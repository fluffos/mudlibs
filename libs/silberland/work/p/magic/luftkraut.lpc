// 
// Eine Portion Luftkraut 
// (Bugfixes by Woody, 2002-11-22)
// 60 Sekunden lang Damage 70%, Speed 150..180%

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include <food.h>
#include <new_skills.h>

#define SPEED 150+(random(4)*10)
#define DAMAGE 70 

int decay_resets=6+random(10);


void create()
{
  if( !is_clone(TO)) return;
  ::create();

  AddId( ({ "kraut", "luftkraut", "\nkraut", "\nluftkraut" }) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Luftkraut");

  SetProp(P_SHORT, "Ein Straeusschen Luftkraut");
  SetProp(P_LONG,
      "Das Luftkraut ist eine seltene, hochmagische Pflanze, deren Genuss "
      "gar sonderbare Folgen nach sich ziehen kann. Die Blaetter dieser "
      "Pflanze bewegen sich staendig, so als wuerde sie ein leichter "
      "Wind umspielen.");

  SetProp(P_INFO, "Das Luftkraut macht Dich hyperaktiv.");

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 5000);
  SetProp(P_MATERIAL, MAT_PLANT);
  SetProp(P_FOOD_INFO, ([F_HEAL:20,F_POISON:0,F_SOAK:5]));
}


void Eating(object pl)
{
  tell_object(pl,
      "Du isst das Luftkraut und fuehlst Dich um vieles schneller.\n");
  say(pl->Name() + " isst ein seltsames Kraut.\n");
  pl->ModifySkillAttribute(pl, SA_SPEED, SPEED, 60);
  pl->ModifySkillAttribute(pl, SA_DAMAGE, DAMAGE, 60);
}


void reset()
{
  object e;

  ::reset();
  if (!(--decay_resets))
  {
    if ((e = ENV(ME)) && interactive(e))
      tell_object(e, "Das Luftkraut verwelkt. Du wirfst es weg.\n");
    remove();
  }
}
