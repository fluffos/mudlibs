
inherit "std/thing";

#include <properties.h>
#include "/p/daemon/itemd/itemd.h"

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Supergem");
  AddId( ({"edelstein", "SUPERGEM"}) );
  SetProp(P_MAGIC, 1);
  SetProp(P_NOBUY, 1);
}

int create_super_gem(object ob)
{
  string pre;
  if( !ob || !ob->id("EDELSTEIN") ) return 0;
  pre=({"Super", "Ultra", "Hyper", "Riesen", "Mega"})[random(5)];
  SetProp(P_NAME, pre+lower_case(ob->Query(P_NAME)[0]) );
  SetProp(P_GENDER, ob->QueryProp(P_GENDER));
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, ob->QueryProp(P_LONG)+
      Name(WER,1)+" ist ein seltenes Einzelstueck und riesengross." );   
  SetProp(P_INFO, ob->QueryProp(P_INFO)+
      Name(WER,1)+" ist durch "+QueryPossPronoun(FEMALE,WEN,SINGULAR)+
      " Groesse ganz besonders magisch.\n");
  AddId(lower_case(QueryProp(P_NAME)));
  SetProp(P_WEIGHT, 20*(ob->Query("u_gpu")[0])/(ob->Query("u_gpu")[1]));
  SetProp(P_VALUE, 50*(ob->Query("u_cpu")[0])/(ob->Query("u_cpu")[1]));
  SetProp(P_MATERIAL, ob->QueryProp(P_MATERIAL));
  SetProp("old_gem", lower_case(ob->Query(P_NAME)[0]));
}  

int IsSocketItem()
{
  return SOC_M_GGEM;
}
