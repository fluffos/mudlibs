inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Obsidiandolch");
  SetProp(P_LONG,
    "Dieser Dolch hat eine Klinge aus tiefschwarzem Obsidian.");
  SetProp(P_NAME, "Obsidiandolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch", "obsidiandolch"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 70);
  SetProp(P_WC_FIX, 30);
  SetProp(P_WC_BONUS,
    (["Messerkaempfer":40, "Messerexperte":145, "Messermeister":280]) );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_OBSIDIAN:100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 200);
  SetProp(P_SIZE, 35);
}

