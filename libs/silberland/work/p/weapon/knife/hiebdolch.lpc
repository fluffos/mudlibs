inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Hiebdolch");
  SetProp(P_LONG,  
    "Der Hiebdolch besitzt eine lange, stark gekruemmte Klinge, die weniger "
    "zum Zustechen, sondern eher zum Schneiden geeignet ist. Man koennte "
    "den Hiebdolch also fast als kleinen Verwandten des Krummsaebels "
    "bezeichnen.");
  SetProp(P_NAME, "Hiebdolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"hiebdolch", "dolch"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 95);
  SetProp(P_WC_FIX, 60);
  SetProp(P_WC_BONUS,
    (["Messerkaempfer":50, "Messerexperte":150, "Messermeister":250]) );
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 650);
  SetProp(P_VALUE, 800);
  SetProp(P_SIZE, 40);
  SetProp(P_QUALITY_DECAY, 120);
}

