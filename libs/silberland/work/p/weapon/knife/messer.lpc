inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Messer");
  SetProp(P_LONG, 
    "Dieses einfaches Messer hat einen Holzgriff und eine Klinge, die nur an "
    "einer Seite eine Schneide aufweist. Das Messer ist mehr ein "
    "Gebrauchsgegenstand als eine Waffe, aber Du kannst es dennoch zuecken und "
    "damit auf Deine Gegner einstechen.");
  SetProp(P_NAME, "Messer");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"messer"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 55);
  SetProp(P_WC_FIX, 15);
  SetProp(P_WC_BONUS,
    (["Messerkaempfer":40, "Messerexperte":140, "Messermeister":230]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_IRON:60, MAT_WOOD:40]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 300);
  SetProp(P_SIZE, 25);
  SetProp(P_QUALITY_DECAY, 85);
}

