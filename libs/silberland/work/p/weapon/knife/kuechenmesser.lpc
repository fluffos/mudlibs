inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Kuechenmesser");
  SetProp(P_LONG, 
    "Das Kuechenmesser hat eine breite Klinge und eignet sich fuer alle "
    "Arbeiten, die in der Kueche so anfallen. Als Waffe ist es nicht sehr "
    "gut geeignet, weil es sehr schlecht in der Hand liegt.");
  SetProp(P_NAME, "Kuechenmesser");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"messer", "kuechenmesser"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 55);
  SetProp(P_WC_FIX, 0);
  SetProp(P_WC_BONUS,
    (["Messerkaempfer":50, "Messerexperte":160, "Messermeister":250]) );
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_IRON:60, MAT_WOOD:40]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 200);
  SetProp(P_SIZE, 30);
}

