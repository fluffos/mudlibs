inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Langdolch");
  SetProp(P_LONG,  
    "Der Langdolch ist wirklich lang, ueber einen Fuss misst die Klinge. "
    "Sie hat zwei extrem scharfe Schneiden und eine furchterregende Spitze. "
    "Der Griff besteht aus einem wertvollen schwarzen Holz, in das weisse "
    "Verziehrungen eingelegt sind. Am Knauf ist ein kleiner Edelstein "
    "eingelegt. Diese wertvolle und bestaendige Waffe ist sicher der Stolz "
    "seines Besitzers.");
  SetProp(P_NAME, "Langdolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"langdolch", "dolch"}) );
  SetProp(P_INFO, "Sicher stammt der Langdolch aus fuerstlichem Hause.\n");

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 100);
  SetProp(P_WC_FIX, 80);
  SetProp(P_WC_BONUS,
    (["Messerkaempfer":50, "Messerexperte":100, "Messermeister":200]) );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:70,MAT_EBONY:20,MAT_IVORY:7,MAT_EMERALD:3]) );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 2000);
  SetProp(P_SIZE, 40);
  SetProp(P_QUALITY_DECAY, 300);
}

