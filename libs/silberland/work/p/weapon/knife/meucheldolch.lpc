inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Meucheldolch");
  SetProp(P_LONG,  
    "Der Meucheldolch ist eine toedliche Waffe. Die lange und sehr spitze "
    "Klinge kann den Gegner mit einem Stich toeten, denn sie ist so schmal, "
    "dass sie ohne viel Widerstand tief in den Koeper eindringen kann. "
    "Im Griff sind einige Kerben eingeritzt.");
  SetProp(P_NAME, "Meucheldolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"meucheldolch", "dolch"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 125);
  SetProp(P_WC_FIX, 55);
  SetProp(P_WC_BONUS,
    (["Messerkaempfer":50, "Messerexperte":120, "Messermeister":220]) );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 450);
  SetProp(P_VALUE, 1500);
  SetProp(P_SIZE, 35);
  SetProp(P_QUALITY_DECAY, 170);
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:25, A_DEX:20]) );

  AddDetail( ({"griff", "kerben"}),
    "Im Griff sind einige Kerben eingeritzt. Das sind wohl die Opfer, die "
    "mit diesem Meucheldolch ermordet wurden.");
      
}

