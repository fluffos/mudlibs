inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Dolch");
  SetProp(P_LONG,
    "Ein Dolch mit einer einen halben Fuss langen Klinge, die zwei scharfe "
    "Schneiden besitzt. Der Dolch ist sehr spitz und eignet sich ideal zum "
    "Zustechen.");
  SetProp(P_NAME, "Dolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 70);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["Messerkaempfer":50, "Messerexperte":180, "Messermeister":300]) );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 500);
  SetProp(P_SIZE, 30);
  SetProp(P_QUALITY_DECAY, 130);
}

