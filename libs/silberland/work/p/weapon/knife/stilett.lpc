inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Stilett");
  SetProp(P_LONG,
    "Das Stilett ist ein Dolch mit extrem duenner Klinge, die im "
    "Rundschliff gefertigt ist. Die Klinge ist eher schmal und nicht sehr "
    "scharf, dafuer ist die Spitze aber um so gefaehrlicher. Das Stilett "
    "eignet sich also fast nur zum zustechen und nicht zum schneiden, "
    "deshalb wird es auch fast nur von Meuchelmoerdern verwendet.");
  SetProp(P_NAME, "Stilett");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stilett"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 60);
  SetProp(P_WC_FIX, 90);
  SetProp(P_WC_BONUS,
    (["Messerkaempfer":50, "Messerexperte":120, "Messermeister":200]) );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 850);
  SetProp(P_SIZE, 30);
  SetProp(P_QUALITY_DECAY, 110);
}

