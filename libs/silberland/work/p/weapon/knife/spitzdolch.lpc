inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Spitzdolch");
  SetProp(P_LONG,  
    "Der Spitzdolch hat am Griff eine sehr breite Klinge, die sich zur "
    "Spitze hin stark verjuengt, man koennte fast von einer dreieckigen "
    "Form sprechen. Die Spitze ist wirklich sehr spitz und ist sicher sehr "
    "gefaehrlich. Aber auch die beiden Schneiden sind extrem scharf. Der "
    "Spitzdolch ist daher eine kleine, aber sehr gefaehrliche Waffe.");
  SetProp(P_NAME, "Spitzdolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"spitzdolch", "dolch"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 90);
  SetProp(P_WC_FIX, 70);
  SetProp(P_WC_BONUS,
    (["Messerkaempfer":50, "Messerexperte":120, "Messermeister":200]) );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 900);
  SetProp(P_SIZE, 35);
  SetProp(P_QUALITY_DECAY, 140);
}

