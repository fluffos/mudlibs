inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Steindolch");
  SetProp(P_LONG,
    "Dieser Dolch wurde aus einem Stueck Stein gefertigt. Der Griff ist "
    "etwas klobig, dafuer ist die Klinge umso besser bearbeitet. Mit einer "
    "guten Stahlklinge kann man diesen Dolch aber nicht vergleichen.");
  SetProp(P_NAME, "Steindolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch", "steindolch"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 60);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS,
    (["Messerkaempfer":50, "Messerexperte":130, "Messermeister":220]) );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_GRANITE:100]) );
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 200);
  SetProp(P_SIZE, 25);
  SetProp(P_QUALITY_DECAY, 80);
}

