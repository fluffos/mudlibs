inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Fleischermesser");
  SetProp(P_LONG, 
    "Das Fleischermesser ist das Hauptwerkzeug eines Fleischers. Es hat "
    "eine extrem schwere Klinge, die auf der einen Seite eine scharfe "
    "Schneide besitzt und auf der anderen Seite fast einen Finger breit ist. "
    "Damit kann man jedes Fleischstueck mit einem Hieb in zwei Haelften "
    "teilen.");
  SetProp(P_NAME, "Fleischermesser");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"messer", "fleischermesser"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 85);
  SetProp(P_WC_FIX, 10);
  SetProp(P_WC_BONUS,
    (["Messerkaempfer":50, "Messerexperte":170, "Messermeister":270]) );
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_IRON:60, MAT_WOOD:40]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 250);
  SetProp(P_SIZE, 40);
}

