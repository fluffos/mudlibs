inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Jagdmesser");
  SetProp(P_LONG, 
    "Die Klinge des Jagdmessers ist an der Spitze etwas gekruemmt, um das "
    "Ausnehmen von erlegten Tieren zu erleichtern. Die Klinge ist sehr "
    "scharf und widerstandsfaehig, sodass man damit leicht durch Haut und "
    "Knochen schneiden kann. In den hoelzernen Griff sind Hirsche und Rehe "
    "geschnitzt.");
  SetProp(P_NAME, "Jagdmesser");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"messer", "jagdmesser"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 70);
  SetProp(P_WC_FIX, 35);
  SetProp(P_WC_BONUS,
    (["Messerkaempfer":50, "Messerexperte":150, "Messermeister":250]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:80, MAT_WOOD:20]) );
  SetProp(P_WEIGHT, 240);
  SetProp(P_VALUE, 550);
  SetProp(P_SIZE, 30);
  SetProp(P_QUALITY_DECAY, 150);
}

