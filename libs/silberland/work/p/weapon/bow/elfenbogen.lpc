inherit "/p/weapon/weapon_inh";

#include <properties.h>    
#include <combat.h>        

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Elfenbogen");
  SetProp (P_LONG, 
    "Ein eleganter Bogen, mit geschwungenen Linien und "
    "kunstvollen Verzierungen, von Elfen verwendet. Diese "
    "Boegen sind leicht und dennoch leistungsstark, passend "
    "zum kuenstlerischen und geschickten Naturell der Elfen.");
  SetProp (P_NAME, "Elfenbogen");
  SetProp (P_GENDER, MALE);
  AddId (({"bogen", "elfenbogen"}));

  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 220);
  SetProp(P_WC_BONUS, 
    (["elf":100, "Bogenkaempfer":50, "Bogenexperte":150, "Bogenmeister":250]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_WOOD:40, MAT_HORN:40]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 1700);
  SetProp(P_SIZE, 50);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:16]) );
}
