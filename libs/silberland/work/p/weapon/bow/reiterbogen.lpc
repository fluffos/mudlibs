inherit "/p/weapon/weapon_inh";

#include <properties.h>    
#include <combat.h>        

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Reiterbogen");
  SetProp (P_LONG, 
    "Ein kompakter Bogen, speziell fuer den Einsatz zu "
    "Pferd konzipiert. Er zeichnet sich durch seine Kuerze "
    "und Wendigkeit aus, was es dem Reiter ermoeglicht, "
    "effektiv aus dem Sattel zu schiessen.");
  SetProp (P_NAME, "Reiterbogen");
  SetProp (P_GENDER, MALE);
  AddId (({"bogen", "reiterbogen"}));

  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 140);
  SetProp(P_WC_BONUS, 
    (["elf":50, "Bogenkaempfer":50, "Bogenexperte":150, "Bogenmeister":250]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_HORN:60]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 700);
  SetProp(P_SIZE, 50);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:10]) );
}
