inherit "/p/weapon/weapon_inh";

#include <properties.h>    
#include <combat.h>        

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Kriegsbogen");
  SetProp (P_LONG, 
    "Ein leistungsstarker Langbogen, der speziell "
    "fuer militaerische Zwecke entwickelt wurde. Kriegsboegen "
    "sind aufgrund ihrer Reichweite und Durchschlagskraft "
    "in Schlachten entscheidend.");
  SetProp (P_NAME, "Kriegsbogen");
  SetProp (P_GENDER, MALE);
  AddId (({"bogen", "kriegsbogen"}));

  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 250);
  SetProp(P_WC_BONUS, 
    (["elf":50, "Bogenkaempfer":50, "Bogenexperte":150, "Bogenmeister":250]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_WOOD:40, MAT_HORN:40]) );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 1800);
  SetProp(P_SIZE, 50);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:16, A_STR: 12]) );
}
