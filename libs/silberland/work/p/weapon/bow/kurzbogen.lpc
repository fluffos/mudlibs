inherit "/p/weapon/weapon_inh";

#include <properties.h>    
#include <combat.h>        

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Kurzbogen");
  SetProp (P_LONG, 
    "Ein einfacher, kompakter Bogen mit kurzen Wurfarmen, ideal fuer den "
    "Einsatz in beengten Verhaeltnissen oder auf kurze Distanzen. Seine "
    "Handlichkeit ermoeglicht schnelles Ziehen und Abschiessen.");
  SetProp (P_NAME, "Kurzbogen");
  SetProp (P_GENDER, MALE);
  AddId (({"bogen", "kurzbogen"}));

  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 125);
  SetProp(P_WC_BONUS, 
    (["elf":50, "Bogenkaempfer":50, "Bogenexperte":150, "Bogenmeister":250]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_WOOD:60]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 350);
  SetProp(P_SIZE, 50);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:4]) );
}
