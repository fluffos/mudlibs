inherit "/p/weapon/weapon_inh";

#include <properties.h>    
#include <combat.h>        

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Langbogen");
  SetProp (P_LONG, 
    "Ein traditioneller Bogen mit langen, geraden Wurfarmen. "
    "Seine Einfachheit und Kraft machen "
    "bei Bogenschuetzen beliebt, sowohl fuer den Krieg als "
    "auch fuer den Jagdgebrauch.");
  SetProp (P_NAME, "Langbogen");
  SetProp (P_GENDER, MALE);
  AddId (({"bogen", "langbogen"}));

  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 165);
  SetProp(P_WC_BONUS, 
    (["elf":50, "Bogenkaempfer":50, "Bogenexperte":150, "Bogenmeister":250]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_WOOD:60]) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_VALUE, 1000);
  SetProp(P_SIZE, 50);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:14]) );
}
