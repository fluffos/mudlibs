inherit "/p/weapon/weapon_inh";

#include <properties.h>    
#include <combat.h>        

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Jagdbogen");
  SetProp (P_LONG, 
    "Ein mittelgrosser Bogen, praezise und wendig, speziell fuer die Jagd entwickelt. "
    "Seine Groesse und Wendigkeit ermoeglichen schnelle Schuesse in Wald- und "
    "Gelaendeumgebungen.");
  SetProp (P_NAME, "Jagdbogen");
  SetProp (P_GENDER, MALE);
  AddId (({"bogen", "jagdbogen"}));

  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 100);
  SetProp(P_WC_BONUS, 
    (["elf":50, "Bogenkaempfer":50, "Bogenexperte":150, "Bogenmeister":250]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_WOOD:60]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 350);
  SetProp(P_SIZE, 50);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:4]) );
}
