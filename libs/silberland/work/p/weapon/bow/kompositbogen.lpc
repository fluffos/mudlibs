inherit "/p/weapon/weapon_inh";

#include <properties.h>    
#include <combat.h>        

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Kompositbogen");
  SetProp (P_LONG, 
    "Ein Bogen, der aus verschiedenen Materialien wie Holz, Horn und Sehnen hergestellt ist. "
    "Kompositboegen sind aufgrund ihrer Effizienz und hohen Zugstaerke "
    "besonders in kriegerischen Kulturen verbreitet.");
  SetProp (P_NAME, "Kompositbogen");
  SetProp (P_GENDER, MALE);
  AddId (({"bogen", "kompositbogen"}));

  SetProp(P_WEAPON_TYPE, WT_BOW);
  SetProp(P_WC, 180);
  SetProp(P_WC_BONUS, 
    (["elf":50, "Bogenkaempfer":50, "Bogenexperte":150, "Bogenmeister":250]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_WOOD:40, MAT_HORN:40]) );
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE, 1500);
  SetProp(P_SIZE, 50);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:12]) );
}
