inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Peitsche");
  SetProp(P_LONG,  
    "Die Peitsche besteht eigentlich nur aus einer langen Lederschnur, die an "
    "einem Griff befestigt ist.");
  SetProp(P_NAME, "Peitsche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"peitsche"}) );

  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 111);
  SetProp(P_WC_FIX, 0);
  SetProp(P_WC_BONUS, (["Peitschenkaempfer":50, "Peitschenexperte":150, 
      "Peitschenmeister":250]) );
  SetProp(P_DAM_TYPE, DT_WHIP );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 400);
  SetProp(P_SIZE, 200);
  SetProp(P_QUALITY_DECAY, 80);
}

