inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Bullenpeitsche");
  SetProp(P_LONG,  
    "Die Bullenpeitsche besteht aus gehaerteten Rindsleder, das zu einer "
    "lange Peitsche geflochten wurde. Ein Treffer mit dieser Peitsche kann "
    "schreckliche Verletzungen hervorrufen. Normalerweise wird sie nur von "
    "Viehhirten beim Treiben von Rindern verwendet, aber auch zur "
    "Selbstverteidigung wird sie oft benutzt, denn durch ihre grosse Laenge "
    "kann man einen Angreifer abwehren, bevor dieser auch nur in die Naehe "
    "kommt.");
  SetProp(P_NAME, "Bullenpeitsche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"peitsche", "bullenpeitsche"}) );

  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 165);
  SetProp(P_WC_FIX, 0);
  SetProp(P_WC_BONUS, (["Peitschenkaempfer":50, "Peitschenexperte":150, 
      "Peitschenmeister":250]) );
  SetProp(P_DAM_TYPE, DT_WHIP );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 700);
  SetProp(P_SIZE, 350);
  SetProp(P_QUALITY_DECAY, 80);
}

