inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine neunschwaenzige Peitsche");
  SetProp(P_LONG,  
    "Die Neunschwaenzige besteht aus einem Griff, an dem neun "
    "Peitschenschnuere befestigt sind. Wenn man mit dieser Peitsche "
    "zuschlaegt, trifft man fast immer mit einer der Schnuere den Gegner."
    "Bei vielen kleinen Gegnern kann man sogar gleich mehrere auf einmal "
    "treffen.");
  SetProp(P_NAME, "Peitsche");
  SetProp(P_NAME_ADJ, "neunschwaenzig" );
  SetProp(P_GENDER, FEMALE);
  AddId( ({"peitsche", "neunschwaenzige"}) );
  AddAdjective( ({"neunschwaenzige", "neunschwaenzig"}) );

  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 119);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS, (["Peitschenkaempfer":50, "Peitschenexperte":150, 
      "Peitschenmeister":250]) );
  SetProp(P_DAM_TYPE, DT_WHIP );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 550);
  SetProp(P_SIZE, 150);
  SetProp(P_QUALITY_DECAY, 80);
}

