/*
 * /p/weapon/weapon_inh.c
 *
 * Weapon inheriter
 * Sorgt fuer Logging der verwendenden Objekte
 *
 */


inherit "/std/weapon";

void create()
{
  ::create();
  if (this_object() && file_name(this_object())[0..9] != "/p/weapon/")
  {
    raise_error("Bitte std/weapon als inherit verwenden!");
    return;
  }
  if (this_object() && previous_object())       // do I still exist? pred?
  {
    "/p/weapon/weaponmaster"->Register(
        explode( file_name(), "#" )[0],
        explode( file_name(previous_object()), "#" )[0] );
  }
}

