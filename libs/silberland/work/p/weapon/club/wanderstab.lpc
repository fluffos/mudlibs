inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein Wanderstab");
  SetProp(P_LONG,
    "Der Wanderstab ist eigentlich nur ein dicker Ast, der notduerftig "
    "bearbeitet wurde. Zum Kaempfen eigenet er sich nur schlecht.");
  SetProp(P_NAME, "Wanderstab");
  SetProp(P_GENDER, MALE);
  AddId( ({"stab","wanderstab" }));

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 80);
  SetProp(P_WC_FIX, 0);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":100, "Keulenmeister":150]));
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ({MAT_ELM_WOOD,MAT_OAK,MAT_BEECH})[random(3)] );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 200);
  SetProp(P_SIZE, 100);
  SetProp(P_QUALITY_DECAY, 70);
}

