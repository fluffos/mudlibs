inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Vorschlaghammer");
  SetProp(P_LONG,  
    "Dieser Vorschlaghammer besitzt einen maechtigen Hammerkopf, der auf "
    "einem langen Stiel sitzt. Er ist so schwer, dass man ihn nur mit zwei "
    "Haenden fuehren kann. Fuer schwere Arbeiten ist er bestens geeignet, "
    "fuer den Kampf hingegen liegt er zu schlecht in der Hand.") ;
  SetProp(P_NAME, "Vorschlaghammer");
  SetProp(P_GENDER, MALE);
  AddId( ({"vorschlaghammer", "hammer"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 160);
  SetProp(P_WC_FIX, 0);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_IRON :30, MAT_OAK:70]) );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 600);
  SetProp(P_SIZE, 105);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:15]) );  
}

