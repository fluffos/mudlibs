inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Knueppel");
  SetProp(P_LONG, 
    "Dieser Knueppel ist eigentlich nur ein grosser, dicker Holzstock. Er dient "
    "nur als improvisierte Waffe, denn er hat nicht einmal einen richtigen "
    "Griff und liegt deshalb auch ganz schlecht in der Hand.");
  SetProp(P_NAME, "Knueppel");
  SetProp(P_GENDER, MALE);
  AddId( ({"knueppel"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 70);
  SetProp(P_WC_FIX, 0);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ({MAT_MISC_TROPICAL_WOOD,MAT_MISC_CONIFER_WOOD,MAT_FIR,
    MAT_MISC_DECIDUOUS_WOOD,MAT_OAK, MAT_BEECH })[random(6)] );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 30);
  SetProp(P_SIZE, 60);
  SetProp(P_QUALITY_DECAY, 50 );
}
