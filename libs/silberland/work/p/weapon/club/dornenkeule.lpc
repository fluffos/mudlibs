inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Dornenkeule");
  SetProp(P_LONG, 
    "Diese Keule wurde mit vielen kleinen Dornen bespickt, damit sie mehr "
    "Schaden macht. Bei den Dornen handelt es sich zum Teil um echte Dornen "
    "und um kleine, spitze Steine, die fest im harten Holz der Keule "
    "verankert sind.");
  SetProp(P_NAME, "Dornenkeule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"keule", "dornenkeule"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 125);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_RIP}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_OAK:90, MAT_STONE:5, MAT_MISC_PLANT:5]) );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 530);
  SetProp(P_SIZE, 80);
  SetProp(P_QUALITY_DECAY, 70 );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:5]) );
}

