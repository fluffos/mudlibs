inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Knochenkeule");
  SetProp(P_LONG, 
    "Diese Keule wurde aus dem Oberschenkelknochen eines grossen Tieres "
    "angefertigt. Am Griff haengt ein Lederband, das mit bunten Federn "
    "geschmueckt ist.");
  SetProp(P_NAME, "Knochenkeule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"keule", "knochenkeule"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 135);
  SetProp(P_WC_FIX, 10);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_BONE:90, MAT_FEATHER:5, MAT_LEATHER:5]) );
  SetProp(P_WEIGHT, 2200);
  SetProp(P_VALUE, 430);
  SetProp(P_SIZE, 75);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:7]) );
}

