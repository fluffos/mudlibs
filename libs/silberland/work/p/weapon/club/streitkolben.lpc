inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Streitkolben");
  SetProp(P_LONG,  
    "Der Streitkolben ist eigentlich nur eine Holzkeule, deren Ende mit "
    "metallenen Spitzen und Stacheln verstaerkt wurde, um die "
    "Schadenswirkung zu erhoehen. In der Hand eines erfahrenen Kaempfers "
    "wird aber dennoch eine sehr gefaehrliche Waffe daraus. Trotz der "
    "einfachen Fertigung ist ein Streikolben eine langlebige und "
    "zuverlaessige Waffe.");
  SetProp(P_NAME, "Streitkolben");
  SetProp(P_GENDER, MALE);
  AddId( ({"streitkolben"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 145);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_COPPER:40, MAT_BEECH:60]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 1500);
  SetProp(P_SIZE, 75);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:8]) );  
}

