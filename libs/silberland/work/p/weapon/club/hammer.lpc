inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Hammer");
  SetProp(P_LONG,  
    "Ein kleiner Hammer, wie man ihn zum Naegeleinschlagen benutzt.");
  SetProp(P_NAME, "Hammer");
  SetProp(P_GENDER, MALE);
  AddId( ({"hammer"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 70);
  SetProp(P_WC_FIX, 0);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_IRON :30, MAT_OAK:70]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 100);
  SetProp(P_SIZE, 40);
  SetProp(P_QUALITY_DECAY, 60);
}

