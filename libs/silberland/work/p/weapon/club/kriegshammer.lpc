inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Kriegshammer");
  SetProp(P_LONG,  
    "Der Kriegshammer hat seinen Namen mit vollem Recht. Der lange Stiel und "
    "der breite Hammerkopf sind ideal ausgewogen und jeder kraeftige "
    "Kaempfer kann damit gewaltige Schlaege austeilen. Zusaetzlich sind "
    "seitlich des Hammerkopfes und am Ende des Stiels noch einige Spitzen "
    "angebracht, die sowohl das Aussehen des Hammers noch bedrohlicher "
    "machen, aber sicher auch einigen Schaden anrichten koennen.");
  SetProp(P_NAME, "Kriegshammer");
  SetProp(P_GENDER, MALE);
  AddId( ({"kriegshammer", "hammer"}) );
  SetProp(P_INFO, "Falls Zwerge keine Axt zur Hand haben, kaempfen sie "
                     "auch gerne einmal mit solch einem Kriegshammer.");

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 229);
  SetProp(P_WC_FIX, 15);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_IRON :30, MAT_YEW_WOOD:70]) );
  SetProp(P_WEIGHT, 3850);
  SetProp(P_VALUE, 3200);
  SetProp(P_SIZE, 100);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:19]) );  
}

