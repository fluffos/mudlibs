inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein Kampfstab");
  SetProp(P_LONG,
    "Ein langer, aus Holz gefertigter Stab. Viele Magier benutzen solche "
    "Staebe als Verteidigungswaffe. Aber auch als Wanderstab kann man ihn "
    "benutzen.");
  SetProp(P_NAME, "Kampfstab");
  SetProp(P_GENDER, MALE);
  AddId( ({"stab","kampfstab" }));

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 120);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE,DT_BLUDGEON);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ({MAT_ELM_WOOD,MAT_OAK,MAT_BEECH})[random(3)] );
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 800);
  SetProp(P_SIZE, 120);
  SetProp(P_QUALITY_DECAY, 90);
}

