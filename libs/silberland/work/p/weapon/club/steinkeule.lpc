inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Steinkeule");
  SetProp(P_LONG, 
    "Diese Keule besteht voellig aus Stein und ist auch dementsprechend "
    "schwer und unhandlich. sie wurde nur grob behauen, sodass man aufpassen "
    "muss, dass man sich nicht an einer spitzen Kante verletzt.");
  SetProp(P_NAME, "Steinkeule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"keule", "steinkeule"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 145);
  SetProp(P_WC_FIX, 5);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_GRANITE);
  SetProp(P_WEIGHT, 4200);
  SetProp(P_VALUE, 330);
  SetProp(P_SIZE, 75);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:10]) );
}

