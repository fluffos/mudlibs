inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein Schmiedehammer");
  SetProp(P_LONG,
    "Der Hammer ist kurz, aber umso schwerer und wiegt so gut und gern 5 Kilo. "
    "Du musst schon einige Kraft aufbringen, um so einen Hammer zu schwingen. "
    "Ein Schmied kann mit diesem Hammer wahre Wunderwerke aus einem Stueck "
    "Metall fertigen, aber fuer den Kampf ist er nicht so gut geeignet.");
  SetProp(P_NAME, "Schmiedehammer");
  SetProp(P_GENDER, MALE);
  AddId( ({"hammer","schmiedehammer" }));

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 90);        
  SetProp(P_WC_FIX, 0);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250,
      "schmied":200]) );
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_OAK:80, MAT_IRON:20]) );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 500);
  SetProp(P_SIZE, 85);
  SetProp(P_QUALITY_DECAY, 80 );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:14]) );
}

