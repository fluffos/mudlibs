inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Keule");
  SetProp(P_LONG, 
    "Diese Keule ist ein primitive Waffe, die nur aus einem bearbeiteten "
    "Stueck Holz besteht. Am Griff ist sie gerade so dick, dass man sie "
    "gut halten kann, nach oben wird sie immer dicker und endet in einer "
    "massigen Rundung, mit der man gewaltige Hiebe austeilen kann.");
  SetProp(P_NAME, "Keule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"keule"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 90);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ({MAT_MISC_TROPICAL_WOOD,MAT_MISC_CONIFER_WOOD,MAT_FIR,
    MAT_MISC_DECIDUOUS_WOOD,MAT_OAK, MAT_BEECH })[random(6)] );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 330);
  SetProp(P_SIZE, 80);
  SetProp(P_QUALITY_DECAY, 70 );
}

