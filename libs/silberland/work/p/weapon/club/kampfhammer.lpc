inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Kampfhammer");
  SetProp(P_LONG,  
    "Dieser einhaendige Hammer wurde speziell fuer den Kampf angefertigt. "
    "An einem Holzstiel stitzt ein maechtiger Hammerkopf, dessen beide Enden "
    "sich verbreitern, um eine groessere Schlagflaeche zu haben. Der Griff "
    "ist mit Leder umwickelt, damit der Hammer besser in der Hand liegt. "
    "Am unteren Ende befindet sich eine Lederschlaufe, mit deren Hilfe man "
    "den Hammer eindrucksvoll durch die Luft wirbeln kann.");
  SetProp(P_NAME, "Kampfhammer");
  SetProp(P_GENDER, MALE);
  AddId( ({"kampfhammer", "hammer"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 140);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_IRON :30, MAT_YEW_WOOD:60, MAT_LEATHER:10]) );
  SetProp(P_WEIGHT, 1650);
  SetProp(P_VALUE, 900);
  SetProp(P_SIZE, 85);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:7]) );

  AddDetail( ({"schlaufe", "lederschlaufe"}),
    "Mit dieser Lederschlaufe kann man den Kampfhammer eindrucksvoll "
    "durch die Luft wirbeln.");
  AddCmd( ({"wirbel", "wirbl", "wirble"}), "wirbeln");
}

int wirbeln(string str)
{
  notify_fail("Was willst Du durch die Luft wirbeln?\n");
  if( !str ) return 0; 
  if(! id(str) ) return 0;
  if( QueryProp(P_WIELDED)!= this_player() )
    return notify_fail("Du musst den Kampfhammer dazu vorher zuecken.\n"),0;
  write(break_string("Du nimmst den Kampfhammer an der Schlaufe und wirbelst "
      "ihn eindrucksvoll durch die Luft.", 78));
  say(break_string(this_player()->Name(WER,1)+" nimmt "+
      this_player()->QueryPossPronoun(MALE, WEN, SINGULAR)+ " Kampfhammer an "
      "der Schlaufe und wirbelt ihn eindrucksvoll durch die Luft.",78) );
  return 1;
}

