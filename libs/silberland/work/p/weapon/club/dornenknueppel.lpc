inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Dornenknueppel");
  SetProp(P_LONG, 
    "Dieser Knueppel wurde mit den Ranken eines Dornenbusches umwickelt, um "
    "auf diese Weise die Schadenswirkung zu erhoehen. Recht stabil schaut "
    "das ganze aber dann doch nicht aus." );
  SetProp(P_NAME, "Dornenknueppel");
  SetProp(P_GENDER, MALE);
  AddId( ({"knueppel", "dornenknueppel"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 115);
  SetProp(P_WC_FIX, 10);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_RIP}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL,  ([ ({MAT_MISC_TROPICAL_WOOD,MAT_MISC_CONIFER_WOOD,
      MAT_FIR, MAT_MISC_DECIDUOUS_WOOD,MAT_OAK, MAT_BEECH })[random(6)] :80,
    MAT_MISC_PLANT:20])  );
  SetProp(P_WEIGHT, 1700);
  SetProp(P_VALUE, 330);
  SetProp(P_SIZE, 70);
  SetProp(P_QUALITY_DECAY, 60 );
}

