inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Stachelkeule");
  SetProp(P_LONG, 
    "Diese schwere Keule ist mit fingerdicken Eisenstacheln bewehrt. "
    "Der Griff ist gewellt. sodass man mit den Fingern einen guten Halt hat.");
  SetProp(P_NAME, "Stachelkeule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"keule", "stachelkeule"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 137);
  SetProp(P_WC_FIX, 25);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([ ({MAT_MISC_TROPICAL_WOOD,MAT_MISC_CONIFER_WOOD,
      MAT_FIR, MAT_MISC_DECIDUOUS_WOOD,MAT_OAK, MAT_BEECH })[random(6)] :90,
    MAT_IRON:10 ]));
  SetProp(P_WEIGHT, 2200);
  SetProp(P_VALUE, 530);
  SetProp(P_SIZE, 85);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:5]) );
}

