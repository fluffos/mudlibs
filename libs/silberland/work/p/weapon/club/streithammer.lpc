inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Streithammer");
  SetProp(P_LONG,  
    "Der Streithammer ist ein maechtige Waffe, die nur von sehr starken und "
    "erfahrenen Kaempfern gefuehrt wird. Auf einem bronzenen Stiel mit "
    "vielen Verzierungen sitzt ein gewaltiger Hammerkopf. Sicherlich kann "
    "man mit einem einzigen Hieb dieser Waffe seinen Gegner zerschmettern.");
  SetProp(P_NAME, "Streithammer");
  SetProp(P_GENDER, MALE);
  AddId( ({"streithammer", "hammer"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 255);
  SetProp(P_WC_FIX, 10);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":70, "Keulenexperte":130, "Keulenmeister":220]));
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL :30, MAT_BRONCE: 70]) );
  SetProp(P_WEIGHT, 6000);
  SetProp(P_VALUE, 2000);
  SetProp(P_SIZE, 115);
  SetProp(P_QUALITY_DECAY, 140);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:22, P_LEVEL:20]) );  
}

