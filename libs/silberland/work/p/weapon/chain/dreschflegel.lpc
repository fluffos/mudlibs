inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Dreschflegel");
  SetProp(P_LONG,  
    "Dreschflegel werden hauptsaechlich von Bauern benutzt, um das Korn "
    "zu dreschen. Aber es hindert niemanden daran, mit dem Dreschflegel "
    "auf die Koepfe von Gegner einzudreschen. Der Dreschflegel besteht aus "
    "einem laengerem und einem kuerzerem Holzstueck, die mit einer kurzen "
    "Eisenkette verbunden sind.");
  SetProp(P_NAME, "Dreschflegel");
  SetProp(P_GENDER, MALE);
  AddId( ({"dreschflegel", "flegel"}) );

  SetProp(P_WEAPON_TYPE, WT_CHAIN );
  SetProp(P_WC, 135);
  SetProp(P_WC_FIX, 0);
  SetProp(P_WC_BONUS, 
    (["Kettenkaempfer":50, "Kettenexperte":150, "Kettenmeister":250]) );
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_ELM_WOOD: 95, MAT_IRON:5]) );
  SetProp(P_WEIGHT, 2200);
  SetProp(P_VALUE, 300);
  SetProp(P_SIZE, 150);
  SetProp(P_QUALITY_DECAY, 50);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:8]) );  

}

