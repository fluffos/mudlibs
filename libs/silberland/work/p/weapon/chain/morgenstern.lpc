inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Morgenstern");
  SetProp(P_LONG,  
    "An einem stabilen Holzgriff ist ein lange Eisenkette befestigt, an der "
    "eine mit spitzen Stacheln besetzt Eisenkugel haengt. Oftmals verfehlt "
    "man den Gegner mit dem Morgenstern, aber wenn man einmal trifft, dann "
    "ist die Schadenswirkung enorm.");
  SetProp(P_NAME, "Morgenstern");
  SetProp(P_GENDER, MALE);
  AddId( ({"morgenstern"}) );

  SetProp(P_WEAPON_TYPE, WT_CHAIN );
  SetProp(P_WC, 187);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS, 
    (["Kettenkaempfer":50, "Kettenexperte":100, "Kettenmeister":230]) );
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_IRON: 40, MAT_OAK: 60]) );
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE, 1300);
  SetProp(P_SIZE, 100);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:14]) );  

  AddDetail( ({"eisenkugel", "kugel", "stacheln"}),
    "Die Eisenkugel mit den Stacheln kann enormen Schaden machen, wenn man "
    "gut trifft.");
}

