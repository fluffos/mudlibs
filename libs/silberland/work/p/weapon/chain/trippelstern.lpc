inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Trippelstern");
  SetProp(P_LONG,
    "Der Trippelstern besitzt, wie man dem Namen nach schon vermuten kann, "
    "drei stachelbesetzte Eisenkugeln an langen Ketten. Man muss schon "
    "viel Kraft und Geschick besitzen, um diese Waffe schwingen zu koennen, "
    "aber es braucht noch viel mehr Kampferfahrung, um alle drei Kugeln "
    "effektiv einzusetzen. Der Legende nach gab es frueher einmal Krieger, "
    "die nicht nur alle drei Kugeln gegen einen Gegner einsetzen konnten, "
    "sondern auch drei Feinde mit je einer Kugel treffen konnten.");
  SetProp(P_NAME, "Trippelstern");
  SetProp(P_GENDER, MALE);
  AddId( ({"trippelstern"}) );

  SetProp(P_WEAPON_TYPE, WT_CHAIN );
  SetProp(P_WC, 266);
  SetProp(P_WC_FIX, 3);
  SetProp(P_WC_BONUS, 
    (["Kettenkaempfer":50, "Kettenexperte":120, "Kettenmeister":250]) );
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_IRON: 60, MAT_OAK: 40]) );
  SetProp(P_WEIGHT, 7500);
  SetProp(P_VALUE, 2900);
  SetProp(P_SIZE, 120);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:26]) );  

  AddDetail( ({"eisenkugeln", "kugeln", "stacheln"}),
    "Die Eisenkugeln mit den Stacheln machen enormen Schaden, vor allem, "
    "wenn man mit allen drei Kugeln gleichzeitig trifft.");
}

