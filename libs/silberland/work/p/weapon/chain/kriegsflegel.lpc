inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Kriegsflegel");
  SetProp(P_LONG,  
    "Der Kriegsflegel besteht aus zwei mit einer Eisenkette verbundenen "
    "Holzstuecken, von denen das laengere als Griff verwendet wird und das "
    "kuerzere als Schlagstueck dient, und daher mit vielen Eisenspitzen "
    "ausgestattet ist, um die Schlagwirkung noch zu erhoehen.");
  SetProp(P_NAME, "Kriegsflegel");
  SetProp(P_GENDER, MALE);
  AddId( ({"kriegsflegel", "flegel"}) );

  SetProp(P_WEAPON_TYPE, WT_CHAIN );
  SetProp(P_WC, 185);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS, 
    (["Kettenkaempfer":50, "Kettenexperte":150, "Kettenmeister":250]) );
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_BEECH: 65, MAT_IRON:35]) );
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE, 1300);
  SetProp(P_SIZE, 150);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:13]) );  

}

