inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Doppelstern");
  SetProp(P_LONG, 
    "Im Gegensatz zum Morgenstern sind am Doppelstern gleich zwei Ketten "
    "mit zwei stachelbesetzen Kugeln befestigt. Dadurch ist die "
    "Schadenswirkung bei einem Treffer noch hoeher, aber nur Meister im "
    "Kampf mit Kettenwaffen schaffen es, oefters mit beiden Kugeln den "
    "Gegner zu treffen.");
  SetProp(P_NAME, "Doppelstern");
  SetProp(P_GENDER, MALE);
  AddId( ({"doppelstern"}) );

  SetProp(P_WEAPON_TYPE, WT_CHAIN );
  SetProp(P_WC, 222);
  SetProp(P_WC_FIX, 12);
  SetProp(P_WC_BONUS, 
    (["Kettenkaempfer":50, "Kettenexperte":100, "Kettenmeister":250]) );
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_IRON: 50, MAT_OAK: 50]) );
  SetProp(P_WEIGHT, 5500);
  SetProp(P_VALUE, 1900);
  SetProp(P_SIZE, 110);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:20]) );  

  AddDetail( ({"eisenkugeln", "kugeln", "stacheln"}),
    "Die Eisenkugeln mit den Stacheln machen enormen Schaden, vor allem, "
    "wenn man mit beiden Kugel gleichzeitig trifft.");
}

