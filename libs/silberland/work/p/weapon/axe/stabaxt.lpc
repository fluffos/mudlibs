inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Stabaxt");
  SetProp(P_LONG, 
    "Die Stabaxt hat ihren Namen von dem langen Stab, der als Stiel dieser "
    "Axt dient. Ganz oben auf dem Stab ist ein einschneidiges Axtblatt und "
    "eine lange Spitze befestigt. Man kann mit dieser Waffe wie eine Axt"
    "oder wie einen Kampfstab bzw wie einen Speer verwenden. Vor allem "
    "feindliche Stab- oder Speerkaempfer kann man auf diese Weise gut "
    "parieren, ohne auf die Schlagkraft einer starken Axt verzichten zu "
    "muessen. Aber auch als Wanderstab laesst sich die Stabaxt verwenden.");
  SetProp(P_NAME, "Stabaxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"stabaxt", "axt"}) );
  SetProp(P_INFO, 
      "Wenn man will, kann man diese Waffe auch wie einen Speer halten.\n "
      "(halte stabaxt wie eine axt|ein speer).\n");

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 220);
  SetProp(P_WC_FIX, 25);
  SetProp(P_WC_BONUS,(["Axtkaempfer":60, "Axtexperte":130, "Axtmeister":220]));
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:25, MAT_BEECH:75]));
  SetProp(P_WEIGHT, 3800);
  SetProp(P_VALUE, 2000);
  SetProp(P_SIZE, 165);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:21]) );  

  AddCmd( ({"halte"}), "halten");
}

int halten(string str)
{
  string axt, art;
  notify_fail("Syntax: halte stabaxt wie eine axt|ein speer.\n");
  if(!str) return 0;
  if(sscanf(str,"%s wie %s",axt,art)!=2) return 0;
  if(!id(axt) ) return 0;
  if(art=="speer" )
  {
    write("Du haeltst die Stabaxt jetzt wie einen Speer!\n");
    SetProp(P_WEAPON_TYPE, WT_SPEAR );
    return 1;
  }
  else if(art=="axt")
  {
    write("Du haeltst die Stabaxt jetzt wie eine Axt!\n");
    SetProp(P_WEAPON_TYPE, WT_AXE );
    return 1;
  }
  return 0;
}
