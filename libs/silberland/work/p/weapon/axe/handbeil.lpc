inherit "/p/weapon/weapon_inh";

#include <properties.h>    
#include <combat.h>        

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein einfaches Handbeil");
  SetProp (P_LONG, 
    "Dieses einfache Handbeil benutzt man meist fuer das Zerkleinern von "
    "Feuerholz oder fuer andere grobe Holzarbeiten. Fuer den Kampf ist die "
    "kleine Beilklinge nur wenig geeignet.");
  SetProp (P_NAME, "Handbeil");
  SetProp (P_GENDER, NEUTER);
  AddId (({"beil", "handbeil"}));

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 90);
  SetProp(P_WC_FIX, 10);
  SetProp(P_WC_BONUS, (["Axtkaempfer":50, "Axtexperte":150, "Axtmeister":250]));
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_IRON:40, MAT_OAK:60]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 150);
  SetProp(P_SIZE, 45);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:4]) );
}
