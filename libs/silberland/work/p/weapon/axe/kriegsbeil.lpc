inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Kriegsbeil");
  SetProp(P_LONG,  
    "Das Kriegsbeil ist beteht aus einem eisenverstaerten Holzstiel und einem "
    "einblaettrigen Axtblatt, auf dessen Rueckseite ein kleiner Hammerkopf "
    "angebracht ist, um die Waffe besser auszubalancieren. Ganz oben am "
    "Stiel befindet sich noch ein spitzer Dorn, mit dem man zur Not nach dem "
    "Gegner stechen kann. Das Axtblatt ist fast fingerdick und daher sehr "
    "stabil.");
  SetProp(P_NAME, "Kriegsbeil");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"kriegsbeil", "beil"}) );

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 166);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS, (["Axtkaempfer":30, "Axtexperte":90, "Axtmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE, DT_BLUDGEON}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:30, MAT_IRON:10, MAT_ASH_WOOD:60]) );
  SetProp(P_WEIGHT, 2100);
  SetProp(P_VALUE, 1700);
  SetProp(P_SIZE, 115);
  SetProp(P_QUALITY_DECAY, 140);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:10]) );  
}

