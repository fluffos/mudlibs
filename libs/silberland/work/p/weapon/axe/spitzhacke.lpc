inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Eine Spitzhacke");
  SetProp (P_LONG, 
    "Die Spitzhacke, von den zwergischen Bergleuten auch Krampen genannt, ist "
    "ein Werkzeug fuer den Bergbau. Auf einem langen Holzstiel befindet sich "
    "ein schweres Eisenblatt, das sich auf beiden Seiten zu einer scharfen "
    "Spitze verjuengt. Selbst die haertesten Steine lassen sich damit in zwei "
    "Teile schlagen. Fuer den Kampf laesst sich diese Waffe nur bedingt "
    "verwenden, da sie sehr schlecht ausbalanciert ist.");
  SetProp (P_NAME, "Spitzhacke");
  SetProp (P_GENDER, FEMALE);
  AddId (({"hacke", "spitzhacke", "krampen"}));

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 95);
  SetProp(P_WC_FIX, 0 );
  SetProp(P_WC_BONUS, (["Axtkaempfer":50, "Axtexperte":150, "Axtmeister":270]));
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:70, MAT_OAK:30]));
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 500);
  SetProp(P_SIZE, 100);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:5]) );
}

