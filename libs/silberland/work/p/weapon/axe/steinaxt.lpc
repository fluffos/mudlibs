inherit "/p/weapon/weapon_inh";

#include <properties.h>    
#include <combat.h>        

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Eine Steinaxt");
  SetProp (P_LONG,
    "Die Steinaxt besteht aus einem langen Holzstock, auf dem am oberen "
    "Ende ein steinernes Axtblatt eingesetzt ist, das starke "
    "Bearbeitungsspuren aufweist. Sicher war es nicht leicht, dem Stein die "
    "Form eines Axtblattes zu geben. Nur sehr primitive Voelker, die keine "
    "Metalle kennen, verwenden solche Waffen.");
  SetProp (P_NAME, "Steinaxt");
  SetProp (P_GENDER, FEMALE);
  AddId (({"axt", "steinaxt"}));

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 145);
  SetProp(P_WC_FIX, 0);
  SetProp(P_WC_BONUS, (["Axtkaempfer":50, "Axtexperte":130, "Axtmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_GRANITE:40, MAT_OAK:60]) );
  SetProp(P_WEIGHT, 5500);
  SetProp(P_VALUE, 700);
  SetProp(P_SIZE, 95);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:12]) );

  AddDetail( ({"axtblatt", "blatt", "stein", "spuren", "bearbeitungsspuren"}),
    "Der Stein wurde sicher sehr lange bearbeitet, denn er sieht wirklich "
    "wie ein metallenes Axtblatt aus, obwohl er sicher nicht die gleiche "
    "Schaerfe aufweist.");

}
