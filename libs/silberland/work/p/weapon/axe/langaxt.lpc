inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Langaxt");
  SetProp(P_LONG,
    "Die Langaxt gehoert zu den schwersten Waffen, die man gerade noch "
    "zuecken kann. An einem langen Holzstiel ist eine gewaltige Beilklinge "
    "befestigt, die so lange und so stark gekruemmt ist, dass ihr Ende "
    "beinahe den Griff streift. Gewaltige Kraefte sind noetig, um diese Axt "
    "zu schwingen. Rueckhandschlaege sind mit dieser schweren Waffe "
    "unmoeglich, sodass sich auf der Rueckhandseite nicht einmal ein kleiner "
    "Hammerkopf befindet, wie es bei leichteren Aexten ueblich ist.");
  SetProp(P_NAME, "Langaxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"langaxt", "axt"}) );

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 267);
  SetProp(P_WC_FIX, 10);
  SetProp(P_WC_BONUS,(["Axtkaempfer":60, "Axtexperte":130, "Axtmeister":200]));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:45, MAT_FIR:55]));
  SetProp(P_WEIGHT, 7500);
  SetProp(P_VALUE, 2500);
  SetProp(P_SIZE, 150);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:25, P_SIZE: 155]) );  
}

