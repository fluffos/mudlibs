inherit "/p/weapon/weapon_inh";

#include <properties.h>    
#include <combat.h>        

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Eine Handaxt");
  SetProp (P_LONG, 
    "Eine praktische Handaxt, wie man sie fuer viele alltaegliche Arbeiten, "
    "aber auch fuers Kaempfen verwenden kann. Vor allem Zwerge tragen fast "
    "immer so eine Axt mit sich herum.");
  SetProp (P_NAME, "Handaxt");
  SetProp (P_GENDER, FEMALE);
  AddId (({"axt", "handaxt"}));

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 100);
  SetProp(P_WC_BONUS, 
    (["zwerg":50, "Axtkaempfer":50, "Axtexperte":150, "Axtmeister":250]) );
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_IRON:40, MAT_FIR:60]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 350);
  SetProp(P_SIZE, 50);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:4]) );
}
