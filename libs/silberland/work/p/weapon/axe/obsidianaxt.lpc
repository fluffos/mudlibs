inherit "/p/weapon/weapon_inh";

#include <properties.h>    
#include <combat.h>        

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Eine Obsidianaxt");
  SetProp (P_LONG,
    "Diese Axt hat ein sehr breites, tiefschwarz glaenzendes Axtblatt. "
    "Obwohl es sich nur um einen Stein handelt, ist die Axt trotzdem sehr "
    "gut ausbalanciert und hat eine scharfe Klinge. Der hoelzerne Stiel ist "
    "am Griff mit Leder umwickelt, um einen besseren Griff zu gewaehren.");
  SetProp (P_NAME, "Obsidianaxt");
  SetProp (P_GENDER, FEMALE);
  AddId (({"axt", "obsidianaxt"}));

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 155);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS, (["Axtkaempfer":50, "Axtexperte":150, "Axtmeister":270]));
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_OBSIDIAN:35, MAT_OAK:60, MAT_LEATHER:5]) );
  SetProp(P_WEIGHT, 4500);
  SetProp(P_VALUE, 900);
  SetProp(P_SIZE, 100);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:14]) );

  AddDetail( ({"obsidian"}),
    "Das Obsidian glaenzt tiefschwarz.");
}
