inherit "/p/weapon/weapon_inh";

#include <properties.h>    
#include <combat.h>        

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Steinbeil");
  SetProp (P_LONG, 
    "Diese primitive Waffe besteht aus einem scharfkantigen Stein, der an "
    "einem Holzstock befestigt wurde. Nur sehr primitive Voelker, die keine "
    "Metalle kennen, verwenden solche Waffen.");
  SetProp (P_NAME, "Steinbeil");
  SetProp (P_GENDER, NEUTER);
  AddId (({"beil", "steinbeil"}));

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 85);
  SetProp(P_WC_FIX, 0);
  SetProp(P_WC_BONUS, (["Axtkaempfer":50, "Axtexperte":150, "Axtmeister":250]));
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_GRANITE:40, MAT_OAK:60]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 100);
  SetProp(P_SIZE, 70);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:5]) );
}
