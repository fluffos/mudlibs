inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Pickel");
  SetProp(P_LONG,
    "Der Pickel ist ein vielseitiges Werkzeug. Man kann ihn zum Erzabbau "
    "verwenden, um beim Klettern mehr halt zu haben und sogar als Waffe. "
    "Der Pickel besteht aus einem hoelzernen Griff, auf den eine eiserne "
    "Pickelspitze aufgesetzt ist. Auf der einen Seite ist sie sehr spitz, "
    "auf der anderen stark abgeflacht. Mit der spitzen Seite kann man "
    "Loecher in Steine schlagen und sie dann mit der flachen Seite "
    "zertruemmern.");
  SetProp(P_NAME, "Pickel");
  SetProp(P_GENDER, MALE);
  AddId( ({"pickel"}) );

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 125);
  SetProp(P_WC_FIX, 25);
  SetProp(P_WC_BONUS, (["Axtkaempfer":50, "Axtexperte":130, "Axtmeister":225]));
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_BEECH:70,MAT_IRON:30]));
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 300);
  SetProp(P_SIZE, 65);
}
