inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Streitaxt");
  SetProp(P_LONG,  
    "Die Streitaxt besitzt zwei Axtblaetter und wird daher auch Doppelaxt "
    "genannt. Beide Blaetter sind stark gekruemmt, um eine bessere "
    "Schneidwirkung zu erreichen. Dazwischen befindet sich ein langer Dorn. "
    "Um besseren Halt zu gewaehren, ist der Metallstiel mit Fellstuecken "
    "umwickelt, was der ganzen Axt ein barbarisches Aussehen verleiht. Auch "
    "die kleinen Blutspritzer auf dem Axtblatt zeigen, dass diese Waffe "
    "nur fuer den Kampf gefertigt wurde.");
  SetProp(P_NAME, "Streitaxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"streitaxt", "axt", "doppelaxt", "barbarenstreitaxt"}) );
  SetProp(P_INFO, 
    "Nur maechtige Krieger koennen mit dieser Waffe kaempfen.\n");

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 257);
  SetProp(P_WC_FIX, 15);
  SetProp(P_WC_BONUS,(["Axtkaempfer":60, "Axtexperte":130, "Axtmeister":250]));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL,([MAT_STEEL:35, MAT_BRONCE:59, MAT_PELT:5, MAT_BLOOD:1]));
  SetProp(P_WEIGHT, 5500);
  SetProp(P_VALUE, 3333);
  SetProp(P_SIZE, 120);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:23, P_LEVEL:15, P_XP:300000]) );  
}

