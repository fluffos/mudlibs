inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Pike");
  SetProp(P_LONG,  
    "Die Pike ist ein ueberlanger Speer mit einer langen, metallenen Spitze. "
    "Am besten setzt man sie im Kampf gegen Reiter oder sehr grosse, wilde "
    "Tiere ein.");
  SetProp(P_NAME, "Pike");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"pike"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 205);
  SetProp(P_WC_FIX, 15);
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":150, "Speermeister":230]) );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_IRON:10, MAT_OAK:90]) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_VALUE, 900);
  SetProp(P_SIZE, 300);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:16, P_SIZE:155]) );  
}

