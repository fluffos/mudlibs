inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Hellebarde");
  SetProp(P_LONG,  
    "Diese Hellebarde ist ueber zwei Meter lang und hat eine scharfe "
    "Spitze und ein grosses Axtblatt an der Spitze. Man kann damit sowohl "
    "zustechen als auch mit grosser Reichweite zuschlagen und sich so seine "
    "Feinde vom Leib halten.");
  SetProp(P_NAME, "Hellebarde");
  SetProp(P_GENDER, FEMALE);
  AddId("hellebarde");

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 189+random(10));
  SetProp(P_WC_FIX, 45 );
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":150, "Speermeister":250]) );
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:30, MAT_OAK:70]) );
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE, 3000);
  SetProp(P_SIZE, 210);
  SetProp(P_WIELD_RESTRICTIONS, ([P_SIZE:155, A_STR:12]) );
  
  AddDetail( "spitze",
    "Die Spitze der Hellebarde ist wirklich spitz und gefaehrlich.");
  AddDetail( ({"blatt", "axtblatt"}), 
    "Das Axtblatt kann ueble Wunden verursachen." );

}

