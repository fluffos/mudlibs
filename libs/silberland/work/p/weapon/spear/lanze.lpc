inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Lanze");
  SetProp(P_LONG,  
    "Die Lanze besteht aus einem langen Holzstab mit einer metallenen "
    "Spitze mit zwei scharfen Schneiden. Man kann damit sowohl auf einem "
    "Pferd einen Lanzenangriff durchfuehren, aber auch am Boden auf seine "
    "Feinde einstechen.");
  SetProp(P_NAME, "Lanze");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"lanze"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 170);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":150, "Speermeister":250]) );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:10, MAT_OAK:90]) );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 1500);
  SetProp(P_SIZE, 230 ); 
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:8, P_SIZE:155]) );  
}

