inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Dreizack");
  SetProp(P_LONG,  
    "Der Dreizack ist ein Speer mit drei Spitzen, die alle mit Widerhaken "
    "versehen sind. Hauptsaechlich dient er dem Fischfang, aber zur Not "
    "kann man damit auch ganz gut Menschen oder andere Lebewesen abstechen.");
  SetProp(P_NAME, "Dreizack");
  SetProp(P_GENDER, MALE);
  AddId( ({"dreizack"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 130);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":170, "Speermeister":240]) );
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_RIP}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_BRONCE:30, MAT_FIR:70]) );
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 1200);
  SetProp(P_SIZE, 100);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:5]) );  
}

