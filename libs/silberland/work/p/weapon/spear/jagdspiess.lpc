inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Jagdspiess");
  SetProp(P_LONG,  
    "Der Jagdspiess ist eine speziell fuer die Jagd entwickelte Waffe. "
    "Die Speerspitze besteht aus einer langen, flachen Klinge, an deren "
    "unterem Ende zwei Querstreben angebracht sind, damit der Spiess nicht "
    "zu tief in das getroffene Wild eindringt. Wenn man einen guten Stand "
    "hat, kann man damit sogar den Sturmlauf eines wildgewordenen Ebers "
    "abfangen.");
  SetProp(P_NAME, "Jagdspiess");
  SetProp(P_GENDER, MALE);
  AddId( ({"spiess", "jagdspiess"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 155);
  SetProp(P_WC_FIX, 35);
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":150, "Speermeister":250]) );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:20, MAT_OAK:80]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 900);
  SetProp(P_SIZE, 165 ); 
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:8]) );  
}

