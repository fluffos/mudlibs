inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Harpune");
  SetProp(P_LONG,  
    "Die Harpune besteht aus einem langen, eisenbeschlagenen Stiel, der "
    "einen gefaehrlich aussehenden Widerhaken traegt. Am unteren Ende "
    "befindet sich ein Eisenring, an dem eine Lederschnur befestigt ist. "
    "Damit kann man die Harpune am Bott festbinden, wenn man einen Fisch "
    "damit harpuniert hat.");
  SetProp(P_NAME, "Harpune");
  SetProp(P_GENDER, MALE);
  AddId( ({"harpune"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 165);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":150, "Speermeister":250]) );
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_RIP}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_IRON:30, MAT_OAK:60, MAT_LEATHER:10]) );
  SetProp(P_WEIGHT, 2200);
  SetProp(P_VALUE, 900);
  SetProp(P_SIZE, 190);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:9]) );  
}

