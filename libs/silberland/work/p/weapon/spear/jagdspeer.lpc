inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Jagdspeer");
  SetProp(P_LONG,
    "Der Jagdspeer eigenet sich, wie der Name schon sagt, ideal zur Jagd "
    "auf wilde Tiere. Er ist lang genug, um angriffslustige Tiere auf "
    "Distanz halten zu koennen, und hat eine lange, scharfe Spitze, mit "
    "der man jedes Wild erlegen kann.");
  SetProp(P_NAME, "Jagdspeer");
  SetProp(P_GENDER, MALE);
  AddId( ({"speer", "jagdspeer"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_WC, 115);
  SetProp(P_WC_FIX, 25);
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":170, "Speermeister":280]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_ELM_WOOD:80, MAT_IRON:20]) );
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 800);
  SetProp(P_SIZE, 135);
  SetProp(P_QUALITY_DECAY, 110 );
}

