inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Kampfspiess");
  SetProp(P_LONG,  
    "Der Kampfspiess ist ein besonders dicker Speer, der ideal fuer den "
    "Kampf geeignet ist. Die breite, flache Klinge hat sowohl eine scharfe "
    "Spitze als auch zwei scharfe Kanten, sodass man sowohl zustechen als "
    "auch eine Schneidwirkung erreichen kann. Hinter der Klinge befinden "
    "sich seitlich zwei ebenfalls angespitze Strebeklingen. Der Stiel ist "
    "mit Eisenplatten verstaerkt und fuer die Fuehrungshand ist ein runder "
    "Handschutz eingbaut.");
  SetProp(P_NAME, "Kampfspiess");
  SetProp(P_GENDER, MALE);
  AddId( ({"spiess", "kampfspiess"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 175);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":150, "Speermeister":250]) );
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:15, MAT_IRON:20, MAT_OAK:65]) );
  SetProp(P_WEIGHT, 1800);
  SetProp(P_VALUE, 1300);
  SetProp(P_SIZE, 160 ); 
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:10]) );  
}

