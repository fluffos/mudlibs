inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Obsidianspeer");
  SetProp(P_LONG,
    "Dieser Speer besteht aus dunklem Holz, in das viele eigenartige "
    "Symbole geritzt sind. Die Speerspitze besteht aus tiefschwarz "
    "glaenzendem Obsidian und ist sehr spitz. Unterhalb der Spitze ist der "
    "Speer mit vielen bunten Vogelfedern verziert.");
  SetProp(P_NAME, "Obsidianspeer");
  SetProp(P_GENDER, MALE);
  AddId( ({"speer", "obsidianspeer"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_WC, 105);
  SetProp(P_WC_FIX, 15);
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":170, "Speermeister":280]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_TROPICAL_WOOD:80, MAT_OBSIDIAN:17,
                        MAT_FEATHER:3]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 900);
  SetProp(P_SIZE, 135);
  SetProp(P_QUALITY_DECAY, 90 );

  AddDetail( ({"feder", "federn", "vogelfeder", "vogelfedern"}),
    "Unterhalb der Spitze ist der Speer mit vielen bunten Vogelfedern "
    "verziert. Es handlet sich vor allem um Federn von Papageien.");
  AddDetail( ({"spitze", "speerspitze", "obsidian"}),
    "Die Speerspitze besteht aus tiefschwarz glaenzendem Obsidian und ist "
    "sehr spitz.");
  AddDetail( ({"symbole", "symbol"}),
    "Die eingeritzten Symbole sollen wohl Glueck fuer die Jagd und im "
    "Kampf bringen.");  
}

