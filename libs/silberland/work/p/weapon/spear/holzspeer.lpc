inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Holzspeer");
  SetProp(P_LONG,
    "Dieser primitive Speer besteht nur aus einem geraden Stueck Holz, das "
    "am oberen Ende angespitzt ist.");
  SetProp(P_NAME, "Holzspeer");
  SetProp(P_GENDER, MALE);
  AddId( ({"speer", "holzspeer"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_WC, 65);
  SetProp(P_WC_FIX, 10);
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":160, "Speermeister":270]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ({MAT_ASH_WOOD, MAT_OAK, MAT_FIR, MAT_ELM_WOOD, 
                        MAT_BEECH})[random(5)] );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 100);
  SetProp(P_SIZE, 115);
  SetProp(P_QUALITY_DECAY, 60 );
}

