inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Speer");
  SetProp(P_LONG,
    "Ein langer Speer, wie er oft von wilden Voelkern wie den Gaffos oder den "
    "Goblins verwendet wird. Er besteht eigentlich nur aus einem langen "
    "Holzstueck mit einer metallenen Spitze.");
  SetProp(P_NAME, "Speer");
  SetProp(P_GENDER, MALE);
  AddId( ({"speer"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_WC, 95);
  SetProp(P_WC_FIX, 20);
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":170, "Speermeister":280]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_ASH_WOOD:80, MAT_COPPER:20]) );
  SetProp(P_WEIGHT, 1100);
  SetProp(P_VALUE, 600);
  SetProp(P_SIZE, 110);
  SetProp(P_QUALITY_DECAY, 80 );
}

