inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Angriffsspeer");
  SetProp(P_LONG,
    "Der Angriffsspeer ist eine gefaehrliche Waffe und eignet sich sehr gut "
    "fuer lange Kaempfe. Die staehlerne Spitze ist mit grausamen Widerhaken "
    "besetzt. Der hoelzerne Stiel ist mit duennen Eisenplaettchen "
    "beschlagen, was die Haltbarkeit dieses Speeres wesentlich erhoeht.");
  SetProp(P_NAME, "Angriffsspeer");
  SetProp(P_GENDER, MALE);
  AddId( ({"speer", "angriffsspeer"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_WC, 145);
  SetProp(P_WC_FIX, 35);
  SetProp(P_WC_BONUS,
    (["Speerkaempfer":50, "Speerexperte":170, "Speermeister":250]) );
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_OAK:75, MAT_STEEL:15, MAT_IRON:10]) );
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 800);
  SetProp(P_SIZE, 135);
  SetProp(P_QUALITY_DECAY, 140 );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:7]) );
}

