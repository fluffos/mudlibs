inherit "/std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Rapier");
  SetProp(P_LONG, 
    "Das Rapier ist eine elegante Einhaenderwaffe und dient hauptsaechlich "
    "dem schnellen Kampf, wie ihn vor allem die Elfen beherrschen. "
    "Die Klinge ist sehr spitz und sehr schmal, hat aber trotzdem zwei "
    "scharfe Schneiden, sodass man mit dem Rapier nicht nur zustechen, "
    "sondern auch zuschlagen kann.");
  SetProp(P_NAME, "Rapier");
  SetProp(P_GENDER, NEUTER);
  AddId("rapier");
 
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 115);
  SetProp(P_WC_FIX, 55);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, ({ DT_SLASH, DT_PIERCE }));
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 750);
  SetProp(P_VALUE, 1100);
  SetProp(P_SIZE, 90);
}

