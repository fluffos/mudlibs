inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Bihaender");
  SetProp(P_LONG,  
    "Der Bihaender, auch Zweihaender genannt, ist ein maechtiges, "
    "zweihaendiges Schwert, mit einer fast mannslangen Klinge. Man braucht "
    "schon eine gewisse Groesse und ziemlich viel Kraft, um mit dieser "
    "Waffe vernuenftig umgehen zu koennen. Die Parierstange ist sehr breit "
    "und der Griff fuer besseren Halt mit einem blauen Tuch umwickelt. Der "
    "Knauf stellt einen Drachenkopf dar.");
  SetProp(P_NAME, "Bihaender");
  SetProp(P_GENDER, MALE);
  AddId( ({"bihaender", "schwert", "zweihaender"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 202);
  SetProp(P_WC_FIX, 35);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:95, MAT_COTTON:5]) );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 2666);
  SetProp(P_SIZE, 155);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:17, P_SIZE:155]) );  

  AddDetail( ({"knauf", "drachenkopf"}),
    "Der Knauf stellt einen Drachenkopf dar.");
  AddDetail( ({"tuch", "griff", "halt"}),
    "Der Griff ist mit einem blauen Tuch umwickelt, das Schweiss und Blut "
    "aufsaugen soll. So verliert man nie den guten Griff.");
}

