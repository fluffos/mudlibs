inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Bronzeschwert");
  SetProp(P_LONG,
    "Dieses primitive Schwert besteht aus Bronze. Es ist sehr kurz und hat "
    "nicht einmal eine richtige Parierstange. Die Spitze des Schwertes ist "
    "leicht abgerundet, sodass man auf das Zustechen vergessen muss. Dafuer "
    "weist die Klinge aber eine annehmbare Schaerfe auf.");
  SetProp(P_NAME, "Bronzeschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"bronzeschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 105);
  SetProp(P_WC_FIX, 30);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_BRONCE: 100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 400);
  SetProp(P_SIZE, 65);
  SetProp(P_QUALITY_DECAY, 90);
 
  AddDetail( ({"bronze"}),
    "Bronze eignet sich nicht so gut fuer Waffen, darum ist dieses "
    "Schwert auch von minderer Qualitaet.");
}

