inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Knochenschwert");
  SetProp(P_LONG, 
    "Dieses Schwert wurde aus einem grossen Knochen gefertigt. Es ist sehr "
    "gut bearbeitet und obwohl es nie an die Schaerfe eines Metallschwertes "
    "herranreichen kann, so liegt es doch sehr gut in der Hand.");
  SetProp(P_NAME, "Knochenschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"knochenschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 110);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_BONE:100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 300);
  SetProp(P_SIZE, 90);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:5]) ); 
  
  AddDetail( ({"knochen"}),
    "Es muss sich um den Knochen eines riesigen Tieres handeln.");
}

