inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Krummschwert");
  SetProp(P_LONG, 
    "Das Krummschwert ist eine sehr wirkungsvolle und gefaehrliche Waffe, "
    "wie sie oft von Orks verwendet wird. Die Klinge weisst eine starke "
    "Kruemmung auf, sie verbreitert sich staendig und endet in einer "
    "breiten, dreieckigen Spitze. Die Rueckseite der Klinge ist gezackt, "
    "um dem Feind den Bauch aufreissen zu koennen. Die Parierstange ist mit "
    "Daemonenfratzen verziehrt und der Griff ist mit einem blutroten Band "
    "umwickelt.");
  SetProp(P_NAME, "Krummschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"krummschwert", "schwert"}) );
  SetProp(P_INFO, 
    "Dieses  Krummschwert stammt sicher aus Kharokurg, der beruechtigten "
    "Schmiede der Orks.");

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 157);
  SetProp(P_WC_FIX, 45);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_RIP}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:90, MAT_BRASS:8, MAT_CLOTH:2]) );
  SetProp(P_WEIGHT, 1700);
  SetProp(P_VALUE, 1800);
  SetProp(P_SIZE, 90);
  SetProp(P_QUALITY_DECAY, 115);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:12]) );  
}

