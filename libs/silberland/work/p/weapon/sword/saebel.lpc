inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h> 

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Saebel");
  SetProp(P_LONG, 
    "Der Saebel hat eine leicht gekruemmte Klinge, die nur auf der "
    "Aussenseite eine Schneide aufweist, sich nach oben hin verjuengt und in "
    "eine gefaehrliche Spitze auslaeuft. Die Hand des Saebelkaempfers ist "
    "durch einen einfachen Griffkorb geschuetzt.");
  SetProp(P_NAME, "Saebel");
  SetProp(P_GENDER, MALE);
  AddId ("saebel");

  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 120);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 1250);
  SetProp(P_VALUE, 1000);
  SetProp(P_SIZE, 75);
}

