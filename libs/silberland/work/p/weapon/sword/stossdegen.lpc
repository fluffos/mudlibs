inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Stossdegen");
  SetProp(P_LONG, 
    "Mit diesem schweren Degen fuehrt man hauptsaechlich gefaehrliche Stoesse "
    "aus. Darum ist die Spitze des Stosssdegens auch verstaerkt. Der elegante "
    "Griffkorb ist voller Verziehrungen. Der Griff besteht aus eingelegtem "
    "Elfenbein." );
  SetProp(P_NAME, "Stossdegen");
  SetProp(P_GENDER, MALE);
  AddId( ({"degen", "stossdegen"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 135);
  SetProp(P_WC_FIX, 50);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL,([MAT_STEEL:90, MAT_IVORY:10 ]));
  SetProp(P_WEIGHT, 860);
  SetProp(P_VALUE, 1500);
  SetProp(P_SIZE, 85);
  SetProp(P_QUALITY_DECAY, 115);
}

