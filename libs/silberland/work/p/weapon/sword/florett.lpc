inherit "/p/weapon/weapon_inh";

#include <properties.h> 
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp( P_SHORT, "Ein einfaches Florett" );
  SetProp( P_LONG, 
    "Dieses Florett ist eine Gebrauchswaffe. Keinerlei Verzierungen schmuecken "
    "dieses zierliche Geraet. Es dient einzig zum schnellen Kampf. Die Klinge "
    "ist rund und stumpf, dafuer ist die Spitze umso gefaehrlicher und "
    "spitzer. Die Hand wird durch einen halbkugelformigen Korb geschuetzt.");
  SetProp( P_NAME, "Florett");
  SetProp( P_GENDER, NEUTER);
  AddId ("florett");

  SetProp( P_WEAPON_TYPE, WT_SWORD);
  SetProp( P_WC, 100);
  SetProp( P_WC_FIX, 65);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp( P_DAM_TYPE, DT_PIERCE);
  SetProp( P_NR_HANDS, 1);
  SetProp( P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp( P_WEIGHT, 620);
  SetProp( P_VALUE, 880);
  SetProp( P_SIZE, 90);
}

