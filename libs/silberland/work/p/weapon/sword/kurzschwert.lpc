inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

int check(string type);

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein Kurzschwert");
  SetProp(P_LONG,
    "Das Schwert hat eine kurze, aber dennoch scharfe Klinge und eine kleine "
    "Parierstange. Keinerlei Verziehrungen schmuecken diese Waffe, deshalb "
    "ist das Kurzschwert auch viel billiger als andere Schwerter. Meist wird "
    "es von unerfahrenen Kaempfern benutzt, die die Kunst des Schwertfechtens "
    "noch nicht so gut beherrschen.");
  SetProp(P_NAME, "Kurzschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert","kurzschwert" }));
 
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_WC, 110);
  SetProp(P_WC_FIX, 30);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 600); 
  SetProp(P_SIZE, 50);

  AddCmd( ({"fuehre", "fuehr"}), "cmd_fuehren");
}

int cmd_fuehren(string str)
{
  string was;

  notify_fail("Was willst Du fuehren?\n");
  if(!str || str == "") return 0;

  if( sscanf(str, "%s als dolch", was) == 1 && id(was) )
  {
    if( !check(WT_KNIFE) ) return -1;
    write("Du fuehrst " + name(WEN,1) + " jetzt als Dolch.\n");
    SetProp(P_WEAPON_TYPE, WT_KNIFE);
    AddId("dolch");
    RemoveId("schwert");
    return 1;
  }
  else if( sscanf(str, "%s mit hand", was) == 1 && id(was) )
  {
    if( !check(WT_SWORD) ) return -1;
    write("Du fuehrst " + name(WEN,1) + " jetzt als Schwert.\n");
    SetProp(P_WEAPON_TYPE, WT_SWORD);
    RemoveId("dolch");
    AddId("schwert");
    return 1;
  }
  return 0;
}

int check(string type)
{
  if( QueryProp(P_WEAPON_TYPE) == type)
  {
    write("Aber Du fuehrst " + name(WEN,1) + " doch schon als " +
        (type == WT_KNIFE ? "Dolch" : "Schwert") + "!\n");
    return 0;
  }
  if( QueryProp(P_WIELDED) )
  {
    write("Du musst " + name(WEN,1) + " zuerst wegstecken, um es anders "
        "zu fuehren!\n");
    return 0;
  }
  return 1;
}

