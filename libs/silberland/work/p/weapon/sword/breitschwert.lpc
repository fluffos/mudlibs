inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Breitschwert");
  SetProp(P_LONG,  
    "Die Klinge des Breitschwertes ist, wie der Name schon sagt, breiter als "
    "bei einem normalen Schwert und deshalb kann ein starker Kaempfer damit "
    "auf mehr Schaden anrichten. Das Griffstueck ist mit kleinen Haemmern "
    "und Ambossen verziehrt." );
  SetProp(P_NAME, "Breitschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"breitschwert", "schwert"}) );
  SetProp(P_INFO, 
    "Ein kleines 'F' am Knauf verraet, dass dieses Schwert aus den Schmieden "
    "von Felonia stammt.");

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 160);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL :100]) );
  SetProp(P_WEIGHT, 1700);
  SetProp(P_VALUE, 1600);
  SetProp(P_SIZE, 95);
  SetProp(P_QUALITY_DECAY, 110);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:10]) ); 
}

