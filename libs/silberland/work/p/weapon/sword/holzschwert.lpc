inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Holzschwert");
  SetProp(P_LONG, 
    "Dieses kurze Schwert wurde aus einem besonders harten Holz gefertigt. "
    "Darum ist es kein wirkliches Spielzeug, auch wenn es so aussehen "
    "sollte. Die Schneide ist erstaunlich scharf, auch wenn sie nicht ganz "
    "mit einem Stahlschwert mithalten kann.");
  SetProp(P_NAME, "Holzschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"holzschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 90);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_TROPICAL_WOOD:100]) );
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 300);
  SetProp(P_SIZE, 75);
  SetProp(P_QUALITY_DECAY, 75);
 
  AddDetail( ({"holz", "maserung"}),
    "Das Holz ist sehr hart und schaut sehr exotisch aus. Die dunkle "
    "Maserung verlaeuft genau parallel zur Schneide.");
}

