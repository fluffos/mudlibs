inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Degen");
  SetProp(P_LONG, 
    "Ein leichter Degen. Man kann ihn leicht fuehren, er ist gut "
    "ausbalanziert und liegt angenehm in der Hand. Er hat einen schmucklosen " 
    "Griffkorb, der die Hand schuetzt." );
  SetProp(P_NAME, "Degen");
  SetProp(P_GENDER, MALE);
  AddId( ({"degen"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 110);
  SetProp(P_WC_FIX, 50);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL,([MAT_STEEL:100 ]));
  SetProp(P_WEIGHT, 660);
  SetProp(P_VALUE, 700);
  SetProp(P_SIZE, 90);
  SetProp(P_QUALITY_DECAY, 75);
}

