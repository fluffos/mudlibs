inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Flamberge");
  SetProp(P_LONG, 
    "Die Flamberge ist ein gewaltiges, zweihaendiges Schwert mit einer "
    "schmalen, stark gewellten Klinge. Angeblich soll durch diese Wellung "
    "die Schneidwirkung verstaerkt werden, was sich vor allem bei stark "
    "geruesteten Gegnern bemerkbar macht. Die Parierstange ist sehr breit "
    "und der Griff ist mit Fell umwickelt.");
  SetProp(P_NAME, "Flamberge");
  SetProp(P_GENDER, MALE);
  AddId( ({"flamberge", "schwert", "zweihaender"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 235);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":60, "Schwertexperte":120, "Schwertmeister":265]));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:97, MAT_PELT:3]) );
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE, 3000);
  SetProp(P_SIZE, 165);
  SetProp(P_QUALITY_DECAY, 130);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:19, P_SIZE:155]) );  

}

