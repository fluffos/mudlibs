inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Langschwert");
  SetProp(P_LONG,  
    "Dieses Langschwert hat eine lange, schmale und sehr scharfe Klinge und "
    "eine breite Parierstange. Es liegt sehr gut in der Hand, denn der Griff "
    "ist mit einem Lederband umwickelt. Man kann damit sowohl auf seinen "
    "Gegner einschlagen als auch mit der Spitze zustechen." );
  SetProp(P_NAME, "Langschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"langschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 50);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL :95, MAT_LEATHER:5]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 1500);
  SetProp(P_SIZE, 105);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:8]) ); 
  
}

