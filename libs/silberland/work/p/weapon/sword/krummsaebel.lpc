inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Krummsaebel");
  SetProp(P_LONG,
    "Der Krummsaebel ist eine gefaehrliche Waffe, denn die Klinge ist "
    "gezackt und hinterlaesst graessliche Wunden, wenn man damit einen "
    "guten Treffer landet. Vor allem Orks verwenden solche brutalen Waffen, "
    "denn sie erfreuen sich immer an den Schmerzen ihrer Feinde.");
  SetProp(P_NAME, "Krummsaebel");
  SetProp(P_GENDER, MALE);
  AddId( ({"krummsaebel", "saebel"}) );
  SetProp(P_INFO, 
    "Dieser Krummsaebel stammt sicher aus Kharokurg, der beruechtigten "
    "Schmiede der Orks.");

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 145);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_RIP}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 1300);
  SetProp(P_SIZE, 80);
  SetProp(P_QUALITY_DECAY, 115);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:10]) );  
}

