inherit "/p/weapon/weapon_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Obsidianschwert");
  SetProp(P_LONG,
    "Die Klinge dieses Schwertes besteht aus schwarz glaenzendem Obsidian. "
    "Sie wurde aus einem langen Steinsplitter gefertigt und so exzellent "
    "bearbeitet, dass man kaum Bearbeitungsspuren erkennen kann. Der Griff "
    "besteht aus ebenfalls tiefschwarzen, schoen gemasertem Holz.");
  SetProp(P_NAME, "Obsidianschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"obsidianschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 140);
  SetProp(P_WC_FIX, 25);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_OBSIDIAN: 90, MAT_EBONY:10]) );
  SetProp(P_WEIGHT, 1400);
  SetProp(P_VALUE, 1200);
  SetProp(P_SIZE, 85);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:12]) ); 
 
  AddDetail( ({"obsidian"}),
    "Der Obsidian glitzert schwarz.");
}

