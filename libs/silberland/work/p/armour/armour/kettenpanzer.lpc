inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Kettenpanzer");
  SetProp(P_LONG,  
    "Das ist ein Kettenpanzer, wie in nur Ritter tragen. Die schweren Ketten "
    "schuetzen den Koeper zwar vorzueglich, aber schraenken doch den Traeger "
    "stark in seiner Bewegungsfreiheit ein. Dieser Panzer ist von sehr alter "
    "Machart, aber trotzdem noch sehr gut erhalten. An einigen Stellen sind "
    "dicke Stahlplatten in das Kettengewebe eingearbeitet, um besonders "
    "verletzliche Stellen noch besser zu schuetzen.") ;
  SetProp(P_NAME, "Kettenpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "kettenpanzer"}) );
  SetProp(P_INFO, 
    "Schmale Stichwaffen moegen schon hie und da durch eine Luecke in der "
    "Panzerung dringen koennen, dafuer gleiten aber Schwert- und Axthiebe "
    "ohne Schaden zu machen daran ab.");

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 34);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 4000);
  SetProp(P_VALUE, 3200);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR: 15]) );
}

