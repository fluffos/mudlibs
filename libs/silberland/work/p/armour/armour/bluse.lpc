inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp( P_SHORT, "Eine Bluse aus feinster Seide");
  SetProp( P_LONG,
     "Diese Bluse ist aus feinster Seide und sehr weich und anschmiegsam. "
     "Die weiblichen Proportionen werden so sehr vorteilhaft hervorgehoben. "
     "Die kleinen Knoepfe sind aus in allen regenbogenfarben schillerndem "
     "Perlmutt gemacht.");
  SetProp( P_NAME, "Bluse");
  SetProp( P_GENDER, FEMALE);
  AddId (({"bluse", "seidenbluse"}));
  
  SetProp( P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp( P_AC, 10);
  SetProp( P_MATERIAL, ([MAT_SILK:95, MAT_PEARL:5]) );
  SetProp( P_WEIGHT, 150);
  SetProp( P_VALUE, 790);
  SetProp( P_QUALITY_DECAY, 80);
  SetProp( P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]));
  SetProp( P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2, T_HEAT_PROT:0]) );

  AddDetail( ({"seide"}),
    "Die Seide ist sehr weich und anschmiegsam, genau wie es viele Frauen "
    "lieben.");
  AddDetail( ({"knopf", "knoepfe", "perlmutt"}),
    "Das Perlmutt, uas dem die Knoepfe gefertig wurden, schillert in allen "
    "Farben des Regenbogens.");
}
