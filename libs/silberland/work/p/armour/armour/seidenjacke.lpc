inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Seidenjacke");
  SetProp(P_LONG,
    "Diese Jacke ist aus feinster Seide genaeht worden. Sie ist in lustig "
    "bunten Farben bedruckt. Sie gehoerte sicher einmal einem Zauberer. Wie "
    "eine perfekte Ruestung sieht sie ja nicht aus, jedoch ist sie dank ihrer "
    "kuenstlerischen Bemalung sicher einiges wert.");
  SetProp(P_NAME, "Seidenjacke");
  SetProp(P_GENDER, FEMALE);
  AddId(({"jacke","seidenjacke"}));

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 10);	
  SetProp(P_MATERIAL, ([MAT_SILK:100]));
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 2000);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0,T_HEAT_PROT:1]) );
}
