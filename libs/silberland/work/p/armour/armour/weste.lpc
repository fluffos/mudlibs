inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Stoffweste");
  SetProp(P_LONG, 
    "Du siehst eine braune Weste aus sehr dicht gewobenem Stoff. "
    "Vorne an der Brust scheint sie mit duennen Knochenleisten verstaerkt "
    "zu sein. An den Ellenbogen ist sie mit ledernen Flecken versehen. "
    "Vorne sind Knoepfe dran, damit man die Weste zumachen kann.");
  SetProp(P_NAME, "Weste");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"weste", "stoffweste"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL,([MAT_CLOTH:45, MAT_FUR:10, MAT_LEATHER:5,MAT_BONE:15,  
      MAT_BRASS:4, MAT_WOOL:21]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 350);
}
