inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Eine Lederruestung");
  SetProp (P_LONG,
    "Die Lederruestung besteht aus gegerbtem Leder. Nur an den Schultern ist "
    "das Leder zusaetzlich verstaerkt. Insgesamt handelt es sich um eine "
    "einfache Ruestung, die nur wenig Schutz bietet, dafuer aber sehr billig "
    "ist und daher bei armen Kaempfern sehr beliebt ist.");
  SetProp (P_NAME, "Lederruestung");
  SetProp (P_GENDER, FEMALE);
  AddId (({"ruestung","lederruestung"}));
  
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR); 
  SetProp (P_AC, 15);
  SetProp (P_MATERIAL, MAT_LEATHER);
  SetProp (P_WEIGHT, 1500);
  SetProp (P_VALUE, 500);
  
  AddDetail( "leder",
    "Es laesst sich nicht mehr feststellen, von welchem Tier das Leder "
    "dieser Ruestung stammt.");
}
