inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  string animal;
  if( !is_clone(this_object()) ) return;
  ::create();

  switch(random(4) )
  {
    case 0: animal="eines Polarfuches";break;
    case 1: animal="eines Eiswolfes";break;
    case 2: animal="eines Polarbaeren";break;
    case 3: animal="von Schneehasen";break;
  }
  SetProp(P_SHORT, "Eine Pelzjacke");
  SetProp(P_LONG, 
    "Eine dicke, warme Pelzjacke aus dem Pelz "+animal+". Sie ist wohl kein "
    "allzuguter Ruestungschutz, dafuer bietet sie umsomehr Schutz gegen die "
    "grimmige Kaelte des hohen Nordens.");
  SetProp(P_NAME, "Pelzjacke");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"jacke", "pelzjacke"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 15);
  SetProp(P_MATERIAL, ([MAT_PELT:100]));
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 2500);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:7, T_HEAT_PROT:-7 ]) );
}

