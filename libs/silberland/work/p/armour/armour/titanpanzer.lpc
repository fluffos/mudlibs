inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Titanpanzer");
  SetProp (P_LONG, 
    "Dieser Panzer besteht aus zwei Platten aus hartem, aber sehr leichtem "
    "Titan, die Brust und Ruecken schuetzen. Verbunden sind sie durch ein "
    "bewegliches Scharnier, mit dem man den Panzer auf verschiedene Groessen "
    "des Brustkorbes einstellen kann. So bleibt der gesamte Oberkoerper immer "
    "gut geschuetzt.");
  SetProp (P_NAME, "Titanpanzer");
  SetProp (P_GENDER, MALE);
  AddId (({"panzer","titanpanzer"}));
  
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 33);
  SetProp (P_MATERIAL, MAT_TITANIUM);
  SetProp (P_WEIGHT, 1750);
  SetProp (P_VALUE, 2700);

  AddDetail ("titan", 
    "Das Titan des Panzers scheint nahezu undurchdringbar zu sein, ohne "
    "jedoch uebermaessig viel zu wiegen.");
  AddDetail( "scharnier",
    "Mit dem beweglichen Scharnier kann man den Panzer auf verschiedene "
    "Groessen des Brustkorbes einstellen.");
}

