inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  string matname,mat;
  int value;
  if (!is_clone(this_object())) return;
  ::create();

  switch( random(10) )
  {
    case 0..1: matname="Eisennieten"; mat=MAT_IRON; value=200;break;
    case 2..3: matname="Bronzeplatten"; mat=MAT_BRONCE; value=100;break;
    case 4..5: matname="dicke Kupferscheiben"; mat=MAT_COPPER; break;
    case 6..8: matname="eingearbeitete Knochen"; mat=MAT_BONE; value=0;break;
    case 9: matname="kleine Elfenbeinstuecke"; mat=MAT_IVORY; value=300;break; 
  }
  SetProp (P_SHORT, "Ein Lederpanzer");
  SetProp (P_LONG,
    "Der Lederpanzer besteht aus gehaertetem Leder und ist ein ganz guter "
    "Schutz fuer den Oberkoerper. An einigen Stellen ist der Panzer durch "
     +matname+" verstaerkt.");
  SetProp (P_NAME, "Lederpanzer");
  SetProp (P_GENDER, MALE);
  AddId (({"panzer","lederpanzer"}));

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR); 
  SetProp (P_AC, 22);
  SetProp (P_MATERIAL, ([MAT_LEATHER:85, mat:15]) );
  SetProp (P_WEIGHT, 1800);
  SetProp (P_VALUE, 700+value);

  AddDetail( ({"leder"}),
    "Das Leder wurde mit Wachs gehaertet, darum schuetzt es weitaus besser "
    "als andere Ruestungen aus Leder.");
  SetProp(P_SMELL,
    "Am Leder kann man noch Geruchsspuren der Gerbfluessigkeiten "
    "feststellen.\n");
}
