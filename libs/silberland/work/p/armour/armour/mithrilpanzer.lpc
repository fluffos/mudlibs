inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Mithrilpanzer");
  SetProp (P_LONG,
    "Dieser herrliche Kettenpanzer wurde vollstaendig aus Mithril gefertigt. "
    "Die Kettenglieder sind poliert und glitzern silbrig. An einigen "
    "wichtigen Stellen sind Platten in das Kettengewebe eingearbeitet, um "
    "die Schutzwirkung noch zu verstaerken. Alle Platten sind fein ziseliert "
    "und mit Runen und Symbolen geschmueckt.");
  SetProp (P_NAME, "Mithrilpanzer");
  SetProp (P_GENDER, MALE);
  AddId (({"panzer","mithrilpanzer", "kettenpanzer"}));

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 39);
  SetProp (P_MATERIAL, MAT_MITHRIL);
  SetProp (P_WEIGHT, 3000);
  SetProp (P_VALUE, 8500);
  SetProp (P_QUALITY_DECAY, 250);
  SetProp (P_WEAR_RESTRICTIONS, ([A_STR:15]) );

  AddDetail( ({"mithril"}),
    "Das Mithril glaenzt und strahlt wie frischpoliertes Silber.");
  AddDetail( ({"platten"}),
    "Die Platten sind in die Ketten eingearbeitet, um die besonders "
    "wichtigen Koerperteile zu schuetzen. Sie sind fein ziseliert "
    "und mit Runen und Symbolen geschmueckt.");
  AddDetail( ({"runen", "rune", "symbole", "symbol"}),
    "Es handelt sich um Runen des Schutzes und um Symbole der zwergischen "
    "Schmiede, wie zB Hammer und Amboss oder zwei gekreuzte Aexte.");
  
}
