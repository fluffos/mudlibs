inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Kettenhemd");
  SetProp(P_LONG,
    "Dieses Kettenhemd ist aus einem sehr widerstandsfaehigen Material und "
    "hat schon so manchem Soldaten das Leben gerettet. Es besteht aus feinen "
    "Kettengliedern, die zu einem Hemd zusammengewoben sind. Dadurch ist man "
    "gut geschuetzt und trotzdem noch sehr beweglich. Besonders beliebt sind "
    "solche Kettenhemden bei den Zwergen und menschlichen Soldaten.");
  SetProp(P_NAME, "Kettenhemd");
  SetProp(P_GENDER, NEUTER);
  AddId("kettenhemd");
  
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, ([MAT_IRON:100]) );
  SetProp(P_WEIGHT, 3700);
  SetProp(P_VALUE, 2000);
  SetProp(P_QUALITY_DECAY, 120);

  AddDetail( ({"kettenglieder", "glieder"}),
    "Die Kettenglieder sind so engmaschig, dass keine Waffe sie durchdringen "
    "kann. Nur zwergische Schmiede verstehen es, aus Metall so feine "
    "Kettenglieder zu formen und dann zu einem Hemd zu verweben.");
}
