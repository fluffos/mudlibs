inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Eisenpanzer");
  SetProp (P_LONG,
    "Der Panzer besteht aus zwei Platten aus schwerem Eisen, von denen die "
    "eine die Brust und die andere den Ruecken schuetzt. Beide Platten sind "
    "durch Eisenringe verbunden, um dem Oberkoerper noch einige "
    "Bewegungsfreiheit zu gewaehren.");
  SetProp (P_NAME, "Eisenpanzer");
  SetProp (P_GENDER, MALE);
  AddId (({"panzer","eisenpanzer"}));
  
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 30);
  SetProp (P_MATERIAL, ([MAT_IRON:100]) );
  SetProp (P_WEIGHT, 3500);
  SetProp (P_VALUE, 1700);

  AddDetail("eisen", 
    "Schweres Eisen bildet die Grundlage fuer den Schutz, den dieser "
    "Eisenpanzer seinem Traeger bietet.");
  AddDetail( ({"platten", "platte"}),
    "Eine Platte schuetzt die Brust, die andere den Ruecken.");
  AddDetail( ({"ringe", "eisenringe"}),
    "Die Eisenringe verbinden die beiden Eisenplatten. Sie gewaehrem dem "
    "Oberkoerper etwas mehr Bewegungsfreiheit, als eine Vollruestung, sind "
    "aber auch ein Schwachpunkt, weil der Koerper so an der Seite schlechter "
    "geschuetzt ist.");
}
