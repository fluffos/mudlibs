inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Brustpanzer");
  SetProp (P_LONG,
    "Der Brustpanzer ist mit vielen silernen und goldenen Verzierungen "
    "versehen und und ist am Rand mit einer seidenen Spitzenborte verziert. "
    "Aufgrund seiner zierlichen Proportionen kann der nur einer Frau "
    "gehoeren.");
  SetProp (P_NAME, "Brustpanzer");
  SetProp (P_GENDER, MALE);
  AddId (({"panzer","brustpanzer"}));
  SetProp(P_INFO, 
    "Der Brustpanzer scheint gegen Luftangriffe zu schuetzen.");
  
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 33);
  SetProp (P_MATERIAL, ([MAT_SILVER:10, MAT_GOLD:10, MAT_BRASS:70, 
                         MAT_SILK:10]));
  SetProp (P_WEIGHT, 2250);
  SetProp (P_VALUE, 2600);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_AIR:1]) );  
}

