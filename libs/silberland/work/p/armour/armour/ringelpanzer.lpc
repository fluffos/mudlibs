inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Ringelpanzer");
  SetProp (P_LONG,
    "Der Ringelpanzer besteht aus einer Lederruestung, in die viele kleine "
    "Metallringe eingenaeht wurden. So wird die Schutzwirkung der Ruestung "
    "um vieles erhoeht, das Gewicht ist aber viel geringer als bei einer "
    "Vollmetallruestung.");
  SetProp (P_NAME, "Ringelpanzer");
  SetProp (P_GENDER, MALE);
  AddId (({"panzer","ringelpanzer"}));
  
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 27);
  SetProp (P_MATERIAL, ([MAT_BRASS:20, MAT_LEATHER:80]));
  SetProp (P_WEIGHT, 2880);
  SetProp (P_VALUE, 1500);
}
