inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Bronzepanzer");
  SetProp(P_LONG,  
    "Der Bronzepanzer hat eine leicht rundliche Form, sodass er nicht direkt "
    "am Koerper aufliegt. So ist zwar die Schutzwirkung etwas geringer, "
    "dafuer bildet sich aber unter dem Panzer eine kuehlende Luftschicht. "
    "Auf der Brustplatte befindet sich in der Mitte eine Verstaerkung, die "
    "wie ein kuenstliches Brustbein aussieht, und auch so wirkt, denn dadurch "
    "werden Treffer von der Mitte weiter nach aussen geleitet.");
  SetProp(P_NAME, "Bronzepanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "bronzepanzer"}) );
  SetProp(P_INFO, 
    "Dieser Panzer haelt nicht nur Schlaege ab, sondern auch die Strahlung "
    "der Sonne. Vielleicht kann er auch Hitze und Feuer abwehren.");

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 27);
  SetProp(P_MATERIAL, MAT_BRONCE );
  SetProp(P_WEIGHT, 3300);
  SetProp(P_VALUE, 1750);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2,T_HEAT_PROT:1]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ ([DT_FIRE:1]) );
  
  AddDetail( "bronze",
    "Bronze eignet sich sehr gut fuer Ruestungen.");
  AddDetail( ({"verstaerkung", "brustbein"}),
    "Auf der Brustplatte befindet sich in der Mitte eine Verstaerkung, die "
    "wie ein kuenstliches Brustbein aussieht, und auch so wirkt, denn dadurch "
    "werden Treffer von der Mitte weiter nach aussen geleitet.");
}

