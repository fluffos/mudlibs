inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Eine Messingruestung");
  SetProp (P_LONG,
    "Die Ruestung besteht aus lauter kleinen Messingplaettchen, die mittels "
    "eines Drahtes miteinander verflochten sind. Das ganze aehnelt einer "
    "Mischung aus Kettenhemd und Schuppenpanzer, doch diese Ruestung ist von "
    "der Schutzwirkung sicherlich schlechter als jeder dieser beiden "
    "Ruestungen. Dafuer ist die Messingruestung aber auch um vieles billiger.");
  SetProp (P_NAME, "Messingruestung");
  SetProp (P_GENDER, FEMALE);
  AddId (({"ruestung","messingruestung"}));
  
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 25);
  SetProp (P_MATERIAL, ([MAT_BRASS:85, MAT_COPPER:15]) );
  SetProp (P_WEIGHT, 2500);
  SetProp (P_VALUE, 700);
  SetProp (P_WEAR_RESTRICTIONS, ([A_STR:5 ]) );
}


