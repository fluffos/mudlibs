inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Plattenpanzer");
  SetProp (P_LONG,
    "Der Plattenpanzer besteht komplett aus Stahlplatten, die den Koeper fast "
    "vollstaendig umschliessen. Kaum ein Treffer kann durch diese schwere "
    "Ruestung dringen. Vor allem Ritter tragen solche Ruestungen, denn fuer "
    "einen Fusskaempfer ist der Plattenpanzer fast zu schwer und behindert "
    "die Bewegungsfreiheit zu viel.");
  SetProp (P_NAME, "Plattenpanzer");
  SetProp (P_GENDER, MALE);
  AddId (({"panzer","plattenpanzer"}));

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 36);
  SetProp (P_MATERIAL, MAT_STEEL);
  SetProp (P_WEIGHT, 4500);
  SetProp (P_VALUE, 2800);
  SetProp (P_QUALITY_DECAY, 140 );
  SetProp (P_WEAR_RESTRICTIONS, ([A_STR:18, A_CON:15]) );

}

