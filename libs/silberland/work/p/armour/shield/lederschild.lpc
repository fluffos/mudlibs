inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Lederschild");
  SetProp(P_LONG, 
    "Der Schild besteht aus dickem Leder, das auf einen runden Rahmen aus Holz "
    "aufgezogen ist. Dadurch ist der Schild sehr leicht, wird aber auch "
    "schnell kaputt.");
  SetProp(P_NAME, "Lederschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild","lederschild"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_SHIELD); 
  SetProp(P_AC, 11); 
  SetProp(P_MATERIAL, ([MAT_LEATHER:80, MAT_FIR:20]) );
  SetProp(P_WEIGHT,  800);
  SetProp(P_VALUE, 350);
  SetProp(P_QUALITY_DECAY, 60);
  
  AddDetail( ({"leder"}),
    "Das Leder des Schildes ist sehr dick und kann sicher einige Schlaege "
    "abfangen.");
}

