inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Kupferschild");
  SetProp(P_LONG, 
    "Der Schild besteht aus beschlagenem Kupfer. An einigen Stellen weist "
    "der Schild Dellen auf, wo das Kupfer nicht so gut verarbeitet wurde. Er "
    "hat eine dreieckige Form." );
  SetProp(P_NAME, "Kupferschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild","kupferschild"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_SHIELD); 
  SetProp(P_AC, 15); 
  SetProp(P_MATERIAL, MAT_COPPER);
  SetProp(P_WEIGHT, 1900);
  SetProp(P_VALUE, 650);
  SetProp(P_QUALITY_DECAY, 90);

  AddDetail ("kupfer",
    "Gewoehnliches beschlagenes Kupfer.");
}

