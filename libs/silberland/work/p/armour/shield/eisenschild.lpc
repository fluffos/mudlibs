inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Eisenschild");
  SetProp(P_LONG, 
    "Der Schild besteht aus schwerem Eisen. Er ist voellig rund, daher "
    "koennte man den ihn auch als Rundschild bezeichnen.");
  SetProp(P_NAME, "Eisenschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild","eisenschild", "rundschild"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 23);
  SetProp(P_MATERIAL, MAT_IRON);
  SetProp(P_WEIGHT, 2800);
  SetProp(P_VALUE, 1000);
  SetProp(P_QUALITY_DECAY, 110);

  AddDetail("eisen", "Schweres Eisen macht es den Schwertern der Gegner "+
    "schwerer, dem Traeger dieses Schildes Verletzungen zuzufuegen.");
}

