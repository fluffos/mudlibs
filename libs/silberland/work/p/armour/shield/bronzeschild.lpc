inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Bronzeschild");
  SetProp(P_LONG, 
    "Der Schild besteht aus beschlagener Bronze und ist ein sehr guter Schutz "
    "fuer einen Schwertkaempfer. Da er nicht zu gross ist, behindert er auch "
    "nicht so sehr wie ein grosser Schild.");
  SetProp(P_NAME, "Bronzeschild");
  SetProp(P_GENDER, MALE);
  AddId (({"schild","bronzeschild"}));
  
  SetProp(P_ARMOUR_TYPE, AT_SHIELD); 
  SetProp(P_AC, 20); 
  SetProp(P_MATERIAL, MAT_BRONCE);
  SetProp(P_WEIGHT, 1600);
  SetProp(P_VALUE, 800);
  SetProp(P_QUALITY_DECAY, 130);

  AddDetail( ({"bronze"}),
    "Bronze eignet sich sehr gut fuer Ruestungen und fuer Schilde.");
}

