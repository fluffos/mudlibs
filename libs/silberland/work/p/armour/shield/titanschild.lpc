inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Titanschild");
  SetProp(P_LONG,  
    "Dieser Schild aus Titan ist wesentlich leichter als alle anderen "
    "Schilder aus Metall. Trotzdem hat es eine ebenbuertige Schutzwirkung. "
    "Der Rand des laenglichen Schildes ist leicht abgerundet, damit man "
    "sich nicht selbst an einer scharfen Kante verletzen kann.") ;
  SetProp(P_NAME, "Titanschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild", "titanschild"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 24);
  SetProp(P_MATERIAL, ([MAT_TITANIUM:100]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 1200);
  SetProp(P_QUALITY_DECAY, 125);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:15]) );

  AddDetail( ({"titan"}),
    "Titan ist sehr hart und stabil, aber troztdem sehr leicht. Deshalb ist "
    "auch dieser Schild fuer seine exzellente Schutzwirkung auch sehr "
    "leicht.");
    
}

