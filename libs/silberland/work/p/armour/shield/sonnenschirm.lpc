inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp(P_SHORT, "Ein schicker Sonnenschirm");
  SetProp(P_LONG,
      "Dieser Sonnenschirm kann Dich bestimmt gut vor der Hitze schuetzen. "
      "Du kannst ihn aufspannen oder auch wieder zuklappen.");
  SetProp(P_NAME, "Sonnenschirm");
  SetProp(P_GENDER, MALE);
  AddId( ({"sonnenschirm", "schirm"}) );
  SetProp(P_INFO,
      "Dieser Sonnenschirm ist ein hervorragender Hitzeschutz.\n");
  
  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([ MAT_ASH_WOOD:15, MAT_CLOTH:85 ]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 3000);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:0, T_HEAT_PROT:8 ]) );
  SetProp(P_WORN_TEXT, "aufgespannt");
  SetProp(P_WEAR_TEXT,
          ({ "Du spannst den Sonnenschirm auf.\n",
             " spannt einen Sonnenschirm auf.\n" }) );
  SetProp(P_UNWEAR_TEXT,
          ({ "Du klappst den Sonnenschirm zu.\n",
             " klappt einen Sonnenschirm zu.\n" }) );

  AddCmd ( ({"klapp","klappe"}), "klappe" );
  AddCmd ( ({"spann","spanne"}), "spanne" );
}

int spanne(string str)
{
  string ob;
  if(!str) return 0;
  if(sscanf(str, "%s auf", ob)==1 ) return do_wear(ob);
  return 0;
}

int klappe(string str)
{
  string ob;
  if(!str) return 0;
  if(sscanf(str, "%s auf", ob)==1 ) return do_wear(ob);
  if(sscanf(str, "%s ein", ob)==1 ) return do_unwear(ob);
  if(sscanf(str, "%s zu", ob)==1 ) return do_unwear(ob);
  if(sscanf(str, "%s zusammen", ob)==1 ) return do_unwear(ob);
  return 0;
}

