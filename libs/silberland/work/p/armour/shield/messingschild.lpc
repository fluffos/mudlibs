inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Messingschild");
  SetProp(P_LONG,
    "Ein einfacher Schild, der aus Messing gefertigt wurde. Er ist rund "
    "und hat kreuzfoermige Verstrebungen, um dem Schild mehr Stabilitaet "
    "zu geben. Durch die starke Woelbung prallen vor allem Pfeile sehr gut "
    "an diesem Schild ab.");
  SetProp(P_NAME, "Messingschild");
  SetProp(P_GENDER, MALE);
  AddId (({"schild","messingschild"}));
  
  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 17);
  SetProp(P_MATERIAL, MAT_BRASS);
  SetProp(P_WEIGHT, 1600);
  SetProp(P_VALUE, 500);
  SetProp(P_QUALITY_DECAY, 90);

  AddDetail( ({"messing", "form"}),
    "Das Messing wurde hauptsaechlich durch Haemmern in die richtige "
    "Form gebracht. An einigen Stellen kann man noch Spuren dieser "
    "Bearbeitung erkennen.");
  AddDetail( ({"spuren", "stellen"}),
    "Einige Stellen auf dem Schild weisen noch Spuren der Bearbeitung "
    "durch Haemmern auf.");
}

