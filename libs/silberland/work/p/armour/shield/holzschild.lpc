inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Holzschild");
  SetProp(P_LONG, 
    "Dieser einfache Schild besteht aus mehreren Holzbrettern, die zu einem "
    "rechteckigen Schild zusammengefuegt wurden. Sogar der Griff in der "
    "Mitte des Schildes ist aus Holz. Auf die Vorderseite ist ein "
    "Wappen gemalt.");
  SetProp(P_NAME, "Holzschild");
  SetProp(P_GENDER, MALE);
  AddId (({"schild","holzschild"}));
  
  SetProp(P_ARMOUR_TYPE, AT_SHIELD); 
  SetProp(P_AC, 13); 
  SetProp (P_MATERIAL, 
    ({MAT_BEECH, MAT_OAK, MAT_YEW_WOOD, MAT_ELM_WOOD, MAT_FIR})[random(5)]);
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 200);
  SetProp(P_QUALITY_DECAY, 75);

  AddDetail( ({"holz"}),
    "Du bist Dir nicht sicher, um welches Holz es sich handelt. Vielleicht "
    "solltest Du den Schild genauer identifizieren.");

  AddDetail( ({"wappen"}),
    "      -------------------------------\n"
    "      |3\\    WWW    |      |||      |\n"
    "      | \\\\  -{?|    |      |||      |\n"
    "      |  \\XXXXX\\    |      |||      |\n"
    "      |  __/XXXX\\   |------+|+------|\n"
    "      | 3XXX/\\XXX\\  |-------+-------|\n"
    "      |    ___/XXX\\/|------+|+------|\n"
    "      |    \\XXX//X/ |      |||      |\n"
    "      |   _/X/  \\X\\ |      |||      |\n"
    "      |  3XX/  3XX/ |      |||      |\n"
    "      |------------------------------\n"
    "      | \\$$\\        |3\\    WWW      |\n"
    "      |  \\$$\\       | \\\\  -{?| W    |\n"
    "      |   \\  \\      |  \\XXXXX//     |\n"
    "       \\   \\$$\\     |  __/XXX\\\\    /\n"
    "        \\   \\$$\\    |3XXX/XXXX/   /\n"
    "         \\_  \\  \\   |  __/XXX/  _/\n"
    "           \\  \\$$\\  |  \\XX//X\\ /\n"
    "            \\_ \\$$\\ | 3XX/3X/_/\n"
    "              \\_\\__\\|_______/\n");

}

