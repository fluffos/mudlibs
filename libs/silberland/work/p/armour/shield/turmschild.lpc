inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Turmschild");
  SetProp(P_LONG,  
    "Mit diesem Schild kann man sowohl Nahkampfwaffen als auch Pfeile und "
    "Wurfgeschosse abblocken. Er ist so gross, dass man sich beinahe "
    "dahinter verstecken kann. Mehere Soldaten koennen nebeneinander stehend "
    "damit einen richtigen Schildwall aufbauen. Der Turmschild besteht "
    "komplett aus Stahl und is am Rand noch zusaetzlich durch Nieten "
    "verstaerkt.") ;
  SetProp(P_NAME, "Turmschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild", "turmschild"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 27);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 3500);
  SetProp(P_VALUE, 2500);
  SetProp(P_QUALITY_DECAY, 125);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:15]) );

  AddDetail( ({"stahl"}),
    "Bester Stahl wurde beim Bau von diesem Schild verwendet.");
}

