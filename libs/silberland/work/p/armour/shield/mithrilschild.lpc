inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Mithrilschild");
  SetProp(P_LONG,
    "Es ist ein sehr widerstandsfaehiger Schild aus glaenzendem Mithril. Er "
    "hat eine tropfenfoermige Gestalt und ist am Rand mit Runen und kleinen, "
    "eingravierten Haemmern und Aexten verziert.");
  SetProp(P_NAME, "Mithrilschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild","mithrilschild"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 29);
  SetProp(P_MATERIAL, MAT_MITHRIL);
  SetProp(P_WEIGHT, 1750);
  SetProp(P_VALUE, 3000);
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:15]) );

  AddDetail( ({"mithril"}),
    "Obwohl dieser Schild sicher schon viele Jahre alt ist, hat das Mithril "
    "noch immer den gleichen silbrigen Glanz wie am Tag seiner Herstellung.");
  AddDetail( ({"runen", "haemmer", "aexte"}),
    "Der Schildrand ist mit Runen und kleinen Haemmern und Aexten verziert. "
    "Das ist auch kaum verwunderlich, da ja nur Zwerge Mithril verarbeiten.");
}

