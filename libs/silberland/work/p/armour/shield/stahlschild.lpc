inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Stahlschild");
  SetProp(P_LONG,  
    "Dieser Schild hat eine annaehernd ovale Form und laeuft nach unten "
    "spitz zu. Dadurch kann man den ganzen Koerper damit schuetzen. In der "
    "Mitte ist der Schild etwas gewoelbt und in der Mitte der Woelbung "
    "befidnet sich eine scharfe Spitze, mit der man zur Not auch einen "
    "Gegner aufspiessen kann.") ;
  SetProp(P_NAME, "Stahlschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild", "stahlschild"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 25);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_VALUE, 1100);
  SetProp(P_QUALITY_DECAY, 125);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:12]) );
  SetProp(P_EFFECTIVE_WC, 75 );
  
  AddDetail( ({"stahl"}),
    "Bester Stahl wurde beim Bau von diesem Schild verwendet.");
}

