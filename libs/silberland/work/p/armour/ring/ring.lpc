inherit "/p/armour/armour_inh";

#include <combat.h>
#include <properties.h>

#define SPEC_MAT ({ MAT_AMETHYST, MAT_TOPAZ, MAT_AQUAMARINE, MAT_OPAL, \
                    MAT_SAPPHIRE, MAT_EMERALD, MAT_RUBY, MAT_DIAMOND })

#define MATMSTR "p/daemon/materialdb"

void create()
{
  int r, value;
  string s, mat, mattext;
  
  if (!is_clone(this_object())) return;
  ::create();

  switch(random(6))
  {
    case 0: mat=MAT_GOLD; 
            value=300;
            mattext=({"Gold", "purem Gold"})[random(2)]; 
            break;
    case 1: mat=MAT_SILVER; 
            value=100; 
            mattext=({"poliertem Silber", "geflechteten Silberfaeden",
                      "Silber"})[random(3)];
            break;
    case 2: mat=MAT_PLATINUM; 
            value=500;
            mattext=({"Platin", "glaenzendem Platin"})[random(2)]; 
            break;
    case 3: mat=MAT_HORN; 
            value=0;
            mattext="einem durchbohrten Hornstueck";
            break;
    case 4: mat=MAT_IVORY; 
            value=150;
            mattext=({"weissem Elfenbein", "Elfenbein"})[random(2)];
            break;
    case 5: mat=MAT_BONE; 
            value=0;
            mattext="Knochen";
            break;
  }
  r=random(100)%8;
  s=MATMSTR->MaterialName(SPEC_MAT[r], 0, 100);
  SetProp(P_SHORT, "Ein "+s+"ring");
  SetProp(P_LONG, 
    "Das ist ein wertvoller Ring aus "+mattext+" mit einem schoenen "+
    MATMSTR->MaterialName(SPEC_MAT[r], WEM, 100)+".");
  SetProp(P_NAME, s+"ring");
  SetProp(P_GENDER, MALE);
  AddId( ({"ring", lower_case(s)+"ring"}) );

  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 1+r/2+random(2));
  SetProp(P_MATERIAL, ([ mat:90-r*3, SPEC_MAT[r]:10+r*3 ]));
  SetProp(P_WEIGHT, 20+random(r*10));
  SetProp(P_VALUE, 650+random(r*100)+value);
  SetProp(P_QUALITY_DECAY, 250+r*20);
}

