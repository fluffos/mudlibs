inherit "/p/armour/armour_inh";

#include <combat.h>
#include <properties.h>

#define SPEC_MAT ({ MAT_AMETHYST, MAT_TOPAZ, MAT_AQUAMARINE, MAT_OPAL, \
                    MAT_SAPPHIRE, MAT_EMERALD, MAT_RUBY, MAT_DIAMOND })

#define MATMSTR "p/daemon/materialdb"

void create()
{
  int r;
  string s, mat, mattext;
  
  if (!is_clone(this_object())) return;
  ::create();

  r=random(100)%8;
  s=MATMSTR->MaterialName(SPEC_MAT[r], 0, 100);
  switch( random(4) )
  {
    case 0: mat=MAT_GOLD;
            mattext=" eingebettet in einem Goldtaler.";
            break;
    case 1: mat=MAT_SILVER;
            mattext=" an einer schoenen Silberkette.";
            break;
    case 2: mat=MAT_LEATHER;
            mattext=" an einer Lederschnur.";
            break;
    case 3: mat=MAT_FEATHER;
            mattext=" umgeben von schoenen Federn.";
            break;
  }
  SetProp(P_SHORT, "Ein "+s+"amulett");
  SetProp(P_LONG, 
    "Das ist ein wertvolles Amulett mit einem schoenen "+
    MATMSTR->MaterialName(SPEC_MAT[r], WEM, 100)+ mattext);
  SetProp(P_NAME, s+"amulett");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"amulett", lower_case(s)+"amulett"}) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, 1+r/2+random(2));
  SetProp(P_MATERIAL, ([ mat:80-r*3, SPEC_MAT[r]:20+r*3 ]));
  SetProp(P_WEIGHT, 100+random(r*40));
  SetProp(P_VALUE, 550+random(r*400));
  SetProp(P_QUALITY_DECAY, 250+r*20);

}

