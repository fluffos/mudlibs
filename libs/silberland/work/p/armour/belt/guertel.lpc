inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  string farbe;
  if( !is_clone(this_object()) ) return;
  ::create();

  farbe=({"schwarz", "braun", "dunkelbraun", "hellbraun"})[random(4)];
  SetProp(P_SHORT, "Ein lederner Guertel");
  SetProp(P_LONG, 
    "Ein schmaler, "+farbe+"er Lederguertel mit einer Schnalle zum zumachen.");
  SetProp(P_NAME, "Lederguertel");
  SetProp(P_NAME_ADJ, farbe);
  SetProp(P_GENDER, MALE);
  AddId( ({"lederguertel", "guertel"}) );
  AddAdjective( ({farbe+"er", farbe+"en"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 1+random(3));
  SetProp(P_MATERIAL, ([MAT_LEATHER:95, MAT_BRASS:5 ]) );
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 160);                                            
}

