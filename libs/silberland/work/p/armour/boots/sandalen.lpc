#include <properties.h>
#include <combat.h>

inherit "/p/armour/armour_inh";
 
void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ledersandalen");
  SetProp(P_LONG,
    "Ledersandalen, wie man sie benutzt, wenn es fuer die schwereren "
    "Lederschuhe zu heiss ist.");
  SetProp(P_NAME, "Sandalen");
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  AddId(({"sandalen", "ledersandalen", "tatschkerl"}));

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 100);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1, T_HEAT_PROT:0]) );
}

