inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein Paar Eisenstiefel");
  SetProp(P_LONG,
    "Diese Stiefel sind aus schwerem Leder gefertigt und aussen vollstaendig "
    "mit stabilen Eisenplatten verstaerkt. Dadurch sind sie zwar sehr schwer "
    "und schnelles Laufen ist fast unmoeglich, dafuer bieten sie aber den "
    "Fuessen den bestmoeglichen Schutz. Die Sohlen sind durch kleine "
    "Eisenspitzen noch zusaetzlich gestaerkt, sodass man guten Halt im "
    "Gelaende hat und auch schon mal kraeftig zutreten kann.");
  SetProp(P_NAME, "Eisenstiefel");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"stiefel","eisenstiefel" }));
  
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_LEATHER:55, MAT_IRON:45]) );
  SetProp(P_WEIGHT, 2200);  
  SetProp(P_VALUE, 1800); 
  SetProp(P_EFFECTIVE_WC, 50);
}

