inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Paar Eisenschuhe");
  SetProp(P_LONG,
    "Diese schweren Lederschuhe sind aussen vollstaendig mit Eisenplatten "
    "verstaerkt. Dadurch sind sie zwar sehr schwer, aber dafuer sind die "
    "Fuesse auch extrem gut geschuetzt.");
  SetProp(P_NAME, "Eisenschuhe");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId(({"schuhe", "eisenschuhe"}));

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_LEATHER:30, MAT_IRON:70]) );
  SetProp(P_WEIGHT, 1900);
  SetProp(P_VALUE, 1200);
}

