inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein Paar Kampfstiefel");
  SetProp(P_LONG,
    "Die Stiefel sind aus schwerem Leder, in welches Metallteile "
    "eingearbeitet sind, gefertigt. Leicht sind sie ja nicht gerade, aber sie "
    "sehen so aus, als ob sie guten Schutz im Kampf bieten wuerden.");
  SetProp(P_NAME, "Kampfstiefel");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"stiefel","kampfstiefel" }));
  
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_LEATHER:75, MAT_IRON:25]) );
  SetProp(P_WEIGHT, 1500);  
  SetProp(P_VALUE, 1100); 
}

