inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Paar Lederschuhe");
  SetProp(P_LONG,
    "Ein Paar huebscher, aber fester Lederschuhe. Die dicke Ledersohle "
    "macht das Wandern sicherlich bequem.");
  SetProp(P_NAME, "Lederschuhe");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId(({"schuhe", "lederschuhe"}));

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 200);
}
