inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Fellstiefel");
  SetProp(P_LONG, 
    "Ein Paar dicke Fellstiefel, die Deine Fuesse vor eisiger Kaelte "
    "schuetzen. Mit ihnen solltest Du nie kalte Zehen bekommen. Die Sohle "
    "aus dickem Leder hat ein grobes Profil, damit man nicht ausrutschen "
    "kann." );
  SetProp(P_NAME, "Fellstiefel");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId (({"stiefel","fellstiefel"}));
  
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_PELT:100]));
  SetProp(P_WEIGHT, 1100);
  SetProp(P_VALUE, 800);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4, T_HEAT_PROT:-2]));
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
      ([DT_WATER:2, DT_COLD:1]) );
  
  AddDetail( ({"fell"}),
    "Es handelt sich um das Fell eines Seehundes, daher sind die "
    "Fellstiefel so warm und zusaetzlich noch wasserdicht.");
}

