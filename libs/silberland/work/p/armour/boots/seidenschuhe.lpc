inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return; 
  ::create();
  
  SetProp(P_SHORT, "Seidenschuhe");
  SetProp(P_LONG,
    "Diese Schuhe sind aus reinster Seide genaeht. Die Sohle besteht aus "
    "Leder, welches die Schuhe etwas langlebiger zu machen scheint. "
    "Vor allem Frauen und eitle Zauberer tragen solche feinen Schuhe.");
  SetProp(P_NAME, "Seidenschuhe");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId(({"schuhe","seidenschuhe"}));

  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_SILK:60, MAT_LEATHER:40]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 300);
  SetProp(P_QUALITY_DECAY, 80 );
}

