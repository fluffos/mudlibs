inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Paar Lederstiefel");
  SetProp (P_LONG, 
    "Feste Stiefel aus feinstem Leder, wie sie fast alle Arbeiter und "
    "Soldaten tragen. Sie bieten guten Schutz fuer die Fuesse, halten sie "
    "warm und sind fuer langes Stehen sehr gut geeignet. Die Sohle ist stark "
    "gerillt, sodass man auch in schwerem Gelaende guten Halt findet.");
  SetProp (P_NAME, "Lederstiefel");
  SetProp (P_GENDER, MALE);
  SetProp (P_PLURAL, 1);
  AddId (({"stiefel","lederstiefel"}));
  
  SetProp (P_ARMOUR_TYPE, AT_BOOT);
  SetProp (P_AC, 6);
  SetProp (P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp (P_WEIGHT, 1000);
  SetProp (P_VALUE, 700);

  AddDetail( ({"leder"}),
    "Es handelt sich um gegerbtes "+
    ({"Schweinsleder", "Kuhleder", "Krokodilleder"})[random(3)]
    +", das sehr gut verarbeitet wurde.");
}
