inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Beinschienen aus Titan");
  SetProp(P_LONG, 
    "Diese Beinschienen wurden aus Titan gefertigt und sind ueberraschend "
    "leicht. Trotzdem schuetzen sie die Beine genausogut wie schwerere "
    "Exemplare. ");
  SetProp(P_NAME, "Titanbeinschienen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"beinschienen", "schienen", "titanbeinschienen"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 1350);
  SetProp(P_QUALITY_DECAY, 125);
  
  AddDetail( "titan",
    "Titan ist viel leichter als alle anderen Metalle, aber genauso stabil.");
}

