inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Beinschienen aus Messing");
  SetProp(P_LONG,  
    "Diese Beinschienen aus Messing schuetzen die Beine vor Schlaegen. "
    "Sie bestehen aus einer dicken Lederschicht auf die zur Verstaerkung "
    "viele kleine Schuppen aus Messing aufgenietet sind. Mit breiten "
    "Lederbaendern kann man die Beinschienen an den Beinen befestigen.");
  SetProp(P_NAME, "Messingbeinschienen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"beinschienen", "messingbeinschienen"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_BRASS:60, MAT_LEATHER:40]) );
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 880);
  SetProp(P_QUALITY_DECAY, 110);

  AddDetail( ({"messing", "schuppen", "messingschuppen"}),
    "Die Messingschuppen schauen sehr widerstandsfaehig aus.");
}

