inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Wollhose");
  SetProp(P_LONG,
    "Diese Hose wurde aus Wolle gewebt. Sie hat einen flotten Schnitt und "
    "passt sich jeder Figur ideal an. Die Wolle ist sehr weich und auch "
    "ziemlich warm.");
  SetProp(P_NAME, "Wollhose");
  SetProp(P_GENDER, FEMALE);
  AddId(({"wollhose","hose"}));

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_WOOL);
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 300);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4,T_HEAT_PROT:-2]) );

  AddDetail( ({"wolle", "schafwolle"}),
    "Es handelt sich um kuschelig weiche Schafwolle.");
}

