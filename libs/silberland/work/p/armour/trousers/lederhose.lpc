inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Lederhose");
  SetProp(P_LONG,
    "Diese Hose besteht aus festem Leder und haelt sicher viele Strapazen "
    "aus. Auf dem Hinterteil sind zwei zusaetzliche Lederflecken aufgenaeht, "
    "um ein schnelles Durchwetzen zu verhindern.");
  SetProp(P_NAME, "Lederhose");
  AddId(({"lederhose","hose"}));
  SetProp(P_GENDER, FEMALE);

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 500);
  SetProp(P_QUALITY_DECAY, 120);

  AddDetail( ({"leder"}),
    "Bei dem Leder handelt es sich um gegerbtes Kuhleder.");
}

