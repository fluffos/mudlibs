inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Rock");
  SetProp(P_LONG,
    "Ein langer Rock aus weicher Baumwolle, der mit Blumenmustern bestickt "
    "ist.");
  SetProp(P_NAME, "Rock" );
  SetProp(P_GENDER, MALE);
  AddId( ({"rock"}) );
  SetProp(P_INFO, "Natuerlich tragen nur Frauen so einen Rock.\n");

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 120);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE ]) );
  
  AddDetail( ({"blumen", "blumenmuster", "muster"}),
    "Der Rock ist mit bunten Blumenmustern bestickt.");
  AddDetail( ({"baumwolle"}),
    "Der Rock besteht aus weicher Baumwolle.");
}

