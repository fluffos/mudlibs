inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Lederbeinschienen");
  SetProp(P_LONG, 
    "Diese Beinschienen bestehen aus hartem Leder und schuetzen sowohl "
    "Ober- als auch Unterschenkel vor Schlaegen und Hieben. Am Knie sind "
    "sie durch ein breites Gelenk verbunden, sodass man die Beine trotz des "
    "harten Leders noch gut bewegen kann.");
  SetProp(P_NAME, "Lederbeinschienen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"beinschienen", "schienen", "lederbeinschienen"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 650);

  AddDetail( "leder",
    "Es handelt sich um mehrlagiges, verstaerktes Leder.");
}

