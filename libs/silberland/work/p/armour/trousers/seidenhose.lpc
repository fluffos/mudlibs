inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

create()
{
  ::create();
  SetProp(P_SHORT, "Eine Seidenhose");
  SetProp(P_LONG,
    "Diese Hose wurde aus feinster Seide gefertigt und mit bunten Farben "
    "bemalt. Sie ist sehr weit geschnitten und sehr luftig, sodass man sie "
    "eher bei heissen Temperaturen anziehen sollte."); 
  SetProp(P_NAME, "Seidenhose");
  SetProp(P_GENDER, FEMALE);
  AddId(({"hose","seidenhose"}));

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_SILK);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 900);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0,T_HEAT_PROT:1]) );
  SetProp(P_QUALITY_DECAY, 90);
  
  AddDetail( ({"seide"}),
    "Die Seide ist sehr weich und anschmiegsam.");
}

