inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein kurzer Rock");
  SetProp(P_LONG,  
    "Ein kurzer Rock, der nur bis zu den Knien reicht. Er besteht aus weicher "
    "Baumwolle und ist mit Blumenmustern bestickt. Meist tragen nur junge "
    "Maedchen so einen Rock, da er fuer aeltere Frauen unschicklich ist.");
  SetProp(P_NAME, "Rock" );
  SetProp(P_NAME_ADJ, "kurz");
  SetProp(P_GENDER, MALE);
  AddId( ({"rock"}) );
  AddAdjective( ({"kurz", "kurzer", "kurzen"}) );
  SetProp(P_INFO, "Natuerlich tragen nur Frauen und Maedchen so einen Rock.\n");

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]) );
  SetProp(P_WEIGHT, 170);
  SetProp(P_VALUE, 100);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE ]) );
  
  AddDetail( ({"blumen", "blumenmuster", "muster"}),
    "Der Rock ist mit bunten Blumenmustern bestickt.");
  AddDetail( ({"baumwolle"}),
    "Der Rock besteht aus weicher Baumwolle.");
}

