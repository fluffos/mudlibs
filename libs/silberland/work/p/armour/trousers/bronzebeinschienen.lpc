inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Beinschienen aus Bronze");
  SetProp(P_LONG, 
    "Diese Beinschienen aus Bronze schuetzen die Unterschenkel vor "
    "Schlaegen. Sie sind in einem Stueck gegossen und perfekt an die "
    "muskuloesen Unterschenkel von Kaempfern angepasst.") ;
  SetProp(P_NAME, "Beinschienen");
  SetProp(P_NAME_ADJ, "bronzen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"beinschienen", "schienen", "bronzebeinschienen"}) );
  AddAdjective( ({"bronzene", "bronzen"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, MAT_BRONCE );
  SetProp(P_WEIGHT, 1700);
  SetProp(P_VALUE, 950);
  SetProp(P_QUALITY_DECAY, 105);
  
  AddDetail( "bronze",
    "Bronze eignet sich sehr gut fuer Ruestungen.");
}

