inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Eine Kettenhose");
  SetProp(P_LONG,
    "Diese Kettenhose besteht aus lauter kleinen Eisengliedern, welche zu "
    "einer Hose zusammengekettet worden sind. Ein Meister der Schmiedekunst "
    "muss dieses prachtvolle Werk geschaffen haben.");
  SetProp(P_NAME, "Kettenhose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose", "kettenhose"}));

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_IRON:100]) );
  SetProp(P_WEIGHT, 2200);  
  SetProp(P_VALUE, 1900); 
  SetProp(P_QUALITY_DECAY, 115);
}

