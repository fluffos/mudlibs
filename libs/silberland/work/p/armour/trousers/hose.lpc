inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  string farbe;
  if( !is_clone(this_object()) ) return;
  ::create();

  farbe=({"dunkelblau", "blau", "grau", "schwarz", "braun"})[random(5)];
  SetProp(P_SHORT, "Eine "+farbe+"e Hose");
  SetProp(P_LONG, 
    "Eine gewoehnliche "+farbe+"e Hose. Sehr billig und einfach "
    "gearbeitet. Sie ist mit Filz gefuettert, denn der "+farbe+"e Stoff waere "
    "wohl alleine ein bischen zu duenn." );
  SetProp(P_NAME, "Hose");
  SetProp(P_NAME_ADJ, farbe);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose"}) );
  AddAdjective( ({farbe+"e"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_CLOTH:75, MAT_FELT:25]) );
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 250);
}

