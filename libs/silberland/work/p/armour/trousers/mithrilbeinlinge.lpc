inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Kettenbeinlinge aus Mithril");
  SetProp(P_LONG, 
    "Diese Beinlinge sind aus einem feinmaschigen Kettengeflecht gefertigt, "
    "das aus silbrig schimmerndem und stahlhartem Mithril besteht. Nur die "
    "besten zwergischen Schmiede sind in der Lage, solche Meisterwerke "
    "herzustellen.") ;
  SetProp(P_NAME, "Mithrilbeinlinge");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"beinlinge", "kettenbeinlinge", "mithrilbeinlinge",
           "mithrilkettenbeinlinge"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, MAT_MITHRIL );
  SetProp(P_WEIGHT, 1700);
  SetProp(P_VALUE, 1400);
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:15]) );
  
  AddDetail( "mithril",
    "Das Mithril glaenzt silbrig. Noch keinen einzigen Kratzer kann man "
    "auf dem Mithril erkennen.");
}

