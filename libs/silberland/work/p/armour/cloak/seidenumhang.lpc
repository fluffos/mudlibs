inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Umhang aus feinster Seide");
  SetProp(P_LONG, 
    "Dieser Umhang besteht aus feinster Seide. Er ist so leicht, dass man "
    "ihn kaum spuert, wenn man ihn um die Schultern gehaengt hat. Nur "
    "wohlhabende Frauen und eitle Magier trage solche Umhaenge.");
  SetProp(P_NAME, "Seidenumhang");
  SetProp(P_GENDER, MALE);
  AddId(({"umhang", "seidenumhang"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK); 
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_SILK:100]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 1300);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1, T_HEAT_PROT:0]) );
  
}

