inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Braunbaerenfell");
  SetProp(P_LONG,  
    "Das ist das dicke Fell eines Braunbaeren. Es ist sehr dick und daher "
    "auch sehr warm." );
  SetProp(P_NAME, "Braunbaerenfell");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fell", "baerenfell", "braunbaerenfell", "\nfell_is_gerb_able"}) );
  SetProp(P_INFO, 
    "Du kannst das Baerenfell als Umhang benutzten. Sicher ist es sehr "
    "warm.\n" );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, MAT_PELT );
  SetProp(P_WEIGHT, 1000 );
  SetProp(P_VALUE, 999 );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:6, T_HEAT_PROT:-3]) );
  SetProp(P_WORN_TEXT, "umgehaengt");
  SetProp(P_WEAR_TEXT, ({"Du haengst Dir das Baerenfell um.\n",
                         " haengt sich ein Baerenfell um.\n"}) );
}

