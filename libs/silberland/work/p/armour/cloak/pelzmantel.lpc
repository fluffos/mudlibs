inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) )     return;
  ::create();

  SetProp(P_SHORT, "Ein Schafspelzmantel");
  SetProp(P_LONG, 
    "Dieser Schafspelzmantel haelt sicher sehr warm, denn er ist "
    "vollstaendig aus weicher Schafswolle gemacht. Die Wolle ist so dick, "
    "dass man in diesem Mantel sicher nicht erfrieren kann. Am Kragen ist "
    "er besonders dick, um auch den Hals noch waermen zu koennen.");
  SetProp(P_NAME, "Schafspelzmantel");
  SetProp(P_GENDER, MALE);
  AddId( ({"mantel", "pelzmantel", "schafspelzmantel"}) );

  SetProp(P_WEIGHT, 1350);
  SetProp(P_VALUE, 600);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_MATERIAL, ([MAT_WOOL:100]) );
  SetProp(P_AC, 6);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:7, T_HEAT_PROT:-9]) );

}

