inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Fellumhang");
  SetProp(P_LONG,  
    "Ein dicker Fellumhang, der gegen grimmige Kaelte schuetzt. "
    "Er wurde aus vielen kleinen Fellstuecken zusammengenaeht, sodass man "
    "nicht mehr sage, kann, von welchen Tieren die Felle stammen. Aber "
    "die Hauptsache an diesem Umhang is ja wohl, dass er schoen warm haelt.");
  SetProp(P_NAME, "Fellumhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"fell", "umhang", "fellumhang"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_PELT:100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 500);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:6, T_HEAT_PROT:-6 ]) );

}
