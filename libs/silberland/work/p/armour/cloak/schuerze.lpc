inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine gruene Schuerze");
  SetProp(P_LONG, 
    "Es ist ein alte, gruene Schuerze, wie sie typischerweise Wirte tragen.");
  SetProp(P_NAME, "Schuerze");
  SetProp(P_NAME_ADJ, "gruen");
  SetProp(P_GENDER, FEMALE);
  AddId("schuerze");
  AddAdjective( ({"gruen", "gruene"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK); 
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 400);
  SetProp(P_QUALITY_DECAY, 75 );
}

