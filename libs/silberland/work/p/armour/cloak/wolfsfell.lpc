inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Wolfsfell");
  SetProp(P_LONG, 
    "Dieses Wolfsfell gehoerte wohl einmal einem boesen Wolf. Es ist "
    "nicht allzu schwer, und hat huebsche silberne Streifen.");
  SetProp(P_NAME, "Wolfsfell");
  SetProp(P_GENDER, NEUTER);
  AddId (({"fell","wolfsfell","\nfell_is_gerb_able"}));
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_PELT:100]) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 450);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:5, T_HEAT_PROT:-3]) );
}

