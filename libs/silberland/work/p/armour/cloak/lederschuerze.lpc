inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Lederschuerze");
  SetProp(P_LONG, 
    "Es ist eine abgetragene Lederschuerze, wie sie Minenarbeiter oder "
    "Schmiede oft tragen. Die Schuerze kann man sich mit einem duennen "
    "Band vor den Bauch binden.");
  SetProp(P_NAME, "Lederschuerze");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schuerze", "lederschuerze" }) );
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK); 
  SetProp(P_AC, 5);
  SetProp(P_DAMAGED, 1);
  SetProp(P_MATERIAL, ([MAT_LEATHER:95, MAT_COTTON:5]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 400);
  SetProp(P_WORN_TEXT, "umgebunden");
  SetProp(P_WEAR_TEXT, ({"Du bindest Dir die Lederschuerze um.\n",
                          " bindet sich die Lederschuerze um.\n"}) );
}

