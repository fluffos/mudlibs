inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Eine schoene Robe");
  SetProp(P_LONG, 
    "Eine schoene Robe, wie sie vornehme und reiche Leute gerne tragen. "
    "Sie besteht aus einem feinen, glaenzendem Material uns ist mit einer "
    "goldfarbenen Borte besetzt.");
  SetProp(P_NAME, "Robe");
  SetProp(P_GENDER, FEMALE);
  AddId("robe");

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_SILK:100]) );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 450);
  SetProp(P_QUALITY_DECAY, 80 );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3, T_HEAT_PROT:-1]) );
}

