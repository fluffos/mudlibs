inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Staehlernes Plattenzeug");
  SetProp(P_LONG,  
    "Das Plattenzeug ist besteht aus dicken Stahlplatten, die so geformt "
    "sind, dass sie perfekt auf die Unterarme passen. Mit zwei Schnallen kann "
    "man sie befestigen. Nur sehr starke Kaempfer koennen mit so grossem "
    "Gewicht noch gut kaempfen.");
  SetProp(P_NAME, "Plattenzeug");
  SetProp(P_NAME_ADJ, "staehlern");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"plattenzeug", "zeug"}) );
  AddAdjective( ({"staehlernes"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 2100);
  SetProp(P_VALUE, 1900);
  SetProp(P_QUALITY_DECAY, 170);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:18]) );
}

