inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Armschienen aus Bronze");
  SetProp(P_LONG,  
    "Diese Armschienen wurden aus Bronze gegossen und sind sehr stabil. Sie "
    "huellen die Unterarme komplett ein. Mit zwei Schnallen kann man die "
    "Armschienen enger machen, sodass sie nicht mehr wegrutschen koennen.");
  SetProp(P_NAME, "Armschienen");
  SetProp(P_NAME_ADJ, "bronzen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"armschienen", "bronzearmschienen"}) );
  AddAdjective( ({"brozene"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, MAT_BRONCE );
  SetProp(P_WEIGHT, 1600);
  SetProp(P_VALUE, 900);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:10, P_FROG:1]) );

  AddDetail( "bronze",
    "Bronze eignet sich sehr gut fuer Ruestungen.\n");

}

