inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Armschienen aus Titan");
  SetProp(P_LONG,  
    "Diese Armschienen wurden aus Titan gefertigt und sind ueberraschend "
    "leicht. Trotzdem schuetzen sie die Unterarme genausogut wie schwerere "
    "Exemplare. Mit zwei Ledergurten kann man die Armschienen am Unterarm "
    "befestigen.");
  SetProp(P_NAME, "Titanarmschienen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"armschienen", "titanarmschienen"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_TITANIUM:85, MAT_LEATHER:15]) );
  SetProp(P_WEIGHT, 1100);
  SetProp(P_VALUE, 1600);
  SetProp(P_QUALITY_DECAY, 110);

  AddDetail( "titan",
    "Titan ist viel leichter als alle anderen Metalle, aber genauso stabil.");

}

