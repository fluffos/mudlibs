inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Paar Mithrilarmschienen");
  SetProp (P_LONG,
    "Diese Armschienen sind extrem widerstandsfaehig, weil sie aus vielen "
    "kleinen Mithrilringen gefertigt wurden. Das Armgelenk der Schienen ist "
    "gekapselt und daher ist auch der Ellbogen sehr gut geschuetzt.");
  SetProp (P_NAME, "Mithrilarmschienen");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_PLURAL, 1);
  AddId (({"armschienen","mithrilarmschienen"}));
  
  SetProp (P_ARMOUR_TYPE, AT_BRACERS);
  SetProp (P_AC, 9);
  SetProp (P_MATERIAL, MAT_MITHRIL);
  SetProp (P_WEIGHT, 1400);
  SetProp (P_VALUE, 2500);
  SetProp (P_QUALITY_DECAY, 250);
  SetProp (P_WEAR_RESTRICTIONS, ([A_STR:15]) );
}

