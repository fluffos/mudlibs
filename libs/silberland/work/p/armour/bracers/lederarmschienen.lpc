inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Lederne Armschienen");
  SetProp(P_LONG,  
    "Diese Armschienen aus gegerbtem und gehaertetem Leder schuetzen die "
    "Unterarme vor Schaden. Mit zwei Baendern kann man die Armschienen an "
    "den Unterarmen befestigen.");
  SetProp(P_NAME, "Armschienen" );
  SetProp(P_NAME_ADJ, "ledern");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"armschienen", "lederarmschienen"}) );
  AddAdjective( ({"leder", "lederne" }) );

  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 350);

  AddDetail( ({"leder", "hirschleder"}),
    "Bei dem Leder handelt es sich um strapazierfaehiges Hirschleder.");
  
}


