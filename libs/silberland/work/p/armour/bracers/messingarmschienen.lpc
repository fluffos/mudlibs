inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Armschienen aus Messing");
  SetProp(P_LONG,  
    "Diese Armschienen bestehen aus Leder, in das kleine Ringe aus Messing "
    "eingearbeitet worden sind. Mit zwei breiten Lederbaendern kann man die "
    "Armschienen an den Unterarmen festbinden.");
  SetProp(P_NAME, "Messingarmschienen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"armschienen", "messingarmschienen"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_BRASS:50, MAT_LEATHER:50]) );
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 700);
  
}

