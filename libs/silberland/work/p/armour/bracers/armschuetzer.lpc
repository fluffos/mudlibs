inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Armschuetzer");
  SetProp(P_LONG,  
    "Diese Armschuetzer sollen die Unterarme schuetzen, vor allem gegen "
    "Schmutz und Dornen und Stacheln. Deshalb tragen oft Gaertner, Arbeiter "
    "und Bauern solche Armschuetzer, da sie sich dann nicht staendig ihr "
    "Hemd schmutzig machen. Die Armschuetzer bestehen aus einer dreifachen "
    "Stoffschicht, sodass Dornen und Stacheln sie nicht durchdringen "
    "koennen. Gegen echte Waffen bieten sie aber nur sehr wenig Schutz.");
  SetProp(P_NAME, "Armschuetzer" );
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"armschuetzer", "schuetzer"}) );

  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_CLOTH:100]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 150);

}

