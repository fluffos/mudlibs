inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eiserne Armschienen");
  SetProp(P_LONG,  
    "Diese Armschienen aus Eisen schuetzen die Unterarme vor Schlaegen. "
    "Viele kleine Eisenplaettchen sind auf weiches Leder genietet. Mit "
    "breiten Lederbaendern kann man die Schienen am Unterarm befestigen. "
    "Man braucht schon etwas Kraft, um mit solch schwerem Gewicht an den "
    "Armen noch eine Waffe schwingen zu koennen.");
  SetProp(P_NAME, "Armschienen");
  SetProp(P_NAME_ADJ, "eisern");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"armschienen", "eisenarmschienen"}) );
  AddAdjective( ({"eisern", "eiserne"}) );

  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_IRON:65, MAT_LEATHER:35]) );
  SetProp(P_WEIGHT, 1400);
  SetProp(P_VALUE, 750);
  SetProp(P_QUALITY_DECAY, 110);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:8]) );
  
}

