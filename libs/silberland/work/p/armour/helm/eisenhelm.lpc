inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Eisenhelm");
  SetProp(P_LONG,
    "Dieser einfache Eisenhelm schuetzt den Kopf vor Verletzungen. Er schaut "
    "aus wie eine Haube, nur dass er aus Eisen besteht. Er hat weder "
    "Verzierungen noch ein Visier, es handelt sich also um einen sehr "
    "einfachen und daher auch billigen Helm.");
  SetProp(P_NAME, "Eisenhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "eisenhelm"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_HELMET); 
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, MAT_IRON);
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 440);
}

