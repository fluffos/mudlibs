inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Mithrilhelm");
  SetProp(P_LONG, 
    "Es ist ein relativ widerstandsfaehiger Helm aus Mithril. Der ganze Kopf "
    "und Hals ist durch dicke Mithrilplatten geschuetzt, nur im Gesicht "
    "befindet sich ein herzfoermige Oeffnung, durch die Augen und Mund "
    "frei bleiben.");
  SetProp(P_NAME, "Mithrilhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "mithrilhelm"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 14);
  SetProp(P_MATERIAL, MAT_MITHRIL);
  SetProp(P_WEIGHT, 1100);
  SetProp(P_VALUE, 3500);
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:15]) );
}

