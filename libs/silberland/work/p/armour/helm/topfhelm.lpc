inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Topfhelm");
  SetProp(P_LONG,
    "Der Topfhelm schuetzt den ganzen Kopf vor Schaden. Nur fuer die Augen "
    "sind zwei duenne Schlitze frei, ansonsten ist der Kopf durch stabile "
    "Stahlplatten geschuetzt. Vor allem Ritter tragen solche Helme bei "
    "Turnieren, aber auch andere Kaempfer wollen oft fuer ihren Kopf den "
    "bestmoeglichen Schutz.");
  SetProp (P_NAME, "Topfhelm");
  SetProp (P_GENDER, MALE);
  AddId (({"helm", "topfhelm"}));

  SetProp (P_ARMOUR_TYPE, AT_HELMET); 
  SetProp (P_AC, 13);
  SetProp (P_MATERIAL, MAT_STEEL);
  SetProp (P_WEIGHT, 2222);
  SetProp (P_VALUE, 2222);
  SetProp (P_QUALITY_DECAY, 150);
  SetProp (P_DAM_PROTECTION, 
      QueryProp(P_DAM_PROTECTION)+([DT_SOUND:1, DT_LIGHT:1, DT_AIR:1]) );
}

