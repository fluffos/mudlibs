inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Kettenhaube");
  SetProp(P_LONG,  
    "Diese Kettenhaube ist ein sehr guter Schutz fuer den Kopf. Zwar "
    "schuetzt sie nicht so gut wie ein Vollhelm, dafuer ist der Kopf noch "
    "viel beweglicher. Sie besteht aus einem engmaschigen Netz von "
    "staehlernen Kettengliedern und reicht bis zum Hals hinunter.");
  SetProp(P_NAME, "Kettenhaube");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"haube", "kettenhaube"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_WEIGHT, 1700);
  SetProp(P_VALUE, 1000);
  SetProp(P_QUALITY_DECAY, 125);
  SetProp(P_WEAR_RESTRICTIONS, ([A_DEX:10]) );
}

