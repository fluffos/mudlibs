inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Lederhelm");
  SetProp(P_LONG,
    "Dieser einfache Lederhelm bietet nicht allzuviel Schutz. Er besteht nur "
    "aus einer ledernen Halbkugel, die man mit einem Riemen am Kinn "
    "festmachen kann. Da nicht einmal die Ohren bedeckt werden, ist man "
    "wenigstens in seinen Hoervermoegen nicht eingeschraenkt, wenn man "
    "diesen Lederhelm traegt.");
  SetProp(P_NAME, "Lederhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "lederhelm"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET); 
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 140);
}

