inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein Titanhelm");
  SetProp(P_LONG,
    "Der Titanhelm schuetzt den Kopf sehr gut und ist dabei extrem leicht. "
    "Der Helm hat einen langen Nasenschutz und ein breites Lederband, mit "
    "dem man den Helm unter dem Kinn festbinden kann. Nach oben hin laeuft "
    "der Helm spitz zu. An der Helmspitze kann man eine Helmzier befestigen.");
  SetProp(P_NAME, "Titanhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm","titanhelm" }));
 
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_TITANIUM:95, MAT_LEATHER:5]));
  SetProp(P_VALUE, 1100);
  SetProp(P_WEIGHT, 800);   
}

