inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein schlapper Filzhut");
  SetProp(P_LONG, 
    "Der Filzhut ist schwarz und hat eine nach oben gebogene Krempe. " 
    "Er ist riesengross und eignet sich gut dafuer, Regen abzuhalten, "
    "oder sein Gesicht zu verbergen, indem man ihn nach unten zieht. Auch "
    "bei starkem Sonnenlicht ist so ein Hut ganz nuetzlich, da die Augen "
    "beschattet werden. ");
  SetProp(P_NAME, "Filzhut");
  SetProp(P_GENDER, MALE);
  AddId( ({"hut", "filzhut"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_FELT:100]) );
  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 180);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:1, T_HEAT_PROT:3 ]) );
}

