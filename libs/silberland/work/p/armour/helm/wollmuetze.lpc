inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Wollmuetze");
  SetProp(P_LONG,
    "Eine simple Wollmuetze bietet eigentlich nur Schutz vor kleinen "
    "Dingen, die einem auf den Kopf fallen koennten. Natuerlich haelt sie "
    "den Kopf auch angenehm warm, vor allem, wenn man sie so weit ins Gesicht "
    "herunterzieht, dass auch die Ohren vollkommen bedeckt sind." );
  SetProp(P_NAME, "Wollmuetze");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"muetze", "wollmuetze"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, MAT_WOOL);
  SetProp(P_WEIGHT, 70);
  SetProp(P_VALUE, 110);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3, T_HEAT_PROT:-1]) );
}

