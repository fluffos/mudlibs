inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Bronzehelm");
  SetProp(P_LONG,  
    "Dieser Bronzehelm schuetzt den Kopf vor Schlaegen und vor der "
    "Strahlung der Sonne. Er ist relativ hoch und spitz und hat eine "
    "gekruemmte Krempe, die die Augen beschattet. Auf der Seite sind schoene "
    "Verziehrungen angebracht.");
  SetProp(P_NAME, "Bronzehelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "bronzehelm"}) );
  SetProp(P_INFO, 
    "Dieser Helm haelt nicht nur Schlaege ab, sondern auch die Strahlung "
    "der Sonne. Vielleicht kann er auch Hitze und Feuer abwehren.");

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 11);
  SetProp(P_MATERIAL, ([MAT_BRONCE:100]) );
  SetProp(P_WEIGHT, 1600);
  SetProp(P_VALUE, 700);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0,T_HEAT_PROT:3]) );  
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ ([DT_FIRE:2]) );
  SetProp(P_WORN_TEXT, "aufgesetzt");

  AddDetail( "bronze",
    "Bronze eignet sich sehr gut fuer Helme.\n");
  AddDetail( "krempe",
    "Die Krempe ist breit und gekruemmt, dadurch beschattet sie das ganze "
    "Gesicht.");
  AddDetail( "verziehrungen",
    "Seitlich am Helm sind schoene Verziehrungen angebracht.");
  
}

