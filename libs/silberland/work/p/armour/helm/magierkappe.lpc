inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Magierkappe");
  SetProp(P_LONG, 
    "Diese Kappe ist aus feinem Leder genaeht worden. Darauf sind in den "
    "verschiedensten Farben magische Symbole gemalt. Fast alle Magier und "
    "Zauberer haben solche Kappen auf.");
  SetProp(P_NAME, "Magierkappe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"kappe","magierkappe"}));

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 60);
  SetProp(P_VALUE, 200);
}

