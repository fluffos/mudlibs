inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Zauberhut");
  SetProp(P_LONG, 
    "Dieser Hut ist sehr lang und spitz. Er besteht aus blauem Stoff auf dem "
    "silberne und goldene Symbole gestickt sind. Welche Bedeutung diese "
    "Symbole haben, kannst Du nicht entschluesseln. Da musst Du schon einen "
    "Zauberer fragen, denn diese tragen sehr gerne solche Huete.");
  SetProp(P_NAME, "Zauberhut");
  SetProp(P_GENDER, MALE);
  AddId(({"zauberhut","hut"}));

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_CLOTH:98, MAT_SILVER:1, MAT_GOLD:1]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 400);

  AddDetail( ({"symbol", "symbole"}),
    "Merkwuerdige Symbole sind auf diesen Zaubererhut gestickt. Ihre "
    "Bedeutung kennen wohl nur die Zauberer.");
}

