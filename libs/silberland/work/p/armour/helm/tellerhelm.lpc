inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Tellerhelm");
  SetProp(P_LONG,
    "Wie der Name schon sagt, schaut der Tellerhelm wie ein Suppenteller aus. "
    "Und tatsaechlich haben schon viele Soldaten im Feldeinsatz ihre Suppe "
    "aus ihrem Tellerhelm geloeffelt. Aber auch als Kopfschutz ist der Helm "
    "ganz gut geiegnet, obwohl nur ein Teil des Kopfes geschuetzt wird. "
    "Dafuer ist der Tellerhelm aber ziemlich leicht und billig.");
  SetProp(P_NAME, "Tellerhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "tellerhelm"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET); 
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_BRASS:100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 330);
}

