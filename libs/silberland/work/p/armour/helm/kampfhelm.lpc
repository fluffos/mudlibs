inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein Kampfhelm");
  SetProp(P_LONG,
    "Der Kampfhelm ist ein Lederhelm, auf den viele kleine Metallschuppen "
    "aufgenaeht sind. Auf diese Weise schuetzt der Helm viel besser als ein "
    "normaler Lederhelm, ist aber nicht so schwer zu tragen wie ein "
    "Vollmetallhelm.");
  SetProp(P_NAME, "Kampfhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm","kampfhelm" }));

  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_IRON:60, MAT_LEATHER:40]) );
  SetProp(P_WEIGHT, 1250);    
  SetProp(P_VALUE, 400); 
}

