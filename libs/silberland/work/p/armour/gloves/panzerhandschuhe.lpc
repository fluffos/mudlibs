inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Panzerhandschuhe");
  SetProp(P_LONG, 
    "Ein Paar Handschuhe aus Leder, die mit harten Metallplaettchen "
    "gepanzert sind. Die Haende sind dadurch fast genauso beweglich wie "
    "in normalen Lederhandschuhen, aber weit besser geschuetzt.");
  SetProp(P_NAME, "Panzerhandschuhe");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"handschuhe","panzerhandschuhe"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_GLOVE); 
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_COPPER:60, MAT_LEATHER:40]) );
  SetProp(P_WEIGHT, 1150);
  SetProp(P_VALUE, 1500);
  SetProp(P_QUALITY_DECAY, 130 );
}

