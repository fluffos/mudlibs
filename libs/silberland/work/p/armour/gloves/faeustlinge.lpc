inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Faeustlinge");
  SetProp(P_LONG, 
    "Ein Paar warme Faeustlinge aus ganz flauschigem, weichem Fell. Sicher "
    "bleiben so die Finger auch in der groessten Kaelte noch warm. "
    "Allerdings kann man die Finger nicht mehr so richtig bewegen, sodass "
    "man die Faeustlinge fuer schwierige Handgriffe sicher ausziehen muss.");
  SetProp(P_NAME, "Faeustlinge");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_PLURAL, 1);
  AddId (({"faeustlinge", "faeustling"}));

  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 2);
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 500);
  SetProp(P_MATERIAL, ([MAT_PELT:100]));
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:3, T_HEAT_PROT:-3 ]) );
}
