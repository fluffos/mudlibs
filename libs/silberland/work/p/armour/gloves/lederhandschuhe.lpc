inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Lederhandschuhe");
  SetProp(P_LONG, 
    "Ein Paar Handschuhe aus feinstem Leder. Sie sind angenehm zu tragen "
    "und schuetzen die Haende sehr gut.");
  SetProp(P_NAME, "Lederhandschuhe");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"handschuhe","lederhandschuhe"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_GLOVE); 
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 800);

}
