inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar wunderschoene Seidenhandschuhe");
  SetProp(P_LONG, 
    "Ein Paar wunderschoener Handschuhe aus wertvoller Seide. Auf der "
    "Aussenseite sind sie mit kleinen Perlen verziert, was sie im Licht "
    "huebsch funkeln laesst.");
  SetProp(P_NAME, "Seidenhandschuhe");
  SetProp(P_NAME_ADJ, "wunderschoen");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"handschuhe","seidenhandschuhe"}) );
  AddAdjective( ({"wunderschoen", "wunderschoene"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_GLOVE); 
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_SILK:90, MAT_PEARL:10]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 1400);
}

