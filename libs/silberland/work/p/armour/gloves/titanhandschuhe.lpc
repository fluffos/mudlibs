inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein Paar Titanhandschuhe");
  SetProp(P_LONG,
    "Ein Paar Handschuhe aus winderstandsfaehigem, aber trotzdem extrem "
    "leichtem Titan. Aus vielen kleinen Titanplatten wurden mit viel "
    "handwerklichem Geschick diese Handschuhe gefertigt, die beinahe so "
    "beweglich und geschmeidig wie Lederhandschuhe sind, aber doch die "
    "Haende viel besser schuetzen.");
  SetProp(P_NAME, "Titanhandschuhe");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"handschuhe","titanhandschuhe" }));
  
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_TITANIUM:100]));
  SetProp(P_WEIGHT, 500);  
  SetProp(P_VALUE, 1500); 
}

