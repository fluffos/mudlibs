inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Wollhandschuhe");
  SetProp(P_LONG, 
    "Ein Paar Handschuhe aus warmer Schafwolle. Sie waermen die Finger sehr "
    "gut, dafuer leidet die Fingerfertigkeit aber sehr, denn mit diesen "
    "dicken Wollhandschuhen hat man kaum mehr ein Gefuehl dafuer, was man "
    "son in der Hand hat.");
  SetProp(P_NAME, "Wollhandschuhe");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"handschuhe","wollhandschuhe"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_GLOVE); 
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_WOOL:100]) );
  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 700);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3, T_HEAT_PROT:-2]) );
}

