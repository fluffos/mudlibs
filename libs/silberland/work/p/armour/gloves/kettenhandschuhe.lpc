inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Kettenhandschuhe");
  SetProp(P_LONG,  
    "Diese Handschuhe aus Kettengewebe schuetzen die Haende ganz "
    "ausgezeichnet. Was diese Handschuhe aber so wertvoll macht, ist aber "
    "die Vergoldung. Dadurch leuchten die Haende so hell wie die Sonne.");
  SetProp(P_NAME, "Kettenhandschuhe");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"handschuhe", "kettenhandschuhe"}) );

  SetProp(P_ARMOUR_TYPE, AT_GLOVE );
  SetProp(P_AC, 6);
  SetProp(P_MATERIAL, ([MAT_STEEL:90, MAT_GOLD:10]) );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 2000);

}

