/*
 * /p/weapon/armour_inh.c
 *
 * Armour inheriter
 * Sorgt fuer Logging der verwendenden Objekte
 *
 */


inherit "/std/armour";

void create()
{
  ::create();
  if (this_object() && file_name(this_object())[0..9] != "/p/armour/")
  {
    raise_error("Bitte std/armour als inherit verwenden!");
    return;
  }
  if (this_object() && previous_object())       // do I still exist? pred?
  {
    "/p/armour/armourmaster"->Register(
        explode( file_name(), "#" )[0],
        explode( file_name(previous_object()), "#" )[0] );
  }
}

