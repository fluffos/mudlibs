#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <attributes.h>
#include <moving.h>
#include "/p/daemon/skillmaster/skillmaster.h"
#include "../reading.h"


create() {
  if(is_clone()) destruct();
}

void ReadSuccessFunc(object reader) {
  string skill;
  mapping skill_map;
  int skillLevel;

  skill = PO->QueryProp("skill");
  skill_map=reader->QueryProp(P_EXTERNAL_SKILLS);

  // damit der skill sicher eingetragen ist im SPieler
  skillLevel = SKILLMASTER->QuerySkill(reader, skill);

  if(skill_map[skill] > skill_map[skill,3])  {
      tell_object(reader, BS("Leider lernst du durch diese Lektuere nichts mehr."));
      return;
  }

  if(BOOKMASTER->HasReadBook(reader, PO)) {
      tell_object(reader, BS("Das hast du schon einmal gelesen. Du lernst nichts Neues."));
      return;
  }

  tell_object(reader, BS(sprintf("Du lernst etwas ueber '%s' dazu!", CAP(SKILL2NAME[skill]))));

  SKILLMASTER->LearnSkill(reader, skill, 50+random(100));

  return;
}
