#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <attributes.h>
#include <moving.h>
#include "/p/daemon/skillmaster/skillmaster.h"
#include "../reading.h"


create() {
  if(is_clone()) destruct();
}

void ReadSuccessFunc(object reader) {
    object ob;
    int i;
    string *keys, endSkills, id;
    mapping skillMod;

    ob = clone_object(READ_OBJ("wearable"));
    skillMod = PO->QueryProp(P_SKILL_MOD);

    keys = m_indices(skillMod);
    endSkills = "";
    for(i=0;i<sizeof(keys); ++i) {
      endSkills += "'" + CAP(SKILL2NAME[keys[i]])+"', ";
      if(objectp(present("\nreading_skillboost_"+keys[i], reader))) {
        tell_object(reader, BS("Dieses Wissen hilft dir gerade nicht, da du schon etwas Aehnliches im Kopf hast."));
        ob->remove(1);
        return;
      }
      ob->AddId("\nreading_skillboost_"+keys[i]);
    }

    id = "reading_"+getuid(reader)+"_"+time();
    ob->AddId(id);

    ob->SetProp(P_SKILL_MOD, skillMod);
    ob->SetTimeout(random(3)+1 * (1800+random(1800)));
    endSkills = endSkills[0..strlen(endSkills)-2];

    if(ob->move(reader, M_NOCHECK) != 1) {
      destruct(ob);
      return;
    }

    ob->SetEndMessage(sprintf("Deine Faehigkeit(en) %s sind nun nicht mehr verbessert.", endSkills));
    tell_object(reader, BS(sprintf("Deine Faehigkeiten %s sind nun eine zeitlang verbessert.", endSkills)));

    ob->DoWear(1);
    return;
}
