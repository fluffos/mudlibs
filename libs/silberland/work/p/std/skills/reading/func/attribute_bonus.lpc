#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <attributes.h>
#include <moving.h>
#include "../reading.h"


create() {
  if(is_clone()) destruct();
}

void ReadSuccessFunc(object reader) {
    object ob;

    ob = clone_object(READ_OBJ("bonus"));
    if(ob->move(reader, M_NOCHECK) != 1) {
        destruct(ob);
        return;
    }

    ob->SetProp(P_X_ATTR_MOD, PO->QueryProp("attr_bonus"));
    ob->SetTimeout(1800+random(1800));
    reader->UpdateAttributes();

    return;
}
