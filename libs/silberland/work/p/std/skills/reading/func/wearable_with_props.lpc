#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>
#include <attributes.h>
#include <moving.h>
#include "/p/daemon/skillmaster/skillmaster.h"
#include "../reading.h"


create() {
  if(is_clone()) destruct();
}

void ReadSuccessFunc(object reader) {
    object ob;
    int i;
    string *keys, id;
    mapping properties;

    ob = clone_object(READ_OBJ("wearable"));
    properties = PO->QueryProp("properties");

    keys = m_indices(properties);
    for(i=0;i<sizeof(keys); ++i) {
      if(objectp(present("\nreading_propitem_"+keys[i], reader))) {
        tell_object(reader, BS("Dieses Wissen hilft dir gerade nicht, da du schon etwas Aehnliches im Kopf hast."));
        ob->remove(1);
        return;
      }
      ob->AddId("\nreading_propitem_"+keys[i]);
      ob->SetProp(keys[i], properties[keys[i]]);
    }

    ob->SetTimeout(PO->QueryProp("duration"));
    if(ob->move(reader, M_NOCHECK) != 1) {
      destruct(ob);
      return;
    }

    ob->SetEndMessage(PO->QueryProp("end_message"));
    ob->DoWear(1);
    return;
}
