private string generateTitle() {
  int type, nParts;
  string title;

  type = random(sizeof(typen));
  title = typen[type];

  for(nParts=random(2)+1;nParts>0;nParts--) {
    title += " " + themen[random(sizeof(themen))];
  }

  return title;
}

private string destructChanceStr(int chance) {
  switch(chance) {
    case 0 .. 5: return "wirkt neu"; break;
    case 6 .. 15: return "hat leichte Gebrauchsspuren"; break;
    case 16 .. 25: return "wurde schon mehrfach gelesen"; break;
    case 26 .. 30: return "scheint viel gelesen zu sein"; break;
    case 31 .. 45: return "ist schon sehr zerfleddert"; break;
    case 46 .. 55: return "hat schon einiges durchgemacht"; break;
    case 56 .. 70: return "faellt schon fast auseinander"; break;
    case 71 .. 80: return "haelt kaum noch zusammen"; break;
    case 81 .. 95: return "besteht eigentlich nur noch aus ein paar losen Seiten"; break;
    default: return "ist ein Wunder, dass es nicht schon lange zerfallen ist.";
  }
}

private string readability(int readability) {
  switch(readability) {
    case -10000 .. -7500: return "Es ist besonders fuer Leseanfaenger geeignet."; break;
    case -7499 .. -5000: return "Es ist ein sehr einfach geschriebenes Buch."; break;
    case -4999 .. -2500: return "Dieses Buch ist leicht zu lesen."; break;
    case -2499 .. -500: return "Das Buch wirkt simpel geschrieben und einfach zu verstehen."; break;
    case -499 .. 500: return "Dieses Buch weder einfach nach noch leicht zu lesen."; break;
    case 501 .. 1000: return "Es braucht schon etwas Uebung, um dieses Buch zu verstehen"; break;
    case 1001 .. 2500: return "Um dieses Buch zu lesen musst du schon etwas Zeit investieren."; break;
    case 2501 .. 5000: return "Dieses Buch ist schwer verstaendlich."; break;
    case 5001 .. 7500: return "Das zu lesen wird nicht so leicht ohne Universitaetsabschluss"; break;
    default: return "Das Buch scheint kaum verstaendlicher Fachjargon zu sein."; break;
  }
}

void create()
{
  string title;
  int destructChance, difficulty, learnChance;
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  title = generateTitle();
  destructChance = random(100);
  difficulty = -10000 + random(20000);
  learnChance = -500 + random(1000);

  SetProp(P_SHORT, "Das Buch '"+title+"'");
  SetProp(P_LONG,
    "Dieses Buch ist in einen "+COLOR+"en "+EINBAND+"einband geschlagen. Seine Seiten sind "+SEITEN+" und "
    +SEITEN+". Auf den Buchdeckel wurden folgende Lettern aufgepraegt\n "
    "    " + title+"\n"
    "Es " + destructChanceStr(destructChance)+". " + readability(difficulty));

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Buch '"+title+"'");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 1);
  AddId( ({"buch", lower_case(title), "\nrandom_book"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_INK: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 300 + random(3000));
  SetProp(P_VALUE, 20 + random(460));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, "rBook_"+title);
  SetProp(P_BOOK_DIFFICULTY, difficulty);
  SetProp(P_BOOK_TEXTS, 
    ({"Nach dieser Lektuere kommst du zu folgender Erkenntnis:\n" + ausgaben[random(sizeof(ausgaben))]}));
  SetProp(P_BOOK_LEARN, learnChance);
  SetProp(P_BOOK_SUCCESS_FUNC, TO);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, destructChance);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Du hast das Buch vollstaendig gelesen. Zurfieden legst du es zur Seite.");
}

void ReadSuccessFunc(object reader)
{
    SetProp(P_BOOK_DESTRUCT_CHANCE, QueryProp(P_BOOK_DESTRUCT_CHANCE) + 1);
    return;
}
