#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Buch 'Uebungen fuer mehr Gelenkigkeit'");
  SetProp(P_LONG,
    "Der Einband des Buches ist mit gemuetlichen Hobbit-Ornamenten verziert, "
    "die an ein ueppiges Festmahl erinnern. Die Seiten sind von zartem, "
    "natuerlichem Papier, auf dem die Worte in liebevoller Hobbit-Schrift "
    "niedergeschrieben sind. Die Aura des Buches ist warm und einladend, "
    "als ob der Leser direkt zu einem festlichen Abendessen eingeladen waere." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Buch 'Uebungen fuer mehr Gelenkigkeit'");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MAGIC: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Der Hobbit-Autor beschreibt in herzlicher Manier Uebungen, die nach "
      "einem ueppigen Festmahl die Gelenkigkeit verbessern sollen. Von "
      "'Die Butterstampfer-Drehung' bis zur 'Hobbit-Fussmassage' sind die "
      "Uebungen so gemuetlich wie das Lachen eines Hobbits nach einem guten Essen."}));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 25);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Nach dieser Lektuere fuehlst du dich sofort beweglicher.");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("attribute_bonus"));
  SetProp("attr_bonus", ([A_DEX: 1]));
}
