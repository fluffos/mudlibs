#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Buch 'Dauerlauf fuer Anfaenger'");
  SetProp(P_LONG,
    "Der Einband dieses Buches strahlt eine harmonische Verbindung zur Natur "
    "aus, mit Abbildungen von laufenden Elfen durch majestaetische Waelder. Die "
    "Seiten sind mit einer leichten, energievollen Aura versehen, die den "
    "Wunsch nach Ausdauer und Naturverbindung weckt." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Buch 'Dauerlauf fuer Anfaenger'");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MAGIC: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 333);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Kapitel 1: Die Elfenmethode des Dauerlaufens\n"
      "In diesem Kapitel vermittelt der elfische Dauerlaufcoach die Grundlagen "
      "der Elfenmethode. Es umfasst die richtige Atmung, Lauftechniken und den "
      "Aufbau von Ausdauer. Die Worte sind wie sanfte Schritte im Einklang mit "
      "der Natur, waehrend der Leser die Kunst des Dauerlaufens erfaehrt.",
      "Kapitel 2: Die Verbindung zur Natur\n"
      "Das Buch betont die spirituelle Komponente des Dauerlaufens. Es erklaert, "
      "wie die Verbindung zur Natur die Ausdauer staerkt und den Laeufer mit der "
      "umgebenden Energie harmonisiert. Die Texte sind durchzogen von einer "
      "elfischen Ruhe, die den Leser auf eine Reise der koerperlichen und geistigen "
      "Ausdauer entfuehrt."}));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 25);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Nach dieser Lektuere fuehlst du dich sofort ausdauernder. Die Elfenmethode wirkt!");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("attribute_bonus"));
  SetProp("attr_bonus", ([A_CON: 1]));
}
