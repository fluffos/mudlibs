#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"
#include "/p/daemon/skillmaster/skillmaster.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Handbuch zum Loechergraben");
  SetProp(P_LONG,
    "Der Einband des Buches zeigt schematische Zeichnungen von Zwerge beim "
    "Loechergraben, umgeben von Werkzeugen und Minenlandschaften. Die Seiten "
    "sind von robustem Papier, auf dem praezise Anweisungen und Skizzen zum "
    "exakten Graben von Loechern niedergeschrieben sind." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Handbuch zum Loechergraben");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch", "handbuch", "loechergraben"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MAGIC: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, -5000);
  SetProp(P_BOOK_TEXTS, 
    ({"Dieses praxisnahe Handbuch gibt detaillierte Anweisungen, wie Zwerge "
      "ihre Loecher mit hoechster Praezision graben koennen. Von der Auswahl der "
      "richtigen Schaufel bis zur optimalen Haltung beim Graben, sind die "
      "Schriften klar und direkt. Skizzen illustrieren jeden Schritt des Loechergrabens." }));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 5);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Fuer einen kurzen Moment durchflutet die Praktikabilitaet des "
                                  "Handbuchs deine Handlungen, als ob du selbst in den Tiefen "
                                  "der Zwergenmine arbeitest");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("skill_bonus"));
  SetProp(P_SKILL_MOD, ([SK_DIGGING: 200 + random(300)]));
}
