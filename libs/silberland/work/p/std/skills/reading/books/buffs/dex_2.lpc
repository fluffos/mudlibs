#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Buch 'Von der Beweglichkeit der Elfen'");
  SetProp(P_LONG,
    "Der Einband des Buches ist mit elfischen Ornamenten verziert, die an "
    "fliessende Bewegungen erinnern. Die Seiten sind von feinstem Pergament, "
    "auf dem detaillierte Zeichnungen und Schriften in elfischer Sprache zu "
    "sehen sind. Die Aura des Buches ist anmutig und geheimnisvoll, als ob "
    "die Beweglichkeit der Elfen direkt aus den Seiten zu stroemen scheint." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Buch 'Von der Beweglichkeit der Elfen'");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch", "elfenbuch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MAGIC: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 400);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Kapitel 1: Die Eleganz der Gelenke\n"
      "Diese anatomische Studie untersucht detailliert die Struktur der "
      "elfischen Gelenke und erklaert, wie diese zu ihrer besonderen Beweglichkeit "
      "beitragen. Das Kapitel ist mit kunstvollen Zeichnungen von elfischen "
      "Gelenken illustriert, die die Schoenheit und Funktionalitaet dieser anatomischen "
      "Strukturen verdeutlichen.",
      "Kapitel 2: Praktische Anweisungen fuer elfische Beweglichkeit\n"
      "Hier findet der Leser detaillierte Anweisungen, um die eigene Gewandtheit zu "
      "erhoehen. Die Schriften geben Einblicke in elfische Bewegungstechniken und trainieren "
      "die Leser, ihre Gelenke auf elfische Weise zu nutzen. Die Worte sind fliessend wie "
      "der Tanz der Elfen, waehrend sie ihre Anmut in praktische Uebungen uebertragen."}));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 25);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Nach dieser Lektuere fuehlst du dich sofort beweglicher.");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("attribute_bonus"));
  SetProp("attr_bonus", ([A_DEX: 2]));
}
