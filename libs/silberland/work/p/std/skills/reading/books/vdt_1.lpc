#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Buch 'Von den Toten, Band I'");
  SetProp(P_LONG,
    "Dieses Buch wurde in schwarzes Leder gebunden. Seine Seiten sind alt und "
    "vergilbt. Ein fauliger und modriger Geruch, wie von frischer Graberde "
    "geht davon aus. In grossen, silbernen Lettern ist folgendes aufgepraegt:\n "
    " VON DEN TODTEN I: Yber Den Tsomby" );

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Dieses Buch enthaelt offenbar nekromantisches Wissen!");
  SetProp(P_NAME, "Von den Toten, Band I");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch", "von den toten", "band 1", "von den toten 1", 
           "von den toten band 1"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_SKIN: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 6666);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Der Zombie ist der geringste der lebenden Toten. Bereits die "
      "geringsten unter den Nekromanten erlernen ihn zu erheben.",
      
      "Ein erhobener Leichnam von geringer Verwesung wird Zombie "
      "geheissen. Um einen solchen lebenden Toten zu erschaffen, "
      "nimm einen frisch Verstorbenen. Entgegen verbreiteter "
      "Meinungen - auch unter meines gleichen - ist es fuer die "
      "Kraft des Zombies nicht von belang wie stark verwest "
      "das Grundmaterial bereits sei. Einzig die Staerke des "
      "Rohmaterials ist von Relevanz.",
      
      "Jene Verdammten, die sich in hoeheren Kreisen der "
      "heulenden Finsternis waehnen, vermoegen auf die einfache "
      "Hilfe des Zombie verzichten. Er ist dumm und einfach. "
      "So vermag er keine Waffen zu fuehren und nur selten "
      "wird sein Anblick Deinen Feinden genug Furcht einjagen, "
      "um ihr Herz zu Halt zu bringen!"}));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_SUCCESS_FUNC, TO);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 10);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Mit diesem neuen Wissen fuehlst Du dich boesartiger als zuvor!");
  SetProp(P_BOOK_MAX_LEARN, 1500);

}

void ReadSuccessFunc(object reader)
{
    reader->SetProp(P_ALIGN, reader->QueryProp(P_ALIGN)-100);
    return;
}
