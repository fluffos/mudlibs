#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"
#include "../guildbook.h"

inherit "/p/std/skills/reading/books/guild_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Folio mit dem Titel 'Skelette, Zombies und Mumienhelfer'");
  SetProp(P_LONG,
    "Dieses Folio ist von einem gealterten Lederumschlag umgeben, dessen "
    "Oberflaeche von Runen durchzogen ist. Die Seiten im Inneren bestehen "
    "aus Pergament, das mit schattenhaften Illustrationen von Skeletten, "
    "Zombies und geisterhaften Mumien verziert ist. Eine schwache, morbide "
    "Aura haftet an dem Folio, als ob die Seelen der Toten zwischen den "
    "Zeilen gefangen sind." );

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Dieses Buch enthaelt offenbar nekromantisches Wissen!");
  SetProp(P_NAME, "Folio mit dem Titel 'Skelette, Zombies und Mumienhelfer'");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"folio", "buch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_BLOOD:10,  MAT_SKIN: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 6666);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 500);
  SetProp(P_BOOK_TEXTS, 
    ({"Kapitel 1: Die Grundlagen der Totenerweckung\n"
      "Dieser Abschnitt behandelt die grundlegenden Konzepte der Totenerweckung, "
      "angefangen bei der Auswahl der Leiche bis hin zur richtigen Vorbereitung "
      "des Rituals. Der Text ist klar und lehrreich, aber dennoch von einer duesteren "
      "Atmosphaere durchzogen, die die Trennlinie zwischen Leben und Tod betont.",
      "Kapitel 2: Der Tanz der Skelette\n"
      "Hier werden die Feinheiten der Erweckung von Skeletten enthuellt. Der Autor "
      "beschreibt die Bewegungsablaeufe und das richtige Setzen der Knochen, um lebendige "
      "Skelette zu erschaffen. Die Worte hallen wie das Klappern von Knochen in einem "
      "leeren Grab.",
      "Kapitel 3: Die Wandlung der Zombies\n"
      "Dieses Kapitel widmet sich der Erschaffung von Zombies und betont die Bedeutung "
      "der Verwesung und des richtigen Einsatzes von Seelenenergie. Die Beschreibungen "
      "sind grafisch und verleihen dem Leser eine unheimliche Vorstellung von wandelnden "
      "Untoten.",
      "Kapitel 4: Die Macht der Mumienhelfer\n"
      "Hier werden die Mumien als anspruchsvollere Helfer behandelt. Der Text gibt Einblicke "
      "in die notwendigen magischen Symbole und Rituale, um Mumien zu erschaffen, die ueber "
      "erweiterte Faehigkeiten verfuegen. Die Atmosphaere ist gepraegt von altertuemlicher Mystik "
      "und Respekt vor den Mumien.",
      "Kapitel 5: Die Harmonie in der Anrufung des Kharr-Zzteth\n"
      "Das letzte Kapitel verbindet die vorherigen Abschnitte und zeigt, wie die Anrufung "
      "des Kharr-Zzteth als kraftvolle Einheit genutzt werden kann, um ein Ensemble von Untoten "
      "zu kontrollieren. Die Worte sind von einer erhabenen Dunkelheit durchzogen, die den Leser "
      "tief in die Geheimnisse der Totenerweckung fuehrt."}));
  SetProp(P_BOOK_LEARN, 500);
  SetProp(P_BOOK_DESTRUCT_CHANCE, 10);
  SetProp(P_BOOK_SUCCESS_MESSAGE,"Die Worte enthuellen sich dir, und ploetzlich "
                                 "fuellt eine dunkle Erleuchtung seinen Verstand. ");
  SetProp(P_BOOK_NONREADABLE_PSSAGES, QueryProp(P_BOOK_NONREADABLE_PSSAGES) + ({
    "Deine Augen verweilen auf den Worten, doch sie entschluepfen deinem Verstaendnis wie Schatten in der Nacht.",
    "Ein Kribbeln des Unbehagens durchfaehrt dich, als die Worte auf der Schriftrolle zu verschwimmen scheinen."
  }));
  SetProp(P_GUILDBOOK_GUILD, "nekromanten");
  SetProp(P_GUILDBOOK_MAX_SKILL, 9800);
  SetProp(P_GUILDBOOK_SKILL, "anrufung des kharr-zzteth");
  SetProp(P_GUILDBOOK_SKILL_NAME, "Anrufung des Kharr-Zzteth");
}
