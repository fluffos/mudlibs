#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"
#include "../guildbook.h"

inherit "/p/std/skills/reading/books/guild_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Die Papyrusrolle 'Die Kunst der Einbalsamierung'");
  SetProp(P_LONG,
    "Die Papyrusrolle ist aus feinem Papyrus gefertigt und mit detaillierten "
    "Hieroglyphen und Illustrationen geschmueckt. Die Farben, von rostigem "
    "Braun bis zu tiefem Gold, spiegeln die Waerme der Wuestensonne wider. "
    "Die Rolle verstroemt einen Hauch von exotischen Gewuerzen und Erde, als "
    "ob sie die Essenz der Wuestenluft in sich traegt." );

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Dieses Buch enthaelt offenbar nekromantisches Wissen!");
  SetProp(P_NAME, " Papyrusrolle 'Du Kunst der Einbalsamierung'");
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"rolle", "papyrusrolle", "papyrus"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_PAPER:100]));
  SetProp(P_WEIGHT, 600);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Kapitel 1: Die Kunst der Vorbereitung\n"
      "Dieses Kapitel fuehrt in die grundlegenden Techniken der Einbalsamierung "
      "ein. Es beschreibt die richtige Auswahl der Leiche, die Reinigung des "
      "Koerpers und die Anwendung von Salzen und Oelen. Die Worte sind von einer "
      "ruhigen Ernsthaftigkeit durchdrungen, die den Respekt vor dem Prozess betont.",
      "Kapitel 2: Der Tanz der Aromen\n"
      "Hier werden die feinen Nuancen der Duftstoffe und Oele enthuellt, die waehrend "
      "der Einbalsamierung verwendet werden. Der Text vermittelt ein tiefes Verstaendnis "
      "fuer die Symbolik hinter den Duftstoffen und wie sie dazu beitragen, den Koerper "
      "fuer die Reise ins Jenseits vorzubereiten. Die Worte wirken wie eine Melodie, "
      "die die Sinne des Lesers berauscht.",
      "Kapitel 3: Der Fluch der Mumie\n"
      "Das abschliessende Kapitel beleuchtet die mystische Seite der Mumien. Es beschreibt "
      "den'Fluch der Mumie' und wie er in den Ritualen der Einbalsamierung verwoben ist. "
      "Der Text hebt die Bedeutung von Respekt und Ritualen hervor, um die Seele der "
      "Mumie zu beschwichtigen. Die Worte sind von einer geheimnisvollen Atmosphaere "
      "umhuellt, die den Leser in die alten Rituale entfuehrt."}));
  SetProp(P_BOOK_LEARN, -300);
  SetProp(P_BOOK_DESTRUCT_CHANCE, 25);
  SetProp(P_BOOK_SUCCESS_MESSAGE,"Die Worte enthuellen sich dir, und ploetzlich "
                                 "fuellt eine dunkle Erleuchtung seinen Verstand. ");
  SetProp(P_GUILDBOOK_GUILD, "nekromanten");
  SetProp(P_GUILDBOOK_MAX_SKILL, 9800);
  SetProp(P_GUILDBOOK_SKILL, "fluch der mumie");
  SetProp(P_GUILDBOOK_SKILL_NAME, "Fluch der Mumie");
}
