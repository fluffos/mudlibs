#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Buch 'Von der Intelligenz'");
  SetProp(P_LONG,
    "Dieses Buch ist in edlem, dunklem Einband gehuellt, verziert mit filigranen "
    "goldenen Ornamenten. Die Seiten sind mit winzigen, kunstvoll geschriebenen "
    "Schriftzeichen gefuellt, die einen Eindruck von tiefer Weisheit und "
    "intellektueller Raffinesse vermitteln. Beim Beruehren spuert man die prickelnde "
    "Energie des Wissens, die aus den Seiten zu stroemen scheint." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Buch 'Von der Intelligenz'");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch", "von der intelligenz"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MAGIC: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 333);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Der Text in diesem Kapitel ist eine tiefe Erkundung der vielschichtigen "
      "Natur des Denkens und der Intelligenz. Es diskutiert abstrakte Konzepte "
      "wie kognitive Flexibilitaet und algorithmische Informationsverarbeitung in "
      "einer Weise, die die Grenzen des Verstaendnisses herausfordert. Die Saetze "
      "sind kunstvoll verwoben, und die Worte scheinen einen Tanz der Intellektualitaet "
      "aufzufuehren."}));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 25);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Nach dieser Lektuere fuehlst du dich sofort klueger.");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("attribute_bonus"));
  SetProp("attr_bonus", ([A_INT: 1]));
}
