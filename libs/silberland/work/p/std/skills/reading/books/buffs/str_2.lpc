#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Buch 'Sieben einfache Regeln fuer mehr Kraft'");
  SetProp(P_LONG,
    "Der Einband des Buches ist rustikal und zeigt das Bild eines baertigen, "
    "muskuloesen Kerls, der mit einer Axt Holz hackt. Die Seiten sind von "
    "echtem, robustem Papier, auf dem die Worte im fiesen steirischen "
    "Dialekt von Arnold S. niedergeschrieben sind. Die Aura des Buches "
    "ist bodenstaendig und voller burschikoser Energie." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Buch 'Sieben einfache Regeln fuer mehr Kraft'");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch", "logik und intellekt"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MAGIC: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 333);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Kapitel 1: Die G'stampften Grundregeln\n"
      "Arnold S. legt los und erklaert in seinem fiesen steirischen Dialekt "
      "die grundlegenden Regeln fuer mehr Kraft. Von \"Schweiss is' guad, "
      "Traenen san fuer'n Babys\" bis zu \"Oft moi a Oachterl steirischen Apfelsaft "
      "trink'n\", sind die Ratschlaege so bodenstaendig wie ein Almabtrieb.",
      "Kapitel 2: Von der Hax'n bis zur Gurgel\n"
      "Hier geht's um konkrete Uebungen und Ernaehrungstipps. Arnold S. teilt seine "
      "Erfahrungen als echter Profi und betont, dass \"a kraeftige Gurgel a wichtige Muskel is\". "
      "Die Worte sind so klar wie der steirische Bergbach, direkt und ohne Schnickschnack."}));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 33);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Nach dieser Lektuere fuehlst du dich sofort stark wie ein Bodybuilder.");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("attribute_bonus"));
  SetProp("attr_bonus", ([A_STR: 2]));
}
