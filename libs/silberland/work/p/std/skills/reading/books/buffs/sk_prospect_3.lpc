#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"
#include "/p/daemon/skillmaster/skillmaster.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Buch 'Die Schaetze der Erde'");
  SetProp(P_LONG,
    "Der Einband des Buches praesentiert funkelnde Edelsteine in ihrer "
    "natuerlichen Pracht, umrahmt von Berglandschaften und Minen. Die Seiten "
    "sind von hochwertigem Papier, auf dem umfassende Informationen ueber die "
    "unst des Edelsteinschuerfens und -abbaus niedergeschrieben sind." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Buch 'Die Schaetze der Erde'");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MISC_JEWEL: 30, MAT_PAPER: 60]));
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, -500);
  SetProp(P_BOOK_TEXTS, 
    ({"Kapitel 1: Grundlagen des Edelsteinschuerfens\n"
      "Dieses Kapitel bietet einen detaillierten Einblick in die Grundlagen "
      "des Edelsteinschuerfens, von den verschiedenen Arten von Edelsteinen bis "
      "zu den besten Methoden fuer die Identifikation von Schuerfstellen. Praktische "
      "Tipps, wie man die Werkzeuge richtig einsetzt, machen es zu einem "
      "unverzichtbaren Begleiter fuer angehende Edelsteinschuerfer.",
      "Kapitel 2: Die Kunst des Edelsteinabbaus\n"
      "Hier wird die Kunst des Edelsteinabbaus behandelt, angefangen von "
      "traditionellen Methoden bis hin zu modernen Techniken. Die Schriften sind "
      "von einer tiefen Wertschaetzung fuer die natuerliche Schoenheit der Edelsteine "
      "durchdrungen. Von Smaragden ueber Diamanten bis zu Saphiren werden die "
      "unterschiedlichen Abbauverfahren und ihre Herausforderungen erlaeutert.",
      "Kapitel 3: Die Suche nach dem perfekten Edelstein\n"
      "Das letzte Kapitel widmet sich der Suche nach dem perfekten Edelstein, "
      "angefangen bei der Auswahl der richtigen Schuerfgebiete bis hin zur "
      "Identifikation hochwertiger Steine. Inspirierende Geschichten von "
      "Entdeckern und Edelsteinsammlern verleihen diesem Kapitel eine erhebende Note."}));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 5);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Diese Einfuehrung in die Welt der Edelsteine war wirklich interessant!");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("skill_bonus"));
  SetProp(P_SKILL_MOD, ([SK_PROSPECT: 1000 + random(1000)]));
}
