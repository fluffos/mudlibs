#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit "/p/std/skills/reading/std_book";

#define PARTS   ({"Yok", "Zuum", "Uul", "Zzteth", "Krarth", "Nyogul", "Morgul", "Guuhl", "Sschach", "Njark", \
                  "Zirm", "Vrek", "Tthar", "Zol", "Iyek", "Sfrib", "Srf", "Znarr", "Thol", "Tharg", "Toth", "Mrn", \
                  "Prak", "Farnk", "Ierk", "Isha", "Yahdzyn", "Vyol", "Khaza", "Doom", "Yog", "Yoh", "Naho", "Tuur",\
                  "Oth", "Zztta", "Yol", "Ghurmak", "Kolak", "Khai"})
#define CONNECTORS ({"-", "'", ""}) 

private string generateNekroName() {
  string name, connector;
  int nParts;

  name = "";
  for(nParts=2+random(3); nParts>=0; nParts--) {
    connector = CONNECTORS[random(sizeof(CONNECTORS))];
    if(strlen(name) > 0) name += connector;
    if(connector == "" && strlen(name) > 0) name += lower_case(PARTS[random(sizeof(PARTS))]);
    else name += PARTS[random(sizeof(PARTS))];
  }

  return name;
}

void create()
{
  string name;
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  name = generateNekroName();

  SetProp(P_SHORT, "Eine der Schriftrollen von "+name);
  SetProp(P_LONG,
    "Diese vergilbte und modrig riechende Schriftrolle ist mit blutig roten "
    "Runen einer seltsamen Sprache versehen. Ein Geruch von Verwesung geht "
    "von ihr aus. Sie enthaelt offensichtliche ueble Geheimnisse." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Schriftrolle von "+name);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"rolle", "schriftrolle", lowerstring(name)}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_BLOOD: 20,  MAT_MISC_UNHOLY: 10, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_INFO, BS("Diese Schritfrolle enthaelt geheimes Wissen der Nekromanten."));

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Du liest finstere Worte und dunkle Riten. Die Runen pulsieren beim Lesen. "
      "Vor deinen Augen. Sie beschreiben makabere Vorgaenge und widerliche "
      "Angelegenheiten mit Leichen, die der Mehrung des Boesen dienen. Es "
      "handelt sich um die finsteren Rituale von "+name+", welche Anleitung "
      "bieten, um die Kraefte der jenseitigen Finternis besser zu lenken."}));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 25);

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("wearable_with_props"));
  SetProp("properties", ([P_NEKRO_SPELLCOST: 5 + random(5)]));
  SetProp("duration", 1800 + random(1800));
  SetProp("end_message", "Das finstere Wissen von "+name+" verlaesst deinen Geist wieder.");
}

public string _query_book_success_message() {
  if(TP->QueryProp(P_ALIGN) > 0) {
    TP->AddSp(-10);
    return "Ein kalter Schauer laeuft dir den Ruecken hinab. Es fuehlt sich an, als wuerden "
           "die Worte deine Seele aufsaugen!";
  } else if(TP->QueryProp(P_GUILD) == "nekromanten") {
    return "Mit einem haemischen Grinsen kicherst du. Nun kannst du die Kraefte der Finsterns effizienter lenken!";
  }

  return "Schaudernd lest du die Schriftrolle wieder weg.";
}