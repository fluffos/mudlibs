#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"
#include "../guildbook.h"

inherit "/p/std/skills/reading/books/guild_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Heftchen 'Rituale zu wecken die Leich'");
  SetProp(P_LONG,
    "Ein duesteres Werk, dessen Pergament von altertuemlichen Runen und "
    "dunklen Illustrationen geziert wird. Die Seiten tragen die Spuren "
    "vergangener Rituale und scheinen beinahe den Hauch des Todes zu "
    "atmen. Die Tinte ist tiefrot, als ob sie das Blut der Untoten "
    "widerspiegeln wuerde. Beim Beruehren fuehlt man eine kalte, morbide "
    "Praesenz, die die Grenzen zwischen Leben und Tod verschwimmen laesst." );

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Dieses Buch enthaelt offenbar nekromantisches Wissen!");
  SetProp(P_NAME, "Das Heftchen 'Rituale zu wecken die Leich'");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"heft", "heftchen", "rituale zu wecken die leich"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_BLOOD:10,  MAT_SKIN: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 666);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Kapitel 1: Die Kunst des Leichenweckens\n"
      "Dieses Kapitel erkundet verschiedene Methoden, Untote zu erwecken, "
      "angefangen bei einfachen Koerpern bis hin zu maechtigen Geistern. "
      "Es betont die Wichtigkeit der richtigen Vorbereitung und gibt "
      "detaillierte Anweisungen fuer jedes Ritual. Der Text liest sich "
      "wie ein Fluestern aus dem Jenseits, und dunkle Schatten tanzen "
      "zwischen den Zeilen.",
      "Kapitel 2: Die Erhabenheit der Anrufung des Kharr-Zzteth\n"
      "Hier wird die Anrufung des Kharr-Zzteth als der Hoehepunkt "
      "aller Leichenweck-Rituale dargestellt. Der Autor preist die "
      "uebernatuerlichen Kraefte dieser Anrufung und gibt Einblicke "
      "in die feinen Nuancen, um die besten Ergebnisse zu erzielen. "
      "Die Worte sind von einer duesteren Euphorie durchdrungen, die den "
      "Leser tief in die Geheimnisse der Nekromantie fuehrt."}));
  SetProp(P_BOOK_LEARN, 10000);
  SetProp(P_BOOK_DESTRUCT_CHANCE, 10);
  SetProp(P_BOOK_SUCCESS_MESSAGE,"Die Worte enthuellen sich dir, und ploetzlich "
                                 "fuellt eine dunkle Erleuchtung seinen Verstand. ");
  SetProp(P_BOOK_NONREADABLE_PSSAGES, QueryProp(P_BOOK_NONREADABLE_PSSAGES) + ({
    "Deine Augen verweilen auf den Worten, doch sie entschluepfen deinem Verstaendnis wie Schatten in der Nacht.",
    "Ein Kribbeln des Unbehagens durchfaehrt dich, als die Worte auf der Schriftrolle zu verschwimmen scheinen."
  }));
  SetProp(P_GUILDBOOK_GUILD, "nekromanten");
  SetProp(P_GUILDBOOK_MAX_SKILL, 7000);
  SetProp(P_GUILDBOOK_SKILL, "anrufung des kharr-zzteth");
  SetProp(P_GUILDBOOK_SKILL_NAME, "Anrufung des Kharr-Zzteth");
}
