#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"
#include "../guildbook.h"

inherit "/p/std/skills/reading/books/guild_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Buch 'Asche und Blut - Vampire unter sich'");
  SetProp(P_LONG,
    "Das Buch ist in edles, dunkles Leder gebunden, verziert mit Blutspritzern "
    "und  filigranen Silberornamenten. Die Seiten bestehen aus einem glatten, "
    "duennen Pergament, das in einem unheilvollen Rot getoent ist. Auf den Seiten "
    "finden sich Illustrationen von eleganten Vampiren, die im Spiel der Nacht "
    "ihre dunkle Existenz leben. Beim Beruehren spuert man eine kuehle, aber "
    "3lebendige Energie, als ob die Essenz der Nacht durch das Buch stroemt." );

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Dieses Buch enthaelt offenbar nekromantisches Wissen!");
  SetProp(P_NAME, "Buch 'Asche und Blut - Vampire unter sich'");
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch", "vampire unter sich", "vampirbuch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_BLOOD:10,  MAT_SKIN: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 2500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Kapitel 1: Die Geburt der Unsterblichkeit\n"
      "Dieses Kapitel enthuellt die Urspruenge der Vampirrasse und beschreibt "
      "den uebergang von einem sterblichen Wesen zu einem unsterblichen "
      "Geschoepf der Dunkelheit. Die Worte sind von einer unnatuerlichen Klarheit "
      "durchzogen und vermitteln ein tiefes Verstaendnis fuer die VerAenderungen, "
      "die mit der Vampirwerdung einhergehen.",
      "Kapitel 2: Die Kunst des Blutes\n"
      "Hier werden die Feinheiten des Vampirismus detailliert beschrieben. "
      "Der Leser erfaehrt, wie Vampire ihre Beute auswaehlen, das Blut extrahieren "
      "und die speziellen Kraefte des Blutes nutzen. Die Worte sind erotisch "
      "geladen und erwecken die Sinne des Lesers fuer die sinnliche Seite des "
      "Vampirdaseins.",
      "Kapitel 3: Die Schatten des Ewigen Lebens\n"
      "Das abschliessende Kapitel gewAehrt einen Einblick in das Leben eines "
      "Vampirs in der Nacht. Es beschreibt die sozialen Strukturen innerhalb "
      "der Vampirgemeinschaft, die Herausforderungen des ueberlebens und die "
      "Kunst, in den Schatten der Menschheit zu existieren. Die Worte sind von "
      "einer duesteren Romantik durchzogen, die das ambivalente Wesen der "
      "Vampirgesellschaft betont."}));
  SetProp(P_BOOK_LEARN, -300);
  SetProp(P_BOOK_DESTRUCT_CHANCE, 25);
  SetProp(P_BOOK_SUCCESS_MESSAGE,"Die Worte enthuellen sich dir, und ploetzlich "
                                 "fuellt eine dunkle Erleuchtung seinen Verstand. ");
  SetProp(P_BOOK_NONREADABLE_PSSAGES, QueryProp(P_BOOK_NONREADABLE_PSSAGES) + ({
    "Deine Augen verweilen auf den Worten, doch sie entschluepfen deinem Verstaendnis wie Schatten in der Nacht.",
    "Ein Kribbeln des Unbehagens durchfaehrt dich, als die Worte auf der Schriftrolle zu verschwimmen scheinen."
  }));
  SetProp(P_GUILDBOOK_GUILD, "nekromanten");
  SetProp(P_GUILDBOOK_MAX_SKILL, 9800);
  SetProp(P_GUILDBOOK_SKILL, "biss des vampirs");
  SetProp(P_GUILDBOOK_SKILL_NAME, "Biss des Vampirs");
}
