#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"
#include "../guildbook.h"

inherit "/p/std/skills/reading/books/guild_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Die Schriftrolle 'Dunkle Anrufungen fuer Anfaenger'");
  SetProp(P_LONG,
    "Diese Schriftrolle ist mit duesteren Symbolen und geheimnisvollen Glyphen "
    "verziert, die in einem tiefen Schwarz auf einem alten, vergilbten Pergament "
    "geschrieben sind. Die Seiten wirken beinahe lebendig, als wuerden sie die "
    "dunklen Energien des Nekromantenrituals selbst in sich tragen. Beim Beruehren "
    "spuert man eine kalte, unheilvolle Aura, die darauf hinweist, dass dieses Werk "
    "nicht für die zartbesaiteten Seelen gemacht ist." );

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Dieses Buch enthaelt offenbar nekromantisches Wissen!");
  SetProp(P_NAME, "Schriftrolle 'Dunkle Anrufungen fuer Anfaenger'");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"rolle", "schriftrolle", "dunkle anrufungen fuer anfaenger"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_BLOOD:10,  MAT_SKIN: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 666);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Die ersten Zeilen beschreiben die grundlegenden Prinzipien der dunklen "
      "Anrufung und die Bedeutung des Kharr-Zzteth. Der Text betont die "
      "Notwendigkeit von Disziplin und Konzentration, um die Macht der Dunkelheit "
      "zu beherrschen. Die Worte scheinen fast zu fluestern und erzeugen eine "
      "beklemmende Atmosphaere, die dich in die duesteren Geheimnisse des "
      "Nekromantentums einfuehrt."}));
  SetProp(P_BOOK_LEARN, 10000);
  SetProp(P_BOOK_DESTRUCT_CHANCE, 10);
  SetProp(P_BOOK_SUCCESS_MESSAGE,"Die Worte enthuellen sich dir, und ploetzlich "
                                 "fuellt eine dunkle Erleuchtung seinen Verstand. "
                                 "Die Macht des Kharr-Zzteth wird klarer, und die "
                                 "Schriftrolle leuchtet schwach auf, als ob sie "
                                 "die Anerkennung des Nekromanten spuert.");
  SetProp(P_BOOK_NONREADABLE_PSSAGES, ({
    "Deine Augen verweilen auf den Worten, doch sie entschluepfen deinem Verstaendnis wie Schatten in der Nacht.",
    "Die Schrift bleibt undurchdringlich, und das Wissen des Kharr-Zzteth bleibt fuer dich verborgen.",
    "Ein Kribbeln des Unbehagens durchfaehrt dich, als die Worte auf der Schriftrolle zu verschwimmen scheinen, und du begreifst, dass du noch nicht bereit bist, die Dunkelheit zu verstehen."
  }));
  SetProp(P_BOOK_MAX_LEARN, 1500);

  SetProp(P_GUILDBOOK_GUILD, "nekromanten");
  SetProp(P_GUILDBOOK_MAX_SKILL, 5000);
  SetProp(P_GUILDBOOK_SKILL, "anrufung des kharr-zzteth");
  SetProp(P_GUILDBOOK_SKILL_NAME, "Anrufung des Kharr-Zzteth");
}
