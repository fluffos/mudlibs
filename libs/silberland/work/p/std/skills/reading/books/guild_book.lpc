#include <moredef.h>
#include <properties.h>
#include <new_skills.h>
#include "/p/std/skills/reading/reading.h"
#include "guildbook.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_BOOK_SUCCESS_FUNC, TO);
  SetProp(P_GUILDBOOK_MAX_SKILL, 9800);
  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_LEARN, -300);
}

void ReadSuccessFunc(object reader)
{
    mapping oldSkill;
    if(reader->QueryProp(P_GUILD) != QueryProp(P_GUILDBOOK_GUILD) || !reader->QuerySkill(QueryProp(P_GUILDBOOK_SKILL))) {
        tell_object(reader, BS("Mit diesem Wissen kannst du nichts anfangen."));
        return;
    }

    if(reader->QuerySkillAbility(QueryProp(P_GUILDBOOK_SKILL)) > QueryProp(P_GUILDBOOK_MAX_SKILL)) {
        tell_object(reader, BS("Leider lernst du durch diese Lektuere nichts mehr."));
        return;
    }

    if(BOOKMASTER->HasReadBook(reader, TO)) {
        tell_object(reader, BS("Das hast du schon einmal gelesen. Du lernst nichts Neues."));
        return;
    }

    oldSkill = reader->QuerySkill(QueryProp(P_GUILDBOOK_SKILL));
    oldSkill[SI_SKILLABILITY] += random(100);
    reader->ModifySkill(QueryProp(P_GUILDBOOK_SKILL), oldSkill);
    tell_object(reader, BS(sprintf("Du lernst etwas ueber '%s' dazu!", QueryProp(P_GUILDBOOK_SKILL_NAME))));

    return;
}
