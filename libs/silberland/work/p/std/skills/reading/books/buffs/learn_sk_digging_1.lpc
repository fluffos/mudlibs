#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"
#include "/p/daemon/skillmaster/skillmaster.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Lehrbuch fuer kleine Tunnelgraeber");
  SetProp(P_LONG,
    "Der Einband des Buches zeigt verspielte Illustrationen von zwergischen "
    "Kindern, die mit kleinen Schaufeln in froehlicher Gemeinschaft kleine "
    "Tunnel graben. Die Seiten sind von robustem Papier, auf dem klare "
    "Anweisungen und einfache Zeichnungen fuer angehende Tunnelgraeber "
    "niedergeschrieben sind. Es hat schon viele Gebrauchsspuren." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Lehrbuch fuer kleine Tunnelgraeber");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch", "lehrbuch", "traeberbuch", "tunnelbuch", "tunnelgraeberbuch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MAGIC: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, -5000);
  SetProp(P_BOOK_TEXTS, 
    ({"Dieses Buch vermittelt grundlegende Kenntnisse fuer angehende Tunnelgraeber. "
      "Von der richtigen Wahl der Werkzeuge bis zur einfachen Technik des "
      "Tunnelgrabens werden die Informationen in kinderfreundlicher Sprache "
      "vermittelt. Bunte Illustrationen zeigen, wie die jungen Tunnelgraeber "
      "ihre ersten kleinen Gaenge schaffen." }));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 10);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Einfach, aber duch hilfreich ist dein Urteil ueber dieses Buch.");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("learn_skill"));
  SetProp("skill", SK_DIGGING);
}
