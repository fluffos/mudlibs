#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"
#include "/gilden/paladine/paladin_extern.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Buch mit dustygefaelligen Gebeten");
  SetProp(P_LONG,
    "Das Buch mit den dustygefaelligen Gebeten und Gesaengen ist ein heiliges Werk, "
    "das den Anhaengern der Gottheit Dusty gewidmet ist. Der Einband zeigt kunstvoll "
    "gestaltete Symbole der Paladine, die in einem sanften Glanz erstrahlen. "
    "Die Seiten sind aus feinstem Pergament gefertigt und tragen die eingravierten "
    "Zeichen von Segen und Andacht." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Buch mit dustygefaelligen Gebeten");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch", "gebetsbuch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MISC_HOLY: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_INFO, BS("Die Gebete und Gesaenge sind fuer Paladine sehr hilfreich."));

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Dieses Buch enthaelt vierundzwanzig tiefgruendige Gebete und Gesaenge, die der "
      "Herrin Dusty gewidmet sind. Jedes Lied erhebt die Tugenden der Paladine und "
      "preist die schuetzende Hand von Dusty. Die Worte sind in einer altertuemlichen"
      "Sprache verfasst, die die Goettlichkeit der Gesaenge betont."}));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 25);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Nach dieser Lektuere fuehlst du dich sofort ausdauernder. Die Elfenmethode wirkt!");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("wearable_with_props"));
  SetProp("properties", ([P_PALADIN_SPELLCOST: 5 + random(5)]));
  SetProp("duration", 1800 + random(1800));
  SetProp("end_message", "Dustys wohlwollender Blick wendet sich von dir ab.");
}

public string _query_book_success_message() {
  if(TP->QueryProp(P_ALIGN) < 0) {
    TP->AddHp(-10);
    return "Argh! Ein ekelhaftes Gefuehl der Goettlichkeit durchdringt dich.";
  } else if(TP->QueryProp(P_ALIGN) > 500) {
    return "Ein wohliges Gefuehl goettlicher Erhabenheit durchflutet dich. Ehre sei Dusty!";
  }

  return "Du klappst das Buch wieder zu.";
}