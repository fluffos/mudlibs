#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Buch 'Atmen wie die Drachen'");
  SetProp(P_LONG,
    "Der Einband des Buches zeigt verzierte Drachensymbole in tiefem Rot und "
    "Gold. Die Seiten wirken wie vergilbte Pergamentrollen, auf denen die "
    "Weisheiten eines zwerigschen Einsiedlers in der Wueste eingraviert sind. "
    "Beim Beruehren spuert man eine waermende Energie, als ob die Lebenskraft "
    "der Drachen selbst durch die Seiten fliesst." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Buch 'Atmen wie die Drachen'");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MAGIC: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Kapitel 1: Die Atemtechnik der Wuestendrachen\n"
      "Der zwerigsche Einsiedler enthuellt die besondere Atemtechnik der "
      "Drachen, die ihre Lebenskraft aufrechterhaelt. Das Kapitel erklaert "
      "die richtige Art des Ein- und Ausatmens, um die Energiefluesse im Koerper "
      "zu harmonisieren. Die Worte sind wie der warme Wuestenwind, der die "
      "Geheimnisse des Drachenatmens weitertraegt.",
      "Kapitel 2: Die Verschmelzung mit der Lebenskraft\n"
      "Das Buch vertieft die Verbindung zwischen dem Leser und der Lebenskraft "
      "der Drachen. Es beschreibt Meditationstechniken, um die Atemtechnik in"
      "den Alltag zu integrieren und die Ausdauer zu steigern. Die Texte sind "
      "durchdrungen von einer ruhigen, kraftvollen Aura, die den Leser auf "
      "eine Reise zur inneren Staerke mitnimmt."}));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 33);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Nach dieser Lektuere fuehlst du dich sofort ausdauernder. Du schnaufst wie ein Drache!");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("attribute_bonus"));
  SetProp("attr_bonus", ([A_CON: 2]));
}
