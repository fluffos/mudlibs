#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"
#include "/p/daemon/skillmaster/skillmaster.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Buch 'Edelsteinschaetze Enthuellt'");
  SetProp(P_LONG,
    "Der Einband des Buches zeigt einen funkelnden Diamanten auf einem "
    "prachtvollen Samtkissen. Die Seiten sind von edlem Pergament, auf dem "
    "ein einziger Abschnitt voller Wissen und Anleitung fuer die "
    "Edelsteinsuche und -abbau niedergeschrieben ist. " );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Buch 'Edelsteinschaetze Enthuellt'");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 20, MAT_PAPER: 80]));
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, -1000);
  SetProp(P_BOOK_TEXTS, 
    ({"Das Buch ist eine umfassende Anleitung zum Schuerfen und Abbauen von "
      "Edelsteinen. Von der Auswahl der richtigen Ausruestung bis zur "
      "Identifikation der besten Schuerfgebiete wird jeder Schritt praezise "
      "erklaert. Inspirierende Anekdoten von Edelsteinsuchern vermitteln die "
      "Leidenschaft und Faszination dieses Handwerks."}));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 2);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Eine interessante Lektuere!");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("skill_bonus"));
  SetProp(P_SKILL_MOD, ([SK_PROSPECT: 250 + random(250)]));
}
