#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"
#include "/p/daemon/skillmaster/skillmaster.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Die Biographie 'Der Stollen und ich'");
  SetProp(P_LONG,
    "Die Biographie \"Der Stollen und ich\" ist ein einzigartiges Werk, "
    "das die Lebensgeschichte eines erfahrenen zwergischen Bergmanns erzaehlt. "
    "Der Einband zeigt einen verschlungenen Stollen, durchzogen von "
    "schimmernden Mineralien und von Dunkelheit umhuellt. Die Seiten sind "
    "sorgfaeltig auf Pergament gedruckt und tragen die Spuren jahrzehntelanger "
    "Bergbauabenteuer. Es ist schon ziemlich zerlesen und verdreckt." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Biographie 'Der Stollen und ich'");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"buch", "biographie", "stollenbuch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MAGIC: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 300);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, -5000);
  SetProp(P_BOOK_TEXTS, 
    ({"Diese Biographie nimmt den Leser mit auf eine faszinierende Reise in "
      "die Tiefen der Dunkelheit. Es eroeffnet mit den praegenden Kindheitsmomenten "
      "des Bergmanns, der bereits als kleiner Zwerg von der geheimnisvollen Welt "
      "unter der Erde fasziniert war. Das Kapitel fuehrt weiter durch seine Lehrjahre, "
      "wo er die Kunst des Tunnelgrabens von erfahrenen Bergleuten erlernte." }));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 25);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Durch die Erlebnisse des Bergmanns verstehst du nun mehr vom Bergbau.");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("learn_skill"));
  SetProp("skill", SK_DIGGING);
}
