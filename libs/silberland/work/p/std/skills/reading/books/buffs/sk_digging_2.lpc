#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"
#include "/p/daemon/skillmaster/skillmaster.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Buch 'Zwergenbingen und Trollhoehlen'");
  SetProp(P_LONG,
    "Der Einband des Buches zeigt kunstvolle Illustrationen von unterirdischen "
    "Siedlungen. Die Seiten sind von stabilem Papier, auf dem detaillierte "
    "Beschreibungen und Bauplaene verschiedener architektonischer Prinzipien "
    "niedergeschrieben sind. " );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Buch 'Zwergenbingen und Trollhoehlen'");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MAGIC: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 750);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, -500);
  SetProp(P_BOOK_TEXTS, 
    ({"Das erste Kapitel gibt einen umfassenden Einblick in die architektonischen "
      "Prinzipien der Zwergenbingen. Von stabilen Stuetzpfeilern bis zu kunstvollen "
      "Gravuren werden die Techniken der Zwergenbaukunst ausfuehrlich beschrieben. "
      "Die Schriften sind so solide wie der Fels, den die Zwerge unter der Erde formen.",
      "Das zweite Kapitel widmet sich den architektonischen Prinzipien der Trollhoehlen. "
      "Es beschreibt die organischen Formen, die die Trolle in den Felsen meisseln, und "
      "betont die Verbindung mit der Natur. Die Schriften sind von einer wilden, "
      "natuerlichen Energie durchzogen, als ob die Trollhoehlen selbst lebendig waeren."}));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 5);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Nach dem Lesen dieses Buches verstehst du die Architektur "
                                  "von Minen und Schaechten weit besser.");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("skill_bonus"));
  SetProp(P_SKILL_MOD, ([SK_DIGGING: 500 + random(500)]));
}
