#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"
#include "/p/daemon/skillmaster/skillmaster.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Der grosze Almanach der Kreyterkunthe");
  SetProp(P_LONG,
    "Der Einband des Buches ist mit kunstvollen Ranken verziert, die die "
    "Vielfalt der Pflanzen im Silberland symbolisieren. Die Seiten bestehen "
    "aus robustem Pergament, auf dem die Weisheiten von Heribert, dem alten "
    "Moench aus der Steppe, in klaren Schriften niedergeschrieben sind. "
    "Holzdrucke illustrieren die Pflanzen in ihrer natuerlichen Pracht, als ob "
    "der Almanach selbst ein Stueck der Silberland-Wildnis waere." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Almanach der Kreyterkunthe");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch", "almanach"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MAGIC: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 3000);
  SetProp(P_VALUE, 7000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_INFO, BS("Dieser Almanach ist sehr alt und enthaelt Wissen ueber die Pflanzenwelt"));

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Kapitel 1: Die Kraeuter des Feldes und der Wiese\n"
      "Heribert beginnt mit einer detaillierten Auflistung und Beschreibung aller "
      "Kraeuter, die auf den Feldern und Wiesen des Silberlands zu finden sind. "
      "Die Schriften sind von einem Hauch Moenchsruhe durchzogen und geben genaue "
      "Anweisungen zu Standorten, Anwendungen und Heilkraeften.",
      "Kapitel 2: Die Geheimnisse des Waldes\n"
      "Das zweite Kapitel widmet sich den Pflanzen, die im dichten "
      "Wald des Silberlands gedeihen. Von maechtigen Baeumen bis zu zarten "
      "Blueten beschreibt Heribert die Vielfalt und den Nutzen dieser "
      "Pflanzen. Die Holzdrucke zeigen die majestaetische Schoenheit der Waldflora.",
      "Kapitel 3: Die Verborgenen in den Hoehen\n"
      "Heribert fuehrt den Leser zu den hoeheren Gefilden des Silberlands, wo "
      "seltene und geheimnisvolle Pflanzen gedeihen. Die Schriften sind von einer "
      "erhabenen Energie durchdrungen, waehrend sie die Leser durch Bergpfade und "
      "Felsschluchten fuehren. Die Holzdrucke zeigen die erhabene Schoenheit der "
      "Bergpflanzen." }));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 5);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Die Worte enthuellen sich, und du spuerst, wie die Weisheit der Pflanzenwelt des Silberlands in dir aufgeht.");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("skill_bonus"));
  SetProp(P_SKILL_MOD, ([SK_HERBALLORE: 1000, SK_SENSE: 300]));
}
