#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Buch 'Stark wie ein Troll'");
  SetProp(P_LONG,
    "Der Einband des Buches zeigt einen muskelbepackten Troll, der mit einem "
    "riesigen Felsen jongliert. Die Seiten sind von grobem Papier, auf dem "
    "die Worte in einfacher, direkter Sprache niedergeschrieben sind. Die "
    "Aura des Buches ist roh und kraftvoll, als ob die pure Staerke des Trolls "
    "aus den Seiten stroemt." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Buch 'Stark wie ein Troll'");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch", "trollbuch"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MAGIC: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Orgelmar, der starke Troll, gibt seine nicht immer eloquente, aber "
      "effektive Anleitung zum Muskelaufbau preis. Das Kapitel beschreibt "
      "einfache Uebungen, die ohne viel Nachdenken ausgefuehrt werden koennen, "
      "sowie Ernaehrungstipps wie \"Iss mehr Fleisch, werd' staerker!\" Die Worte "
      "sind so direkt wie ein Tritt eines Trolls."}));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 25);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Nach dieser Lektuere fuehlst du dich sofort kraeftiger.");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("attribute_bonus"));
  SetProp("attr_bonus", ([A_STR: 1]));
}
