#include <moredef.h>
#include <properties.h>
#include "/p/std/skills/reading/reading.h"

inherit "/p/std/skills/reading/std_book";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Das Buch 'Logik und Intellekt'");
  SetProp(P_LONG,
    "Das Buch praesentiert sich in einem schlichten, aber eleganten Einband, "
    "der die Essenz von Klarheit und Struktur ausstrahlt. Die Seiten sind mit "
    "praezisen Texten gefuellt, die das Gefuehl von Rationalitaet und Ordnung "
    "vermitteln. Beim Beruehren spuert man die nuechterne Energie der klaren "
    "Gedanken, die von den Seiten ausgeht." );

//--Namen------------------------------------------------------------------
  SetProp(P_NAME, "Buch 'Logik und Intellekt'");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"buch", "logik und intellekt"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_WOOD: 10,  MAT_MAGIC: 20, MAT_PAPER: 70]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 333);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

//--Buchsachen-------------------------------------------------------------

  SetProp(P_BOOK_ID, 0);
  SetProp(P_BOOK_DIFFICULTY, 0);
  SetProp(P_BOOK_TEXTS, 
    ({"Kapitel 1: Die Architektur der Logik\n"
      "In diesem Kapitel wird die Grundstruktur der Logik als Fundament "
      "fuer rationale Denkprozesse erklaert. Es behandelt Themen wie Syllogismen, "
      "Argumentationsformen und die Kunst der klaren Schlussfolgerungen. Die Worte "
      "sind wie Bausteine angeordnet, die die Denkstrukturen des Lesers staerken.",
      "Kapitel 2: Die Kunst der Intellektuellen Debatte\n"
      "Hier taucht das Buch in die Welt der geistigen Auseinandersetzung ein. Es "
      "erklaert die Regeln und Etikette intellektueller Debatten, betont die Wichtigkeit "
      "von Evidenz und die Faehigkeit, ueberzeugende Argumente zu praesentieren. Die Texte "
      "sind durchzogen von einer sachlichen Rhetorik, die den Leser dazu ermutigt, "
      "klare Gedanken zu formulieren."}));
  SetProp(P_BOOK_LEARN, 0);
  SetProp(P_BOOK_FAIL_FUNC, 0); 
  SetProp(P_BOOK_DESTRUCT_CHANCE, 33);
  SetProp(P_BOOK_SUCCESS_MESSAGE, "Nach dieser Lektuere fuehlst du dich sofort klueger.");

  SetProp(P_BOOK_SUCCESS_FUNC, READ_FUNC("attribute_bonus"));
  SetProp("attr_bonus", ([A_INT: 2]));
}
