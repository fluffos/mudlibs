#include <moredef.h>
#include "reading.h"

#define SAVEFILE "/p/std/skills/reading/bookmaster"

// Signaturen
void Save();
void Restore();

// DATA
private mapping books; // liste der bekannten buecher
private mapping players; // buecher, die schon gelesen wurden

public void create() {
  if (is_clone(TO)) return;
  
  players    = ([ ]);
  
  seteuid(getuid(this_object()));
  Restore();
}

public void Save() {
    save_object(SAVEFILE);
    return;
}

public void Restore() {
    restore_object(SAVEFILE);
    return;
}

// prueft, ob ein spieler ein buch bereits gelesen hat
// returns: 1 wenn gelesen
public int HasReadBook(object pl, mixed book) {
    string bookId;

    if(pl == 0)
        return BM_RET_NOT_READ;

    if(objectp(book)) bookId = book->QueryProp(P_BOOK_ID) || explode(file_name(book), "#")[0];
    if(stringp(book)) bookId = book;
    if(!stringp(bookId)) return BM_RET_FAIL;
       
    if(!member(players, pl))
        return BM_RET_NOT_READ;
        
    if(member(players[pl], bookId) > -1) {
        return BM_RET_READ;
    }

    return BM_RET_NOT_READ;
}

// markiert ein buch als von einem spieler gelesen
// returns: 1 bei erfolg, 2 wenn das buch bereits gelesen wurde
public int MarkBookAsRead(object pl, mixed book) {
    string bookId;

    if(pl == 0)
        return -1;

    if(objectp(book)) bookId = book->QueryProp(P_BOOK_ID) || explode(file_name(book), "#")[0];
    if(stringp(book)) bookId = book;
    if(!stringp(bookId)) return BM_RET_FAIL;
    
    if(!member(players, pl))
        players += ([pl: ({})]);
    
    if(HasReadBook(pl, bookId))
        return BM_RET_READ;
        
    players[pl] = players[pl] + ({bookId});
    
    Save();
    return BM_RET_OK;
}
