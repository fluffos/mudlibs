#include "../reading.h"
#include <wizlevels.h>
#include <moredef.h>
#include <properties.h>
#include <armour.h>
#include <combat.h>
inherit "std/armour";
inherit READ_OBJ("messager_base");

private string endMessage;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  AddId( ({"\nreading_wearable"}) );

  SetProp(P_SHORT, ""+time()); // damit mehrere davon getragen werden koennen
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0 );
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOGET, "");
  SetProp(P_INVIS, 1);
  SetProp(P_NEVERDROP, 1);
}

public int remove(int silent) {
    DoUnwear(1);
    return messager_base::remove(silent);
}

