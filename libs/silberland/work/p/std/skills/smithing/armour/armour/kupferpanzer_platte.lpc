inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Plattenpanzer aus Kupfer");
  SetProp (P_LONG,
    "Dieser schoene Plattenpanzer wurde vollstaendig aus Kupfer gefertigt. "
    "Die Platten sind poliert und glitzern goldgelb. An einigen "
    "wichtigen Stellen sind die Platten zusaetzlich verstaerkt, um "
    "die Schutzwirkung noch zu vergroessern.");
  SetProp (P_NAME, "Plattenpanzer");
  SetProp (P_NAME_ADJ, "kupfern");

  SetProp (P_GENDER, MALE);
  AddId (({"panzer","kupferpanzer", "plattenpanzer"}));

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 22);
  SetProp (P_MATERIAL, MAT_COPPER);
  SetProp (P_WEIGHT, 2500);
  SetProp (P_VALUE, 1500);
  
}
