inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  string matname,mat;
  int value;
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_MATERIAL, ([MAT_COPPER:95, MAT_LEATHER:5]) );

  AddDetail( ({"leder"}),
    "Des leder wurde von einem Schneider hergestellt..");
  SetProp(P_SMELL,
    "Das Metall richt nach nichts.");
}

void _init_armor(){

  if(QueryProp(P_ARMOUR_TYPE)=="Umhang" ||
     QueryProp(P_ARMOUR_TYPE)=="Guertel" ||
     QueryProp(P_ARMOUR_TYPE)=="Panzer" )
      SetProp (P_GENDER, MALE);
  if(QueryProp(P_ARMOUR_TYPE)=="Amulett"||
     QueryProp(P_ARMOUR_TYPE)=="Handschuh"||
     QueryProp(P_ARMOUR_TYPE)=="Armschienen" ||
     QueryProp(P_ARMOUR_TYPE)=="Schild" ||
     QueryProp(P_ARMOUR_TYPE)=="Schuhe" ||
     QueryProp(P_ARMOUR_TYPE)=="Handschuh")
      SetProp (P_GENDER, NEUTER);
  if(QueryProp(P_ARMOUR_TYPE)=="Hosen" ||
     QueryProp(P_ARMOUR_TYPE)=="Helm" )
      SetProp (P_GENDER, FEMALE);
  SetProp (P_VALUE, random(QueryProp(P_AC)*320)+300);
  SetProp (P_WEIGHT, QueryProp(P_AC)*210);
}

long ()
   {return(break_string(
            QueryProp(P_SHORT)+
            ", bestehend aus Kupferketten, sehr geeignet Angriffe abzublocken, "
            "sehr anschmirgsamm, mit Leder verbunden und selbst geschmiedet das ist doch "
            "ganz was besonderes!")
         );
   }

