inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Mithrilplattenpanzer");
  SetProp (P_LONG,
    "Dieser herrliche Plattenpanzer wurde vollstaendig aus Mithril gefertigt. "
    "Die Platten sind poliert und glitzern silbrig. An einigen "
    "wichtigen Stellen sind die Platten zusaetzlich verstaerkt, um "
    "die Schutzwirkung noch zu vergroessern. Alle Platten sind fein ziseliert "
    "und mit Runen und Symbolen geschmueckt.");
  SetProp (P_NAME, "Mithrilplattenpanzer");
  SetProp (P_GENDER, MALE);
  AddId (({"panzer","mithrilpanzer", "plattenpanzer", "mithrilplattenpanzer"}));

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 40);
  SetProp (P_MATERIAL, MAT_MITHRIL);
  SetProp (P_WEIGHT, 8500);
  SetProp (P_VALUE, 18500);
  SetProp (P_QUALITY_DECAY, 250);
  SetProp (P_WEAR_RESTRICTIONS, ([A_STR:15]) );

  AddDetail( ({"mithril"}),
    "Das Mithril glaenzt und strahlt wie frischpoliertes Silber.");
  AddDetail( ({"runen", "rune", "symbole", "symbol"}),
    "Es handelt sich um Runen des Schutzes und um Symbole der zwergischen "
    "Schmiede, wie zB Hammer und Amboss oder zwei gekreuzte Aexte.");
  
}
