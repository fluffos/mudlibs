inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Kettenpanzer aus Titan");
  SetProp(P_LONG,
    "Ein Kettenpanzer aus Titan, wie in nur Ritter tragen. Die schweren Ketten "
    "schuetzen den Koeper zwar vorzueglich, aber schraenken doch den Traeger "
    "stark in seiner Bewegungsfreiheit ein. Dieser Panzer ist von sehr alter "
    "Machart, aber trotzdem noch sehr gut erhalten. An einigen Stellen sind "
    "leichte Titanplatten in das Kettengewebe eingearbeitet, um besonders "
    "verletzliche Stellen noch besser zu schuetzen.") ;
  SetProp (P_NAME, "Kettenpanzer");
  SetProp (P_NAME_ADJ, "titanen");
  SetProp (P_GENDER, MALE);
  AddId (({"panzer","titanpanzer","kettenpanzer"}));
  
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 31);
  SetProp (P_MATERIAL, MAT_TITANIUM);
  SetProp (P_WEIGHT, 1700);
  SetProp (P_VALUE, 2800);

  AddDetail ("titan", 
    "Das Titan des Panzers scheint nahezu undurchdringbar zu sein, ohne "
    "jedoch uebermaessig viel zu wiegen.");
}

