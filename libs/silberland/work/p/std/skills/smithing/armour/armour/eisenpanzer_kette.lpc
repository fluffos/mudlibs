inherit "/p/armour/armour_inh";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein Kettenpanter aus Eisen");
  SetProp(P_LONG,
    "Ein eisener Kettenpanzer, wie in nur Ritter tragen. Die schweren Ketten "
    "schuetzen den Koeper zwar vorzueglich, aber schraenken doch den Traeger "
    "stark in seiner Bewegungsfreiheit ein. Dieser Panzer ist von sehr alter "
    "Machart, aber trotzdem noch sehr gut erhalten. An einigen Stellen sind "
    "schwere Eisenstreben in das Kettengewebe eingearbeitet, um besonders "
    "verletzliche Stellen noch besser zu schuetzen.") ;
  SetProp (P_NAME, "Kettenpanzer");
  SetProp (P_NAME_ADJ, "eisen");
  SetProp (P_GENDER, MALE);
  AddId (({"panzer","eisenpanzer","kettenpanzer"}));
  
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 28);
  SetProp (P_MATERIAL, ([MAT_IRON:100]) );
  SetProp (P_WEIGHT, 3600);
  SetProp (P_VALUE, 1700);

  AddDetail("eisen", 
    "Schweres Eisen bildet die Grundlage fuer den Schutz, den dieser "
    "Eisenpanzer seinem Traeger bietet.");
}
