inherit "/std/thing";

#include "properties.h"

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Lederriemen");
  SetProp(P_LONG, 
    "Ein Lederriemen wie er von Schmieden verwendet wird.");
  SetProp(P_VALUE, 5);
  SetProp(P_WEIGHT, 10);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME,"Eisenbrocken");
  SetProp(P_MATERIAL, MAT_LEATHER);
  AddId( ({"riemen","lederriemen"}));

}
