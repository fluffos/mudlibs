string m_func()
{
  if(SKILLMASTER->QuerySkill(TP, SK_SEWING) > 9250 )
    return "Du bist nun bereit aus magischen Fellen magische Objekte "+
      "herzustellen. Vernaehe einfach die Magischen Felle miteinander "+
      "und mit etwas Glueck entsteht ein magischer Gegenstand!";
  else
    return "Du bist noch nicht bereit aus magischen Fellen magische Objekte "+
      "herzustellen.\n";
}

string ring_func(){
  object ob;
  if(!ob=deep_present("\nwzhaar",TP)) {
    tell_object(TP,
        "Bardo bemerkt, dass Du kein Wasserzyklopenhaar bei Dir hast.\n");
    return "Ja los, besorg mir antikes Wasserzyklopenhaar!\n";
  }
  else
    return "Wenn Du ein antikes Wasserzyklopenhaar hast, gib es mir einfach!";
