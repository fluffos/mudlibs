  */
}

string k_func(){
 object ob;
  
  if(ob=deep_present("\nnaehkaestchen",TP)){
  ob->remove(0);
    clone_object("/p/std/skills/sewing_tanning/naehkaestchen.lpc")->move(
      TP,M_NOCHECK);
  tell_object(TP,"Bardo nimmt sich Dein altes Naehkaestchen und gibt Dir ein Neues.\n");
    return "Du hast zwar schon eins, aber gut - hier hast Du ein neues Naehkaestchen. Nimm Dir Fadel und Naden, das wird jetzt flix gefickt!";
  }
  clone_object("/p/std/skills/sewing_tanning/naehkaestchen.lpc")->move(
      TP,M_NOCHECK);
  tell_object(TP,"Bardo nimmt ein Naehkaestchen und gibt es Dir.\n");
  return "Hier nimm dieses Naehkaestchen.";
}

void nix_da(string pln)
{
  object pl;
  if(!pl=find_player(pln)) return;
  if(!present(pl))
    pl->Message("Bardo teilt Dir mit: Komm vorbei, wenn Du etwas willst!\n",
        MSGFLAG_TELL); 
  else
  tell_room(environment(),"Bardo sagt: "+
      capitalize(pln)+" du Hirt, bist ja eh da, was soll das teile mit?\n");
  return;
}

void catch_tell(string str)
{
  object pl;
  if( !pl=find_player(lower_case(explode(str," ")[0])) ) return;
  if ((strstr(str, "teilt Dir mit: ") != -1)) {
    call_out("nix_da",3,getuid(pl));
  }
 return;
}


string long()
{
  string rasse;
  switch (rasse = TP ? TP->QueryProp(P_RACE) : "Mensch")
  {
    case "Hobbit": case "Oger": case "Troll":
      break;
    case "Fee":
      rasse = "Feen";
      break;
    // case "Elf": case "Dunkelelf": case "Mensch": case "Zwerg":
    default:
      rasse += "en";
  }

  return
    BS(sprintf(
        "Vor Dir steht Bardo, der Naeher. Er ist ein schlanker, gut gebauter "
        "Elf, welcher die Naeherei zu seinem Leben gemacht hat. Er bemerkt "
        "Dich kaum, da er so vertieft in seine Naeherei ist. Auch wenn er "
        "unscheinbar wirkt, bist Du Dir sicher, dass er aus Dir ein schoenes "
        "Paar %slederhandschuhe fabrizieren wird, solltest Du ihn angreifen!",
        rasse)) +
    "Er ist in einer - wie sollte es anders sein - meisterlichen Verfassung.\n";
}


void give_notify(object ob)
{
  object ring1,ring2;
  string msg;
  string fn;

  if (ob->id("rose")) {
    write("Bardo sagt: Danke fuer "+ob->name(WEN,1)+"!\n"+
        "Bardo fragt: Willst Du das Silberlied hoeren?\n");
    return;
  }

  if (ob->id("\nwzhaar"))
  {
    environment()->Message(
        "Bardo sagt: Danke fuer "+ob->name(WEN,1)+", "+TP->name(WER)+"!\n"+
        "Bardo fragt: Zur Belohnung gebe ich Dir zwei magische Ringe.\n",
        MSGFLAG_SOUND );

    ring1 = clone_object("/p/std/skills/sewing_tanning/items/naeh_ring");
    ring2 = clone_object("/p/std/skills/sewing_tanning/items/gerb_ring");

    if (TP->MayAddWeight(
          ring1->QueryProp(P_WEIGHT)+ring2->QueryProp(P_WEIGHT)))
    {
      write( break_string(
            msg = "Eigentlich kannst Du die Ringe gar nicht mehr tragen, ich "
            "stecke sie Dir aber einfach trotzdem in die Tasche. Solltest "
            "mal ein wenig von Deinem unnuetzen Krempel wegwerfen!",
            78, "Bardo sagt zu Dir: " ) );
      environment()->Message( break_string(msg, 78,
            "Bardo sagt zu "+TP->name(WEM,1)+": "),
          MSGFLAG_SOUND | MSGFLAG_NO_TP );
    }
    write("Bardo gibt Dir zwei Ringe.\n");
    environment()->Message( "Bardo gibt "+TP->name(WEM)+" zwei Ringe.\n",
        MSGFLAG_VISUAL | MSGFLAG_NO_TP );
    ring1->move(TP,M_NOCHECK);
    ring2->move(TP,M_NOCHECK);

    write_file("/p/std/skills/sewing_tanning/log/ring.log",
        ctime() + ": Ring geholt - "+ getuid(TP) + "\n");

    ob->remove(0);
    return;
  }

  fn = explode(file_name(ob), "#")[0];
  if (fn == "/p/std/skills/sewing_tanning/items/meister_items" ||
      fn == "/p/std/skills/sewing_tanning/items/gilden_items" ||
      fn == "/p/std/skills/sewing_tanning/items/defend_gloves")
  {
    msg = sprintf("Bardo zerlegt %s in Einzelteile und gibt %%s davon eine "
        "Magieseide zurueck.",
        ob->name(WEN,1));
    printf(break_string(msg), "Dir");
    environment()->Message(break_string(sprintf(msg, TP->name(WEM))), 
          MSGFLAG_VISUAL | MSGFLAG_NO_TP);

    ring1 = clone_object("/p/std/skills/sewing_tanning/obj/magieseide");
    ring1->move(TP,M_NOCHECK);
    ob->remove();
    return;
  }
}


int rep_auswahl(object ob)
{
  if( ob->QueryProp(P_WEAPON_TYPE) )
  {
    write("Bardo sagt: Ich repariere keine Waffen!\n");
    return 0;
  }
  if( ob->QueryMaterialGroup(MATGROUP_CLOTH) > 20 ||
      ob->QueryMaterial(MAT_LEATHER) > 20 ||
      ob->QueryMaterial(MAT_PELT) > 20)
  {
    return 1;
  }
  else
  {
    write("Bardo sagt: Sachen aus solch einem Material kann ich nicht "
        "zusammenenflicken!\n");
    return 0;
  }
}
