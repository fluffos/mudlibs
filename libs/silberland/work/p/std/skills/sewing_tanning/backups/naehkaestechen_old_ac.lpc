void set_furs(){
  int x;
  used_furs=({""});
  for (x=1;x<=sizeof(armor_types)-1;x++)
  {
    if(member_array(armor_types[x][5], used_furs)==-1){
      used_furs+=({armor_types[x][5]});
    }
  }
  return;
}

void show_furs(){
  int x;
  for (x=1;x<=sizeof(used_furs)-1;x++){
    write(used_furs[x]+"\n");
  }
  return;
}

string show_level(){
  if (s_skill <= 2450) return level_names[1];
  if (s_skill <= 3450) return level_names[2];
  if (s_skill <= 5450) return level_names[3];
  if (s_skill <= 6700) return level_names[4];
  if (s_skill <= 7950) return level_names[5];
  if (s_skill <= 9100) return level_names[6];
  if (s_skill <= 9450) return level_names[7];
  if (s_skill <= 9650) return level_names[8];
  if (s_skill <= 9950) return level_names[9];
  if (s_skill <= 10000) return level_names[10];
  return "Error";
}
  
string show_gerb(){
  if (s_skill <= 1000) return gerb_names[1];
  if (s_skill <= 2000) return gerb_names[2];
  if (s_skill <= 3000) return gerb_names[3];
  if (s_skill <= 4000) return gerb_names[4];
  if (s_skill <= 5000) return gerb_names[5];
  if (s_skill <= 6000) return gerb_names[6];
  if (s_skill <= 7000) return gerb_names[7];
  if (s_skill <= 8000) return gerb_names[8];
  if (s_skill <= 9000) return gerb_names[9];
  if (s_skill <= 1000) return gerb_names[10];
  return "Error";
}


void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  SetProp(P_NAME,"Naehkaestchen");
  SetProp(P_SHORT,"Ein Naehkaestchen");
  SetProp(P_LONG,"Du siehst ein Naehkaestchen. Es ermoeglicht Dir verschiedene "+
                 "Dinge herzustellen. "+
                 "Mit <naehmuster> oder kurz <nm> kannst Du Dir ansehen, was Du herstellen "+
                 "kannst. "+
                 "Um Felle zu vernaehen, musst Du sie zuerst gerben, was mit <gerbe> oder "+
                 "<ng> gemacht werden kann. Zu guter Letzt kannst du mit <naehe> oder <naeh> "+
                 "den Naehvorgang einleiten."
                 );
  AddId( ({"\nnaehkaestchen","kaestchen","naehkaestchen"}) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NODROP, "Das gibst Du nicht her.\n");
  SetProp(P_NEVERDROP, "Das gibst Du nicht her.\n");

  AddCmd(({"naehe","naeh"}), "func_naeh");
  AddCmd(({"naehmuster","nm"}), "func_muster");
  AddCmd(({"gerbe","ng"}), "func_gerbe");
  
  set_furs();
  NKNAME=capitalize(getuid(this_player()));    
  call_other(SKILLMASTER, "???");
  s_skill=SKILLMASTER->QuerySkill(this_player(),SK_SEWING);
  g_skill=SKILLMASTER->QuerySkill(this_player(),SK_TANNING);

}

void check_sk_values() {
    s_skill=SKILLMASTER->QuerySkill(this_player(),SK_SEWING);
    g_skill=SKILLMASTER->QuerySkill(this_player(),SK_TANNING);
      return;
}

varargs string long() {
  if(SKILLMASTER->QuerySkill(this_player(),SK_SEWING) == -1)
    obtain_sewing_skill(this_player());
  if(SKILLMASTER->QuerySkill(this_player(),SK_TANNING) == -1)
    obtain_tanning_skill(this_player());
  s_skill=SKILLMASTER->QuerySkill(this_player(),SK_SEWING);
  g_skill=SKILLMASTER->QuerySkill(this_player(),SK_TANNING);
  NKNAME=capitalize(getuid(this_player()));    
  return BS( "Du siehst ein Naehkaestchen. Es ermoeglicht Dir verschiedene "
             "Dinge herzustellen. Mit <naehmuster> oder kurz <nm> kannst "
             "Du Dir ansehen, was Du herstellen kannst. "
             "Um Felle zu vernaehen, musst Du sie zuerst gerben, was "
             "mit <gerbe> oder <ng> gemacht werden kann. Zu guter Letzt "
             "kannst du mit <naehe> oder <naeh> den Naehvorgang einleiten. "
             );

}

int obtain_tanning_skill(object pl) {
   int start_skill, maxskill, maxunlearn;
   int x;
   switch(pl->QueryProp(P_RACE)) {
     case "Zwerg": start_skill=2800; maxskill=10000; maxunlearn=9000; break;
     case "Elf": start_skill=2900; maxskill=10000; maxunlearn=9000; break;
     case "Dunkelelf": start_skill=2000; maxskill=10000; maxunlearn=9000; break;
     case "Fee": start_skill=2900; maxskill=10000; maxunlearn=9000; break;
     case "Oger": start_skill=200; maxskill=8000; maxunlearn=3000; break;
     case "Troll": start_skill=200; maxskill=8000; maxunlearn=3000; break;
     default: start_skill=2000; maxskill=9999; maxunlearn=9000;
   }
   call_other(SKILLMASTER, "???");
   SKILLMASTER->AddSkill(pl, SK_TANNING, start_skill, maxskill,
       maxunlearn, SK_TANNING_NAME);
   g_skill=SKILLMASTER->QuerySkill(this_player(),SK_TANNING);
   return 1;
}

int obtain_sewing_skill(object pl) {
   int start_skill, maxskill, maxunlearn;
   int x;
   switch(pl->QueryProp(P_RACE)) {
     case "Zwerg": start_skill=2300; maxskill=10000; maxunlearn=9000; break;
     case "Elf": start_skill=2300; maxskill=10000; maxunlearn=9000; break;
     case "Dunkelelf": start_skill=2300; maxskill=10000; maxunlearn=9000; break;
     case "Fee": start_skill=2300; maxskill=10000; maxunlearn=9000; break;
     case "Oger": start_skill=200; maxskill=7950; maxunlearn=3000; break;
     case "Troll": start_skill=200; maxskill=7950; maxunlearn=3000; break;
     default: start_skill=2200; maxskill=9999; maxunlearn=9000;
   }
   call_other(SKILLMASTER, "???");
   SKILLMASTER->AddSkill(pl, SK_SEWING, start_skill, maxskill,
       maxunlearn, SK_SEWING_NAME);
   s_skill=SKILLMASTER->QuerySkill(this_player(),SK_SEWING);
   
   return 1;
}



//-----GAERBEN BEGIN-----

func_gerbe(string arg){
  object fell;
  int suc;

  check_sk_values();
  
  notify_fail("Was willst Du gerben?\n");
  NKNAME=capitalize(getuid(this_player()));    

  if(!arg) return 0;

  if(!fell=present(arg, this_player())) {
    notify_fail("Das hast Du nicht bei Dir.\n");
    return 0;
  }
  
  if(arg=="fell") {
    write("Welches Fell meinst Du genau? (z.b. biberfell,...)\n");
    return 1;
  }
  
  if(member_array(explode(arg," ")[0],used_furs)==-1){
    notify_fail("Das kann man nicht gerben.\n");
    return 0;
  }
 
  if(member_array("\ng_fell",(fell->QueryProp(P_IDS)))!=-1) {
   write(fell->QueryProp(P_SHORT)+" ist schon gegerbt!\n");
   return 1;
  }
 
  if (IS_SEWING) {
    write("Du kannst nicht gerben waehrend du naehst!\n");
    return 1;
  }

  if(fell->QueryProp(P_WORN)) {
    write("Getragene Felle koennen nicht gegerbt werden!\n");
    return 1;
  }
  
  call_other(SKILLMASTER, "???");

  if(interactive(TP) && (SKILLMASTER->QuerySkill(TP, SK_TANNING)==-1))
     obtain_tanning_skill(TP);

  suc=SKILLMASTER->UseSkill(TP, SK_TANNING); 
  g_skill=SKILLMASTER->QuerySkill(this_player(),SK_TANNING);
  if(suc>0) {
    write(fell->QueryProp(P_SHORT)+" wird von Dir gegerbt.\n");
    tell_room(environment(this_player()),NKNAME+" gerbt: "+fell->QueryProp(P_SHORT)+".\n",
                ({this_player()}));
    fell->AddId("\ng_fell");
    fell->SetProp(P_SHORT,(fell->QueryProp(P_SHORT)+" (gegerbt)"));
    if(random(g_skill)>7800){
     fell->SetProp(P_SHORT,(fell->QueryProp(P_SHORT)+" (hochqualitativ)"));
     //fell->RemoveId("\ng_fell");
     fell->AddId("\ng_fell_hq");
    }
  }
  else
  {
    write(fell->QueryProp(P_SHORT)+" wird von Dir zerstoert als Du versuchst es zu gerben.\n");
    fell->remove(0);
  }
  return 1;
}

string player_tries_to_move(object pl,string dir,mapping dest)
{
  PL_MOVED=1;
  return(break_string("Du solltest Dich nicht bewegen waehrend Du naehst.",78));
}

//-----GAERBEN END-----


//-----NAEHEN BEGIN-----

varargs int sew_now(int i, mixed presuf) {
  switch(DELAY_COUNT) {
    case 0:
      tell_object(this_player(),
          "Du naehst [------]\n");
          //"Du suchst Dir das passende Naehmuster.\n");
      break;
    case 1:
      tell_object(this_player(),
          "Du naehst [**----]\n");
          //"Du suchst Dir das passende Naehmuster.\n");
      break;
    case 2:
      tell_object(this_player(),
          "Du naehst [****--]\n");
          //"Du konzentrierst Dich.\n");
      if( this_player())
        this_player()->SetProp(P_TMP_MOVE_HOOK, 0);
      break;
  }

  if(DELAY_COUNT>2){
    if(!PL_MOVED){
      tell_object(this_player(),
          "Du naehst [******]\n");
     call_out("build_armor",1,i, presuf);
     DELAY_COUNT=0;
     PL_MOVED=0;
     IS_SEWING=0;
     return 1;
    }
    else{
     DELAY_COUNT=0;
     write("Du vernichtest alles und brichst den Naehvorgang ab.\n");
     PL_MOVED=0;
     IS_SEWING=0;
     return 1;
    }
  }
      
  DELAY_COUNT++;
  call_out("sew_now",armor_types[i][0]+random(2),i, presuf);
  return 1;
}

func_naeh(mixed in){
  int amount;
  string fell;
  object *fell_present;
  object *silk_present;
  object *dest_now;
  mixed presuf;
  int r,s,i;
 
  r=0;
  s=0;
  amount=0;

  fell_present=({});
  dest_now=({});
  
  NKNAME=capitalize(getuid(this_player()));    
  notify_fail(break_string("Was willst du Naehen? Nr. 1,2,.."+
      " (siehe Kommando <naehmuster>)"));
 
  if(!in) return 0;
  
  i=to_int(in);



  call_other(SKILLMASTER, "???");

  if(interactive(TP) && (SKILLMASTER->QuerySkill(TP, SK_SEWING)==-1))
     obtain_sewing_skill(TP);
  
  if(i<1 || i>(sizeof(armor_types)-1)) return 0;

//  ({1,5, "lkappe", "Eine lederne Kappe", 1, "biberfell", 1, "raupenseide"}),

  if(armor_types[i][1]>s_skill) return 0;
  
  write("Du versuchst folgendes herzustellen: "+armor_types[i][3]+".\n");
 // write(armor_types[to_int(i)][4]);
  amount=sizeof(fell_present=filter_objects(all_inventory(this_player()),
                "id",armor_types[i][5]));
  if(amount<armor_types[i][4]){
    write("Fehlende Komponenten: "+capitalize(armor_types[i][5])+
          " ("+(armor_types[i][4]-amount)+" Stk.)");
    r=1;
  } 
   
  amount=sizeof(silk_present=filter_objects(all_inventory(this_player()),
                "id",armor_types[i][7]));
  if(amount<armor_types[i][6]){
    if(r==1) write(" und "); else write ("Fehlende Komponenten: ");
    write(capitalize(armor_types[i][7])+
          " ("+(armor_types[i][6]-amount)+" Stk.)");
    r=1;
  }
  if(r==1){
    write(".\n");
   return 1;
  }
 
 if(armor_types[i][1]<9000){ 
  for(r=0;r<armor_types[i][4];r++){
    if(member_array("\ng_fell",(fell_present[r]->QueryProp(P_IDS)))!=-1){
    s++;
    dest_now+=({fell_present[r]});    
    }
  }
  if(s<armor_types[i][4]){
    write("Du hast nur "+s+" Stk. gegerbte "+
        capitalize(armor_types[i][5])+
        "e brauchst jedoch "+
        armor_types[i][4]+" Stk.\n");
    return 1;
  }
 }
  else{
    for(r=0;r<armor_types[i][4];r++){
      if((sizeof(fell_present)-1) >= r) {
        if(member_array("\ng_fell_hq",(fell_present[r]->QueryProp(P_IDS)))!=-1)
        {
         s++;
         dest_now+=({fell_present[r]});    
        }
      }
       
    } 
    if(s<armor_types[i][4]){
      write("Du hast nur "+s+" Stk. hochqualitativ gegerbte "+
          capitalize(armor_types[i][5])+
          "e brauchst jedoch "+armor_types[i][4]+" Stk.\n");
      return 1;
    }
  }
  for(r=0;r<=armor_types[i][6]-1;r++) {
     if((sizeof(silk_present)-1) >= r) 
       dest_now+=({silk_present[r]});
  }

  write("Du nimmst folgende Dinge zur Hand:\n");
  for(r=0;r<=sizeof(dest_now)-1;r++) {
    write(" -"+dest_now[r]->QueryProp(P_SHORT)+"\n");
    if(pointerp(dest_now[r]->QueryProp(P_ITEMD_PRE_SUFFIX))) {
        presuf=dest_now[r]->QueryProp(P_ITEMD_PRE_SUFFIX);
    }
    dest_now[r]->remove(0);
  }

  if(!this_player()->QueryProp(P_TMP_MOVE_HOOK)){
     this_player()->SetProp(P_TMP_MOVE_HOOK, ({ time()+200, this_object(), "player_tries_to_move" }) );
  }
  else
  {
    write("Aus irgendeinem Grund kannst Du  nicht naehen.\n "
        "Du wirst schon wissen, warum!\n");
    return 1;
    
  }
  
  write ("Du beginnst...\n");
  tell_room(environment(this_player()),NKNAME+" packt sein Naehkaestchen aus und naeht.\n",
      ({this_player()})); 
  DELAY_COUNT=0;
  IS_SEWING=1;
  call_out("sew_now",1,i, presuf); 

  return 1;
}


int build_armor(int i, mixed presuf){
   object cob;
   string *parts;
   int suc;

  call_other(SKILLMASTER, "???");

  //leichter etwas naehen, schwerer den skill hochzubringen
  suc=SKILLMASTER->UseSkill(TP, SK_SEWING, -2000, 2000);
  s_skill=SKILLMASTER->QuerySkill(this_player(),SK_SEWING);
   if(suc>0) {
      write ("Du erzeugst: "+armor_types[i][3]+".\n");
    tell_room(environment(this_player()),BS(NKNAME+" erzeugt: "
          +armor_types[i][3]+"."), ({this_player()}));

      if(armor_types[i][2]=="I"){
        if(armor_types[i][10][0]!="/")
          cob=clone_object(ARMOR(armor_types[i][10]));
        else
          cob=clone_object(armor_types[i][10]);
        cob->move(this_player(),M_NOCHECK);
      }
      else {
      cob=clone_object(ARMOR(armor_types[i][10]));
      cob->move(this_player(),M_NOCHECK);
      cob->SetProp(P_ARMOUR_TYPE,armor_types[i][8]);
      parts=explode(armor_types[i][3]," ");
      cob->AddId(lower_case(parts[sizeof(parts)-1]));
      cob->SetProp(P_SHORT,armor_types[i][3]);
      if(s_skill<9500) {
        cob->SetProp(P_SHORT,armor_types[i][3]);
      cob->SetProp(P_AC,armor_types[i][9]);
      }
      else if(random(10)){
        cob->SetProp(P_SHORT,armor_types[i][3]+
            " (erzeugt von "+
            capitalize(getuid(this_player()))+
            ")"
            );
      }
      else {
        cob->SetProp(P_SHORT,armor_types[i][3]+
            " (erzeugt von "+
            capitalize(getuid(this_player()))+
            ") (hochqualitativ)"
            );
        cob->SetProp(P_AC,armor_types[i][9]+1);
      }
      cob->SetProp(P_NAME,armor_types[i][2]);
      cob->AddId(explode(lower_case(armor_types[i][2])," "));
      cob->AddId(lower_case(armor_types[i][8]));
      cob->_init_armor();
      }
      if(suc > 9250 && pointerp(presuf) && sizeof(presuf)==2 &&
          (presuf[0]!="" && presuf[1]!="") && !random(2)) 
      {
        tell_object(TP, BS("Durch Deine aussergewoehnlichen Naehfertigkeiten "
              "hast Du magische Eigenschaften in Dein Werk weben koennen!"));
        DoMagic(cob, presuf[0], presuf[1]);
         
      }
    return 1;
   }
  write("Du warst zu ungeschickt! Leider hast Du alles vernichtet.\n");
  return 1;
}

int func_muster(string i){
  int x;
  int y;

  check_sk_values();
  
  y=0;
  notify_fail("Welche Seite der Muster haettes Du gerne? naehmuster <1..10>\n");

  if(to_int(i) < 1 || to_int(i) > 10) return 0;
  
  
  write("----------------------------------------------------------------\n");
  write("In Ausbildungsstufe "+i+" ("+level_names[to_int(i)]+") kannst Du \n");
  write("mit Deinem momentanen Koennen folgendes herstellen:\n");
  write("----------------------------------------------------------------\n");
  for (x=1;x<=sizeof(armor_types)-1;x++)
  {
    if(to_int(i)==to_int(armor_types[x][0])&&(s_skill>=armor_types[x][1])){

    y++;
// write(sprintf("%2d. %s - Erfahrung: %1d\n    Kosten: %1d Stk. %s und %1d Stk. %s\n",
 write(sprintf("%2d. %s \n    Kosten: %1d Stk. %s und %1d Stk. %s\n",
      x,armor_types[x][3],armor_types[x][4],
      capitalize(armor_types[x][5]),
     armor_types[x][6],
      capitalize(armor_types[x][7])));
    }
  }
  if(!y) write ("Noch gar nichts.\n");
  write("----------------------------------------------------------------\n");
  return 1;
}

nosave int DoMagic(object ob, string pre, string suf) {
  call_other(ITEMD, "SetMagicItem",ob, pre, suf);
  return 1;
}
