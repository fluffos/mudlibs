inherit "/std/thing";

#include "properties.h"

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Etwas Raupenseide");
  SetProp(P_LONG, 
   "Die Raupenseide ist weiss, reissfest, doch etwas klebrig.");
  SetProp(P_VALUE, 5);
  SetProp(P_WEIGHT, 10);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME,"Raupenseide");
  SetProp(P_MATERIAL, MAT_SILK);
  AddId( ({"seide","raupenseide", "\nraupenseide"}));

}
