inherit "/std/thing";

#include "properties.h"

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Etwas Magieseide");
  SetProp(P_LONG, 
   "Die Magieseide ist weiss, reissfest, doch etwas klebrig und hoch magisch.");
  SetProp(P_VALUE, 5);
  SetProp(P_WEIGHT, 10);
  SetProp(P_MAGIC,100);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME,"Magieseide");
  SetProp(P_MATERIAL, ([MAT_SILK:40, MAT_MAGIC:60])); 
  AddId( ({"seide","magieseide", "\nmagieseide"}));

}
