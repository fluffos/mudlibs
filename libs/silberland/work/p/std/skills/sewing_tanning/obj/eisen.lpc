inherit "/std/thing";

#include "properties.h"

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Eisenbrocken");
  SetProp(P_LONG, 
    "Ein Stueckchen Eisen welches auch bei Naeharbeiten verwendet wird.");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Eisenbrocken");
  SetProp(P_VALUE, 5);
  SetProp(P_WEIGHT, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, MAT_IRON);
  AddId( ({"stueck","eisenbrocken","brocken", "\neisenbrockeeisenbrocken"}));
}
