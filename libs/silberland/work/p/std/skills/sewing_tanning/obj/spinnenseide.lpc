inherit "/std/thing";

#include "properties.h"

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Etwas Spinnenseide");
  SetProp(P_LONG, 
   "Die Spinnenseide ist weiss, reissfest, doch etwas klebrig.");
  SetProp(P_VALUE, 5);
  SetProp(P_WEIGHT, 10);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME,"Spinnenseide");
  SetProp(P_MATERIAL, MAT_SILK);
  AddId( ({"seide","spinnenseide", "\nspinnenseide"}));

}
