inherit "/std/thing";

#include "properties.h"

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Einige Stoffreste");
  SetProp(P_LONG, 
   "Die Stoffreste sind bunt und stinken etwas.");
  SetProp(P_VALUE, 5);
  SetProp(P_WEIGHT, 10);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME,"Stoffreste");
  SetProp(P_MATERIAL, MAT_CLOTH);
  AddId( ({"stoffreste","reste", "\nstoffreste"}));

}
