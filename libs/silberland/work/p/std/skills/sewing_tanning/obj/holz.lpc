inherit "/std/thing";

#include "properties.h"

void create()
{
  if( !is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Stueckchen Holz");
  SetProp(P_LONG, 
    "Ein Stueckchen Holz welches bei Naeharbeiten verwendet wird.");
  SetProp(P_VALUE, 5);
  SetProp(P_WEIGHT, 10);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME,"Holzstueck");
  SetProp(P_MATERIAL, MAT_MISC_WOOD);
  AddId( ({"stueckchen", "stueck","holzstueck","holz", "\nholzstueck"}));

}
