inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  string matname,mat;
  int value;
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"leder"}));

  SetProp (P_MATERIAL, ([MAT_LEATHER:95, MAT_SILK:5]) );

  AddDetail( ({"leder"}),
    "Das Leder wurde mit sauber vernaeht.");
  AddDetail( ({"holz","elemente","element","holzelemente","holzelement"}),
    "Deswegen ist diese art von Ruestung sehr stabil.");
  SetProp(P_SMELL,
    "Am Leder kann man noch Geruchsspuren der Gerbfluessigkeiten "
    "feststellen.\n");
}

void _init_armor(){

  if(QueryProp(P_ARMOUR_TYPE)==AT_CLOAK ||
      QueryProp(P_ARMOUR_TYPE)==AT_BELT ||
      QueryProp(P_ARMOUR_TYPE)==AT_ARMOUR )
    SetProp (P_GENDER, MALE);
  else if(QueryProp(P_ARMOUR_TYPE)==AT_AMULET)
    SetProp (P_GENDER, NEUTER);
  else if(QueryProp(P_ARMOUR_TYPE)==AT_TROUSERS ||
      QueryProp(P_ARMOUR_TYPE)==AT_HELMET )
    SetProp (P_GENDER, FEMALE);
  else if( QueryProp(P_ARMOUR_TYPE)==AT_GLOVE||
      QueryProp(P_ARMOUR_TYPE)==AT_BRACERS ||
      QueryProp(P_ARMOUR_TYPE)==AT_BOOT )
    SetProp(P_PLURAL, 1);
  SetProp (P_VALUE, random(QueryProp(P_AC)*160)+200);
  SetProp (P_WEIGHT, QueryProp(P_AC)*130);
  SetProp(P_LONG, break_string(
        QueryProp(P_SHORT)+
        ", bestehend aus gegerbten Leder, verstaerkt mit Holzelementen, "
        "schuetzend vor Angriffen, waermend bei kaltem Wetter und selbst "
        "genaeht, das ist doch ganz was besonderes!")
      );
}

