inherit "std/thing";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Bandagen");
  SetProp(P_LONG, 
    "Mit diesen Bandagen kann man eine Leiche einwicklen, um sie fuer die "
    "Mumifizierung vorzubereiten.");
  SetProp(P_NAME, "Bandangen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"bandagen", "\nnekromanten_bandangen"}) );

  SetProp(P_MATERIAL, ([MAT_CLOTH:100]));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1000);
}

