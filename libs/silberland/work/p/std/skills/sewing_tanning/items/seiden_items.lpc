inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include "/gilden/druidenzirkel/druiden_extern.h"

void create()
{
  string matname,mat;
  int value;
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_MATERIAL, ([MAT_SILK:50, MAT_MAGIC:50]) );

  AddDetail( ({"seide"}),
    "Die Seide wurde meisterhaft verarbeitet.\n");
}

void _init_armor(){

  if(QueryProp(P_ARMOUR_TYPE)==AT_CLOAK ||
      QueryProp(P_ARMOUR_TYPE)==AT_BELT ||
      QueryProp(P_ARMOUR_TYPE)==AT_ARMOUR )
    SetProp (P_GENDER, MALE);
  else if(QueryProp(P_ARMOUR_TYPE)==AT_AMULET)
    SetProp (P_GENDER, NEUTER);
  else if(QueryProp(P_ARMOUR_TYPE)==AT_TROUSERS ||
      QueryProp(P_ARMOUR_TYPE)==AT_HELMET )
    SetProp (P_GENDER, FEMALE);
  else if(QueryProp(P_ARMOUR_TYPE)==AT_GLOVE||
      QueryProp(P_ARMOUR_TYPE)==AT_BRACERS ||
      QueryProp(P_ARMOUR_TYPE)==AT_BOOT )
    SetProp(P_PLURAL, 1);
  SetProp (P_VALUE, random(QueryProp(P_AC)*260)+600);
  SetProp (P_WEIGHT, QueryProp(P_AC)*70);
  SetProp(P_QUALITY_DECAY, 150+random(10)*random(10) );
  SetProp(P_M_HEALTH_MOD,([P_HP:1+random(4),P_SP:1+random(4)]));
  SetProp(P_ITEMD_ELEMENTAL_VALUE,random(3)+1);
  if(QueryProp(P_ARMOUR_TYPE) == AT_GLOVE)
    SetProp(P_DRUID_ADD_HAND_DAMAGE, 3+random(3));
//  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_LONG, break_string(
        QueryProp(P_SHORT)+
        ", bestehend aus magischer Seide, schuetzend vor Angriffen, "
        "waermend bei kaltem Wetter und selbst genaeht, das ist doch "
        "ganz was besonderes! " + capitalize(QueryPronoun(WER)) + 
        (IsPlural() ? "helfenn" : "hilft") + "Druiden beim "+
        (QueryProp(P_ARMOUR_TYPE) == AT_GLOVE ? "Handkampf." : "Zaubern.")
      ));
}

