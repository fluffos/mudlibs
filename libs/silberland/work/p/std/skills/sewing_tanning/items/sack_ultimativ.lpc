#include <properties.h>
inherit "/std/container";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein ultimativer Sack der Leichtigkeit");
  SetProp(P_LONG, break_string("Ein Sack aus feinem Leder. Er ist selbst genaeht und bietet einigen "+
    "Platz fuer alle moeglichen Sachen, die Du so mit Dir rumschleppst."));
  AddId(({"sack", "sack der leichtigkeit"}));
  AddAdjective( ({"ultimativ", "ultimativer", "ultimativen"}));
  SetProp(P_NAME, "Sack");
  SetProp(P_NAME_ADJ, "ultimativ");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 250);
  SetProp(P_MAX_WEIGHT, 13000);
  SetProp(P_VALUE, 500);
  SetProp(P_WEIGHT_PERCENT, 25);
  SetProp(P_INFO, break_string("Dieser Sack macht Sachen leichter als andere Saecke, "+
    "Du Sack.\n"));
  SetProp(P_MATERIAL, MAT_LEATHER);
  AddDetail("leder", break_string("Feines Leder das sich weich und angenehm "+
    "anfuehlt und mit magischer Seide vernaeht ist.\n"));
  if (this_player())
    write_file("/p/std/skills/sewing_tanning/log/meisterschneider.log",
        sprintf("%s: %O erzeugt %s.\n",
          dtime(), this_player(), QueryProp(P_SHORT) ));
}
