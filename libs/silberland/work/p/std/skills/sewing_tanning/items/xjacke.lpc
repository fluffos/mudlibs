inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>


void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Eine rote Pelzjacke mit weissen Fellraendern");
  SetProp(P_LONG, 
    "Eine dicke, warme rote Pelzjacke mit weissen Fellraendern. Beim Anblick "
    "dieser Jacke besteht die Gefahr zu erblinden. Dir Grausts vor Kitsch.");
  SetProp(P_NAME, "Pelzjacke mit weissen Fellraendern");
  SetProp(P_NAME_ADJ, "rot");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"jacke", "pelzjacke"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 15);
  SetProp(P_MATERIAL, ([MAT_PELT:100]));
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 2500);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:7, T_HEAT_PROT:-7 ]) );
}

