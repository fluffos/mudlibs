#include <properties.h>
inherit "/std/container";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine selbstgenaehte Ledertasche");
  SetProp(P_LONG, break_string("Eine Tasche aus feinem Leder. Sie ist selbst genaeht und bietet einigen "+
    "Platz fuer alle moeglichen Sachen, die Du so mit Dir rumschleppst."));
  AddId(({"tasche", "ledertasche"}));
  SetProp(P_NAME, "Ledertasche");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 250);
  SetProp(P_MAX_WEIGHT, 8000);
  SetProp(P_VALUE, 100);
  SetProp(P_WEIGHT_PERCENT, 40);
  SetProp(P_INFO, break_string("Diese Ledertasche ermoeglicht es Dir, mehr Sachen "+
    "mit Dir herum zu tragen.\n"));
  SetProp(P_MATERIAL, MAT_LEATHER);
  AddDetail("leder", break_string("Feines Leder das sich weich und angenehm "+
    "anfuehlt.\n"));

}
