inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Eine rote Fellhose mit weissen Raendchen");
  SetProp(P_LONG,
    "Das knallige rot und die weissen Raendchen sind sicher die "
    "perfekte Tarnfarbe :)");
  SetProp(P_NAME, "Fellhose mit weissen Raendchen");
  SetProp(P_NAME_ADJ, "rot");
  SetProp(P_GENDER, FEMALE);
  AddId(({"fellhose","hose"}));

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_PELT);
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 500);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4,T_HEAT_PROT:-2]) );

  AddDetail( ({"fell"}),
    "Von welchem Tier das Fell stammt, laesst sich nicht feststellen.");
}

