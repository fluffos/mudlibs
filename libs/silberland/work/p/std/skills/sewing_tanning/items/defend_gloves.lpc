inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "/gilden/druidenzirkel/druiden_extern.h"

void create()
{
  string matname,mat;
  int value;
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:2, T_HEAT_PROT:2]) );
  SetProp(P_MATERIAL, ([MAT_SILK:10, MAT_PELT:80, MAT_GOLD:10]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_VALUE, random(1300)+4000);
  SetProp(P_NAME_ADJ, "exquisit");
  SetProp(P_PLURAL, 1);
  AddAdjective( ({"exquisit", "exquisiten", "exquisiter", "exquisitem", "exquisite"}) );

  AddId( ({"handschuhe", "meisterhandschuhe"}) );
  SetProp(P_DEFEND_FUNC, this_object());
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 5+random(5));
  seteuid(getuid(this_object()));
}

void _init_armor(){
  int attr;
  SetProp(P_VALUE, random(QueryProp(P_AC) * 300) + 1200);
  SetProp(P_WEIGHT, QueryProp(P_AC) * 50);
  SetProp(P_QUALITY_DECAY, 280 + random(12) * random(12) );

  SetProp(P_M_HEALTH_MOD,([P_HP: 1+random(6), P_SP: 1+random(6)]));
  //SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_LONG,break_string(
        QueryProp(P_SHORT)+
        ", bestehend aus mit magischer Seide vernaehtem Fell eines Goldmarders, "
        "schuetzend vor Angriffen, waermend bei kaltem Wetter und selbst "
        "genaeht, das ist doch ganz was besonderes! " + capitalize(QueryPronoun(WER)) + 
        " wurde" + (IsPlural() ? "n" : "") + " von einem Meisternaeher "
        "hergestellt und verbessern den Handkampf und lassen Dich Angriffe abwehren."
        )
      );
  write_file("/p/std/skills/sewing_tanning/log/meisterschneider.log",
      sprintf("%s: %O erzeugt %s.\n",
        dtime(), this_player(), QueryProp(P_SHORT) ));
}

void reset()
{
  if (!is_clone(this_object()))
    return;
  ::reset();
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  if (!random(44) && sizeof(dtyp & m_indices(PHYSICAL_DAMAGE_TYPES)))
  {
    tell_object(QueryProp(P_WORN),
        "Deine Kampfhandschuhe wehren den Angriff ab!\n");
    return 5000;
  }
}
