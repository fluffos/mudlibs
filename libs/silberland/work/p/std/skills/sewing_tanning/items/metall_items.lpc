inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  string matname,mat;
  int value;
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_MATERIAL, ([MAT_IRON: 20, MAT_LEATHER:75, MAT_SILK:5]) );

  AddDetail( ({"leder"}),
    "Das Leder wurde mit sauber vernaeht.");
  AddDetail( ({"metall"}),
    "Deswegen ist diese Art von Ruestung extrem stabil.");
  SetProp(P_SMELL,
    "Am Leder kann man noch Geruchsspuren der Gerbfluessigkeiten "
    "feststellen.\n");
  SetProp(P_QUALITY_DECAY, 100+random(50) );
}

void _init_armor(){

  if(QueryProp(P_ARMOUR_TYPE)==AT_CLOAK ||
      QueryProp(P_ARMOUR_TYPE)==AT_BELT ||
      QueryProp(P_ARMOUR_TYPE)==AT_ARMOUR )
    SetProp (P_GENDER, MALE);
  else if(QueryProp(P_ARMOUR_TYPE)==AT_AMULET)
    SetProp (P_GENDER, NEUTER);
  else  if(QueryProp(P_ARMOUR_TYPE)==AT_TROUSERS ||
      QueryProp(P_ARMOUR_TYPE)==AT_HELMET )
    SetProp (P_GENDER, FEMALE);
  else if( QueryProp(P_ARMOUR_TYPE)==AT_GLOVE||
      QueryProp(P_ARMOUR_TYPE)==AT_BRACERS ||
      QueryProp(P_ARMOUR_TYPE)==AT_BOOT )
    SetProp(P_PLURAL, 1);
  SetProp (P_VALUE, random(QueryProp(P_AC)*240)+200);
  SetProp (P_WEIGHT, QueryProp(P_AC)*140);
}

string long ()
{
  return(break_string(
        QueryProp(P_SHORT)+
        ", bestehend aus gegerbten Leder, verstaerkt mit Metall, schuetzend vor Angriffen, "
        "waermend bei kaltem Wetter und selbst genaeht, das ist doch "
        "ganz was besonderes!")
      );
}

