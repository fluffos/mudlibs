inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>

void create()
{
  if( !is_clone(this_object()) ) return;

  ::create();

  SetProp(P_SHORT, "Ein schwarzer Lederguertel mit riesiger Metallschnalle");
  SetProp(P_LONG, 
    "Ein schwarzer Lederguertel mit einer riesen Schnalle zum zumachen.");
  SetProp(P_NAME, "Lederguertel mit riesiger Metallschnalle");
  SetProp(P_NAME_ADJ, "schwarz");
  SetProp(P_GENDER, MALE);
  AddId( ({"lederguertel", "guertel"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 1+random(3));
  SetProp(P_MATERIAL, ([MAT_LEATHER:95, MAT_BRASS:5 ]) );
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 160);                                            
}

