inherit "/std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine magische Peitsche der Zucht");
  SetProp(P_LONG,  
    "Die Peitsche besteht eigentlich nur aus einer langen Lederschnur, die an "
    "einen Griff befestigt ist. Sie ist selbst zusammengenaeht!");
  SetProp(P_NAME, "Peitsche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"peitsche"}) );

  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 181);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, DT_WHIP );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_LEATHER:50, MAT_MAGIC:50]) );
  SetProp(P_WEIGHT,180);
  SetProp(P_VALUE, 800);
  SetProp(P_QUALITY_DECAY, 150);
  SetProp(P_M_HEALTH_MOD, ([P_HP:2+random(3), P_SP:2+random(3)]) );
}

