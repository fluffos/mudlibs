inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar rote Stiefel mit weissem Fellrand");
  SetProp(P_LONG, 
    "Uaaeh, wie kitschig. Du wuerdest Dich mit sowas in Grund und "
    "Boden schaemen." );
  SetProp(P_NAME, "Stiefel mit weissem Fellrand");
  SetProp(P_NAME_ADJ, "rot");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId (({"stiefel"}));
  
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_PELT:100]));
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 800);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4, T_HEAT_PROT:-2]));
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) +
      ([DT_WATER:2, DT_COLD:1]) );
  
}
