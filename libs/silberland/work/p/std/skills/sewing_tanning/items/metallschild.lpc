inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein metallbeschlagener Lederschild");
  SetProp(P_LONG, 
    "Der Schild besteht aus dickem Leder, das auf einen runden Rahmen aus Holz "
    "aufgezogen ist. Das Leder ist mit Eisenstuecken vertaerkt, um die "
    "Schtzwirkung zu verstaerken. Es ist selbst zusammengenaeht!");
  SetProp(P_NAME, "Lederschild");
  SetProp(P_NAME_ADJ, "metallbeschlagen");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild","lederschild"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_SHIELD); 
  SetProp(P_AC, 21); 
  SetProp(P_MATERIAL, ([MAT_LEATHER:60, MAT_FIR:20, MAT_IRON:20]) );
  SetProp(P_WEIGHT,  1200);
  SetProp(P_VALUE, 450);
  SetProp(P_QUALITY_DECAY, 120);
  
  AddDetail( ({"leder"}),
    "Das eisenverstaerkte Leder des Schildes ist sehr dick und kann sicher "
    "viele Schlaege abfangen.");
}

