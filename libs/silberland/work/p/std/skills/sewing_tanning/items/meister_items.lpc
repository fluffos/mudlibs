inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "/gilden/druidenzirkel/druiden_extern.h"

string write_mapping(mapping map);

void create()
{
  string matname,mat;
  int value;
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_MATERIAL, ([MAT_SILK:50, MAT_MAGIC:50]) );
  SetProp (P_VALUE, random(1300)+4000);
  SetProp(P_NAME_ADJ, "ultimativ");
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_MAGIC, 7);
  AddAdjective( ({"ultimativ", "ultimative", "ultimativen", "ultimatives"}) );

  AddDetail( ({"seide"}),
    "Die Seide wurde meisterhaft verarbeitet.\n");

  seteuid(getuid(this_object()));
}

void _init_armor(){
  int attr;
  if(QueryProp(P_ARMOUR_TYPE)==AT_CLOAK ||
      QueryProp(P_ARMOUR_TYPE)==AT_BELT ||
      QueryProp(P_ARMOUR_TYPE)==AT_ARMOUR )
    SetProp (P_GENDER, MALE);
  else if(QueryProp(P_ARMOUR_TYPE)==AT_AMULET)
    SetProp (P_GENDER, NEUTER);
  else if(QueryProp(P_ARMOUR_TYPE)==AT_TROUSERS ||
      QueryProp(P_ARMOUR_TYPE)==AT_HELMET )
    SetProp (P_GENDER, FEMALE);
  else if(QueryProp(P_ARMOUR_TYPE)==AT_GLOVE||
      QueryProp(P_ARMOUR_TYPE)==AT_BRACERS ||
      QueryProp(P_ARMOUR_TYPE)==AT_BOOT )
    SetProp(P_PLURAL, 1);
  SetProp (P_VALUE, random(QueryProp(P_AC)*300)+1200);
  SetProp (P_WEIGHT, QueryProp(P_AC)*50);
  SetProp(P_QUALITY_DECAY, 180+random(12)*random(12) );

  SetProp(P_ITEMD_ELEMENTAL_VALUE,random(3)+2);
  if(QueryProp(P_ARMOUR_TYPE) == AT_GLOVE)
    SetProp(P_DRUID_ADD_HAND_DAMAGE, 5+random(5));
  switch(random(100))
  {
    case 0..39: attr = 1; break;
    case 50..79: attr = 2; break;
    case 80..99: attr = 3; break;
  }
  switch(random(100))
  {
    case  0..39: SetProp(P_M_ATTR_MOD, ([ A_INT: attr]) ); break;
    case 40..79: SetProp(P_M_ATTR_MOD, ([ A_CON: attr]) ); break;
    case 80..89: SetProp(P_M_ATTR_MOD, ([ A_DEX: attr]) ); break;
    case 90..99: SetProp(P_M_ATTR_MOD, ([ A_STR: attr]) ); break;
  }
  SetProp(P_M_HEALTH_MOD,([P_HP: 1+random(6), P_SP: 1+random(6)]));
  //SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_INFO, "Diese Art von Gegenstand macht Druidenzauber billiger.\n");
  SetProp(P_LONG,break_string(
        QueryProp(P_SHORT)+
        ", bestehend aus magischer Seide, schuetzend vor Angriffen, "
        "waermend bei kaltem Wetter und selbst genaeht, das ist doch "
        "ganz was besonderes! " + capitalize(QueryPronoun(WER)) + 
        " wurde" + (IsPlural() ? "n" : "") + " von einem Meisternaeher "
        "hergestellt und " + (IsPlural() ? "helfen" : "hilft") + " Druiden beim "+
        (QueryProp(P_ARMOUR_TYPE) == AT_GLOVE ? "Handkampf." : "Zaubern.")
        )
      );
  write_file("/p/std/skills/sewing_tanning/log/meisterschneider.log",
      sprintf("%s: %O erzeugt %s: ATTR: %s, HEALTH: %s\n",
        dtime(),
        this_player(), 
        QueryProp(P_SHORT), 
        write_mapping(QueryProp(P_M_ATTR_MOD)),
        write_mapping(QueryProp(P_M_HEALTH_MOD))
        ));
}

string write_mapping(mapping map)
{
  int i;
  string ret;

  ret = "";
  for (i = sizeof(map) - 1; i >= 0; i--)
  {
    while (i >= 0)
    {
      ret += to_string(m_indices(map)[i]) + ":" +
        to_string(m_values(map)[i--]) + ", ";
    }
  }
  return ret[0..<3];
}

