#include <properties.h>
inherit "/std/container";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein kuscheliger Sack des ultimativen Federgewichts");
  SetProp(P_LONG, break_string("Ein Sack aus kuscheligem Leder. Er ist selbst genaeht und bietet einigen "+
    "Platz fuer alle moeglichen Sachen, die Du so mit Dir rumschleppst."+
    " Dieser Sack laesst Dich mehr schleppen als jeder andere Sack."));
  AddId(({"sack", "sack der Leichtigkeit"}));
  AddAdjective( ({"kuschelig", "kuscheliger", "kuscheligen"}));
  SetProp(P_NAME, "Sack");
  SetProp(P_NAME_ADJ, "kuschelig");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 150);
  SetProp(P_MAX_WEIGHT, 16000);
  SetProp(P_VALUE, 1000);
  SetProp(P_WEIGHT_PERCENT, 20);
  SetProp(P_MAGIC,1);
  SetProp(P_INFO, break_string("Dieser Sack macht Sachen noch leichter als andere Saecke, "+
    "Du Sack.\n"));
  SetProp(P_MATERIAL, ([ MAT_LEATHER : 70 , MAT_MAGIC : 30 ]));
  AddDetail("leder", break_string("Feines Leder das sich kuschelig weich und angenehm "+
    "anfuehlt und mit magischer Seide vernaeht ist.\n"));
  seteuid(getuid(this_object()));
  if (this_player())
    write_file("/p/std/skills/sewing_tanning/log/meisterschneider.log",
        sprintf("%s: %O erzeugt %s.\n",
          dtime(), this_player(), QueryProp(P_SHORT) ));
}
