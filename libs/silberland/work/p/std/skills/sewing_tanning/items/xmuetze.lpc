inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>

void create() 
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine rote Zipfelmuetze mit weissem Fellquastel");
  SetProp(P_LONG,
    "Hierbei zeigt sich deutlich dass Geschmack seine Grenzen hat. "
    "Das weisse Quasterl baumelt peinlich rum." );
  AddDetail( ({ "quaste", "quasterl", "quastel" }),
    "... baumelt rum.");
  SetProp(P_NAME, "Zipfelmuetze mit weissem Fellquastel");
  SetProp(P_NAME_ADJ, "rot");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"muetze", "zipfelmuetze"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, MAT_FUR);
  SetProp(P_WEIGHT, 70);
  SetProp(P_VALUE, 110);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3, T_HEAT_PROT:-1]) );
}

