inherit "/std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Morgenstern");
  SetProp(P_LONG,  
    "An einem stabilen Holzgriff ist ein langer Lederriemen befestigt, an der "
    "eine mit spitzen Stacheln besetzt Lederkugel haengt. Oftmals verfehlt "
    "man den Gegner mit dem Morgenstern, aber wenn man einmal trifft, dann "
    "ist die Schadenswirkung enorm.");
  SetProp(P_NAME, "Morgenstern");
  SetProp(P_GENDER, MALE);
  AddId( ({"morgenstern"}) );

  SetProp(P_WEAPON_TYPE, WT_CHAIN );
  SetProp(P_WC, 177);
  SetProp(P_WC_FIX, 20);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_LEATHER: 70, MAT_IRON: 10, MAT_OAK: 20]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 1100);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:8]) );  
}

