#include <properties.h>
inherit "/std/container";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein kleiner Lederbeutel");
  SetProp(P_LONG, break_string("Ein Beutel aus feinem Leder. Er ist selbst genaeht und bietet einigen "+
    "Platz fuer alle moeglichen Sachen, die Du so mit Dir rumschleppst."));
  AddId(({"beutel", "lederbeutel"}));
  AddAdjective( ({"klein", "kleiner", "kleinen"}));
  SetProp(P_NAME, "Lederbeutel");
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 250);
  SetProp(P_MAX_WEIGHT, 5000);
  SetProp(P_VALUE, 100);
  SetProp(P_WEIGHT_PERCENT, 50);
  SetProp(P_INFO, break_string("Dieser Lederbeutel ermoeglicht es Dir, mehr Sachen "+
    "mit Dir herum zu tragen.\n"));
  SetProp(P_MATERIAL, MAT_LEATHER);
  AddDetail("leder", break_string("Feines Leder das sich weich und angenehm "+
    "anfuehlt.\n"));

}
