inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include "/gilden/druidenzirkel/druiden_extern.h"
#include "/gilden/berserker/berserker_extern.h"
#include "/gilden/paladine/paladin_extern.h"
#include "/gilden/nekromanten/nekro_properties.h"
#include "/gilden/zechpreller/zechpreller_extern.h"
#include "/gilden/amazonen/amazonen_extern.h"
#include "/gilden/waldlaeufer/def_extern.h"

void create()
{
  string matname,mat;
  int value;
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:6, T_HEAT_PROT:2]) );
  SetProp(P_MATERIAL, ([MAT_SILK:10, MAT_PELT:90]) );
  SetProp(P_VALUE, random(1300)+4000);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_NAME_ADJ, "exquisit");
  AddAdjective( ({"exquisit", "exquisiten", "exquisiter", "exquisitem"}) );

  AddId( ({"mantel", "fellmantel"}) );
  AddDetail( ({"fell", "baerenfell"}),
    "Das Fell eines legendaeren Baren. Du bist stolz, einen solch tollen "
    "Mantel zu besitzen.");
  seteuid(getuid(this_object()));
}

void _init_armor(){
  int attr;
  if(QueryProp(P_ARMOUR_TYPE) == AT_CLOAK ||
      QueryProp(P_ARMOUR_TYPE) == AT_BELT ||
      QueryProp(P_ARMOUR_TYPE) == AT_ARMOUR )
    SetProp(P_GENDER, MALE);
  else if(QueryProp(P_ARMOUR_TYPE) == AT_AMULET)
    SetProp(P_GENDER, NEUTER);
  else if(QueryProp(P_ARMOUR_TYPE) == AT_TROUSERS ||
      QueryProp(P_ARMOUR_TYPE) == AT_HELMET )
    SetProp(P_GENDER, FEMALE);
  else if(QueryProp(P_ARMOUR_TYPE) == AT_GLOVE||
      QueryProp(P_ARMOUR_TYPE) == AT_BRACERS ||
      QueryProp(P_ARMOUR_TYPE) == AT_BOOT )
    SetProp(P_PLURAL, 1);
  SetProp(P_VALUE, random(QueryProp(P_AC) * 300) + 1200);
  SetProp(P_WEIGHT, QueryProp(P_AC) * 50);
  SetProp(P_QUALITY_DECAY, 280 + random(12) * random(12) );

  if (strstr(QueryProp(P_SHORT), "Berserker") != -1)
    SetProp(P_BERSERKER_BONUS, (["all": 10 + random(10)]));
  else if (strstr(QueryProp(P_SHORT), "Druiden") != -1)
    SetProp(P_ITEMD_ELEMENTAL_VALUE, 7 + random(4));
  else if (strstr(QueryProp(P_SHORT), "Paladin") != -1)
    SetProp(P_PALADIN_SPELLCOST, 7 + random(4));
  else if (strstr(QueryProp(P_SHORT), "Nekromant") != -1)
  {
    SetProp(P_NEKRO_SPELLCOST, 7 + random(4));
    SetProp(P_NEKRO_BONUS, (["all": 10 + random(10)]));
  }
  else if (strstr(QueryProp(P_SHORT), "Zechpreller") != -1)
  {
    SetProp(P_ZECHPRELLER_SPELLCOST, 7 + random(4));
    SetProp(P_ZECHPRELLER_BONUS, (["all": 10 + random(10)]));
    SetProp(P_ZECHPRELLER_REDUCE_ALC, 20 + random(10));
  }
  else if (strstr(QueryProp(P_SHORT), "Amazone") != -1)
  {
    SetProp(P_AMAZONEN_SPELLCOST, 7 + random(4));
    SetProp(P_AMAZONEN_BONUS, (["all": 10 + random(10)]));
  }
  else if (strstr(QueryProp(P_SHORT), "Waldlaeufer") != -1)
  {
    SetProp(P_RANGER_SPELLCOST, 7 + random(4));
    SetProp(P_RANGER_BONUS, (["all": 10 + random(10)]));
  }
  SetProp(P_M_HEALTH_MOD,([P_HP: 1+random(6), P_SP: 1+random(6)]));
  //SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_LONG,break_string(
        QueryProp(P_SHORT)+
        ", bestehend aus mit magischer Seide vernaehtem Baerenfell, "
        "schuetzend vor Angriffen, waermend bei kaltem Wetter und selbst "
        "genaeht, das ist doch ganz was besonderes! " + capitalize(QueryPronoun(WER)) + 
        " wurde" + (IsPlural() ? "n" : "") + " von einem Meisternaeher "
        "hergestellt und " + (IsPlural() ? "verbessern" : "verbessert") +  
        " die Gildenfertigkeiten."
        )
      );
  write_file("/p/std/skills/sewing_tanning/log/meisterschneider.log",
      sprintf("%s: %O erzeugt %s.\n",
        dtime(), this_player(), QueryProp(P_SHORT) ));
}

