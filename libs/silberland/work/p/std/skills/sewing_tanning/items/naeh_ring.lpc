
#include <properties.h>
#include <combat.h>
#include <attributes.h>

#include "/p/daemon/skillmaster/skillmaster.h"

inherit "std/armour";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId(({"ring", "holzring", "naehersring", "\nnaehersring", "naehring", 
        "naeherring"}));
  SetProp(P_SHORT, "Ein hoelzerner Ring des Naehers");
  SetProp(P_LONG,
    "Der Ring ist prachtvoll gearbeitet und besteht aus Holz. "
    "Eine kleine Schnitzerei auf der Oberseite des Rings zeigt "
    "ein Naehkaestchen und ein Fuchsfell (gegerbt).");
  SetProp(P_NAME, "Holzring");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 4);
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 4000+500*random(6));
  SetProp(P_SKILL_MOD, ([SK_SEWING:300, SK_TANNING:-1000]));
  SetProp(P_MATERIAL, ([MAT_WOOD:70,MAT_MAGIC:30]) );
  SetProp(P_INFO,"Dieser Ring verbessert Deine Naehfertigkeit!\n"+
                 "Dieser Ring verschlechtert Deine Gerbfertigkeit!\n"+
                 "Dieser Ring macht Dich intelligenter!\n"+
                 "Dieser Ring bietet zusaetzliche Ruestungsklasse!\n");
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_M_ATTR_MOD, ([ A_INT: 1 + !random(3) + !random(3) ]) );
  SetProp(P_WEAR_FUNC, this_object());
}

int WearFunc(object ruestung, int silent)
{
  object *rings;

  if (sizeof(rings = environment()->QueryArmours(AT_RING)) && 
      rings[0]->id("\nnaehersring") )
  {
    if (!silent)
      tell_object(environment(), "Du traegst doch bereits einen Naeherring!\n");
    return 0;
  }
  return 1;
}
