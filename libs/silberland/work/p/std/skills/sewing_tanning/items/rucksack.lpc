#include <properties.h>
inherit "/std/container";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein ultimativer Rucksack des Weltenumwanderers");
  SetProp(P_LONG, break_string("Ein Rucksack aus wunderschoenem, weissen "
        "Loewenfell. Er ist selbst genaeht und bietet einigen "+
    "Platz fuer alle moeglichen Sachen, die Du so mit Dir rumschleppst."+
    " Dieser Rucksack bleibt Dir auch bei einem Tod erhalten!"));
  AddId(({"rucksack", "rucksack des weltenumwanderers"}));
  AddAdjective( ({"ultimativ", "ultimativer", "ultimativen"}));
  SetProp(P_NAME, "Rucksack des Weltenumwanderers");
  SetProp(P_NAME_ADJ, "ultimativ");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 300);
  SetProp(P_MAX_WEIGHT, 20000);
  SetProp(P_VALUE, 3000);
  SetProp(P_WEIGHT_PERCENT, 30);
  SetProp(P_MAGIC,1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_INFO, break_string("Dieser Rucksack macht Sachen noch leichter "
        "als andere Saecke, ausserdem bleibt er beim Tod erhalten.\n"));
  SetProp(P_MATERIAL, ([ MAT_LEATHER : 70 , MAT_MAGIC : 30 ]));
  seteuid(getuid(this_object()));
  if (this_player())
    write_file("/p/std/skills/sewing_tanning/log/meisterschneider.log",
        sprintf("%s: %O erzeugt %s.\n",
          dtime(), this_player(), QueryProp(P_SHORT) ));
}
