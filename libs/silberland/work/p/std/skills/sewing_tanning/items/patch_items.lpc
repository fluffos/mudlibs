inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  string matname,mat;
  int value;
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_MATERIAL, ([MAT_CLOTH:95, MAT_SILK:5]) );
  SetProp (P_VALUE, random(900)+200);

  AddDetail( ({"stoff","stoffreste"}),
    "Sie wurden sauber vernaeht.");
  SetProp(P_SMELL,
    "Riecht etwas vergammelt.\n");
}

void _init_armor(){

  if(QueryProp(P_ARMOUR_TYPE)==AT_CLOAK ||
      QueryProp(P_ARMOUR_TYPE)==AT_BELT ||
      QueryProp(P_ARMOUR_TYPE)==AT_ARMOUR )
    SetProp (P_GENDER, MALE);
  else if(QueryProp(P_ARMOUR_TYPE)==AT_AMULET)
    SetProp (P_GENDER, NEUTER);
  else if(QueryProp(P_ARMOUR_TYPE)==AT_TROUSERS ||
      QueryProp(P_ARMOUR_TYPE)==AT_HELMET )
    SetProp (P_GENDER, FEMALE);
  else if( QueryProp(P_ARMOUR_TYPE)==AT_GLOVE||
      QueryProp(P_ARMOUR_TYPE)==AT_BRACERS ||
      QueryProp(P_ARMOUR_TYPE)==AT_BOOT )
    SetProp(P_PLURAL, 1);
  SetProp (P_VALUE, random(QueryProp(P_AC)*200)+200);
  SetProp (P_WEIGHT, QueryProp(P_AC)*90);
  SetProp(P_LONG, break_string(
        QueryProp(P_SHORT)+
        ", bestehend aus schoen vernaehten Stoffresten, schuetzend vor Angriffen, "
        "waermend bei kaltem Wetter und selbst genaeht, das ist doch "
        "ganz was besonderes!")
      );
}

