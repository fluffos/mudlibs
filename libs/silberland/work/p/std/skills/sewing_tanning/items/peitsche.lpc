inherit "/std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Peitsche");
  SetProp(P_LONG,  
    "Die Peitsche besteht eigentlich nur aus einer langen Lederschnur, die an "
    "einen Griff befestigt ist. Sie ist selbst zusammengenaeht!");
  SetProp(P_NAME, "Peitsche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"peitsche"}) );

  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 111);
  SetProp(P_WC_FIX, 10);
  SetProp(P_DAM_TYPE, DT_WHIP );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 400);
  SetProp(P_QUALITY_DECAY, 80);
}

