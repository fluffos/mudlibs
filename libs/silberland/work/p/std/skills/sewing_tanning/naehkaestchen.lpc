{
  if(nr == 6)
    return ({
             "Du bist fast fertig.",
             "Du spuerst, dass dies ein Meisterstueck werden wird.",
             "Du denkst . o O (Ich bin der beste Schneider im SilberLand)",
             "Fast hast Du es geschafft",
             armor_types[i][3] +" naehert sich der Fertigstellung.",
             armor_types[i][3] +" ist fast fertig.",
             armor_types[i][3] +" wird sicher wunderschoen.",
             })[random(7)];
  return ({
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du naehst.",
      "Du denkst . o O (Ob ich jemals so meisterlich naehen werde wie Bardo?)",
      "Deine Finger schmerzen von dieser Arbeit.",
      "Du konzentrierst Dich voll auf Deine Arbeit.",
      "AUA! Du stichst Dir mit der Naehnadel in den Finger!",
      "Du hoffst, dass Du bald ein Meisternaeher bist.",
      armor_types[i][3] +" nimmt langsam Gestalt an.",
      "Du denkst . o O (Ich brauche mehr Felle)",
      "Du denkst . o O (Ich brauche mehr Seide)",
      "Du singst: Lustig ist das Naeherleben, tralalala.",
      })[random(30)];
}

varargs int sew_now(int i, mixed presuf) {
  switch(DELAY_COUNT) {
    case 0:
      tell_object(this_player(),
          random_message(i, 0)+" [------]\n");
      //"Du suchst Dir das passende Naehmuster.\n");
      break;
    case 1:
      tell_object(this_player(),
          random_message(i, 2)+" [**----]\n");
      //"Du suchst Dir das passende Naehmuster.\n");
      break;
    case 2:
      tell_object(this_player(),
          random_message(i, 4)+" [****--]\n");
      //"Du konzentrierst Dich.\n");
      if( this_player())
        this_player()->SetProp(P_TMP_MOVE_HOOK, 0);
      break;
  }

  if(DELAY_COUNT>2){
    if(!PL_MOVED){
      tell_object(this_player(),
          random_message(i, 6)+" [******]\n");
      call_out("build_armor",1,i, presuf);
      DELAY_COUNT=0;
      PL_MOVED=0;
      IS_SEWING=0;
      return 1;
    }
    else{
      DELAY_COUNT=0;
      write("Du vernichtest alles und brichst den Naehvorgang ab.\n");
      PL_MOVED=0;
      IS_SEWING=0;
      return 1;
    }
  }

  DELAY_COUNT++;
  call_out("sew_now",armor_types[i][0]+random(2),i, presuf);
  return 1;
}

int func_naeh(mixed in){
  int amount;
  string fell;
  object *fell_present;
  object *silk_present;
  object *dest_now;
  mixed presuf;
  int r,s,i;

  r=0;
  s=0;
  amount=0;

  fell_present=({});
  dest_now=({});

  NKNAME=capitalize(getuid(this_player()));    
  notify_fail(break_string("Das geht jetzt nicht."));
  if(this_player()->InFight()) return 0;
  notify_fail(break_string("Was willst du Naehen? Nr. 1,2,.."+
        " (siehe Kommando <naehmuster>)"));

  if(!in) return 0;

  i=to_int(in);

  call_other(SKILLMASTER, "???");

  if(interactive(TP) && (SKILLMASTER->QuerySkill(TP, SK_SEWING)==-1))
    obtain_sewing_skill(TP);

  if(i<1 || i>(sizeof(armor_types)-1)) return 0;

  //  ({1,5, "lkappe", "Eine lederne Kappe", 1, "biberfell", 1, "raupenseide"}),

  if(armor_types[i][1]>s_skill) return 0;

  write("Du versuchst folgendes herzustellen: "+armor_types[i][3]+".\n");
  // write(armor_types[to_int(i)][4]);
  amount=sizeof(fell_present=filter_objects(all_inventory(this_player()),
        "id",armor_types[i][5]));
  if(amount<armor_types[i][4]){
    write("Fehlende Komponenten: "+capitalize(armor_types[i][5])+
        " ("+(armor_types[i][4]-amount)+" Stk.)");
    r=1;
  } 

  amount=sizeof(silk_present=filter_objects(all_inventory(this_player()),
        "id",armor_types[i][7]));
  if(amount<armor_types[i][6]){
    if(r==1) write(" und "); else write ("Fehlende Komponenten: ");
    write(capitalize(armor_types[i][7])+
        " ("+(armor_types[i][6]-amount)+" Stk.)");
    r=1;
  }
  if(r==1){
    write(".\n");
    return 1;
  }

  if(armor_types[i][1]<9400){ 
    for(r=0;r<armor_types[i][4];r++){
      if(member_array("\ng_fell",(fell_present[r]->QueryProp(P_IDS)))!=-1){
        s++;
        dest_now+=({fell_present[r]});    
      }
    }
    if(s<armor_types[i][4]){
      write("Du hast nur "+s+" Stk. gegerbte "+
          capitalize(armor_types[i][5])+
          "e brauchst jedoch "+
          armor_types[i][4]+" Stk.\n");
      return 1;
    }
  }
  else{
    for(r=0;r<armor_types[i][4];r++){
      if((sizeof(fell_present)-1) >= r) {
        if(member_array("\ng_fell_hq",(fell_present[r]->QueryProp(P_IDS)))!=-1)
        {
          s++;
          dest_now+=({fell_present[r]});    
        }
      }

    } 
    if(s<armor_types[i][4]){
      write("Du hast nur "+s+" Stk. hochqualitativ gegerbte "+
          capitalize(armor_types[i][5])+
          "e brauchst jedoch "+armor_types[i][4]+" Stk.\n");
      return 1;
    }
  }
  for(r=0;r<=armor_types[i][6]-1;r++) {
    if((sizeof(silk_present)-1) >= r) 
      dest_now+=({silk_present[r]});
  }

  if(!this_player()->QueryProp(P_TMP_MOVE_HOOK)){
    this_player()->SetProp(P_TMP_MOVE_HOOK, ({ time()+200, this_object(), "player_tries_to_move" }) );
  }
  else
  {
    write("Aus irgendeinem Grund kannst Du  nicht naehen.\n "
        "Du wirst schon wissen, warum!\n");
    return 1;

  }

  write("Du nimmst folgende Dinge zur Hand:\n");
  for(r=0;r<=sizeof(dest_now)-1;r++) {
    write(" -"+dest_now[r]->QueryProp(P_SHORT)+"\n");
    if(pointerp(dest_now[r]->QueryProp(P_ITEMD_PRE_SUFFIX))) {
      presuf=dest_now[r]->QueryProp(P_ITEMD_PRE_SUFFIX);
    }
    dest_now[r]->remove(0);
  }


  write ("Du beginnst...\n");
  tell_room(environment(this_player()),NKNAME+" packt "+
      this_player()->QueryPossPronoun(NEUTER, WEN, SINGULAR)
      +" Naehkaestchen aus und naeht.\n",
      ({this_player()})); 
  DELAY_COUNT=0;
  IS_SEWING=1;
  call_out("sew_now",1,i, presuf); 

  return 1;
}


int build_armor(int i, mixed presuf){
   object cob;
   string *parts;
   int suc;

  call_other(SKILLMASTER, "???");

  //leichter etwas naehen, schwerer den skill hochzubringen
  suc=SKILLMASTER->UseSkill(TP, SK_SEWING, -2000, 2000);
  s_skill=SKILLMASTER->QuerySkill(this_player(),SK_SEWING);
   if(suc>0) {
      write ("Du erzeugst: "+armor_types[i][3]+".\n");
    tell_room(environment(this_player()),BS(NKNAME+" erzeugt: "
          +armor_types[i][3]+"."), ({this_player()}));

      if(armor_types[i][2]=="I"){
        if(armor_types[i][10][0]!="/")
          cob=clone_object(ARMOR(armor_types[i][10]));
        else
          cob=clone_object(armor_types[i][10]);
        cob->move(this_player(),M_NOCHECK);
      }
      else {
      cob=clone_object(ARMOR(armor_types[i][10]));
      cob->move(this_player(),M_NOCHECK);
      cob->SetProp(P_ARMOUR_TYPE,armor_types[i][8]);
      parts=explode(armor_types[i][3]," ");
      cob->AddId(lower_case(parts[sizeof(parts)-1]));
      cob->SetProp(P_SHORT,armor_types[i][3]);
      if(s_skill<9500) {
        cob->SetProp(P_AC,armor_types[i][9]);
      }
      else if(random(10)){
        cob->SetProp(P_AC,armor_types[i][9]+1);
      }
      else {
        cob->SetProp(P_SHORT,armor_types[i][3]+
            " (hochqualitativ)"
            );
        cob->SetProp(P_AC,armor_types[i][9]+2);
        cob->SetProp(P_QUALITY_DECAY, cob->QueryProp(P_QUALITY_DECAY) * 2);
      }
      if(cob->QueryProp(P_AC) > VALID_ARMOUR_CLASS[cob->QueryProp(P_ARMOUR_TYPE)])
        cob->SetProp(P_AC, VALID_ARMOUR_CLASS[cob->QueryProp(P_ARMOUR_TYPE)]);
      cob->SetProp(P_NAME,armor_types[i][2]);
      cob->AddId(explode(lower_case(armor_types[i][2])," "));
      cob->AddId(lower_case(armor_types[i][8]));
      cob->_init_armor();
      cob->SetProp(P_ITEMD_NO_SOCKETED, 1);
      cob->SetProp(P_LONG, cob->QueryProp(P_LONG) + " " + cob->Name(WER,1) + " wurde von " +
          capitalize(getuid(this_player())) + " erzeugt.\n");
      }
      if(s_skill > 9250 && suc > 5000 && pointerp(presuf) && sizeof(presuf)==2 &&
          (presuf[0]!="" && presuf[1]!="") ) 
      {
        tell_object(TP, BS("Durch Deine aussergewoehnlichen Naehfertigkeiten "
              "hast Du magische Eigenschaften in Dein Werk weben koennen!"));
        DoMagic(cob, presuf[0], presuf[1]);

      }
      return 1;
   }
   write("Du warst zu ungeschickt! Leider hast Du alles vernichtet.\n");
   return 1;
}

int func_muster(string i){
  int x;
  int y;

  check_sk_values();

  y=0;
  notify_fail("Welche Seite der Muster haettes Du gerne? naehmuster <1..10>\n");

  if(to_int(i) < 1 || to_int(i) > 10) return 0;


  write("----------------------------------------------------------------\n");
  write("In Ausbildungsstufe "+i+" ("+level_names[to_int(i)]+") kannst Du \n");
  write("mit Deinem momentanen Koennen folgendes herstellen:\n");
  write("----------------------------------------------------------------\n");
  for (x=1;x<=sizeof(armor_types)-1;x++)
  {
    if(to_int(i)==to_int(armor_types[x][0])&&(s_skill>=armor_types[x][1])){

      y++;
      // write(sprintf("%2d. %s - Erfahrung: %1d\n    Kosten: %1d Stk. %s und %1d Stk. %s\n",
      write(sprintf("%2d. %s \n    Kosten: %1d Stk. %s und %1d Stk. %s\n",
            x,armor_types[x][3],armor_types[x][4],
            capitalize(armor_types[x][5]),
            armor_types[x][6],
            capitalize(armor_types[x][7])));
    }
  }
  if(!y) write ("Noch gar nichts.\n");
  write("----------------------------------------------------------------\n");
  return 1;
}

nosave int DoMagic(object ob, string pre, string suf) {
  call_other(ITEMD, "SetMagicItem",ob, pre, suf);
  return 1;
}

void init()
{
  ::init();
  if (environment() && interactive(environment()))
    SetProp(P_KEEP_ON_SELL, getuid(environment()));
}
