void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  SetProp(P_SHORT, "Ein Juwelierkaestchen");
  SetProp(P_LONG,
      "Du siehst ein Juwelierkaestchen. Es ermoeglicht Dir verschiedene "+
      "Dinge herzustellen. Mit <juweliermuster> oder kurz <jm> kannst Du "+
      "Dir ansehen, was Du herstellen kannst. "
      "Mit <jj> kannst Du dann die Schmuckstuecke herstellen.");
  AddId( ({"\nJuwelierkaestchen","kaestchen","juwelierkaestchen"}) );
  SetProp(P_NAME, "Juwelierkaestchen");
  SetProp(P_GENDER, NEUTER);

  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  SetProp(P_MATERIAL, ({MAT_WOOD, MAT_METAL}));

  AddCmd(({"jj"}), "func_jj");
  AddCmd(({"juweliermuster","jm"}), "func_muster");
  
  check_sk_values();
  SUID;
}

string show_level(){
  return level_names[1+j_skill/250];
}

void check_sk_values() 
{
  NKNAME=capitalize(getuid(this_player()));    
  call_other(SKILLMASTER, "???");
  j_skill=SKILLMASTER->QuerySkill(this_player(),SK_JEWELRY);
  return;
}

int obtain_jewelry_skill(object pl) {
   int start_skill, maxskill, maxunlearn;
   int x;
   switch(pl->QueryProp(P_RACE)) {
     case "Mensch": start_skill=250; maxskill=10000; maxunlearn=9000; break;
     case "Hobbit": start_skill=500; maxskill=10000; maxunlearn=9000; break;
     case "Zwerg": start_skill=750; maxskill=10000; maxunlearn=9000; break;
     case "Elf": start_skill=300; maxskill=10000; maxunlearn=9000; break;
     case "Dunkelelf": start_skill=300; maxskill=10000; maxunlearn=9000; break;
     case "Fee": start_skill=350; maxskill=10000; maxunlearn=9000; break;
     case "Oger": start_skill=50; maxskill=9000; maxunlearn=6000; break;
     case "Troll": start_skill=50; maxskill=9000; maxunlearn=6000; break;
     default: start_skill=250; maxskill=9990; maxunlearn=9000;
   }
   call_other(SKILLMASTER, "???");
   SKILLMASTER->AddSkill(pl, SK_JEWELRY, start_skill, maxskill,
       maxunlearn, SK_JEWELRY_NAME);
   j_skill=SKILLMASTER->QuerySkill(this_player(),SK_JEWELRY);
   
   return 1;
}

void init() 
{
  ::init();
  if(this_player() && environment() && this_player() == environment())
  {
    SetProp(P_KEEP_ON_SELL, getuid(environment()));
    call_other(SKILLMASTER, "???");
    if(SKILLMASTER->QuerySkill(this_player(),SK_JEWELRY) == 0)
      obtain_jewelry_skill(this_player());
    check_sk_values();
  }
}

//-----JUWELIEREN BEGIN-----

varargs mixed player_tries_to_move(mixed dest, int methods, string direction, 
  string textout, string textin)
{
  PL_MOVED=1;
  if(MENV->QueryProp(P_GHOST))
  {
    while(remove_call_out("sew_now") != -1);
    return ({dest, methods, direction, textout, textin});
  }
  return(break_string("Du solltest Dich nicht bewegen waehrend Du juwelierst.",78));
}

string random_message(int i, int nr)
{
  string metal, gem;

  metal = armor_types[i][5];
  gem = armor_types[i][7];
  if(nr == 6)
    return ({"Das Schmuckstueck naehert sich der Vollendung.",
             "Du bist fast fertig.",
             "Du spuerst, dass dies ein Meisterstueck werden wird.",
             "Du denkst . o O (Ich bin der beste Juwelier im SilberLand)",
             "Fast hast Du es geschafft",
             "Bald ist das neue Schmuckstueck fertig",
             armor_types[i][3] +" naehert sich der Fertigstellung.",
             armor_types[i][3] +" ist fast fertig.",
             armor_types[i][3] +" wird sicher wunderschoen.",
             "Hoffentlich gelingt dieses Schmuckstueck!"})[random(10)];
  return ({
      "Mit einem kleinen Hammer bearbeitest Du das Edelmetall.",
      "Mit einem kleinen Hammer bearbeitest Du das "+CAP(metal)+".",
      "Mit Schleifpapier bringst Du das Metall zum Glaenzen.",
      "Mit Schleifpapier bringst Du das "+CAP(metal)+" zum Glaenzen.",
      "Du polierst den Schmuckstein.",
      "Langsam kann man die Form des neuen Schmuckstuecks erkennen.",
      "Du polierst das Metall.",
      "Du schleifst und haemmerst.",
      "Vor Deinem inneren Auge siehst Du schon das fertige Schmuckstueck.",
      "Du polierst "+(strstr(gem, "perle")!=-1 ? "die Perle" : "den Edelstein")+".",
      "Du haemmerst.",
      "Du polierst.",
      "Du schleifst.",
      "Du haemmerst und polierst.",
      "Du polierst und schleifst.",
      "Du haemmerst und schleifst.",
      "Du polierst und haemmerst.",
      "Du schleifst und polierst.",
      "Du haemmerst das Metall.",
      "Du haemmerst das "+CAP(metal)+".",
      "Du polierst das Metall.",
      "Du polierst das "+CAP(metal)+".",
      "Deine Finger schmerzen von dieser Arbeit.",
      "Du konzentrierst Dich voll auf Deine Arbeit.",
      "Dir bricht ein Fingernagel ab.",
      "Du brichst Dir fast einen Fingernagel ab.",
      "Du schleifst, haemmerst und polierst.",
      "Du haemmerst, schleifst und polierst.",
      "Du polierst, haemmerst und schleifst.",
      "Du haemmerst, polierst und schleifst.",
      "Du polierst, schleifst und haemmerst.",
      "Du schleifst, polierst und haemmerst.",
      "Du hoffst, dass Du bald ein Meisterjuwelier bist.",
      armor_types[i][3] +" nimmt langsam Gestalt an.",
      "Du denkst . o O (ganz schoen teuer dieses Juwelierhandwerk)",
      "Du denkst . o O (Ich brauche mehr (" +
        (strstr(gem, "perle")!=-1 ? "Perlen" : "Edelsteine") + ")",
      "Du denkst . o O (Ich brauche mehr Geld fuer Edelmetalle)",
      "Du singst: Lustig ist das Juwelierleben, tralalala.",
      })[random(38)];
}

varargs void sew_now(int i, int value, string *material) 
{
  int delay;

  if(!this_player()) return;

  switch(DELAY_COUNT) {
    case 0:
      tell_object(this_player(),
          random_message(i, 0)+" [------]\n");
      break;
    case 1:
      tell_object(this_player(),
          random_message(i, 1)+" [*-----]\n");
      break;
    case 2:
      tell_object(this_player(),
          random_message(i, 2)+" [**----]\n");
      break;
    case 3:
      tell_object(this_player(),
          random_message(i, 3)+" [***---]\n");
      break;
    case 4:
      tell_object(this_player(),
          random_message(i, 4)+" [****--]\n");
      break;
    case 5:
      tell_object(this_player(),
          random_message(i, 5)+" [*****-]\n");
      break;
  }

  if(DELAY_COUNT>5)
  {
    if(!PL_MOVED)
    {
      tell_object(this_player(),
          random_message(i, 6)+" [******]\n");
      call_out("build_armor",1, i, value, material);
      DELAY_COUNT=0;
      PL_MOVED=0;
      IS_SEWING=0;
      return;
    }
    else
    {
      this_player()->SetProp(P_TMP_MOVE_HOOK, 0);
      tell_object(this_player(), 
          "Du vernichtest alles und brichst den Vorgang ab.\n");
      DELAY_COUNT=0;
      PL_MOVED=0;
      IS_SEWING=0;
      return;
    }
  }

  delay = armor_types[i][0]/4+random(2);
  if(delay > 6)
  {
    if(!mappingp(armor_types[i][11]))
      delay /= 2;
    DELAY_COUNT++;
  }
  else
   DELAY_COUNT+=2;
  call_out("sew_now", delay, i, value, material);
}

int metal_file_name(object ob)
{
  if(strstr(file_name(ob), "/p/std/skills/jewelry/obj") != -1)
    return 1;
  return 0;
}
  
int gem_file_name(object ob)
{
  if(strstr(file_name(ob), "/obj/gems/") != -1 ||
     strstr(file_name(ob), "/obj/pearls/") != -1 ||
     strstr(file_name(ob), "/p/magic/") != -1)
    return 1;
  return 0;
}

int func_jj(mixed in)
{
  int amount;
  object *metal_present;
  object *gem_present;
  int r,i;
  int value;
  string *material;
 
  r=0;
  amount=0;

  metal_present=({});
  gem_present=({});
  
  NKNAME=capitalize(getuid(this_player()));    
  notify_fail(break_string("Das geht jetzt nicht."));
  if(this_player()->InFight()) return 0;
  notify_fail(break_string("Was willst du herstellen? Nr. 1,2,.."+
      " (siehe Kommando <juweliermuster>)"));
 
  if(!in) return 0;
  
  i=to_int(in);

  call_other(SKILLMASTER, "???");

  if(interactive(TP) && (SKILLMASTER->QuerySkill(TP, SK_JEWELRY)==0))
     obtain_jewelry_skill(TP);
  
  if(i<1 || i>(sizeof(armor_types)-1)) return 0;

//  ({1,5, "lkappe", "Eine lederne Kappe", 1, "biberfell", 1, "raupenseide"}),

  if(armor_types[i][1]>j_skill) return 0;
  
  write("Du versuchst folgendes herzustellen: "+armor_types[i][3]+".\n");
 // write(armor_types[to_int(i)][4]);
  amount=sizeof(metal_present=filter_array(filter_objects(all_inventory(this_player()),
                "id",armor_types[i][5]), #'metal_file_name));
  if(amount<armor_types[i][4]){
    write("Fehlende Komponenten: "+capitalize(armor_types[i][5])+
          " ("+(armor_types[i][4]-amount)+" Stk.)");
    r=1;
  } 
   
  amount=sizeof(gem_present=filter_array(filter_objects(all_inventory(this_player()),
                "id",armor_types[i][7]), #'gem_file_name));
  if(amount && gem_present[0]->IsUnit())
  {
    if( (amount=gem_present[0]->QueryProp(P_AMOUNT)) < armor_types[i][6])
    {
      if(r==1) write(" und "); else write ("Fehlende Komponenten: ");
      write(capitalize(armor_types[i][7])+
          " ("+(armor_types[i][6]-amount)+" Stk.)");
      r=1;
    }
  }
  else if(amount<armor_types[i][6] )
  {
    if(r==1) write(" und "); else write ("Fehlende Komponenten: ");
    write(capitalize(armor_types[i][7])+
          " ("+(armor_types[i][6]-amount)+" Stk.)");
    r=1;
  }
  if(r==1)
  {
    write(".\n");
    return 1;
  }

  if(!this_player()->QueryProp(P_TMP_MOVE_HOOK))
  {
     this_player()->SetProp(P_TMP_MOVE_HOOK, 
         ({ time()+200, this_object(), "player_tries_to_move" }) );
  }
  else
  {
    write("Aus irgendeinem Grund kannst Du nichts herstellen.\n"
        "Du wirst schon wissen, warum!\n");
    return 1;
  }
  
  value = 0;
  material = ({});
  write("Du nimmst folgende Dinge zur Hand:\n");
  for(r=0;r<=armor_types[i][4]-1;r++) {
     if((sizeof(metal_present)-1) >= r) 
     {
       write(" - "+metal_present[r]->QueryProp(P_SHORT)+"\n");
       value += metal_present[r]->QueryProp(P_VALUE);
       material += m_indices(metal_present[r]->QueryProp(P_MATERIAL));
       metal_present[r]->remove(0);
     }
  }

  material += m_indices(gem_present[0]->QueryProp(P_MATERIAL));
  if(gem_present[0]->IsUnit())
  {
    int *cpu;
    write(" - "+armor_types[i][6] + " " + gem_present[0]->Name(RAW)+"\n");
    cpu = gem_present[0]->QueryCoinsPerUnits();
    value += cpu[0] * armor_types[i][6] / cpu[1];
    gem_present[0]->AddAmount(-armor_types[i][6]);
  }
  else
  {
    write(" - "+gem_present[0]->QueryProp(P_SHORT)+"\n");
    value += gem_present[0]->QueryProp(P_VALUE);
    gem_present[0]->remove(0);
  }

  write ("Du beginnst...\n");
  tell_room(environment(this_player()),NKNAME+" packt "+
      this_player()->QueryPossPronoun(NEUTER, WEN, SINGULAR)
      +" Juwelierkaestchen aus und beginnt zu arbeiten.\n",
      ({this_player()})); 
  DELAY_COUNT=0;
  IS_SEWING=1;
  call_out("sew_now", 1, i, value/2, m_indices(mkmapping(material, material))); 

  return 1;
}

int build_armor(int i, int value, string *material)
{
  object cob;
  int suc;
  int trivial;
  string n;
  string *props;
  int j;
  mapping old_prop;

  if(!this_player()) return 0;
  this_player()->SetProp(P_TMP_MOVE_HOOK, 0);
  if(j_skill - 1000 > armor_types[i][1])
    trivial = 1;
  else
    trivial = 0;
  call_other(SKILLMASTER, "???");
  //leichter etwas naehen, schwerer den skill hochzubringen
  suc=SKILLMASTER->UseSkill(TP, SK_JEWELRY, -2500+i*8, 2000-i*10, trivial);
  j_skill=SKILLMASTER->QuerySkill(this_player(),SK_JEWELRY);
  if(suc>0) 
  {
    write ("Du erzeugst"+(trivial ? " mit Leichtigkeit" : "")+": "+armor_types[i][3]+".\n");
    tell_room(environment(this_player()),BS(NKNAME+" erzeugt: "
          +armor_types[i][3]+"."), ({this_player()}));

    cob=clone_object(ARMOR + armor_types[i][10]);
    cob->move(this_player(),M_NOCHECK);
    if (sizeof(props = explode(armor_types[i][2], " ")) == 3)
    {
      cob->SetProp(P_NAME, ({
            armor_types[i][2],
            props[0] + (props[0][<1] == 'e' ? "" : "s") + " " + props[1] + " " + props[2],
            armor_types[i][2],
            armor_types[i][2],
            }));
    }
    else
      cob->SetProp(P_NAME,armor_types[i][2]);
    if(suc > 9000)
    {
      cob->SetProp(P_SHORT,armor_types[i][3]+ " (hochqualitativ)");
      cob->SetProp(P_NAME_ADJ, "hochqualitativ");
      cob->SetProp(P_QUALITY_DECAY, 500);
      if(i >= 480)
        cob->SetProp(P_M_HEALTH_MOD, ([P_HP:1+random(4), P_SP:1+random(4)]) );
      else
        cob->SetProp(P_M_HEALTH_MOD, ([P_HP:1, P_SP:1]) );
      cob->SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1, T_HEAT_PROT:1]) );
    }
    else
      cob->SetProp(P_SHORT,armor_types[i][3]);

    n = strstr(armor_types[i][2], "perle") != -1 ? "n" : ""; 
    cob->AddId(explode(lower_case(armor_types[i][2])," "));
    cob->AddId(lower_case(armor_types[i][3]));
    cob->AddId(armor_types[i][5] + armor_types[i][9]);
    cob->AddId(armor_types[i][7] + n + armor_types[i][9]);
    cob->AddId(armor_types[i][5] + armor_types[i][7] + n + armor_types[i][9]);

    cob->SetProp(P_AC, armor_types[i][8]);
    cob->SetProp(P_MATERIAL, material);
    cob->SetProp(P_VALUE, value);
    cob->SetProp(P_ITEMD_NO_SOCKETED, 1);
    cob->SetProp(P_QUALITY_DECAY, cob->QueryProp(P_QUALITY_DECAY) + i/5 + suc/50);
    cob->set_long(capitalize(armor_types[i][5]), capitalize(armor_types[i][7]),
        armor_types[i][6], capitalize(getuid(this_player())));
    if(mappingp(armor_types[i][11]))
    {
      for(j = sizeof(props = m_indices(armor_types[i][11])) - 1; j >= 0; j--)
      {
        if(mappingp(armor_types[i][11][props[j]]))
        {
          if(!mappingp(old_prop = cob->QueryProp(props[j])))
            old_prop = ([]);
          cob->SetProp(props[j], old_prop + armor_types[i][11][props[j]]);
        }
        else
          cob->SetProp(props[j], armor_types[i][11][props[j]]);
      }
      cob->SetProp(P_MAGIC, i/100);
      cob->SetProp(P_WEAR_RESTRICTIONS,
          armor_types[i][5] == "mithril" ? ([P_LEVEL: 60]) :
          (armor_types[i][5] == "platin" ? ([SR_SEER: 1]) : ([P_LEVEL: 20])));

      if(find_player("feyaria"))
        tell_object(find_player("feyaria"),
            sprintf("%s*** JUWELIER *** : %O baut %s (%O)%s\n", 
              ANSI_BOLD+ANSI_YELLOW, this_player(),cob->QueryProp(P_SHORT),
              cob, ANSI_NORMAL));
      write_file("/p/std/skills/jewelry/log/magic",
            sprintf("%s  %O baut %s (%O)\n", 
              dtime(), this_player(),cob->QueryProp(P_SHORT), cob));
    }
    return 1;
  }
  write("Du warst zu ungeschickt! Leider hast Du alles vernichtet.\n");
  tell_room(environment(this_player()),BS("So ein Missgeschick! " + NKNAME +
        " versagt erbaermlich beim Juwelieren."), ({this_player()}));
  return 1;
}

int func_muster(string i){
  int x;
  int y;
  int max;

  check_sk_values();
  
  max = sizeof(level_names) - 1;
  y=0;
  notify_fail("Welche Seite der Muster haettes Du gerne? juweliermuster <1.." +
      max + ">\n");

  if(to_int(i) < 1 || to_int(i) > max) return 0;
  
  
  write("----------------------------------------------------------------\n");
  write("In Ausbildungsstufe "+i+" ("+level_names[to_int(i)]+") kannst Du \n");
  write("mit Deinem momentanen Koennen folgendes herstellen:\n");
  write("----------------------------------------------------------------\n");
  for (x=1;x<=sizeof(armor_types)-1;x++)
  {
    if(to_int(i)==to_int(armor_types[x][0])&&(j_skill>=armor_types[x][1])){

    y++;
    write(sprintf("%2d. %s \n    Kosten: %1d Stk. %s und %1d Stk. %s\n",
      x,armor_types[x][3],armor_types[x][4],
      capitalize(armor_types[x][5]),
     armor_types[x][6],
      capitalize(armor_types[x][7])));
    }
  }
  if(!y) write ("Noch gar nichts.\n");
  write("----------------------------------------------------------------\n");
  return 1;
}
