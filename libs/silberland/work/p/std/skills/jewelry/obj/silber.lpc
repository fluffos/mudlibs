#include <properties.h>

inherit "std/thing";

void create()
{
  ::create();

  SetProp(P_SHORT, "Ein Stueck Silber");
  SetProp(P_LONG,
    "Ein Stueck Silber, wie es Juweliere fuer die Anfertigung von Schmuck "
    "verwenden. Es glaenzt und funkelt im Licht, als ob es die Verarbeitung "
    "zu einem Schmuckstueck kaum erwarten koennte." );
  SetProp(P_NAME, "Silber");
  SetProp(P_GENDER, NEUTER);
  AddId(({"stueck", "silber", "stueck silber", "\nsk_jewelry_silber"}));

  SetProp(P_MATERIAL, MAT_SILVER );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "weiss");
}
