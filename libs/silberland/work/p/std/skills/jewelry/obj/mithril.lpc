#include <properties.h>

inherit "std/thing";

void create()
{
  ::create();

  SetProp(P_SHORT, "Ein Stueck Mithril");
  SetProp(P_LONG,
    "Ein Stueck Mithril, wie es Juweliere fuer die Anfertigung von Schmuck "
    "verwenden. Es glaenzt und funkelt im Licht, als ob es die Verarbeitung "
    "zu einem Schmuckstueck kaum erwarten koennte." );
  SetProp(P_NAME, "Mithril");
  SetProp(P_GENDER, NEUTER);
  AddId(({"stueck", "mithril", "stueck mithril", "\nsk_jewelry_mithril"}));

  SetProp(P_MATERIAL, MAT_MITHRIL );
  SetProp(P_WEIGHT, 12);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "weiss");
}
