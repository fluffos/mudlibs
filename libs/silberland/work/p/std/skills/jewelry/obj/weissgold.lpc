#include <properties.h>

inherit "std/thing";

void create()
{
  ::create();

  SetProp(P_SHORT, "Ein Stueck Weissgold");
  SetProp(P_LONG,
    "Ein Stueck Weissgold, wie es Juweliere fuer die Anfertigung von Schmuck "
    "verwenden. Es wurde durch das Legieren von Silber und Gold hergestellt. "
    "Es glaenzt und funkelt im Licht, als ob es die Verarbeitung "
    "zu einem Schmuckstueck kaum erwarten koennte." );
  SetProp(P_NAME, "Weissgold");
  SetProp(P_GENDER, NEUTER);
  AddId(({"stueck", "weissgold", "stueck weissgold", "\nsk_jewelry_weissgold"}));

  SetProp(P_MATERIAL, ([MAT_GOLD:50, MAT_SILVER:50]) );
  SetProp(P_WEIGHT, 16);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "weiss");
}
