#include <properties.h>

inherit "std/thing";

void create()
{
  ::create();

  SetProp(P_SHORT, "Ein Stueck Rotgold");
  SetProp(P_LONG,
    "Ein Stueck Rotgold, wie es Juweliere fuer die Anfertigung von Schmuck "
    "verwenden. Es wurde durch das Legieren von Kupfer und Gold hergestellt. "
    "Es glaenzt und funkelt im Licht, als ob es die Verarbeitung "
    "zu einem Schmuckstueck kaum erwarten koennte." );
  SetProp(P_NAME, "Rotgold");
  SetProp(P_GENDER, NEUTER);
  AddId(({"stueck", "rotgold", "stueck rotgold", "\nsk_jewelry_rotgold"}));

  SetProp(P_MATERIAL, ([MAT_GOLD:50, MAT_COPPER:50]) );
  SetProp(P_WEIGHT, 14);
  SetProp(P_VALUE, 1250);
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gold");
}
