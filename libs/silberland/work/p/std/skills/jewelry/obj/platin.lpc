#include <properties.h>

inherit "std/thing";

void create()
{
  ::create();

  SetProp(P_SHORT, "Ein Stueck Platin");
  SetProp(P_LONG,
    "Ein Stueck Platin, wie es Juweliere fuer die Anfertigung von Schmuck "
    "verwenden. Es glaenzt und funkelt im Licht, als ob es die Verarbeitung "
    "zu einem Schmuckstueck kaum erwarten koennte." );
  SetProp(P_NAME, "Platin");
  SetProp(P_GENDER, NEUTER);
  AddId(({"stueck", "platin", "stueck platin", "\nsk_jewelry_platin"}));

  SetProp(P_MATERIAL, MAT_PLATINUM );
  SetProp(P_WEIGHT, 22);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "weiss");
}
