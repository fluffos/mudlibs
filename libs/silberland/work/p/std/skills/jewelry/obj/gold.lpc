#include <properties.h>

inherit "std/thing";

void create()
{
  ::create();

  SetProp(P_SHORT, "Ein Stueck Gold");
  SetProp(P_LONG,
    "Ein Stueck Gold, wie es Juweliere fuer die Anfertigung von Schmuck "
    "verwenden. Es glaenzt und funkelt im Licht, als ob es die Verarbeitung "
    "zu einem Schmuckstueck kaum erwarten koennte." );
  SetProp(P_NAME, "Gold");
  SetProp(P_GENDER, NEUTER);
  AddId(({"stueck", "gold", "stueck gold", "\nsk_jewelry_gold"}));

  SetProp(P_MATERIAL, MAT_GOLD );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "gelb");
}
