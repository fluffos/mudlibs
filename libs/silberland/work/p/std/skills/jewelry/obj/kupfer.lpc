#include <properties.h>

inherit "std/thing";

void create()
{
  ::create();

  SetProp(P_SHORT, "Ein Stueck Kupfer");
  SetProp(P_LONG,
    "Ein Stueck Kupfer, wie es Juweliere fuer die Anfertigung von Schmuck "
    "verwenden. Es glaenzt und funkelt im Licht, als ob es die Verarbeitung "
    "zu einem Schmuckstueck kaum erwarten koennte." );
  SetProp(P_NAME, "Kupfer");
  SetProp(P_GENDER, NEUTER);
  AddId(({"stueck", "kupfer", "stueck kupfer", "\nsk_jewelry_kupfer"}));

  SetProp(P_MATERIAL, MAT_COPPER );
  SetProp(P_WEIGHT, 8);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "rot");
}
