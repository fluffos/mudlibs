inherit "/std/armour";

#include <combat.h>
#include <properties.h>

void create()
{
  
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_GENDER, NEUTER);
  AddId( ({"amulett", "\njewelry_amulet", "\nallowed_metal_item"}) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_WEIGHT, 20);
  SetProp("ruestungsbalsam", 10);
}

string plural(string gem)
{
  switch(gem)
  {
    case "Tigerauge": return "n";
    case "Lapislazuli": return "s";
    case "Diamant": return "en";
    default: return "e";
  }
}

void set_long(string metal, string gem, int nr, string player)
{
  if(nr < 0) nr = 0;
  else if(nr > 4) nr = 5;
  SetProp(P_LONG,
      "Ein wunderschoenes Amulett aus "+metal+", in das "+ 
      ({"kein", "ein", "zwei", "drei", "vier", "viele"})[nr]+" "+gem+
      (nr != 1 ? plural(gem) : "")+
      " eingearbeitet "+ (nr == 1 ? "ist" : "sind") +". "+
      player+" hat dieses herrliche Schmuckstueck hergestellt.");
}
