inherit "/std/armour";

#include <combat.h>
#include <properties.h>
#include "/p/daemon/skillmaster/skillmaster.h"

void create()
{
  
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_GENDER, MALE);
  AddId( ({"ring", "\njewelry_ring", "\nallowed_metal_item"}) );

  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_WEIGHT, 20);
}

void set_long(string metal, string gem, int nr, string player)
{
  if(nr < 0) nr = 0;
  else if(nr > 4) nr = 5;
  SetProp(P_LONG,
      "Ein wunderschoener Ring aus "+metal+", in den "+
      ({"keine", "eine", "zwei", "drei", "vier", "viele"})[nr]+" "+gem+
      (nr != 1 ? "n" : "")+
      " eingearbeitet "+ (nr == 1 ? "ist" : "sind") +". "+
      player+" hat dieses herrliche Schmuckstueck hergestellt.");
}

