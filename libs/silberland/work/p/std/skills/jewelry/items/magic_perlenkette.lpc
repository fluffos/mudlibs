inherit "/std/armour";

#include <combat.h>
#include <properties.h>
#include "/p/daemon/skillmaster/skillmaster.h"

void create()
{
  
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_GENDER, FEMALE);
  AddId( ({"kette", "perlenkette", "\njewelry_amulet", "\nallowed_metal_item"}) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_WEIGHT, 20);
  SetProp(P_WEAR_FUNC, this_object());
  SetProp("ruestungsbalsam", 10);
}

void set_long(string metal, string gem, int nr, string player)
{
  if(nr < 0) nr = 0;
  else if(nr > 4) nr = 5;
  SetProp(P_LONG,
      "Eine wunderschoene Kette aus "+metal+" auf die "+
      ({"kein", "eine", "zwei", "drei", "vier", "viele"})[nr]+" "+gem+
      (nr != 1 ? "n" : "")+ " aufgefaedelt "+ (nr == 1 ? "ist" : "sind") +
      ". "+ player+" hat dieses herrliche Schmuckstueck hergestellt.");
}

int WearFunc(object ruestung, int silent)
{
  mapping skills;
  string skill;
  int value, max;

  if (mappingp(skills = QueryProp(P_SKILL_MOD)))
  {
    skill = m_indices(skills)[0];
    if (mappingp(skills = this_player()->QueryProp(P_EXTERNAL_SKILLS)) &&
        member(skills, skill))
    {
      if (skills[skill,0] == skills[skill, 3]) // Skill gemaxt, ring darf verwendet werden
        return 1;
    }
    write(break_string("Deine Faehigkeiten sind zu gering, um " + 
          name(WEN,1) + " zu benutzen.", 78));
    return 0;
  }
  return 1;
}
