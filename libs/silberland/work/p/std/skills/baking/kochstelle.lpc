void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Kochstelle");
  SetProp(P_LONG, 
    "Diese Kochstelle bietet alles was das Herz eines Koches erfreut. "
    "Eine grosse Feuerstelle zum Kochen, dazu jede Menge Toepfe und Pfanne, "
    "Messer zum Schneiden, Loeffeln zum Umruehren und einge ganze Menge "
    "anderer Kuechenwerkzeuge."
    "Was Du alles kochen kannst, siehst Du mit 'kochrezepte'.");
  SetProp(P_NAME, "Kochstelle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kochstelle", "\nsbaking_cookingpoint"}) );

  SetProp(P_MATERIAL, ([MAT_STEEL:60, MAT_WOOD:20, MAT_FIRE:20]) );
  SetProp(P_WEIGHT, 120000);
  SetProp(P_VALUE, 5500);
  SetProp(P_SIZE, 130);
//  SetProp(P_NOGET, 1);

  AddDetail( ({"feuerstelle", "feuer", "hitze"}),
      "Das Feuer hat gerade die richtige Hitze zum Kochen.");
  AddDetail( ({"toepfe", "topf", "pfanne", "pfannen"}),
      "Es sind genug Toepfe und Pfannen fuer alle moeglichen Gerichte da.");
  AddDetail( ({"messer", "loeffel", "kuechenwerkzeug", "kuechenwerkzeuge"}),
      "Es sind je Menge Kuechenwerkzeuge hier, alles was man so zum Kochen "
      "braucht.");


  AddCmd( ({"koche", "koch"}), "cmd_kochen");
  AddCmd( ({"rezepte", "kochrezepte"}), "cmd_rezepte");

  seteuid(getuid(this_object()));
}

varargs mixed player_tries_to_move(mixed dest, int methods, string direction, 
  string textout, string textin)
{
  PL_MOVED=1;
  if(MENV->QueryProp(P_GHOST))
  {
    while(remove_call_out("sew_now") != -1);
    return ({dest, methods, direction, textout, textin});
  }
  return(break_string("Du solltest Dich nicht bewegen waehrend Du kochst.",78));
}

int cmd_kochen(string str)
{
  int suc;

  if (objectp(IS_BAKING) && present(IS_BAKING, ENV(TO)))
    notify_fail("Hier kocht schon " + IS_BAKING->name(WER) + "!\n");
  call_other(SKILLMASTER, "???");
  suc = SKILLMASTER->UseSkill(this_player(), SK_BAKING); 
  IS_BAKING = TP;
  return 1;
}

string zutatenstring(string* zutaten)
{
  string ret;
  int i;

  ret = "";
  for (i = 0; i < sizeof(zutaten); i++)
  {
    ret += capitalize(zutaten[i]);
    if (i == sizeof(zutaten) - 1)
      ret += ".";
    else if (i == sizeof(zutaten) - 2)
      ret += " und ";
    else
      ret += ", ";
  }
  return ret;
}

int cmd_rezepte(string str)
{
  int x;
  int y;
  int j_skill;

  call_other(SKILLMASTER, "???");
  j_skill=SKILLMASTER->QuerySkill(this_player(),SK_BAKING);
  
  y=0;
  notify_fail("Welche Seite der Kochrezepte haettes Du gerne? kochrezepte "
      "<1.."+REZEPT_SEITEN+">\n");

  if(to_int(str) < 1 || to_int(str) > REZEPT_SEITEN) return 0;
  
  
  write("----------------------------------------------------------------\n");
  write("In Ausbildungsstufe "+str+" ("+level_names[to_int(str)]+") kannst Du \n");
  write("mit Deinem momentanen Koennen folgendes herstellen:\n");
  write("----------------------------------------------------------------\n");
  for (x=1;x<=sizeof(rezept_liste)-1;x++)
  {
    if(to_int(str)==to_int(rezept_liste[x][0])&&(j_skill>=rezept_liste[x][1])){

    y++;
    write(sprintf("%2d. %s \n      Zutaten: %s\n",
      x,rezept_liste[x][3],
      zutatenstring(rezept_liste[x][4])));
    }
  }
  if(!y) write ("Noch gar nichts.\n");
  write("----------------------------------------------------------------\n");
  return 1;
}

