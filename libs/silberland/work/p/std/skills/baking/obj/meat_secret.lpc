inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein Stueck Gehemeinsfleisch");
  SetProp(P_LONG, 
    "Ein sehr seltsames Stueck Fleisch, das irgendwie magisch aufgeladen "
    "zu sein scheint. Von welchem Lebewesen es stammt, laesst sich nicht "
    "mehr feststellen, aber es ist ganz bestimmt etwas sehr besonderes. "
    "Ob man daraus auch etwas besonderes kochen kann?");
  SetProp(P_NAME, "Gehemeinsfleisch");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fleisch", "gehemeinsfleisch", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_FLESH:100]) );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 100);
}
