inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein Vogelei");
  SetProp(P_LONG, 
    "Das Ei eines Vogels. Es hat eine harte, weisse Schale und sieht sehr "
    "lecker aus. Von welchem Vogel dieses Ei stammt, laesst sich nur sehr "
    "schwer feststellen, aber Ei ist Ei. Sicher eignet es sich sehr gut "
    "zum Kochen.");
  SetProp(P_NAME, "Vogelei");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"ei", "vogelei", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_FOOD:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
}
