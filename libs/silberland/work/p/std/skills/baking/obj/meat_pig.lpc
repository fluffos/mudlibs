inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein saftiges Stueck Schweinefleisch");
  SetProp(P_LONG, 
    "Ein saftiges Stueck Fleisch vom einem Schwein oder Wildschwein, "
    "so genau laesst sich das nicht mehr erkennen, aber es wird sicher lecker "
    "schmecken, wenn es einmal richtig zubereitet und gebraten ist.");
  SetProp(P_NAME, "Schweinefleisch");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fleisch", "schweinefleisch", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_FLESH:100]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 10);
}
