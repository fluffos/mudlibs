inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Etwas Milch");
  SetProp(P_LONG, 
    "Ein viertel Liter Milch, gerade die Menge die man oft zum Kochen braucht.");
  SetProp(P_NAME, "Milch");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"milch", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_MILK:100]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 100);
}
