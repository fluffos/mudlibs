inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein Elfenohr");
  SetProp(P_LONG, 
    "Das Ohr eines Elfen, oder einer Elfin, so genau laesst sich das nicht "
    "mehr feststellen.");
  SetProp(P_NAME, "Elfenohr");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"ohr", "elfenohr", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_SKIN:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
}
