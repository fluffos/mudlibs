inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Eine Gewuerzmischung");
  SetProp(P_LONG, 
    "Eine Gewuerzmischung, wie man sie fuer fast alle Speisen verwenden kann.");
  SetProp(P_NAME, "Gewuerzmischung");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"gewuerz", "mischung", "gewuerzmischung", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_MISC_SPICE: 100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 300);
}
