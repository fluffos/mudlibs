inherit "std/food";

#include <properties.h>
#include <food.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein Stueck Brot");
  SetProp(P_LONG, 
    "Ein Stueck Brot. Du kannst es essen, aber auch verwenden, um ein "
    "leckeres Sandwich herzustellen.");
  SetProp(P_NAME, "Brot");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"brot", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_BREAD: 100]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 70);
  SetProp(P_FOOD_INFO, ([F_SOAK: 5, F_HEAL:5]) );
}
