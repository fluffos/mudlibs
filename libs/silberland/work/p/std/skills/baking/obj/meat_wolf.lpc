inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein grosses Stueck Wolfsfleisch");
  SetProp(P_LONG, 
    "Ein grosses saftiges Stueck Wolfsfleisch. Von welchem Wolf es genau "
    "stammt, laesst sich nicht mehr erkennen, aber es wird sicher lecker "
    "schmecken, wenn es einmal richtig zubereitet und gebraten ist.");
  SetProp(P_NAME, "Wolfsfleisch");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fleisch", "wolfsfleisch", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_FLESH:100]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 10);
}
