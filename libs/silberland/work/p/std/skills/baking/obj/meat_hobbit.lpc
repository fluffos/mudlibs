inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein kleines Stueck Hobbitfleisch");
  SetProp(P_LONG, 
    "Ein grosses Stueck Hobbitfleisch. Du musst schon ein Kannibale sein, "
    "um so etwas zu essen, aber vielleicht schmeckt es ja auch sehr lecker, "
    "wenn es einmal richtig zubereitet und gebraten ist und man die Herkunft "
    "nicht mehr so eindeutig feststellen kann.");
  SetProp(P_NAME, "Hobbitfleisch");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fleisch", "hobbitfleisch", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_FLESH:100]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 10);
}
