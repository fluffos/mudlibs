inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein Fledermausfluegel");
  SetProp(P_LONG, 
    "Der kleine Fluegel einer Fledermaus. Er besteht fast nur aus weicher "
    "Haut, die sich leicht zusammenrollen laesst.");
  SetProp(P_NAME, "Fledermausfluegel");
  SetProp(P_GENDER, MALE);
  AddId( ({"fluegel", "fledermausfluegel", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_SKIN:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
}
