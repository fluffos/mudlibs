inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein rohes Stueck Rindfleisch");
  SetProp(P_LONG, 
    "Ein grosses Steak vom Rind, es ist noch roh und blutig und so kaum "
    "zu essen, aber es wird sicher lecker "
    "schmecken, wenn es einmal richtig zubereitet und gebraten ist.");
  SetProp(P_NAME, "Rindfleisch");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fleisch", "rindfleisch", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_FLESH:100]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 10);
}
