inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein kleines Stueck Katzenfleisch");
  SetProp(P_LONG, 
    "Ein kleines Stueck Fleisch von einer Katze. Was fuer eine Art von Katze "
    "das war, laesst sich nicht mehr erkennen, aber es wird sicher lecker "
    "schmecken, wenn es einmal richtig zubereitet und gebraten ist.");
  SetProp(P_NAME, "Katzenfleisch");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fleisch", "katzenfleisch", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_FLESH:100]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 10);
}
