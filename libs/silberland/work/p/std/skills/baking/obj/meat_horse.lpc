inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein riesiges Stueck Pferdefleisch");
  SetProp(P_LONG, 
    "Ein riesiges Stueck Fleisch von einem Pferd oder einem aehnlichen Huftier, "
    "so genau laesst sich das nicht mehr erkennen, aber es wird sicher lecker "
    "schmecken, wenn es einmal richtig zubereitet und gebraten ist.");
  SetProp(P_NAME, "Pferdefleisch");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fleisch", "pferdefleisch", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_FLESH:100]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 10);
}
