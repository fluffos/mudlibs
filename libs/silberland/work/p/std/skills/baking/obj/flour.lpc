inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Etwas Mehl");
  SetProp(P_LONG, 
    "Ein viertel Kilogramm Mehl, gerade die Menge die man oft zum Kochen braucht.");
  SetProp(P_NAME, "Mehl");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"mehl", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_FOOD: 100]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 10);
}
