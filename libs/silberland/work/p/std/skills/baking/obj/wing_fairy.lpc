inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein Feenfluegel");
  SetProp(P_LONG, 
    "Der Fluegel einer Fee. Er sieht aus wie ein riesiger Libellenfluegel.");
  SetProp(P_NAME, "Feenfluegel");
  SetProp(P_GENDER, MALE);
  AddId( ({"fluegel", "feenfluegel", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_SKIN:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
}
