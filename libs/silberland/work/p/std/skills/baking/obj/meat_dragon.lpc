inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein riesiges Stueck Drachenfleisch");
  SetProp(P_LONG, 
    "Ein riesiges Stueck Drachenfleisch. Von welchem Drachen es genau "
    "stammt, laesst sich nicht mehr erkennen, aber es wird sicher lecker "
    "schmecken, wenn es einmal richtig zubereitet und gebraten ist.");
  SetProp(P_NAME, "Drachenfleisch");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fleisch", "drachenfleisch", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_FLESH:100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 10);
}
