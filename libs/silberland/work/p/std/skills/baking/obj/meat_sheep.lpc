inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein zaehes Stueck Schafsfleisch");
  SetProp(P_LONG, 
    "Ein Stueck Fleisch vom Schaf, es schaut etwas zaeh aus, "
    "aber es wird sicher lecker "
    "schmecken, wenn es einmal richtig zubereitet und gebraten ist.");
  SetProp(P_NAME, "Schafsfleisch");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fleisch", "schafsfleisch", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_FLESH:100]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 10);
}
