inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Eine Basis fuer Saucen");
  SetProp(P_LONG, 
    "Eine Basis fuer Saucen. Man kann damit jegliche Sauce herstellen, "
    "man braucht nur die richtigen Zutaten.");
  SetProp(P_NAME, "Saucenbasis");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"saucenbasis", "basis", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_FOOD: 100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 200);
}
