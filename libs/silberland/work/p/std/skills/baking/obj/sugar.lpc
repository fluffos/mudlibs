inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Etwas Zucker");
  SetProp(P_LONG, 
    "Ein viertel Kilogramm Zucker, gerade die Menge die man oft zum Kochen braucht.");
  SetProp(P_NAME, "Zucker");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"zucker", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_SUGAR: 100]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 150);
}
