inherit "std/thing";

#include <properties.h>

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Ein Schlangenei");
  SetProp(P_LONG, 
    "Das Ei einer Schlange. Im Gegensatz zu Vogeleiern ist die Schale sehr "
    "weich. Von welcher Schlange dieses Ei stammt, laesst sich nur sehr "
    "schwer feststellen, aber Ei ist Ei. Sicher eignet es sich sehr gut "
    "zum Kochen.");
  SetProp(P_NAME, "Schlangenei");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"ei", "schlangenei", "\nbaking_zutat"}) );

  SetProp(P_MATERIAL, ([MAT_FOOD:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
}
