
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include "../dragon.h"
inherit D_STD;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Drachenpanzer");
//  SetProp(P_LONG,
//    "Diese Ruestung ist aus vielen kleinen Drachenschuppen gefertigt "+
//    "worden. Sie bietet trotz ihrer unheimlichen Leichtheit "+
//    "einen enormen Schutz. Die Ruestung schimmert @@color@@. "
//    );

  SetProp(P_NAME, "Drachenpanzer");
  Set(P_WEIGHT, 2000);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, MALE);
  AddId( ({ "\npanzer", "drachenpanzer", "panzer" }) );
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_MATERIAL, MAT_HORN);
  SetProp(P_AC, 35+random(6));
  stat_set(3);
}

long () {
  return(BS(
    "Diese Ruestung ist aus vielen kleinen Drachenschuppen gefertigt "+
    "worden. Sie bietet trotz ihrer unheimlichen Leichtheit "+
    "einen enormen Schutz. Auf einer Schuppe ist der Name '"+creator_name+
    "' eingraviert. Die Ruestung schimmert "+rcol+".")); 
     }


