int DefendFunc(string dtype, mixed spell, object enemy) {
  if(member(dtype, DT_FIRE)>=0) {
    return( random(defend_value) );
  }
}

void setcol(string farbe) {
  rcol=farbe;
  AddId(farbe);
  //SetProp(P_AUTOLOADOBJ, isalo );
  //AddAdjective(farbe);
  //SetProp(P_NAME_ADJ,farbe);

  stats=([]);           // initialize to prevent inconsistency (woody)
  if (farbe=="rot") {
    modify_stat("str",statvalue);
    return;
  }
  if (farbe=="blau") {
    modify_stat("int",statvalue);
    return;
  }
  if (farbe=="gruen") 
  {modify_stat("con",statvalue);
   return;
  }
 if (farbe=="weiss") 
  {modify_stat("dex",statvalue);
  return;
   }

  write("Da stimmt was nicht mit der Ruestung! Lamuerte oder Erzie "
     "benachrichtigen.\n");
}

void set_creator_name(string cn) {
  creator_name=cn; 
}
   
stat_set(int value) {
  statvalue=value;
}


mixed query_isalo() {
  return (isalo);
}

string color() {
  return(rcol);
}
string query_creator_name() {
  return creator_name; 
}
int _is_drobj() {
  return 1;
}                   
 
reset() {
  object ob;
  ::reset();
  ob=this_object();
  while (ob=environment(ob)) {
    if (isalo>0 && interactive (ob) ) {
      isalo--;
    }
  } 
 // SetProp(P_AUTOLOADOBJ, isalo );
  if (isalo<1) {
    Set(P_AUTOLOADOBJ, 0);
    SetProp(P_INFO,
        BS("Es scheint, als wuerde diese Ruestung den naechsten "+
        "Weltuntergang nicht mehr ueberstehen."));
  }
}
 
 //Wargha, irgendwe soitamal _set_autoloadobj ausdocen!!!!!
 

int _up_count( int i) {
  isalo+=i;
  if (isalo>=31) {
    isalo=30;
    return 0;
  }
  return ( 0 );
}

mixed _query_autoloadobj() {
  if(isalo<=0) 
    return 0;
  return ( ({isalo, rcol, creator_name }) );
}  

void _set_autoloadobj( mixed args ) { 
  object ob;
  ob=QueryProp(P_WORN);
  if (sizeof(args) > 1) {
    isalo=args[0];
    rcol=args[1];
    creator_name=args[2];
  }
  //SetProp (P_X_ATTR_MOD, ([ A_INT:0, A_CON:0, A_DEX:0, A_STR:0 ]));
  //stats=([ A_INT:0, A_CON:0, A_DEX:0, A_STR:0 ]); 
  stats=([]);
  SetProp(P_M_ATTR_MOD, 0);
  if (objectp(ob)) ob->UpdateAttributes();
  setcol (rcol);
}

int WearFunc(object me) 
{
  if( lower_case(query_creator_name())!=TP->query_real_name() )
  {
    write(BS("Du kannst "+name(WEN,1)+" nicht tragen, weil "+
          QueryPronoun(WER)+" fuer"+ query_creator_name()+
          " angefertigt worden "+
          (QueryProp(P_PLURAL)?"sind":"ist")+"."));
    return 0;
  }
  return 1;
}


