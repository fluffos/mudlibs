
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include "../dragon.h"
inherit D_STD;


create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Drachenschild");

  SetProp(P_NAME, "Drachenschild");
  Set(P_WEIGHT, 1100);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, MALE);
  AddId( ({ "\nschild", "drachenschild", "schild" }) );
  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_MATERIAL, MAT_HORN);
  SetProp(P_AC, 26+random(5));
  stat_set(2);
}

long () {
  return(BS(
     "Dieses Schild ist aus vielen kleinen Drachenschuppen gefertigt "+
    "worden. Es bietet trotz seiner unheimlichen Leichtheit "+
    "einen enormen Schutz. Auf einer Schuppe ist der Name '"+creator_name+
    "' eingraviert. Das Schild schimmert "+rcol+"."));
}

