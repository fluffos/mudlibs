
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include "../dragon.h"
inherit D_STD;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Drachenhelm");
  //SetProp(P_LONG,
  //  "Dieser Helm ist aus vielen kleinen Drachenschuppen gefertigt "+
  //   "worden. Er bietet trotz seiner unheimlichen Leichtheit "+
  //  "einen enormen Schutz. Dieser helm leuchtet @@color@@."
  //  );

  SetProp(P_NAME, "Drachenhelm");
  Set(P_WEIGHT, 700);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, MALE);
  AddId( ({ "drachenhelm", "helm" }) );
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_MATERIAL, MAT_HORN);
  SetProp(P_AC, 12+random(4));
  stat_set(2);  
//  call_out("modify_long",2);
}

