
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include "../dragon_new.h"
inherit D_STD; 

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Drachenarmschienen");
  SetProp(P_LONG,
    "Diese Schienen sind aus vielen kleinen Drachenschuppen gefertigt "+
    "worden. Die Schienen bieteten trotz ihrer unheimlichen Leichtheit "+
    "einen enormen Schutz."
    );

  SetProp(P_NAME, "Drachenarmschienen");
  Set(P_WEIGHT, 700);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({ "\narm", "armschienen", "drachenarmschienen"}) );
  SetProp(P_ARMOUR_TYPE, AT_BRACERS);
  SetProp(P_AC, 7);
}

void set_new_long () {
  SetProp(P_LONG, BS(
   "Diese Schienen sind aus vielen kleinen Drachenschuppen gefertigt "+
   "worden. Die Schienen bieteten trotz ihrer unheimlichen Leichtheit "+
   "einen enormen Schutz. Auf einer Schuppe ist der Name '"+creator_name+
   "' eingraviert. Sie schimmern in magischem "+rcol+"."));
}

