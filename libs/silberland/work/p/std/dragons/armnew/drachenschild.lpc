
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include "../dragon_new.h"
inherit D_STD;


create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Drachenschild");

  SetProp(P_NAME, "Drachenschild");
  Set(P_WEIGHT, 1100);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, MALE);
  AddId( ({ "\nschild", "drachenschild", "schild" }) );
  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 25);
}

void set_new_long () {
  SetProp(P_LONG, BS(
    "Dieser Schild ist aus vielen kleinen Drachenschuppen gefertigt "+
    "worden. Er bietet trotz seiner unheimlichen Leichtheit "+
    "einen enormen Schutz. Auf einer Schuppe ist der Name '"+creator_name+
    "' eingraviert. Der Schild schimmert "+rcol+"."));
}

