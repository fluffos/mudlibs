
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include "../dragon_new.h"
inherit D_STD;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Drachenhelm");
  SetProp(P_LONG,
    "Dieser Helm ist aus vielen kleinen Drachenschuppen gefertigt "+
    "worden. Er bietet trotz seiner unheimlichen Leichtheit "+
    "einen enormen Schutz.");

  SetProp(P_NAME, "Drachenhelm");
  Set(P_WEIGHT, 800);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, MALE);
  AddId( ({ "drachenhelm", "helm" }) );
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 12);
}

void set_new_long () 
{
  SetProp(P_LONG, BS(
    "Dieser Helm ist aus vielen kleinen Drachenschuppen gefertigt "+
    "worden. Er bietet trotz seiner unheimlichen Leichtheit "+
    "einen enormen Schutz. Auf einer Schuppe ist der Name '"+creator_name+
    "' eingraviert. Dieser Helm leuchtet "+rcol+"."));
}

