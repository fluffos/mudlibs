
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include "../dragon_new.h"
inherit D_STD;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Drachenbeinschienen");
  SetProp(P_LONG,
    "Diese Schienen sind aus vielen kleinen Drachenschuppen gefertigt "+
    "worden. Die Schienen bieteten trotz ihrer unheimlichen Leichtheit "+
    "einen enormen Schutz."
    );

  SetProp(P_NAME, "Drachenbeinschienen");
  Set(P_WEIGHT, 900);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({ "\nbein", "beinschienen", "drachenbeinschienen"}) );
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 7);
}

void set_new_long () {
  object pl;
  string *s;
  SetProp(P_LONG,BS(
    "Diese Schienen sind aus vielen kleinen Drachenschuppen gefertigt "+
    "worden. Die Schienen bieteten trotz ihrer unheimlichen Leichtheit "+
    "einen enormen Schutz. Auf einer Schuppe ist der Name '"+creator_name+
    "' eingraviert. Sie schimmern in magischem "+rcol+"."));
  if (objectp(pl = find_player(lower_case(creator_name))) &&
      pl->QueryProp(P_GENDER) == FEMALE)
  {
    SetProp(P_NAME, "Drachenschuppenrock");
    if (strstr(QueryProp(P_SHORT), "rock") == -1)
    {
      s = explode(regreplace(QueryProp(P_SHORT), "Drachenbeinschienen", "Drachenschuppenrock", 1),
          " ");
      if (sizeof(s) > 3)
        SetProp(P_SHORT, "Ein " + color()+"er "+s[1]+"r "+s[2]+"r "+implode(s[3..], " "));
    }
    RemoveId( ({"beinschienen", "drachenbeinschienen"}) );
    AddId( ({"drachenschuppenrock", "rock"}) );
    SetProp(P_GENDER, MALE);
    SetProp(P_PLURAL, 0);
    SetProp(P_LONG,BS(
          "Dieser Rock ist aus vielen kleinen Drachenschuppen gefertigt "
          "worden. Er schmiegt sich sanft um die Taille und Hueften seiner "
          "Traegerin und reicht bis knapp ueber die Knie. Dieser "
          "Drachenschuppenrock bietet trotz seiner unheimlichen Leichtheit "
          "einen enormen Schutz. Auf einer Schuppe ist der Name '"+creator_name+
          "' eingraviert. Der Rock schimmert in magischem "+rcol+"."));
  }

}
