int DefendFunc(string dtype, mixed spell, object enemy) {

  if(member(dtype, DT_FIRE)>=0 && defend_fire==1) {
    return( random(QueryProp(P_AC)+defend_value) );
  }
  if(member(dtype, DT_COLD)>=0 && defend_ice==1) {
    return( random(QueryProp(P_AC)+defend_value) );
  }
  if(member(dtype, DT_WATER)>=0 && defend_water==1) {
    return( random(QueryProp(P_AC)+defend_value) );
  }
  if(member(dtype, DT_AIR)>=0 && defend_air==1) {
    return( random(QueryProp(P_AC)+defend_value) );
  }

}

void setcol(string farbe) {
  rcol=farbe;
  AddId(farbe);
  this_object()->set_new_long();
  //SetProp(P_AUTOLOADOBJ, isalo );
  //AddAdjective(farbe);
  //SetProp(P_NAME_ADJ,farbe);
  return;
}

void set_creator_name(string cn) {
  creator_name=cn; 
  this_object()->set_new_long();
}

mixed query_isalo() {
  return (isalo);
}

string color() {
  return(rcol);
}
string query_creator_name() {
  return creator_name; 
}
int _is_drobj() {
  return 1;
}                   

void reset() {
  object ob;
  ::reset();
  ob=this_object();
  while (ob=environment(ob)) {
    if (isalo>0 && interactive (ob) ) {
      if(everlast!=1) isalo--;
    }
  } 
  // SetProp(P_AUTOLOADOBJ, isalo );
  if (isalo<1) {
    Set(P_AUTOLOADOBJ, 0);
    SetProp(P_INFO,
        BS("Es scheint, als wuerde diese Ruestung den naechsten "+
          "Weltuntergang nicht mehr ueberstehen."));
  }
}

//Wargha, irgendwe soitamal _set_autoloadobj ausdocen!!!!!


int _up_count( int i) {
  isalo+=i;
  if (isalo>=31) {
    isalo=30;
    return 0;
  }
  return ( 0 );
}

mixed _query_autoloadobj() {
  if(isalo<=0) 
    return 0;
  return ( ({isalo, rcol, creator_name, setx, sety, setz }) );
}  

void _set_autoloadobj( mixed args ) { 
  object ob;
  ob=QueryProp(P_WORN);
  if (sizeof(args) > 1) {
    isalo=args[0];
    rcol=args[1];
    creator_name=args[2];
    setx=args[3];
    sety=args[4];
    setz=args[5];
  }
  //SetProp (P_X_ATTR_MOD, ([ A_INT:0, A_CON:0, A_DEX:0, A_STR:0 ]));
  //stats=([ A_INT:0, A_CON:0, A_DEX:0, A_STR:0 ]); 
  stats=([]);
  SetProp(P_M_ATTR_MOD, 0);
  if (objectp(ob)) ob->UpdateAttributes();
  setcol (rcol);
  set_type(setx,sety,setz);
  this_object()->set_new_long();
}

int WearFunc(object me) 
{
  if( lower_case(query_creator_name())!=TP->query_real_name() )
  {
    write(BS("Du kannst "+name(WEN,1)+" nicht tragen, weil "+
          QueryPronoun(WER)+" fuer "+ query_creator_name()+
          " angefertigt worden "+
          (QueryProp(P_PLURAL)?"sind":"ist")+"."));
    return 0;
  }
  return 1;
}

int Damage(int dam)
{
  object schuppe;
  if( dam<0 )
  {
    if (!schuppe=deep_present("\nschupp", MENV))
    {
      tell_object(MENV,"Du hast ja gar keine Drachenschuppen zum reparieren!\n");
      return 0;
    }
    if(dam < -QueryProp(P_DAMAGED))
      dam = -QueryProp(P_DAMAGED);
    if (schuppe->QueryProp(P_AMOUNT)<-dam)
      dam=-schuppe->QueryProp(P_AMOUNT);
    schuppe->AddAmount(dam);
  }
  return ::Damage(dam);
}

