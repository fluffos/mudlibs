#ifndef P_NODONATE
#define P_NODONATE "nodonate"
#endif

mapping stats = ([ ]);  // A_INT:0, A_CON:0, A_DEX:0, A_STR:0 ]);
int defend_value = 10;

string *std_types = 
({ 
 ({"der Haerte","func_main_ac"}),
 ({"der Propheten","func_main_stat"}),
 ({"der Unsterblichen","func_main_reboot_save"}),
 ({"der Hexerei","func_main_mp"}),
 ({"der Baeren","func_main_hp"}),
 });

string *bon_types = 
({ 
 ({"feste","beschlagene","func_bonus_ac"}), 
 ({"heilige", "gesalbte","func_bonus_stat"}),
 ({"energiegeladene", "magische","func_bonus_mp"}),
 ({"berserkende", "starke","func_bonus_hp"}),
 ({"glitschige", "gehuellte","func_defend_fire"}),
 ({"strahlende", "flammende","func_defend_ice"}),
 ({"glatte", "beschichtete","func_defend_water"}),
 ({"stromlinige", "luftige","func_defend_air"}),
 ({"gewuchtete", "krallenbesetzte","func_light_weight"}),
 ({"durchloecherte", "strohueberzogene","func_heat_defense"}),
 ({"klirrende", "fellumgebene","func_cold_defense"}),
 ({"unverwuestliche", "diamantene","func_indestructable"}),
 ({"anschmiegsame", "koerperfoermige","func_noloose"}), 
 });

string rcol;
string creator_name="";
int defend_fire=0,defend_ice=0,defend_water=0,defend_air=0;
int statmods = 0;
int mpmods = 0;
int hpmods = 0;
int isalo = 30;
int everlast = 0; //Wird nie zerstoert
int setx;
int sety;
int setz;

void setcol(string farbe);
string color();
void modify_stat(string what, int value);
string query_creator_name();

void create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Drachenruestung");
  SetProp(P_LONG,
      "Diese Ruestung ist aus vielen kleinen Drachenschuppen gefertigt "+
      "worden. Diese Ruestung bietet trotz ihrer unheimlichen Leichtheit "+
      "einen enormen Schutz."
      );

  SetProp(P_NAME, "Drachenruestung");
  SetProp(P_NODONATE, 1);
  SetProp(P_NOBUY,1);
  SetProp(P_NOSELL,1);
  SetProp(P_GENDER, FEMALE);
  Set(P_WEIGHT, 500);
  SetProp(P_DEFEND_FUNC, this_object() );
  //  SetProp(P_AUTOLOADOBJ,isalo);
  SetProp(P_MATERIAL, MAT_HORN);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );
  SetProp(P_NOSELL, "Nein, davon moechtest Du Dich nicht trennen.\n");
  SetProp(P_INFO, BS("Es scheint als wuerde diese Ruestung sogar den "
        "naechsten Weltuntergang unbeschadet ueberstehen.\n"));
  AddId( /*"HELM",*/ "drachenruestung" );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_QUALITY_DECAY, 333);
}

string set_type(int x, int y, int z){

  if(!color()) return "No Color set!";
  if(y==z) return "Dubble stat not allowed!";
  if(!query_creator_name()) return "Creator Name not set!";
  if(this_object()->QueryProp(P_GENDER)==2 && !QueryProp(P_PLURAL)) 
    SetProp(P_SHORT,"Eine "+color()+"e "+bon_types[y][0]+" "+bon_types[z][1]+
        " "+this_object()->QueryProp(P_NAME)+" "+std_types[x][0]);
  if(this_object()->QueryProp(P_GENDER)==1 && !QueryProp(P_PLURAL)) 
    SetProp(P_SHORT,"Ein "+color()+"er "+bon_types[y][0]+"r "+bon_types[z][1]+
        "r "+this_object()->QueryProp(P_NAME)+" "+std_types[x][0]);
  if(this_object()->QueryProp(P_PLURAL))  
    SetProp(P_SHORT,capitalize(color())+"e "+bon_types[y][0]+" "+bon_types[z][1]+
        " "+this_object()->QueryProp(P_NAME)+" "+std_types[x][0]); 

  call_out(std_types[x][1],0); 
  call_out(bon_types[y][2],2); 
  call_out(bon_types[z][2],4); 
  setx=x;
  sety=y;
  setz=z;

  return "Armor Built...";
}


void func_main_ac()
{
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)] );
  SetProp(P_MATERIAL, ([MAT_HORN:70, MAT_IRON:30]) );
  return;
}


void func_main_stat()
{
  string farbe;
  if(!color()) return;
  farbe=color();
  stats=([]);           // initialize to prevent inconsistency (woody)
  if (farbe=="rot") {
    modify_stat("str",1);
    statmods=1;
    return;
  }
  if (farbe=="blau") {
    modify_stat("int",1);
    statmods=1;
    return;
  }
  if (farbe=="gruen")
  {modify_stat("con",1);
    statmods=1;
    return;
  }
  if (farbe=="weiss")
  {modify_stat("dex",1);
    statmods=1;
    return;
  }
}

void func_main_reboot_save()
{
  everlast=1;
  return;
}

void func_main_mp()
{
  if (mappingp(QueryProp(P_M_HEALTH_MOD)))
    SetProp(P_M_HEALTH_MOD,([P_HP:QueryProp(P_M_HEALTH_MOD)["hp"],P_SP:5]));
  else
    SetProp(P_M_HEALTH_MOD,([P_HP:0,P_SP:5]));
  return;
}

void func_main_hp()
{ 
  if (mappingp(QueryProp(P_M_HEALTH_MOD)))
    SetProp(P_M_HEALTH_MOD,([P_HP:5,P_SP:QueryProp(P_M_HEALTH_MOD)["sp"]]));
  else
    SetProp(P_M_HEALTH_MOD,([P_HP:5,P_SP:0]));
  return;
}


void func_defend_fire()
{
  defend_fire=1;
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_FIRE:1]));
  return;
}

void func_defend_ice()
{
  defend_ice=1;
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_COLD:1]));
  return;
}

void func_defend_water()
{
  defend_water=1;
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_WATER:1]));
  return;
}

void func_defend_air()
{
  defend_air=1;
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_AIR:1]));
  return;
}

void func_light_weight()
{
  int x;
  x=this_object()->QueryProp(P_WEIGHT);
  x=x/4;
  this_object()->Set(P_WEIGHT,x);
  this_object()->Set(P_TOTAL_WEIGHT,x);
  return;
}

void func_indestructable()
{
  AddId("NODESTRUCT");
  SetProp(P_QUALITY_DECAY, 5000);
  return;
}

void func_noloose()
{
  SetProp(P_NEVERDROP,1);
  return;
} 

void func_heat_defense()
{
  SetProp( P_TEMPERATURE_PROTECTION, 
      ([ T_COLD_PROT:QueryProp(P_TEMPERATURE_PROTECTION)[T_COLD_PROT]+1,
         T_HEAT_PROT:QueryProp(P_TEMPERATURE_PROTECTION)[T_HEAT_PROT]+4 ]) );
  return;
}

void func_cold_defense()
{
  SetProp( P_TEMPERATURE_PROTECTION, 
      ([ T_COLD_PROT:QueryProp(P_TEMPERATURE_PROTECTION)[T_COLD_PROT]+4,
         T_HEAT_PROT:QueryProp(P_TEMPERATURE_PROTECTION)[T_HEAT_PROT]+1 ]) );
  return;
}

void func_bonus_hp()
{ 
  int x;

  if (mappingp(QueryProp(P_M_HEALTH_MOD)))
  {
    if(QueryProp(P_M_HEALTH_MOD)["hp"]) x=10; else x=0;
    SetProp(P_M_HEALTH_MOD,([P_HP:5+x,P_SP:QueryProp(P_M_HEALTH_MOD)["sp"]]));
  }
  else
    SetProp(P_M_HEALTH_MOD,([P_HP:5,P_SP:0]));
}

void func_bonus_mp()
{
  int x;

  if (mappingp(QueryProp(P_M_HEALTH_MOD)))
  {
    if(QueryProp(P_M_HEALTH_MOD)["sp"]) x=10; else x=0;
    SetProp(P_M_HEALTH_MOD,([P_HP:QueryProp(P_M_HEALTH_MOD)["hp"],P_SP:5+x]));
  }
  else
    SetProp(P_M_HEALTH_MOD,([P_HP:0,P_SP:5]));
}

void func_bonus_ac()
{
  SetProp(P_AC, VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)]-1 );
  SetProp(P_MATERIAL, ([MAT_HORN:70, MAT_IRON:30]) );
  return;
}

void func_bonus_stat()
{ 
  string farbe;
  int x;

  if(!color()) return;
  farbe=color();


  if(statmods) x=1; else x=0;

  //tell_object(find_player("lamuerte"),"MMMMMMM"+x+"\n");
  stats=([]);           // initialize to prevent inconsistency (woody)
  if (farbe=="rot") {
    modify_stat("str",x+1);
    return;
  }
  if (farbe=="blau") {
    modify_stat("int",x+1);
    return;
  }
  if (farbe=="gruen")
  {modify_stat("con",x+1);
    return;
  }
  if (farbe=="weiss")
  {modify_stat("dex",x+1);
    return;
  }
}



//void query_neverdrop() {
//  return QueryProp(P_AUTOLOADOBJ);
//}

void set_resist(int value) { 
  defend_value = value;
  return;
}   

int modify_stat(string what, int value) { 
  stats[what]=value;
  SetProp(P_M_ATTR_MOD, stats);
  return stats[what];
}

