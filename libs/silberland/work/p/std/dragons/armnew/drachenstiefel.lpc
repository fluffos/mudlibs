
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include "../dragon_new.h"
inherit D_STD;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Drachenstiefel");

  SetProp(P_NAME, "Drachenstiefel");
  Set(P_WEIGHT, 1000);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY,1);
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 1);
  AddId( ({ "\nstiefel", "stiefel", "drachenstiefel"}) );
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 7);
}

void set_new_long () {
  object pl;
  SetProp(P_LONG, BS(
    "Diese Stiefel sind aus vielen kleinen Drachenschuppen gefertigt "+
    "worden. Die Stiefel bieteten trotz ihrer unheimlichen Leichtheit "+
    "einen enormen Schutz. Auf einer Schuppe ist der Name '"+creator_name+
    "' eingraviert. Sie schimmern "+rcol+"."));
}

