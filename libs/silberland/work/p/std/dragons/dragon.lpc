#pragma strong_types

inherit "/std/mnpc";

#include <properties.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>
#include <combat.h>
#include <new_skills.h>
#include "dragon.h"
#ifndef AddProp
#define AddProp(x,y) SetProp(x, QueryProp(x)+y)
#endif

ENVCHECKPROC

nosave int _set_level(int arg);
int do_no_breath_spell(object liv);
void breath_spell();
int breathdamage, dragonage, dragontype, dragonalign, counter, spellrate;

void create() 
{ 
  if(!is_clone(this_object())) return;
  ::create();
  AddId(({"drache", "STD_Dragon", "NOWIMPY", "NOCONTROL", "NO_MUMMY", 
        "NOFALLDOWN"}));
  SetProp(P_NAME,"Drache");
  SetProp(P_LONG,
      "Du erschauderst vor Ehrfurcht, als Dir der riesige Drache "
      "in die Augen blickt und Dampf aus seinen Nuestern blaest. "
      "Er ist ueber und ueber mit Schuppen bedeckt, die die meisten "
      "Zauber und den meisten physischen Schaden abwehren. Seine "
      "Klauen sind so gross wie ein Kurzschwert und so scharf, dass "
      "sie alles zerreissen koennen, was in ihre Naehe kommt. Sein "
      "Schwanz laeuft in eine gefaehrliche Hornspitze aus, die schon "
      "so manchen Helden, der sich zuviel zutraute, in zwei Haelften "
      "geteilt hat.");
  
  SetProp(P_MSGIN, "kommt an.\nDu zitterst am ganzen Leib");
  SetProp(P_MSGOUT, "geht#.\nDir faellt ein Stein vom Herzen");
  SetProp(P_MMSGIN, "wird sichtbar");
  SetProp(P_MMSGOUT, "verschwindet vor Deinen Augen");
  SetProp(P_GENDER, MALE );
  SetProp(P_RACE, "Drache");
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_TEMPERATURE_RANGE, ([0:-100, 1:500]));
  SetProp(P_TRANSPARENT, 0);
}

void create_default_dragon(int level,int age,int align,int scales) 
{ 
  string *alter, *alter2, *farbe, *d_items;
  int prob, *chances;
  object *inv, ob;  
  string shorttxt;
  mixed color;
  int hands;

  if (level < 0 || level > 5) level = 1;
  if (age < 0 || age > 12) age = 1;
  if (align < 0 || align > 2) align = 2;
  
  dragontype = level;
  dragonalign = align;
  dragonage= age;
  create_default_npc(25 + level * 2 + age * 2);
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP) + age * 100);
  hands = 250 + level * 10 + age * 45;
  SetProp(P_HANDS, ({" mit " + QueryPossPronoun(FEMALE, WEM, PLURAL) + " Klauen", 
        hands, DT_RIP }) );
  SetProp(P_BODY, (250 + (level * 10) + (age * 25)));
  SetProp(P_XP, QueryProp(P_MAX_HP) * hands * 5  / 100 * (111 + level + age * 4) );
  SetProp(P_HP_DELAY, 2 - age / 5);
  SetProp(P_TRANSPARENT, 0);
  
  SetProp(P_WEIGHT, 500000 + 150000 * age + 40000 * level);
  SetProp(P_SIZE, 300+ level * 50 + age * 50);
  spellrate = 20 + level * 2 + age * 3;
  Set(P_SPELLRATE, spellrate);
  alter = ({ "jung", "erwachsen", "alt", "steinalt"});
  alter2= ({ "kundig", "erfahren", "weis"});
  farbe= ({({"schwarz", "weiss", "gruen", "blau", "rot"}),
           ({"kupfern", "bronzen", "messing", "silbern", "golden"}),
           ({"amethyst", "smargad", "saphir", "rubin", "diamant"}) }); 
  shorttxt = "Ein " + alter[(age-1)/3] + "er " + alter2[age%3] + "er ";

  if (QueryProp(P_NAME) == "Drache")
  {
    if (dragontype)
    {
      color = farbe[align][level-1];
      if (align==0 || align==1)
      {
        SetProp(P_SHORT,shorttxt + color + "er Drache"); 
        SetProp(P_NAME_ADJ, color );
      }
      else
      {
        SetProp(P_SHORT, shorttxt + CAP(color) + "drache");
        SetProp(P_NAME, CAP(color) + "drache");
      }
    }
    else
    {
      color = "";
      SetProp(P_SHORT, shorttxt + "Drache");
    }
    AddAdjective( ({alter[(age-1)/3]+"er", alter2[age%3]+"er", color+"er"}) ); 
  }
  if (align == 0)
  {
    SetProp(P_ALIGN, -((age/2+1)*150));
    SetProp(P_RESISTANCE_STRENGTHS, ([DT_HOLY:0.2-age/60., DT_UNHOLY:-0.4-age/40.]) );
  }
  else if (align == 1) 
  {
    SetProp(P_ALIGN,  ((age/2+1)*150));
    SetProp(P_RESISTANCE_STRENGTHS, ([DT_HOLY:-0.4-age/40., DT_UNHOLY:0.2-age/60.]) );
  }
  else if (align == 2) 
  {
    SetProp(P_ALIGN,  0);
    SetProp(P_RESISTANCE_STRENGTHS, 
        ([DT_HOLY:-0.2-age/40., DT_UNHOLY:-0.2-age/40.]) );
  }

  AddProp(P_RESISTANCE_STRENGTHS, 
      ([DT_FIRE      :-0.5-age/30.,    DT_COLD      :-0.2-age/40., 
        DT_WATER     :-0.2-age/40.,    DT_AIR       :-0.2-age/40., 
        DT_LIGHTNING :-0.2-age/40.,    DT_EXPLOSION :-0.1-age/40.,   
        DT_SOUND     :-0.2-age/60.,    DT_LIGHT     :-0.3-age/60., 
        DT_ELECTRIC  :-0.2-age/40.,    DT_ACID      :-0.1-age/40., 
        DT_POISON    :-0.2-age/40.,    DT_TERROR    :-0.9,   
        DT_MAGIC     :-0.6-age/60.,    DT_MIND      :-0.1-age/60.,
        DT_PIERCE    :0.2]));   
  SetProp(P_NOMAGIC, 3 + age * 4 + level * 3); 
  if (align == 0) 
  {
    switch (level) 
    {   
      case 1:
        AddSpell(4,70*age+100,
          Name(WER,1)+" speit Dir eine Saeurewolke entgegen.\n",
          Name(WER,1)+" speit @WEN mit einer Saeurewolke an.\n",
          ({DT_ACID}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_ACID:-1, DT_AIR:0.5-age/25.]) );
        break;
      case 2: 
        AddSpell(4,90*age+90,
          Name(WER,1)+" speit Dir eine Eiswolke entgegen.\n",
          Name(WER,1)+" speit @WEN mit einer Eiswolke an.\n",
          ({DT_COLD}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_COLD:-1, DT_FIRE:0.5-age/25.]) );
        break;
      case 3:    
        AddSpell(4,110*age+80,
          Name(WER,1)+" speit Dir eine Giftwolke entgegen.\n",
          Name(WER,1)+" speit @WEN mit einer Giftwolke an.\n",
          ({DT_POISON}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_POISON:-1, DT_LIGHTNING:0.5-age/25.]) );
        break;
      case 4:
        AddSpell(4,130*age+70,
          Name(WER,1)+" speit Dir einen Blitz entgegen.\n",
          Name(WER,1)+" speit @WEN mit einem Blitz an.\n",
          ({DT_LIGHTNING}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_LIGHTNING:-1, DT_ELECTRIC: -1, DT_WATER:0.5-age/25.]) );
        break;
      case 5:    
        AddSpell(4,150*age+60,
          Name(WER,1)+" speit Dir eine Flammenwolke entgegen.\n",
          Name(WER,1)+" speit @WEN mit einer Flammenwolke an.\n",
          ({DT_FIRE}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_FIRE:-1, DT_COLD:0.5-age/25.]) );
    }
  }
  else if (align == 1)
  {
    switch (level)
    {
      case 1:
        AddSpell(4,70*age+100,
          Name(WER,1)+" speit Dir eine Saeurewolke entgegen.\n",
          Name(WER,1)+" speit @WEN mit einer Saeurewolke an.\n",
          ({DT_ACID}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_ACID:-1, DT_FIRE:0.5-age/25.]) );
        break;
      case 2:    
        AddSpell(4,90*age+90,
          Name(WER,1)+" speit Dir einen Wirbelsturm entgegen.\n",
          Name(WER,1)+" speit @WEN einen Wirbelsturm entgegen.\n",
          ({DT_AIR}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_AIR:-1, DT_ACID:0.5-age/25.]) );
        break;
     case 3: 
       AddSpell(4,110*age+80,
         Name(WER,1)+" speit Dir eine Flutwelle entgegen.\n",
         Name(WER,1)+" speit @WEN eine Flutwelle entgegen.\n",
         ({DT_WATER}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_WATER:-1, DT_LIGHTNING:0.5-age/25.]) );
       break;
     case 4: 
       AddSpell(4,130*age+70,
         Name(WER,1)+" speit Dir einen Blitz entgegen.\n",
         Name(WER,1)+" speit @WEN mit einen Blitz an.\n",
         ({DT_LIGHTNING}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_LIGHTNING:-1, DT_ELECTRIC: -1, DT_WATER:0.5-age/25.]) );
       break;
     case 5:
       AddSpell(4,150*age+60,
         Name(WER,1)+" speit Dir eine Feuerwolke entgegen.\n",
         Name(WER,1)+" speit @WEN mit einer Feuerwolke an.\n",
         ({DT_FIRE}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_FIRE:-1, DT_COLD:0.5-age/25.]) );
    }
  }
  else if (align == 2)
  {
    switch (level)
    {
      case 1:
        AddSpell(4,70*age+100,
          Name(WER,1)+" bruellt Dich ganz laut an.\n",
          Name(WER,1)+" bruellt @WEN ganz laut an.\n",
          ({DT_SOUND}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_SOUND:-1, DT_EXPLOSION:0.5-age/25.]) );
        break;
      case 2:    
        AddSpell(4,90*age+90,
          Name(WER,1)+" speit Dir eine Giftwolke entgegen.\n",
          Name(WER,1)+" speit @WEN mit einer Giftwolke an.\n",
          ({DT_POISON}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_POISON:-1, DT_LIGHTNING:0.5-age/25.]) );
        break;
     case 3: 
       AddSpell(4,110*age+80,
          Name(WER,1)+" speit Dir eine Eiswolke entgegen.\n",
          Name(WER,1)+" speit @WEN mit einer Eiswolke an.\n",
          ({DT_COLD}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_COLD:-1, DT_FIRE:0.5-age/25. ]) );
       break;
     case 4: 
       AddSpell(4,130*age+70,
         Name(WER,1)+" speit Dir eine Feuerwolke entgegen.\n",
         Name(WER,1)+" speit @WEN mit einer Feuerwolke an.\n",
         ({DT_FIRE}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_FIRE:-1, DT_WATER:0.5-age/25.]) );
       break;
     case 5:
       AddSpell(4,150*age+60,
         Name(WER,1)+" laesst Dich explodieren.\n",
         Name(WER,1)+" laesst Dich explodieren.\n",
         ({DT_EXPLOSION}),([SP_SHOW_DAMAGE:1]));
        AddProp(P_RESISTANCE_STRENGTHS, 
            ([DT_EXPLOSION:-1, DT_AIR:0.5-age/25.]) );
    }
  }
  breathdamage=(150+(age*25)+(level*10));
//  Drachenatem besser im Heart-beat!  
//  AddSpell(1,1,
//   Name(WER,1)+" spuckt Feuer in den ganzen Raum und zerstoert Deine Ruestung.\n",
//   Name(WER,1)+" spuckt Feuer in den ganzen Raum und zerstoert Deine Ruestung.\n",
//    ({DT_FIRE}),"breath_spell");
  AddSpell(2,300+level*25+age*50, 
    Name(WER,1)+" greift Dich mit "+QueryPossPronoun(MALE, WEM)+" langen Schwanz an.\n",
    Name(WER,1)+" greift @WEN mit "+QueryPossPronoun(MALE, WEM)+" langen Schwanz an.\n",
    ({DT_BLUDGEON}),([SP_SHOW_DAMAGE:1]) );
  
  seteuid(getuid(this_object()));

  if (scales > (level * 2 + age * 2)) 
    scales = level * 2 + age * 2;
  ob = clone_object(D_OBJ("schuppe"));
  ob->AddAmount(scales / 2 + random(scales));
  ob->move(TO);

  switch (random(14))
  {
    case 0:
      "/obj/gemmaster"->DistributeGem(age/4,(level+age)/3,1,1);
      break;
    case 1:
      "/obj/pearlmaster"->DistributePearl(age/4,(level+age)/3,1,1);
      break;
    case 2:
      if(random(scales)>5)
        clone_object("/p/std/skills/sewing_tanning/obj/magieseide")->move(TO);
      if(random(scales)>10)
        clone_object("/p/std/skills/sewing_tanning/obj/magieseide")->move(TO);
      if(random(scales)>15)
        clone_object("/p/std/skills/sewing_tanning/obj/magieseide")->move(TO);
      break;
    default:   
      "/obj/gemmaster"->DistributeGem(age/8,(level+age)/6,1,1);
      "/obj/pearlmaster"->DistributePearl(age/8,(level+age)/6,1,1);
  }
  
  ob=clone_object("/p/magic/magiestein");
  ob->AddAmount(age/4 + random((level+age)/5));
  ob->move(TO);

  d_items=({"/p/armour/amulet/amulett",
            "/p/armour/ring/ring",
            "/p/armour/belt/guertel"});
  switch (level + age * 3) 
  {
    case  3..14: prob=750; chances=0; break;
    case 15..21: prob=30; chances=({3000,8000,9500,9999,10000}); break;
    case 22..29: prob=15;  chances=({3000,4000,9200,9998,10000}); break;
    case 30..41: prob=10;  chances=({1000,2000,6000,9990,10000}); break;
    default: prob=100; chances=0;
  }
  if (!random(prob))
  {
    ob = clone_object(d_items[random(sizeof(d_items))]);
    ob->SetProp(P_CURSED, 0);
    if(find_object(ITEMD))
      find_object(ITEMD)->identify(ob,-1,0,0,chances,1);
    ob->move(TO);
  }
  
  if (random((age + level) * age) >= 123 && !random(20))
  {
    ob = clone_object(DRACHENLANZENTEIL);
    ob->move(TO);
    log_file(DRACHENLANZENLOG,sprintf("[%s](Level %d) %s :%s (%d)\n",
          dtime(time()),QueryProp(P_LEVEL),file_name(this_object()),
          ob->QueryProp(P_SHORT),ob->QueryProp(P_MAGIC))); 
  }
  return;
} 

void init()
{
  ::init();
  if (this_player() && this_player()->QueryProp("dragon_enemy") > time() &&
      !IS_LEARNING(this_player()))
    Kill(this_player());
}

void heart_beat()
{
  ::heart_beat();
  if (++counter >= 2 + random(3))
  {
    if (InFight()) 
      breath_spell();
    counter=0;
  }
}

int do_no_breath_spell(object liv) 
{
  if (!objectp(liv)) return 0;
  if (!living(liv)) return 0;
  if (IS_LEARNING(liv)) return 0;
  if (liv->id("drache")) return 0;
  if (!query_once_interactive(liv) && !IsEnemy(liv)) return 0;
  return 1;
}

void breath_spell()
{
  int i,j;
  object *inv; 
  object *armours;
  
  tell_room(MENV, Name(WER,1)+" spuckt Feuer in den ganzen Raum "
      "und zerstoert Deine Ruestung.\n");
  inv=filter_array(all_inventory(environment(this_object())), #'do_no_breath_spell );
  for (i = sizeof(inv) - 1; i >= 0; i--) 
  {
    if (sizeof(armours=inv[i]->QueryProp(P_ARMOURS)) ) 
    {
      for (j = sizeof(armours) - 1; j >= 0; j--)
      {
        if( !random(4) && objectp(armours[j]) && armours[j]->QueryProp(P_AC) && 
            !armours[j]->id("drachenruestung") && 
            armours[j]->QueryProp(P_QUALITY_DECAY) )
          armours[j]->TakeFlaw(5 + random(dragonage * (dragontype + 5) / 3));
      }
    }
    inv[i]->Defend(breathdamage / 2 + random(breathdamage / 2), DT_FIRE, 
        ([SP_SHOW_DAMAGE:1,SP_NAME:"Dragonbreath"]), this_object());
  }
  return;
}

void die(int poisondeath)
{
  object item;
  if (dragonage > 4 &&   
      (item=present("\ndrachenquest", TP)) )
             item->add_dragon_kill(dragontype, dragonalign);
  write_file("/log/npc/drachen",
     ctime()+": "+this_player()->Name(WER)+" killt "+ name(WEN)+ " " +
     "(Alter: "+dragonage+", Typ: "+dragontype+", Align: "+dragonalign+").\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/log/npc/drachen",
    ctime()+": "+Name(WER)+"(Alter: "+dragonage+") hat gerade "+
    player->name(WEN)+ " umgebracht.\n");
}

varargs void ModifySkillAttribute(object caster, string atrname, int value, 
    int duration, mixed fun)
{
  if ((atrname == SA_SPEED || atrname == SA_QUALITY) && value < 44 + 3 * dragonage)
    value = 44 + 3 * dragonage;
  ::ModifySkillAttribute(caster, atrname, value, duration, fun);
}

int _set_spellrate() { return spellrate; }
int _query_frog() { return 0; }
int _query_blind() { return 0; }
int _query_poison() { return 0; }
int _query_wimpy() { return 0; }

