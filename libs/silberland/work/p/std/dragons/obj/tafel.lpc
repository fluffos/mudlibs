#include <properties.h>
#include <language.h>
inherit "/std/thing";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine Tafel");
  SetProp(P_LONG,"Auf diese Tafel hat Haegar was raufgemalt. Lies doch mal!\n");
  AddId(({"tafel", "tafle"}));
  SetProp(P_NAME, "Tafel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOGET, "Die Tafel ist unverrueckbar.\n");
  SetProp(P_WEIGHT, 1200);

 AddReadDetail ("tafel",

    "\n    ____________________________________________\n"
      "   |  Halli Hallo meine Freunde der Schuppen!!  | \n"
      "   |  ----------------------------------------  | \n"     
      "   |                                            | \n"
      "   |  Da ihr mich in letzter Zeit kaum noch     | \n"
      "   |  mit Arbeit eindeckt, reduzierte ich nun   | \n"
      "   |  kurzfristig die Preise meiner original    | \n"
      "   |  Drachenruestungsteile. Nundenn, macht     | \n"
      "   |  schnell, denn wer weiss, wie lange diese  | \n"
      "   |  einalig billige Aktion noch aufrecht      | \n"
      "   |  sein wird.                                |\n"
      "   |                                            | \n"
      "   |  PS: Probiert mal kontrolliere und         | \n"
      "   |      erneuere. Geht aber nur bei           | \n"
      "   |      NEUEN Drachenruestungen!              | \n"
      "   |      Preis: 5 Schuppen 5000 Muenzen        | \n"
      "   |       fuer 5-15 Online Stunden.            | \n"
      "   |                                            | \n"
      "   |                                            | \n"
      "   |                        MfG.                | \n"
      "   |                           Haegar           | \n"
      "   |_________________          _________________| \n"
      "                     |        |\n\n");

}

