inherit "std/unit";

#pragma strong_types

#include <properties.h>
#include <language.h>
#include "../dragon.h"

int _set_autoloadobj( mixed args )
{
  if (pointerp(args))
    args=args[0];
  if (stringp(args))
    args=to_int(args);
  if (!intp(args))
    return 0;
  return (int) SetProp(P_AMOUNT,args);
}

int _query_autoloadobj()
{
  return (int) QueryProp(P_AMOUNT);
}

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  SetProp(P_NAME,({"Drachenschuppe","Drachenschuppen"}));
  SetProp(P_SHORT,"Drachenschuppe");
  AddSingularId("schuppe");
  AddPluralId("schuppen");
  AddSingularId("drachenschuppe");
  AddPluralId("drachenschuppen");
  AddId("\nschupp");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_MATERIAL, MAT_HORN);
  SetCoinsPerUnits(1,0);
  SetGramsPerUnits(1,8);
}
