
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();   

SetProp(P_SHORT, "Ein mit Mithrilplatten gepanzertes Riesenfell");
SetProp(P_NAME, "Riesenfell");
SetProp(P_GENDER, NEUTER);
SetProp(P_NAME_ADJ, "mithrilgepanzert");
AddId(({"riesenfell","fell", "\ngiant_fur"}));
SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
SetProp (P_MATERIAL, ([MAT_FUR:50, MAT_MITHRIL:50]));     
SetProp(P_AC, 1); //wird erst aus dem riesen heraus gesetzt

AddDetail(({"platten","mithril","mithrilplatten"}),
"Die Mithrilplatten geben sehr guten Schutz.");

}

