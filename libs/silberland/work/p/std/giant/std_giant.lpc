void nimm_alles() {
  if(present("leiche", environment(TO))) {
	  command("nimm alles aus leiche");
  } 
}


 void spell_all(object enemy,int damage,mixed dam_type)
    {
      int i;
         object *inv;
      inv=PresentEnemies();
             damage=random((1000)+500);
                         damage/=sizeof(inv);
        tell_room(ENV(ME), BS("Der Riese pruegelt Dich fast zu Tode!!!\n"));
          for(i=sizeof(inv)-1;i>=0;i--)
                  {
         tell_object(inv[i], "Du geraetst in aergste Bedraengniss!!!\n");
          inv[i]->Defend(damage, dam_type,
      ([SP_SHOW_DAMAGE:1,SP_NAME:"Riese"]), this_object());
     }
   }
   
   
   
   
 void spell_speed(object enemy,int damage,mixed dam_type)
    {
      int i;
         object *inv;
      inv=PresentEnemies();
       TO->ModifySkillAttribute(this_object(),SA_SPEED,500,4+random(4));
             damage=random((1000)+500);
                         damage/=sizeof(inv);
        tell_room(ENV(ME), BS("Der Riese pruegelt wie irr auf Dich ein!!!\n"));
          for(i=sizeof(inv)-1;i>=0;i--)
                  {
         tell_object(inv[i], "Du geraetst in aergste Bedraengniss!!!\n");
          inv[i]->Defend(damage, dam_type,
      ([SP_SHOW_DAMAGE:1,SP_NAME:"Riese"]), this_object());
     }
   }
   
   
   
   