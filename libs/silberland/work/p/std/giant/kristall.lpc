/*
Die Magiekristalle der Riesen
dante sl 2000
*/

inherit "std/unit";
#pragma strong_types
#include <properties.h>
#include <language.h>

void _set_autoloadobj( mixed args )
{
  if (pointerp(args))
    args=args[0];
  if (stringp(args))
    sscanf(args,"%d",args);
  if (!intp(args))
    args=0;
  SetProp(P_AMOUNT,args);
}

int _query_autoloadobj()
{
  return (int) QueryProp(P_AMOUNT);
}

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  SetProp(P_NAME,({"Magiekristallsplitter","Magiekristallsplitter"}));
  SetProp(P_SHORT,"Ein Magiekristallsplitter");
  SetProp(P_LONG, break_string(
  "Du siehst hier einen kleinen, magischen Kristallsplitter. Urspruenglich waren nur "
  "die Riesen dieser Welt in seinem Besitz. Er leuchtet und funkelt "
  "wunderschoen und beinhaltet wunderbare, magische Kraefte. "
  "Angeblich bauten die Riesen vor vielen tausenden Jahren Kristall in einem Bergwerk "
  "tief unter der Oberflaeche ab."));
  
  
  SetProp(P_INFO, break_string(
  "Der magische Kristallsplitter keonnte Dir wertvolle Dienste erweisen."));
  
  AddSingularId("splitter");
  AddPluralId("splitter");
  AddSingularId("magiekristallsplitter");
  AddPluralId("magiekristallsplitter");
  AddSingularId("kristallsplitter");
  AddPluralId("kristallsplitter");
  AddSingularId("kristall");
  AddPluralId("kristalle");
  AddSingularId("magiekristall");
  AddPluralId("magiekristalle");
  AddId("\nmagie_kristall_splitter");
  SetProp(P_GENDER,MALE);
  SetCoinsPerUnits(1,0);
  SetGramsPerUnits(1,5);
}
