int access_rights(string name, string file, int readflag, int def)
{
  name=lower_case(name);

  if (name=="gwenshara") return 1;      // auch access_rights.c
  if (file=="access_rights.lpc") return 0;
  if (readflag) return 1;               // allgemeines Leserecht

  if (name=="delgo" && file[0..13]=="default_ranger") return 1;
  return 0;
}
