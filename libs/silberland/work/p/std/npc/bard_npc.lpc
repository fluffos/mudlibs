#include "/gilden/bardengilde/bardengilde.h"
#include <properties.h>
#include <new_skills.h>
#include <combat.h>
#include <food.h>
#include <moving.h>
inherit "std/mnpc";

private string bardGroup;

public void create() {
    if(!is_clone(TO)) return;
    ::create();
} 

public void Attack(object enemy) {
    int gs;

    gs = QueryProp(P_GUILD_LEVEL);
    if(time() > QueryProp(P_NEXT_SPELL_TIME) && !random(3) && present(SONG_SMALL_AURA)) {
        aura->damage("");
    }

    if(!QueryProp(P_TMP_BARDS_ZAUBERMELODIE) && !random(2))

    if(objectp(enemy)) {
        ::Attack(enemy);
    }
}

private void enable_aura() {
    object aura;

    if(!present(SONG_SMALL_AURA, this_object())) {
        aura = clone_object(OBJ("aura"));
        aura->move(TO, M_NOCHECK);
        aura->load(TO, bardGroup, (5+QueryProp(P_GUILD_LEVEL)+random(10))*2, 0.0));
    }
}

private void init_buffs() {
    int gs = QueryProp(P_GUILD_LEVEL);

    AddSpell("")
    
    if(gs > 2) {
        ode_an_die_sterne();
    }

    if(gs > 3) {
        enable_aura();
    }

}

varargs void create_default_bard_npc(int level, int glevel, string group, int maxhp)
{
    if(intp(maxhp))
        create_default_npc(level, maxhp);
    else
        create_default_npc(level);

    if(group != BARD_GROUP_ALESTRA && 
       group != BARD_GROUP_TIRNEA &&
       group != BARD_GROUP_KORRIAX &&
       group != BARD_GROUP_SARRIAN) {
           raise_error("Ilegal bard group");
           return;
    }

    SetProp(P_XP, QueryProp(P_XP) * 4 / 3);
    SetProp(P_HANDS,
        ({" mit seinen Haenden",
         QueryProp(P_HANDS)[1],
        ({DT_BLUDGEON}) }));
  
    if(glevel < 1) glevel = 1;
    if(glevel > 15) glevel = 15;
    SetProp(P_GUILD, "bardengilde");
    SetProp(P_GUILD_LEVEL, glevel);
    AddId( ({"\nbarden_npc", "NOWIMPY", "NOCONTROL"}) );
    SetProp(P_RESISTANCE_STRENGTHS, ([DT_SOUND: -0.5]) );
  
    seteuid(geteuid(this_object()));
    clone_object("/gilden/bardengilde/armour/bbrosche")->move(this_object());
    command("trage alles");
    init_buffs();
}