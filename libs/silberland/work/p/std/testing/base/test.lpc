/*
This is the base class for all tests.

It provides the runTests() function that will execute all tests that are
implemented in this class and provide an according output.
*/

#include <functionlist.h>
#include "../testing.h"

#define cl(x) #'x
#define bool int

inherit "/p/std/testing/base/assertions";

private nosave mapping results;
private string currentFunction;

public void create() {
    results = ([ ]);
}

private bool isTestFunctionName(string functionName) {
    return lower_case(functionName[0..3]) == "test";
}

private string *getTestFunctions() {
    string *functions;
    
    functions = functionlist(this_object(), RETURN_FUNCTION_NAME|TYPE_MOD_PUBLIC);
    functions = filter_array(functions, cl(isTestFunctionName));

    return functions;
}

private void foreach(mixed *array, closure function) {
    int i;
    for(i=0; i < sizeof(array); i++) {
        apply(function, array[i]);
    }
}

private void addTestToResults(string function) {
    currentFunction = function;
    results += ([
        currentFunction: ([
            T_STATUS: T_NOT_EXECUTED,
            T_REASON: ""
        ])
    ]);
}

private void executeTest(string function) {
    addTestToResults(function);
    call_other(this_object(), function);
}

nomask public mapping runTests() {
    string *functions;
    int i;

    results = ([ ]);

    functions = getTestFunctions();
    foreach(functions, cl(executeTest));
    
    return results;
}

nomask public void success() {
    results[currentFunction][T_STATUS] = T_SUCCESS;
}

nomask public varargs void fail(string reason) {
    results[currentFunction][T_STATUS] = T_FAILED;

    if(stringp(reason)) {
        results[currentFunction][T_REASON] = T_SUCCESS;
    }
}

nomask public mapping results() {
    return results;
}
