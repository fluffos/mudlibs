int access_rights(string name, string file, int readflag, int def)
{
  string s1, s2, s3;

  if (file=="access_rights.lpc") return 0;
  name=lower_case(name);

  if (readflag) {
    if( (name=="andyl" || (name=="wraz" && readflag)) && file[0..5]=="barden") return 1;
    // rage == balance == trusted (woody)
    if (name=="rage") return 1;
    if (file[0..3]=="book") return 1;
    if (file[0..2]=="npc") return 1;
    return 0;
  }
  if (sscanf(file,"%s/%s", s1,s2)!=2) return 0;

  if (name=="andyl" && s1=="barden") return 1;
  if (name=="lamuerte" && s1=="dragons") return 1;
  if (name=="lamuerte" && s1=="skills") return 1;
  if (name=="dante" && s1=="giant") return 1;
  return 0;
}
