  int SubTaskPercent(string quest,      eindeutige Questid
                     mixed player,      object player oder object * players
                     int task,          eindeutige Taskid
                     int percent)       Prozentwert, der subtrahiert werden soll
  int ToggleTask(string quest,          eindeutige Questid
                 mixed player,          object player oder object * players
