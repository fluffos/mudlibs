
  Questmaster / Questobjekt Konzept
  =================================

  Schnittstellen- und Datendefinition

Allgemein

  Typen
  call_t            mixed * (Format: ({string objname, string fun}))
  time_t            int (Sekunden seit 1970)
  percent_t         int (0..100)
  bool_t            int (0, 1)


Questobjekt

  Methoden
  void AddTask(int id,                  eindeutige Taskid, beginnend mit 1
               int * requires,          Taskids
               call_t * verify,         Callbacks zur Pruefung der Vorrauss.
               call_t * triggers,       call_others die getriggert werden
               object * access,         objekte, die den Task setzen duerfen
               bool_t percent,          ist Taskfortschritt prozentual
               int players,             Anzahl noetiger Spieler
               time_t reset,            Zeit bis zum Reset des Tasks
               string description)      Beschreibung des Tasks fuer Debug




Questmaster

  Methoden
  int StartQuest(string quest,          eindeutige Questid
                 mixed player)          object player oder object * players
  int StopQuest(string quest,           eindeutige Questid
                mixed player)           object player oder object * players
  int SetTask(string quest,             eindeutige Questid
              mixed player,             object player oder object * players
              int task)                 eindeutige Taskid
  int SetTaskTO(string quest,           eindeutige Questid
                mixed player,           object player oder object * players
                int task                eindeutige Taskid
                int percent)            Prozentwert, der gesetzt werden soll
  int AddTaskPercent(string quest,      eindeutige Questid
                     mixed player,      object player oder object * players
                     int task,          eindeutige Taskid
