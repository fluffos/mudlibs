#include <wizlevels.h>

//#define DEBUG
#ifdef DEBUG
#define DB(x) if (find_player("cirion")) tell_object(find_player("cirion"),x+"\n");
#else
#define DB(x)
#endif

int access_rights(string name, string file, int readflag, int def, string fun)
{
  string *s;
  int n;

  if (IS_LORD(name))
    return def;

  DB(sprintf("name %s file %s",name,file));
  s = explode(file,"/");
  n = sizeof(s);

  if (readflag)
  {
    DB("read "+n);
    if (file == "access_rights.lpc")
      return 0;
    if (n < 2 || (n > 1 && s[0] == "doc"))
      return def;
  }

  return 0;
}

