#pragma strict_types

#define WANT_QM_TYPES
#define NEED_QO_PROTOTYPES

#include "quest.h"
#include <wizlevels.h>
#include <properties.h>

nosave string questid;
nosave string uid;
nosave mapping steps;
nosave mapping variables;

void create()
{
  if (is_clone(this_object()))
  {
    if (explode(file_name(this_object()),"#")[0] == QO)
    {
      write("illegal clone\n");
      destruct(this_object());
    }
    else
    {
      steps = ([]);
      variables = ([]);
      QM->register();
      call_out("remove_unconfigured",0);
    }
  }
  else if (file_name(this_object()) == QO)
  {
  }
  else
  {
    QM->reloadquest();
  }
}

/** programming interface */

nosave int AddTask(int taskid, //)
                   int * requires,
                   call_t * verify,
                   call_t * triggers,
                   string * access,
                   bool_t percent,
                   int players,
                   time_t reset,
                   string description)
{
  if (!is_clone(this_object()))
    return (int)QM->AddTask(taskid, requires, verify, triggers, access,
                            percent, players, reset, description);
  return Q_ACCESS_DENIED;
}

/** automatic properties */
nosave int _query_nosell()
{ return 1; }

nosave int _query_nobuy()
{ return 1; }

nosave int _query_nodrop()
{ return 1; }

nosave int _query_neverdrop()
{ return 1; }

nosave void _set_autoloadobj(mixed data)
{
  if (!is_clone(this_object()))
    return;
  questid = data[0];
  steps = data[1];
  variables = data[2];
  uid = getuid(this_player());
}

nosave mixed _query_autoloadobj()
{
  if (!is_clone(this_object()))
    return 0;
  return ({questid, steps, variables});
}

/** internal interface to questmaster */

void initialize(string s_questid, string s_uid)
{
  if ( is_clone(this_object()) && file_name(previous_object()) == QM )
  {
    questid = s_questid;
    uid = s_uid;
  }
}

nosave void remove_unconfigured()
{
  if ( !uid )
    destruct(this_object());
}

void set_steps(mapping s_steps)
{
  if ( is_clone(this_object()) && file_name(previous_object()) == QM )
    steps = s_steps;
}

mapping query_steps()
{
  if ( file_name(previous_object()) == QM )
    return steps;
  else
    return copy_mapping(steps);
}

void set_variables(mapping s_variables)
{
  if ( is_clone(this_object()) && file_name(previous_object()) == QM )
    variables = s_variables;
}

void SetTask(int task, int value)
{
  if ( is_clone(this_object()) && file_name(previous_object()) == QM )
  {
    steps[task] = value;
  }
}

int QueryTask(int task)
{
  if (member(steps, task) && steps[task])
    return Q_TRUE;
  return Q_FALSE;
}

int QueryTaskPercent(int task)
{
  if (member(steps, task))
    return steps[task];
  return 0;
}
