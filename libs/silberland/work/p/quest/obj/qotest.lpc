#include "quest.h"

inherit "std/thing";
inherit QO;

create()
{
  thing::create();
  quest::create();

  write(QError(AddTask(QTASK_START(({}),({"/cirion/tools/lupe"}),1,0)))+"\n");
  write(QError(AddTask(2,
          ({QTI_START}),
          ({}),
          ({}),
          ({"/cirion/tools/lupe"}),
          Q_FALSE,
          1,
          0,
          "no desc"))+"\n");
  write(QError(AddTask(3,
          ({QTI_START}),
          ({}),
          ({}),
          ({"/cirion/tools/lupe"}),
          Q_FALSE,
          1,
          0,
          "no desc"))+"\n");

}
