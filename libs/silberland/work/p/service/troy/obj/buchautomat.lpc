inherit "/std/thing";

#include <properties.h>
#include <moving.h>

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Ein Handbuch fuer Anfaenger");
  SetProp(P_LONG,"Ein Handbuch fuer Anfaenger.\n");
  SetProp(P_NAME,"Buch");
  AddId(({"handbuch","buch","anfaengerbuch","\nbookmachine"}));
  SetProp(P_GENDER,NEUTER);
  SetProp(P_ARTICLE,1);
  SetProp(P_NOGET,1);
  AddCmd(({"nimm","nehme"}),"nimm");
}

nimm(str)
{
  string was;
  notify_fail("Was willst Du nehmen ? Syntax: NIMM <ETWAS>.\n");
  if(!str || !stringp(str) || (str=lower_case(str))=="" || !id(str)) return 0;
  if(present("\nhintbook",this_player()))
  {
    write("Du hast doch schon ein Buch...\n");
    return 1;
  }
  say(capitalize(this_player()->name(WER,1)) + " nimmt ein Buch.\n",this_player());
  write("Du nimmst ein Buch. Sofort erscheint auf unerklaerliche Weise ein neues.\n");
  clone_object("/p/service/troy/obj/anfaengerbuch")->move(this_player());
  return 1;
}

move(target, method, mess)
{
  if ((method & M_GET) && living(target))
    return get(target);
  else
    return ::move(target,method,mess);
}

get(targ)
{
  if (!targ || !interactive(targ) || targ != this_player())
    return 0;
  if (present("\nhintbook", this_player()))
  {
    write("Du hast doch schon ein Buch...\n");
    return ME_CANT_BE_TAKEN;
  }
  clone_object("/p/service/troy/obj/anfaengerbuch")->move(targ,M_GET);
  write("Du nimmst ein Buch. Sofort erscheint auf unerklaerliche Weise ein neues.\n");
  say(capitalize(targ->name(WER,1))+" nimmt ein Buch.\n",targ);
  return 1;
}





