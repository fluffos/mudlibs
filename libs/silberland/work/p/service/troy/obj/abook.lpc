inherit "/p/service/troy/std/book1";

#include <properties.h>
#include "../books.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Das Handbuch fuer Anfaenger");
  SetProp(P_LONG, break_string(
	"Du haeltst ein leinengebundenes Buch in Deinen Haenden. "+
	"Der Titel heisst: 'Erste Schritte im MorgenGrauen'. Du kannst "+
	"es mit 'oeffne buch' aufschlagen und mit 'lies buch' sequentiell, "+
	"also Seite fuer Seite, lesen. Mit 'lies seite <nr>' kannst Du "+
	"speziell die Seite <nr> lesen. Mit 'schliesse buch' schlaegst "+
	"Du es wieder zu.",78));
  SetProp(P_NAME,"Handbuch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOBUY, 1);
  SetProp(P_BOOK_CONTENTS, "/p/service/troy/etc/a.text");
  AddId(({"handbuch","\nhintbook"}));
}

reset()
{
  if(!is_clone(this_object())) return 1;
  if(!environment(this_object())) return remove();
  if(!interactive(environment(this_object())))
  {
    if(!is_clone(environment(this_object())))
      tell_room(environment(this_object()),"Ein Buch verschwindet mit Knall und Schwefelduft.\n");
    return remove();
  }
  return 1;
}
