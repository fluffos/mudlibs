
private mapping rooms = ([ ]);

public void _dump_cache()
{
   write( sprintf( "%O\n %d rooms\n", rooms, sizeof( rooms ) ) );
}

public nomask int cache_room( object room )
{
   if ( !room || !room->get_location() )
      return 0;

   rooms[ room->get_location() ] = room;

   return 1;
}

private mapping zones = ([ ]);

public void _dump_zones()
{
   write( sprintf( "%O\n %d zones\n", zones, sizeof( zones ) ) );
}
