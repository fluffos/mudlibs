/***************************************************************/ 
/*                 OVERLAND DB QUERIES                         */
/***************************************************************/ 
// #include "/obj/masters.h"

// for DB handling dummy

#define DB "/std/thing"

/***************************************************************/ 
/*                                                             */
/*[world]                                                      */
/*   [plain]                                                   */
/*      [zone]                                                 */
/*      [zone]                                                 */
/*      [...]                                                  */
/*   [plain]                                                   */
/*      [zone]                                                 */
/*      [...]                                                  */
/*   [...]                                                     */
/*[world]                                                      */
/*   [...]                                                     */
/*                                                             */
/***************************************************************/ 

/***************************************************************/ 
/*                       WORLDS                                */
/* table: tOLworld                                             */
/***************************************************************/ 
public nomask string * query_worlds()
{
  string sql;
  mixed *res;

  sql = sprintf(
      "SELECT name "
      "FROM tOLWorld "
      "WHERE enabled <> 0");

  res = DB->execute_query( sql );

//  return( sizeof(res) ? map( res, (: $1[0] :) ): ({ }) );
  return( sizeof(res) ? map_array( res, lambda( ({'a}), ({#'[, 'a, 0}) ) ): ({ }) );
}

/***************************************************************/ 
/*                       PLAINS                                */
/* table: tOLPlains, tOLWorldPlains, TOLWorld                  */
/* param: world .. the world that contains the plains          */
/***************************************************************/ 
public nomask string * query_plains_of_world( string world )
{
  string sql;
  mixed *res;

  if ( !world )
    return( ({ }) );

  sql = sprintf(
      "SELECT p.name "
      "FROM tOLPlains p, tOLWorldPlains wp, tOLWorld w "
      "WHERE w.ID = wp.world AND p.ID = wp.plain "
      "  AND w.name = '%s' "
      "  AND p.enabled <> 0",
      world );

  res = DB->execute_query( sql );

//  return( sizeof(res) ? map( res, (: $1[0] :) ): ({ }) );
  return( sizeof(res) ? map_array( res, lambda( ({'a}), ({#'[, 'a, 0}) ) ): ({ }) );
}

/***************************************************************/ 
/*                       PLAIN                                 */
/* table: tOLPlains                                            */
/* param: plain .. the plains                                  */
/***************************************************************/ 
public nomask string * query_plain( string plain )
{
  string sql;
  mixed *res;

  if ( !plain )
    return( 0 );

  sql = sprintf(
      "SELECT ID, name, Landscape, Transparent  "
      "FROM tOLPlains "
      "WHERE name = '%s' "
      "  AND enabled <> 0",
      plain );

  res = DB->execute_query( sql );

//  return ( sizeof( res )? res[ 0 ] : 0  );
  return( sizeof(res) ? map_array( res, lambda( ({'a}), ({#'[, 'a, 0}) ) ): ({ }) );
}

/***************************************************************/ 
/* table: tOLPlains, tOLPlainData                              */
/* param: plain .. the plain                                   */
/***************************************************************/ 
public nomask string * query_plaindata( string plain )
{
  string sql;
  mixed *res;

  if ( !plain )
    return( 0 );

  sql = sprintf(
      "SELECT MapChar, VColor, VChar, blocking, HColor, HChar, RoomType, RoomLandscape, FPNeeded, "
      "       Description, CanEnter, BlockMessage, Flags "
      "FROM tOLPlains p, tOLPlainData d "
      "WHERE p.ID = d.PlainID "
      "  AND p.name = '%s'",
      plain );

  res = DB->execute_query( sql );

//  return ( sizeof( res )? res : 0  );
  return( sizeof(res) ? map_array( res, lambda( ({'a}), ({#'[, 'a, 0}) ) ): ({ }) );
}

/***************************************************************/ 
/* table: tOLPlains, tOLWorldPlains                            */
/* param: plain .. the plain                                   */
/***************************************************************/ 
public nomask string query_upper_plain( string plain )
{
  string sql;
  mixed *res;

  if ( !plain )
    return( 0 );

  sql = sprintf(
      "SELECT p2.name "
      "FROM tOLPlains p1, tOLWorldPlains wp1, tOLPlains p2, tOLWorldPlains wp2 "
      "WHERE p1.ID = wp1.plain AND p2.ID = wp2.plain "
      "      AND wp1.world = wp2.world "
      "      AND (wp1.level+1) = wp2.level "
      "      AND p1.name = '%s' "
      "      AND p1.enabled <> 0 "
      "      AND p2.enabled <> 0",
      plain );

  res = DB->execute_query( sql );

  return ( sizeof( res )? res[ 0 ][ 0 ] : 0 );
}

/***************************************************************/ 
/* table: tOLPlains, tOLWorldPlains                            */
/* param: plain .. the plain                                   */
/***************************************************************/ 
public nomask string query_lower_plain( string plain )
{
  string sql;
  mixed *res;

  if ( !plain )
    return( 0 );

  sql = sprintf(
      "SELECT p2.name "
      "FROM tOLPlains p1, tOLWorldPlains wp1, tOLPlains p2, tOLWorldPlains wp2 "
      "WHERE p1.ID = wp1.plain AND p2.ID = wp2.plain "
      "  AND wp1.world = wp2.world "
      "  AND (wp1.level-1) = wp2.level "
      "  AND p1.name = '%s' "
      "  AND p1.enabled <> 0 "
      "  AND p2.enabled <> 0",
      plain );

  res = DB->execute_query( sql );

  return ( sizeof( res )? res[ 0 ][ 0 ] : 0 );
}

/***************************************************************/ 
/*                       MAPS                                  */
/* table: tOLMaps, tOLPlains                                   */
/* param: plain .. the plain that contains the maps            */
/***************************************************************/ 
public nomask string * query_maps_on_plain( string plain )
{
  string sql;
  mixed *res;

  if ( !plain )
    return( ({ }) );

  sql = sprintf(
      "SELECT m.name "
      "FROM tOLPlains p, tOLMaps m "
      "WHERE p.ID = m.PlainID "
      "  AND p.name = '%s' "
      "  AND m.enabled <> 0",
      plain );

  res = DB->execute_query( sql );

//  return( sizeof(res) ? map( res, (: $1[0] :) ): ({ }) );
  return( sizeof(res) ? map_array( res, lambda( ({'a}), ({#'[, 'a, 0}) ) ): ({ }) );
}

/***************************************************************/ 
/*                       MAP                                   */
/* table: tOLMaps                                              */
/* param: map .. the map                                       */
/***************************************************************/ 
public nomask string * query_map( string map )
{
  string sql;
  mixed *res;

  if ( !map )
    return( 0 );

  sql = sprintf(
      "SELECT ID, name, PosX, PosY, Map "
      "FROM tOLMaps "
      "WHERE name = '%s' "
      "  AND enabled <> 0",
      map );

  res = DB->execute_query( sql );

//  return ( sizeof( res )? res[ 0 ] : 0  );
  return( sizeof(res) ? map_array( res, lambda( ({'a}), ({#'[, 'a, 0}) ) ): ({ }) );
}

/***************************************************************/ 
/*                       ZONES                                 */
/* table: tOLZones, tOLPlains                                  */
/* param: plain .. the plain that contains the maps            */
/***************************************************************/ 
public nomask string * query_zones_of_plain( string plain )
{
  string sql;
  mixed *res;

  if ( !plain )
    return( ({ }) );

  sql = sprintf(
      "SELECT z.name "
      "FROM tOLZones z, tOLPlains p "
      "WHERE p.ID = z.PlainID "
      "  AND p.name = '%s' "
      "  AND z.enabled <> 0",
      plain );

  res = DB->execute_query( sql );

//  return( sizeof(res) ? map( res, (: $1[0] :) ): ({ }) );
  return( sizeof(res) ? map_array( res, lambda( ({'a}), ({#'[, 'a, 0}) ) ): ({ }) );
}

/***************************************************************/ 
/*                       ZONE                                  */
/* table: tOLZones, tOLPlains, tOLWorld, tOLWorldPlains        */
/* param: zone .. the zone                                     */
/***************************************************************/ 
public nomask string * query_zone( string zone )
{
  string sql;
  mixed *res;

  if ( !zone )
    return( 0 );

  sql = sprintf(
      "SELECT z.ID, z.name, w.name, p.name, IFNULL( m.name, '' ), z.PosX, z.PosY, "
      "       z.Type, z.Color, z.MapChar, z.Flags, "
      "       north, east, south, west "
      "FROM tOLWorld w, tOLWorldPlains wp, tOLPlains p, tOLZones z LEFT JOIN tOLMaps m ON z.MapID = m.ID "
      "WHERE p.ID = z.PlainID "
      "  AND w.ID = wp.world "
      "  AND wp.plain = p.ID "
      "  AND z.name = '%s' "
      "  AND z.enabled <> 0",
      zone );

  res = DB->execute_query( sql );

//  return ( sizeof( res )? res[ 0 ] : 0  );
  return( sizeof(res) ? map_array( res, lambda( ({'a}), ({#'[, 'a, 0}) ) ): ({ }) );
}

