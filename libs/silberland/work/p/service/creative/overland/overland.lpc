/***************************************************************/ 
/*                    VISIBLE PLAYER                           */
/* colours the view the player sees                            */
/***************************************************************/ 
private int      _obj_view_size_;
private string   _obj_location_;
private int      _obj_dx_;
private int      _obj_dy_;
private object   _obj_plr_;

protected string eval_livings( string in, int pos )
{
  object room;
  object *inv;

  if ( _merge_map_[ pos ] != ' ' ){
    return "";
  }

  room = rooms[ sprintf("%s%d|%d", _obj_location_, _obj_dx_+pos/(_obj_view_size_+1), _obj_dy_+pos%(_obj_view_size_+1) ) ];

  //   write( sprintf("%s > %O >",sprintf("%s%d|%d", _obj_location_, _obj_dx_+pos/(_obj_view_size_+1), _obj_dy_+pos%(_obj_view_size_+1) ) , room));
  if ( !room ) {
    //      write("\n");
    return "";
  }

  inv = filter_array( all_inventory( room ), #'interactive );
  //   write( sizeof( inv )+"\n" );
  if ( sizeof( inv /*filter( inv, (: !$1->is_invis_for( _obj_plr_ ) :) )*/ ) ){
    _merge_map_[ pos ] = 'G';
  }

  return "";
}

protected string find_visible_livings( string world, string plain, int xpos, int ypos, string * view, object plr, int rad )
{
  int size2;

  _merge_map_ = OLVIEW_ZONES( view );

  _obj_view_size_ = (int)sqrt( (float)strlen( OLVIEW_PLAIN( view ) ) );
  size2 = _obj_view_size_/2;
  _obj_plr_ = plr;
  _obj_location_ = sprintf("@%s|%s|", world, plain);
  _obj_dx_ = xpos - size2;//OL_VIEW_RADIUS;
  _obj_dy_ = ypos - size2;//OL_VIEW_RADIUS;

  my_regreplace( OLVIEW_VISIBLE_PLAIN( view ), "[^ ]", (#'eval_livings), 1 );

  return _merge_map_;   
}

/***************************************************************/ 
/*                    COLOUR THE VIEW                          */
/* colours the view the player sees                            */
/***************************************************************/ 
#define CDEBUG 0
private mapping _colour_filter_ = ([ 0:"",
    "reset":VT_TA_AO,
    "bblack":VT_B_BLACK,
    "bred":VT_B_RED,
    "bgreen":VT_B_GREEN,
    "bbrown":VT_B_BROWN,
    "byellow":VT_B_YELLOW,
    "bblue":VT_B_BLUE,
    "bmagenta":VT_B_MAGENTA,
    "bcyan":VT_B_CYAN,
    "bwhite":VT_B_WHITE,
    //"underline":CC_UNDERLINE
    ]); 

private mixed * _colour_view_;

private string   _colour_pos_;
private int      _colour_xpos_;
private int      _colour_ypos_;

private int      _colour_size_;
private mapping  _colour_zones_;

private mapping _colour_data_;

private string * eval_zone( int pos )
{
  //   write( "POSITION="+pos+" size="+_colour_size_+" ("+(pos/(_colour_size_+1))+"/"+((pos%(_colour_size_+1)))+")\n"); 
  string loc;

  loc = sprintf( "%s|%d|%d", _colour_pos_, 
      _colour_xpos_+(pos/(_colour_size_+1)), 
      _colour_ypos_+(pos%(_colour_size_+1)) ); 

  //ODEBUG( loc );
  return /*( ({ CC_BRED+CC_WHITE, "*" }) );*/({ _colour_zones_[ loc, ZONE_DATA_COLOUR ], _colour_zones_[ loc, ZONE_DATA_CHAR ], (_colour_zones_[ loc, ZONE_DATA_TYPE ] == OLROOM_TYPE_ZONE ) }); 
  ///ODEBUG( hmp );
  //COLOUR_INFO( hmp );
  //return hmp;
  // ret #3 = visibility (range | connect )
}

private string _calculate_colours( string in, int pos )
{
  string currentMapchar;
  string colour;

#if CDEBUG   
  write( "["+in+"]>" );
#endif   

  currentMapchar = in[ 0..0 ];
  colour = VT_TA_AO;

  if ( currentMapchar == CLIP_A || currentMapchar == CLIP_B ) { 
    currentMapchar = OLVIEW_VISIBLE_PLAIN( _colour_view_ )[ pos..pos ]; 
    colour += _colour_data_[ currentMapchar, PDATA_VCOLOR ];
    in = strmul( _colour_data_[ currentMapchar, PDATA_VCHAR ], strlen( in ) );
#if CDEBUG   
    write( " %^green%^V%^reset%^["+in+"]>" );
#endif   
  } else {
    string *tmp;

    tmp = 0;
    switch ( currentMapchar ){
      case " ": break;
      case "@":
        case "*": 
        tmp = eval_zone( pos );
      //colour = tmp[ 0 ];//CC_BRED+CC_BLACK; 
      in = tmp[ 1 ];
      //break;
      default :
      if ( member( _colour_data_, currentMapchar ) ){
        colour += _colour_data_[ currentMapchar, PDATA_HCOLOR ];
        in = strmul( _colour_data_[ currentMapchar, PDATA_HCHAR ], strlen( in ) );
      } else {
        //               write( sprintf(" vpChar=%O",to_string( ({ OLVIEW_VISIBLE_PLAIN( _colour_view_ )[ pos ] }) )) );
        //               write( sprintf(" pC=%O",_colour_data_[ OLVIEW_PLAIN( _colour_view_ ), PDATA_HCOLOR ]) );
        if ( OLVIEW_VISIBLE_PLAIN( _colour_view_ )[ pos ] != ' ' )
          colour = _colour_data_[ OLVIEW_VISIBLE_PLAIN( _colour_view_ )[ pos..pos ], PDATA_VCOLOR ];
        else {
          colour = _colour_data_[ OLVIEW_PLAIN( _colour_view_ )[ pos..pos ], PDATA_HCOLOR ];
          if ( tmp && !tmp[ 2 ] ) 
            in = strmul( _colour_data_[ OLVIEW_PLAIN( _colour_view_ )[ pos..pos ], PDATA_HCHAR ], strlen( in ) );
        }

        /*
        if ( !tmp || tmp[ 2 ] )
          colour = terminal_colour( colour, _colour_filter_ )+(tmp?tmp[0]:VT_RED);
          */
        colour += (tmp?tmp[0]:VT_RED);
      }
    }

#if CDEBUG   
    write( " %^red%^H%^reset%^["+in+"]>" );
#endif   
  }

  if ( currentMapchar == " " || in[0] == ' ' ){
    if ( OLVIEW_LOWER_PLAIN( _colour_view_ ) )
      in = VT_TA_AO+OLVIEW_LOWER_PLAIN( _colour_view_ )[ pos..(pos+strlen(in)-1) ];
    else
      in = VT_TA_AO+in;   
#if CDEBUG
    write( " -\" \"- ["+COLOUR_INFO(in)+"]\n" );
#endif      
    return ( in );
  }   

#if CDEBUG
  write( " ["+COLOUR_INFO(colour+in)+"]\n" );
#endif      

  return ( VT_TA_AO+colour+in );  
}

public string colour_overland_view( mixed * view )
{
  mixed *pos;
  string colours;
  string ret;

  pos = unify_position( OLVIEW_POSITION( view ) );
  if ( !pos )
    return 0;

  _colour_view_ = view;

  _colour_pos_ = sprintf("@%s|%s", LOC_WORLD( pos ), LOC_PLAIN( pos ));
  _colour_size_ = (int)sqrt( (float)strlen( OLVIEW_PLAIN( view ) ) );

  _colour_xpos_ = LOC_VIEW_X( pos ) - (_colour_size_/2);
  _colour_ypos_ = LOC_VIEW_Y( pos ) - (_colour_size_/2);

  _colour_data_ = overland_data[ LOC_WORLD( pos ) ][ LOC_PLAIN( pos ) ][ OL_DATA_PLAINDATA ];   
  _colour_zones_ = overland_data[ LOC_WORLD( pos ) ][ LOC_PLAIN( pos ) ][ OL_DATA_ZONES ];
  //write( sprintf("%O\n",_colour_data_) );

  colours = implode( map_array( m_indices( mkmapping( efun::explode( OLVIEW_PLAIN( view ) , "" ) ) - ([ "\n" ]) ), #'build_pattern_fun), "|" );
//        lambda( ({'a}), ({ #'+, ({ #'+, "\\", 'a }), "+"}) ) ) , "|" );

//  colours = implode( map( m_indices( mkmapping( explode( OLVIEW_PLAIN( view ), "" ) ) - ([ "\n" ]) ), (: "\\"+$1+"+" :) ), "|" );
  //write( colours+"\n" ); 

  //write( sprintf("%O\n",merge_object_layer( OLVIEW_PLAIN( view ), OLVIEW_ZONES( view ) )) );

  ret = my_regreplace( merge_object_layer( OLVIEW_PLAIN( view ), OLVIEW_ZONES( view ) ),
      colours+"|[@*gGX]", (#'_calculate_colours), 1 );
  //write( "\n"+ret+"\n" ); 
  return ret;
}

/***************************************************************/ 
/*                         VIEW                                */
/* calculates the view the player sees                         */
/***************************************************************/ 
public string calculate_overland_view( string * view, object plr )
{
  mixed *pos;
  int rad;

  pos = unify_position( OLVIEW_POSITION( view ) );
  if ( !pos )
    return 0;

  rad = calculate_view_range( plr, LOC_WORLD( pos ), LOC_PLAIN( pos ) );

  apply_mask( &view, rad );

  OLVIEW_ZONES( view ) = find_visible_livings( LOC_WORLD( pos ), LOC_PLAIN( pos ), LOC_VIEW_X( pos ),  LOC_VIEW_Y( pos ), 
      view, plr, rad );

  return colour_overland_view( view );
  //   return 0;
}

/***************************************************************/ 
/*                        MOVING                               */
/* calculates the view the player sees                         */
/***************************************************************/
#if 0
#include "overland_moving.lpc"
#include "/room/genRoom.h"
#else

#define _DIR_IDX_ 0
#define _DIR_DX_ 1
#define _DIR_DY_ 2

private mapping _directions_ =
 ([ "norden": 1; -1;  0,
    "osten" : 6;  0;  1,
    "sueden": 9;  1;  0,
    "westen": 4;  0; -1 ]);

private nomask object create_room( string location )
{
  mixed *pos;
  object room;
  string surrounding;
  mapping plain_data;
  string *dirs;
  string dir;
  int i, idx, dx, dy;
  mapping zones;

  pos = unify_position( location );
  if ( !pos )
    return 0;

  room = clone_object( OVERLAND_ROOM );
  if ( !room ) 
    raise_error("Couldn't clone OverlandRoom!\n"); 

  room->set_location( location );

  surrounding = get_sourrounding( location );
  plain_data = overland_data[ LOC_WORLD( pos ) ][ LOC_PLAIN( pos ) ][ OL_DATA_PLAINDATA ];

  dirs = m_indices( _directions_ );
  for ( i = sizeof( dirs ) - 1; i >= 0; i -- ) {
    dir = dirs[i];
    idx = _directions_[dir, _DIR_IDX_];
    dx = _directions_[dir, _DIR_DX_];
    dy = _directions_[dir, _DIR_DY_];
//  foreach( string cmd, string dir, int idx, int dx, int dy : _directions_ ){
    if ( plain_data[ surrounding[ idx..idx ] ] ){
      if ( plain_data[ surrounding[ idx..idx ], 9 ] )//ROOM_DATA_CANENTER
        room->AddExit( dir, sprintf("@%s|%s|%d|%d", LOC_WORLD( pos ), LOC_PLAIN( pos ), LOC_VIEW_X( pos )+dx, LOC_VIEW_Y( pos )+dy ) ); 
      else
        room->AddGuardedExit( dir, sprintf("@%s|%s|%d|%d", LOC_WORLD( pos ), LOC_PLAIN( pos ), LOC_VIEW_X( pos )+dx, LOC_VIEW_Y( pos )+dy ),
                              "NO_GUARD", plain_data[ surrounding[ idx..idx], 10 ] ); //ROOM_DATA_BLOCKMESSAGE
    }
  }

  zones = overland_data[ LOC_WORLD( pos ) ][ LOC_PLAIN( pos ) ][ OL_DATA_ZONES ];

  if ( zones[ location ] && zones[ location, ZONE_DATA_TYPE ] != OLROOM_TYPE_ZONE  ){ 
    string plain;
    //ODEBUG( zones[ location, ZONE_DATA_FLAGS ] );
    plain = overland_data[ LOC_WORLD( pos ) ][ LOC_PLAIN( pos ) ][ OL_DATA_LOWER_PLAIN ];
    if ( plain && (zones[ location, ZONE_DATA_FLAGS ] & OLROOM_FLAG_PLAIN_DOWN) ){
      room->AddExit( "unten", sprintf("@%s|%s|%d|%d", LOC_WORLD( pos ),  plain, LOC_VIEW_X( pos ), LOC_VIEW_Y( pos ) ) );
    }
    plain = overland_data[ LOC_WORLD( pos ) ][ LOC_PLAIN( pos ) ][ OL_DATA_UPPER_PLAIN ];
    if ( plain && (zones[ location, ZONE_DATA_FLAGS ] & OLROOM_FLAG_PLAIN_UP) ){
      room->AddExit( "oben", sprintf("@%s|%s|%d|%d", LOC_WORLD( pos ), plain, LOC_VIEW_X( pos ), LOC_VIEW_Y( pos ) ) );
    }

    //OLROOM_FLAG_PLAIN_DOWN
  }

  return room;  
}

public nomask int move( object living, string dest, string msg, string cmd )
{
  mixed *pos;
  object dest_obj;

  pos = unify_position( dest );
  if ( !living || !dest || !pos ) 
    return 0;

  dest = build_unified_position( pos );

  //write( "moving to "+dest+"\n" );
  dest_obj = rooms[ dest ];
  //write( sprintf("found <%O>\n", dest_obj ) );
  if ( !dest_obj ) {
    mapping zones;

    zones = overland_data[ LOC_WORLD( pos ) ][ LOC_PLAIN( pos ) ][ OL_DATA_ZONES ];
    //ODEBUG( zones );
    //ODEBUG( zones[ dest ] );
    //ODEBUG( zones[ dest, ZONE_DATA_TYPE ] );
    if ( zones[ dest ] && zones[ dest, ZONE_DATA_TYPE ] == OLROOM_TYPE_ZONE ){
      dest = zones[ dest, ZONE_DATA_ENTRYS ][ cmd ];
      if ( !dest ) return 1;
      else if ( dest[ 0 ] == '!' ) {
        tell_object( living, dest[1..]+"\n" );
        return 1;
      } else dest_obj = (object)dest;

    } else {
      dest_obj = create_room( dest );
      if ( !dest_obj ) return 0;
      //write( sprintf("Adding room: %O (%O)\n", dest_obj, dest_obj->get_location() ) );
      //rooms += ([ dest_obj->query_location(): dest_obj ]); 
      cache_room( dest_obj );
    }
  }

  living->move_living( dest_obj, msg, 0, cmd);
}

#endif

public nomask string query_destination( string dest, string cmd )
{
  mixed *pos;
  object dest_obj;

  pos = unify_position( dest );
  if ( !dest || !pos ) 
    return 0;

  dest = build_unified_position( pos );

  //write( "moving to "+dest+"\n" );
  dest_obj = rooms[ dest ];
  //write( sprintf("found <%O>\n", dest_obj ) );
  if ( !dest_obj ) {
    mapping zones;

    zones = overland_data[ LOC_WORLD( pos ) ][ LOC_PLAIN( pos ) ][ OL_DATA_ZONES ];
    //ODEBUG( zones );
    //ODEBUG( zones[ dest ] );
    //ODEBUG( zones[ dest, ZONE_DATA_TYPE ] );
    if ( zones[ dest ] && zones[ dest, ZONE_DATA_TYPE ] == OLROOM_TYPE_ZONE ){
      dest = zones[ dest, ZONE_DATA_ENTRYS ][ cmd ];
      if ( !dest ) return 0;
      else if ( dest[ 0 ] == '!' ) {
        //tell_object( living, dest[1..]+"\n" );
        return dest;
      } else dest_obj = (object)dest;

    } else {
      dest_obj = create_room( dest );
      if ( !dest_obj ) return 0;
      //write( sprintf("Adding room: %O (%O)\n", dest_obj, dest_obj->get_location() ) );
      //rooms += ([ dest_obj->query_location(): dest_obj ]); 
      cache_room( dest_obj );
    }
  }
  return (string)dest_obj;
  //living->move_living( dest_obj, msg, 0, cmd);
}

