}

/***************************************************************/ 
/*                   UNIFIED POSITION                          */
/* unify overland position                                     */
/***************************************************************/ 
public nomask mixed * unify_position( string position )
{
  mixed *ret;
  int *map;

  if ( !position || position[ 0 ] != '@' )
    return 0;
  ret = explode( position[1..], "|" );
  switch ( sizeof( ret ) ) {
    case 4: if ( !overland_data[ LOC_WORLD( ret ) ] || !overland_data[ LOC_WORLD( ret ) ][ LOC_PLAIN( ret ) ] ) 
              return 0;
            LOC_VIEW_X( ret ) = to_int( LOC_VIEW_X( ret ) );
            LOC_VIEW_Y( ret ) = to_int( LOC_VIEW_Y( ret ) );
            break;
    case 5: if ( !overland_data[ LOC_WORLD( ret ) ] || !overland_data[ LOC_WORLD( ret ) ][ LOC_PLAIN( ret ) ] || !overland_data[ LOC_WORLD( ret ) ][ LOC_PLAIN( ret ) ][ LOC_MAP( ret ) ] )
              return 0;
            map = overland_data[ LOC_WORLD( ret ) ][ LOC_PLAIN( ret ) ][ LOC_MAP( ret ) ][ OL_DATA_MAPPOSITION ];
            LOC_VIEW_X( ret ) = map[ 0 ] + to_int( ret[ 3 ]);
            LOC_VIEW_Y( ret ) = map[ 1 ] + to_int( ret[ 4 ]);
            ret = ret[0..3];
            break;
    default: return 0;
  }
  return ret;
}

public nomask string build_unified_position( mixed * pos )
{
  if (!pos || sizeof( pos ) != 4 )
    return 0;

  return ( sprintf( "@%s|%s|%d|%d", pos[0], pos[1], pos[2], pos[3] ) );
}

/***************************************************************/ 
/*                      MASK VIEWS                             */
/* apply a circular mask to a view                             */
/***************************************************************/ 
#define MASK_CHAR "%"

private mapping masks = ([ ]);

private nomask int _calc_offset( float hy2, int kat )
{
  kat = abs(kat);
  return to_int(sqrt(hy2 - (float)(kat*kat)));
}

private nomask varargs string create_mask( int rad, int size )
{
  int    off;
  string line;
  float  tmp;
  int size2, i, h;
  string *mask;

  if ( !size )
    size = OLVIEW_SIZE;

  size2 = size / 2;

  mask = ({ });

  tmp = (float)rad + 0.5;
  tmp *= tmp;

  for ( i = 0; i < size2 - rad; i++) mask+= ({ strmul(" ",size) });
  //   write( sprintf("1:%O\n", mask) );

  for ( h = max(size2 - rad, 0); h <= min(size2 + rad, size-1); h++ ) {

    off = min(_calc_offset(tmp, size2 - h ), size2);
    //      write(" off="+off+"\n");
    line = strmul(MASK_CHAR,(off*2+1));
    off = size2 - off;
    if (off < 0) off = 0;
    mask += ({ strmul(" ",off)+line+strmul(" ",off) });
  }

  for ( i = 0; i < size2 - rad; i++) mask+= ({ strmul(" ",size) });

  return implode(mask,"\n");
}

public nomask varargs string get_mask( int rad, int size )
{
  int crad;
  string key;

  if ( !size )
    size = OLVIEW_SIZE;

  size = abs( size );

  crad = min(abs(rad), (int)(( size/2 )*1.5));

  key = crad+"|"+size;
  if ( !member( masks, key ) ){
    masks[ key ] = create_mask( crad, size );
  }

  return masks[ key ];
}

protected nomask string my_regreplace( string text, string pattern,
                                       closure replacepattern, int flags ) {
  string *matches;
  string match;
  int i, arr_len, str_pos, match_len;

  matches = regexplode( text, pattern );
  arr_len = sizeof( matches );
  str_pos = 0;
  for ( i = 0; i < arr_len; i++ ) {
    match = matches[i];
    match_len = strlen( match );
    // every second element is a match
    if ( i % 2 ) {
      matches[i] = funcall( replacepattern, match, str_pos );
    }
    str_pos += match_len;
  }
  return implode( matches, "" ); 
}

string _apply_mask_tmp_;

string apply_mask_fun( string txt, int idx ) {
  return _apply_mask_tmp_[idx..idx+strlen(txt)-1];
}

protected nomask void apply_mask( string * view, int rad )
{
  int size, nsize;
  string tmp, mask;
  int i;

  size=0;
  if ( !view ) return;

  for (i = 1; i <= ((rad <= 4)?2:3); i++){
    if ( !view[ i ]  ) 
      continue;

    _apply_mask_tmp_ = view[i];

    nsize = (int)sqrt( (float)strlen( _apply_mask_tmp_ ) );
    if ( nsize != size ){
      size = nsize;
      mask = get_mask( rad, size );
    }

    view[ i ] = my_regreplace(mask,MASK_CHAR+MASK_CHAR"*", #'apply_mask_fun, 1);
  }
}

/* some mask related output */
public string info_masks_cached()
{
  return ( sizeof(masks)+" ("+implode( sort_array(m_indices(masks), #'>), ", ")+")\n");
}


/***************************************************************/ 
/*                      CLIP THE PLAIN                         */
/* get a clipping of the plain                                 */
/***************************************************************/ 
private string get_plain_clipping( string world, string plain, int xpos, int ypos, int size )
{
  string view;

  view = get_default_landscape( world, plain, size );

  view = merge_maps( view, world, plain, xpos, ypos, size );

  return view; 
}

//TODO
public nomask string get_sourrounding( string position )
{
  mixed *pos;

  pos = unify_position( position );
  if ( !pos )
    return 0;

  return get_plain_clipping( LOC_WORLD( pos ), LOC_PLAIN( pos ), LOC_VIEW_X( pos )-1, LOC_VIEW_Y( pos )-1, 3 );
}

public nomask string get_landscape( string position )
{
  mixed *pos;
  
  pos = unify_position( position );
  if ( !pos )
    return 0;

  return get_plain_clipping( LOC_WORLD( pos ), LOC_PLAIN( pos ), LOC_VIEW_X( pos ), LOC_VIEW_Y( pos ), 1 );
}

/***************************************************************/ 
/*                    DECODE THE PLAIN                         */
/* decode a part of the plain                                  */
/***************************************************************/ 
private mapping _plain_data_;
private string decode( string in, int pos )
{
  //   write( "["+in+"]>"+_plain_data_[ in[ 0..0 ], 1 ]+"\n" );
  /*string ret =*/ return strmul(_plain_data_[ in[ 0..0 ], 1 ],strlen( in )); 
  //   write( "["+ret+"]\n" );
  //   return ret;
}

protected string build_pattern_fun( string txt ) {
  return sprintf("\\%s\\%s*", txt, txt);
}

private string decode_plain_view( string view, string world, string plain )
{
  string data;

  data = implode( map_array( m_indices( mkmapping( efun::explode( view , "" ) ) - ([ "\n", " " ]) ), #'build_pattern_fun ), "|" );
//        lambda( ({'a}), ({ #'+, ({ #'+, "\\", 'a }), "+"}) ) ) , "|" );
//        (: "\\"+$1+"+" :) ), 
  _plain_data_ = overland_data[ world ][ plain ][ OL_DATA_PLAINDATA ];

  return my_regreplace( view, data, (#'decode), 1 );
}

/***************************************************************/ 
/*                CALCULATE THE VIEW SIZE                      */
/* calculate the viewable section                              */
/*                                                             */
/*        dDd                                                  */
/*       gcCcg                                                 */
/*      gfbBbfg                                                */
/*     dcbaAabcd                                               */
/*     DCBAXABCD                                               */
/*     dcbaAabcd                                               */
/*      gfbBbfg                                                */
/*       gcCcg                                                 */
/*        dDd                                                  */
/*                                                             */ 
/***************************************************************/ 
private int _plain_transparent_;

int _check( int x )
{
  if ( _plain_transparent_ && x == ' ' )
    return ( 1 );
  else
    return (_plain_data_[ to_string( ({ x }) ) ] ? !_plain_data_[ to_string( ({ x }) ), 2 ] : 0);
  /*   switch (x) {
       case ' ': return 0;
       case '.':
       case ':': return 1;
       case 'N':
       case '#': return 0;
       }
       return 1;*/
}

void do_vsection( string *in, int dir, string *ret, int size )
{
  int A,B,C,D,a,b,c,d,f,g;

  ret[size][size] = in[size][size];

  A = _check( in[size + 1*dir][size] );
  if( A>0 ) B = _check( in[size + 2*dir][size] );
  if( B>0 ) C = _check( in[size + 3*dir][size] );
  if( C>0 ) D = _check( in[size + 4*dir][size] );
  if( A ) ret[size + 1*dir][size]=in[size+1*dir][size];
  if( B ) ret[size + 2*dir][size]=in[size+2*dir][size];
  if( C ) ret[size + 3*dir][size]=in[size+3*dir][size];
  if( D ) ret[size + 4*dir][size]=in[size+4*dir][size];

  if( A )                    a = _check( in[size + 1*dir][size - 1] );
  if( B || a>0 )             b = _check( in[size + 2*dir][size - 1] );
  if( C || B>0 && b>0 )      c = _check( in[size + 3*dir][size - 1] );
  if( D || c>0 )             d = _check( in[size + 4*dir][size - 1] );
  if( a>0 && b>0 )           f = _check( in[size + 2*dir][size - 2] );
  if( a>0 && b>0 && (c>0 || f>0) )   g = _check( in[size + 3*dir][size - 2] );
  if( a ) ret[size + 1*dir][size - 1]=in[size + 1*dir][size - 1];
  if( b ) ret[size + 2*dir][size - 1]=in[size + 2*dir][size - 1];
  if( c ) ret[size + 3*dir][size - 1]=in[size + 3*dir][size - 1];
  if( d ) ret[size + 4*dir][size - 1]=in[size + 4*dir][size - 1];
  if( f ) ret[size + 2*dir][size - 2]=in[size + 2*dir][size - 2];
  if( g ) ret[size + 3*dir][size - 2]=in[size + 3*dir][size - 2];

  a=b=c=d=f=g=0;
  if( A )                    a = _check( in[size + 1*dir][size + 1] );
  if( B || a>0 )             b = _check( in[size + 2*dir][size + 1] );
  if( C || B>0 && b>0 )      c = _check( in[size + 3*dir][size + 1] );
  if( D || c>0 )             d = _check( in[size + 4*dir][size + 1] );
  if( a>0 && b>0 )           f = _check( in[size + 2*dir][size + 2] );
  if( a>0 && b>0 && (c>0 || f>0) )   g = _check( in[size + 3*dir][size + 2] );
  if( a ) ret[size + 1*dir][size + 1]=in[size + 1*dir][size + 1];
  if( b ) ret[size + 2*dir][size + 1]=in[size + 2*dir][size + 1];
  if( c ) ret[size + 3*dir][size + 1]=in[size + 3*dir][size + 1];
  if( d ) ret[size + 4*dir][size + 1]=in[size + 4*dir][size + 1];
  if( f ) ret[size + 2*dir][size + 2]=in[size + 2*dir][size + 2];
  if( g ) ret[size + 3*dir][size + 2]=in[size + 3*dir][size + 2];
}

void do_hsection( string * in, int dir, string * ret, int size )
{
  int A,B,C,D,a,b,c,d,f,g;

  A = _check( in[size][size + 1*dir] );
  if( A>0 ) B = _check( in[size][size + 2*dir] );
  if( B>0 ) C = _check( in[size][size + 3*dir] );
  if( C>0 ) D = _check( in[size][size + 4*dir] );
  if( A ) ret[size][size + 1*dir]=in[size][size + 1*dir];
  if( B ) ret[size][size + 2*dir]=in[size][size + 2*dir];
  if( C ) ret[size][size + 3*dir]=in[size][size + 3*dir];
  if( D ) ret[size][size + 4*dir]=in[size][size + 4*dir];

  if( A )                    a = _check( in[size - 1][size + 1*dir] );
  if( B || a>0 )             b = _check( in[size - 1][size + 2*dir] );
  if( C || B>0 && b>0 )      c = _check( in[size - 1][size + 3*dir] );
  if( D || c>0 )             d = _check( in[size - 1][size + 4*dir] );
  if( a>0 && b>0 )           f = _check( in[size - 1][size + 2*dir] );
  if( a>0 && b>0 && (c>0 || f>0) )   g = _check( in[size - 2][size + 3*dir] );
  if( a ) ret[size - 1][size + 1*dir]=in[size - 1][size + 1*dir];
  if( b ) ret[size - 1][size + 2*dir]=in[size - 1][size + 2*dir];
  if( c ) ret[size - 1][size + 3*dir]=in[size - 1][size + 3*dir];
  if( d ) ret[size - 1][size + 4*dir]=in[size - 1][size + 4*dir];
  if( f ) ret[size - 2][size + 2*dir]=in[size - 2][size + 2*dir];
  if( g ) ret[size - 2][size + 3*dir]=in[size - 2][size + 3*dir];

  a=b=c=d=f=g=0;
  if( A )                    a = _check( in[size + 1][size + 1*dir] );
  if( B || a>0 )             b = _check( in[size + 1][size + 2*dir] );
  if( C || B>0 && b>0 )      c = _check( in[size + 1][size + 3*dir] );
  if( D || c>0 )             d = _check( in[size + 1][size + 4*dir] );
  if( a>0 && b>0 )           f = _check( in[size + 2][size + 2*dir] );
  if( a>0 && b>0 && (c>0 || f>0) )   g = _check( in[size + 2][size + 3*dir] );
  if( a ) ret[size + 1][size + 1*dir]=in[size + 1][size + 1*dir];
  if( b ) ret[size + 1][size + 2*dir]=in[size + 1][size + 2*dir];
  if( c ) ret[size + 1][size + 3*dir]=in[size + 1][size + 3*dir];
  if( d ) ret[size + 1][size + 4*dir]=in[size + 1][size + 4*dir];
  if( f ) ret[size + 2][size + 2*dir]=in[size + 2][size + 2*dir];
  if( g ) ret[size + 2][size + 3*dir]=in[size + 2][size + 3*dir];
}

private string calculate_visible_area( string view, string world, string plain )
{
  string *in;
  string *ret;
  int i, size;

  in = explode( view, "\n" );
  size = sizeof( in );

  ret = allocate( size );

  for ( i = 0; i < size; i ++ )
    ret[i] = strmul(" ", size);

  do_vsection( in, 1, ret, size/2 );
  do_vsection( in, -1, ret, size/2 );
  do_hsection( in, 1, ret, size/2 );
  do_hsection( in, -1, ret, size/2 );

  return implode(ret,"\n");
}
/***************************************************************/ 
/*                 MASKING THE ACTUAL PLAIN                    */
/* spare out the visible area                                  */
/***************************************************************/
#define CLIP_A "¥"
#define CLIP_B "§"
private string _clip_view;
private int    _clip_count;
private string clip( string in, int pos )
{
  int len;

  len = strlen( in );
  _clip_view[ pos..(pos+len-1) ] = _clip_count ? strmul(CLIP_A, len) : strmul(CLIP_B, len);

  _clip_count = !_clip_count;

  return in;
}

private string clip_view( string view, string mask )
{
  string data;

  _clip_view = view;
  _clip_count = 0;

  data = implode( map_array( m_indices( mkmapping( efun::explode( mask , "" ) ) - ([ "\n", " " ]) ), #'build_pattern_fun ), "|" );
//        lambda( ({'a}), ({ #'+, ({ #'+, "\\", 'a }), "+"}) ) ) , "|" );

  my_regreplace( mask, data, (#'clip), 1 );
  return _clip_view;
}

/***************************************************************/ 
/*                 ADDING THE VIEWED ZONES                     */
/* which zones can be seen here                                */
/***************************************************************/

mapping _zones_;

filter_zones( mixed key, mixed x, mixed y, mixed size ) {
  return ( _zones_[ key, ZONE_DATA_POSX ] >= x &&
         _zones_[ key, ZONE_DATA_POSX ] < (x + size) &&
         _zones_[ key, ZONE_DATA_POSY ] >= y &&
         _zones_[ key, ZONE_DATA_POSY ] < (y + size) );
}

private string get_visible_zones( string world, string plain, int xpos, int ypos, int size )
{
  string view;
  string *zones;
  string zone;
  int tmp, i ;

  view = (strmul( ( strmul( " ", size ) +"\n" ), size ))[0..<2];

  //write( "XPOS= "+xpos+" YPOS="+ypos+" ("+size+")\n");
  //write( sprintf("test=%O\n",overland_data[ world ][ plain ][ OL_DATA_ZONES ]));

  _zones_ = overland_data[ world ][ plain ][ OL_DATA_ZONES ];

  zones = m_indices( filter_mapping( _zones_, #'filter_zones, xpos, ypos, size ) );
  /*
  zones = filter( overland_data[ world ][ plain ][ OL_DATA_ZONES ],
      (: 
       $2[ ZONE_DATA_POSX ] >= $3 && $2[ ZONE_DATA_POSX ] < ($3 + $5) &&
       $2[ ZONE_DATA_POSY ] >= $4 && $2[ ZONE_DATA_POSY ] < ($4 + $5) :), 
      xpos, ypos, size );
  */

  for ( i = sizeof( zones ) - 1; i >= 0; i-- ) {
    zone = zones[i];
//  foreach( string zone : zones ){
    //      write("dx="+(zones[ zone, ZONE_DATA_POSX ] - xpos )+" dy="+(zones[ zone, ZONE_DATA_POSY ] - ypos )+"\n");
    tmp = (size + 1) * (_zones_[ zone, ZONE_DATA_POSX ] - xpos ) + ( _zones_[ zone, ZONE_DATA_POSY ] - ypos );
    view[ tmp..tmp ] = ( _zones_[ zone, ZONE_DATA_TYPE ] == OLROOM_TYPE_ZONE ?"@":"*" ); 
  }

  view[ (size+1)*(size/2) + (size/2) ] = 'X';
  return view;
}

/***************************************************************/ 
/*                    PREPARE VIEW DATA                        */
/* prepare the datastructure for calculating the view          */
/* [0] location string                                         */
/* [1] lower plain (background)                                */
/* [2] actual plain (the one you are on)                       */
/* [3] view plain (the area you can see)                       */
/* [4] zones that can be seen                                  */
/***************************************************************/ 
public nomask mixed * get_overland_view_data( string position )
{
  mixed *pos;
  mixed *ret;
  int xpos, ypos;
  string lplain;

  pos = unify_position( position );
  if ( !pos )
    return 0;

  ret = allocate( OLVIEW_PLAINS );

  /* [0] location string                                         */
  OLVIEW_POSITION( ret ) = build_unified_position( pos );

  xpos = LOC_VIEW_X( pos ) - OLVIEW_RADIUS;
  ypos = LOC_VIEW_Y( pos ) - OLVIEW_RADIUS;
  //write( "XPOS= "+xpos+" YPOS="+ypos+" \n");

  /* [1] lower plain (background)                                */
  lplain = overland_data[ LOC_WORLD( pos ) ][ LOC_PLAIN( pos ) ][ OL_DATA_LOWER_PLAIN ];
  if ( lplain && overland_data[ LOC_WORLD( pos ) ][ LOC_PLAIN( pos ) ][ OL_DATA_TRANSPARENT ] ){
    OLVIEW_LOWER_PLAIN( ret ) = get_plain_clipping( LOC_WORLD( pos ), lplain, xpos, ypos, OLVIEW_SIZE );
    OLVIEW_LOWER_PLAIN( ret ) = decode_plain_view(  OLVIEW_LOWER_PLAIN( ret ),  LOC_WORLD( pos ), lplain );
  }

  /* [2] actual plain (the one you are on)                       */
  OLVIEW_PLAIN( ret ) = get_plain_clipping( LOC_WORLD( pos ),  LOC_PLAIN( pos ), xpos, ypos, OLVIEW_SIZE );

  /* [3] view plain (the area you can see)                       */
  _plain_data_ = overland_data[ LOC_WORLD( pos ) ][ LOC_PLAIN( pos ) ][ OL_DATA_PLAINDATA ];
  _plain_transparent_ = overland_data[ LOC_WORLD( pos ) ][ LOC_PLAIN( pos ) ][ OL_DATA_TRANSPARENT ];
  OLVIEW_VISIBLE_PLAIN( ret ) = calculate_visible_area( OLVIEW_PLAIN( ret ), LOC_WORLD( pos ),  LOC_PLAIN( pos ) );
  OLVIEW_PLAIN( ret ) = clip_view( OLVIEW_PLAIN( ret ), OLVIEW_VISIBLE_PLAIN( ret ) );

  /* [4] zones that can be seen                                  */
  OLVIEW_ZONES( ret ) = get_visible_zones( LOC_WORLD( pos ),  LOC_PLAIN( pos ), xpos, ypos, OLVIEW_SIZE );

  return ret;
}

