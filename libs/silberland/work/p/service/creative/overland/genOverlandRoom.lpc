#include <moving.h>
#include "overland.h"

//#include "world.h"

//#define VIEW(x) implode(x[0],"\n")

private string location = 0;

private string * cache;
public void invalidate_cache(){ cache = 0; }
public int update_cache()
{
  //   write( "updating cache\n" );
  cache = WORLD->get_overland_view_data( location );
}

create() {
  ::create();
  SetProp(P_INT_SHORT, "In der Overland");
}

public string * _dump_cache(){ return cache; }

//#include "location.lpc"

public int set_location( string loc ){ 
  mixed *data;

  if ( !WORLD->unify_position( loc ) ) return 0;
  if ( location != loc ) invalidate_cache();
  location = "@"+implode( map_array(WORLD->unify_position( loc ), #'to_string ), "|"); 
  update_cache();

  data = WORLD->get_room_description_data( location );
  if ( data ){
    SetProp( P_ENVIRONMENT, ([ ENV_TERRAIN: ROOM_DATA_ROOMLANDSCAPE( data ) ]) );
    SetProp( P_INT_SHORT, ROOM_DATA_DESCRIPTION( data ) );
    /*
    set_type( ROOM_DATA_ROOMTYPE( data ) );
    set_landscape( ROOM_DATA_ROOMLANDSCAPE( data ) );
    TO->set_fp_needed( ROOM_DATA_FPNEEDED( data ) );
    set_long( ROOM_DATA_DESCRIPTION( data ) );
    */
  }
  return 1;
}

public string get_location(){ return location; }

//temp ret = 2 for distinguishing with old OL
int query_overland(){ return (!!location)*2; }

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  string view;

  if ( location ) {
    if ( !cache ) update_cache();
    view = WORLD->calculate_overland_view( cache + ({}), this_player() );
  } else
    view = "Du schwebst im absoluten Nichts!\n";
  return view + "\n" + ::int_long(viewer, viewpoint, shortflag);
}

/* variable fp needed */
private int fp_needed = 10;
public void set_fp_needed( int fp )
{
  fp_needed = abs( fp );
}
public int fp_needed( )
{
  return( fp_needed );
}

