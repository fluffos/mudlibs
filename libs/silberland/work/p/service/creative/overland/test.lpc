string my_regreplace( string text, string pattern,
    closure replacepattern, int flags ) {
  string *matches;
  string match;
  int i, e, arr_len, str_pos, match_len;

  e = get_eval_cost();
  matches = regexplode( text, pattern );
  arr_len = sizeof( matches );
  str_pos = 0;
  for ( i = 0; i < arr_len; i++ ) {
    match = matches[i];
    match_len = strlen( match );
    // every second element is a match
    if ( i % 2 ) {
      matches[i] = funcall( replacepattern, match, str_pos );
    }
    str_pos += match_len;
  }
  e -= get_eval_cost();
  write( "eval_cost: "+(e-3)+"\n" );
  return implode( matches, "" );
}

