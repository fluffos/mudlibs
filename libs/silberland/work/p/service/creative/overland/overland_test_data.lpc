#include <vt100.h>
#include <environment.h>
// for DB handling dummy

/***************************************************************/ 
/*                                                             */
/*[world]                                                      */
/*   [plain]                                                   */
/*      [zone]                                                 */
/*      [zone]                                                 */
/*      [...]                                                  */
/*   [plain]                                                   */
/*      [zone]                                                 */
/*      [...]                                                  */
