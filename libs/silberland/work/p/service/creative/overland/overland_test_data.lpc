/***************************************************************/ 

/***************************************************************/ 
/*                       WORLDS                                */
/* table: tOLworld                                             */
/***************************************************************/ 
public nomask string * query_worlds()
{
  return ({ "techdemo" });
}

/***************************************************************/ 
/*                       PLAINS                                */
/* table: tOLPlains, tOLWorldPlains, TOLWorld                  */
/* param: world .. the world that contains the plains          */
/***************************************************************/ 
public nomask string * query_plains_of_world( string world )
{
  return ({ "tech1", "tech2" });
}

/***************************************************************/ 
/*                       PLAIN                                 */
/* table: tOLPlains                                            */
/* param: plain .. the plains                                  */
/***************************************************************/ 
public nomask string * query_plain( string plain )
{
  return ([ "tech1": ({ "4", "tech1", "+", "1" }), "tech2": ({ "5", "tech2", " ", "1" }) ])[ plain ];
  
}

/***************************************************************/ 
/* table: tOLPlains, tOLPlainData                              */
/* param: plain .. the plain                                   */
/***************************************************************/ 
public nomask mixed * query_plaindata( string plain )
{
  return ([
      "tech1":
        ({
         ({ "#",VT_BLACK+VT_B_WHITE,"#","0",VT_BLACK+VT_B_WHITE,"#","1",TT_ROAD,"1","Somewhere on the OL ...","1","","0" }),
         ({ "%",VT_WHITE+VT_B_YELLOW,"%","0",VT_WHITE+VT_B_YELLOW,"%","1",TT_DESERT,"1","Somewhere on the OL ...","1","","0" }),
         ({ "+",VT_WHITE+VT_B_BLUE,"+","0",VT_WHITE+VT_B_BLUE,"+","1",TT_WATER,"1","Somewhere on the OL ...","1","","0" }),
         ({ ".",VT_YELLOW+VT_B_GREEN,".","0",VT_YELLOW+VT_B_GREEN,".","2",TT_CAVE,"1","Somewhere on the OL ...","1","","0" }),
         ({ "4",VT_YELLOW+VT_B_GREEN,"f","0",VT_YELLOW+VT_B_GREEN,"f","1",TT_FOREST,"1","Somewhere on the OL ...","1","","0" }),
         ({ ":",VT_BLACK+VT_B_WHITE,":","0",VT_BLACK+VT_B_WHITE,":","1",TT_ROAD,"1","Somewhere on the OL ...","1","","0" }),
         ({ "=",VT_BLACK+VT_B_WHITE,"=","0",VT_BLACK+VT_B_WHITE,"=","1",TT_ROAD,"1","Somewhere on the OL ...","1","","0" }),
         ({ "?",VT_BLACK+VT_B_YELLOW,"n","0",VT_BLACK+VT_B_YELLOW,"n","1",TT_HILL,"1","Somewhere on the OL ...","0","Yo can't go there.","0" }),
         ({ "C","",".","0",VT_BLACK+VT_B_YELLOW,"M","3",TT_CAVE,"1","Somewhere on the OL ...","1","","0" }),
         ({ "F",VT_BLACK+VT_B_GREEN,"F","1",VT_BLACK+VT_B_GREEN,"F","1",TT_FOREST,"1","Somewhere on the OL ...","1","","0" }),
         ({ "M",VT_BLACK+VT_B_YELLOW,"M","1",VT_BLACK+VT_B_YELLOW,"M","1",TT_MOUNTAIN,"1","Somewhere on the OL ...","0","Du kannst hier nicht weiter.\n","0" }),
         ({ "N",VT_BLACK+VT_B_YELLOW,"n","0",VT_BLACK+VT_B_YELLOW,"n","1",TT_HILL,"1","Somewhere on the OL ...","1","","0" }),
         ({ "T",VT_B_WHITE+VT_BLACK,"+","1",VT_B_WHITE+VT_BLACK,"+","1",TT_HOUSE,"1","Somewhere on the OL ...","0","Your way is blocked by a fortification tower.","0" }),
         ({ "c","",":","0",VT_BLACK+VT_B_YELLOW,"M","3",TT_CAVE,"1","Somewhere on the OL ...","1","","0" }),
         ({ "f",VT_B_GREEN+VT_YELLOW,"f","0",VT_B_GREEN+VT_YELLOW,"f","1",TT_FOREST,"1","Somewhere on the OL ...","1","qwe","0" }),
         ({ "n",VT_BLACK+VT_B_YELLOW,"n","0",VT_BLACK+VT_B_YELLOW,"n","1",TT_HILL,"1","Somewhere on the OL ...","1","","0" }),
         ({ "w",VT_B_WHITE+VT_BLACK,"|","1",VT_B_WHITE+VT_BLACK,"|","1",TT_HOUSE,"1","Somewhere on the OL ...","0","Your way is blocked by a stonewall.","0" }),
         ({ "~",VT_WHITE+VT_B_BLUE,"~","0",VT_WHITE+VT_B_BLUE,"~","1",TT_WATER,"1","Somewhere on the OL ...","1","","0" }) }),
      "tech2":
        ({
         ({ "#",VT_BLUE+VT_B_WHITE,"#","0",VT_BLUE+VT_B_WHITE,"#","1",TT_PLAIN,"1","Somewhere on the OL ...","0","","0" }),
         ({ ":",VT_BLACK+VT_B_WHITE,":","0",VT_BLACK+VT_B_WHITE,":","1",TT_ROAD,"1","Somewhere on the OL ...","1","","0" }),
         ({ "C",VT_TA_U,".","0",VT_BLACK+VT_B_YELLOW,"M","3",TT_CAVE,"1","Somewhere on the OL ...","1","","0" }),
         ({ "M",VT_BLACK+VT_B_YELLOW,"M","1",VT_BLACK+VT_B_YELLOW,"M","1",TT_MOUNTAIN,"1","Somewhere on the OL ...","1","","0" }),
         ({ "N",VT_BLACK+VT_B_YELLOW,"n","0",VT_BLACK+VT_B_YELLOW,"n","1",TT_HILL,"1","Somewhere on the OL ...","1","","0" }),
         ({ "n",VT_BLACK+VT_B_YELLOW,"n","0",VT_BLACK+VT_B_YELLOW,"n","1",TT_HILL,"1","Somewhere on the OL ...","1","","0" })
         }) 
   ])[plain];
}

/***************************************************************/ 
/* table: tOLPlains, tOLWorldPlains                            */
/* param: plain .. the plain                                   */
/***************************************************************/ 
public nomask string query_upper_plain( string plain )
{
  return ([ "tech1": "tech2" ])[plain];
}

/***************************************************************/ 
/* table: tOLPlains, tOLWorldPlains                            */
/* param: plain .. the plain                                   */
/***************************************************************/ 
public nomask string query_lower_plain( string plain )
{
  return ([ "tech2": "tech1" ])[plain];
}

/***************************************************************/ 
/*                       MAPS                                  */
/* table: tOLMaps, tOLPlains                                   */
/* param: plain .. the plain that contains the maps            */
/***************************************************************/ 
public nomask string * query_maps_on_plain( string plain )
{
  return ([ "tech1": ({ "techmap1" }), "tech2": ({ "techmap2" }) ])[plain];
}

/***************************************************************/ 
/*                       MAP                                   */
/* table: tOLMaps                                              */
/* param: map .. the map                                       */
/***************************************************************/ 
public nomask string * query_map( string map )
{
  return ([
      "techmap1":
        ({
         "3","techmap1","0","0",
         "++++++++++++++++++++++++~~~~~~~~~~~~++~~~~~~~~++++\n"
         "+++~~~~++++++++++~~~~~~~~..........~~~......%~~+++\n"
         "++~~%n~~++++~~~~~~~................T......%%%%%~~+\n"
         "+~~%Mn~+++++~~%%%.......:~...ffff..w....%%%%%%%%~+\n"
         "++~nnn~+++~~%%%%........:ff.....f..w.....%%%%%%%~+\n"
         "++~~~~++~~~%%.fffff::::::ffffff....w....%%%%%%~~~+\n"
         "+++++++~~%%.ffFFnNN:ffffffff44Fff..T..%%%%%%%~~~++\n"
         "+++++~~~~%ffFFFFnNM:NNnnfFF44Ffff......%%%%%~~++++\n"
         "++++++~~~ffFFFFnNNM:NNNNNNn4nnnnnnnn...%%%%~~~~+++\n"
         "+++++~~~ffFFnnnNNMMcMMMMNNNNNNNNNNNnn......NN~~~++\n"
         "+++~~~~fff.MMMMMMMMcMMMMMNNNMMMMNNNNNn.nNNNN~~~+++\n"
         "++++~~.ffMMMMMMMMMMcMMMMMMMMMMMMMMNNNNNNNN~~~~~+++\n"
         "+++++~..fMMMMMMMMCCCCCMMccccMMMMMMNNnnn%~~~~~~~~++\n"
         "++++~~..MMMMMMMCCCCCCCCMcMMcMMMMMNNnnn%%~~~~~~~~++\n"
         "++++~~....MMMMCCCCCCCCCCCMMcccMMNNnnnnnn%~~~~~~+++\n"
         "++++~~...MMMMMCCCCCCCCCCMMMcMMMMNNnnnNNNNN~~~~++++\n"
         "+++~.....nMMMMMCCCCCCCMMMMMcMMMMNNNNNNMMMNNN++++++\n"
         "++~....::nMMMMMMMMMMMMMMMMMccccMMMMMMMMMMMMN++++++\n"
         "++~~....:.nMMMMMMMMMMMMMMMMMMMMMNNNNNMMMMMNN++++++\n"
         "+~....~~=~~~~MMMMMMMMMMMMMNNNNNNN44NNNNNNNNn~+++++\n"
         "+~...~~.:...nnMMMMMMMMMNNnnnnnn444444nnnNnnn~~++++\n"
         "+~~~~~..:....fnnnNNMMMNn....44444444444nnn..~~++++\n"
         "+~...~.....::f44NNNnnnn........FFF44444Ff..~++++++\n"
         "+~~..~....ff:::##44fff.~~~~~~~..FFFFFFFf..~~~~++++\n"
         "++~~~~..fffFFF44##::..~~~++~~~~..FFFFf..~~~~~+++++\n"
         "++~~.~..fffF444444f..~~~+++++~~~.ffff.~~~~++++++++\n"
         "+++~~~~~~~~fFFf~~~~~~~~~+++++~~~~....~~~++++++++++\n"
         "+++++++~~~~~~~~~~~~~~~++++++++~~~~~~~~~+++++++++++\n"
         "+++++++++++~~~~~++~+++++++++++++++++++++++++++++++"
        }),
      "techmap2":
        ({
         "4","techmap2","0","0",
         "                                             \n"
         "     #                                       \n"
         "   ###                                       \n"
         "  ##n##                                      \n"
         "  ####                                       \n"
         "   #                                         \n"
         "                                             \n"
         "                                             \n"
         "                                             \n"
         "                 nNnnNNnNNNnnn               \n"
         "             nnNnNMMMMMMMNNNnnn              \n"
         "           nnNMMMMMMMMMMMMMMMNNn             \n"
         "          nNNMMMM    CMMMMMMMMNNn            \n"
         "          nNNMMC     CCMMMMMMMNn             \n"
         "           NMMCC      CCCMMMMMMN             \n"
         "          nNMMCC     CCCMMMMMMN              \n"
         "          nNNMMCCCCCCCMMMMMMMMMN       nn  # \n"
         "           nNNMMMMMMMMMMMMMMMM::::::::::n### \n"
         "             NNNNMMMMMMMNNMMMMMNNn   NnnNM#  \n"
         "                NNNNNNnn   nNNNn      #####  \n"
         "                 NNNn       nn         ##    \n"
         "                                             "
        })
      ])[map];
}

/***************************************************************/ 
/*                       ZONES                                 */
/* table: tOLZones, tOLPlains                                  */
/* param: plain .. the plain that contains the maps            */
/***************************************************************/ 
public nomask string * query_zones_of_plain( string plain )
{
  return ([
      "tech1": ({ "techup1", "techup2" }),
      "tech2": ({ "techdown1", "techdown2" })
      ])[plain];
}

/***************************************************************/ 
/*                       ZONE                                  */
/* table: tOLZones, tOLPlains, tOLWorld, tOLWorldPlains        */
/* param: zone .. the zone                                     */
/***************************************************************/ 
public nomask string * query_zone( string zone )
{
  return ([
      "techup1": ({ "4", "techup1", "techdemo", "tech1", "", "17", "30", "2", "", ">", "1", "", "", "", "" }),
      "techup2": ({ "6", "techup2", "techdemo", "tech1", "", "15", "14", "2", "", ">", "1", "", "", "", "" }),
      "techdown1": ({ "5", "techdown1", "techdemo", "tech2", "", "17", "30", "2", VT_BLACK, "<", "2", "", "", "", "" }),
      "techdown2": ({ "7", "techdown2", "techdemo", "tech2", "", "15", "14", "2", VT_TA_U, "<", "2", "", "", "", "" }),
      ])[zone];
}

