inherit "std/thing";

#include <properties.h>
#include <defines.h>

create()
{
  if(IS_BLUE(ME)) return;
  ::create();
  SetProp(P_SHORT, "Ein altes Exemplar des Planeditors");
  SetProp(P_LONG,
    "Du haelst einen alten Planeditor in Haenden. Eigentlich ist es voellig "
    "unklar, wie Du zu diesem Exemplar gelangt bist, das Beste ist wohl, "
    "Du entsorgst ihn beim naechstgelegenen Muellschlucker und holst Dir "
    "einen neuen aus dem Seherladen.");
  SetProp(P_NAME,"Planeditor");
  SetProp(P_NAME_ADJ,"alt");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  AddId(({"planeditor", "editor","alter$planeditor"}));
  AddAdjective(({"alt","alte"}));
}

reset()
{
  if(IS_BLUE(ME)) return;
  if(!environment(ME)) return remove();
  if(!interactive(environment(ME)))
  {
    if(IS_BLUE(environment(ME)))
      tell_room(environment(ME), "Ein Planeditor zerfaellt zu Staub.\n");
    return remove();
  }
  return 1;
}

mixed _set_autoloadobj(mixed data)
{
  object ob;
  if (this_player())
  {
    ob=clone_object("/p/service/obj/planedit");
    ob->move(this_player());
    ob->SetProp(P_AUTOLOADOBJ, data);
    ME->remove();
  }
}

