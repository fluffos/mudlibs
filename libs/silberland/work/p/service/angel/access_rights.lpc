inherit "/p/service/iwo/access/ac_client_fun.lpc";

varargs int access_rights(string euid, string file, int readflag, int def, string fun)
{
  int retval;
  string * files;
  mixed    parts, valid;

  valid = ({ "angel", "hiri", "yara" });

  // Lesen darf generell _jeder_ 
  if ( readflag )
     return 1;

  retval = ::access_rights(euid, file, readflag, def);
  
  if(!retval && (file[0..9] == "haustiere/"))
    {
      parts = explode (euid, ".");
      
      tell_object(find_player("protheg"), "Haustiere ACCESS: "+euid+", "+file+"\n");
      
      if(sizeof(parts & valid))
	retval = 1;
    }
  
  return retval;
}
