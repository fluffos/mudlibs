inherit "std/thing";

#include "buch.h"
#include <defines.h>
#include <moredef.h>


int offen;
int seite;
int seitenzahl;
int seitzahl;

int lesbuch();
int titel();
int getseitzahl();

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
//  SUID;
  offen = 0;
  seite = 0;
  seitenzahl = getseitzahl();
  SetProp(P_SHORT, "Ein Buch");
  SetProp(P_LONG,
      "Du haeltst ein wunderschoenes kleines, mit Kunstfell bezogenes Buch "
      "in Deinen Haenden. Es fuehlt sich wunderbar weich an. In diesem Buch "
      "kannst Du nachlesen, wie man sein Haustier hegt und pflegt. In einer "
      "hellen, fein verschnoerkelten Schrift steht auf dem Einband: "
      "Mein Haustier.\n");
  SetProp(P_NAME,"Buch");
  AddId("buch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT,200);
  SetProp(P_NOBUY, 1);
  AddCmd(({"lies","lese"}), "lies");
  AddCmd("oeffne","oeffne");
  AddCmd("schliesse","schliesse");
  AddCmd("blaettere","blaettere");
}

int oeffne(string str) {
  string was;
  if (!str) return 0;
  if (!id(str)) return 0;
  if (offen) write("Es ist schon geoeffnet.\n");
  if (!offen) {
    offen=1;
    write("Du oeffnest das Buch auf Seite 1.\n");
    say(TPN + " oeffnet ein Buch.\n",TP);
    seite=1;
  }
  return 1;
}

int schliesse(string str) {
  string was;
  if (!str) return 0;
  if (!id(str)) return 0;
  if (!offen) write("Es ist schon geschlossen.\n");
  if (offen) {
    offen=0;
    write("Du schliesst das Buch wieder.\n");
    say(TPN + " schliesst ein Buch wieder.\n",TP);
    seite=0;
  }
  return 1;
}

int blaettere(string str) {
  if (!offen) return 0;
  if (!str) return 0;
  if (sscanf(str,"zu seite %d",seitzahl)<1) return 0;
  if ((seitzahl < 1) || (seitzahl > seitenzahl)) return 0;
  if (((seitzahl/2)*2) == seitzahl) seitzahl++;
  write("Du blaetterst zu Seite "+seitzahl+".\n");
  say(TPN + " blaettert in einem Buch.\n");
  seite=seitzahl;
  return 1;
}

int lies(string str)
{
  string was;
  notify_fail("Was willst Du lesen? Syntax: LIES <ETWAS>.\n");
  if(!str) return 0;
  if(sscanf(str,"%s",was)!=1) return 0;
  if (!id(str)) return 0;
  say(TPN + " liest in einem Buch.\n",TP);
  if (offen) {
    lesbuch();
  } else {
    titel();
  }
  return 1;
}

int lesbuch() {
  TP->more(BUCHDIR+"seite"+seite);
  seite+=2;
  if (seite > seitenzahl) {
    offen=0;
    write("Du hast das Buch fertig gelesen und schliesst es.\n");
    say(TPN + " hat ein Buch fertig gelesen und schliesst es.\n",TP);
    seite=0;
  } else {
    write("Du blaetterst um.\n");
    say(TPN + " blaettert um.\n",TP);
  }
  return 1;
}

int titel() {
  TP->more(BUCHDIR+"titel");
  return 1;
}

string buchinfo() {
  return "Mein Haustier";
}

int getseitzahl() {
  return 19;
}
