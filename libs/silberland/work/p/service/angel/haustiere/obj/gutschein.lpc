/********************************************************************
 * Klasse: Gutschein fuer Tierhandlungen                            *
 * Datei: /p/service/angel/haustiere/obj/gutschein.c                *
 * Letzte Ueberarbeitung: 21.12.2002                                *
 ********************************************************************/

/* 20041022 Koomi Bugfix, Autoloadobj kann sich unabsichtlich selber
                  loeschen, das wird nun abgefangen
 */

inherit "/std/thing";

#include <properties.h>
#include <moving.h>

long ()
{
  return break_string ("Diesen Gutschein kannst Du in jeder Tierhandlung im Silberland als "
         "Zahlungsmittel fuer Tiere verwenden. Fuer Gegenstaende hat er jedoch "
         "keine Gueltigkeit. Der Gegenwert betraegt "+QueryProp(P_VALUE)+" Muenzen.", 78);
}

short ()
{
   return "Ein Gutschein ueber "+QueryProp(P_VALUE)+" Muenzen.\n";
}

mixed _set_autoloadobj(mixed value)
{
   if ( intp(value) )
    if (value > 0)
      SetProp(P_VALUE, value);

   return value;
}

void create ()
{
   ::create();

   SetProp (P_NAME, "Gutschein");
   SetProp (P_GENDER, MALE);
   SetProp (P_SHORT, "Ein Gutschein");
   SetProp (P_LONG,  "Diesen Gutschein kannst Du in jeder Tierhandlung im Silberland als "
                     "Zahlungsmittel fuer Tiere verwenden. Fuer Gegenstaende hat er jedoch "
                     "keine Gueltigkeit.");
   SetProp (P_NOBUY, 1);
   SetProp (P_VALUE, 10);
   SetProp( P_MATERIAL, MAT_PAPER );
   SetProp (P_INFO, "Dieser Gutschein birgt keine besonderen Geheimnisse." );
   SetProp (P_WEIGHT, 1);

   SetProp(P_AUTOLOADOBJ, 10);
   seteuid(getuid(this_object()));

   AddId(({"gutschein", "petshop\nvoucher"}));
}