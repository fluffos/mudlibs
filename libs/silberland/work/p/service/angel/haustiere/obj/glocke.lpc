/********************************************************************
 * Klasse: Konfigitem fuer das Haustier                             *
 * Datei: /p/service/angel/haustiere/obj/glocke.c                   *
 * Letzte Ueberarbeitung: 21.12.2002                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet_item.lpc";

#include <properties.h>
#include <moving.h>
#include "/p/service/angel/haustiere/std_pet.h"

void _delay ( string dummy )
{
  ::BringPetBack(dummy);
}

int BringPetBack ( string args )
{
   if ( args == "mit glocke" || args == "mit gloeckchen" )
   {	
     write ("Du klingelst mit Deinem Gloeckchen.\n");
     tell_room (environment(this_player()), this_player()->Name(WER)+
                " klingelt mit einem goldenen Gloeckchen.\n", ({this_player()}));
     call_out ("_delay", 2, args);
     return 1;
   }
   notify_fail ("Womit moechtest Du klingeln?\n");
   return 0;   
}

void create ()
{
   if (!is_clone(this_object())) return;
   ::create();

   SetProp (P_NAME, "Gloeckchen");
   SetProp (P_SHORT, "Eine kleines, goldenes Gloeckchen");
   SetProp (P_LONG,  "Dieses goldene Gloeckchen hast Du wohl in einer Tierhandlung "+
                     "bekommen, als Du Dein Haustier ausgesucht hast.");

   SetProp (P_INFO, "Mit diesem Gloeckchen kannst Du folgendes tun:\n"+
                    "----------------------------------------------\n"+
                    "laeuten:   Damit kannst Du Dein Haustier wieder zurueckholen.\n"+
                    "pethelp:   Dieses Kommando zeigt Dir einen Hilfetext an.\n"+
                    "petconfig: Damit kannst Du Dein Haustier veraendern.\n"
                    "entlasse <haustiername> fuer immer:\n"
                    "!!! WARNUNG !!! kann man nicht rueckgaengig machen !!! WARNUNG !!!\n\n" );
   SetProp (P_WEIGHT, 1);
   SetProp (P_GENDER, NEUTER);

   seteuid(getuid(this_object()));

   AddId(({"glocke", "gloeckchen"}));

   AddCmd ( ({"laeute", "klingel", "klingle"}) , "BringPetBack");
}