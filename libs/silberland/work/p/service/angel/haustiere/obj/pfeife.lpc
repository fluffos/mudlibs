/********************************************************************
 * Klasse: Konfigitem fuer das Haustier                             *
 * Datei: /p/service/angel/haustiere/obj/pfeife.c                   *
 * Letzte Ueberarbeitung: 22.12.2002                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet_item.lpc";

#include <properties.h>
#include <moving.h>
#include "/p/service/angel/haustiere/std_pet.h"

void _delay ( string args )
{
  ::BringPetBack(args);
}

int BringPetBack ( string args )
{
   if ( args == "auf pfeife" || args == "auf pfeifchen" )
   {
     write ("Du spielst auf Deinem Pfeifchen.\n");
     tell_room (environment(this_player()), this_player()->Name(WER)+
                " spielt auf einem schwarzen Pfeifchen.\n", ({this_player()}));
     call_out ("_delay", 2, args);
     return 1;
   }
   notify_fail ("Worauf moechtest Du spielen?\n");
   return 0;
}

void create ()
{
   if (!is_clone(this_object())) return;
   ::create();

   SetProp (P_NAME, "Pfeifchen");
   SetProp (P_SHORT, "Eine kleines, schwarzes Pfeifchen");
   SetProp (P_LONG,  "Dieses schwarze Pfeifchen hast Du wohl in einer Tierhandlung "+
                     "bekommen, als Du Dein Haustier ausgesucht hast.");

   SetProp (P_INFO, "Mit diesem Pfeifchen kannst Du folgendes tun:\n"+
                    "---------------------------------------------\n"+
                    "spielen:   Damit kannst Du Dein Haustier wieder zurueckholen.\n"+
                    "pethelp:   Dieses Kommando zeigt Dir einen Hilfetext an.\n"+
                    "petconfig: Damit kannst Du Dein Haustier veraendern.\n"
                    "entlasse <haustiername> fuer immer:\n"
                    "!!! WARNUNG !!! kann man nicht rueckgaengig machen !!! WARNUNG !!!\n\n" );

   SetProp (P_WEIGHT, 1);
   SetProp (P_GENDER, NEUTER);

   seteuid(getuid(this_object()));

   AddId(({"pfeife", "pfeifchen"}));

   AddCmd ( ({ "spiele", "spiel" }) , "BringPetBack");
}