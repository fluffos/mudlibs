inherit "std/room";

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>

int clean_up( int ref )
{
  return 1;
}

int remove ()
{
   return 0;
}

void create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INT_SHORT, "Der Schlafraum der Haustiere" );
  SetProp(P_INT_LONG,
    "Du befindest Dich im Schlafraum aller Haustiere wo sie geduldig der Rueckkehr ihrer Besitzer harren.\n"
  );
}