inherit "/p/service/iwo/access/ac_client_fun.lpc";

varargs int access_rights(string euid, string file, int readflag, int def, string fun)
{
  int retval;
  string * files;
  mixed    parts, valid;

  valid = ({ "angel", "protheg", "hiri", "koomi", "yara" });


  // Lesen darf generell _jeder_  --WICHTIG WICHTIG WICHTIG--
  if ( readflag )
     return 1;

  if ((fun == "save_object") && (file[0..4] == "save/"))
    return 1;

  retval = ::access_rights(euid, file, readflag, def);

  if ( !retval ) {
    parts = explode (euid, ".");
    if ( sizeof(parts & valid) )
       retval = 1;
  }

  if (file[0..9]=="npc/kwlil_" && euid == "lilyth")
    retval = 1;

  return retval;
}
