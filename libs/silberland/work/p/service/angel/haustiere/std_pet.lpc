// Unser Hautier steht dem Besitzer bei!
// (sofern es erlaubt ist)
void InformDefend(object enemy)
{
   if ( wants_help && objectp(enemy) && !enemy->Id("NOPETATTACK") )
      Kill(enemy);
}

// Werte beim Reset zuruecksetzen
reset ()
{
   ::reset();
   greeted_players = 0;
   reported_players = 0;
   food_status = 0;
   play_status = 0;
   if ( !objectp( find_player( QueryProp( P_PET_OWNER_NAME ) ) ) )
      go_to_sleep();
}

/************** Lade- & Speicherroutinen **************/

// Extrahiert den Namen des Haustieres aus den Dateinamen der savefiles
string FindPet( string uid )
{
   int i, max;
   string name, player;
   mixed files;

   files = get_dir(SAVEFILE_DIR+"*");
   max = sizeof(files);
   for (i=0; i < max; i++)
   {
      sscanf(files[i], "pet_%s_%s.o", name, player);
      if (player == uid)
         return name;
   }
}

// Extrahiert den Namen des Besitzers aus den Dateinamen der savefiles
string FindOwner( string uid )
{
   int i, max;
   string name, player;
   mixed files;

   files = get_dir(SAVEFILE_DIR+"*");
   max = sizeof(files);
   for (i=0; i < max; i++)
   {
      sscanf(files[i], "pet_%s_%s.o", name, player);
      if (name == uid)
         return player;
   }
}

varargs string QuerySaveFileName( string name, string uid )
{
     return sprintf(
	 SAVEFILE_DIR+"pet_%s_%s",
	 (name || lower_case(QueryProp(P_NAME))),
	 (uid || lower_case(QueryProp(P_PET_OWNER_NAME))) );
}

// Zum Sichern der Haustierdaten
int SavePet ()
{
   string err;

   if( stringp ( QueryProp(P_PET_OWNER_NAME) ) )
   {
     save_object( QuerySaveFileName() );
     return 1;
   }
   return 0;
}

// Zum Laden der Haustierdaten
object RestorePet ( string uid )
{
   string name;

   name = FindPet( uid );
   if ( stringp( name ) )
   {
      restore_object ( QuerySaveFileName(name, uid) );
      set_living_name (lower_case(Name(RAW)));
      AddId( ({"haustier", "\nhaustier", "NOWIMPY"}) );
      AddId(lower_case(Name(RAW)));
      AddId(SID_NOLEARN);
      // Emergency-Fix wegen neuem AddCmd:
      SetProp( P_COMMANDS, (["nenne":({"give_name"});({0});({0}),"taufe":({"give_name"});({0});({0}),"benenne":({"give_name"});({0});({0})]) );
      return this_object();
   }
   else
   {
	  if ( find_player (uid) )
	     tell_object ( find_player (uid), "Dein Haustier ist leider unauffindbar!\n" );
	  remove();
   }
}

// Funktion zum Modifizieren der Loyalitaet
void ModifyLoyality ( int joy)
{
  int loyality;
  object owner, tool;

  loyality = QueryProp(P_PET_LOYALITY);

  loyality += joy;

  if ( loyality > 100 )
     loyality = 100;

  write_file( "/p/service/angel/haustiere/log/loyality.log",sprintf("%s loyality of "+Name(WER)+" towards %s changes %d -> %d (Verb: %s).\n",dtime(time()), capitalize(QueryProp(P_PET_OWNER_NAME)), QueryProp(P_PET_LOYALITY), loyality, to_string(query_verb()) ) );

  if ( loyality < 0 )
  {
	 owner = find_player ( QueryProp(P_PET_OWNER_NAME) );
	 if ( objectp (owner) )
	 {
		tool = present ( "\nstd_pet_item", owner );

		if ( objectp (tool) )
		   tool->remove();

	    tell_object ( owner, "Du hast das Vetrauen von "+Name(WEM)+" zu "+
	              "Dir nun voellig zerstoert!\n"+Name(WER)+" verlaesst Dich.\n" );
	    say ( owner->Name()+" hat das Vetrauen von "+Name(WEM)+" voellig zerstoert!\n"
	                       +Name(WER)+" verlaesst "+owner->name()+".\n", ({ owner }) );
     }
	 rm( QuerySaveFileName() + ".o" );
	 call_out ("remove", 0);
	 return;
  }
  SetProp (P_PET_LOYALITY, loyality);
}

// Entfernt Sonderzeichen aus einem String
string remove_special_keys( string text )
{
   int i;
   string result;

   result = "";

   for ( i = 0; i < strlen(text); i++ )
   {
      if ( text[i] == ' ' || text[i] == ''' || ( text[i] >= 'A' &&  text[i] <= 'Z') || ( text[i] >= 'a' &&  text[i] <= 'z') )
         result += text[i .. i];
   }
   return result;
}

/****** Befehle an das Haustier ***********/

// Funktion zum Ausfuehren eines allgemeinen Kommandos
void do_cmd ( string cmd )
{
   while ( strlen(cmd) && (  cmd[0] < 'A' || (cmd[0] > 'Z' && cmd[0] < 'a') || cmd[0] > 'z') )
         cmd = cmd[1 .. strlen(cmd)-1];

   if (!command_me ( cmd ))
      command_me("emote schaut verwirrt drein.");
}

varargs string str_replace ( string text, string to_replace, string replacement, int sensitive )
{
   mixed parts;
   int i;

   if ( !stringp ( text ) || !stringp ( to_replace ) || !stringp ( replacement ) )
      return text;

   parts = explode ( text, " ");

   for (i=0; i < sizeof(parts); i++)
   {
      if ( !sensitive )
      {
         if ( lower_case(parts[i]) == lower_case(to_replace) )
            parts[i] = replacement;
      }
      else
      {
         if ( parts[i] == to_replace )
            parts[i] = replacement;
      }
   }
   return implode (parts, " ");
}

// Das Haustier erhaelt die Moeglichkeit auf Saetze, welche mit seinem
// Namen beginnen zu reagieren:
void catch_tell( string msg )
{
   string cmd_string, original_string, pet_name;
   mixed commands, cmd_keys, tmp_keys, owner_name;
   int i, j, test;

   if ( !stringp ( QueryProp(P_PET_OWNER_NAME) ) || !strlen(msg) > 2 || !objectp (this_player()) )
      return 0;

   msg = str_replace ( msg[0 .. strlen(msg)-2], "mich", lower_case(this_player()->name()), 0 );

   if ( !( sscanf (msg, "%s sagt: %s %s", owner_name, pet_name, original_string) == 3 ) &&
        !( sscanf (msg, "%s teilt Dir mit: %s", owner_name, original_string) == 2 ))
      return 0;

   if ( !stringp (owner_name) )
      return 0;

   owner_name = explode(owner_name, " ")[<1];

   if ( owner_name != capitalize ( QueryProp(P_PET_OWNER_NAME) ) ||  lower_case (owner_name) != lower_case(this_player()->query_real_name()))
      return 0;

   if ( (strstr ( msg, "teilt Dir mit:") > 0) && (strstr ( msg, "teilt Dir mit:") < strstr ( msg, original_string)) )
   {
	   if ( environment (this_player()) != environment (this_object()) )
	   {
	      write( Name()+" ist doch gar nicht anwesend!\n");
	      return 0;
       }

	   write ("Du gibtst "+name(WEM)+" ein Zeichen.\n");
	   say ( capitalize(owner_name) + " gibt "+name(WEM)+" ein Zeichen.\n", ({ this_player() }));
   }
   else
   {
	   if ( !stringp (pet_name) || strstr (lower_case(pet_name), lower_case(name(RAW))) == -1)
          return 0;
   }

   cmd_string = remove_special_keys (original_string);

   commands = explode (cmd_string, " ");

   cmd_keys =  QueryProp(P_PET_COMMANDS);

   for (i=0; i < sizeof(cmd_keys); i += 2)
   {
	  test = 1;
	  tmp_keys = commands;
	  for (j=0; j < sizeof(cmd_keys[i+1]); j++)
	  {
		 if ( member (tmp_keys, cmd_keys[i+1][j]) == -1 )
		    test = 0;
		 else
		    tmp_keys -= ({ cmd_keys[i+1][j] });
	  }
	  if (test)
	  {
	     call_out ( cmd_keys[i], 0, tmp_keys );
	     return;
      }
   }

   while ( cmd_string[0] == ' ' )
   {
	  cmd_string = cmd_string[1 .. strlen(cmd_string)-1];
   }

   if (member(QueryProp(P_PET_FORBIDDEN_CMDS), commands[0]) == -1)
   {
      call_out ( "do_cmd", 0, original_string );
   }
   else
   {
      call_out ( "do_cmd", 0, "emote will das nicht.");
      return;
   }
}

// Funktion zum Aendern eines Kommandos
void ChangeCommand ( string key, string command )
{
   int pos;
   mixed cmds, values;

   cmds = QueryProp(P_PET_COMMANDS);
   pos = member ( cmds, key );

   if ( pos == -1 || pos > sizeof(cmds) )
      return;

   values = explode ( command, " ");

   if ( sizeof ( values ) )
   {
      cmds[pos+1] = values;
      SetProp(P_PET_COMMANDS, cmds);
   }
}

/******** Reaktionsgestaltung des Haustiers *********/

varargs string QueryDein(int casus,int gender,int zahl)
{
  return
    ({ ({({"dein", "deine"}),({"dein", "deine"}),({"deine", "deine"})}),
       ({({"deines","deiner"}),({"deines","deiner"}),({"deiner","deiner"})}),
       ({({"deinem","deinen"}),({"deinem","deinen"}),({"deiner","deinen"})}),
       ({({"dein","deine"}),({"deinen","deine"}),({"deine","deine"})})
       })[casus][gender][zahl];
}


// einfacher Parser
string parse_text ( string str )
{
   int pos, casus;
   string name_string;

   if ( !stringp (str) )
      return 0;

   do
   {
      if ( (pos = member (str, '$')) != -1 )
      {
      	 if ( strlen(str) < pos+7 ) // in dem Fall liegt ein Fehler in der Syntax vor.
      	 {
      	    write ("Fehler: Inkorrekte Anzahl von Parametern fuer '$'!\n");
      	    return str;
      	 }

         name_string = "";

         casus = to_int(str[pos+6 .. pos+6])-1; // Wenn nicht angegeben ist es 0

         if (casus < 0 || casus > 4)
            casus = 0;

         if ( str[pos+1] == 's' )
         {
            if ( str[pos+2 .. pos+5] == "name" )
               name_string = capitalize(this_player()->QueryDu(casus));
            if ( str[pos+2 .. pos+5] == "pron" )
               name_string = capitalize(this_player()->QueryDu(casus));
            if ( str[pos+2 .. pos+3] == "bf" )
               name_string = capitalize(QueryDein( casus, to_int(str[pos+4 .. pos+4]), to_int(str[pos+5 .. pos+5])  ));
         }

         if ( str[pos+1] == 'o' )
         {
            if ( str[pos+2 .. pos+5] == "name" )
               name_string = this_player()->name(casus);
            if ( str[pos+2 .. pos+5] == "pron" )
               name_string = this_player()->QueryPronoun(casus);
            if ( str[pos+2 .. pos+3] == "bf" )
               name_string = this_player()->QueryPossPronoun( to_int(str[pos+4 .. pos+4]), casus, to_int(str[pos+5 .. pos+5])  );
         }

         if ((pos-1 >= 0) && (pos+7 < strlen(str)))
            str = str[0 .. pos-1] + name_string + str[pos+7 .. strlen(str)-1];
         else
         {
            if ( (pos-1 < 0) && (pos+7 >= strlen(str)) )
               return name_string;

            if ( (pos-1 < 0) )
               str = capitalize(name_string) + str[pos+7 .. strlen(str)-1];

            if ( (pos+7 >= strlen(str)) )
               str = str[0 .. pos-1] + name_string;
         }
      }
   } while (pos != -1);
   return str;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
     return;

  if ( gruppe == "fies" && (QueryProp(P_PET_OWNER_NAME) == this_player()->query_real_name()) )
     ModifyLoyality (-1);

  if ( !QueryProp(P_PET_REACTIONS)[gruppe] )
     return;
  else
     call_out("react", 0, parse_text(QueryProp(P_PET_REACTIONS)[gruppe, 0]), parse_text(QueryProp(P_PET_REACTIONS)[gruppe, 1]) );
}

void react(string victim, string others)
{
  if (present(this_player(), environment(this_object())))
  {
    if( !others ) others = victim;
    tell_object(this_player(), break_string(Name(WER, 1) + " "+victim, 78) );
    tell_room(environment(this_object()), break_string(Name(WER, 1)+" "+others, 78), ({this_player(),this_object()}) );
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


// Funktion zum anpassen der Haustier-Reaktionen
void ModifyReaction ( string group, string victim, string others )
{
   if ( member ( REACTION_GROUPS, group ) != -1 )
      SetProp(P_PET_REACTIONS, QueryProp(P_PET_REACTIONS) + ([ group : victim; others ]) );
}

/********* Zugriffsfunktionen ***********/

void AddFriend( string name )
{
   friends_list += ({ lower_case(name) });
}

void RemoveFriend( string name )
{
   friends_list -= ({ lower_case(name) });
}

mixed GetFriends ()
{
   return friends_list;
}

void SetFriends ( mixed friends )
{
   friends_list = friends;
}

int get_play_status ()
{
   return play_status;
}

void set_play_status ( int value )
{
   play_status = value;
}

mixed get_prey_list ()
{
   return prey_list;
}

string QueryVersion ()
{
   return QueryProp(P_PET_VERSION);
}


/********** Logging *************/

AddExp( int e )
{
  int experience;

  experience = QueryProp(P_PET_XP);
  if((experience+=e) < 0) experience = 0;
  return SetProp(P_PET_XP, experience);
}

varargs int StopHuntFor( mixed arg, int silent )
{
  if (IsEnemy (arg) )
  {
    call_out ( "ExploreBodies", 0 );
    write_file( "/p/service/angel/haustiere/log/pet_xp.log",sprintf("%s Owner: %s ("+Name(WER)+"): StopHuntFor "+file_name(previous_object())+", TOTAL_XP = "+QueryProp(P_PET_XP)+".\n",dtime(time()),capitalize(QueryProp(P_PET_OWNER_NAME)) ) );
  }
  return ::StopHuntFor( arg, silent );
}
