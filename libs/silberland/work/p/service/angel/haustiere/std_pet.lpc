// 30.01.2003
int is_sleeping()
{
   return (environment() == find_object ("/p/service/angel/haustiere/pet_room"));
}

/************ Begruessungsroutinen *************/

// Filtert die zu Gruessenden:
int filter_people(object ob)
{
   if ( (!ob->QueryProp(P_INVIS)) && interactive (ob))
      return 1;
   else
      return 0;
}


void ExploreBodies ()
{
   mixed ids, objs;
   int joy, i;

   if ( !pointerp (prey_list) || !objectp ( environment (this_object()) ) )
      return 0;

   objs = all_inventory ( environment (this_object()) );

   for (i=0; i < sizeof (objs); i++)
   {
	 // 26.12.2002 ... Check auf gueltiges Objekt
	 if ( objectp (objs[i]) )
	 {
       if ( !objs[i]->id("Leiche") )
          return 0;

       ids = objs[i]->QueryProp( P_IDS );

       if ( !pointerp(ids) )
          return 0;

       ids = explode ( ids[<1], "\n" );

       if ( ids[0] != "leiche" )
          return 0;

       if ( sizeof (ids) < 2 )
          return 0;

       ids = explode ( ids[1], "#" );

       if ( !pointerp (prey_list) || ( member ( prey_list, ids[0] ) == -1  ) )
          return 0;

       if ( objs[i]->QueryDecay() < 6 )
          return 0;

       say ( Name() + " " + QueryProp(P_PET_TRIUMPH_MSG) + "\n" );
       joy = 10 + objs[i]->QueryProp(P_LEVEL) - QueryProp(P_LEVEL);

       if ( joy > 0 && !food_status )
       {
          ModifyLoyality ( joy );
          food_status = 1;
       }

       objs[i]->remove();
     }
   }
}

void AttackPrey ( object prey )
{
  object pl;

  pl = find_player( QueryProp(P_PET_OWNER_NAME) );

  if ( objectp ( prey ) && environment (prey) == environment (this_object()) &&
       !prey->id("QUESTOBJ") && !prey->id("NOPETATTACK") && !prey->id("geist")
       && !prey->id("zombie")  && prey->QueryProp(P_LEVEL)
        < (QueryProp(P_LEVEL)+5) )
  {
    if ( !pointerp ( prey_list ) )
      prey_list = ({ explode ( file_name( prey ), "#" )[0] });
    else if(member(prey_list, explode(file_name(prey), "#")[0]) == -1)
      prey_list += ({ explode ( file_name( prey ), "#" )[0] });

     // 11.03.03 Events wirken sich nicht negativ auf die Tiere aus.
    if ( (!objectp(pl) || query_idle(pl) > 600 ||
         environment (pl) != environment (this_object())) &&
         strstr(file_name(prey), "event/") == -1 )
    {
      say (name()+" sieht veraergert aus.\n");
      ModifyLoyality ( -5 );
      return;
    }

    Kill (prey);
  }
}

// Sollte ein NPC auf der Speisekarte des Haustiers stehen, so gnade ihm Woody ...
void PredatorCheck( object ob )
{
   int i;
   mixed enemies;

   // Spieler oder deren Haustiere werden nicht verspeist!
   if ( query_once_interactive (ob) || ob->QueryProp(P_FRIEND) )
      return 0;

   enemies = QueryProp(P_PET_ENEMIES);

   for (i=0; i < sizeof (enemies); i++)
   {
	  if ( stringp(enemies[i]) && 
               ( ob->id(enemies[i]) || 
                 ( stringp(ob->QueryProp(P_RACE)) && 
                   lower_case( ob->QueryProp(P_RACE) )==lower_case(enemies[i]))
               )
             )
	  {
	     call_out ( "AttackPrey", 1, ob );
	     say (Name()+" "+sprintf( QueryProp(P_PET_ATTACK_MSG)+"\n", ob->name(WEN) ) );
	     return 0;
      }
   }
}

init ()
{
   object owner;
   string msg;

   ::init();
   // Im Schlafraum wird NIX gemacht!
   if ( is_sleeping() )
      return;

   PredatorCheck( this_player() );

   owner = find_player(QueryProp(P_PET_OWNER_NAME));
   if ( report_status && (owner != this_player()) && (!pointerp(reported_players) || (member (reported_players, this_player()) == -1)) )
   {
      if (objectp(owner))
      {
	     if ( sizeof ( QueryProp(P_RACESTRING) >= WEN ) )
	        msg = this_player()->QueryProp(P_RACESTRING)[WEN];
	     if ( !stringp ( msg ) )
	        msg = this_player()->QueryProp(P_RACE);

	     msg = this_player()->QueryArticle(WEN, 0, 1) + msg;

	     // Nur mehr Seherhaeuser bewachen!
         if ( strstr(file_name(environment(this_object())), "seher/haus") >= 0 )
            tell_object (owner, Name()+" "+sprintf(QueryProp(P_PET_REPORT_MSG), msg )+"\n");
      }

      if (!pointerp(reported_players))
         reported_players = ({ this_player() });
      else
         reported_players += ({ this_player() });
   }
   call_out("greet_check",0);
}

// Haustier-Ignoranten filtern:
int filter_ignorants( object ob )
{
  if( pointerp(ob->QueryProp(P_IGNORE)) && (member(ob->QueryProp(P_IGNORE), "haustiere") != -1) )
    return 1;
}

// Array mit den Haustier-Ignoranten finden:
mixed get_ignorants ()
{
   mixed ignorants;

   ignorants = filter_array (all_inventory ( environment (this_object()) ), #'filter_ignorants);
   if ( pointerp(ignorants) )
      return  ignorants;
   else
      return ({});
}

// Begruesungsroutine
void greet_player()
{
   mixed msgs;

   if ( !objectp(this_player()) || !objectp(environment(this_player())) )
      return 0;

   if ( environment (this_player()) != environment(this_object()) || this_player()->QueryProp(P_INVIS) )
      return;

   if ( (this_player()->query_real_name() == QueryProp(P_PET_OWNER_NAME)) )
   {
	  msgs = QueryProp(P_PET_GREETS_OWNER);
	  if ( !pointerp( msgs ) || sizeof( msgs ) != 2 )
	  {
		 say ("Fehler: Bitte Begruessungstext fuer den Besitzer neu definieren!\n");
		 return 0;
	  }

	  if ( stringp ( msgs[0] ) && strlen ( msgs[0] ) )
	  {
         if ( !pointerp(this_player()->QueryProp(P_IGNORE)) || (member(this_player()->QueryProp(P_IGNORE), "haustiere") == -1 ) )
            tell_object (this_player(), Name()+" "+parse_text( msgs[0] )+"\n");
         say (Name()+" "+parse_text( msgs[1] )+"\n", ({this_player()})+get_ignorants() );
      }
   }
   else
   if ( member(friends_list, this_player()->query_real_name()) == -1  )
   {
	  msgs = QueryProp(P_PET_GREETS_STRANGER);
	  if ( !pointerp( msgs ) || sizeof( msgs ) != 2 )
	  {
		 say ("Fehler: Bitte Begruessungstext fuer Fremde neu definieren!\n");
		 return 0;
	  }
	  if ( stringp ( msgs[0] ) && strlen ( msgs[0] ) )
	  {
         if ( !pointerp(this_player()->QueryProp(P_IGNORE)) || (member(this_player()->QueryProp(P_IGNORE), "haustiere") == -1 ) )
            tell_object (this_player(), Name()+" "+parse_text( msgs[0] )+"\n");
         say (Name()+" "+parse_text( msgs[1] )+"\n", ({this_player()})+get_ignorants() );
      }
   }
   else
   {
	  msgs = QueryProp(P_PET_GREETS_FRIEND);
	  if ( !pointerp( msgs ) || sizeof( msgs ) != 2 )
	  {
		 say ("Fehler: Bitte Begruessungstext fuer Freunde neu definieren!\n");
		 return 0;
	  }
	  if ( stringp ( msgs[0] ) && strlen ( msgs[0] ) )
	  {
         if ( !pointerp(this_player()->QueryProp(P_IGNORE)) || (member(this_player()->QueryProp(P_IGNORE), "haustiere") == -1 ) )
            tell_object (this_player(), Name()+" "+parse_text( msgs[0] )+"\n");
         say (Name()+" "+parse_text( msgs[1] )+"\n", ({this_player()})+get_ignorants() );
      }
   }
}

void greet_check()
{
   if ( !objectp(this_player()) )
      return 0;

   if ( !interactive(this_player()) && !this_player()->QueryProp(P_FRIEND) )
      return 0;

   if ( !pointerp( greeted_players ) || member ( greeted_players, this_player() ) == -1 )
      call_out ( "greet_player", 0 );
   else
      return 0;

   if (!pointerp(greeted_players))
      greeted_players = ({ this_player() });
   else
      greeted_players += ({ this_player() });
}


/************** Implementierung der eingebauten Kommandos ******************/

int bewache ( mixed args )
{
   if ( this_player()->query_real_name() != QueryProp(P_PET_OWNER_NAME) )
   {
	  write ("Das ist doch garnicht Dein Haustier!\n");
      return 0;
   }

   if ( member (args, "nicht") != -1 )
   {
      write ( Name(RAW) + " hat nun wieder nur mehr Augen fuer Dich.\n");
      say ( Name(RAW) + " hat nun wieder nur mehr Augen fuer "+this_player()->name(WEN)+".\n", ({this_player()}) );
      report_status = 0;
      return 1;
   }

   if ( strstr(file_name(environment(this_object())), "seher/haus") < 0 )
   {
      say ( Name(RAW) + " moechte diesen Ort nicht bewachen.\n" );
      return 1;
   }

   if ( member (args, "haus") != -1 || member (args, "heim") != -1 || member (args, "ort") != -1
        || member (args, "platz") != -1 || member (args, "raum") != -1 )
   {
	  this_player()->RemovePursuer( this_object() );
      say ( Name(RAW) + " beobachtet diesen Ort nun ganz genau.\n" );

      report_status = 1;
      return 1;
   }

   write ("Was soll "+Name(RAW)+" denn bewachen oder nicht mehr bewachen?\n");
   return 0;
}

int folge ( )
{
   if ( this_player()->query_real_name() != QueryProp(P_PET_OWNER_NAME) )
   {
	  write ( "Das ist doch gar nicht Dein Haustier!\n" );
      return 0;
   }

   if ( member (this_player()->QueryPursuers(), this_object()) == -1 )
   {
      this_player()->AddPursuer( this_object() );
      report_status = 0;
      write (Name(RAW)+" "+parse_text( QueryProp(P_PET_FOLLOW_MSG)[0] )+"\n");
      say (Name(RAW)+" "+parse_text( QueryProp(P_PET_FOLLOW_MSG)[1] )+"\n", ({this_player()}));
      return 1;
   }

   write (Name(RAW) + " folgt Dir doch schon!\n");
   return 0;
}

int warte ( )
{
   if ( this_player()->query_real_name() != QueryProp(P_PET_OWNER_NAME) )
   {
	  write ("Das ist doch gar nicht Dein Haustier!\n");
      return 0;
   }

   if ( member (this_player()->QueryPursuers(), this_object()) != -1 )
   {
      this_player()->RemovePursuer( this_object() );
      write (Name(RAW)+" "+parse_text( QueryProp(P_PET_STOP_MSG)[0] )+"\n");
      say (Name(RAW)+" "+parse_text( QueryProp(P_PET_STOP_MSG)[1] )+"\n", ({this_player()}));
      return 1;
   }
   write (Name(RAW)+" folgt Dir doch gar nicht!\n");
}

int hilf ( mixed args )
{
   if ( this_player()->query_real_name() != QueryProp(P_PET_OWNER_NAME) )
   {
	  write ("Das ist doch garnicht Dein Haustier!\n");
      return 0;
   }

   if ( member (args, "nicht") != -1 )
   {
      say (Name(RAW)+" entspannt sich sichtlich.\n");
      this_player()->RemoveDefender(this_object());
      wants_help = 0;
      return 1;
   }

   if ( member (args, "kampf") != -1 || member (args, "schlacht") != -1 )
   {
      write ( Name(RAW) + " laesst Dich nicht mehr aus den Augen.\n");
      say ( Name(RAW) + " laesst "+this_player()->name(WEN)+" nicht mehr aus den Augen.\n", ({this_player()}) );
      this_player()->AddDefender(this_object());
      wants_help = 1;
      return 1;
   }

   write ("Wo soll Dir "+name()+" beistehen bzw. nicht beistehen?\n");
   return 0;
}


// Prueft ob der angegebene Name moeglich ist:
int verify_name (string name)
{
  // Pruefung ob ein Spieler bereits so heisst.
  if (file_size(sprintf("/save/%c/%s.o", lower_case(name)[0], lower_case(name))) > 0)
     return 0;

  // Pruefung ob der Name gesperrt ist:
  if ( "/secure/master"->QueryBanished(name) )
     return 0;

  // Pruefung ob schon ein Haustier so heisst:
  if ( stringp( FindOwner( lower_case (name) ) ) )
     return 0;

  // Pruefung ob sonst ein NPC so heisst.
  if (find_living(name))
     return 0;
  else
     return 1;
}

// Hilfsfunktion aus der Lib
varargs string query_c_article(int casus, int plural)
{
  if (plural)
    return ({ "die ", "der ", "den ", "die "})[casus];
  return ({ ({ "das ", "des ", "dem ", "das " }),
            ({ "der ", "des ", "dem ", "den " }),
            ({ "die ", "der ", "der ", "die " }) })
         [(int)QueryProp( P_GENDER ) % 3][casus];
}

string short ()
{
   if ( stringp ( QueryProp(P_PET_OWNER_NAME) ) )
      return QueryProp(P_NAME) + ", "+query_c_article(WER)+QueryProp(P_RACE) + " von " + capitalize(QueryProp(P_PET_OWNER_NAME)) + ".\n";
   else
      return QueryProp(P_NAME) + ", "+query_c_article(WER)+QueryProp(P_RACE) + ".\n";
}

string QueryMood ()
{
   switch ( QueryProp(P_PET_LOYALITY) )
   {
	  case 100:      return " und sieht vollends gluecklich aus!";
	  case 90 .. 99: return " und sieht sehr gluecklich aus.";
	  case 80 .. 89: return " und sieht gluecklich aus.";
	  case 70 .. 79: return " und sieht sehr zufrieden aus.";
	  case 60 .. 69: return " und sieht ziemlich zufrieden aus.";
	  case 50 .. 59: return " und sieht zufrieden aus.";
	  case 40 .. 49: return " und sieht unzufrieden aus.";
	  case 30 .. 39: return " und sieht ungluecklich aus.";
	  case 20 .. 29: return " und sieht sehr ungluecklich aus.";
	  case 10 .. 19: return " und sieht extrem ungluecklich aus!";
	  case 1 .. 9: return " und sieht verwirrt aus!";
	  default: return " und sieht stark verwirrt aus!";
   }
}

string long ()
{
  string output;

  output = ::long();

  output = output[0 .. strlen(output) - 3];
  return output + QueryMood() + "\n";
}

void InitSpells ()
{
  return;
}

// Gib Deinem Tier einen Namen:
int give_name (string args)
{
  string str, id;

  notify_fail ("Wen oder was willst Du wie benennen?\n");
  if (!stringp(args))
     return 0;

  sscanf( args, "%s %s", id, str );

  if ( member(QueryProp(P_IDS), id) == -1 )
	 return 0;

  notify_fail ("Das ist doch gar nicht Dein Haustier!\n");
  if ( this_player()->query_real_name() != QueryProp(P_PET_OWNER_NAME) )
     return 0;

  notify_fail ("Es ist noch zu frueh Deinem Haustier einen anderen Namen zu geben!\n");
  if ( time() < QueryProp(P_PET_RENAME_DELAY) && (!IS_LEARNER(this_player())) )
     return 0;

  notify_fail ("Wie moechstest Du Dein Haustier (be)nennen?\n");
  if (!stringp(str))
     return 0;

  notify_fail ("Der Name Deines Haustiers darf nur ein Wort lang sein!\n");
  if ( sizeof(explode ( str, " ")) > 1 || sizeof(explode ( str, " ")) == 0 )
     return 0;

  notify_fail ("Dieser Name darf nicht vergeben werden!\n");
  if ( !verify_name (str) )
     return 0;
  else
  {
	 // Sollte das Haustier umbenannt werden -> altes save_file loeschen!
	 rm( QuerySaveFileName() + ".o" );

	 // 26.12.2002: RassenID bleibt!
	 if ( lower_case (QueryProp(P_NAME)) != "haustier" && lower_case (QueryProp(P_NAME)) != lower_case (QueryProp(P_RACE)) )
	    RemoveId ( lower_case (QueryProp(P_NAME)) );
	 AddId( str );
	 SetProp (P_NAME, capitalize(str) );
     SetProp(P_ARTICLE, 0);
     InitSpells ();
	 tell_object (this_player(), "Du gibst Deinem Haustier den Namen: "+capitalize(str)+".\n");
     say (this_player()->Name()+" gibt "+this_player()->QueryPossPronoun(NEUTER, WEM, 0)+" Haustier den Namen: "+capitalize(str)+".\n", ({ this_player() }));


	 // Der Name des Haustieres darf nur alle 24h geaendert werden:
	 SetProp (P_PET_RENAME_DELAY, time()+86400);
	 set_living_name(str);
	 SavePet();
	 return 1;
  }
}

// Das Haustier zieht sich zurueck
void go_to_sleep ()
{
   object owner;
   
   // Nur clone werden bewegt! 22.09.2003 (Angel)
   if (!is_clone(this_object()))
      return;
      
   prey_list = 0;
   report_status = 0;

   owner = find_player( QueryProp(P_PET_OWNER_NAME) );

   if ( objectp(owner) )
      owner->RemovePursuer( owner );

   SavePet();
   if ( objectp (environment (this_object()) ) )
      tell_room ( environment (this_object()), Name(RAW)+ " geht ins Reich der schlafenden Haustiere.\n" );
   move ( SLEEPING_PETS, M_NOCHECK|M_SILENT );
}

// Haustiere koennen von Spielern nicht verletzt werden:
string checkattack ()
{
   if ( !objectp(this_player()) )
      return 0;

   if (interactive(this_player()))
	  return QueryProp(P_PET_NOATTACK_MSG)+"\n";
   else
      return 0;
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
   if ( interactive(enemy) )
   {
	  if (objectp(enemy))
	  {
         write_file( "/p/service/angel/haustiere/log/abuse.log",sprintf("%s %s greift "+Name(WER)+" an (Verb: %O).\n",dtime(time()), capitalize(enemy->query_real_name()), spell ) );
	     tell_object (enemy, QueryProp(P_PET_NOATTACK_MSG));
	     StopHuntFor( enemy, 1 );
	     enemy->StopHuntFor( this_object(), 1 );
      }
	  return 0;
   }
   return ::Defend(dam, dam_type_list, spell, enemy);
}

// Haustiere sterben nicht sondern ziehen sichzurueck und verlieren Loyalitaet
void die ( int poisondeath )
{
   object	po;
   
   /* Kindergarten Modus an. 29.11.2004 Koomi */
   /* ich hoffe, dass man solche latenten Aggressionen von Magiern gegenueber
    * anderen Magiern bzw deren Objekte durch sachliche Diskussion vermeiden 
    * kann und solcher Kindergartenspiele vermeiden kann
    */
    
   po=previous_object();
   if(po)
   {
      if(po->id("wan ling"))
      {
        if(environment())
	{
	  tell_room(environment(),
	    Name(RAW)+" weicht geschickt aus und beisst Wan Ling zu Tode.\n");
	}
	po->die();
	return;
      }
   }   
   /* Kindergarten Modus aus */

   prey_list = 0;
   say ( Name(RAW) + " " + QueryProp(P_PET_DEFEAT_MSG) + "\n" );
   SetProp( P_HP, QueryProp(P_MAX_HP));
   ModifyLoyality (-50);
   SetProp( P_PET_RETURN_DELAY, ( time() + ( 100 - QueryProp( P_PET_LOYALITY ) + 1) * 3600 ) );
   go_to_sleep();
}

// Haustiere fliegen nicht aus dem Speicher
clean_up( int ref )
{
  return 1;
}

/********** Verhalten wenn das Haustier einen Gegenstand erhaelt ***********/

// Lass alles fallen:
void drop_stuff ( object ob )
{
   mixed stuff;
   int   i;

   if ( objectp(ob) )
   {
	  say ( Name(WER)+ " will "+ob->name(WEN)+" nicht.\n" );
      ob->move(environment(this_object()), M_PUT);
      return;
   }

   stuff = all_inventory();

   for ( i = 0; i < sizeof (stuff); i++ )
   {
	  say ( Name(WER)+ " will "+stuff[i]->name(WEN)+" nicht.\n" );
      stuff[i]->move(environment(this_object()), M_PUT);
   }

}

// Haustier futtert das Essen und reagiert auf die Qualitaet:
void consume_food ( object ob, int joy )
{
   switch (joy)
   {
	  case 0:  say ( break_string (Name(WER) + " schlingt "+ob->name(WEN)+" hinunter, es scheint nicht sonderlich gut zu schmecken.", 78) );
	           if ( !food_status && (this_player()->query_real_name() == QueryProp(P_PET_OWNER_NAME))  )
	              ModifyLoyality ( random (2) );
	           food_status = 1;
	           break;
	  case 1:  say ( break_string (Name(WER) + " macht sich ueber "+ob->name(WEN)+" mit Appetit her.", 78) );
	           if ( !food_status && (this_player()->query_real_name() == QueryProp(P_PET_OWNER_NAME))  )
	              ModifyLoyality (1);
	           food_status = 1;
	           break;
	  case 2:  say ( break_string (Name(WEM) + " scheint "+ob->name(WER)+" sehr gut zu schmecken.", 78) );
	           if ( !food_status && (this_player()->query_real_name() == QueryProp(P_PET_OWNER_NAME)) )
	              ModifyLoyality (2);
	           food_status = 1;
	           break;
	  case 3:  say ( break_string (Name(WER) + " hat "+ob->name(WEN)+" anscheinend zum Lieblingsgericht gewaehlt und ist restlos gluecklich.", 78) );
	           if ( !food_status && (this_player()->query_real_name() == QueryProp(P_PET_OWNER_NAME)))
	              ModifyLoyality (3);
	           food_status = 1;
	           break;
	  default: say ( break_string (Name(WER) + " isst "+ob->Name(WEN)+" auf und schaut zufrieden.", 78) );
	           break;
   }
   ob->remove();
}

// Basisfunktion fuer das Verhalten bzgl. erhaltenen Gegenstaenden:
int check_give( object obj )
{
   int i, joy;
   mixed ids, food;

   joy = -1;

   ids = obj->QueryProp(P_IDS);
   food = QueryProp(P_PET_FOOD);

   for (i=0; i < sizeof(ids); i++)
   {
	  if ( member (food, ids[i]) )
	  {
		 if ( food[ids[i]] > joy )
		    joy = food[ids[i]];
      }
   }
   if ( joy > -1 )
   {
      call_out("consume_food", 0, obj, joy);
      return 0;
   }
   call_out("drop_stuff", 0, obj);
   return 0;
}

