#define MY_PET_VERSION "v1.20.2 (18.09.2022, Gwenshara)"

mixed  prey_list;
mixed  friends_list, greeted_players, reported_players;
int    report_status, food_status, play_status;
int    wants_help;



void ModifyLoyality ( int joy );
varargs string QuerySaveFileName( string name, string uid );
int SavePet ();
