/********************************************************************
 * Klasse: Verkaeufer in der Tierhandlung                           *
 * Datei: /p/service/angel/haustiere/std_petshop_vendor.c           *
 * Letzte Ueberarbeitung: 18.12.2002                                *
 ********************************************************************/

inherit "/std/npc.lpc";

#include <properties.h>
#include "/p/service/angel/haustiere/std_pet.h"

create ()
{
   ::create();
   SetProp (P_NAME, "Verkaeufer");
   SetProp (P_SHORT, "Verkaeufer");
   SetProp (P_LONG, "Dies ist ein Verkaeufer in irgendeiner Tierhandlung.");
   SetProp (P_GENDER, MALE);

   AddId( ({"\npetshop_vendor", "verkaeufer" }) );

   AddInfo ( DEFAULT_INFO, "Davon weiss ich leider nichts." );
}

void GiveIntroduction ()
{
   write ( "Der Verkaeufer gibt Dir noch einen Gegenstand und meint:\n"+
         "Seid nett zu Eurem neuen Gefaehrten, denn selbst das treuste Tier vertraegt nicht alles.\n" );
   say ( "Der Verkaeufer gibt "+this_player()->Name(WEM)+" noch einen Gegenstand und meint:\n"+
         "Seid nett zu Eurem neuen Gefaehrten, denn selbst das treuste Tier vertraegt nicht alles.\n", ({this_player()}) );
}