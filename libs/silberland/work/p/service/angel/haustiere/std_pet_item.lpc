inherit "/std/thing.lpc";

#include <properties.h>
#include <moving.h>
#include "std_pet.h"

int stat;
mixed temp, choice, key, value;
string version;
object pet;

void menu_choice ( string args );

int display_help (string dummy)
{
  string result;

  result = read_file ("/p/service/angel/haustiere/pet.hlp");

  this_player()->More (result);
  return 1;
}

void generic_input ( string args )
{
   temp = args;
   stat++;
   menu_choice ( choice );
}

// Hilfsfunktion fuer die Auswahl
string _s_to_o ( string str )
{
   int pos;

   if ( !stringp (str) )
      return 0;

   do
   {
      if ( (pos = strstr (str, "$", pos)) != -1 )
      {
      	 if ( strlen(str) < pos+7 ) // in dem Fall liegt ein Fehler in der Syntax vor.
      	 {
      	    write ("Fehler: Inkorrekte Anzahl von Parametern fuer '$'!\n");
      	    return str;
      	 }

      	 if ( str[pos+1 .. pos+1] == "s" )
      	 {
	      	str = str[0 .. pos] + "o" + str[pos+2 .. strlen(str)-1];
      	 }
      	 pos++;
      }
   } while (pos != -1);
   return str;
}

void menu_choice ( string args )
{
   int i;
   
   switch ( args )
   {
	  case "1":  if ( !stat )
	             {
		            write ( break_string("Bitte Die Langbeschreibung fuer das Haustier eingeben und mit <enter> abschliessen:", 78) );
		            temp = 0;
		            choice = "1";
                    input_to ("generic_input");
                    return;
	             }

	             if( stringp (temp) && strlen(temp) )
	             {
		           if ( objectp (pet) )
		           {
	                  pet->SetProp(P_LONG, temp);
	                  pet->SavePet();
	                  write ("Langbeschreibung erfolgreich geaendert!\n");
                   }
	               else
	               {
	                  write ("Das Haustier ist nicht auffindbar!\n");
	                  return;
                   }
                 }
	             else
	             {
	               write ("Eingabefehler!\n");
	               return;
                 }
	             break;

	  case "2":  if ( !stat )
	             {
		            write ( break_string("Bitte den Schluessel fuer das Detail angeben und mit <enter> abschliessen:", 78) );
	                temp = 0;
	                choice = "2";
	                input_to ("generic_input");
	                return;
                 }
                 if ( stat == 1 )
                    key = temp;

                 if ( !stringp (key) || !strlen(key) )
                 {
	                write ("Eingabefehler!\n");
	                return;
                 }

	             if( stat == 1 )
	             {
		            write ( break_string("Bitte die Detailbeschreibung angeben:", 78) );
		            temp = 0;
		            choice = "2";
                    input_to ("generic_input");
                    return;
                 }

                 if ( objectp (pet) )
                 {
                    if ( stringp (temp) && strlen(temp) )
                    {
                       pet->AddDetail(key, temp);
                       pet->SavePet();
                       write ("Detail hinzugefuegt / geaendert!\n");
                    }
                    else
                    {
                       write ("Eingabefehler!\n");
                       return;
                    }
                 }
	             else
	             {
	                write ("Das Haustier ist nicht auffindbar!\n");
	                return 0;
                 }
                 break;

	  case "3":  if ( !stat )
	             {
		            write ( break_string("Bitte den Schluessel fuer das zu loeschende Detail angeben und mit <enter> abschliessen:", 78) );
	                temp = 0;
	                choice = "3";
	                input_to ("generic_input");
	                return;
                 }

                 if ( objectp (pet) )
                 {
                    if ( stringp (temp) && strlen(temp) )
                    {
                       pet->RemoveDetail(temp);
                       pet->SavePet();
                       write ("Detail entfernt!\n");
                    }
                    else
                    {
                       write ("Eingabefehler!\n");
                       return;
                    }
                 }
	             else
	             {
	                write ("Das Haustier ist nicht auffindbar!\n");
	                return 0;
                 }
                 break;

	  case "4":  if ( !stat )
	             {
		            write ( break_string("Bitte Text eingeben mit dem sich das besiegte Haustier verabschiedet und mit <enter> abschliessen:", 78) );
		            temp = 0;
		            choice = "4";
                    input_to ("generic_input");
                    return;
	             }

	             if( stringp (temp) && strlen(temp) )
	             {
		           if ( objectp (pet) )
		           {
	                  pet->SetProp(P_PET_DEFEAT_MSG, temp);
	                  pet->SavePet();
	                  write ("Ausgabe erfolgreich geaendert!\n");
                   }
	               else
	               {
	                  write ("Das Haustier ist nicht auffindbar!\n");
	                  return;
                   }
                 }
	             else
	               write ("Eingabefehler!\n");
	             break;

	  case "5":  if ( !stat )
	             {
		            write ( break_string("Bitte die Meldung beim Bewachen von Raeumen eingeben und mit <enter> abschliessen:", 78) );
		            temp = 0;
		            choice = "5";
                    input_to ("generic_input");
                    return;
	             }

	             if( stringp (temp) && strlen(temp))
	             {
		           if ( objectp (pet) )
		           {
	                  pet->SetProp(P_PET_REPORT_MSG, temp);
	                  pet->SavePet();
	                  write ("Meldung erfolgreich geaendert!\n");
                   }
	               else
	               {
	                  write ("Das Haustier ist nicht auffindbar!\n");
	                  return;
                   }
                 }
	             else
	               write ("Eingabefehler!\n");
	             break;

	  case "6":  if ( !stat )
	             {
		            write ( break_string("Bitte den Begruessungstext fuer den Besitzer eingeben und mit <enter> abschliessen:", 78) );
		            temp = 0;
		            choice = "6";
                    input_to ("generic_input");
                    return;
	             }

	             if( stringp (temp) )
	             {
		           if ( objectp (pet) )
		           {
	                  pet->SetProp(P_PET_GREETS_OWNER,({ temp, _s_to_o(temp) }) );
	                  pet->SavePet();
	                  write ("Begruessungstext erfolgreich geaendert!\n");
                   }
	               else
	               {
	                  write ("Das Haustier ist nicht auffindbar!\n");
	                  return;
                   }
                 }
	             else
	               write ("Eingabefehler!\n");
	             break;

	  case "7":  if ( !stat )
	             {
		            write ( break_string("Bitte den Begruessungstext fuer Freunde eingeben und mit <enter> abschliessen:", 78) );
		            temp = 0;
		            choice = "7";
                    input_to ("generic_input");
                    return;
	             }

	             if( stringp (temp) )
	             {
		           if ( objectp (pet) )
		           {
	                  pet->SetProp(P_PET_GREETS_FRIEND, ({ temp, _s_to_o(temp) }));
	                  pet->SavePet();
	                  write ("Begruessungstext erfolgreich geaendert!\n");
                   }
	               else
	               {
	                  write ("Das Haustier ist nicht auffindbar!\n");
	                  return;
                   }
                 }
	             else
	               write ("Eingabefehler!\n");
	             break;

	  case "8":  if ( !stat )
	             {
		            write ( break_string("Bitte den Begruessungstext fuer Fremde eingeben und mit <enter> abschliessen:", 78) );
		            temp = 0;
		            choice = "8";
                    input_to ("generic_input");
                    return;
	             }

	             if( stringp (temp) )
	             {
		           if ( objectp (pet) )
		           {
	                  pet->SetProp(P_PET_GREETS_STRANGER, ({ temp, _s_to_o(temp) }));
	                  pet->SavePet();
	                  write ("Begruessungstext erfolgreich geaendert!\n");
                   }
	               else
	               {
	                  write ("Das Haustier ist nicht auffindbar!\n");
	                  return;
                   }
                 }
	             else
	               write ("Eingabefehler!\n");
	             break;

	  case "9":  if ( !stat )
	             {
		            write ( break_string("Hinzuzufuegenden Freund eingeben und mit <enter> abschliessen:", 78) );
		            temp = 0;
		            choice = "9";
                    input_to ("generic_input");
                    return;
	             }

	             if( stringp (temp) && (strlen(temp) > 2)  )
	             {
		           if ( objectp (pet) )
		           {
	                  pet->AddFriend(temp);
	                  pet->SavePet();
	                  write ("Freund hinzugefuegt!\n");
                   }
	               else
	               {
	                  write ("Das Haustier ist nicht auffindbar!\n");
	                  return;
                   }
                 }
	             else
	             {
	               write ("Eingabefehler!\n");
	               return;
                 }
	             break;

	  case "a":  if ( !stat )
	             {
		            write ( break_string("Zu entfernenden Eintrag eingeben und mit <enter> abschliessen:", 78) );
		            temp = 0;
		            choice = "a";
                    input_to ("generic_input");
                    return;
	             }

	             if( stringp (temp) && strlen(temp) )
	             {
		           if ( objectp (pet) )
		           {
	                  pet->RemoveFriend(temp);
	                  pet->SavePet();
	                  write ("Eintrag entfernt!\n");
                   }
	               else
	               {
	                  write ("Das Haustier ist nicht auffindbar!\n");
	                  return;
                   }
                 }
	             else
	             {
	               write ("Eingabefehler!\n");
	               return;
                 }
	             break;

	  case "b":  if ( !stat )
	             {
		            write ( break_string("Bitte den Schluessel fuer das Kommando angeben und mit <enter> abschliessen:", 78) );
	                temp = 0;
	                choice = "b";
	                input_to ("generic_input");
	                return;
                 }
                 if ( stat == 1 )
                    key = temp;

                 if ( !stringp (key) || !strlen(key) )
                 {
	                write ("Eingabefehler!\n");
	                return;
                 }
	             if( stat == 1 )
	             {
		            write ( break_string("Bitte die neuen Schluesselworte angeben:", 78) );
		            temp = 0;
		            choice = "b";
                    input_to ("generic_input");
                    return;
                 }

                 if ( objectp (pet) )
                 {
                    if ( stringp (temp) && strlen(temp) )
                    {
                       pet->ChangeCommand(key, temp);
                       pet->SavePet();
                       write ("Kommando hinzugefuegt / geaendert!\n");
                    }
                    else
                    {
                       write ("Eingabefehler!\n");
                       return;
                    }
                 }
	             else
	             {
	                write ("Das Haustier ist nicht auffindbar!\n");
	                return 0;
                 }
                 break;

	  case "c":  if ( !stat )
	             {
		            write ( break_string("Bitte Gruppe der Reaktion angeben und mit <enter> abschliessen:", 78) );
	                temp = 0;
	                choice = "c";
	                input_to ("generic_input");
	                return;
                 }
                 if ( stat == 1 )
                    key = temp;

                 if ( !stringp (key) || !strlen(key) )
                 {
	                write ("Eingabefehler!\n");
	                return;
                 }

	             if( stat == 1 )
	             {
		            write ( break_string("Bitte den Text fuer die betreffende Person angeben:", 78) );
		            temp = 0;
		            choice = "c";
                    input_to ("generic_input");
                    return;
                 }

                 if ( stat == 2 )
                    value = temp;

	             if( stringp (value) && stat == 2 )
	             {
		            write ( break_string("Bitte den Text fuer die Zuseher angeben:", 78) );
		            temp = 0;
		            choice = "c";
                    input_to ("generic_input");
                    return;
                 }

                 if ( objectp (pet) )
                 {
                    if ( !strlen (temp) )
                       temp = 0;

                    pet->ModifyReaction(key, value, temp);
                    pet->SavePet();
                    write ("Reaktion hinzugefuegt / geaendert!\n");

                 }
	             else
	             {
	                write ("Das Haustier ist nicht auffindbar!\n");
	                return 0;
                 }
                 break;

	  case "d":  value =  "Uebersicht der derzeitigen Einstellungen:\n"+
	                      "-----------------------------------------\n\n";

	             value += "Langbeschreibung:\n";
	             value += pet->QueryProp(P_LONG)+"\n\n";

	             value += "Text wenn das Tier besiegt wurde:\n";
	             value += pet->QueryProp(P_PET_DEFEAT_MSG)+"\n\n";

	             value += "Meldung beim Bewachen von Raeumen:\n";
	             value += pet->QueryProp(P_PET_REPORT_MSG)+"\n\n";

	             value += "Begruessung des Besitzers:\n";
	             value += pet->QueryProp(P_PET_GREETS_OWNER)[0]+ "\n\n";

	             value += "Begruessung von Freunden:\n";
	             value += pet->QueryProp(P_PET_GREETS_FRIEND)[0]+"\n\n";

	             value += "Begruessung von Fremden:\n";
                 value += pet->QueryProp(P_PET_GREETS_STRANGER)[0]+"\n\n";

	             value += "Liste der Freunde:\n";
                 value += implode( pet->GetFriends(), ", " )+"\n\n";

  	             value += "Liste der Kommandos:\n";
  	             for (i=0; i < sizeof (pet->QueryProp(P_PET_COMMANDS)); i+=2)
  	             {
                     value += pet->QueryProp(P_PET_COMMANDS)[i]+": ";
                     value += implode (pet->QueryProp(P_PET_COMMANDS)[i+1], ", ") + "\n";
                 }

	             value += "\nListe der Reaktionen:\n";
	             if ( sizeof ( pet->QueryProp(P_PET_REACTIONS) ) )
  	                for (i=0; i < sizeof (REACTION_GROUPS); i++)
  	                {
                        value += REACTION_GROUPS[i]+":\n";
                        value += "Person: \t" + pet->QueryProp(P_PET_REACTIONS)[REACTION_GROUPS[i], 0] + "\n";
                        value += "Zuseher:\t" + pet->QueryProp(P_PET_REACTIONS)[REACTION_GROUPS[i], 1] + "\n\n";
                    }

                 this_player()->More(value);

	             break;

	  case "0":  return;
	  default: write ("Eingabefehler!\n");

   }
}

void edit_menu ()
{
   write ("Haustier-Konfigurationsmenue:\n");
   write ("------------------------------\n");
   write ("1 ... Langbeschreibung aendern\n");
   write ("2 ... Detail hinzufuegen/aendern\n");
   write ("3 ... Detail loeschen\n");
   write ("4 ... Text wenn das Tier besiegt wurde\n");
   write ("5 ... Meldung beim Bewachen von Raeumen\n");
   write ("6 ... Begruessung des Besitzers\n");
   write ("7 ... Begruessung von Freunden\n");
   write ("8 ... Begruessung von Fremden\n");
   write ("9 ... Freunde hinzufuegen\n");
   write ("a ... Freunde loeschen\n");
   write ("b ... Kommandos konfigurieren\n");
   write ("c ... Reaktionen festlegen\n");
   write ("d ... Einstellungen anzeigen\n");
   write ("0 ... Menue beenden\n");
   write ("----------------------------------------\n");
}

int config_pet ()
{   
   string pet_name;
   
   notify_fail ("Dein Haustier ist nicht auffindbar, Du solltest es rufen!\n");
   if ( !objectp(pet) )
   {
	  pet_name = FindPet( this_player()->query_real_name() );
	  if ( stringp (pet_name) )
	     pet = find_living( pet_name );
	     
	  if ( !objectp(pet) )
         return 0;
   }

   notify_fail ("Du solltest Dein Haustier erst mal benennen/taufen!\n");
   if ( pet->Name(RAW) == pet->QueryProp(P_RACE)  )
      return 0;

   edit_menu();
   write ("Deine Wahl: ");
   stat = 0;
   input_to("menu_choice");

   return 1;
}

string FindPet( string uid )
{
   int i, max;
   string name, player;
   mixed files;

   files = get_dir("/p/service/angel/haustiere/save/*");

   max = sizeof(files);
   for (i=0; i < max; i++)
   {
      sscanf(files[i], "pet_%s_%s.o", name, player);
      if (player == uid)
         return name;
   }
   return 0;
}


int BringPetBack ( string dummy )
{
  string pet_name;
  object new_pet;

  if ( objectp(pet) && environment(pet) == environment(this_player()) )
  {
	 pet->command_me("freu");
	 return 1;
  }

  if (!objectp(pet))
  {
	 pet_name = FindPet( this_player()->query_real_name() );
	 if ( stringp (pet_name) )
	    pet = find_living(pet_name);
  }

  if (objectp(pet))
  {
	  if ( time() < pet->QueryProp(P_PET_RETURN_DELAY) )
	  {
	     write ("Dein Haustier ist noch zu gekraenkt um wieder zu kommen.\n" );
		 pet->go_to_sleep ();
	     return 0;
      }

      if ( this_player()->QueryProp(P_SP) < 50 )
      {
	     write ("Du hast nicht genuegend Magiepunkte!\n");
	     return 0;
      }

      this_player()->AddSp(-50);
	  pet->move( environment(this_player()), M_NOCHECK);
	  return 1;
  }

  if ( !stringp(QueryProp(P_AUTOLOADOBJ)) )
  {
	 write ("Es ist ein Fehler aufgetreten, bitte wende Dich an einen Magier!\n");
	 return 0;
  }
  new_pet = clone_object (QueryProp(P_AUTOLOADOBJ));
  if ( objectp(new_pet) )
     new_pet->RestorePet (this_player()->query_real_name());

  if ( objectp(new_pet) )
  {
	  pet = new_pet;
	  if ( time() < pet->QueryProp(P_PET_RETURN_DELAY) )
	  {
         write ("Dein Haustier ist noch zu gekraenkt um wieder zu kommen.\n" );
		 pet->go_to_sleep ();
	     return 0;
      }

	  pet->move( environment(this_player()), M_NOCHECK);
	  return 1;
  }
  write ("Dein Haustier scheint nicht zu reagieren ...\n");
  write ("Dein "+Name(RAW)+" loest sich in seine Bestandteile auf!\n");
  call_out("remove", 0);
}

int release_pet ( string args )
{
   string n, pet_name;
   
   notify_fail ("Dein Haustier ist nicht auffindbar, Du solltest es rufen!\n");
   if ( !objectp(pet) )
   {
	  pet_name = FindPet( this_player()->query_real_name() );
	  if ( stringp (pet_name) )
	     pet = find_living( pet_name );
	     
	  if ( !objectp(pet) )
         return 0;
   }
   
   notify_fail ("Syntax: <entlasse 'haustiername' fuer immer> \nWARNUNG: Dieses Kommando ist permanent!!!\n");
   if ( !stringp ( args ) )
      return 0;

   if ( !sscanf( args, "%s fuer immer", n ) == 1 )
      return 0;

   if ( lower_case(pet->query_real_name()) != n )
      return 0;

   tell_room (environment (this_player()), this_player()->Name()+" entlaesst "+this_player()->QueryPossPronoun(NEUTER, WEN, 0)+" Haustier.\n", ({ this_player() }) );
   pet->ModifyLoyality(-1000);
   return 1;
}

void create ()
{
   ::create();

   version = "std_pet_item Version 1.0 (Release)";

   SetProp (P_NAME, "KTool");
   SetProp (P_SHORT, "Ein Konfigurationstool");
   SetProp (P_LONG,  "Ein Konfigurationstool");
   SetProp (P_AUTOLOADOBJ, 1);
   SetProp (P_NODROP, "Das solltest Du auf keinen Fall verlieren!\n");
   SetProp (P_NEVERDROP, 1);

   seteuid(getuid(this_object()));

   AddId("\nstd_pet_item");

   AddCmd ( "pethelp", "display_help" );
   AddCmd ( "petconfig", "config_pet" );
   AddCmd ( "entlasse", "release_pet" );
}

void set_pet ( object new_pet )
{
   pet = new_pet;
   if ( objectp(pet) )
      SetProp (P_AUTOLOADOBJ, explode(file_name(pet), "#")[0]);
}

object get_pet ()
{
   return pet;
}

void BecomesNetDead(object spieler)
{
   if ( objectp( pet ) )
   {
      pet->go_to_sleep();
   }
}