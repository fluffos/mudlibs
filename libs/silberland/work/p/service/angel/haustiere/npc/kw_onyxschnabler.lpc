/*
** Elessar Petshop, Ein Onyxschnabler
**
**
*/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells()
{
  SetProp(P_SPELLS, 0);

  SetProp(P_SPELLRATE, 25);

  AddSpell(4,150,
	   Name()+" hackt Dir frech ins Bein.\n",
	   Name()+" hackt @WEM frech ins Bein.\n",
	   DT_SLASH,([SP_SHOW_DAMAGE:1]));
}

void create()
{
  SetProp(P_PET_PRICE, 20000);
  SetProp(P_PET_LEVEL, 5);
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_RACE, "Onyxschnabler");
  SetProp(P_NAME, "Onyxschnabler");
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "flattert herein");
  SetProp(P_MMSGOUT, "flattert weit weg");
  SetProp(P_SIZE, 15);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 650);

   SetProp(P_PET_ENEMIES, ({}));
   SetProp(P_PET_FOOD,
	   (["semmel":3,"brot":3,"vogelfutter":1,"Nahrung":0]));

   create_default_npc(5);

   SetProp(P_HANDS,({" mit seinem kleinen Schnabel", 40, DT_RIP}));

   SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:     -0.9, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]));

  InitSpells();

  AddId(({"onyxschnabler","schnabler"}));
}
