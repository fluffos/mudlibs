/********************************************************************
 * NPC: Ein Sichelschrecken (Riesenmantis) als Haustier             *
 * Datei: /p/service/angel/haustiere/npc/kolibri.c                  *
 * Letzte Ueberarbeitung: 21.12.2002                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 30);

   AddSpell(7, 250,
     Name()+" schlaegt Dir ihre scharfen Klauen ins Fleisch.\n",
     Name()+" schlaegt @WEM ihre scharfen Klauen ins Fleisch.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1])
   );

   AddSpell(2, 300,
     Name()+" massakriert Deinen Arm mit scharfen Klauen.\n",
     Name()+" massakriert @WESSEN Arm mit scharfen Klauen.\n",
      DT_RIP, "gift", ([SP_SHOW_DAMAGE:1])
   );

   AddSpell(2, 350,
     Name()+" schlitzt Dich mit einem kraeftigen Hieb auf.\n",
     Name()+" schlitzt @WEN mit einem kraeftigen Hieb auf.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1])
   );

   AddSpell(1, 500,
     Name()+" haelt Dich mit ihren Klauen und beisst Dich.\n",
     Name()+" haelt @WEN mit ihren Klauen und beisst zu.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1])
   );
}

void create ()
{
   SetProp (P_PET_PRICE, 144000);
   SetProp (P_PET_LEVEL, 12);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Riesenmantis");
   SetProp (P_NAME, "Riesenmantis");
   SetProp (P_MSGIN, "krabbelt herein");
   SetProp (P_MSGOUT, "krabbelt");
   SetProp (P_MMSGIN, "krabbelt herein");
   SetProp (P_MMSGOUT, "krabbelt");
   SetProp (P_SIZE, 200 + random(50));
   SetProp (P_ALIGN, -400);
   SetProp (P_MAX_HANDS, 8);
   SetProp (P_GENDER, FEMALE);

   AddClass( ({CL_NIGHTVISION, CL_DARKELF}) );

   SetProp (P_PET_ENEMIES, ({ "moskito", "muecke", "insekt", "ratte", "reh", "maus", "vogel" }) );
   SetProp (P_PET_FOOD, ([ "rumpelwicht":3, "ratte":2, "mantisfutter":1, "Nahrung":0 ]) );

   create_default_npc(12);

   SetProp (P_HANDS,({" mit sichelfoermigen Klauen"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_RIP, DT_PIERCE })
                    }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.2, DT_COLD:      0.3, DT_WATER:       0.1
     , DT_AIR:       0.0, DT_LIGHTNING:-0.3, DT_EXPLOSION:  -0.1
     , DT_SOUND:     0.0, DT_LIGHT:    -0.4, DT_ELECTRIC:    0.1
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.4
     , DT_HOLY:      0.3, DT_UNHOLY:    0.0, DT_MAGIC:      -0.1
     , DT_MIND:      0.0, DT_SLASH:    -0.2, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:      -0.2
     ]) );

   InitSpells();

   AddId( ({"sichelschreck", "riesenmantis"}) );
}
