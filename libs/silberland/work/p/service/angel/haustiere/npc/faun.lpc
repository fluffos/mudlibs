/********************************************************************
 * NPC: Ein Faun als Haustier                                       *
 * Datei: /p/service/angel/haustiere/npc/faun.c                     *
 * Letzte Ueberarbeitung: 22.09.2003                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 20);

  AddSpell(1, 400,
    "Der Faun wirft eine Kugel purer Magie nach Dir.\n",
    "Der Faun wirft eine Kugel purer Magie nach @WEM.\n",
     DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 350,
    "Der Faun sieht Dir zornerfuellt in die Augen.\n",
    "Der Faun sieht @WEM zornerfuellt in die Augen.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));
     
  AddSpell(4, 250,
    "Der Faun beschwoehrt einen Blitz herauf und wirft ihn nach Dir.\n",
    "Der Faun beschwoehrt einen Blitz herauf und wirft ihn nach @WEM.\n",
     DT_ELECTRIC, ([SP_SHOW_DAMAGE:1]));

  AddSpell(4, 300,
    "Der Faun fixiert Dich und fasst ich an den Kopf.\n",
    "Der Faun fixiert @WEN und fasst sich an den Kopf.\n",
     DT_MIND, ([SP_SHOW_DAMAGE:1]));

  AddSpell(5, 200,
    "Der Faun sieht Dich an und laesst einen markerschuetternden Schrei los.\n",
    "Der Faun schreit @WEN furchtbar an.\n",
      DT_SOUND, ([SP_SHOW_DAMAGE:1]));
}

void create ()
{  
   SetProp (P_PET_PRICE, 256000);
   SetProp (P_PET_LEVEL, 16);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Faun");
   SetProp (P_NAME, "Faun");
   SetProp (P_MSGIN, "schleicht herein");
   SetProp (P_MSGOUT, "schleicht");
   SetProp (P_MMSGIN, "springt herein");
   SetProp (P_MMSGOUT, "springt");
   SetProp (P_SIZE, 50 + random(20));
   SetProp (P_ALIGN, 0);
   SetProp (P_MAX_HANDS, 2);
   SetProp (P_GENDER, MALE);

   SetProp (P_PET_ENEMIES, ({ "riesenspinne", "sichelschreck" }) );
   SetProp (P_PET_FOOD, ([ "wunderkraut":3, "wirselkraut":2, "gemuese":1, "Nahrung":0 ]) );

   create_default_npc(16);

   SetProp( P_HANDS,({" mit maechtiger Feenmagie"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_BLUDGEON, DT_MAGIC })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:      0.0, DT_WATER:      -0.2
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:    -0.2, DT_LIGHT:     0.0, DT_ELECTRIC:   -0.2
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.3
     , DT_HOLY:     -0.2, DT_UNHOLY:    0.2, DT_MAGIC:      -0.3
     , DT_MIND:     -0.2, DT_SLASH:     0.0, DT_BLUDGEON:    0.2
     , DT_PIERCE:    0.2, DT_SQUEEZE:   0.0, DT_WHIP:        0.2
     , DT_RIP:       0.2
     ]) );

  InitSpells ();

  AddId( ({"faun", "waldgeist"}) );
}
