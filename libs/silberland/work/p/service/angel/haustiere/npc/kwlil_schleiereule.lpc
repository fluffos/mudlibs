#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/p/service/angel/haustiere/std_pet.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  SetProp (P_PET_PRICE, 81000);
  SetProp (P_PET_LEVEL, 9);

  if(!is_clone(TO)) return;

  ::create();

//--Bezeichnungen----------------------------------------------------------

  SetProp(P_NAME, "Schleiereule");
  SetProp(P_GENDER, FEMALE);
  AddId(({"schleiereule", "eule", "FEDERN_WUSCHEL"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE,1);

  SetProp(P_PET_ENEMIES, ({ }) );
  SetProp(P_PET_FOOD, (["maus":3, "eulenfutter":2, "Nahrung":0]) );

//--Eigenschaften----------------------------------------------------------

  create_default_npc(9);

  SetProp(P_HANDS, ({" mit ihren scharfen Krallen"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Schleiereule");
  SetProp(P_SIZE, 30+random(15));
  SetProp(P_WEIGHT, 300+random(150));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt weiter");
  SetProp(P_MMSGIN, "kommt von einem Baum geflogen");
  SetProp(P_MMSGOUT, "fliegt auf einen Baum");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

   AddSpell(1, 150,
     Name()+" hackt mit ihrem Schnabel nach Dir!",
     Name()+" hackt mit ihrem Schnabel nach @WEM!\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

//--Create Ende------------------------------------------------------------

}
