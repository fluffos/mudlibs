inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 30);

   SetProp(P_SPELLS, 0);

   SetProp(P_SPELLRATE, 25);
 
   AddSpell(4,150,
       Name()+" hackt Dir frech ins Bein.\n",
       Name()+" hackt @WEM frech ins Bein.\n",
       DT_SLASH,([SP_SHOW_DAMAGE:1]));

   AddSpell(1, 200,
       Name()+" kraechzt dich an.\n",
       Name()+" kraechzt @WEN an.\n",
     ({ DT_TERROR, DT_SOUND }), ([SP_SHOW_DAMAGE: 1]));
}

void create ()
{
   SetProp (P_PET_PRICE, 36000);
   SetProp (P_PET_LEVEL, 6);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Untoter");
   SetProp (P_NAME, "Skelettkraehe");
   SetProp (P_MSGIN, "fliegt herein");
   SetProp (P_MSGOUT, "fliegt");
   SetProp (P_MMSGIN, "entsteht in einer gruenen Wolke");
   SetProp (P_MMSGOUT, "zerplatzt");
   SetProp (P_SIZE, 10 + random(5));
   SetProp (P_ALIGN, -100);
   SetProp (P_MAX_HANDS, 0);
   SetProp (P_GENDER, NEUTER);

   AddClass( ({CL_UNDEAD, CL_FLYING}) );

   SetProp (P_PET_ENEMIES, ({ "wurm", "kaefer", "spinne" }) );
   SetProp (P_PET_FOOD, ([  "untotenfutter":3, "wurm": 1, "vogelfutter": 2, "Nahrung":0 ]) );

   create_default_npc(2);

   SetProp( P_HANDS,({" mit ihrem skelettierten Schnabel"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_PIERCE })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_COLD:      -0.3, DT_TERROR:     -1.0, DT_HOLY:      0.3, 
       DT_UNHOLY:   -0.3, DT_MAGIC:      -0.1,  DT_MIND:     -1.0, 
     ]) );

  InitSpells ();

  AddId( ({"skelettkraehe", "kraehe"}) );
}
