inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 40);

   AddSpell(5,200,
      "Der Vampirwolf will seine Zaehne in Dein Bein schlagen!\n",
      "Der vampirwolf will seine Zaehne in @WESSEN Bein schlagen.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));


   AddSpell(3,300,
      "Der Vampirwolf will seine Zaehne in Deinen Arm schlagen!\n",
      "Der vampirwolf will seine Zaehne in @WESSEN Arm schlagen.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));

   AddSpell(5, 200,
      "Der Vampirwolf knurrt dich furchtbar an.\n",
      "Der Vampirwolf knurrt @WEN furchtbar an.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));

   AddSpell(1, 500,
      "Der Vampirwolf reisst dir deine Eingeweide heraus.\n",
      "Der Vampirwolf reisst @WEM die Eingeweide heraus.\n",
         DT_RIP, ([SP_SHOW_DAMAGE:1]));
}

void create ()
{
   SetProp (P_PET_PRICE, 256000);
   SetProp (P_PET_LEVEL, 16);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Untoter");
   SetProp (P_NAME, "Vampirwolf");
   SetProp (P_MSGIN, "schleicht zaehnefletschend herein");
   SetProp (P_MSGOUT, "schleicht");
   SetProp (P_MMSGIN, "wuehlt sich aus dem Boden");
   SetProp (P_MMSGOUT, "vergraebt sich im Boden");
   SetProp (P_SIZE, 170);
   SetProp (P_ALIGN, -500);
   SetProp (P_MAX_HANDS, 4);
   SetProp (P_GENDER, MALE);

   AddClass( ({CL_UNDEAD}) );

   SetProp (P_PET_ENEMIES, ({ "hase", "kaninchen", "reh", "schwein", "vogel" }) );
   SetProp (P_PET_FOOD, ([  "leiche":3, "untotenfutter":3, "fleisch": 2, "hundefutter": 1, "Nahrung":0 ]) );

   create_default_npc(16);

   SetProp( P_HANDS,({" mit seinen scharfen Krallen"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_POISON, DT_RIP })
                     }) );

   SetProp( P_RESISTANCE_STRENGTHS,([DT_COLD:-1.0, DT_FIRE:0.3, DT_HOLY:0.3]));

  InitSpells ();

  AddId( ({"wolf", "vampirwolf"}) );
}
