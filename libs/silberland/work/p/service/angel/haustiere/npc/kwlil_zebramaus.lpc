#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/p/service/angel/haustiere/std_pet.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  SetProp (P_PET_PRICE, 4000);
  SetProp (P_PET_LEVEL, 2);

  if(!is_clone(TO)) return;

  ::create();

//--Bezeichnungen----------------------------------------------------------

  SetProp(P_NAME, "Zebramaus");
  SetProp(P_GENDER, FEMALE);
  AddId(({"zebramaus", "maus", "FELL_WUSCHEL"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE,1);

  SetProp(P_PET_ENEMIES, ({ }) );
  SetProp(P_PET_FOOD, (["kaese":3, "maeusefutter":2, "Nahrung":0]) );

//--Eigenschaften----------------------------------------------------------

  create_default_npc(2);

  SetProp(P_HANDS, ({" mit ihren kleinen Pfoten"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Zebramaus");
  SetProp(P_SIZE, 7+random(20));
  SetProp(P_WEIGHT, 15+random(30));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "wuselt herein");
  SetProp(P_MSGOUT, "wuselt weiter");
  SetProp(P_MMSGIN, "klettert aus einem kleinen Loch im Boden");
  SetProp(P_MMSGOUT, "verschwindet in einem kleinen Loch im Boden");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

   AddSpell(1, 50,
     Name()+" zwickt Dich mit ihren spitzen Zaehnchen.",
     Name()+" zwickt @WEN mit ihren spitzen Zaehnchen.\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

//--Create Ende------------------------------------------------------------

}
