inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 25);

   AddSpell(9, 150,
     Name()+" kratzt dich mit ihren Pfoten.",
     Name()+" kratzt @WEN mit ihren Pfoten.\n",
      ({ DT_RIP }),([SP_SHOW_DAMAGE:1]));

   AddSpell(1, 200,
      Name()+" schlaegt ihre Vampirzaehne in dich.",
      Name()+" schlaegt ihre Vampirzaehne in @WEN.\n",
         ({ DT_PIERCE }),([SP_SHOW_DAMAGE:1]));
}

void create ()
{
   SetProp (P_PET_PRICE, 64000);
   SetProp (P_PET_LEVEL, 8);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Untoter");
   SetProp (P_NAME, "Vampirratte");
   SetProp (P_MSGIN, "schleicht lauernd herein");
   SetProp (P_MSGOUT, "schleicht");
   SetProp (P_MMSGIN, "wuehlt sich aus dem Boden");
   SetProp (P_MMSGOUT, "vergraebt sich im Boden");
   SetProp (P_SIZE, 100);
   SetProp (P_ALIGN, -500);
   SetProp (P_MAX_HANDS, 4);
   SetProp (P_GENDER, FEMALE);

   AddClass( ({CL_UNDEAD}) );

   SetProp (P_PET_ENEMIES, ({ "ratte", "kaefer", "spinne", "wurm", "wiesel", "maus" }) );
   SetProp (P_PET_FOOD, ([  "leiche":3, "untotenfutter":3, "Nahrung":0 ]) );

   create_default_npc(8);

   SetProp( P_HANDS,({" mit ihren Krallen"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_POISON, DT_RIP, DT_PIERCE })
                     }) );

   SetProp( P_RESISTANCE_STRENGTHS,([DT_COLD:-1.0, DT_FIRE:0.3, DT_HOLY:0.3]));

  InitSpells ();

  AddId( ({"ratte", "vampirratte"}) );
}
