/*
** Elessar Petshop, Ein Schwarzfuchs
**
**
*/

inherit "/p/service/angel/haustiere/std_pet.lpc";
#include <class.h>
#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"



void InitSpells()
{
  SetProp(P_SPELLS, 0);

  SetProp(P_SPELLRATE, 25);

  AddSpell(9,250,
	   Name()+" reisst Dich mit seinen Reisszaehnen auf.\n",
	   Name()+" reisst @WEN mit seinen Reisszaehnen auf.\n",
	   DT_RIP,([SP_SHOW_DAMAGE:1]));
}

void create()
{
  SetProp(P_PET_PRICE, 80000);
  if(!is_clone(TO)) return;
  
  ::create();

  SetProp(P_PET_LEVEL, 13);

  SetProp(P_RACE, "Fuchs");
  SetProp(P_NAME, "Schwarzfuchs");
  SetProp(P_MSGIN, "trottet herein");
  SetProp(P_MSGOUT, "trottet");
  SetProp(P_MMSGIN, "trottet herein");
  SetProp(P_MMSGOUT, "trottet weit weg");
  SetProp(P_SIZE, 110);
  SetProp(P_ALIGN, -150);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 35243);

   SetProp(P_PET_ENEMIES, ({ }));
   SetProp(P_PET_FOOD,
	   (["fleisch":3,"fisch":2,"fuchsfutter":1,"Nahrung":0]));

   create_default_npc(13);

   SetProp(P_HANDS,({" mit seinem scharfen Gebiss", 135, DT_RIP}));

   SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:     -0.9, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:  -0.1, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]));

  InitSpells();

  AddId(({"fuchs","schwarzfuchs"}));
  AddClass(CL_ANIMAL);
}
