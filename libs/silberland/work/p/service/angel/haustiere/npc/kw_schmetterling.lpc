/*
** Elessar Petshop, Ein Schmetterling
**
**
*/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells()
{
  SetProp(P_SPELLS, 0);

  SetProp(P_SPELLRATE, 0);

  SetAttackChats(20,({
    Name()+" flattert umher.\n",
      Name()+" flattert auf und ab.\n"}));
}

void create()
{
  SetProp(P_PET_PRICE, 3000);
  SetProp(P_PET_LEVEL, 2);
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_RACE, "Schmetterling");
  SetProp(P_NAME, "Schmetterling");
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "flattert herein");
  SetProp(P_MMSGOUT, "flattert weit weg");
  SetProp(P_SIZE, 6);
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 3);

  SetProp(P_PET_ENEMIES, ({ }));
  SetProp(P_PET_FOOD,
	  (["nektar":3,"honig":2,"schmetterlingfutter":1,"Nahrung":0]));

  create_default_npc(2);

  SetProp(P_HANDS,({" mit seinen Fluegeln", 25, DT_SLASH}));

   SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:     -0.9, DT_SLASH:     0.1, DT_BLUDGEON:    0.1
     , DT_PIERCE:    0.1, DT_SQUEEZE:   0.1, DT_WHIP:        0.1
     , DT_RIP:       0.1]));

  InitSpells();

  AddId(({"schmetterling"}));
}
