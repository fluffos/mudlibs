/*
** Elessar Petshop, Ein Kristalladler
**
**
*/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells()
{
  SetProp(P_SPELLS, 0);

  SetProp(P_SPELLRATE, 35);

  AddSpell(4, 250,
	   Name()+" schlaegt Dich mit seinen starken Fluegeln.\n",
	   Name()+" schlaegt @WEN mit seinen starken Fluegeln.\n",
	   DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 250,
	   Name()+" zwickt Dich stark mit seinem Schnabel.\n",
	   Name()+" zwickt @WEN stark mit seinem Schnabel.\n",
	   DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 300,
	   Name()+" reisst Dich mit seinen Krallen auf.\n",
	   Name()+" reisst @WEN mit seinen Krallen auf.\n",
	   DT_RIP,([SP_SHOW_DAMAGE:1]));
}

void create()
{
  SetProp(P_PET_PRICE, 188000);
  SetProp(P_PET_LEVEL, 15);
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_RACE, "Vogel");
  SetProp(P_NAME, "Kristalladler");
  SetProp(P_MSGIN, "fliegt herein und landet");
  SetProp(P_MSGOUT, "springt hoch und fliegt");
  SetProp(P_MMSGIN, "landet hier");
  SetProp(P_MMSGOUT, "fliegt weg");
  SetProp(P_SIZE, 60);
  SetProp(P_ALIGN, -30);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 9243);
  
  SetProp(P_PET_ENEMIES, ({"maus","hamster","murmeltier","schlange",
			     "vogel"}));
  SetProp(P_PET_FOOD,
	  (["fleisch":3,"vogelfutter":1,"Nahrung":0]));
  
  create_default_npc(15);
  
  SetProp(P_HANDS,({" mit seinem spitzen Schnabel", 165, DT_PIERCE}));

  SetProp(P_RESISTANCE_STRENGTHS ,
	  ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
	     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
	     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
	     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
	     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
	     , DT_MIND:     -0.9, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
	     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
	     , DT_RIP:       0.0
	   ]));
  
  InitSpells();
  
  AddId(({"vogel","adler","kristalladler"}));
}
