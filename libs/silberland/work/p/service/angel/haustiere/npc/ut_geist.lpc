inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 30);

   AddSpell(4, 250,
      Name()+" saugt dir Lebenskraft ab!\n",
      Name()+" raubt @WEM Lebenskraft!\n",
      DT_UNHOLY, ([SP_SHOW_DAMAGE:1]));

   AddSpell(1, 400,
     Name()+" verflucht dich mit schrecklichen Worten.\n",
     Name()+" verflucht @WEN mit schrecklichen Worten.\n",
      DT_UNHOLY, ([SP_SHOW_DAMAGE:1])
   );

   AddSpell(2, 300,
      "Der Geist erschreckt dich!\n",
      "Der Geist erschreckt @WEN!\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));

   AddSpell(7, 200,
      Name()+" gleitet durch dich hindurch!\n",
      Name()+" gleitet durch @WEN hindurch!\n",
      DT_COLD, ([SP_SHOW_DAMAGE:1])
   );
}

void create ()
{
   SetProp (P_PET_PRICE, 300000);
   SetProp (P_PET_LEVEL, 12);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Untoter");
   SetProp (P_NAME, "Geist");
   SetProp (P_MSGIN, "schwebt herein");
   SetProp (P_MSGOUT, "schwebt");
   SetProp (P_MMSGIN, "loest sich in Luft auf");
   SetProp (P_MMSGOUT, "wird sichtbar");
   SetProp (P_SIZE, 170);
   SetProp (P_ALIGN, 0);
   SetProp (P_MAX_HANDS, 2);
   SetProp (P_GENDER, MALE);

   AddClass( ({CL_UNDEAD}) );

   SetProp (P_PET_FOOD, ([  "leiche":1, "geisterfutter":3, "untotenfutter": 1, "Nahrung":0 ]) );

   create_default_npc(16);

   SetProp( P_HANDS,({" mit seinen durchscheinenden Haenden"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_MIND, DT_TERROR })
                     }) );

   SetProp( P_RESISTANCE_STRENGTHS,([
        DT_COLD:-1.0, DT_FIRE:0.3, DT_HOLY:0.5, DT_MAGIC: 0.3,
        DT_SLASH:    -0.8, DT_BLUDGEON:   -0.8
      , DT_PIERCE:   -0.8, DT_SQUEEZE:  -0.8, DT_WHIP:       -0.8
      , DT_RIP:      -0.8]));

  InitSpells ();

  SetProp(P_NOCORPSE, 1);
  SetProp(P_DIE_MSG, "loest sich in Luft auf.\n");

  AddId( ({"geist"}) );
}
