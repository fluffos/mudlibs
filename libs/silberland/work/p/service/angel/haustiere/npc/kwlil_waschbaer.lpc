#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/p/service/angel/haustiere/std_pet.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  SetProp (P_PET_PRICE, 100000);
  SetProp (P_PET_LEVEL, 10);

  if(!is_clone(TO)) return;

  ::create();

//--Bezeichnungen----------------------------------------------------------

  SetProp(P_NAME, "Waschbaer");
  SetProp(P_GENDER, MALE);
  AddId(({"waschbaer", "baer", "FELL_WUSCHEL"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE,1);

  SetProp(P_PET_ENEMIES, ({ }) );
  SetProp(P_PET_FOOD, (["ei":3, "waschbaerenfutter":2, "Nahrung":0]) );

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10);

  SetProp(P_HANDS, ({" mit seinen Waschbaerpfoten"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Waschbaer");
  SetProp(P_SIZE, 40+random(20));
  SetProp(P_WEIGHT, 9000+random(3000));
  SetProp(P_ALIGN, -40);
  SetProp(P_MAX_HANDS, 4);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "trollt sich herein");
  SetProp(P_MSGOUT, "trollt sich weiter");
  SetProp(P_MMSGIN, "trollt sich herbei");
  SetProp(P_MMSGOUT, "trollt sich davon");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

   AddSpell(1, 120,
     Name()+" beisst Dich kraeftig ins Bein!",
     Name()+" beisst @WEN kraeftig ins Bein!\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

//--Create Ende------------------------------------------------------------

}
