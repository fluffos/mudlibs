#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/p/service/angel/haustiere/std_pet.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  SetProp (P_PET_PRICE, 25000);
  SetProp (P_PET_LEVEL, 5);

  if(!is_clone(TO)) return;

  ::create();

//--Bezeichnungen----------------------------------------------------------

  SetProp(P_NAME, "Frettchen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"frettchen", "FELL_WUSCHEL"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE,1);

  SetProp(P_PET_ENEMIES, ({ }) );
  SetProp(P_PET_FOOD, (["obst":3, "frettchenfutter":2, "Nahrung":0]) );

//--Eigenschaften----------------------------------------------------------

  create_default_npc(5);

  SetProp(P_HANDS, ({" mit seinen kleinen Pfoten"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Frettchen");
  SetProp(P_SIZE, 20+random(35));
  SetProp(P_WEIGHT, 500+random(1200));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht sich davon");
  SetProp(P_MMSGIN, "schleicht herein");
  SetProp(P_MMSGOUT, "schleicht sich davon");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

   AddSpell(1, 70,
     Name()+" beisst Dich mit seinen spitzen Zaehnen!",
     Name()+" beisst @WEN mit seinen spitzen Zaehnen!\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

//--Create Ende------------------------------------------------------------

}
