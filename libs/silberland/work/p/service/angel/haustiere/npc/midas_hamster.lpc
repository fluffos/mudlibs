/*
** Midas Petshop, Ein Hamster
**
**
*/

inherit "/p/service/angel/haustiere/std_pet";

#include <class.h>
#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells()
{
  SetProp(P_SPELLS, 0);

  SetProp(P_SPELLRATE, 25);

  AddSpell(9,100,
	   Name()+" knabbert an Deinem Fuss.\n",
	   Name()+" knabbert an @WESSEN Fuss.\n",
	   DT_PIERCE,([SP_SHOW_DAMAGE:1]));
}

void create()
{
  ::create();

  SetProp(P_PET_PRICE, 40000);

  SetProp(P_RACE, "Hamster");
  SetProp(P_NAME, "Goldhamster");
  SetProp(P_MSGIN, "trippelt herein");
  SetProp(P_MSGOUT, "trippelt");
  SetProp(P_MMSGIN, "trippelt herein");
  SetProp(P_MMSGOUT, "trippelt weit weg");
  SetProp(P_SIZE, 15);
  SetProp(P_ALIGN, 10);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 350);
  
  SetProp(P_PET_ENEMIES, ({ }));
  SetProp(P_PET_FOOD,
	  (["obst":3,"gemuese":2,"hamsterfutter":1,"Nahrung":0]));
  
  create_default_npc(13);
  
  SetProp(P_HANDS,({" mit seinen scharfen Zaehnchen", 115, DT_RIP}));
  
  SetProp(P_RESISTANCE_STRENGTHS ,
	  ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
	     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
	     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
	     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
	     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
	     , DT_MIND:     -0.9, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
	     , DT_PIERCE:    0.0, DT_SQUEEZE:  -0.1, DT_WHIP:        0.0
	     , DT_RIP:       0.0
	     ]));
  
  InitSpells();
  
  AddId(({"hamster","goldhamster"}));
  AddClass(CL_ANIMAL);
}
