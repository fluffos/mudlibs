/********************************************************************
 * NPC: Ein Wurm als Haustier                                    *
 * Datei: /p/service/angel/haustiere/npc/kolibri.c                  *
 * Letzte Ueberarbeitung: 21.12.2002                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 30);

   AddSpell(1, 40,
     Name()+" wirft sich gegen Dich.",
     Name()+" wirft sich gegen @WEN.\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));
}

void create ()
{
   SetProp (P_PET_PRICE, 1000);
   SetProp (P_PET_LEVEL, 2);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Wurm");
   SetProp (P_NAME, "Wurm");
   SetProp (P_MSGIN, "kriecht herein");
   SetProp (P_MSGOUT, "kriecht");
   SetProp (P_MMSGIN, "kriecht aus dem Boden");
   SetProp (P_MMSGOUT, "kriecht");
   SetProp (P_SIZE, 10 + random(5));
   SetProp (P_ALIGN, -100);
   SetProp (P_MAX_HANDS, 1);
   SetProp (P_GENDER, MALE);

   AddClass( ({CL_NIGHTVISION, CL_DARKELF}) );

   SetProp (P_PET_ENEMIES, ({ }) );
   SetProp (P_PET_FOOD, ([ "leiche":3, "erde":2, "wurmfutter":1, "Nahrung":0 ]) );

   create_default_npc(2);

   SetProp( P_HANDS,({" mit seinem windigen Koerper"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_BLUDGEON })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]) );

  InitSpells ();

  AddId( ({"wurm"}) );
}
