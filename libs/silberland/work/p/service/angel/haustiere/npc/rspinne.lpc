/********************************************************************
 * NPC: Eine Riesenspinne als Haustier                              *
 * Datei: /p/service/angel/haustiere/npc/rspinne.c                  *
 * Letzte Ueberarbeitung: 20.12.2002                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void gift (object enemy, int damage, mixed dam_type)
{
  if(!enemy->QueryProp(P_POISON))
    enemy->SetProp(P_POISON, 1);
//  enemy->AddPoison(1+random(3));
}

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 30);

   AddSpell(7, 200,
     Name()+" spritzt Dich mit Gift voll.\n",
     Name()+" spritzt @WEN mit Gift voll.\n",
      DT_POISON,([SP_SHOW_DAMAGE:1])
   );

   AddSpell(2, 250,
     Name()+" schlaegt ihre Giftzaehne in Dich und vergiftet Dich.\n",
     Name()+" schlaegt ihre Giftzaehne in @WEN und vergiftet @WEN .\n",
      DT_POISON, "gift", ([SP_SHOW_DAMAGE:1])
   );

   AddSpell(2, 350,
     Name()+" haelt Dich fest und beisst Dich.\n",
     Name()+" haelt @WEN fest und beisst @WEN.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1])
   );

   AddSpell(1, 400,
     Name()+" stranguliert Dich beinahe mit ihrem Faden.\n",
     Name()+" stranguliert @WEN beinahe mit ihrem Faden.\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1])
   );
}

void create ()
{
   SetProp (P_PET_PRICE, 256000);
   SetProp (P_PET_LEVEL, 16);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Spinne");
   SetProp (P_NAME, "Riesenspinne");
   SetProp (P_MSGIN, "krabbelt herein");
   SetProp (P_MSGOUT, "krabbelt");
   SetProp (P_MMSGIN, "krabbelt herein");
   SetProp (P_MMSGOUT, "krabbelt");
   SetProp (P_SIZE, 200 + random(50));
   SetProp (P_ALIGN, -400);
   SetProp (P_MAX_HANDS, 8);
   SetProp (P_GENDER, FEMALE);

   AddClass( ({CL_NIGHTVISION, CL_DARKELF}) );

   SetProp (P_PET_ENEMIES, ({ "fliege", "mosquito", "moskito", "bremse", "muecke", "insekt", "schmetterling", "ratte", "vogel" }) );
   SetProp (P_PET_FOOD, ([ "rumpelwicht":3, "ratte":2, "spinnenfutter":1, "Nahrung":0 ]) );

   create_default_npc(16);

   SetProp (P_HANDS,({" mit einem ihrer giftigen Beine"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_POISON, DT_PIERCE, DT_BLUDGEON })
                    }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.3, DT_COLD:      0.1, DT_WATER:      -0.4
     , DT_AIR:       0.0, DT_LIGHTNING:-0.3, DT_EXPLOSION:  -0.1
     , DT_SOUND:     0.0, DT_LIGHT:    -0.4, DT_ELECTRIC:    0.1
     , DT_ACID:      0.0, DT_POISON:   -1.0, DT_TERROR:     -0.3
     , DT_HOLY:      0.1, DT_UNHOLY:    0.0, DT_MAGIC:      -0.2
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]) );

   InitSpells();

   AddId( ({"spinne", "riesenspinne"}) );
}
