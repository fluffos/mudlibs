/********************************************************************
 * NPC: Eine Fledermaus als Haustier                                *
 * Datei: /p/service/angel/haustiere/npc/fledermaus.c               *
 * Letzte Ueberarbeitung: 20.12.2002                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 40);

   AddSpell(1, 100,
     Name()+" stoesst einen spitzen Schrei aus.",
     Name()+" schreit @WEN an.\n",
      ({ DT_SOUND }),([SP_SHOW_DAMAGE:1]));
}

void create ()
{
   SetProp (P_PET_PRICE, 16000);
   SetProp (P_PET_LEVEL, 4);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Fledermaus");
   SetProp (P_NAME, "Fledermaus");
   SetProp (P_MSGIN, "flattert herein");
   SetProp (P_MSGOUT, "flattert");
   SetProp (P_MMSGIN, "flattert herein");
   SetProp (P_MMSGOUT, "flattert");
   SetProp (P_SIZE, 20 + random(6));
   SetProp (P_ALIGN, -100);
   SetProp (P_MAX_HANDS, 4);
   SetProp (P_GENDER, FEMALE);

   AddClass( ({CL_NIGHTVISION, CL_DARKELF}) );

   SetProp (P_PET_ENEMIES, ({ "fliege", "mosquito", "moskito", "bremse", "muecke", "insekt", "schmetterling" }) );
   SetProp (P_PET_FOOD, ([ "schmetterling":3, "fliege":2, "fledermausfutter":1, "Nahrung":0 ]) );

   create_default_npc(4);

   SetProp( P_HANDS,({" mit ihren kleinen Klauen"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_PIERCE })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]) );

  InitSpells ();

  AddId( ({"fledermaus"}) );
}
