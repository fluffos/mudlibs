inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 30);

   AddSpell(1, 150,
     Name()+" versucht dich zu erwuergen.",
     Name()+" versucht @WEN zu erwuergen.\n",
      ({ DT_SQUEEZE }),([SP_SHOW_DAMAGE:1]));

   AddSpell(5, 100,
      Name()+" haut dir auf die Nase.",
      Name()+" haut @WEM auf die Nase.\n",
         ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

   AddSpell(5, 100,
      Name()+" kratzt dich mit seinen Fingernaegeln.",
      Name()+" kratzt @WEN mit seinen Fingernaegeln.\n",
         ({ DT_RIP }),([SP_SHOW_DAMAGE:1]));
}

void create ()
{
   SetProp (P_PET_PRICE, 20000);
   SetProp (P_PET_LEVEL, 5);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Untoter");
   SetProp (P_NAME, "Haendchen");
   SetProp (P_NAME_ADJ, "krabbelnd");
   SetProp (P_MSGIN, "krabbelt herein");
   SetProp (P_MSGOUT, "krabbelt");
   SetProp (P_MMSGIN, "wuehlt sich aus dem Boden");
   SetProp (P_MMSGOUT, "vergraebt sich im Boden");
   SetProp (P_SIZE, 10 + random(5));
   SetProp (P_ALIGN, -100);
   SetProp (P_MAX_HANDS, 0);
   SetProp (P_GENDER, NEUTER);

   AddClass( ({CL_UNDEAD}) );

   SetProp (P_PET_ENEMIES, ({ }) );
   SetProp (P_PET_FOOD, ([  "untotenfutter":3, "Nahrung":0 ]) );

   create_default_npc(2);

   SetProp( P_HANDS,({" mit seinem unheimlichen Leuchten"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_LIGHT })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_COLD:      -0.3, DT_TERROR:     -1.0, DT_HOLY:      0.3, 
       DT_UNHOLY:   -0.1, DT_MAGIC:      -0.1,  DT_MIND:     -1.0, 
     ]) );

  InitSpells ();

  SetProp(P_NOCORPSE, 1);
  SetProp(P_DIE_MSG, "loest sich auf.\n");

  AddId( ({"haendchen"}) );
}
