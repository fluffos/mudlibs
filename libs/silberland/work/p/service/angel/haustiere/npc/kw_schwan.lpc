/*
** Elessar Petshop, Ein Schwan
**
**
*/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells()
{
  SetProp(P_SPELLS, 0);

  SetProp(P_SPELLRATE, 25);

  AddSpell(4,200,
	   Name()+" schlaegt Dich mit seinen starken Fluegeln.\n",
	   Name()+" schlaegt @WEN mit seinen starken Fluegeln.\n",
	   DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,180,
	   Name()+" zwickt Dich mit seinem Schnabel.\n",
	   Name()+" zwickt @WEN mit seinem Schnabel.\n",
	   DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
}

void create()
{

  SetProp(P_PET_PRICE, 90000);
  SetProp(P_PET_LEVEL, 12);

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_RACE, "Vogel");
  SetProp(P_NAME, "Schwan");
  SetProp(P_MSGIN, "stolziert herein");
  SetProp(P_MSGOUT, "stolziert");
  SetProp(P_MMSGIN, "stolziert herein");
  SetProp(P_MMSGOUT, "stolziert weit weg");
  SetProp(P_SIZE, 80);
  SetProp(P_ALIGN, -30);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 12243);

   SetProp(P_PET_ENEMIES, ({"frosch"}));
   SetProp(P_PET_FOOD,
	   (["semmel":3,"brot":3,"vogelfutter":1,"Nahrung":0]));

   create_default_npc(12);

   SetProp(P_HANDS,({" mit seinem Schnabel", 145, DT_RIP}));

   SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:     -0.9, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]));

  InitSpells();

  AddId(({"schwan"}));
}
