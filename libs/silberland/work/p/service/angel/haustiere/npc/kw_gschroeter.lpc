/*
** Elessar Petshop, Ein grosser Quarzschroeter
**
**
*/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells()
{
  SetProp(P_SPELLS, 0);

  SetProp(P_SPELLRATE, 25);

  AddSpell(9,100,
	   Name()+" schleudert Dich mit seinen Zangen durch die Luft.\n",
	   Name()+" schleudert @WEN mit seinen Zangen durch die Luft.\n",
	   DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,200,
	   Name()+" drueckt Dir die Luftroehre zu.\n",
	   Name()+" drueckt @WEM die Luftroehre zu.\n",
	   DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(20,({
    "Der grosse Schroeter wird jetzt erst richtig aggressiv.\n",
      "Der grosse Schroeter fuchtelt wie wild mit seinen Zangen. \n"}));
}

void create()
{
  SetProp(P_PET_PRICE, 50000);
  SetProp(P_PET_LEVEL, 10);
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_RACE, "Kaefer");
  SetProp(P_NAME, "Quarzschroeter");
  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "krabbelt herein");
  SetProp(P_MMSGOUT, "krabbelt weit weg");
  SetProp(P_SIZE, 25);
  SetProp(P_ALIGN, -100);
  SetProp(P_BODY, 80);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 323);

  SetProp(P_PET_ENEMIES, ({ }));
  SetProp(P_PET_FOOD,
	  (["EDELSTEIN":5,"quarz":4,"schroeterfutter":1,"Nahrung":0]));

   create_default_npc(10);

   SetProp(P_HANDS,({" mit seinen gefaehrlichen Zangen", 90, DT_RIP}));

   SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:     -0.9, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:  -0.1, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]));

  InitSpells();

  AddId(({"schroeter", "quarzschroeter"}));
}
