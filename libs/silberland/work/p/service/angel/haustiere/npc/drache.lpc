/********************************************************************
 * NPC: Ein Drache als Haustier fuer Aaliyah                        *
 * Datei: /p/service/angel/haustiere/npc/drache.c                   *
 * Letzte Ueberarbeitung: 24.05.2005                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 50);

   AddSpell(1, 400,
     Name()+" spuckt eine Flammenwolke auf Dich.\n",
     Name()+" spuckt eine Flammenwolke auf @WEN.\n",
      ({ DT_FIRE }),([SP_SHOW_DAMAGE:1]));
   AddSpell(1, 500,
     Name()+" spuckt eine Eiswolke auf Dich.\n",
     Name()+" spuckt eine Eiswolke auf @WEN.\n",
      ({ DT_COLD }),([SP_SHOW_DAMAGE:1]));


}

void create ()
{
   SetProp (P_PET_PRICE, 100000);
   SetProp (P_PET_LEVEL, 30);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Drache");
   SetProp (P_NAME, "Drache");
   SetProp (P_MSGIN, "stapft herein");
   SetProp (P_MSGOUT, "stapft");
   SetProp (P_MMSGIN, "fliegt herein");
   SetProp (P_MMSGOUT, "fliegt weg");
   SetProp (P_SIZE, 1000);
   SetProp (P_ALIGN, 0);
   SetProp (P_MAX_HANDS, 6);
   SetProp (P_GENDER, MALE);

   SetProp (P_PET_ENEMIES, ({ }) );
   SetProp (P_PET_FOOD, ([ "kaninchen":3, "hase":2, "reh":1, "Nahrung":0 ]) );

   create_default_npc(20);

   SetProp( P_HANDS,({" mit seinen Drachenklauen"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_RIP })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.5, DT_COLD:     -1.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.3
     , DT_HOLY:      0.2, DT_UNHOLY:    0.0, DT_MAGIC:      -0.5
     , DT_MIND:      0.0, DT_SLASH:    -0.3, DT_BLUDGEON:   -0.3
     , DT_PIERCE:    0.1, DT_SQUEEZE:  -0.3, DT_WHIP:       -0.3
     , DT_RIP:      -0.3
     ]) );

  InitSpells ();

  AddId( ({"drache"}) );
}
