#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/p/service/angel/haustiere/std_pet.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  SetProp (P_PET_PRICE, 49000);
  SetProp (P_PET_LEVEL, 7);

  if(!is_clone(TO)) return;

  ::create();

//--Bezeichnungen----------------------------------------------------------

  SetProp(P_NAME, "Waldkauz");
  SetProp(P_GENDER, FEMALE);
  AddId(({"waldkauz", "kauz", "FEDERN_WUSCHEL"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE,1);

  SetProp(P_PET_ENEMIES, ({ }) );
  SetProp(P_PET_FOOD, (["maus":3, "eulenfutter":2, "Nahrung":0]) );

//--Eigenschaften----------------------------------------------------------

  create_default_npc(7);

  SetProp(P_HANDS, ({" mit seinen winzigen Krallen"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Waldkauz");
  SetProp(P_SIZE, 15+random(25));
  SetProp(P_WEIGHT, 250+random(150));
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 2);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt weiter");
  SetProp(P_MMSGIN, "kommt von einem Baum geflogen");
  SetProp(P_MMSGOUT, "fliegt auf einen Baum");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

   AddSpell(1, 60,
     Name()+" hackt mit seinem winzigen Schnabel nach Dir.",
     Name()+" hackt mit seinem winzigen Schnabel nach @WEM.\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

//--Create Ende------------------------------------------------------------

}
