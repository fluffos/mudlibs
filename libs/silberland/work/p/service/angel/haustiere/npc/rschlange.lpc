/********************************************************************
 * NPC: Eine Riesenschlange als Haustier                            *
 * Datei: /p/service/angel/haustiere/npc/rschlange.c                *
 * Letzte Ueberarbeitung: 21.12.2002                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 40);

   AddSpell(4, 250,
     Name()+" verpasst Dir einen Schlag mit ihrem Schwanz.\n",
     Name()+" verpasst @WEM einen Schlag mit ihrem Schwanz.\n",
      DT_BLUDGEON,([SP_SHOW_DAMAGE:1])
   );

   AddSpell(1, 400,
     Name()+" schlaegt ihre Zaehne in Deinen Koerper.\n",
     Name()+" schlaegt ihre Zaehne in @WESSEN Koerper.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1])
   );

   AddSpell(2, 300,
     Name()+" schnellt nach vorne und beisst Dich.\n",
     Name()+" schnellt nach vorne und beisst @WEN.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1])
   );

   AddSpell(7, 350,
     Name()+" wichelt sich um Deinen Leib und drueckt zu.\n",
     Name()+" wickelt sich um @WEN und drueckt zu.\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1])
   );
}

void create ()
{
   SetProp (P_PET_PRICE, 144000);
   SetProp (P_PET_LEVEL, 12);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Schlange");
   SetProp (P_NAME, "Schlange");
   SetProp (P_MSGIN, "schlaengelt sich herein");
   SetProp (P_MSGOUT, "schlaengelt");
   SetProp (P_MMSGIN, "faellt herein");
   SetProp (P_MMSGOUT, "springt");
   SetProp (P_SIZE, 550 + random(50));
   SetProp (P_ALIGN, 0);
   SetProp (P_MAX_HANDS, 1);
   SetProp (P_GENDER, MALE);

   SetProp (P_PET_ENEMIES, ({ "hase", "kaninchen", "reh", "schwein", "vogel" }) );
   SetProp (P_PET_FOOD, ([ "hasenbraten":3, "ratte":2, "schlangenfutter":1, "Nahrung":0 ]) );

   create_default_npc(12);

   SetProp( P_HANDS,({" mit ihrem Wuergegriff und scharfen Zaehnen"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_SQUEEZE, DT_PIERCE })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:    -0.2, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.1
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:     -0.2, DT_SLASH:     0.1, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:  -0.2, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]) );

  InitSpells ();

  AddId( ({"schlange", "riesenschlange"}) );
}
