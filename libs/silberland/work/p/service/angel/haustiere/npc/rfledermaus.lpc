/********************************************************************
 * NPC: Eine Riesenfledermaus als Haustier                          *
 * Datei: /p/service/angel/haustiere/npc/rfledermaus.c              *
 * Letzte Ueberarbeitung: 20.12.2002                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 30);

   AddSpell(9, 150,
     Name()+" stoesst einen unertraeglich spitzen Schrei aus.",
     Name()+" schreit @WEN an.\n",
      ({ DT_SOUND }),([SP_SHOW_DAMAGE:1]));

   AddSpell(1, 250,
     Name()+" zerkratzt Dir Dein Gesicht.",
     Name()+" zerkratzt @WESSEN Gesicht.\n",
      ({ DT_RIP }),([SP_SHOW_DAMAGE:1]));
}

void create ()
{
   SetProp (P_PET_PRICE, 64000);
   SetProp (P_PET_LEVEL, 8);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Fledermaus");
   SetProp (P_NAME, "Riesenfledermaus");
   SetProp (P_MSGIN, "flattert herein");
   SetProp (P_MSGOUT, "flattert");
   SetProp (P_MMSGIN, "flattert herein");
   SetProp (P_MMSGOUT, "flattert");
   SetProp (P_SIZE, 50 + random(15));
   SetProp (P_ALIGN, -300);
   SetProp (P_MAX_HANDS, 4);
   SetProp (P_GENDER, FEMALE);

   AddClass( ({CL_NIGHTVISION, CL_DARKELF}) );

   SetProp (P_PET_ENEMIES, ({ "fliege", "mosquito", "moskito", "bremse", "muecke", "insekt", "schmetterling" }) );
   SetProp (P_PET_FOOD, ([ "schmetterling":3, "fliege":2, "fledermausfutter":1, "Nahrung":0 ]) );

   create_default_npc(8);

   SetProp( P_HANDS,({" mit ihren scharfen Klauen"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_PIERCE, DT_RIP })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:      -0.2, DT_LIGHTNING:-0.3, DT_EXPLOSION:   0.0
     , DT_SOUND:    -0.4, DT_LIGHT:    -0.1, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.3
     , DT_HOLY:      0.2, DT_UNHOLY:   -0.1, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.1, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.1
     ]) );

  InitSpells ();

  AddId( ({"fledermaus", "riesenfledermaus"}) );
}
