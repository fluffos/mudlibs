#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/p/service/angel/haustiere/std_pet.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  SetProp (P_PET_PRICE, 256000);
  SetProp (P_PET_LEVEL, 16);

  if(!is_clone(TO)) return;

  ::create();

//--Bezeichnungen----------------------------------------------------------

  SetProp(P_NAME, "Schwarzbaer");
  SetProp(P_GENDER, MALE);
  AddId(({"schwarzbaer", "baer", "FELL_WUSCHEL"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE,1);

  SetProp(P_PET_ENEMIES, ({ }) );
  SetProp(P_PET_FOOD, (["fisch":3, "baerenfutter":2, "Nahrung":0]) );

//--Eigenschaften----------------------------------------------------------

  create_default_npc(16);

  SetProp(P_HANDS, ({" mit seinen grossen Pranken"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Schwarzbaer");
  SetProp(P_SIZE, 140+random(70));
  SetProp(P_WEIGHT, 90000+random(60000));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 4);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft weiter");
  SetProp(P_MMSGIN, "stapft herein");
  SetProp(P_MMSGOUT, "stapft davon");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

   AddSpell(1, 170,
     Name()+" schleudert Dich zu Boden!",
     Name()+" schleudert @WEN zu Boden!\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

   AddSpell(1, 250,
     Name()+" zerkratzt Dich mit seinen scharfen Krallen!",
     Name()+" zerkratzt @WEN mit seinen scharfen Krallen!\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

   AddSpell(1, 350,
     Name()+" zerreisst Dich mit seinen grossen Pranken!",
     Name()+" zerreisst @WEN mit seinen grossen Pranken!\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

//--Create Ende------------------------------------------------------------

}
