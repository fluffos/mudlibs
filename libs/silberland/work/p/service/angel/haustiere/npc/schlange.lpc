/********************************************************************
 * NPC: Eine Schlange als Haustier                                  *
 * Datei: /p/service/angel/haustiere/npc/schlange.c                 *
 * Letzte Ueberarbeitung: 21.12.2002                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void gift (object enemy, int damage, mixed dam_type)
{
  if(!enemy->QueryProp(P_POISON))
    enemy->SetProp(P_POISON, 1);
//  enemy->AddPoison(1+random(3));
}

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 30);

   AddSpell(7, 200,
     Name()+" spritzt Dich mit Gift voll.\n",
     Name()+" spritzt @WEN mit Gift voll.\n",
      DT_POISON,([SP_SHOW_DAMAGE:1])
   );

   AddSpell(2, 250,
     Name()+" schlaegt ihre Giftzaehne in Dich und vergiftet Dich.\n",
     Name()+" schlaegt ihre Giftzaehne in @WEN und vergiftet @WEN .\n",
      DT_POISON, "gift", ([SP_SHOW_DAMAGE:1])
   );

   AddSpell(2, 300,
     Name()+" springt Dich an und beisst Dich.\n",
     Name()+" springt @WEN an und beisst zu.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1])
   );

}

void create ()
{
   SetProp (P_PET_PRICE, 64000);
   SetProp (P_PET_LEVEL, 8);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Schlange");
   SetProp (P_NAME, "Schlange");
   SetProp (P_MSGIN, "schlaengelt sich herein");
   SetProp (P_MSGOUT, "schlaengelt");
   SetProp (P_MMSGIN, "faellt herein");
   SetProp (P_MMSGOUT, "springt");
   SetProp (P_SIZE, 150 + random(20));
   SetProp (P_ALIGN, 0);
   SetProp (P_MAX_HANDS, 1);
   SetProp (P_GENDER, FEMALE);

   SetProp (P_PET_ENEMIES, ({ "hase", "kaninchen", "maus", "ratte", "vogel" }) );
   SetProp (P_PET_FOOD, ([ "hasenbraten":3, "maus":2, "schlangenfutter":1, "Nahrung":0 ]) );

   create_default_npc(8);

   SetProp( P_HANDS,({" mit ihrem Wuergegriff und scharfen Zaehnen"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_POISON, DT_PIERCE, DT_SQUEEZE })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:    -0.2, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.1
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:     -0.2, DT_SLASH:     0.1, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:  -0.2, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]) );

  InitSpells ();

  AddId( ({"schlange", "giftschlange"}) );
}
