/********************************************************************
 * NPC: Ein Pogopuschel als Haustier                                *
 * Datei: /p/service/angel/haustiere/npc/pogopuschel.c              *
 * Letzte Ueberarbeitung: 06.09.2003                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 35);

   AddSpell(8, 150,
     Name()+" verpasst Dir mit seinem Schwanz eine schallende Ohrfeige! AUTSCH!!",
     Name()+" verpasst @WEM mit seinem Schwanz eine schallende Ohrfeige.\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

   AddSpell(2, 225,
     Name()+" spritzt Dir eine aetzende Fluessigkeit ins Gesicht.",
     Name()+" spritzt @WEM eine aetzende Fluessigkeit ins Gesicht.\n",
      ({ DT_POISON }),([SP_SHOW_DAMAGE:1]));

   AddSpell(1, 275,
     Name()+" schlaegt Dir seine spitzen Zaehne ins Fleisch.",
     Name()+" schlaegt @WEM seine Zaehne ins Fleisch.\n",
      ({ DT_PIERCE }),([SP_SHOW_DAMAGE:1]));
}

void create ()
{
   SetProp (P_PET_PRICE, 100000);
   SetProp (P_PET_LEVEL, 9);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Pogopuschel");
   SetProp (P_NAME, "Pogopuschel");
   SetProp (P_MSGIN, "huepft herein");
   SetProp (P_MSGOUT, "huepft");
   SetProp (P_MMSGIN, "springt herein");
   SetProp (P_MMSGOUT, "springt");
   SetProp (P_SIZE, 100 + random(50));
   SetProp (P_ALIGN, 0);
   SetProp (P_MAX_HANDS, 4);
   SetProp (P_GENDER, MALE);

   SetProp (P_PET_ENEMIES, ({ "fisch", "kaninchen", "maus", "vogel" }) );
   SetProp (P_PET_FOOD, ([ "hasenbraten":3, "kaninchen auf spiess":2, "maus":1, "Nahrung":0 ]) );

   create_default_npc(9);

   SetProp( P_HANDS,({" mit seinem kraeftigen Schwanz"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_BLUDGEON })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:      0.0, DT_WATER:      -0.2
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:    -0.2, DT_LIGHT:     0.0, DT_ELECTRIC:    0.2
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.3
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.1, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:      -0.1
     ]) );

  InitSpells ();

  AddId( ({"pogopuschel", "fischwesen", "puschel"}) );
}
