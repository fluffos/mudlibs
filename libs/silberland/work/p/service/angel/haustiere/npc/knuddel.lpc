/********************************************************************
 * NPC: Ein Knuddel als Haustier                                    *
 * Datei: /p/service/angel/haustiere/npc/knuddel.c                  *
 * Letzte Ueberarbeitung: 17.01.2003                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create ()
{
   SetProp (P_PET_PRICE, 4000);
   SetProp (P_PET_LEVEL, 2);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Knuddel");
   SetProp (P_NAME, "Knuddel");
   SetProp (P_MSGIN, "wuselt herein");
   SetProp (P_MSGOUT, "wuselt");
   SetProp (P_MMSGIN, "wuselt herein");
   SetProp (P_MMSGOUT, "wuselt");
   SetProp (P_SIZE, 10 + random(5));
   SetProp (P_ALIGN, 50);
   SetProp (P_MAX_HANDS, 4);
   SetProp (P_GENDER, MALE);

   SetProp (P_PET_ENEMIES, ({ }) );
   SetProp (P_PET_FOOD, ([ "nektar":3, "honig":2, "bonbon":1, "Nahrung":0 ]) );

   create_default_npc(2);

   SetProp( P_HANDS,({" mit seinem traurigen Blick"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_SLASH })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]) );

  InitSpells ();

  AddId( ({"knuddel"}) );
}
