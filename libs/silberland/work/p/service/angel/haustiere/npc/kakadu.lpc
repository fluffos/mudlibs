/********************************************************************
 * NPC: Ein Kolibri als Haustier                                    *
 * Datei: /p/service/angel/haustiere/npc/kolibri.c                  *
 * Letzte Ueberarbeitung: 21.12.2002                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 30);

   AddSpell(7, 150,
     Name()+" knallt Schnabel voran gegen Deinen Magen.",
     Name()+" knallt Schnebel voran gegen @WESSEN Magen.\n",
      ({ DT_PIERCE }),([SP_SHOW_DAMAGE:1]));


   AddSpell(3, 200,
     Name()+" hackt mit seinem Schlabel auf Deinen Kopf ein.",
     Name()+" hackt mit seinem Schnabel auf @WESSEN Kopf ein.\n",
      ({ DT_PIERCE }),([SP_SHOW_DAMAGE:1]));
}

void create ()
{
   SetProp (P_PET_PRICE, 36000);
   SetProp (P_PET_LEVEL, 6);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Kakadu");
   SetProp (P_NAME, "Kakadu");
   SetProp (P_MSGIN, "flattert herein");
   SetProp (P_MSGOUT, "flattert");
   SetProp (P_MMSGIN, "flattert herein");
   SetProp (P_MMSGOUT, "flattert");
   SetProp (P_SIZE, 10 + random(5));
   SetProp (P_ALIGN, 50);
   SetProp (P_MAX_HANDS, 4);
   SetProp (P_GENDER, MALE);

   // Papagei kann sprechen!
   SetProp( P_PET_FORBIDDEN_CMDS, QueryProp(P_PET_FORBIDDEN_CMDS) - ({ "sag" }) );

   SetProp (P_PET_ENEMIES, ({ "wurm", "insekt" }) );
   SetProp (P_PET_FOOD, ([ "paradiesfrucht":3, "frucht":2, "vogelfutter":1, "Nahrung":0 ]) );

   create_default_npc(6);

   SetProp( P_HANDS,({" mit seinem kraeftigen Schnabel"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_PIERCE })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ]) );

  InitSpells ();

  AddId( ({"kakadu", "vogel", "papagei"}) );
}
