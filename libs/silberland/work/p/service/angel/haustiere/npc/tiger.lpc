/********************************************************************
 * NPC: Ein Tiger als Haustier                                      *
 * Datei: /p/service/angel/haustiere/npc/spinne.c                   *
 * Letzte Ueberarbeitung: 20.12.2002                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
  SetProp (P_SPELLS, 0);

  SetProp(P_SPELLRATE, 40);

  AddSpell(1, 500,
    "Der Tiger springt Dich an, reisst Dich zu Boden und graebt seine "
    "Krallen\nin Deine Brust.\n",
    "Der Tiger springt und reisst @WEN zu Boden.\n",
     DT_RIP, ([SP_SHOW_DAMAGE:1]));

  AddSpell(4, 300,
    "Der Tiger zerfetzt Deine Beine zu blutigen Klumpen.\n",
    "Der Tiger zerfetzt @WESSEN Beine zu blutigen Klumpen.\n",
     DT_RIP, ([SP_SHOW_DAMAGE:1]));

  AddSpell(4, 250,
    "Der Tiger attackiert Dich mit messerscharfen Zaehnen.\n",
    "Der Tiger attackiert @WEN mit messerscharfen Zaehnen.\n",
     DT_RIP, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 350,
    "Der Tiger schlaegt Dir eine Pranke ins Gesicht.\n",
    "Der Tiger schlaegt @WEM eine Pranke ins Gesicht.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(5, 200,
    "Der Tiger faucht Dich furchtbar an.\n",
    "Der Tiger faucht @WEN furchtbar an.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));
}

void create ()
{
   SetProp (P_PET_PRICE, 256000);
   SetProp (P_PET_LEVEL, 16);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Tiger");
   SetProp (P_NAME, "Tiger");
   SetProp (P_MSGIN, "schleicht herein");
   SetProp (P_MSGOUT, "schleicht");
   SetProp (P_MMSGIN, "springt herein");
   SetProp (P_MMSGOUT, "springt");
   SetProp (P_SIZE, 250 + random(60));
   SetProp (P_ALIGN, 0);
   SetProp (P_MAX_HANDS, 4);
   SetProp (P_GENDER, MALE);

   SetProp (P_PET_ENEMIES, ({ "hase", "kaninchen", "reh", "schwein", "vogel" }) );
   SetProp (P_PET_FOOD, ([ "hasenbraten":3, "kaninchen auf spiess":2, "katzenfutter":1, "Nahrung":0 ]) );

   create_default_npc(16);

   SetProp( P_HANDS,({" mit seinen scharfen Klauen und Zaehnen"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_PIERCE, DT_RIP })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.3, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.1, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.2, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.3
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:   -0.2, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:      -0.2
     ]) );

  InitSpells ();

  AddId( ({"tiger", "grosskatze", "raubkatze"}) );
}
