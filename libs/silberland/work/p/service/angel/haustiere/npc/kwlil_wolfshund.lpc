#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

inherit "/p/service/angel/haustiere/std_pet.lpc";

//--Create-----------------------------------------------------------------

void create()
{
  SetProp (P_PET_PRICE, 144000);
  SetProp (P_PET_LEVEL, 12);

  if(!is_clone(TO)) return;

  ::create();

//--Bezeichnungen----------------------------------------------------------

  SetProp(P_NAME, "Wolfshund");
  SetProp(P_GENDER, MALE);
  AddId(({"wolfshund", "hund", "FELL_WUSCHEL"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE,1);

  SetProp(P_PET_ENEMIES, ({ }) );
  SetProp(P_PET_FOOD, (["kaninchen":3, "hundefutter":2, "Nahrung":0]) );

//--Eigenschaften----------------------------------------------------------

  create_default_npc(12);

  SetProp(P_HANDS, ({" mit seinen grossen Pfoten"
                    ,QueryProp(P_HANDS)[1]
                    , ({DT_BLUDGEON})
                    })  );

  SetProp(P_RACE, "Wolfshund");
  SetProp(P_SIZE, 55+random(35));
  SetProp(P_WEIGHT, 40000+random(15000));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 4);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft weiter");
  SetProp(P_MMSGIN, "laeuft");
  SetProp(P_MMSGOUT, "laeuft davon");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 30);

   AddSpell(3, 120,
     Name()+" springt Dich von hinten an.",
     Name()+" springt @WEN von hinten an.\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

   AddSpell(4, 150,
     Name()+" schnappt wuetend nach Dir!",
     Name()+" schnappt wuetend nach @WEM!\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

   AddSpell(3, 220,
     Name()+" zerreisst Dich mit seinen scharfen Zaehnen!",
     Name()+" zerreisst @WEN mit seinen scharfen Zaehnen!\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

//--Create Ende------------------------------------------------------------

}
