inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 30);

   AddSpell(1, 40,
     Name()+" leuchtet dich hell an.",
     Name()+" leuchtet @WEN an.\n",
      ({ DT_LIGHT }),([SP_SHOW_DAMAGE:1]));
}

void create ()
{
   SetProp (P_PET_PRICE, 2000);
   SetProp (P_PET_LEVEL, 2);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Untoter");
   SetProp (P_NAME, "Irrlicht");
   SetProp (P_MSGIN, "schwebt herein");
   SetProp (P_MSGOUT, "schwebt");
   SetProp (P_MMSGIN, "entsteht aus Nebel");
   SetProp (P_MMSGOUT, "loest sich auf");
   SetProp (P_SIZE, 10 + random(5));
   SetProp (P_ALIGN, -100);
   SetProp (P_MAX_HANDS, 0);
   SetProp (P_GENDER, NEUTER);

   AddClass( ({CL_UNDEAD}) );

   SetProp (P_PET_ENEMIES, ({ }) );
   SetProp (P_PET_FOOD, ([ "leiche":3, "geiterfutter":1, "Nahrung":0 ]) );

   create_default_npc(2);

   SetProp( P_HANDS,({" mit seinem unheimlichen Leuchten"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_LIGHT })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -1.0
     , DT_HOLY:      0.0, DT_UNHOLY:   -0.1, DT_MAGIC:       0.0
     , DT_MIND:     -0.1, DT_SLASH:    -0.5, DT_BLUDGEON:   -0.5
     , DT_PIERCE:   -0.5, DT_SQUEEZE:  -0.5, DT_WHIP:       -0.5
     , DT_RIP:      -0.5
     ]) );

  InitSpells ();

  SetProp(P_NOCORPSE, 1);
  SetProp(P_DIE_MSG, "loest sich auf.\n");

  AddId( ({"irrlicht"}) );
}
