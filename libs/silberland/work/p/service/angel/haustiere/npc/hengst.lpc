/********************************************************************
 * NPC: Ein Einhorn als Haustier                                    *
 * Datei: /p/service/angel/haustiere/npc/einhorn.c                  *
 * Letzte Ueberarbeitung: 14.04.2004                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_pet.lpc";

#include "/d/def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void InitSpells ()
{
   SetProp (P_SPELLS, 0);

   SetProp(P_SPELLRATE, 30);

   AddSpell(9, 200,
     Name()+" tritt Dich mit seinem Huf.",
     Name()+" tritt @WEN mit seinem Huf.\n",
      ({ DT_BLUDGEON }),([SP_SHOW_DAMAGE:1]));

   AddSpell(1, 300,
     Name()+" peitscht Dich seinem Schweif .",
     Name()+" peitscht @WEN mit seinem Schweif.\n",
      ({ DT_PIERCE }),([SP_SHOW_DAMAGE:1]));
}

void create ()
{
   SetProp (P_PET_PRICE, 10000);
   SetProp (P_PET_LEVEL, 20);
   if (!is_clone(this_object())) return;
   ::create();


   SetProp (P_RACE, "Hengst");
   SetProp (P_NAME, "edler, weisser Hengst");
   SetProp (P_MSGIN, "galoppiert elegant herein");
   SetProp (P_MSGOUT, "galoppiert elegant");
   SetProp (P_MMSGIN, "galoppiert elegant herein und steigt.");
   SetProp (P_MMSGOUT, "steigt und galoppiert elegant");
   SetProp (P_SIZE, 250 + random(50));
   SetProp (P_ALIGN, 0);
   SetProp (P_MAX_HANDS, 4);
   SetProp (P_GENDER, NEUTER);

   SetProp (P_PET_ENEMIES, ({ }) );
   SetProp (P_PET_FOOD, ([ "apfel":3, "karotte":2, "semmel":1, "Nahrung":0 ]) );

   create_default_npc(10);

   SetProp( P_HANDS,({" mit seinen Hinterhufen"
                      ,QueryProp(P_HANDS)[1]
                      ,({ DT_PIERCE })
                     }) );

   SetProp (P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.3
     , DT_HOLY:      0.2, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:   -0.1, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:      -0.1
     ]) );

  InitSpells ();

  AddId( ({"hengst", "huftier"}) );
}
