/*
  Ogermaster! by PROtheG
*/

#pragma strong_types;

#include "../def.h"

#define HISTSIZE 15
#define OGERSAVE RTM "ogersave"
#define KNOCHEN OBJ "grimowknochen"

int version;
nosave string *history;

nomask int query_prevent_shadow() { return 1; }

nomask varargs nosave int allowed(mixed prev, string what)
{
  if(!objectp(prev)) return 0;
  
  if((TP) && (interactive(TP)) && (getuid(TP)=="protheg")) return 1;
  
  if(interactive(prev)) return 0;
  
  if(stringp(what))
    if(strstr(file_name(prev), what))
      {
	DB(sprintf("*** Ogertool %O messed by %O [%O]\n",
		   ENV(ME), prev, prev->QueryProp(P_CLONER)));
	return 0;
      }
  
  return 1;
}

nomask void create()
{
  SUID;
  
  history=({});
  
  restore_object(OGERSAVE);
}

nomask public void AddHistory(string who, string what)
{
  if(!allowed(PO, KNOCHEN)) return;  
  
  history+=({({time(), who, what})});
  
  if(sizeof(history) > HISTSIZE)
    history-=({history[0]});

}

nomask public string *QueryHistory()
{
  if(!allowed(PO, KNOCHEN)) return 0;
  
  return history;
}

nomask nosave int is_listening(object who)
{
  if(who->QueryProp("Ogerlistener"))
    return 1;
  
  return 0; 
}

nomask public object *QueryListeners()
{
  return filter_array(users(), "is_listening");
}

nomask public int GetCurrentVersion()
{
  return version;  
}

varargs nomask public int UpdateCurrentVersion(int noversionupgrade)
{
  object *pls;
  object sp;
  int i;

  if(!allowed(PO)) return 0;
  
  if(!noversionupgrade) version++;
  save_object(OGERSAVE);
  
  if(sizeof(pls=QueryListeners()))
    for(i=sizeof(pls)-1;i>=0;i--)
      if(sp=present(RACETOOLID, pls[i]))
	sp->erneuern(1);

  return version;
}

nomask public int SetCurrentVersion(int i)
{
  if(!allowed(PO, KNOCHEN)) return 0;

  version=i;
  save_object(OGERSAVE);
  return version;
}

