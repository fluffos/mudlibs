#pragma strong_types;

#include "../def.h"
#include <ansi.h>
#include <exploration.h>

inherit "std/thing";
inherit MOST "std_things";

// Reporteinstellungen
#define NORMAL    0
#define KURZ      1
#define FARBE     2
#define FARBEKURZ 3

//Somit ist moeglich "blabla"+C+"blabla"+N
#define C GetColor()
#define S(x) GetColor(x)
#define N NormalColor()

#define FM(x, y, z) (x->QueryProp(P_GENDER)==FEMALE ? y : z)

#define INV_TEST(x,y,z) (IS_LEARNER(x) && IS_LEARNER(y) && \
                         z->QueryProp(P_INVIS))

#define WIZ_NAME(pl,genitiv) ("("+capitalize(getuid(pl))+ \
    (genitiv ? (strstr("xsz",getuid(pl)[<1..])!=-1?"'":"s"):"")+")")

nosave int lastHP, lastSP, aktiv=0, show, xpdiff, souldate, setting, netalivebug;
nosave object owner;
nosave string owner_name, currentcolor;
nosave mapping soulcmds;

varargs nosave string huefe(int flag);
nosave varargs int rbefehl(string str, string *form, int sp, int nearonly);
varargs void init_soul_cmds(int force);

// Farbe wird wieder zurueckgesetzt
string NormalColor()
{
  if(setting)
    return ANSI_NORMAL;

  return "";
}
//Liefert den aktuellen Farbwert (oder nichts), mit flag (i) wird ein neuer
//Farbwert gesetzt. i=1 > beliebige Farbe. i=ANSI_RED > rot etc.
varargs string GetColor(mixed i)
{
  if(!setting)
    return currentcolor="";
  
  if(!i) 
    return currentcolor;
  
  if(intp(i))
    return currentcolor=({ANSI_RED,ANSI_BLUE,ANSI_CYAN,ANSI_PURPLE})[random(4)];
  
  return i;
}

//Speichert die Farbeinstellung und setzt eine beliebige Farbe auf aktuell
void Setting(int i)
{
  setting=i;
  GetColor(1);
}

//Liefert die Versionsnummer zurueck
int Version()
{
  return 1;
}

//Liefert den Filename zum Masterobjekt
string Master()
{
  return "bla";
}

// liefert den String fuer die Rasse
string Rasse()
{
  return "Hund";
}

// liefert den String fuers ignorieren (ignoriere bla)
string IgnoriereID()
{
  return "bla";
}

// Meldung fuer Report wenn absolut fit
string absolut_fit()
{
  return "Du bist nun wieder absolut fit.";
}

// Report Zeilen normal
string Report_normal(int hp, int maxhp, int sp, int maxsp)
{
  return "* Du hast nun "+hp+" von "+maxhp+" Lebenspunkten und "+sp+" von "+
    maxsp+" Magiepunkten.";
}

// Report Zeilen kurz
string Report_kurz(int hp, int maxhp, int sp, int maxsp)
{
  return "* LP: "+hp+" ("+maxhp+") MP: "+sp+" ("+maxsp+")";
}

// Spezialbehandlungen von Aufenthaltsorten bei werliste
string Region(string str)
{
  return "";
}

//Wird ausgegeben, wenn sich das Tool selbst erneuert
string Erneuern_Meldung()
{
  return BS(C+"Dein Tool erneuert sich!"+N);
}

//Rassentitel
string Titel(object pl)
{
  if(IS_SEER(pl))
    return "Ober"+FM(pl, "nudel ","nudler ");
  
  return FM(pl, "Nudel ", "Nudler ");
}

//Meldung wenn die History noch leer ist
nosave string History_leer()
{
  return BS("In letzter Zeit war es recht ruhig...");
}

//Ueberschrift der History
nosave string History_msg()
{
  return "Hier kommt die Liste";
}

// <Spieler> <History_format> huhu
//zb: Protheg teilte Dir mit: huhu
nosave string History_format()
{
  return "teilte Dir mit: ";
}

//NotifyFail beim rufen
string Rufen_syntax()
{
  return BS("Was willst Du den anderen mitteilen?");
}

// <Spieler> <Rufen_format> huhu
//zb: Protheg teilt Dir mit: huhu
string Rufen_format()
{
  return "teilt Dir mit: ";
}

//Format der Rufenausgabe an den Spieler
string Rufen_msg()
{
  return "Du teilst den Anderen mit: ";
}

void create()
{
  if (!is_clone(ME)) return;  // (return on BP)
  ::create();
  
  AddId(({RACETOOLID}));
  
  SetProp(P_MAGIC, 1);
  SetProp(P_NEVERDROP, 1);  
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_NODROP, "Nein! Das willst Du nicht!!\n");
  lastHP = lastSP = -1;
  setting=0;
  xpdiff=-1;
  
  SetProp(P_NOSELL,
	  "Nein! Das willst Du nicht verkaufen!!\n");
}

void reset()
{
  if(!is_clone(ME)) return;
  ::reset();
  
  // Falls sich bei den r* commands was geaendert hat (Soul)
  call_out("init_soul_cmds", 5+random(10));
}

//Aktivierung des reports
void activate(object ob)
{
  if (objectp(ob)) 
    {
      aktiv = 1;
      owner = ob;
      owner_name = getuid(owner);
      ob->AddHpHook(ME);
      lastHP = ob->QueryProp(P_HP);
      lastSP = ob->QueryProp(P_SP);
    } 
  else 
    {
      if (ob=(owner||TP)) ob->RemoveHpHook(ME);
      owner = owner_name = aktiv = 0;
    }
}

//Gibts eine neuere Version des Tools
public varargs int erneuern(int force)
{
  object neu;
  string msg;
  
  if(!is_clone(ME)) return 0;
  
  if(!MENV) 
    return call_out("remove",0), 0;
  
  if((!force) && 
     (Master()->GetCurrentVersion(explode(file_name(ME), "#")[0])==Version()))
    return 0;
  
  RemoveCmd(0);
  
  SetProp(P_INVIS, 1);
  
  neu=clone_object(explode(file_name(ME), "#")[0]);
  neu->move(MENV, M_NOCHECK);
  
  if(aktiv) neu->activate(MENV);
  
  //Uebernahme der Farbeinstellung
  neu->Setting(setting);
  //Uebernahme des ReportStatus
  neu->SetReportStatus(show);
  neu->SetProp(P_KEEP_ON_SELL, QueryProp(P_KEEP_ON_SELL));
  
  activate(0);
  
  if(strlen(msg=Erneuern_Meldung()))
    tell_object(MENV, msg+"\n");
  
  call_out("remove", 0);
  
  return 1;
}

void BecomesNetDead(object who)
{
  if((objectp(who)) && (who==MENV))
    xpdiff=-1;
  
  netalivebug=1; //sollte bei BecomesNetAlive auf 0 gesetzt werden
}

void BecomesNetAlive(object who)
{
  netalivebug=0; //Falls das mal wieder nicht aufgerufen wird, kuemmern wir
                 //uns spaeter darum -> r* commands
  
  xpdiff=-1;
  
  if(MENV && MENV==who)
    {
      call_out("erneuern", 0);
      
      xpdiff=who->QueryProp(P_XP);
    }
}

//Liefert den Namen der Listener-Prop
string Listener()
{
  return Rasse()+"listener";
}

nosave int is_race(object who)
{
  if(who->QueryProp(P_RACE)==Rasse()) return 1;
  else return 0;
}

nosave int is_higher(object a, object b)
{
  if((a->QueryProp(P_LP))>(b->QueryProp(P_LP))) return 1;
  else return 0;
}

//Wer ignoriert das tool? Gesetzt in IgnoriereID()
int is_not_ignoring(object pl, string str)
{
  string *ign;
  string *tmp;
  string str2;
  
  if(!interactive(pl)) return 0;
  if(!pointerp(ign=pl->QueryProp(P_IGNORE))) return 0;
  
  if(str=="presay")
    if((member(ign, IgnoriereID()+".presay")!=-1) ||
       (member(ign, lower_case(Rasse())+".presay")!=-1) ||
       (member(ign, "rassenpresay")!=-1))
      return 0;
  
  if(sizeof(tmp=explode(str, "///"))==2)
    {
      str=tmp[0];
      str2=tmp[1];
    }
  
  if((member(ign, IgnoriereID()+"."+str)!=-1) ||
     (member(ign, lower_case(Rasse())+"."+str)!=-1) ||
     (member(ign, str+"."+IgnoriereID())!=-1) ||
     (member(ign, str+"."+lower_case(Rasse()))!=-1) ||
     (member(ign, IgnoriereID())!=-1) ||
     (member(ign, str)!=-1) ||
     (member(ign, lower_case(Rasse()))!=-1))
    return 0;

  if((member(ign, IgnoriereID()+"."+str2)!=-1) ||
     (member(ign, lower_case(Rasse())+"."+str2)!=-1) ||
     (member(ign, str2+"."+IgnoriereID())!=-1) ||
     (member(ign, str2+"."+lower_case(Rasse()))!=-1) ||
     (member(ign, IgnoriereID())!=-1) ||
     (member(ign, str2)!=-1) ||
     (member(ign, lower_case(Rasse()))!=-1))
    return 0;

  return 1;
}

//Das ganze negiert, der lesbarkeit halber ;)
int is_ignoring(object pl, string str)
{
  return !is_not_ignoring(pl, str);
}

string ignorieren_hilfe_text()
{
  return "Ignorierte Spieler werden komplett abgefangen:\n"
    " 'ignoriere <name>'\n \n"
    "Ignorieren der Rassenobjekte:\n"
    " zB 'ignoriere spinne' 'ignoriere dunkelelf'\n"
    "Geziehltes ignorieren des Rassenobjektes eines Spielers:\n"
    " zB 'ignoriere <name>.traene' od. '<name>.elf'\n"
    "Ignorieren einzelner Befehle:\n"
    " zB 'ignoriere knuddel' 'ignoriere rgrunz.knochen'\n \n"
    "Ignorieren aller Rassenpresays:\n"
    " 'ignoriere rassenpresay'\n"
    "Ignorieren einiger Rasspresays:\n"
    " zB 'ignoriere spinne.presay' 'ignoriere oger.presay'\n \n"
    "Die einzelnen Rassenobjekte sind zur Zeit:\n"
    " 'spinne' 'knochen' 'traene' 'pfeife' 'gebiss'\n"
    " 'bluete' 'bartspange'\n"
    "Bei Rassen nicht vergessen:\n"
    " 'dunkelelf' 'elf' 'zwerg' 'troll' 'oger 'fee' 'zwerg'.\n";
}

//Liefert alle Anwesnden von Rasse() geordnet oder nicht
//kein Parameter liefert alle nicht ignorierenden von Rasse()
//Parameter 1 liefert alle von Rasse()
//Parameter 1,TP liefert alle von Rasse() ohne manselbst
//Parameter TP liefert alle nicht ignorierenden von Rasse() ohne manselbst
varargs nosave object *Alle_Anwesenden(mixed tmp1, object tmp2)
{
  object *ret;
  
  ret=filter_array(users(), "is_race");
  ret=sort_array(ret, "is_higher");

  if(objectp(tmp1))
    {
      ret-=({tmp1});
      ret=filter_array(ret, CLOSURE(is_not_ignoring), 
		       getuid(tmp1)+"///"+query_verb());    
    }
  else
    if(objectp(tmp2))
      if(!tmp1)
	{
	  ret-=({tmp2});
	  ret=filter_array(ret, CLOSURE(is_not_ignoring), 
			   getuid(tmp2)+"///"+query_verb());    
	}
      else
	ret-=({tmp2});
  
  return ret;
}

varargs string Gesinnung(object tp)
{
  string ret;
  int i;
  
  i=tp->QueryProp(P_ALIGN);
  
  if(!intp(i)) 
    return "neutral";
  
  if(i<= -1200) 
    return "diabolisch";
  
  switch(i)
    {
    case -5000 .. -1000: ret="satanisch";  break;
    case  -999 ..  -800: ret="sehr boese"; break;
    case  -799 ..  -500: ret="boese";      break;
    case  -499 ..  -200: ret="gemein";     break;
    case  -199 ..   -40: ret="frech";      break;
    case   -39 ..    39: ret="neutral";    break;
    case    40 ..   199: ret="nett";       break;
    case   200 ..   499: ret="lieb";       break;
    case   500 ..   799: ret="gut";      break;
    case   800 ..   999: ret="sehr gut"; break;
    default:             ret="heilig";
    }
  
  return ret;
}

nosave string Erschoepfung(object tp)
{
  int p, c;
  
  p = 100 * tp->QueryProp(P_MV) / tp->QueryProp(P_MAX_MV);
  c=setting;
  
  switch (p)
    {
    case 0..5:
      return (c ? ANSI_RED : "")+
	sprintf("%20-s", "STOPP!! LUFT!!")+
	(c ? ANSI_NORMAL : "");
    case 6..15:
      return (c ? ANSI_YELLOW : "")+
	sprintf("%20-s", "total ausser Atem.")+
	(c ? ANSI_NORMAL : "");
    case 16..20: 
      return (c ? ANSI_GREEN : "")+
	sprintf("%20-s", "ziemlich erschoepft.")+
	(c ? ANSI_NORMAL : "");
    case 21..30: 
      return (c ? ANSI_GREEN : "")+
	sprintf("%20-s", "etwas erschoepft.")+
	(c ? ANSI_NORMAL : "");
    default:     
      return duplicate(" ", 20);
    }
}

nosave string Gewicht(object tp)
{
  int p, c;

  p = 100 * (tp->QueryProp(P_TOTAL_WEIGHT) - tp->QueryProp(P_WEIGHT) )
    / tp->QueryProp(P_MAX_WEIGHT);
  c=setting;

  switch (p)
    {
    case  0 ..  50: 
      return duplicate(" ",20);
    case 51 ..  60: 
      return (c ? ANSI_GREEN : "")+sprintf("%20-s","etwas beladen")+(c ? ANSI_NORMAL : "");
    case 61 ..  70: 
      return (c ? ANSI_GREEN : "")+sprintf("%20-s","ziemlich beladen")+(c ? ANSI_NORMAL : "");
    case 71 ..  80: 
      return (c ? ANSI_YELLOW : "")+sprintf("%20-s","schwer beladen")+(c ? ANSI_NORMAL : "");
    case 81 ..  90: 
      return (c ? ANSI_YELLOW : "")+sprintf("%20-s","sehr beladen")+(c ? ANSI_NORMAL : "");
    case 91 ..  95: 
      return (c ? ANSI_RED : "")+sprintf("%20-s","extrem beladen!")+(c ? ANSI_NORMAL : "");
    default:
      return (c ? ANSI_RED : "")+sprintf("%20-s","UFFF!! beladen!")+(c ? ANSI_NORMAL : "");
    }
}

varargs nosave string Balken(int aktuell, int max, int colorflag, int wimpy, int size)
{
  string ret;
  int i,w,s;
  
  if(aktuell > max) aktuell=max;
  
  if(!size) size=30;
  
  if(!colorflag)
    {
      size=size-10; //Anzeige

      i=(aktuell*size/max);
      if(wimpy) w=(wimpy*size/max);
      
      ret=duplicate(" ",size);
      
      if(wimpy)
	if(aktuell<=wimpy)
	  ret=duplicate("+",w)+duplicate("-",size-w);
	else
	  ret=duplicate("+", w)+duplicate("#",i-w)+duplicate("-",size-i);
      else
	ret=duplicate("#",i)+duplicate("-",size-i);

      ret=sprintf("%3d",aktuell)+" ["+sprintf("%3d",max)+"] "+ret; //10
    }
  else
    if(colorflag==1)
      {
	size=size-6; //Anzeige
	
	i=(aktuell*size/max);
	if(wimpy) w=(wimpy*size/max);
	
	ret=duplicate(" ",size);
	
	s=strlen(to_string(aktuell));
	ret[<s+1..<2]=to_string(aktuell);
	
	if(wimpy)
	  if(aktuell<=wimpy)
	    ret=ANSI_BLACK+ANSI_BG_BLUE+ret[0..w-1]+ANSI_BG_RED+ret[w..<0]+ANSI_NORMAL;
	  else
	    ret=ANSI_BLACK+ANSI_BG_BLUE+ret[0..w-1]+ANSI_BG_GREEN+ret[w..i-1]+ANSI_BG_RED+ret[i..<0]+ANSI_NORMAL;
	else
	  ret=ANSI_BLACK+ANSI_BG_GREEN+ret[0..i-1]+ANSI_BG_RED+ret[i..<0]+ANSI_NORMAL;
	
	ret=ret+" ["+sprintf("%3d",max)+"]"; //6
      }
    else
      {
	size=size-10;
	
	i=(aktuell*size/max);
	if(wimpy) w=(wimpy*size/max);
	
	ret=duplicate(" ",size);
	
	if(wimpy)
	  if(aktuell<=wimpy)
	    ret=ANSI_BG_BLUE+ret[0..w-1]+ANSI_BG_RED+ret[w..<0]+ANSI_NORMAL;
	  else
	    ret=ANSI_BG_BLUE+ret[0..w-1]+ANSI_BG_GREEN+ret[w..i-1]+ANSI_BG_RED+ret[i..<0]+ANSI_NORMAL;
	else
	  ret=ANSI_BG_GREEN+ret[0..i-1]+ANSI_BG_RED+ret[i..<0]+ANSI_NORMAL;
	ret=sprintf("%3d",aktuell)+" ["+sprintf("%3d",max)+"] "+ret; //10
      }
  return ret;
}

nosave string Stufenpunkte(object pl)
{
  string ret;
  int i, lvl, rlvl;
  
  if((pl->LpLevel()==(pl->QueryProp(P_LEVEL)+1))
     && (pl->LevelPerc(pl->LpLevel()+1) < 20))
    lvl=pl->QueryProp(P_LEVEL);
  else
    lvl=pl->LpLevel();

  if(((lvl+1) < pl->QueryProp(P_LEVEL)) ||
     (lvl > pl->QueryProp(P_LEVEL)))
    rlvl=pl->QueryProp(P_LEVEL);
  
  i=pl->LevelPerc(lvl+1)/10;

  if(!setting)
    ret=sprintf("%10'-'-s", duplicate("#",i));
  else
    {
      ret=duplicate(" ", 10);
      ret=ANSI_BG_GREEN+ret[0..i-1]+ANSI_BG_RED+ret[i..<0]+ANSI_NORMAL;
    }
  
  return sprintf("%3d+ [%s] %3d", lvl, ret, (rlvl ? rlvl : lvl+1));

}

varargs nosave string Zustand(object tp, int flag)
{
  string ret;
  int tmp;

  ret="";

  if(tp->QueryProp(P_FROG))       
    ret+=" Frosch";

  if(tmp=tp->QueryProp(P_POISON)) 
    ret+=(tmp > 5 ? " GIFT!":" Gift");

  if(tp->QueryProp(P_BLIND))      
    ret+=(tp->QueryProp(P_BLIND)[BLIND_TIME] > 15 ? " BLIND!" : " Blind");

  if(tp->QueryProp(P_DEAF))
    ret+=(tp->QueryProp(P_DEAF)[DEAF_TIME] > 15 ? " TAUB!" : " Taub");

  if(!strlen(ret)) 
    if(flag) 
      ret="";
    else
      ret=" Normal.";
  
  return ret;
}

nosave string get_region(string str)
{
  string *fn;
  string ret,tmp;
  
  if(strlen(tmp=Region(str)))
    return " ("+tmp+")";
  
  fn=explode(str, "/");
  
  switch(fn[0])
    {
    case "d":
      ret=sprintf(" (%s)", CAP(fn[1]));
      
      if(fn[1]=="seher")
	ret=" (Seherhaus)";
      break;
    case "gilden":
      ret=" (Gilden)";
      break;
    case "players":
      ret=" (Magiergebiet)";                              
      break;
    case "room":
      if(fn[1]=="death")
	ret=" (Bei Lars)";
      break;
    default:
      ret="";
    }
  
  return ret;
}

//liefert eine formatierte Anwesendenliste mit argument str==kurz und einer
//Anzeige bzgl Unwuerdig, oder nicht
varargs string who_list(string str, int kurz, int unwuerdig)
{
  string ret, plname, region, li;
  object *who, *listeners;
  object weapon, fighting;
  int i, u;

  who=Alle_Anwesenden(1);
  
  ret=str+"\n";
  
  ret+=sprintf("%25-s %6s %20-s%10s\n%64'-'s\n","Name","","Waffe","Gesinnung",""); 
  
  u=0;
  
  for(i=sizeof(who)-1;i>=0;i--)
    {
      if(!IS_WIZARD(TP)) if(who[i]->QueryProp(P_INVIS)) continue;
      
      plname=Titel(who[i]);
      
      if(unwuerdig)
	if(strstr(plname, "Unwuerdig", 0)!=-1)
	  u++;
      
      if((IS_SEER(TP)) && (ENV(who[i])))
	region=get_region(file_name(ENV(who[i])));
      else
	region="";
      
      fighting=who[i]->InFight();
      weapon=who[i]->QueryProp(P_WEAPON);
      
      ret+=sprintf("%25-s %6s %20.20-s %10s\n - Standort: %-50.50s\n%s", 
		   plname+CAP(getuid(who[i])),
		   (query_idle(who[i])>120 ? 
		    (query_idle(who[i])>1800 ? "(IDLE)":"(idle)"):""),
		   (weapon ? extract_colors(weapon->Name(RAW)) : ""),
		   Gesinnung(who[i]),
		   (ENV(who[i]) ? ENV(who[i])->QueryProp(P_INT_SHORT)+region: 
		    "Im Nirvana"),
		   (fighting ? " - Im Kampf mit: "+fighting->Name(WER)+"\n" : 
		    "")+(kurz ? "":"\n"));
    }

  listeners=users()-who;
  li="";

  for(i=sizeof(listeners)-1;i>=0;i--)
    if((listeners[i]->QueryProp(Rasse()+"listener")) && 
       (!listeners[i]->QueryProp(P_INVIS)))
      li+=CAP(getuid(listeners[i]))+(i>0 ? ", ":"");

  if(unwuerdig && u)
    ret+=BS("Das "+(u==1 ? "ist ein Unwuerdiger":"sind "+u+" Unwuerdige")+"!")+
      "\n";
  
  if(strlen(li))
    ret+="Stille Lauscher:\n"+BS(li);
  
  return ret;
}

//wird immer wieder aufgerufen wenn der report aktiv ist
void NotifyHpChange()
{
  int    hp, mhp, sp, msp, prz;
  string col;
  
  // Sicherheits-Check
  if (!previous_object() || !owner || (owner != previous_object()))
    return;

  // Ausschalten wenn aktiv == 0 (z.B. nach Tod)
  if (!aktiv)
  {
    //SetProp(P_NODROP, 0);
    if (owner!=find_netdead(getuid(owner)))
      owner->RemoveHpHook(ME);   // geht nur bei nicht-netztoten Spielern
    return;
  }

  // Test auf Geist
  if (owner->QueryProp(P_GHOST))
    return;

  // aktuelle Werte ermitteln
  hp = owner->QueryProp(P_HP);
  mhp = owner->QueryProp(P_MAX_HP);
  sp = owner->QueryProp(P_SP);
  msp = owner->QueryProp(P_MAX_SP);

  // Vergleich und Ausgabe
  if((hp < lastHP) || (hp != lastHP && sp == msp) || (sp != lastSP))
    {
      switch(show)
	{
	case KURZ:
	  tell_object(owner, BS(Report_kurz(hp, mhp, sp, msp)));

	  if((hp==mhp) && (sp==msp)) tell_object(owner, BS(absolut_fit()));

	  break;
	case FARBE:
	  switch (hp*100/mhp)
	    {
	    case  0 ..  20: col=ANSI_RED+ANSI_BOLD;    break;
	    case 21 ..  40: col=ANSI_BLUE+ANSI_BOLD;   break;
	    case 41 ..  60: col=ANSI_CYAN+ANSI_BOLD;   break;
	    case 61 ..  80: col=ANSI_YELLOW+ANSI_BOLD; break;
	    case 81 .. 100: col=ANSI_GREEN+ANSI_BOLD;  break;
	    default: col=ANSI_NORMAL;
	    }
	  tell_object(owner,
		      col+Report_normal(hp, mhp, sp, msp)+ANSI_NORMAL+"\n");

	  if((hp==mhp) && (sp==msp))
	    tell_object(owner, col+absolut_fit()+ANSI_NORMAL+"\n");

	  break;
	case FARBEKURZ:
	  switch (hp*100/mhp)
	    {
	    case  0 ..  20: col=ANSI_RED+ANSI_BOLD;    break;
	    case 21 ..  40: col=ANSI_BLUE+ANSI_BOLD;   break;
	    case 41 ..  60: col=ANSI_CYAN+ANSI_BOLD;   break;
	    case 61 ..  80: col=ANSI_YELLOW+ANSI_BOLD; break;
	    case 81 .. 100: col=ANSI_GREEN+ANSI_BOLD;  break;
	    default: col=ANSI_NORMAL;
	    }
	  tell_object(owner,
		      col+Report_kurz(hp, mhp, sp, msp)+ANSI_NORMAL+"\n");
	  if((hp==mhp) && (sp==msp))
	    tell_object(owner, 
			col+absolut_fit()+ANSI_NORMAL+"\n");
	  break;
	default:
	  tell_object(owner,
		      BS(Report_normal(hp, mhp, sp, msp)));
	  if((hp==mhp) && (sp==msp))
	    tell_object(owner, BS(absolut_fit()));
	}
    }
  // neue Werte merken
  lastHP = hp; lastSP = sp;
}

//Der reportstatus (NORMAL,KURZ,...) werden beim erneuern uebertragen
public void SetReportStatus(int what)
{
  show=what;
}

nosave int Report(string str)
{
  if(MENV != TP)
    return 0;
  
  notify_fail("Syntax: "+query_verb()+" ein|aus|kurz|farbe|farbekurz.\n");
  
  switch (str)
    {
    case "ein":
    case "n":
    case "normal":
      if (aktiv && objectp(owner))
	if(show==NORMAL)
	  write("Der Report-Modus normal ist schon eingeschaltet!\n");
	else
	  {
	    show=NORMAL;
	    write("Der Report-Modus wird auf normal umgestellt!\n");
	  }
      else 
	{
	  write("Report-Modus ist jetzt eingeschaltet.\n");
	  activate(TP);
	  show=NORMAL;
	}
      break;
    case "a":
    case "aus":
      if (!aktiv)
        write("Der Report-Modus ist doch schon ausgeschaltet!\n");
      else 
	{ 
	  write("Report-Modus ist nun ausgeschaltet.\n");
	  activate(0);
	}
      break;
    case "k":
    case "kurz":
      if(aktiv && objectp(owner))
	if(show==KURZ)
	  write("Der Report-Modus kurz ist schon eingeschaltet!\n");
	else
	  {
	    show=KURZ;
	    write("Der Report-Modus wird auf kurz umgestellt!\n");
	  }
      else
	{
	  write("Report-Modus kurz ist jetzt eingeschaltet.\n");
	  activate(TP);
	}
      show=1;
      break;
    case "f":
    case "farbe":
      if(aktiv && objectp(owner))
	if(show==FARBE)
	  write("Der Report-Modus farbe ist schon eingeschaltet!\n");
	else
	  {
	    show=FARBE;
	    write("Der Report-Modus wird auf farbe umgestellt!\n");
	  }
      else 
	{
	  write("Report-Modus farbe ist jetzt eingeschaltet.\n");
	  activate(TP);
	}
      show=2;
      break;
    case "fk":
    case "farbekurz":
      if(aktiv && objectp(owner))
	if(show==FARBEKURZ)
	  write("Der Report-Modus farbekurz ist schon eingeschaltet!\n");
	else
	  {
	    show=FARBEKURZ;
	    write("Der Report-Modus wird auf farbekurz umgestellt!\n");
	  }
      else 
	{
	  write("Report-Modus farbekurz ist jetzt eingeschaltet.\n");
	  activate(TP);
	}
      show=3;
      break;
    default:
      return 0;
    }
  return 1;
}

varargs int move(mixed dest, int method)
{
  int res;
  object env;
  
  res=::move(dest,method);
  
  if(res==ME_TOO_HEAVY)
    return res;
  
  env=MENV;
  
  if((IS_LEARNER(env)) || env->QueryProp(P_TESTPLAYER))
    SetProp(P_AUTOLOADOBJ, 1);        // fuer Magier autoload
  else
    SetProp(P_AUTOLOADOBJ, 0);
  
  if((interactive(env)) && (env->QueryProp(P_RACE)!=Rasse()) &&
     (!IS_WIZARD(env)))
    call_out("hau_ab", 0, env);
  else
    {
      if((interactive(env)) && (env->QueryProp(P_RACE)==Rasse()))
	{
	  env->SetProp(Listener(), 1);
	  DB("*** Activating Property "+Rasse()+"-listener in "+CAP(getuid(env))+
	     ". Version 1."+Version()+"\n");
	}
      
      if(xpdiff<=0) xpdiff=env->QueryProp(P_XP);
      
      call_out("checkowner", 1);
    }
    
  return res;
}

void hau_ab(object who)
{
  tell_object(who, "Das ist nicht fuer Dich bestimmt!");

  call_out("remove", 0);
}

nosave int History(string str)
{
  int i, n, s;
  string txt;
  mixed *history;

  history=Master()->QueryHistory();

  if(!sizeof(history))
    return History_leer(), 1;      

  if(strlen(str))
    if((to_string(n = to_int(str)) == str) && (n > 0))
      {
	if(n > 15)
	  return write(BS("Syntax: "+query_verb()+" [1 .. 15]")), 1;
	
	history = history[-n..];

	str=0;
      }
    else
      str=lower_case(TP->_unparsed_args());
  
  txt=History_msg();
  txt+=BS(">"+duplicate("-", 76)+"<");
  
  s=sizeof(history);
  
  for(i=0;i<s;i++)
    {
      if(str && (strstr(lower_case(history[i][1]+history[i][2]), str) == -1))
	continue;
      
      if(((time()+7200)/86400)>((history[i][0]+7200)/86400))
	txt+=BS("("+dtime(history[i][0])+")");
      else
	txt+=BS("("+dtime(history[i][0])[19..26]+")");
      
      txt+=break_string(history[i][2], 78, CAP(history[i][1])+" "+
			History_format());
    }

  txt+=BS(">"+duplicate("-", 76)+"<");

  TP->More(txt);

  return 1;
}

nosave int Rufen(string str)
{
  object *plr;
  string pre;
  int i;
  
  notify_fail(Rufen_syntax());
  if(!str) return 0;
  
  if(!TP) return 0;
  if(!MENV) return 0;
  if(TP!=MENV) return 0;
  
  if(TP->QueryProp(P_INVIS)) 
    return write("Das geht nur, wenn Du sichtbar bist!!\n"),1;
  
  plr=Alle_Anwesenden(TP);
  
  str=TP->_unparsed_args();
  
  pre=Titel(TP);
  pre+=CAP(getuid(TP))+" "+Rufen_format();

  pre=break_string(str, 78, pre);
  
  for(i=sizeof(plr)-1;i>=0;i--)
    tell_object(plr[i], pre);
  
  if(!IS_SEER(TP)) TP->AddSp(-1);
  
  write(break_string(str, 78, Rufen_msg()));

  Master()->AddHistory(getuid(TP),implode(explode(str,"\n"),""));

  return 1;
}

void checkowner()
{
  if (aktiv && !objectp(owner) && stringp(owner_name)) 
    {
      owner = find_player(owner_name);
      if(!objectp(owner)) 
	activate(0);
      else 
	activate(owner);
    }
}

int remove(int x)
{
  if((TP) && (MENV) && (TP==MENV))
    {
      if(aktiv) MENV->RemoveHpHook(ME);

      if(!(present("\n"+Rasse()+"tool", TP)))
	MENV->SetProp(Listener(), 0);
    }
  
  return ::remove(x);
}

void destruct(object ob)
{
  remove();
}

// ---------------------------------------------------------------------------

varargs void init_soul_cmds(int force)
{
  string *cmds;
  string *tmp;
  int i;
  
  if((!force) && (file_date(SOUL+Rasse())==souldate)) return;
  
  souldate=file_date(SOUL+Rasse());

  if(!force)
    DB(BS("*** "+Rasse()+"Soul in "+sprintf("%O", (MENV||TP||"-"))+
	  " Rehashing from file ("+ctime(souldate)+")"));
  
  soulcmds=([]);
  
  cmds=explode(read_file(SOUL+Rasse()), "\n");
  
  for(i=sizeof(cmds)-1;i>=0;i--)
    {
      tmp=explode(cmds[i], "##");
      
      if(sizeof(tmp)!=9)
	{
	  DB("*** RTSoul: Fehler beim Einlesen ("+i+")\n");
	  continue;
	}
      
      soulcmds+=([i:explode(tmp[0],","); ({ tmp[1], tmp[2], tmp[3], tmp[4],
		  tmp[5], tmp[6]}); tmp[7]; tmp[8]]);
      
      AddCmd(soulcmds[i], "rtsoulcmd");
    }
}

nosave int rtsoulcmd(string str)
{
  int i;
  
  for(i=sizeof(soulcmds)-1;i>=0;i--)
    if(member(soulcmds[i], query_verb())!=-1)
      return rbefehl(str, soulcmds[i,1], to_int(soulcmds[i,2]), 
		     to_int(soulcmds[i,3]));
  
  return 0;
}

string _in(string a, mapping m)
{
  if (member(m,lower_case(a)))
    return m[a];
  else
    return "";
}

string ParseAdverben(string str, object ob)
{
  string *advpart;
  mixed quotedpart;
  mapping adverben;

  if (!str) return 0;
  str=" "+str;
  adverben=ob->QueryStdAdverbs()+ob->QueryAdverbs();
  advpart=explode(str,"/");
  if (sizeof(advpart)>1)
    quotedpart=" "+implode(advpart[1..],"/");
  else
    quotedpart="";
  advpart=regexplode(advpart[0],"\\<[^, ]*\\>");
  advpart=map_array(advpart,CLOSURE(_in),adverben) - ({""});
  return sizeof(advpart) ? ob->CountUp(advpart)+quotedpart : quotedpart[1..];
}

/*
explode_str() - ersetzt @@...@@ Makros
-------------
str ......... der String
ob .......... das Objekt, dessen Name eingesetzt werden soll
adv ......... Adverben
fern ........ 0: Naehe, 1: aus der Ferne
*/
varargs string explode_str(string str, object ob, string adv, int fern)
{
  string s,s1,s2,x;
  s2=str;
  s="";

  while (sscanf(s2, "%s@@%s@@%s", s1, x, s2) == 3)
    {
      switch (x)
	{
	case "WER":    
	  if (fern>0 && INV_TEST(TP,ob,ob)) s+=s1+WIZ_NAME(ob,0);
	  else s+=s1+ob->name(WER);
	  break;

	case "WESSEN": 
	  if (fern>0 && INV_TEST(TP,ob,ob)) s+=s1+WIZ_NAME(ob,1);
	  else s+=s1+ob->name(WESSEN);
	  break;

	case "WEM":
	  if (fern>0 && INV_TEST(TP,ob,ob)) s+=s1+WIZ_NAME(ob,0);
	  else s+=s1+ob->name(WEM);
	  break;

	case "WEN":
	  if (fern>0 && INV_TEST(TP,ob,ob)) s+=s1+WIZ_NAME(ob,0);
	  else s+=s1+ob->name(WEN);
	  break;

	case "WIE":
	  s+=s1+adv; 
	  break;
	  
	case "FERN":   
	  if (fern>0) s+=s1+" aus der Ferne"; 
	  else s+=s1; 
	  break;
	  
	case "HAARFARBE":
	  s+=s1+ob->QueryProp(P_HAIR_COLOR)+"e ";
	  break;
	  
	case "HAARFARBEN":
	  s+=s1+ob->QueryProp(P_HAIR_COLOR)+"en ";
	  break;
	}
    }
  
  s+=s2;
  
  return s;
}

/*
  
rbefehl()
---------
str ......... der String, wie er beim Befehl angehaengt wurde
form ........ ein Array mit den diversen Meldungen:
form[0].... Fehlermeldung, wenn str leer ist
form[1].... Fehlermeldung, wenn Spieler == Zielperson
form[2].... sprintf Fehlermeldung bei nicht parse-baren Adverben
"...%s...", Zielperson->Name(casus)
form[3].... sprintf Maske fuer Zielperson
"%s...%s...%s.\n", Spieler, Adverben, ["Ferne"]
form[4].... sprintf Maske fuer Spieler
"...%s...%s...%s.\n", Zielperson->Name(casus), Adverben, ["Ferne"]
form[5].... sprintf Maske fuer Raum
"%s...%s...%s...", Spieler, Zielperson->Name(casus), Adverben
sp........... Kosten (spellpoints)
---
Anmerkungen:

"Ferne"  ist " aus der Ferne", wenn die Spieler in verschiedenen Raeumen
            stehen, sonst ein Leerstring ("").
Adverben   werden wie soul-Adverben geparsed, ihnen wird ausserdem ein
           Space vorangestellt (um sie fuer die sprintf Maske optional
           zu machen).
*/
 
varargs int rbefehl(string str, string *form, int sp, int nearonly)
{
  string *s, adv, away, title;
  mixed ob;
  object room;
  int i, ferne, tmp;
  
  if(MENV != TP)
    return notify_fail(BS("Dazu musst Du "+name(WEN,1)+" erst einmal "
			  "an Dich nehmen!")), 0;
  
  //netalivebug ueberpruefung
  if(netalivebug && !IS_WIZARD(TP))
    call_out("BecomesNetAlive", 0, TP);
  
  if(!IS_SEER(TP) && (TP->QueryProp(P_SP) < sp))
    return notify_fail("Dazu bist Du nicht maechtig genug!\n"), 0;
  
  notify_fail(BS(form[0]));
  
  str=TP->_unparsed_args();
  
  if(!stringp(str) || str=="") return 0;
  
  s=explode(str, " ");
  if(!i=sizeof(s)) return 0;
  
  s[0]=LOWER(s[0]);
  
  ob=find_player(s[0]) || match_living(s[0], 1);
  // ergibt:  - Spielerobjekt oder
  //          - String (passender Spielername) oder
  //          - Integer (-1: multiple matches, -2: no matches)
  if(stringp(ob)) ob=find_player(ob);
  // Jetzt: - Spielerobjekt oder
  //        - Integer (0 oder -2: nicht da, -1: mehrere da)
  
  if(objectp(ob) && ob->QueryProp(P_INVIS) && !IS_WIZARD(TP)) ob=0;
  
  if(!objectp(ob)) 
  {
    if(ob==-1)
      return notify_fail("Das war nicht eindeutig!\n"), 0;
    else
      return notify_fail("Kein solcher Spieler!\n"), 0;
  }
  
  if(ob==TP) return notify_fail(BS(form[1])), 0;
  
  if(i<2) adv="";
  else
    {
      if(!adv=ParseAdverben(implode(s[1..], " "), TP))
	return notify_fail(BS(sprintf(explode_str(form[2], ob)))), 0;
      else
	if(strlen(adv)) adv=" "+adv;
    }
  
  // aus der Ferne?
  // (Bei der Gelegenheit ausserdem gleich room und ferne setzen)
  ferne=(room=ENV(TP)) != ENV(ob);
  
  if(nearonly && ferne)
    return write(BS(ob->Name(WER)+" ist zuweit weg von Dir...")), 1;

  if(is_ignoring(ob, query_verb()))
    return write(BS(ob->Name(WER)+" ignoriert Dich, oder Diesen Befehl.")), 1;
  
  if(is_ignoring(ob, "presay"))
    title="";
  else
    title=Titel(TP);
  
  // Nun die eigentliche Ausgabe:
  // tell_object (ob, bs(sprintf(explode_str(form[3], ob, adv, ferne), TPN)));
  if(ob->Message(BS(CAP(sprintf(explode_str(form[3], ob, adv, ferne),
				title+(INV_TEST(ob,TP,TP) ? WIZ_NAME(TP,0) : TPN)))))==-1)
    write(ob->Name(WER)+" ignoriert Dich oder diesen Befehl.\n");
  else 
  {
    write(BS(CAP(sprintf(explode_str(form[4], ob, adv, ferne)))));
    if(!ferne)
      tell_room(room, BS(CAP(
	  sprintf(explode_str(form[5], ob, adv, -1), Titel(TP)+TPN))), 
	  ({TP,ob}) );
  }
  
  if(interactive(ob) && ((i=query_idle(ob)) >= 600))
    {
      if(i < 3600)
	away = time2string("%m %M", i);
      else
	away = time2string("%h %H und %m %M", i);
      
      printf("%s ist seit %s passiv.\n", ob->Name(WER), away);
    }
  
  
  if(!IS_SEER(TP) && sp)
    TP->AddSp(-sp);
  
  return 1;
}
