#pragma strong_types;

#include "../def.h"
#include <ansi.h>
#include <exploration.h>

inherit STD "rt";

#define ELESSARMASTER "/d/kristallwald/sargola/dorf/npc/wmaster"
#define QM "/secure/questmaster"

#define C +GetColor()+
#define G +GetColor(ANSI_GREEN)+
#define B +GetColor(ANSI_YELLOW)+
#define N +NormalColor()+

varargs nosave string huefe(int flag);

int Version() { return 40;}

nomask void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Eine Buergerfibel von Midas");
  SetProp(P_LONG,
	  "Diese Fibel ist eine fein geabeitete Gewandnadel die golden glaenzt. Sie hat "
    "die Form von zwei Haenden. Wenn man die Fibel schliesst, dann sieht es aus, als "
    "wuerden die Haende einander gereicht werden. Sie ist das offizielle Symbol der "
    "Buerger von Midas und kann Menschen gute Dienste leisten.");
  SetProp(P_NAME, "Buergerfibel");
  SetProp(P_GENDER, FEMALE);

  AddId(({"fibel", "buergerfibel","gewandnadel","\menschen_rt"}));
  
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL, ([MAT_GOLD:5,MAT_MAGIC:10,MAT_COPPER:85]));
  SetProp(P_NODROP, "Diese Fibel ist ein Zeichen deines Stanedes!\n");

  SetProp(P_NOSELL,
	  "Du kannst so ein Standesymbol nicht einfac verkaufen!\n");

  SetProp(P_INFO,
	  BS("Diese Fibel leistet dir nuetzliche Dienste. Tippe <menhilfe> fuer mehr."));

  AddDetail("dienste", CLOSURE(huefe));
  
  AddCmd("menreport", "Report");
  
  //Cmds fuer die Menschenkomunikation
  AddCmd(({"menruf","menrufe"}), "Rufen");
  AddCmd(({"menhist","menhistory"}), "History");
  AddCmd(({"menwinke","menwink"}), "menwink");
  AddCmd(({"menknuddel","menknuddle","menknuddele"}), "menknuddel");

  AddCmd(({"meninfo"}), "meninfo");
  AddCmd(({"menwer"}), "menwer");
  AddCmd(({"menfarbe","menfarben"}), "menfarbe");

  AddCmd(({"menpresay"}), "menpresay");

  AddCmd(({"menhilfe"}), "menhilfe");

  GetColor(1);
  
  SUID;
  
  // r* commands:
  init_soul_cmds(1);
}

string Master()
{
  return RTM "menschenmaster";
}

string Rasse()
{
  return "Mensch";
}

string IgnoriereID()
{
  return "fibel";
}

string absolut_fit()
{
  return "Du bist nun wieder voll bei Kraeften.";
}

string Report_normal(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* Du hast nun ";
  
  if(hp==maxhp)
    ret+="volle Lebenspunkte und ";
  else
    ret+=""+hp+" von "+maxhp+" Lebenspunkte und ";
  
  if(sp==maxsp)
    ret+="volle Magiepunkte.";
  else
    ret+=""+sp+" von "+maxsp+" Magiepunkte.";
  
  return ret;
}

string Report_kurz(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* ";
  
  if(hp==maxhp)
    ret+="LP: "+hp+" und ";
  else
    ret+="LP: "+hp+" von ("+maxhp+") und ";
  
  if(sp==maxsp)
    ret+="MP: "+sp;
  else
    ret+="MP: "+sp+" von ("+maxsp+")";
  
  return ret;
}

string Region(string str)
{
  if(strstr(str, "/d/ebene/Midas")==0)
    return "Midas";

  return "";
}

string Erneuern_Meldung()
{
  return BS(""C"Deine Fibel glitzert kurz auf!"N"");
}

string History_leer()
{
  return BS("In letzter Zeit war es recht ruhig...");
}

string History_msg()
{
  return "";
}

string History_format()
{
  return "rief Dir zu: ";
}

string Rufen_syntax()
{
  return BS("Was willst Du den anderen Menschen zurufen?");
}

string Rufen_format()
{
  return "ruft Dir zu: ";
}

string Rufen_msg()
{
  return "Du rufst den Menschen zu: ";
}

varargs nosave string huefe(int flag)
{
  string ret, rcmds;
  int i;
  
  rcmds="";
  
  if(IS_SEER(TP))
    {
      for(i=sizeof(soulcmds)-1;i>=0;i--)
	if(i==0)
	  rcmds+="und "+soulcmds[i][0]+".";
	else
	  rcmds+=soulcmds[i][0]+", ";
      
      rcmds=break_string(rcmds, 60, " ", BS_NO_PARINDENT);
    }
  else
    {
      for(i=sizeof(soulcmds)-1;i>=0;i--)
	if(i==0)
	  rcmds+="und "+soulcmds[i][0]+"("+soulcmds[i,2]+").";
	else
	  rcmds+=soulcmds[i][0]+"("+soulcmds[i,2]+"), ";
      
      rcmds=break_string(rcmds, 60, " ", BS_NO_PARINDENT);
    
  
      rcmds+="Die Zahlen in den Klammern sind die Magiekosten.\n \n";
      
    }
  
  ret="\n \n"
    "Die Buergerfibel kann Dir anzeigen, wie es um Deine\n"
    "Lebensenergie und Zauberkraft bestellt ist.\n \n"
    "Der Befehl dazu lautet:\n"
    " 'menreport [ein|kurz|farbe|farbekurz|aus]'\n \n"
    "Die Buergerfibel bietet Dir weiters folgende RVerben an:\n"+
    rcmds+
    "\nEinige Befehle nur fuer Menschen:\n"
    " 'menwer, meninfo, menfarbe, menpresay'\n \n"
    "RVerben nur fuer Menschen:\n"
    " 'menwinke, menknuddel'\n"
    "Hilfe zu den Befehlen erhaelst Du mit:\n"
    " 'menhilfe'\n \n"
    "                                                         Ver 1."+Version()+"\n";
  if(flag) return ret;
  
  TP->More(make_document(ret));
  return "";
}

nosave int menhilfe(string str)
{
  string ret;

  if(str) str=explode(str, " ")[0];

  switch(str)
    {
    case "menreport": 
      ret="Der Report informiert Dich, wie es um Deine "
	"Lebensenergie und Zauberkraft bestellt ist.\n"
	"Moegliche Einstellungen sind:\n"
	"* menreport normal    - Schaltet den Report normal ein.\n"
	"* menreport kurz      - Schaltet den Report kurz ein.\n"
	"* menreport farbe     - Schaltet den Report in Farbe ein.\n"
	"* menreport farbekurz - Schaltet den Report faerbig und\n"
	"                        kurz ein.\n"
	"* menreport aus       - Schaltet den Report wieder aus.\n";
      break;
    case "meninfo": 
      ret="In 'meninfo' hast Du eine eher zu Menschen passende Version\n"
	"der normalen Infoanzeige bei 'info'.\n"
	"Mit 'menfarbe' kannst Du die Anzeige sogar in wunderschoenen\n"
	"Farben darstellen lassen.\n"
	"Einige unwichtige Angaben werden im Normalfall unterdrueckt.\n";
      break;
    case "menwer": 
      ret="Mit 'menwer' siehst Du, wer aus dem Menschenvolk anwesend ist.\n"
	"*  Wer ist anwesend?\n"
	"*  Ist er/sie anwesend, oder idle?\n"
	"*  Was fuer eine Waffe hat er/sie gezueckt?\n"
	"*  Welche Gesinnung hat er/sie?\n"
	"*  Wo befindet er/sie sich?\n\n"
	"Mit 'menwer kurz' siehst Du das ganze etwas kompakter.\n";
    break;
    case "menfarben":
    case "menfarbe": 
      ret="Mit '"+str+" ein|aus' kannst Du die Farbanzeige einstellen.\n";
    break;
    case "menruf": 
    case "menrufe": 
      ret="Mit '"+str+"' hast Du die Moeglichkeit, den anderen Menschen\n"
	"etwas mitzuteilen, ohne dass andere Rassen mithoeren koennen.\n"
	"Mit 'menhist' kannst Du die Rufe nocheinmal lesen.\n";
    break;
    case "menhist": 
      ret="Mit 'menhist' kannst Du versuchen, die Echos der zuletzt\n"
	"gerufenen Meldungen zu erhaschen...\n"
	"Jedoch ist die Liste in ihrer Groesse beschraenkt.\n";
    break;
    case "menwinke":
    case "menwink": 
      ret="Mit '"+str+"' kannst Du den anderen Menschen zuwinken.\n"; 
      break;
    case "menknuddel":
    case "menknuddle":
    case "menknuddele": 
      ret="Mit '"+str+"' kannst Du die anderen Menschen alle knuddeln.\n"; 
      break;
    case "menpresay":
      ret="Mit 'menpresay' kannst Du Dir Dein Menschen-Presay, welches\n"
	"z.B. bei 'menwer' gezeigt wird, permanent als Presay setzen.\n\n"
	"Mit 'menpresay loeschen' kannst Du Dein Presay entfernen.\n";      
      break;
    case "allgemein":
      ret=huefe(1);
      break;
    case "ignoriere":
    case "ignorieren":
      ret=ignorieren_hilfe_text();
      break;
    default: 
      ret="Mit 'menhilfe' kannst Du Dich ueber Folgendes informieren:\n \n"
	"menhilfe <menreport>  Wie sieht es mit Leben u. Magie aus?\n"
	"         <meninfo>    Ein etwas anderes 'info'.\n"
	"         <menwer>     Eine Liste aller anwesenden Menschen.\n"
	"         <menfarbe>   Farbeinstellungen?\n"
	"         <menpresay>  Das Menschenpresay fix setzen.\n"
	"         <menrufe>    Den anderen Menschen etwas zurufen?\n"
	"         <menhist>    Wer hat den Menschen etwas zugerufen?\n"
	"         <menwink>    Winkt den anwesenden Menschen zu.\n"
	"         <menknuddel> Knuddelt alle anwesenden Menschen.\n"
	"         <allgemein>  Allgemeine Uebersicht.\n"
	"         <ignoriere>  Uebersicht der Ignorieremoeglichkeiten.\n";
    }
  return TP->More(make_document(ret)),1;
}

string Titel(object pl)
{
  string ret, anrede;
  
  if(!pl->QueryProp(Listener()))
    if(!present(RACETOOLID, pl))
      return "";
    else
      pl->SetProp(Listener(), 1);

  if(pl->QueryProp(P_FROG))
    return "";
  
  if(IS_WIZARD(pl))
    return "Magier"+FM(pl,"in "," ");

  if(IS_SEER(pl)) {
    anrede = (pl->QueryProp(P_GENDER)==MALE?"patriach":"matriarchin");
  }
  else {
    anrede = (pl->QueryProp(P_GENDER)==MALE?"buerger":"buergerin");
  }
  
  if(pl->QueryProp(P_GUILD)=="druidenzirkel")
    return "Druiden"+anrede+" ";
  
  if(pl->QueryProp(P_GUILD)=="zechpreller")
    return "Saeufer"+anrede+" ";
  
  if(pl->QueryProp(P_GUILD)=="berserker")
    return "Berserker"+anrede+" ";

  if(pl->QueryProp(P_GUILD)=="paladine")
    return "Paladin"+anrede+" ";

  if(pl->QueryProp(P_GUILD)=="nekromanten")
    return "Schwarzmagier"+anrede+" ";

  if(pl->QueryProp(P_GUILD)=="waldlaeufer")
    return "Hueter"+anrede+" ";

  if(pl->QueryProp(P_GUILD)=="bardengilde")
    return "Saenger"+anrede+" ";

  return capitalize(anrede)+" ";
}

nosave int menpresay(string str)
{
  string np, op;

  notify_fail(BS("Du kannst mit 'menpresay' nur das Menschen-Presay setzen!")+
	      BS("Du kannst aber auch mit 'menpresay loeschen' das Presay "
		 "loeschen."));

  if(strlen(str)) 
    if(str=="loeschen")
      {
	if(!strlen(TP->QueryProp(P_PRESAY)))
	  return write(BS("Du hattest doch gar kein Presay gesetzt!?")), 1;
	
	TP->SetProp(P_PRESAY, "");
	
	return write(BS("Dein Presay wurde geloescht.")), 1;
      }
    else
      return 0;

  
  np=Titel(TP);
  
  if(strlen(op=TP->QueryProp(P_PRESAY)))
    if(np!=op)
      write(BS("Dein voriges Presay '"+op+"' wird ersetzt."));
  
  TP->SetProp(P_PRESAY, np[0..<2]);
  
  write(BS("Du bist nun:")+
	BS(np+CAP(getuid(TP))+" "+(TP->QueryProp(P_TITLE) || "")));
  
  return 1;
}

nosave int menfarbe(string str)
{
  notify_fail(BS("Syntax: menfarbe ein|aus"));
  if(!str) return 0;
  
  if(str=="aus")
    {
      Setting(0); 
      return write(BS("Die Buergerfibel siehst Du jetzt in Schwarz/Weiss.")), 
	1;
    }

  if(str=="ein")
    {
      Setting(1); 
      return write(BS("Die Buergerfibel siehst Du jetzt in Farbe.")), 1;
    }
  
  return 0;
}

nosave int meninfo(string str)
{
  object tp;
  mapping at;
  int xp;

  tp=TP;

  if(str && IS_WIZARD(TP))
    if(!tp=find_player(str))
      return write(BS("Spieler nicht gefunden!")), 1;

  if(tp->QueryProp(P_GHOST))
    return write(BS("Geister haben keine Punkte!")), 1;
  
  at=tp->QueryProp(P_ATTRIBUTES);

  if(!xpdiff) xpdiff=tp->QueryProp(P_XP);

  xp=tp->QueryProp(P_XP);

  write(sprintf(
    " "B"+-----"N"\n"
    " "B"|"N" %35.35-s  %20s         "C":. ,.."N"\n"
    " "B"|"N"                                                                 "C".' :~.':_.,"N"\n"
    "   Leben: %s         "C".'   ::.::'.'"N"\n"
    "   Magie: %s        "C":     ::'  .:"N"\n"
    "                                                              "C"`.:    .:  .:/"N"\n"
    "   Erfahrung:        %10d %28-s  "C"`::--.:'.::'"N"\n"
    "   %28s  %s           "G"|. _"C":===-'"N"\n"
    "   Abenteuer:       %4d [%4d]  %s           "G"/ /"N"\n"
    "   Stufe: %21s                "G",---.---.    __,','"N"\n"
    "   ____________________________               "G"(~`.  \\   )   )','.,---.."N"\n"
    "                                               "G"`v`\\ | ,' .-'.:,'_____   `."N"\n"
    "   Intelligenz:         %8-s                   "G")|/.-~.--~~--.   ~~~-. \\"N"\n"
    "   Ausdauer:            %8-s %9|s      "G"__/-'_.-~        \"\"---.._`.|"N"\n"
    "   Kraft:               %8-s           "G"_.-~~_.-~                     \"\"'"N"\n"
    "   Geschicklichkeit:    %8-s    "G"_..--~~_.(~~"N"\n"
    " "B"|"N"                      "G"__...---~~~_..--~~"N"      %18|s           "B"|"N"\n"
    " "B"|"N" %16s  "G",'___...---~~~"N"      %35.35|s "B"|"N"\n"
    " "B"+-----                                                                 -----+"N"\n",
    Titel(tp)+CAP(getuid(tp)),
    CAP(tp->QueryProp(P_GUILD))+" ["+tp->QueryProp(P_GUILD_LEVEL)+"]",
    Balken(tp->QueryProp(P_HP), tp->QueryProp(P_MAX_HP), setting, 
	   tp->QueryProp(P_WIMPY),45),
    Balken(tp->QueryProp(P_SP), tp->QueryProp(P_MAX_SP), setting,0,45),
    xp, Zustand(tp), 
    (xp-xpdiff ? "Unterschied:      "+sprintf("%10d",xp-xpdiff) : ""), 
    Erschoepfung(tp),
    tp->QueryProp(P_QP), QM->QueryAllQP(), Gewicht(tp),
    Stufenpunkte(tp),
    sprintf("%2d [%2+d]", at[A_INT], tp->QueryAttributeOffset(A_INT)), 
    sprintf("%2d [%2+d]", at[A_CON], tp->QueryAttributeOffset(A_CON)), 
    Gesinnung(tp),
    sprintf("%2d [%2+d]", at[A_STR], tp->QueryAttributeOffset(A_STR)), 
    sprintf("%2d [%2+d]", at[A_DEX], tp->QueryAttributeOffset(A_DEX)),
    (tp->QueryProp(P_WIMPY) ? sprintf("Vo: %3d",tp->QueryProp(P_WIMPY)):""),
    (tp->QueryMoney() ? tp->QueryMoney()+" Muenzen" : ""),
    (tp->QueryProp(P_WIMPY) ? (tp->QueryProp(P_WIMPY_DIRECTION) ? 
			       "Ri: "+tp->QueryProp(P_WIMPY_DIRECTION):""):
     "")));

  GetColor(1);
  return 1;
}

nosave int menwink(string str)
{
  object *elfs;
  string me;
  int i;

  if(TP->QueryProp(P_INVIS)) 
    return write(BS("Das geht nur, wenn Du sichtbar bist!!")),1;
  
  elfs=Alle_Anwesenden(TP);
  
  me=Titel(TP)+CAP(getuid(TP));
  
  if(!str) str="";  
  if(str[0]=='/') 
    str=str[1..<1]+" ";
  else
    str="";
  
  for(i=sizeof(elfs)-1;i>=0;i--)
    tell_object(elfs[i], BS(me+" winkt allen Menschen "+str+"aus der Ferne zu."));
  
  write(BS("Du winkst allen Menschen "+str+"aus der Ferne zu."));

  return 1;
}

nosave int menknuddel(string str)
{
  object *elfs;
  string me;
  int i;

  if(TP->QueryProp(P_INVIS)) 
    return write(BS("Das geht nur, wenn Du sichtbar bist!!")),1;
  
  elfs=Alle_Anwesenden(TP);
  
  me=Titel(TP)+CAP(getuid(TP));

  if(!str) str="";  
  if(str[0]=='/') 
    str=str[1..<1]+" ";
  else
    str="";
  
  for(i=sizeof(elfs)-1;i>=0;i--)
    tell_object(elfs[i], BS(me+" knuddelt alle Menschen "+str+"aus der Ferne."));

  write(BS("Du knuddelst alle Menschen "+str+"aus der Ferne."));

  return 1;
}

nosave int menwer(string str)
{
  if(str && str!="kurz")
    return write(BS("menwer [kurz]")), 1;
  
  TP->More(make_document(who_list("Diese Menschen sind anwesend:\n",
				  strlen(str))));
  
  return 1;
}

string extra_look()
{
  return capitalize(environment()->QueryPronoun())+
    " traegt eine Buergerfibeln von Midas.\n";
}

void hau_ab(object who)
{
  tell_object(who, BS("Als Du die kleine Wasserperle beruehrst, zerfliesst "
		      "sie ploetzlich..."));

  call_out("remove", 0);
}
