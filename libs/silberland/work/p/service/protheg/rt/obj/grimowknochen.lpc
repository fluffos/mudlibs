#pragma strong_types;

#include "../def.h"
#include <ansi.h>
#include <exploration.h>

inherit STD "rt";

#define QM "/secure/questmaster"

#define SOULFILE SOUL "Oger"

//Somit ist moeglich "blabla"+C+"blabla"+N
#define C GetColor()
#define S(x) GetColor(x)
#define N NormalColor()

nosave int lastlogin; 

//Liefert die aktuelle Versionsnummer
int Version() { return 6;}

nomask void create()
{
  if(!is_clone(ME)) return;  // (return on BP)
  ::create();

  SetProp(P_SHORT, "Grimows Geschenk");
  SetProp(P_LONG,
	  BS("Du hast von Grimow diesen grossen, saftigen Knochen als "
	     "Geschenk bekommen. Achte auf ihn und verliere ihn nicht, dann "
	     "wird er Dir viele Dienste erweisen koennen."));
  SetProp(P_NAME, "Knochen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"geschenk", "knochen", "grimows geschenk","grimowknochen"}));

  SetProp(P_WEIGHT, 400);
  SetProp(P_MATERIAL, ([MAT_BONE:90,MAT_FLESH:8,MAT_SKIN:2]));

  SetProp(P_NOSELL,
	  "Du kannst doch nicht einfach Grimows Geschenk verkaufen!\n");

  SetProp(P_INFO,
	  "Mjam, ein Knochen! Aber Du solltest ihn lieber nicht essen, "
	  "denn er kann Dir viele Dienste erweisen.");

  AddDetail("dienste", CLOSURE(huefe));
  
  AddDetail(({"grimow"}),
	    QueryProp(P_LONG));
  
  AddCmd("grreport", "Report");
  
  //Cmds fuer die Komunikation
  AddCmd(({"grgrunze","grgrunz"}), "Rufen");
  AddCmd(({"grhist"}), "History");
  AddCmd(({"grwink","grwinke"}), "grwink");
  
  AddCmd(({"grinfo"}), "grinfo");
  AddCmd(({"grwer"}), "grwer");
  AddCmd(({"grfarbe","grfarben"}), "grfarbe");

  AddCmd(({"grpresay"}), "grpresay");

  //Hilfeanzeige
  AddCmd(({"grhilfe"}), "grhilfe");
  
  AddCmd(({"knabber","knabbere","beiss","beisse"}), "cmd_knabbern");
  AddCmd(({"schleck","schlecke"}), "cmd_schlecken");
  AddCmd(({"sabber","sabbere"}), "cmd_sabbern");
  
  GetColor(1);
  
  SUID;

  // r* commands:
  init_soul_cmds(1);
}

nosave int cmd_knabbern(string str)
{
  if(!str) return 0;
  if(!id(str)) return 0;
  
  write(BS("Du knabbern etwas an grosse Knochen von Grimow!"));
  tell_room(ENV(TP), BS(TPN+" knabbert an einem grossen Knochen herum."), 
	    ({TP}));
  return 1;
}

nosave int cmd_schlecken(string str)
{
  if(!str) return 0;
  if(!id(str)) return 0;
  
  write(BS("Du schlecken grosses Knochen von Grimow ab! Mjam!"));
  tell_room(ENV(TP), BS(TPN+" schleckt an einem grossen Knochen herum."), 
	    ({TP}));
  return 1;
}

nosave int cmd_sabbern(string str)
{
  if(!str) return 0;
  if(!id(str)) return 0;
  
  write(BS("Du sabbern an grosse, leckere Knochen von Grimow!"));
  tell_room(ENV(TP), BS(TPN+" sabbert an einem grossen Knochen herum."), 
	    ({TP}));
  return 1;
}

//Liefert den Filename zum Masterobjekt
