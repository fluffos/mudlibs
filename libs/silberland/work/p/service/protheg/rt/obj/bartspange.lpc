#pragma strong_types;

#include "../def.h"
#include <ansi.h>
#include <exploration.h>

inherit STD "rt";

#define QM "/secure/questmaster"

#define C +GetColor()+
#define W +GetColor(ANSI_BOLD+ANSI_WHITE)+
#define R +GetColor(ANSI_BOLD+ANSI_RED)+
#define B +GetColor(ANSI_YELLOW)+
#define N +NormalColor()+

varargs nosave string huefe();
nosave int haar;

int Version() { return 4;}

nomask void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Eine goldene Bartspange");
  SetProp(P_LONG,
	  BS("Eine goldene Bartspange haengt da in dem Bart. Ihr Funkeln "
	     "erkennt man schon von weitem. Sie gehoert Dir, "
	     "nur Dir allein! Nur Dir wird "
	     "sie Glueck bringen! Achte gut darauf!"));

  SetProp(P_NAME, "Spange");
  SetProp(P_GENDER, FEMALE);
  AddAdjective(({"goldene","goldenen"}));
  SetProp(P_NAME_ADJ, "golden");

  AddId(({"spange","haarspange","bartspange","goldspange"}));
  
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1500);
  SetProp(P_MATERIAL, ([MAT_GOLD:100]));
  SetProp(P_MAGIC, 1);
  SetProp(P_NODROP, "Du willst die Spange bestimmt nicht loswerden!!\n");
  
  SetProp(P_ARTICLE, 1);
  
  SetProp(P_NOSELL,
	  "Beim Haendler wuerde sie nur in einer Kiste verstauben!!\n");
  
  SetProp(P_INFO,
	  BS("Kein wahrer Zwerg traegt einen Teddy mit sich herum! Im "
	     "Gegenteil! Er koennte dis Spange sogar stoeren."));
  
  AddDetail(({"funkeln","gold"}), CLOSURE(huefe));
  
  AddCmd("zwereport", "Report");
  
  //Cmds fuer die Zwergenkomunikation
  AddCmd(({"zweruf","zwerufe"}), "Rufen");
  AddCmd(({"zwehist","zwehistory"}), "History");
  AddCmd(({"zwewink","zwewinke"}), "zwewink");
  AddCmd(({"zweknuddel","zweknuddle","zweknuddele"}), "zweknuddel");
  
  AddCmd(({"zweinfo"}), "zweinfo");
  AddCmd(({"zwewer"}), "zwewer");
  AddCmd(({"zwefarbe","zwefarben"}), "zwefarbe");
  
  AddCmd(({"zwehaar"}), "zwehaar");
  
  AddCmd(({"zwepresay"}), "zwepresay");

  AddCmd(({"zwehilfe"}), "zwehilfe");
  
  GetColor(1);
  
  SUID;
  
  // r* commands:
  init_soul_cmds(1);
}

string info()
{
  if((MENV) && (query_once_interactive(MENV)))
    if(present("universal-teddy", MENV))
      return BS("Kein wahrer Zwerg traegt einen Teddy mit sich herum! Im "
		"Gegenteil! Er koennte die Spange sogar stoeren.");
  return BS("Die Spange funkelt wunderbar!");
}

string Master()
{
  return RTM "zwergenmaster";
}

string Rasse()
{
  return "Zwerg";
}

string IgnoriereID()
{
  return "bartspange";
}

string absolut_fit()
{
  return "Du bist nun wieder absolut fit.";
}

string Report_normal(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* Du hast nun ";
  
  if(hp==maxhp)
    ret+="volle Lebenspunkte und ";
  else
    ret+=""+hp+" von "+maxhp+" Lebenspunkten und ";
  
  if(sp==maxsp)
    ret+="volle Magiepunkte.";
  else
    ret+=""+sp+" von "+maxsp+" Magiepunkten.";
  
  return ret;
}

string Report_kurz(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* ";
  
  if(hp==maxhp)
    ret+="LP: "+hp+" und ";
  else
    ret+="LP: "+hp+" von ("+maxhp+") und ";
  
  if(sp==maxsp)
    ret+="MP: "+sp;
  else
    ret+="MP: "+sp+" von ("+maxsp+")";
  
  return ret;
}

string Region(string str)
{
  if(strstr(str, "/d/gebirge/dusty/hoch")==0)
    return "Felonia";

  if(strstr(str, "/d/gebirge/dusty/zwerge")==0)
    return "Felonia";

  if(strstr(str, "/d/gebirge/angrox/room")==0)
    return "Bergwerk";

  return "";
}

string Erneuern_Meldung()
{
  return BS(""C"Deine Spange funkelt kurz auf!"N"");
}

string History_leer()
{
  return BS("In letzter Zeit war es recht ruhig...");
}

string History_msg()
{
  return "";
}

string History_format()
{
  return "rief: ";
}

string Rufen_syntax()
{
  return BS("Was willst Du den anderen Zwergen zurufen?");
}

string Rufen_format()
{
  return "ruft den Zwergen zu: ";
}

string Rufen_msg()
{
  return "Du rufst den Zwergen zu: ";
}

varargs nosave string huefe(int flag)
{
  string ret, rcmds;
  int i;
  
  rcmds="";
  
  if(IS_SEER(TP))
    {
      for(i=sizeof(soulcmds)-1;i>=0;i--)
	if(i==0)
	  rcmds+="und "+soulcmds[i][0]+".";
	else
	  rcmds+=soulcmds[i][0]+", ";
      
      rcmds=break_string(rcmds, 60, " ", BS_NO_PARINDENT);
    }
  else
    {
      for(i=sizeof(soulcmds)-1;i>=0;i--)
	if(i==0)
	  rcmds+="und "+soulcmds[i][0]+"("+soulcmds[i,2]+").";
	else
	  rcmds+=soulcmds[i][0]+"("+soulcmds[i,2]+"), ";
      
      rcmds=break_string(rcmds, 60, " ", BS_NO_PARINDENT);
    
  
      rcmds+="Die Zahlen in den Klammern sind die Magiekosten.\n \n";
      
    }
  
  ret="\n \n"
    "Die Spange kann Dir anzeigen, wie es um Deine\n"
    "Lebensenergie und Zauberkraft bestellt ist.\n \n"
    "Der Befehl dazu lautet:\n"
    " 'zwereport [ein|kurz|farbe|farbekurz|aus]'\n \n"
    "Die Spange bietet Dir weiters folgende RVerben an:\n"+
    rcmds+
    "\nEinige Befehle nur fuer Zwerge:\n"
    " 'zwewer, zweinfo, zwefarbe, zwepresay'\n \n"
    "RVerben nur fuer Zwerge:\n"
    " 'zwewinke, zweknuddel'\n"
    "Hilfe zu den Befehlen erhaelst Du mit:\n"
    " 'zwehilfe'\n \n"
    "                                                         Ver 1."+Version()+"\n";
  
  if(flag) return ret;
  
  TP->More(make_document(ret));
  return "";
}

nosave int zwehilfe(string str)
{
  string ret;

  if(str) str=explode(str, " ")[0];

  switch(str)
    {
    case "zwereport": 
      ret="Der 'zwereport' informiert Dich, wie es um Deine\n"
	"Lebensenergie und Zauberkraft bestellt ist.\n"
	"Moegliche Einstellungen sind:\n"
	"* zwereport normal    - Schaltet den Report normal ein.\n"
	"* zwereport kurz      - Schaltet den Report kurz ein.\n"
	"* zwereport farbe     - Schaltet den Report in Farbe ein.\n"
	"* zwereport farbekurz - Schaltet den Report faerbig und\n"
	"                        kurz ein.\n"
	"* zwereport aus       - Schaltet den Report wieder aus.\n";
      break;
    case "zweinfo": 
      ret="In 'zweinfo' hast Du eine eher zu Zwergen passende Version\n"
	"der normalen Infoanzeige bei 'info'.\n"
	"Mit 'zwefarbe' kannst Du die Anzeige sogar in wunderschoenen\n"
	"Farben darstellen lassen.\n"
	"Einige unwichtige Angaben werden im Normalfall unterdrueckt.\n";
      break;
    case "zwewer": 
      ret="Mit 'zwewer' siehst Du, wer aus dem Zwergenvolk anwesend ist.\n"
	"*  Wer ist anwesend?\n"
	"*  Ist er/sie anwesend, oder idle?\n"
	"*  Was fuer eine Waffe hat er/sie gezueckt?\n"
	"*  Welche Gesinnung hat er/sie?\n"
	"*  Wo befindet er/sie sich?\n\n"
	"Mit 'zwewer kurz' siehst Du das ganze etwas kompakter.\n";
    break;
    case "zwefarben":
    case "zwefarbe": 
      ret="Mit '"+str+" ein|aus' kannst Du die Farbanzeige einstellen.\n";
    break;
    case "zweruf":
    case "zwerufe":
      ret="Mit '"+str+"' hast Du die Moeglichkeit, den anderen Zwergen\n"
	"etwas mitzuteilen, ohne dass andere Rassen mithoeren koennen.\n"
	"Mit 'zwehist' kannst Du die Rufe nocheinmal lesen.\n";
    break;
    case "zwehist": 
      ret="Mit 'zwehist' kannst Du versuchen, die Echos der zuletzt\n"
	"gerufenen Meldungen zu erhaschen...\n"
	"Jedoch ist die Liste in ihrer Groesse beschraenkt.\n";
    break;
    case "zwewinke":
    case "zwewink": 
      ret="Mit '"+str+"' kannst Du den anderen Zwergen zuwinken.\n"; 
      break;
    case "zweknuddel":
    case "zweknuddle":
    case "zweknuddele": 
      ret="Mit '"+str+"' kannst Du die anderen Zwerge alle knuddeln.\n"; 
      break;
    case "zwehaar":
      ret="Mit 'zwehaar' kannst Du bestimmen ob Du die Spange als\n"
	"Haarspange tragen willst, oder nicht.\n";
      break;
    case "zwepresay":
      ret="Mit 'zwepresay' kannst Du Dir Dein Zwergen-Presay, welches\n"
	"z.B. bei 'zwewer' gezeigt wird, permanent als Presay setzen.\n\n"
	"Mit 'zwepresay loeschen' kannst Du Dein Presay wieder entfernen.\n";
      break;
    case "allgemein":
      ret=huefe(1);
      break;
    case "ignoriere":
    case "ignorieren":
      ret=ignorieren_hilfe_text();
      break;
    default: 
      ret="Mit 'zwehilfe' kannst Du Dich ueber Folgendes informieren:\n \n"
	"zwehilfe <zwereport>  Wie sieht es mit Leben u. Magie aus?\n"
	"         <zweinfo>    Ein etwas anderes 'info'.\n"
	"         <zwewer>     Eine Liste aller anwesenden Zwerge.\n"
	"         <zwefarbe>   Farbeinstellungen?\n"
	"         <zwepresay>  Das Zwergenpresay fix setzen.\n"
	"         <zwerufe>    Den anderen Zwergen etwas zurufen?\n"
	"         <zwehist>    Wer hat den Zwergen etwas zugerufen?\n"
	"         <zwewink>    Winkt den anwesenden Zwergen zu.\n"
	"         <zweknuddel> Knuddelt alle anwesenden Zwerge.\n"
	"         <zwehaar>    Die Spange lieber im Haar?\n"
	"         <allgemein>  Allgemeine Uebersicht.\n"
	"         <ignoriere>  Uebersicht der Ignorieremoeglichkeiten.\n";
    }
  return TP->More(make_document(ret)),1;
}

string Titel(object pl)
{
  string ret;

  // Jaja muss sein ;)
  if(getuid(pl)=="protheg")
    return "Drowmagier ";
  
  if(!pl->QueryProp(Listener()))
    if(!present(RACETOOLID, pl))
      return "";
    else
      pl->SetProp(Listener(), 1);
  
  if(pl->QueryProp(P_FROG))
    return "";
  
  if(IS_WIZARD(pl))
    return "Zwergenmagier"+FM(pl,"in "," ");

  if(IS_SEER(pl))
    ret="Zwerg";
  else
    ret="Jungzwerg";
  
  if(pl->QueryProp(P_GUILD)=="druidenzirkel")
    return ret+"endruid"+FM(pl,"in ","e ");
  
  if(pl->QueryProp(P_GUILD)=="zechpreller")
    return ret+"ensaeufer"+FM(pl,"in "," ");
  
  if(pl->QueryProp(P_GUILD)=="paladine")
    return ret+"enpaladin ";

  if(pl->QueryProp(P_GUILD)=="berserker")
    return ret+"enberserker"+FM(pl,"in "," ");
  
  if(pl->QueryProp(P_GUILD)=="nekromanten")
    return ret+"ennekromant"+FM(pl,"in "," ");
  
  return ret+FM(pl,"in "," ");
}

nosave int zwehaar(string str)
{
  notify_fail(BS("Einfach nur 'zwehaar'."));
  if(str) return 0;
  
  if(haar)
    {
      haar=0;

      SetProp(P_SHORT, "Eine goldene Bartspange");
      
      SetProp(P_LONG,
	      BS("Eine goldene Spange haengt da in dem Bart. Ihr Funkeln "
		 "erkennt man schon von weitem. Sie gehoert Dir, "
		 "nur Dir allein! Nur Dir wird "
		 "sie Glueck bringen! Achte gut darauf!"));
      
      write(BS("Du traegst die Spange nun wieder als Bartspange."));
      
      return 1;
    }
  SetProp(P_SHORT, "Eine goldene Haarspange");
  SetProp(P_LONG,
	  BS("Eine goldene Spange haengt da in Deinem Haar. Ihr Funkeln "
	     "erkennt man schon von weitem. Sie gehoert Dir, "
	     "nur Dir allein! Nur Dir wird sie Glueck bringen! Achte gut "
	     "darauf!"));
  
  write(BS("Du traegst die Spange nun in deinen Haaren."));
  
  haar=1;
  
  return 1;
}

nosave int zwepresay(string str)
{
  string np, op;

  notify_fail(BS("Du kannst mit 'zwepresay' nur das Zwergen-Presay setzen!")+
	      BS("Du kannst aber auch mit 'zwepresay loeschen' das Presay "
		 "loeschen."));

  if(strlen(str)) 
    if(str=="loeschen")
      {
	if(!strlen(TP->QueryProp(P_PRESAY)))
	  return write(BS("Du hattest doch gar kein Presay gesetzt!?")), 1;
	
	TP->SetProp(P_PRESAY, "");
	
	return write(BS("Dein Presay wurde geloescht.")), 1;
      }
    else
      return 0;

  
  np=Titel(TP);
  
  if(strlen(op=TP->QueryProp(P_PRESAY)))
    if(np!=op)
      write(BS("Dein voriges Presay '"+op+"' wird ersetzt."));
  
  TP->SetProp(P_PRESAY, np[0..<2]);
  
  write(BS("Du bist nun:")+
	BS(np+CAP(getuid(TP))+" "+(TP->QueryProp(P_TITLE) || "")));
  
  return 1;
}

nosave int zwefarbe(string str)
{
  notify_fail(BS("Syntax: zwefarbe ein|aus"));
  if(!str) return 0;
  
  if(str=="aus")
    {
      Setting(0); 
      return write(BS("Die Meldungen der Spange siehst Du jetzt in "
		      "Schwarz/Weiss.")), 1;
    }

  if(str=="ein")
    {
      if(TP->QueryProp(P_TTY)!="ansi")
	return write(BS("Du hast noch nicht 'stty ansi' gemacht!")), 1;

      Setting(1); 
      return write(BS("Die Meldungen der Spange siehst Du jetzt in "
		      "Farbe.")), 1;
    }
  
  return 0;
}

nosave int zweinfo(string str)
{
  object tp;
  mapping at;
  int xp;

  tp=TP;

  if(str && IS_WIZARD(TP))
    if(!tp=find_player(str))
      return write(BS("Spieler nicht gefunden!")), 1;

  if(tp->QueryProp(P_GHOST))
    return write(BS("Geister haben keine Punkte!")), 1;
  
  at=tp->QueryProp(P_ATTRIBUTES);

  if(!xpdiff) xpdiff=tp->QueryProp(P_XP);

  xp=tp->QueryProp(P_XP);

  write(sprintf(
" %48.48|s        "C"___I___"N"\n"
"                                                        "C"/=  |  #\\"N"\n"
" Leben: %s       "C"/.__-| __ \\"N"\n"
" Magie: %s       "C"|/"N" _"C"\\_/"N"_ "C"\\|"N"\n"
"                                                       "B"(( __ "N"\\"B"__))"N"\n"
" Erfahrung:        %10d   %16s    "C"__ "B"((()))))())"C" __"N"\n"
" %28s   %16s  "C",'  |"B"()))))(((()"C"|# `."N"\n"
" Abenteuer:       %4d [%4d]                    "C"/    |"W"^"N""B"))()))))("W"^"N""C"|   =\\"N"\n"
" Stufe: %21s                   "C"/    /"W"^v^"N""B"(())()()"W"v^"N""C"\\'  .\\"N"\n"
"                                               "C" |__.'"W"^v^v^"N""B"))))))"W"^v^v"N""C"`.__|"N"\n"
" Kraft:               %8-s                 /_ ' "W"\\______"N""B"(()"W"_____("N"   |\n"
" Ausdauer:            %8-s            _..-'   _/"W"/_____["N""C"xxx"W"]_____\\"N".-|\n"
" Geschick:            %8-s           /,"W"_"N"#\\.=-' "W"/v^v^v^v^v^v^v^v^"N"| _|\n"
" Intelligenz:         %8-s           \\)"W"|"N")      "W"v^v^v^v^v^v^v^v^v"N"| _|\n"
"                                          "W"||"N"       "W":v^v^v^v^v^v`"N".-' |#  \\,\n"
" %38.38-s   "W"||"N"       "W"v^v^v^v`"N"_/\\__,--.|\\_=_/\n"
" %18-s                       "B"><"N"       "W":v^v"N"____|  \\_____|"B"_"N"\n"
" %24.24-s              "W",  ||"N"       "W"v^"N""B"      /  \\       /"N"\n"
" %-s                 "W"//\\_||_)\\"N"    "B"`/_..-._\\   )_...__\\"N"\n"
" %-s                "W"||   \\/  "R"#"N"|"N"     "B"|_='_(     |  =_(_"N"\n"
"                                     "W"||  _/\\_  |"N"    "B"/     =\\    /  '  =\\"N"\n"
"                                      "W"\\\\/ \\/ )/"N" gnv "B"|=____#|    '=....#|"N"\n",
Titel(tp)+CAP(getuid(tp))+" "+CAP(tp->QueryProp(P_GUILD))+" ["+tp->QueryProp(P_GUILD_LEVEL)+"]",
Balken(tp->QueryProp(P_HP), tp->QueryProp(P_MAX_HP), setting, 
       tp->QueryProp(P_WIMPY),40),
Balken(tp->QueryProp(P_SP), tp->QueryProp(P_MAX_SP), setting,0,40),
xp, (tp->QueryMoney() ? tp->QueryMoney()+" Muenzen" : ""),
(xp-xpdiff ? "Unterschied:      "+sprintf("%10d",xp-xpdiff) : ""),
Gesinnung(tp), 

tp->QueryProp(P_QP), QM->QueryAllQP(), Stufenpunkte(tp),
sprintf("%2d [%2+d]", at[A_STR], tp->QueryAttributeOffset(A_STR)), 
sprintf("%2d [%2+d]", at[A_CON], tp->QueryAttributeOffset(A_CON)), 
sprintf("%2d [%2+d]", at[A_DEX], tp->QueryAttributeOffset(A_DEX)),
sprintf("%2d [%2+d]", at[A_INT], tp->QueryAttributeOffset(A_INT)),
(tp->QueryProp(P_WIMPY) ? (tp->QueryProp(P_WIMPY_DIRECTION) ? 
			   "Flucht: "+tp->QueryProp(P_WIMPY_DIRECTION):""):""),
(tp->QueryProp(P_WIMPY) ? sprintf("Vorsicht: %3d",tp->QueryProp(P_WIMPY)):""),

Zustand(tp, 1)[1..], Erschoepfung(tp), Gewicht(tp)));
  
  GetColor(1);
  return 1;
}

nosave int zwewink(string str)
{
  object *zwerge;
  string me;
  int i;

  if(TP->QueryProp(P_INVIS)) 
    return write(BS("Das geht nur, wenn Du sichtbar bist!!")),1;
  
  zwerge=Alle_Anwesenden(TP);
  
  me=Titel(TP)+CAP(getuid(TP));
  
  if(!str) str="";  
  if(str[0]=='/') 
    str=str[1..<1]+" ";
  else
    str="";
  
  for(i=sizeof(zwerge)-1;i>=0;i--)
    tell_object(zwerge[i], BS(me+" winkt allen Zwergen "+str+"aus der Ferne zu."));
  
  write(BS("Du winkst allen Zwergen "+str+"aus der Ferne zu."));

  return 1;
}

nosave int zweknuddel(string str)
{
  object *zwerge;
  string me;
  int i;

  if(TP->QueryProp(P_INVIS)) 
    return write(BS("Das geht nur, wenn Du sichtbar bist!!")),1;
  
  zwerge=Alle_Anwesenden(TP);
  
  me=Titel(TP)+CAP(getuid(TP));

  if(!str) str="";  
  if(str[0]=='/') 
    str=str[1..<1]+" ";
  else
    str="";
  
  for(i=sizeof(zwerge)-1;i>=0;i--)
    tell_object(zwerge[i], BS(me+" knuddelt alle Zwerge "+str+"aus der Ferne."));
  
  write(BS("Du knuddelst alle Zwerge "+str+"aus der Ferne."));
  
  return 1;
}

nosave int zwewer(string str)
{
  if(str && str!="kurz")
    return write(BS("Syntax: 'zwewer [kurz]'")), 1;
  
  TP->More(make_document(who_list("Diese Zwerge sind anwesend:\n",
				  strlen(str))));
  
  return 1;
}

string extra_look()
{
  if(haar)
    return CAP(MENV->QueryPronoun())+
      " traegt eine funkelnde Spange im Haar.\n";
  else
    return CAP(MENV->QueryPronoun())+
      " traegt eine funkelnde Spange im Bart.\n";
}

void hau_ab(object who)
{
  tell_object(who, BS("Als Du die goldene Spange nimmst, reisst sie Dir "
		      "ploetzlich ein vorbeirennender Zwerg weg..."));
  
  RemoveCmd(0);
  
  call_out("remove", 0);
}

