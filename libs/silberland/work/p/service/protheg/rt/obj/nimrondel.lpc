#pragma strong_types;

#include "../def.h"
#include <ansi.h>
#include <exploration.h>

inherit STD "rt";

#define ELESSARMASTER "/d/kristallwald/sargola/dorf/npc/wmaster"
#define QM "/secure/questmaster"

#define C +GetColor()+
#define G +GetColor(ANSI_GREEN)+
#define B +GetColor(ANSI_YELLOW)+
#define N +NormalColor()+

varargs nosave string huefe(int flag);

int Version() { return 33;}

nomask void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Nimrondels Traene");
  SetProp(P_LONG,
	  BS("Nimrondels Traene ist eine kleine Perle aus purem Wasser, "
	     "welche durch die magische Beruehrung eines Elfen zu einem "
	     "festen Edelstein erstarrt ist."));

  SetProp(P_NAME, ({"Nimrondels Traene","Nimrondels Traene",
		      "Nimrondels Traene","Nimrondels Traene"}));
  SetProp(P_GENDER, FEMALE);

  AddId(({"traene", "nimrondeltraene","nimrondels traene","nimrondelstraene"
	      }));
  
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL, ([MAT_WATER:90,MAT_MAGIC:10]));
  SetProp(P_NODROP, "Nicht doch! Die Traene koennte zerfliessen...\n");

  SetProp(P_ARTICLE, 0);

  SetProp(P_NOSELL,
	  "Der Haendler wuerde den wahren Wert dieser Wasserperle nicht "
	  "erkennen!\n");

  SetProp(P_INFO,
	  BS("Kein wahrer Elf traegt einen Teddy mit sich herum! Im "
	     "Gegenteil! Er koennte die Traene sogar stoeren."));
  
  AddDetail(({"perle","wasserperle","beruehrung"}),
	    "Durch die magische Beruehrung eines Elfen ist das Wasser zu "
	    "einer Perle geworden.");
  
  AddDetail(({"edelstein"}),
	    "Nimrondels Traene ist wohl der kostbarste Edelstein, den es im "
	    "Kristallwald zu finden gibt.");

  AddDetail("wasser", CLOSURE(huefe));
  
  AddCmd("nimreport", "Report");
  
  //Cmds fuer die Elfenkomunikation
  AddCmd(({"nimruf","nimrufe"}), "Rufen");
  AddCmd(({"nimhist","nimhistory"}), "History");
  AddCmd(({"nimwink","nimwinke"}), "nimwink");
  AddCmd(({"nimknuddel","nimknuddle","nimknuddele"}), "nimknuddel");

  AddCmd(({"niminfo"}), "niminfo");
  AddCmd(({"nimwer"}), "nimwer");
  AddCmd(({"nimfeind","nimfeinde"}), "nimfeinde");
  AddCmd(({"nimfarbe","nimfarben"}), "nimfarbe");

  AddCmd(({"nimpresay"}), "nimpresay");

  AddCmd(({"nimhilfe"}), "nimhilfe");

  GetColor(1);
  
  SUID;
  
  // r* commands:
  init_soul_cmds(1);
}

string info()
{
  if((MENV) && (query_once_interactive(MENV)))
    if(present("universal-teddy", MENV))
      return BS("Kein wahrer Elf traegt einen Teddy mit sich herum! Im "
		"Gegenteil! Er koennte die Traene sogar stoeren.");
  return BS("Das Wasser der Traene glitzert geheimnisvoll.");
}

string Master()
{
  return RTM "traenenmaster";
}

string Rasse()
{
  return "Elf";
}

string IgnoriereID()
{
  return "traene";
}

string absolut_fit()
{
  return "Du bist nun wieder absolut fit.";
}

string Report_normal(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* Du hast nun ";
  
  if(hp==maxhp)
    ret+="volle Lebenspunkte und ";
  else
    ret+=""+hp+" von "+maxhp+" Lebenspunkte und ";
  
  if(sp==maxsp)
    ret+="volle Magiepunkte.";
  else
    ret+=""+sp+" von "+maxsp+" Magiepunkte.";
  
  return ret;
}

string Report_kurz(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* ";
  
  if(hp==maxhp)
    ret+="LP: "+hp+" und ";
  else
    ret+="LP: "+hp+" von ("+maxhp+") und ";
  
  if(sp==maxsp)
    ret+="MP: "+sp;
  else
    ret+="MP: "+sp+" von ("+maxsp+")";
  
  return ret;
}

string Region(string str)
{
  if(strstr(str, "/d/kristallwald/sargola/dorf")==0)
    return "Elessar";

  if(strstr(str, "/d/kristallwald/protheg/elessar")==0)
    return "Elessar";

  if(strstr(str, "/d/dschungel/feyaria/dorf")==0)
    return "Dschungelelfen";
  
  return "";
}

string Erneuern_Meldung()
{
  return BS(""C"Deine Traene wabbelt etwas und leuchtet kurz auf!"N"");
}

string History_leer()
{
  return BS("In letzter Zeit war es recht ruhig...");
}

string History_msg()
{
  return "";
}

string History_format()
{
  return "rief Dir zu: ";
}

string Rufen_syntax()
{
  return BS("Was willst Du den anderen Elfen zurufen?");
}

string Rufen_format()
{
  return "ruft Dir zu: ";
}

string Rufen_msg()
{
  return "Du rufst den Elfen zu: ";
}

varargs nosave string huefe(int flag)
{
  string ret, rcmds;
  int i;
  
  rcmds="";
  
  if(IS_SEER(TP))
    {
      for(i=sizeof(soulcmds)-1;i>=0;i--)
	if(i==0)
	  rcmds+="und "+soulcmds[i][0]+".";
	else
	  rcmds+=soulcmds[i][0]+", ";
      
      rcmds=break_string(rcmds, 60, " ", BS_NO_PARINDENT);
    }
  else
    {
      for(i=sizeof(soulcmds)-1;i>=0;i--)
	if(i==0)
	  rcmds+="und "+soulcmds[i][0]+"("+soulcmds[i,2]+").";
	else
	  rcmds+=soulcmds[i][0]+"("+soulcmds[i,2]+"), ";
      
      rcmds=break_string(rcmds, 60, " ", BS_NO_PARINDENT);
    
  
      rcmds+="Die Zahlen in den Klammern sind die Magiekosten.\n \n";
      
    }
  
  ret="\n \n"
    "Nimrondels Traene kann Dir anzeigen, wie es um Deine\n"
    "Lebensenergie und Zauberkraft bestellt ist.\n \n"
    "Der Befehl dazu lautet:\n"
    " 'nimreport [ein|kurz|farbe|farbekurz|aus]'\n \n"
    "Nimrondels Traene bietet Dir weiters folgende RVerben an:\n"+
    rcmds+
    "\nEinige Befehle nur fuer Elfen:\n"
    " 'nimwer, nimfeinde, niminfo, nimfarbe, nimpresay'\n \n"
    "RVerben nur fuer Elfen:\n"
    " 'nimwinke, nimknuddel'\n"
    "Hilfe zu den Befehlen erhaelst Du mit:\n"
    " 'nimhilfe'\n \n"
    "                                                         Ver 1."+Version()+"\n";
  if(flag) return ret;
  
  TP->More(make_document(ret));
  return "";
}

nosave int nimhilfe(string str)
{
  string ret;

  if(str) str=explode(str, " ")[0];

  switch(str)
    {
    case "nimreport": 
      ret="Der 'nimreport' informiert Dich, wie es um Deine "
	"Lebensenergie und Zauberkraft bestellt ist.\n"
	"Moegliche Einstellungen sind:\n"
	"* nimreport normal    - Schaltet den Report normal ein.\n"
	"* nimreport kurz      - Schaltet den Report kurz ein.\n"
	"* nimreport farbe     - Schaltet den Report in Farbe ein.\n"
	"* nimreport farbekurz - Schaltet den Report faerbig und\n"
	"                        kurz ein.\n"
	"* nimreport aus       - Schaltet den Report wieder aus.\n";
      break;
    case "niminfo": 
      ret="In 'niminfo' hast Du eine eher zu Elfen passende Version\n"
	"der normalen Infoanzeige bei 'info'.\n"
	"Mit 'nimfarbe' kannst Du die Anzeige sogar in wunderschoenen\n"
	"Farben darstellen lassen.\n"
	"Einige unwichtige Angaben werden im Normalfall unterdrueckt.\n";
      break;
    case "nimwer": 
      ret="Mit 'nimwer' siehst Du, wer aus dem Elfenvolk anwesend ist.\n"
	"*  Wer ist anwesend?\n"
	"*  Ist er/sie anwesend, oder idle?\n"
	"*  Was fuer eine Waffe hat er/sie gezueckt?\n"
	"*  Welche Gesinnung hat er/sie?\n"
	"*  Wo befindet er/sie sich?\n\n"
	"Mit 'nimwer kurz' siehst Du das ganze etwas kompakter.\n";
    break;
    case "nimfarben":
    case "nimfarbe": 
      ret="Mit '"+str+" ein|aus' kannst Du die Farbanzeige einstellen.\n";
    break;
    case "nimruf": 
    case "nimrufe": 
      ret="Mit '"+str+"' hast Du die Moeglichkeit, den anderen Elfen\n"
	"etwas mitzuteilen, ohne dass andere Rassen mithoeren koennen.\n"
	"Mit 'nimhist' kannst Du die Rufe nocheinmal lesen.\n";
    break;
    case "nimhist": 
      ret="Mit 'nimhist' kannst Du versuchen, die Echos der zuletzt\n"
	"gerufenen Meldungen zu erhaschen...\n"
	"Jedoch ist die Liste in ihrer Groesse beschraenkt.\n";
    break;
    case "nimwinke":
    case "nimwink": 
      ret="Mit '"+str+"' kannst Du den anderen Elfen zuwinken.\n"; 
      break;
    case "nimknuddel":
    case "nimknuddle":
    case "nimknuddele": 
      ret="Mit '"+str+"' kannst Du die anderen Elfen alle knuddeln.\n"; 
      break;
    case "nimfeind":
    case "nimfeinde":
      ret="Mit '"+str+"' siehst Du die derzeitigen Feinde von Elessar.\n"+
	(IS_SEER(TP) ? 
	 "Mit '"+str+" <name>' siehst Du die Frevel, die <name> bereits\n"
	 "an Elessar begangen hat.\n":"");
      break;
    case "nimpresay":
      ret="Mit 'nimpresay' kannst Du Dir Dein Elfen-Presay, welches\n"
	"z.B. bei 'nimwer' gezeigt wird, permanent als Presay setzen.\n\n"
	"Mit 'nimpresay loeschen' kannst Du Dein Presay entfernen.\n";      
      break;
    case "allgemein":
      ret=huefe(1);
      break;
    case "ignoriere":
    case "ignorieren":
      ret=ignorieren_hilfe_text();
      break;
    default: 
      ret="Mit 'nimhilfe' kannst Du Dich ueber Folgendes informieren:\n \n"
	"nimhilfe <nimreport>  Wie sieht es mit Leben u. Magie aus?\n"
	"         <niminfo>    Ein etwas anderes 'info'.\n"
	"         <nimwer>     Eine Liste aller anwesenden Elfen.\n"
	"         <nimfarbe>   Farbeinstellungen?\n"
	"         <nimpresay>  Das Elfenpresay fix setzen.\n"
	"         <nimrufe>    Den anderen Elfen etwas zurufen?\n"
	"         <nimhist>    Wer hat den Elfen etwas zugerufen?\n"
	"         <nimfeinde>  Die Feinde von Elessar!\n"
	"         <nimwink>    Winkt den anwesenden Elfen zu.\n"
	"         <nimknuddel> Knuddelt alle anwesenden Elfen.\n"
	"         <allgemein>  Allgemeine Uebersicht.\n"
	"         <ignoriere>  Uebersicht der Ignorieremoeglichkeiten.\n";
    }
  return TP->More(make_document(ret)),1;
}

nosave int nimfeinde(string str)
{
  int i,z;
  string ret;
  object *feinde;
  string *f;
    
  catch(call_other(ELESSARMASTER, "???"));
	
  if((!str) || (!IS_SEER(TP)))
    {
      if(!sizeof(feinde=ELESSARMASTER->getfeinde()))
	return write(BS("In Elessar herrscht zur Zeit Frieden.")), 1;
      
      ret="";
      f=({});

      for(i=sizeof(feinde)-1;i>=0;i--)
	if(objectp(feinde[i]))
	  f+=({CAP(getuid(feinde[i]))});
      
      f=sort_array(f, CLOSURE(>));
      
      if(sizeof(f)==1)
	ret+=BS(" "+f[0]+".");
      else
	{
	  ret+=(implode(f[0..<2], ", "));
	  
	  ret+=" und "+f[<1]+".";
	  ret=break_string(ret, 40, "* ",BS_LEAVE_MY_LFS|BS_NO_PARINDENT);
	}
      ret="Die aktuellen Feinde von Elessar:\n"+ret;
    }
  else 
    {
      if(!find_player(str))
	return write(BS("Spieler "+CAP(str)+" kann ich nicht finden.")), 1;

      i=ELESSARMASTER->getfeindkills(find_player(str))[0];
      z=ELESSARMASTER->getfeindkills(find_player(str))[1];

      if(i==-1)
	return write(BS(CAP(str)+" hat noch keine bekannten Frevel an Elessar "
			"begangen.")), 1;
      
      ret="Begangene Frevel an Elessar:\n"
	"============================\n";
      ret+=BS("* "+CAP(str)+" mit "+(i?i+" Toetung(en)":"")+
	      (z? (i? " und ":"")+z+" Zivilen Vergehen":"")+".");
    }

  return write(make_document(ret)),1;
}

string Titel(object pl)
{
  string ret;

  // Jaja muss sein ;)
  if(getuid(pl)=="protheg")
    return "Drowmagier ";
  
  if(!pl->QueryProp(Listener()))
    if(!present(RACETOOLID, pl))
      return "";
    else
      pl->SetProp(Listener(), 1);

  if(pl->QueryProp(P_FROG))
    return "";
  
  if(IS_WIZARD(pl))
    return "Hochelfenmagier"+FM(pl,"in "," ");

  if(IS_SEER(pl))
    ret="Hochelf";
  else
    ret="Elf";
  
  if(pl->QueryProp(P_GUILD)=="druidenzirkel")
    return ret+"endruid"+FM(pl,"in ","e ");
  
  if(pl->QueryProp(P_GUILD)=="zechpreller")
    return ret+"ensaeufer"+FM(pl,"in "," ");
  
  if(pl->QueryProp(P_GUILD)=="berserker")
    return ret+"enberserker"+FM(pl,"in "," ");

  if(pl->QueryProp(P_GUILD)=="paladine")
    return ret+"enpaladin ";

  if(pl->QueryProp(P_GUILD)=="nekromanten")
    return ret+"ennekromant ";
  
  return ret+FM(pl,"e "," ");
}

nosave int nimpresay(string str)
{
  string np, op;

  notify_fail(BS("Du kannst mit 'nimpresay' nur das Elfen-Presay setzen!")+
	      BS("Du kannst aber auch mit 'nimpresay loeschen' das Presay "
		 "loeschen."));

  if(strlen(str)) 
    if(str=="loeschen")
      {
	if(!strlen(TP->QueryProp(P_PRESAY)))
	  return write(BS("Du hattest doch gar kein Presay gesetzt!?")), 1;
	
	TP->SetProp(P_PRESAY, "");
	
	return write(BS("Dein Presay wurde geloescht.")), 1;
      }
    else
      return 0;

  
  np=Titel(TP);
  
  if(strlen(op=TP->QueryProp(P_PRESAY)))
    if(np!=op)
      write(BS("Dein voriges Presay '"+op+"' wird ersetzt."));
  
  TP->SetProp(P_PRESAY, np[0..<2]);
  
  write(BS("Du bist nun:")+
	BS(np+CAP(getuid(TP))+" "+(TP->QueryProp(P_TITLE) || "")));
  
  return 1;
}

nosave int nimfarbe(string str)
{
  notify_fail(BS("Syntax: nimfarbe ein|aus"));
  if(!str) return 0;
  
  if(str=="aus")
    {
      Setting(0); 
      return write(BS("Nimrondels Traene siehst Du jetzt in Schwarz/Weiss.")), 
	1;
    }

  if(str=="ein")
    {
      Setting(1); 
      return write(BS("Nimrondels Traene siehst Du jetzt in Farbe.")), 1;
    }
  
  return 0;
}

nosave int niminfo(string str)
{
  object tp;
  mapping at;
  int xp;

  tp=TP;

  if(str && IS_WIZARD(TP))
    if(!tp=find_player(str))
      return write(BS("Spieler nicht gefunden!")), 1;

  if(tp->QueryProp(P_GHOST))
    return write(BS("Geister haben keine Punkte!")), 1;
  
  at=tp->QueryProp(P_ATTRIBUTES);

  if(!xpdiff) xpdiff=tp->QueryProp(P_XP);

  xp=tp->QueryProp(P_XP);

  write(sprintf(
    " "B"+-----"N"\n"
    " "B"|"N" %35.35-s  %20s         "C":. ,.."N"\n"
    " "B"|"N"                                                                 "C".' :~.':_.,"N"\n"
    "   Leben: %s         "C".'   ::.::'.'"N"\n"
    "   Magie: %s        "C":     ::'  .:"N"\n"
    "                                                              "C"`.:    .:  .:/"N"\n"
    "   Erfahrung:        %10d %28-s  "C"`::--.:'.::'"N"\n"
    "   %28s  %s           "G"|. _"C":===-'"N"\n"
    "   Abenteuer:       %4d [%4d]  %s           "G"/ /"N"\n"
    "   Stufe: %21s                "G",---.---.    __,','"N"\n"
    "   ____________________________               "G"(~`.  \\   )   )','.,---.."N"\n"
    "                                               "G"`v`\\ | ,' .-'.:,'_____   `."N"\n"
    "   Intelligenz:         %8-s                   "G")|/.-~.--~~--.   ~~~-. \\"N"\n"
    "   Ausdauer:            %8-s %9|s      "G"__/-'_.-~        \"\"---.._`.|"N"\n"
    "   Kraft:               %8-s           "G"_.-~~_.-~                     \"\"'"N"\n"
    "   Geschicklichkeit:    %8-s    "G"_..--~~_.(~~"N"\n"
    " "B"|"N"                      "G"__...---~~~_..--~~"N"      %18|s           "B"|"N"\n"
    " "B"|"N" %16s  "G",'___...---~~~"N"      %35.35|s "B"|"N"\n"
    " "B"+-----                                                                 -----+"N"\n",
    Titel(tp)+CAP(getuid(tp)),
    CAP(tp->QueryProp(P_GUILD))+" ["+tp->QueryProp(P_GUILD_LEVEL)+"]",
    Balken(tp->QueryProp(P_HP), tp->QueryProp(P_MAX_HP), setting, 
	   tp->QueryProp(P_WIMPY),45),
    Balken(tp->QueryProp(P_SP), tp->QueryProp(P_MAX_SP), setting,0,45),
    xp, Zustand(tp), 
    (xp-xpdiff ? "Unterschied:      "+sprintf("%10d",xp-xpdiff) : ""), 
    Erschoepfung(tp),
    tp->QueryProp(P_QP), QM->QueryAllQP(), Gewicht(tp),
    Stufenpunkte(tp),
    sprintf("%2d [%2+d]", at[A_INT], tp->QueryAttributeOffset(A_INT)), 
    sprintf("%2d [%2+d]", at[A_CON], tp->QueryAttributeOffset(A_CON)), 
    Gesinnung(tp),
    sprintf("%2d [%2+d]", at[A_STR], tp->QueryAttributeOffset(A_STR)), 
    sprintf("%2d [%2+d]", at[A_DEX], tp->QueryAttributeOffset(A_DEX)),
    (tp->QueryProp(P_WIMPY) ? sprintf("Vo: %3d",tp->QueryProp(P_WIMPY)):""),
    (tp->QueryMoney() ? tp->QueryMoney()+" Muenzen" : ""),
    (tp->QueryProp(P_WIMPY) ? (tp->QueryProp(P_WIMPY_DIRECTION) ? 
			       "Ri: "+tp->QueryProp(P_WIMPY_DIRECTION):""):
     "")));

  GetColor(1);
  return 1;
}

nosave int nimwink(string str)
{
  object *elfs;
  string me;
  int i;

  if(TP->QueryProp(P_INVIS)) 
    return write(BS("Das geht nur, wenn Du sichtbar bist!!")),1;
  
  elfs=Alle_Anwesenden(TP);
  
  me=Titel(TP)+CAP(getuid(TP));
  
  if(!str) str="";  
  if(str[0]=='/') 
    str=str[1..<1]+" ";
  else
    str="";
  
  for(i=sizeof(elfs)-1;i>=0;i--)
    tell_object(elfs[i], BS(me+" winkt allen Elfen "+str+"aus der Ferne zu."));
  
  write(BS("Du winkst allen Elfen "+str+"aus der Ferne zu."));

  return 1;
}

nosave int nimknuddel(string str)
{
  object *elfs;
  string me;
  int i;

  if(TP->QueryProp(P_INVIS)) 
    return write(BS("Das geht nur, wenn Du sichtbar bist!!")),1;
  
  elfs=Alle_Anwesenden(TP);
  
  me=Titel(TP)+CAP(getuid(TP));

  if(!str) str="";  
  if(str[0]=='/') 
    str=str[1..<1]+" ";
  else
    str="";
  
  for(i=sizeof(elfs)-1;i>=0;i--)
    tell_object(elfs[i], BS(me+" knuddelt alle Elfen "+str+"aus der Ferne."));

  write(BS("Du knuddelst alle Elfen "+str+"aus der Ferne."));

  return 1;
}

nosave int nimwer(string str)
{
  if(str && str!="kurz")
    return write(BS("Nimwer [kurz]")), 1;
  
  TP->More(make_document(who_list("Diese Elfen sind anwesend:\n",
				  strlen(str))));
  
  return 1;
}

string extra_look()
{
  return capitalize(environment()->QueryPronoun())+
    " traegt eine von Nimrondels Traenen.\n";
}

void hau_ab(object who)
{
  tell_object(who, BS("Als Du die kleine Wasserperle beruehrst, zerfliesst "
		      "sie ploetzlich..."));

  call_out("remove", 0);
}

