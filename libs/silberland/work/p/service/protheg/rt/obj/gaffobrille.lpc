inherit STD "rt";

#define QM "/secure/questmaster"

#define SOULFILE SOUL "Gaffo"

//Somit ist moeglich "blabla"+C+"blabla"+N
#define C GetColor()
#define S(x) GetColor(x)
#define N NormalColor()

nosave int lastlogin; 

//Liefert die aktuelle Versionsnummer
int Version() { return 1;}

nomask void create()
{
  if(!is_clone(ME)) return;  // (return on BP)
  ::create();

  SetProp(P_SHORT, "Ein grosses Gaffomonokel");
  SetProp(P_LONG,
	  "Dieses schmucke Gaffomonokel fuer extragrosse Augen hast du von Kuckeline "
    "bekommen. Achte darauf und verliere es nicht, dann "
	     "wird es Dir viele Dienste erweisen koennen.");
  SetProp(P_NAME, "Gaffomonokel");
  SetProp(P_GENDER, NEUTER);
  AddId(({"monokel", "gaffomonokel"}));
  
  SetProp(P_WEIGHT, 400);
  SetProp(P_MATERIAL, ([MAT_BRASS:99,MAT_GLASS:1]));
  
  SetProp(P_NOSELL,
	  "Du kannst das Monokel doch nicht einfach verkaufen!\n");
  
  SetProp(P_INFO,
	  "Dieses Monokel kann Dir viele Dienste erweisen.");

  AddDetail("dienste", CLOSURE(huefe));
  
  AddCmd("gafforeport", "Report");
  
  //Cmds fuer die Komunikation
  AddCmd(({"gaffogroehle","gaffogroehl"}), "Rufen");
  AddCmd(({"gaffohist"}), "History");
  AddCmd(({"gaffowink","gaffowinke"}), "gaffwink");
  
  //AddCmd(({"gaffoinfo"}), "gaffoinfo");
  AddCmd(({"gaffower"}), "gaffower");
  AddCmd(({"gaffofarbe","gaffofarben"}), "gaffofarbe");

  AddCmd(({"gaffopresay"}), "gaffopresay");

  //Hilfeanzeige
  AddCmd(({"gaffohilfe"}), "gaffohilfe");
  
  GetColor(1);
  
  SUID;

  // r* commands:
  init_soul_cmds(1);
}

