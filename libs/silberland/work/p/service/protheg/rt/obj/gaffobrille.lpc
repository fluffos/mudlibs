// Meldung fuer Report wenn absolut fit
string absolut_fit()
{
  return "Du bist nun wieder absolut fit.";
}
// Report Zeilen normal
string Report_normal(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* Du hast ";
  
  if(hp==maxhp)
    ret+="volle Lebenspunkte und ";
  else
    ret+=""+hp+" von "+maxhp+" Lebenspunkte und ";
  
  if(sp==maxsp)
    ret+="volle Magiepunkte.";
  else
    ret+=""+sp+" von "+maxsp+" Magiepunkte.";
  
  return ret;
}

// Report Zeilen kurz
string Report_kurz(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* ";
  
  if(hp==maxhp)
    ret+="LP: "+hp+" und ";
  else
    ret+="LP: "+hp+" von ("+maxhp+") und ";
  
  if(sp==maxsp)
    ret+="MP: "+sp;
  else
    ret+="MP: "+sp+" von ("+maxsp+")";
  
  return ret;
}

// Spezialbehandlungen von Aufenthaltsorten bei werliste
string Region(string str)
{
  if(strstr(str, "/d/ebene/Gaffos/")==0)
    return "Gaffodorf";
  
  return "";
}

