#pragma strong_types;

#include "../def.h"
#include <ansi.h>
#include <exploration.h>

inherit STD "rt";

#define DHRKIONMASTER "/d/unterwelt/zordan/dhrkion/master/dhrkion"
#define QM "/secure/questmaster"

#define SOULFILE SOUL "Dunkelelf"

#define DUNKEL 10

//Somit ist moeglich "blabla"+C+"blabla"+N
#define C GetColor()
#define S(x) GetColor(x)
#define N NormalColor()

nosave int dunkel, lastlogin; 

varargs nosave string huefe(int flag);

//Liefert die aktuelle Versionsnummer
int Version() { return 50;}

nomask void create()
{
  if(!is_clone(ME)) return;  // (return on BP)
  ::create();

  SetProp(P_SHORT, "Eine kleine Spinne");
  SetProp(P_LONG,
	  BS("Eine kleine Spinne aus Obsidian, die Euch wertvolle Dienste "
	     "leisten wird, solange Ihr sie auf der Schulter tragt. Sie "
	     "ist von Lloth persoenlich geweiht worden, also achtet auf sie!"));
  SetProp(P_NAME, "Spinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({"spinne", "spinnentool"}));

  SetProp(P_WEIGHT, 150);
  SetProp(P_MATERIAL, ([MAT_OBSIDIAN:90,MAT_MISC_UNHOLY:10]));

  SetProp(P_NOSELL,
	  "Ihr hoert eine Stimme im Kopf: 'Wage es bloss nicht!'\n");

  SetProp(P_INFO,
	  "Lauscht, welche Dienste Euch die Spinne bieten kann!\n");

  AddDetail("dienste",
	    "Lauscht, welche Dienste sie Euch bieten kann!\n");
  
  SetProp(P_SOUND, CLOSURE(huefe));
  
  AddCmd("spreport", "Report");
  
  //Cmds fuer die Drow-komunikation
  AddCmd(({"spruf","sprufe"}), "Rufen");
  AddCmd(({"sphist"}), "History");
  AddCmd(({"spwink","spwinke"}), "spwink");
  AddCmd(({"spdunkel"}), "spdunkel");
  AddCmd(({"sphass"}), "sphass"); 

  AddCmd(({"spinfo"}), "spinfo");
  AddCmd(({"spwer"}), "spwer");
  AddCmd(({"spfarbe","spfarben"}), "spfarbe");

  AddCmd(({"sppresay"}), "sppresay");

  //Anzeige der Feinde von Dhrkion...
  AddCmd(({"spfeinde"}),"spfeinde");

  //Hilfeanzeige
  AddCmd(({"sphilfe"}), "sphilfe");

  GetColor(1);
  
  SUID;

  // r* commands:
  init_soul_cmds(1);
}

//Liefert den Filename zum Masterobjekt
string Master()
{
  return RTM "spinnenmaster";
}

// liefert den String fuers ignorieren (ignoriere bla)
string IgnoriereID()
{
  return "spinne";
}

// liefert den String fuer die Rasse
string Rasse()
{
  return "Dunkelelf";
}

// Meldung fuer Report wenn absolut fit
string absolut_fit()
{
  return "Ihr seid nun wieder absolut fit.";
}

// Report Zeilen normal
string Report_normal(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* Ihr habt nun ";
  
  if(hp==maxhp)
    ret+="volle Lebenspunkte und ";
  else
    ret+=""+hp+" von "+maxhp+" Lebenspunkte und ";
  
  if(sp==maxsp)
    ret+="volle Magiepunkte.";
  else
    ret+=""+sp+" von "+maxsp+" Magiepunkte.";
  
  return ret;
}

// Report Zeilen kurz
string Report_kurz(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* ";
  
  if(hp==maxhp)
    ret+="LP: "+hp+" und ";
  else
    ret+="LP: "+hp+" von ("+maxhp+") und ";
  
  if(sp==maxsp)
    ret+="MP: "+sp;
  else
    ret+="MP: "+sp+" von ("+maxsp+")";
  
  return ret;
}

// Spezialbehandlungen von Aufenthaltsorten bei werliste
string Region(string str)
{
  if(strstr(str, "/d/unterwelt/zordan/dhrkion")==0)
    return "Dhrkion";
  
  if(strstr(str, "/d/unterwelt/protheg/av")==0)
    return "ArdulVhier";
  
  return "";
}

