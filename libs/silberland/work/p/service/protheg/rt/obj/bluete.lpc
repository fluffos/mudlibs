#pragma strong_types;

#include "../def.h"
#include <ansi.h>
#include <exploration.h>

inherit STD "rt";

#define FEEFEINDMASTER "/d/ebene/ronja/feenquest/master/master"
#define QM "/secure/questmaster"

#define C +GetColor()+
#define G +GetColor(ANSI_BOLD+ANSI_YELLOW)+
#define B +GetColor(ANSI_YELLOW)+
#define N +NormalColor()+

varargs nosave string huefe(int flag);

int Version() { return 4;}

nomask void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Die seidene Bluete einer Orchidee");
  SetProp(P_LONG,
	  BS("In Deinen Haenden haelst Du eine aeusserst zarte, seidene "
	     "Bluete einer Orchidee, die eine leicht blaeuliche Maserung "
	     "aufweist. Sie wirkt sehr fragil, doch Du spuerst, "
	     "dass die Magie in ihr sehr maechtig ist und die Bluete und "
	     "deren Traegerin beschuetzt."));

  SetProp(P_NAME, "Orchideenbluete");
  SetProp(P_GENDER, FEMALE);

  AddId(({"bluete","orchideenbluete","seidenbluete"}));
  
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 100);
  SetProp(P_MATERIAL, ([MAT_MISC_PLANT:90,MAT_MAGIC:10]));
  SetProp(P_NODROP, "Nicht doch! Die Bluete koennte beschaedigt werden...\n");

  SetProp(P_ARTICLE, 1);
  
  SetProp(P_SMELL, "Die Orchideenbluete duftet so gut, dass es Dir gleich "
	  "besser geht.\n");
  
  SetProp(P_NOSELL,
	  "Der Haendler wuerde den wahren Wert dieser Bluete nicht "
	  "erkennen!\n");

  SetProp(P_INFO,
	  BS("Keine wahre Fee traegt einen Teddy mit sich herum! Im "
	     "Gegenteil! Er koennte die Orchideenbluete sogar stoeren."));
  
  AddDetail("maserung", CLOSURE(huefe));
  
  AddCmd("feereport", "Report");
  
  //Cmds fuer die Feenkomunikation
  AddCmd(({"feetriller","feetrillere","feetraeller","feetraellere"}), "Rufen");
  AddCmd(({"feehist","feehistory"}), "History");
  AddCmd(({"feewink","feewinke"}), "feewink");
  AddCmd(({"feeknuddel","feeknuddle","feeknuddele"}), "feeknuddel");

  AddCmd(({"feeinfo"}), "feeinfo");
  AddCmd(({"feewer"}), "feewer");
  AddCmd(({"feefarbe","feefarben"}), "feefarbe");
  AddCmd(({"feefeind","feefeinde"}), "feefeinde");
  
  AddCmd(({"feepresay"}), "feepresay");

  AddCmd(({"feehilfe"}), "feehilfe");

  GetColor(1);
  
  SUID;
  
  // r* commands:
  init_soul_cmds(1);
}

string info()
{
  if((MENV) && (query_once_interactive(MENV)))
    if(present("universal-teddy", MENV))
      return BS("Keine wahre Fee traegt einen Teddy mit sich herum! Im "
		"Gegenteil! Er koennte die Bluete sogar stoeren.");
  return BS("Die Bluete ist von einer maechtigen magischen Aura umgeben.");
}

string Master()
{
  return RTM "feenmaster";
}

string Rasse()
{
  return "Fee";
}

string IgnoriereID()
{
  return "bluete";
}

string absolut_fit()
{
  return "Du bist nun wieder absolut fit.";
}

string Report_normal(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* Du hast nun ";
  
  if(hp==maxhp)
    ret+="volle Lebenspunkte und ";
  else
    ret+=""+hp+" von "+maxhp+" Lebenspunkte und ";
  
  if(sp==maxsp)
    ret+="volle Magiepunkte.";
  else
    ret+=""+sp+" von "+maxsp+" Magiepunkte.";
  
  return ret;
}

string Report_kurz(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* ";
  
  if(hp==maxhp)
    ret+="LP: "+hp+" und ";
  else
    ret+="LP: "+hp+" von ("+maxhp+") und ";
  
  if(sp==maxsp)
    ret+="MP: "+sp;
  else
    ret+="MP: "+sp+" von ("+maxsp+")";
  
  return ret;
}

string Region(string str)
{
  if(strstr(str, "/d/ebene/ronja/feenquest")==0)
    return "Elessar";

  return "";
}

string Erneuern_Meldung()
{
  return BS(""C"Deine Orchideenbluete leuchtet kurz auf!"N"");
}

string History_leer()
{
  return BS("In letzter Zeit war es recht ruhig...");
}

string History_msg()
{
  return "";
}

string History_format()
{
  return "trillerte: ";
}

string Rufen_syntax()
{
  return BS("Was willst Du den anderen Feen zutrillern?");
}

string Rufen_format()
{
  return "trillert Dir zu: ";
}

string Rufen_msg()
{
  return "Du trillerst den Feen zu: ";
}

varargs nosave string huefe(int flag)
{
  string ret, rcmds;
  int i;
  
  rcmds="";
  
  if(IS_SEER(TP))
    {
      for(i=sizeof(soulcmds)-1;i>=0;i--)
	if(i==0)
	  rcmds+="und "+soulcmds[i][0]+".";
	else
	  rcmds+=soulcmds[i][0]+", ";
      
      rcmds=break_string(rcmds, 60, " ", BS_NO_PARINDENT);
    }
  else
    {
      for(i=sizeof(soulcmds)-1;i>=0;i--)
	if(i==0)
	  rcmds+="und "+soulcmds[i][0]+"("+soulcmds[i,2]+").";
	else
	  rcmds+=soulcmds[i][0]+"("+soulcmds[i,2]+"), ";
      
      rcmds=break_string(rcmds, 60, " ", BS_NO_PARINDENT);
    
  
      rcmds+="Die Zahlen in den Klammern sind die Magiekosten.\n \n";
      
    }
  
  ret="\n \n"
    "Die Orchideenbluete kann Dir anzeigen, wie es um Deine\n"
    "Lebensenergie und Zauberkraft bestellt ist.\n \n"
    "Der Befehl dazu lautet:\n"
    " 'feereport [ein|kurz|farbe|farbekurz|aus]'\n \n"
    "Die Orchideenbluete bietet Dir weiters folgende RVerben an:\n"+
    rcmds+
    "\nEinige Befehle nur fuer Feen:\n"
    " 'feewer, feeinfo, feefarbe, feepresay'\n \n"
    "RVerben nur fuer Feen:\n"
    " 'feewinke, feeknuddel'\n"
    "Hilfe zu den Befehlen erhaelst Du mit:\n"
    " 'feehilfe'\n \n"
    "                                                         Ver 1."+Version()+"\n";
  
  if(flag && intp(flag))
    return ret;
  
  TP->More(make_document(ret));
  return "";
}

nosave int feehilfe(string str)
{
  string ret;

  if(str) str=explode(str, " ")[0];

  switch(str)
    {
    case "feereport": 
      ret="Der 'feereport' informiert Dich, wie es um Deine\n"
	"Lebensenergie und Zauberkraft bestellt ist.\n"
	"Moegliche Einstellungen sind:\n"
	"* feereport normal    - Schaltet den Report normal ein.\n"
	"* feereport kurz      - Schaltet den Report kurz ein.\n"
	"* feereport farbe     - Schaltet den Report in Farbe ein.\n"
	"* feereport farbekurz - Schaltet den Report faerbig und\n"
	"                        kurz ein.\n"
	"* feereport aus       - Schaltet den Report wieder aus.\n";
      break;
    case "feeinfo": 
      ret="In 'feeinfo' hast Du eine eher zu Feen passende Version\n"
	"der normalen Infoanzeige bei 'info'.\n"
	"Mit 'feefarbe' kannst Du die Anzeige sogar in wunderschoenen\n"
	"Farben darstellen lassen.\n"
	"Einige unwichtige Angaben werden im Normalfall unterdrueckt.\n";
      break;
    case "feewer": 
      ret="Mit 'feewer' siehst Du, wer aus dem Feenvolk anwesend ist.\n"
	"*  Wer ist anwesend?\n"
	"*  Ist sie anwesend, oder idle?\n"
	"*  Was fuer eine Waffe hat sie gezueckt?\n"
	"*  Welche Gesinnung hat sie?\n"
	"*  Wo befindet sie sich?\n\n"
	"Mit 'feewer kurz' siehst Du das ganze etwas kompakter.\n";
    break;
    case "feefarben":
    case "feefarbe": 
      ret="Mit '"+str+" ein|aus' kannst Du die Farbanzeige einstellen.\n";
    break;
    case "feetraeller":
    case "feetraellere":
    case "feetriller": 
    case "feetrillere": 
      ret="Mit '"+str+"' hast Du die Moeglichkeit, den anderen Feen\n"
	"etwas mitzuteilen, ohne dass andere Rassen mithoeren koennen.\n"
	"Mit 'feehist' kannst Du die Rufe nocheinmal lesen.\n";
    break;
    case "feehist": 
      ret="Mit 'feehist' kannst Du versuchen, die Echos der zuletzt\n"
	"getrillerten Meldungen zu erhaschen...\n"
	"Jedoch ist die Liste in ihrer Groesse beschraenkt.\n";
    break;
    case "feewinke":
    case "feewink": 
      ret="Mit '"+str+"' kannst Du den anderen Feen zuwinken.\n"; 
      break;
    case "feeknuddel":
    case "feeknuddle":
    case "feeknuddele": 
      ret="Mit '"+str+"' kannst Du die anderen Feen alle knuddeln.\n"; 
      break;
    case "feefeind":
    case "feefeinde":
      ret="Mit '"+str+"' siehst Du die derzeitigen Feinde vom Feenschloss.\n";
      break;
    case "feepresay":
      ret="Mit 'feepresay' kannst Du Dir Dein Feen-Presay, welches\n"
	"z.B. bei 'feewer' gezeigt wird, permanent als Presay setzen.\n\n"
	"Mit 'feepresay loeschen' kannst Du Dein Presay wieder entfernen.\n";
      break;
    case "allgemein":
      ret=huefe(1);
      break;
    case "ignoriere":
    case "ignorieren":
      ret=ignorieren_hilfe_text();
      break;
    default: 
      ret="Mit 'feehilfe' kannst Du Dich ueber Folgendes informieren:\n \n"
	"feehilfe <feereport>  Wie sieht es mit Leben u. Magie aus?\n"
	"         <feeinfo>    Ein etwas anderes 'info'.\n"
	"         <feewer>     Eine Liste aller anwesenden Feen.\n"
	"         <feefarbe>   Farbeinstellungen?\n"
	"         <feepresay>  Das Feenpresay fix setzen.\n"
	"         <feetriller> Den anderen Feen etwas zutrillern?\n"
	"         <feehist>    Wer hat den Feen etwas zugerufen?\n"
	"         <feefeinde>  Die Feinde vom Feenschloss!\n"
	"         <feewink>    Winkt den anwesenden Feen zu.\n"
	"         <feeknuddel> Knuddelt alle anwesenden Feen.\n"
	"         <allgemein>  Allgemeine Uebersicht.\n"
	"         <ignoriere>  Uebersicht der Ignorieremoeglichkeiten.\n";
    }
  return TP->More(make_document(ret)),1;
}

nosave int feefeinde(string str)
{
  int i;
  string ret;
  object *feinde;
  string *f;
    
  catch(call_other(FEEFEINDMASTER, "???"));
	
  if(!sizeof(feinde=FEEFEINDMASTER->ListEnemies()))
    return write(BS("Im Feenschloss herrscht zur Zeit Frieden.")), 1;
  
  ret="";
  f=({});
  
  for(i=sizeof(feinde)-1;i>=0;i--)
    f+=({CAP(explode(feinde[i], "_")[0])});
  
  f=sort_array(f, CLOSURE(>));
  
  if(sizeof(f)==1)
    ret+=BS("* "+f[0]+".");
  else
    {
      ret+=(implode(f[0..<2], ", "));
      
      ret+=" und "+f[<1]+".";
      ret=break_string(ret, 40, "* ",BS_LEAVE_MY_LFS|BS_NO_PARINDENT);
    }
  ret="Die aktuellen Feinde vom Feenschloss:\n"+ret;
  
  return write(make_document(ret)),1;
}

string Titel(object pl)
{
  string ret;

  // Jaja muss sein ;)
  if(getuid(pl)=="protheg")
    return "Drowmagier ";
  
  if(!pl->QueryProp(Listener()))
    if(!present(RACETOOLID, pl))
      return "";
    else
      pl->SetProp(Listener(), 1);

  if(pl->QueryProp(P_FROG))
    return "";
  
  if(IS_WIZARD(pl))
    return "Feenmagierin ";

  if(IS_SEER(pl))
    ret="Fee";
  else
    ret="Jungfee";
  
  if(pl->QueryProp(P_GUILD)=="druidenzirkel")
    return ret+"ndruidin ";
  
  if(pl->QueryProp(P_GUILD)=="zechpreller")
    return ret+"nsaeuferin ";
  
  if(pl->QueryProp(P_GUILD)=="paladine")
    return ret+"npaladin ";

  if(pl->QueryProp(P_GUILD)=="bardengilde")
    return ret+"nbardin ";

  return ret+" ";
}

nosave int feepresay(string str)
{
  string np, op;

  notify_fail(BS("Du kannst mit 'feepresay' nur das Feen-Presay setzen!")+
	      BS("Du kannst aber auch mit 'feepresay loeschen' das Presay "
		 "loeschen."));

  if(strlen(str)) 
    if(str=="loeschen")
      {
	if(!strlen(TP->QueryProp(P_PRESAY)))
	  return write(BS("Du hattest doch gar kein Presay gesetzt!?")), 1;
	
	TP->SetProp(P_PRESAY, "");
	
	return write(BS("Dein Presay wurde geloescht.")), 1;
      }
    else
      return 0;

  
  np=Titel(TP);
  
  if(strlen(op=TP->QueryProp(P_PRESAY)))
    if(np!=op)
      write(BS("Dein voriges Presay '"+op+"' wird ersetzt."));
  
  TP->SetProp(P_PRESAY, np[0..<2]);
  
  write(BS("Du bist nun:")+
	BS(np+CAP(getuid(TP))+" "+(TP->QueryProp(P_TITLE) || "")));
  
  return 1;
}

nosave int feefarbe(string str)
{
  notify_fail(BS("Syntax: feefarbe ein|aus"));
  if(!str) return 0;
  
  if(str=="aus")
    {
      Setting(0); 
      return write(BS("Die Orchideenbluete siehst Du jetzt in "
		      "Schwarz/Weiss.")), 1;
    }

  if(str=="ein")
    {
      if(TP->QueryProp(P_TTY)!="ansi")
	return write(BS("Du hast noch nicht 'stty ansi' gemacht!")), 1;

      Setting(1); 
      return write(BS("Die Orchideenbluete siehst Du jetzt in Farbe.")), 1;
    }
  
  return 0;
}

nosave int feeinfo(string str)
{
  object tp;
  mapping at;
  int xp;

  tp=TP;

  if(str && IS_WIZARD(TP))
    if(!tp=find_player(str))
      return write(BS("Spieler nicht gefunden!")), 1;

  if(tp->QueryProp(P_GHOST))
    return write(BS("Geister haben keine Punkte!")), 1;
  
  at=tp->QueryProp(P_ATTRIBUTES);

  if(!xpdiff) xpdiff=tp->QueryProp(P_XP);

  xp=tp->QueryProp(P_XP);

  write(sprintf(
"                "C",_"N"   "G".--.                            .--."N"   "C"_,"N"\n"
"                "C"_)\\ "N""G"/    ;--.                     .--;   \\"N" "C"/(_"N"\n"
"   "G". ' ."N"    "C"_.-'   |"N"   "G".'    \\                  /    '."N"   "C"|   '-._"N"    "G". ' ."N"\n"
"  "G"-= * =-"N"  "C"(.-,    /"N"  "G"/       |                |       \\"N"  "C"\\    ,-.)"N"  "G"-= * =-"N"\n"
"   "G"' ."N"\\"G"'"N"    ). "C"'))/"N" "G".'       /                  \\       '."N" "C"\\((`"N" .(    "G"'"N"/"G". '"N"\n"
"       \\_   \\_  /( "G"/        (                    )        \\"N" )\\  _/   _/\n"
"       /_\\ .--'   '-.        "G"\\                  /"N"        .-'   '--. /_\\\n"
"       ||\\/    "B"_________________________________________________"N"   \\/||\n"
"       ||/ /' "B"("N"%48.48|s"B"()"N"'\\ \\||\n"
"       \\_.'   "B"|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~|"N"   '._/\n"
"             ."B"|"N" Leben:  %s "B"|"N".\n"
"            / "B"|"N" Magie:  %s "B"|"N" \\\n"
"           |  "B"|"N"                                                "B"|"N"  |\n"
"           |  "B"|"N" Erfahrung:    %10d   %10.10-s          "B"|"N"  |\n"
"           |  "B"|"N" %24s   %16-s    "B"|"N"  |\n"
"        __/'  "B"|"N" Abenteuer:   %4d [%4d]                       "B"|"N"  '\\__\n"
"    _..'  _.-'"B"|"N" Stufe: %21s                   "B"|"N"`-._  '. _\n"
" _./  .-;'/   "B"|"N"                                                "B"|"N"   \\`;-.` `._\n"
"/_.-'' / /    "B"|"N" Intelligenz: %8-s %24.24-s "B"|"N"    \\ \\ `'-._\\\n"
"       | /    "B"|"N" Ausdauer:    %8-s %-s     "B"|"N"     \\ |\n"
"      ( /     "B"|"N" Kraft:       %8-s %-s     "B"|"N"      \\ )\n"
"     /_/      "B"|"N" Geschick:    %8-s %18-s       "B"|"N"       \\_\\\n"
"              "B"|"N" %45.45-s  "B"|"N"\n"
"              "B"|_______________________________________________ |"N"\n"
"              "B"\\_______________________________________________\\/"N"\n",
Titel(tp)+CAP(getuid(tp))+" "+CAP(tp->QueryProp(P_GUILD))+" ["+tp->QueryProp(P_GUILD_LEVEL)+"]",
Balken(tp->QueryProp(P_HP), tp->QueryProp(P_MAX_HP), setting, 
       tp->QueryProp(P_WIMPY),38),
Balken(tp->QueryProp(P_SP), tp->QueryProp(P_MAX_SP), setting,0,38),
xp, Gesinnung(tp), (xp-xpdiff ? "Unterschied:  "+sprintf("%10d",xp-xpdiff) : ""),
(tp->QueryMoney() ? tp->QueryMoney()+" Muenzen" : ""),
tp->QueryProp(P_QP), QM->QueryAllQP(), Stufenpunkte(tp),
sprintf("%2d [%2+d]", at[A_INT], tp->QueryAttributeOffset(A_INT)), 
Zustand(tp)[1..], 
sprintf("%2d [%2+d]", at[A_CON], tp->QueryAttributeOffset(A_CON)), 
Erschoepfung(tp),
sprintf("%2d [%2+d]", at[A_STR], tp->QueryAttributeOffset(A_STR)), 
Gewicht(tp),
sprintf("%2d [%2+d]", at[A_DEX], tp->QueryAttributeOffset(A_DEX)),
(tp->QueryProp(P_WIMPY) ? sprintf("Vorsicht: %3d",tp->QueryProp(P_WIMPY)):""),
(tp->QueryProp(P_WIMPY) ? (tp->QueryProp(P_WIMPY_DIRECTION) ? 
			   "Flucht: "+tp->QueryProp(P_WIMPY_DIRECTION):""):"")

));
  
  GetColor(1);
  return 1;
}

nosave int feewink(string str)
{
  object *feen;
  string me;
  int i;

  if(TP->QueryProp(P_INVIS)) 
    return write(BS("Das geht nur, wenn Du sichtbar bist!!")),1;
  
  feen=Alle_Anwesenden(TP);
  
  me=Titel(TP)+CAP(getuid(TP));
  
  if(!str) str="";  
  if(str[0]=='/') 
    str=str[1..<1]+" ";
  else
    str="";
  
  for(i=sizeof(feen)-1;i>=0;i--)
    tell_object(feen[i], BS(me+" winkt allen Feen "+str+"aus der Ferne zu."));
  
  write(BS("Du winkst allen Feen "+str+"aus der Ferne zu."));

  return 1;
}

nosave int feeknuddel(string str)
{
  object *feen;
  string me;
  int i;

  if(TP->QueryProp(P_INVIS)) 
    return write(BS("Das geht nur, wenn Du sichtbar bist!!")),1;
  
  feen=Alle_Anwesenden(TP);
  
  me=Titel(TP)+CAP(getuid(TP));

  if(!str) str="";  
  if(str[0]=='/') 
    str=str[1..<1]+" ";
  else
    str="";
  
  for(i=sizeof(feen)-1;i>=0;i--)
    tell_object(feen[i], BS(me+" knuddelt alle Feen "+str+"aus der Ferne."));
  
  write(BS("Du knuddelst alle Feen "+str+"aus der Ferne."));
  
  return 1;
}

nosave int feewer(string str)
{
  if(str && str!="kurz")
    return write(BS("Syntax: 'feewer [kurz]'")), 1;
  
  TP->More(make_document(who_list("Diese Feen sind anwesend:\n",
				  strlen(str))));
  
  return 1;
}

string extra_look()
{
  return capitalize(environment()->QueryPronoun())+
    " wird von der Magie einer Orchideenbluete beschuetzt.\n";
}

void hau_ab(object who)
{
  tell_object(who, BS("Als Du die zarte Orchideenbluete beruehrst, zerfaellt "
		      "sie zu Staub..."));

  call_out("remove", 0);
}

