#pragma strong_types;

#include "../def.h"
#include <ansi.h>
#include <exploration.h>

inherit STD "rt";

#define QM "/secure/questmaster"

#define SOULFILE SOUL "Troll"

//Somit ist moeglich "blabla"+C+"blabla"+N
#define C GetColor()
#define S(x) GetColor(x)
#define N NormalColor()

nosave int lastlogin; 

//Liefert die aktuelle Versionsnummer
int Version() { return 4;}

nomask void create()
{
  if(!is_clone(ME)) return;  // (return on BP)
  ::create();

  SetProp(P_SHORT, "Das Gebiss eines maechtigen Bergpumas");
  SetProp(P_LONG,
	  BS("Du hast dieses Gebiss eines maechtigen Bergpumas von Gjordil "
	     "bekommen. Achte darauf und verliere es nicht, dann "
	     "wird es Dir viele Dienste erweisen koennen."));
  SetProp(P_NAME, "Gebiss");
  SetProp(P_GENDER, NEUTER);
  AddId(({"gebiss", "pumagebiss", "bergpumagebiss"}));
  
  SetProp(P_WEIGHT, 400);
  SetProp(P_MATERIAL, ([MAT_BONE:99,MAT_FLESH:1]));
  
  SetProp(P_NOSELL,
	  "Du kannst das Gebiss doch nicht einfach verkaufen!\n");
  
  SetProp(P_INFO,
	  "Dieses maechtige Gebiss kann Dir viele Dienste erweisen.");

  AddDetail("dienste", CLOSURE(huefe));
  
  AddCmd("trollreport", "Report");
  
  //Cmds fuer die Komunikation
  AddCmd(({"trollgroehle","trollgroehl"}), "Rufen");
  AddCmd(({"trollhist"}), "History");
  AddCmd(({"trollwink","trollwinke"}), "trollwink");
  
  AddCmd(({"trollinfo"}), "trollinfo");
  AddCmd(({"trollwer"}), "trollwer");
  AddCmd(({"trollfarbe","trollfarben"}), "trollfarbe");

  AddCmd(({"trollpresay"}), "trollpresay");

  //Hilfeanzeige
  AddCmd(({"trollhilfe"}), "trollhilfe");
  
  GetColor(1);
  
  SUID;

  // r* commands:
  init_soul_cmds(1);
}

//Liefert den Filename zum Masterobjekt
string Master()
{
  return RTM "trollmaster";
}

// liefert den String fuers ignorieren (ignoriere bla)
string IgnoriereID()
{
  return "gebiss";
}

// liefert den String fuer die Rasse
string Rasse()
{
  return "Troll";
}

// Meldung fuer Report wenn absolut fit
string absolut_fit()
{
  return "Troll jetzt wieder fit!";
}

// Report Zeilen normal
string Report_normal(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* Troll ";
  
  if(hp==maxhp)
    ret+="volle Lebenspunkte und ";
  else
    ret+=""+hp+" von "+maxhp+" Lebenspunkte und ";
  
  if(sp==maxsp)
    ret+="volle Magiepunkte.";
  else
    ret+=""+sp+" von "+maxsp+" Magiepunkte.";
  
  return ret;
}

// Report Zeilen kurz
string Report_kurz(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* ";
  
  if(hp==maxhp)
    ret+="LP: "+hp+" und ";
  else
    ret+="LP: "+hp+" von ("+maxhp+") und ";
  
  if(sp==maxsp)
    ret+="MP: "+sp;
  else
    ret+="MP: "+sp+" von ("+maxsp+")";
  
  return ret;
}

// Spezialbehandlungen von Aufenthaltsorten bei werliste
string Region(string str)
{
  if(strstr(str, "/d/gebirge/speedy/trollager")==0)
    return "Trolllager";
  
  return "";
}

