int pflanzerauchen11(object raucher)                                           
{
  if(raucher)
    {
      write(BS("Total benommen nimmst Du noch einen letzten Zug aus Deiner "
	       "Pfeife und steckst sie dann weg.\n\n"));
      say(BS(raucher->name()+" nimmt noch einen letzten Zug aus der Pfeife "
	     "und steckt sie dann weg."));
      
      SetProp(P_NODROP, 0);
      
      pfeifegestopft_kraut=0;
      pfeifeangezuendet=0;
      return 1;
    }
  else
    {
      pfeifeangezuendet=0;
      return 1;
    }
}

string short()
{
  if(pfeifeangezuendet)
    SetProp(P_SHORT, "Grados Hobbitpfeife (glimmend)");
  else
    if(pfeifegestopft_blatt || pfeifegestopft_kraut ||
       pfeifegestopft_stern || pfeifegestopft_pflanze)
      SetProp(P_SHORT, "Grados Hobbitpfeife (gestopft)");
    else
      SetProp(P_SHORT, "Grados Hobbitpfeife");
  
  return ::short();
}

// Extralook
string extra_look()
{
  if(!MENV) return "";
  if(!query_once_interactive(MENV)) return "";
  
  if(pfeifeangezuendet)
    return BS(CAP(MENV->QueryPronoun())+" raucht gerade eine von Grados "
	      "Hobbitpfeifen.");
  else
    return BS(CAP(MENV->QueryPronoun())+" traegt eine von Grados "
	      "Hobbitpfeifen.");
}
