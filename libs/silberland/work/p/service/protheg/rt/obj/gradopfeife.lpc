int zufall;


int pflanzerauchen1(object raucher)
{
  if(raucher)
    {
      write(BS("Du wunderst Dich ueber den komischen Geschmack der "
	       "Nakrafulpflanze. Irgendwie nicht schlecht, aber irgendwie "
	       "auch ganz anders als alles das Du bisher geraucht hast."));
      say(BS(raucher->name()+" schliesst "+
	     raucher->QueryPossPronoun(FEMALE,WEN)+
	     " Augen und entspannt sich total."));

      call_out("pflanzerauchen2", 25+random(5),raucher);
    }
  else
    {
      pfeifeangezuendet=0;
      return 1;
    }
}

int pflanzerauchen2(object raucher)
{
  if(raucher)
    {
      formringerl=random(7);
      
      write(BS("Vergnuegt springst Du herum und machst "+RINGERL[formringerl]+
	       ". Du fuehlst Dich total frei, denkst an die Weiten der Wueste."));
      say(BS(raucher->name()+" blaest vergnuegt "+RINGERL[formringerl]+"."));
      
      call_out("pflanzerauchen3", 25+random(5),raucher);
    }
  else
    { 
      pfeifeangezuendet=0;
      return 1;
    }
}

int pflanzerauchen3(object raucher)
{
  if(raucher)
    {
      zufall=random(24);

      write(BS("Bilder dringen in Deinen Kopf ein, Bilder "+FIGUREN[zufall]+
	       ". Du gruebelst ob sie Dir bekannt vorkommen, ob Du dort "
	       "schon mal warst."));
      say(BS(raucher->name()+" scheint in Gedanken versunken."));

      call_out("pflanzerauchen4", 25+random(5),raucher);
    }
  else
    {
      pfeifeangezuendet=0;
      return 1;
    }
}

