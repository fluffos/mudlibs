      call_out("pflanzerauchen10", 15+random(5),raucher);
    }
  else
    {
      pfeifeangezuendet=0;
      return 1;
    }
}

int pflanzerauchen10(object raucher)
{
  if(raucher)
    {
      write(BS("Ploetzlich findest Du dich an dem Ort wieder, den Du in "
	       "Deinen Visionen gesehen hast..."));

      raucher->move(ORT[zufall], M_TPORT, 
		    "vor Deinen Augen",
		    "verschwindet",
		    "erscheint mit einem lauten Knall");
      
      call_out("pflanzerauchen11", 15+random(5),raucher);
    }
  else
    {
      pfeifeangezuendet=0;
      return 1;
    }
