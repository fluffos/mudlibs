#pragma strong_types;

#include "../def.h"
#include <ansi.h>
#include <exploration.h>

inherit STD "rt";

#define QM "/secure/questmaster"

#define BARRY "/d/huegelland/orw/pfeifenladen/"

#define C +GetColor()+
#define G +GetColor(ANSI_GREEN)+
#define W +GetColor(ANSI_WHITE)+
#define N +NormalColor()+

varargs nosave string huefe(int flag);

int Version() { return 10;}

// Vars fuer Pfeife
#define RINGERL ({"ein Ringerl","ein unfoermiges Ringerl", \
                  "ein huebsches Ringerl","ein rundes Ringerl", \
                  "ein lustiges Ringerl","ein ovales Ringerl", \
                  "ein nicht sehr huebsches Ringerl" })

nosave int pfeifeangezuendet;
nosave string pfeifenname = "Grados Hobbitpfeife";
nosave int pfeifenwert = random(3)+random(3)+random(3);
nosave int formringerl;
nosave int pfeifegestopft_blatt;
nosave int pfeifegestopft_kraut;
nosave int pfeifegestopft_stern;
nosave int pfeifegestopft_pflanze;

string det_farbe()
{
  return "Jetzt ist sie "+({"blau","cyanfarben","purpur","rot",
			      "gelb"})[random(5)]+".\n";
}

nomask void create()
{
  string aussehen;
  
  if(!is_clone(ME)) return;
  ::create();
  
  aussehen="Die Hobbitpfeife ist "+
    ({"lang","kurz","laenglich","eher kurz","eher lang"})[random(5)]+
    ", "+
    ({"schmal","breit","duenn","dick"})[random(4)]+
    " und "+
    ({"gebogen","gerade","geknickt"})[random(3)]+
    ".";
  
  SetProp(P_SHORT, "Grados Hobbitpfeife");
  SetProp(P_LONG,
	  BS("Dies ist eine der Hobbitpfeifen von Grado Schnellfuss, einem "
	     "beruehmten Hobbitabenteurer. Die Pfeifen wurden ihm einst von "
	     "einem maechtigen Zauberer zum Geschenk gemacht. Diese Pfeife "
	     "ist von ausgezeichneter Qualitaet und ihr Holz weist einige "
	     "elfische Schnitzereien auf. Sie scheint ihre Farbe zu aendern.")+
	  BS(aussehen));

  SetProp(P_NAME, ({"Grados Hobbitpfeife", "Grados Hobbitpfeife",
		      "Grados Hobbitpfeife", "Grados Hobbitpfeife"}));
  SetProp(P_GENDER, FEMALE);
  
  AddId(({"pfeife", "hobbitpfeife","grados pfeife","grados hobbitpfeife"}));
  
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));
  SetProp(P_NODROP, 
	  BS("Du wuerdest Dich nie von dieser kostbaren Hobbipfeife trennen!"));
  SetProp(P_ARTICLE, 0);
  
  SetProp(P_NOSELL,
	  "Du wuerdest Dich nie von dieser kostbaren Hobbipfeife trennen!\n");
  
  SetProp(P_INFO,
	  BS("Das ist sicher keine gewoehnliche Pfeife.")+
	  BS("Sie passt doch wesentlich besser zu einem Hobbit als so "
	     "ein Teddy. Dieser wuerde die Hobbitpfeife zudem nur negativ "
	     "beeinflussen."));
  
  AddDetail(({"form","aussehen"}),
	    aussehen);
  
  AddSpecialDetail(({"farbe"}), "det_farbe");
  
  AddDetail(({"grado","schnellfuss", "grado schnellfuss"}),
	    "Grado Schnellfuss ist anscheinend ein hobbitscher Abenteurer.");
  
  AddDetail(({"holz", "qualitaet"}),
	    "Das Holz der Hobbitpfeife ist von ausgezeichneter Qualitaet.");
  
  AddDetail(({"verzierungen", "verzierung","schnitzerei","schnitzereien"}), 
	    CLOSURE(huefe));
  
  AddCmd("horeport", "Report");
  
  //Kommandos fuer die Hobbitkommunikation
  
  AddCmd(({"horuf","horufe"}), "Rufen");
  AddCmd(({"hohist","hohistory"}), "History");
  AddCmd(({"howink","howinke"}), "howink");
  AddCmd(({"hoknuddel","hoknuddle","hoknuddele"}), "hoknuddel");
  AddCmd(({"howuschel","howuschle","howuschele"}), "howuschel");
  AddCmd(({"hoprost","hoproste"}), "hoproste");
  AddCmd(({"homahlzeit"}), "homahlzeit");
  
  AddCmd(({"hoinfo"}), "hoinfo");
  AddCmd(({"hower"}), "hower");
  AddCmd(({"hofarbe","hofarben"}), "hofarbe");
  
  AddCmd(({"hopresay"}), "hopresay");
  
  AddCmd(({"hohilfe"}), "hohilfe");


  // Pfeife funs

  AddCmd(({"stopfe","stopf"}), "fktstopfen");
  AddCmd(({"rauche","rauch"}), "fktrauchen");

  pfeifegestopft_blatt=0;
  pfeifegestopft_kraut=0;
  pfeifegestopft_stern=0;
  pfeifegestopft_pflanze=0;
  pfeifeangezuendet=0;
  
  GetColor(1);
  
  SUID;
  
  // r* commands:
  init_soul_cmds(1);
}

string info()
{
  if((MENV) && (query_once_interactive(MENV)))
    if(present("universal-teddy", MENV))
      return BS("Das ist sicher keine gewoehnliche Pfeife.")+
	BS("Sie passt doch wesentlich besser zu einem Hobbit als so "
	   "ein Teddy. Dieser wuerde die Hobbitpfeife zudem nur negativ "
	   "beeinflussen.");
  
  return BS("Das ist sicher keine gewoehnliche Pfeife.")+
    BS("Das Holz der Hobbitpfeife glaenzt geheimnisvoll.");
}

string Master()
{
  return RTM "pfeifenmaster";
}

string Rasse()
{
  return "Hobbit";
}

string IgnoriereID()
{
  return "gradopfeife";
}

string absolut_fit()
{
  return "Du bist nun wieder absolut fit.";
}

string Report_normal(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* Du hast nun ";
  
  if(hp==maxhp)
    ret+="volle Lebenspunkte und ";
  else
    ret+=""+hp+" von "+maxhp+" Lebenspunkte und ";
  
  if(sp==maxsp)
    ret+="volle Magiepunkte.";
  else
    ret+=""+sp+" von "+maxsp+" Magiepunkte.";
  
  return ret;
}

string Report_kurz(int hp, int maxhp, int sp, int maxsp)
{
  string ret;
  
  ret="* ";
  
  if(hp==maxhp)
    ret+="LP: "+hp+" und ";
  else
    ret+="LP: "+hp+" von ("+maxhp+") und ";
  
  if(sp==maxsp)
    ret+="MP: "+sp;
  else
    ret+="MP: "+sp+" von ("+maxsp+")";
  
  return ret;
}

string Region(string str)
{
  if(strstr(str, "/d/huegelland/raballion/hobbits")==0)
    return "Derlim";

  if(strstr(str, "/d/huegelland/orw/pfeifenladen")==0)
    return "Elessar";

  return "";
}

string Erneuern_Meldung()
{
  return BS(""C"Deine Pfeife beginnt sich zu veraendern..."N"");
}

string History_leer()
{
  return BS("In letzter Zeit war es recht ruhig...");
}

string History_msg()
{
  return "";
}

string History_format()
{
  return "rief Dir zu: ";
}

string Rufen_syntax()
{
  return BS("Was willst Du den anderen Hobbits zurufen?");
}

string Rufen_format()
{
  return "ruft Dir zu: ";
}

string Rufen_msg()
{
  return "Du rufst den Hobbits zu: ";
}


varargs nosave string huefe(int flag)
{
  string ret, rcmds;
  int i;
  
  rcmds="";
  
  if(IS_SEER(TP))
    {
      for(i=sizeof(soulcmds)-1;i>=0;i--)
	if(i==0)
	  rcmds+="und "+soulcmds[i][0]+".";
	else
	  rcmds+=soulcmds[i][0]+", ";
      
      rcmds=break_string(rcmds, 60, " ", BS_NO_PARINDENT);
    }
  else
    {
      for(i=sizeof(soulcmds)-1;i>=0;i--)
	if(i==0)
	  rcmds+="und "+soulcmds[i][0]+"("+soulcmds[i,2]+").";
	else
	  rcmds+=soulcmds[i][0]+"("+soulcmds[i,2]+"), ";
      
      rcmds=break_string(rcmds, 60, " ", BS_NO_PARINDENT);
      
      
      rcmds+="Die Zahlen in den Klammern sind die Magiekosten.\n \n";
      
    }
  
  ret="\n \n"
    "Grados Hobbitpfeife kann Dir anzeigen, wie es um Deine\n"
    "Lebensenergie und Zauberkraft bestellt ist.\n \n"
    "Der Befehl dazu lautet:\n"
    " 'horeport [ein|kurz|farbe|farbekurz|aus]'\n \n"
    "Grados Hobbitpfeife bietet Dir weiters folgende RVerben an:\n\n"+
    rcmds+
    "\nEinige Befehle nur fuer Hobbits:\n"
    " 'hower, hoinfo, hofarbe, hopresay'\n \n"
    "RVerben nur fuer Hobbits:\n"
    " 'howinke, hoknuddel, hoprost, homahlzeit'\n\n"
    "Hilfe zu den Befehlen erhaelst Du mit:\n"
    " 'hohilfe'\n \n"
    "                                                         Ver 1."+Version()+"\n";
  if(flag) return ret;
  
  TP->More(make_document(ret));
  return "";
}

nosave int hohilfe(string str)
{
  string ret;
  
  if(str) str=explode(str, " ")[0];
  
  switch(str)
    {
    case "horeport": 
      ret="Der 'horeport' informiert Dich, wie es um Deine "
	"Lebensenergie und Zauberkraft bestellt ist.\n"
	"Moegliche Einstellungen sind:\n"
	"* horeport normal    - Schaltet den Report normal ein.\n"
	"* horeport kurz      - Schaltet den Report kurz ein.\n"
	"* horeport farbe     - Schaltet den Report in Farbe ein.\n"
	"* horeport farbekurz - Schaltet den Report faerbig und\n"
	"                       kurz ein.\n"
	"* horeport aus       - Schaltet den Report wieder aus.\n";
      break;
    case "hoinfo": 
      ret="In 'hoinfo' hast Du eine eher zu Hobbits passende Version\n"
	"der normalen Infoanzeige bei 'info'.\n"
	"Mit 'hofarbe' kannst Du die Anzeige sogar in wunderschoenen\n"
	"Farben darstellen lassen.\n"
	"Einige unwichtige Angaben werden im Normalfall unterdrueckt.\n";
      break;
    case "hower": 
      ret="Mit 'hower' siehst Du, wer aus dem Hobbitsvolk anwesend ist.\n"
	"*  Wer ist anwesend?\n"
	"*  Ist er/sie anwesend, oder idle?\n"
	"*  Was fuer eine Waffe hat er/sie gezueckt?\n"
	"*  Welche Gesinnung hat er/sie?\n"
	"*  Wo befindet er/sie sich?\n\n"
	"Mit 'hower kurz' siehst Du das ganze etwas kompakter.\n";
      break;
    case "hofarben":
    case "hofarbe": 
      ret="Mit '"+str+" ein|aus' kannst Du die Farbanzeige einstellen.\n";
      break;
    case "horuf": 
    case "horufe": 
      ret="Mit '"+str+"' hast Du die Moeglichkeit, den anderen Hobbits\n"
	"etwas mitzuteilen, ohne dass andere Rassen mithoeren koennen.\n"
	"Mit 'hohist' kannst Du die Rufe nocheinmal lesen.\n";
      break;
    case "hohist": 
      ret="Mit 'hohist' kannst Du versuchen, die Echos der zuletzt\n"
	"gerufenen Meldungen zu erhaschen...\n"
	"Jedoch ist die Liste in ihrer Groesse beschraenkt.\n";
      break;
    case "howinke":
    case "howink": 
      ret="Mit '"+str+"' kannst Du den anderen Hobbits zuwinken.\n"; 
      break;
    case "hoknuddel":
    case "hoknuddle":
    case "hoknuddele": 
      ret="Mit '"+str+"' kannst Du die anderen Hobbits alle knuddeln.\n"; 
      break;
    case "hoprost":
    case "hoproste": 
      ret="Mit '"+str+"' kannst Du allen anderen Hobbits zuprosten.\n"; 
      break; 
    case "homahlzeit": 
      ret="Mit '"+str+"' kannst Du allen anderen Hobbits einen guten Appetit wuenschen.\n"; 
      break;  
    case "hopresay":
      ret="Mit 'hopresay' kannst Du Dir Dein Hobbits-Presay, welches\n"
	"z.B. bei 'hower' gezeigt wird, permanent als Presay setzen.\n\n"
	"Mit 'hopresay loeschen' kannst Du Dein Presay entfernen.\n";      
      break;
    case "allgemein":
      ret=huefe(1);
      break;
    case "ignoriere":
    case "ignorieren":
      ret=ignorieren_hilfe_text();
      break;
    default: 
      ret="Mit 'hohilfe' kannst Du Dich ueber Folgendes informieren:\n \n"
	"hohilfe <horeport>   Wie sieht es mit Leben u. Magie aus?\n"
	"        <hoinfo>     Ein etwas anderes 'info'.\n"
	"        <hower>      Eine Liste aller anwesenden Hobbits.\n"
	"        <hofarbe>    Farbeinstellungen?\n"
	"        <hopresay>   Das Hobbitspresay fix setzen.\n"
	"        <horufe>     Den anderen Hobbits etwas zurufen?\n"
	"        <hohist>     Wer hat den Hobbits etwas zugerufen?\n"
	"        <howink>     Winkt den anwesenden Hobbits zu.\n"
	"        <hoprost>    Prostet den anwesenden Hobbits zu.\n"
	"        <homahlzeit> 'Guten Appetit' an alle anwesenden Hobbits.\n"
	"        <hoknuddel>  Knuddelt alle anwesenden Hobbits.\n"
	"        <allgemein>  Allgemeine Uebersicht.\n"
	"        <ignoriere>  Uebersicht der Ignorieremoeglichkeiten.\n";
    }
  return TP->More(make_dokument(ret)),1;
}

string Titel(object pl)
{
  string ret;
  
  // Jaja muss sein ;)
  if(getuid(pl)=="andyl")
    return "Hobbitsoundmagier ";

  if(getuid(pl)=="protheg")
    return "Drowmagier ";
  
  if(!pl->QueryProp(Listener()))
    if(!present(RACETOOLID, pl))
      return "";
    else
      pl->SetProp(Listener(), 1);
  
  if(pl->QueryProp(P_FROG))
    return "";
  
  if(IS_WIZARD(pl))
    return "Hobbitmagier"+FM(pl,"in "," ");

  ret="Hobbit";

  if(pl->QueryProp(P_GUILD)=="druidenzirkel")
    return ret+"druid"+FM(pl,"in ","e ");
  
  if(pl->QueryProp(P_GUILD)=="zechpreller")
    return ret+"zechpreller"+FM(pl,"in "," ");
  
  if(pl->QueryProp(P_GUILD)=="berserker")
    return ret+"berserker"+FM(pl,"in "," ");
  
  if(pl->QueryProp(P_GUILD)=="paladine")
    return ret+"paladin ";
  
  if(pl->QueryProp(P_GUILD)=="bardengilde")
    return ret+"bard"+FM(pl,"in ","e ");

  if(pl->QueryProp(P_GUILD)=="nekromanten")
    return ret+"nekromant ";
    
  return ret+FM(pl,"dame "," ");
}

nosave string Hunger(int food, int max_food, int drink, int max_drink)
{
  string ret;
  int f, d;
  
  f=food*100/max_food;
  d=drink*100/max_drink;

  // HUNGER: 00-10: extrem hungrig, 11-20: ausgesprochen hungrig, 21-30: ziemlich hungrig, 31-40: sehr hungrig, 41-50: hungrig, 
  // HUNGER: 51-60: noch hungrig, 61-70: kaum hungrig, 71-80: beinahe gesaettigt, 81-90: gesaettigt, 91-99: satt, 100: absolut voll. 
  
  // DURST: 00-10: extrem durstig, 11-20: ausgesprochen durstig, 21-30: ziemlich durstig, 31-40: sehr durstig, 41-50: durstig, 
  // DURST: 51-60: noch durstig, 61-70: kaum durstig, 71-80: fast nicht durstig, 81-90: ueberhaupt nicht durstig, 91-99: voll, 100: absolut voll 
  
  ret="Du bist ";
  
  switch(f)
    {
    case 11 ..  20 : ret+="ausgesprochen hungrig"; break;
    case 21 ..  30 : ret+="ziemlich hungrig"; break;
    case 31 ..  40 : ret+="sehr hungrig"; break;
    case 41 ..  50 : ret+="hungrig"; break;
    case 51 ..  60 : ret+="noch hungrig"; break;
    case 61 ..  70 : ret+="kaum hungrig"; break;
    case 71 ..  80 : ret+="beinahe gesaettigt"; break;
    case 81 ..  90 : ret+="gesaettigt"; break;
    case 91 .. 100 : ret+="voll angegessen"; break;
    default : ret+="extrem hungrig"; break;
    }
  
  if((f < 50 && d > 50) ||
     (f > 50 && d < 50))
    ret+=" aber ";
  else 
    ret+=" und ";
  
  switch(d)
    {
    case 11 ..  20 : ret+="ausgesprochen durstig"; break;
    case 21 ..  30 : ret+="ziemlich durstig"; break;
    case 31 ..  40 : ret+="sehr durstig"; break;
    case 41 ..  50 : ret+="durstig"; break;
    case 51 ..  60 : ret+="noch durstig"; break;
    case 61 ..  70 : ret+="kaum durstig"; break;
    case 71 ..  80 : ret+="fast nicht durstig"; break;
    case 81 ..  90 : ret+="ueberhaupt nicht durstig"; break;
    case 91 .. 100 : ret+="voll angetrunken"; break;
    default : ret+="extrem durstig"; break;
    }
  
  return ret+".";
}

nosave int hopresay(string str)
{
  string np, op;

  notify_fail(BS("Du kannst mit 'hopresay' nur das Hobbit-Presay setzen!")+
	      BS("Du kannst aber auch mit 'hopresay loeschen' das Presay "
		 "loeschen."));

  if(strlen(str)) 
    if(str=="loeschen")
      {
	if(!strlen(TP->QueryProp(P_PRESAY)))
	  return write(BS("Du hattest doch gar kein Presay gesetzt!?")), 1;
	
	TP->SetProp(P_PRESAY, "");
	
	return write(BS("Dein Presay wurde geloescht.")), 1;
      }
    else
      return 0;

  
  np=Titel(TP);
  
  if(strlen(op=TP->QueryProp(P_PRESAY)))
    if(np!=op)
      write(BS("Dein voriges Presay '"+op+"' wird ersetzt."));
  
  TP->SetProp(P_PRESAY, np[0..<2]);
  
  write(BS("Du bist nun:")+
	BS(np+CAP(getuid(TP))+" "+(TP->QueryProp(P_TITLE) || "")));
  
  return 1;
}

nosave int hofarbe(string str)
{
  notify_fail(BS("Syntax: hofarbe ein|aus"));
  if(!str) return 0;
  
  if(str=="aus")
    {
      Setting(0); 
      return write(BS("Die Hobbitpfeife zeigt Dir jetzt 'hoinfo' in Schwarz/Weiss.")), 
	1;
    }

  if(str=="ein")
    {
      Setting(1); 
      return write(BS("Die Hobbitpfeife zeigt Dir jetzt 'hoinfo' in Farbe.")), 1;
    }
  
  return 0;
}

nosave int hoinfo(string str)
{
  object tp;
  mapping at;
  int xp;
  
  tp=TP;

  if(tp->QueryProp(P_GHOST))
    return write(BS("Geister haben keine Punkte!")), 1;
  
  at=tp->QueryProp(P_ATTRIBUTES);
  
  if(!xpdiff) xpdiff=tp->QueryProp(P_XP);
  
  xp=tp->QueryProp(P_XP);
  
  write(sprintf(
    " "G"+-----"N"\n"
    " "G"|"N" %45.45-s  %23s\n"
    " "G"|"N"\n"
    "   Leben: %s           "W" ~~ ~"N"\n"
    "   Magie: %s          "W"~ ~"N"\n"
    "                                      "C"____"N"                      "W"~~~"N"\n"
    "   Erfahrung:        %10d      "C"(___ `-._"N"                "W"_____"N"\n"
    "   %28.28s          "C"`-._ `-._          ."W"'-----`"C"."N"\n"
    "   Abenteuer:       %4d [%4d]              "C"`-._ `-._     ."G"=-=-=-=-="C"."N"\n"
    "   Stufe: %21s  %11s     "C"`._ /`-..-"G"=-=-=-=-=-"C"|"N"\n"
    "   ____________________________                     "C"`-._             |"N"\n"
    "                                                         "C"`-.._______.'"N"\n"
    "   Intelligenz:         %8-s  %-s\n"
    "   Ausdauer:            %8-s  %-s\n"
    "   Kraft:               %8-s  %-s\n"
    "   Geschicklichkeit:    %8-s  %-s\n"
    "\n"
    " "G"|"N" %70-s "G"|"N"\n"
    " "G"|"N" %70-s "G"|"N"\n"
    " "G"+-----                                                              -----+"N"\n",
    
    Titel(tp)+CAP(getuid(tp)),
    CAP(tp->QueryProp(P_GUILD))+" ["+tp->QueryProp(P_GUILD_LEVEL)+"]",
    Balken(tp->QueryProp(P_HP), tp->QueryProp(P_MAX_HP), setting, 
	   tp->QueryProp(P_WIMPY),45),
    Balken(tp->QueryProp(P_SP), tp->QueryProp(P_MAX_SP), setting,0,45),
    xp, (xp-xpdiff ? "Unterschied:      "+sprintf("%10d",xp-xpdiff) : ""), 
    tp->QueryProp(P_QP), QM->QueryAllQP(), 
    Stufenpunkte(tp), Gesinnung(tp),
    sprintf("%2d [%2+d]", at[A_INT], tp->QueryAttributeOffset(A_INT)), 
    Zustand(tp)[1..],
    sprintf("%2d [%2+d]", at[A_CON], tp->QueryAttributeOffset(A_CON)), 
    Erschoepfung(tp),
    sprintf("%2d [%2+d]", at[A_STR], tp->QueryAttributeOffset(A_STR)), 
    Gewicht(tp),
    sprintf("%2d [%2+d]", at[A_DEX], tp->QueryAttributeOffset(A_DEX)),
    (tp->QueryMoney() ? tp->QueryMoney()+" Muenzen" : ""),
    Hunger(tp->QueryProp(P_FOOD), tp->QueryProp(P_MAX_FOOD), 
	   tp->QueryProp(P_DRINK), tp->QueryProp(P_MAX_DRINK)),
    (tp->QueryProp(P_WIMPY) ? (sprintf("Vorsicht: %3d", 
				       tp->QueryProp(P_WIMPY))+
			       (tp->QueryProp(P_WIMPY_DIRECTION) ? 
				" Ri: "+tp->QueryProp(P_WIMPY_DIRECTION):"")):
     "")));
  
  GetColor(1);
  return 1;
}

nosave int howink(string str)
{
  object *hobbits;
  string me;
  int i;
  
  if(TP->QueryProp(P_INVIS)) 
    return write(BS("Das geht nur, wenn Du sichtbar bist!!")),1;
  
  hobbits=Alle_Anwesenden(TP);
  
  me=Titel(TP)+CAP(getuid(TP));
  
  if(!str) str="";  
  if(str[0]=='/') 
    str=str[1..<1]+" ";
  else
    str="";
  
  for(i=sizeof(hobbits)-1;i>=0;i--)
    tell_object(hobbits[i], BS(me+" winkt allen Hobbits "+str+"aus der Ferne zu."));
  
  write(BS("Du winkst allen Hobbits "+str+"aus der Ferne zu."));

  return 1;
}

