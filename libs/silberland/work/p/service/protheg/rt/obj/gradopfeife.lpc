{
  if(raucher)
    {
      write(BS("Deine Augen werden muede, Dein Atem wird immer regelmaessiger "
	       "und die Welt um Dich herum scheint zu verschwimmen."));
      say(BS(raucher->name()+" bewegt sich immer langsamer."));

      call_out("pflanzerauchen6", 25+random(5),raucher);
    }
  else
    {
      pfeifeangezuendet=0;
      return 1;
    }
}

