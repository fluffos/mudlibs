nosave int homahlzeit(string str)
{
  object *hobbits;
  string me;
  int i;

  if(TP->QueryProp(P_INVIS)) 
    return write(BS("Das geht nur, wenn Du sichtbar bist!!")),1;

  hobbits=Alle_Anwesenden(TP);
  
  me=Titel(TP)+CAP(getuid(TP));

  if(!str) str="";  
  if(str[0]=='/') 
    str=str[1..<1]+" ";
  else
    str="";
  
  for(i=sizeof(hobbits)-1;i>=0;i--)
    tell_object(hobbits[i], BS(me+" wuenscht allen Hobbits einen guten Appetit "+str+"aus der Ferne."));
  
  write(BS("Du wuenscht allen Hobbits einen guten Appetit "+str+"aus der Ferne."));

  return 1;
}

int hower(string str)
{
  if(str && str!="kurz")
    return write(BS("Nimwer [kurz]")), 1;
  
  TP->More(make_document(who_list("Folgende Hobbits sind anwesend:\n",
				  strlen(str))));

  return 1;
}

void hau_ab(object who)
{
  tell_object(who, BS("Als Du die Hobbitpfeife beruehrst, loest "
		      "sie sich ploetzlich auf..."));

  call_out("remove", 0);
}

// Pfeifenfunktionen
// Uebernommen aus Orws Pfeifenwerkstatt
nosave int fktstopfen(string str)
{
  string was;
  string wohinein;
  object kr;
  
  notify_fail("Was willst Du wo reinstopfen?!\n");
  if(!str) return 0;
  
  if(sscanf(str, "%s in %s", was, wohinein)!=2 &&
     sscanf(str, "%s mit %s", wohinein, was)!=2)
    return 0;
  
  wohinein=explode(wohinein," ")[0];
  
  if(member(({"pfeife","hobbitpfeife"}), wohinein)==-1)
    return 0;

  if(pfeifegestopft_blatt || pfeifegestopft_kraut ||
     pfeifegestopft_stern || pfeifegestopft_pflanze)
    return write(BS("Die Pfeife ist doch schon gestopft!")), 1;

  // Pfeife mit Langgrundblatt stopfen
  if(was=="langgrundblatt" || was=="grundblatt" || was=="blatt")
    {
      if(kr=present("PFEIFENKRAUTBLATT",TP))
	{
	  write(BS("Du stopfst das Langgrundblatt in Grados Hobbitpfeife."));
	  say(BS(TPN+" stopft eine kleine Pfeife."));
	  
	  pfeifegestopft_blatt=1;
	  kr->remove();
	  return 1;
	}
      else
	return write(BS("Mit welchem Langgrundblatt?")), 1;
    }

  // Pfeife mit Grottenkraut stopfen
  if(was=="grottenkraut" || was=="kraut")
    {
      if(kr=present("PFEIFENKRAUTKRAUT",TP))
        {
          write(BS("Du stopfst das Grottenkraut in Grados Hobbitpfeife."));
          say(BS(TPN+" stopft eine kleine Pfeife."));

          pfeifegestopft_kraut=1;
          kr->remove();
          return 1;
        }
        else
	  return write(BS("Mit welchem Grottenkraut?")), 1;
      }
  
  // Pfeife mit Suedstern stopfen
  if(was=="suedstern" || was=="stern")
    {
      if(kr=present("PFEIFENKRAUTSTERN",TP))
        {
          write(BS("Du stopfst den Suedstern in Grados Hobbitpfeife."));
          say(BS(TPN+" stopft eine kleine Pfeife."));

          pfeifegestopft_stern=1;
          kr->remove();
          return 1;
        }
        else
	  return write(BS("Mit welchem Suedstern?")), 1;
    }
  
  // Pfeife mit Nakrafulpflanze stopfen
  if(was=="nakrafulpflanze" || was=="pflanze")
    {
      if(present("PFEIFENKRAUTPFLANZE_1",TP))
        {
          write(BS("Du stopfst die zerriebene Nakrafulpflanze in Grados Hobbitpfeife."));
          say(BS(TPN+" stopft eine kleine Pfeife."));

          pfeifegestopft_pflanze=1;
          kr->remove();
          return 1;
        }
      
      if(present("PFEIFENKRAUTPFLANZE_0",TP))
	return write(BS("Du solltest die Nakrafulpflanze vorher zerreiben.")), 1;
      else
	return write(BS("Mit welcher Nakrafulpflanze?")), 1;
    }
  
  write(BS("Sowas kannst Du nicht in Grados Hobbitpfeife stopfen!"));
  return 1;
}

// Uebernommen aus Orws Pfeifenwerkstatt
nosave int fktrauchen(string str)
{
  notify_fail(BS("Was willst Du rauchen?!")); 
  if(!str) return 0;
  
  if(!id(str)) return 0;
  
  if(pfeifeangezuendet)
    return write(BS("Du rauchst doch schon Deine Pfeife!")), 1;
  
  // Pfeife gestopft mit Langgrundblatt
  if(pfeifegestopft_blatt)
    {
      write(BS("Gemuetlich zuendest Du Dir Deine Pfeife an."));
      say(BS(TPN+" zuendet sich gemuetlich eine Pfeife an."));
      
      SetProp(P_NODROP, "Aber Grados Hobbitpfeife brennt doch gerade!\n");
      
      pfeifeangezuendet=1;
      
      call_out("blattrauchen1", 15+random(5), TP);
      return 1;
    }
  
  // Pfeife gestopft mit Grottenkraut
  if(pfeifegestopft_kraut)
    {
      write(BS("Gemuetlich zuendest Du Dir Deine Pfeife an."));
      say(BS(TPN+" zuendet sich gemuetlich eine Pfeife an."));
      
      SetProp(P_NODROP, "Aber Grados Hobbitpfeife brennt doch gerade!\n");
      
      pfeifeangezuendet=1;
      
      call_out("krautrauchen1", 15+random(5),TP);
      return 1;
    }
  
  // Pfeife gestopft mit Suedstern
  if(pfeifegestopft_stern)
    {
      write(BS("Gemuetlich zuendest Du Dir Deine Pfeife an."));
      say(BS(TPN+" zuendet sich gemuetlich eine Pfeife an."));
      
      SetProp(P_NODROP, "Aber Grados Hobbitpfeife brennt doch gerade!\n");
      
      pfeifeangezuendet=1;
      
      call_out("sternrauchen1", 15+random(5),TP);
      return 1;
    }
  
  // Pfeife gestopft mit einer Nakrafulpflanze
  if(pfeifegestopft_pflanze)
    {
      write(BS("Gemuetlich zuendest Du Dir Deine Pfeife an."));
      say(BS(TPN+" zuendet sich gemuetlich eine Pfeife an."));
      
      SetProp(P_NODROP, "Aber Grados Hobbitpfeife brennt doch gerade!\n");
      
      pfeifeangezuendet=1;
      
      call_out("pflanzerauchen1", 15+random(5),TP);
      return 1;
    }
  
  write(BS("Du musst Grados Hobbitpfeife vorher stopfen um sie rauchen zu koennen!"));
  return 1;
}


// Blattrauchen
int blattrauchen1(object raucher)
{
  if(objectp(raucher))
    {
      write(BS("Kleine Rauchwoelkchen kommen aus Deiner Pfeife und Du "
	       "fuehlst Dich so richtig wohl."));
      say(BS(raucher->name()+" fuehlt sich richtig wohl."));
      
      if(raucher->QueryProp(P_RACE)=="Hobbit")
	raucher->heal_self(pfeifenwert);

      call_out("blattrauchen2", 25+random(5),raucher);
    }
  else
    {
      pfeifeangezuendet=0;
      return 1;
    }
}

