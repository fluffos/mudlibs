#include <language.h>
#include <properties.h>
#include "/mail/post.h"

inherit "/std/thing";
string index;

create() {
  (::create());
  SetProp(P_NAME,"Briefmarke");
  SetProp(P_GENDER,FEMALE);
  AddId("marke");
  AddId("briefmarke");
  SetProp(P_VALUE,10);
  SetProp(P_WEIGHT,1);
  index="20";
}

short() {
  return "Eine "+(QueryUsed() ? "gestempelte " : "")+
    STAMPSERV->QueryStampPrice(index)+"-Muenzen- '"+
      STAMPSERV->QueryStampName(index)+ "' - Briefmarke\n";
}

long() {
  return break_string(short()[0..<2]+".\
 Unter der Wertangabe zeigt die Marke "+STAMPSERV->QueryStampShort(index)+". "+
     STAMPSERV->QueryStampLong(index),70,0,1);
}

SetIndex(str) {
  index=str;
  AddId(STAMPSERV->QueryStampName(index)+ " - briefmarke");
}

QueryIndex() {
  return index;
}

QueryUsed() {
  return (index[0]=='@');
}

_query_value() {
   if (QueryUsed()) return 0;
  return STAMPSERV->QueryStampPrice(index);
}
