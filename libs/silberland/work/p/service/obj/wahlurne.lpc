inherit "std/secure_thing";

#include "/secure/wizlevels.h"
#include <language.h>
#include <defines.h>
#include <moving.h>
#include <properties.h>
#include <ansi.h>

#define TI this_interactive()
#define TP this_player()
#define PO previous_object
#define SAVEFILE "/p/service/save/wahl/wahl"

nosave string in_use;
nosave int lastuse;

private string thema;
private string *moeglichkeiten;
private mapping ergebnis;

#undef SAY

nosave SAY( str )
{
  write ( str );
  // say ( str );
  log_file( "WAHL", str );
}

void create()
{
  int i;
  if (is_clone(this_object())) destruct(this_object());
  if (ergebnis) return 0;
  seteuid(getuid(this_object()));
  ::create();
  AddId("urne");
  AddId("wahlurne");
  SetProp(P_SHORT,"Eine Wahlurne");
  SetProp(P_NAME,"Wahlurne");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOGET, 1);
  in_use=0;
  thema=0;
  ergebnis=([]);
  moeglichkeiten=({});
  restore_object(SAVEFILE);
  move("/gilden/abenteurer");
}

int move(mixed dest, int method)
{
  if ((stringp(dest) && dest!="/gilden/abenteurer") &&
      (objectp(dest) && dest!=find_object("/gilden/abenteurer")) )
    return ME_CANT_BE_TAKEN;
  else
    return ::move(dest,method);
}

string long()
{
  string h,n;
  if (TP)
    if (TP->QueryProp(P_TTY)=="vt100")
      h=ANSI_BOLD, n=ANSI_NORMAL;
    else if (TP->QueryProp(P_TTY)=="ansi")
      h=ANSI_CYAN, n=ANSI_NORMAL;
    else
      h=n="";

  return
    "Eine Wahlurne. Mit ihr koennen geheime Wahlen durchgefuehrt werden.\n" +
    ((TP==TI) && IS_ARCH(TI) ?
     h + "Moegliche Befehle:" + n +
     "\n waehle, auswertung, wahlthema, moeglichkeit.\n" :
     "Mit '"+h+"waehle"+n+"' kannst Du Deine Wahl treffen.\n")+
    h+"Aktuelles Thema:"+n+"\n "+(stringp(thema) ? thema : "keines")+"\n"+
    (thema && sizeof(moeglichkeiten) ?
     h+"Wahlmoeglichkeiten:"+n+"\n "+
     implode (moeglichkeiten, "\n ")+"\n" : "");
}

void save_me()
{
  save_object(SAVEFILE);
}

void init()
{
  ::init();
  add_action("waehle", "waehl",1);
  if (!TP || (TP!=TI) || !IS_ARCH(TP)) return;
  add_action("auswertung","auswertung");
  add_action("wahlthema", "wahlthema");
  add_action("moeglichkeit","moeglichkeit");
}

int wahlthema(string str)
{
  if (!IS_ARCH(TI))
  {
    write("NOT allowed!\n");
    return 1;
  }
  if (!(str=this_interactive()->_unparsed_args())) return 0;
  thema=str;
  say(TI->Name(WER)+" setzt ein neues Abstimmungsthema fest.\n");
  ergebnis=([]);
  moeglichkeiten=({});
  write("Ok.\n");
  save_me();
  return 1;
}

int moeglichkeit(string str)
{
  if (!IS_ARCH(TI))
  {
    write("NOT allowed!\n");
    return 1;
  }
  if (!(str=TI->_unparsed_args()))
  {
    write(
     "Syntax: 'moeglichkeit <mglkt>' zum Hinzufuegen, oder\n"+
     "        'moeglichkeit -<mglkt>' zum Entfernen einer Wahlmoeglichkeit.\n"+
     "        'moeglichkeit ---' zum Entfernen aller Wahlmoeglichkeiten.\n");
    return 1;
  }
  if (str=="---")
  {
    moeglichkeiten=({});
    write("Ok.\n");
    save_me();
    return 1;
  }
  if (member_array(str, moeglichkeiten) != -1)
  {
    write("Schon drin.\n");
    return 1;
  }
  if (str[0]=='-')
  {
    str=str[1..];
    if (member_array(str, moeglichkeiten) == -1)
    {
      write("Nicht drin.\n");
      return 1;
    }
    moeglichkeiten-=({str});
  }
  else
    moeglichkeiten+=({str});
  write("Ok.\n");
  save_me();
  return 1;
}

int waehle()
{
  int i, n;
  
  if (!TI) return 0;
  if (TI != TP)
  {
    write("Illegal. Lass Dich bloss zu nix zwingen!\n");
    tell_object(TI, "Lass das!\n");
    return 1;
  }
  if (!thema)
  {
    notify_fail("Es steht doch noch gar kein Thema fest!\n");
    return 0;
  }
  if (TP->QueryProp(P_AGE) < 43200)
  {
    notify_fail("Wahlberechtigt sind nur Spieler, "
        "die aelter als einen Tag sind!\n");
    return 0;
  }
  if (TP->QueryProp(P_SECOND) || TP->QueryProp(P_TESTPLAYER))
  {
    notify_fail("Zweit- und Testspieler sind nicht wahlberechtigt!\n");
    return 0;
  }
  if (TP->QueryProp(P_LEVEL) < 10)
  {
    notify_fail("Man kann erst ab Stufe 10 mitwaehlen.\n");
    return 0;
  }
  if (in_use)
  {
    if (time() > lastuse+120)
      write(in_use+" hat sich zulange Zeit gelassen, "
          "Du kannst daher waehlen.\n");
    else
    {
      if (in_use!=capitalize(getuid(TP)))
        write(in_use+" waehlt gerade, warte also bitte einen Augenblick.\n");
      else
        write("Aber Du waehlst doch schon!\n");
      return 1;
    }
  }
  in_use=capitalize(getuid(TP));
  lastuse=time();
  say(in_use+" tritt an die Wahlurne.\n");
  write ("Du trittst bedaechtig an die Wahlurne heran.\n\n");
  write ("Aktuelles Thema:" +
      (strlen(thema) > 61 ? "\n" + break_string(thema,78) : " " + thema) +
      "\n");
  n=sizeof(ergebnis);
  write ("Bisher "+(n<2 ? "hat " : "haben ")+
    (n ? "bereits "+n : "noch kein")+" Spieler gewaehlt.\n\n");
  write ("Folgende Moeglichkeiten stehen Dir zur Auswahl zur Verfuegung:\n\n");
  // for (i=0;i<sizeof(moeglichkeiten);i++)
  //   write(sprintf(" -- %d.) %s\n",i+1,moeglichkeiten[i]));
  for (i=0;i<sizeof(moeglichkeiten);i++)
    write(sprintf("  %3d: %-30s\n",i+1,moeglichkeiten[i]));
  if (member(ergebnis, getuid(TP)))
    write("\nDeine bisherige Wahl: "+ergebnis[getuid(TP)]+"\n");
  write("\nTriff nun Deine (erneute) Wahl (sie ist UNSICHTBAR): ");
  input_to("waehle_2",1);
  return 1;
}

nosave int falsch(int r)
{
  switch (r)
  {
    case 1:
      write("Du hast Dich entschieden, doch nicht zu waehlen.\n");
      break;
    case 3:
      write("Diese Wahlmoeglichkeit gibt es nicht! "
            "Versuchs bitte gleich nochmal.\n");
      break;
    default:
      write("Diese Auswahl ist ungueltig. Versuchs bitte gleich nochmal.\n");
      break;
  }
  say(in_use + " hat " + TP->QueryPossPronoun(FEMALE,WEN) +
               " Wahl abgebrochen.\n");
  in_use=0;
  return 1;
}

nosave int waehle_2(string str)
{
  int i;

  if ((!str) || (!strlen(str)) || (str=="q") || (str=="~q"))
    return falsch(1);

  if (TI != TP)
  {
    write("Illegal. Lass Dich bloss zu nix zwingen!\n");
    tell_object(TI, "Lass das!\n");
    in_use=0;
    return 1;
  }
  if (in_use!=capitalize(getuid(TP)))
  {
    write("Ojeh, Du hast Dir zulange Zeit gelassen...\n"+
        "Versuchs bitte nochmal!\n");
    return 1;
  }
  if (member_array(str, moeglichkeiten)==-1)
  {
    if ( !sscanf( str, "%d", i ) ) return falsch(2);
    if ( i<1 || i>sizeof(moeglichkeiten) ) return falsch(3);
    ergebnis+=([getuid(TP):moeglichkeiten[i-1]]);
  }
  else
    ergebnis+=([getuid(TP):str]);
  write("Ok.\n");
  write("Wenn Du Deine Auswahl aendern willst, waehle einfach nochmal,\n"+
        "Deine erneute Wahl ersetzt dann die eben erfolgte.\n");
  save_me();
  say(in_use+" hat ausgewaehlt.\n");
  in_use=0;
  return 1;
}

int auswertung()
{
  int i,j,n,max;
  int *stimmen;
  string *s, *maxs, *ind;

  if (!TP || (TP!=TI) || !IS_ARCH(TP))
  {
    write("NOT allowed!\n");
    return 1;
  }
  n=sizeof(moeglichkeiten);
  stimmen=allocate(n+1);
  ind=m_indices(ergebnis);
  SAY("\n---------------------------------------------------------------------------\n");
  SAY("Wahlergebnisse zum Thema: "+thema+"\n");
  SAY("---------------------------------------------------------------------------\n");
  SAY("Gewaehlt haben folgende Personen: \n");
  // for (i=0;i<sizeof(ergebnis[0]);i++)
  //   SAY(capitalize(ergebnis[0][i])+"\n");
#ifdef DEBUG
  tell_object(find_player("woody"), sprintf("%O\n", ind));
  tell_object(find_player("woody"), sprintf("%O\n", ergebnis[0]));
#endif
  SAY (break_string( implode(
    map_array( sort_array(ind, #'>), #'capitalize), ", "), 75, "  "));
  max=0;
  maxs=({});
  for (i=0;i<sizeof(ergebnis);i++)
  {
    j=member_array(ergebnis[ind[i]],moeglichkeiten);
    if (j==-1) 
      stimmen[n]++;
    else
    {
      stimmen[j]++;
      if (max<stimmen[j])
      {
        maxs=({moeglichkeiten[j]});
        max=stimmen[j];
      }
      else if (max && (max==stimmen[j]))
        maxs+=({moeglichkeiten[j]});
    }
  }
  SAY("---------------------------------------------------------------------------\n");
  SAY("Ergebnis:\n\n");
  // for (i=0;i<n;i++)
  //   SAY(sprintf(" -- %d.) %s\t: %d\n", i+1, moeglichkeiten[i], stimmen[i]));

  for (i=0;i<n;i++)
    SAY(sprintf("  %3d: [%3d] %-25s\n",
      i+1, stimmen[i], moeglichkeiten[i] ));

  SAY(sprintf("\nUngueltige Stimmen: %d.\n",stimmen[n]));
  if (sizeof(maxs))
    SAY(break_string(
      sprintf("Die meisten gueltigen Stimmen (%d) gab es fuer: %s.",
      max, implode(maxs, ", ")), 78));
  SAY("---------------------------------------------------------------------------\n");
  return 1;
}
