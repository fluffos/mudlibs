inherit "/std/container";

#include "../def.h"
#include <properties.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine Posttasche");
  SetProp(P_LONG, "Eine Posttasche aus schwarzem Leder. Sie gehoert einem "
      "Brieftraeger, der sie braucht, um damit Postkarten auszutragen.");
  AddId(({"tasche", "posttasche", "\nptasche"}));
  SetProp(P_NAME, "Posttasche");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 600);
  SetProp(P_MAX_WEIGHT, 15000);
  SetProp(P_VALUE, 1400);
  SetProp(P_INFO, "Die Posttasche hast Du sicher von einem Brieftraeger "
                  "geklaut. Schaem Dich!\n");
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );

}

varargs int move( mixed dest, int method )
{
  if( dest->id("\npostman") )
    return ::move(dest, method);
  else {
    tell_room(dest, "Die Posttasche loest sich in Luft auf.\n");
    call_out("weg", 0);
    return 0;
  }
}

weg()
{
  TO->remove();
}
