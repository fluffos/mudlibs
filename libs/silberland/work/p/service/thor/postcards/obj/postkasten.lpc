inherit "/std/container";

#include "../def.h"
#include <properties.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Postkasten");
  SetProp(P_LONG,
         "Ein leuchtend gelber Postkasten. An der Vorderseite ist ein "
         "schmaler Schlitz angebracht, der allerdings durch seine vielen "
         "kleinen Zacken ein wenig gefaehrlich aussieht. Trotzdem scheint "
         "von ihm keine allzugrosse Gefahr auszugehen.");
      
  AddId(({"kasten", "postkasten", "briefkasten", "\npkasten"}));
  SetProp(P_NAME, "Postkasten");
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_MAX_WEIGHT, 3000);
  SetProp(P_VALUE, 1400+random(500));
  SetProp(P_INFO, BS("Ein Postkasten ist dazu da, um Postkarten "
    "hineinzustecken. Natuerlich nur, sofern Du wuenscht, dass Deine "
    "Postkarte zugestellt wird.\n"));
  SetProp(P_MATERIAL, ([MAT_ALUMINIUM:90, MAT_MISC_LIVING:10]));
  SetProp(P_NOGET, 1);
  SetProp(P_KILL_NAME, "Ein bissiger Postkasten");
  SetProp(P_KILL_MSG, "Ich bin nicht bissig, nur hungrig!");
  
  AddDetail( ({"vorderseite", "seite"}),
             "An der Vorderseite des Postkastens siehst Du einen schmalen, "
             "langen Schlitz, der mit vielen kleinen Zacken bestueckt ist.");
  AddDetail( "schlitz",
             "Der Schlitz ist gezackt.");
  AddDetail( "zacken",
             "Sie sehen ziemlich scharf aus.");
  AddDetail( "gefahr",
             "Du wirst Dich doch wohl nicht vor einem Postkasten fuerchten?!");
  
//  AddCmd( ({"stecke", "steck"}), "schnapp");

}

varargs int PreventLeave(object ob)
{
  if( !TP->id("\npostman"))
      return 1;
  else
    return ::PreventLeave(ob);
}

varargs int PreventInsert(object ob)
{
  if( ob->id("\npkarte2" ))
      return ::PreventLeave(ob);
  if( !ob->id("\npkarte") ) {
    write(BS("Du kannst nur Postkarten in den Postkasten stecken!"));
    return 1;
  }

  else if (!call_other(ob, "CheckCard")) {
    write(BS("Vielleicht solltest Du die Postkarte noch vervollstaendigen ... "
             "Irgendetwas scheint ihr noch zu fehlen."));
    return 1;
  }
  
  else {
    call_out("schnapp", 1);
    return ::PreventLeave(ob);
  }
      
}

void schnapp(string str)
{
  int i;
  i=random(20);
  
  if(!TP)
    return;
  
  else if( environment(TP) != environment(TO) )
    return;
 
  else {
    write(BS("Ploetzlich woelbt sich der Postkasten kurz nach "
             "vor und schnappt kraeftig nach Deiner Hand."));
    say(BS("Ploetzlich woelbt sich der Postkasten kurz nach vor und schnappt "
           "nach "+CAP(TP->name(WESSEN))+" Hand."));
    
    switch (i) {
    
      case 0 .. 4: write(BS("Deine guten Reflexe haben Deine Hand gottseidank "
                            "noch rechtzeitig ausser Reichweite gebracht und "
                            "ausser einem Schrecken hast Du nichts "
                            "abbekommen."));
                   say(BS(CAP_TPN+" konnte dank "
                       +TP->QPP(MALE, WESSEN, PLURAL)+" guten Reflexe "
                       +TP->QPP(FEMALE, WEN, SINGULAR)+" gerade noch in "
                       "Sicherheit bringen und steht nun mit leicht "
                       "verdutztem Gesicht etwas unschluessig in der Gegend "
                       "rum."));
                   break;
      case 5 .. 10: write(BS("Schnell ziehst Du Deine Hand zurueck, aber "
                             "leider nicht schnell genug, den die scharfen "
                             "Zacken vom Schlitz des Postkastens verpassen Dir "
                             "noch ein paar Schrammen."));
                    TP->do_damage(5);
                    say(BS(CAP_TPN+" zieht schnell "
                        +TP->QPP(FEMALE, WEN, SINGULAR)+" Hand zurueck, ist "
                        "allerdings nicht schnell genug und steht dafuer jetzt "
                        "mit einem etwas verschrockenem Gesicht da."));
                    break;
      case 11 .. 15: write(BS("Du versuchst Deine Hand zurueckzuziehen, bist "
                          "aber leider zu langsam, sodass Dir der Postkasten "
                          "noch eine etwas schmerzhafte Bisswunde "
                          "zufuegt. Etwas veraengstigt kuckst Du den "
                          "Postkasten nochmal an, willst dann aber nicht mehr "
                          "naeher ueber ihn nachdenken."));
                      TP->do_damage(15);
                      say(BS(CAP_TPN+" versucht noch, "
                         +TP->QPP(FEMALE, WEN, SINGULAR)+" Hand "
                         "zurueckzuziehen, ist aber zu langsam und bekommt "
                         "von dem Postkasten eine ziemlich schmerzlich "
                         "aussehende Bisswunde zugefuegt. "+CAP_TPN+" wirft "
                         "dem Postkasten noch eine etwas veraengstigen Blick "
                         "zu und wendet sich dann schnell ab."));
                      break;
      case 16 .. 19: write(BS("Du versuchst Deine Hand zurueckzuziehen, bist "
                           "allerdings viel zu langsam, sodass der Postkasten "
                           "aeusserst hart zuschnappt. Du schreist vor Schmerz "
                           "laut auf und kuckst Deine stark blutende Hand "
                           "an."));
                      TP->do_damage(25);
                      say(BS(CAP_TPN+" versucht "
                          +TP->QPP(FEMALE, WEN, SINGULAR)+" Hand vor dem "
                          "Postkasten in Sicherheit zu bringen, ist dabei "
                          "allerdings viel zu langsam, sodass der Postkasten "
                          "aeusserst hart zuschnappen kann. "+CAP_TPN+" schreit"
                          "vor Schmerz laut auf und kuckt veraengstigt "
                          "auf "+TP->QPP(FEMALE, WEN, SINGULAR)+" stark "
                          "blutende Hand."));
                      break;
    }
  }
}
