#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_LONG,
      "Eine einfache Postkarte. Du kannst sie lesen.");
  SetProp(P_NAME, "Postkarte");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([MAT_PAPER:100]));
  AddId( ({"karte", "postkarte", "\npkarte2"}));
  
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);

}
