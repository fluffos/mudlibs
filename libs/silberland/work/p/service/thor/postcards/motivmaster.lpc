#pragma strong_types

#define MOTIVFILE "/p/service/thor/postcards/save/motive"
#define MOTIVMASTER "/p/service/thor/postcards/motivmaster"

mapping motive;   // Aufbau: ([ "gruppe": ([ "title" : "txt",...]), ... ])

void create()
{
  seteuid(getuid(this_object()));
  if (!restore_object(MOTIVFILE) || !mappingp(motive)) {
    motive = ([ ]);
  }
}

int query_prevent_shadow() { return 1; }

string *GetGroups()
{
  return sort_array( m_indices(motive), #'> );
}

string *GetMotives(string mgroup)
{
  if (!member(motive, mgroup)) return 0;
  return sort_array( m_indices(motive[mgroup]), #'> );
}

string GetMotive(string mgroup, string title)
{
  if (!member(motive, mgroup) ||                // Motivgruppe gibts nicht
      !mappingp(motive[mgroup]) ||              // Motivgruppe kein Mapping
      !member(motive[mgroup], title)) return 0; // Motiv gibts nicht
  return motive[mgroup][title];
}

int AddGroup(string mgroup)
{
  if (member(motive, mgroup)) return 0;         // Misserfolg
  motive[mgroup] = ([ ]);
  save_object(MOTIVFILE);
  return 1;     // erfolgreich
}

int RemoveGroup(string mgroup)
{
  if (!member(motive, mgroup)) return 0;        // Misserfolg
  motive = m_delete(motive, mgroup);
  save_object(MOTIVFILE);
  return 1;     // erfolgreich
}

int AddMotive(string mgroup, string title, string txt)
{
  if (!member(motive, mgroup)) return 0;        // Misserfolg
  if (member(motive[mgroup], title)) return 0;  // Misserfolg
  motive[mgroup][title] = txt;
  save_object(MOTIVFILE);
  return 1;     // erfolgreich
}

int RemoveMotive(string mgroup, string title)
{
  if (!member(motive, mgroup)) return 0;        // Misserfolg
  if (!member(motive[mgroup], title)) return 0; // Misserfolg
  efun::m_delete(motive[mgroup], title);
  save_object(MOTIVFILE);
  return 1;     // erfolgreich
}

