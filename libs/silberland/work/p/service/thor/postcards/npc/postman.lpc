void create()
{
 
  ::create();

  SetProp(P_SHORT, "Ein Brieftraeger");
  SetProp(P_LONG, 
    "Der Brieftraeger ist ein ziemlich grosser, schlacksiger Kerl. Er wirkt "
    "ziemlich fit, schliesslich muss er ja auch Tag und Nacht durchs "
    "SilberLand laufen. Er sieht Dich mit freundlichen, wenn auch leicht "
    "gestresst wirkenden Augen an.");
  SetProp(P_NAME, "Brieftraeger");
  SetProp(P_GENDER, MALE);
  AddId(({"traeger", "brieftraeger", "postmann", "mann", "\npostman"}));
  set_living_name("postman");
  AddDetail( ({"auge", "augen"}),
             "Die Augen des Brieftraegers machen einen sehr aufgeweckten, "
             "freundlichen Eindruck.");

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit harten Faeusten", 200, DT_BLUDGEON}));
  SetProp(P_MAX_HP, 1500);
  SetProp(P_BODY, 250);
  SetProp(P_XP, -100000); // Bonus fuer Spells
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 185);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  
  SetProp(P_MSGIN, "hastet schnaufend herein");
  SetProp(P_MSGOUT, "hastet weiter");
  SetProp(P_MMSGIN, "hastet schnaufend herein");
  SetProp(P_MMSGOUT, "hastet weiter durchs SilberLand");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "An Dich stelle ich keine Postkarten mehr zu, %s!");
  SetProp(P_KILL_NAME, "Ein Brieftraeger");

  AddInfo(DEFAULT_INFO, "wuehlt nur in seiner Posttasche weiter.\n");
  AddInfo("post", "Die Post ist ein guter Arbeitgeber! Man braucht nix zu "
                  "tun und bekommt trotzdem gut bezahlt.","sagt: ");
  AddInfo( ({"brief", "briefe"}), "Tut mir leid, ich liefere nur Postkarten "
                                 "aus.","informiert: ");
  AddInfo( ({"karte", "postkarte", "karten", "postkarten"}), "Falls eine an "
                   "Sie adressiert war, habe ich sie Ihnen sicher schon "
                   "ueberreicht.", "meint: ");
  AddInfo( ({"kasten", "postkasten", "briefkasten"}), "In jeder Stadt und in "
                   "jedem zivilisierten Dorf hier im SilberLand gibt es einen "
                   "Postkasten. Ich entleere sie von Zeit zu Zeit.",
                   "erklaert: ");
  AddInfo( ({"posttasche", "tasche"}), "Wenn Du auch so eine schoene "
                           "Posttasche haben willst, musst Du Dich bei der "
                           "Zentrale der SilberLand Post als Brieftraeger "
                           "bewerben.", "sagt: ");
  AddInfo( "zentrale", "Die Zentrale ist die Post in Midas.", "sagt: ");
  AddInfo( "midas", "Wunderschoene Stadt. Ich bin dort geboren.", "sagt: ");
  AddInfo( ({"staedte", "doerfer"}), "Von Smoersky bis Kyranda, ich komm "
                                     "ueberall umeinander.", "dichtet: ");
  AddInfo( "smoersky", "Verdammt kalt dort. Und langweilig. Nix los. Ich "
                       "komm dort nur selten hin, weils auch nur selten "
                       "Spieler dorthin verschlaegt.", "sagt: ");
  AddInfo( "kyranda", "Gutes Bier gibts dort! Ich kehr fast immer in der "
                      "hiesigen Kneipe dort ein und goenne mir eine kleine "
                      "Pause von meiner anstrengenden Arbeit.", "sagt: ");
  AddInfo( "bier", "Ja, Bier ist schon was feines. Ich besuche oefters meinen "
                   "alten Kumpel Zechus Prellus um einen gemeinsam mit ihm zu "
                   "heben.", "sagt: ");
  AddInfo( ({"freund", "zechus", "prellus", "kumpel"}), "Hehe, Zechus ist ein "
                   "alter Freund von mir. Wir haben gemeinsam schon so manchen "
                   "Monat durchgesoffen.", "sagt stolz: ");
  AddInfo( "monat", "Tja, da schauste, was? Das wuerdest Du nicht schaffen!",
                    "meint veraechtlich: ");
  AddInfo( ({"hund", "hunde"}), "Ich hasse Hunde! Immer wollen sie mich bei "
                                "der Arbeit behindern!", "sagt veraergert: ");
  AddInfo( ({"yiqanuc", "dorf"}), "Ein schoenes Dorf, dieses Yiqanuc. Und so "
      "friedlich!", "sagt: ");
  AddInfo( "zynra", "Eine gute Freundin von mir!", "sagt: ");
  AddInfo( "xandim", "Die Xandim sind ein aeusserst freundliches und "
      "hoefliches Volk.");

  SetProp( P_LOG_INFO, "thor/postman");
   
  SetProp( P_REJECT, ({ REJECT_GIVE,
        break_string(
          "Oh, @WER! Ist ja nett von Dir!\n"
          "Aber ich habe auch so schon genug zu schleppen!",
          78, "Der Brieftraeger sagt: ", 1)
        }) );

  SetProp(P_SPELLRATE,10);
  AddSpell(5, 300,
    "Der Brieftraeger wirft seine Posttasche nach Dir.\n",
    "Der Brieftraeger wirft seine Posttasche nach @WEN.\n",
     DT_BLUDGEON ,([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 800,
    "Der Brieftraeger rammt Dir sein Knie mit voller Gewalt in den Bauch.\n",
    "Der Brieftraeger rammt @WEN sein Knie mit voller Gewalt in den Bauch.\n",
     DT_BLUDGEON ,([SP_SHOW_DAMAGE:1]));

  SetChats(2, ({
  "Der Brieftraeger kramt in seiner Posttasche herum.\n",
  "Der Brieftraeger kuckt Dich ein wenig verwirrt an.\n",
  BS("Der Brieftraeger nimmt einen Brief aus seiner Tasche, liest sich kurz "
  "den Empfaenger durch und steckt ihn dann unschluessig wieder zurueck."),
  "Der Brieftraeger idlet ein wenig in der Gegend rum.\n",
  "Der Brieftraeger kuckt etwas gestresst.\n"}) );

  SUID;
  CLONEME( OBJ("posttasche") );

  add_soul_commands();

  move("/d/polar/thor/xandim/room/kneipe", M_TPORT);
}

heart_beat()
{
  object *env;
  int i;
  
  if(QueryProp(P_HP)<200) {
    SetProp(P_HP, QueryProp(P_MAX_HP));
    env=all_inventory(environment(TO));
    for(i=0; i<sizeof(env); i++) {
      if(query_once_interactive(env[i]) && IsEnemy(env[i])) {
        env[i]->AddExp(-5000-random(env[i]->QueryProp(P_LEVEL)*500));
        tell_object(env[i], "Der Brieftraeger heilt sich durch Deine "
                            "Erfahrung.\n");
      }
    }
  }
  ::heart_beat();
}
    

reset()
{
  if (find_call_out("CheckLocations") < 0)
    call_out("CheckLocations", 0, 0);
  ::reset();
}

void CheckLocations(int curloc)
{
  object bag;

  if (curloc >= sizeof(locations))
  {
    if(!bag=present("\nptasche", TO)) {
      if (find_player("thor"))
        tell_object(find_player("thor"),
          "Der Brieftraeger teilt Dir mit: Ich habe keine Tasche mehr! :-(\n");
      call_out("heim", 10);
      return;
    }
    if(!sizeof(cards=all_inventory(bag))) {
      call_out("heim", 20);
      return;
    }
    call_out("CheckReceivers", 5);
    return;
  }

#ifdef DEBUG
  if (find_player("thor")) {
    tell_object(find_player("thor"),
        sprintf("Der Brieftraeger teilt Dir mit: curloc=%d\n",
          curloc));
    tell_object(find_player("thor"),
        sprintf("Der Brieftraeger teilt Dir mit: dest=%s\n",
          locations[curloc]));
  }
#endif
  command_me("winke /artig");
  TO->move(locations[curloc], M_TPORT);
  if(!present("\npkasten", environment()))
    tell_room(environment(), BS("Der Brieftraeger kratzt sich verwirrt "
                                "am Kopf."));
  else {
    tell_room(environment(), BS("Der Brieftraeger oeffnet einen Postkasten."));
    command_me("nimm alles aus postkasten");
    tell_room(environment(), BS("Der Brieftraeger schliesst einen "
                                "Postkasten."));
    command_me("stecke alles in posttasche");
  }
  call_out("CheckLocations", 20, curloc+1);
}

void heim()
{
  command_me("sag Feierabend!");
  command_me("winke /artig");
  move(START, M_TPORT);
}

CheckReceivers()
{
  receiver=cards[j]->QueryProp(P_RECEIVER);
  sender=cards[j]->QueryProp(P_SENDER);
  if(cards[j]->id("\npkarte2")) {
    if(recv=find_living(receiver)) {
      command_me("winke /artig");
      TO->move(environment(recv), M_TPORT);
      command_me("nimm "+receiver+"postkarte "
                 "aus tasche");
      call_out("give_card", 2);
    }
    else if(cards[j]->QueryProp(P_DELIVER_TRIES) < 80)
      cards[j]->SetProp(P_DELIVER_TRIES,
                        cards[j]->QueryProp(P_DELIVER_TRIES)+1);
    else if(cards[j]->QueryProp(P_DELIVER_TRIES) == 80) {
      cards[j]->RemoveId(receiver+"postkarte");
      cards[j]->SetProp(P_RECEIVER, lower_case(cards[j]->QueryProp(P_SENDER)));
      cards[j]->AddId(cards[j]->QueryProp(P_RECEIVER)+"postkarte");
      cards[j]->SetProp(P_READ_MSG, cards[j]->QueryProp(P_READ_MSG)+
                "Empfaenger unbekannt oder zu lange nicht eingeloggt!\n");
    }
  }
  j++;
  
  if( j < sizeof(cards) )
    call_out("CheckReceivers", 10);
  
  else {
    j=0;
    call_out("heim", 10);
    return;
  }
}
   
give_card()
{
  if(!recv) {
    k=0;
    return;
  }
  if(environment()==environment(recv)) {
    command_me("gib postkarte an "+receiver);
    k=0;
    write_file("/p/service/thor/postcards/log/zustellungen",
               dtime(time())+": Postkarte wurde an "+capitalize(receiver)+
               " zugestellt.\n");
      
  }
  else
    recv->AddPursuer(TO);
}

int PreventFollow( object dest )
{
  if( k < 20 ) {
    tell_object(recv, BS("Der Brieftraeger schnauft: Halt! Moment! Ich habe "
                    "eine Postkarte fuer Sie! So bleiben Sie doch bitte einen "
                    "Moment stehen!"));
    k++;
    call_out("give_card", 2);
    return 2; 
  }
  else {
    tell_object(recv, BS("Der Brieftraeger gibt voellig ausser Atem auf."));
    k=0;
    return 2;
  }
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("react") != -1) return;
  switch(gruppe) {
    case "fies": call_out("react", 1, "trete "+getuid(TP)+" /heftig in den Bauch");
                 break;
    case "aergerlich": call_out("react", 1, "sag Ach, lass mich doch in "
                                            "Ruhe, "+getuid(TP));
                       break;
    case "traurig":    call_out("react", 1, "umarme "+getuid(TP)+" /troestend");
                       break;
    case "albern":      
                       call_out("react", 1, "grinse");
                       break;
    case "intim":      call_out("react", 1, "liebe "+getuid(TP));
                       break;
    case "froh":       call_out("react", 1, "freue");
                       break;
    case "nett":       call_out("react", 1, "knuddel "+getuid(TP));
                       break;
  }
}

react( string action )
{
  command_me(action);
}
