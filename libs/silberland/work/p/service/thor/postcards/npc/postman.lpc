object *cards, recv;
string receiver, sender;
string *locations=({
    "/players/thor/workroom", 
    "/players/woody/workroom",
    "/players/muaddib/workroom",
    "/d/polar/thor/xandim/room/hauptplatz3",           //Yiqanuc
    "/d/ebene/creative/feldlager/room/a7_a0",          //Feldlager
    "/d/polar/lamuerte/dorf/rooms/festland_2.lpc",       //Smoersky
    "/d/gebirge/eros/room/berg_u16",                   //Gebirge (Dax)
    "/d/ebene/Midas/room/room_f5"});                   //Midas
                    
