inherit "std/thing";

#include <properties.h>

// Prototypes
string p_short();
string p_name();

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  AddId(({"iwoplant", "sproessling"}));

  SetProp(P_NAME, "Sproessling");
  SetProp(P_SHORT, "Ein Sproessling");
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE);

  SetProp(P_LONG, "Der Sproessling einer Pflanze. Leider weisst "
    "Du nicht genau, um welche Pflanze es sich hierbei handelt, aber "
    "wenn Du etwas haettest, um ihn einzupflanzen, koenntest Du "
    "das sicher herausfinden.");

  SetProp(P_INFO, #'info);
}

string info()
{
  return "na servas\n";
}

