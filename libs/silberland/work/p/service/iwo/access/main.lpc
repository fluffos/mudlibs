#pragma strong_types

#include <wizlevels.h>
#include <properties.h>
#include <ansi.h>
#include "def.h"

#define TO efun::this_object()


// Prototypes
void create();
string _query_int_short();
string int_long();
varargs string GetExits( object viewer );


void create()
{
  if (is_clone(TO)) destruct();
  seteuid(getuid(this_object()));
}

string _query_int_short()
{
  return "Im Hauptkontrollraum fuer Zugriffsrechte";
}

string int_long()
{
  string longint;
  
  longint = break_string("Du befindest Dich im Hauptkontrollraum fuer Zugriffsrechte. "
    + "Wenn Du kein Erzmagier oder hoeher bist, kannst Du hier eigentlich "
    + "garnichts machen. Wenn Du ein Regionsmagier bist, kannst Du "
    + "ueber den Ausgang mit dem Namen Deiner Region die Berechtigungen "
    + "fuer Deine Region betrachten und bearbeiten.", 78);
    
  longint += "Hife bekommst Du mit: mhilfe\n"; 

  return longint+GetExits();
}

varargs string GetExits( object viewer )
{
  string *domains;
  string *numbers;
  string ac_file;
  int ac_filesize;
  int i;
  int n;

  ac_file = sprintf("%s/access_rights.lpc", ACPATH);

  ac_filesize = file_size(ac_file);

  numbers = ({ "zwei","drei","vier","fuenf","sechs","sieben","acht",
               "neun","zehn","elf","zwoelf","dreizehn","vierzehn",
               "fuenfzehn","sechzehn","siebzehn","achtzehn",
               "neunzehn","zwanzig" });

  if (!pointerp(domains = MASTER->get_domains()))
    return "Es gibt keine sichtbaren Ausgaenge.\n";

  n = sizeof(domains);

  for (i=0;i<n;i++)
    if (file_size(sprintf("/d/%s/access_rights.lpc", domains[i])) == ac_filesize)
      domains[i] = ANSI_GREEN + domains[i] + ANSI_NORMAL;
    else
      domains[i] = ANSI_RED + domains[i] + ANSI_NORMAL;

  switch(sizeof(domains))
    {
      case 1: 
          return break_string("Es gibt einen sichtbaren Ausgang: "
                   + domains[0]+"\n", 78);
      case 2..20:
          return break_string("Es gibt " + numbers[n-2] 
                   + " sichtbare Ausgaenge: "
                   + implode(domains, " ")+"\n");
      default:
          return break_string(sprintf("Es gibt %d sichtbare Ausgaenge: %s\n", n,
                   implode(domains, " ")));
        
    }
  
}


void init()
{
  add_action("_normalfunction", "", 1);
}


int _normalfunction()
{
  string verb;
  string *domains;

  verb = query_verb();

  if (verb == "mhilfe")
    {
      this_player()->more(ACDOC);
      return 1;
    }

  if (!pointerp(domains = MASTER->get_domains())) return 0;

  if (member(domains, verb)==-1) return 0;

  tell_room(TO, sprintf("Target: %s%s\n", ACPATH, verb));

  return this_player()->move(ACPATH+verb,3);
}
