inherit "std/npc";

#include <defines.h>
#include <moredef.h>
#include <npc.h>
#include <moving.h>
#include <properties.h>
#include <living.h>
#include <combat.h>

#pragma strong_types

void create()
{
  object ob;

  if (!is_clone(this_object())) return;

  ::create();

  AddId( ({ "lipido", "vermesser", "mensch", "gehilfe" }));

  SetProp(P_NAME, "Lipido");
  SetProp(P_SHORT, "Lipido der Vermesser");
  SetProp(P_LONG, "Lipido ist einer der fleissigen Gehilfen "
    "des lokalen Bautrupps. Woauchimmer geplant wird etwas "
    "neues zu machen ist er mit sicherheit der Erste der vor "
    "Ort alle noetigen Daten aufnimmt und das letzte Wort "
    "um die Genehmigung des Vorhabens hat. Emsig kritzelt "
    "er auf einer Karte herum bei der Du Dir nichtmal sicher "
    "bist ob er sie ueberhaupt richtig in der Hand hat :)");

  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);

  create_default_npc(20);

  SetProp(P_RACE, "Mensch");
  SetProp(P_ALIGN, 300);
  
  SetProp(P_NOATTACK, "weicht aus wie eine Schlaftablette.");

  ob = clone_object("/obj/fackel.lpc");

  ob->AddId( ({ "karte" }) );
  ob->SetProp(P_NAME, "Karte");
  ob->SetProp(P_SHORT, "Eine Karte");
  ob->SetProp(P_LONG, "Nur gekritzel ist zu sehen.");
  ob->move(this_object(), M_GET);

  SetChats(5, ({
    "Lipido fragt: Wie soll das jemals gehen!?\n",
    "Lipido sagt: Das kann ich NIEMALS genehmigen!\n",
    "Lipido murmelt: Welcher Idiot hat das geplant?\n",
    "Lipido fragt: Wie zum Woody stellen die sich das vor?\n",
    "Lipido kritzelt emsig auf einer Karte rum.\n",
    "Lipido schuettelt unglaeubig den Kopf.\n",
    "Lipido flucht das Blaue vom Himmel.\n"
    }));

}

