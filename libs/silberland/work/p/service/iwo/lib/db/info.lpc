inherit "/std/thing";

#pragma strict_types


#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <config.h>
#include <ansi.h>



void create()
{
  ::create();
  seteuid(getuid());
  SetProp(P_NAME, "Information");
  SetProp(P_SHORT, "Information");
  SetProp(P_LONG, "Wohl nur eine Datenbank kann damit was Anfangen.");
  AddId( ({ "information"}) );
}
