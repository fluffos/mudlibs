/*
 Parse functions for Group master
 Iwo@SL
*/
 

// Command parser
int ParseGCommand (string str)
{
  string *xstr;
  string cmd;

  if (destruct_gobj == 1)
    {
      if (PO->id("\ngobj"))
        {
	  MasterInfo(sprintf("Destructing object: %O", PO));
	  if (ENV(PO))
	    MasterInfo(sprintf("Environment: %O", ENV(PO)));
	  PO->remove();
	  return 0;
	}
    }

  if (!str) str = "s";

  xstr = explode(str, " ");
  
  cmd = xstr[0];
  
  
  switch (cmd)
    {
    case "g": // New group
      NewGroup(TP, str[2..<1]);
      break;
    case "s": // Group status
      GroupStatus(TP, "");
      break;
    case "aufl": // Break a group
      BreakByMember(TP, str[5..<1]);
      break;
    case "v": // Leave a group
      LeaveGroup(TP, 0);
      break;
    case "aufn": // Invite a player
      InvitePlayer(TP, str[5..<1]);
      break;
    case "b": // Join a group
      JoinGroup(TP, str[2..<1]);
      break;
    case "r": // Group shout
      ShoutMembers(TP, TP->_unparsed_args()[2..<1], 0);
      break;
    case "e": // Group shout
      ShoutMembers(TP, TP->_unparsed_args()[2..<1], 1);
      break;
    case "hist": // Group shout history
      ShoutHist(TP, TP->_unparsed_args()[5..<1]);
      break; 
    case "o": // Group may view exact values
      ToggleOpen(TP);
      break;
    case "l": // Change leader
      ChangeLeader(TP, TP->_unparsed_args()[2..<1]);
      break;
    case "aus": // Fire a member
      FireMember(TP, str[4..<1]);
      break;
    case "ort":
      LocateMembers(TP);
      break;
    case "liste": // List all Groups
      ListGroups(TP);
      break;
    case "p": // Toggle public
      TogglePublic(TP);
      break;
    case "k": // Common attack command
      SetAttackCommand(TP, TP->_unparsed_args()[2..<1]);
      break;
    case "a": // Launch common attack command
      ExecuteAttackCommand(TP);
      break;
    default:
      TellHelp(TP);
    }

  save_object(GROUPMASTER); 

  return 1;

}



// Administrative Commands (wizard only)
int MasterCommand(string str)
{
  string *xstr, cmd;

  notify_fail("Das darfst Du nicht.");
  if (!IS_WIZARD(TP)) return 0;
  
  if (!str || str == "") str = "h";
  
  xstr = explode(str, " ");
  
  cmd = xstr[0];
  
  switch (cmd)
    {
      case "h":
        TellMasterHelp(TP);
	break;
      case "g":
        ListGroups(TP);
	break;
      case "s":
        GroupStatus(TP, str[2..<1]);
	break;
      case "a":
        BreakGroup(str[2..<1], BREAK_MASTER);
	break;
      case "des":
        ToggleGobjDestruct(TP);
	break;
      case "t":
        ListTasks();
	break;
      case "enable":
        EnableGroupAbility(str[7..<1]);
	break;
      case "disable":
        DisableGroupAbility(str[8..<1]);
	break;
      case "cg":
        CheckGobjs();
	break;
      case "fg":
        FindAllGobjs();
	break;
      case "rg":
        ResetAllGobjs();
	break;
      case "id":
        MasterInfo(sprintf("My UID: %O, EUID: %O", getuid(TO), geteuid(TO)));
	return 1;
	break;
      default:
        TellMasterHelp(TP);
	break;
    }
  return 1;
}
