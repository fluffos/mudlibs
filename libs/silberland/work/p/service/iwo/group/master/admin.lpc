/*
 admin functions for Group master
 Iwo@SL
*/
 

// Enable group ability
// Temporary function to limit access
private nosave int EnableGroupAbility (string s_pl)
{
  if (!IS_WIZARD(TP) && getuid(TP) != "iwo")
    {
      MasterInfo("Enabling group ability requires wizard privileges.");
      return 1;
    }
    
  if (!s_pl || s_pl == "")
    {
      TellMasterHelp(TP);
      return 1;
    }
    
  group_enabled += ({ s_pl });
  
  MasterInfo(sprintf("Added group ability for '%s'.", CAP(s_pl)));
  
  return 1;
}


// Disable group ability
// Temporary function to limit access
private nosave int DisableGroupAbility (string s_pl)
{
  if (!IS_ARCH(TP) && getuid(TP) != "iwo")
    {
      MasterInfo("Enabling group ability requires arch privileges.");
      return 1;
    }
    
  if (!s_pl || s_pl == "")
    {
      TellMasterHelp(TP);
      return 1;
    }
    
  if (member(group_enabled, s_pl) == -1)
    {
      MasterInfo(sprintf("No ability for '%s'.", CAP(s_pl)));
      return 1;
    }
    
  group_enabled -= ({ s_pl });
  
  MasterInfo(sprintf("Removed group ability for '%s'.", CAP(s_pl)));
  
  return 1;
}

// Print a task list
private nosave int ListTasks()
{
  if (!IS_ARCH(TP) && getuid(TP) != "iwo")
    {
      MasterInfo("Task list requires Arch privileges.");
      return 1;
    }
  MasterInfo("Active Tasks: PID, NEXT, TYPE, PTIME, COUNT, ARGS");
  MasterInfo(sprintf("%O", tasks));
  return 1;  
  //          PID     NEXT    TYPE  PTIME  COUNT  COMMAND   ARGS
}

// Destruct mode for group object
private nosave int ToggleGobjDestruct(object pl)
{
  if (!IS_ARCH(pl) && getuid(pl) != "iwo")
    {
      MasterInfo(sprintf("Destruct mode requires arch privileges (%s)", CAP(getuid(pl))));
      return 1;
    }
    
  if (destruct_gobj == 1)
    {
      MasterInfo(sprintf("Destruct mode cancelled (%s)", capitalize(getuid(pl))));
      destruct_gobj = 0;
    }
  else
    {
      MasterInfo(sprintf("Destruct mode activated (%s)", capitalize(getuid(pl))));
      MasterInfo("Removing each group object registering.");
      destruct_gobj = 1;
    }
    
  return 1;
}
