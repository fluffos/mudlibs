// Calculate new XP for all members
//  *** D E A K T I V I E R T ! ! ! ***
// Some miscalculations. Just used to test
// possibility. Complete rewrite suggested
varargs void RecalcXp(string pl, int value, string grp)
{
  object ob_pl;
  string *members;
  int xpinc, grpsize, i;

  members = m_indices(groups[grp, 1]);  
  grpsize = sizeof(members);
  xpinc = value / (grpsize + 1);
  find_player(pl)->AddExp(xpinc - value);
 
  for (i = 0; i < grpsize; i++)
    {
      ob_pl = find_player(members[i]);
      ob_pl->AddExp(xpinc);
      groups[grp, 1][members[i], 1] = ob_pl->QueryProp(P_XP);
      TellP(find_player("iwo"), sprintf("Player: %s, EP-Zuwachs: %d", members[i], groups[grp,1][members[i],1] - groups[grp,1][members[i],0]));
    } 
 
}



// Updates old group objects
void CheckGobjVersion(object gobj, string version)
{
  object pl;
  
  if (destruct_gobj == 1) 
    {
      MasterInfo(sprintf("Destruct group object (%O)", ENV(gobj)));
      gobj->remove();
      return;
    }
  
  if (version != GROUPOBJVERSION)
    {
      if(!interactive(ENV(gobj))) return;
      pl = ENV(gobj);
      gobj->remove();
      TellP(pl, "Ein sengender Schmerz durchfaehrt Dich.");
      TellP(pl, "Du greifst Dir ans linke Auge und schreist vor Schmerz.");
      tell_room(ENV(pl), BS(pl->Name(WER) + " fasst sich ploetzlich ans linke "
        "Auge und schreit vor Schmerz."), ({ pl }));
      pl->AddHp(-5);
      clone_object(GROUPOBJ)->move(pl, M_NOCHECK);
      MasterInfo(sprintf("Group object updated. %s->%s", version, GROUPOBJVERSION));
      MasterInfo(sprintf("Env: %O", pl));
    }
  return;
}


void RegisterGobj(object gobj)
{
  if (member(group_objects, gobj)>-1) return;
  
  MasterInfo(sprintf("Group object registered: %O (%O)", gobj, environment(gobj)));
  
  group_objects += ({ gobj });
}



void UnRegisterGobj(object gobj)
{
  if (member(group_objects, gobj)<0) return;
  
  MasterInfo(sprintf("Group object unregistered: %O (%O)", gobj, environment(gobj)));
  
  group_objects -= ({ gobj });
}


private nosave void CheckGobjs()
{
  int i;
  int invalid;
  int all;
  
  all = sizeof(group_objects);
  
  for (i=0;i<sizeof(group_objects);i++)
    {
      if (!objectp(group_objects[i]) || !environment(group_objects[i])
        || !interactive(environment(group_objects[i])))
	  {
	    MasterInfo(sprintf("Unregistering Group object: %O", group_objects[i]));
	    group_objects -= ({ group_objects[i] });
	    invalid++;
	  }
	     
    }
  MasterInfo(sprintf("Checked %d Objects, %d removed.", all, invalid));
}


private nosave void FindAllGobjs()
{
  int i, gc;
  object *pls;
  object gobj;
  
  pls = users();
  
  MasterInfo("Finding all Group objects...");
  
  gc=0;
  
  for (i=0;i<sizeof(pls);i++)
    {
      if (gobj = present("\ngobj", pls[i]))
        { 
	  RegisterGobj(gobj); 
	  gc++; 
	}
    }
  
  MasterInfo(sprintf("Found %d Objects.", gc));
}


private nosave void ResetAllGobjs()
{
  int i;
  CheckGobjs();

  MasterInfo("Resetting all Group objects...");
  
  for (i=0;i<sizeof(group_objects);i++)
      group_objects[i]->reset();

  MasterInfo(sprintf("Done. (%d Objects)", sizeof(group_objects)));
  
}


private nosave void NotifyGobjs()
{
  int i;
  object pl;
  object room;
  
  CheckGobjs();
  for (i=0;i<sizeof(group_objects);i++)
    {
      if ( !objectp(group_objects[i]) || // Bugfix Feyaria.
          (!pl = environment(group_objects[i])) ) continue;
      if (!group_objects[i]->QueryProp(P_GROUPREPORT_NOTIFY)) continue;
      room = environment(pl);
      tell_object(pl, BS("Astrale Funken entweichen von Deinem Stigma "
        "in die Unendlichkeit."));
      if (!pl->QueryProp(P_INVIS))  // Bugfix Feyaria fuer invis magier
        tell_room(room, BS("Das Stigma ueber " + pl->name(WESSEN) + " Auge "
              "scheint zu gluehen."), ({ pl}));
    }
  
}
