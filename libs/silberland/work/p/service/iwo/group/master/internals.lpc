// No need to explain
string strmul(string a, int x)
{
  string str;
  int i;

  str = "";

  for (i = 0; i <= x-1; i++)
    {
      str += a;
    }

  return str;
}


// Adds a task
void AddTask(int delay, int count, string function, mixed *args)
{
  mixed pid;

  int type; // 0 clear if count reaches zero, 1 loop forever

  if (count == 0) type = 1;
  else type = 0;
  
  
  pid = time() + random(100);
  //          PID     NEXT    TYPE  PTIME  COUNT  COMMAND   ARGS
  tasks += ([ pid: time()+delay; type; delay; count; function; args ]);

  MasterInfo("New Task:");
  MasterInfo(sprintf("PID:%O TYPE:%O PTIME:%O COUNT:%O",
               pid, type, delay, count));
  MasterInfo(sprintf("COMMAND:%O ARGS:%O", function, implode(args, ",")));

  return;
}


// RunTask
varargs void RunTask(string pid, int next, int type, int delay, int count, string function, mixed *args)
{
  if (function == "RunTask" || function == "AddTask") raise_error("Possible recursive task. Aborting.");

  // It's time to run it
  if (next < time())
    {
      apply(#'call_other,TO,function,args);
      
      if (type == 1) tasks[pid, 0] = time()+delay;
      else
        {
          if (count <= 1) tasks -= ([ pid ]);
          else
            {
              count--;
              tasks[pid, 0] = time()+delay;
              tasks[pid, 3] = count;
            }
        }
        
  
    }
}




// Check if a new group got enough members
void CheckEmpty(string grp)
{
  if (!IsGroup(grp)) return 0;
  if (NumMembers(grp) < 2) BreakGroup(grp, BREAK_EMPTY);
  return;
}


// Check if members are in the same env as leader
void CheckPresence()
{
  if (sizeof(groups) >0) walk_mapping(groups, "CheckPresence2", TO);
}

// Part2 of CheckPresence
varargs void CheckPresence2(string grp, string leader, mapping members)
{
  walk_mapping(members, "CheckLeaderPresence", TO,  leader);
  return;
}

// Part3 of CheckPresence
varargs void CheckLeaderPresence(string s_pl)
{
  string leader, grp;
  object pl;
  object ob_leader;

  pl = find_player(s_pl);

  grp = affiliations[s_pl, 0];

  // This for group report. Poor named function... i know
  NotifyHpChange(grp, pl);

  leader = QueryLeader(grp);

  // pl is leader
  if (leader == s_pl || grp == "gurus") return;

  // stupid but be sure
  if (!pl || !leader) return;

  // leader is a arch wizard or my massa, no breaking
  if (ob_leader = find_player(leader))
   if (IS_ARCH(ob_leader) || getuid(ob_leader) == "iwo") return;
  
  if (!present( leader, ENV(pl) ) )
    {
      // Increase away from group by 2
      groups[grp, 1][s_pl, 3] += 2;
      // pl has been to long away from leader
      if (groups[grp, 1][s_pl, 3] > MAX_AWAY_FROM_GROUP && !IS_WIZARD(pl))
        {
	  TellP(pl, "Da Du zu lange von Deiner Gruppe entfernt warst, beschliesst Du auszutreten.");
          LeaveGroup(pl, 0);
	}
        
    }
  else
    {
      // set away from group to zero
      groups[grp, 1][s_pl, 3] = 0;
    }
    
  return;
}


// Run this for each player
varargs void CheckMembers (string grp)
{
  walk_mapping(groups[grp, 1], "CheckXp", TO, grp);
}

// Call NotifyXpChange if currXP != lastXP
varargs void CheckXp (string pl, int firstXP, int lastXP, string grp)
{
  object ob_pl;
  int currXP;

  ob_pl = find_player(pl);
  lastXP = groups[grp, 1][pl, 1];
  currXP = ob_pl->QueryProp(P_XP);

  if (lastXP != currXP) NotifyXpChange(pl, currXP - lastXP, grp);

  return;
}


