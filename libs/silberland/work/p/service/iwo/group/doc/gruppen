Die Funktionen des Groupmasters lassen sich nach
  #include "/p/service/iwo/group/group.h"
mittels GROUPMASTER->Funktion oder call_out/other nutzen.

Folgende Funktionen stehen zur Verfuegung:

  int IsInGroup (object pl)
      Gibt 1 zurueck wenn <pl> in einer Gruppe ist ansonsten 0.

  int IsGroup (string grp)
      Gibt 1 zurueck wenn es eine Gruppe namens <grp> gibt.. sonst 0.

  int IsMember (string grp, string pl)
      Gibt 1 zurueck wenn <pl> Mitglied der Gruppe <grp> ist.

  int IsLeader (string grp, string pl)
      Gibt 1 zurueck wenn <pl> Anfuehrer der Gruppe <grp> ist.

  int IsPublic (string grp)
      Gibt 1 zurueck wenn Gruppe <grp> frei zugaenglich ist.

  int NumMembers (string grp)
      Gibt die Anzahl der Mitglieder der Gruppe <grp> zurueck

  int GroupAvgLvl (string grp)
      Gibt den durchschnittliechen Spielerlevel der Gruppe <grp> zurueck

  string QueryLeader (string grp)
      Gibt den Anfuehrer der Gruppe <grp> als String zurueck

  string GroupAffiliation (object pl)
      Gibt als String zurueck in welcher Gruppe <pl> ist oder 0 falls
      in keiner

  string *GroupMembers (string grp)
      Gibt einen String-Array mit den Mitgliedern der Gruppe <grp> oder
      0 falles es die Gruppe nicht gibt aus

  varargs int GroupMsg(string grp, string txt, string indent, int emote)
      Schickt an alle Mitglieder der Gruppe <grp> den Text <txt>
      eingerueckt mit <indent> optional als emote (1)

      Bsp: GROUPMASTER->GroupMsg("gurus", "Ihr habt noch 10 Minuten um "
                          "die Aufgabe zu loesen!", "Info");

      Ergibt: [Gruppe Gurus:Info] Ihr habt noch 10 Minuten um die 
              [Gruppe Gurus:Info] Aufgabe zu loesen!

      Rueckgabewert 1 bei Erfolg andernfalls 0    

  
