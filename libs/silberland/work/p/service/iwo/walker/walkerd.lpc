
inherit "std/thing";

#pragma strong_types

#include <moving.h>
#include <properties.h>

#include "/p/service/iwo/walker/walker.h"

#include "/p/service/iwo/walker/ways.lpc"

// Prototypes
void SetupStations();

// Golbals
string  *stations   = ({});
mapping known_rooms = ([]);

void create()
{
  if (is_clone(this_object())) return;
  ::create();
  
  seteuid(getuid(this_object()));
  
  SetProp(P_NAME, "Walkerd");
  
  SetProp(P_SHORT, "The Walkerd");
  
  AddId( ({ "walkerd" }) );
  
  SetProp(P_NOGET, 1);
  
  this_object()->move("/players/iwo/workroom");

  //restore_object(WALKERD);
  
}

void SetupStations()
{
  string *dsts, *srcs;
  int    i;
  
  dsts = ({});
  
  srcs = m_indices(ways);
  
  for (i=0; i < sizeof(srcs); i++)
    {
      dsts        += m_indices(ways[srcs[i], DST]);
      known_rooms += ([ ways[srcs[i], PATH]: srcs[i] ]);
    }
  
  stations = srcs + dsts;
  
  if (sizeof(stations)<=0) raise_error("No Stations!");
  
}


varargs int remove(int s)
{
  //save_object(WALKERD);
  return ::remove(s);
}

