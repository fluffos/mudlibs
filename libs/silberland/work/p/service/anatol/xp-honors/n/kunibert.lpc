/* kunibert, Veteran des 3., 4. und 5. vergessenen Krieges
 * __________________________________________(i) Anatol@Silberland (2012) */

#pragma strict_types

inherit "std/npc";

#include <wizlevels.h>
#include <properties.h>
#include <combat.h>
#include <living/life.h>
#include <moving.h>
#include <new_skills.h>
#include "../xp-honors.h"

#define ORDEN_ID "\a\n\a\tol_medal_of_xp_honor"

object beutel;


private nosave void 
chat(string *msg) 
{
    if (environment())
        environment()->Message(
      break_string(msg[0],77,(msg[1]?Name()+" "+msg[1]:0),1),MSGFLAG_NO_TP);
}


public void 
give_notify(object given) 
{
    chat(({"Dasch brauch ish nischt!","nuschelt: "}));
    drop_obj(given);
}

nosave string 
infoBeutel() 
{
    if (present("\a\n\a\tol_beutel", this_object())) 
    {
        if (find_call_out("CA_ZeigeBeutel")==-1)
            call_out("CA_ZeigeBeutel",0,getuid(this_player()));
        return "Den hier?";
    }
    else 
        return "Habsch keinen :(";
}

nosave string 
infoListe() 
{
    if (present("\a\n\a\tol_list_of_xp_honor", this_object())) 
    {
        if (find_call_out("CA_ZeigeListe")==-1)
            call_out("CA_ZeigeListe",0,getuid(this_player()));
        return "Die hier?";
    }
    else 
        return "Habsch keine :(";
}

public void 
CA_ZeigeBeutel(string wem) 
{
    command("zeige "+wem+" ordensbeutel");
}

public void 
CA_ZeigeListe(string wem) 
{
    command("zeige "+wem+" liste");
}

public void 
create() 
{
    closure c;
  
    if (is_clone(this_object())) 
    {
        destruct(this_object());
        return;
    }
    ::create();

    SetProp(P_SHORT,"Feldwebel a.D. Kunibert, Veteran der vergessenen Kriege");
    SetProp(P_LONG, "Kunibert, Feldwebel ausser Dienst, Veteran des 2., "
        "3. und 4. vergessenen Krieges, betrunkenster Einwohner und "
        "schmutzigster Nichtzwerg aller Zeiten. Jup. Steht vor Dir. Und "
        "sieht genau so aus, wie Du ihn Dir vorstelltest: Der Dreck der "
        "Strasse, der sich an den Betrunkenen sammelt wie Muell an "
        "Seherportalen und der stete Geruch nach Alkohol sind zwei ganz "
        "deutliche Zeichen, dass Kunibert viel zu vergessen hat, was ihm "
        "schwerfiel zu vergessen.");

    AddDetail("schmutz",
        "Oh je... die Farbe seiner Kleidung, tolles militaerisches "
        "braun-grau-gruen, verschwimmt mit dem Schmutz und Dreck der "
        "Strasse. Die Frage, wo der Kragen aufhoert und der Hals anfaengt, "
        "ist gar nicht mal so einfach. Traegt er eigentlich Handschuhe?");
    AddDetail(({"handschuhe", "handschuh"}),
        "Keine Handschuhe an den Haenden. Das ist Dreck.");
    AddDetail("kleidung",
        "Die Kleidung sieht militaerisch geschnitten aus, scheint aber "
        "aus einer Epoche weit vor Deiner Zeit zu stammen, 'unglaublich "
        "altmodisch' duerfte noch untertrieben sein. In einem entsprechend "
        "abgetragenen Zustand ist sie auch.");
    AddDetail("zustand",
        "Kunibert, Feldwebel ausser Dienst, Veteran des 2., 3. und, "
        "jawohl, 4. vergessenen Krieges, ... ist in keinem sehr schoenen "
        "Zustand.");
    SetProp(P_SMELL,break_string(
        "Uuuuaaaargh! Eine olfaktorische Zumutung aus billigem Fusel, "
        "Pferdedung, altem Schweiss und ... etwas, das vor langer Zeit "
        "gestorben ist.",77));
    SetProp(P_GENDER, MALE);
    SetProp(P_INFO, break_string(
        "Veteran der vergessenen Kriege wird man nicht durch 'fair play'. "
        "Lass den Alten am besten in Ruhe. Aber - er hat bestimmt eine "
        "Idee, was mit den Orden passieren soll, die er da hat. Frag ihn "
        "doch mal danach.",77));

    AddInfo("hilfe",
        "Ish braushe keine Hilfe!","sagt: ");
    AddInfo("schmutz","Wer isht hier schmudshig? Ish bin nicht "
        "schnudshig!","sagt: ");
    AddInfo("idee","Wash?","fragt: ");
    AddInfo("fair play","Ish weish nicht, wash das ishd.");
    AddInfo(({"kriege","krieg"}),"Wash? Wash soll dash sein? Welshe "
        "Kriege?", "fragt: ");
    AddInfo(({"vergessene kriege","vergessener krieg"}),
        "Aaaaah, die beruehmden vergeshenen Kriege! Darueber kann ish "
        "viel erdshaehlen, ish war naemlish dabei! Dsshumindeshd bei "
        "den ... alsho... alsho beim driddn war ish dabei. Und dem "
        "danach. Und davor, genau! Dadshu weish ich gandsh viele "
        "Eindshelheidn!", "sagt: ");
    AddInfo(({"einzelheit","einzelheiten"}),
        "Oh... ish glaube, ish hab shie vergesshen....","murmelt: ");
    AddInfo("alkohol","<hick!>","sagt: ");
    AddInfo("zeichen","Shehet die Dsheishen! ... Welshe Dsheishen?",
        "wirrt: ");
    AddInfo("orden","Aaaah, die Orden. Damalsh in den vergesshenen "
        "Kriegen, dash waren noch Dsheiden voller Helden. Blosh "
        "waren die alle sho shnell tot und eingeaeshert, und wir "
        "hatten dieshe vielen Orden uebrig.. ish hab shie dann mal "
        "mitgenommen, waere doch shade geweshen um dash Material, "
        "oder? Und ish hab einen neuen Verwendungshdshweck!",
        "erlaeutert: ");
    AddInfo(({"menge","mass","masz","erfahrung"}),
        "Alsho, Du brausht sch.. shon eine Menge davon, damit esh "
        "fuer einen Orden reisht. Shagen wir, eine Milliarde?", "sagt: ");
    AddInfo("milliarde",
        "Dash isht eine Eins mit neun Nullen. Gansh shoen viel!","erklaert: ");
    AddInfo(({"verwendungszweck","zweck","verwendung"}),
        "Alsho, esh gibt hier sho viele Leute, die ein unglaublishes "
        "Mash an Erfahrung geshammelt haben. Dafuer gibt es jedsht einen "
        "Orden. Wer glaubt, deshen wuerdig dshu shein, sholl mir mal "
        "shalutieren. Ish verleihe dann feierlish einen Orden, ish "
        "hab ja welshe.", "fuehrt aus: ");
    AddInfo(({"salut","salutieren"}),
        "Alsho Du wirsht ja wohl jemandem shalutieren koennen, oder?",
        "schaut unglaeubig: ");
    AddInfo("vergessen",
        "Alkohol isht gut gegen dash... fuer dash! Jawohl, fuer dash "
        "Vergesshen. Ish weish shon gar nisht mehr, wash ish "
        "vergesshen habe...","lallt: ");

    SetProp(P_ARTICLE,0);
    SetProp(P_NAME,"Kunibert");
    SetProp(P_KILL_NAME,"Feldwebel a.D. Kunibert");
    SetProp(P_KILL_MSG,"'Alter Mann' am A....!");

    AddId(({"kunibert", "\a\n\a\tol_kunibert"}));

    set_living_name("kunibert"); 

    create_default_npc(60);  

    SetProp(P_ATTRIBUTES,([A_STR:25,A_DEX:20,A_INT:20,A_CON:50]));
    SetProp(P_SPELLRATE,40);  
    SetProp(P_MAX_HP,1560);
    SetProp(P_XP,0);

    SetProp(P_BODY,888);
    SetProp(P_SIZE,183);   
    SetProp(P_ALIGN,20);
    SetProp(P_RACE,"Mensch");
    SetProp(P_LOG_INFO,"anatol/kunibert.log");

    SetProp(P_RESISTANCE,({DT_MAGIC, DT_COLD }));
    SetProp(P_MMSGIN,"faellt verdutzt vom Himmel");
    SetProp(P_MSGIN,"torkelt bedaechtig herein");
    SetProp(P_MSGOUT,"torkelt bedaechtig");
    SetProp(P_MMSGOUT,"wird in eine Dunstwolke gesaugt und ist weg");
   
    SetProp(P_MURDER_MSG,"Da ueberlebt man den 3., 4. und 5. vergessenen "
        "und dann sowas. Soll ich das gut finden, %s? Hae? Wuerdest Du "
        "das gut finden? Ist das etwa gut?.");

    AddInfo(DEFAULT_INFO,
      ({"ignoriert Dich.\n",
       "hoert gar nicht zu was Du sagst.\n",
       "ist zu gebrechlich, um deine Frage zu verstehen.\n",
       "kann oder moechte darauf nicht antworten.\n",
       "murmelt etwas unverstaendliches vor sich hin.\n"}));

    AddInfo("beutel",#'infoBeutel,"fragt: ");
    AddInfo("liste",#'infoListe,"fragt: ");

    AddCmd(({"salutier","salutiere"}),"cmdSalutiere");

    seteuid(getuid(this_object()));

    beutel=clone_object("/std/thing");
    c=symbol_function("SetProp",beutel);
    funcall(c, P_SHORT,"Ein abgewetzter Beutel voller Orden");
    funcall(c, P_LONG,"Dieser abgewetzte Beutel ist voller alter, "
        "angelaufener und teilweise potthaesslicher Orden. Das "
        "kannst Du tatsaechlich erkennen, weil das Gewebe an vielen "
        "Stellen durchgescheuert ist. Du hast das Gefuehl, dass, wuerde "
        "irgendwer den Beutel zu stark schuetteln, selbiger samt Inhalt "
        "zu Staub zerfallen wuerde.");
    funcall(c, P_NAME,"Beutel voller Orden");
    funcall(c, P_WEIGHT,0);
    funcall(c, P_LIGHT,0);
    funcall(c, P_MATERIAL,MAT_COTTON);
    funcall(c, P_GENDER,MALE);
    funcall(c, P_INFO,"Schick' Anatol eine Mail. Die Codesequenz ist :\n\n"
        "asjduicufgj55j4ueid8x8x888888s2tqaryfxfduuerzdzzcz-U\n\n"
        "Aber natuerlich nur, wenn Du regulaerer Spieler bist.\n");
    funcall(c, P_NODROP,"Der bleibt, wo es ist");
    funcall(c, P_NEVERDROP,"Der bleibt, wo es ist");
    beutel->AddId(({"ordensbeutel","\a\n\a\tol_beutel"}));
    beutel->move(this_object(),M_NOCHECK);
    clone_object(HONORS_DIR "t/liste")->move(this_object(),M_NOCHECK);

    SetChats(1, ({
        Name(WER)+" setzt zu einer Rede an, schweigt dann aber.\n",
        Name(WESSEN)+" Blick streift unstet die Runde.\n",
        Name(WER)+" brummelt leise.\n",
        Name(WER)+" sieht wirklich verdammt betrunken aus.\n",
        Name(WER)+" sagt: 'ommmimirschderblchrrr'.\n",
        Name(WER)+" mustert irgendetwas sehr kritisch.\n"
                       }));
    SetAttackChats(5, ({
        Name(WER)+" schreit: Allesh innen Grabn!\n",
        Name(WER)+" flucht bitterboes\n",
        Name(WER)+" ruft: Schu den Waffn!\n"}));

    AddSpell(1,800,
        Name(WER)+" torkelt Dir ueberraschend elegant "
                    "einen heftigen Tritt an den Kopf.\n",
        Name(WER)+" tritt @WEM ueberraschend elegant "
                    "einen heftigen Tritt an den Kopf.\n",
                    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
    AddSpell(4,360,
        Name(WER)+" haut Dir voll auf die Nase.\n",
        Name(WER)+" haut @WEM voll auf die Nase.\n",
                    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );

    AddSpell(2,230,
        Name(WER)+" tritt Dir mit der Hacke auf den kleinen Zeh.\n",
        Name(WER)+" tritt @WEM mit der Hacke auf den kleinen Zeh.\n",
                    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );

    AddSpell(3,400,
        Name(WER)+" bricht Dir scheinbar zufaellig einen Finger. AUA!!\n",
        Name(WER)+" bricht @WEM scheinbar zufaellig einen Finger. Autsch.\n",
                    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );

    AddSpell(1,400,
        Name(WER)+" tritt Dir unvermittelt zwischen die Beine!\n",
        Name(WER)+" tritt @WEM unvermittelt zwischen die Beine!\n",
                    ({DT_BLUDGEON}), "spellCentralLowKickOuch",
                    ([SP_SHOW_DAMAGE:1]) );
}

nosave string
spellCentralLowKickOuch(object enemy, int damage, mixed d_types)
{
    if (((int)(enemy->QueryProp(P_GENDER)) == MALE) && (damage>30))
    {
        enemy->Message("Du klappst zusammen "
            "und konzentrierst dich ganz auf DIESEN Schmerz.\n");
        environment()->Message((string)enemy->Name(WER)+
            " klappt zusammen.\n"+
            Name(WER)+" schreit: Dran-gen Mashda!\n",
                ([MSGFLAG_EXCLUDE:enemy]));
        enemy->SetProp(P_PARALYZED,
            ([  PARALYZE_TIME:5,
                PARALYZE_MSG:"Ne, im Moment geht gar nix. "
                "Uargh, diese SCHMERZEN...!\n"]));
    }
}

public int 
remove() 
{
    if ((objectp(beutel))&&(beutel))
        beutel->remove();
    return 
        ::remove();
}

public void
init() 
{
    ::init();
    if ( this_player() 
        && (query_once_interactive(this_player()))
        && (present("\a\n\a\tol_medal_of_xp_honor",this_player()))
          && (!(this_player()->QueryProp(P_INVIS))) && (!InFight()))
        call_out("CA_greet",2,this_player());
}

nosave void
CA_greet(object who)
{
    while (remove_call_out("CA_greet")>=0);

    if (environment() && who && environment(who)
        && environment(who) == environment())
        {
            environment()->Message(
                Name(WER)+" versucht, die Hacken zusammenzuschlagen.\n"
                +Name(WER)+" salutiert "+(string)(who->name(WEM))+".\n",
                0,([MSGFLAG_EXCLUDE:({who})]));
            who->Message(Name(WER)+" salutiert Dir.\n");
        }   
}
nosave int 
cmdSalutiere(string wem)
{
    if ((!this_player()) ||
        (!query_once_interactive(this_player())))
        return 0;
    notify_fail("Wem moechtest Du salutieren?\n");
    if (!id(wem))
        return 0;
    this_player()->Message(break_string("Du stehst richtig "
            "schoen still und salutierst "+name(WEM)+".",77));
    environment()->Message(break_string(this_player()->Name(WER)+
        " steht still und salutiert "+name(WEM)+".",77),MSGFLAG_NO_TP);
    if (find_call_out("CA_salute")==-1)
        call_out("CA_salute",2,this_player());
    return 1;
}

nosave void
CA_salute(object who)
{
    if (!this_player()
        || (!who)
        || (!environment())
        || (!environment(who))
        || (environment()!=environment(who)))
        return;

    if (present(ORDEN_ID,who))
        environment()->Message(Name(WER)+" nickt wohlwollend.\n");
    else
    {
        if ((int)(who->QueryProp(P_XP)) > 1000000000)
        {
            environment()->Message(break_string("Na hallo! Da haben "
                "wir doch einen Anwaerter auf den shilbernen "
                "... Dingsh! Hershlichen Glhickwunsh!",77,
                    Name(WER)+" sagt: ",1));
            environment()->Message(
                break_string(Name(WER)+" zieht einen angeschimmelten Orden aus "
                +QueryPossPronoun(MALE,WER, SINGULAR)+" Beutel, spuckt "
                "drauf und poliert ihn, bis er blitzt und glaenzt.\n"+
                Name(WER)+" sagt: Da hashd Du!",77,0,1),
                MSGFLAG_VISUAL);
            clone_object(HONORS_MEDAL)->move(who,M_NOCHECK);
            environment()->Message(
                break_string(Name(WER)+" verleiht "+
                    (string)(this_player()->name(WEM)) +" einen Orden.",77),
                    MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({who})]));
            who->Message(Name(WER)+" verleiht Dir einen Orden.\n"
            "Du ziehst ihn, natuerlich, auch sofort an.\n");
            who->command_me("\\ziehe orden an");
        }
        else
        {
            environment()->Message(Name(WER)+" kuckt nichtmal hin.\n");
        }

    }

}

public int 
_query_alcohol()
{ 
    return 100;
}

public string
_query_noattack()
{
    if ((this_player())&& (query_once_interactive(this_player()))&&
        (!IS_SEER(this_player())))
        return "ignoriert Deine Poebelversuche.\n";
    else
        return 0;
}

public mixed
_query_paralyze()
{
    return 0;
}
