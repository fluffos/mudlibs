                      "Grosskreuz des vergossenen Blutes",
                      "Grosskreuz des vergossenen Blutes"}),
            P_GENDER:NEUTER,
            P_MATERIAL:([MAT_MITHRIL:50,MAT_GOLD:10,MAT_RUBY:20, MAT_MAGIC:10, MAT_SILK:5,MAT_BLOOD:5]),
            P_IDS:({"grosskreuz"}),
            "colors":ANSI_BOLD+ANSI_RED
          ]),
        ]);
}


// RenewMedal - auf Anfrage erhaelt der Spieler einen neuen Orden.

public int
RenewMedal()
{
    object env,ob;
    string err;
    if (explode(file_name(previous_object()),"#")[0]!=HONORS_MEDAL)
        return 0;
    
    if (!(env=environment(previous_object()))  ||
               (!query_once_interactive(env)))
        return 0;

    if (IS_ELDER(env)) 
    {
        if (find_object(HONORS_MEDAL))
            destruct(find_object(HONORS_MEDAL));
    }

    /*  
    if  ((find_object(HONORS_MEDAL)) &&
         ((program_time(previous_object())) == 
           program_time(find_object(HONORS_MEDAL))))
    {
        write("Keine Aktualisierungen vorhanden.\n");
        return 0;
    }
    */

    if (err=catch(call_other(HONORS_MEDAL,"???")))
    {
        printf("*** Laden der Blueprint fehlgeschlagen:\n"
                "%s\nBitte Magier verstaendigen.\n",err);
        return 0;
    }
    else if (err=catch(ob=clone_object(HONORS_MEDAL)))
    {
        printf("*** Clonen von der Blueprint fehlgeschlagen:\n"
                "%s\nBitte Magier verstaendigen.\n",err);
        return 0;
    }
    else if (((int)(ob->move(environment(previous_object()),M_NOCHECK)))!=1)
    {
    printf("*** Move des geclonten Objekts fehlgeschlagen:\n"
                "%s\nRollback. Bitte Magier verstaendigen.\n",err);
        ob->remove();
        return 0;
    }
    if (previous_object()->QueryProp(P_WORN)) 
    {
        previous_object()->DoUnwear(1);
        ob->DoWear(1);
    }
    previous_object()->move(this_object(),M_NOCHECK);
    previous_object()->remove();
    return 1;
}


// MedalName - Zu Debug-Zwecken... und die Ordensliste ruft das auch ab.

varargs public string
MedalName(int stage, int colored)
{
    mapping ref;
    closure c;
    if (!member(customizing,stage))
    {
        ref=([])+customizing[-1];
        ref[P_NAME]=map_array(ref[P_NAME],lambda( ({'x,'y}),
                ({#'sprintf , "%s (%s. Grad)" , 'x , 
                ({#'to_string, 'y }) }) ), 
                stage-(sizeof(m_indices(customizing))-2));
    }
    else
        ref=([])+customizing[stage];
    
    if (!objectp(helper))
        helper=clone_object("/std/thing");

    c=symbol_function("SetProp",helper);

    funcall(c,P_NAME_ADJ,ref[P_NAME_ADJ]);
    funcall(c,P_NAME,ref[P_NAME]);
    funcall(c,P_GENDER,ref[P_GENDER]);
    return (colored?ref["colors"]:"")+(string)helper->Name(WER)+(colored?ANSI_NORMAL:"");
}

