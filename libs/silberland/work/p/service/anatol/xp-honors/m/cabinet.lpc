            P_MATERIAL:([MAT_SILVER:85,MAT_SAPPHIRE:5,MAT_LIGHTNING:5,MAT_SILK:5]),
            "colors":ANSI_BOLD+ANSI_GREEN
          ]),

        4:
          ([P_NAME_ADJ:({"gross","tiefenrein"}),
            P_NAME: ({"Verdienstkreuz in Purpur am Bande",
                      "Verdienstkreuzes in Purpur am Bande",
                      "Verdienstkreuz in Purpur am Bande",
