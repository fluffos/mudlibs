            P_MATERIAL:([MAT_SILVER:20,MAT_SAPPHIRE:5, MAT_GOLD:25,MAT_PLATINUM:25,MAT_LIGHT:5,MAT_OPAL:15,MAT_SILK:10]),
            P_IDS:({"kreuz","regenbogenverdienstkreuz","verdienstkreuz"}),
            "colors":ANSI_BOLD+ANSI_YELLOW
          ]),

        7:
          ([P_NAME_ADJ:({"seelenrein"}),
            P_NAME: ({"Gnadengrosskreuz mit Zwillingsstern",
                      "Gnadengrosskreuzes mit Zwillingsstern",
                      "Gnadengrosskreuz mit Zwillingsstern",
                      "Gnadengrosskreuz mit Zwillingsstern"}),
            P_GENDER:NEUTER,
            P_MATERIAL:([MAT_SILVER:25,MAT_GOLD:25,MAT_SAPPHIRE:10, MAT_PLATINUM:40]),
            P_IDS:({"kreuz","gnadengrosskreuz","grosskreuz"}),
            "colors":ANSI_BOLD+ANSI_BLUE
          ]),

        -1:
