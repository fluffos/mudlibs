            P_GENDER:NEUTER,
            P_MATERIAL:([MAT_SILVER:75,MAT_SILK:15]),
            P_IDS:({"kreuz","verdienstkreuz in purpur am bande","verdienstkreuz"}),
            "colors":ANSI_BOLD+ANSI_PURPLE
          ]),
        5:
          ([P_NAME_ADJ:({"lichtgewirkt"}),
            P_NAME: ({"Regenbogenverdienstkreuz am Bande",
                      "Regenbogenverdienstkreuzes am Bande",
                      "Regenbogenverdienstkreuz am Bande",
                      "Regenbogenverdienstkreuz am Bande"}),
            P_GENDER:NEUTER,
            P_MATERIAL:([MAT_SILVER:25,MAT_GOLD:25,MAT_PLATINUM:25,MAT_LIGHT:5,MAT_OPAL:15,MAT_SILK:10]),
            P_IDS:({"kreuz","regenbogenverdienstkreuz","verdienstkreuz"}),
            "colors":ANSI_BOLD+ANSI_YELLOW
          ]),
        6:
          ([P_NAME_ADJ:({"monoheroisch","gross"}),
