#pragma strict_types

#include <properties.h>
#include <ansi.h>
#include <moving.h>
#include "../xp-honors.h"

mapping customizing;
object helper;


// CustomizeMedal - wird vom Orden selbst aufgerufen.

public int
CustomizeMedal()
{
    mapping ref;
    int stage;
    closure c;
    
    if ((file_name(previous_object())[0..(strlen(HONORS_DIR)-1)]  
               != HONORS_DIR)
         || (!environment(previous_object())) 
         || (!query_once_interactive(environment(previous_object()))))
        return 0;

    if ((!stage=QUERY_XPHONOR(environment(previous_object()))) &&
        ((int)(environment(previous_object())->QueryProp(P_XP)) < 1000000000))
        return 0;
    
    if (!member(customizing,stage))
    {
        ref=([])+customizing[-1];
        ref[P_NAME]=map_array(ref[P_NAME],lambda( ({'x,'y}),
                ({#'sprintf , "%s (%s. Grad)" , 'x , 
                ({#'to_string, 'y }) }) ), 
                stage-(sizeof(m_indices(customizing))-2));
    }
    else
        ref=([])+customizing[stage];

    c=symbol_function("SetProp",previous_object());

    if (stage)
        funcall(c,P_AUTOLOADOBJ,1); 

    funcall(c,P_ARTICLE,0);
    funcall(c,P_NAME,ref[P_NAME]);
    funcall(c,P_NAME_ADJ,ref[P_NAME_ADJ]);
    funcall(c,P_GENDER,ref[P_GENDER]);
    funcall(c,P_MATERIAL,ref[P_MATERIAL]);
    funcall(c,"declinated_name",
        (string)(previous_object()->name(WESSEN)));
    funcall(c,P_ARTICLE,1);
    funcall(c,"medal_color",ref["colors"]);
    funcall(c,P_SHORT,
        (string)(previous_object()->Name(WER,1)));
    funcall(c,P_LONG,break_string(sprintf(
        "Ah, %s. Eine Auszeichnung, welche Deine mit unglaublich viel "
        "Durchhaltevermoegen erworbene Erfahrung zu Leben und Sterben "
        "der silberlaendischen Fauna wertschaetzt. %s",
        (string)(previous_object()->name(WER,1)),
        (stage
            ?sprintf("Genaugenommen wurde Dir die Auszeichnung schon %d mal "
                "auf einer hoeheren Stufe verliehen. Gleich was geschieht, "
                "niemand kann Dir die Leistung und die Auszeichnung wieder "
                "aberkennen.",
                stage)
           :"Du darfst diesen Orden tragen, solange Du "
                "mehr als 1'000'000'000 Erfahrungspunkte besitzst."
        )
        ),77));
    previous_object()->AddId(({"\a\n\a\tol_auszeichnung",
            "auszeichnung"})+ref[P_IDS]);
    return 1;
}

public void
create()
{
    if (is_clone(this_object()))
        return;
    customizing= ([ 
        0: ([
            P_NAME_ADJ:({"klein"}),
            P_NAME: ({"Verdienstorden in Silber",
                      "Verdienstordens in Silber",
                      "Verdienstorden in Silber",
                      "Verdienstorden in Silber"}),
            P_GENDER:MALE,
            P_MATERIAL:([MAT_SILVER:95,MAT_SILK:5]),
            P_IDS:({"orden","verdienstorden"}),
            "colors":ANSI_NORMAL
           ]),

        1:
           ([
            P_NAME_ADJ:({"gross"}),
            P_NAME: ({"Verdienstorden in Silber mit Stern",
                      "Verdienstordens in Silber mit Stern",
                      "Verdienstorden in Silber mit Stern",
                      "Verdienstorden in Silber mit Stern"}),
            P_GENDER:MALE,
            P_MATERIAL:([MAT_SILVER:90,MAT_EMERALD:5,MAT_SILK:5]),
            P_IDS:({"orden","verdienstorden"}),
            "colors":ANSI_BOLD+ANSI_WHITE
           ]),

        2:
           ([
            P_NAME_ADJ:({"kaltgeschmiedet"}),
            P_NAME: ({"Verdienstkreuz in Echtsilber",
                      "Verdienstkreuzes in Echtsilber",
                      "Verdienstkreuz in Echtsilber",
                      "Verdienstkreuz in Echtsilber"}),
            P_GENDER:NEUTER,
            P_MATERIAL:([MAT_SILVER:88,MAT_ICE:2,MAT_LIGHTNING:5,MAT_SILK:5]),
            P_IDS:({"kreuz","verdienstkreuz"}),
            "colors":ANSI_BOLD+ANSI_CYAN
           ]),

        3:
          ([P_NAME_ADJ:({"dreigefaltet","gross"}),
            P_NAME: ({"Verdienstkreuz mit Stern",
                      "Verdienstkreuzes mit Stern",
                      "Verdienstkreuz mit Stern",
