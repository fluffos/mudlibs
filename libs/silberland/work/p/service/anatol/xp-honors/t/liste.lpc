/* Liste der Ordensempfaenger
 * __________________________________________(i) Anatol@Silberland (2012) */


#pragma strict_types

#include "../xp-honors.h"
#include <properties.h>
#include <ansi.h>

string my_current_long;

inherit "/std/thing";

public void
create()
{
    if (!is_clone(this_object()))
        return;
    ::create();

    seteuid(getuid(this_object()));

    SetProp(P_WEIGHT, 250); 
    SetProp(P_VALUE, 100); 
    SetProp(P_MATERIAL,([MAT_PAPER]));
    AddId(({"\a\n\a\tol_list_of_xp_honor","liste"})); 
    SetProp(P_NAME,"Liste");
    AddAdjective(({"verschmiert"}));
    SetProp(P_NAME_ADJ,({"verschmiert"}));
    SetProp(P_GENDER,FEMALE);
    SetProp(P_SHORT,"Eine verschmierte Liste");
    SetProp(P_LONG,"Das muessen Feldwebel a.D. Kuniberts Aufzeichnungen "
        "sein. Offenbar hat er sich aufgeschrieben, wem er wann welchen "
        "Orden 'verlieh'. Na, zumindest die etwas wichtigeren. Bloederweise "
        "ist alles total verwischt. Grossartig.");
    SetProp("i_am_still_good",2);
}



nosave void
updateLong()
{
    int i;
    int stufe;
    mixed data;

    my_current_long=
      ".---  ---------------------- - --- ----- \n"
      "|  Au zei hn ng ueber verlie  ne Orden  |\n"
      "'---- ----------- -------- ---  --- ----'\n";

    data=(mixed)HONORS_MASTER->GetToplistArray();
   
    for (i=0;i<sizeof(data);i++)
    {
        if (stufe!=data[i][1])
            my_current_long+=
                "\n"+(string)HONORS_CABINET->MedalName(stufe=data[i][1])
                +":\n";

        my_current_long+=sprintf("%13s - verliehen am %s\n",
            capitalize(data[i][0]), dtime(data[i][2])[5..16]);
    }
    my_current_long+="\n";
    return;
}

/* Krueckenloesung, damit die Liste nicht mehr aktualisiert wird, wenn
 * sie nicht mehr in Kunibert ist */

varargs public int 
move(mixed dest, int method)
{
    if (QueryProp("i_am_still_good"))
    {
        SetProp("i_am_still_good",QueryProp("i_am_still_good")-1);
        updateLong();
    }
    return ::move(dest,method);
}


public string
_query_long()
{
    if (QueryProp("i_am_still_good"))
        updateLong();
    return my_current_long;
}

