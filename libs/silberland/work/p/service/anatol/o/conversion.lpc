// v 1.0 20120414-141634 Release

/*
 * ----------------------------------------------------------------------
 * string int2roman(int i)    
 * 
 *    wandelt i (0<i<=100000) in eine roemische Zahl um. Die groesste
 *    roemische Einheit ist hier das "M" fuer 1000. Zahlen ausserhalb
 *    des gueltigen Bereichs werden mit 0 quittiert.
 * 
 * ----------------------------------------------------------------------
 * int roman2int(string r)      
 * 
 *    Versucht, r als roemische Zahl einzulesen und als int auszugeben.
 *    Invalide roemische Zahlen werden mit -1 abgewiesen.
 *
 * ----------------------------------------------------------------------
 * int dtime2int(string dt)
 *
 *    Nimmt einen Zeitstempel im dtime()-Format und wandelt ihn in 
 *    eine Integer-Zeitstempel, d.h. Sekunden seit 1. Januar 1970, um. 
 *    Ein negativer Rueckgabewert weist auf einen Fehler hin.
 *
 */

#pragma strict_types

public void create() {
    if (is_clone(this_object())) 
        return (void)destruct(this_object());
}

public int query_prevent_shadow() { return 1; }

// ======================================================================
//               Roemisch --> Integer, Integer --> Roemisch
// ======================================================================

/* Hier gelten roemische Zahlen mit Subtraktionsregeln in der 
 * heute ueblichen Darstellung mit lateinischen Buchstaben (IVXLCDM)
 * und der Apostrophus-Schreibweise fuer grosse Zahlen, sollte das
 * je jemand abrufen, hierbei ist etwa  |)) = 5000, (((|))) = 100000
 * (das D fuer die 500 verbleibt jedoch und wird nicht als |) 
 * dargestellt, ebenso behaelt dasseit ~ 100 n.Chr. uebliche M
 * den 1000er-Platz und nicht etwa (|).
 * Die Null gab es in roemischer Darstellung weitgehend nicht.
 */

/* Roemische Zahlen generieren.... ziemlich straightforward 
 * Im Fehlerfall wird 0 (nicht ""!) zurueckgegeben, und zwar
 * dann, wenn der Uebergabewert keine Integer, kleiner null 
 * oder einfach ueber einem gewissen Limit liegen. 
 * Fuer den numerischen Wert 0 wird "" zurueckgegeben. */

#define MAX_INTEGER_FOR_ROMAN 399999

public string int2roman(int input) {
    string output;  
    if ((!intp(input)) || (input<0) || (input>MAX_INTEGER_FOR_ROMAN)) return 0;
    if (!input) return "";
    output="";
    while ((input>=100000) && (output+="(((|)))") )      input-=100000;
    if (   (input>= 90000) && (output+="((|))(((|)))") ) input-= 90000;
    if (   (input>= 50000) && (output+= "|)))") )        input-= 50000;
    if (   (input>= 40000) && (output+="((|))|)))") )    input-= 40000;
    while ((input>= 10000) && (output+= "((|))") )       input-= 10000;
    if (   (input>=  9000) && (output+="M((|))") )       input-=  9000;
    if (   (input>=  5000) && (output+= "|))") )         input-=  5000;
    if (   (input>=  4000) && (output+="M|))") )         input-=  4000;
    while ((input>=  1000) && (output+= "M") )           input-=  1000;
    if (   (input>=   900) && (output+="CM") )           input-= 900;
    if (   (input>=   500) && (output+= "D") )           input-= 500;
    if (   (input>=   400) && (output+="CD") )           input-= 400;
    while ((input>=   100) && (output+= "C") )           input-= 100;
    if (   (input>=    90) && (output+="XC") )           input-=  90;
    if (   (input>=    50) && (output+= "L") )           input-=  50;
    if (   (input>=    40) && (output+="XL") )           input-=  40;
    while ((input>=    10) && (output+= "X") )           input-=  10;
    if (   (input>=     9) && (output+="IX") )           input-=   9;
    if (   (input>=     5) && (output+= "V") )           input-=   5;
    if (   (input>=     4) && (output+="IV") )           input-=   4;
    while ((input>=     1) && (output+= "I") )           input-=   1;
    return output;
}

/* Um roemische Zahlen in die ueblichen lateinischen zu wandeln, ist der 
 * Aufwand ein kleinwenig groesser, da wirklich alle falschen 'roemischen' 
 * Zahlen zurueckgewiesen werden sollen. Hier braucht es dann auch eine 
 * Hilfsfunktion, da die String-Operationen doch von umfangreicherer 
 * Natur sind. 
 *
 * Im Fehlerfall werden negative Werte zurueckgegeben:
 *   -1 Uebergabewert technisch unzulaessig.
 *   -2 Uebergabewert inhaltlich unzulaessig. */

private nosave string reduceRoman(string sy, string re) {
    if ((strlen(re)<strlen(sy)) || (re[0..(strlen(sy)-1)]!=sy)) return re;
    else return re[(strlen(sy))..];
}
 
 
public int roman2int(string input) {
    int output;
    if ((!stringp(input)) || (!input) ) return -1;
    if ((input=upperstring(input))=="") return 0;
    output=0;
    while   (input != input=reduceRoman("(((|)))",input))      output+=100000;
    if      (input != input=reduceRoman("((|))(((|)))",input)) output+= 90000;
    else if (input != input=reduceRoman("((|))|)))",input))    output+= 40000;
    else {
        if  (input != input=reduceRoman("|)))",input))         output+= 50000;
        if  (input != input=reduceRoman("((|))",input))        output+= 10000;
        if  (input != input=reduceRoman("((|))",input))        output+= 10000;
        if  (input != input=reduceRoman("((|))",input))        output+= 10000;
    }
    if      (input != input=reduceRoman("M((|))",input))       output+=  9000;
    else if (input != input=reduceRoman("M|))",input))         output+=  4000;
    else {
        if  (input != input=reduceRoman("|))",input))          output+=  5000;
        if  (input != input=reduceRoman("M",input))            output+=  1000;
        if  (input != input=reduceRoman("M",input))            output+=  1000;
        if  (input != input=reduceRoman("M",input))            output+=  1000;
    }
    if      (input != input=reduceRoman("CM",input))           output+=   900;
    else if (input != input=reduceRoman("CD",input))           output+=   400;
    else {
        if  (input != input=reduceRoman( "D",input))           output+=   500;
        if  (input != input=reduceRoman( "C",input))           output+=   100;
        if  (input != input=reduceRoman( "C",input))           output+=   100;
        if  (input != input=reduceRoman( "C",input))           output+=   100;
    }
    if      (input != input=reduceRoman("XC",input))           output+=    90;
    else if (input != input=reduceRoman("XL",input))           output+=    40;
    else {
        if  (input != input=reduceRoman("L",input))            output+=    50;
        if  (input != input=reduceRoman("X",input))            output+=    10; 
        if  (input != input=reduceRoman("X",input))            output+=    10;
        if  (input != input=reduceRoman("X",input))            output+=    10;
    }
    if      (input != input=reduceRoman("IX",input))           output+=     9;
    else if (input != input=reduceRoman("IV",input))           output+=     4;
    else {
        if  (input != input=reduceRoman("V",input))            output+=     5;
        if  (input != input=reduceRoman("I",input))            output+=     1;
        if  (input != input=reduceRoman("I",input))            output+=     1;
        if  (input != input=reduceRoman("I",input))            output+=     1;
    }  
    if (input!="") return -2;
    else return output;
}

/* ======================================================================
 *                    dtime()-String --> Integer
 * ======================================================================
 * Konvertiert eine dtime()-Zeichenkette in eine Integer, die die seit
 * 1.1.1970 00:00:00 vergangenen Sekunden enthaelt. Der String wird auch
 * angenommen, wenn der Wochentagspraefix fehlt oder unvollstaendig ist,
 * es werden lediglich die letzten 23 Zeichen beruecksichtigt.
 * "Sam, 14. Apr 2012, 12:29:05"
 *  ^^^^^\__optional
 * Eine grobe Syntaxpruefung wird durchgefuehrt. Negative Rueckgabewerte
 * weisen auf einen Fehler hin, zu Debug-Zwecken gibt es davon recht
 * viele... 
 *
 * OBACHT, dtime() macht natuerlich die Uhrumstellung mit, d.h. waehrend
 * CEST / DST verweist dtime(0) nicht auf Mitternacht zum 1.1.1970, sondern
 * auf 1 Uhr. dtime2int(" 1. Jan 1970, 00:00:00") wuerde dann -3600 liefern.
 * Negative Werte werden auf einen (einzigen) negativen Fehlercode gemappt.
 */

#define SECONDS(x) 	to_int(x[25..26])
#define MINUTES(x) 	to_int(x[22..23])
#define HOURS(x) 	to_int(x[19..20])
#define DAYS(x) 	to_int(x[5..6])
#define MONTHS(x) 	(month[(x[9..11])])
#define YEARS(x) 	(to_int(x[13..16])-1970)

#define ONE_YEAR	31622400   // 366 Tage, geht eh nur bis 2038 ...
#define ONE_MONTH	2678400    // 31 Tage
#define ONE_DAY		86400
#define ONE_HOUR	3600
#define ONE_MINUTE	60

public int dtime2int(string dt) {
    mapping month;
    int result;

    if (!stringp(dt) || strlen(dt)>27 || strlen(dt)<22 ) 
        return -1;

    dt = "     "+dt[<22..];

    if ( (dt[7..8]+dt[12..12]+dt[17..18]+dt[21..21]+dt[24..24]) != ".  , ::" )
       return -2;


    month= ([ "Jan":0, "Feb":1, "Mar":2, "Apr":3, "Mai":4, "Jun":5,
          "Jul":6, "Aug":7, "Sep":8, "Okt":9, "Nov":10, "Dez":11 ]);

    if (YEARS(dt) < 0) return -10;
    result=YEARS(dt)*ONE_YEAR;
    if (YEARS(dt) != YEARS(dtime(result))) return -11;
    result+=(MONTHS(dt)-MONTHS(dtime(result)))*ONE_MONTH;
    if (YEARS(dt) != YEARS(dtime(result))) return -12;
    if (MONTHS(dt) != MONTHS(dtime(result))) return -13;
    result+=(DAYS(dt)-DAYS(dtime(result)))*ONE_DAY;
    if (YEARS(dt) != YEARS(dtime(result))) return -14;
    if (MONTHS(dt) != MONTHS(dtime(result))) return -15;
    if (DAYS(dt) != DAYS(dtime(result))) return -16;
    result+=(HOURS(dt)-HOURS(dtime(result)))*ONE_HOUR;
    if (YEARS(dt) != YEARS(dtime(result))) return -17;
    if (MONTHS(dt) != MONTHS(dtime(result))) return -11;
    if (DAYS(dt) != DAYS(dtime(result))) return -19;
    if (HOURS(dt) != HOURS(dtime(result))) return -20;
    result+=(MINUTES(dt)-MINUTES(dtime(result)))*ONE_MINUTE;
    if (YEARS(dt) != YEARS(dtime(result))) return -21;
    if (MONTHS(dt) != MONTHS(dtime(result))) return -22;
    if (DAYS(dt) != DAYS(dtime(result))) return -23;
    if (HOURS(dt) != HOURS(dtime(result))) return -24;
    if (MINUTES(dt) != MINUTES(dtime(result))) return -25;
    result+=(SECONDS(dt)-SECONDS(dtime(result)));

    // Ergebnis negativ? Im Sommer ist der Nullpunkt nicht 
    // 1.1.1970 Mitternacht, sondern 1 Uhr.

    if (result < 0) return -3;

    if (dtime(result)[5..] != dt[5..]) 
        return -99;  // Monat evtl. nicht okay gewesen
    return result;
}

