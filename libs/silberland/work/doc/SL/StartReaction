
void StartReaction(string verb, string gruppe, string adverb, int touch)

StartReaction wird im 'Opfer' eines Soul-Kommandos aufgerufen.
verb ist immer das jeweile verb (in der kuerzesten form)
gruppe ist die verbengruppe ( fies, intim, nett, froh, albern, neutral,
  traurig, aergerlich, frech )
adverb ist das angegeben adverb
touch ist 1, wenn beim verb eine Beruehrung dabei ist, ansonsten 0

knuddel igel -> Im Igel wird StartReaction mit folgenen Parametern aufgerufen:
verb= knuddel, gruppe=nett, adverb=0, touch=1
Da es eine Beruehrung ist, koennte der Knuddlende sich an den Stacheln stechen
und HP verlieren.

Tiere reagieren meist nur auf Beruehrung, Humanoide dagegen sollten auf
fast alle Dinge irgendwie reagieren. Mutige Kaempfer werden sicher
zurueckschlagen wenn man sie haut oder tritt. Und manche Leute werden einen
Kampf mit einem frechen Spieler anfangen. Das alles kann man mittels
StartReaction ganz einfach implementieren.

hier ein Beispiel fuer eine gesamte StartReaction Abfrage:

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; // Nicht zu viele Reactions!
  switch(gruppe) 
  {
    case "fies":
      if( random(2) )
        call_out("react", 0, "sagt: Du bist gemein!",
          "sagt: "+TP->name(WER)+" ist gemein!");
      else
        call_out("angriff",0);
      break;
    case "aergerlich":
      call_out("react", 0, "fragt: Warum aergerst Du Dich, "+TPN+"?",0);
      break;
    case "traurig":
      call_out("react", 0, "troestet Dich.",
             "troestet "+TP->name(WEN)+".");
      break;
    case "albern":
      call_out("react", 0, "kichert.",0);
      break;
    case "neutral":
      call_out("react", 0, "grinst Dich an.", "grinst "+TP->name(WEN)+" an.");
      break;
    case "intim":
      call_out("react", 0, "kuesst Dich.", "kuesst "+TP->name(WEN)+".");
      break;
    case "froh":
      call_out("react", 0, "laechelt Dich froehlich an.",
             "laechelt "+TP->name(WEN)+" froehlich an.");
      break;
    case "aengstlich":
      call_out("react", 0, "floesst Dir neuen Mut ein.",
             "floesst "+TP->name(WEM)+" neuen Mut ein.");
      break;
    case "frech":
      call_out("react", 0, "fiept Dich an.", "fiept "+TP->name(WEN)+" an.");
      break;
    case "nett":
      call_out("react", 0, "knuddelt Dich.", "knuddelt "+TP->name(WEN)+".");
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

void angriff()
{
  if (present(TP, ENV(TO))) 
  {
    tell_room(ENV(TO), Name(WER, 1)+" schreit: DAFUER WIRST DU STERBEN!\n");
    Kill(TP);
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

