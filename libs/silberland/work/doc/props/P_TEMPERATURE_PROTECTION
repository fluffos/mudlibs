NAME:
    P_TEMPERATURE_PROTECTION      "temperature_protection"

DEFINIERT IN:
    /sys/armour.h

BESCHREIBUNG:
    Mapping aus zwei numerischen Werten, die den Temperaturschutz eines
    Ruestungsteils angeben, und zwar getrennt in Schutz vor Kaelte sowie
    Hitzeschutz. Positive Werte stellen einen Schutzwert dar, negative
    hingegen eine zusaetzliche Belastung.
    Die entsprechenden Keys fuer das Mapping lauten T_COLD_PROT bzw.
    T_HEAT_PROT.

BEISPIEL:
    // Ein Helm, der vor Kaelte schuetzt, aber auch etwas vor Sonne:
    SetProp( P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:2, T_HEAT_PROT:1 ]) );

BEMERKUNGEN:
    Ruestungen haben sinnvolle Defaultwerte, je nach Ruestungstyp.
    AT_ARMOUR:   ([ T_COLD_PROT: 4, T_HEAT_PROT: -3 ]);
    AT_CLOAK:    ([ T_COLD_PROT: 4, T_HEAT_PROT: -1 ]);
    AT_HELMET:   ([ T_COLD_PROT: 2, T_HEAT_PROT: 1 ]);
    AT_TROUSERS: ([ T_COLD_PROT: 3, T_HEAT_PROT: -1 ]);
    AT_GLOVE:    ([ T_COLD_PROT: 2, T_HEAT_PROT: -1 ]);
    AT_BOOT:     ([ T_COLD_PROT: 2, T_HEAT_PROT: 0 ]);
    AT_BRACERS:  ([ T_COLD_PROT: 1, T_HEAT_PROT: 0 ]);
    AT_SHIELD:   ([ T_COLD_PROT: 0, T_HEAT_PROT: 3 ]);

SIEHE AUCH:
    P_TEMPERATURE_OFFSET, P_TEMPERATURE_RANGE, P_ENVIRONMENT,
    temperatur

