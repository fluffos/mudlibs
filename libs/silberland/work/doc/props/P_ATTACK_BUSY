NAME:
    P_ATTACK_BUSY                 "attack_busy"                 

DEFINIERT IN:
    /sys/living/combat.h

BESCHREIBUNG:
    Kann der Spieler noch Spezialwaffen (zB Flammenkugel) einsetzen?

    Die Verwendung erfolgt folgendermassen:

    Der Spieler will eine Spezialwaffe einsetzen, dies geschieht in
    der Regel mit einem Kommando ("wirf kugel nach monster"). Sobald
    dies erfolgt, kann die zugehoerige Funktion durch Abfrage der
    Property P_ATTACK_BUSY ermitteln, ob der Spieler nichts bereits
    zu beschaeftigt fuer eine zusaetzliche Kampfrunde ist. Ist dem
    so, so ist P_ATTACK_BUSY gesetzt und eine entsprechende Ausgabe
    an den Spieler auszugeben ("Was, jetzt, wo Du alle Haende voll
    zu tun hast, willste auch noch eine Flammenkugel werfen?" o.ae.).

    Ist der Spieler hingegen nicht beschaeftigt, und spricht auch sonst
    nichts dagegen (fehlende Magiepunkte, etc.), so ist P_ATTACK_BUSY
    zu setzen; in der Regel auf 1, ist die Spezialwaffe jedoch etwas
    maechtiger, durchaus auch auf 2 oder 3, um den uebermaessigen Ge-
    brauch von Spezialwaffen in einer Kampfrunde zu reduzieren. Je nach
    Stufe und Geschicklichkeit hat man pro Kampfrunde maximal 3 bis 8
    Zusatzaktionen, wobei das An- und Ausziehen von Ruestungen im Kampf
    sowie das Wegstecken und Zuecken von Waffen ebenfalls als eine
    Aktion gewertet wird.

BEMERKUNGEN:
    Beachte bitte, dass Spezialwaffen mit Sonderrunden erst durch das
    Balance-Team geprueft werden muessen, da sie in der Regel ziemlich
    maechtig sind und die Balance gefaehrden koennten.

BEISPIEL:

    int flammenkugel(string str)
    {
      object gegner;
      if (!str) {
        if (!gegner=this_player()->SelectEnemy())
          return write("Aber Du kaempfst doch gar nicht!\n"),1;
      } else {
        if (!gegner=present(str,environment(this_player())))
          return write("So jemanden siehst Du hier nicht!\n"),1;
        if (gegner==this_player())
          return write("Das waere viel zu gefaehrlich!\n"),1;
        if (!living(gegner))
          return write("Aber "+gegner->name()+" lebt doch gar nicht!\n"),1;
      }
      if (this_player()->QueryProp(P_SP)<10)
        return write("Dazu fehlt Dir derzeit die Konzentration.\n"),1;
      if (this_player()->QueryProp(P_ATTACK_BUSY))
        return write("Du bist im Moment zu sehr beschaeftigt.\n"),1;
      this_player()->SetProp(P_ATTACK_BUSY, 1);
      this_player()->AddSp(-10);
      gegner->Defend(150+random(150), ({ DT_FIRE }),
          ([ SP_NAME:"flammenkugel",SP_PHYSICAL_ATTACK:0,SP_SHOW_DAMAGE:1 ]),
          this_player() );
    }

