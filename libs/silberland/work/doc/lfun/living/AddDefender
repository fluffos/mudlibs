FUNKTION:
     void AddDefender(object friend)

DEFINIERT IN:
     /std/living/combat.c

ARGUMENTE:
     friend - der neue Verteidiger

BESCHREIBUNG:
     Prueft die Validitaet eines neuen Verteidigers und traegt ihn gegebenen-
     falls in P_DEFENDERS ein. Somit wird "friend" bei einem Angriff auf das
     Objekt, in dem AddDefender aufgerufen wurde mit InformDefend informiert
     und mit DefendOther eventuell zur direkten Verteidigung aufgerufen.

BEISPIEL:
     // init()
     // Wird aufgerufen, sobald sich zwei Objekte, von denen mindestens eines
     // ein Living ist, begegnen. this_player() (TP) ist in diesem Fall das
     // entsprechende Objekt, das uns begegnet - wir pruefen, ob es sich um
     // einen Freund handelt, und wenn ja, kommt er in unsere
     // Defender-Liste. Er verteidigt uns also bei Bedarf, weil dann
     // InformDefend in ihm aufgerufen wird...
     void init()
     {
       ::init();
       if (TP && TP->id("ZuInformierenBeiBedarf")) AddDefender(TP);
     }

     // InformDefend()
     // Wird aufgerufen, sobald ein Feind einen unserer Freunde (Defender)
     // angreift. Weil uns nix besseres einfaellt machen wir hier nix
     // vorerst mal anderes als den Gegner anzugreifen...
     //
     void InformDefend(object enemy)
     {
       Kill(enemy);
     }

SIEHE AUCH:
     P_DEFENDERS, DefendOther(L), InformDefend(L)

