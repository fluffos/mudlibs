
#include "../def.h"

inherit "std/room";

#include <properties.h>

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "" );
  SetProp( P_INT_LONG,
    "" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");

  AddSound( ({ "" }),
    "");

  AddSmell( DEFAULT_SMELL,
    "");

  AddSmell( ({ "" }),
    "");

  AddRoomMessage( 
    ({""}),30,"func");

  AddCmd( ({ "tue" }), "command" );

  AddExit( "norden", "nach Norden#" + "./room2" );

  AddItem( "item" , REFRESH_DESTRUCT);
}

command(string str )
{
  notify_fail( "Was willst Du tun?\n" );
  if( str == "tuer" )
  {
    write("Du tust etwas.\n");
    say( PLN+" tut etwas.\n");
    return 1;
  }
  return 0;
}
