FUNKTION
  int obtain_skill(object pl);


DEFINIERT IN
  /p/daemon/skillmaster/skills/sk_<skillname>.c


BESCHREIBUNG
  obtain_skill() dient zum initialisieren des Skills in einem Spieler welcher
  diesen Skill noch nicht besitzt. Diese Funktion ist ausgegliedert eine 
  eigene kleine Master-Programme (fuer jeden Skill eines)


ARGUMENTE
  player     ... Der Spieler der den neuen Skill erhalten soll


RUECKGABEWERT
  Integerwert
  1 ... gelungen


SIEHE AUCH
  skillmaster


BEISPIEL (SK_SEWING)
-----------------------------------------------------------
#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
#include "../skillmaster.h" 

void create()
{
  if (is_clone(TO)) {
    destruct(this_object());
    return ;
  }
  SUID; 
}

nomask int query_prevent_shadow() { return 1; }

int obtain_skill(object pl) {
  int start_skill, maxskill, maxunlearn;
  int x;
  switch(pl->QueryProp(P_RACE)) {
    case "Zwerg": start_skill=2300; maxskill=10000; maxunlearn=9000; break;
    case "Elf": start_skill=2300; maxskill=10000; maxunlearn=9000; break;
    case "Dunkelelf": start_skill=2300; maxskill=10000; maxunlearn=9000; 
    break;
    case "Fee": start_skill=2300; maxskill=10000; maxunlearn=9000; break;
    case "Oger": start_skill=200; maxskill=7950; maxunlearn=3000; break;
    case "Troll": start_skill=200; maxskill=7950; maxunlearn=3000; break;
    default: start_skill=2200; maxskill=9999; maxunlearn=9000;
  }
  SKILLMASTER->AddSkill(pl, SK_SEWING, start_skill, maxskill,
      maxunlearn, SK_SEWING_NAME);
  return 1;
}
