// A corpse.
// 
// Ekeltexte by Boing
//
// This is a decaying corpse. It is created automatically
// when a player or monster dies.

#pragma strong_types

inherit "std/container";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
#include <combat.h>

// Potion-Verwaltung
// aber nicht fuer die Distribution!
#if (__HOST_NAME__==MUDHOST)
#define CORPSED "/p/daemon/corpsed/corpsed"
#endif

#define PROP_CORPSE_DECAY_TIME "corpse_decay"

/* private vars */
private nosave int _decay;
private nosave string _name;
private nosave string _short_addon="";
private nosave int already_jeered=0;
private nosave string _adverb="";

/* prototypes */
void Identify(object ob);
void do_decay();
void gegessen();
int QueryDecay();
nosave int mampf(string str);
nosave int spott(string str);
nosave int DoMurderMsg(object npc, object pl);
void ChannelMessage(object ob);
void ChannelMessageJeer(mixed sender, string text, int flag);


ENVCHECKPROC

void create()
{
  ::create();
  if(is_clone(this_object()))
  {
    AddId( ({ "leiche","reste","ueberreste","rest","ueberrest" }) );
    AddId("Leiche");
    SetProp( P_GENDER, FEMALE );
    SetProp(P_NAME, "Leiche");
    SetProp(P_KILL_MSG,"Du bist was Du isst...");
    SetProp(P_MATERIAL, MAT_MISC_DEAD);
    SetProp(PROP_CORPSE_DECAY_TIME,30);
  }
  else {
    SetProp(P_NAME, "Eine Leiche");
    SetProp(P_ARTICLE, 0);
  }
  seteuid(getuid(this_object()));
}

void init()
{
  ::init();
  add_action("mampf", "iss");
  add_action("mampf", "ess");
  add_action("mampf", "verspeis");
  add_action("mampf", "verspeise");
  add_action("spott", "spotte");
  add_action("spott", "espotte");
  add_action("spott", "gspotte");
}

/* Damit die Leiche nicht voll wird... */
int MayAddWeight(mixed weight)
{
  return 0;
}

/* Uebernehme den Namen von ob */
void Identify(object ob)
{
  int level,i;
  object potion;
  mapping dam2adverb;
  string *possible_adverbs;
  string *last_damtypes; 
  dam2adverb=([DT_FIRE: " verkohlte", 
               DT_COLD: " tiefgefrorene", 
               DT_EXPLOSION: " zerfetzte", 
               DT_LIGHTNING: " verkohlte", 
               DT_ELECTRIC: " verkohlte",
               DT_ACID: " veraetzte", 
               DT_UNHOLY: " verstuemmelte",
               DT_WATER: " aufgeweichte", 
               DT_SQUEEZE: " zerquetschte",
               ]);
  possible_adverbs=({});
  AddId( "leiche\n" + file_name(ob) );
  _name = ob->name(WESSEN,0);
  last_damtypes=ob->QueryProp(P_LAST_DAMTYPES);
  SetProp(P_LAST_DAMTYPES, last_damtypes);
 
  if (ob->QueryProp("berserker_spalten"))
    possible_adverbs = ({" gespaltene"});
  else
    for (i=sizeof(last_damtypes)-1;i>=0;i--) {
      if(member(dam2adverb, last_damtypes[i]))
        possible_adverbs+=({dam2adverb[last_damtypes[i]]});
    }
  if(!sizeof(possible_adverbs)) {
    _adverb="";
    SetProp(P_LONG, "Du siehst die sterblichen Ueberreste "+ _name + ".\n");
  }
  else {
    _adverb=possible_adverbs[random(sizeof(possible_adverbs))];
    SetProp(P_LONG, "Du siehst die"+_adverb+"n Ueberreste "+ _name + ".\n");
  }
  SetProp(P_SHORT, "Die"+_adverb+" Leiche "+_name);
  _decay = 6;
  level=ob->QueryProp(P_LEVEL);
  SetProp(P_LEVEL, level);

  SetProp(P_ORIG_NAME, ob->name(RAW));
  SetProp(P_ORIG_FILENAME, explode(file_name(ob),"#")[0]);
  SetProp(P_RACE, ob->QueryProp(P_RACE));
  SetProp(P_SIZE, ob->QueryProp(P_SIZE));
  //SetProp(P_WEIGHT, ob->QueryProp(P_WEIGHT));
  SetProp(P_KILLER, ob->QueryProp(P_KILLER));
  SetProp(P_ATTRIBUTES, ob->QueryProp(P_ATTRIBUTES));
  SetProp(P_LAST_DAMTYPES, ob->Query(P_LAST_DAMTYPES));
  SetProp(P_ALIGN, ob->QueryProp(P_ALIGN));
  SetProp(P_RESISTANCE_STRENGTHS, ob->QueryProp(P_RESISTANCE_STRENGTHS));
  SetProp(P_HANDS, ob->QueryProp(P_HANDS));
  SetProp(P_MAX_HANDS, ob->QueryProp(P_MAX_HANDS));
  SetProp(P_NOMAGIC, ob->QueryProp(P_NOMAGIC));
  
  // groesere Gegner geben jetzt immer ein paar LE!
  if((ob->QueryProp(P_HEAL) == 0) && (level > 10)) {
    SetProp(P_HEAL, (level-10)/5+1);
  }
 
  // Potion-Verwaltung
  if(!query_once_interactive(ob)) 
  {
    "/std/corpse"->ChannelMessage(ob);
#if (__HOST_NAME__==MUDHOST)
    catch(CORPSED->cloneitems(ob));
#endif
  }
  else
  {
    AddId( ({"Spielerleiche", "Spielerleiche_" + getuid(ob)}) );
    SetProp(PROP_CORPSE_DECAY_TIME, 50);
  }

  call_out("do_decay", QueryProp(PROP_CORPSE_DECAY_TIME));
}

/*
 * Prevents tampering with the master object
 */
int query_prevent_shadow() { return 1; }

void do_decay()
{
  _decay -= 1;
  if (_decay > 0) 
  {
    switch(_decay)
    {
      case 5: SetProp(P_SHORT,"Die leicht stinkende"+_adverb+" Leiche "+_name+
                  _short_addon);
              if(random(2)) tell_room(environment(ME),BS(
                "Die Leiche "+_name+" faengt langsam an zu stinken."));
              break;
      case 4: SetProp(P_SHORT,"Die bereits ziemlich stinkende"+_adverb+" Leiche "+_name+
                  _short_addon);
              if(random(2)) tell_room(environment(ME),BS(
                "Die stinkende Leiche "+_name+" faengt langsam an zu verschimmeln."));
              break;
      case 3: SetProp(P_SHORT,"Die leicht schimmelnde"+_adverb+" Leiche "+_name+
                  _short_addon);
              if(random(2)) tell_room(environment(ME),BS(
                "Die schimmelige Leiche "+_name+" schimmelt stark weiter."));
              break;
      case 2: SetProp(P_SHORT,"Die halbverweste und schimmelnde Leiche "+_name+
                  _short_addon);
              if(random(2)) tell_room(environment(ME),BS(
                "Die verschimmelte Leiche "+_name+" faengt an zu verwesen!"));
              if ( QueryProp( P_HEAL ) >= -5 )
                SetProp( P_HEAL, -5 );
              break;
      case 1: SetProp(P_SHORT,"Die verfaulten Einzelteile "+_name+
                  _short_addon);
              tell_room(environment(ME),BS(
                "Die halbverweste Leiche "+_name+" faengt an zu verfaulen! IGITT!!!"));
              SetProp( P_HEAL, -10 );
              break;
	    }
    call_out("do_decay", QueryProp(PROP_CORPSE_DECAY_TIME));
    return;
  }
  tell_room(environment(ME),BS(
    "Die verfaulte Leiche "+_name+" zerfaellt zu Staub."));
  ME->remove();
}

varargs string GetSmell(mixed key, mixed race) {
  switch(_decay) {
    case 6: return "Die Leiche riecht noch sehr frisch.\n";
            break;
    case 5: return "Die Leiche riecht schon nicht mehr frisch.\n";
            break;
    case 4: return "Die Leiche stinkt bereits vor sich hin.\n";
            break;
    case 3: return "Die Leiche riecht schimmelig.\n";
            break;
    case 2: return "Die Leiche verbreitet einen widerlichen Verwesungsgeruch.\n";
            break;
    case 1: return "Die Leiche stinkt bestialisch gen Himmel. PFUI!\n";
            break;
    default:
    case 0: return "Die Leiche stinkt bestialisch.\n";
            break;

  }
}

varargs string GetSound(mixed key, mixed race) {
  return "Die Leiche ist totenstill, was denkst Du denn?\n";
}

void gegessen() {}

int QueryDecay() { return _decay; }

varargs int remove()
{
  // units bekommen eine Chance zur Vereinigung...
  filter_objects( all_inventory(ME), "move", environment(ME), M_SILENT );
  return ::remove();
}

int mampf(string str)
{
  int heal;

  notify_fail("Was moechtest Du essen?\n");
  if (!str || !id(str)) return 0;
  if (!this_player()->eat_food(((int)QueryProp(P_SIZE)/10) || 1)) return 1;
  // if (!this_player()->eat_food(QueryProp(P_WEIGHT)/5000 || 1)) return 1;
  say(sprintf("%s wird von %s voll Hingebung verspeist.\n",
	      Name(WER), this_player()->name(WEM)));
  if ( ( heal = QueryProp(P_HEAL) ) < 0 )
  {
    this_player()->do_damage(random(-heal+1), this_object());
    write("Buah, diese Leiche war zweifellos nicht besonders gesund!\n");
  }
  else if(heal > 0)
  {
    this_player()->heal_self(random(heal+1));
    write("Hmmm, lecker! Du fuehlst Dich gestaerkt!\n");
  }
  else
  {
    write("Die Leiche war zwar lecker, aber es passierte nicht viel!\n");
  }
  gegessen();
  ME->remove();
  return 1;
}

nosave int spott(string str)
{
  object killobj;

  if (!str)
    return notify_fail("Syntax: "+query_verb()+" <text>\n"), 0;

  if (!objectp(killobj=QueryProp("my_killer")))
    return notify_fail("Da gibt es nix zum verspotten.\n"), 0;

  if (PL!=killobj)
    return notify_fail("Du bist nicht der Moerder!\n"), 0;

  if (_decay < 4)
    return notify_fail("Dazu ist es jetzt zu spaet.\n"), 0;

  if (already_jeered)
    return notify_fail("Du kannst Dein Opfer nur einmal verspotten!\n"), 0;
  else {
    str = PL->_unparsed_args();
    switch (query_verb())
    {
      case "espotte":
        "/std/corpse"->ChannelMessageJeer(PL, str, MSG_EMOTE);
        break;
      case "gspotte":
        "/std/corpse"->ChannelMessageJeer(PL, str, MSG_GEMOTE);
        break;
      default:
        "/std/corpse"->ChannelMessageJeer(PL, str, MSG_SAY);
        break;
    }
    already_jeered=1;
    write("Du verspottest Dein totes Opfer.\n");
  }
  return 1;
}

