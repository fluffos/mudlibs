int kma=sizeof(KILL_MESSAGES,KILL_MESSAGES2,KILL_MESSAGES3);

int _query_kma() { return kma; }

nosave int DoMurderMsg(object npc, object pl)
{
  int m_HP, m_WC, m_AC, s_HP, s_WC, s_AC, nr, ret;
  int x, y, z;
  closure m_q, s_q;

  if (IS_LEARNER(pl)) return 0;

  m_q = symbol_function("QueryProp", npc);
  s_q = symbol_function("QueryProp", pl);

  if (funcall(m_q, P_TESTPLAYER)) return 0;

  m_HP = funcall(m_q, P_MAX_HP);
  m_WC = funcall(m_q, P_TOTAL_WC);
  m_AC = funcall(m_q, P_TOTAL_AC);
  s_HP = funcall(s_q, P_MAX_HP);
  s_WC = funcall(s_q, P_TOTAL_WC);
  s_AC = funcall(s_q, P_TOTAL_AC);

  ret = funcall(m_q, P_FORCE_MURDER_MSG);
  if (ret > 0)
    ret = 1;
  else if (ret < 0)
    ret = 0;
  else
  {
    if (nr = (random(100) < 5) ? 1 : 0)
      ret = 1;
    else if (nr = ((x = m_HP * (m_WC + m_AC)) > 50000) ? 2 : 0)
      ret = 1;
    else if (nr = (y = m_HP * (m_WC - s_AC)) >
                  (z = 4 * s_HP * (s_WC - m_AC)) ? 3 : 0)
      ret = 1;
    else
      ret = 0;
  }

#ifdef LOG_MOERDER_MSG
  log_file("npc/moerder.log",
           sprintf("MON(%O) COND(%d) NPC(%d), DIFF(%d,%d)\n",
                   ob,nr,x,y,z));
#endif

  return ret;

}


void ChannelMessage(object ob)
{
  string msg, killer;
  mixed msg_flags;
  int flag, i;

  if(explode(file_name(previous_object()), "#")[0] != "/std/corpse")
    return;

  // determine killing player
  while (previous_object(i) && !query_once_interactive(previous_object(i)))
    i++;

  if (!previous_object(i)) return;              // no killer found

  killer = previous_object(i)->name();
  if (lower_case(killer)!=getuid(previous_object(i)))
    killer=capitalize(getuid(previous_object(i)));

  if (DoMurderMsg(ob,previous_object(i)))
  {
    // remember killer - but ONLY if there is a murder message!!!
    previous_object()->SetProp("my_killer", previous_object(i));

    if(!(msg=ob->QueryProp(P_MURDER_MSG)))
      msg=KILL_MESSAGES,KILL_MESSAGES2,KILL_MESSAGES3[random(kma)];

    msg=sprintf(msg,killer);
    msg_flags=ob->QueryProp(P_MSG_FLAGS);
    flag = mappingp(msg_flags) ? msg_flags[P_MURDER_MSG] : 0;

    switch (flag)
    {
      case 1:
        CHMASTER->send("Moerder", "Der Geist "+ob->name(WESSEN,0),
            funcall(msg), MSG_EMOTE);
        break;
      case 2:
        CHMASTER->send("Moerder", ob->Name(WESSEN,0)+" Geistes",
            funcall(msg), MSG_EMOTE);
        break;
      default:
        CHMASTER->send("Moerder", "Geist "+ob->name(WESSEN,0),
            funcall(msg), MSG_SAY);
    }
  }
}

void ChannelMessageJeer(mixed sender, string text, int flag)
{
  if(explode(file_name(previous_object()), "#")[0] == "/std/corpse")
    CHMASTER->send("Moerder", sender, text, flag);
}


void reanimate_me() {
  object ob;
  if(file_size("/gilden/nekromanten/npc/zombie") != -1) return ;
  if(catch(ob=clone_object("/gilden/nekromanten/npc/zombie")))
    return ;
  tell_room(environment(this_object()), "Die Leiche erhebt sich zu einem "
      "schrecklichen Zombie!\n");
  ob->move(environment(this_object()), M_NOCHECK|M_SILENT);
  ob->SetZombie(this_object(), 1, random(5000)+5000);
  this_object()->move(ob, M_NOCHECK|M_SILENT);
  remove();
  return;
}

int SetShortAddon(string str) {
  if(_short_addon[0..0] != " ")
    _short_addon = " " + str;
  else
    _short_addon = str;
  return 1;
}

string QueryShortAddon() {
  return _short_addon;
}
