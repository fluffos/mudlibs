/*
 * Exits of the room (obvious ones, doors, and special ones)
 * we define the following function for easy reference:
 * GetExits() - return a string containing an "Obvious Exits" Statement
 *
 * The exits are implemented as properties P_EXITS
 * They are stored locally (_set_xx, _query_xx)
 * as mapping to speed up the routines in this module.
 *
 */

#pragma strong_types

#define NEED_PROTOTYPES

#include "/std/sys_debug.h"
#include <config.h>
#include <thing/properties.h>
#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <room/exits.h>
#include <room/doors.h>
#include <room/houses.h>
#include <routingd.h>
#include <wizlevels.h>
#include <new_skills.h>  // fuer P_TMP_MOVE_HOOK
#include <exploration.h>
#include <overland.h>


// define's
#define CARDINAL_DIRECTIONS ([ "norden","nordosten","osten","suedosten", \
                               "sueden","suedwesten","westen","nordwesten" ])
#define REL_DIRECTIONS ([ "oben","unten","links","rechts","vorne","hinten" ])


 // global var's
private nosave string *explore;

// local prototypes
string _MakePath(string str);
string substitute_str(string str);
string GetExitMsg(string str);


nosave mapping _query_new_exits()
{
  mapping exits;
  mixed key;
  int i;

  if((!previous_object() || file_name(previous_object())!=DOOR_MASTER) &&
     QueryProp(P_DOOR_INFOS))
    call_other(DOOR_MASTER,"init_doors");

  return Query(P_NEW_EXITS);
}


nosave mapping _query_exits()
{
  mapping exits;
  mixed key;
  int i;

  if((!previous_object() || file_name(previous_object())!=DOOR_MASTER) &&
     QueryProp(P_DOOR_INFOS))
    call_other(DOOR_MASTER,"init_doors");

  key = m_indices(exits = copy_mapping(Query(P_NEW_EXITS)));
  for (i=sizeof(key)-1;i>=0;i--)
    if ( exits[key[i]][EX_FUNC] || !stringp( exits[key[i]][EX_DEST] ) )
      exits = m_delete(exits, key[i]);
    else
      exits[key[i]] = exits[key[i]][EX_DEST];
  return exits;
}


nosave mapping _query_special_exits()
{
  mapping exits;
  mixed key;
  int i;

  key = m_indices(exits = copy_mapping(Query(P_NEW_EXITS)));
  for (i=sizeof(key)-1;i>=0;i--)
    if ( !closurep(exits[key[i]][EX_FUNC]) )
      exits = m_delete(exits, key[i]);
    else
      exits[key[i]] = exits[key[i]][EX_FUNC];
  return exits;
}


void reset() {}

void create()
{
  Set(P_NEW_EXITS,([]));
  Set(P_NEW_EXITS, NOSETMETHOD, F_MODE);
  Set(P_EXITS, NOSETMETHOD, F_MODE);
  Set(P_SPECIAL_EXITS, NOSETMETHOD, F_MODE);
  explore = EPMASTER->QueryExplore(EP_EXIT);
#if (__HOST_NAME__==MUDHOST)
  (void) CheckForHouses();
#endif
}


void AddExit(mixed cmd, mixed room)
{
  int i;
  mapping exita, exitb, exitc;

  exitb = ([]);

  exita=Query(P_NEW_EXITS);
  if (!mappingp(room))  // alte Version...
  {
    if (!closurep(room))        // Ahja... hoffentlich ist room ein String.
    {
      int s;
      string msg;
      object router;

      if ((s = member(room, '#')) != -1)
      {
        exitb[EX_DEST] = room[s+1..];
        exitb[EX_MSG]  = room[0..(s-1)];
      }
      else
        exitb[EX_DEST] = room;

      exitb[EX_DEST] = _MakePath(exitb[EX_DEST]);

      if (!is_clone(this_object()) && objectp(router=find_object(ROUTER)))
        router->RegisterExit(file_name(this_object()),cmd,exitb[EX_DEST]);
    }
    else
      exitb[EX_FUNC] = room;
  }
  else  // neue Version...
  {
    exitb = room;
    if (exitb[EX_DEST])
    {
      exitb[EX_DEST] = _MakePath(exitb[EX_DEST]);
      if (!is_clone(this_object()) && objectp(router=find_object(ROUTER)))
        router->RegisterExit(file_name(this_object()),cmd,exitb[EX_DEST]);
    }
    if (exitb[EX_TESTFUNC])
    {
      if (stringp(exitb[EX_TESTFUNC]))
        exitb[EX_TESTFUNC] = symbol_function(exitb[EX_TESTFUNC], this_object());
      if (!closurep(exitb[EX_TESTFUNC])) return;
    }
    if (exitb[EX_FUNC])
    {
      if (stringp(exitb[EX_FUNC]))
        exitb[EX_FUNC] = symbol_function(exitb[EX_FUNC], this_object());
      if (!closurep(exitb[EX_FUNC])) return;
    }
  }

  if (!pointerp(cmd)) cmd = ({ cmd });

  for (i=sizeof(cmd)-1; i>=0; i--)
  {
    exitc = copy_mapping(exitb);
    if (!exitc[EX_MSG]) exitc[EX_MSG] = GetExitMsg(cmd[i]);
    exita += ([ cmd[i] : exitc ]);
  }

  Set(P_NEW_EXITS, exita);
}


void RemoveExit(mixed cmd)
{
  mapping exita;

  if (!cmd)
    return Set(P_NEW_EXITS,([]));

  if (!pointerp(cmd))
    cmd = ({cmd});
  for(exita=Query(P_NEW_EXITS);sizeof(cmd);cmd=cmd[1..])
    exita = m_delete(exita,cmd[0]);

  Set(P_NEW_EXITS,exita);
}


void AddSpecialExit(mixed cmd, mixed function) {
  if (stringp(function)) function=symbol_function(function, this_object());
  if (!closurep(function)) return;
  AddExit(cmd, function);
}

void RemoveSpecialExit(mixed cmd) {
  RemoveExit(cmd);
}

void AddGuardedExit(mixed cmd, mixed room, string id, string fail_msg) {
  AddExit(cmd, ([ EX_DEST:   room,
                  EXG_ID:    id,
                  EXG_PLMSG: fail_msg ]) );
}

void RemoveGuardedExit(mixed cmd) {
  RemoveExit(cmd);
}


varargs string GetExits( object viewer )
{
  int n, i;
  string exits;
  string *numbers;
  string *indices;
  string *hidden;

  if (QueryProp(P_DOOR_INFOS))
    call_other(DOOR_MASTER,"init_doors");

  numbers = ({"zwei","drei","vier","fuenf","sechs","sieben","acht"});

  indices = m_indices(Query(P_NEW_EXITS));
  if (pointerp(hidden=QueryProp(P_HIDE_EXITS)))
    indices-=hidden;

  n = sizeof(indices);
  switch (n)
  {
    case 0:
    return "Es gibt keine sichtbaren Ausgaenge.\n";
    case 1:
    return "Es gibt einen sichtbaren Ausgang: "+indices[0]+".\n";
    case 2: case 3: case 4: case 5: case 6: case 7: case 8:
    exits = "Es gibt "+numbers[n-2]+" sichtbare Ausgaenge: ";
    break;
    default:
    exits = "Es gibt viele sichtbare Ausgaenge: ";
  }
  for (i = 0; i < n-2; i++)
    exits += indices[i]+", ";
  exits += indices[n-2]+" und "+indices[n-1]+".\n";
  return break_string(exits,78);
}


/*
 * init: Add the direction commands here. If there are doors, add
 * door manipulation commands.
 */
void init()
{
  add_action("_normalfunction","",1);
}


int _normalfunction()
{
  string verb;
  mapping dest;
  mixed message, prep;
  mixed ret;

  verb = query_verb();
  if (!Query(P_NEW_EXITS) || !(dest = Query(P_NEW_EXITS)[verb]))
  {
    if (member(CARDINAL_DIRECTIONS, verb))
      notify_fail("Nach " + capitalize(verb) + " kannst Du nicht gehen.\n");
    else if (member(REL_DIRECTIONS, verb))
      notify_fail("Nach " + verb + " kannst Du nicht gehen.\n");
    return 0;
  }

  // 1. EX_TESTFUNC
  // -------------------------------------------
  if (closurep(dest[EX_TESTFUNC]))
  {
    ret = funcall(dest[EX_TESTFUNC], verb);
    if (!ret) return 1;
  }

  // 2. GUARD
  // -------------------------------------------
  if (dest[EXG_ID] && (present(dest[EXG_ID]) || dest[EXG_ID]=="NO_GUARD" ) &&
      query_once_interactive(this_player()) && !IS_LEARNING(this_player()))
  {
    if (dest[EXG_PLMSG])
      write(process_string(dest[EXG_PLMSG]));
    else
      write("Eine unbekannte Kraft haelt Dich zurueck.\n");

    if (dest[EXG_RMMSG])
      say( capitalize( substitute_str( process_string(dest[EXG_RMMSG]) ) ) );

    if (dest[EXG_FUNC] && dest[EXG_ID]!="NO_GUARD")
      call_other( present(dest[EXG_ID]), dest[EXG_FUNC], this_player(), verb );

    return 1;
  }

  if (dest[EX_PLMSG]) write(break_string(dest[EX_PLMSG],78,0,1));

  // 3. EX_FUNC
  // -------------------------------------------
  if (closurep(dest[EX_FUNC]))
  {
    ret = funcall(dest[EX_FUNC], verb);
    if (!stringp(ret))
    {
      if (explore && ret && member(explore,verb)>=0)
        EPMASTER->GiveExplorationPoint(verb, EP_EXIT);
      return ret;
    }
    ret = _MakePath(ret);
  }
  else
    ret = dest[EX_DEST];

  if (!ret) return 0;
  if ( strlen(ret) && ret[0] == '@' ) {
    ret = OVERLAND_MASTER->query_destination( ret, verb );
    if ( !ret )
      return 0;
    if ( ret[0] == '!' ) {
      write( break_string( ret[1..], 78, 0, 1 ) );
      return 1;
    }
  }
  ret = this_player()->move( ret, M_GO, dest[EX_MSG],
                             dest[EX_MSG_OUT], dest[EX_MSG_IN] );

  if (explore && (ret>0) && member(explore,verb)>=0)
    EPMASTER->GiveExplorationPoint(verb, EP_EXIT);

  return 1;
}


string _MakePath(string str)
{
  string pref,name,rest;
  string *comp, *strs, wiz;

  comp = explode(file_name(this_object()), "/");
  switch(str[0])
  {
    case '@':
      return str;
    case '.':
      str = "/" + implode(comp[0..<2], "/") + "/" + str;
      break;

    case '~':
      strs = explode( str, "/" );
      if (strlen(strs[0]) > 1)          // ~magier/...
        wiz = strs[0][1..];
      if (comp[0] == "d")
      {
        if (wiz)
          str = "/d/" + comp[1] + "/" + wiz + "/" + implode(strs[1..], "/");
        else
        {
          wiz = explode( getuid(this_object()), "." )[<1];
          str = "/d/" + comp[1] + "/" + (IS_LEARNER(wiz) ? wiz : comp[2]) +
            "/" + implode( strs[1..], "/" );
        }
      }
      else
        str = "/" + comp[0] + "/" +
          (wiz || getuid(this_object())) + "/" +
          implode( strs[1..], "/" );
      break;
  }
  return MASTER->_get_path(str, getuid(this_object()));
}


string GetExitMsg(string str)
{
  string s;

  if (!str) return "";

  // "nordoben" etc. erkennen; in diesem Fall: s:="norden"
  if (str != "oben" && str[<4..] == "oben")
    s = str[0..<5] + "en";
  else if (str != "unten" && str[<5..] == "unten")
    s = str[0..<6] + "en";
  else
    s = str;

  // Himmelsrichtung?
  if (member(CARDINAL_DIRECTIONS, s))
     return "nach " + capitalize(str);

  // Relative Richtung?
  if (member(REL_DIRECTIONS, s))
    return "nach "+str;

  // Default-Exit-Praeposition gesetzt?
  if (QueryProp(P_EXIT_PREPOSITION))
    return QueryProp(P_EXIT_PREPOSITION) + " " + str;

  return str;
}


string substitute_str(string str)
{
  if (!str || !this_player()) return 0;
  str = implode(efun::explode(str, "@Wer@"), this_player()->Name() );
  str = implode(efun::explode(str, "@wer@"), this_player()->name() );
  str = implode(efun::explode(str, "@wessen@"), this_player()->name(WESSEN) );
  str = implode(efun::explode(str, "@wem@"), this_player()->name(WEM) );
  str = implode(efun::explode(str, "@wen@"), this_player()->name(WEN) );
  return str;
}


int CheckForHouses()
{
  int i;
  mixed houses;
  string *dirs;
  mapping exits;

  if (catch(houses = SEERHOUSEMASTER->QueryHouses()))
    return raise_error("Fehler beim Aufruf von "+
        SEERHOUSEMASTER+"->QueryHouses()\n"), -1;

  exits = QueryProp(P_EXITS);
  dirs = m_indices(exits);

  // Erst alle Seherhaeuser abhaengen...
  for (i=sizeof(dirs)-1; i>=0; i--)
    if (exits[dirs[i]][0..strlen(SEERHOUSE_PATH)-1]==SEERHOUSE_PATH)
      RemoveExit(dirs[i]);

  // Nothing to do.
  if (!houses || !sizeof(houses)) return 1;

  // Jetzt die vom Master berichteten Haeuser anhaengen.
  for (i=sizeof(houses)-1; i>=0; i--)
    AddExit(houses[i][QH_DIRECTION], ([ 
          EX_DEST: SEERHOUSE_PATH+houses[i][QH_FILENAME],
          EX_PLMSG: "Du betrittst das Seherhaus von " + 
            capitalize(explode(houses[i][QH_FILENAME], ":")[0]) + ".\n"]) );

  return 1;
}

