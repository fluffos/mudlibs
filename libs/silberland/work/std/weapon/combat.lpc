#include "/std/sys_debug.h"

#pragma strong_types

#define NEED_PROTOTYPES

#include <thing/properties.h>
#include <thing/commands.h>
#include <thing/description.h>

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <attributes.h>
#include <defines.h>
#include <moving.h>

#define RESTR_CHECKER "/std/restriction_checker.lpc"

// local prototypes
varargs int wield(string str, int silent);
int unwield(string str);
varargs int DoUnwield(int silent);

// global vars
int wc_bonus;


void create()
{
  // Ein paar Defaultwerte:
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_NR_HANDS, 2);       // lieber 2-haendig, wenns vergessen wird :)
  SetProp(P_WC_FIX, 30);        // So stark wie blosse Haende geht immer.
  SetProp(P_QUALITY_DECAY, 100);        // Default-Abnutzung.
  SetProp(P_WIELD_TEXT,
      ({ "Du zueckst %s.\n",
         " zueckt %s.\n" }) );
  SetProp(P_UNWIELD_TEXT,
      ({ "Du steckst %s zurueck.\n",
         " steckt %s zurueck.\n" }) );
  SetProp(P_DAMAGE_DESTRUCT_TEXT,
      "%s haelt der Belastung nicht mehr laenger stand und zerbricht in "
      "tausend kleine Einzelteilchen." );

  Set(P_WIELDED, PROTECTED, F_MODE_AS);
  Set(P_LAST_USE, time());
  Set(P_LAST_USE, PROTECTED, F_MODE_AS);
}

void init()
{
  add_action("wield", "zueck");
  add_action("wield", "zuecke");
  add_action("wield", "zieh");
  add_action("wield", "ziehe");
  add_action("unwield", "steck");
  add_action("unwield", "stecke");
}

int CheckDex(object pl)
{
  // Kein Spieler - Kein Zuecken ;-) (should not happen, though)
  if (!objectp(pl)) return 0;

  // Ausreichend Geschick?
  return ( ((pl->QueryAttribute(A_DEX) + 5) * 10) >=
           QueryProp(P_WC) + QueryProp(P_DAMAGED) );
}

varargs int wield_me(int silent) 
{
  object wielded_weapon;
  int used_hands;
  closure cl;
  mapping rmap;
  string res;
  mixed wield_func, spc_id;

  if(environment() != PL)
  {
    _notify_fail( "Du musst " + name(WEN,1) + " schon erst nehmen!\n" );
    return 0;
  }
  if(QueryProp(P_WIELDED))
  {
    notify_fail("Das hast Du schon gemacht!\n");
    return 0;
  }
  if(PL->QueryProp(P_GHOST)) 
  {
    notify_fail("Als Geist kannst Du das nicht!\n");
    return 0;
  } 
  if(!CheckDex(PL))
  {
    notify_fail("Du bist nicht geschickt genug, "
        "um mit dieser Waffe umzugehen.\n");
    return 0;
  }
  if( (rmap=QueryProp(P_WIELD_RESTRICTIONS)) && 
      (res=RESTR_CHECKER->check_restrictions(PL, rmap)) )
  {
    notify_fail(res);
    return 0;
  }
  if( PL->InFight() && PL->QueryProp(P_ATTACK_BUSY) )
  {
    notify_fail("Du bist zu erschoepft, um "+name(WEN,0)+" zu zuecken.\n");
    return 0;
  }
  SetProp(P_ATTACK_BUSY, 1);

  if(wielded_weapon = PL->QueryProp(P_WEAPON))
  {
    if(wielded_weapon->DoUnwield(silent) && !(PL->QueryProp(P_WEAPON)))
      return wield_me(silent);
    else
    {
      notify_fail("Das geht nicht, solange Du noch eine andere Waffe "
          "gezueckt hast.\n");
      return 0;
    }
  }

  if ((QueryProp(P_WC) + QueryProp(P_DAMAGED) > MAX_WEAPON_CLASS))
  {
    notify_fail("Ungueltige Waffenklasse, bitte Erzmagier verstaendigen!\n");
    return 0;
  }

  if (QueryProp(P_M_ATTR_MOD) &&
      stringp(PL->TestAttributeLock(QueryProp(P_M_ATTR_MOD))))
  {
    notify_fail("Eine magische Kraft hindert Dich daran, "+ME->name(WEN,1)+
        " zu zuecken.\n");
    return 0;
  }

  if (mappingp(QueryProp(P_WC_BONUS)))
  {
    spc_id = filter_array(PL->QueryProp(P_IDS), QueryProp(P_WC_BONUS));
    wc_bonus = sizeof(spc_id) && QueryProp(P_WC_BONUS)[spc_id[0]];
  }
  else
  {
    wc_bonus = 0;
  }

  if(query_once_interactive(PL) &&
    (((QueryProp(P_WC)+wc_bonus) > MAX_WEAPON_CLASS) ||
     ((QueryProp(P_WC)+QueryProp(P_DAMAGED)+wc_bonus) > MAX_WEAPON_CLASS)))
  {
    notify_fail("Ungueltiger Waffenklassen-Bonus, bitte Erzmagier "
        "verstaendigen!\n");
    return 0;
  }

  if (!PL->UseHands(ME,QueryProp(P_NR_HANDS))) {
    notify_fail("Du hast keine Hand mehr frei.\n");
    return 0;
  }

  // P_WIELD_FUNC im Spielerobjekt auswerten (kann object oder *object sein!)
  wield_func = PL->QueryProp(P_WIELD_FUNC);

  if (objectp(wield_func) && !wield_func->WieldFunc(ME,silent))
    return PL->FreeHands(ME),1;
  else if (pointerp(wield_func))
  {
    int i;
    PL->SetProp(P_WIELD_FUNC, wield_func=filter_array(wield_func,#'objectp));
    for ( i = sizeof(wield_func); i-->0; )
      if (!wield_func[i]->WieldFunc(ME,silent))
        return PL->FreeHands(ME),1;
  }

  // Eigene P_WIELD_FUNC auswerten
  wield_func = QueryProp(P_WIELD_FUNC);
  if(wield_func && !wield_func->WieldFunc(ME,silent))
    return PL->FreeHands(ME),1;

  // Alle Checks erfolgreich durchlaufen -> zuecken!
  SetProp(P_WIELDED, PL);
  SetProp(P_EQUIP_TIME, time());
  cl=symbol_function("SetProp",PL);
  funcall( cl, P_WEAPON, ME );
  funcall( cl, P_TOTAL_WC, QueryProp(P_WC)+wc_bonus );

  // Attribute gegebenenfalls updaten!
  if (QueryProp(P_M_ATTR_MOD) || QueryProp(P_M_HEALTH_MOD))
    PL->UpdateAttributes();

  // "zueck"-Meldung ausgeben
  if (!silent)
  {
    write(sprintf( QueryProp(P_WIELD_TEXT)[0], name(WEN,1) ));
    say(PL->Name(WER) + sprintf( QueryProp(P_WIELD_TEXT)[1], name(WEN,0) ));
  }
  return 1;
}

varargs int wield(string str, int silent)
{
  if(!str) return 0;
  if(query_verb()[0..3]=="zieh" && sscanf(str,"%s hervor",str)!=1) return 0;
  if(!id(str))
  {
    _notify_fail("Du hast sowas nicht.\n");
    return 0;
  }
  return wield_me(silent);
}

int unwield(string str) 
{
  string dummy;

  if (!str) return 0;
  if(sscanf(str,"%s weg", dummy)!=1 && 
     sscanf(str,"%s ein", dummy)!=1 &&
     sscanf(str,"%s zurueck", dummy)!=1 )
    return 0;
  str = dummy;
  if(!str || !id(str) || PL->QueryProp(P_WEAPON) != ME )
    return 0;
  if(environment() != PL) 
  {
    _notify_fail("Diese Waffe gehoert Dir nicht!\n");
    return 0;
  }
  if(!QueryProp(P_WIELDED)) 
  {
    _notify_fail("Diese Waffe hast Du gar nicht gezueckt ...\n");
    return 0;
  }
  return DoUnwield();
}

varargs int DoUnwield(int silent)
{
  int used_hands;
  object wielded_by;
  mixed hands, unwield_func;
  closure cl;
  string tmp;

  if(!wielded_by = QueryProp(P_WIELDED)) return 0;

  // Verflucht? Wenn ja - Meldung und Abbruch.
  if ( (tmp = QueryProp(P_CURSED)) && !(silent & M_NOCHECK) )
  {
    if (stringp(tmp))
      tell_object(wielded_by, tmp);
    else
      tell_object(wielded_by, 
		  "Du kannst "+name(WEN)+" nicht wegstecken.\n");
    return 1;
  }

  // Im Kampf und zu beschaeftigt?
  if( wielded_by->InFight() && wielded_by->QueryProp(P_ATTACK_BUSY) )
  {
    tell_object(wielded_by,
        "Du bist zu erschoepft, um "+name(WEN,0)+" wegzustecken.\n");
    return 1;
  }

  // P_UNWIELD_FUNC im Spielerobjekt auswerten (kann object oder *object sein!)
  unwield_func = wielded_by->QueryProp(P_UNWIELD_FUNC);

  if (objectp(unwield_func) && !unwield_func->UnwieldFunc(ME,silent))
    return 1;
  else if (pointerp(unwield_func))
  {
    int i;
    PL->SetProp(P_UNWIELD_FUNC,
        unwield_func=filter_array(unwield_func,#'objectp));
    for ( i = sizeof(unwield_func); i-->0; )
      if (!unwield_func[i]->UnwieldFunc(ME,silent))
        return 1;
  }

  // Eigene P_UNWIELD_FUNC auswerten
  unwield_func = QueryProp(P_UNWIELD_FUNC);
  if(unwield_func && !unwield_func->UnwieldFunc(ME,silent))
    return 1;

  // Alle Checks erfolgreich durchlaufen -> wegstecken!
  wielded_by->SetProp(P_ATTACK_BUSY, 1);
  cl=symbol_function("QueryProp",wielded_by);
  hands = funcall(cl,P_HANDS);

  wielded_by->FreeHands(ME);
  cl=symbol_function("SetProp",wielded_by);
  funcall(cl,P_TOTAL_WC, hands[1]); /* bare hands */
  funcall(cl,P_WEAPON, 0);

  // "Zuruecksteck"-Meldung ausgeben
  if (!silent)
  {
    tell_object( wielded_by,
        sprintf( QueryProp(P_UNWIELD_TEXT)[0], name(WEN,1) ) );
    tell_room( environment(wielded_by),
        wielded_by->Name(WER) +
        sprintf( QueryProp(P_UNWIELD_TEXT)[1], name(WEN,0) ),
        ({ wielded_by }) );
  }

  SetProp(P_WIELDED, 0);        // Reihenfolge wichtig wg. _set_wc()
  wc_bonus = 0;                 // gehen wir halt mal auf Nummer sicher

  // Attribute gegebenenfalls updaten!
  if (QueryProp(P_M_ATTR_MOD) || QueryProp(P_M_HEALTH_MOD))
    wielded_by->UpdateAttributes();

  return 1;
}

int QueryDamage(object enemy)
{
  int dam, wc, ff;
  object hit_func;

  if(!QueryProp(P_WIELDED)) return 0;
  /*
  dam = (2*QueryProp(P_WC)+10*
	 QueryProp(P_WIELDED)->QueryAttribute(A_STR)) / 3;
  dam = random(dam);
  */
  wc=2*(QueryProp(P_WC)+wc_bonus);      // 2* aus Formel herausgehoben
  ff=QueryProp(P_WC_FIX);
  dam = (wc*ff+
    random(wc*(100-ff)+1000*QueryProp(P_WIELDED)->QueryAttribute(A_STR)))/300;
  if(hit_func=QueryProp(P_HIT_FUNC))
    dam += hit_func->HitFunc(enemy);
  SetProp(P_LAST_USE, time());
  return dam;
}

/// TO BE REMOVED

object SetWieldFunc(object ob) { return SetProp(P_WIELD_FUNC, ob); }
object QueryWieldFunc() { return QueryProp(P_WIELD_FUNC); }

object SetUnwieldFunc(object ob) { return SetProp(P_UNWIELD_FUNC, ob); }
object QueryUnwieldFunc() { return QueryProp(P_UNWIELD_FUNC); }

object SetHitFunc(object ob) { return SetProp(P_HIT_FUNC, ob); }
object QueryHitFunc() { return QueryProp(P_HIT_FUNC); }

object QueryWielded() { return QueryProp(P_WIELDED); }
// ***

nosave int _set_nr_hands(int arg)
{
  if(arg<1) return Query(P_NR_HANDS);
  Set(P_NR_HANDS, arg);
}

nosave mixed _set_dam_type(mixed arg)
{
  int i;
  if(pointerp(arg))
  {
    for (i=sizeof(arg)-1;i>=0;i--)
    { 
      if( member(m_indices(ALL_DAMAGE_TYPES), arg[i])==-1 )
        return raise_error("Illegal Damage Type: "+arg[i]+"\n");
    }
    return Set(P_DAM_TYPE, arg);
  }
  else if( stringp(arg) )
  {
    if( member(m_indices(ALL_DAMAGE_TYPES), arg)==-1 )
      return raise_error("Illegal Damage Type: "+arg+"\n");
    return Set(P_DAM_TYPE, ({ arg }));
  }
  else
    return raise_error(sprintf("Illegal Damage Type: %O\n",arg));
}

nosave int _set_damaged(int dam)
{
  return Set(P_DAMAGED, dam > 0 ? dam : 0);     // keine negativen Damagewerte
}

nosave int _set_wc(int wc)
{
  object ob;

  if ((ob=QueryProp(P_WIELDED)) && query_once_interactive(ob) &&
      wc+QueryProp(P_DAMAGED) > MAX_WEAPON_CLASS)
  {
    tell_object(ob,
        "Ungueltige Waffenklasse fuer "+
        name(WEN,1)+", bitte Erzmagier verstaendigen.\n");
    return -1;
  }
  if (ob) ob->SetProp(P_TOTAL_WC, wc+wc_bonus);
  return Set(P_WC, wc);
}

nosave int _set_wc_bonus(mapping bo) 
{
  object ob;
  mixed spc_id;

  wc_bonus = 0;
  if (ob=QueryProp(P_WIELDED))
  { 
    if (mappingp(bo))
    {
      spc_id = filter_array(ob->QueryProp(P_IDS), bo);
      wc_bonus = sizeof(spc_id) && bo[spc_id[0]];
    }
    else
    {
      wc_bonus = 0;
    } 
    if(query_once_interactive(ob) &&                                                  
      ((QueryProp(P_WC)+wc_bonus > MAX_WEAPON_CLASS) || 
       (QueryProp(P_WC)+wc_bonus+QueryProp(P_DAMAGED) > MAX_WEAPON_CLASS)))
    {
      tell_object(ob,                                                                                               
        "Ungueltiger Waffenklassen-Bonus fuer "+                                                                          
        name(WEN,1)+", bitte Erzmagier verstaendigen.\n");                                                        
      return -1; 
    } 
  }
  return Set(P_WC_BONUS, bo);
}

nosave int _set_wc_fix(int i)
{
  if (i<0) i=0; else if (i>100) i=100;
  return Set(P_WC_FIX, i);
}

nosave float _set_wc_fixfactor(float ff)
{
  return _set_wc_fix(to_int(ff*100+0.5)) / 100.0;
}

nosave float _query_wc_fixfactor()
{
  return QueryProp(P_WC_FIX) / 100.0;
}

// flaw  wird bei jedem Hit hochgezaehlt
// ftime ist die Zeit des ersten Hits
// alle decay Hits wird die Waffe um 1 verschlechtert

private nosave int ftime, totalflaw, flaw, decay;

nosave mixed _set_quality_decay(mixed arg)
{
  if (intp(arg)) decay = arg;
  return Set(P_QUALITY_DECAY, arg);
}

int Damage(int dam)
{
  int wc;

  if (dam)
  {
    wc = QueryProp(P_WC);

    if (wc - dam < MIN_WEAPON_CLASS)
    {
      if (!QueryProp(P_NO_DAMAGE_DESTRUCT))
      {
        object w;
        string text;

        w = QueryProp(P_WIELDED);       // Traeger?
        text = break_string(
            capitalize(
              sprintf( QueryProp(P_DAMAGE_DESTRUCT_TEXT),name(WER,1) ) ), 78);

        // Leise und erzwungen (also auch wenn verflucht!) zerstoeren:
        ME->remove(M_NOCHECK | M_SILENT);

        // Zerstoerung erfolgreich?
        if (!ME)
        {
          if (!w && environment())
            if (living(environment()) || query_once_interactive(environment()))
              // Environment == Lebewesen
              w = environment();
            else
              // Annahme: Environment == Raum
              tell_room(environment(), text);

          // w = Lebewesen (oder 0)
          if (w) tell_object(w, text);

          return dam;
        }
      }
      dam = wc - MIN_WEAPON_CLASS;
    }

    if (dam + QueryProp(P_DAMAGED) < 0)
      dam = -QueryProp(P_DAMAGED);

    SetProp( P_DAMAGED, QueryProp(P_DAMAGED) + dam );
    SetProp( P_WC, wc - dam );
    // P_TOTAL_WC wird automatisch von _set_wc() korrigiert
  }
  return dam;
}

varargs void TakeFlaw(int hits)
{
  int wc;

  if (!QueryProp(P_QUALITY_DECAY)) { // kein q.decay, keine abnuetzung
    return ;
  }
  if (!ftime) ftime=time();
  flaw += hits || 1;
  if (decay && (flaw >= decay)) {
    Damage(flaw/decay);
    totalflaw += flaw/decay*decay;
    flaw %= decay;
  }
}

mixed *QueryFlaw()
{
  return ({ totalflaw+flaw, ftime, dtime(ftime) });
}

