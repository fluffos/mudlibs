mixed get_next_exp(int lev);
varargs string get_new_title(int lev, object pl);

void create()
{
  room::create();
  SetProp(P_INDOORS,1);
  SetProp(P_INT_LONG,
      "Du befindest Dich in der beruehmten Abenteurer-Gilde.\n"
      +"Hier kannst Du Deine Erfahrungsstufe erhoehen.\n"
      +"An der Wand siehst Du eine grosse Uhr.\n"
      +"Moegliche Befehle sind:\n"
      +"                   liste (geloest/ungeloest)\n"
      +"                   erhoehe (stufe)\n"
      +"                   kosten\n");
  SetProp(P_INT_SHORT,"Abenteuer-Gilde");
  AddCmd("kosten","kosten");
  AddCmd("liste","liste");
  AddSpecialDetail("uhr","zeige_reboot");
  AddCmd("erhoehe","advance");
  AddCmd("wandle","change");
  AddItem("/obj/zeitungsautomat",REFRESH_REMOVE);
  SetProp( P_LIGHT, 1 );
}

void init()
{
  room::init();
  if (IS_LORD(PL)) {
    add_action("banish","banish");
    add_action("unbanish","unbanish");
  }
  if (IS_ARCH(PL))
  {
    add_action("mbanish","mbanish");
    add_action("sbanish","sbanish");
    add_action("munbanish","munbanish");
    add_action("sunbanish","sunbanish");
  }
}

string zeige_reboot()
{
  string str;
  int t,t2;
  
  t=time()-last_reboot_time();
  t2=t;
  str="Seit dem letzten Shutdown sind "+t+" Sekunden vergangen.\n";
  if (t<60) return str;
  str+="Das sind ";
  if (t>=86400)
  {
    str+=t/86400+" Tag";
    if (t>=86400*2) 
      str+="e";
    str+=", ";
    t2=t2%86400;
  }
  if (t>=3600)
  {
    str+=t2/3600+" Stunde";
    if (t2/3600!=1) 
      str+="n";
    str+=", ";
    t2=t2%3600;
  }
  if (t>=60)
  {
    str+=t2/60+" Minute";
    if (t2/60!=1)
      str+="n";
    str+=" und ";
    t2=t2%60;
  }
  str+=t2+" Sekunde";
  if (t2!=1)
    str+="n";
  str+=".\n";
  return str;
}

int banish(string str)
{
  string grund, name;
  
  if (!IS_LORD(this_interactive())) return 0;
  
  if (!str) {
    write("Syntax: banish <name> <grund>\n");
    return 1;
  }
  str = this_interactive()->_unparsed_args();

  if (sscanf(str,"%s %s",name,grund)!=2) name=str;
  if (!name || name =="")
  {
    write("Syntax: banish <name> <grund>\n");
    return 1;
  }
  if( !grund )
  {
    write("Du musst einen Grund angeben! Syntax: banish <name> <grund>\n");
    return 1;
  }
  name=lower_case(name);
  "/secure/master"->BanishName(name,capitalize(grund));
  return 1;
}

int unbanish(string str)
{
  string name;

  if (!IS_LORD(this_interactive())) return 0;

  if (!str) {
    write("Syntax: unbanish <name>\n");
    return 1;
  }
  str = this_interactive()->_unparsed_args();

  if (sscanf(str,"%s",name) != 1) name=str;
  if (!name || name =="") {
    write("Syntax: unbanish <name>\n");
    return 1;
  }
  name=lower_case(name);
  "/secure/master"->UnbanishName(name);
  return 1;
}

int mbanish(string str)
{
  string grund, name;

  if ((this_interactive() != this_player()) || (!IS_ARCH(this_interactive())))
    return 0;
  notify_fail("Syntax: mbanish <name> <grund>\n");

  if (!(str=this_interactive()->_unparsed_args()))
    return 0;
  if (sscanf(str,"%s %s",name,grund)!=2)
    return write("Eine Begruendung muss angegeben werden!\n"), 1;
  if (!stringp(name) || !strlen(name)) return 0;
  "/secure/merlin"->MBanishInsert(lower_case(name), capitalize(grund),
      this_interactive());
  return 1;
}

int sbanish(string str)
{
  string grund, name;

  if ((this_interactive() != this_player()) || (!IS_ARCH(this_interactive())))
    return 0;
  notify_fail("Syntax: sbanish <name> <grund>\n");

  if (!(str=this_interactive()->_unparsed_args()))
    return 0;
  if (sscanf(str,"%s %s",name,grund)!=2)
    return write("Eine Begruendung muss angegeben werden!\n"), 1;
  if (!stringp(name) || !strlen(name)) return 0;
  "/secure/merlin"->SBanishInsert(lower_case(name), capitalize(grund),
      this_interactive());
  return 1;
}

int munbanish(string str)
{
  if ((this_interactive() != this_player()) || (!IS_ARCH(this_interactive())))
    return 0;
  notify_fail("Syntax: munbanish <name>\n");
  if (!stringp(str) || !strlen(str)) return 0;
  "/secure/merlin"->MBanishDelete(lower_case(str));
  return 1;
}

int sunbanish(string str)
{
  if ((this_interactive() != this_player()) || (!IS_ARCH(this_interactive())))
    return 0;
  notify_fail("Syntax: sunbanish <name>\n");
  if (!stringp(str) || !strlen(str)) return 0;
  "/secure/merlin"->SBanishDelete(lower_case(str));
  return 1;
}

#define male_title_str ({ \
      "der hoffnungsvolle Anfaenger", "der Landstreicher", \
      "der Streuner", "der Pfadfinder", "der Kaempfer", \
      "der erfahrene Kaempfer",   "der Abenteurer", \
      "der erfahrene Abenteurer", "der Haudegen", \
      "der Krieger",              "der Ritter",      "der Held", \
      "der Feuerbaendiger",       "der Beschwoerer", "der Zauberlehrling", \
      "der Zauberer",             "der Hexer",       "der Prophet", \
      "der angehende Seher", "der Seher" })

#define fem_title_str ({ \
      "die hoffnungsvolle Anfaengerin", "die Landstreicherin", \
      "die Streunerin", "die Pfadfinderin", "die Kaempferin", \
      "die erfahrene Kaempferin", "die Abenteurerin", \
      "die erfahrene Abenteurerin", "die Mutige",    "die Kriegerin", \
      "die Amazone",                "die Heldin",    "die Feuerbaendigerin", \
      "die Beschwoererin",          "die Adeptin",   "die Zauberin", \
      "die Hexe",                   "die Prophetin", \
      "die angehende Seherin", "die Seherin" })

varargs string get_new_title(int lev, object pl)
{
  string s, *dt;

  if (!pl) pl=PL;
//  if (IS_SEER(pl) && (s=pl->Query(P_TITLE))) return s;
  if (lev<1) lev=1;
  else if (IS_SEER(pl))
    lev = 20;
  else if (lev >= 20)
    lev = 19;

  // Pruefen, ob das Spielerobjekt Defaultgildentitel definiert;
  // alle Rassen sollten dies tun...
  if (dt=pl->QueryProp(pl->QueryProp(P_GENDER) == FEMALE ?
      P_DEFAULT_GUILD_FEMALE_TITLES : P_DEFAULT_GUILD_MALE_TITLES))
    return dt[lev-1];
  /*
  // Alternative: Gilde selbst befragen...
  if ((m=QueryProp(pl->QueryProp(P_GENDER) == FEMALE ?
      P_GUILD_FEMALE_TITLES : P_GUILD_MALE_TITLES)) && member(m,lev))
    return m[lev];
  */
  if (pl->QueryProp(P_GENDER) == FEMALE) return fem_title_str[lev-1];
  else return male_title_str[lev-1];
}

string UpdateTitle(int level, object pl)
{
  mapping ts;
  string title;

  title = get_new_title (level, pl);
  if (!mappingp(ts=pl->Query(P_GUILD_TITLE)))
      ts=([]);
  ts[pl->QueryProp(P_DEFAULT_GUILD) || DEFAULT_GUILD]=title;
  pl->Set(P_GUILD_TITLE,ts);
  if (!IS_SEER(pl))
    pl->SetProp(P_TITLE,0);
  return title;
}

mixed get_next_exp(int lev)
{
  if (lev < 1) return -1;
  if (lev >= 32) return 100000000+(lev-31)*25000000;
  return
    ({
      676, 1014, 1522, 2283, 3425,				//  1-5
      5138, 7707, 11561, 17341, 26012,				//  6-10
      39018, 58527, 77791, 97791, 131687,			// 11-15
      197530, 296296, 444444, 666666, 1000000,			// 16-20
      1500000, 2250000, 3375000, 5062500, 7600000,		// 21-25
      11000000, 17000000, 25000000, 40000000, 60000000,		// 26-30
      80000000})[lev];						// 31
}

int next_qp(int lev, object pl)
{
  int need;

  need=pl->QueryProp(P_NEEDED_QP);
  if (lev>=20) return need;	// zur Level-20-Werdung alle needed QP
  if (lev<4) return 0;		// spaeter mal, wenns mehr Quests gibt...
  if (lev<7) return need/20;
  if (lev<10) return need/10;
  if (lev<13) return need/5;
  if (lev<15) return need*7/20;
  if (lev<19) return need/2;
  if (lev<20) return need*13/20;
}

int seer_cond(int silent)
{
  int unable, ep, ap;
  string sminfo;

  sminfo = "Um Seher"+(PL->QueryProp(P_GENDER) == FEMALE ? "in" : "")+
      " werden zu koennen, ";

  if (unable = (PL->QueryProp(P_LEVEL) < 20))
    sminfo += "reicht Deine Stufe noch nicht aus. ";

  ep = XP_NEEDED_FOR_WIZ - PL->QueryProp(P_XP);
  ap = PL->QueryProp(P_NEEDED_QP);
  if (ap < QM->QuerySeerQP())
    ap = QM->QuerySeerQP();
  ap = ap - PL->QueryProp(P_QP);

  if (unable && ((ep > 0) || (ap > 0))) sminfo += "Zudem ";
  if ((ep > 0) && (ap > 0))
    sminfo +=
      sprintf("fehlen Dir noch %d Erfahrungspunkt%s und %d Abenteuerpunkt%s.\n",
        ep, (ep>1 ? "e" : ""), ap, (ap>1 ? "e" : ""));
  else if (ep > 0)
    sminfo += ((ep == 1) ? "fehlt Dir noch 1 Erfahrungspunkt.\n" :
               "fehlen Dir noch "+ep+" Erfahrungspunkte.\n");
  else if (ap > 0)
    sminfo += ((ap == 1) ? "fehlt Dir noch 1 Abenteuerpunkt.\n" :
               "fehlen Dir noch "+ap+" Abenteuerpunkte.\n");

  unable = unable || (ep > 0) || (ap > 0);

  if (QM->QueryReadyForSeer(PL) == 0)
  {
    sminfo +=
      (unable ? "Du MUSST ueberdies noch einige Abenteuer loesen!" :
                "MUSST Du noch einige Abenteuer loesen!");
    sminfo += " Mit 'liste' erfaehrst Du, wieviele Abenteuer pro Gruppe Du "
      "auslassen kannst.\n";
    unable = 1;
  }
  ep = 11*EPMASTER->QueryAverage();
  if (10*EPMASTER->QueryExplorationPoints(this_player()) <= ep)
  {
    sminfo +=
      (unable ?
       "Ausserdem solltest Du Dich besser auskennen als der Durchschnitt.\n" :
       "solltest Du Dich besser auskennen als der Durchschnitt.\n");
    unable = 1;
  }
  if (!unable)
    sminfo = "Du erfuellst alle Bedingungen, um Seher"+
      (PL->QueryProp(P_GENDER) == FEMALE ? "in" : "")+" zu werden.\n";

  if (!silent)
    write(break_string(sminfo, 78, 0, 1));

  return !unable;
}


// ApCost()
//  - ermittelt, wieviel EP fuer einen AP benoetigt werden
// nr: Die Nummer des APs (der wievielte durch EP bekommene AP?)
//
nosave int ApCost(int nr)
{
  int n;
  if (nr <= 10) return 10;      // konstante Kosten fuer die ersten 10 AP
  n = 10 + (nr-10) * (EPMASTER->QueryMaxEP() - 600) / 900;
  if (n<0) return 0; else return n;
}


// ApCosts()
//  - ermittelt die Gesamtkosten fuer (n) zu bekommende APs
// nr: Die Nummer des APs (der wievielte durch EP bekommene AP?)
// n: Die Anzahl an AP, die der Spieler bekommen soll
//
nosave int ApCosts(int nr, int n)
{
  int i,c;
  for (i=c=0; i<n; i++) c+=ApCost(nr+i);
  return c;
}


// ExploredAP()
//   ermittelt die Anzahl der durch Forschen erlangten AP eines Spielers
// pl: Das Spielerobjekt
// level: Der Level des Spielers
//
nosave int ExploredAP(object pl, int level)
{
  int attrsum,ls;

  if (!level) level=pl->QueryProp(P_LEVEL);
  // Summe der jetzigen AP - 4 (man startet mit 1,1,1,1)
  attrsum=pl->QueryRealAttribute(A_STR)+pl->QueryRealAttribute(A_INT)+
          pl->QueryRealAttribute(A_DEX)+pl->QueryRealAttribute(A_CON)+
          pl->QueryProp(P_AP)-4;

  // gefundene ZTs abziehen
  attrsum -= 10 - sizeof(pl->QueryProp(P_POTIONROOMS));

  // Level beruecksichtigen
  if (level <= 10)
    attrsum -= (level-1)*2;
  else
    if (level <= 20)
      attrsum -= 18+(level-10);
    else
      attrsum -= 28+(level-20)/2;

  return attrsum;
}


// GivenAP()
//  - ermittelt, wieviele AP der Spieler beim Erhoehen auf Stufe 'level'
//    maximal erhaelt (also AP fuer Stufe und FP abzgl. Stufen- und ZT-AP)
//
nosave int GivenAP(object pl, int level)
{
  int ap, attrsum, i, nr, rest, maxsum;

  if (stringp(pl)) pl=find_player(pl);
  attrsum=pl->QueryRealAttribute(A_STR)+pl->QueryRealAttribute(A_INT)+
          pl->QueryRealAttribute(A_DEX)+pl->QueryRealAttribute(A_CON)+
          pl->QueryProp(P_AP);
  TW("attrsum: "+attrsum+".\n");
  maxsum = A_SUM - sizeof(pl->QueryProp(P_POTIONROOMS)) - attrsum;
  if (maxsum <= 0) return 0;
  TW("maxsum: "+maxsum+".\n");
  if (level==1) ap=0;
  else if (level <= 10) ap=2;
  else if (level <= 20) ap=1;
  else ap=(level % 2) ? 0 : 1;  // jeden 2. Level einen weiteren AP
  TW("Fuer den Level: "+ap+" AP.\n");
  nr=ExploredAP(pl, level-1);
  TW("Bisher explored: "+nr+" AP.");
  rest=pl->QueryProp(P_EP_NUM)-pl->QueryProp(P_EP_NUM_FOR_AP);
  i=0;
  while ((rest > ApCost(nr+i+1)) && (ap+i+1 <= maxsum)) {
    if (!i) TW(sprintf("\nrest: %d (%d)", rest, ApCost(nr+i+1)));
    i++;
    rest-=ApCost(nr+i);
    TW(sprintf(" - %d (%d)",rest, ApCost(nr+i+1)));
  }
  ap+=i;
  TW("\nFuers Forschen: "+i+".\n");
  TW("Also insgesamt: "+ap+".\n");
  if ((20 <= level) && (level < 50)) maxsum -= (51 - level) / 2;
  if (level < 20) maxsum -= (20 - level);
  if (level < 10) maxsum -= (10 - level);
  if (ap > maxsum) {
    ap = (maxsum > 0 ? maxsum : 0);
    TW("Wurde begrenzt auf: "+ap+".\n");
  }
  return ap;
}


int kosten()
{
  int level, lp, multi, ap;
#ifdef QP_NEEDED
  int qp;
#endif

  level = PL->QueryProp(P_LEVEL);
  lp = PL->QueryProp(P_LP);

#ifdef QP_NEEDED
  if( (qp = next_qp(level + 1, PL)) > PL->QueryProp(P_QP) )
    write("Du brauchst mindestens " + qp +
          " Abenteuerpunkte fuer die naechste Stufe.\n");
#endif

  // sogar zuwenig Stupse fuer Level - 1
  if (level > 2 && lp < PL->NeededLp(level - 1))
    write("Erhoehen?!? Wie bist Du ueberhaupt an Deine Stufe gekommen?\n"
        "Sei froh, dass Du nicht wieder abgestuft wirst!\n");
  // zuwenig Stupse fuer aktuellen Level
  else if (lp < PL->NeededLp(level))
    write("Du solltest erstmal wieder Deine derzeitige Stufe rechtfertigen!\n");
  // genug Stupse, um oefter zu erhoehen
  else if (multi = (lp >= PL->NeededLp(level + 2)))
    write("Du koenntest auf Stufe " + PL->LpLevel() + " erhoehen!\n");
  else
  {
    switch (PL->NextLevelPerc())
    {
      case 0..5:
        if (level > 1) {
          write("Na komm, Du hast doch gerade erst die letzte Stufe "
              "geschafft.\n");
          break;
        }
        // else fall-thru
      case 6..20:
        write("Die naechste Stufe ist noch laaaange hin.\n");
        break;
      case 21..40:
        write("Bis zur naechsten Stufe hast Du noch einiges vor Dir.\n");
        break;
      case 41..60:
        write("Den halben Weg zur naechsten Stufe hast Du in etwa "
            "geschafft.\n");
        break;
      case 61..75:
        write("Dir fehlt in etwa noch ein Drittel - also, halt Dich ran!\n");
        break;
      case 76..90:
        write("Viel fehlt Dir zur naechsten Stufe nicht mehr!\n");
        break;
      case 91..95:
        write("Auf ins Gefecht, Du bist schon auf der Zielgerade!\n");
        break;
      case 96..97:
        write("Du hast es so gut wie geschafft! Nicht aufgeben!\n");
        break;
      case 98..99:
        write("Du stehst jetzt unmittelbar vor Deinem Ziel!\n");
        break;
      case 100:
        write("Du koenntest jetzt Deine Stufe erhoehen!\n");
        break;
      default:
        write("Hmm, irgendetwas stimmt hier nicht.\n");
        break;
    }
  }

  // Stufe erhoehen moeglich
  if (lp >= PL->NeededLp(level + 1))
  {
    if (ap = GivenAP (PL, level + 1))
      write(sprintf( "%s wirst Du %d Attributpunkt%s erhalten.\n",
            (multi ? "Beim Aufstieg auf Stufe " + (level + 1) : "Dabei"),
            ap, (ap == 1 ? "" : "e") ));
  }

  // Koennte Seher werden?
  if (!IS_SEER(this_player()) && level >= 19)
    seer_cond(0);

  return 1;
}


nosave string str2attr(string s)
{
  int i;
  if ((i=strlen(s=lower_case(s))) < 3) return 0;
  if (s=="kraft"[0..i-1]) return A_STR;
  if (s=="intelligenz"[0..i-1]) return A_INT;
  if (s=="ausdauer"[0..i-1]) return A_CON;
  if (s=="geschicklichkeit"[0..i-1]) return A_DEX;
  return 0;
}


int change(string arg)
{
  string von, nach;
  int v, n, sp;

  notify_fail(
    "Welches Attribut willst Du in welches wandeln?\n"
    "Attribute: Kra(ft), Ges(chicklichkeit), Aus(dauer), Int(elligenz)\n");

  if (!stringp(arg)) return 0;
  if ((sscanf(arg, "%s in %s", von, nach) != 2) &&
      (sscanf(arg, "%s nach %s", von, nach) != 2)) return 0;
  if (!(von=str2attr(von)) || !(nach=str2attr(nach))) return 0;

  if (von==nach)
  {
    log_file("interactive/ATTR_CHANGED",
        sprintf("[%s] %O: TRIED CHEATING TO INCREASE %s [%d]\n",
        ctime(), PL, von, PL->QueryRealAttribute(von)));
    notify_fail("Du kannst ein Attribut nur in ein anderes wandeln!\n");
    return 0;
  }

  v=PL->QueryRealAttribute(von);
  n=PL->QueryRealAttribute(nach);

  if (!PL->QueryProp(P_TESTPLAYER) && !IS_LEARNING(PL))
  {
    if (PL->QueryProp(P_GHOST))
      return notify_fail("Als Geist kannst Du das nicht!\n"), 0;

    if (PL->QueryProp(P_KILLS))
      return notify_fail(
          "Du hast einen Mitspieler umgebracht!\n"
          "In diesem Fall kannst Du keine Attribute wandeln.\n"
          "Bitte kontaktiere den Sheriff und bringe das in Ordnung.\n"), 0;

    if (time() < PL->QueryProp(P_NEXT_SPELL_TIME))
      return notify_fail("Du bist noch zu erschoepft von Deinem letzten "
        "Spruch.\n"), 0;

    if ((sp=PL->QueryProp(P_SP)) < CHANGE_COST)
      return notify_fail("Du musst erst wieder magische Kraefte sammeln!\n"),0;

    if (v <= 3+PL->QueryProp(P_LEVEL)/4 && v <= A_MAX-3 )
      return notify_fail("Du kannst Deine "+ATTRIBUTE_STRING[von]+" nicht "
        "weiter verringern!\n"), 0;

    if (n >= A_MAX)
      return notify_fail("Du kannst Deine "+ATTRIBUTE_STRING[nach]+" nicht "
        "weiter erhoehen!\n"), 0;

    PL->AddSp(-1*CHANGE_COST);
    PL->SetProp(P_NEXT_SPELL_TIME, time()+CHANGE_TIMECOST);
  }
  else
  {
    // Obergrenze gilt auch fuer Testies und Magier
    if (n >= A_MAX)
      return notify_fail("Du kannst Deine "+ATTRIBUTE_STRING[nach]+" nicht "
        "weiter erhoehen!\n"), 0;
  }

  // Attribute umverteilen
  PL->SetRealAttribute(von, --v);
  PL->SetRealAttribute(nach, ++n);

  write(
    "Du konzentrierst Dich und murmelst ein paar magische Worte...\n"
    "Deine "+ATTRIBUTE_STRING[von]+" hat sich auf "+v+" verringert.\n"
    "Deine "+ATTRIBUTE_STRING[nach]+" hat sich auf "+n+" erhoeht.\n");
  say(PL->Name()+" murmelt einige magische Worte.\n");

  log_file("interactive/ATTR_CHANGED",
      sprintf("[%s] %O: %s [now %d] -> %s [now %d]\n",
      ctime(), PL, von, v, nach, n));

  return 1;
}


int advance(string arg)
{
  string s, title, attr;
  int level, gender, ap, yet, attrsum;

  TW(sprintf("gilde::advance (%O) start\n", this_object()));

  notify_fail ("Was willst Du erhoehen?\n"+
    "Stufe, Gildenstufe, Kraft, Int(elligenz), "
    "Aus(dauer), Gesch(icklichkeit)?\n");

  if (!arg) return 0;
  attr = str2attr(arg);
  if (!attr && arg != "stufe" && arg != "gildenstufe") return 0;

  // Attribut-Handling
  attrsum = PL->QueryRealAttribute(A_STR)+PL->QueryRealAttribute(A_INT)+
            PL->QueryRealAttribute(A_DEX)+PL->QueryRealAttribute(A_CON);
  if (attr)
  {
    if (!(ap=PL->QueryProp(P_AP))) {
      write ("Du kannst Deine "+ATTRIBUTE_STRING[attr]+
             " im Moment leider nicht erhoehen.\n");
      return 1;
    }
    if (PL->QueryRealAttribute(attr) >= A_MAX) {
      write(sprintf("Du hast bereits die maximale %s erreicht.\n"
            "Versuch doch, ein anderes Attribut zu erhoehen!\n"
            "(Siehe dazu auch 'hilfe attribute').\n",
            ATTRIBUTE_STRING[attr]));
      return 1;
    }
    if (attrsum >= A_SUM) {
      write ("Du hast bereits die maximale Anzahl an Attributen erreicht.\n"+
             "Fuer Dich koennen wir leider nix mehr tun!\n");
      return 1;
    }
    yet = PL->QueryRealAttribute(attr);
    PL->SetRealAttribute(attr,yet+1);
    if (PL->QueryRealAttribute(attr) != (yet+1))
    {
      PL->SetRealAttribute(attr,yet);
      write ("Hoppla, irgendwas ist da schiefgelaufen. "+
             "Bitte einen Erzmagier verstaendigen!\n");
      return 1;
    }
    PL->SetProp(P_AP, --ap);
    write(sprintf("Deine %s hat sich von %d auf %d erhoeht.\n",
      ATTRIBUTE_STRING[attr], yet, yet+1));
    PL->save_me(1);
    return 1;
  }

  // Playerkills?
  if (PL->QueryProp(P_KILLS))
  {
    notify_fail("Du hast einen Mitspieler umgebracht!\n"
                "In diesem Fall kannst Du Deine Stufe nicht erhoehen.\n"
                "Bitte kontaktiere den Sheriff und bring das in Ordnung.\n");
    say(PL->Name(WER)+
        " hat soeben auf schmerzliche Weise erfahren muessen,\n"
        "dass es wirklich nicht foerderlich ist, Mitspieler umzubringen.\n");
    return 0;
  }

  // Einige Variablen setzen...
  title = PL->QueryProp( P_TITLE );
  level = PL->QueryProp( P_LEVEL );
  gender = PL->QueryProp( P_GENDER );

  TW ("advance() 2 continued...\n");

  // Neuangelegter Charakter?
  if (level == -1)
    level = 0;
  else
  {
#ifdef QP_NEEDED
    if ( (PL->NextLevelPerc() < 100) ||
         (PL->QueryProp(P_QP) < next_qp(level, PL)) )
      return kosten();
#else
    if (PL->NextLevelPerc() < 100)
      return kosten();
#endif
  }

  TW ("advance() 3 continued...\n");

  // Alle Bedingungen erfuellt
  level++; 

  if (level >= 20 && !IS_SEER(PL) && seer_cond(1))
  {
    s = (gender == FEMALE ? "in" : "");
    write("Du erfuellst die Bedingungen, um Seher" + s + " zu werden!\n"+
      "Suche dazu Merlin auf und sag 'merlin mach mich zu"+
      (gender==FEMALE ? "r" : "m")+" seher" + s + "'.\n");
  }

  // Level erhoehen, Titel updaten
  PL->SetProp(P_LEVEL, level);
  title = UpdateTitle (level, PL);
  if (strlen(title = PL->QueryProp(P_TITLE) || ""))
    title = " " + title;

  // Alle im Raum informieren
  say(s = sprintf("%s%s hat jetzt Stufe %d erreicht.\n",
        PL->Name(WER), title, level));

  // Testspieler von [Info:] ausnehmen
  if (!PL->QueryProp(P_TESTPLAYER))
    call_other("/obj/infomaster", "InfoMsg", s);

  TW ("advance() 4 continued...\n");

  // Feedback fuer Spieler
  if (level < 7)
    write(sprintf("Gratulation! Du bist jetzt %s%s (Stufe %d).\n",
        PL->name(), title, level));
  else if (level < 14)
    write(sprintf("Gut gemacht, %s%s (Stufe %d).\n",
        PL->name(), title, level));
  else
    write(sprintf("Willkommen auf Deiner neuen Stufe!\n"
        "Du bist jetzt %s%s (Stufe %d).\n", PL->name(), title, level));

  // vergebene Attributpunkte
  if (ap = GivenAP(PL,level))
  {
    int apnow, apforlev, epforap;

    if      (level <=  1) apforlev = 0;
    else if (level <= 10) apforlev = 2;
    else if (level <= 20) apforlev = 1;
    else apforlev = ((level + 1) % 2);  // jeden 2. Level einen weiteren AP

    if (apforlev >= ap)
      apforlev = ap;
    else
    {
      epforap = ApCosts(ExploredAP(PL, level - 1) + 1, ap - apforlev);
      TW ("Ziehe " + epforap + " EP fuer AP ab.\n");
      PL->SetProp(P_EP_NUM_FOR_AP, PL->QueryProp(P_EP_NUM_FOR_AP) + epforap);
    }

    apnow = PL->SetProp(P_AP, ap+PL->QueryProp(P_AP));

    if (ap == apforlev)         // APs nur fuer Stufe
      s = "Aufgrund des Erreichens Deiner Spielerstufe ";
    else if (apforlev)          // APs auch fuer Stufe
      s = "Aufgrund des Erreichens Deiner Spielerstufe und "
          "Deiner Erkundungen auf dieser Welt ";
    else                        // APs nur fuers Forschen
      s = "Aufgrund Deiner Erkundungen auf dieser Welt ";

    s += "erhaeltst Du " + ap + " Attributpunkt" + (ap == 1 ? ", mit dem" :
        "e, mit denen") + " Du Deine Attribute erhoehen kannst.";

    if (ap != apnow)
      s += " Insgesamt hast Du jetzt " + apnow +
           " Attributpunkt" + (apnow == 1 ? "" : "e") + ".";

    write("\n" + break_string(s, 78) + "\n");
  }

  TW ("advance() done.\n");

  PL->save_me(1);       // sicherheitshalber Spielerobjekt sichern
  return 1;
}


nosave int compare( mixed *i, mixed *j )
{
  if( i[2] == j[2] )
    return i[1] > j[1];
  else
    return i[2] > j[2];
}

nosave string asText( int i )
{
  switch( i )
  {
    case 0: return "kann keines";
    case 1: return "kann eines";
    default:
      return sprintf( "koennen %d", i );
  }
}

#define FLAG2STR ([ 0 : "", 1 : " geloest", 2 : " ungeloest" ])

varargs int liste(mixed pl)
{
  int qgroups, i, j, n, *dontneed, flag;
  mixed *qlists, *quests, *qnums, *qpoints;
  string str, bold, normal, ja, nein;

  if (!this_player())
    return 0;

  if (stringp(pl))
  {
    if (pl == "geloest")
      flag = 1;
    else if ((pl == "nicht geloest") || (pl == "ungeloest"))
      flag = 2;
    else if (sscanf(pl, "%s nicht geloest", str) ||
             sscanf(pl, "%s ungeloest", str))
      flag = 2;
    else if (sscanf(pl, "%s geloest", str))     // Reihenfolge wichtig!
      flag = 1;
    else
      flag = 0;
    if (flag)
      pl = str;
  }

  if(!objectp(pl))
    if(stringp(pl) && IS_WIZARD(this_player()))
      pl=find_player(pl)||find_netdead(pl);
  if(!objectp(pl))
    pl=PL;

  ja = nein = bold = normal = "";
  switch (PL->QueryProp(P_TTY))
  {
    case "ansi":        // farben vorhanden...
      ja = ANSI_BOLD+ANSI_GREEN;
      nein = ANSI_BOLD+ANSI_RED;
      // kein break!
    case "vt100":       // gilt auch fuer ansi...
      bold = ANSI_BOLD;
      normal = ANSI_NORMAL;
  }

  if ((this_player()->QueryProp(P_TTY) == "ansi") ||
      (this_player()->QueryProp(P_TTY) == "vt100"))
    bold=ANSI_BOLD, normal=ANSI_NORMAL;
  else
    bold=normal="";

  str = sprintf("%s%-38s%s    AP  Stufe  geloest  verantw. Magier\n%'-'77s\n",
      bold,"Liste der Abenteuer"+
      (pl != PL ? " ("+capitalize(getuid(pl))+")" : "")+":", normal, "");

  qgroups = sizeof(dontneed=QM->QueryDontneed(pl));
  qlists = allocate( qgroups );
  qnums = allocate( qgroups + 1 );
  qpoints = allocate( qgroups + 1 );
  for( i=qgroups-1; i>=0; i-- )
    qlists[i] = ({});

  quests = QM->QueryQuests();
  for( i=sizeof(quests[0])-1; i>=0; i-- )
    if( quests[1][i][6] )
    {
      for( j=qgroups-1; QGROUPS[j]>quests[1][i][0]; j-- )
        /* j je nach Punktezahl auf Gruppe fuer Quest setzen */ ;
      if( flag==0 || (flag==1 && pl->QueryQuest(quests[0][i]) ) ||
       (flag==2 && !pl->QueryQuest(quests[0][i]) ) )
      {
        qlists[j] += ({ ({
          quests[0][i], quests[1][i][0], quests[1][i][4], quests[1][i][7], 
                  quests[1][i][5], quests[1][i][8] }) });

        // Anzahl der Quests zaehlen:
        if (quests[1][i][5]) {
          qnums[<1]++;
          qpoints[<1] += quests[1][i][0];
        } else {
          qnums[j]++;
          qpoints[j] += quests[1][i][0];
        }
      }
    }

  for( i=0; i<qgroups; i++ )
  {
    str += bold + "Gruppe " + (i+1) +
      (qnums[i] ? sprintf(" (%d Abenteuer%s, %d AP)",
                          qnums[i], FLAG2STR[flag], qpoints[i])
                : "") + ":" + normal + "\n";

    if (!qnums[i])
      str += sprintf("  In dieser Gruppe gibt es derzeit keine%s Abenteuer.\n",
          FLAG2STR[flag] ? FLAG2STR[flag] + "en" : "");
    else
    {
      qlists[i] = sort_array( qlists[i], "compare", ME );
      for( j=0; j<sizeof(qlists[i]); j++ )
      {
        if(qlists[i][j][4]==0)
        {
          str +=
            sprintf( "  %-38s %3d   %2d     %s    %-10s %4s\n",
              qlists[i][j][0], qlists[i][j][1], qlists[i][j][2],
              (pl->QueryQuest(qlists[i][j][0]) ?
               ja+" ja "+normal : nein+"nein"+normal),
              capitalize(qlists[i][j][3][0]),
              (IS_WIZARD(this_player()) ? sprintf("%d",qlists[i][j][5]):"" )
              );
          if (qlists[i][j][3][0] != qlists[i][j][3][1])
            str += sprintf("%61s %-10s\n", "Derzeit betreut von",
                           capitalize(qlists[i][j][3][1]));
        }
      }
      str += sprintf(
        "  (Von den Abenteuern dieser Gruppe %s ausgelassen werden.)\n",
        asText(dontneed[i]));
    }
    str += "\n";
  }

#if 0
  str += sprintf("%s%d%s%soptionale%s Abenteuer:%s\n",
      bold, qnums[<1], FLAG2STR[flag],
      flag ? (qnums[<1] == 1 ? "es " : "e ") : " ",
      qnums[<1] == 1 ? "s" : "",
      normal );
#else
  str += sprintf("%sOptionale Abenteuer (%d%s, %d AP):%s\n",
      bold, qnums[<1], flag ? FLAG2STR[flag] : " insgesamt",
      qpoints[<1], normal );
#endif

  if (!qnums[<1])
    str += sprintf("  In dieser Gruppe gibt es derzeit keine%s Abenteuer.\n",
        FLAG2STR[flag] ? FLAG2STR[flag] + "en" : "");
  else
  {
    for( i=0; i<qgroups; i++ )
    {
      for( j=0; j<sizeof(qlists[i]); j++ )
      {
        if(qlists[i][j][4]!=0) {
          n++;
          str += sprintf( "  %-38s %3d   %2d     %s    %-10s %4s\n",
                         qlists[i][j][0], qlists[i][j][1], qlists[i][j][2],
                         (pl->QueryQuest(qlists[i][j][0]) ?
                          ja+" ja "+normal : nein+"nein"+normal),
                         capitalize(qlists[i][j][3][0]),
                         (IS_WIZARD(this_player()) ? sprintf("%d",qlists[i][j][5]):"" )
                        );
          if (qlists[i][j][3][0] != qlists[i][j][3][1])
            str += sprintf("%61s %-10s\n", "Derzeit betreut von",
                           capitalize(qlists[i][j][3][1]));
        }
      }
    }
  }

  i=j=pl->QueryProp(P_NEEDED_QP);
  if (QM->QuerySeerQP() > i) i = QM->QuerySeerQP();
  if (QM->QueryWizQP() > j) j = QM->QueryWizQP();
  if (i==j)
    str += sprintf(
      "\nUm "+bold+"Magier oder Seher"+normal+
      " zu werden, musst Du %d der %d Abenteuerpunkte\n"+
      "und %d Erfahrungspunkte erlangen.\n",
      i, QM->QueryMaxQP(), XP_NEEDED_FOR_WIZ);
  else
    str += sprintf(
      "\nUm "+bold+"Seher"+normal+
      " zu werden, musst Du %d der %d Abenteuerpunkte und\n"+
      "%d Erfahrungspunkte erlangen. Um "+bold+"Magier"+normal+
      " zu werden,\nbenoetigst Du allerdings %d Abenteuerpunkte.\n",
      i, QM->QueryMaxQP(), XP_NEEDED_FOR_WIZ, j);
  this_player()->More(str, 0);
  return 1;
}

