// This may look like C code, but it is really -*- C++ -*-

/*
 * 18. Jan 1996 Hadra@AnderLand
 * i++ gegen ++i ausgetausch
*/

#include <properties.h>
#include <wizlevels.h>
#include <language.h>
#define ME this_object()

nosave int is_in ( object ob, mixed x )
{
  return (strstr( lower_case(country(ob)), x ) != -1 ||
          strstr( lower_case(ob->Query(P_LOCATION) || ""), x ) != -1);
}
nosave int is_at(object ob, mixed x) {
  return (environment(ob)==x);
}
nosave int is_wiz_level_lt(object ob, mixed x) {
  return (query_wiz_level(ob) < x);
}
nosave int is_wiz_level_eq(object ob, mixed x) {
  return (query_wiz_level(ob) == x);
}
nosave int is_wiz_level_ge(object ob, mixed x) {
  return (query_wiz_level(ob) >= x);
}
nosave int is_prop_set(object ob, mixed x) {
  return (ob->QueryProp(x));
}
nosave int is_prop_unset(object ob, mixed x) {
  return (!ob->QueryProp(x));
}
nosave int is_second(object ob, mixed x) {
  return ob->QueryProp(P_SECOND) && ob->QueryProp(P_SECOND_MARK) >= x;
}
nosave int is_mage_second(object ob, mixed x) {
  return ob->QueryProp(P_SECOND) &&
    IS_LEARNER(lower_case(ob->QueryProp(P_SECOND))) &&
    (ob->QueryProp(P_SECOND_MARK) >= x);
}
nosave int is_in_gilde(object ob, mixed x) {
  return (ob->QueryProp(P_GUILD)==x);
}
nosave int is_name_in(object ob, mixed x) {
  return (member(x,geteuid(ob))>=0);
}
nosave int is_in_region(object ob, mixed x) {
  return (environment(ob) &&
	  (file_name(environment(ob))[0..(strlen(x)-1)]==x));
}
nosave int is_gender(object ob, mixed x) {
  return (ob->QueryProp(P_GENDER)==x);
}
nosave int is_race(object ob, mixed x) {
  return (ob->QueryProp(P_RACE)==x);
}
nosave int is_idle(object ob, int i) {
  return query_idle(ob) >= i*60;
}
nosave int is_nude(object ob) {
  return !sizeof(ob->QueryProp(P_ARMOURS));
}
nosave int is_coward(object ob) {
  return ob->QueryProp(P_WIMPY) >= ob->QueryProp(P_MAX_HP)/2;
}
nosave int name_starts_with(object ob,string str) {
  return getuid(ob)[0..strlen(str)-1] == str;
}
nosave int is_loggedin(object ob,int n) {
  return (time() - ob->QueryProp(P_LAST_LOGIN)) >= n;
}

object *filter_users(string str) {
  object *res,*orig,*zwi;
  string *words;
  int i,sz,f;
  mixed x;
  
  orig=users();
  if (!str || str=="") return orig;
  res=({});
  words=explode(lower_case(str)," ");
  sz=sizeof(words);

  for (i=0;i<sz;i++)
  {
    zwi=({});
    switch(words[i])
    {
      case "ausser":
      case "ohne":
      case "nicht":
        f=-1;
        if (!i) res=orig;   // Falls das das erste Argument war...
        continue;
      case "oder":
        f=0;
        continue;
      case "und":
        f=1;
        continue;

      case "alle":
        zwi=orig;
        break;

      case "in":
      case "aus":
        if (++i>=sz) break;
        zwi=filter_array(orig,"is_in",ME,words[i]);
        break;

      case "region":
        if (++i>=sz) break;
        zwi=filter_array(orig,"is_in_region",ME,"/d/"+words[i]);
        break;

      case "gilde":
        if (++i>=sz) break;
        zwi=filter_array(orig,"is_in_gilde",ME,words[i]);
        break;
      
      case "bei":
        if (++i>=sz) break;
        if (!objectp(x=find_player(words[i])) &&
            !objectp(x=find_living(words[i])))
          break;
        if (!IS_LEARNER(this_player()) && x->QueryProp(P_INVIS))
          break;
        zwi=filter_array(orig,"is_at",ME,environment(x));
        break;

      case "gott":
        zwi=filter_array(orig,"is_wiz_level_ge",ME,GOD_LVL);
        break;

      case "erzmagier":
      case "erzie":
        zwi=filter_array(orig,"is_wiz_level_ge",ME,ARCH_LVL);
        break;

      case "weiser":
        zwi=filter_array(orig,"is_wiz_level_ge",ME,ELDER_LVL);
        break;

      case "regionsmagier":
        zwi=filter_array(orig,"is_wiz_level_ge",ME,LORD_LVL);
        break;

      case "magier":
        zwi=filter_array(orig,"is_wiz_level_ge",ME,LEARNER_LVL);
        break;

      case "spieler":
        zwi=filter_array(orig,"is_wiz_level_lt",ME,SEER_LVL);
        break;

      case "seher":
        zwi=filter_array(orig,"is_wiz_level_eq",ME,SEER_LVL);
        break;

      case "maennlich":
        zwi=filter_array(orig,"is_gender",ME,MALE);
        break;

      case "weiblich":
        zwi=filter_array(orig,"is_gender",ME,FEMALE);
        break;

      case "mensch":
        zwi=filter_array(orig,"is_race",ME,"Mensch");
        break;
      case "zwerg":
        zwi=filter_array(orig,"is_race",ME,"Zwerg");
        break;
      case "elf":
        zwi=filter_array(orig,"is_race",ME,"Elf");
        break;
      case "hobbit":
        zwi=filter_array(orig,"is_race",ME,"Hobbit");
        break;
      case "troll":
        zwi=filter_array(orig,"is_race",ME,"Troll");
        break;
      case "dunkelelf":
        zwi=filter_array(orig,"is_race",ME,"Dunkelelf");
        break;
      case "fee":
        zwi=filter_array(orig,"is_race",ME,"Fee");
        break;
      case "oger":
        zwi=filter_array(orig,"is_race",ME,"Oger");
        break;
      case "untot":
      case "untoter":
        zwi=filter_array(orig,"is_race",ME,"Untoter");
        break;
      /*
      case "ork":
        zwi=filter_array(orig,"is_race",ME,"Ork");
        break;
      case "goblin":
        zwi=filter_array(orig,"is_race",ME,"Goblin");
        break;
      case "gaffo":
        zwi=filter_array(orig,"is_race",ME,"Gaffo");
        break;
      */

      case "frosch":
        zwi=filter_array(orig,"is_prop_set",ME,P_FROG);
        break;

      case "testi":
      case "testie":
      case "testspieler":
        zwi=filter_array(orig,"is_prop_set",ME,P_TESTPLAYER);
        break;

      case "zweiti":
      case "zweitie":
      case "zweitspieler":
        if (IS_INACTIVEWIZ(this_player()))
          zwi = filter_array(orig, "is_second", ME, -1);
        else
          zwi = filter_array(orig, "is_second", ME, 0);
        break;

      case "magierzweiti":
      case "magierzweitie":
      case "magierzweitspieler":
        if (IS_INACTIVEWIZ(this_player()))
          zwi = filter_array(orig, "is_mage_second", ME, -1);
        else
          zwi = filter_array(orig, "is_mage_second", ME, 1);
        break;

      case "weg":
      case "abwesend":
        zwi=filter_array(orig,"is_prop_set",ME,P_AWAY);
        break;

      case "idle":
        if ((i+1<sz) && (x=to_int(words[i+1])) && (to_string(x)==words[i+1])) {
          i++;
          zwi=filter_array(orig,"is_idle",ME,x);
        }
        else
          zwi=filter_array(orig,"is_idle",ME,2);
        break;

      case "nackt":
        zwi=filter_array(orig,"is_nude",ME);
        break;

      case "ledig":
        zwi=filter_array(orig,"is_prop_unset",ME,P_MARRIED);
        break;

      case "feig":
      case "feigling":
        zwi=filter_array(orig,"is_coward",ME);
        break;

      case "erwartet":
      case "erwartete":
        if (!pointerp(x = this_player()->QueryProp(P_WAITFOR))) break;
        x=map_array(x,#'lower_case);
        zwi=filter_array(orig,"is_name_in",ME,x);
        break;

      case "freund":
      case "freunde":
        if (!objectp(x = present("\n\bfband", this_player()))) break;
        if (!pointerp(x = x->QueryProp(P_AUTOLOADOBJ))) break;
        if (sizeof(x) < 2) break;
        if (!pointerp(x = x[1])) break;
        x=map_array(x,#'lower_case);
        zwi=filter_array(orig,"is_name_in",ME,x);
        break;

      case "suechtig":
      case "suechtler":
        zwi=filter_array(orig,"is_loggedin",ME,14400);
        break;

      case "dauermudder":
        zwi=filter_array(orig,"is_loggedin",ME,28800);
        break;

      default:
        if (words[i][<1]=='*' && strlen(words[i])>1) {
          zwi=filter_array(orig,"name_starts_with",ME,words[i][0..<2]);
          break;
        }
        f=0;
        if (this_player())
          write("Warnung: Unbekanntes Suchkriterium "+words[i]+".\n");
    }
    switch (f) {
      case -1: res-=zwi;break;
      case 1:  res=res&zwi;break;
      default: res-=zwi; res+=zwi;
    }
  }
  return res;
}

