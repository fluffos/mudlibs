/*
 *-------------------------------------------------------------------
 * comm.c
 * This file is part of the MorgenGrauen mudlib.
 * Basical communiacation commands for npc.
 * For better support of the sequencer module.
 *
 * written by Rumata 15.08.92
 *-------------------------------------------------------------------
 */

#include <language.h>
#include <defines.h>
#include "/sys/player/comm.h"

void create() {
  add_action( "sage", "sag" );
  add_action( "sage", "sage" );
  add_action( "echo", "echo" );
  add_action( "emote", "emote" );
}

int echo(string str) {
  say( str + "\n" );
  return 1;
}

int sage(string str) {
  say( break_string(str, 78, ME->Name(WER,2)+" sagt: "));
  return 1;
}

int emote(string str) {
  say( capitalize(ME->name(WER,2))+" "+str+"\n" );
  return 1;
}

varargs int Message(string msg, int flag)
{
  if (!ME->QueryProp(P_DEAF))
    tell_object( ME, msg );
}
