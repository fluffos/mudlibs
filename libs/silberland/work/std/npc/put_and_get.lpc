inherit "std/living/put_and_get";
#include <moving.h>
#include <properties.h>

void give_notify(object obj)
{
  mixed* msg;
  string str;

  if ( pointerp( msg = QueryProp(P_REJECT) ) )
  {
    if (obj->IsUnit())
      obj->Set("u_req", obj->QueryProp(P_GIVEN_AMOUNT));

    str = msg[1];
    str = regreplace( str, "@CAP_WER", obj->Name(WER,1),    1 );
    str = regreplace( str, "@WER",     obj->name(WER,1),    1 );
    str = regreplace( str, "@WESSEN",  obj->name(WESSEN,1), 1 );
    str = regreplace( str, "@WEM",     obj->name(WEM,1),    1 );
    str = regreplace( str, "@WEN",     obj->name(WEN,1),    1 );

    say( capitalize(str) );

    switch( msg[0] )
    {
      case REJECT_GIVE:
        if(!give_obj( obj, this_player() ))
          drop_obj( obj );
        break;
      case REJECT_DROP:
        drop_obj( obj );
        break;
      case REJECT_DESTRUCT:
        obj->remove();
        break;
      case REJECT_KEEP:
        /* keep it */
        break;
    }
  }
}
