// SilberLand MUDlib
//
// std/npc/compare.c - Vergleichen von Waffen und Ruestungen
//
// $Date$
/* $Revision$
 * $Log$
 */

inherit "std/thing/commands";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <combat.h>
#include <bank.h>
#include <defines.h>
#include <moredef.h>

#define VGL_PREIS 500
#define WEBS(x) break_string(x, 78, Name(WER,1)+" sagt: ", 1)

int vgl_preis;

varargs create(int comp_preis);

varargs create(int comp_preis)
{
  if( comp_preis ) vgl_preis=comp_preis;
  else vgl_preis=VGL_PREIS;
  AddCmd(({"vergleiche", "vergleich"}), "compare");
}

compare(str)
{
  object ob1, ob2, lager;
  string str1, str2, str3;
  notify_fail(WEBS("Was willst Du womit vergleichen?"));
  if (!str || !stringp(str)) return 0;
  if (sscanf( str, "%s mit %s", str1, str2) != 2) return 0;

  ob1 = present(str1, TP);
  ob2 = present(str2, TP);
  if (!ob1 || !ob2) {
    write(WEBS("Wenn Du eine Einschaetzung haben willst, so solltest Du "
        "doch etwas angeben, was Du auch hast!"));
    return 1;
  }

  if (ob1==ob2)
  {
    write (BS(Name(WEM,1)+" ist es zu bloed, "+ob1->name(WEN,1)+
      " mit sich selbst zu vergleichen. "+QueryPronoun(WER)+" drueckt " 
      +ob1->QueryPronoun(WEN)+ " Dir daher wieder in die Hand."));
    return 1;
  }
  // Wenn der Spieler kein Magier ist kostet es halt was
  if (!IS_LEARNING(TP))
  {
    if (TP->QueryMoney() < vgl_preis)
    {
      write (WEBS("Das kostet "+vgl_preis+
          " Muenzen, und Du hast nicht soviel!\n"));
      return 1;
    }
  }
  if (ob1->QueryProp(P_WEAPON_TYPE) && ob2->QueryProp(P_WEAPON_TYPE))
  {
    write (BS(
      Name(WER,1)+" nimmt "+ob1->name(WEN, 1)+" und "+ ob2->name(WEN, 1)+
      " und vergleicht beide eingehend miteinander. Schliesslich gibt "+
      QueryPronoun(WER)+" Dir folgende Beurteilung:") +"\n");
    write (BS (comp_quality(ob1, ob2, 1) + "."));
  }
  else
   if (ob1->QueryProp(P_ARMOUR_TYPE) && ob2->QueryProp(P_ARMOUR_TYPE))
   {
     write (BS(
       Name(WER,1)+" nimmt "+ob1->name(WEN, 1)+" und "+ ob2->name(WEN, 1)+
       " und vergleicht beide eingehend miteinander. Schliesslich gibt "
       +QueryPronoun(WER)+" Dir folgende Beurteilung:")+"\n");
     write (BS (comp_quality(ob1, ob2, 2) + ".") + "\n");
   }
   else
   {
     write (WEBS("Ich kenne mich nur mit Waffen und Ruestungen "+
       "aus, nicht aber mit dem Zeug, das Du da bei Dir hast!"));
     return 1;
   }
  write ( BS(comp_weight(ob1, ob2) + "."));
  if (!IS_LEARNER(TP))
  {
    TP->AddMoney(-vgl_preis);
    ZENTRALBANK->PayIn(vgl_preis);
    write ("\n"+BS(Name(WER,1)+" haelt seine Hand auf, und Du bezahlst "+
      "widerwillig die "+vgl_preis+" Muenzen. Insgeheim denkst Du Dir, was "+
      "fuer ein Wucher das doch ist, bist aber doch froh, etwas erfahren "+
      "zu haben.\n"));
  } else {
    write("\n"+WEBS("Immer wieder schoen, wenn mal ein Magier vorbeischaut! "
        "Komm doch oefter mal hierher!")+"\n");
  }
  return 1;
}

string comp_quality(object ob1, object ob2, int typ)
{
  int wert1, wert2, diff, h1, h2;
  string name1, name2;
  name1 = capitalize(ob1->name(WER, 1));
  name2 = ob2->name(WER, 1);
  if (typ == 1)
  {
    wert1 = ob1->QueryProp(P_WC);
    wert2 = ob2->QueryProp(P_WC);
    h1 = ob1->QueryProp(P_NR_HANDS);
    h2 = ob2->QueryProp(P_NR_HANDS);
    write (BS(name1 + " ist ein "+(h1==1?"Einh":(h1==2?"Zweih":h1+"-H"))+
      "aender, " + name2 +
      (h1==h2?" auch":" ein "+
       (h2==1?"Einh":(h2==2?"Zweih":h2+"-H"))+
       "aender")+".\n"));
    h1 = ob1->QueryProp(P_WC_FIXFACTOR);
    h2 = ob2->QueryProp(P_WC_FIXFACTOR);
    if (h1 > h2)
      write(name1+" liegt besser in der Hand als "+name2+".\n");
    else if (h1 < h2)
      write(name1+" liegt schlechter in der Hand als "+name2+".\n");
    else
      write(name1+" und "+name2+" liegen etwa gleich gut in der Hand.\n");
  }
  else
  {
    wert1 = ob1->QueryProp(P_AC);
    wert2 = ob2->QueryProp(P_AC);
  }
  diff = wert1 - wert2;
  if (IS_WIZARD(TP) && TP->QueryProp(P_WANTS_TO_LEARN))
  {
    write("  Typ = " + typ + ", d.h. " + (typ==1 ? "Waffen" : "Ruestungs") + "vergleich.\n");
    write("  Hands1: " + h1 + "\n");
    write("  Hands2: " + h2 + "\n");
    write("  Wert1: " + wert1 + "\n");
    write("  Wert2: " + wert2 + "\n");
    write("  Wertdifferenz: " + diff + "\n");
  }
  if (diff > 2*wert2) return  (name1 + " laesst " + ob2->name(WEN, 1) + " richtig mickrig aussehen" );
  if (diff > wert2) return (name1 + " ist viel besser als " + name2);
  if (diff > wert2/5) return (name1 + " ist besser als " + name2);
  if (diff > wert2/10) return (name1 + " ist etwas besser als " + name2);
  if (-diff > 2*wert1) return (name1 + " wirkt mickrig neben " + ob2->name(WEM, 1));
  if (-diff > wert1) return (name1 + " ist viel schlechter als " + name2);
  if (-diff > wert1/5) return (name1 + " ist schlechter als " + name2);
  if (-diff > wert1/10) return (name1 + " ist etwas schlechter als " + name2);
  return (name1 + " und " + name2 + " sind etwa gleich gut");
}

string comp_weight(object ob1, object ob2)
{
  string name1, name2;
  int wert1, wert2, diff;
  name1 = capitalize(ob1->name(WER, 1));
  name2 = ob2->name(WER, 1);
  wert1 = ob1->QueryProp(P_WEIGHT);
  wert2 = ob2->QueryProp(P_WEIGHT);
  diff = wert1 - wert2;
  if (IS_WIZARD(TP) && TP->QueryProp(P_WANTS_TO_LEARN))
  {
    write("  Gewicht1: " + wert1 + "\n");
    write("  Gewicht2: " + wert2 + "\n"); 
    write("  Gewichtsdifferenz: " + diff + "\n");
  }
  if (diff > wert2*3/2) return (name1 + " ist viel schwerer als " + name2);
  if (diff > wert2/3) return (name1 + " ist schwerer als " + name2);
  if (diff > wert2/6) return (name1 + " ist etwas schwerer als " + name2);
  if (-diff > wert1*3/2) return (name1 + " ist viel leichter als " + name2);
  if (-diff > wert1/3) return (name1 + " ist leichter als " + name2);
  if (-diff > wert1/6) return (name1 + " ist etwas leichter als " + name2);
  return (name1 + " und " + name2 + " sind etwa gleich schwer");
}

