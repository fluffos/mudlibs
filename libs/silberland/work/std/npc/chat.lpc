#define NEED_PROTOTYPES

#include <living/combat.h>
#include <thing/properties.h>
#include <properties.h>

#define ME this_object()

/*
 * Some simple chat variables
 */

/*
 * heart_beat is called so the monster may chat.
 */
heart_beat()
{
  if( InFight() ) DoAttackChat();
  else            DoChat();
}

void SetChats(int chance, mixed strs) {
  if (!pointerp(strs))
    return;
  SetProp(P_CHAT_CHANCE,chance);
  SetProp(P_CHATS,strs);
}

void SetAttackChats(int chance, mixed strs) {
  if (!pointerp(strs))
    return;
  SetProp(P_ACHAT_CHANCE,chance);
  SetProp(P_ACHATS,strs);
}

void AddChat(string chat) {
  if (!pointerp(QueryProp(P_CHATS)))
    SetProp(P_CHATS, ({ chat }) );
  else
    SetProp(P_CHATS, QueryProp(P_CHATS) + ({ chat }) );
}

void AddAttackChat(string chat) {
  if (!pointerp(QueryProp(P_ACHATS)))
    SetProp(P_ACHATS, ({ chat }) );
  else
    SetProp(P_ACHATS, QueryProp(P_ACHATS) + ({ chat }) );
}

void DoAttackChat()
{
  int i;
  string *c;
  object *enemies;
  string msg;

  if (!ME || !environment(ME) || (QueryProp(P_DISABLE_ATTACK)>0)) return;
  if (random(100) < QueryProp(P_ACHAT_CHANCE))
    if ((c = QueryProp(P_ACHATS)) && sizeof(c)) 
    {
      msg = process_string( c[random(sizeof(c))] );
      for (i = sizeof(enemies = PresentEnemies()); i-->0; )
        if (enemies[i])
          tell_object(enemies[i], msg);
    }
}

void DoChat() {
  string *c;
  if (!ME || !environment(ME))
    return;
  if (random(100) < QueryProp(P_CHAT_CHANCE))
    if ((c = QueryProp(P_CHATS)) && sizeof(c)) 
      tell_room(environment(ME),
		process_string(c[random(sizeof(c))]));
}
