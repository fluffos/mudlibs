string *_query_eye_colors()
{
  return ({"smaragdgruen", "saphirblau", "rubinrot", "amethystviolett", 
           "goldgesprenkelt", "obsidianschwarz", "bernsteinfarben", "silbern"});
}

string *_query_hair_colors()  
{
  return ({"goldblond", "nachtschwarz", "eichenbraun", "mondweiss", 
           "blauschwarz", "sonnengelb", "hellblond", "silbern"});
}

