#pragma strong_types

inherit "std/player/base";

#include <properties.h>
#include <attributes.h>
#include <environment.h>
#include <moving.h>
#include <new_skills.h>

void create()
{
  base::create();

  SetDefaultHome("/d/kristallwald/sargola/dorf/room/kapelle");
  SetPrayRoom("/d/kristallwald/sargola/dorf/room/kapelle");

  AddId("Elfenspieler");
  SetProp(P_AVERAGE_SIZE, 195);
  SetProp(P_AVERAGE_WEIGHT, 70000);
  SetProp(P_ATTRIBUTES_OFFSETS, ([ A_INT:5, A_DEX:3, A_CON:1, A_STR:-2 ]) );
  SetProp(P_MAX_FOOD, 100);
  SetProp(P_MAX_DRINK, 130);
  SetProp(P_MAX_ALCOHOL, 70);
  SetProp(P_FOOD_DELAY, 10);
  SetProp(P_DRINK_DELAY, 8);
  SetProp(P_ALCOHOL_DELAY, 5);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:10,T_RANGE_MAX:30]));

  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_MAGIC : -0.2,
         DT_MIND  : -0.1,
         DT_HOLY  :  0.1,
         DT_UNHOLY:  0.1 ]) );

  SetProp(P_RACE_TT_MV,
      ([ TT_OTHER:      4,
         TT_CAVE:       13,
         TT_HOUSE:      6,
         TT_HILL:       8,
         TT_FOREST:     3,
         TT_TOWN:       11,
         TT_MOUNTAIN:   13,
         TT_DESERT:     9,
         TT_JUNGLE:     6,
         TT_SWAMP:      15,
         TT_PLAIN:      6,
         TT_ARCTIC:     12,
         TT_UNDERWATER: 12,
         TT_WATER:      10,
         TT_ROAD:       5,
         TT_AIR:        3,]) );
  SetProp(P_MATERIAL_KNOWLEDGE,
      ([ MATGROUP_WOOD:30,
         MATGROUP_HERBAL:30, 
         MATGROUP_LIVING:20 ]) );
}

string _query_race()
{
  return "Elf";
}

string *_query_racestring()
{
  if (QueryProp(P_GENDER) == FEMALE)
    return ({"Elfe","Elfe","Elfe","Elfe"});
  return ({"Elf","Elfen","Elf","Elf"});
}

string _query_racedescr()
{
  return break_string(
    "Elfen sind grosse, hagere Wesen, etwa 1,90 m von Statur. Ihr am "
    "meisten charakteristisches Merkmal sind wohl ihre langen, spitzen "
    "Ohren. Sie haben einen beeindruckenden Feinsinn fuer die Natur, "
    "der sie auch entstammen und der sie sich auch stark verbunden "
    "fuehlen. Daher verwundert es auch nicht weiter, dass sie sich am "
    "liebsten in ruhige Waelder zurueckziehen, um sich Dingen wie der "
    "Kunst und der Musik zu widmen. Groessere Doerfer oder Staedte "
    "hingegen werden von Elfen meist gemieden. Ein besonderer Wesenszug "
    "der Elfen ist wohl ihre ausserordentliche Klugheit und Weisheit. "
    "Mit ihr haben sie schon so manchen ueberlegen geglaubten Feind "
    "besiegt. Ihre Intelligenz verleitet Elfen nur allzuoft zu "
    "hemmungsloser Arroganz - und wenn sie erstmal begonnen haben, "
    "ueber etwas zu philosophieren, kann man ihnen mitunter noch "
    "stundenlang zuhoeren...", 78);
}

int QueryAllowSelect() { return 1; }

int _query_hp_delay() {
  int re;
  re = Query(P_HP_DELAY);
  if (environment() && environment()->QueryProp(P_INDOORS))
    re++;
  else
    re--;
  return re;
}
int _query_sp_delay() {
  int re;
  re = Query(P_SP_DELAY);
  if (environment() && environment()->QueryProp(P_INDOORS))
    re++;
  else
    re--;
  return re;
}

string *_query_default_guild_male_titles()
{
  return ({
      "der hoffnungsvolle Jungelf", "der Blumenpfluecker",
      "der Baumfreund",     "der Gaertner",        "der Waldlaeufer",
      "der Faehrtensucher", "der Pfadfinder",      "der Kundschafter",
      "der Jaeger",         "der Grosswildjaeger", "der Wildnisexperte",
      "der Bogenschuetze",  "der erfahrene Bogenschuetze", "der Saenger",
      "der Barde",          "der Sternensaenger",  "der Wipfellaeufer",
      "der Sterndeuter",    "der angehende Elfenseher", "der Elfenseher" });
}

string *_query_default_guild_female_titles()
{
  return ({
      "die hoffnungsvolle Jungelfe", "die Blumenpflueckerin",
      "die Baumfreundin",     "die Gaertnerin",        "die Waldlaeuferin",
      "die Faehrtensucherin", "die Pfadfinderin",      "die Kundschafterin",
      "die Jaegerin",         "die Grosswildjaegerin", "die Wildnisexpertin",
      "die Bogenschuetzin",   "die erfahrene Bogenschuetzin",
      "die Saengerin",        "die Bardin",            "die Sternensaengerin",
      "die Wipfellaeuferin",  "die Sterndeuterin",
      "die angehende Elfenseherin", "die Elfenseherin" });
}

