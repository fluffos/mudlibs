#include <defines.h>

// asynchron() -- asynchron process handling
// the cmd will be executed like map_array, but stopped and reinitiated with
// call_out() when the evaluation time is exceeded
varargs void asynchron(mixed *array, closure cmd, mixed extra, int c)
{
  int i, j;
  int st;

  st = time();
  j = sizeof(array);
  if ( !pointerp(extra) )
      extra = ({});

  while ( i < j && get_eval_cost() > 200000 )
    apply( cmd, array[i..i++] + extra );

  if ( i < j )
  {
    if ( !c )
      tell_object( ME, sprintf( "%O: entering asynchronous mode\n", cmd ) );

    // langsamerer call_out wenn Aufruf > 1 Sekunde gedauert hat -> Anti-Lag
    call_out( #'asynchron/*'*/, (st != time() ? 3 : 1), array[i..], cmd, extra, 1 );
  }
  else if (c)
    tell_object( ME, sprintf( "%O: done.\n", cmd ) );
}
