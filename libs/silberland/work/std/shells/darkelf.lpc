nosave int old_align;
nosave int last_light=100;
nosave string *ch_l, *ch_d, *ch_al, *ch_ad, *ch_lad;     // chats for light, dark,
                                                         // and artificial light/dark

void create()
{
  base::create();

  SetDefaultHome("/d/unterwelt/zordan/dhrkion/room/tempel");
  SetPrayRoom("/d/unterwelt/zordan/dhrkion/room/tempel");

  AddId("Dunkelelfenspieler");
  AddClass(CL_NIGHTVISION);
  AddClass(CL_DARKELF);
  SetProp(P_DEFAULT_GUILD, "dunkelelfen");
  SetProp(P_AVERAGE_SIZE, 185);
  SetProp(P_AVERAGE_WEIGHT, 72000);
  SetProp(P_ATTRIBUTES_OFFSETS, ([ A_STR:-1, A_DEX:4, A_INT:4 ]) );
  SetProp(P_MAX_FOOD, 90);
  SetProp(P_MAX_DRINK, 135);
  SetProp(P_MAX_ALCOHOL, 75);
  SetProp(P_FOOD_DELAY, 10);
  SetProp(P_DRINK_DELAY, 9);
  SetProp(P_ALCOHOL_DELAY, 5);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:15,T_RANGE_MAX:35]));
  SetProp(P_ALIGN, -1000);
  SetProp(P_MSGIN,"schleicht herein");
  SetProp(P_MSGOUT,"schleicht");
  SetProp(P_MMSGIN,"tritt aus dem Schatten hervor");
  SetProp(P_MMSGOUT,"verschwindet im Schatten");

  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_UNHOLY: -0.2,
         DT_HOLY  :  0.25,
         DT_LIGHT :  0.3,
         DT_MIND  : -0.1,
         DT_MAGIC : -0.1]) );

  SetProp(P_RACE_TT_MV,
      ([ TT_OTHER:      4,
         TT_CAVE:       3,
         TT_HOUSE:      6,
         TT_HILL:       9,
         TT_FOREST:     9,
         TT_TOWN:       9,
         TT_MOUNTAIN:   14,
         TT_DESERT:     10,
         TT_JUNGLE:     9,
         TT_SWAMP:      14,
         TT_PLAIN:      6,
         TT_ARCTIC:     12,
         TT_UNDERWATER: 14,
         TT_WATER:      12,
         TT_ROAD:       5,
         TT_AIR:        3,]));
  SetProp(P_MATERIAL_KNOWLEDGE,
      ([ MATGROUP_STONE:20,
         MATGROUP_LIVING:10 ]) );

  ch_l = CHAT_LIGHT;
  ch_d = CHAT_DARK;
  ch_al = CHAT_LIGHTENED;
  ch_ad = CHAT_DARKENED;
  ch_lad = CHAT_LIGHT_ADAPTED;
}

void FinalSetup()
{
  ::FinalSetup();
  old_align = QueryProp(P_ALIGN);
}

string _query_race()
{
  return "Dunkelelf";
}

string *_query_racestring()
{
  if (QueryProp(P_GENDER)==2)
    return ({"Dunkelelfe","Dunkelelfe","Dunkelelfe","Dunkelelfe"});
  return ({"Dunkelelf","Dunkelelfen","Dunkelelf","Dunkelelf"});
}

string _query_racedescr()
{
  return break_string(
      "Dunkelelfen sind boesartig und gemein. Sie versuchen alle durch "
      "ihre Hinterlisten zu betruegen und zu hintergehen. Ihre Statur "
      "ist durchaus mit der der Elfen zu vergleichen. Allerdings haben "
      "Dunkelelfen eine fast schwarze Haut und schneeweisse Haare. "
      "Mit ihren dunkelroten Augen durchdringen sie auch tiefste Finsternis, "
      "dagegen haben sie es im hellen Tageslicht oft sehr schwer. Die "
      "Dunkelelfen hassen alles Gute und bekaempfen es, wo es nur geht.", 78);
}

int QueryAllowSelect() { return 1; }

int _query_hp_delay()
{
  int re;
  re = Query(P_HP_DELAY);
  if (environment() && set_light(0)>0 && QueryProp("darkelf_light_adapted"))
    re+=9;
  else
    re--;
  return re;
}

int _query_sp_delay()
{
  int re;
  re = Query(P_SP_DELAY);
  if (environment() && set_light(0)>0 && !QueryProp("darkelf_light_adapted"))
    re+=9;
  else
    re--;
  return re;
}

nosave int _set_align(int a)
{
  if( a > old_align ) a = (old_align+a)/2;
  else a -= (old_align-a)/3;
  old_align = a;
  return Set(P_ALIGN, a);
}

varargs int move(mixed dest, int methods, string direction, string textout,
                 string textin)
{
 int d_light, ret,time,lvl,maxtime;

 if(last_light == 100 && objectp(environment(this_object())))
   last_light = environment(this_object())->_query_total_light();

 ret = ::move(dest, methods, direction, textout, textin);

 // move() erfolgreich und environment vorhanden?
 if (ret > 0 && objectp(environment(this_object())))
 {
   d_light = environment(this_object())->_query_total_light();
   // Man wird blind, wenn ...
   if (QueryProp("darkelf_light_adapted") == 0 &&
       d_light > last_light &&  // ...das Licht im Zielraum > im Startraum und
       d_light > 0 &&           // ...das Licht im Zielraum > 0 ist (== hell),
       last_light <= 0 &&       // ...es vorher dunkel war
       !QueryProp(P_BLIND) &&   // ...und man nicht ohnehin schon blind ist
       !QueryProp(P_GHOST))     // ...man kein Geist ist, weil man sonst nicht
                                // mehr automatisch entblindet wuerde
   {
     time = 2 + (d_light - last_light) * 3;
     tell_object(this_object(),
         "Durch das ploetzliche Licht wirst Du geblendet.\n");
     maxtime=10-QueryProp(P_LEVEL)/15; // 20 sec auf lvl 1, 10 sec auf lvl 80
     maxtime=(maxtime<2?2:maxtime); // aber mindestens 4 sec
     SetProp(P_BLIND, ([BLIND_TIME:(time>maxtime?maxtime:time),
       BLIND_MSG:"Du bist vom hellen Licht geblendet.\n"]));
   }
   last_light = d_light;
 }
 return ret;
}


// Ausgaben fuer Dunkelheit
heart_beat() {
  int light, total_light, rnd;
  string *msg;
  ::heart_beat();
  if(!environment()) return;
  if (!random(50) && interactive(this_object()) &&
      query_idle(this_object())<1000 ) {    // Rechenzeit ist kostbar.
    light=environment()->QueryProp(P_LIGHT);
    total_light=environment()->_query_total_light();
    if(QueryProp("darkelf_light_adapted") && total_light>0) {
      if (!random(3))   // 50*3 -> 1:150
        tell_object(this_object(), ch_lad[random(sizeof(ch_lad))]); // wir sind angepasst!
    }
    else if(light>0 && total_light>0) {        // hell hier, wie immer :(
      if (!random(2))   // 50*2 -> 1:100
        tell_object(this_object(), ch_l[random(sizeof(ch_l))]);
    }
    else if(light<1 && total_light<1) {   // dunkel hier, wie immer :)
      if (!random(4))   // 50*4 -> 1:200
        tell_object(this_object(), ch_d[random(sizeof(ch_d))]);
    }
    else if(light<1 && total_light>0) {   // kuenstlich hell hier :(
      if (!random(2))   // 50*2 -> 1:100
        tell_object(this_object(), ch_al[random(sizeof(ch_al))]);
    }
    else {                                // kuenstlich dunkel hier :)
      if (!random(3))   // 50*3 -> 1:150
        tell_object(this_object(), ch_ad[random(sizeof(ch_ad))]);
    }
  }
}


