#pragma strong_types

inherit "std/player/base";

#include <properties.h>
#include <attributes.h>
#include <environment.h>
#include <moving.h>
#include <new_skills.h>

void create()
{
  base::create();

  SetDefaultHome("/d/huegelland/raballion/hobbits/room/kapelle");
  SetPrayRoom("/d/huegelland/raballion/hobbits/room/kapelle");

  AddId("Hobbitspieler");
  SetProp(P_AVERAGE_SIZE, 100);
  SetProp(P_AVERAGE_WEIGHT, 50000);
  SetProp(P_ATTRIBUTES_OFFSETS, ([ A_INT:2, A_DEX:5, A_CON:1, A_STR:-1 ]) );
  SetProp(P_MAX_FOOD, 130);
  SetProp(P_MAX_DRINK, 70);
  SetProp(P_MAX_ALCOHOL, 100);
  SetProp(P_FOOD_DELAY, 8);
  SetProp(P_DRINK_DELAY, 11);
  SetProp(P_ALCOHOL_DELAY, 4);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:8,T_RANGE_MAX:28]));

  SetProp(P_BODY, 15);
  SetProp(P_HANDS, ({" mit pelzigen Haenden",25,DT_BLUDGEON}) );
  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_TERROR    : -0.15,
         DT_MAGIC     : -0.1,
         DT_SOUND     :  0.2,
         DT_LIGHTNING :  0.1,
         DT_POISON    :  0.1,
         DT_COLD      : -0.15]) );

  SetProp(P_RACE_TT_MV,
      ([ TT_OTHER:      4,
         TT_CAVE:       6,
         TT_HOUSE:      6,
         TT_HILL:       3,
         TT_FOREST:     11,
         TT_TOWN:       8,
         TT_MOUNTAIN:   11,
         TT_DESERT:     13,
         TT_JUNGLE:     8,
         TT_SWAMP:      13,
         TT_PLAIN:      5,
         TT_ARCTIC:     12,
         TT_UNDERWATER: 20,
         TT_WATER:      15,
         TT_ROAD:       5,
         TT_AIR:        4,]) );
  SetProp(P_MATERIAL_KNOWLEDGE,
      ([ MATGROUP_EATABLE:30, 
         MATGROUP_DRUG:30, 
         MATGROUP_POISONOUS:10]) );
}

string _query_race()
{
  return "Hobbit";
}

string *_query_racestring()
{
  if (QueryProp(P_GENDER) == FEMALE)
    return ({"Hobbitfrau","Hobbitfrau","Hobbitfrau","Hobbitfrau"});
  return ({"Hobbit","Hobbits","Hobbit","Hobbit"});
}

string _query_racedescr()
{
  return break_string(
    "Hobbits sind kleine Wesen, sogenannte Halblinge, etwa einen Meter von "
    "Statur. Sie sind relativ stark behaart und zeichnen sich durch ihre "
    "ausserordentliche Geschicklichkeit, ihren Mut und ihre bewunderswerte "
    "Standfestigkeit aus. Ihre Heimat sind huegelige Taeler und Ebenen, "
    "denn ebenso wie die Elfen wissen auch sie die Natur zu schaetzen, "
    "ohne jedoch eine derart starke Bindung mit ihr einzugehen. Wenngleich "
    "Hobbits unermuedliche und vor allem auch kluge Kaempfer sein koennen, "
    "so ist das kriegerische Abenteurerleben doch nicht so recht ihre Sache. "
    "Viel lieber sitzen sie zu Hause in ihrer warmen, gemuetlichen Stube vor "
    "dem Kamin, um ihr Pfeifchen zu rauchen oder sich die koestlichsten "
    "Speisen einzuverleiben. Denn Freundlichkeit und Gemuetlichkeit sind "
    "Eigenschaften, die allen Hobbits gemeinsam sind.", 78);
}

int QueryAllowSelect() { return 1; }

string *_query_default_guild_male_titles()
{
    return ({
      "der hoffnungsvolle Junghobbit", "der Herumtreiber",
      "der kleine Hobbit", "der pelzfuessige Hobbit", "der Spaziergaenger",
      "der Wanderer",      "der Tourist",             "der Reisende",
      "der Weltreisende",  "der Erforscher",          "der Weltenbummler",
      "der Entdecker",     "der Reiseleiter",         "der Nachtschwaermer",
      "der Draufgaenger",  "der Hobbithexer",         "der Hobbitprophet",
      "der Hobbitheld",    "der angehende Hobbitseher", "der Hobbitseher" });
}

string *_query_default_guild_female_titles()
{
    return ({
      "das hoffungsvolle Hobbitmaedchen", "die Herumtreiberin",
      "die kleine Hobbitfrau", "die pelzfuessige Hobbitfrau",
      "die Spaziergaengerin",  "die Wandersfrau",    "die Touristin",
      "die Reisende",          "die Weltreisende",   "die Erforscherin",
      "die Weltenbummlerin",   "die Entdeckerin",    "die Reiseleiterin",
      "die Nachtschwaermerin", "die Draufgaengerin", "die Hobbithexe",
      "die Hobbitprophetin",   "die Hobbitheldin",
      "die angehende Hobbitseherin", "die Hobbitseherin" });
}

mixed RaceDefault(string arg)
{
  if (!arg)
    return 0;
  switch(arg) {
    case P_HANDS : return ({" mit pelzigen Haenden",25,DT_BLUDGEON});
    case P_BODY :  return 15;
  }
  return ::RaceDefault(arg);
}

string *_query_eye_colors()
{
  return ({"braun", "hellbraun", "mittelbraun", "dunkelbraun", 
           "schwarz", "blau", "hellblau", "dunkelblau"});
}

string *_query_hair_colors()  
{
  return ({"hellbraun", "braun", "dunkelbraun", "schwarz", 
           "schwarzbraun", "mittelbraun", "braunschwarz", "dunkelblond"});
}

