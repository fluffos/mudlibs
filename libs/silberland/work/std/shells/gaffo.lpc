inherit "std/player/base";

#include <properties.h>
#include <attributes.h>
#include <environment.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>

create()
{
  base::create();
  SetDefaultHome("/gilden/abenteurer/gaffogilde");
  SetPrayRoom("/d/ebene/Gaffos/room/kapelle");
  if (!QueryProp(P_SIZE)) // Das hier passiert nur beim ersten Einloggen
  {
     SetProp(P_SIZE,160+random(40));
     Set(P_SIZE,SAVE|PROTECTED,F_MODE_AS);
     SetProp(P_HANDS, ({" mit haarigen Pfoten", 30, DT_BLUDGEON}) );
     SetProp(P_ALIGN, 0 );
  }
  SetProp(P_AVERAGE_SIZE, 180);
  SetProp(P_ATTRIBUTES_OFFSETS,
      ([ A_STR:-1, A_DEX:5, A_CON:5, A_INT:-2 ]) );
  SetProp(P_MAX_FOOD, 80);
  SetProp(P_MAX_DRINK, 120);
  SetProp(P_MAX_ALCOHOL, 200);
  SetProp(P_FOOD_DELAY, 4);
  SetProp(P_DRINK_DELAY, 8);
  SetProp(P_ALCOHOL_DELAY, 10);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:0,T_RANGE_MAX:25]));
  SetProp(P_RACE_TT_MV,
      ([ TT_OTHER:      4,
         TT_CAVE:       7,
         TT_HOUSE:      3,
         TT_HILL:       5,
         TT_FOREST:     3,
         TT_TOWN:       3,
         TT_MOUNTAIN:   3,
         TT_DESERT:     10,
         TT_JUNGLE:     7,
         TT_SWAMP:      10,
         TT_PLAIN:      6,
         TT_ARCTIC:     20,
         TT_UNDERWATER: 20,
         TT_ROAD:       2 ]) );
  SetProp(P_MATERIAL_KNOWLEDGE,
      ([MATGROUP_EATABLE:50, MATGROUP_WOOD:20, MATGROUP_HERBAL: 30, MATGROUP_MINERAL: -10, MATGROUP_METAL: -20]) );
  AddId("Gaffospieler");
  AddId("FELL_WUSCHEL");
  SetProp(P_BODY, 15);
  SetProp(P_RESISTANCE_STRENGTHS,
    ([DT_MIND  :  0.3,
      DT_POISON: -0.3,
      DT_ACID  : -0.3,
      DT_FIRE  : 0.1,
      DT_TERROR: 0.3,
      DT_MAGIC: 0.1]) );
}

public int cmd_soul_gaffen(string str) {
  object ziel;
  if(!str || str == 0) {
    write("Du gaffst wie ein waschechter Gaffo.\n");
    say(this_player()->Name(WER)+" gafft mit grossen Gaffoaugen.\n");
    return 1;
  }

  if(objectp(ziel=present(str, environment(this_player())))) {
    write("Du gaffst "+ziel->name(WEN)+" an.\n");
    tell_room(environment(this_player()), this_player()->Name(WER)+" gafft "+ziel->name(WEN)+" an.\n", ({this_player(), ziel}));
    tell_object(ziel, this_player()->Name(WER)+" gafft dich mit grossen Augen an.\n");
    return 1;
  }

  write("Wen willst du angaffen?\n");
  return -1;
}

string _query_race()
{
  return "Gaffo";
}

string *_query_racestring()
{
  if (QueryProp(P_GENDER) == FEMALE)
    return ({"Gaffo","Gaffo","Gaffo","Gaffo"});
  return ({"Gaffo","Gaffo","Gaffo","Gaffo"});
}

string _query_racedescr()
{
  return "Die Gaffos sind scheue Ureinwohner des Silberlands, bekannt fuer "
         "ihre riesigen, neugierigen Augen, mit denen sie die Welt um sich "
         "herum unermuedlich beobachten. Obwohl sie neugierig sind, gelten als leicht "
         "zu beeinflussen und aengstlich. Sie verbringen die meiste Zeit "
         "versteckt im Unterholz oder hohen Gras, von wo aus sie alles \"gaffen\""
         ", was ihre Aufmerksamkeit erregt. Ihr Koerperbau ist haarig und leicht "
         "affenartig, mit kleinen Stummelschwaenzen, die ihnen beim Klettern und "
         "Verstecken helfen. Gaffos sind leidenschaftliche Geniesser von vergorenen "
         "Fruechten und alkoholischen Getraenken, die sie in erstaunlichen Mengen "
         "konsumieren koennen. Doch Vorsicht: Ein betrunkener Gaffo kann im "
         "Vollrausch aeusserst aggressiv und unberechenbar werden, was sie zu "
         "gleichermaßen faszinierenden wie gefaehrlichen Bewohnern des Silberlands macht.";
}

int QueryAllowSelect() { return 1; }

void Attack(object enemy)
{
  int rnd;
  if(QueryProp(P_ALCOHOL) > 170 && !random(20) && QuerySkillAttribute(SA_SPEED) <= 100) {
    write("Im Vollrausch wirst du ganz wild und aggressiv!\n");
    say(Name(WER)+" faengt an im Vollrausch wild um sich zu schlagen!\n");
    rnd = QueryProp(P_LEVEL)/10;
    if(rnd<2) rnd = 2;
    if(rnd>5) rnd = 5;
    ModifySkillAttribute(this_object(), SA_SPEED, 200, rnd);
  }  
  if( enemy )
    ::Attack(enemy);
}

