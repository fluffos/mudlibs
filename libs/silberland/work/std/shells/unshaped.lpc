#pragma strict_types

#define RACE_CHANGE_DIR  "/d/nacht/anatol/rassen/"
#define RACE_CHANGE_ROOM RACE_CHANGE_DIR "r/halle"
#define UNSHAPED_ALLOW_SELECT 1

inherit "/std/player/base";

#include <properties.h>
#include <attributes.h>
#include <environment.h>
#include <moving.h>
#include <new_skills.h>

public void create() {

  base::create();

  SetDefaultHome("/gilden/abenteurer");        // Wie Mensch
  SetPrayRoom("/d/ebene/Midas/room/kapelle");  // Wie Mensch

  AddId("Formloserspieler");

  // Standardgroesse und -gewicht fuer Formlose 
  
  SetProp(P_AVERAGE_SIZE, 175);
  SetProp(P_AVERAGE_WEIGHT, 75000);

  // Keine Attributs-Offsets
  
  SetProp(P_ATTRIBUTES_OFFSETS, ([ A_INT:0, A_STR:0, A_CON:0, A_DEX:0 ]) );

  // Maximalwerte fuer Mampf, Gluck und Schluck gering halten, dazu
  // extremst schlechte beim Abbau - also nicht sehr erfreulich.
  
  SetProp(P_MAX_FOOD,     50);
  SetProp(P_MAX_DRINK,    50);
  SetProp(P_MAX_ALCOHOL,  50);
  SetProp(P_FOOD_DELAY,   20);  
  SetProp(P_DRINK_DELAY,  20);
  SetProp(P_ALCOHOL_DELAY,20);  

  // Temperatur wie Mensch
  
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:10,T_RANGE_MAX:30]));

  SetProp(P_BODY, -20);  // Schlechter noch als ein Barfuss 

  // Absolutest miese Bewegungswerte.
  
  SetProp(P_RACE_TT_MV,
      ([ TT_OTHER:      18,
         TT_CAVE:       18,
         TT_HOUSE:      18,
         TT_HILL:       18,
         TT_FOREST:     18,
         TT_TOWN:       18,
         TT_MOUNTAIN:   18,
         TT_DESERT:     18,
         TT_JUNGLE:     18,
         TT_SWAMP:      18,
         TT_PLAIN:      18,
         TT_ARCTIC:     18,
         TT_UNDERWATER: 18,
         TT_WATER:      18,
         TT_ROAD:       18 ]) );

  // Kein Materialwissen.
  
  SetProp(P_MATERIAL_KNOWLEDGE, ([]) );

  call_out("CheckForChange",2);
}


public string _query_race() {
  return "Formloser";
}

public string *_query_racestring() {
  if (QueryProp(P_GENDER) == FEMALE)
    return ({"Formlose","Formlosen","Formlosen","Formlosen"});
  return ({"Formloser","Formlosen","Formlosen","Formlosen"});
}

public string _query_racedescr() {
  return break_string(
    "Gewaehlt von jenem Geiste, der noch unentschlossen ist, ist der "
    "Formlose ein unvollendetes Geschoepf - eine Gestalt, dazu geschaffen, "
    "eine unsterbliche Seele fuer maximal etwa 24 Lebensstunden zu "
    "beherbergen. Wird diese Huelle einen Lebenstag alt, so wird sie von "
    "der Magie der Wandlung zu sich gerufen, die formlose Unentschlossenheit "
    "muss einer anderen, wirklichen Gestalt (wie zum Beispiel der eines "
    "Zwergen oder eines Hobbits) weichen - die Hallen der Magie der Wandlung, "
    "Anrufungsort dieser Magie, kann jedoch auch schon vor Ablauf dieser "
    "Frist aufgesucht werden. Dies ist der einzige Sinn der Formlosen: "
    "Wirkliche Rassen muessen ihre Gestaltsauren im allgemeinen neun Monate "
    "ruhen lassen, bevor ein (mit Kummer und Schmerz behafteter) Wechsel der "
    "Rasse moeglich ist. Die Formlosigkeit ist also ein kleiner Aufschub "
    "einer schweren Entscheidung.", 78);
}

public int QueryAllowSelect() { return UNSHAPED_ALLOW_SELECT; }

// Keine Lorbeeren fuer Formlose

public string *_query_default_guild_male_titles() {
  return ({
      "das formlose Wesen", "das formlose Wesen", "das formlose Wesen", 
      "das formlose Wesen", "das formlose Wesen", "das formlose Wesen", 
      "das formlose Wesen", "das formlose Wesen", "das formlose Wesen",
      "das formlose Wesen", "das formlose Wesen", "das formlose Wesen",
      "das formlose Wesen", "das formlose Wesen", "das formlose Wesen",     
      "das formlose Wesen", "das formlose Wesen", "das formlose Wesen",
      "das formlose Wesen ","das formlose Wesen" });
}

public string *_query_default_guild_female_titles() {
  return _query_default_guild_male_titles();
}

public mixed RaceDefault(string arg) {
  if (!arg)
    return 0;
  switch(arg) {
    case P_HANDS : return ({" mit formlosen Haenden",10,DT_BLUDGEON});
    case P_BODY :  return -15;
  }
  return ::RaceDefault(arg);
}

nosave void magicSpeaks(string msg) {
    tell_object(this_object(),
      "Die Magie der Wandlung spricht zu Dir:\n\n" +break_string(
      "'' Kleines Wesen. "+msg+" ''",65,"           ",0)[2..]+"\n");
}

nosave void proceedToRaceChange() {
  object rc;

  if ((catch(call_other(RACE_CHANGE_ROOM,"???"))) ||
      (!(rc=find_object(RACE_CHANGE_ROOM)))) return;
  if (((environment(this_object()))==rc) || (((environment(this_object())) && 
        (file_name(environment(this_object()))[0..(strlen(RACE_CHANGE_DIR)+7)]
         ==RACE_CHANGE_DIR "wechsel:")))) return;
  if (QueryProp(P_GHOST)) 
    magicSpeaks(
      "Das Ende Deiner formlosen Gestalt naht! "
      "Wir sind bereit, Dich zu Uns zu rufen, doch benoetigst Du "
      "auch eine sterbliche Huelle, die Dir verlorengegangen sein muss. "
      "Versuche, sie wieder zu erhalten und warte, bis Unser Ruf Dich "
      "erneut ereilt.");
  else {
    magicSpeaks(
      "So ist das Ende Deiner formlosen Gestalt gekommen, die Zeit der "
      "Entscheidung da, kleines Wesen. Wir, die Magie der Wandlung, rufen "
      "Dich zu uns!");
    if (move(rc,M_GO|M_NOCHECK,0,
       "wird von der Magie der Wandlung gerufen und verblasst",
       "folgt dem Ruf der Magie der Wandlung und "
       "erscheint verbluefft neben Dir") !=1)
      magicSpeaks(
         "Leider vermoegen Wir nicht, Unser Wesen in diesen Ruf zu "
         "legen. Folge nun Du ihm selbst, suche auf die Hallen "
         "der Magie der Wandlung. Dort wirst Du Uns finden.");
  }
  return;
}

public int TimeTillRaceChangeLeft() {
  return (((int)QueryProp(P_AGE)>86400)?0:86400-(int)QueryProp(P_AGE));
}

public void CheckForChange() {
  int i;
  if (!environment(this_object()))
    call_out("CheckForChange",2);
  else if (!i=TimeTillRaceChangeLeft()) 
    proceedToRaceChange();
  else 
    magicSpeaks(time2string(
        "Dein Antlitz ist noch formlos, die "
        "Auren Deiner Gestalt noch immer ohne Erfuellung. In etwa %x %X "
        "wird Dich Unser Ruf ereilen. Gehe in Dich und trachte danach, "
        "die Gestalt zu erkennen, nach der Dein Geist und Deine Seele "
        "verlangt. Sind Deine Gedanken klar, so kannst Du auch aus eigenen "
        "Kraeften die Hallen der Magie der Wandlung aufsuchen.",i));
}

public void reset() {
  ::reset();
  if ((!interactive(this_object())) ||       // Blueprint ...
      (find_call_out("CheckForChange")>=0))  // Paranoia
    return;   
  CheckForChange();
}

