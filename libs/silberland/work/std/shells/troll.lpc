inherit "std/player/base";

#include <properties.h>
#include <attributes.h>
#include <environment.h>
#include <moving.h>
#include <combat.h>

nosave int lev, hbonus;

void create()
{
  base::create();

  SetDefaultHome("/d/gebirge/speedy/trollager/room/kapelle");
  SetPrayRoom("/d/gebirge/speedy/trollager/room/kapelle");

  AddId("Trollspieler");
  SetProp(P_AVERAGE_SIZE, 330);
  SetProp(P_AVERAGE_WEIGHT, 350000);
  SetProp(P_ATTRIBUTES_OFFSETS, ([ A_STR:6, A_DEX:-2, A_CON:7, A_INT:-5 ]) );
  SetProp(P_MAX_FOOD, 150);
  SetProp(P_MAX_DRINK, 100);
  SetProp(P_MAX_ALCOHOL, 100);
  SetProp(P_FOOD_DELAY, 13);
  SetProp(P_DRINK_DELAY, 13);
  SetProp(P_ALCOHOL_DELAY, 6);
  SetProp(P_HP_DELAY, 0);
  SetProp(P_SP_DELAY, 6);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:5,T_RANGE_MAX:30]));
  SetProp(P_ALIGN, -333);
  SetProp(P_MSGIN,"trampelt herein");
  SetProp(P_MSGOUT,"trampelt");

  SetProp(P_BODY, 10);
  SetProp(P_HANDS, ({" mit starken Trollhaenden",55,DT_BLUDGEON}) );
  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_BLUDGEON  : -0.05,
         DT_PIERCE    : -0.05,
         DT_RIP       : -0.05,
         DT_SQUEEZE   : -0.05,
         DT_SLASH     : -0.05,
         DT_WHIP      : -0.05,
         DT_TERROR    : -0.2,
         DT_AIR       : -0.2,
         DT_MAGIC     :  0.1,
         DT_FIRE      :  0.35,
         DT_LIGHT     :  0.1, 
         DT_LIGHTNING :  0.1,
         DT_MIND      :  0.2]) ) ;

  SetProp(P_RACE_TT_MV,
      ([ TT_OTHER:      4,
         TT_CAVE:       7,
         TT_HOUSE:      10,
         TT_HILL:       9,
         TT_FOREST:     10,
         TT_TOWN:       10,
         TT_MOUNTAIN:   7,
         TT_DESERT:     16,
         TT_JUNGLE:     15,
         TT_SWAMP:      25,
         TT_PLAIN:      7,
         TT_ARCTIC:     14,
         TT_UNDERWATER: 13,
         TT_WATER:      25,
         TT_ROAD:       6,
         TT_AIR:        6,]) );
  SetProp(P_MATERIAL_KNOWLEDGE,
      ([ MATGROUP_SOLID: -50,
         MATGROUP_FLUID: -50,
         MATGROUP_GAS:   -50]) );
}

void FinalSetup()
{
  ::FinalSetup();
  lev = QueryProp(P_LEVEL);
  if (lev >= 50) hbonus = 101; else hbonus = lev * 2 + 1;   // Hands-Bonus
}

string _query_race()
{
  return "Troll";
}

string *_query_racestring()
{
  if (QueryProp(P_GENDER) == FEMALE)
    return ({"Trollfrau","Trollfrau","Trollfrau","Trollfrau"});
  return ({"Troll","Trolls","Troll","Troll"});
}

string _query_racedescr()
{
  return break_string(
      "Trolle sind riesige Kreaturen, die im Kampf durch ihre "
      "brutale Gewalt und Kraft ueberzeugen. Ausserdem haben sie "
      "die Eigenart, dass sie schneller als alle anderen Rassen "
      "ihre Wunden heilen. Ansonsten sind sie eher schwer von "
      "Begriff. Durch ihre Groesse sind sie auch sehr tolpatschig "
      "und ungeschickt. Also alles in allem grosse Dummkoepfe, die "
      "ihr Gehirn in den Armen haben.", 78);
}

int QueryAllowSelect() { return 1; }

int _query_body()
{
  return Query(P_BODY)+(lev>50?50:lev)/2;
}

_query_hands()
{
  mixed h;
  h=Query(P_HANDS);
  return ({ h[0], h[1]+random(hbonus), h[2] });
}

void heart_beat()
{
  ::heart_beat();
  if (!random(500) && interactive(this_object()) &&
      query_idle(this_object()) > 180 && environment())
    tell_room(environment(), Name(WER,1)+" kratzt sich am Hintern.\n", 
        ({this_object()}) );
}

void reset()
{
  if (file_name()[0..4]=="/std/") {
    set_next_reset(-1);
    return;
  }
  lev = QueryProp(P_LEVEL);     // Einmal pro Reset geschieht die Anpassung
  if (lev >= 50) hbonus = 101; else hbonus = lev * 2 + 1;   // Hands-Bonus!
  if( QueryProp(P_BLIND) && random(70) < lev )
  {
    if( !mappingp(QueryProp(P_BLIND)) || 
        !QueryProp(P_BLIND)[BLIND_END_MSG] )
      tell_object(this_object(),"Du kannst wieder sehen.\n");
    SetProp(P_BLIND, 0);
  }
  else if( QueryProp(P_DEAF) && random(70) < lev )
  {
    if( !mappingp(QueryProp(P_DEAF)) ||
        !QueryProp(P_DEAF)[DEAF_END_MSG] )
      tell_object(this_object(),"Du kannst wieder hoeren.\n");
    SetProp(P_DEAF, 0);
  }
  else if( QueryProp(P_FROG) && random(70) < lev )
  {
    tell_object(this_object(),"Du bist kein Frosch mehr.\n");
    SetProp(P_FROG, 0);
  }
  if( QueryProp(P_POISON) && random(70) < lev )
  {
    AddPoison(-1-QueryProp(P_LEVEL)/20); 
    if( QueryProp(P_POISON) )
      tell_object(this_object(),"Du kaempfst gegen das Gift an.\n");
    else
      tell_object(this_object(),"Du ueberwindest Deine Vergiftung.\n");
  }
  if (!InFight() && QueryProp(P_HP) != QueryProp(P_MAX_HP)) 
  {
    tell_object(this_object(),
        "Langsam schliessen sich Deine Wunden.\n");
    AddHp(random(lev+QueryAttribute(A_CON)));
    AddSp(1);
  }
  ::reset();
}

