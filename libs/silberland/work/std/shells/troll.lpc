{
      return ({
        "der hoffnungsvolle Trolljunge", "der trollige Troll",
        "der kleine Troll",   "der unerfahrene Troll", "der erfahrene Troll",
        "der Troll",          "der Schwertfresser",    "der Keulenschwinger",
        "der Schlagetot",     "der Hobbittoeter",      "der Menschentoeter",
        "der Elfentoeter",    "der Zwergentoeter",     "der Trollkaempfer",
        "der Trollkrieger",   "der riesige Troll",     "der Trollheld",
        "der Trollanfuehrer", "der angehende Trollseher", "der Trollseher" });
}

string *_query_default_guild_female_titles()
{
      return ({
       "das hoffnungsvolle Trollmaedchen", "die trollige Trollin",
       "die kleine Trollin", "die unerfahrene Trollin", "die erfahrene Trollin",
       "die Trollin",      "die Schwertfresserin",   "die Keulenschwingerin",
       "die Schlagetoeterin",  "die Hobbittoeterin",  "die Menschentoeterin",
       "die Elfentoeterin",    "die Zwergentoeterin", "die Trollkaempferin",
       "die Trollkriegerin",   "die riesige Trollin", "die Trollheldin",
       "die Trollanfuehrerin", "die angehende Trollseherin",
       "die Trollseherin" });
}

mixed RaceDefault(string arg)
{
  if (!arg)
    return 0;
  switch(arg) {
    case P_HANDS : return ({" mit starken Trollhaenden",55,DT_BLUDGEON});
    case P_BODY :  return 10;
  }
  return ::RaceDefault(arg);
}

string *_query_eye_colors()
{
  return ({"steingraun", "granitgrau", "rot", "violett", 
           "schwarz", "hellgrau", "grau", "dunkelgrau"});
}

string *_query_hair_colors()  
{
  return ({"schwarz", "dunkelgruen", "gruen", "schlammgruen", 
           "giftgruen", "hellgruen", "grasgruen", "schwarzgruen"});
}

