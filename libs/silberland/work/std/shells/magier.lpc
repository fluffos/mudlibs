#define LEARNING() QueryProp(P_WANTS_TO_LEARN)

#define IDLE_MAX 7200

nosave string my_snooper;
nosave int _hbstop, _hbforce;
nosave int _age;

void create()
{
  if (!is_clone(ME))
    return;
  
  base::create();
  
  Set(P_RACE, SAVE, F_MODE_AS);
  Set(P_ZAP_MSG, SAVE, F_MODE_AS);
  Set(P_TRANK_FINDEN, SAVE, F_MODE_AS);
  Set(P_HANDS, SAVE, F_MODE_AS);
  Set(P_SHORT_CWD, SAVE, F_MODE_AS);
  SetProp(P_MAGIC, 1);
  SetDefaultHome("gilden/abenteurer");
  SetProp(P_ENEMY_DEATH_SEQUENCE,
	  ([17:"Der Tod schuettelt verstaendnislos den Kopf.\n\n",
	    18:"Der Tod sagt: WIESO MUSSTEST DU DICH AUCH UNBEDINGT MIT EINEM MAGIER ANLEGEN?\n\n"]));
  SetProp(P_ATTRIBUTES_OFFSETS,([]));
  Set(P_RACESTRING, SAVE, F_MODE_AS);

  SetProp(P_AVERAGE_SIZE, 180);
  AddClass(CL_NIGHTVISION);
  SetProp(P_SIZE, 180);
}

int id (string str) {
  if (QueryProp(P_INVIS) &&
      (!this_interactive() ||!IS_LEARNER(this_interactive())))
    return 0;
  return ::id(str);
}

nosave string _query_racedescr()
{
  return "Magier koennen einfach alles. Aber manche Magier koennen mehr.\n";
}

string _query_race()
{
  if (previous_object() && previous_object()->query_login_object())
    return 0;

  return Query(P_RACE) ? Query(P_RACE) : Set(P_RACE, "Magier");
}

string *_query_racestring()
{
  if (!pointerp(Query(P_RACESTRING)))
    return
    ({QueryProp(P_RACE),QueryProp(P_RACE),QueryProp(P_RACE),QueryProp(P_RACE)});
  else
    return Query(P_RACESTRING);
}

nosave string convert_message(string str, object obj)
{
  // efun:: damit @@foo@@ am Anfang kommen kann.
  str = implode( efun::explode( str, "@@wer@@" ), obj->name(WER,2) );
  str = implode( efun::explode( str, "@@wessen@@" ), obj->name(WESSEN,2) );
  str = implode( efun::explode( str, "@@wem@@" ), obj->name(WEM,2) );
  str = implode( efun::explode( str, "@@wen@@" ), obj->name(WEN,2) );
  str = implode( efun::explode( str, "@@ich@@" ), this_object()->name(WER,2) );
  return capitalize(str);
}

nosave int zap(string str)
{
  object opfer;
  string* message;

  if (!str || !LEARNING()) return 0;
  // if (opfer=present(str))
  if (opfer=present(str, environment()))
  {
    // write (sprintf("Opfer: %O\n", opfer));
    if (living(opfer))
    {
      message = QueryProp(P_ZAP_MSG);
      if (!pointerp(message) || sizeof(message)!=3)
      {
	say(this_object()->Name() +" beschwoert einen Blitz vom Himmel.\n");
	write("Du zappst "+opfer->name(WEN,2)+".\n");
      }
      else
      {
	write(convert_message(message[0], opfer));
	say(convert_message(message[1], opfer), ({this_player(), opfer}));
	tell_object(opfer, convert_message(message[2], opfer));
      }
      opfer->die();
      return 1;
    }
    else
    {
      write("Aber "+capitalize(str)+" lebt nicht.\n");
      return 1;
    }
  }
  else
  {
    write("Sowas siehst Du hier nicht.\n");
    return 1;
  }
}

nosave int peace(string sname)
{
  object obj, *enem;
  string myself, him;

  if (!LEARNING())
    return 0;
  myself=funcall(#'name,WER);//');
  if (!sname)
  {
    say(myself+" stiftet Frieden.\n");
    for (obj=first_inventory(environment()); obj; obj=next_inventory(obj))
      obj->StopHuntingMode();
  }
  else
  {
    obj=find_living(sname);
    if (!obj)
    { 
      write("Kein solches Lebewesen im Spiel.\n");
      return 1;
    }
    him=obj->name(WEM);
    for(enem=(object *)obj->StopHuntingMode()[0];sizeof(enem);enem=enem[1..])
    {
      enem[0]->StopHuntFor(obj);
      tell_object(obj,myself+" beendet Deinen Kampf mit "+enem[0]->name(WEM)+".\n");
      tell_object(enem[0],myself+" beendet Deinen Kampf mit "+him+".\n");
    }
  }
  write("Ok.\n");
  return 1;
}

nosave int traenke()
{
  if(SetProp(P_TRANK_FINDEN, !QueryProp(P_TRANK_FINDEN)))
    write("Du kannst jetzt Zaubertraenke finden.\n");
  else
    write("Du findest jetzt keine Zaubertraenke mehr.\n");
  return 1;
}

mixed verfolger()
{
  mixed *pur;

  if (!pointerp(pur=QueryProp(P_PURSUERS)))
    return 0;
  else
    return pur[0];
}

int verfolge(string str)
{
  mixed *pur, lv,lv2;
  
  if (!LEARNING())
    return 0;

  if (!str || str=="")
  {
    if (pointerp(pur=Query(P_PURSUERS)) && objectp(pur[0])) {
      write( sprintf( "Ok, Du verfolgst %s jetzt nicht mehr.\n",
                      pur[0]->Name(WEN) ) );
      pur[0]->RemovePursuer(ME);
    }
    else
      write("Du hast niemanden verfolgt.\n");
    return 1;
  }

  str=lower_case(str);
  if (intp(lv=match_living(str))||!lv)
  {
    write("Kein solches Wesen gefunden.\n");
    return 1;
  }
  if (objectp(lv))
    lv2=lv;
  else
  {
    lv2=find_player(lv);
    if (!lv2)
      lv2=find_living(lv);
  }
  if (!lv2)
  {
    write("Hm, irgendwas geht schief :(\n");
    return 1;
  }
  lv2->AddPursuer(ME);
  write("Ok, Du verfolgst jetzt "+lv2->name(WEN)+".\n");
  lv2->TakeFollowers();
  return 1;
}

void heart_beat()
{
  mixed *en;
  
  if (!_hbforce && ((!(en=QueryEnemies()) ||
      !sizeof(en[0]) && Query(P_WANTS_TO_LEARN))))
  {
    _age = age;
    _hbstop = absolute_hb_count();
    set_heart_beat(0);
    return;
  }
  base::heart_beat();
}

int MayAddWeight() { return 0;}

varargs int remove()
{
  string workroom;

  if (query_once_interactive(this_object())) {
    workroom = "/players/"+getuid()+"/workroom";
    if( !environment() || file_name(environment()) != workroom )
      catch(move(workroom, M_GO, "nach Hause"));
  }
  return (int)base::remove();
}

mixed level_sort(mixed list)
{
  mixed *sorted_arr;
  int i;
  sorted_arr = ({ ({ }),({ }) });
  for (i=sizeof(list)-1;i>=0;i--)
  {
    sorted_arr[0] += ({ list[i]->QueryProp(P_LEVEL) });
    sorted_arr[1] += ({ list[i] });
  }
  sorted_arr = order_alist(sorted_arr);
  return sorted_arr[1];
}

nosave int pwho()
{
  object* user;
  mixed* spieler, res;
  int i;
  mixed *hands;
  if (!IS_WIZARD(this_player()))
    return 0;
  user = users();
  spieler = ({ });
  for (i=sizeof(user)-1; i>=0; i--)
    if (!IS_LEARNER(user[i]))
      spieler += ({ user[i] });
  spieler = level_sort(spieler);

  res = "Lvl Name         Erfahrung   QP  Int Str Dex Con   WC   AC     FP   HP (max)\n";
  //     xxx xxxxxxxxxxxx xxxxxxxxx xxxx  xxx xxx xxx xxx xxxx xxxx  xxxxx  xxx (xxx)
  res += "------------------------------------------------------------------------------\n";
  for (i=sizeof(spieler)-1; i>=0; i--)
    res += sprintf("%3d %-12s %9d %4d  %3d %3d %3d %3d %4d %4d  %5d  %3d (%3d)\n",
	   spieler[i]->QueryProp(P_LEVEL),
	   capitalize(getuid(spieler[i])),
	   spieler[i]->QueryProp(P_XP),
	   spieler[i]->QueryProp(P_QP),
	   spieler[i]->QueryAttribute(A_INT),
	   spieler[i]->QueryAttribute(A_STR),
	   spieler[i]->QueryAttribute(A_DEX),
	   spieler[i]->QueryAttribute(A_CON),
	   spieler[i]->QueryProp(P_TOTAL_WC),
	   spieler[i]->QueryProp(P_TOTAL_AC),
	   spieler[i]->QueryProp(P_EP_NUM),
//	   (sizeof(hands=spieler[i]->QueryProp(P_HANDS))?hands[1]:0),
	   spieler[i]->QueryProp(P_HP),
	   spieler[i]->QueryProp(P_MAX_HP));
  ME->More(res);
  return 1;
}


//#@#@#@#@#@

nosave void initialize() {
  filesys::initialize();
}

nosave int allow_snoop(string str)
{ 
  object ob;
  
  if (!str)
  { 
    if (!my_snooper) return 0;
    str=my_snooper;
    my_snooper=0;
    write("Ok, "+capitalize(str)+" Erlaubnis zum Snoopen entzogen.\n");
    ob=query_snoop(this_player());
    if (!ob) return 1;
    if (getuid(ob) != str) return 1;
    tell_object(ob,
      ME->Name(WER)+" zwingt Dich, mit dem Snoopen aufzuhoeren.\n");
    snoop(ob);
    return 1;
  }
  if (my_snooper) allow_snoop(0); /* Remove the other first ! */
  str=lower_case(str);
  ob=find_player(str);
  if (!ob){
    write("Kein solcher Spieler.\n");
    return 1;
  }
  if (query_wiz_grp(ob)>query_wiz_grp(this_player())){
    write("Level des Snoopers groesser als Deiner.\n");
    return 1;
  }
  write("Ok !\n");
  my_snooper=str;
  return 1;
}

nomask int QueryAllowSnoop(object who)
{
  return getuid(who) == my_snooper;
}

nosave int snoop_on(string str)
{
  object ob;
  string flags, plname;
  int fl;
  
  if (!str) {
    snoop(this_player());  /* Abort snoop */
    return 1;
  }
  if (!LEARNING())
    return 0;
  fl=0;
  if (sscanf(str,"%s %s", plname, flags)==2 && flags!="")
  {
    str=plname;
    while (strlen(flags)) {
      switch (flags[0])
      {
	case 'l':
	  fl|=SF_LOCKED; 
	  break;
	case 'f':
	  fl|=SF_FORCE;
	  break;
	default:
	  printf("Unbekanntes Flag %s ignoriert.\n",flags[0..0]);
      }
      flags=flags[1..];
    }
  }
  SetProp(P_SNOOPFLAGS,fl);
  ob = find_player(str);
  if (!ob) {
    write("Spieler "+capitalize(str)+" nicht gefunden.\n");
    return 1;
  }
  if (!snoop(this_player(),ob)){
    write("Du kannst "+ob->name(WEN)+" nicht snoopen !\n");
    return 1;
  }
  write("Du snoopst jetzt "+ob->name(WEN)+".\n");
  return 1;
}

nosave int trans(string str) {
  object living;
  string oldenv;
  if (!LEARNING())
    return 0;
  if (!str) {
    _notify_fail("Trans WEN?\n");
    return 0;
  }
  str=match_living(str,0);
  if (!stringp(str))
    switch (str)
    {
      case -1: write("Das war nicht eindeutig.\n"); return 1;
      case -2: write("So ein Wesen gibt es nicht.\n"); return 1;
    }
  if((living=find_living(str)))
  {
    oldenv=file_name(environment(living));
    if (living->move(file_name(environment(ME)),
        M_TPORT | (query_verb()=="Trans" ? M_NOCHECK : 0) ) <= 0)
    {
      write(living->Name(WER)+" will oder kann nicht kommen!\n");
      tell_object(living, Name(WER)+
		  " wollte Dich teleportieren, hat aber versagt!\n");
      return 1;
    }
    tell_object(living,
		"Ein seltsames Gefuehl ueberkommt Dich ...\n"
		+"Du verlierst die Orientierung ...\n");
    write("OK.\n");
    if (interactive(living) && !IS_LEARNER(living) &&
        !living->QueryProp(P_TESTPLAYER))
      log_file("irregular/TRANS",
          sprintf("%s: %s transt %s von %s nach %s\n",
            dtime(time()), capitalize(getuid(ME)), capitalize(getuid(living)),
             oldenv, file_name(environment(ME)) ));
  }
  else
    write(capitalize(str)+" nicht gefunden!\n");
  return 1;
}

nosave int force_someone(string str)
{
  object living;
  string what, rest;
  string living_name;

  str=this_player()->_unparsed_args();
  if (!LEARNING())
    return 0;
  if( !str || sscanf( str, "%s %s", living_name, what ) != 2 )
  {
    _notify_fail("Zwinge WEN zu WAS?\n");
    return 0;
  }
  if( sscanf( what, "zu %s", rest ) == 1 )
    what = rest;
  if (!(living = find_living(lower_case(living_name))))
  {
    write("Kein solches Lebewesen gefunden!\n");
    return 1;
  }
  if (living->command_me(what))
  {
    write("Hat geklappt!\n");
    if (!IS_LEARNER(living) && !IS_ARCH(this_object()))
      if( find_living(lower_case(living_name)))
        tell_object(living,sprintf("%s zwingt Dich zu: %s\n",
          (QueryProp(P_INVIS) &&
          IS_LEARNER(find_living(lower_case(living_name))))?
          "("+CAP(getuid(this_object()))+")":Name(WER), what));
    if (!living ||
        (!IS_LEARNER(living) && !living->QueryProp(P_TESTPLAYER)))
      log_file("irregular/ZWINGE", 
	     sprintf("%s: %s zwingt %s\n", 
		     dtime(time()), capitalize(geteuid(this_player())),str));
  }
  else
    write("Hat nicht geklappt!\n");
  return 1;
}

nosave int wiz_score_list(string arg) {
  if (arg) wizlist(arg);
  else wizlist();
  return 1;
}

nosave int echo_all(string str)
{
  mixed *u;
  int i;

  if (!LEARNING())
    return 0;
  if (!(str=_unparsed_args())) { // 
    write("Was moechtest Du 'echoallen'?\n");
    return 1;
  }
  u=users();
  for (i=sizeof(u)-1; i>=0; i--)
  {
    if (IS_ARCH(u[i]) && (u[i]->QueryProp(P_WANTS_TO_LEARN) >= 2))
      tell_object(u[i], "[Echoall:"+capitalize(getuid())+"] ");
  }
  shout( str + "\n");
  write( str + "\n");
  return 1;
}

nosave int echo_to(string str)
{
  object ob;
  string who;
  string msg;

  if (!LEARNING())
    return 0;
  if (!(str=_unparsed_args()) || sscanf(str, "%s %s", who, msg) != 2) {
    write("Was moechtest Du 'echoen' ?\n");
    return 1;
  }
  ob = find_living(lower_case(who));
  if (!ob) {
    write("Kein Spieler mit diesem Namen eingeloggt.\n");
    return 1;
  }
  tell_object(ob, msg + "\n");
  write( ob->name(WEN)+"->" + msg + "\n");
  return 1;
}

nosave int mecho_all(string str)  {
  object *who;
  int i;

  if (!LEARNING())
    return 0;
  _notify_fail("Was moechtest Du denn allen Magiern zukommen lassen?\n");
  if (!(str=_unparsed_args())) return 0;
  who=users();
  for (i=0; i<sizeof(who); i++)
    if (IS_LEARNER(who[i]))
      tell_object(who[i], break_string(str,78));
  return 1;
}

nosave int local_commands() 
{
  if (!LEARNING())
    return 0;
  localcmd();
  return 1;
}

private nosave string prettyfile(string str) {
  if (!str) return 0;
  if (str[0..2] == "/d/") return "+"+str[3..<1];
  if (str[0..8] == "/players/") return "~"+str[9..<1];
  return str;
}

private nosave int cmp_user(object i,object j)
{
  return query_ip_number(i) > query_ip_number(j);
}

nosave int list_peoples_wiz() 
{
  mixed *list, res;
  int i, a;
  string a_age,a_ipnum,a_name,a_level,a_idle,a_room,a_end, a_title;

  if (!LEARNING())
    return 0;
  switch(QueryProp("tty")) {
    case "vt100":
    a_ipnum = ""; a_name = ANSI_BOLD; a_level = ANSI_NORMAL;
    a_idle = ANSI_BLINK; a_room = ANSI_NORMAL; a_end = ANSI_NORMAL;
    a_title = ANSI_INVERS; a_age = ANSI_NORMAL;
    break;
    case "ansi":
    a_ipnum = ANSI_GREEN; a_name = ANSI_BOLD; a_level = ANSI_RED;
    a_idle = ANSI_BLACK+ANSI_BOLD; a_room = ANSI_BOLD+ANSI_BLUE;
    a_end = ANSI_NORMAL;
    a_title = ANSI_INVERS; a_age = ANSI_PURPLE;
    break;
    default:
    a_title = a_ipnum = a_name = a_level = a_idle = a_room = a_end = "";
    a_age = "";
  }

  list = sort_array( users(), #'cmp_user );//');
  res = a_title+"There are now " + sizeof(list) + " players";
  for (i=0, a=0; i < sizeof(list); i++)
    if (query_idle(list[i]) >= 5 * 60)
      a++;
  if (a)
    res += " (" + (sizeof(list) - a) + " active)";
  res += ". " + query_load_average() + a_end+ "\n";
  for(i=0; i<sizeof(list); i++) {
    string name_;
    name_ = list[i]->query_real_name();
    if (!name_)
      name_ = "<logon>";
    name_ = capitalize(name_);
    if (list[i]->QueryProp(P_INVIS))
      name_ = "(" + name_ + ")";
    res += sprintf( "%s%-15s%s %s%-12s%s %s%3d%s %s",
	   a_ipnum, query_ip_number(list[i]),a_end,
	   a_name, name_,a_end,
	   a_level, MASTER->get_wiz_level(getuid(list[i])),a_end,
	   a_age
	   );
    res += time2string("%4x %0X",list[i]->QueryProp(P_AGE)*2);
    if (query_idle(list[i]) >= 5 * 60)
      res += a_idle+" I";
    else
      res += "  ";
    res += a_end;
    if (query_editing(list[i]))
      res += a_idle+"E"+a_end;
    else
      res += " ";

    if (query_input_pending(list[i]))
      res += a_idle+"M "+a_end;
    else
      res += "  ";

    if (environment(list[i]))
      res += a_room+prettyfile(file_name(environment(list[i])));
    res += a_end+"\n";
  }
  ME->More(res);

  return 1;
}

/*
 * Temporary move the player to another destination and execute
 * a command.
 */

nosave int in_room(string str)
{
  string room;
  object old_room;
  string cmd,err;
  
  if (!(str=_unparsed_args()) || !LEARNING())
    return 0;
  if (sscanf(str, "%s %s", room, cmd) != 2) {
    write("Usage: in ROOM CMD\n");
    return 1;
  }
  if (!room) {
    write("Fehlerhafter Dateiname.\n");
    return 1;
  }
  old_room = environment();
  room="/secure/master"->_get_path(room,getuid());
  if (file_size(room+".lpc")<0)
    write(room+".c: No such file - trying virtual room ...\n");
  if (err=catch(move_object(room)))
  {
    write("Error moving to room:"+err+"\n");
    return 1;
  }
  if (environment()!=find_object(room) && IS_ARCH(ME))
  {
    write("Move failed - trying efun308 ... ");
    __set_environment(ME,find_object(room));
    if (environment()!=find_object(room))
    {
      write("failed.\n");
      return 1;
    }
    write("suceeded.\n");
  } 
  command(cmd);
  if (old_room) move_object(old_room);
  else {write("Rueckkehr nicht gelungen.\n");return 1;}
  if (environment()!=old_room && IS_ARCH(ME))
  {
    write("Move back failed, trying efun308 ... ");
    __set_environment(ME,old_room);
    if (environment()!=old_room)
      write("failed.\n");
    else
      write("suceeded.\n");
  }
  return 1;
}

nosave int shut_down_game(string str)
{
  if (!IS_ARCH(ME) || ME!=this_interactive())
    return 0;
  _notify_fail("Du musst einen Grund dafuer angeben.\n");
  if (!str=ME->_unparsed_args()) return 0;
  write( "Direkter Shutdown mit Grund \""+str+"\" (ja/nein): " );
  input_to("shut_down_game_2",0,str);
  return 1;
}

nosave int shut_down_game_2(string arg,string str)
{
  if (!IS_ARCH(ME) || ME!=this_interactive())
    return 0;
  if( arg!="ja" ) {
    write( "Shutdown abgebrochen.\n" );
  } else {
    shutdown(str);
  }
  return 1;
}

nosave int at_player(mixed dest)
{
  object ob,old_room;
  mixed ret;
  string cmd;
  
  if (!LEARNING())
    return 0;
  if (!(dest=_unparsed_args())) {
    write("Wohin moechtest Du Dich teleportieren?\n");
    return 1;
  }
  if (sscanf(dest, "%s %s", dest, cmd) != 2) {
    write("Usage: at LIVING CMD\n");
    return 1;
  }
  ob = find_living(dest);
  if (!ob)
  {
    dest=match_living(dest,1);
    if (stringp(dest))
      dest = find_living(dest);
    if (objectp(dest))
      ob=environment(dest);
    else
      ob=0;
  } else
    ob=environment(ob);
  if (!ob)
  {
    _notify_fail("Lebewesen nicht gefunden.\n");
    return 0;
  }
  old_room=environment(this_object());
  move_object(ob);
  if (environment()!=ob && IS_ARCH(ME))
  {
    write("Move failed, trying efun308 ... ");
    __set_environment(ME,ob);
    if (environment()!=ob)
    {
      write("failed.\n");
      return 1;
    }
    write("suceeded.\n");
  }
  command(cmd);
  if (old_room) move_object(old_room);
  else write("Rueckkehr nicht gelungen.\n");
  if (environment()!=old_room && IS_ARCH(ME))
  {
    write("Move back failed, trying efun308 ... ");
    __set_environment(ME,old_room);
    if (environment()!=old_room)
      write("failed.\n");
    else
      write("suceeded.\n");
  }
  return 1;
}

nosave int teleport(string dest) {
  object ob;
  string path;
  mixed ret;

  if (!LEARNING())
    return 0;
  if (!(dest=_unparsed_args())) {
    write("Wohin moechtest Du Dich teleportieren?\n");
    return 1;
  }
  if (verfolger())
    verfolge("");
  if ((ob=find_living(dest)) && (ob=environment(ob))) 
  {
    if( move(ob,M_TPORT | ( query_verb()=="Goto" ? M_NOCHECK : 0) )<=0 )
      write("Dorthin kannst Du nicht gehen!\n");
    return 1;
  }
  path=(mixed)MASTER->_get_path(dest,getuid(this_object()));
  ret=catch(call_other(path,"?"));
  if (ret && file_size(path)<0)
  {
    dest=match_living(dest,1);
    if (stringp(dest) && (ob=environment(find_living(dest)))) 
    {
      if( move(ob,M_TPORT | ( query_verb()=="Goto" ? M_NOCHECK : 0) )<=0 )
        write("Dorthin kannst Du nicht gehen!\n");
      return 1;
    }
    printf("Fehler beim Teleport nach %O: No such file.\n",path);
    return 1;
  } 
  if (ret)
    printf("Fehler beim Teleport nach %O: %O\n",dest,ret);
  ret=catch(move(path,M_TPORT|M_NOCHECK));
  if (stringp(ret))
    ret=implode(explode(ret,"\n"),"");
  if (ret)
    printf("Fehler beim Teleport nach %O: %O\n",dest,ret);
  return 1;
}

nosave int heal(string str)
{
  object ob;
  string it;
  int lp1,mp1,lp2,mp2;

  if (!LEARNING())
    return 0;
  if (!str) return 0;
  it = lower_case(str);
  ob = present(it,environment());
  if (!ob || !living(ob))
    ob = find_living(it);
  if (!ob) {
    write("Dieser Spieler ist momentan nicht da.\n");
    return 1;
  }
  lp1=ob->QueryProp(P_HP);
  mp1=ob->QueryProp(P_SP);
  ob->heal_self(1000000);
  lp2=ob->QueryProp(P_HP);
  mp2=ob->QueryProp(P_SP);
  if (!IS_LEARNER(ob) && !ob->QueryProp(P_TESTPLAYER))
    log_file("irregular/HEAL", 
	     sprintf("%s: %s heilt %s (%s) [%d/%d -> %d/%d = +%d/+%d]\n",
		     dtime(time()),
		     capitalize(geteuid(ME)),
		     ob->name(WEN), capitalize(geteuid(ob)),
                     lp1,mp1,lp2,mp2,lp2-lp1,mp2-mp1));
  tell_object(ob, QueryProp(P_NAME) + " heilt Dich.\n");
  write("Ok.\n");
  return 1;
}

nosave int go_home() 
{
  if (!LEARNING())
    return 0;
  if (query_wiz_level(this_object()) == LEARNER_LVL)
    return (int)move("/secure/merlin", M_GO, "nach Hause");
  else
    return (int)move("players/" + getuid() + "/workroom", M_GO, "nach Hause");
}

nosave int add_domain_master(string str)
{
  string master, domain;

  if (this_object() != this_interactive() || 
      query_wiz_level(this_interactive())<90)
  {
    write("Das darfst Du nicht !\n");
    return 1;
  }
  _notify_fail("Syntax: addmaster <user> <domain>\n");
  if (!str) return 0;
  if (sscanf(str,"%s %s",master,domain)!=2) return 0;
  if (!master || !domain) return 0;
  if (!"/secure/master"->add_domain_master(master,domain))
    write("Hat nicht funktioniert.\n");
  else 
    write("Ok.\n");
  return 1;
}

nosave int remove_domain_master(string str)
{
  string master, domain;

  if (this_object() != this_interactive() || 
      query_wiz_level(this_interactive())<90)
  {
    write("Das darfst Du nicht !\n");
    return 1;
  }
  _notify_fail("Syntax: removemaster <user> <domain>\n");
  if (!str) return 0;
  if (sscanf(str,"%s %s",master,domain)!=2) return 0;
  if (!master || !domain) return 0;
  if (!"/secure/master"->remove_domain_master(master,domain))
    write("Hat nicht funktioniert.\n");
  else
    write("Ok.\n");
  return 1;
}

nosave int invis(string str)
{
  object *alle;
  object *magier;

  if (!LEARNING())
    return 0;

  if (QueryProp(P_INVIS)) {
    write("Du warst schon unsichtbar.\n");
    return 1;
  }

  // Properties setzen
  SetProp(P_INVIS, QueryProp(P_AGE));
  Set(P_LAST_LOGOUT, time());
  Set(P_LAST_VISIBLE_LOGOUT, time());

  // Meldungen
  if (!IS_ARCH(this_object()) || str != "leise")
  {
    alle = filter_array(all_inventory(environment(ME)), #'living);
    magier = filter_array(alle, #'query_once_interactive);
    magier = filter_array( magier,
        lambda( ({ 'x }),
                ({ #'>=, ({ #'query_wiz_level, 'x }), WIZARD_LVL }) ) );
    alle = alle - magier + ({ ME });

    // Raummeldungen:
    tell_room( environment(),
        capitalize(getuid(this_object())) + " geht nach Hause.\n", magier );
    tell_room( environment(),
        capitalize(getuid(this_object())) + " wird unsichtbar.\n", alle );

    // inform Meldung:
    "/secure/merlin"->notify_player_invis(getuid(this_object()), 1);
    write("Du bist jetzt unsichtbar.\n");
  }
  else
    write("Du bist jetzt unbemerkt unsichtbar.\n");

  return 1;
}

nosave int vis(string str)
{
  object *alle;
  object *magier;

  if (!QueryProp(P_INVIS)) {
    write("Du warst schon sichtbar.\n");
    return 1;
  }

  // Properties setzen
  SetProp(P_INVIS, 0);

  // Meldungen
  if (!IS_ARCH(this_object()) || str != "leise")
  {
    alle = filter_array(all_inventory(environment(ME)), #'living);
    magier = filter_array(alle, #'query_once_interactive);
    magier = filter_array( magier,
        lambda( ({ 'x }),
                ({ #'>=, ({ #'query_wiz_level, 'x }), WIZARD_LVL }) ) );
    alle = alle - magier + ({ ME });

    // Raummeldungen:
    tell_room( environment(),
        capitalize(getuid(this_object())) + " betritt diese Welt.\n", magier );
    tell_room( environment(),
        capitalize(getuid(this_object())) + " wird sichtbar.\n", alle );

    // inform Meldung:
    "/secure/merlin"->notify_player_enter(getuid(this_object()));
    write("Du bist jetzt sichtbar.\n");
  }
  else
    write("Du bist jetzt unbemerkt sichtbar.\n");

  return 1;
}

int mschau(string str)
{
  int level, x, andl, orl, i, fault;
  string *mm;

  if (this_interactive()!=ME)
    return 0;
  if ( str=="?" )
  {
    if ( level=Query(P_WANTS_TO_LEARN) )
      write("Du hast den Magier-Modus eingeschaltet (Stufe "+level+").\n");
    else
      write("Du hast den Magier-Modus ausgeschaltet.\n");
  }
  else if ( str=="ja" || str=="an" || str=="ein" )
  {
    if ( level=Query(P_WANTS_TO_LEARN) )
      write("Du hast den Magier-Modus schon eingeschaltet (Stufe "+
          level+")!\n");
    else
    {
      write("Du hast jetzt den Magier-Modus eingeschaltet.\n");
      SetProp(P_WANTS_TO_LEARN, 1);
      SetProp(P_MAGIC, 1);
    }
  }
  else if ( str=="nein" || str=="aus" )
  {
    if ( Query(P_WANTS_TO_LEARN) )
      write( "Ok, Magier-Mode aus.\n" );
    else
      write( "Magier-Mode war schon aus.\n");
    SetProp(P_WANTS_TO_LEARN, 0);
    SetProp(P_MAGIC, 0);
  }
  else if (str==to_string(level=to_int(str)))
  {
    if (query_wiz_level(getuid(this_object()))<WIZARD_LVL) {
      write( "Du hast jetzt den Magier-Modus eingeschaltet.\n" );
      SetProp(P_WANTS_TO_LEARN, 1);
      SetProp(P_MAGIC, 1);
    }
    else {
      write("Ok, Magier-Modus auf Stufe "+str+".\n");
      SetProp(P_WANTS_TO_LEARN, level);
      SetProp(P_MAGIC, level);
    }
  }
  else
  {
    mm=explode(str, " ");
    level=QueryProp(P_WANTS_TO_LEARN);
    orl=andl=fault=0;
    if (!sizeof(mm))
      fault=1;
    for (i=sizeof(mm)-1; i>=0; i--)
    {
      if ((x=member(RH_NAMES, mm[i][1..]))==-1)
        fault=1;
      else
        switch(mm[i][0..0]) {
          case "-": andl+=RH_NUM[x]; break;
          case "+": orl+=RH_NUM[x]; break;
          default: fault=1;
        }
    }
    if (fault)
      write("Syntax: mschau ?|ein|aus|<stufe>|"
            "{+|-(fn|sz|li|tmp|cl|ter|io|hp|sp|lv|mv|nfn)}\n");
    else if (query_wiz_level(getuid(this_object()))<WIZARD_LVL)
    {
      write("Du hast jetzt den Magier-Modus eingeschaltet.\n");
      SetProp(P_WANTS_TO_LEARN, 1);
      SetProp(P_MAGIC, 1);
    }
    else
    {
      level = level & ~andl | orl;
      write("Ok, Magier-Modus auf Stufe "+level+".\n");
      SetProp(P_WANTS_TO_LEARN, level);
      SetProp(P_MAGIC, level);
    }
  }
  return 1;
}

nosave int go_wiz_home(string str)
{
  int f;

  if (!LEARNING())
    return 0;
  str=query_verb();
  if (str[0]!='+') return 0;
  str=str[1..];
  str=explode(str," ")[0];
  if (catch(f=file_size("/players/"+str+"/workroom.lpc")) || f<=0)
  {
    printf("%shat keinen Workroom.\n",capitalize(str+" "));
    return 1;
  }
  if (catch(call_other("/players/"+str+"/workroom","???")))
  {
    write("Der Workroom hat Fehler.\n");
    return 1;
  }
  this_object()->move("/players/"+str+"/workroom",M_TPORT|M_NOCHECK);
  return 1;
}

nosave void FinalSetup()
{
  string err,filename;
  object ob;

  ::FinalSetup();
  SetProp(P_CURRENTDIR,"/players/"+getuid());
  initialize();
  _age = age;
  _hbstop = absolute_hb_count();
  set_heart_beat(0);
}

nosave int protect(string str)
{
  if (!LEARNING())
    return 0;
  if (this_object() != this_interactive())
    return 0;
  if (!str || str=="")
  {
    write("\"protect <propstring>\" toggelt das Protected-Flag.\n");
    return 1;
  }
  if (!Query(str) && !Query(str,F_MODE) && !Query(str,F_SET_METHOD) &&
      !Query(str,F_QUERY_METHOD))
  {
    write("Alle Werte dieser Property sind auf 0. Nichts gemacht.\n");
    return 1;
  }
  Set(str, PROTECTED, F_MODE);
  write(str+" ist jetzt "+(Query(str,F_MODE) & PROTECTED?"":"nicht ")+
	"protected.\n");
  return 1;
}

nosave int ifinger(string str)
{
  if (!(str=_unparsed_args()) || str=="")
  {
    write("Syntax: ifinger [<user>]@<host>\n");
    return 1;
  }
  notify_fail("Fehler beim Abschicken des Finger-Requests aufgetreten.\n");
  if (!"/p/daemon/ifingerd"->ifinger(str))
    return 0;
  write("Anfrage abgeschickt.\n");
  return 1;
}

nosave int udpq(string str)
{
  string ret, mud, type;
  
  if (!LEARNING())
    return 0;
  if (!(str=this_interactive()->_unparsed_args()) || str=="" ||
      sscanf(str,"%s %s",mud,type)<2)
  {
    write("Syntax: udpq mud type\n");
    return 1;
  }
  if (member(({"commands","email","hosts","inetd","list","mud_port","time",
	       "version"}),type)==-1)
    write("TYPEs: commands, email, hosts, inetd, list, "
        "mud_port, time, version\n");
  if (ret=INETD->send_udp(mud,
      ([SENDER:getuid(this_object()), REQUEST:QUERY, DATA:type]),1))
    write(ret);
  else
    write("Anfrage abgeschickt.\n");
  return 1;
}

nosave int ping(string str)
{
  object pl;

  if (!stringp(str)||!strlen(str))
  {
    _notify_fail("Usage: ping <spielername>\n");
    return 0;
  }
  str=lower_case(str);
  if (!(pl=find_player(str)))
  {
    _notify_fail("Spieler "+capitalize(str)+" nicht gefunden.\n");
    return 0;
  }
  tell_object(pl,sprintf("%s pingt Dich an.\a\n",
    (QueryProp(P_INVIS)&&IS_LEARNER(pl))?"("+CAP(getuid(this_object()))+")":
    Name(WER)));
  write("Ok.\n");
  return 1;
}

nosave void upd_my_age()
{
  if (_age)
    age = _age + absolute_hb_count() - _hbstop;

  _age = age;
  _hbstop = absolute_hb_count();
}

nosave int _query_age()
{
  upd_my_age();
  return age;
}

void save_me(int i)
{
  upd_my_age();
  base::save_me(i);
}

varargs void Reconnect(int silent, string my_ip, int invis_login)
{
  base::Reconnect(silent, my_ip, invis_login);
  filesys::reconnect();
}


#define HERZSCHLAG ([ "an":1, "ein":1, "aus":0 ])

nosave int herzschlag(string str)
{
  if (!str || !member(HERZSCHLAG, str))
    return notify_fail("Syntax: herzschlag ein|aus\n"), 0;

  set_heart_beat(_hbforce = HERZSCHLAG[str]);
  write("Ok, Herzschlag "+str+"geschaltet.\n");

  return 1;
}


nosave int check_ip(string ip)
{
  int i1,i2,i3,i4;
  if(sscanf(ip, "%d.%d.%d.%d",i1,i2,i3,i4)!=4)
    return 0;
  if( i1<0 || i1 >255 || i2<0 || i2>255 || i3<0 || i3>255 || i4<0 || i4>255)
    return 0;
  // localhost darf nicht gesperrt werden
  if( ip=="127.0.0.1") return 0;   
  // nicht routbare IPs laut rfc 1918 
  if(i1==10 || (i1==192 && i2==168) || (i1==172 && (i2>=16 && i2<=31)) ) 
    return 0; 
  return 1;
}

nosave int sitebanish(string str)
{
  string result, grund, ip; 
  _notify_fail("Syntax: sitebanish ip grund\n");
  if(!str || !IS_ARCH(ME) || ME!=this_interactive())
  {
    result=call_other("/secure/loginmaster", "QueryBanishString");
    if(result) write(result+"\n");
    return 1;
  }
  str=this_player()->_unparsed_args();
  if(!str) return 0;
  if(sscanf(str, "%s %s",ip,grund)!=2)
    return 0;
  if(!check_ip(ip))
    return write(ip+" ist keine gueltige IP!\n"),1;
  if(call_other("/secure/loginmaster", "SiteBanish", ip,grund))
  {
    result=call_other("/secure/loginmaster", "QueryBanishString");
    if(result) write(result+"\n");
  }
  else 
    write("IP "+ip+" konnte nicht gesperrt werden!\n");
  return 1;  
}

nosave int siteunbanish(string str)
{
  string result; 
  if (!IS_ARCH(ME) || ME!=this_interactive())
    return 0;
  _notify_fail("Syntax: siteunbanish ip\n");
  if(!str) return 0;
  str=this_player()->_unparsed_args();
  if(!check_ip(str))
    return write(str+" ist keine gueltige IP!\n"),1;
  if(call_other("/secure/loginmaster", "IsBanished", str))
  {
    if(call_other("/secure/loginmaster", "SiteUnBanish", str))
      write("IP "+str+" kann nun wieder einloggen!\n");
    else 
      write("IP "+str+" konnte nicht gesperrt werden!\n");
  }
  else 
    write("IP "+str+" ist ja gar nicht gesperrt!\n");
  return 1;  
}

nosave int maylogin(string str)
{
  string add, rem;

  _notify_fail("Syntax: maylogin [-|+]player\n");
  if(!str)
    return 0;
  add="";
  rem="";
  if (!(sscanf(str, "-%s", rem)==1 || sscanf(str, "+%s", add)==1))
    return 0;
  if (add!="") {
    if (call_other("/secure/loginmaster", "AddMayLogin", add))
      write("maylogin: added "+add+".\n");
  }
  else if (rem!="") {
    if (call_other("/secure/loginmaster", "RemoveMayLogin", rem))
      write("maylogin: removed "+rem+".\n");
  }
  else {
    write("maylogin: something went wrong.\n");
  }
  return 1;  
}

nosave int lockgame(string str)
{
  string result, grund; 
  int level, empty,i;
  object *u;
  _notify_fail("Syntax: lockgame level [--empty=grund]\n");
  if(!str || !IS_ARCH(ME) || ME!=this_interactive())
  {
    result=call_other("/secure/loginmaster", "QueryLockString");
    if(result) write(result+"\n");
    return 1;
  }
  if(sscanf(str, "%d --empty=%s",level,grund)==2)
    empty=1;
  else if(sscanf(str, "%d",level)!=1)
    return 0;
  if(level >66) level=66;
  if(level <0) level=0;
  if( call_other("/secure/loginmaster", "LockGame", level) )
  {
    result=call_other("/secure/loginmaster", "QueryLockString");
    if(empty && level)
    {
      u=users();
      for(i=sizeof(u)-1;i>=0;i--)
      {
        if( query_wiz_level(u[i])<level)
        {
          tell_object(u[i],"Automatisches Ausloggen wegen:"+grund+"\n");
          u[i]->disconnect();
        }
      }
    }
    if(result) write(result+"\n");
  }
  else
    write("Konnte Spiel nicht locken!\n");  
  return 1;  
}

