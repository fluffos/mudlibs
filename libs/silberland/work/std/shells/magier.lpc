#pragma strong_types

inherit "/std/player/base";
inherit "/std/shells/filesys/filesys";
inherit "/std/player/objects";

#define NEED_PROTOTYPES

#include <thing/properties.h>
#include <properties.h>
#include <wizlevels.h>
#include <language.h>
