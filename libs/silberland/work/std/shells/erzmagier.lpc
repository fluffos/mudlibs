inherit "/std/shells/magier";

#include <wizlevels.h>
#include <properties.h>
#include <moving.h>
#include <class.h>
#include <moredef.h>
#include <defines.h>
#include <ansi.h>

create()
{
  if (!is_clone(this_object()))
      return;

  ::create();

  call_out("arch_check",0);
}

void arch_check()
{
  if( !IS_ARCH(this_object()) )
  {
    remove();
  if(this_object()) 
    destruct(this_object()); 
  }
}

