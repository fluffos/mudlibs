
// SilberLand MUDlib
//
// std/shells/gnom  Gnom Shell 
//
// $Date$
/* $Revision$
 * $Log$
 */

inherit "std/player/base";

#include <properties.h>
#include <attributes.h>
#include <environment.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>

create()
{
  base::create();
  SetDefaultHome("/gilden/abenteurer");
  SetPrayRoom("/d/ebene/Midas/room/kapelle");
  if (!QueryProp(P_SIZE)) // Das hier passiert nur beim ersten Einloggen
  {
     SetProp(P_SIZE,100+random(21));
     Set(P_SIZE,SAVE|PROTECTED,F_MODE_AS);
  }
  SetProp(P_AVERAGE_SIZE, 110);
  SetProp(P_ATTRIBUTES_OFFSETS,
      ([ A_STR:1, A_DEX:3, A_CON:0, A_INT:3 ]) );
  SetProp(P_MAX_FOOD, 100);
  SetProp(P_MAX_DRINK, 100);
  SetProp(P_MAX_ALCOHOL, 100);
  SetProp(P_FOOD_DELAY, 10);
  SetProp(P_DRINK_DELAY, 10);
  SetProp(P_ALCOHOL_DELAY, 4);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  SetProp(P_RACE_TT_MV,
      ([ TT_OTHER:      4,
         TT_CAVE:       3,
         TT_HOUSE:      5,
         TT_HILL:       8,
         TT_FOREST:     9,
         TT_TOWN:       8,
         TT_MOUNTAIN:   9,
         TT_DESERT:     10,
         TT_JUNGLE:     14,
         TT_SWAMP:      11,
         TT_PLAIN:      7,
         TT_ARCTIC:     13,
         TT_UNDERWATER: 14,
         TT_ROAD:       5 ]) );
  SetProp(P_MATERIAL_KNOWLEDGE,
      ([MATGROUP_METAL:20, MATGROUP_STONE:50]) );
  AddId("Gnomspieler");
}

string _query_race()
{
  return "Gnom";
}

string *_query_racestring()
{
  if (QueryProp(P_GENDER) == FEMALE)
    return ({"Gnomfrau","Gnomfrau","Gnomfrau","Gnomfrau"});
  return ({"Gnom","Gnoms","Gnom","Gnom"});
}

string _query_racedescr()
{
  return "Gnome sind kleine Bewohner der Unterwelt, die sich auf den Abbau "
         "von Mineralien und Erzen spezialisiert haben. Aus diesen Sachen "
         "basteln sie die abenteuerlichsten Maschienen und Geraete. Gnome "
         "etwas kleiner als Zwerge, etwa 110 Zentimeter gross, und weit "
         "nicht so kraeftig und ausdauernd. Das machen sie aber mit ihrem "
         "Erfindungsgeist und ihrer Rafinesse bei weitem wett. Mit ihrer "
         "knolligen Nase haben sie einen echten Riecher fuer den richtigen "
         "Ort zum Bergbau.";
}

int QueryAllowSelect() { return 0; }

string *_query_default_guild_male_titles()
{
      return ({
         "der hoffnungsvolle Junggnom", "der junge Gnom", "der kleine Gnom",
         "der Steineklopfer", "der haemmernde Gnom", "der Steinbearbeiter",
         "der Metallbearbeiter", "der Schraubensucher", "der Zahnraddreher",
         "der kleine Bastler", "der Bastler", "der Mechankierlehrling", 
         "der Mechanikergeselle", "der Mechaniker", "der Chefmechaniker", 
         "der Meistermechaniker", "der Erfinder", "der grosse Erfinder",
         "der angehende Gnomseher", "der Gnomseher" });
}

string *_query_default_guild_female_titles()
{
      return ({
         "das hoffnungsvolle Gnommaedchen", "das junge Gnommaedchen", 
         "die kleine Gnomfrau", "die Steineklopferin", 
         "die haemmernde Gnomfrau", "die Steinbearbeiterin",
         "die Metallbearbeiteriin", "die Schraubensucherin", 
         "die Zahnraddreherin", "die kleine Bastlerin", "die Bastlerin", 
         "der Mechankierlehrling", "die Mechanikergesellin", 
         "die Mechanikerin", "die Chefmechanikerin", 
         "die Meistermechanikerin", "die Erfinderin", "die grosse Erfinderin",
         "die angehende Gnomseherin", "die Gnomseherin" });
}

