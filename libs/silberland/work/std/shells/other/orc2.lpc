inherit "/players/feyaria/mudlib/base";

#include <properties.h>
#include <attributes.h>
#include <environment.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>

create()
{
  base::create();
  SetDefaultHome("/gilden/abenteurer");
  SetPrayRoom("/d/ebene/Midas/room/kapelle");
  if (!QueryProp(P_SIZE)) // Das hier passiert nur beim ersten Einloggen
  {
     SetProp(P_SIZE,155+random(20));
     Set(P_SIZE,SAVE|PROTECTED,F_MODE_AS);
     SetProp(P_HANDS, ({" mit Klauen und Zaehnen", 30, DT_RIP}) );
     SetProp(P_ALIGN, -666 );
  }
  SetProp(P_AVERAGE_SIZE, 165);
  SetProp(P_ATTRIBUTES_OFFSETS,
      ([ A_STR:2, A_DEX:3, A_CON:3, A_INT:-1 ]) );
  SetProp(P_MAX_FOOD, 100);
  SetProp(P_MAX_DRINK, 100);
  SetProp(P_MAX_ALCOHOL, 100);
  SetProp(P_FOOD_DELAY, 10);
  SetProp(P_DRINK_DELAY, 10);
  SetProp(P_ALCOHOL_DELAY, 4);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:5,T_RANGE_MAX:27]));
  SetProp(P_RACE_TT_MV,
      ([ TT_OTHER:      4,
         TT_CAVE:       5,
         TT_HOUSE:      7,
         TT_HILL:       7,
         TT_FOREST:     8,
         TT_TOWN:       9,
         TT_MOUNTAIN:   8,
         TT_DESERT:     10,
         TT_JUNGLE:     13,
         TT_SWAMP:      14,
         TT_PLAIN:      6,
         TT_ARCTIC:     12,
         TT_UNDERWATER: 12,
         TT_ROAD:       5 ]) );
  SetProp(P_MATERIAL_KNOWLEDGE,
      ([MATGROUP_METAL:10, MATGROUP_DEAD:10]) );
  AddId("Orkspieler");
  SetProp(P_BODY, 10);
}

string _query_race()
{
  return "Ork";
}

string *_query_racestring()
{
  if (QueryProp(P_GENDER) == FEMALE)
    return ({"Orkin","Orkin","Orkin","Orkin"});
  return ({"Ork","Orks","Ork","Ork"});
}

string _query_racedescr()
{
  return "Die Orks sind nicht besonders intelligent. "
         "Dafuer sind sie hervorragend als Kaempfer geeignet. "
         "Die gruene, schuppige Haut und ihr dichter schwarzer Pelz"
         "verleihen ihnen einen natuerlichen Schutz vor koerperlichen "
         "Angriffen. Aus ihrem Gebiss stehen Eckzaehne von gewaltiger "
         "Laenge hervor, die jedem Wildschwein zur Ehre reichen wuerden. " 
         "Orks sind von Natur aus boese. Sie schrecken vor keinem Feind "
         "zurueck. Meist greifen sie ihre Opfer in grossen Horden an, "
         "von denen nur noch verkohlte und zerfetzte Ueberreste auf dem " 
         "Schlachtfeld verbleiben.";
}

int QueryAllowSelect() { return 0; }

void Attack(object enemy)
{
  if( !random(3) )
  {
    write("Du beisst "+enemy->name(WEN,1)+".\n");
    tell_object(enemy, Name(WER)+ "beisst Dich.\n");
    say( Name(WER)+" beisst "+enemy->name(WEN,2)+".\n", 
         ({enemy, this_object()}));
    enemy->Defend(20+QueryAttribute(A_STR)*2+QueryProp(P_LEVEL), DT_PIERCE, 
      ([SP_SHOW_DAMAGE:1,SP_NAME: "Orkbiss", SP_PHYSICAL_ATTACK:1,
        SP_REDUCE_ARMOUR: ([P_BODY:60]) ]), this_object() );
  }
  if( enemy )
    ::Attack(enemy);
}

string *_query_default_guild_male_titles()
{
      return ({
         "der hoffnungsvolle Orkjunge", "der junge Ork", "der kleine Ork",
         "der schwache Ork",  "der unerfahrene Ork",  "der Ork",
         "der erfahrene Ork", "der orkische Raeuber", "der orkische Pluenderer",
         "der orkische Brandschatzer", "der starke Ork", "der Orkkaempfer",
         "der Orkkrieger",    "der Orkmetzler",       "der brutale Ork",
         "der Orkheld",       "der beruechtigte Ork", "der Orkschamane",
         "der angehende Orkseher", "der Orkseher" });
}

string *_query_default_guild_female_titles()
{
      return ({
       "das hoffnungsvolle Orkmaedchen", "die junge Orkin", "die kleine Orkin",
       "die schwache Orkin",  "die unerfahrene Orkin",  "die Orkin",
       "die erfahrene Orkin", "die orkische Raeuberin",
       "die orkische Pluendererin", "die orkische Brandschatzerin",
       "die starke Orkin",    "die Orkkaempferin", "die Orkkriegerin",
       "die Orkmetzlerin",    "die brutale Orkin", "die Orkheldin",
       "die beruechtigte Orkin", "die Orkschamanin",
       "die angehende Orkseherin", "die Orkseherin" });
}

