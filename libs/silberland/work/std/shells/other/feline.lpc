// SilberLand MUDlib
//
// std/shells/feline  Felinen Shell 
//
// $Date$
/* $Revision$
 * $Log$
 */

inherit "/std/player/base";

#include <properties.h>
#include <attributes.h>
#include <environment.h>
#include <moving.h>
#include <combat.h>

void create()
{ 
  base::create();
  SetDefaultHome("/gilden/abenteurer");
  SetPrayRoom("/d/ebene/Midas/room/kapelle");
  if (!QueryProp(P_SIZE)) // Das hier passiert nur beim ersten Einloggen
  {
     SetProp(P_SIZE,190+random(21));
     Set(P_SIZE,SAVE|PROTECTED,F_MODE_AS);
     SetProp(P_HANDS,({" mit scharfen Krallen",30,DT_RIP}));
     SetProp(P_MSGIN,"schleicht herein");
     SetProp(P_MSGOUT,"schleicht");
     SetProp(P_MMSGIN,"erscheint mit einem grellen Blitz");
     SetProp(P_MMSGOUT,"verschwindet mit einem grellen Blitz");
  }
  SetProp(P_AVERAGE_SIZE, 200);
  SetProp(P_ATTRIBUTES_OFFSETS,
      ([ A_STR:2, A_DEX:4, A_CON:1, A_INT:0 ]) );
  SetProp(P_MAX_FOOD, 100);
  SetProp(P_MAX_DRINK, 100);
  SetProp(P_MAX_ALCOHOL, 100);
  SetProp(P_FOOD_DELAY, 10);
  SetProp(P_DRINK_DELAY, 10);
  SetProp(P_ALCOHOL_DELAY, 4);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:15,T_RANGE_MAX:40]));
  SetProp(P_RACE_TT_MV,
      ([ TT_OTHER:      4,
         TT_CAVE:       8,
         TT_HOUSE:      7,
         TT_HILL:       9,
         TT_FOREST:     5,
         TT_TOWN:       9,
         TT_MOUNTAIN:   8,
         TT_DESERT:     11,
         TT_JUNGLE:     3,
         TT_SWAMP:      11,
         TT_PLAIN:      6,
         TT_ARCTIC:     19,
         TT_UNDERWATER: 15,
         TT_ROAD:       5 ]) );
  SetProp(P_MATERIAL_KNOWLEDGE,
      ([MATGROUP_WOOD:20]) );
  AddId("Felinenspieler");
}

string _query_race()
{
    return "Feline";
}

string *_query_racestring()
{
  if (QueryProp(P_GENDER) == FEMALE)
    return ({"Felinin","Felinin","Felinin","Felinin"});
  return ({"Feline","Felinen","Felinen","Felinen"});
}

string _query_racedescr()
{
    return "Felinen sind aufrecht gehende Katzenwesen. "
        "Ihr besonderes Merkmal ist ihre Geschmeidigkeit und die "
        "Geschwindigkeit, mit der sie alles machen. Sie sind sehr "
        "ausgeglichene Wesen, die nur gelegentlich mal einen "
        "Kratzbaum benoetigen, um ihre Krallen zu wetzen.";
}

int QueryAllowSelect() { return 0; }

