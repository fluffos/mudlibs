
// SilberLand MUDlib
//
// std/shells/goblin  Goblin Shell 
//
// $Date$
/* $Revision$
 * $Log$
 */

inherit "std/player/base";

#include <properties.h>
#include <attributes.h>
#include <environment.h>
#include <moving.h>
#include <combat.h>

create()
{
  base::create();
  SetDefaultHome("/gilden/abenteurer");
  SetPrayRoom("/d/ebene/Midas/room/kapelle");
  if (!QueryProp(P_SIZE)) // Das hier passiert nur beim ersten Einloggen
  {
     SetProp(P_SIZE,125+random(25));
     Set(P_SIZE,SAVE|PROTECTED,F_MODE_AS);
     SetProp(P_HANDS, 
       ({" mit schmutzigen Haenden", 30, ({DT_BLUDGEON, DT_POISON}) }) );
     SetProp(P_ALIGN, -111);
  }
  SetProp(P_AVERAGE_SIZE, 137 );
  SetProp(P_ATTRIBUTES_OFFSETS,
      ([ A_STR:1, A_DEX:2, A_CON:1, A_INT:-4 ]) );
  SetProp(P_MAX_FOOD, 90);
  SetProp(P_MAX_DRINK, 90);
  SetProp(P_MAX_ALCOHOL, 90);
  SetProp(P_FOOD_DELAY, 10);
  SetProp(P_DRINK_DELAY, 10);
  SetProp(P_ALCOHOL_DELAY, 4);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:5,T_RANGE_MAX:30]));
  SetProp(P_RACE_TT_MV,
      ([ TT_OTHER:      4,
         TT_CAVE:       5,
         TT_HOUSE:      7,
         TT_HILL:       8,
         TT_FOREST:     5,
         TT_TOWN:       10,
         TT_MOUNTAIN:   7,
         TT_DESERT:     8,
         TT_JUNGLE:     11,
         TT_SWAMP:      12,
         TT_PLAIN:      6,
         TT_ARCTIC:     13,
         TT_UNDERWATER: 19,
         TT_ROAD:       5 ]) );
  SetProp(P_MATERIAL_KNOWLEDGE,
      ([ MATGROUP_SOLID:-25, MATGROUP_POISONOUS:50]) );
  AddId("Goblinspieler");
  SetProp(P_HP_DELAY, 3);
  SetProp(P_SP_DELAY, 8);
  SetProp(P_RESISTANCE_STRENGTHS,([DT_POISON:-0.5 ]) );
}

string _query_race()
{
  return "Goblin";
}

string *_query_racestring()
{
  if (QueryProp(P_GENDER)==2)
    return ({"Goblinfrau","Goblinfrau","Goblinfrau","Goblinfrau"});
  return ({"Goblin","Goblins","Goblin","Goblin"});
}

string _query_racedescr()
{
  return 
    "Goblins sind kleine, schwache Kreaturen mit einem rotfarbenen, "
    "struppigen Pelz. Sie essen alles, sogar giftige und verdorbene Dinge.";
}

int QueryAllowSelect() { return 0; }

int _query_poison()
{
  return 0;
}

