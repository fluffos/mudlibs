inherit "std/player/base";

#include <properties.h>
#include <attributes.h>
#include <environment.h>
#include <moving.h>
#include <new_skills.h>

void create()
{
  base::create();

  SetDefaultHome("/d/gebirge/dusty/zwerge/room/kapelle");
  SetPrayRoom("/d/gebirge/dusty/zwerge/room/kapelle");

  AddId("Zwergenspieler");
  SetProp(P_AVERAGE_SIZE, 120);
  SetProp(P_AVERAGE_WEIGHT, 75000);
  SetProp(P_ATTRIBUTES_OFFSETS, ([ A_STR:3, A_DEX:2, A_CON:5, A_INT:-3 ]) );
  SetProp(P_MAX_FOOD, 80);
  SetProp(P_MAX_DRINK, 90);
  SetProp(P_MAX_ALCOHOL, 130);
  SetProp(P_FOOD_DELAY, 12);
  SetProp(P_DRINK_DELAY, 11);
  SetProp(P_ALCOHOL_DELAY, 3);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:10,T_RANGE_MAX:30]));

  SetProp(P_BODY, 10);
  SetProp(P_HANDS, ({" mit blossen Haenden",35,DT_BLUDGEON}) );
  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_FIRE  : -0.15,
         DT_POISON: -0.2,
         DT_MAGIC :  0.15,
         DT_WATER :  0.25, ]) );

  SetProp(P_RACE_TT_MV,
      ([ TT_OTHER:      4,
         TT_CAVE:       3,
         TT_HOUSE:      4,
         TT_HILL:       7,
         TT_FOREST:     9,
         TT_TOWN:       9,
         TT_MOUNTAIN:   3,
         TT_DESERT:     9,
         TT_JUNGLE:     14,
         TT_SWAMP:      20,
         TT_PLAIN:      6,
         TT_ARCTIC:     12,
         TT_UNDERWATER: 25,
         TT_WATER:      18,
         TT_ROAD:       5,
         TT_AIR:        5,]) );
  SetProp(P_MATERIAL_KNOWLEDGE,
      ([ MATGROUP_STONE:30,
         MATGROUP_METAL:30, 
         MATGROUP_PRECIOUS_METAL: 40, 
         MAT_GOLD:100 ]) );
}

string _query_race()
{
  return "Zwerg";
}

string *_query_racestring()
{
  if (QueryProp(P_GENDER) == FEMALE)
    return ({"Zwergin","Zwergin","Zwergin","Zwergin"});
  return ({"Zwerg","Zwerges","Zwerg","Zwerg"});
}

string _query_racedescr()
{
  return break_string(
    "Ein Zwerg ist nur im Gebirge so richtig zu Hause. Dort, in seinen "
    "kuehlen, dunklen Stollen und Hoehlen fuehlt er sich wohl, das ist "
    "seine Welt. "
    "Zwerge sind etwas groesser als Hobbits, etwa 1,20 m. Diese geringe "
    "Groesse gleichen sie mit ungewoehnlicher Ausdauer, unbeirrbarer "
    "Kampfkraft und Mut sowie einer gehoerigen Portion roher Kraft "
    "spielend wieder aus. Hat er sich erstmal etwas in den Kopf gesetzt, "
    "hat es keinen Sinn zu versuchen, es ihm wieder auszureden. Vielmehr "
    "laeuft man in diesen Momenten Gefahr, den Jaehzorn und das Misstrauen "
    "eines Zwerges kennenzulernen. Besonderes Geschick wird Zwergen auch "
    "beim Anfertigen und im Umgang mit Waffen nachgesagt - sie sind nicht "
    "nur gute Handwerker sondern auch geschickte wenn auch nicht sonderlich "
    "intelligente Kaempfer. Hat ein Zwerg einmal Freundschaft geschlossen, "
    "so kann man sich felsenfest auf ihn verlassen. Doch auch Feiern ist "
    "er nicht abgeneigt - seine Ausdauer betrifft nicht nur Kampfkraft "
    "sondern auch Trinkfestigkeit.", 78);
}

int QueryAllowSelect() { return 1; }

int _query_hp_delay() {
  int re;
  re = Query(P_HP_DELAY);
  if (environment() && environment()->QueryProp(P_INDOORS))
    re--;
  else
    re++;
  return re;
}

int _query_sp_delay() {
  int re;
  re = Query(P_SP_DELAY);
  if (environment() && environment()->QueryProp(P_INDOORS))
    re--;
  else
    re++;
  return re;
}

string *_query_default_guild_male_titles()
{
  return ({
      "der hoffnungsvolle Jungzwerg", "der Minenarbeiter",
      "der Erzschuerfer",    "der Tunnelgraeber",   "der Stollenbauer",
      "der Goldsucher",      "der Wandergeselle",   "der Schatzsucher",
      "der Gesteinskundige", "der Schmiedegeselle", "der Huettenkundige",
      "der Grobschmied",     "der Waffenschmied",   "der Goldschmied",
      "der Steinmetz",       "der Diamantschleifer","der Juwelier",
      "der Meisterschmied",  "der angehende Zwergenseher",
      "der Zwergenseher" });
}

string *_query_default_guild_female_titles()
{
  return ({
      "die hoffnungsvolle Jungzwergin", "die Minenarbeiterin",
      "die Erzschuerferin", "die Tunnelgraeberin", "die Stollenbauerin",
      "die Goldsucherin",   "die Wandergesellin",  "die Schatzsucherin",
      "die Gesteinskundige","die Schmiedegesellin","die Huettenkundige",
      "die Grobschmiedin",  "die Waffenschmiedin", "die Goldschmiedin",
      "die Steinmetzin",    "die Diamantschleiferin", "die Juwelierin",
      "die Meisterschmiedin", "die angehende Zwergenseherin",
      "die Zwergenseherin" });
}

mixed RaceDefault(string arg)
{
  if (!arg)
    return 0;
  switch(arg) {
    case P_HANDS : return ({" mit blossen Haenden",35,DT_BLUDGEON});
    case P_BODY :  return 10;
  }
  return ::RaceDefault(arg);
}

string *_query_eye_colors()
{
  return ({"stahlblau", "schwarz", "grau", "blaugrau", 
           "kupfergruen", "blau", "dunkelblau", "steingrau"});
}     

string *_query_hair_colors()  
{    
  return ({"rostrot", "aschgrau", "kohleschwarz", "staubgrau", 
           "feuerrot", "schiefergrau", "schwarzgrau", "flammenrot"}); 
}

