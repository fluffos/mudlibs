{
      return ({
       "der Untote", "der Untote", "der Untote", "der Untote",
       "der Untote", "der Untote", "der Untote", "der Untote", 
       "der Untote", "der Untote", "der Untote", "der Untote", 
       "der Untote", "der Untote", "der Untote", "der Untote",
       "der Untote", "der Untote", "der Untote", "der Untote"});
}

string *_query_default_guild_female_titles()
{
      return ({
       "die Untote", "die Untote", "die Untote", "die Untote",
       "die Untote", "die Untote", "die Untote", "die Untote", 
       "die Untote", "die Untote", "die Untote", "die Untote", 
       "die Untote", "die Untote", "die Untote", "die Untote",
       "die Untote", "die Untote", "die Untote", "die Untote"});
