mixed RaceDefault(string arg)
{
  if (!arg)
    return 0;
  switch(arg) {
    case P_HANDS : return ({" mit skelettierten Haenden",70,({DT_RIP, DT_UNHOLY})});
    case P_BODY :  return -10;
  }
  return ::RaceDefault(arg);
}


varargs int second_life(string arg) 
{
  int lost_exp, poolcost;
  mixed killer;
  object ob;
  
  lost_exp = QueryProp(P_XP) / (QueryProp(P_LEVEL) + 17);
  if (objectp(killer=Query(P_LAST_KILLER)) && killer!=environment())
    catch(killer->NotifyPlayerDeath(this_object(),killer,lost_exp));
  if (environment())
    catch(environment()->NotifyPlayerDeath(this_object(),killer,lost_exp));
  catch(map_objects(
        (environment() ? all_inventory(environment()) : ({}))
          + deep_inventory(this_object()) - ({killer}),
        "NotifyPlayerDeath", this_object(),killer,lost_exp));
  UpdateAttributes(); // Beim Tod werden Dinge entfernt, Attribute pruefen
  call_other(NNPCMASTER, "RemoveFeind", ME);
  call_other("/room/death/death_room", "add_player", ME);
  SetProp(P_PURSUERS, 0);
  SetProp(P_GHOST, 1);  
  move("/room/death/undead_room", M_NOCHECK|M_SILENT);

  if(QueryProp(P_TESTPLAYER))
    poolcost = 0;
  else
    poolcost=call_other(NEKROMASTER, "QueryDeathPenalty",QueryProp(P_GUILD_CIRCLE));
  if(!call_other(NEKROMASTER, "UseBloodPool", poolcost)) {
    if(QueryProp(P_GUILD_CIRCLE) < 2 ) {
      tell_object(this_object(), BS(
         sprintf("%s! Du opferst VIEL mehr Erfahrungspunkte um Deiner "
           "entgueltigen VERNICHTUNG zu entgehen!",
           QueryProp(P_GENDER)==FEMALE?"NAERRIN":"NARR")));
      lost_exp = lost_exp * 6 / 5;
    }
    else if (ob=deep_present(NEKRO_SOULSTONE, this_object())) {
      tell_object(this_object(), BS(
            "Die Macht des nekromantischen Seelensteins erhaelt Deine unheilige "
            "Existenz. Mit einem lauten Zischen und rotem Aufgluehen zerfaellt er "
            "zu Staub."));
      ob->remove();
    }
    else {
      tell_object(this_object(),BS(
         "Du opferst eine Stufe der Verdammnis um der Vernichtung "
         "zu entgehen."));  
      SetProp(P_GUILD_CIRCLE, QueryProp(P_GUILD_CIRCLE)-1);
    }
  } else {
    tell_object(this_object(), BS(
          "Unzaehlige Seelen der Seelenmuehle werden vernichtet damit DU "
          "weiterexistieren kannst!"));
  }
  AddExp(-lost_exp);
  SetProp(P_LOST_XP, QueryProp(P_LOST_XP) + ({lost_exp}) );

  SetProp(P_HP, QueryProp(P_MAX_HP)/2);
  SetProp(P_SP, 1);
  return 1;
}

void _set_new_attributes() {
  mapping old_attr;
  if(!mappingp(old_attr=QueryProperties()[P_OLD_SHELL_ATTR_OFFSET])) {
    SetProp(P_ATTRIBUTES_OFFSETS, ([ A_STR:0, A_DEX:1, A_CON:2, A_INT:4 ]) );
  }
  else {
    SetProp(P_ATTRIBUTES_OFFSETS, ([ A_STR:old_attr[A_STR], 
                                     A_DEX:old_attr[A_DEX]+1,
                                     A_CON:old_attr[A_CON],
                                     A_INT:old_attr[A_INT]+1
                                   ]));
  }
  UpdateAttributes();
}


string *_query_eye_colors()
{
  return ({"rotgluehend"});
}     

string *_query_hair_colors()  
{    
  return ({"fahl", "schwarz", "kohleschwarz", "knochengrau", });
}

void new_eye_and_hair_color()
{
  if( previous_object() && file_name(previous_object())=="/gilden/nekromanten" )
  {
    SetProp(P_EYE_COLOR, 
        QueryProp("eye_colors")[random(sizeof(QueryProp("eye_colors")))]);
    SetProp(P_HAIR_COLOR, 
        QueryProp("hair_colors")[random(sizeof(QueryProp("hair_colors")))]);
  }
}

void reset()
{
  // Blueprint braucht keinen Reset
  if (file_name()[0..4]=="/std/") {
    set_next_reset(-1);
    return;
  }
  if(interactive(ME) && !QueryProp(P_TESTPLAYER) && 
      !call_other(NEKROMASTER, "UseBloodPool", QueryProp(P_GUILD_CIRCLE)*2))
  {
    tell_object(this_object(), BS(
        "BEI ALLEN NIEDERHOELLEN! Es sind nicht mehr genug "
        "Seelen in der Seelenmuehle um Deine Existenz komplett "
        "aufrecht zu erhalten! Du spuerst Deine Kraft schwinden!"));
    this_object()->AddHp(-QueryProp(P_GUILD_CIRCLE)*10);
    this_object()->AddSp(-QueryProp(P_GUILD_CIRCLE)*10);
  }
  ::reset();
}
