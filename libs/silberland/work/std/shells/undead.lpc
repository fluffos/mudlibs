inherit "std/player/base";

#include <properties.h>
#include <attributes.h>
#include <environment.h>
#include <moving.h>
#include <combat.h>
#include <class.h>
#include "/gilden/nekromanten/nekro.h"

nosave int old_align;

void create()
{
  mapping old_attr;
  base::create();

  SetDefaultHome("/gilden/nekromanten");
  SetPrayRoom("/gilden/nekromanten");

  AddId(({"Untoterspieler"}));
  AddClass(CL_UNDEAD);
  AddClass(CL_NIGHTVISION);
  SetProp(P_AVERAGE_SIZE, 200);
  SetProp(P_AVERAGE_WEIGHT, 100000);
  call_out("_set_new_attributes", 0); // Hier werden die neuen Attribute 
                                     // gesetzt

  SetProp(P_MAX_FOOD, 100);
  SetProp(P_MAX_DRINK, 100);
  SetProp(P_MAX_ALCOHOL, 100);
  SetProp(P_FOOD_DELAY, 10);
  SetProp(P_DRINK_DELAY, 10);
  SetProp(P_ALCOHOL_DELAY, 5);
  SetProp(P_HP_DELAY, 3);
  SetProp(P_SP_DELAY, 2);
  SetProp(P_MAX_POISON, 6);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  SetProp(P_ALIGN, -1666);
  SetProp(P_NOCORPSE, 1);
  
  SetProp(P_BODY, -10);
  SetProp(P_HANDS, ({" mit skelettierten Haenden",70,({DT_RIP, DT_UNHOLY}) }) );
  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_UNHOLY    : -0.3,
         DT_TERROR    : -0.25,
         DT_POISON    : -0.2,
         DT_COLD      : -0.15,
         DT_MAGIC     : -0.1,
         DT_PIERCE    : -0.1,
         DT_BLUDGEON  :  0.1,
         DT_FIRE      :  0.15,
         DT_LIGHT     :  0.25, 
         DT_HOLY      :  0.3]) ) ;

  SetProp(P_RACE_TT_MV,
      ([ TT_OTHER:      4,
         TT_CAVE:       6,
         TT_HOUSE:      5,
         TT_HILL:       7,
         TT_FOREST:     7,
         TT_TOWN:       6,
         TT_MOUNTAIN:   9,
         TT_DESERT:     11,
         TT_JUNGLE:     10,
         TT_SWAMP:      15,
         TT_PLAIN:      5,
         TT_ARCTIC:     12,
         TT_UNDERWATER: 15,
         TT_WATER:      15,
         TT_ROAD:       5,
         TT_AIR:        4,]) );
  SetProp(P_MATERIAL_KNOWLEDGE,
      ([ MATGROUP_DEAD: 50 ]) );
}

int _query_hp_delay() 
{
  int re, align;
  re = Query(P_HP_DELAY);
  if( (align=QueryProp(P_ALIGN)) > 0 )
  {
    AddHp(-1-random(align/100) );
    re+=10;
  }
  return re;
}

int _query_sp_delay() 
{
  int re, align;
  re = Query(P_SP_DELAY);
  if( (align=QueryProp(P_ALIGN)) > 0 )
  {
    AddSp(-1-random(align/100) );
    re+=10;
  }
  return re;
}

nosave int _set_align(int a) 
{
  if( a > old_align ) a -= 2*(a-old_align)/3; 
  else a += (a-old_align)/2; 
  old_align = a;
  return Set(P_ALIGN, a);
}

void FinalSetup()
{
  ::FinalSetup();
  old_align=QueryProp(P_ALIGN);
}

string _query_race()
{
  return "Untoter";
}

string *_query_racestring()
{
  if (QueryProp(P_GENDER) == FEMALE)
    return ({"Untote","Untoten","Untoten","Untote"});
  return ({"Untoter","Untoten","Untoten","Untoten"});
}

string _query_racedescr()
{
  return break_string(
      "Untote sind erfahrene Nekromanten, die selber Untot geworden sind.",
      78);
}

int QueryAllowSelect() { return 0; }


