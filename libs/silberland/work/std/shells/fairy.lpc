inherit "std/player/base";

#include <properties.h>
#include <attributes.h>
#include <environment.h>
#include <moving.h>
#include <combat.h>
#include <class.h>

nosave int old_align;

void create()
{
  base::create();

//  SetDefaultHome("/d/ebene/trogor/room/kapelle");
//  SetPrayRoom("/d/ebene/trogor/room/kapelle");

  SetDefaultHome("/d/ebene/ronja/feenquest/room/kapelle");
  SetPrayRoom("/d/ebene/ronja/feenquest/room/kapelle");

  AddId("Feenspieler");
  AddClass(CL_FLYING);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_AVERAGE_SIZE, 65);
  SetProp(P_AVERAGE_WEIGHT, 20000);
  SetProp(P_ATTRIBUTES_OFFSETS, ([ A_STR:-4, A_DEX:6, A_CON:-1, A_INT:6 ]) );
  SetProp(P_MAX_FOOD, 75);
  SetProp(P_MAX_DRINK, 80);
  SetProp(P_MAX_ALCOHOL, 70);
  SetProp(P_FOOD_DELAY, 8);
  SetProp(P_DRINK_DELAY, 7);
  SetProp(P_ALCOHOL_DELAY, 3);
  SetProp(P_HP_DELAY, 6);
  SetProp(P_SP_DELAY, 1);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:15,T_RANGE_MAX:30]));
  SetProp(P_ALIGN, 1000);
  SetProp(P_MSGIN,"flattert herein");
  SetProp(P_MSGOUT,"flattert");
  SetProp(P_MMSGOUT,"ist ploetzlich verschwunden");
  SetProp(P_MMSGIN,"erscheint ploetzlich");

  SetProp(P_BODY, -10);
  SetProp(P_HANDS, ({" mit Feenmagie", 30, ({DT_MAGIC, DT_BLUDGEON}) }));
  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_AIR   : -0.2,
         DT_MAGIC : -0.2,
         DT_HOLY  : -0.2,
         DT_UNHOLY:  0.2,
         DT_TERROR:  0.25,
         DT_MIND  :  0.1]) );

  SetProp(P_RACE_TT_MV,
      ([ TT_OTHER:      3,
         TT_CAVE:       8,
         TT_HOUSE:      4,
         TT_HILL:       4,
         TT_FOREST:     3,
         TT_TOWN:       4,
         TT_MOUNTAIN:   6,
         TT_DESERT:     7,
         TT_JUNGLE:     5,
         TT_SWAMP:      8,
         TT_PLAIN:      3,
         TT_ARCTIC:     9,
         TT_UNDERWATER: 25,
         TT_WATER:      12,
         TT_ROAD:       3,
         TT_AIR:        2,]) );
  SetProp(P_MATERIAL_KNOWLEDGE,
      ([ MATGROUP_METAL:-10,
         MATGROUP_BIO:30,
         MATGROUP_MAGIC: 20]) );
}

void FinalSetup()
{
  ::FinalSetup();
  old_align = QueryProp(P_ALIGN);
}

string _query_race()
{
  return "Fee";
}

string *_query_racestring()
{
  return ({"Fee","Fee","Fee","Fee"});
}

string _query_racedescr()
{
  return break_string(
      "Feen sind kleine, muntere Geschoepfe, die sich "
      "hauptsaechlich im Wald aufhalten. Sie besitzen "
      "kleine Libellenfluegelchen, die aber leider im Laufe der "
      "Zeit verkuemmert sind, so dass sie nur mehr kurze Strecken "
      "fliegen koennen. Allerdings macht sie ihre "
      "zarte Struktur zu sehr wendigen und flinken "
      "Geschoepfen. Auch ihr Intellekt ist nicht "
      "zu vernachlaessigen, da sie sich nicht nur "
      "um die Pflege der Baeume kuemmern, sondern "
      "auch einige in die weite Welt geschickt haben, "
      "um diese zu erkunden. Alle Feenwesen sind weiblich. Die "
      "Fortpflanzung erfolgt auf magischem Wege.", 78);
}

int QueryAllowSelect() { return 1; }

nosave int _set_align(int a)
{
  if( a < old_align ) a = (old_align+a)/2;
  else a += (a-old_align)/3;
  old_align = a;
  return Set(P_ALIGN, a);
}

string *_query_default_guild_female_titles()
{
      return ({
         "die hoffnungsvolle Jungfee", "die kleine Fee", "die junge Fee",
         "die unerfahrene Fee", "die Fee", "die Bluetenfee",
         "die erfahrene Fee",   "die Baumnymphe",   "die Wassernymphe",
         "die Quellnymphe",     "die Nymphe",       "die Dryade",
         "die gute Fee",        "die Feenheldin",   "die zauberkundige Fee",
         "die Feenzauberin",    "die Feenmagierin", "die Feenkoenigin",
         "die angehende Feenseherin", "die Feenseherin" });
}

mixed RaceDefault(string arg)
{
  if (!arg)
    return 0;
  switch(arg) {
    case P_HANDS : return ({" mit Feenmagie", 30, ({DT_MAGIC, DT_BLUDGEON}) });
    case P_BODY :  return -10;
  }
  return ::RaceDefault(arg);
}

string *_query_eye_colors()
{
  return ({"veilchenblau", "himmelblau", "teichgruen", "grasgruen",
           "golden", "violett", "silbern", "orangen"});
}

string *_query_hair_colors()
{
  return ({"violett", "orangen", "hellblau", "hellgruen",
           "silbern", "golden", "meerblau", "efeugruen"});
}

void heart_beat()
{
  ::heart_beat();

  if (!random(500) &&
      interactive(this_object()) &&
      (query_idle(this_object()) > 180) &&
      environment() &&
      !QueryProp(P_FROG) &&
      !id("NOWINGS"))
  {
    tell_room(environment(),
        Name(WER,1) + " flattert mit ihren Fluegeln.\n",
        ({ this_object() }) );
  }
}

