mixed RaceDefault(string arg)
{
  if (!arg)
    return 0;
  switch(arg) {
    case P_HANDS : return ({" mit fettigen Ogerhaenden",40,DT_BLUDGEON});
    case P_BODY :  return 10;
  }
  return ::RaceDefault(arg);
}

string *_query_eye_colors()
{
  return ({"rot", "hellrot", "dunkelrot", "waessrigweiss", 
           "hellgelb", "gelb", "dunkelgelb", "weiss"});
}

string *_query_hair_colors()  
{
  return ({"weiss", "hellblond", "mittelblond", "blond", 
           "dunkelblond", "hellbraun", "braun", "dunkelbraun"});
}

