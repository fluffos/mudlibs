int undie()
{
  mixed x,di;
  int *lxp;

  if (!this_interactive()) return 0;
  if (!IS_LORD(this_interactive())) return 0;

  x = QueryProp(P_DEADS);
  if (x > 0) Set(P_DEADS, x-1);

  log_file("irregular/UNDIE",
      sprintf("[%s]: %O -> %O [%d -> %d]\n",ctime(),
      this_interactive(), this_object(), x, QueryProp(P_DEADS)));

  /*
  x=QueryProp(P_XP);
  if ((di=QueryProp(P_LEVEL))<20 || !IS_SEER(this_object()))
    x = (x*3)/2 - x;
  else
    x = x / (di-18) * (di-17) - x;

  if (x > QueryProp(P_LOST_XP))
    x = QueryProp(P_LOST_XP);
  else if (x < 0)
    x = 0;

  AddExp(x);
  SetProp(P_LOST_XP, QueryProp(P_LOST_XP)-x);
  */

  if (sizeof(lxp = QueryProp(P_LOST_XP)))
  {
    x = lxp[sizeof(lxp) - 1];
    SetProp(P_LOST_XP, lxp[0..<2]); // Letztes Element es Arrays loeschen.
    AddExp(x);
  }

  Set(P_GHOST,0);
  return 1;
}

int *_query_lost_xp()
{
  mixed lxp;
  int *l;
  int i, d;

  lxp = Query(P_LOST_XP);
  if (intp(lxp))
  {
    if (lxp == 0)
      return SetProp(P_LOST_XP, ({}) );

    l = ({});
    for (i = 1, d = QueryProp(P_DEADS); i <= d; i++)
      l += ({lxp / d + (i == d ? lxp % d : 0)});

    return SetProp(P_LOST_XP, l);
  }
  return lxp;
}
 
int _query_total_lost_xp()
{
  int *lxp;
  int i;
  int xp;

  lxp = QueryProp(P_LOST_XP);
  xp = 0;
  
  for(i = sizeof(lxp) - 1; i >= 0; i--)
    xp += lxp[i];

  return xp;
}

// Zum Wiederbeleben von Toten mit pronzentueller XP-Rueckerstattung
int resurrect(int percent)
{
  int *lxp;
  int xp, resxp;

  if( IS_ARCH(this_interactive()) || (previous_object() && 
        member(RESURRECT_ALLOWED, 
          explode(file_name(previous_object()), "#")[0]) != -1) )
  {

    lxp = QueryProp(P_LOST_XP);
    xp = lxp[sizeof(lxp) - 1];

    resxp = xp * percent / 100; 
    SetProp(P_LOST_XP, lxp[0..<2] + ({xp - resxp}) ); 
    AddExp(resxp);

    log_file( "interactive/RESURRECT",
        sprintf( "%s: %s resurrects %s (%d%% = %d XP)\n",
          ctime(),
          capitalize(getuid(this_player())),
          capitalize(getuid(ME)),
          percent, 
          resxp));

    return resxp;
  }
  return 0;
}
