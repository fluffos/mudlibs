// Defines some things which are different than in living.c
// One example is the heart_beat().

inherit "std/living/life";

#pragma strong_types

#define NEED_PROTOTYPES

#include <player/resurrect.h>
#include <thing/properties.h>
#include <player/base.h>

#include <properties.h>
#include <config.h>
#include <health.h>
#include <wizlevels.h>
#include <language.h>
#include <living/combat.h>

#include <defines.h>
#include <moving.h>

#ifndef P_BILLION_XP
#define P_BILLION_XP "billion_xp"
#endif

nosave int _set_playerkills(int val);
nosave int delay_mv;

void create()
{
  ::create();
  Set(P_KILLS, SAVE, F_MODE_AS);
  Set(P_KILLS, SECURED, F_MODE_AS);
  Set(P_GHOST, SAVE, F_MODE_AS);
  Set(P_BILLION_XP, SAVE, F_MODE_AS);
  delay_mv=DELAY_MV;
}



// Gwenshara 2025 - experimental
public int AddExp(int e) {
  int currentXp, bxp, totalXp;

  if(QueryProp(P_TESTPLAYER)) {
    currentXp = QueryProp(P_XP);
    totalXp = currentXp + e; // Total XP after adding

    // Check if total XP exceeds 1 billion
    if(totalXp >= 1000000000) {
      // Calculate the number of billions XP
      bxp = totalXp / 1000000000; 
      
      // Update the billion XP counter
      SetProp(P_BILLION_XP, QueryProp(P_BILLION_XP) + bxp);

      // Update the current XP by keeping the remainder after division by 1 billion
      SetProp(P_XP, totalXp % 1000000000);

      // Return the current XP after the update
      return QueryProp(P_XP);
    }
  }

  return ::AddExp(e);  // Fall back to the default AddExp behavior
}


nosave int _set_playerkills(int val)
{
  string tmp;
  int playerkills;

  // Derzeit keine Arena im SL
  /*
  if ( previous_object(1) && environment(previous_object(1)) &&
       (tmp = file_name(environment(previous_object(1)))) &&
       (tmp == "/d/wueste/room/arena/arena" ||
        tmp == "/d/fernwest/li/xian/room/shinto" ||
        tmp[0..31] == "/d/fernwest/li/xian/room/shinto_" ||
        tmp[0..35] == "/players/dancer/games/fighting_area/") )
    return 0;
  */

  tmp = sprintf("[%s] %O -> %s (%O)",
        ctime(), previous_object(1) || this_interactive() || this_player(),
        capitalize(getuid(ME)), val);

  playerkills = Query(P_KILLS);

  if( intp(val) && val>=0 ) 
    if( previous_object(1) && IS_ARCH(getuid(previous_object(1))) &&
        this_interactive() && IS_ARCH(this_interactive()) )
      playerkills = val;
    else
      tmp += " - ILLEGAL!";
  else
    playerkills++;

  log_file( "irregular/SET_KILLS", tmp+"\n" );
  return Set(P_KILLS, playerkills);
}

/* Hier wird _set_align() aus living/life.c ueberladen, damit das Spieler-
 * alignment nicht mehr auf +/- 1000 begrenzt ist. Durch die Beschraenkung
 * des Monster-alignments und durch die Formel zur Neuberechnung des 
 * Alignments, bleibt der Wert fuer Spieler aber trotzdem beschraenkt.
 */
nosave int _set_align(int a) {
  return Set(P_ALIGN, a);
}

nosave int time_to_save;	/* when to next save player */

nosave void heart_beat() {
  int mv;

  ::heart_beat();
  if (age > time_to_save) {
    save_me(1);
    time_to_save = age + 500;
  }
  if (--delay_mv < 0) {
    mv=QueryProp(P_MV);
    if (this_object()->InFight())
      mv+=MVP_GAIN_INFIGHT;
    else
      mv+=QueryProp(P_RESTING) ? MVP_GAIN_REST : MVP_GAIN_NORMAL;
    SetProp(P_MV, mv);
    delay_mv=DELAY_MV;
  }
}

void force_save() {
  time_to_save=0;
}

nomask int do_damage(int dam, object enemy) {
  string tmp,tmp2;
  int hit_point;

  hit_point = QueryProp(P_HP);
  if ( QueryProp(P_GHOST) || dam<=0 ) return 0;
  hit_point -= dam;
  if ( hit_point < 0 )
  {
    if (IS_LEARNING(ME) && query_once_interactive(ME))
    {
      tell_object(ME, "Deine magischen Kraefte verhindern Deinen Tod.\n" );
      return 0;
    }
    if (!interactive( ME ))
    {
      hit_point = 10;   // Tod bei Netztoten verhindern
    }
    else
    {
      if ( enemy && objectp(enemy) && interactive( enemy ) && enemy!=ME &&
           /*
	   file_name(environment(ME))[0..5]!="/d/pk/" &&
	   file_name(environment(ME))[0..14]!="/d/schattenwelt/" &&
	   environment(ME)!=find_object("/d/wueste/room/arena/arena") &&
           environment(ME)!=find_object("/d/fernwest/li/xian/room/shinto") &&
           */
	   !QueryProp(P_TESTPLAYER) && !IS_WIZARD(ME) )
      {
	if (QueryPlAttacked(enemy))
	  hit_point=1;
	else
	  hit_point=0;
        if(!call_other ("/obj/pkmaster", "PK_allowed", environment(ME), enemy, ME))
        {
          if (!hit_point) enemy->SetProp( P_KILLS, -1 );
          log_file("irregular/PLAYERKILLS",
              sprintf("%s %s(%d/%d) toetete %s(%d/%d)%s\n",
                ctime(time()),
                capitalize(getuid(enemy)),query_wiz_level(enemy),
                enemy->QueryProp(P_LEVEL),capitalize(getuid(ME)),
                query_wiz_level(ME),QueryProp(P_LEVEL),
                (hit_point?" NOTWEHR=>KEIN PK":"")),0,1);
        }
        else
          log_file( "combat/PK",
              sprintf( "%s, %s (%d/%d) toetete %s (%d/%d)\n",
                dtime(time()),
                capitalize(getuid(enemy)),
                query_wiz_level(enemy), enemy->QueryProp(P_LEVEL),
                capitalize(getuid(ME)),
                query_wiz_level(ME), QueryProp(P_LEVEL) ) );
      } else {
	tmp=dtime(time());
        if (!objectp(enemy) && objectp(previous_object()))
          enemy = previous_object();
	tmp2=((string)(objectp(enemy)?(explode(file_name(enemy),"#")[0]):""));
	if (strlen(tmp2)>33) tmp2="..."+tmp2[<31..];
	if (!QueryProp(P_TESTPLAYER))
	  create_kill_log_entry(tmp2+" ("+
				((string)(objectp(enemy)?getuid(enemy):"?"))
				+")");
      }
      if (enemy)
	enemy->StopHuntFor(this_object(),1);
      hit_point = -1;
      map_objects( QueryEnemies()[0], "StopHuntFor", ME, 1 );
      StopHuntingMode(1);
      Set(P_LAST_KILLER,enemy);
      Set(P_ALCOHOL,0);
      Set(P_DRINK,0);
      Set(P_FOOD,0);
      Set(P_BLIND,0);
      Set(P_DEAF,0);
      die();
    }
  }
  SetProp(P_HP, hit_point);
  return dam;
}

varargs int second_life(string arg) {
  int lost_exp, l;
  mixed killer;

  if (IS_LEARNING(this_object()) && query_once_interactive(this_object()))
  {
    tell_object(this_object(),
        "Sei froh, dass Du unsterblich bist, "+
        "sonst waere es eben zu Ende gewesen.\n");
    return 1;
  }
  if (!IS_SEER(ME) || (l=QueryProp(P_LEVEL))<20)
    lost_exp = QueryProp(P_XP)/3;
  else
    lost_exp = QueryProp(P_XP)/(l-17);
  AddExp(-lost_exp);
  SetProp(P_LOST_XP, QueryProp(P_LOST_XP) + ({lost_exp}));
  SetProp(P_GHOST, 1);
  if (objectp(killer=Query(P_LAST_KILLER)) && killer!=environment())
    catch(killer->NotifyPlayerDeath(ME,killer,lost_exp));
  if (environment())
    catch(environment()->NotifyPlayerDeath(ME,killer,lost_exp));
  catch(map_objects(
        (environment() ? all_inventory(environment()) : ({}))
          + deep_inventory(ME) - ({killer}),
        "NotifyPlayerDeath", ME,killer,lost_exp));
  clone_object( "room/death/death_mark" )->move( ME, M_NOCHECK );
  UpdateAttributes(); // Beim Tod werden Dinge entfernt, Attribute pruefen
  return 1;
}

int AddHpHook(object ob)
{
  object *hooks;

  if (!ob || !objectp(ob) || environment(ob)!=ME)
    return 0;
  hooks=Query(P_HP_HOOKS);
  if (!pointerp(hooks))
  {
    Set(P_HP_HOOKS,({ob}));
    return 1;
  }
  if (member(hooks,ob)>=0)
    return 0;
  Set(P_HP_HOOKS,hooks+({ob}));
  return 1;
}

int RemoveHpHook(object ob)
{
  object *hooks;

  if (!pointerp(hooks=Query(P_HP_HOOKS)))
    return 0;
  Set(P_HP_HOOKS,hooks-({ob}));
  return 1;
}

nosave int _set_hp(int hp)
{
  object *hooks;
  int ret,i,old;

  if ((old=Query(P_HP))==hp)
    return old;
  ret=life::_set_hp(hp);
  if (ret==old || !pointerp(hooks=Query(P_HP_HOOKS)))
    return ret;
  i=0;
  while (i<sizeof(hooks))
    if (!objectp(hooks[i]))
      hooks=hooks[0..i-1]+hooks[i+1..];
    else
    {
      hooks[i]->NotifyHpChange();
      i++;
    }
  Set(P_HP_HOOKS,hooks);
  return ret;
}

nosave int _set_sp(int sp)
{
  object *hooks;
  int ret,i,old;

  if ((old=Query(P_SP))==sp)
    return old;
  ret=life::_set_sp(sp);
  if (ret==old || !pointerp(hooks=Query(P_HP_HOOKS)))
    return ret;
  i=0;
  while (i<sizeof(hooks))
    if (!objectp(hooks[i]))
      hooks=hooks[0..i-1]+hooks[i+1..];
    else
    {
      hooks[i]->NotifyHpChange();
      i++;
    }
  Set(P_HP_HOOKS,hooks);
  return ret;
}

