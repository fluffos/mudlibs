#pragma strong_types

#define NEED_PROTOTYPES

#include <thing/properties.h>
#include <thing.h>
#include <player.h>
#include <language.h>
#include <properties.h>

#include <config.h>
#include <defines.h>
#include <wizlevels.h>
#include <new_skills.h>

#define HIST_SIZE 40
#define MAX_ALIASES 1000

mapping aliases;
int hist_size, show_processing, histmin;
string default_notify_fail;
nosave string *history, *unparsed_args, *hist2, unmodified;
nosave int hist_now,hist_now2;
nosave object last_command_env;
nosave int cmds_per_time, last_chg;

nosave void reallocate_histbuf();
nomask void __set_bb(int i);
nosave varargs int __auswerten(string str, string intern);
varargs int SoulComm(string str, string _verb);
varargs mixed More(string str, int fflag, string returnto);
nosave int _starts_with(string str, string start);

private nosave void AddHistory(string str)
{
  if (!stringp(str) || str=="" || str[0]=='&' || str[0]=='^' || str=="hist")
    return;
  if (strlen(str)>=4 && hist2[(50+hist_now2-1)%50]!=str)
    hist2[(hist_now2++)%50]=str;
  if (!hist_size || !pointerp(history) || (sizeof(history) < hist_size))
    return;
  if (strlen(str)>=histmin && history[(hist_size+hist_now-1)%hist_size]!=str)
    history[(hist_now++)%hist_size]=str;
}


nosave void create()
{
  for (hist2 = allocate(50), hist_now = 0; hist_now < 50; hist_now++)
    hist2[hist_now] = "";

  Set(P_LOCALCMDS, ({ }) );
  Set(P_LOCALCMDS, PROTECTED, F_MODE_AS);

  show_processing = 1;
  last_chg = histmin = hist_now = hist_now2 = 0;
  hist_size = HIST_SIZE;
  unparsed_args = ({ 0,0,0 });

  reallocate_histbuf();
}


nosave int replacedisplay(string str)
{
  if (!str || str=="" || !sscanf(str,"%d",show_processing))
    printf("Unzulaessige Eingabe!\n%s 0|1|2\n",query_verb());
    printf("Ersetzungsanzeige auf Level %d.\nLevel 0: Nichts anzeigen\n"+
     "Level 1: Nur History-Ersetzungen anzeigen\n"+
     "Level 2: History- und Alias-Ersetzungen anzeigen\n",show_processing);
  if (show_processing>2&&!IS_WIZARD(ME)) show_processing=2;
  return 1;
}

nosave int histmin(string str)
{
  int len;

  if (!str||!sscanf(str,"%d",len)||len<0)
  {
    write("Benutzung: histmin ZAHL\nLegt die Mindestlaenge fest, die eine \
Befehlszeile haben muss, um in den\nHistory-Puffer zu gelangen. Derzeit \
eingestellt auf "+(string)histmin+" Zeichen.\n");
    return 1;
  }
  histmin=len;
  write("Mindestlaenge auf "+(string)len+" eingestellt.\n");
  return 1;
}

nosave void reallocate_histbuf()
{
  int i;

  // bei Gelegenheit ueberarbeiten, dass die alte History nicht draufgeht...
  history = allocate(hist_size);
  hist_now = 0;
  for (i = 0; i < hist_size; i++)
    if (!stringp(history[i]))
      history[i] = "\n\n";
}

nosave int histlen(string str)
{
  int d;

  if (!str)
  {
    printf("Deine History-Buffer-Laenge liegt bei %d Befehlen.\n",hist_size);
    return 1;
  }
  if (!sscanf(str,"%d",d) || d < 0 || d > 40)
  {
    write("histlen <zahl>\nZahl zwischen 0 und 40\n");
    return 1;
  }
  hist_size = d;
  printf("Deine History-Buffer-Laenge liegt jetzt bei %d Befehlen.\n",
      hist_size);
  reallocate_histbuf();
  return 1;
}

nosave void initialize()
{
  if (!pointerp(history) || (sizeof(history) != hist_size))
    reallocate_histbuf();
  add_action("__auswerten","",1);
  if (!mappingp(aliases))
    aliases=([]);
}

nosave mixed _set_default_notify_fail(string s)
{
  if (stringp(s)&&s!="")
  {
    if (s[<1]!='\n') s+="\n";
    return default_notify_fail=s;
  } else if (!s||s=="") default_notify_fail=0;
}

nosave mixed _query_default_notify_fail()
{
  return default_notify_fail;
}

nosave int set_errormessage(string s)
{
  if (!(s=_unparsed_args()))
  {
    (void)_set_default_notify_fail(0);
    write("Standard-Fehlermeldung auf \"Wie bitte?\" gesetzt.\n");
  } else
  {
    write(break_string(sprintf("Standard-Fehlermeldung auf %s gesetzt.\n",
             s),78));
    (void)_set_default_notify_fail(s);
  }
  return 1;
}

void reconnect()
{
  if (!mappingp(aliases)) aliases=([]);
  set_modify_command(0);
  set_modify_command(this_object());
}

nosave int show_hist()
{
  int i;
  string comm;

  tell_object(ME, "Die History-Liste enthaelt folgende Kommandos:\n");
  for (i=0; i<hist_size; i++)
    if ((comm=history[(hist_now+i)% hist_size])!= "\n\n")
      tell_object(ME, " &"+(hist_now+i-hist_size)+"/-"+ (hist_size-i-1)
      +"\t= "+comm+"\n");
  return 1;
}

nosave string present_alias(mixed *ali)
{
  int j,k;
  string s,s2;

  for (s="",j=sizeof(ali)-1;j>=0;j--)
    if (intp(ali[j]))
      if ((k=ali[j])<0)
  s="$"+(k==-1?"":(string)-k)+"*"+s;
      else
  s="$"+(string)k+s;
    else
      s=implode(efun::explode(ali[j],"$"),"\\$")+s;
  return s;
}

#define ALIFORMAT ({" %s\t= %s", "alias %s %s"})
// Ich weiss, den Variablennamen im define zu haben ist unfein, aber das
// macht es im Code dann angenehm uebersichtlich.  -HrT

nosave varargs int query_aliases(int as_cmd)
{
  int i;
  string *a,*ali;

  if(i=sizeof(ali=sort_array(m_indices(aliases),#'<))) //')))
  {
    for(a=({}),i--; i>=0; i--)
      a+=({sprintf(ALIFORMAT[as_cmd],ali[i],present_alias(aliases[ali[i]]))});
    More("Du hast folgende Aliase definiert:\n"+implode(a,"\n"));
  }
  else
    write("Du hast keine Aliase definiert.\n");
  return 1;
}

nosave int _starts_with(string str, string start)
{
  return (strlen(start)>strlen(str) ? 0
    : str[0..strlen(start)-1]==start);
}

nosave int _contains(string ali, string what)
{
  return strstr( lower_case(present_alias(aliases[ali])), what ) != -1;
}

nosave int _contains_re(string ali, string what)
{
  return sizeof( regexp( ({ lower_case(present_alias(aliases[ali])) }),
                         what ) );
}

nosave int alias(string str)
{
  string command;
  string *tmp, *hits;
  int num, l, pos, cont;
  int as_cmd;

  str = _unparsed_args() || "";

  // -a Parameter auswerten
  if (as_cmd = (str == "-a" || str[0..2] == "-a "))
    str = str[3..];

  if (!strlen(str) || str == "*" || str == "?")
    return query_aliases(as_cmd);

  // Alias-Abfrage
  // -------------------------------------------------------------------------
  // 1. "alias /reg_exp/" - Regular Expression search.
  if (strlen(str) > 2 && str[0] == '/' && str[<1] == '/')
  {
    str = lower_case( str[1..<2] );
    hits = filter_array( m_indices(aliases), #'_contains_re, str );
    if (!sizeof(hits))
    {
      printf("Du hast kein Alias, auf das der regulaere Ausdruck "
          "\"%s\" passt.\n", str);
      return 1;
    }
    hits = sort_array( hits, #'> );
    for (l = sizeof(hits); l--; )
      hits[l] = sprintf( ALIFORMAT[as_cmd], hits[l],
          present_alias( aliases[hits[l]] ) );
    More("Auf folgende Aliase passt der regulaere Ausdruck \""+
         str + "\":\n" + implode(hits,"\n") );
    return 1;
  }
  else if ( (pos = member(str,' ')) < 0 )       // 1 Arg only -> query
  {
    // 2. "alias xyz" - Exact match.
    if (tmp = aliases[str])
      printf( ALIFORMAT[as_cmd]+"\n", str, present_alias(tmp) );
    else
      // 3. "alias xyz*" - Starts with search.
      if (str[<1] == '*')
      {
        str = str[0..<2];
        hits = filter_array( m_indices(aliases), #'_starts_with, str );
        if (!sizeof(hits))
        {
          printf("Du hast kein Alias, das mit \"%s\" anfaengt.\n", str);
          return 1;
        }
        hits = sort_array( hits, #'> );
        for (l = sizeof(hits); l--; )
          hits[l] = sprintf( ALIFORMAT[as_cmd], hits[l],
              present_alias( aliases[hits[l]] ) );
        More("Folgende Aliase beginnen mit \"" +
             str + "\":\n" + implode(hits,"\n") );
      }
      // 4. "alias ?xyz" - Contains search.
      else if (str[0]=='?')
      {
        str = lower_case( str[1..] );
        hits = filter_array( m_indices(aliases), #'_contains, str );
        if (!sizeof(hits))
        {
          printf("Du hast kein Alias, das \"%s\" enthaelt.\n", str);
          return 1;
        }
        hits = sort_array( hits, #'> );
        for (l = sizeof(hits); l--; )
          hits[l] = sprintf( ALIFORMAT[as_cmd], hits[l],
              present_alias( aliases[hits[l]] ) );
        More("Folgende Aliase enthalten \"" +
             str + "\":\n" + implode(hits,"\n") );
      }
      else
        printf("Du hast kein Alias \"%s\" definiert.\n", str);
    return 1;
  }

  // Alias-Definition
  // -------------------------------------------------------------------------
  if (!pos)
  {
    write("Fehler: Alias beginnt mit einem Leerzeichen!\n");
    return 1;
  }
  if ((command = str[0..pos-1]) == "unalias")
  {
    write
      ("Den Befehl 'unalias' kannst Du nicht mit einem Alias belegen! ;-)\n");
    return 1;
  }
  str = str[pos+1..];
  tmp = ({ });
  while (l = strlen(str))
  {
    pos = 0;
    cont = 1;
    while (cont)
    {
      if (pos < l)
      {
        if(str[pos] == '\\')
        {
          str = str[0..pos-1] + str[pos+1..];
        }
        else
        {
          if (str[pos] == '&' || str[pos] == '$')
          {
            cont = 0;
            if (pos > 0)
              tmp += ({ str[0..pos-1] });
            if (pos == l - 1)
            {
              printf("Fehler: %c am Zeilenende!\n",str[pos]);
              return 1;
            }
            if ((num = str[++pos])=='*')
              num = 1, pos--;
            else
              num -= '0';
            if (num < 0 || num > 9)
            {
              printf("Fehler: Nach %c muss eine Ziffer oder * folgen!\n",
               str[pos-1]);
              return 1;
            }
            if ( (str = str[pos+1..]) != "" && str[0] == '*')
              str = str[1..], num =- num;
            tmp += ({ num });
          }
        }
        pos++;
      }
      else
      {
        cont = 0;
        if (str != "")
          tmp += ({ str });
        str = "";
      }
    } // while (cont)
  }

  if (!aliases[command] && (sizeof(aliases) >= MAX_ALIASES))
  {
    write("Du hast schon genuegend Aliase definiert!\n");
  } else {
    if (aliases[command])
      printf("Altes Alias war: %s\t= %s\n", command,present_alias(aliases[command]));
    aliases[command] = tmp;
    printf("Neues Alias: %s\t= %s\n",command,present_alias(tmp));
  }
  return 1;
}

nosave int unalias(string str)
{
  string *hits, um;
  int i;

  str = _unparsed_args() || "";
  if (!strlen(str))
  {
    write("Du musst schon angeben, welches Alias Du entfernen willst.\n");
    return 1;
  }

  // 1. "unali xyz" - Exact match
  if ( member(aliases, str) )
  {
    efun::m_delete( aliases, str );
    printf("Du entfernst das Alias %O.\n", str);
    return 1;
  }

  // 2. "unali xyz*" - Starts with match
  if ( str[<1] == '*' )
  {
    str = str[0..<2];
    hits = filter_array( m_indices(aliases), #'_starts_with, str );
    if (!sizeof(hits))
    {
      printf("Du hast kein Alias, das mit \"%s\" anfaengt.\n", str);
      return 1;
    }
  }
  // 3. "unali /xyz/ - Regexp matching
  else if ( str[0] == '/' && str[<1] == '/' )
  {
    str = str[1..<2];
    hits = regexp( m_indices(aliases), ("^" + str + "$") );
    if (!sizeof(hits))
    {
      printf("Du hast kein Alias, auf das der regulaere Ausdruck "
          "\"%s\" passt.\n", str);
      return 1;
    }
  }
  // 4. "unali x y z" - Aufzaehlung
  else if (member( str, ' ' ) != -1)
  {
    hits = efun::explode( str, " " ) - ({ "" });
    for (i = 0; i < sizeof(hits); i++)
    {
      if ( member(aliases, hits[i]) )
        printf("Du entfernst das Alias %O.\n", hits[i]);
      else
        printf("Du hast kein Alias %O definiert.\n", hits[i]);
    }
    aliases -= mkmapping( hits );
    return 1;
  }
  // 5. weder noch -> Alias not found!
  else
  {
    write("So ein Alias hast Du nicht definiert.\n");
    return 1;
  }

  aliases -= mkmapping( hits );
  write( break_string( "Du entfernst folgende Aliase: "+
    implode( sort_array( hits, #'> ), ", " ) + ".\n", 78 ) );

  return 1;
}

public int HasAlias(string alias)
{
  return member( aliases, alias );
}

varargs string _unparsed_args(int level)
{
  return unparsed_args[level];
}

#define ARTIKEL ({"das","der","die","des","dem","den","ein","eine","einer",\
                  "eines"})

#define TRENNER ({"in","aus","ueber","auf","unter","mit","durch","fuer",\
                  "von","vom","im","aufs","ein","weg","zurueck"})

nosave string _single_spaces(string str)
{
  int i,j,l,fl;
  string s2;

  l=strlen(s2=str);
  for (fl=1,i=j=0;i<l;i++)
  {
    if (fl)
    {
      if (str[i]!=' ')
      {
        s2[j]=str[i];
        j++;
        fl=0;
      }
    } else
    {
      if ((s2[j]=str[i])==' ') fl=1;
      j++;
    }
  }
  j--;
  while (j>=0&&s2[j]==' ') j--;
  return s2[0..j];
}

nosave mixed _return_args(string str)
{
  string *t,*t2,verb,s2;
  int i,l,j,l2;

  t=explode(str," ");
  verb=t[0];
  if ((str=unparsed_args[0]=implode(t[1..]," "))=="")
  {
    unparsed_args[0]=unparsed_args[1]=unparsed_args[2]=0;
    return str=verb;
  }
  str=unparsed_args[1]=lower_case(_single_spaces(str));
  t=regexplode(str,"\\<im\\>|\\<ins\\>");
  for (i=1;i<sizeof(t);i+=2) t[i]="in";
  t=regexplode(implode(t,""),"[\\,\\!\\:][\\,\\!\\:]*");
  l=sizeof(t);
  for(i=1;i<l;i+=2) t[i]="";
  t=explode(implode(t,"")," ")-({""});
  for (i=sizeof(t)-2;i>=0;i--)
  {
    if (member(ARTIKEL,t[i])>=0)
      t=t[0..i-1]+t[i+1..];
  }
  unparsed_args[2]=implode(t," ");
  t=regexplode((str=implode(t," ")),"[0-9][0-9]*\\.");
  if ((l=sizeof(t))>2)
  {
    i=1;
    while (i<l-1)
    {
      t[i]=" "+t[i][0..<2]+" ";
      if ((l2=sizeof(t2=explode(t[i+1]," ")))<2)
  t[i+1]+=t[i];
      else
      {
  for (j=1;j<l2;j++)
  {
    if (member(TRENNER,t2[j])>=0)
    {
      t2[j-1]+=t[i];
      l2=0;
    }
  }
  if (!l2)
    t[i+1]=implode(t2," ");
  else
    t[i+1]+=t[i];
      }
      t[i]="";
      i+=2;
    }
    str=_single_spaces(verb+" "+implode(t," "));
    if (str[<1]==' ') str=str[0..<2];
  } else str=verb+(str==""?"":" "+str);
  if (show_processing>2)
    printf("-> {%s}\n",str);
  return str;
}

int TakeFollowers();

nosave void decay_average()
{
  if (absolute_hb_count()-last_chg>14)
  {
    last_chg=absolute_hb_count()-last_chg;
    if (last_chg>3000)
      last_chg=absolute_hb_count(),cmds_per_time=0;
    else
    {
      while (last_chg>14)
  cmds_per_time=cmds_per_time*9/10, last_chg-=15;
      last_chg=absolute_hb_count()-last_chg;
    }
  }
}

private nosave void HandlePreparedSpells() {
  mixed ps;

  if (pointerp(ps=QueryProp(P_PREPARED_SPELL))
      && sizeof(ps)>=1 && intp(ps[0]) && stringp(ps[1]))
  {
#ifdef DELAY_SPELLS
    ps[0]++;
    SetProp(P_PREPARED_SPELL,ps);
    write("Die Ausfuehrung Deines vorbereiteten Spruches wird verzoegert.\n");
#else
    write("Du brichst die Spruchvorbereitung fuer ''"+ps[1]+"'' ab.\n");
    SetProp(P_PREPARED_SPELL,0);
#endif
  }
  else if (ps)
    SetProp(P_PREPARED_SPELL,0);
}

nosave mixed bb;
#ifndef BBMASTER
#define BBMASTER "/secure/bbmaster"
#endif

mixed modify_command(string str)
{
  mixed commLine, input, output;
  string verb,s1,*tmp,uverb;
  int l,l2,nummer,i,p;
  mapping para;

  if( previous_object() &&
      (previous_object()!=this_object() || process_call()) ) {
    if(IS_ARCH(this_object()))
      tell_object(this_object(), sprintf("Illegal modify_command(%s) from %O\n",
          str, previous_object()));
    return 0;
  }

  for (i=strlen(str);i-->0;)
  {
    int code;
    // UTF-8:
    // does not work currently, reason unknown
    /*
    if((i>0) && (str[i-1]=='Ã')) {
      code = str[i--];
      // printf("UTF-8 detected, code: %d = 0x%x.\n",code,code);
      if(code==0x84) str[i..i+1]="Ae";
      else if(code==0x96) str[i..i+1]="Oe";
      else if(code==0x9C) str[i..i+1]="Ue";
      else if(code==0xA4) str[i..i+1]="ae";
      else if(code==0xB6) str[i..i+1]="oe";
      else if(code==0xBC) str[i..i+1]="ue";
      else if(code==0x9F) str[i..i+1]="ss";
      else i++;
    }
    else
    */
    if(str[i]=='Ä') str[i..i]="Ae";
    else if(str[i]=='ä') str[i..i]="ae";
    else if(str[i]=='Ö') str[i..i]="Oe";
    else if(str[i]=='ö') str[i..i]="oe";
    else if(str[i]=='Ü') str[i..i]="Ue";
    else if(str[i]=='ü') str[i..i]="ue";
    else if(str[i]=='ß') str[i..i]="ss";
    else if(str[i]=='À' || str[i]=='Á') str[i]='A';
    else if(str[i]=='à' || str[i]=='á') str[i]='a';
    else if(str[i]<' ' || str[i]>127) str[i]='?';
  }

  // Big Brother?
  if (bb)
    BBMASTER->writebb( sprintf("%s %O\n",ctime(time())[4..15],str) );

  decay_average();
  cmds_per_time += 10000;
  Set(P_ACTUAL_NOTIFY_FAIL,0);
  unparsed_args[0] = unparsed_args[1] = unparsed_args[2] = unmodified = "";
  if (!str)
    return "";

  // RM-Escape
  if (str == "\\ESCAPE" && IS_LORD(ME))
  {
    __set_environment(ME,"/room/void");
    environment()->init();
    printf("You escaped.\n");
    return "";
  }

  // RM-Command Escape
  if (str[0..2] == "\\\\\\" && IS_LORD(ME))
  {
    str = _return_args(str);
    tmp = efun::explode(str[3..]," ");
    verb = tmp[0];
    if (verb && verb != "")
    {
      s1 = implode(tmp[1..]," ");
      if (!__auswerten(s1,verb))
      SoulComm(s1,verb);
    }
    unparsed_args[0] = unparsed_args[1] = unparsed_args[2] = 0;
    return 1;
  }

  // Paralyse beruecksichtigen
  if (para = QueryProp(P_PARALYZED))
  {
    // Magier und Geister werden ent-paralysiert (kein HB, bzw. "bete"...)
    if (QueryProp(P_GHOST) || IS_LEARNER(this_object()))
      Set(P_PARALYZED, 0);
    else
    {
      write(para[PARALYZE_MSG]);
      if (stringp(para[PARALYZE_MSG_OTHER]))
        environment()->Message(
            capitalize(sprintf(para[PARALYZE_MSG_OTHER], name())),
            MSGFLAG_NO_TP);
      return 1;
    }
  }

  unmodified = str;
  last_command_env = environment();

  // Etwaige Verfolger gleich direkt reinholen
  if (remove_call_out("TakeFollowers")>=0)
    catch(TakeFollowers());

  // Default-Fehlermeldung setzen
  if (default_notify_fail)
    efun::notify_fail(default_notify_fail);

  // Nichts zu tun?
  if (str=="")
    return "";

  AddHistory(unmodified);
  HandlePreparedSpells();

  // Kein Alias-Expanding erwuenscht:
  if (str[0]=='\\') return _return_args(str[1..]);

  // Abkuerzungen fuer die Himmelsrichtungen:
  switch (str)
  {
    case "n": return "norden";
    case "s": return "sueden";
    case "w": return "westen";
    case "o": return "osten";
    case "nw": return "nordwesten";
    case "sw": return "suedwesten";
    case "so": return "suedosten";
    case "no": return "nordosten";
    case "ob": return "oben";
    case "u": return "unten";

    case "nob": return "nordoben";
    case "noob": return "nordostoben";
    case "oob": return "ostoben";
    case "soob": return "suedostoben";
    case "sob": return "suedoben";
    case "swob": return "suedwestoben";
    case "wob": return "westoben";
    case "nwob": return "nordwestoben";
    case "nu": return "nordunten";
    case "nou": return "nordostunten";
    case "ou": return "ostunten";
    case "sou": return "suedostunten";
    case "su": return "suedunten";
    case "swu": return "suedwestunten";
    case "wu": return "westunten";
    case "nwu": return "nordwestunten";
  }

  // Befehlswiederholung?
  if (str[0] == '&')
  {
    p = strlen(s1 = str[1..]);
    if (p)
      for (l2=0,i=0;i<hist_size-1 && !l2;i++)
      {
        if (history[(hist_size-i+hist_now-1)%hist_size][0..p-1]==s1)
          str=history[(hist_size-i+hist_now-1)%hist_size],l2=1;
        if (l2 && show_processing)
        {
          printf("[%s]\n",str);
          AddHistory(str);
        }
      }
    if (!l2)
    {
      if (str == "&&")
        str = "&-0";
      if (sscanf(str,"&%d%s",nummer,s1) && !strlen(s1))
      {
        if (nummer < 0 || (!nummer && (str[1] == '-')))
          if (nummer < -(hist_size-1))
            nummer = -1;
          else
            nummer = (hist_now+nummer-1+hist_size)%hist_size;
        else
          if ((nummer > hist_now) || (hist_now - nummer > hist_size))
            nummer = -1;
          else
            nummer = nummer % hist_size;
        if ((nummer < 0) || ((commLine = history[nummer]) == "\n\n"))
          notify_fail("Der Befehl ist nicht in der History!\n");
        else
        {
          if (show_processing)
            write(sprintf("[%s]\n",commLine));
          AddHistory(str = commLine);
        }
      }
    }
  }
  unmodified = str;
  if (str[0] == '^')
  {
    string *oldnew,pre,post;

    if (sizeof(oldnew=explode(str,"^")) > 1)
    {
      sscanf(history[(hist_now-1)%hist_size],"%s"+oldnew[0]+"%s", pre, post);
      if (show_processing)
        write(sprintf("[%s%s%s]\n",pre,oldnew[1],post));
      AddHistory((str=pre+oldnew[1]+post));
    }
  }

  if (!str || str=="")
    return "";

  unmodified = str;
  input = explode(str," ");
  uverb = explode(unmodified," ")[0];
  if (!(commLine = aliases[uverb]))
    return _return_args(str);

  output = "";
  l = sizeof(commLine);
  l2 = sizeof(input);

  for (i = 0; i < l; i++)
    if (!intp(commLine[i]))
      output += commLine[i];
    else
      if ((p = commLine[i]) >= 0)
      {
        if (l2 > p)
          output += input[p];
      }
      else
      {
        p = -p;
        if (l2 > p)
          output += implode(input[p..]," ");
      }

  output = _single_spaces(output);
  l = i = strlen(output) - 1;
  while (i > 0 && output[i] == ' ')
    i--;
  if (i != l)
    output = output[0..i];

  unmodified = output;
  if (bb)
    BBMASTER->writebb("->"+output+"\n");

  if (show_processing > 1)
    printf("[%s]\n",output);

  return _return_args(output);
}

nosave int do_list(string str)
{
  string *cmdlist;
  int i;

  if (!QueryProp(P_WANTS_TO_LEARN))
    return 0;
  if (!str) return notify_fail("Syntax: do <cmd1>;<cmd2>;...\n"), 0;
  cmdlist=explode(_unparsed_args(),";")-({ "" });
  for (i = 0; i < sizeof(cmdlist); i++)
  {
    cmdlist[i] = implode(explode(cmdlist[i]," ") - ({ }), " ");
    if (show_processing)
      write(sprintf("[%s]\n",cmdlist[i]));
    command(cmdlist[i]);
  }
  return 1;
}

//falls die aliasliste kaputt ist ...

int unalias_all()
{
  if (IS_ELDER(this_interactive())) {
    aliases=([]);
    return 1;
  }
  return 0;
}

object _query_last_command_env()
{
  return last_command_env;
}

int _query_show_alias_processing()
{
  return show_processing;
}

int _query_histmin()
{
  return histmin;
}

varargs void AddAction(mixed fun, mixed cmd, int flag, int lvl)
{
  int i;
  mixed *cmds;

  if (!(cmds=Query(P_LOCALCMDS))) cmds=({});

  if (!pointerp(cmd)) cmd=({cmd});

  for (i = sizeof(cmd)-1; i>=0; i--)
    cmds += ({({ cmd[i] , fun, flag, lvl})});

  Set(P_LOCALCMDS, cmds);
}

nosave int auswerten(mixed cmd, string str)
{
  if (closurep(cmd))
    return funcall(cmd,str);
  if (stringp(cmd))
    return call_other(this_object(),cmd,str);
  return 0;
}

nosave varargs int __auswerten(string str, string intern)
{
  string verb;
  mixed *cmd, cmds;
  int i,ret,lvl,l,vl;

  if (!intern)
    verb=query_verb();
  else
    verb=intern;
  lvl=query_wiz_level(ME);
  vl=strlen(verb);
  cmds=QueryProp(P_LOCALCMDS);

  for(i=sizeof(cmds)-1;i>=0;i--)
  {
    cmd=cmds[i],l=strlen(cmd[0]);
    if (cmd[0]==verb[0..l-1] && cmd[3]<=lvl && (cmd[2]||vl==l) &&
  (ret=auswerten(cmd[1],str)))
      return ret;
  }
  return 0;
}

nosave string *_query_localcmds()
{
  mixed *l;

  l=Query(P_LOCALCMDS);
  if (!pointerp(l))
    l=({});
  return ({
    ({"ali","alias",1,0}),
    ({"unali","unalias",1,0}),
    ({"histmin","histmin",0,0}),
    ({"histlen","histlen",0,0}),
    ({"hist","show_hist",0,0}),
    ({"history","show_hist",0,0}),
    ({"do","do_list",0,LEARNER_LVL}),
    ({"ersetzungsanzeige","replacedisplay",0,0}),
    ({"fehlermeldung","set_errormessage",0,SEER_LVL}),
  })+l;
}

int _query_command_average()
{
  decay_average();
  return cmds_per_time;
}

nomask void __set_bb(int i)
{
  if( previous_object()!=find_object(BBMASTER) || process_call() )
    return;
  bb=i;
}

