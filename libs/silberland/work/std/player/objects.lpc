#pragma strong_types

#define NEED_PROTOTYPES
#include "/sys/player/filesys.h"

#include <config.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include <thing/moving.h>
#include <properties.h>

#include <wizlevels.h>


/*
 * destruct/update glossary:
 *
 * "soft" means that the object is given the chance to self-destruct, thus
 * allowing it to do necessary cleanup like subtracting from the carried
 * weight of the environment(). We call remove() in the object to be
 * destructed.
 *
 * "hard" means that we use the efun "destruct" to destruct the object
 * without giving it a chance to even notice it. Any reference object
 * variables will be '0' after that.
 *
 */

nosave int update_object(string str)
{
  object ob;
  string upd_file;
  if (!(str=_unparsed_args())) {
    notify_fail("Usage: "+query_verb()+" <object_path>\n"); return 0;
  }
  upd_file = find_file(str,".lpc");
  if (!upd_file) upd_file=find_file(str);
  if (!upd_file) {
    notify_fail(str+": No such file.\n"); return 0;
  }
  ob = find_object(upd_file);
  if (!ob) {
    notify_fail(upd_file+": No such object.\n"); return 0;
  }
  if (query_verb() == "update")         // do only soft update
  {
    if (!ob->remove()) {
      notify_fail(upd_file+": doesn't want to be destructed!\n");
      return 0;
    }
  }
  else
    destruct(ob);                       // hard (forced) update

  write(upd_file+": will be reloaded at next reference.\n");
  return 1;
}

int clone(string str) 
{
  object ob;
  string clone_file;
  int ret;

  if (!(str=_unparsed_args())){
    notify_fail("Usage: clone <object_path>\n"); return 0;
  }
  clone_file = find_file(str,".lpc");
  if (!clone_file) clone_file=find_file(str);
  if (!clone_file) {
    notify_fail(str+": No such file.\n"); return 0;
  }
  ob = clone_object(clone_file);
  if (!ob)
  {
    say(this_player()->Name(WER,1)+" malt wilde Zeichen in die Luft und "
        +"murmelt vor sich hin, aber nichts passiert...\n");
    write(clone_file+": Failed to clone.\n");
  }
  else
  {
    write("Cloned "+file_name(ob)+".\n");
    say(this_player()->Name(WER,1) + " "
                + this_player()->QueryProp(P_CLONE_MSG)+".\n");

    /* try to move the object to my environment */
    if ( (ret=ob->move(this_object(),M_GET)) < 0 &&
         (ret=ob->move(environment(),M_NOCHECK)) < 0)
    {
      say(ob->Name(WER,1)+" loest sich in Luft auf.\n");
      ob->remove();
      if (ob) destruct(ob);
      write(clone_file+": failed to move ("+ret+").\n");
    }
  }
  return 1;
}

nosave int destruct_object(string str)
{ 
  object ob;
  object *obs;
  string strWER,strWEN;

  if (!(str=_unparsed_args())) {
    notify_fail("Usage: "+query_verb()+" <objectname>\n"); return 0;
  }

  // Objekt suchen: erst nach ID...
  obs = this_player()->select_objects(lower_case(str));
  if (!obs || !sizeof(obs)) {
    // ...dann nach Filenamen (eigtl. ist ja '[Uu]pdate' dafuer zustaendig)
    if (!(ob=find_object(str)) &&
        !(ob=find_object(find_file(str,".lpc") || "")))
    {
      notify_fail("Kein \""+str+"\" gefunden.\n");
      return 0;
    }
  }
  else
    ob=obs[0];

  strWER=ob->name(WER) || "etwas";
  strWEN=ob->name(WEN) || "etwas";

  if (query_verb() == "destruct")       // do only soft destruct
  {
    if (!ob->remove() && objectp(ob)) {
      notify_fail(capitalize(strWER)+" will nicht 'destructed' werden!\n");
      say(this_object()->Name(WER,1)+" versucht vergeblich, "+strWEN+
          " zu atomisieren.\n");
      return 0;
    }
  }
  else
    destruct(ob);                       // hard (forced) destruct

  say(capitalize(strWER)+" "+this_object()->QueryProp(P_DESTRUCT_MSG)+".\n");
  write(capitalize(strWER)+" wird von Dir zerstaeubt.\n");
  return 1;
}

/*
 * load object. If it cant be loaded errormsg is returned, else
 * 0 is returned.
 * We just call a non existing function in the object, and that way
 * force it to be loaded.
 */
string load_object(string file)
{
  return catch(call_other(file,"???"));
}

nosave int load(string str)
{ 
  object env;
  string file;
  string err;
  int ec;

  if (!(str=_unparsed_args())) {
    notify_fail("Usage: load <object_path>\n"); return 0;
  }
  file = find_file(str,".lpc");
  if (!file) file=find_file(str);
  if (!file) {
    notify_fail(str+": No such file.\n"); return 0;
  }
  ec=get_eval_cost();
  if (err=load_object(file))
    printf("Cannot load %O, err = %O\n",file,err);
  else {
    ec=ec-get_eval_cost()-13;   // 13 is the overhead for load_object()
    write(file+": loaded (eval cost: "+ec+").\n");
  }
  return 1;
}

nosave int exec_playerob(string name)
{
  object ob, *inv;
  int i;

  if (!IS_LORD(this_object())) return 0;
  if (this_player() != this_interactive()) return 0;
  if (this_player() != this_object()) return 0;
  if (!(name=_unparsed_args())) return 0;
  name="secure/master"->_get_path(name,getuid(this_object()));
  if (catch(call_other(name,"????"))) 
  {
    write("BUG in "+name+"\n");
    return 1;
  }
  ob=clone_object(name);
  if (!ob) return 0;
  if (getuid(ob) != getuid(this_object()))
  {
    write("UID conflict.\n");
    destruct(ob);
    return 1;
  }
  log_file("EXEC", getuid(this_object())+" "+name+" "+dtime(time()));
  disable_commands();
  exec(ob,this_object());
  if (interactive(this_object()) || !interactive(ob))
  {
    enable_commands();
    write("Fehler in exec\n");
    return 1;
  }
  inv=all_inventory(this_object());
  ob->start_player(capitalize(getuid(this_object())));
  remove();
  return 1;
}

nosave string *_query_localcmds()
{
  return ({
           ({ "clone","clone",0,INACTIVEWIZ_LVL }),
	   ({ "destruct","destruct_object",0,INACTIVEWIZ_LVL }),
	   ({ "Destruct","destruct_object",0,INACTIVEWIZ_LVL }),
	   ({ "load","load",0,INACTIVEWIZ_LVL }),
	   ({ "update","update_object",0,INACTIVEWIZ_LVL }),
	   ({ "Update","update_object",0,INACTIVEWIZ_LVL }),
	   ({ "exec","exec_playerob",0,WIZARD_LVL })
	 });
}
