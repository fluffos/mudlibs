            words[i]=words[i][1..];
            qadv=implode(words[i..], " ");
            break;
        }
        tmp=plr_adverbs[words[i]] || QueryStdAdverbs()[words[i]];
        if (tmp) { // Adverbkuerzel erkannt
            if (i==num-1) { // letztes wort
                adv+=({ tmp });
                continue;
            } else if (words[i+1]=="und") {
                adv+=({ tmp });
                i++; // 'und' uebergehen;
                continue;
            }
        }
        // Wort nicht als Kuerzel erkannt: quoten
        qadv=implode(words[i..], " ");
        break;
    }
    if (qadv) adv+=({ qadv });
    adverb=CountUp(adv);
    if (adverb=="") adverb=0;
}
