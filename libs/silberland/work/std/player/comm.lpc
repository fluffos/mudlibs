#pragma strong_types

inherit "/std/player/channel";

#define NEED_PROTOTYPES

#include "/std/sys_debug.h"

#include <thing/properties.h>
#include <thing/description.h>
#include <player/comm.h>
#include <player/base.h>

#include <properties.h>
#include <config.h>
#include <ansi.h>
#include <wizlevels.h>
#include <language.h>
#include <udp.h>
#include <defines.h>
#include <daemon.h>

#define ECHO_COST 50
#define MAX_IGNORE 500
#define MIN_LEVEL_FOR_INTERMUD 2

#define PERMUTATE(from,to) \
  if (objectp(QueryProp(P_PERM_STRING))) \
    to=call_other(QueryProp(P_PERM_STRING), "permutate_string", (from))||""; \
  else \
    to=from;

nosave string *last_tell=({});
nosave string last_received;
nosave string last_shout = "";
nosave int last_shout_time = 0;

#define MAX_TMHIST 10
#define MAX_THIST 50
nosave mapping msghist = ([ 0:({ }), 1:({ }) ]);        // 0: tm, 1: room

varargs nosave void AddToMsgHist(string was, int out, int room);
varargs nosave string GetMsgHist(mixed filter, int in_only, int room);
varargs nosave void ClearMsgHist(int room);

//local property prototypes
nosave int _set_earmuffs(int level);
nosave int _query_intermud();

private nosave string *buffer = ({});

void create()
{
  ::create();
  Set(P_EARMUFFS, 0);
  Set(P_EARMUFFS, SAVE|SECURED, F_MODE_AS);
  // Set(P_INTERMUD, SAVE, F_MODE_AS);
  Set(P_IGNORE, ({}), F_VALUE);
  Set(P_IGNORE, SAVE, F_MODE_AS);
  Set(P_BUFFER, SAVE, F_MODE_AS);
  msghist = ([ 0:({ }), 1:({ }) ]);
}

private int _send(object ob, string message, int flag)
{
  mixed res;
  if(!call_resolved(&res, ob, "Message", message, flag))
    tell_object(ob, message);
  return res;
}

varargs nosave int _flush_cache(string arg)
{
  switch(arg)
  {
    case "ein":
      SetProp(P_BUFFER, 1); 
      printf("Der Kobold merkt sich jetzt alles!\n"); break;
    case "aus":
      SetProp(P_BUFFER, 0); 
      printf("Der Kobold wird Dich nicht stoeren!\n"); break;
    default: if(arg) printf("Der Kobold sagt: kobold ein oder kobold aus\n");
  }
  if(sizeof(buffer))
  {
    tell_object(this_object(),
		sprintf("Ein kleiner Kobold teilt Dir folgendes mit:\n%s",
			implode(buffer, "")));
    buffer = ({});
  }     
  return 1;
}

private int check_ignore(mixed ignore, string verb, string name)
{
  return (ignore == verb) ||
    ((sizeof(ignore = efun::explode(ignore, ".")) > 1) &&
     (name == ignore[0] && member(ignore[1..], verb) != -1));
}

varargs int Message(string msg, int flag, mixed extra)
{
  object ti;
  string verb, reply, *ignore, tin;
  int em, te;
  mixed deaf;

  // Bei den Kanaelen 'Debug' und 'Entwicklung' kann man gezielt Bugs
  // einzelner Magier ignorieren. Dazu wird der Kanalname zum 'verb',
  // damit 'ignoriere name.debug' funktioniert.
  if (flag == MSGFLAG_CHANNEL &&
      (msg[1..5] == "Debug" || msg[1..11] == "Entwicklung"))
  {
      // Missbrauch der Variable 'ignore' als Zwischenspeicher
    ignore = regexplode( msg, ":| |\\]" );
    verb = lower_case(ignore[0][1..]);
    tin = lower_case(ignore[2]);
  }
  else
  {
    verb = query_verb();
    if (ti = this_interactive())        // v.a. fuer antwortende NPCs noetig
    {
      if ( (this_interactive() == ME) && (living(previous_object())) )
        ti = previous_object();

      tin = getuid(this_interactive());
    }
  }
  if (te = flag & (MSGFLAG_TELL | MSGFLAG_WHISPER))
    if (ti && (ti != previous_object()))        // potentielles Fake-tm erkennen
      msg = break_string(msg[0..<2]+" [!]",
          QueryProp(P_SCREENWIDTH), 0, BS_LEAVE_MY_LFS);

  // fuer "erwidere"
  if (ti && (flag & MSGFLAG_TELL))
    if (!ti->QueryProp(P_INVIS)||IS_LEARNER(ME))
      last_received=getuid(ti);

  // Hoert der Spieler nicht?
  em = (ti && (te || flag & MSGFLAG_SHOUT) &&
        (QueryProp(P_EARMUFFS) &&
         (query_wiz_level(ti) < QueryProp(P_EARMUFFS))));
  ignore = (pointerp(ignore = QueryProp(P_IGNORE)) ? ignore : ({}));

  // Werden Sender oder Verb ignoriert?
  if (ti && (member(ignore, getuid(ti)) != -1)) {
    if (te && (IS_LEARNER(ti) || !QueryProp(P_INVIS)))
      if (!(flag & MSGFLAG_SILENT))
        tell_object(ti, Name()+" hoert gar nicht zu, was Du sagst.\n");
    return MESSAGE_IGNORE_YOU;
  }

  if (tin && verb &&
     sizeof(filter_array(ignore, #'check_ignore/*'*/, verb, tin)))
  {
    if (ti && (verb[0..2] != "ruf" && verb[0..3] != "mruf" &&
         verb[0..3] != "echo" && verb[0] != '-') && !(flag & MSGFLAG_CHANNEL)
        && (IS_LEARNER(ti) || !QueryProp(P_INVIS)))
      if (!(flag & MSGFLAG_SILENT))
        tell_object(ti, Name()+" wehrt \""+verb+"\" ab.\n");
    return MESSAGE_IGNORE_VERB;
  }
  if (flag & MSGFLAG_RTELL) {
    int at;

    // fuer intermud-erwidere
    last_received = verb = lower_case(explode(msg, " ")[0][1..]);
    at = member(verb, '@');

    if ((member(ignore, verb) >= 0) || (member(ignore,verb[0..at]) >= 0))
      return MESSAGE_IGNORE_YOU;
    else if (at > 0 && member(ignore, verb[at..]) >= 0)
      return MESSAGE_IGNORE_MUD;
  }

  // Spieler taub?
  te |= (flag & MSGFLAG_SAY);

  if ((deaf = QueryProp(P_DEAF)) && (flag & MSGFLAG_DEAFCHK)
      && !(flag & MSGFLAG_CHIST))
  {
    if (te)
    {
      if (mappingp(deaf))
        deaf = deaf[DEAF_MSG];
      if (!stringp(deaf))
        deaf = "%s ist momentan leider taub.\n";
      reply = capitalize(sprintf(deaf, name()));
    }
  }
  else if (em)
    reply = Name() + " hat Oropax in den Ohren.\n";

  if(QueryProp(P_BUFFER) &&
     (deaf ||
      query_editing(this_object()) ||
      query_input_pending(this_object())))
  {
    deaf = MESSAGE_DEAF;
    if(flag & MSGFLAG_CACHE)
    {
      if (flag & MSGFLAG_HIST)
        AddToMsgHist(msg, 0, ((flag & MSGFLAG_SHIST) != 0));
      if (!stringp(reply))
        reply = Name()+" moechte gerade nicht gestoert werden.\n";

      if(sizeof(buffer) < 20)
      {
        buffer += ({ msg[0..<2]+" ["+dtime(time())[19..26]+"]\n" });
        reply += "Die Mitteilung wurde von einem kleinen Kobold in Empfang " +
          "genommen.\nEr wird sie spaeter weiterleiten!";
        deaf = MESSAGE_CACHE;
      }
      else {
        reply += "Die Mitteilung ging verloren, denn " +
          "der Kobold kann sich nichts mehr merken!";
        deaf = MESSAGE_CACHE_FULL;
      }
      if (ti && (IS_LEARNER(ti) || !QueryProp(P_INVIS)) &&
          !(flag & MSGFLAG_SILENT))
          tell_object(ti, reply+"\n");
    }
    return deaf;
  }

  if ( (deaf || em) &&
       ( (flag & MSGFLAG_RTELL) ||
         (ti && (IS_LEARNER(ti) || !QueryProp(P_INVIS))) ) ) {
    if (te && ti && !(flag & MSGFLAG_SILENT))
      tell_object(ti, reply);
    return MESSAGE_DEAF;
  }

  _flush_cache();
  te |= (flag & MSGFLAG_RTELL);
  if(flag & MSGFLAG_HIST)
    AddToMsgHist(msg, 0, ((flag & MSGFLAG_SHIST) != 0));
  if(te && QueryProp(P_AWAY))
    msg = break_string(msg[0..<2]+" ["+dtime(time())[19..23]+"]\n",
        QueryProp(P_SCREENWIDTH), 0, BS_LEAVE_MY_LFS);
  tell_object(this_object(), msg);
  return MESSAGE_OK;
}

nosave int ignoriere(string str)
{
  mixed ignore;
  int i;
  string verb;
  
  if (verb && verb!="ignorier" && verb!="ignoriere")
    return 0;
  if(!(ignore = Query(P_IGNORE))) ignore = ({});
  
  if (!str)
  {
    write("Du ignorierst:\n"+
        break_string(implode(ignore, ", "), QueryProp(P_SCREENWIDTH)));
    return 1;
  }
  if (member_array(lower_case(str), ignore)!=-1)
  {
    Set(P_IGNORE, ignore -= ({ lower_case(str) }));
    printf("Du ignorierst %s nicht mehr.\n", capitalize(str));
    return 1;
  }
  if (sizeof(ignore) >= MAX_IGNORE)
    write("Deine Ignoriere-Liste hat das erlaubte Maximum bereits erreicht!\n");
  else {
    Set(P_IGNORE, ignore += ({ lower_case(str) }));
    printf("Du ignorierst jetzt folgende Mitteilungen: %s.\n", str);
  }
  return 1;
}

int earmuffs(string s)
{
  int x;

  if (!s || s == "") {
    write("Ok, Oropax aus.\n");
    SetProp(P_EARMUFFS, 0);
    return 1;
  }
  if (sscanf(s, "%d", x) == 0 || x < 0) {
    write("Verwendung: oropax <level>\n");
    return 1;
  }
  if (SetProp(P_EARMUFFS, x) == x)
    printf("Ok, Oropaxlevel ist jetzt %d.\n", x);
  else
    printf("So hoch geht es nicht. Oropaxlevel ist jetzt %d.\n",
	   QueryProp(P_EARMUFFS));
  return 1;
}

private int same_race(object pl, string my_race)
{
  // alle NPC's und Magier bekommen die Meldung im Klartext
  return !interactive(pl) ||
    (pl->QueryProp(P_RACE) == my_race) ||
    IS_LEARNING(pl);
}

private int is_frog(object pl)
{
  // alle NPC's und Magier bekommen die Meldung im Klartext
  return !interactive(pl) || (pl->QueryProp(P_FROG)) || IS_LEARNING(pl);
}

private int is_wiz_level_ge(object ob, mixed x)
{
  return query_wiz_level(ob) >= x;
}

nosave int _communicate(mixed str, int silent)
{
  string  verb;
  string  myname;
  string  myrace;
  string  msg;
  object  *livings, *taub, *same, *not_same, *wiz;
  int     i;

  if (extern_call())
    str = _unparsed_args() || "";

  verb = query_verb();
  if (stringp(verb) && verb[0] == '\'')
    str = verb[1..] + " " + str;

  if (!str || str == "" || str == " ") {
    write("Was willst Du sagen?\n");
    return 1;
  }

  PERMUTATE(str,msg);
  if (regreplace(str,"[^A-Za-z?]","",1)[<1] == '?')     // last non-letter=? ?
    verb = "frag";
  else if (verb != "rede")
    verb = "sag";

  // Ausgabe an den Spieler selbst:
  if (!silent)
    write(myname = break_string(str, 78, "Du "+verb+"st: "));

  // In History aufnehmen (Variable myname missbrauchen):
  AddToMsgHist(myname, 1, 1);

  // Eigennamensbestimmung
  myname =
    ( ( (QueryProp(P_INVIS) || !IS_LEARNER(ME)) ||
        !(QueryProp(P_CAN_FLAGS) & CAN_PRESAY) ? "" : QueryProp(P_PRESAY) ) +
      ME->name()) || "";

  // Taube und Magier bestimmen
  livings = ({ });
  if (environment())
    livings += filter_array( all_inventory(environment()), #'living );
  livings += filter_array( all_inventory(this_object()), #'living );

  taub = filter_array( livings, #'interactive );
  wiz = filter_array( taub, "is_wiz_level_ge", ME, LEARNER_LVL );
  taub = filter_objects( taub, "QueryProp", P_DEAF );
  taub += ({ this_object() });
  wiz -= taub;

  // "rede" Handling
  if (query_verb() == "rede" && !IS_LEARNER(ME))
  {
    // a) als Frosch
    if (QueryProp(P_FROG))
    {
      myrace   = QueryProp(P_RACE);
      same     = filter_array(livings, #'is_frog);
      not_same = livings - same;

      // das hoeren alle meiner Rasse, NPC's und Magier mit 'mschau an':
      if (sizeof(wiz))
      {
        // Magier sehen auch den Namen des sprechenden Frosches:
        filter_objects( wiz, "Message",
            break_string(msg, 78,
              "Frosch "+capitalize(getuid(this_object()))+" quakt: "),
            MSGFLAG_SAY | MSGFLAG_SILENT );
        filter_objects( livings-(wiz+taub+not_same), "Message",
            break_string(msg, 78, capitalize(myname)+" quakt: "),
            MSGFLAG_SAY | MSGFLAG_SILENT );
      }
      else
        filter_objects( livings-(taub+not_same), "Message",
            break_string(msg, 78, capitalize(myname)+" quakt: "),
            MSGFLAG_SAY | MSGFLAG_SILENT );

      // das hoeren alle anderen:
      filter_objects( livings-(taub+same), "Message",
          capitalize(myname)+" quakt: Quak quaaaak quaaaaaaaak!\n",
          MSGFLAG_SAY | MSGFLAG_SILENT );
    } // if (QueryProp(P_FROG))
    // b) als Nicht-Frosch
    else
    {
      myrace = QueryProp(P_RACE);
      same     = filter_array(livings, #'same_race, myrace);
      not_same = livings - same;

      // das hoeren alle meiner Rasse, NPC's und Magier mit 'mschau an':
      filter_objects( livings-(taub+not_same), "Message",
          break_string(str, 78, capitalize(myname)+" "+verb+"t: "),
          MSGFLAG_SAY | MSGFLAG_SILENT );

      // das hoeren alle anderen:
      msg = capitalize(myname);
      switch (myrace)
      {
        case "Zwerg":
          msg += " murmelt etwas in "+QueryPossPronoun()+"en Bart.\n";
          break;
        case "Elf":
          msg += " singt leise vor sich hin.\n";
          break;
        case "Mensch":
          msg += " sagt etwas in einer fremdartigen Sprache.\n";
          break;
        case "Hobbit":
        case "Oger":
          msg += " scheint noch an der letzten Mahlzeit zu kauen.\n";
          break;
        case "Troll":
          msg += " grollt unverstaendliche Laute mit donnernder Stimme.\n";
          break;
        case "Fee":
          msg += " summt eine leise Melodie.\n";
          break;
        case "Dunkelelf":
          msg += " zischt verstohlen einige diabolische Laute.\n";
          break;
        default:
          msg += " brummelt vor sich hin.\n";
      }
      filter_objects( livings-(taub+same), "Message", msg,
          MSGFLAG_SAY | MSGFLAG_SILENT );
    } // if (QueryProp(P_FROG)) else
  } // if (query_verb() == "rede" && !IS_LEARNER(ME))
  // normales "sag"
  else
  {
    if (!QueryProp(P_INVIS) || !sizeof(wiz))
      filter_objects( livings-taub, "Message",
          break_string(msg, 78, capitalize(myname)+" "+verb+"t: "),
          MSGFLAG_SAY | MSGFLAG_SILENT );
    else
    {
      filter_objects( livings-(wiz+taub), "Message",
          break_string(msg, 78, capitalize(myname)+" "+verb+"t: "),
          MSGFLAG_SAY | MSGFLAG_SILENT );
      filter_objects( wiz, "Message",
          break_string(msg, 78,
            "("+capitalize(getuid(this_object()))+") "+verb+"t: "),
          MSGFLAG_SAY | MSGFLAG_SILENT );
    }
  }
  return 1;
}

nosave int _shout_to_all(mixed str)
{
  string pre, myname, realname, str1, str2;
  int i,chars;
  object *u;
  
  if (!(str=_unparsed_args())) {
    write("Was willst Du rufen?\n");
    return 1;
  }

  if ((str == last_shout) && (last_shout_time > (time() - 120))) {
    write("Aber das hast Du doch schon gerufen!\n");
    return 1;
  }
  last_shout = str;
  last_shout_time = time();

  chars=strlen(str)/2;
  if (chars<4) chars=4;
  pre = (!IS_LEARNER(ME) ||
         QueryProp(P_INVIS) ||
         !(QueryProp(P_CAN_FLAGS) & CAN_PRESAY)) ? "" : QueryProp(P_PRESAY);
  realname = capitalize((pre + capitalize(getuid()))||"");
  myname = capitalize(pre + ME->name()||"");
  if (QueryProp(P_INVIS))
    realname = "("+realname+")";

  PERMUTATE(str,str1);

  if(QueryProp(P_FROG))
    str2 = break_string("Quaaak, quaaaaaak, quuuuaaaaaaaaaaaaaaaaaaaak !!",
		        78, myname+" quakt: ");
  else
    str2 = break_string(str1, 78, myname+" ruft: ");

  if(!IS_SEER(ME))  // Seher++ duerfen kostenfrei rufen
  {
    if (QueryProp(P_SP) < (chars+20)) 
    {
      write("Du musst erst wieder magische Kraefte sammeln.\n");
      if (QueryProp(P_LEVEL) < 10)
        write("Tip: Benutz doch mal die Ebenen "
              "(Hilfe dazu mit 'hilfe ebenen').\n");
      return 1;
    }
    SetProp(P_SP, QueryProp(P_SP) - chars - 20);
  }
    
  write(break_string(str, 78, "Du rufst: "));
  str1=break_string(str1, 78, realname+" ruft: ");

  u=users()-({this_object()});
  for (i=sizeof(u)-1;i>=0;i--)
    if (getuid(u[i]) != ROOTID)         // login-Objekte ausnehmen
      _send(u[i], (IS_LEARNER(u[i]) ? str1 : str2), MSGFLAG_SHOUT);
  return 1;
}

varargs nosave int do_tell(string wem, string was)
{
  object          ob;
  string          myname;
  mixed           it;
  string          away;
  mixed           ignore;
  int             i;
  mixed          *xname;
  int             visflag;
  mixed           ret;

  // .n Expansion (tmhist)
  if (wem == ".") wem = ".1";
  if (sscanf(wem, ".%d", i))
  {
    if (i > 0 && i <= sizeof(last_tell))
      wem = last_tell[i-1];
    else {
      _notify_fail("Mit so vielen Leuten hast Du nicht gesprochen!\n");
      return 0;
    }
  }

  // Intermud-teile-mit
  if (sizeof(xname = explode(wem, "@")) == 2)
  {
    if (!IS_SEER(ME) && (QueryProp(P_LEVEL) < MIN_LEVEL_FOR_INTERMUD))
    {
       write(break_string(
            "Deine Spielerstufe erlaubt Dir leider noch "
            "nicht, Gespraeche in andere Welten zu beginnen.", 77));
    }
    else if (ret = (string)INETD->send_udp(xname[1],
          ([ REQUEST:   "tell",
             RECIPIENT: xname[0],
             SENDER:    getuid(ME),
             DATA:      was ]), 1))
      write(ret);
    else
    {
      write("Nachricht abgeschickt.\n");

      // In tmhist aufnehmen:
      if (!sizeof(last_tell))
        last_tell = ({ wem });
      else if (last_tell[0] != wem)
          last_tell = ( ({ wem }) + (last_tell - ({ wem })) )[0..MAX_TMHIST-1];

      // In thist aufnehmen:
      ret = INETD->expand_mud_name(lower_case(xname[1]));
      ret = (pointerp(ret) && sizeof(ret)) ? ret[0] : xname[1];
      away = break_string(was, 78,
          sprintf("Du teilst %s@%s mit: ",
            capitalize(xname[0]), capitalize(ret)));
      AddToMsgHist(away, 1);
    }
    return 1;
  }

  // Lebewesen suchen (Spieler zuerst)
  if (!ob = find_player(it = lower_case(wem)) || find_living(it))
  {
    if (!stringp(it = match_living(it,1))) // bevorzugt Spieler finden
      it = match_living(lower_case(wem),0); // sonst auch npc
    if (!stringp(it))
    {
      switch (it)
      {
        case -1:
          write("Das war nicht eindeutig!\n");
          return 1;
        default:
          // (eigtl. nur -2 moeglich)
          write("Kein solcher Spieler!\n");
          return 1;
      }
    }
    ob = find_player(it);
    if (!ob)
    {
      ob = find_living(it);
      if (!ob)
      {
        write("Kein solcher Spieler!\n");
        return 1;
      }
    }
  }

  // tmhist updaten, wenn visflag OK
  if (visflag = (!ob->QueryProp(P_INVIS)) || IS_LEARNER(ME))
  {
    if (sizeof(last_tell))
    {
      if(last_tell[0] != it)
        last_tell = ( ({ it }) + (last_tell - ({ it })) )[0..MAX_TMHIST-1];
    }
    else
      last_tell = ({ it });
  }

  // Eigenen Namen setzen (je nach Unsichtbarkeit und Ziel)
  if (QueryProp(P_INVIS))
  {
    if (!IS_LEARNER(ob))
      myname = ME->Name();
    else
      myname = "(" + capitalize(getuid()) + ")";
  }
  else
  {
    myname = ((IS_LEARNER(ME) && (QueryProp(P_CAN_FLAGS) & CAN_PRESAY)) ?
              capitalize(QueryProp(P_PRESAY) + ME->name()) : ME->Name());
  }

  // Eigener Text ("Du teilst...")
  if (visflag || !query_once_interactive(ob))
  {
    away = break_string(was, QueryProp(P_SCREENWIDTH), "Du teilst " +
        (query_once_interactive(ob) ? capitalize(it) : ob->name(WEM)) +
        " mit: ");
    write(away);
    AddToMsgHist(away, 1);
  }

  // JETZT erst Sprachflueche auswerten
  PERMUTATE(was, was);

  // An den Empfaenger schicken (gg.falls sprachfluchpermutiert)
  _send(ob, break_string(was, ob->QueryProp(P_SCREENWIDTH), 
        myname+" teilt Dir mit: "), MSGFLAG_TELL);

  // Unsichtbare als nicht eingeloggt vortaeuschen
  if (!visflag && query_once_interactive(ob))
  {
    write("Kein solcher Spieler!\n");
    return 1;
  }

  // Weg-Meldung gesetzt ?
  if (away = (string) ob->QueryProp(P_AWAY)) 
  {
    if (interactive(ob) && (i = query_idle(ob)) >= 600)
    {
      if (i < 3600)
        away += " (seit "+time2string("%m %M", i)+")";
      else
        away += " (seit "+time2string("%h %H und %m %M", i)+")";
    }
    write(
        break_string(
          "ist gerade nicht da: " + away, QueryProp(P_SCREENWIDTH), 
          capitalize(it) + " ", BS_INDENT_ONCE));
    return 1;
  }

  // Noch laenger als 10 Heartbeats paralysiert ?
  if ( ( mappingp(ob->QueryProp(P_PARALYZED)) ) &&
            ( intp(i = (int) ob->QueryProp(P_PARALYZED)[PARALYZE_TIME]) ) &&
            ( i < 0 || i > 10 ) )
  {
    printf("%s kann Dir gerade nicht antworten.\n", capitalize(it));
    return 1;
  }

  // Laenger als 10 Minuten idle ?
  if (interactive(ob) && (i = query_idle(ob)) >= 600)
  {
    if (i < 3600)                       // unter 1 Stunde
      away = time2string("%m %M", i);
    else if (i > 10*86400)              // ueber 10 Tagen
      away = time2string("%d %D", i);
    else if (i > 3*86400)               // ueber 3 Tage
      away = time2string("%d %D und %h %H", i);
    else                                // 1 Stunde bis 3 Tage
      away = time2string("%h %H und %m %M", i);

    printf("%s ist schon %s inaktiv.\n", capitalize(it), away);
  }
  return 1;
}


varargs nosave void AddToMsgHist(string was, int out, int room)
{
  was=implode(explode(was,"\n")-({""}),"\n")+"\n";  // Leerzeilen raus
  if (sizeof(msghist[room]))
  {
    // check ob's evtl. bloss ein timeout-bedingter resend war (UDP/cross-mud)
    // (oder ob einfach jemand mit lauter gleichen mehrfach-tm's nervt)
    if ((msghist[room][<1][1]==was) && (time()-msghist[room][<1][0] <= 30))
    {
      msghist[room][<1][0]=time();   // Zeitpunkt updaten
      msghist[room][<1][2]++;
      return;
    }
  }
  msghist[room] += ({ ({ time(), was, 1, out }) });
  while (sizeof(msghist[room]) > MAX_THIST)
    msghist[room] = msghist[room][1..];
}


varargs nosave string GetMsgHist(mixed filter, int in_only, int room)
{
  string str,b,n,dt,dtnow;
  mixed th;
  int i;

  str=QueryProp(P_TTY);
  if (str=="ansi" || str=="vt100")
    b=ANSI_BOLD, n=ANSI_NORMAL;
  else
    b=n="";

  if ((previous_object()!=ME) || (this_interactive()!=ME))
    return "Ungueltiger Aufruf!\n";

  if (in_only)
    th = filter_array( msghist[room],
                       lambda( ({'a}), ({ #'!, ({ #'[,'a,3 }) }) ) );
  else
    th = msghist[room];

  if (!sizeof(th))
    if (room)
      return "Du hast bisher noch kein gesagtes Wort gehoert!\n";
    else
      return "Dir hat noch niemand etwas mitgeteilt!\n";

  if (intp(filter) && (filter > 0) && (filter < sizeof(th)))
    i = sizeof(th) - filter;
  else
    i = 0;

  for (str=""; i<sizeof(th); i++)
  {
    if (stringp(filter) &&
        strstr(lower_case(th[i][1]), lower_case(filter)) == -1)
      continue;

    str += b;
    if (time()-th[i][0] > 6*86400)      // mehr als eine Woche her?
      str += dtime(th[i][0])+" Uhr";    // Vollformat-Datum
    else
    {
      dt = dtime(th[i][0]);
      dtnow = dtime();

      if (dt[0..2] != dtnow[0..2])      // neuer Wochentag?
        if (ctime(th[i][0])[0..2] == ctime(time()-86400)[0..2])
          // bei der Sommerzeitumstellung moeglicherweise kurz falsch
          str += "Gestern um " + dt[19..] + " Uhr";     // Gestern+Zeit
        else
          str += dt[0..2]+", " + dt[19..] + " Uhr";     // Wochentag+Zeit
      else
        // sonst: heute
        str += dt[19..26] + " Uhr";                     // nur Uhrzeit
    }

    // Wiederholungen und die Nachricht selbst
    str += (th[i][2] > 1 ? " ("+th[i][2]+" mal):" : ":")+n+"\n"+th[i][1];
  }
  if (!strlen(str) && stringp(filter))
    return "Keine auf \""+filter+"\" passende Mitteilung gefunden!\n";

  return str;
}


varargs nosave void ClearMsgHist(int room)
{
  msghist[room] = ({});
}


// teile-mit
nosave int _teile(string str)
{
  string who, message;

  if (!(str=_unparsed_args()))
    return 0;
  if (sscanf(str, "%s mit %s", who, message) == 2)
    return do_tell(who, message);
}

// erzaehle
nosave int _tell(string str)
{
  string who, message;

  notify_fail("Was willst Du mitteilen?\n");
  if (!(str=_unparsed_args()))
    return 0;
  if (sscanf(str, "%s %s", who, message) != 2)
    return 0;
  return do_tell(who, message);
}

// erwidere
nosave int erwidere(string str)
{
  if (!last_received)
    _notify_fail("Du hast aber noch keine Mitteilungen erhalten, "
                 "auf die Du was erwidern\nkoenntest.\n");
  else if (!stringp(str=_unparsed_args()) || !strlen(str))
    _notify_fail("Was willst Du denn "+last_received+" erwidern?\n");
  else
    return do_tell(last_received, str);
  return 0;
}

// fluestere
nosave int _whisper(string str)
{
  object          ob;
  string          who;
  string          msg;
  string          myname;

  if (!(str=_unparsed_args()) || 
       (sscanf(str, "%s zu %s", who, msg) != 2 &&
        sscanf(str, "%s %s", who, msg) != 2)) {
    write("Was willst Du wem zufluestern?\n");
    return 1;
  }
  ob = present(lower_case(who), environment(this_player()));
  if (!ob || !living(ob)) {
    write("Kein solcher Spieler in diesem Raum.\n");
    return 1;
  }
  PERMUTATE(msg,str);
  write(break_string(msg, QueryProp(P_SCREENWIDTH), sprintf("Du fluesterst %s zu: ", ob->name(WEM))));
  myname = capitalize((((IS_LEARNER(ME) && !QueryProp(P_INVIS) &&
                         (QueryProp(P_CAN_FLAGS) & CAN_PRESAY))?
                        QueryProp(P_PRESAY) : "") + ME->name()) || "");
  _send(ob, break_string(str, ob->QueryProp(P_SCREENWIDTH),
      sprintf("%s fluestert Dir zu: ",
          QueryProp(P_INVIS) && IS_LEARNER(ob) ?
            "("+capitalize(getuid(ME))+")" : myname)), MSGFLAG_WHISPER);
  say(sprintf("%s fluestert %s etwas zu.\n", myname, ob->name(WEM, 1)), ob);
  return 1;
}

// gespraech
nosave int _converse()
{
  write("Mit '**' wird das Gespraech beendet.\n");
  write("]");
  input_to("_converse_more");
  return 1;
}

nosave int _converse_more(mixed str)
{
  string          cmd;
  int             i;
  string          myname;
  
  if (str == "**") {
    write("Ok.\n");
    return 0;
  }
  myname=capitalize((((IS_LEARNER(ME)&&!QueryProp(P_INVIS) &&
                     (QueryProp(P_CAN_FLAGS) & CAN_PRESAY))?
		      QueryProp(P_PRESAY):"")+ME->name())||"");
  if(str != "") _communicate(str, 1); 
  write("]");
  input_to("_converse_more");
}

private int is_learner(object o) { return IS_LEARNER(o); }

nosave int _shout_to_wizards(mixed str)
{
  int             i, j;
  string          myname;
  object         *u;
 
  str = _unparsed_args();
  if (!str||!strlen(str)) {
    write("Was willst Du den Magiern zurufen?\n");
    return 1;
  }
  myname = capitalize(getuid(this_object()));
  if (!IS_LEARNER(this_object())) write("Ok.\n");
  map_array(filter_array(users(), #'is_learner), //')))
#'_send, break_string(str, 78, myname+" an alle Magier: "),MSGFLAG_MECHO);//'
  return 1;
}

nosave int _echo(string str) {
  if (!IS_SEER(ME) || (!IS_LEARNER(ME) &&
		       !(QueryProp(P_CAN_FLAGS)&CAN_ECHO)))
    return 0;
  if (!(str=_unparsed_args())) {
    write ("Was moechtest Du 'echoen'?\n");
    return 1;
  }
  if (!IS_LEARNER(this_interactive()))
  {
    if (QueryProp(P_SP)<ECHO_COST)
    {
      _notify_fail("Du musst erst wieder magische Kraefte sammeln.\n");
      return 0;
    }
    SetProp(P_SP,QueryProp(P_SP)-ECHO_COST);
    str=">\b"+str;
  }
  say ( str + "\n");
  write ( str + "\n");
  return 1;
}

//****local property methods
nosave int _set_earmuffs(int level)
{
  int max;
  if ((max=1+query_wiz_level(this_object())) > 100) max=100;
  return Set(P_EARMUFFS, level > max ? max : level);
}

nosave mixed _set_ignore(mixed arg)
{
  if(stringp(arg)) arg = ({ arg });
  if(pointerp(arg)) return Set(P_IGNORE, arg);
}

nosave int _query_intermud()
{
  mixed tmp;
  return member(pointerp(tmp=Query(P_CHANNELS))?tmp:({}), "Intermud" ) > -1;
}

nosave int tmhist()
{
  int i;
  if ((previous_object()!=ME) || (this_interactive()!=ME))    
    return -1; 
  if (!sizeof(last_tell))
  {
    _notify_fail("Du hast noch keinem etwas mitgeteilt.\n");
    return 0;
  }
  for (i=sizeof(last_tell)-1;i>=0;i--)
    printf(".%-2d %s\n",i+1,last_tell[i]);
  return 1;
}


nosave int thist(string str)
{
  int n, in_only;

  if (str == "-c") {
    ClearMsgHist();
    write("Ok, Teile-Mit-History geloescht.\n");
    return 1;
  }

  if (str) {
    if (in_only = (str[0..1]=="-i"))
      str = str[3..];
  }

  if (str && strlen(str))       // Argument angegeben?
    if (to_string(n=to_int(str)) == str) {      // eine Zahl?
      if (n < 1 || n > MAX_THIST) {
        _notify_fail("Werte kleiner 1 oder groesser "+MAX_THIST+
                     " machen wenig Sinn!\n");
        return 0;
      }
      ME->More(GetMsgHist(n,in_only));
    }
    else                                        // sonst ein String.
      ME->More(GetMsgHist(str,in_only));
  else
    ME->More(GetMsgHist(0,in_only));

  return 1;
}


nosave int shist(string str)
{
  int n, in_only;

  if (str == "-c") {
    ClearMsgHist(1);
    write("Ok, Sag-History geloescht.\n");
    return 1;
  }

  if (str) {
    if (in_only = (str[0..1]=="-i"))
      str = str[3..];
  }

  if (str && strlen(str))       // Argument angegeben?
    if (to_string(n=to_int(str)) == str) {      // eine Zahl?
      if (n < 1 || n > MAX_THIST) {
        _notify_fail("Werte kleiner 1 oder groesser "+MAX_THIST+
                     " machen wenig Sinn!\n");
        return 0;
      }
      ME->More(GetMsgHist(n,in_only,1));
    }
    else                                        // sonst ein String.
      ME->More(GetMsgHist(str,in_only,1));
  else
    ME->More(GetMsgHist(0,in_only,1));

  return 1;
}


nosave string *_query_localcmds()
{
  return ({
    ({"kobold", "_flush_cache",0,0}),
     ({"sag","_communicate",0,0}),
     ({"sage","_communicate",0,0}),
     ({"'","_communicate",1,0}),
     ({"rede","_communicate",0,0}),
     ({"mruf","_shout_to_wizards",0,0}),
     ({"mrufe","_shout_to_wizards",0,0}),
     ({"ruf","_shout_to_all",0,0}),
     ({"rufe","_shout_to_all",0,0}),
     ({"erzaehl","_tell",0,0}),
     ({"erzaehle","_tell",0,0}),
     ({"teil","_teile",0,0}),
     ({"teile","_teile",0,0}),
     ({"fluester","_whisper",0,0}),
     ({"fluestere","_whisper",0,0}),
     ({"gespraech","_converse",0,0}),
     ({"echo","_echo",0,0}),
     ({"oropax","earmuffs",0,WIZARD_LVL}),
     ({"ignorier","ignoriere",0,0}),
     ({"ignoriere","ignoriere",0,0}),
     ({"tmhist","tmhist",0,0}),
     ({"thist","thist",0,0}),
     ({"shist","shist",0,0}),
     ({"erwider","erwidere",0,0}),
     ({"erwidere","erwidere",0,0}),
    })+channel::_query_localcmds();
}

