inherit "std/living/moving";

#pragma stong_types

#define NEED_PROTOTYPES

#include <thing/properties.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moving.h>

void create()
{
  SetProp(P_MSGIN,   "kommt an");
  SetProp(P_MSGOUT,  "geht");
  SetProp(P_MMSGIN,  "tritt aus einer Schwefelwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  Set(P_MSGIN,   SAVE, F_MODE_AS);
  Set(P_MSGOUT,  SAVE, F_MODE_AS);
  Set(P_MMSGIN,  SAVE, F_MODE_AS);
  Set(P_MMSGOUT, SAVE, F_MODE_AS);
}

// autoload and nodrop object may not fall into the environment
varargs int remove(int silent)
{
  string err;
  mixed dest_obj;

  if (interactive(this_object()))
    catch("/secure/merlin"->notify_player_leave(getuid(this_object()),
        QueryProp(P_INVIS)));

  for(dest_obj = deep_inventory(ME); sizeof(dest_obj); dest_obj = dest_obj[1..])
    if(dest_obj[0]->QueryProp(P_AUTOLOADOBJ) ||
       dest_obj[0]->QueryProp(P_NODROP))
    {
      // trying to remove before hard destruct
      if (err = catch(dest_obj[0]->remove()))
        log_file("interactive/REMOVE_FAILED",
            sprintf( "%s: %s: %s [%s]\n",
              ctime(time())[4..], file_name(dest_obj[0]),
              regreplace(err, "\n", "", 1), capitalize(getuid(ME)) ) );

      // remove() failed, try destruct()
      if(dest_obj[0])
        destruct(dest_obj[0]);
    }

  if(!QueryProp(P_INVIS) && !silent)
    catch(say(name(WER,1) + " verlaesst diese Welt.\n", ME));

  if(ME && !silent)
    tell_object(ME, "Bis bald!\n");

  if ( previous_object() && ME != this_player() && ME != this_interactive()
       && file_name(previous_object())[0..7] != "/secure/"
       && ((member(file_name(ME), ':') > -1) ||
           (member(file_name(ME), '#') > -1)) )
  {
    log_file( "interactive/PLAYERDEST",
              sprintf( "[%s] %O vernichtet von PO %O, TI %O, TP %O\n",
                       ctime(), ME, previous_object(),
                       this_interactive(), this_player() ) );
  }

  return (int)::remove();
}

#define EXH_MSG_ME ({ "Du fuehlst Dich etwas erschoepft.\n", \
            "Du verspuerst leichte Muedigkeit nach Deinen Anstrengungen.\n", \
            "Dein Herz klopft etwas schneller.\n", \
            "Du schwitzt leicht. Wie waers mal mit etwas Ruhe?\n" })

#define EXH_MSG2_ME ({ "Du spuerst die Erschoepfung nun ziemlich stark.\n", \
            "Voellig verausgabt schnappst Du nach Luft.\n", \
            "Dein Herz klopft heftig... vielleicht solltest Du ihm ja mal " \
              "etwas Ruhe\ngoennen?\n", \
            "Du keuchst vor Anstrengung.\n", \
            "Schweissperlen rinnen Dir uebers Gesicht - " \
              "kein Wunder, nach dieser\nAnstrengung!\n" })

#define EXH_MSG2_ROOM ({ " schnauft vor Anstrengung.\n", \
            " macht einen stark erschoepften Eindruck.\n", \
            " schwitzt stark, kein Wunder, bei der Anstrengung!\n", \
            " keucht erschoepft.\n", \
            " schnappt voellig verausgabt nach Luft.\n" })

varargs int move(mixed dest, int methods, string direction,
                 string textout, string textin)
{
  int mv, mvp;

  mv=::move(dest, methods, direction, textout, textin);
  if (mv<=0) {
    switch (mv) {
      case ME_TOO_EXHAUSTED:
        tell_object(ME, "Du bist zu erschoepft.\n"); break;
      case ME_RESTING:
        tell_object(ME, "Du solltest zuerst aufstehen.\n");
      case ME_CANT_MOVE:
        if (stringp(QueryProp(P_NOMOVE)))
          tell_object(ME, QueryProp(P_NOMOVE));
        else
          tell_object(ME, "Du kannst Dich nicht bewegen.\n");
      default:
    }
  }
  else if ((methods & M_GO) && !QueryProp(P_GHOST)) {
    SetProp(P_MV, mvp=QueryProp(P_MV)-QueryNeededMv());
    if ((mvp < 250) && !random(3))
      if (mvp < 100) {          // SEHR erschoepft, Meldung mit 33%
        write (EXH_MSG2_ME[random(sizeof(EXH_MSG2_ME))]);
        say (this_object()->Name(WER)+
            EXH_MSG2_ROOM[random(sizeof(EXH_MSG2_ROOM))]);
      }
      else if (!random(2))      // sollen nicht ganz so oft kommen... 17%
        write(EXH_MSG_ME[random(sizeof(EXH_MSG_ME))]);
  }
  return mv;
}

/*** Query-Methoden fuer Froesche... ;^) ***/
string _query_msgin() {
  return QueryProp(P_GHOST) ? "schwebt herein" :
         QueryProp(P_FROG) ? "huepft herein" : Query(P_MSGIN);
}

string _query_msgout() {
  return QueryProp(P_GHOST) ? "schwebt" :
         QueryProp(P_FROG) ? "huepft" : Query(P_MSGOUT);
}
