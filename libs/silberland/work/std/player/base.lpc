nosave void ndead_revive()
{
  string fname;
  int ret;

  set_heart_beat(1);
  ndead_next_check=NETDEAD_CHECK_TIME;
  ndead_currently=0;
  ndead_lasttime=0;
  if (!objectp(ndead_location))
    if (sizeof(explode(ndead_l_filename,"#"))==1)
    {
      catch(call_other(ndead_l_filename,"???"));
      ndead_location=find_object(ndead_l_filename);
    } else
    {
      ndead_location=find_object(ndead_l_filename);
      if (!ndead_location && env_ndead_info)
      {
        fname=explode(ndead_l_filename,"#")[0];
        call_other(fname,"?");
        ndead_location=(find_object(fname)->SetProp(P_NETDEAD_INFO,
                                                    env_ndead_info));
      }
    }
  if (!objectp(ndead_location) ||
      catch(ret = move(ndead_location,M_GO|M_NOCHECK)) || ret != 1 )
  {
    move("gilden/abenteurer",M_GO|M_NOCHECK|M_SILENT);
    catch(move(ndead_location,M_GO|M_NOCHECK,"zurueck ins Leben"));
    ndead_location = environment();
  }
  /* (now only in Reconnect() - woody, 2004-03-30)
  catch(ndead_location->BecomesNetAlive(ME));
  catch(map_objects(all_inventory(ndead_location) + deep_inventory(ME),
                    "BecomesNetAlive", ME));
  */

  // ndead_location = 0;        // needed in Reconnect()
  ndead_l_filename = 0;
  env_ndead_info = 0;
}

nosave void ndead_move_me()
{
  set_heart_beat(0);
  stop_heart_beats();
  if (QueryGuest())
  {
    quit();
    if (ME) remove();
    if (ME) destruct(ME);
    return;
  }
  ndead_next_check=NETDEAD_CHECK_TIME;
  ndead_currently=1;
  ndead_lasttime=0;
  ndead_location=environment();
  if (objectp(ndead_location))
    ndead_l_filename=file_name(ndead_location);
  if (sizeof(explode(file_name(environment()),"#")))
    env_ndead_info=environment()->QueryProp(P_NETDEAD_INFO);
  else
    env_ndead_info=0;
  disable_commands();
  ndead_disabled=time();        // genaue Uhrzeit von disable_commands()
  move(NETDEAD_ROOM,M_GO|M_NO_ATTACK|M_NOCHECK,"ins Reich der Netztoten");
}

int QueryGuest()
{
  string dummy;
  return sscanf(getuid(),"gast%d",dummy);
}

int disconnect(string str)
{
  string verb;

  verb=query_verb();
  if (!verb)
    verb="AUTOCALL";
  if (verb[0..5]=="schlaf" && str!="ein")
  {
    notify_fail(
"\"schlafe ein\" beendet Deine Verbindung mit "+MUDNAME+". Du behaeltst Deine"
"\nSachen, aber Vorsicht: Wenn "+MUDNAME+" abstuerzt, waehrend Du weg bist,"
"\nverlierst Du sie doch, genauso, als wenn Du Deine Verbindung mit \"ende\""
"\nbeendet haettest (allerdings bekommst Du dann eine finanzielle "
"Entschaedigung).\n"
"ABER: BENUTZUNG AUF EIGENE GEFAHR !!!\n");
    return 0;
  }
  if (IS_LEARNER(this_object()) || QueryGuest())
    return quit();
  write(
"Dieser Befehl beendet Deine Verbindung mit "+MUDNAME+". Du behaeltst Deine"
"\nSachen, aber Vorsicht: Wenn "+MUDNAME+" abstuerzt, waehrend Du weg bist,"
"\nverlierst Du sie doch, genauso, als wenn Du Deine Verbindung mit \"ende\""
"\nbeendet haettest (allerdings bekommst Du dann eine finanzielle "
"Entschaedigung).\n"
"ABER: BENUTZUNG AUF EIGENE GEFAHR !!!\n");
  if (is_clone(environment()) && !environment()->QueryProp(P_NETDEAD_INFO))
    write("\nACHTUNG: Wenn Du hier laenger als ETWA 10 Minuten schlaefst, "
        "kommst Du nicht\nan diesen Ort zurueck !\n");
  say(Name()+" hat gerade die Verbindung zum "+MUDNAME+" gekappt.\n");
  remove_interactive(ME);
  return 1;
}

nosave int finger (string str)
{
  string ret;
  mixed xname;
  int flags;

  notify_fail("Du solltest schon angeben, fuer wen Du Dich interessierst!\n");
  if (!str) return 0;
  xname = explode(str," ");
  flags = (member(xname, "-n") != -1) * FF_NOPLAN +
          (member(xname, "-f") != -1) * FF_NOFAMILY +
          (member(xname, "-w") != -1) * FF_NOWIZARD +
          (member(xname, "-m") != -1) * FF_NOMISC +
          (member(xname, "-s") != -1) * FF_NOLONG;
  xname -= ({ "-n","-f","-w","-m","-s" });
  if (sizeof(xname) != 1)
  {
    write("finger <spielername> oder finger <spielername@mudname>\n"+
      "Bitte nur den reinen Spielernamen verwenden, keine "
      "Namensvorsaetze oder Titel.\n");
    return 1;
  }
  xname=explode(xname[0],"@");
  if(sizeof(xname)==2)
  {
    if (ret = INETD->send_udp(xname[1],
          ([ REQUEST: "finger",
             SENDER:  getuid(ME),
             DATA:    xname[0] ]), 1))
      write(ret);
        else
      write("Anfrage an '"+xname[1]+"' abgeschickt.\n");
    return 1;
  }
  More(FINGERD->finger_single(xname[0],0,flags));
  return 1;
}

string lalign(string str, int wid)
{
  return (str+"                                                   "+
      "                                                   ")[0..wid-1];
}

#define MUDS_BAR "\
-------------------------------------------------------------------------------"

private void format(mixed mud, mixed hosts, string output)
{
  output += lalign(hosts[mud][HOST_NAME], 20) + "  " +
        (hosts[mud][HOST_STATUS] ?
           hosts[mud][HOST_STATUS] > 0 ?
             "UP       " + ctime(hosts[mud][HOST_STATUS])[4..15] :
             "DOWN     " + ctime(-hosts[mud][HOST_STATUS])[4..15]
         : "UNKNOWN  Never accessed.") + "\n";
}

nosave int muds() {
  mapping hosts;
  int i;
  mixed muds, output;

  output = lalign("Mudname", 20) + "  Status   Last access";
  output += "\n" + MUDS_BAR[0..strlen(output)] + "\n";
  muds = sort_array(m_indices(hosts = INETD->query("hosts")),#'>);
  map_array(muds, #'format, hosts, &output);
  More(output);
  return 1;
}

// **** local property methods

nosave int _set_level(int i)
{
  if (intp(i) && (i >= 1))
    return Set(P_LEVEL, i);
  else
    return -1;
}

/* sets the terminal type */
/* note: support vt100 (b/w), ansi (color), dumb (none) */
nosave string _set_tty(string str) {
  if(str != "dumb" && str != "vt100" && str != "ansi")
    return Query(P_TTY);
  return Set(P_TTY, str);
}

nosave int stty(string str)
{
  if (str!="dumb"&&str!="vt100"&&str!="ansi"&&str!="reset")
  {
    write("Syntax: stty dumb|vt100|ansi oder reset\n");
  }
  if(str == "reset") {
    printf("\e[30;47m\e[0mDieser Text sollte lesbar sein!\n");
    return 1;
  }
  write("TTY steht jetzt auf "+SetProp(P_TTY,str)+".\n");
  if(str == "ansi" || str == "vt100") {
      printf("Terminal Test:\n");
      printf("VT100: \e[1mfett\e[0m \e[4munterstrichen\e[0m "+
             "\e[5mblinkend\e[0m \e[7minvers\e[0m\n");
      if(str == "ansi") {
          int fg, bg;
          printf("ANSI Farben und VT100 Attribute:\n");
          for(fg = 30; fg <= 37; fg++) {
              for(bg = 40; bg <= 47; bg++) {
                  printf("\e[%d;%dm\e[1m@\e[0m", fg, bg);
                  printf("\e[%d;%dm\e[4m@\e[0m", fg, bg);
                  printf("\e[%d;%dm\e[5m@\e[0m", fg, bg);
                  printf("\e[%d;%dm\e[7m@\e[0m", fg, bg);
              }
              printf("\n");
          }
          printf("Sollte dieser Text hier nicht richtig lesbar\n"
                 "sein, benutze das Kommando stty reset!\n");
      }
  }
  return 1;
}

int set_ascii_art(string str)
{
  if (str=="ein" || str=="an") {
    SetProp(P_NO_ASCII_ART, 0);
    printf("Zukuenftig moechtest Du ASCII-Grafiken sehen.\n");
  }
  else if (str=="aus") {
    SetProp(P_NO_ASCII_ART, 1);
    printf("Zukuenftig moechtest Du KEINE ASCII-Grafiken mehr sehen.\n");
  }
  else {
     printf("Du moechtest "+(QueryProp(P_NO_ASCII_ART) ? "KEINE ":"")+
                     "ASCII-Grafiken sehen.\n");
  }
  return 1;
}

nosave int anzeige(string str)
{
  string s1;
  int n;

  if ((!str) || (str==""))
  {
    write ("Aktuelle Einstellung der Anzeige:\n");
    switch (n = QueryProp(P_COLUMN_MODE))
    {
      case 0:
        write("Objekte werden untereinander angezeigt und");
        break;
      case 1:
        write("Objekte werden in Spalten angezeigt und");
        break;
      default:
        write("Ueber " + (n == 2 ? 6 : n) +
              " Objekte werden in Spalten angezeigt, es wird");
    }
    write ((QueryProp(P_SHORTINV) ? " immer" : " nie") + " gruppiert.\n");

    write ("Du siehst " + (QueryProp(P_BRIEF)&BRIEF_TITLE ? "Presay und Titel":
          "Rasse und Gildentitel") + " bei anderen Spielern.\n");

    return 1;
  }

  if (sscanf(str, "spalten%s",s1) == 1)
  {
    if (s1 == (" " + to_string(n = to_int(s1))))
    {
      if (n <= 2)
        write("Unzulaessiger Wert (nur Werte groesser 2 erlaubt)!\n");
      else
      {
        write("Ok, mehr als " + n + " Objekte "
              "werden jetzt automatisch in Spalten angezeigt.\n");
        SetProp(P_COLUMN_MODE, n);
      }
    }
    else switch (s1)
    {
      case "":
      case " ein":
        write("Ok, Objekte werden jetzt in Spalten angezeigt.\n");
        SetProp(P_COLUMN_MODE, 1);
        break;
      case " aus":
        write("Ok, Objekte werden jetzt untereinander angezeigt.\n");
        SetProp(P_COLUMN_MODE, 0);
        break;
      case " auto":
        write("Ok, mehr als 6 Objekte "
              "werden jetzt automatisch in Spalten angezeigt.\n");
        SetProp(P_COLUMN_MODE, 6);
        break;
      default:
        write("anzeige spalten [ein | aus | auto | <zeilen>]\n");
    }
  }
  else if (sscanf(str, "gruppieren%s", s1) == 1)
  {
    switch (s1)
    {
      case "":
      case " ja":
      case " ein":
        write("Ok, Objekte werden jetzt gruppiert.\n");
        SetProp(P_SHORTINV, 1);
        break;
      case " nein":
      case " aus":
        write("Ok, Objekte werden nicht gruppiert.\n");
        SetProp(P_SHORTINV, 0);
        break;
      default:
        write("anzeige gruppieren [ja | nein]\n");
    }
  }
  else if (str == "rasse")
  {
    SetProp(P_BRIEF, QueryProp(P_BRIEF) - (QueryProp(P_BRIEF)&1024) );
    write ("Du siehst jetzt Rasse und Gildentitel bei anderen Spielern.\n");
  }
  else if (str == "titel")
  {
    SetProp(P_BRIEF, QueryProp(P_BRIEF) | 1024);
    write ("Du siehst jetzt Presay und Titel bei anderen Spielern.\n");
  }
  else
    write(
        "Syntax:\n"
        "anzeige gruppieren [ja | nein]\n"
        "anzeige spalten [ein | aus | auto | <zeilen>]\n"
        "anzeige rasse | titel\n");

  return 1;
}

// XxXxXxXxXx

int more(string str)
{
  if(!str)
  {
    notify_fail("Usage: more <file>\n");
    return 0;
  }
  if (file_size(str) <= 0) {
    notify_fail(str+": No such file\n");
    return 0;
  }
  More(str, 1);
  return 1;
}

nosave int set_screensize(string str)
{
  int size;

  if (str && member( (["abs","rel","bei"]), str[0..2] )) {
    size = QueryProp(P_MORE_FLAGS);
    if ("beides"[0..strlen(str)-1] == str) {
      size |= E_ABS|E_ABS2;
      write("Ok, beim Prompt werden Zeilenzahl und prozentualer Anteil "
          "des Textes angegeben.\n");
    }
    else if ("absolut"[0..strlen(str)-1] == str) {
      size &= ~E_ABS2; size |= E_ABS;
      write("Ok, beim Prompt wird die Zeilenzahl des Textes angegeben.\n");
    }
    else if ("relativ"[0..strlen(str)-1] == str) {
      size &= ~(E_ABS | E_ABS2);
      write("Ok, beim Prompt wird der prozentuale Anteil des Textes "
          "angegeben.\n");
    }
    else {
      write("Ungueltiger Wert! "
          "Erlaubt sind 'absolut', 'relativ' oder 'beides'.\n");
      return 1;
    }
    SetProp(P_MORE_FLAGS, size);
    return 1;
  }
  if (str && (str=="auto" || sscanf(str,"auto %d",size)))
  {
    if (size>0) {
      write("Ungueltiger Wert! "
          "In Verbindung mit 'auto' sind nur negative Werte erlaubt.\n");
      return 1;
    }
    SetProp(P_SCREENSIZE,size-1);
    write("Ok, Deine Zeilenzahl wird nun automatisch ermittelt (derzeit "+
        QueryProp(P_SCREENSIZE)+").\n"+
        break_string("Bitte beachte, dass dies nur einwandfrei funktioniert, "
          "wenn Dein Client Telnetnegotiations unterstuetzt (siehe auch "
          "\"hilfe telnegs\")."));
    return 1;
  }
  if (!str || str=="" || !sscanf(str,"%d",size) || size<0 || size>100)
  {
    write(sprintf("Deine aktuelle Einstellung ist %d%s Zeilen (%s).\n",
            QueryProp(P_SCREENSIZE),
            Query(P_SCREENSIZE) < 0 ? " 'automatische'" : "",
            QueryProp(P_MORE_FLAGS) & E_ABS2 ? "absolut und relativ" :
            QueryProp(P_MORE_FLAGS) & E_ABS ? "absolut" : "relativ"));
    return 1;
  }
  SetProp(P_SCREENSIZE,size);

  printf("Ok, Deine Zeilenzahl steht nun auf %d.\n",size);
  return 1;
}

nosave int set_screenwidth(string str)
{
  int width;

  if (str && (str=="auto" || sscanf(str,"auto %d",width)))
  {
    if (width>0) {
      write("Ungueltiger Wert! "
          "In Verbindung mit 'auto' sind nur negative Werte erlaubt.\n");
      return 1;
    }
    SetProp(P_SCREENWIDTH,width-1);
    write("Ok, Deine Zeilenlaenge wird nun automatisch ermittelt (derzeit "+
        QueryProp(P_SCREENWIDTH)+").\n"+
        break_string("Bitte beachte, dass dies nur einwandfrei funktioniert, "
          "wenn Dein Client Telnetnegotiations unterstuetzt (siehe auch "
          "\"hilfe telnegs\")."));
    return 1;
  }
  if (!str || str=="" || !sscanf(str,"%d",width) || width<78 || width>250)
  {
    write(sprintf("Deine aktuelle Einstellung ist %d%s Zeilenlaenge.\n",
            QueryProp(P_SCREENWIDTH),
            Query(P_SCREENWIDTH) < 0 ? " 'automatische'" : ""));
    return 1;
  }
  SetProp(P_SCREENWIDTH,width);

  printf("Ok, Deine Zeilenlaenge steht nun auf %d.\n",width);
  return 1;
}

nosave int presay(string str)
{
  if( strlen(_unparsed_args()) > 35 )
  {
    write("Das ist leider zu lange.\n");
    return 1;
  }
  if( strlen(_unparsed_args()) + strlen(QueryProp(P_TITLE)) > 65  )
  {
    write("Zusammen mit Deinem Titel ist das leider zu lange.\n");
    return 1;
  }
  if (!str=_unparsed_args())
    write("Dein Presay ist jetzt geloescht.\n");
  else
    printf("Dein Presay lautet jetzt: \"%s\".\n",str=capitalize(str));
  SetProp(P_PRESAY,str);
  write(short());
  return 1;
}

nosave int sethands(string str)
{
  mixed *hands;

  if (!(str=_unparsed_args()))
  {
    write("sethands <message>\n");
    return 1;
  }
  if (str=="0")
    hands=RaceDefault(P_HANDS);
  if (!hands || !pointerp(hands))
    hands=Query(P_HANDS);
  hands[0]=" "+str;
  Set(P_HANDS,hands);
  write("Ok.\n");
  return 1;
}

nosave int inform(string str)
{
  int inf;

  inf=Query(P_INFORMME);
  switch (str) {
    case "on":
    case "ein":
    case "an":
      if (inf & IF_INFORMME) {
        write("Inform ein war schon eingestellt!\n");
      }
      else
      {
        write("Kuenftig wirst Du informiert, wenn jemand das "+MUDNAME+" "
              "verlaesst/betritt.\n");
        Set(P_INFORMME,inf | IF_INFORMME);
      }
      return 1;
    case "aus":
    case "off":
      if (!(inf & IF_INFORMME)) {
        write("Inform aus war schon eingestellt!\n");
      }
      else
      {
        write("Ok, ab jetzt wirst Du nicht mehr informiert.\n");
        Set(P_INFORMME,inf & ~IF_INFORMME);
      }
      return 1;
    case "+ip":
    case "+showip":
      if (!IS_LEARNER(this_object())) break;
      if (inf & IF_SHOWIP) {
        write("Inform +ip war schon eingestellt!\n");
      }
      else
      {
        write("Ab sofort siehst Du zusaetzlich die IP der einloggenden "
              "Spieler.\n");
        Set(P_INFORMME,inf | IF_SHOWIP);
      }
      return 1;
    case "-ip":
    case "-showip":
      if(!IS_LEARNER(this_object())) break;
      if (!(inf & IF_SHOWIP)) {
        write("Inform -ip war schon eingestellt!\n");
      }
      else
      {
        write("Ab sofort siehst Du die IP der einloggenden Spieler "
              "nicht mehr.\n");
        Set(P_INFORMME,inf & ~IF_SHOWIP);
      }
      return 1;
    case "+race":
    case "+rasse":
      if(inf & IF_SHOWRACE) {
        write("Inform +race war schon eingestellt!\n");
      }
      else
      {
        write("Ab sofort siehst Du zusaetzlich die Rasse der einloggenden "
              "Spieler.\n");
        Set(P_INFORMME,inf | IF_SHOWRACE);
      }
      return 1;
    case "-race":
    case "-rasse":
      if(!(inf & IF_SHOWRACE)) {
        write("Inform -race war schon eingestellt!\n");
      }
      else
      {
        write("Ab sofort siehst Du die Rasse der einloggenden Spieler "
              "nicht mehr.\n");
        Set(P_INFORMME, inf & ~IF_SHOWRACE);
      }
      return 1;
    case "+clone":
    case "+clones":
    case "+names":
    case "+namen":
      if(!IS_LEARNER(this_object())) break;
      if(inf & IF_SHOWCLONES) {
        write("Inform +names war schon eingestellt!\n");
      }
      else
      {
        write("Ab sofort siehst Du zusaetzlich alle Spieler, die von derselben\n"
              "IP Adresse des einloggenden Spielers kommen.\n");
        Set(P_INFORMME,inf | IF_SHOWCLONES);
      }
      return 1;
    case "-clone":
    case "-clones":
    case "-names":
    case "-namen":
      if(!IS_LEARNER(this_object())) break;
      if(!(inf & IF_SHOWCLONES)) {
        write("Inform -names war schon eingestellt!\n");
      }
      else
      {
        write("Ab sofort siehst Du die Spieler mit der gleichen IP Adresse "
              "nicht mehr.\n");
        Set(P_INFORMME, inf & ~IF_SHOWCLONES);
      }
      return 1;
    case 0:
      write("Inform-Mode ist "+((inf & IF_SHOWRACE)?"mit":"ohne")+" Rasse "+
           ((inf & IF_INFORMME)?"ein":"aus")+"geschaltet.\n");
      if(IS_LEARNER(this_object()) && (inf & IF_SHOWIP))
        write("Zusaetzlich bekommst Du die IP mit angezeigt.\n");
      if(IS_LEARNER(this_object()) && (inf & IF_SHOWCLONES))
        write("Zusaetzlich bekommst Du die Spieler mit gleicher IP "+
              "mit angezeigt.\n");
      return 1;
    }
  write("Syntax: inform 'an' , 'aus' , '+race' , '-race' , bitte.\n");
  return 1;
}

void delayed_write(mixed *what)
{
  if (!pointerp(what)||!sizeof(what)||!pointerp(what[0]))
    return;
  tell_object(ME,what[0][0]);
  if (sizeof(what)>1&&sizeof(what[0])>1)
    call_out("delayed_write",what[0][1],what[1..]);
}

varargs void notify_player_change(string who, int rein, int invis,
                                  string ip, string race, string cloneip)
{
  string *list;
  string bon,boff;
  int inf;

  if (QueryProp("tty")!="dumb")
  {
    bon = ANSI_BLINK;
    boff = ANSI_NORMAL;
  }

  // 'inform' handlen
  if ((inf=Query(P_INFORMME)) & IF_INFORMME)
  {
    if (rein==1)
      tell_object(ME,
          break_string(sprintf(
              "%s%s ist gerade %sins "+MUDNAME+" gekommen.%s%s",
              (inf & IF_SHOWRACE) && stringp(race) ? race+" ":"",
              who,
              (invis ? bon+"UNSICHTBAR"+boff+" " : ""),
              (inf & IF_SHOWIP) && stringp(ip) ? " ["+ip+"]" : "",
              (inf & IF_SHOWCLONES) && stringp(cloneip) ?
                " ("+(strlen(cloneip) ? cloneip : "-")+")" :""),
            (QueryProp(P_TTY_COLS) || 80)-2));
    else if (rein)
      tell_object(ME,who+" ist jetzt "+bon+"UNSICHTBAR"+boff+".\n");
    else
      tell_object(ME,who+" hat gerade das "+MUDNAME+" verlassen.\n");
  }

  // 'erwarte' handlen
  if (pointerp(list=Query(P_WAITFOR)) && sizeof(list))
  {
    if (member(list,who)!=-1)
      if (rein==-1)
        if (QueryProp(P_NO_ASCII_ART))
          tell_object(ME, "\a"+who+" IST JETZT UNSICHTBAR !!!\n");
        else
          tell_object(ME, "\a"+who+"   I S T   J E T Z T   "+
              bon+"U N S I C H T B A R"+boff+" !!!\n");
      else
        if (QueryProp(P_NO_ASCII_ART))
          tell_object(ME, sprintf("\a%s IST JETZT %s%sDA !!!\n",
              who,
              (rein ? "" : "NICHT MEHR "),
              (invis&&rein ? "UNSICHTBAR " : "")));
        else
          tell_object(ME, sprintf("\a%s   I S T   J E T Z T   %s%sD A !!!\n",
              who,
              (rein ? "" : "N I C H T   M E H R   "),
              (invis&&rein?bon+"U N S I C H T B A R   "+boff:"")));
  }
}

nosave int erwarte(string str)
{
  string *list, erw, *nlist;
  int i;

  list=Query(P_WAITFOR);
  if (str && str!="-u")
  {
    string *dazu, *weg;
    erw="";
    dazu=weg=({});
    str=lower_case(str);
    nlist=explode(str," ")-({"und"," ","",","});
    nlist=sort_array(m_indices(mkmapping(nlist)),#'>);
    if (sizeof(nlist) > MAX_WAITFOR) nlist=nlist[0..MAX_WAITFOR-1];
    if (!pointerp(list=Query(P_WAITFOR))) list=({});
    for (i=0; i<sizeof(nlist); i++)
    {
      if (str[<1]==',') str=str[0..<2];
      str=capitalize(nlist[i]);
      if (member(list,str)!=-1) {
        list-=({str}); weg+=({str});
      } else {
        list+=({str}); dazu+=({str});
      }
    }
    if (sizeof(list) > MAX_WAITFOR) {
      dazu -= list[MAX_WAITFOR..];
      list = list[0..MAX_WAITFOR-1];
      erw = "Deine Erwarte-Liste hat das erlaubte Maximum erreicht!\n";
    }
    if (sizeof(dazu))
      erw+=CountUp(dazu)+" an die Liste angehaengt. ";
    if (sizeof(weg))
      erw+=CountUp(weg)+" aus der Liste entfernt.";
    if (!sizeof(list))
      erw+=" Du erwartest jetzt niemanden mehr.";
    Set(P_WAITFOR,list);
  } else {
    erw="Du erwartest derzeit";
    if (!pointerp(list)||!sizeof(list))
      erw+=" niemanden.";
    else
      erw+=":\n"+implode(str!="-u" ? sort_array(list,#'>) : list, ", ")+".";
  }
  write(break_string(erw, 78, 0, 1));
  return 1;
}

nosave int uhrmeldung(string str)
{
  string *tmp;

  if (!(str=_unparsed_args()))
  {
    str=QueryProp(P_CLOCKMSG);
    if (!str)
    {
      write("Du hast die Standard-Uhrmeldung.\n");
      return 1;
    }
    if( !stringp(str) ) str = sprintf("%O\n",str);
    tmp = efun::explode(str,"%d");
    tmp[0] = regreplace(tmp[0],"%%","%",1);
    tmp[1] = regreplace(tmp[1],"%%","%",1);
    str=implode(tmp,"%d");
    printf("Deine Uhrmeldung ist:\n\"%s\"\n",str[0..<2]);
    return 1;
  }
  if (str=="0")
  {
    SetProp(P_CLOCKMSG,0);
    write("Ok, Du hast jetzt wieder die Standard-Meldung.\n");
    return 1;
  }
  tmp = efun::explode(str,"%d");
  if (sizeof(tmp) > 2) {
    write("Fehler, es darf nur ein %d in der Uhrmeldung vorkommen!\n");
    return 1;
  }
  else if (sizeof(tmp) < 2) {
    write("Fehler, es muss mindestens ein %d in der Uhrmeldung vorkommen!\n");
    return 1;
  }
  tmp[0] = regreplace(tmp[0],"%","%%",1);
  tmp[1] = regreplace(tmp[1],"%","%%",1);
  str=implode(tmp,"%d")+"\n";
  SetProp(P_CLOCKMSG,str);
  write("Ok, neue Uhrmeldung wurde gesetzt.\n");
  return 1;
}

nosave int muduptime()
{
  write ("Letzter Reboot: "+dtime(last_reboot_time())+",\n");
  write ("Uptime: "+uptime()+".\n");
  return 1;
}

nosave int raste()
{
  string norest;

  if (QueryProp(P_RESTING))
    write("Aber Du rastest doch schon!\n");
  else if (QueryProp(P_GHOST))
    write("Als Geist kannst Du nicht rasten oder Ruhe finden!\n");
  else if (environment() && (norest=environment()->QueryProp(P_NOREST))) {
    if (stringp(norest))
      write(norest);
    else
      write("Du kannst an diesem Ort nicht rasten.\n");
    return 1;
  }
  else if (InFight())
    write("Im Kampf kannst Du nicht rasten!\n");
  else if (time() < QueryProp(P_LAST_AWAKE_TIME) + 300)
    write("Du hast Dich doch erst unlaengst ausgeruht!\n");
  else {
    write("Du schliesst die Augen und rastest ein wenig. Tut das gut...\n");
    SetProp(P_RESTING, time());
    call_out("wache", 90, "auf");
  }
  return 1;
}

nosave int wache(string str)
{
  if (str!="auf") return 0;
  if (!QueryProp(P_RESTING))
    return _notify_fail("Aber Du rastest doch gar nicht!\n"), 0;
  while (remove_call_out("wache") != -1);
  if (find_call_out("wache2") != -1)
    return write("Gedulde Dich doch ein wenig!\n"), 1;
  if (QueryProp(P_GHOST)) {
    write("Etwas zu spaet wachst Du wieder auf...\n");
    SetProp(P_RESTING, 0);
    SetProp(P_LAST_AWAKE_TIME, time());
    return 1;
  }
  write("Nach und nach wirst Du wieder munter.\n");
  call_out("wache2", 10);
  return 1;
}

nosave void wache2()
{
  if (!QueryProp(P_GHOST))
    write("Frisch erholt erhebst Du Dich.\n");
  SetProp(P_RESTING, 0);
  SetProp(P_LAST_AWAKE_TIME, time());
}

nosave int pluendern(string str)
{
  if( str == "ein" || str == "ja" )
  {
    write("Du pluenderst jetzt alle Leichen.\n");
    SetProp(P_LOOTING, 1);
  }
  else if( str == "aus" || str == "nein" )
  {
    write("Du pluenderst jetzt keine Leichen mehr.\n");
    SetProp(P_LOOTING, 0);
  }
  else
  {
    write("Du pluenderst zur Zeit "+( QueryProp(P_LOOTING) ? "alle" : "keine" )+
         " Leichen.\n");
    write("Umschalten mit 'pluendern <ein|aus>.\n");
  }
  return 1;
}

nosave int zweitiemarkierung(string arg)
{
  if (!QueryProp(P_SECOND))
    return _notify_fail("Aber Du bist doch gar kein Zweitspieler.\n"), 0;

  notify_fail("Syntax: zweitiemarkierung [unsichtbar|sichtbar|name]\n");
  switch (arg)
  {
    case "unsichtbar":
      SetProp(P_SECOND_MARK, -1);
      write("Jetzt sieht kein Spieler mehr, dass Du ein Zweitspieler bist.\n");
      return 1;
    case "sichtbar":
      SetProp(P_SECOND_MARK, 0);
      write("Jetzt sieht kein Spieler mehr, wessen Zweitspieler Du bist.\n");
      return 1;
    case "name":
      SetProp(P_SECOND_MARK, 1);
      write("Jetzt koennen alle sehen, wessen Zweitspieler Du bist.\n");
      return 1;
  }
  return 0;
}

nosave int emailanzeige(string str)
{
  int wem;

  notify_fail("Syntax: emailanzeige [alle|freunde|niemand]\n");

  if (!str || str=="")
  {
    str = ([ 0 : "niemandem",
             1 : "Deinen Freunden",
             2 : "allen" ])[QueryProp(P_SHOW_EMAIL)];
    if (!str) {
      SetProp(P_SHOW_EMAIL, 0);
      str = "niemandem";
    }
    write("Deine Email wird " + str + " angezeigt.\n");
    return 1;
  }
  else if (!member((["alle","freunde","niemand"]),str))
    return 0;

  SetProp(P_SHOW_EMAIL, (["niemand":0,"freunde":1,"alle":2])[str]);
  str = (["niemand":"niemandem","freunde":"Deinen Freunden",
          "alle":"allen"])[str];

  write("Deine Email wird ab nun " + str + " angezeigt.\n");
  return 1;
}

nosave int topliste(string arg)
{
  if (!arg)
  {
    printf("Du hast Dich fuer die Topliste %s.\n",
        (QueryProp(P_NO_TOPLIST) ? "gesperrt" : "freigegeben"));
    return 1;
  }
  else if (!member((["j","ja","n","nein"]),arg))
    return _notify_fail("Syntax: topliste [ja|nein]\n"),0;
  if (arg[0]=='j') {
    SetProp(P_NO_TOPLIST,0);
    write("Du wirst ab nun in die Topliste mit aufgenommen.\n");
  } else {
    SetProp(P_NO_TOPLIST,1);
    write("Du wirst jetzt nicht in der Topliste auftauchen.\n");
  }
  write("Bitte beachte, dass diese Aenderungen erst mit der naechsten\n"+
      "automatischen Erstellung der Toplisten aktiv werden.\n");
  return 1;
}

