int _filterattr_con(int i)
{
  if (i<A_MIN) i=A_MIN;
  if (i>A_MAX) i=A_MAX;
  SetProp(P_MAX_HP,42+8*i);
  return i;
}

int _filterattr_int(int i)
{
  if (i<A_MIN) i=A_MIN;
  if (i>A_MAX) i=A_MAX;
  SetProp(P_MAX_SP,42+8*i);
  return i;
}

