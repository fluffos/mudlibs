nosave string _query_auth_info()
{
  mixed auth;

  if (!interactive(ME))
    return Set(P_AUTH_INFO,0);
  if (stringp(auth=Query(P_AUTH_INFO))) return auth;
  if (auth>3) return Set(P_AUTH_INFO,"UNKNOWN");
  MASTER->get_auth_user(ME);
  (void)Set(P_AUTH_INFO,++auth);
  return "NOT YET KNOWN";
}

nosave string _set_auth_info(mixed s)
{
  if (!previous_object(1)||file_name(previous_object(1))[0..7]!="/secure/")
    return 0;
  Set(P_AUTH_INFO,s);
}

string _query_my_ip()
{
  return my_ip;
}

nosave int _query_screensize() {
  int sz,rows;
  if ((sz=Query(P_SCREENSIZE)) >= 0) return sz;
  if (!rows=QueryProp(P_TTY_ROWS)) return 20;
  return (rows+=sz)>=5 ? rows : 5;
}

nosave int _query_screenwidth() {
  int sz,cols;
  if ((sz=Query(P_SCREENWIDTH)) >= 0) return sz;
  if (!cols=QueryProp(P_TTY_COLS)) return 78;
  return (cols+=sz)>=78 ? cols : 78;
}

mixed _set_testplayer(mixed arg) {
  mixed res;
  object setob;

  setob=this_player();
  if (!objectp(setob) || !query_once_interactive(setob))
    setob=this_interactive();
  if (!objectp(setob))
    setob=previous_object();
  if (setob && !IS_ARCH(setob)) {
    arg=geteuid(setob);
    if (!arg || arg=="NOBODY")
      arg=getuid(setob);
    arg=capitalize(arg);
  }
  res=Set(P_TESTPLAYER,arg);
  Set(P_TESTPLAYER,PROTECTED,F_MODE_AS);
  return res;
}

nosave int _check_keep(object ob)
{
  return (ob->QueryProp(P_KEEP_ON_SELL))==geteuid(ME);
}

int behalte(string str)
{
  object *obs, ob;
  string s;
  int alles;

  if (str)
  {
    if ((alles = str=="alles") || str=="nichts")
    {
      obs = filter_objects( all_inventory(ME),"short" );
      if (!sizeof(obs))
      {
        _notify_fail("Wer nichts hat, kann auch nichts behalten :-)\n");
        return 0;
      }
      map_objects( obs, "SetProp", P_KEEP_ON_SELL, alles ? geteuid(ME) : 0);
      if (alles)
        write("Ok, Du behaeltst nun alles bei 'verkaufe alles'.\n");
      else
        write("Ok, Du behaeltst bei 'verkaufe alles' nichts mehr.\n");
      return 1;
    }
    // sonstiges (Filter)
    obs=present_objects(str);
    if (!sizeof(obs))
    {
      _notify_fail("Aber sowas hast Du doch gar nicht dabei!\n");
      return 0;
    }
    if (sizeof(filter_array(obs,#'_check_keep)) != sizeof(obs))
    {
      map_objects(obs, "SetProp", P_KEEP_ON_SELL, geteuid(ME));
      write(break_string("Ok, Du wirst "+CountUp(map_objects(obs,"name",WEN))+
          " jetzt bei 'verkaufe alles' behalten.", 78));
    }
    else
    {
      map_objects(obs, "SetProp", P_KEEP_ON_SELL, 0);
      write(break_string("Ok, Du wirst "+CountUp(map_objects(obs,"name",WEN))+
          " beim naechsten 'verkaufe alles' mitverkaufen!", 78));
    }
    return 1;
  }
  obs=filter_array(all_inventory(ME),#'_check_keep);
  if (!sizeof(obs))
    write("Du hast derzeit nichts zum Behalten markiert!\n");
  else
    More("Du behaeltst bei 'verkaufe alles':\n"+make_invlist(ME,obs));
  return 1;
}

nosave int show_telnegs(string arg)
{
  if (!arg)
  {
    write("Du bekommst Aenderungen Deiner Fenstergroesse "+
          (QueryProp(P_TTY_SHOW)?"":"nicht ")+"angezeigt.\n");
    return 1;
  }
  if (member(({"ein","an","aus"}),arg)==-1)
  {
    write("Syntax: telnegs [ein|aus]\n");
    return 1;
  }
  if (arg=="ein" || arg=="an")
  {
    write("Du bekommst "+(QueryProp(P_TTY_SHOW)?"":"nun ")+
          "Aenderungen Deiner Fenstergroesse angezeigt.\n");
    Set(P_TTY_SHOW,1);
    return 1;
  }
  write("Du bekommst "+(QueryProp(P_TTY_SHOW)?"nun ":"")+
        "Aenderungen Deiner Fenstergroesse nicht "+
        (QueryProp(P_TTY_SHOW)?"mehr ":"")+"angezeigt.\n");
  Set(P_TTY_SHOW,0);
  return 1;
}

private nosave string OrCountUp(string *s)
{
  switch (sizeof(s))
  {
    case 1: return s[0];
    case 2: return s[0]+" oder "+s[1];
    default: return implode(s[0..<2], ", ")+" oder "+s[<1];
  }
}

nosave int reise(string str)
{
  mixed  t, ship, dstr;
  string mit, nach;
  int    i;

  _notify_fail("Syntax: reise [mit <transportmittel>] [nach <zielort>]\n");

  // auto-discard invalid travel infos
  t=QueryProp(P_TRAVEL_INFO);
  if (!pointerp(t) || (sizeof(t) < 4) || !objectp(t[0]) || !objectp(t[1]))
    SetProp(P_TRAVEL_INFO, t=0);

  if (!str)
  {
    if (!t)
      write("Du hast momentan keine Reiseroute eingestellt.\n");
    else if (t[0]==environment())
     if (environment()->id("Transporter"))
       write(sprintf("Du reist gerade mit %s%s.\n",
             environment()->name(WEM,1), t[2] ? " "+t[3] : ""));
     else
       write(sprintf("Du wirst mit %s%s reisen.\n",
             t[1]->name(WEM), t[2] ? " "+t[3] : ""));
    else
       write(break_string(sprintf("Deine zuletzt eingestellte Reiseroute "
             "(mit %s%s) ist hier unwirksam.", t[1]->name(WEM,1),
             t[2] ? " "+t[3]: ""), 78));
    return 1;
  }

  if (str == "route")
  {
    string *harbours;

    if (environment()->id("Transporter"))       // sind wir auf einem Schiff?
    {
      harbours = environment()->QueryHarbours(1);
      write("Reiseroute " + environment()->name(WESSEN,1) + ":\n");
      if (sizeof(harbours))
        write( break_string( implode( harbours, " - " ) + ".", 78 ) );
      else
        write( "unbekannt.\n" );
      return 1;
    }

    if (!pointerp(ship = SHIPD->HasShip(environment())))
      return _notify_fail("Hier verkehren keine Transportmittel!\n"), 0;

    write("Hier verkehren folgende Transportmittel:\n");
    for (i=0; i<sizeof(ship); i++)
    {
      if (!ship[i]->Query(P_SHORT)) continue;
      harbours = ship[i]->QueryHarbours(1);
      if (sizeof(harbours))
        write( break_string( implode( harbours, " - " ) + ".", 78,
              ship[i]->Query(P_SHORT) + ": ", BS_INDENT_ONCE ) );
      else
        write( ship[i]->Query(P_SHORT) + ": Route unbekannt.\n" );
    }
    return 1;
  }

  if (member( (["aus","nicht","abbrechen","beenden","loeschen"]),str ))
  {
    if (!t) write("Aber Du hast ja gar keine Reiseroute eingestellt!\n");
    else write("Du loeschst Deine Reiseroute.\n");
    SetProp(P_TRAVEL_INFO, 0);
    return 1;
  }

  str=regreplace(str,"\\<(zu|zum|zur)\\>","nach",0);
  if (sscanf(str, "mit %s nach %s", mit, nach)==2 ||
      sscanf(str, "nach %s mit %s", nach, mit)==2)
  {
    if (!strlen(nach))
      return _notify_fail("Du solltest schon auch angeben, "
          "wohin Du reisen willst.\n"), 0;

    if (environment()->id("Transporter"))
      if (environment()->id(mit))
        return reise("nach "+nach);
      else
        return _notify_fail("Du solltest erst Deine Reise mit "+
            environment()->name(WEM,1)+" beenden!\n"), 0;

    if (!pointerp(ship = SHIPD->HasShip(environment(), mit)))
      return _notify_fail("So ein Transportmittel verkehrt hier nicht!\n"), 0;

    for (i=sizeof(ship)-1; i>=0; i--)
      if (!ship[i]->HasRoute(nach)) ship[i]=0;
    ship-=({0});

    // bereits gewaehltes Transportmittel bevorzugen
    if (pointerp(t) && objectp(t[1]) && (member(ship,t[1])!=-1))
      ship = ({ t[1] });

    if (sizeof(ship) > 1)
    {
      if (file_name(environment()) == ship[0]->HasRoute(nach)[0])
        return _notify_fail("Aber da bist Du ja bereits!\n"), 0;
      write(break_string("Dahin kannst Du mit "+
            OrCountUp(map_objects(ship, "name", WEM))+" gelangen.", 78));
      // anwesende sichtbare Schiffe bevorzugen
      dstr=filter_array( filter_objects(ship,"short"), lambda( ({'x}),
            ({ #'==, ({#'environment, 'x}), environment() }) ) );
      if (sizeof(dstr))
        ship=dstr[0];
      else
        ship=ship[0];
      dstr=ship->HasRoute(nach);
      write(sprintf("Du waehlst %s und reist %s.\n",
            ship->name(WEN,1),dstr[1]));
    }
    else if (sizeof(ship) < 1)
      return _notify_fail(break_string("Nach \""+capitalize(nach)+
            "\" kann Dich das angegebene Transportmittel leider "
            "nicht bringen!", 78)), 0;
    else
    {
      ship=ship[0];
      dstr=ship->HasRoute(nach);
      if (file_name(environment()) == dstr[0])
        return _notify_fail("Aber da bist Du ja bereits!\n"), 0;
      write(sprintf("Ok, Du reist nun mit %s %s.\n",ship->name(WEM),dstr[1]));
    }

    // Transportmittel ist bereits anwesend :)
    if (environment(ship)==environment() && ship->short())
      ship->Enter(this_object());

    SetProp(P_TRAVEL_INFO, ({ environment(), ship, dstr[0], dstr[1] }) );
    return 1;
  }

  if (sscanf(str, "nach %s", nach))
  {
    if (!strlen(nach))
      return _notify_fail("Du solltest schon auch angeben, "
          "wohin Du reisen willst.\n"), 0;

    if (environment()->id("Transporter"))       // sind wir auf einem Schiff?
    {
      if (!dstr=environment()->HasRoute(nach))
        return _notify_fail("Dorthin kann Dich "+environment()->name(WER,1)+
            " leider nicht bringen!\n"), 0;

      write(sprintf("Ok, Du reist jetzt %s.\n",dstr[1]));
      SetProp(P_TRAVEL_INFO,
          ({ environment(), environment(), dstr[0], dstr[1] }) );

      // Schon am Ziel?
      if (file_name(environment(ship=environment()))==dstr[0] && ship->short())
      {
        environment()->Leave(this_object());
        if (environment()!=ship)
          SetProp(P_TRAVEL_INFO, 0);    // erfolgreich ausgestiegen
      }
      return 1;
    }

    // nicht auf einem Schiff; aber vielleicht an einem Hafen.
    if (!pointerp(ship = SHIPD->HasShip(environment())))
      return _notify_fail("Von hier aus kannst Du nicht reisen!\n"), 0;

    for (i=sizeof(ship)-1; i>=0; i--)
      if (!ship[i]->HasRoute(nach)) ship[i]=0;
    ship-=({0});

    // bereits gewaehltes Transportmittel bevorzugen
    if (pointerp(t) && objectp(t[1]) && (member(ship,t[1])!=-1))
      ship = ({ t[1] });

    if (sizeof(ship) > 1)
    {
      if (file_name(environment()) == ship[0]->HasRoute(nach)[0])
        return _notify_fail("Aber da bist Du ja bereits!\n"), 0;
      write(break_string("Dahin kannst Du mit "+
            OrCountUp(map_objects(ship, "name", WEM))+" gelangen.", 78));
      // anwesende sichtbare Schiffe bevorzugen
      dstr=filter_array( filter_objects(ship,"short"), lambda( ({'x}),
            ({ #'==, ({#'environment, 'x}), environment() }) ) );
      if (sizeof(dstr))
        ship=dstr[0];
      else
        ship=ship[0];
      dstr=ship->HasRoute(nach);
      write(sprintf("Du waehlst %s und reist %s.\n",
            ship->name(WEN,1),dstr[1]));
    }
    else if (sizeof(ship) < 1)
      return _notify_fail(break_string("Nach \""+capitalize(nach)+
            "\" kann Dich leider keines der hier verkehrenden "
            "Transportmittel bringen!", 78)), 0;
    else  // sizeof(ship) == 1
    {
      ship=ship[0];
      dstr=ship->HasRoute(nach);
      if (file_name(environment()) == dstr[0])
        return _notify_fail("Aber da bist Du ja bereits!\n"), 0;
      write(sprintf("Ok, Du reist nun mit %s %s.\n",ship->name(WEM),dstr[1]));
    }

    // Transportmittel ist bereits anwesend :)
    if (environment(ship)==environment() && ship->short())
      ship->Enter(this_object());

    SetProp(P_TRAVEL_INFO, ({ environment(), ship, dstr[0], dstr[1] }) );
    return 1;

  }   // if (sscanf(str, "nach %s", nach)) ...

  if (sscanf(str, "mit %s", mit))
  {
    if (!strlen(mit))
      return _notify_fail("Du solltest schon auch angeben, "
          "womit Du reisen willst.\n"), 0;

    if (environment()->id("Transporter"))
      if (environment()->id(mit))
        return _notify_fail("Aber das tust Du doch bereits!\n"), 0;
      else
        return _notify_fail("Du solltest erst Deine Reise mit "+
            environment()->name(WEM,1)+" beenden!\n"), 0;

    if (!pointerp(ship = SHIPD->HasShip(environment(), mit)))
      return _notify_fail("So ein Transportmittel verkehrt hier nicht!\n"), 0;

    if (sizeof(ship) > 1)
    {
      write(break_string(capitalize(mit)+" koennte "+
            OrCountUp(map_objects(ship, "name", WER))+" sein.", 78));
      // anwesende sichtbare Schiffe bevorzugen
      dstr=filter_array( filter_objects(ship,"short"), lambda( ({'x}),
            ({ #'==, ({#'environment, 'x}), environment() }) ) );
      if (sizeof(dstr))
        ship=dstr[0];
      else
        ship=ship[0];
      write(sprintf("Du waehlst %s.\n", ship->name(WEN,1)));
    }
    else if (sizeof(ship) < 1)
      return _notify_fail("So ein Transportmittel verkehrt hier nicht!\n"), 0;
    else  // sizeof(ship) == 1
    {
      ship=ship[0];
      write(sprintf("Ok, Du reist nun mit %s.\n",ship->name(WEM)));
    }

    // Transportmittel ist bereits anwesend :)
    if (environment(ship)==environment() && ship->short())
      ship->Enter(this_object());

    // Bisher gesetztes Reiseziel, wenn moeglich, beibehalten.
    if (pointerp(t) && stringp(t[2]) && stringp(t[3]) &&
        (member(ship->QueryHarbours(),t[2])!=-1))
    {
      write("Dabei behaeltst Du Dein bisheriges Reiseziel ("+
          t[3]+") bei.\n");
      SetProp(P_TRAVEL_INFO, ({ environment(), ship, t[2], t[3] }) );
    }
    else
      SetProp(P_TRAVEL_INFO, ({ environment(), ship, 0, 0 }) );

    return 1;

  }   // if (sscanf(str, "mit %s", mit)) ...

  return 0;
}

nosave string UnANSI(string str)
{
  if (stringp(str))
    return regreplace(str, "(\e\\[[0-9]*[HJm])|\a", "", 1);
  else
    return str;
}

private nosave string cleanup_short(string str)
{
  // Erst \n und trailing '.' raus
  str = regreplace(str, "\n", "", 1);
  // Dann sooft wie moeglich 'x\b' entfernen
  while (str != (str = regreplace(str, "[^\b]\b", "", 1)));
  // Alle uebrig gebliebenen '\b' und ANSI Sequenzen fliegen raus
  return UnANSI(regreplace(str, "\b", "", 1));
}

int einstellungen()
{
  string *msg;
  int brief, n, i;
  string anzeige, anzeige2, kampf, ersetzung, showemail;
  mapping m;

  switch (n=QueryProp (P_COLUMN_MODE)) {
    case 0: anzeige = "Objekte werden untereinander angezeigt und"; break;
    case 1: anzeige = "Objekte werden in Spalten angezeigt und"; break;
    default: anzeige = ("Ueber " + (n == 2 ? 6 : n)+
                 " Objekte in Spalten angezeigt und");
  }
  anzeige+=(QueryProp(P_SHORTINV) ? " immer" : " nie") + " gruppiert.";
  anzeige2 = "Du siehst " + (QueryProp(P_BRIEF)&BRIEF_TITLE ?
      "Presay und Titel": "Rasse und Gildentitel") + " bei anderen Spielern.";

  brief=QueryProp(P_BRIEF) & BRIEF_FMASK;
  kampf="Angriffsmeldungen "+((brief & BRIEF_FNOATTACK) ? "nicht " : "")+
        "angezeigt, Schadensmeldungen "+ ((brief & BRIEF_FNODAMAGE)
        ? (brief & BRIEF_FNOATTACK ? "auch " : "")+"nicht."
        : (brief & BRIEF_FNOATTACK ? "schon." : "auch."));
  if( brief & BRIEF_FNODAMAGE && brief & BRIEF_FNOATTACK )
    kampf="Angriffsmeldungen und Schadensmeldungen nicht angezeigt.";

  switch (QueryProp(P_SHOW_ALIAS_PROCESSING))
  {
    case 0: ersetzung = "Aus"; break;
    case 1: ersetzung = "History"; break;
    case 2: ersetzung = "Alias"; break;
  }
  switch (QueryProp(P_SHOW_EMAIL))
  {
    case 0: showemail = " (Niemand)"; break;
    case 1: showemail = " (Freunde)"; break;
    case 2: showemail = " (Alle)"; break;
  }
  write( "+----------------------------------------------------------+---------------+\n");
  printf("| %-56s | Einstellungen |\n",(short()?cleanup_short(short()):
        capitalize(getuid(this_object())))[0..55]);
  if( IS_SEER(this_object()) ) {
    write( "+----------------------------------------------------------+---------------+\n");
    printf( "| mout:  %-65s |\n"
        "| min:   %-65s |\n"
        "| mmout: %-65s |\n"
        "| mmin:  %-65s |\n",
        cleanup_short(Name(WER)+" "+(msg=explode(QueryProp(P_MSGOUT),"#"))[0]
         +" <Richtung>"+(sizeof(msg)>1 ? msg[1] : "")+".")[0..64],
        cleanup_short(Name(WER)+" "+QueryProp(P_MSGIN)+".")[0..64],
        cleanup_short(Name(WER)+" "+QueryProp(P_MMSGOUT)+".")[0..64],
        cleanup_short(Name(WER)+" "+QueryProp(P_MMSGIN)+".")[0..64]);
    if( IS_WIZARD(this_object()) )
      printf( "| cmsg:  %-65s |\n" "| dmsg:  %-65s |\n",
          cleanup_short(Name(WER)+" "+QueryProp(P_CLONE_MSG)+".")[0..64],
          cleanup_short("<Irgendetwas> "+QueryProp(P_DESTRUCT_MSG)+".")[0..64]);
    write( "+----------------------------+---------------------+-----------------------+\n");
  }
  else
    write( "+----------------------------+---------------------+-------+---------------+\n");
      printf( "| Ersetzungsanzeige: %-7s | TTY         : %-5s | Ausgaenge  : %-3s      |\n",
        ersetzung,
        capitalize(QueryProp(P_TTY)),
        (QueryProp(P_SHOW_EXITS) ? "Ein": "Aus"));
      printf( "| Zeilen     : %-3d %9s | Zeilenlaenge: %-3d   | Telnegs    : %-3s      |\n",
        QueryProp(P_SCREENSIZE),
        QueryProp(P_MORE_FLAGS) & E_ABS2 ? "(abs+rel)" :
        QueryProp(P_MORE_FLAGS) & E_ABS ? "(absolut)" : "(relativ)",
        QueryProp(P_SCREENWIDTH),
        QueryProp(P_TTY_SHOW) ? "Ein" : "Aus");
      printf( "| Raummodus  : %-9s     | Inform      : %3s   | Pluendern  : %3s      |\n",
        ((QueryProp(P_BRIEF)&BRIEF_VMASK)==0 ? "Lang":
         ((QueryProp(P_BRIEF)&BRIEF_VMASK)==1 ? "Kurz": "Ultrakurz")),
        (QueryProp(P_INFORMME)&1 ? "Ein": "Aus"),
        (QueryProp(P_LOOTING) ? "Ein": "Aus"));
  if( IS_WIZARD(this_object()) )
    printf( "| Magiermodus: %-13d | Trankfinden : %3s   | Unsichtbar : %-4s     |\n",
        QueryProp(P_WANTS_TO_LEARN),
        (QueryProp(P_TRANK_FINDEN) ? "Ein": "Aus"),
        (QueryProp(P_INVIS) ? "Ja": "Nein"));
  write( "+----------------------------+---------------------+-----------------------+\n");
  printf( "| Anzeige : %-62s |\n",anzeige[0..61]);
  printf( "|         : %-62s |\n",anzeige2[0..61]);
  printf( "| Kampf   : %-62s |\n",kampf[0..61]);
  printf( "| Haende  : %-62s |\n",
      cleanup_short(Name(WER)+" greift Dich"+QueryProp(P_HANDS)[0]+" an.")[0..61]);
  if( IS_SEER(this_object()) ) {
  write( "+--------------------------------------------------------------------------+\n");
    printf(
        "| Uhrmeldung     : %-55s |\n"
        "| Fehlermeldung  : %-55s |\n"
        "| Zeitungsmeldung: %-55s |\n" ,
        cleanup_short(QueryProp(P_CLOCKMSG)?QueryProp(P_CLOCKMSG):
         "Du hoerst die Uhr schlagen: Es ist jetzt %d Uhr.")[0..54],
        cleanup_short(QueryProp(P_DEFAULT_NOTIFY_FAIL)?QueryProp(P_DEFAULT_NOTIFY_FAIL):
         "Wie bitte?")[0..54],
        cleanup_short((QueryProp(P_READ_NEWS)||([]))["*NNADWMSG*"]?QueryProp(P_READ_NEWS)["*NNADWMSG*"]:
         "Nix Neues auf der Welt")[0..54]);
  }
  printf(
      "+--------------------------------------------------------------------------+\n"
      "| E-Mail Adresse : %-55s |\n"
      "| Homepage       : %-55s |\n",
      (QueryProp(P_MAILADDR)?QueryProp(P_MAILADDR)[0..54]+showemail:"keine"),
      (QueryProp(P_HOMEPAGE)?QueryProp(P_HOMEPAGE)[0..54]:"keine")
      );
  if(mappingp(m=QueryProp(P_MESSENGER))) 
  {
    msg = m_indices(m);
    for(i=sizeof(msg)-1;i>=0;i--)
      printf( "| %-13s  : %-55s |\n", CAP(msg[i]), to_string(m[msg[i]]));
  }
  if( n=QueryProp(P_LOCATION) )
    printf( "| Ort            : %-55s |\n", n);
  write( "+--------------------------------------------------------------------------+\n");

  return 1;
}

int attribute()
{
  printf("Kraft: %2d  Geschick: %2d  Ausdauer: %2d  Intelligenz: %2d  "
      "LP: %3d  MP: %3d\n",
      QueryAttribute(A_STR), QueryAttribute(A_DEX),
      QueryAttribute(A_CON), QueryAttribute(A_INT),
      QueryProp(P_MAX_HP), QueryProp(P_MAX_SP));
  return 1;
}

string SetMarried(string str)
{
  if (!stringp(str) && str != 0) return 0;
  if( (previous_object() && member(MARRIED_ALLOWED,
          explode(file_name(previous_object()), "#")[0]) != -1) ||
      (this_interactive() && member(MARRIED_UIDS, 
          getuid(this_interactive())) != -1) )
  {
    if (stringp(str))
      log_file( "interactive/HOCHZEIT", 
          sprintf("%s: %s heiratet %s.\n",
            ctime(), capitalize(getuid(ME)), capitalize(str) ));
    else
      log_file( "interactive/HOCHZEIT", 
          sprintf("%s: %s ist wieder frei.\n",
            ctime(), capitalize(getuid(ME)) ));
    SetProp(P_MARRIED, str);
    return str;
  }
  return 0;
}

