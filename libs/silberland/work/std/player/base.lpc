mixed RaceDefault(string arg)
{
  if (!arg)
    return 0;
  switch(arg)
  {
    case P_HANDS :
      return ({" mit blossen Haenden",30,DT_BLUDGEON});
    case P_BODY :
      return 0;
  }
  return 0;
}

void checkConsistency()
{
  mixed h,hs;
  int   m;

  if (IS_WIZARD(this_object())) return;
  if (pointerp(h=this_object()->RaceDefault(P_HANDS)) && sizeof(h)>1)
    m=(int)h[1];
  else
    m=30;
  if((hs=Query(P_HANDS))[1] != m && !IS_LEARNER(this_object())) {
    log_file("interactive/inconsistent", sprintf(
      "[%s] %O: HANDS: %d -> %d\n", dtime(time()), this_player(), hs[1], m));
    if (!IS_SEER(this_object())) hs[0] = h[0];
    hs[1] = m;
    if (sizeof(h)>2) hs[2] = h[2];
    Set(P_HANDS,hs);
  }
  if (Query(P_BODY)!=(m=RaceDefault(P_BODY))) {
    log_file("interactive/inconsistent", sprintf("[%s] %O: BODY: %d -> %d\n",
        dtime(time()), this_player(), Query(P_BODY), m));
    Set(P_BODY,m);
  }
}

void FinalSetup()
{
  int avg, var;

  if (!QueryProp(P_SIZE) && (avg=QueryProp(P_AVERAGE_SIZE))) {
    var=avg/24+1;
    SetProp(P_SIZE,avg+random(var)-random(var)+random(var)-random(var));
    Set(P_SIZE,SAVE|PROTECTED,F_MODE_AS);
  }
  if (!QueryProp(P_WEIGHT) && (avg=QueryProp(P_AVERAGE_WEIGHT))) {
    var=avg/15+1;
    SetProp(P_WEIGHT,
        avg+random(var)-random(var)+random(var)-random(var)-
        (QueryProp(P_GENDER)==FEMALE ? 3000+random(2001) : 0));
    Set(P_WEIGHT,SAVE|PROTECTED,F_MODE_AS);
  }
  Set(P_TTY_COLS, SAVE, F_MODE_AD);
  Set(P_TTY_ROWS, SAVE, F_MODE_AD);
  Set(P_TTY_TYPE, SAVE, F_MODE_AD);
}

#ifdef AUTO_LOGOUT
nosave void auto_logout()
{
  if (!interactive(this_object())) {
    if (IS_LEARNER(this_object())) {
      quit();
      if (this_object()) {
        remove();
        if (this_object()) destruct(this_object());
      }
    }
    return;
  }
  if (query_idle(this_object()) < MAX_IDLE)
  {
    tell_object(ME, "Automatischer Logout abgebrochen.\n");
    return;
  }
  log_file("interactive/AUTO_LOGOUT",
      sprintf("%s: %s, idle: %s\n",
          ctime(), capitalize(getuid()),
          time2string("%h %H und %m %M", query_idle(this_object()))));
  tell_object(ME, "Automatischer Logout wegen zu langer Idlezeit.\n");
  say(Name()+" wurde wegen zu langer Idlezeit automatisch ausgeloggt.\n");
  if (IS_LEARNER(this_object())) {
    quit();
    if (this_object()) {
      remove();
      if (this_object()) destruct(this_object());
    }
  }
  else
    remove_interactive(ME);
}
#endif

void reset()
{
  int idle;

  if (!query_once_interactive(this_object()))
    return;
  if (!interactive(this_object())) {
    if (IS_LEARNER(this_object())) {
      quit();
      if (this_object()) remove();
      if (this_object()) destruct(this_object());
    }
    return;
  }
#ifdef AUTO_LOGOUT
  if ((query_idle(this_object()) > MAX_IDLE) && !IS_ARCH(this_object()))
  {
    if (IS_LEARNER(this_object())) {
      tell_object(ME, "\aAchtung, in 2 Minuten automatischer "
          "Logout wegen zu langer Idlezeit!\n");
      call_out("auto_logout", 120);
    }
    else
      auto_logout();
  }
#endif
}

varargs int remove(mixed arg)
{
  return (int)moving::remove(arg);
}

varargs nosave void stop_heart_beats(mixed obs)
{
  int i;

  if (!obs)
  {
    hb_obs=({});
    obs=deep_inventory(ME);
  }
  for (i=sizeof(obs)-1;i>=0;i--)
    if (pointerp(obs[i]))
      stop_heart_beats(obs[i]);
    else
      if (set_object_heart_beat(obs[i],0))
    hb_obs+=({obs[i]});
}

nosave void restart_heart_beats()
{
  int i;

  if (pointerp(hb_obs))
  {
    for (i=sizeof(hb_obs)-1;i>=0;i--)
      set_object_heart_beat(hb_obs[i],1);
    hb_obs=0;
  }
}

nosave void ListAwaited()
{
  string *list;
  object ob;
  int i,mag;

  mag=IS_LEARNER(ME);
  list=QueryProp(P_WAITFOR);

  for (i=sizeof(list)-1;i>=0;i--)
    if (!(ob=find_player(lower_case(list[i]))))
      list=list[0..i-1]+list[i+1..];
    else
      if (ob->QueryProp(P_INVIS))
        if (mag)
          list=list[0..i-1]+({"("+list[i]+")"})+list[i+1..];
        else
          list=list[0..i-1]+list[i+1..];

  if (sizeof(list))
    write(break_string("Anwesende Erwartete: "+CountUp(list)+".", 78));
}

varargs void Reconnect(int silent, string ip, int invis_login)
{
  int num, lastnew;
  string prev;
  object *inv;
  mixed err;

  // Security:
  prev = explode(file_name(previous_object()),"#")[0];
  if ((prev != "/secure/login") && (prev != "/secure/master"))
  {
    write("DIESER VERSUCH WAR ILLEGAL !!\n");
    destruct(ME);
    return 0;
  }

  // Einige Initialisierungen:
  startup_telnet_negs();
  my_ip = ip;
  enable_commands();
  set_living_name(getuid());
  _remove_netdead();
  set_heart_beat(1);
  restart_heart_beats();

  // REENTER mitloggen:
  log_file("game/REENTER",
      sprintf("[%s]: %11s (%s)\n",
        ctime()[0..15], capitalize(getuid()), query_ip_name(ME)));

  // Unsichtbares Einloggen? Nur fuer Magier:
  if (!QueryProp(P_INVIS) && invis_login && IS_WIZARD(ME))
    SetProp(P_INVIS, QueryProp(P_AGE));

  // "...ist gerade ins SL gekommen." Meldung:
  if (!silent)
    "/secure/merlin"->notify_player_enter(getuid(ME), QueryProp(P_INVIS));

  // Commands und Prompt reinitialisieren:
  command::reconnect();
  ME->modify_prompt();

  // /etc/(WIZ)NEWS ausgeben
  if (num = QueryProp(P_LAST_LOGOUT))
    if (IS_WIZARD(this_object()) && (file_time("/etc/WIZNEWS") >= num))
      cat("/etc/WIZNEWS");
    else if (file_time("/etc/WIZNEWS") >= num)
      cat("/etc/NEWS");

  // Mail bekommen?
  if (num="secure/mailer"->FingerMail(geteuid())) {
    if (lastnew="secure/mailer"->LastNewMail(geteuid()))
      write("\n  __ /  Du hast "+num+" neue"+(num==1 ? "n Brief":" Briefe")+
              " am Postamt liegen.\n"
              " |__|   Letzter Brief am "+dtime(lastnew)+" eingetroffen.\n\n");
    else
      write("\n  __ /\n"
              " |__|   Du hast "+num+" neue"+(num==1 ? "n Brief" : " Briefe")+
              " am Postamt liegen.\n\n");
  }

  // Wieder auf den Ebenen anmelden:
  catch(RegisterChannels());

  funcall(#'Set, P_CALLED_FROM_IP, query_ip_number()); //');
  funcall(#'Set, P_CALLED_FROM_IP_NAME, query_ip_name(ME)); //');

  if (query_once_interactive(ME))
    Set(P_LAST_LOGIN,time());

  // falls Gegenstaende mit 'upd -ar' upgedated wurden, muessen die
  // "verloren gegangenen" init()'s nachgeholt werden
  if ( !IS_LEARNER(ME) && ndead_disabled ) {
    call_out( "catchup_inits", 0, ndead_disabled, all_inventory(ME) );
    ndead_disabled=0;
  }

  // noch nicht geclonte Autoloader "nach"clonen
  while ( remove_call_out("load_auto_objects") != -1 )
    /* do nothing */;

  if ( m_sizeof(autoload_rest) )
    call_out( "load_auto_objects", 0, autoload_rest );

  if (ndead_currently) {
    ListAwaited();
    ndead_revive();
  }

  // BecomesNetAlive() Orgie:
  inv = ((ndead_location ? all_inventory(ndead_location) - ({ ME }) : ({}))
         + deep_inventory(ME)) - ({ 0 });

  if (ndead_location)
  {
    if (err = catch( ndead_location->BecomesNetAlive(ME) ))
    {
      log_file( "error/RECONNECT",
          sprintf( "[%s]: (%s) Error in %O: %s",
                   ctime(time())[4..], capitalize(getuid(ME)),
                   ndead_location, err ) );
    }
    ndead_location = 0;
  }

  for (num = sizeof(inv); num-->0; )
  {
    if (err = catch(call_other(inv[num], "BecomesNetAlive", ME)))
      log_file( "error/RECONNECT",
          sprintf( "[%s]: (%s) Error in %O: %s",
                   ctime(time())[4..], capitalize(getuid(ME)),
                   inv[num], err ) );
  }

  // Raummeldung bei Wiedereinloggen:
  // (erst hier, weil Spieler evtl. durch ein BecomesNetAlive() bewegt wurde)
  if (!QueryProp(P_INVIS) && !silent &&
      environment() && file_name(environment()) != NETDEAD_ROOM)
    say(QueryProp(P_NAME)+" weilt wieder unter den Lebenden.\n");

}

nosave void catchup_inits( int logout, object *obs )
{
  filter_array( obs, "call_init", ME, logout );
}

nosave int call_init( object ob, int logout )
{
  if ( objectp(ob) && ( program_time(ob) >= logout ||
                        ob->QueryProp(P_CLONE_TIME) >= logout ) )
    return catch(ob->init()), 1;
}

void NetDead()
{
  object *inv;
  int num;

  catch(RemoveChannels());
  say("Ploetzlich weicht alles Leben aus "+name(WEM)+".\n");
  if (QueryGuest()) return (void) quit();
  _set_netdead();
  remove_call_out("quit");
  remove_living_name();
  Set(P_LAST_LOGOUT, time());
  if (!QueryProp(P_INVIS))
    Set(P_LAST_VISIBLE_LOGOUT, time());
  if (ME)
    ndead_location = environment();
  catch("secure/merlin"->notify_player_leave(geteuid(ME),QueryProp(P_INVIS)));

  // BecomesNetDead() Orgie:
  if (environment())
  {
    catch(environment()->BecomesNetDead(ME));
    inv = deep_inventory(ME) + all_inventory(environment()) - ({ 0,ME });
    for (num = sizeof(inv); num-->0; )
        catch( call_other(inv[num], "BecomesNetDead", ME) );
  }
}

nosave void ndead_move_me();

void heart_beat() {
  if (!ME)
    return;
  if (ndead_currently)
  {
    if (interactive(ME)) {
      ndead_revive();
      ndead_location = 0;
    }
    else return;
  }
  else
    if (!(ndead_next_check--))
    {
      ndead_next_check=NETDEAD_CHECK_TIME;
      if (!interactive(ME))
        if (ndead_lasttime)
        {
          save_me(1);
          if (IS_LEARNER(ME))
          {
            quit();
            if (ME)
              remove();
            if (ME)
              destruct(ME);
            return;
          }
          ndead_move_me();
        }
        else
          ndead_lasttime=1;
    }
  if (ME && ndead_lasttime && interactive(ME))
    ndead_lasttime=0;
  life::heart_beat();
  combat::heart_beat();
}

/*
 * Identify ourself.
 * special temp handling for ghosts and i
 */
varargs int id(string str, int lvl)
{
  if (::id(str))
    return 1;
  if (Query(P_INVIS) && lvl < QueryProp(P_LEVEL))
    return 0;
  if (QueryProp(P_GHOST)&& str == "geist von "+ lower_case(QueryProp(P_NAME)))
    return 1;
  if (QueryProp(P_FROG) && str == "frosch") return 1;
}

nosave int set_homepage(string str)
{
  mixed tmp;
  if (!(str=_unparsed_args())) {
    if (!QueryProp(P_HOMEPAGE))
      write("Du hast keine URL-Adresse gesetzt!\n");
    else
      write("Deine offizielle URL-Adresse lautet: " + QueryProp(P_HOMEPAGE)
            +"\n");
    return 1;
  }
  write("Deine offizielle URL-Adresse wurde geaendert.\n");
  if (str=="keine" || str=="0" || str=="nichts") {
    SetProp(P_HOMEPAGE, 0);
    call_other(HOMEPAGED,"UnsetHomepage",
      getuid(this_object()));
  } else {
    tmp = filter_array(regexplode(str, "[<][^>]*[>]"),
                       lambda(({'e}), ({#'!=, ({#'[, 'e, 0}), '<'})));
    write("Sie lautet jetzt: "+(str = implode(tmp, ""))+"\n");
    call_other(HOMEPAGED,"SetHomepage",
      getuid(this_object()),str);
    write("Achtung:\n");
    write(break_string("Die Adresse ist in kurzer Zeit dann auch ueber die "
      "offizielle HomePage des SilberLandes abrufbar "
      "(sl.mud.at/homepages.shtml)!\n",78));
    return SetProp(P_HOMEPAGE, str);
  }
  return 1;
}

nosave mixed _set_icq(mixed no)
{
  mapping m;
  m = QueryProp(P_MESSENGER) || ([]);
  if (0 == no)
    m = m_delete(m, "ICQ");
  else
    m["ICQ"] = no;
  SetProp(P_MESSENGER, m);
  Set(P_ICQ, 0);

  return no;
}

nosave mixed _query_icq()
{
  mapping m;
  m = QueryProp(P_MESSENGER) || ([]);
  if (!m["ICQ"])
    return Query(P_ICQ);
  return m["ICQ"];
}
nosave mixed _query_messenger()
{
  mixed no;
  mapping m;

  m = Query(P_MESSENGER) || ([]);
  if (no = Query(P_ICQ))
  {
    m["ICQ"] = to_string(no);
    Set(P_ICQ, 0);
    Set(P_MESSENGER, m);
  }
  return m;
}

nosave int set_messenger(string str)
{
  mapping m;
  string * args;
  mixed no;

  m = QueryProp(P_MESSENGER) || ([]);
  if (!(str=_unparsed_args()))
  {
    if (!m || !sizeof(m))
      write("Du hast keine Instant-Messenger-ID gesetzt!\n");
    else
    {
      write("Deine Instant-Messenger-IDs lauten: \n");
      walk_mapping(m, lambda(({'k,'n}),({#'printf,"%-15s: %s\n",({#'capitalize,'k}),'n})));
    }
  }
  else if (2 != sizeof(args = explode(str, " ")))
  {
    write("Syntax: messenger [<messenger> <id>|keine]\n");
  }
  else
  {
    args[0] = lower_case(args[0]);
    if (-1 == member(map_array(VALID_MESSENGERS,#'lower_case), args[0]))
      write("Gueltige Messenger sind: "+implode(VALID_MESSENGERS,", ")+".\n");
    else
    {
      args[0] = VALID_MESSENGERS[member(map_array(VALID_MESSENGERS,
                                                  #'lower_case), args[0])];
      if ("keine" == args[1] || "loeschen" == args[1])
      {
        m = m_delete(m, args[0]);
        write("Deine ID fuer den Messenger '"+args[0]+"' wurde geloescht.\n");
      }
      else
      {
        m[args[0]] = args[1];
        write("Deine ID fuer den Messenger '"+args[0]+"' wurde geaendert.\n"
              "Sie lautet jetzt: "+args[1]+"\n");
      }
      SetProp(P_MESSENGER, m);
    }
  }
  return 1;
}

nosave int set_icq(string str)
{
  int icqnr;

  if (!(str=_unparsed_args())) {
    if (!QueryProp(P_ICQ))
      write("Du hast keine ICQ Nummer gesetzt!\n");
    else
      write("Dein ICQ Nummer lautet: "+QueryProp(P_ICQ)+".\n");
    return 1;
  }
  sscanf(str,"%d",icqnr);
  if(!icqnr) {
    write("Deine ICQ Nummer wurde geloescht.\n");
    SetProp(P_ICQ,0);
    return 1;
  }
  write("Deine ICQ Nummer wurde geaendert.\n");
  write("Sie lautet jetzt: "+icqnr+".\n");
  return SetProp(P_ICQ,to_string(icqnr));
}

nosave int set_email(string str)
{
  if (!(str=_unparsed_args())) {
    write("Deine offizielle E-Mail Adresse lautet: "+
          QueryProp(P_MAILADDR)+"\n");
    return 1;
  }
  write("Deine offizielle E-Mail Adresse wurde geaendert.\n");
  if (str=="keine") str="none";
  return SetProp(P_MAILADDR, str);
  return 1;
}

nosave int set_location(string str)
{
  mixed ort;

  if (str == "0" || str == "loeschen") {
    Set(P_LOCATION, 0);
    write("Du loescht Deine Ortsangabe.\n");
    return 1;
  }

  if (stringp(str = _unparsed_args()) && str != "") {
      Set(P_LOCATION, capitalize(str));
      printf("Du aenderst Deine Ortsangabe auf \"%s\".\n",
             Query(P_LOCATION));
  }
  else if (stringp(ort = Query(P_LOCATION)))
      printf("Deine Ortsangabe lautet \"%s\".\n", Query(P_LOCATION));
  else {
      Set(P_LOCATION, 0, F_VALUE);
      write("Du hast keine Ortsangabe gesetzt.\n");
  }

  return 1;
}

nosave int self_delete()
{
  int dauer;

  if ( (!QueryProp(P_TESTPLAYER) || IS_LEARNER(ME)) &&
       (IS_SEER(ME) || (QueryProp(P_LEVEL) >= 5)) )
  {
    if (time()-next_selfdel > 86400) next_selfdel=0;
    if (!next_selfdel) {
      dauer=(IS_LEARNER(ME) ? query_wiz_level(ME)/4 : QueryProp(P_LEVEL)/5) *
            (IS_SEER(ME) ? 3600 : 300);
      if (dauer<300) dauer=300;
      next_selfdel=time()+dauer;
      write(break_string("Beruhige Dich doch erst mal und versuch es in "+
          time2string(dauer>=3600 ? dauer % 3600 ? "%h %H und %m %M" :
              "%h %H" : "%m %M", dauer)+" nochmal!", 78));
      return 1;
    }
    else if (time() < next_selfdel) {
      dauer = next_selfdel - time();
      if (dauer < 60)
      {
        write("Gedulde Dich bitte noch einen kleinen Augenblick (" +
            dauer + " Sekunden)...\n"
            "Bist Du denn sicher, dass Du das wirklich willst???\n");
      }
      else
      {
        write(break_string("Dazu ist es noch zu frueh! Versuch es in "+
            time2string(dauer>=3600 ? dauer % 3600 ? "%h %H und %m %M" :
                "%h %H" : "%m %M", dauer)+" nochmal!", 78));
      }
      return 1;
    }
  }
  write("\n"+
    " ------------------------------------------------------- \n"+
    "| W I L L S T   D U   D A S   W I R K L I C H   ?  ?  ? |\n"+
    "|-------------------------------------------------------|\n"+
    "| Wenn Du Dich jetzt selbstloeschst, ist Dein Charakter |\n"+
    "| UNWIDERRUFLICH verloren.  Es gibt KEINE Moeglichkeit, |\n"+
    "| ihn wiederherzustellen,  Du muesstest wieder ganz von |\n"+
    "| vorne anfangen! Falls Du Dich jetzt immer noch selbst |\n"+
    "| loeschen willst, gib nun Dein Password ein.           |\n"+
    "| Alternativ verwende doch den Befehl 'spielpause',  um |\n"+
    "| nur voruebergehend von hier fernzubleiben.            |\n"+
    " ------------------------------------------------------- \n\n");
  write("Bitte das Password angeben: ");
  input_to("self_delete2",1);
  return 1;
}

int self_delete2(string str)
{
  int ret;
  ret=(int) MASTER->delete_player(str, getuid(PL));
  if (!ret)
  {
    write("Das hat nicht hingehauen (Woody sei Dank ....)\n");
    return 1;
  }
  if (PL->QueryProp(P_GUILD))
    catch(call_other(GUILD_DIR+PL->QueryProp(P_GUILD), "austreten"));

  PARENTMASTER->RemoveWiz(getuid(ME));

  if (QueryProp(P_DEADS) < 5) {
    write("Adios! Man sieht sich.\n");
    say(Name(WER,1)+" hat sich gerade selbst zerstoert.\n");
  }
  else {
    write( "\nTod kommt auf seinem weissen Pferd angeritten.\n"
+"Er steigt ab, baut sich drohend vor Dir auf und mustert Dich schadenfroh.\n"
+"\nTod sagt: ENDLICH! NUN KANN DIR AUCH LARS NICHT MEHR HELFEN!\n\n"
+"Tod holt weit mit seiner Sense aus. Mit grossem Schwung laesst er sie auf\n"
+"Dich zusausen und dann...\n");
    say(Name(WER,1)+" schied gerade endgueltig von uns.\n");
  }
  remove(1);
  return 1;
}

nosave int spielpause(string str)
{
  int days;
  string foo;

  if (!str || sscanf(str, "%d tag%s", days, foo) != 2)
    return notify_fail("spielpause <x> tage\n"), 0;

  if (days < 0)
    days = -1;

  if (days > 0)
    printf("Du wirst Dich erst wieder am %s einloggen koennen!\n",
           dtime((time()/86400)*86400+days*86400)[0..16]);
  else if (days < 0)
    write( "Du wirst Dich auf unbestimmte Zeit nicht mehr einloggen koennen.\n"
          +"Wenn Du wieder spielen willst, musst Du Dich an einen Gott oder\n"
          +"Erzmagier wenden (mit einem Gast oder Mail von aussen).\n" );
  else {
    write( "Die Spielpause ist aufgehoben.\n" );
    __MASTER_OBJECT__->TBanishName(getuid(this_object()), 0);
    return 1;
  }
  write( "Wenn Du das wirklich willst, gib jetzt 'ja' ein.\n]" );
  input_to( "spielpause2", 0, days);
  return 1;
}

nosave void spielpause2(string str, int days)
{
  if (str && (str == "ja" || str == "Ja" || str == "JA")) {
    __MASTER_OBJECT__->TBanishName(getuid(this_object()), days);
    write(
      "Ok, die Spielpause wird mit dem naechsten Ausloggen wirksam.\n"
      "Solltest Du es Dir bis dahin noch einmal ueberlegt haben, so kannst\n"
      "Du den Vorgang mit 'spielpause 0 tage' wieder rueckgaengig machen.\n");
    return;
  }
  write("Vorgang wurde abgebrochen.\n" );
}

/*
 *-----------------------------------------------------------------
 * Aenderung das Passwords
 *-----------------------------------------------------------------
 */
nosave int change_password() {
  string verb;
  verb=query_verb();
  if (verb!="passwd"&&verb!="password"&&verb!="passwort")
    return 0;
  write("Bitte das ALTE Passwort angeben: ");
  input_to("change_password2",1);
  return 1;
}

nosave int change_password2(string str) {
  write("\n");
  if (!str) {
    str == "";
  }
  if (MASTER->update_password(str,str) == 0) {
    write("Falsches Passwort!\n");
    return 1;
  }
  passwold = str;
  write("Bitte das NEUE Passwort eingeben: ");
  input_to("change_password3",1);
  return 1;
}

nosave int change_password3(string str) {
  write("\n");
  if ((!str) || str == "") {
    write("Abgebrochen !\n");
    return 1;
  }
  if (lower_case(str)==getuid())
  {
    write("Das ist zu leicht zu erraten. Nimm ein anderes, bitte.\n");
    write("Bitte das NEUE Passwort eingeben: ");
    input_to("change_password3",1);
    return 1;
  }
  if (strlen(str) < 6) {
    write("Das neue Passwort muss mindestens 6 Zeichen lang sein!\n");
    write("Bitte das NEUE Passwort eingeben: ");
    input_to("change_password3",1);
    return 1;
  }
  passw = str;
  write("Nochmal: ");
  input_to("change_password4",1);
  return 1;
}

nosave int change_password4(string str) {
  write("\n");
  if (!str || str != passw) {
    write("Das war verschieden! Passwort NICHT geaendert.\n");
    return 1;
  }
  if (MASTER->update_password(passwold,passw))
    write("Passwort geaendert.\n");
  return 1;
}

