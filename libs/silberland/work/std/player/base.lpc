nosave void smart_log(string myname, string str)
{
  string creat, creat2, date, filext, filext2, obnam, rest;
  object obj;
  string *strs;

  if (sscanf(str,"%s:%s",obnam,rest)==2 &&
      ((obj=present(obnam,environment())) || (obj=present(obnam)) ))
    str = rest;
  else {
    obj = QueryProp(P_REFERENCE_OBJECT);
    if (!obj || !present(obj))
      obj = environment(this_object());
  }

  creat2 = 0;
  date = dtime(time())[5..<11];

  if (myname=="EP" || !(creat = obj->QueryProp(P_LOG_FILE)))
  {
    creat = MASTER->creator_file(obj);
    if (creat[0..1]=="d.") creat=efun::explode(creat, ".")[<1];

    strs = MASTER->full_path_array(file_name(obj),0);
    if (strs[0]=="d" && myname!="EP")
      creat2 = strs[1]+"/"+lower_case(strs[2]);

    if (creat == ROOTID)
      creat = "ROOT";
    else if (!creat || creat[0]==' ')
      creat="STD";

    filext = ".rep";
    switch(myname)
    {
      case "EP":     filext  = ".ep";   break;
      case "DETAIL": filext2 = ".det";  break;
      case "IDEA":   filext2 = ".idea"; break;
      case "BUG":    filext2 = ".bug";  break;
      case "TYPO":   filext2 = ".typo"; break;
    }
    creat = "report/" + creat + filext;
  }

  // FP-Vorschlaege NICHT in Objekt-Logfiles, und kein log-rotate!
  if (myname=="EP")
  {
    write_file( "/log/" + creat, myname + " von " +
        capitalize(getuid(this_object())) +
        " [" + file_name(obj) + "] (" + date + "):\n" +
        str + "\n\n" );
  }
  // Evtl. objekteigene SmartLog() Funktion auswerten
  else if (!obj->SmartLog(creat, myname, str, date))
  {
    log_file( creat, myname + " von " + capitalize(getuid(this_object())) +
              " [" + file_name(obj) + "] "+
              (obj != environment() ? "{ENV = " + file_name(environment()) + 
               "} " : "") + "(" + date + "):\n" +
              str + "\n\n" );
    if (creat2)
    {
      creat2 = "report/" + creat2 + filext2;
      log_file( creat2, capitalize(getuid(this_object())) +
              " [" + file_name(obj) + "] "+
              (obj != environment() ? "{ENV = " + file_name(environment()) + 
               "} " : "") + "(" + date + "):\n" +
              str + "\n\n" );
    }
  }
  // Die globalen logs wurden ausgebaut, da sie ja eh' niemand liest.
}

int quit()
{
  int num;
  object *inv;

  catch(RemoveChannels());
  Set(P_LAST_LOGOUT,time());

  if (!QueryProp(P_INVIS))
    Set(P_LAST_VISIBLE_LOGOUT,time());

  if (!QueryGuest()) {
    tell_object(ME, "Speichere "+capitalize(getuid(this_object()))+".\n");
    save_me(0);
  }
  if (environment()) {
    catch(environment()->PlayerQuit(ME));
    inv = all_inventory(environment()) - ({ME}) + deep_inventory(ME) - ({0});
    for (num = sizeof(inv); num-->0; )
      catch(call_other(inv[num], "PlayerQuit", ME));
  }
  if (catch(remove())) destruct(ME);
  return 1;
}

nosave int delayed_quit()
{
  if (!QueryProp(P_GHOST)) return quit();
}

nosave int new_quit()
{
  string noquit;

  if (IS_LEARNING(ME)) return quit();
  if (environment() && (noquit=environment()->QueryProp(P_NOQUIT))) {
    if (stringp(noquit))
      write(noquit);
    else
      write("Es ist an diesem Ort nicht moeglich, das Spiel zu verlassen.\n");
    return 1;
  }
  if (QueryProp(P_GHOST)) return quit();
  if (ME->EnemyPresent())  // && (time()-QueryProp(P_LAST_QUIT)<600)
  {
    write ("Du bereitest Dich"+
        (find_call_out("delayed_quit") != -1 ? " erneut" : "")+
        " auf den Ausstieg aus dem Spiel vor.\n");
    remove_call_out("delayed_quit");
    call_out("delayed_quit", 10);
    return 1;
  }
  if (QueryProp(P_LAST_COMBAT_TIME)+30 > time())
  {
    write ("Du bist noch zu aufgebracht von Deinem letzten Kampf.\n");
    return 1;
  }
  return quit();
}

nosave string exhausted_text()
{
  int p;

  // Anzahl der verbleibenden Moving Points in Prozent:
  p = 100 * QueryProp(P_MV) / QueryProp(P_MAX_MV);

  switch (p)
  {
    case 0..5:   return "Du bist im Moment schwer erschoepft.";
    case 6..15:  return "Du bist ziemlich ausser Atem.";
    case 16..30: return "Du bist etwas erschoepft.";
    case 31..50: return "Du spuerst erste Anzeichen der Erschoepfung.";
    default:     return "";
  }
}

nosave string weight_text()
{
  int p;

  // Gewicht in Prozent ausrechnen:
  p = 100 * (QueryProp(P_TOTAL_WEIGHT) - QueryProp(P_WEIGHT) )
          / QueryProp(P_MAX_WEIGHT);

  // Durch etwaige Antigewichte kann der Wert auch unter 0 sinken:
  if (p < 0) p = 0;

  switch (p)
  {
    case  0..50:  return "";
    case 51..60: return "Du traegst einiges Gewicht mit Dir herum.";
    case 61..70: return "Du bist ziemlich beladen.";
    case 71..80: return "Du bist schwer beladen.";
    case 81..90: return "Du bist sehr schwer beladen.";
    case 91..95: return "Du bist extrem schwer beladen.";
    case 96..100: return "Das schwere Gewicht zwingt Dich fast zu Boden.";
    default:     return "Du schleppst mehr als Du eigentlich tragen kannst.";
  }
}

nosave varargs mixed score(string arg, int internal)
{
  string ret;
  mixed ind;
  int level, n;

  if (QueryProp(P_GHOST)) {
    write("Im ewigen Leben gibt es keine Punkte.\n");
    return 1;
  }

  // Einzige Ausnahme von der Balkenanzeige: max. 20% vom naechsten Level
  if ((LpLevel() == (QueryProp(P_LEVEL)+1)) && (LevelPerc(LpLevel()+1) < 20))
    level = QueryProp(P_LEVEL);
  else
    level = LpLevel();

  ind = QueryProp(P_ATTRIBUTES);

  if (QueryProp(P_NO_ASCII_ART) || arg == "-k")
  {
    ret = sprintf(
      "Du bist: %s\n"+
      "%d Lebenspunkte (max: %d), %d Erfahrungspunkte\n"
      "%d Magiepunkte (max: %d), %d Abenteuerpunkte (max: %d)\n"
      "%d Attributpunkte, Stufe %d (%d Prozent zur Stufe %d)\n\n"
      "Ausdauer: %s, Kraft: %s\n"
      "Intelligenz: %s, Geschicklichkeit: %s\n",
      capitalize(short() || "\n"),
      QueryProp(P_HP), QueryProp(P_MAX_HP),
      QueryProp(P_XP),
      QueryProp(P_SP), QueryProp(P_MAX_SP),
      QueryProp(P_QP), QM->QueryAllQP(),
      QueryProp(P_AP),
      level, LevelPerc( level + 1 ), level + 1,
      sprintf("%d (%+d)", ind[A_CON], QueryAttributeOffset(A_CON)),
      sprintf("%d (%+d)", ind[A_STR], QueryAttributeOffset(A_STR)),
      sprintf("%d (%+d)", ind[A_INT], QueryAttributeOffset(A_INT)),
      sprintf("%d (%+d)", ind[A_DEX], QueryAttributeOffset(A_DEX))
    );
  }
  else
  {
    ret = sprintf(
      "Du bist: %s"+
      "+------------------------------+------------------------------+\n"
      "| Lebenspunkte:      %3d (%3d) | Erfahrungspunkte: %10d |\n"
      "| Magiepunkte:       %3d (%3d) | Abenteuerpunkte: %4d (%4d) |\n"
      "| Attributpunkte:           %2d | Stufe %d [%-'.'*s] %d |\n"
      "+------------------------------+------------------------------+\n"
      "| Ausdauer:           %8s | Kraft:              %8s |\n"
      "| Intelligenz:        %8s | Geschicklichkeit:   %8s |\n"+
      (internal ? "" :
      "+------------------------------+------------------------------+\n"
      ),
      capitalize(short() || "\n"),
      QueryProp(P_HP), QueryProp(P_MAX_HP),
      QueryProp(P_XP),
      QueryProp(P_SP), QueryProp(P_MAX_SP),
      QueryProp(P_QP), QM->QueryAllQP(),
      QueryProp(P_AP),
      level,
      (n = 18 - strlen(to_string(level)) - strlen(to_string(level + 1))),
      sprintf("%'#'*s", LevelPerc( level + 1 ) * n / 100, ""),
      level + 1,
      sprintf("%d (%+d)", ind[A_CON], QueryAttributeOffset(A_CON)),
      sprintf("%d (%+d)", ind[A_STR], QueryAttributeOffset(A_STR)),
      sprintf("%d (%+d)", ind[A_INT], QueryAttributeOffset(A_INT)),
      sprintf("%d (%+d)", ind[A_DEX], QueryAttributeOffset(A_DEX))
    );
  }

  if (internal)         // falls von "info" verwendet
    return ret;

  write(ret);           // sonst direkt ausgeben ("punkte" bzw. "score")
  return 1;
}

nosave int pl_info(string arg)
{
  string ret;
  string gift, tmp;
  string *strings;
  int i,sz,val;
  mixed ind;
  object *enem1, *enem2, *inv;

  if (QueryProp(P_GHOST)) {
    write("Im ewigen Leben gibt es keine Punkte.\n");
    return 1;
  }

  strings=({"","","",""});
  i=0;
  if (val=QueryProp(P_POISON) ) {
    strings[i]=(val<4 ? "leicht vergiftet" : "vergiftet");
    i++;
  }
  if( QueryProp(P_BLIND) ) {
    strings[i]="blind";
    i++;
  }
  if( QueryProp(P_DEAF) ) {
    strings[i]="taub";
    i++;
  }
  if( QueryProp(P_FROG) ) {
    strings[i]="ein Frosch";
    i++;
  }
  gift="";
  if( i )
  {
    for( sz=0;sz<i;sz++)
      gift += strings[sz]+ (sz==i-1?".":(sz==i-2?" und ":", "));
    gift = "Du bist " + gift + "\n";
  }
  if ((tmp=exhausted_text()) != "")
    gift += tmp + "\n";
  if ((tmp=weight_text()) != "")
    gift += tmp + "\n";

  ret = score(arg, 1);

  if (QueryProp(P_NO_ASCII_ART) || arg == "-k")
  {
    ret += sprintf(
      "\n"
      "Gilde: %s, Gildenstufe: %d, Spielerstufe: %d\n" + gift +
      "Vorsicht-Modus: %d%s\n"
      "Dein Charakter ist %s.\n"
      "Alter: %s\n\n%s%s",
      (QueryProp(P_GUILD) ?
        capitalize(QueryProp(P_GUILD)) :
        capitalize(QueryProp(P_DEFAULT_GUILD) || DEFAULT_GUILD)),
      QueryProp(P_GUILD_LEVEL) ? QueryProp(P_GUILD_LEVEL) : QueryProp(P_LEVEL),
      QueryProp(P_LEVEL),
      QueryProp(P_WIMPY),
      (QueryProp(P_WIMPY_DIRECTION) ?
        ", Fluchtrichtung: "+to_string(QueryProp(P_WIMPY_DIRECTION)) :
        ""),
      al_to_title(QueryProp(P_ALIGN)),
      get_age(),
      break_string(Forschung()),
      (QueryProp(P_AWAY) ?
        sprintf("\nDu bist nicht ansprechbar: %s\n",
                QueryProp(P_AWAY)) : "") );

  }
  else
  {
    gift = implode(
        map_array(
          explode(gift, "\n"),
          lambda(({'x}), ({#'sprintf, "| %-59s |", 'x }) ) ), "\n");
    ret += sprintf(
      (QueryProp(P_LEVEL) < 100 ?
      "+------------------------+-----+-----------+------------------+\n"
      "| Gilde: %:-15s | Gildenstufe: %2d | Spielerstufe: %2d |\n"
      "+------------------------+-----------------+------------------+\n"
      :
      "+-----------------------+------+----------+-------------------+\n"
      "| Gilde: %:-14s | Gildenstufe: %2d | Spielerstufe: %3d |\n"
      "+-----------------------+-----------------+-------------------+\n"
      ) + break_string(gift, 0, "", BS_LEAVE_MY_LFS) +
      "| Vorsicht-Modus: %3d%:-40s |\n"
      "| Dein Charakter ist %-40s |\n"
      "| Alter: %-52s |\n%s"
      "+-------------------------------------------------------------+\n"
      ,
      (QueryProp(P_GUILD) ?
        capitalize(QueryProp(P_GUILD)) :
        capitalize(QueryProp(P_DEFAULT_GUILD) || DEFAULT_GUILD)),
      QueryProp(P_GUILD_LEVEL) ? QueryProp(P_GUILD_LEVEL) : QueryProp(P_LEVEL),
      QueryProp(P_LEVEL),
      QueryProp(P_WIMPY),
      (QueryProp(P_WIMPY_DIRECTION) ?
        ", Fluchtrichtung: "+to_string(QueryProp(P_WIMPY_DIRECTION)) :
        ""),
      al_to_title(QueryProp(P_ALIGN))+".",
      get_age(),
      (QueryProp(P_AWAY) ?
        sprintf("| Du bist nicht ansprechbar: %:-32s |\n",
                QueryProp(P_AWAY)) : "")
      );

    ind = explode(break_string(Forschung(), 59), "\n");
    for (i=0;i<sizeof(ind);i++)
      ret += sprintf("| %-59s |\n", to_string(ind[i]));
    ret += "+-------------------------------------------------------------+\n";
  }

  // Feinde aufzaehlen
  enem1 = ((mixed) QueryEnemies())[0];
  if (sizeof(enem1))
  {
    enem2 = ({});
    inv = all_inventory(environment(ME));

    for (i=0; i < sizeof(enem1); i++)
      if (member_array(enem1[i], inv) == -1) // Ist unser Feind, aber nicht da.
        enem2 += ({enem1[i]});

    if (sizeof(enem2))
    {
      ind = explode( break_string(
        "Du verfolgst "+CountUp( map_objects( enem2, "name", WEN ) )
        +".", 59), "\n");

      for (i=0; i < sizeof(ind); i++)
        ret += sprintf("| %-59s |\n", to_string(ind[i]));

      ret+="+-------------------------------------------------------------+\n";
    }
  }

  // Und jetzt ausgeben
  More(ret);
  return 1;
}

nosave string getmanpage(string dir, string page)
{
  string text, *syn;
  int i;

  if (dir[<1] != '/')
    dir += "/";

  if ((text=read_file(dir+page)) && strlen(text))
    return text;

  if (text = read_file(dir+".synonym")) {
    syn = regexplode(text, "([ \t][ \t]*|\n)");
    if ((i=member(syn, page))!=-1)
      return read_file(dir+syn[i+2]);
  }
  return 0;
}

nosave int help(string str)
{
  string verb, rest, text;
  string gilde, was;
  mixed found;

  found=0;
  text = "";

  if (str)
  {
    // Security
    str = regreplace( str, "/\\.\\.|\\.\\./", "", 1 );

    // bestimmte Gildenhilfe?
    if (sscanf(str, "gilde %s %s", gilde, was) == 2)
    {
      if (file_size("/doc/g." + gilde) != -2) {
        write("Zu einer Gilde \"" + capitalize(gilde) +
              "\" gibt es keine Hilfeseiten.\n");
        return 1;
      }
      if (!text = getmanpage("/doc/g." + gilde + "/", was))
        text = "Dazu ist in der Gilde " + capitalize(gilde) +
               " leider keine Hilfe verfuegbar.\n";
      More(text);
      return 1;
    }

    // Gildenhilfen-Uebersicht?
    if (sscanf(str, "gilde %s", gilde) == 1)
    {
      if (file_size("/doc/g." + gilde) != -2) {
        write("Zu einer Gilde \"" + capitalize(gilde) +
              "\" gibt es keine Hilfeseiten.\n");
        return 1;
      }
      found = get_dir( "/doc/g." + gilde + "/*" ) - ({ ".",".." });
      if (!sizeof(found)) {
        write("In der Gilde " + capitalize(gilde) +
              " gibt es derzeit keine Hilfeseiten.\n");
        return 1;
      }
      found = map_array( found, #'capitalize );
      text = "Die Gilde " + capitalize(gilde) + " hat folgende Hilfeseiten:\n"+
             break_string( implode( found, ", " ) + ".", 78 );
      More(text);
      return 1;
    }

    // Bei z.B. "hilfe teile mit" nur nach "teile" suchen
    if ( sscanf( str, "%s %s",verb,rest ) == 2 )
      str = verb;

    // Magier
    if ( IS_LEARNER(PL) && (rest = getmanpage("/doc/w/", str)) ) {
      found++;
      text += rest;
    }

    // eigene Gilde
    if ( (gilde = QueryProp(P_GUILD)) &&
         (rest = getmanpage("/doc/g." + gilde + "/", str)) )
    {
      if (found++) text += "\n----------------\n";
      text += rest;
    }

    // Seher
    if ( IS_SEER(PL) && (rest = getmanpage("/doc/s/", str)) ) {
      if (found++) text += "\n----------------\n";
      text += rest;
    }

    // Spieler
    if (rest = getmanpage("/doc/helpdir/", str)) {
      if (found++) text += "\n----------------\n";
      text += rest;
    }

    // Nichts gefunden
    if (!found)
    {
      if (getmanpage("/doc/s/", str))
        text = "Dieser Befehl ist Sehern vorbehalten.\n";
      else if (getmanpage("/doc/w/", str))
        text = "Dieser Befehl ist Magiern vorbehalten.\n";
      else
        text = "Dazu ist keine Hilfe verfuegbar.\n";
    }
    else if (found > 1)
      text = "Dazu sind "+found+" Hilfeseiten verfuegbar:\n\n" + text;

    More(text);
    return 1;
  }

  // Allgemeine Hilfe
  if (IS_LEARNER(PL))
    text = read_file("/doc/hilfe.magier");
  else if (IS_SEER(PL))
    text = read_file("/doc/hilfe.seher");

  More(text + read_file("/doc/hilfe.spieler"));
  return 1;
}


public varargs mixed filter_who_options(string str, int flags)
{
  string par;
  string* opt;
  int i, j, len, res;

  if (!str || str=="")
    return ({ flags, "", "" });

  opt = explode(str," "); len=sizeof(opt);
  res = flags;
  par = "";
  for (i=0; i<len; i++)
    switch (opt[i])
    {
      case "short":
      case "-kurz":
        res |= 1;
        par += " short";
        break;
      case "long":
      case "-lang":
        res &= ~3;
        par += " long";
        break;
      case "race":
      case "-rasse":
        res &= ~3;
        res |= 8;
        par += " race";
        break;
      case "vert":
      case "-vertikal":
        res |= 3;
        break;
      case "alpha":
      case "-alpha":
      case "-alphabetisch":
        res |= 4;
        break;
      default:
        if (opt[i][0] == '-')
          for (j=strlen(opt[i])-1; j; j--)
            switch (opt[i][j])
            {
              case 'a': res|=4; par += " alpha"; break;
              case 'k': res|=1; par += " short"; break;
              case 'v': res|=3; par += " vert"; break;
              case 'l': res&=~3; par += " long"; break;
              case 'r': res&=~3; res|=8; par += " race"; break;
            }
        else if (i)
          return ({ res, implode(opt[i..]," "), par[1..] });
        else
          return ({ res, str, "" });
    }
  return ({ res, 0, par[1..] });
}

nosave int who(string str)
{
  int i, flags;
  string res, ret, params, mud;
  mixed ans;

  if (str = _unparsed_args())
  {
    ans = filter_who_options(str);
    flags = ans[0];
    str = ans[1];
    params = ans[2];
  }
  if (stringp(str) && strlen(str))
  {
    ans = explode(str, " ");
    mud = ans[0];
    ans = ans[1..];
    if (mud == "mud" && sizeof(ans)) {      // Wird explizit nach einem
      mud = ans[0]; ans = ans[1..]; i=1;    // anderen Mud gefragt?
    } else i=0;
    params = implode(explode(params, " ") + ans - ({""}), " ");
    if (sizeof(INETD->expand_mud_name(mud)) || i)
    {
      if (ret = INETD->send_udp(mud,
            ([ REQUEST: "who",
               SENDER:  getuid(ME),
               DATA:    params ]), 1 ))
	write(ret);
      else
	write("Anfrage abgeschickt.\n");
      return 1;
    }
  }

  res = implode("/obj/werliste"->QueryWhoListe(
      IS_LEARNER(ME) && QueryProp(P_WANTS_TO_LEARN), flags, 0, str), "\n");

  if (IS_LEARNER(ME) && QueryProp(P_WANTS_TO_LEARN))
    i = sizeof( users() );
  else
    i = sizeof( users() - filter_objects(users(), "QueryProp", P_INVIS) );

  if (flags & 1)
    ret = res + "\n\n";
  else
  {
    ret = sprintf( "%'-'*s\n", QueryProp(P_SCREENWIDTH) || 78, "" );
    ret = "Liste der Mitspieler vom " + dtime(time()) + " (" +
          sizeof(explode(res,"\n")-({""})) + " Teilnehmer):\n" + ret + res +
          (strlen(res) ? "\n"+ret : "") +
          sprintf(
              "Derzeit Anwesende: %d, heute bisher %d (%d davon gleichzeitig), "
              "Rekord: %d\n", i,
              "/secure/merlin"->QueryMaxDistinctUsersToday(),
              "/secure/merlin"->QueryMaxUsersToday(),
              "/secure/merlin"->QueryMaxUsers() );
  }
  More(ret,0);
  return 1;
}

nosave int kwho(string str)
{
  int flags;
  mixed res;

  if(str) {
    res = filter_who_options(str);
    flags = res[0];
    str = res[1];
  }
  More(implode( "/obj/werliste"->QueryWhoListe(IS_LEARNER(ME) &&
          QueryProp(P_WANTS_TO_LEARN), flags | 1, 0, str),"\n")+"\n\n",0);
  return 1;
}

nosave varargs int kkwho(string str) {
  object *obs;
  string *namen,res;
  int i;

  obs=filter_users(str);namen=({});
  if (IS_LEARNER(this_player())) {
    for (i=sizeof(obs)-1;i>=0;i--)
      if (environment(obs[i]))
	namen+=({capitalize(geteuid(obs[i]))});
  } else {
    for (i=sizeof(obs)-1;i>=0;i--)
      if (!obs[i]->QueryProp(P_INVIS) && environment(obs[i]))
	namen+=({capitalize(geteuid(obs[i]))});
  }
  namen=sort_array(namen,#'<); //')
  res="";
  for (i=sizeof(namen)-1;i>=0;i--) {
    res+=namen[i];
    if (i)
      res+=", ";
  }
  res+=".";
  write(break_string(res,75));

  return 1;
}

nosave int kill(string str) {
  object eob,wob;
  int i;

  if (QueryProp(P_GHOST))
  {
    write("Das kannst Du in Deinem immateriellen Zustand nicht.\n");
    return 1;
  }
  if (QueryGuest())
  {
    write("Du bist doch nur Gast hier.\n");
    return 1;
  }
  if (!str || str == "") {
    write("WEN willst Du toeten?\n");
    return 1;
  }
  eob = present(lower_case(str),environment());
  if (!eob || !living(eob)) {
    if (str=="alle") {
      object *lvs;
      lvs=filter_array(all_inventory(environment()),
		       lambda(({'x}),({#'?,
			 ({#'query_once_interactive, 'x}), ({#'return, 0}),
			 ({#'living, 'x}), ({#'return, 1}),
				({#'return, 0})}))); // '})})));
      if (i=sizeof(lvs)) {
	for (i--;i>=0;i--)
          if ((!lvs[i]->QueryProp(P_NO_GLOBAL_ATTACK)) &&
              (!lvs[i]->QueryProp(P_FRIEND)))
            Kill(lvs[i]);
	return 1;
      }
    }
    write("Du siehst hier kein derartiges Wesen!\n");
    return 1;
  }
  if (eob == this_object())
  {
    write("Selbstmord ist keine Loesung!\n");
    return 1;
  }
  if (query_once_interactive(eob) &&
      !(IS_LEARNER(this_object()) && IS_LEARNER(eob)) &&
      !(eob->QueryProp(P_TESTPLAYER)) &&
      !call_other ("/obj/pkmaster", "PK_allowed", environment(), this_object(), eob))
  {
      write(eob->Name(WER)+" ist ein Spieler!\n"
          "Das Angreifen von Spielern ist hier nicht erlaubt!\n");
      return 1;
  }
  /* Kill him */
  Kill(eob);
  return 1;
}

nosave int stop(string str)
{
  if (InFight())
  {
    write("Mitten im Kampf kannst Du das nicht!\n");
    return 1;
  }
  if (!str)
  {
    StopHuntingMode();
    write("Ok.\n");
    return 1;
  }
  if (!StopHuntFor(str)) write("So jemanden verfolgst Du nicht!\n");
  return 1;
}

int emote(string str,int genitiv)
{
  string *commands, verb;
  mixed from, message;
  mixed living;
  int i, size;

  if (!(Query(P_CAN_FLAGS) & CAN_EMOTE))
    return 0;

  genitiv = (query_verb()[0]==';'||query_verb()[0..5]=="gemote");
  if (query_verb()[0] == ':' || query_verb()[0] == ';')
    verb = query_verb()[1..] + " ";
  else
    verb = "";

  // Der Text (bzw. die durch '#' getrennten Bestandteile):
  str = this_player()->_unparsed_args();
  commands = explode(verb + (str || ""), "#");

  // Namenspraefix:
  from = (IS_SEER(ME) ? "" : ">") + Name(genitiv ? WESSEN : WER);

  // Anderer Text fuer Spieler als fuer Magier, wenn invis:
  if (QueryProp(P_INVIS))
    from =
      ({
         from,
         "(" + capitalize(getuid()) +
         (genitiv ? (member( ([ 'x','s','z' ]), getuid()[<1] ) ? "'" : "s")
                  : "") + ")"
      });
  else
    from = ({ from, from });

  // Der Text, erst der fuer Spieler, dann der fuer Magier:
  message =
    ({
      break_string(from[0] + " " + commands[0], 78),
      break_string(from[1] + " " + commands[0], 78)
    });

  // Anderer Text fuer eine bestimmte Person?
  if ((size = sizeof(commands)) >= 3)
  {
    living = find_living(lower_case(commands[1])) ||
             match_living(lower_case(commands[1]),1);

    if (stringp(living))
      living = find_living(living);

    if (!objectp(living) || environment(living) != environment())
    {
      write(capitalize(commands[1])+" ist hier nicht!\n");
      return 1;
    }

    if (living != ME)
      tell_object(living,
          break_string( from[IS_LEARNING(living) ? 1 : 0] +
                        " " + commands[2], 78));
  }

  // Optional anderer Text fuer einen selbst:
  if (size >= 4)
    write(break_string(commands[3], 78));
  else
    write(break_string(from[1] + " " + commands[0], 78));

  // Text fuer Rest im Raum:
  living = all_inventory(environment()) - ({ ME, living });
  living = filter_array(living, #'living);
  for (i = sizeof(living); i-->0; )
    living[i]->Message(message[IS_LEARNING(living[i]) ? 1 : 0], MSGFLAG_SAY);

  return 1;
}

nosave int remote(string str, int flag)
{
  int m;
  string ret, verb, dest, message;
  string *exstr;
  object destpl;
  mixed xname;

  if ( !(Query(P_CAN_FLAGS) & CAN_REMOTE) )
    return 0;

  if (!IS_LEARNER(ME) && (QueryProp(P_QP) < QM->QueryMaxQP()))
    return 0;

  str = _unparsed_args();
  verb = query_verb();
  if ((verb[1]==':' || verb[1]==';') && strlen(verb) > 2) {
    if (str) str = verb[2..]+" "+str;
    verb = verb[0..1];
  }

  if ( !str || sizeof( (exstr=efun::explode(str," ")) - ({""}) ) <= 1 )
  {
    write("Was willst Du zu wem `emoten`?\n");
    return 1;
  }

  dest = lower_case(exstr[0]);
  if (sizeof(xname = explode(dest, "@")) < 2)
  {
    if(!(destpl=find_player(match_living(dest,1))) ||
        (destpl->QueryProp(P_INVIS) && !IS_LEARNER(ME)))
    {
      write("Einen solchen Spieler gibt es derzeit nicht.\n");
      return 1;
    }
    if (destpl == ME)
    {
      write("Bist Du wirklich so weit von Dir entfernt?\n");
      return 1;
    }
    if (environment() == environment(destpl))
    {
      write("Innerhalb eines Raumes solltest Du "+verb[1..]+
        " benutzen.\n");
      return 1;
    }
  }

  str = implode(exstr[1..]," ");
  if ( member( str, '#' ) == -1 && member( str, '^' ) == -1 ) str += " #";
  str = regreplace( str, "#", "aus der Ferne", 1 );
  str = regreplace( str, "\\^", "in der Ferne", 1 );

  if ( destpl )         // lokal
  {
    if ( QueryProp(P_INVIS) && IS_LEARNER(destpl) )
      message = "(" + capitalize(getuid(ME)) +
          (flag ? (strstr("xsz",getuid(ME)[<1..])!=-1 ? "'" : "s") : "") + ")";
    else
      message = (flag ? Name(WESSEN) : Name(WER));

    message += " " + str + (member( ".?!", str[<1] ) == -1 ? "." : "") + "\n";

    if ( (m = destpl->Message( message, MSGFLAG_REMOTE )) > 0 )
      write(break_string(destpl->Name()+"->"+message, 78));
    else if (m == MESSAGE_CACHE)
      write(destpl->Name()+" ist gerade beschaeftigt.\n");
    else if (m == MESSAGE_IGNORE_YOU)
      write(destpl->Name()+" ignoriert Dich.\n");
    else
      write(destpl->Name()+" ignoriert Deine Meldung.\n");
  }
  else                  // remote
  {
    message = str + (member( ".?!", str[<1] ) == -1 ? "." : "");

    if (ret = (string) INETD->send_udp(xname[1],
          ([ REQUEST:   "tell",
             RECIPIENT: xname[0],
             SENDER:    getuid(ME),
             METHOD:    flag ? "gemote" : "emote",
             DATA:      sprintf("*%s* ", message) ]), 1))
      write(ret);
    else
      write("Nachricht abgeschickt.\n");
  }
  return 1;
}

nosave int gemote(string str)
{
  return emote(str, 1);
}

nosave int rgemote(string str)
{
  return remote(str, 1);
}

nosave void updates_after_restore()
{
  // div. Module updaten lassen:
  potion::create();
  attributes::update_max_sp_and_hp();
  // Property-F_MODE's, die frueher anders definiert waren, umsetzen:
  Set(P_MARRIED,        PROTECTED,      F_MODE_AS);
  Set(P_WANTS_TO_LEARN, PROTECTED,      F_MODE_AS);
  Set(P_NAME,           SECURED,        F_MODE_AS);
  Set(P_NAME_ADJ,       PROTECTED,      F_MODE_AS);
  Set(P_INVIS,          PROTECTED,      F_MODE_AS);
  Set(P_NEEDED_QP,      -1,             F_SET_METHOD);
  Set(P_NEEDED_QP,      SAVE|SECURED,   F_MODE_AS);
}

varargs nomask int start_player(string str, string ip, int invis_login)
{
  int newflag, invis;   // could player be restored? / invis before restore?
  string prev;

  startup_telnet_negs();
  ME->modify_prompt();

  prev = explode(file_name(previous_object()),"#")[0];
  if ((prev != "/secure/login") &&
      (prev != "/secure/master") &&
      (!geteuid(ME) || geteuid(ME) != getuid(ME) ||
       capitalize(geteuid(ME)) != str ||
       geteuid(ME) != geteuid(previous_object())))
  {
    write("DIESER VERSUCH WAR ILLEGAL !!\n");
    destruct(ME);
    return 0;
  }

  // try to restore player. If it doesn't exist, set the new flag.
  invis = QueryProp(P_INVIS);
  newflag = !restore_object(
      sprintf("/" SAVEPATH "%c/%s", str[0] | 0x20, lower_case(str)) );

  // Schonmal sichern, falls ein Bug (Evalcost...) dazwischen kommen sollte.
  autoload_rest = autoload;

  if (!QueryProp(P_INVIS))
  {
    if (invis)
      SetProp(P_INVIS, invis);
    else if (invis_login && IS_WIZARD(ME))
      SetProp(P_INVIS, QueryProp(P_AGE));
  }
  else if (!IS_WIZARD(ME))
    SetProp(P_INVIS, 0);

  // Dinge, die nach dem restore_object() zu erledigen sind, nachholen
  // (Property-F_MODEs, etc.)
  updates_after_restore();

  // Save-Intervall auf +500 Heartbeats setzen, IP merken
  time_to_save = age + 500;
  my_ip = ip;

  AddId(getuid());
  Set(P_NAME, str);

  if (query_once_interactive(ME))
    Set(P_LAST_LOGIN, time());

  if (IS_WIZARD(ME) && !QueryProp(P_WANTS_TO_LEARN))
    Set(P_WANTS_TO_LEARN, 1);

  if (IS_SEER(ME))
    SetProp(P_CAN_FLAGS, QueryProp(P_CAN_FLAGS) | CAN_REMOTE);

  if (!QueryProp(P_NEEDED_QP))
    SetProp(P_NEEDED_QP, QM->QueryNeededQP());

  // Ein paar Property-Werte, zur Sicherheit:
  SetProp(P_AC, 0);
  SetProp(P_WEAPON, 0);
  // wird eigtl. schon in attributes::update_max_sp_and_hp() gesetzt:
  SetProp(P_MAX_HP, ((int) QueryAttribute(A_CON)) * 8 + 42);
  SetProp(P_MAX_SP, ((int) QueryAttribute(A_INT)) * 8 + 42);

  // das ist fuer Gaeste hier zu frueh!!! Zordan
  // call_out("delayed_notify",0,getuid(ME));

  if (newflag)
  {
    funcall(#'Set, P_LEVEL, -1 /*'*/);
    SetProp(P_ATTRIBUTES, ([ A_STR:1, A_CON:1, A_INT:1, A_DEX:1 ]) );
    SetProp(P_HP, QueryProp(P_MAX_HP));
    SetProp(P_WIMPY, 20);
    if (IS_WIZARD(ME))
      set_is_wizard(ME,1);
    else
      set_is_wizard(ME,0);
  }
  move_player_to_start(0);
  catch(bb="/secure/bbmaster"->query_bb());
}

nosave void delayed_notify(string wer, int war_invis)
{
  if (war_invis == QueryProp(P_INVIS))
    catch("/secure/merlin"->notify_player_enter(wer,QueryProp(P_INVIS)));
  // andernfalls kamen die Ausgaben schon vom vis/invis Befehl
}

nosave int move_player_to_start5(string where)
{
  int num, lastnew, str;
  string called_from_ip, called_from_ip_name;
  mixed err, start_place, second;
  object mon;

  if (QueryProp(P_LEVEL) < 1)
  {
    // catch("/std/gilde"->advance("stufe"));
    // catch(call_other("/gilden/"+(QueryProp(P_DEFAULT_GUILD)||DEFAULT_GUILD),
    //                  "advance", "stufe"));
    funcall(#'Set, P_LEVEL, 1 /*'*/);
    funcall(#'Set, P_TITLE, 0 /*'*/);
    funcall(#'Set, P_GUILD_TITLE, /*'*/
        ([ QueryProp(P_DEFAULT_GUILD) || DEFAULT_GUILD :
             QueryProp(P_GENDER) == FEMALE ?
               QueryProp(P_DEFAULT_GUILD_FEMALE_TITLES)[0] :
               QueryProp(P_DEFAULT_GUILD_MALE_TITLES)[0]
        ]) );

    if (QueryGuest())
      funcall(#'SetProp, P_TITLE, "durchstreift das "+MUDNAME+"..." /*'*/);
    else
      catch("obj/infomaster"->InfoMsg(
            sprintf( "%s %s wurde gerade geboren.",
              QueryProp(P_RACESTRING)[0],
              capitalize(getuid()) ) ));
  }

  enable_commands();

  set_heart_beat(1);
  command::initialize();
  add_put_and_get_commands();
  add_soul_commands();
  add_action("UseSpell","",1);
  if (interactive(this_object()))
  {
    if (IS_WIZARD(this_object()))
      cat("/etc/WIZNEWS");
    else
      cat("/etc/NEWS");
    if (query_ip_number(ME)=="127.0.0.1")
      cat("/etc/NEWS.localhost");

    if (num="secure/mailer"->FingerMail(getuid())) {
      if (lastnew="secure/mailer"->LastNewMail(geteuid()))
        write("  __ /  Du hast "+num+" neue"+(num==1 ? "n Brief":" Briefe")+
              " am Postamt liegen.\n"
              " |__|   Letzter Brief am "+dtime(lastnew)+" eingetroffen.\n\n");
      else
        write("  __ /\n"
              " |__|   Du hast "+num+" neue"+(num==1 ? "n Brief" : " Briefe")+
              " am Postamt liegen.\n\n");
    }
    catch(RegisterChannels());
    // printf("%O:%O\n",ME,query_ip_name());
    called_from_ip = QueryProp(P_CALLED_FROM_IP);
    called_from_ip_name = QueryProp(P_CALLED_FROM_IP_NAME);
    if (called_from_ip || called_from_ip_name)
      write(sprintf("Das letzte Mal kamst Du von %s (%s).\n\n",
        (called_from_ip_name || "unbekannt"),
        (called_from_ip || "unbekannt")));
    funcall(#'Set, P_CALLED_FROM_IP, query_ip_number()); //');
    funcall(#'Set, P_CALLED_FROM_IP_NAME, query_ip_name(ME)); //');
  }
  set_living_name(getuid());
  if (!stringp(default_home) || !strlen(default_home))
    default_home="gilden/abenteurer";
  err=0;

  start_place=QueryProp(P_START_HOME);

  if (!start_place && IS_SEER(ME) && !IS_LEARNER(ME))
    if (catch(start_place=SEERHOUSEMASTER->HasHouse(getuid(ME))))
      start_place=0;

  if (start_place && (objectp(start_place)
                      || (stringp(start_place) && start_place != "")))
  {
    if ((err=catch(move(start_place, M_GO|M_NOCHECK|M_SILENT|M_NO_SHOW)))
        || !environment())
      err=catch(move(default_home, M_GO|M_NOCHECK|M_SILENT|M_NO_SHOW));
  }
  else
    err=catch(move(default_home,M_GO|M_NOCHECK|M_SILENT|M_NO_SHOW));
  if (err) catch(move("gilden/abenteurer",M_GO|M_NOCHECK|M_SILENT|M_NO_SHOW));

  // Zeit fuer letzte Einstellungen am Spielerobjekt
  catch(ME->FinalSetup());

  // Um Geld-Xties mit illegal viel Geld zu vermeiden, kommt ein Check:
  if ( !IS_LEARNER(ME) && !Query(P_TESTPLAYER) && mon=present("\ngeld", ME) )
  {
    // maximale Kraft, die der Spieler haette haben koennen
    if ( (str=QueryProp(P_LEVEL)/10+1) > 5 )
      str = 5;
    str += QueryAttribute(A_STR);
    if ( QueryProp(P_FROG) ) str += 20;
    if ( str < 1 ) str = QueryRealAttribute(A_STR) + 5;
    if ( str > A_MAX_MODIFIED ) str = A_MAX_MODIFIED;

    // Wieviel konnte der Spieler insgesamt maximal tragen?
    num = 9200 + str * 800;
    if ( num < 3000 ) num = 3000;

    // Verdoppeln fuer einen guten Container und nochmal 20% draufschlagen
    // zur Sicherheit. Das Ganze danach *4, um die maximale Anzahl Muenzen
    // zu erhalten.
    num = num * 48 / 5;         // 48/5 = 9.6 (=2*1.2*4)

    // Geld, das zuviel ist, auf den Maximalwert kuerzen.
    // Zur Sicherheit wird mitgeloggt. Falls ein Spieler sich (zu recht)
    // beschwert, kann man immer noch wieder die Summe korrigieren ;-)
    if ( (str = mon->QueryProp(P_AMOUNT)) > num )
    {
      mon->SetProp( P_AMOUNT, num );
      log_file( "interactive/ZUVIEL_GELD",
          sprintf( "%s: %s hatte %d Muenzen bei sich."
                   " Korrigiert auf %d.\n ",
                   ctime(time())[4..], capitalize(getuid(ME)), str, num ) );
    }
  }

  // Entschaedigung - sowie deren Tragbarkeit ueberpruefen :)
  if (ndead_lasttime)
  {
    write("Du findest "+ndead_lasttime+
        " Muenzen, die Du beim letzten Mal verloren hast.\n");

    if ( MayAddWeight( ndead_lasttime / 4 ) )
    {
      write( "Weil Du nicht mehr soviel tragen kannst, spendest Du den "
          "Rest der Zentralbank.\n" );

      num = (QueryProp(P_MAX_WEIGHT) - query_weight_contents()) * 4;
      ndead_lasttime = (num < 0) ? 0 : num;
    }
    AddMoney( ndead_lasttime );
    ndead_lasttime=0;
  }

  // Zweitiemarkierung ueberpruefen:
  if ( !IS_LEARNER(ME) && (second = QueryProp(P_SECOND)) )
  {
    err = 0;
    if (!stringp(second)) {
      err = "NO_STRING";
      write("Deine Zweitspielermarkierung muss auf einen Namen gesetzt sein!\n");
    }
    else
    {
      second = lower_case(second);
      if (second[0..3] == "von ") second = second[4..];
      if (!MASTER->get_userinfo(second)) {
        err = "1ST_DELETED";
        write(
            "Der Charakter, als dessen Zweitspieler Du markiert warst,\n"
            "existiert offenbar nicht mehr!\n\n");
      }
      if (second == getuid(ME)) {
        err = "SELF";
        write("Du kannst nicht als Dein eigener Zweitspieler markiert sein!\n");
      }
    }
    if (err)
    {
      log_file( "irregular/WRONG_SECOND",
          sprintf( "%s: %s [%s], P_SECOND = %s\n",
            ctime(time())[4..], err, capitalize(getuid(ME)),
            regreplace(sprintf("%O",QueryProp(P_SECOND)),"\n *"," ",1) ) );
      SetProp(P_SECOND, 0);
      write(
          "Die Markierung wurde daher geloescht, bitte aendere dies und sprich\n"
          "im Zweifel einen Erzmagier darauf an! Eine nicht gesetzte Markierung\n"
          "bei einem Zweitspieler kann zum Ausschluss vom Spiel fuehren!\n\n");
    }
    else if (capitalize(second) != QueryProp(P_SECOND))
      SetProp(P_SECOND, capitalize(second));
  }

  if (!QueryProp(P_INVIS))
    say(capitalize(name(WER)) + " betritt diese Welt.\n");
  else
    write("DU BIST UNSICHTBAR!\n\n");

  // hier ist das Objekt auf alle Faelle geladen. Jetzt erst das inform bitte :)
  call_out("delayed_notify",0,getuid(ME),QueryProp(P_INVIS));

  /*
  if (query_mud_port(this_player())==4711)
    write("...");
  */
  if (IS_WIZARD(getuid(ME)))
    set_is_wizard(ME,1);
  else
    set_is_wizard(ME,0);

  if ( query_once_interactive(ME) )
    ListAwaited();

  save_me(1);   // nach erfolgter Initialisierung abspeichern

  // Autoloader werden ganz zum Schluss geclont, da das bis zum bitteren
  // (Evalcost-)Ende geschieht und danach u.U. keine Rechenzeit fuer
  // andere Aktionen mehr ueber ist
  load_auto_objects( autoload );
}


/*
 * Checks for several player info:
 * - email address
 * - gender
 * - terminal
 * - second entry
 */
nosave int move_player_to_start(string where)
{
  string mailaddr;

  if (QueryProp(P_CARRIED_VALUE) > 0)
  {
    ndead_lasttime = QueryProp(P_CARRIED_VALUE);
    SetProp(P_CARRIED_VALUE, 0);
  }
  if (file_time("/save/"+getuid()[0..0]+"/"+getuid()+".o") <
      last_reboot_time()) {
    SetProp(P_FOOD, 0);
    SetProp(P_DRINK, 0);
    SetProp(P_ALCOHOL, 0);
    SetProp(P_BLIND, 0);
    SetProp(P_DEAF, 0);
    SetProp(P_POISON, 0);
    SetProp(P_GHOST, 0);
    SetProp(P_FROG, 0);
    Set(P_PARALYZED, 0);
    SetProp(P_MV, QueryProp(P_MAX_MV));
  }
  if (QueryGuest())
    Set(P_MAILADDR,"none");
  else if ((this_object() == this_player()) &&
           (!(mailaddr = Query(P_MAILADDR)) || mailaddr == ""))
  {
    write("Gib bitte Deine E-Mail-Adresse an (oder 'none'): ");
    saved_where = where;
    input_to("getmailaddr");
    return 0;
  }
  move_player_to_start2(where);
}
nosave void getmailaddr(string maddr) {
  if (!stringp(maddr) || !strlen(maddr))
    maddr = "none";
  Set(P_MAILADDR, maddr);
  move_player_to_start2(saved_where);
}

nosave void move_player_to_start2(string where)
{
  /*
  tell_object(find_player("woody"),
      sprintf( "mpts2(): %O: TP=%O, TI=%O\n"+
               "         uid(to)=%O, uid(tp)=%O, uid(ti)=%O\n",
        this_object(), this_player(), this_interactive(),
        getuid(this_object()),
        this_player() ? getuid(this_player()) : 0,
        this_interactive() ? getuid(this_interactive()) : 0 ));
  */

  if ( (this_object() == this_player()) &&
       (member_array( QueryProp(P_GENDER), ({MALE,FEMALE}) ) == -1) )
  {
    write("Bist Du maennlich oder weiblich: ");
    saved_where = where;
    input_to("getgender", 0);
    return;
  }
  move_player_to_start3(where);
}

/*  This function is called using input_to, and sets the
 *  gender of this player.
 */
nosave void getgender(string gender_string) {

  gender_string = lower_case(gender_string);
  if (gender_string[0] == 'm') {
    write("Willkommen, mein Herr!\n");
    SetProp(P_GENDER,MALE);
  }
  else if (gender_string[0] == 'w') {
    write("Willkommen, gnae' Frau!\n");
    SetProp(P_GENDER,FEMALE);
  }
  else {
    write("Wie? Was? Verstehe ich nicht!\n");
    write("Bist Du maennlich oder weiblich? (tippe m or w): ");
    input_to("getgender");
    return;
  }
  if (QueryGuest())
    write("Dein Name ist nun " + capitalize(getuid()) + ".\n");
  move_player_to_start3(saved_where);
}

nosave void move_player_to_start3(string where)
{
  if ( (this_object() == this_player()) &&
       (!QueryProp(P_TTY) || QueryProp(P_TTY) == "none") )
  {
    write("Waehle einen Terminaltyp "
        "(kann spaeter mit <stty> geaendert werden)\n");
    write("vt100, ansi, dumb [dumb] ");
    saved_where = where;
    input_to("gettty", 0);
    return;
  }
  move_player_to_start4(where);
}

/*  This function is called using input_to, and sets the
 *  tty of this player.
 */
nosave void gettty(string ttystr) {
  if (!ttystr || ttystr == "") ttystr = "dumb";
  ttystr = lower_case(ttystr);
  if (ttystr == "vt100") {
    write("Dies sollte "+ANSI_BOLD+"fett"+ANSI_NORMAL+" sein.\n");
    SetProp(P_TTY, ttystr);
  }
  else if (ttystr == "ansi") {
    write("Dies sollte "+ANSI_RED+"rot"+ANSI_NORMAL+" sein.\n");
    SetProp(P_TTY, "ansi");
  }
  else if (ttystr == "dumb") {
    write("Ohje, oede! Besorg Dir ein besseres Terminal!\n");
    SetProp(P_TTY, "dumb");
  }
  else {
    write("Dieser Terminaltyp wird nicht unterstuetzt. "
        "Nimm bitte einen aus:\n");
    write("vt100, ansi or dumb (default is dumb): ");
    input_to("gettty");
    return;
  }
  move_player_to_start4(saved_where);
}

string *_query_hair_colors() {
  return ({ "blond", "braun", "schwarz" });
}

string *_query_eye_colors() {
  return ({ "gruen", "blau", "braun" });
}

nosave void move_player_to_start4(string where)
{
  int var, avsize, avweight;
  string size_desc, weight_desc;
  string *augenfarben, *haarfarben;
  int size;
  int weight;
  string eye_color;
  string hair_color;

  if ( (this_object() != this_player()) ||
       ( QueryProp(P_WEIGHT) && QueryProp(P_SIZE) &&
         QueryProp(P_HAIR_COLOR) && QueryProp(P_EYE_COLOR) ) )
  {
    move_player_to_start5(where);
    return;
  }
  avsize = QueryProp(P_AVERAGE_SIZE) || 180;
  avweight = QueryProp(P_AVERAGE_WEIGHT) || 70000;
  augenfarben = QueryProp("eye_colors");
  haarfarben = QueryProp("hair_colors");
  var = avsize / 15 + 1;
  size = avsize + random(var) - random(var) + random(var) - random(var) +
    ((!random(20)) * var) - ((!random(20)) * var);
  var = avweight / 15 + 1;
  weight = avweight + random(var) - random(var) + random(var) - random(var) +
    ((!random(20)) * var) - ((!random(20)) * var) -
    (QueryProp(P_GENDER) == FEMALE ? var / 2 + random(var) : 0);

  switch(1000 * size / avsize)
  {
    case 0..800: size_desc="ziemlich winzig"; break;
    case 801..850: size_desc="eher winzig"; break;
    case 851..900: size_desc="recht klein"; break;
    case 901..950: size_desc="eher klein"; break;
    case 951..1050: size_desc="mittelgross"; break;
    case 1051..1100: size_desc="relativ gross"; break;
    case 1101..1150: size_desc="ziemlich gross"; break;
    case 1151..1200: size_desc="sehr gross"; break;
    default: size_desc="riesig"; break;
  }
  switch(1000 * weight / avweight)
  {
    case 0..800: weight_desc="ein Fliegengewicht"; break;
    case 801..850: weight_desc="sehr leicht"; break;
    case 851..900: weight_desc="recht leicht"; break;
    case 901..950: weight_desc="eher leicht"; break;
    case 951..1050: weight_desc="mittelschwer"; break;
    case 1051..1100: weight_desc="relativ schwer"; break;
    case 1101..1150: weight_desc="ziemlich schwer"; break;
    case 1151..1200: weight_desc="sehr schwer"; break;
    default: weight_desc="uebergewichtig"; break;
  }
  eye_color = augenfarben[random(sizeof(augenfarben))];
  hair_color = haarfarben[random(sizeof(haarfarben))];

  saved_where = where;
  if (QueryGuest())
    get_race_description("ja", size, weight, eye_color, hair_color);
  else
  {
    write(break_string("Du bist nun "+size_desc+", "+ weight_desc+", hast "+
          hair_color+"e Haare und "+eye_color+"e Augen.",78));
    write("Bist Du damit zufrieden? (ja/nein) ");
    input_to("get_race_description", 0, size, weight, eye_color, hair_color);
  }
}

nosave varargs void get_race_description(string str, int size, int weight,
                                         string eye_color, string hair_color)
{
  if ( str == "ja" || str == "j" )
  {
    SetProp(P_WEIGHT, weight);
    Set(P_WEIGHT,SAVE|PROTECTED,F_MODE_AS);
    SetProp(P_SIZE, size);
    Set(P_SIZE,SAVE|PROTECTED,F_MODE_AS);
    SetProp(P_EYE_COLOR, eye_color);
    Set(P_EYE_COLOR,SAVE|PROTECTED,F_MODE_AS);
    SetProp(P_HAIR_COLOR, hair_color);
    Set(P_HAIR_COLOR,SAVE|PROTECTED,F_MODE_AS);
    move_player_to_start5(saved_where);
  }
  else
//    call_out("move_player_to_start4",0, saved_where);
    move_player_to_start4(saved_where);
}

public int ResetRaceDescription()
{
  mixed *ui;

  // nur erlaubt bei validen Spielerobjekten mit geaenderter Shell
  ui = MASTER->get_userinfo(getuid());
  if (!pointerp(ui)) return 0;
  if (!stringp(ui[4])) return 0;
  if (ui[4][11..] == explode(file_name(this_object()),":")[0])
    if (!ARCH_SECURITY)
      return 0;

  SetProp(P_SIZE, QueryProp(P_AVERAGE_SIZE) || 180);
  SetProp(P_WEIGHT, QueryProp(P_AVERAGE_WEIGHT) || 70000);
  SetProp(P_EYE_COLOR, 0);
  SetProp(P_HAIR_COLOR, 0);
  return 1;
}

nomask mixed query_real_name() {
  /* ACHTUNG !! DIES LFUN DARF NICHT ENTFERNT WERDEN !!! */
  /* Sie wird vom Gamedriver (zB bei F_ED) aufgerufen !! */
  return getuid();
}

/*
 * the wizard command review: show player moving messages
 */

int review() {
  string *msg;
  write(short());
  write("Deine Bewegungen werden wie folgt gemeldet:\n"+
        "mout:  "+Name(WER)+" "+(msg=explode(QueryProp(P_MSGOUT),"#"))[0]
       +" <Richtung>"+(sizeof(msg)>1 ? msg[1] : "")+".\n"+
        "min:   "+Name(WER)+" "+QueryProp(P_MSGIN)+".\n"+
        "mmout: "+Name(WER)+" "+QueryProp(P_MMSGOUT)+".\n"+
        "mmin:  "+Name(WER)+" "+QueryProp(P_MMSGIN)+".\n"+
        (IS_LEARNER(ME) ?
	 "cmsg:  "+Name(WER)+" "+QueryProp(P_CLONE_MSG)+".\n"+
	 "dmsg:  <Irgendetwas> "+QueryProp(P_DESTRUCT_MSG)+".\n"
	 : "")+
        "Wenn Du jemanden angreifst, sieht das so aus:\n"+
        Name(WER)+" greift Dich"+QueryProp(P_HANDS)[0]+" an.\n");
  return 1;
}

/*
 * set player moving messages
 */

nosave int setmin(string str)
{
  if( strlen(_unparsed_args()) > 65 )
  {
    write("Das ist leider zu lange.\n");
    return 1;
  }
  SetProp(P_MSGIN, _unparsed_args()||"kommt an");
  write("Ok, min:   "+Name(WER)+" "+QueryProp(P_MSGIN)+".\n");
  return 1;
}

nosave int setmout(string str)
{
  string *msg;
  if( strlen(_unparsed_args()) > 50 )
  {
    write("Das ist leider zu lange.\n");
    return 1;
  }
  if(sizeof(msg=explode((_unparsed_args()||"geht"),"#"))>2)
  {
    write("Du darfst nur einmal '#' fuer die Richtung angeben.\n");
    return 1;
  }
  if(sizeof(msg)>1)
  {
    if (msg[0]!="" && msg[0][<1]==' ') msg[0]=msg[0][0..<2];
    SetProp(P_MSGOUT, msg[0]+"#"+msg[1]);
  }
  else
    SetProp(P_MSGOUT, _unparsed_args()||"geht");
  write("Ok, mout:  "+Name(WER)+" "+(msg=explode(QueryProp(P_MSGOUT),"#"))[0]
       +" <Richtung>"+(sizeof(msg)>1 ? msg[1] : "")+".\n");
  return 1;
}

nosave int setmmin(string str)
{
  if( strlen(_unparsed_args()) > 65 )
  {
    write("Das ist leider zu lange.\n");
    return 1;
  }
  SetProp(P_MMSGIN, _unparsed_args()||"erscheint");
  write("Ok, mmin:  "+Name(WER)+" "+QueryProp(P_MMSGIN)+".\n");
  return 1;
}

nosave int setmmout(string str)
{
  if( strlen(_unparsed_args()) > 65 )
  {
    write("Das ist leider zu lange.\n");
    return 1;
  }
  SetProp(P_MMSGOUT, _unparsed_args()||"verschwindet");
  write("Ok, mmout: "+Name(WER)+" "+QueryProp(P_MMSGOUT)+".\n");
  return 1;
}

nosave int setcmsg(string str)
{
  SetProp(P_CLONE_MSG, _unparsed_args() ||
      "zaubert etwas aus " + QueryPossPronoun(MALE,WEM) + " Aermel hervor");
  write("Ok, cmsg: "+Name(WER)+" "+QueryProp(P_CLONE_MSG)+".\n");
  return 1;
}

nosave int setdmsg(string str)
{
  SetProp(P_DESTRUCT_MSG, _unparsed_args() ||
      "wird von " + name(WEM,1) + " zerstaeubt");
  write("Ok, dmsg: "+Name(WER)+" "+QueryProp(P_DESTRUCT_MSG)+".\n");
  return 1;
}

nosave int set_title(string str)
{
  string bonus;
  if( strlen(_unparsed_args()) > 50 )
  {
    write("Das ist leider zu lange.\n");
    return 1;
  }
  if( strlen(_unparsed_args()) + strlen(QueryProp(P_PRESAY)) > 65  )
  {
    write("Zusammen mit Deinem Presay ist das leider zu lange.\n");
    return 1;
  }
  bonus = "";
  if (!(str=_unparsed_args()))
    str = "";
  else if( str[0..2]=="\\b," || str[0..2]=="\\b'" )
  {
    bonus = "\b"; // ein Backspace fuer ein (Hoch-) Komma ist ok! :-)
    str = str[2..];
  }
  if (str=="0")
    SetProp(P_TITLE, 0);	// (Gildentitel wird dann angezeigt)
  else
    SetProp(P_TITLE, bonus+str);
  write("Dein Titel lautet jetzt: \""+QueryProp(P_TITLE)+"\".\n");
  write(short());
  return 1;
}

#ifdef NEDIT_FOR_EXTRALOOK

nosave int done_extralook(string str)
{
  if (!str) {
    write("Ok, abgebrochen.\n");
    return 1;
  }
  if (str=="")
    SetProp(P_EXTRA_LOOK,0);
  else
    SetProp(P_EXTRA_LOOK,str);
  write("Ok.\n");
  return 1;
}

nosave int extralook(mixed str)
{
  if( str=="?" )
  {
    write( "Dein Extralook ist:\n"+QueryProp(P_EXTRA_LOOK) );
    return 1;
  }
  write("Bitte gib Deinen Extra-Look ein. Hilfe mit ~h. Beenden mit **:\n");
  nedit("done_extralook", QueryProp(P_EXTRA_LOOK));
  return 1;
}

#else

nosave int extra_input(string str, string look)
{
  if (str=="**" || str==".")
  {
    if (look=="")
      SetProp(P_EXTRA_LOOK,0);
    else
      SetProp(P_EXTRA_LOOK,look);
    write("Ok.\n");
    return 1;
  }
  else if (str=="~h") {
    write("Der Mini-Editor versteht folgende Befehle:\n"
          "~h       Hilfe\n"
          "~r       Zeige gesamten Text an\n"
          "~d       Loesche letzte Zeile\n"
          "~c       Loesche gesamten Text\n"
          "~q       Abbruch\n"
          ". / **   Sauber beenden\n");
  }
  else if (str=="~r") {
    write("Das hast Du bisher geschrieben:\n"+
        "--------------------------\n"+look+
        "--------------------------\n");
  }
  else if (str=="~c") {
    write("Gesamten Text geloescht.\n");
    look="";
  }
  else if (str=="~d") {
    if (strlen(look)) {
      write("Vorherige Zeile geloescht.\n");
      look=implode(efun::explode(look,"\n")[0..<3],"\n");
    }
    else
      write("Du kannst nicht nichts loeschen.\n");
    if (strlen(look)) look+="\n";
  }
  else if (str=="~q") {
    write("Abbruch! Dein Extra-Look bleibt unveraendert.\n");
    return 1;
  }
  else
    look=look+str+"\n";
  write("]");
  input_to("extra_input",0,look);
  return 1;
}

nosave int extralook(mixed str)
{
  string look;
  look=QueryProp(P_EXTRA_LOOK);
  if (str=="?")
  {
    if (!stringp(look)) write("Du hast keinen Extra-Look.\n");
    else write("Dein Extra-Look ist:\n"+look);
  }
  else if (str=="loeschen") {
    SetProp(P_EXTRA_LOOK,0);
    write("Ok, Extra-Look geloescht.\n");
  } else {
    if (str=="neu") look="";
    write("Bitte gib Deinen Extra-Look ein. Hilfe mit ~h, beenden mit **:\n"+
        (stringp(look) && strlen(look) ?
         "--------------------------\n"+look : "")+"]");
    input_to("extra_input", 0, look || "");
  }
  return 1;
}

#endif

nosave void calculate_value()
{
  int i, carried_value, value;
  object *inv;

  inv = deep_inventory(ME);
  carried_value = 0;
  for (i = sizeof(inv); i-->0; )
    if (!inv[i]->QueryProp(P_AUTOLOADOBJ))
      carried_value+=((value=inv[i]->QueryProp(P_VALUE))>1000?1000:value);
  SetProp(P_CARRIED_VALUE, carried_value);
}

/* Called by command 'save' */
int save_character() {
  save_me(1);
  write("Ok.\n");
  return 1;
}

void save_me(mixed value_items)
{
  object *obs;
  mixed val;
  string obnam, dummy;
  int i;

  if( getuid()[0..3]=="gast" )
    return;
  autoload=([]);
  obs=deep_inventory(ME);
  for( i=sizeof(obs)-1;i>=0;i--)
  {
    if( val = obs[i]->QueryProp( P_AUTOLOADOBJ ) )
    {
      if( sscanf( file_name( obs[i] ), "%s#%s", obnam, dummy )==2  )
      {
        if (obnam=="/obj/money")
          autoload[obnam] += val;
        else
          autoload += ([file_name(obs[i]) : val]);
      }
    }
  }
  // An noch nicht geclonte Autoloader denken!
  autoload += autoload_rest;

  if (value_items)
    calculate_value();
  else
    SetProp(P_CARRIED_VALUE, 0);
  // Set(P_LAST_LOGOUT,time());
  catch(call_other(GUILD_DIR+QueryProp(P_GUILD), "GuildRating", this_object()));
  save_object("/"+SAVEPATH+extract(getuid(),0,0)+"/" + getuid());
}

private nosave void auto_failed(string filename, mixed data, string bug)
{
  // Mitloggen zwecks Bereinigung
  log_file( "interactive/AUTOLOAD_FAILED",
      sprintf( "%s: %s %s [%s], Data = %s\n",
        ctime(time())[4..], bug, filename, capitalize(getuid(ME)),
        regreplace(sprintf("%O",data),"\n *"," ",1) ) );

  // Von Liste runter, da sonst Endlos-call_out-Verkettung
  efun::m_delete( autoload_rest, filename );
}

nosave void load_auto_object(string filename, mixed data)
{
  object ob;
  string file, dummy;
  int ret;

  if (!sscanf(filename, "%s#%s", file, dummy))
    file = filename;

  ob = find_object(file);
  if (!ob && catch(call_other(file,"???"))) {
    auto_failed( filename, data, "LOADFAIL" );
    return;
  }

  if (catch(ob = clone_object(file))) {
    auto_failed( filename, data, "CLONFAIL" );
    return;
  }

  if (catch(ret=ob->move(ME,M_NOCHECK)) || (ret<0)) {
    auto_failed( filename, data, "MOVEFAIL" );
    return;
  }

  if (ob)
    (void) catch(ob->SetProp(P_AUTOLOADOBJ, data));

  // Autoloader erfolgreich geladen - kann von der Liste runter.
  efun::m_delete( autoload_rest, filename );

  // nette Meldung an den Spieler
  if (!IS_LEARNER(this_object()) && !ob->QueryProp(P_INVIS) && ob->short())
    tell_object(ME,
        ob->Name(WER) + " materialisier" +
        (ob->IsPlural() ? "en" : "t") + " sich.\n");
}

nosave void load_auto_objects(mapping map)
{
  if ( (!mappingp(map) || !m_sizeof(map)) && !m_sizeof(autoload_rest) )
    return;

  // Mit Netztoten Spielern rechnen manche Autoloader nicht. Also
  // das Clonen unterbrechen und in Reconnect() wieder anwerfen.
  if ( !interactive() )
    return;

  // Kleiner Hack: autoload_rest ist eine globale Variable, die beim
  // Clonen der einzelnen Autoloader direkt veraendert wird.
  // So lange das Mapping noch Eintraege hat, muessen wir noch fehlende
  // Autoloader clonen.
  if ( !m_sizeof(autoload_rest) )
    autoload_rest = map;

  // Schon hier einen call_out() zum "Nach"clonen von noch nicht geclonten
  // Autoloadern starten, da spaeter u.U. keine Rechenzeit mehr dafuer da ist.
  while ( remove_call_out("load_auto_objects") != -1 )
      /* do nothing */;

  // Mit Parameter '0' aufrufen, da das globale Mapping benutzt wird.
  call_out( "load_auto_objects", 0, 0 );

  // Mit catch() gegen die Evalcost-Falle!
  // Mit Absicht das walk_mapping() aus der "alten" Version erhalten und
  // nicht durch eine (einfachere) Schleife inkl. get_eval_cost() ersetzt,
  // da eine Schleife gegenueber der walk_mapping()-Loesung den Aufbau
  // der previous_object()-Kette veraendern wuerde; darauf testen aber
  // manche Objekte.
  catch( walk_mapping( autoload_rest, #'load_auto_object/*'*/ ) );
}

/*
 * al_to_title: Make the numeric alignment value into a string
 */
string al_to_title(mixed a)
{
  if (!intp(a)) return "unbekannt";
  if (a >= KILL_NEUTRAL_ALIGNMENT * 1000)
    return "scheinheilig";
  if (a >= KILL_NEUTRAL_ALIGNMENT * 100)
    return "heilig";
  if (a > KILL_NEUTRAL_ALIGNMENT * 20)
    return "gut";
  if (a > KILL_NEUTRAL_ALIGNMENT * 4)
    return "nett";
  if (a > - KILL_NEUTRAL_ALIGNMENT * 4)
    return "neutral";
  if (a > - KILL_NEUTRAL_ALIGNMENT * 20)
    return "frech";
  if (a > - KILL_NEUTRAL_ALIGNMENT * 100)
    return "boese";
  return "satanisch";
}

