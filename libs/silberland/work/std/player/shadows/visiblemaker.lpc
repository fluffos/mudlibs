// 15.3.2004 Feyaria: short muss auch .\n haben

#include <properties.h>
#include <language.h>


#define DD "feyaria"
#define DEBUG(x) if (find_player(DD)) tell_object(find_player(DD), x+"\n")

object pl;

create()
{
  if (!is_clone(this_object()) )  return;

  pl = this_player();

  call_out("make_visible", 60 + random(60));
  DEBUG(" * visiblemaker: "+pl->Name());
  shadow(pl, 1);
  //  tell_object(find_player("stahldorn"), pl->name());
}

make_visible()
{
  object ob;

  unshadow();
  if(environment(pl))
     tell_room(environment(pl), pl->Name() + " wird sichtbar.\n", ({pl}));
  tell_object(pl, "Du wirst sichtbar.\n");
  remove();
}

varargs string name(int fall, int demon)
{
  switch(fall)
  {
     case WER: case WESSEN:
     case WEM: case WEN:
       return ({"Jemand","Jemandes","Jemandem","Jemanden"})[fall];
     default: return "Jemand";
  }
}

varargs string Name(int fall, int demon) {return name(fall, demon);}

string short()
{
   return "Jemand.\n";
}

int remove()
{
   destruct(this_object());
   return 1;
}

