
#include <defines.h>
#include <properties.h>

#define WEG destruct(this_object())

object player;

_tarn_turn_on(pl){
  if(!objectp(pl)||!interactive(pl)) return WEG;
  player=pl;
  shadow(pl,1);
}    

_query_info()  {
	return break_string(
	"Undurchdringlich fuer Deine Magie!");
 }


_query_article()  {
	return 1;  }
	

_query_name()  {
	
	return "Zombiemeister";
	
	}

_query_long()  {
	return break_string(
"Vor Dir siehst Du einen stinkenden, fauligen Zombie. Es ist kein normaler "
"Zombie, es ist der Zombie aller Zombies, der Meisterzombie, Oberzombie und "
"Herr aller Zombies und Untoten! Es ist der Namenlose!!! GREIFE IHN JA NICHT AN! "
"WER WEISS WER DA DAHINTER STECKT!");
     }

_query_short()  {
return "Der Namenlos, Herr aller Zombies, Oberzombie und Anfuehrer der Untoten\n";
    }	

	
_query_msgin(){ 
 return "humpelt ein Bein nachschleifend und eitertriefend herein";
}
_query_msgout(){
 return "humpelt stinkend und Gewebe verlierend";
}
_query_mmsgin(){ 
 return "entsteht ploetzlich aus einer stinkenden Eiterbeule am Boden";
}
_query_mmsgout(){  
 return "loest sich in stinkenden schleimigen Eiter auf";
}



_query_noattack()  {
	return "sagt: Sterblicher versuche das gar nicht erst!\n";
}
 

_tarn_turn_off(){
  WEG;
}
