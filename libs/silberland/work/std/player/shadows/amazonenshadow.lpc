#include <moving.h>
#include <properties.h>
#include <wizlevels.h>

#define ANZAHL 10

mapping verbs = ([]);
int count;
object pl;

void create()
{
  if (!is_clone(this_object())) return;
  pl = this_player();
  shadow(this_player(), 1);
}

int remove()
{
  destruct(this_object());
  return 1;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (this_player()->QueryProp(P_GENDER) != MALE || gruppe != "intim")
    return;
  if (!member(verbs, verb))
  {
    verbs[verb] = ({getuid(this_player())});
    count++;
  }
  else if (member(verbs[verb], getuid(this_player())) == -1)
  {
    verbs[verb] += ({getuid(this_player())});
    count++;
  }
  if (IS_WIZARD(pl))
    printf("%O\n", verbs);
  if (count > ANZAHL)
  {
    tell_object(pl, 
        "Du hast jetzt genuegend Maenner betoert, ab nun kannst Du den Zauber "
        "'Betoeren'.\n");
    find_object("/gilden/amazonen")->LearnSpell("betoeren", pl); 
    remove();
  }
}

int amazonen_shadow_test()
{
  return 1;
}

