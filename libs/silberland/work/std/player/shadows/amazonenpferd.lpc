#include <moving.h>
#include <properties.h>

// 
// Da der Shadow sich nicht im Player befindet, wird ein
// Zusatzobjekt benoetigt.
//
#define HOOK "/gilden/amazonen/obj/pferd_hook"

nosave object pl;

void create()
{
  if (!is_clone(this_object())) return;
  shadow(this_player(), 1);
  pl=this_player();
  clone_object( HOOK ); // Steuerung des shadows ueber die hook
}

string _query_msgin() { return "reitet herein"; }
string _query_msgout() { return "reitet"; }

int move( mixed dest, int method, string dir, string msgout, string msgin )
{
  if( !(method & M_NOCHECK) && dest->QueryProp(P_INDOORS) )
  {
    write( "Das Pferd weigert sich, dorthin zu traben.\n" );
    return 1;
  }
  return pl->move( dest, method, dir, msgout, msgin );
}

_inventory()
{
  if( !environment() || set_light(0)>0 )
    write( "Du sitzt auf einem Pferd.\n" );
  return pl->_inventory();
}

void absteigen() { destruct(this_object()); }

int QueryReiter() { return 1; }

void reset()
{
  if (!pl) destruct(this_object());
  else return pl->reset();
}

mapping _query_race_tt_mv()
{
  return ([
    TT_OTHER:      2,
    TT_CAVE:       30,
    TT_HOUSE:      30,
    TT_HILL:       3,
    TT_FOREST:     4,
    TT_TOWN:       2,
    TT_MOUNTAIN:   4,
    TT_DESERT:     3,
    TT_JUNGLE:     4,
    TT_SWAMP:      6,
    TT_PLAIN:      2,
    TT_ARCTIC:     5,
    TT_UNDERWATER: 25,
    TT_WATER:      8,
    TT_ROAD:       2,
    TT_AIR:        2,
    ]);
}

string short()
{
  return pl->short()[0..<3] + " (reitend).\n";
}
