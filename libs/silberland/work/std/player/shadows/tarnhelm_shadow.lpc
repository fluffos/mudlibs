#include <defines.h>
#include <properties.h>

#define WEG() destruct(this_object())

object player;
int gender;
string desc;

_tarn_turn_on(pl,txt,gen)
{
  if (!objectp(pl)||!interactive(pl)) return WEG();
  if (!stringp(txt)||txt=="") return WEG();
  if (gen<0||gen>2) return WEG();
  player=pl;
  desc=capitalize(txt);
  gender=gen;
  shadow(pl,1);
}

special_verb()
{
  string verb;
  
  verb=query_verb();
  if (!verb||verb=="") return 0;
  if (verb[0]=='-') return 1;
  if (verb=="ruf"||verb=="rufe"||verb=="teile"||verb=="teil"||verb=="mruf"||
      verb=="mrufe"||verb=="erzaehl"||verb=="erzaehle") return 1;
}

_query_gender()
{
  return gender;
}

_query_name()
{
  if (!special_verb())
    return capitalize(desc);
  return player->Query(P_NAME);
}

_query_short()
{
  return capitalize(player->name());
}

_query_long()
{
  string str;

  str=player->name();
  return capitalize(str)+" ist "+str+" ist "+str+".\n";
}

_query_ids()
{
  return player->Query("ids")+({lower_case(desc)});
}

_query_race()
{
  return desc;
}

_tarn_turn_off()
{
  destruct(this_object());
}

_query_article()
{
  if (!special_verb())
    return 1;
}

_query_presay()
{
  return "";
}

_query_title()
{
  return "";
}

Defend(dam, dam_type, spell, enemy)
{
  object o;

  if (!query_once_interactive(previous_object()))
    player->Defend(dam, dam_type, spell, enemy);
  else
    previous_object()->StopHuntFor(player);
  if ((o=present("tarnhelm",player)))
  	o->ziehe("tarnhelm aus",player);
  if (this_object()) destruct(this_object());
}

Kill(ob)
{
  object o;

  if ((o=present("tarnhelm",player)))
    o->ziehe("helm aus",player);
  if (this_object()) destruct(this_object());
}

InsertEnemy(ob)
{
  object o;

  if (!query_once_interactive(ob))
    player->InsertEnemy(ob);
  else
    ob->StopHuntFor(player);
  if ((o=present("tarnhelm",player)))
    o->ziehe("tarnhelm aus",player);
  if (this_object()) destruct(this_object());
}

short()
{
  if (explode(file_name(previous_object()),"#")[0]=="/obj/werliste")
    return capitalize(geteuid(player)+" verkleidet als "+player->short());
  return player->short();
}

QueryDisguise()
{
  return desc; 
}
