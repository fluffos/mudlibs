#pragma strong_types

#define NEED_PROTOTYPES

#include "/sys/thing/properties.h"
#include "/sys/room/description.h"

#include <container.h>
#include <properties.h>
#include <rooms.h>
#include <wizlevels.h>
#include <defines.h>
#include <new_skills.h>


void create()
{
  Set(P_DEAF, SAVE, F_MODE);
}

object getobject(string str)
{
  string what;
  object base, *objs;

  if (str[<8..]==" in raum") {
    what = str[0..<9];
    base = environment();
  } else if (str[<7..]==" in mir") {
    what = str[0..<8];
    base = this_object();
  } else {
    base = 0;
    what = str;
  }

  if (base)
    objs = base->present_objects(what);
  else
    objs = environment()->present_objects(what)
         + this_object()->present_objects(what);

  return sizeof(objs) ? objs[0] : 0;
}

int riech(string str)
{
  object ob;
  string smell; 

  _notify_fail("Du kannst nichts Besonderes riechen.\n");
  if (!str) str = DEFAULT_SMELL;
  else
    if (str[0..2]=="an ") str = str[3..];   // 'rieche an x' => 'rieche x'

  if (ob=getobject(str)) {
    smell = ob->GetSmell(QueryProp(P_RACE));
    if (!smell)
    {
      write ("Du schnupperst an "+ob->name(WEM)+
          ", riechst aber nichts Besonderes.\n");
      return 1;
    }
  }
  else {
    if (str[<8..]==" in raum")
      str=str[0..<9];
    if (ob = environment(this_player()))
      smell = ob->GetSmell(str, QueryProp(P_RACE));
  }

  if (smell) {
    write(smell);
    return 1;
  }
  return 0;
}

int lausch(string str)
{
  object ob;
  string sound; 

  _notify_fail("Du kannst nichts Besonderes hoeren.\n");
  if (!str) str = DEFAULT_SOUND;
  else
    if (str[0..2]=="an ") str = str[3..];   // 'lausche an x' => 'lausche x'

  if (this_object()->QueryProp(P_DEAF))
  {
    write("Du bist doch taub!\n");
    return 1;
  }

  if (ob=getobject(str)) {
    sound = ob->GetSound(QueryProp(P_RACE));
    if (!sound)
    {
      write ("Du lauschst an "+ob->name(WEM)+
          ", hoerst aber nichts Besonderes.\n");
      return 1;
    }
  }
  else {
    if (str[<8..]==" in raum")
      str=str[0..<9];
    if (ob = environment(this_player()))
      sound = ob->GetSound(str, QueryProp(P_RACE));
  }

  if (sound) {
    write(sound);
    return 1;
  }
  return 0;
}

nosave string *_query_localcmds()
{
  return
    ({({"riech","riech",0,0}),
      ({"rieche","riech",0,0}),
      ({"lausch","lausch",0,0}),
      ({"lausche","lausch",0,0})
    });
}
