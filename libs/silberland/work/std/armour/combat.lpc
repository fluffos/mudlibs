#define NEED_PROTOTYPES

#include <thing/properties.h>
#include <thing/description.h>
#include <config.h>
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <new_skills.h>
#include <moving.h>

#define RESTR_CHECKER "/std/restriction_checker"

// globale Variablen
private nosave closure defend_cl;
private nosave mapping dam_protect;      // dagegen schuetzt die Ruestung

// lokale prototypes
mixed set_dam_prot(mixed prot);


void create()
{
  // Ein paar Defaultwerte:
  Set(P_ARMOUR_TYPE, AT_ILLEGAL);       // Alarm, wenn nicht gesetzt.
  Set(P_LAST_USE, time());
  SetProp(P_QUALITY_DECAY, 100);        // Default-Abnutzung.
  SetProp(P_WEAR_TEXT,
      ({ "Du ziehst %s an.\n",
         " zieht %s an.\n" }) );
  SetProp(P_UNWEAR_TEXT,
      ({ "Du ziehst %s aus.\n",
         " zieht %s aus.\n" }) );
  SetProp(P_DAMAGE_DESTRUCT_TEXT,
      "%s haelt der Belastung nicht mehr laenger stand und zerbricht in "
      "tausend kleine Einzelteilchen." );

  Set(P_WORN, PROTECTED, F_MODE_AS);
  Set(P_LAST_USE, PROTECTED, F_MODE_AS);
  Set(P_DAM_PROTECTION, PROTECTED, F_MODE_AS);
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);     // nur phys. Schutz!
}

void init()
{
  add_action("ziehe", "ziehe");
  add_action("ziehe", "zieh");
  add_action("do_wear", "trage");
}

// -> das define muss nach /sys/combat.h
#define NR_ARMOURS (ALL_ARMOUR_TYPES + ([AT_RING: 2]))

// Wenn man schon genug ruestungen eines typs traegt, so werden diese zurueckgegeben.
private object* TestType(string type)
{
  object* armours;

  if( sizeof(armours = PL->QueryArmours(type)) == NR_ARMOURS[type] )
    return armours;
  return 0;
}

nosave mixed _set_armour_type(mixed type)
{
  if (!COMBAT_MASTER->valid_armour_type(type))
    Set(P_ARMOUR_TYPE, type = AT_ILLEGAL);
  else
    Set(P_ARMOUR_TYPE, type);
  AddId(type);

  // **** Default-Worn-Text setzen:

  if( type == AT_HELMET )
    SetProp(P_WORN_TEXT, "aufgesetzt");
  else if( type == AT_SHIELD )
    SetProp(P_WORN_TEXT, "gehalten");
  else if( type == AT_CLOAK )
    SetProp(P_WORN_TEXT, "umgehaengt");

  return type;
}

nosave mixed _set_dam_prot(mixed prot)
{
  int i, *tmp;

  if (stringp(prot))
    prot = ([ prot : 1 ]);
  else if (pointerp(prot))
  {
    tmp = ({ });
    for (i = sizeof(prot); i--;) tmp += ({ 1 });
    prot = mkmapping(prot, tmp);
  }
  else if (mappingp(prot))
    prot = copy_mapping(prot);
  else
    return -1;

  if (mappingp(Set(P_DAM_PROTECTION, prot)))
    return dam_protect = prot;
  else
    return -1;
}

nosave int _set_damaged(int dam)
{
  return Set(P_DAMAGED, dam > 0 ? dam : 0);     // keine negativen Damagewerte
}

nosave int _set_ac(int ac)
{
  object ob;

  if ((ob=QueryProp(P_WORN)) && query_once_interactive(ob) &&
      ac+QueryProp(P_DAMAGED) > VALID_ARMOUR_CLASS[QueryProp(P_ARMOUR_TYPE)])
  {
    tell_object(ob, "Ungueltige Ruestungsklasse fuer "+
        name(WEN,1)+", bitte Erzmagier verstaendigen.\n");
    return -1;
  }
  ac = Set(P_AC, ac);

  if (ob)
    ob->QueryProp(P_TOTAL_AC);  // P_TOTAL_AC im Traeger updaten (f. Query()s)

  return ac;
}

nosave object _set_defend_func(object ob)
{
  defend_cl = symbol_function("DefendFunc",ob);
  return Set(P_DEFEND_FUNC,ob);
}

private void msg(string str, mixed fl)
{
  if(fl) write(str); else _notify_fail(str);
}

private int is_same(object a)
{
  return (a->QueryProp(P_ARMOUR_TYPE) == AT_MISC) &&
         (a->QueryProp(P_SHORT) == QueryProp(P_SHORT));
}

varargs int DoWear(int silent, int all)
{
  object *armours;
  mixed wear_func,type;
  mapping rmap;
  string res;
  int nh;

  if (all) notify_fail("Alles angezogen, was ging.\n");
  if (QueryProp(P_WORN))
    return msg("Du traegst " + ME->name(WEN,1) + " bereits.\n", all), 0;
  if (environment() != PL)
    return msg("Du musst " + ME->name(WEN,1) + " erst nehmen!\n", all), 0;

  type = QueryProp(P_ARMOUR_TYPE);


  if (PL->QueryProp(P_GHOST)) {
     write("Als Geist kannst du nichts tragen!\n");
     return !all;
  }

  if (type != AT_MISC)
  {
    if (sizeof(armours = TestType(type)))
    {
      if (all || (armours[0]->QueryProp(P_WORN) != this_player()))
        return msg("Du traegst bereits " + armours[0]->name(WEN,1)+
                   " als Schutz der Sorte " + type + ".\n", all), 0;
      armours[0]->DoUnwear();
      if (armours[0]->QueryProp(P_WORN))
      {
        if( sizeof(armours) == 2)
        {
          armours[1]->DoUnwear();
          if (armours[1]->QueryProp(P_WORN))
            return 1;
        }
        else
          return 1;
      }
    }
  }
  else  // AT_MISC-Ruestungen nur eine je P_SHORT
    if( sizeof(filter_array(PL->QueryProp(P_ARMOURS) - ({0}), #'is_same) ) )
       return msg("Du traegst bereits "+name(WEN,0)+"!\n", all), 0;

  if( (type == AT_ILLEGAL) || (QueryProp(P_AC) > VALID_ARMOUR_CLASS[type]) )
  {
    write("Ungueltiger Ruestungstyp, bitte Erzmagier verstaendigen.\n");
    return !all;
  }

  // Trage-Restriktionen?
  if( (rmap = QueryProp(P_WEAR_RESTRICTIONS)) &&
      (res = RESTR_CHECKER->check_restrictions(PL, rmap)) )
  {
    write(res);
    return !all;
  }

  // Im Kampf und zu beschaeftigt?
  if( PL->InFight() && PL->QueryProp(P_ATTACK_BUSY) )
  {
    write("Du bist zu erschoepft, um "+name(WEN)+" anzuziehen.\n");
    return !all;
  }

  // Attributsperre?
  if (QueryProp(P_M_ATTR_MOD) &&
      stringp(PL->TestAttributeLock(QueryProp(P_M_ATTR_MOD))))
  {
    write("Eine magische Kraft hindert Dich daran, "+ME->name(WEN,1)+
        " anzuziehen.\n");
    return !all;
  }

  // Freie Haende pruefen.
  nh=QueryProp(P_NR_HANDS);
  if (nh<1 && type==AT_SHIELD)
    nh=1;

  if (nh) {
    if (!PL->UseHands(ME,nh)) {
      write("Du hast keine Hand mehr frei.\n");
      return !all;
    }
  }

  // P_WEAR_FUNC im Spielerobject auswerten (kann object oder *object sein!)
  wear_func = PL->QueryProp(P_WEAR_FUNC);

  if (objectp(wear_func) && !wear_func->WearFunc(ME,silent))
  {
    if (nh)
      PL->FreeHands(ME);
    return !all;
  }
  else if (pointerp(wear_func))
  {
    int i;
    PL->SetProp(P_WEAR_FUNC, wear_func=filter_array(wear_func,#'objectp));
    for ( i = sizeof(wear_func); i-->0; )
      if (!wear_func[i]->WearFunc(ME,silent)) return !all;
  }

  // Eigene P_WEAR_FUNC auswerten
  wear_func = QueryProp(P_WEAR_FUNC);
  if(wear_func && !wear_func->WearFunc(ME,silent))
  {
    if (nh)
      PL->FreeHands(ME);
    return !all;
  }

  // Alle Checks erfolgreich durchlaufen -> anziehen!
  SetProp(P_EQUIP_TIME, time());
  SetProp(P_WORN, PL);
  PL->SetProp(P_ATTACK_BUSY, 1);
  armours = PL->QueryProp(P_ARMOURS) - ({ 0 }) + ({ ME });
  PL->SetProp(P_ARMOURS, armours);
  // P_TOTAL_AC und P_TOTAL_TEMPERATURE_PROTECTION im Traeger updaten
  PL->QueryProp(P_TOTAL_AC);
  PL->UpdateTotalTempProt();

  // Attribute gegebenenfalls updaten!
  if (QueryProp(P_M_ATTR_MOD) || QueryProp(P_M_HEALTH_MOD))
    PL->UpdateAttributes();

  // "anzieh"-Meldung ausgeben
  if (!silent)
  {
    write(sprintf( QueryProp(P_WEAR_TEXT)[0], name(WEN,1) ));
    say(PL->Name(WER) + sprintf( QueryProp(P_WEAR_TEXT)[1], name(WEN,0) ));
  }
  return !all;
}

varargs int do_wear(string str, int silent)
{
  int all;
  all = (str=="alles");
  if (!str || (!id(str) && !all)) return 0;
  if(all && !silent && !QueryProp(P_INVIS)) write(Name(WER)+": ");
  return DoWear(silent, all);
}

varargs int DoUnwear(int silent)
{
  object *armours, worn_by;
  mixed remove_func;
  string tmp;
  closure sp;
  int nh;

  if (!(worn_by = QueryProp(P_WORN)))
    return 0;

  // Verflucht? Wenn ja - Meldung und Abbruch.
  if ( (tmp = QueryProp(P_CURSED)) && !(silent & M_NOCHECK) )
  {
    if (stringp(tmp))
      tell_object(worn_by, tmp);
    else
      tell_object(worn_by, "Du kannst "+name(WEN)+" nicht ausziehen.\n");
    return 1;
  }

  // Im Kampf und zu beschaeftigt?
  if( worn_by->InFight() && worn_by->QueryProp(P_ATTACK_BUSY) )
  {
    tell_object(worn_by,
      "Du bist zu erschoepft, um "+name(WEN)+" auszuziehen.\n");
    return 1;
  }

  // P_REMOVE_FUNC im Spielerobjekt auswerten (kann object oder *object sein!)
  remove_func = worn_by->QueryProp(P_REMOVE_FUNC);

  if (objectp(remove_func) && !remove_func->RemoveFunc(ME,silent))
    return 1;
  else if (pointerp(remove_func))
  {
    int i;
    PL->SetProp(P_REMOVE_FUNC,remove_func=filter_array(remove_func,#'objectp));
    for ( i = sizeof(remove_func); i-->0; )
      if (!remove_func[i]->RemoveFunc(ME,silent))
        return 1;
  }

  // Eigene P_REMOVE_FUNC auswerten
  remove_func = QueryProp(P_REMOVE_FUNC);
  if(remove_func && !remove_func->RemoveFunc(this_object(),silent))
    return 1;

  // Alle Checks erfolgreich durchlaufen -> ausziehen!

  nh=QueryProp(P_NR_HANDS);
  if (nh<1 && QueryProp(P_ARMOUR_TYPE)==AT_SHIELD)
    nh=1;

  if (nh)
    worn_by->FreeHands(ME);

  sp = symbol_function("SetProp",worn_by);
  armours = worn_by->QueryProp(P_ARMOURS) - ({ ME, 0 });
  funcall(sp, P_ATTACK_BUSY, 1);
  funcall(sp, P_ARMOURS, armours);
  // P_TOTAL_AC und P_TOTAL_TEMPERATURE_PROTECTION im Traeger updaten
  worn_by->QueryProp(P_TOTAL_AC);
  worn_by->UpdateTotalTempProt();

  if (!silent)
  {
    tell_object( worn_by,
        sprintf( QueryProp(P_UNWEAR_TEXT)[0], name(WEN,1) ) );
    tell_room( environment(worn_by),
        worn_by->Name(WER) +
        sprintf( QueryProp(P_UNWEAR_TEXT)[1], name(WEN,0) ),
        ({ worn_by }) );
  }

  SetProp(P_WORN, 0);

  // Attribute gegebenenfalls updaten!
  if (QueryProp(P_M_ATTR_MOD) || QueryProp(P_M_HEALTH_MOD))
    worn_by->UpdateAttributes();

  return 1;
}

varargs int do_unwear(string str, int silent)
{
  int all;
  if (all=(str=="alles")) notify_fail("Alles ausgezogen, was ging.\n");
  if (!str || (!id(str) && !all)) return 0;
  if(!QueryProp(P_WORN))
  {
    if (!all) _notify_fail( "Du traegst " + ME->name(WEN,1) + " nicht.\n" );
    return 0;
  }
  if(all && !silent) write(Name(WER)+": ");
  DoUnwear( silent );
  return !all;
}

int QueryDefend (string* dam_type, mixed spell, object enemy) {
  int prot, i;
  object pl;
  string *prot_types;

  prot = 0;
  if (sizeof(prot_types=filter_array(dam_type, dam_protect)))
  {
    for (i=sizeof(prot_types)-1; i>=0; i--)
      prot += QueryProp(P_AC) * dam_protect[prot_types[i]];
    prot = random(1 + prot / sizeof(prot_types));
  }
  if (objectp(QueryProp(P_DEFEND_FUNC))) {
    if (!closurep(defend_cl))
      defend_cl=symbol_function("DefendFunc",QueryProp(P_DEFEND_FUNC));
    if (!objectp(pl=QueryProp(P_WORN))
        || !query_once_interactive(pl)
        || interactive(pl)) // Bei Netztoten keine (evtl. wirksame) DefendFunc
      prot += funcall(defend_cl, dam_type, spell, enemy);
  }
  SetProp(P_LAST_USE, time());
  return prot;
}

int ziehe(string str)
{
  string ob;
  if(!str) return 0;
  if(sscanf(str, "%s an", ob)==1 ) return do_wear(ob);
  if(sscanf(str, "%s aus", ob)==1 ) return do_unwear(ob);
  return 0;
}

// TO BE REMOVED

void SetDefendFunc(object ob) { SetProp(P_DEFEND_FUNC,ob); }
object QueryDefendFunc() { return QueryProp(P_DEFEND_FUNC); }

void SetWearFunc(object ob) { SetProp(P_WEAR_FUNC,ob); }
object QueryWearFunc() { return QueryProp(P_WEAR_FUNC); }

void SetRemoveFunc(object ob) { SetProp(P_REMOVE_FUNC,ob); }
object QueryRemoveFunc() { return QueryProp(P_REMOVE_FUNC); }

mixed QueryWorn() { return QueryProp(P_WORN); }

// flaw  wird bei jedem Treffer hochgezaehlt
//       (in jeder Kampfrunde random fuer ein Ruestungsteil)
// ftime ist die Zeit des ersten Treffers
// decay ist ein Mapping ([dam_type:hits,...,0:hits]).
//       Wenn mit Schadenstyp 'dam_type' angegriffen wird, wird alle
//       'hits' Treffer die Ruestung um 1 verschlechtert. Default ist
//       'dam_type' 0, d.h. alle Schadenstypen.
//       Bei mehreren Schadenstypen in 'dam_type' wird pro Schlag
//       zufaellig einer ausgewaehlt.
// qualityflaw: wenn es qualitydecay uebersteigt,
//       sinkt qualitdecay um einen Punkt

private nosave int ftime, totalflaw, flaw, qualityflaw;
private nosave mapping decay;

nosave mixed _set_quality_decay(mixed arg)
{
  if (intp(arg))
    decay = ([0:arg]);
  else if (mappingp(arg))
    decay = arg;
  else
    decay = arg = 0;
  return Set(P_QUALITY_DECAY, arg);
}

int Damage(int dam)
{
  int ac;

  if (dam)
  {
    if (dam < 0) // Reparatur
      flaw=0;  // aktuelle Abnutzung wird auch auf Null gesetzt.
    ac=QueryProp(P_AC);

    if (ac - dam < 0)
    {
      if (!QueryProp(P_NO_DAMAGE_DESTRUCT))
      {
        object w;
        string text;

        w = QueryProp(P_WORN);          // Traeger?
        text = break_string(
            capitalize(
              sprintf( QueryProp(P_DAMAGE_DESTRUCT_TEXT),name(WER,1) ) ), 78);

        // Leise und erzwungen (also auch wenn verflucht!) zerstoeren:
        ME->remove(M_NOCHECK | M_SILENT);

        // Zerstoerung erfolgreich?
        if (!ME)
        {
          if (!w && environment())
            if (living(environment()) || query_once_interactive(environment()))
              // Environment == Lebewesen
              w = environment();
            else
              // Annahme: Environment == Raum
              tell_room(environment(), text);

          // w = Lebewesen (oder 0)
          if (w) tell_object(w, text);

          return dam;
        }
      }
      dam = ac;
    }
    if (dam+QueryProp(P_DAMAGED) < 0) dam = -QueryProp(P_DAMAGED);
    if (dam > 0)
    {
      qualityflaw+=dam;
      if( decay[0]>1 && qualityflaw>decay[0]/10 ) // QualityDecay sinkt ganz langsam
      {
        decay+=([0:decay[0]-1]);
        if (mappingp(QueryProp(P_QUALITY_DECAY) ))
          SetProp(P_QUALITY_DECAY, decay );
        else
          SetProp(P_QUALITY_DECAY, decay[0]-1 );
        qualityflaw=0;
      }
    }
    SetProp(P_DAMAGED, QueryProp(P_DAMAGED)+dam);
    SetProp(P_AC, ac-dam);
    // P_TOTAL_AC wird von _set_ac() korrigiert
  }
  return dam;
}

varargs void TakeFlaw(mixed dam_type)
{
  int    ac, hits;
  string dt;

  if (!ftime) ftime=time();
  if (dam_type && intp(dam_type)) flaw+=dam_type; else flaw++;
  if (decay)  // speed things up
  {
    if (pointerp(dam_type)) {
      dt = dam_type[random(sizeof(dam_type))];  // Angriffsschaden
      hits = decay[member(decay,dt)?dt:0];      // decay[dt] may be 0
    }
    else hits=decay[0];
    if (hits && (flaw >= hits)) {
      Damage(flaw/hits);
      totalflaw += flaw/hits*hits;
      flaw %= hits;
    }
  }
}

mixed *QueryFlaw()
{
  return ({ totalflaw+flaw, ftime, dtime(ftime), flaw });
}

nosave mapping _set_temperature_protection(mixed m)
{
  if (mappingp(m))
    return Set(P_TEMPERATURE_PROTECTION,
        copy_mapping(m));
  else if (intp(m))
    return Set(P_TEMPERATURE_PROTECTION,
        ([ T_COLD_PROT:m,T_HEAT_PROT:m ]) );
  else
    return Set(P_TEMPERATURE_PROTECTION,
        ([ T_COLD_PROT:0,T_HEAT_PROT:0 ]) );
}

nosave mapping _query_temperature_protection()
{
  mixed res, at;

  if (mappingp(res=Query(P_TEMPERATURE_PROTECTION)))
    return copy_mapping(res);
  at=QueryProp(P_ARMOUR_TYPE);
  switch (at)
  {
    case AT_ARMOUR:
      return ([ T_COLD_PROT:4,T_HEAT_PROT:-3 ]);
    case AT_CLOAK:
      return ([ T_COLD_PROT:4,T_HEAT_PROT:-1 ]);
    case AT_HELMET:
      return ([ T_COLD_PROT:2,T_HEAT_PROT:1 ]);
    case AT_TROUSERS:
      return ([ T_COLD_PROT:3,T_HEAT_PROT:-1 ]);
    case AT_GLOVE:
      return ([ T_COLD_PROT:2,T_HEAT_PROT:-1 ]);
    case AT_BOOT:
      return ([ T_COLD_PROT:2,T_HEAT_PROT:0 ]);
    case AT_BRACERS:
      return ([ T_COLD_PROT:1,T_HEAT_PROT:0 ]);
    case AT_SHIELD:
      return ([ T_COLD_PROT:0,T_HEAT_PROT:3 ]);
    default:
      return ([ T_COLD_PROT:0,T_HEAT_PROT:0 ]);
  }
}

