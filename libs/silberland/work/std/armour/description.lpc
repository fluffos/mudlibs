#pragma strong_types

inherit "/std/thing/description";

#define NEED_PROTOTYPES

#include <thing/properties.h>
#include <thing/description.h>
#include <properties.h>
#include <combat.h>

mapping QueryFlaw();


void create()
{
  ::create();
  SetProp (P_DAM_DESC, DFLT_DAM_DESC);
}


mixed dam_desc()
{
  string re;
  mixed desc;
  int x,dam,decay;

  if (!QueryProp(P_NAME) || !QueryProp(P_SHORT) || !desc=QueryProp(P_DAM_DESC))
    return 0;

  // Die Ruestung hat keine AC - also auch keine Schadensbeschreibung
  if (!x = QueryProp(P_AC)+(dam=QueryProp(P_DAMAGED)))
    return 0;

  // Nur eine Beschreibung angegeben - 50:50 Grenze
  if (stringp(desc))
    return (dam > (x / 2)) ? desc : 0;

  if (!pointerp(desc) || !sizeof(desc))
    return 0;

  // Genug Abstufungen bereits durch Damage?
  if (x > sizeof(desc))
    x = ((sizeof(desc)-1) * dam / x);
  else                                          // flaw/decay mit einbeziehen
  {
    if (mappingp(QueryProp(P_QUALITY_DECAY)) )
      decay = QueryProp(P_QUALITY_DECAY)[0];
    else 
      decay = QueryProp(P_QUALITY_DECAY);

    if (dam == x)                               // AC=0 -> schrottreif
      x = sizeof(desc)-1;
    else if (!decay)                            // Flaws ungueltig?
      x = ((sizeof(desc)-1) * dam / x);
    else
      x = ((sizeof(desc)-1) * (100*dam+100*QueryFlaw()[3]/decay)) / (100*x);
  }

  return stringp(desc[x]) ? desc[x] : 0;
}


string short()
{
  string s;
  if (!(s=QueryProp(P_SHORT)) || QueryProp(P_INVIS)) return 0;
  return s+(QueryProp(P_WORN) ?
    " ("+(QueryProp(P_WORN_TEXT) || "getragen")+").\n":".\n");
}


string long()
{
  int dmg;
  string s;

  s=dam_desc();
  return ::long() +
    (s ? sprintf("%s %s in einem %sen Zustand.\n",
         capitalize(QueryPronoun(WER)), IsPlural() ? "sind" : "ist", s) : "");
}


mapping _query_material()
{
  mixed res,at;

  if (mappingp(res=Query(P_MATERIAL)))
    return res;
  at=QueryProp(P_ARMOUR_TYPE);
  switch(at)
  {
    case AT_ARMOUR:
    case AT_HELMET:
    case AT_RING:
    case AT_SHIELD:
    case AT_BRACERS:
      return ([MAT_MISC_METAL:100]);
    case AT_AMULET:
      return ([MAT_MISC_METAL:100,MAT_MISC_MAGIC:100]);
    case AT_CLOAK:
    case AT_TROUSERS:
      return ([MAT_CLOTH:100]);
    case AT_MISC:
      return ([MAT_MISC:100]);
    case AT_GLOVE:
    case AT_BOOT:
    case AT_BELT:
    default:
      return ([MAT_LEATHER:100]);
  }
}

