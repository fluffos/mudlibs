#define ANZ 3
#include <properties.h>
#include <bank.h>
#include <moving.h>
#include <wizlevels.h>

inherit "/std/thing/properties";
inherit "/std/room/items";
inherit "/std/container/description";
inherit "/std/room/restrictions";

mixed *all,all2;
object shop;
int sum;
int store_percent_left;

_set_store_percent_left()
{
  store_percent_left=ZENTRALBANK->_query_store_percent_left();
}

_register_shop(ob)
{
  shop=ob;
}

void create()
{
  seteuid(getuid());
  properties::create();
  items::create();
  _set_store_percent_left();
}

void init()
{
  add_action("welt","welt");
}

int welt()
{
  this_player()->move(shop || "/gilden/abenteurer", M_GO, "zurueck");
  return 1;
}

void clean_double() {}

void reset()
{
  items::reset();
  _set_store_percent_left();
  all=all_inventory(this_object());
  if (sizeof(all)==0)
  {
    all=0;
    return;
  }
  all2=order_alist(({({}),({})}));
  call_out("aufraeumen",random(10));
  if (sum)
    if (!shop)
      ZENTRALBANK->PayIn(sum);
    else
      shop->_add_money(sum);
  sum=0;
} 

void aufraeumen()
{
  int i;
  int size;
  mixed element,got;

  i=30;
  size=sizeof(all);
  if (i>=size) 
    i=size-1;
  while (i>0)
  {
    // Sicherheitsabfrage, objekt koennte sich selbst zerstoert haben
    if (objectp(all[size-1-i])) 
    {
      element=explode(file_name(all[size-1-i]),"/")[0];
      if (element=="players"||element=="d")
        element=explode(file_name(all[size-1-i]),"#")[0];
      else
        element=all[size-1-i]->short()+explode(file_name(all[size-1-i]),"#")[0];
      got=assoc(element,all2);
      if (pointerp(got))
      {
        if (got[1]<ANZ-1) 
        {
          got[1]++;
          all2=insert_alist(element,got,all2);
        } 
        else 
        {
          sum+=all[size-1-i]->QueryProp(P_VALUE)*store_percent_left/100;
          catch(all[size-1-i]->remove());
          if (all[size-1-i])
            destruct(all[size-1-i]);
        }
      } 
      else 
        all2=insert_alist(element,({all[size-1-i],1}),all2);
    }
    i--;
  }
  if (size<31)
    all=({});
  else
    all=all[0..size-31];
  if (!sizeof(all))
  {
    all=0;
    all2=0;
  } 
  else
    call_out("aufraeumen",0);
} 

int clean_up(int refcount) { return 1; }

int _query_current_money()
{
  return sum;
}

varargs string int_short(mixed viewer, mixed viewpoint, int shortflag)
{
  return "Ein Lagerraum"+
    (IS_LEARNING(viewer) ? " ["+file_name(this_object())+"]" : "")+
    ".\n";
}

varargs string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  object *allinv;
  string *items;
  int i;

  allinv=all_inventory(this_object())-({viewpoint});

  if (!IS_LEARNING(viewer))
    return break_string("Du stehst in einem Lagerraum, in dem Du "
        "eigentlich ueberhaupt nichts verloren hast. Mit "
        "'welt' gelangst Du wieder in den zugehoerigen Laden.", 78);

  for (i=sizeof(allinv)-1; i>=0; i--)
    if (allinv[i] && !allinv[i]->short()) allinv[i]=0;
  allinv-=({0});
  items=map_objects(allinv, "name");

  return "["+file_name(this_object())+"]\n"
    "Du stehst im Lagerraum von "+
    (objectp(shop) ? file_name(shop) : "<unbekannt>")+".\n"+
    "Es gibt einen sichtbaren Ausgang: welt.\n"+
    "Inhalt ("+sizeof(allinv)+" Objekte):\n"+
    break_string(capitalize(implode(items, ", ")), 78);
    // make_invlist(viewer, allinv, shortflag);
}

varargs string GetDetail(mixed key, mixed race)
{
  return "Hier gibt es keine Details.\n";
}

