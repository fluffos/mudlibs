#pragma strong_types

inherit "std/room";

#include <properties.h>
#include <mnpc.h>

void create()
{
  string wizname;

  ::create();
  wizname = capitalize(getuid(this_object()));

  SetProp(P_INT_SHORT, "Der Arbeitsraum von "+wizname);
  SetProp(P_INT_LONG,
      "Dieses ist der Arbeitsraum von "+wizname+". Es liegen vollgeschriebene "
      "Zettel auf dem Boden, die Waende sind mit Kreidezeichen zugekritzelt. "
      "Man merkt, dass dieser Raum dafuer da ist, dass "+wizname+" fuer sich "
      "ungestoert arbeiten kann. Ein magisches Portal fuehrt in die Welt "
      "der Sterblichen.");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({ "portal", "portale" }), 
      "Das Portal fuehrt in die Abenteurer-gilde." );
  AddDetail( ({ "raum", "arbeitsraum" }),
      "Du befindest Dich mittendrin." );
  AddDetail( "zettel",
      "Die Zettel sind mit unleserlichen Zeichen vollgeschrieben." );
  AddDetail( ({ "boden", "fussboden" }),
      "Der Fussboden ist bedeckt mit vollgeschriebenen Zetteln." );
  AddDetail( ({ "wand", "waende" }),
      "An den Waenden befinden sich Kreidezeichen." );
  AddDetail( ({ "kreide", "kreidezeichen", "zeichen" }),
      "Die Zeichen ergeben nur fuer " + wizname + " einen Sinn." );
  AddDetail( "portal",
      "Das Portal fuehrt in die Welt der Sterblichen." );

  AddExit("gilde","in die Gilde#/gilden/abenteurer");
}

void init()
{ 
  ::init();
  if (this_player() && this_player()->QueryProp(P_INVIS) )
  {
    tell_room(this_object(), "(" + capitalize(getuid(this_player())) +
        ") betritt den Raum.\n", ({this_player()}) );
  }
  if (this_player() && !interactive(this_player()) && 
      this_player()->QueryProp(P_MNPC_FLAGS) )
  {
     this_player()->SetProp(P_MNPC_FLAGS, 0);
     tell_room(this_object(),"MNPC "+ this_player()->Name(WER)+
         " wurde gestoppt.\n");
  }
}
