inherit "std/thing/description";

#pragma strong_types

#define NEED_PROTOTYPES

#include <container.h>
#include <properties.h>
#include <defines.h>
#include <wizlevels.h>
#include <wizard.h>
#include <vt100.h>
#include <moving.h>
#include <new_skills.h>

void create()
{
  ::create();
  SetProp(P_TRANSPARENT, 1);
  AddId("Container");
}

string short()
{
  string sh;

  if (QueryProp(P_INVIS)) return 0;
  if (sh = QueryProp(P_SHORT))
    sh = process_string(sh) + ".\n";

  if (!sh || !QueryProp(P_CNT_OPENCLOSE))
    return sh;

  if (IsOpen())
    return sh[0..<3] + " (geoeffnet).\n";
  else
    return sh[0..<3] +
      sprintf(" (%sgeschlossen).\n", (IsLocked() ? "ab" : "") );
}

varargs string long()
{
  string descr, inv_descr;

  descr = process_string(QueryProp(P_LONG));

  if (!QueryProp(P_TRANSPARENT))
    if (QueryProp(P_CNT_OPENCLOSE))
      return descr + capitalize(QueryPronoun(WER)) + " ist " +
             (IsLocked() ? "ab" : "") + "geschlossen.\n";
    else
      return descr;

  inv_descr = make_invlist(PL, all_inventory(ME), 0);
  if (stringp(inv_descr) && strlen(inv_descr))
    descr +=
      capitalize(QueryPronoun(WER)) +
      (QueryProp(P_CNT_OPENCLOSE) ? " ist geoeffnet und" : "") +
      " enthaelt:\n" + inv_descr;
  else
    if (QueryProp(P_CNT_OPENCLOSE))
      descr += capitalize(QueryPronoun(WER)) + " ist geoeffnet und leer.\n";

  return descr;
}

nosave object vwr;

#define FT_NPC  1
#define FT_PLR  2
#define FT_ARM  3
#define FT_WPN  4

string wiz_hdr(mixed obj)
{
  string descr, ter, fnam, nc, sc, tc, cc,
         lvc, mvc, mmvc, hpc, mhpc, spc, mspc, coff, *fn;
  int fs, mlev, ftype;

  if (!vwr && !objectp(vwr))
    return file_name(obj);
  mlev=vwr->QueryProp(P_WANTS_TO_LEARN);
  descr="";
  switch (vwr->QueryProp(P_TTY)) {
    case "vt100":
    case "ansi": coff=VT_TA_AO; hpc=VT_GREEN; sc=VT_TA_B+VT_BLUE;
                 tc=spc=VT_BLUE; mhpc=mspc=mmvc=VT_TA_B+VT_RED; nc=VT_GREEN;
                 cc=mvc=VT_CYAN; lvc=VT_TA_B+VT_GREEN; break;
    default: coff=nc=sc=tc=mvc=mmvc=lvc=spc=mspc=hpc=mhpc=cc="";
  }
  if (obj->id("NPC"))
    ftype=FT_NPC;
  else
    if (obj->id("Spieler"))
      ftype=FT_PLR;
    else
      if (obj->QueryProp(P_WEAPON_TYPE))
        ftype=FT_WPN;
      else
        if (obj->QueryProp(P_ARMOUR_TYPE))
          ftype=FT_ARM;
  if (mlev&RH_NFNHDR)
    descr+=sprintf("%s%s%s:", tc,
        (ftype==FT_NPC?"NPC":(ftype==FT_PLR?"PLR":
        (ftype==FT_WPN?"Wpn":(ftype==FT_ARM?"Arm":"Obj")))), coff);
  fnam=file_name(obj);
  fn=explode(fnam, "/");
  descr+=nc;
  if (mlev&RH_NFILENAME && sizeof(fn)) {
    switch (fn[0]) {
      case "players": descr+="~"+fn[1]+"/";
                      if (sizeof(fn)>3)
                        descr+=".../";
                      descr+=fn[<1]; break;
      case "d": descr+="+"+capitalize(fn[1][0..1])+"/"+fn[2]+"/.../"+fn[<1]; break;
      default: descr+="/"+implode(fn, "/");
    }
  }
  else
    descr+=fnam;
  descr+=coff;
  if (mlev&RH_SIZE && ftype!=FT_PLR) {
    fs=file_size(explode(fnam, "#")[0]+".lpc");
    descr+=sprintf("|sz:%s%s%s", sc, (fs<1024?(string)fs:((string)(fs/1024)+"k")), coff);
  }
  switch(ftype) {
    case FT_NPC: if (mlev&RH_NPC_LVL)
                   descr+=sprintf("|lv:%s%d%s", lvc, obj->QueryProp(P_LEVEL), coff);
                 if (mlev&RH_NPC_HP)
                   descr+=sprintf("|hp:%s%d%s(%s%d%s)", hpc, obj->QueryProp(P_HP),
                          coff, mhpc, obj->QueryProp(P_MAX_HP), coff);
                 if (mlev&RH_NPC_SP)
                   descr+=sprintf("|sp:%s%d%s(%s%d%s)", spc, obj->QueryProp(P_SP),
                          coff, mspc, obj->QueryProp(P_MAX_SP), coff);
                 break;
    case FT_PLR: if (mlev&RH_NPC_LVL)
                   descr+=sprintf("|lv:%s%d%s", lvc, obj->QueryProp(P_LEVEL), coff);
                 if (mlev&RH_NPC_HP)
                   descr+=sprintf("|hp:%s%d%s(%s%d%s)", hpc, obj->QueryProp(P_HP),
                          coff, mhpc, obj->QueryProp(P_MAX_HP), coff);
                 if (mlev&RH_NPC_SP)
                   descr+=sprintf("|sp:%s%d%s(%s%d%s)", spc, obj->QueryProp(P_SP),
                          coff, mspc, obj->QueryProp(P_MAX_SP), coff);
                 if (mlev&RH_PLR_MV)
                   descr+=sprintf("|mv:%s%d%s(%s%d%s)", mvc, obj->QueryProp(P_MV),
                          coff, mmvc, obj->QueryProp(P_MAX_MV), coff);
                 break;
  }
/*  if (mlev&RH_CLONER)
    descr+=sprintf("|cl:%s%s%s", cc, obj->QueryProp(P_CLONER), coff); */

  return descr;
}

#define MI_ARRAY        0x0001          // return as array
#define MI_NO_GROUP     0x0002          // do not group identical items
#define MI_TAG_KEPT     0x0004          // tag items marked as kept

private void stringenize(mixed obj, int wiz, int flags, mixed objs, mixed info)
{
  string id, tmp;
  int idx, nogroup;

  // Kein Gruppieren, wenn: wiz (mit Pfaden), via Option sowie bei Livings
  nogroup = wiz || (flags & MI_NO_GROUP) || living(obj);

  tmp = capitalize(obj->short() || "")[0..<2];

  if (wiz)
    tmp += " [" + wiz_hdr(obj) + "]";

  if ( (flags & MI_TAG_KEPT) &&
       objectp(vwr) &&
       obj->QueryProp(P_KEEP_ON_SELL) == getuid(vwr) )
    tmp = "+" + tmp;

  if (nogroup)
    id = file_name(obj);
  else 
    id = explode(file_name(obj), "#")[0] + tmp;

  if((idx = member(objs, id)) == -1)
  {
    objs += ({ id });
    info += ({ ({ tmp, 1, obj, obj->QueryProp(P_TOTAL_WEIGHT) }) });
  }
  else
  {
    info[idx][1]++;
    info[idx][3] += obj->QueryProp(P_TOTAL_WEIGHT);
  }
}

private string collect(mixed obj)
{
  if(!strlen(obj[0])) return 0;
  return obj[0] + (obj[1] > 1 ? " (" + obj[1] + ")" : "");
}

varargs mixed make_invlist(object viewer, mixed inv, int flags)
{
  int max, iswiz, col;
  mixed objs, info;
  string descr;

  vwr = viewer;
  iswiz = IS_LEARNING(viewer) && 1;
  descr = "";
  objs = ({ });
  info = ({ });

  // Elementweise Strings bilden und in objs/info sammeln
  map_array(inv, #'stringenize/*'*/, iswiz, flags, &objs, &info);

  // Rueckgabe als Array erwuenscht? (z.B. bei 'inv' der Fall)
  if (flags & MI_ARRAY)
    return info;

  // Zusammengefasste Objekte in passenden String umwandeln
  inv = map_array(info, #'collect/*'*/) - ({ 0 });

  // Wenn nichts ueberbleibt...
  if (!sizeof(inv))
    return "";

  // col auf 1 setzen, wenn gruppiert werden soll (je nach User Setting)
  // COLUMN_MODE: 0=nie, 1=immer, 2=bei mehr als 6 Items gruppieren
  if ((col = (objectp(viewer) ? viewer->QueryProp(P_COLUMN_MODE) : 0)) >= 2)
    col = sizeof(inv) > (col == 2 ? 6 : col);

  // Endgueltigen String zurueckgeben
  return sprintf("%" + (col ? "#" : "=") + "-"+
      (objectp(viewer) ? viewer->QueryProp(P_SCREENWIDTH) || 78 : 78)+"s", 
      implode(inv, "\n")) + "\n";
}
