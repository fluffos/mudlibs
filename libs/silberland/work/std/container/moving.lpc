#pragma strong_types

inherit "/std/thing/moving";

#define NEED_PROTOTYPES 1

#include <container.h>


// deep_remove()
//
// This method removes the object as well as all objects it contains.
// 1 means success, destruction complete, 0 is (maybe partial) failure.

varargs int deep_remove(int silent)
{
  object *obs;
  obs = all_inventory(this_object());
  map_objects(obs, "remove", silent);
  obs -= ({ 0 });
  remove(silent);
  return (sizeof(obs) || this_object()) ? 0 : 1;
}
