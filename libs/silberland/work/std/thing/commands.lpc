// Defining extra commands for objects
//
//	AddCmd(string|string* cmd, string fun|closure cl, int flag)
//	   Adds a verb with associated function to the object. When
//         <cmd> or one of the elements of the array <cmd> is typed,
//	   the function <fun> in the object is invoked. The function
// 	   should return 1 in success or 0 in case the object doesn't
// 	   accept the combination <cmd> and arguments to <cmd> (See
//	   "commands" in the concepts documentation). Note that you
//	   can query the verb typed by using the efun query_verb().
//
// The commands are implemented as property P_COMMANDS as mapping.
//
//Usage: AddCmd(({"greif","greife","greifen"}),
//              "cmd_greife");
//Usage: AddCmd("greif|greife|greifen&in&loch|spalt",
//              "cmd_greife",
//              "Wohin willst Du greifen?");
//Usage: AddCmd("stell|stelle|stellen&regal|buecheregal|regale|buecherregale&auf",
//              "cmd_stelle",
//              "Was willst Du wieder aufstellen?|Das willst Du bestimmt AUFstellen.");

#pragma strong_types

#define NEED_PROTOTYPES 1

#include <thing/properties.h>
#include <thing/commands.h>
#include <properties.h>
#include <exploration.h>
#include <wizlevels.h>

// prototype for local property methods
nosave mapping _set_commands(mapping commands);

private nosave string *explore;

void create()
{
  Set(P_COMMANDS, ([]));
  explore = EPMASTER->QueryExplore(EP_CMD);
}

/* 
 an flag from type int !=0 doesn't support complex cmd with a & connection
 if we find one - we ignore the complex cmd part after &
*/
varargs void AddCmd(mixed cmd, mixed func, mixed flag)
{
  int i;
  mapping cmds;
  mixed post_cmd;
  
  cmds = Query(P_COMMANDS);
  post_cmd = 0;

  if (stringp(func) && !function_exists(func, this_object()))
  {
    if (this_interactive() && IS_LEARNER(this_interactive()))
      tell_object(this_interactive(),
          "\nBUG: AddCmd: Funktion "+func+" unbekannt!\n\n");
    else
      raise_error("AddCmd: Funktion "+func+" unbekannt\n");
  }
  if (!pointerp(cmd))              
  { 
    cmd=explode(cmd,"&");
    if (!flag || !intp(flag))
    {
      if (!stringp(flag)) flag = 0;         //no flags
      post_cmd = implode(cmd[1..], "&");
      if (!strlen(post_cmd)) post_cmd=0;    //no complex rule
    }
    cmd = explode(cmd[0],"|");
  }

  for (i = sizeof(cmd)-1; i>=0; i--)
  {
    if (!member(cmds, cmd[i])) 
    { //we might have more then one action per command
      cmds += ([ cmd[i] : ({ func }); ({ post_cmd }); ({ flag }) ]);
    }
    else
    {
      cmds[cmd[i], 0] += ({ func });
      cmds[cmd[i], 1] += ({ post_cmd });
      cmds[cmd[i], 2] += ({ flag });
    }
  }

  Set(P_COMMANDS, cmds);			// setting new old+actions
}

varargs void RemoveCmd(mixed cmd)
{
  int i;
  mapping cmds;
  
  cmds = Query(P_COMMANDS);
  if (!cmd) Set(P_COMMANDS, ([]));
  else
  {
    if(stringp(cmd)) cmd = explode(cmd,"|");
    if(!mappingp(cmd) && pointerp(cmd)) cmd = mkmapping(cmd);
    else return;
    Set(P_COMMANDS, Query(P_COMMANDS) - cmd);
  }
}

int auswerten(mixed cmd, string str)
{
  if (closurep(cmd))
    return funcall(cmd,str);
  return (int)call_other(this_object(),cmd,str);
}

int _cl(string str)
{
  string verb,key,error_msg,rules;
  mixed cmd, cmds;
  int i,k,l,max,ret,missing;
  string *keys,*words,*groups,*errmsg,*synon;

  if(!verb = query_verb()) return 0;
  cmds=Query(P_COMMANDS);
  if(cmd = cmds[verb,0])
  {
    max = -1;                             //no notify_fail string jet
    for (k=sizeof(cmd); k--;) 
    {                                     //all functions
      rules=cmds[verb,1][k];
      if (stringp(rules) && strlen(rules))//there is a complex rule
      {                                   //test if the rule apply
        error_msg=cmds[verb,2][k];
        if (!str)                         //rule can't apply since there is no input
        {
          if (stringp(error_msg) && strlen(error_msg))
            notify_fail(efun::explode(error_msg,"|")[0]+"\n");
          continue;                       //go to next funktion which my be not complexe
        }
        if (!words) 
          words = efun::explode(lower_case(str)," "); //get the words of the input
        groups = efun::explode(rules,"&");
        missing=-1;                       //number of missing rule
        l=sizeof(groups);
        for (i=0; i<l; i++)               //for all rules
        {
          synon = efun::explode(groups[i],"|");
          if (!sizeof(synon & words))     //none of the synonym's fit
          {
            missing=i;
            break;
          }
        }
        if (missing>=0) 
        {                                 //a word is missing
          if (max<missing && stringp(error_msg) && strlen(error_msg))
          {
            errmsg=efun::explode(error_msg,"|"); //get all error messages
            if (sizeof(errmsg)>missing)   //got we a right one?
            {
              max=missing;                //we get maybe later a stronger errormessage
              notify_fail(errmsg[missing]+"\n");
            }
          }
          continue; // Naechste Funktion zu diesem Verb pruefen
        }
        //yaeh we found a function !!
      }
      if (ret = auswerten(cmd[k],str))    //we found a rule or there is none
      {
        if ((ret == 1) && explore && (member(explore,verb) >= 0))
          EPMASTER->GiveExplorationPoint(verb, EP_CMD);
        return ret;
      }
    }
  }
  keys=m_indices(cmds);		          //incomplete cmd
  
  for(i = sizeof(keys)-1; i>=0; i--)
  {
    cmd=cmds[keys[i],2][0];               //incomplete cmd's should be only one pro command
    if (!intp(cmd) || !cmd) continue;     //flag not int or not set?
    key=keys[i];
    if (strstr(verb,key)) continue;       //no correspondence?
    if (ret = auswerten(cmds[key,0][0],str)) 
    {
      if ((ret == 1) && explore && (member(explore,key) >= 0))
        EPMASTER->GiveExplorationPoint(key, EP_CMD);
      return ret;
    }
  }
  return 0;
}

void init() {
  mixed cmds;
  
  if (mappingp(cmds = QueryProp(P_COMMANDS)))
    add_action("_cl","",1);
}

// **** local property methods
nosave mapping _set_commands(mapping commands)
{
  if (mappingp(commands))
    Set(P_COMMANDS, commands);
}
