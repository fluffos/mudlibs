#define NEED_PROTOTYPES
inherit "/std/thing";
inherit "/std/restriction_checker";
#include <thing/properties.h>
#include <properties.h>
#include <wizlevels.h>
#include <new_skills.h>
#include <moving.h>
#include <moredef.h>
#define SPELLTYPE_COUNTER "spelltype_counter"
#pragma strong_types

void create() {
  seteuid(getuid());
  ::create();
}

mapping QuerySpell(string spell) {
  mapping spi;

  if (!spell
      || !(spi=QueryProp(P_SB_SPELLS))
      || !(spi=spi[spell]))
    return 0;
  return copy_mapping(spi);
}

varargs int
AddSpell(string verb, int kosten, mixed ski) {
  int level;
  mapping spells;

  if (!verb || kosten<0)
    return 0;
  verb=lower_case(verb);
  level=(intp(ski))?ski:0;
  if (!mappingp(ski)) ski=([]);
  ski=AddSkillMappings(QueryProp(P_GLOBAL_SKILLPROPS),ski);
  ski+=([SI_SPELLCOST:kosten]);
  if (level)
    ski=AddSkillMappings(ski,([SI_SKILLRESTR_LEARN:([P_LEVEL:level])]));
  if (!(spells=QueryProp(P_SB_SPELLS)))
    spells=([]);
  SetProp(P_SB_SPELLS,spells+([verb:ski]));
  return 1;
}

int
TryAttackSpell(object victim, int damage, mixed dtypes,
               mixed is_spell, object caster, mapping sinfo) {
  mixed noattack, diemsg;
  object *u;
  string message;
  int i, arena, maxdamage;
  
  if (noattack = victim->QueryProp(P_NOATTACK)) {
    if (stringp(noattack))
      write(victim->Name(WER,1)+" "+noattack+"\n");
    else
      write(victim->Name(WER,1)+" springt geschickt aus Deiner Reichweite.\n");
    return 0;
  }
  if ((maxdamage=sinfo[SI_MAX_DAMAGE]) && damage>maxdamage )
    damage=maxdamage;
  
  // Schaden berechnen, SA_DAMAGE ist ein prozentualer Multiplikator
  damage = (damage * caster->QuerySkillAttribute(SA_DAMAGE)) / 100;

  if (query_once_interactive(victim) && query_once_interactive(caster) &&
      !(IS_LEARNER(caster) && IS_LEARNER(victim)) &&
      !(victim->QueryProp(P_TESTPLAYER)) ) 
  {
    arena= call_other ("/obj/pkmaster", "PK_allowed", environment(caster), caster, victim);
    if(!arena)
    {
      log_file("combat/ATTACKS", dtime(time())+", "+
          capitalize(caster->query_real_name())+
          " greift "+capitalize(victim->query_real_name())+
          " an (Spellbook).\n");

      message="**** "+capitalize(caster->query_real_name())+" greift "+
        capitalize(victim->query_real_name())+" an (Spellbook) ****\n";
      u=users();
      for (i=sizeof(u)-1;i>=0;i--)
        if (IS_LORD(u[i]))
          tell_object(u[i],message);
      call_out("tried_pk", 0, caster, victim);   
      return 0;
    }
    else if( !caster->InFight())
    {
      log_file("combat/PK", dtime(time())+", "+
          capitalize(caster->query_real_name())+
          " greift "+capitalize(victim->query_real_name())+
          " an (Spellbook).\n");
    }
  }
  if((sinfo[SI_NOMAGIC] < victim->QueryProp(P_NOMAGIC)) &&
      victim->QueryProp(P_NOMAGIC)*100 >
      random(100)*caster->QuerySkillAttribute(SA_ENEMY_SAVE)) 
  {
    if(stringp(sinfo[SI_COMBAT_NOMAGIC_MSG]))
      printf(sinfo[SI_COMBAT_NOMAGIC_MSG], victim->Name(WER, 1));
    else
      printf("%s wehrt Deinen Zauber ab.\n", victim->Name(WER, 1));
    return 0;
  }
  else
  {
    diemsg=victim->QueryProp(P_DIE_MSG);
    if( sinfo[SI_DIE_MSG] )
      victim->SetProp(P_DIE_MSG, sinfo[SI_DIE_MSG]);
    damage=victim->Defend(damage, dtypes, is_spell, caster);
    if( victim )  
      victim->SetProp(P_DIE_MSG, diemsg);
    return damage;
  }
}

nosave void tried_pk(object caster, object victim)
{  
  if (previous_object()!=this_object()) return;
  if (!objectp(caster)) return;
  // das geht so im spellbook nicht! (Zordan)
  // while (remove_call_out("tried_pk") != -1);
  if(environment(caster) != find_object("/room/entscheidung"))
    catch (call_other ("/obj/pkmaster", "TriedPK", caster, victim));
}

varargs int
TryDefaultAttackSpell(object victim, object caster, mapping sinfo, mixed str) {
  if (!str) str=1;
  return TryAttackSpell(victim,
                        (GetOffset(SI_SKILLDAMAGE,sinfo,caster)+
                         random(GetFValue(SI_SKILLDAMAGE,sinfo,caster))),
                        GetData(SI_SKILLDAMAGE_TYPE,sinfo,caster),
                        str,
                        caster,
                        sinfo);
}

#define SMUL(x,y) ((x<0 && y<0)?(-1*x*y):(x*y))
int
SpellSuccess(object caster, mapping sinfo) {
  int cval,abil,res, *sp_count, diff;
  abil=sinfo[SI_SKILLABILITY];
  cval=(int)caster->UseSkill(SK_CASTING);
  res=abil + (SMUL(abil,cval)) / MAX_ABILITY - 
      random(MAX_ABILITY-(abil==MAX_ABILITY?2000:0));
//  if (cval && res>MAX_ABILITY) // besonders gut gelungen?
//    caster->LearnSkill(SK_CASTING,1+(res-MAX_ABILITY)/2000);
//  Das Lernen des Casting soll jede Gilde selbst uebernehmen.
  return res;
}

int
CanTrySpell(object caster, mapping sinfo) {
  mapping rmap;
  string res;
  if (caster->QueryProp(P_DISABLE_SPELLS)) {
    write(sinfo[SI_DISABLED_MSG] ||
          "Dazu fehlt Dir derzeit die Konzentration.\n");
    return 0;
  }
  if (caster->QueryProp(P_RESTING)) {
    write("Dazu fehlt Dir derzeit die Konzentration.\n");
    return 0;
  }
  if (caster->QueryProp(P_GHOST)) {
    write("Als Geist kannst Du nicht zaubern.\n");
    return 0;
  }
  if( caster->InFight() && caster->QueryProp(P_ATTACK_BUSY))
  {
    write("Dazu bist zu erschoepft.\n");
    return 0;
  }
  caster->SetProp(P_ATTACK_BUSY, 1);
  if ((rmap=sinfo[SI_SKILLRESTR_USE])
      && (res=check_restrictions(caster,rmap))) {
    write(res);
    return 0;
  }
  return 1;
}

void
Learn(object caster, string spell, mapping sinfo) {
  int val,diff;
  string attrib;
  if(! attrib=sinfo[SI_SKILLLEARN_ATTRIBUTE])
    attrib=A_INT;
  val=((caster->QueryAttribute(attrib)/2)*GetFValue(SI_SKILLLEARN,sinfo,caster)+
       GetOffset(SI_SKILLLEARN,sinfo,caster));
  if (!(diff=GetFValueO(SI_DIFFICULTY,sinfo,caster)))
    diff=GetFValueO(SI_SPELLCOST,sinfo,caster);
  caster->LearnSkill(spell,val,diff);
}

void
Erfolg(object caster, string spell, mapping sinfo) {
  object env;
  if (env=environment(caster))
    env->SpellInform(caster,spell,sinfo);
}

void
Misserfolg(object caster, string spell, mapping sinfo) {
  int old_abil;
  object victim;
  if(sinfo[SI_FAIL_MSG]) 
    write(SI_FAIL_MSG);
  else 
    write("Der Zauberspruch ist missglueckt.\n");
  old_abil = sinfo[SI_SKILLABILITY];
  if(sinfo[SI_SKILLARG] && (victim=present(sinfo[SI_SKILLARG], 
          environment(caster)) || victim=present(sinfo[SI_SKILLARG], caster)))
  {
    if(victim->id(SID_NOLEARN)) 
      return;
  }
  Learn(caster,spell,sinfo);
  sinfo=caster->QuerySkill(spell);

  if (old_abil < (mappingp(sinfo) ? sinfo[SI_SKILLABILITY] : sinfo))
    if(sinfo[SI_LEARN_MSG]) 
      write(sinfo[SI_LEARN_MSG]);
    else
      write("Du lernst aus Deinem Fehler.\n");
  else
    if(sinfo[SI_NOLEARN_MSG])
      write(sinfo[SI_NOLEARN_MSG]);
    else
      write("Leider lernst Du nicht aus Deinem Fehler.\n");
}

string
SelectSpell(string spell, mapping sinfo) {
  if (sinfo && sinfo[SI_SKILLFUNC])
    return sinfo[SI_SKILLFUNC];
  return spell;
}

void
prepare_spell(object caster, string spell, string msg) {
  if (!caster || !spell) return;
  tell_object(caster,
      msg || "Du bereitest Dich auf den Spruch ``"+spell+"'' vor.\n");
}

varargs int
UseSpell(object caster, string spell, mapping sinfo) {
  mapping ski;
  string spellbook,sname,fname,txt;
  int fat,cost;
  int *sp_count, diff;
  mixed ps,res;

  if (!caster || !spell)
    return 0;
  //write(sprintf("--- spellbook\ncaster = %O\nspell = %O\nsinfo = %O\n", caster, spell, sinfo));
  //sname=SelectSpell(spell,sinfo);
  //printf("sname = %O\n", sname);
  // Spell kann in der Gilde anderen Namen haben
  if (!(ski=QuerySpell(spell))) // Existiert dieser Spell?
    return 0;
  ski=AddSkillMappings(ski,sinfo);
  // Gildeneigenschaften sollen Spelleigenschaften ueberschreiben koennen
  ski=race_modifier(caster,ski);
  // Fuer verschiedene Rassen unterschiedliche Eigenschaften

  //printf("Spellinfo = %O\n",ski);

  if (!CanTrySpell(caster, ski))
    return 1;

  /* SpellCheck wer wieoft spells macht! */
  if(!caster->InFight()) {
    if(pointerp(caster->QueryProp(SPELLTYPE_COUNTER)))
      sp_count=caster->QueryProp(SPELLTYPE_COUNTER);
    else 
      sp_count=({0,0});
    diff=time()-caster->QueryProp(P_LAST_SPELL_TIME);
    if(diff>=sp_count[0]-1 && diff<=sp_count[0]+1) sp_count[1]++;
    else sp_count=({diff,0});
    if(sp_count[1]>40) {
      tell_object(caster, "Du fuehlst Dich erschoepft.\n");
      write_file("/log/ARCH/SPELLS", 
          sprintf("%s: %s - %s\n", dtime(time()), getuid(caster), spell));
      sp_count=({0,0});
      caster->SetProp(P_NEXT_SPELL_TIME, time()+300);
    }
    caster->SetProp(P_LAST_SPELL_TIME, time());
    caster->SetProp(SPELLTYPE_COUNTER, sp_count);
  }
  if (caster->QueryProp(P_SP) < (cost=GetFValueO(SI_SPELLCOST,ski,caster))) {
    if (txt=ski[SI_SP_LOW_MSG]) write(process_string(txt));
    else write("Du hast zu wenig Zauberpunkte fuer diesen Spruch.\n");
    return 1;
  }
  // printf("cost: %d\n",cost);
  if (time()<caster->QueryProp(P_NEXT_SPELL_TIME)) {
    if (txt=ski[SI_TIME_MSG]) write(process_string(txt));
    else write("Du bist noch zu erschoepft von Deinem letzten Spruch.\n");
    return 1;
  }

  // Spruchvorbereitung
  if (pointerp(ps=caster->QueryProp(P_PREPARED_SPELL)) // Ausstehender Spruch
      && (sizeof(ps)>=3) && intp(ps[0]) && stringp(ps[1])) {
    if (ps[1]==spell) { // Dieser Spruch wird noch vorbereitet
      if (time()<ps[0]) {
        write("Du bist noch mit der Spruchvorbereitung beschaeftigt.\n");
        return 1;
      }
    } else {    // Andere Sprueche brechen die Vorbereitung ab
      write("Du brichst die Spruchvorbereitung fuer ``"+ps[1]+"'' ab.\n");
      ps=0;
    }
  }
  else ps=0;
  // Checkfunktion vor der Vorbereitung
  if(ski[SI_PREPAREFUNC] && !ps) {
    if(!res=call_other(this_object(), ski[SI_PREPAREFUNC], caster, ski))
      return 1;
    if (mappingp(res))
      ski=res; //res wurde von prep-funktion manipuliert und zurueckgeliefert!
  }
  if ((fat=ski[SI_PREPARE_TIME]) && !ps)  // Spruch braucht Vorbereitungszeit
  {
    if (QueryProp(P_SB_NEW_PREPAREFUNC))
      caster->SetProp(P_PREPARED_SPELL,({time()+fat,spell,ski}));
    else //alter aufruf
      caster->SetProp(P_PREPARED_SPELL,({time()+fat,spell,ski[SI_SKILLARG]}));
    prepare_spell(caster,spell,ski[SI_PREPARE_MSG]);
    return 1;
  }
  else if (!ps)
    caster->SetProp(P_PREPARED_SPELL, 0);

  if (!(fname=sinfo[SI_SPELLFUNC]))
    fname=sname;
  //printf("fname = %O\n", fname);
  // Funktion kann anderen Namen haben als Spell
  res=0;
  if((ski[SI_NOMAGIC] < environment(caster)->QueryProp(P_NOMAGIC)) &&
      random(100) < environment(caster)->QueryProp(P_NOMAGIC)) {
    if (txt=ski[SI_NOMAGIC_MSG]) write(txt);
    else write("Dein Zauberspruch verpufft im Nichts.\n");
    res=ERFOLG;
  } else {
    res=call_other(this_object(),fname,caster,ski);
  }
  if (!res)
    return 1;

  if ((fat=GetFValueO(SI_SPELLFATIGUE,ski,caster))<0)
    fat=1;
  caster->AddSp(-1*cost);
  caster->SetProp(P_NEXT_SPELL_TIME,time()+fat);
  caster->Set(P_NEXT_SPELL_TIME,SAVE,F_MODE_AS);

  if (res>0)
    Erfolg(caster,spell,ski);
  else
    Misserfolg(caster,spell,ski);
  return 1;
}

nosave varargs object
find_victim(string wen, object pl) {
  object victim;

  if (!pl) return 0;
  if (!strlen(wen)) {
    if (victim = pl->QueryEnemy())
      return victim;
    else
      return 0;
  }
  if (victim = present(wen, environment(pl)))
    return victim;
  else if (victim = present(wen, pl))
    return victim;
  else
    return 0;
}
varargs object
FindVictim(string wen, object pl, string msg) {
  object vic;

  if (!(vic=find_victim(wen,pl)) && msg)
    write(msg);
  return vic;
}
varargs object
FindLivingVictim(string wen, object pl, string msg) {
  object vic;

  if (!(vic=FindVictim(wen,pl,msg)))
    return 0;
  if (!living(vic)) {
    printf("%s lebt doch nicht!\n", capitalize(vic->name()));  
    return 0;
  }
  return vic;
}
varargs object
FindEnemyVictim(string wen, object pl, string msg) {
  object vic;
  mixed noattack;
  int arena;

  if (!(vic=FindLivingVictim(wen,pl,msg))) {
    if ((stringp(wen) && wen!="") || !objectp(pl))
      return 0;
    if (!(vic=pl->SelectEnemy()))
      return 0;
  }
  if (noattack = vic->QueryProp(P_NOATTACK)) {
    if (stringp(noattack))
      write(vic->Name(WER,1)+" "+noattack+"\n");
    else
      write(vic->Name(WER,1)+" springt geschickt aus Deiner Reichweite.\n");
    return 0;
  }
  if (vic==pl) {
    write("Du koenntest Dir dabei wehtun.\n");
    return 0;
  }
  if (query_once_interactive(vic) && query_once_interactive(pl) &&
      !(IS_LEARNER(pl) && IS_LEARNER(vic)) &&
      !(vic->QueryProp(P_TESTPLAYER)) ) 
  {
    arena= call_other ("/obj/pkmaster", "PK_allowed", environment(pl), pl, vic);
    if(!arena)
    {
      write(vic->Name(WER)+" ist ein Spieler!\n"
          "Das Angreifen von Spielern ist hier nicht erlaubt!\n");
      return 0;
    }
  }
  if (!pl->IsEnemy(vic)) // War es bisher kein Feind?
    pl->Kill(vic);       // Dann ist es jetzt einer.
  return vic;
}

object *
FindGroup(object pl, int who) {
  object *res,ob,env;
  int p1,p2;

  res=({});
  if (!pl || !(env=environment(pl))) return res;
  p1=((int)(query_once_interactive(pl)?1:-1));
  for (ob=first_inventory(env);ob;ob=next_inventory(ob)) {
    if (!living(ob)) continue;
    p2=((int)((query_once_interactive(ob)||ob->QueryProp(P_FRIEND))?1:-1));
    if (p2>0 && !interactive(ob) && query_once_interactive(ob))
      continue; // keine Netztoten.
    if (IS_LEARNING(ob) &&
        (ob->QueryProp(P_INVIS) || (who<0 && !pl->IsEnemy(ob))))
      continue;
    if (who<0 && ob->QueryProp(P_NO_GLOBAL_ATTACK))
      continue;
    if(ob->QueryProp(P_NOATTACK))
      continue;
    if (p1*p2*who >=0)
      res+=({ob});
  }
  return res;
}

object *
FindGroupN(object pl, int who, int n) {
  if (!pl) return ({});
  n=(n*pl->QuerySkillAttribute(SA_EXTENSION))/100;
  if (n<1) n=1;n--;
  return FindGroup(pl,who)[0..n];
}

object *
FindGroupP(object pl, int who, int pr) {
  object *res,*nres;
  int i;

  nres=({});
  if (!pl) return nres;
  pr=(pr*pl->QuerySkillAttribute(SA_EXTENSION))/100;
  res=FindGroup(pl,who);
  for (i=sizeof(res)-1;i>=0;i--)
    if (pr>=random(100))
      nres+=({res[i]});
  return nres;
}
