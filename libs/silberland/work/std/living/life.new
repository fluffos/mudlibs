// living object life variables
//
//  P_ALIGN         -- alignment value
//  P_ALIGN_STRING  -- alignment string
//  P_NPC           -- if living is an NPC
//  P_HP            -- HitPoints
//  P_SP            -- SpellPoints
//  P_ALCOHOL       -- value of intoxication
//  P_DRINK         -- value of soakness
//  P_FOOD          -- value of stuffness
//  P_AGE           -- Age
//  P_XP            -- experience
//  P_POISON        -- level of poison
//  P_CORPSE        -- corpse-object
//  P_CORPSE_PROPS  -- corpse-object properties

#pragma strong_types

#define NEED_PROTOTYPES

#include <thing/properties.h>
#include <thing.h>
#include <properties.h>
#include <config.h>
#include <health.h>
#include <wizlevels.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <combat.h>
#include <new_skills.h>
#include <living.h>
#include <npcmaster.h>

#define ALCOHOL_VALUE(n) n

#include "log.h"

int age;                  /* Number of heart beats of this character. */

static int delay_alcohol; /* time until next alcohol effect */
static int delay_drink;   /* time until next drink effect */
static int delay_food;    /* time until next food effect */
static int delay_heal;    /* time until next heal effect */
static int delay_sp;      /* time until next sp regeneration */
static int delay_poison;  /* time until next poison effect */
static int delay_temp;    /* time until next temperature effect */
static int delay_theal;   /* time until next heal effect if out of temp */
static int delay_tsp;     /* time until next sp regeneration if out of temp */

static int htemp;         /* temperature difference */
static int lasthtemp;     /* to prevent NPC_TEMPERATURE logfile flooding... */
static int drop_poison;
static mapping enemy_damage;

// local properties prototypes
static int _set_align(int a);
static int _set_hp(int hp);
static int _set_sp(int sp);
static int _set_mv(int mv);
static int _set_alcohol(int n);
static int _set_drink(int n);
static int _set_food(int n);
static int _set_poison(int n);
static int _query_age();
static int _set_xp(int xp);
mixed _set_die_hook(mixed hook);
static int _set_blind(mixed bl);
static int _set_deaf(mixed taub);
static int _set_paralyzed(mixed para);

void create()
{
  Set(P_GHOST, SAVE, F_MODE);
  Set(P_FROG, SAVE, F_MODE);
  Set(P_ALIGN, SAVE, F_MODE);
  Set(P_ALIGN_STRING, SAVE, F_MODE);
  Set(P_HP, SAVE, F_MODE);
  Set(P_SP, SAVE, F_MODE);
  Set(P_MV, SAVE, F_MODE);
  Set(P_XP, SAVE, F_MODE);
  Set(P_TOTAL_TEMPERATURE_PROTECTION, PROTECTED, F_MODE);
  SetProp(P_TOTAL_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:0,T_HEAT_PROT:0 ]) );

  Set(P_ALCOHOL, SAVE, F_MODE);
  Set(P_DRINK, SAVE, F_MODE);
  Set(P_FOOD, SAVE, F_MODE);
  Set(P_POISON, SAVE, F_MODE);

  SetProp(P_FOOD_DELAY, FOOD_DELAY);
  SetProp(P_DRINK_DELAY, DRINK_DELAY);
  SetProp(P_ALCOHOL_DELAY, ALCOHOL_DELAY);
  SetProp(P_HP_DELAY, HEAL_DELAY);
  SetProp(P_SP_DELAY, HEAL_DELAY);
  SetProp(P_POISON_DELAY, POISON_DELAY);

  Set(P_AGE, -1, F_SET_METHOD);
  Set(P_AGE, PROTECTED, F_MODE);
  SetProp(P_CORPSE, "/std/corpse");

  enemy_damage=([]);
}

/*
 * This function is called from other players when they want to make
 * damage to us. But it will only be called indirectly.
 * We return how much damage we received, which will
 * change the attackers score. This routine is probably called from
 * heart_beat() from another player.
 * Compare this function to reduce_hit_point(dam).
 */
int do_damage(int dam, mixed enemy) 
{
  int hit_point;
  int al;
  int xp_gain;

  if (QueryProp(P_GHOST) || QueryProp(P_NOATTACK) || dam <= 0 || 
      (objectp(enemy) &&
       (enemy->QueryProp(P_GHOST) || enemy->QueryProp(P_NOATTACK))))
    return 0;

  // direktes do_damage() (nicht aus Defend!) bei rein-raus abschwaechen
  if (extern_call()
      && objectp(enemy)
      && living(enemy)
      && !QueryProp(P_ENABLE_IN_ATTACK_OUT)) {
    al = time() - enemy->QueryProp(P_LAST_MOVE);
    if (al <= 3)
      // 1. Runde: damage/4, 2. Runde: damage/2
      dam /= (4 - al);
  }

  hit_point = QueryProp(P_HP)-dam;
  if (QueryProp(P_XP) && enemy)
  {
    xp_gain= dam*(int)QueryProp(P_TOTAL_WC)/10;
    enemy->AddExp(xp_gain)
    enemy_damage[enemy]+=dam;
  }
  SetProp(P_HP, hit_point);
  if (hit_point<0) {
    if (enemy)
    {
      int exp_to_give, total_damage, tmp, i;
      mixed *present_enemies, *inv;

      enemy->StopHuntFor(ME,1);
      present_enemies=({});
      exp_to_give=QueryProp(P_XP)/100;
      inv=all_inventory(environment());
      for (i=sizeof(inv)-1; i>=0; i--)
        if (tmp=enemy_damage[inv[i]])
        {
          total_damage+=tmp;
          present_enemies+=({({inv[i], tmp})});
        }
      if (!total_damage)
        enemy->AddExp(exp_to_give);
      else
        for (i=sizeof(present_enemies)-1; i>=0; i--)
          present_enemies[i][0]->AddExp(exp_to_give*present_enemies[i][1]/
                                        total_damage);

      if (!query_once_interactive(ME) && QueryProp(P_XP)>500*100)
      {
        if (QueryProp(P_XP) > 25*QueryProp(P_TOTAL_WC)*QueryProp(P_MAX_HP))
          log_file ("npc/NPC_XP_ILLEGAL", file_name(ME) + ", XP: " +
                    (QueryProp(P_XP)/100) + ", HP*WC/20: "+
                    (QueryProp(P_TOTAL_WC)*QueryProp(P_MAX_HP)/20)+
                    ", Killer: " + enemy->Name() + "\n");
        else if (QueryProp(P_XP) > 10*QueryProp(P_TOTAL_WC)*QueryProp(P_MAX_HP))
          log_file ("npc/NPC_XP_HIGH", file_name(ME) + ", XP: " +
                    (QueryProp(P_XP)/100) + ", HP*WC/20: "+
                    (QueryProp(P_TOTAL_WC)*QueryProp(P_MAX_HP)/20)+
                    ", Killer: " + enemy->Name() + "\n");
        else
          log_file ("npc/NPC_XP", file_name(ME) + ", XP: " +
                    (QueryProp(P_XP)/100) + ", HP*WC/20: "+
                    (QueryProp(P_TOTAL_WC)*QueryProp(P_MAX_HP)/20)+
                    ", Killer: " + enemy->Name() + "\n");
      }

      // Align
      // al = enemy->QueryProp(P_ALIGN) / 10 + QueryProp(P_ALIGN) / 4;
      al = enemy->QueryProp(P_ALIGN) / 32 + QueryProp(P_ALIGN) / 12;
      if (al > 100) al = 100;
      else if (al < -100) al = -100;
      enemy->SetProp(P_ALIGN, enemy->QueryProp(P_ALIGN) - al);
    }
    SetProp(P_KILLER, enemy);
    StopHuntingMode(1);
    die();
  }
  return dam;
}

void transfer_all_to(mixed dest)
{
  object *ob;
  string prop;
  int lootfails;

{
  object *ob;
  string prop;
  int lootfails;

  ob = all_inventory(ME);
  if(sizeof(ob) && objectp(QueryProp(P_KILLER)) &&
     QueryProp(P_KILLER)->QueryProp(P_LOOTING) )
  {
      lootfails = 0;
      tell_object(QueryProp(P_KILLER),"Du pluenderst die Leiche.\n");
      tell_room(environment(ME), QueryProp(P_KILLER)->Name(WER,1)+
        " pluendert die Leiche.\n", ({ME, QueryProp(P_KILLER) }) );
  }

  if (query_once_interactive(this_object()))
    prop = P_NEVERDROP; // Spieler behalten ihre NEVERDROP sachen
  else
    prop = P_NODROP; // NODROP sachen von NPCs werden nicht gepluendert

  while (sizeof(ob))
  {
    if ( objectp(ob[0]) && !ob[0]->QueryProp(prop) )
    {
      ob[0]->move(dest,M_SILENT|M_NOCHECK); /* no unwield messages */
      if( objectp(QueryProp(P_KILLER)) &&
          QueryProp(P_KILLER)->QueryProp(P_LOOTING) )
      {
        QueryProp(P_KILLER)->pick_obj( ob[0] );
        if (environment(ob[0]) != QueryProp(P_KILLER))
          lootfails++;
      }
    }
    ob = ob[1..];
  }
  if ( lootfails && objectp(QueryProp(P_KILLER)) &&
       QueryProp(P_KILLER)->QueryProp(P_LOOTING) )
  {
    tell_object(QueryProp(P_KILLER),
        "Du konntest die Leiche nicht vollstaendig pluendern.\n");
  }
  SetProp(P_USED_HANDS, 0);
}

static void create_kill_log_entry(string killer)
{
  int level, lost_exp;

  if ((level=ME->QueryProp(P_LEVEL))<20 || !IS_SEER(ME))
    lost_exp = ME->QueryProp(P_XP)/3;
  else
    lost_exp = ME->QueryProp(P_XP)/(level-17);

  log_file("combat/KILLS",
      sprintf("%s %s [%d,%d] %s\n", ctime()[4..15],
        capitalize(getuid(ME)), level, lost_exp, killer), 0, 1);
}

varargs void die(int poisondeath)
{
  object corpse;
  string die_msg;
  string tmp;
  mapping props;
  mixed *ind, res;
  int i;

  if ( QueryProp(P_GHOST) )
    return; // Ghosts dont die ...

  if (res=QueryProp(P_TMP_DIE_HOOK))
  {
    if ( pointerp(res) && sizeof(res) >= 3
         && intp(res[0]) && time() < res[0]
         && objectp(res[1]) && stringp(res[2]) )
    {
      if ( res = call_other( res[1], res[2], poisondeath ) )
        return;
    }
    else
      SetProp(P_TMP_DIE_HOOK,0);
  }

  if (IS_LEARNING(ME) && query_once_interactive(ME))
  {
    tell_object(ME,
        "Sei froh dass Du unsterblich bist, sonst waere es eben "
        "Dein Ende gewesen.\n");
    return;
  }

  // Einige Werte bei echten Toden zuruecksetzen
  if ( query_once_interactive(this_object()) )
  {
    if (QueryProp(P_POISON)) {
      Set( P_POISON, F_SET_METHOD, 0 );
      Set( P_POISON, F_QUERY_METHOD, 0 );
      Set( P_POISON, 0 );       /* Don't die twice of the same poison */
    }

    Set( P_LAST_DIE_TIME, time());
    Set( P_ALCOHOL,     0 );
    Set( P_DRINK,       0 );
    Set( P_FOOD,        0 );
    Set( P_BLIND,       0 );
    Set( P_DEAF,        0 );
    Set( P_PARA,        0 );
    Set( P_PARALYZED,   0 );    // bei P_FROG SetProp statt Set, damit
    SetProp( P_FROG,    0 );    // Attributmodifier wieder geloescht werden
    if (QueryProp(P_HP) > 0) {
      // damit der Teddy o.ae. mitbekommt, dass man jetzt tot ist ]:->
      SetProp(P_HP, 0);
      SetProp(P_SP, 0);
    }
  }

  map_objects( QueryEnemies()[0], "StopHuntFor", ME, 1 );
  StopHuntingMode(1);

  if (query_once_interactive(ME) && extern_call() && 
      previous_object() != this_object())
  {
    corpse = previous_object() || this_interactive() || this_player();
    if (corpse)
    {
      tmp = efun::explode(file_name(corpse),"#")[0] + " (direkt !)";

      if ( strlen(tmp) > 33 )
        tmp = "..." + tmp[<31..];

      create_kill_log_entry( tmp + " (" + REAL_UID(corpse) + ")" );
      log_file("interactive/DIE", sprintf("[%s] %11s %s\n",
            ctime()[4..], capitalize(getuid(ME)), tmp), 0, 1);
    }
    if ( query_once_interactive(corpse) &&
         !QueryProp(P_TESTPLAYER) && !IS_LEARNER(ME) )
    {
      if(!call_other ("/obj/pkmaster", "PK_allowed", environment(ME), corpse, ME))
      {
        corpse->SetProp( P_KILLS, -1 );
        log_file( "irregular/PLAYERKILLS",
            sprintf( "%s %s (%d/%d) toetete %s (%d/%d)\n",
              ctime(),
              capitalize(getuid(corpse)),
              query_wiz_level(corpse), corpse->QueryProp(P_LEVEL),
              capitalize(getuid(ME)),
              query_wiz_level(ME), QueryProp(P_LEVEL) ) );
      }
      else
      log_file( "combat/PK",
          sprintf( "%s, %s (%d/%d) toetete %s (%d/%d)\n",
                   dtime(time()),
                   capitalize(getuid(corpse)),
                   query_wiz_level(corpse), corpse->QueryProp(P_LEVEL),
                   capitalize(getuid(ME)),
                   query_wiz_level(ME), QueryProp(P_LEVEL) ) );

    }
  }

  if (!query_once_interactive(ME))
  {
    corpse = ((object) QueryProp(P_KILLER)) || previous_object() ||
             this_interactive() || this_player();

    if (corpse && query_once_interactive(corpse)) {
      res = QueryProp(P_XP);
      if (res < NPC_EXP_MARK1) res = 0;
      else if (res < NPC_EXP_MARK2) res = 1;
      else if (res < NPC_EXP_MARK3) res = 2;
      else res = 3;
      if ( !QueryProp(P_NO_SCORE) && !IS_LEARNER(corpse) &&
           pointerp(res = NPCMASTER->QueryNPC(res)))
        corpse->AddScore(res[0]);
    }
  }

  if (poisondeath) {
    switch (poisondeath)
    {
      case 2:
        die_msg = " wird von Kaelte hinweggerafft und kippt um.\n";
        Set(P_LAST_DAMTYPES, ({ DT_COLD }));
        break;
      case 3:
        die_msg = " wird von Hitze hinweggerafft und kippt um.\n";
        Set(P_LAST_DAMTYPES, ({ DT_FIRE }));
        break;
      default:
        die_msg = " wird von Gift hinweggerafft und kippt um.\n";
        Set(P_LAST_DAMTYPES, ({ DT_POISON }));
    }
  }
  else if (!die_msg=QueryProp(P_DIE_MSG))
    die_msg = " faellt tot zu Boden.\n";

  // Todesmeldung ausgeben
  say (ME->Name(WER,1) + die_msg);

  if (query_once_interactive(ME))
    Set( P_DEADS, Query(P_DEADS) + 1 );

  if ( QueryProp(P_NOCORPSE) || !(tmp = QueryProp(P_CORPSE)) ||
       !objectp(corpse = clone_object(tmp)) )
    transfer_all_to( environment() );
  else
  {
    if (!objectp(corpse))
      corpse = clone_object(QueryProp(P_CORPSE));
    if (!(QueryProp(P_CORPSE_FLAGS) & COR_NOSETWEIGHT))
      corpse->SetProp(P_WEIGHT,QueryProp(P_WEIGHT));
    corpse->SetProp(P_HEAL, QueryProp(P_HEAL));
    corpse->Identify(ME);
    if (query_once_interactive(ME))
      SetProp(P_LAST_CORPSE, corpse);
    if (!(QueryProp(P_CORPSE_FLAGS) & COR_NOINVTRANSFER))
      transfer_all_to(corpse);
    else
      transfer_all_to(environment(ME));
    if (props=QueryProp(P_CORPSE_PROPS))
    {
      ind = m_indices(props);
      for (i=sizeof(ind); i>0; i)
        corpse->SetProp(ind[--i], props[ind[i]]);
    }
    if (QueryProp(P_CORPSE_FLAGS) & COR_MSGIN)
      corpse->move(environment(ME),M_GO|M_NOCHECK);
    else
      corpse->move(environment(ME),M_NOCHECK);
    if (QueryProp(P_CORPSE_FLAGS) & COR_KILLENEMY)
      corpse->Kill(QueryProp(P_KILLER));
  }
  if (!ME->second_life(corpse)) {
    Set(P_GHOST, 1);
    remove();
  }
}

void heal_self(int h) {
  if(h <= 0) return;
  SetProp(P_HP, QueryProp(P_HP)+h);
  SetProp(P_SP, QueryProp(P_SP)+h);
}

int AddSp(int value) {
  SetProp(P_SP, QueryProp(P_SP) + value);
  return QueryProp(P_SP);
}

void restore_spell_points(int value) {
  SetProp(P_SP, QueryProp(P_SP) + value);
}

int AddHp(int value) {
  // Falls value < 0 -> minimal auf 1 HP senken
  if(SetProp(P_HP, (QueryProp(P_HP) + value)) <= 0) SetProp(P_HP, 1);
  return QueryProp(P_HP);
}

int reduce_hit_point(int dam) {
  object o;
#ifdef LOG_REDUCE_HP
  if (this_player()!=this_object()) {
    log_file("interactive/REDUCE_HP", file_name(ME)+" by ");
    if (!this_player())
      log_file("interactive/REDUCE_HP","?\n");
    else {
      log_file("interactive/REDUCE_HP",file_name(this_player()));
      o=previous_object();
      if (o)
        log_file("interactive/REDUCE_HP", " " + file_name(o) + ", " +
                 o->name(WER,0) + " (" + creator(o) + ")\n");
      else
        log_file("interactive/REDUCE_HP", " ??\n");
    }
  }
#endif
  return AddHp(-dam);
}

int AddPoison(int strength)
{
  return SetProp(P_POISON, QueryProp(P_POISON) + strength);
}

varargs int drink_alcohol(int strength, int silent)
{
  int alc;

  alc = QueryProp(P_ALCOHOL)+ALCOHOL_VALUE(strength);
  if ((alc > QueryProp(P_MAX_ALCOHOL)) &&
      !IS_LEARNER(this_object()))
  {
    if (!silent)
      tell_object(ME,
          "Scho ein Pech, Du - hicksch! - hascht allesch verschuettet.\n");
    return 0;
  }
  if (alc < 0) alc = 0;
  if (!alc && !silent)
    tell_object(ME, "Du bist stocknuechtern.\n");
  else if ((alc > QueryProp(P_ALCOHOL)) && !silent)
    tell_object(ME, "Du fuehlst Dich etwas angeheiterter.\n");
  SetProp(P_ALCOHOL, alc);
  return 1;
}

varargs int drink_soft(int strength, int silent)
{
  int soaked;

  soaked = QueryProp(P_DRINK)+DRINK_VALUE(strength);
  if((soaked > QueryProp(P_MAX_DRINK)) &&
     !IS_LEARNER(this_object()))
  {
    if (!silent)
      tell_object(ME,
          "Du bist so voll, dass Du echt keinen Schluck mehr runterkriegst.\n");
    return 0;
  }
  if(soaked < 0) soaked = 0;
  if(!soaked && !silent) tell_object(ME, "Dir klebt die Zunge am Gaumen.\n");
  SetProp(P_DRINK, soaked);
  return 1;
}

varargs int drink_drink(int soak, int alc, int silent)
{
  int soaked, alcohol, res;
  res=this_object()->UseSkill(SK_BOOZE,([SI_SKILLARG:alc]));
  if (intp(res) && res>0) alc=res;
            
  alcohol = QueryProp(P_ALCOHOL)+ALCOHOL_VALUE(alc);
  soaked = QueryProp(P_DRINK)+DRINK_VALUE(soak);
  if (!IS_LEARNER(this_object()))
    if (alcohol > QueryProp(P_MAX_ALCOHOL)) {
      if (!silent)
        tell_object(ME,
          "Scho ein Pech, Du - hicksch! - hascht allesch verschuettet.\n");
      return 0;
    }
    else if (soaked > QueryProp(P_MAX_DRINK)) {
      if (!silent)
        tell_object(ME,
          "Du bist so voll, dass Du echt keinen Schluck mehr runterkriegst.\n");
      return 0;
    }
  if (alcohol < 0) alcohol = 0;
  if (soaked < 0) soaked = 0;
  if (!alcohol && !silent)
    tell_object(ME, "Du bist stocknuechtern.\n");
  else if ((alcohol > QueryProp(P_ALCOHOL)) && !silent)
    tell_object(ME, "Du fuehlst Dich etwas angeheiterter.\n");
  SetProp(P_ALCOHOL, alcohol);
  SetProp(P_DRINK, soaked);
  return 1;
}

varargs int eat_food(int strength, int silent)
{
  int stuffed;

  stuffed = QueryProp(P_FOOD)+FOOD_VALUE(strength);
  if ((stuffed > QueryProp(P_MAX_FOOD)) && 
      !IS_LEARNER(this_object()))
  {
    if (!silent)
      tell_object(ME,
          "Das ist viel zu viel fuer Dich! Wie waers mit etwas leichterem?\n");
    return 0;
  }
  if (stuffed < 0) stuffed = 0;
  if (!stuffed && !silent)
    tell_object(ME,
        "Oha, Dein Magen knurrt! Du wirst doch nicht hungrig sein?\n");
  SetProp(P_FOOD, stuffed);
  return 1;
}

varargs int do_exhaust(int exhaust, int silent)
{
  int mvs;

  mvs = QueryProp(P_MV)-exhaust;
  if ((mvs < 0) && !IS_LEARNER(this_object()))
  {
    if (!silent)
      tell_object(ME, "Dazu bist Du noch zu erschoepft!\n");
    return 0;
  }
  SetProp(P_MV, mvs);
  return 1;
}

static void heart_beat()
{
  int hpoison, lhp;
  mapping trange, tmod, defic;

  if (!this_object())
    return;

  age++;

  // Als Geist leidet man nicht unter so weltlichen Dingen wie
  // Alkohol, Gift&Co ...
  // Spieler ohne environment - sonst buggst beim einloggen
  if ( QueryProp(P_GHOST) || !environment() )
    return;

  hpoison=QueryProp(P_POISON);
  if(QueryProp(P_ALCOHOL) && !random(40)) {
    int n;
    n=5*(QueryProp(P_ALCOHOL)-1)/QueryProp(P_MAX_ALCOHOL);
    n=random(n);
    switch(n) {
      case 0:
      say(ME->Name(WER,1) + " sagt: <Hick>!\n");
      write("<Hick>! Oh, Tschuldigung.\n");
      break;
      case 1:
      say(ME->Name(WER,1) + " stolpert ueber " +
          QueryPossPronoun(MALE,WEN,PLURAL) + " Fuesse.\n");
      write("Du stolperst.\n");
      break;
      case 2:
      write("Du fuehlst Dich benommen.\n");
      say(ME->Name(WER,1) + " sieht betrunken aus.\n");
      break;
      case 3:
      say(ME->Name(WER,1) + " ruelpst.\n");
      write("Du ruelpst.\n");
      break;
    }
  } 
  if(QueryProp(P_ALCOHOL) && --delay_alcohol < 0) {
    SetProp(P_ALCOHOL, QueryProp(P_ALCOHOL)-1);
    if (!hpoison && !EnemyPresent() ) {
      SetProp(P_HP, QueryProp(P_HP)+1);
      SetProp(P_SP, QueryProp(P_SP)+1);
    }
    delay_alcohol = QueryProp(P_ALCOHOL_DELAY);
  }

  if(--delay_drink < 0) {
    delay_drink = QueryProp(P_DRINK_DELAY);
    SetProp(P_DRINK, QueryProp(P_DRINK)-1);
  }

  if(--delay_food < 0) {
    delay_food = QueryProp(P_FOOD_DELAY);
    SetProp(P_FOOD, QueryProp(P_FOOD)-1);
  }

  /* temperature handling */
  if (--delay_temp < 0) {
    delay_temp = TEMP_DELAY;
    trange = QueryProp(P_TEMPERATURE_RANGE);
    if (mappingp(tmod=QueryProp(P_TOTAL_TEMPERATURE_PROTECTION))) {
      trange[T_COLD_PROT] -= tmod[T_COLD_PROT];
      trange[T_HEAT_PROT] += tmod[T_HEAT_PROT];
    }
    htemp =
      (mappingp(environment()->QueryProp(P_ENVIRONMENT)) ?
        environment()->QueryProp(P_ENVIRONMENT)[ENV_TEMPERATURE]:15)+
      environment()->QueryProp(P_TEMPERATURE_OFFSET)+
      QueryProp(P_TEMPERATURE_OFFSET);
    if (htemp < trange[0])
      htemp -= trange[0];
    else if (htemp > trange[1])
      htemp -= trange[1];
    else htemp = 0;
  }

  /* normal regeneration */
  if(--delay_heal < 0) {
    delay_heal = QueryProp(P_HP_DELAY)-(QueryProp(P_RESTING) ? 1 : 0);
    if (!hpoison && !EnemyPresent() ) {  // Voraussetzung: nicht vergiftet
      if (!htemp)                               // Temperatur ok
        SetProp(P_HP, QueryProp(P_HP)+1+(QueryProp(P_RESTING) ? 1 : 0));
      else if ((-5 < htemp) && (htemp < 5)) {   // Differenz < 5
        if (--delay_theal < 0) {
          delay_theal = THEAL_DELAY;
          SetProp(P_HP, QueryProp(P_HP)+1);
        }
      }
    }
  }

  if(--delay_sp < 0) {
    delay_sp = QueryProp(P_SP_DELAY)-(QueryProp(P_RESTING) ? 1 : 0);
    if (!hpoison && !EnemyPresent() ) {   // Voraussetzung: nicht vergiftet
      if (!htemp)                               // Temperatur ok
        SetProp(P_SP, QueryProp(P_SP)+1+(QueryProp(P_RESTING) ? 1 : 0));
      else if ((-5 < htemp) && (htemp < 5)) {   // Differenz < 5
        if (--delay_tsp < 0) {
          delay_tsp = THEAL_DELAY;
          SetProp(P_SP, QueryProp(P_SP)+1);
        }
      }
    }
  }

  // Netztote leiden nicht unter Gift/Temperatur
  if (query_once_interactive(ME) && !interactive(ME))
  {
    hpoison = 0;
    htemp = 0;
  }

  if (hpoison)  {
    lhp=QueryProp(P_HP);
    hpoison--;
    if (--delay_poison < 0) {
      delay_poison = QueryProp(P_POISON_DELAY) + random(POISON_MERCY_DELAY);
      lhp -= hpoison;
      if (lhp<0) lhp=-1;
      SetProp(P_HP, lhp);
      if (lhp < 0) {
        tell_object(this_object(), "Oh weh - das Gift war zuviel fuer Dich!\n"
                    +"Du stirbst.\n");
        if (query_once_interactive(this_object()) && !IS_LEARNING(this_object()))
        {
          create_kill_log_entry("Vergiftung");
          log_file("interactive/DIE", sprintf("[%s] %11s -GIFT-\n",
                ctime()[4..], capitalize(getuid(ME))));
        }
        die(1);
        return;
      }
      if (((hpoison < 3) || !query_once_interactive(ME)) &&
          (--drop_poison < 0)) {
        switch(hpoison) {
        case 1:
          drop_poison += (15+random(6));  // Das werden etwa 50...
        case 2:
          drop_poison += (25+random(10));
        case 0:
          Set(P_POISON, hpoison);
          if (!hpoison)
            tell_object(this_object(),
                "Du scheinst die Vergiftung ueberwunden zu haben.\n" );
          break;
        default:
          drop_poison += (20-2*hpoison + random(40-3*hpoison));
          Set(P_POISON, hpoison);
        }
      }
    }
    if (hpoison && !random(15))
      switch (QueryProp(P_HP)*100/QueryProp(P_MAX_HP))  {
        case 71..100 :
          write("Du fuehlst Dich nicht gut.\n");
          say(ME->Name(WER)+" sieht etwas benommen aus.\n", ({ME}));
          break;
        case 46..70 :
          write("Dir ist schwindlig und Dein Magen revoltiert.\n");
          say(ME->Name(WER)+" taumelt ein wenig.\n", ({ME}));
          break;
        case 26..45 :
          write("Dir ist heiss. Du fuehlst Dich schwach. Kopfweh hast Du "
                "auch.\n");
          say(ME->Name(WER)+" glueht direkt und scheint grosse "
              "Schwierigkeiten zu haben.\n", ({ME}));
          break;
        case 11..25 :
          write("Du fuehlst Dich beschissen. Alles tut weh, und Du siehst "
                "nur noch unscharf.\n");
          say(ME->Name(WER)+" taumelt und stoehnt und kann gerade "
              "noch vermeiden, hinzufallen.\n", ({ME}));
          break;
        case 0..10 :
          write(break_string("Du siehst fast nichts mehr und kannst Dich nur "
                             "noch unter groessten Schmerzen bewegen. Aber "
                             "bald tut nichts mehr weh...", 78));
          say(break_string(ME->Name(WER)+" glueht wie im Fieber, kann sich "
                           "kaum noch ruehren und hat ein schmerzverzerrtes "
                           "Gesicht.\n", 78), ({ME}));
          break;
      }
  }

  if (mappingp(defic=QueryProp(P_BLIND)) && defic[BLIND_TIME]!=-1)
    if (!SetProp(P_BLIND, defic[BLIND_TIME]-1))
      write(defic[BLIND_END_MSG] || "Du kannst wieder sehen!\n");

  if (mappingp(defic=QueryProp(P_DEAF)) && defic[DEAF_TIME]!=-1)
    if (!SetProp(P_DEAF, defic[DEAF_TIME]-1))
      write(defic[DEAF_END_MSG] || "Du kannst wieder hoeren!\n");

  if (mappingp(defic=QueryProp(P_PARALYZED)) && defic[PARALYZE_TIME]!=-1)
    SetProp(P_PARALYZED, defic[PARALYZE_TIME]-1);

  if (htemp)
  {
    if (delay_temp==TEMP_DELAY)
    {
      if (!query_once_interactive(ME) && (lasthtemp != htemp)) {
        log_file("npc/NPC_TEMPERATURE",
            sprintf("%s %s in %O (Abweichung: %d)\n",
              ctime()[4..15], explode(file_name(ME),"#")[0],
              environment(), htemp));
        lasthtemp = htemp;
      }

      lhp = htemp<0 ? (-htemp+1)/4 : (htemp-1)/4;
      lhp = QueryProp(P_HP) - lhp;
      if (lhp<0) lhp=-1;
      SetProp(P_HP, lhp);
      if (lhp < 0)
      {
        tell_object(this_object(), "Oh weh - die "+
          (htemp<0 ? "Kaelte" : "Hitze")+
          " war zuviel fuer Dich!\nDu stirbst.\n");
        if (query_once_interactive(this_object()) && !IS_LEARNING(this_object()))
        {
          create_kill_log_entry("Temperatur");
          log_file("interactive/DIE", sprintf("[%s] %11s -TEMP-\n",
                ctime()[4..], capitalize(getuid(ME))));
        }
        else
          log_file("npc/NPC_TEMPERATURE",
              sprintf("%s %s TOT (Abweichung: %d)\n",
                ctime()[4..15], file_name(ME), htemp));
        this_object()->die(htemp<0 ? 2 : 3);
        return;
      }
      if (random(60) < (htemp<0 ? -htemp : htemp))
      {
        if (htemp>19) {
          if (random(2)) {
            write("Die sengende Hitze macht Dir schwer zu schaffen.\n");
            say(ME->Name(WER)+
                " leidet arg unter der sengenden Hitze.\n",({ME}));
          } else {
            write("Was fuer eine Affenhitze! Dir rinnen schon "
                "Schweissperlen die Stirn herab...\n");
            say(ME->Name(WER)+
                " schwitzt und aechzt unter der Hitze.\n",({ME}));
          }
        }
        else if (htemp<-19)
        {
          if (random(2)) {
            write("Die klirrende Kaelte macht Dir schwer zu schaffen.\n");
            say(ME->Name(WER)+
                " leidet arg unter der klirrenden Kaelte.\n",({ME}));
          } else {
            write("Du bibberst am ganzen Leib, so kalt ist es.\n");
            say(ME->Name(WER)+
                " bibbert und friert am ganzen Leib.\n",({ME}));
          }
        }
        else
        switch (htemp)
        {
          case -19..-10:
            switch(random(3))
            {
              case 0:
                write("Du frierst am ganzen Leib ob der Kaelte.\n");
                say(ME->Name(WER)+
                    " friert und zittert am ganzen Leib.\n", ({ME}));
                break;
              case 1:
                write("Du klapperst vor Kaelte mit den Zaehnen.\n");
                say(ME->Name(WER)+
                    " klappert vor Kaelte mit den Zaehnen.\n",({ME}));
                break;
              default:
                write("Du schlotterst vor lauter Kaelte... brrrr!\n");
                say(ME->Name(WER)+
                    " schlottert ob der eisigen Kaelte... brrrr!\n",({ME}));
            }
            break;
          case -9..-5:
            if (random(2)) {
              write("Du frierst etwas.\n");
              say(ME->Name(WER)+" scheint etwas zu frieren.\n", ({ME}));
            } else {
              write("Du spuerst die Kaelte ziemlich deutlich.\n");
            }
            break;
          case -4..-1:
            if (random(2)) {
              write("Dich froestelt leicht.\n");
              say(ME->Name(WEN)+" scheint leicht zu froesteln.\n", ({ME}));
            } else {
              write("Dir ist ein wenig kalt... "
                  "Du spuerst eine leichte Gaensehaut aufkommen.\n");
            }
            break;
          case 1..4:
            if (random(2)) {
              write("Dir ist ein wenig heiss, ufffz... "
                  "nicht sonderlich angenehm.\n");
            } else {
              write("Du schwitzt leicht... etwas warm hier!\n");
              say(ME->Name(WEM)+" scheint etwas heiss zu sein.\n", ({ME}));
            }
            break;
          case 5..9:
            if (random(2)) {
              write("Du wischt Dir den Schweiss von der Stirn. "
                  "Ganz schoen warm hier!\n");
              say(ME->Name(WER)+
                  " wischt sich den Schweiss von der Stirn.\n", ({ME}));
            } else {
              write("Du bekommst die Hitze schon relativ "
                  "deutlich zu spueren...\n");
            }
            break;
          case 10..19:
            switch (random(3))
            {
              case 0:
                write("Du schwitzt ziemlich stark.\n");
                say(ME->Name(WER)+" schwitzt ziemlich stark.\n", ({ME}));
                break;
              case 1:
                write("Du stoehnst unter der Hitze.\n");
                say(ME->Name(WER)+" stoehnt unter der Hitze.\n", ({ME}));
                break;
              default:
                write("Die Hitze setzt Dir ziemlich zu... Du aechzt.\n");
                say(ME->Name(WER)+
                    " aechzt von den hohen Temperaturen geplagt.\n", ({ME}));
            }
        }

      }
    }
  }
}

string get_age()
{
  int i,j;
  string s;
  s="";
  i = QueryProp(P_AGE);
  if ((j=i/43200)) {
    s += j + " Tag"+(j==1?", ":"e, ");
    i %= 43200;
  }
  if ((j=i/1800)) {
    s += j + " Stunde"+(j==1?", ":"n, ");
    i %= 1800;
  }
  if ((j=i/30)) {
    s += j + " Minute"+(j==1?" und ":"n und ");
    i %= 30;
  }
  s += i*2 + " Sekunden.";
  return s;
}

void show_age()
{
  int i,j;

  write("Alter:\t");
  write(get_age()+"\n");
}

int AddExp(int e)
{
  int experience;
  
  experience = QueryProp(P_XP);
  if(QueryProp(P_KILLS)>1 && e>0) return experience;
  if((experience+=e) < 0) experience = 0;
  return SetProp(P_XP, experience);
}

public void UpdateTotalTempProt()
{
  int i;
  object *armours;
  mapping sum,val;

  sum = ([ T_COLD_PROT:0, T_HEAT_PROT:0 ]);
  armours = QueryProp(P_ARMOURS);
  if ( member(armours,0)>=0 )
  {
    armours -= ({ 0 });
    Set(P_ARMOURS, armours, F_VALUE);
  }

  for ( i = sizeof(armours); i-->0; )
    if (mappingp(val = armours[i]->QueryProp(P_TEMPERATURE_PROTECTION)))
    {
      sum[T_COLD_PROT] += val[T_COLD_PROT];
      sum[T_HEAT_PROT] += val[T_HEAT_PROT];
    }

  SetProp(P_TOTAL_TEMPERATURE_PROTECTION, sum);
}

static int _set_align(int a) {
  if (a<-1000) a = -1000;
  if (a>1000) a = 1000;
  return Set(P_ALIGN, a);
}

static int _query_align() {
  int ret;
  if (!intp(ret=Query(P_ALIGN)))
    return Set(P_ALIGN,0);
  else
    return ret;
}

static int _set_hp(int hp) {
  if(QueryProp(P_GHOST)) return QueryProp(P_HP);
  if(hp < 0) return Set(P_HP, 0);
  if(hp > QueryProp(P_MAX_HP)) return Set(P_HP, QueryProp(P_MAX_HP));
  return Set(P_HP, hp);
}

static int _set_sp(int sp) {
  if(QueryProp(P_GHOST)) return QueryProp(P_SP);
  if(sp < 0) return Set(P_SP, 0);
  if(sp > QueryProp(P_MAX_SP)) return Set(P_SP, QueryProp(P_MAX_SP));
  return Set(P_SP, sp);
}

static int _set_mv(int mv) {
  if(QueryProp(P_GHOST)) return QueryProp(P_MV);
  if(mv < 0) return Set(P_MV, 0);
  if(mv > QueryProp(P_MAX_MV)) return Set(P_MV, QueryProp(P_MAX_MV));
  return Set(P_MV, mv);
}

static int _set_alcohol(int n) {
  return Set(P_ALCOHOL, (n < 0 ? 0 : n));
}

static int _set_drink(int n) {
  return Set(P_DRINK, (n < 0 ? 0 : n));
}

static int _set_food(int n) {
  return Set(P_FOOD, (n < 0 ? 0 : n));
}

static int _set_poison(int n)
{
  n = (n<0 ? 0 : (n>MAX_POISON ? MAX_POISON : n));

  if (Query(P_POISON) == 0 && n==0)
    return 0;

  log_file("interactive/POISON", sprintf("%s %s: %d von %O (%s)\n",
           ctime()[4..15],
           (query_once_interactive(this_object()) ?
             capitalize(geteuid(this_object())) : 
             capitalize(ME->name(WER))),
           n,
           (previous_object(2) && (previous_object(2) != this_object()) ?
            previous_object(2) : previous_object(1)),
           (this_player() ? capitalize(geteuid(this_player())) : "???")));

  switch(n) {
  case 1:
    drop_poison = 40+random(16);
    break;
  case 2:
    drop_poison = 25+random(8);
    break;
  case 3:
    drop_poison = 18+random(4);
    break;
  }
  return Set(P_POISON, n);
}

static int _query_age() { return Set(P_AGE, age); }

static int _set_xp(int xp) { return Set(P_XP, xp < 0 ? 0 : xp); }

mixed _set_die_hook(mixed hook){
  if(hook && query_once_interactive(this_object()))
    log_file("interactive/DIE_HOOK",
       sprintf("%s: DIE_HOOK gesetzt von %O in %O (%s)\n",
               ctime()[4..15],
               (previous_object(2) ? previous_object(2) : previous_object(1)),
               ME,getuid(ME)));
  return Set(P_TMP_DIE_HOOK,hook);
}

mapping _query_enemy_damage() {
  return copy_mapping(enemy_damage);
}

static mapping _query_temperature_range()
{
  return copy_mapping(Query(P_TEMPERATURE_RANGE));
}

static int _set_blind(mixed bl)
{
  int ret;
  mixed standard;

  if (!mappingp(standard=QueryProp(P_BLIND)))
    standard=([ BLIND_TIME:3600, BLIND_MSG:"Du bist blind!\n" ]);
  if (mappingp(bl))
    Set(P_BLIND, bl);
  else if (stringp(bl))
    Set(P_BLIND, standard + ([ BLIND_MSG: bl ]) );
  else if (intp(bl) && bl)
    Set(P_BLIND, standard + ([ BLIND_TIME: bl ]) );
  if (!bl || !(ret=Query(P_BLIND)[BLIND_TIME]))
    Set(P_BLIND, ret=0);
  return ret;
}

static int _set_deaf(mixed taub)
{
  int ret;
  mixed standard;

  if (!mappingp(standard=QueryProp(P_DEAF)))
    standard=([ DEAF_TIME:3600, DEAF_MSG:"%s ist momentan leider taub.\n" ]);
  if (mappingp(taub))
    Set(P_DEAF, taub);
  else if (stringp(taub))
    Set(P_DEAF, standard + ([ DEAF_MSG: taub ]) );
  else if (intp(taub) && taub)
    Set(P_DEAF, standard + ([ DEAF_TIME: taub ]) );
  if (!taub || !ret=Query(P_DEAF)[DEAF_TIME])
    Set(P_DEAF, ret=0);
  return ret;
}

static int _set_paralyzed(mixed para)
{
  int ret;
  string msg, end;
  mapping standard, old_para;

  if(IS_LEARNING(this_object())) return Set(P_PARALYZED, 0);
  standard= ([
    PARALYZE_TIME:1,
    PARALYZE_MSG:"Du bist paralysiert und kannst Dich nicht bewegen.\n",
    PARALYZE_MSG_OTHER:"%s versucht, sich zu bewegen, ist aber paralysiert.\n",
    PARALYZE_END:"Du kannst Dich wieder bewegen!\n",
    PARALYZE_END_OTHER:"%s kann sich wieder bewegen.\n"]);
  if (mappingp(para))
    Set(P_PARALYZED, standard+para);
  else
  {
    if (mappingp(old_para=Query(P_PARALYZED)))
      standard=old_para;
    if (intp(para))
      Set(P_PARALYZED, standard + ([ PARALYZE_TIME: para ]) );
    else if (stringp(para))
      Set(P_PARALYZED, standard + ([ PARALYZE_MSG: para ]) );
  }
  if (!ret=Query(P_PARALYZED)[PARALYZE_TIME])
  {
  SetProp(P_DISABLE_ATTACK, ret);
  SetProp(P_DISABLE_SPELLS, ret);
  if (ret>=10 && previous_object(1) && previous_object()!=this_player() )
    log_file("interactive/PARALYZE",sprintf("%s %d %O %O\n",ctime()[4..15],
                                ret,previous_object(1),this_object()));
  return ret;
}

