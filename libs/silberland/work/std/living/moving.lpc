#include <class.h>
 
#pragma strong_types

void AddPursuer(object ob)
{
  mixed *pur;

  if (!objectp(ob))
    return;
  
  if (!pointerp(pur=Query(P_PURSUERS)))
    pur=({0,({})});
  else
    if (member(pur[1],ob)!=-1)
      return;
  SetProp(P_PURSUERS,({pur[0],pur[1]+({ob})}));
  ob->_SetPursued(ME);
}

void RemovePursuer(object ob)
{
  mixed *pur;
  
  if (pointerp(pur=Query(P_PURSUERS)) && member(pur[1],ob)!=-1)
  {
    pur[1]-=({ob});
    ob->_RemovePursued(ME);
    if (!pur[0]&&!sizeof(pur[1]))
      pur=0;
    SetProp(P_PURSUERS,pur);
  }
}

object *QueryPursuers()
{
  mixed *pur;
  if (pointerp(pur=Query(P_PURSUERS)))
    return pur[1]-({0});
  else
    return ({});
}

void _SetPursued(object ob)
{
  mixed *pur;

  if (!pointerp(pur=Query(P_PURSUERS)))
    pur=({0,({})});
  else
    if (objectp(pur[0]))
      pur[0]->RemovePursuer(ME);
  pur[0]=ob;
  Set(P_PURSUERS,pur);
}

void _RemovePursued(object ob)
{
  mixed *pur;

  if (!pointerp(pur=Query(P_PURSUERS)) || pur[0]!=ob)
    return;
  pur[0]=0;
  if (!sizeof(pur[1]))
    pur=0;
  Set(P_PURSUERS,pur);
}

int CheckEnemy(object ob)
{
  return (living(ob) && funcall(#'IsEnemy,ob)); //'));
  // return (living(ob) && (funcall(#'IsEnemy,ob)
  //                        || ob->IsEnemy(this_object())));
//')));
}

int QueryNeededMv()
{
  int i,w;

  // Magier erschoepfen niemals.
  if (IS_LEARNING(this_object()) || !environment())
    return 0;

  // Schweben erschoepft nicht. ;-)
  if (QueryProp(P_GHOST))
    return 0;

  // w = wieviel Prozent dessen, was man tragen kann, traegt man?
  w = 100 * (QueryProp(P_TOTAL_WEIGHT) - QueryProp(P_WEIGHT)) /
      (QueryProp(P_MAX_WEIGHT) || 1);

  switch (w)
  {
    case  0..50: w=100; break;
    case 51..60: w=110; break;
    case 61..70: w=120; break;
    case 71..80: w=130; break;
    case 81..90: w=150; break;
    case 91..95: w=200; break;
    case 96..99: w=250; break;
    default:     w=300; break;
  }
  return  w * environment()->QueryExhaustion(ME) / 100;
}

int TryMove(mixed dest, int methods)
{
  if (!(methods & (M_GO | M_NOCHECK | M_TPORT)))
    return ME_PLAYER;
  if (methods & M_NOCHECK) {
    dest->PreventInsert(this_object());
    if (environment()) environment()->PreventLeave(this_object(), dest);
    return 1;
  }
  if ((methods & M_GO) && QueryProp(P_RESTING))
    return ME_RESTING;
  if (query_once_interactive(this_object()) &&
      (methods & M_GO) && QueryNeededMv() > QueryProp(P_MV))
    return ME_TOO_EXHAUSTED;
  if ((methods & (M_GO | M_TPORT)) && QueryProp(P_NOMOVE))
    return ME_CANT_MOVE;
  if (methods & M_TPORT)
    if (environment() &&
	(environment()->QueryProp(P_NO_TPORT) & (NO_TPORT_OUT|NO_TPORT)))
      return ME_CANT_TPORT_OUT;
    else
      if (dest->QueryProp(P_NO_TPORT) & (NO_TPORT_IN|NO_TPORT))
        return ME_CANT_TPORT_IN;
  if (dest->PreventInsert(this_object()))
    return ME_CANT_BE_INSERTED;
  if (environment() && environment()->PreventLeave(this_object(),dest))
    return ME_CANT_LEAVE_ENV;
  return 1;
}

varargs int move(mixed dest, int methods, string direction, string textout,
                 string textin)
{
  int ret, i,nightvis,quiet;
  object enem, *enemies, *cl_nv, mark;
  mixed res;
  int licht, licht2;
  object old_env;
 
  cl_nv=({});
  if ((ret=TryMove(dest, methods))<0)
    return ret;

  if (res=QueryProp(P_TMP_MOVE_HOOK))
  {
    if (pointerp(res) && sizeof(res)>=3
        && intp(res[0]) && time()<res[0]
        && objectp(res[1]) && stringp(res[2]))
    {
      if ((res=call_other(res[1],res[2],dest,methods,direction,textout,textin)))
      {
        if (pointerp(res) && sizeof(res) >= 5)
        {
          dest=res[0];
          methods=res[1];
          direction=res[2];
          textout=res[3];
          textin=res[4];
        }
        else if (stringp(res))
          return tell_object(this_object(), res), 1;
        else
          return 1;
      }
    }
    else
      SetProp(P_TMP_MOVE_HOOK,0);
  }

  if (QueryProp(P_INVIS)) methods|=M_SILENT;
  
  quiet=UseSkill(SK_QUIETWALK);
  if(quiet>0) methods|=M_SILENT;
  
  if(environment())
  {
    if (!(methods&M_SILENT))
    {
      string *mout;
      if (!textout)
      {
        if ((methods & M_TPORT))
          textout=(string)QueryProp(P_MMSGOUT)||(string)QueryProp(P_MSGOUT);
        else 
          textout=(string)(mout=explode(QueryProp(P_MSGOUT),"#"))[0]||
            (string)QueryProp(P_MMSGOUT);
      }
      if(direction=="") direction=0;
      say(Name(WER,2)+" "+textout+(direction?" "+
            direction:"")+ (sizeof(mout)>1?mout[1]:"")+".\n",
          (filter_objects(all_inventory(environment()), "CannotSee", 1)+
           ({this_object()})));
    }
    
    enem=first_inventory(environment());
    while (enem)
    {
      if (living(enem) && StopHuntFor(enem,1))
      {
	tell_object(this_object(),
		    enem->Name()+" ist jetzt hinter Dir her.\n");
	tell_object(enem,"Du verfolgst jetzt "+
		    this_object()->name(WEN)+".\n");
	enem->InsertEnemy(this_object());
      }
      enem=next_inventory(enem);
    }
    if (!(methods & M_NOCHECK))
      environment()->exit();
  }

  licht=set_light(0);
  old_env=environment();
  licht2=dest->_query_total_light();

  move_object(dest);
  
  if(!objectp(this_object())) return 0;
  
  if( objectp(old_env) )
  {
    if( licht<=0 && old_env->_query_total_light()>0 )
    {
      old_env->Message("Es wird heller!\n", MSGFLAG_VISUAL);
    }
    if( licht>0 && old_env->_query_total_light()<=0 )
      old_env->Message("Es wird dunkler!\n", MSGFLAG_VISUAL);
  }
  SetProp(P_PREPARED_SPELL,0); // Spruchvorbereitung abgebrochen
  SetProp(P_LAST_MOVE,time()); // Zeitpunkt der letzten Bewegung
  dest = environment();

  nightvis=UseSkill(SK_NIGHTVISION);
  if (objectp(dest) && !(methods & M_SILENT))  // dest muss es geben... 
  {
    if (!textin)
    {
      if (methods & M_TPORT)
        textin=QueryProp(P_MMSGIN);
      else
        textin=QueryProp(P_MSGIN);
    }
    say(capitalize(name(WER,0))+" "+textin+".\n", 
        filter_objects(all_inventory(dest), "CannotSee", 1)+ ({this_object()}) );
  }

  if( licht2<=0 && dest->_query_total_light()>0 )
     dest->Message("Es wird hell!\n", MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  if( licht2>0 && dest->_query_total_light()<=0 )
     dest->Message("Es wird dunkel!\n", MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  if (interactive(this_object()) && !(methods&M_NO_SHOW))
    if((nightvis>0 
        || set_light(0)>0 
        || this_object()->is_class_member(CL_NIGHTVISION)
       ) 
        && !QueryProp(P_BLIND))
      tell_object(this_object(),""+this_object()->env_descr(1));
    else
   {
     if (QueryProp(P_BLIND) && mappingp(QueryProp(P_BLIND)))
        tell_object(this_object(),(QueryProp(P_BLIND)[BLIND_MSG]||"Finsternis.")+"\n");
     else
        tell_object(this_object(),({"Finsternis.\n", 
                                    "Hier ist es voellig dunkel.\n",
                                    "Es ist voellig schwarz vor Deinen Augen.\n",
                                    "Kein Licht erhellt den Raum.\n",
                                    "Absolute Dunkelheit.\n"})[random(5)]);
   }                                                                                       
      /*
      if ((QueryProp(P_BRIEF) & BRIEF_VMASK)==2)
        tell_object(this_object(),"!!");  // d.h. Raum ist dunkel
      else
      */

  // Begruessungsschlag fuer die Gegner, dest muss es geben (Zordan)
  if (objectp(dest) && living(this_object()) && !(methods & M_NO_ATTACK) &&
      !( (mark=present("\ndeath_mark",this_object())) && 
         file_name(mark)[0..21]=="/room/death/death_mark") )
  {
    object *enem2;

    enemies = filter_objects( all_inventory(dest)-({ME}), "CheckEnemy", ME );
    enem2 = filter_array( all_inventory(dest)-({ME}), #'CheckEnemy); //');
    filter_objects( enemies, "Attack", this_object() );
    filter_array( enem2, #'Attack);//');
    filter_array( enemies, #'InsertEnemy);//');
  }
  if (pointerp(Query(P_PURSUERS)) && sizeof(Query(P_PURSUERS)[1]))
  {
    while (remove_call_out("TakeFollowers")>=0);
    call_out("TakeFollowers",0);
  }
  return 1;
}

void TakeFollowers()
{
  mixed *f,env;
  int meth,i,r;
  
  f=Query(P_PURSUERS);
  if (!pointerp(f)) return;
  if (member(f[1],0)!=-1) f[1]-=({0});  // bereinigt auch P_PURSUERS
  env=environment();
  if(file_name(env) == "/room/netztot") return;
  f=f[1];
  for (i=sizeof(f)-1;i>=0;i--)
    if (environment(f[i])!=env)
    {
      //meth=M_NOCHECK;
      meth=M_GO;
      if (f[i]->Query(P_FOLLOW_SILENT))
	meth|=M_SILENT|M_NO_SHOW;
      if (catch(r=f[i]->PreventFollow(env)))
        return;
      if (!r)
	f[i]->move(env,meth);
      else if (r==2)
        RemovePursuer(f[i]);
    }
}

int PreventFollow(object dest) { return 0; }

varargs int remove()
{
  destruct(this_object());
  return 1;
}

varargs int deep_remove(int silent)
{
  object *obs;
  obs = all_inventory(this_object());
  map_objects(obs, "remove", silent);
  obs -= ({ 0 });
  remove(silent);
  return (sizeof(obs) || this_object()) ? 0 : 1;
}
