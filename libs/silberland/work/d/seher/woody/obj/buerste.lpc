/*
** Eine Buerste
** (w) 2002-10-09, Woody@SL
*/

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>

#include <defines.h>
#include <moredef.h>


#define STIFTE 35
#define ZUWENIG_STIFTE 10

int stifte;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId("haarbuerste");
  AddId("buerste");

  SetProp(P_SHORT, "Eine Haarbuerste");
  SetProp(P_LONG,
      "Die Haarbuerste hat einen Griff aus unbehandeltem Buchenholz. "
      "Der Buerstenkopf ist etwas breiter und mit einigen Dutzend "
      "kleiner, an den Spitzen abgerundeter Stifte aus Eiche besetzt. "
      "Alles in allem ein grundsolides Produkt aus den silberlaendischen "
      "Handwerksbetrieben.");
  AddDetail( ({ "griff" }),
      "Der Griff ist aus unbehandeltem, aber geglaettetem Buchenholz." );
  AddDetail( ({ "buche","buchenholz" }),
      "Fein gemasertes Buchenholz, wie es auch gerne zur Herstellung "
      "von Tabakpfeifen verwendet wird. Die Hobbits wissen bestimmt "
      "mehr darueber!" );
  AddDetail( ({ "kopf","buerstenkopf" }),
      "Er ist etwa 7-8 Zentimeter breit, auf ihm wurden einige Dutzend "
      "kleiner Stifte aus Eichenholz eingearbeitet." );
  AddDetail( ({ "stifte","stift" }),
      "Die kleinen Stifte wurden sorgfaeltig ins Eichenholz eingearbeitet. "
      "Du staunst, wie widerstandsfaehig sie wohl sein muessen. Wenn Dir "
      "langweilig ist, koenntest Du sie ja zaehlen." );
  AddDetail( ({ "spitze","spitzen","stiftspitzen","stiftspitze" }),
      "Die Spitzen der Stifte wurden sorgfaeltig abgerundet, damit "
      "man sich beim Buersten nicht verletzt. Schliesslich ist aus "
      "dem Kopf austretendes Blut nicht so sexy..." );
  AddDetail( ({ "eiche","eichenholz" }),
      "Aeusserst hartes, festes Eichenholz wurde fuer die Stifte "
      "verwendet. Dies ist auch notwendig, da weiches Holz viel zu "
      "schnell abbrechen wuerde." );
  AddDetail( ({ "holz" }),
      "Welches Holz genau meinst Du?" );
  AddDetail( ({ "produkt" }),
      "Die Haarbuerste wurde sorgfaeltig hergestellt." );
  /* AddDetail( ({  }),
      "" ); */

  SetProp(P_NAME, "Haarbuerste");
  SetProp(P_GENDER, FEMALE);

  // SetProp(P_VALUE, 233);     // siehe _query_value()
  SetProp(P_WEIGHT, 200);
  SetProp(P_WEAPON_TYPE, WT_MISC);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_WC, 30);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([ MAT_BEECH:75, MAT_OAK:25 ]) );

  stifte = STIFTE;
  AddCmd( ({"zaehl","zaehle"}), "cmd_zaehle" );
  AddCmd( ({"buerst","buerste"}), "cmd_buerste" );
}


int _query_value()
{
  return 233 - 6 * (STIFTE - stifte);
}


int cmd_zaehle(string str)
{
  if (str!="stifte")
    return notify_fail("Was willst Du zaehlen?\n"), 0;

  write("Du zaehlst die Stifte der Buerste. Ganze " + stifte + " Stueck!\n");
  environment(TP)->Message(
      TP->Name() + " zaehlt die Stifte auf " +
      TP->QueryPossPronoun(FEMALE,WEM) + " Buerste. Warum auch immer...\n",
      MSGFLAG_VISUAL | MSGFLAG_NO_TP );
  return 1;
}


int cmd_buerste(string str)
{
  object wen;
  string was,was2,haircol;

  if (!str)
    return notify_fail("Was willst Du buersten?\n"), 0;

  switch (str)
  {
    case "mich":
    case "haare":
    case "mir haare":
    case "meine haare":
    case "eigene haare":
      wen = TP;
      break;

    default:
      if (str[<10..] == " die haare")
        str = str[0..<11];
      else if (str[<6..] == " haare")
        str = str[0..<7];
      else if (str[0..9] == "haare von ")
        str = str[10..];
      else if (str[<7..] == "' haare")
        str = str[0..<8];
      else if (str[<7..] == "s haare")
        str = str[0..<8];
      wen = present(str,environment(TP));
  }

  if (!wen || (!IS_LEARNER(TP) && wen->QueryProp(P_INVIS)))
  {
    notify_fail("So jemand ist hier nicht.\n");
    return 0;
  }

  if (!QueryProp(P_WIELDED)) {
    notify_fail("Du solltest die Buerste erstmal zuecken!\n");
    return 0;
  }

  if (!living(wen))
  {
    write("Aber " + wen->name(WER,1) + " lebt doch nicht!\n");
    return 1;
  }

  if (wen->QueryProp(P_FROG)) {
    write("Was willst Du denn bitte bei einem Frosch buersten?!?\n");
    return 1;
  }

  if (stifte <= ZUWENIG_STIFTE) {
    write("Bei Deiner Buerste sind leider schon zuviele Stifte abgebrochen,\n"
        "die taugt wohl nur noch als Altholz!\n");
    return 1;
  }

  was = "die Haare";
  was2 = "die %sen Haare";
  if (wen->QueryProp(P_RACE))
    switch (lower_case(wen->QueryProp(P_RACE)))
    {
      case "fisch"         :
      case "echse"         :
      case "drache"        : was = "die Schuppen";
                             was2 = "die %sen Schuppen";
                             break;
      case "erzgreif"      : 
      case "greif"         : 
      case "vogel"         : was = "die Federn";
                             was2 = "die %sen Federn";
                             break;
      case "pferd"         : 
      case "loewe"         : was = "die Maehne";
                             was2 = "die %se Maehne";
                             break;
      case "hobbit"        :
      case "tier"          : was = "das Fell";
                             was2 = "das %se Fell";
                             break;
    }

  if ( wen->id("SCHUPPEN_WUSCHEL")) {
    was = "die Schuppen";
    was2 = "die %sen Schuppen";
  }
  if ( wen->id("FEDERN_WUSCHEL")) {
    was = "die Federn";
    was2 = "die %sen Federn";
  }
  if ( wen->id("FELL_WUSCHEL")) {
    was = "das Fell";
    was2 = "das %se Fell";
  }
  if ( wen->id("MAEHNE_WUSCHEL")) {
    was = "die Maehne";
    was2 = "die %se Maehne";
  }
  if ( wen->id("HAARE_WUSCHEL")) {
    was = "die Haare";
    was2 = "die %sen Haare";
  }

  if (haircol = wen->QueryProp(P_HAIR_COLOR))
    was = sprintf(was2,haircol);

  if (wen == TP)
  {
    write("Du buerstest Dir " + was + " wieder ordentlich.\n");
    tell_room(
        environment(TP),
        TP->Name() + " buerstet sich " + was +
        " wieder ordentlich.\n", ({ TP,wen }) );
  }
  else
  {
    write("Du buerstest " + wen->name(WEM,1) + " " + was +
        " wieder ordentlich.\n");
    wen->Message( TP->Name() + " buerstet Dir " + was +
        " wieder ordentlich.\n", MSGFLAG_SAY );
    tell_room(
        environment(TP),
        TP->Name() + " buerstet " + wen->name(WEM) + " " + was +
        " wieder ordentlich.\n", ({ TP,wen }) );
  }

  if (random(47) == 11)
  {
    stifte--;
    write("Verdammt, jetzt ist glatt einer der Stifte abgebrochen!\n");
    if (TP != wen)
      wen->Message("Ohje, einer der Stifte scheint abgebrochen zu sein!\n");
  }

  return 1;
}

