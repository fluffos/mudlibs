inherit "std/thing";

#include <properties.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>


create()
{
  if (!is_clone(ME)) return;
  ::create();
  AddId (({"handlupe","lupe"}));
  SetProp (P_SHORT, "Ein kleine Handlupe");
  SetProp (P_LONG, "Wenn Du durch diese Handlupe blickst, kannst Du "+
    "ein wenig mehr erkennen als sonst...");
  SetProp (P_NAME, "Handlupe");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_VALUE, 200);
  SetProp (P_WEIGHT, 100);
  SetProp (P_MATERIAL, ([ MAT_GLASS:65, MAT_COPPER:35 ]) );
  AddCmd ( ({"blick", "blicke"}), "blicke");
}


varargs string func(int i, int faktor)
{
  if (IS_LEARNING(TP))
    return to_string(i);

  if (faktor)
    i = faktor * i;

  switch(i)
  {
    case -99..0: return "gar keine";
    case 1..2:   return "nur spaerliche";
    case 3..5:   return "extrem wenige";
    case 6..10:  return "sehr wenige";
    case 11..15: return "wenige";
    case 16..20: return "einige";
    case 21..25: return "unterdurchschnittlich viele";
    case 26..30: return "durchschnittlich viele";
    case 31..35: return "ueberdurchschnittlich viele";
    case 36..40: return "genug";
    case 41..50: return "mehr als genug";
    case 51..60: return "viele";
    case 61..80: return "sehr viele";
    case 81..100: return "extrem viele";
    case 101..150: return "gigantisch viele";
    default: return "schier unendlich viele";
  }
  return "";
}

int blicke(string str)
{
  string s1, s2, erz, ret;
  object ob;

  notify_fail ("Wo willst Du durchblicken?\n");
  if (!str) return 0;
  if (sscanf(str, "durch %s", s1) != 1) return 0;
  if (!id(s1)) return 0;
  ret = "\nDu blickst durch Deine kleine Handlupe...\n\n";
  ob = environment(TP);
  if ((!(erz = (string) call_other(ob, "IsSeerHouse"))) ||
       (file_name(ob)[0..13] != "/d/seher/haus/"))
  {
    erz = getuid(ob);
    if (sscanf(erz, "d.%s.%s", s1, s2) == 2)
      erz = capitalize(s2) + " als Mitgestalter der Region " + capitalize(s1);
    else if (erz[0..1] == "d.")
      erz = "ein Mitarbeiter der Region " + capitalize(erz[2..]);
    else if (erz[0..5] == "GUILD.")
      erz = "ein Gildenmagier";
    else
      erz = capitalize(erz);
  }
  ret += sprintf("...und erkennst, dass der Erschaffer dieses Raums %s "
         "ist, und dass in diesem Raum %s Einzelheiten zu finden, "
         "%s Gerueche zu riechen und %s Geraeusche zu hoeren sind.\n\n",
         erz,
         func(sizeof(ob->QueryProp(P_DETAILS)) +
              sizeof(ob->QueryProp(P_SPECIAL_DETAILS)) +
              sizeof(ob->QueryProp(P_READ_DETAILS)) ),
         func(sizeof(ob->QueryProp(P_SMELLS)), 4),
         func(sizeof(ob->QueryProp(P_SOUNDS)), 4) );
  write(break_string(ret, 78, 0, 1));
  say(TP->Name() + " blickt durch eine kleine Handlupe.\n");
  return 1;
}
