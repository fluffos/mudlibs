/*
** Eine Monokel
** ---
** 1997-01-17  Woody@SL  Release
*/

inherit "std/thing";

#include <properties.h>
#include "/players/woody/files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  AddId ("monokel");
  SetProp (P_SHORT, "Ein Monokel");
  SetProp (P_LONG, "Durch das Monokel kannst Du Teile Deiner naeheren "
    "Umgebung besonders gut erkennen. Es ist klein, in einen schwarzen "
    "Rahmen eingelassen und hat einen edel aussehenden Goldrand.");
  SetProp (P_NAME, "Monokel");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 3000);
  SetProp (P_WEIGHT, 150);
  SetProp (P_MATERIAL, ({ MAT_GLASS, MAT_METAL }) );
  SetProp (P_INFO, bs("Wenn Du die Augen zusammenkneifst, kannst Du den "
    "Zustand aller anwesenden Lebewesen genau erkennen."));
  AddCmd ( ({"kneif","kneife"}), "kneife");
}

string Zustand (object wer)
{
  string nm;
  int hpnt, max_hpnt;
  nm = capitalize(wer->name(WER,1));
  hpnt = wer->QueryProp(P_HP);
  max_hpnt = wer->QueryProp(P_MAX_HP);
  if (hpnt < max_hpnt/20) 
    return nm+" steht schon mit einem Fuss im Grab.\n";
  else if (hpnt < max_hpnt/10) 
    return nm+" steht auf der Schwelle des Todes.\n";
  else if (hpnt < max_hpnt/5) 
    return nm+" braucht dringend einen Arzt.\n";
  else if (hpnt < max_hpnt*3/10) 
    return nm+" ist in keiner guten Verfassung.\n";
  else if (hpnt < max_hpnt*4/10) 
    return nm+" wankt bereits bedenklich.\n";
  else if (hpnt < max_hpnt/2) 
    return nm+" macht einen mitgenommenen Eindruck.\n";
  else if (hpnt < max_hpnt*6/10) 
    return nm+" sieht nicht mehr taufrisch aus.\n";
  else if (hpnt < max_hpnt*7/10) 
    return nm+" ist leicht angeschlagen.\n";
  else if (hpnt < max_hpnt*8/10) 
    return nm+" fuehlte sich heute schon besser.\n";
  else if (hpnt < max_hpnt*9/10) 
    return nm+" ist schon etwas geschwaecht.\n";
  else
    return nm+" ist absolut fit.\n";
}

kneife(str)
{
  string s1;
  int i;
  object ob, lv;
  notify_fail ("Was willst Du zusammenkneifen?\n");
  if (!str) return 0;
  if (sscanf(str, "%s zusammen", s1)!=1) return 0;
  if (s1!="auge" && s1!="augen") return 0;
  say (CAP_TPN+" kneift die Augen etwas zusammen.\n");
  write ("Du kneifst die Augen zusammen...");
  lv=filter_array(all_inventory(ENV(TP)), #'living)-({TP});
  if (!sizeof(lv))
    write ("\n...erkennst jedoch ausser Dir hier nirgendwo Lebewesen.\n");
  else
  {
    write(" und erkennst:\n"+implode(map_array(lv, #'Zustand), ""));
  }
  return 1;
}
