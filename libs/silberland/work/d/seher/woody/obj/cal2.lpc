inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <ansi.h>
#include <moredef.h>
#include <wizlevels.h>

#define MAX_ENTRIES 200
#define P_WOODY_CAL_SAVE "woody_cal_save"

object owner;
mapping entries = ([ ]);


void create()
{
  string str;

  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();

  AddId ( ({"cal","kalender"}) );
  SetProp (P_SHORT, "Ein Kalender");
  SetProp (P_LONG,
      "Ein kleiner, handlicher Taschenkalender.\n"
      "Du kannst mit \"cal [monat [jahr]]\" ein bestimmtes Kalenderblatt "
      "ansehen. Willst Du den Rahmen drumherum nicht, dann gib "
      "\"cal -n [monat [jahr]]\" ein.\n"
      "Mit \"calday <tt.mm.jjjj> <eintrag>\" kannst Du fuer einen "
      "Tag einen Eintrag vornehmen (ein bereits vorhandener wird dabei "
      "ueberschrieben), mit \"caldaydel <tt.mm.jjjj>\" loescht Du einen "
      "Eintrag fuer einen bestimmten Tag.\n"
      "\"caldays\" zeigt Dir alle Deine Eintraege an. Mehr als " +
      MAX_ENTRIES + " Eintraege kann sich Dein Kalender nicht merken. Mit "
      "\"caldaydel *\" loescht Du uebrigens alle vorhandenen Eintraege, "
      "mit \"caldaydel alte\" alle in der Vergangenheit liegenden.\n");
  SetProp (P_NAME, "Kalender");
  SetProp (P_ARTICLE, 1);
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 400);
  SetProp (P_VALUE, 900);
  SetProp (P_NOSELL, 1);
  SetProp (P_MATERIAL, MAT_PAPER);

  // here are our sweet commands
  AddCmd("cal", "cal");
  AddCmd("calday", "calday");
  AddCmd("caldays", "caldays");
  AddCmd("caldaydel", "caldaydel");
}


varargs int move(mixed dest, int method)
{
  int r;

  r = ::move(dest,method);      // first do the move - we wants it, precious!
  if (r != 1) return r;         // no success? bail out

  if (objectp(dest) && query_once_interactive(dest)) {  // moved into player?
    owner = dest;
    entries = owner->QueryProp(P_WOODY_CAL_SAVE);       // restore entries
    if (!mappingp(entries)) entries = ([ ]);
  }
  else {                                // have been moved into bag, room,...?
    owner = 0;
    entries = ([ ]);                    // will be restored anyways...
  }
  return 1;
}

void saveme()
{
  if (!owner) return;
  owner->SetProp(P_WOODY_CAL_SAVE, entries);
  owner->Set(P_WOODY_CAL_SAVE, SAVE, F_MODE_AS);
}


mapping mon2num = ([
    "Jan" :  1, "Feb" :  2, "Mar" :  3, "Apr" :  4,
    "May" :  5, "Jun" :  6, "Jul" :  7, "Aug" :  8,
    "Sep" :  9, "Oct" : 10, "Nov" : 11, "Dec" : 12 ]);

mapping wd2num = ([
    "Mon" :  1, "Tue" :  2, "Wed" :  3, "Thu" :  4,
    "Fri" :  5, "Sat" :  6, "Sun" :  7 ]);

mapping mon2str = ([
    1:"Januar", 2:"Februar", 3:"Maerz", 4:"April",
    5:"Mai", 6:"Juni", 7:"Juli", 8:"August",
    9:"September", 10:"Oktober", 11:"November", 12:"Dezember" ]);

mapping monofs = ([
    1:0, 2:31, 3:31+28, 4:31+28+31, 5:31+28+31+30,
    6:151, 7:151+30, 8:151+30+31, 9:151+30+31+31, 10:151+30+31+31+30, 
    11:304, 12:304+30 ]);


int query_1st(int jahr, int monat)
{
  int t;

  // Zeitpunkt t vom 1. Jaenner schaetzen
  t = (jahr - 1970) * (int)(365.25 * 86400);
  t -= t % 86400;
  // Monat dazuzaehlen
  t += monofs[monat] * 86400;

  // Etwaige Korrekturen vornehmen
  if (((int)(ctime(t)[<4..]) < jahr) || (mon2num[ctime(t)[4..6]] < monat))
    while ( ((int)(ctime(t)[<4..]) < jahr) ||
            ( ((int)(ctime(t)[<4..]) == jahr) &&
              (mon2num[ctime(t)[4..6]] < monat) ) )
      t += 86400;
  else if ( ((int)(ctime(t)[<4..]) > jahr) ||
            ( (mon2num[ctime(t)[4..6]] >= monat)&&
              ((int)(ctime(t)[<4..]) > jahr) ) )
  {
    while ( ((int)(ctime(t)[<4..]) > jahr) ||
            ( (mon2num[ctime(t)[4..6]] >= monat)&&
              ((int)(ctime(t)[<4..]) > jahr) ) )
      t -= 86400;
    t += 86400;         // Korrektur, da einmal zu oft abgezogen
  }
  return t;
}


int cal(string str)
{
  int jahr;
  int monat;
  int t,i,noframe;
  string ret,ct,today;
  string bold,color,hilite,invers,reset;
  string termine;

  // Farbvariablen belegen:
  switch (TP->QueryProp(P_TTY))
  {
    case "ansi":
      bold = ANSI_BOLD;
      color = ANSI_BOLD + ANSI_YELLOW;
      hilite = ANSI_BOLD + ANSI_RED;
      invers = ANSI_BOLD + ANSI_GREEN;
      reset = ANSI_NORMAL;
      break;
    case "vt100":
      bold = color = hilite = ANSI_BOLD;
      invers = ANSI_INVERS;
      reset = ANSI_NORMAL;
      break;
    default:
      bold = color = invers = reset = "";
  }

  // -n Switch auswerten:
  if (stringp(str))
    if (str[0..1] == "-n") {
      noframe = 1;
      str = str[3..];
    }

  // Monat/Jahr Parameter auswerten:
  if (!stringp(str) || !strlen(str)) {
    jahr = to_int(ctime()[<4..]);
    monat = to_int(mon2num[ctime()[4..6]]);
  }
  else if (sscanf(str, "%d %d", monat, jahr) < 2) {
    jahr = to_int(ctime()[<4..]);
    if (sscanf(str, "%d", monat) < 1)
      monat = to_int(mon2num[ctime()[4..6]]);
  }

  // Validity check:
  if ((jahr < 1970) || (jahr > 2032)) {
    write("Ungueltiges Jahr angegeben! (erlaubt: 1970 - 2032)\n");
    return 1;
  }
  if ((monat < 1) || (monat > 12)) {
    write("Ungueltiges Monat angegeben! (erlaubt: 1 - 12)\n");
    return 1;
  }

  // Zeitpunkt t vom 1. Jaenner schaetzen
  t = query_1st(jahr, monat);

  // Header (Monat+Jahr, Mo-So Kopfzeile), Termine-String:
  ret = sprintf( "%s%|20s%s\n", bold, mon2str[monat]+" "+jahr, reset );
  ret += color + "Mo Di Mi Do Fr Sa So" + reset + "\n";
  termine = "";

  ct = ctime(t);
  if (wd2num[ct] != 1)  // padding required
    ret += sprintf("%*s", (wd2num[ct[0..2]] - 1) * 3, "");

  // Aktuelles Monat und Jahr?
  if ( (ctime()[-4..] == ct[-4..]) &&
       (ctime()[4..6] == ct[4..6]) )
    today = ctime()[8..10];
  else
    today = 0;

  while (mon2num[ct[4..6]] == monat)
  {
    if (today == ct[8..10]) {
      ret += invers + ct[8..9] + reset + " ";
      if (member(entries,t))
        termine += sprintf("%s%s:%s %s\n",
            invers, dtime(t)[5..16], reset, entries[t]);
    }
    else if (member(entries,t)) {
      ret += hilite + ct[8..9] + reset + " ";
      termine += sprintf("%s: %s\n", dtime(t)[5..16], entries[t]);
    }
    else
      ret += ct[8..10];
    if (wd2num[ct[0..2]] == 7)
      ret = ret[0..<2] + "\n";
    ct = ctime(t += 86400);
  }
  if (wd2num[ct[0..2]] != 1)
  {
    ret += sprintf("%*s", (8 - wd2num[ct[0..2]]) * 3, "");
    ret = ret[0..<2] + "\n";
  }

  if (!noframe)
    ret = ",----------------------.\n" +
          implode( map_array( explode( ret, "\n" ),
                              lambda(
                                ({ 'x }),
                                ({ #'sprintf, "| %-20s |", 'x }) )
                            ), "\n" ) +
          "\n`----------------------'\n";

  ret += termine;
  write(ret);
  return 1;
}

mixed _query_autoloadobj()
{
  object ob;

  ob = this_player();
  if (ob && query_once_interactive(ob) && IS_SEER(ob))
    return 1;
  return 0;
}

int calday(string str)
{
  int tt,t,m,j,e;

  if (!owner) {
    write("Dazu solltest Du den Kalender erst mal in die Hand nehmen.");
    return 1;
  }

  if (TP != owner)
    return write("He, das ist nicht Dein Kalender, lass das!\n"), -1;

  str = TP->_unparsed_args();
  notify_fail("Syntax: calday <tt.mm.jjjj> <eintrag>\n");
  if (!str) return 0;
  if (sscanf(str, "%d.%d.%d %s", t, m, j, e) != 4) return 0;

  if ((j < 1970) || (j > 2032)) {
    write("Ungueltiges Jahr angegeben! (erlaubt: 1970 - 2032)\n");
    return 1;
  }
  if ((m < 1) || (m > 12)) {
    write("Ungueltiges Monat angegeben! (erlaubt: 1 - 12)\n");
    return 1;
  }
  if (sizeof(entries) > MAX_ENTRIES) {
    write("Maximum an Eintraegen (" + MAX_ENTRIES + ") bereits erreicht!\n");
    return 1;
  }
  tt = query_1st(j,m) + 86400 * (t - 1);
  if (t != to_int(ctime(tt)[8..9])) {
    write("Ungueltiger Tag angegeben!\n");
    return 1;
  }
  write(break_string(sprintf("Eintrag fuer %d.%02d.%04d %s: %s", t, m, j,
        member(entries, tt) ? "ersetzt" : "vermerkt", e), 78));
  entries[tt] = e;
  saveme();
  return 1;
}


int caldays(string str)
{
  int i;
  int *t;
  string *ret;

  if (TP != owner)
    return write("He, das ist nicht Dein Kalender, lass das!\n"), -1;

  if (!sizeof(entries)) {
    write("Du hast noch gar keine Eintraege in Deinem Kalender!\n");
    return 1;
  }

  ret = ({ });
  t = sort_array(m_indices(entries), #'<);

  for (i=sizeof(t); i-->0; )
  {
    ret += ({ sprintf("%s: %s\n", dtime(t[i])[5..16], entries[t[i]]) });
  }

  if (str)
    ret = regexp( ret, str );

  if (!sizeof(ret)) {
    write("Keine Eintraege in Deinem Kalender passen auf Deine Suche!\n");
    return 1;
  }

  TP->More("\nEintraege in Deinem Kalender" +
      (str ? ", die Deiner Suche entsprechen" : "") + ":\n" +
      "------------------------------------------------------------------------------\n" +
      implode(ret, "") + "\n");
  return 1;
}


int caldaydel(string str)
{
  int tt,t,m,j;

  if (!owner) {
    write("Dazu solltest Du den Kalender erst mal in die Hand nehmen.");
    return 1;
  }

  if (TP != owner)
    return write("He, das ist nicht Dein Kalender, lass das!\n"), -1;

  str = TP->_unparsed_args();
  notify_fail("Syntax: caldaydel <tt.mm.jjjj>   oder\n"
              "        caldaydel *   (loescht ALLE Eintraege)\n");

  if (!str) return 0;

  if (str == "*" || str == "alte")
  {
    if (!sizeof(entries)) {
      write("Du hast doch noch gar keine Eintraege in Deinem Kalender!\n");
      return 1;
    }

    write("Willst Du wirklich alle" + (str == "alte" ? " alten" : "") +
          " Eintraege loeschen?\n");
    write("Loeschen (j/n) -> ");
    input_to("really_del_all",0,owner,(str=="alte"));   // erst rueckfragen...
    return 1;   // (damit ist _hier_ nix mehr zu tun)
  }

  if (sscanf(str, "%d.%d.%d", t, m, j) != 3) return 0;

  if ((j < 1970) || (j > 2032)) {
    write("Ungueltiges Jahr angegeben! (erlaubt: 1970 - 2032)\n");
    return 1;
  }
  if ((m < 1) || (m > 12)) {
    write("Ungueltiges Monat angegeben! (erlaubt: 1 - 12)\n");
    return 1;
  }
  tt = query_1st(j,m) + 86400 * (t - 1);
  if (t != to_int(ctime(tt)[8..9])) {
    write("Ungueltiger Tag angegeben!\n");
    return 1;
  }

  if (member(entries, tt))      // Gibt es ueberhaupt einen Eintrag an dem Tag?
  {
    efun::m_delete(entries, tt);
    saveme();
    write(sprintf("Eintrag vom %d.%02d.%4d geloescht!\n", t, m, j));
  }
  else
    write("Fuer diesen Tag gibt es keine Eintraege!\n");

  return 1;
}


int cl_valid(int el, int t)
{
  return el >= t;
}


int del_entries(int all)
{
  int n;

  n = sizeof(entries);
  if (all) {
    entries = ([ ]);
    saveme();
    return n;
  }
  entries = filter_mapping( entries, #'cl_valid, time() - 86399 );
  saveme();
  return n - sizeof(entries);
}


void really_del_all(string str, object ob, int nur_alte)
{
  int n;

  if (ob != owner) {
    write("Nach Weitergabe des Kalenders ist das nicht mehr moeglich!\n");
    return;
  }
  if (str == "j" || str == "ja")
  {
    n = del_entries(!nur_alte);
    if (!n)
      write("Keine " + (nur_alte ? "alten " : "") +
          "Eintraege zum Loeschen gefunden!\n");
    else
      write("Ok, alle " + (nur_alte ? "alten " : "") + "Eintraege (" +
          n + " insgesamt) aus Deinem Kalender entfernt.\n");
    return;
  }
  write("Du behaeltst alle Eintraege in Deinem Kalender bei.\n");
}
