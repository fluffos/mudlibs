/* 
 * Ein geraeumiger Kleiderschrank.
 * ---
 * (w) written by Woody
 * ---
 * 2002-01-15  Initial release (basierend auf Anatols Regal).
 * 2002-01-18  Kerben, leichter gemacht
 *
 * Haelt sich an die Begrenzungen der Seherhausmoebel (moebel.h)
 * Man kann es beschriften.
 *
 */


#pragma strict_types 

#include <properties.h>
#include <moving.h>
#include "/d/seher/sys/moebel.h"

inherit "/d/seher/anatol/std/container_closeable";


string beschriftung;
mapping nr = ([ 2:"zwei", 3:"drei", 4:"vier", 5:"fuenf", 6:"sechs" ]);


public void create()
{
  int n;

  ::create();
  if (!is_clone(this_object())) return;

  n = random(7);                        // 0..6
  beschriftung = 0;
  AddId( ({ "kleiderschrank","schrank",MOEBEL_ID }) );
  SetProp(P_SHORT, "Ein Kleiderschrank");
  SetProp(P_LONG, "Ein Kleiderschrank.\n");
  SetProp(P_NAME, "Kleiderschrank");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 22000 + 500 * n);
  SetProp(P_WEIGHT_PERCENT, 100);
  SetProp(P_TOTAL_OBJECTS, 30 + n);
  SetProp(P_MAX_WEIGHT, 200000);        // 200 kg reichen wohl.
  SetProp(P_SIZE, 220 + 2 * n);         // ca. 2.2m hoch.
  SetProp(P_VALUE, 6000);               // Tischlerei will bezahlt sein.
  SetProp(P_MATERIAL, ([ MAT_MISC_WOOD:90, MAT_STEEL:10 ]) );

  AddCmd( ({ "beschrift", "beschrifte" }), "cmdBeschrifte" );
  AddSpecialDetail( ({ "schild", "beschriftung"}), "detBeschriftung" );

  AddSpecialDetail( ({ "hoehe" }), "detHoehe" );
  AddDetail( ({ "hand" }),
      "Du betrachtest angestrengt Deine Hand. Nichts passiert.");
  AddDetail( ({ "oberkante" }),
      "Das ist da wo der Schrank Richtung Himmel gesehen aufhoert.");
  AddDetail( ({ "zwutschgerl" }),
      "Ist aber weiter kein Grund, traurig zu sein!");
  AddDetail( ({ "kleider" }),
      "Auch diese koennen potentiell im Kleiderschrank verwahrt werden.");
  AddDetail( ({ "kleiderberg","kleiderberge" }),
      "Zum Glueck kann man die hinter den Schranktueren verschwinden lassen.");
  AddDetail( ({ "schranktuer","schranktuere","schranktueren",
                "tuer","tuere","tueren" }),
      "Die Schranktueren sind zwar schlicht gehalten, aber scheinen sauber "
      "und solide verarbeitet zu sein. Sie schliessen perfekt und fugenfrei "
      "mit dem Korpus ab und werden von stahlbehauenen Scharnieren fest "
      "und wackelfrei gehalten. Sie ermoeglichen es Dir, den Schrank zu "
      "oeffnen und wieder zu schliessen. An der linken Schranktuer "
      "entdeckst Du ein kleines Schild" +
      (n ?
       ", waehrend an der rechten Schranktuer im linken unteren Eck " +
       (n == 1 ? "eine kleine Kerbe" : nr[n] + " kleine Kerben") +
       " zu finden sind" : "") + ".");

  if (n)
  {
    if (n == 1)
      AddDetail( ({ "kerbe" }),
          "Sie wurde offenbar sehr sorgfaeltig angebracht. "
          "Ob sie eine Bedeutung hat?");
    else
      AddDetail( ({ "kerbe", "kerben" }),
          "Die Kerben wurden offenbar sehr sorgfaeltig angebracht. "
          "Ob sie eine besondere Bedeutung haben?");
    AddDetail( ({ "bedeutung", "besondere bedeutung" }),
        "Du vermutest, dass es mit der Qualitaet zu tun haben koennte...?");
    AddDetail( ({ "qualitaet" }),
        "Den genauen Zusammenhang kannst Du Dir aber nicht erklaeren.");
  }

  AddDetail( ({ "korpus" }),
      "Der Korpus des Kleiderschranks ist - ebenso wie die Tueren - sehr "
      "schlicht und ohne Schnoerkel, aber grundsolide gearbeitet. Du "
      "bist froh, so ein Prachtexemplar erworben zu haben und kein "
      "wackliges Teil mit nordisch klingendem Vornamen zu besitzen.");
  AddDetail( ({ "prachtexemplar","teil" }),
      "Dein Kleiderschrank ist wirklich perfekt verarbeitet.");
  AddDetail( ({ "fugen" }),
      "Falls Du diese zwischen geschlossener Schranktuer und Korpus suchst, "
      "suchst Du wahrlich vergebens.");
  AddDetail( ({ "scharnier","scharniere" }),
      "Die staehlernen Scharniere sind wunderbar glatt und sauber "
      "geschmiedet. Du bist Dir sicher, dass nur ein sehr geschickter "
      "Zwerg so eine feine Kunst zu vollbringen vermag.");
  AddDetail( ({ "schnoerkel" }),
      "Keine am Kleiderschrank zu finden!");
  AddDetail( ({ "vorname","vornamen" }),
      "Ach was weiss denn ich, Bjoern, oder Knut, oder gar Stenskaer!");
  AddDetail( ({ "bjoern","knut","stenskaer" }),
      "Das waren natuerlich rein zufaellig gewaehlte Beispiele.");
  AddDetail( ({ "ikea" }),
      "Haeh?!");
  AddDetail( ({ "zwerg" }),
      "Man kann von Zwergen halten was man will, aber schmieden koennen sie.");
  AddDetail( ({ "kunst" }),
      "Naja, zumindest sind sie sehr sauber gearbeitet, kunstvolle Verzierungen "
      "hats dann doch nicht soviele. Wozu auch, sind ja nur Scharniere...");
  AddDetail( ({ "verzierung","verzierungen" }),
      "Also eigentlich gar keine, genauer betrachtet.");
  AddDetail( ({ "stahl" }),
      "Feinster Stahl, garantiert ohne Dornen.");
  AddDetail( ({ "dorn","dornen" }),
      "Wieso sollte ein Stahl auch Dornen haben?\n"
      "Du schuettelst verwundert den Kopf.");
  AddDetail( ({ "kopf" }),
      "Ein Schrank hat keinen Knopf. Nur Fuesse.");
  AddDetail( ({ "fuss","fuesse" }),
      "Vier schlichte aber staemmige Fuesse aus massivem Holz.");
  AddDetail( ({ "holz" }),
      "Das Holz wirkt relativ teuer, wurde vermutlich ordentlich nachbehandelt. "
      "Was es fuer eine Sorte ist, kannst Du aber beim besten Willen nicht "
      "feststellen.");
  AddDetail( ({ "geruch","gerueche" }),
      "Da der Schrank so gut verarbeitet ist und so dicht abschliesst, bist "
      "Du Dir sicher, dass er auch geruchfest ist. Oder Du hoffst es. ;-)");
  AddDetail( ({ "schranken" }),
      "Bezeichnend, nicht wahr?");
  AddDetail( ({ "ewigkeit" }),
      "Du glaubst es einfach, da Du keine Lust hast, solange zu warten.");
}


nosave string detBeschriftung()
{
  if (!beschriftung) return
    "Das Schild ist leer, der Schrank unbeschriftet. Das musst Du aendern!\n";
  else
    return break_string("Jemand hat mit krakeligen Buchstaben '"+
        beschriftung+"' auf das Schild am Kleiderschrank gemalt.", 78);
}


nosave string detHoehe()
{
  int rel;

  // rel: relative Groesse des Schrankes zum Spieler (in Prozent)
  rel = (int) QueryProp(P_SIZE) * 100 / (int) this_player()->QueryProp(P_SIZE);

  if (rel < 90)
    return "Also eigentlich bist Du ja doch deutlich groesser als der Schrank.\n";
  if (rel < 110)
    return "Die Hoehe des Schranks erreichst Du in etwa auch.\n";
  if (rel < 125)
    return "Der Schrank ist schon ziemlich hoch. Deine Hand erreicht grade mal so\ndie Oberkante.\n";
  if (rel < 200)
    return "Also gegen den Schrank bist Du ja ein richtiger Zwerg!\n";

  return "Als Du zum Schrank emporblickst, kommst Du Dir vor wie ein winziges\nZwutschgerl.\n";
}


nosave int cmdBeschrifte(string wiebitte)
{
  string schrift, schrank;

  notify_fail("Was willst Du beschriften?\n");
  if ( !wiebitte || !this_player() || !interactive(this_player()) )
    return 0;

  if (id(wiebitte)) {
    write("Beschrifte ... mit ...?\n");
    return 1;
  }
  if (!wiebitte = (string) this_player()->_unparsed_args())
    return 0;   // kann eigtl. nie passieren :)
  if (sscanf(wiebitte,"%s mit %s",schrank, schrift)!=2) {
    notify_fail("Beschrifte ... mit ...?\n");
    return 0;
  }
  if (!id(schrank)) {
    notify_fail("Das kannst Du wohl nicht beschriften.\n");
    return 0;
  }
  if (beschriftung) {
    write("Auf dem Schild des Schranks steht bereits klar und "
        "deutlich:\n'"+beschriftung+"'. Kriegst Du nicht wieder runter. :(\n");
    return 1;
  }
  if ((!schrift) || (schrift=="")) {
    write("Guter Ansatz, aber mit was moechtest Du den Schrank "
        "beschriften?\n");
    return 1;
  }
  if (strlen(schrift) > 25) {
    write("Mmmh, so viel passt da nicht drauf, fasse Dich ein wenig "
        "kuerzer.\n");
    return 1;
  }
  beschriftung = schrift;
  AddId(lowerstring(beschriftung)+" schrank");
  SetProp(P_INFO, "Dieser Schrank wurde von " +
      capitalize(getuid(this_player())) + " beschriftet.\n");

  write(break_string("Du schreibst in grossen lesbaren Buchstaben '"+
        beschriftung+"' auf das Schild am Schrank, trittst dann zurueck "
        "und bewunderst Dein Werk! Wow!",77));
  say(break_string(this_player()->Name(WER)+" schreibt langsam in grossen "
        "wackeligen Buchstaben etwas auf ein Schild an einem Schrank "
        "(Du siehst, wie "+
        this_player()->QueryPossPronoun(FEMALE,WER,SINGULAR)+" Zunge an "
        "den Lippen kreist, ist wohl gar nicht so einfach, so ganz ohne... "
        "huch, ohne Stift). Dann tritt "+this_player()->QueryPronoun(WER)+
        " zurueck und bewundert "+
        this_player()->QueryPossPronoun(NEUTER,WEN,SINGULAR)+
        " Werk.",77));
  return 1;
}


public string long()
{
  if (QueryProp(P_CNT_STATUS) || !sizeof(all_inventory(this_object())))
    return break_string("Ein wahrer Schrank von Kleiderschrank erhebt sich "
        "da vor Dir in die Hoehe. Der kann wohl wahre Kleiderberge in sich "
        "beherbergen! Ausserdem hat er zwei stabile Tueren, mit denen man "
        "ihn oeffnen und schliessen kann, wohl um etwaige Gerueche in ihre "
        "Schranken zu weisen. An ihnen erkennst Du auch metallbehauene "
        "Scharniere, die wohl fuer die Ewigkeit gemacht wurden. An der "
        "linken Schranktuer befindet sich ein kleines Schild, das geradezu "
        "darauf wartet, genauer betrachtet zu werden.", 76);
    else
      return break_string("Ein "+ (beschriftung ?
            "mit " + beschriftung + " beschrifteter" : "unbeschrifteter") +
          " Kleiderschrank,\nin ihm befinden sich:\n",78,0,1)+
          make_invlist(this_player(),all_inventory(this_object()),0);
}


varargs int PreventInsert(object ob)
{
  if ((!environment()) || 
      ((member(inherit_list(environment()),"std/room.lpc"))<0)) {
    write("Solange Du den Schrank mit Dir herumtraegst, wird das nichts.\n");
    return 1;
  }
  if (!ob->QueryProp(P_ARMOUR_TYPE)) {
    write("Aber der Kleiderschrank kann doch nur Kleidung aufnehmen!\n");
    return 1;
  }
  return ::PreventInsert(ob);
}
 

int move(mixed dest, int method)
{
  if (sizeof(all_inventory(this_object()))) {
    write("Also mit Inhalt ist Dir der Schrank *WIRKLICH* zu schwer.\n"
      "Raeum ihn doch erst mal aus, bevor Du ihn in der Gegend rumtraegst.\n");
    return ME_TOO_HEAVY;
  }
  else if (objectp(dest) && 
    ((member(inherit_list(dest),"std/room.lpc"))>=0) &&
    (present(MOEBEL_ID+" "+MAX_MOEBEL_ALLOWED,dest))) {
     write("Da steht bereits genug herum, findest Du nicht?\n");
    return ME_CANT_BE_DROPPED;
  }
  else return ::move(dest, method);
}


public string short()
{
  string s;

  s = "Ein "+ (beschriftung?"["+beschriftung+"] ":"unbeschrifteter ") +
      GetContainerStatusString() + "er Kleiderschrank ";
  switch (sizeof(all_inventory(this_object()))) {
    case 0: return s+="(leer).\n";
    case 1..5: return s+="(duenn bestueckt).\n";
    case 6..10: return s+="(etwas gefuellt).\n";
    case 11..22: return s+="(halb vollgestellt).\n";
    case 23..29: return s+="(ziemlich voll).\n";
    case 30..34: return s+="(vollgestellt).\n";
    case 35: return s+="(randvoll).\n";
    default: return s+="(berstend voll).\n";
  }
  return "Hae?.\n";
}
