// /d/seher/mupfel/obj/heilwasser.c   Eine Flasche Heilwasser
// 23-06-95  - Mupfel@AnderLand -

inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include "/players/woody/files.h"

#define MAXFILL 10

int fill;

create()
{

  if (!is_clone(this_object())) return;
  ::create();
  fill = MAXFILL;
  SetProp(P_SHORT, "Eine Flasche Heilwasser");
  SetProp(P_LONG, BS(
    "Dies ist eine Flasche mit bestem Heilwasser, frisch abgefuellt aus "+
    "den tiefen Quellen der Schreckensspitze. Um einen Schluck von diesem "+
    "belebenden Wasser zu Dir zu nehmen, tippe 'schluck wasser'.")+
    "Die Flasche ist noch @@fuellstand@@.\n");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10*MAXFILL);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NAME, "Flasche Heilwasser");
  AddId (({"wasser", "heilwasser", "flasche", "flasche wasser", "flasche heilwasser"})); 

  AddCmd ("schluck", "trinken");
}

string fuellstand()
{
  return (fill == MAXFILL ? "ganz voll" : "zu "+ 100*fill/MAXFILL +"% gefuellt");
}


int trinken(string was)
{
  if (!present(ME, PL)) return 0;  // 'Wie bitte?' wenn die Flasche bloss daliegt
  notify_fail(
    "Hm. So wird das nix. Wenn Du einen Schluck Heilwasser zu Dir nehmen\n"+
    "willst, tippe 'schluck wasser'.\n");
  if (!was) return 0;
  if (was=="wasser")
  {
    write("Du setzt die Heilwasserflasche an und nimmst einen kraeftigen Schluck\n"+
          "der belebenden Fluessigkeit. Sofort fuehlst Du Dich viel besser.\n");
    say(PL->name(WER)+" nimmt einen Schluck Heilwasser und sieht gleich "+
        "viel besser aus.\n");
    PL->heal_self(80+random(20));
    fill--;
    if (fill == 0)
    {
      write("Nachdem Du den letzten Schluck aus der Flasche ausgetrunken\n"+
            "hast, loest sie sich ploetzlich in Nichts auf.\n");
      say(PL->name(WESSEN)+" Heilwasserflasche ist leer und entsorgt sich selbst.\n");
      remove();
    }
    SetProp(P_WEIGHT, 10*fill);
    return 1;
  }
  return 0;
}
