inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./def.h"

int tuer_offen;

void create()
{
  ::create();
  tuer_offen = 0;     
  SetProp( P_INT_SHORT, "Levitikus Seherhaus" );
  SetProp( P_INT_LONG,
    BS("Du blickst um Dich und siehst ein schoen aufgeraeumtes "
    "und durch mehrere Fenster hellerleuchtetes Zimmer. In der Mitte steht "
    "ein grosser Tisch, in den Ecken Schraenke, ein Buecherregal und ein "
    "Schreibtisch. An den Waenden haengen einige Bilder und auf dem Boden "
    "liegt ein sauberer, schoener Teppich, welcher die rustikale Einrichtung "
    "noch unterstreicht. In einer Ecke siehst Du ein Fernrohr.\n") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
	
  AddDetail( "boden",
    BS("Auf dem Boden liegt ein Teppich, auf dem der Tisch und die Stuehle "
    "stehen. Der Teppich selbst ist schoen gewebt und sieht aus wie neu. "
    "Erinnert ans Erdgeschoss kniest Du Dich nieder und kriechst suchend auf "
    "dem Boden herum, kannst allerdings kein einziges Staubkorn finden. In "
    "einem Eck findest Du allerdings eine Falltuere, durch die Du sicherlich "
    "wieder nach unten gelangen kannst.\n") );
  AddDetail( "wand",
     BS("Die Wand ist schneeweiss verputzt, rundherum in allen vier "
     "Himmelsrichtungen kannst Du aus den Fenstern blicken. In den Ecken "
     "stehen zwei Schraenke ein Buecherregal und ein Schreibtisch. Die freien "
     "Stellen sind mit Bildern aus dem ganzen Silberland bestueckt.\n") );
  AddDetail( "decke",
    BS("Von der Decke baumelt ein rustikaler Kronleuchter herunter, "
    "in dem einige Kerzen stecken.\n") );
  AddDetail( "hitze",
    BS("Zum Glueck hat es hier herinnen angenehmere Temperaturen als "
    "draussen.\n") );
  AddDetail ("einrichtung",
    BS("Mehrere Bilder und vor allem der Teppich machen das Zimmer"
    "aussergewoehnlich.\n"));
  AddDetail( "kronleuchter",
    BS("Ein echt rustikales Stueck mit original 40 Kerzen bestueckt.\n") );
  AddDetail ("sonne",
    BS("Sie scheint durch das Fenster herein.\n"));
  AddDetail( "kerzen",
    BS("Die 40 Kerzen des Kronleuchters sind aus Bienenwachs. Zur Zeit "
    "brennen sie allerdings nicht, da die Sonne durch die grossen Fenster "
    "sowieso genug Licht hereinlaesst.\n") );
  AddDetail( ({"bild", "bilder"}),
    BS("Bilder aus allen Gegenden des Silberlandes. Den "
    "Bergen, Staedten, Waelder, dem Flachland...\n") );
  AddDetail( "fenster",
    BS("Du blickst aus dem Fenster ueber Tijara und den Dschungel hinweg auf "
    "das weite Meer und faengst zu traeumen an... Wenn Du Dir das Fernrohr "
    "zur Hand nimmst, kannst Du sicher alles etwas naeher betrachten."));
  AddDetail( "fernrohr",
    BS("Solltest Du Dir die Umgebung draussen naeher betrachten "
    "wollen gib einfach 'fern objekt' ein. Damit koenntest Du zum Beispiel "
    "Tijara, den Dschungel und das Meer etwas naeher betrachten koennen.\n") );
  AddDetail( ({"schraenke","schrank"}),
    BS("Hier gibt es zwei Schraenke. Einen normalen "
    "Wandschrank und einen Glasschrank.\n") );
  AddDetail (({"ecke","ecken"}),
    BS("Deren gibt es vier an der Zahl.\n"));
  AddDetail( "wandschrank",
    BS("Genauer betrachtend erkennst Du, dass dies ein "
    "Schrankbett ist... klar! Wo soll der Besitzer denn sonst auch schlafen? "
    "Im staubigen Erdgeschoss sicher nicht.\n") );
  AddDetail("schrankbett",
    BS("So Bett, das gleichzeitig ein Schrank ist.\n"));
  AddDetail(({"levitikus", "besitzer"}),
    BS("Ein besonders verdienter Seher im Silberland"
    "ist Besitzer dieses Hauses.\n"));
  AddDetail( "glasschrank",
    BS("In diesem Schrank befindet sich viel Geschirr, eine Wasserpfeife, "
    "ein paar normale Pfeifen, Tabak und und ein Kisterl Roche."));
  AddDetail("geschirr",
    BS("Es ist aus Porzellan und schoen bemalt.\n"));
  AddDetail (({"kisterl", "kisterl roche", "roche"}),
    BS("Na die von Ferrero!?.\n"));
  AddDetail ("porzellan",
    BS("Qualitativ hochwertiges Porzellan.\n"));
  AddDetail( "wasserpfeife",
    BS("Von sowas sollte man die Finger lassen!\n"));
  AddDetail( ({"pfeifen","pfeife"}),
    BS("Mmm...sicher was Feines mit dem richtigen Tabak. "
      "Du kannst ja mal eine versuchen!\n"));
  AddDetail("tabak",
    BS("Feiner Tabak. Woher ihn der Besitzer wohl her hat?\n"));
  AddDetail(({"staub","staubkorn"}),
    BS("Kein einziges Staubkorn kannst Du hier finden.\n"));
  AddDetail( "erdgeschoss",
    BS("Das Stockwerk unter Dir.\n"));
  AddDetail( "teppich",
    BS("Der Teppich ist fein gewebt. Auf Deiner Suche nach Staub "
    "hebst Du ihn an einem Eck hoch und siehst darunter... doch auch hier ist "
    "nichts zu finden.\n"));
  AddDetail("regal",
    BS("Hier sind also die Buecher aus dem Erdgeschoss hingekommen! Das "
    "Regal quillt fast ueber vor interessanten Werken ueber die Staedte und "
    "Gegenden des Silberlandes, aber auch Studien ueber Tiere und Monster "
    "sind hier zu finden."));
  AddDetail ("temperatur",
    BS("Es ist weder kalt noch warm hier drin.\n"));
  AddDetail("silberland",
    BS("Das Land in dem Du dich befindest.\n"));
  AddDetail("gegenden",
    BS("Hier im Silberland gibt es einige Gegenden; die Berge, "
    "Waelder, Staedte, das Flachland, den Dschungel, den Kristallwald... "
    "etc...\n"));
  AddDetail(({"berg", "gebirge","berge"}),
    BS("Hohe, kalte und finstere Berge.\n"));
  AddDetail(({"wald","waelder"}),
    BS("Weite ruhige Waelder.\n"));
  AddDetail( ({"steppe","flachland"}),
    BS("Das weite Flachland mit seiner Steppe.\n"));
  AddDetail("dschungel",
    BS("Der tiefe Dschungel, in den noch niemand weit vordringen "
    "konnte.\n"));
  AddDetail("kristallwald",
    BS("Der maerchenhaft schoene, aber ebenso unerforsche "
    "Kristallwald.\n"));
  AddDetail( ({"studien","tiere","monster"}),
    BS("Studien ueber die Tiere und Monster "
    "des Silberlandes eben...\n"));
  AddDetail("buecher",
    BS("Zwei Buecher stechen besonders aus dem Regal hervor; ein "
    "weisses und ein rotes Buch.\n"));
  AddDetail(({"weisses","weisses buch"}),
    BS("Du kannst es lesen.\n"));
  AddDetail(({"rotes","rotes buch"}),
    BS("Du kannst es lesen.\n"));
  AddReadDetail(({"weisses","weisses buch"}),
    BS("Dieses Buch traegt den Titel 'Experimente mit Teleportern'. "
    "Hier sind der Aufbau und die Funktionsweise von Teleportern "
    "genauestens beschrieben. Viel sagen Dir die komplizierten Erklaerungen "
    "allerdings nicht, und so legst Du es wieder ins Regal zurueck.\n"));
  AddReadDetail( ({"rotes","rotes buch"}) ,
    BS("In diesem Buch hat der letzte Eigentuemer wohl "
    "niedergeschrieben, was mit dem unteren Stockwerk wohl geschehen ist. "
    "Dies kannst Du allerdings nur an den Skizzen erkennen, denn der Text ist "
    "mit uralten Runen geschrieben, die heutzutage niemand mehr verwendet und "
    "Du daher auch nicht mehr uebersetzen kannst. Enttaeuscht legst Du das "
    "Buch wieder ins Regal zurueck.\n"));
  AddDetail("eigentuemer",
    BS("Hmm...naja... muss wohl der Vorbesitzer dieses Seherhauses "
    "gewesen sein, denn die Runen, die anscheinend den Namen des Verfassers "
    "angeben sollen, koennen unmoeglich Levitikus ergeben.\n"));
  AddDetail("runen",
    BS("Uralte Runen aus der Vorzeit.\n"));
  AddDetail("stockwerk",
     BS("Ein Stockwerk...jetzt befindest Du Dich im oberen Stockwerk "
     "und unter Dir ist das untere Stockwerk.\n"));
  AddDetail( ({"haus","seherhaus", "zimmer"}),
     BS("Dies ist das Seherhaus von Levitikus.\n"));
  AddDetail ("buch",
    BS("Ein recht altes Buch mit zerfleddertem Einband.\n"));
  AddDetail (({"wachs","bienenwachs"}),
    BS("Ein wohlriechendes Material fuer Kerzen.\n"));
  AddDetail ("tisch",
    BS("Um den runden Tisch, der sich in der Mitte des Zimmers "
    "befindet, sind acht Stuehle gereiht. Auf ihm befindet sich ein Korb "
    "mit Fruechten und ein paar Erfrischungen.\n"));
  AddDetail ( "fruechte",
    BS("Frische Dschungelfruechte; darunter Aepfel, Bananen "
    "und Orangen. Moechtest Du nicht etwas probieren?\n"));
  AddDetail ("korb",
    BS("Ein Korb voll mit frischen Fruechten.\n"));
  AddDetail ("mitte",
    BS("Dort befindet sich der Tisch.\n"));
  AddDetail ( "erfrischungen",
    BS("Tee, Kaffee, Wein, Bier und Wasser... alles da. Greif nur zu!\n"));
  AddDetail ("stuehle",
    BS("Um den Tisch herum stehen acht Stuehle, die "
    "allesamt einen recht gemuehtlichen Eindruck machen. Ein Stuhl lacht "
    "Dich besonders an.\n"));
  AddDetail ("stuhl",
    BS("Ein ganz angenehmer Stuhl. Vielleicht kannst Du Dich ja "
    "in ihn hineinsetzen?\n"));
  AddDetail ( ({"falltuere","falltuer"}),
    BS("Fragend begutachtest Du die Falltuere "
    "und versuchst sie zu oeffnen. Hier muesste es wieder zurueck ins "
    "Erdgeschoss gehen, von wo Du hergekommen bist.\n"));
  AddDetail ("schreibtisch",
    BS("Der Schreibtisch ist zwar schlicht gehalten, "
    "passt aber im Stil recht gut in das Zimmer. Er besitzt 2 Laden und "
    "vor ihm steht ein gemuehtlicher Sessel.\n"));
  AddDetail ("sessel",
    BS("Ein gemuehtliches Stueck. Aber hier solltest Du Dich "
    "nicht hineinsetzen, denn das ist Levitikus Privatsessel.\n"));
  AddDetail (({"lade","laden"}),
    BS("Sie sind fest verschlossen. Sicher hat "
    "Levitikus hier Private Sachen verstaut.\n"));
  AddDetail ("wein",
    BS("Mmmm...Ein alter Chateau Clos de Midas, ein '78er aus "
    "der Ebene, lecker! Den solltest Du so schnell wie moeglich kosten, "
    "bevors ein anderer tut!\n"));
  AddDetail("kaffee",
    BS("Eine Galamischung aus Tijara! Der erweckt Tote wieder zum "
    "Leben.\n"));
  AddDetail("bier",
    BS("Ein Original aus einer Zwergenbrauerei...und ueber deren "
    "Kuenste wird ja so einiges gemunkelt...\n"));
  AddDetail("wasser",
    BS("Frisch aus einem Dschungelbach.\n"));
  AddDetail(({"banane","bananen"}),
    BS("Hmm..beim Anblick einer Banane fragst Du "
   "Dich immer wieder, warum die Dinger eigentlich so krumm sein muessen. Ob "
   "es auch gerade Bananen gibt? Lass Dirs schmecken!\n"));
  AddDetail (({"apfel","aepfel"}),
    BS("Ein lecker rotes Aepfelchen, direkt zum Reinbeissen.\n"));
  AddDetail(({"orange","orangen"}),
    BS("Eine orange Orange. Warum eine Orange wohl orange ist? Naja, "
    "sonst wuerde die orange Orange wohl kaum Orange heissen, sondern "
    "Zitrone, oder? Diese hier sieht jedenfalls zum reinbeissen aus; "
    "nach dem Schaelen, versteht sich.\n"));

  AddSmell(DEFAULT_SMELL,
    "Ein angenehmer Duft von Gemuehtlichkeit und Gelassenheit "
    "stroemt Dir hier entgegen." );
  AddSmell("duft",
    "Der Duft muss wohl von Pfeifenrauch und Wein herruehren.");
  AddSmell(({"rauch","pfeifenrauch"}),
    "Ein angenehmer Geruch; nicht so wie der von Zigaretten.");
  AddSmell("wein",
    "Raus mit Deinem Riecher aus dem guten Wein! Untersuchen reicht "
    "doch, oder? ;)");

  AddSound (DEFAULT_SOUND,
    "Hier ist es recht still. Eine Wohltat, nach dem Laerm auf der Strasse.");
  AddSound("laerm", 
    "Den hoerst du hier nicht.");

  AddCmd( ({"steig","kletter", "steige", "klettere"}), "kletter");
  AddCmd( "oeffne", "oeffne");
  AddCmd( "iss","iss");
  AddCmd( ({"trinke","trink"}),"trink");
  AddCmd( ({"rauch", "rauche"}),"rauch");
  AddCmd( "fern","fern");     	
  AddCmd( ({ "sitze", "sitz", "setz" , "setze" }), "sitz");
}

int oeffne (string str)
{
  notify_fail ("Was mochestest Du oeffnen?\n");
  if (!str) return 0;
  switch (str)	
  {
    case "fenster":	
      write(BS("Die Fenster sind verschlossen. Wahrscheinlich um "
	  "die Hitze von draussen nicht reinzulassen.\n"));
      say(TP->name(WER,2)+" probiert, das Fenster zu oeffnen.\n");
      return 1;	
    case "laden":	
      write (BS("Sie lassen sich nicht oeffnen... glaubst Du zumindest.\n"));
      say(TP->name(WER,2)+" schafft es nicht, die Laden zu oeffnen.\n");
      return 1;	
    case "lade":
      write(BS("AUTSCH! Eine verborgene Kraft im Schreibtisch gibt "
	+"Dir einen leichten Schlag auf die Finger.\n"));
      say(TP->name(WER,2)+" bekommt von einer verborgenen Kraft einen "
	+"Schlag auf die Finger.\n");				
      return 1;
    case "falltuere":
    case "falltuer":
      write (BS("Du oeffnest die Falltuere und schaust nach unten. Ob man da "
	+"runterklettern kann?\n"));
      tuer_offen =1;		
      return 1;
    default: return 0;
  }
  return 0;
}

int iss (string str)
{
  notify_fail ("Was moechtest Du essen?\n");
  if (!str) return 0;
  switch (str)
  {
    case"banane":
    case "bananen":
      write(BS("Du isst eine Banane und musst sagen, dass sie wirklich gut "
        "schmeckt!\n"));
      say(TP->name(WER,2)+" isst eine Banane.\n");
      return 1;
    case "apfel":
    case "aepfel":
      write(BS("Ein roter guter Apfel! Lecker!\n"));
      say(TP->name(WER,2)+" verschlingt einen Apfel.\n");
      return 1;
    case "orange":
    case "orangen":
      write(BS("Iiieh...deine Finger picken jetzt aber! Auch wenn die Orange "
	+"recht gut geschmeckt hat.\n"));
      say(TP->name(WER,2)+" isst eine Orange und flucht ueber klebrige "
        "Finger.\n");
      return 1;	
    default: return 0;
  }
  return 0;
}


int trink (string str)
{
  notify_fail("Was moechtest Du trinken?\n");
  if (!str) return 0;
  switch (str)
  {
    case "tee":
      write(BS("Du geniesst eine Tasse schwarzen Tee.\n"));
      say(TP->name(WER,2)+" schluerft ein Taesschen Tee.\n");
      return 1;
    case "wein":
      write(BS("Guter Wein!\n"));
      say(TP->name(WER,2)+" geniesst ein gutes Troepfchen.\n");
      return 1;
    case "bier":
      write(BS("Borp. Lecker.\n"));
      say(TP->name(WER,2)+" stuerzt ein Bier hinunter und stoesst kurz "
        "auf.\n");
      return 1;
    case "wasser":
      write(BS("Du fuehlst Dich erfrischt.\n"));
      say("Ein Glaeschen Wasser erfrischt "+TP->name(WEN,2));	
      return 1;
    default: return 0;
  }
  return 0;
}

int rauch (string str)
{
  notify_fail("Was moechtest Du rauchen?\n");
  if (!str) return 0;
  if (str=="pfeife")
  {
    write(BS("Du rauchst genuesslich ein Pfeiferl.\n"));
    say("Genuesslich raucht "+TP->name(WER,2)+" eine Pfeife.\n");
    tell_room(TO, "Angenehmer Duft erfuellt den Raum.\n");	
    return 1;
  }
  return 0;	
}

int fern (string str)
{
   notify_fail(BS("Du weisst nicht genau, in welche Richtung Du das Fernrohr "
     "drehen sollst...\n"));
   if (!str) return 0;
   switch (str)
   {
     case "tijara":
       write(BS("Mit dem Fernrohr kannst Du an dem geschaeftigen Treiben in "
        "Tijara fast direkt teilnehmen. Ueberall arbeiten die Leute. Die "
        "Daecher funkeln in der Sonne und scheinen in der Hitze geradezu zu "
        "vergluehen. Ein paar Leute baden auch im Brunenn am Hauptplatz.\n"));
     return 1;
    case "daecher":
      write(BS("\n\n+++*****XXXX BLEND XXXX*****+++ \n\nDas naechste mal "
        "solltest Du nicht direkt auf die Dacher blicken, von welchen sich "
        "die Sonne spiegelt.\n"));
      return 1;
    case "treiben":
      write(BS("Die Leute gehen ihrer Arbeit nach.\n"));
      return 1;
    case "hauptplatz":
      write(BS("Hier steht ein Brunnen, in welchem gerade einige Leute ein "
	"erfrischendes Bad nehmen.\n"));
      return 1;
    case "brunnen":
      write(BS("Einige Leute baden gerade darin um der Hitze zu entkommen. Du "
	"bist froh hier zu stehen, wo es angenehmere Temperaturen hat.\n"));
      return 1;
    case "sonne":
      write("Nein, das solltest Du lieber nicht tun, Deinen Augen zuliebe.\n");
      return 1;
    case "dschungel":
      write(BS("Im Dschungel kannst Du selbst mit dem Fernrohr nicht viel "
        "erkennen. Die Vegetation hier ist einfach zu dicht.\n"));
      return 1;
    case "kristallwald":
      write(BS("Der Kristallwald sieht auch von so grosser Entfernung "
        "maerchenhaft schoen aus. Du kannst sogar den See von Rhondonit "
        "erahnen.\n"));
      return 1;
    case "see von rhondonit":
    case "see":
      write (BS("Du siehst nur ein leichtes Blinken der Wellen, die ans Ufer "
	+"schlagen.\n"));
      return 1;
    case "vegetation":
      write(BS("Einfach zu dicht, als um etwas erkennen zu koennen.\n"));
      return 1;
    case "meer":
      write(BS("Dein Blick schweift vom Hafen, in dem gerade einige Schiffe "
        "be- und entladen werden, ueber das schier endlos scheinende Meer "
        "hinweg bis zum Horizont, wo Du vermeinst, eine kleine Insel zu "
        "erkennen. Weiter im Norden faehrt gerade ein Schiff Richtung "
        "Midas."));
      return 1;
    case "insel":
      write(BS("Das muss wohl die Felseninsel sein. Und eine Yacht, faehrt "
        "gerade Richtung Tijara.\n"));
      return 1;
    case "felseninsel":
      write(BS("So weit kommst Du auch mit dem Fernrohr nicht.\n"));
      return 1;
    case "yacht":
      write(BS("Sie faehrt mit gehisstem Segel und kommt flott vorwaerts.\n"));
      return 1;
    case "schiff":
      write(BS("Die Karavelle, welche Passagiere nach Midas bringt, hisst "
        "gerade ihre Segel.\n"));
      return 1;
    default: return 0;
  }
  return 0;
}

int sitz( string str)
{
  notify_fail ( "Wohin willst Du Dich denn setzen?\n");
  if (!str) return 0;
  if( str=="auf sessel" || str =="in sessel" || str =="sessel")
  {	
    if( TP->QueryProp(P_NAME)!="Levitikus" )
    {
      write( BS("\nDu willst Dich in den Sessel setzen, wirst aber von einer "
	"unsichtbaren Kraft wieder herauskatapultiert.\n"));
      say(BS("Der Sessel von Levitikus spuckt "+this_player()->name(WER,2)+
         " wieder aus.\n"));
	TP->reduce_hit_point(random(5));
      return 1;
    }
    write( BS("Du setzt Dich in Deinen EIGENEN Sessel."));
    say(BS("Der Sessel von Levitikus freut sich, dass sein Besitzer wieder "
      "mal vorbeischaut.\n") );
    return 1;
  }
  return 0;
}

	
int kletter (string str)
{
  notify_fail ("Wodurch moechtest Du klettern?\n");
  if( str== "durch falltuere" || str == "durch falltuer" || str == "falltuer"
     || str == "falltuere" || str == "unten" || str == "nach unten" ||
      str == "runter" )
  {
    if (tuer_offen ==1)
    {
      write ( "Du versuchst Dich vorsichtig nach unten zu Hangeln. Doch als "
        "Du bemerkst, dass\nes hier doch zu weit nach unten geht, ist es "
        "schon zu spaet! Dein Griff lockert\nsich und \n\n       "
	"                  'PLUMPS!'\n\n"
	"Du rauschst mit Pauken und Trompeten auf den Boden. Zum Glueck war "
        "da so\nein Haufen Staub, der Deinen Sturz abgefangen hat, Auch wenn "
        "Du jetzt wieder\neinmal voller Staub bist, so bist Du doch froh, "
        "unverletzt gelandet zu sein.\nDu waerst sicher auch anders wieder "
        "runtergekommen.\n" );
      TP->move(SEHERHAUS "levitikus",M_GO, "nach unten",
         "fliegt durch die Falltuere", "fliegt von oben herein");
      TP->reduce_hit_point(random(5));
      return 1;
    }
    else
    {
      write(BS("Du hast sie ja noch nichtmal aufgemacht!"));
      return 1;
    }
  }
  return 0;
}

reset()
{
  ::reset();
  tuer_offen =0;
}
