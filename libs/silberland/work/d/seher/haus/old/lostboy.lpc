inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./def.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "Lostboy's Seherhaus" );
  SetProp( P_INT_LONG,
    "Du betrittst Lostboys bescheidene Huette. "
   +"Fast alles hier besteht aus Holz. Als allererstes "
   +"faellt Dir das uebergrosse Bett ins Auge. "
   +"An der Suedwand entdeckst Du einen kleinen Kamin, "
   +"in dem ein kleines Feuerchen lodert. Ueber dem " 
   +"Kamin haengt ein grosses Bild. In der Mitte "
   +"der Huette steht ein kleiner Tisch. "
   +"In einer Ecke findest Du einen Haufen Dreck, "
   +"der gar nicht in die ansonsten saubere Huette passt. "
   +"Der Boden wurde erst vor kurzem geputzt, Du solltest Dir die Schuhe ausziehen. "
   +"Sonst siehst Du noch ein paar weitere Moebelstuecke rumstehen. "
);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN]));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  AddDetail( ({ "huette", }), 
          "Du stehst mittendrin. Obwohl sie sehr schlicht "
         +"gehalten ist, findest Du es hier gleich gemuetlich." );
  AddDetail( ({ "holzarten", "arten" }), 
          "Fichte, Buche, Birke, ... " );
  AddDetail( ({ "holz", }), 
          "Alles ist aus Holz. Allerdings nicht einheitlich, sondern "
         +"alle moeglichen Holzarten. Dadurch entsteht ein lustiges "
         +"Farbenspiel. Besonders die Waende, mal ein heller Holzbalken, "
         +"mal ein dunkler Holzpfeiler. " );
  AddDetail( ({ "balken", "farbenspiel", "spiel", "pfeiler", "holzpfeiler" }), 
          "Hell, dunkel, hell, dunkel. Du bekommst einfach "
         +"nicht genug davon." ); 
  AddDetail( ({ "fenster", "fensterchen" }), 
          "Du schaust aus dem Fenster. Es ist ein schoener Anblick. "
         +"Die Sonne geht gerade unter. Die Steppe sieht von hier aus " 
         +"so friedlich aus. Der prachtvolle Eindruck "
         +"bringt Dich ins Traeumen." );
  AddDetail( ({ "steppe", }), 
          "Die Steppe zeigt sich hier von ihrer schoensten Seite. " ); 
  AddDetail( ({ "seite", }), 
          "Ob die andere auch so schoen ist? " );
  AddDetail( ({ "falschen", }), 
          "Sengir? " );
  AddDetail( ({ "eindruck", "anblick" }), 
          "So langsam hast Du genug vom Traeumen und beschliesst " 
         +"die Huette noch ein bisschen genauer anzuschauen." );
  AddDetail( ({ "spitze", "wurm" }), 
          "Ihhhh, ist das ekelhaft. Du hast kein Bedarf dir das " 
         +"genauer anzusehen." );
  AddDetail( ({ "bett", "himmelbett" }), 
          "Was fuer ein prachtvolles Himmelbett. Eins der wenigen "
         +"Objekte, die nicht aus Holz bestehen. Du verspuerst Lust "
         +"Dich in das Bett zu legen, so bequem schaut es aus. "
         +"Doch irgendwie hast Du ein ungutes Gefuehl bei dem Gedanken." );  
  AddDetail( ({ "objekte", }), 
          "Viele Objekte lassen sich hier untersuchen, welches meinst Du? " );
  AddDetail( ({ "lust", }), 
          "Das Bett verlangt foermlich nach dir. Was soll schon passieren? " );
  AddDetail( ({ "boden" }), 
          "Sogar der Boden besteht aus Holz. "
         +"Die Holzlatten sind sehr gut verlegt worden. Du kannst auf den "             
         +"ersten Blick keine Luecken entdecken. "
         +"In einer Ecke siehst du einen "
         +"Haufen Dreck liegen. " );
  AddDetail( ({ "luecken", }), 
          "Auf den ersten Blick geben sie einen Top Zustand ab. " );  
  AddDetail( ({ "holzlatten", "latten" }), 
          "Du beschliesst den Boden genauer zu untersuchen. " 
         +"Also kriechst Du auf dem Boden rum. Tatsaechlich, Du "
         +"kannst eine etwas groessere Luecke entdecken.");
  AddDetail( ({ "luecke", }), 
          "Du betrachtest die Luecke im Holzboden nun etwas intensiver. "
         +"Als Du Dein Gesicht drueber beugst um runter zu gucken, kannst "
         +"Du leider nichts entdecken. Es ist einfach zu dunkel. "
         +"Allerdings spuerst Du einen Luftzug. "
         +"Da unten muss ein geheimer Raum verborgen sein." );
  AddDetail( ({ "luftzug", "zug" }), 
          "Durch die Luecke spuerst Du einen leichten Zug. "
         +"Aber sehen kannst Du leider nichts." );
  AddDetail( ({ "raum", }), 
          "Du kannst nicht 100%ig sagen, ob es da unten etwas zu finden gibt. "
         +"Waehrend Du noch raetselst was da sein koennte, entdeckst "
         +"Du im Boden die Umrisse einer Falltuere.");
  AddDetail( ({ "umrisse" }), 
          "Jetzt kannst Du sie gut erkennen. Komisch das "
         +"sie Dir vorher noch nicht aufgefallen sind. " );
  AddDetail( ({ "falltuere", "falltuer" }), 
          "Sie laesst sich bestimmt oeffnen, aber nur wie? " );
  AddDetail( ({ "tuer" }), 
          "Diese Holztuer im Norden scheint sehr stabil zu sein. "
         +"Sie ist geoeffnet. " );
  AddDetail( ({ "dreck", "haufen" }), 
          "Es ist ein kleiner Haufen Erde. Du hast kein Plan, was der "
         +"da soll. Du siehst Etwas aus der Erde rausgucken. " ); 
  AddDetail( ({ "etwas", }), 
          "Es sieht aus wie die Spitze von einem Wurm. Du "
         +"ekelst Dich und beschliesst den Dreckhaufen in Ruhe zu lassen. " );
  AddDetail( ({ "kamin", }), 
          "Das Feuerchen, welches im Kamin dahinlodert, "
          "gibt Dir schoen warm. Du fuehlst Dich pudelwohl. "
         +"Ueber dem Kamin haengt ein Bild. "  );
  AddDetail( ({ "bild", }), 
          "Du betrachtest ein Bild. Es ist schoen gezeichnet. "
         +"Du siehst darauf Lostboy mit seinen Freunden. "  );
  AddDetail( ({ "freunde", "gesichter" }), 
          "Du siehst ein paar Gesichter. Ein paar kennst Du, "
         +"ein paar hast Du noch nie gesehen. "
         +"Unter jeder Person stehen die jeweiligen Namen." );
  AddDetail( ({ "person", "leute" }), 
          "Wenn du eine Person genau anschaust, erfaehrst du vielleicht mehr ueber sie." );
  AddDetail( ({ "namen", }), 
          "Du kannst sie lesen" );
  AddDetail( ({ "wand", "waende" }), 
          "Wie alles in dieser Huette ist auch die Wand aus Holz. "
         +"Nur ein kleines Fensterchen erhellt die Huette. "
         +"An der Ostwand haengt ein Schild mit einem Spruch drauf." );
  AddDetail( ({  "spruch" }), 
          "Wenn Du mutig genug bist kannst Du versuchen ihn zu lesen." );
  AddDetail( ({ "moebel", "moebelstuecke", "stuecke" }), 
          "Dein Blick schweift durch die ganze Huette. "
         +"Es ist wirklich nur eine stinknormale Einrichtung. "
         +"Gerade als Du aufgibst was Interessantes zu finden, "
         +"entdeckst Du eine kleine versteckte Truhe auf einem "
         +"hohen Schrank."  );
  AddDetail( ({ "truhe", }), 
          "Sie schaut interessant aus. Du willst unbedingt wissen "
         +"was darin verborgen ist. ");
  AddDetail( ({ "schrank", }), 
          "Voellig uninteressant. Du macht ihn trotzdem auf und "
         +"findest dreckige Waesche. Entsetzt schliesst Du den "
         +"Schrank wieder." );
  AddDetail( ({ "decke", }), 
          "Ja, ne Decke hat die Huette auch." );
  AddDetail( ({ "tisch", }), 
          "Ein viereckiger Tisch aus Holz. Du wunderst Dich "
         +"das keine Stuehle an dem Tisch stehen. Der Tisch selber "
         +"ist fast leer. Nur ein aufgeschlagenes Buch liegt darauf." );
  AddDetail( ({ "erde", }), 
          "Die Erde sieht aus als ob sie hier schon lange "
          "lagern wuerde." );
  AddDetail( ({ "stuehle", }), 
          "Um den Tisch kannst Du keine entdecken, aber neben dem "
         +"Schrank steht ein Hocker." );
  AddDetail( ({ "hocker" }), 
          "Der Holzhocker steht direkt neben dem hohen Schrank. "
         +"Er sieht richtig unbequem aus." );
  AddDetail( ({ "zettel" }), 
          "Lies ihn." );
  AddReadDetail( ({ "namen", }), 
          "Das sind meine Freunde:\n"
         +"Ed, Drgary, Sheila, Joscherl, Arthoas, Thrawn, Slayven,\n"
         +"Protheg, Darklord, Muadib, Asmodis, Ikea, Zeh, Scho,\n"
         +"Adt, Skunk, Semira, Sargola, Andyl, Bad, Aleph, Homer,\n"
         +"Krigi, Sengir, Legolas, Blackwolf, Andi, Rakal,\n"
         +"Kara, Zordan, Fenris, Torte und Verdandi.\n"
         +"Lostboy hat noch zu jedem Namen ein paar Zeilen dazu geschrieben.\n" ); 
  AddDetail( ({ "zeilen", }), 
          "Schau Dir einfach die Leute auf dem Bild an. " );
  AddDetail( ({ "feuer", "feuerchen" }), 
          "Du kannst ja mal reinfassen wenn Du willst. " );
  AddDetail( ({ "ostwand", }), 
          "Die Ostwand ist uninteressant. Nur das Schild das "
         +"an ihr haengt faellt Dir ins Auge. "  );
  AddDetail( ({ "suedwand", }), 
          "Ausser einem Kamin und einem schoenen Bild " 
          "findest Du hier nichts Sehenswertes." );
  AddDetail( ({ "einrichtung", }), 
          "Wie gesagt, stinknormal." );                              
  AddDetail( ({ "holzbalken", "balken" }), 
          "Die bunten Holzbalken stuetzen die Huette. "
          "Du hoffst, dass sie halten." );  
  AddDetail( ({ "fichte", "buche", "birke" }), 
          "Die gibt es vor allem im Silberwald zu finden." );    
  AddReadDetail( ({ "spruch" }), 
          "Wer ist die Liebste Weit und Breit? Na Kara, das schreit "
         +"nach Hochzeit. " );
  AddDetail( ({ "schild", }), 
           "Auf dem Schild steht ein schoener Spruch. Darueber ist noch "
          +"ein wundervolles Portrait von der noch wundervolleren Kara. " );
  AddDetail( ({ "sonne", }), 
          "Du schaust zu wie sie im wunderschoenen rot hinter "
         +"dem Horizont verschwindet." );    
  AddDetail( ({ "toilette", "Toboibilebettcheben" }), 
          "Du fragst Dich was dieser scheiss soll." );    
  AddDetail( ({ "auge", }), 
          "Du versuchst Dein Auge anzuschauen. Schaffst es aber nicht." );     
  AddDetail( ({ "wunder", "gedanke", "gefuehl", "gesichter", "plan", "bedarf", "gedanken" }), 
          "Du entdeckst nichts besonderes daran." );     
  AddDetail( ({ "lostboy", }), 
          "Der Erschaffer dieser schnuckeligen Huette. "
         +"Du kannst ihn auf dem Bild nur unscharf erkennen." );     
  AddDetail( ({ "mitte", }), 
          "Eigentlich hat die Huette keine richtige Mitte. "
         +"Sie ist einfach zu krumm und schief gebaut." );     
  AddDetail( ({ "interessantes", "sehenswertes" }), 
          "Du suchst nach etwas Interessantem. "
         +"Als Du in einen Spiegel siehst, hast du es endlich gefunden." );     
  AddDetail( ({ "spiegel", }), 
          "Du siehst Dich. Welch Wunder." );     
  AddDetail( ({ "ecke", "ecken" }), 
          "Die Huette hat vier Ecken. Aber man sieht nur drei. "
         +"Du wunderst Dich." );     
  AddDetail( ({ "buch", }), 
           "Das Buch auf dem Tisch ist zugeklappt. Auf der Vorderseite "
          +"steht LOSTBOYS TAGEBUCH gekritzelt. " );
  AddDetail( ({ "tagebuch", }), 
           "Du oeffnest das Tagebuch und siehst lauter Zeichen. "
          +"Vielleicht sind es Buchstaben? Und was macht man mit "
          +"Buchstaben?" );               
  AddReadDetail( ({ "tagebuch", "buch" }), 
          "Es ist dir zwar peinlich aber Du faengst trotzdem an zu lesen.\n"
         +"Du hast gerade die Seite aufgeschlagen auf der alle Tode von\n"
         +"Lostboy verzeichnet sind:\n"
         +"30.Mai 03:38 Mein erster Tod durch den Waldwolf beim Sumpf.\n"
         +"14.Jun 14:10 Meine erste Begegnung mit einem Oger endete toedlich.\n" 
         +"23.Jun 20:37 Der riesige Troll im Huegelland hatte mich mit 2 Schlaegen gekillt.\n"
         +"25.Jun 19:31 Ich wollte fluechten, nur war ein Silberwolf im Weg.\n"
         +" 1.Jul 23:50 Der Wassergeist hat mich ohne Probleme erlegt.\n"
         +" 2.Jul 00:04 Ich Trottel bin gleich nochmal zum Wassergeist.\n"
         +" 3.Jul 22:04 Der Schmied Haegar hat mich gekillt. Wieso weiss ich heute noch nicht.\n"
         +" 3.Jul 23:16 Da hats wiedermal ein Oger geschafft mich zu erlegen.\n"
         +" 8.Jul 00:26 Heute ist ein schwarzer Tag. Die Oger waren wieder da.\n"
         +" 8.Jul 19:12 Wer haette das gedacht? Der Offizier hat mich doch tatsaechlich gekillt.\n"
         +"17.Jul 18:39 Der Zergenwaechter wollte mich nicht durch lassen und hatte gewonnen.\n"
         +" 3.Aug 01:13 Der Gargyl hat mich einfach nicht fliehen lassen.\n"
         +" 3.Aug 01:41 Eine halbe Stunde spaeter. Selber Ort, selber Gargyl.\n"
         +" 5.Aug 19:47 Die Bestien waren los. Seit dem Tag hasse ich sie auch.\n"
         +" 5.Aug 20:15 Da will man seine Ausruestung wieder und wird dabei von einer anderen Bestie gekillt.\n"
         +"11.Sep 21:47 ARGL, so n kleener Kobold wollte es wissen. Er hatte recht.\n"
         +"Hier endet die Todesseite von Lostboy, Du kannst die naechste Seite\n"
         +"aufschlagen wenn Du willst.\n" );




  AddDetail( ({ "buchstaben" }), 
          "Hmmm wie war das nochmal?? AHHHH man liest sie. " );
  AddReadDetail( ({ "buchstaben" }), 
          "a u f k o m m a e i n m a l s i e ... ist das anstregend. "
         +"Aber wer liest schon einzelne Buchstaben, die meisten "
         +"lesen das ganze Buch auf einmal." );         
  AddDetail( ({ "waesche" }), 
           "Die liegt hinter dem verschlossenen Schrank. Zum Glueck, "
          +"sonst wuerde es hier anders riechen." );
  AddDetail( ({ "ecke 4", "vierte ecke" }), 
          "Die vierte Ecke kann man nicht sehen, "
         +"weil der Haufen Erde in dieser Ecke fast alles verdeckt." );     
  AddDetail( ({ "portrait", }), 
          "Du schaust einer wunderschoenen Dame in die Augen.\n"
         +"Ihr Antlitz laesst Dich alles Schlimme dieser Welt vergessen.\n"
         +"Du kannst einfach nicht von ihr ablassen.\n"
         +"BELL BELL, Lostboy`s Wachhund reisst Dich aus Deiner\n"
         +"Blickstarre heraus.\n" ); 
  AddDetail( ({ "dame" }), 
           "Das ist Kara, wer denn sonst? "
          +"Lostboy wuerde von keiner anderen ein Portrait aufhaengen." );
  AddReadDetail( ({ "zettel" }), 
          "Auf dem Zettel steht folgendes geschrieben:\n"
         +"Man bist Du tief gesunken wenn Du in einem vergammelten\n"
         +"Haufen Dreck rumwuehlst. Aber was solls. Auf dem Zettel\n" 
         +"is halt nunmal ne Karte von der Steppe abgezeichnet.\n"
         +"\n"
         +"                   o \n"
         +"                   | \n"
         +"                 o-o \n"
         +"                   | \n"
         +"             o-o   o \n" 
         +"            /   \\ / \n"
         +"         o-o     o   \n"
         +"        /            \n"
         +"lager<-o             \n");      

  AddDetail( ({ "ed", }), 
          "Ein ruhiger Typ von dem ich lange nichts mehr hoerte." );     
  AddDetail( ({ "drgary", }), 
          "Mit ihm hab ich immer Ameisen gekillt." );     
  AddDetail( ({ "sheila", }), 
           "Eine nette junge Hobbitfrau, die oefters mal durchs "
          +"Silberland irrt. Aber sie hats zu was gebracht." );     
  AddDetail( ({ "joscherl", }), 
           "Mein Metzelkumpel alter Tage. Mit ihm bin ich "
          +"aufgewachsen. Mit ihm hab ich in der Zwergenmine "
          +"aufgeraeumt." );     
  AddDetail( ({ "arthoas", }), 
           "Er war immer eine Art Vorbild fuer mich. "
          +"Stets war er da um mir zu helfen. Doch vor kurzem ist er verstorben." );     
  AddDetail( ({ "Thrawn", }), 
          "Er ist leider vor langer Zeit ausgewandert." );     
  AddDetail( ({ "slayven", }), 
           "Ein Kaempfer der alten Schule. " 
          +"Mit ihm habe ich schon fast alle Monster besiegt.");     
  AddDetail( ({ "protheg", }), 
           "Ein netter Kumpel der innerhalb kurzer Zeit zu "
          +"einem der besten Kaempfer im Silberland wurde." );     
  AddDetail( ({ "darklord", }), 
          "Der Forscher. Er hat mir den Einstieg in Knarkh erleichtert." );     
  AddDetail( ({ "muadib", }), 
          "Er war mal mein bester Kumpel. Wir sind gemeinsam "
         +"auf ZT-Suche gegangen. Mit ihm bin ich gross geworden." );     
  AddDetail( ({ "asmodis", }), 
          "Mein Kampfkumpan. Er hat sich jedoch nie aus Midas "
         +"heraus getraut." );     
  AddDetail( ({ "ikea", "adt" }), 
          "Mit Ikea und Adt habe ich mich bis zum Seher "
         +"hochgearbeitet. Leider sind die nur noch selten "
         +"zu sehen." );     
  AddDetail( ({ "zeh", "scho", "andyl" }), 
          "Alter Kumpel mit dem ich das Silberland erforscht habe." );     
  AddDetail( ({ "semira", }), 
          "Supernette Freundin mit der ich viel erlebt habe. "
         +"Immerwieder fuer mich da, wenns mir langweilig ist." );     
  AddDetail( ({ "skunk", "krigi" }), 
          "Mit Skunk und Krigi habe ich Midas "
         +"unsicher gemacht. Beide sind tapfere Helden." );     
  AddDetail( ({ "sargola", }), 
          "Mein einziger richtiger Magier-Freund. " 
         +"Mit ihm verstehe ich mich wirklich gut.");     
  AddDetail( ({ "andi", }), 
           "Ein taperer junger Held. Ich helfe ihm "
          +"immer wieder gerne." );     
  AddDetail( ({ "zordan", }), 
           "Mein Ex-Schueler. Er ist mir aber schnell ueber " 
          +"den Kopf gewachsen. Bald kann ich nur noch von " 
          +"ihm lernen. Er ist sehr maechtig geworden.");     
  AddDetail( ({ "blackwolf", }), 
           "Ein verwirrter junger Zwerg. Er hat sich leider "
          +"zurueckgezogen." );     
  AddDetail( ({ "kara", }), 
          "Mein Lieblingsmaedel hier. Ich hoffe sie mag mich auch. "
         +"Und ich hoffe, dass sie nicht den Falschen heiraten wird." );     
  AddDetail( ({ "fenris", }), 
           "Fenris, Fenris, was soll ich dazu sagen?. "
          +"Einmal muss ich ihm alles genau erklaeren, ein "
          +"andermal bin ich verbluefft was er alles weiss." );     
  AddDetail( ({ "bad", "aleph", "homer" }), 
           "Bad, Aleph und Homer sind alles Groessen im SL. Von ihnen habe "
          +"ich gute Tips bekommen." );     
  AddDetail( ({ "sengir", }), 
           "Sengir hatte immer grosse Probleme sich zurecht zu finden. Doch "
          +"auf einmal, wie ein Wunder, wurde ein richtiger Held aus ihm." );     
  AddDetail( ({ "legolas", }), 
           "Scheiss Alzheimer, ich erinnere mich kaum an ihn. ARGL. "
          +"Kann mir jemand helfen?" );     
  AddDetail( ({ "rakal", }), 
           "Ihn kenne ich noch nicht so lange, aber er scheint voll "
          +"nett zu sein." );     
  AddDetail( ({ "torte", }), 
           "Mit Torte habe ich mich erst sehr spaet befreundet. Irgendwie "
          +"ist das an uns vorbeigegangen." );     
  AddDetail( ({ "verdandi", }), 
           "Verdandi is voll cool. Eine super B....! "
          +"Sie ist eine gute Kaempferin, aber auskennen tut se sich noch kaum." );     
  AddDetail( ({ "auf schrank", }), 
           "Du kannst nur die Truhe sehen, was da sonst noch so alles rumliegt "
          +"wird von dem Schrank verdeckt." );     
  AddDetail( ({ "moeglichkeit", "moeglichkeiten" }), 
          "Viele Moeglichkeiten fuehren zum gewuenschten Ziel." );     
  AddDetail( ({ "weg", }), 
          "Wer sucht der findet." );     
  AddDetail( ({ "traeumen", "traeume" }), 
          "Leg Dich doch mal auf das wundervolle Bett. Dort laesst es sich bestimmt gut traeumen." );     
  AddDetail( ({ "schuhe", }), 
          "Hast Du die etwa immer noch an?" );     

  AddCmd( ({ "oeffen", "oeffne" }), "beweg_etwas" );
  AddCmd( ({ "lege" , "liege", "leg", "lieg" }) , "lege" );
  AddCmd( ({ "heb", "ziehe", "hebe", "zieh" }), "ziehe" );
  AddCmd( ({ "steig", "zwaeng", "kletter", "steige", "zwaenge", }), "kletter" );
  AddCmd( ({ "grabe", "wuehle", "wuehl", "grab" }), "grabe" );
  AddCmd( ({ "fass", "greif", "fasse", "greife" }), "fasse" );
  AddCmd( ({ "sitz", "sitze", "setze", "setz" }), "sitze" );
  AddCmd( ({ "schlage", "blaetter", "schlag" }), "schlage" );
  AddCmd( ({ "breche", "brech", "brich" }), "breche" );
  AddExit( "raus", LOSTBOY );

  AddItem(SEHERHAUS "lostboy_wachhund", REFRESH_REMOVE);
}


beweg_etwas( str )
{
  notify_fail( "Was willst Du denn oeffnen ?\n" );
  if ( str == "truhe" ) {
    write( "Du willst die Truhe oeffnen. Aber leider ist\n"
                +"der Schrank zu hoch fuer Dich. Du musst wohl\n"
                +"erst noch ein bisschen wachsen oder Dir einen\n"
                +"anderen Weg nach oben suchen.\n"  );
               say(  this_player()->name(WER,2)+" ist zu klein um "
                +"an die Truhe ranzukommen.\n");
    return 1;
  }
  if ( str == "falltuere" || str == "falltuer" ) {
    write( "Du versuchst die Falltuere zu oeffnen.\n"
                +"Doch leider bist Du zu schwach.\n"
                +"Die Tuere scheint von innen verschlossen zu sein.\n"
                +"Vielleicht gibt es ja noch eine andere Moeglichkeit.\n"  );
               say(  this_player()->name(WER,2)+" versucht verzweifelt "
                +"eine versteckte Falltuere zu oeffnen.\n");


    return 1;
  }
  if ( str == "buch" ) {
    write( "Lies es doch einfach.\n" );
    say(  this_player()->name(WER,2)+" versucht verzweifelt "
                +"eine versteckte Falltuere zu oeffnen.\n");
    return 1;
  }
  return 0;
}

int lege( string str )
{
  notify_fail( "WorAUF moechtest Du Dich legen ?\n" );
  if ( str == "auf bett" || str == "in bett" || str == "bett" ) {
    if ( getuid(this_player()) != "lostboy" ) {
      write(    "Du legst Dich auf das Bett. Es ist noch viel schoener\n"
          +"als Du es Dir vorgestellt hast.\n"
          +"Doch auf einmal knurrt Dich Lostboys ansonsten so\n"
          +"lieber Wachhund an und attakiert Dich.\n" 
          +"Er beisst mit seinen scharfen Zaehnen in Dein Bein\n"
          +"und hinterlaesst eine tiefe Wunde. Du bekommst Panik\n"
          +"und fluechtest nach draussen.\n" );
          this_player()->reduce_hit_point(5);

      this_player()->move(LOSTBOY, M_GO, 0, 
        "legt sich auf Lostboys Bett. Als ihn der Wachhund anspringt, "
       +"bekommt er Panik und fluechtet nach draussen.\n" , "fliegt heran\n");
      return 1;
    }
    else {
      write("Du legst Dich auf Dein Bett.\n");
      say(this_player()->name(WER,2)+" legt sich auf sein Bett. Du wirst neidisch.\n" );
      return 1;
    }
  }
 return 0;
}

int ziehe( string str )
{
  notify_fail( "WorAN willst Du ziehen ?\n" );
  if ( str == "an luecke" || str == "an falltuere" || str == "falltuere" || str == "an falltuer"  ) {
    write( "Du versuchst die Falltuere zu oeffnen. "
          +"Doch leider scheint sie zu klemmen.\n");
    say(  this_player()->name(WER,2)+" versucht eine Falltuere im Boden zu oeffnen.\n");
    return 1;
  }
  if ( str == "schuhe aus" || str == "stiefel aus"  ) {
    write( "Du ziehst Deine Schuhe aus und stellst sie vor die Tuer.\n"
      +"Lostboy wird sich freuen.\n");
    say(  this_player()->name(WER,2)+" zieht seine Schuhe aus und stellt sie vor die Tuer.\n");
  return 1;
  }
  if ( str == "wurm" || str == "an wurm"  ) {
    write( "Du ziehst den Wurm aus der schmutzigen Erde heraus.\n"
      +"Der Wurm regt sich total auf, denn du hast ihn aufgeweckt.\n"
      +"Angewiedert kackt er Dich an und kriecht wieder in die Erde.\n");
    say(  this_player()->name(WER,2)+" wird von einem Wurm angekackt.\n");
    return 1;
  } 
  return 0;
}

int kletter( string str )
{
  notify_fail( "WorAUF moechtest Du klettern ?\n" );
  if ( str == "auf hocker" || str == "hocker" ) {
    write(   "Du kletterst auf den Hocker.\n" );
    this_player()->move(SEHERHAUS "lostboy_hocker", M_GO, 0, 
      "klettert auf den Hocker neben dem Schrank.\n"
     +"Er kann Dich da oben nicht mehr reden hoeren\n.",
      "klettert zu dir auf den Hocker. Jetzt wirds eng.\n");
    return 1;
  }
  if ( str == "luecke" || str == "in luecke" || str == "durch luecke" ) {
    write(     "Du versuchst Dich verzweifelt durch die 2 cm dicke\n"
          +"Luecke zu quetschen. Fast haettest Du es geschafft,\n"
          +"aber dann wars doch zu eng.\n" ); 
    say(  this_player()->name(WER,2)+" versucht sich in den Boden zu quetschen.\n");
    return 1;
  }
  if ( str == "auf schrank" || str == "schrank" ) {
    write(     "Der Schrank ist etwa drei Meter hoch. Eindeutig das\n"
          +"hoechste hier. Unmoeglich an ihm empor zu klettern. Denn\n"
          +"er ist recht schlicht gebaut und bietet so keine Moeglichkeit\n"
          +"sich daran festzuhalten.\n" ); 
    say(  this_player()->name(WER,2)+" schaut sich einen Schrank an und blickt einen Moment\n"
          +"spaeter recht traurig drein.\n");
    return 1;
  }
  return 0;
}

int fasse( string str )
{
  notify_fail( "wo willst Du hinfassen ?\n" );
  if ( str == "in feuer" || str == "feuer" || str == "in feuerchen" ) {
    write(     "Du greifst in das Feuer und verbrennst Dich.\n"
          +"Du denkst wohl Du bist unverwundbar?\n"
          +"Schwarze Finger und dicke Blasen sind die Strafe dafuer.\n"
          +"Mach das nicht zu oft, das kann toedlich sein.\n");
    this_player()->reduce_hit_point(4);
    say(  this_player()->name(WER,2)+" haelt seine Finger ins offene Feuer.\n");
    return 1;
  }
  return 0;
}

int sitze( string str )
{
  notify_fail( "Wohin willst Du Dich setzen?\n" );
  if ( str == "auf hocker" || str == "hocker" ) {
    write(     "Du willst Dich doch nicht auf den Hocker setzen.\n"
          +"Denn im letzten Moment entdeckst Du wie schmutzig\n"
          +"der Hocker ist. Einige Leute scheinen da schon drauf\n" 
          +"geklettert zu sein.\n" );
    say(  this_player()->name(WER,2)+" setzt sich nicht auf einen Hocker.\n");
    return 1;
  }
  return 0;
}


int schlage( string str )
{
  notify_fail( "Was willst du AUFschlagen?\n" );
  if ( str == "naechste seite auf" || str == "in buch"  || str == "naechste seite" ) {
    write(     "Du blaetterst die naechste Seite auf.\n"
          +"Die Ueberschrift lautet: Lostboy`s Feinde.\n"
          +"Du ueberfliegst die Seite nur ein bischen.\n" 
          +"Ahhh, da hat Lostboy auch etwas ueber Dich geschrieben.\n"
          +"Gerade als Du es lesen willst kommt Lostboys Wachhund angeknurrt.\n"
          +"Er scheint etwas dagegen zu haben, dass Du da rumschnueffelst.\n"
          +"Deine Angst beschliesst das Buch zu vergessen.\n" );
    say(  this_player()->name(WER,2)+" schlaegt in Lostboy`s Tagebuch die naechste Seite auf.\n");
    return 1;
  }
  return 0;
}

int grabe( string str )
{
  notify_fail( "In was willst du graben/wuehlen?\n" );
  if ( str == "in erde" || str == "erde" || str == "haufen" || str == "in haufen" || str == "in dreck" || str == "dreck" ) {
    write(     "Geschickt graebst Du um den Wurm herum.\n"
          +"Du hoffst nicht noch mehr Ungeziffer in dem Haufen\n"
          +"zu entdecken. Aber nein, Du hast Glueck. Ein beschriebener\n" 
          +"Zettel kommt zum Vorschein.\n");
    say(  this_player()->name(WER,2)+" graebt in dem Dreckshaufen und findet etwas.\n");
    return 1;
  }
  return 0;
}


int breche( string str )
{
  notify_fail( "Was willst Du AUFbrechen?\n" );
  if ( str == "falltuere auf" || str == "falltuer auf" || str == "luecke auf" || str == "tuer auf" ) {
    write(     "Nein, nein. Das Holz ist zu schade.\n"
          +"Du willst doch nicht Lostboys schoene Huette zerstoeren.\n");
    say(  this_player()->name(WER,2)+" wollte gerade Lostboys Inventar zerstoeren.\n");
    return 1;
  }
  return 0;
}

