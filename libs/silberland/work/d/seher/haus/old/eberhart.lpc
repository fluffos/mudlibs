inherit "std/room";

#include <properties.h>
#include <language.h>
#include "./def.h"
#define PlayerGender TP->QueryProp(P_GENDER)

create()
{
        ::create();

        SetProp( P_INT_SHORT, "Eberhart's Heiligtum" );
        SetProp( P_INT_LONG, BS(
                "Du stehst in einer geraeumigen Wohnhoehle. "
        +       "Dieser Raum gehoert offensichtlich einem Zwerg, da Dir "
        +       "sofort der typische Zwergenduft in die Nase steigt. "
        +       "Du siehst in der Mitte des Raumes einen Tisch stehen, auf "
        +       "dem eine Oellampe steht. Ausserdem siehst Du einen Kamin, "
        +       "ueber der in einem grossen Topf gemaechlich etwas vor sich "
        +       "hinbrodelt. Vor der Feuerstelle steht ein Schaukelstuhl.\n"));
        

        SetProp( P_LIGHT, 1 );
        SetProp( P_INDOORS, 1 );
	SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:25]));

  AddDetail( ({ "feuer" }), 
                break_string( "Das Feuer glimmt vor sich hin.", 78 ) );
  AddDetail( ({ "scheite" }), 
                break_string( "Ein paar Scheite liegen neben dem Kamin.", 78 ) );
  AddDetail( ({ "scheit" }), 
                break_string( "Ein paar Scheite liegen neben dem Kamin.", 78 ) );
  AddDetail( ({ "zwergeneintopf" }), 
                break_string( "Ja, die Bruehe schaut GENAU so aus wie "+
                "Zwergeneintopf.", 78 ) );
  AddDetail( ({ "eintopf" }), 
                break_string( "Die Bruehe schaut aus wie Zwergeneintopf.", 78 ) );
  AddDetail( ({ "bruehe" }), 
                break_string( "Sie schaut undefinierbar aus, am besten ist, "+
                "du laesst sie in Ruhe weiterkoecheln.", 78 ) );
  AddDetail( ({ "hoehlenwaende" }), 
                break_string( "Hm. Simple Waende in einer Hoehle.", 78 ) );
  AddDetail( ({ "waende" }), 
                break_string( "Eindeutig Hoehlenwaende.", 78 ) );
  AddDetail( ({ "feuerstelle" }), 
                break_string( "In der Feuerstelle glimmt Feuer langsam vor "+
                "sich hin.", 78 ) );
  AddDetail( ({ "hoehle", "wohnhoehle" }), 
                break_string( "Dies ist Eberharts Wohnhoehle.", 78 ) );
        AddDetail( "tisch",BS(
                "Der Tisch besteht aus Eiche, soweit Du das einschaetzen "
        +       "kannst. Er besitzt auch einige Schubladen. Auf dem Tisch "
        +       "liegt neben der Lampe auch ein Zettel.\n"));
        
        AddDetail( ({ "oellampe", "lampe" }), BS(
                "Die Lampe ist auf seltsame Art mit dem Tisch verbunden, "
        +       "will heissen, Du kannst sie nicht nehmen.\n"));
        
        AddDetail( ({ "schublade", "schubladen" }), BS(
                "Sie sind leider alle verschlossen.\n"));
        
        AddDetail( "zettel", BS(
                "Auf dem Zettel steht geschrieben:\n\n"
        +       "Dieser Raum ist mein Domizil. Jeder, der hier nur mal "
        +       "vorbeischauen will, ist herzlich wilkommen.\n"
        +       "An alle anderen: Wer auch nur das geringste Teil meiner "
        +       "Muenzsammlung oder sonst irgendetwas entfernt, ist des "
        +       "Todes!!!\n\n"
        +       "gez.: Krimm Eberhart der Muenzensammler\n"));
        
        AddDetail( ({ "schaukelstuhl", "stuhl" }), BS(
                "Der Schaukelstuhl ist auf Zwergengroesse zugeschnitten, "
        +       "und reichlich verziert. Wahrscheinlich sitzt hier der Bewohner "
        +       "des Abends oftmals vor dem Kamin und schwelgt in seinen "
        +       "Erinnerungen. Du kannst in ihm schaukeln.\n"));
        
        AddDetail( "Kamin", BS(
                "Im Kamin glimmt ein Feuer langsam vor sich hin. Du bist der "
        +       "Meinung, gleich einen Scheit nachlegen zu muessen, und tust "
        +       "dies auch sogleich.\n"));

        AddDetail( "topf", BS(
                "Mit dem Inhalt dieses Topfes koennte man fast eine ganze "
        +       "Bauernfamilie einige Tage durchfuettern. Wenn da nur nicht "
        +       "diese undefinierbare Bruehe drin waere. Du hast zwar schon "
        +       "viel von Zwergeneintopf gehoert, aber das hier schlaegt "
        +       "alle Rekorde.\n"));

        AddDetail( "schublade", BS(
                "Sie ist verschlossen, und kein Schluessel da.\n"));

        AddExit("osten", EBERHART); 
  
        AddCmd(({"schaukel", "schaukle"}), "schaukle");
  
}


schaukle (str)
{
  string rasse; 
  notify_fail("Worin willst Du schaukeln?\n");
  
   if (str == "in schaukelstuhl" || str == "in stuhl")
    {
      if ((rasse=TP->QueryProp(P_RACE)) != "Zwerg" &&
           (rasse=TP->QueryProp(P_RACE)) !="*zwerg*" )
        {

          write(BS("Der Stuhl fuer Zwerge konzipiert. Du als "+rasse
                  +" wirst da nicht reinpassen. Du brichst in Traenen aus.\n"));

          say(TPN+BS(" will sich in den Stuhl setzen. Aber da der Stuhl wohl nur "
                   +"fuer Zwerge geeignet ist, bricht "
                   +(PlayerGender==FEMALE ? "sie":"er")+" in Traenen aus.\n"));
          return 1;
        }
      write (BS("Du setzt Dich in den Stuhl und beginnst zu schaukeln. Uiiii- ist "
               +"das TOOLLLLLLLLLLLLLLL. Du quietschst vergnuegt.\n"));
    
      say (TPN+BS(" setzt sich in den Schaukestuhl und beginnt zu schaukeln. Es "
                 +"gefaellt "+(PlayerGender==FEMALE ? "ihr":"ihm")+" offenbar "
                 +"recht gut, denn "+(PlayerGender==FEMALE ? "sie":"er")+
                  " beginnt vergnuegt zu quietschen.\n"));
      return 1;
     }
  return 0;
}
