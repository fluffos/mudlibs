/// Palmwedel



inherit "std/thing";

#include <properties.h>

#include <language.h>

#include <combat.h>

#include "./def.h"


create()

{

   if(!is_clone(this_object())) return;

   ::create();





SetProp(P_NAME, "Palmwedel");

SetProp(P_LONG,"Ein echter Palmwedel aus dem Dschungel. Hierzulande echt praktisch "

	+"denn er spendet einen kuehlen Lutftzug, ");

SetProp(P_SHORT,"Ein Palmwedel");

SetProp(P_GENDER, MALE);

SetProp(P_WEIGHT, 20);

SetProp (P_MATERIAL, ({MAT_WOOD}));

SetProp(P_VALUE, 2);

AddId("palmwedel");



}
