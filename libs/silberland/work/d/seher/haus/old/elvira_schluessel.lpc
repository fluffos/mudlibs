inherit "std/thing";

#include <properties.h>

#include <language.h>

#include <defines.h>

#include <moredef.h>

#include <moving.h>



#include "./def.h"

#define ONLY_ELVIRA_SEHERHAUS "\nberx99"


///string only_elvira_seherhaus="\nich_gehoere_nur_in_elviras_seherhaus_und_sonst_nirgendstwo_hin";


/*

 erstmals_gestartet wird auf 1 gesetzt, Da QueraProp() schon _vor_ init()

 aufgerufen wird und deshalb das environment noch nicht gesetzt ist. 

 Derzeit wird durch die 'sekundenabfrage' verhindert, dass das oefters 

 aufgerufen wird. Doch ist mir das zu unsicher. deshalb werd ich mir da was 

 anderes ueberlegen ...

*/

int erstmals_gestartet=(1);

int last_time=(0);	// wann QP zum letzten mal aufgerufen wurde.



create()

{

  if (!is_clone(this_object())) return;

   ::create();

   SetProp(P_NAME, "Schluessel");

   SetProp(P_GENDER, MALE);

   SetProp(P_SHORT, "Ein grosser Eisenschluessel");

   SetProp(P_LONG, "Ein grosser Eisenschluessel. Ein Zettel haengt daran, "

        +"der besagt, dass die der Schluessel zu Elviras "

        +"Lieblingsraum ist. Wo sich der wohl befinden mag ?\n");

   SetProp(P_WEIGHT, 30);

   SetProp(P_VALUE, 0);

   AddId( ({"schluessel", ONLY_ELVIRA_SEHERHAUS}) );

}



int test()

{

  object *environ_list;

  int i;

  int ok;

  ok=0;



   if(erstmals_gestartet)

  {

        return 1;

  }



//  write("test\n");

  environ_list = all_environment(TO);

//  write(sizeof(environ_list)+"\n");

  for(i=0 ;i<sizeof(environ_list); i++)

  {

    if(environ_list[i]->QueryProp(P_INT_SHORT)=="In Elviras Strandhaus")

    {

      ok = 1;

    }

/*    else

    {

      write("dieses env taugt mir nicht \n");

    }

*/

  }

  if(ok)

  {

//        write("Eine Blume sagt:Hier gehoer ich hin.\n");

	return 1;

  }

  else

  {

	write("Sorry. falscher Raum.\n");

	call_out("remove",0);

	erstmals_gestartet = 1;

/* 

   Is notwendig, damit beim remove() test() nicht nochmalaufgerufen wird.

*/

	return 1;

  }

}





void init()

{

  erstmals_gestartet = 0;

//  write("Init -vor test\n");

  test();

//  write("init -nach test\n");

  last_time = time();

  return ::init();

}



mixed QueryProp(string name)

{

  int current_time;

//  write("Q.P.\n");

  if(last_time == current_time = time() )

  {

/*

  Diese sekunde schon getestet. das reicht :-)

*/

	return ::QueryProp(name);

  }

  else

  {

/*

Diese sekunde noch nicht getestet -> last_time updaten und testen

*/

	last_time = current_time;

	test();

	return ::QueryProp(name);

  }

}

