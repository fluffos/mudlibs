init() {
  ::init();
  if (member(visitors, getuid(TP))==-1) {
    visitors+=({getuid(TP)});
    saveload=visitors;
    save_object(SEHERHAUS GBOOK);
  }
}

reset() {
  ::reset();
  resetmoney++;
  resetmoney%=3;
}

/* -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    ausfuehrbare Funktionen
   -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- */

int lukefkt( string str ) {
  object obj;
  notify_fail( "Was willst Du denn oeffnen ?\n" );
  if ( str == "bodenluke" ) {
    this_player()->move(SEHERHAUS "zordan2", M_GO, 0,
      "verschwindet auf einmal", "erscheint ploetzlich");
    return 1;
  }
  if ( str == "schublade" ) {
    write( "Welche Schublade willst Du oeffnen ?\n");
    return 1;
  }
  if ( str == "linke schublade" || str == "linke Schublade" ) {
    write( "Du willst die linke Schublade oeffnen. Zu Deinem Entsetzen "
          +"ist sie aber\nabgeschlossen. So ein Pech.\n" );
    say(this_player()->name(WER,2)+" versucht die linke Schublade zu "
          +"oeffnen,\ngibt aber nach einiger Zeit enttaeuscht auf.\n" );
    return 1;
  }
  if ( str == "rechte schublade" || str == "rechte Schublade" ) {
    say(this_player()->name(WER,2)+" oeffnet die rechte Schublade.\n" ); 
    if ( !resetmoney ) {
      write( "Du oeffnest die rechte Schublade und es fallen Muenzen heraus.\n" );
      seteuid(getuid(this_object()));
      obj=clone_object("/obj/money");
      obj->SetProp(P_AMOUNT,random(5)+1);
      obj->move(this_object(),M_MOVE_ALL|M_NOCHECK);
      resetmoney++;
    }
    else {
      write( "Du oeffnest die rechte Schublade. Sie ist leider leer.\n" );
    }
    return 1;
  }
  return 0;
}

int setzen( string str ) {
  notify_fail( "WorAUF moechtest Du Dich setzen ?\n" );
  if ( str == "auf hocker" || str == "auf den hocker" ) {
    if  ( this_player()->name(WER,2) != "Zordan" ) {
      write( "Du setzt Dich auf den Hocker und auf einmal hoerst Du ein leises\n"
            +"Klicken. Im selben Moment katapultiert Dich der Hocker nach "
            +"Draussen.\n" );
      this_player()->move(ZORDAN, M_GO, 0,
        "wird vom Hocker nach Draussen katapultiert", "fliegt heran");
      return 1;
    }
    else {
      write("Du setzt Dich auf Deinen Hocker.\n");
      say(this_player()->name(WER,2)+" setzt sich auf seinen Hocker.\n" );
      return 1;
    }
  }
  return 0;
}

int sessel( string str ) {
  notify_fail( "WorEIN moechtest Du Dich kuscheln ?\n" );
  if ( str == "in sessel" || str =="sessel" || str == "in den sessel" ) {
    write("Du kuschelst Dich in den Sessel. Noch nie in Deinem Leben hast "
         +"Du Dich so\nwohl in einem Sessel gefuehlt !\n" );
    say(this_player()->name(WER,2)+" kuschelt sich in einen der Sessel. "
        +"Vielleicht solltest Du Dich mal\nlieber dazugesellen. Sonst "
        +"entgeht Dir sicher etwas !\n" );
    return 1;
  }
  return 0;
}

int spendieren( string str ) {
  string *tmp;
  object pl;
  int i,found;
  notify_fail("DU darfst hier nichts spendieren. Hole Zordan, der darf !\n");
  if ( this_player()->name(WER,2) != "Zordan" ) return 0;
  notify_fail("spendiere <spieler>\n");
  if (!str||str=="") return 0;
  tmp=explode(str," ");
  if (sizeof(tmp)<1) return 0;
  if ((!(pl=present(tmp[0],this_object()))
    && !(pl=present(tmp[0],this_player())))
    || !living(pl)) { write( capitalize(tmp[0]) + " ist nicht hier !!\n");
    return 1;
  }
  write("Du spendierst " + capitalize(tmp[0]) + " einen Schluck Whisky.\n" );
  say("Zordan spendiert " + capitalize(tmp[0]) + " einen Schluck des besten "
     +"Whiskys aus dem\nSilberland. Er zergeht so richtig auf der Zunge. Alle "
     +"wollen mehr.\n" , pl );
  tell_object( pl, "Zordan spendiert Dir etwas vom leckersten Whisky, den es im "
             +"Silberland gibt !\n" );
  return 1;
}

int legen( string str ) {
  notify_fail( "WorEIN moechtest Du Dich legen ?\n" );
  if ( str == "in bett" || str == "bett" ) {
    if  (this_player()->QueryProp(P_GENDER) == MALE
      && this_player()->Name(WER,2) != "Zordan" ) {
      write("Zordan mag keine Maenner in seinem Bett !\n");
      say(this_player()->name(WER,2)+ " versucht sich ins Bett zu legen. Doch "
         +"irgendetwas scheint ihn abzuhalten.\n" );
      return 1;
    }
    write("Du legst Dich in Zordan's Bett und fuehlst Dich sau wohl. So einen\n"
         +"Komfort hast Du nicht erwartet. Einfach gigantisch !!!\n" );
    say(this_player()->name(WER,2)+" legt sich in Zordan's Bett und fuehlt sich"
        +"sau wohl.\nDu moechtest Dich eigentlich dazulegen.\n" );
    return 1;
  }
  return 0;
}

int greifen( string str ) {
  notify_fail( "WorEIN moechtest Du greifen ?\n" );
  if ( str == "in feuer" ) {
    write("Du greist trotz aller Warnungen in das Feuer. Die Schmerzen sind "
         +"unbeschreiblich\ngross. Aber was ist das ? Die Schmerzen lassen "
         +"nach und Du kannst unter dem\nFeuer einen Ring erfuehlen !\n" );
    this_player()->reduce_hit_point(5);
    say(this_player()->name(WER,2)+" greift in's Feuer, faengt an zu "
         +"schreien und zieht die Hand wieder raus.\n" );
    return 1;
  }
  return 0;
}

int klettern( string str ) {
  notify_fail( "Ob man hier irgendwo klettern kann ?\n" );
  return 0;
}

int trinken( string str ) {
  string *temp;
  string farbe;
  string pl;
  notify_fail( "Was moechtest Du trinken/kosten ?\n" );
  if ( str == "whisky" ) {
    write("Du schaffst es nicht, die Karaffe zu oeffnen. Frag mal "
         +"lieber Zordan. " );
    say(pl+" versucht die Karaffe zu oeffnen.\n" );
    return 1;
  }
  if ( !str || str=="" ) return 0;
  temp=explode(str," ");
  if (sizeof(temp)<2) return 0;
  if ( temp[1] != "flasche" ) return 0;
  farbe=temp[0];
  pl=this_player()->name(WER,2);
  notify_fail( "Solch eine Flasche siehst Du hier nicht !\n" );
  switch (farbe) {
    case "rote" :
      write("Du trinkst von der roten Flasche. Es schmeckt so aehnlich wie "
           +"Tomaten.\nDu bist Dir sicher: das ist Tomatensaft.\n" );
      say(pl+" trinkt von der roten Flasche und verzieht das Gesicht.\n" );
      return 1;
    case "gruene" :
      write("Du trinkst von der gruenen Flasche. Dir wird fast schlecht, so "
           +"dermassen schlecht schmecjt das. Du uebergibst Dich.\n" );
      say(pl+" trinkt von der gruenen Flasche und uebergibt sich.\n" );
      return 1;
    case "weisse" :
      write("Du trinkst von der weissen Flasche. Sie schmeckt ausgezeichnet. "
           +"Sie enthaelt\neinen leckeren Kokuslikoer.\n" );
      say(pl+" trinkt von der weissen Flasche und strahlt.\n" );
      return 1;
    case "schwarze" :
      write("Du trinkst von der schwarzen Flasche.\n"
           +"Auf einmal wird Dir ganz schwarz vor Augen und Du faelltst um.\n"
           +"In diesem Moment kommt Lars auf Dich zu und meint:\n"
           +" ' In einem Seherzelt darf man nicht sterben'\n"
           +"Lars fuehrt Dich zu einer Tuer und schubs Dich durch.\n"
           +"Du weilst wieder unter den Lebenden.\n" );
      say(pl+" trinkt von der schwarzen Flasche und faellt tot um.\n"
            +"Nach einem kleinen Moment steht er aber wieder auf.\n");
      return 1;
    case "braune" :
      write("Du trinkst von der braunen Flasche. Es ist gewoehnlicher Whisky."
           +"Zwar kein\nbesonders guter, aber er schmeckt trotzdem ganz gut.\n" );
      say(pl+" trinkt von der braunen Flasche und grinst.\n" );
      return 1;
    case "gelbe" :
      write("Du trinkst von der gelben Flasche. IHhhhhhhhhhhhhh Das ist "
           +"ja Urin.\nDu spuckst es sofort wieder aus.\n" );
      say(pl+" trinkt von der gelben Flasche und spuckt sofort die\n"
           +"Fluessigkeit aus.\n" );
      return 1;
    case "orange" :
      write("Du trinkst von der orangenen Flasche. Dabei handelt es sich um "
           +"leckeren Saft.\nDu beschliesst Dir auch welchen zu besorgen.\n" );
      say(pl+" trinkt von der orangenen Flasche und schaut besorgt drein.\n" );
      return 1;
    case "blaue" :
      write("Du trinkst von der blauen Flasche. Huch, es schmeckt nach "
            +"Pflaumen. Muss wohl ein Pflaumenschnaps sein.\n" );
      say(pl+" trinkt von der blauen Flasche und freut sich.\n" );
      return 1;
    case "durchsichtige" :
      write("Du trinkst von der durchsichtigen Flasche. Dir wird ganz warm im "
           +"Koerper.\nUnd huch, Du siehst Deine Hand fuer kurze Zeit nicht "
           +"mehr !\n" );
      say(pl+" trinkt von der durchsichtigen Flasche und ist fuer einen kurzen "
            +"Moment\nnicht mehr zu sehen gewesen.\n" );
      return 1;
    case "ocker" :
      write("Du trinkst von der ockerfarbene Flasche. Der Geschmack ueberrascht "
           +"Dich.\nEs schmeckt eigentlich nach suessen Aepfeln.\n" );
      say(pl+" trinkt von der ockerfarbenen Flasche und bekommt dicke Pickel.\n"
            +"Du faellst um vor Lachen.\n" );
      return 1;
  }
  return 0;
}

string lesen()
{
  string buch, out;
  int i;

  out="Du liest das Gaestebuch von Zordan:\n"
  +" ________________________________________________________________________\n"
  +"/\n"
  +"Folgende Leute haben bisher mein Zelt betreten:\n";
  buch="";
  for (i=sizeof(visitors)-1; i>=0; i--)
    buch+=CAP(visitors[i])+(i==0?".":", ");
  out+=break_string(buch,78)
  +"\\________________________________________________________________________\n";

  say(this_player()->name(WER,2)+" liest das Gaestebuch von Zordan.\n" );

  return out;
}

