
/* -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-

    Das Seherhaus von Zordan.
    Solange Zordan noch ein Seher ist kann das Haus ja so im Silberland
    stehen bleiben. Sollte Zordan mal ein Magier werden verkauft er das
    Zelt an einen Haendler der es einem Schelm verkaufen mag.
    ( d.h. man kann den Namen 'Zordan' durch einen anderen veraendern
      und trotzdem als Detail im Silberland lassen - Vorschlag )

    Version 1.0 vom 21.09.1997

   -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- */

inherit "std/room";
#define GBOOK "zordan_gaestebuch"

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./def.h"

nosave int resetmoney;
nosave string *visitors;
mixed *saveload;

string lesen();

create()
{
  ::create();

  resetmoney=0;
  visitors=({});
  if (restore_object(SEHERHAUS GBOOK))
    visitors=saveload;
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_PLAIN]));

  SetProp( P_INT_SHORT, "Das Seherhaus von Zordan" );
  SetProp( P_INT_LONG,
    "Du befindest Dich jetzt im Seherhaus von Zordan. Eigentlich ist es "
    "ja ein Zelt, aber wer haelt sich schon an solchen Kleinigkeiten auf. "
    "Irgendwie beschleicht Dich das Gefuehl, dass der Innenraum ein wenig "
    "groesser ist als es von aussen scheint. Das Zelt ist nicht gerade "
    "super komfortabel ausgestattet, doch scheint es den Anforderungen eines "
    "Schelmes zu genuegen. Du siehst einen kleinen Schreibtisch an dem ein "
    "Hocker steht. Desweiteren befinden sich eine Menge Regale an den nicht "
    "vorhandenen Waenden. Fuer Gaeste hat Zordan eine gemuetliche Sitzecke "
    "mit drei riesig grossen Sesseln und einem Glastisch vorteilhaft in einer "
    "Ecke untergebracht. In deren Naehe ist auch eine kleine Bar. "
    "Ein kleines Bett steht sonst noch gelangweilt herum und ein paar Sachen "
    "fuer die Hygiene sind neben dem Bett in einem kleinen Schraenkchen "
    "untergebracht. Waerme bekommst Du hier durch die offene Feuerstelle in "
    "der Mitte des Zeltes. Der Fussboden besteht aus einfach geschnitzten "
    "Holzdielen. "
  );


/* -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    Gegenstaende im Raum
   -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- */

  AddItem(SEHERHAUS "zordan_haustier", REFRESH_DESTRUCT);

/* -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    sichtbare Ausgaenge
   -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- */

  AddExit( "raus", ZORDAN );

/* -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    ausfuehrbare Kommandos
   -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- */

  AddCmd( ({ "oeffne" }) , "lukefkt" );
  AddCmd( ({ "setze" , "setz" , "sitz" }) , "setzen" );
  AddCmd( ({ "kuschel", "kuschle"}) , "sessel" );
  AddCmd( ({ "spendiere" , "spendier" }), "spendieren" );
  AddCmd( ({ "lege", "lieg" }), "legen" );
  AddCmd( ({ "greife" , "greif" }), "greifen" );
  AddCmd( ({ "kletter" , "klettere" }), "klettern" );
  AddCmd( ({ "koste" , "trinke" , "trink" }), "trinken" );

/* -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    untersuchbare Details
   -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- */

  AddReadDetail(({"buch", "gaestebuch"}), #'lesen);

  AddDetail( ({ "stelle" , "moment" , "detail" , "details" ," forschen" ,
                "gegenteil" , "naehe" , "erforschen" , "last" , "graus" ,
                "menge" , "anhieb" , "mitte" , "schwanz" }),
    "Das ist doch kein Detail ..."
  );

  AddDetail( ({ "tafel" }),
    "Lies doch einfach."
  );

  AddDetail( ({ "buch" , "gaestebuch" }),
    "Das ist das Gaestebuch von Zordan. Jeder der sein Zelt betritt, wird "
    "automatisch aufgenommen. Lies es doch einfach mal !"
  );

  AddDetail( ({ "ring" }),
    "Als Du den Ring naeher betrachtest faellt Dir auf, dass es eher ein "
    "grosser Eisenring ist."
  );

  AddDetail( ({ "eisenring" }),
    "Der Eisenring ist komischerweise in den Boden eingelassen. Neben dem "
    "Eisenring kannst du einen Riss ertasten."
  );

  AddDetail( ({ "riss" }),
    "Der Riss ist gar kein Riss sondern es hebt sich eine quadratische "
    "Bodenluke hervor. "
  );

  AddDetail( ({ "bodenluke" }),
    "Ob man sie oeffnen kann ?"
  );

  AddDetail( ({ "fussboden" , "boden" }),
    "Der Fussboden besteht aus einfachen Holzdielen. "
  );

  AddDetail( ({ "holzdielen" , "dielen" }),
    "Die Holzdielen bestehen wie der Name schon sagt aus Holz. Sie sind "
    "ziemlich fachmaennisch ausgelegt, so dass nicht ein einziger Spalt "
    "oder Fuge zu sehen ist. Ansonsten faellt Dir noch auf, dass der "
    "Fussboden ziemlich sauber ist und nur hier und da ein kleines "
    "Staubkorn herumliegt. "
  );

  AddDetail( ({ "spalt" , "fuge" }),
    "Argl. Hoer auf damit !!!"
  );

  AddDetail( ({ "staubkorn" , "korn" }),
    "Auf dem Fussboden befindet sich nur sehr wenig Staub. Auch in dem "
    "gesamten Zelt ist eigentlich nur Unordnung, aber nur sehr wenig "
    "Staub zu sehen. "
  );

  AddDetail( ({ "unordnung" }),
    "Unordnung ja, Staub nein :-)"
  );

  AddDetail( ({ "staub" }),
    "Sehr wenig Staub ist in diesem Zelt. Das kann Zordan doch nicht selber "
    "gemacht haben. Ob er eine Reinemachefrau hat ? "
  );

  AddDetail( ({ "reinemachefrau" }),
    "Hm, seine kleine Dackeldame wedelt immer aufgeregt mit ihrem Schwanz. "
    "Ob deshalb hier kein Staub herumliegt ? "
  );

  AddDetail( ({ "feuerstelle" }),
    "Die Feuerstelle ist genau in der Mitte des Zeltes aufgebaut. Sie "
    "besteht aus einem Steinkreis in der eine kleines Feuer brennt. "
    "Ueber der Feuerstelle ist ein kleines Gestell angebracht. "
  );

  AddDetail( ({ "steinkreis" , "kreis" , "steine" }),
    "Um das Feuer herum sind ein paar grosse Steine gelegt, damit sich "
    "das Feuer nicht auf das Zelt ausbreiten kann. Das haette schliesslich "
    "verherende Folgen !"
  );

  AddDetail( ({ "folge" , "folgen" }),
    "Die Folge waere ja wohl, dass Zordan ein neues Zelt aufschlagen muesste. "
  );

  AddDetail( ({ "feuer" }),
    "Einige Holzstuecke brennen in diesem Feuer. Die Hitze die von dem "
    "Feuer ausgeht ist schier unglaublich. Du solltest besser nicht in "
    "das Feuer greifen. "
  );

  AddDetail( ({ "holzstuecke" }),
    "Viele der Holzstuecke sind schon runtergebrannt. Deshalb beschliesst Du "
    "einen neues dazuzulegen. Zordan wird sich freuen ! "
  );

  AddDetail( ({ "gestell" }),
    "Das Gestell ist ueber dem Feuer aufgebaut. An ihm haengt ein kleiner "
    "Topf. "
  );

  AddDetail( ({ "topf" }),
    "Hier bereitet Zordan wohl sein Essen vor. "
  );

  AddDetail( ({ "essen" }),
    "Im Moment ist leider nichts in dem Topf. Schade. "
  );

  AddDetail( ({ "hygiene" }),
    "Hier macht sich Zordan nach seinen Abenteuern immer sauber. Du siehst "
    "eine Menge Sachen in dem Schraenkchen. "
  );

  AddDetail( ({ "schraenkchen" }),
    "In diesem kleinen Schraenkchen bewahrt Zordan seine Sachen fuer die "
    "taegliche Hygiene auf. Das Schraenkchen ist mit 2 starken Eisenseilen "
    "an der Decke befestigt. Ansonsten besteht das Schraenkchen aus ganz "
    "normalem Holz. "
  );

  AddDetail( ({ "eisenseile" }),
    "Die beiden Eisenseile sind an der Holzplattfarom an der Decke und "
    "halten so das Schraenkchen, so dass es nicht herunterfallen kann. "
  );

  AddDetail( ({ "sachen" }),
    "Du findest in dem Schraenkchen Zahnputzzeug, Zahnseide, einen Lappen, "
    "Seife, einen Kamm, ein Handtuch und eine Schere. "
  );

  AddDetail( ({ "schere" }),
    "Eine gewaltige Schere. Mit ihr schneidet Zordan sich die Haare und "
    "seinen Bart. "
  );

  AddDetail( ({ "haare" }),
    "Du koenntest Deine auch mal wieder waschen ;)"
  );

  AddDetail( ({ "bart" , "windungen" }),
    "Zordan hat, wie es zu einem Schelm nunmal gehoert, einen netten "
    "Bart mit einigen Windungen. "
  );

  AddDetail( ({ "seife" }),
    "Komisch, die Seife besteht aus einer seltsamen Substanz. Sie ist irgendwie "
    "besonders hart und riecht eigentlich nach gar nichts. "
  );

  AddDetail( ({ "substanz" , "waschkraft" }),
    "Die Seife besteht aus magischen Stein. Dieser Stein laesst zwar richtige "
    "Seife entstehen, doch wird er nie weniger und hat besonders hohe "
    "Waschkraft. "
  );

  AddDetail( ({ "stein" }),
    "Du versuchst ihn weiter als einen Meter vom Schraenkchen wegzubekommen. "
    "Doch dann flutscht Dir der Stein auf einmal aus der Hand und landet "
    "wieder in dem Schraenkchen. "
  );

  AddDetail( ({ "kamm" }),
    "Huch, ein ganz normaler Kamm aus Hol z? Das kann doch nicht sein ! "
    "*wunder* "
  );

  AddDetail( ({ "handtuch" }),
    "An dem Handtuch erkennst Du auf Anhieb nichts besonderes. Allerdings "
    "faellt Dir auf, dass es wohl nie ganz nass gewesen sein kann. "
  );

  AddDetail( ({ "lappen" }),
    "Dieser Lappen ist ein ganz normaler Waschlappen, wie man ihn in jedem "
    "guten Haushalt findet. "
  );

  AddDetail( ({ "waschlappen" , "gedanke" }),
    "Ein Gedanke in Deinem Kopf bildet sich heraus: Bist Du einer und greifst "
    "Elsurion nicht an ??"
  );

  AddDetail( ({ "kopf" }),
    "Etwas rundlich, aber sinst ok ;)"
  );

  AddDetail( ({ "elsurion" }),
    "Ein netter aber gefaehrlicher Mann. Besuch ihn doch mal. "
  );

  AddDetail( ({ "zahnputzzeug" , "putzzeug" }),
    "Das Zahnputzzeug besteht aus einem kleinen Becher und einer Zahnbuerste. "
    "Zahncreme suchst Du vergeblich. "
  );

  AddDetail( ({ "becher" , "zahnputzbecher" }),
    "Der kleine Zahnputzbecher ist aus Metall gefertigt und enthaelt ein "
    "wenig Wasser. "
  );

  AddDetail( ({ "metall" , "Aluminium" }),
    "Dieser Becher ist aus Aluminium. "
  );

  AddDetail( ({ "wasser" }),
    "Als Du das Wasser untersuchst, schwappt ein wenig aus dem Becher heraus. "
    "Doch auf einmal fuellt sich der Becher !! Du denkst . o O ( Das muss "
    "Magie sein ) "
  );

  AddDetail( ({ "zahnseide" }),
    "Die Zahnseide benutzt Zordan wohl, um die Essensreste zwischen den Zaehnen "
    "nochmal richtig zu entfernen. "
  );

  AddDetail( ({ "essensreste" }),
    "Na bei Dir passiert das ja wohl auch mal, oder ?"
  );

  AddDetail( ({ "zaehne" , "zaehnen" }),
    "Du betrachtest Deine Zaehne in der aufgebrachten Eisenfolie im "
    "Schraenkchen und meinst: Boh, sind die gelb, ich sollte mir wohl auch "
    "lieber mal Zahnputzzeug besorgen. "
  );

  AddDetail( ({ "eisenfolie" }),
    "Die Eisenfolie ist an der Innenseite des Schraenkchens angebracht, um "
    "sich darin waehrend des Waschens ansehen zu koennen. Erschreckt musst "
    "Du feststellen, dass die Eisenfolie Dein Spiegelbild gar nicht umdreht !"
  );

  AddDetail( ({ "waschen" }),
    "Das tust Du ja wohl jeden Tag, oder ? "
  );

  AddDetail( ({ "spiegelbild" }),
    "Ui. die Eisenfolie dreht Dein Spiegelbild tatsaechlich nicht um ! Nach "
    "dem ersten Schrecken findest Du es aber eigentlich lustig Dich mal "
    "richtig herum zu sehen. "
  );

  AddDetail( ({ "schrecken" , "schreck" }),
    "Bu !"
  );

  AddDetail( ({ "bett" }),
    "Ein kuscheligges, kleines Bett mit rosarotem Laken und gruenem Bettzeug "
    "steht ein wenig abseits der uebrigen Moebel ziemlich einsam in der "
    "Gegend herum. Das Bett ist nicht gemacht. Zordan muss wohl mal wieder "
    "ziemlich hektisch zu einem Monster aufgebrochen sein oder einem seiner "
    "Freunde in der Not helfen muessen. Vielleicht laesst Zordan Dich ja "
    "mal kurz in seinem Bett probeschlafen ?"
  );

  AddDetail( ({ "laken" }),
    "Das Laken ist einfach nur rosarot, mehr nicht. "
  );

  AddDetail( ({ "bettzeug" }),
    "Im krassen Gegensatz zum Laken ist das Bettzeug in einem hellem "
    "Gruenton gehalten. Die wird fast uebel bei dem Anblick. "
  );

  AddDetail( ({ "anblick" , "gruenton" , "gegensatz" }),
    "Wiiiiiiiiiiderlich. "
  );

  AddDetail( ({ "moebel" , "rest" }),
    "Naja, halt der Rest der Bude :-)"
  );

  AddDetail( ({ "gegend" }),
    "Mit der Gegend ist hier eher das Zelt gemeint. "
  );

  AddDetail( ({ "monster" , "viecher" }),
    "Arg boese, dem Spieler zusetzende, grausame, meistens viel staerke, "
    "von Spieler verfluchte, Muenzen einbringe, Viecher im Silberland. "
    "Zordan mag eigentlich viel lieber durch das Silberland streifen, als "
    "ein Monster nach dem anderen umzulegen. "
  );

  AddDetail( ({ "muenzen" , "muenze" , "waehrung" }),
    "Die Waehrung im Silberland sind Muenzen. "
  );

  AddDetail( ({ "freunde" }),
    "Also Zordan hat inzwischen viele Freunde im Silberland gefunden. "
    "Wenn Du noch nicht zu denen gehoerst, dann frag ihn doch einfach mal, "
    "ob er nicht mit Dir zusammen ein paar Abenteuer erleben will. "
    "Ohne Freunde hast Du im Silberland KEINE Chance. "
  );

  AddDetail( ({ "abenteuer" }),
    "Hm, ueberall im Silberland findest Du welche. Auch dieses Zelt gehoert "
    "dazu. "
  );

  AddDetail( ({ "chance" }),
    "Normalerweise bekommt jeder eine 2. Allerdings wenn Du erst bei Lars "
    "bist, dann kann Dir leider auch keiner mehr helfen. Also lass es "
    "einfach nicht so weit kommen und mach gefaehrliche Abenteuer nie "
    "ohne gute Freunde !"
  );

  AddDetail( ({ "lars" }),
    "Hoffentlich lernst Du ihn nie kennen !!!"
  );

  AddDetail( ({ "not" , "hauptaufgabe" , "hauptaufgaben" }),
    "Eines von Zordan Hauptaufgaben besteht darin, Mitspielern in Not "
    "zu helfen. Allerdings ist er hier und da auf ein kleines Spaesschen "
    "aufgelegt. Hoffentlich nimmt ihm das keiner krumm. :-) "
  );

  AddDetail( ({ "naehe" }),
    "Gleich neben der Sitzecke siehst Du eine kleine Bar."
  );

  AddDetail( ({ "bar" }),
    "Die Bar besteht aus normalen Holz. In ihr befinden sich verschiedenfarbige "
    "Flaschen, eine Karaffe und eine Menge Glaeser. Auf der Bar ist eine kleine "
    "Tafel angebracht. "
  );

  AddReadDetail( ({ "tafel" }),
    "H\n"
    "Y Herzlich Willkommen " + this_player()->name(WER,2) + ", in meinem "
       "kleinen bescheidenem Zuhause.\n"
    "| Mach es Dir doch einfach gemuetlich und probier ein paar meiner "
       "Koestlichkeiten\n"
    "| an der Bar. Vielleicht gelingt es Dir ja auch mich anzutreffen. "
       "Dann plauschen\n"
    "| wir einfach mal ein wenig bei einem sehr feinem Whisky.\n"
    "|                                                Der Schelm Zordan\n"
"\\___________________________________________________________ _____ ___ __ _\n"
  );

  AddDetail( ({ "flaschen" }),
    "Du sieht Flaschen mit verschiedenfarbigen Inhalten: rot, gruen, weiss, "
    "schwarz, braun, gelb, orange, blau, durchsichtig und ocker. Du kannst sie "
    "entweder nur kosten oder trinken. Ganz wie Du magst. "
  );

  AddDetail( ({ "inhalte" }),
    "Du kannst die Art des Inhaltes der Flaschen nicht durch ansehen "
    "herausfinden ! Koste oder trinke sie doch einfach. "
  );

  AddDetail( ({ "karaffe" }),
    "Die Karaffe ist aus feinsten Kristall hergestellt und enthaelt eine "
    "braune Fluessigkeit, die Du durch riechen als Whisky "
    "identifizierst. Sie ist wohl fuer ganz besondere Gaeste gedacht und "
    "Du laesst sie daher unberuehrt stehen. "
  );

  AddDetail( ({ "fluessigkeit" , "whisky" }),
    "Auf der Karaffe siehst Du: 18 Jahre alt. "
  );

  AddDetail( ({ "glaeser" , "bedeutung" }),
    "Die Glaeser sind aus Glas. Sie haben keine weitere Bedeutung. "
  );

  AddDetail( ({ "glas" }),
    "Ganz normales Glas eben :) "
  );

  AddDetail( ({ "ecke" , "ecken" }),
    "Ups. Eine Ecke in einem Zelt ? Ja tatsaechlich ! In ihr befindet sich "
    "eine sehr gemuetlich aussehende Sitzecke mit drei Sesseln und einem "
    "Glastisch. "
  );

  AddDetail( ({ "glastisch" }),
    "In der Mitte zwischen den Sesseln und der Sitzecke befindet sich ein "
    "stilvoll gearbeiteter Glastisch. Er hat drei Tischbeine um ihn in jeder "
    "Position nicht wackeln zu lassen. Neben der mit Blumen gefuellten, "
    "kleinen Vase liegt ein Buch. "
  );

  AddDetail( ({ "tisch" }),
    "Welchen Tisch meinst Du ? Schreib- oder Glastisch ? "
  );

  AddDetail( ({ "tischbeine" }),
    "Die drei Beine sind aus hellbraunen Holz gefertigt. Du erkennst an ihnen "
    "nix besonderes. "
  );

  AddDetail( ({ "position" }),
    "Eine kleine Biende fluestert Dir zu: Ein Tisch mit drei Beinen steht "
    "immer wackelfrei. Wusstest Du das nicht ?"
  );

  AddDetail( ({ "blumen" }),
    "Die Vase ist mit verschiedensten Blumen aus dem Silberland gefuellt. "
    "Eine Blume kommt Dir ein wenig seltsam vor. "
  );

  AddDetail( ({ "blume" }),
    "Die Blume ist deshalb komisch, da sie nicht im Silberland zu finden ist. "
    "Sie schimmert weiss und seltsamerweise riecht sie nicht. Wo mag Zordan "
    "denn bloss diese Blume gefunden haben ?? Du findest keine Antwort und "
    "beschliesst, dass es sich um Magie handeln muss. "
  );

  AddDetail( ({ "antwort" }),
    "Natuerlich 42 :-)"
  );

  AddDetail( ({ "vase" , "porzellan" }),
    "Die Vase besteht aus feinstem Porzellan zwergischer Herkunft. Auf ihr "
    "sind witzige Figuren abgebildet."
  );

  AddDetail( ({ "herkunft" }),
    "Sie muss wohl von einem sehr alten und weisen Mann gemacht worden sein. "
  );

  AddDetail( ({ "figuren" }),
    "Du siehst auf der Vase verschieden Personen, die alle seltsam bunte "
    "Kleidung tragen. Erst jetzt bemerkst Du, dass viele verschiedene "
    "Schelme auf der Vase abgebildet sind. "
  );

  AddDetail( ({ "personen" , "schelme" }),
    "Du bist Dir sicher: Das ist die Ahnenreihe von Zordan. Du siehst "
    "mehr als 10 verschiedene Personen abgebildet. Eine davon soll wohl "
    "auch Zordan darstellen."
  );

  AddDetail( ({ "kleidung" }),
    "Wie auch alles in diesem Zelt sind die abgebildeten Schelme auf der "
    "vase sehr bunt ausstafiert."
  );

  AddDetail( ({ "sitzecke" , "ecke" , "sitz" , "sitzgruppe" }),
    "Die Sitzecke schaut sehr gemuetlich aus und ist wohl der Ort, wo sich "
    "Zordan am liebsten breitmacht. Sie besteht aus drei sehr gemuetlich "
    "aussehenden Sesseln und einer Garnitur, auf der bestimmt an die "
    "6 Gaeste Platz haben. Die Garnitur besteht aus einem bunten Stoff. "
  );

  AddDetail( ({ "ort" }),
    "Die Sitzecke ist ohne jeden Zweifel der gemuetlichste Ort in diesem "
    "Zelt. "
  );

  AddDetail( ({ "zweifel" }),
    "Mach es Dir doch einfach mal gemuetlich, dann wird auch der letzte "
    "Zweifel ausgeraeumt sein !"
  );

  AddDetail( ({ "platz" }),
    "Also wenn man naha aneinanderrueckt, dann passen auch 8 Gaeste drauf. "
  );

  AddDetail( ({ "sessel" }),
    "Die Sessel sind genauso wie die Garnitur aus buntem Stoff hergestellt. "
    "Sie sehen urgemuetlich aus. Vielleicht solltest Du Dich doch mal "
    "reinkuscheln. "
  );

  AddDetail( ({ "garnitur" , "teile" }),
    "Die Garnitur besteht aus 4 einzelnen Teilen, die zu einer Sitzgruppe "
    "zusammengefasst sind. Sie besteht aus buntem Stoff und sieht "
    "urgemuetlich aus. "
  );

  AddDetail( ({ "stoff" , "seide" }),
    "Die gesammte Sitzecke ist aus buntem Stoff gemacht. "
    "Du waescht Dir die Haende und faesst den Stoff an. Du stellst fest, "
    "dass es reinste Seide ist. Die Farben sind allerdings ziemlich "
    "durcheinandergewuerfelt und ergeben keinen Sinn. "
  );

  AddDetail( ({ "sinn" }),
    "Macht es Sinn den Sinn zu untersuchen ?"
  );

  AddDetail( ({ "gaeste" , "gast" }),
    "Du schaust in den Spiegel neben dem Eingang und stellst fest: Ja, ich "
    "bin ein Gast in Zordan's Zelt. "
  );

  AddDetail( ({ "spiegel" }),
    "Der Spiegel besteht aus feinstem Kristall und ist sehr schoen verarbeitet"
    ", wie es eigentlich nur Zwerge koennen. Dieses komische Funkeln in dem "
    "Material erinnert Dich aber irgendwie an etwas hier im Silberland. "
    "Rechts unten am Spiegel hat Zordan wohl ein kleines Symbol angebracht."
  );

  AddDetail( ({ "kristall" , "funkeln" , "material" }),
    "Das Funkeln im Kristall erinnert Dich irgendwie an den Kristallwald. "
    "Erst jetzt faellt Dir die Angabe des Herstellers auf: Es ist Eesthil. "
    "Irgendwie verwundert Dich das schon, da Eesthil ja eigentlich kein "
    "Zwerg ist. Aber das spricht eindeutig fuer das Koennen Eesthil's !"
  );

  AddDetail( ({ "eesthil" , "angabe" , "hersteller" }),
    "Na den findest Du doch im Kristallwald."
  );

  AddDetail( ({ "kristallwald" }),
    "Wer suchet der findet, wer nicht findet hat nicht gesucht. ;)"
  );

  AddDetail( ({ "symbol" }),
    "Du kannst es lesen."
  );

  AddReadDetail( ({ "symbol" }),
    "Bedien Dich ruhig an meiner Bar, Zordan."
  );

  AddDetail( ({ "waende" , "wand" }),
