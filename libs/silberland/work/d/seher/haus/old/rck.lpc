
#pragma strong_types

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "./def.h"

void create()
{
  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "rck Seherhaus" );
  SetProp( P_INT_LONG,
   "Du befindest Dich im Haeuschen von rck.\n"+
   "Hier ist es sehr seltsam. Du kommst Dir vor wie in einer anderen\n"+
   "Zeit. Koennte es sein das Du Dich im 21. Jahrhundert befindest?\n"+
   "Um Dich herum siehst Du Gestalten, die einen sehr mitgenommenen\n"+
   "Eindruck machen. Du siehst ein paar Buchstaben um Dich herum-\n"+
   "kreisen. Dunkelheit bricht ueber Dich ein.\n"
  );
  SetProp(P_INDOORS,1);
  AddDetail( ({ "buchstaben" }),
            "Sie drehen sich um Dich herum - wuerden sie das\n"+
            "nicht tun, koenntest Du darauf\n\n"+
            "           http://ag.or.at/~rkiesler\n\n"+
            "lesen, keine Ahnung, was das soll.\n");
  AddDetail( ({ "dich", "dir" }),
            "Ich wuesste gerne mehr ueber Dich...\n"+
            "Schreibe doch einfach eine Mail an rck!\n");
  AddDetail( ({ "ahnung" }),
            "Lass' Dir halt was einfallen! ;-)\n");
  AddDetail( ({ "gestalten" }),
            "Waehrest Du im 21. Jahrhundert geboren, wuerdest.\n"+
            "Du glatt annehmen, das waehren Junkies.\n" );
  AddDetail( ({ "jahrhundert"}),
            "Hier siehts aus wie im 21. Jahrhundert, auch wenn\n"+
            "Du davon keine Ahnung hast....\n" );
  AddDetail( ({ "junkies" }),
            "Hmmm. Junkie. Was ist das?" );
  AddDetail( ({ "raum", "arbeitsraum" }),
             "Du befindest Dich mittendrin.\n" );
  AddDetail( ({ "boden", "fussboden" }),
             "Der schwarze Boden hier sieht sehr duester aus.\n" );
  AddDetail( ({"rck"}),
             "Er hat dieses Haeuschen gebaut.\n" );
  AddDetail( ({"haeuschen"}),
             "Fuer ein Haus hats irgendwie nicht gereicht.\n" );
  AddDetail( ({"haus"}),
             "Ich bin einigen Leuten sehr dankbar fuer die\n"+
             "Moeglichkeit, hier ein kleines Seherhaeuschen\n"+
             "zu bauen.\n" );
  AddDetail( ({"seherhaeuschen"}),
             "Gefaellt es Dir? (-> Mail)\n");
  AddDetail( ({"moeglichkeit"}),
             "War ein ziemlicher Aufwand...\n");
  AddDetail( ({"aufwand"}),
             "Bis ich da was bekommen habe... (-> Mail)\n");
  AddDetail( ({"leute"}),
             "Insbesonders dankt rck Akira, Feyaria und Woody.\n"+
             "Und selbstverstaendlich noch Muaddib. Und allen\n"+
             "anderen. Und Dir, dass Du Dir das Haus ansiehst.\n" );
  AddDetail( ({"muaddib"}),
             "Ein echt netter Kerl.\n");
  AddDetail( ({"kerl"}),
             "So viel ich weiss ist er ein Kerl. Er koennte aber\n"+
             "auch ein Maedchen sein... Wer weiss? ;-)\n");
  AddDetail( ({"maedchen"}),
             "MUAD'DIB heisst so was wie 'Der Auserwaehlte'\n");
  AddDetail( ({"auserwaehlte"}),
             "Jaja... Ein Auserwaehlter...\n");
  AddDetail( ({"feyaria"}),
             "Sie ist echt cool. Ihr 'Haus' ist neben dem Arbeits-\n"+
             "zimmer des Gouverneurs in Tijara.\n" );
  AddDetail( ({"arbeitszimmer"}),
             "Der Gouverneur schwimmt in Buechern und Zetteln.\n");
  AddDetail( ({"buecher", "zetteln", "zettel"}),
             "Schau halt selber nach!\n"); 
  AddDetail( ({"gouverneur"}),
             "Er hat ein Rattenproblem.\n");
  AddDetail( ({"rattenproblem"}),
             "Frage doch einfach mal den Gouverneur danach!\n");
  AddDetail( ({"tijara"}),
             "Du befindest Dich in Tijara. Glaubst Du zumindest.\n" );
  AddDetail( ({"akira"}),
             "Ich habe noch immer den Geschmack des koestlichen Eises\n"+
             "auf der Zunge, zu dem mich Akira einmal eingeladen hat.\n");
  AddDetail( ({"eis"}),
             "Du weisst schon. Eis. Das kalte Zeug zum Schlecken.\n" );
  AddDetail( ({"schlecken"}),
             "Mit der Zunge drueber fahren. Zufrieden?\n" );
  AddDetail( ({"zunge"}),
             "Mit ihr kann man einige interessante Sachen machen....\n" );
  AddDetail( ({"sachen"}),
             "Zum Beispiel... Hmmm... Denk selber darueber nach.\n" );
  AddDetail( ({"beispiel"}),
             "Ein Beispiel. Also gut. Kuessen. Waere ohne Zunge nur\n" +
             "halb so lustig. Meiner Meinung nach.\n" );
  AddDetail( ({"kuessen"}),
             "Tja... Kuessen... Eine sehr angenehme Taetigkeit.\n" );
  AddDetail( ({"taetigkeit"}),
             "Was machst Du gerade? (-> Mail)\n" );
  AddDetail( ({"meinung"}),
             "Was meinst Du dazu? (-> Mail)\n" );
  AddDetail( ({"zeug"}),
             "Phew. Du bist ein harter Brocken.\n" );
  AddDetail( ({"brocken"}),
             "Ich schreibe mir hier die Finger wund, und Du schaust,\n"+
             "und schaust und schaust...\n");
  AddDetail( ({"finger"}),
             "Sie sind ganz wund. Meine zumindest.\n" );
  AddDetail( ({"woody"}),
             "Von ihm weiss ich nicht viel. Frage ihn doch selber!\n");
  AddDetail( ({"dunkelheit"}),
             "rck liebt es dunkel. Schwarz.");
  AddDetail( ({"schwarz"}),
             "rck's Lieblingsfarbe. rck waehre gerne ein Grufti, aber\n"+
             "irgendwie klappts damit nicht so richtig. Vielleicht\n"+
             "kannst Du mir dabei helfen?\n");
  AddDetail( ({"lieblingsfarbe"}),
             "rck's Lieblingsfarbe ist Schwarz. Eventuell in Kombination\n"+
             "mit Magenta (Violett)");
  AddDetail( ({"magenta", "violett"}),
             "Fuer mich sehr wichtig und wertvoll.\n" );
  AddDetail( ({"kombination"}),
             "Fuer mich ist die Kombination als solche eine sehr wichtige\n"+
             "Sache. Das Leben macht zB alleine gar keinen Spass.\n");
  AddDetail( ({"leben"}),
             "Mein Leben hatte schon viele Tiefpunkte. Momentan versuche\n"+
             "ich, mit irgendwie durchzuschlagen.\n");
  AddDetail( ({"tiefpunkte"}),
             "Darauf moechte ich jetzt nicht eingehen. (-> Mail)\n"); 
  AddDetail( ({"sache"}),
             "Meine Lieblingszahl ist 2.\n");
  AddDetail( ({"lieblingszahl"}),
             "Zu zweit geht alles besser... Zwei ist die kleinste\n"+
             "Primzahl. Doppelt haelt besser.\n");
  AddDetail( ({"primzahl"}),
             "Eine Zahl, die nur durch sich selbst und 1 teilbar ist\n");
  AddDetail( ({"zahl"}),
             "Eine Kombination aus Ziffern\n");
  AddDetail( ({"ziffern"}),
	     "0, 1, 2, 3, 4, 5, 6, 7, 8 und 9\n");
  AddDetail( ({"zeit"}),
	     "Sie verrinnt viel zu schnell.\n");
  AddDetail( ({"mail"}),
	     "Schreibe einfach an rck...\n");
  AddDetail( ({"eindruck"}),
	     "Sie liegen regungslos herum.\n");
  AddDetail( ({"leute", "leuten"}),
	     "Insbesondere Akira, Feyaria, Muaddib und Woody.\n");
  AddDetail( ({"spass"}),
	     "Fuer mich unentbehrlich.\n");
  AddDetail( ({"grufti"}),
	     "Gruftis rule.\n");


  AddExit("raus", RCK);
}



