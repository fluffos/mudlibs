#pragma strong_types

inherit "/obj/container";

#include <properties.h>
#include <language.h>
#include "./def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT,"Eine Eichentruhe");
  SetProp(P_LONG,break_string(
  "Eine alte, schwere Eichentruhe, die wohl noch aus der Werkstatt "
  "des Sivaoaners Rakal stammt.",78));
  SetProp(P_NAME,"Truhe");
  AddId(({"truhe","eichentruhe"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_OAK);
  SetProp(P_NOGET, "Was willst Du denn noch alles mit Dir rumschleppen?\n");
  SetProp(P_MAX_WEIGHT, 20000);
}

