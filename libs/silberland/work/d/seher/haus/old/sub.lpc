//----------------------------------------------------------------------------
  AddReadDetail( ({ "verpackung", "tafel" }),
    "Feinste Schweizer Vollmilchschokolade.\n"
    "Zutaten:\n"
    "Zucker, Kakaobutter, Vollmilchpulver, Butterreinfett, Molkepulver,\n"
    "Magermilchpulver, Emulgator: Sojalecithin, Malzextrakt.\n"
    "Inhalt: 100g.\n");
