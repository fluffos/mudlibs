// Commands
//----------------------------------------------------------------------------
  AddCmd( ({ "iss" , "esse" }) , "essen" );
  AddCmd( ({ "trink" , "trinke"  }) , "trinken" );
  AddCmd( ({ "lies" , "lese" }) , "lesen" );
  AddCmd( ({ "schreib" , "schreibe" }) , "schreiben" );
  AddCmd( ({ "setz" , "setze" }) , "setzen" ); 
  AddCmd( ({ "drueck" , "druecke" }) , "druecken" ); 
}

int essen( string str ) {
  notify_fail( "Was moechtest Du essen?\n" );
  if ( str == "schokolade" || str == "tafel" ) {
    write("Als Du die Tafel in die Hand nimmst, kommst du drauf, dass gar "
         +"nichts mehr drin ist. Dabei hast Du Dich sooo auf die Schokolade "
         +"gefreut... Dir kommen vor lauter Enttaeuschung fast die Traenen. "
         +"Wie gemein von Subsonic, Dir nichts uebrigzulassen! Am liebsten "
         +"wuerdest Du jetzt ganz boese und gemein zu ihm sein... \n" );
    say(this_player()->name(WER,2)+" nimmt eine Tafel Schokolade und schaut "
         +"auf einmal ganz deprimiert drein. \n" );
    return 1;
  }
  return 0;
}

int trinken( string str ) {
  notify_fail( "Was moechtest Du trinken?\n" );
  if ( str == "limonade" || str == "himbeerlimonade" || str == "flasche" ) {
    write("Du nimmst einen grossen Schluck aus der Flasche und verziehst das "
         +"Gesicht. Die Limonade ist so suess, dass sie Dir fast am Gaumen "
         +"klebenbleibt, und die Unmengen an Kohlensaeure bringen Dich fast "
         +"zum Niesen. Jetzt hast Du noch mehr Durst als vorher... \n" );
    say(this_player()->name(WER,2)+" trinkt einen Schluck Limonade, verzieht "
         +"das Gesicht und faengt beinahe zu niesen an. \n" );
    return 1;
  }
  return 0;
}

int setzen( string str ) {
  notify_fail( "Wohin moechtest Du Dich setzen?\n" );
  if ( str == "auf sofa" ) {
    write("Du nimmst Anlauf und wirfst Dich in das Sofa. Sofort versinkst du "
         +"tief in den weichen Polstern. \n" );
    say(this_player()->name(WER,2)+" versinkt in den weichen Polstern des "
         +"Sofas. \n" );
    return 1;
  }
  return 0;
}

//----------------------------------------------------------------------------
// Das ist jetzt ziemlich ungeschickt programmiert, ich wusste es aber
// nicht besser... Also: Je nach Zustand der Variable taste werden ein paar
// Details und Sounds ueberschrieben.
//----------------------------------------------------------------------------

int druecken( string str ) {
  notify_fail( "Was moechtest Du denn druecken?\n" );
  if ( str == "taste" || str == "auf taste" ) {
    if ( taste == 0 ) {
      write("Du drueckst auf eine grosse Taste links unten. Ploetzlich hoerst Du "
           +"ein lautes Knacksen, aber sonst passiert nichts. Gerade willst Du "
           +"erleichtert aufatmen, als ploetzlich die Anzeigen auf den Geraeten "
           +"zum Leben erwachen und der ganze Raum zu beben beginnt. Du hoerst "
           +"und fuehlst eine seltsame Musik, die gar nicht zu den ueblichen "
           +"Liedern der Elfen passen will... \n" );
      say(this_player()->name(WER,2)+" drueckt eine Taste auf einem der "
           +"Geraete. Es knackst laut. Du glaubst schon, es wuerde nichts weiter "
           +"passieren, als ploetzlich der Raum zu beben beginnt. Du hoerst "
           +"und fuehlst eine seltsame Musik, die gar nicht zu den ueblichen "
           +"Liedern der Elfen passen will... \n" );

      AddSound( DEFAULT_SOUND,
        "Der ganze Raum bebt im Rhythmus einer Musik, die von einer anderen "
        +"Welt zu kommen scheint. ");
      AddSound( ({ "musik" }),
        "Die Musik laesst sich schwer beschreiben. Sie ist gekennzeichnet durch "
        +"treibende Baesse, Zirpen, Fiepen, Breaks, Beats, Vibes ;) ");

      AddDetail( ({ "quader" }),
        "In jeder Raumecke steht ein seltsamer Quader auf dem Regal. Sie scheinen "
        +"die Musik zu erzeugen, die den Raum erfuellt");
      AddDetail( ({ "vorderseite" }),
        "An der Vorderseite siehst Du Anzeigen und Tasten. Sie leuchten und "
        +"blinken mit der Musik um die Wette. In einer der Anzeigen siehst Du "
        +"drei Buchstaben. ");
      AddDetail( ({ "wuerfel" }),
        "Genau in der Mitte des Raumes steht ein schwarzer Wuerfel. Er besteht "
        +"aus Holz und seine Kantenlaenge misst ungefaehr dasselbe wie Dein "
        +"Arm. Der Wuerfel scheint fuer das Beben des Raumes verantwortlich zu "

        +"sein, denn als Du ihn beruehrst, fuehlst Du starke Vibrationen im "
        +"Rhythmus der Musik. Dir fallen dir einige Loecher in einer Seitenwand "
        +"des Wuerfels auf. ");
      AddDetail( ({ "loecher", "loch", "roehre", "roehren" }),
        "Bei naeherer Betrachtung entpuppen sich die Loecher als drei Roehren, "
        +"die nebeneinander angeordnet sind und ins Innere des Wuerfels fuehren. "
        +"Du haeltst die hand vor die Roehren und bemerkst einen Lufthauch, der "
        +"andauernd seine Staerke aendert und aus dem Inneren des Wuerfels kommt. ");
     AddDetail( ({ "tasten", "taste" }),
       "An der Vorderseite befinden sich viele Tasten. Wenn Du vor der Musik "
       +"am liebsten davonlaufen wuerdest, kannst Du sie ja per Tastendruck "
       +"abschalten... ");
     AddDetail( ({ "musik" }),
       "Schon einmal mit lauschen probiert? ");
     taste = 1;
        }
    else {

      write("Du drueckst auf eine grosse Taste links unten. Die Musik verstummt. "
            +"Erleichtert atmest Du auf... \n" );

      say(this_player()->name(WER,2)+" drueckt eine Taste auf einem der "
           +"Geraete. Die seltsame Musik verstummt. Irgendwie bist Du erleichtert... \n" );

      AddSound( DEFAULT_SOUND,
        "Ausser dem Rascheln der Blaetter draussen hoerst Du nichts.");
      AddSound( ({ "musik" }),
        "Musik? Das muss Du Dir einbilden, denn im Moment ist nichts zu "
        +"hoeren. Es koennte jedoch eine Moeglichkeit geben, hier Musik "
        +"anzuhoeren... ");

      AddDetail( ({ "quader" }),
        "In jeder Raumecke steht ein seltsamer Quader auf dem Regal. Du "
        +"kannst Dir ihre Funktion nicht erklaeren, aber irgendetwas sagt Dir, "
        +"dass sie etwas mit den Geraeten und dem Wuerfel in der Mitte des Raumes "
        +"zu tun haben... ");
      AddDetail( ({ "vorderseite" }),
        "An der Vorderseite siehst Du Anzeigen und Tasten. Sie scheinen inaktiv "
        +"zu sein. In einer der Anzeigen leuchten Dir drei Buchstaben entgegen. ");
      AddDetail( ({ "wuerfel" }),
        "Genau in der Mitte des Raumes steht ein schwarzer Wuerfel. Seine "
        +"Kantenlaenge misst ungefaehr dasselbe wie Dein Arm. Du klopfst mit dem "
        +"Finger gegen den Wuerfel und stellst fest, dass er aus hartem Holz "
        +"besteht. Dabei fallen dir einige Loecher in einer Seitenwand des "
        +"Wuerfels auf. ");
      AddDetail( ({ "loecher", "loch", "roehre", "roehren" }),
        "Bei naeherer Betrachtung entpuppen sich die Loecher als drei Roehren, "
        +"die nebeneinander angeordnet sind und ins Innere des Wuerfels fuehren. "
        +"Du fragst Dich wozu das gut sein soll. Du hast das Gefuehl, dass der "
        +"Wuerfel mit den vier Quadern und den Geraeten im Regal in Zusammenhang "
        +"steht. ");
      AddDetail( ({ "tasten", "taste" }),
        "An der Vorderseite befinden sich viele Tasten. Du kannst ja "
        +"versuchen, eine zu druecken... ");
      taste = 0;
      }
    return 1;
  }
  return 0;
}

//----------------------------------------------------------------------------
// Und jetzt noch so ein dummer Einfall: Mein Sofa fungiert als Gaestebuch
// Die Namen werden in der Datei "sofa.txt" gespeichert.
// Leider funktioniert die Abfrage, ob ein Spieler schon eingetragen ist,
// noch nicht :(
//----------------------------------------------------------------------------
int lesen( string str ) {
  string a;
  restore_object(LOGFILE);
  a = implode(namen,", ");
  notify_fail( "Was moechtest Du lesen ?\n" );
  if ( str == "sofa" || str == "schrift" || str == "schriften" || str == "beschriftung" || str == "namen" || str == "name" ) {
    
    write ( "Du liest die Schriften auf dem Sofa.\n"
    +"Folgende Leute haben sich auf Subsonics Sofa verewigt: \n"
    +BS(a) );
    say(this_player()->name(WER,2)+" liest die Schriften auf Subsonics Sofa. \n");
    return 1;
  }
  return 0;
}



int schreiben( string str ) {
  restore_object(LOGFILE);  
  notify_fail( "Was moechtest Du wohin schreiben?\n" );
  if ( str == "name auf sofa" || str == "namen auf sofa" || str == "name" || str == "sofa" ) 
  {
	if ( member(namen,capitalize(getuid(TP))) ==-1)
	{
		write("Du nimmst den Stift und schreibst Deinen Namen auf das Sofa. "
		   +"Subsonic wird sich darueber freuen ;) \n" );
		say(this_player()->name(WER,2)+" schreibt was auf Subsonics Sofa. "
		   +"Vielleicht solltest Du das auch versuchen... \n" );
		namen+=({capitalize(getuid(TP))});
		write_file( "/d/kristallwald/sargola/log/sub-sofa.log", capitalize(getuid(TP))+", ");
		//save_object(LOGFILE);
		return 1;
	}
	else
	{
		write("Du hast Dich doch schon einmal eingetragen.\n");
		return 1;
	}

  }
  return 0;
}

