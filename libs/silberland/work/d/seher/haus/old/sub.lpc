//----------------------------------------------------------------------------
// ---=== SuBSoNiCs Seherhaus ===--- Version0.9 ;)
//----------------------------------------------------------------------------
#include "./def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>                 

#define LOGFILE "/d/kristallwald/sargola/log/sub-sofa.log"

//----------------------------------------------------------------------------
// Variable taste, sorgt fuer guten Sound (oder auch nicht) ;)
//----------------------------------------------------------------------------
int taste = 0;

string * namen;


create()
{
  ::create();
  if(!restore_object(LOGFILE))
	namen = ({});


//----------------------------------------------------------------------------
// Properties
//----------------------------------------------------------------------------
  SetProp( P_INT_SHORT, "Subsonics' Seherhaus" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich im Seherhaus von Subsonic. Es ist sehr hell und warm "
    +"hier drin. Du erkennst sofort, warum: Eine Wand und die Decke bestehen "
    +"aus Glas, das von einer aufwendigen Holzkonstruktion gehalten wird. "
    +"An den uebrigen Waenden stehen Regale mit vielen Buechern und auch "
    +"einige Poster haengen da. Du siehst ein gemuetliches Sofa, neben dem "
    +"einige Sachen auf dem Teppichboden verstreut herumliegen. In der Mitte "
    +"des Raumes steht ein seltsamer Wuerfel. ") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

//----------------------------------------------------------------------------
// Details
//----------------------------------------------------------------------------
  AddDetail( ({ "seherhaus", "haus", "raum", "hier", "beschreibung" }),
    "Du befindest Dich im Seherhaus von Subsonic. Es ist sehr hell und warm "
    +"hier drin. Du erkennst sofort, warum: Eine Wand und die Decke bestehen "
    +"aus Glas, das von einer aufwendigen Holzkonstruktion gehalten wird. "
    +"An den uebrigen Waenden stehen Regale mit vielen Buechern und auch "
    +"einige Poster haengen da. Du siehst ein gemuetliches Sofa, neben dem "
    +"einige Sachen auf dem Teppichboden verstreut herumliegen. In der Mitte "
    +"des Raumes steht ein seltsamer Wuerfel. ");
  AddDetail( ({ "decke", "wand" }),
    "Die Decke und eine der vier Waende sind aus dickem Glas gefertigt. Eine "

    +"aufwendige Holzkonstruktion traegt die einzelnen Scheiben. Die Sonne "
    +"scheint herein und gibt dem Raum eine warme, gemuetliche Atmosphaere. ");
  AddDetail( ({ "waende", "aussenwand", "aussenwaende" }),
    "Drei Waende sind weiss gestrichen und mit Postern behaengt. Die vierte "
    +"Wand besteht aus Glas.");
  AddDetail( ({ "glas", "scheiben", "glasscheiben", "isolierglas" }),
    "Dickes Isolierglas, damit die Waerme drinnen und die Kaelte draussen "
    +"bleibt. Du fragst Dich woher Subsonic das Glas hat... Vielleicht aus "
    +"dem Kristallwald? ");
  AddDetail( ({ "kristallwald" }),
    "Kennst Du den Kristallwald nicht? Du befindest Dich mittendrin! ");
  AddDetail( ({ "waerme", "kaelte" }),
    "Durch den Treibhaus-Effekt ist es hier drinnen merklich waermer als "
    +"draussen. ");
  AddDetail( ({ "treibhaus-effekt" }),
    "Treibhaus-Effekt... Eh schon wissen... Muss ich das jetzt wirklich "
    +"erklaeren? ");
  AddDetail( ({ "sonne" }),
    "Die Sonne scheint herein und laechelt Dich an. Du freust dich und "
    +"laechelst zurueck. ");
  AddDetail( ({ "atmosphaere" }),
    "Die Atmosphaere hier drin ist hell, warm und gemuetlich. ");
  AddDetail( ({ "holz" }),
    "Viele Dinge hier bestehen aus Holz. Du musst schon genauer " 
    +"beschreiben, was Du meinst... ");
  AddDetail( ({ "holzkonstruktion" }),
    "Eine Holzkonstruktion, bestehend aus Stuetzen, Balken und "
    +"Verstrebungen traegt die Glasscheiben. ");
  AddDetail( ({ "stuetzen", "stuetze", "balken", "verstrebungen" }),
    "Die Stuetzen, Balken und Verstrebungen sind Teile der "
    +"Holzkonstruktion. ");
  AddDetail( ({ "dinge", "ding" }),
    "Welches Ding genau meinst du? ");
  AddDetail( ({ "regale", "buecherregale", "regal", "buecherregal" }),
    "An den Waenden stehen hohe und niedrige Buecherregale aus Kiefernholz. "
    +"Auf den Regalbrettern stehen und liegen Buecher und andere, seltsame "
    +"Gegenstaende. ");
  AddDetail( ({ "kiefernholz" }),

    "Die Regale sind aus Kiefernholz gefertigt. ");
  AddDetail( ({ "regalbretter" }),
    "Die Regalbretter sind in verschiedener Hoehe im Regal befestigt. Das "
    +"Ganze erinnert Dich an ein bekanntes schwedisches Moebelhaus. ");
  AddDetail( ({ "buecher", "buch" }),
    "Die Buecher stehen in langen, ungeordneten Reihen im Regal. Du wuerdest "
    +"wahrscheinlich Jahre brauchen, um alle zu lesen, soviele sind es. "
    +"Subsonic scheint sie gern zu lesen, denn einige Exemplare gehen schon "
    +"aus dem Leim. ");
  AddDetail( ({ "exemplare", "exemplar" }),
    "Einige der Buecher sind schon so zerlesen, dass die einzelnen Seiten "
    +"herausfallen. Du laesst sie lieber im Regal stehen. Vielleicht findest "
    +"Du woanders was zum Lesen. ");
  AddDetail( ({ "seiten" }),
    "Du musst aufpassen, dass die Seiten nicht aus den Buechern fallen.");
  AddDetail( ({ "gegenstaende", "gegenstand" }),
    "Ausser den Buechern fallen Dir noch einige "
    +"uebereinandergestapelte Geraete und vier seltsame Quader auf. ");
  AddDetail( ({ "quader" }),
    "In jeder Raumecke steht ein seltsamer Quader auf dem Regal. Du "
    +"kannst Dir ihre Funktion nicht erklaeren, aber irgendetwas sagt Dir, "
    +"dass sie etwas mit den Geraeten und dem Wuerfel in der Mitte des Raumes "
    +"zu tun haben... ");
  AddDetail( ({ "ecke", "raumecke" }),
    "In jeder Raumecke fallen Dir seltsame, in den Regalen stehende Quader "
    +"auf. ");
  AddDetail( ({ "geraet", "geraete" }),
    "Du siehst Dir die Geraete im Regal naeher an. Sie sind "
    +"uebereinander gestapelt und scheinen zusammenzugehoeren. An der "
    +"Vorderseite bemerkst Du viele Tasten und Anzeigen. Irgendwie kommt Dir "
    +"das sehr bekannt vor. ");
  AddDetail( ({ "vorderseite" }),
    "An der Vorderseite siehst Du Anzeigen und Tasten. Sie scheinen inaktiv "
    +"zu sein. In einer der Anzeigen leuchten Dir drei Buchstaben entgegen. ");
  AddDetail( ({ "buchstaben" }),
    "Hast du es schon mit lesen probiert?");
  AddDetail( ({ "tasten", "taste" }),
    "An der Vorderseite befinden sich viele Tasten. Du kannst ja "
    +"versuchen, eine zu druecken... ");
  AddDetail( ({ "anzeigen", "anzeige" }),
    "Drei Buchstaben leuchten Dir verheissungsvoll entgegen... ");
  AddDetail( ({ "funktion" }),
    "Hmmm... Vielleicht solltest Du Dir die Geraete im Regal naeher "
    +"anschauen. ");
  AddDetail( ({ "fm4" }),
    "FM4 ruleZ... ;)");
  AddDetail( ({ "wuerfel" }),
    "Genau in der Mitte des Raumes steht ein schwarzer Wuerfel. Seine "
    +"Kantenlaenge misst ungefaehr dasselbe wie Dein Arm. Du klopfst mit dem "
    +"Finger gegen den Wuerfel und stellst fest, dass er aus hartem Holz "
    +"besteht. Dabei fallen dir einige Loecher in einer Seitenwand des "
    +"Wuerfels auf. ");
  AddDetail( ({ "arm", "arme" }),
    "Du betrachtest nachdenklich Deinen kraeftigen Arm und laesst Deine "
    +"starken Muskeln spielen... ;)");
  AddDetail( ({ "finger" }),
    "Du ueberlegst, ob Du Deine Finger zaehlen sollst, laesst es aber dann "
    +"doch bleiben.");
  AddDetail( ({ "kantenlaenge", "kanten" }),
    "Die Kanten des Wuerfels sind ungefaehr so lang wie Dein Arm.");
  AddDetail( ({ "loecher", "loch", "roehre", "roehren" }),
    "Bei naeherer Betrachtung entpuppen sich die Loecher als drei Roehren, "

    +"die nebeneinander angeordnet sind und ins Innere des Wuerfels fuehren. "
    +"Du fragst Dich wozu das gut sein soll. Du hast das Gefuehl, dass der "
    +"Wuerfel mit den vier Quadern und den Geraeten im Regal in Zusammenhang "
    +"steht. ");
  AddDetail( ({ "seitenwand", "seitenwaende" }),
    "Zusammen bilden die Seitenwaende einen schwarzen Wuerfel in der Mitte "
    +"des Raumes. ");
  AddDetail( ({ "mitte", "raummitte" }),
    "Genau in der Mitte des Raumes befindet sich ein schwarzer Wuerfel.");
  AddDetail( ({ "poster", "sailormoon-poster" }),
    "Du siehst fuenf knallbunte SailorMoon-Poster mit Darstellungen von "
    +"Usagi, Ami, Makoto, Rei und Minako. Deine schlimmsten Befuerchtungen "
    +"bestaetigen sich: Subsonic ist ein Moonie ;)");
  AddDetail( ({ "darstellungen", "kriegerinnen", "anime-zeichnungen", 
"zeichnungen" }),
    "Die Poster zeigen Anime-Zeichnungen von den Sailormoon-Kriegerinnen. ");
  AddDetail( ({ "sofa" }),
    "Das weisse Sofa ist mit schwarzer Schrift beschrieben. Es sieht zwar "
    +"etwas abgewetzt und durchgesessen, aber seeeehr gemuetlich aus. Du "
    +"kannst dich draufsetzen. ");
  AddDetail( ({ "schrift", "beschriftung", "namen" , "name" }),
    "Das Sofa ist mit Namen beschriftet. Du kannst sie lesen. Wenn Du willst, "
    +"kannst Du Deinen Namen dazuschreiben... ");
  AddDetail( ({ "polster", "polsterung" }),
    "Die Polsterung des Sofas sieht wirklich sehr weich aus. ");
  AddDetail( ({ "sachen" }),
    "Neben dem Sofa liegen einige Sachen auf dem Boden verstreut. "
    +"Du erkennst eine Flasche, einen Stift und etwas, das "
    +"wie eine angebrochene Tafel Schokolade aussieht. ");
  AddDetail( ({ "teppichboden", "boden" }),
    "Der Boden des Raumes ist mit einem weissen Teppichboden ausgelegt. ");
  AddDetail( ({ "flasche" }),
    "Die Flasche enthaelt eine knallrote sprudelnde Fluessigkeit. Sieht aus "
    +"wie Himbeerlimonade. ");
  AddDetail( ({ "fluessigkeit", "himbeerlimonade", "limonade" }),
    "Die sprudelnde knallrote Fluessigkeit in der Flasche sieht aus wie "
    +"Himbeerlimonade. Du kannst sie trinken. ");
  AddDetail( ({ "knallrot", "farbe" }),
    "Das Knallrot der Limonade ist so intensiv, dass es Dir in die Augen "
    +"sticht. Der Farbe nach zu urteilen muss die Limonade sehr suess sein. "
    +"Die sprudelnde Aktivitaet in der Flasche weist auf sehr viel "
    +"Kohlensaeuregehalt hin. ");
  AddDetail( ({ "kohlensaeure", "kohlensaeuregehalt", "gehalt" }),
    "Die Kohlensaeure bringt die Limonade in der Flasche zum Sprudeln. ");
  AddDetail( ({ "tafel", "schokolade", "verpackung" }),
    "Auf der Verpackung steht 'Feinste Schweizer Vollmilchschokolade'. Dir "
    +"laeuft sofort das Wasser im Mund zusammen. Am liebsten wuerdest du "
    +"gleich die ganze Tafel auffuttern... Du versuchst verzweifelt, der "
    +"Versuchung zu widerstehen. Du koenntest ja ein kleines Stueck davon "
    +"essen... Subsonic nimmt Dir das sicher nicht uebel... ");
  AddDetail( ({ "stueck" }),
    "Du kannst gerne ein Stueck der Schokolade essen, wenn Du Lust hast... ");
  AddDetail( ({ "stift" , "filzstift" }),
    "Ein wasserfester Filzstift. Wenn Du willst, kannst Du damit Deinen Namen "
    +"auf das Sofa schreiben. ");

