//----------------------------------------------------------------------------
  AddSmell( ({ "limonade", "flasche", "himbeerlimonade", "fluessigkeit" }),
    "Du schnupperst an der Flasche Himbeerlimonade und stellst fest, dass sie "
    +"intensiv nach Himbeeren riecht... ");
  AddSmell( DEFAULT_SMELL,
    "Du kannst nur den typischen Geruch von Kiefernholz wahrnehmen.");

  AddSound( DEFAULT_SOUND,
    "Ausser dem Rascheln der Blaetter draussen hoerst Du nichts.");

