// Thor@SilberLand
// Gonzo's Seherhaus
// 1997-03-17

#include "./def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Gonzo's Seherhaus" );
  SetProp( P_INT_LONG, BS(
    "Du bist hier im Seherhaus von Gonzo. Es macht auf den ersten Blick einen "
   +"wirklich gemuetlichen Eindruck. Das Haus ist komfortabel eingerichtet, "
   +"obwohl es teilweise ein wenig unordentlich ist, mit einem Wort, es ist so "
   +"richtig wohnlich. Durch die grossen Fenster dringen die warmen Sonnenstrahlen "
   +"ins Innere des Hauses. Du fuehlst Dich wirklich wohl hier und moechtest am "
   +"liebsten auch so ein Haus haben. In der linken, hinteren Ecke steht ein Kasten, "
   +"daneben haengt ein grosses Schild an der Wand. An der rechten Wand steht ein "
   +"Regal mit einer tollen Hi-Fi Anlage. In der rechten Ecke liegen Gonzo's NIKE "
   +"Basketballschuhe. In der "
   +"Mitte des Raumes steht ein Holztisch mit vier Stuehlen rundherum und am Boden "
   +"liegt ein grosser Teppich. Alles hier ist so richtig knuddelig, sodass Du Lust "
   +"hast, Dich hier noch etwas naeher umzuschauen.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20]) );

  AddDetail( ({ "seherhaus", "haus" }),
              QueryProp(P_INT_LONG));
  AddDetail( "gonzo",
             "Gonzo ist ein knuddeliger Seher hier im SilberLand. Vielleicht laedt "
            +"er Dich ja mal zu einem kleinen Plausch hier ein. Du stehst hier "
            +"uebrigens gerade in seinem Haus, so nebenbei.");
  AddDetail( "seher",
             "Gib \"hilfe seher\" ein, und Du weisst mehr :)");
  AddDetail( ({"plausch", "talk", "small-talk"}),
             "Gonzo kann manchmal recht geschwaetzig sein. Fang doch einfach mal einen "
            +"Small-Talk mit ihm an.");
  AddDetail( ({"blick", "eindruck"}),
             "Auch auf den zweiten Blick ist der Eindruck wirklich gemuetlich.");
  AddDetail( "einrichtung",
             "Die Einrichtung besteht aus einem Kasten in der linken, hinteren Ecke, "
            +"einem Tisch mit ein paar Stuehlen und einem Regal mit einer Hi-Fi Anlage "
            +"an der rechten Wand.");
  AddDetail( "fenster",
             "Die Fenster sind gross, sodass sie viel Sonne in das Innere des Hauses lassen "
            +"und alles hell und freundlich wirkt.");
  AddDetail( ({"sonne", "sonnenstrahlen", "strahlen"}),
             "Die Sonne scheint warm und angenehm durch die grossen Fenster ins Haus herein.");
  AddDetail( ({"inneres", "innere"}),
             "Das Innere des Hauses wird von warmen Sonnenstrahlen erhellt.");
  AddDetail( ({"ecke", "ecken"}),
             "Ja, ein Haus das hat normalerweise vier davon.");
  AddDetail( ({"kasten", "hormonkasten"}),
             "Das ist Gonzo's Hormonkasten. Wenn Gonzo's Hormone wieder einmal verrueckt "
            +"spielen, hat er da einige Utensilien drinnen, die ihm helfen, dass er sich "
            +"wieder einkriegt.");
  AddDetail( "hormone",
             "Davon hat Gonzo leider etwas zuviel. Daher ja auch der Hormonkasten, um Gonzo's "
            +"Hormone im Zaum zu halten.");
  AddDetail( "utensilien",
             "Es ist unhoeflich, weiter in dieser Richtung nachzuforschen. Das geht nur "
            +"Gonzo allein etwas an.");
  AddDetail( "schild",
             "Wie waers, wenn Du versuchst, das Schild zu lesen?");
  AddDetail( "regal",
             "Auf dem Regal steht eine Hi-Fi Anlage. Daneben liegt ein Stapel Rap-CDs und "
            +"einige Zeitschriften und Buecher.");
  AddDetail( ({"hi-fi anlage", "anlage"}),
             "Du findest Gonzo's Hi-Fi Anlage wirklich toll und wirst schon ganz gruen vor "
            +"Neid. Am liebsten wuerdest Du sie sofort einschalten, um auszuprobieren, ob "
            +"sie auch so gut groovt, wie sie aussieht.");
  AddDetail( ({"stapel", "cds", "CDs", "rap-cds"}),
             "Neben der Hi-Fi Anlage steht ein Stapel Rap-CDs. Gonzo mag diese Musik "
            +"anscheinend sehr gerne. Vielleicht kannst Du Dir ja mal eine von ihm "
            +"ausleihen, wenn Du ihn ganz lieb darum bittest."); 
  AddDetail( ({"musik", "rap"}),
             "Scheinbar hoert Gonzo gerne Rap-Musik.");
  AddDetail( "zeitschriften",
             "Diverse Zeitschriften ueber Sport, Musik und ... Maedchen!!! ... liegen "
             "auf dem Regal neben der Hi-Fi Anlage herum.");
  AddDetail( "buecher",
             "Einige Buecher ueber die verschiedensten Sachen stapeln sich auf dem Regal.");
  AddDetail( "sachen",
             "Auf dem Regal liegen die verschiedensten Sachen herum.");
  AddDetail( "basketball",
             "Mannschaftssport, in dem fuenf Spieler pro Mannschaft versuchen, einen Ball - "
            +"genannt Basketball - in den gegnerischen Korb zu werfen. Lexikon Eintrag Ende.");
  AddDetail( "korb",
             "Notwendig, beim Basketball.");
  AddDetail( ({"mannschaftssport", "sport"}),
             "Ja, Basketball ist so etwas. Das heisst, dass man dabei in der Regel ins Schwitzen "
            +"kommt.");
  AddDetail ( "lexikon",
              "Wenn Du wirklich nicht weisst, was das ist, bist Du selber schuld.");
  AddDetail( "runde",
             "Ja, eine Runde Basketball waere jetzt wirklich ganz lustig...");
  AddDetail( ({"NIKE", "nike"}),
             "Irgend so eine komische Firma, die Schuhe macht. Sie muss irgendwo in Midas sein.");
  AddDetail( "midas",
             "Hauptstadt des Silberlandes.");
  AddDetail( "silberland",
             "Eigentlich gehoere hier eine Skriptfalle her."); 
  AddDetail( ({"falle", "skriptfalle"}),
             "Bin ehrlich gesagt zu faul, eine zu proggen.");
  AddDetail( ({"schuhe", "basketballschuhe"}),
             "In der rechten, hinteren Ecke stehen NIKE Basketballschuhe. Gonzo scheint gerne "
            +"Basketball zu spielen. Sie sind schon etwas "
            +"ausgelatscht, er scheint sie gerne zu tragen. Einer der beiden Schuhe sieht "
            +"allerdings irgendwie etwas merkwuerdig aus.");
  AddDetail( "schuh",
             "Du nimmst den Schuh in die Hand und betrachtest ihn genauer. Dabei faellt Dir auf, "
            +"dass die Sohle etwas sonderbar erscheint - anders, als man es bei einem Schuh "
            +"erwarten wuerde.");
  AddDetail( "sohle",
             "Du tastest ein wenig auf der Sohle herum, da faellt Dir eine klitzekleine "
            +"Vertiefung in der Ferse auf.");
  AddDetail( "ferse",
             "In der Ferse ist eine klitzekleine Vertiefung.");
  AddDetail( "vertiefung",
             "Die Vertiefung ist genau so gross wie ein Daumen. Vielleicht solltest Du mal "
            +"versuchen, in die Vertiefung hineinzudruecken.");
  AddDetail( "mitte",
             "In der Mitte des Raumes steht ein Tisch mit vier Stuehlen rund herum.");
  AddDetail( ({"tisch", "holztisch"}),
             "In der Mitte des Raumes steht ein grosser, massiver Tisch der aus blitzblank "
            +"polierten Eichenholz gezimmert ist.");
  AddDetail( "raum",
             "Du stehst mitten drinnen.");
  AddDetail( "eichenholz",
             "Der Holztisch besteht aus massiven Eichenholz.");
  AddDetail( "stuehle",
             "Die Stuehle bestehen, wie auch der Tisch, aus massivem Holz. Hier bewirtet "
            +"Gonzo seine Gaeste.");
  AddDetail( ({"gaeste", "gast"}),
             "Das bist Du hier gerade.");
  AddDetail( "holz",
             "Der Tisch, die Sessel und auch der Boden sowie Waende und Decke sind aus Holz.");
  AddDetail( "boden",
             "Der Boden ist aus Holz. Er ist sauber gekehrt und es liegt ein poppiger Teppich "
             "am Boden.");
  AddDetail( "teppich",
             "Auf dem Teppich sind bunte, lustige Muster. Er ist ganz weich und gefaellt Dir "
            +"sehr gut.");
  AddDetail( ({"muster", "symbole"}),
             "Die Muster am Teppich kann man nicht eindeutig identifizieren. Es sind bunte, "
            +"ineinander verschlungene Symbole.");
  AddDetail( ({"wand", "waende"}),
             "An den Waenden haengen einige Fotos und Poster");
  AddDetail( ({"fotos", "poster"}),
             "Die Waende sind mit Poster von Michael Jordan tapeziert.");
  AddDetail( ({"michael", "jordan", "michael jordan"}),
             "Einer von Gonzo's Idolen.");
  AddDetail( "decke",
             "Die Decke ueber Dir besteht aus Holzbalken.");
  AddDetail( ({"balken", "holzbalken"}),
             "Die Decke besteht aus grossen, massiven Holzbalken.");
             
  AddReadDetail( "schild" ,
    "                                 \n"
   +"      -------------------        \n"
   +"     /                   \\       \n"
   +"    /     --------        \\      \n"
   +"   /     /       /         \\     \n"
   +"  /     / NO    /    /\\     \\    \n"
   +" /     /       /    /  \\     \\   \n"
   +"|     |       /    /   |     |   \n"
   +"|     | SMOK /    /ING |     |   \n"
   +"|     |     /    /     |     |   \n"
   +"|     |    /    /      |     |   \n"
   +"|      \\  /    / HERE /      |   \n"
   +" \\      \\/    /      /      /    \n"
   +"  \\          /      /      /     \n"
   +"   \\         -------      /      \n"
   +"    \\                    /       \n"
   +"     \\                  /        \n"
   +"       -----------------        \n"  
  );

/*  AddSound( DEFAULTSOUND,
    "");
    
  AddSmell( DEFAULTSMELL,
    "");
*/
  AddCmd( ({"druecke", "drueck"}), "vertiefung" );
  AddCmd( ({"schalte", "schalt"}), "radio");

  AddExit( "raus", GONZO);
}

vertiefung (str)
{
  notify_fail("Was willst Du druecken?\n");
  if(str=="in vertiefung"||str=="in vertiefung hinein")
    { 
    write(BS("Du drueckst in die Vertiefung in der Sohle des Turnschuhes hinein und "
            +"Dich ueberkommt ploetzlich ein ganz sonderbares Gefuehl...\n"));
    say(BS(CAP_TPN+" drueckt ein wenig am Basketballschuh herum und ist ploetzlich "
          +"verschwunden.\n"));
    TP->move(SEHERHAUS "gonzo2",M_TPORT);
    return 1;
    }
  else
    return 0;
}

radio (str)
{
  notify_fail("Was willst Du einschalten?\n");
  if(str=="anlage ein"||str=="hi-fi anlage ein")
    {
    write(BS("Du schaltest die Hi-Fi Anlage ein und sogleich erfuellt ein "
            +"ohrenbetaeubender Rap-Sound den Raum ... "));
    say(BS(CAP_TPN+" schaltest die Hi-Fi Anlage ein und sogleich erfuellt ein "
            +"ohrenbetaeubender Rap-Sound den Raum ... "));
    call_out("boom",4);
    call_out("boom",6);
    call_out("boom",8);
    
    call_out("rest",10);
    return 1;
  }
  else
    return 0;
}

boom ()
{
  tell_room(TO, "BOOM ... \n");
}

rest ()
{
  tell_room(TO, BS(
    "Du erschrickst fuerchterlich, als ein paar Disco-Girls aus dem Nichts "
    +"erscheinen und zu singen beginnen:\n\nGONZO, GONZO, he's the man! All "  
    +"the girls want the GONZOMAN! Go-ho-ho-honzomaaaan!\n\nGanz verwirrt "
    +"schaltest Du die Anlage lieber gleich wieder ab, bevor noch jemand von "
    +"den Nachbarn gestoert wird. Sogleich verschwinden auch die Disco-Girls "
    +"wieder wie durch ein Wunder.\n"));
}

