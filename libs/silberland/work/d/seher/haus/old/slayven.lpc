inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./def.h"

#define bs( x ) break_string( x, 78 )
#define BETT(wer) (member(bett, getuid(wer))!=-1)
string *bett=({});

string d_uhr();
int kaminofen=0;
int holztruhe=0;
int steintruhe=0;

create()
{
  ::create();
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Slayvens Domizil" );
  SetProp( P_INT_LONG,
	   "Dies ist das Seherhaus von Slayven. \n"
	   + "Sie ist sehr schoen hobbitmaessig eingerichtet. Schoene Naturfarben " 
	   + "praegen das Gesamtbild. Die Mitte des Raumes wird von einem riesigem Altar "
	   + "dominiert. An der Nordwand steht ein hoechst komfortables Bett. "
	   + "Der Kaminofen an der Suedwand spendet angenehme Waerme. "
	   + "Neben dem Kaminofen stehen ein Tisch und zwei Sessel. "
           + "Im Osten kannst Du drei Truhen erkennen und im Westen steht eine "
           + "Bar und ein riesiger Kuehlschrank.\n" 
	   + "Eine Tuer fuehrt wieder nach draussen.\n");
  
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_HOUSE]) );

  AddSpecialDetail( ({"slayven"}), "slayven_weg");
  AddSpecialDetail( ({ "ofen", "kaminofen", "kamin" }), "kamin_an"); 
  AddSpecialDetail( ({"bett"}), "schau_bett");
  AddSpecialDetail( ({"feuer"}), "feuer_da");
  AddSpecialDetail( ({"holztruhe"}), "holztruhe");
  AddSpecialDetail( ({"steintruhe"}), "steintruhe");
  
  AddDetail( ({"eisentruhe"}), 
	     "Die Eisenruhe ist mit einem Symbol und einer Inschrift verziert.\n"
	     + "Ausserdem besitzt sie ein riesiges Goldschloss.\n"); 
  AddDetail( ("waerme"),
	     "Der Kaminofen spendet eine angenehme Waerme.\n");
  AddDetail( ("metallplatten"),
	     "Der Kaminofen ist aus soliden schwarzen Metallplatten gebaut.\n");
  AddDetail( ("metall"),
	     "Ein schwarzes Metall.\n"); 
  AddDetail( ("ecke"),
	     "Da stehen ein Kuehlschrank und eine Bar.\n");
  AddDetail( ("kuehlschrank"),
	     "Ein riesiger Kuehlschrank (so wie es sich fuer einen Hobbit gehoert) steht "
	     + "an der Westwand. Der muss Unmengen von Nahrungsmitteln fassen koennen.\n"); 
  AddDetail( ({ "portal", "portale" }), 
	     "Das Portal fuehrt in Andyls Soundstudio.\n" );
  AddDetail( ({ "soundstudio", "studio", "andyls", "andyl" }),
	     "Wenn Du das Portal durchschreitest kommst Du in Andyls Soundstudio.\n" );
  AddDetail( ("gesamtbild"),
             "Das Gesamtbild ist von schoenen Naturfarben gepraegt.\n");
  AddDetail( ({"naturfarben", "farben"}),
             "Hier siehst du viele Naturfarben. Vor allem gruen und weiss.\n");
  AddDetail( ("raum"),
             "Der Raum in dem Du stehst, ist Slayvens Reich.\n");
  AddDetail( ("reich"),
             "In diesem Reich ist Slayven der Herrscher.\n");
  AddDetail( ("mitte"),
             "In der Mitte des Raumes stehen ein riesiger Altar.\n");
  AddDetail( ("tisch"),
             "Der Tisch ist aus solidem Eichenholz. "
	     + "Auf ihm ist ein Tischtuch ausgebreitet und eine Blumenvase steht darauf.\n");
  AddDetail( ({"tuch", "tischtuch"}),
             "Das Tischtuch ist aus einem wiederstandsfaehigen Stoff mit einem Karomuster darauf.\n");
  AddDetail( ("stoff"),
             "Der Stoff sieht sehr wiederstandsfaehig aus.\n");
  AddDetail( ("karomuster"),
             "Ein einfaches schwarz weisses Karomuster.\n"
	     + "Hey, darauf koennte man ja Schach spielen.\n");
  AddDetail( ("schach"),
             "Theoretisch waere es moeglich auf dem Tischtuch Schach zu spielen.\n");
  AddDetail( ({"vase", "blumenvase"}),
             "In der schwarzen Blumenvase sind ein paar wunderschoene Blumen.\n"
	     + "Nur seltsam, dass Du nicht eine dieser Blumen kennst.\n");
  AddDetail( ("blumen"),
             "Als du die Blumen naeher untersuchst, merkst Du, dass es keine echten sind "
	     + "sondern magische Hologramme. Slayven hat wahrscheinlich keine Lust auf Blumengiessen.\n"
	     + "Jetzt wird Dir klar, warum Dir keine der Blumen bekannt war.\n");          
  AddDetail( ("hologramme"),
             "Magische Hologramme in der Form von Blumen.\n");
  AddDetail( ("blumengiessen"),
             "Sag bloss sowas machst Du freiwillig !\n");
  AddDetail( ("domizil"),
	     "Das ist Slayvens Domizil.\n");
  AddDetail( ("freunde"),
             "Slayven hat einen grossen Freundeskreis. Gehoerst du dazu?\n");
  AddDetail( ("herrscher"),
             "Eine Stimme droehnt Dir ploetzlich im Ohr.\n"
	     +  "\n"
	     +  "** Slayven ist der wahre Herrscher! Huldigt Slayven! **\n"
	     +  "\n"); 
  AddDetail( ({"schild", "holzschild"}),
             "Du kannst es lesen.\n");
  AddDetail( ("sessel"),
             "Da stehen ein Ebenholzsessel und ein Seidensessel. Beide laden zum damit schaukeln ein.\n");
  AddDetail( ("ebenholzsessel"),
             "Ein Sessel aus Ebenholz mit einem weissen Anstrich.\n");
  AddDetail( ("anstrich"),
             "Ein strahlend weisser Anstrich.\n");
  AddDetail( ("weiss"),
	     "Was fuer ein schoenes Weiss!\n");
  AddDetail( ("seidensessel"),
             "Dieser Sessel ist gepolstert und mit feinster weisser Seide ueberzogen.\n");
  AddDetail( ("ebenholz"),
             "Ein wahrhaft edles Holz.\n");
  AddDetail( ("seide"),
             "Wohl eines der edelsten Stoffe. Das sanfte Weiss der Seide wirkt aeussert" 
	     + " angenehm auf Dich.\n"); 
  AddReadDetail( ("schild"),
		 " \n "  
		 + "Dieses Haus wurde mit freundlicher\n"
		 + "                  Unterstuetzung von AnDyL erbaut.\n"
		 + "                                                   \n");      
  AddDetail( ("nordwand"),
             "Da steht ein grosses Bett. Ausserdem haengt dort ein kleines Holzschild. \n"); 
  AddDetail( ("ostwand"),
             "Da stehen drei Truhen. Ausserdem ist dort eine Tuer.\n");
  AddDetail( ("westwand"),
             "An der Westwand steht ein riesiger Kuehlschrank und eine Bar.\n");
  AddDetail( ("suedwand"),
             "An der Suedwand stehen ein Kaminofen, ein Tisch und zwei Sessel.\n"
	     + "Ausserdem haengt dort eine Kuckusuhr.\n");
  AddDetail( ({"riesig", "riesiger"}),
             "So ein riesiger Kuehlschrank. Dir bleibt bei dem Anblick der Mund offen.\n");
  AddDetail( ("anblick"),
             "Was fuer ein Anblick. Du staunst.\n");
  AddDetail( ("truhen"),
             "Da stehen eine Eisentruhe, eine Holztruhe und eine Steintruhe.\n"); 
  AddDetail( ("hobbit"),
             "Du stehst in der Wohnung von einem.\n");
  AddDetail( ("Wohnung"),
             "Du stehst gerade in Slayvens Wohnung.\n");
  AddDetail( ("stimme"),
             "Sie hoerte sich unheimlich an.\n");
  AddDetail( ("aura"),
             "Als Du die Aura naeher untersuchst klingen auf einmal mystische Toene an Dein Ohr.\n"
	     + "Klarer Fall, hier war AnDyL im Spiel.\n");
  AddDetail( ("eisentruhe"),
             "Die Truhe ist mit einem Symbol und einer Inschrift verziert.\n"
	     + "Ausserdem besitzt die Truhe ein riesiges Goldschloss.\n"); 
  AddDetail( ("symbol"),
             "Das Symbol zeigt einen Hobbit mit einer gezueckten Tequilaflasche dem "
	     + "ein Hustinettenbaer folgt. Wer kann das wohl sein ?\n");
  AddDetail( ("inschrift"),
             "Du kannst sie lesen.\n");
  AddReadDetail(("inschrift"),
		"\n"
		+ "Geld ist nicht alles im Leben. Aber habe stets genug davon.\n"
		+ "\n"
		+ "                                 Weisheit eines Hobbitmillionaers\n"
		+ "\n");  
  AddDetail( ({ "schloss", "goldschloss" }),
             "Das Goldschloss ist fuer jeden Sterblichen unknackbar.\n");  
  AddDetail( ({"sterbliche","sterblicher"}),
             "Alle die sterben koennen, sind sterblich.\n");
  AddDetail( ({ "boden", "fussboden", "holzboden" }),
	     "Es ist ein solider Holzboden.\n" );
  AddDetail( ({ "waende" }),
	     "Die Waende sind in einem sanften natuerlichem Gruenton gehalten.\n" );
  AddDetail( ({ "wand" }),
             "Welche meinst du ? Die Nordwand, die Ostwand, die Suedwand oder die Westwand.\n");
  AddDetail( ({ "decke" }),
             "Die Decke besteht aus einfachen Holzlatten. Eine Lampe haengt an ihr.\n");
  AddDetail( ("lampe"),
             "Die Lampe spendet ein angenehmes Licht.\n");
  AddDetail( ("licht"),
             "Ohne Licht, waer man im Dunkeln !\n");
  AddDetail( ({"dunkel", "dunkeln"}),
             "Im Dunkeln, braucht man Licht !\n");
  AddDetail( ("gruenton"),
             "Ein angenehmes gruen, sowie es Hobbits gern haben.\n");
  AddDetail( ("truhe"),
             "Welche meinst Du, die Holztruhe, die Steintruhe oder die Eisentruhe?\n"); 
  AddDetail( ({"latten", "holzlatten"}),
	     "Das sind Holzlatten aus solidem Eichenholz.\n");
  AddDetail( ("eichenholz"),
             "Es ist sehr solide.\n");         
  AddDetail( ("holz"),
	     "Welches Holz meinst Du ?\n"
	     + "Das Eichenholz, das Ebenholz oder das Zedernholz ?\n");
  AddDetail( ("bar"),
             "Die reichlich ausgestattete Bar ist aus solidem Eichenholz gebaut.\n"
	     + "Sie enthaelt ein reichhaltiges Sortiment an Alkoholika von den besten "
	     + "alkoholherstellenden Hobbits.\n" 
	     + "Auch ein paar edle Zwergentropfen kannst Du entdecken.\n");  
  AddDetail( ({ "alkoholika", "sortiment" }),
             "Ungefaehr 60 Flaschen kannst du zaehlen. \n"
	     + "Wenn Du willst kannst du dir jede "
	     + "einzelne davon naeher anschauen (unt flasche 1,...,unt flasche 59). "
	     + "Ausserdem faellt Dir eine Flasche Tequila auf, die wie ein Heiligtum "
	     + "auf einem Steinaltar in der Mitte des Raumes trohnt.\n");
  AddDetail( ({"zwergentropfen", "tropfen"}),
             "Jaja, hier sind ein paar auesserst feine Tropfen aus dem Zwergenland. \n"
	     + "Slayven gibt sich eben nur mit dem besten zufrieden.\n");
  AddDetail( ({ "altar", "steinaltar" }),
             "Ein Steinaltar aus Granit.\n" 
	     + "Er ist ueber und ueber mit Verzierungen bedeckt. " 
	     + "Darauf steht eine Flasche Tequila. "  
	     + "Sie steht dort als waere sie ein Heiligtum, dass angebetet werden muss.\n");  
  AddDetail( ("granit"),
             "Granit, die absolute Haerte in Sachen Stein.\n");
  AddDetail( ("verzierungen"),
             "Eine Unzahl von Verzierung bedeckt den ganzen Altar.\n"
	     + "Eine Verzierung faellt Dir jedoch besonders auf.\n");
  AddDetail( ("verzierung"),
             "Die Verzierung duerfte den Tequilagott darstellen, der seine schuetzende Hand " 
	     + "ueber die Tequilas dieser Welt haelt.\n");
  AddDetail( ("hand"),
             "Die sieht ziemlich schlagkraeftig aus.\n");
  AddDetail( ("welt"), "Diese Welt wird Silberland genannt.\n");
  AddDetail( ({ "tequila", "flasche", "heiligtum", "olmeca", "tequilaflasche" }),
	     "Allein an der Art wie die Flasche hier aufgestellt ist, kannst du erkennen, dass "
	     + "Tequila eine wichtige Rolle in Slayvens Leben spielt.\n"
	     + "Es handelt sich bei dem Tequila um eine Flasche 'TEQUILA OLMECA BLANCO'.\n"
             + "Diese Flasche scheint Slayven besonders wichtig zu sein.\n");
  AddDetail( ({"zuckerl","zuckerln", "hustenzuckerln", "hustinetten"}),
             "Der Hustinettenbaer scheint welche zu haben. Frag ihn einfach mal danach."); 
  AddDetail( ({"uhr", "kuckucksuhr"}),
	     "Eine schoene Kuckucksuhr aus gruen angestrichenen Zedernholz.\n"
	     + "Der Kuckuck schaut Dich schief an.\n");
  AddDetail( ("zedernholz"),
	     "Das Zedernholz der Kuckusuhr ist gruen gestrichen.\n");
  AddDetail( ({"tequilagott", "gott"}),
             "Du kannst ihn nich sehen, aber er ist hier allgegenwaertig!\n");
  AddDetail( ("kuckuck"),
	     "Du betrachtest den hoelzernen Kuckuck und, und, UND...\n"
	     + "... nix.\n" 
	     + "Hast du was anderes erwartet ?\n");
  AddDetail (({"kopfpolster", "polster"}),
             "Ein weicher Kopfpolster. So richtig zum verknuddeln.\n");
  AddDetail (({"bettdecke"}),
             "Eine kuschelige Bettdecke. So richtig zum verknuddeln.\n");
  AddDetail (("leintuch"),
	     "Ein einfaches weisses Leintuch is ueber die Matratze gespannt.\n");
  AddDetail (("matratze"),
	     "Ein schoen weiche Matratze.\n");
  AddDetail (("tuer"),
	     "Die Tuer im Osten fuehrt nach draussen.\n");
  AddReadDetail ( ({"uhr ab", "zeit ab", "zeit", "uhr"}), #'d_uhr);

