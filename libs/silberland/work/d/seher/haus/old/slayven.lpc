    {
      write ("Willst Du mit dem Ebenholzsessel oder dem Seidensessel schaukeln ?\n");
      return 1;
    } 
  
  if ((str == "ebenholzsessel") || (str == "mit ebenholzsessel") || (str == "auf ebenholzsessel"))
    {
      write ("Du schaukelst lustig und vergnuegt auf dem Ebenholzsessel.\n");
      say (this_player()->name(WER,2)+" schaukelt lustig und vergnuegt auf dem Ebenholzsessel.\n");
      return 1;
    }
  
  if ((str == "seidensessel" || str == "mit seidensessel" || str == "auf seidensessel"))
    {
      if (TP->query_real_name() == "slayven")
	{   
	  write ("Du schaukelst lustig und vergnuegt auf dem Seidensessel.\n");
	  say ("Slayven schaukelt lustig und vergnuegt auf dem Seidensessel.\n");
	  return 1;
	}  
      else
	{
	  write ("Du schaukelst vergnuegt auf dem Stuhl herum .\n"
		 + "Ploetzlich macht es WUMM und Du liegst auf dem Boden.\n"
		 + "Gluecklicherweise hat deine Nase den Sturz aufgefangen.\n"
		 + "AUUAAAA !!!!!\n");
	  (TP->reduce_hit_point(5));	  
	    say (this_player()->name(WER,2)+" schaukelt auf dem Seidensessel herum,\n" 
		 + " faellt von ihm herunter, "
		 +"und faengt den Sturz gekonnt mit der Nase auf. (Autsch!).\n");
	  return 1;
	}
    }
  return 0;
}
  
huldige_wem (str)
    
{
  notify_fail("Wem willst Du huldigen (es kann nur einen geben!)?\n");
  if ((str == "slayven")) 
    { 
      if (present ("slayven"))  
	{ 
	  if (TP->query_real_name() == "slayven" )  	
	    {
	      write ("Du klopfst Dir selber einmal lobend auf die Schulter.\n");
	      say ("Slayven klopft sich selber lobend auf die Schulter.\n"); 
	      return 1;    
	    }
	  else
	    {
	      write ("Du faengst an Slayven zu huldigen.\n"
		     + "Du kriechst vor Slayven im Staub und faengst an einige Lobeshymnen" 
		     + " zu groellen.\n");
	      say (this_player()->name(WER,2)+" kriecht vor Slayven im Staub und groellt" 
		   " ihm zu Ehren einige Lobeshymnen (was absolut schauderhaft klingt).\n"); 
	      return 1;      
	    }
	}
      else
	{
	  write ("Slayven ist nicht hier. Also heb Dir deine Huldigung besser fuer spaeter auf.\n");
	  return 1;
	}
    }
  return 0;
}

int lege_in(string str)
{
  notify_fail("Wohin moechtest Du Dich legen?\n");
  if (!str) return 0;
  if (BETT(TP))
    {
      write ("Aber Du liegst doch schon!\n");
      return 1;
    }
  if (str=="in bett") 
    {
      if( sizeof(bett)>=3 )
	{
	  write("Das Bett ist leider schon voll besetzt.\n");
	  say( CAP(TPN)+ " findet kleinen Platz im Bett.\n");
	  return 1;
	}
      write (BS(
		"Du legst Dich in das kuschelige Bett. "
                "Ah, das ist ein angenehm entspannendes Gefuehl."));
      say (CAP(TPN)+" legt sich in das Bett.\n");
      bett += ({ getuid(TP) });
      return 1; 
    }
  return 0;
}

int steh(string str)
{
  if( !BETT(TP) )
    return  notify_fail ("Aber Du stehst doch schon!\n"), 0;
  if (str!="auf")
    return notify_fail ("Willst Du vielleicht aufstehen ?\n"),0;
  if( BETT(TP) )
    {
      write ("Du krabbelst aus dem kuscheligen Bett.\n");
      say (CAP(TPN)+" krabbelt aus dem kuscheligen Bett.\n");
      bett -= ({ getuid(TP) });
      return 1;
    }
  return 0;
}

PlayerQuit(object ob)
{
  if (BETT(ob))
    bett -= ({ getuid(ob) });
}

int aus_haus()
{
  if( BETT(TP) )
    return notify_fail ("Dazu solltest Du erstmal aufstehen!\n"), 0;
   TP->move(SLAYVEN, M_GO, "Slayvens Seherhaus durch die Tuer", "verlaesst",
   "kommt aus Slayvens Seherhaus");
  return 1;
}

string schau_bett()
{
  string str;
  str = "Ein aeusserst kuscheliges Bett hat Slayven da. "
    "Ein weisses Leintuch, eine weiche Decke und ein schoener Kopfpolster liegen darauf."
    " Darin ist genug Platz fuer 2 Personen. Es laed zum darin liegen ein.";
  switch ( sizeof(bett) )
    { 
    case 1: 
      str+= CAP(bett[0])+" hat es sich in dem Bett gemuetlich gemacht.";
      break;
    case 2:
      str+= CAP(bett[0])+ " und "+ CAP(bett[1])+ " haben es sich in dem "
	"Bett gemuetlich gemacht.";
      break;
    }
  return BS(str);
}

