string
feuer_da ()
{
if (kaminofen == 1)
{
  return ("Es brennt ein Feuer im Kaminofen.\n");
}
 else
   {
     return ("Es brennt derzeit kein Feuer im Kaminofen.\n");
   }
}

string
steintruhe ()
{
  if (steintruhe == 1)
    {
      return ("Die Truhe ist komplett aus Stein. "
	      + "In dieser Truhe bewahrt Slayven seine Privatsachen auf."
	      + " Sie ist von einer magischen Aura umgeben.\n"
	      + "Sie ist offen.\n"); 
    }
  else
    {
      return ("Die Truhe ist komplett aus Stein. "
	      + "In dieser Truhe bewahrt Slayven seine Privatsachen auf."
	      + " Sie ist von einer magischen Aura umgeben.\n" 
	      + "Sie ist geschlossen.\n");
    }
}

string
holztruhe ()
{
  if (holztruhe == 1)
    {
      return ( "Eine einfache Holztruhe.\n"
	       + "Slayven hat sie fuer all seine Freunde hier aufgestellt.\n"
	       + "Sie ist offen.\n");
    } 
  else
    {
      return ( "Eine einfache Holztruhe.\n"
	       + "Slayven hat sie fuer all seine Freunde hier aufgestellt.\n"
	       + "Sie ist geschlossen.\n");
    }
}

schmeisse_raus (string str)
{
  string wen;
  object ob;  
  if( TP->query_real_name() == "slayven" ) 
    {
      if(!str)
	{	
	  write ("Wen willst Du rausschmeissen?\n"); 
	  return 1;	
	}      
      else
	{      
	  if (sscanf(str, "%s raus", wen) == 1)
	    {
	      if (ob=present(wen))
		{
		  ob->move(SLAYVEN,M_GO,
			   "aus dem Raum durch einen Fusstritt von Slayven", 
			   "fliegt", "fliegt aus Slayvens Seherhaus");
		  return 1;
		}
	      else 
		{
		  write ("Wen willst Du rausschmeissen?\n");	
		  return 1;
		}
	    } 
	}
    }
  else 
    {   
      write ("Hier wird nichts geschmissen.\n");
      return 1;   
    } 
}

spendiere_was (string str)
{
  string wem;
  object pl;  
  if( TP->query_real_name() == "slayven" ) 
    {
      if(!str)
	{	
	  write ("Wem willst Du was spendieren?\n"); 
	  return 1;	
	}      
      else
	{      
	  if (sscanf(str, "%s tequila", wem) == 1)
	    {
	      if (pl=present(wem))
		{
		  write("Du spendierst "+pl->name()+ " einen Schluck aus der Tequilaflasche.\n");
		  tell_object(pl, "Slayven spendiert Dir einen Schluck aus der Tequilaflasche.\n");
		  return 1;
		}
	      else 
		{
		  write ("Wem willst Du was spendieren?\n");	
		  return 1;
		}
	    } 
	}
    }
  else 
    {   
      write ("Du kannst hier nichts spendieren.\n");
      return 1;   
    } 
}


string
kamin_an ()
{
if (kaminofen==0) 
{
  return ("Der Kaminofen ist aus ein paar Metallplatten gebaut.\n"
	 +"Im Winter wenn es kalt ist spendet er Slayven angenehme Waerme.\n"
	 +"Derzeit brennt darin kein Feuer, aber Du koenntest eines anzuenden.\n");
}
 else 
   {
     return ("Der Kaminofen ist aus Metallplatten gebaut.\n"
	     +"Im Winter wenn es kalt ist spendet er Slayven angenehme Waerme.\n"
	     +"Derzeit brennt gerade ein Feuer darin.\n"
	     +"Wenn du willst kannst Du es wieder ausloeschen.\n");
   } 
}

spiele_was( str )
{
  notify_fail("Was willst Du spielen ? \n");
  if((str == "schach"))
    {
      write("Du spielst eine Runde Schach.\n");
      say (this_player()->name(WER,2)+" spielt eine Runde Schach.\n");
      return 1;
    }   
  return 0;
}

zuende_an( str )

{
notify_fail( "Was willst Du denn anzuenden ?\n");
if(( str == "ofen" || str == "kamin" || str == "kaminofen" || str == "ofen an" || str == "kamin an" || str == "kaminofen an" || str == "feuer" || str == "feuer an")) 
{
  if (kaminofen==1) write ("Da brennt bereits ein Feuer im Kaminofen.\n");	
  else 
      {
        write( "Du machst Dir ein schoenes warmes Feuer im Kaminofen.\n" );
        say (this_player()->name(WER,2)+" zuendet ein schoenes warmes Feuer im Kaminofen an.\n");     
        kaminofen=1;
        return 1;
      }
}
return 0;
}

oeffne_was( str )
     
{
  notify_fail("Was willst Du oeffnen ? \n");  
  if((str == "kuehlschrank") || (str == "schrank"))
    {
      if( TP->query_real_name() == "slayven" ) 
	{
	  write( "Du oeffnest den Kuehlschrank.\n"
		 + "Du verschwindest in dem Kuehlschrank (der innen um einiges groesser "
                 + "ist als aussen) und stehst in einer grossen Halle.\n"
                 + "Rings um Dich herum, kannst du Regale mit den verschiedensten "
                 + "Koestlichkeiten des Silberlandes sehen.\n"
                 + "Nach einer kurzen Denkpause entscheidest Du Dich fuer eine von diesen "
                 + "Koestlichkeiten und trittst den Rueckweg an. Sorgfaeltig wie Du bist "
                 + "schliesst du natuerlich hinter Dir die Kuehlschranktuer.\n");  
          say ("Slayven oeffnet die Kuehlschranktuer und verschwindet im Kuehlschrank "
                 + "(der Dir auesserst seltsam vorkommt).\n" 
                 + "Erst nach einiger Zeit kommt er wieder mit Koestlichkeiten beladen hervor. "
	         + "Die sehen wirklich lecker aus. Dir laeuft das Wasser im Mund zusammen.\n"
                 + "Sorgfaeltig wie er ist schliesst Slayven natuerlich die Kuehlschranktuer wieder.\n");  
          return 1;
	}    
      else
	{
	  write("Du oeffnest den Kuehlschrank einen Spalt und traust deinen Augen nicht.\n"
                +"Da drinnen ist ja eine eine ganze Halle mit Koestlichkeiten (wie geht das denn?).\n"
	        +"Als Du versuchst sie zu betreten wirst Du urploetzlich zurueckgeschleudert und "
                +"Du hoerst eine Stimme:\n"
                +" *** Unbefugten ist der Zutritt verboten ***\n"
                +"Die Kuehlschranktuer schliesst sich wieder.\n");
          say (this_player()->name(WER,2)+" oeffnet den Kuehlschrank, wird urploetzlich "
               + "zurueckgeschleudert und eine Stimme ertoent:\n"   
               + " *** Unbefugten ist der Zutritt verboten ***\n"
               + "Die Kuehlschranktuer schliesst sich wieder.\n"); 
	  return 1;
        }    
    }   

  if (str == "holztruhe")
    {
      if (holztruhe == 1)
	{
	  write ("Die Holztruhe ist doch schon offen.\n");
	  return 1;
	}
      else
	{
	  write ("Du oeffnest die Holztruhe.\n");
	  say (this_player()->name(WER,2)+" oeffnet die Holztruhe.\n");   
	  (holztruhe = 1);
	  return 1;
	}  
    }

  if (str == "steintruhe")
    {    
      if( TP->query_real_name() == "slayven" )
	{
	  if (steintruhe == 1)
	    {
	      write ("Die Steintruhe ist doch schon offen.\n");
	      return 1;
	    }
	  else
	    {
	      write ("Du oeffnest die Steintruhe.\n");
	      say ("Slayven oeffnet die Steintruhe.\n");   
	      (steintruhe = 1);
	      return 1;
	    }  
	}
      else 
	{
	  write ("Du kannst die Steintruhe nicht oeffnen.\n");
	  return 1;
	}
    }
  
  if (str == "eisentruhe")
    {
      if( TP->query_real_name() == "slayven" ) 
	{
	  write( "Du oeffnest die Eisentruhe.\n"
		 + "Edelsteine, Rubine, Smaragde, Gold und Silber glaenzen Dir entgegen. "
		 + "Stolz stellst du fest, dass alle diese Reichtuemer in deinem Besitz sind. "
		 + "Du seufzt einmal gluecklich und schliesst zufrieden wieder die Truhe.\n");
	  say ("Slayven oeffnet eine Eisentruhe.\n"
	       + "Du kannst Edelsteine, Rubine, Smaragde, Gold und Silber in der Truhe erkennen. "
	       + "Du kannst kaum glauben das ein Hobbit so reich sein kann. "
	       + "Dir bleibt der Mund offen.\n"
	       + "Slayven begutachtet seine Reichtuemer, seufzt dann gluecklich und schliesst "
	       + "mit einem zufriedenen Blick wieder die Truhe.\n"
	       + "Du schuettelst deinen Kopf, kommst wieder zu Dir und schliesst den Mund.\n");
	  return 1;
	}
      else
	{
	  write("Du versuchst mit aller Gewalt die Eisentruhe zu oeffnen, "
		+"aber es gelingt Dir nicht.\n");
	  say (this_player()->name(WER,2)+" versucht mit aller Gewalt vergeblich " 
	       + "die Eisentruhe zu oeffnen.\n"); 
	  return 1;
	}
    }
  return 0;
}

schliesse_was ( str )
     
{
  notify_fail("Was willst Du schliessen ?\n");  
  if((str == "kuehlschrank") || (str == "schrank"))
    {
      write ("Der Kuehlschrank ist bereits zu.\n");
      return 1;
    }

if (str == "holztruhe")
  {
    if (holztruhe = 0)
      {     
	write ("Die Holztruhe ist doch schon zu.\n");
	return 1; 
      }
    else
      {
	write ("Du schliesst die Holztruhe.\n");
	say (this_player()->name(WER,2)+" schliesst die Holztruhe.\n");
	(holztruhe = 0);
	return 1;
      }
    return 0;
  }

if (str == "steintruhe")
  { 
    if( TP->query_real_name() == "slayven" ) 
      {
	if (steintruhe == 0)   
	  {     
	    write ("Die Steintruhe ist doch schon zu.\n");
	    return 1; 
	  }
	else
	  {
	    write ("Du schliesst die Steintruhe.\n");
	    say (this_player()->name(WER,2)+" schliesst die Steintruhe.\n");
	    (steintruhe = 0);
	    return 1;
	  }
      }
    else
      {
	write ("Du kannst die Steintruhe nicht schliessen.\n");
	return 1;
      }    
  }   
 return 0;
}                      

loesche_aus (str)
     
{
  notify_fail("Was willst du ausloeschen ?\n");
  if ((str == "kamin aus") || (str == "ofen aus") || (str == "kaminofen aus") || (str == "feuer") || (str == "feuer aus"))
    {
      if (kaminofen==0) write ("Es brennt ja gar kein Feuer im Kaminofen.\n");
      else write("Du loescht das Feuer im Kaminofen.\n");
      kaminofen=0;
      return 1;
    } 
return 0;
}

string
slayven_weg()  
{ 
  return ( "Slayven scheint gerade nicht in seinem Domizil zu sein.\n"
	  + "Auch Deine verzweifelte Suche fuehrt zu nichts.\n");
  say (this_player()->name(WER,2)+" sucht verzweifelt nach Slayven.\n");        
}


string d_uhr()
     
{
  int t,h,m;
  t=( (time() + 3600) % 43200) / 60;    // wg. GMT
  h=t/60; m=t%60;
  if (!h) h=12;
  return ("Der Kuckuck sagt es ist jetzt "+h+" Uhr"+(m?" "+m:"")+" min.\n");
}

bete_an (str)
     
{
  notify_fail("Wen oder was willst Du anbeten ?\n");
  if ((str == "altar an") || (str == "tequila an") || (str =="olmeca an") || (str == "flasche an"))
    {
      write ("Du betest mit groesster Erfurcht zum Tequilagott.\n"
	     + "Du tanzt ein paar mal um den Altar und verfaellst in einen tranceartigen Zustand.\n"
             + "Erst nach einer Zeit erlangst Du wieder deine Sinne zurueck.\n"
             + "Du fuellst Dich jetzt irgendwie staerker als zuvor "
	     +"(aber das taeuscht sicher).\n");      
      say (this_player()->name(WER,2)+" betet mit groesster Erfurcht zum Tequilagott, " 
	   +"vollfuehrt wilde Taenze um den Altar, beruhigt sich aber nach einer Zeit "
	   +" wieder und sieht jetzt staerker aus als wie zuvor.\n");
      return 1;
    }
  return 0;
}

stehle_was (str)
     
{
  notify_fail("Was willst Du stehlen ?\n");
  if ((str == "tequila") || (str == "olmeca") || (str == "heiligtum") || (str == "flasche"))
    { 
      if( TP->query_real_name() == "slayven" )
	{ 
	  write ("Du willst Dich doch nicht selbst bestehlen, oder ?\n");
	  return 1;
	}
      else
	{
	  write (" Wenn Du wirklich den Tequila stehlen willst, tippe \n"
		 +"'stehle hinterlistig tequila' ein.\n"); 
	  return 1;
	}
    }
  if ((str == "hinterlistig tequila"))    
    { 
      if( TP->query_real_name() == "slayven" )
	{ 
	  write ("Du willst Dich doch nicht selbst bestehlen, oder ?\n");
	  return 1;
	}
      else 
	{
	  write( "Als Du Dich an dem Tequila vergreifst, ertoent eine Stimme:\n" 
		 + "**Elender Dieb, dafuer wirst Du bezahlen.**\n"
		 + "Der Tequilagott OLMECA erscheint ploetzlich ueber dem Altar. "
		 + "Er breitet seine Haende aus, und spricht magische Worte "
		 + "die Du zwar nicht verstehst, die dir aber die Haare zu Berge "
		 + "stehen lassen. Mit seiner ganzen Kraft wirft er Dir einen "
		 + "Lichtblitz entgegen.\n"
		 + "Du spuerst einen entsetzlichen Schmerz in Deinen Haenden "
		 + "und der Tequilagott verschwindet wieder.\n");
	  
	      (TP->reduce_hit_point(10)); 
	  return 1;
	}
    }
  return 0;
}  

trinke_was (str)
     
{
  notify_fail("Was willst du trinken ?\n");
  if ((str == "tequila") || (str == "olmeca"))
    {
      if (TP->query_real_name() == "slayven")
	{
	  write ("Du nimmst einen kraeftigen Schluck aus der Tequilaflasche.\n");
