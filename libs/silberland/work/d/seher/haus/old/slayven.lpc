    }
  return 0;
}

greife_in (str) 
{
  notify_fail( "In was willst Du greifen ?\n" );
  if ((str == "in ofen" || str == "in kaminofen" || str == "in feuer")) 
    {
      if (kaminofen == 1)
	{
          write("Du greifst in den Kaminofen.\n"
		+"Dummerweise brennt gerade ein Feuer darin.\n"
		+"Und da Feuer ja bekanntlich sehr heiss ist "
                +"verbrennst Du Dir ordentlich die Finger.\n"
		+"Als Du den Schmerz fuehlst schreist Du: 'AUAAAAAAAAHHHHHHHHHH!\n");
          (TP->reduce_hit_point(5));
	  say(this_player()->name(WER,2)+" hat ins Feuer gegriffen und schreit jetz lauthals:\n"
	      +"        * AUAAAAAAAHHHHHHHHH! *\n");
	  return 1;
	}
      else 
	{
	  write ("Du greifst in den Kaminofen.\n"
		 +"Als Du Deine Hand wieder zurueckziehst ist sie voller Russ. IHGITT !\n"); 
	  return 1; 
        }      
    }
return 0;
}  
  
  

















