/*
** Ein Hustinettenbaer fuer Slayvens Seherhaus
** 
** Progged by AnDyL
**
** 1997-11-03
**
** Last updated: 1997-01-08
*/

#include "def.h"   // Eingefuegt (Anatol)
inherit "std/npc";

#include <properties.h>
#include <language.h>

create()
{

  if (!is_clone(this_object())) return;

  ::create();    


  SetProp(P_SHORT, "Eine Hustinettenbaer");
  SetProp(P_HEAL, 2);

  SetProp(P_LONG, "Eine lieber brummiger Hustinettenbaer.\n"
                 +"Er hat ein gruenes Fell und traegt eine Packung Hustenzuckerl bei sich.\n"
                 +"Er macht einen ueberaus freundlichen Eindruck.\n");


  SetProp(P_NAME, "Hustinettenbaer");
  SetProp(P_NOATTACK, "brummelt: Keine Lust zu sowas und verzieht sich beleidigt ins Eck.");  


  SetProp(P_GENDER, MALE);

  AddId( ({"baer","hustinettenbaer"}) ); 

  create_default_npc( 20 );
  SetProp(P_XP,0);
  SetProp(P_BODY, 500);
  SetProp(P_HANDS, ({" mit seinen Hustenzuckerln.", 20}));
  SetProp(P_ALIGN, 800 ); 
  SetProp(P_RACE, "Hustinettenbaer");

  SetChats(2, ({
  "Der Hustinettenbaer gibt ein lautes 'HATSCHI !!!' von sich.\n",
  "Der Hustinettenbaer brummelt ein wenig vor sich hin.\n",
  "Der Hustinettenbaer singt: Ja die Hustinetten, die schmecken Dir das moecht ich wetten.\n",
  "Der Hustinettenbaer grinst Dich schelmisch an.\n",
  "Der Hustinettenbaer sagt: Ich mag Slayven. Der gibt mir immer Hustenzuckerl.\n",
  "Der Hustinettenbaer schnieft: Ich darf Slayvens Tequila nicht probieren.\n",
  "Der Hustinettenbaer knuddelt Dich ganz fest. \n",
  "Der Hustinettenbaer tanzt ein paar mal um Dich herum.\n",
  "Der Hustinettenbaer nimmt ein paar Hustinetten aus der Schachtel.\n",
  "Der Hustinettenbaer kugelt einmal quer durch den Raum.\n",
  "Der Hustinettenbaer spielt dir das Lied von der Grippe.\n",
  "Der Hustinettenbaer schaut seufzend zum Altar.\n"
  }) );
  
  AddInfo("slayven",
	  "sagt: Mein Herr und Meister. Ein aeusserst netter Hobbit. Ihm gehoert dieses Haus. \n");
  AddInfo("woody",
	  "sagt: Das ist doch irgendsoein Gott, oder ?.\n");
  AddInfo("dusty",
	  "sagt: Das ist doch irgendsoeine Goettin, oder ?.\n"); 
  AddInfo(({"hustinetten", "hustenzuckerln", "hustenzuckerl", "zuckerl", "zuckerln"}),
	  "sagt: Ich wuerd Dir gerne welche geben aber die brauch ich" 
	  + " ...'HATSCHHIII'... leider selber.\n");
  AddInfo("andyl",
	  "sagt: Der hat diese Haus gebaut. Er waer ja ganz nett wenn er" 
          + " nicht immer soviel Krach machen wuerde.\n");
  AddInfo(({ "tequila", "flasche", "olmeca" }),
	  "sagt: Das ist Slayvens Heiligtum. Fass sie bitte nicht an.\n");
  AddInfo(({ "hobbit", "hobbits" }),
	  "sagt: Liebe Leut diese Hobbits.\n");
  AddInfo(({ "elf", "elfen"}),
	  "seufzt: Ich kannte da mal eine huebsche Elfin...\n");          
  AddInfo(("elfin"),
	  "sagt: Das geht dich gar nichts an...\n");
  AddInfo(({"zwerg", "zwerge"}),
	  "sagt: Zwerge koennen schoenste Sachen aus Stein unt Metallen machen.\n");
  AddInfo(({"mensch", "menschen"}),
	  "sagt: Das sind so richtige Durchschnittstypen.\n");
  AddInfo(("bar"),
	  "sagt: Mein Meister hat eine schoene Bar, meinst du nicht?\n");
  AddInfo(("altar"),
          "sagt: Auf dem Altar steht Slayvens Heiligtum.\n");
  AddInfo(("heiligtum"),
          "sagt: Slayvens Heiligtum ist sein TEQUILA OLMECA BLANCO.\n");
  AddInfo(("alkohol"),
	  "sagt: Von dem Zeug wird mir immer so uebel.\n");
  AddInfo(("holztruhe"),
          "sagt: Die Holztruhe hat Slayven fuer seine Freunde hier aufgstellt.\n");
  AddInfo(("steintruhe"),
	  "sagt: Darin bewahrt Slayven seine Privatsachen auf.\n");
  AddInfo(("eisentruhe"),
	  "sagt: Darin sind saemtliche Schaetze meines Meisters.\n");
  AddInfo(("kuehlschrank"),
	  "sagt: In dem Kuehlschrank sind extrem viele Nahrungsmittel.\n");
  AddInfo(("bett"),
          "sagt: Das Bett hier ist wahnsinnig weich.\n");
  AddInfo(({"baer", "hustinettenbaer"}),
	  "sagt: Wie du siehst bin ich so einer. Hustinettenbaeren sind " 
	  + "aeusserst angenehme Zeitgenossen.\n");
  AddInfo(("aura"),
          "meint empoert: Da hat sicher wieder Andyl gepfuscht!\n");
  AddInfo(("gott"),
	  "sagt: Ich kenne bloss drei Goetter: Woody, Dusty und den Tequilagott.\n");
  AddInfo(("tequilagott"),
	  "sagt: Er wacht ueber alle Tequilas dieser Welt.\n");
 
  
  
}
































