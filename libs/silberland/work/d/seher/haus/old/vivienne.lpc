inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./def.h"

int vorhang, tee;
string *stuhl=({});
#define STUHL(wer) (member(stuhl, getuid(wer))!=-1)
string *diwan=({});
#define DIWAN(wer) (member(diwan, getuid(wer))!=-1)
string d_uhr();

create()
{
  ::create();
  vorhang=0;

 SetProp(P_INT_SHORT, "Viviennes Hoellenparadies");
 SetProp(P_INT_LONG, "Willkommen im teuflischen Paradies!\n\n"+
	BS("Du stehst in Viviennes kleinem Hoellenparadies, auch hier merkt "+
	"man, dass sie sich noch immer nicht zwischen Gut und Boese "+
	"entschieden hat... Im Zimmer dominieren Rot- und Weisstoene. "+
	"Dein Blick wird sofort auf das riesige Himmelbett in der Mitte "+
	"des Raumes gelenkt. An den Waenden erblickst Du weisse Tapeten und "+
	"viele Regale. In der einen hinteren Ecke steht eine sehr alte "+
	"Wanduhr, in der anderen siehst Du einen rotweissen Paravent. "+
	"Im Raum befindet sich auch noch ein Kamin, in dem ein lustiges, "+
	"kleines Feuer flackert! Du wunderst Dich ueber die hoellische Hitze "+
	"im Raum, vor allem, weil das Feuer Dir nichts auszumachen scheint! "+
	"In der Naehe des Kamins ist eine kleine Sitzgruppe um einen Tisch "+
	"plaziert. Vivienne laedt wohl gerne Gaeste ein, denn auf dem Tisch "+
	"stehen noch einige Teetassen und eine Kanne. Vielleicht kannst ja "+
	"mal auch Du vorbeikommen und mit ihr bei einem Taesschen Tee "
	"plaudern?"));

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:25]));
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);

  vorhang_zu();
  AddDetail( ({"traum"}),
    "Hier drin kann man sicher schoen traeumen...");
  AddDetail( ({"augen"}),
    "Du traust Deinen Augen kaum und fragst Dich, ob es vielleicht "
    "nur Einbildung ist...");
  AddDetail( ({"einbildung"}),
    "Nein, es ist alles wahr, was Du hier siehst...");
  AddDetail( ({"kopf"}),
    "Auch Du hast einen...");
  AddDetail( ({"engelshaar", "haar"}),
    "Vivienne laesst auch ihre braune Haartracht als Engelshaar durchgehen.");
  AddDetail( ({"decke"}),
    "Welche Decke meinst Du? Die Bettdecke oder die Hoehlendecke?");
  AddDetail( ({"kleidung", "ruestung"}),
     "Durch Staub und Lehm ist sie sicherlich verschmutzt "
     "und Du willst auf keinen Fall dieses Weiss zerstoeren.");
  AddDetail( ({"weiss", "himmlisch", "waschmittel"}),
    "Ein himmlisch weisses Weiss, was Vivienne fuer ein Waschmittel "
    "verwendet???");
  AddDetail( ({"waende", "wand"}),
    "Tapeten kleben auf den Waenden, auch einige Regale sind an den "
    "Waenden angebracht. Vielleicht solltest Du Dir diese Dinge genauer "
    "ansehen?");
  AddDetail( ({"dinge"}),
    "Du meinst wohl die Tapeten und die Regale? Die kannst Du alle "
    "untersuchen.");
  AddDetail( ({"tapeten", "tapete"}),
    "Sie sind weiss, und mit goldenen Strichen sind Muster "
    "daraufgemalt worden.");
  AddDetail( ({"striche", "strich"}),
    "Herrlich goldene Striche, die ein Glitzern verursachen. Sie "
    "stellen verschiedene Muster dar.");
  AddDetail( ({"muster"}),
     "Die Muster bestehen aus goldenen Strichen. Du erkennst keine speziellen "
     "Zeichnungen, nur Linien, die aber beruhigend auf Dich wirken.");
  AddDetail( ({"zeichnungen", "zeichnung"}),
    "Es sind eigentlich keine Zeichnungen, nur Linien.");
  AddDetail( ({"linien", "linie"}),
    "Aus goldenen Strichen an der Tapete. Sie wirken beruhigend auf Dich.");
  AddDetail( ({"hoehlendecke"}),
    "Oh la la. An der Decke erkennst Du eine Malerei.");
  AddDetail( ({"malerei", "gegensatz"}),
    "Ahja, im Gegensatz zur himmlischen Tapete ist hier wieder "
    "Hoellisches zu sehen. Rot, rot, rot. ");
  AddDetail( ({"boden"}),
    "Der Boden ist weiss! Hoppla, sollte es nicht eigentlich "
    "umgekehrt sein, das Himmlische an der Decke und das Hoellische am Boden? "
    "Dem ist hier wohl nicht so...");
  AddDetail( ({"regale", "regal"}),
    "Es sind einfache Holzbretter, naja, so einfach wohl doch nicht, "
    "denn sie sind vergoldet. Auf ihnen liegen Buecher, Edelsteine, "
    "Unmengen von Stofftieren und allerlei Krimskrams, die Vivienne einfach "
    "zum Wohlfuehlen braucht.");
  AddDetail( ({"holzbretter", "holzbrett", "brett", "bretter"}),
    "Sie sind vergoldet und bilden die Regale an den Waenden.");
  AddDetail( ({"buecher", "buch"}),
    "Ohne Buecher kann Vivienne nicht ueberleben. Im Geiste siehst Du "
    "sie auf dem Diwan vor dem Kamin sitzen und lesen, neben einer Tasse Tee.");
  AddDetail( ({"edelsteine", "edelstein", "stein", "steine", "liebe"}),
    "Hier macht sich Viviennes Liebe fuer Diamanten "
    "sichtbar. Andere Edelsteine siehst Du nicht!");
  AddDetail( ({"diamanten", "diamant"}),
    "Herrliche Steine, ihre Klarheit und Reinheit ist bewundernswert.");
  AddDetail( ({"klarheit", "reinheit"}),
    "Man muss diese Steine einfach bewundern.");
  AddDetail( ({"krimskrams", "krims", "krams"}),
    "Kleine Figuren, die huebsch anzusehen sind.");
  AddDetail( ({"figuren", "figur"}),
    "Sie sind klein und stehen auf den Regalen.");
  AddDetail( ({"stofftiere", "stofftier", "tier", "tiere", "leidenschaft"}),
    "Wieder eine grosse Leidenschaft, Stofftiere, zum Knuddeln, "
    "Kuscheln und Liebhaben, aber nur fuer Vivienne. Sonst nur zum Anschauen.");
  AddDetail( ({"wohlfuehlen"}),
    "Vivienne fuehlt sich hier sicher wohl! Ob Du Dich hier "
    "auch wohlfuehlen wuerdest?");
  AddDetail( ({"unmengen"}),
    "Jaja, Stofftiere, wo man nur hinblickt...");
  AddDetail( ({"anschauen", "kuscheln", "liebhaben", "knuddeln", "kuscheln"}), 
    "Nicht jeder darf diese Stofftiere knuddeln... Das ist Vivienne "
    "vorbehalten.");
  AddDetail( ({"ecke", "eck", "ecken", "besonderes"}),
    "In fast jeder Ecke findet sich etwas Besonders.");
  AddDetail( ({"wanduhr", "pendeluhr", "uhr"}),
    "Die Uhr an der Wand hat ein grosses Pendel. Sie "
    "zeigt die Zeit erstaunlich genau an. Ihr Ticken bringt Ruhe und "
    "Regelmaessigkeit in den Raum.");
  AddDetail( ({"zeit"}),
    "Du kannst sie an der Uhr lesen.");
  AddReadDetail ( ({"uhr ab", "zeit ab"}), #'d_uhr);
  AddDetail( ({"ticken", "ruhe", "regelmaessigkeit"}),
    "Das Ticken strahlt Ruhe und Regelmaessigkeit aus!");
  AddDetail( ({"pendel"}),
    "Das grosse Pendel schwingt hin und her...");
  AddDetail( ({"paravent"}),
    "Ob der wohl eine bestimmte Aufgabe hat? Vielleicht kannst Du "
    "ihn beiseite schieben?");
  AddDetail( ({"aufgabe"}),
    "Wenn er keinerlei Aufgabe haette, wuerde er wohl hier nicht herumstehen.");
  AddDetail( ({"dampfbad", "bad"}),
    "Manche moegens heiss, Vivienne sogar sehr. Wenn Du Dich traust, kannst "
    "Du das heisse Bad geniessen. Leg bitte aber vorher alles ab!");
  AddDetail( ({"baden"}),
    "Vivienne liebt es, sich bei einem Bad zu entspannen.");
  AddDetail( ({"kamin"}),
    "In ihm flackert ein lustiges, kleines Feuer, das dem Raum auch "
    "Gemuetlichkeit verleiht.");
  AddDetail( ({"gemuetlichkeit"}),
    "Also, Vivienne findet es gemuetlich.");
  AddDetail( ({"feuer"}),
    "Es flackert im Kamin. Obwohl es klein ist, ist hier drinnen aber "
    "trotzdem eine hoellische Hitze.");
  AddDetail( ({"hitze"}),
    "Trotz des kleinen Feuers ist es hoellisch heiss. Naja, wenn sie "
    "es so will...");
  AddDetail( ({"sitzgruppe", "gruppe", "naehe"}),
    "Sie steht in der Naehe des Kamins und besteht aus einem "
    "Diwan und mehreren Polsterstuehlen.");
  AddSpecialDetail( ({"diwan", "ausruhen"}), "det_diwan");
  AddDetail( ({"damast"}),
    "Ein schoener, roter Damast.");
  AddDetail( ({"polsterstuehle", "polsterstuhl", "stuehle", "stuhl"}),
    "3 an der Zahl stehen um den Tisch herum. Auch sie sind "
    "mit rotem Damast ueberzogen.");
  AddDetail( ({"tisch"}),
    "Auf dem Tisch stehen noch einige Teetassen und Kannen. Auch der "
    "Tisch ist aus vergoldetem Holz.");
  AddDetail( ({"holz"}),
    "Das Holz ist vergoldet.");
  AddDetail( ({"gaeste", "gast"}),
    "Vivienne laedt gerne Gaeste ein, um beim Tee Gesellschaft zu "
    "haben. Vielleicht hast Du ja mal Glueck und erwischt sie hier.");
  AddDetail( ({"vivienne"}),
    "Scheinbar ist Vivienne grad nicht hier.");
  AddDetail( ({"gesellschaft"}),
    "Vivienne ist zwar manchmal gern allein, aber sie mag es "
    "noch mehr, liebe Freunde um sich zu haben.");
  AddDetail( ({"freunde", "freund"}),
    "Was tut man ohne gute Freunde. Vivienne waere ohne ihre besten "
    "Freunde hilflos!");
  AddDetail( ({"glueck"}),
    "Vielleicht mit ein bisschen Glueck ist Vivienne grad da, wenn "
    "Du hier drinnen bist. Wenn nicht, frag sie halt, vielleicht laedt sie "
    "Dich ein... ");
  AddDetail( ({"tee", "lieblingsgetraenk", "getraenk", "schwarztee"}),
    "Tee ist Viviennes Lieblingsgetraenk.");
  AddSpecialDetail( ({"teetassen", "teetasse", "tasse", "tassen", "taesschen"}),
    "sd_tassen");
  AddDetail( ({"kanne", "teekanne"}),
    "Der Tee in der Kanne ist immer schoen warm, und wird auch nicht "
    "weniger.... Vielleicht kannst Du ja etwas davon in eine der Tassen "
    "fuellen?");
  AddSmell(DEFAULT_SMELL, "Es riecht hier nach Tee.");
  AddSmell( ({"tee", "schwarztee"}),
    "Der Tee riecht herrrlich. Es scheint sich um einen exquisiten Schwarztee "
    "zu handeln.");
  AddDetail( ({ "damastvorhaenge", "vorhaenge", "bettvorhaenge",
                "damastvorhang", "vorhang", "bettvorhang"  }), 
    "Sie verbergen den Einblick ins Himmelbett. Ob Du sie wohl teilen "
    "kannst?");
  AddDetail( ({ "mitte" }), 
    "Jeder Raum hat eine Mitte. In der Mitte dieses Paradieses steht ein "
    "Himmelbett." );
  AddDetail( ({ "blick", "eintreten" }), 
    "Er richtet sich beim Eintreten gleich auf das grosse Himmelbett in der "
    "Mitte des Raumes.");
  AddDetail( ({ "innere" }), 
    "Es ist durch die Damastvorhaenge vor neugierigen Blicken geschuetzt." );
  AddDetail( ({ "einblick" }), 
    "Du kannst das Himmelbett noch nicht genauer ansehen.");
  AddDetail( ({ "himmelbett", "bett" }), 
    "Es steht in der Mitte des Raumes. Genaueres kannst Du noch nicht sehen, "
    "da schwere, rote Damastvorhaenge den Einblick ins Innere verwehren. Ob "
    "Du wohl ergruenden kannst, was sich dahinter verbirgt?");
  AddDetail( ({ "glitzern" }), 
     "Es kommt einerseits von den goldenen Mustern auf der Tapete und "
     "andererseits von den Diamanten, die auf den Regalen liegen.");
  AddDetail( ({ "rottoene", "weisstoene", "farben", "rot", "hauptrolle"}), 
    "Diese Farben spielen die Hauptrolle in diesem Zimmer, rot fuer das "
    "Teuflische, weiss fuer das Himmlische! Doch ab und zu sieht man noch "
    "ein goldenes oder diamantenes Glitzern.");
  AddDetail( ({ "zimmer", "raum" }), 
    "Da stehst Du mitten drin.");
  AddDetail( ({ "gut", "boese", "entscheidung", "teuflisch", "hoellisch" }), 
    "Die Entscheidung zwischen Gut und Boese wird Vivienne wohl irgendwann "
    "einmal treffen muessen... aber das hat ja noch Zeit.... ;-)");
  AddDetail( ({ "loch", "hoehle" }), 
    "Das war dieser Raum wohl mal frueher. Lang, lang ist's her...");
  AddDetail( ({ "paradies", "hoellenparadies" }), 
    "Glaubst Du, Vivienne gibt sich mit einer einfachen Hoehle zufrieden? "
    "Eben, aus einem Loch wird ein angenehmes Paradies!");
  AddDetail( ({ "staub", "staubschicht", "schicht" }),
    "Du malst gelangweilt einige Kreise in den Staub.");
  AddSpecialDetail( ({"vivienne"}), "vivi_da");
  AddSpecialDetail( ({"muddymud"}), "muddy_da");

  AddSound(DEFAULT_SOUND, "Du hoerst das Ticken einer Uhr.");
  AddSound(({"ticken", "uhr"}), "Tick... Tick... Tick... Tack.");

  AddCmd( ({"teile", "teil"}), "teilen");
  AddCmd( ({"schliess", "schliesse"}), "schliessen");
  AddCmd( ({"schiebe", "schieb"}), "schieben");
  AddCmd( ({"kuschel"}), "kuscheln");
  AddCmd( ({"knuddel", "knuddle"}), "knuddeln");
  AddCmd( ({"fuell", "fuelle", "giess", "giesse"}), "fuelle");
  AddCmd( ({"trink", "trinke"}), "trinke");
  AddCmd( ({"sitz", "setze", "sitze", "setz"}), "sitzen");
  AddCmd ( ({"steh", "stehe"}), "steh");

  AddSpecialExit("westen", "westen");

}

void vorhang_auf()
{
  AddDetail( ({"bett", "himmelbett"}),
    "Ein Traum von einem Bett breitet sich vor Deinen Augen aus. Die schweren, "
    "roten Damastvorhaenge sind geteilt und erlauben einen Blick auf das "
    "grosse Himmelbett.  Flauschig weiche, weisse Polster liegen am "
    "Kopfende. Eine weiche, weisse Decke liegt daruebergebreitet da. Am "
    "liebsten wuerdest Du Dich in dieses himmlische Weiss fallen lassen. Doch "
    "Vivienne sieht es sicher nicht gern, wenn Du mit Deiner Ruestung und "
    "Kleidung ihr schoenes Bett beschmutzt.");
  AddDetail( ({"bettdecke"}),
    "Sie liegt da ueber das Bett gebreitet... Vivienne kuschelt sich "
    "hier sicher gern rein, ob allein oder zu zweit lassen wir mal ausser "
    "Frage gestellt...");
  AddDetail( ({"polster"}),
    "Sie liegen weich und weiss am Kopfende des Bettes. Du fragst "
    "Dich, wie es wohl aussieht, wenn Viviennes Engelhaar ueber diese Polster "
    "fliesst...");
  AddDetail( ({"kopfende"}),
    "Das ist dort, wo der Kopf normalerweise liegt.");
}

void vorhang_zu()
{
  AddDetail( ({ "damastvorhaenge", "vorhaenge", "bettvorhaenge",
                "damastvorhang", "vorhang", "bettvorhang"  }), 
                break_string( "Sie verbergen den Einblick ins Himmelbett. Ob "+
                "Du sie wohl teilen kannst?", 78 ) );
  AddDetail( ({"bettdecke", "kopfende", "polster"}),
    "Das ist doch hinter den Bettvorhaengen versteckt.");
}

int knuddeln(string str)
{
  if( (str== "stofftier" || str=="stofftiere") &&
      TPN=="Vivienne" )
  {
    write("Du knuddelst Deine Stofftiere.\n");
    say("Vivienne knuddelt ihre Stofftiere.\n");
    return 1;
  }
  return 0; 
}

int schieben(string str)
{
  notify_fail("Was willst Du beiseite schieben?\n");
  if( str=="paravent" || str == "paravent beiseite")
  {
     write(BS( 
       "Hinter dem Paravent befindet sich ein Dampfbad. Jetzt weisst Du auch, "
       "warum er da ist, schliesslich will Vivienne ja nicht gleich gesehen "
       "werden, falls sie beim Baden ueberrascht wird.") );
     say( CAP(TPN)+ " schiebt den Paravent beiseite.\n");
     return 1;
  }
  return 0;
}

int teilen(string str)
{
  notify_fail("Was willst Du teilen?\n");
  if(str== "vorhaenge" || str =="bettvorhaenge" || str=="vorhang" ||
     str=="bettvorhang" || str=="damastvorhang" || str=="damastvorhaenge")
  {
    if(!vorhang)
    {
      write(BS(
        "Du siehst nun das Bett. Flauschig weiche, weisse Polster liegen am "
        "Kopfende. Eine weiche, weisse Decke liegt daruebergebreitet da. Am "
        "liebsten wuerdest Du Dich in dieses himmlische Weiss fallen lassen. "
        "Doch Vivienne sieht es sicher nicht gern, wenn Du mit Deiner Ruestung"
        " und Kleidung ihr schoenes Bett beschmutzt."));
      say( BS( CAP(TPN)+" teilt die Vorhaenge und wirft einen kurzen "
            "Blick auf Viviennes Bett."));
      vorhang=1;
      vorhang_auf();
      return 1;
    }
    notify_fail("Die Vorhaenge sind doch schon geteilt.\n");
  }
  return 0;
}

int schliessen(string str)
{
  notify_fail("Was willst Du schliessen?\n");
  if(str== "vorhaenge" || str =="bettvorhaenge" || str=="vorhang" ||
     str=="bettvorhang" || str=="damastvorhang" || str=="damastvorhaenge")
  {
    if(vorhang)
    {
      write("Du schliesst die Bettvorhaenge wieder.\n");
      say( CAP(TPN)+" schliesst die Bettvorhaenge.\n");
      vorhang=0;
      vorhang_zu();
      return 1;
    }
    else
      notify_fail("Aber die Vorhaenge sind doch schon zu!\n");
  }
  return 0;
}
   
int kuscheln(string str)
{
  if(str=="in bettdecke" || str=="bettdecke")
  {
    if( TP->query_real_name()=="Vivienne")
    {
      write("Du kuschelst Dich in Deine kuschelig weiche Bettdecke.\n");
      say( "Vivienne kuschelt sich in ihre Bettdecke.\n");
    }  
    else
    {
      write("Du kuschelst Dich in Vivienns Bettdecke.\n");
      say( CAP(TPN)+" kuschelt sich in Vivienns Bettdecke.\n");
    }
    return 1;
  }
  if( (str=="stofftiere" || str =="stofftier") && 
      TPN=="Vivienne" )
  {
    write("Du kuschelst Dich an Deine Stofftiere.\n");
    say("Vivienne kuschelt sich an ihre Stofftiere.\n");
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();
  if(vorhang==1)
  {
    tell_room(TO,"Die Vorhaenge verschliesen sich auf magische Weise.\n");
    vorhang=0;
    vorhang_zu();
  }
}

string sd_tassen()
{
  if (tee>1)
    return BS("Auf dem Tisch stehen 4 Teetassen, von denen "+to_string(tee)+
      " mit geradezu himmlisch duftendem Tee gefuellte sind.");
  else if (tee)
    return BS("Auf dem Tisch stehen vier Tassen, von denen eine "+
      "mit himmlisch duftendem Tee gefuellt ist.");
  else return BS("Vier Tassen stehen auf dem Tisch. Sie sind unbenutzt.");
}

int fuelle (string str)
{ 
  string *n;
  n=({"erste", "zweite", "dritte", "vierte"});
  notify_fail ("Was willst Du wohin fuellen?\n");
  if (!str) return 0;
  if (str=="tee in tasse" || str=="tasse mit tee")
  {
    if (tee>3)
      write ("Aber die Tassen sind doch schon voll!\n");
    else if (tee)
    {
      write (BS("Vorsichtig giesst Du etwas Tee aus der Teekanne in die "+
        n[tee]+" Tasse. Seltsamerweise scheint die Teekanne kein bisschen "+
        "leichter geworden zu sein."));
      say (BS("Vorsichtig giesst "+CAP(TPN)+" etwas Tee aus der Teekanne in "+
        "die "+n[tee]+" Tasse."));
      tee++;
    }
    else
    {
      write (BS("Vorsichtig giesst Du etwas Tee aus der Teekanne in eine "+
        "Tasse. Seltsamerweise scheint die Teekanne kein bisschen leichter "+
        "geworden zu sein."));
      say (BS("Vorsichtig giesst "+CAP(TPN)+" etwas Tee aus der Teekanne in "+
        "eine Tasse."));
      tee++;
    }
    return 1;
  }
  else
    return 0;
}

int trinke (string str)
{
  notify_fail ("Was willst Du trinken?\n");
  if (!str) return 0;
  if (str!="tee") return 0;
  if (tee)
  {
    write ("Du trinkst mit Behagen eine Tasse koestlich duftenden Tees.\n");
    say (BS(CAP(TPN)+" trinkt mit Behagen eine mit koestlich duftendem Tee "+
      "gefuellte Tasse."));
    tee--;
  }
  else
    write ("Alle vier Teetassen sind leider leer!\n");
  return 1;
}

int sitzen(string str)
{
  notify_fail("Worauf willst Du Dich setzen?\n");
  if (!str) return 0;
  if (STUHL(TP) || DIWAN(TP) )
  {
    write ("Aber Du sitzt doch schon!\n");
    return 1;
  }
  if (str=="auf diwan") 
  {
    if( sizeof(diwan)>=3 )
    {
      write("Leider sitzen schon zu viele Leute auf dem Diwan.\n");
      say( CAP(TPN)+ " findet keine Platz mehr auf dem Diwan.\n");
      return 1;
    }
    write (BS(
      "Du setzt Dich auf den gemuetlichen Diwan. Hier kann man so richtig "
      "schoen entspannen."));
    say (CAP(TPN)+" setzt sich auf den Diwan.\n");
    diwan += ({ getuid(TP) });
    return 1; 
  }
  if (str=="auf stuhl" || str=="auf sessel") 
  {
    if( sizeof(stuhl)>=3 )
    {
      write("Leider sind schon alle Stuehle vergeben.\n");
      say( CAP(TPN)+ " sucht verzweifelt einen freien Stuhl.\n");
      return 1;
    }
    write (BS(
      "Du setzt Dich auf einen Stuhl am Tisch."));
    say (CAP(TPN)+" setzt sich auf einen Stuhl am Tisch.\n");
    stuhl += ({ getuid(TP) });
    return 1; 
  }  
  return 0;
}

int steh(string str)
{
  if( !STUHL(TP) && !DIWAN(TP) )
    return  notify_fail ("Aber Du stehst doch schon!\n"), 0;
  if (str!="auf")
    return notify_fail ("WIE stehen? Vermutlich willst Du AUFstehen...\n"),0;
  if( STUHL(TP) )
  {
    write ("Du erhebst Dich vom Stuhl.\n");
    say (CAP(TPN)+" erhebt sich von dem Stuhl.\n");
    stuhl -= ({ getuid(TP) });
    return 1;
  }
  if( DIWAN(TP) )
  {
    write ("Du erhebst Dich vom dem gemuetlichen Diwan.\n");
    say (CAP(TPN)+" erhebt sich von dem gemuetlichen Diwan.\n");
    diwan -= ({ getuid(TP) });
    return 1;
  }
  return 0;
}

PlayerQuit(object ob)
{
  if (STUHL(ob))
    stuhl -= ({ getuid(ob) });
  if (DIWAN(ob))
    diwan -= ({ getuid(ob) });
}

int westen()
{
  if( STUHL(TP) || DIWAN(TP) )
    return notify_fail ("Dazu solltest Du erstmal aufstehen!\n"), 0;
  TP->move( VIVIENNE, M_GO, "nach Westen", "verlaesst das Hoellenparadies",
         "kommt aus Viviennes Hoellenparadies heraus");
  return 1;
}

string det_diwan()
{
  string str;
  str = "Natuerlich auch mit rotem Damast ueberzogen. Er laedt zum "
        "Ausruhen ein. Wieviele Gaeste hier wohl schon drin gesessen haben? ";
  switch ( sizeof(diwan) )
  { 
    case 1: 
      str+= CAP(diwan[0])+" hat es sich auf dem Diwan gemuetlich gemacht.";
      break;
    case 2:
      str+= CAP(diwan[0])+ " und "+ CAP(diwan[1])+ " haben es sich auf dem "
      "Diwan gemuetlich gemacht.";
      break;
  }
  return BS(str);
}
string d_uhr()
{
  int t,h,m;
  t=( (time() + 3600) % 43200) / 60;    // wg. GMT
  h=t/60; m=t%60;
  if (!h) h=12;
  return BS("Du liest die Zeit an der Pendeluhr ab, und erkennst, "+
    "dass es jetzt in etwa "+h+" Uhr"+(m?" "+m:"")+" ist.");
}
string vivi_da()
{
  if( TP->query_real_name() == "muddymud" )
     return BS("Scheinbar ist Vivienne grad nicht hier. Du vermisst sie ganz "
       "schrecklich.");
  else if( present("muddymud") )
    return BS("Scheinbar ist Vivienne grad nicht hier. Muddymud vermisst "
      "sie ganz schrecklich.");
  else
    return BS("Scheinbar ist Vivienne grad nicht hier.");
}

string muddy_da()
{
  if( TP->query_real_name() == "vivienne" )
     return BS("Scheinbar ist Muddymud grad nicht hier. Du vermisst ihn ganz "
       "schrecklich.");
  else if( present("vivienne") )
    return BS("Scheinbar ist Muddymud grad nicht hier. Vivienne vermisst "
      "ihn ganz schrecklich.");
  else
    return BS("Scheinbar ist Muddymud grad nicht hier.");
