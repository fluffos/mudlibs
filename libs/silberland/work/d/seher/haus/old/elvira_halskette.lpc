/// Kette



inherit "std/thing";



#include <properties.h>

#include <language.h>

#include <combat.h>

#include "../def.h"



create()

{

   if(!is_clone(this_object())) return;

   ::create();





SetProp(P_NAME, "Halskette");

SetProp(P_LONG,"Eine schoene Halskette aus Holz. Die Buschmaenner tragen sie, "

		+" weil sie glauben, dass sie ihnen Glueck bringt. Sie "

		+"soll magische Kraefte besitzen die sie vor Gefahren "

		+"schuetzen. ");

SetProp(P_SHORT,"Eine Halskette");

SetProp(P_GENDER, FEMALE);

SetProp(P_WEIGHT, 20);

SetProp (P_MATERIAL, ({MAT_WOOD}));

SetProp(P_VALUE, 2);

AddId("halskette");



}
