
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "./def.h"

create()
{
  ::create();
  SetProp( P_INT_SHORT, "Das Seherhaus von Zordan" );
  SetProp( P_INT_LONG,
    "Du bist jetzt im geheimen Keller von Zordan's Haus. Hier bewahrt Zordan "
    "private Dinge auf. Von den paar Moebeln faellt Dir eigentlich nur die "
    "saubere Ordnung auf; ganz im Gegensatz zu oben im Zelt. "
  );

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "dinge" }),
   "Alles was Du hier findest darfst Du natuerlich mitnehmen !! "
  );

  AddDetail( ({ "boden" }),
    "Einen richtigen Boden gibt es hier nicht. Der Keller ist einfach nur "
    "in das Erdreich gegraben. "
  );

  AddDetail( ({ "decke" , "luke" }),
    "An der Decke ist nichts besonderes ausser der Luke. "
  );

  AddDetail( ({ "keller" }),
    "In diesem Keller verstaut Zordan nur ein paar private Dinge, mehr "
    "nicht. "
  );

  AddDetail( ({ "wand" , "waende" }),
    "Die Waende sind einfach nur aus fester Erde. "
  );

  AddDetail( ({ "erde" , "erdreich" }),
    "Ganz normale Erde halt. "
  );

  AddDetail( ({ "moebel" }),
    "Ein paar Regale und Truhen stehen hier rum. "
  );

  AddDetail( ({ "regale" , "regal" }),
    "In den Regalen liegen Dinge von Zordan. "
  );

  AddDetail( ({ "zordan" }),
    "Gut das er Dich hier nicht erwischt hat. "
  );

  AddDetail( ({ "truhen" , "truhe" }),
    "In den Truhen liegen ein paar Dinge von Zordan. Alle sind offen. Hier "
    "erwartet Zordan wohl niemanden. "
  );

  AddDetail( ({ "ordnung" }),
    "Also im Gegensatz zu seinem Zelt haelt Zordan hier die Ordnung aufrecht. "
  );

  AddDetail( ({ "zelt" }),
    "Das ist ueber dir. " 
  );

  AddDetail( ({ "gegensatz" }),
    "Naja, anders halt. "
  );

  AddExit( "rauf", SEHERHAUS "zordan" );
}

