inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "./def.h"

create()

{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Wachhund");
  SetProp(P_LONG, 
    "Du siehst Lostboy`s Wachhund.\n"
   +"Eigentlich schaut er ja ganz niedlich und ungefaehrlich aus, \n"
   +"aber ihn zu streicheln traust du dich trotzdem nicht. \n"
   +"Er liegt verschlafen in einer Ecke und beachtet dich gar nicht. \n"
   +"Der Koeter sollte eigentlich die Huette bewachen, wenn Lostboy nicht da ist.\n" );
  SetProp(P_NAME, "Wachhund");
  SetProp(P_GENDER, MALE);
  AddId("Lostboy`s Wachhund");
  AddId("wachhund");
  AddId("hund");
  create_default_npc( 5 );
  SetProp(P_BODY, 255);
  SetProp(P_HANDS, ({" mit seinem scharfen Zaehnen ", 55}));
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Hund");
  SetProp(P_XP, 0);
  SetProp(P_NOATTACK, 1);
  AddCmd( ({ "trete", "tritt", }), "trete" );
  AddCmd( ({ "knuddle", "kuesse", "knuddel", "streichel", "kuess", "streichle"  }), "kuesse" );
  AddCmd( ({ "mustere", "muster", }), "muster" );
  AddCmd( ({ "befiehl", "befehl", "befehle" }), "hund" );
//  set_living_name ("Lostboy`s Wachhund");
  SetProp(P_DEFAULT_INFO,"bellt: Wuff? \n");
  AddInfo("lostboy",
    "heult: jauuuuuuuuuuuuul. bell. bell. wuff.\n");
  AddInfo("steppe",
    "sagt: klaefft: grrr, bruell, grunz.\n");
  AddInfo(({"katze", "huette"}),
    "wufft: bell, klaeff, knurr.\n");
}

int trete( string str )
{
  notify_fail( "Was willst Du denn treten ?" );
  if ( str == "hund" || str == "wachhund" ) {
    write( "Du trittst den Wachhund. Aber ihm scheint das\n"
                +"gar nicht zu gefallen. Er flaetscht seine Zaehne\n"
                +"und schaut dich boese an.\n"  );
    tell_room(environment(),this_player()->name()+" tritt den Wachhund. Der "
                 +"Hund scheint sauer zu sein.\n",({this_player() }) );
    return 1;
  }
  return 0;
}
  
int kuesse( string str )
{
  notify_fail( "Was willst du kuessen ?\n" );
  if ( str == "hund" || str == "wachhund" ) {
    write(    "Du zeigst dem Hund das du ihn magst.\n"
          +"Er weis das zu schaetzen und schleckt "
          +"dich mit seiner Zunge ab.\n " );
    tell_room(environment(),this_player()->name()+" und der Wachhund haben "
                 +"ein Techtelmaechtel.\n",({this_player() }) );
    return 1;
  }
  return 0;
}

int muster( string str )
{
  notify_fail( "was willst du mustern ?\n" );
  if ( str == "hund" || str == "wachhund" || str == "den hund" ) {
    write( "Du musterst den Hund. Er mustert dich auch.\n");
    tell_room(environment(),this_player()->name()+" und der Hund starren sich "
                 +"gegenseitig an.\n",({this_player() }) );  
    return 1;
  }
  return 0;
}

int hund( string str )
{
  notify_fail( "Der Hund versteht nicht.\n" );
  if ( str == "sitz" || str == "platz" || str == "mach sitz" || str == "mach platz"  ) {
    if (getuid(this_player()) != "lostboy" ) {
      write(    "Du befiehlst: Hund mach platz.\n"
           +"Der Hund mag Dich nicht und ignoriert Dich.\n" );
      tell_room(environment(),this_player()->name()+" befiehlt: Hund mach platz.\n"
                 +"Der Hund ignoriert ihn.\n",({this_player() }) );  
      return 1;
    }
    else {
      write("Ja der hund macht das.\n");
      say(this_player()->name(WER,2)+" befiehlt: Hund mach platz.\n" 
                +"Der dumme Wachhund reagiert und setzt sich hin.\n");
      return 1;
    }
  }
  return 0;
}

