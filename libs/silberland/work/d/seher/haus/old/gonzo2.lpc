// Thor@SilberLand
// Gonzo's Seherhaus
// 1997-04-09

#include "./def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <living.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Gonzo's Seherhaus" );
  SetProp( P_INT_LONG, BS(
       "Du bist hier im Dachboden von Gonzo's Seherhaus. Der Boden ist sauber und "
      +"es liegt keinerlei Krimskrams herum. Hier scheint Gonzo immer Basketball "
      +"zu spielen. An der hinteren Wand haengt ein Basketballkorb und darunter "
      +"liegt der Ball dazu. An der rechten Wand sind zwei Haken angebracht, an "
      +"denen ein Basketballtrikot und ein Paar Shorts haengen. Gonzo scheint "
      +"diesen Sport wirklich sehr zu moegen. Er verbring wahrscheinlich die meiste "
      +"Zeit hier in diesem Raum. Vielleicht begegnest Du ihm ja mal hier.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20]) );

  AddDetail( "dachboden",
              QueryProp(P_INT_LONG));
  AddDetail( "gonzo",
             "Gonzo scheint furchtbar gerne Basketball zu spielen, wenn er schon "
            +"einen eigenen Raum dafuer hat.");
  AddDetail( ({"raum", "basketballraum"}),
             "Du bist gerade im Basketballraum von Gonzo.");
  AddDetail( ({"haus", "seherhaus"}),
             "Das hier ist der Dachboden von Gonzo's Seherhaus.");
  AddDetail( "boden",
             "Der Boden ist sauber und man sieht ueberhaupt nichts herumliegen. "
            +"Nur unter dem Basketballkorb an der hinteren Wand liegt ein Ball. "
            +"Ausserdem ist in der linken, hinteren Ecke ein rechteckfoermiges "
            +"Loch im Boden.");
  AddDetail( "ecke",
             "In der linken, hinteren Ecke ist ein rechteckiges Loch im Boden.");
  AddDetail( "loch",
             "Durch das Loch im Boden fuehrt eine Strickleiter wieder nach unten.");
  AddDetail( ({"leiter", "strickleiter"}),
             "Ueber die Strickleiter kannst Du wieder in den Wohnraum klettern.");
  AddDetail( "wohnraum",
             "Der ist unter Dir.");
  AddDetail( ({"krimskrams", "krams"}),
             "Man sieht keinerlei Krimskrams herumliegen.");
  AddDetail( "basketball",
             "Netter Sport fuer fuenf Leute. Man muss nur soviel laufen dabei.");
  AddDetail( "sport",
             "Meist anstrengende Aktivitaet, wo man ins Schwitzen kommt, daher "
            +"warscheinlich nichts fuer Dich.");
  AddDetail( "waende",
             "Die Waende sind kahl, bis auf den Basketballkorb und den Haken mit "
            +"den Kleidungsstuecken drauf.");
  AddDetail( ({"stuecke", "kleidungsstuecke"}),
             "Es sind ein Basketballtrikot und ein Paar Shorts.");
  AddDetail( "wand",
             "An der hinteren Wand haengt ein Basketballkorb, an der rechten Wand "
            +"sind zwei Haken in die Wand geschlagen, an denen ein Basketballtrikot "
            +"und ein Paar Shorts haengen.");
  AddDetail( "haken",
             "An der rechten Wand sind zwei Haken eingeschlagen, an denen Gonzo's "
            +"Basketballtrikot und Shorts haengen.");
  AddDetail( ({"basketballtrikot", "trikot"}),
             "Ein blaues Basketballtrikot mit gelben Streifen am Rand. Es sieht etwas "
            +"verschwitzt aus, daher fasst Du es wohl besser nicht an.");
  AddDetail( ({"rand", "streifen"}),
             "Das Basketballtrikot hat gelbe Streifen am Rand.");           
  AddDetail( ({"paar", "shorts"}),
             "Ein Paar schwarzer Shorts. Es ist Dir eigentlich nicht wirklich ein "
            +"Beduerfnis, Gonzo's Shorts naeher zu untersuchen.");
  AddDetail( "beduerfnis",
             "Du kannst es Dir verkneifen, die Shorts naeher zu untersuchen.");
  AddDetail( ({"korb", "basketballkorb"}),
             "An der hinteren Wand ist ein Basketballkorb in ca. 2 Meter Hoehe "
            +"angebracht. Unter dem Korb liegt ein Ball am Boden. Diesen versucht "
            +"man fuer gewoehnlich, in den Korb zu werfen.");
  AddDetail( "ball",
             "Ein runter, oranger Ball mit duennen, schwarzen Streifen - in "
            +"Fachkreisen auch Basketball genannt. Du koenntest ja mal versuchen, "
            +"den Ball in den Korb zu werfen.");
  AddDetail( "zeit",
             "Gonzo wird warscheinlich viel Zeit hier verbringen. Er spielt nun "
             "mal leidenschaftlich gerne Basketball.");
  AddDetail( "decke",
             "Du blickst zur Decke und siehst einige dicke Dachbalken aus Holz.");
  AddDetail( ({"balken", "dachbalken"}),
             "Auf einem Dachboden sind Dachbalken - wie verwunderlich.");
  AddDetail( "holz",
             "So ziemlich alles in diesem Raum hier ist aus Holz.");

  AddCmd( ({"werfe", "wirf"}), "ball");
  AddCmd( ({"kletter", "klettere"}), "runter");

/*  AddSound( DEFAULTSOUND,
    "");
    
  AddSmell( DEFAULTSMELL,
    "");
*/
   
}

ball (str)
{
  notify_fail("Wohin willst Du das werfen?\n");
  if(str=="ball in korb"||str=="ball in basketballkorb")
    { 
    write(BS("Du dribbelst ein Stueck nach vor, springst, wirfst den Ball zum Korb "
            +"hinauf und triffst mitten hinein. Stolz und zufrieden legst Du den "
            +"Ball wieder an seinen Platz zurueck.\n"));
    say(BS(CAP_TPN+" schnappt sich den Ball, laeuft wie verrueckt los und wirft "
        "den Ball in den Korb.\n"));
    return 1;
    }
  else
    return 0;
}

runter (str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(str=="runter"||str=="hinunter")
    {
    write(BS("Du kletterst geschickt die Strickleiter hinunter und stehst nun "
            +"wieder im Wohnraum von Gonzo.\n"));
    TP->move( SEHERHAUS "gonzo", M_GO, "", "klettert geschickt eine Strickleiter "
            +"hinunter und ist verschwunden", "kommt eine Strickleiter "
            +"heruntergeklettert");
    return 1;
    }
  else
    return 0;
}

