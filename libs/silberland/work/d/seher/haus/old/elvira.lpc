}



/******************************************************

int steigen(string str)

******************************************************/

int steigen(string str)

{

  notify_fail("Wohin moechtest Du steigen ?\n");

  if(!str) return 0;

  if(member( ({"auf sessel","sessel"}), str)!=-1)

  {

 // irgendwer will auf den Sessel steigen ...



 //  sizeof(array) liefert die anzahl der Elemente im Array

 //  wenn also _kein_ Element in stuhl_array ist ... (also niemand drauf steht)

    if( !sizeof(stuhl_array) )

    {

      stuhl_array+=({TP});  // TP wird in stuhl_array eingetragen.

                           //  ich weiss aber nicht, ob am anfang oder am Ende.

      write( BS("Du steigst auf den Sessel. Nun kannst Du die Decke genau "

           +"sehen...Du entdeckst einen Hebel. "));

      say(CAP(TPN) + " steigt auf einen Sessel.\n");

      return 1;

    }

    else  /// wenn mind 1 Element in stuhl_array ist (jemand drauf steht)

    {

      if( auf_sessel(TP,0))  /// steht TP am stuhl?

      {

        write("Wie hoch willst Du denn noch hinaus?\n");

        return 1;

      }

      else  /// steht wer anderer am Stuhl....

      {

        write("Du versuchst, auf den Sessel zu steigen, aber er ist schon von "

               + stuhl_array[0]->QueryProp(P_NAME) + " besetzt.\n");

        say(CAP(TPN) + " versucht auf den Sessel zu steigen, auf dem schon "

             + stuhl_array[0]->QueryProp(P_NAME) + " steht\n"); 

        return 1; 

      }

    }

  }

  else if( member ( ({"von sessel", "runter", "hinunter"}),str)!=-1)

  { /// irgendwer will runter steigen ...

    if( sizeof(stuhl_array) ) /// irgendwer is oben ...

    {

      if( auf_sessel(TP,0)) /// TP steht auf dem stuhl ...

      {

        write("Du steigst vom Stuhl runter.\n");

        say(CAP(TPN) + " steigt vom Stuhl herunter.\n");

        stuhl_array-=({TP});

        return 1;

      }

      else /// sonstwer steht oben ...

      {

        write("Da solltest Du doch erst mal raufklettern.\n");

        return 1;

      }

    }

    else /// leiner oben, also auch TP nicht ...

    {

      write("Da solltest Du doch erst mal raufklettern.\n");

      return 1;

    }

  } return 0;

}



/******************************************************

int ziehen(string str)

******************************************************/

int ziehen(string str)

{

  notify_fail("Was moechtest Du ziehen ?\n");

  if(!str) return 0;

  if( str!="hebel") return 0;

  if(!auf_sessel(TP,0)) return 0;

 

  write( BS("Du ziehst an dem Hebel. Du hoerst das klicken eines Mechanismus "

       +"irgendwo unter Dir. Du bildest Dir ein dass das Gerauesch unter dem Philodendron "

+"zu hoeren war.\n"));

  say(CAP(TPN) + " bewegt irgendetwas.\n");

//    hebel = hebel == 1 ? 0:1; Selbe Wirkung wie naechste Zeile

  hebel = 1 - hebel;

  return 1;

}

