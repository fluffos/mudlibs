{

  if(auf_sessel(TP,0));

  notify_fail("Wohin moechtest Du Dich setzen ?\n");

  if(!str) return 0;

  if( member( ({"auf couch","couch"}), str)==-1) return 0;



  write("Du setzt Dich auf die Couch. Du verspuerst grossen Gusto auf "

       +"einen Schluck Met.\n");

  say(CAP(TPN) + " setzt sich auf die Couch\n");

