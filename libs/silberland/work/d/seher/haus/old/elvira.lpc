/******************************************************

int oeffnen(string str)

******************************************************/

int oeffnen(string str)

{

  if(auf_sessel(TP,1)) return 0;

  notify_fail( "Was willst Du denn oeffnen ?\n" );

  if( member( ({"schrank", "kasten", "kleiderschrank", 

                "kleiderkasten"}), str)==-1 ) return 0;

  if(schrank_offen) /// schrank ist schon offen

  {

    write("Aber der Schrank ist doch schon offen.\n");

    return 1;

  }

  else

  {

    write( BS("Du oeffnest den Schrank und findest drin Elviras Elfengewand. "

             +"Du kommst "

             +"drauf, dass Elvira nicht zu den Ordentlichsten gehoert, dies "

             +"aber anscheinend gut verbergen kann, denn wenn Dir die "

             +"Ordnung im Raum schon beinahe unheimlich vorkam, so wendet "

             +"sich dieser Zustand hier ins Gegenteil. Du bist froh, dass "

             +"Du hier nichts suchen musst, denn die Unordnung steigt ins "

             +"Unermessliche. Das einzige was man auf ersten Anblick "

             +"erkennen kann, ist eine Kleiderstange mit "

             +"Kleiderhaken, auf denen haufenweise Gewand haengt..."));

    say( CAP(TPN) + " oeffnet einen Schrank.\n"); 

    schrank_offen = 1; // damit er auch wirklich offen ist ...

    return 1;

  }

}



/******************************************************

int schliessen(string str)

******************************************************/

int schliessen(string str)

{

  if(auf_sessel(TP,1)) return 0;

  notify_fail( "Was willst Du denn schliessen ?\n" );

  if( member( ({"schrank", "kasten", "kleiderschrank",

                "kleiderkasten"}), str)==-1 ) return 0;

  else

  {

    if(schrank_offen) /// schrank ist offen

    {

      write("Du schliesst den Schrank.\n");

      say( CAP(TPN) + " schliesst einen Schrank.\n");

      schrank_offen = 0;

      return 1;

    }

    else ///Schrank is zu ...

    {

      write("Aber der Schrank ist doch geschlossen.\n");

      return 1;

    }

    return 0; /// hier sollten wir _nie_ herkommen!!!

  }

  return 0; /// irgendein schliesse, das uns nix angeht ...

}



/// KAKTUS



/******************************************************

int pfluecken(string str)

******************************************************/

int pfluecken(string str)

{

  if(auf_sessel(TP,1)) return 0;

  notify_fail("Was willst Du pfluecken ?\n");

  if(!str) return 0;

  if( member( ({"feige","frucht","feige von kaktus"}), str)==-1) return 0;

  if(!anz_feige) return 0;



  CLONE( SEHERHAUS "elvira_feige",TP);

  write("Du greifst nach der Feige und stichst Dich schmerzlich in "

       +"den Finger. Du blutest. Vielleicht solltest Du es ja das "

       +"naechste Mal etwas vorsichtiger angehen.\n\n"

       +"Ploetzlich flattert der Vampir auf Dich zu und faengt an "

       +"Dein Blut aufzusaugen.\n\n"

       +"Dir wird schwindlig und Du fuehlst dass Du gleich in Ohnmacht "

       +"faellst...\n\n "

       +"Du solltest schnell etwas unternehmen. Du dachtest man kann "

       +"in Seherhaeusern ehnicht sterben und Dir ist dieser Vampir "

       +"egal? Na du haettest halt genauer die Zeitung lesen sollen, "

       +"dann wuesstest du, das sich das mit dem letzten reboot "

       +"geaendert hat....\n\n"

       +"Aber da das neu ist  wird Dir ausnahmsweise geholfen.\n\n "

       +"Elviras Diener eilt rasch herbei und wachelt wie wild mit "

       +"einer Knoblauchzehe herum. Der Vampir ruempft angeekelt die "

       +"Nase und fliegt davon.\n");

  say(CAP(TPN) + " greift nach der Feige.\n");

  anz_feige = anz_feige - 1;

  return 1;

}



