int nehmen(string str)

******************************************************/

int nehmen(string str)

{

  if(auf_sessel(TP,1)) return 0;

  notify_fail("Was willst Du nehmen ?\n");

  if(!str) return 0;

  if(member( ({"brett","bretter"}), str)==-1) return 0;

  if(bretter_weg)

  {

    write( BS("Du nimmst die zwei losen Bretter und legst sie auf die Seite. Du entdeckst"

+" ein Loch im Boden, wohin das wohl fuehren mag ? Eine magische Aura haelt Dich "

+"davon ab so einfach hineinzuklettern. Eine Stimme sagt Dir dass Du einen Schluessel ""brauchst und die magischen Worte kennen solltest, wenn Du hier weiter vordringen moechtest."));

    say(CAP(TPN) + " nimmt ein paar Bretter und lehnt sie achtlos in eine "

                 + "der Ecken.\n");

    bretter_weg = 1 - bretter_weg;

    return 1;

  }

  else

  {

    write("Du legst die Bretter und legst sie in das Loch zurueck.\n");

    say(CAP(TPN) + " legt ein paar Bretter auf den Boden.\n");

    bretter_weg = 1 - bretter_weg;

    return 1;

  }
}



