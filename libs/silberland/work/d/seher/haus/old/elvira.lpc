/******************************************************

int hebeln(string str)

******************************************************/

int hebeln(string str)

{

  notify_fail("Was willst Du womit (weg)hebeln?\n");

  if(!hebel) { write("hebel falsch gesetzt\n"); return 0; }

  else if(!present("brett", TP) ) { write("kein brett\n"); return 0; }

  else if(herd_weg) { write("herd is schon weg\n"); return 0; }

  else if(member( ({"herd", "herd weg"}), str)==-1) return 0;



    write("Du hebelst den Herd mit den Brettern zur Seite.\n");

    say(CAP(TPN) + " hebelt den Herd zur Seite.\n");

    herd_weg = 1;

    return 1;

}





/******************************************************

int lesen lesen( string str ) 

******************************************************/

int lesen( string str ) 

{

  string schriftrolle;

  notify_fail( "Was moechtest du lesen ?\n" );

  if ( str != "schriftrolle" ) return 0;

    

  schriftrolle=read_file(SEHERHAUS "elvira_schriftrolle.txt");

  write ( "Du liest die Schriftrolle:\n"

         +"Sie enthaelt eine lange Liste von Namen, lauter Besucher von "

         +"Elviras Strandhaus.\n "

         +break_string(schriftrolle,78));

  say(CAP(TPN) + " liest die Schriftrolle.\n " );

  return 1;

}



/******************************************************

void schreibrolle ( string name ) 

******************************************************/

void schreibrolle ( string name ) 

{

  string buch;

  buch=read_file( SEHERHAUS "elvira_schriftrolle.txt");


  if ( strstr(buch,name) == -1 ) {

    write_file( SEHERHAUS "elvira_schriftrolle.txt", name+", ");

  }

}



/******************************************************

int zwischenraum(string str)

*****************************************************/

int zwischenraum(string str)

{

  if(auf_sessel(TP,1)) return 0;

// Ich wuerd da gern wieder auf die 'Standardfehlermeldung' zurueckschalten.

  notify_fail("hakuna ??\n");

//  if(!(hebel                          || (getuid(TP)=="berx")) ) return 0;

  if(!(str = "matata"                 || (getuid(TP)=="berx")) ) return 0;

  else if(!(hebel                     || (getuid(TP)=="berx")) ) return 0;

  else if(!(bretter_weg               || (getuid(TP)=="berx")) ) return 0;

//  else if(!(present("schluessel", TP) || (getuid(TP)=="berx")) ) return 0;

  else return this_player()->move(SEHERHAUS "elvira_geheim", M_GO,0,"verschwindet durch ein Loch","kommt heruntergeklettert");

}



/******************************************************

int tuer(string str)

******************************************************/

int tuer(string str)

{

  object ob;



  if(auf_sessel(TP,1)) return 0;



  while(ob=deep_present(ONLY_ELVIRA_SEHERHAUS, TP)) ob->Remove();

  return this_player()->move(ausgang, M_GO);

}





