	  schrank_offen = 0;  // speichert, ob der schrank offen ist ...

	  hebel = 0;          // Wie der Hebel gestellt is. 0='zu'

	  blumentopf = 0;     // Wo is der Topf? 0='drauf'

//	  gardine_zu = 0;     // Ob die gardinen geschlossen sind. offen=0

	  herd_weg = 0;       // Ob der Herd draufsteht 0='drauf', 1='weg'

