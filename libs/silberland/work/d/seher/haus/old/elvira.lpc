int heben(string str)

******************************************************/

int heben(string str)

{

  if( !(member( ({"topf", "blumentopf", "philodendron"}), str) ==-1) )

    notify_fail("Der Blumentopf ist doch viel zu schwer um ihn wegzuheben. "

               +"Ob Du ihn schieben koenntest?\n");

  return 0;

}



/// PHILODENDRON



/******************************************************

int schieben(string str)

******************************************************/

int schieben(string str)

{

  if(auf_sessel(TP,1)) return 0;

  notify_fail("Was willst Du schieben ?\n");

  if(!str) return 0;

  if( member( ({"philodendron","topf","philodendron zur seite",

              "topf zur seite"}), str)==-1) return 0;

  if(!blumentopf) /// topf steht 'drauf' reicht das oder brauch ich noch was?

  {

    write("Du schiebst den Philodendron zur Seite.\n");

    say(CAP(TPN) + " schiebt den Philodendron zur Seite.\n");

    call_out("brett",3); 

    blumentopf = 1 - blumentopf; /// 'weg'

    return 1;

  }

  else /// topf is schon weg...

  {

    if(!bretter_weg) // Bretter sind da, oder 'schon wieder'

    {

      write("Du schiebst den Philodendron an seinen Platz "

           +"zurueck.\n");

      say(CAP(TPN) + " schiebt den Philodendron auf seinen Platz "

                  +"zurueck.\n");

      blumentopf = 1 - blumentopf;

      return 1; 

    }

    else  /// Die bretter fehlen ja ;-)

    {

      write("Die Bretter liegen ja nicht da. Willst Du den Topf "

           +"ins Loch stossen?\n");

      return 1;

    }

  }

}



