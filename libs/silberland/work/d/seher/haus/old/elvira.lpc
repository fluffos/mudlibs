	create()

	{

	  ::create();



	  SetProp( P_INT_SHORT, "In Elviras Strandhaus" );

	  SetProp( P_INT_LONG, BS("Du befindest dich im Inneren von " 

	        +"Elviras Strandhaus, am oestlichen Kuestenweg von Tijara. "

	        +"In der Mitte des Raumes steht ein grosser Mahagonitisch, der "

	        +"von vier gepolsterten Sesseln umgeben wird. Ein grosser "

	        +"Philodendron, nimmt einen weiteren Teil des "

	        +"Raumes ein. Weiters siehst Du einen Schrank, welcher in "

	        +"einer "

	        +"Ecke steht. Ein Regal haengt an der Wand. Ausserdem siehst "

	        +"Du noch ein riesiges Becken, indem sich einige hungrige "

	        +"Piranhas befinden. Durch das grosse Fenster scheint die "

	        +"Sonne hell herein. Das Fenster kann mit Gardinen "

	        +"verhaengt werden. An der Westwand erkennst Du eine Nische, "

	        +"die durch einen Perlenvorhang vom uebrigen Raum getrennt "

	        +"wird. Eine Couch steht einladend in einer Ecke."));

 

	  SetProp( P_LIGHT, 1 );

	  SetProp( P_INDOORS, 1 );

	  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 20]) );

//	  AddId( ({ONLY_ELVIRA_SEHERHAUS}) );



AddDetail( ({"raum","wohnraum","inneres","inneren","haus","seherhaeuser","seherhaus"}), BS(

        "Das ist Elviras Wohnraum. "

	        +"Er ruft in Dir Erinnerungen an tropische Sphaeren hervor. "

	        +"In der Mitte des Raumes steht ein grosser Mahagonitisch, der "

	        +"von vier gepolsterten Sesseln umgeben wird. Ein grosser "

	        +"Philodendron, nimmt einen weiteren Teil des "

	        +"Raumes ein. Weiters siehst Du einen Schrank, welcher in "

	        +"einer "

	        +"Ecke steht. Ein Regal haengt an der Wand. Ausserdem siehst "

	        +"Du noch ein riesiges Becken, indem sich einige hungrige "

	        +"Piranhas befinden. Durch das grosse Fenster scheint die "

	        +"Sonne hell herein. Das Fenster kann mit Gardinen "

	        +"verhaengt werden. An der Westwand erkennst Du eine Nische, "

	        +"die durch einen Perlenvorhang vom uebrigen Raum getrennt "

	        +"wird. Eine Couch steht einladend in einer Ecke."));

	  AddDetail( ({"tisch","mahagonitisch"}), BS("Ein runder "

	        +"Mahagonitisch, "

	        +"vier gepolsterte Mahagonisessel umgeben ihn. Auf dem Tisch "

	        +"befindet sich eine Schriftrolle, eine Obstschale mit lauter erlesenen und "

