/******************************************************

int auf_sessel(string pers, integer wert)

******************************************************

Testet, ob ob aufm sessel is. gibt 0 zurueck wenn 'nicht oben', sonst 1.

mit int wird angegeben, ob notify-fail auf "Du solltest zuerst vom Sessel runtersteigen" geaedert wird (1) oder nicht(0).

*/

int auf_sessel(object pers, int wert)

{

  switch(wert)

  {

    case 1:

      notify_fail("Du solltest zuerst vom Sessel runtersteigen.\n");

      if(member(stuhl_array,pers)==-1) return 0; 

      return 1;

    break;

    default: 

      if(member(stuhl_array,pers)==-1) return 0; 

      return 1; 

    break; 

  } 

} 



/****************************************************** 

string feige_fkt(string str) 

******************************************************/ 

string feige_fkt(string str) 

{

  if(anz_feige > 1) return anz_feige + " Feigen.\n"; 

  else if(anz_feige >0) return "1 Feige.\n"; 

  else return 0; /// standardfehlermeldung :-) gemein, ich weiss. 

}





/******************************************************

string gardinen_fkt(string str)

******************************************************/

string gardinen_fkt(string str)

{

  if(!cordel) return BS("Durch das Fenster scheint die Sonne hell in den "

             +"Raum. "

             +"Es kann von Gardinen verhaengt werden. Diese werden durch "

             +"eine Cordel zusammengehalten.");

  else return BS("Die Gardinen tauchen den Raum in schummriges Licht. Wenn es Dir "

             +"doch zu Dunkel ist kannst du die Gardinen ja wieder "

             +"zurueckbinden.");

}



/******************************************************

string cordel_fkt(string str)

******************************************************/

string cordel_fkt(string str)

{

  if(!cordel)

    return BS("Eine dicke Cordel haelt die Gardinen zusammen. Wenn Dir das "

                +"Licht zu hell ist koenntest Du sie ja loesen."); 

  else return BS("Die Kordel haengt funktionslos neben dem Fenster herum. "

             +"Damit kannst du die Vorhaenge sicher wieder auf ihren alten "

             +"Platz zurueckbinden.\n");

}



/******************************************************

string fenster_fkt(string str)

******************************************************/

string fenster_fkt(string str)

{

  if(!cordel) return BS("Das Fenster taucht den Raum in ein helles Licht. Es "

                     +"kann von "

                +"Gardinen verhaengt werden. Ein prachtvoller Kaktus steht "

                +"vor dem Fenster.");

  else return BS("Die Gardinen verhaengen das Fenster und lassen nur wenig "

             +"Licht durchdringen. Ein prachtvoller Kaktus steht "

             +"vor dem Fenster.");

}



/******************************************************

string kaktus_fkt(string str)

******************************************************/

string kaktus_fkt(string str)

{

  if(anz_feige > 1) return BS("Der praechtige Kaktus traegt verlockende Feigen. "

                          +"Du koenntest eine pfluecken.");

  else if(anz_feige == 1) return BS("Der praechtige Kaktus traegt eine "

                               +"verlockende Feige. Du koenntest sie "

                               +"pfluecken.");

  else return "Ein praechtiger Kaktus.\n";

}



/******************************************************

string kasten_fkt(string str)

******************************************************/

string kasten_fkt(string str)

{

  if(!schrank_offen) return BS("Auf dem Schrank hat sich ein kleiner Vampir "

                           +"niedergelassen. Der Kleiderschrank ist "

                           +"geschlossen. Vielleicht koenntest Du ihn "

                           +"oeffnen ?");

  else return BS("Der Kleiderschrank enthaelt Elviras Elfengewand. Du kommst "

             +"drauf, dass Elvira nicht zu den Ordentlichsten gehoert, dies "

             +"aber anscheinend gut verbergen kann, denn wenn Dir die "

             +"Ordnung im Raum schon beinahe unheimlich vorkam, so wendet "

             +"sich dieser Zustand hier ins Gegenteil. Du bist froh, dass "

             +"Du hier nichts suchen musst, denn die Unordnung steigt ins "

             +"Unermessliche. Das einzige was man auf ersten Anblick "

             +"erkennen kann, ist eine Kleiderstange mit "

             +"Kleiderhaken, auf denen haufenweise Gewand haengt...");

}



/******************************************************

string haken_fkt(string str)

******************************************************/

string haken_fkt(string str)

{

  if(!schrank_offen) return 0;

  else return BS("Hoelzerne Buegel sind mit einem Metallhaken "

                +"zusammengeschraubt. Sie sind ueber und ueber mit Gewand "

                +"ueberhaeuft, aber anscheinend war Elvira auch das "

                +"irgendwann zu muehsam, denn einige Haken sind leer und das "

                +"uebrige Gewand ist achtlos auf den Schrankboden geworfen.");

}



