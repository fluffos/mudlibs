/// XANTHOS



inherit "std/npc";



#include <properties.h>

#include <language.h>

#include <moving.h>

#include <defines.h>

#include <moredef.h>

/// #include <combat.lpc>



#include "./def.h"



create()

      {

        if (!is_clone(this_object())) return;

        ::create();



	SetProp(P_NAME, "Xanthos");

	SetProp(P_GENDER, MALE);

	SetProp(P_SHORT, "Xanthos, der Diener von Elvira");

	SetProp(P_ALIGN, 1000);

	SetProp(P_LONG,

		"Das ist Xanthos, Elviras Diener. Er traegt nur einen"

		+" Bastrock und haelt einen Palmwedel in seiner Hand, mit"

		+" der er Dir kuehle Luft zufaechelt. Du kannst ihn nach"

		+" allem fragen, aber dienen tut er nur Elvira. ");

	AddId("diener");

	AddId("xanthos");

	SetProp(P_MAX_HP, 275);

	SetProp(P_HP, 275);

	SetProp(P_XP, 0);

	SetProp(P_HANDS, ({" mit einem Palmwedel", 5}) );

	SetProp(P_AC, 1);

	SetProp(P_ARTICLE,0);

	SetProp(P_NOATTACK,1);



// Is irgendwie fuerdie Rechte notwendig, wer was machen kann. Aber was

// genau ... k.a. einfach uebernommen.

	seteuid(getuid(this_object()));

 	



	AddDetail("diener", BS(

		"Das ist Xanthos, Elviras Diener. Er traegt nur einen Bast"

		+"rock und haelt einen Palmwedel in seiner Hand, mit der er"

		+" Dir kuehle Luft zufaechelt. Du kannst ihn nach allem"

		+" fragen, aber dienen tut er nur Elvira."));

	AddDetail( ({"bastrock","buschmaenner"}), BS(

		"Als Du den Bastrock so betrachtest, mußt Du unweigerlich an"

		+" Buschmaenner denken. Wo Elvira ihren Diener wohl aufge"

		+"gabelt hat ?"));

	AddDetail( ({"palmwedel","luft"}), BS(

		"Der Palmwedel spendet Dir kuehle Luft."));

	AddInfo( ({"elvira","herrin"}), BS(

		"sagt : Das ist eine ganz liebenswuerdige und sehr "

		+"temperamentvolle Elfin. Sie ist meine Herrin. Sie hat mir "

		+"das Leben gerettet und ich habe ihr als Dank meine Dienste "

		+"auf Lebenszeit geschenkt.\n"));

	AddInfo( DEFAULT_INFO, "laechelt Dich freundlich an.\n");

	AddInfo("raetsel",

		"sagt : Wenn Du das Raetsel loest, so wirst Du eine "

		+"Ueberraschung erleben.\n");

	AddInfo( ({"mud","sucht"}),

		"sagt : Das ist Elviras schlimmste Sucht, aber sie liebt es.\n");

	AddInfo( ({"liebhaber","froesche","ausschweifungen"}), BS(

		"sagt wer - ich ? Aber nicht doch. Elvira ist strikt gegen "

		+"solche Ausschweifungen, davon zeugen die vielen verzauber"

		+"ten Froesche im Einmachglas. Ich wuerde mich hueten zu "

		+"riskieren, so zu enden..."));

	AddInfo("diener", BS(

		"sagt: Ich bringe ihr alles, was ihr Herz begehrt. Das ist "

		+"meist recht schwer, weil sie oft sehr ausgefallene und spe"

		+"zielle Wuensche hat."));

	AddInfo( ({"wuensche","todesaxt","axt"}), BS(

		"sagt: Naja im Moment wuenscht sie sich eine Todesaxt, ob"

		+"wohl sie doch viel zu patschert ist sie zu zuecken, aber"

		+" diese Axt scheint auf sie eine sehr starke Faszination"

		+" auszuueben, sodass allein der Besitz dieser sie schon"

		+" ganz gluecklich macht. Jaja etwas eigen ist sie halt"

		+" manchmal schon."));

	AddInfo("herz", BS(

		"sagt: Elviras Herz ist unergruendlich aber Elviras Kopf "

		+"noch viel unergruendlicher."));



/*

  Diese Methode, Objekte zu clonen is _NICHT STANDARD_ und sollte 

   normalerweise _NICHT_ verwendet werden.

  Das Normale vorgehen is 

  {

    seteuid(getuid(this_object()));

    clone_object("<pfad+dateiname>")->move(this_object(), M_NOCHECK);

  }

  wobei das seteuid(...) notwendig ist, damit der NPC auch wirklich clonen kann.



  Meine Methode ueber call_out() einer speziellen fkt ist nur notwendig, da 

   diese Objekte die Angewohnheit haben, Sich selbst zu destructen, wenn sie 

   sich nicht im korrekten Raum befinden. Da das aber beim clonen des npc 

   noch nicht der Fall ist, wuerden sich die items sofort wieder destructen. 

   Deshalb dieser umweg ueber call_out().

*/



    call_out("machen",0);

}



void machen() {

  clone_object( SEHERHAUS "elvira_halskette" )->move(this_object(), M_NOCHECK);

  clone_object( SEHERHAUS "elvira_palmwedel" )->move(this_object(), M_NOCHECK);

}

