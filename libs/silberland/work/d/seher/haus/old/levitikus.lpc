inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "./def.h"

create()
{
  ::create();
     
  SetProp( P_INT_SHORT, "Levitikus Seherhaus" );
  SetProp( P_INT_LONG, BS(
    "Hier bist Du nun, in Levitikus Seherhaus. Aber irgendwie hast Du Dir das "
    "anders vorgestellt. Es sieht ziemlich verlassen aus und alles ist voller "
    "Staub. Der Schreibtisch, das Buecherregal, die Truhe, einfach ALLES! "
    "Durch ein verschmiertes Fenster tritt etwas Licht ein, wodurch Du diese "
    "Unordnung erst so richtig erkennen kannst. Von der Decke und den Waenden "
    "rieselt der Verputz auf den Boden, auf dem sich schon eine "
    "zentimeterdicke Staubschicht gebildet hat. Von Aussen hat dabei doch "
    "alles so neu ausgesehen.") );
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({"feyaria", "sargola"}),
    "Sargola und Feyaria haben dieses Haus gebaut.");
  AddDetail( ({"seherhaus","haus", "raum"}),
    QueryProp(P_INT_LONG) );     
  AddDetail( "levitikus",
    "Das ist der Eigentuemer dieser unwirtlichen Staette." );
  AddDetail( "licht",
    "Etwas Licht kommt noch durch das verschmierte unt staubige Fenster "
    "herein und erhellt den Raum ein wenig." );
  AddDetail( "staub",
    "Also davon gibts hier Berge." );
  AddDetail( "staubschicht",
    "So eine dicke Schicht hast du noch nirgends gesehen.");
  AddDetail( "berge",
    "Berge von Staub." );
  AddDetail( "alles",
    "Einfach ALLES ist hier voller Staub." );
  AddDetail( "unordnung",
    "Das Regal ist verrueckt worden, der Schreibtisch ist unaufgeraeumt und "
    "alles ist total verstaubt." );
  AddDetail( ({"eisentuere", "eisentuer","tuer","tuere"}),
    "Hmmmm...merkwuerdig...denkst Du Dir, als Du die Tuere aus massivem "
    "Eisen erblickst. Sie besitzt keinerlei Mechanismus zum Versperren "
    "derselbigen. Wozu auch? Hier giebt es anscheinend sowieso nichts zu "
    "holen." );
  AddDetail( "mechanismus", 
    "Du findest einfach keinen Mechanismus zum Verriegeln der Tuere, daher "
    "kannst Du sie nur oeffnen." );
  AddDetail( "eisen", 
    "Fein verarbeitetes Eisen. Muss wohl von Zwergen bearbeitet worden "
    "sein.");
  AddDetail( "fenster",
    "Du blickst aus dem Fenster und musst feststellen, dass die Scheiben "
    "wohl mal gewaschen werden koennten, denn von Draussen kannst Du nicht "
    "allzuviel erkennen. Vielleicht kannst Du es ja oeffnen." );
  AddDetail( "rahmen",
    "Er ist total verzogen. Wahrscheinlich klemmt das Fenster deshalb." );
  AddDetail( ({"scheibe","fensterscheibe"}),
   "Total verschmiert." );
  AddDetail("tafel",
    "Du versuchst, den Staub von der Tafel wegzupusten, um zu sehen, was "
    "ich wohl darunter verbirgt.... HAAAAATSCHHIIIIEE! Gesundheit! Viel "
    "kannst Du nicht mehr von dem erkennen, was da einmal gestanden hat, "
    "ausser irgendwas von teleportieren und einem kleinen Plan vom Haus, in "
    "dem merkwuerdiger Weise ein weiteres Stockwerk eingezeichnet ist.");
  AddDetail( ({"plan", "stockwerk"}),
    "Viel mehr kannst Du hier nicht erkennen; der Rest ist verwischt.");
  AddDetail(({"regal","buecherregal"}),
    "Vor Dir baut sich ein tief verstaubtes Buecherregal auf. Es bietet "
    "wohl platz fuer hundert oder hundertfuenfzig Buecher. Allerdings "
    "liegen davon nur mehr drei total zerfledderte Waelzer darin herum; ein "
    "gruener, ein roter und ein weisser.");
  AddDetail("waelzer",
    "Ein gruener, ein weisser und ein roter Waelzer liegen noch im "
    "Regal herum.");
  AddDetail(({"weisser","weisser waelzer"}),
    "Du nimmst das Buch mit dem Titel 'Mein Leben; von Levitikus' in die "
    "Hand und faengst an, darin zu lesen 'Als ich noch ein kleines Kind war "
    "...bla bla bla... GAEHN! Bevor Du noch einschlaefst, legst Du das Buch "
    "allerdings sicherheitshalber wieder ins Regal zurueck.");
  AddDetail(({"gruener","gruener waelzer"}),
    "Ein interessantes Buch ueber aetzende Saeurebatzen, und wie sie auf "
    "blubbernde Basen reagieren. Ein wissenschaftlich hoch angesehenes "
    "Werk!");
  AddDetail(({"roter","roter waelzer"}),
    "\n\nFFFLLLUUUUSSSCCCHHH!!!!\n\n"
    +BS("Gerade, als Du den roten Waelzer aus dem Regal nehmen willst, "
    "rauscht eine riesige Fontaene Staub auf Dich herab. Du kannst zwar fast "
    "den gesamten Staub von Dir beuteln, wirst allerdings das unangenehme "
    "Gefuehl nicht los, dass da Spinnen und Kaefer im Staub waren, die jetzt "
    "in Deiner Kleidung herumwuseln.") );
  AddDetail("truhe",
    "Nachdem Du den Staub von der Truhe gewischt hast, steht vor Dir eine "
    "wunderschoene, schneeweisse Truhe mit netten Verzierungen und schoen "
    "eingearbeiteten Bildern.");
  AddDetail("verzierungen",
    "Naja, Verzierungen halt eben; Linien, Knoten, Kacheln, etc...");
  AddDetail("bilder",
    "Bilder von Tieren, Goettern und Helden des Silberlandes. Ein Bild sticht "
    "allerdings besonders hervor.");
  AddDetail("bild",
    "Ein Bild eines mit Ogerblut getraenkten Schlachtfeldes, auf dem gerade "
    "einige Seher versuchen, der drohenden Gefahr durch die Oger Herr zu "
    "werden.");
  AddDetail( ({"goetter", "gott"}),
    "Woody, Dusty, etc...");
  AddDetail( ({"woody", "dusty","helden"}),
    "Gruesse Sie von mir, bitte!");
  AddDetail( ({"tiere", "tier"}),
    "Du siehst hier einige auf den Bildern.");
  AddDetail("schreibtisch",
    "Du untersuchst den Schreibtisch naeher und musst feststellen, dass er "
    "schon uralt sein muss. Allerdings scheint er schon seil langem nicht "
    "mehr benutzt worden zu sein, da er, wie der Stuhl, der wohl dazugehoert, "
    "total verstaubt und verdreckt ist. Auf ihm kugeln noch ein paar alte, "
    "zerfetzte Pergamente herum.");
  AddDetail("stuhl",
    "Der Stuhl sieht zwar ziemlich zerbrechlich aus, aber mutig wie Du nun "
    "mal bist, setzt Du dich drauf ... und schon passierts! Er bricht "
    "auseinander und Du sitzt am Boden. Verlegen baust Du ihn wieder "
    "halbwegs zusammen und beschliesst, den Stuhl Stuhl sein zu lassen.");
  AddDetail( ({"pergamente", "pergament"}),
    "Du durchsuchst die alten Pergamente nach irgendwelchen Informationen. "
    "Teilweise erkennst Du ein paar alte Runen und neuere Buchstaben; da aber "
    "saemtliche Pergamente zerfetzt oder schon verbleicht sind, kannst Du "
    "absolut nichts wichtiges mehr daraus gewinnen. Nur ein kleiner Brief ist "
    "noch halbwegs gut erhalten.");
  AddDetail("brief",
    "Du oeffnest den Brief, der anscheinend erst vor Kurzem hier vergessen "
    "wurde, denn er sieht noch gut erhalten aus, und liest ihn. Es ist ein "
    "Dankschreiben von Levitikus an Feyaria und Sargola, die ihm mit ganzer "
    "Kraft dabei geholfen haben, sein Haus einzurichten.");
  AddDetail( ({"runen", "rune"}),
    "Uralte Runen eben, die niemand mehr lesen kann.");
  AddDetail( ({"buchstaben", "buchstabe"}),
    "Naja...neuere Buchstaben...solche wie L,E,V sowie I,T oder I,K,U und S.");
  AddDetail("boden",
    "Ein Boden wie jeder andere auch; nur total verdreckt und voller Staub. "
    "Auf ihm steht alles, was nicht and Wand und Decke haengt. Weiter hinten "
    "siehst Du ein kleines Mauseloch und direkt daneben einen kleinen Haufen "
    "Staub. Unter dem Staub kannst Du auch so etwas aehnliches wie ein "
    "Pentagramm erkennen...");
  AddDetail("haufen",
    "Du blickst direkt vom Haufen hinauf an die Decke, wo Du ueber dem Haufen "
    "eine kleine Oeffnung erblickst.");
  AddDetail( ({"loch","mauseloch"}),
    "Dieses Mauseloch sieht aus, als waeren die Maeuse schon seit langem "
    "ausgewandert. Was sollte es hier auch schon gross zu holen geben?");
  AddDetail ("pentagramm",
    "Du wischt den Staub vom Pentagramm. Jetzt erinnert es Dich entfernt an "
    "einen Teleporter. Vielleicht kannst Du Dich hier ja irgendwohin "
    "teleportieren?");
  AddDetail ("decke",
    "Der Verputz rieselt leise vor sich hin und ganz hinten im Eck, ueber "
    "einem Haufen Staub, kannst Du eine Oeffnung erkennen.");
  AddDetail ("oeffnung",
    "Du betrachtest Dir die Oeffnung in der Decke naeher und versuchst zu "
    "erkennen, wo sie wohl hinfuehren mag. Der Blick ist aber durch eine Art "
    "Falltuere versperrt.");
  AddDetail ( ({"putz","verputz"}),
    "Er rieselt... und rieselt... und rieselt...");
  AddDetail (({"falltuere","falltuer"}),
   "Genau ist sie von hier nicht zu erkennen. Du bist Dir aber sicher, dass "
   "sie in den ersten Stock fuehrt, oder von dort wieder herunter.");
  AddDetail ( ({"wand","waende"}),
    "An der Wand, von welcher der Verputz schon rieselt, findest Du eine "
    "Tafel, sowie einige alte verstaubte Bilder.");

  AddSmell( DEFAULT_SMELL, 
    "Hier riecht es irgendwie vermodert und nach Staub." );
  AddSmell( "staub",
    "Gut...auf Deine Verantwortung. HAAAAAAAATSSSSCCCHHHHHIIIIIIIIEEEEE!!!! "
    "GESUNDHEIT! Also am Staub solltest Du lieber nicht mehr riechen.");

  AddSound( DEFAULT_SOUND,
    "Ausser dem Wirbel draussen auf der Strasse hoerst Du hier herinnen "
    "ueberhaupt nichts." );     

  AddCmd( "oeffne", "oeffnen" );
  AddCmd (({"teleportier","teleportiere"}),"teleportieren");
  AddCmd (({"bitte"}), "bitten");
     
  AddSpecialExit( "raus", "raus" );
}

int teleportieren (string str)
{
  notify_fail ( BS("Nur zoegernd stellst Du Dich vorsichtig auf das Feld "
    "und rufst 'beam me up, scotty!'. Das Pentagramm beginnt roetlich zu "
    "leuchten, Staub wird aufgewirbelt und Du beginnst Dich von Unten herauf "
    "zu dematerialisieren. Ploetzlich steigen schwarze Dampfwolken von dem "
    "Feld auf, das Haus bebet kurz und Du faellst wie ein nasser Sack zu "
    "Boden. Waehrend noch zitternd und hektisch pruefst, ob Deine Beine noch "
    "da sind, hoerst Du eine dumpfe Stimme aus dem Pentagramm sagen 'Das "
    "Zauberwort fehlt!'"));
  if (!str) return 0;
  if (str == "bitte" || str == "hinauf bitte" || str == "rauf bitte" ||
      str == "nach oben bitte" )
  {
    write("\nNa also! Warum denn nicht gleich so? Das Pentagramm beginnt "
      "leise zu schnurren,\nalles beginnt sich leicht zu drehen und Du hast "
      "das Gefuehl, als ob es langsam\naufwaerts ginge.\n\n");
    if (TP->query_real_name() !="Levitikus" && !IS_WIZARD (TP) )
    {
      if (TP->QueryProp (P_SP)<3)
      {
        notify_fail ("Leider hast Du zuwenig Magiepunkte.\n");
        return 0;
      }
      else
	TP->restore_spell_points (-3);
    }		
    TP->move(SEHERHAUS "levitikus_ob",M_TPORT);
    return 1;
  }
  if( str == "hinauf" || str == "rauf" || str == "nach oben" || str == "oben")
  {
    write(BS("Man soll nie so befehlend sein in einem fremden Haus! "
      "Vielleicht wuerde ein einfaches 'Bitte' reichen..."));
    return 1;
  }
  return 0;
}     

int raus (string str)
{
  write (BS("Du verlaesst diese Staette der Unordnung, schuettelst Dir noch "
    "mal den Staub von den Kleidern und atmest erleichtert auf."));
  TP->move(LEVITIKUS,M_GO, "nach draussen");
  return 1;
}


int oeffnen (string str)
{
  notify_fail ("Was mochestest Du oeffnen?\n");
  if (!str) return 0;
  if (str=="tuer"||str=="tuere")
  {
    write (BS("Du oeffnest die Tuere. Als Du sie allerdings wieder loslaesst, "
      "schwingt sie wieder zurueck in den Tuerstock."));
    say(TP->name(WER,2)+" versucht die Tuer zu oeffnen, sie schwingt aber "
      "gleich wieder zu.\n");
    return 1;
  }
  if (str=="fenster")
  {
    write(BS("Geht leider nicht. Es klemmt anscheinend im Rahmen fest."));
    say(TP->name(WER,2)+" probiert, das Fenster zu oeffnen.\n");
    return 1;
  }
  if (str=="truhe")
  {
    write (BS("Du versuchst die Truhe zu oeffnen, doch da ist nichts zu "
      "machen. Sie bleibt fest verschlossen."));
    say(TP->name(WER,2)+" schafft es nicht, die Truhe zu oeffnen.\n");
    return 1;
  }
  if (str=="faltuere"||str=="falltuer")
  {
    write(BS("Das kannst Du von hier aus nicht!\n"));
    say(TP->name(WER,2)+" kann die Fallture nicht oeffnen.\n");	
    return 1;
  }
  return 0;
}

int bitten (string str)
{
  notify_fail("Um was willst Du bitten?\n");
  if( !str ) return 0; 	
  if( str=="teleportiere" || str=="nach oben" || str=="teleportation" ||
      str=="hinauf" || str == "rauf" || str == "nach oben" || str == "oben" ||
      str == "teleportiere rauf" || str=="teleportiere hinauf" ||
      str == "teleportiere nach oben" || str=="teleportiere oben" ||
      str=="um teleport" || str=="um teleportation" ||
      str=="nach oben teleportieren" )
  {
    return TP->command_me("teleportiere bitte");
  }
  return 0;
}
