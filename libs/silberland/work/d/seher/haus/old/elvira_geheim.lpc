/// Geheimraum

inherit "std/room";



#include <properties.h>

#include <language.h>

#include <moving.h>

#include <defines.h>

#include <moredef.h>

///#pragma strong_types;



#include "./def.h"







create()

{

string ausgang;

  ::create();



  SetProp( P_INT_SHORT, "Ein geheimer Raum" );

  SetProp( P_INT_LONG, BS(

		"Du befindest Dich hier in Elviras "

		+"Lieblingsraum. Er hat etwas mystisches "

		+"an sich. Du kannst keine Fenster entdecken. Aber "

		+"dennoch ist es nicht finster... der Raum wird von einer "

		+"mystischen Aura in ein angenehmes Licht getaucht. "

		+"Ueberall stehen verstaubte Truhen und Kisten. Ein Regal "

		+"steht an der Ostwand. Auf dem sechseckichen Tisch stehen "

		+"viele Flaschen, Glaeser Eprouvetten, Chemikalien, "

		+"Kraeuter, Pulver und seltsames Werkzeug. Ein Buch faellt Dir auf."

		+"In einer Ecke liegen ein paar Knochen."));

  SetProp( P_LIGHT, 1 );

  SetProp( P_INDOORS, 0 );

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20]) );



	AddDetail ( ({ "raum","wohnraum","inneres","lieblingsraum" }),

   		"Du befindest Dich hier in Elviras "

		+"Lieblingsraum. Er hat etwas mystisches "

		+"an sich. Du kannst keine Fenster entdecken. Aber "

		+"dennoch ist es nicht finster... der Raum wird von einer "

		+"mystischen Aura in ein angenehmes Licht getaucht. "

		+"Ueberall stehen verstaubte Truhen und Kisten. Ein Regal "

		+"steht an der Ostwand. Auf dem sechseckichen Tisch stehen "

		+"viele Flaschen, Glaeser Eprouvetten, Chemikalien, "

		+"Kraeuter, Pulver und seltsames Werkzeug. In einer Ecke "

		+"liegen ein paar Knochen.");

	AddDetail( ({"truhen","kisten","geheimnis","dinge"}),

		"Die Truhen und Kisten sind verstaubt, sie wurden wohl schon "

		+"lange nicht mehr geoeffnet. Sie enthalten so manches "

		+"Geheimnis. Sicher wuerdest Du einiges ueber Elvira erfahren "

		+"wenn Du sie oeffnen wuerdest. Aber Du respektierst dass das "

		+"Elviras privaten Dinge sind und laesst es bleiben.");

	AddDetail( ({ "aura","kraft" }),

		"Eine mystische Aura erfuellt diesen Raum. Du spuerst, dass "

		+"hier wohl nichts unmoeglich ist, denn eine magische Kraft "

		+"erfuellt den Raum. Du fuehlst Dich hier sicher und geborgen");

	AddDetail( ({ "fenster","licht" }),

		"Der Raum hat keine Fenster. Er wird von einer magischen Aura "

		+"eingehuellt, die ihn in ein angenehmes Licht taucht. Ein "

		+"Gefuehl von Ruhe und Frieden regt sich in Dir.");

	AddDetail( ({ "frieden","gefuehl","ruhe" }),

		"Dich ueberkommt ein Gefuehl von Ruhe und Frieden. "

		+"Du bist hier einfach gluecklich.");

AddDetail( ({ "regal","ostwand" }),

		"Das Regal an der Ostwand enthaelt Glaeser mit eingelegten "

		+"Tieren, sowie getrocknete Haeute, Pulver und "

		+"andere Ingredienzen.");

	AddDetail( ({ "boden","staub" }),

		"Die Kisten sowie der Holzboden sind mit einer dicken "

		+"Staubschicht bedeckt.");

	AddDetail( ({ "ingredienzen","glaeser","tiere","haeute","pulver" }),

		"All diese Ingredienzen dienen dazu Zaubertraenke aller Art "

		+"herzustellen.");

	AddDetail( ({ "art","zaubertraenke" }),

		"Nun diese Zaubertraenke koennen allerelei bewirken - gute "

		+"und boese Dinge. Von Heiltraenken ueber Liebestraenke "

		+"bishin zu Verwandlungstraenke und solche, die von dunklen "

		+"Maechten beherrscht wird laesst sich alles hier herstellen. "

		+"Elvira scheint sich darauf zu verstehen sie zu brauen. "

		+"Besser Du ruehrst hier nichts an, dann "

		+"kann nichts schiefgehen.");

	AddDetail( ({ "liebe" }),

		"Das Beste was Dir auf dieser Welt passieren kann.");

	AddDetail( ({ "liebestraenke" }),

		"Du denkst : Muss Liebe schoen sein ! Aber die Flasche ist leider leer. Du musst doch "

+"selber nach einem lieben Menschen suchen.");

	AddSpecialDetail( ({"strickleiter","leiter"}), "strickleiter");

	AddDetail( ({ "tisch" }),

		"Auf dem sechseckichen Tisch stehen "

		+"viele Flaschen, Glaeser Eprouvetten, Chemikalien, "

		+"Kraeuter, Pulver und seltsames Werkzeug. ");

	AddDetail( ({ "werkzeug"}),

		"Das Werkzeug erinnert Dich an das was du in einem Labor "

		+"erwartest vorzufinden. Es dient wohl zur Herstellung "

		+"der Zaubertraenke. ");

	AddDetail( ({ "flaschen","glaeser","eprouvetten","chemikalien","kraeuter","pulver" }),

		"Elvira braut hier Zaubertraenke, und da kann sie all diese "

		+"Dinge sicher gut gebrauchen.");

	AddDetail( ({ "bild","elfin","elvira" }),

		"Wenn man genauer hinschaut kann man eine Elfin erkennen. "

		+"Du vermutest dass es sich um Elvira handelt. Sie schaut "

		+"sehnsuechtig in die Ferne...was sie dort wohl erwartet ?");

	AddDetail( ({ "ferne" }),

		"Du schaust in die Ferne, kannst jedoch nichts erkennen was "

		+"Elvira so fesselt.");

	AddDetail( ({ "wand","waende" }),

		"An der Westwand haengt ein Bild. An der Ostwand siehst du "

		+"ein Regal.");		

  	AddDetail( ({ "knochen","ecke" }),

		"Ja hoppla was machen den die Knochen da in der Ecke ? Die "

		+"muss wohl ihr Liebling Clea da beim spielen vergessen "

		+"haben.");

	AddDetail( ({ "liebling","clea","hund" }),

		"Clea ist ein grosser schwarzer Hund und Elviras Liebling.");

	AddDetail( ({ "decke" }),

		"Von der Decke haengt eine Strickleiter, ueber die Du sicher "

		+"wieder in den Wohnraum zurueckgelangen kannst.");

	AddDetail( ({"buch","papier"}),

		"Das Buch ist sehr alt und das Papier vergilbt. Du kannst "

		+"schwarze Schriftzeichen erkennen. Die Sprache ist alt "

		+"und Dir leider fremd. Aber Du vermutest dass die Formeln "

		+"und Rezepte fuer die Zaubertraenke darin enthalten sind. "

		+"Elvira weiss sicher mehr darueber."); 

	AddDetail( ({ "rezepte","formeln" }),

		"Du kannst nur erahnen dass das Formeln und Rezepte fuer die Zaubertraenke sind.");

AddDetail( ({ "zeichen","schriftzeichen" }),

	"Die schwarzen Schriftzeichen sind sehr alt und Dir unbekannt.");

AddDetail( ({ "verwandlungstraenke" }),

	"Das sind gefaehrliche Traenke, wenn Du nicht aufpasst wirst Du ein Monster !");

AddDetail( ({ "heiltraenke" }),

	"Wie oft hast Du die schon gewuenscht sowas dabei zu haben.");

AddDetail( ({ "eprouvette" }),

	"In diesen kleinen Glasroehrechen mischt Elvira die Zutaten fuer Liebesrtaenke. "

+"Ob diese Traenke was damit zu tun haben, dass sie Zordan so gerne hat ?");

AddSound( DEFAULT_SOUND,

    		"Du hoerst das Rauschen des Meeres.");

    	AddSmell( DEFAULT_SMELL,

    		"Es riecht frisch und angenehm");



  

	AddCmd( ({ "klettere","kletter" }), "klettern" );



//	ausgang = "/players/elvira/workroom.lpc";

//	AddSpecialExit( "workroom",ausgang);

	

}



int klettern(string str)

	{

 	 notify_fail( "Wohin willst Du klettern ?\n" );

	 if(!str) return 0;

 	 if( member( ({"strickleiter","leiter"}), str)!=-1)

	{

	 

	 this_player()->move(SEHERHAUS "elvira", M_GO,0,"klettert nach oben",
             "kommt aus einem Loch geklettert");



    return 1;

  }

  return 0;

}
