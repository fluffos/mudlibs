//
// Madame's Seherhaus 

#include "./def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
int offen;

create()
{
  ::create();

  offen=0;
  SetProp( P_INT_SHORT, "Madame's Seher-Haeuschen" );
  SetProp( P_INT_LONG, BS(
    "Ueber der Tuer haengt ein Schild. Auf der rechten Seite des Hauses kannst "
    "Du ein nicht gemachtes Bettchen und einen Schrank erkennen. Wenn Du Deinen "
    "Blick auf die linke Seite des Raumes schweifen laesst, dann siehst Du einen "
    "Tisch, auf dem ein etwas eigenartig ausschauendes Geraet steht. Um den Tisch "
    "herum stehen ein paar Stuehle.") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22]) );
  
  AddDetail( ({ "bett", "bettchen", "unordnung" }),
    "Das Bett sieht irgendwie recht unordendlich aus und es wird von einigen"
   +" Plueschtieren bevoelkert, die ziemlich lebendig aussehen."); 

  AddDetail( ({ "seite" }),
    "Auf der rechten Seite kannst Du ein Bett erkennen und auf der linken Seite siehst "
   +"Du einen Schrank.");

  AddDetail( ({ "plueschtiere", "plueschis", "plueschtier", "tier", "tierchen", "tiere" }),
    "Auf dem Bett sitzen einige Plueschtiere, und irgendwie unterscheiden sie sich doch "
   +"alle von einander! Du kannst einen Biber, einen Hund samt Welpe, einen kleinen "
   +"weissen Baeren, ein Ferkel und natuerlich auch einen Pinguin erkennen.");
    
  AddDetail( ({ "biber" }),                                                      
    "Ein wirklich sehr lieb anzuschauendes Tierchen ist dieser Biber. Er schaut wirklich "
   +"taeuschend echt aus und deshalb bringst Du Deine hoelzernen Gegenstaende mal besser "
   +"in Sicherheit.");
      
  AddDetail( ({ "hund" }),                                                      
    "Also dieser Hund ist wirklich keine Gefahr fuer irgendwen, ausser wenn Du seinem "
   +"Welpen zu Nahe kommst. Dann koennte er sicherlich auch unangenehm werden.");
    
  AddDetail( ({ "gefahr", "sicherheit", "gegenteil" }),
    "Weisst eh Gefahr ist das Gegenteil von Sicherheit.");
   
  AddDetail( ({ "welpe", "nachwuchs" }),                                                        
    "*Knurr* Es waere doch vernuenftig dem Hund samt Nachwuchs nicht zu Nahe kommen "
   +"wuerdest!");
              
  AddDetail( ({ "ferkel" }),                                                      
    "Ui niedlich! Bei der Unordnung fuehlt es sich natuerlich fast schon wie zu Hause.");      

  AddDetail( ({ "baer" }),                                                      
    "Du kannst einen Knopf auf dem Oberkoerper des kleines Baeren erkennen.");
    
  AddDetail( ({ "knopf" }),
    "Bei naher Betrachtung kannst Du erkennen, das auf den Knopf ein rotes Kreuz "
   +"aufgemalt wurde.");
              
  AddDetail( ({ "kreuz", "oberkoerper" }),
    "Der Knopf des Baeren hat ein Kreuz aufgemalt");

  AddDetail( ({ "pinguin" }),
    "Natuerlich darf bei all den Plueschis auch ein Pinguin nicht fehlen, der Madame's "
   +"Haus-und-Hof-Pinguin darstellt. Er hat dann auch noch einen kleinen Anhaenger um "
   +"den Hals gebunden, denn Du Dir noch genauer anschauen koenntest."); 

  AddDetail( ({ "anhaenger" }),
    "Auf dem Anhaenger sind Schriftzeichen zu erkennen.");
 
  AddDetail( ({ "schriftzeichen", "schirft", "sinn" }),
    "Normalerweise liest man Schriftzeichen!");          
  
  AddDetail( ({ "name", "namen" }),
    "Die meisten Dinge haben auch einen Namen, aber das spezielle Ding hier scheint "
   +"keinen Namen zu besitzen.");
          
  AddSpecialDetail( ({ "schrank", "kleiderschrank" }), "schrank");        
      
  AddDetail( ({ "stuhl", "stuehle", "tisch", "mitte" }),         
    "In der Mitte des Raumes steht ein Tisch mit ein paar Stuehlen rundherum. Auf dem "
   +"Tisch kannst Du ein eigenartiges Geraet erkennen."); 
      
  AddDetail( ({ "geraet", "ding", "etwas", "gegenstand", "gegenstaende", "untersuchung" }),
    "Auch nach genauer Untersuchung kannst Du mir diesem Ding nichts anfangen. "
   +"Vielleicht ist es ja nur einfach ein sinnlos herumstehendes Etwas, das weder "
   +"einen Sinn noch einen Namen hat.");   

  AddDetail( ({ "blick" }),
    "Also wirklich! Man kann doch keinen Blick untersuchen!");       

  AddDetail( ({ "haeuschen", "haus", "seherhaus", "seher", "gaeste", "gast" }),
    "Madame's Seher-Haeuschen.");
      
  AddDetail( ({ "madame" }),
    ([0: "Solche Fragereinen koennte man eigentlich auch als zudringlich bezeichnen. "
        +"Eine geheimnissvolle Stimme sagt, dass die Herrin im Moment nicht da ist.",
     "elf": "Fuer Elfen steht das Haus natuerlich immer zur freien Verfuegung.",
     "hobbit": "Wanderhobbit's werden in diesen vier Waenden gern als Gaeste gesehen."]) );      
      
  AddDetail( ({ "rose", "rosen", "strauss", "vase" }),
    ([0: "Du schaust Dich ganz aufmerksam um, aber Du kannst nirgendwo Rosen erkennen",
      "elf": "Auf dem Tisch steht ein Vase mit einem Strauss wunderschoener "
            +"langstieliger roter Rosen.",
      "hobbit": "Auf dem Tisch steht eine Vase mit Blumen."]) );
      
  AddDetail( ({ "schild" }),
    "Was kann man mit einem Schild anstellen?");

  AddDetail( ({ "tuer" }),
    "Da Du hier in einem normalen Haeuschen bist, hat dies natuerlich auch eine Tuer.");

  AddDetail( ({ "wand", "waende" }),
    "Die Waende schauen ziemlich nichtssagens aus.");
 
  AddDetail( ({ "boden", "schmutz" }),
    "Der Boden schaut ein bisschen schmutzig aus.");

  AddDetail( ({ "decke" }),
    "Du kannst nur eine normale Decke erkennen.");
      
  AddReadDetail( ({ "anhaenger" }),
    "Madame's Lieblingspinguin #%&.");
              
  AddReadDetail( ({ "schild" }),
    "Madame's Seher-Haeuschen.");

  AddSound( DEFAULT_SOUND,
    "Es ist ganz ruhig im Zimmer.");
    
  AddSound( ({ "ruhe" }),
    ([0: "Die Ruhe ist ueberwaeltigend.",
      "elf": "Ein ganz leises Surren ist zu hoeren."]) );

  AddSound( ({ "surren" }),
    ([0: "Die Ruhe ist ueberwaeltigend.",
      "elf": "Das Surren scheint durch das komische Ding auf dem Tisch erzeugt zu werden."]) );
      
  AddSound( ({ "knurren" }),     
    "Das Knurren des Hundes erschreckt Dich.");
    
  AddSmell( DEFAULT_SMELL,
    ([0: "Der Geruch in Madame's Haeuschen ist recht angenehm, aber trotzdem nichtssagend.",
      "elf": "In Madame's Haeuschen riecht es ganz angenehm nach Rosen.",
      "hobbit": "In Madam's Haeuschen riecht es nach frischen Blumen."]) );

  AddCmd( ({ "oeffne" }), "cmd_oeffne" );
  AddCmd( ({ "schliesse" }), "cmd_schliesse" );

  AddExit( "raus", MADAME );
}

cmd_oeffne(string str)
{
  notify_fail( "Was willst Du tun?\n" );
  if( str == "schrank" )
  {
    if(offen)
    {
      write("Aber die Schranktuer ist ja schon offen!\n");
      return 1;
    }
    offen=1;
    write("Du oeffnest die Tuer des Kleiderschranks.\n");
    say( TPN+" oeffnet die Tuer des Kleiderschranks.\n");
    return 1;
  }
  return 0;
}

cmd_schliesse(string str)
{
  notify_fail( "Was willst Du tun?\n" );
  if( str == "schrank" )
  {
    if(!offen)
    {
      write("Aber die Schranktuer ist ja gar nicht offen!\n");
      return 1;
    }
    offen=0;
    write("Du schliesst die Tuer des Kleiderschranks wieder.\n");
    say( TPN+" schliesst die Tuer des Kleiderschranks wieder.\n");
    return 1;
  }
  return 0;
}

string schrank()
{
  string str;
  str= "Hierbei scheint es sich um einen ganz normalen Kleiderschrank zu handeln.";
  if(offen)
    str+=" Die Schranktuer ist geoeffnet.";
  return BS(str);
}
  


