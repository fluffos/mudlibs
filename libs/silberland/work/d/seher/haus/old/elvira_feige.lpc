inherit "std/food";

#include <properties.h>

#include <food.h>

#include <language.h>

#include <defines.h>

#include <moredef.h>

#include <moving.h>



#include "./def.h"



#define ONLY_ELVIRA_SEHERHAUS "\nberx99"



/*

 erstmals_gestartet wird auf 1 gesetzt, Da QueraProp() schon _vor_ init()

 aufgerufen wird und deshalb das environment noch nicht gesetzt ist. 

 Derzeit wird durch die 'sekundenabfrage' verhindert, dass das oefters 

 aufgerufen wird. Doch ist mir das zu unsicher. deshalb werd ich mir da was 

 anderes ueberlegen ...

*/

int erstmals_gestartet=(1);

int last_time=(0);	// wann QP zum letzten mal aufgerufen wurde.



/*

******************************************************

	create()

******************************************************

*/

        create()



	{

	  if (!is_clone(this_object())) return;

	  ::create();

	  SetProp(P_NAME, "Blume");

	  SetProp(P_GENDER, FEMALE);

	  SetProp(P_SHORT, "Eine koestliche Feige");

	  SetProp(P_LONG, "Eine verlockend aussehende Feige, in die du am "

                         +"liebsten gleich reinbeissen moechtest.");

	  AddId( ({"feige", ONLY_ELVIRA_SEHERHAUS}) );



	  SetProp(P_WEIGHT, 20);

	  SetProp(P_VALUE, 0);

	  SetProp(P_FOOD_INFO, ([F_HEAL : ({2, 0}), F_SOAK : 5]));

        // Heilt 2 Lebenspunkte, Saettigung 5



// ***AddSmell("feige",

//        "Sie riecht suess und verlockend.");

	

//	  AddCmd("wobinich_test","test");

	}



/*

******************************************************

	void BeimEssen()

******************************************************

*/

        void BeimEssen()

	{

	  write("Du stopfst Dir genuesslich die Feige in den Mund.\n");

	  say(CAP(TPN) + "stopft sich genuesslich eine Feige in den Mund.\n");

	}



/*

******************************************************

int test()

******************************************************

*/

int test()

{

  object *environ_list;

  int i;

  int ok;

  ok=0;



  if(erstmals_gestartet) return 1;

  environ_list = all_environment(TO);

  for(i=0 ;i<sizeof(environ_list); i++)

    if(environ_list[i]->QueryProp(P_INT_SHORT)=="In Elviras Strandhaus") 

      ok = 1;

  if(ok) return 1;

  else

  {

    write("Sorry. falscher Raum.\n");

    call_out("remove",0);

    erstmals_gestartet = 1;

//      Is notwendig, damit beim remove() test() nicht nochmalaufgerufen wird.

    return 1;

  }

}



/*

******************************************************

	void init()

******************************************************

*/

        void init()

	{

	  erstmals_gestartet = 0;

 	  test();

	  last_time = time();

	  return ::init();

	}



/*

******************************************************

	mixed QueryProp(string name)

******************************************************

*/

        mixed QueryProp(string name)

	{

	  int current_time;

	  if(last_time == current_time = time() ) return ::QueryProp(name);

//                             Diese sekunde schon getestet. das reicht :-)

	  else

	  {

//        Diese sekunde noch nicht getestet -> last_time updaten und testen

	    last_time = current_time;

	    test();

	    return ::QueryProp(name);

	  }

	}

