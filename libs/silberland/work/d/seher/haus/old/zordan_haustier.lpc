
/*
   Das Haustier in Zordan's Seherhaus
   
   Es ist ein Gestaltenwandler, der auf Fragen von Spielern hin sich 
   in eine andere Gestalt veraendert kann.
 
   Version 1.0 vom 22.09.1997

*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./def.h"

int istwandler;
string wandlerform;


create() {
  if (!is_clone(this_object())) return;

  ::create();

  istwandler=1;

  SetProp(P_SHORT, "Ein Gestaltenwandler");
  SetProp(P_LONG, 
    "Eine durchschimmernde Gestalt von etwa zwei Meter scheint der "
    "Mitbewohner von Zordan zu sein. Er macht hier im Zelt sauber und "
    "bringt ein wenig Ordnung in das Chaos. Im Moment kannst Du nicht "
    "viel von ihm erkennen, da er wohl keine richtige Gestalt hat. "
    "Normalerweise ist er recht freundlich aber Du solltest ihn besser "
    "nicht aergern. Wer weiss in was er sich dann verwandelt. Ausserdem "
    "ist er durchaus in der Lage, Dir ein paar Fragen zu beantworten. "
    "Er traegt eine Kette mit einem Schild um den Hals. "
  );
  SetProp(P_NAME, "Gestaltenwandler");
  SetProp(P_GENDER, MALE);
  set_living_name ("Gestaltenwandler");
  AddId( ({ "gestaltenwandler" ,"wandler" }) );
  SetProp(P_SIZE, 180+random(30));

  SetProp(P_HANDS, ({" mit einem Wuergegriff", 55}));
  SetProp(P_BODY, 10);
  create_default_npc( 100 );
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "tier");
  SetProp(P_XP, 10);
  SetProp(P_NOATTACK, 1);

  SetProp( P_REJECT, ({ REJECT_KEEP, "Der Gestaltenwandler sagt: "
    +"Danke. Ich werde es dann Zordan geben.\n" }) );

  SetProp(P_DEFAULT_INFO, ({
    "sagt: Frag mich doch Morgen nochmal danach.\n",
    "zuckt zusammen.\n",
    "fragt: Willst Du mir nicht mehr darueber erzaehlen ?\n",
    "bruellt: Mist, ich muss noch einkaufen.\n",
    "dreht sich um und putzt weiter.\n",
    "winkt ab.\n",
    "grummelt: lass mal lieber.\n",
    "sagt: Vielleicht weiss Sedda mehr darueber ?\n",
    "sagt: Hm, nie davon gehoert.\n",
    "murmelt: Ne, davon weiss ich nichts.\n",
    "sagt: Da solltest Du besser Zordan fragen.\n" })
  );

/* -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    Details
   -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- */

  AddDetail( ({ "hals" }),
    "Um den Hals traegt der Wandler eine Kette an der ein Schild haengt. "
  );

  AddDetail( ({ "mitbewohner" }),
    "Der Wandler ist Zordan's Mitbewohner. Er sorgt fuer Ruhe und Ordnung "
    "in diesem Zelt."
  );

  AddDetail( ({ "kette" }),
    "Die Kette haelt nur das Schild. "
  );

  AddDetail( ({ "schild" }),
    "Auf dem Schild steht: Wenn Du mir mal etwas hinterlassen willst, "
    "dann geb die Sachen einfach dem Wandler. Er wird dafuer sorgen, "
    "dass ich ( und nur ich ! ) die Sachen bekomme.    gez. Zordan "
  );

/* -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    Fragen auf die geantwortet wird
   -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- */

  AddInfo( ({ "name" , "namen" }),
    "Leider hat Zordan wohl vergessen mir einen zu geben." , "sagt: "
  );

  AddInfo( ({ "zordan" , "herr" , "meister" }),
    "Das ist mein Herr und Meister. Ich tue ALLES fuer ihn !" , 
    "sagt ehrfuerchtig: "
  );

  AddInfo( ({ "alles" }),
    "Ja, wirklich alles. Glaub es mir ruhig. " , "sagt: " 
  );

  AddInfo( ({ "zelt" }),
    "Ich mache das Zelt gerade sauber. Bitte steh nicht im Weg. " , "meint: "
  );

  AddInfo( ({ "steppe" }),
    "hier in der Steppe gibt es mehr zu sehen als Du denkst !" , "murmelt: "
  );

  AddInfo( ({ "silberland" , "land" }),
    "Hier im Silberland bei Zordan fuehle ich mich am wohlsten, Du nicht ?",
    "erwidert: "
  );

  AddInfo( ({ "creative" }),
    "Ohne ihn haette Zordan mich nicht. " , "grinst: " 
  );

  AddInfo( ({ "woody" , "dusty" , "goetter" , "gott" }),
    "Nur er/sie koennen mich toeten. " , "zittert: "
  );

  AddInfo( ({ "whisky" }),
    "Whisky ist der einzige Alkohol, den Zordan trinkt. Ich bin aber "
    "Nichtalkoholiker. Und Musik mag ich auch nicht besonders. " , 
    "antwortet: "
  );

  AddInfo( ({ "alkohol" , "musik" }),
    "Das verwandelt mich in eine Gestalt ohne Koerper. " , "arglt: "
  );

  AddInfo( ({ "koerper" }),
    "Findest Du mich nicht huebsch so ? Ich koennte mich ja mal verwandeln. ",
    "grinst: "
  );

  AddInfo( ({ "gegenstand" , "gegenstaende" , "sachen" , "sache" }),
    "Wenn Du etwas NUR fuer Zordan abgeben moechtest kannst Du es mir "
    "geben. Ich werde es ihm dann beim naechsten Treffen geben. " ,
    "fluestert: "
  );

  AddInfo( ({ "zeit" }),
    "Es ist Zeit weiterzuarbeiten. " , "sagt: "
  );

  AddInfo( ({ "treffen" }),
    "Wer weiss wann das sein wird. " , "seufzt: "
  );

  AddInfo( ({ "sedda" }),
    "Sie ist eine nette Frau. Wenn Du Probleme hast dann frag sie ruhig. ",
    "sagt: "
  );

  AddInfo( ({ "hannelore" }),
    "Sie bringt mir immer was zu essen vorbei. " , "sagt erfreut: "
  );

  AddInfo( ({ "sensal" , "bodenstab" }),
    "Der Auktionaer hier im Silberland. Ein sehr netter Mann. Leider "
    "hat er genauso wenig Zeit wie ich. " , "sagt: "
  );

  AddInfo( ({ "lostboy" }),
    "Er ist ein wackerer Recke, der Zordan beim Aufbau seines Zeltes viel "
    "geholfen hat. " , "grinst: "
  );

  AddInfo( ({ "fenris" }),
    "Er ist der Schueler Zordans. Wie es ihm heute geht weiss ich leider "
    "nicht. " , "sagt: "
  );

  AddInfo( ({ "freunde" , "freund" }),
    "Frag Zordan lieber selber nach seinen Freunden. " , "meint. "
  );

  AddInfo( ({ "gestalt", "gestalten" , "verwandeln" , "verwandlung" ,
              "wandeln" , "wandel" }),
    "Ich kann viele Gestalten annehmen: Mensch, Zwerg, Elf, Hobbit, Katze, "
    "Hund, Vogel und keine. " , "sagt: "
  );


  AddCmd( ({ "frag" , "frage" }), "fragen" );
  AddCmd( ({ "trete" , "tritt" , "tret" }), "treten" );
  AddCmd( ({ "liebe" , "lieb" }), "lieben" );
  AddCmd( ({ "befehle" , "befiehl" }), "befehl" );
  AddCmd( ({ "aerger" , "aergere" }), "aergern" );
  AddCmd( ({ "kuess" , "kuesse" }), "kuessen" );
  AddCmd( ({ "knuddel" }), "knuddeln" );
}

reset() {
  object obj;

  ::reset();

  if ( !istwandler ) {
    obj=this_object();
    obj->SetProp(P_SHORT, "Ein Gestaltenwandler");
    obj->SetProp(P_LONG, 
      "Eine durchschimmernde Gestalt von etwa zwei Meter scheint der "
      "Mitbewohner von Zordan zu sein. Er macht hier im Zelt sauber und "
      "bringt ein wenig Ordnung in das Chaos. Im Moment kannst Du nicht "
      "viel von ihm erkennen, da er wohl keine richtige Gestalt hat. "
      "Normalerweise ist er recht freundlich aber Du solltest ihn besser "
      "nicht aergern. Wer weiss in was er sich dann verwandelt. Ausserdem "
      "ist er durchaus in der Lage, Dir ein paar Fragen zu beantworten. "
      "Er traegt eine Kette mit einem Schild um den Hals. "
      );
    obj->SetProp(P_NAME, "Gestaltenwandler");
    obj->SetProp(P_GENDER, MALE);
    obj->set_living_name ("Gestaltenwandler");
    obj->SetProp(P_SIZE, 180+random(30));
    obj->RemoveId( ({"katze","hund","vogel","mensch","elf","hobbit","zwerg","monster"}) );
    say("Der Gestaltenwandler verliert auf einmal seine Gestalt.\n");
    istwandler=1;
  }
}
/* -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
    ausfuehrbare Funktionen
   -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=- */

int fragen ( string str ) {
  string wen, frage;
  object obj;

  if ( !str || str=="" ) return 0;
  if (sscanf(str, "%s nach %s", wen, frage)!=2) return 0;
  if (!id(wen)) return 0;
  if ( getuid(this_player())=="zordan" && frage == "post" ) {
    command ("gib alles an zordan");
    return 1;
  }  
  obj=this_object();
  switch (frage) {
    case "keine" : {
      obj->SetProp(P_SHORT, "Ein Gestaltenwandler");
      obj->SetProp(P_LONG, 
        "Eine durchschimmernde Gestalt von etwa zwei Meter scheint der "
        "Mitbewohner von Zordan zu sein. Er macht hier im Zelt sauber und "
        "bringt ein wenig Ordnung in das Chaos. Im Moment kannst Du nicht "
        "viel von ihm erkennen, da er wohl keine richtige Gestalt hat. "
        "Normalerweise ist er recht freundlich aber Du solltest ihn besser "
        "nicht aergern. Wer weiss in was er sich dann verwandelt. Ausserdem "
        "ist er durchaus in der Lage, Dir ein paar Fragen zu beantworten. "
        "Er traegt eine Kette mit einem Schild um den Hals. "
        );
      obj->SetProp(P_NAME, "Gestaltenwandler");
      obj->SetProp(P_GENDER, MALE);
      obj->set_living_name ("Gestaltenwandler");
      obj->SetProp(P_SIZE, 180+random(30));
      obj->RemoveId( ({"katze","hund","vogel","mensch","elf","hobbit","zwerg","monster"}) );
      istwandler=1;
      tell_room(environment(),this_player()->name()+" fragt den Wandler "
          +"nach Keine.\n", ({this_player() }) );
      say("Der Gestaltenwandler verliert auf einmal seine Gestalt.\n");
      return 1;
      }
    case "mensch" : {
      obj->SetProp(P_SHORT, "Ein Mensch");
      obj->SetProp(P_LONG,
        "Im Moment ist der Gestaltenwandler ein ganz normaler Mensch. "
        "Er ist nicht viel groesser als Du und geht seiner normalen "
        "Beschaeftigung des Aufraeumens nach. Kleidung traegt er allerdings "
        "nicht. Ein kleines Schild haengt ihm um den Hals. "
        );
      obj->SetProp(P_NAME, "Mensch");
      obj->RemoveId( ({"katze","hund","vogel","mensch","elf","hobbit","zwerg","monster"}) );
      obj->AddId( "mensch" );
      obj->SetProp(P_GENDER, MALE);
      obj->set_living_name ("Mensch");
      obj->SetProp(P_SIZE, 160+random(20));
      istwandler=0;
      tell_room(environment(),this_player()->name()+" fragt den Wandler "
          +"nach Mensch.\n", ({this_player() }) );
      say("Der Gestaltenwandler verwandelt sich in einen Menschen.\n");
      return 1;
      }
    case "zwerg" : {
      obj->SetProp(P_SHORT, "Ein Zwerg");
      obj->SetProp(P_LONG,
        "Im Moment ist der Gestaltenwandler ein Zwerg. "
        "Starke Muskeln protzen unter seiner nicht vorhandenen Kleidung "
        "hervor. Mit dieser Gestalt faengt er an die schweren Sachen "
        "im Zelt aufzuraeumen. Um den Hals traegt er ein kleines Schild. "
        );
      obj->SetProp(P_NAME, "Zwerg");
      obj->RemoveId( ({"katze","hund","vogel","mensch","elf","hobbit","zwerg","monster"}) );
      obj->AddId( "zwerg" );
      obj->SetProp(P_GENDER, MALE);
      obj->set_living_name ("Zwerg");
      obj->SetProp(P_SIZE, 60+random(30));
      istwandler=0;
      tell_room(environment(),this_player()->name()+" fragt den Wandler "
          +"nach Zwerg.\n", ({this_player() }) );
      say("Der Gestaltenwandler verwandelt sich in einen Zwerg.\n");
      return 1;
      }
    case "elf" : {
      obj->SetProp(P_SHORT, "Ein Elf");
      obj->SetProp(P_LONG,
        "Im Moment ist der Gestaltenwandler ein ganz normaler Elf. "
        "Mit seinen spitzen Ohren lauscht er wohl den Ungeziefern nach "
        "und faengt sie dann ein. Voellig nackt steht er vor Dir. Aber "
        "das scheint ihn nicht sonderlich zu stoeren. Nur ein kleines "
        "Schild haengt um seinen Hals. "
        );
      obj->SetProp(P_NAME, "Elf");
      obj->RemoveId( ({"katze","hund","vogel","mensch","elf","hobbit","zwerg","monster"}) );
      obj->AddId( "elf" );
      obj->SetProp(P_GENDER, MALE);
      obj->set_living_name ("Eld");
      obj->SetProp(P_SIZE, 220+random(30));
      istwandler=0;
      tell_room(environment(),this_player()->name()+" fragt den Wandler "
          +"nach Elf.\n", ({this_player() }) );
      say("Der Gestaltenwandler verwandelt sich in einen Elfen.\n");
      return 1;
      }
    case "hobbit" : {
      obj->SetProp(P_SHORT, "Ein Hobbit");
      obj->SetProp(P_LONG,
        "Im Moment ist der Gestaltenwandler ein pelziger Hobbit. "
        "Lauter wuscheliges Fell haengt ihm im Moment den ganzen Koerper "
        "herunter. Mit diesem Fell faengt er wohl manchmal den Staub ein, "
        "denn viel Staub ist hier ja nicht zu erkennen. Um den Hals traegt "
        "er ein kleines Schild. "
        );
      obj->SetProp(P_NAME, "Hobbit");
      obj->RemoveId( ({"katze","hund","vogel","mensch","elf","hobbit","zwerg","monster"}) );
      obj->AddId( "hobbit" );
      obj->SetProp(P_GENDER, MALE);
      obj->set_living_name ("Hobbit");
      obj->SetProp(P_SIZE, 170+random(10));
      istwandler=0;
      tell_room(environment(),this_player()->name()+" fragt den Wandler "
          +"nach Hobbit.\n", ({this_player() }) );
      say("Der Gestaltenwandler verwandelt sich in einen Hobbit.\n");
      return 1;
      }
    case "katze" : {
      obj->SetProp(P_SHORT, "Eine Katze");
      obj->SetProp(P_LONG,
        "Im Moment ist der Gestaltenwandler eine kleine suesse Katze. "
        "Sie schnurrt zufrieden und streicht zwischen Deinen Beinen durch. "
        "Ihr Fell ist weiss mit kleinen braunen Flaechen dazwischen. "
        "Um den Hals traegt sie eine kleine Kette mit einem Schild daran. "
        );
      obj->SetProp(P_NAME, "Katze");
      obj->RemoveId( ({"katze","hund","vogel","mensch","elf","hobbit","zwerg","monster"}) );
      obj->AddId( "katze" );
      obj->SetProp(P_GENDER, FEMALE);
      obj->set_living_name ("Katze");
      obj->SetProp(P_SIZE, 15+random(5));
      istwandler=0;
      tell_room(environment(),this_player()->name()+" fragt den Wandler "
          +"nach Katze.\n", ({this_player() }) );
      say("Der Gestaltenwandler verwandelt sich in eine kleine Katze.\n");
      return 1;
      }
    case "hund" : {
      obj->SetProp(P_SHORT, "Ein Hund");
      obj->SetProp(P_LONG,
        "Im Augenblick ist der Wandler ein suesser kleiner Hund. "
        "Er wedelt nett in Deine Richtung und schnueffelt an Dir. "
        "Sein braunes Fell schimmert hell auf im Schein des Feuers. "
        "An seinem Halsband traegt er ein kleines Schild. "
        );
      obj->SetProp(P_NAME, "Hund");
      obj->RemoveId( ({"katze","hund","vogel","mensch","elf","hobbit","zwerg","monster"}) );
      obj->AddId( "hund" );
      obj->SetProp(P_GENDER, MALE);
      obj->set_living_name ("hund");
      obj->SetProp(P_SIZE, 30+random(10));
      istwandler=0;
      tell_room(environment(),this_player()->name()+" fragt den Wandler "
          +"nach Hund.\n", ({this_player() }) );
      say("Der Gestaltenwandler verwandelt sich in einen Hund.\n");
      return 1;
      }
    case "vogel" : {
      obj->SetProp(P_SHORT, "Ein Vogel");
      obj->SetProp(P_LONG,
        "Im Augenblick ist der Wandler ein kleiner Vogel. "
        "Er fliegt durch das Zelt und zwitschert dabei ganz froehlich. "
        "Manchmal setzt er sich auch auf Deine Schulter und schaut Dich "
        "frech an. Ein kleines Schild haengt ihm um den Hals. "
        );
      obj->SetProp(P_NAME, "Vogel");
      obj->RemoveId( ({"katze","hund","vogel","mensch","elf","hobbit","zwerg","monster"}) );
      obj->AddId( "vogel" );
      obj->SetProp(P_GENDER, MALE);
      obj->set_living_name ("vogel");
      obj->SetProp(P_SIZE, 10+random(5));
      istwandler=0;
      tell_room(environment(),this_player()->name()+" fragt den Wandler "
          +"nach Vogel.\n", ({this_player() }) );
      say("Der Gestaltenwandler verwandelt sich in einen Vogel.\n");
      return 1;
      }
  }
  return 0;
}

int treten ( string str ) {
  if ( (istwandler==1) && ( (str == "wandler") || (str == "gestaltenwandler") )) {
    write ("Du versuchst den Wandler zu treten. Aber da er keine Gestalt "
          +"hat kannst Du\nihn nicht treffen.\n" );
    tell_room(environment(),this_player()->name()+" versucht den Gestaltenwandler "
          +"zu treten, verfehlt ihn aber.\n", ({this_player() }) );
    return 1;
  }
  return 0;
}

int befehl ( string str ) {
  notify_fail("Der Wandler belehrt Dich: Nur Zordan kann mir Befehle geben !\n");
  if ( this_player()->name() == "Zordan" && str != "" && str ) {
    tell_room(environment(),"Zordan fluestert dem Gestaltenwandler etwas zu."
      +"\n", ({this_player() }) );
    command(str);
    return 1;
  }
  tell_room(environment(),this_player()->name()+" fluestert dem Wandler etwas "
    +"zu wird aber ignoriert.\n", ({this_player() }) );
  return 0;
}

int aergern ( string str ) {
  object obj;
  notify_fail("Wen willst Du aergern ?\n");
  if ( str == "wandler" || str == "gestaltenwandler" ) {
    obj=this_object();
    obj->SetProp(P_SHORT, "Ein blutruenstiges Monster");
    obj->SetProp(P_LONG,
      "Im Augenblick ist der Wandler ein blutruenstiges Monster das "
      + this_player()->name() + " dauernd anrempelt, tritt und vollsabbert. "
      "Es ist ziemlich sauer wird aber dennoch genug Charme haben, Dich "
      "nicht aufzufressen. Um den Hals traegt es ein Schild. "
      );
    obj->SetProp(P_NAME, "blutruenstiges Monster");
    obj->RemoveId( ({"katze","hund","vogel","mensch","elf","hobbit","zwerg","monster"}) );
    obj->SetProp(P_GENDER, NEUTER);
    obj->set_living_name ("blutruenstiges Monster");
    obj->AddId( "monster" );
    obj->SetProp(P_SIZE, 250+random(50));
    istwandler=0;
    tell_room(environment(),this_player()->name()+" aergert den Wandler."
        +"\n", ({this_player() }) );
    say("Der Gestaltenwandler verwandelt sich in ein blutruenstiges Monster.\n");

    return 1;
  }
  return 0;
}

int kuessen ( string str ) {
  if ( str == "wandler" || str == "gestaltenwandler" ) {
    tell_room(environment(),this_player()->name()+" kuesst den Gestaltenwandler."
      +"\n", ({this_player() }) );
    tell_room(environment(),"Der Gestaltenwandler gibt "
      +this_player()->name()+" eine heftige Ohrfeige.\n", ({this_player() }) );
    write("Der Gestaltenwandler gibt Dir eine heftige Ohrfeige. Deine "
      "Wangen gluehen\nund schmerzen richtig arg.\n");
    return 1;
  }
  return 0;
}

int lieben ( string str ) {
  if ( str == "wandler" || str == "gestaltenwandler" ) {
    tell_room(environment(),this_player()->name()+" faellt ueber "
      +"den Gestaltenwandler her.\n", ({this_player() }) );
    write("Der Gestaltenwandler verliert seine Gestalt und verschmilzt "
      "mit Dir.\nSolch ein Gefuehl hast Du in Deinem Leben noch nicht erlebt. "
      "Du schwebst\nnicht nur im 7. Himmel. Nein, Dein Herz rast, Dein "
      "Magen tanzt Tango,\nDein Leib zittert und Du moechtest nie wieder "
      "zurueck. Leider verlaesst\nder Gestaltenwandler Deinen Koerper nach "
      "einer Weile.\n");
    return 1;
  }
  return 0;
}

int knuddeln ( string str ) {
  if ( str == "wandler" || str == "gestaltenwandler" ) {
    tell_room(environment(),this_player()->name()+" knuddelt den "
      +"Gestaltenwandler durch und freut sich.\n", ({this_player() }) );
    write("Der Gestaltenwandler ist hoch erfreut ueber Dich und knuddelt "
       "Dich fest.\n");
    return 1;
  }
  return 0;
}

