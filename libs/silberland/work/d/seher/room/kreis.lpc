
/*
** Standard-Objekt fuer virtuellen Compiler fuer magischen Kreis
** ---
** 96-09-24  Woody@SiSt
*/

inherit "std/room";

#include <properties.h>
#include "files.h"

#define SEHERTORMASTER "/obj/sehertormaster"

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_INT_LONG,break_string(
    "Du stehst auf einem etwas kreisfoermigen Gang, der von Westen "
    "nach Osten fuehrt. An den Waenden haengen ueberall irgendwie "+
    "magisch glitzernde und funkelnde Gemaelde und Bilder von "
    "verschiedensten Szenerien dieser Welt. Boden, Decke und Waende "+
    "selbst sind tiefschwarz und scheinen jegliches Licht foermlich "+
    "aufzusaugen. Du bist froh, Seher zu sein, denn so kannst Du "
    "dennoch etwas sehen... aber etwas mulmig ist Dir doch.", 78));

  // muss UNBEDINGT NACH dem SetProp P_INT_LONG kommen !!!
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_INT_SHORT,"Im magischen Kreis");
  AddDetail(({"wand","waende"}),break_string(
	"Die Waende sind tiefschwarz und strahlen irgendwie eine "+
	"unheimliche Atmosphaere aus. Ausserdem kannst Du etliche "+
	"Gemaelde an ihnen erkennen.", 78));
  AddSpecialDetail(({"gemaelde", "bild", "bilder"}), "d_gemaelde");
  previous_object()->CustomizeObject();
}

string d_gemaelde()
{
  switch(QueryProp(P_NR))
  {
    case 1: return "Du siehst eine belebte Hauptstrasse.\n";
    case 2: return "Du siehst eine dunkle Hoehle.\n";
    case 3: return "Du siehst einen Palmenstrand.\n";
    default: return "Du siehst gar nix.\n";
  }
}
