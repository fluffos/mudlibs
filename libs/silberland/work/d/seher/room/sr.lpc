
/*
** Der Startraum zum magischen Kreis.
** teleportiert in "kreis:getuid[nummer]"
** ---
** 96-09-24  Woody@SiSt
*/

#include <properties.h>
#include <moving.h>
#include "files.h"

inherit "std/room";

void create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Vor dem magischen Kreis");
  SetProp (P_INT_LONG,
    "Du stehst im Vorraum zum magischen Kreis. Nach unten kannst Du ihn "+
    "betreten, aber bedenke, dass Du von dort nicht mehr hierher zurueck "+
    "gelangst...");

  // AddExit( "oben", "in den magischen Kreis#"+ROOM("kreis[1]") );
  AddSpecialExit( "unten", "unten");
}

unten()
{
  TP->move(ROOM("kreis:"+getuid(TP)+"["+(MIN_NR+random(MAX_NR-MIN_NR+1))+"]"),
    M_GO, "in den magischen Kreis");
  return 1;
}
