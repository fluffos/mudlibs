#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include "files.h"

inherit "std/virtual/v_compiler";

create()
{
  ::create();
  SetProp(P_COMPILER_PATH, ROOM("") );
  SetProp(P_STD_OBJECT, ROOM("kreis"));
  SetProp(P_VALID_NAME, "kreis");
  SetProp(P_MIN_NR, MIN_NR);
  SetProp(P_MAX_NR, MAX_NR);
}

string Validate(string file)
{
  int x;
  string path, name, who;

  file = ::Validate(file);
  if((sscanf(file, "%s:%s[%d]", name, who, x) == 3) &&
	name == QueryProp(P_VALID_NAME) &&
	(x >= QueryProp(P_MIN_NR) && x <= QueryProp(P_MAX_NR)))
    return file;
}

int CustomizeObject()
{
  string name,foo,who;
  int x;
  if(!(name = ::CustomizeObject()) || sscanf(name,"%s:%s[%d]",foo,who,x)!=3)
    return 0;
  PO->SetProp(P_NR, x);
  if (!IS_SEER(TP)) PO->SetProp(P_LIGHT, 0);
  if(x > QueryProp(P_MIN_NR))
    PO->AddExit("westen",ROOM("kreis:"+getuid(TP)+"["+(x-1)+"]"));
  else
    PO->AddExit("westen",ROOM("kreis:"+getuid(TP)+"["+QueryProp(P_MAX_NR)+"]"));
  if(x < QueryProp(P_MAX_NR))
    PO->AddExit("osten",ROOM("kreis:"+getuid(TP)+"["+(x+1)+"]"));
  else
    PO->AddExit("osten",ROOM("kreis:"+getuid(TP)+"["+QueryProp(P_MIN_NR)+"]"));
  if(x==QueryProp(P_MIN_NR))
  {
    PO->AddExit("oben",ROOM("sr"));
    PO->SetProp(P_INT_LONG, PO->QueryProp(P_INT_LONG)+
      "Nach oben fuehrt eine Luke zurueck zu dem Ort, "+
      "von dem Du gekommen bist.\n");
  /*
    PO->NewDoor("zurueck",ROOM("sr"),({"falltuer","klappe","luke","tuer"}),({
	D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
	D_NAME, "Falltuer",
	D_GENDER, FEMALE,
	D_SHORT, "Eine %se Falltuer im Boden fuehrt zurueck.",
	D_LONG, "Die Falltuer im Fussboden fuehrt zurueck zu dem Ort, "+
	        "von dem Du gekommen bist.\n" }) );
  */
  }
  return 1;
}
