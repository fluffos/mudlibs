/*
** Orkisch-Fluch, original vom Eumel
** 4.11.2003 
** Feyaria@SilberLand
*/

inherit "std/thing";

#include <properties.h>

object owner;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du sprichst Orkisch.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\norkischfluch", "\norkisch", "\nsprachfluch"}));
  owner=0;
}


reset()
{ 
  ::reset();
  remove();
}


init()
{
  ::init();
  if (owner && interactive(owner))
  {
    owner->SetProp(P_PERM_STRING, 0);
    owner=0;
  }
  if (environment()==this_player())
  {
    owner=this_player();
    owner->SetProp(P_PERM_STRING, this_object());
  }

}

string lower_case_but_first(string text) 
{
  int i;
  string *worte;
  worte=new_explode(text," ");
  for (i=0; i<sizeof(worte); i++) {
    worte[i]= worte[i][0..0]+lower_case(worte[i][1..<0]);
  }
  text = implode(worte," ");
  return text;
}

string permutate_string (string str)
{
  string transform;

  transform=lower_case_but_first(str);
  transform=implode(explode(transform, "."), "...Hugh. ");
  transform=regreplace(transform, "(-|_|=|#|+|§|/|$|%|$)", "", 1);
  transform=regreplace(transform, "nn", "n", 1);
  transform=regreplace(transform, "(chs|ks|gs)", "xx", 1);
  transform=regreplace(transform, "( ist | sind | bin | bist | seit | Ist | Sind | Bin | Bist | Seit )", 
      " sein ", 1);
  transform=regreplace(transform, "( mich| mir|Mir|Mich)", 
      " dummes wertloses "+this_player()->name(), 1);
  transform=regreplace(transform, "( meinen| meiner| meinem| meine| mein)", 
      "von unnuetzes toerichtes "+this_player()->name(), 1);
  transform=regreplace(transform, "( ich|Ich )", 
      " armseliges bedauerliches "+this_player()->name(), 1);
  transform=regreplace(transform, "( Der | Die | Das | der | die | das | Ein | "
      "ein | eine | eines | wir | Wir | Er | er | Sie | sie | Es | Es )", " ", 1);
  transform=regreplace(transform, "sch", "s", 1);
  transform=regreplace(transform, "Sch", "sss", 1);
  transform=regreplace(transform, "ch", "tsch", 1);
  transform=regreplace(transform, "Ch", "K", 1);
  transform=regreplace(transform, " n", "*+*", 1);
  transform=regreplace(transform, "n", "ng", 1);
  transform=regreplace(transform, "S", "Z", 1);
  transform=regreplace(transform, "a", "o", 1);
  transform=regreplace(transform, "r", "rrr", 1);
  transform=regreplace(transform, ",", " oeh...", 1);
  transform=regreplace(transform, "?", " ...hompf??", 1);
  transform=regreplace(transform, "!", "...Ieeeeeeyyyi!!!", 1);
  transform=regreplace(transform, "(;|,|:)", " howuu:", 1);
  return transform;
}

string extra_look()
{
  if (environment()->QueryProp(P_GENDER)==2)
    return "Sie ist verflucht und kann nicht mehr richtig sprechen.\n";
  else
    return "Er ist verflucht und kann nicht mehr richtig sprechen.\n";
}
