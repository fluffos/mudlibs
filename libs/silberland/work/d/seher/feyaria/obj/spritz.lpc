// /players/feyaria/seher/spritz.c
// Spritzpistole fuer Seherladen
// 1997-01-15 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine bunte Spritzpistole");
  SetProp(P_LONG, BS( 
    "Das ist eine bunte Spritzpistole. Mit dem Befehl 'splash' kannst Du "
    "andere Spieler bespritzen.") );
  SetProp(P_NAME, "Spritzpistole");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"pistole", "spritzpistole", "SEHER\nspritzpistole"}) );

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
}
