// /players/feyaria/seher/flamm.c
// Mini-Flammenwerfer fuer Seherladen
// 1997-01-15 Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Mini-Flammenwerfer");
  SetProp(P_LONG, BS( 
    "Das ist ein Mini-Flammenwerfer. Mit dem Befehl 'flame' kannst Du ihn "
    "auf einen anderen Spieler abfeuern.") );
  SetProp(P_NAME, "Mini-Flammenwerfer");
  SetProp(P_GENDER, MALE);
  AddId( ({"flammenwerfer", "miniflammenwerfer", "mini-flammenwerfer",
       "werfer","SEHER\nflammenwerfer"}) );

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);

}
