
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

object clon;
string name;

init() {
  ::init();
  if (MENV && !interactive(MENV)) {
    call_out("remove",0);
  } else if (clon==0) {
    clon=TP;
  } else if (TP != clon) {
    if (find_call_out("undweg") == -1) {
      call_out("undweg",1800);
    }
  }
}

create() {
  if (!is_clone(TO)) return;
  ::create();

  clon=0;

  SetProp(P_SHORT, "Ein Knutschfleck");
  SetProp(P_LONG, 
    "Du kannst diesen Knutschfleck jemandem, den Du sehr magst, auf den Hals "
    "druecken. Dazu gibst Du einfach 'Knutschfleck <Person>' ein." );
  SetProp(P_NAME, "Knutschfleck");
  SetProp(P_INFO, "Was soll es schon so besonderes an einem Knutschfleck geben?\n");
  SetProp(P_GENDER, MALE);
  AddId( ({ "knutschfleck","fleck" }) );

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, "Den Knutschfleck wuerdest Du niemals hergeben.\n");
  SetProp(P_NEVERDROP, 1);

  AddCmd("knutschfleck","knutschfkt");
}

string extra_look() {
  if ((MENV) && (MENV == clon)) return "";
  if (environment()->QueryProp(P_GENDER)==MALE)
    return "Er hat einen dicken Knutschfleck von "+name+" am Hals.\n";
  else
    return "Sie hat einen dicken Knutschfleck von "+name+" am Hals.\n";
}

undweg() {
  if (MENV) {
    tell_object(MENV,BS(
      "Der Knutschfleck von "+name+" verblasst und verschwindet." ));
  }
  ME->remove();
}

int knutschfkt(string str ) {
  object ob;
  string opfer,*ignore;
  notify_fail( "Wem moechtest Du einen Knutschflekt saugen?\n" );
  if (!str) return 0;
  if (ob=find_player(str)) {
    if (ob->QueryProp(P_INVIS) != 0) return 0;
    notify_fail( "Dir selber kannst Du keinen Knutschfleck saugen!\n" );
    if (TP==ob) return 0;
    notify_fail( CAP(str)+" muss schon hier im Raum sein!\n" );
    if (!present(ob,ENV(MENV))) return 0;
    notify_fail( CAP(str)+" muss ein Spieler sein!\n" );
    if (!interactive(ob)) return 0;
    opfer=CAP(ob->Name());
    notify_fail( CAP(str)+" hat schon einen Knutschfleck!\n" );
    if (present("knutschfleck2",ob)) return 0;
    notify_fail( "Du kannst dem eigenen Geschlecht keinen Knutschfleck machen!\n" );
    if (TP->QueryProp(P_GENDER) == ob->QueryProp(P_GENDER)) return 0;
    notify_fail( opfer+" ignoriert Deinen Knutschfleckversuch!\n" );
    if (pointerp(ignore=ob->QueryProp(P_IGNORE))) {
       if (member(ignore,getuid(TP)) >= 0) return 0;
       if (member(ignore,"knutschfleck") >= 0) return 0;
       if (member(ignore,"knutschfleck."+getuid(TP)) >= 0) return 0;
    }
    name=TPN;
    tell_object(TP,BS(
      "Du drueckst Dich zaertlich an "+opfer+" und kuesst "+ob->QueryPronoun(WER)+
      " leidenschaftlich. Dann faengt Du an "+ob->QueryPossPronoun(2)+"n Hals "
      "auszusaugen. Nach ein paar Minuten bist Du zufrieden und hinterlaesst "
      "einen deutlich leuchtenden Knutschfleck."));
    tell_object(TP,"Du grinst "+opfer+" an.\n");
    tell_object(ob,BS(
      TPN+" drueckt Dich zaertlich an sich und kuesst Dich leidenschaftlich. "
      "Auf einmal faengt "+TP->QueryPronoun(WER)+" aber gemeinerweise an Deinem Hals "
      "auszusaugen. Du moechtest "+TP->QueryPronoun(WESSEN)+" abschuetteln. Doch "
      "es ist zu spaet. Es entsteht ein stark leuchtender Knutschfleck an Deinem Hals."));
    tell_object(ob,CAP(TPN)+" grinst Dich an.\n");
    tell_room(ENV(TP),BS(
      TPN+" drueckt sich zaertlich an "+opfer+" und kuesst "+ob->QueryPronoun(WESSEN)+
      " leidenschaftlich. Doch dann faengt "+TP->QueryPronoun(WER)+" an, an dem "
      "Hals von "+opfer+" zu saugen. Es entsteht ein wunderbar leuchtender "
      "Knutschfleck."), ({ TP,ob}) );
    ME->SetProp(P_SHORT, 0);
    ME->SetProp(P_LONG,  0);
    ME->AddId("knutschfleck2");
    ME->RemoveId("knutschfleck");
    ME->RemoveId("fleck");
    ME->RemoveCmd(0);
    ME->move(ob,M_SILENT + M_NOCHECK);
    return 1;
  }
  return 0;
}

QueryProp(string prop) {
  if (prop==P_SHORT && environment() && TP && MENV!=TP ) {
    if (!IS_WIZARD(TP)) {
      tell_object(MENV,
        TPN+" schaut sich Deinen Knutschfleck an und grinst.\n"); 
    }
  }
  return ::QueryProp(prop); 
}
