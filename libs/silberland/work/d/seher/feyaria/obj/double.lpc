/*
** Doppel-Fluch
** 4.11.2003 
** Feyaria@SilberLand
*/

inherit "std/thing";

#include <properties.h>

object owner;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du sprichst mit doppelt.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\ndoppelfluch", "\ndoppel", "\nsprachfluch"}));
  owner=0;
}


reset()
{ 
  ::reset();
  remove();
}


init()
{
  ::init();
  if (owner && interactive(owner))
  {
    owner->SetProp(P_PERM_STRING, 0);
    owner=0;
  }
  if (environment()==this_player())
  {
    owner=this_player();
    owner->SetProp(P_PERM_STRING, this_object());
  }

}

string permutate_string (string str)
{
  string transform;
  int i;

  transform=str;
  transform=regreplace(transform, "a", "aa", 1);
  transform=regreplace(transform, "A", "AA", 1);
  transform=regreplace(transform, "e", "ee", 1);
  transform=regreplace(transform, "E", "EE", 1);
  transform=regreplace(transform, "i", "ii", 1);
  transform=regreplace(transform, "I", "II", 1);
  transform=regreplace(transform, "o", "oo", 1);
  transform=regreplace(transform, "O", "oo", 1);
  transform=regreplace(transform, "u", "uu", 1);
  transform=regreplace(transform, "U", "UU", 1);
  return transform;
}

string extra_look()
{
  if (environment()->QueryProp(P_GENDER)==2)
    return "Sie ist verflucht und kann nicht mehr richtig sprechen.\n";
  else
    return "Er ist verflucht und kann nicht mehr richtig sprechen.\n";
}
