/*
** Sternchen-Fluch
** 12.08.2002
** Feyaria@SilberLand
*/

inherit "std/thing";

#include <properties.h>

object owner;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du sprichst mit falscher Reihenfolge.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\nyodafluch", "\nyoda", "\nsprachfluch"}));
  owner=0;
}


void reset()
{ 
  if (!is_clone(this_object())) return;
  ::reset();
  remove();
}


void init()
{
  ::init();
  if (owner && interactive(owner))
  {
    owner->SetProp(P_PERM_STRING, 0);
    owner=0;
  }
  if (environment()==this_player())
  {
    owner=this_player();
    owner->SetProp(P_PERM_STRING, this_object());
  }

}

string permutate_string (string str)
{
  string transformed;
  string *strs;
  int i;

  transformed="";
  strs=explode(regreplace(str, "(-|_|#|:|,|;|+|=)", " ", 1), " ");
  if(!sizeof(strs))
    return "";
  do
  {
    i=random(sizeof(strs));
    transformed+=strs[i]+" ";
    strs-=({strs[i]});
  }
  while(sizeof(strs));
  return transformed;
}

string extra_look()
{
  if (environment()->QueryProp(P_GENDER)==2)
    return "Sie ist verflucht und kann nicht mehr richtig sprechen.\n";
  else
    return "Er ist verflucht und kann nicht mehr richtig sprechen.\n";
}
