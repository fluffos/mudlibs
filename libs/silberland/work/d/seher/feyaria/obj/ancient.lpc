/*
** Ancient-Fluch, eine uralte Sprache
** 4.11.2003 
** Feyaria@SilberLand
*/

inherit "std/thing";

#include <properties.h>

object owner;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du sprichst eine alte Sprache.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\nancientfluch", "\nancient", "\nsprachfluch"}));
  owner=0;
}


void reset()
{ 
  ::reset();
  remove();
}


void init()
{
  ::init();
  if (owner && interactive(owner))
  {
    owner->SetProp(P_PERM_STRING, 0);
    owner=0;
  }
  if (environment()==this_player())
  {
    owner=this_player();
    owner->SetProp(P_PERM_STRING, this_object());
  }

}

string lower_case_but_first(string text) 
{
  int i;
  string *worte;
  worte=new_explode(text," ");
  for (i=0; i<sizeof(worte); i++) {
    worte[i]= worte[i][0..0]+lower_case(worte[i][1..<0]);
  }
  text = implode(worte," ");
  return text;
}

string permutate_string (string str)
{
  string transform;

  transform=lower_case_but_first(str);
  transform=regreplace(transform, "b", "p", 1);
  transform=regreplace(transform, "c", "k", 1);
  transform=regreplace(transform, "d", "t", 1);
  transform=regreplace(transform, "e", "o", 1);
  transform=regreplace(transform, "f", "v", 1);
  transform=regreplace(transform, "g", "k", 1);
  transform=regreplace(transform, "h", "", 1);
  transform=regreplace(transform, "i", "u", 1);
  transform=regreplace(transform, "j", "y", 1);
  transform=regreplace(transform, "m", "n", 1);
  transform=regreplace(transform, "w", "v", 1);
  transform=regreplace(transform, "B", "P", 1);
  transform=regreplace(transform, "C", "Z", 1);
  transform=regreplace(transform, "D", "T", 1);
  transform=regreplace(transform, "E", "O", 1);
  transform=regreplace(transform, "F", "V", 1);
  transform=regreplace(transform, "G", "K", 1);
  transform=regreplace(transform, "I", "U", 1);
  transform=regreplace(transform, "J", "Y", 1);
  transform=regreplace(transform, "M", "N", 1);
  transform=regreplace(transform, "W", "V", 1);
  return transform;
}

string extra_look()
{
  if (environment()->QueryProp(P_GENDER)==2)
    return "Sie ist verflucht und kann nicht mehr richtig sprechen.\n";
  else
    return "Er ist verflucht und kann nicht mehr richtig sprechen.\n";
}
