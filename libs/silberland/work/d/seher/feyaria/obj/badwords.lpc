inherit "std/thing";

#include <properties.h>

object owner;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du sprichst keine boesen Woerter mehr.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\nbadwordsfluch", "\nbadwords", "\nsprachfluch"}));
  owner=0;
}


void reset()
{ 
  ::reset();
//  remove();
}


void init()
{
  ::init();
  if (owner && interactive(owner))
  {
    owner->SetProp(P_PERM_STRING, 0);
    owner=0;
  }
  if (environment()==this_player())
  {
    owner=this_player();
    owner->SetProp(P_PERM_STRING, this_object());
  }
}

string permutate_string (string str)
{
  string transformed;
  int i;

  str = lower_case(str);
  transformed = regreplace(str, "scheisse", "********", 1);
  transformed = regreplace(str, "shit", "****", 1);
  transformed = regreplace(str, "fuck", "****", 1);
  transformed = regreplace(str, "fick", "****", 1);
  transformed = regreplace(str, "beschiss", "********", 1);
  transformed = regreplace(str, "suck", "****", 1);
  transformed = regreplace(str, "mist", "****", 1);
  transformed = regreplace(str, "damn", "****", 1);
  transformed = regreplace(str, "verdammt", "********", 1);
  transformed = regreplace(str, "kacke", "*****", 1);
  transformed = regreplace(str, "arsch", "*****", 1);
  return transformed;
}

string extra_look()
{
  if (environment()->QueryProp(P_GENDER)==2)
    return "Sie ist verflucht und kann nicht mehr richtig sprechen.\n";
  else
    return "Er ist verflucht und kann nicht mehr richtig sprechen.\n";
}
