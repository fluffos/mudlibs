";,`%%%%%%%%%%`;;,;;'%%%%%%%%%%%%%'%%'"+g+"  `;;;;;,;, %;;;\n"+f+
";;;,`%%%%%%%%%%%,; ..`%%%%%%%%;'%%%'"+g+"    `;;;;,;; %%;;\n"+f+
