   "                `W::::::::W.`WWWWWW'.::::::::WWWW'\n"
   "                   `WW:::::::.`WWWWW ::::::::WWW'\n"
   "                     `WWW:::::.`WWWW':::::::WW'\n"
   "                       `:WWWWW..`:'..::WWWWW'\n"
   "                          ````."+g+"WWWWWW"+f+"...'\n"
+g+"                              :WWWWWWWW:\n"
   "                              `.WWWWWW'\n"
   "                               .WW.VWW.....'\n"
   "                         `....WW`VVVWWWWW'\n"
   "                           `WWW:' VVV ```\n"
   "                                  VVV\n"
     +ANSI_NORMAL+"\n");
        break;
      
      case 7:
        tell_object(player,f+ 
"       .     .       "+h+"      .\n"+f+
"     ...  :``..':  "+h+"...  :``..':                    "+k+".     .\n"+f+
"      : ````.'   "+h+":'': ````.'   :''::'       "+k+"':''' :'..``:':...  .\n"+f+
"    ..:..  :    "+h+", ..:..  :     .'' :          "+k+": ''  :    :  : ''.\n"+f+
" ``.    `:    ."+h+"``.    `:    .'     :          "+k+":  : :      ::   :\n"+f+
"     :    :   :    "+h+":    :   :        :       "+k+":    ::      ::  :\n"+f+
"      :   :   :     "+h+":   :   :         :      "+k+":     :      :  :\n"+f+
"      :    :   :    "+h+":    :   :        :       "+k+": ...:    :  :\n"+f+
"       :    :   :..'"+h+"':    :   :..''''``::"+k+"...::.    ''''.``..\n"+f+
"        : ...:..'     "+h+": ...:..'     .'' "+k+".:           ..:''\n"+f+
"        .'   .'       "+h+".'   .'  "+g+".::::"+h+"' "+k+".: ...'''"+g+":::::..\n"+f+
