    +ANSI_NORMAL+"\n");
        break;

      default:
        write("So eine Blume gibts leider nicht.\n");
        return 1;
    }
    if( getuid(TP)!="feyaria" )
      call_out("remove",0);
    return 1;
  }
  else
    notify_fail("Spieler "+ CAP(wen) +" ist ja gar nicht da!\n");
  return 0;
}


int blumenstrauss(string str)
{
  object player;
  string wen;
  string *f;
  string g;
  int i;  
  notify_fail(
    "Syntax: blumenstrauss fuer <name> <farb1> <2> <3> <4> <5> <6>\n");
  f= ({"", "", "", "", "", "", ""});
  if( !str ) return 0;
  if( sscanf(str,"fuer %s %s %s %s %s %s %s",
                       wen,f[1],f[2],f[3],f[4],f[5],f[6])!=7 )
    return 0;
  if( player=find_player(wen) )
  {
    g= ANSI_NORMAL+ANSI_GREEN;
    for (i=1; i<=6; i++)
    {
      if( !stringp(f[i]=blumenfarbe(f[i])) ) return 1;
    }
    write("Du sendest einen Blumenstrauss an "+ CAP(wen) +".\n");
    tell_object( player, TPN+ " sendet Dir einen grossen Blumenstrauss.\n\n");
                                                                  
    tell_object(player, 
 f[2]+"                          .~.~.\n"
      "                        _/     \\_         "+f[3]+"  .~.~.\n"+
 f[1]+"        .~.~.         "+f[2]+"~' \\     / `~       "+f[3]+
      "_/     \\_\n"+
 f[1]+"      _/     \\_      "+f[2]+":    .- -.    :    "+f[3]+
      "~' \\     / `~\n"+
 f[1]+"    ~' \\     / `~    "+f[2]+"\\ _ -`- -'- _ /   "+f[3]+
      ":    .- -.    :\n"+
 f[1]+"   :    .- -.    :    "+f[2]+":     :     :    "+f[3]+
      "\\ _ -`- -'- _ /\n"+
 f[1]+"   \\ _ -`- -'- _ /    "+f[2]+"`..   :   ..'     "+f[3]+
      ":     :     :\n"+
 f[1]+"    :     :     :        "+f[2]+"`.~^~.'        "+f[3]+"`..   :   ..'"
      "     "+f[4]+".~.~.\n"+
 f[1]+"    `..   :   ..'          "+g+"| |             "+f[3]+"`.~^~.'"
      "      "+f[4]+"_/     \\_\n"+
 f[1]+"       `.~^~.'             "+g+"; :        "+f[6]+".~.~. "+g+" / / "
      "     "+f[4]+"~' \\     / `~\n"+
