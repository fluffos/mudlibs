"              @m@'                 "+g+"`;%;             "+f+"`@\n"
"              `@'                   "+g+";%;.             "+f+"'\n"
"               `                    "+g+"`;%;\n"
"                                     "+g+";%;.\n"
    +ANSI_NORMAL+"\n");
