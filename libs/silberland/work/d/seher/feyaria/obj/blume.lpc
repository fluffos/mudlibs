// /players/feyaria/seher/blume.c
// Eine Blume zum Verschicken fuer Seherladen
// 1997-01-15 Feyaria@SilberLand
// 2000-01-05 Zordan BugFix in 'sende'

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <ansi.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine schoene Blume");
  SetProp(P_LONG, BS( 
    "Das ist eine schoene Blume. Mit dem Befehl 'sende <farbe> blume <nr> an "
    "<name>' kannst Du die Blume an jemanden versenden. Zur Zeit gibt es 11 "
    "verschiedene Blumen. Zusaetzlich kann man auch einen ganzen "
    "Blumenstrauss verschicken: 'blumenstrauss fuer <name> <farbe1> <2> <3> "
    "<4> <5> <6>") );
  SetProp(P_NAME, "Blume");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"blume", "schoene blume", "SEHER\nblume"}));

  SetProp(P_MATERIAL, ({MAT_MAGIC, MAT_PLANT}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 2222);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_AUTOLOADOBJ, 1);

  AddCmd( ({"sende", "send"}), "senden");
  AddCmd( ({"blumenstrauss"}), "blumenstrauss");
}

mixed blumenfarbe(string farbe)
{
  string f;
  switch(farbe)
  {
    case "weiss": case "weisse": case "w":     f=ANSI_WHITE+ANSI_BOLD; break;
    case "rot": case "rote": case "r":         f=ANSI_RED+ANSI_BOLD; break;
    case "gelb": case "gelbe": case "g":       f=ANSI_YELLOW+ANSI_BOLD; break;
    case "violette": case "violett": case "v": f=ANSI_PURPLE+ANSI_BOLD; break; 
    case "blau": case "blaue": case "b":       f=ANSI_BLUE+ANSI_BOLD; break;
    case "cyan": case "c":                     f=ANSI_CYAN+ANSI_BOLD; break;
    default: write("So eine Farbe gibts es nicht!\n"); return -1;
  }
  return f;
}

int senden(string str)
{
  int nr;
  string wen, farbe;
  string *farben;
  object player;
  string g,f,r,w,h,k;
  notify_fail("Syntax: sende <farbe> blume <nr> an <name>\n");
  if( !str) return 0;
  if( sscanf(str,"%s blume %d an %s",farbe, nr, wen)!=3 ) return 0;
  if( player=find_player(wen) )
  {
    if( nr<1 || nr>11 )
    {
      write("So eine Blume gibts leider nicht.\n");
      return 1;
    }
    g= ANSI_NORMAL+ANSI_GREEN;
    if( nr == 7 || nr == 8 )
    {
      if( sizeof(farben=explode(farbe, " "))!=3) 
        return write("Fuer diese Blume sind 3 Farbangaben noetig!\n"), 1; 
      if( !stringp(f=blumenfarbe(farben[0])) ) return 1;
      if( !stringp(h=blumenfarbe(farben[1])) ) return 1;
      if( !stringp(k=blumenfarbe(farben[2])) ) return 1;
    }
    else if( nr == 9  )
    {
      if( sizeof(farben=explode(farbe, " "))!=2) 
        return write("Fuer diese Blume sind 2 Farbangaben noetig!\n"), 1; 
      if( !stringp(f=blumenfarbe(farben[0])) ) return 1;
      if( !stringp(h=blumenfarbe(farben[1])) ) return 1;
    }
    else
      if( !stringp(f=blumenfarbe(farbe)) ) return 1;
    w=ANSI_WHITE+ANSI_BOLD;
    r=ANSI_RED+ANSI_BOLD;
    if( player->QueryProp(P_TTY)!="ansi" )
      w=r=f=g=h=k="";
    write("Du sendest eine schoene Blume an "+ CAP(wen) +".\n");
    if(nr==5 && wen=="vivienne")
    {
      tell_object( player, ANSI_CYAN+TPN+ " sendet Dir die "+ANSI_WHITE+ANSI_BOLD+
        "himmlisch weisse"+ANSI_NORMAL+ANSI_CYAN+" und "+ANSI_RED+ANSI_BOLD+
        "hoellisch rote"+ANSI_NORMAL+ANSI_CYAN+" Zwillingsblume,\n"
        "die einzig und alleine fuer "+ANSI_PURPLE+ANSI_BOLD+ANSI_UNDERL+
        "Vivienne"+ANSI_NORMAL+ANSI_CYAN+" gezuechtet wurde.\n"+
        ANSI_NORMAL+"\n");
    }
    else
      tell_object( player, TPN+ " sendet Dir eine schoene Blume.\n\n");
    switch(nr)
    {
      case 1: tell_object(player,
      g+"              ____          ___          "+f+" __----__   _/\\\n"
     +g+"           _/^ __ ^\\_    /~^_/ |       )"+f+"/^        ^-^ _/\n"
     +g+"        _/^ _/^  ^\\_ ^\\ | ./  /~      /"+f+"(            _/\\.\n"
     +g+"      _/^_/^--_     ^\\_^\\-__-~      _/("+f+" \\         _/  ./\n"
     +g+"    ./^_/|  \\_ ~\\      \\_^\\_      /^ _"+f+"(  ~-_    _/ \\./\\\n"
     +g+"  _/^_/   \\_  ~\\ \\      ^\\__^\\../^_/^ )"+f+"\\    ~~~~    _\\/\n"
     +g+" <__/       ~\\__\\|         ^\\.__./^      "+f+"~---____--~ ~\\\n"
     +ANSI_NORMAL+"\n");
       break;

     case 2: 
    tell_object(player,
   f+"            .-~~-.--.\n"
     "           :         )\n"
     "     .~ ~ -.\\       /.- ~~\n"
     "    >       `.    .'       <\n"
     "   (         .- -.         )\n"
     "    `- -.-~  `- -'  ~-.- -'\n"
     "      (        :        )        "+g+"   _ _ .-:\n"
  +f+"       ~--.    :    .--~        "+g+".-~  .-~  }\n"
  +f+"           ~-.-^-.-~ "+g+"\\_      .~  .-~   .~\n"
     "                    \\ \\'     \\ '_ _ -~\n"
     "                     `.`.    //\n"
     "           . - ~ ~-.__`.`-.//\n"
     "        .-~   . - ~  }~ ~ ~-.~-.\n"
     "      .' .-~      .-~       :/~-.~-./:\n"
     "     //_~_ _ . - ~                 ~-.~-._\n"
     "                                      ~-.<\n"
     +ANSI_NORMAL+"\n");
         break;

  case 3: tell_object( player,       
  f+"                  .     .\n"
    "             ...  :``..':\n"
    "              : ````.'   :''::'\n"
    "            ..:..  :     .'' :\n"
    "         ``.    `:    .'     :\n"
    "             :    :   :        :\n"
    "              :   :   :         :\n"
    "             :    :   :        :\n"
    "               :    :   :..''''``::.\n"
    "               : ...:..'     .''\n"
    "               .'   .'  "+g+".::::'\n"
 +f+"               :..''"+g+"'``:::::::\n"
