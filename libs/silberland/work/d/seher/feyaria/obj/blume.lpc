"                 ,        "+g+";;'      `;;,               .,;;;'   ;\n"+f+
"              ,;;;       "+g+";;          `;;,';;;,.     ,%;;'     '\n"+f+
"            ,;;,;;       "+g+";;        "+f+" ,;"+g+"`;;;, `;::.  %%;'\n"+f+
"           ;;;,;;;       "+g+"`'       "+f+",;;; "+g+";;,;;, `::,%%;'\n"+f+
"           ;;;,;;;,          .,%%%%%'%"+g+" ;;;;,;;   %;;;\n"+f+
