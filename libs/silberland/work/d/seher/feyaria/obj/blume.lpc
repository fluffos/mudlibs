    "                             | |\n"
    "                             | |\n"
     +ANSI_NORMAL+"\n");
        break;
       case 6:
         tell_object(player, f+
   "                                    .\n"
   "                                ...:::...\n"
   "                      ...     .::::::::::::.    ...\n"
   "                 ..::::::W:.  ::::::::::::WW .::::W.\n"
   "               .:::::::::WWW.::::::::::WWWW::::WW'\n"
   "               `::::::::::WWW``...```:WWWW:::WWW'    .....\n"
   "                :::::::` .....:::::::....`.::WWWW ..::WWWW'\n"
