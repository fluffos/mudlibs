"           @mmnnvvv%vvvvvnnmm@'"+g+"`:::%%:::'"+f+"`@mmnnvv%vvmm@\n"
"           `@mnvvv%vvnnmm@'     "+g+"`:;%%;:'     "+f+"`@mvv%vm@'\n"
"            `@mnv%vnnm@'          "+g+"`;%;'         "+f+"`@n%n@\n"
