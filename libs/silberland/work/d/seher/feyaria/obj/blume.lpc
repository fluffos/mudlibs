    +ANSI_NORMAL+"\n");
        break;
      case 11:
        tell_object(player,f+
"                                                 :. ,..\n"
"                                               .' :~.':_.,\n"
"                                             .'   ::.::'.'\n"
"                                            :     ::'  .:\n"
"                                          `.:    .:  .:/\n"
