/*
** hoeflich-Fluch
** 4.11.2003 
** Feyaria@SilberLand
*/

inherit "std/thing";

#include <properties.h>

object owner;
string *f_titles;
string *m_titles;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du sprichst sehr hoeflich.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\nhoeflichfluch", "\nhoeflich", "\nsprachfluch"}));
  owner=0;
  f_titles= ({"ehrenwertes Fraeulein %s", "gnaedige Frau %s", 
      "%s, die allerschoenste im SilberLand,", "anbetungswuerdige %s",
      "die Holde %s", "verehrte %s", "bezaubernde %s", "Lady %s", 
      "Madame %s"});
  m_titles= ({"ehrenwerter Herr %s", "Meister %s", "seine Lordschaft %s",
      "%s-san", "Herr %s", "Sir %s"});
}


void reset()
{ 
  if (!is_clone(this_object())) return;
  ::reset();
  remove();
}


void init()
{
  ::init();
  if (owner && interactive(owner))
  {
    owner->SetProp(P_PERM_STRING, 0);
    owner=0;
  }
  if (environment()==this_player())
  {
    owner=this_player();
    owner->SetProp(P_PERM_STRING, this_object());
  }

}

string lower_case_but_first(string text) 
{
  int i;
  string *worte;
  worte=new_explode(text," ");
  for (i=0; i<sizeof(worte); i++) {
    worte[i]= worte[i][0..0]+lower_case(worte[i][1..<0]);
  }
  text = implode(worte," ");
  return text;
}

string permutate_string (string str)
{
  int i,j;
  string transform, titel;
  string *worte;
  object ob, *u;

  transform=lower_case_but_first(str);
  transform=regreplace(transform, "_", " ", 1);
  switch( random(6) )
  {
    case 0: 
      transform = "Sehr geehrte Damen und Herren, "+transform; 
      break;
    case 1: 
      transform = transform+" Vielen Dank fuer die Aufmerksamkeit."; 
      break;
    case 2:
      worte = explode(transform, " ");
      j = random(sizeof(worte));
      transform = "";
      for(i=0; i<sizeof(worte); i++)
      {
        transform += worte[i]; 
        if( i==j)
          transform += ", wenn ihr mir die Bemerkung erlaubt, ";
        else
          transform += " ";
      }
      break;
    case 3: 
      transform = "Bitte hoert mich an: "+transform; 
      break;
    case 4: 
      transform = "Entschuldigung, aber "+transform; 
      break;
    case 5:
      worte = explode(transform, " ");
      j = random(sizeof(worte));
      transform = "";
      for(i=0; i<sizeof(worte); i++)
      {
        transform += worte[i]; 
        if( i==j)
          transform += ", meiner bescheidenen Meinung nach, ";
        else
          transform += " ";
      }
      break;
  }
/*  
  worte = explode(transform, " ");
  transform = "";
  for(i=0; i<sizeof(worte); i++)
  {
    if ( strlen(worte[i])>=3 && ob=find_living(lower_case(worte[i])))
    {
      if( ob->QueryProp(P_GENDER) == FEMALE )
        transform += sprintf(f_titles[random(sizeof(f_titles))], capitalize(worte[i]));
      else if( ob->QueryProp(P_GENDER) == MALE )
        transform += sprintf(m_titles[random(sizeof(m_titles))], capitalize(worte[i]));
    }
    else
      transform += worte[i]+ " "; 
  }
*/
  for(i=sizeof(u=users())-1; i>=0; i--)
  {
    if( u[i]->QueryProp(P_GENDER) == FEMALE )
      titel = sprintf(f_titles[random(sizeof(f_titles))], capitalize(getuid(u[i])));
    else if( u[i]->QueryProp(P_GENDER) == MALE )
      titel = sprintf(m_titles[random(sizeof(m_titles))], capitalize(getuid(u[i])));
    else
    {
      if( (titel = capitalize(getuid(u[i]))) != " R O O T ")
      {
        if (find_player("feyaria"))
          tell_object(find_player("feyaria"),
              sprintf("Spieler mit Gender 0 : %O\n", u[i]));
      }
    }
    transform=regreplace(transform, capitalize(getuid(u[i])), titel, 1);
    transform=regreplace(transform, getuid(u[i]), titel, 1);
  }
  return transform;
}

string extra_look()
{
  if (environment()->QueryProp(P_GENDER)==2)
    return "Sie ist verflucht und kann nicht mehr richtig sprechen.\n";
  else
    return "Er ist verflucht und kann nicht mehr richtig sprechen.\n";
}
