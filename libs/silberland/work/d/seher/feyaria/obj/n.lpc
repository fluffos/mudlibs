/*
** Buchstabenfluch-Fluch
** 12.08.2002
** Feyaria@SilberLand
*/

inherit "std/thing";

#include <properties.h>

object owner;
string b;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du kannst einen Buchstaben nicht aussprechen.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\nbuchstabenfluch", "\nsprachfluch"}));
  owner=0;
  b = ({"a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n",
      "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z"})[random(26)];
}


void reset()
{ 
  ::reset();
  remove();
}


void init()
{
  ::init();
  if (owner && interactive(owner))
  {
    owner->SetProp(P_PERM_STRING, 0);
    owner=0;
  }
  if (environment()==this_player())
  {
    owner=this_player();
    owner->SetProp(P_PERM_STRING, this_object());
  }

}

string permutate_string (string str)
{
  return implode(explode(implode(explode(str, b),""),capitalize(b)),"");
}

string extra_look()
{
  if (environment()->QueryProp(P_GENDER)==2)
    return "Sie ist verflucht und kann nicht mehr richtig sprechen.\n";
  else
    return "Er ist verflucht und kann nicht mehr richtig sprechen.\n";
}
