/*
** Zahnlos-Fluch, original von Eumel
** 4.11.2003 
** Feyaria@SilberLand
*/

inherit "std/thing";

#include <properties.h>

object owner;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du sprichst mit Zahnluecke.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\nzahnlosfluch", "\nzahnlos", "\nsprachfluch"}));
  owner=0;
}


reset()
{ 
  ::reset();
  remove();
}


init()
{
  ::init();
  if (owner && interactive(owner))
  {
    owner->SetProp(P_PERM_STRING, 0);
    owner=0;
  }
  if (environment()==this_player())
  {
    owner=this_player();
    owner->SetProp(P_PERM_STRING, this_object());
  }

}

string lower_case_but_first(string text) 
{
  int i;
  string *worte;
  worte=new_explode(text," ");
  for (i=0; i<sizeof(worte); i++) {
    worte[i]= worte[i][0..0]+lower_case(worte[i][1..<0]);
  }
  text = implode(worte," ");
  return text;
}

string permutate_string (string str)
{
  string transform;

  transform=lower_case_but_first(str);
  transform=regreplace(transform, " sch", " f", 1);
  transform=regreplace(transform, "Sch", "F", 1);
  transform=regreplace(transform, "sch", "ch", 1);
  transform=regreplace(transform, "S", "F", 1);
  transform=regreplace(transform, "sz", "ff", 1);
  transform=regreplace(transform, "ss", "ff", 1);
  transform=regreplace(transform, "s", "ff", 1);
  transform=regreplace(transform, "Z", "Tsch", 1);
  transform=regreplace(transform, "z", "tsch", 1);
  transform=regreplace(transform, "X", "Ksch", 1);
  transform=regreplace(transform, "x", "ksch", 1);
  return transform;
}

string extra_look()
{
  if (environment()->QueryProp(P_GENDER)==2)
    return "Sie ist verflucht und kann nicht mehr richtig sprechen.\n";
  else
    return "Er ist verflucht und kann nicht mehr richtig sprechen.\n";
}
