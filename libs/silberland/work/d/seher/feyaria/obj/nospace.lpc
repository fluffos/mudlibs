inherit "std/thing";

#include <defines.h>
#include <moredef.h>
#include <properties.h>

int dauer;
object owner;

create()
{
  if (!is_clone(ME)) return;
  ::create();
  dauer=0;
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du sprichst ohne Leerzeichen.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\nsprachfluch", "\nnospace", "\nospacefluch"}));
  owner=0;
}

init() {
  ::init();
  if(interactive(ENV(ME)))
    ENV(ME)->SetProp(P_PERM_STRING, this_object());
}



string permutate_string (string str) {
 string transform;
 transform=regreplace(str, " ", "", 1);
 transform=regreplace(str, "_", "", 1);
 transform=regreplace(str, ".", "", 1);
 transform=regreplace(str, ";", "", 1);
 transform=regreplace(str, "-", "", 1);
 transform=regreplace(str, "+", "", 1);
 return transform;
}

void reset()
{
  ::reset();
  remove();
} 
