/*
** Buchstabierfluch-Fluch
** 4.11.2003 
** Feyaria@SilberLand
*/

inherit "std/thing";

#include <properties.h>

object owner;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du buchstabierst.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\nstabierfluch", "\nstabier", "\nsprachfluch"}));
  owner=0;
}


reset()
{ 
  ::reset();
  remove();
}


init()
{
  ::init();
  if (owner && interactive(owner))
  {
    owner->SetProp(P_PERM_STRING, 0);
    owner=0;
  }
  if (environment()==this_player())
  {
    owner=this_player();
    owner->SetProp(P_PERM_STRING, this_object());
  }

}

string permutate_string (string str)
{
  string transform;

  transform=lower_case(str);
  transform=regreplace(transform, "a", "a ", 1);
  transform=regreplace(transform, "e", "e ", 1);
  transform=regreplace(transform, "i", "i ", 1);
  transform=regreplace(transform, "o", "o ", 1);
  transform=regreplace(transform, "u", "u ", 1);
  transform=regreplace(transform, "b", "be ", 1);
  transform=regreplace(transform, "c", "ce ", 1);
  transform=regreplace(transform, "d", "de ", 1);
  transform=regreplace(transform, "f", "eff ", 1);
  transform=regreplace(transform, "g", "ge ", 1);
  transform=regreplace(transform, "h", "ha ", 1);
  transform=regreplace(transform, "k", "ka ", 1);
  transform=regreplace(transform, "l", "el ", 1);
  transform=regreplace(transform, "m", "em ", 1);
  transform=regreplace(transform, "n", "en ", 1);
  transform=regreplace(transform, "p", "pe ", 1);
  transform=regreplace(transform, "q", "ku ", 1);
  transform=regreplace(transform, "r", "er ", 1);
  transform=regreplace(transform, "s", "es ", 1);
  transform=regreplace(transform, "t", "te ", 1);
  transform=regreplace(transform, "j", "jott ", 1);
  transform=regreplace(transform, "v", "fau ", 1);
  transform=regreplace(transform, "w", "we ", 1);
  transform=regreplace(transform, "x", "iks ", 1);
  transform=regreplace(transform, "y", "uepsilon ", 1);
  transform=regreplace(transform, "z", "zett ", 1);
  transform=regreplace(transform, "0", "Null", 1);
  transform=regreplace(transform, "1", "Eins", 1);
  transform=regreplace(transform, "2", "Zwei", 1);
  transform=regreplace(transform, "3", "Drei", 1);
  transform=regreplace(transform, "4", "Vier", 1);
  transform=regreplace(transform, "5", "Fuenf", 1);
  transform=regreplace(transform, "6", "Sechs", 1);
  transform=regreplace(transform, "7", "Sieben", 1);
  transform=regreplace(transform, "8", "Acht", 1);
  transform=regreplace(transform, "9", "Neun", 1);
  return transform;
}

string extra_look()
{
  if (environment()->QueryProp(P_GENDER)==2)
    return "Sie ist verflucht und kann nicht mehr richtig sprechen.\n";
  else
    return "Er ist verflucht und kann nicht mehr richtig sprechen.\n";
}
