/* 
 * kaennchen.c - eine kleine magische Giesskanne... 
 * Sie wird ausschliesslich vom magischen Samen geclont und dient primaer
 * dazu, aus dem Samen eine kleine Kiste werden zu lassen. Waer auch einfacher
 * gegangen, aber wer kennt sich mit Kisten schon so genau aus? ;)
 *
 * (c) 2001 Adrian Holzwarth / Anatol@Silberland
 *
 */

#pragma strict_types
#include <properties.h>
#include "../../defines.h"

inherit "/std/thing";

private nosave int wasser;

public void create() {
  if (!is_clone(this_object())) 
    return;
  ::create();
  wasser=21;
  AddId(({"kaennchen","giesskaennchen","kanne", "giesskanne", 
        "\a\n\a\tol_giesskanne"}));
  SetProp(P_NAME,"Giesskaennchen");
  SetProp(P_GENDER,NEUTER);
  SetProp(P_SHORT,"Ein magisches Giesskaennchen");
  SetProp(P_INFO,break_string(
      "Das einzige, was an diesem Giesskaennchen magisch ist, ist "
      "der Umstand, dass sie sich, wenn sie einmal leergegossen ist, "
      "unproblematisch aufloest",77));
  SetProp(P_LONG, 
      "Ein schnuckeliges kleines Giesskaennchen. Damit kann man bestimmt "
      "ganz toll andere Leute nassspritzen oder fleissig ... Dinge giessen. "
      "Ob und was wirklich Sinn macht, sei allerdings dahingestellt. Sieht "
      "man von diesem magischen Schimmer ab, schaut das Kaennchen wie ein "
      "normales, nicht mehr ganz neues Giesskaennchen aus.");
  SetProp(P_SMELL, "Das Wasser im Kaennchen riecht nach Regenwasser.\n");
  SetProp(P_SOUND, "*glucker*\n");
  AddDetail("schimmer",
      "Irgendwie... liegt ein magischer Schimmer ueber dem Kaennchen.");
  AddSpecialDetail("wasser","detailWasser");
  SetProp(P_WEIGHT,0); // Wird mit NO_CHECK in den Spieler gemoved.
  SetProp(P_SIZE,30);
  SetProp(P_NODROP,"Das magische Giesskaennchen moechte Dich nicht "
      "verlassen.\n");
  SetProp(P_NEVERDROP,1);
  SetProp(P_VALUE,2000);  // GUENSTIG! :o)
  SetProp(P_MATERIAL,([MAT_IRON:100,MAT_MAGIC:100]));
  AddCmd(({"giess","giesse"}),"cmdGiesse");
  AddCmd(({"spritz","spritze"}),"cmdSpritze");
}

nosave string detailWasser()  {
  switch (wasser) {
    case 0:      return "Das Kaennchen ist leer.\n";
                 break;
    case 1..2:   return "Das Kaennchen ist fast leer.\n";
                 break;
    case 3..4:   return "Das Kaennchen ist bald leer.\n";
                 break;
    case 5..6:   return "Das Wasser geht bald zur Neige.\n";
                 break;
    case 7..8:   return "Das Wasser geht bald zur Neige.\n";
                 break;
    case 9..10:  return "Das Kaennchen ist noch etwa zur Haelfte gefuellt.\n";
                 break;
    case 11..12: return "Noch etwas ueber die Haelfte...\n";
                 break;
    case 13..14: return "Noch deutlich mehr als zur Haelfte gefuellt.\n";
                 break;
    case 15..16: return "Das Kaennchen ist noch zu etwa drei Viertel voll.\n";
                 break;
    case 17..18: return "Das Kaennchen ist noch fast voll.\n";
                 break;
    case 19..20: return "Das Kaennchen ist noch voller Wasser.\n";
                 break;
    default: return "Bis zum Rand ist das Giesskaennchen mit Wasser "
             "gefuellt.\n";
  }
}

nomask nosave int cmdGiesse(string s) {
  int i;
  object t;
   
  if ((!this_player())||(environment()!=this_player())) return 0;
  notify_fail("Was moechtest Du giessen?\n");
  
  if ((!s)||(!t=present(s,environment(this_player()))))
    return 0;
  if (t==this_player()) {
    write("Du haeltst das Giesskaennchen ueber Dich und laesst es regnen.\n");
    tell_room(environment(this_player()),break_string(
        "Nanu? "+(string)this_player()->name(WER)+" scheint es mal wieder zu "
        "warm zu sein, jedenfalls begiesst "+
        (string)this_player()->QueryPronoun(WER)+" sich mit einer kleinen "
        "Giesskanne und scheint es zu geniessen. Naja, wer's braucht...",77),
        ({this_player()}));
  }
  else {
    write(break_string("Mit Bedacht und kleingaertnerischer Sorgfalt waesserst"
          " Du "+(string)t->name(WEN)+". Moege"+
          (t->IsPlural()?"n ":" ")+(string)t->QueryPronoun(WER)+
          " wachsen und gedeien, "+(string)t->QueryPossPronoun(FEMALE,WER,
            PLURAL)+
          " Wurzeln ewig halten!",77));
    tell_room(environment(this_player()),break_string(
          "Mit Bedacht und kleingaertnerischer Sorgfalt waessert "+(string)
          this_player()->name(WER)+" "+(string)t->name(WEN)+".",77),
        ({this_player(),t}));
    t->MagicWatering(this_object());
    if (living(t)) {
      write(break_string("Irgendwie wirkt "+(string)t->QueryPronoun(WER)+
            " etwas irritiert und stiert Dich leicht veraergert an.",77));
      tell_object(t,break_string(
          (string)this_player()->Name(WER)+" wendet sich Dir mit "
          "kleingaertnerischer Sorgfalt zu und bewaessert bedaechtig mit Hilfe"
          " einer kleinen Giesskanne Deine Beine. Du bist nicht wirklich "
          "begeistert und stierst "+(string)this_player()->QueryPronoun(WEN)+
          " irritiert und leicht veraergert an.",77));
      tell_room(environment(this_player()),break_string(
          "Aber "+(string)t->name(WER)+" wirkt nicht wirklich begeistert und "
          "stiert "+(string)this_player()->name(WEN)+" irritiert und leicht "
          "veraergert an.",77), ({this_player(),t}));
    }
  }
  if (!--wasser) remove();
  return 1;
}

nomask nosave int cmdSpritze(string s) {
  int i;
  string x;
  object t;
   
  if ((!this_player())||(environment()!=this_player())) return 0;
  notify_fail("Wen moechtest Du nassspritzen?\n");
  
  if ((!s)||(sscanf(s,"%s nass",x)!=1)|| 
      (!t=present(x,environment(this_player()))))
    return 0;
  if (t==this_player()) {
    write(break_string( "Du haeltst das Giesskaennchen ueber Dich und "
          "schuettelst es kraeftig, bis Du so richtig nass bist. "
          "Aaaaaaah.... DAS tut gut!\n",77));
    tell_room(environment(this_player()),break_string(
        "Oh, "+(string)this_player()->name(WER)+" scheint in Hitze zu sein, "+
        (string)this_player()->QueryPronoun(WER)+" haelt ein kleines "
        "Giesskaennchen ueber sich und spritzt sich so richtig nass. "
        "War wohl wieder noetig! :o)",77),({this_player()}));
  }
  else {
    write(break_string("Du spritzt "+(string)t->name(WEN)+" so richtig NASS!"
          ,77));
    tell_room(environment(this_player()),break_string(
          "Mit einem kleinen Jubelschrei spritzt "+(string)
          this_player()->name(WER)+" "+(string)t->name(WEN)+" mal so "
          "richtig nass.",77),
        ({this_player(),t}));
    if (living(t)) {
      write(break_string("Mit gespielter Entruestung brummelt "+
            (string)t->QueryPronoun(WER)+
            " Dich tropfend an.",77));
      tell_object(t,break_string(
          (string)this_player()->Name(WER)+" jubelt ploetzlich los und "
          "spritzt Dich mit einer kleinen Giesskanne plitscheplatschenass. "
          "Des ungebaendigten Vergnuegens wegen kommst Du nicht um ein "
          "kleines Laecheln herum und brummelst "+(string)
          this_player()->QueryPronoun(WEN)+" mit gespielter Entruestung an."
          ,77));
      tell_room(environment(this_player()),break_string(
          (string)t->Name(WER)+" scheint ueber das sichtliche Vergnuegen "
          +(string)this_player()->name(WESSEN)+" amuesiert und brummelt "+
          (string) this_player()->QueryPronoun(WEN)+" mit gespielter "
          "Entruestung an.",77),({this_player(),t}));
    }
  }
  if (!--wasser) remove();
  return 1;
}

public int remove() {
  if (environment())
    tell_object(environment(),
        "Mit einem *PLOPP* verschwindet die Giesskanne in "
        "einer kleinen Rauchwolke.\n");
  ::remove();
}

varargs string long() {
  return QueryProp(P_LONG)+detailWasser();
}
