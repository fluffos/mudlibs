
/*
 * Das Korbpflanzenobjekt verwendet der Virtual Compiler als include, 
 * sollte also NICHT direkt geclont werden!
 *
 * 2001 02 06  Revision 1.1    Containergroesse direkt vom Spielerlevel
 *                             abhaengig (genehmigt).
 * 2001 02 25  Revision 1.2    Korb wehrt sich gegen
 *                             - Edelsteine
 *                             - Geld
 *                             - Andere Units
 *                             - MagicItems
 *                             - Nicht entfluchbare Gegenstaende
 *                             - Nicht zerstoerbare Gegenstaende
 *                             - Questobjekte
 * 2001 03 13  Revision 1.3    Den VC ausgebaut. War Overkill.
 */
#include "../../defines.h"
#include "korbpflanze.h"

inherit STD "container_closeable";
inherit STD "modules/kill_log";

nosave int max_content;

nosave void SetKillName() {
  string s;
  if (s=OWNER)
    s=capitalize(((s)[<1]=='s'||s[<1]=='x'||s[<1] =='z')?s+="' ": s+="s ");
  else
    s=QueryArticle(); 
  SetProp(P_KILL_NAME, s+"Korbpflanze");
}

create() {
  if (!is_clone(this_object())) return;
  ::create();
  max_content=3;
  AddId(({"korb","korbpflanze","pflanze","pflanzenkorb",
        KORBPFLANZENID,"\a\n\a\tol_pflanzenkorb"}));
  SetProp(P_NAME,"Korbpflanze");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_SHORT,"Eine Korbpflanze");
  SetProp(P_LONG,"Ein etwas eigenartiges Gewaechs hat sich hier... "
      "nun ja, niedergelassen. Kraeftige Wurzeln verankern es sicher "
      "im Boden, und auf dem etwa einen halben Meter hohen armdicken "
      "Stamm ruht in einem Gewurstel aus Blaettern so etwas wie ein "
      "Korb, der auch noch einen Deckel hat. Welche Pflanze bringt "
      "solchen Wuchs zustande? Und... was ist das fuer ein blaues "
      "Funkeln am Rand des Korbs? Das sieht nicht sehr pflanzlich aus.");
  AddDetail(({"wuchs"}),
      "Das muss man sich mal ansehen. Unten Wurzeln, dann ein halbmeter "
      "langer Stamm, dann ein... Korb. Ein von Blaettern halb zugedeckter "
      "Korb, aber ein Korb.");
  AddDetail(({"gewurstel","blatt","blaetter"}),
      "Ein wildes Gewurstel aus kleinen und grossen gruenen Blaettern "
      "umgibt den Fruchtstand dieser seltsamen Pflanze. Die Blaetter "
      "sind allesamt leicht oval, haben einen glatten Rand und sind "
      "dunkelgruen gefleckt.");
  AddDetail("fruchtstand",
      "Eigentlich ist das gar kein Fruchtstand, Du wuerdest es eher fuer "
      "... aeh ... oder doch ein Fruchtstand? Jedenfalls sieht das da in "
      "dem Blaettergewurstel aus wie ein grosser Korb, voellig gleichgueltig, "
      "was es wirklich ist. Es sieht aus wie ein Korb. Jawohl.");
  AddDetail(({"wurzel","wurzeln"}),
      "Einige starke Wurzeln gehen vom Stamm aus und gruben sich tief in "
      "den Boden ein. Es duerfe unmoeglich sein, diese Pflanze je wieder "
      "zu entfernen.");
  AddDetail(({"stamm"}),
      "Der Stamm ist gut armdick - zumindest aus der Sicht eines kraeftigen "
      "Zwerges, ein duerrer Elf wuerde sicherlich von Oberschenkeln sprechen "
      "- und sieht sehr stabil aus, ein leicht blaeulicher Schimmer huscht "
      "ueber die glatte Rinde.");
  AddDetail("schimmer",
      "Moeglicherweise ein Zeichen dafuer, dass Magie im Spiel ist.");
  AddDetail("rinde",
      "Die Rinde ist steinhart, da ist nix zu saebeln oder saegen.");
  AddDetail(({"sternenstein", "stein", "kristall"}),
      "Oha, ein Sternenstein! Man sagt, dass diese blauen Kristalle nur "
      "sehr schwer zu finden seien und zu grosser Macht ueber Koerper und "
      "Geist verhelfen koennen. Eine sehr bekannte Verwendungsmoeglichkeit "
      "wird wohl auch hier angebracht: Der blau funkelnde Stein sorgt dafuer, "
      "dass nur eine ganz bestimmte Person die Korbpflanze oeffnen oder "
      "schliessen kann.");
  AddDetail("korb",
      "Interessant, dieser 'Fruchtstand' ist wirklich ein grosser, luft"
      "durchlaessiger Korb, in den man bestimmt ein paar Dinge hineinlegen "
      "kann. Es koennte aber sein, dass zu kleine Dinge durch die Luecken "
      "wieder rausfallen. Mit fasziniertem Blick musterst Du auch den "
      "komischen blauen Kristall, der am Rand des Korbs eingewachsen zu "
      "sein scheint.");
  AddDetail("deckel",
      "Die Korbpflanze hat doch tatsaechlich einen Deckel, der irgendwie "
      "(es ist einfach nicht genau zu erkennen) am Korb befestigt ist.");
  AddDetail("funkeln",
      "Ein kleiner blauer Kristall blitzt am Rande des Korbs auf, er scheint "
      "dort eingewachsen zu sein.");
  
  SetProp(P_INFO,break_string(
      "Zweifellos kann diese Pflanze als Behaelter fuer einige Habseligkeiten "
      "dienen. Bemerkenswert duerfte sein, dass der Sternenstein - jawohl - "
      "am Korb irgendwie die Schwingungen der Umgebung verinnerlicht hat "
      "und nur dem Bewohner dieser Raeumlichkeiten in Resonanz antwortet. "
      "Es koennte sogar mit Schmerz verbunden sein, versucht man einen "
      "fremden Sternenstein unter seinen Willen zu zwingen... Naja, leider "
      "passt in den pflanzlichen Korb nicht allzuviel hinein... Schade.",77));
  
  SetProp(P_WEIGHT,10000);
  SetProp(P_SIZE,60);
  SetProp(P_MAX_WEIGHT,100000);
  SetProp(P_WEIGHT_PERCENT,100);
  SetProp(P_NOGET,"Die Pflanze ist festgewachsen.\n");
  SetProp(P_VALUE,1000);
  SetProp(P_MATERIAL,MAT_MISC_PLANT);
  SetProp("container_states",({"aufgeklappt","zugedeckelt"}));
  seteuid(getuid(this_object()));
}

public varargs int PreventInsert(object ob) {
  if (QueryProp(P_TOTAL_OBJECTS)>max_content) 
    write("Du schaust, ob noch irgendwo etwas Platz in dem Korb ist... "
        "leider nein.\n");
  else if (ob->id("EDELSTEIN"))
    write("Du stellst bedauernd fest, dass, bedingt durch die faserige "
        "Loechrigkeit der\nPflanzenstruktur des Korbes, Edelsteine unten "
        "herausfallen wuerden...\n");
  else if (ob->id("\ngeld"))
    write("Geld? In einem loechrig-fasernden Korb? Macht das Sinn? Du "
        "gruebelst kurz\ndarueber nach und kommst, Magie hin, Magie her, " 
        "zu einem leider\nsehr eindeutigen Ergebnis.\n");
  else if (ob->id("Unit"))
    write("Fuer die Aufbewahrung dererlei Krams ist der Korb nicht gedacht, "
        "irgendwie\nist er dafuer zu faserig, da faellt unten alles wieder "
        "raus.\n");
  else if ( (ob->QueryProp("itemd"))  && (ob->QueryProp(P_MAGIC)))
    write("Irgendetwas in Dir weigert sich standhaft, einen derartig "
        "verzauberten\nGegenstand in ein lebendes Etwas zu stopfen. Du "
        "versuchst, Deinen Unwillen\nniederzukaempfen, doch es gelingt Dir "
        "nicht.\n");
  else if ((ob->id("NODESTRUCT"))||(ob->id("NOUNCURSE"))||(ob->id("QUESTOBJ")))
    write("Du versuchst es einige Male, aber es scheint Dinge zu geben, "
        "die - bedingt\ndurch die Magie der Pflanze - einfach nicht in den "
        "Korb hinein wollen.\n");
  else return 0;
  return 1;
}

nosave int mayAct() {
  if ((!this_player()) || (!interactive(this_player()))) return 0;
  write("Du legst Deine Hand auf den Sternenstein der Korbpflanze.\n");
  tell_room(environment(this_object()), break_string((string)
    this_player()->Name(WER)+" legt "+
    (string)this_player()->QueryPossPronoun(FEMALE,WEN,SINGULAR)+ 
    " Hand auf den Sternenstein der Korbpflanze.",77),({this_player()}));
  if ((int)this_player()->QueryProp(P_SP)<10) {
    write(break_string("Deine geistige Energie reicht nicht aus, um "
     "eine Resonanz im Sternenstein zu bewirken. Staerke Dein Mentem.",77));
    return 0;
  }
  this_player()->AddSp(-10);
  if (getuid(this_player()) != OWNER) {
    write("ARGH, AUAAAAaaaaah..... ein Blitz faehrt aus dem Sternenstein "
        "in Deine Hand.\n"
        "Mit schmerzverzerrter Miene ziehst Du sie vom Korb zurueck.\n");
    tell_room(environment(this_object()), break_string("Ein heftiger Blitz "
          "zuckt vom Sternenstein in "+
          (string) this_player()->name(WESSEN)+" Hand. Mit schmerzverzerrtem "
          "Gesicht nimmt "+(string)this_player()->name(WER)+" "+
          (string)this_player()->QueryPossPronoun(FEMALE,WEN,SINGULAR)+ 
          " Hand wieder weg.",77),
        ({this_player()}));
    SetKillName();
    this_player()->do_damage(10+random(6),this_object());
    this_player()->AddHp(-3*random(30));
    return 0;
  }
  // regelmaessig neu setzen, falls der Spieler erhoeht...
  max_content=(int)this_player()->QueryProp(P_LEVEL)/10;
  return 1;
}

nosave varargs int tryOpenContainer(string with) {
  if (mayAct()) return ::tryOpenContainer(with);
  else return 0;
}

nosave varargs int tryCloseContainer(string with) {
  if (mayAct()) return ::tryCloseContainer(with);
  else return 0;
}



