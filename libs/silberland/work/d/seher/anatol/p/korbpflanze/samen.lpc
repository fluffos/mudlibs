#pragma strict_types
#include <properties.h>
#include "../../defines.h"
#include "/p/daemon/housed/sys/housed.h"
#include "korbpflanze.h"

nosave int kaennchen;

inherit "/std/thing";

public varargs string info(object ob) {
  if (find_call_out("showInfo")<0)
    call_out("showInfo",2);
  return ::info(ob);
}

nosave void showInfo() {
  if (!this_player()) return;
  if (HOUSED->HasHouse(getuid(this_player())))
    tell_object(this_player(),
      "\n''In meinem Haus!'' schiesst Dir ploetzlich durch den Kopf!\n\n");
  if (kaennchen) {
    kaennchen--;
    tell_object(this_player(),
      "\nEtwas materialisiert sich zwischen Deinen Besitztuemern.\n\n");
    clone_object(KAENNCHEN)->move(this_player(),M_NOCHECK);
    SetProp(P_NODROP,SetProp(P_NEVERDROP,0));
  }
}
 
public void create() {
  if (!is_clone(this_object())) 
    return;
  ::create();
  kaennchen=1;
  AddId(({"samen", "\a\n\a\tol_samen"}));
  SetProp(P_NAME,"Samen");
  SetProp(P_GENDER,MALE);
  SetProp(P_SHORT,"Ein kleiner Samen");
  SetProp(P_INFO,break_string(
      "Dieser Samen ist hochmagisch und stammt einer sehr seltenen "
      "Pflanze, deren botanische Bezeichnung seit drei Jahrtausenden "
      "verschollen ist. Das Geruecht, dass man, wenn man diesen Samen "
      "an einen bestimmten Ort legt und giesst, durchaus einen gewissen "
      "Erfolg verzeichnen kann, haelt sich hingegen sehr hartnaeckig.",77));
  SetProp(P_LONG, "Das ist ein kleiner gelb-gruen schillernder Samen. "
      "Und Du hast schlicht keine Ahnung, zu welcher Pflanze er gehoert.");
  SetProp(P_SMELL, "Der Samen riecht nach nichts.\n");
  SetProp(P_SOUND, 
      "War da nicht...? Nein, Du hast Dich bestimmt getaeuscht.\n");
  AddDetail("pflanze",
      "Ja, aber... welche?!");
  SetProp(P_WEIGHT,10);
  SetProp(P_NODROP,"Du glaubst, irgendwas vergessen zu haben...\n");
  SetProp(P_NEVERDROP,1);
  SetProp(P_SIZE,1);
  SetProp(P_NOBUY,1);
  SetProp(P_VALUE,10000);  // Offenbar seltener Samen ;)
  SetProp(P_MATERIAL,([MAT_MISC_PLANT:100,MAT_MAGIC:100]));
}

public void MagicWatering(object ob) {
  string s;
  if ((!this_player()) || (!interactive(this_player())) || (!ob) || 
      (!objectp(ob)) || (file_name(ob)[0..(strlen(KAENNCHEN)-1)]!=KAENNCHEN)
      || (!(HOUSED->HasHouse(getuid(this_player())))) ||
      (!environment(this_player()))||
      (file_name(environment(this_player()))[0..(strlen(VIRTUAL)-1)]!=VIRTUAL)
      || (file_name(environment(this_player()))[<6..<1]!=":00:00")||
      (((string)environment(this_player())->QueryOwner())!=
         getuid(this_player())))
    return 0;
  if(present(KORBPFLANZENID,environment()))
    tell_room(environment(),
        "Der Samen zerfaellt. Manches scheint nicht beliebig wiederholbar "
        "zu sein.\n");
  else {
    clone_object(KORB_DIR+"korbpflanze")->move(
        environment(this_object()),M_NOCHECK);
    tell_room(environment(),break_string(
        "Deine Augen weiten sich vor Ueberraschung und Dir klappt der "
        "Kiefer tiefer. Blitzartig schiessen Wurzeln aus dem Samen, der "
        "mit einem Gluehen auf die Groesse eines Trollkopfs anwaechst, "
        "mit leisem Rauschen schiesst ein Trieb aus ihm heraus, der sofort "
        "verholzt und in etwa einem halben Meter Hoehe eine Art Fruchstand "
        "- nein, eine Art bedeckelten Bluetenkelch? - zu bilden scheint. "
        "Mit Verblueffung stellst Du fest, dass... nein, das kann irgendwie "
        "nicht sein, aber... doch, das ist.. eine ein Korb? Kann man da was "
        "reintun? Ja, tatsaechlich, das scheint ein Deckel zu sein und "
        "diese... mh, was ist das fuer ein blau schimmernder... Stein dort? "
        "WOW! Ein Mineral! Gewachsen! Und das alles so schnell! Du "
        "blinzelst. Und schliesst Deinen Mund, noch immer schwer "
        "beeindruckt.",77));
  }
  remove();
}

