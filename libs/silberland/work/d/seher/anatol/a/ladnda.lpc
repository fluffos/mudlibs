/* lad'nda :>
 * Da der verflixte Seherladen nur aeusserst schwer zu finden ist, 
 * muss es wohl eine Moeglichkeit geben, ein wenig Auskunft ueber den
 * derzeitigen Aufenthalt - zumindest, ob er ueberhaupt zugaenglich
 * ist - zu erhalten.
 * (c) Anatol@Silberland 9/97
 *
 * Initial  Revision 1.0
 * 07-09-97 Revision 1.1     - 'autoload' auf Anraten von Sehern und Magiern
 *                             (wobei mir ersteres DEUTLICH wichtiger ist),
 *                             zurueckgenommen.
 * 13-10-97 Revision 1.2     - Materialbestandteil Silber 6%. FEMALE
 * 2012-06-11                -  P_SHORT nach Spielerhinweis (Ron) angepasst
 */


#pragma strong_types

inherit "/std/armour";

#define SEHERLADEN "/d/seher/anatol/r/seherladen"
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <wizlevels.h>
 
nosave int letzter_aufruf;


void create() {
  if (!is_clone(this_object())) return;
  ::create();
  letzter_aufruf=0;
  SetProp(P_SHORT, "Ein magisches Siegel mit der Rune Lad'nda");
  SetProp(P_LONG,break_string(
    "Magisch glitzert die Rune Lad'nda auf dem blutroten Siegel, welches "
    "an einem tiefschwarzen Seidenband haengt. Diese Rune hat bestimmt "
    "magische Kraefte, die Du vielleicht entdecken und nutzen kannst, wenn "
    "Du das Siegel traegst.",77));
  SetProp(P_INFO, "Wer das liest ist doof...\n"); /* _query_info()! */
  SetProp(P_AC,0); 
  SetProp(P_ARMOUR_TYPE,AT_MISC); /* Behindert keine anderen Buttons oder so */
  SetProp(P_NAME, ({"die Rune Lad'nda",  // Alle Faelle, 
                    "der Rune Lad'nda", // da non-Standard...
                    "der Rune Lad'nda",
                    "die Rune Lad'nda"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE,0);
  SetProp(P_WEIGHT, 40); 
  SetProp(P_VALUE, 3533); 
  SetProp(P_MATERIAL,([MAT_MAGIC:20,MAT_SILVER:6,
                       MAT_SILK:21,MAT_BLOOD:8,MAT_LEATHER:45]));
  SetProp(P_NODROP,"Magische Runen behaelt man, oder man vernichtet sie.\n");
  SetProp(P_NEVERDROP,1); 
  // SetProp(P_AUTOLOADOBJ,1); 
  SetProp(P_SMELL,"Die Rune riecht irgendwie magisch.\n");
  SetProp(P_SOUND,"Du hoerst leises magisches Knistern.\n");
  AddId(({"lad'nda","rune", "siegel","anatol_lad'nda","SEHER_TOOL",
     "\a\n\a\tol_lad'nda"})); 

  AddDetail("siegel",
    "Blutrot glaenzt das Leder, in das die geheimnisvolle magische Rune "
    "gepraegt ist. Welche Kraefte moegen wohl in dem gewirkten Siegel "
    "stecken...?");
  AddDetail(({"leder","stueck"}),
    "Das Siegel besteht aus einem glatten blutroten Stueck Leder, in das "
    "die Rune Lad'nda gepraegt wurde.");
  AddDetail("kraefte",
    "Besser, Du machst Dir nicht zuviele Gedanken darum...");
  AddDetail(({"band","seidenband"}),
    "Das Siegel haengt an einem tiefschwarzen Seidenband, so dass Du es "
    "tragen koenntest.");
  AddDetail(({"rune","lad'nda"}),
    "Die kompliziert gepraegte Rune ist irgendwie silbrig in das blutrote "
    "Leder des Siegels gewirkt. Ein sicheres Zeichen dafuer, dass diese "
    "Rune ueber magische Kraefte verfuegt.");

  AddCmd("woissernu","cmdWoister");
}


string _query_info() {   // Das direkte Ueberschreiben von Setz- und Abfrage-
  if (QueryProp(P_WORN)) // methoden ist pfui ;) Ich mach's trotzdem.
    return break_string( 
           "Die Rune Lad'nda ermoeglicht Dir, mit Hilfe des magischen Befehls "
           "'woissernu' etwas mehr ueber den derzeitigen Aufenthalt eines "
           "gewissen alten magischen Ladens in Erfahrung zu bringen.",75);
  else
    return 0;   /* Ist quasi eine Wurstseher-Sperre ;-> */
}

nosave int cmdWoister() {
  string meldung;
  if (!this_player()) return 0;
  if ((!QueryProp(P_WORN))&&(!IS_WIZARD(this_player()))) {
    write("Es passiert nichts.\n");
    return 1;
  }
  if ((!(meldung=SEHERLADEN->woBistDu(this_player()))) ||
       ((((time()-letzter_aufruf)<60)&&(!IS_WIZARD(this_player())))))
    write("Du ruehrst an der Kraft der magischen Rune, doch "
          "es ruehrt sich nichts.\n");
  else {
    letzter_aufruf=time();
    write("Du ruehrst an der Kraft der magischen Rune.\n"+meldung);
  }
  return 1;
}


int deniedToSell(object player) {
  if(!objectp(player)) return 1;
  return ((present("\nanatol_lad'nda",player))?1:0);
}

  
