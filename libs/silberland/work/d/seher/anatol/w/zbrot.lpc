/* 
 * Zwergenbrot, eigentlich nur dazu da, um deniedToSell(object player)
 * auf Funktionaliaet zu pruefen... ansonsten - bitte, wem es Spass macht.
 * (c) Anatol@SL 9/97
 */


#pragma strong_types

inherit "/std/weapon";

#include <language.h>
#include <properties.h>
#include <wizlevels.h>
#include <combat.h>


void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein echtes Zwergenbrot");
  SetProp(P_LONG,break_string(
    "Ja rattenscharf! Das ist ja ein echtes Zwergenbrot, wie es eine "
    "Zwergenurgrossmutter immer 'gebacken' hat. Klasse klasse, da hat bestimmt "
    "sogar ein Hund darueber uriniert. Dir laeuft beim Anblick des "
    "leckeren (steinharten) Zwergenbrotes das Wasser im Munde zusammen.",77));
  SetProp(P_INFO, 
      "Es heisst, dass man nie hungert, solange man Zwergenbrot dabei hat.\n"
      "Das mag aber auch einfach daran liegen, dass niemand hungrig genug\n"
      "sein kann, um davon auch nur ein kleines Stueck abzubeissen...\n");

  SetProp(P_WC,30);                  /* quasi mit blossen Haenden */
  SetProp(P_DAM_TYPE,DT_BLUDGEON);   /* quasi mit blossen Haenden */
  SetProp(P_WEAPON_TYPE,WT_CLUB);    /* WT_BREAD waer natuerlich besser */
  SetProp(P_NAME, "Zwergenbrot");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 1000); 
  SetProp(P_VALUE, 1093); 
  SetProp(P_MATERIAL,MAT_FOOD);
  SetProp(P_NR_HANDS,2);   
  SetProp(P_NODROP,"NIE! Zwergenbrot ist viel zu wertvoll!!\n");
  AddId(({"brot","zwergenbrot","anatol_zwergenbrot","\nzwergenbrot"})); 
  AddCmd("iss","cmdIss");
}

nosave int cmdIss(string str) {
  notify_fail("Was willst Du essen?\n");
  if (!str) return 0;
  notify_fail("Das kannst Du nicht essen.\n");
  if (!id(str)) return 0;
  write("Du fuehlst Dich noch nicht hungrig genug, "
        "um das Zwergenbrot zu essen.\n");
  return 1;
}

int deniedToSell(object player) {   /* Verkauf nur an Zwerge. */
  if (!objectp(player)) return 0;    
  if (player->QueryProp("race")!="Zwerg") return 1;
  return 0;
}
