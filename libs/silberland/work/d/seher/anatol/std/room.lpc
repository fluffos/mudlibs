
#pragma strong_types
#include "../defines.h"
#include <wizlevels.h>

inherit SEHER "std/modules/kill_log";
inherit "/std/room";

private nosave string * stupids;
private nosave string * fail_messages;
private nosave string * skydetails;

nosave void SetStupids(string * targets) {
  if ((targets) && (pointerp(targets))) stupids=targets; 
  return;
}

nosave void SetFailMessages(string * messages) {
  if ((messages) && (pointerp(messages)) && (sizeof(messages)))
    fail_messages=messages;
  return;
}

varargs public string GetDetail(mixed key, mixed race) {
  string ret;

  if (Query(P_DETAILS)[key])
    return ::GetDetail(key,race);
  if ((sizeof(stupids)) && ((this_player()) && (member(stupids, key)!=-1)) 
      && (!IS_LEARNER(this_player()))
      && (query_once_interactive(this_player())))
    log_file("/wiz/anatol/stupids", /* Format fuer ext. Shellscript */
      sprintf("%s|%s|%O|%s\n",ctime(), file_name(this_object()),
        file_name(this_player()),key),50000,1);
  if (sizeof(fail_messages)) 
    return process_string(fail_messages[random(sizeof(fail_messages))]);
  return 0;
}

