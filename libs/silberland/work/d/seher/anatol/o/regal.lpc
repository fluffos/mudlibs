/* 
 *
 * (c) 2002 Adrian Holzwarth / Anatol@Silberland
 *
 * Ein Regal.
 *
 * Beschraenkung in der Anzahl der hineinsteckbaren Objekte recht lasch
 * (20-30), dafuer nur leer tragbar und nur 5 in einem Raum deponier-/nutzbar. 
 *
 * Man kann es beschriften.
 *
 */ 

#pragma strict_types 

#include <properties.h>
#include <moving.h>
#include "/d/seher/sys/moebel.h"

inherit "/std/container";


string beschriftung;

public void create() {
  int i;
  if (!is_clone(this_object())) return;
  ::create();
  i=random(5);
  AddId(({"regal","\a\n\a\tol_regal",MOEBEL_ID}));
  beschriftung=0;
  SetProp(P_SHORT,"Ein Regal");
  SetProp(P_LONG, "Ein Regal.\n");
  SetProp(P_NAME,"Regal");
  SetProp(P_GENDER,NEUTER);
  SetProp(P_WEIGHT,10000+(i*1500));   // Schwer, haelt aber auch was aus.
  SetProp(P_WEIGHT_PERCENT,100);
  SetProp(P_TOTAL_OBJECTS,20+(i*2));
  SetProp(P_MAX_WEIGHT,1000000+(i*150000));
  SetProp(P_SIZE,200+(i*40));
  SetProp(P_VALUE,3333+(i*450));  // *seufz* Das Holz war teuer... ;)
  SetProp(P_MATERIAL,([MAT_MISC_WOOD:50-(i*5),MAT_STONE:50+(i*5)]));

  AddCmd(({"beschrift","beschrifte"}),"cmdBeschrifte");
  AddSpecialDetail(({"schildchen","beschriftung"}),"detBeschriftung");
  AddDetail("moebelhandel","Gibts hier noch nicht. "
      "Muss also wo anders her sein.\n");
  AddDetail("gesangsverein",
      "Der liebe Herr Gesangsverein ist vor zwei Minuten am anderen "
      "Ende des Silberlands gesichtet worden. Entweder Du rennst da jetzt "
      "hin und machst Dich laecherlich oder Du vergisst ihn einfach "
      "wieder. :)");
  AddDetail("augenhoehe",([0:
      "Interessant, ein Zwerg haette es genauso gesehen.",
      "zwerg":"Interessant, ein Elf haette es genauso gesehen."]));
  switch (i) {
    case 0:
      AddDetail(({"bretter","brett","fachboden","fachboeden"}),
          "Stabile Bretter halten als schmucklose aber hochgradig "
          "funktionale Fachboeden her. So leicht brechen die nicht durch.");
      AddDetail(({"bein","beine","saeulen","saeule"}),
          "Die steinernen Saeulen an den Ecken sehen recht stabil aus und "
          "koennen sicherlich einiges aushalten.");
      break;
    case 1:
      AddDetail(({"bretter","brett","fachboden","fachboeden"}),
          "Stabile Bretter halten als schmucklose aber hochgradig "
          "funktionale Fachboeden her. Wenn Du genauer hinsiehst - hey, "
          "die sind sogar doppelt verleimt! Na, wenn das nichts aushaelt...");
      AddDetail(({"bein","beine","saeulen","saeule"}),
          "Die steinernen Saeulen an den Ecken sehen sehr stabil aus. Eher "
          "geben die Bretter nach als diese Bollwerke behauener Natur");
      AddDetail(({"bollwerk","bollwerke"}), "Gnh. Du weisst schon.");
      break;
    case 2:
      AddDetail(({"bretter","brett","fachboden","fachboeden"}),
          "Stabile Bretter halten als schmucklose aber hochgradig "
          "funktionale Fachboeden her. Kleine steinerne Besaetze sollen "
          "wohl verhindern, dass die ohnehin nicht leicht zu zerbrechenden "
          "Fachboeden unnoetig verschrammt werden. Schlau!");
      AddDetail(({"bein","beine","saeulen","saeule"}),
          "Extradicke Beine - kleine Saeulen - tragen die Fachboeden. Da "
          "ist nix zu wollen: Das haelt.");
      AddDetail(({"steinbesatz","steinbesaetze","besatz","besaetze"}),
          "Zum Glueck sind die Besaetze nur klein, sonst wuerden sie zwar "
          "vor Schrammen schuetzen, aber Einbussen in der Stabilitaet "
          "bedeuten.");
      AddDetail("einbussen","Hier? Keine!");
      break;
    case 3:
      AddDetail(({"bretter","brett","fachboden","fachboeden"}),
          "Stabile, sichtbar doppelt verleimte Fachboeden. Die werden "
          "eine ganze Menge aushalten, sie haben sogar kleine Steinbesaetze. "
          "Die sehen so schlecht gar nicht aus.");
      AddDetail(({"steinbesatz","steinbesaetze","besatz","besaetze"}),
          "Zum Glueck sind die Besaetze nur klein, sonst wuerden sie zwar "
          "vor Schrammen schuetzen, aber Einbussen in der Stabilitaet "
          "bedeuten.");
      AddDetail(({"bein","beine","saeulen","saeule"}),
          "Hoffentlich bricht hier der Fussboden nicht durch, gute Guete, "
          "wer baut denn Regale mit solchen Beinen... ehr... Saeulen. Ok, "
          "es soll ja auch was aushalten, gut. Aber... Jungejunge.");
    default:  // 4 
      AddDetail(({"bretter","brett","fachboden","fachboeden"}),
          "Vierfach vom Fachmann gekreuzt verleimte Bretter halten als "
          "Fachboeden extraordinaerer Staerke her. Sie sehen zwar nicht "
          "sonderlich toll (sondern ein bisschen klobig) aus, aber darauf "
          "koennte der sprichwoertliche Baer tatsaechlich steppen. Die "
          "Besaetze aus Stein wuerden auch fuer ordentliche Akustik sorgen.");
      AddDetail(({"steinbesatz","steinbesaetze","besatz","besaetze"}),
          "Die Steinbesaetze werden effektiv dafuer sorgen, dass die "
          "Fachboeden beim unachtsamen Einlagern von Schwertern zu "
          "schnell verkratzen.");
      AddDetail(({"bein","beine","saeulen","saeule"}),
          "Stabil wie ein massiver Opferaltar steht dieses Regal da, dank "
          "extradicker massiv steinerner Beine, die man mit Fug und Recht "
           "'Saeulen' zu nennen hat. Eigentlich solltest Du dieses Regal "
           "alleine gar nicht tragen koennen.");
      AddDetail(({"fug","recht"}),"Genau. Mit Fug und Recht.");
      AddDetail(({"altar","opferaltar"}),
          "Naja, gluecklicherweise ist das ein Regal. Man darf also wieder "
          "etwas runternehmen, wenn was drauf liegt. Auch, wenn man zufaellig "
          "kein Gott ist.");
      AddCmd(({"stepp","steppe"}),"cmdSteppe");
      break;
  }
}

nosave string detBeschriftung() {
  if (!beschriftung) return 
    "Das Schildchen ist leer, das Regal unbeschriftet.\nHm.\nHMM.\n"
    "Ob man das Regal beschriften kann?\nBestimmt kann man.\nAber nur "
    "einmal.\nDu bist Dir da sehr sicher.\n";
  else
    return break_string("Jemand hat mit krakeligen Buchstaben '"+
        beschriftung+"' auf das Schildchen am Regal gemalt.",77);
}

nosave int cmdSteppe(string s) {
  string worauf;

  if (!this_player()) return 0;

  notify_fail("Steppen? DU? Auf was denn?\n");
  if ((!s)||(s=="")) return 0;

  notify_fail("Darauf kann man nicht steppen. Du zumindest nicht.\n");
  if ((!sscanf(s,"auf %s",worauf)) ||(!id(worauf))) return 0;

  notify_fail("Du wuerdest nur all die Sachen runterwerfen. Lass mal.\n");
  if (sizeof(all_inventory(this_object()))) return 0;

  write("*klapperdiklapperdiklapperdiklack*\n");
  say(break_string("Ja haelt man es fuer moeglich? Da steigt "+
   this_player()->name(WER)+" doch glatt auf das Regal, strahlt "
   "ein bisschen wie Fred Astaire, Gene Kelly und Ginger Rogers "
   "gleichzeitig in der Rolle als Lord of the Dance "
   "und legt eine flotte Sohle auf's... Regal. "
   "Klackerdiklackerdicklakkerdiklack, Du erkennst mit Kennerblick, dass "+
   this_player()->QueryPronoun(WER)+" "+
   this_player()->QueryPossPronoun(FEMALE,WEN,PLURAL)+" Hausaufgaben gemacht "
   "hat, gekonnt reihen sich perfekte Cramprolls an mitreisende Brushes und "
   "Flaps... da hat jemand heimlich geuebt! Mit einem lauten "
   "KLOCKERDI...KLOCK springt "+this_player()->name(WER)+" mit einem Salto "
   "vom Regal - natuerlich ohne Nachzuwackeln in den Stand. Begeistert "
   "klatschst Du Beifall! Als "+this_player()->name(WER)+" dann noch ein "
   "baeriges Brummen von sich gibt, weisst Du endlich Bescheid: Jawoll, HIER "
   "steppt der Baer!",77));
  return 1;
}
      

nosave int cmdBeschrifte(string wiebitte) {
  string schrift, regal;
  notify_fail("Was willst Du beschriften?\n");
  if ((!wiebitte) || (!this_player()) || (!interactive(this_player())) ||
  (!wiebitte=(string)this_player()->_unparsed_args())) return 0;

  notify_fail("Beschrifte ... mit ...?\n");
  if (sscanf(wiebitte,"%s mit %s",regal, schrift)!=2) return 0;

  notify_fail("Das kannst Du wohl nicht beschriften.\n");
  if (!id(regal)) return 0;

  notify_fail("Auf dem Schildchen des Regals steht bereits klar und "
      "deutlich:\n'"+beschriftung+"'. Kriegst Du nicht wieder runter. :(\n");
  if (beschriftung) return 0;

  notify_fail("Guter Ansatz, aber mit was moechtest Du das Regal "
      "beschriften?\n");
  if ((!schrift) || (schrift=="")) return 0;

  notify_fail("Mmmh, so viel passt da nicht drauf, fasse Dich ein wenig "
      "kuerzer.\n");
  if (strlen(schrift)>20) return 0;

  beschriftung=schrift;
  AddId(lowerstring(beschriftung)+" regal");
  SetProp(P_INFO,"Dieses Regal wurde von "+(string)this_player()->Name(WEM)+
      " beschriftet.\n");

  write(break_string("Du schreibst in grossen lesbaren Buchstaben '"+
        beschriftung+"' auf das Schildchen am Regal, trittst dann zurueck "
        "und bewunderst Dein Werk! Wow!",77));
  say(break_string(this_player()->Name(WER)+" schreibt langsam in grossen "
        "wackeligen Buchstaben etwas auf ein kleines Schildchen an einem "
        "Regal (Du siehst, wie "+
        this_player()->QueryPossPronoun(FEMALE,WER,SINGULAR)+" Zunge an "
        "den Lippen kreist, ist wohl gar nicht so einfach, so ganz ohne... "
        "huch, ohne Stift). Dann tritt "+this_player()->QueryPronoun(WER)+
        " zurueck und bewundert "+
        this_player()->QueryPossPronoun(NEUTER,WEN,SINGULAR)+
        " Werk.",77));
  return 1;
}

public string long() {
  if (!sizeof(all_inventory(this_object())))
    return break_string("Mein lieber Herr Gesangsverein, das ist aber "
        "ein Drum von einem Regal! Naja, eigentlich sieht es ja aus, wie "
        "just aus einem schwedischen Moebelhandel entwendet, aber "
        "gleichzeitig scheint es auch einiges auszuhalten: Die vier Beine "
        "an den Ecken sind nicht etwa aus Holz, sondern aus behauenem Stein, "
        "die Bretter koennten glatt aus Eiche sein. Nicht unbedingt sehr "
        "schmuck, das Teil, aber praktikabel! Dir faellt ein kleines "
        "Schildchen auf, das an einem Fachboden in Deiner Augenhoehe "
        "angenagelt ist.",77);
    else
      return break_string("Ein "+ (beschriftung?
            "mit "+beschriftung+" beschriftetes":"unbeschriftetes")+
          " Regal, in ihm steht:\n",77,0, 1)+
      make_invlist(this_player(),all_inventory(this_object()), 0);
}

varargs int PreventInsert(object ob) {
  if ((!environment()) || 
      ((member(inherit_list(environment()),"std/room.lpc"))<0)) {
    write("Solange Du das Regal mit Dir herumtraegst, wird das nichts.\n");
    return 1;
  }
  return ::PreventInsert(ob);
}
 
int move(mixed dest, int method) {
  if (sizeof(all_inventory(this_object()))) {
    write("Bist jeck?! Mach das Regal doch bitte erstmal leer, "
        "bevor Du es herumtraegst.\n");
    return ME_TOO_HEAVY;
  }
  else if (objectp(dest) && 
    ((member(inherit_list(dest),"std/room.lpc"))>=0) &&
    (present(MOEBEL_ID+" "+MAX_MOEBEL_ALLOWED,dest))) {
     write("Da steht bereits genug herum, findest Du nicht?\n");
    return ME_CANT_BE_DROPPED;
  }
  else return ::move(dest, method);
}

public string short() {
  string s;
  s="Ein "+ (beschriftung?"["+beschriftung+"]":"unbeschriftetes")+" Regal ";
  switch (sizeof(all_inventory(this_object()))) {
    case 0: return s+="(leer).\n";
    case 1..5: return s+="(duenn bestueckt).\n";
    case 6..10: return s+="(etwas gefuellt).\n";
    case 11..15: return s+="(halb vollgestellt).\n";
    case 16..20: return s+="(ziemlich voll).\n";
    case 21..24: return s+="(vollgestellt).\n";
    case 25: return s+="(randvoll).\n";
    default: return s+="(berstend voll).\n";
  }
  return "Hae?.\n";
}
