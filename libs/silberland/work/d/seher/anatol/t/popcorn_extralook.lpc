/* Extralook mit Popcorn...
 * __________________________________________(i) Anatol@Silberland (2012) */

#pragma strict_types
#include <moving.h>
#include <properties.h>

inherit "/std/thing";

void create() {
  if ((!is_clone(this_object()))) return;
  ::create();  

  SetProp(P_SHORT,0);
  SetProp(P_LONG,0);
  SetProp(P_INVIS,1);

  SetProp(P_WEIGHT,0);
  SetProp(P_NOBUY,1);
  SetProp(P_NOSELL,1);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1);
  AddId(({"\a\n\a\tol_popcorn"}));
  AddCmd(({"entfern","entferne"}),"cmdEntferne");
  
}

string extra_look() {
  if (living(environment())) 
    return "Iiih, "+
     ((string)environment()->QueryPronoun(WER))+ " hat "
     "Popcorn in den Haaren.\n";
  else return "";
}

void reset() {
 ::reset();
 remove();
}

nosave int cmdEntferne(string what) {
  if ((!this_player()) || (this_player() != environment())) return 0;
  if (what != "popcorn") 
    return 0; 
  write(break_string(
    "Baeh, weg mit dem Popcorn. Muehevoll saeuberst Du Dir die Haare.\n"));
  return remove();
}
