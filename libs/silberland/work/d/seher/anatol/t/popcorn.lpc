/* Eine Grosse Tuete Popcorn! Yay.
 * __________________________________________(i) Anatol@Silberland (2012) */

#pragma strict_types
#include <moving.h>
#include <properties.h>
#define MAX_POPCORN 50

#define POPCORNID "\a\n\a\tol_popcorn"
#define POPCORN "/d/seher/anatol/t/popcorn_extralook"
inherit "/std/thing";


private int popcorn;
private int salt;

void create() {
  if ((!is_clone(this_object())) || (popcorn)) return;
  ::create();  
  popcorn = MAX_POPCORN;
  salt= random(2);

  SetProp(P_SHORT,sprintf("Eine grosse Tuete Popcorn (%s)",
      (salt?"gesalzen":"gezuckert")));
  SetProp(P_LONG,"Popcorn (du solltest das hier niemals lesen)");
  SetProp(P_NAME, "Popcorntuete");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_WEIGHT,500);
  SetProp(P_VALUE,100);
  SetProp(P_NOBUY,1);
  SetProp(P_NOSELL,"Du behaeltst die Popcorntuete lieber.\n"); /* s.ob. */
  SetProp(P_NODROP,
    "Ups, vorsicht, nicht doch das Popcorn fallenlassen!\n");
  SetProp(P_NEVERDROP,1);      /* Nicht in Leichen liegenlassen, ne?  */
  SetProp(P_INFO,break_string(
    "An Popcorn ist so gar nichts magisch. Aber sie koennen besondere "
    "Momente versuessen. Oder versalzen. Je nachdem.",77));
  AddId(({"tuete","popcorntuete","popcorn","tuete popcorn"}));

  SetProp(P_MATERIAL,MAT_PAPER);

  AddCmd("iss","cmdIss");
  AddCmd(({"wirf","werfe","werf"}),"cmdWirf");
  AddAdjective(({"gross"}));
  
}

private string getMenge() {

  switch ((int)((100*popcorn)/MAX_POPCORN)) {
    case 0..2:
    	return "Die Tuete enthaelt nur noch einen winzigen "
	     "Rest Popcorn. Schnell, neues kaufen!";
    case 3..10:
        return "Das Popcorn in der Tuete geht langsam zur Neige.";
    case 11..25:
        return "Die Tuete enthaelt noch einiges an Popcorn, "
	     "viel ist es aber nicht mehr.";
    case 26..40:
    	return "Noch viel Handvoll Popcorn wollen da "
	     "gefuttert werden.";
    case 41..60:
    	return "Die Tuete ist noch zur Haelfte mit "
	     "Popcorn gefuellt, yay!";
    case 61..80:
        return "Ein Teil des Popcorns wurde schon gefuttert, "
	     "aber es ist noch genug fuer alle da.";
    case 81..95:
        return "Die Tuete wurde frisch angebrochen, es "
	     "fehlt etwas Popcorn.";
    default:
        return "Die Tuete ist randvoll mit frischem Popcorn. "
	    "Hau rein!";
  }
}

varargs string long()  {
  return break_string(sprintf(
     "Diese Tuete enthaelt leckeres %s Popcorn. Es eignet sich "
     "vorzueglich dazu, waehrend des Genusses eines spannenden "
     "(oder zumindest leidlich unterhaltsamen) Schauspiels gemampft "
     "zu werden. %s",(salt?"gesalzenes":"gezuckertes"),getMenge())
     ,77);
}

private nosave int checkPopcorn() {
   if (!(--popcorn)) {
     write("Die Tuete ist leergefuttert und loest sich in Wohlgefallen auf.\n"
        "Mann, DAS ist mal intelligente Abfallwirtschaft!\n");
     return (int)remove();
   }
   else return 1;
}
nosave int cmdIss(string what) {


  if ((!this_player()) || (this_player() != environment())) return 0;

  notify_fail("Was willst Du essen?\n");
  if (what != "popcorn") 
    return 0; // nicht id(), man isst keine Tueten.
  write(break_string(
    "*MAMPF* Du greifst Dir eine ordentliche Handvoll Popcorn aus Deiner "
    "Tuete und stopfst sie Dir hemmungslos in den Mund. Lecker! *schmatz*",
    77));
  say(break_string(sprintf(
    "*MAMPF* %s greift sich eine ordentliche Handvoll Popcorn aus %s "
    "Popcorntuete und stopft sie sich auf einmal in %s Mund, ein wahrhaft "
    "grauenvoller Anblick! Und wie %s stahlt, als %s das Zeug "
    "verschmatzt! %s %s Popcorn ist offenbar sehr lecker.",
      this_player()->Name(WER),
      this_player()->QueryPossPronoun(FEMALE, WEM, SINGULAR),
      this_player()->QueryPossPronoun(MALE, WEN, SINGULAR),
      this_player()->QueryPronoun(WER),
      this_player()->QueryPronoun(WER),
      this_player()->Name(WESSEN),
      (salt?"gesalzenes":"gezuckertes")),77));
  return checkPopcorn();
}

nosave int cmdWirf(string whatever) {
  string what,whom;
  string* battlecry;
  object target, pop;

  if ((!this_player()) || (this_player() != environment())) return 0;
  notify_fail("Was willst Du nach wem werfen?\n");
  if (!stringp(whatever) || (!strlen(whatever)) ||
     (sscanf(whatever,"%s nach %s",what, whom)!=2) ||
     (what!="popcorn")) return 0; // evtl kommen noch weitere IDs.
  
  notify_fail("Wonach willst Du Popcorn werfen?\n");
  if (!(target=present(whom,environment(this_player()))))
     return 0;

  if (!living(target)) {
      write("Such Dir lieber lebende Ziele, das macht mehr Spass!\n");
      return 1;
  }
  if (!interactive(target)) {
      write(break_string(sprintf("%s is ja schoen und gut... aber Popcorn "
      "auf Mitspieler werfen, DAS macht Spass!",(string)(target->Name(WER))),77));
      return 1;
  }
  battlecry = ({ "BAZAAMM", "WROMMMM","WUUUUUSCH", "WUAHAHAHA",
     "CRY BABY CRY", "GEH DUSCHEN"});

  what = battlecry[random(sizeof(battlecry))];

  write(break_string(sprintf(
     "Du greifst Dir eine wirklich kraeftige Handvoll Popcorn und "
     "wirfst sie mit einem lauten '%s!' %s ueber den Kopf. %s schaut "
     "recht verdutzt, als es um %s herum %s Popcorn regnet. Hae hae hae!",
     what, (string)(target->name(WEM)), 
     (string)capitalize(((string)(target->QueryPronoun(WER)))),
     (string)(target->QueryPronoun(WEN)),
     (salt?"gesalzenes":"gezuckertes")
     ),77));

  say(break_string(sprintf(
     "%s greift sich eine wirklich kraeftige Handvoll Popcorn und "
     "wirft sie mit einem froehlich-lauten '%s!' %s ueber den Kopf. %s schaut "
     "recht verdutzt, als es um %s herum %s Popcorn regnet.",
     (string)(this_player()->Name(WER)), 
     what, (string)(target->name(WEM)), 
     (string)capitalize((string)(target->QueryPronoun(WER))),
     (string)(target->QueryPronoun(WEN)),
     (salt?"gesalzenes":"gezuckertes")
     ),77),target);

  tell_object(target,break_string(sprintf(
     "%s greift sich eine wirklich kraeftige Handvoll Popcorn und "
     "wirft sie Dir mit einem froehlich-lauten '%s!' ueber Deinen Kopf. "
     "Na praechtig, es regnet %s Popcorn.",
     (string)(this_player()->Name(WER)), what,
     (salt?"gesalzenes":"gezuckertes")
     ),77));
  
  if (!present(POPCORNID,target)) {
   pop=clone_object(POPCORN);
   if (objectp(pop)) 
     pop->move(target);
  }
  return checkPopcorn();
}
