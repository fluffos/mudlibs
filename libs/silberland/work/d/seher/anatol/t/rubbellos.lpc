#pragma strict_types

#include <properties.h>
#include <wizlevels.h>

#include "../defines.h"
#include "/p/daemon/housed/sys/upgrade.h"

#define LEVEL_NEEDED  60
#define UPGRADE_NO 1
#define KEKS_LOG(x) log_file(LOG "glueckskeks", \
    sprintf("%s: %s\n",dtime(time())[5..],x))
#define INFO_LOG(x) log_file(LOG "glueckskeks.info", \
    sprintf("%s: %s\n",dtime(time())[5..],x))
#define FAIL_LOG(x) log_file(LOG "glueckskeks.err", \
    sprintf("%s: %s\n",dtime(time())[5..],x))

#define DBG(l,t) DEBUG_MESSAGE("keks",l,t)

#define SUCCESS_PROBABILITY 200

inherit "/std/thing";
inherit SEHER "std/modules/kill_log";

nomask nosave int gotHitByZaunpfahl() {
    if ((this_player()) && (!(this_player()->QueryProp(P_INVIS))))
        environment(this_player())->Message(break_string(
        "Ein Zaunpfahl erscheint und gibt "+
        this_player()->Name(WEM)+" zur Erinnerung einen leichten "
        "Schlag auf den Hinterkopf.",78),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
}

nomask nosave int detMuster() {
    write(break_string("Das Muster scheint mit Leben erfuellt, sofort beginnen "
         "Deine Augen zu traenen.",78));
    if ((this_player()) && (!(this_player()->QueryProp(P_INVIS))))
        environment(this_player())->Message(break_string(
        this_player()->Name(WER)+" weint.",78),
	    MSGFLAG_SOUND|MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
}

nomask nosave int cmdZerdepper(string arg) {
    string * coloreffect;
    string * colorful;
    string * trostpreise;
    string owner;
    object trost,env;

    trostpreise=({"/obj/seil","/obj/fackel","/obj/schaufel","/obj/misc/bier",
       "/obj/misc/bonbon","/obj/misc/kissen","/obj/misc/lolli", 
       "/obj/misc/wuerfel","/obj/party/obj/kuchen","/obj/party/obj/joint",
       "/obj/party/obj/mon_cherie","/obj/party/obj/reis"});
    
    coloreffect=({"leuchtend","metallic","tief","hell","dunkel","matt"});
    colorful=({"blutrot","schweinchenrosa","weinrot","schamrot","mohnrot",
        "rubinrot","blutorangenorange","sonnengelb","bananengelb",
        "zitronengelb","quietschgelb","goldgelb","pissgelb",
        "osterglockenblumengelb", "giftgruen", "ekelgruen", "schleimgruen",
        "blattgruen","waldgruen","grasgruen","smaragdgruen", "olivgruen",
        "lachsrosa","pink","lila","flieder","himmelblau","kornblumenblau",
        "zartrosa","ozeanblau","koenigsblau","kaiserblau","graublau",
        "volltrunkenblau","spontanblau","erdbraun","schwarz","weiss",
        "pfirsich", "ocker", "ultramarinblau", "kardinalrot", "anthrazit",
        "graumeliert", "tuerkis", "oktarin", "bunt"});

    notify_fail("Was willst Du zerdeppern?\n");
    if ((!arg) ||(!strlen(arg)) || (!id(arg))) return 0;
    notify_fail("Du musst den Glueckskeks bei Dir haben.\n");
    if (environment(this_object()) != this_player()) return 0;
    owner=getuid(this_player());
     
    write("Mit aller Kraft schleuderst Du den Glueckskeks zu Boden.\n");
    env=environment(this_player());
    env->Message(break_string(
        "Mit aller Kraft und ohne gebotener Vorsicht schleudert "+
        this_player()->Name(WER)+" einen goldenen Glueckskeks zu Boden "
        "und schaut erwartungsvoll hin."
        ,78), MSGFLAG_NO_TP);

    env->Message(break_string(
        "Wuuuusch! Der Glueckskeks faucht und raucht und zerplatzt mit "
        "einem lauten *PENG* zu einer " + 
        coloreffect[random(sizeof(coloreffect))] + 
        colorful[random(sizeof(colorful))] + 
        " glitzernden Wirbel-Wolke." ,78), MSGFLAG_NO_TP);

    switch (random(SUCCESS_PROBABILITY)) {
        case 0 .. 19 :
            catch(trost=clone_object(trostpreise[random(sizeof(trostpreise))]));
            if (trost) {
                trost->move(env,M_NOCHECK);
                env->Message(break_string(
                "Als sich die Wolke verzieht, bleibt etwas" + 
                " auf dem Boden zurueck.\n",78,0,1), MSGFLAG_VISUAL);
            }
            INFO_LOG(sprintf("Trostpreis: %s - %s",owner,(trost?file_name(trost):"BUG")));
	    DBG("info",capitalize(owner)+ " wandelt einen Glueckskeks in "+(trost?file_name(trost):"BUG!")+".");
            break;
        case 21 :
            env->Message(break_string(
                "Oh... das sieht gut aus.\n",78));
            call_other(explode(file_name(this_object()),"#")[0],"doUpgrade");
            INFO_LOG(sprintf("Gewinnt: %s",owner));
	    DBG("warn",capitalize(owner)+ " hat Glueck mit dem Glueckskeks.");
            break;
        case 22 :
        case 20 :
            write("Knapp daneben. Leider.\n");
            env->Message(
               "Tod tritt aus einer Schwefelwolke.\n"
               "Tod sagt: WAS, OHNE RITUS VON ASHK-ENTE?\n"
               "Tod sagt: ACH EGAL, GEHT AUCH SO.\n"
               "Tod deutet auf "+this_player()->Name(WEN)+".\n",
                 MSGFLAG_NO_TP);
            this_player()->die();
            env->Message(
               "Tod verschwindet mit Knall und Schwefelduft.\n",
                 MSGFLAG_NO_TP);
            INFO_LOG(sprintf("Knapp daneben: %s",owner));
	    DBG("warn",capitalize(owner)+ " wird vom Glueckskeks umgebracht.");
            break;
        case 23..27: // 5:200 == 1:40
            trost=clone_object("/obj/money");  
               // 1 Promille Chance auf eine Million!
            trost->AddAmount((!random(1000)?999999:random(100)));
            trost->move(env,M_NOCHECK);
            env->Message(break_string(
            "Als sich die Wolke verzieht, bleibt unermesslicher Reichtum" + 
              " zurueck.\n",78,0,1),MSGFLAG_VISUAL);
            INFO_LOG(sprintf("Geldgewinn: %s - %d",owner,trost->QueryProp(P_AMOUNT)));
	    DBG("info",capitalize(owner)+ " wird vom Glueckskeks mit "+trost->QueryProp(P_AMOUNT)+" Muenzen bedacht.");
            break;
        default :
            env->Message(break_string(
                "Leider passiert ueberhaupt nichts weiter.",78),
                 MSGFLAG_VISUAL);
            INFO_LOG(sprintf("Niete: %s ",owner));
	    DBG("info",capitalize(owner)+ " zerdeppert einen ereignislosen Glueckskeks.");

            break;
    }
    ::remove();
    return 1;
}

nomask void create() {
    seteuid(getuid(this_object()));
    if (!is_clone(this_object())) 
      return;
    ::create();
    SetProp(P_SHORT,"Ein goldener Glueckskeks");
    SetProp(P_LONG,"Woah. Das Ding hat in etwa die Form einer dicken Scheibe, "
        "im Durchmesser aehnlich einer mittelgrossen Muenze, ist aber schwer, "
        "unerwartet schwer, und fuehlt sich warm an. Die Kanten des goldenen "
        "Dings sind abgerundet, dafuer ist die gesamte Oberflaeche mit einem "
        "sehr feinen Muster. Sinn und Zweck dieses Dings, das Du aus "
        "unerfindlichen Gruenden 'Glueckskeks' nennst, erschliesst sich auf "
        "den ersten Blick nicht. ");
    SetProp(P_NAME,"Glueckskeks");
    SetProp(P_GENDER, MALE);
    SetProp(P_VALUE,50000); 
    SetProp(P_WEIGHT,1250);
    SetProp(P_SIZE,3);
    SetProp(P_KILL_NAME,"Eine ueberaus unglueckliche Verkettung extrem widriger Umstaende");
    SetProp(P_KILL_MSG,"Oh... Aeh... Hoppla?");
    SetProp(P_SOUND,"Irgendwas da drin singt ganz leise vor sich hin.\n");
    SetProp(P_SMELL,"Gold stinkt nicht.\n");
    SetProp(P_MATERIAL,([MAT_GOLD:50,MAT_MAGIC:50]));
    SetProp(P_NODROP,
      "Einen goldenen Glueckskeks laesst man nicht einfach fallen.\n");
    SetProp(P_NEVERDROP,
      "Einen goldenen Glueckskeks laesst man nicht einfach fallen.\n");
    AddCmd(({"zerdepper","zerdeppere"}),"cmdZerdepper");

    AddId(({"ding","glueckskeks","\a\n\a\tol_glueckskeks","keks"}));
    AddAdjective(({"golden"}));
 
    AddDetail(({"goldmuenzen","goldmuenze", "form", "scheibe", "durchmesser"}), 
        "Der Glueckskeks sind ueberhaupt nicht keksig aus, mehr wie drei "
        "aufeinander geklebte kleine polierte Goldmuenzen.");
    AddDetail(({"kante","kanten"}),
        "Die Kanten sind grosszuegig abgerundet, so dass die Gefahr, sich "
        "zu verletzen, an sich recht gering scheint."); 
    AddSpecialDetail(({"oberflaeche","muster"}),"detMuster");
    AddDetail(({"blick", "sinn", "zweck", "grund","gruende","sinn und zweck"}),
        "Auf den ersten Blick erschliesst sich Sinn und Zweck des Dings "
        "nicht. Aber Du hast doch bestimmt noch andere Moeglichkeiten, "
        "etwas ueber seltsame Dinge zu erfahren.");
    AddDetail(({"gold","golde"}),
        "Es ist ja nicht alles Gold, was glänzt. Und auch wenn der "
	"Glueckskeks vom Aussehen und Gewicht dem Golde sehr aehnelt, "
	"steckt doch sicher mehr in ihm.");
    AddDetail(({"moeglichkeit","moeglichkeiten"}),
        "Tja, was wird das wohl sein...");
    AddDetail(({"gewinn","betrachtung"}),
        "Ja, man kann dabei was gewinnen und ja, man gewinnt sofort. "
        "Oberflaechlich betrachtet koennte man den Glueckskeks auch "
        "'Rubbellos' nennen.");
    AddDetail(({"rubbellos","rubbellose"}),
        "Bei oberflaechlicher Betrachtung koennte man den Glueckskeks "
        "auch 'Rubbellos' nennen. Bei oberflaechlicher Betrachtung. Es "
        "gibt da naemlich einen kleinen Unterschied.");
    AddDetail("ding",
        "Das Ding ist schon seltsam... und moeglicherweise auch nicht "
	"ganz ungefaehrlich. Besser, Du kuckst es Dir ganz genau an, "
	"damit Du wenigstens weisst, worauf Du Dich einlaesst. Ach. "
	"Andererseits. Dran aendern kannst du nix, also was solls!");
    AddDetail(({"glueck", "portion"}),
        "Es bedarf einer grossen Portion Glueck fuer das grosse Glueck.");
    AddDetail("unterschied","Rubbellose toeten nicht.");
}



nomask string _query_info() {
    string res;
    if (!this_player()) return "pecunia non olet.\n";
    if (this_player() != environment(this_object())) return 
        "Die Magie dieses Objekts ist nur erkennbar, wenn Du es bei Dir "
        "traegst.\n";  // Naja, reine Schikane ;-)
    res= "Essbar ist der Glueckskeks sicher nicht, aber Du kannst Dein Glueck "
        "trotzdem herausfordern, in dem Du den Glueckskeks zerdepperst. "
        "Da wird wohl meistens nicht viel passieren, aber mit einer grossen "
        "Portion Glueck kannst Du einen sehr wertvollen Gewinn einstreichen. ";
    if (!IS_SEER(this_player()))
        res+="Naja, koenntest Du zumindest, waerest Du Seher von gewissem Stand.";
    else if ((int)((this_player()->QueryProp(P_LEVEL))) < LEVEL_NEEDED)
        res+="Naja, kannst Du zumindest, wenn Du " + 
           ((LEVEL_NEEDED - (int)(this_player()->QueryProp(P_LEVEL)))==1
               ?"noch ein klitzekleines Stuefchen"
               :"noch "+(LEVEL_NEEDED - (int)(this_player()->QueryProp(P_LEVEL)))
                   + " Stufen") + " aufgestiegen bist.";
    else if ( (int)MAY_UPGRADE(UPGRADE_NO,getuid(this_player()))==
              HOUSE_UPGRADE_NO_SUCH_HOUSE) {
        res+="Naja, nein, kannst Du nicht. Zumindest solange Du kein "
            "Seherhaus hast. (*mit dem Zaunpfahl zuhau!*)";
        gotHitByZaunpfahl();
    }
    else if ( (int)MAY_UPGRADE(UPGRADE_NO,getuid(this_player()))==
              HOUSE_UPGRADE_ALREADY_DONE) {
        res+="Stop. Nein, kannst Du nicht. Einmal reicht. DU hast schon. "
            "Wer schon hat, der kriegt nix mehr. Echt mal. Ich glaub, es "
            "hackt!";
    }
    return break_string(res,78);
}  


/* Aufzurufen in der Blueprint, sie muss fuer den upgrade.c das 
   previous_object() sein.  */

nomask void doUpgrade() {
    string owner;
    string result1;
    string result2;

    result1=result2="";
    if ((!this_player())||(!query_once_interactive(this_player()))) return;
    owner=getuid(this_player());
    if (process_call() || (explode(file_name(this_object()),"#")[0] !=
        explode(file_name(previous_object()),"#")[0])) {
        FAIL_LOG(sprintf("Sehr seltsam (%s,%s,%s)",owner, 
            file_name(previous_object()),file_name(this_interactive())));
        return; 
    }
    if ((!IS_SEER(this_player())) || 
        ((int)(this_player()->QueryProp(P_LEVEL)) < LEVEL_NEEDED)) {
        result1="Es ist schon ziemlich unklug, Hinweise, die sehr "
            "deutlich machen, dass einem irgendetwas fehlt, um vom "
            "moeglichen Hauptgewinn profitieren zu koennen, ausser "
            "acht zu lassen. Du haettest jetzt den Hauptgewinn "
            "gewonnen. Glueckwunsch.";
        result2="Wie schade - da haette " + this_player()->Name(WER) + 
            "einen Seherhausausbau gewonnen...\n...und erfuellt die " 
            "Teilnahmebedingungen nicht. (Kopf->Tisch)";   
        KEKS_LOG(sprintf("Gewinnt, aber nicht berechtigt: %s",owner));
    } 
    else {
        switch ((int)UPGRADE(UPGRADE_NO,owner=getuid(this_player()))) {
            case HOUSE_UPGRADE_BAD_CALL:                  // Echter Fehler
                write("Oh, da gab es einen Bug. Gib mal dem zustaendigen "
                    " Magier Bescheid. (#0012)\n");
                FAIL_LOG(sprintf("Fehlerhafter Aufruf (%s)",owner));
                break;
            case HOUSE_UPGRADE_ACCESS_FAILURE:            // Echter Fehler
                write("Oh, da gab es einen Bug. Gib mal dem zustaendigen "
                    " Magier Bescheid. (#0013)\n");
                FAIL_LOG(sprintf("Fehlende Zugriffsrechte (%s)",owner));
                break;
            case HOUSE_UPGRADE_FAILED:                    // Echter Fehler
                write("Oh, da gab es einen Bug. Gib mal dem zustaendigen "
                    " Magier Bescheid. (#0014)\n");
                FAIL_LOG(sprintf("Seltsamer Fehler (%s)",owner));
                break;
            case HOUSE_UPGRADE_HOUSE_LOAD_FAIL:           // Echter Fehler
                write("Oh, da gab es einen Bug. Gib mal dem zustaendigen "
                    " Magier Bescheid. (#0015)\n");
                FAIL_LOG(sprintf("Seherhaus nicht ladbar (%s)",owner));
                break;
            case HOUSE_UPGRADE_NO_SUCH_HOUSE:             // Selten so gelacht
                result1="Es ist ja nicht so, dass es keine Hinweise gab. "
                    "Jetzt musst Du damit klarkommen, dass Du gewonnen "
                    "HAETTEST (was echt nicht sehr wahrscheinlich war), "
                    "der Gewinn aber verfaellt, weil Du kein passendes "
                    "Seherhaus hast.";
                result2="Wie schade - da haette " + this_player()->Name(WER) + 
                    "einen Seherhausausbau gewonnen...\n"
                    "...und hat gar kein Seherhaus...(Kopf->Tisch)";   
                KEKS_LOG(sprintf("Gewinnt, aber ohne Haus: %s",owner));
                break;
            case HOUSE_UPGRADE_ALREADY_DONE:  // Fehler des Spielers :))
                result1="Wahnsinnig witzig und ganz schoen dekadent, aber "
                    "Du hast es geschafft. Du hast das Glueckslos ein "
                    "zweites mal aus der Trommel gefischt - obwohl Du "
                    "sicher wusstest, dass es Dir nichts bringt.";
                result2="Dekadenz hat einen Namen: " + 
                    this_player()->Name(WER) + "!\n";
                KEKS_LOG(sprintf("Gewinnt... zum zweiten Mal: %s",owner));
                break;
            case 1:          
                result1=" ***** DU HAST GEWONNEN! *****\n"
                    "Glueckwunsch! Dein Seherhaus ist groesser geworden!\n";
                result2="Glueckwunsch! " + this_player()->Name(WER) + 
                    " hat einen Seherhausausbau gewonnen!\n";
                KEKS_LOG(sprintf("Gewonnen: %s",owner));
                break;
            default:
                write("Oh, da gab es einen Bug. Gib mal dem zustaendigen "
                    " Magier Bescheid. (#0018)\n");
                FAIL_LOG(sprintf("switch default? (%s)",owner));
                break;
        }
    }
    if (strlen(result1)>0)
       write(break_string(result1,78));
    if (strlen(result2)>0) {
       if ((IS_WIZARD(this_player())) || 
               (this_player()->QueryProp(P_TESTPLAYER)))
           write(break_string(result2,78,0,1));
       else
           shout(break_string(result2,78,0,1));
    }
    return;
}
