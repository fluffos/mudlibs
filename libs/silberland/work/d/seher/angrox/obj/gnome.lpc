inherit "std/thing";

#include <defines.h>
#include <moredef.h>
#include <properties.h>

int dauer;
object owner;

create()
{
  if (!is_clone(ME)) return;
  ::create();
  dauer=0;
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du sprichst rueckwaerts.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\nsprachfluch"}));
  owner=0;
}

init() {
  ::init();
  if(interactive(ENV(ME)))
    ENV(ME)->SetProp(P_PERM_STRING, this_object());
}



string permutate_string (string str) {
 string transformed, *expl;
 mixed names;
 int i, x;
 expl=new_explode(str, "");
 x=sizeof(expl)-1;
 if (x<2) return str;
 for (i=0;i<=x;i++) {
   //TELL("angrox", sprintf("Buchstabe: %s\n", expl[i]));
   if(i==0 && expl[i]=="n") expl[i]="gn";
   else if(i==0 && expl[i]=="N") expl[i]="Gn";
   else if(expl[i]=="n" && expl[i-1]!="g")
     expl[i]="gn";
   else if(expl[i]=="N" && lower_case(expl[i-1])!="G")
     expl[i]="Gn";
 }
 transformed=implode(expl, "");
 return transformed;
}

void reset()
{
  ::reset();
  remove();
} 
