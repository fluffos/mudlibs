inherit "std/thing";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ("alter");
  SetProp (P_SHORT, 0);
  
  SetProp (P_NAME, "Alter");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 0);
  SetProp (P_VALUE, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_MATERIAL, MAT_MISC);

}

string extra_look()
{
   if (environment()->QueryProp(P_GENDER)==2)
      return bs ("Sie ist vom Alter gebeugt und kann kaum noch "
                +"gerade gehen.\n");
   else
     return bs ("Er ist vom Alter gebeugt und kann kaum noch "
                +"gerade gehen.\n");
  
}


