inherit "std/thing";

#include <defines.h>
#include <moredef.h>
#include <properties.h>

int dauer;
object owner;

create()
{
  if (!is_clone(ME)) return;
  ::create();
  dauer=0;
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du sprichst rueckwaerts.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\nsprachfluch"}));
  owner=0;
}

init() {
  ::init();
  if(interactive(ENV(ME)))
    ENV(ME)->SetProp(P_PERM_STRING, this_object());
}



string permutate_string (string str) {
 int flag; 
 string transform;
 flag=0;
 transform=regreplace(str, "Bier", "Kamillentee", flag);
 transform=regreplace(transform, "bier", "kracherl", flag);
 transform=regreplace(transform, "besuchen", "ficken", flag);
 transform=regreplace(transform, "gehen", "brunzen", flag);
 transform=regreplace(transform, "gehn", "brunzn", flag);
 transform=regreplace(transform, "geht", "brunzt", flag);
 transform=regreplace(transform, "geholt", "gefickt", flag);
 transform=regreplace(transform, "crea", "elton", flag);
 transform=regreplace(transform, "lim", "mr. todessequenz", flag);
 transform=regreplace(transform, "singen", "groehlen", flag);
 transform=regreplace(transform, "fragen", "haben", flag);
 transform=regreplace(transform, "frage", "habe", flag);
 transform=regreplace(transform, "frag", "hab", flag);
 transform=regreplace(transform, "rufen", "singen", flag);
 transform=regreplace(transform, "rufe", "singe", flag);
 transform=regreplace(transform, "ruf", "sing", flag);
 transform=regreplace(transform, "telefon", "optokoppler", flag);
 transform=regreplace(transform, "muenzen", "tabletten", flag);
 transform=regreplace(transform, "muenze", "tablette", flag);
 transform=regreplace(transform, "gebiet", "brunnen", flag);
 transform=regreplace(transform, "dante", "bug", flag);
 transform=regreplace(transform, "naehe", "weite", flag);
 transform=regreplace(transform, "hallo", "schleichts euch", flag);
 transform=regreplace(transform, "lol", "leck o' mio", flag);
 transform=regreplace(transform, "rotfl", "=(((((((", flag);
 transform=regreplace(transform, "nichts", "alles", flag);
 transform=regreplace(transform, "ja", "nein", flag);
 transform=regreplace(transform, "nein", "ja", flag);
 transform=regreplace(transform, "freund", "feind", flag);
 transform=regreplace(transform, "danke", "pfffffffffffff", flag);
 transform=regreplace(transform, "quest", "kacke", flag);
 transform=regreplace(transform, "warum", "darum", flag);
 transform=regreplace(transform, "magier", "idler", flag);


 return transform;
}

void reset()
{
  ::reset();
  remove();
} 
