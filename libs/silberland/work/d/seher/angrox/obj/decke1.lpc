inherit "/std/thing";

create ()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT,"Eine samtweiche Schmusedecke");
  SetProp(P_LONG, BS("Ochhhhh ... wie suess!!! Eine samtweiche, "
	 +"knuddelig-wuschelige Schmusedecke! Sie leuchtet Dich in "
	 +"einem zarten Gelb an und wird Dir sicherlich bald so ans "
	 +"Herzen gewachsen sein, dass Du sie nie wieder hergeben willst, "
	 +"da Du sie schmusen, Dich bei ihr ankuscheln, anschmiegen und "
	 +"ausweinen kannst.\nDeine Schmusedecke kann allerdings noch "
	 +"viel mehr: Du kannst damit andere Spieler aus der Ferne "
	 +"angrinsen, wuscheln, umarmen, stupsen, sie haetscheln und taetscheln, "
	 +"sie anlaecheln, troesten, Dich bei ihnen anschmiegen und "
	 +"ankuscheln, an ihren Ohren knabbern, Dich bei ihnen bedanken "
	 +"und sie sogar kuessen. Allerdings kostet Dich dass einen "
	 +"Magiepunkt, und es funktioniert nur, wenn Du ein \"r\" vor "
	 +"das entsprechende Verb stellst.\n"));

  AddId(({"decke", "schmusedecke"}));
  SetProp (P_NAME,"Schmusedecke");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 200);
  SetProp (P_NOBUY, 1);
  SetProp (P_VALUE, 0);
  SetProp (P_MATERIAL, ({MAT_CLOTH, MAT_VELVET}));

  AddCmd (({"rgrins", "rgrinse", "rwuschel", "rwuschle", "rtaetschle", "rstupse", "rstups",
			"rtaetschel", "rumarme", "rumarm", "rlaechle", "rlaechel",
			"rtroeste", "rtroest", "rschmiege", "rschmieg", "rkuschel",
			"rkuschle", "rknabbere", "rknabber", "rkuesse", "rkuess",
			"rhaetschle", "rhaetschel", "rdanke", "rdank"}),
			"remote_actions");
  AddCmd (({"schmus","schmuse"}),"schmuse_decke");
  AddCmd (({"kuschel","kuschle"}),"kuschel_decke");
  AddCmd (({"weine","wein"}),"weine_decke");
  AddCmd (({"schmiege","schmieg"}),"schmiege_decke");
}


schmuse_decke(string str)
{
  notify_fail ("Was moechtest Du denn schmusen?");
  if (str=="decke" || str=="schmusedecke")
	{
	  write (BS("Du nimmst Deine samtweiche Schmusedecke und schmust "
			+"Dich so richtig in sie hinein. Fuer einen Augenblick "
			+"vergisst Du alles um Dich herum und fuehlst Dich so "
			+"richtig gluecklich.\n"));
	  say (BS(this_player()->name(WER,2)+" schmust "
		  +(PlayerGender==FEMALE ? "ihre" : "seine")+" Schmusedecke so "
		  +"richtig fest. Du spuerst foermlich, wie gluecklich "
		  +this_player()->name(WER,2)+" jetzt ist und wuerdest am liebsten "
		  +"auch diese Decke haben und Dich reinschmusen.\n"));
	  return 1;
	};
  return 0;
}


kuschel_decke(string str)
{
  //notify_fail ("Wen moechtest Du knuddeln?");
  if (str=="decke" || str=="schmusedecke")
	{
	  write (BS("Du nimmst Deine weiche Decke und kuschelst Dich so "
			+"richtig in sie rein. Du quietscht "
			+"dabei gluecklich und kannst foermlich erkennen, wie "
			+"Dich die anderen Anwesenden um Deine Schmusedecke "
			+"beneiden.\n"));

	  say (BS(this_player()->name(WER,2)+" kuschelt sich richtig fest in "
		  +(PlayerGender==FEMALE ? "ihre" : "seine")+" Schmusedecke "
		  +"hinein und quietscht dabei gluecklich. Irgendwie beneidest Du "
		  +this_player()->name(WER,2)+" um "
		  +(PlayerGender==FEMALE ? "ihre" : "seine")+" tolle "
		  +"Schmusedecke...\n"));
	  return 1;
	};
  return 0;
}


weine_decke(string str)
{
  if (str=="decke" || str=="schmusedecke")
	{
	  write (BS("Mit einem lauten Schluchzen nimmst Du Deine "
		  +"Schmusedecke, drueckst Dein Gesicht in den weichen "
		  +"Stoff und beginnst mitleidserregend zu weinen. "
		  +"WUAEHHHHHHHHH!"));

	  say (BS(this_player()->name(WER,2)+" schluchzt laut, nimmt "
		  +(PlayerGender==FEMALE ? "ihre" : "seine")+" Schmusedecke, "
		  +"presst "+(PlayerGender==FEMALE ? "ihr" : "sein")+" Gesicht "
		  +"hinein und beginnt mitleidserregend zu heulen.\n"));

	  return 1;
	};
  return 0;
}


schmiege_decke(string str)
{
  //notify_fail ("Wo moechtest Du Dich denn anschmiegen?");
  if (str=="decke" || str=="schmusedecke")
	{
	  write (BS("Du nimmst Deine weiche Decke und schmiegst Dich so "
			+"richtig in sie rein. Du quietscht "
			+"dabei gluecklich und kannst foermlich erkennen, wie "
			+"Dich die anderen Anwesenden um Deine Schmusedecke "
			+"beneiden.\n"));

	  say (BS(this_player()->name(WER,2)+" schmiegt sich richtig fest in "
		  +(PlayerGender==FEMALE ? "ihre" : "seine")+" Schmusedecke "
		  +"hinein und quietscht dabei gluecklich. Irgendwie beneidest Du "
		  +this_player()->name(WER,2)+" um "
		  +(PlayerGender==FEMALE ? "ihre" : "seine")+" tolle "
		  +"Schmusedecke..."));
	  return 1;
	};
  return 0;
}


remote_actions(string text)
{

 object player;
 mixed pname;
 string quote;
 string *sentence;
 mapping remote_texte;
 string *ign;

 notify_fail("Schoen und gut - aber welchen Spieler meinst Du denn?\n");
 if (extern_call() && this_interactive()) text=this_interactive()->_unparsed_args();
 if (!text) return 0;

 if (!IS_LEARNER(TP))
 {
   if (!TP->QueryProp(P_SP))
   {
     write("Dazu hast Du zuwenig Magiepunkte.\n");
     return 1;
   }
   TP->AddSp(-1);
 }

 pname = lower_case((sentence=explode(text," "))[0]);
 quote = ParseAdverben(implode(explode(text," ")[1..]," "),this_player());
 if (quote==0) quote="";
 if (quote!="") quote=" "+quote;

 if (!player = find_player(pname))
	 {
         pname = match_living(pname, 1);
         if (pname == -1)
                 {
                 write("Das war nicht eindeutig!\n");
                 return 1;
                 }
         else if (!stringp(pname) || !(player = find_player(pname)))
                 {
                 write("Dieser Spieler scheint nicht da zu sein.\n");
                 return 1;
                 }
         }

 if (player->QueryProp(P_INVIS) && !IS_LEARNING(this_player()))
         {
         write("Dieser Spieler scheint nicht da zu sein.\n");
         return 1;
         }
 if (present(pname,environment(TP)))
	 {
	 write("Aber dieser Spieler steht doch neben Dir!\n");
		 return 1;
	 };
 if (ign=player->QueryProp(P_IGNORE))
 if (member(ign,lower_case(TPN)+".decke")!=-1)
	 {
	 write(capitalize(pname)+" ignoriert Dich. *Schnuff*\n");
	 return 1;
	 };
 remote_texte=TEXT_MAPPING;
 write(remote_texte[query_verb(),0]);
 player->Message( remote_texte[query_verb(),1], MSGFLAG_SOUL );
 // tell_object(player, remote_texte[query_verb(),1]);
 return 1;
}

string _in(string a,mapping m)
{
  if (member(m,lower_case(a)))
    return m[a];
  else
    return "";
}



string ParseAdverben(string str,object ob)
{
  string *advpart,quotedpart;
  mapping adverben;
  if (! str) return 0;
  str=" "+str;
  adverben=ob->QueryStdAdverbs()+ob->QueryAdverbs();
  advpart=explode(str,"/");
  if (sizeof(advpart)>1)
      quotedpart=implode(advpart[1..],"/");
  else
    quotedpart="";
  advpart=regexplode(advpart[0],"\\<[^, ]*\\>");
//  write(sprintf("%O\n",advpart));
  advpart=(map_array(advpart,#'_in,adverben)+({quotedpart}))-({""}); //'));
  return ob->CountUp(advpart);

}

