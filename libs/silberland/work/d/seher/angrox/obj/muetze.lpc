/*
** Eine rote Zwergenmuetze
** 27-01-97 Angrox@SL
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../files.h"

int muetze_getragen;
#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  muetze_getragen=0;
  
  AddId (({"muetze", "zwergenmuetze"}));
  SetProp (P_SHORT, "Eine rote Zwergenmuetze");
  SetProp (P_LONG, "Die rote Zwergenmuetze ist fuer Gartenzwerge, "
               +"und solche die es werden wollen, ein unbedingtes "
               +"muss. Sie besteht aus flauschigen Samt und schmiegt "
               +"sich sicherlich an Deinen Kopf an.");
             
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 10);
  SetProp(P_NAME, "rote Zwergenmuetze");
  //SetProp (P_INFO, "Die rote Muetze wurde von den silberlaendischen "
  //           +"Gartenzwergenmuetzenmanufaktur exklusiv fuer Thor "
  //           +"fabriziert");
  SetProp (P_ARMOUR_TYPE, AT_MISC); 
  SetProp (P_AC, 0);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_WEAR_TEXT, ({"Du setzt Deine rote Zwergenmuetze auf.\n",
                         " setzt eine rote Zwergenmuetze auf.\n"}));
  SetProp(P_UNWEAR_TEXT, ({"Du nimmst Deine rote Zwergenmuetze ab.\n",
                           " nimmt eine rote Zwergenmuetze vom Kopf.\n"}));
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_REMOVE_FUNC, this_object());

  AddDetail("material", "Es handelt sich um Samt.");
  AddDetail("samt", "Der Samt fuehlt sich so schoen weich an.");
  //AddDetail("widmung", "Du kannst sie lesen, oder?");
  //AddReadDetail("widmung", "Da steht: Fuer meine Lieblingsseherin von "
   //              +"Angrox.\nDu erroetest.\n");
}

string extra_look()
{
  if (muetze_getragen)
    {
      if (environment()->QueryProp(P_GENDER)==2)
        return bs ("Sie hat noch eine suesse, rote Zwergenmuetze auf dem Kopf.\n");
      else
        return bs ("Er hat noch eine suesse, rote Zwrgenmuetze auf dem Kopf.\n");
    }
  muetze_getragen=0;
  
}

int WearFunc(object me)
{
 muetze_getragen=1;
 return 1;
}

int RemoveFunc(object me)
{
 muetze_getragen=0;
 return 1;
}
