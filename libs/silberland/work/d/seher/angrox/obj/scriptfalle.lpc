//  
// Ein Object, das Untersuchungsscripts verhindern soll!
//  
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>

int counter=0; 
int pre_time=0; 
int cur_time=0;
string str_old;

create()
{
  if (!is_clone(TO) )  return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");
  SetProp(P_GENDER, MALE);
  AddId(({"\nscriptfalle", "antiscript"}));
  SetProp(P_NAME, "Scriptfalle");
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  //SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_KILL_MSG, "Lars, lass fuer Scripter keine Gnade walten!");
  AddCmd(({"schaue", "schau", "unt"}), "scriptfalle"); 
}

scriptfalle(string str)
{
 int difference;
 if(!str) return 0;   
 if(str_old==str) return 0; 
 if(!pre_time)
   {
    pre_time=time();
    return 0;
   }
 if(IS_LEARNER(TP))
   {
      write("\n"+str+"/"+str_old+"\n");
   }
 str_old=str;     
 cur_time=time(); 
 difference=cur_time-pre_time;  
 if(!difference)
   {
    counter++;                  
   }
 if(difference>200) difference=0;                               
 if(difference>400) counter=0;  
 counter=counter-difference/3; 
 if (counter<0) counter=0;
 if(counter>40) 
   {
     write("\nHuch ... irgendwas passiert mit Dir...\n");
     counter=0;
     call_out("falle_zugeschnappt", 0);
   }
 if(IS_LEARNER(TP))
   {
     write("Anz. der Sek.: "+difference+"\n");
     write("Counter: "+counter+"\n");
   }
 pre_time=time();   // setzen der aktuellen zeit nach unt
 return 0; 
}


falle_zugeschnappt()
{
 object ob;
 int zahl;
 switch(random(5)+1)
   {
   case 1: TP->do_damage(50+random(200));
           break;
   case 2: if(ob=deep_present("muenzen", TP))
             {
             zahl=ob->QueryProp(P_AMOUNT);
             ob=SetProp(P_AMOUNT, (zahl/100)*(30+random(70)));
	     }
           else TP->do_damage(100);
           break;
   case 3: if (ob=first_inventory(TP))
                ob->remove();
           else TP->do_damage(100+random(50));
           break;
   case 4: TP->die();
           break;
   case 5: if(ob=deep_present("muenzen", TP))
             {
             if((ob->QueryProp(P_SHORT))!=0)
                 ob->remove();
             else TP->do_damage(random(250));
	     }
           else TP->do_damage(random(200));
           break;
   }
}





