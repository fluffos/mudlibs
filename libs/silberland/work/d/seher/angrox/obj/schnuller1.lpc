** 20-06-1996  Extraverb "nuckle" hinzugefuegt
** 09-01-1997  Modell "Wuschel"
*/


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../files.h"

#define PlayerGender this_player()->QueryProp(P_GENDER)
int schnuller_in_mund;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  schnuller_in_mund=0;
  AddId ("schnuller");
  SetProp (P_SHORT, "Ein zartgelber Schnuller");
  SetProp (P_LONG, bs(
           "Dieser kleine, zartgelbe Schnuller ist einfach suess. Am liebsten wuerdest "
           "du ihn sofort in den Mund nehmen.\n"));

  SetProp (P_INFO, BS("Wenn Du deinen Schnuller hast, kannst Du auf ihm herum<nuckel>n! "
                    +"Allerdings ist dieser Schnuller, so wie vieles, fuer Wuschel "
                    +"angefertigt. Wenn er also nicht im Besitz von Wuschel ist, dann "
                    +"ist er bitte zurueckzubringen. Danke.\n"));

  SetProp (P_NAME, "Schnuller");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 40);
  SetProp (P_VALUE, 50);
  SetProp (P_NOBUY, 0);
  

  SetProp (P_MATERIAL, MAT_GUM);
  AddCmd ("nimm", "nimm");
  AddCmd ("wirf", "wirf"); 
  AddCmd ("gib", "gib"); 
  AddCmd ("nuckle", "nuckel");

}

string extra_look()
{
  if (schnuller_in_mund)
    {
      if (environment()->QueryProp(P_GENDER)==2)
        return bs ("Sie hat einen gelben Schnuller in ihrem Mund.\n");
      else
        return bs ("Er hat einen gelben Schnuller in seinem Mund.\n");
    }
  schnuller_in_mund=0;
  
}



nimm(str)
{
  notify_fail("Was willst du den nehmen?\n");
  if(str=="schnuller in mund" && schnuller_in_mund==0)
      {
      write(BS("Voller Ungeduld steckst du den Schnuller in deinen Mund und "
           +"nuckelst ein bisschen darauf herum. Hmm... dieser tolle "
           +"Zitronengeschmack. Genau richtig und nicht zu sauer. Einfach lecker. "
           +"Nur Kuesse schmecken (vielleicht) besser.\n"));
      say(TPN+" steckt einen Schnuller in "+(PlayerGender==FEMALE ? "ihren" : "seinen")+
                 " Mund und nuckelt darauf herum.\n");
      schnuller_in_mund = 1;
      return 1;
    }
  else if (str=="schnuller in mund" && schnuller_in_mund==1)
    {
     write("Du hast ihn schon im Mund. *nuckel*\n");
     return 1;
    }
  
  if(str=="schnuller aus mund" && schnuller_in_mund==1)
    {
     write("Mit einer zoegernden Handgewegung und viel Wehmut nimmst\n"
          +"du den Schnuller aus dem Mund.\n");
     say(TPN+" nimmt voller Bedauern und mit einem lauten <PLOPP> einen "
               +"Schnuller aus\n"+(PlayerGender==FEMALE ? "ihrem" : "seinem")+
               " Mund und steckt ihn weg.\n");
     schnuller_in_mund = 0;
     return 1;
   }
  else if(str=="schnuller aus mund" && schnuller_in_mund==0)
    {
     write("Du hast den Schnuller nicht im Mund.\n");
     return 1;
   }
  return 0;
}

wirf(str)
{
 notify_fail("Was willst du den werfen?\n");
  if (str=="schnuller weg" && schnuller_in_mund==1)
    {
     write("Du musst den Schnuller zuerst aus dem Mund nehmen!\n");
     return 1;
   }
 return 0;
}


gib(str)
{
 notify_fail("Was willst du WEM geben?\n");
 if (str=="schnuller weg" && schnuller_in_mund==1)
    {
     write("Du musst den Schnuller zuerst aus dem Mund nehmen!\n");
     return 1;
   }
 return 0;
}

nuckel()
{
int anzahl;
 notify_fail("Dazu musst du den Schnuller zuerst in den Mund nehmen.\n");
 if (schnuller_in_mund)
   {
    write("Du nuckelst ein bisschen auf deinem Schnuller herum.\n"
         +"Hmm...nur Kuesse schmecken besser!!!\n");
    say(TPN+" nuckelt auf "+(PlayerGender==FEMALE ? "ihrem" : "seinem")+
               " gelben Schnuller herum.\n");
    anzahl++;
    if (anzahl>10)
      {
       TP->heal_self(5);
       anzahl=0;
     }
    return 1;
  }
return 0;
}













