/*
** Ein Guertel 
** 07.06.1996 by Angrox@Silberland
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../files.h"

#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"guertel", "keuschheitsguertel"}));
  SetProp (P_SHORT, "Ein Keuschheitsguertel");
  SetProp (P_LONG,
    "Das ist ein magischer Keuschheitsguertel. Er verhindert "
    +"jegliche Annaeherung an das andere Geschlecht, aussgenommnen "
    +"Deinen Ehepartner.");
  SetProp (P_NAME, "Keuschheitsguertel");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 500);
  SetProp (P_VALUE, 100);
  SetProp (P_NODROP, "So leicht wirst Du den nicht mehr los.\n");

  SetProp (P_ARMOUR_TYPE, AT_MISC);  // siehe sys/combat.h
  SetProp (P_AC, 0);

  SetProp (P_MATERIAL, MAT_LEATHER);
}


void init()
{
 
 add_action("noway", "kuesse", 1);
 add_action("noway", "kuess", 1);
add_action("noway", "knutsche", 1);
add_action("noway", "knutsch", 1);
add_action("noway", "liebe", 1);
add_action("noway", "lieb", 1);
 ::init();
}


noway(string str)
{
 object ob, partner; 
 string partner_name;
 if (!str || CAP(str)==TPN)  return 0;
 if(!(ob=find_living(str)) || !present(ob, ENV(TP))) return 0;
 if( (ob->QueryProp(P_MARRIED))==(TP->QueryProp(P_NAME)) )
  return 0;
 TP->QueryProp(P_MARRIED);
 if((TP->QueryProp(P_MARRIED)) &&
   (partner=find_living(lower_case(TP->QueryProp(P_MARRIED))))!=0)
        tell_object(partner, BS("SKANDAL! Dein Ehepartner "+TPN
                 +" macht sich an "+ob->name(WEN)+" ran!!!\n"));
  
 write (BS("Du versuchst Dich an "+ob->name(WEM)+" heranzumachen, "
           +"doch der Guertel verhindert dies!\n"));
 tell_object (ob,
    BS(CAP(getuid(TP))+" will wohl etwas von Dir, aber ploetzlich "
   + "ueberlegt "+(PlayerGender==FEMALE?"sie":"er")+" es sich "
   +"und zuckt zurueck!"));
 tell_room (ENV(TP),
    BS(CAP(getuid(TP))+" will sich an "+ob->name(WEM)+" herranmachen, "+
    "doch ploetzlich zuckt "+(PlayerGender==FEMALE?"sie":"er")+" zurueck!"),
     ({TP, ob}) );
 return 1;
}





































