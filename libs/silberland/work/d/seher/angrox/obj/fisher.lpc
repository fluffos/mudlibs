inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../files.h"

#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  if (!is_clone(ME)) return;
  ::create();
  AddId(({"friend", "fisherman", "fisherman's"}));
  SetProp (P_SHORT, "Ein Fisherman's Friend");
  SetProp (P_LONG, "Das Fisherman's Friend ist eine braune "
		  +"Pastille, eines der Besten Hustenbonbons weit "
		  +"breit. Dieses hier ist von der Sorte \"Extra "
		  +"stark mit Zucker\". Und vergiss nicht: \"Sind sie "
		  +"zu stark, bist Du zu schwach!\"");

  SetProp (P_NAME, "Fisherman's Friend");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 1);
  SetProp (P_WEIGHT, 10);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL:0, F_SOAK:0, F_ALCOHOL:0, F_POISON:0]));
}

BeimEssen()
{
  write(BS("Du steckst das Fisherman's Friend in Deinen Mund und "
		  +"beginnst zu lutschen ... WOW ... echt scharf!!!!\n"));
  say (TPN+BS(" steckt ein Fisherman's Friend in den Mund und lutscht "
		  +"darauf herum. Ploetzlich veraendert sich "
		  +(PlayerGender==FEMALE? "ihr":"sein")+" Gesichtsausdruck "
		  +"und "+(PlayerGender==FEMALE? "sie":"er")+" atmet ganz "
		  +"heftig ein und aus. Nach einiger Zeit atmet "
		  +(PlayerGender==FEMALE? "sie":"er")+" wieder normal und "
		  +"sieht irgendwie erleichtert aus."));
  return ::BeimEssen();
}
