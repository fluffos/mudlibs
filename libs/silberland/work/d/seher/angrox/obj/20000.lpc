inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../files.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ("muenzen");
  SetProp (P_SHORT, "20000 Muenzen");
  SetProp (P_LONG, bs(
           "Du siehst 20000 Muenzen.\n"));
  SetProp (P_NAME, "20000 Muenzen");
  SetProp (P_GENDER, MALE);
  SetProp (P_ARTICLE, 0);
  SetProp (P_WEIGHT, 1000);
  SetProp (P_VALUE, 20000);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOGET, "Die Muenzen sind am Boden festgeklebt. Du kannst sie nicht nehmen.\n");
  SetProp (P_MATERIAL, MAT_GOLD);
 
}



