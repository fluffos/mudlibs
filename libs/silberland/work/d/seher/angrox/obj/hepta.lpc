#include <properties.h>
#include <combat.h>
inherit "std/armour";
#include <moving.h>
#include <wizlevels.h>
#include "../files.h"

create()
{
    if (!is_clone(this_object())) return;
    ::create();
    SetProp(P_SHORT, "Das Heptagramm-Amulett");
    SetProp(P_LONG, BS("Das Amulett hat die Form eines Heptagrammes.\n"));
    SetProp(P_NAME, "Heptagramm-Amulett");
    SetProp(P_GENDER, NEUTER);
    SetProp(P_VALUE, 0);
    SetProp(P_LIGHT, 1);
    SetProp(P_WEIGHT, 100);
    SetProp(P_AUTOLOADOBJ, 1);
    SetProp(P_ARMOUR_TYPE, AT_MISC);
    SetProp(P_NODROP, "Woody wuerde Dich verkehrt herum aufhaengen, "
                +"wenn Du das tust!\n");
    SetProp(P_NEVERDROP, 1);
    SetProp(P_AC, 0);
    AddCmd( "setangrox", "angrox_set");
    AddId(({"heptagramm", "heptagramm-amulett", "hepta"}));
    call_out("angrox_set", 0);    
}

angrox_set()
{ 
    TP->SetProp(P_TITLE, "will Stufe 31 werden..." );
    TP->SetProp(P_RACE, "Erzzwerg" );
    TP->SetProp(P_GENDER, 1);
    TP->SetProp(P_TESTPLAYER, 0);
    TP->SetProp(P_SECOND, 0);
    TP->SetProp(P_GHOST, 0);
    TP->SetProp(P_FROG, 0);
    TP->SetProp(P_FOOD, 0);
    TP->SetProp(P_SIZE, 135);
    TP->SetProp(P_ALIGN, 500);
    TP->SetProp(P_ALCOHOL, 0);
    TP->SetProp(P_DRINK, 0);
    TP->SetProp(P_FOOD, 0);
    TP->SetProp(P_HANDS, ({" mit toetlichen Blitzen", 10000, DT_LIGHTNING}));
    TP->SetProp(P_BODY, 10000); 
    TP->SetProp(P_PRESAY, "Questadore");
    TP->SetProp(P_MSGIN, "zaubert sich herein");
    TP->SetProp(P_MSGOUT, "verzaubert sich");
    TP->SetProp(P_MMSGIN, "manifestiert sich aus den Schatten");
    TP->SetProp(P_MMSGOUT, "verschwindet in der Dunkelheit");
    TP->SetProp(P_BLIND, 0);
    TP->SetProp(P_ZAP_MSG, ({ "Du schleuderst einen Blitz nach @@wem@@.\n",
        "@@ich@@ schleudert einen Blitz nach @@wem@@.\n",
        "@@ich@@ schleudert einen Blitz nach Dir.\n" }));
    return 1;
}





