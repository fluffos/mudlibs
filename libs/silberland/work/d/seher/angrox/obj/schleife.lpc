/*
** Eine gelbe Haarschleife
** 27-01-97 Angrox@SL
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../files.h"

int schleife_getragen;
#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  schleife_getragen=0;
  
  AddId (({"schleife","haarschleife"}));
  SetProp (P_SHORT, "Eine gelbe Haarschleife");
  SetProp (P_LONG, "Diese gelbe Haarschleife besteht aus feinstem "
             +"Material und ist so richtig samtig weich. Am liebsten "
             +"wuerdest Du sie Dir sofort in Haar stecken.");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 10);
  SetProp(P_NAME, "gelbe Haarschleife");
  SetProp (P_INFO, "Diese wunderschoene, gelbe Haarschleife besteht "
             +"aus dem erlesensten Material und wurde exklusiv fuer "
             +"Wuschel hergestellt. Wenn diese Haarschleife verloren "
             +"gehen sollte, so ist sie unverzueglich an die "
             +"Eigentuemerin zurueckzugeben.");
  SetProp (P_ARMOUR_TYPE, AT_MISC); 
  SetProp (P_AC, 0);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_WEAR_TEXT, ({"Du steckst Dir eine gelbe Schleife ins Haar.\n",
                         " steckt sich eine gelbe Schleife ins Haar.\n"}));
  SetProp(P_UNWEAR_TEXT, ({"Du nimmst eine gelbe Schleife aus Deinem Haar.\n",
                           " nimmt eine gelbe Schleife aus den Haaren.\n"}));
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_REMOVE_FUNC, this_object());

  AddDetail("material", "Es handelt sich um Samt.");
  AddDetail("samt", "Der Samt fuehlt sich so schoen weich an.");
}

string extra_look()
{
  if (schleife_getragen)
    {
      if (environment()->QueryProp(P_GENDER)==2)
        return bs ("In ihrem Haar steckt eine gelbe Haarschleife.\n");
      else
        return bs ("In seinem Haar steckt eine gelbe Haarschleife.\n");
    }
  schleife_getragen=0;
  
}

int WearFunc(object me)
{
 schleife_getragen=1;
 return 1;
}

int RemoveFunc(object me)
{
 schleife_getragen=0;
 return 1;
}
