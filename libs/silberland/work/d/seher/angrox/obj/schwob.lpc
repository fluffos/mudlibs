inherit "std/thing";

#include <defines.h>
#include <moredef.h>
#include <properties.h>

int dauer;
object owner;

create()
{
  if (!is_clone(ME)) return;
  ::create();
  dauer=0;
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du sprichst rueckwaerts.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\nsprachfluch"}));
  owner=0;
}

init() {
  ::init();
  if(interactive(ENV(ME)))
    ENV(ME)->SetProp(P_PERM_STRING, this_object());
}



string permutate_string (string str) {
 int flag; 
 string transform;
 flag=0;
 transform=regreplace(str, "Wochen", "Woche", flag);
 transform=regreplace(transform, "wochen", "woche", flag);
 transform=regreplace(transform, "hat", "hedd", flag);
 transform=regreplace(transform, " eines ", " von a ", flag);
 transform=regreplace(transform, " dieser ", " von dene ", flag);
 transform=regreplace(transform, " des ", " vom ", flag);
 transform=regreplace(transform, " diesem ", " dem ", flag);
 transform=regreplace(transform, " richtig ", " recht ", flag);
 transform=regreplace(transform, " heben", " lupf", flag);
 transform=regreplace(transform, " hebt", " lupf", flag);
 transform=regreplace(transform, " halten ", " heben ", flag);
 transform=regreplace(transform, " etwas", " ebbes", flag);
 transform=regreplace(transform, " auch", " au", flag);
 transform=regreplace(transform, " noch ", " no ", flag);
 transform=regreplace(transform, " nach ", " no ", flag);
 transform=regreplace(transform, " Guten Tag ", " Gruess Gott ", flag);
 transform=regreplace(transform, " guten tag ", " gruess gott ", flag);
 transform=regreplace(transform, "hat", "hedd", flag);
 transform=regreplace(transform, " haben ", " hend ", flag);
 transform=regreplace(transform, " habe ", " hend ", flag);
 transform=regreplace(transform, " ein ", " hend ", flag);
 transform=regreplace(transform, " eine ", " hend ", flag);
 transform=regreplace(transform, "en Sie", "et Sie", flag);
 transform=regreplace(transform, "en Sie", "et Sie", flag);
 transform=regreplace(transform, "wessen", "wem sei", flag);
 transform=regreplace(transform, "Wessen", "Wem sei", flag);
 transform=regreplace(transform, "herunter", "ra", flag);
 transform=regreplace(transform, "hinab", "naa", flag);
 transform=regreplace(transform, "hinunter", "naa", flag);
 transform=regreplace(transform, "hinauf", "nuff", flag);
 transform=regreplace(transform, "herauf", "nuff", flag);
 transform=regreplace(transform, "herauf", "nuff", flag);
 transform=regreplace(transform, "das", "des", flag);
 transform=regreplace(transform, "Das", "Des", flag);
 transform=regreplace(transform, "ran", "dro", flag);
 transform=regreplace(transform, "daran", "dro", flag);
 transform=regreplace(transform, " denn", " noh", flag);
 transform=regreplace(transform, " dann", " noh", flag);
 transform=regreplace(transform, " nein", " hanoi", flag);
 transform=regreplace(transform, " sehr", " saumaessich", flag);
 transform=regreplace(transform, "nicht mehr", "nemme", flag);
 transform=regreplace(transform, " die", " d", flag);
 transform=regreplace(transform, "nichts", "nix", flag);
 transform=regreplace(transform, "Nichts", "Nix", flag);
 transform=regreplace(transform, "tiell", "ziell", flag);
 transform=regreplace(transform, "tion", "zion", flag);
 transform=regreplace(transform, "einge", "oig", flag);
 transform=regreplace(transform, "ange", "og", flag);
 transform=regreplace(transform, "ck", "gg", flag);
 transform=regreplace(transform, "eu", "ei", flag);
 transform=regreplace(transform, "ie", "ia", flag);
 transform=regreplace(transform, "ja", "joo", flag);
 transform=regreplace(transform, "ph", "f", flag);
 transform=regreplace(transform, "Sp", "Schb", flag);
 transform=regreplace(transform, "sp", "schb", flag);
 transform=regreplace(transform, "Th", "Ch", flag);
 transform=regreplace(transform, "th", "ch", flag);
 transform=regreplace(transform, "ut", "uad", flag);
 transform=regreplace(transform, " zu", " z", flag);
 transform=regreplace(transform, "p", "b", flag);
 transform=regreplace(transform, "p", "b", flag);
 transform=regreplace(transform, "t", "d", flag);
 transform=regreplace(transform, "auchen ", "auche ", flag);
 transform=regreplace(transform, "sschen ", "ssle ", flag);
 transform=regreplace(transform, "chen ", "le ", flag);
 transform=regreplace(transform, "ern ", "eret ", flag);
 transform=regreplace(transform, "ich ", "i ", flag);
 transform=regreplace(transform, "Ich ", "I ", flag);
 transform=regreplace(transform, "mal ", "mol ", flag);
 transform=regreplace(transform, "on ", "o ", flag);
 transform=regreplace(transform, "ig ", "ich ", flag);
 transform=regreplace(transform, "pe ", "p ", flag);
 transform=regreplace(transform, "st", "schd", flag);
 transform=regreplace(transform, "en ", "e ", flag);
 transform=regreplace(transform, "!", ", hajo, so isch des !", 0);

 return transform;
}

void reset()
{
  ::reset();
  remove();
} 
