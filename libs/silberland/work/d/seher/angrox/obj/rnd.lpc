inherit "std/thing";

#include <defines.h>
#include <moredef.h>
#include <properties.h>

int dauer;
object owner;

create()
{
  if (!is_clone(ME)) return;
  ::create();
  dauer=0;
  SetProp(P_NAME, "Sprachfluch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Du sprichst rueckwaerts.\n");
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"backspeech", "\nbackspeech", "\nsprachfluch"}));
  owner=0;
}

init() {
  ::init();
  if(interactive(ENV(ME)))
    ENV(ME)->SetProp(P_PERM_STRING, this_object());
}

mixed get_player_names() {
  object *pls;
  string *names;
  int i;
  names=({});
  pls=users()-filter_array(users(), #'is_clone);
  for(i=sizeof(pls)-1;i>=0;i--) 
    names+=({getuid(pls[i])});
  return names;
}


string permutate_string (string str) {
 string transformed, *expl;
 mixed names;
 int i, x;
 expl=explode(str, " ");
 names=get_player_names();
 for(i=sizeof(expl)-1;i>=0;i--) {
   if((x=member(names, lower_case(expl[i])))!=-1) {
     expl[i]=CAP(names[random(sizeof(names))]);
     break;
   }
 } 
 transformed=implode(expl, " ");
 return transformed;
}

void reset()
{
  ::reset();
  remove();
}
    
