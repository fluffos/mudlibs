


inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

#define PlayerGender this_player()->QueryProp(P_GENDER)

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein weisses Hochzeitskleid");
  SetProp(P_LONG, BS( 
    "Dieses Hochzeitkleid ist trotz seiner Schlichtheit ein "
   +"Meisterwerk der SilberLaendischen Hochzeitskleidmanufactur. "
   +"Das Kleid besteht aus reinster Seide, von den begabtesten "
   +"elfischen Seidenspinnern in monatelanger Arbeit gefertigt. "
   +"Das Kleid ist ueber und ueber mit kleinen Perlen "
   +"bestickt, die die Traegerin in einem ueberirdischen Glanz "
   +"erstrahlen lassen.\n"));

  AddDetail("perlen", 
    "Es muessen wohl Hunderte sein, die die Perlentaucher "
   +"aus den Buchten in der Naehe von Tijara erbeutet haben, um "
   +"diesem Kleid die vollendete Schoenheit zu verleihen.");

  AddDetail("seide", 
    "Die Seide ist weich und anschmiegsam, liegt kuehl und sehr "
   +"angenehm auf der Haut.");
   
   AddDetail("platten", "Die Platten, aus denen sich der Panzer "
   +"zusammensetzt, sind sechseckig. Sie sind sehr dick und bieten "
   +"einen hervorragenden Schutz.");  
   
  SetProp(P_INFO, BS("Es gibt nichts besonders an diesem Plattenpanzer.\n") );
   SetProp(P_NAME_ADJ, "weiss");
  SetProp(P_NAME, "Hochzeitskleid");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"kleid", "hochzeitskleid"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC,0);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );
}

int WearFunc(object me)
{
  /*
  if (PlayerGender != FEMALE)
    {
      write(BS("Du bist ja ein Mann. Da solltest Du lieber kein "
        +"Hochzeitskleid anziehen.\n"));
      return 0;
    }
    */ 
  return 1;
}

int RemoveFunc(object me)
{
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  return 0;
}


string extra_look()
{
  if (this_object()->QueryProp(P_WORN))
    {
      return BS("Sie hat ein wundervolles, mit Perlen besticktes "
            +"Hochzeitskleid an.");  
    }
  return "";
}

