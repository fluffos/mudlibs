inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <player.h>
#include <moving.h>
#include <wizlevels.h>
#include "../files.h"


create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create(); 
  AddId ( ({"wolke","gewitterwolke"}) );
  SetProp (P_GENDER, FEMALE);
  SetProp (P_RACE, "Wolke");
  SetProp (P_NAME, "kleine Gewitterwolke");
  SetProp (P_SHORT, "Eine kleine Gewitterwolke");

  SetProp (P_LONG, "Die kleine Gewitterwolke schwebt ueber den Koepfen der "
                   +"Anwesenden. In ihren dunklen Nebel heckt sie vermutlich "
                   +"schon wieder etwas gemeines aus, um jemanden mit einem "
                   +"Blitz zu versengen."); 

  create_default_npc(1);
  SetProp (P_ALIGN, -500);
  SetProp (P_XP, 1000);
  SetProp (P_BODY, 200);
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit einem kleinen Blitz", 100, DT_LIGHTNING}) );
  set_living_name( "wolke" );
  SetProp (P_NOCORPSE, 1);
  SetProp (P_NOATTACK, "weicht Dir geschickt aus und feuert einen kleinen Blitz nach Dir.");
  SetProp (P_DIE_MSG," loest sich auf.\n");
  SetProp(P_MSGIN, "schwebt knisternd vor Energie herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "taucht ploetzlich ueber Euren Koepfen auf");
  SetProp(P_MMSGOUT, "verschwindet urploetzlich");
  SetProp (P_DEFAULT_INFO,
	"knistert vor Energie.\n");

 // SetProp( P_REJECT, ({ REJECT_DROP, "Die Wolke will nix von Dir.\n" }) );


}

void verfolge(object spieler)
{
  string name;
  name=spieler->QueryProp(P_NAME);
  spieler->AddPursuer(ME);
 
  SetChats(20, ({
	"Die Wolke schwebt ueber dem Kopf von "+name+".\n",
	"Die Wolke durchnaesst "+name+".\n",
	"Ein kleiner Blitz von der Wolke trifft "+name+" in den Hintern.\n",
	"Ein Platzregen durchnaesst "+name+" total.\n"
			   }) );
  ME->move(environment(spieler), M_GO); 
  return;
}

void catch_tell(string str)
{
  string wer, wer2, was, wen;
  object spieler;
  if (sscanf(str, "%s sagt: %s %s %s\n", wer, wer2, was, wen)==4)
   {
    if (wer2!="wolke" && wer2!="gewitterwolke") return;
    if (was!="verfolge") return;
    if (!(spieler=find_player(lower_case(wen)))) 
      {
        write("Der Spieler ist nicht da!\n");
        return;
      }
   verfolge(spieler);
   }
}



