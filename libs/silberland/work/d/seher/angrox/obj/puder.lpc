inherit "std/thing";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  AddId ("puder");
  SetProp (P_SHORT, 0);
  
  SetProp (P_NAME, "puder");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 0);
  SetProp (P_VALUE, 0);
  SetProp (P_NOBUY, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_MATERIAL, MAT_MISC);
  call_out("weg", 40);
}

string extra_look()
{
   if (environment()->QueryProp(P_GENDER)==2)
      return bs ("Ihr Gesicht ist voll Puder und sieht so richtig "
                  +"babyweich aus. Irgendwie suess.\n");
   else
     return bs ("Sein Gesicht ist voll Puder und sieht so richtig "
                  +"babyweich aus. Irgendwie suess.\n");
  
}

weg()
{
 ME->remove();
}
 
