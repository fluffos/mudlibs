inherit "std/thing";

#include <language.h>
#include <properties.h>

create()
{
  if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein kleiner Schluessel");
  SetProp(P_LONG,
    "Ein kleiner Schluessel. Was der wohl aufsperrt?");

  SetProp(P_NOGET,0);
  SetProp(P_NODROP,0);
  SetProp(P_VALUE, 300);
  SetProp(P_WEIGHT,15);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Schluessel");
 
  AddId("schluessel");

  seteuid(getuid());

}

string QueryDoorKey()
{
  return(
"/d/unterwelt/jed/room/nekrohoehle_2:/d/unterwelt/jed/room/nekrohoehle_3" );
}
