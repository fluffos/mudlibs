inherit "p/std/dragons/dragon";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h> 
#include <defines.h>
#include <moredef.h>

create()
{ int zufall;
  object ob;
  if (!is_clone(this_object())) return;
  ::create();    
  create_default_dragon(4,5,0,15);
  SetProp(P_SHORT, "Urastrunamus der gefangene Schlafdrache");
  SetProp(P_NAME, "Urastrunamus");
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS)+
      ([DT_WATER: 0.3]));
  AddId("urastrunamus");
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME_ADJ, 0);
  SetProp(P_LONG, 
      "Qexyypbmizox, der Blitzschleuderer, ist ein gewaltiger "
      "blauer Drache mit gefaehrlichen Faengen und Zaehnen so gross "
      "wie Schwerter. Um seinen Koerper zucken staendig kleine Blitze. "
      "Er mustert Dich mit seinen handtellergrossen Augen, die Dich "
      "gnadenlos anstarren und bis in den Innerstes zu blicken scheinen. ");
  SetProp(P_SPELLRATE, 30);
  
 
}

