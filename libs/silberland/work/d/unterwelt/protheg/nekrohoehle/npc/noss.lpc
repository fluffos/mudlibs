inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>


void create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Noss der Foltermeister");
  SetProp(P_LONG,
    "Noss ist hier der gefaehrliche Foltermeister. Er ist eher "
    "gross mit einem langen Bart. Er sieht sehr kraeftig aus, er "
    "muss ja auch taeglich viele Menschen foltern. Mit ihm willst "
    "Du aber bestimmt keinen Streit.");
  SetProp(P_NAME, "Noss");
  SetProp(P_GENDER, MALE);
  AddId(({"noss", "foltermeister","meister"}));
  set_living_name("noss");

  create_default_npc(15);

  SetProp(P_ATTRIBUTES, ([ A_DEX:20, A_STR:20, A_INT:20, A_CON:20 ]) );

  SetProp(P_HANDS, ({" mit kraefitgen Folterhaenden",400,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 1000);
  SetProp(P_BODY, 200);
  SetProp(P_XP, 1000000);
  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 350);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,-4);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft raus");
  SetProp(P_MMSGIN, "stapft herein");
  SetProp(P_MMSGOUT, "verschwinden ploetzlich");

  SetProp(P_DIE_MSG,  " wird keinen mehr foltern.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Noss");

  AddInfo(DEFAULT_INFO, "tritt Dich.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Noss sagt: Das will ich nicht, geh jetzt weg oder ich foltere Dich zu tode!\n" }) );

  SetProp(P_SPELLRATE,65);
  AddSpell(1,1100,
    "Noss peitscht Dich kraeftig aus.\n",
    "Noss peitscht @WEM kraeftig aus.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,800,
    "Noss wirft den Kopf eines Paladins nach Dir.\n",
    "Noss wirft den Kopf eines Paladins nach @WEM.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]) );

/*  SUID;
    CLONEME(""); */
}