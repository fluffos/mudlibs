inherit "/p/std/dragons/dragon";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <inpc.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <wizlevels.h>

#define JEDLOG "/d/unterwelt/jed/log/"

void ruestung_weg(object enemy, int damage, mixed dam_type);
int verschluckt(object enemy, int damage, mixed dam_type);
void maul(object enemy, int damage, mixed dam_type);


create()
      {
      if (!is_clone(this_object())) return;
       ::create();
       
      create_default_dragon(1,10,1,20);
      
       SetProp(P_SHORT,"Urastrunamus der alte goldene Drache");
       SetProp(P_NAME, "Urastrunamus");
       SetProp(P_ARTICLE, 0);
       SetProp(P_NAME_ADJ, 0);
       SetProp(P_LONG, BS(
                "Vor Dir liegt ein alter goldener Drache. Er wird "
                 "hier von den Nekromanten festgehalten. Er schlaeft "
                 "den ganzen Tag und wartet darauf seinen Sohn nach "
                 "hundertausend Jahren wiederzusehen. Hilf ihm oder "
                 "befreie ihn von seinem Leid."));                  
       AddId(({"urastrunamus"}) );
       
       SetProp(P_SIZE, 15000);


	AddSpell( 2,1,"Der Drache verschluckt Dich.\n",
		"Der Drache verschluckt @WEN.\n",
		DT_MAGIC, "verschluckt" );

	AddSpell(2,1,"Der Drache zerstoert Deine Ruestung!\n",
		"Der Drache zerstoert die Ruestung von @WEM!\n",
		DT_MAGIC, "ruestung_weg");


	AddSpell(10,500,"Der Drache streift Dich mit seinem Odem!\n",
		"Der Drache streift @WEN mit seinem Odem!\n",
		DT_FIRE, ([SP_SHOW_DAMAGE:1]) );
	AddSpell(10,600,"Der Drache trifft Dich mit seinen Krallen.\n",
		"Der Drache trifft @WEN mit seinen Krallen.\n",
		DT_SLASH, ([SP_SHOW_DAMAGE:1]) );
	

}


void die(int poisondeath)
{
  write_file(JEDLOG "drache",
    ctime()+": "+CAP(getuid(TP))+" killt Urastrunamus.\n");
  if( !IS_LEARNER(TP) )
    domainshout(CAP_TPN+
         " hat Urastrunamus bezwungen.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(JEDLOG "drache",
    ctime()+": Urastrunamus hat gerade "+CAP(getuid(player))+
    " umgebracht.\n");
}


