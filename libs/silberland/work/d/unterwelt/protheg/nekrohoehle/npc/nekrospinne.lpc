inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>


void create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine steinerne Nekromantenspinne");
  SetProp(P_LONG,
    "Eine grosse steinerne Nekromantenspinne steht vor Dir. Sie "
    "besteht aus reinem Stein und sieht sehr gefaehrlich aus. Sie "
    "hat acht lange Beine mit denen sie Dich vernichten kann.");
  SetProp(P_NAME, "Nekromantenspinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({"spinne", "\ja", "nekromantenspinne","steinspinne","spinn"}));
  set_living_name("nekromantenspinne");
  SetProp(P_INFO, "Du Nekromantenspinne ist vollkommen aus Stein." );

  create_default_npc(20);

  SetProp(P_ATTRIBUTES, ([ A_DEX:25, A_STR:25, A_INT:25, A_CON:25 ]) );

  SetProp(P_HANDS, ({" mit acht Steinbeinen",400,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 1000);
  SetProp(P_BODY, 200);
  SetProp(P_XP, 3000000);
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 350);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL,-4);
  SetProp(P_AGGRESSIVE, 0.75);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft raus");
  SetProp(P_MMSGIN, "stampft herein");
  SetProp(P_MMSGOUT, "verschwinden ploetzlich");

  SetProp(P_DIE_MSG,  " wird keinen mehr toeten.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Die steinerne Nekromantenspinne");

  AddInfo(DEFAULT_INFO, "faucht Dich an.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Nekromantenspinne wird wuetend!\n" }) );

  SetProp(P_SPELLRATE,65);
  AddSpell(1,1100,
    "Die Nekromantenspinne zerdrueckt Dich beinahe.\n",
    "Die Nekromantenspinne zerdrueckt @WEM beinahe.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,800,
    "Die Nekromantenspinne beisst Dir beinahe den Kopf ab.\n",
    "Die Nekromantenspinne beisst @WEM beinache den Kopf ab.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]) );
  AddSpell(2,500,
    "Die Nekromantenspinne springt Dich an.\n",
    "Die Nekromantenspinne springt @WEM an.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,300,
    "Die Nekromantenspinne sticht Dir in die Augen.\n",
    "Die Nekromantenspinne stich @WEM in die Augen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,300,
    "Die Nekromantenspinne setzt Dir hart zu.\n",
    "Die Nekromantenspinne setzt @WEN hart zu.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));


/*  SUID;
    CLONEME(""); */
}

