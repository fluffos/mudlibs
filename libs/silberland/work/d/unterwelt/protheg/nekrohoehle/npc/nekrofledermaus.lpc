inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>


void create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine steinerne Nekromantenfledermaus");
  SetProp(P_LONG,
    "Eine grosse steinerne Nekromantenfledermaus steht vor Dir. Sie "
    "besteht aus reinem Stein und sieht sehr gefaehrlich aus. Sie "
    "hat zwei riesige Fluegel mit denen sie Dich vernichten kann.");
  SetProp(P_NAME, "Nekromantenfledermaus");
  SetProp(P_GENDER, FEMALE);
  AddId(({"steinmaus", "\ja", "nekromantenfledermaus","fledermaus","maus"}));
  set_living_name("nekromantenfledermaus");
  SetProp(P_INFO, "Du Nekromantenfledermaus ist vollkommen aus Stein." );

  create_default_npc(20);

  SetProp(P_ATTRIBUTES, ([ A_DEX:25, A_STR:25, A_INT:25, A_CON:25 ]) );

  SetProp(P_HANDS, ({" mit zwei maechtigen Fluegeln",400,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 1000);
  SetProp(P_BODY, 200);
  SetProp(P_XP, 3000000);
  SetProp(P_RACE, "Fledermaus");
  SetProp(P_SIZE, 250);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,-4);
  SetProp(P_AGGRESSIVE, 0.75);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt raus");
  SetProp(P_MMSGIN, "fliegt herein");
  SetProp(P_MMSGOUT, "verschwinden ploetzlich");

  SetProp(P_DIE_MSG,  " wird keinen mehr toeten.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Die steinerne Nekromantenfledermaus");

  AddInfo(DEFAULT_INFO, "faucht Dich an.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Nekromantenfledermaus wird wuetend!\n" }) );

  SetProp(P_SPELLRATE,65);
  AddSpell(2,500,
    "Die Nekromantenfledermaus schlaegt Dich mit ihren Fluegeln.\n",
    "Die Nekromantenfledermaus schlaegt @WEM mit ihren Fluegeln.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,300,
    "Die Nekromantenfledermaus schleudert Dich gegen die Wand.\n",
    "Die Nekromantenfledermaus schleudert @WEM gegen die Wand.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,300,
    "Die Nekromantenfledermaus beisst Dich.\n",
    "Die Nekromantenfledermaus beisst @WEN.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

}

