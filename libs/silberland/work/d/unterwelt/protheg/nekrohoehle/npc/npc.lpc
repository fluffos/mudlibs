
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>


void create() 
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Gehilfe");
  SetProp(P_LONG,
    "Vor Dir steht Noss's kleiner Gehilfe. Er ist ein mieser kleiner "
    "Zwerg und stinkt fuerchterlich. Neben dem starken Geruch kannst "
    "Du seine grossen Muskeln bewundern die er durch harte Arbeit "
    "bekommen hat. Er tut hier nur wenig, eigentlich nur Peitschen "
    "herumtragen und Leichen aufraeumen, aber unterschaetz ihn deshalb "
    "nicht.");
  SetProp(P_NAME, "Gehilfe");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"gehilfe", "folterer"}));
  set_living_name("Gehilfe");
  
  create_default_npc(7);
  SetProp(P_HANDS, ({" mit kraeftigen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_MAX_HP, 300 );
  SetProp(P_BODY, 90 );
  
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE,100);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " legt sich hin und steht nicht mehr auf.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "<name> will Deine Sachen nicht haben.\n" }) );

  SetProp(P_SPELLRATE,50);
  AddSpell(1,1100,
    "Der Gehilfe zerfetzt Deine Eingeweide.\n",
    "Der Gehilfe zerfetzt @WEM Eingeweide.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Gehilf sagt: Ma, imma muas i oabeitn!.\n"}) );
  SetAttackChats(10, ({
    "Der Gehilfe Schreit: Na Dir hau i di Fressn ein.\n"}) );

}




