inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Folterkammer." );
  SetProp( P_INT_LONG,
       "Du stehst in dem Raum wo die Gefangenen gehalten "
       "werden, bevor sie bis zum schrecklichen Tod, von "
       "den boesen Nekromantenfolterern gefoltert werden. "
       "Du siehst drei riesige Kaefige in denen hunderte "
       "von Spielern eingesperrt sind. Du siehst Paladine, "
       "Druiden, Berserker, Zechpreller und sogar einige "
       "Nekromanten die der Gilde nicht treu waren und nun "
       "auch zum Tode verurteilt sind. Pass hier lieber auf "
       "sonst kannst Du dich bald mit den Gefangenen befreunden."
  );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "raum" }),
       "In diesem Raum werden die Gefangenen gehalten, bis sie "
       "dann zum gefoltert werden dran sind."
  );
  AddDetail( ({ "gefangenen", "gefangene" }),
       "Sie schauen sehr aengstlich drein, da sie wissen, das "
       "sie bald sterben muessen."
  );
  AddDetail( ({ "boden", }),
       "Der Boden hier besteht aus Stein, da es eine Hoehle ist."
  );
  AddDetail( ({ "stein" }),
       "Er wurde sehr gut bearbeitet, um bei den Gefangenen einen "
       "guten Eindruck zu machen?"
  );
  AddDetail( ({ "spieler", "spielern" }),
       "Spieler werden hier am liebsten gefoltert."
  );
  AddDetail( ({ "hoehle" }),
       "Sie ist wunderschoen."
  );
  AddDetail( ({ "eindruck" }),
       "Ich denke das war nicht der Sinn des bearbeitens, aber "
       "genau wissen dass nur die Nekromanten."
  );
  AddDetail( ({ "sinn" }),
       "Den genauen, kennen nur die Nekromanten."
  );
  AddDetail( ({ "wand", "decke", "waende" }),
       "Sie besteht aus Stein, da es eine Hoehle ist."
  );
  AddDetail( ({ "tod", "ende", "tode" }),
       "Bis zum bitteren Ende werden die Gefangenen gefoltert."
  );
  AddDetail( ({ "nekromanten", "folterer", "nekromantenfolterer", "nekromantenfolterern" }),
       "Sie sind die, die alle Gefangenen frueher oder spaeter "
       "zu tode foltern werden."
  );
  AddDetail( ({ "kaefige" }),
       "In diesen, grossen, stinkenden Kaefigen, werden viele "
       "Gefangene gehalten bis sie dran sind von den Folterern "
       "zu tode gefoltert zu werden."
  );
  AddDetail( ({ "druiden", "berserker", "zechpreller", "paladine", "nekromanten", "paladiner" }),
       "Du siehst dass die Gefangenen verschiedenen Gilden angehoert "
       "haben und dass hier Niemand verschont wird."
  );
  AddDetail( ({ "gilde", "gilden" }),
       "Derzeit gibt es die Druiden, die Berserker, die Zechpreller, die "               "Paladiner und die Nekromanten."
  );
  AddDetail( ({ "geruch" }),
       "Riech doch einfach mal."
  );
  AddDetail( ({ "loch" }),
       "Es gehoert wohl einer Maus die in dem Loch "
       "Suessigkeiten versteckt. Leider ist das Loch "
       "viel zu klein um reinzugreifen."
  );
  AddDetail( ({ "maus" }),
       "Derzeit ist sie leider nicht da."
  );
  AddDetail( ({ "suessigkeiten" }),
       "Bonbons, Schokolade..."
  );
  AddDetail( ({ "bonbons", "schokolade" }),
       "Das wuerde Dir jetzt gut schmecken."
  );
  AddDetail( ({ "niemand" }),
       "Gar keiner."
  );
  AddDetail( ({ "gilden" }),
       "Mach einfach mal <hilfe gilden>."
  );
  AddSmell( DEFAULT_SMELL,
       "Du riechst nur die stinkenden Gefangenen."
  );
  AddSmell( "gefangenen",
       "Als Du den Geruch der Gefangenen riechst, bemerkst Du "
       "einen schwachen, aber dennoch riechbaren Nebengeruch."
  );
  AddSmell( "nebengeruch",
       "Es riecht nach Zucker."
  );
  AddSmell( "zucker",
       "Du folgst dem Geruch und findest ein kleines Loch "
       "ganz knapp vor dem Boden, dass Du vorher nicht "
       "bemerkt hast."
  );
  AddSound( DEFAULT_SOUND,
       "Du hoerst nur wenige Hilferufe der Gefangenen."
  );
  AddSound( "hilferufe",
       "HHHIIIIIIIIIIIIIIIIIIIILLFEEE.......!!!!" 
  );
  AddExit("suedosten", "./folterkammer_1.lpc");
  AddExit("sueden", "./folterkammer_4.lpc");
}
