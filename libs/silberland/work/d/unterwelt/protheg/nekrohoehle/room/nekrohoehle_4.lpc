inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <room.h>
#include <moredef.h>
#include <defines.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Nekromantenhoehle." );
  SetProp( P_INT_LONG,
        "Man kann diesen Raum nicht wirklich einen Raum nennen "
        "da er nur ganz klein ist und in der Form einer Kugel. "
        "Die Waende sind ganz glatt, Du rutscht fast aus beim "
        "stehen. Ob hier ein Wesen lebt?"
        );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({"kugel","waende","raum","form"}),
          "Der Raum hat die Form einer Kugel. Die Waende der Kugel "
          "sind so glatt dass Du beim stehen fast ausrutscht."
  );
  AddDetail( ({"wesen"}),
          "Villeicht wohnt hier eines also Vorsticht!"
  );
  AddDetail( ({"vorsicht"}),
          "Vorsicht, sonst gehst Du nocht drauf!"
  );
  AddExit("unten", "./nekrohoehle_3.lpc");
  AddItem("/d/unterwelt/jed/npc/nekrofledermaus", REFRESH_DESTRUCT);
}

