inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Ein kleiner Kaefig" );
  SetProp( P_INT_LONG,
    "Du stehst in einem kleiner Kaefig das eher wie ein Gefaengnis "
    "aussieht. Es ist Nichts vorhanden, nur vier Waende, ein Dach und "
    "ein Boden. Du weisst nicht warum aber irgendwie willst Du trotzdem "
    "weg hier.");

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 0 );
  
  AddDetail( ({ "kaefig", "gefaengnis"  }),
    "Ganz fad hier. Nichts ist vorhanden.");
  AddDetail( ({ "boden", "wand", "waende", "decke" }), 
    "Nichts ist darauf zu erkennen. Geh lieber, sonst stirbst "
    "Du noch vor langeweile.");
  AddRoomMessage( 
    ({"Du willst irgendwie weg hier ..."}),30,"func");

 

  AddItem( "/d/unterwelt/jed/npc/d.lpc" , REFRESH_DESTRUCT);

  AddExit( "westen", "./nekrohoehle_3" );
}

