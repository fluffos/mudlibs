inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Folterkammer." );
  SetProp( P_INT_LONG,
       "Du befindest Dich hier in eimen Warteraum. Hier "
       "muessen die Gefangenen warten, bis sie an der "
       "Reihe sind, bis zum Tode gefoltert zu werden. "
       "Es herrscht zu deinem Erstaunen eine recht gute "
       "Stimmung, da die Gefangenen bald von ihrem Leid "
       "befreit werden. Die Gefangenen bilden eine kleine "
       "Reihe und in kurzen Abstaenden wird der Erste in "
       "der Reihe nach Westen geschickt. Pass bloss auf "
       "dass Du dich nicht unabsichtlich in die Reihe "
       "stellst, da das fuerchterliche Konsequenzen haben "
       "koennte."
  );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "warteraum", "raum" }),
       "Hier warten die Gefangenen darauf endlich zu "
       "Tode gefoltert zu werden."
  );
  AddDetail( ({ "tode", "tod" }),
       "Es ist fuerchterlich, dass so viele Spieler "
       "sterben muessen."
  );
  AddDetail( ({ "spieler" }),
       "Es sind so viele, es lohnt sich nicht einmal "
       "alle zu zaehlen."
  );
  AddDetail( ({ "gefangenen" }),
       "Sie warten hier auf ihre Hinrichtung."
  );
  AddDetail( ({ "hinrichtung" }),
       "Sie werden bis zum Tode gefoltert."
  );
  AddDetail( ({ "reihe" }),
       "Die Gefangenen bilden eine kleine Reihe. "
       "Der Erste in der Reihe wird nach einiger Zeit "
       "nach Westen geschickt."
  );
  AddDetail( ({ "wand", "decke", "waende" }),
       "Sie ist glaenzend und voellig sauber. Du kannst "
       "es Dir zwar nicht erklaeren wie sie so sauber sein "
       "kann, wenn diese ganzen schmutzigen Gefangenen "
       "hier herumstehen."
  );
  AddDetail( ({ "boden" }),
       "Er ist glaenzend und sauber."
  );
  AddDetail( ({ "erste" }),
       "Der Erste halt, der der ganz Vorne ist."
  );
  AddDetail( ({ "vorne" }),
       "Am Anfang der Reihe halt."
  );
  AddDetail( ({ "anfang" }),
       "Wenn Du so daran interresiert bist, stell Dich doch hin."
  );
  AddDetail( ({ "zeit" }),
       "In kurzen Abstaenden."
  );
  AddDetail( ({ "abstaende", "abstaenden" }),
       "In ca. 5 min. Abstaenden. Die gefangenen halten wohl nich "
       "sehr viel aus."
  );
  AddDetail( ({ "westen" }),
       "Geh einfach mal nach Westen."
  );
  AddDetail( ({ "erstaunen" }),
       "Zu Deinem Erstaunen herrscht hier eine gute Stimmung."
  );
  AddDetail( ({ "stimmung" }),
       "Sie ist sehr gut, muss wohl daran liegen dass "
       "die Gefangenen bald von ihrem Leid befreit werden."
  );
  AddDetail( ({ "leid" }),
       "Naja gefangen sein, warten muessen. Da ist anscheinend "
       "sterben besser."
  );
  AddDetail( ({ "konsequenzen" }),
       "Villeicht foltern Dich ein paar Leute und schneiden Dir "
       "danach den Kopf ab."
  );
  AddDetail( ({ "leute" }),
       "Irgendwer halt, muss Du umbedingt wissen wer es ist?"
  );
  AddDetail( ({ "kopf" }),
       "Pass gut auf ihn auf."
  );
  AddSmell( DEFAULT_SMELL,
       "Du riechst die stinkenden Gefangenen."
  );
  AddSmell( "gefangenen",
       "Sie stinken fuerchterlich."
  );
  AddSound( DEFAULT_SOUND,
       "Du hoerst die Gefangenen sprechen."
  );
  AddSound( "gefangenen",
       "Sie sprechen zwar, aber es ist eher nur "
       "gemurmel dass Du nicht verstehen kannst, also "
       "kuemmerst Du dich nicht darum."
  );
  AddExit("osten", "./folterkammer_1.lpc");
  AddExit("westen", "./folterkammer_5.lpc");
  AddExit("norden", "./folterkammer_2.lpc");
}



