inherit "std/room";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Folterkammer." );
  SetProp( P_INT_LONG,
       "Dieser Raum dient rein zum auspeitschen von Spielern, "
       "Magiern und Npc's. Du siehst Ketten an den Waenden "
       "die dazu dienen, den der ausgepeitst wird, festzuhalten. "
       "Grosse Peitschen haengen an den waenden die natuerlich "
       "einmal verwendet worden sind. An der Spitze einer der "
       "Peitschen sind kleine Klingen angebracht um den gefolterten "
       "richtig die Haut aufzureissen. Derzeit sind nur zwei "
       "Leute da, die gefoltert werden."
  );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "raum" }),
       "In diesem Raum wird nur gepeitscht."
  );
  AddDetail( ({ "spieler", "spielern" }),
       "Irgendwelche Spieler die gescripter haben, oder die "
       "Spieler mit denen der Tod probleme hatte werden hier "
       "ausgepeitscht."
  );
  AddDetail( ({ "tod" }),
       "Der Tod. Er ist eigentlich an ganz netter Kerl."
  );
  AddDetail( ({ "kerl" }),
       "Nicht Du, der Tod."
  );
  AddDetail( ({ "magiern", "magier" }),
       "Die Magier die das Magiersein nur ausnuetzen werden "
       "hier ausgepeitscht."
  );
  AddDetail( ({ "magiersein" }),
       "Nuetze es ja nicht aus, falls Du Magier bist."
  );
  AddDetail( ({ "npc's", "npcs", "npc" }),
       "Sie Npc's die zu viele Spieler umbringen, werden hier "
       "natuerlich auch ausgepeitscht."
  );
  AddDetail( ({ "ketten" }),
       "An den Waenden haengen Ketten, um den der gerade gefoltert "
       "wird festzuhalten."
  );
  AddDetail( ({ "peitschen" }),
       "Es haengen einige an der Wand. Eine faellt Dir aber besonders "
       "auf."
  );
  AddDetail( ({ "peitsche" }),
       "An ihrer Spitze sind kleine Klingen angebracht, um "
       "das auspeitschen noch schmerzvoller zu machen."
  );
  AddDetail( ({ "spitze" }),
       "An ihrer Spitze sind kleine Klingen angebracht."
  );
  AddDetail( ({ "klingen" }),
       "Sie sind sehr scharf, so dass man damit Jemanden "
       "richtig in die Haut schneidet. Komisch, die Klingen "
       "zeigen irgendwie in eine Richtung."
  );
  AddDetail( ({ "jemand", "jemanden" }),
       "Jemand wird hier immer ausgepeitscht."
  );
  AddDetail( ({ "haut" }),
       "Mit den Klingen schneidet man schoen tief in die "
       "Haut hinein."
  );
  AddDetail( ({ "richtung" }),
       "Sie zeigt auf ein Loch dass Dir vorher, komischer weise, nicht "  
       "aufgefallen ist. Ob dass wohl Etwas zu "
       "bedeuten hat?"
  );
  AddDetail( ({ "etwas" }),
       "Ob dass wohl Etwas zu bedeuten hat?"
  );
  AddDetail( ({ "leute" }),
       "Derzeit sind nur zwei da. Ein Paladiner und ein Paladiner."
  );
  AddDetail( ({ "paladiner", "paladin", "paladine" }),
       "Paladiner sind hier Stammgaeste, da ihr Align immer "
       "so gut ist. Du weisst nicht wieso aber es kommt Dir in den "
       "Sinn einen der Paladin hier auszupeitschen."
  );
  AddDetail( ({ "holz" }),
       "Du siehst fast nichts mehr vom Holz, sondern nur noch Blut."
  );
  AddDetail( ({ "align" }),
       "Es geht von satanisch bis heilig."
  );
  AddDetail( ({ "stammgaeste" }),
       "Das sind sie, die Paladiner."
  );
  AddDetail( ({ "nordwesten" }),
       "Als Du nach Nordwesten schaust, erkennst Du "
       "ein kleines Loch."
  );
  AddDetail( ({ "loch" }),
       "Es ist ziemlich gross. Du koenntest ja versuchen durchzuklettern."
  );
  AddDetail( ({ "boden" }),
       "Der Boden besteht aus Holz, aber Du kannst fast nur "
       "noch Blut sehen."
  );
  AddDetail( ({ "blut" }),
       "Es ist ueberall."
  );
  AddDetail( ({ "waende", "wand" }),
       "Ketten und Peitschen haengen an ihnen."
  );
  AddDetail( ({ "decke" }),
       "Sogar die Decken sind mit Blut beschmiert."
  );
  AddSound( DEFAULT_SOUND,
       "Du hoerst nur das Knallen der Peitschen."
  );
  AddSound( "knallen",
       "KNAAAAAAAAAAAAAAALLLLL......"
  );
  AddSmell( DEFAULT_SMELL,
       "Du kannst nur das Blut riechen."
  );
  AddSmell( "blut",
       "Pfui, riecht das schrecklich."
  );
  AddExit("sueden", "./folterkammer_5.lpc");
  AddCmd(({"klettere","kletter"}),"kfunc");
}

int peitschung(string str)
{
  object paladin;
  notify_fail("Wen willst Du auspeitschen?\n");
  if (str!="paladin aus") return 0;
  write(
       "Du nimmt einer der Peitschen, holst weit aus und ...\n"
       "KNAAAAAAAALLLLLLLL.......\n"
       "Du peitscht dem Paladiner so stark auf den Ruecken dass "
       "er zu bluten beginnt. Du lachst auf, denn es macht Dir "
       "richtig Spass.\n");
       say(
       TP->Name()+
       " peitscht einen Paladiner gehoerig aus.\n");
       return 1;
}

kfunc (str)
{
 object me; 
 notify_fail("Wo willst Du durchklettern?\n");
 if (str=="in loch")
  {
   write("Du nimmst deinen ganzen Mut zusammen und kletterst durch das Loch.\n");
   this_player()->move("/d/unterwelt/jed/room/nekrohoehle_1.lpc",M_GO,
   "im Dickicht","verschwindet","kommt an"); 
   return 1;
  }
}
