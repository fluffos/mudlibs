inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Folterkammer." );
  SetProp( P_INT_LONG,
       "Du befindest Dich hier in der Folterkammer "
       "die von den boesen Nekromanten erschaffen wurde. Hier " 
       "werden alle Rassen "
       "von jeder Gilden gefoltert. Du erkennst sterbende "
       "Paladiner die auf der Streckbank liegen. "
       "Nicht mal Dusty koennte Dich aus so einer "
       "schrecklichen Lage herausholen, also lauf schnell "
       "weg."
  );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
 
  AddDetail( ({ "boden", }),
       "Der Boden hier besteht aus Stein, da es eine Hoehle ist."
  );
  AddDetail( ({ "stein" }),
       "Er wurde sehr gut bearbeitet, um bei den Gefangenen einen "
       "guten Eindruck zu machen?"
  );
  AddDetail( ({ "hoehle" }),
       "Sie ist wunderschoen."
  );
  AddDetail( ({ "eindruck" }),
       "Ich denke das war nicht der Sinn des bearbeitens, aber "
       "genau wissen dass nur die Nekromanten."
  );
  AddDetail( ({ "sinn" }),
       "Den genauen, kennen nur die Nekromanten."
  );
  AddDetail( ({ "wand", "decke", "waende" }),
       "Sie besteht aus Stein, da es eine Hoehle ist."
  );
  AddDetail( ({ "folterkammer" }),
       "Hier wird jeder, aber am meisten Paladine "
       "gefoltert. Mit den schrecklichsten und "
       "graueneregensten Methoden werden hier "
       "alle Spieler getoetet."
  );
  AddDetail( ({ "paladine","paladiner" }),
       "Die Paladine werden am meisten und am "
       "liebsten hier gefoltert."
  );
  AddDetail( ({ "spieler" }),
       "Willst du etwa gefoltert werden? Wenn ja, "
       "mails an Jed."
  );
  AddDetail( ({ "jed" }),
       "Wenn du willst, foltert er Dich persoehnlich."
  );
  AddDetail( ({ "methoden" }),
       "Also das beruehmteste ist die Streckbank. "
       "Dann gibt es noch die Wachsfolter, das "
       "Auspeitschen, manchen werden einfach Koerperteile "
       "abgschnitten und an die Kannibalen verfuettert."
  );
  AddDetail( ({ "streckbank" }),
       "Du wirst solang durch Gewichte gestreckt, bis "
       "dein Koerper zerreist."
  );
  AddDetail( ({ "gewichte" }),
       "Am Anfang nur leichte und dann immer schwerere bis "
       "es Dich zerreisst."
  );
  AddDetail( ({ "koerper" }),
       "Der wird hier zerschnitten und an Kannibalen "
       "verfuettert."
  );
  AddDetail( ({ "kannibalen" }),
       "Du willst sie nicht treffen, glaubs mir. "
  );
  AddDetail( ({ "wachsfolter" }),
       "Bei dieser Folter lassen sie heisses Wachs "
       "auf deine Brust bzw. Busen laufen."
  );
  AddDetail( ({ "wachs" }),
       "Das Wachs ist kochend heiss und brennt furchtbar."
  );
  AddDetail( ({ "busen", "brust" }),
       "Welches der beiden Du hast, muss du selber wissen."
  );
  AddDetail( ({ "folter" }),
       "Es gibts verschiedene Methoden."
  );
  AddDetail( ({ "auspeitschen" }),
       "Bei dieser Folter, wird man ausgepeitscht bis "
       "man so stark blutet das man stirbt. Das "
       "Peitschen ist sehr unenagenehm und schrecklich."
  );
  AddDetail( ({ "peitschen" }),
       "Ploetzlich wendet sich einer der Folterer Dir zu "
       "und peitscht dir hart auf den Ruecken. Du schreist "
       "lau auf...AAAAAAAARRRRGGGGHHHHHHHHHHH!!!!!!"
  );
  AddDetail( ({ "ruecken" }),
       "Nun blutet er."
  );
  AddDetail( ({ "koerperteil","koerperteile" }),
       "Jeder einzelne wird hier zerstoert und vernichtet "
       "und dann an die schrecklichen Kannibalen verfuettert."
  );
  AddDetail( ({ "nekromanten" }),
       "Sie sind das grauenvollste im ganzen Silberland und "
       "sie verbreiten das Boese."
  );
  AddDetail( ({ "silberland" }),
       "Das ist das Mud in dem du gerade spielst."
  );
  AddDetail( ({ "mud" }),
       "Also, mails Jed und er erklaerts dir ganz genau "
       "in einer Mail."
  );
  AddDetail( ({ "mail" }),
       "Herst, Du machst es mir schwierig."
  );
  AddDetail( ({ "boese" }),
       "Das Boese wird immer siegen. Die Nekromanten "
       "representieren das Boese."
  );
  AddDetail( ({ "gilden", "rassen" }),
       "Egal welche, alles wird hier gefoltert."
  );
  AddDetail( ({ "lage" }),
       "Sie ist, wenn Du dich hier nicht auskennst, "
       "nicht sehr gut."
  );
  AddDetail( ({ "dusty" }),
       "Ich sagte doch, auch Sie kann dir hier nicht mehr "
       "raushelfen...UTX villeicht?"
  );
  AddDetail( ({ "utx" }),
       "Sie ist das liebste Wesen im ganzen Silberland."
  );
  AddDetail( ({ "gefangenen" }),
       "Die werden hier gefoltert."
  );
  AddDetail( ({ "blut" }),
       "Es fliesst hier taeglich, hoffentlich nich deines."
  );
  AddSound( DEFAULT_SOUND,
       "Du hoerst nichts als Schreie von gefolterten "
       "Gefangenen."
  );
  AddSound( "schreie",
       "Es sind schmerzensschreie der Gefangenen."
  );
  AddSound( "gefangenen",
       "Sie schreien fuerchterlich."
  );
  AddSmell( DEFAULT_SMELL,
       "Du riechst fast nur Blut."
  );
  AddSmell( "blut",
       "Es ist das Blut der sterbenden Gefangenen."
  );
  AddSmell( "gefangenen",
       "Eigentlich kannst Du nur ihr Blut riechen."
  );
  AddExit("norden", "./folterkammer_3.lpc");
  AddExit("suedwesten", "./folterkammer_6.lpc");
  AddExit("osten", "./folterkammer_4.lpc");
  AddItem("/d/unterwelt/jed/npc/noss", REFRESH_DESTRUCT);
}