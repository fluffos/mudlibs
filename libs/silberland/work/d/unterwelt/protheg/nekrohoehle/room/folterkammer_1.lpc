inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Folterkammer." );
  SetProp( P_INT_LONG,
       "Du stehst am Anfang der Folterkammer und kannst "
       "trotzdem schon das Blut der sterbenden Spieler "
       "riechen. Es ist aber sonst eine wunderbare Hoehle "
       "die aus dem harten Stein herausgeschlagen wurde. "
       "Es hat wohl Jahre, wenn nicht laenger gedauert "
       "diese Prachthoehle zu gestalten. Im Westen geht "
       "die Kammer weiter, aber wenn Dir dein Leben lieb ist "
       "kehrst Du besser um."
  );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "boden", }),
       "Der Boden hier besteht aus Stein, da es eine Hoehle ist."
  );
  AddDetail( ({ "stein" }),
       "Er wurde sehr gut bearbeitet, um bei den Gefangenen einen "
       "guten Eindruck zu machen?"
  );
  AddDetail( ({ "hoehle" }),
       "Sie ist wunderschoen."
  );
  AddDetail( ({ "eindruck" }),
       "Ich denke das war nicht der Sinn des bearbeitens, aber "
       "genau wissen dass nur die Nekromanten."
  );
  AddDetail( ({ "sinn" }),
       "Den genauen, kennen nur die Nekromanten."
  );
  AddDetail( ({ "wand", "decke", "waende" }),
       "Sie besteht aus Stein, da es eine Hoehle ist."
  );
  AddDetail( ({ "anfang" }),
       "Dies ist erst der Anfang der schrecklichen Folterkammer. "
       "Wenn Dir dein Leben lieb ist, kehrst Du schnell wieder "
       "um."
  );
  AddDetail( ({ "folterkammer", "kammer" }),
       "In dieser Kammer wird alles Lebende bis zum schrecklichen "
       "Tod gefoltert."
  );
  AddDetail( ({ "lebende" }),
       "Einfach alles, nichts wird verschont, gestehe denn freigelassen."
  );
  AddDetail( ({ "tod" }),
       "Bis zum schrecklichen Tod, wird hier alles gefoltert und "
       "verpruegelt."
  );
  AddDetail( ({ "leben" }),
       "Wenn Dir deines lieb ist, haust du von hier schnell ab."
  );
  AddDetail( ({ "blut" }),
       "Du kannst bereits das Blut, der Spieler, von hier aus riechen. "
       "Wenn du weitergehst, koennte es Deines sein!"
  );
  AddDetail( ({ "spieler" }),
       "Spieler wie Du und ich, keiner wird hier verschont."
  );
  AddDetail( ({ "hoehle", "prachthoehle" }),
       "Die Hoehle ist wunderschoen. Sie wurde mit genauigkeit "
       "aus dem Stein herausgemeiselt. Es muss wohl Jahre, wenn "
       "nicht laenger, gedauert haben diese Hoehle zu errichten."
  );
  AddDetail( ({ "stein" }),
       "Es ist ein sehr dunkler Stein, Du kennst ihn leider nicht."
  );
  AddDetail( ({ "jahre" }),
       "Das ist eine ganz schoen lange Zeit."
  );
  AddDetail( ({ "zeit" }),
       "Zeit kann man doch nicht untersuchen, oder doch?"
  );
  AddDetail( ({ "westen" }),
       "Nach Westen geht es in die Folterkammer hinein, aber "
       "sei vorsichtig."
  );
  AddSound( DEFAULT_SOUND,
       "Du kannst nur ein paar leise Schreie, von gefolterten "
       "Spielern hoehren."
  );
  AddSound( "schreie",
       "Es sind die Schreie von sterbenden Spielern."
  );
  AddSmell( DEFAULT_SMELL,
       "Du kannst sogar von hier, das Blut der Spieler "
       "riechen."
  );
  AddSmell( "blut",
       "PFUUUUUUUUIIII, Blut stinkt."
  );
  AddExit("nordwesten", "./folterkammer_2.lpc");
  AddExit("westen", "./folterkammer_4.lpc");
} 