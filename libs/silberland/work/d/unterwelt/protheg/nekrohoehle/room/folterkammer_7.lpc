inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moredef.h>
#include <defines.h>
#include <moving.h>

int counter;

create()
{
  object ob;
  ::create();

  SetProp( P_INT_SHORT, "In der Folterkammer." );
  SetProp( P_INT_LONG,
        "Du befindest Dich hier im Leichenraum der Folterkammer. "
        "Das erste das Dir hier auffaelt ist der furchtbare Gestank "
        "von totem Fleisch. Ueberall siehst Du nichts als Leichen. "
        "Es ist ein schrecklicher Ort, denn nicht mal die Folterer "
        "halten sich hier gerne auf. Am besten gehst Du von hier weg "
        "man weiss ja nicht ob auch alle Koerper tot sind."
  );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "leichenraum" }),
      "Hier werden die Leichen der zu tode gefolterten Leute gelagert."
  );
  AddDetail( ({ "leute" }),
      "Alle Leute! Es gibt keine Ausnahmen."
  );
  AddDetail( ({ "ausnahmen" }),
      "Keine sagte ich."
  );
  AddDetail( ({ "gestank" }),
      "Riech mal."
  );
  AddDetail( ({ "ort" }),
      "Es ist ein ganz schrecklicher, Du gehst am besten weg von hier."
  );
  AddDetail( ({ "leichen", "koerper" }),
      "Alte Leichen, neue Leichen hier gibt es alles. Eine "
      "faellt Dir besonders auf."
  );
  AddDetail( ({ "leiche" }),
      "PFUI! Bei dieser haengt noch das Auge dran."
  );
  AddDetail( ({ "auge" }),
      "Es ist kein schoener Anblick. Es glitzert etwas."
  );
  AddDetail( ({ "anblick" }),
      "Kein schoener."
  );
  AddDetail( ({ "waende", "wand" }),
      "Komischerweise sind die Waende ganz sauber."
  );
  AddDetail( ({ "boden" }),
      "Am Boden ist viel Dreck, hier sind auch schon viele Leichen verottet."
  );
  AddDetail( ({ "dreck" }),
      "Es ist sehr viel vorhanden."
  );
  AddDetail( ({ "decke" }),
      "Die Decke ist wie die Waende, total sauber."
  );
  AddDetail( ({ "folterkammer" }),
      "Du bist hier im Leichenraum der Folterkammer."
  );
  AddDetail( ({ "glitzern" }),
      "Es ist eine Reflektion des Lichtes die die Fackeln erzeugen."
  );
  AddDetail( ({ "licht" }),
      "Das Licht wird von Fackeln erzeugt. Es scheint auf das Auge "
      "und ein kleiner Lichtstrahl wird vom Auge auf die Gedaerme "
      "der Leiche reflektiert."
  );
  AddDetail( ({ "fackel", "fackeln" }),
      "Sie erzeugen hier das Licht."
  );
  AddDetail( ({ "lichtstrahl" }),
      "Nur ein kleiner."
  );
  AddDetail( ({ "gedaerme" }),
      "Sie sehen furchtbar aus, Etwas scheint jedoch in ihnen zu sein."
  );
  AddDetail( ({ "etwas" }),
      "Irgendetwas, greif einfach mal hinein."
  );
  AddSmell( DEFAULT_SMELL,
      "Es stinkt nach totem Fleisch."
  );
  AddSmell( "fleisch",
      "Es riecht furchtbar."
  );
  AddSound( DEFAULT_SOUND,
      "Es ist kein Laut zu hoehren."
  );
  AddExit("nordwesten", "./folterkammer_6.lpc");
  AddCmd(({"greife","greif"}),"gfunc");
  counter=1;
}

int gfunc(string str)
{
  object schluesselobj;
  notify_fail("Wu willst Du hineingreifen?\n");
  if (!counter) return write(BS(
  "Du wuehlst in den Gedaermen herum, findest aber nichts.\n")),1;
  if (str=="in gedaerme")
  {
       schluesselobj = clone_object("/d/unterwelt/jed/obj/schluessel");
       schluesselobj->move(this_player(),M_GET|M_SILENT);
       write(
       BS("Du greifst in die Gedaerme hinein und faengst an herumzuwuehlen. "
       "Nach einiger Zeit findest Du einen kleinen Schluessel den Du sofort "  
       "einsteckst.\n"));
       say(
       BS(TP->Name()+
       " tut etwas.\n"),this_player());
       counter--;
  
  return 1;
  }
}

reset()
{
      ::reset();
      counter=1;
}
