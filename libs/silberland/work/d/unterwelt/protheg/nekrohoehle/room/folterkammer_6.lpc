inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Folterkammer." );
  SetProp( P_INT_LONG,
       "Dieser Raum ist etwas merkwuerdig. Es befindet "
       "sich nichts in ihm. Er ist total leer, bis auf "
       "den Stein aus dem die Hoehle gemacht ist. Dieser "
       "Raum dient anscheinend zur Ausrastung der Folterer. "
       "Foltern ist anscheinend auch eine anstrengende "
       "Arbeit. Ein sehr schlechter Geruch dringt aus "
       "dem Suedosten herauf."
  );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({ "raum" }),
       "Er dient zur Ausrastung der Folterer."
  );
  AddDetail( ({ "ausrastung" }),
       "Sie arbeiten dann nicht, sondern stehen nur herum "
       "und dehnen ihre Muskeln."
  );
  AddDetail( ({ "folterer" }),
       "Sie foltern die Gefangenen."
  );
  AddDetail( ({ "gefangenen" }),
       "Sie haben nichts getan, werden gefoltert, getoetet "
       "und muessen auch noch darauf warten."
  );
  AddDetail( ({ "muskeln" }),
       "Die Folterer haben sehr viele Muskeln, da das Foltern "
       "eine sehr schwere koerperliche Betaetigung ist."
  );
  AddDetail( ({ "foltern", "betaetigung" }),
       "Foltern ist eine sehr schwere koerperliche Betaetigung."
  );
  AddDetail( ({ "hoehle" }),
       "Sie ist eigentlich wunderschoen und besteh ausschliesslich "
       "aus Stein."
  );
  AddDetail( ({ "stein", "gestein" }),
       "Leider kennst Du diese Art nicht."
  );
  AddDetail( ({ "art" }),
       "Du kennst sie nicht."
  );
  AddDetail( ({ "wand", "decke", "boden" }),
       "Die Wand, die Decke und der Boden sind voellig "
       "sauber. Es liegt villeicht an dem unbekannten Gestein."
  );
  AddDetail( ({ "geruch" }),
       "Riech einfach mal."
  );
  AddDetail( ({ "suedosten" }),
       "Geh einfach nach Suedosten."
  );
  AddSmell( DEFAULT_SMELL,
       "Ein sehr schrecklicher Geruch dringt aus dem Suedosten "
       "herauf."
  );
  AddSmell( "geruch",
       "Schau einfach mal nach."
  );
  AddSound( DEFAULT_SOUND,
       "Es ist kein einziger Lausch zu hoehren."
  );
  AddExit("nordosten", "./folterkammer_5.lpc");
  AddExit("suedosten", "./folterkammer_7.lpc");
}