inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <room.h>
#include <moredef.h>
#include <defines.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Nekromantenhoehle." );
  SetProp( P_INT_LONG,
        "Du stehst in der maechtigen Nekromantenhoehle die unendlich "
        "lang zu wirken scheint. Das erste das Dir sofort auffaelt "
        "ist der riesige Drachenkopf der direkt vor Dir steht. Er "
        "hat wunderschoene, unbezahlbare Verzierungen die kein "
        "menschliches Wesen errichten koennte. Es muss ein goettliches "
        "Kunstwerk sein, eine andere Loesung kann dein Kopf nicht "
        "ausmachen. Bis auf den Kopf ist der Raum komplett leer. "
        "Die ganze Hoehle ist in diesem Bereich ganz glatt, ob etwa "
        "Jemand die ganze Hoehle bearbeitet hat?"
   );
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({"wand","waende","decke","bereich","raum"}),
       "Komischer weise sind sie in diesem Bereich ganz glatt und "
       "sauber."
  );
  AddDetail( ({"boden"}),
       "Der Boden ist ganz sauber, so sauber das Du das Glaenzen "
       "richtig deutlich sehen kannst."
  );
  AddDetail( ({"glaenzen"}),
       "Es ist richtig hell, beim naeheren hinsehen erkennst Du "
       "auch eine kleine Vertiefung die Du fast uebersehen haettest."
  );
  AddDetail( ({"vertiefung"}),
       "Sie ist eher klein, Du kannst aber einen kleinen Hebel erkennen."
  );
  AddDetail( ({"hebel"}),
       "Was kann man damit wohl machen?"
  );
  AddDetail( ({"kunstwerk","wesen"}),
       "Der Drachenkopf ist so schoen das kein menschliches Wesen "
       "ihn jehmals errichtet haben koennte."
  );
  AddDetail( ({"nekromantenhoehle"}),
       "Sie ist riesig gross und wunderschoen."
  );
  AddDetail( ({"drachenkopf","kopf"}),
       "Der Drachenkopf ist riesig gross mit wunderschoenen Verzierungen. "
       "Es sieht fast so aus als koennte man ihn irgendwie oeffnen."
  );
  AddDetail( ({"verzierungen"}),
       "Sie sind so schoen und ungewoehnlich das sie nicht von dieser "
       "Welt stammen koennen. Hmm...ein dumkler Stein sieht merkwuerdig "
       "aus, findest Du."
  );
  AddDetail( ({"stein"}),
       "Beim naeheren betrachten erkennst Du das es kein Stein ist, sondern "
       "ein dunkles Loch ist."
  );
  AddDetail( ({"loch"}),
       "Was da wohl rein gehoert?"
  );     
  AddDetail( ({"welt"}),
       "Na unsere Welt."
  );
  AddSound( DEFAULT_SOUND,
       "Es herrscht Totenstille."
  );
  AddSound( "totenstille",
       "Nichts zu hoehren."
  );
  AddSmell( DEFAULT_SMELL,
       "Du kannst nichts besonderes riechen."
  );

  
        NewDoor( "westen","./nekrohoehle_2","drachenkopf",
	 ({  D_NAME,"Drachenkopf",
	D_GENDER, MALE,
	D_FLAGS, (DOOR_NEEDKEY|DOOR_RESET_CL|DOOR_CLOSED),
	D_MSGS, ({"nach Westen", "geht durch den offenen Kopf",
				 "kommt durch den Kopf herein" }),
	D_SHORT,"Der Drachenkopf ist %s. ",
	D_LONG,
		 "Ein maechtiger Drachenkopf steht vor Dir. Seine Augen sind aus "
		 "Rubinen die rot wie die Hoelle funkeln. Er ist ein einziges "
	         "Meisterwerk. Seine Verzierungen sind einzigartig. Wer ihn wohl "
                 "erschaffen hat?"
	 }) );

  AddExit("westen", "./nekrohoehle_2.lpc");
  AddExit("osten", ([EX_DEST: "./room", EX_TESTFUNC:"fledermauscheck"]));
   AddCmd(({"ziehe","zieh"}),"hfunc");
}

int hfunc(string str)
{
  object hebel;
  notify_fail("Was willst Du ziehen?\n");
  if (str!="hebel") return 0;
  write(
       "Du ziehst an dem Hebel und ploetzlich bricht die Decke "
       "und der Boden auf, es sind nun zwei maechtige Loecher "
       "am Boden und der Decke entstanden.\n");
       say(
       "Die Erde beginnt etwas zu beben und irgendetwas ist anders.\n");
  AddExit("unten", "./nekrohoehle_5.lpc");
  AddExit("oben", "./nekrohoehle_4.lpc");
       return 1;
}

fledermauscheck()
{
if(present("\ja", find_object("/d/unterwelt/jed/room/nekrohoehle_4")) ||
   present("\ja", find_object("/d/unterwelt/jed/room/nekrohoehle_5")))
 return write("Eine Barriere hindert Dich!\n"),0;
else
    return 1;
}

