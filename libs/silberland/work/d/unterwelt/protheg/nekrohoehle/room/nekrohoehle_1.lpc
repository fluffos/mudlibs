inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Nekromantenhoehle." );
  SetProp( P_INT_LONG,
       "Du befindest dich hier in der schrecklichen "
       "Nekromantenhoehle. "
       "Kleine und grosse Steinzacken siehst Du an der "
       "Decke haengen. Es liegen viele Steine herum, da "
       "diese Hoehle hauptsaechlich aus Stein besteht. "
       "Dir ist irgendwie mumlig, Du solltest vorsichtig "
       "sein, fallst Du beschliesst weiterzugehen. Wer weiss "
       "es koennte dein Ende sein."
  );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );

  AddDetail( ({"nekromantenhoehle"}),
       "Dies hier ist die schreckliche Nekromantenhoehle."
  );
  AddDetail( ({"steinzacken"}),
       "Sie scheinen ziemlich lose zu sein, also sei "
       "lieber vorsichtig."
  );
  AddDetail( ({"decke"}),
       "Die Decke besteht aus Stein. Von ihr haengen "
       "kleine und grosse Steinzacken."
  );
  AddDetail( ({"ende"}),
       "Noch bist Du nicht tot."
  );
  AddDetail( ({"stein"}),
       "Die Art des Steins kennst Du nicht, er ist "
       "aber sehr dunkel, fast schwarz."
  );
  AddDetail( ({"boden"}),
       "Er besteht vollstaendig aus Stein."
  );
  AddDetail( ({"wand"}),
       "Sie besteht aus Stein. Nach Suedosten ist das Loch "
       "aus dem Du hierher gekommen bist."
  );
  AddDetail( ({"loch"}),
       "Aus diesem Loch bist du hierher gelangen."
  );
  AddDetail( ({"art"}),
       "Die kennst Du nicht."
  );
  AddSound( DEFAULT_SOUND,
       "Es herrscht Totenstille."
  );
  AddSound( "totenstille",
       "Nichts zu hoehren."
  );
  AddExit("nordosten", "./nekrohoehle_2.lpc");
  AddCmd(({"klettere","kletter"}),"kfunc");
}

kfunc (str)
{
 object me; 
 notify_fail("Wo willst Du durchklettern?\n");
 if (str=="in loch")
  {
   write("Du nimmst deinen ganzen Mut zusammen und kletterst durch das Loch.\n");
   this_player()->move("/d/unterwelt/jed/room/folterkammer_3.lpc",M_GO,
   "im Dickicht","verschwindet","kommt an"); 
   return 1;
  }
}
