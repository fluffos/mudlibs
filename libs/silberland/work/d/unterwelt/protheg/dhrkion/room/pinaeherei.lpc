#include "../def.h"

inherit MOST "std_room";

#define ANSCHLUSS "/d/unterwelt/zordan/dhrkion/room/schmiede"

string tafel()
{
  if(TP)
    TP->More(make_document(
	"Unverzauberte Piwafwis koennen hier verzaubert werden.\n"
	"Die Verzauberung dauert ungefaehr einen Tag.\n"
	"Mitzubringen sind: Ein Piwafwi und folgende Ingredienzen.\n \n"
	"Ingredienzen:              Einfach    Zweifach    Dreifach\n"
	"* reine Diamanten             2           4           6\n"
	"* Schuppen eines Drachen      5          10          15\n"
	"* Magiesteine                 2           4           6\n"
	"* Goldmuenzen               30000       60000       90000\n"
	"* etwas Spinnenseide          1           1           1\n \n"
	"Liste der moeglichen Verzauberungen:\n"
	"* zusaetzliche magische Verdunkelung\n"
	"* magische Widerstandsfaehigkeit\n"
	"* zusaetzliche Innenfuttertaschen\n"
	"* Erhoehung der Lebenskraft\n"
	"* Erhoehung der magischen Kraft\n"
	"* Elementarer Schutz (x)\n"
	"* Drachenschutz (x)\n"
	"* heiliger Schutz (x)\n"
	"* unheiliger Schutz (x)\n \n"
	"(x) Es ist immer nur ein Schutz moeglich.\n \n"
	"Bestellung mit: sage 'Mizzri naehe mir bitte einen Piwafwi'\n"
	"Anschliessend:  sage 'Mizzri verzaubere bitte meinen Piwafwi'\n"
	"Abholung:       sage 'Mizzri ich will meinen piwafwi abholen'\n"
	"Weitere Moeglichkeiten fuer Piwafwis:\n"
	" Zerstoerung, Wiederbringung und Reparatur\n"));
  
  return "";
}

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Die Raeume von Mizzri Okh Chak'ar");
  SetProp(P_INT_LONG,
	  BS("Du findest Dich in einer niedrigen Halle wieder, die bis auf "
	     "einige Kleiderstaender vollkommen leer und schmucklos gehalten "
	     "ist. Scheinbar legt die Bewohnerin keinen grossen Wert auf "
	     "Verzierungen, dafuer sind alle wichtigen Arbeitsgeraete zum "
	     "Naehen vorhanden, sowie auch ein Tisch und ein recht bequem "
	     "aussehender Couchsessel."));
  
  AddDetail(({"boden","marmorboden"}),
	    "Der Boden scheint aus einem dunklen Marmor zu bestehen, er "
	    "schimmert schwach.");
  
  AddDetail(({"schimmern","schimmer"}),
	    "Der Marmorboden schimmert etwas.");
  
  AddDetail(({"decke"}),
	    "Die schmucklose Decke liegt in knapp vier Metern Hoehe.");
  
  AddDetail(({"hoehe","meter"}),
	    "Die Decke ist nicht sonderlich hoch.");
  
  AddDetail(({"waende","wand"}),
	    "Die Waende sind absolut schlicht gehalten, der einzige Schmuck "
	    "ist die Tuer die wieder hinaus nach Dhrkion fuehrt.");
  
  AddDetail(({"halle"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"marmor"}),
	    "Die ganze Halle besteht aus leicht schimmerndem Marmor.");
  
  AddDetail(({"tuer","ausgang"}),
	    "Durch die Tuer gelangt man wieder zurueck nach Dhrkion.");
  
  AddDetail(({"bewohnerin","mizzri"}),
	    "Sie scheint wohl gerade nicht hier zu sein.");
  
  AddDetail(({"staender","kleiderstaender"}),
	    "Viele der Kleiderstaender sind mit allerlei kostbaren Kleidern, "
	    "Hosen und Hemden behangen. Sie wurden alle von Mizzri Okh "
	    "Chak'ar genaeht und sind fuer die noblen Dunkelelfen der "
	    "Haeuser bestimmt.");
  
  AddDetail(({"hose","hosen","seidenhose","seidenhosen"}),
	    "Kostbare Hosen aus reiner Spinnenseide haengen an den "
	    "Kleiderstaendern.");
  
  AddDetail(({"hemd","hemden","seidenhemd","seidenhemden"}),
	    "Einige sehr kunstvoll genaehte Hemden haengen an den "
	    "Kleiderstaendern.");
  
  AddDetail(({"kleid","kleider","seidenkleid","seidenkleider"}),
	    "Einige seidene Kleider haengen an den Kleiderstaendern und "
	    "warten auf ihre Abholung. Hie und da siehst Du auch einen "
	    "der beruehmten Piwafwis herumhaengen.");
  
  AddDetail(({"piwafwis","piwafwi"}),
	    "Tatsaechlich, es haengen auch ein paar Piwafwis an den "
	    "Kleiderstaendern. Ob diese von Mizzri Okh Chak'ar genaeht "
	    "wurden?");
  
  AddDetail(({"haeuser","haus","dunkelelfen","dunkelelf","abholung"}),
	    "Viele der Kleider an den Kleiderstaendern warten auf deren "
	    "Abholung, denn sie sind fuer die nobleren Dunkelelfen bestimmt.");
  
  AddDetail(({"schmuck","verzierung","verzierungen"}),
	    "Schmuck? Verzierungen? Nein den findest Du hier nicht. Einzig "
	    "die Kleiderstaender schmuecken die Halle mit ihren Kleidern.");
  
  AddDetail(({"wert"}),
	    "Mizzri Okh Chak'ar legt scheinbar keinen grossen Wert auf "
	    "Schmuck und Verzierungen.");
  
  AddDetail(({"sessel","couchsessel"}),
	    "Ein besonders bequem aussehender Couchsessel steht neben "
	    "dem Tisch. Er gehoert Mizzri Okh Chak'ar, deswegen sitzt sie "
	    "auch meisst darin, wenn sie naeht.");
  
  AddDetail(({"seide","spinnenseide"}),
	    "Saemtliche von Mizzri Okh Chak'ar erzeugten Kleider bestehen aus "
	    "dunkler Spinnenseide. Das macht die Kleider so kostbar und "
	    "begehrt.");
  
  AddDetail(({"geraete","geraet","arbeitsgeraet","arbeitsgeraete"}),
	    "Wie sie alle genau heissen und wofuer sie genau gebraucht "
	    "werden weisst Du nicht, aber dass sie benutzt werden siehst "
	    "Du sofort an den vielen Resten von Spinnenseide, die um jedes "
	    "der Geraete herumliegen.");
  
  AddDetail(({"dhrkion"}),
	    "Du musst nur durch die Tuer gehen, dann bist Du draussen in "
	    "Dhrkion.");
  
  AddDetail(({"rest","reste","seidenrest","seidenreste","spinnenseidenrest",
		"spinnenseidenreste","seiderest","seidereste",
		"spinneseidenrest","spinnenseidereste"}),
	    "Um die Arbeitsgeraete liegen allerlei Spinnenseidenreste herum.");
  
  AddDetail(({"naehen"}),
	    "Die Halle ist vollkommen zum Naehen ausgestattet.");
  
  AddDetail(({"tisch"}),
	    "Neben dem Couchsessel steht ein steinerner Tisch, auf dem sich "
	    "einige Gegenstaende befinden.");
  
  AddDetail(({"gegenstaende","gegenstand"}),
	    "Auf dem Tisch liegen fein saeuberlich aufgereihte Naehnadeln, "
	    "einige Rollen Zwirn und eine Kristalltafel.");
  
  AddDetail(({"naehnadel","naehnadeln","nadel","nadeln"}),
	    "Auf dem Tisch liegen einige Naehnadeln fein saeuberlich "
	    "aufgereiht.");
  
  AddDetail(({"rolle","rollen"}),
	    "Einige Rollen Zwirn befinden sich auf dem Tisch.");
  
  AddDetail(({"zwirn"}),
	    "Bei dem Zwirn scheint es sich um eine besonders "
	    "widerstandsfaehige Spinnenseide zu handeln.");
  
  AddDetail(({"tafel","kristalltafel","kristall"}),
	    "Da steht was drauf...");
  
  AddSound(({"stille", DEFAULT_SOUND}), 
	   "Hier herrscht eine angenehme Stille.");
  
  AddSmell(({DEFAULT_SMELL}), 
	   "Die Kleiderstaender riechen teilweise etwas modrig, ansonsten "
	   "riecht es hier ziemlich neutral.");
  
  AddSmell(({"staender","kleiderstaender"}),
	   "Die Kleiderstaender riechen teilweise etwas modrig.");
  
  AddReadDetail(({"tafel","kristalltafel","kristall"}), CLOSURE(tafel));
  
  Licht("dunkel");
  Umgebung("warm", TT_CAVE, 1);
  
  AddExit("tuer", ANSCHLUSS);
  
  AddItem(NPC "mizzri", REFRESH_DESTRUCT);
}

varargs string GetExits(object viewer)
{
  return "Durch die 'Tuer' kannst Du wieder zurueck.\n";
}

