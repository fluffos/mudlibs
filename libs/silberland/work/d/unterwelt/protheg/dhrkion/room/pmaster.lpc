#include "../def.h"

#define SAVEFILE ROOM "psave"

#define INGREDIENTS_1 (["diamanten":2,"dschuppen":5,"magiesteine":2,"geld":30000])
#define INGREDIENTS_2 (["diamanten":4,"dschuppen":10,"magiesteine":4,"geld":60000])
#define INGREDIENTS_3 (["diamanten":6,"dschuppen":15,"magiesteine":6,"geld":90000])
#define EIN_TAG 86400

mapping orders;
mapping piwafwis;

void create()
{
  orders=([]);
  piwafwis=([]);
  
  SUID;
  
  restore_object(SAVEFILE);
}

mapping QueryIngredients(int i)
{
  switch(i)
    {
    case 1: return INGREDIENTS_1;
    case 2: return INGREDIENTS_2;
    case 3: return INGREDIENTS_3;
    }
}

public int QueryPiwafwi(string n)
{
  if(!PO) return 0;
  if(geteuid()!=geteuid(PO)) return 0;
  
  if(member(piwafwis, n)) return piwafwis[n];
  
  return 0;
}

public int DeletePiwafwi(string n)
{
  if(!PO) return 0;
  if(geteuid()!=geteuid(PO)) return 0;
  
  if(!member(piwafwis, n)) return 0;
  
  if(objectp(find_object(piwafwis[n]))) return 0;
  
  DB(BS("*** Deleting Piwafwi for "+CAP(n)));
  
  piwafwis=m_delete(piwafwis, n);
  
  save_object(SAVEFILE);
  
  return 1;
}

public int RegisterPiwafwi(string n, string fname)
{
  if(!PO) return 0;
  
  if(geteuid()!=geteuid(PO)) return 0;
  
  if(member(piwafwis, n)) return 0;

  DB(BS("*** Registering Piwafwi for "+CAP(n)));
  
  piwafwis+=([n:fname]);
  
  save_object(SAVEFILE);
  
  return 1;
}

public int NewOrder(string n, int lvl, string *mods)
{
  if(!PO) return 0;
  if(geteuid()!=geteuid(PO)) return 0;
  
  if(member(orders, n)) return 0;
  
  DB(BS("*** New Piwafwi Order for "+CAP(n)));
  
  orders+=([n:time()+EIN_TAG;lvl;mods]);
    
  save_object(SAVEFILE);
}

public mixed GetOrder(string n, int remove)
{
  string *ret;
  
  if(!PO) return 0;
  if(geteuid()!=geteuid(PO)) return 0;
  
  if(!member(orders, n)) return 0;
  
  if(remove)
    {
      ret=({orders[n], orders[n, 1], orders[n, 2]});
      
      orders=m_delete(orders, n);

      save_object(SAVEFILE);
      
      return ret;
    }
  
  return ({orders[n], orders[n, 1], orders[n, 2]});
}

public mixed DeleteOrder(string n)
{
  return GetOrder(n, 1);
}

