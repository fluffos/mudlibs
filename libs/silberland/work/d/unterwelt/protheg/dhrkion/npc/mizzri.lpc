#pragma strong_types;

#include "../def.h"

inherit DUNKELELF;

#define PMASTER ROOM "pmaster"
#define PREIS_NORMAL 1000
#define PREIS_DEST_NORMAL 2000
#define PREIS_DEST_SPEZIAL 5000
#define PREIS_REPARATUR 2000
#define PREIS_MAGIC_REPARATUR 5000
#define PREIS_WIEDERBRINGUNG 10000

nosave mapping beutel;
nosave int timeout;

string zerstoerung();
string wiederbringung();
string reparatur();
string wielangnoch();

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Dunkelelfe Mizzri Okh Chak'ar die Meisternaeherin");
  SetProp(P_LONG,
    BS("Mizzri Okh Chak'ar ist eine eher schmaechtigere Dunkelelfe, die "
       "ihr Leben einzig und allein dem Naehen gewidmet hat. Sie betreibt "
       "hier diesen Laden, in dem sie alle ihre genaehten Kunstwerke "
       "anbietet. Sie ist fuer eine Dunkelelfe relativ klein und traegt "
       "auch nicht die sonst ueblichen Ruestungen, sondern ein schoenes "
       "edelsteinbesetztes Kleid aus dunkler Spinnenseide."));

  SetProp(P_NAME, "Mizzri Okh Chak'ar");
  SetProp(P_GENDER, FEMALE);
  AddId(({"mizzri","mizzri okh chakar","dunkelelf","mizzri okh chak'ar",
	    "naeherin","meisternaeherin","bewohnerin"}));
  
  set_living_name("mizzri");
  
  create_default_darkelf(20);

  SetProp(P_HANDS, ({" mit Nadel und Faden",
		       QueryProp(P_HANDS)[1]+50, DT_PIERCE}));
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, -750);
  SetProp(P_ARTICLE, 0);
  
  SetProp(P_NOATTACK, "ist zu sehr mit Naehen beschaeftigt und ignoriert "
	  "Dich!\n");  
  
  SetProp(P_LOG_INFO, "protheg/mizzri");
  
  AddInfo(DEFAULT_INFO,
	  ({"naeht einfach weiter.\n",
	      "hat offenbar nichts bemerkt.\n",
	      "wuerdigt Dich keines Blickes.\n",
	      "deutet nur laechelnd auf die Tafel.\n",
	   "blickt kurz auf und naeht dann weiter.\n"}));
  
  AddLibrary(DHRKIONLIB,1);
  
  AddInfo(({"zerstoeren","zerstoerung","zerstoerung"}), CLOSURE(zerstoerung));
  AddInfo(({"wiederbringung","wiederbringen"}), CLOSURE(wiederbringung));
  AddInfo(({"reparieren","reparatur"}), CLOSURE(reparatur));
  AddInfo(({"bestellung","bestellungen"}), CLOSURE(wielangnoch), "sagt: ");
  
  AddInfo(({"verzauberung","verzaubern"}),
	  "Dazu brauchst Du nur Deinen, noch nicht verzauberten, Piwafwi, "
	  "die magischen Ingredienzen und das Geld laut Kristalltafel. "
	  "Dann sagst Du 'Mizzri verzaubere bitte meinen Piwafwi' und "
	  "alles weitere erledige dann ich.",
	  "sagt: ");
  
  AddInfo(({"piwafwi","umhang","piwafwiumhang","dunkelelfenumhang",
		"drowumhang","drowpiwafwi","hilfe","geld","ingredienzen",
		"ingredienz","tafel","kristalltafel","abholen",
		"abholung","verzauberungen"}),
	  "deutet nur laechelnd auf die Tafel.");
  
  AddInfo(({"naehen","naeherei"}),
	  "laechelt und naeht dann weiter.");
  
  AddInfo(({"mizzri","mizzri okh chakar","mizzri okh chak'ar"}),
	  "Ja? Was ist mit mir?", "sagt: ");
  
  AddInfo(({"kyorl","kyorl okh chakar","k'yorl","k'orl okh chak'ar"}),
	  "Was ist mit K'yorl? Ist sie endlich tot?", "sagt: ");
  
  AddInfo(({"nkaaht","nkaaht okh chakar","nkaaht okh chak'ar"}),
	  "Was ist mit Nkaaht? Ist er endlich tot?", "sagt: ");
  
  AddInfo(({"verdunkelung","magische verdunkelung","zusaetzliche magische verdunkelung"}),
	  "Mit dieser Verzauberung wird der Piwafwi anschliessend von einer "
	  "noch duenkleren Aura umgeben.", "sagt: ");
  
  AddInfo(({"widerstandsfaehigkeit","magische widerstandsfaehigkeit"}),
	  "Mit dieser Verzauberung ist der Piwafwi anschliessend von einer "
	  "magischen Aura umgeben, die ihn im Kampf widerstandsfaehiger "
	  "macht.", "sagt: ");
  
  AddInfo(({"innenfuttertaschen","zusaetzliche innenfuttertaschen"}),
	  "Mit dieser Verzauberung nimmt der Piwafwi anschliessend viel "
	  "mehr auf, ist aber insgesamt leichter als zuvor.", "sagt: ");
  
  AddInfo(({"lebenskraft","erhoehung der lebenskraft","erhoehung lebenskraft"}),
	  "Mit dieser Verzauberung erhoeht der Piwafwi die Lebenskraft des "
	  "Traegers.", "sagt: ");

  AddInfo(({"magische kraft","erhoehung der magischen kraft",
		"erhoehung magische kraft","magie","erhoehung der magie",
		"magieerhoehung"}),
	  "Mit dieser Verzauberung erhoeht der Piwafwi die magische Kraft des "
	  "Traegers.", "sagt: ");

  AddInfo(({"schutz"}),
	  "Welchen meinst Du?", "sagt: ");
  
  AddInfo(({"elementarer schutz","elementarem schutz"}),
	  "Mit dieser Verzauberung schuetzt der Piwafwi etwas vor der Macht "
	  "der Elemente.", "sagt: ");
  
  AddInfo(({"drachenschutz"}),
	  "Mit dieser Verzauberung schuetzt der Piwafwi etwas vor heissem "
	  "Drachenodem.", "sagt: ");
  
  AddInfo(({"heiliger schutz"}),
	  "Mit dieser Verzauberung schuetzt der Piwafwi etwas vor heiligen "
	  "Angriffen.", "sagt: ");
  
  AddInfo(({"unheiliger schutz"}),
	  "Mit dieser Verzauberung schuetzt der Piwafwi etwas vor unheiligen "
	  "Angriffen.", "sagt: ");
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP, Name()+" beachtet Dich nicht und naeht weiter.\n"}));

  SetChats(1, ({
    Name()+" naeht an einem schoenen Kleid herum.\n",
      Name()+" naeht an einem langen Abendkleid herum.\n",
      Name()+" naeht an einer seidenen Hose herum.\n",
      Name()+" naeht an einem kunstvoll geschnittenen Hemd herum.\n",
      Name()+" naeht an einem kurzen Rock herum.\n",
      Name()+" naeht an einer seidenen Weste herum.\n",
      Name()+" blickt kurz auf, bemerkt Dich jedoch nicht.\n",
      Name()+" blickt kurz auf und naeht dann weiter.\n"}));
  
  SUID;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;
  if(touch)
    {
      switch(random(3))
        {
          case 0: call_out("reaction", 0, TP,
            "blickt Dich kurz an und naeht dann weiter.",
            "blickt "+TP->name(WEN)+" nur kurz an.");
          break;
          case 1: call_out("reaction", 0, TP,
            "grummelt nur kurz und naeht dann weiter.",
            "grummelt "+TP->name(WEN)+" kurz an.");
          break;
          case 2: call_out("reaction", 0, TP,
	    "murmelt etwas und naeht dann weiter.",
            "murmelt etwas und naeht dann weiter.");
          break;
        }
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

varargs void reaction(object ob, string macher, string andere, int flag)
{
  if(present(ob, ENV(TO)))
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    if(flag) ob->AddHp(-20+random(10));
  }
}

void sfktmiz(string str)
{
  command_me("sage "+str);
}

string wielangnoch()
{
  if(!TP || !present(TP, MENV)) return "";
  
  if(TP->QueryProp(P_RACE)!="Dunkelelf")
    return "Was willst Du? Geh woanders spielen!";
      
  if(!sizeof(PMASTER->GetOrder(getuid(TP))))
    return "Aber fuer Dich habe ich doch gar keinen Auftrag!";
  
  if(PMASTER->GetOrder(getuid(TP))[0] > time())
    return "Dein Piwafwi ist noch nicht fertig!";
  
  return "Dein Piwafwi ist fertig, Du koenntest ihn Dir jederzeit abholen...";
}

void reparatur_final(string str, object rep, int preis)
{
  if(str!="ja")
    return sfktmiz("Dann nicht...");
  
  if(!present(TP, MENV)) return;
  if(!objectp(rep)) return;
  
  rep->Damage(-(rep->QueryProp(P_DAMAGED)));
  
  TP->AddMoney(-preis);
  
  write(BS(Name()+" nimmt Dir den Piwafwi ab, wendet sich ihrem Werkzeug "
	   "zu und naeht an dem Piwafwi rum...")+
	BS("Kurze Zeit spaeter gibt sie ihn Dir vollstaendig repariert "
	   "zurueck.")+
	BS("Du sagst: Danke"));
  
  tell_room(ENV(TP), BS(TPN+" laesst einen Piwafwi reparieren..."), ({TP}));
  
  return;
}

string reparatur()
{
  object rep;
  string own;
  int preis;
  
  if(!rep=present("piwafwi", TP))
    return "meint: Wo ist denn Dein Piwafwi?\n";
  
  if(stringp(own=rep->QueryOwner()))
    if(own!=getuid(TP))
      return "meint: Was machst Du mit einem fremden Piwafwi?!\n";
  
  if(rep->QueryProp(P_DAMAGED) < 2)
    return "meint: Der Piwafwi bedarf noch keiner Reparatur!\n";
  
  preis=(rep->QueryMagic()*PREIS_MAGIC_REPARATUR)+PREIS_REPARATUR;
  
  sfktmiz("Die Reparatur Deines "+(rep->QueryMagic() ? "magischen ":"")+
	  "Piwafwi wuerde Dich "+preis+" Muenzen "
	  "kosten...");
  if(TP->QueryMoney() < preis)
    return "sagt: Die Du allerdings nicht hast!\n";
  
  sfktmiz("Willst Du das bezahlen?");
  write(" ja / nein ? ");
  input_to("reparatur_final", 0, rep, preis);
  
  return "nickt.\n";
}

string wiederbringung()
{
  string pi;
  object piw;
  
  if(TP)
    if(TP->QueryProp(P_RACE)=="Dunkelelf")
      if(stringp(pi=PMASTER->QueryPiwafwi(getuid(TP))))
	if(objectp(piw=find_object(pi)))
	  {
	    if(deep_present(piw, TP))
	      {
		sfktmiz("Aber Du hast ihn doch bereits! Verschwende meine "
			"Zeit nicht unnoetig!");
		return "blickt boese.";
	      }
	    
	    if(present(piw, ENV(TP)))
	      {
		sfktmiz("Aber Da ist er doch bereits! Verschwende meine "
			"Zeit nicht unnoetig!");
		return "blickt boese.";
	      }
	    
	    tell_room(MENV, BS(Name()+" konzentriert sich kurz..."));
	    
	    sfktmiz("Ja, ich habe ihn gesehen... Ich kann nun versuchen, ihn "
		 "Dir wiederzubringen... Vergiss nicht, es kostet Dich "+
		 PREIS_WIEDERBRINGUNG+" Muenzen.");
	    
	    write("Willst Du das? Ja/Nein? ");
	    input_to("wiederbringung_final", 0, piw);
	    
	    return "nickt.";
	  }
	else
	  {
	    sfktmiz("Dein Piwafwi wurde leider vollstaendig zerstoert! Wenn Du "
		    "einen neuen willst, kann ich Dir einen naehen.");
	    
	    PMASTER->DeletePiwafwi(getuid(TP));
	    
	    return "naeht weiter.";
	  }
      else
	{
	  sfktmiz("Hm, ueber Deinen Piwafwi habe ich keine Aufzeichnungen. "
		  "Bist Du Dir sicher, dass Du einen von mir haben sollst?");
	  return "gruebelt.";
	}
    else
      {
	 sfktmiz("Was willst Du? Geh woanders spielen!");
	 return "blickt boese.";
      }
	 
	  
  return "fragt: Was soll ich denn wiederbringen?";
}

void wiederbringung_final(string str, object piw)
{
  if(!TP || !MENV || !present(TP, MENV)) return;
  if(!objectp(piw)) return;
  
  if(str!="ja") 
    return sfktmiz("Na dann nicht.");
  
  if(TP->QueryMoney() < PREIS_WIEDERBRINGUNG)
    {
      sfktmiz("Du hast die erforderlichen "+PREIS_WIEDERBRINGUNG+" Muenzen "
	      "nicht! Komm wieder wenn Du sie hast!");
      
      return;
    }
  
  if(piw->move(MENV, M_NOCHECK)!=1)
    {
      sfktmiz("Meine Magie ist scheinbar nicht stark genug, um Deinen "
	      "Piwafwi wiederzubringen...");
      
      return;
    }
  
  tell_room(MENV, BS(Name()+" wirbelt ihre Haende herum und haelt darin "
		     "ploetzlich einen Piwafwi..."));
  
  if(piw->move(TP, M_GET)==ME_TOO_HEAVY)
    sfktmiz("Du bist ueberladen und kannst ihn daher nicht tragen! Ich werde "
	    "ihn Dir aber auch nicht halten, ich lege ihn hier auf den Boden");
  else
    sfktmiz("Hier bitte.");
  
  TP->AddMoney(-PREIS_WIEDERBRINGUNG);
}

void zerstoerung_normal_janein(string str, object what)
{
  if(str!="ja")
    {
      sfktmiz("Dann eben nicht.");
      
      return;
    }
  
  if(TP->QueryMoney() < PREIS_DEST_NORMAL)
    {
      sfktmiz("Du hast die "+PREIS_DEST_NORMAL+" Muenzen nicht!");
      
      return;
    }
  
  what->SetProp(P_CURSED, 0);
  what->DoUnwear(1);
  what->move(MENV, M_NOCHECK);  
  what->remove(1);
  
  if(objectp(what)) what->destruct(1);
  
  if(objectp(what)) what->move("/players/protheg/workroom", M_NOCHECK);
  
  PMASTER->DeletePiwafwi(getuid(TP));
  
  TP->AddMoney(-PREIS_DEST_NORMAL);
  
  tell_room(MENV, BS(Name()+" nimmt den Piwafwi und uebergibt ihn einem "
		     "Sklaven, der ihn wegbringt."));
  
  sfktmiz("Nun gut, jetzt kannst Du Dir hier einen neuen naehen lassen, oder "
	  "in Zukunft ohne Piwafwi herumirren...");
}

void zerstoerung_spezial_janein(string str, object what)
{
  if(str!="ja")
    {
      sfktmiz("Dann eben nicht.");
      
      return;
    }
  
  if(TP->QueryMoney() < PREIS_DEST_SPEZIAL)
    {
      sfktmiz("Du hast die "+PREIS_DEST_SPEZIAL+" Muenzen nicht!");
      
      return;
    }
  
  what->SetProp(P_CURSED, 0);
  what->DoUnwear(1);
  what->move(MENV, M_NOCHECK);  
  what->remove(1);
  
  if(objectp(what)) what->destruct(1);
  
  if(objectp(what)) what->move("/players/protheg/workroom", M_NOCHECK);
  
  PMASTER->DeletePiwafwi(getuid(TP));
  
  TP->AddMoney(-PREIS_DEST_SPEZIAL);
  
  write(BS("Mizzri konzentriert sich kurz...")+
	BS("Ploetzlich haelt sie Deinen Piwafwi in ihren Haenden...")+
	BS("Sie nimmt den Piwafwi und uebergibt ihn einem "
	   "Sklaven, der ihn wegbringt."));
  
  sfktmiz("Nun gut, jetzt kannst Du Dir hier einen neuen naehen lassen, oder "
	  "in Zukunft ohne Piwafwi herumirren...");
}

string zerstoerung()
{
  string pi;
  object piw;
  
  if(TP)
    if(TP->QueryProp(P_RACE)=="Dunkelelf")    
      if(stringp(pi=PMASTER->QueryPiwafwi(getuid(TP))))
	if(objectp(piw=find_object(pi)))
	  if(deep_present(piw, TP))
	    {
	      sfktmiz("Du moechtest also Deinen Piwafwi zerstoeren lassen. "
		      "Du weisst, dass Dich das "+PREIS_DEST_NORMAL+" Muenzen "
		      "kostet. Bist Du sicher, dass Du ihn zerstoeren lassen "
		      "willst?");
	      
	      write("Zerstoeren? Ja / Nein  ");
	      
	      input_to("zerstoerung_normal_janein", 0, piw);
	      return "schaut fragend.";
	    }
	  else
	    {
	      sfktmiz("Du moechtest also Deinen Piwafwi zerstoeren lassen. "
		      "Da Du ihn nicht bei Dir hast, kostet es Dich "+
		      PREIS_DEST_SPEZIAL+" Muenzen. Bist Du sicher, dass Du "
		      "ihn zerstoeren lassen willst?");
	      
	      write("Zerstoeren? Ja / Nein  ");
	      
	      input_to("zerstoerung_spezial_janein", 0, piw);
	      return "schaut fragend.";	    
	    }
	else
	  PMASTER->DeletePiwafwi(getuid(TP));
      else
  	{
	  sfktmiz("Hm, ueber Deinen Piwafwi habe ich keine Aufzeichnungen. "
		  "Bist Du Dir sicher, dass Du einen von mir haben sollst?");
	  return "gruebelt.";
	}
    else
      {
	sfktmiz("Was willst Du? Geh woanders spielen!");
	return "blickt boese.";
      }
  
  return "fragt: Was willst Du denn zerstoeren lassen?";
}

void verzauberung_kaestchen(int anzahl, object pl, object pi, string *mods)
{
  object k;
  
  if(!objectp(pl)) return;
  if(!present(pl, MENV)) return;
  if(!objectp(pi)) return;
  if(!present(pi, pl)) return;
  
  pi->DoUnwear();
  
  tell_object(pl, BS("Du gibst "+name(WEM)+" Deinen Piwafwi."));
  
  pi->move(ME, M_NOCHECK);
  pi->remove(1);
  if(objectp(pi))
    destruct(pi);
  
  sfktmiz("Hier hast Du ein Kaestchen, in welches Du die geforderten "
	  "Ingredienzen laut Kristalltafel reinlegen sollst. Wenn Du fertig "
	  "bist, gib es mir einfach wieder. Aber Vorsicht warte nicht zu "
	  "lange, denn es loest sich in ein paar Minuten wieder auf.");
  
  k=clone_object(OBJ "kaestchen");
  
  k->Activate(getuid(pl), anzahl, mods);
  
  k->move(TP, M_NOCHECK);
  
  tell_object(pl,
	      BS(Name()+" gibt Dir ein hoelzernes Kaestchen und widmet sich "
		 "wieder dem Naehen zu..."));
  
  tell_room(MENV, BS(Name()+" gibt "+pl->name(WEM)+" ein hoelzernes Kaestchen "
		     "und widmet sich wieder dem Naehen zu..."), ({TP}));
  
}

void remove_kaestchen(object k)
{
  map_array(all_inventory(k), CLOSURE(remove));
  k->remove(1);
}

void check_kaestchen(object pl, object k)
{
  object *inv;
  object ob;
  mapping ing;
  int error;
  
  if(!sizeof(inv=all_inventory(k))) 
    {
      sfktmiz("Das Kaestchen ist ja leer! Vergeude meine Zeit nicht!");
      
      //remove_kaestchen(k);
      
      return ;
    }
  
  if((!k->QueryMagic()) || (!sizeof(k->QueryMods())))
    {
      sfktmiz("Irgendetwas stimmt mit dem Kaestchen nicht, ich beschlagnahme "
	      "es sicherheitshalber!");

      //remove_kaestchen(k);

      return ;
    }
  
  ing=PMASTER->QueryIngredients(k->QueryMagic());
  
  error=0;
  
  if(!objectp(ob=present("diamant", k)))
    {
      sfktmiz("Es befinden sich keine Diamanten in dem Kaestchen!");
      error=1;
    }
  else
    if(ob->QueryProp(P_AMOUNT) < ing["diamanten"])
      {
	sfktmiz("Es befinden sich nicht genug Diamanten in dem Kaestchen!");
	error=1;
      }

  if(!objectp(ob=present("\nschupp", k)))
    {
      sfktmiz("Es befinden sich keine Drachenschuppen in dem Kaestchen!");
      error=1;
    }
  else
    if(ob->QueryProp(P_AMOUNT) < ing["dschuppen"])
      {
	sfktmiz("Es befinden sich nicht genug Drachenschuppen in dem "
		"Kaestchen!");
	error=1;
      }
  
  if(!objectp(ob=present("magiestein", k)))
    {
      sfktmiz("Es befinden sich keine Diamanten in dem Kaestchen!");
      error=1;
    }
  else
    if(ob->QueryProp(P_AMOUNT) < ing["magiesteine"])
      {
	sfktmiz("Es befinden sich nicht genug Diamanten in dem Kaestchen!");
	error=1;
      }
  
  if(!objectp(ob=present("\nspinnenseide", k)))
    {
      sfktmiz("Es befindet sich keine Spinnenseide in dem Kaestchen!");
      error=1;
    }
  
  if(!objectp(ob=present("geld", k)))
    {
      sfktmiz("Es befindet sich kein Geld in dem Kaestchen!");
      error=1;
    }
  else
    if(ob->QueryProp(P_AMOUNT) < ing["geld"])
      {
	sfktmiz("Es befindet sich nicht genug Geld in dem Kaestchen!");
	error=1;
      }
  
  if(error)
    {
      sfktmiz("Das sind nicht genug Ingredienzen fuer die Verzauberung des "
	      "Piwafwi.");
      tell_room(MENV, BS(Name()+" leert das Kaestchen auf den Boden aus..."));
      k->move(MENV, M_NOCHECK);
      k->remove(1);
      
      return;
    }
  
  sfktmiz("Gut, ich werde alles weitere veranlassen.");
  sfktmiz("Du kannst Dir Deinen verzauberten Piwafwi ab morgen um diese "
	  "Zeit abholen kommen. Sag mir einfach 'Mizzri ich will meinen "
	  "Piwafwi abholen'.");
  
  PMASTER->NewOrder(getuid(pl), k->QueryMagic(), k->QueryMods());
  
  //remove_kaestchen(k);
}

void verzauberung_mods(int anzahl, object pl, object pi)
{
  sfktmiz("Folgende Verzauberungen sind moeglich!");
  sfktmiz(" 1) zusaetzliche magische Verdunkelung");
  sfktmiz(" 2) magische Widerstandsfaehigkeit");
  sfktmiz(" 3) zusaetzliche Innenfuttertaschen");
  sfktmiz(" 4) Erhoehung der Lebenskraft");
  sfktmiz(" 5) Erhoehung der magischen Kraft");
  sfktmiz(" 6) Elementarer Schutz");
  sfktmiz(" 7) Drachenschutz");
  sfktmiz(" 8) heiliger Schutz");
  sfktmiz(" 9) unheiliger Schutz");
  sfktmiz("Es ist immer nur ein Schutz moeglich.");
  sfktmiz("Waehle nun "+anzahl+" der Moeglichkeiten aus (zB '2 5').");
  
  write("Was willst Du waehlen? ");
  input_to("verzauberung_mods2", 0, anzahl, pl, pi);
}

void verzauberung_mods2(string str, int anzahl, object pl, object pi)
{
  string *mods, *tmp, *awd;
  int i;
  
  if(!stringp(str)) 
    return verzauberung_mods(anzahl, pl, pi);
  
  DB(BS("*Eingabe = "+str));
  
  tmp=explode(str, " ");
  
  if(sizeof(tmp)!=anzahl)
    return verzauberung_mods(anzahl, pl, pi);
  
  mods=({});
  awd=({});
  
  for(i=anzahl-1;i>=0;i--)
    switch(tmp[i])
      {
      case "1":
	if(sizeof(awd & ({tmp[i]})))
	  {
	    sfktmiz("Diese Verzauberung ist nur einmal erlaubt!");
	    return verzauberung_mods(anzahl, pl, pi);
	  }
	
	mods+=({"extradark"});
	awd+=({tmp[i]});
	
	break;
      case "2":
	if(sizeof(awd & ({tmp[i]})))
	  {
	    sfktmiz("Diese Verzauberung ist nur einmal erlaubt!");
	    return verzauberung_mods(anzahl, pl, pi);
	  }
	
	mods+=({"durable"});
	awd+=({tmp[i]});
	
	break;
      case "3":
	if(sizeof(awd & ({tmp[i]})))
	  {
	    sfktmiz("Diese Verzauberung ist nur einmal erlaubt!");
	    return verzauberung_mods(anzahl, pl, pi);
	  }
	
	mods+=({"extrapockets"});
	awd+=({tmp[i]});
	
	break;
      case "4":
	if(sizeof(awd & ({tmp[i]})))
	  {
	    sfktmiz("Diese Verzauberung ist nur einmal erlaubt!");
	    return verzauberung_mods(anzahl, pl, pi);
	  }
	
	mods+=({"hpmod"});
	awd+=({tmp[i]});
	
	break;
      case "5":
	if(sizeof(awd & ({tmp[i]})))
	  {
	    sfktmiz("Diese Verzauberung ist nur einmal erlaubt!");
	    return verzauberung_mods(anzahl, pl, pi);
	  }
	
	mods+=({"mpmod"});
	awd+=({tmp[i]});
	
	break;
      case "6":
	if(sizeof(awd & ({"6","7","8","9"})))
	  {
	    sfktmiz("Nur ein Schutz ist erlaubt!");
	    return verzauberung_mods(anzahl, pl, pi);
	  }
	
	mods+=({"druidmagic"});
	awd+=({tmp[i]});
	
	break;
      case "7":
	if(sizeof(awd & ({"6","7","8","9"})))
	  {
	    sfktmiz("Nur ein Schutz ist erlaubt!");
	    return verzauberung_mods(anzahl, pl, pi);
	  }
	
	mods+=({"dragonmagic"});
	awd+=({tmp[i]});
	
	break;
      case "8":
	if(sizeof(awd & ({"6","7","8","9"})))
	  {
	    sfktmiz("Nur ein Schutz ist erlaubt!");
	    return verzauberung_mods(anzahl, pl, pi);
	  }
	
	mods+=({"holymagic"});
	awd+=({tmp[i]});
	
	break;
      case "9":
	if(sizeof(awd & ({"6","7","8","9"})))
	  {
	    sfktmiz("Nur ein Schutz ist erlaubt!");
	    return verzauberung_mods(anzahl, pl, pi);
	  }
	
	mods+=({"unholymagic"});
	awd+=({tmp[i]});
	
	break;
      }
  
  tell_room(MENV, BS(Name()+" nickt."));
  
  call_out("verzauberung_kaestchen", 2, anzahl, pl, pi, mods);
}

void verzauberung_auswahl(string str, object pl, object pi)
{
  if(!objectp(pl)) return;
  if(!present(pl, MENV)) return;
  if(!objectp(pi)) return;
  if(!present(pi, pl)) return;
  
  switch(str)
    {
    case "1":
      sfktmiz("Gut eine Verzauberung also...");
      call_out("verzauberung_mods", 1, to_int(str), pl, pi);
      break;
    case "2":
      sfktmiz("Gut zwei Verzauberungen also...");
      call_out("verzauberung_mods", 1, to_int(str), pl, pi);
      break;
    case "3":
      if(!IS_SEER(pl))
	{
	  sfktmiz("Diese Option ist nur fuer Seher!");
	  
	  write(BS("1) Ein magischer Piwafwi.          (Eine Verzauberung)")+
		BS("2) Ein stark magischer Piwafwi     (Zwei Verzauberungen)")+
		BS("3) Ein ultimativ magischer Piwafwi (Drei Verzauberungen, nur "
		   "Seher)")+
		"1 / 2 / 3 ? ");
	  
	  input_to("verzauberung_auswahl", 0, pl, pi);
	  return; 
	}
      
      sfktmiz("Gut drei Verzauberungen also...");
      call_out("verzauberung_mods", 1, to_int(str), pl, pi);
      
      break;
    default: 
      sfktmiz("Keine Verzauberungen? Auch gut, habe ich weniger zu tun...");
      return;
    }
}

void piwafwi_uebergabe(object who, string *order)
{
  object pi;
  
  if(!objectp(who)) return;
  if(!present(who, MENV)) return;
  if(TP->QueryProp(P_RACE)!="Dunkelelf") return;
  if(!sizeof(order)) return;
  
  pi=clone_object(ARMOUR "piwafwi");
  
  pi->SetOwner(who);
  
  pi->activate(who, order[2]);
  
  if(pi->move(who, M_GET)==ME_TOO_HEAVY)
    {
      sfktmiz("Aber Du kannst den Piwafwi garnicht tragen! Komm wieder, wenn "
	      "Du wieder etwas Platz in Deinem Inventar hast...");
      
      pi->remove(1);
      
      return;
    }
  
  PMASTER->DeleteOrder(getuid(who));
  
  sfktmiz("Hier hast Du Deinen verzauberten Piwafwi! Vergiss nicht, dass "
	  "jeder Dunkelelf nur einen verzauberten Piwafwi haben kann! "
	  "Wenn Du einen neuen haben willst, musst Du Deinen zuerst von mir "
	  "zerstoeren lassen! Frage mich einfach nach 'zerstoerung'."
	  " Falls er Dir jedoch abhanden gekommen ist, kann ich ihn "
	  "Dir gegen Bezahlung wiederbringen. Billig wird es jedoch "
	  "nicht! Frage mich einfach nach 'wiederbringung'.");
  
  tell_room(MENV, BS(who->Name()+" holt sich einen Piwafwi ab."), ({who}));
}

void piwafwi_kaufen_janein(string str)
{
  object pi;
  
  if(str!="ja")
    return sfktmiz("Dann nicht...");
  
  if(TP->QueryMoney()< PREIS_NORMAL)
    return sfktmiz((TP->QueryMoney() ? "Mit zuwenig ":"Ohne ")+
		   "Geld wird das wohl nichts.");
  
  pi=clone_object(ARMOUR "piwafwi");
  pi->SetOwner(TP);
  
  if(pi->move(TP, M_GET)==ME_TOO_HEAVY)
    {
      sfktmiz("Aber wenn Du ueberladen bist, kann ich Dir nichts "
	      "uebergeben.");
      
      pi->remove(1);
      
      return;
    }
  
  sfktmiz("Hier hast Du einen von meinen handgenaehten Piwafwis. "
	  "Achte gut darauf, dann wird er Dir gute Dienste erweisen. "
	  "Ich kann ihn fuer Dich auch reparieren wenn er einmal "
	  "abgetragen ist. Wenn Du ihn verzaubern lassen willst, frage "
	  "mich einfach nach 'Verzauberung'.");
  
  TP->AddMoney(-PREIS_NORMAL);
}

void catch_tell(string str)
{
  string who;
  object pi;
  
  if(!MENV) return;
  if(file_name(MENV)!=ROOM "pinaeherei") return;

  catch(call_other(PMASTER, "???"));
  
  if(find_call_out("sfktmiz")!=-1) return;
  
  str=lower_case(str);
  str=implode(explode(str, "\n"), " ");
  str=regreplace(str, "[^a-z0-9 ]","",1);
  
  if((sscanf(str, "%s sagt mizzri naehe mir bitte einen piwafwi",who)==1) ||
     (sscanf(str, "%s sagt mizzri naeh mir bitte einen piwafwi",who)==1) ||
     (sscanf(str, "%s sagt mizzri naehe mir einen piwafwi",who)==1) ||
     (sscanf(str, "%s sagt mizzri naeh mir einen piwafwi",who)==1))
    {
      who=explode(who," ")[<1]; //Fuer Leute mit Presay
      
      if(!TP || TP!=find_player(who) || !present(TP, MENV)) return;
      
      if(TP->QueryProp(P_RACE)!="Dunkelelf")
	return sfktmiz("Was willst Du? Geh woanders spielen!");
      
      if(present("\npiwafwikaestchen", TP))
	return sfktmiz("Gib mir lieber das Kaestchen...");
      
      if(PMASTER->GetOrder(who))
	return sfktmiz("Aber ich lasse doch gerade einen Piwafwi fuer Dich "
		       "verzaubern! Gedulde Dich, er wird bald fertig sein!");
      
      if(PMASTER->QueryPiwafwi(who))
	return sfktmiz("Aber Dein Piwafwi existiert doch noch. Wenn Du einen "
		       "neuen haben willst, musst Du ihn zuerst von mir "
		       "zerstoeren lassen! Frage mich einfach nach "
		       "'zerstoerung'. Falls er Dir jedoch abhanden gekommen "
		       "ist, kann ich ihn Dir gegen Bezahlung wiederbringen. "
		       "Billig wird es jedoch nicht! Frage mich einfach nach "
		       "'wiederbringung'.");
      
      if(deep_present("piwafwi", TP))
	return sfktmiz("Aber Du hast doch bereits einen Piwafwi bei Dir! "
		       "Willst Du ihn vielleicht verzaubern lassen, oder "
		       "einfach nur reparieren lassen?");
      
      sfktmiz("Fertige Piwafwis habe ich hier an einem der Staender "
	      "haengen. Fuer "+PREIS_NORMAL+" Muenzen kann ich Dir "
	      "einen davon geben.");
      
      if(TP->QueryMoney()< PREIS_NORMAL)
	return sfktmiz("Aber "+(TP->QueryMoney() ? "mit zuwenig ":"ohne ")+
		       "Geld wird das wohl nichts.");
      
      sfktmiz(BS("Willst Du das bezahlen?"));
      write("Ja / Nein ? ");
      
      input_to("piwafwi_kaufen_janein", 0);
      return;
    }
  
  if((sscanf(str, "%s sagt mizzri verzaubere bitte meinen piwafwi",who)==1) ||
     (sscanf(str, "%s sagt mizzri verzaubere meinen piwafwi",who)==1) ||
     (sscanf(str, "%s sagt mizzri verzaubere mir bitte einen piwafwi",who)==1))
    {
      who=explode(who," ")[<1]; //Fuer Leute mit Presay
      
      if(!TP || TP!=find_player(who) || !present(TP, MENV)) return;
      
      if(TP->QueryProp(P_RACE)!="Dunkelelf")
	return sfktmiz("Was willst Du? Geh woanders spielen!");
      
      if(!objectp(pi=present("piwafwi", TP)))
	return sfktmiz("Ohne Piwafwi brauchen wir garnicht erst anfangen...");
      
      if(stringp(pi->QueryOwner()) && pi->QueryOwner()!=getuid(TP))
	return sfktmiz("Aber dieser Piwafwi gehoert doch jemandem!");
      
      if(pi->QueryMagic())
	return sfktmiz("Dein Piwafwi scheint bereits magisch zu sein. Wenn "
		       "Du einen neuen willst, musst Du diesen hier erst "
		       "zerstoeren lassen! Frage mich einfach nach "
		       "'zerstoerung'.");
      
      if(PMASTER->GetOrder(getuid(TP)))
	return sfktmiz("Fuer Dich wird bereits ein Piwafwi verzaubert. Wenn "
		       "er fertig ist, kannst Du ihn Dir abholen. Sag mir "
		       "einfach 'Mizzri ich will meinen Piwafwi abholen'.");
      
      sfktmiz("Folgende Verzauberungen habe ich im Angebot...");

      tell_room(MENV, BS(Name()+" zaehlt "+TP->name(WEM)+" die Punkte auf."),
		({TP}));
      
      write(BS("1) Ein magischer Piwafwi.          (Eine Verzauberung)")+
	    BS("2) Ein stark magischer Piwafwi     (Zwei Verzauberungen)")+
	    BS("3) Ein ultimativ magischer Piwafwi (Drei Verzauberungen, nur "
	       "Seher)")+
	    "1 / 2 / 3 ? ");
      
      input_to("verzauberung_auswahl", 0, TP, pi);
      return;      
    }

  if(sscanf(str, "%s sagt mizzri ich will meinen piwafwi abholen",who)==1)
    {
      string *order;
      
      who=explode(who," ")[<1]; //Fuer Leute mit Presay
      
      if(!TP || TP!=find_player(who) || !present(TP, MENV)) return;
      
      if(TP->QueryProp(P_RACE)!="Dunkelelf")
	return sfktmiz("Was willst Du? Geh woanders spielen!");
      
      if(!sizeof(order=PMASTER->GetOrder(getuid(TP))))
	return sfktmiz("Aber fuer Dich habe ich doch gar keinen Auftrag!");
      
      if(order[0]> time())
	return sfktmiz("Dein Piwafwi ist noch nicht fertig!");
      
      sfktmiz("Dein Piwafwi ist fertig, einen Moment...");
      
      call_out("piwafwi_uebergabe", 1, TP, order);
    }
  
}

void give_notify(object ob)
{
  if(!ob->id("\npiwafwikaestchen"))
    {
      sfktmiz("Nein, danke!");
      drop_obj(ob);
      return;
    }
  
  if(!stringp(ob->QueryOwner()))
    {
      sfktmiz("Danke");
      
      remove_kaestchen(ob);
      return;
    }
  
  if(ob->QueryOwner()!=getuid(TP))
    {
      sfktmiz("Was soll denn das? Das ist ja nicht Dein Kaestchen! "
	      "Hast Du es etwa "+CAP(ob->QueryOwner())+" gestohlen?");
      
      remove_kaestchen(ob);
      return;
    }
  
  sfktmiz("Gut, mal sehen...");
  
  call_out("check_kaestchen", 2, TP, ob);
}

void init()
{
  ::init();
  
  if(TP && interactive(TP) && TP->QueryProp(P_RACE)=="Dunkelelf")
    call_out("hallo", 1);
}

void hallo()
{
  object p;
  
  if(TP && MENV && present(TP, MENV))
    if(!objectp(p=present("piwafwi", TP)))
      return write(BS(Name(WER)+" blickt Dich an.")+
		   BS(Name(WER)+" sagt: Willst Du vielleicht einen Piwafwi?")+
		   BS(Name(WER)+" sagt: Jeder Dunkelelf sollte einen Piwafwi "
		      "haben!")+
		   BS(Name(WER)+" sagt: Du brauchst nur zu sagen: 'Mizzri "
		      "naeh mir bitte")+
		   BS(Name(WER)+" sagt: einen Piwafwi'."));
    else
      if(!p->QueryMagic())
	return write(BS(Name(WER)+" blickt Dich an.")+
		     BS(Name(WER)+" sagt: Willst Du Deinen Piwafwi nicht "
			"verzaubern lassen?"));
      else
	if(p->QueryProp(P_DAMAGED) >= 2)
	  return write(BS(Name(WER)+" blickt Dich an.")+
		       BS(Name(WER)+" fragt Dich: Wie siehst Du denn aus?")+
		       BS(Name(WER)+" fragt Dich: Soll ich Deinen Piwafwi "
			  "reparieren?"));
}
