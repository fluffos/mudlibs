/*
  Hochzeitszeremonie
  Kleid der satanischen Frau
*/

#pragma strict_types;

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Brautkleid aus schwarzer Seide");
  SetProp(P_LONG,
	  BS("Dieses Brautkleid wurde fuer eine maechtige "
	     "Dunkelelfenpriesterin aus pechschwarzer Seide gefertigt. "
	     "Das eng geschnittene Oberteil mit dem tiefen Ausschnitt "
	     "und den langen Aermeln, ist mit Silberstickereien uebersaeht "
	     "und mit Perlen aus Obsidian verziert. Der schwarz gehaltene "
	     "Unterteil besteht hauptsaechlich aus Falten, an dessen Kanten "
	     "es leicht gruenlich schimmert."));

  SetProp(P_INFO, 
	  BS("Dieses Brautkleid wurde speziell fuer eine "
	     "Dunkelelfenpriesterin gefertigt, aber auch andere "
	     "Frauen koennen es tragen, wenn sie wuerdig sind und von "
	     "satanischem Charakter."));

  SetProp(P_NAME, "Brautkleid");
  SetProp(P_NAME_ADJ, "seiden");
  AddAdjective(({"seidenes","seidenen"}));

  SetProp(P_GENDER, NEUTER);
  AddId(({"kleid", "seidenkleid", "brautkleid", KLEIDUNG}));
  
  AddDetail(({"seide", "spinnenseide"}),
	    "Feinste Spinnenseide. Sie schimmert leicht, wenn Licht "
	    "darauffaellt.");

  AddDetail(({"falten", "unterteil"}),
	    "Der Unterteil der Brautkleides ist bodenlang, faltig und weit "
	    "geschnitten. Er raschelt bei jeder Bewegung ganz leise.");
  
  AddDetail(({"oberteil", "ausschnitt"}),
	    "Das enganliegende Oberteil mit seinem tiefen Ausschnitt und "
	    "seinen langen Aermel ist ueber und ueber mit Silberstickereien "
	    "und Perlen aus Obsidian bedeckt.");

  AddDetail(({"stickereien", "stickerei", "silberstickerei", 
		"silberstickereien", "perlen", "perle", "obsidian"}),
	    "Die Silberstickereien und die Perlen aus Obsidian bilden ein "
	    "eigenartiges Muster.");
  
  AddDetail(({"muster", "netz", "spinnennetz", "struktur"}),
	    "Das Muster erinnert an die Struktur eines Spinnennetzes.");

  AddDetail(({"aermel", "aermeln"}),
	    "In die Seide der langen Aermel sind silberne Stickereien "
	    "eingearbeitet.");

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 20);
  SetProp(P_MATERIAL, ([MAT_SILK:90, MAT_OBSIDIAN:5, MAT_SILVER:5]));
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 1200);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
  SetProp(P_WEAR_RESTRICTIONS, 
	  ([SR_EXCLUDE_RACE:({"Fee","Elf"}), 
	    P_GENDER:FEMALE,
	    SR_GOOD:-1000]));

  SetProp(P_REMOVE_FUNC, ME);
}

int RemoveFunc(object me, int silent)
{
  if(!HZM->Hochzeit()) return 1;
  if(!QueryWorn()) return 1;

  if(!silent)
    tell_object(QueryWorn(), BS("Nicht waehrend der Hochzeit!"));
  
  return 0;
}
