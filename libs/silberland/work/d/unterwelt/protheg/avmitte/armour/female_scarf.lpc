/*
  Hochzeitszeremonie
  Schal der Frau
*/

#pragma strict_types;

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Brautschleier aus Seide");
  SetProp(P_LONG,
	  BS("Ein Brautschleier aus silbergrauer Spinnenseide. Das "
	     "Gewebe ist so fein, dass es fast schon wie ein Nebel "
	     "aussieht. Mit einem silbernen Stirnreif kann man ihn "
	     "am Kopf befestigen."));

  SetProp(P_INFO, 
	  BS("Dieser Brautschleier wurde speziell fuer eine "
	     "Dunkelelfenpriesterin gefertigt, aber auch andere "
	     "Frauen koennen ihn tragen, wenn sie wuerdig und von "
	     "satanischem Charakter sind."));

  SetProp(P_NAME, "Brautschleier");
  SetProp(P_NAME_ADJ, "silbergrau");
  AddAdjective(({"silbergrauer","silbergrauen"}));

  SetProp(P_GENDER, MALE);
  AddId(({"schleier", "brautschleier", KLEIDUNG}));
  
  AddDetail(({"seide","spinnenseide"}),
	    "Feinste Spinnenseide. Sie schimmert leicht, wenn Licht "
	    "darauffaellt.");

  AddDetail(({"gebilde","nebel"}),
	    "Nein, der Schleier ist doch aus Seide, aber da sie so duenn und "
	    "fein gewoben ist, scheint er wie ein Gebilde aus Nebel. Der "
	    "kleinste Lufthauch laesst ihn leicht wehen.");

  AddDetail(({"reif","stirnreif"}),
	    "Ein glatter, silberner Stirnreif haelt den Brautschleier fest. "
	    "Ein kleines Muster ziert dessen Vorderseite.");

  AddDetail(({"vorderseite","muster","zeichen","hauszeichen"}),
	    "Das Muster auf der Vorderseite scheint eines der Hauszeichen von "
	    "Dhrkion zu sein.");
  
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_SILK:90, MAT_OBSIDIAN:5, MAT_SILVER:5]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_WEAR_RESTRICTIONS, 
	  ([SR_EXCLUDE_RACE:({"Fee","Elf"}), 
	    P_GENDER:FEMALE,
	    SR_GOOD:-1000]));

  SetProp(P_REMOVE_FUNC, ME);
}

int RemoveFunc(object me, int silent)
{
  if(!HZM->Hochzeit()) return 1;
  if(!QueryWorn()) return 1;

  if(!silent)
    tell_object(QueryWorn(), BS("Nicht waehrend der Hochzeit!"));
  
  return 0;
}
