/*
  Hochzeitszeremonie
  Hose des Mannes
*/

#pragma strict_types;

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine schwarze Seidenhose");
  SetProp(P_LONG,
	  BS("Die Hose besteht aus feiner, schwarzer Spinnenseide und "
	     "ist ein Teil der Hochzeitsbekleidung fuer Dunkelelfenmaenner. "
	     "Sie ist recht schlicht gehalten, lediglich die Seitennaehte "
	     "sind mit einem Muster in smaragdglaenzender Seide bestickt."));

  SetProp(P_INFO, 
	  BS("Diese Seidenhose wurde speziell fuer Dunkelelfenmaenner "
	     "gefertigt, aber auch andere Rassen koennen sie tragen, da die "
	     "Seide recht nachgiebig zu sein scheint."));

  SetProp(P_NAME, "Seidenhose");
  SetProp(P_NAME_ADJ, "schwarz");
  AddAdjective(({"schwarze","schwarzen"}));

  SetProp(P_GENDER, FEMALE);
  AddId(({"hose", "seidenhose", KLEIDUNG}));
  
  AddDetail(({"seide","spinnenseide"}),
	    "Feinste Spinnenseide. Sie schimmert leicht, wenn Licht "
	    "darauffaellt.");

  AddDetail(({"bekleidung","hochzeitsbekleidung"}),
	    "Die Hochzeitsbekleidung fuer Dunkelelfenmaenner besteht aus "
	    "einem Hemd, einer Hose und einem Umhang.");
  
  AddDetail(({"naehte","seitennaehte"}),
	    "Die Seitennaehte der Hose sind mit einem magisch, "
	    "smaragdglaenzendem Muster verziert.");
  
  AddDetail(({"muster","netz","spinnennetz"}),
	    "Das Muster erinnert entfernt an das Netz einer Spinne.");
  
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_SILK:90, MAT_MAGIC:10]));
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
  SetProp(P_WEAR_RESTRICTIONS, 
	  ([SR_EXCLUDE_RACE:({"Fee","Elf"}), 
	    P_GENDER:MALE,
	    SR_GOOD:0]));

  SetProp(P_REMOVE_FUNC, ME);
}

int RemoveFunc(object me, int silent)
{
  if(!HZM->Hochzeit()) return 1;
  if(!QueryWorn()) return 1;
  
  if(!silent)
    tell_object(QueryWorn(), BS("Nicht waehrend der Hochzeit!"));
  
  return 0;
}

