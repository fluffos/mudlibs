#pragma strong_types;

#include "../def.h"

inherit "/std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein schwarze Robe");
  SetProp(P_LONG,
	  BS("Eine lange, schwarze Robe mit einer kleinen Silberschnalle, "
	     "wie sie die Tempelwaechter von Ardulvhier tragen."));
  
  SetProp(P_NAME, "Robe");
  SetProp(P_NAME_ADJ, "schwarz");
  SetProp(P_GENDER, FEMALE);
  AddId("robe");
  AddAdjective(({"schwarz", "schwarze", "schwarzen"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_COTTON:99, MAT_SILVER:1]));
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 700);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_UNHOLY:1]));
  
  SetProp(P_WEAR_TEXT,
	  ({"Du haengst Dir die schwarze Robe um und verschliesst die "
	      "Silberschnalle.\n",
	      " haengt sich eine schwarze Robe um.\n"}));

  AddDetail(({"schnalle","silberschnalle"}),
	    "Die Silberschnalle fixiert die Robe auf den Schultern des "
	    "Traegers.");
  
  AddDetail(({"schultern","schulter"}),
	    "Sofern man Schultern hat...");
}
