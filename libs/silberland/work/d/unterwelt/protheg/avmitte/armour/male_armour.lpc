/*
  Hochzeitszeremonie
  Hemd des Mannes
*/

#pragma strict_types;

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein schwarzes Seidenhemd");
  SetProp(P_LONG,
	  BS("Dieses Hemd wurde aus feinster, schwarzer Spinnenseide "
	     "gefertigt. Es wurde fuer nur einen Zweck geschneidert "
	     "und zwar fuer die Hochzeit eines Dunkelelfenmannes. "
	     "Grosse Knoepfe aus Perlmut zieren das Hemd und oben wurde "
	     "eine Halskrempe aus Stoff angenaeht. Die linke Brustseite "
	     "ziert ein merkwuerdiges Zeichen."));

  SetProp(P_INFO, 
	  BS("Dieses Seidenhemd wurde speziell fuer Dunkelelfenmaenner "
	     "gefertigt, aber auch andere Rassen koennen es tragen, da "
	     "die Seide recht nachgiebig zu sein scheint."));

  SetProp(P_NAME, "Seidenhemd");
  SetProp(P_NAME_ADJ, "schwarz");
  AddAdjective(({"schwarzes","schwarzen"}));

  SetProp(P_GENDER, NEUTER);
  AddId(({"hemd", "seidenhemd", KLEIDUNG}));

  AddDetail(({"seide", "spinnenseide"}),
	    "Feinste Spinnenseide. Sie schimmert leicht, wenn Licht "
	    "darauffaellt.");

  AddDetail(({"linke seite", "seite", "brustseite", "linke brustseite"}),
	    "Auf der linken Brustseite wurde ein seltsam, verschlungenes "
	    "Zeichen in das Hemd gestickt. Vermutlich eines der bedeutenden "
	    "Hauszeichen Dhrkions.");

  AddDetail(({"hauszeichen","zeichen"}),
	    "Jede Dunkelelfenfamilie in Dhrkion hat ihr eigenes Hauszeichen.");

  AddDetail(({"knopf","knoepfe"}),
	    "Knoepfe aus kostbarem Perlmut verzieren das Seidenhemd.");

  AddDetail(({"kragen","krempe","stoff","stoffkrempe"}),
	    "Der Kragen des Seidenhemdes wurde mit einer eleganten "
	    "Stoffkrempe erweitert.");

  AddDetail(({"zweck","hochzeit"}),
	    "Dieses Seidenhemd ist nur fuer einen Zweck gefertigt worden, "
	    "fuer die Hochzeit eines Dunkelelfenmannes.");

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 20);
  SetProp(P_MATERIAL, ([MAT_SILK:90, MAT_PEARL:5, MAT_CLOTH:5]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  SetProp(P_WEAR_RESTRICTIONS, 
	  ([SR_EXCLUDE_RACE:({"Fee", "Elf"}), 
	    P_GENDER:MALE,
	    SR_GOOD:0]));
  
  SetProp(P_REMOVE_FUNC, ME);
}

int RemoveFunc(object me, int silent)
{
  if(!HZM->Hochzeit()) return 1;
  if(!QueryWorn()) return 1;
  
  if(!silent)
    tell_object(QueryWorn(), BS("Nicht waehrend der Hochzeit!"));
  
  return 0;
}

