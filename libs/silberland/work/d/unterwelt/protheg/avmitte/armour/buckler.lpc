#pragma strong_types;

#include "../def.h"

inherit "/std/armour";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein Buckler aus Mithril");
  SetProp(P_LONG,
    BS("In Deinen Haenden haelst Du einen stachelbesetzten Buckler aus "
    "geschwaerztem Mithril. Der Schild ist vollkommen rund und besitzt, "
    "bis auf ein paar Stacheln keine weiteren Verzierungen."));

  SetProp(P_NAME, "Buckler");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "stachelbesetzt");
  AddId(({"buckler","mithrilbuckler","\ntempelwaechterschild"}));
  
  SetProp(P_ARMOUR_TYPE, AT_SHIELD);
  SetProp(P_AC, 20);
  SetProp(P_MATERIAL, ([MAT_MITHRIL:80, MAT_MISC_UNHOLY:20]));
  SetProp(P_WEIGHT, 950);
  SetProp(P_VALUE, 3000);
  SetProp(P_QUALITY_DECAY, 220);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:15, SR_GOOD:0]));

  AddDetail(({"mithril"}),
    "Obwohl dieser Schild sicher schon viele Jahre alt ist, hat das Mithril "
    "noch immer den gleichen silbrigen Glanz wie am Tag seiner Herstellung.");

  SetProp(P_DEFEND_FUNC, ME);
}

int DefendFunc(mixed dam_type, int spell, object enemy)
{
  object pl;
  
  if((!enemy->QueryProp(P_WEAPON)) && (!spell) &&
     (!enemy->QueryArmours(AT_GLOVE)) && (random(100) < 10) && 
     (enemy->QueryAttribute(A_DEX) < pl->QueryAttribute(A_DEX)))
    {
      tell_object(enemy, 
	  BS("Unvorsichtig wie Du bist, stichst Du Dich an dem Buckler!"));

      tell_object(pl,
	  BS(enemy->name(WER)+" sticht sich an Deinem Buckler."));
      say(BS(enemy->name(WER)+" sticht sich an "+pl->Name(WESSEN)+
	     " Buckler."), ({pl, enemy}));

      enemy->Defend(random(2 * QueryProp(P_AC))+random(15),
		    DT_PIERCE, ([SP_SHOW_DAMAGE:1]), pl);
  }

  return 0;
}
