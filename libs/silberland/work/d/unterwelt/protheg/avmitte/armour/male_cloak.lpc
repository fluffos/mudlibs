/*
  Hochzeitszeremonie
  Umhang des Mannes
*/

#pragma strict_types;

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein schwarzer wallender Seidenumhang");
  SetProp(P_LONG,
	  BS("Ein langer, wallender, edel aussehender Seidenumhang "
	     "aus pechschwarzer Spinnenseide. Bis auf die silberne "
	     "Spange, die als Verschluss um den Hals gilt, ist er "
	     "voellig schmucklos. Das laesst ihn aber umso eleganter "
	     "wirken."));

  SetProp(P_INFO, 
	  BS("Diese Seidenumhang wurde speziell fuer Dunkelelfenmaenner "
	     "gefertigt, aber auch andere Rassen koennen ihn tragen, da "
	     "die Seide recht weit geschnitten zu sein scheint."));

  SetProp(P_NAME, "Seidenumhang");
  SetProp(P_NAME_ADJ, "schwarz");
  AddAdjective(({"schwarzer","schwarzen"}));

  SetProp(P_GENDER, MALE);
  AddId(({"umhang", "seidenumhang", KLEIDUNG}));

  AddDetail(({"seide","spinnenseide"}),
	    "Feinste Spinnenseide. Sie schimmert leicht, wenn Licht "
	    "darauffaellt.");

  AddDetail(({"spange","verschluss"}),
	    "Am oberen Ende des Umhanges haengt eine silberne Spange, mit der "
	    "der Umhang um den Hals verschlossen wird. Die Form der Spange "
	    "erinnert Dich an ein Hauszeichen einer maechtigen Familie in "
	    "Dhrkion.");
  
  AddDetail(({"zeichen","hauszeichen"}),
	    "Du erinnerst Dich, es in Dhrkion bereits einmal gesehen zu "
	    "haben!");
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_SILK:95, MAT_SILVER:5]));
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 800);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
  SetProp(P_WEAR_RESTRICTIONS, 
	  ([SR_EXCLUDE_RACE:({"Fee", "Elf"}), 
	    P_GENDER:MALE,
	    SR_GOOD:0]));

  SetProp(P_REMOVE_FUNC, ME);
}

int RemoveFunc(object me, int silent)
{
  if(!HZM->Hochzeit()) return 1;
  if(!QueryWorn()) return 1;
  
  if(!silent)
    tell_object(QueryWorn(), BS("Nicht waehrend der Hochzeit!"));
  
  return 0;
}

