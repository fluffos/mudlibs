/*
  Portal aus dem Dschungel, in den Dschungel

*/

#include "../def.h"

inherit MOST "std_room";

#define ANSCHLUSS ({"/d/dschungel/protheg/neutijara/room/hoehlenportal", \
                    "/d/kristallwald/protheg/av/room/hoehlenportal"})

#define DHRKION "/d/unterwelt/zordan/dhrkion/master/dhrkion"

#define ERRORS ({"/d/unterwelt/zordan/schleim/room/weg1", \
                 "/d/unterwelt/basics/central/room/01-09-01"})

nosave int next;

string symbole()
{
  if(TP->QueryProp(P_RACE)=="Dunkelelf")
    return "Folgendes kannst Du entziffern: 'Dschungel' und 'Kristallwald'\n";
  else
    return "Du kannst die Symbole leider nicht entziffern.\n";
}

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Stalagmitenfeld");
  SetProp(P_INT_LONG,
	  BS("Ein wunderschoener Ausblick bietet sich Euch hier. Vor Euch das "
	     "Ufer eines gewaltigen Sees und hinter Euch ein kreisrundes, "
	     "in einen gewaltigen Stalagmiten eingearbeitetes Portal. Weiter "
	     "suedlich erkennt Ihr einen weiteren gewaltigen Stalagmiten, der "
	     "jedoch in seiner Form von den anderen abweicht. Rund um ihn "
	     "herum breitet sich ein weites Gelaende aus."));

  AddDetail(({"ausblick","blick","hoehle"}),
	    "Ihr lasst Euren Blick schweifen... Soweit Ihr erkennen koennt, "
	    "liegt im Norden ein gewaltiger See und nach Sueden hin "
	    "breitet sich ein ebenes Gelaende aus, in dessen Mitte ein "
	    "riesiger, diskusfoermiger Stalagmit zu sein scheint.");

  AddDetail(({"seeufer","ufer"}),
	    "Noerdlich Eures Standpunktes erstreckt sich das Seeufer "
	    "weit nach Osten und nach Sueden hin.");

  AddDetail(({"tempelgelaende","gelaende"}),
	    "Nach Sueden hin breitet sich das Tempelgelaende von "
	    "Ardulvhier aus.");

  AddDetail(({"see"}),
	    "Weiter im Norden erkennt Ihr die spiegelglatte Oberflaeche "
	    "eines Sees.");

  AddDetail(({"oberflaeche","seeoberflaeche"}),
	    "Von hier aus koennt Ihr nur sehr wenig erkennen.");

  AddDetail(({"uferguertel","ufer","seeufer","seeuferguertel"}),
	    "Der See im Norden wird von einem recht breiten Uferguertel "
	    "abgegrenzt.");

  AddDetail(({"ardulvhier","stadt","dunkelelfenstadt","zentrum"}),
	    "Nach Sueden hin eroeffnet sich Euch das Zentrum der Stadt "
	    "Ardulvhier.");

  AddDetail(({"portal","steinportal"}),
	    "Ein uraltes Portal aus Stein. An manchen Stellen koennt Ihr "
	    "bereits deutliche Alterungserscheinungen erkennen. Es ist mit "
	    "allerlei seltsamen Symbolen uebersaet.");

  AddDetail(({"riss","stelle","stellen","alterungserscheinung","risse",
		"alterungserscheinungen"}),
	    "Das Portal muss hier schon seit sehr langer Zeit stehen, denn "
	    "es weist deutliche Alterungserscheinungen in Form von Rissen "
	    "auf.");

  AddDetail(({"stein"}),
	    "Der Stein des Portals scheint nicht aus dieser Hoehle zu "
	    "stammen, denn er sieht volkommen anders aus.");

  AddDetail(({"zeit","ewigkeit"}),
	    "Das Steinportal muss hier schon eine Ewigkeit herumstehen!");

  AddDetail(({"boden"}),
	    "Der Boden ist uebersaet mit kleinen, spitzen Stalagmiten. Ihr "
	    "muesst aufpassen wo Ihr hintretet, doch da seht Ihr vor Euch "
	    "einen kleinen, gepflasterten Weg, der von dem Portal weg "
	    "fuehrt.");

  AddDetail(({"decke","hoehlendecke"}),
	    "Die Decke der Hoehle befindet sich weit ueber Euch. Aber Ihr "
	    "seid Euch sicher, dass sie mit Stalagtiten uebersaet ist.");

  AddDetail(({"stalagtit","stalagtiten"}),
	    "Die haengen irgendwo weit ueber Euch.");

  AddDetail(({"weg"}),
	    "Ein gepflasterter Weg fuehrt zwischen den spitzen Stalagmiten "
	    "hindurch nach Sueden.");

  AddDetail(({"symbol","symbole","schriftzug"}),
	    "Die Symbole stellen einen Schriftzug in dunkelelfischer Sprache "
	    "dar.");

  AddDetail(({"sprache","dunkelelfensprache","dunkelelfenschrift"}),
	    ([
	      "dunkelelf": 
	      "Die Symbole sollten fuer Euch kein Hinderniss darstellen!",
	      0:
	      "Sie sieht sehr komplex aus. Ihr werdet sie wohl nicht "
	      "entziffern koennen!"]));

  AddDetail(({"wand","waende","hoehlenwand","hoehlenwaende","steinwand",
		"steinwaende"}),
	    "Ihr steht hier auf weitgehend offenem Gelaende, die "
	    "Hoehlenwaende befinden sich in einiger Entfernung.");

  AddDetail(({"form"}),
	    "Die Form des Stalagmites aehnelt eher der eines Diskus.");

  AddDetail(({"mitte","stalagmit","diskuss","diskus"}),
	    "Die Mitte des Tempelgelaendes wird von einem gewaltigen, "
	    "diskusfoermigen Stalagmiten eingenommen.");

  AddDetail(({"entfernung"}),
	    "Ihr befindet Euch fast in der Mitte der Hoehle, daher befinden "
	    "sich die Hoehlenwaende in einiger Entfernung zu Euch.");

  AddDetail(({"feld","stalagmitenfeld","stalagmiten"}),
	    "Rund um Euch herum bilden hunderte kleiner, aeusserst spitzer "
	    "Stalagmiten ein Feld.");
  
  AddReadDetail(({"symbol","symbole","schriftzug"}), CLOSURE(symbole));

  AddSound(DEFAULT_SOUND,
	   "Im Norden hoert Ihr entfernt das Plaetschern von Wasser...");
  
  AddSound(({"plaetschern","geplaetscher","wasser"}),
	   "Weiter im Norden duerfte sich, dem Geplaetscher nach, ein See "
	   "befinden.");
  
  AddSmell(DEFAULT_SMELL,
	   "Der feine Geruch von Weihrauch weht Euch aus dem Sueden her "
	   "entgegen.");
  
  AddSmell(({"rauch","weihrauch","geruch"}),
	   "Aus dem Sueden her weht Euch der Geruch von Weihrauch entgegen.");

  AddExit(({"sueden","weg"}), 
	  "einen Weg entlang nach Sueden#" ROOM "tgel_0_2_0");

  AddExit(({"norden","osten","suedwesten","westen","nordosten","suedosten",
	      "nordwesten"}), 
	  ([EX_DEST:ROOM "portal", EX_TESTFUNC:"autsch"]));

  AddCmd(({"betrete","betritt","betret"}), "tport" );
  AddCmd(({"folge","folg"}), "folgen");
  
  Licht("dunkel");
  Umgebung("warm", TT_CAVE, 1);
  
  next=0;
}

nosave int folgen(string str)
{
  notify_fail("Wem wollt Ihr folgen?\n");
  if(!str) return 0;

  if(str=="weg"||str=="weg nach sueden")
    {
      TP->command_me("weg");
      return 1;
    }

  return 0;
}

nosave int tport(string str)
{
  int tmp;
  
  notify_fail("Was wollt Ihr denn betreten?\n" );
  if(!str) return 0;
  
  if(str=="portal"||str=="kreisrundes portal"||str=="steinportal")
    {
      if(TP->QueryProp(P_SP)<=20)
        return 
	  write("Ihr naehert Euch dem Portal, doch es passiert nichts...\n"
		"Ihr seid wohl nicht maechtig genug!\n"), 1;

      if(next>time())
	return write(BS("Das Portal ist vor kurzem benutzt worden!")+
		     BS("Du musst Dich kurz gedulden, bis sich die Magie "
			"erholt hat!")), 1;
      
      if(TP->QueryProp(P_ALIGN)>500)
        {
          write("Ihr naehert Euch dem Portal, als es ploetzlich zu pulsieren "
                "beginnt!\nDann hoert Ihr nur noch einen Knall und dann tiefe "
                "Schwaerze...\n");

          say(BS(TP->Name()+" will das Portal betreten, doch eine gewaltige "
		 "Druckwelle befoerdert "+TP->QueryPronoun(WEN)+
		 " ins Reich der Traeume...\n"),({TP}));

          //TP->AddHp(-(TP->QueryProp(P_HP)-5));
	  TP->SetProp(P_HP, 5);

          TP->SetProp(P_PARALYZED, 
            ([PARALYZE_TIME: 5, 
	    PARALYZE_MSG: "Tiefste Schwaerze umgibt Euch...\n",
	    PARALYZE_END: "Langsam erwacht Ihr aus Eurer Ohnmacht...\n"]));
	  
	  next=time()+4+random(3);
	  
          return 1;
        }

      if(DHRKION->getfeindkills(TP) >= 500)
	return write(BS("Du naeherst Dich dem Portal, doch es passiert "
			"nichts...")+
		     BS("Rein instinktiv weisst Du, dass Du als ewiger "
			"Feind von Dhrkion auch in Ardulvhier nicht "
			"willkommen bist!")), 1;
      
      if(TP->QueryProp(P_RACE)=="Dunkelelf")
        TP->AddSp(-5);
      else
	{
	  TP->AddSp(-20);

	  if(random(1000) > 777)
	    {
	      write(BS("Ihr naehert Euch dem Portal, als es anfaengt "
		       "blaeulich zu schimmern. In der Mitte bildet sich "
		       "ein waberndes Etwas, doch das kuemmert Euch nicht "
		       "mehr, denn Ihr betrettet gerade das Portal...")+
		    BS("Ein kalter Schauer laeuft Euch den Ruecken hinab. "
		       "Irgendwas schlimmes ist gerade passiert!!!"));

	      say(BS(TP->Name()+" durchschreitet das Portal..."));
	      
	      tmp=random(sizeof(ERRORS));

	      /*
		if(file_size(ERRORS[tmp]+".lpc") < 0)
		TP->move(ME, M_NOCHECK|M_TPORT|M_NO_ATTACK);
		else
	      */
	      
	      TP->move(ERRORS[tmp], M_NOCHECK|M_TPORT|M_NO_ATTACK);
	      
	      return 1;
	    }
	}
      
      write(BS("Ihr naehert Euch dem Portal, als es anfaengt blaeulich zu "
	       "schimmern. In der Mitte bildet sich ein waberndes Etwas, "
	       "doch das kuemmert Euch nicht mehr, denn Ihr betretet "
	       "gerade das Portal und lasst Euch von ihm in eine andere "
	       "Dimension saugen..."));

      say(BS(TP->Name()+" durchschreitet das Portal..."));

      TP->move(ANSCHLUSS[random(2)], M_NOCHECK|M_TPORT|M_NO_ATTACK);

      next=time()+4+random(3);

      return 1;
    }

  return 0;       
}

varargs string GetExits(object viewer)
{
  return "";
}

nosave int autsch(string str)
{
  object *boots;

  if(sizeof(boots=TP->QueryArmours(AT_BOOT)))
    {
      write(BS("Nicht einmal mit "+boots[0]->name(WEM)+" koennt Ihr das "
	       "spitze Stalagmitenfeld ueberqueren!"));
      boots[0]->TakeFlaw(([DT_PIERCE:150]));
    }
  else
    {
      write(BS("Ihr macht ein paar Schritte, als Euch der stechende "
	       "Schmerz der kleinen, aber spitzen Stalagmiten in den "
	       "Fuessen beinahe uebermannt und Ihr zum Portal "
	       "zuruecktaumelt."));
      
      SetProp(P_KILL_NAME, 
	      "Wildes Herumrennen und eine schmerzhafte Erfahrung");
      
      TP->do_damage(10+(random(20)));

      if(TP->QueryProp(P_GHOST)) 
	return 0;
    }
  
  return 1;
}
