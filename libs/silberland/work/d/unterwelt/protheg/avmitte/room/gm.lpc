/*
  Verwaltet das Aendern der Gesinnung beim Verehren Lloths in den Schreinen.
  Diese Datei muss von den angeschlossenen Schreinen inheritet werden

  Tyron, 25.05.2001              

  PROtheG, 26.02.2002
*/

#include "../def.h"
#include "../func.h"

#define OBERGRENZE -1500
#define GMSAVE LOG "gmsave"

//Mapping, welcher Spieler in welchem Schrein schon wie oft Lloth verehrt hat.
mapping Bet_pl; 
string *alle_vier;


void create()
{
  if(is_clone(ME)) return destruct(ME);
  
  Bet_pl=([]);
  alle_vier=({});
  
  SUID;
  
  restore_object(GMSAVE);
}

nosave void rotate_mapping()
{
  int i;
  string *index;

  if(!sizeof(index=m_indices(Bet_pl))) return;

  for(i=sizeof(index)-1; i>=0; i--)
    if(Bet_pl[index[i], 0] > 0)
      {
	Bet_pl[index[i], 0]++;
	
	if(Bet_pl[index[i], 0] >= 3)
	  Bet_pl=m_delete(Bet_pl, index[i]);
      }
}

void reset()
{
  rotate_mapping();
}

void Aendere_Gesinnung(object player, int schrein)
{
  int align;
  int *fl_beten;
  string pl;
  
  //Falls "player" kein Objekt oder Spieler nicht mehr im Raum, Funktion abbrechen.
  if((!player) || (!objectp(player)) || (ENV(player) != PO)) return;
  
  pl=getuid(player);
  
  if((!schrein) || (schrein > 4)) return;

  if(!member(Bet_pl, pl))
    Bet_pl+=([pl: 0; 0; 0; 0; 0]);
    
  Bet_pl[pl, schrein]++;
  
  if(Bet_pl[pl, schrein] < 4)
    {
      align=player->QueryProp(P_ALIGN);
      
      if(align > OBERGRENZE)
	player->SetProp(P_ALIGN, align-10-random(20));
      
      if((Bet_pl[pl, SCHREIN_RISS])   && (Bet_pl[pl, SCHREIN_SPINNE]) &&
	 (Bet_pl[pl, SCHREIN_BECKEN]) && (Bet_pl[pl, SCHREIN_TAFEL])  &&
	 (!Bet_pl[pl, 0]))
	{
	  if(align > OBERGRENZE)
	    player->SetProp(P_ALIGN, align-100-random(26));

	  DB("*** Gesinnungsmaster AV: "+CAP(pl)+" hat alle 4 Schreine.\n");
	  
	  if(member(alle_vier, pl)==-1)
	    {
	      alle_vier+=({pl});
	      
	      save_object(GMSAVE);
	    }
	  
	  Bet_pl[pl, 0]++;
	}
    }  
}

public int QueryAll4(string pl)
{
  if(member(alle_vier, pl)==-1)
    return 0;
  
  return 1;
}

mapping dumpvars()
{
  return Bet_pl;
}
