/*
  Hochzeitszeremonie
  der Vorraum des unheiligen Tempels
*/

#include "../def.h"

inherit MOST "std_room";

#define CT(x) sprintf("%65|s\n", x)

nosave string instruktionen();
nosave string verzeichnis();

void create() 
{
  ::create();
  
  SetProp(P_INT_SHORT, "Das Auge von Ardulvhier (Vorraum)");
  SetProp(P_INT_LONG,
	  BS("Ihr findet Euch in einem kleinen Vorraum, der eigentlich nur "
	     "eine kleine Hoehle ist, von der man durch zwei gigantische Tore "
	     "direkt in den unheiligen Hauptraum gelangen kann, wieder. Die "
	     "Waende sind mit dunklen Seidenvorhaengen geschmueckt, in der "
	     "Mitte steht ein zwergenhoher Steinblock und seitlich davon je "
	     "ein Fackelhalter mit Hoellenfeuer."));

  SetProp(P_NOQUIT, "Wagt es in diesen Hallen nicht!\n");
  SetProp(P_NOREST, "Wagt es in diesen Hallen nicht!\n");

  AddDetail(({"hoehle","vorraum","raum"}),
	    TO->QueryProp(P_INT_LONG));

  AddDetail(({"boden"}),
	    "Der Boden scheint aus nur einer einzigen Steinplatte zu "
	    "bestehen.");

  AddDetail(({"marmorplatte","platte","steinplatte"}),
	    "Die Steinplatte am Boden besteht scheinbar aus dunklem Marmor.");

  AddDetail("marmor",
	    "Marmor, wie man ihn sonst nur in den hoechsten Haeusern "
	    "Dhrkions sieht.");

  AddDetail(({"haeuser","dhrkion"}),
	    "Nur die reichsten Haeuser Dhrkions koennen sich solchen Marmor "
	    "leisten.");

  AddDetail(({"tor","tore"}),
	    "Die Tore aus massivem, dunklen Eichenholz sind fest "
	    "verschlossen.");

  AddDetail(({"holz","eichenholz"}),
	    "Nur das massivste Holz der dunklen Steineiche wurde fuer diese "
	    "Tore verwendet.");

  AddDetail(({"eiche","steineiche"}),
	    "Steineichen gehoeren zu den aeltesten und staerksten Baeumen "
	    "ueberhaupt hier im Unterreich.");

  AddDetail("baeume",
	    "Es wachsen nicht viele Baeume hier im Unterreich, doch dafuer "
	    "gehoeren sie zu den staerksten und widerstandsfaehigsten "
	    "ueberhaupt.");

  AddDetail(({"reich","unterreich","dunkelelfen"}),
	    "Falls Ihr es noch nicht bemerkt habt, Ihr befindet Euch hier im "
	    "Unterreich, speziell hier im Reich der Dunkelelfen!");

  AddDetail("decke",
	    "Die Decke wirkt sehr hoch, das kommt wohl daher, dass sie "
	    "tiefschwarz ist.");

  AddDetail(({"dunkelelfentempel","tempel","hauptraum"}),
	    "Der Tempel ist durch die zwei gigantischen Tore betretbar. In "
	    "ihm werden normalerweise die Trauungen vorgenommen, doch auch "
	    "Hinrichtungen gab es da schon.");

  AddDetail(({"trauungen","trauung"}),
	    "Dieser Tempel hat bereits einige blutige Trauungen gesehen.");

  AddDetail(({"hinrichtung","hinrichtungen"}),
	    "Wenn der Tempel gerade nicht fuer eine Trauung benutzt wird, "
	    "werden dort auch oft Hinrichtungen vollstreckt.");

  AddDetail(({"mitte"}),
	    "In der Mitte der Hoehle steht ein von Fackelhaltern umringter "
	    "Steinblock.");

  AddDetail(({"vorhaenge","seidenvorhaenge","vorhang","seidenvorhang",
		"waende"}),
	    "Die Waende wurden mit Seidenvorhaengen behaengt, die sich bei "
	    "jedem Lufthauch geheimnisvoll winden. An einer Wand scheint "
	    "eine Tafel aufgehaengt zu sein.");

  AddDetail(({"hauch","lufthauch"}),
	    "Es reicht schon, wenn man an der Wand vorbeigeht...");

  AddDetail("wand",
	    "An einer Wand wurde eine Tafel befestigt.");

  AddDetail(({"tafel","wandtafel","verzeichniss","trauungsverzeichniss"}),
	    "Jede Trauung wurde hier auf der Wandtafel verewigt! Eine "
	    "kleine Schriftrolle haengt an ihrer Seite.");

  AddDetail(({"seite"}),
	    "Eine kleine Schriftrolle haengt an der Seite der Wandtafel.");

  AddDetail(({"rolle","schriftrolle"}),
	    "Die Schriftrolle scheint Instruktionen ueber die im Tempel "
	    "vollfuehrten Trauungen zu beinhalten.");

  AddDetail(({"instruktion","instruktionen"}),
	    "Die stehen auf der Schriftrolle.");

  AddDetail(({"halter","fackelhalter"}),
	    "Seitlich des Steinblocks steht je ein Fackelhalter, der mit "
	    "Hoellenfeuerfackeln bestueckt ist.");

  AddDetail(({"feuer","hoellenfeuer","fackeln","hoellenfeuerfackeln",
		"atmosphaere"}),
	    "Die Hoellenfeuerfackeln verbreiten eine unheimliche, duestere "
	    "Atmosphaere.");

  AddDetail(({"block","steinblock"}),
	    "Ein zwergengrosser Steinblock steht hier mitten im Vorraum. "
	    "Auf ihm ist eine Spinne aus Schwarzsilber angebracht, auf "
	    "deren Ruecken eine Schale befestigt ist.");

  AddDetail("ruecken",
	    "Eine Schale steht auf dem Ruecken der Spinne.");

  AddDetail(({"beine","spinne"}),
	    "Eine Spinne aus Schwarzsilber ziert den grossen Steinblock. "
	    "Ihre Beine halten ihn fest umklammert und eine kleine Schale "
	    "ist auf ihrem Ruecken.");

  AddDetail(({"material","silber","schwarzsilber"}),
	    "Schwarzsilber ist ein sehr beliebtes Material bei Dunkelelfen, "
	    "um Schmuck herzustellen.");

  AddDetail("schmuck",
	    "Dunkelelfen legen viel wert auf kostbaren Schmuck.");

  AddDetail(({"opferschale","schale"}),
	    "Es scheint offenbar eine Opferschale zu sein. Etwas Blut klebt "
	    "an den Raendern.");

  AddDetail(({"blut","raender"}),
	    "Hier werden wohl oft Blutopfer veranstaltet!");

  AddDetail(({"opfer","blutopfer"}),
	    "Du koenntest das naechste Blutopfer sein!");

  AddReadDetail(({"rolle", "schriftrolle", "instruktion", "instruktionen"}),
		CLOSURE(instruktionen));

  AddReadDetail(({"tafel","wandtafel","liste", "hochzeitsliste", "verzeichnis",
		    "hochzeitsverzeichnis"}),
		CLOSURE(verzeichnis));

  AddSound(({"stille","totenstille",DEFAULT_SOUND}),
	   "Es herrscht eine Totenstille.");

  AddSmell(({"moder",DEFAULT_SMELL}),
	   "Es riecht etwas modrig.");
  
  //AddCmd(({"lies","lese"}),"hochzeitsliste");

  AddExit("raus", "aus dem Tempel#" ROOM "tgel_2_2_0" );

  AddExit("llothtempel",
	  ([EX_DEST:ROOM "tempel", 
	  EX_TESTFUNC:"betreten", 
	  EX_MSG:"durch die Tore in den Tempel"]));
  
  Licht("dunkel");
  Umgebung("maessig", TT_CAVE, 1);

  AddItem(NPC "dienerin", REFRESH_DESTRUCT);
}

nosave string instruktionen()
{
  string ret;

  ret=
    CT("Offizieller Ablauf einer Zeremonie")+
    CT("--------------------------------------\n")+
    "Die satanische Braut, oder der Braeutigam bitten die Dienerin\n"
    "im Vorraum des Tempels um eine Audienz bei der Hohepriesterin\n"
    "zum Zwecke einer Trauung.\n"
    "Daraufhin wird ein Verwandter/Bekannter als Zeuge auserkoren.\n\n"
    "Es wird mit den Vorbereitungen begonnen, die Einladungen\n"
    "werden verschickt und die Hochzeit fuer den kommenden Tag\n"
    "festgesetzt.\n\n"
    "Am naechsten Tag, wenn alle anwesend sind, uebergibt die\n"
    "Dienerin der satanischen Braut und dem Braeutigam die\n"
    "empfohlenen Zeremoniegewaender.\n"
    "Die Leihgebuehr betraegt fuer sie dreihundert (300) und fuer ihn\n"
    "fuenfhundert (500) Goldmuenzen.\n\n"
    "Hat das Paar die Zeremoniegewaender angelegt, duerfen alle den\n"
    "Tempel betreten. Nach einer kurzen Warte- und Sammelpause wird\n"
    "die zustaendige Hohepriesterin mit der Zeremonie beginnen.\n\n"
    "Waehrend der Zeremonie sind Unterhaltungen, Kaempfe und sonstige\n"
    "Stoerungen strengstens zu unterlassen!\n\n"
    "Unerwuenschte Rassen:\n"
    "  Oberflaechenelfen und Feenwesen! (ausser mit Einladung)\n\n"
    "Vorraussetzungen an das Paar:\n"
    "  Sie muss von satanischem Charakter sein, er mindestens frech.\n"
    "  Die Leihgebuer fuer sie betraegt 300 Muenzen, fuer ihn 500.\n"
    "  Die Bitte um Audienz an die Dienerin kostet 666 Muenzen!\n\n";
  
  TP->More(make_dokument(ret));
  
  return "";
}

nosave string verzeichnis()
{
  string ret;
  
  if(!ret=read_file(LOG "hliste"))
    ret="Hier hat noch keiner geheiratet!\n";

  ret="Ihr blickt auf die Tafel und lest die Hochzeitsliste durch:\n\n"+
    ret;  

  TP->More(make_dokument(ret));
  
  return "";
}

nosave int betreten()
{
  object it;

  if(HZM->Keine_Hochzeit()) return 1;
  
  if(HZM->Hochzeit_laeuft())
    return write(BS("Die Dienerin herrscht Euch an: Stoere die Zeremonie "
		 "nicht!")), 0;
  
  if(TP->QueryProp(P_GENDER)==FEMALE && getuid(TP)==HZM->Braut())
    {
      if((it=present("brautkleid", TP)) && (it->QueryWorn()==TP))
	if((it=present("brautschleier", TP)) && (it->QueryWorn()==TP))
	  if(TP->QueryProp(P_ALIGN) < -666)
	    if(GESINNUNG->QueryAll4(getuid(TP)))
	      return write(BS("Die Dienerin laesst Euch passieren.")), 1;
	    else
	      return write(BS("Die Dienerin meint: Ihr habt Euch noch nicht "
			      "an den Schreinen gereinigt!")), 0;
	  else
	    return write(BS("Die Dienerin meint: Ihr seid nicht boese genug!")), 0;

      return write(BS("Ihr muesst erst die Hochzeitskleidung anlegen!")), 0;
    }
      
  if(TP->QueryProp(P_GENDER)==MALE && getuid(TP)==HZM->Braeutigam())
    {
      if((it=present("seidenhemd", TP)) && (it->QueryWorn()==TP))
	if((it=present("seidenumhang", TP)) && (it->QueryWorn()==TP))
	  if((it=present("seidenhose", TP)) && (it->QueryWorn()==TP))
	    if(TP->QueryProp(P_ALIGN)>0)
	      return write(BS("Die Dienerin meint: Ihr seid nicht boese genug!")), 0;
	    else
	      return write(BS("Die Dienerin laesst Euch passieren.")), 1;

      return write(BS("Ihr muesst erst die Hochzeitskleidung anlegen!")), 0;
    }

  if(getuid(TP)==HZM->Zeuge()) 
    return write(BS("Die Dienerin laesst Euch passieren.")), 1;
  
  if(!HZM->Geschlossene_Gesellschaft()) 
    return write(BS("Die Dienerin laesst Euch passieren.")), 1;

  if(HZM->Eingeladen(getuid(TP)))
    return write(BS("Die Dienerin laesst Euch passieren.")), 1;

  write(BS("Ihr seid nicht eingeladen worden zu dieser Hochzeit!"));

  return 0;
}

varargs int PreventLeave(object who, mixed dest)
{
  object weg;

  //  if(!query_once_interactive(who)) return 0; 

  if(stringp(dest))
    if(dest==ROOM "tempel")
      return 0;

  if(present(KLEIDUNG, who))
    {
      if(interactive(who))
	tell_object(who, 
	    BS("Bevor Ihr den Tempel verlasst, gebt Ihr noch die Kleidung "
	       "zurueck."));

      while(weg=deep_present(KLEIDUNG, who))
	{
	  weg->SetProp(P_CURSED, 0);
	  weg->DoUnwear(1);
	  weg->remove();
	}
    }

  return 0;
}
