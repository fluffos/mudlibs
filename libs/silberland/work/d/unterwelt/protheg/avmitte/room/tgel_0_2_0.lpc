#include "../def.h"

inherit MOST "std_room";

nosave string *getrunken;
nosave int moos;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Fusse eines gewaltigen Stalagmiten");
  SetProp(P_INT_LONG,
	  BS("Ihr wandert durch die unheiligen Tempelanlagen von Ardulvhier "
	     "und werdet das Gefuehl nicht los, beobachtet zu werden... "
	     "Neben Euch ragt ein gewaltiger Stalagmit, an dessen Fuss sich "
	     "ein Brunnen befindet, in die Hoehe. Er erscheint etwas seltsam, "
	     "denn er ist nicht kegelfoermig wie die anderen Stalagmiten. Er "
	     "ist oben ziemlich abgeflacht und bildet fast schon einen "
	     "Diskus. Darin befindet sich der wohl maechtigste Tempel der "
	     "ganzen Stadt. Aus dem Osten ziehen sich einige Nebelschwaden "
	     "bis hierher."));

  AddDetail(({"boden"}),
	    "Den Boden bildet ein Mosaik aus faustgrossen, dunklen Steinen, "
	    "die fein, saeuberlich glattgeschliffen wurden.");

  AddDetail(({"stein","steine"}),
	    "Hunderte von faustgrossen Steinen bilden ein dunkles Mosaik auf "
	    "dem Boden.");

  AddDetail(({"muster","mosaik"}),
	    "Ihr koennt das Muster, dass das Mosaik bildet nicht genau "
	    "erkennen, jedoch fallen Euch hie und da in den Boden eingelegte "
	    "Runensteine auf.");

  AddDetail(({"runenstein","runensteine"}),
	    "Das Mosaik am Boden ist mit seltsamen Runensteinen gespickt, "
	    "wahrscheinlich sind es unheilige Zeichen, die fuer bestimmte "
	    "Zauber notwendig sind. Zwei der Runensteine scheinen einen "
	    "Pfad zu begrenzen.");

  AddDetail(({"zauber","zeichen"}),
	    "Dunkelelfenpriesterinnen verwenden oft bestimmte uralte Zeichen "
	    "auf Runensteinen, um ihre Zauber zu verstaerken.");

  AddDetail(({"priesterin","priesterinnen","dunkelelfenpriesterin",
		"dunkelelfenpriesterinnen"}),
	    "Dunkelelfenpriesterinnen halten sich meisstens in ihrem Tempel "
	    "auf...");

  AddDetail("himmel",
	    "Wo wollt Ihr denn in einer Hoehle einen Himmel sehen?");

  AddDetail(({"hoehlendecke","decke"}),
	    "Die Decke der Hoehle ist viel zu weit oben, als dass man etwas "
	    "erkennen koennte!");

  AddDetail(({"stadt","ardulvhier","tempelanlagen","anlagen"}),
	    "Ihr befindet Euch hier in den Tempelanlagen der Stadt "
	    "Ardulvhier. Ein gewaltiger, diskusfoermiger Stalagmit der in "
	    "der Mitte der Hoehle steht beherbergt einen Tempel und "
	    "die Hoehle rund herum wird als Gebetsstaette genutzt. Ein "
	    "seltsames Gefuehl erfuellt Euch, als ob Ihr hier nicht allein "
	    "seid...");

  AddDetail(({"inneres","tempel","stalagmit"}),
	    "Der abgerundete Stalagmit beherbergt in seinem Inneren den "
	    "maechtigsten Tempel von Ardulvhier, vielleicht solltet Ihr "
	    "ihn Euch einmal ansehen. Der Eingang befindet sich im Sueden.");

  AddDetail(({"zentrum","hoehle","mitte"}),
	    "Ihr befindet Euch hier im Zentrum der Hoehlen von Ardulvhier. "
	    "Genau in der Mitte der Hoehle befindet sich ein seltsam "
	    "geformter Stalagmit.");

  AddDetail("hoehlen",
	    "Ardulvhier ist auf mehrere Hoehlen aufgeteilt, jede Hoehle "
	    "beherbergt einen bestimmten Teil der Stadt.");

  AddDetail(({"teile","teil"}),
	    "Jeder Teil von Ardulvhier ist in sich abgeschlossen. Ihr "
	    "solltet die Teile einmal besuchen.");

  AddDetail("hoehe",
	    "Ihr blickt in die Hoehe... Weit ueber Euch befindet sich "
	    "irgendwo die Decke der Hoehle.");

  AddDetail(({"augen","dunkelheit"}),
	    "So sehr Ihr Eure Augen auch anstrengt, Ihr koennt nicht "
	    "mehr erkennen!");

  AddDetail("eingang",
	    "Der Eingang liegt weiter suedlich.");

  AddDetail("gefuehl",
	    "Ein seltsames Gefuehl umschleicht Euch andauernd... Es ist als "
	    "ob Ihr beobachtet werdet, jedoch koennt Ihr niemanden sehen.");

  AddDetail(({"gebetsstaette","staette"}),
	    "Hie und da sind rund um den Stalagmiten Schreine aufgestellt, "
	    "an denen man der dunklen Goettin Lloth huldigen, oder ihr ein "
	    "Opfer bringen kann.");

  AddDetail(({"goettin","lloth","dunkle goettin"}),
	    "Die gesamten Tempelanlagen sind der dunklen Goettin Lloth "
	    "gewidmet.");

  AddDetail(({"schrein","schreine","opfer"}),
	    "Etwas weiter, entlang des Stalagmites sind einige Schreine "
	    "aufgestellt. Dort kann man Lloth huldigen und ihr Opfer "
	    "darbringen.");

  AddDetail(({"form","diskuss","diskus"}),
	    "Der Stalagmit ist ziemlich flach, und hat schon fast die Form "
	    "eines Diskus.");

  AddDetail(({"pfad","norden"}),
	    "Von hier aus fuehrt ein ebener Pfad nach Norden...");

  AddDetail(({"altar","altaere"}),
	    "Rund um den diskusfoermigen Stalagmiten stehen verschiedene "
	    "Altaere, um der dunklen Goettin Lloth huldigen zu koennen und "
	    "ihr Opfer darbringen zu koennen.");

  AddDetail(({"ritual","rituale"}),
	    "Da muesst Ihr schon zu einem der Altaere gehen, um bei so einem "
	    "Ritual anwesend zu sein. Hier steht nur ein Brunnen.");

  AddDetail(({"brunnen","steinbrunnen"}),
	    "Ein schlichter, aus Steinplatten bestehender Brunnen, in dem "
	    "das kristallklare Wasser permanent plaetschert...");

  AddDetail(({"fuss"}),
	    "Am Fusse des Stalagmiten plaetschert kristallklares Wasser "
	    "in einem Brunnen.");

  AddDetail(({"stein","granit"}),
	    "Hier besteht fast alles aus hartem Granit...");

  AddDetail(({"platte","steinplatte","platten","steinplatten"}),
	    "Ziegelfoermige Steinplatten aus Granit wurden fuer den "
	    "Brunnen verwendet.");

  AddDetail(({"wasser","brunnenwasser","trinkwasser"}),
	    "Das kristallklare Wasser fliesst aus einem Loch im Stalagmiten "
	    "heraus und muendet im Brunnenbecken.");

  AddDetail(({"loch"}),
	    "Etwas ueber dem Steinbrunnen befindet sich ein Loch in den "
	    "Stalagmiten, aus dem kristallklares Wasser in das Becken "
	    "hinabplaetschert.");

  AddDetail(({"becken","brunnenbecken","steinbrunnenbecken"}),
	    "Es ist vollkommen mit Moosen ausgelegt, die im kristallklaren "
	    "Wasser seltsam Gruen leuchten.");

  AddDetail(({"moos","moose"}),
	    "In dem Wasser scheinen sie in einem seltsamen Gruen zu leuchten. "
	    "Ob das wohl etwas bedeutet?");

  AddDetail(({"gruen"}),
	    "Das Moos im Wasser leuchtet in einem seltsamen Gruen.");

  AddDetail(({"osten","schwaden","nebel","nebelschwaden"}),
	    "Aus dem Osten ziehen einige Nebelschwaden bis hierher.");  

  AddSound(DEFAULT_SOUND,
	   "Die Stille der Hoehle wird hier nur durch das angenehm rythmische "
	   "Plaetschern des Brunnens unterbrochen.");

  AddSound(({"stille"}),
	   "*stille*");

  AddSound(({"wasser","brunnen","plaetschern","geplaetscher"}),
	   "Das Wasser im Brunnen plaetschert ungestoert vor sich hin...");

  AddSmell(({"geruch","luft",DEFAULT_SMELL}),
	   "Der Geruch von Weihrauch und anderen Kraeutern liegt in der "
	   "Luft.");

  AddSmell(({"rauch","weihrauch","kraeuter","kraut"}),
	   "Die Luft ist durchstroemt mit dem Geruch von Weihrauch und "
	   "sonstigen Kraeutern, die an den Altaeren entlang des Stalagmiten "
	   "verbrannt, oder fuer sonstige Rituale verwendet werden.");

  Umgebung("warm", TT_CAVE, 1);
  Licht("duester");

  set_exits("tgel");

  AddCmd(({"folge","folg"}), "folgen");
  AddCmd(({"trinke","trink"}), "trinken");
  AddCmd(({"nimm","nehme","nehm"}), "nehmen");
  AddCmd(({"reiss","reisse","rupf","rupfe"}), "rupfen");

  AddExit(({"pfad","norden"}),
	  "einen Pfad entlang nach Norden#" ROOM "portal");

  SetProp(P_HIDE_EXITS, ({"pfad","norden"}));

  getrunken=({});
  moos=random(2)+1;

  AddItem(NPC "tw", REFRESH_DESTRUCT);
}

void reset()
{
  ::reset();

  moos=random(2)+1;
  getrunken=({});
}

nosave int rupfen(string str)
{
  object moos_obj;

  notify_fail("Was wollt Ihr denn ausrupfen?\n");
  if(!str) return 0;

  if(str=="moos aus"||str=="moose aus"||
     str=="moos aus brunnen"||str=="moose aus brunnen")
    {
      if(moos < 0) moos=0;

      if(!moos)
	return write(BS("Ihr zieht an dem Moos herum, doch es ist zu fest. "
			"Vielleicht lockert sich ja bald einmal eines...")),1;

      if(TP->QueryAttribute(A_STR)<=random(12))
	return write(BS("Ihr zieht und zerrt an dem Moos herum, doch Ihr seid "
			"zu schwach, um eines herauszureissen... Versucht es "
			"doch gleich nocheinmal!")),1;

      moos_obj=clone_object(OBJ "giftmoos");
      
      if(moos_obj->move(TP)==ME_TOO_HEAVY)
	{
	  write(BS("Ihr seid so ueberladen, dass Ihr vermutlich nicht einmal "
		   "mehr das Stueckchen Moos aufheben koennt..."));
	  moos_obj->remove();

	  return 1;
	}

      write(BS("Ihr erblickt ein locker sitzendes Moos und reisst einmal "
	       "kraeftig daran... Schwupp und schon haelt Ihr es in den "
	       "Haenden und steckt es ein."));
      
      moos--;

      return 1;
    }
  return 0;
}

nosave int nehmen(string str)
{
  if(!str) return 0;

  if(str=="moos"||str=="moos aus brunnen"||str=="moos aus steinbrunnen"||
     str=="moos aus trinkbrunnen")
    return write("Das Moos im Brunnen sitzt recht fest...\n"
		 "Ihr werdet es wohl ausreissen muessen!\n"),1;

  return 0;
}

nosave int trinken(string str)
{
  string was, woraus;

  notify_fail(BS("Was wollt Ihr denn woraus trinken?"));
  if(!str) return 0;

  if(sscanf(str, "%s aus %s", was, woraus)!=2) return 0;

  if(member(({"wasser","trinkwasser","brunnenwasser","steinbrunnenwasser"}),
	    was)==-1) return 0;

  if(member(({"brunnen","trinkbrunnen","steinbrunnen"}), woraus)==-1)
    return notify_fail(BS("Woraus wollt Ihr denn das Wasser trinken?")), 0;

  if(member(getrunken, getuid(TP))>=0)
    return write("Ihr habt erstmal genug getrunken!\n"), 1;

  if(TP->QueryProp(P_DRINK) > (TP->QueryProp(P_MAX_DRINK)-8))
    return write(BS("Ihr werdet wohl nicht mehr soviel Wasser trinken "
		    "koennen!")), 1;
  
  if(!random(2)) getrunken+=({getuid(TP)});
  
  TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK)+8);
  
  write(BS("Ihr beugt Euch ueber den Brunnenrand und nehmt einen kraeftigen "
	   "Schluck von dem kristallklaren Wasser. Ihr fuehlt ein kurzes "
	   "Kribbeln in Eurem Koerper und seid danach total erfrischt..."));
  
  TP->heal_self(50+random(20));
  
  return 1;
}

nosave int folgen(string str)
{
  notify_fail(BS("Wem wollt Ihr folgen?"));
  if(!str) return 0;

  if(str=="pfad"||str=="pfad nach norden")
    {
      //TP->command_me("pfad");
      
      TP->move(ROOM "dsch_portal", M_GO, "den Pfad entlang");
      
      return 1;
    }

  return 0;
}
