/*
  Der "Atem Lloths"
  Einer der Schreine im Tempelbezirk von Ardulvhier

  Macalla + Tyron, Juni 2001

  Finalisiert by PROtheG, Oktober 2001
*/

#include "../def.h"

inherit MOST "std_room";
inherit ROOM "s";

#define MAX_MED_SUM  8
#define MAX_MED_PL   2

nosave int med_sum;
nosave object seq;
nosave mapping med_pl;

/*
  In dieser Funktion erhaelt ein meditierender Spieler seine Magiepunkte
  zurueck. Sie wird von cmd_meditieren() aufgerufen.
*/
nosave int Addiere_SP(object pl)
{
  int med_count;

  if(!pl || !objectp(pl) || ENV(pl)!=ME) return -1;

  //  if(pl->QueryProp(P_GUILD)!="dunkelelfen") return 0;

  if(med_sum >= MAX_MED_SUM)  // Maximal zulaessige Meditationen erreicht?
    return 0;

  med_count=med_pl[pl];

  if(med_count < MAX_MED_PL) // Maxi Meditationen fuer Spieler erreicht?
    {
      write(BS("Ihre Macht speist Eure magischen Kraefte - auf dass"
	       " Ihr das Werk der Goettin tun moegt ...."));

      pl->AddSp(pl->QueryProp(P_MAX_SP));

      med_pl[pl]=med_count+1;
    }

  return 1;
}

void create()
{
  ::create();

  med_sum=0;
  med_pl=([]);

  SetProp(P_INT_SHORT, "Der Atem Lloths");
  SetProp(P_INT_LONG,
	  BS("Farbige Daempfe quellen aus einem langen, gezackten Riss im "
	     "Boden vor Euch, der dick mit winzigen, bunten Kristallen "
	     "verkrustet ist. Ihr Schimmern verbindet sich mit dem Wallen "
	     "und Fliessen der Daempfe, die Euch umgeben. Sie wirbeln um "
	     "Euch herum, greifen nach Euch, schlingen sich um Euch - Ihr "
	     "fuehlt sie wie die Umarmung der ewigen Lloth, der dieser "
	     "Schrein geweiht ist."));

  AddDetail(({"daempfe","wallen","fliessen"}),
     "Die Daempfe wallen in bunten, dicken Wolken aus dem Riss im Boden."
     " In feinen, fadenartigen Tentakeln verteilen sie sich dann in der"
     " Luft und fliessen um Euch herum.");

  AddDetail(({"wolken","tentakel"}),
     "Die Wolken huellen Euch ein, die Tentakel umschlingen Euch.");

  AddDetail(({"riss"}),
     "Ein langer, natuerlicher Riss oeffnet sich im Boden und spuckt die"
     " farbigen Daempfe aus, die Euch umgeben.");

  AddDetail(({"boden"}),
     "Der Boden besteht hier, wie ueberall in diesen Hoehlen, aus Kalkstein.");

  AddDetail(({"himmel"}),
     "Zwischen dem und Euch ist erfreulich viel festes Gestein.");

  AddDetail(({"gestein","kalkstein"}),
     "Kalkstein.");

  AddDetail(({"hoehle","hoehlen"}),
     "Die zentrale Hoehle von Ardulvhier.");

  AddDetail(({"decke","waende"}),
     "Die Daempfe umwallen Euch so dicht, dass Ihr die Waende und die Decke"
     " der Hoehle nicht erkennen koennt.");

  AddDetail(({"ardulvhier","stadt"}),
     "Das grosse, maechtige Ardulvhier, die groesste Stadt der Dunkelelfen"
     " und die herrlichste Stadt der gesamten Welt!");

  AddDetail(({"dunkelelfen","drow","reich","volk","voelker"}),
     "Dies ist das Reich des edelsten aller Voelker: der Dunkelelfen!");

  AddDetail(({"kristall","kristalle","schimmern"}),
     "Die winzigen Kristalle schimmern in allen Farben. Sie sind auf"
     " natuerliche Art an dem Riss gewachsen und ueberziehen den Stein wie"
     " ein dichter, bunter Teppich.");

  AddDetail(({"farben"}),
     "Alle Farben, die Ihr mit Euren Augen wahrnehmen koennt.");

  AddDetail(({"augen"}),
     "Eure wunderschoenen, dunkelrot gluehenden Augen.");

  AddDetail(({"teppich","schicht"}),
     "Eine dicke, bunte Schicht aus Kristall.");

  AddDetail(({"umarmung"}),
     "Wie suess ist die Umarmung der ewigen, dunklen Lloth!");

  AddDetail(({"lloth","goettin","herrin"}),
     "Ehre sei der Ewigen, der Dunklen, der Herrin ueber Leben und Tod.");

  AddDetail(({"leben","tod"}),
     "Lloth alleine bestimmt Euer Leben und Euren Tod.");

  AddDetail(({"schrein"}),
     "Auch dies ist ein Schrein der Goettin. Verehrt sie und neigt Euer Haupt"
     " vor ihrer Allmacht.");

  AddDetail(({"haupt"}),
     "Tief sollt Ihr Euch verbeugen und aus ganzem Herzen beten.");

  AddDetail(({"allmacht"}),
     "Alle Macht der ewigen Goettin!");

  AddDetail(({"beduerfnis","verfuehrung"}),
     "Wie eine suesse Verfuehrung fuehlt Ihr das Verlangen, Euch"
     " niederzulassen und zu meditieren.");

  AddDetail(({"atem"}),
     "Lloths Atem erfuellt diesen Raum mit seiner Suesse.");

  AddDetail(({"suesse","gunst"}),
     "Die Suesse ihrer Gunst.");

  AddSmell( DEFAULT_SMELL,
     "Ihr koennt den Geruch nicht genau einordnen.");

  AddSmell(({"geruch"}),
     "Ihr koennt den Geruch nicht genau einordnen, aber er wirkt seltsam"
     " beruhigend, staerkend.");

  AddCmd("", "seq_check", 1);
  AddCmd(({"bete","huldige"}),"cmd_beten");
  AddCmd(({"neig","neige"}),"cmd_neigen");
  AddCmd(({"meditiere"}),"cmd_meditieren");


  Licht("dunkel");
  Umgebung("warm", TT_CAVE, 1);

  set_exits("tgel");
  set_exits("tor");
}

nosave int seq_check(string str)
{
  if((objectp(seq)) && (seq==TP) && !IS_WIZARD(TP)) return 1;
  return 0;
}

void reset()
{
  ::reset();

  med_sum=0;
  med_pl=([]);
}

nosave int cmd_beten(string str)
{
  notify_fail(BS("Wollt Ihr zu Lloth beten?"));

  if(!str) return 0;

  if(member(({"lloth", "zu lloth", "loth", "zu loth"}), str)>-1)
    {
      write(BS("Ihr kniet Euch neben den Riss und betet "
	       "zu Lloth, der dunklen Herrin. Dabei durchfaehrt Euch der "
	       "Gedanke, dass dies ein sehr guter Ort fuer eine Meditation "
	       "waere."));

      say(BS(TP->Name()+" kniet sich hin und betet."), ({TP}));
      
      return 1;
    }
  else
    if(member(({"woody", "zu woody", "dusty", "zu dusty"}), str)>-1)
      {
	write(break_string(
	     "`Du unwuerdiger Wurm wagst es tatsaechlich, HIER zu "
	     "einem anderen Gott zu beten??'\n"
	     "Die Rauchtentakel winden sich langsam und unaufhaltsam um "
	     "Euren Hals, und dann erhalten sie ploetzlich Substanz und "
	     "druecken zu. Ganz langsam druecken sie Euch die Luft ab. "
	     "Schliesslich brecht Ihr zuammen. Dann, Euch kommt es wie "
	     "Ewigkeiten vor, laesst der Druck nach, und Ihr bekommt "
	     "ganz allmaehlich wieder Luft.",0,0,1));
	
	say(break_string(
	   TP->Name()+" wagt es tatsaechlich, HIER zu einem anderen Gott "
	   "zu beten!\n"
	   "Langsam treten "+TP->QueryPossPronoun(FEMALE,WER,PLURAL)+
	   " Augen aus ihren Hoehlen und "+TP->QueryPronoun(WER)+
	   " greift an "+TP->QueryPossPronoun(MALE,WEN,SINGULAR)+
	   " Hals, als wuerde "+TP->QueryPronoun(WER)+" stranguliert."
	   " Schliesslich bricht "+TP->QueryPronoun(WER)+
	   " mit vor Angst verzerrtem Gesicht zusammen.",0,0,1));
	
	TP->AddHp(-22-random(10)-random(10));
	
	return 1;
      }
  return 0;
}

nosave int cmd_neigen(string str)
{
  notify_fail(BS("Was moechtet Ihr neigen?"));

  if(!str) return 0;
  
  if(str=="kopf"||str=="haupt")
    {
      write(BS("Ihr neigt andaechtig Euer Haupt zu Ehren der grossen "
	       "dunklen Goettin. Dabei durchfaehrt Euch der Gedanke, "
	       "dass dies ein sehr guter Ort fuer eine Meditation waere."));

      say(BS(TP->Name()+" neigt andaechtig den Kopf."), ({TP}));

      return 1;
    }

  return 0;
}

void darkelf_fin(object who)
{
  Addiere_SP(who);

  seq=0;
}

void other_fin(object who)
{
  who->move(ROOM "tgel_0_1_0", M_GO,"","rennt davon",
	    "stuermt kreidebleich herein");
  
  seq=0;
}

nosave int cmd_meditieren(string str)
{
  notify_fail(BS("So nicht. Einfach nur meditieren."));

  if(str) return 0;

  if(objectp(seq) && ENV(seq)==ME)
    if(seq==TP)
      return write(""),1;
    else
      return write(BS("Stoere "+seq->Name(WESSEN)+" Meditation nicht!")), 1;

  if(TP->QueryProp(P_ALIGN) > -200)
    return write(BS("Dazu seid Ihr viel zu 'nett'!!")), 1;

  seq=TP;

  if(TP->QueryProp(P_RACE)=="Dunkelelf") // Sequenz fuer Dunkelelfen
    StartSequence(ROOM "seq/schrein1_darkelf", seq, "darkelf_fin");
  else //  Sequenz fuer Nichtdunkelelfen
    StartSequence(ROOM "seq/schrein1_other", seq, "other_fin");

  GESINNUNG->Aendere_Gesinnung(TP, SCHREIN_RISS);
  
  return 1;
}

