#include "../def.h"

inherit MOST "std_room";
inherit ROOM "s";

nosave object seq;
nosave int pause;
nosave string *broken;

/*
  In dieser Funktionen erhaelt ein opfernder Spieler eine der Perlen
  Lloths. Die Funktion wird von cmd_opfern() aufgerufen.
*/

nosave int gebe_perle(object pl)
{
  int i, anzperl;
  object ob;
  object *inv;

  anzperl=0;

  if(!pl||!objectp(pl)||ENV(pl)!=ME) return -1;
  //if(pl->QueryProp(P_GUILD)!="dunkelelfen") return 0;

  // Falls der Charakter schon drei Perlen besitzt, keine weitere geben
  inv=deep_inventory(pl);
  for(i=sizeof(inv)-1;i>=0;i--)
    if(inv[i]->id("\nlloth_perle"))
      {
	anzperl++;
	if(anzperl>=3) return 0;
      }

  pl->AddHp(-20-random(11));

  tell_object(pl,
	      BS("Ihr schliesst kurz die Augen, und als Ihr sie wieder "
		 "oeffnet, liegt in der Mitte der Einbuchtung eine winzige "
		 "rote Perle."));

  ob=clone_object(OBJ "lloth_perle");

  if(objectp(ob))
    if(ob->move(pl)==ME_TOO_HEAVY)
      {
	tell_object(pl,
		    BS("Ihr dankt Lloth, nehmt die Perle... Doch! sie "
		       "faellt Euch aus der Hand und zerschellt auf dem "
		       "Boden."));
	ob->remove(1);
      }
    else
      tell_object(pl,
		  BS("Ihr dankt Lloth, nehmt die Perle und steckt sie ein."));

  
  return 1;
}

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Die Tafel Lloths");
  SetProp(P_INT_LONG,
	  BS("Vor Euch erhebt sich ein schlanker, brusthoher Stalagmit, "
	     "auf dessen nadelfeiner Spitze eine unregelmaessige, aber "
	     "spiegelglatt geschliffene Felsplatte in perfekter Balance "
	     "ruht. In ihrem Zentrum ist eine stilisierte Spinne "
	     "eingemeisselt. Ihr Koerper wird von einer Mulde gebildet, "
	     "die acht Beine sind feine Rinnen, die die Platte bis "
	     "fast zu deren Rand durchziehen."));

  AddDetail(({"stalagmit"}),
     "Ein goldbraun schimmernder, schlanker Stalagmit.");
  
  AddDetail(({"spitze","ende"}),
    "Die Spitze des Stalagmiten ist so fein wie eine Nadel und wirkt, als"
    " wuerde sie durch eine blosse Beruehrung abbrechen.");

  AddDetail(({"nadel"}),
    "Die Spitze des Stalagmiten ist an ihrem Ende fast transparent. So"
    " fein ist sie.");

  AddDetail(({"beruehrung"}),
    "Natuerlich wagt Ihr es nicht, die Spitze zu beruehren und damit"
    " vielleicht Lloths Zorn heraufzubeschwoeren...");

  AddDetail(({"lloth"}),
    "Die ewige, dunkle, maechtige Lloth regiert hier.");

  AddDetail(({"zorn"}),
    "Glaubt mir, Ihr wollt nicht wissen, was LLoths Zorn anrichten kann ...");

  AddDetail(({"felsplatte","platte"}),
    "Die Felsplatte ist etwa zwei Handbreit dick und wie der Stalagmit aus"
    " goldbraunem, schimmerndem Stein. Sie ist bestimmt sehr schwer - umso"
    " seltsamer, dass sie so auf der feinen Spitze des Stalagmiten ruht."
    " Ein weiteres Wunder Lloths!");

  AddDetail(({"handbreit","hand"}),
    "Wenn Ihr ein Drow seit, dann betrachtet Eure Hand und ihr wisst, wie"
    " dick die Platte ist. Falls nicht ... was hast du hier verloren,"
    " Eindringling?");

  AddDetail(({"stein","gestein","kalkstein","fels"}),
    "Die ganze Hoehle um Euch herum ist aus Kalkstein. Aber dieser Altar? So"
    " einen Stein habt Ihr noch nie zuvor gesehen.");

  AddDetail(({"wunder"}),
    "Die ewige Lloth hat ihren Kindern viele Wunder geschenkt - dies ist"
    " eines davon.");

  AddDetail(({"eindringling"}),
    "Wenn Ihr einer seid, dann habe ich nur einen Rat an Euch: LAUFT!!!");

  AddDetail(({"hoehle","hoehlen"}),
    "Die Hoehle ist aus Kalkstein.");

  AddDetail(({"altar"}),
    "Er ist, wie alles hier, Lloth geweiht. Ehre sei der ewigen Lloth!.");

  AddDetail(({"drow","reich","dunkelelfen","voelker","volk"}),
    "Dies ist das Reich des edelsten aller Voelker: Das Reich der"
    " Dunkelelfen.");

  AddDetail(({"rat"}),
    "Nimm ihn lieber an!");

  AddDetail(({"balance"}),
    "Die Felsplatte schwingt ganz leicht bei jedem kleinen Luftzug, der"
    " darueber streicht. Aber die Balance ist perfekt und sie pendelt sich"
    " jedesmal nach einer Weile wieder ein und ruht dann wieder voellig"
    " bewegungslos auf der Spitze des Stalagmiten.");

  AddDetail(({"luftzug"}),
    "Die Hoehlen hier sind riesengross und natuerlich auch gut belueftet."
    " Darum spuert man hier manchmal einen leichten Luftzug.");

  AddDetail(({"zentrum","mitte"}),
    "In der exakten Mitte der Platte stellt eine flache Mulde den Koerper"
    " der stilisierten Spinne dar.");

  AddDetail(({"mulde","koerper"}),
    "Den Koerper der stilisierten Spinne bildet eine kreisrunde, flache"
    " Mulde. Sie wurde wohl so gestaltet, um ein Opfer darbringen zu"
    " koennen.");

  AddDetail(({"opfer"}),
    "Welches Opfer koennte wohl edler sein, als Euer eigenes Blut?");

  AddDetail(({"blut"}),
    "Opfert euer Blut der ewigen Lloth! Vielleicht koennt Ihr sie dann"
    " gnaedig stimmen.");

  AddDetail(({"spinne"}),
    "Die Spinne ist Lloth heilig und sollte es deshalb auch Euch sein!");

  AddDetail(({"beine","rinne","rinnen"}),
    "Acht Rinnen, die von der Mulde im Zentrum ausgehen, stellen"
    " die Beine der Spinne dar. Sie ziehen sich fast bis zum Rand der"
    " Felsplatte.");

  AddDetail(({"rand","raender"}),
    "Die Platte selber ist spiegelglatt poliert, aber ihre Raender sind"
    " unregelmaessig und lassen noch den groben, unbearbeiteten Fels"
    " erkennen.");

  AddDetail(({"boden"}),
    "Der Boden besteht, wie ueberall hier, aus Kalkstein.");

  AddDetail(({"himmel"}),
    "Zwischen dem und Euch ist erfreulich viel festes Gestein.");

  AddDetail(({"kinder"}),
    "Die Dunkelelfen sind die Kinder Lloths.");

  AddCmd("", "seq_check", 1);
  AddCmd(({"bete","huldige"}), "cmd_beten");
  AddCmd(({"beruehr","beruehre"}), "cmd_beruehren");
  AddCmd(({"brich","brech","breche"}), "cmd_abbrechen");
  AddCmd(({"opfer","opfere"}), "cmd_opfern");

  Licht("dunkel");
  Umgebung("warm", TT_CAVE, 1);

  set_exits("tgel");
  //set_exits("tor");

  pause=0;
  broken=({});
}

nosave int seq_check(string str)
{
  if((objectp(seq)) && (seq==TP) && !IS_WIZARD(TP)) return 1;
  return 0;
}

nosave int cmd_beten(string str)
{
  notify_fail(BS("Wollt Ihr zu Lloth beten?"));
  
  if(!str) return 0;
  
  if(member(({"lloth", "zu lloth", "loth", "zu loth"}), str)>-1)
    {
      write(BS("Ihr legt Euch vor den Altar und betet "
	       "zu Lloth, der Dunklen Herrin. Ihr spuert, dass ihr Blick "
	       "gefaellig auf Euch ruht ob dieses Zeichens Eurer "
	       "Ehrerbietung, und erhebt Euch wieder."));
      
      say(BS(TP->Name()+" legt sich vor dem Altar nieder und betet."),
	  ({TP}));

      return 1;
    }
  else
    if(member(({"woody", "zu woody", "dusty", "zu dusty"}), str)>-1)
    {
      write(break_string(
	     "`Du unwuerdiger Wurm wagst es tatsaechlich, HIER zu "
	     "einem anderen Gott zu beten??'\n"
	     "Ploetzlich erhebt sich die Spinne von ihrem Alter und "
	     "springt auf Euch herunter. Ihr seid starr vor Entsetzen, "
	     "koennt Euch nicht ruehren. Die Spinne beisst Euch, und "
	     "entsetzlicher Schmerz durchzieht Euren Koerper.",0,0,1));
      
      say(break_string(
	      TP->Name()+" wagt es tatsaechlich, HIER zu einem anderen Gott "
	      "zu beten!\n"
	      "Ploetzlich liegt "+TP->QueryPronoun(WER)+" starr vor "
	      "Entsetzen auf dem Boden und beginnt furchtbar zu schreien.",
	      0, 0, 1));
      
      TP->AddHp(-22-random(10)-random(10));

      return 1;
    }
  return 0;
}

nosave int cmd_beruehren(string str)
{
  notify_fail(BS("Was moechtet Ihr beruehren?"));

  if(!str) return 0;

  if(str=="stalagmit"||str=="spitze")
    {
      write(BS("Ihr beruehrt vorsichtig die Spitze des Stalagmiten. "
	       "Sie ist sehr, sehr hart und gibt nicht das kleinste bisschen "
	       "nach."));

      say(BS(TP->Name()+" beruehrt vorsichtig die Spitze des Stalagmiten."));

      return 1;
    }
  else
    if(str=="platte"||str=="steinplatte"||str=="altar")
      {
	write(BS("Ihr beruehrt vorsichtig die schwere Platte und "
		 "zuckt erschaudernd zusammen, als Euch die Macht Lloths "
		 "wie ein leichter Schlag trifft."));

	say(BS(TP->Name()+" beruehrt vorsichtig die Platte des Altars "
	       "und zuckt schaudernd zusammen."));

	return 1;
      }
  
  return 0;
}

nosave int cmd_abbrechen(string str)
{
  object ob;

  notify_fail(BS("Was moechtet Ihr abbrechen?"));

  if(!str) return 0;
  
  if(str=="stalagmit ab"||str=="spitze ab")
    {
      if(member(broken, getuid(TP))>=0)
	return write(BS("Denkt Ihr nicht, dass Ihr bereits genug angerichtet "
			"habt?")), 1;

      write(break_string(
	"Mit aller Kraft versucht ihr, die Spitze des"
        " Stalagmiten abzubrechen, aber anscheinend vermag keine Kraft"
        " dieser Welt ihn zu zerstoeren.\n\n"
        "Ihr habt jedoch das immer staerker werdende Gefuehl dass dieses"
        " Sakrileg ein ziemlich grosser Fehler war. Euch ist, als"
        " beobachte Euch eine dunkle, unheilvolle Macht, die Euch in der"
        " naechsten Zeit viel Unglueck bringen wird.", 0, 0, 1));

      say(BS(TPN+" versucht vergeblich, die Spitze des Stalagmiten "
	     "abzubrechen. Ihr seit Euch ziemlich sicher, dass "+
	     TP->QueryPronoun(WER)+" diesen Fehler noch bereuen wird."));

    ob=clone_object(OBJ "lloth_fluch");

        /*
	  Es gibt hier absichtlich keine Ueberpruefung, ob jemand schon einen
	  Fluch besitzt. Wer dreimal versucht, den Altar zu zerstoeren, dem
	  wird halt dreimal die Abwehr verringert...
        */
    ob->move(TP, M_NOCHECK);
    ob->DoWear(1);
    
    if(!random(3)) broken+=({getuid(TP)});
    
    return 1;
    }
  
  return 0;
}

void darkelf_fin(object who)
{
  gebe_perle(who);
  
  seq=0;
}

void other_fin(object who)
{
  who->SetProp(P_HP, 1);
  who->move(ROOM "tgel_1_4_0", M_GO,"","rennt davon",
            "stuermt kreidebleich herein");

  seq=0;
}

nosave int cmd_opfern(string str)
{
  notify_fail(BS("Wem moechtet Ihr was opfern?"));

  if(!str) return 0;
  if(str!="lloth blut" && str!="goettin blut") return 0;

  if(objectp(seq) && ENV(seq)==ME)
    return write(BS("Stoert "+seq->name()+" nicht beim opfern!")), 1;

  if(!present("\nlloth_schale", TP))
    return write(BS("Gerade wollt Ihr etwas von Eurem Blut opfern, als"
          " Euch bewusst wird, dass Ihr wohl noch ein geeignetes Gefaess"
          " braucht, in das Ihr das Blut fliessen lassen koennt, bevor Ihr"
          " es der ewigen Lloth darbringt.")),1;

  if(pause > time())
    return write(BS("Ihr fuehlt, dass sich die Magie seit der letzten "
		    "Opferung noch nicht wieder vollstaendig erholt hat.")), 1;
  
  seq=TP;

  if(TP->QueryProp(P_RACE)=="Dunkelelf") // Sequenz fuer Dunkelelfen
    StartSequence(ROOM "seq/schrein4_darkelf", seq, "darkelf_fin");
  else //  Sequenz fuer Nichtdunkelelfen
    StartSequence(ROOM "seq/schrein4_other", seq, "other_fin");
  
  GESINNUNG->Aendere_Gesinnung(TP, SCHREIN_TAFEL);
  
  pause=time()+60*2;
 
  return 1;
}
