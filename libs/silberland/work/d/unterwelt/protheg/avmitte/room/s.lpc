#include <properties.h>
#include <moving.h>
#include "../def.h"

inherit MOST "std_things";

nosave int step;
nosave string *sequence;
nosave string ret;
nosave object pl;

int StartSequence(string fname, object who, string fin)
{
  //if(find_call_out("NextSequence") != -1) 0;

  SUID;

  if(file_size(fname)<0) return -1;

  sequence=explode(read_file(fname), "\n");

  step=0;
  pl=who;
  ret=fin;

  call_out("NextSequence", 0);

  return 1;
}

void NextSequence()
{
  string str, how;
  int t;

  str=sequence[step++];

  sscanf(str,"%s %d", how, t);

  if(!how && str[0..2]=="end") how="end";

  switch(how)
    {
    case "all":
      while((str=sequence[step++])!="**")
	      tell_room(ENV(pl), BS(FormatString(str, pl)));
	    tell_room(ENV(pl),"\n");
      break;
    case "plr":
      while((str=sequence[step++])!="**")
  	    tell_object(pl, BS(FormatString(str, pl)));
  	  tell_object(pl,"\n");
      break;
    case "mix":
      while((str=sequence[step++])!="**")
	      tell_object(pl, BS(FormatString(str, pl)));
	    tell_object(pl,"\n");
      while((str=sequence[step++])!="**")
	      tell_room(ENV(pl), BS(FormatString(str, pl)), ({ pl }));
	    tell_room(ENV(pl),"\n");
      break;
    case "fun":
      funcall(sequence[step++]);
      break;
    case "end":
      if(ret!=0 && stringp(ret))
	      call_other(ME, ret, pl);
      return;
    default:
      DB("*** Sequencer Fehler in ("+step+")\n");
    }

  call_out("NextSequence",t);
}
