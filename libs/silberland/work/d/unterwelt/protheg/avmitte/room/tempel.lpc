nosave int keine_magier(object pl)
{
  if(getuid(pl)=="protheg") return 1;
  if(!IS_WIZARD(pl)) return 1;
  else return 0;
}

void seq_16()
{
  object *pls;
  int i;
  
  RMS("Die Hohepriesterin hebt den Kelch und ploetzlich beginnt die Hoehle zu beben! "
      "Ueber Eurem Kopf bildet sich eine kleine Wolke, die mit ihren Auslaeufern "
      "sehr spinnenfoermig aussieht.\n\n"
      "Die Hohepriesterin haelt ihren Kelch in die Hoehe, als er ploetzlich in "
      "einem eigenartigen gruenen Pulsieren erstrahlt, danach loest sich die Wolke "
      "wieder auf.\n\n");
  
  pls=users()-(filter_array(all_inventory(ME), CLOSURE(interactive)));
  
  pls=filter_array(pls, "keine_magier");
  
  for(i=sizeof(pls)-1;i>=0;i--)
    tell_object(pls[i],
		"Ein gewaltiges Beben durchzieht das Silberland...\n"
		"Du weisst, dass gerade etwas Wunderbares passiert ist.\n"+
		BS(s_sie+" und "+s_er+" haben sich gerade das Ja-wort gegeben"
		   "und die dunkle Herrin Lloth hat den Zweien ihren Segen "
		   "gegeben!"));

  stat++;
  
  call_out("seq_"+stat, 16);
}

