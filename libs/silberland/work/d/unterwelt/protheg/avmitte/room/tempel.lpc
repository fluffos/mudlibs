void seq_fin()
{
  DB("*** Hochzeit seq_fin\n");
  
  if(HZM->Keine_Hochzeit())
    if((objectp(er) && ENV(er)==TO) || (objectp(sie) && ENV(sie)==TO) ||
       (objectp(zeuge) && ENV(zeuge)==TO))
      RMS("Die Hohepriesterin meint zornig: 'Ihr seid noch immer da!?'\n\n");

  init_vars();
}

int PreventLeave(object who, mixed dest)
{
  object weg;
  
  DB("*** Tempel - PreventLeave "+sprintf("%O", who)+"\n");
    
  if(stringp(dest))
    if(dest==ROOM "vorraum")
      return ::PreventLeave(who,dest);

  if(HZM->Hochzeit_laeuft())
    {
      if(who->QueryProp(P_GHOST)) 
	return ::PreventLeave(who,dest);
      
      call_out("comeback", 1, who);
      
      return 0;
    }
  
  if((present(KLEIDUNG, who)) && (dest!=file_name(ME)))
    while(weg=present(KLEIDUNG, who))
      {
	weg->SetProp(P_CURSED, 0);
	weg->DoUnwear(1);
	weg->remove();
      }
  
  return ::PreventLeave(who,dest);
}

void comeback(object who)
{
  if(objectp(who) && (ENV(who)!=TO) && (!who->QueryProp(P_GHOST)))
    {
      tell_object(who,
		  "Eine Hohepriesterin teilt Dir mit: 'Hiergeblieben!'\n");
      who->move(TO, M_NOCHECK|M_SILENT|M_NO_SHOW);
    }
}

