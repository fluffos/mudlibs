		  CAP(s_er)+" ("+dtime(time())[0..16]+" um "+
		  to_int(dtime(time())[19..20])+" Uhr)");

  
  stat++;
  
  call_out("seq_"+stat, 20);
}

void seq_18()
{
  object ring1, ring2;

  if(jemand_fehlt()) return;
  
  RMS("Die Hohepriesterin schnippt mit den Fingern und haelt auf eimal einen "
      "juwelenbesetzen Dolch in der Hand....\n\n");

  tell_room(TO,
	    BS("Mit einem schnellen Schnitt hat die Hohepriesterin "+s_zeuge+
	       " etwas Haut von den Wunden abgeschnitten und legt sie in eine "
	       "bereitgestellte Schuessel. Mit zitternden Fingern hebt sie "
	       "die Schale und dunkelgrauer Rauch beginnt daraus zu quellen. "
	       "Danach uebergibt sie dem Brautpaar je einen Ring und "
	       "murmelt ein paar Worte..."), ({ er, sie, zeuge }));

  MS(zeuge,
     "Mit eine schnellen Schnitt hat Euch die Hohepriesterin ploetzlich etwas "
     "Haut bei Euren bereits klaffenden Wunden abgeschnitten!!! Nach einer "
     "kurzen rituellen Eintauchung werden die Hautstuecke um Ringe gewickelt "
     "und an das Brautpaar verteilt");

  MP("Mit einem schnellen Schnitt hat die Hohepriesterin "+s_zeuge+
     " etwas Haut aus den bereits vorhandenen Wunden geschnitten und "
     "legt sie in eine bereitgestellte Schuessel. Mit zitternden Fingern "
     "hebt sie die Schale und dunkelgrauer Rauch beginnt daraus zu quellen. "
     "Danach uebergibt sie Euch einen Ring aus der Schale.");

  ring1=clone_object(ARMOUR "married");
  ring1->SetProp(P_AUTOLOADOBJ, (["partner":lower_case(s_er),
				  "zeuge":lower_case(s_zeuge),
				  "datum":time()]));
  ring1->move(sie, M_NOCHECK);
  if(!ring1->DoWear())
    sie->command_me("trage ring");

  ring2=clone_object(ARMOUR "married");
  ring2->SetProp(P_AUTOLOADOBJ, (["partner":lower_case(s_sie),
				  "zeuge":lower_case(s_zeuge),
				  "datum":time()]));
  ring2->move(er, M_NOCHECK);
  if(!ring2->DoWear())
    er->command_me("trage ring");


  write_file(LOG "hliste",
	     dtime(time())+"\n"+
	     "---------------------------\n"
	     "     "+CAP(s_sie)+" und "+CAP(s_er)+
	     " sind den unheiligen Bund eingegangen.\n");

  tell_room(ROOM "vorraum",
	    "Eine Hohepriesterin kommt an.\n"
	    "Die Hohepriesterin traegt etwas auf der Wandtafel ein.\n"
	    "Die Hohepriesterin geht durch die Tore in den Tempel zurueck.\n");
  
  stat++;
  
  call_out("seq_"+stat, 22);
}

