/*
  Hochzeitszeremonie
  der unheilige Tempel
*/

#include "../def.h"

inherit MOST "std_room";

#define MS(x,y) tell_object(x, \
  break_string(y,78,"",BS_LEAVE_MY_LFS+BS_NO_PARINDENT))

#define MP(x) tell_object(er,  \
  break_string(x,78,"",BS_LEAVE_MY_LFS+BS_NO_PARINDENT)); \
              tell_object(sie, \
  break_string(x,78,"",BS_LEAVE_MY_LFS+BS_NO_PARINDENT))

#define RMS(x) tell_room(TO, \
  break_string(x,78,"",BS_LEAVE_MY_LFS+BS_NO_PARINDENT))

nosave int stat, delay, chat, tuerzu;
nosave object er, sie, zeuge;
nosave string s_er, s_sie, s_zeuge;

nosave void init_vars()
{
  stat=0;
  delay=0;
  chat=0;
  er=0;
  sie=0;
  zeuge=0;
  s_er=0;
  s_sie=0;
  s_zeuge=0;
}

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Das Auge von Ardulvhier");
  SetProp(P_INT_LONG,
	  BS("Ihr erstarrt bei dem Anblick, den Euch dieser unheilige Tempel "
	     "bietet. Der Raum wirkt von Innen viel groesser, Ihr kommt Euch "
	     "richtig klein und unbedeutend vor. Die Decke wird von einer "
	     "riesigen, magischen Scheibe eingenommen. Gehalten wird sie von "
	     "sechs gewaltigen Marmorsaeulen, die auf leicht gruenlich "
	     "leuchtenden Sockeln stehen. Die Waende sind mit schweren, "
	     "dunklen Seidenvorhaengen verhaengt und in regelmaessigen "
	     "Abstaenden sind trollhohe Abbilder der Goettin Lloth "
	     "aufgestellt. In der Mitte des Raumes, gleich unterhalb des "
	     "Zentrums der grossen Scheibe ruht eine Hohepriesterin auf "
	     "einem spinnenfoermigen Thron."));

  SetProp(P_NOQUIT, "Wagt es in diesen Hallen nicht!\n");
  SetProp(P_NOREST, "Wagt es in diesen Hallen nicht!\n");

  AddDetail(({"innen","tempel","hoehle","raum"}),
	    TO->QueryProp(P_INT_LONG));
  AddDetail(({"platten","marmorplatten","boden"}),
	    "Der Boden besteht aus quadratischen Marmorplatten, die mit "
	    "seltsamen Zeichen verziert sind.");
  AddDetail(({"hilfe","macht","zeichen"}),
	    "Die Zeichen sind verschiedene Zeichen des Schutzes, oder dienen "
	    "um die Macht der Dunkelelfenzauber zu fokussieren.");
  AddDetail("schutz",
	    "Sie schuetzen die Hohepriesterin mit ihrer Aura.");
  AddDetail("aura",
	    "Der Tempel ist wahrlich von einer gewaltigen Aura umgeben, die "
	    "mit Hilfe der Zeichen auf dem Boden, maechtige Dunkelelfenzauber "
	    "fokussieren kann.");
  AddDetail(({"dunkelelfenzauber","zauber","hohepriesterinnen"}),
	    "Unheilige Zauber, die die Hohepriesterinnen ausueben um ihrem "
	    "Volk zu helfen.");
  AddDetail("volk",
	    "Den Dunkelelfen natuerlich!");
  AddDetail("anblick",
	    "Ihr seid so ueberwaeltigt, dass Ihr es kaum wagt Euch zu "
	    "bewegen.");
  AddDetail("decke",
	    "Die Decke wird von einer gigantischen Scheibe eingenommen.");
  AddDetail("scheibe",
	    "Die Scheibe scheint mit einem Dunkelelfenzauber belegt zu sein, "
	    "denn hin und wieder aendert sich das Muster.");
  AddDetail(({"minuten","muster"}),
	    "Alle paar Minuten wechselt das Muster von Schlachten ueber "
	    "Bilder von beruehmten und maechtigen Dunkelelfen bis hin zu "
	    "den wirren Gedanken der Hohepriesterin.");
  AddDetail(({"schlacht","schlachten"}),
	    "Es handelt sich hauptsaechlich um die Schlachten zwischen den "
	    "Dunkelelfen und den Feenwesen.");
  AddDetail(({"bilder","dunkelelfen"}),
	    "Es handelt sich wohl um Bilder von maechtigen und beruehmten "
	    "Dunkelelfen.");
  AddDetail(({"saeulen","marmorsaeulen"}),
	    "Sechs der massivsten Marmorsaeulen, die Ihr je gesehen habt "
	    "halten eine gewaltige Scheibe. Im Zentrum des Saeulenkreises "
	    "befindet sich ein Thron, der wie sie auf einem leicht gruenlich "
	    "schimmernden Sockel steht.");
  AddDetail(({"priesterin","hohepriesterin"}),
	    "Sie scheint wohl gerade nicht da zu sein.");
  AddDetail("gedanken",
	    "Ihr koennt ihre Gedanken nicht interpretieren, aber es hat "
	    "sicher etwas mit der Spinnengoettin Lloth zu tun!");
  AddDetail(({"mitte","zentrum","saeulenkreis","kreis"}),
	    "Das Zentrum der Marmorsaeulen, sowie der Scheibe ueber ihnen ist "
	    "gleichzeitig auch die Mitte des Raumes.");
  AddDetail("thron",
	    "Ein spinnenfoermiger Thron steht hier, um die Macht der Zeichen "
	    "auf dem Boden zu fokussieren und die Hohepriesterin bei ihren "
	    "Zaubern zu unterstuetzen. Er besteht aus einem grossen "
	    "Marmorblock, auf dem ein Sitz aus dunklem Silber befestigt ist. "
	    "Davor steht ein kleiner Altar, scheinbar wird er fuer Blutopfer "
	    "benutzt, denn es liegen zwei Dolche darauf und ein kleiner "
	    "Obsidiankelch, der wohl das Blut auffangen soll steht daneben.");
  AddDetail(({"block","marmorblock","basis",}),
	    "Ein seltsam geformeter Block aus tiefschwarzem Marmor dient als "
	    "Basis fuer den Thron.");
  AddDetail(({"blut","kelch","obsidiankelch"}),
	    "Ein Obsidiankelch ziert den Altar. Offenbar wird in ihm waehrend "
	    "der Trauung das Blut aufgefangen.");
  AddDetail(({"krummdolch","krummdolche","dolch","dolche"}),
	    "Zwei lange Krummdolche liegen auf dem Altar und warten auf die "
	    "naechste Trauung.");
  AddDetail(({"opfer","blutopfer"}),
	    "Der Altar wird hauptsaechlich fuer die Trauung verwendet, doch "
	    "auch Hinrichtungen hat es hier gegeben!");
  AddDetail(({"zeremonie","rolle","trauung"}),
	    "In diesem unheiligen Tempel wird die Trauung zweier Dunkelelfen "
	    "vollzogen. Es ist auch bestimmten anderen Rassen unter "
	    "speziellen Bedingungen erlaubt, hier zu heiraten. Waehrend der "
	    "Trauung spricht die Hohepriesterin ein paar Worte zu dem "
	    "zukuenftigen Paar und die Gaeste stehen rundherum und verhalten "
	    "sich still. Danach wird der Trauzeuge in einer rituellen "
	    "Zeremonie den frischen Bund staerken. Sobald Lloth ihren Segen "
	    "dazu gegeben hat, ist die Trauung vorbei und die Hohepriesterin "
	    "versinkt wieder in ihre Konzentration.");
  AddDetail(({"rassen","bedingungen","charakter","frauen"}),
	    "Es duerfen auch andere Rassen heiraten, jedoch keine Elfen und "
	    "Feenwesen und die Frauen muessen einen satanischen Charakter "
	    "aufweisen!");
  AddDetail(({"worte"}),
	    "Wichtige, warnende wenn auch zukunftsweisende Worte!");
  AddDetail(({"paar","gaeste","trauzeuge","bund"}),
	    "Alle muessen anwesend sein, um den Segen Lloths fuer den "
	    "unheiligen Bund zu erflehen. Das Paar, ein Trauzeuge und Gaeste, "
	    "die der Hohepriesterin bei der Zeremonie geistig helfen.");
  AddDetail("segen",
	    "Ohne Lloths Segen ist eine Trauung hinfaellig!");
  AddDetail("konzentration",
	    "Die Hohepriesterin sitzt hier tagelang und uebt sich in "
	    "Konzentration, um die Dunkelelfenzauber besser fokussieren zu "
	    "koennen.");
  AddDetail(({"hinrichtung","hinrichtungen"}),
	    "Wenn der Tempel nicht fuer eine Trauung reserviert ist, kann es "
	    "schon mal vorkommen, dass hier eine Hinrichtung vollzogen wird.");
  AddDetail("marmor",
	    "Feinster tiefschwarzer Marmor!");
  AddDetail("silber",
	    "Finsterstes, kostbarstes Silber!");
  AddDetail(({"geflecht","sitz"}),
	    "Der Sitz ist ein spinnenfoermiges Geflecht aus dunklem Silber, "
	    "welches sich majestaetisch ueber den Marmorblock zieht.");
  AddDetail("altar",
	    "Dieser Altar scheint wohl eine wichtige Rolle bei der Trauung "
	    "zu spielen. Ein Kelch und zwei Dolche wurden bereitgestellt.");
  AddDetail(({"sockel","sockeln","gruen"}),
	    "Runde, in seltsamem Gruen leuchtende Sockeln tragen sechs "
	    "gewaltige Marmorsaeulen. Ihr koennt nicht erkennen, woraus sie "
	    "bestehen.");
  AddDetail(({"waende","fels","wand","vorhaenge","seidenvorhaenge"}),
	    "Die Waende wurden mit schweren, dunklen Seidenvorhaengen "
	    "behaengt, um den nackten, kahlen Fels zu verbergen.");
  AddDetail("seide",
	    "Eine relativ grobe, dunkle Seide wurde fuer die Vorhaenge "
	    "verwendet.");
  AddDetail("abstaende",
	    "In regelmaessigen Abstaenden sind Abbilder der Goettin Lloth "
	    "die Waende entlang aufgestellt.");
  AddDetail(({"statuen","frauenstatuen","spinnen","darstellung",
		"spinnenstatuen","abbilder"}),
	    "Hohe Spinnen- oder Frauenstatuen, die die Spinnengoettin Lloth "
	    "darstellen sollen. Offene Haare, ein wilder, boeser Blick und "
	    "eine Schlangenpeitsche ist die haeufigste Darstellung, doch es "
	    "gibt auch Statuen, die aussehen, als wuerden sie eine andere "
	    "Gestalt segnen. Vor manchen Statuen liegen Schalen mit "
	    "Opfergaben.");
  AddDetail("gestalt",
	    "Wohl eine Hohepriesterin!");
  AddDetail(({"goettin","lloth","spinnengoettin","dunkelelfenfrau","frau",
		"gesicht","gesichter"}),
	    "Lloth hat viele Gesichter, dennoch wird sie oft als "
	    "wunderschoene, halbnackte Dunkelelfenfrau mit wallenden Haaren, "
	    "einem wilden, boesen Blick und einer Schlangenpeitsche "
	    "dargestellt.");
  AddDetail("haare",
	    "Lange, weisse Haare.");
  AddDetail(({"ehrfurcht","knie","blick"}),
	    "Ein Blick der Euch erstarren und vor Ehrfurcht auf die Knie "
	    "fallen laesst!");
  AddDetail(({"peitsche","schlangenpeitsche","symbol"}),
	    "Die Schlangenpeitsche ist das Symbol Lloths schlechthin!");
  AddDetail(({"schale","schalen"}),
	    "Einige Schalen mit Opfergaben stehen bei den Abbildern Lloths.");
  AddDetail(({"gaben","opfergaben","stuecke","feenwesen","ohren","zungen",
		"elfenohren","elfenzungen","lebewesenteile",
		"oberflaechenlebewesenteile","elfen"}),
	    "Bei den Opfergaben handelt es sich hauptsaechlich um Stuecke "
	    "von Feenwesen, Elfenohren, Elfenzungen und sonstigen "
	    "Oberflaechenlebewesenteilen.");
  AddDetail(({"tor","ausgang"}),
	    "Den Ausgang bildet ein gewaltiges Tor aus dunklem Eichenholz.");
  AddDetail(({"holz","eichenholz"}),
	    "Dunkles massives Eichenholz.");
  AddDetail(({"waechter","dunkelelfenwaechter","wache","wachen",
		"dunkelelfenwache","dunkelelfenwachen"}),
	    "Zwei steinern wirkende Dunkelelfenwaechter stehen neben dem "
	    "Ausgang und beobachten jeden Eurer Schritte!");


  AddSound(({"stille","totenstille", DEFAULT_SOUND}),
	   "Es herrscht Totenstille.");

  AddSmell(DEFAULT_SMELL,
	   "Es riecht etwas modrig.");
  AddSmell(({"moder"}),
	   "Es riecht irgendwie nach Moder, aber auch nach getrocknetem "
	   "Blut.");
  AddSmell(({"geruch","blutgeruch","blut","altar"}),
	   "Der Geruch von trockenem Blut weht vom Altar herueber.");

  AddExit("tor",
	  ([EX_DEST:ROOM "vorraum",
	  EX_TESTFUNC:"raumverlassen",
	  EX_MSG:"durch die Tore hinaus"]));

  Licht("dunkel");
  Umgebung("maessig", TT_CAVE, 1);

  AddCmd("", "nospell", 1);
  
  init_vars();
  
  SUID;
  
  AddItem(NPC "priesterin", REFRESH_DESTRUCT);
}

nosave int IsDarkelf(object who)
{
  if(who->QueryProp(P_RACE)=="Dunkelelf") return 1;
  else return 0;
}

int raumverlassen(string str)
{
  if((HZM->Hochzeit_laeuft()) || (tuerzu))
    return MS(TP, "Die Waechter lassen Euch nicht passieren.\n"
	   "Die Hohepriesterin funkelt Euch an und meint: 'Hiergeblieben!'"),0;
  return 1;
}

nosave int nospell(string str)
{
  if(HZM->Hochzeit_laeuft() || HZM->Vorbereitungen())
    if(member((TP->QueryProp(P_NEWSKILLS))+(["toete":1]), 
	      lower_case(query_verb())))
      return write("Die dunkle Macht dieses Tempels stoert Euch in Eurer "
		   "Konzentration!\n"), 1;
  return 0;
}

varargs string GetExits(object viewer)
{
  if((HZM->Hochzeit_laeuft()) || (tuerzu))
    return "Waehrend einer Trauung ist das Verlassen des Tempels verboten!\n";
  else
    return "Ihr koennt den Raum durch das 'Tor' verlassen.\n";
}

nosave int jemand_fehlt()
{
  int flag;

  delay=0;
  flag=0;

  if(!HZM->Hochzeit_laeuft()) return 0;

  if(!present("lotu-varia"))
    {
      RemoveItem(NPC "priesterin");
      AddItem(NPC "priesterin", REFRESH_DESTRUCT);
    }
  
  if((!objectp(er))    || (!present(er)))    flag=1;
  if((!objectp(sie))   || (!present(sie)))   if(flag) flag=4; else flag=2;
  if((!objectp(zeuge)) || (!present(zeuge))) if(flag) flag=4; else flag=3;

  DB("*** Hochzeit: Seq: "+stat+" "+
     (flag ? "jemand fehlt - flag="+flag:"")+"\n");
  
  if(flag)
    {
      delay=1;
      
      RMS("Die Hohepriesterin erschrickt ploetzlich!");
      
      switch(flag)
	{
	case 1:
	  RMS("Die Hohepriesterin fragt: Wo ist "+HZM->Braeutigam()+
	      " abgeblieben?!!");
	  break;
	case 2:
	  RMS("Die Hohepriesterin fragt: Wo ist "+HZM->Braut()+
	      " abgeblieben?!!");
	  break;
	case 3:
	  RMS("Die Hohepriesterin fragt: Wo ist "+HZM->Zeuge()+
	      " abgeblieben?!!");
	  break;
	case 4:
	  RMS("Die Hohepriesterin fragt: Wo sind denn alle "
	      " abgeblieben?!!");
	  break;
	}
      RMS("Die Hohepriesterin meint erzuernt:\n"
	  " `Wenn bis in 10 Minuten nicht wieder alle hier sind, '\n"
	  " `werde ich die Trauung abbrechen!'\n\n");
      
      call_out("Ultimatum_vorbei", 600);
    }

  return delay;
}

void BrautBeendetHochzeit()
{
  RMS("Die Hohepriesterin meint sichtlich enttaeuscht:\n"
      "  'Nun, "+s_sie+" scheint es sich anders ueberlegt zu haben. Und nun "
      "verschwindet!'\n\nMit diesen Worten laesst sie sich auf ihren Thron "
      "nieder und beginnt zu beten...\n\n");
  MS(sie,
     "Ihr denkt . o O (Ob das die richtige Entscheidung war?\n"+
     s_er+" blickt Euch total enttaeuscht an.\n");
  MS(er,
     "Ihr blickt "+s_sie+" enttaeuscht an und wendet Euch von ihr ab.\n");

  write_file(LOG "hochzeit",
	     ctime()+" - "+s_sie+" sagt 'Nein'\n");

  stat=666;

  HZM->Hochzeit_fertig(1);

  tuerzu=0;

  call_out("seq_fin", 60);
}

void BraeutigamBeendetHochzeit()
{
  stat=666;

  HZM->Hochzeit_fertig(1);
  
  RMS("Die Hohepriesterin wird bleich und schnappt kurz nach Luft...\n"
      "Die Hohepriesterin zueckt Lloths Zorn.\n"
      "Die Hohepriesterin bruellt:\n"
      "  `Ich habe Euch gewarnt "+s_er+", doch Ihr habt es trotzdem getan!'\n"
      "  `Nun werdet Ihr es buessen!'\n\n");
  tell_room(TO,
	    "Mit diesen Worten stuerzt sie sich auf "+s_er+".\n",({er}));
  MS(er,
     "Mit diesen Worten stuerzt sie sich auf Euch.\n"
     "Spinnweben fallen ploetzlich auf Euch herab...\n");

  RMS("Die Hohepriesterin greift mit ihrer Peitsche an.\n");

  er->SetProp(P_TMP_DIE_HOOK, 0); //der soll sterben!

  er->Defend(800, ({DT_TERROR, DT_MAGIC, DT_UNHOLY, DT_RIP}),
	     0, present("hohepriesterin"));

  RMS("Die Hohepriesterin spricht einen maechtigen Zauber...\n");

  er->Defend(500000, ({DT_TERROR, DT_MAGIC, DT_UNHOLY, DT_RIP, DT_SLASH}),
	     0, present("hohepriesterin"));

  SetProp(P_KILL_NAME, "Lotu-Varia");
  if(!er->QueryProp(P_GHOST)) er->do_damage(10000);
  
  write_file(LOG "hochzeit",
	     ctime()+" - "+s_er+" sagt 'Nein'\n");
  
  tuerzu=0;
  
  call_out("StirbBraeutigam2", 4);
}

void StirbBraeutigam2()
{
  RMS("Die Hohepriesterin grinst daemonisch.\n"
      "Die Hohepriesterin meint:\n"
      " `Das habt Ihr nun davon! Und nun verlasst mich!'\n"
      "Die Hohepriesterin setzt sich zurueck auf ihren Thron...\n\n");
  
  call_out("seq_fin", 60);
}

int QuerySieOk()
{
  if(stat==11) return 1;
  return 0;
}

int QueryErOk()
{
  if(stat==13) return 1;
  return 0;
}

void init()
{
  ::init();

  if(interactive(TP) && HZM->Vorbereitungen()) 
    call_out("checkenter", 1);
}

void checkenter()
{
  if(!objectp(er)) 
    { 
      if(er=find_player(HZM->Braeutigam()))
	s_er=CAP(getuid(er)); 
    }

  if(!objectp(sie)) 
    { 
      if(sie=find_player(HZM->Braut()))
	s_sie=CAP(getuid(sie)); 
    }
  
  if(!objectp(zeuge)) 
    { 
      if(zeuge=find_player(HZM->Zeuge()))
	s_zeuge=CAP(getuid(zeuge)); 
    }
  
  if(!present("lotu-varia"))
    {
      RemoveItem(NPC "priesterin");
      AddItem(NPC "priesterin", REFRESH_DESTRUCT);
    }

  if(present(TP, ME))
    {
      call_out("check4hochzeit", 2);

      if(er==TP)
	return RMS("Die Hohepriesterin laechelt boese und meint: "
		   "`Ah, der Braeutigam!'\n");

      if(sie==TP)
	return RMS("Die Hohepriesterin schaut auf und meint: "
		   "`Ah, die von Lloth gesegnete Braut!'\n");

      if(zeuge==TP)
	return RMS("Die Hohepriesterin reibt die Haende und meint: "
		   "`Ah, der Trauzeuge!'\n");

      RMS("Die Hohepriesterin meint: `Ah, ein Gast. Benehmt Euch!'\n");
    }
}

void check4hochzeit()
{
  if(objectp(er) && present(er, ME))
    if(objectp(sie) && present(sie, ME))
      if(objectp(zeuge) && present(zeuge, ME))
	if(delay)
	  {
	    if((stat < 2) && (stat > 665)) return;
	    
	    RMS("Die Hohepriesterin meint:\n"
		" `Endlich sind alle wichtigen Teilnehmer wieder anwesend. '\n"
		" `In Kuerze kann ich mit der Zeremonie fortfahren.'\n");
	    
	    while(remove_call_out("Ultimatum_vorbei")!=-1);
	    
	    delay=0;
	    
	    call_out("seq_"+stat, 10);
	  }
	else
	  {
	    if(tuerzu) return;

	    if(HZM->Geschlossene_Gesellschaft())
	      RMS("Die Hohepriesterin meint:\n"
		  " `Nun sind alle wichtigen Teilnehmer anwesend.'\n"+
		  " `Ich werde mich nun auf den Beginn der Zeremonie "
		  "konzentrieren.'\n");
	    else
	      {
		RMS("Die Hohepriesterin meint:\n"
		    " `Nun sind alle wichtigen Teilnehmer anwesend.'\n"+
		    " `Ich warte noch auf ein paar Gaeste, dann werde ich mit'\n"
		    " `der Zeremonie beginnen.'\n");
		
		tell_room(find_object(ROOM "vorraum"),
			  "Die Dienerin sagt: 'Die Hochzeitszeremonie wird "
			  "in Kuerze beginnen!\n"
			  "Die Dienerin sagt: Nach dem Beginn wird der "
			  "Einlass verwehrt.'\n");
	      }
	    
	    call_out("rauswerfen", 2);
	    
	    tuerzu=1;
	    
	    call_out("start_hochzeit", 60);
	  }
}

int check_einladungen(object pl)
{
  if(!HZM->Eingeladen(getuid(pl))) return 1;
  return 0;
}

void rauswerfen()
{
  int i;
  object *pls;

  if(!HZM->Vorbereitungen()) return;
  if(!tuerzu) return;

  if(!HZM->Geschlossene_Gesellschaft()) return;

  pls=filter_array(all_inventory(), CLOSURE(interactive));
  pls-=({er, sie, zeuge});

  if(!sizeof(pls=filter_array(pls, CLOSURE(check_einladungen)))) return;

  DB("*** Hochzeit: "+sizeof(pls)+" Spieler sind nicht eingeladen!!\n");

  for(i=sizeof(pls)-1; i >= 0; i--)
    {
      tell_object(pls[i], 
	  BS("Die Hohepriesterin schickt Euch hinaus, da Ihr nicht geladen "
	     "seid!"));
      pls[i]->move(ROOM "vorraum", M_GO, "durch die Tore hinausgefuehrt", 
		   "wird", "kommt herein");
    }
  
}

void Ultimatum_vorbei()
{
  if(!delay) return;
  if(!HZM->Hochzeit_laeuft()) return;

  DB("*** Hochzeit: 10-Minuten Ultimatum abgelaufen!\n");

  RMS("Die Hohepriesterin meint erzuernt:\n"
      " `Die Zeit ist um! Ich breche hiermit die Trauung ab.'\n"
      " `Es wird heute keine weiteren Hochzeiten mehr geben!'\n\n"
      "Danach kehrt die Hohepriesterin wieder zu ihrem Thron zurueck\n"
      "und beginnt zu beten.\n\n");
  
  stat=666;
  
  HZM->Hochzeit_fertig(1);
  
  tuerzu=0;
  
  call_out("seq_fin", 60);
}  

void start_hochzeit()
{
  object lotu;

  if(!HZM->Vorbereitungen()) return;

  HZM->Starte_Hochzeit();

  lotu=present("priesterin");
  chat=lotu->QueryProp(P_CHAT_CHANCE);
  lotu->SetProp(P_CHAT_CHANCE, 0);

  stat=2;

  RMS("Die Hohepriesterin meint: `Nun, da alle wichtigen Teilnehmer anwesend sind...'\n"
      "Die Hohepriesterin nickt mit dem Kopf, worauf sich zwei Wachen vor dem Tor "
      "postieren und ihre Waffen demonstrativ vor dem Tor ueberkreuzen.\n\n"
      "Die Hohepriesterin breitet die Arme aus...\n"
      "... und ihre Augen leuchten eigenartig auf.\n\n");

  er->SetProp(P_FROG,0);
  er->SetProp(P_BLIND,0);
  er->SetProp(P_DEAF, 0);
  er->SetProp(P_GHOST, 0);
  er->heal_self(500);

  sie->SetProp(P_FROG,0);
  sie->SetProp(P_BLIND,0);
  sie->SetProp(P_DEAF, 0);
  sie->SetProp(P_GHOST, 0);
  sie->heal_self(500);

  zeuge->SetProp(P_FROG,0);
  zeuge->SetProp(P_BLIND,0);
  zeuge->SetProp(P_DEAF, 0);
  zeuge->SetProp(P_GHOST, 0);
  zeuge->heal_self(500);

  call_out("seq_"+stat, 12);
}

