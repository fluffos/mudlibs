/*
  Tempelgelaende Ardulvhier
*/

#include "../def.h"

inherit MOST "std_room";

#define MAX_FLECHTEN 3

nosave int flechte, last;
nosave string last_name;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Fusse eines gewaltigen Stalagmiten");
  SetProp(P_INT_LONG,
	  BS("Ihr wandert durch die unheiligen Tempelanlagen von Ardulvhier "
	     "und werdet das Gefuehl nicht los, dass Ihr beobachtet werdet... "
	     "Neben Euch ragt ein gewaltiger Stalagmit in die Hoehe. Er "
	     "erscheint etwas seltsam, denn er ist nicht kegelfoermig wie die "
	     "anderen Stalagmiten. Er ist oben ziemlich abgeflacht und bildet "
	     "fast schon einen Diskus. Darin befindet sich der wohl "
	     "maechtigste Tempel der ganzen Stadt. Ein grosser "
	     "Gesteinsbrocken liegt vor Euch auf dem Boden."));

  AddDetail(({"boden"}),
	    "Den Boden bildet ein Mosaik aus faustgrossen, dunklen Steinen, "
	    "die fein, saeuberlich glattgeschliffen wurden.");

  AddDetail(({"stein","steine"}),
	    "Hunderte von faustgrossen Steinen bilden ein dunkles Mosaik auf "
	    "dem Boden.");

  AddDetail(({"muster","mosaik"}),
	    "Ihr koennt das Muster, dass das Mosaik bildet nicht genau "
	    "erkennen, jedoch fallen Euch hie und da in den Boden eingelegte "
	    "Runensteine auf.");

  AddDetail(({"runenstein","runensteine"}),
	    "Das Mosaik am Boden ist mit seltsamen Runensteinen gespickt, "
	    "wahrscheinlich sind es unheilige Zeichen, die fuer bestimmte "
	    "Zauber notwendig sind.");

  AddDetail(({"zauber","zeichen"}),
	    "Dunkelelfenpriesterinnen verwenden oft bestimmte uralte Zeichen "
	    "auf Runensteinen, um ihre Zauber zu verstaerken.");

  AddDetail(({"priesterin","priesterinnen","dunkelelfenpriesterin",
		"dunkelelfenpriesterinnen"}),
	    "Dunkelelfenpriesterinnen halten sich meisstens in einem Tempel "
	    "auf...");

  AddDetail("himmel",
	    "Wo wollt Ihr denn in einer Hoehle einen Himmel sehen?");

  AddDetail(({"hoehlendecke","decke"}),
	    "Die Decke der Hoehle ist viel zu weit oben, als dass man etwas "
	    "erkennen koennte!");

  AddDetail(({"stadt","ardulvhier","tempelanlagen","anlagen"}),
	    "Ihr befindet Euch hier in den Tempelanlagen der Stadt "
	    "Ardulvhier. Einst wurde ein gewaltiger Stalagmit der in der "
	    "Mitte der Hoehle stand zu einem Tempel auserkoren "
	    "und von da an wird die Hoehle rund herum als Gebetsstaette "
	    "genutzt. Ein seltsames Gefuehl erfuellt Euch, als ob Ihr hier "
	    "nicht allein seit...");

  AddDetail(({"inneres","tempel","stalagmit"}),
	    "Der abgerundete Stalagmit beherbergt in seinem Inneren den "
	    "maechtigsten Tempel von Ardulvhier, vielleicht solltet Ihr "
	    "ihn Euch mal ansehen. Der Eingang befindet sich im Suedosten.");
  
  AddDetail(({"zentrum","hoehle","mitte"}),
	    "Ihr befindet Euch hier im Zentrum der Hoehlen von Ardulvhier. "
	    "Genau in der Mitte der Hoehle befindet sich ein seltsam "
	    "geformter Stalagmit.");

  AddDetail("hoehlen",
	    "Ardulvhier ist auf mehrere Hoehlen aufgeteilt, jede Hoehle "
	    "beherbergt einen bestimmten Teil der Stadt.");

  AddDetail(({"teile","teil"}),
	    "Jeder Teil von Ardulvhier ist in sich abgeschlossen. Du "
	    "solltest die Teile einmal besuchen.");

  AddDetail("hoehe",
	    "Ihr blickt in die Hoehe und seht... Dunkelheit!");

  AddDetail(({"augen","dunkelheit"}),
	    "So sehr Ihr Eure Augen auch anstrengt, da ist nichts "
	    "erblickenswertes!");

  AddDetail("eingang",
	    "Der Eingang liegt weiter suedoestlich.");

  AddDetail("gefuehl",
	    "Ein seltsames Gefuehl umschleicht Euch andauernd... Es ist als "
	    "ob Ihr beobachtet werdet, jedoch koennt Ihr niemanden sehen.");
  
  AddDetail(({"gebetsstaette","staette"}),
	    "Hie und da sind rund um den Stalagmiten Schreine aufgestellt, "
	    "an denen man der dunklen Goettin Lloth huldigen, oder ihr ein "
	    "Opfer bringen kann.");

  AddDetail(({"goettin","lloth","dunkle goettin"}),
	    "Die gesamten Tempelanlagen sind der dunklen Goettin Lloth "
	    "gewidmet.");

  AddDetail(({"schrein","schreine","opfer"}),
	    "Etwas weiter, entlang des Stalagmites sind einige Schreine "
	    "aufgestellt. Dort kann man Lloth huldigen und ihr Opfer "
	    "darbringen.");
  
  AddDetail(({"form","diskus"}),
	    "Der Stalagmit ist ziemlich flach, und hat schon fast die Form "
	    "eines Diskus.");
  
  AddDetail(({"steinbrocken","brocken","gesteinsbrocken"}),
	    "Der Gesteinsbrocken duerfte frueher einmal wohl ein Stalagtit "
	    "gewesen sein, der im Laufe der Zeit durch Erschuetterungen der "
	    "Oberwelt von der Decke herabgefallen ist und hier unten "
	    "aufgeschlagen ist.");
  
  AddDetail(({"erschuetterung","erschuetterungen"}),
	    "Durch Erschuetterungen der Oberwelt loesen sich hin und wieder "
	    "ein paar Stalagtiten von der Decke und fallen hinab.");

  AddDetail(({"oberwelt"}),
	    "Die Oberwelt befindet sich weiter oben...");

  AddDetail(({"unterwelt","reich","dunkelelfen","dunkelelfenreich"}),
	    "Ihr befindet Euch hier in der Unterwelt... Dem Reich der "
	    "Dunkelelfen!");

  AddDetail(({"zeit","lauf","lauf der zeit","laufe der zeit"}),
	    "Diese Hoehle ist schon uralt!");

  AddDetail(({"stalagtiten"}),
	    "Hoch ueber Euch haengen davon noch mindestens weitere "
	    "einhundert...");
  
  AddDetail(({"stalagtit"}),
	    "Der Stalagtit liegt in einige Stuecke zerfallen vor Euch und "
	    "ist mit einigen Flechten und Moosen uebersaeht.");
  
  AddDetail(({"stueck","stalagtitstueck","stalagtitenstueck","stuecke",
		"stalagtitstuecke","stalagtitenstuecke"}),
	    "Die Stalagtitenstuecke liegen quer ueber den Boden verteilt "
	    "herum.");
  
  AddDetail(({"moos","moose"}),
	    "Weiches, saftiges Moos ueberzieht beinahe die ganzen "
	    "Stalagtitenstuecke. Scheinbar tropft von oben Wasser herab "
	    "und laesst es wachsen...");

  AddDetail(({"flechte","flechten"}),
	    "Ein Geaest aus festgewachsenen Flechten breitet sich rund um die "
	    "Gesteinsbrocken aus.");

  AddDetail(({"geaest"}),
	    "Ein wirres Geaest aus Flechten hat sich um den zerstoerten "
	    "Stalagtiten gebildet.");

  AddDetail(({"wasser","tropfen","wassertropfen"}),
	    "Du kannst die Wassertropfen nur hoeren.");
  
  AddSound(DEFAULT_SOUND,
	   "Es herrscht eine andaechtige Stille. Nur hin und wieder hoerst "
	   "Du einen Wassertropfen herabtropfen.");

  AddSound(({"stille"}),
	   "--------------------< stille >--------------------");

  AddSound(({"plopp","platsch","wasser","wassertropfen","tropfen"}),
	   "Hin und wieder scheint ein Wassertropfen von der Decke auf das "
	   "Moos zu tropfen...");
  
  AddSmell(DEFAULT_SMELL,
	   "Es riecht etwas nach Weihrauch...");

  AddSmell(({"rauch","weihrauch","schrein","schreine"}),
	   "Von den Schreinen her weht Euch etwas Weihrauch entgegen...");
  
  AddRoomMessage(({"*plopp*\n", "*platsch*\n"}), 60);
  
  Licht("duester");
  Umgebung("warm", TT_CAVE, 1);
  
  set_exits("tgel");
  //set_exits("tor");
  
  AddCmd(({"reisse","reiss","rupf","rupfe"}), "reissenfkt");
  
  flechte=MAX_FLECHTEN;
  last=0;
  last_name=0;

  AddItem(NPC "tw", REFRESH_DESTRUCT);
}

void reset()
{
  flechte=MAX_FLECHTEN;
  last=0;
  last_name=0;
  
  ::reset();
}

nosave int reissenfkt(string str)
{
  object fl;

  notify_fail(BS("Woran wollt Ihr reissen?"));
  if(!str) return 0;
  
  if(strstr(str, "flecht")==-1) return 0;
  
  if(last > time() && last_name==getuid(TP))
    return write(BS("Ihr muesst noch kurz verschnaufen!")), 1;
  
  if(!flechte) 
    return write(BS("Ihr zerrt an einer Flechte, doch sie gibt nicht "
		    "nach!")), 1;
  
  last=time()+4;
  last_name=getuid(TP);
  
  if(TP->QueryAttribute(A_STR) < 5+random(10))
    return write("Ihr zerrt an einer Flechte, doch Ihr seid zu schwach!\n"
		 "Probiert es doch gleich noch einmal!\n"),1;
  
  flechte--;
  
  write(BS("Mit einem kraeftigen Ruck schafft Ihr es, eine der Flechten "
	   "aus dem Geaest herauszureissen..."));
  
  fl=clone_object(OBJ "flechte");
  
  if(fl->move(TP)==ME_TOO_HEAVY)
    {
      fl->move(ME);
      write(BS("Die Flechte gleitet Euch aus der Hand..."));
    }
  
  return 1;
}
