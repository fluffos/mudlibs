#include "../def.h"

inherit MOST "std_room";

#define ANSCHLUSS_AV "/d/unterwelt/protheg/av/room/tor_5_17_5"

create() 
{
  ::create();
  
  SetProp(P_INT_SHORT, "Vor einem massiven Stahltor");
  SetProp(P_INT_LONG,
	  BS("Der breite Weg endet hier abrupt vor einem massiven, in eine "
	     "Mauer eingelassenen, Tor. Die gewaltige Mauer zieht sich "
	     "von einer riesigen Saeule im Nordwesten weiter bis zur "
	     "Hoehlenwand im Suedosten und trennt somit das Tempelgelaende "
	     "vom nordoestlichen Teil Ardulvhiers."));

  AddDetail(({"boden","marmorboden"}),
	    "Der Boden hier besteht aus nacktem schwarzen Marmor, genauso "
	    "wie die gewaltige Mauer vor Euch.");
  
  AddDetail(({"marmor","schwarzer marmor"}),
	    "Hier vor dem Tor scheint alles aus schwarzem Marmor zu bestehen. "
	    "Keinerlei Verzierungen, oder sonstige Ornamente.");
  
  AddDetail(({"verzierungen","ornamente","verzierung","ornament"}),
	    "Hier beim Tor koennt Ihr keinerlei Verzierungen oder Ornamente "
	    "erkennen.");
  
  AddDetail(({"hoehlendecke","decke"}),
	    "Die Hoehlendecke koennt Ihr von hier herunten nicht erkennen.");
  
  AddDetail(({"weg"}),
	    "Der Weg vom bzw. zum Tempelgelaende endet hier abrupt mit dem "
	    "schwarzen Marmorboden.");
  
  AddDetail(({"gelaende","tempelgelaende"}),
	    "Das Tempelgelaende erstreckt sich von hier aus nach Suedwesten.");
  
  AddDetail(({"wand","waende","hoehlenwand","hoehlenwaende"}),
	    "Weiter suedoestlich endet die grosse Mauer an der Hoehlenwand.");
  
  AddDetail(({"mauer","marmormauer"}),
	    "Eine gewaltige Mauer aus schwarzem Marmor, die sich zwischen "
	    "einer riesigen Saeule im Nordwesten und der Hoehlenwand weiter "
	    "im Suedosten befindet, trennt das Tempelgelaende vom "
	    "nordoestlichen Teil Ardulvhiers.");
  
  AddDetail(({"ardulvhier","stadt"}),
	    "Ihr befindet Euch gerade hier in der Stadt Ardulvhier.");
  
  AddDetail(({"saeule"}),
	    "Im Nordwesten befindet sich eine riesige Saeule, scheinbar "
	    "ist sie eine der Saeulen, die die Hoehlendecke tragen.");
  
  AddDetail(({"stadtteil","teil","nordoestlicher teil","nordoestlichen teil",
		"nordoestlicher stadtteil","nordoestlichen stadtteil"}),
	    "Der Teil von Ardulvhier befindet sich im Nordosten. Ihr koennt "
	    "ihn durch das Tor erreichen.");
  
  AddDetail(({"tor"}),
	    "Das Tor besteht vollkommen aus einem blaeulich schimmernden "
	    "Pilz. Obwohl er weich aussieht, scheint er doch steinhart zu "
	    "sein, denn Ihr koennt ihn nicht bewegen, nichteinmal einritzen.");
  
  AddDetail(({"pilz"}),
	    "Das Tor scheint aus einem magisch verstaerkten Pilz zu bestehen.");
  
  AddSound(({"stille",DEFAULT_SOUND}),
	   "Hier herrscht eine angenehme Stille.");
  
  AddSmell(DEFAULT_SMELL,
	   "Ihr vernehmt einige Geruchsfetzen vom Tempelgelaende her, jedoch "
	   "koennt ihr sie nicht genau einordnen...");
  
  AddSmell(({"fetzen","geruchsfetzen"}),
	   "Ihr koennt sie nicht genau einordnen...");
  
  Licht("duester");
  Umgebung("warm", TT_CAVE, 1);
  
  set_exits("tgel");
  AddExit("tor", ([EX_DEST: ANSCHLUSS_AV,
		   EX_PLMSG: "Du durchschreitest den Tunnel.\n"+
		   BS("Als Du den Tunnel wieder verlaesst, geleiten "
		      "Dich zwei Wachen bis zum Stadttor hinaus, da "
		      "dieser Stadtteil zur Zeit nicht betreten "
		      "werden darf.")+
		   BS("Du betrittst den Verbindungstunnel zum "
		      "aeusseren Stadttor..."),
		   EX_MSG: "in die Dunkelelfenstadt Ardulvhier"]));
}

