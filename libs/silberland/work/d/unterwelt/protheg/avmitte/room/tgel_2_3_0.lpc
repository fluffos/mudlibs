/*
  Der Schrein "Die Kinder Lloths"
  Einer der Schreine im Tempelbezirk von Ardulvhier

  Macalla + Tyron, Mai 2001

  Finalisiert by PROtheG, Oktober 2001
*/

#include "../def.h"

inherit MOST "std_room";
inherit ROOM "s";

#define MAX_OPF_SUM  8
#define MAX_OPF_PL   2

nosave object seq;
nosave int Opf_sum;
nosave mapping Opf_pl;

/*
  In dieser Funktion erhaelt ein Spieler, der ein Opfer dargebracht hat,
  seine Lebenspunkte zurueck.
*/
nosave int Addiere_HP(object pl)
{
  int opf_count;

  if((!objectp(pl)) || (ENV(PL)!=ME)) return -1;
  
  //  if (pl->QueryProp( P_GUILD) != "dunkelelfen") return 0;
  
  if(Opf_sum>=MAX_OPF_SUM)  // Max zulaessige Opfer erreicht?
    return 0;
  
  opf_count=Opf_pl[pl];
  
  if(opf_count < MAX_OPF_PL) // Max zulaessige Opfer fuer Spieler erreicht?
    {
      write(BS("Doch dann spuehrt Ihr, wie sich der Schmerz in pure "
	       "Kraft wandelt, die Euch durchfliesst ... Offensichtlich ist "
	       "Lloth mit Euch zufrieden - sie sei auf ewig gepriesen!!"));
      
      pl->AddHp(pl->QueryProp(P_MAX_HP));

      Opf_pl[pl]=opf_count+1;
    }
  
  return 1;
}

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Die Kinder Lloths");
  SetProp(P_INT_LONG,
	  BS("Ihr steht in einer Hoehle aus Spinnweben. Sie bedecken die "
	     "Saeulen um Euch herum, haengen wie schweres Tuch dazwischen "
	     "und spannen sich ueber Euch wie ein Baldachin. Das dicke "
	     "Gewebe pulsiert und bewegt sich, als wuerden tausende und "
	     "abertausende winziger Wesen darin leben. In der Mitte des "
	     "Platzes kauert eine grosse Spinne, die Euch das Gefuehl "
	     "goettlicher Allmacht vermittelt. Ihr seid Euch sicher, dass "
	     "es eine toedliche Dummheit waere, diese Verkoerperung Lloths "
	     "anzugreifen. Rings um euch herum am Fusse der Spinnweben "
	     "liegen die Knochen derer, die diesen Fehler begangen haben."));

  AddDetail(({"hoehle","raum"}),
     "Ihr steht in einer kleinen runden Hoehle, die aus einem dicken,"
     " undurchdringlichen Gespinst aus Spinnweben gebildet wird.");

  AddDetail(({"saeulen","verzierungen"}),
     "Die Saeulen sind ueber und ueber mit dicken Spinnweben bedeckt. "
     "Von ihren kunstvollen Verzierungen ist hier nichts mehr zu sehen.");

  AddDetail(({"spinnweben","tuch","stoff","bahnen","netz","netze"}),
     "Die Spinnweben sehen aus wie dicker, weisser Stoff, der in schweren"
     " Bahnen nach unten haengt.");

  AddDetail(({"baldachin","decke"}),
     "Auch die Decke dieser Hoehle wird von Spinnweben gebildet. Das dichte"
     " Gespinst spannt sich wie ein grosser, weisser Baldachin ueber Eurem"
     " Kopf.");

  AddDetail(({"gespinst","gespinnst","gewebe"}),
     "Das dicke, silberfarbene Gewebe bewegt sich und pulsiert voller Leben.");

  AddDetail(({"wesen","leben","spinnen"}),
     "Als Ihr die Spinnweben genauer betrachtet, tretet Ihr ehrfuerchtig einen"
     " Schritt zurueck, denn das Gewebe ist dicht mit abertausenden winzigen"
     "  Spinnen bevoelkert. - Die Goettin ist hier wahrlich praesent ...");

  AddDetail(({"mitte","platz"}),
     "Der Platz wird von mehreren Saeulen gebildet, die in einem"
     " unregelmaessigen Kreis um einen kleinen freien Platz angeordnet sind."
     " In der Mitte des Platzes thront eine grosse Spinne, die in ihrer"
     " Schoenheit die ganze Groesse Lloths offenbart.");

  AddDetail(({"gefuehl","gefuehle"}),
     "Gefuehle spuert man, die sieht man nicht!");

  AddDetail(({"schoenheit"}),
     "Die Spinne ist wunderschoen, mit langer, seidigschwarzer Behaarung und "
     "funkelnden Augen.");

  AddDetail(({"verkoerperung"}),
     "Die Spinne ist Lloth heilig. Und sollte es damit auch Euch sein!");

  AddDetail(({"groesse","allmacht"}),
     "Huldigt der Groesse und Allmacht Lloths!");

  AddDetail(({"lloth","goettin","dunkle","ewige","allmaechtige"}),
     "Lloth, die Dunkle, die Ewige, die Allmaechtige!");

  AddDetail(({"dummheit"}),
     "Ihr seht die Knochen am Fusse der Spinnweben.");

  AddDetail(({"knochen","fuss","fusse","fehler"}),
     "Rund um den Platz, am Fusse der Spinnweben, liegen die Knochen derer, "
     "die so dumm waren, hier kaempfen zu wollen. Euch wundert es etwas, "
     "dass sie nicht in das Gespinst mit eingewoben sind, aber vermutlich "
     "wollten die Kinder Lloths diese Frevler nicht in ihren Netzen dulden.");

  AddDetail(({"boden"}),
     "Der Boden ist total weiss. Ihr koennt nicht erkennen, woraus er "
     "besteht.");

  AddDetail(({"himmel"}),
     "Zwischen dem und Euch ist erfreulich viel festes Gestein.");

  AddDetail(({"opfer","futteropfer"}),
     "Wenn Ihr Lloth wirklich ehren wollt, waere ein Futteropfer fuer die "
     "Spinnen angebracht. Besorgt Euch dafuer aber ein noch lebendes Tier. "
     "Spinnen moegen kein Aas.");

  AddDetail(({"tier","aas"}),
     "Hier findet Ihr so etwas nicht.");

  AddCmd("", "seq_check", 1);
  AddCmd(({"bete","huldige"}), "cmd_beten");
  AddCmd(({"fuetter","fuettere"}), "cmd_fuettern");
  AddCmd(({"opfer","opfere"}), "cmd_opfern");
  AddCmd(({"bring","bringe"}), "cmd_darbringen");

  AddItem(NPC "spinne", REFRESH_DESTRUCT);

  Licht("dunkel");
  Umgebung("warm", TT_CAVE, 1);

  set_exits("tgel");

  Opf_sum=0;
  Opf_pl=([]);
}

void reset()
{
  ::reset();

  Opf_sum=0;
  Opf_pl=([]);
}

nosave int seq_check(string str)
{
  if((objectp(seq)) && (seq==TP) && !IS_WIZARD(TP)) return 1;
  return 0;
}

nosave int cmd_beten(string str)
{
  notify_fail(BS("Wollt Ihr zu Lloth beten?"));

  if(!str) return 0;
  
  //  if(strstr(str, "loth")>-1)
  if(member(({"lloth", "zu lloth", "loth", "zu loth"}), str)>-1)
    {
      write(BS("Ihr werft Euch vor der Spinne zu Boden und betet "
	       "zu Lloth, der dunklen Herrin. Dabei durchfaehrt Euch der "
	       "Gedanke, dass ein Futteropfer fuer die heilige Spinne "
	       "angemessen waere."));

      say(BS(TP->Name()+" wirft sich vor der Spinne zu Boden und betet."),
	  ({TP}));

      return 1;
    }
  else
    //    if((strstr(str, "woody")>-1) || (strstr(str, "dusty")>-1))
    if(member(({"woody", "zu woody", "dusty", "zu dusty"}), str)>-1)
      {
	write(break_string(
	    "Du wagst es tatsaechlich, HIER zu einem anderen "
	    "Gott, als Lloth selbst zu beten!\n"
	    "Eine unsichtbare Kraft packt Euch, ein stechender Schmerz "
	    "durchzieht Euren gesamten Korper und zwingt Euch in die Knie. "
	    "Von Kraempfen gepeinigt schreit Ihr auf und windet Euch "
	    "stoehnend auf dem Boden.", 0, 0, 1));
	
	say(break_string(
	   TP->Name()+" wagt es tatsaechlich, HIER zu einem anderen Gott "
	   "als Lloth selbst zu beten??\n"
	   "Schreiend bricht "+TP->QueryPronoun(WER)+
	   " zusammen und waelzt sich stoehnend von Kraempfen geschuettelt "
	   "auf dem Boden.", 0, 0, 1));
	
	TP->AddHp(-22-random(10)-random(10));

	return 1;
      }
  return 0;
}

nosave int cmd_fuettern(string str)
{
  notify_fail(BS("Wen oder was moechtet Ihr fuettern?"));

  if(!str) return 0;

  if(str=="spinne")
    return write(BS("Eine Goettin fuettert man nicht! Ihr bringt man "
		    "ein Opfer dar!")), 1;

  return 0;
}

nosave int cmd_opfern(string str)
{
  notify_fail("Was wollt Ihr opfern?\n");

  if(!str) return 0;
  
  return write(BS("Versucht es doch mal mit 'bringe spinne opfer dar'. "
		  "Natuerlich nur, wenn Ihr ein geeignetes Opfertier "
		  "dabei habt.")),1;
}

nosave int ist_geeignet(object ob)
{
  if(query_once_interactive(ob) || interactive(ob)) return 0;
  if(!living(ob)) return 0;

  if(ob->id("elementar")) return 0;
  if(ob->id("feuerwusel")) return 0;

  //  if(!ob->is_class_member(CL_ANIMAL)) return 0;

  if(ob->is_class_member(({CL_DEMON,CL_UNDEAD}))) return 0;
  
  return 1;
}

void darkelf_fin(object who)
{
  Addiere_HP(who);

  seq=0;
}

void other_fin(object who)
{
  who->move(ROOM "tgel_1_4_0", M_GO,"","rennt davon",
            "stuermt kreidebleich herein");
  seq=0;
}

nosave int cmd_darbringen(string str)
{
  int opfer;

  object *opfertiere;
  object sp;

  notify_fail(BS("Wie waere es mit 'bringe spinne opfer dar'?"));

  if(!str) return 0;

  if(str=="spinne opfer dar")
    {
      if(!sp=present("mutterspinne"))
	return write(BS("Wem wollt Ihr ein Opfer darbringen?")), 1;
            
      opfertiere=filter_array(all_inventory(ME)-({sp}), "ist_geeignet");
      
      if(!sizeof(opfertiere))
	return write(BS("Ohne geeignetes Opfertier??? Was soll das?")),1;

      if(sizeof(opfertiere)==1)
	opfer=0;
      else
	opfer=random(sizeof(opfertiere));
      
      tell_room(ME, 
		"Die Spinne naehert sich "+opfertiere[opfer]->name(WEM)+
		" und stuerzt sich auf "+opfertiere[opfer]->QueryPronoun(WEN)+
		".\n");
      opfertiere[opfer]->die(1);

      seq=TP;
      if(seq->QueryProp(P_RACE) == "Dunkelelf") // Sequenz fuer Dunkelelfen
	StartSequence(ROOM "seq/schrein2_darkelf", seq, "darkelf_fin");
      else //  Sequenz fuer Nichtdunkelelfen
	StartSequence(ROOM "seq/schrein2_other", seq, "other_fin");

      GESINNUNG->Aendere_Gesinnung(TP, SCHREIN_SPINNE);
      
      return 1;
    }
  
  return 0;
}
