/*
  Suedtor Tempelgelaende Ardulvhier
*/

#include "../def.h"

inherit MOST "std_room";

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Tempelgelaende von Ardulvhier");
  SetProp(P_INT_LONG,
	  BS("Der Weg endet hier abrupt an der Hoehlenwand, es sieht sogar "
	     "so aus, als wuerde er direkt hineinfuehren. Eure natuerlichen "
	     "Instinkte warnen Euch, dass hier nichts ist wie es scheint."));

  AddDetail(({"boden"}),
	    "Der Boden besteht hauptsaechlich aus einer Schicht kleiner, "
	    "jedoch aeusserst spitzer Stalagmiten. Gut, dass Ihr Euch hier "
	    "auf dem gepflasterten Weg befindet.");
  AddDetail(({"stalagmiten","schicht","stalagmitenschicht"}),
	    "Der Boden ist mit einer Schicht, spitzer Stalagmiten uebersaeht.");
  AddDetail(({"decke","hoehlendecke"}),
	    "Die Decke befindet sich weit ueber Euch. Sie scheint nicht "
	    "sonderlich interessant, doch Ihr hofft, dass euch keiner der "
	    "vielen Stalagtiten, die dort oben haengen erwischt.");
  AddDetail(({"instinkte","instinkt"}),
	    "Eure Instinkte warnen Euch... Wenn Ihr nur wuesstet wovor!");
  AddDetail(({"stalagtit","stalagtiten"}),
	    "Die haengen weit ueber Eurem Kopf an der Hoehlendecke.");
  AddDetail(({"kopf"}),
	    "Passt auf, dass Euch nichts auf den Kopf faellt.");
  AddDetail(({"wand","hoehlenwand"}),
	    "Die Hoehlenwand scheint auf den ersten Blick eine normale "
	    "Wand zu sein...");
  AddDetail(({"blick","zweiten blick","zweiter blick"}),
	    "Die Hoehlenwand sieht ziemlich glatt aus, doch an einigen "
	    "Stellen befinden sich seltsame Risse.");
  AddDetail(({"stelle","stellen"}),
	    "An einigen Stellen der Hoehlenwand befinden sich seltsam "
	    "geformte Risse.");
  AddDetail(({"riss","risse"}),
	    "Naeher betrachtet sind das keine Risse sondern Umrisse von "
	    "perfekt getarnten Statuen, die links und rechts vom Wegrand "
	    "stehen.");
  AddDetail(({"wegrand","rand"}),
	    "Der Wegrand ist durch duenne Moose gekennzeichnet und trennt "
	    "den Weg von der umliegenden Stalagmitenschicht.");
  AddDetail(({"umrisse","umriss"}),
	    "Die schwach erkennbaren Umrisse verraten die Statuen, ansonsten "
	    "waeren sie wohl perfekt getarnt.");
  AddDetail(({"statue","statuen"}),
	    "Die Statuen scheinen etwas zu bewachen, was es genau ist koennt "
	    "Ihr nicht erkennen, es ist wohl magisch verborgen.");

  AddSound(({"stille","absolute stille",DEFAULT_SOUND}),
	   "Es herrscht eine absolute, doch irgendwie sehr seltsame Stille.");

  AddSmell(DEFAULT_SMELL,
	   "Es riecht nach frischem Moos.");

  AddSmell(({"moos","rand","wegrand"}),
	   "Der Wegrand ist mit Moos gesaeumt und trennt somit den Weg "
	   "von der umliegenden Stalagmitenschicht.");

  Licht("duester");
  Umgebung("warm", TT_CAVE, 1);

  set_exits("tgel", ({"norden"}));
}
