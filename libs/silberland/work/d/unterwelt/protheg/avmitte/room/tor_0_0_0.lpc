#include "../def.h"

inherit MOST "std_room";

nosave int pilze;

create() 
{
  ::create();
  
  SetProp(P_INT_SHORT, 
	  "Irgendwo im Tempelgelaende von Ardulvhier.");
  SetProp(P_INT_LONG,
	  BS("Ihr seid bei einer massiven Felswand angelangt. Waere da nicht "
	     "dieser unscheinbare Fleck, waeret Ihr wohl weitergegangen. "
	     "Irgendwas ist hier seltsam... Ansonsten erstreckt sich nach "
	     "Suedosten hin das zentrale Tempelgelaende von Ardulvhier."));

  AddDetail(({"hoehlenboden","boden"}),
	    "Der Boden besteht aus einer duennen Schicht aeusserst spitzer "
	    "Stalagmiten. Nach Sueden und nach Osten hin fuehren jedoch "
	    "breite, mit Steinplatten gepflasterte Wege.");
  AddDetail(({"weg","wege","weg nach osten","weg nach sueden"}),
	    "Es fuehren je ein breiter, gepflasterter Weg nach Sueden und "
	    "nach Osten. Aufgrund der umliegenden Stalagmitenschicht ist "
	    "es wohl ratsam, auf ihnen zu bleiben.");
  AddDetail(({"schicht","stalagmitenschicht"}),
	    "Eine duenne Schicht mit aeusserst spitzen Stalagmiten bildet "
	    "den Boden der Hoehle. Haltet Euch lieber auf den Wegen auf!");
  AddDetail(({"stalagmit"}),
	    "Welchen von den vielen meint Ihr?");
  AddDetail(({"stalagmiten"}),
	    "Lauter kleine, spitze Stalagmiten bilden in der gesamten Hoehle "
	    "den Boden.");
  AddDetail(({"platte","platten","steinplatte","steinplatten"}),
	    "Die Wege nach Sueden und nach Osten hin sind mit schweren, "
	    "quadratischen Steinplatten ausgelegt. In deren Fugen wachsen "
	    "Moose und an manchen Stellen sogar ein paar Pilze.");
  AddDetail(({"fugen","fuge"}),
	    "Die Fugen sind ausgefuellt mit Moosen und sogar einige Pilze "
	    "wachsen dazwischen.");
  AddDetail(({"stelle","stellen"}),
	    "An manchen Stellen zwischen den Steinplatten wachsen sogar "
	    "ein paar Pilze.");
  AddDetail(({"pilze","pilz"}),
	    "Kleine, sehr seltsam aussehende Pilze. Ihr bezweifelt, dass "
	    "sie geniessbar sind.");
  AddDetail(({"decke","hoehlendecke"}),
	    "Die Decke der Hoehle liegt ziemlich weit oben. Viele kleine "
	    "und grosse Stalagtiten haengen herab.");
  AddDetail(({"ardulvhier","stadt","dunkelelfenstadt","zentrum"}),
	    "Ihr befindet Euch hier im Zentrum von Ardulvhier, nahe des "
	    "Tempelgelaendes.");
  AddDetail(({"gelaende","tempelgelaende"}),
	    "Das Tempelgelaende von Ardulvhier erstreckt sich nach "
	    "Suedosten.");
  AddDetail(({"hoehlenwand","wand","felswand"}),
	    "Die massive Felswand zeigt keinerlei Ritzen oder Spalten. Man "
	    "koennte meinen, sie sei kuenstlich erschaffen worden. Doch was "
	    "ist das? Diesen grossen Fleck haettet Ihr jetzt beinahe "
	    "uebersehen. Er ist nur unwesentlich dunkler gefaerbt, als die "
	    "umliegende Felswand.");
  AddDetail(({"waende","felswaende","hoehlenwaende"}),
	    "Massive Felswaende umgeben Euch hier in der Hoehle. Ihr koennt "
	    "keine Schlupfloecher, oder sonstigen Oeffnungen erkennen. Die "
	    "Hoehlenwaende sind einfach nur hoch, glatt und massiv!");
  AddDetail(({"loecher","schlupfloecher","oeffnungen","oeffnung","loch",
		"schlupfloch"}),
	    "Ihr koennt leider keine Loecher oder Oeffnungen entdecken.");
  AddDetail(({"fels","felsen"}),
	    "Etwas abseits befindet sich ein, vollkommen moosumwachsener "
	    "Felsen. Scheinbar befindet sich irgendwo ueber ihm eine "
	    "Wasserquelle, die das Moos so spriessen laesst.");
  AddDetail(({"quelle","wasserquelle"}),
	    "Wahrscheinlich ein oberirdischer See, der durch irgendeine "
	    "Felsspalte hindurch, hier heruntertroepfelt und den Fels "
	    "befeuchtet.");
  AddDetail(({"see"}),
	    "Hoechstwahrscheinlich.");
  AddDetail(({"felsspalte","stalagtit","stalagtiten"}),
	    "Davon gibt es in der Hoehlendecke sicherlich genug.");
  AddDetail(({"spalten","ritzen","spalte","ritze"}),
	    "Die Hoehlenwand ist so glatt, dass Ihr keine entdecken koennt.");
  AddDetail(({"fleck"}),
	    "Der Fleck wirkt fast, wie der Schatten eines unsichtbaren Tores. "
	    "Ihr naehert ihm Euch vorsichtig, als Ihr etwas seltsames "
	    "spuert... Als ob diesen Fleck eine Aura umgeben wuerde.");
  AddDetail(({"tor"}),
	    "Vielleicht ist dieser Fleck sogar ein Tor?!");
  AddDetail(({"aura"}),
	    "Scheinbar ist dieser Fleck von einer magischen Aura umgeben. "
	    "Es kommt Euch vor, als ob ihr sie nur betreten muesstet...");
  AddDetail(({"schatten"}), 
	    "Der Fleck wirkt fast wie einer, doch wo ist das Tor?");
  
  AddSound(({"stille","hoehle",DEFAULT_SOUND}),
	   "Eine angenehme Stille erfuellt die Hoehle.");

  AddSmell(DEFAULT_SMELL,
	   "Es riecht etwas nach feuchtem Moos.");
  AddSmell(({"moos","moose"}),
	   "Hier riecht es nach frischen, feuchten Moosen. Ein Fels, der "
	   "etwas abseits der Felswand steht, ist ueber und ueber mit "
	   "Moosen bedeckt.");

  AddCmd(({"reisse","reiss","rupfe","rupf","pfluecke","pflueck"}), 
	 "pfluecken");

  Licht("dunkel");
  Umgebung("warm", TT_CAVE, 1);

  set_exits("tgel", ({"sueden","osten"}));

  pilze=2;
}

reset()
{
  ::reset();
  
  pilze=2;
}

nosave pfluecken(string str)
{
  notify_fail("Was wollt Ihr denn pfluecken?\n");
  if(!str) return 0;
  
  if(member(({"moos","moose","moos von fels","moose von fels",
		"moos von felsen","moose von felsen","moos von felsen ab",
		"moose von felsen ab","moos von fels ab","moose von fels ab"}),
	    str)!=-1)
    return write(BS("Die Moose sind viel zu fest. Ihr wuerdet Euch nur die "
		    "Fingernaegel abbrechen!")),1;
  
  if(member(({"pilze","giftpilze","kleine pilze","pilz","gifpilz",
		"kleinen pilz"}), str)==-1) return 0;
  
  if(TP->QueryAttribute(A_DEX)<=random(10))
    return 
      write(BS("Ihr sucht Euch einen "+
	       ({"kleinen ","mittelgrossen ","grossen "})[random(3)]+
	       "Pilz aus und greift danach... Doch Ihr seid zu ungeschickt "
	       "und der Pilz wird zwischen Euren Fingern zerquetscht.")),1;
  if(!pilze)
    return 
      write(BS("Ihr blickt Euch um, doch keiner der Pilze scheint "
	       "Euch zuzusagen...")),1;
  
  write(BS("Ihr sucht Euch einen "+
	   ({"kleinen ","mittelgrossen ","grossen "})[random(3)]+
	   "Pilz aus, pflueckt ihn vorsichtig und steckt ihn in Eure "
	   "Taschen."));
  CLONE(OBJ "giftpilz", TP);
  
  pilze--;
  
  return 1;
}
