/*
  Tempeleingang
*/

#include "../def.h"

inherit MOST "std_room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Fusse eines gewaltigen Stalagmiten");
  SetProp(P_INT_LONG,
	  BS("Ihr wandert durch die unheiligen Tempelanlagen von Ardulvhier "
	     "und werdet das Gefuehl nicht los, dass Ihr beobachtet werdet... "
	     "Vor Euch ragt ein gewaltiger Stalagmit in die Hoehe. Er "
	     "erscheint etwas seltsam, denn er ist nicht kegelfoermig wie die "
	     "anderen Stalagmiten. Er ist oben ziemlich abgeflacht und bildet "
	     "fast schon einen Diskus. Im Osten steht eine Gruppe schlanker, "
	     "reich verzierter Saeulen, zu denen ein kleiner Weg hinueber "
	     "fuehrt.")+
	  BS("Ein massives Tor bildet den Eingang in diesen Stalagmiten."));

  AddDetail(({"boden"}),
	    "Den Boden bildet ein Mosaik aus faustgrossen, dunklen Steinen, "
	    "die fein, saeuberlich glattgeschliffen wurden.");

  AddDetail(({"stein","steine"}),
	    "Hunderte von faustgrossen Steinen bilden ein dunkles Mosaik auf "
	    "dem Boden.");

  AddDetail(({"muster","mosaik"}),
	    "Ihr koennt das Muster, dass das Mosaik bildet nicht genau "
	    "erkennen, jedoch fallen Euch hie und da in den Boden eingelegte "
	    "Runensteine auf.");

  AddDetail(({"runenstein","runensteine"}),
	    "Das Mosaik am Boden ist mit seltsamen Runensteinen gespickt, "
	    "wahrscheinlich sind es unheilige Zeichen, die fuer bestimmte "
	    "Zauber notwendig sind.");

  AddDetail(({"zauber","zeichen"}),
	    "Dunkelelfenpriesterinnen verwenden oft bestimmte uralte Zeichen "
	    "auf Runensteinen, um ihre Zauber zu verstaerken.");
  
  AddDetail(({"priesterin","priesterinnen","dunkelelfenpriesterin",
		"dunkelelfenpriesterinnen"}),
	    "Dunkelelfenpriesterinnen halten sich meistens in einem Tempel "
	    "auf...");

  AddDetail("himmel",
	    "Wo wollt Ihr denn in einer Hoehle einen Himmel sehen?");

  AddDetail(({"hoehlendecke","decke"}),
	    "Die Decke der Hoehle ist viel zu weit oben, als dass man etwas "
	    "erkennen koennte!");
  
  AddDetail(({"stadt","ardulvhier","tempelanlagen","anlagen"}),
	    "Ihr befindet Euch hier in den Tempelanlagen der Stadt "
	    "Ardulvhier. Einst wurde ein gewaltiger Stalagmit der in der "
	    "Mitte der Hoehle stand zu einem Tempel auserkoren und von da "
	    "an wird die Hoehle rund herum als Gebetsstaette genutzt. Ein "
	    "seltsames Gefuehl erfuellt Euch, als ob Ihr hier nicht allein "
	    "seid...");

  AddDetail(({"inneres","inneren","innere","tempel","stalagmit"}),
	    "Der abgerundete Stalagmit beherbergt in seinem Inneren den "
	    "maechtigsten Tempel von Ardulvhier, vielleicht ist das Tor "
	    "vor Euch der Eingang dazu...");

  AddDetail(({"zentrum","hoehle","mitte"}),
	    "Ihr befindet Euch hier im Zentrum der Hoehlen von Ardulvhier. "
	    "Genau in der Mitte der Hoehle befindet sich ein seltsam "
	    "geformter Stalagmit.");
  
  AddDetail("hoehlen",
	    "Ardulvhier ist auf mehrere Hoehlen aufgeteilt, jede Hoehle "
	    "beherbergt einen bestimmten Teil der Stadt.");

  AddDetail(({"teile","teil"}),
	    "Jeder Teil von Ardulvhier ist in sich abgeschlossen. Ihr "
	    "solltet die Teile einmal besuchen.");

  AddDetail("hoehe",
	    "Ihr blickt in die Hoehe und seht... Dunkelheit!");

  AddDetail(({"augen","dunkelheit"}),
	    "So sehr Ihr Eure Augen auch anstrengt, da ist nichts "
	    "erblickenswertes!");

  AddDetail("eingang",
	    "Den Eingang bildet ein massives Tor aus schwarzer Eiche.");

  AddDetail(({"tor","eichentor","umrisse"}),
	    "Das grosse Eichentor bildet den Eingang ins Innere des "
	    "Stalagmiten. Es scheint aus magischer Dunkeleiche zu bestehen, "
	    "denn Ihr koennt nur die Umrisse und ein paar Ornamente genau "
	    "erkennen.");

  AddDetail(({"ornament","ornamente","torfluegel","fluegel"}),
	    "Die Ornamente an den Torfluegeln tragen jeweils eine gruenliche "
	    "Schale, ansonsten sind sie eher schmucklos.");

  AddDetail(({"schale","schalen"}),
	    "Gruenliche Schalen, vermutlich aus Jade, die mit frischem Blut "
	    "gefuellt sind! Ihr koennt nicht erahnen, welchem Zweck sie "
	    "dienen koennten...");

  AddDetail(({"jade"}),
	    "Die beiden Schalen am Tor scheinen aus dunkler Jade zu "
	    "bestehen.");

  AddDetail(({"zweck"}),
	    "Ihr wisst nicht, welchem Zweck diese beiden Schalen dienen "
	    "koennten...");

  AddDetail(({"blut","feenblut"}),
	    "Frisches Feenblut... Wahrscheinlich von einem der vielen Opfer "
	    "an die Goettin Lloth!");

  AddDetail(({"eiche","dunkeleiche"}),
	    "Das Tor besteht vollstaendig aus Dunkeleiche! Welch "
	    "handwerkliche Meisterleistung, da das Holz dieser Eiche eines "
	    "der seltensten und haertesten ueberhaupt ist.");

  AddDetail(({"leistung","meisterleistung","holz"}),
	    "Dieses Eichentor ist eine handwerkliche Meisterleistung! Es gibt "
	    "nicht viele Handwerker, die es ueberhaupt schaffen koennten "
	    "dieses Holz zu bearbeiten...");

  AddDetail(({"handwerker","zimmerer","lage"}),
	    "Nur wenige Handwerker sind in der Lage eine Dunkeleiche zu "
	    "bearbeiten.");

  AddDetail("gefuehl",
	    "Ein seltsames Gefuehl umschleicht Euch andauernd... Es ist als "
	    "ob Ihr beobachtet werdet, jedoch koennt Ihr niemanden sehen.");

  AddDetail(({"gebetsstaette","staette"}),
	    "Hie und da sind rund um den Stalagmiten Schreine aufgestellt, "
	    "an denen man der dunklen Goettin Lloth huldigen, oder ihr ein "
	    "Opfer bringen kann.");

  AddDetail(({"goettin","lloth","dunkle goettin"}),
	    "Die gesamten Tempelanlagen sind der dunklen Goettin Lloth "
	    "gewidmet.");
  
  AddDetail(({"schrein","schreine","opfer"}),
	    "Etwas weiter, entlang des Stalagmites sind einige Schreine "
	    "aufgestellt. Dort kann man Lloth huldigen und ihr Opfer "
	    "darbringen.");

  AddDetail(({"form","diskus"}),
	    "Der Stalagmit ist ziemlich flach, und hat schon fast die Form "
	    "eines Diskus.");
  
  AddDetail(({"saeulen","onyxsaeulen","gruppe","reihen"}),
	    "Die Saeulen stehen in mehreren kreisfoermigen Reihen um einen "
	    "kleinen Platz herum. Sie scheinen aus Onyx zu sein...");

  AddDetail(({"platz"}),
	    "Zumindest nehmt Ihr an, dass sich in der Mitte der Saeulen ein "
	    "Platz befindet. Denn irgend Etwas scheint Euch daran zu "
	    "hindern, zwischen den Saeulen hindurch zu sehen. Allerdings "
	    "koennt Ihr nicht sagen, was.");

  AddDetail(({"etwas"}),
	    "Was es ist, koennt Ihr nicht erkennen.");

  AddDetail(({"weg"}),
	    "Ein kleiner, aber sehr sorgfaeltig angelegter Weg fuehrt "
	    "hinueber zu den Onyxsaeulen.");

  AddDetail(({"onyx","stein"}),
	    "Der Stein schimmert makellos seidigschwarz.");
  
  AddSound(DEFAULT_SOUND,
	   "Seltsame Stimmen dringen aus dem Tempel an Eure Ohren.");

  AddSound(({"ohren","ohr"}),
	   "Man kann nur mit den Ohren lauschen.");

  AddSound(({"stimme","stimmen"}),
	   "Leider koennt Ihr nicht mehr verstehen, als dass es sich "
	   "vermutlich um ein Gebet handelt.");

  AddSound(({"gebet","antwort"}),
	   "Im Tempel werdet Ihr vielleicht die Antwort darauf erfahren!");

  AddSmell(({"geruch",DEFAULT_SMELL}),
	   "Es riecht nach frischem Blut!!");

  AddSmell(({"blut","blutgeruch"}),
	   "Der Blutgeruch scheint vom Tor aus zu gehen...");

  AddSmell(({"tor"}),
	   "Das Tor riecht nach frischem Blut.");
  
  Licht("duester");
  Umgebung("warm", TT_CAVE, 1);

  set_exits("tgel");
  //set_exits("tor");

  AddExit("tor", 
	  ([EX_DEST: ROOM "vorraum", 
	  EX_MSG: "durch das Tor",
	  EX_PLMSG: BS("Als Ihr Euch dem Tor naehert, oeffnen es sich beinahe "
		       "lautlos, so dass ihr es durchschreiten koennt...")]));

  AddItem(NPC "tw", REFRESH_DESTRUCT);
}
