/*
  Ein Giftpilz...
*/

#pragma strong_types;

#include "../def.h"

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>

nosave int alter, fertig;
nosave string col;

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  col=({"rot","gruen","gelb","tuerkis","violett","blau"})[random(6)];
  
  SetProp(P_SHORT, "Ein "+col+"er Pilz");
  SetProp(P_LONG,
	  BS("In Deiner Hand haelst Du einen recht seltsam aussehenden "+
	     col+"en Pilz. Er besitzt einen laenglichen Fuss und einen "
	     "wohlgeformten gepunkteten Kopf."));

  SetProp(P_INFO, 
	  BS("Du bist Dir nicht sicher, ob der Pilz essbar ist."));

  SetProp(P_NAME, "Pilz");
  SetProp(P_NAME_ADJ, col);
  AddAdjective(({col,col+"e",col+"er"}));

  SetProp(P_GENDER, MALE);
  AddId(({"\ngiftiger_pilz","pilz","giftpilz"}));
  
  SetProp(P_MATERIAL, ([MAT_MUSHROOM:90, MAT_MISC_POISON:8, MAT_MISC_DRUG:2]));
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 33);
  SetProp(P_NOBUY, 1);
  
  SetProp(P_FOOD_INFO, ([F_HEAL:({35, 0}), F_SOAK:5, F_POISON:1,
  F_MSG:"Du verschlingst den "+col+"en Pilz in einem Stueck...\n",
  F_MSG_ROOM:"verschlingt einen "+col+"en Pilz in einem Stueck.\n"]));

  alter=5;
  fertig=0;
}

reset()
{
  ::reset();

  alter--;

  if((alter <= 2) && (!fertig))
    {
      SetProp(P_SHORT, "Ein "+col+"er Pilz (getrocknet)");
      SetProp(P_INFO,
	      BS("Du bist Dir nicht sicher, ob der Pilz essbar ist.")+
	      BS("Da das Moos jedoch bereits etwas eingetrocknet ist, "
                 "koennten sich die Giftstoffe ja bereits verfluechtigt "
                 "haben."));
      SetProp(P_FOOD_INFO, ([F_HEAL:({30, 0}), F_SOAK:5, F_POISON:0,
      F_MSG:"Du verschlingst den "+col+"en Pilz in einem Stueck...\n",
      F_MSG_ROOM:"verschlingt einen "+col+"en Pilz in einem Stueck.\n"]));

      SetProp(P_MATERIAL, ([MAT_MUSHROOM:98, MAT_MISC_DRUG:2]));
      
      fertig=1;
    }

  if(alter <= 0)
    {
      if(MENV && interactive(MENV))
	tell_object(MENV, 
		    BS("Du erkennst, dass der "+col+"e Pilz vertrocknet "
		       "ist und wirfst ihn weg."));
      call_out("remove",0);
    }
}
