/*
  lloth_perle.c
  Ein Blutstropfen Lloths, mit dem man Gegner paralysieren kann
  
  tyron, Oktober 2001  
*/

#pragma strong_types;

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein Blutstropfen Lloths");
  SetProp(P_LONG,
	  BS("In Deiner Hand liegt eine winzige, blutrote Perle, von der eine "
	     "seltsame Faszination ausgeht."));
  
  SetProp(P_INFO,
	  BS("Dies ist ein Blutstropfen Lloths - ein Geschenk der Goettin "
	     "an eines ihrer treuen Kinder. Es kann nur von einer wahrhaft "
	     "boesen Seele dazu verwendet werden, einen Gegner zu "
	     "paralysieren. Dazu muss es auf den Gegner geworfen werden."));

  SetProp(P_NAME, "Blutstropfen Lloths");
  SetProp(P_GENDER, MALE);
  AddId(({"perle", "tropfen", "blutstropfen", "\nlloth_perle" }));

  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 1200);

  // Das Teil soll nicht weiter- oder weggegeben werden koennen
  SetProp(P_NODROP, 
	  BS("Ein Geschenk Lloths gibt man doch nicht so einfach weg."));
  SetProp(P_NEVERDROP, 1);
  
  AddCmd(CMD_WERFEN, "cmd_werfe");
}

nosave int cmd_werfe(string str)
{
  string check1, check2, sgegner;
  object player, ogegner;
    
  notify_fail(BS("Was moechtest Du auf wen werfen?"));
  if(!str) return 0;
    
  if(sscanf( str, "%s %s %s", check1, check2, sgegner) < 3) return 0;
  
  if(!id(check1) || check2!="auf") return 0;

  if(!ENV(TP)) return 0;

  notify_fail(BS("Dazu muesstest Du die Perle erst einmal in der Hand haben"));

  if(TP!=MENV) return 0;
  
  if(!objectp(ogegner=present(sgegner, ENV(TP))))
    return write(BS("So jemanden siehst Du hier nicht.")), 1;
  
  if((!TP->IsEnemy(ogegner)) || !TP->InFight())
    return write(BS("Du kannst nur auf einen Gegner eine Perle werfen.")), 1;

  if(TP->QueryProp(P_ALIGN) > -100)
    return write(BS("Deine Gesinnung erlaubt Dir das nicht!")), 1;
  
  write(BS("Die Perle wird zu einem blutroten Netz und fesselt "+
	   ogegner->name(WEN)+" fuer kurze Zeit."));
  
  say(BS(TPN+" wirft etwas auf "+ogegner->name(WEN, 2)+". "+ 
         CAP(ogegner->QueryPronoun(WER))+" wird von einem "
         "blutroten Netz gefesselt."), ({TP}));
  
  ogegner->SetProp(P_PARALYZED,
		   ([PARALYZE_TIME: 3+random(3),
		     PARALYZE_MSG: "Das Netz haelt Dich fest.\n",
		     PARALYZE_MSG_OTHER: "Das Netz haelt %s gefangen.\n",
		     PARALYZE_END: "Das Netz loest sich auf.\n",
		     PARALYZE_END_OTHER: "Das Netz loest sich auf.\n" ]));
  
  call_out("remove", 0, 1);

  RemoveCmd(CMD_WERFEN);

  return 1;
}
