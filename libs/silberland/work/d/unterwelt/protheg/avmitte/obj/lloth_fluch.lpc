/*
  lloth_fluch.c   -  Die Verminderung der Abwehr, wenn man versucht, die
                     Tafel Lloths zu zerstoeren

  tyron, September 2001  
*/

#pragma strong_types;

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

/*
  Regelt, ob der Schutz ausgezogen werden kann oder nicht.
  (Ein Destructen ist nur moeglich, wenn der Schutz
  ausgezogen ist.)
*/
nosave int Freigabe;  

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  Freigabe = 0;

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "");
  SetProp(P_GENDER, MALE);
  AddId(({"\nlloth_fluch", "NO_armour"}));

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);

  // Das Teil soll nicht aus Versehen weggegeben werden koennen
  SetProp(P_NODROP, 1);
  // Beim Tod des Spielers bzw. beim Ausloggen soll dar Schutz verschwinden
  SetProp(P_NEVERDROP, 1);
    
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);

  SetProp(P_DEFEND_FUNC, ME);
  SetProp(P_REMOVE_FUNC, ME);
    
  // Der Fluch haelt zwischen vier und sechs Minuten
  call_out("fluchhinweis", 30+random(31));
  call_out("remove", (420+random(61)+random(61)+random(61)), 1);
}

reset()
{
  if(!is_clone(ME)) return;
  ::reset();
  
  remove(1);
}

void remove(int silent)
{
  /*
    remove() ruft DoUnwear() auf. Darum muss das Ausziehen des Schutzes
    erlaubt werden.
  */

  Freigabe=1;
  ::remove(silent);
}

int DefendFunc(string *dtype, mixed spell, object enemy)
{
  if(!QueryWorn()) return 0;
  
  if(sizeof(dtype & m_indices(PHYSICAL_DAMAGE_TYPES)))
    return -(10 + QueryWorn()->QueryAttribute(A_DEX)/2);
  
  if(sizeof(dtype & ({DT_HOLY, DT_UNHOLY})))
    return -(10 + QueryWorn()->QueryAttribute(A_INT));

  return 0;
}

int RemoveFunc(string *dtyp, mixed spell, object enemy)
{
  // Lloths Schutz kann man nicht ausziehen. Nur vor dem
  // Loeschen des Objekts muss das Ausziehen erlaubt werden.
  return Freigabe;
}

void fluchhinweis()
{
  if(!QueryWorn()) return remove(1);

  tell_object(QueryWorn(),
	      ({"Du fuehlst Dich durch ein boesartiges Auge beobachtet.\n",
		  "Du fuehlst Dich nackt.\n",
		  "Du fuehlst dich schutzlos.\n",
		  "Unglueck haftet dir an. Du hast Angst.\n"})[random(4)]);

  call_out("fluchhinweis", 30+random(31));
}
