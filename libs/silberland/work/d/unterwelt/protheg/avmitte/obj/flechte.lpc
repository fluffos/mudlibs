/*
  Eine Flechte zum drauf herumkauen
*/

#pragma strong_types;

#include "../def.h"

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>

nosave int alter;

void create()
{
  if(!is_clone(TO)) return;
  ::create(({"zerkau","zerkaue","kau","kaue"}));

  SetProp(P_SHORT, "Ein kurzes Stueck einer Flechte");
  SetProp(P_LONG,
	  BS("Du haelst ein kurzes Stueck einer Flechte in Deiner Hand. "
	     "Sie sieht etwas trocken aus, aber trotzdem geniessbar."));
  SetProp(P_INFO, 
	  BS("Wenn man die Flechte etwas vorkaut sollte man sie normal "
	     "essen koennen."));
  SetProp(P_NAME, "Flechte");
  SetProp(P_GENDER, FEMALE);
  AddId(({"\nflechte","flechte"}));
  
  SetProp(P_MATERIAL, ([MAT_MISC_PLANT:95, MAT_WATER:5]));
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 1);
  
  SetProp(P_FOOD_INFO, 
	  ([F_HEAL:({35, 0}), 
	    F_SOAK:4, 
	    F_VERB:"kauen",
	    F_MSG:"Du zerkaust die Flechte und schluckst sie einfach runter...\n",
	    F_MSG_ROOM:"zerkaut eine Flechte.\n"]));
  
  alter=5;
  
  AddCmd(({"iss","esse"}), "essenfkt");
}

nosave int essenfkt(string str)
{
  if(!str) return 0;

  if(str=="flechte")
    return notify_fail("Die Flechte muss man erst zerkauen!\n"),0;

  return 0;
}

void reset()
{
  ::reset();
  
  alter--;
  
  if(alter <= 0)
    {
      if(MENV && interactive(MENV))
	tell_object(MENV, 
		    BS("Du erkennst, dass die Flechte total vertrocknet ist "
		       "und wirfst sie weg."));

      call_out("remove",0);
    }
}
