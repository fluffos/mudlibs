/*
  lloth_schale.c
  Die Opferschale aus dem becken fuer Lloths Tafel
  
  tyron, Juni 2001  
*/

#pragma strong_types;

#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Eine einfache Steinschale");
  SetProp(P_LONG,
	  BS("Eine einfache Steinschale aus einem braeunlichen, "
	     "rauchigen Stein. Ihre Aussenseite ist rauh und sieht fast "
	     "unbehandelt aus, ihr Inneres dagegen ist makellos rund und "
	     "glatt poliert."));

  SetProp(P_INFO,
	  BS("Du spuerst, dass es mit dieser Schale eine besondere "
	     "Bewandtnis hat. Vielleicht wird sie fuer ein wichtiges "
	     "Ritual benoetigt."));

  SetProp(P_NAME, "Steinschale");
  SetProp(P_GENDER, FEMALE);
  AddId(({ "schale", "steinschale", "opferschale", "\nlloth_schale" }));
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 200);

  SetProp(P_MATERIAL, 
	  ([MAT_MISC_STONE: 95, MAT_MISC_UNHOLY: 4, MAT_BLOOD: 1]));

  // Das Teil soll nicht aus Versehen weggegeben werden koennen
  SetProp(P_NODROP, "Lloth wuerde das nicht zulassen...\n");
  SetProp(P_NEVERDROP, 1);

  AddDetail(({"aussenseite","aussen"}),
	    "Die Aussenseite der Schale ist rauh und sieht fast unbehandelt "
	    "aus.");
  
  AddDetail(({"innenseite","innen","inneres"}),
	    "Die Innenseite der Schale ist makellos rund und glatt poliert.");

  AddDetail(({"stein","rauchstein"}),
	    "Die Schale besteht aus einem braeunlichen, rauchigen Stein.");
}
