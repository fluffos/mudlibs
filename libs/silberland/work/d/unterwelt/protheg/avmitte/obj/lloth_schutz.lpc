/*
  lloth_schutz.c\
  Der zusaetzliche Schutz Lloths nach dem Baden in ihrem Brunnen
  
  tyron, Mai 2001  
*/

#pragma strong_types;

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

/*
  Regelt, ob der Schutz ausgezogen werden kann oder nicht.
  (Ein Destructen ist nur moeglich, wenn der Schutz
  ausgezogen ist.)
*/
nosave int Freigabe;  

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  Freigabe=0;
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  SetProp(P_NAME, "");
  SetProp(P_GENDER, MALE);
  AddId(({"\nlloth_schutz", "NO_armour"}));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);

  // Das Teil soll nicht aus Versehen weggegeben werden koennen
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
    
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_DEFEND_FUNC, ME);
  SetProp(P_REMOVE_FUNC, ME);
    
  // Der Schutz haelt zwischen vier und sechs Minuten
  call_out("remove", (300+random(61)+random(61)+random(61)), 1);
}

void remove(int silent)
{
  // remove() ruft DoUnwear() auf. Darum muss das Ausziehen des Schutzes
  // erlaubt werden.
  Freigabe=1;
  ::remove(silent);
}

int DefendFunc(string *dtype, mixed spell, object enemy)
{
  if(!QueryWorn()) return 0;

  if(sizeof(dtype & m_indices(PHYSICAL_DAMAGE_TYPES)))
    return (5 + QueryWorn()->QueryAttribute(A_DEX)/2);
  
  if(sizeof(dtype & ({DT_HOLY})))
    return (5 + random(QueryWorn()->QueryAttribute(A_INT)));
  
  return 0;
}

int RemoveFunc(string *dtyp, mixed spell, object enemy)
{
  // Lloths Schutz kann man nicht ausziehen. Nur vor dem
  // Loeschen des Objekts muss das Ausziehen erlaubt werden.
  return Freigabe;
}

void reset()
{
  if(!is_clone(ME)) return;
  ::reset();

  remove(1);
}

string extra_look()
{
  if(!QueryWorn()) return "";
  
  return (QueryWorn()->QueryProp(P_GENDER)==FEMALE ? "Sie ":"Er ")+
    "wird von einer dunklen Aura geschuetzt!\n";
}

void BecomesNetDead(object spieler)
{
  if((MENV) && (spieler==MENV))
    {
      while(find_call_out("remove")!=-1);
      call_out("remove", 0, 1);
    }
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  if((MENV) && (victim==MENV))
    {
      while(find_call_out("remove")!=-1);
      call_out("remove", 0, 1);
    }
}
