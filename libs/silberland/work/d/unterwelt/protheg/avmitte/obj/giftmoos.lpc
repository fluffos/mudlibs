/*
  Ein giftiges Stueck Moos...

  Wird mit der Zeit ungiftig!
*/

#pragma strong_types;

#include "../def.h"

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>

nosave int alter, fertig;

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Etwas gruenschimmerndes Moos");
  SetProp(P_LONG,
	  BS("Du haelst etwas Moos, das in einer seltsamen, gruenen Farbe "
	     "zu schimmern scheint in Deiner Hand und fragst Dich, ob es "
	     "essbar ist oder nicht..."));
  SetProp(P_INFO, 
	  BS("Du bist Dir nicht sicher, ob das Moos essbar ist."));

  SetProp(P_NAME, "Moos");
  SetProp(P_NAME_ADJ, "gruenschimmernd");
  AddAdjective(({"gruen","gruenes","gruene","gruenschimmerndes",
		   "gruenschimmernde","gruenschimmernd"}));
  SetProp(P_GENDER, NEUTER);
  AddId(({"\ngiftiges_moos","moos"}));
  
  SetProp(P_MATERIAL, ([MAT_MISC_PLANT:45, MAT_MISC_POISON: 5, MAT_WATER:50]));
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 1);
  
  SetProp(P_FOOD_INFO, ([F_HEAL:({25, 0}), F_SOAK:3, F_POISON:1,
  F_MSG:"Du oeffnest den Mund und schluckst das Moos einfach runter...\n",
  F_MSG_ROOM:"schluckt ein seltsames Stueck Moos hinunter.\n"]));
  
  alter=5;
  fertig=0;
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();
  
  alter--;
 
  if((alter <= 4) && (!fertig))
    {
      SetProp(P_SHORT, "Etwas gruenschimmerndes Moos (getrocknet)");
      SetProp(P_INFO, 
	      BS("Du bist Dir nicht sicher, ob das Moos essbar ist.")+
	      BS("Da das Moos jedoch bereits etwas eingetrocknet ist, "
		 "koennten sich die Giftstoffe ja bereits verfluechtigt "
		 "haben."));
      SetProp(P_FOOD_INFO, ([F_HEAL:({20, 0}), F_SOAK:3, F_POISON:0,
      F_MSG:"Du oeffnest den Mund und schluckst das Moos einfach runter...\n",
      F_MSG_ROOM:"schluckt ein seltsames Stueck Moos hinunter.\n"]));

      SetProp(P_MATERIAL, ([MAT_MISC_PLANT:85, MAT_WATER:15]));

      fertig=1;
    }
  
  if(alter <= 0)
    {
      if(MENV && interactive(MENV))
	tell_object(MENV, 
		    BS("Du erkennst, dass das Moos vertrocknet ist und "
		       "wirfst es weg."));
      call_out("remove", 0);
    }
}
