/*
  Hochzeitszeremonie
  Die Priesterin
*/

#pragma strong_types;

#include "../def.h"

inherit DUNKELELF;

#define P_LADUNG "sh:epeitsche-ladung"

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT,
	  "Lotu-Varia, Hohepriesterin Lloths und Zweitgeborene des Hauses Kryio");
  SetProp(P_LONG,
	  BS("Eine ueber zwei Meter grosse Dunkelelfenfrau mustert Dich "
	     "aus ihren Augenwinkeln. Sie ist in diesen dunklen Raeumen "
	     "beinahe unsichtbar, denn ihr dunkles Gewand schirmt ebenso "
	     "das Licht, wie die Koerperwaerme ab. Das einzige was Du "
	     "erkennen kannst, sind ihre langen, weissen Haare, ihre "
	     "seltsam, gruenleuchtenden Augen und die Peitsche, die an "
	     "Ihrer Seite haengt."));

  SetProp(P_NAME, "Lotu-Varia");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:40]));
  AddId(({"priesterin", "hohepriesterin", "lotu-varia", "lotu", "varia",
	    "frau","dunkelelf","dunkelelfin","dunkelelfenfrau",
	    "zweitgeborene","NOWIMPY"}));

  set_living_name("Lotu-Varia");

  create_default_darkelf(40);

  SetProp(P_HANDS, ({" mit ihren Krallen", QueryProp(P_HANDS)[1], DT_RIP}));

  SetProp(P_MAX_SP, 2500);
  SetProp(P_SP, 2500);

  SetProp(P_SIZE, 210);
  SetProp(P_ALIGN, -2500);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_TRANSPARENT, 0);

  AddProp(P_RESISTANCE_STRENGTHS ,
	  ([
	    DT_FIRE:   -0.1, DT_COLD:  -0.1,
	    DT_WATER:  -0.1, DT_AIR:   -0.1,
	    DT_SOUND:   0.1, DT_ACID:  -0.2,
	    DT_POISON: -0.3, DT_MAGIC: -0.5]));

  SetProp(P_NOMAGIC, 60);

  SetProp(P_MSGIN, "kommt aus einer Seitentuer herein");

  SetProp(P_DIE_MSG, " loest sich in einer Rauchwolke auf.\n");
  SetProp(P_NOCORPSE, 1);

  AddDetail(({"auge","augen","augenwinkel"}),
	    "Obwohl es nicht so aussieht, sind Lotu-Varias Augen trotzdem "
	    "auf Euch gerichtet! Das gruene Funkeln darin ist kaum zu "
	    "Uebersehen.");

  AddDetail(({"funkeln"}),
	    "Lotu-Varias Augen funkeln Euch gruen entgegen.");

  AddDetail(({"gewand","kleider","kleid"}),
	    "Lotu-Varia wird von einem sehr dunkel wirkenden Gewand "
	    "eingehuellt, sodass Ihr nicht genau erkennen koennt, welche "
	    "Kleider sie traegt.");

  AddDetail(({"haare","haar","haarpracht","zopf"}),
	    "Lotu-Varias lange, weisse Haarpracht laeuft als Zopf ihren "
	    "Ruecken hinab.");

  AddDetail(({"seite"}),
	    "An Lotu-Varias Seite haengt eine sehr seltsam anmutende "
	    "Peitsche.");

  AddDetail(({"peitsche","zorn","lloths zorn"}),
	    "Lloths Zorn ist eine fast zwei Meter lange, schwarze "
	    "Lederpeitsche mit Dornenkugeln an den Spitzen. Ein blauer "
	    "Saphir ziert das stumpfe Ende.");

  SetProp(P_LOG_INFO, "protheg/hochzeit");

  AddInfo(DEFAULT_INFO,
	  ({"scheint in ihre Gebete vertieft!\n",
	      "ignoriert Euch.\n",
	      "blickt ueber Euch hinweg.\n",
	      "meint: 'Fragt meine Dienerin!'\n"}));

  AddInfo(({"hochzeit","trauung","audienz"}),
	  "Belaestigt mich mit soetwas nicht, fragt meine Dienerin im "
	  "Vorraum, wenn Ihr eine Audienz wollt.\n",
	  "sagt: ");

  AddInfo(({"dienerin"}),
	  "Meine Dienerin befindet sich im Vorraum draussen!",
	  "sagt: ");

  AddInfo(({"vorraum","draussen"}),
	  "Der Vorraum ist DRAUSSEN!",
	  "herrscht Euch an: ");
  
  SetProp(P_REJECT, ({REJECT_DROP,
      "Die Hohepriesterin blickt Euch an meint: 'Das brauche ich nicht!\n"}));

  SetProp(P_SPELLRATE, 50);

  AddSpell(1,0,
	   "Die Hohepriesterin hebt ihre Arme...\n"+
	   "Ploetzlich senken sich lauter Spinnweben ueber Euch.\n",
	   "Die Hohepriesterin hebt ihre Arme...\n"+
	   "Ploetzlich senken sich lauter Spinnweben ueber @WEN.\n",
	   DT_BLUDGEON, "llothspell_laehmen");
  AddSpell(3,400,
	   "Die Hohepriesterin richtet ihren Gedankenfokus auf Euch.\n",
	   "Die Hohepriesterin richtet ihren Gedankenfokus auf @WEN.\n",
	   DT_MIND, ([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 350,
	   "Die Hohepriesterin jagt Euch ihre Klauen in den Koerper.\n",
	   "Die Hohepriesterin jagt @WEM ihre Klauen in den Koerper.\n",
	   ({DT_RIP,DT_PIERCE}), ([SP_SHOW_DAMAGE:1]));

/* Ist in Darkelf schon definiert

  AddSpell(4, 400,
  "Die Hohepriesterin feuert Euch eine kleine Dunkellanze entgegen.\n",
  "Die Hohepriesterin feuert @WEM eine kleine Dunkellanze entgegen.\n",
  ({DT_UNHOLY,DT_PIERCE}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 800,
  "Die Hohepriesterin feuert Euch eine gewaltige Dunkellanze entgegen.\n",
  "Die Hohepriesterin feuert @WEM eine gewaltige Dunkellanze entgegen.\n",
  ({DT_UNHOLY,DT_PIERCE}), ([SP_SHOW_DAMAGE:1]));

*/

  SetChats(1, ({
    "Die Hohepriesterin verfaellt kurz in rasendes Gelaechter.\n",
      "Die Hohepriesterin murmelt etwas, worauf eine kleine Wolke entsteht "
      "und kurz danach wieder verschwindet.\n",
      "Die Hohepriesterin murmelt etwas vor sich hin.\n",
      "Die Hohepriesterin schliesst die Augen und spricht ein Gebet.\n"}));

  SetAttackChats(2, ({
    "Die Hohepriesterin bruellt: Moege Lloth Euch bestrafen!\n",
      "Die Magie des Tempels wirkt auf Eure Zauber!\n",
      "Die Hohepriesterin hackt mit ihren Klauen wild um sich.\n"
      "Die Hohepriesterin faucht Euch an.\n"}));

  SUID;

  CLONEME(WEAPON "zorn");
}

void llothspell_laehmen(object enemy,int damage, mixed dam_type)
{
  enemy->SetProp(P_DISABLE_ATTACK, enemy->QueryProp(P_DISABLE_ATTACK)+1+random(3));
}

string _query_noattack()
{
  if(!HZM->Keine_Hochzeit())
    return "sagt: 'Nicht jetzt! Ich habe eine Trauung zu vollfuehren!'\n";
}

int Defend(int dam, string *dtype, mixed spell, object enemy)
{
  object pe;

  if(!pointerp(dtype))
    dtype=({dtype});

  if(!QueryProp(P_WEAPON))
    {
      if(!present("\nepeitsche")) CLONEME(WEAPON "epeitsche");
      
      command("zuecke peitsche");
    }
  
  if(sizeof(dtype & ({ DT_HOLY })))
    {
      tell_room(ENV(TO),
		"Die Hohepriesterin lacht und meint:\n"+
		"'Der Tempel schuetzt mich vor Euren primitiven Zaubern!'\n");

      return ::Defend(0, dtype, spell, enemy);
    }

  if(sizeof(dtype & ({ DT_MAGIC })))
    {
      tell_room(ENV(TO), "Der Tempel wendet die Magie gegen Euch!\n");

      enemy->Defend(dam*2/3, dtype, spell, ME);

      if(spell)
	return ::Defend(0, dtype, spell+([SP_RECURSIVE:1]), enemy);
      else
	return ::Defend(0, dtype, ([SP_RECURSIVE:1]), enemy);
    }

  if(sizeof(dtype & ({ DT_LIGHTNING, DT_ELECTRIC })))
    {
      tell_room(ENV(TO),
		"Die Hohepriesterin blockt mit ihrer Peitsche ab...\n");
      
      if(pe=present("\nepeitsche",TO))
	pe->SetProp(P_LADUNG, pe->QueryProp(P_LADUNG)+dam/2);
      
      return ::Defend(0, dtype, spell, enemy);
    }
  
  if(enemy->QueryProp(P_ALIGN)>100) 
    enemy->SetProp(P_ALIGN, enemy->QueryProp(P_ALIGN)-10);
  
  BLINDFIGHT

  return ::Defend(dam*4/5, dtype, spell, enemy);
}

void catch_tell(string str)
{
  string who, what;
  object env;

  str=lower_case(str);
  str=regreplace(str, "[^a-z0-9 ]","",1);

  if((sscanf(str, "%s antwortet dir %s", who, what)==2) ||
     (sscanf(str, "%s sagt %s", who, what)==2))
    {
      if(!HZM->Hochzeit_laeuft()) return;

      env=ENV(TO);
      
      if(env!=find_object(ROOM "tempel")) return;

      who=explode(who," ")[<1]; //Fuer Leute mit Presay

      if(!TP || TP!=find_player(who) || !present(TP, env)) return;

      who=lower_case(who);
      what=lower_case(what)[0..1];

      if(HZM->Braut()==getuid(TP))
	if(env->QuerySieOk())
	  {
	    switch(what)
	      {
	      case "ja": env->sie_jupp();
		break;
	      case "ne": env->BrautBeendetHochzeit();
		break;
	      }
	    return;
	  }
      
      if(HZM->Braeutigam()==getuid(TP))
	if(env->QueryErOk())
	  {
	    switch(what)
	      {
	      case "ja": env->er_jupp();
		break;
	      case "ne": env->BraeutigamBeendetHochzeit();
		break;
	      }
	    return;
	  }

      return tell_object(TP,
       "Die Hohepriesterin knurrt Euch an und deutet Euch still zu sein!\n");
    }
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch(gruppe)
    {
    case "fies":
      call_out("reaction", 0, TP,
	       "tritt Euch.\n",
	       "tritt "+TP->name(WEN)+".\n", 1);
      break;
    case "frech":
      call_out("reaction", 0, TP,
	       "bruellt Euch an: 'Verschwinde, Wurm!'\n",
	       "bruellt "+TP->name(WEN)+" an: 'Verschwinde, Wurm!'\n");
      break;
    case "intim":
      call_out("reaction", 0, TP,
	       "gibt Euch eine saftige Ohrfeige.\n",
	       "gibt "+TP->name(WEM)+" eine saftige Ohrfeige.\n", 1);
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

varargs void reaction(object ob, string macher, string andere, int flag)
{
  if(present(ob, ENV(TO)))
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
      if(flag) ob->AddHp(-10-random(10));
    }
}

varargs int StopHuntFor(object arg, int silent)
{
  int tmp;

  if(tmp=::StopHuntFor(arg, silent))
    call_out("peitschen_check", 5);
  
  return tmp;
}

varargs mixed StopHuntingMode(int silent)
{
  call_out("peitschen_check", 5);
  
  return ::StopHuntingMode(silent);
}

peitschen_check()
{
  if(!m_sizeof(GetEnemies()))
    command("stecke peitsche weg");
}

void die(int poisondeath)
{
  write_file(LOG "kills",
	     ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt die Priesterin.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int l) 
{
  if(killer == ME)
    write_file(LOG "deads",
      ctime()+": Die Priesterin hat "+CAP(getuid(player))+" umgebracht ("+l+
	       ").\n");
}
