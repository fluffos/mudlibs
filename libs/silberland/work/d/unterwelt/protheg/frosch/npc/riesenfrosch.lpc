/*
**
** Der Orden des Frosches, Riesenfrosch Endgegner
** 
*/

inherit "std/npc";

#include "../def.h"

void create() 
{
  object d;
  
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein schleimiger Riesenfrosch sitzt hier herum");
  SetProp(P_LONG, 
	  BS("Ein kleiner, seltsamer Frosch. Er traegt einen goldenen "
	     "Orden, welcher ihn als Meister im Orden des Frosches "
	     "auszeichnet."));
  
  SetProp(P_NAME, "Riesenfrosch");
  SetProp(P_GENDER, MALE);
  
  SetProp(P_NAME_ADJ, "schleimig");
  AddAdjective(({"schleimige","schleimiger","schleimigen"}));
  
  AddId(({"frosch","\norden_des_frosches"}));
  
  create_default_npc(40, 2500);
  SetProp(P_MAX_SP, 1);
  SetProp(P_SP, 1);
  SetProp(P_HANDS, 
	  ({" mit seinen langen, schleimigen Zunge",QueryProp(P_HANDS)[1],
	      ({DT_POISON, DT_BLUDGEON})}));
  SetProp(P_RACE, "Frosch");
  SetProp(P_SIZE, 250);
  SetProp(P_WEIGHT, 500000);
  SetProp(P_ALIGN, -600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -200);
  
  SetProp(P_MSGIN, "huepft herein.\Der Boden unter Dir erbebt");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  
  SetProp(P_DIE_MSG, " zerplatzt wie eine Seifenblase.\n");
  SetProp(P_NOCORPSE, 1);
  
  SetProp(P_MURDER_MSG, "Moege mich der Orden des Frosches raechen!");
  SetProp(P_KILL_NAME, "Der Orden des Frosches");
  
  SetProp(P_TRANSPARENT, 0);
  
  AddInfo(DEFAULT_INFO, ({"quakt nur.\n"}));
  
  SetProp(P_REJECT, ({REJECT_DROP,
	"Der Frosch will Deine Sachen nicht.\n" }) );

  SetChats(3, ({
       "Der Frosch quakt, sodass die Erde bebt.\n",
	 "Der Frosch huepft herum.\nDie Erde unter Dir bebt leicht.\n",
	 "Der Frosch faengt eine Fliege mit seiner Zunge.\n",
	 "Der Frosch streckt Dir seine Zunge heraus.\n"}));
  SetAttackChats(10, ({
     "Der Frosch quakt boese.\n",
       "Der Frosch huepft aufgeregt herum.\nDie Erde unter Dir bebt leicht.\n",
       "Der Frosch peitscht mit seiner Zunge herum.\n"}));
  
  SetProp(P_SPELLRATE, 40);
  
  AddSpell(3,400,
       "Der Frosch schleudert Dir seine Zunge entgegen.\n",
       "Der Frosch schleudert @WEM seine Zunge entgegen.\n",
       DT_SLASH,([SP_SHOW_DAMAGE:1]));
      
  AddSpell(2,550,
       "Der Frosch schleckt Dich ab.\n",
       "Der Frosch schleckt @WEN ab.\n",
       DT_POISON,([SP_SHOW_DAMAGE:1]));
      
  AddSpell(1,800,
       "Der Frosch springt auf Dich und erdrueckt Dich fast.\n",
       "Der Frosch springt auf @WEN.\n",
       DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  
  SUID;
  
  "/obj/gemmaster"->DistributeGem(5, 5, 0, ME, "diamant");
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if(enemy->QueryProp(P_FROG))
    dam=dam*2;
  
  return ::Defend(dam, dam_type_list, spell, enemy);
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction") != -1) return;
  
  if(touch && !TP->QueryProp(P_FROG))
    {
      tell_object(TP, BS("Der Schleim des Riesenfrosches veraezt Dich."));
      tell_room(ENV(TO), BS(TPN+" schreit ploetzlich laut auf."), 
		({TP}));
      
      SetProp(P_KILL_NAME, "Aetzender Froschschleim");
      
      TP->do_damage(5+random(6));
    }  
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}
