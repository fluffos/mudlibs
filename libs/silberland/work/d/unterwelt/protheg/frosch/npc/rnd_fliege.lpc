#include "../def.h"

inherit "std/mnpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();
  
  switch(random(6))
    {
    case 1:
      SetProp(P_SHORT, "Eine grosse Schmeissfliege brummt um Dich herum");
      SetProp(P_LONG,
	      BS("Eine besonders haessliche, grosse Schmeissfliege brummt "
		 "hier herum."));
      SetProp(P_NAME, "Schmeissfliege");
      AddId(({ "schmeissfliege"}));
      AddAdjective(({"grosse","grosser","grossen","gross"}));
      SetProp(P_NAME_ADJ, "gross");
      break;
    case 2:
      SetProp(P_SHORT, "Eine Eintagsfliege fliegt um Dich herum");
      SetProp(P_LONG,
	      BS("Eine harmlose Eintagsfliege fliegt hier herum. Morgen wirst "
		 "Du sie hier nicht mehr antreffen."));
      SetProp(P_NAME, "Eintagsfliege");
      AddId(({ "eintagsfliege"}));
      AddAdjective(({"harmlose","harmloser","harmlosen","harmlos"}));
      SetProp(P_NAME_ADJ, "harmlos");
      break;
    case 3:
      SetProp(P_SHORT, "Eine Obstfliege fliegt um Dich herum");
      SetProp(P_LONG,
	      BS("Eine Obstfliege fliegt hier herum."));
      SetProp(P_NAME, "Obstfliege");
      AddId(({ "obstfliege"}));
      break;
    case 4:
      SetProp(P_SHORT, "Eine fette Fleischfliege brummt um Dich herum");
      SetProp(P_LONG,
	      BS("Eine besonders fette Fleischfliege brummt "
		 "hier herum."));
      SetProp(P_NAME, "Fleischfliege");
      AddId(({ "fleischfliege"}));
      AddAdjective(({"fette","fetter","fetten","fett"}));
      SetProp(P_NAME_ADJ, "fett");
      break;
    case 5:
      SetProp(P_SHORT, "Eine laestige Fruchtfliege fliegt um Dich herum");
      SetProp(P_LONG,
	      BS("Eine kleine, jedoch laestige Fruchtfliege fliegt hier herum."));
      SetProp(P_NAME, "Fruchtfliege");
      AddId(({ "fruchtfliege"}));
      AddAdjective(({"laestige","laestiger","laestigen","laestig"}));
      SetProp(P_NAME_ADJ, "laestig");
      break;
    default:
      SetProp(P_SHORT, "Eine laestige Stubenfliege fliegt um Dich herum");
      SetProp(P_LONG,
	      BS("Eine kleine, jedoch laestige Stubenfliege fliegt hier herum."));
      SetProp(P_NAME, "Stubenfliege");
      AddId(({ "stubenfliege"}));
      AddAdjective(({"laestige","laestiger","laestigen","laestig"}));
      SetProp(P_NAME_ADJ, "laestig");
      break;
    }  

  AddId(({"fliege","NOCONTROL","SKILL_NOLEARN"}));
  
  SetProp(P_GENDER, FEMALE);

  create_default_npc(2);

  SetProp(P_HANDS, ({ " mit ihren Beinen",30, ({DT_PIERCE})}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 3);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_WEIGHT, 3);
  
  SetProp(P_NOATTACK, "weicht Dir aus, Du wirst sie nie treffen.\n");

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  AddInfo(DEFAULT_INFO, " antwortet unhoeflicherweise nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
		 Name(WER)+" ist viel zu klein, um sowas zu schleppen.\n" }) );
  
  SetProp(P_MNPC_AREA, ROOM);
  SetProp(P_MNPC_WAIT, ({12, 30, 60}) );
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS+MOV_INDOORS+MOV_INFIGHT+MOV_MOVES);
}

void init()
{
  ::init();
  
  if(!QueryProp(P_MNPC_DEFAULTROOM))
    if(ENV(ME))
      SetProp(P_MNPC_DEFAULTROOM, file_name(ENV(ME)));
}
