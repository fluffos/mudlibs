/*
**
** Eine lebendige Wurzel
** 
*/

inherit "std/npc";

#include "../def.h"

void create() 
{
  object d;
  
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Wurzel haengt von der Decke");
  SetProp(P_LONG, 
	  "Die Wurzel haengt von der Decke und scheint leicht zu schwingen...");
  
  SetProp(P_NAME, "Wurzel");
  SetProp(P_GENDER, FEMALE);
  
  AddId(({"wurzel","NOWIMPY","NOCONTROL","NO_MUMMY","NOFALLDOWN"}));
  
  create_default_npc(20);
  SetProp(P_MAX_SP, 1);
  SetProp(P_SP, 1);
  SetProp(P_HANDS, 
	  ({" mit einem Wurzelarm",QueryProp(P_HANDS)[1]+100,
	      ({DT_POISON, DT_BLUDGEON})}));
  SetProp(P_RACE, "Baum");
  SetProp(P_SIZE, 250);
  SetProp(P_WEIGHT, 500000);
  SetProp(P_ALIGN, -600);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_HEAL, -200);
  
  SetProp(P_MSGIN, "haengt von der Decke");
  SetProp(P_MSGOUT, "haengt");
  
  SetProp(P_DIE_MSG, " faellt schlaff herab.\n");

  SetProp(P_NOCORPSE, 1);
  
  SetProp(P_KILL_NAME, "Der Arm einer Wurzel");
  
  SetProp(P_TRANSPARENT, 0);
  
  AddInfo(DEFAULT_INFO, "haengt einfach nur da.");
  
  SetProp(P_REJECT, ({REJECT_DROP,
	"Die Wurzel will nicht behaengt werden.\n"}));
  
  SetChats(3, ({
       "Die Wurzel knarrt leicht.\n",
	 "Hat sich die Wurzel nicht gerade bewegt?\n"}));

  SetAttackChats(10, ({
     "Die Wurzel holt gross aus.\n",
       "Die Wurzel wickelt sich um Dein Bein.\n",
       "Die Wurzel versucht Dich zu erwuergen.\n"}));
  
  SetProp(P_SPELLRATE, 40);
  
  AddSpell(3,300,
	   "Die Wurzel peitscht Dich.\n",
	   "Die Wurzel peitscht @WEN.\n",
	   DT_SLASH,([SP_SHOW_DAMAGE:1]));
      
  AddSpell(2,550,
	   "Die Wurzel sticht Dich.\n",
	   "Die Wurzel sticht @WEN.\n",
	   DT_POISON,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(1,600,
	   "Die Wurzel wickelt sich fest um Dich.\n",
	   "Die Wurzel wickelt sich fest um @WEN.\n",
	   DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  if(!random(3))
    {
      SetProp(P_DIE_MSG, " faellt schlaff herab.\n"
	      "Ein kleiner Samen kullert heraus.\n");
      
      CLONEME(OBJ "lsamen");
    }
}

void init()
{
  ::init();
  
  if(TP && TP->id("wurzel")) AddDefender(TP);
}

void InformDefend(object e)
{
  Kill(e);
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction") != -1) return;
  
  if(touch)
    {
      write(BS("Die Wurzel beginnt sich ploetzlich zu bewegen..."));
      Kill(TP);
    }  
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}
