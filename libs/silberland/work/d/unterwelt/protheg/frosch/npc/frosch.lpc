/*
**
** Der Orden des Frosches
** 
*/

inherit "std/mnpc";

#include "../def.h"

nosave int frog, nofrog;

string info_indent()
{
  return (QueryProp(P_RACE)=="Mensch"?"sagt":"quakt");
}

void init_nofrog()
{
  RemoveId(QueryProp(P_IDS));
  
  create_default_npc((frog/3)+1);
  SetProp(P_HANDS, 
	  ({" mit seinen gruenen Fingern",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_WEIGHT, 75000);
  SetProp(P_HEAL, 0);
  SetProp(P_WIMPY, 10);
  
  SetProp(P_MSGIN, "rennt herein");
  SetProp(P_MSGOUT, "rennt");
  
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({5,10,5}));
  
  SetProp(P_SPELLS, ({}));
  
  nofrog=time();
  
  SetProp(P_REJECT, ({REJECT_DROP,
	Name()+ "will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
       Name()+"huepft herum.\n",
	 Name()+" murmelt etwas.\n",
	 Name()+" meditiert vor sich hin.\n",
	 Name()+" huepft herum.\n",
	 Name()+" faengt eine Fliege mit seiner Zunge.\n",
	 Name()+" streckt Dir seine Zunge heraus.\n"}));
  SetAttackChats(10, ({
     Name()+" quakt boese.\n",
       Name()+" huepft aufgeregt herum.\n",
       Name()+" peitscht mit seiner Zunge herum.\n"}));


  switch(frog)
    {
    case 1 .. 60:
      SetProp(P_SHORT, "Ein Juenger des Ordens");
      SetProp(P_LONG, "Ein sehr aufgebrachter Ordensjuenger!");
      AddId(({"juenger","ordensjuenger"}));
      
      SetProp(P_NAME, "Ordensjuenger");
      
      AddSpell(3,300,
       "Der Ordensjuenger schleudert Dir einen kleinen Feuerball entgegen.\n",
       "Der Ordensjuenger schleudert @WEM einen kleinen Feuerball entgegen.\n",
       DT_FIRE,([SP_SHOW_DAMAGE:1]));
      
      AddSpell(2,450,
       "Der Ordensjuenger schleudert Dir eine kleine Eislanze entgegen.\n",
       "Der Ordensjuenger schleudert @WEM eine kleine Eislanze entgegen.\n",
       DT_COLD,([SP_SHOW_DAMAGE:1]));
      
      AddSpell(1,600,
       "Der Ordensjuenger schleudert Dir einen kleinen Blitz entgegen.\n",
       "Der Ordensjuenger schleudert @WEM einen kleinen Blitz entgegen.\n",
       DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));
      
      CLONEME("/p/armour/armour/seidenjacke");
      
      if(!random(3)) CLONEME(OBJ "trank");
      
      break;
    case 61 .. 85:
      SetProp(P_SHORT, "Ein Prophet des Ordens");
      SetProp(P_LONG, "Ein sehr aufgebrachter Ordensprophet!");
      AddId(({"prophet","ordensprophet"}));
      
      SetProp(P_NAME, "Ordensprophet");
      
      AddSpell(3,400,
       "Der Ordensprophet schleudert Dir einen Feuerball entgegen.\n",
       "Der Ordensprophet schleudert @WEM einen Feuerball entgegen.\n",
       DT_FIRE,([SP_SHOW_DAMAGE:1]));
  
      AddSpell(2,550,
       "Der Ordensprophet schleudert Dir eine Eislanze entgegen.\n",
       "Der Ordensprophet schleudert @WEM eine Eislanze entgegen.\n",
       DT_COLD,([SP_SHOW_DAMAGE:1]));
      
      AddSpell(1,700,
       "Der Ordensprophet schleudert Dir einen Blitz entgegen.\n",
       "Der Ordensprophet schleudert @WEM einen Blitz entgegen.\n",
       DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));

      CLONEME("/p/armour/amulet/amulett");
      CLONEME("/p/armour/armour/lederruestung");
      
      if(!random(2)) CLONEME(OBJ "trank");
      if(!random(3)) CLONEME(OBJ "zauberstab");
      
      break;
    case 86 .. 100:
      SetProp(P_SHORT, "Ein Meister des Ordens");
      SetProp(P_LONG, "Ein sehr aufgebrachter Ordensmeister!");
      AddId(({"meister","ordensmeister"}));
      
      SetProp(P_NAME, "Ordensmeister");
      
      AddSpell(3,500,
       "Der Ordensmeister schleudert Dir einen heissen Feuerball entgegen.\n",
       "Der Ordensmeister schleudert @WEM einen heissen Feuerball entgegen.\n",
       DT_FIRE,([SP_SHOW_DAMAGE:1]));
      
      AddSpell(2,650,
       "Der Ordensmeister schleudert Dir eine eisige Eislanze entgegen.\n",
       "Der Ordensmeister schleudert @WEM eine eisige Eislanze entgegen.\n",
       DT_COLD,([SP_SHOW_DAMAGE:1]));
      
      AddSpell(1,800,
       "Der Ordensmeister schleudert Dir einen gewaltigen Blitz entgegen.\n",
       "Der Ordensmeister schleudert @WEM einen gewaltigen Blitz entgegen.\n",
       DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));
      
      CLONEME("/p/armour/amulet/amulett");
      CLONEME("/p/armour/armour/lederpanzer");
      CLONEME("/p/armour/bracers/mithrilarmschienen");
      
      CLONEME(OBJ "trank");
      if(random(3)) CLONEME(OBJ "zauberstab");
      
      break;
    }
  
  command("trage alles");
}

void init_frog()
{
  if(!frog)
    frog=random(100)+1;
  
  nofrog=0;
  
  RemoveId(QueryProp(P_IDS));
  
  SetProp(P_NAME, "Frosch");
  SetProp(P_GENDER, MALE);
  AddId(({"frosch","\nfroschordenfrosch"}));
  
  create_default_npc(10);
  SetProp(P_HANDS, 
	  ({" mit seinen gruenen Fingern",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Frosch");
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_WIMPY, 10);

  SetProp(P_MSGIN, "huepft herein");
  SetProp(P_MSGOUT, "geht");
  
  SetProp(P_SPELLS, ({}));
  
  filter_array(all_inventory(ME), CLOSURE(destruct));

  CLONEME(ARMOUR "orden");
  command("trage alles");

  SetProp(P_REJECT, ({REJECT_DROP,
	"Der Frosch will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
       "Der Frosch quakt.\n",
	 "Der Frosch murmelt etwas.\n",
	 "Der Frosch meditiert vor sich hin.\n",
	 "Der Frosch huepft herum.\n",
	 "Der Frosch faengt eine Fliege mit seiner Zunge.\n",
	 "Der Frosch streckt Dir seine Zunge heraus.\n"}));
  SetAttackChats(10, ({
    "Der Frosch quakt boese.\n",
       "Der Frosch huepft aufgeregt herum.\n",
       "Der Frosch peitscht mit seiner Zunge herum.\n"}));
  
  switch(frog)
    {
    case  1 ..  50: 
      SetProp(P_SHORT, "Ein Frosch des Ordens (Aufgenommener)");
      SetProp(P_LONG, 
	      BS("Ein kleiner, seltsamer Frosch. Er traegt einen goldenen "
		 "Orden, welcher ihn als Aufgenommener im Orden des Frosches "
		 "auszeichnet."));
      present("\nfroschorden")->SetType(1);

      SetProp(P_SPELLRATE, 20);
      
      AddId(({"\naufgenommenerfrosch","aufgenommener","aufgenommenerfrosch"}));
      
      AddSpell(3,300,
       "Der Frosch schleudert Dir einen kleinen Feuerball entgegen.\n",
       "Der Frosch schleudert @WEM einen kleinen Feuerball entgegen.\n",
       DT_FIRE,([SP_SHOW_DAMAGE:1]));
      
      AddSpell(2,450,
       "Der Frosch schleudert Dir eine kleine Eislanze entgegen.\n",
       "Der Frosch schleudert @WEM eine kleine Eislanze entgegen.\n",
       DT_COLD,([SP_SHOW_DAMAGE:1]));
      
      AddSpell(1,600,
       "Der Frosch schleudert Dir einen kleinen Blitz entgegen.\n",
       "Der Frosch schleudert @WEM einen kleinen Blitz entgegen.\n",
       DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));
      
      break;
    case 51 ..  80: SetProp(P_SHORT, "Ein Frosch des Ordens (Prophet)");
      SetProp(P_LONG, 
	      BS("Ein kleiner, seltsamer Frosch. Er traegt einen goldenen "
		 "Orden, welcher ihn als Prophet im Orden des Frosches "
		 "auszeichnet."));
      present("\nfroschorden")->SetType(2);
      
      SetProp(P_SPELLRATE, 30);
      
      AddId(({"\nprophetfrosch","prophet","prophetfrosch"}));
      
      AddSpell(3,400,
       "Der Frosch schleudert Dir einen Feuerball entgegen.\n",
       "Der Frosch schleudert @WEM einen Feuerball entgegen.\n",
       DT_FIRE,([SP_SHOW_DAMAGE:1]));
  
      AddSpell(2,550,
       "Der Frosch schleudert Dir eine Eislanze entgegen.\n",
       "Der Frosch schleudert @WEM eine Eislanze entgegen.\n",
       DT_COLD,([SP_SHOW_DAMAGE:1]));
      
      AddSpell(1,700,
       "Der Frosch schleudert Dir einen Blitz entgegen.\n",
       "Der Frosch schleudert @WEM einen Blitz entgegen.\n",
       DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));
      
      break;
    case 81 .. 100: SetProp(P_SHORT, "Ein Frosch des Ordens (Meister)");
      SetProp(P_LONG, 
	      BS("Ein kleiner, seltsamer Frosch. Er traegt einen goldenen "
		 "Orden, welcher ihn als Meister im Orden des Frosches "
		 "auszeichnet."));
      present("\nfroschorden")->SetType(3);
      
      SetProp(P_SPELLRATE, 40);
      
      AddId(({"\nmeisterfrosch","meister","meisterfrosch"}));
      
      AddSpell(3,500,
       "Der Frosch schleudert Dir einen heissen Feuerball entgegen.\n",
       "Der Frosch schleudert @WEM einen heissen Feuerball entgegen.\n",
       DT_FIRE,([SP_SHOW_DAMAGE:1]));
      
      AddSpell(2,650,
       "Der Frosch schleudert Dir eine eisige Eislanze entgegen.\n",
       "Der Frosch schleudert @WEM eine eisige Eislanze entgegen.\n",
       DT_COLD,([SP_SHOW_DAMAGE:1]));
      
      AddSpell(1,800,
       "Der Frosch schleudert Dir einen gewaltigen Blitz entgegen.\n",
       "Der Frosch schleudert @WEM einen gewaltigen Blitz entgegen.\n",
       DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));
      
      break;
    }
}

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  AddId(({"\norden_des_frosches"}));
  
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  
  SetProp(P_MNPC_AREA, ROOM "hoehle");
  SetProp(P_MNPC_WAIT, ({5,20,20}));
  
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  
  SetProp(P_DIE_MSG,  " kippt tot um.\n");
  
  SetProp(P_MURDER_MSG, "Moege mich der Orden des Frosches raechen!");
  SetProp(P_KILL_NAME, "Der Orden des Frosches");
  
  AddInfo(DEFAULT_INFO, 
	  ({"quakt nur.\n",
	      "meditiert einfach weiter.\n",
	      "murmelt etwas von 'Wahrheit'.\n",
	      "murmelt etwas von 'Universum'.\n",
	      "@@info_indent@@: Lass mich darueber meditieren.\n"}));
  
  AddInfo(({"frosch","froesche","form","froschform"}),
	  "Der Frosch ist die einzig wahre Form, nur als Frosch kannst Du "
	  "die absolute Wahrheit erkennen. Nur als Frosch wirst Du das wahre "
	  "Wesen des Universums sehen.",
	  "@@info_indent@@: ");
  
  AddInfo(({"wahrheit"}),
	  "Nur als Frosch kannst Du die Wahrheit erkennen.",
	  "@@info_indent@@: ");
  
  AddInfo(({"universum","wesen"}),
	  "Nur als Frosch wirst Du das wahre Wesen des Universums sehen.",
	  "@@info_indent@@: ");
  
  AddInfo(({"orden","orden des frosches","froschorden"}),
	  "Davon verstehst Du nichts!",
	  "@@info_indent@@: ");
  
  AddInfo(({"aufgenommener","aufgenommene"}),
	  "Die Aufgenommenen im Orden des Frosches befinden sich noch auf der "
	  "untersten Stufe.",
	  "@@info_indent@@: ");
  
  AddInfo(({"prophet","propheten"}),
	  "Propheten sind schon weit fortgeschritten im Orden des Frosches. "
	  "Sie befinden sich schon viel naeher an der Wahrheit.",
	  "@@info_indent@@: ");
  
  AddInfo(({"meister"}),
	  "Meister haben bereits die Vollendung im Orden des Frosches "
	  "erreicht. Sie haben die Wahrheit erkannt und leben nach ihr.",
	  "@@info_indent@@: ");
  
  AddInfo(({"allmacht","allwissen","allgegenwart"}),
	  "Danach muss jeder Frosch streben!",
	  "@@info_indent@@: ");
  
  SetProp(P_LOG_INFO, "protheg/frosch");
  
  SUID;
  
  init_frog();
}

void SetFrogLevel(int i)
{
  if(i<1) i=1;
  if(i>100) i=100;
  
  frog=i;
  
  if(!nofrog)
    init_frog();
}

void init()
{
  ::init();
  
  if(MENV) 
    if(!strlen(QueryProp(P_MNPC_DEFAULTROOM)))
      SetProp(P_MNPC_DEFAULTROOM, file_name(MENV));
  
  if(interactive(TP))
    call_out("hallo", 0);
}

void hallo()
{
  if(!TP) return;
  if(!MENV) return;
  if(!present(TP,MENV)) return;
  
  if(TP->QueryProp(P_FROG))
    {
      if(present("\nfroschorden", TP))
	write(BS(Name(WER)+" quakt: Sei gegruesst Bruder!"));
      else
	write(BS(Name(WER)+" quakt: Moegest Du die Wahrheit finden, Frosch!"));
    }
  else
    if(nofrog)
      {
	if(present("\nfroschorden", TP)) 
	  write(BS(Name(WER)+" quakt: Verraeter!"));
	
	if(!IsEnemy(TP)) 
	  write(BS(Name(WER)+" quakt: Stirb Unwuerdiger!"));

	Kill(TP);

	return;
      }
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();
  
  if((nofrog+1800) < time())
    init_frog();
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if(!nofrog)
    {
      tell_room(MENV, BS("Der Frosch quakt: Du willst also einen Kampf?!")+
		BS("Daraufhin verwandelt sich der Frosch ploetzlich zurueck..."));
      
      init_nofrog();
    }
  else
    nofrog=time();
  
  return ::Defend(dam, dam_type_list, spell, enemy);
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  if(killer)
    if(killer==ME)
      SetFrogLevel(frog+victim->QueryProp(P_LEVEL));
    else
      SetFrogLevel(frog+victim->QueryProp(P_LEVEL)/2);  
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;
  
  if(nofrog) return;
  
  if(touch)
    call_out("reaction", 0, TP,
	     "kreischt: Finger weg, das ist mein Schleim!",
	     "kreischt: Finger weg, das ist mein Schleim!");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}
