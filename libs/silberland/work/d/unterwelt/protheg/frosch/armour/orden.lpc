
#include "../def.h"

inherit "std/armour";

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Orden des Frosches");
  SetProp(P_LONG,
	  "Das ist ein kleiner, goldener Orden mit einem Frosch drauf." );
  
  SetProp(P_NAME, "Orden des Frosches");
  SetProp(P_GENDER, MALE);
  AddId( ({"orden", "froschorden", "orden des frosches", "\nfroschorden"}));
  
  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_GOLD:98,MAT_CLOTH:2]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 1000000);
  
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_DEFEND_FUNC, TO);
}

void SetType(int t)
{
  switch(t)
    {
    case 1: SetProp(P_SHORT, "Der Orden des Frosches (Anfaengerorden)");
      SetProp(P_LONG,
	      "Das ist ein kleiner, goldener Orden mit einem Frosch drauf. "
	      "Er stammt von einem Anfaengerfrosch.");
      AddId(({"anfaengerorden"}));
      break;
    case 2: SetProp(P_SHORT, "Der Orden des Frosches (Prophetenorden)");
      SetProp(P_LONG,
	      "Das ist ein kleiner, goldener Orden mit einem Frosch drauf. "
	      "Er stammt von einem Prophetenfrosch.");
      AddId(({"prophetorden","prophetenorden"}));
      break;
    case 3: SetProp(P_SHORT, "Der Orden des Frosches (Meisterorden)");
      SetProp(P_LONG,
	      "Das ist ein kleiner, goldener Orden mit einem Frosch drauf. "
	      "Er stammt von einem Meisterfrosch.");
      AddId(({"meisterorden"}));
      break;
    default: break;
    }
}

int WearFunc(object me) 
{
  if(MENV)
    if(query_once_interactive(MENV))  
      if(!MENV->QueryProp(P_FROG))
	return write(BS("Nur ein Frosch kann diesen Orden tragen!")), 0;
  
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy) 
{
  if(MENV)
    if(living(MENV))
      if(!query_once_interactive(MENV))
	return random(MENV->QueryAttribute(A_DEX))+MENV->QueryAttribute(A_CON);
  
  return 0;
}

void init()
{
  ::init();
  
  if(MENV && living(MENV)) return;
  
  if(ENV(MENV) && living(ENV(MENV))) return;
  
  call_out("aufloesen", 0, 1);
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();
  
  if(MENV && living(MENV)) return;
  
  if(ENV(MENV) && living(ENV(MENV))) return;
  
  call_out("aufloesen", 0, 1);
}

void aufloesen()
{
  tell_room(MENV, BS("Der Orden des Frosches loest sich ploetzlich auf!"));
  
  remove(1);
}
