/*
**
** Eingang zum Orden des Frosches
**
*/

#include "../def.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Der Eingang zu einer grossen Hoehle");
  SetProp(P_INT_LONG,
	  "Du findest Dich ploetzlich vor dem Eingang zu einer Hoehle wieder. "
	  "Wie ein grosses Loch ragt der Eingang vor Dir. Was sich wohl "
	  "dahinter verbirgt? Eine Holztafel haengt neben dem Eingang.");
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]));
  
  AddDetail(({"hoehlenboden","boden"}),
	    "Der Boden hier ist ziemlich staubig.");
  
  AddDetail(({"decke","hoehlendecke"}),
	    "Die Decke scheint eine normale Hoehlendecke zu sein.");
  
  AddDetail(({"eingang","hoehleneingang"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"hoehle","loch"}),
	    "Was sich wohl in der Hoehle befindet?");
  
  AddDetail(({"wand","waende","hoehlenwand","hoehlenwaende"}),
	    "Die Hoehlenwaende sind einfach nur Hoehlenwaende.");
  
  AddDetail(({"holztafel","tafel"}),
	    "Lesen bildet!");
  
  AddReadDetail(({"tafel","holztafel"}),
		"Auf der Holztafel steht: Der Orden des Frosches, nur "
		"Froesche erlaubt.");
  
  AddSound(DEFAULT_SOUND,
	   "Hier ist es ziemlich still.");
  
  AddSmell(DEFAULT_SMELL,
	   "Es riecht etwas modrig.");
  
  AddExit("norden", "nach Norden#" ROOM "hoehle:16:19");
}

