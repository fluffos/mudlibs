/*
**
** Grube des Riesenfrosches
**
*/

#include "../def.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Grube irgendwo in der Hoehle");
  SetProp(P_INT_LONG,
	  "Du stehst in einer mit Steinplatten ausgelegten Grube. "
	  "Sie ist von oben noch relativ gut beleuchtet.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]));
  
  AddDetail(({"boden","hoehlenboden","kammerboden"}),
	    "Der Boden ist hier komplett staubfrei! Du kannst sogar die "
	    "einzelnen Steinplatten im Boden erkennen.");
  
  AddDetail(({"platten","steinplatten"}),
	    "Die ganze Grube ist mit Steinplatten ausgelegt.");
  
  AddDetail(({"decke","hoehlendecke"}),
	    "Diese Grube hat keine Decke, die Hoehlendecke ist zu weit oben, um "
	    "etwas zu erkennen.");
  
  AddDetail(({"wand","waende","steinwand","steinwaende","grubenwand",
		"grubenwaende"}),
	    "Die Waende sind komplett mit Steinplatten ausgelegt. An einer Wand "
	    "befindet sich die Leiter, ueber die Du wieder rauf gelangst.");
  
  AddDetail(({"ausweg","ausgang","leiter"}),
	    "Die Leiter scheint der einzige Ausgang zu sein.");
  
  AddSound("grube",DEFAULT_SOUND,
	   "Hier ist es absolut still.");
  
  AddSmell(({"grube",DEFAULT_SMELL}),
	   "Es riecht sehr abartig hier...");
  
  AddExit("leiter", 
    ([EX_DEST:ROOM "kneipe", EX_MSG:"nach oben", EX_TESTFUNC:"player_exhaust"]));
  
  AddItem(NPC "riesenfrosch", REFRESH_DESTRUCT);
}

int player_exhaust()
{
  if(TP)
    if(interactive(TP))
      if(!TP->do_exhaust(50-(random(TP->QueryAttribute(A_CON)))))
	return 0;
  
  return 1;
}
