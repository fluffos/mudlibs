#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

#define P_LAST_FROG_ROOM "last_desert_room"
#define P_LAST_FROG_TIME "last_desert_time"

#define GO_WAIT ({ \
  "Du bist noch zu erschoepft von der Wanderung.", \
  "Deine Fuesse werden Dich erst in ein paar Sekunden weitertragen koennen.", \
  "Du musst noch ein paar Sekunden ausruhen.", \
  "Ein Schatten laesst Dich noch einen kleinen Moment innehalten.", \
  "Du musst erstmal wieder zu Atem kommen.", \
  "Die weite Wanderung hinterlaesst so langsam ihre Spuren.", \
  "War da nicht gerade noch ein Geraeusch?", \
  "Du glaubst etwas gesehen zu haben und stoppst noch einmal.", \
  "So langsam macht sich ein Krampf in Deinen Beinen bemerkbar.", \
  "Abrupt bleibst Du stehen und schaust Dich um.", \
  "Mach mal etwas langsamer!", \
  "War da an der Ecke nicht auf einmal Jemand?", \
  "So schnell kannst Du nicht weitergehen.", \
  "Du musst ein wenig langsamer gehen, sonst stirbst Du gleich vor Ort.", \
    "Du kannst nicht mehr.", })

#define FAILS ({ \
  "Ist das wirklich wichtig!\n", \
  "Sowas gibt es wirklich?\n", \
  "Sowas untersuchst Du?\n", \
  "Hast Du jetzt nicht eigentlich was anderes zu tun?\n", \
  "Lass das, das bringt doch so nichts!\n", \
  "Geh lieber metzeln, denn so wird das nichts!\n", \
  "Du untersuchst aber auch wirklich alles, oder?\n", \
  "Protheg war zu faul fuer dieses Detail!\n", \
  "Dieses Detail wurde an einen Gnom vermietet.\n", \
  "Gibts hier nicht, oder nicht in dieser Form!\n", \
  "Untersuch doch nicht jeden Bloedsinn!\n"})

string oldlong,newlong,*karte,*details;
int xpos,ypos;

void GenerateKarte();

nomask int query_prevent_shadow() {
  return 1;
}

void init() 
{
  object ob,env;
  
  ::init();
  
  if(TP && (env=ENV(TP)) && living(TP)) 
    if(objectp(ob=TP->QueryProp(P_LAST_FROG_ROOM))) 
      if(find_object(file_name(ob))) 
	if (ob != env) 
	  if (!sizeof(all_inventory(ob))) 
	    ob->remove();
  
  TP->SetProp(P_LAST_FROG_ROOM,env);
  TP->SetProp(P_LAST_FROG_TIME,time());
}

void reset() 
{
  object *all,*inv;
  int i,j;
  
  ::reset();
  
  all=all_inventory(ME);
  
  for(i=0;i<sizeof(all);i++) 
    {
      if(!query_once_interactive(all[i])) 
	{
	  if (!living(all[i])) 
	    {
	      tell_room(ME,BS(sprintf(
		    "%s wird von einem vorbeihuepfenden Frosch mitgenommen.\n",
		    all[i]->Name())));
	      all[i]->remove();
	    } 
	  else 
	    if(!present("Spieler",ME)) 
	      {
		inv=deep_inventory(all[i]);
		
		for (j=0;j<sizeof(inv);j++) 
		  inv[j]->remove(1);
		
		all[i]->remove();
	      }
	}
    }
  
  all=filter_array(all_inventory(ME),CLOSURE(living));
  
  if(!sizeof(all)) 
    call_out("remove",0);
}

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  oldlong="Du stehst mitten in einer gewaltigen Hoehle.";
  newlong=oldlong;

  SetProp(P_INT_SHORT, "In einer gewaltigen Hoehle" );
  SetProp(P_INT_LONG,  "@@show_long@@" );
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, 
    ([ENV_TEMPERATURE: 15+random(11), ENV_TERRAIN: TT_CAVE]) );

  karte=({ });
  PO->CustomizeObject();
  GenerateKarte();
}

int check_time() {
  if(!IS_WIZARD(TP) && (time() <= TP->QueryProp(P_LAST_FROG_TIME))) {
    write(BS(GO_WAIT[random(sizeof(GO_WAIT))]));
    return 0;
  }
  return 1;
}

nosave void GenerateKarte() 
{
  string *a,*b,*c;
  int i;

  a=b=c=({ });
  newlong=break_string(oldlong,72);
  a=explode(newlong,"\n");

  for (i=0;i<(8-sizeof(a));i++)
    a+=({ "" });
  
  b+=({karte[0]});
  
  for (i=1;i<5;i++) 
    b+=({ karte[i]+" "+a[i-1] });
  
  newlong=implode(b,"\n");
  
  for (i=4;i<sizeof(a);i++) 
    c+=({ a[i] });
  
  if(sizeof(c)>0) newlong+="\n"+BS(implode(c," "));
  
  return;
}

string show_long() 
{
  if(!IS_WIZARD(TP) && !present("\nfroschorden",TP))
    return BS(oldlong)[0..<2];
  
  return newlong[0..<2];
}

void SetVars(string *k,string l,string *det,int x,int y) 
{
  oldlong=l;
  details=det;
  karte=k;
  xpos=x;
  ypos=y;
  return;
}

varargs string GetDetail(mixed key, mixed race) 
{
  string *erg;
  
  if (member(details,key) != -1) 
    {
      erg=FROGMASTER->InsertDetail(key);

      if(pointerp(erg)) details+=erg;

      details-=({ key });
    }
  
  if (Query(P_DETAILS)[key]) return ::GetDetail(key,race);

  if(sizeof(FAILS)) 
    return FAILS[random(sizeof(FAILS))];
  
  return 0;
}

varargs string GetExits(object v)
{
  string ret;
  string *tmp;
  
  if(strlen(ret=::GetExits(v)))
    if(sizeof(tmp=explode(ret, ":"))==2)
      ret="Die Hoehle erstreckt sich nach:"+tmp[1];
  
  return ret;
}
