/*
**
** Ein verwurzelter Hoehlenabschnitt
**
*/

#include "../def.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Ein verwurzelter Abschnitt in einer grossen Hoehle");
  SetProp(P_INT_LONG,
	  "Der Hoehlenabschnitt hier ist vollkommen von Wurzeln die die "
	  "Nordwand herabwachsen blockiert. Da scheint von oberhalb eine "
	  "gewaltige Pflanze herunter durchzubrechen. Nur der steinerne "
	  "Boden ist noch verschont geblieben.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]));
  
  AddDetail(({"raum","hoehle","hoehlenabschnitt"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"hoehlenboden","boden"}),
	    "Der Boden hier ist ziemlich staubig.");
  
  AddDetail(({"decke","hoehlendecke"}),
	    "Von der Decke erkennt man fast nichts mehr, da sie von vielen "
	    "Wurzeln durchgebrochen wurde, die jetzt hier herumhaengen.");
  
  AddDetail(({"wand","waende","hoehlenwand","hoehlenwaende","nordwand"}),
	    "Die einzige Hoehlenwand, die Du hier siehst, ist die Nordwand "
	    "und die ist eigentlich fast komplett von den herabhaengenden "
	    "Wurzeln verdeckt.");
  
  AddDetail(({"erde","erdreich"}),
	    "Die Erde wird von den Wurzeln hier heruntergezogen.");
  
  AddDetail(({"pflanze"}),
	    "Es muss sich, den Wurzeln nach, um eine gewaltige Pflanze handeln.");
  
  AddDetail(({"wurzeln"}),
	    "Die Wurzeln haengen von der Decke herab und wachsen immer tiefer "
	    "in die Hoehle herein. Bei manchen hast Du sogar das Gefuehl, dass "
	    "sie sich bewegen wuerden.");
  
  AddDetail(({"bewegung"}),
	    "Da! Da hat sich gerade eine der Wurzeln bewegt...");
  
  AddSound(DEFAULT_SOUND,
	   "Hier ist es ziemlich still. Hie und da hoerst Du ein leises "
	   "Knarren.");
  
  AddSound(({"knarren","wurzel","wurzeln"}),
	   "Hin und wieder hoerst Du die Wurzeln leicht knarren...");
  
  AddSmell(({"erde","wurzeln",DEFAULT_SMELL}),
	   "Es riecht nach Erde und den Wurzeln.");
  
  AddExit("westen", "nach Westen#" ROOM "hoehle:13:11");
  AddExit("osten", "nach Osten#" ROOM "hoehle:15:11");
  AddExit("nordwesten", "nach Nordwesten#" ROOM "wurzel_w");
  AddExit("nordosten", "nach Nordosten#" ROOM "wurzel_o");
  AddExit("suedwesten", "nach Suedwesten#" ROOM "hoehle:13:12");
  
  AddItem(NPC "wurzel", REFRESH_DESTRUCT);
  AddItem(NPC "wurzel", REFRESH_DESTRUCT);
}

