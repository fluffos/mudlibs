inherit "std/pub";

#include "../def.h"

inherit MOST "std_room";

#include <pub.h>

void add_meister_frosch()
{
  object f;
  
  if(present("\nbarmeisterfrosch")) return;
  
  if(objectp(f=present("\nmeisterfrosch")))
    {
      f->AddId(({"\nbarmeisterfrosch"}));
      f->SetProp(P_MNPC_FLAGS, 0);
      return;
    }
  
  f=clone_object(NPC "frosch");
  f->SetFrogLevel(100);
  f->AddId(({"\nbarmeisterfrosch"}));
  f->SetProp(P_MNPC_FLAGS, 0);
  f->move(ME, M_NOCHECK);
}

void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:15]));
  SetProp(P_INT_SHORT, "Eine Kammer irgendwo in der Hoehle");
  SetProp(P_INT_LONG, 
	  "Du findest Dich in einer seltsamen Kammer wieder. Mitten im Raum "
	  "befindet sich ein gewaltiges Loch, welches man ueber eine Leiter "
	  "erreichen kann. Ansonsten ist die Kammer bis auf einen Tisch und ein "
	  "paar Fackeln an den Waenden leer.");

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "\nfroschordenfrosch");
  SetProp(P_PUBKEEPER_NAME, "Ein Frosch");
  SetProp(P_PUBMSG_NOKEEPER, "Leider ist zur Zeit kein Frosch des Ordens hier und alleine weisst Du nicht, welches von den Sachen trinkbar ist...\n");
  SetProp(P_PUBMSG_NOENEMY, 
	  BS("Feinde des Froschordens werden nicht bedient!"));
  SetProp(P_PUBMSG_NOINVITE, 
	  BS("Es herrscht grad Hektik im Kampf..."));
  SetProp(P_PUBMSG_FIGHTING, 
	  BS("Es herrscht grad Hektik im Kampf..."));

  AddDrink("Allwissen", ({"wissen","allwissen"}),
           300, 30, 0, 7,
           ({"Der Frosch deutet auf einen Krug, der auf dem Tisch steht. "
	       "Du nimmst ihn und leerst ihn in einem Zug. Ein seltsamer "
	       "Nachgeschmack verbleibt auf Deiner Zunge.\n",
	       "&& trinkt etwas aus einem Krug.\n"}));
  
  AddDrink("Allmacht", ({"macht","allmacht"}),
	   300, 30, 3, 4,
           ({"Der Frosch deutet auf ein Glas, das auf dem Tisch steht. "
	       "Du nimmst es und trinkst es aus. Dabei spuerst Du auf der "
	       "Zunge ein leichtes Prickeln...\n",
	       "&& trinkt etwas aus einem Glas.\n"}));

  AddDrink("Allgegenwart", ({"allgegenwart","gegenwart"}),
	   300, 30, -3, 7,
           ({"Der Frosch deutet auf ein Glas, das auf dem Tisch steht. "
	       "Du nimmst es und trinkst es, ohne hineinzusehen aus...\n"
	       "WHOOOOOOAAAAAAAHHHH!!! Das war das ekeligste, was Du je "
	       "getrunken hast! Durch den Schreck bist Du ganz munter!\n",
	       "&& trinkt ein Muntermacher und reisst die Augen auf...\n"}));
  
  AddDetail(({"kammer","raum"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"boden","kammerboden","hoehlenboden"}),
	    "Der Boden ist hier komplett staubfrei! Du kannst sogar die "
            "einzelnen Steinplatten im Boden erkennen. Weiter vor Dir gaehnt "
	    "ein grosses Loch im Boden.");
  
  AddDetail(({"platten","steinplatten"}),
            "Die ganze Kammer ist mit Steinplatten ausgelegt.");
  
  AddDetail(({"decke","hoehlendecke"}),
            "Die Hoehlendecke ist zu weit oben, um etwas zu erkennen.");
  
  AddDetail(({"wand","waende","steinwand","steinwaende","kammerwand",
		  "kammerwaende"}),
            "Die Waende sind komplett mit Steinplatten ausgelegt. Einige Fackeln "
	    "wurden daran aufgehaengt.");
  
  AddDetail(({"leiter"}),
	    "Ueber die Leiter gelangt man hinunter in das Loch.");
  
  AddDetail(({"loch"}),
	    "Das Loch reicht recht weit hinab, aber Du glaubst unten "
	    "Bewegungen zu vernehmen...");
  
  AddDetail(({"bewegung","bewegungen"}),
	    "Was da unten wohl ist?");
  
  AddDetail(({"fackeln"}),
	    "Einige Fackeln sind an den Waenden befestigt und erhellen die "
	    "Kammer. Eine der Fackeln scheint schief zu haengen.");
  
  AddDetail(({"fackel"}),
	    "Eine der Fackeln haengt schief.");
  
  AddDetail(({"tisch"}),
	    "Ein sehr seltsamer Tisch aus massivem Holz, der ueber und ueber "
	    "mit seltsamen, teilweise uebel riechenden Gefaessen gefuellt ist.");
  
  AddDetail(({"holz"}),
	    "Scheint sehr massives Holz zu sein. An einer Seite des Tisches "
	    "erkennst Du eine kleine Holztafel.");
  
  AddDetail(({"seite","tischseite"}),
	    "An einer Seite des Tisches erkennst Du eine kleine Holztafel.");
  
  AddDetail(({"tafel","holztafel"}),
	    "Auf der Holztafel steht das 'menue'.");
  
  AddDetail(({"gefaess","gefaesse"}),
	    "Auf dem Tisch stehen viele kleine und groessere Gefaesse, die "
	    "teilweise mit uebel riechendem Zeugs gefuellt sind. Scheinbar "
	    "werden die Fluessigkeiten von den Froeschen verwaltet.");
  
  AddDetail(({"zeugs","zeug","fluessigkeit","fluessigkeiten"}),
	    "Du willst eigentlich nicht genau wissen, was das alles fuer "
	    "Zeugs ist...");
  
  AddDetail(({"frosch","froesche"}),
	    "Die sind hier allgegenwaertig...");
  
  AddSound("kammer",DEFAULT_SOUND,
           "Hier ist es absolut still.");
  
  AddSmell(({"grube",DEFAULT_SMELL}),
           "Aus der Grube kommt ein recht abartig Geruch...");
  
  AddSmell(({"geruch"}),
	   "Der Geruch ist kaum auszuhalten.");
  
  AddCmd("menue", "newmenue");
  AddCmd(({"zieh","ziehe"}), "cmd_ziehen");
  AddCmd(({"dreh","drehe"}), "cmd_drehen");
  
  AddExit("osten", ROOM "hoehle:3:3");
  AddExit("suedosten", ROOM "hoehle:3:4");
  AddExit("leiter", ROOM "grube");
  
  RemoveItem("/obj/topliste");
  add_meister_frosch();
}

void reset()
{
  ::reset();
  
  add_meister_frosch();
}

nosave int cmd_ziehen(string str)
{
  if(!str) return 0;
  
  if(str=="an fackel"||str=="fackel")
    return write(BS("Du ziehst an der Fackel, doch sie bewegt sich nicht...")), 1;
  
  return 0;
}

nosave int cmd_drehen(string str)
{
  if(!str) return 0;
  
  if(str=="an fackel"||str=="fackel")
    return write(BS("Du drehst an der Fackel bis Du ein deutliches 'Klick' "
		    "vernimmst. Als Du die Fackel wieder loslaesst, bewegt "
		    "sie sich wieder in die urspruengliche Lage...")), 1;
  
  return 0;
}

nosave int newmenue(string str)
{
  int i;
  string ret;
  mixed *drink;

  drink=query_drink();
  ret="";

  ret+=duplicate(" ",25)+"Getraenke:\n"+
    duplicate(" ",24)+"------------\n";
  
  for(i=0;i<sizeof(drink);i++)
    ret+=duplicate(" ",5)+
      sprintf("%-39.39s %5.5d Muenzen\n",
	      drink[i][0], calc_price(drink[i]));
  
  if(!strlen(ret))
    ret="Zur Zeit sind wir ausverkauft!\n";

  TP->More(make_document(ret));
  return 1;
}
