/*
**
** Schatzkammer der Froesche
**
*/

#include "../def.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Kammer irgendwo in der Hoehle");
  SetProp(P_INT_LONG,
	  "Du findest Dich ploetzlich in einer kleinen Kammer wieder. "
	  "Die Kammer ist bis auf einen Altar, der die ganze Rueckwand "
	  "einnimmt leer.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]));
  
  AddDetail(({"kammer","raum","froschkammer"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"boden","hoehlenboden","kammerboden"}),
	    "Der Boden ist hier komplett staubfrei! Du kannst sogar die "
	    "einzelnen Steinplatten im Boden erkennen.");
  
  AddDetail(({"platten","steinplatten"}),
	    "Die ganze Kammer ist mit Steinplatten ausgelegt.");
  
  AddDetail(({"decke","hoehlendecke","kammerdecke"}),
	    "Die Decke ist genauso wie der Boden mit Steinplatten "
	    "ausgelegt.");
  
  AddDetail(({"wand","waende","hoehlenwand","hoehlenwaende","kammerwand",
		"kammerwaende"}),
	    "Die Waende sind komplett mit Steinplatten ausgelegt.");
  
  AddDetail(({"altar"}),
	    "Ein gewaltiger Altar nimmt die gesamte Rueckwand ein. Er ist "
	    "ueber und ueber mit Kerzen bedeckt, sodass Du die Skulpturen "
	    "darunter nicht mehr erkennen kannst. Eine kleine Schuessel "
	    "liegt darauf.");
  
  AddDetail(({"skulpturen","skulptur"}),
	    "Du kannst die Skulpturen darunter fast nicht mehr erkennen, "
	    "Du kannst gerade noch die Umrisse erahnen.");
  
  AddDetail(({"umriss","frosch","umrisse"}),
	    "Die Umrisse erinnern entfernt an einen Frosch.");
  
  AddDetail(({"kerze","kerzen"}),
	    "Der Altar ist ueber und ueber von fast abgebrannten Kerzen "
	    "bedeckt. Scheinbar ist dies hier ein sehr geheiligter Ort.");
  
  AddDetail(({"ort"}),
	    "Dies ist ein sehr heiliger Ort.");
  
  AddDetail(({"schuessel"}),
	    "Es scheint sich um eine Opferschuessel zu handeln.");
  
  AddDetail(({"opferschuessel"}),
	    "Normalerweise opfert man hier ein paar Muenzen...");
  
  AddDetail(({"muenzen","muenze"}),
	    "Ein paar Muenzen sollten reichen.");
  
  AddDetail(({"rueckwand"}),
	    "Die Rueckwand siehst Du eigentlich nicht, denn sie wird "
	    "komplett vom Altar eingenommen.");
  
  AddSound(DEFAULT_SOUND,
	   "Hier ist es absolut still.");
  
  AddSmell(({"kammer",DEFAULT_SMELL}),
	   "Es riecht ziemlich nach Wachs.");
  
  AddSmell(({"kerze","kerzen","wachs"}),
	   "Die ganze Kammer riecht nach warmem Wachs.");
  
  AddExit( "norden", "nach Norden#" ROOM "hoehle:21:3");
  
  AddCmd(({"opfer","opfere"}), "cmd_opfern");
}

nosave int cmd_opfern(string str)
{
  int amount;
  string foo;
  
  notify_fail(BS("Was und wieviel willst Du denn opfern?"));
  if(!str) return 0;
  
  if(sscanf(str, "%d muenze%s", amount, foo)!=2) return 0;
  
  if(amount < 1) return 0;
  
  if(TP->QueryMoney() < amount)
    return write(BS("Soviele Muenzen hast Du ja garnicht.")), 1;
  
  TP->AddMoney(-amount);
  
  if(TP->QueryProp(P_FROG))
    {
      write(BS("Du huepfst hoch und wirfst ein paar Muenzen in die "
	       "Opferschale...")+
	    BS("Sofort fuehlst Du Dich viel besser..."));
      
      if(amount > 10000) amount=10000;
      
      TP->heal_self(amount/10);
    }
  else
    {
      TP->SetProp(P_FROG, 1);
      
      write(BS("Du wirfst ein paar Muenzen in die Opferschale...")+
	    BS("Zuerst passiert nichts, doch ploetzlich faengst Du an zu "
	       "schrumpfen..."));
      
      tell_room(ME, BS(TPN+" ist nun naeher an der Wahrheit des Ordens des "
		       "Frosches."), ({TP}));
    }
  
  return 1;
}
