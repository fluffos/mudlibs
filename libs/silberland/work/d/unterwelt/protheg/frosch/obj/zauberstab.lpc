#include "../def.h"

inherit "std/thing";

nosave int stab;
nosave string *typ=({"weiss","rot","blau","gruen"});
nosave string *dt=({DT_LIGHTNING, DT_FIRE, DT_COLD, DT_POISON});

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  stab=random(sizeof(typ));
  
  SetProp(P_SHORT, "Ein Zauberstab mit "+typ[stab]+"er Spitze");
  SetProp(P_LONG,
	  BS("Ein kurzer, hoelzerner Zauberstab mit einer "+typ[stab]+
	     "en Spitze."));
  
  SetProp(P_INFO, "Der Zauberstab reagiert auf den uralten Befehl 'fiare'.");
  SetProp(P_NAME, "Zauberstab");
  SetProp(P_GENDER, MALE);
  AddId(({"stab","zauberstab"}));

  SetProp(P_MATERIAL, MAT_PEAR_WOOD);
  SetProp(P_MAGIC, 1);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  
  AddDetail(({"spitze","stabspitze","zauberstabspitze"}),
	    "Die Spitze des Zauberstabes ist "+typ[stab]+".");
  
  AddCmd(({"fiare"}), "cmd_spell");
}

nosave int cmd_spell(string str)
{
  object enemy;
  
  if(strlen(str))
    {
      if(!objectp(enemy=present(str, ENV(TP))))
	return write(BS("Wen willst Du mit Deinem Zauberstab angreifen?")), 1;
    }
  else
    {
      if(!objectp(enemy=TP->InFight()))
	return write(BS("Wen willst Du mit Deinem Zauberstab angreifen?")), 1;
    }
  
  if(enemy==TP)
    return write(BS("Dich selbst?!")), 1;
  
  if(TP->QueryProp(P_SP) < 10)
    return write(BS("Dazu reicht Deine Magie nicht!")), 1;
  
  if(TP->QueryProp(P_ATTACK_BUSY))
    return write(BS("Du bist im Moment zu sehr auf den Kampf konzentriert!")), 1;
  
  TP->SetProp(P_ATTACK_BUSY, 2);
  TP->AddSp(-10);
  
  write(BS("Du schwingst den Zauberstab und deutest damit auf "+
	   enemy->name(WEN)+"...")+
	BS("Ein "+typ[stab]+"er Strahl schiesst aus dem Zauberstab."));
  
  enemy->Defend(200+random(100), ({dt[stab]}), 
		([SP_NAME:"fiare",SP_PHYSICAL_ATTACK:0,SP_SHOW_DAMAGE:1]), TP);
  
  RemoveCmd(({"fiare"}));
  
  call_out("remove", 0, 1);
  
  return 1;
}
