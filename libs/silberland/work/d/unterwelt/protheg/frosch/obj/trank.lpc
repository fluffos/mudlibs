#include "../def.h"

inherit "std/thing";

nosave int trank;
nosave string *farbe=({"blau","rot","gruen"});

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  trank=random(3);
  
  SetProp(P_SHORT, "Ein kleines, "+farbe[trank]+"es Flaeschchen");
  SetProp(P_LONG,
	  BS("Ein kleines "+farbe[trank]+"es Flaeschchen. Was sich darin "
	     "wohl befindet?"));
  
  SetProp(P_INFO, 
	  BS("In solchen Flaeschchen befinden sich normalerweise "
	     "Heiltraenke."));
  
  SetProp(P_NAME, "Flaeschchen");
  SetProp(P_NAME_ADJ, farbe[trank]);
  AddAdjective(({farbe[trank],farbe[trank]+"e",farbe[trank]+"es",
		   farbe[trank]+"en"}));
  
  SetProp(P_GENDER, NEUTER);
  AddId("flaeschchen");
  
  SetProp(P_MATERIAL, MAT_GLASS);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  
  AddCmd(({"trink","trinke"}), "cmd_trinken");
}

nosave int cmd_trinken(string str)
{
  notify_fail(BS("Was willst Du trinken"));
  if(!str) return 0;
  
  if(!id(str)) return 0;
  
  if(TP->QueryProp(P_ATTACK_BUSY))
    return write(BS("Du bist im Moment zu sehr auf den Kampf konzentriert!")),
      1;
  
  write(BS("Du trinkst das "+farbe[trank]+"e Flaeschchen in einem Zug "
	   "leer..."));
  
  switch(trank)
    {
    case 0: TP->AddSp(30+random(21)); break;
    case 1: TP->AddHp(30+random(21)); break;
    case 2: TP->heal_self(30+random(21)); break;
    }
  
  TP->SetProp(P_ATTACK_BUSY, 1);
  
  RemoveCmd(({"trink","trinke"}));
  
  call_out("remove", 0, 1);
  
  return 1;
}
