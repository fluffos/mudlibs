#include "../def.h"

inherit "std/thing";

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  //  if(strstr(file_name(PO), ROOM)==-1) 
  if(getuid() != getuid(PO))
    {
      call_out("remove", 0);

      raise_error("Trottel, das darf nur " ROOM " clonen!");

      return;
    }
  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG,"");
  SetProp(P_NAME, 0);
  AddId(({"DIE_IF_DISCO"}));

  SetProp(P_INVIS, 1);
  
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}

void BecomesNetAlive(object spieler)
{
  object room;
  
  if(!MENV) return;
  if(MENV!=spieler) return;
  
  room=ENV(spieler);
  
  SetProp(P_KILL_NAME, "Ein harter Aufprall");
  spieler->do_damage(5000);
  
  call_out("remove", 1, 1);
  
  write_file(LOG "die_if_disco", dtime()+": "+CAP(getuid(spieler))+" stirbt "
	     "in "+file_name(room)+"\n");
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();
  
  if(MENV)
    if(interactive(MENV))
      call_out("remove",0 ,1);
}
