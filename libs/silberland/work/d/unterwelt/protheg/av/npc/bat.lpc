// Urspruenglich aus den Unterweltbasics
// Jetzt mnpc

#include "../def.h"

inherit "std/mnpc";

void Customize(int level)
{
  string *c_short;
  int    *c_level;

  c_short=({"klein","mittler","gross"});
  c_level=({4,7,10});

  if(level < 0) level = 0;
  if(level > 2) level = 2;

  SetProp(P_SHORT,"Eine "+c_short[level]+"e Fledermaus flattert hier herum");

  switch(level)
  {
    case 0  :
      SetProp(P_LONG,
        "Du siehst eine ganz gewoehnliche Fledermaus, wie man sie auch oft "
        "in alten Kirchtuermen oder Dachboeden findet. Ein schwaechlicher, "
        "kleiner Koerper mit einer hundeartigen, aber etwas eingedrueckten "
        "Schnauze, zwei Krallenbeinchen, mit denen sie sich gut an Aesten "
        "oder Felsvorspruengen festklammern kann, riesigen ultraschall"
        "empfindliche Ohren und natuerlich zwei duennen Flatterfluegeln mit "
        "verkuemmerten Krallenhaendchen daran. Sieht alles ziemlich harmlos "
        "aus."
      );
      break;

    case 1  :
      SetProp(P_LONG,
        "Diese Fledermaus sieht ihren kleineren Verwandten recht aehnlich, "
        "nur dass sie etwas groesser, staerker und boeser als diese ist. "
        "Sonst sieht sie ganz normal aus: Schnauze mit Zaehnen, Krallenbeine, "
        "lederartige Fluegel mit Krallenhaenden daran und grossen Ohren."
      );
      break;

    default :
      SetProp(P_LONG,
        "Diese Fledermaus sieht ihren kleinen und mittelgrossen Verwandten "
        "recht aehnlich, nur dass sie noch etwas groesser, staerker und boeser "
        "als diese ist. Sonst sieht sie ganz normal aus: Schnauze mit "
        "Zaehnen, Krallenbeinen, lederartige Fluegel mit Krallenhaenden "
        "daran und grossen Ohren."
      );
      break;
  }

  SetProp(P_NAME_ADJ, c_short[level]);
  SetProp(P_ADJECTIVES,0);
  AddAdjective( ({c_short[level]+"en",c_short[level]+"er",c_short[level]+"em"
                 ,c_short[level]+"es",c_short[level]+"e"}) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:50]));

  create_default_npc(c_level[level]);
  SetProp(P_HANDS, ({" mit ihren Krallen und Zaehnen",
     QueryProp(P_HANDS)[1], ({ DT_PIERCE, DT_RIP })  }));

  SetProp(P_SIZE, 10+random(5)+10*level);
  SetProp(P_ALIGN, -100-level*200);
  
  AddDetail(({"koerper","fledermauskoerper"}),
	    "Ein schwaechlicher, kleiner Koerper mit einer hundeartigen, "
	    "aber etwas eingedrueckten Schnauze, zwei Krallenbeinchen und "
	    "natuerlich zwei duennen Flatterfluegeln mit verkuemmerten "
	    "Krallenhaendchen daran.");
  
  AddDetail(({"schnauze","hundeschnauze","hundeartige schnauze"}),
	    "Die Fledermaus hat eine seltsame, hundeartige Schnauze.");
  
  AddDetail(({"beine","bein","beinchen","krallenbeinchen","kralleinbeine",
		"krallenbein"}),
	    "Die Fledermaus besitzt zwei kurze, jedoch scharfe "
	    "Krallenbeinchen.");
  
  AddDetail(({"ohr","ohren","fledermausohr","fledermausohren"}),
	    "Die Ohren sind ja groesser als der ganze Kopf!");
  
  AddDetail(({"kopf","fledermauskopf"}),
	    "Der Kopf der Fledermaus besteht eigentlich nur aus der "
	    "hundeartigen Schnauze, den grossen Ohren und Fell.");
  
  AddDetail(({"fell","fledermausfell"}),
	    "Das Fell der Fledermaus sieht recht weich aus.");
  
  AddDetail(({"auge","augen","fledermausauge","fledermausaugen"}),
	    "Hm, ah, doch! Die Fledermaus hat doch Augen, aber die sind "
	    "kaum zu erkennen.");
  
  AddDetail(({"fluegel","fledermausfluegel"}),
	    "Die Fluegel der Fledermaus sehen sehr widerstandsfaehig aus.");
  
  AddDetail(({"krallenhaendchen","krallenhand","krallenhaende","hand","haende",
		"haendchen"}),
	    "Die sehen recht scharf aus.");
}

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  AddId(({ "fledermaus" }));

  create_default_npc(4);

  SetProp(P_HANDS, ({" mit ihren kleinen Krallen und Zaehnchen",
     QueryProp(P_HANDS)[1], ({ DT_PIERCE, DT_RIP })  }));
  SetProp(P_NAME, "Fledermaus");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Fledermaus");
  AddClass( ({CL_FLYING, CL_ANIMAL}) );

  SetProp(P_SIZE, 10+random(5));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_WEIGHT, 15);
  
  SetProp(P_MNPC_AREA, ROOM "weg_");
  SetProp(P_MNPC_WAIT, ({12, 30, 60}) );
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS+MOV_INDOORS+MOV_INFIGHT+MOV_MOVES);  
  
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "flattert herein");
  SetProp(P_MMSGOUT, "flattert weg");

  Customize(random(3));
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void init()
{
  ::init();
  if(TP && TP->id("fledermaus")) AddDefender(TP);
  
  if(!QueryProp(P_MNPC_DEFAULTROOM))
    if(ENV(ME))
      SetProp(P_MNPC_DEFAULTROOM, file_name(ENV(ME)));
}
