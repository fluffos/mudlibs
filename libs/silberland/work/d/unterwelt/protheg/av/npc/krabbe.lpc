// Eine kleine Krabbe

#include "../def.h"

inherit "std/mnpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine kleine Krabbe krabbelt hier umher");
  SetProp(P_LONG,
	  BS("Eine kleine, rote Krabbe krabbelt vor Dir auf dem Boden "
	     "herum. Ihre grossen Scheren sehen nicht sonderlich bedrohlich "
	     "aus, dennoch koennten sie schmerzhaft zwicken..."));

  SetProp(P_NAME, "Krabbe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"krabbe"}));

  create_default_npc(2+random(2));

  SetProp(P_HANDS, ({ " mit ihren grossen Scheeren", 50, ({DT_SQUEEZE})}));
  SetProp(P_RACE, "Krustentier");
  SetProp(P_SIZE, 5);
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 0.01);
  SetProp(P_WIMPY, 3);
  SetProp(P_NOMAGIC, 0);
  SetProp(P_WEIGHT, 150);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "kommt aus dem Wasser gekrabbelt");
  SetProp(P_MMSGOUT, "krabbelt zurueck ins Wasser");

  SetProp(P_DIE_MSG,  " stirbt.\n");

  AddInfo(DEFAULT_INFO, " klappert nur mit ihren Scheeren.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Krabbe ist viel zu klein, um sowas zu schleppen.\n" }) );
  
  SetProp(P_MNPC_AREA, ROOM "noufer_");
  SetProp(P_MNPC_WAIT, ({12, 30, 60}) );
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS+MOV_INDOORS+MOV_INFIGHT+MOV_MOVES);
  
  AddDetail(({"schere","scheren","krabbenschere","krabbenscheren"}),
	    "Die sehen nicht sonderlich bedrohlich aus, dennoch koennten "
	    "sie schmerzhaft zwicken...");
  
  AddDetail(({"panzer","krabbenpanzer"}),
	    "Die Krabbe ist durch ihren harten Panzer geschuetzt.");
  
  SUID;
}

void init()
{
  ::init();
  
  if(!QueryProp(P_MNPC_DEFAULTROOM))
    if(ENV(ME))
      SetProp(P_MNPC_DEFAULTROOM, file_name(ENV(ME)));
}
