#include "../def.h"

inherit MOST "mynpc";

#define HFPREIS 299
#define DELFPREIS 99
#define LAGER 10
#define MYMONEY 2000

#define BSDK(x) break_string(x, 78, "Drowkrieger Krznar sagt: ",BS_LEAVE_MY_LFS+BS_NO_PARINDENT)

string menge_fackel();

nosave int vorrat;

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Drowkrieger Krznar, der Schlitzer");
  SetProp(P_LONG,
	  BS("Vor Dir steht ein beeindruckendes Bild von einem Dunkelelfen. "
	     "Eine fast zweieinhalb Meter grosse Gestalt mit einem bedrohlich "
	     "wirkenden, dunklen Umhang, einem schwarzen, tief ins Gesicht "
	     "gezogenen Hut, und einem kleinen Sack auf dem Ruecken funkelt "
	     "Dich boese an."));
  SetProp(P_NAME, ({"Drowkrieger Krznar","Drowkriegers Krznar",
		      "Drowkrieger Krznar","Drowkrieger Krznar"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:60]));
  AddId(({"krznar", "schlitzer","dunkelelf","drowkrieger","NOCONTROL",
	    "NOWIMPY"}));
  set_living_name("krznar");
  set_light(-2);
  
  create_default_npc(22);
  SetProp(P_HANDS, ({" mit seinen beiden Krummsaebeln",450,DT_SLASH}));
  SetProp(P_RACE, "Dunkelelf");
  SetProp(P_SIZE, 247);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_VULNERABILITY, ({DT_HOLY,DT_LIGHT}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC, 99);
  SetProp(P_GUILD, "dunkelelfen");
  SetProp(P_GUILD_LEVEL, 38);

  ModifySkill("dunkellanze", 10000);
  ModifySkill("dunkellanze", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]));
  ModifySkill("ausweichen", 10000);
  ModifySkill("ausweichen", ([SI_PREPARE_TIME:0, SI_SPELLCOST:10]));

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "tritt aus dem Schatten hervor");
  SetProp(P_MMSGOUT, "verschwindet in einem Schatten");

  SetProp(P_MNPC_AREA, ROOM "weg_" );
  SetProp(P_MNPC_WAIT, ({ 60, 60, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "weg_h03");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  
  AddDetail(({"bild"}),
	    QueryProp(P_LONG));
  
  AddDetail(({"meter","gestalt"}),
	    "Krznar misst beinahe zwei einhalb Meter! Ein wahrlich "
	    "beeindruckender Dunkelelf!");
  
  AddDetail(({"umhang"}),
	    "Der Umhang von Krznar laesst ihn ziemlich bedrohlich wirken.");
  
  AddDetail(({"hut"}),
	    "Krznar hat seinen schwarzen Hut tief ins Gesicht gezogen.");
  
  AddDetail(({"gesicht"}),
	    "Krznars Gesicht wird beinahe vollstaendig von seinem Hut "
	    "verdeckt.");
  
  AddDetail(({"ruecken"}),
	    "Krznar traegt einen kleinen Sack auf dem Ruecken.");
  
  AddDetail(({"sack"}),
	    "Der Sack ist zu unfoermig, als dass Du erahnen koenntest, was "
	    "sich in ihm befindet.");
  
  AddInfo(DEFAULT_INFO, "sagt: Nein! Dir verrate ich sicher nichts!\n");
  
  AddInfo("krznar",
	  "Was willst Du wissen von ihm?",
	  "fragt: ");
  
  AddInfo(({"hoellenfackel","hoellenfackeln","fackel","fackeln",
	      "hoellenfeuer"}),
	  CLOSURE(menge_fackel),
	  "sagt: ");
  
  AddInfo("sack",
	  "Darin bewahre ich meine Hoellenfackeln auf!",
	  "sagt: ");
  
  AddInfo(({"umhang","hut"}), 
	  "Der ist besonders wertvoll.",
	  "meint: ");
  
  AddInfo(({"hoelle","feuer","waren"}), 
	  "Ich verkaufe diese Hoellenfackeln hier. Das Feuer soll direkt "
	  "aus der Hoelle gekommen sein.",
	  "sagt: ");
  
  AddInfo(({"hilfe"}),
	  "Hilfe brauche ich nicht, aber Du vielleicht?! Ich habe den Auftrag,"
	  " diese Hoellenfackeln hier zu verkaufen. Willst Du eine kaufen?",
	  "sagt: ");
  
  AddInfo(({"auftrag"}),
	  "Ich wurde von Lotu-Varia persoenlich beauftragt, diese "
	  "Hoellenfackeln hier zu verkaufen...",
	  "sagt :");
  
  AddInfo(({"lotu","lotuvaria","lotu-varia","varia","drowpriesterin"}),
	  "Die Drowpriesterin Lotu-varia befindet sich im Haupttempel unten "
	  "in ArdulVhier.",
	  "sagt: ");
  
  AddInfo(({"tempel","haupttempel"}),
	  "Der Haupttempel befindet sich unten in ArdulVhier.",
	  "sagt: ");
  
  AddInfo(({"ardulvhier"}),
	  "deutet den Hoehlenweg hinunter.");
  
  SetProp(P_REJECT,({REJECT_DROP,"Krznar will Dein Zeugs nicht.\n"}));
  
  AddCmd(({"kaufe","kauf"}),"get_fackel");
  
  SetProp(P_SPELLRATE, 70);
  
  AddSpell(1,600,
	   "Drowkrieger Krznar schlitzt Dich auf.\n",
	   "Drowkrieger Krznar schlitzt @WEN auf.\n",
	   ({DT_SLASH,DT_RIP}), ([SP_SHOW_DAMAGE:0]));
  
  AddSpell(1,500,
	   "Drowkrieger Krznar versetzt Dir einen kritischen Treffer.\n",
	   "Drowkrieger Krznar versetzt @WEM einen kritischen Treffer.\n",
	   ({DT_SLASH}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,1,"","", DT_BLUDGEON, "dlanze");
  AddSpell(1,1,"","", DT_BLUDGEON, "ausw");

  SetChats(2, ({
    "Drowkrieger Krznar preist seine Waren an.\n",
      "Drowkrieger Krznar haelt Dir eine Hoellenfackel unter die Nase.\n",
      "Drowkrieger Krznar fragt: Willst Du eine Hoellenfackel?\n",
      "Drowkrieger Krznar sieht sich um.\n",
      "Drowkrieger Krznar fragt Dich: Hast Du schon mal Feuer direkt aus der Hoelle gesehen?\n",
      "Drowkrieger Krznar verneigt sich vor Dir.\n",
      "Drowkrieger Krznar mustert Dich.\n"}));
  vorrat=LAGER;
}

int Defend(int dam, mixed dam_type_list, mixed spell, object enemy)
{
  if(QuerySkillAttribute(SA_SPEED)<200)
    TO->ModifySkillAttribute(TO, SA_SPEED, 200, 500);
  
  return ::Defend(dam, dam_type_list, spell, enemy);
}

void dlanze(object enemy,int damage, mixed dam_type)
{
  command_me("dunkellanze");
}

void ausw(object enemy,int damage, mixed dam_type)
{
  command_me("ausweichen");
}

string _query_noattack()
{
  if(vorrat) 
    return "meint: Stoer mich nicht bei meinen Geschaeften!\n";

  if(TP->QueryProp(P_LEVEL)<=10) 
    return "taetschelt Dir nur grinsend den Kopf.\n";
}

void init()
{
  ::init();

  call_out("ww",1);
}

void ww()
{
  if(TP)
    if(present(TP)&&interactive(TP)&&TP->QueryProp(P_RACE)=="Dunkelelf")
      if(TP->QueryProp(P_LEVEL)<=10 || !random(3))
	write(BSDK("Brauchst Du vielleicht eine von meinen Hoellenfackeln?"));
      else
	write(BS("Drowkrieger Krznar verneigt sich vor Dir."));
}

void reset()
{
  ::reset();

  if(vorrat <= 3)
    vorrat=LAGER;
}

nosave int get_fackel(string str)
{
  object hf,mo;
  string ret;
  
  notify_fail(BS("Was willst Du denn von wem kaufen?"));
  if(!str) return 0;
  
  if(str=="fackel von krznar"||str=="hoellenfackel von krznar"||
     str=="hoellenfackel von krznar")
    {
      if(!vorrat) 
	return write(BSDK("Tut mir leid, ich muss mir erst neue Fackeln "
			  "holen.")),1;
      
      if(TP->QueryProp(P_RACE)=="Dunkelelf")
	{
	  if(TP->QueryMoney() < DELFPREIS)
	    return write(BSDK("Du hast ja nichteinmal die "+DELFPREIS+
			      " Muenzen fuer eine Hoellenfackel!")),1;
	  
	  if(TP->AddMoney(-DELFPREIS))
	    {
	      write(BSDK("Das kostet "+DELFPREIS+" Muenzen!")+
		    BS("Du gibst ihm das Geld, worauf er Dir eine "
		       "Hoellenfackel aushaendigt."));
	      say(BS("Krznar verkauft "+TP->name(WEM,1)+" eine Hoellenfackel."),
		  ({TP}));
	      
	      hf=clone_object(OBJ "hf");
	      
	      if(hf->move(TP)==ME_TOO_HEAVY)
		{
		  hf->move(MENV, M_NOCHECK);
		  write(BS("Die Hoellenfackel ist Dir zu schwer und faellt "
			   "auf den Boden."));
		}
	      vorrat--;
	      
	      if(vorrat<0) vorrat=0;
	      
	      if(!vorrat)
		ME->AddMoney(MYMONEY+random(500));
	      
	      return write(BSDK("Moege das Silberland im Dunkeln "
				"versinken!")),1;
	    }
	  else
	    return write(BSDK("Da scheint etwas nicht zu stimmen, komm doch "
			      "spaeter wieder!")),1;
	}
      else
	{
	  if(TP->QueryMoney()<HFPREIS)
	    return write(BSDK("Du hast ja nichteinmal die "+HFPREIS+
			      " Muenzen fuer eine Hoellenfackel!")),1;
	  
	  if(vorrat < 3)
	    return write(BSDK("Ich hab leider nicht mehr so viele, Ich "
			      "behalte den Rest lieber fuer einen "
			      "Dunkelelfen.")),1;

	  if(TP->AddMoney(-HFPREIS))
	    {
	      write(BSDK("Das kostet "+HFPREIS+" Muenzen!")+
		    BS("Du gibst ihm das Geld, worauf er Dir eine "
		       "Hoellenfackel aushaendigt."));
	      
	      say(BS("Krznar verkauft "+TP->name(WEM,1)+" eine Hoellenfackel."),
		  ({TP}));
	      
	      hf=clone_object(OBJ "hf");
	      
	      if(hf->move(TP)==ME_TOO_HEAVY)
		{
		  hf->move(MENV, M_NOCHECK);
		  
		  write(BS("Die Hoellenfackel ist Dir zu schwer und faellt "
			   "auf den Boden."));
		}
	      vorrat--;
	      return write(BSDK("Moege das Silberland im Dunkeln versinken!")),1;
	    }
	  else
	    return write(BSDK("Da scheint etwas nicht zu stimmen, komm doch "
			      "spaeter wieder!")),1;
	}
    }
  
  return 0;
}

string menge_fackel()
{
  if(!vorrat)
    return "Tut mir leid, aber ich habe keine Fackeln mehr!\n";

  return "Ich habe noch "+vorrat+" Hoellenfackeln!\n"
    "Willst Du etwa eine kaufen?\n";
}

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  
  if(verb=="verneig"||verb=="verneige")
    return call_out("reaction", 0, TP,
		    "verneigt sich vor Dir.",
		    "verneigt sich vor "+TP->Name(WEM,1)+".");
  
  switch (gruppe) 
    {
    case "fies":
      call_out("reaction", 0, TP,
	       "meint: Haha! Ganz nach meinem Geschmack!\n",
	       "meint: Haha! Ganz nach meinem Geschmack!\n");
      break;
    case "frech":
      call_out("reaction", 0, TP,
	       "grinst Dich an.\n",
	       "grinst "+TP->name(WEN,1)+" an.\n");
      break;
    case "froh":
      call_out("reaction", 0, TP,
	       "schuettelt nur seinen Kopf.\n", 
	       "schuettelt nur seinen Kopf.\n");
      break;
    case "intim":
      call_out("reaction", 0, TP,
	       "schuettelt sich entruestet.\n",
	       "schuettelt sich entruestet.\n");
      break;
    case "nett":
      call_out("reaction", 0, TP,
	       "grummelt Dich an.\n",
	       "grummelt "+TP->name(WEN,1)+" an.\n");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
	       "fragt Dich: Willst Du nicht eine Hoellenfackel kaufen?\n",
	       "haelt "+TP->name(WEN,1)+" eine Hoellenfackel unter die Nase.\n");
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}
 
