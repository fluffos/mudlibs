/*
** Der verrueckte Sklave Lugful
**
*/

#include "../def.h"

inherit MOST "mynpc";

void create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der verrueckte Kobold Lugful huepft um Dich herum");
  SetProp(P_LONG,
	  "Vor Dir befindet sich eine bemitleidenswerte Kreatur. Vollkommen "
	  "abgemagert, dreckig, einen durchdringenden Uringeruch verbreitend "
	  "und nur mit einem Lendenschurz bekleidet huepft der Kobold Lugful "
	  "vor Dir auf und ab. Offenbar ist er durch die jahrelange "
	  "Misshandlung seiner Herrin verrueckt geworden und wurde aus der "
	  "Stadt verbannt.");

  SetProp(P_NAME, "Lugful");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "verrueckt");
  AddAdjective(({"verrueckt","verrueckte","verrueckten"}));
  AddId(({"lugful", "kobold", "kobold lugful"}));
  
  create_default_npc(10);
  SetProp(P_HANDS, ({" garnicht",0 ,DT_BLUDGEON}));
  SetProp(P_XP, 10);
  SetProp(P_RACE, "Kobold");
  SetProp(P_SIZE, 80);
  SetProp(P_WEIGHT, 25000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 5);
  
  SetProp(P_MSGIN, "huepft ploetzlich um Dich herum");
  SetProp(P_MSGOUT, "huepft weg");
  SetProp(P_MMSGIN, "huepft ploetzlich um Dich herum");
  SetProp(P_MMSGOUT, "huepft irgendwohin");
  SetProp(P_MNPC_AREA, ROOM "noufer");
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "noufer_1_6_1");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS+MOV_INDOORS+MOV_MOVES+MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt erleichtert, aber tot zu Boden.\n");

  SetProp(P_MURDER_MSG, "Danke! Danke! Danke!");
  SetProp(P_KILL_MSG, "Oh Nein!! Wie konnte das nur passieren!");
  
  AddDetail(({"sklave","kreatur","misshandlung"}),
	    "Lugfur ist offenbar lange Jahre mishandelt worden und ist nur "
	    "noch eine armseelige Kreatur, die hier am Seeufer darauf wartet,"
	    " dass irgendjemand dem Elend ein Ende macht.");
  
  AddDetail(({"urin","uringeruch"}),
	    "Das riecht man doch!");
  
  AddDetail(({"lendenschurz"}),
	    "Viel mehr hat Lugfur nicht an.");
  
  AddDetail(({"herrin","dunkelelfe"}),
	    "Sicherlich hat eine aeusserst sadistische Dunkelelfe den "
	    "Kobold jahrelang mishandelt und ihn so zugerichtet.");
  
  AddDetail(({"jahre"}),
	    "Sehr lange offenbar...");
  
  SetProp(P_SMELL, "Lugful riecht fuerchterlich nah Urin!\n");
  
  AddInfo(DEFAULT_INFO, 
	  ({"grinst nur.",
	      "blickt schief.",
	      "huepft herum.",
	      "gackert.",
	      "wiehert.",
	      "gluckst.",
	      "rollt sich auf dem Boden herum.",
	      "springt auf und ab.",
	      "kreischt herum.",
	      "lacht nur irr.",
	      "singt: Hihihi!",
	      "kreischt: Hahaha!",
	      "kichert nur irr."}));
  
  AddInfo(({"sklave","misshandlung","herrin","dunkelelf","dunkelelfe",
		"dunkelelfen","ardulvhier","elend","urin"}),
	  "blickt angsterfuellt!");
  
  SetProp(P_REJECT, ({ REJECT_DROP,
     Name()+" kreischt: Nein! Ich darf das nicht nehmen!\n" }) );

  SetChats(3,({
     Name()+" huepft irr kichernd herum.\n",
       Name()+" murmelt: Lugfur tu das!\n",
       Name()+" murmelt: Lugfur tu dies!\n",
       Name()+" murmelt: Lugfur tu jenes!\n",
       Name()+" murmelt: Lugfur lass das!\n",
       Name()+" zuckt zusammen, als wuerde ihn wer auspeitschen.\n",
       Name()+" gackert herum.\n",
       Name()+" gluckst.\n",
       Name()+" kreischt herum.\n",
       Name()+" grinst Dich an.\n",
       Name()+" singt: Hihihi!\n",
       Name()+" springt auf und ab.\n"}));

  SetAttackChats(10, ({
     Name()+" fleht: Los! Toetet mich!\n",
       Name()+" fleht: Los! Macht schneller!\n",
       Name()+" fleht: Erloest mich! Bitte!\n",
       Name()+" fleht: Habt Erbarmen und toetet mich!\n"}));
  
  SUID;
  
  CLONEME("/p/armour/trousers/lendenschurz");
  command("trage alles");
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) 
    {
    case "aengstlich":
      call_out("reaction", 0, TP, 
	       "zittert.",
	       "zittert.");
      break;
    case "fies":
    case "aergerlich":
      call_out("reaction", 0, TP,
	       "zuckt winselnd zusammen.",
	       "zuckt winselnd zusammen.");
      break;
    case "frech":
    case "nett":
      call_out("reaction", 0, TP,
	       "zuckt zusammen.",
	       "zuckt zusammen");
      break;
    case "froh":
    case "traurig":
      call_out("reaction", 0, TP,
	       "bricht weinend in Traenen aus.", 
	       "bricht weinend in Traenen aus.");
      break;
    case "intim":
    case "albern":
      call_out("reaction", 0, TP,
	       "blickt schief.",
	       "blickt schief.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
	       "",
	       "");
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if(present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}

varargs string name(int casus, int demon)
{
  if(casus!=RAW)
    return ::name(casus, 1);
  
  return ::name(casus, demon);
}

void die(int pd)
{
  object k;
  
  if(objectp(k=QueryProp(P_KILLER)))
    if(interactive(k))
      if(k->QueryProp(P_ALIGN) > -1000)
	k->SetProp(P_ALIGN, k->QueryProp(P_ALIGN)-50);
  
  ::die(pd);      
}
