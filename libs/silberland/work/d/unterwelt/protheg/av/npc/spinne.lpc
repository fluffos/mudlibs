// Urspruenglich aus den Unterweltbasics
// Jetzt mnpc

#include "../def.h"

inherit "std/mnpc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine winzige Spinne krabbelt um Dich herum");
  SetProp(P_LONG,
	  BS("Eine kleine, dunkel gezeichnete Spinne sitzt hier mitten am "
	     "Boden. Ob die wohl giftig ist? Wenn nicht, stellt sie auf "
	     "jeden Fall keine Gefahr dar bei dieser geringen Groesse..."));

  SetProp(P_NAME, "Spinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({ "winzige spinne", "spinne"}));

  create_default_npc(3);

  SetProp(P_HANDS, ({ " mit acht Beinen",30, ({DT_PIERCE, DT_POISON}) }));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 5);
  SetProp(P_ALIGN, -250);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);
  SetProp(P_WEIGHT, 5);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " stirbt.\n");

  AddInfo(DEFAULT_INFO, " antwortet unhoeflicherweise nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Spinne ist viel zu klein, um sowas zu schleppen.\n" }) );
  
  SetProp(P_MNPC_AREA, ROOM "weg_");
  SetProp(P_MNPC_WAIT, ({12, 30, 60}) );
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS+MOV_INDOORS+MOV_INFIGHT+MOV_MOVES);
  
  AddDetail(({"bein","beine","spinnenbein","spinnenbeine"}),
	    "Die Spinne besitzt acht Spinnenbeine.");
  
  AddDetail(({"auge","augen","kopf","koerper","apinnenauge","spinnenaugen",
		"spinnenkopf","spinnenkoerper"}),
	    "Ja, das hat die Spinne alles.");
  
  SUID;
  
  if(!random(5)) CLONEME("/p/std/skills/sewing_tanning/obj/spinnenseide");
}

void init()
{
  ::init();
  
  if(!QueryProp(P_MNPC_DEFAULTROOM))
    if(ENV(ME))
      SetProp(P_MNPC_DEFAULTROOM, file_name(ENV(ME)));
}
