// Ssssslange

#include "../def.h"

inherit "std/mnpc";

#define SNCOLOR ({"gruen","rot","blau","violett","gelb","braun"})
#define SNPATTERN ({"getupft","gestreift","gepunktet"})

void create()
{
  string skin;
  object s;
  
  if(!is_clone(TO)) return;
  ::create();
  
  skin=SNCOLOR[random(sizeof(SNCOLOR))]+SNCOLOR[random(sizeof(SNCOLOR))]+
    SNPATTERN[random(sizeof(SNPATTERN))];  
  
  SetProp(P_SHORT, "Eine "+skin+"e Schlange schlaengelt am Boden herum");
  SetProp(P_LONG,
	  BS("Eine "+skin+"e Schlange schlaengelt vor Dir am Boden herum. "
	     "Du kannst nicht mit Sicherheit sagen, ob sie giftig ist..."));

  SetProp(P_NAME, "Schlange");
  SetProp(P_NAME_ADJ, skin);
  AddAdjective(({skin,skin+"e",skin+"en"}));
  
  SetProp(P_GENDER, FEMALE);
  AddId(({"schlange", skin+"e schlange"}));
  
  create_default_npc(5+random(2));
  
  SetProp(P_HANDS, ({ " mit ihren Giftzaehnen", 60, ({DT_PIERCE,DT_POISON})}));
  SetProp(P_RACE, "Schlange");
  SetProp(P_SIZE, 5);
  SetProp(P_ALIGN, -250);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, -10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);
  SetProp(P_WEIGHT, 500);

  SetProp(P_MSGIN, "schlaengelt sich herein");
  SetProp(P_MSGOUT, "schlaengelt sich");
  SetProp(P_MMSGIN, "kommt uebers Wasser hergeschlaengelt");
  SetProp(P_MMSGOUT, "schlaengelt aufs Wasser hinaus");
  
  SetProp(P_DIE_MSG,  " stirbt.\n");
  
  AddInfo(DEFAULT_INFO, " antwortet unhoeflicherweise nicht.\n");
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Schlange hat keine Haende, um sowas zu schleppen.\n"}));
  
  SetProp(P_MNPC_AREA, ROOM "noufer_");
  SetProp(P_MNPC_WAIT, ({12, 30, 60}) );
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS+MOV_INDOORS+MOV_INFIGHT+MOV_MOVES);
  
  AddDetail(({"kopf","schlangenkopf"}),
	    "Die "+skin+"e Schlange hat einen pfeilfoermigen Kopf.");
  
  AddDetail(({"schlangenschwanz","schwanz","koerper","schlangenkoerper"}),
	    "Der Koerper der Schlange beginnt an einem Ende mit dem Kopf "
	    "und endet am anderen mit dem Schwanz. Wo der Koerper aufhoert "
	    "und der Schwanz beginnt kannst Du nicht genau sagen.");
  
  SUID;
  
  catch(s=clone_object("/d/ebene/creative/feldlager/obj/haut"));
  
  if(objectp(s))
    {
      s->SetProp(P_SHORT, "Eine "+skin+" Schlangenhaut");
      s->SetProp(P_LONG, "Das ist eine "+skin+" Schlangenhaut.");
      s->move(ME, M_NOCHECK);
    }
}

void init()
{
  ::init();
  
  if(!QueryProp(P_MNPC_DEFAULTROOM))
    if(ENV(ME))
      SetProp(P_MNPC_DEFAULTROOM, file_name(ENV(ME)));
}
