#pragma strong_types

#include "../def.h"
 
inherit ROOM "nordufer";

// ---------- Funktionen
void create()
{
  ::create();
 
  SetAVStandards();
  
  AddDetail(({"weg"}),
    "Ihr koennt nur wieder den Weg zurueck nach Suedosten nehmen.");
  
  set_exits( "noufer");
}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  if(TP->QueryProp(P_RACE) == "Dunkelelf")
    SetProp(P_INT_LONG,
	    "Das Seeufer endet hier recht abrupt. Es fuehrt nur noch der "
	    "Weg wieder zurueck.");
  else
    SetProp(P_INT_LONG,
	    "Das Seeufer endet hier recht abrupt. Es fuehrt nur noch der "
	    "Weg wieder zurueck.");
  
  return ::int_long( viewer, viewpoint, shortflag);
}
