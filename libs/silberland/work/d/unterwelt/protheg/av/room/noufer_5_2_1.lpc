#pragma strong_types

#include "../def.h"

inherit ROOM "nordufer";

// ---------- Funktionen
void create()
{
  ::create();
 
  SetAVStandards();

  AddDetail_DSpc( ({ "pfeiler", "strebepfeiler" }),
    ("So etwas siehst Du hier nicht."),
    ("Der Fels ragt hier wie ein maechtiger Strebepfeiler in die Hoehle"
     " hinein.") );
  
  AddDetail( ({ "felsen", "vorsprung", "felsvorsprung" }),
    "Das Seeufer windet sich hier um einen Felsen herum." );
  
  AddDetail(({"boden"}),
    "Der Boden hier ist voll mit Knochen.");
  
  AddDetail(({"knochen","skelett","skeletteile","skeletteil","skelette"}),
    "Die Knochen scheinen alles Skeletteile zu sein. Vermutlich "
    "sind sie alle oben auf dem Sims ausgerutscht und "
    "heruntergestuerzt.");
  
  AddDetail(({"ausruestung"}),
    "Die ist schon lange weg...");
  
  set_exits("noufer");

  AddItem(({NPC "schlange",NPC "krabbe"}), REFRESH_DESTRUCT);
}

string int_long( mixed viewer, mixed viewpoint, int shortflag)
{
  if(TP->QueryProp(P_RACE) == "Dunkelelf")
    SetProp(P_INT_LONG,
	    "Das Seeufer windet sich hier um einen Felsen, der wie ein "
	    "Strebepfeiler die Decke zu stuetzen scheint. Der Boden hier "
	    "ist mit Knochen uebersaeht.");
  else
    SetProp(P_INT_LONG,
	    "Das Seeufer windet sich um einen Felsvorsprung der Hoehlenwand "
	    "herum. Der Boden hier ist mit Knochen uebersaeht.");

  return ::int_long( viewer, viewpoint, shortflag);
}
