/*
**  weg_t07.c  Weg von der Oberflaeche zur Dunkelelfenstadt ArdulVhier
**
**  Tyron, 24.5.2003
**
*/

#pragma strong_types
 
#include "../def.h"
 
inherit ROOM "std_av";

void create()
{
  ::create();
  
  //  Lichtlevel und Terrain
  SetAVStandards();
  
  SetProp(P_INT_SHORT, "Ein steiler Tunnel");
  SetProp(P_INT_LONG,  "");  // Wird in int_long() gesetzt...
 
  AddDetail(({"tunnel"}),
    "Ein steiler, enger Tunnel. Besonders wohl fuehlst Du Dich hier nicht.");

  AddDetail(({"unterwelt"}),
    "Das finstere Reich in den Tiefen des Silberlands.");

  AddDetail(({"tiefe","tiefen","reich"}),
    "Dort scheint dieser Gang hinzufuehren.");

  AddDetail(({"silberland"}),
    "Silbern ist hier gar nichts....");

  AddDetail_DSpc(({"sueden"}),
    ("Tiefste Dunkelheit!"),
    ("Im Sueden endet der Gang in einer grossen Hoehle."));

  AddDetail_DSpc(({"hoehle","hoehlen"}),
    ("Hoehle? Was fuer eine Hoehle? Du siehst keine."),
    ("Sie ist noch zu weit weg, als dass Du mehr erkennen koenntest."));

  AddDetail_DSpc(({"norden"}),
    ("Tiefste Dunkelheit!"),
    ("Ein Stueck den Gang hinauf kommt schliesslich ein Knick. Was"
     " dahinter liegt, kannst Du leider nicht sehen."));

  AddDetail_DSpc(({"knick"}),
    ("Knick? Was fuer ein Knick? Du siehst keinen."),
    ("Ein Stueck den Gang hinauf kommt schliesslich ein Knick. Was"
     " dahinter liegt, kannst Du leider nicht sehen."));

  AddDetail_DSpc(({"stueck"}),
    ("Wie, Stueck??"),
    ("Ein Stueck den Gang hinauf kommt schliesslich ein scharfer Knick."));

  AddDetail(({"fels","felsen","gestein","wand","waende","decke","boden"}),
    "Der Felsen besteht wohl aus Kalkstein und ist ziemlich rauh.");

  AddDetail(({"kalkstein"}),
    "Ein recht weiches Gestein, in dem sich haeufig Hoehlen bilden.");

  AddDetail_DSpc(({"dunkelheit","finsternis"}),
    ("Diese unendliche Finsternis geht Dir allmaehlich auf die Nerven. Du"
     " siehst fast nichts, nur wenige Schritte von Dir entfernt koennten"
     " sich die schlimmsten Monster verbergen."),
    ("Eine angenehme Dunkelheit umgibt Dich."));

  AddDetail_DSpc(({"platz","plaetze"}),
    ("Dies ist kein Platz fuer Dich."),
    ("Der Tunnel ist nicht besonders angenehm. Du kennst schoenere Plaetze"
     " in der Unterwelt."));

  AddDetail_DSpc(({"gang"}),
    ("Als Du Dir die Wand einmal genauer ansiehst, erkennst Du, dass der"
     " Gang kuenstlich angelegt wurde."),
    ("Dieser Gang wurde kuenstlich in den Felsen geschlagen."));

  AddDetail_DSpc(({"monster","alptraum","alptraeume"}),
    ("Monster, wie Du sie Dir in Deinen schlimmsten Alptraeumen nicht"
     " vorstellen kannst."),
    ("Ja, in der Unterwelt gibt es auch Monster, die einem Alptraeume"
     " bereiten koennen. Aber wie kommst Du jetzt darauf?"));

  AddDetail_DSpc(({"ahnung","nerven"}),
    ("Du hast keine Ahnung, was Dich auf den naechsten Metern erwartet."),
    ("Du hast keine Ahnung, was Dich in diesem Tunnel alles erwartet. Aber"
     " Du weisst, dass die Unterwelt gefaehrlich sein kann."));
  
  AddExit("suedunten", ROOM "weg_t08");
  AddExit("nordoben",  ROOM "weg_t06");
}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  if(objectp(viewer) && IS_DROW(viewer))
    SetProp(P_INT_LONG,
	    BS("Du stehst in einem der vielen Tunnel der Unterwelt. Er "
	       "verlaeuft von Sueden nach Norden und steigt dabei nach "
	       "Norden hin steil an. So geradlinig, wie er sich durch "
	       "das Gestein zieht, bist Du Dir ziemlich sicher, dass dies "
	       "kein natuerlicher Gang ist. Weiter im Sueden endet dieser "
	       "Tunnel in einer Hoehle, ein Stueck weiter im Norden "
	       "verschwindet er hinter einem scharfen Knick."));
  else
    SetProp(P_INT_LONG,
	    BS("Du stehst in einem Tunnel, der sich scheinbar endlos durch die"
	       " Finsternis der Unterwelt zieht. Er verlaeuft von Sueden nach "
	       "Norden und steigt dabei nach Norden hin steil an. Du hast "
	       "keine Ahnung, was Dich auf den naechsten Metern erwartet. "
	       "Schon nach kurzer Zeit verschwindet der Gang in tiefer "
	       "Finsternis. Irgendwie fuehlst Du Dich hier fehl am Platz."));
  
  return ::int_long(viewer, viewpoint, shortflag);
}
