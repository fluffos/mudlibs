/*
**  weg_h09.c  Weg von der Oberflaeche zur Dunkelelfenstadt ArdulVhier
**             Der Raum vor dem Stadttor
**
**  Tyron, 24.5.2003
**
*/

#pragma strong_types

#include "../def.h"

inherit ROOM "std_av";
 
void create()
{
  ::create();
 
  SetProp(P_INT_SHORT, "Vor dem Nordosttor von ArdulVhier");
  SetProp(P_INT_LONG,  "");  // Wird in int_long() gesetzt...
  
  //  Lichtlevel und Terrain 
  SetAVStandards(); 
  
  AddDetail_DSpc(({"hoehle"}),
    ("Ihr muesst in einer wirklich grossen Hoehle stehen, auch wenn Ihr Nichts"
     " erkennen koennt."),
    ("Ihr stehst in einer wundervollen, grossen Hoehle."));

  AddDetail_DSpc(({"decke"}),
    ("Eine Decke seht Ihr nicht."),
    ("Die ist weit ueber Euch, Ihr koennst sie kaum erkennen."));

  AddDetail(({"boden"}),
    "Der 'Boden' besteht aus einem schmalen Felsbogen...");

  AddDetail_DSpc(({"dunkelheit"}),
    ("Eure Augen koennen die Dunkelheit hier nicht durchdringen. Ihr "
     "koennt nur erahnen, wie gross die Hoehle ist, und was sich alles darin"
     " verstecken mag."),
    ("Die Hoehle ist in eine angenehme Dunkelheit gehuellt."));
  
  AddDetail(({"augen"}),
    "Ja, Eure!");
  
  AddDetail(({"licht"}),
    "Licht gibt es hier unten keins.");

  AddDetail_D_ZSpc(({"bruecke"}),
    ("Ob man diesen Felsbogen wirklich eine Bruecke nennen kann?"),
    ("Die Bruecke ist eine kunstvolle Dunkelelfenarbeit. So geformt, als"
     " sei sie natuerlich entstanden. Sie fuehrt zum Stadttor im Suedwesten."),
    ("Auch wenn sie fast wie natuerlich entstanden aussieht: Ihr erkennt,"
     " dass es sich um eine kuenstlich angelegte Bruecke handelt. Und Ihr "
     "muesst neidvoll zugeben, dass sie genauso kunstvoll gebaut ist wie eine "
     "Zwergenarbeit."));
  
  AddDetail_D_ZSpc(({"bogen", "felsbogen", "etwas"}),
    ("Ein schmaler, duenner Felsbogen, der hier wohl als Bruecke dient."),
    ("Eine filigrane Bruecke."),
    ("Eine filigrane Bruecke."));
  
  AddDetail_D_ZSpc(({"dunkelelfenarbeit", "arbeit"}),
    ("Das Tor koennte die Arbeit von Dunkelelfen sein."),
    ("Das Stadttor und die Bruecke sind Arbeiten von Dunkelelfen."),
    ("Das Tor und die Bruecke sind Arbeiten von Dunkelelfen."));
  
  AddDetail(({"zwergenarbeit", "zwergenarbeiten"}),
    "Zwergenarbeiten gibt es hier weit und breit keine.");
  
  AddDetail(({"zwerge"}),
    "So tief unten wohnen auch keine Zwerge mehr.");
  
  AddDetail_DSpc(({"dunkelelf", "dunkelelfen"}),
    ("Angeblich soll es hier irgendwo eine Stadt der Dunkelelfen geben."),
    ("Ihr koennt stolz darauf sein, zu diesem Volk zu gehoeren."));
  
  AddDetail_DSpc(({"tor", "stadttor"}),
    ("In die Felswand fuehrt ein Tunnel hinein. Sein Portal besteht aus"
     " schwarzen Onyx, der aber von feinsten, silberfarbenen Faeden durchzogen"
     " ist. Das Portal ist so glatt und fugenlos gearbeitet, dass es so"
     " aussieht, als bestehe es aus einem einzigen Block. In die Pfosten des"
     " Portals sind Angeln eingelassen, an denen schwere, eiserne Torfluegel"
     " haengen.\n"
     "Ueber dem Tor erkennt Ihr schmale Schlitze in der Felswand."),
    ("Das Stadttor von ArdulVhier ist ein Tunnel, der durch die Felswand in"
     " die Stadt fuehrt. Das Portal dieses Tunnels besteht aus schwarzen Onyx,"
     " der von feinsten, silberfarbenen Faeden durchzogen ist. Das Portal ist"
     " so glatt und fugenlos gearbeitet, dass es so aussieht, als bestehe es"
     " aus einem einzigen Block. In die Pfosten des Portals sind Angeln"
     " eingelassen, an denen schwere, eiserne Torfluegel haengen.\n"
     "Oberhalb des Tors erkennt Ihr die Schiessscharten des Wehrgangs, der um"
     " die Stadt herum fuehrt."));
  
  AddDetail_DSpc(({"tunnel", "oeffnung"}),
    ("Ihr koennt in der dunklen Oeffnung nichts erkennen."),
    ("Der Tunnel fuehrt in die Stadt."));
  
  AddDetail(({"portal"}),
    "Das Portal ist sehr schlicht, aber sichtlich mit grossem Aufwand"
    " hergestellt worden.");
  
  AddDetail(({"aufwand"}),
    "Es muss einen enormen Aufwand bedeutet haben, den harten Onyx so glatt zu"
    " polieren.");
  
  AddDetail(({"onyx", "faeden"}),
    "Normalerweise ist Onyx komplett schwarz. Aber dieser hier ist von sehr"
    " feinen silbernen Faeden durchzogen. Er ist voellig glatt poliert.");
  
  AddDetail(({"block", "onyxblock", "fuge", "fugen"}),
    "In dem Portal ist nicht eine einzige Fuge zu erkennen. Es sieht"
    " tatsaechlich so aus, als bestuende es aus einem einzigen Onyxblock.");
  
  AddDetail(({"pfosten", "angeln"}),
    "In die Pfosten sind grosse, eiserne Angeln eingelassen.");

  AddDetail(({"fluegel", "torfluegel"}),
    "Das Tor kann durch schwere, eiserne Torfluegel verschlossen werden.");

  AddDetail_DSpc(({"schlitz", "schlitze"}),
    ("Ueber dem Tor erkennt Ihr schmale Schlitze in der Felswand."),
    ("Oberhalb des Tors erkennt Ihr die Schiessscharten des Wehrgangs, der um"
     " die Stadt herum fuehrt."));

  AddDetail_DSpc(({"schiessscharte", "schiessscharten","schiesscharte", 
		     "schiesscharten"}),
    ("Die Schlitze ueber dem Tor koennten tatsaechlich Schiessscharten sein."),
    ("Die Schiessscharten gehoeren zu dem Wehrgang, der um die Stadt herum"
     " fuehrt."));

  AddDetail_DSpc(({"wehrgang"}),
    ("Ihr koennt keinen Wehrgang erkennen."),
    ("Ihr wisst, dass in der Felswand ein solcher Gang verlaeuft, aber Ihr "
     "koennt ihn von hier aus natuerlich nicht sehen."));

  AddDetail_DSpc(({"suedwesten"}),
    ("Im Suedwesten fuehrt der Bogen zu einer Felswand mit einem"
     " eindrucksvollen Tor."),
    ("Im Suedwesten fuehrt die Bruecke zum eindrucksvollen Stadttor von"
     "ArdulVhier"));

  AddDetail(({"wand", "felswand"}),
    "Die Felswand ist so glatt, als sei sie poliert worden.");

  AddDetail(({"geraeusch", "geraeusche"}),
    "Seit wann koennt Ihr Geraeusche sehen?");

  AddDetail_DSpc(({"gewaesser", "wasser", "see", "ardulvhier-see",
                     "oberflaeche"}),
    ("Ihr koennt nur schemenhaft eine Wasserflaeche, vielleicht einen "
     "unterirdischen See, erkennen."),
    ("Unter Euch schimmert dunkel die Oberflaeche des ArdulVhier-Sees."));

  AddDetail_DSpc(({"stadt", "ardulvhier"}),
    ("Ihr seht das Stadttor der Stadt im Suedwesten."),
    ("Man sieht von hier aus nur das Stadttor und die Schiessscharten der"
     " Wehrgaenge. Aber Ihr wisst, dass sie die praechtigste und schoenste"
     " Stadt der Welt ist."));

  AddDetail_DSpc(({"nordosten", "ufer", "sims"}),
    ("So etwas seht Ihr hier nicht."),
    ("Im Nordosten fuehrt die Bruecke zu einem schmalen Sims, der am See"
     " entlang fuehrt."));

  AddSound_DSpc(DEFAULT_SOUND,
    ("Irgendwo aus der Dunkelheit hoert Ihr Wasser tropfen."),
    ("Ihr hoert, wie Wasser von der Decke in den See tropft."));

  AddSound_DSpc(({"wasser", "tropfen", "wassertropfen"}),
    ("Ihr hoert ein unregelmaessiges Tropfen. Es klingt, als wuerden "
     "Wassertropfen auf eine grosse Wasserflaeche fallen."),
    ("Ihr hoert das klingende 'pling, pling', mit dem einzelne"
     " Wassertropfen in den See fallen, das 'Lied von ArdulVhier'."));

  AddSound_DSpc(({"lied", "melodie", "ardulvhier", "see"}),
    ("Ihr lauscht, hoert aber Nichts."),
    ("\nIhr lauscht der zarten Melodie der Wassertropfen. Mit Bedauern"
     " denkt Ihr daran, dass Ihr jetzt nicht am 'Stein des Liedes' seid. An"
     " diesem Platz soll man das Lied des Sees besonders gut hoeren"
     " koennen."));

  AddSound_DSpc(({"geraeusche", "hall"}),
    ("Alle Geraeusche hallen hoerbar nach, wie in einer grossen Halle oder"
     " Kirche."),
    ("Alle Geraeusche hallen in der gewaltigen Hoehle hoerbar nach."));

  AddExit("nordosten",  ROOM "weg_h08");
  AddExit("suedwesten", ROOM "tor_5_17_5");
}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  if(objectp(viewer) && IS_DROW(viewer))
    SetProp(P_INT_LONG,
	    BS("Ihr steht auf einer filigranen Bruecke ueber den "
	       "ArdulVhier-See. Nach Suedwesten fuehrt sie zum Stadttor "
	       "von ArdulVhier, nach Nordosten zum anderen Ufer des hier "
	       "sehr schmalen Sees."));
  else 
  if(objectp(viewer) && IS_DWARF(viewer))
      SetProp(P_INT_LONG,
	      BS("Ihr steht auf einer filigranen Bruecke, die ueber ein "
		 "dunkles Gewaesser fuehrt. Aergerlich muesst Ihr Euch "
		 "eingestehen, dass diese Bruecke genauso kunstvoll wie "
		 "eine Zwergenarbeit ist, auch wenn sie definitiv nicht "
		 "von Zwergen erbaut wurde. Im Suedwesten fuehrt die "
		 "Bruecke zu einer Felswand mit einem eindrucksvollen Tor."));
    else
      SetProp(P_INT_LONG,
	      BS("Ihr steht auf einem zerbrechlich wirkenden Felsbogen, der "
		 "ueber ein dunkles Gewaesser fuehrt. Ihr seid Euch ganz und "
		 "gar nicht sicher, ob dieses Etwas stabil genug ist, Euch "
		 "zu tragen. Im Suedwesten fuehrt der Bogen zu einer "
		 "Felswand mit einem eindrucksvollen Tor."));
  
  return ::int_long(viewer, viewpoint, shortflag);
}
