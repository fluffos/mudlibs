/*
** Ein Boot fuer Ardulvhiers See
** by PROtheG@Silberland
**
**
*/

#include "../def.h"

inherit "std/transport";

#define LANDEPLATZ_1 ROOM "noufer_3_4_1"
#define LANDEPLATZ_2 ROOM "weg_h08"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Langboot");
  SetProp(P_INT_LONG,
	  BS("Ihr befindet Euch auf einem laenglichen Holzboot, welches "
	     "ueber den See von Ardulvhier gleitet."));

  SetProp(P_SHORT, "Ein laengliches Holzboot hat hier angelegt");
  SetProp(P_LONG,
	  BS("Du siehst ein laengliches Holzboot. Es liegt hier am Seeufer "
	     "und wartet auf Passagiere"));
  
  AddId(({"boot", "holzboot","langboot"}));
  
  SetProp(P_NAME, "Langboot");
  SetProp(P_NAME_ADJ, "hoelzern");
  AddAdjective(({"hoelzernen","hoelzern","hoelzerne"}));
  
  SetProp(P_GENDER, NEUTER);
  
  SetProp(P_LIGHT, 0);
  SetProp(P_TRANSPARENT,1);
  
  AddDetail(({"boot","holzboot","langboot"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"see","ardulvhiersee","wasser","wasseroberflaeche"}),
	    "Das Langboot gleitet sanft ueber den See dahin.");
  
  AddDetail(({"boden"}),
	    "Der ist weit unter Euch!");
  
  AddDetail(({"insel"}),
	    "Mitten im See scheint sich eine grosse Insel zu befinden. "
	    "Leider koennt Ihr sie mit diesem Boot nicht erreichen.");
  
  AddDetail(({"ardulvhier","stadt","dunkelelfenstadt","drowstadt"}),
	    "Im Suedwesten scheint sich eine Stadt zu befinden, vermutlich "
	    "ist das Ardulvhier.");
  
  SetProp(P_DEPARTMSG, ({
      "Das Langboot stoesst ab.\n",
      "Das Langboot stoesst ab.\n"})); 
      
  SetProp(P_ARRIVEMSG, ({
    "Das Langboot erreicht ein @@QueryArrived@@.\n",
    "Ein Langboot legt am Seeufer an.\n"}));
    
  SetProp(P_ENTERMSG, ({
    "betritt das Langboot",
    "betritt das Langboot"}));
  
  SetProp(P_MAX_PASSENGERS, 3);

  SetProp(P_ENTERFAIL,
    BS("Es befinden sich bereits 3 Personen auf dem Langboot. Es wuerde "
       "sonst wohl sinken."));

  SetProp(P_LEAVEMSG, ({
    "verlaesst das Langboot",
    "verlaesst das Langboot"}));
      
  SetProp(P_LEAVEFAIL,
    "Lieber nicht! Ihr wisst nicht, was da in dem Wasser lebt.\n");
  
  AddCmd(({"fahr","fahre"}), "cmd_fahren");
  AddCmd(({"betret","betrete","betritt"}), "cmd_betreten");
  AddCmd(({"verlasse", "verlass"}), "cmd_verlassen");

  AddRoute(LANDEPLATZ_1, 30, 20, "Seeufer nahe einer Schlammbank",
	   ({"bank","schlammbank"}), "zu einer Schlammbank am Seeufer");
  
  AddMsg(BS("Das Langboot treibt auf den See hinaus."), 15);
  
  AddMsg(BS("Das Langboot treibt an einer grossen Insel mitten im See "
	    "vorbei."), 15);
  
  AddMsg(BS("Das Langboot treibt ueber den ruhigen See dahin."), 10);
  
  AddMsg(BS("Das Langboot naehert sich dem Seeufer von Ardulvhier."), 10);
  
  AddRoute(LANDEPLATZ_2, 30, 20, "Seeufer bei Ardulvhier", 
	   ({"ardulvhier"}), "zum Seeufer bei Ardulvhier");
  
  AddMsg(BS("Das Langboot treibt auf den See hinaus."), 15);
	 
  AddMsg(BS("Das Langboot treibt an einer grossen Insel mitten im See "
	    "vorbei."), 15);
  
  AddMsg(BS("Das Langboot treibt ueber den ruhigen See dahin."), 10);
  
  AddMsg(BS("Das Langboot naehert sich einer Schlammbank.\n"), 10);
  
  Start();
}

nosave int cmd_fahren(string str)
{
  notify_fail(BS("Womit wollt Ihr fahren?"));
  if(!str) return 0;
  
  if(id(str) || id(explode(str, "mit ")) || id(explode(str, "auf ")))
    return Enter();
  
  return 0;
}

nosave int cmd_betreten(string str)
{
  notify_fail(BS("Was wollt Ihr betreten?"));
  if(!str) return 0;
  
  if(id(str))
    return Enter();
  
  return 0;
}

nosave int cmd_verlassen(string str)
{
  notify_fail(BS("Was wollt Ihr verlassen?"));
  if(!str) return 0;
  
  if(id(str))
    return Leave();

  return 0;
}

void init()
{
  ::init();
  
  if(interactive(TP))
    {
      catch(call_other(LANDEPLATZ_1, "???"));
      catch(call_other(LANDEPLATZ_2, "???"));
    }
}

varargs string GetExits(object viewer)
{
  if(QueryArrived())
    return "Ihr koennt das Boot verlassen.\n";
  
  return "";
}
