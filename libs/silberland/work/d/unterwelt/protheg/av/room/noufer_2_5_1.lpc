#pragma strong_types

#include "../def.h"
 
inherit ROOM "nordufer";

// ---------- Funktionen
void create()
{
  ::create();
  
  SetAVStandards();
  
  AddDetail(({"wand","waende","hoehlenwaende","hoehlenwand"}),
    "Die Hoehlenwand ragt direkt neben Euch auf. An dieser Stelle ist es "
    "unmoeglich, an ihr hinauf zu klettern. Einige Skelette liegen da "
    "herum.");
  
  AddDetail(({"skelett","skelette"}),
    "Vermutlich sind sie oben ausgerutscht und konnten sich nicht mehr "
    "retten. Nun rotten sie hier herum. Ihre Ausruestung wurde schon laengst "
    "entfernt.");
  
  AddDetail(({"ausruestung"}),
    "Die ist schon laengst weg.");
  
  set_exits( "noufer", ({ "suedwesten" }), 1);
  
  AddItem(({NPC "schlange",NPC "krabbe"}), REFRESH_DESTRUCT);
}

string int_long( mixed viewer, mixed viewpoint, int shortflag)
{
  if(TP->QueryProp(P_RACE) == "Dunkelelf")
    SetProp(P_INT_LONG,
	    "An der Hoehlenwand liegen einige Skelette, ansonsten wirkt das "
	    "Ufer verlassen.");
  else
    SetProp(P_INT_LONG,
	    "Das Seeufer wirkt leer.");

  return ::int_long( viewer, viewpoint, shortflag);
}

