/*
**  Weg am See bei ArdulVhier
**
**  Tyron, 7.6.2003
**
*/

#pragma strong_types

#include "../def.h"

inherit ROOM "std_av";

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Am Nordostufer des ArdulVhier-Sees");
  SetProp(P_INT_LONG,  "");  // Wird in int_long() gesetzt...
  
  AddDetail_DSpc(({"boden","ufer","seeufer","nordostufer"}),
    ("Das Seeufer ist breit genug, um bequem darauf gehen zu koennen."),
    ("Das Ufer ist breit genug, um bequem darauf gehen zu koennen."));

  AddDetail_DSpc(({"see","ardulvhier-see","rand","wasserflaeche"}),
    ("Ihr steht direkt am Rand einer grossen Wasserflaeche."),
    ("Ihr steht direkt am Rand des ArdulVhier-Sees."));

  AddDetail(({"felsen"}),
    "Der Felsen der Hoehlenwand wirkt bedrohlich nahe...");

  AddDetail_DSpc(({"hoehle"}),
    ("Ihr muesst in einer wirklich grossen Hoehle stehen, auch wenn Ihr Nichts"
     " erkennen koennt."),
    ("Ihr steht in einer wundervollen, grossen Hoehle."));

  AddDetail_DSpc(({"decke"}),
    ("Eine Decke koennt Ihr nicht erkennen."),
    ("Die ist so hoch ueber Euch, dass selbst Ihr sie nicht erkennen koennt."));
  
  AddDetail(({"wand","waende","hoehlenwaende","hoehlenwand"}),
    "Die Hoehlenwand ragt direkt neben Euch auf. An dieser Stelle ist es "
    "unmoeglich, an ihr hinauf zu klettern.");

  AddSound_DSpc(DEFAULT_SOUND,
    ("Irgendwo aus der Dunkelheit um Euch herum hoert Ihr Wasser tropfen."),
    ("Ihr hoert, wie Wasser von der Decke in den See tropft."));

  AddSound_DSpc(({"wasser","tropfen","wassertropfen"}),
    ("Ihr hoert ein unregelmaessiges Tropfen. Es klingt als wuerden "
     "Wassertropfen auf eine grosse Wasserflaeche fallen."),
    ("Ihr hoert das klingende 'pling, pling', mit dem einzelne "
     "Wassertropfen in den See fallen, das 'Lied von ArdulVhier'."));

  AddSound_DSpc(({"lied","melodie","ardulvhier","see"}),
    ("Ihr lauscht, hoert aber Nichts."),
    ("\nIhr lauscht der zarten Melodie der Wassertropfen. Mit Bedauern"
     " denkt Ihr daran, dass Ihr jetzt nicht am 'Stein des Liedes' seid. An"
     " diesem Platz soll man das Lied des Sees besonders gut hoeren"
     " koennen."));
  
  AddSound(({"geraeusche","hall"}),
    "Alle Geraeusche hallen hoerbar nach, wie in einer grossen Halle oder"
    " Kirche.");
}

