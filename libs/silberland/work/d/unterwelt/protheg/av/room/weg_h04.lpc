/*
**  weg_h04.c  Weg von der Oberflaeche zur Dunkelelfenstadt ArdulVhier
**
**  Tyron, 24.5.2003
**
*/

#pragma strong_types

#include "../def.h"

inherit ROOM "std_av";
 
void create()
{
  ::create();
 
  SetProp(P_INT_SHORT, "Ein Sims in einer grossen Hoehle");
  SetProp(P_INT_LONG,  "");  // Wird in int_long() gesetzt...
  
  //  Lichtlevel und Terrain 
  SetAVStandards(); 
  
  AddDetail_DSpc(({"hoehle"}),
    ("Ihr muesst in einer wirklich grossen Hoehle stehen, auch wenn Ihr nichts"
     " erkennen koennt."),
    ("Ihr steht in einer wundervollen, grossen Hoehle."));

  AddDetail_DSpc(({"decke"}),
    ("Eine Decke seht Ihr nicht."),
    ("Die ist ein gutes Stueck ueber Euch und sieht sehr solide aus."));

  AddDetail(({"boden"}),
    "Der Boden besteht aus Fels und sieht ziemlich fest aus.");

  AddDetail_DSpc(({"sims"}),
    ("Der Sims, auf dem der Weg verlaeuft, ist wirklich schmal. Ein falscher"
     " Schritt, und Ihr stuerzt ab. Und die Ungewissheit, was sich in der"
     " Dunkelheit um Euch herum verbergen mag, macht Euch nicht gerade"
     " sicherer..."),
    ("Der Sims, auf dem der Weg verlaeuft, ist wirklich schmal. Ein falscher"
     " Schritt, und Ihr stuerzt ab."));

  AddDetail(({"schritt"}),
     "Ein falscher Schritt, und Ihr stuerzt ab.");

  AddDetail_DSpc(({"dunkelheit"}),
    ("Eure Augen koennen die Dunkelheit hier nicht durchdringen. Ihr"
     " koennt nur erahnen, wie gross die Hoehle ist, und was sich alles darin"
     " verstecken mag."),
    ("Die Hoehle ist in eine angenehme Dunkelheit gehuellt."));

  AddDetail(({"augen"}),
    "Ja, Eure!");

  AddDetail(({"licht"}),
    "Licht gibt es hier unten keins.");

  AddDetail_DSpc(({"seite","seiten"}),
    ("Auf der einen Seite Eures schmalen Pfades seht Ihr eine Felswand, auf"
     " der anderen einen dunklen, bodenlosen Abgrund."),
    ("Auf der einen Seite Eures schmalen Pfades seht Ihr die Felswand, auf"
     " der anderen, weit unter Euch, die schimmernde Oberflaeche des"
     " dunklen Sees."));

  AddDetail_DSpc(({"pfad","weg"}),
    ("Der Pfad ist schmal und fuehrt an einem tiefen Abgrund entlang. Euch"
     " ist gar nicht wohl zu Mute. Vielleicht solltet Ihr lieber umkehren."),
    ("Der Pfad ist schmal und verlaeuft weit oben an der Hoehlenwand. Euch"
     " ist ein bisschen mulmig zu Mute, so offen muss es wohl an 'der"
     " Oberflaeche' sein..."));

  AddDetail(({"fels","felsen","gestein","wand","felswand","felswaende",
		  "hoehlenwand","hoehlenwaende","waende"}),
    "Der Felsen besteht wohl aus Kalkstein und ist ziemlich rauh.");

  AddDetail(({"kalkstein"}),
    "Ein recht weiches Gestein, in dem sich haeufig Hoehlen bilden.");

  AddDetail_DSpc(({"abgrund","tiefe"}),
    ("Direkt neben Euch tut sich ein Abgrund auf. Ihr habt keine Ahnung, wie"
     " tief es nach unten geht, aber den Geraeuschen nach zu urteilen _sehr_"
     " weit. Wenn jetzt der Sims unter Euch wegbricht und Ihr hinunter"
     " stuerzt..."),
    ("Ihr steht hoch oben in der Hoehle, der See liegt ziemlich tief unter"
     " Euch. Ihr haelt lieber Abstand."));

  AddDetail_DSpc(({"abstand"}),
    ("So etwas seht Ihr hier nicht."),
    ("Je groesser, desto besser."));

  AddDetail(({"geraeusch","geraeusche"}),
    "Seit wann koennt Ihr Geraeusche sehen?");

  AddDetail_DSpc(({"see","ardulvhier-see","oberflaeche"}),
    ("Dem Tropfen nach zu urteilen muss in der Tiefe ein unterirdischer See"
     " liegen."),
    ("Tief unter Euch schimmert dunkel die Oberflaeche des"
     " ArdulVhier-Sees."));

  AddDetail_DSpc(({"stadt","ardulvhier"}),
    ("So etwas seht Ihr hier nicht."),
    ("Man sieht die Stadt von hier aus nicht. Aber Ihr wisst, dass sie hier"
     " in der Naehe liegt und die praechtigste und schoenste Stadt der Welt"
     " ist."));

  AddSound_DSpc(DEFAULT_SOUND,
    ("Irgendwo aus der Dunkelheit unter Euch hoert Ihr Wasser tropfen."),
    ("Ihr hoert, wie Wasser von der Decke in den See tropft."));

  AddSound_DSpc(({"wasser","tropfen","wassertropfen"}),
    ("Von sehr weit unten hoert Ihr ein unregelmaessiges Tropfen. Es klingt,"
     " als wuerden Wassertropfen auf eine grosse Wasserflaeche fallen."),
    ("Ihr hoert das klingende 'pling, pling', mit dem einzelne"
     " Wassertropfen in den See fallen, das 'Lied von ArdulVhier'."));
  
  AddSound_DSpc(({"lied","melodie","ardulvhier","see","wasserflaeche"}),
    ("Ihr lauscht, hoert aber Nichts."),
    ("\nIhr lauscht der zarten Melodie der Wassertropfen. Mit Bedauern"
     " denkt Ihr daran, dass Ihr jetzt nicht am 'Stein des Liedes' seid. An"
     " diesem Platz soll man das Lied des Sees besonders gut hoeren"
     " koennen."));

  AddSound(({"geraeusche","hall"}),
    "Alle Geraeusche hallen hoerbar nach, wie in einer grossen Halle oder"
    " Kirche.");

  AddExit("suedwestunten", ROOM "weg_h05");
  AddExit("nordoben",      ROOM "weg_h03");
}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  if(objectp(viewer) && IS_DROW(viewer))
    SetProp(P_INT_LONG,
	    BS("Ihr steht auf einem schmalen Sims hoch oben in einer "
	       "gewaltigen Hoehle. Auf der einen Seite Eures schmalen "
	       "Pfades seht Ihr die Felswand, auf der anderen, weit unter "
	       "Euch, die schimmernde Oberflaeche des dunklen Sees, an dem "
	       "das praechtige ArdulVhier liegt."));
  else
    SetProp(P_INT_LONG,
	    BS("Ihr steht auf einem schmalen Sims inmitten undurchdringlicher "
	       "Dunkelheit. Auf der einen Seite Eures schmalen Pfades seht "
	       "Ihr eine Felswand, auf der anderen erahnt Ihr einen dunklen, "
	       "bodenlosen Abgrund. Ihr koennt nicht weit sehen, aber an den "
	       "hallenden Geraeuschen erahnen, dass Ihr Euch in einer grossen "
	       "Hoehle befinden muesst."));
  
  return ::int_long(viewer, viewpoint, shortflag);
}
