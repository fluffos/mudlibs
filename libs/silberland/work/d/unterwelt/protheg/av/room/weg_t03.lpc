/*
**  weg_t03.c  Weg von der Oberflaeche zur Dunkelelfenstadt ArdulVhier
**
**  Tyron, 24.5.2003
**
*/

#pragma strong_types

#include "../def.h"
 
inherit ROOM "std_av";
 
void create()
{
  ::create();

  //  Lichtlevel und Terrain
  SetAVStandards();
 
  SetProp(P_INT_SHORT, "Ein steiler Tunnel");
  SetProp(P_INT_LONG,  "");  // Wird in int_long() gesetzt...
 
  AddDetail(({"tunnel"}),
    "Ein steiler, enger Tunnel. Besonders wohl fuehlst Du Dich hier nicht.");

  AddDetail(({"unterwelt"}),
    "Das finstere Reich in den Tiefen des Silberlands.");

  AddDetail(({"tiefe","tiefen","reich"}),
    "Dort scheint dieser Gang hinzufuehren.");

  AddDetail(({"silberland"}),
    "Silbern ist hier gar nichts....");

  AddDetail_DSpc(({"westen"}),
    ("Tiefste Dunkelheit!"),
    ("Ein Stueck den Gang hinauf kommt schliesslich ein Knick. Was"
     " dahinter liegt, kannst Du leider nicht sehen."));

  AddDetail_DSpc(({"osten"}),
    ("Tiefste Dunkelheit!"),
    ("Ein weites Stueck den Gang hinauf kommt schliesslich ein Knick. Was"
     " dahinter liegt, kannst Du leider nicht sehen."));

  AddDetail_DSpc(({"knick","knicke"}),
    ("Knick? Was fuer ein Knick? Du siehst keinen."),
    ("Sowohl im Westen als auch Im Osten knickt der Gang schliesslich"
     " scharf ab."));

  AddDetail_DSpc(({"stueck"}),
    ("Wie, Stueck??"),
    ("Ein Stueck den Gang entlang kommen schliesslich scharfe Knicke."));

  AddDetail(({"fels","felsen","gestein","wand","waende","decke","boden"}),
    "Der Felsen besteht wohl aus Sandstein und ist ziemlich rauh.");

  AddDetail(({"sandstein"}),
    "Der Sandstein, wie man ihn in der Wueste findet.");

  AddDetail(({"wueste"}),
    "Die liegt irgendwo ueber Dir.");

  AddDetail(({"hoehle","hoehlen"}),
    "Hoehlen siehst Du hier keine.");

  AddDetail_DSpc(({"dunkelheit","finsternis"}),
    ("Diese Finsternis geht Dir allmaehlich auf die Nerven. Du siehst fast"
     " nichts, nur wenige Schritte von Dir entfernt koennten sich die"
     " schlimmsten Monster verbergen."),
    ("Eine angenehme Dunkelheit umgibt Dich."));

  AddDetail_DSpc(({"platz","plaetze"}),
    ("Dies ist kein Platz fuer Dich."),
    ("Der Tunnel ist nicht besonders angenehm. Du kennst schoenere Plaetze"
     " in der Unterwelt."));

  AddDetail_DSpc(({"gang"}),
    ("Als Du Dir die Wand einmal genauer ansiehst, erkennst Du, dass der"
     " Gang kuenstlich angelegt wurde."),
    ("Dieser Gang wurde kuenstlich in den Felsen geschlagen."));

  AddDetail_DSpc(({"monster","alptraum","alptraeume"}),
    ("Monster, wie Du sie Dir in Deinen schlimmsten Alptraeumen nicht"
     " vorstellen kannst."),
    ("Ja, in der Unterwelt gibt es auch Monster, die einem Alptraeume"
     " bereiten koennen. Aber wie kommst Du jetzt darauf?"));

  AddDetail_DSpc(({"ahnung","nerven"}),
    ("Du hast keine Ahnung, was Dich auf den naechsten Metern erwartet."),
    ("Du hast keine Ahnung, was Dich in diesem Tunnel alles erwartet. Aber"
     " Du weisst, dass die Unterwelt gefaehrlich sein kann."));
  
  AddExit("ostunten", ROOM "weg_t04");
  AddExit("westoben", ROOM "weg_t02");
  
  AddItem(NPC "krznar", REFRESH_DESTRUCT);
}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  if(objectp(viewer) && IS_DROW(viewer))
    SetProp(P_INT_LONG,
	    BS("Dies ist einer der vielen Tunnel der Unterwelt. Er verlaeuft "
	       "von Osten nach Westen und steigt dabei nach Westen hin steil "
	       "an. So geradlinig, wie er sich durch das Gestein zieht, bist "
	       "Du Dir ziemlich sicher, dass dies kein natuerlicher Gang ist."
	       " Ziemlich weit im Osten und ein Stueck weiter im Westen "
	       "verschwindet er jeweils hinter scharfen Knicken."));
  else
    SetProp(P_INT_LONG,
	    BS("Dies ist einer der vielen Tunnel, die sich scheinbar endlos "
	       "durch die Finsternis der Unterwelt ziehen. Er verlaeuft von "
	       "Osten nach Westen und steigt dabei nach Westen hin steil an. "
	       "Du hast keine Ahnung, was Dich auf den naechsten Metern "
	       "erwartet. Schon nach kurzer Zeit verschwindet der Gang in "
	       "tiefer Finsternis. Irgendwie fuehlst Du Dich hier fehl am "
	       "Platz."));
  
  return ::int_long(viewer, viewpoint, shortflag);
}
