/*
**  weg_t08.c  Weg von der Oberflaeche zur Dunkelelfenstadt ArdulVhier
**             Das untere Ende des Tunnels
**
**  Tyron, 24.5.2003
**
*/

#pragma strong_types
 
#include "../def.h"
 
inherit ROOM "std_av";

void create()
{
  ::create();

  //  Lichtlevel und Terrain
  SetAVStandards();
 
  SetProp(P_INT_SHORT, "Das untere Ende eines steilen Tunnels");
  SetProp(P_INT_LONG,  "");  // Wird in int_long() gesetzt...

  AddDetail_D_ZSpc(({"tunnel","sueden"}),
    ("Tiefste Dunkelheit!"),
    ("Im Sueden endet der Gang in einer grossen Hoehle."),
    ("Rund um Dich herum herrscht tiefste Dunkelheit. Aber Dein Gefuehl sagt"
     " Dir, dass der Gang im Sueden in eine gewaltige Hoehle fuehrt."));

  AddDetail_D_ZSpc(({"gefuehl"}),
    ("Du fuehlst Dich hier sehr unwohl."),
    ("Im fuehlst Dich in dem engen Gang nicht wirklich wohl."),
    ("Die Luft riecht im Sueden etwas anders als im Norden, die Echos der von"
     " Dir verursachten Geraeusche klingen etwas anders... Du kannst nicht"
     " wirklich sagen, was anders ist. Es ist halt so ein Gefuehl..."));

  AddDetail_D_ZSpc(({"hoehle","hoehlen"}),
    ("Hoehle? Was fuer eine Hoehle? Du siehst keine."),
    ("Eine gewaltige Hoehle, so viel kannst Du von hier aus erkennen."),
    ("Du hast keine Ahnung, wie sie aussieht, und kannst auch nichts erkennen."
     " Es ist nur so ein Gefuehl, das Dir sagt, das dort eine grosse"
     " Hoehle liegt."));

  AddDetail_D_ZSpc(({"luft"}),
    ("Die Luft ist feucht und klamm. Dich froestelt."),
    ("Die Luft ist gut. Du kannst unbesorgt atmen."),
    ("Du glaubst, dass die Luft aus dem Sueden etwas weniger stickig als die"
     " aus Norden ist. Das spricht fuer eine groessere Hoehle im Sueden."));

  AddDetail_D_ZSpc(({"echo","echos","geraeusch","geraeusche","hall"}),
    ("Du hoerst nichts ausser den Geraeuschen, die Du selbst verurachst."),
    ("Du hoerst nichts ausser den Geraeuschen, die Du selbst verurachst."),
    ("Du glaubst aus dem Sueden mehr Hall in den Echos Deiner Geraeusche"
     " zu hoeren, wie aus einer grossen Hoehle."));

  AddDetail_DSpc(({"norden"}),
    ("Tiefste Dunkelheit!"),
    ("Ein Stueck den Gang hinauf kommt schliesslich ein Knick. Was"
     " dahinter liegt, kannst Du leider nicht sehen."));

  AddDetail(({"unterwelt"}),
    "Das finstere Reich in den Tiefen des Silberlands.");

  AddDetail(({"tiefe","tiefen","reich"}),
    "Dort scheint dieser Gang hinzufuehren.");

  AddDetail(({"silberland"}),
    "Silbern ist hier gar nichts....");

  AddDetail(({"fels","felsen","gestein","wand","waende","decke","boden"}),
    "Der Felsen besteht wohl aus Kalkstein und ist ziemlich rauh.");

  AddDetail(({"kalkstein"}),
    "Ein recht weiches Gestein, in dem sich haeufig Hoehlen bilden.");

  AddDetail_DSpc(({"dunkelheit","finsternis","schritt","schritte"}),
    ("Diese unendliche Finsternis geht Dir allmaehlich auf die Nerven. Du"
     " siehst fast nichts, nur wenige Schritte von Dir entfernt koennten"
     " sich die schlimmsten Monster verbergen."),
    ("Eine angenehme Dunkelheit umgibt Dich."));
  
  AddDetail_DSpc(({"platz","plaetze"}),
    ("Dies ist kein Platz fuer Dich."),
    ("Der Tunnel ist nicht besonders angenehm. Du kennst schoenere Plaetze"
     " in der Unterwelt."));

  AddDetail_DSpc(({"gang"}),
    ("Als Du Dir die Wand einmal genauer ansiehst, erkennst Du, dass der"
     " Gang kuenstlich angelegt wurde."),
    ("Dieser Gang wurde kuenstlich in den Felsen geschlagen."));

  AddDetail_DSpc(({"monster","alptraum","alptraeume"}),
    ("Monster, wie Du sie Dir in Deinen schlimmsten Alptraeumen nicht"
     " vorstellen kannst."),
    ("Ja, in der Unterwelt gibt es auch Monster, die einem Alptraeume"
     " bereiten koennen. Aber wie kommst Du jetzt darauf?"));

  AddDetail_DSpc(({"ahnung","nerven"}),
    ("Du hast keine Ahnung, was Dich auf den naechsten Metern erwartet."),
    ("Du hast keine Ahnung, was Dich in diesem Tunnel alles erwartet. Aber"
     " Du weisst, dass die Unterwelt gefaehrlich sein kann."));
 
  AddExit("suedunten", ROOM "weg_h01");
  AddExit("nordoben",  ROOM "weg_t07");
}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  if(objectp(viewer) && IS_DROW(viewer))
    SetProp(P_INT_LONG,
	    BS("Du stehst am unteren Ende eines Tunnels, der nach Norden hin "
	       "steil ansteigt. Im Sueden fuehrt er in eine gewaltige Hoehle."
	       " So geradlinig, wie er sich durch das Gestein zieht, bist Du "
	       "Dir ziemlich sicher, dass dies kein natuerlicher Gang ist."));
  else 
    if(objectp(viewer) && IS_DWARF(viewer))
      SetProp(P_INT_LONG,
	      BS("Du stehst in einem Tunnel, der sich scheinbar endlos durch "
		 "die Finsternis der Unterwelt zieht. Er verlaeuft von Sueden "
		 "nach Norden und steigt dabei nach Norden hin steil an. Du "
		 "hast keine Ahnung, was Dich auf den naechsten Metern "
		 "erwartet. aber irgendwie hast Du das Gefuehl, dass sich der "
		 "Tunnel im Sueden zu einer gewaltigen Hoehle weitet."));
    else
      SetProp(P_INT_LONG,
	      BS("Du stehst in einem Tunnel, der sich scheinbar endlos durch "
		 "die Finsternis der Unterwelt zieht. Er verlaeuft von Sueden "
		 "nach Norden und steigt dabei nach Norden hin steil an. Du "
		 "hast keine Ahnung, was Dich auf den naechsten Metern "
		 "erwartet. Schon nach kurzer Zeit verschwindet der Gang in "
		 "tiefer Finsternis. Irgendwie fuehlst Du Dich hier fehl "
		 "am Platz."));
  
  return ::int_long(viewer, viewpoint, shortflag);
}
