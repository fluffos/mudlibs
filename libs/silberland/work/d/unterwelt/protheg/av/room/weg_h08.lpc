/*
**  weg_h08.c  Weg von der Oberflaeche zur Dunkelelfenstadt ArdulVhier
**
**  Tyron, 24.5.2003
**
*/

#pragma strong_types

#include "../def.h"

inherit ROOM "std_av";
 
void create()
{
  ::create();
 
  SetProp(P_INT_SHORT, "Ein Sims in einer grossen Hoehle");
  SetProp(P_INT_LONG,  "");  // Wird in int_long() gesetzt...
  
  //  Lichtlevel und Terrain 
  SetAVStandards(); 
  
  AddDetail_DSpc(({"hoehle"}),
    ("Ihr meusst in einer wirklich grossen Hoehle stehen, auch wenn Ihr "
     "Nichts erkennen koennt."),
    ("Ihr steht in einer wundervollen, grossen Hoehle."));

  AddDetail_DSpc(({"decke"}),
    ("Eine Decke seht Ihr nicht."),
    ("Die ist weit ueber Euch, Ihr koennt sie kaum erkennen."));

  AddDetail(({"boden"}),
    "Der Boden besteht aus Fels und sieht ziemlich fest aus.");

  AddDetail_DSpc(({"sims"}),
    ("Der Sims, auf dem der Weg verlaeuft, ist wirklich schmal. Ein falscher"
     " Schritt, und Ihr stuerzt ab. Und die Ungewissheit, was sich in dem"
     " dunklen Wasser unter Euch verbergen mag, macht Euch nicht gerade"
     " sicherer..."),
    ("Der Sims, auf dem der Weg verlaeuft, ist ziemlich schmal. Ein falscher"
     " Schritt, und Ihr nehmt ein unfreiwilliges Bad."));

  AddDetail(({"schritt","bad"}),
     "Ein falscher Schritt, und Ihr nehmt ein unfreiwilliges Bad.");

  AddDetail_DSpc(({"dunkelheit"}),
    ("Eure Augen koennen die Dunkelheit hier nicht durchdringen. Ihr"
     " koennt nur erahnen, wie gross die Hoehle ist, und was sich alles darin"
     " verstecken mag."),
    ("Die Hoehle ist in eine angenehme Dunkelheit gehuellt."));
  
  AddDetail(({"augen"}),
    "Ja, Eure!");
  
  AddDetail(({"licht"}),
    "Licht gibt es hier unten keins.");

  AddDetail_DSpc(({"seite", "seiten"}),
    ("Auf der einen Seite Deines schmalen Pfades seht Ihr eine Felswand, auf"
     " der anderen eine dunkle Wasserflaeche."),
    ("Auf der einen Seite Deines schmalen Pfades seht Ihr die Felswand, auf"
     " der anderen, ein Stueckchen unter Euch, die schimmernde Oberflaeche "
     "des dunklen Sees."));

  AddDetail_DSpc(({"pfad", "weg"}),
    ("Der Pfad ist schmal und beginnt im Nordosten anzusteigen. Er fuehrt an"
     " einem dunklen See entlang."),
    ("Der Pfad beginnt im Nordosten anzusteigen. Er verlaeuft ein Stueckchen"
     " oberhalb des Sees in der Hoehlenwand."));

  AddDetail_DSpc(({"stadttor", "bruecke", "suedwesten","felsenbogen"}),
    ("Weiter im Suedwesten seht Ihr so etwas wie eine Bruecke."),
    ("Im Suedwesten beginnt eine schmale Bruecke, die zum Stadttor von"
     " ArdulVhier fuehrt."));

  AddDetail(({"nordosten"}),
    "Der Pfad beginnt im Nordosten, recht schnell anzusteigen und an der"
    " Hoehlenwand entlang aufwaerts zu fuehren.");

  AddDetail(({"fels", "felsen", "gestein", "wand", "felswand", "felswaende",
		  "hoehlenwand", "hoehlenwaende", "waende"}),
    "Der Felsen besteht wohl aus Kalkstein und ist ziemlich rauh.");

  AddDetail(({"kalkstein"}),
    "Ein recht weiches Gestein, in dem sich haeufig Hoehlen bilden.");

  AddDetail(({"geraeusch", "geraeusche"}),
    "Seit wann koennt Ihr Geraeusche sehen?");

  AddDetail_DSpc(({"wasser", "see", "ardulvhier-see", "oberflaeche",
		       "wasserflaeche"}),
    ("Ihr glaubt unter Euch eine Wasserflaeche, vielleicht einen "
     "unterirdischen See erkennen zu koennen."),
    ("Unter Euch schimmert dunkel die Oberflaeche des ArdulVhier-Sees."));

  AddDetail_DSpc(({"ufer"}),
    ("Auch unterirdische Seen haben Ufer."),
    ("Das Ufer liegt direkt vor Euch."));

  AddDetail_DSpc(({"stadt", "ardulvhier"}),
    ("So etwas seht Ihr hier nicht."),
    ("Man sieht die Stadt von hier aus nicht. Aber Ihr wisst, dass sie hier"
     " in der Naehe liegt und die praechtigste und schoenste Stadt der Welt"
     " ist."));

  AddSound_DSpc(DEFAULT_SOUND,
    ("Irgendwo aus der Dunkelheit hoert Ihr Wasser tropfen."),
    ("Ihr hoert, wie Wasser von der Decke in den See tropft."));

  AddSound_DSpc(({"wasser", "tropfen", "wassertropfen"}),
    ("Ihr hoert ein unregelmaessiges Tropfen. Es klingt, als wuerden"
     " Wassertropfen auf eine grosse Wasserflaeche fallen."),
    ("Ihr hoert das klingende 'pling, pling', mit dem einzelne"
     " Wassertropfen in den See fallen, das 'Lied von ArdulVhier'."));

  AddSound_DSpc(({"lied", "melodie", "ardulvhier", "see"}),
    ("Ihr lauscht, hoert aber Nichts."),
    ("\nIhr lauscht der zarten Melodie der Wassertropfen. Mit Bedauern"
     " denkt Ihr daran, dass Ihr jetzt nicht am 'Stein des Liedes' seid. An"
     " diesem Platz soll man das Lied des Sees besonders gut hoeren"
     " koennen."));

  AddSound(({"geraeusche", "hall"}),
    "Alle Geraeusche hallen hoerbar nach, wie in einer grossen Halle oder"
    " Kirche.");

  AddExit("nordostoben", ROOM "weg_h07");
  AddExit("suedwesten",  ROOM "weg_h09");
}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  if(objectp(viewer) && IS_DROW(viewer))
    SetProp(P_INT_LONG,
	    BS("Ihr steht auf einem schmalen Weg, der am Ufer des "
	       "ArdulVhier-Sees entlang fuehrt und im Nordosten zu steigen "
	       "beginnt. Auf der einen Seite seht Ihr die Hoehlenwand, auf "
	       "der anderen, ein Stueckchen unter Euch, die schimmernde "
	       "Oberflaeche eines dunklen Sees, an dessen anderem Ufer das "
	       "praechtige ArdulVhier liegt. Direkt suedwestlich von Euch "
	       "beginnt eine grazile Bruecke, die zum Stadttor auf der "
	       "anderen Seite des hier sehr schmalen Sees fuehrt."));
  else
    SetProp(P_INT_LONG,
	    BS("Ihr steht auf einem schmalen Sims inmitten einer dunklen "
	       "Hoehle. Auf der einen Seite Eures schmalen Pfades seht "
	       "Ihr eine Felswand, auf der anderen glaubt Ihr Wasser zu "
	       "erkennen. Ihr koennt nicht weit sehen, aber an den "
	       "hallenden Geraeuschen erahnen, dass Ihr Euch in einer "
	       "grossen Hoehle befinden muesst. Ein Stueck weiter "
	       "suedwestlich beginnt so etwas wie eine Bruecke, ein "
	       "Felsenbogen, der auf das Wasser hinaus fuehrt."));
  
  return ::int_long(viewer, viewpoint, shortflag);
}

void init()
{
  ::init();
  
  if(interactive(TP))
    catch(call_other(ROOM "boot", "???"));
  
}
