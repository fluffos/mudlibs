#pragma strong_types

#include "../def.h"
 
inherit ROOM "nordufer";

// ---------- Funktionen
void create()
{
  ::create();
 
  SetAVStandards();

  AddDetail( ({ "wand", "hoehlenwand" }),
    "Sie ragt direkt neben dir auf. An dieser Stelle koennte man wohl an ihr"
    " hoch klettern." );
  
  AddCmd(({"kletter", "klettere"}), "cmd_klettern");
  AddCmd(({"flatter","flattere","flieg","fliege"}), "cmd_fliegen");
  
  set_exits( "noufer");
}

string int_long( mixed viewer, mixed viewpoint, int shortflag)
{
  if(TP->QueryProp(P_RACE) == "Dunkelelf")
    SetProp(P_INT_LONG,
	    "Das Seeufer knickt hier scharf ab. Die Hoehlenwand sieht aus, "
	    "als ob man hier an ihr hinauf klettern koennte.");
  else
    SetProp(P_INT_LONG,
	    "Das Seeufer knickt hier scharf ab. Die Hoehlenwand sieht aus, "
	    "als ob man hier an ihr hinauf klettern koennte.");
  
  return ::int_long(viewer, viewpoint, shortflag);
}

nosave int cmd_fliegen(string str)
{
  if(!str) return 0;
  
  if(str=="rauf"||str=="hinauf"||str=="hoch"||str=="nach oben")
    return write(BS("Irgendeine Macht haelt Euch fest! Ihr muesst wohl "
		    "hinaufklettern!")), 1;
  
  return 0;
}

nosave int cmd_klettern(string str)
{
  notify_fail( "Wohin moechtet Ihr klettern?\n");
  if(!str) return 0;
  
  if(str=="rauf"||str=="hinauf"||str=="hoch"||str=="nach oben")
  {
    write(BS("Muehsam versucht Ihr an der Hoehlenwand hinaufzuklettern..."));

    if(!TP->do_exhaust(100, 1))
      return write(BS("In halber Hoehe verlassen Euch die Kraefte und Ihr "
		      "stuerzt zurueck zurueck auf den Boden.")), 1;

    write(BS("Und tatsaechlich, nach vieler Muehe erreicht Ihr einen "
	     " Sims in der Hoehlenwand."));

    say(BS(TPN+" klettert die Wand hinauf."));

    TP->move(ROOM "weg_h02", M_GO | M_SILENT);

    return 1;
  }
  return 0;
}
