/*
**  weg_h03.c  Weg von der Oberflaeche zur Dunkelelfenstadt ArdulVhier
**
**  Tyron, 24.5.2003
**
*/

#pragma strong_types

#include "../def.h"

inherit ROOM "std_av";

nosave string *gebetet;
 
void create()
{
  ::create();
  
  gebetet=({});
  
  SetProp(P_INT_SHORT, "Ein Sims in einer grossen Hoehle");
  SetProp(P_INT_LONG,  "");  // Wird in int_long() gesetzt...
  
  //  Lichtlevel und Terrain 
  SetAVStandards(); 
  
  AddDetail_DSpc(({"hoehle"}),
    ("Ihr muesst in einer wirklich grossen Hoehle stehen, auch wenn Ihr Nichts"
     " erkennen koennt."),
    ("Ihr steht in einer wundervollen, grossen Hoehle."));

  AddDetail_DSpc(({"decke"}),
    ("Eine Decke seht Ihr nicht."),
    ("Die ist ein gutes Stueck ueber Euch und sieht sehr solide aus."));

  AddDetail(({"boden"}),
    "Der Boden besteht aus Fels und sieht ziemlich fest aus.");

  AddDetail_DSpc(({"sims"}),
    ("Der Sims, auf dem der Weg verlaeuft, verbreitert sich hier etwas."
     " Trotzdem fuehlt Ihr Euch ausgerechnet hier nicht sonderlich wohl. Und"
     " die Ungewissheit, was sich in der Dunkelheit um Euch herum verbergen "
     "mag, macht Euch nicht gerade sicherer..."),
    ("Der Sims, auf dem der Weg verlaeuft, verbreitert sich hier zu einer"
     " Nische. Ihr koennt hier bequem stehen und verweilen."));
  
  AddDetail_DSpc(({"ungewissheit"}),
    ("Vielleicht solltet Ihr doch wieder umkehren..."),
    ("Ihr und Ungewissheit?!"));
  
  AddDetail_DSpc(({"nische","rueckwand"}),
    ("Von der Rueckwand der Nische starrt Euch das Abbild einer mannsgrossen"
     " Spinne an. Ihr spuert regelrecht die Bosheit, die von dem Relief"
     " ausgeht."),
    ("An der Rueckwand der Nische seht Ihr ein Relief, das eine heilige"
     " Spinne zeigt. Ihr koenntet hier beten."));
  
  AddDetail_DSpc(({"bosheit"}),
     ("Ihr schaudert ob dieser Bosheit!"),
     ("Ihr grinst ob dieser Bosheit."));
  
  AddDetail_DSpc(({"abbild","relief","spinne"}),
    ("Das Relief zeigt eine ziemlich grosse, haessliche Spinne."),
    ("Das Relief zeigt eine von Lloths heiligen Spinnen. Ihr steht vor einem"
     " Schrein zu Ehren der Goettin."));

  AddDetail_DSpc(({"schrein"}),
    ("Das koennte ein unheiliger Schrein Lloths sein."),
    ("Dies ist ein Schrein zu Ehren Lloths. Es wuerde Euch bestimmt gut"
     " anstehen, zu beten und Eure Goettin zu ehren."));

  AddDetail_DSpc(({"goettin","llioth"}),
    ("Die boesartige Goettin der Dunkelelfen."),
    ("Die erhabene Lloth, Herrin der Dunkelelfen, Bringerin der"
     " Dunkelheit."));

  AddDetail_DSpc(({"dunkelelf","dunkelelfen"}),
    ("Angeblich soll es hier irgendwo eine Stadt der Dunkelelfen geben."),
    ("Ihr koennt sie von hier aus nicht sehen, aber Ihr wisst, dass es hier"
     " in der Naehe eine praechtige Dunkelelfenstadt gibt."));

  AddDetail_DSpc(({"dunkelheit","gefuehl"}),
    ("Eure Augen koennen die Dunkelheit hier nicht durchdringen. Ihr"
     " habt das mulmige Gefuehl, dass Euch aus dem Schatten der Nische irgend"
     "etwas anstarrt."),
    ("Die Hoehle ist in eine angenehme Dunkelheit gehuellt."));
  
  AddDetail(({"schatten"}),
    "Ihr muesst Euch getaeuscht haben...");
  
  AddDetail(({"augen"}),
    "Ja, Eure!");

  AddDetail(({"licht"}),
    "Licht gibt es hier unten keins.");

  AddDetail_DSpc(({"seite","seiten"}),
    ("Auf der einen Seite des Pfades seht Ihr eine Nische, auf der anderen"
     " einen dunklen, bodenlosen Abgrund."),
    ("Auf der einen Seite des Pfades seht Ihr eine Nische, auf der anderen,"
     " weit unter Euch, die schimmernde Oberflaeche des dunklen Sees."));

  AddDetail_DSpc(({"pfad","weg"}),
    ("Der Pfad fuehrt an einem tiefen Abgrund entlang. Euch ist gar nicht"
     " wohl zu Mute, und das, wo der Sims hier doch etwas breiter ist."
     " Vielleicht solltet Ihr lieber umkehren."),
    ("Der Pfad ist schmal und verlaeuft weit oben an der Hoehlenwand."));
  
  AddDetail_DSpc(({"mut"}),
	 ("Na? Verlaesst Euch der Mut?"),
	 ("Ihr seid doch mutig genug, oder?"));
  
  AddDetail(({"fels","felsen","gestein","wand","felswand","felswaende",
                "hoehlenwand","hoehlenwaende","waende"}),
    "Der Felsen besteht wohl aus Kalkstein und ist ziemlich rauh.");

  AddDetail(({"kalkstein"}),
    "Ein recht weiches Gestein, in dem sich haeufig Hoehlen bilden.");

  AddDetail_DSpc(({"abgrund","tiefe","ahnung"}),
    ("Direkt neben Euch tut sich ein Abgrund auf. Ihr habt keine Ahnung, wie"
     " tief es nach unten geht, aber den Geraeuschen nach zu urteilen _sehr_"
     " weit."),
    ("Ihr steht hoch oben in der Hoehle, der See liegt wirklich tief unter"
     " Euch."));

  AddDetail(({"geraeusch","geraeusche"}),
    "Seit wann koennt Ihr Geraeusche sehen?");

  AddDetail_DSpc(({"see","ardulvhier-see","oberflaeche","seeoberflaeche",
		       "ardulvhiersee","wasserflaeche"}),
    ("Dem Tropfen nach zu urteilen muss in der Tiefe ein unterirdischer See"
     " liegen."),
    ("Tief unter Euch schimmert dunkel die Oberflaeche des"
     " ArdulVhier-Sees."));

  AddDetail_DSpc(({"dunkelelfenstadt","dunkelelfen-stadt","stadt",
                     "ardulvhier"}),
    ("So etwas seht Ihr hier nicht."),
    ("Man sieht die Stadt von hier aus nicht. Aber Ihr wisst, dass sie hier"
     " in der Naehe liegt und die praechtigste und schoenste Stadt der Welt"
     " ist."));

  AddSound_DSpc(DEFAULT_SOUND,
    ("Irgendwo aus der Dunkelheit unter Euch hoert Ihr Wasser tropfen."),
    ("Ihr hoert, wie Wasser von der Decke in den See tropft."));

  AddSound_DSpc(({"wasser","tropfen","wassertropfen"}),
    ("Von sehr weit unten hoert Ihr ein unregelmaessiges Tropfen. Es klingt,"
     " als wuerden Wassertropfen auf eine grosse Wasserflaeche fallen."),
    ("Ihr hoert das klingende 'pling, pling', mit dem einzelne"
     " Wassertropfen in den See fallen, das 'Lied von ArdulVhier'."));

  AddSound_DSpc(({"lied","melodie","ardulvhier","see","nichts"}),
    ("Ihr lauscht, hoert aber Nichts."),
    ("\nIhr lauscht der zarten Melodie der Wassertropfen. Mit Bedauern"
     " denkt Ihr daran, dass Ihr jetzt nicht am 'Stein des Liedes' seid. An"
     " diesem Platz soll man das Lied des Sees besonders gut hoeren"
     " koennen."));

  AddSound(({"geraeusche","hall","kirche"}),
    "Alle Geraeusche hallen hoerbar nach, wie in einer grossen Halle oder"
    " Kirche.");
  
  AddCmd(({"bete"}), "cmd_beten");
  
  AddExit("nordostoben", ROOM "weg_h02");
  AddExit("suedunten",   ROOM "weg_h04");
  
  AddItem(({NPC "bat",NPC "spinne"}), REFRESH_DESTRUCT);
}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  if(objectp(viewer) && !IS_DROW(viewer))
    SetProp(P_INT_LONG,
	    BS("Ihr steht auf einem Sims hoch oben in einer gewaltigen "
	       "Hoehle. Er verbreitert sich hier etwas und bildet eine "
	       "kleine Nische in der Felswand. Auf der anderen Seite des "
	       "Pfades seht Ihr weit weit unter Euch die schimmernde "
	       "Oberflaeche des dunklen Sees, an dem das praechtige "
	       "ArdulVhier liegt."));
  else
    SetProp(P_INT_LONG,
	    BS("Ihr steht auf einem schmalen Sims inmitten undurchdringlicher "
	       "Dunkelheit. Er verbreitert sich hier etwas und bildet eine "
	       "kleine Nische in der Felswand. Auf der anderen Seite des "
	       "schmalen Pfades erahnt Ihr einen dunklen, bodenlosen Abgrund. "
	       "Ihr koennt nicht weit sehen, aber an den hallenden Geraeuschen "
	       "erahnen, dass Ihr Euch in einer grossen Hoehle befinden muesst."));
  
  return ::int_long(viewer, viewpoint, shortflag);
}

public int QueryGebetet(object pl)
{
  if(member(gebetet, getuid(pl))==-1) 
    return 0;
  
  return 1;
}

nosave int cmd_beten(string str)
{
  notify_fail(BS("Zu wem wollt Ihr beten?"));
  if(!str)
    if(TP->QueryProp(P_RACE)!="Dunkelelf")
      return write(BS("Ihr kniet nieder und haelt eine kurze Andacht.")), 1;
    else
      return 0;
  
  if(member(({"zu lloth","zu goettin","zu goettin lloth","zur goettin",
		  "zur goettin lloth","zu spinnengoettin",
		  "zu spinnengoettin lloth","zur spinnengoettin",
		  "zur spinnengoettin lloth","an lloth", "an die goettin",
		  "an die spinnengoettin","an die goettin lloth",
		  "an die spinnengoettin lloth"}), str)==-1)
    return 0;
  
  if(QueryGebetet(TP))
    return write(BS("Ihr habt hier bereits vor kurzem gebetet.")), 1;
  
  write(BS("Ihr verbeugt Euch vor dem Schrein und haelt ein kurzes Gebet "
	   "an die Spinnengoettin Lloth.")+
	BS("Ihr habt nun das Gefuehl, dass Euer Weg nun etwas sicherer "
	   "sein wird."));
  
  gebetet+=({getuid(TP)});

  return 1;
}

void reset()
{
  ::reset();
  
  if(!random(2))
    gebetet=({});
}
