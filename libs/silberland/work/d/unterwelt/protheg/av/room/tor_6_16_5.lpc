#pragma strong_types                                                              

#include <properties.h>
#include <language.h>
 
#include "../def.h"
#include "../func.h"
 
inherit STD "std_room";
inherit STD "std_av";
 
 
// ---------- Funktionen
void create()
{
  ::create();
  SetAVStandards();
 
  SetProp( P_INT_SHORT, "Durchgang zum Nordosttor von ArdulVhier" );
  SetProp( P_INT_LONG,
    "Ein breiter Tunnel in der nordoestlichen Abschlusswand von ArdulVhier."
    " Er fuehrt von der Stadt zum nordoestlichen Stadttor. Direkt"
    " nordoestlich von Dir sieht Du ein Fallgitter, mit dem sich der Torweg"
    " sperren laesst. Die Winde zum Bedienen des Gitters ist neben Dir an"
    " der Wand befestigt.\n"
    "Nach Osten zweigt ein schmaler Gang ab. \n\n"
    "  HINWEIS fuer Protheg:\n"
    "  Denke dran, hier die entsprechenden Schliessmechanismen einzubauen.\n\n");

  AddDetail( ({ "stadttor", "zugang", "weg", "gang", "torweg", "tunnel" }),
     "Dieser Torweg bildet den nordoestlichen Zugang ArdulVhiers.");
  AddDetail( ({ "tor", "tore", "ende" }),
     "Am nordoestlichen Ende des Tunnels sind massive staehlerne Tore angebracht,"
     " die bei Gefahr geschlossen werden koennen.");
  AddDetail( ({ "mitte", "gitter", "fallgitter" }),
     "Nordoestlich von Dir laesst sich der Tunnel durch ein Fallgitter absperren.");
  AddDetail( ({ "staebe", "gitterstaebe" }),
     "Die Staebe sind so dich wie zwei Finger eines Dunkelelfen.");
  AddDetail( ({ "winde" }),
     "Bei Gefahr koennen die Torwachen die Winde einfach loesen, sodass das"
     " Gitter blitzschnell nach unten faellt. So dick, wie die Staebe sind,"
     " dauert das Oeffnen bestimmt laenger.");
  AddDetail( ({ "gefahr" }),
     "Denk nach, was dir dazu einfaellt.");
  AddDetail_DSpc( ({ "dunkelelf", "dunkelelfen" }),
     ("Du stehst in einer ihrer Staedte!"),
     ("Du kannst stolz darauf sein, dazu zu gehoeren!") );
  AddDetail( ({ "boden", "decke", "wand", "waende" }),
     "Der Tunnel wurde aus dem natuerlichen Felsen heraus geschlagen."
     " Boden, Decke und Waende wurdeb zwar sorgfaeltig zurecht gehauen, aber"
     " nicht weiter geglaettet, so dass der Fels recht rauh ist." );
  AddDetail( ({ "stadt", "ardulvhier" }),
     "Die Stadt liegt suedwestlich von Dir." );
  AddDetail( ({ "hoehle", "hoehlen", "stadthoehlen" }),
     "ArdulVhier wurde in mehreren Hoehlen erbaut. Die Stadt ist so gross,"
     " dass sie in eine nicht hineingepasst haette." );
   AddDetail( ({ "abschlusswand", "felswand" }),
     "Hier im Nordosten endet die Stadt an einer Felswand, die sie von einer"
     " benachbarten Hoehle trennt." );

  // AddExit( "nordosten", ROOM "av_05_05_17_tor");
  // AddExit( "osten", ROOM "av_05_06_17");
  // AddExit( "suedwesten", ROOM "av_05_07_15");
  set_exits( "wg", ({ "ost" }) );
  set_exits( "str");
  set_exits( "tor");
}

