#include "../def.h"

#pragma strong_types

inherit ROOM "std_av";

#define ANSCHLUSS_TEMPEL "/d/unterwelt/protheg/avmitte/room/tor_0_4_0"

nosave string *feinde;

void create()
{
  ::create();
  
  SetAVStandards();
  
  SetProp(P_INT_SHORT, "Nordosttor von ArdulVhier");
  SetProp(P_INT_LONG,
	  BS("Das Stadttor ist in der nordoestlichen Abschlusswand von "
	     "ArdulVhier eingelassen. Ein breiter Torweg, der an seinem "
	     "nordoestlichen Ende durch massive Tore verschlossen werden "
	     "kann. In der Mitte des Tunnels faellt Euch noch ein Fallgitter "
	     "auf, mit dem sich der Weg Richtung Stadt sperren laesst."));
  
  AddDetail(({"stadttor", "zugang", "weg", "gang", "torweg", "tunnel"}),
     "Dieser Torweg bildet den nordoestlichen Zugang ArdulVhiers.");

  AddDetail(({"tor", "tore", "ende"}),
     "Am nordoestlichen Ende des Tunnels sind massive staehlerne Tore angebracht,"
     " die bei Gefahr geschlossen werden koennen.");

  AddDetail(({"mitte", "gitter", "fallgitter"}),
     "Suedwestlich von Euch laesst sich der Tunnel durch ein Fallgitter absperren.");

  AddDetail(({"gefahr"}),
     "Denkt nach, was Euch dazu einfaellt.");
  
  AddDetail(({"decke"}),
     "Als Ihr Euch die Decke anseht, fallen Euch fuenf Oeffnungen auf.");

  AddDetail(({"boden", "wand", "waende","felsen"}),
     "Der Tunnel wurde aus dem natuerlichen Felsen heraus geschlagen."
     " Boden und Waende wurden zwar sorgfaeltig zurecht gehauen, aber nicht"
     " weiter geglaettet, so dass der Fels recht rauh ist.");

  AddDetail(({"oeffnung","loch","gussloch","oeffnungen","loecher",
		"gussloecher"}),
     "Durch diese Gussloecher laesst sich heisses Oel, kochendes Wasser oder"
     " Pech auf Angreifer schuetten, die es geschafft haben, die Tore zu"
     " sprengen.");

  AddDetail(({"angreifer"}),
     "Ihr seid hoffentlich keiner, sonst duerfte es jetzt heiss werden ...");

  AddDetail(({"wasser", "oel", "pech", "idee"}),
     "Ihr hofft, dass nicht gerade jetzt jemand auf eine dumme Idee"
     " kommt....");
  
  AddDetail(({"stadt", "ardulvhier"}),
     "Die Stadt liegt suedwestlich von Euch.");

  AddDetail(({"hoehle", "hoehlen", "stadthoehlen"}),
     "ArdulVhier wurde in mehreren Hoehlen erbaut. Die Stadt ist so gross,"
     " dass sie in eine nicht hineingepasst haette.");
  
  AddDetail(({"abschlusswand", "felswand"}),
     "Hier im Nordosten endet die Stadt an einer Felswand, die sie von einer"
     " benachbarten Hoehle trennt.");
  
  feinde=({});
  
  AddExit("nordosten", ROOM "weg_h09");
  AddExit("ardulvhier", ([EX_DEST: ANSCHLUSS_TEMPEL,
			  EX_TESTFUNC: "keine_feinde",
			  EX_PLMSG: "Ihr durchschreitet den Tunnel.\n"+
			  BS("Als Ihr den Tunnel wieder verlasst, geleiten "
			     "Euch zwei Wachen bis zum Tempelgelaende, da "
			     "dieser Stadtteil zur Zeit nicht betreten "
			     "werden darf.")+
			  BS("Ihr betretet den Verbindungstunnel zum "
			     "Tempelgelaende..."),
			  EX_MSG: "in die Dunkelelfenstadt ArdulVhier"]));
  
  AddItem(NPC "tw", REFRESH_DESTRUCT);
  AddItem(NPC "tw", REFRESH_DESTRUCT);
  
  //AddExit("suedwesten", ROOM "av_05_06_16");
  //set_exits("tor");
}

int keine_feinde()
{
  object ob;

  if(DHRKION->getfeindkills(TP) < 500)
    return 1;
  
  if(!query_once_interactive(TP)) 
    return 1;
  
  if(ob=present("torwaechter"))
    {
      write(BS("Der Waechter haelt Euch zurueck!")+
	    BS("Der Waechter erkennt in Euch den Feind!")+
	    BS("Der Waechter greift Euch an."));
      
      ob->Kill(TP);
    }
  
  write(BS("Ihr durchschreitet den Tunnel...")+
	BS("Ploetzlich werdet Ihr nach hinten gerissen und in hohem Bogen "
	   "aus dem Tunnel wieder herausgeschleudert!!")+
	"\n"+
	BS("Ihr fragt Euch, was das wohl jetzt war!"));
  TP->AddHp(-50-random(21));
  
  return 0;
}
