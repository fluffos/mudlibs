#pragma strong_types

#include "../def.h"

inherit ROOM "nordufer";

// ---------- Funktionen
void create()
{
  ::create();
  
  SetAVStandards();
  
  AddDetail(({"fels","felsen"}),
	    "Ein gewaltiger Felsen blockiert das Seeufer weiter nach "
	    "Nordosten.");
  
  set_exits("noufer");
  
  AddItem(NPC "lugful", REFRESH_DESTRUCT);
}

string int_long( mixed viewer, mixed viewpoint, int shortflag)
{
  if(TP->QueryProp(P_RACE) == "Dunkelelf")
    SetProp(P_INT_LONG,
	    "Das Seeufer endet hier abrupt an einem gewaltigen Felsen, der "
	    "scheinbar von der Decke herausgebrochen und herabgefallen ist.");
  else
    SetProp(P_INT_LONG,
	    "Das Seeufer endet hier abrupt an einem gewaltigen Felsen.");

  return ::int_long( viewer, viewpoint, shortflag);
}

