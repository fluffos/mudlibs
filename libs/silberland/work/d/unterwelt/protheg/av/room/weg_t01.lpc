#pragma strong_types

#include "../def.h"
 
inherit ROOM "std_av";

#define ANSCHLUSS "/d/wueste/andyl/kanalisation/room/keller"
 
void create()
{
  ::create();
 
  SetProp(P_INT_SHORT, "Der Beginn eines steilen Tunnels");
  SetProp(P_INT_LONG,  "");  // Wird in int_long() gesetzt...

  //  Lichtlevel und Terrain
  SetAVStandards();
  Licht("duester"); //hier ist es noch nicht ganz so finster
  
  AddDetail(({"tunnel"}),
	    "Ein steiler, enger Tunnel. Besonders wohl fuehlst Du Dich hier "
	    "nicht.");
  
  AddDetail(({"beginn","tunnelbeginn"}),
	    "Du befindest Dich hier am Beginn eines Tunnels, der irgendwohin "
	    "hinunter in die Dunkelheit fuehrt.");
  
  AddDetail(({"unterwelt"}),
	    "Das finstere Reich in den Tiefen des Silberlands.");

  AddDetail(({"tiefe", "tiefen", "reich","hinunter","dunkelheit"}),
	    "Dort scheint dieser Tunnel hinzufuehren.");

  AddDetail(({"silberland"}),
	    "Silbern ist hier gar nichts....");
  
  AddDetail(({"boden"}),
	    "Nass und kalt, sei vorsichtig, sonst rutschst Du noch aus! Im "
	    "Tunnel aendert sich das Gestein allerdings zu Sandstein.");

  AddDetail(({"decke"}),
	    "Eine steinerne Decke voll mit Stalagtiten. Im Tunnel aendert "
	    "sich das Gestein allerdings zu Sandstein.");
  
  AddDetail(({"sandstein"}),
	    "Der Tunnel besteht aus Sandstein, wie man ihn in der Wueste "
	    "findet.");
  
  AddDetail(({"stalagtiten","stalagtit"}),
	    "Die Decke ist voll mit denen.");
  
  AddDetail(({"stalagmiten","stalagmit"}),
	    "Der Boden ist ganz glatt!");
  
  AddDetail(({"wand","tunnelwand","waende","tunnelwaende"}),
	    "Die Tunnelwaende sind mit allerlei Schriftzeichen und "
	    "Ornamenten versehen.");
  
  AddDetail(({"ornament","ornamente"}),
	    "Die Ornamente sind leider schon zu verblasst, als dass man "
	    "etwas erkennen koennte...");
  
  AddDetail_DSpc(({"zeichen","schriftzeichen"}),
	 ("Du kannst sie nicht entziffern..."),
	 ("Alte Schutzzauber, die jedoch mit der Zeit ihre Magie "
	  "verloren haben."));
  
  AddDetail(({"zeit"}),
	    "Scheinbar wurde dieser Tunnel schon vor sehr langer Zeit "
	    "erbaut und ist mittlerweile recht heruntergekommen.");
  
  AddDetail_DSpc(({"zauber","schutzzauber","magie"}),
	 ("Ob es hier welche gibt?!"),
	 ("Jeglicher Zauber hier ist laengst erloschen."));
  
  AddDetail_DSpc(({"sueden","stueck","fuss","fusse"}),
	 ("Der Tunnel steigt noch ein Stueck steil an und endet dann am Fuss"
	  " eines Schachts."),
	 ("Der Tunnel steigt noch etwas an und scheint dann am Fusse eines"
	  " Schachtes zu enden."));

  AddDetail_DSpc(({"suedwesten","knick"}),
	 ("Der Tunnel verschwindet in der Finsternis. Du kannst nicht sehen, was"
	  " dort ist."),
	 ("Der Tunnel faellt steil ab. Dann verschwindet er hinter einem weiteren"
	  " Knick. Was dahinter liegt, kannst Du von hier aus nicht sehen."));
  
  AddDetail_DSpc(({"schacht", "brunnen"}),
	 ("Der Schacht eines alten, ausgetrockneten Brunnens. Durch ihn kannst"
	  " Du auf die Oberflaeche klettern. Dort oben ist es ebenfalls "
	  "stockdunkel."),
	 ("Anscheinend ein Schacht, der zur Oberflaeche fuehrt. Oben befindet "
	  "sich der Keller eines halbverfallenen Hauses."));
  
  AddDetail(({"keller","oben"}),
	    "Der Keller des alten Hauses befindet sich oben.");
  
  AddDetail(({"haus","arrakeen","wueste","oberflaeche"}),
	    "Um dorthin zu gelangen, musst Du raufklettern.");
  
  AddCmd(CMD_KLETTERN, "cmd_klettern");
  
  AddExit("suedwestunten", ROOM "weg_t02");
  AddExit("rauf",          ANSCHLUSS);
}

nosave int cmd_klettern(string str)
{
  notify_fail(BS("Wohin willst Du denn klettern?"));
  if(!str) return 0;
  
  if(str=="rauf"||str=="hinauf"||str=="hoch")
    {
      if(TP->QueryProp(P_RESTING))
	return write(BS("Du raste erstmal fertig!")), 1;
      
      write(BS("Du beginnst den Schacht hinaufzuklettern."));
      
      if(!TP->do_exhaust(50))
	return write(BS("Erschoepft landest Du wieder da, wo Du angefangen "
			"hast.")), 1;
      
      write(BS("Erschoepft gelangst Du oben an..."));
      
      TP->move(ANSCHLUSS, M_GO);
      
      return 1;
    }
  
  return 0;
}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  if(objectp(viewer) && IS_DROW(viewer))
    SetProp(P_INT_LONG,
	    BS("Der Tunnel knickt hier scharf von Suedwesten nach Sueden ab. "
	       "Er steigt in dieser Richtung noch ein kurzes Stueck an und "
	       "scheint dann am Fusse eines Schachts zu enden. Der Schacht "
	       "fuehrt senkrecht nach oben. Nach Suedwesten hin faellt der "
	       "Tunnel steil ab und fuehrt in die Tiefen der Unterwelt."));
  else
    SetProp(P_INT_LONG,
	    BS("Du stehst am Beginn eines Tunnels, der steil nach unten in "
	       "die Tiefe fuehrt. Der Tunnel macht einen scharfen Knick von "
	       "Sueden nach Suedosten. Hier ist es sonst ueberall "
	       "stockdunkel. Du bist Dir nicht sicher, ob Du wirklich dort "
	       "hinunter gehen moechtest."));
  
  return ::int_long(viewer, viewpoint, shortflag);
}
