#pragma strong_types

#include "../def.h"
 
inherit ROOM "nordufer";

// ---------- Funktionen
void create()
{
  ::create();
 
  SetAVStandards();
  
  AddDetail(({"stueck"}), 
	    "Das Stueck des Seeufers hier ist besonders flach.");
  
  set_exits("noufer");
}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  if(TP->QueryProp(P_RACE) == "Dunkelelf")
    SetProp(P_INT_LONG,
	    "Ein flaches Stueck Seeufer am Rand des Sees von ArdulVhier.");
  else
    SetProp(P_INT_LONG,
	    "Ein flaches Stueck Seeufer direkt am Rand einer Wasserflaeche.");

  return ::int_long( viewer, viewpoint, shortflag);
}

