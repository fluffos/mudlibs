/*
**  weg_t02.c  Weg von der Oberflaeche zur Dunkelelfenstadt ArdulVhier
**
**  Tyron, 24.5.2003
**
*/

#pragma strong_types

#include "../def.h"
 
inherit ROOM "std_av";
 
void create()
{
  ::create();
  
  //  Lichtlevel und Terrain
  SetAVStandards();
  
  SetProp(P_INT_SHORT, "Ein steiler Tunnel");
  SetProp(P_INT_LONG,  "");  // Wird in int_long() gesetzt...
 
  AddDetail(({"tunnel"}),
    "Ein steiler, enger Tunnel. Besonders wohl fuehlst Du Dich hier nicht.");

  AddDetail(({"unterwelt"}),
    "Das finstere Reich in den Tiefen des Silberlands.");

  AddDetail(({"tiefe","tiefen","reich"}),
    "Dort scheint dieser Gang hinzufuehren.");

  AddDetail(({"silberland"}),
    "Silbern ist hier gar nichts....");

  AddDetail_DSpc(({"suedosten"}),
    ("Du glaubst dort einen Lichtschimmer zu sehen. Sollte der Gang in"
    " dieser Richtung tatsaechlich an die Oberflaeche fuehren?"),
    ("Ein Stueck den Gang hinauf kommt schliesslich ein Knick, hinter dem"
     " Du einen deutlichen Lichtschimmer siehst."));

  AddDetail_DSpc(({"osten"}),
    ("Tiefste Dunkelheit!"),
    ("Der Gang fuehrt so lange nach Osten, dass Du dort nichts mehr"
     "erkennen kannst."));

  AddDetail(({"richtung"}),
    "Richtung Nordosten koennte der Gang an die Oberflaeche fuehren.");

  AddDetail(({"knick"}),
    "Du stehst an einem scharfen Knick.");

  AddDetail_DSpc(({"stueck"}),
    ("Wie, Stueck??"),
    ("Ein.Stueck den Gang entlang kommt schliesslich ein weiterer scharfer"
     " Knick."));

  AddDetail_DSpc(({"oberflaeche"}),
    ("Wenn der Lichtschimmer im Nordosten Tageslicht ist, dann bist Du gar"
     " nicht mehr weit davon entfernt."),
    ("Von der trennt Dich nur noch ein kurzes Stueck Weg. Du kannst schon"
     " das Tageslicht erkennen."));

  AddDetail(({"fels","felsen","gestein","wand","waende","decke","boden"}),
    "Der Felsen besteht wohl aus Sandstein und ist ziemlich rauh.");

  AddDetail(({"sandstein"}),
    "Der Sandstein, wie man ihn in der Wueste findet.");

  AddDetail(({"wueste"}),
    "Die liegt irgendwo ueber Dir.");

  AddDetail(({"hoehle","hoehlen"}),
    "Hoehlen siehst Du hier keine.");

  AddDetail_DSpc(({"dunkelheit","finsternis"}),
    ("Hier ist es voellig dunkel. Nur im Nordosten glaubst Du einen leichten"
     " Lichtschimmer zu erkennen."),
    ("Hier herrscht noch eine angenehme Dunkelheit, aber weiter im Nordosten"
     " wird es unangenehm hell."));

  AddDetail_DSpc(({"licht","schimmer","lichtschimmer"}),
    ("Du glaubst einen leichten Lichtschimmer zu sehen. Vielleicht"
     " Tageslicht?"),
    ("Du siehst einen deutlichen Lichtschimmer. Hinter dem Knick kommt"
     " irgendwie Tageslicht in den Gang und zerstoert die Dunkelheit."));

  AddDetail_DSpc(({"tageslicht"}),
    ("Du bist Dir nicht voellig sicher. Dazu ist der Lichtschimmer zu"
     " schwach."),
    ("Hinter dem naechsten Knick erreicht Tageslicht den Gang."));

  AddDetail_DSpc(({"platz","plaetze"}),
    ("Dies ist kein Platz fuer Dich."),
    ("Der Tunnel ist nicht besonders angenehm. Du kennst schoenere Plaetze"
     " in der Unterwelt."));

  AddDetail_DSpc(({"gang"}),
    ("Als Du Dir die Wand einmal genauer ansiehst, erkennst Du, dass der"
     " Gang kuenstlich angelegt wurde."),
    ("Dieser Gang wurde kuenstlich in den Felsen geschlagen."));
  
  AddExit("ostunten",    ROOM "weg_t03");
  AddExit("nordostoben", ROOM "weg_t01");

  AddItem(NPC "bat", REFRESH_DESTRUCT);
}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  if(objectp(viewer) && IS_DROW(viewer))
    SetProp(P_INT_LONG,
	    BS("Der Tunnel knickt hier scharf von Osten nach Nordosten ab. Er "
	       "steigt dabei nach Nordosten hin steil an, und fuehrt nach "
	       "Osten genauso steil in die Tiefe. Ein Stueck weiter im "
	       "Nordosten verschwindet er hinter einem weiteren scharfen "
	       "Knick. Ob es hinter diesem Knick noch viel weiter geht?"));
  else
    SetProp(P_INT_LONG,
	    BS("Dies ist vermutlich einer der vielen Tunnel, die sich durch "
	       "die Finsternis der Unterwelt ziehen. Du stehst an einem "
	       "scharfen Knick. Nach Nordosten hin steigt der Gang steil an, "
	       "nach Osten fuehrt er genauso steil in die Tiefe. Du bist "
	       "Dir nicht sicher, ob Du wirklich dort hinunter gehen "
	       "moechtest."));
  
  return ::int_long(viewer, viewpoint, shortflag);
}
