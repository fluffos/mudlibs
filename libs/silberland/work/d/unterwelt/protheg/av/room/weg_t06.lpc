/*
**  weg_t06.c  Weg von der Oberflaeche zur Dunkelelfenstadt ArdulVhier
**
**  Tyron, 24.5.2003
**
*/

#pragma strong_types
 
#include "../def.h"
 
inherit ROOM "std_av";

void create()
{
  ::create();
  
  //  Lichtlevel und Terrain
  SetAVStandards();
  
  SetProp(P_INT_SHORT, "Ein steiler Tunnel");
  SetProp(P_INT_LONG,  "");  // Wird in int_long() gesetzt...
 
  AddDetail(({"tunnel"}),
    "Ein steiler, enger Tunnel. Besonders wohl fuehlst Du Dich hier nicht.");

  AddDetail(({"unterwelt"}),
    "Das finstere Reich in den Tiefen des Silberlands.");

  AddDetail(({"tiefe","tiefen","reich"}),
    "Dort scheint dieser Gang hinzufuehren.");

  AddDetail(({"silberland"}),
    "Silbern ist hier gar nichts....");

  AddDetail_DSpc(({"suedosten"}),
    ("Tiefste Dunkelheit! Aber vielleicht fuehrt der Gang in dieser Richtung"
     " an die Oberflaeche."),
    ("Ein Stueck den Gang hinauf kommt schliesslich ein Knick. Was"
     " dahinter liegt, kannst Du leider nicht sehen."));

  AddDetail_DSpc(({"sueden"}),
    ("Tiefste Dunkelheit!"),
    ("Der Gang fuehrt so lange nach Sueden, dass Du dort nichts mehr"
     "erkennen kannst."));

  AddDetail(({"richtung"}),
    "Richtung Suedosten koennte der Gang an die Oberflaeche fuehren.");

  AddDetail(({"knick"}),
    "Du stehst an einem scharfen Knick.");

  AddDetail_DSpc(({"stueck"}),
    ("Wie, Stueck??"),
    ("Ein Stueck den Gang entlang kommt schliesslich ein weiterer scharfer"
     " Knick."));

  AddDetail_DSpc(({"oberflaeche"}),
    ("Wie weit es bis zu der noch sein mag? Und ob der Gang dorthin fuehrt?"),
    ("Von der trennt Dich noch erfreulich viel Fels."));

  AddDetail(({"fels","felsen","gestein","wand","waende","decke","boden"}),
    "Der Felsen besteht wohl aus Kalkstein und ist ziemlich rauh.");

  AddDetail(({"kalkstein"}),
    "Ein recht weiches Gestein, in dem sich haeufig Hoehlen bilden.");

  AddDetail(({"hoehle","hoehlen"}),
    "Hoehlen siehst Du hier keine.");

  AddDetail_DSpc(({"dunkelheit","finsternis"}),
    ("Diese unendliche Finsternis geht Dir allmaehlich auf die Nerven. Du"
     " siehst fast nichts, nur wenige Schritte von Dir entfernt koennten"
     " sich die schlimmsten Monster verbergen."),
    ("Eine angenehme Dunkelheit umgibt Dich."));

  AddDetail_DSpc(({"platz","plaetze"}),
    ("Dies ist kein Platz fuer Dich."),
    ("Der Tunnel ist nicht besonders angenehm. Du kennst schoenere Plaetze"
     " in der Unterwelt."));

  AddDetail_DSpc(({"gang"}),
    ("Als Du Dir die Wand einmal genauer ansiehst, erkennst Du, dass der"
     " Gang kuenstlich angelegt wurde."),
    ("Dieser Gang wurde kuenstlich in den Felsen geschlagen."));

  AddDetail_DSpc(({"monster","alptraum","alptraeume"}),
    ("Monster, wie Du sie Dir in Deinen schlimmsten Alptraeumen nicht"
     " vorstellen kannst."),
    ("Ja, in der Unterwelt gibt es auch Monster, die einem Alptraeume"
     " bereiten koennen. Aber wie kommst Du jetzt darauf?"));

  AddDetail_DSpc(({"ahnung","nerven"}),
    ("Du hast keine Ahnung, was Dich auf den naechsten Metern erwartet."),
    ("Du hast keine Ahnung, was Dich in diesem Tunnel alles erwartet. Aber"
     " Du weisst, dass die Unterwelt gefaehrlich sein kann."));
  
  AddExit("suedunten", ROOM "weg_t07");
  AddExit("suedostoben", ROOM "weg_t05");
  
  AddItem(NPC "bat", REFRESH_DESTRUCT);
  AddItem(NPC "bat", REFRESH_DESTRUCT);
}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{
  if(objectp(viewer) && IS_DROW(viewer))
    SetProp(P_INT_LONG,
	    BS("Der Tunnel knickt hier scharf von Sueden nach Suedosten ab. "
	       "Er steigt dabei nach Suedosten hin steil an, und fuehrt nach "
	       "Sueden genauso steil in die Tiefe. Ein Stueck weiter im "
	       "Suedwesten verschwindet er hinter einem weiteren scharfen "
	       "Knick. So geradlinig, wie sich der Gang durch das Gestein "
	       "zieht, und so geometrisch, wie die Knicke aussehen, bist Du "
	       "Dir ziemlich sicher, dass dies kein natuerlicher Gang ist."));
  else
    SetProp(P_INT_LONG,
	    BS("Dies ist einer der vielen Tunnel, die sich scheinbar endlos "
	       "durch die Finsternis der Unterwelt ziehen. Du stehst an "
	       "einem scharfen Knick. Nach Suedosten hin steigt der Gang "
	       "steil an, nach Sueden fuehrt er genauso steil in die Tiefe. "
	       "Du hast keine Ahnung, was Dich auf den naechsten Metern "
	       "erwartet. Schon nach kurzer Zeit verschwindet der Gang in "
	       "tiefer Finsternis. Irgendwie fuehlst Du Dich hier fehl am "
	       "Platz."));
  
  return ::int_long(viewer, viewpoint, shortflag);
}
