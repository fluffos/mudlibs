#pragma strong_types

#include "../def.h"
 
inherit ROOM "nordufer";

// ---------- Funktionen
void create()
{
  ::create();
  
  SetAVStandards();
  
  AddDetail(({"bank","schlammbank"}),
	    "Eine grosse Schlammbank erschwert hier das Weiterkommen. Sie "
	    "zieht sich von der Hoehlenwand bis weit ins Wasser.");
  
  AddDetail(({"weiterkommen","weiter"}),
	    "Die Schlammbank erschwert das Weiterkommen, Ihr sinkt staendig "
	    "ein.");
  
  AddDetail(({"schlamm","etwas"}),
	    "Braunes, uebelriechendes Etwas...\nIhr wuergt.");
  
  AddDetail(({"stelle", "schlammlose stelle"}),
	    "Auf einer schlammlosen Stelle erkennt ihr noch verschwommen "
	    "einige Spuren...");
  
  AddDetail(({"spuren","spur"}),
	    "Die Spuren deuten darauf, dass etwas Schweres ueber den Boden "
	    "gezogen wurde.");
  
  AddDetail(({"schweres","etwas schweres"}),
	    "Scheinbar wurde es aus dem Wasser ans Ufer gezogen.");
  
  AddSmell(({DEFAULT_SMELL, "schlamm","etwas","schlammbank","bank"}),
	   "Der Schlamm, der Euch umgibt stinkt fuerchterlich.");
  
  set_exits("noufer", ({"nordosten"}), 1);
  
  AddItem(({NPC "schlange",NPC "krabbe"}), REFRESH_DESTRUCT);
}

string int_long(mixed viewer, mixed viewpoint, int shortflag)
{ 
  if(objectp(viewer) && IS_DROW(viewer))
    SetProp(P_INT_LONG,
            "Vor Euch erstreckt sich eine Schlammbank ueber das Seeufer. "
	    "Auf einer schlammlosen Stelle erkennt ihr einige verschwommene "
	    "Spuren.");
  else
    SetProp(P_INT_LONG,
            "Vor Euch erstreckt sich eine Schlammbank ueber das Seeufer. "
	    "Auf einer schlammlosen Stelle erkennt ihr einige verschwommene "
	    "Spuren.");
  
  return ::int_long(viewer, viewpoint, shortflag);
}

void init()
{
  ::init();
  
  if(interactive(TP))
    catch(call_other(ROOM "boot", "???"));
}
