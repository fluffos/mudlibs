
// GLAAKIS SAEURESCHUHE


inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>


void create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Lederschuhe");
  SetProp(P_LONG, 
      "Die Schuhe bestehen aus festem Leder und sitzen bequem auf "
      "Deinen Fuessen.");
  SetProp(P_PLURAL, 1);
  SetProp(P_NAME, "Schuhe");
  AddId( ({ "schuhe", "lederschuhe", "saeureschuhe" }) );
  SetProp(P_INFO, 
        "Die Schuhe sind aus einem speziellen Leder gegerbt und bieten "
        "einen guten Schutz gegen Saeureattacken.\n" );

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 300);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_AC, 8);
  SetProp(P_DAM_PROTECTION, 
	  QueryProp(P_DAM_PROTECTION)+([DT_ACID:1, DT_MAGIC:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1]) );
  SetProp(P_MATERIAL, ([MAT_MISC_ACID:10, MAT_LEATHER:90]) );


}

