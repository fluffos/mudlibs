
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include "../alte.h"


void create()
{
  if(!is_clone(this_object()))return;
  ::create();

  SetProp(P_SHORT, "Eine schwarze Kutte");
  SetProp(P_LONG,
        "Eine tiefschwarze Kutte, die einst irgendeinen leblosen Koerper "
		"eingehuellt hat. Die Diener der Grossen Alten tragen sie bei ihren "
		"frevelhaften Anbetungen. ");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Kutte");
  SetProp(P_NAME_ADJ, "schwarz");
  AddId("kutte");
  AddAdjective( ({"schwarz", "schwarze", "schwarzen"}) );

  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 500);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([ MAT_CLOTH:90, MAT_MISC_UNHOLY:10]));

  AddDetail( ({ "diener" }),
	  "Die Kutte huellte einst den Koerper eines Dieners ein. ");

  AddDetail( ({ "anbetungen" }),
	  "Die Diener wurden von den Grossen Alten aus Protoplasma erschaffen, "
	  "und sind ihnen hoerig. ");

  AddDetail( ({ "protoplasma" }),
	  "Aus ihm wurden die Diener aus dem Nichts erschaffen. ");

}

