
// TSATHOGGUAS MUETZE !!!


inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>


void create()
{
  if(!is_clone(this_object()))return;
  ::create();

  SetProp(P_SHORT, "Eine Wollmuetze");
  SetProp(P_LONG, "Eine bequeme Wollmuetze mit Ohrenschuetzern.");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Muetze");
  SetProp(P_INFO, "Die Muetze hat Ohrenschuetzer und "
	  "daher kann man Dir ins Ohr schreien und Dir "
	  "macht das nix. :-) Ausserdem haelt sie schoen warm.\n" );
  AddId( ({ "muetze", "wollmuetze" }) );
 
  AddDetail( ({ "ohrenschuetzer", "schuetzer" }), 
      "Die Muetze hat Ohrenschuetzer eingebaut, die von oben herabhaengen "
      "und so die Ohren schoen warm halten.");

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 300);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, MAT_WOOL);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4,T_HEAT_PROT:-2]) );
  SetProp(P_DAM_PROTECTION, 
	  QueryProp(P_DAM_PROTECTION)+([DT_COLD:1, DT_SOUND:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1]) );


}
