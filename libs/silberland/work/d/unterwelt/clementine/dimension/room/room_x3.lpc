

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"

create()
{
	::create();

	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG,
		"Du wanderst einen schier endlos erscheinenden Gang "
		"aus Saeulen entlang. Links und rechts von Dir ragen "
		"die ueberdimensionalen Steinpfeiler auf ihren imposanten "
		"Sockeln in die Hoehe, und verlaufen sich hoch ueber Dir im "
		"Nichts. Der glatt polierte Marmor wirkt beeindruckend, strahlt "
		"aber gleichzeitig eine ungeheure Kaelte und Bedrohung aus. "
		"Nach Nordosten kommst Du zu einem Brunnen. ");
	SetProp(P_LIGHT, 0);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);

	AddExit( "osten", ROOM "room_x1");
	AddExit( "suedwesten", ROOM "room_g3");
	AddExit( "nordwesten", ROOM "room_x4");
	AddExit( "nordosten", ROOM "alte");


//DETAILBEGINN

	AddDetail( ({ "nordosten" }),
          "Im Nordosten siehst Du einen Brunnen stehen.");

	AddDetail( ({ "brunnen" }),
	  "Der Brunnen im Nordosten sieht total interessant aus. Vielleicht "
	  "solltest Du ihn Dir einmal ansehen?");


	AddDetail( ({ "decke" }),
	  "Du kannst die Decke von hier aus nicht sehen.");

	AddDetail( ({ "nichts" }),
	  "Die Steinpfeiler verlaufen sich hoch ueber Dir im Nichts.");

	AddDetail( ({ "steinpfeiler", "pfeiler", "saeulen" }),
	  "Sehr imposant ragen die Saeulen rechts und links von Dir in die "
	  "Hoehe. ");

	AddDetail( ({ "hoehe" }),
	  "Die Saeulen sind wirklich wahnsinnig hoch. Nicht minder hoch "
	  "aber auch die Sockel.");

	AddDetail( ({ "sockeln", "sockel" }),
	  "Du schaetzt, dass die Sockeln mindestens 1,5 Meter hoch sind.");

	AddDetail( ({ "meter" }),
	  "Die genaue Hoehe der Sockeln wuerdest Du natuerlich erst "
	  "erfahren wenn Du sie abmisst.");

	AddDetail( ({ "gang", "saeulengang" }),
	  "Du stehst in einem Saeulengang im Tempel. Bemerkbar macht "
	  "sich das vorallem durch die Saeulen rechts und links von Dir. ");

	AddDetail( ({ "waende", "wand" }),
	  "Die wenigen Waende bestehen aus Stein. An der Westwand "
	  "faellt Dir ein komisches Gekritzel auf.");

	AddDetail( ({ "westwand" }),
	  "An der Westwand ist ein komisches Gekritzel.");

	AddDetail( ({ "gekritzel" }),
	  "Versuch es doch einmal zu lesen!");

	AddReadDetail( ({ "gekritzel" }),
	  "HIIIIIIIIIIIIIILFE!!!!");

	AddDetail( ({ "hilfe" }),
	  "Wer das wohl an die Wand gekritzelt hat?");

	AddDetail( ({ "suedwesten" }),
	  "Im Suedwesten scheint eine Statue zu stehen.");

	AddDetail( ({ "statue" }),
	  "Dazu musst Du schon naeher hingehen!");

	AddDetail( ({ "tempel" }),
	  "Der Tempel entpuppt sich wirklich als riesig. Von aussen sah "
	  "er ja eigentlich gar nicht so gross aus. Wer ihn wohl "
	  "erschaFfen hat?!");

	AddDetail( ({ "erschaffer" }),
	  "Du fragst Dich wer wohl der Erschaffer dieses Tempels war.");

	AddDetail( ({ "stein" }),
	  "Kalter Stein ziert die Waende und den Boden. Irgendwie wirkt "
	  "alles sehr trostlos und verlassen. Aber der Schein truegt "
	  "vermutlich.");

	AddDetail( ({ "schein" }),
	  "Vielleicht truegt der Schein hier einfach und der Tempel ist "
	  "gar nicht so verlassen wie Du anfangs dachtest.");

	AddDetail( ({ "kaelte" }),
	  "Der Marmor strahlt eine ungeheure Kaelte aus. Du fuehlst Dich "
	  "leicht bedroht. Oder leidest Du jetzt schon unter "
	  "Verfolgungswahn?");

	AddDetail( ({ "verfolgungswahn", "wahn" }),
	  "Ist da jemand? Du drehst Dich blitzartig um, kannst aber "
	  "keinen entdecken. Komisch...war da nicht grad ein Geraeusch?");

	AddDetail( ({ "marmor" }),
	  "Der Marmor fuehlt sich kuehl an. Irgendwie unheimlich. Woraus "
	  "er wohl besteht? Die Zwerge in Felonia koennen Dir darueber sicher "
	  "Auskunft geben.");

	AddDetail( ({ "felonia" }),
	  "Die Zwerge in Felonia kennen sich mit Marmor aus!");

	AddDetail( ({ "zwerge", "zwerg" }),
	  "Wenn Du bezueglich des Marmors Fragen hast, dann solltest Du "
	  "die Zwerge fragen gehen.");

	AddDetail( ({ "fragen", "frage" }),
	  "Hast Du Fragen?");

	AddDetail( ({ "auskunft" }),
	  "Hier wirst Du sie nicht bekommen.");

	AddDetail( ({ "bedrohung" }),
	  "Ein mulmiges Gefuehl steigt in Dir auf. Ob Du nicht doch lieber "
	  "umdrehen solltest?");

	AddDetail( ({ "gefuehl" }),
	  "Du fuehlst Dich unwohl hier. Vielleicht ist das hier einfach "
	  "nicht der richtige Ort fuer Dich. ");

	AddDetail( ({ "ort" }),
	  "Auf Mauritius waerst Du jetzt definitiv lieber. Leider kannst Du "
	  "Dir das gerade nicht aussuchen.");

	AddDetail( ({ "mauritius" }),
	  "Weisse Sandstraende, Meer - keine ekeligen und gruseligen "
	  "Tempel. ");

	AddDetail( ({ "sandstraende", "straende", "sandstrand", "strand" }),
	  "Hach ja... weisser warmer Sand unter Deinen Fuessen - das waers "
	  "jetzt. ");

	AddDetail( ({ "fuesse", "fuss" }),
	  "Deine Fuesse stehen leider immer noch auf dem kalten Marmor.");

	AddDetail( ({ "tempel" }),
	  "Du befindest Dich hier in ihm.");

	AddDetail( ({ "meer" }),
	  "Tuerkisfarbenes Meer - hach...");

	AddDetail( ({ "sand" }),
          "Du spuerst schon foermlich den Sand unter Deinen Fuessen.");

	AddDetail( ({ "boden" }),
	  "Der Boden besteht aus Marmor. Alles ist ganz schlicht, beinahe "
	  "schon steril.");

//SMELLS

	AddSmell(DEFAULT_SMELL,
	  "Du befindest Dich hier in einer absolut geruchsfreien Zone.");

	AddSmell( ({ "zone" }),
	  "Du riechst rein gar nichts!");

//SOUNDS

	AddSound(DEFAULT_SOUND,
	  "Eisigkalte Stille herrscht hier. Doch halt, was war das?!!!");

	AddSound( ({ "stille" }),
	  "Fast schon unheimlich legt sich die Stille ueber den Raum.");

	AddSound( ({ "raum" }),
	  "Dir ist schon ganz mulmig im Magen.");

	AddSound( ({ "magen" }),
	  "Nicht einmal Dein Magen traut sich irgendetwas von sich zu geben.");

	AddSound( ({ "irgendetwas", "etwas" }),
	  "Nichts zu hoeren!");

	AddSound( ({ "geraeusch" }),
	  "Nichts zu hoeren!");

//COMMANDS

	AddCmd( ({ "mess", "messe", "miss" }), "c_abmessen");

}

int c_abmessen(string str)
{
	if(str != "sockel ab"  &&
	   str != "sockeln ab" &&
	   str != "sockel"     &&
	   str != "sockeln"    )
	{
		notify_fail("Was moechtest Du hier abmessen?\n");
		return 0;
	}
	if(!present("massband", TP))
	{
		write(BS("Du hast doch gar kein Massband dabei!"));
		return -1;
	}
	else
	{
		write(BS("Wie Du vorhin schon geschaetzt hast. Der "
			"Sockel ist genau 1,52 Meter hoch."));
		return 1;
	}
}


