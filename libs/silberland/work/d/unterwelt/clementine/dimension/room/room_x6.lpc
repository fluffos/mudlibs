

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"

void create()
{
	::create();

	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG,
		"Nichts als die gewaltigen Saeulen aus schwarzem Stein "
		"befindet sich rechts und links von Dir. Mit ihren "
		"quadratischen Sockeln sehen sie ziemlich beeindruckend "
		"aus, zumal ihr Ende fuer Dich gar nicht ersichtlich "
		"scheint. Auf dem polierten Boden kann man "
		"sogar fast sein Spiegelbild erkennen. Wirklich sehr "
		"eindrucksvoll! "
		"Ein suesslicher Geruch macht sich in nordoestlicher Richtung "
		"breit, im Suedwesten siehst Du einen Brunnen. ");
	SetProp(P_LIGHT, 0);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);

	AddExit( "westen", ROOM "room_x7");
	AddExit( "suedosten", ROOM "room_x5");
	AddExit( "suedwesten", ROOM "alte");
	AddExit( "nordosten", ROOM "room_g6");


//DETAILBEGINN

	AddDetail( ({ "spiegelbild", "bild" }),
	  "Du bist einfach fesch wie immer! Absolut umwerfend!");

	AddDetail( ({ "geruch" }),
	  "Riechen!");

	AddDetail( ({ "richtung" }),
	  "im Suedwesten ist ein Brunnen, nach Nordosten kommst Du in "
	  "eine andere Kammer.");

	AddDetail( ({ "kammer" }),
	  "Von hier aus kannst Du nichts erkennen.");

	AddDetail( ({ "brunnen" }),
	  "Der ist im Suedwesten!");

	AddDetail( ({ "suedwesten" }),
	  "Im Suedwesten ist ein Brunnen. Schau ihn Dir einfach mal an!");

	AddDetail( ({ "nordosten" }),
	  "Du bist Dir nicht sicher, ob Du wirklich wissen willst, was sich "
	  "im Nordosten befindet. Der Geruch verheisst zumindest nichts "
	  "Gutes.");

	AddDetail( ({ "gutes" }),
	  "Du kannst nichts Gutes erkennen.");

	AddDetail( ({ "ende" }),
	  "Du kannst es nicht sehen, deshalb wirken die Saeulen ja "
	  "so beeindruckend auf Dich.");

	AddDetail( ({ "stein", "marmor" }),
	  "Feste, im Laufe der Erdgeschichte entstandene mineralische Masse.");

	AddDetail( ({ "laufe", "erdgeschichte", "geschichte" }),
	  "Der Stein ist mindestens genauso alt wie alles andere hier.");

	AddDetail( ({ "masse" }),
	  "Die mineralische Masse ist einfach ein anderes Wort fuer Stein.");

	AddDetail( ({ "wort" }),
	  "Stein oder Masse!");

	AddDetail( ({ "saeule", "saeulen", "steinpfeiler", "pfeiler" }),
	  "Die Saeulen sind einfach ueberdimensional riesig. Viel viel "
	  "groesser als alles, was Du bisher gesehen hast. ");

	AddDetail( ({ "sockel", "sockeln" }),
	  "An einem kannst Du eine Inschrift erkennen.");

	AddDetail( ({ "inschrift" }),
	  "Du kannst sie lesen!");

	AddReadDetail( ({ "inschrift" }),
	  " ______________________________\n"
	  "|                             |\n"
	  "| Huete Dich vor dem Troll !!!|\n"
	  "|_____________________________|\n");

	AddDetail( ({ "troll" }),
	  "Du hast absolut keinen Plan vor welchem Troll Du Dich "
	  "hueten sollst, nimmst es aber zur Kenntnis.");

	AddDetail( ({ "kenntnis" }),
          "Registriert und zur Kenntnis genommen - Trolle sind boese!");

	AddDetail( ({ "trolle" }),
	  "BOESE BOESE BOESE !!!");

	AddDetail( ({ "boese" }),
	  "Boese ist der Boeseste!");

	AddDetail( ({ "boesester", "boeseste" }),
	  "Boese!");

	AddDetail( ({ "wand", "waende" }),
	  "Du tastest die Waende nach Forscherpunkten ab, kannst aber "
	  "keine entdecken.");

	AddDetail( ({ "forscherpunkte", "punkte" }),
	  "Nichts zu finden an den Waenden!");

	AddDetail( ({ "decke" }),
          "Die ist irgendwo ueber Dir. Von hier aus kannst Du sie weder "
 	  "sehen noch erreichen.");

	AddDetail( ({ "boden" }),
          "Der Boden ist so toll poliert, dass Du sogar fast Dein "
          "Spiegelbild erkennen kannst. Einige Tapser irritieren Dich.");

	AddDetail( ({ "tapser" }),
	  "Das sind wohl Fingerabdruecke.");

	AddDetail( ({ "fingerabdruecke", "abdruecke" }),
	  "Tatsaechlich! Du erkennst deutlich ein paar Fingerabdruecke. "
  	  "Sie stammen wohl von einer recht grossen Hand. ");

        AddDetail( ({ "hand" }),
	  "Die Fingerabdruecke stammen wohl von einer recht grossen Hand. "
	  "Mehr kannst Du leider nicht erkennen.");

        AddDetail( ({ "trollhand" }),
          "Hier ist sie nicht. Aber vielleicht woanders?!");		


//SMELLS

	AddSmell( ({ "geruch" }),
	  "Irgendwie suesslich! Er kommt aus Nordosten!");

	AddSmell( ({ "blut" }),
	  "Definitiv Blut, ja!");

//SOUNDS

	AddSound(DEFAULT_SOUND,
           "Im Nordosten hoerst Du manchmal ein leises Kratzen.");

	AddSound( ({ "kratzen", "nordosten" }),
	   "*kratz* *kratz*\n"
	   "Es klingt fast so, als wuerde jemand mit seinen "
	   "Fingernaegeln klackern.");

	AddSound( ({ "naegel", "fingernaegel", "naegeln", "fingernaegeln" }),
	   "Ein sehr unangenehmes Geraeusch!");

	AddSound( ({ "geraeusch" }),
	  "Es kommt aus Nordosten.");

	AddSound( ({ "nordosten" }),
	  "Du kannst ja einmal nachschauen gehen!");


}

