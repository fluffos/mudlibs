//Shudde-M'ell, der ewig Eingegrabene und Herrscher ueber die Erde und 
//die finsteren Reiche der Hoehlen.


// hab ich heute schon erwaehnt, dass ich amazoras files nicht mag?! ;)


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"


int anz_shudde;

void reset()
{
	::reset();
	anz_shudde = 1;
}



void create()
{

  	::create();
	anz_shudde = 1;
	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG, "Du stehst im Saeulengang eines grossen "
	  "Tempels. Rechts und links von Dir verlaufen sich die "
	  "Saeulen hoch oben im Nichts. Nach Sueden fuehrt der Weg "
	  "zum Eingang der Tempelanlage, waehrend Du weiter noerdlich "
	  "tiefer in dieses hoehlenartige Gebilde vordringen kannst. Auf dem "
	  "Boden faellt Dir eine sonderbare Malerei auf, die "
	  "eine haessliche Fratze zeigt. ");
	SetProp(P_LIGHT, 0);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );
	SetProp(P_INDOORS, 1);

	AddExit( "norden", ROOM "room_x1");
	AddExit( "sueden", ROOM "eingang");



/*	
	
Wir klammern das Tor mal aus weil ich sonst im Sueden ne D_TESTFUNC glaub ich
brauche, sonst lasst Yogsothoth einen mit Tor naemlich durch.
Ist aber auch wurscht - war nur ne Anmerkung am Rande :)
	
	NewDoor( "sueden", ROOM "eingang", ({"tor", "steintor",
		"steinernes tor" }),
	({ D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
	D_NAME, "steinerne Tor",
	D_GENDER, NEUTER,
	D_SHORT, "Im Sueden befindet sich ein %ses Tor aus festem Stein.",
	D_LONG, "Ein grosses steinernes Tor, das Dich daneben ziemlich "
		"klein erscheinen laesst. Man muss sicherlich sehr viel "
		"Kraft aufwenden, um es zu bewegen. ",
	D_MSGS, ({ "nach Sueden", "geht", "kommt herein" }), 
	D_OPENMSG, ({ "Du stemmst Dich mit aller Wucht gegen das Tor - "
			   	"langsam oeffnet es sich.",
				"Das Tor wird von %s langsam geoeffnet.",
				"Das Tor wird langsam geoeffnet." }),
	D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du das Tor.",
			  	"Mit einem lauten Rumms schliesst %s das Tor.",
				" wird mit einem lauten RUMMS geschlossen." }),
	D_RESET_CLOSEMSG, " schliesst sich ploetzlich von selbst.\n" }) );
	
*/


//DETAILBEGINN


	AddDetail( ({ "clementine" }),
	  "Clementine hat diese heiligen Hallen hier erschaffen und ist "
	  "schon total angepisst.");

	AddDetail( ({ "boden" }),
	  "Der Boden besteht hier aus festem schwarzen Stein.");

	AddDetail( ({ "stein" }),
	  "Der Stein ist fest (oh Wunder, oh Wunder) und schwarz.");

	AddDetail( ({ "wunder" }),
	  "Es geschehen auch hier noch Wunder. Man muss nur ganz fest "
	  "daran glauben.");

	AddDetail( ({ "boden" }),
	  "Am Boden siehst Du eine Malerei die eine haessliche Fratze zeigt. "
	  "Richtig zum Fuerchten!");

	AddDetail( ({ "fuerchten", "furcht" }),
	  "Die Fratze ist so richtig haesslich!");

	AddDetail( ({ "fratze" }),
	  "Ein seltsames angsteinfloessendes Etwas lacht Dir vom Boden "
	  "entgegen.");

	AddDetail( ({ "etwas" }),
	  "Ob das Shudde-M'ell ist, der ewig Eingegrabene und Herrscher "
	  "ueber die Erde und die finsteren Reiche der Hoehlen?");

	AddDetail( ({ "shudde", "shudde-mell", "mell", "m'ell", 
		      "shudde-m'ell", "alter", "grosser alter" }),
	  "Shudde-M'ell gehoert zu den Grossen Alten. Wenn die Zeit "
	  "reif ist werden sie einen Weg finden um auf die Erde "
	  "zurueckzukehren.");

	AddDetail( ({ "erde" }),
	  "Die Alten werden irgendwann eine Gelegenheit finden um hier her " 
	  "auf die Erde zurueckzukehren.");

	AddDetail( ({ "alte", "grosse alte" }),
          "Furchteinfloessende Geschoepfe, die nicht von dieser Welt "
	  "stammen.");

	AddDetail( ({ "geschoepfe" }),
	  "Graessliche Kreaturen, denen Du nicht begegnen willst.");

	AddDetail( ({ "kreatur", "kreaturen" }),
	  "Glaub mir, Du willst sie nicht sehen!");

	AddDetail( ({ "welt" }),
	  "Deine Welt ist das Silberland, das solltest Du aber nach "
	  "1Mio Untersuchungen von Details wissen.");

	AddDetail( ({ "untersuchungen", "untersuchen" }),
	  "Das Untersuchen von Details macht Dir hier keinen Spass. "
	  "Schau lieber, dass Du hier raus kommst.");

	AddDetail( ({ "details", "detail" }),
	  "Ein Detail - viele kleine Details. Als Gesamtbild ergibt das "
	  "dann einen wundervollen Raum.");

	AddDetail( ({ "raum" }), QueryProp(P_INT_LONG));

	AddDetail( ({ "gesamtbild" }),
	  "Der Raum als Gesamtbild gesehen ist natuerlich wundervoll "
	  "da er von mir kommt :)");

	AddDetail( ({ "spass" }),
	  "Weiterforschen macht Dir hier wirklich keinen Spass mehr.");

	AddDetail( ({ "forschen", "weiterforschen" }),
	  "Ja genau, geh weiterforschen, aber entweder nach Norden oder "
	  "nach Sueden.");

	AddDetail( ({ "norden", "sueden" }),
	  "Der Weg fuehrt von Norden nach Sueden, oder auch umgekehrt.");

	AddDetail( ({ "weg" }),
	  "Eigentlich ist es kein Weg. Aber eine andere Moeglichkeit als nach "
	  "Norden oder Sueden zu gehen hast Du hier einfach nicht.");

	AddDetail( ({ "moeglichkeit" }),
	  "Keine andere da!");

	AddDetail( ({ "silberland" }),
	  "Oder kurz SL.");

	AddDetail( ({ "sl" }),
	  "Ist eine Abkuerzung.");

	AddDetail( ({ "abkuerzung" }),
	  "Du solltest weniger Sinnloses untersuchen!");

	AddDetail( ({ "sinnloses" }),
	  "Mach mal was Produktives!");

	AddDetail( ({ "produktives" }),
	  "Tanz fuer mich ;)");

	AddDetail( ({ "hoehlen", "hoehle" }),
	  "Der Tempel wirkt ein wenig wie eine Hoehle.");

	AddDetail( ({ "eingegrabener", "eingegrabene", "herrscher" }),
	  "Shudde!");

	AddDetail( ({ "reiche", "reich" }),
	  "Shuddes Reich sind die Hoehlen und die Erde.");

	AddDetail( ({ "gelegenheit" }),
	  "Sie werden eine finden...");

	AddDetail( ({ "zeit" }),
	  "Die Zeit ist kostbar! Geniesse alles, solange Du noch kannst.");

	AddDetail( ({ "tempel", "tempels" }),
	  "Du befindest Dich mitten in einem Tempel!");

	AddDetail( ({ "tempelanlage", "anlage" }),
	  "All das hier ist Teil der Tempelanlage.");

	AddDetail( ({ "teil" }),
	  "Ein Stueck davon!");

	AddDetail( ({ "stueck" }),
	  "Alles hier gehoert zu der Tempelanlage.");

	AddDetail( ({ "wand", "waende" }),
	  "Die Waende sind aus Stein. Davor sind die Saeulen errichtet, "
	  "die scheinbar hoch oben irgendwo eine Decke stuetzen.");

	AddDetail( ({ "saeulen", "saeule" }),
	  "Rechts und links von Dir ragen sie hoch zur Decke.");

	AddDetail( ({ "decke" }),
	  "Erkennen kannst Du die Decke nicht. Sie ist einfach zu hoch "
	  "oben.");

	AddDetail( ({ "saeulengang", "gang" }),
	  "Genau da stehst Du grad.");

	AddDetail( ({ "eingang" }),
	  "Er befindet sich suedlich von hier.");

	AddDetail( ({ "nichts" }),
	  "Die Saeulen verlaufen sich hoch oben im schwarzen Nichts. "
	  "Wie der Name Nichts schon sagt, kannst Du hier wirklich "
	  "nichts erkennen.");

	AddDetail( ({ "name" }),
	  "NICHTS! Sag mal bist Du begriffsstutzig?");

	AddDetail( ({ "gebilde" }),
	  "Der Tempel wirkt auf Dich ein wenig wie eine Hoehle.");

	AddDetail( ({ "malerei" }),
	  "Die Malerei auf dem Boden sieht grauenvoll aus. Eine eklige "
	  "Fratze grinst Dir daemonisch entgegen.");

//SOUNDS

	AddSound(DEFAULT_SOUND,
	  "Aus dem Norden dringen gequaelte Schreie an Dein Ohr.");

	AddSound( ({ "schrei", "schreie" }),
	  "Irgendjemand schreit hier gequaelt!");

	AddSound( ({ "irgendjemand", "jemand" }),
	  "WUAAAAAAAAAAAAAAAAAAAAAAH!");

	AddSound( ({ "ohr" }),
	  "Dein Ohr klingt echt gut...");

	AddSound( ({ "norden" }),
	  "Gequaelte Schreie hoerst Du aus noerdlicher Richtung.");

	AddSound( ({ "noerdliche richtung", "richtung" }),
 	  "HKRALKAJLAKSJDLKAJLKJ.");

//SMELLS

	AddSmell(DEFAULT_SMELL,
	  "Es riecht nach Erde und Moder.");

	AddSmell( ({ "erde" }),
	  "Es riecht hier nach feuchter Erde. Woher das wohl kommt?");

	AddSmell( ({ "moder" }),
	  "Igitt! Scheinbar wurde hier schon lange nicht mehr gelueftet.");

	
//COMMANDS

	AddCmd( ({ "tanz", "tanze" }), "c_tanzen");
	AddCmd( ({ "glaub", "glaube" }), "c_glauben");

}

int c_tanzen(string str)
{
	write("Du tanzt fuer Clementine!\n"
	      "Clementine bedankt sich aus der Ferne.\n");
	WLOG(LOG "tanz", "tanzt fuer mich");
	return 1;
}


int c_glauben(string str)
{
	if(str != "an wunder" &&
	   str != "an ein wunder" )
	{
		notify_fail("Woran moechtest Du glauben?\n");
		return 0;
	}
	if(anz_shudde<1)
	{
		write(BS("Du glaubst ganz fest an ein Wunder... doch "
			"irgendwie passiert rein gar nichts."));
		return 1;
	}
	else
	{
		write(BS("Du glaubst ganz fest an ein Wunder und fuehlst "
			"Dich gleich besser."));
		say(CTPN+ " glaubt noch an Wunder.\n");
		TP->heal_self(130);
		anz_shudde--;
		return 1;
	}
}



