
// hastur herr der winde Lloigor, "Der Windschreiter", ist - neben Hastur - Herrscher über die Winde. Er "reitet" dabei auf den kosmischen Winden von Ort zu Ort 

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"


int anz_hastur;

void reset()
{
	::reset();
	anz_hastur = 1;
}

void create()
{

  	::create();
	anz_hastur = 1;
	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG, 
		"Hoch ueber Dir verlaeuft sich die Decke im schwarzen Nichts. "
		"Duester und erdrueckend wirken die Waende aus "
		"Lavagestein, kein einziger Laut ist zu hoeren. Nur manchmal "
		"streift ein eisiger Windhauch Deinen Koerper, und laesst Dich "
		"zusammenzucken. An der Westwand steht ein kleiner Schrein, "
		"in ihm ein Bildnis einer Kreatur, der Du lieber nicht "
		"begegnen moechtest. Durch einen steinernen Bogen im Osten "
		"kommst Du wieder in den Saeulengang. ");
	SetProp(P_LIGHT, 0);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);

	AddExit( "osten", ROOM "room_x4");


// DETAILS

	AddDetail( ({ "windhauch", "hauch", "wind" }),
	  "Manchmal streift ein eisiger Windhauch Deinen Koerper. Unheimlich "
	  "und gruselig, als ob Hastur jeden Moment auftauchen koennte.");

	AddDetail( ({ "hastur" }),
	  "Hastur, einer der Herrscher der Winde. Erbarmungslos sein Wesen, "
	  "grauenvoll seine Gestalt. Mit ihm ist nicht zu spassen!");

	AddDetail( ({ "bildnis", "bild" }),
	  "Das Bildnis im Schrein zeigt eine gigantische Kreatur von "
          "oktopoider Gestalt. Furchterregend und grauenvoll! ");

	AddDetail( ({ "bogen" }),
	  "Durch den Bogen aus Stein gelangst Du wieder in den Saeulengang.");

	AddDetail( ({ "saeulengang" }),
	  "Osten!");

	AddDetail( ({ "gang" }),
	  "Meinst Du den Saeulengang?");

	AddDetail( ({ "koerper" }),
	  "Ist noch alles dran?");

	AddDetail( ({ "wesen" }),
	  "Hastur kennt kein Erbarmen. Zeig also bloss keine Schwaeche "
          "falls Du einen Kampf mit ihm austragen moechtest.");

	AddDetail( ({ "erbarmen" }),
	  "Es ist keines vorhanden.");

	AddDetail( ({ "schwaeche", "schwaechen" }),
	  "Schwaechen hast Du ja so einige... sieh Dich mal an! "
	  "Wichtig ist es, Hastur Deine Schwaechen nicht bemerken zu lassen.!");

	AddDetail( ({ "osten" }),
	  "Osten ist im Osten und Norden ist im Norden und Westen ist im "
  	  "Westen und Sueden ist im Suedwesten.");

	AddDetail( ({ "norden" }),
	  "Norden ist im Norden.");

	AddDetail( ({ "westen" }),
	  "Westen ist im Westen.");

	AddDetail( ({ "sueden" }),
	  "Sueden ist im Sueden.");

	AddDetail( ({ "suedwesten" }),
	  "Im Suedwesten scheint das Lavagestein seltsame Kratzspuren "
          "aufzuweisen.");

	AddDetail( ({ "kratzspuren", "spuren", "kratzer" }),
	  "Das schwarze Lavagestein im Suedwesten weist einige Kratzspuren "
  	  "auf... ob sie eine tiefere Bedeutung haben?");

	AddDetail( ({ "bedeutung" }),
	  "Vielleicht solltest Du die Kratzspuren einmal genauer "
  	  "untersuchen.");

	AddDetail( ({ "kratzspuren genauer", "kratzspuren genau", 
			"spuren genauer", "spur genauer", "spuren genau", 
			"spur genau" }),
	  "Vielleicht solltest Du sie mal ertasten!");

// ertaste kratzspuren -> geheimer raum als geist rein belohnung oder so

	AddDetail( ({ "westwand" }),
	  "An der Westwand ist ein Schrein aufgebaut.");

	AddDetail( ({ "waende", "wand" }),
	  "Welche Wand meinst Du genau?");

	AddDetail( ({ "schrein" }),
	  "Der Schrein wurde an der Westwand errichtet. Er ist nicht besonders "
          "gross, dennoch kann man das Bildnis in der Mitte gut erkennen. "
	  "Unter dem Bild befindet sich auch eine Inschrift. ");

        AddDetail( ({ "inschrift" }),
	  "Du kannst sie lesen!");

	AddReadDetail( ({ "inschrift" }),
	  "+++++++++++++++++++++++++++++++++++\n"
  	  "|Er, der nicht genannt werden darf|\n"
	  "+++++++++++++++++++++++++++++++++++\n");

	AddDetail( ({ "mitte" }),
	  "In der Mitte des Schreins ist ein Bildnis einer zutiefst "
	  "grauenvollen Kreatur.");
		

	AddDetail( ({ "kreatur" }),
	  "Furchterregend und abstossend!");

        AddDetail( ({ "gestalt" }),
	  "Eine furchteinfloessende Gestalt, bei der alleine das Aussprechen "
	  "ihres Namens Verderben bringt. ");

	AddDetail( ({ "verderben" }),
	  "Du solltest Hastur nicht rufen wenn Dir Dein Leben lieb ist...");

	AddDetail( ({ "namen", "name" }),
	   "Hastur, Herrscher der Winde, Gott der Schaefer.");

	AddDetail( ({ "gott", "goetter" }),
	   "Es gibt unzaehlige Goetter - meinst Du einen bestimmten?");

	AddDetail( ({ "woody" }),
	   "Auch Woody ist ein Gott - allerdings etwas weniger "
	   "furchteinfloessend als Hastur.");

	AddDetail( ({ "herrscher" }),
	   "Hastur ist einer der Herrscher der Winde! Spuerst Du denn nicht "
	   "den eisigen Hauch, der hier weht?");

	AddDetail( ({ "ruecken", }),
	   "Brrrrr........");

	AddDetail( ({ "winde", "wind" }),
	   "Der Wind kann oft ein unberechenbarer Gegner sein.");

	AddDetail( ({ "gegner" }),
   	   "Suchst Du denn nach einem Gegner?");

	AddDetail( ({ "kampf", "kaempfe" }),
	   "In diesem Raum wurden scheinbar schon einige Kaempfe "
   	   "ausgefochten. Die blutigen Spritzer auf dem Boden lassen "
	   "das zumindest erahnen."); 

	AddDetail( ({ "boden" }),
	   "Der Boden unter Dir wirkt trotz des kalten Steins irgendwie "
	   "marmoriert. Vielleicht liegt das aber auch nur an den "
	   "unzaehligen Blutspritzern die ihn verzieren.");

	AddDetail( ({ "spritzer", "blut", "blutspritzer" }),
	   "Unter Deinen Fuessen wird der Boden von blutigen Spritzern "
	   "beinahe durchtraenkt. ");

	AddDetail( ({ "lavagestein", "gestein", "lava" }),
	   "Kalt und erdrueckend wirken die Waende aus Lavagestein. Beinahe "
	   "so, als wuerden sie aus einer anderen Dimension stammen. ");

	AddDetail( ({ "dimension" }),
	   "Dich schaudert.");

	AddDetail( ({ "stein" }),
	   "Kalter, lebloser und dunkler Stein.");

	AddDetail( ({ "fuesse" }),
	   "Deine Fuesse stehen in Blut. Vielleicht ist es noch warm?");

	AddDetail( ({ "moment" }),
	   "Es war nur der Wind...");

	AddDetail( ({ "raum", "raeume" }),
	   "Du stehst in einem der Gebetsraeume der Shogotten.");

	AddDetail( ({ "shogotte", "shogotten" }),
	   "Gerade keine hier.");

	AddDetail( ({ "gebetsraeume", "gebetsraum" }),
	   "In diesem hier bringen die Shogotten Opfer fuer Hastur.");

	AddDetail( ({ "opfer" }),
	   "Vielleicht bist Du das naechste?");

	AddDetail( ({ "laut" }),
	   "Keiner zu hoeren, und zu untersuchen schon gar nicht.");

	AddDetail( ({ "schaefer" }),
	   "Hier ist weder ein Schaefer, noch Schafe.");

	AddDetail( ({ "schafe" }),
	   "Keine zu sehen.");

	AddDetail( ({ "decke" }),
	   "Die Decke scheint so hoch ueber Dir zu sehen, dass Du sie von "
	   "hier aus einfach nicht erkennen kannst. Es scheint als wuerde sie "
	   "im Nichts enden.");

	AddDetail( ({ "nichts" }),
	   "Das grosse leere Nichts scheint ueber Dir zu schweben und die "
	   "Decke zu verschlucken.");

	AddDetail( ({ "leben" }),
	   "Noch ist es ja vorhanden.");

	AddDetail( ({ "aussprechen" }),
	   "Das simple Aussprechen des Namens Hastur wird Dir vermutlich "
	   "kein Verderben bringen, aber rufen wuerde ich ihn an Deiner "
	   "Stelle lieber nicht. ");

	AddDetail( ({ "stelle" }),
	   "Ob diese Stelle ein guter Ort ist um zu sterben?");

	AddDetail( ({ "ort" }),
	   "Du willst eigentlich hier ganz schnell weg.");

	AddDetail( ({ "saeulen", "saeule" }),
	   "Die Saeulen stuetzen den Bogen durch den Du nach Osten kommst.");

	AddSmell(DEFAULT_SMELL, "Es riecht leicht suesslich. ");

	AddSmell( ({ "blut" }),
	   "Ob der leichte Hauch des Todes Deine Nasenspitze hier kitzelt?");

	AddSmell( ({ "tod" }),
	   "Den Tod riechen? Weiss nicht ob ihm das recht ist.");

	AddSmell( ({ "nasenspitze", "spitze", "nase" }),
           "Hatschiiii.");

	AddSmell( ({ "hauch" }),
	   "Ein kuehler Hauch weht hier, doch warum hoert man keinen Laut?");

	AddSound(DEFAULT_SOUND, "Nichts zu hoeren. Absolut gar nichts.");

	AddSound( ({ "windhauch", "hauch", "wind" }),
	   "Selbst der Wind ist nicht zu hoeren, obwohl Du definitiv davon "
	   "ueberzeugt bist, dass er weht.");


	AddCmd( ({ "ruf", "rufe" }), "c_rufen");
	AddCmd( ({ "spuer", "spuere" }), "c_spueren");
	AddCmd( ({ "greife", "greif" }), "c_angreifen");

}

int c_rufen(string str)
{

        if(str != "hastur" &&
           str != "nach hastur" )
        {
                notify_fail("Wen moechtest Du rufen?\n");
                return 0;
        }
        if(anz_hastur < 1)
        {
                write(BS("Du fasst Deinen Mut zusammen und rufst nach Hastur! "
                         "Nichts passiert."));
                return 1;
        }
        else
        {
                write("Ein Windstoss reisst Dich fast zu Boden!!\n"
                        "Irgendetwas hat sich veraendert!\n");
                         
                say(CTPN + " fordert Hastur heraus.\n");
                
                TP->heal_self(200);

                anz_hastur--;
                return 1;
        }       
	
}


int c_spueren(string str)
{
	if(str != "eisigen hauch"  &&
	   str != "hauch"          &&
	   str != "eishauch"       )
	{
		notify_fail("Was moechtest Du spueren?\n");
		return 0;
	}
	else
	{
		write(BS("Dir laeuft es kalt den Ruecken hinunter."));
		return 1;
	}
}

int c_angreifen(string str)
{
	if(str != "blut an")
	{
		notify_fail("Was moechtest Du angreifen?\n");
		return 0;
	}
	else
	{
		write(BS("Noch warm..."));
		return 1;
 	}
}
