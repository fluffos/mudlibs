//Yibb, Tsathoggua, Shodagoi


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"

int anz_sho = 1;
int anz_tsa = 1;
int anz_yibb = 1;

void reset()
{
	::reset();
	anz_sho = 1;
	anz_tsa = 1;
	anz_yibb = 1;
}

void create()	
{

  	::create();
	anz_sho = 1;
	anz_tsa = 1;
	anz_yibb = 1;
	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG, 
		"Drei Betten, aus schlichtem Holz gezimmert, stehen an der "
		"Wand, und sehen nicht unbedingt sehr gemuetlich aus. "
		"Daneben befindet sich ein Schrank, an dem Du weder Schloss noch "
		"Knauf erkennen kannst. Auf einem Tisch in der Mitte des Raumes "
		"liegt eine Schale, aus der Rauch aufsteigt. Seltsame Daempfe "
		"huellen den Raum ein, und scheinen Dein Denkvermoegen ausser "
		"Kraft zu setzen. ");
	SetProp(P_LIGHT, 0);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);

	AddExit( "westen", ROOM "room_x5");


	AddDetail( ({ "schloss", "knauf" }),
		"Du kannst weder Schloss noch Knauf an dem Schrank erkennen. Doch "
		"irgendwie muss er ja zu oeffnen sein.");

	AddDetail( ({ "schrank" }),
		"Ein schlichter Schrank aus Holz steht an der Wand. Er hat weder "
		"Schloss noch Knauf und strahlt etwas Boeses aus.");

	AddDetail( ({ "boeses", "boese" }),
		"Du weisst nicht genau was es ist, aber irgendetwas laesst Dich "
		"sehr misstrauisch auf den Schrank reagieren.");

	AddDetail( ({ "misstrauen" }),
		"Ein gesundes Misstrauen ist in manchen Lagen nicht falsch.");

	AddDetail( ({ "lage", "lagen" }),
		"Du hast Dich schon viel zu oft in sehr unguenstige Lagen "
		"manoevriert.");

	AddDetail( ({ "tisch" }),
		"Der Tisch in der Mitte des Raumes ist genauso wie die Betten und "
		"der Schrank schlicht aus Holz gehalten. Auf ihm befindet "
		"sich eine Schale.");

	AddDetail( ({ "holz" }),
		"Schlichtes Holz von dem Du die Herkunft nicht erkennen kannst.");

	AddDetail( ({ "herkunft" }),
		"Das Holz hat unbekannte Herkunft. Aus ihm bestehen die Betten, der "
		"Schrank und der Tisch.");

	AddDetail( ({ "schale", "steinschale" }),
		"Eine Schale aus Stein steht auf dem Tisch. In ihrem Inneren liegt "
	        "eine gruene Masse von der Rauch aufsteigt.");

	AddDetail( ({ "gruene masse", "masse" }),
		"Von der Masse steigt Rauch auf. Sie selbst scheint schleimig und "
		"glitschig zu sein. Genaueres weisst Du aber erst wenn Du Dich traust "
		"sie anzufassen.");

	AddDetail( ({ "rauch" }),
		"Der Rauch vernebelt Deinen Geist. Ob es gesund ist sich laenger "
		"als noetig in diesem Raum aufzuhalten?");

	AddDetail( ({ "gesund" }),
		"Das wirst Du dann ja sehen.");

	AddDetail( ({ "daempfe", "dampf" }),
		"Die Daempfe die aus der Schale aufsteigen scheinen Dein "
		"Denkvermoegen ausser Kraft zu setzen. ");

	AddDetail( ({ "sinne", "sinn" }),
		"Weisst Du denn noch, was Du hier eigentlich suchst?");


	AddDetail( ({ "boden" }),
		"Der Boden ist schlicht und ebenfalls aus Holz. Du kannst "
		"keine Besonderheiten erkennen.");

	AddDetail( ({ "besonderheiten" }),
		"Doch halt, was ist da? Ein grosses Monster kommt und beisst Dir "
		"in den Popo.");

	AddDetail( ({ "popo" }),
		"Aua! :)");

	AddDetail( ({ "monster" }),
		"Wenn ich sag es gibt keine Besonderheiten, dann sind auch keine da. "
		"Verstanden?");

	AddDetail( ({ "keine besonderheiten" }),
		"Keine *fuchtel*");

	AddDetail( ({ "kasten" }),
		"Schrank!");

	AddDetail( ({ "decke" }),
		"Die Decke hier besteht ebenfalls aus Holz. Sie ist um einiges "
		"niedriger hier als in den anderen Raeumen.");

	AddDetail( ({ "raum" }), QueryProp(P_INT_LONG));

	AddDetail( ({ "raeume" }),
		"Du musst Dich schon bewegen um andere Raeume hier zu sehen.");

	AddDetail( ({ "waende", "wand" }),
		"Die Waende bestehen alle aus schlichtem Stein. Eine wirklich "
		"karge Behausung!");

	AddDetail( ({ "behausung" }),
		"Du kannst Dir nicht vorstellen in so einem Zimmer zu leben.");

	AddDetail( ({ "zimmer" }),
		"Schlicht - 3 Betten, ein Tisch, ein Schrank.");

	AddDetail( ({ "shogotten", "shogotte" }),
		"Keine zu sehen.");

	AddDetail( ({ "stein" }),
		"Die Waende bestehen hier aus schlichtem Stein. Keine Furchen, keine "
		"Kratzer - alles wirkt recht steril.");

	AddDetail( ({ "furchen", "kratzer" }),
		"Da ist wirklich nichts zu sehen.");

	AddDetail( ({ "nichts" }),
		"Das grosse Nichts wird Dich irgendwann verschlingen. Aber das "
		"weisst Du ja selbst.");

	AddDetail( ({ "inneres", "innerem", "innere" }),
		"Im Inneren der Schale befindet sich eine eklige gruene glitschige "
		"grausliche, stinkende, furchtbare, total grindige Masse.");

	AddDetail( ({ "trick" }),
		"Irgendeinen Trick muss es ja geben um den Schrank zu oeffnen. "
		"Vielleicht solltest Du Dich einfach etwas entspannen, dann kommen "
		"die guten Ideen ganz von selbst.");

	AddDetail( ({ "idee", "ideen" }),
		"Gute Ideen kommen immer dann wenn man sich einfach genug "
		"entspannen kann.");	

	AddDetail( ({ "mitte" }),
		"In der Mitte des Raumes steht ein Tisch auf dessen Mitte sich "
		"wiederum eine Schale befindet.");

	AddDetail( ({ "geist" }),
		"Der Rauch ist sicherlich nicht gesund fuer Deinen Geist. ");

	AddDetail( ({ "denkvermoegen" }),
		"Dein Denkvermoegen war ohnehin schon nicht das Beste - vielleicht "
		"wird es nun noch mehr in Mitleidenschaft gezogen.");

	AddDetail( ({ "beste" }),
		"Vielleicht waere es das Beste den Raum einfach zu verlassen?");

	AddDetail( ({ "mitleidenschaft" }),
		"Du vermutest, dass hier nicht nur Dein Denkvermoegen in "
		"Mitleidenschaft gezogen werden kann. ");

	AddDetail( ({ "betten", "bett" }),
		"Drei Betten stehen an der Wand. Sie sind schlicht aus Holz gehalten. "
		"In jedem von ihnen befindet sich eine Wolldecke - sonst sind "
		"sie leer.");

	AddDetail( ({ "wolldecke", "wolldecken", "decken" }),
		"In jedem der Betten liegt eine graue Wolldecke. Irgendwie kommen "
		"Dir die Betten schon recht seltsam vor. Warum ausgerechnet drei "
		"Betten hier stehen?! Fuer die Shogotten sind sie sicherlich "
		"nicht gedacht.");

	AddDetail( ({ "graue decken", "graue wolldecken", "wolle",
		"graue wolldecke", "graue decke"}),
		"Vielleicht solltest Du die Decken mal beiseite schieben?");

	AddDetail( ({ "namen" }),
		"Es waren Namen, die mit Blut auf die Betten geschrieben wurden: "
		"Yibb-Tsstl, Tsathoggua, Shodagoi.");

	AddDetail( ({ "yibb-tsstl", "yibb", "tsathoggua", "shodagoi" }),
		"Grosse Alte... ob sie hier zusammenkommen? ");

	AddDetail( ({ "alte", "grosse alte" }),
		"Ein Schauer laeuft Dir den Ruecken hinunter.");

	AddDetail( ({ "schauer", "ruecken" }),
		"Aus der Ferne hoerst Du ein dumpfes Grollen.");

	AddDetail( ({ "ferne" }),
		"Da musst Du schon selbst nachsehen!");

	AddDetail( ({ "grollen", "dumpfes grollen" }),
		"Untersuchen kannst Du es nicht.");
	
	AddDetail( ({ "kraft" }),
		"Als Du so ueber Deine Kraft sinnierst faellt Dir eine kleine Spinne "
		"auf, die in der Ecke sitzt.");

	AddDetail( ({ "ecke" }),
		"In einer Ecke sitzt eine kleine schwarze Spinne, die dort scheinbar "
		"ihr Zuhause gefunden hat.");

	AddDetail( ({ "zuhause" }),
		"Die Spinne hat vermutlich hier ihr Zuhause gefunden. Der bestialische "
		"Gestank der von den Daempfen kommt scheint sie nicht zu stoeren.");

	AddDetail( ({ "gestank" }),
		"Riechen!");

	AddDetail( ({ "spinne" }),
		"Die Spinne ist klein und schwarz. Und bei naeherer Betrachtung "
		"faellt Dir auf, dass sie 8 Beine hat.");

	AddDetail( ({ "beine" }),
		"Alle bis auf ein Bein sind gleich lang.");

	AddDetail( ({ "bein" }),
		"Ein Bein der Spinne ist kuerzer als die anderen sieben. "
		"Vielleicht kann man es ja ausrupfen?");

	AddDetail( ({ "sadist" }),
		"Schaem Dich!");

	AddDetail( ({ "familie" }),
		"Tatsaechlich! Die kleine Spinne hat noch 2 kleine Spinnenbabys im "
		"Schlepptau.");

	AddDetail( ({ "schlepptau" }),
		"Im Schlepptau der Spinne befinden sich noch 2 kleine Spinnenbabys.");

	AddDetail( ({ "spinnenbabys", "babys" }),
		"Suesse kleine Spinnenbabys - ebenfalls mit 8 kleinen Beinchen.");

	AddDetail( ({ "beinchen", "spinnenbeinchen" }),
		"Kleine zierliche Beinchen... wie so ein kleines Spinnenbeinchen "
		"wohl schmeckt?");

	AddDetail( ({ "bonbon" }),
		"Wo ist eines?");

	AddDetail( ({ "betrachtung" }),
		"Ja, Du weisst wie man die Spinne naeher betrachtet!");

//SMELLS	

	AddSmell(DEFAULT_SMELL, "Es stinkt bestialisch!");

	AddSmell( ({ "gestank" }),
		"Wirklich ekelerregend. Dir wird ganz uebel. Eine Mischung "
		"aus verwesenden Koerperteilen vermischt sich mit dem Duft "
		"irgendwelcher Exkremente.");

	AddSmell( ({ "koerperteile", "teile" }),
		"Dir wird schlecht.");

	AddSmell( ({ "exkremente" }),
		"Wirklich grauslich! Aber wusstest Du dass exkrementieren ein "
		"anderes Wort fuer stuhlen ist? Du darfst raten woher das Wort "
		"Stuhl kommt.");

	AddSmell( ({ "wort", "woerter", "stuehle", "stuhl" }),
		"Du riechst weder Woerter noch Stuehle.");

	AddSmell( ({ "dampf", "daempfe", "rauch" }),
		"Er stinkt bestialisch und scheint Deine Sinne zu vernebeln.");

	AddSmell( ({ "mischung", "duft" }),
		"Es stinkt!!!");

	AddSmell( ({ "sinne" }),
		"Du bist Dir nicht mehr ganz sicher, was Du eigentlich hier willst.");
			
//SOUNDS
	
	AddSound(DEFAULT_SOUND, "Aus der Ferne hoert man etwas Dumpfes - hier ist "
	 	"es hingegen fast lautlos.");

	AddSound( ({ "dumpfes" }),
	 	"*brrrrrrrrrrrrrrrrrrrrrrrrrrm*");

	AddSound( ({ "ferne" }),
		"Aus der Ferne hoert man dumpfe Geraeusche.");

	AddSound( ({ "geraeusche", "geraeusch" }),
		"*dmm* *bumm* *zack* *dmm*");

	AddSound( ({ "grollen", "dumpfes grollen" }),
		"*brmmmmm* *dmmmmmm* *tschawummm*");

//COMMANDS

	AddCmd( ({ "iss", "ess", "esse" }), "c_essen");
	AddCmd( ({ "kost", "koste" }), "c_kosten");
	AddCmd( ({ "rupf", "rupfe" }), "c_rupfen");
	AddCmd( ({ "tret", "tritt", "trete" }), "c_treten");	
	AddCmd( ({ "entspann", "entspanne" }), "c_entspannen");
	AddCmd( ({ "brech", "breche" }), "c_brechen");
	AddCmd( ({ "fasse", "fass" }), "c_anfassen");
	AddCmd( ({ "schieb", "schiebe" }), "c_schieben");

}	

int c_essen(string str)
{
	if(str != "verschimmeltes bonbon"  &&
	   str != "bonbon")
	{
		notify_fail("Was moechtest Du essen?\n");
		return 0;
	}
	if(anz_yibb < 1)
	{
		write(BS("Du isst das Bonbon in der Ecke." 
			"Baeh ist das ekelig!"));
		say(CTPN + " verzieht die Mundwinkel.\n");
		TP->do_damage(10);
		return 1;
	}
	else
	{
		write(BS("Du isst das Bonbon in der Ecke. Mhjam, gar nicht so "
			"schlecht."));
		say(CTPN + " mampft etwas.\n");
		TP->heal_self(150);
		anz_yibb--;
		return 1;
	}
}


int c_kosten(string str)
{
	if(str != "spinnenbeinchen"  &&
	   str != "beinchen"     )
	{
		notify_fail("Was moechtest Du hier kosten?\n");
		return 0;
	}
	else
	{
		write(BS("Ist das jetzt Dein Ernst? Iss lieber das "
			"halb verschimmelte Bonbon in der anderen Ecke."));
		return 1;
	}
}


int c_rupfen(string str)
{
	if(str != "bein aus" )
	{
		notify_fail("Was moechtest Du hier ausrupfen?\n");
		return 0;
	}
	else
	{
		write(BS("Bist Du wirklich so ein Sadist, dass Du der kleinen "
			"Spinne einfach ein Bein ausrupfen willst? Vielleicht hat sie "
			"ja Familie!!!"));
		return 1;
	}
}


int c_treten(string str)
{
	if(str != "schrank ein"  &&
	   str != "schrank"      )
	{
		notify_fail("Was moechtest Du eintreten?\n");
		return 0;
	}
	if(anz_tsa < 1)
	{
		write(BS("Du versuchst mit aller Kraft den Schrank einzutreten, "
			"doch nichts passiert."));
		return 1;
	}
	else
	{
		write(BS("Du trittst mit voller Wucht auf den Schrank ein. "
			"Kurz oeffnet er sich einen Spalt und benebelt Deine "
			"Sinne."));
		say(CTPN + " hantiert am Schrank herum.\n");
		TP->heal_self(170);
		anz_tsa--;
		return 1;
	}
}



int c_entspannen(string str)
{
	if(str != "mich" )
	{
		notify_fail("Was moechtest Du entspannen? Dich?\n");
		return 0;
	}
	else
	{
		write(BS("Du entspannst Dich ein wenig und kommst dabei auf die "
			"glorreiche Idee den Schrank einfach mit dem Fuss "
			"einzutreten."));
		say(CTPN+ " entspannt sich.\n");
		return 1;
	}
}




int c_brechen(string str)
{
	if(str != "schrank auf"  &&
	   str != "schloss auf"   )
	{
		notify_fail("Was moechtest Du hier aufbrechen?\n");
		return 0;
	}
	else
	{
		write(BS("Wie willst Du denn den Schrank aufbrechen, wenn er nicht "
			"mal ein Schloss hat? Da muss es doch einen anderen Trick "
			"geben!"));
		return 1;
	}
}

int c_anfassen(string str)
{
	if(str != "gruene masse an"  &&
	   str != "masse an"	)
	{
		notify_fail("Was moechtest Du anfassen?\n");
		return 0;
	}
	if(anz_sho < 1)
	{
		write(BS("Du fasst die eklige gruene Masse an, doch nichts passiert."));
		return 1;
	}
	else
	{
		write(BS("Als Du in die gruene eklige Masse greifst, veraendert sie "
			 "sich ploetzlich und scheint zum Leben zu erwachen."));
		say(CTPN + " befreit Shodagoi!\n");
                TP->heal_self(180); 

                anz_sho--;
                return 1;
        }       
}

				
int c_schieben(string str)
{
	if(str != "decken beiseite" &&
	   str != "wolldecken beiseite" &&
	   str != "wolldecke beiseite"  &&
	   str != "decke beiseite"      )
	{
		notify_fail("Was moechtest Du hier beiseite schieben?\n");
		return 0;
	}
	else
	{
		write(BS("Als Du die Decken beiseite schiebst, siehst Du in jedem "
			"Bett einen Namen geschrieben. Erschrocken legst Du sie "
			"wieder gerade hin."));
		say(CTPN + " fummelt an den grauen Wolldecken herum.\n");
		return 1;
	}
}

