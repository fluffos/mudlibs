
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"

int anz_az;
int anz_nya;

void reset()
{
	::reset();
	anz_az = 1;
	anz_nya = 1;

}
void create()
{

  	::create();
	anz_az = 1;
	anz_nya = 1;
	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG, 
		"Zwei riesige Gemaelde fallen Dir beim Hereinkommen sofort auf. "
		"Jedes von ihnen zeigt eine fuerchterliche Kreatur, die Dir "
		"schon beim blossen Anblick fast den Verstand raubt. In den "
		"schwarzen Steinboden wurden seltsame Zeichen eingraviert, die "
		"sich vielleicht als sehr nuetzlich erweisen koennten. Aus "
		"nordwestlicher Richtung vernimmst Du immer wieder "
		"markerschuetternde Schreie, die Dir das Blut in Deinen Adern "
		"gefrieren lassen. ");
	SetProp(P_LIGHT, 0);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);

	AddExit( "nordwesten", ROOM "room_x2");


//DETAILBEGINN

	AddDetail( ({ "zeichen" }),
		"Es scheint sich um Runen zu handeln. ");
	
	AddDetail( ({ "hereinkommen" }),
	   "Sofort sind Dir die zwei riesigen Gemaelde aufgefallen als Du "
	   "den Raum betreten hast.");

	AddDetail( ({ "raum" }), 
	   "Du stehst in einem Raum der Tempelanlage. Zwei grosse Gemaelde "
	   "prangern an der Wand vor Dir.");

	AddDetail( ({ "tempelanlage", "anlage" }),
	   "Du befindest Dich in ihr!");

	AddDetail( ({ "tempel" }),
	   "Du befindest Dich in ihm!");

	AddDetail( ({ "wand", "waende" }),
	   "Die Waende sind alle aus Stein. An der suedostlichen Wand "
	   "siehst Du die zwei grossen Gemaelde.");

	AddDetail( ({ "suedoestliche wand" }),
	   "Dort haengen die Gemaelde.");

	AddDetail( ({ "gemaelde", "bilder" }),
	   "Zwei riesige Gemaelde haengen an der suedoestlichen Wand. "
	   "Jedes von ihnen zeigt eine fuerchterliche Kreatur. ");

	AddDetail( ({ "gemaelde eins", "gemaelde 1", "erstes gemaelde" }),
	   "Das erste Gemaelde zeigt einen Daemonensultan. Das Zentrum "
	   "des Universums, das blinde Chaos auf seinem Thron inmitten "
	   "der Leere, umringt von anderen Goettern ueber die er wacht. "
	   "Darunter befindet sich eine Inschrift.");

	AddDetail( ({ "gemaelde zwei", "gemaelde 2", "zweites gemaelde" }),
	   "Das zweite Gemaelde zeigt allgegenwaertiges Chaos. Darunter "
	   "siehst Du eine Inschrift.");

	AddDetail( ({ "chaos" }),
	   "Das Chaos ist hier ueberall allgegegenwaertig!!");

	AddDetail( ({ "daemonensultan", "azathoth", "sultan", "daemon" }),
	   "Azathoth der irrsinnige Daemonensultan - die maximale "
	   "Konzentration des Chaos auf einem einzigen Punkt.");

	AddDetail( ({ "nyarlathothep" }),
	   "Nyarlathothep - das allgegenwaertige Chaos, dass sich langsam "
	   "verbreitet.");

	AddDetail( ({ "alte", "alten", "grosse alte", "grossen", "grosse" }),
	   "Meinst Du einen bestimmten der Grossen Alten?");

	AddDetail( ({ "bestimmter" }),
	   "Welchen der Grossen Alten meinst Du?");

	AddDetail( ({ "inschrift" }),
	   "Welche Inschrift moechtest Du lesen? Die erste oder die zweite?");

	AddReadDetail( ({ "inschrift" }),
	   "Moechtest Du die erste Inschrift lesen oder die zweite?");

	AddReadDetail( ({ "inschrift eins", "erste inschrift",
			  "inschrift 1"	}),
	   "**************\n"
	   "*  AZATHOTH  *\n"
	   "**************\n");

	AddReadDetail( ({ "inschrift zwei", "zweite inschrift",
			  "inschrift 2"	}),
	   "*****************\n"
	   "* Nyarlathothep *\n"
	   "*****************\n");


	AddDetail( ({ "stein" }),
	  "Der Boden, die Decke und die Waende sind allesamt aus Stein. "
	  "Kalter lebloser Stein.");

	AddDetail( ({ "thron" }),
	  "Der Thron auf dem Bild sieht ueberdimensional maechtig aus. "
	  "Er scheint von Edelsteinen bestueckt zu sein.");

	AddDetail( ({ "edelsteine", "edelstein" }),
	  "Als Du Dir den Thron naeher ansiehst, faellt Dir auf, dass die "
	  "Edelsteine auf das Gemaelde geklebt wurden. Ob man einen "
	  "herunterreissen kann?");

	AddDetail( ({ "steinboden", "boden" }),
	  "Der Boden unter Dir wurde aus Stein gefertigt. Vermutlich war der "
	  "Stein schon hier und wurde in jahrelanger Arbeit einfach "
	  "geglaettet und poliert.");

	AddDetail( ({ "arbeit" }),
	  "Ob die Shogotten diese Arbeit uebernommen haben?");

	AddDetail( ({ "shogotten", "shogotte" }),
	  "Hier sind keine Shogotten zu sehen. Aber vermutlich kommen "
	  "sie zeitweise zum Beten her.");

	AddDetail( ({ "beten" }),
	  "Als Diener der Grossen Alten benutzen die Shogotten diesen Raum "
	  "um zu beten.");

	AddDetail( ({ "diener" }),
	  "Die Shogotten sind die Diener der Grossen Alten. Die Grossen "
	  "Alten erschuffen sie zur Errichtung ihrer Staedte.");

	AddDetail( ({ "staedte" }),
	  "Die Shogotten wurden von den Grossen Alten zur Errichtung ihrer "
	  "Staedte erschaffen, da man eine kraeftige und ausdauernde "
	  "Sklavenrasse benoetigte.");

	AddDetail( ({ "sklavenrasse", "sklaven", "rasse" }),
	  "Die Shogotten!! Eine Ansammlung kuenstlich entwickeltem "
	  "Protoplasma!");

	AddDetail( ({ "protoplasma", "plasma", "ansammlung" }),
	  "Die Shogotten sind nichts als Protoplasma-Ansammlungen. "
	  "Gelartige fluessige Masse!");

	AddDetail( ({ "masse" }),
	  "Gelartig!");

	AddDetail( ({ "errichtung" }),
	  "Scheinbar haben sie auch diesen Tempel errichtet.");

	AddDetail( ({ "schreie", "schrei" }),
	  "Sehen kannst Du die Schreie nicht, aber bestimmt hoeren.");

	AddDetail( ({ "anblick" }),
	   "Grauenhafte Geschoepfe sind auf den Gemaelden abgebildet.");

	AddDetail( ({ "geschoepf", "geschoepfe" }),
	   "Sieh Dir doch die Gemaelde einfach genauer an!");

	AddDetail( ({ "kreatur", "kreaturen" }),
	   "Der blosse Anblick von soviel Haesslichkeit raubt Dir fast den "
	   "Verstand.");

	AddDetail( ({ "haesslichkeit" }),
	   "Unvorstellbar grauenhaft!");

	AddDetail( ({ "verstand" }),
	   "Du wuenscht eine Begegnung mit diesen Kreaturen nicht mal "
	   "Deinem schlimmsten Feind.");

	AddDetail( ({ "feind" }),
	   "Nicht einmal Deinem schlimmsten Feind wuenscht Du eine "
	   "Begegnung mit diesem Chaos.");

	AddDetail( ({ "begegnungen", "begegnung" }),
	   "Diese waere ein unvorstellbares Grauen fuer Deine Augen.");

	AddDetail( ({ "augen", "auge" }),
	   "Gar nicht auszudenken wie furchtbar Deine Augen dann "
	   "beleidigt waeren.");

	AddDetail( ({ "grauen" }),
	   "Absolut widerwaertig!");

	AddDetail( ({ "decke" }),
	   "Die Decke besteht aus schwarzem Stein. Finster wie die "
	   "Nacht bei Neumond.");

	AddDetail( ({ "nacht" }),
	   "Die Decke ist haesslich und schwarz wie die Nacht finster "
	   "bei Neumond.");

	AddDetail( ({ "neumond" }),
	   "Neumond = kein Mond zu sehen!");

	AddDetail( ({ "mond" }),
	   "Von hier aus kannst Du keinen Mond sehen.");

	AddDetail( ({ "runen" }),
	   "Du kannst sie lesen!");

	AddReadDetail( ({ "runen" }),
	   "Du erkennst die Rune Laguz.");

	AddDetail( ({ "laguz" }),
	   "Laguz - die Rune des Wassers... vielleicht hilft es "
	   "Laguz zu murmeln?");

	AddDetail( ({ "rune" }),
	   "Laguz.");

	AddDetail( ({ "wasser" }),
	   "Welches Wasser meinst Du?");

	AddDetail( ({ "blut", "ader", "adern" }),
	   "Das Blut in Deinen Adern stockt jedes Mal wenn Du "
	   "einen dieser Schreie vernimmst. Etwas Boeses ist hier am "
	   "Werk.");

	AddDetail( ({ "werk" }),
	   "Definitiv ist hier etwas Boeses am Werk.");

	AddDetail( ({ "boeses", "boese" }),
	   "Das Boese ist boese!!! Aber wie!!! :)");

	AddDetail( ({ "mal" }),
	   "Da! Schon wieder! ");

//SMELLS

	AddSmell(DEFAULT_SMELL,
	   "Es riecht hier nach Chaos.");

	AddSmell( ({ "chaos" }),
	   "Stickige abgestandene Luft, chaotische Zustaende...");

	AddSmell( ({ "luft", "zustaende" }),
	   "Du riechst die Luft und die Zustaende und kannst sie aber "
	   "nicht naeher beschreiben.");

//SOUNDS

	AddSound(DEFAULT_SOUND, "Aus nordwestlicher Richtung horest "
	   "Du markerschuetternde Schreie. Irgendwie gruselig! ");

	AddSound( ({ "schrei", "schreie" }),
	  "Die Schreie scheinen aus nordwestlicher Richtung zu kommen.");

	AddSound( ({ "nordwesten", "richtung" }),
	  "Aus dem Nordwesten hoerst Du Schreie.");

	AddSound( ({ "nordwestliche richtung" }),
	  "AUAAAAAAAAAAAAAAAAAAAAH!");

//COMMANDS

	AddCmd( ({ "reiss", "reisse" }), "c_reissen");
	AddCmd( ({ "murmel", "murmle" }), "c_murmeln");

}

int c_reissen(string str)
{
	if(str != "edelsteine herunter" &&
	   str != "edelstein runter"    &&
	   str != "edelstein herunter"  &&
	   str != "edelsteine runter" 	&&
	   str != "einen herunter"   	 &&
	   str != "einen edelstein runter" &&
	   str != "einen stein runter"     &&
	   str != "einen edelstein herunter" &&
	   str != "einen stein herunter"     )
	{
		notify_fail("Was moechtest Du herunterreissen?\n");
		return 0;
	}
	if(anz_az <1)
	{
		write(BS("Du versuchst einen Edelstein herunterzureissen, "
		"kannst aber keinen erreichen."));
		say(CTPN + " werkelt an einem Gemaelde herum.");
		return 1;
	}
	else
	{
		write(BS("Beim Versuch einen Edelstein herunterzureissen "
		 "durchfaehrt Dich eine angenehme Waerme."));
		say(CTPN + " sieht erholter aus.\n");
		TP->heal_self(180);
		anz_az--;
		return 1;
	}
}

int c_murmeln(string str)
{
	if(str != "laguz" )
	{
		notify_fail("Welches Wort moechtest Du murmeln?\n");
		return 0;
	}
	if(anz_nya<1)
	{
		write(BS("Du murmelst mehrmals Laguz, doch nichts passiert."));
		say(CTPN+ " murmelt etwas.\n");
		return 1;
	}
	else
	{
		write(BS("Du murmelst Laguz und fuehlst Dich gleich "
			"frisch gestaerkt."));
		say(CTPN+ " murmelt etwas Unverstaendliches.\n");
		TP->heal_self(140);
		anz_nya--;
		return 1;
	}
}

