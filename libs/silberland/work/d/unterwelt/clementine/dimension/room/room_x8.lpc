

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"

void create()
{
	::create();

	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG,
		"Du wanderst in einem schier endlos erscheinenden Gang aus "
		"pechschwarzen Saeulen. Links und rechts von Dir ragen "
		"die ueberdimensionalen Pfeiler aus Stein auf ihren imposanten "
		"Sockeln in die Hoehe, und verlaufen sich hoch ueber Dir im "
		"Nichts. Der polierte Marmor wirkt beeindruckend, strahlt er "
		"doch auch eine unglaubliche Kaelte und Bedrohung aus. Nach "
		"Nordwesten gelangst Du in einen kleineren Raum, im Suedosten "
		"siehst Du einen Brunnen. ");
	SetProp(P_LIGHT, 0);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);

	AddExit( "osten", ROOM "room_x7");
	AddExit( "suedwesten", ROOM "room_x4");
	AddExit( "nordwesten", ROOM "room_g8");
	AddExit( "suedosten", ROOM "alte");


// DETAILBEGINN

	AddDetail( ({ "nordwesten" }),
	  "Im Nordwesten ist ein kleiner Raum. Es scheint dort irgendwie "
	  "waermer als hier zu sein.");

	AddDetail( ({ "suedosten" }),
	   "Im Suedosten befindet sich ein Brunnen.");

	AddDetail( ({ "brunnen" }),
	   "Der Brunnen sieht irgendwie unheimlich aus. Naeheres erkennst "
	   "Du aber mit Sicherheit nur wenn Du nach Suedosten gehst.");

	AddDetail( ({ "naeheres" }),
	   "Von hier aus kannst Du nichts Naeheres erkennen.");

	AddDetail( ({ "sicherheit" }),
	   "Mit Sicherheit erfaehrst Du erst mehr, wenn Du auch hingehst.");

	AddDetail( ({ "boden" }),
	   "Der Boden ist aus Marmor.");

	AddDetail( ({ "marmor" }),
	   "Marmor ist ein Gestein, das aus den Mineralen Calcit, Dolomit "
	   "oder Aragonit besteht.");

	AddDetail( ({ "gestein" }),
	   "Marmor!");

	AddDetail( ({ "minerale", "calcit", "dolomit", "aragonit" }),
	   "So genau kannst Du das nicht feststellen. Schliesslich bist "
	   "Du kein Hoehlenforscher.");

	AddDetail( ({ "hoehlenforscher" }),
	   "Du zaehlst zur Gattung normaler Forscher und bist definitiv "
	   "kein Hoehlenforscher.");

	AddDetail( ({ "forscher" }),
	   "Forscher forschen. Du forscht zumindest gerade hier.");

	AddDetail( ({ "gattung" }),
	   "Die Gattung Forscher ist mittlerweile recht rar geworden. Nur "
	   "noch sehr wenige Exemplare werden zu ihr gezaehlt.");

	AddDetail( ({ "exemplar", "exemplare" }),
	   "Zu den wenigen Exemplaren zaehlt Justavius.");

	AddSpecialDetail( ({ "justavius" }), "justfunc");
	  
        AddDetail( ({ "raum", "tempel" }), QueryProp(P_INT_LONG));

	AddDetail( ({ "kaelte", "bedrohung" }),
 	   "Trotz der kleinen glitzernden Kristalle des Marmors wirkt "
           "alles kalt und trostlos.");

	AddDetail( ({ "kristalle" }),
	   "Hier glitzert der Marmor irgendwie besonders schoen.");

	AddDetail( ({ "glitzern", "glitzer" }),
           "Wie viele kleine Sternchen glitzert der Marmor hier.");

	AddDetail( ({ "sternchen", "sterne" }),
	   "*************");	

	AddDetail( ({ "stein" }),
	   "Alles ist hier aus Stein. Auch die Pfeiler. Sogenannte "
	   "Steinpfeiler. Du darfst aber auch Saeule dazu sagen.");

	AddDetail( ({ "pfeiler", "steinpfeiler", "saeule", "saeulen" }),
	   "__  __  __  __\n"
	   "| | | | | | | |\n"
	   "| | | | | | | |\n"
	   "| | | | | | | |\n"
	   "|_| |_| |_| |_|\n"
	   "Rechts und links von Dir sind die Saeulen.");

	AddDetail( ({ "sockel", "sockeln" }),
	   "Die Sockeln sehen ungefaehr so aus:\n"
	   " ____________________\n"
	   "|                    |\n"
	   "|                    |\n"
	   "|                    |\n"
	   "|____________________|\n"
	   "                      \n"
	   "Nur noch viel groesser!");

	AddDetail( ({ "hoehe" }),
  	  "Da Du kein Hoehenforscher bist, kannst Du keine genauen "
	  "Hoehenangaben machen.");

	AddDetail( ({ "hoehenforscher" }),
	  "Sowas gibt es wirklich!!! Google mal :)");

	AddDetail( ({ "hoehenangaben", "angaben" }),
	  "Du kannst keine machen!");

	AddDetail( ({ "wand", "waende" }),
	  "Die Waende bestehen aus Marmor und interessieren Dich nicht.");

	AddDetail( ({ "nichts" }),
	  "Die Saeulen sind so hoch, dass sie sich ueber Dir im Nichts "
	  "verlaufen.");

	AddDetail( ({ "gang", "saeulengang" }),
	  "Du stehst in einem Gang im Tempel.");

	AddDetail( ({ "decke" }),
	  "Die Decke ist viel zu hoch oben.");

//SMELLS

	AddSmell(DEFAULT_SMELL, "Es riecht ein wenig nach "
	   "abgestandener Luft.");

	AddSmell( ({ "luft" }),
	  "Sie riecht etwas abgestanden.");

//SOUNDS

	AddSound(DEFAULT_SOUND, "Du hoerst ein leises Knistern.");

	AddSound( ({ "knistern" }),
	  "Das Knistern kommt aus dem Nordwesten.");

	AddSound( ({ "nordwesten" }),
	  "Du streckst Dein Ohr gaaaaaaaaaaaaaanz weit nach Nordwesten, doch "
	  "besser hoerst Du das Knistern nun auch nicht.");

	AddSound( ({ "ohr" }),
	  "Wie willst Du denn Dein Ohr hoeren? Du koenntest Dir hoechstens "
	  "die Finger in die Ohren stecken, damit Du gar nichts hoerst.");

	AddSound( ({ "ohren", "finger" }),
	  "Steck Dir halt Deine Finger in die Ohren wenn Du nichts anderes "
	  "zu tun hast!");


//COMMANDS	

 	AddCmd( ({ "google", "googl", "googel" }), "c_googlen");
	AddCmd( ({ "steck", "stecke" }), "c_stecken");

}


int c_googlen(string str)
{
	if(str != "nach hoehenforscher"  &&
	   str != "nach forscher"        )
	{
		notify_fail("Wonach moechtest Du googlen\n");
		return 0;
	}
	else
	{
		write(BS("Du wirst Google an und stellst fest, dass "
		 "ein Hoehenforscher etwas mit Hoehe und auch in der "
		 "Hoehe forscht! Du bist jetzt viel wissender!"));
		say(CTPN + " googlet.\n");
		return 1;
	}
}


int c_stecken(string str)
{
	if(str != "finger in ohren"   &&
	   str != "finger in ohr"     )
	{
		notify_fail("Wo moechtest Du Deine Finger hinstecken?\n");
		return 0;
	}
	else
	{
		write(BS("Du steckst Dir mit voller Wucht Deine Finger "
			"in Deine Ohren. Wuah das war doch viel zu fest!!! "
			"Irgendwie tun Deine Ohren jetzt ganz schoen weh! "
			"Irritiert nimmst Du die Finger wieder raus."));
		TP->SetProp(P_DEAF, 14 /*, 
			   ([ DEAF_TIME: 3300,
			    DEAF_MSG: "%s hat sich die Finger zu fest in die "
			    "Ohren gesteckt.\n",
			    DEAF_END_MSG: "Du hoerst jetzt wieder was!\n"])*/ );
		say(CTPN + " hat sich die Finger zu fest in die Ohren "
				"gesteckt.\n");
		return 1;
	}
}




string justfunc()
{
	TP->command_me("finger justavius");
}

