// YOG !!!
//
// ANSCHLUSS IRGENDWOHIN... ?! 

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <room/doors.h>
#include "../alte.h"

int anz_h;

void reset()
{
  	::reset();
  	anz_h = 1;
}

void create()
{

  	::create();
	anz_h = 1;
  	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG,
	  "Du befindest Dich am Eingang eines Tempels. Rechts und links "
	  "von Dir ragen Saeulen hoch bis zur Decke. In die Waende sind "
	  "Nischen eingebaut, davor stehen Altaere. Hinter Dir liegt ein "
	  "kleiner schwarzer See, ueber dessen Wasser staendig "
	  "wallende Nebel hinwegziehen. Die Luft ist kuehl und feucht. " );
	SetProp(P_LIGHT, 1);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_CAVE]) );
	SetProp(P_INDOORS, 1);

/*	AddExit( "norden", ROOM "room_g1"); */
	AddGuardedExit( "norden", ROOM "room_g1", "yog", "@@yogfunc@@",
	   "An Yogsothoth kommt keiner vorbei!\n");
		   

	/*

	NewDoor( "norden", ROOM "room_g1", ({"tor", "steintor", 
		"steinernes tor" }),
		({ D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
			D_NAME, "steinerne Tor",
			D_GENDER, NEUTER,
			D_SHORT, "Im Norden befindet sich ein %ses Tor "
				"aus festem Stein.",
			D_LONG, "Ein grosses steinernes Tor, das Dich daneben "
				"ziemlich klein erscheinen laesst. Man muss "
				"sicherlich sehr viel Kraft aufwenden, um "
				"es zu bewegen. ",
			D_MSGS, ({ "nach Norden", "geht", "kommt herein" }),
			D_OPENMSG, ({ "Du stemmst Dich mit aller Wucht gegen "
			  	"das Tor - langsam oeffnet es sich.",
				"Das Tor wird von %s langsam geoeffnet.",
				"Das Tor wird langsam geoeffnet." }),
			D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du "
			  	"das Tor.",	
				"Mit einem lauten Rumms schliesst %s das Tor.",
				" wird mit einem lauten RUMMS geschlossen." }),
			D_RESET_CLOSEMSG, " schliesst sich ploetzlich von "
				"selbst.\n"	}) );

Wir nehmen die Tuer mal raus weil wir keine TESTFUNC einbauen wollen wegen Yog......  
*/
	AddItem(NPC "yog", REFRESH_DESTRUCT);	


//DETAILBEGINN

	AddDetail( ({ "norden" }),
	   "Im Norden befindet sich ein riesiges Tor aus Stein.");

	AddDetail( ({ "tor" }),
	   "Ein grosses steinernes Tor, das Dich daneben "
	   "ziemlich klein erscheinen laesst. Man muss "
	   "sicherlich sehr viel Kraft aufwenden, um "
	   "es zu bewegen. ");

	AddDetail( ({ "altaere", "altar" }),
	   "Dich ueberkommt auf einmal ein befemdlicher Schauder, "
	   "denn die Altaere suggerieren vergessene Riten schrecklicher "
	   "und abstossender Art! Auf einem der Altaere steht ein Kelch. ");

	AddDetail( ({ "kerze", "kerzen" }),
	   "Die Kerzen in den Nischen bilden die einzige Lichtquelle hier.");

	AddDetail( ({ "quelle" }),
	   "Meinst Du die Lichtquelle?");

	AddSpecialDetail( ({ "lichtquelle" }), "lichtfunc");

	AddDetail( ({ "luft" }),
	   "Die Luft ist kalt und feucht. Die Feuchtigkeit scheint vom "
	   "Nebel zu kommen, der sich ueber dem See breit macht.");

	AddDetail( ({ "feuchtigkeit" }),
	   "Es ist etwas feucht hier.");

	AddDetail( ({ "nebel" }),
	   "Wallende Nebel ziehen staendig ueber den See hinweg.");

	AddDetail( ({ "see" }),
	   "Der See im Sueden gefaellt Dir nicht, trotzdem wirst "
	   "Du durch ihn schwimmen muessen um von hier wieder "
	   "wegzukommen. ");

	AddDetail( ({ "boden" }),
	   "Auf dem steinernen Boden kannst Du nasse Spuren ausmachen, die "
	   "vom See hier her fuehren.");

	AddDetail( ({ "spuren" }),
	   "Sind es vielleicht Deine eigenen?");

	AddDetail( ({ "saeulen", "saeule" }),
	   "Die Saeulen ragen hoch bis zur Decke.");

	AddDetail( ({ "decke" }),
	   "Die Decke ist gut zwanzig Fuss ueber Dir und besteht "
	   "aus massivem Felsgestein. ");

	AddSpecialDetail( ({ "nische", "nischen" }), "nische"); 
        // Die Nische uebernehmen wir mal 1:1 von Amazora wegen ZT	

	AddDetail( ({ "eingang" }),
	  "Du stehst am Eingang des Tempels. Wie es wohl drinnen "
	  "aussieht?");

	AddDetail( ({ "fuss" }),
	  "Die Decke liegt pi mal Daumen rund zwanzig Fuss ueber Dir.");

	AddDetail( ({ "pi"}),
	  "3,14159265...");

	AddDetail( ({ "daumen" }),
   	  "Du streckst Deinen Daumen in die Luft und schaetzt noch mal. "
	  "Ja ca. zwanzig Fuss.");

	AddDetail( ({ "felsgestein", "fels", "gestein" }),
	  "Die Decke besteht aus schwarzem Felsgestein.");

	AddDetail( ({ "stein" }),
	  "Die Waende, Nischen, Saeulen, ... alles ist hier aus Stein.");

	AddDetail( ({ "kraft" }),
	  "Man muss sicherlich viel Kraft aufwenden um das Tor oeffnen "
	  "zu koennen.");

	AddDetail( ({ "wasser" }),
	  "Das Wasser des Sees ist schleimig und schwarz. So schwarz dass "
	  "man nicht einmal bis zum Grund sehen kann.");

	AddDetail( ({ "grund" }),
	  "Das Wasser ist viel zu schwarz, als dass man ihn sehen koennte.");

	AddDetail( ({ "riten", "kult", "art" }),
          "Du fragst Dich, was fuer ein Menschenschlag einen derartigen "
	  "Tempel wohl errichtet haben mag.");

	AddDetail( ({ "menschenschlag" }),
	  "Oder waren es vielleicht gar keine Menschen?");

	AddDetail( ({ "menschen", "mensch" }),
	  "Du gruebelst.");

	AddDetail( ({ "wand", "waende" }),
	  "In den Waenden wurden Nischen eingebaut.");

	AddDetail( ({ "kelch" }),
	  "Der Kelch ist gefuellt mit einer roten, zaehen Fluessigkeit.");

  	AddDetail( ({ "fluessigkeit" }),    
          "Es ist, wie Du vermutet hast, Blut. Von wem moechtest Du "
	  "erst gar nicht wissen.");

  	AddDetail( ({ "blut" }),
          "Kannst ja mal versuchen es zu trinken.");

	AddDetail( ({ "raum" }), QueryProp(P_INT_LONG));

	AddDetail( ({ "tempel", "tempels" }),
	  "Du stehst bei seinem Eingang. ");

	AddDetail( ({ "schauder" }),
	  "Es laeuft Dir kalt den Ruecken runter.");

	AddDetail( ({ "ruecken" }),
	   "Ein Schauder laesst Dich zusammenzucken.");

	AddDetail( ({ "irgendetwas" }), QueryProp(P_INT_LONG));	


// SOUNDS

	AddSound(DEFAULT_SOUND,
	  "Du hoerst ein sanftes Plaetschern vom See.");

	AddSound( ({ "see" }),
	  "*platsch* *platsch*");

	AddSound( ({ "plaetschern" }),
	  "Normalerweise sollte Dich so ein Plaetschern ja beruhigen, aber "
	  "irgendwie ist hierfuer nicht der richtige Zeitpunkt.");

	AddSound( ({ "zeitpunkt" }),
	  "Schlechter Zeitpunkt momentan um sich zu entspannen.");

//SMELLS	

	AddSmell(DEFAULT_SMELL,
	  "Ein Geruch von Verwesung und Moder liegt in der Luft.");

	AddSmell( ({ "geruch" }),
	  "Baeh!");

	AddSmell( ({ "verwesung" }),
	  "Pfui!");

	AddSmell( ({ "moder" }),
	  "Es riecht modrig und irgendwie abgestanden.");

	AddSmell( ({ "wasser", "see" }),
	  "Das Wasser des Sees stinkt bestialisch.");


//COMMANDS

	AddCmd( ({ "bewege", "beweg" }), "c_bewegen");
	AddCmd( ({ "schliess", "schliesse" }), "c_schliessen");
	AddCmd( ({ "oeffne" }), "c_oeffnen");
	AddCmd( ({ "schwimm", "schwimme" }), "c_schwimmen");
	AddCmd( ({ "trink", "trinke" }), "c_trinken");
}

int c_bewegen(string str)
{
	if(str != "tor" )
	{
		notify_fail("Was moechtest Du bewegen?\n");
		return 0;
	}
	else
	{
		write(BS("Das Tor laesst sich entweder oeffnen oder "
					"schliessen."));
		return 1;
	}
}


int c_schliessen(string str)
{
	if(str != "tor" )
	{
		notify_fail("Was moechtest Du schliessen?\n");
		return 0;
	}
	else
	{
		write(BS("Du bist viel zu schwach dafuer."));
		return 1;
	}
}

int c_oeffnen(string str)
{
	if(str != "tor" )
	{
		notify_fail("Was moechtest Du hier oeffnen?\n");
		return 0;
	}
	else
	{
		write(BS("Aber das Tor ist doch schon offen!"));
		return 1;
	}
}



int c_trinken(string str)
{
	if( str != "blut"  &&
      	str != "blut aus kelch" &&
      	str != "aus kelch" )
	{
		notify_fail("Was moechtest Du trinken?\n");
		return 0;
	}
	if(anz_h < 1)
	{
		write(BS("Iiiehh!"));
		return 1;
	}
	else
	{
    		write(BS( "Du trinkst das Blut aus dem Kelch. "
		          "Ein bisschen ekelst Du Dich ja schon, aber das "
			  "Blut scheint eine heilende Wirkung zu haben. "
			  "Du spuerst wie eine magische Kraft Dich "
			  "durchstroemt. Ploetzlich wird der Kelch "
                          "brennend heiss und vor Schreck laesst Du "
			  "ihn fallen. Wie von Geisterhand wird er "
			  "aufgehoben und wieder an seinen Platz gestellt."));
      		TP->heal_self(200);
      		anz_h--;
      		say(CTPN+ " trinkt aus einem Kelch.\n");
      		return 1;
	}

}



string nische()
{
   if (TP->FindPotion(
     "Oh, in einer Nische findest Du hinter der Kerze einen Zaubertrank.\n"))
        return "";
   else
      return "Kerzen stehen in den Nischen.\n";
}

int c_schwimmen(string str)
{
  if(str != "durch see"  &&
     str != "see"  )
  {
	  notify_fail("Wodurch moechtest Du schwimmen?\n");
	  return 0;
  }
  else
  {
   	  write(BS("Du springst in den See und kommst voellig nass "
		    "wieder an die Oberflaeche. "));
    TP->move("/d/unterwelt/amazora/dimension/room/hoehle", M_GO, 
      "in den See", "springt", "taucht auf und schwimmt ans Ufer");
    say("Die Wellen glaetten sich wieder.\n");
    return 1;
   }  
}



string lichtfunc()
{
	if(TP->QueryProp(P_RACE) != "Dunkelelf")
	{
	return(BS("Die Kerzen in den Nischen spenden dem Raum Licht, damit "
		"damit Du wenigstens irgendetwas erkennen kannst."));
	}
	else
	{
	return(BS("Du als Dunkelelf brauchst natuerlich die Kerzen als "
	"Lichtquelle nicht."));
	}
}

string yogfunc()
{
     present("yogsothoth", this_object())->Kill(this_player());
     return "Yogosothoth schreit: Lebend kommst Du hier nicht vorbei!\n";
}

