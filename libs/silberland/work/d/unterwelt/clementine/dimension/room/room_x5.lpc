

// ostfunc() Ausgabefehler behoben: 28.06.2019 - Eros
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"

void create()
{
	::create();

	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG,
		"Im Osten siehst Du einen Raum, in dem seltsamer Rauch "
		"aufzusteigen scheint. Im Westen hingegen befindet sich "
		"ein Brunnen aus schwarzem Lavagestein. Imposante Saeulen "
		"aus Stein mit maechtigen quadratischen Sockeln ragen "
		"rechts und links von Dir in die Hoehe, und verschwinden "
		"dort im Nichts. Der polierte Boden wirkt beeindruckend, "
		"strahlt aber gleichzeitig eine ungeheure Bedrohung aus. ");
	SetProp(P_LIGHT, 0);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);

	AddExit( "osten", ROOM "room_g5");
	AddExit( "suedwesten", ROOM "room_x2");
	AddExit( "nordwesten", ROOM "room_x6");
	AddExit( "westen", ROOM "alte");


//DETAILBEGINN


	AddDetail( ({ "bedrohung" }),
	  "Du fuehlst Dich einfach nicht wohl hier.");

	AddDetail( ({ "boden" }),
	  "Der Boden ist glatt poliert. Wer die Hoehle wohl erschaffen "
	  "hat?");

	AddDetail( ({ "grosse alte", "alte", "alten" }),
	  "Wo sind sie?!");

	AddDetail( ({ "shogotte", "shogotten" }),
	  "Die Shogotten laufen hier herum.");

	AddDetail( ({ "sockel", "sockeln" }),
	  "Die quadratischen Sockeln sind genauso imposant wie die Saeulen "
	  "die aus ihnen foermlich herauswachsen.");


	AddDetail( ({ "rauch" }),
	  "Durch den Steinbogen im Osten siehst Du, dass in diesem Raum "
	  "Rauch aufsteigt. ");

	AddDetail( ({ "steinbogen", "bogen" }),
	  "Durch ihn kommst Du nach Osten.");

	AddDetail( ({ "lava", "lavagestein", "gestein" }),
	  "Schwarzes Lavagestein, dass irgendwann einmal durch den Ausbruch "
	  "eines Vulkans entstanden ist.");

	AddDetail( ({ "vulkan" }),
	  "Sehen kannst Du hier keinen mehr. ");

	AddDetail( ({ "ausbruch" }),
	  "Irgendwann ist einmal ein Vulkan ausgebrochen. Sonst "
	  "waere der Brunnen ja wohl nicht aus Lavagestein.");

	AddDetail( ({ "brunnen" }),
	  "Du kannst ihn Dir im Westen naeher ansehen.");

	AddDetail( ({ "westen" }),
	  "Westen ist dort, wo der kleine Finger Deiner linken Hand ganz "
	  "aussen ist.");

	AddDetail( ({ "finger" }),
	  "Alles noch da.");

	AddDetail( ({ "haende" }),
	  "Du hast zwei davon!");

	AddDetail( ({ "linke hand" }),
	  "Deine linke Hand ist links. Zumindest hoff ich das fuer Dich!");

	AddDetail( ({ "rechte hand" }),
	  "Deine rechte Hand hat den Daumen links.");

	AddDetail( ({ "daumen" }),
	  "Du wackelst mit dem Daumen einmal nach rechts und einmal nach "
	  "links. Irgendwie kommst Du Dir dabei sehr bloed vor.");


	AddDetail( ({ "hoehle" }),
	  "Eigentlich stehst Du ja in einem Tempel.");

	AddDetail( ({ "tempel" }),
	  "Ja, da stehst Du gerade.");

	AddDetail( ({ "hand" }),
	  "Welche Hand meinst Du?");

	AddDetail( ({ "decke" }),
	   "Die Decke ist hier genauso hoch oben wie in all den anderen "
	   "Raeumen. Und auch hier kannst Du sie weder sehen noch riechen!");

	AddDetail( ({ "hoehe" }),
	   "Die Hoehe ist so hoch, dass Du gar nicht sagen kannst wie hoch "
	   "sie ist.");

	AddDetail( ({ "nichts" }),
	   "Das Nichts gleicht einem riesigen schwarzen Loch.");

	AddDetail( ({ "loch" }),
	   "Meinst Du das schwarze Loch?");

	AddDetail( ({ "schwarzes loch", "schwarze loch" }),
	   "Das Nichts gleicht irgendwie einem schwarzen Loch. Irgendetwas "
	   "sagt Dir aber, dass man sogar schwarze Loecher mit sich "
	   "mitschleppen kann.");

	AddDetail( ({ "schwarze loecher", "loecher" }),
	   "Deine hellseherischen Kraefte gebieten es Dir, dass Du weisst, "
	   "dass man in der Astralebene schwarze Loecher holen kann.");

	AddDetail( ({ "astralebene", "astral", "ebene" }),
	   "Na momentan bist Du ja nicht in der Astralebene. Wie willst Du "
	   "sie also untersuchen?");

	AddDetail( ({ "kraefte", "kraft" }),
	   "Nicht jeder hat so tolle hellseherische Kraefte wie Du!");

	AddDetail( ({ "hellseherische kraefte", "hellseherische kraft" }),
	   "Die Macht des Geistes mit Dir.");

	AddDetail( ({ "macht", "geist" }),
	   "Amen.");

	AddDetail( ({ "amen" }),
	   "!");

	AddDetail( ({ "wand", "waende" }),
	   "An den Waenden kannst Du nichts Aussergewoehnliches erkennen.");

	AddDetail( ({ "aussergewoehnliches" }),
	   "Nichts zu sehen. Die Waende sind wie ueberall aus Stein.");

	AddDetail( ({ "stein" }),
	   "Der Stein ist hart.");

	AddDetail( ({ "haerte" }),
	   "Hart!");

	AddDetail( ({ "saeulen", "saeule" }),
	   "Die Saeulen stuetzen irgendwo ganz hoch oben die Decke, damit sie "
	   "Dir nicht auf den Kopf fallen kann.");

	AddDetail( ({ "kopf" }),
	   "Deinen Kopf schuetzt Du gewoehnlich mit einem Helm!");

	AddDetail( ({ "helm" }),
	   "Wenn die Decke wirklich einstuerzen wuerde, dann wuerde Dir "
	   "ein Helm auch nicht viel nuetzen.");

	AddDetail( ({ "raeume" }),
	   "In fast allen Raeumen des Tempels ist die Decke hoch oben. "
	   "So hoch oben, dass Du sie mit blossem Auge nicht erkennen "
	   "kannst.");

	AddDetail( ({ "auge", "blosses auge" }),
	   "Die Decke ist einfach nicht zu erkennen.");

	AddDetail( ({ "raum" }), QueryProp(P_INT_LONG));



//SOUND

	AddSound(DEFAULT_SOUND, "Alles ruhig hier.");


//SMELL

	AddSmell(DEFAULT_SMELL,
  	  "Irgendetwas riecht hier komisch. Ob das der Rauch ist?");

	AddSmell( ({ "irgendetwas" }),
	   "Irgendwie stinkt es hier.");

	AddSmell( ({ "rauch" }),
	   "Du solltest dringenst mal im Osten nach dem Rauch riechen.");

	AddSmell( ({ "osten" }),
	   "Von Osten her riecht es wirklich komisch!");	

	AddSmell( ({ "decke" }),
	   "Du kannst die Decke nicht riechen!");

	AddSpecialDetail( ({ "osten" }), "ostenfunc");



}


string ostenfunc()
{
	TP->command_me("osten");
        return "";
	
}


