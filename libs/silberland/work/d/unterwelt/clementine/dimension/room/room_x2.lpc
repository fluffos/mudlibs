

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"

void create()
{
	::create();

	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG,
		"Du wanderst einen schier endlos erscheinenden Gang aus "
		"Saeulen entlang. Links und rechts von Dir ragen die "
		"Pfeiler aus Stein auf ihren maechtigen Sockeln in die Hoehe. "
		"Du hast das Gefuehl, als wuerde Dich jemand verfolgen, manchmal "
		"glaubst Du sogar eine Hand auf Deiner Schulter zu spueren, aber "
		"sobald Du Dich umdrehst ist nichts zu erkennen. Im Nordwesten "
		"siehst Du einen Brunnen. ");
	SetProp(P_LIGHT, 0);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);

	AddExit( "westen", ROOM "room_x1");
	AddExit( "suedosten", ROOM "room_g2");
	AddExit( "nordwesten", ROOM "alte");
	AddExit( "nordosten", ROOM "room_x5");


	AddDetail( ({ "raum", "tempel", "tempelanlage", "anlage" }),
	 QueryProp(P_INT_LONG));

	AddDetail( ({ "gang" }),
          "Er erscheint Dir wirklich endlos.");

 	AddDetail( ({ "hand" }),
          "War da etwas?!");

	AddDetail( ({ "etwas" }),
          "Du kannst wirklich nichts erkennen.");

	AddDetail( ({ "nichts" }),
	  "Gar nichts!");

	AddDetail( ({ "gar nichts" }),
	  "NICHTS zu erkennen!!!");

	AddDetail( ({ "brunnen" }),
	  "Der Brunnen im Nordwesten sieht sehr interessant aus. "
	  "Du solltest ihn Dir einmal naeher ansehen.");

	AddDetail( ({ "nordwesten" }),
          "Nach Nordwesten kommst Du zu einem Brunnen.");

	AddDetail( ({ "nordosten", "suedosten", "westen" }),
	  "Schau Dich ruhig dort naeher um!");

	AddDetail( ({ "jemand" }),
	  "Wo ist hier jemand?!");

	AddDetail( ({ "sockeln", "sockel" }),
	  "Maechtige Sockel! Nicht so kleine Dinger wie auf der "
	  "Pirateninsel!"); 

	AddDetail( ({ "pirateninsel", "insel" }),
	  "Kennst Du nicht? Macht gar nichts.");

	AddDetail( ({ "dinger" }),
	  "Ein Ding, viele kleine Dinger :)");

	AddDetail( ({ "ding" }),
	  "Ringdingding :)");

	AddDetail( ({ "ringdingding" }),
	  "Laeutet hier etwa ein Telefon?");

	AddDetail( ({ "telefon" }),
	  "Clementines Telefon kanns nicht sein, die findet ihres nie :)");

	AddDetail( ({ "clementine" }),
	  "Du blaetterst im Silberland Duden und kuckst beim Buchstaben "
	  "C nach einer Definition.");

	AddDetail( ({ "c", "buchstabe c", "buchstabe", "definition", "duden" }),
	  "C - wie Clementine liest Du. Das absolute Chaos in all seiner "
	  "Boshaftigkeit. ");

	AddDetail( ({ "chaos", "boshaftigkeit" }),
	  "Chaotin Clementine malt Dir aus der Ferne ein Sternchen auf die "
	  "Nase.");

	AddDetail( ({ "silberland" }),
	  "Ja, da sind wir.");

	AddDetail( ({ "ferne" }),
	  "Die Ferne ist zu weit weg um sie zu untersuchen.");

	AddDetail( ({ "sternchen" }),
          "*");

	AddDetail( ({ "nase" }),
	  "Huebsches Sternchen!");

        AddDetail( ({ "boden" }),
	  "Um uns kurz zu fassen: der Boden ist aus Stein.");

	AddDetail( ({ "waende", "wand" }),
	  "Stein!");

	AddDetail( ({ "decke" }),
	  "Zu hoch um sie erkennen zu koennen.");

	AddDetail( ({ "stein" }),
	  "Feucht & kalt. ");

	AddDetail( ({ "saeulen", "saeule", "pfeiler" }),
	  "Links und rechts neben Dir ragen sie in die Hoehe.");

	AddDetail( ({ "hoehe" }),
	  "Hoch!");

        AddDetail( ({ "gefuehl" }),
	  "Nicht gerade das beste hier!");

	AddDetail( ({ "schulter" }),
	  "Alles noch da!");

// SMELLS

	AddSmell(DEFAULT_SMELL, "Es riecht leicht modrig.");

	AddSmell( ({ "moder" }),
	  "Nicht so ganz Deine Lieblingsgeruchsrichtung.");

	AddSmell( ({ "lieblingsgeruchsrichtung", "geruchsrichtung" }),
	  "Moder ist nicht das, was Du taeglich riechen moechtest.");

// SOUNDS

	AddSound(DEFAULT_SOUND,
	  "Aus dem Nordwesten hoerst Du ein leises Plaetschern, sonst ist "
          "es hier still.");

	AddSound( ({ "plaetschern" }),
	  "*blubb* *blubb*");

	AddSound( ({ "blubb" }),
	  "*!*");


	
	
 	 
	 

}

