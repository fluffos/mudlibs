//Im Westen gehts zu Hastur

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"

int anz_stein;

void reset()
{
	::reset();
	anz_stein = 2;
}

void create()
{
	::create();
	anz_stein = 2;
	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG,
		"Du wanderst in einem endlos erscheinenden Gang aus schwarzen "
		"Saeulen. Rechts und links von Dir ragen die imposanten "
		"Pfeiler aus Stein auf ihren gewaltigen Sockeln in die Hoehe, "
		"und verschwinden ueber Dir im Nichts. Alles wirkt sehr "
		"beeindruckend auf Dich, strahlt es doch eine ungeheure "
		"Kaelte und Bedrohung auf seine Umgebung aus. Im Westen "
		"kommst Du durch einen Steinbogen gehen. ");
	SetProp(P_LIGHT, 0);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);

	AddExit( "westen", ROOM "room_g4");
	AddExit( "suedosten", ROOM "room_x3");
	AddExit( "osten", ROOM "alte");
	AddExit( "nordosten", ROOM "room_x8");



//DETAILBEGINN

	AddDetail( ({ "umgebung" }),
	  "Deine Umgebung ist finster und eintoenig. Nicht einmal Forschen "
	  "macht Dir hier Spass.");

	AddDetail( ({ "spass" }),
	  "Absolut kein Spass hier!");

	AddDetail( ({ "forschen" }),
	  "Totaaaaaaaaaaaaaaaaal langweilig ;)");

	AddDetail( ({ "steinbogen", "bogen" }),
	  "Der Steinbogen befindet sich im Westen. Du kannst sogar durch "
	  "ihn hindurchgehen! Aber ob Du wirklich wissen willst, was sich "
	  "dort befindet?");

	AddDetail( ({ "westen" }),
	  "Nach Westen gelangst Du durch einen Steinbogen in eine Art "
	  "Zimmer.");

	AddDetail( ({ "art", "zimmer" }),
  	  "Im Westen kannst Du eine Art Zimmer ausmachen. Um dort etwas "
	  "untersuchen zu koennen musst Du schon 'w' tippen.");

	AddDetail( ({ "hoehe" }),
	  "Die Hoehe ist hier einfach furchtbar hoch!");

	AddDetail( ({ "boden" }),
	   "Der Boden ist aus Marmor wie alles andere hier. Allerdings "
	   "kannst Du einige Steinchen auf ihm ausmachen.");

	AddDetail( ({ "steinchen" }),
	   "Ob das Kieselsteine sind?");

	AddDetail( ({ "kiesel", "kieselsteine" }),
	   "Sieht fast so aus. Warum die hier liegen?");

	AddDetail( ({ "stein" }),
	   "Der Stein ist schwarz und absolut uninteressant.");

	AddDetail( ({ "kaelte", "bedrohung" }),
	   "Es wirkt alles kalt und bedrohlich. Nicht einmal Pflanzen "
	   "wachsen hier.");

	AddDetail( ({ "pflanzen", "pflanze" }),
	   "Gut... es ist alles aus Marmor, da koennen keine Pflanzen wachsen, "
	   "aber wer immer hier auch lebt koennte ja zumindest ein paar "
	   "Vasen mit Blumen aufstellen.");

	AddDetail( ({ "blumen", "blume" }),
	   "Ist das denn wirklich zuviel verlangt, wenn hier irgendwo ein "
	   "paar froehliche Bluemchen stehen wuerden?");

	AddDetail( ({ "bluemchen" }),
	   "Leider kannst Du keine entdecken.");

	AddDetail( ({ "vasen", "vase" }),
	   "Bunte grosse Vasen wuerden sich in dieser Einoede wirklich "
	   "gut machen.");

	AddDetail( ({ "einoede" }),
	   "Alles hier ist eintoenig und langweilig. Wenn Du hier wohnen "
	   "wuerdest, wuerdest Du vermutlich gleich die Waende in einem "
	   "leuchtenden Pink streichen.");

	AddDetail( ({ "pink" }),
	   "Ja, pink - so muessten Deine Waende sein :)");

	AddDetail( ({ "waende", "wand" }),
	   "Stein, Stein und nochmals Stein.");

	AddDetail( ({ "marmor" }),
	   "Der Marmor ist hier ganz schwarz.");

	AddDetail( ({ "schwarz" }),
	   "Schwarz, schwarz, schwarz, schwarz. So schwarz wie die "
	   "Seele eines Dunkelelfs.");

	AddDetail( ({ "seele", "seelen" }),
	   "Haben Dunkelelfen ueberhaupt Seelen?");

	AddDetail( ({ "dunkelelf" }),
	   "Schwarz wie ein beseelter Dunkelelf.");

	AddDetail( ({ "nichts" }),
	   "Du erkennst das Nichts nicht genau.");

	AddDetail( ({ "saeulen", "saeule", "pfeiler", "steinpfeiler" }),
	   "Die Saeulen stehen rechts und links von Dir. ");

	AddDetail( ({ "sockeln", "sockel" }),
	   "Die Saeulen haben unten einen grossen Sockel, der mindestens "
	   "genauso imposant wirkt wie die Saeulen selbst.");

	AddDetail( ({ "decke" }),
	   "Sie ist leider viel zu hoch oben, als dass Du etwas erkennen "
	   "koenntest. Schade eigentlich. ");

	AddDetail( ({ "gang", "saeulengang" }),
	   "Da befindest Du Dich gerade!");


//SOUNDS

	AddSound(DEFAULT_SOUND,
	  "Du hoerst ein leises Zischen.");

	AddSound( ({ "zischen" }),
	  "Kommt vermutlich vom Wind.");

	AddSound( ({ "wind" }),
	  "Der Wind scheint aus dem Westen herzukommen.");

	AddSound( ({ "westen" }),
	  "Den Westen kannst Du von hier nicht abhoeren.");

//SMELLS


	AddSmell(DEFAULT_SMELL,
	  "Es riecht nach Steinen.");

	AddSmell( ({ "steine", "stein" }),
	  "Steinig!");	


	AddCmd( ({ "nimm", "nehme", "nehm" }), "c_nehmen");


}


int c_nehmen(string str)
{
object ob;
	if(str != "kieselsteine" &&
	   str != "kieselstein"  &&
	   str != "steinchen"    &&
	   str != "steine"       &&
	   str != "stein"        )
	{
		notify_fail("Was moechtest Du hier nehmen?\n");
		return 0;
	}
	if(anz_stein<1)
	{
		write(BS("Du findest gerade keinen Kieselstein, den Du "
			"unbedingt mitnehmen willst. Vielleicht ein "
			"anderes Mal."));
		return 1;
	}
	else
	{
		write(BS("Du suchst Dir einen schoenen Kieselstein aus und "
			 "steckst ihn schnell ein."));
		say(CTPN + " steckt etwas ein.\n");
		ob = clone_object(OBJ "stein");
		if(ob->move(TP, M_GET) != 1)
		{
			tell_object(TP, "Das kleine Steinchen ist zu "
					"schwer fuer Dich!\n");
			ob->move(TO, M_NOCHECK);
		}
		anz_stein--;
		return 1;
	}
}


