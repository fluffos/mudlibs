
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"

void create()
{

	::create();

	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG, 
		"Du wanderst in einem schier endlos erscheinenden "
		"Gang aus Saeulen. Links und rechts von Dir ragen "
		"die ueberdimensionalen Steinpfeiler auf ihren imposanten "
		"Sockeln in die Hoehe und verschwinden im schwarzen Nichts. "
		"Der polierte Marmor wirkt beeindruckend, "
		"strahlt aber gleichzeitig eine ungeheure Bedrohung und "
		"Kaelte aus. Weiter im Norden siehst Du einen gewaltigen Brunnen. ");
	SetProp(P_LIGHT, 0);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);
	
	AddExit( "westen", ROOM "room_x3");
	AddExit( "osten", ROOM "room_x2");
	AddExit( "sueden", ROOM "room_g1");
	AddExit( "norden", ROOM "alte");

	AddItem(NPC "shogotte", REFRESH_DESTRUCT);
	AddItem(NPC "shogotte", REFRESH_DESTRUCT);
	AddItem(NPC "shogotte", REFRESH_DESTRUCT);
	AddItem(NPC "shogotte", REFRESH_DESTRUCT);
	AddItem(NPC "shogotte", REFRESH_DESTRUCT);


//DETAILBEGINN

	AddDetail( ({ "bedrohung" }),
	   "Der Marmor wirkt irgendwie bedrohlich auf Dich. ");

	AddDetail( ({ "marmor" }),
	   "Der Marmor wirkt bedrohlich und strahlt eine unheimliche "
	   "Kaelte aus.");

	AddDetail( ({ "kaelte" }),
	   "Marmor kann ja wirklich sehr schoen wirken - vorallem ein "
	   "Marmorgugelhupf; hier strahlt er allerdings eine eisige "
	   "Kaelte aus.");

	AddDetail( ({ "marmorgugelhupf", "guglhupf", "gugelhupf" }),
	   "Mjamm...lecker! Den haettest Du jetzt gerne.");

	AddDetail( ({ "steinpfeiler", "pfeiler" }),
	   "Sie sind riesig!");

	AddDetail( ({ "saeulen", "saeule" }),
	   "Rechts und links von Dir stehen die Saeulen und bilden dadurch "
	   "einen Saeulengang. Ihre Enden verlaufen sich irgendwo im "
	   "schwarzen Nichts.");

	AddDetail( ({ "nichts" }),
	   "Der Raum ist so hoch, dass Du die Decke nicht sehen kannst.");

	AddDetail( ({ "decke" }),
	   "Die ist irgendwo ganz hoch ueber Dir.");

	AddDetail( ({ "saeulengang", "gang" }),
	   "Du befindest Dich in einem Tempel, und in diesem Tempel stehst "
	   "Du gerade in einem Saeulengang.");

	AddDetail( ({ "tempel" }),
	   "Der Tempel scheint ganz schoen riesig zu sein. Zumindest hat "
	   "er wahnsinnig hohe Decken.");

	AddDetail( ({ "enden", "ende" }),
	   "Die Enden der Saeulen sind so hoch oben, dass Du sie von hier "
	   "unten nicht untersuchen kannst.");

	AddDetail( ({ "boden" }),
	   "Der Boden besteht genauso wie die Saeulen aus Marmor. Eigentlich "
	   "ist alles hier aus Marmor.");

	AddDetail( ({ "brunnen" }),
	   "Im Norden befindet sich ein gewaltiger Brunnen. Aber um "
	   "ihn Dir genauer anzusehen muesstest Du schon dorthin gehen.");

	AddDetail( ({ "hoehe" }),
	   "Schier endlos hoch verschwinden die Saeulen im Nichts.");

	AddDetail( ({ "raum" }), QueryProp(P_INT_LONG));

	AddDetail( ({ "wand", "waende" }),
	   "Die Waende sind genauso wie der Boden und die Saeulen aus "
	   "Marmor. Soviele kannst Du allerdings nicht erkennen.");

	AddDetail( ({ "norden" }),
	   "Im Norden befindet sich ein gewaltiger Brunnen.");

	AddDetail( ({ "sueden", "osten", "westen" }),
	   "Du musst schon hingehen um etwas erkennen zu koennen.");

	AddDetail( ({ "etwas" }),
	   "Etwas hat lange Ohren, ist rosa und kann trommeln!");

	AddDetail( ({ "ohren" }),
	   "Na was hat lange Ohren, ist rosa und kann trommeln?! "
	   "Ein Duracell-Hase!!!");

	AddDetail( ({ "duracellhase", "hase", "duracell", "duracell-hase"}),
	   "Also wenn Du einen Duracell-Hasen hier siehst, dann kann ich "
	   "Dir auch nicht mehr weiterhelfen!");

	AddDetail( ({ "sockel", "sockeln" }),
	   "Die Sockeln der Saeulen sind wirklich imposant. Quadratisch, "
	   "praktisch, gut, bilden sie einen festen Untergrund fuer die "
	   "Saeulen.");

	AddDetail( ({ "untergrund" }),
	   "Alles hier ist aus Marmor. Dunkler Marmor, der von noch duenkleren "
	   "Streifen durchbrochen wird.");

	AddDetail( ({ "streifen" }),
	   "Der dunkle Marmor wird von noch duenkleren Streifen "
	   "unterbrochen. Sozusagen ein marmorierter Marmor.");

//SOUNDS

	AddSound(DEFAULT_SOUND,
	   "Hier herrscht eine angenehme Stille. ");

	AddSound( ({ "stille" }),
           "Es ist angenehm ruhig hier. Wenn Du nicht in dem Tempel "
   	   "waerst koenntest Du Dich jetzt so richtig entspannen.");

	AddSound( ({ "tempel" }),
           "Du stehst gerade im Saeulengang des Tempels, in dem es "
   	   "angenehm ruhig ist.");

	AddSound( ({ "trommeln" }),
	   "Was solltest Du hier denn trommeln hoeren?");

//SMELLS

	AddSmell(DEFAULT_SMELL,
 	   "Es riecht nach Stein.");

	AddSmell( ({ "stein" }),
	   "Der Stein riecht steinig und kalt.");	

//COMMANDS


	AddCmd( ({ "kletter", "klettere", "klettre" }), "c_klettern");

}

int c_klettern(string str)
{
	if(str != "saeule hoch"   &&
	   str != "saeulen hoch"  &&
	   str != "an saeule hoch"  &&
	   str != "an saeulen hoch" )
	{
		notify_fail("Woran moechtest Du hochklettern?\n");
		return 0;
	}
	else
	{
		write(BS("Der Marmor der Saeulen ist viel zu glatt, sodass "
			"Du sofort wieder abrutscht."));
		say(CTPN + " rutscht von der Saeule ab.\n");
		TP->do_damage(14);
		return 1;
	}
}

