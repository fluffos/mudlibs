//*************************//
//  Erscheinungsraum Alte  //
//*************************//
//
//yibb, shubb, azathoth, nyarlathothep, shudde, cthuga, hastur, tsathoggua, shodagoi,
//glaaki, wendigo, cthulhu

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"

int anz_yibb;

void reset()
{
	::reset();
	anz_yibb =1;
}


void create()
{

	::create();
	anz_yibb = 1;   
	SetProp(P_INT_SHORT, "In einer Tempelanlage");
        SetProp(P_INT_LONG, 
		"Maechtige Saeulen umschliessen den Raum, in dessen Mitte ein "
		"gewaltiger Brunnen steht. Eine unheimlich grosse Kraft, "
		"jenseits von dieser Welt muss hier am Werk gewesen sein. "
		"Seltsame Zeichen wurden in den polierten Marmor unter Deinen Fuessen "
		"gemeisselt. Immer wieder spuerst Du Gestalten an Dir vorbeihuschen, "
		"aber sobald Du Dich nach ihnen umdrehst, sind sie auch schon "
		"wieder verschwunden. Ein eisiger Luftzug laesst Dich erschaudern. ");
 	SetProp(P_LIGHT, 0);
    	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );		    	 SetProp(P_INDOORS, 1);
	
	AddExit( "norden", ROOM "room_x7");
	AddExit( "nordwesten", ROOM "room_x8");
	AddExit( "nordosten", ROOM "room_x6");
	AddExit( "osten", ROOM "room_x5");
	AddExit( "westen", ROOM "room_x4");
	AddExit( "suedwesten", ROOM "room_x3");
	AddExit( "sueden", ROOM "room_x1");
	AddExit( "suedosten", ROOM "room_x2");

	

// DETAILBEGINN

	
	AddDetail( ({ "brunnen" }),
		"Der Brunnen besteht aus schwarzem Lavagestein, und ist mit einer "
		"dunklen Bruehe gefuellt. Irgendetwas sagt Dir, dass es mit ihm "
		"etwas Unheimliches auf sich hat. ");

	AddDetail( ({ "bruehe" }),
		"Die Bruehe in dem Brunnen entpuppt sich als Wasser - ebenso "
		"pechschwarz wie das Gestein, aus dem er erbaut wurde. ");

	AddDetail( ({ "wasser" }),
	  	"Du hast einmal gehoert, dass man mit Wasser einen Riss in den Welten "
		"erschaffen, und anderen, groesseren Maechten so einen "
		"Durchlass in diese Welt ermoeglichen kann. "); 

        AddDetail( ({ "lavagestein", "gestein" }),
		"Das Gestein, aus dem der Brunnen erbaut wurde, ist so schwarz wie "
		"die Nacht. Wie es wohl hierher gelangte?");

	AddDetail( ({ "nacht" }),
		"Pechschwarz!");

	AddDetail( ({ "schwarz", "pechschwarz" }),
		"Gruselig...");


	AddDetail( ({ "unheimliches" }),
	 	"Ganz wohl ist Dir hier bei dem Brunnen nicht. Irgendetwas scheint "
		"hier nicht mit rechten Dingen zuzugehen. ");
	
	AddDetail( ({ "irgendetwas" }),
		"Bei dem Gedanken daran, dass hier irgendetwas nicht stimmen koennte "
		"wird Dir schon ganz uebel.");

	AddDetail( ({ "gedanken", "gedanke" }),
		"Du denkst an Risse in den Welten und schreckliche Kreaturen.");

	AddDetail( ({ "kreaturen", "kreatur" }),
	 	"Irgendwo hast Du schon einmal gehoert, dass schreckliche Kreaturen "
		"sich den Weg durch Risse in den Welten bahnen koennen und von Neuem "
		"die Erde bevoelkern koennen.");

	AddDetail( ({ "erde" }),
		"Deine Welt hier heisst Silberland.");

	AddDetail( ({ "silberland" }),
		"Langsam solltest Du das schon wissen.");

	AddDetail( ({" welt" }),
	 	"Du solltest Deine Welt hier schuetzt und lieber nicht mit Wasser oder "
		"Aehnlichem spielen.");

	AddDetail( ({ "aehnlichem", "aehnliches" }),
		"Statuen, Bilder, ....");

	AddDetail( ({ "statuen", "statue", "bild", "bilder" }),
		"Hier sind keine... aber vielleicht woanders?!");

	AddDetail( ({ "durchlass" }),
		"Das Wasser kann einen Durchlass fuer Wesen erzeugen, die weit "
		"maechtiger sind, als Du es Dir vorstellen kannst.");

	AddDetail( ({ "wesen" }),
	 	"Maechtige Wesen wie die Grossen Alten zum Beispiel.");

	AddDetail( ({ "alte", "grosse alte", "alten" }),
		"Kreaturen von den Sternen. Bizarre Geschoepfe, so unsagbar fremd, "
		"dass allein ihre Architektur genuegt haette, den menschlichen Geist "
		"in den Wahnsinn zu treiben. ");

	AddDetail( ({ "neues", "neuem" }),
		"Finde es heraus wenn Du Dich traust.");

	AddDetail( ({ "dinge" }),
		"Irgendetwas hier geht nicht mit rechten Dingen zu. Ob Du mal einen "
		"Blick in den Brunnen werfen solltest?");

	AddDetail( ({ "blick" }),
		"Du solltest einen Blick in den Brunnen werfen.");	

	AddDetail( ({ "etwas" }),
		"Das Etwas im Brunnen sieht aus wie ein Tentakel.");

	AddDetail( ({ "tentakel" }),
		"Vielleicht kannst Du ja einmal daran ziehen?");

	AddDetail( ({ "stern", "sterne" }),
		"Hier kannst Du keine sehen.");

	AddDetail( ({ "decke" }),
		"Die Decke ist so hoch ueber Dir, dass Du sie mit blossem Auge nicht "
		"mehr erkennen kannst.");

	AddDetail( ({ "aug", "auge" }),
		"Mit blossem Auge kannst Du die Decke nicht erkennen, vielleicht gibt "
		"es hier auch keine?");

	AddDetail( ({ "gestalten", "gestalt" }),
		"Du kannst sie spueren, aber keine Gestalt erblicken...");

	AddDetail( ({ "gespuer" }),
		"Benutze Dein Gespuer.");

	AddDetail( ({ "geschoepf", "geschoepfe" }),
		"Bizarr und fremd ist die Architektur der Grossen Alten.");

	AddDetail( ({ "architektur" }),
		"Sie koennte auch Deinen Geist beim blossen Anblick in den Wahnsinn "
		"treiben.");

	AddDetail( ({ "wahnsinn" }),
		"Ach stimmt ja... Du bist schon wahnsinnig - vielleicht richten die "
		"Alten an Dir weniger Schaden an, als an anderen...");

	AddDetail( ({ "schaden" }),
		"Freust Du Dich schon auf einen Kampf?");

	AddDetail( ({ "kampf" }),
		"Dir laeuft ja scheinbar schon der Sabber aus den Mundwinkeln.");

	AddDetail( ({ "sabber", "mundwinkeln", "mundwinkel" }),
		"Ieeh. So genau will das keiner sehen.");

	AddDetail( ({ "andere" }),
		"Die anderen sind wohl geistig noch nicht so nackt wie Du in Deinem "
		"Wahnsinn.");

	AddDetail( ({ "anblick" }),
		"Grauenvoll, furchteinfloessend, zerstoererisch, ekelhaft,...");

	AddDetail( ({ "geist" }),
		"Der Anblick koennte Dir Deinen Verstand rauben!");

	AddDetail( ({ "verstand" }),
		"Naja sowas kannst Du bei Dir beim besten Willen nicht erkennen.");

	AddDetail( ({ "wille" }),
		"Auch mit dem besten Willen findest Du an Dir nicht mal ein wenig "
		"Verstand.");

	AddDetail( ({ "fuesse", "fuss" }),
		"Unter Deinen Fuessen kannst Du seltsame Zeichen erkennen, die in "
		"den Marmor gemeisselt wurden. ");

	AddDetail( ({ "zeichen" }),
		"Zeichen in einer Dir fremden Sprache wurden in den Marmor gemeisselt. "
		"Von wem ist Dir unklar, vielleicht waren es die Shogotten?");

	AddDetail( ({ "shogotte", "shogotten" }),
		"Die Shogotten wurden von den Grossen Alten erschaffen um ihnen zu "
		"dienen.");

	AddDetail( ({ "diener" }),
		"Shogotten!");

	AddDetail( ({ "sprache" }),
		"Du kannst nicht erkennen um welche Sprache es sich handelt. "
		"Dennoch kannst Du ja vielleicht einzelne Woerter entziffern?");

	AddDetail( ({ "woerter" }),
		"Ob Du sie entziffern kannst?");

	AddReadDetail( ({ "zeichen", "woerter" }),
		"Du kannst kaum etwas erkennen. Versuch doch einmal einzelne Woerter "
		"zu entziffern.");
	
	AddDetail( ({ "kraft" }),
	 	"Eine gewaltige Kraft muss hier am Werk gewesen sein. ");

	AddSpecialDetail( ({ "werk" }), "werkfunc");  

	AddDetail( ({ "sicherheit" }),
		"Ganz sicher.");

	AddDetail( ({ "beispiel" }),
		"Ein einfaches Beispiel, nur so dahingeschrieben.");

	AddDetail( ({ "grossen", "grosse" }),
		"Du meinst die Grossen Alten?");

	AddDetail( ({ "boden" }),
		"Der Boden unter Dir ist aus poliertem Marmor. Es muss Jahre "
		"gedauert haben um ihn so glatt zu bekommen. An einigen Stellen "
		"wurden Zeichen in ihn eingraviert.");

	AddDetail( ({ "gravur" }),
		"Meinst Du die Zeichen im Boden?");

	AddDetail( ({ "jahre", "jahr" }),
	   	"Noch nie hast Du so einen glatt polierten Marmorboden gesehen.");

	AddDetail( ({ "marmorboden" }),
		"Wie der Name schon sagt ist der Marmorboden aus Marmor.");

	AddDetail( ({ "name" }),
		"Hoffentlich vergisst Du Deinen nicht, wenn Dir einmal die "
		"Grossen Alten erscheinen.");

	AddDetail( ({ "marmor" }),
		"Sowohl der Boden als auch die Saeulen bestehen aus schwarzem polierten "
		"Marmor. ");

	AddDetail( ({ "saeulen", "saeule" }),
		"Grosse maechtige Saeulen umschliessen den Raum in dem Du stehst."
		"Sie wurden aus schwarzem Marmor gefertigt und es wirkt so als wuerden "
		"sie bis in den Himmel thronen.");

	AddDetail( ({ "himmel" }),
		"Den kannst Du von hier nicht sehen.");

	AddDetail( ({ "raum" }), QueryProp(P_INT_LONG));

	AddDetail( ({ "stelle", "stellen" }),
	        "An einigen Stellen wurden Zeichen in den Boden gemeisselt.");

	AddDetail( ({ "mitte" }),
		"In der Mitte befindet sich ein imposanter Brunnen aus schwarzem "
		"Lavagestein. In ihm kannst Du eine dunkle Bruehe entdecken.");

	AddDetail( ({ "luftzug", "luft" }),
	        "Eisig kalte Luft erfuellt den ganzen Raum.");

	AddDetail( ({ "zischen" }),
	        "*zisch*");

	AddDetail( ({ "wand", "waende" }),
		"Hier gibt es keine Waende, durch die Saeulenboegen kannst Du in "
		"alle Himmelsrichtungen gehen.");

	AddDetail( ({ "himmelsrichtungen", "richtungen", "richtung" }),
		"Norden, Osten, Sueden, Westen, ...");

	AddDetail( ({ "saeulenboegen", "boegen" }),
		"Durch sie hindurch kommst Du in andere Raeume.");

	AddDetail( ({ "raeume" }),
		"Du musst selbst hingehen um Naeheres erkennen zu koennen.");

	AddDetail( ({ "naeheres" }),
		"Geh hin!");

	AddDetail( ({ "norden", "osten", "westen", "sueden", "nordosten", "nordwesten",
		      "suedosten", "suedwesten" }),
		"In all diese Himmelsrichtungen kannst Du von hier aus gehen.");

	AddDetail( ({ "maechte", "macht" }),
		"Es gibt noch viel, dass Du zu lernen hast.");

	AddDetail( ({ "riss", "risse" }),
		"Risse in den Welten ermoeglichen groesseren Maechten einen "
		"Durchlass in diese Welt.");

	AddDetail( ({ "welt", "welten" }),
	 	"Was da alles passieren koennte wenn Risse in den Welten entstehen.");

	AddSmell(DEFAULT_SMELL, "Du kannst den eisig kalten Luftzug foermlich riechen.");

	AddSmell( ({ "luftzug", "luft" }),
	 	"Eisig kalte Luft fuellt Deine Lungen bei jedem Atemzug.");

	AddSmell( ({ "atem", "atemzug" }),
		"Es riecht einfach kalt!");

	AddSmell( ({ "lungen" }),
		"An Deinen Lungen kannst Du von hier aus nicht riechen!");


	AddSound(DEFAULT_SOUND, "Du hoerst ein leises Zischen.");

	AddSound( ({ "zischen" }),
		"Das Zischen scheint aus dem Brunnen zu kommen.");

	AddSound( ({ "brunnen" }),
		"Aus dem Brunnen kommt definitiv ein leises Zischen.");

	AddCmd( ({ "wirf", "werf", "werfe" }), "c_werfen");
	AddCmd( ({ "blick", "blicke" }), "c_blicken");
	AddCmd( ({ "zieh", "ziehe" }), "c_ziehen");
	AddCmd( ({ "spuere", "spuer" }), "c_spueren");
	AddCmd( ({ "entziffer", "entziffere", "entziffre" }), "c_entziffern");





}


string werkfunc()
{
	return(BS("Von Deinen "+TP->QueryProp(P_RACE)+"en Haenden kann so etwas "
		"mit Sicherheit nicht erschaffen worden sein."));
	
}


int c_werfen(string str)
{
	if(str != "blick in brunnen" &&
	   str != "blick" )
	{
		notify_fail("Was moechtest Du werfen?\n");
		return 0;
	}
	else
	{
		write(BS("Blick doch einfach in den Brunnen!"));
		return 1;
	}
}

int c_blicken(string str)
{
	if(str != "in brunnen"  &&
	   str != "in wasser"   &&
	   str != "in brunnen rein"  &&
	   str != "in brunnen hinein" )
	{
		notify_fail("Wo moechtest Du reinblicken?\n");
		return 0;
	}
	else
	{
		write(BS("Du wirfst einen Blick in den Brunnen und Dir faellt sofort "
			 "ein sonderbares Etwas auf."));
		return 1;
	}
}

int c_ziehen(string str)
{
object ob;
	if(str != "an tentakel"   &&
	   str != "tentakel"      )
	{
		notify_fail("Woran moechtest Du ziehen?\n");
		return 0;
	}
	if(anz_yibb < 1 || objectp(present("\nalter", this_object())))
	{
		write("Das Wasser schlaegt seltsame Wellen...\n"
			 "\n"
			 "Aber nichts passiert.\n");
		say(CTPN+ " stierlt im Wasser.\n");
		return 1;
	}
	else
	{
		write("Du ziehst an dem Tentakel.\n"
		      "\n"
		      "Irgendetwas hat sich veraendert.\n");
		say(CTPN + " fordert Yibb-Tsstl heraus.\n");
		ob = clone_object(NPC "yibb");
		ob->move(TO, M_NOCHECK);
		anz_yibb--;
		return 1;
	}
}



int c_spueren(string str)
{
	if(str != "gestalt"   &&
	   str != "gestalten"  )
	{
		notify_fail("Was moechtest Du hier spueren?\n");
		return 0;
	}
	else
	{
		write(BS("Da! Schon wieder! Warum kannst Du sie nicht sehen?!"));
		return 1;
	}
}


int c_entziffern(string str)
{
	if(str != "woerter"  &&
	   str != "zeichen"  &&
	   str != "einzelne woerter" )
	{
		notify_fail("Was moechtest Du entziffern?\n");
		return 0;
	}
	else
	{
		write(BS("Yibb-Tsstl, Shubb-Niggurath, Azathoth, Nyarlathothep, "
			 "Shudde-M'ell, Cthuga, Hastur, Tsathoggua, Shodagoi, "
			 "Glaaki, Wendigo, Cthulhu."));
		return 1;
	}
}

