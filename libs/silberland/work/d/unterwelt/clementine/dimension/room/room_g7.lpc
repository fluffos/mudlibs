
// shubb-niggurath


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"

int anz_shubb;

void reset()
{
	::reset();
	anz_shubb = 1;
}

void create()
{

  	::create();
	anz_shubb = 1;
	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG, 
		"An der Nordwand siehst Du eine grosse Freske, die von zwei "
		"Fackeln beleuchtet wird. Ein schwarzes Samtkissen liegt vor "
		"ihr, und wird wohl von den Shogotten zum Beten verwendet. "
		"Immer wieder hast Du das Gefuehl, als wuerde eine Hand Deine "
		"Schulter streifen, doch sobald Du versuchst sie zu fassen, und "
		"Dich umdrehst, scheint sie im Nichts verschwunden zu sein. "
		"Dein Gefuehl sagt Dir, dass es ratsam waere, hier nicht lange zu "
		"verweilen. ");
	SetProp(P_LIGHT, 1);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);

	AddExit( "sueden", ROOM "room_x7");


// DETAILBEGINN


	AddDetail( ({ "freske" }),
	   "Schon beim Hereinkommen ist Dir sofort die grosse graessliche "
	   "Freske an der Nordwand aufgefallen. Sie zeigt eine Kreatur "
	   "aehlich einer Ziege mit tausend Jungen. Rechts und links von "
	   "der Freske befindet sich je eine Fackel.");

	AddDetail( ({ "fackeln", "fackel" }),
	   "Zwei Fackeln sind an der Nordwand befestigt worden. Eine rechts, eine "
	   "links neben der grauenvollen Freske.");

	AddDetail( ({ "junge", "jungen" }),
	   "Du erkennst eine Art Ziege mit tausend Jungen.");

	AddDetail( ({ "ziege" }),
	   "Irgendetwas sagt Dir dass es sich hierbei um "
	   "Shubb-Niggurath handelt.");

	AddDetail( ({ "shubb", "shubb niggurath", "shubb-niggurath",
			       	"niggurath" }),
	   "Eine der Grossen Alten. Selten hast Du etwas Grauenvolleres "
	   "gesehen als dieses Bild.");

	AddDetail( ({ "bild" }),
	   "Na die Freske.");

	AddDetail( ({ "grauenvolleres", "grauenvolles" }),
	   "Kennst Du etwas, dass noch haesslicher ist?");

	AddDetail( ({ "gefuehl" }),
	   "Dein Gefuehl sagt Dir, dass es wohl besser waere "
	   "wieder nach Sueden zu gehen.");

	AddDetail( ({ "sueden" }),
	   "Nach Sueden gehts in einen anderen Raum.");

	AddDetail( ({ "raum" }),
	   "Momentan befindest Du Dich in einer Art Altarraum "
	   "fuer Shubb-Niggurath.");

	AddDetail( ({ "altarraum" }), QueryProp(P_INT_LONG));

	AddDetail( ({ "samtkissen", "kissen" }),
	   "Das Samtkissen liegt vor der Freske. Du kannst zwei "
	   "leichte Vertiefungen im Samt erkennen.");

	AddDetail( ({ "samt" }),
	   "Das Kissen besteht aus schwarzem Samt.");

	AddDetail( ({ "vertiefungen" }),
	   "Eigentlich sind es wohl eher zwei leichte Mulden.");

	AddDetail( ({ "mulden", "mulde" }),
	   "Scheint als waere hier vor kurzem noch jemand gekniet.");

	AddDetail( ({ "alte", "alten", "grosse alte" }),
	   "Irgendwo warten sie und lauern bis ihre Zeit reif ist... ");

	AddDetail( ({ "zeit" }),
	   "Wenn die Zeit reif ist kehren die Grossen Alten zurueck.");

	AddDetail( ({ "hereinkommen" }),
	   "Die Freske ist Dir natuerlich gleich aufgefallen. "
	   "Du bist ja ein Checka!");

	AddDetail( ({ "checka" }),
	   "Du siehst alles.");

	AddDetail( ({ "art" }),
	   "Art oder Unart - das ist hier die Frage.");

	AddDetail( ({ "frage" }),
	   "Wo ist eine?");

	AddDetail( ({ "unart" }),
	   "Unart oder unartig?");

	AddDetail( ({ "unartig" }),
	   "Es gibt einige Spieler die unartig sind.");

	AddDetail( ({ "spieler" }),
  	   "Einige der Spieler sind wirklich unartig. Ich koennte hier "
	   "auch einige Exemplare auffuehren, aber das interessiert "
	   "Dich vermutlich eher weniger.");

	AddDetail( ({ "exemplare" }),
	   "Naja es gibt so einige... den Rest behalte ich lieber fuer mich.");

	AddDetail( ({ "rest" }),
	   "Meins, alles meins!!!");

	AddDetail( ({ "shogotten", "shogotte" }),
	   "Scheinbar benutzen sie das Kissen um zu Beten. Sehen kannst Du "
	   "hier aber keine.");

	AddDetail( ({ "beten" }),
	   "Du befindest Dich hier wohl in einem der Gebetsraeume "
	   "der Shogotten.");

	AddDetail( ({ "gebetsraum", "gebetsraeume" }),
	   "Genau da stehst Du - in einem Gebetsraum.");

	AddDetail( ({ "waende", "wand" }),
	   "Die Waende bestehen (wie sollte es auch anders sein) aus Stein. "
	   "Nur die Nordwand unterscheidet sich etwas von den anderen.");

	AddDetail( ({ "nordwand" }),
	   "An der Nordwand siehst Du die Freske.");

	AddDetail( ({ "stein" }),
	   "Der Stein in diesem Raum ist kalt und steinig.");

	AddDetail( ({ "steinig" }),
	   "Steinig ist mein Weg bis daher auch ;)");

	AddDetail( ({ "weg" }),
	   "Ein langer Weg... :)");

	AddDetail( ({ "kreatur" }),
	   "Die Freske zeigt eine Kreatur, die einfach furchtbar aussieht.");

	AddDetail( ({ "boden" }),
	   "Der Boden ist unter Dir und Du willst ihn gar nicht erforschen.");

	AddDetail( ({ "decke" }),
	   "Die Decke ist viel zu hoch oben, als dass Du von hier "
	   "etwas erkennen koenntest.");

	AddDetail( ({ "etwas" }),
	   "?");

	AddDetail( ({ "hand" }),
	   "Dir kommt es staendig so vor, als wuerde eine Hand Deine "
	   "Schulter streifen. Doch wenn Du Dich umdrehst ist nichts "
	   "zu sehen.");

	AddDetail( ({ "schulter" }),
           "Es fuehlt sich an, als wuerde jemand mit seiner Hand Deine Schulter "
   	   "streifen. Irgendwie gruselig!");

	AddDetail( ({ "nichts" }),
	   "Du siehst Nichts, Du spuerst Nichts, Du riechst sogar Nichts.");

//SOUNDS

	AddSound(DEFAULT_SOUND, "Nur manchmal hoerst Du ein leises Knistern "
	   "von den Fackeln. Die meiste Zeit herrscht hier aber absolute "
	   "Stille.");

	AddSound( ({ "knistern", "knister" }),
	   "Krkkkkslanfslldkg.");

	AddSound( ({ "krkkkkslanfslldkg" }),
 	   "Na so klingt das Knistern der Fackeln.");

	AddSound( ({ "zeit" }),
	   "Die Zeit schleicht lautlos...");

	AddSound( ({ "schleichen" }),
	   "Nichts zu hoeren.");

	AddSound( ({ "stille" }),
	   "Richtig angenehme Stille - wie es beim Beten ja sein sollte.");

	AddSound( ({ "beten" }),
	   "Du hoerst niemanden beten.");

	AddSound( ({ "niemand", "niemanden", "niemandem" }),
	   "Wo ist Niemand?!");


//SMELLS

	AddSmell(DEFAULT_SMELL, "Irgendetwas stinkt hier gewaltig.");

	AddSmell( ({ "gestank" }),
	   "Ein bisschen wie in einem Stall.");

	AddSmell( ({ "stall" }),
	   "Igitt!");

	AddSmell( ({ "nichts" }),
	   "Nichts riecht auch nach Nichts... aber irgendwie poekelt es "
	   "hier leicht.");

	AddSmell( ({ "poekeln", "poekel" }),
	   "Es riecht definitiv nach Ziege.");

	AddSmell( ({ "ziege" }),
	   "Hier riechts definitiv nach Ziege.");


//COMMANDS


	AddCmd( ({ "knie", "kniee" }), "c_knien");
	AddCmd( ({ "erforsche", "erforsch" }), "c_erforschen");
	
}


int c_knien(string str)
{
	if(str != "auf kissen"  &&
	   str != "auf samtkissen" )
	{
		notify_fail("Worauf moechtest Du knien?\n");
		return 0;
	}
	if(anz_shubb < 1)
	{
		write(BS("Du kniest Dich kurz hin, doch nichts passiert."));
		return 1;
	}
	else
	{
		write(BS("Du kniest Dich auf das Kissen und fuehlst Dich "
			"gleich etwas erholter."));
		TP->heal_self(160);
		say(CTPN + " huldigt Shubb-Niggurath.\n");
		anz_shubb--;
		return 1;
	}
}

int c_erforschen(string str)
{
	if(str != "boden" )
	{
		notify_fail("Was moechtest Du erforschen?\n");
		return 0;
	}
	else
	{
		write(BS("DEN BODEN WILLST DU NICHT ERFORSCHEN! GRUMMEL!!"));
		say(CTPN+ " macht sich bei Clementine unbeliebt.");
		return 1;
	}
}

		
