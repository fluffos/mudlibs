
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"

int anz_schatten;
int anz_cthuga;

void reset()
{
	::reset();
	anz_schatten = 1;
	anz_cthuga = 1;
}

void create()
{

  	::create();
	anz_schatten = 1;
	anz_cthuga = 1;
	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG, 
		"Der Weg endet an einer steinernen Mauer, die wohl erst "
		"nachtraeglich aufgestellt wurde. Auch die Decke ist hier niedriger "
		"als in den restlichen Raeumen der Tempelanlage. Die Luft ist "
		"heiss und drueckend, sodass Dir jeder Atemzug schwer faellt. "
		"Ein kleiner Altar steht in der Mitte des Raumes, auf ihm eine "
		"blutrote Kerze, deren flackernde Flamme seltsame dunkle Schatten "
		"an die Wand wirft, und ein Bildnis einer schrecklichen Kreatur. "); 
	SetProp(P_LIGHT, 1);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);

	AddExit( "suedosten", ROOM "room_x8");


	AddDetail( ({ "weg" }),
	   "Der Weg endet hier an einer steinernen Mauer. Nach Suedosten fuehrt er "
	   "wieder zum Saeulengang.");

	AddDetail( ({ "Saeulengang", "gang" }),
	    "Nach Suedosten kommst Du wieder in den Saeulengang.");

	AddDetail( ({ "suedosten" }),
	    "Du kannst Dich dort ruhig umsehen. Von hier aus wirst Du allerdings "
	    "sehr wenig erkennen.");

	AddDetail( ({ "mauer" }),
	    "Die Mauer duerfte erst im Nachhinein aufgestellt worden sein. Irgendwie "
	    "sagt Dir Dein Gefuehl, dass Du gar nicht so genau wissen willst, was "
	    "sich dahinter befindet. ");

	AddDetail( ({ "gefuehl" }),
	    "Man sollte immer auf seine Gefuehle hoeren! Oft bewahrt Dich Dein "
	    "Gefuehl vor so manchen Misserfolgen.");

	AddDetail( ({ "misserfolg" }),
	    "Zum Beispiel ein ploetzlicher Tod durch ein Monster, was wider Erwarten "
	    "ganz ploetzlich an irgendwelchen dunklen Orten auftaucht.");

	AddDetail( ({ "monster" }),
	    "Ist hier eines?");

	AddDetail( ({ "erwarten", "erwartung" }),
	    "Hach ja.... Erwartungen gibt es viele.");

	AddDetail( ({ "orte", "ort" }),
	    "So Orte wie hier z.B..");

	AddDetail( ({ "beispiel" }),
	    "War nur so dahingesagt...");

	AddDetail( ({ "nachhinein" }),
	    "Die Mauer wurde erst spaeter aufgestellt. Frueher war hier wohl ein "
	    "grosses Loch.");

	AddDetail( ({ "loch" }),
	    "Hier ist keines mehr zu sehen. Vermutlich war aber frueher statt der "
	    "Mauer ein grosses Loch.");

	AddDetail( ({ "mitte" }),
	    "Der Raum hat eine Mitte. Und genau in dieser Mitte steht ein Altar. ");

	AddDetail( ({ "raum" }), QueryProp(P_INT_LONG));

	AddDetail( ({ "altar" }),
	    "Auf dem Altar steht eine blutrote Kerze, deren Flamme seltsame Schatten "
	    "wirft. ");

	AddDetail( ({ "kerze" }),
	    "Die Kerze ist blutrot. Ihre Flamme flackert unruhig und wirft dabei "
	    "auch den dunklen Schatten einer schrecklichen Kreatur an die Wand.");

	AddDetail( ({ "flamme" }),
	    "Unruhig flackert die Flamme der Kerze nervoes auf und ab. Als wuerde sie "
	    "auf etwas warten... ");

	AddDetail( ({ "wachs" }),
	    "Die Kerze besteht aus blutrotem Wachs.");

	AddDetail( ({ "kreatur" }),
	    "Das Bildnis einer furchteinfloessenden Kreatur wird an die Wand "
	    "projeziert. Beim Gedanken daran, dass Du dieser Kreatur vielleicht "
	    "begegnen wirst, wird Dir ganz schlecht.");

	AddDetail( ({ "bildnis" }),
	    "Du bekommst es mit der Angst zu tun.");

	AddDetail( ({ "angst" }),
	    "Lieber schnell weg hier...");

	AddDetail( ({ "gedanken", "gedanke" }),
	    "In Gedanken begegnet Dir gerade Cthuga, der Flammende.");

	AddDetail( ({ "cthuga" }),
	    "Cthuga, der Flammende - der Schatten an der Wand zeigt sein Bildnis. Du "
	    "bist Dir ganz sicher. Er gehoert zu den Grossen Alten und im Dunklen "
	    "moechtest Du ihm noch weniger begegnen als im Hellen.");

	AddDetail( ({ "dunkel", "dunkles", "dunklem", "hell", "helles", "hellem" }),
	    "Weder im Dunklen noch im Hellen moechtest Du auch nur irgendeinem der "
	    "Grossen Alten begegnen. ");

	AddDetail( ({ "grosse alte", "alte" }),
	    "Du solltest wirklich auf der Hut sein.");

	AddDetail( ({ "hut" }),
	    "Gib Acht auf Dich!");

	AddDetail( ({ "acht" }),
	    "Aufpassen sollst Du - vorallem dass Du Dich nicht zu Tode forscht...");

	AddDetail( ({ "tode" }),
	    "Die Tode des Herrn sind unergruendlich.");

	AddDetail( ({ "herr", "herren", "herrn" }),
	    "Amen.");

	AddDetail( ({ "amen" }),
	    "Du beendest Dein seltsames Gebet mit einem Amen.");

	AddDetail( ({ "gebet" }),
	    "Vielleicht solltest Du einmal zu Cthuga beten?");

	AddDetail( ({ "schatten" }),
	    "Es scheint, als koennten sie jeden Moment zum Leben erwachen, und "
	    "Dich in den Tod ziehen. ");

 	AddDetail( ({ "decke" }),
	    "Die Decke ist hier sehr niedrig. Alles wird eng und bedrueckend. "
    	    "Jeder Atemzug faellt Dir schwer.");

	AddDetail( ({ "atemzug", "atmen" }),
	    "Das Atmen faellt Dir schwer. Die Luft ist heiss und trocken und steht "
	    "foermlich.");

	AddDetail( ({ "luft" }),
	    "Heiss, stickig, unertraeglich.");

	AddDetail( ({ "boden" }),
	    "Der Boden besteht aus Stein. Um den Altar herum ist ein Kreis in ihn "
	    "eingemeisselt.");

	AddDetail( ({ "kreis" }),
	    "Ein Kreis ist in den Boden genau um den Altar eingemeisselt. Was er fuer "
	    "einen Sinn macht?");

	AddDetail( ({ "sinn" }),
	    "Vielleicht solltest Du Dich einfach in den Kreis stellen?");

	AddDetail( ({ "stein" }),
	    "Der Boden und die Waende bestehen aus Stein. Er ist warm.");

	AddDetail( ({ "wand", "waende", "steinwand", "steinwaende" }),
	    "Dunkle Schatten werden von der Flamme auf die steinernen Waende "
	    "geworfen.");

	AddDetail( ({ "flammender", "flammende" }),
	    "Cthuga wird auch der Flammende genannt.");

	AddDetail( ({ "raeume" }),
	    "Du musst schon nach Suedosten gehen um die anderen zu erforschen.");

	AddDetail( ({ "tod" }),
	    "Es scheint als koennten die Schatten jeden Moment zum Leben erwachen und "
	    "Dich toeten.");

	AddDetail( ({ "leben" }),
	    "Du lebst, der Schatten etwa auch?!");

	AddDetail( ({ "tempelanlage", "tempel", "anlage" }),
	    "Du befindest Dich in einer grossen Tempelanlage. Aber das hast Du ja schon "
	    "beim Eingang bemerkt, nicht wahr?!");

	AddDetail( ({ "eingang" }),
	    "Du bist beim Eingang in die Anlage hineingekommen. Bei Yogsothoth vorbei.");

	AddDetail( ({ "yogsothoth" }),
	    "Yogsothoth, der Waechter des Tores.");

	AddDetail( ({ "waechter" }),
	    "Yogsothoth.");

	AddDetail( ({ "tor" }),
	    "Du weisst schon... das Tor!!!");

//SMELLS


	AddSmell(DEFAULT_SMELL, "Es ist heiss und stickig hier. "
			"Die Luft steht foermlich.");

	AddSmell( ({ "luft" }),
	   "Du kannst kaum tief einatmen so stickig ist es hier.");


//SOUNDS

	AddSound(DEFAULT_SOUND,
	   "Es ist fast still hier. Nur manchmal knistert das Wachs der Kerze "
	   "ein wenig.");

	AddSound( ({ "kerze" }),
	   "*knister* *knister*");

	AddSound( ({ "wachs" }),
	   "Das Wachs der Kerze knistert etwas.");

	AddSpecialDetail( ({ "moment" }), "momentfunc");

	AddCmd( ({ "bet", "bete" }), "c_beten");
	AddCmd( ({ "stell", "stelle" }), "c_stellen");

}

int c_beten(string str)
{
	if(str != "zu cthuga")
	{
		notify_fail("Zu wem moechtest Du beten?\n");
		return 0;
	}
	else
	{
		write(BS("Du betest zu Cthuga und fuehlst wie eine Flamme "
			"Deinen Koerper durchfaehrt."));
		TP->do_damage(15);
		say(CTPN + " hat den Verstand verloren.\n");
		return 1;
	}
}

int c_stellen(string str)
{
	if(str != "in kreis" )
	{
		notify_fail("Wohin moechtest Du Dich stellen?\n");
		return 0;
	}
	if(anz_cthuga < 1)
	{
		write(BS("Du stellst Dich in den Kreis, doch nichts passiert. "
			"Enttaeuscht trittst Du wieder einen Schritt zurueck."));
		return 1;
	}
	else
	{
		write(BS("Als Du Dich in den Kreis stellst fuehlst Du Dich gleich "
			"etwas besser. Froehlich trittst Du wieder einen "
			"Schritt zurueck."));
		TP->heal_self(150);
		anz_cthuga--;
		return 1;
	}
}

string momentfunc(string str)
{
object ob;
	if(anz_schatten <1)
	{
		write(BS("Die Schatten sehen wirklich sehr echt aus."));
		return "";

	}
	else
	{
		
		write(BS("Die Schatten sehen so aus, als koennten sie jeden "
			"Moment zum Leben erwachen."));

		ob =clone_object(NPC "schatten");
		ob->move(TO, M_NOCHECK|M_SILENT );
		anz_schatten--;
		return "";
	}
}


