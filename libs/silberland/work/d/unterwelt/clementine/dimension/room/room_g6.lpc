//Glaaki gewidmet
//In Gedaermen ist noch ne lebende Trollhand (Arnolds wenn ich ihn erwisch)


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"

int anz_glaaki;
int anz_hand;

void reset()
{
	::reset();
	anz_glaaki=1;
	anz_hand=1;
}

void create()
{

  	::create();
	anz_glaaki=1;
	anz_hand=1;
	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG, 
		"Der steinerne Boden ist rot getraenkt. Anscheinend hat hier "
		"erst kuerzlich ein Massaker stattgefunden. Ein suesslicher "
	        "Geruch von Blut und Gedaermen sticht Dir in die Nase. "
	        "Er kommt aus einer der Ecken, es ist aber sehr fragwuerdig "
	        "ob Du der Sache wirklich auf den Grund gehen moechtest. "
		"Du hast das ungute Gefuehl, als ob Du nicht der einzige bist, "
		"der sich momentan hier aufhaelt. ");
	SetProp(P_LIGHT, 0);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);

	AddExit( "suedwesten", ROOM "room_x6");


//DETAILBEGINN


	AddDetail( ({ "boden" }),
	   "Der Boden ist voller Blut. In einer der Ecken kannst Du sogar noch "
	   "Gedaerme ausmachen.");

	AddDetail( ({ "stein" }),
	   "Alles ist hier aus Stein, der von einer leichten Blutschicht "
	   "zumindest am Boden ueberzogen wird. ");

	AddDetail( ({ "blutschicht", "schicht" }),
	   "Der Boden ist von einer Blutschicht ueberzogen. An den Waenden "
	   "kannst unzaehlige Blutsspritzer ausmachen. Igitt!");

	AddDetail( ({ "blutsspritzer", "spritzer", "blutspritzer" }),
	   "Die steinernen Waende haben alle rote Blutsspritzer. Scheinbar "
	   "hat hier erst vor kurzem ein Kampf stattgefunden.");

	AddDetail( ({ "kampf" }),
	   "Bist Du bereit fuer einen Kampf?");

	AddDetail( ({ "ecke", "ecken" }),
	   "In einer der Ecken kannst Du Gedaerme ausmachen. Sie sehen "
	   "irgendwie menschlich aus.");

	AddDetail( ({ "gedaerme", "gedarm", "darm", "daerme" }),
	   "Die Gedaerme sind noch warm und vermutlich humanoiden Ursprungs. "
	   "Wem sie wohl gehoerten?");

	AddDetail( ({ "troll" }),
	   "Du bist Dir ganz sicher, dass die Gedaerme einem Troll "
	   "gehoerten. Aber welchem?");

	AddDetail( ({ "arnold" }),
	   ":)");

	AddDetail( ({ "ursprung" }),
	   "Als Du Dir die Gedaerme naeher ansiehst, faellt Dir unter ihnen "
	   "etwas auf.");

	AddDetail( ({ "etwas" }),
	   "Da scheint etwas zu liegen!!! Zumindest zuckt hier noch etwas."
	   "Vielleicht koenntest Du ja einmal in den Gedaermen wuehlen?");

	AddDetail( ({ "lebendiges", "lebendes" }),
	   "Lebt hier noch etwas?");


	AddDetail( ({ "blut" }),
	   "Alles ist mit Blut getraenkt. Suesslicher Geruch steigt Dir "
	   "in die Nase. Teilweise riecht es auch schon verfault.");

	AddDetail( ({ "geruch" }),
	   "Geruch wird geriiiiiiiiiiecht!");

	AddDetail( ({ "sache" }),
	   "Interessant waere es schon zu wissen, wer hier vor kurzem "
	   "abgeschlachtet wurde.");

	AddDetail( ({ "decke" }),
	   "Die Decke ist so hoch ueber Dir - die kannst Du von hier aus "
	   "gar nicht erkennen. Sie verlaeuft sich irgendwo da oben im "
	   "schwarzen Nichts.");

	AddDetail( ({ "schwarzes nichts", "nichts", "schwarz" }),
	   "Irgendwo da oben ist die Decke.");

	AddDetail( ({ "gefuehl" }),
	   "Deine innere Stimme sagt Dir, dass Du vermutlich nicht der "
	   "einzige bist, der sich hier aufhaelt. ");

	AddDetail( ({ "einziger", "einzige" }),
	   "Du bist nicht alleine...");

	AddDetail( ({ "allein" }),
	   "Allein, allein, allein, allein... Du bist niemals allein! Aber "
	   "das ist ein anderes Kapitel.");

	AddDetail( ({ "kapitel" }),
	   "...");

	AddDetail( ({ "grund" }),
	   "Es gibt mindestens einen Grund warum Du hier nicht "
	   "weiterforschen solltest, wenn Du nicht kaempfen willst. Oder "
	   "meinst Du, dass das Blut hier nur aufgemalt ist?");

	AddDetail( ({ "massaker" }),
	   "Ueberall Blut... ein einzelnes Chaos. Mit welchem der Grossen "
	   "Alten das wohl zu tun haben mag?");

	AddDetail( ({ "chaos" }),
	   "Gedaerme zu Hauf, uebereinander, Blutspritzer, ...");

	AddDetail( ({ "hauf", "haufen" }),
	   "In einer Ecke siehst Du einen Haufen mit Innereien.");

	AddDetail( ({ "innereien" }),
	   "Dich ekelt.");

	AddDetail( ({ "grosse alte", "alte", "alten" }),
	    "Du tippst auf Glaaki.");

	AddDetail( ({ "glaaki" }),
	    "Sehen kannst Du ihn nicht, aber spueren vermutlich.");

	AddDetail( ({ "kometengeborener", "geborener" }),
	    "Glaaki, der Kometengeborene - sein Zorn ist unendlich.");

	AddDetail( ({ "zorn" }),
	    "Huete Dich vor ihm!");

	AddDetail( ({ "stimme" }),
	    "Hoerst Du ausser Deiner inneren Stimme noch andere?");

	AddDetail( ({ "wand", "waende" }),
	    "Die Waende sind voller Blutsspritzer. Irgendetwas hat hier wohl "
	    "maechtig jemanden zerfleischt.");

	AddDetail( ({ "irgendetwas" }),
	    "Scheint wohl Glaaki gewesen zu sein. Ist er zurueckgekehrt?");

//SOUNDS

	AddSound(DEFAULT_SOUND, "Alles still... oder etwa nicht?");

	AddSound( ({ "stimme" }),	
	    "Deine innere Stimme empfiehlt Dir nach Suedwesten zu gehen.");

	AddSound( ({ "suedwesten" }),
	    "Hoeren kannst Du nichts.");
//SMELLS

	AddSmell(DEFAULT_SMELL,
	   "Es riecht nach verfaulten Leichenteilen und Blut.");

	AddSmell( ({ "geruch" }),
	   "Es stinkt bestialisch!");

	AddSmell( ({ "teile", "leichenteile", "gedaerme", "koerperteile" }),
	   "Fuer so eine feine Nase wie Deine ist das hier wirklich "
	   "nichts.");

	AddSmell( ({ "nase" }),
	   "Vielleicht solltest Du Dir Deine Nase einfach zuhalten?");

	AddSmell( ({ "blut" }),
	   "Das Blut riecht suesslich, hat aber auch eine leicht "
	   "alkoholische Note.");

	AddSmell( ({ "note", "alkohol", "alkoholische note" }),
	   "Vermutlich hat der hier Zerschnetzelte kurz vor seinem Tod "
	   "noch etwas gekippt.");

	AddSmell( ({ "zerschnetzelte" }),
	   "Du riechst nur noch einzelne Koerperteile.");

	AddSmell( ({ "tod" }),
	   "Wie der Tod riecht? Vielleicht solltest Du lieber Lars danach "
	   "fragen.");

	AddSmell( ({ "lars" }),
	   "Riech bei Gelegenheit mal an ihm.");

	AddSmell( ({ "gelegenheit" }),
	   "Du wirst vermutlich bald die Gelegenheit dazu haben.");

	


//COMMANDS

	AddCmd( ({ "wuehl", "wuehle" }), "c_wuehlen");
	AddCmd( ({ "halt", "halte" }), "c_halten");
	AddCmd( ({ "spuer", "spuere" }), "c_spueren");
	
}


int c_wuehlen(string str)
{
	object ob;
	if(str != "in gedaermen" &&
	   str != "in daerme"    &&
	   str != "in gedaerme"  &&
	   str != "in daermen"   )
	{
		notify_fail("Worin moechtest Du wuehlen?\n");
		return 0;
	}
	if(anz_hand <1)
	{
		write(BS("Du wuehlst in den Gedaermen, kannst aber nichts "
		 "Lebendiges mehr entdecken."));
		say(CTPN + " wuehlt in Gedaermen. Iiieh!!\n");
		return 1;
	}
	else
	{
		write(BS("Du machst Dich wie ein Berserker an die Gedaerme "
		"ran und durchwuehlst sie. Da! Da ist etwas!"));
		ob=clone_object(NPC "trollhand");
		ob->move(TO, M_NOCHECK|M_SILENT);
		anz_hand--;
		say(CTPN + " wuehlt in Gedaermen.\n");
		return 1;
	}
}

int c_halten(string str)
{
	if(str != "nase zu"   &&
	   str != "nase"      )
	{
		notify_fail("Was moechtest Du zuhalten?\n");
		return 0;
	}
	if(anz_glaaki<1)
	{
		write(BS("Du haeltst Dir Deine Nase zu, doch besser wird "
					"es dadurch nicht."));
		say(CTPN + " spielt mit seiner Nase.\n");
		return 1;
	}
	else
	{
		write(BS("Du haeltst Dir die Nase zu und fuehlst Dich gleich "
			"besser."));
		say(CTPN + " sieht schon besser aus.\n");
		TP->heal_self(140);
		anz_glaaki--;
		return 1;
	}
}


int c_spueren(string str)
{
	if(str != "glaaki" )
	{
		notify_fail("Was moechtest Du hier spueren?\n");
		return 0;
	}
	else
	{
		write(BS("Du spuerst Glaaki den Kometengeborenen mit all "
		"seinem Zorn. Begegnen moechtest Du ihm definitiv nicht."));
		return 1;
	}
}


