
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"

void create()
{

	::create();

	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG, 
		"Du wanderst in einem schier endlos erscheinenden Gang "
		"aus Saeulen. "
		"Rechts und links von Dir ragen die ueberdimensionalen "
		"Pfeiler auf ihren maechtigen quadratischen Sockeln in "
		"die Hoehe, und verlaufen sich dort im schwarzen Nichts. "
		"Aus dem Norden sind manchmal Schreie zu vernehmen, "
		"ein mulmiges Gefuehl macht sich in Dir breit. Im "
		"Sueden siehst Du einen Brunnen. ");
	SetProp(P_LIGHT, 0);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);
	
	AddExit( "westen", ROOM "room_x8");
	AddExit( "osten", ROOM "room_x6");
	AddExit( "sueden", ROOM "alte");
	AddExit( "norden", ROOM "room_g7");


//DETAILBEGINN

	AddDetail( ({ "schrei", "schreie" }),
	  "Sehen kannst Du keine, aber vielleicht hoeren?");

	AddDetail( ({ "hoehe" }),
	  "Das ist ja wohl die Hoehe, dass die Hoehe hier so hoch ist!");

	AddDetail( ({ "saeulen", "saeule", "pfeiler", "steinpfeiler" }),
	  "Die Saeulen interessieren Dich grad ueberhaupt nicht. Der "
	  "Brunnen sieht viel aufregender aus!");

	AddDetail( ({ "brunnen" }),
	  "Der Brunnen im Sueden erweckt wirklich Deine Neugierde.");

	AddDetail( ({ "neugierde" }),
	  "Er sieht sehr magisch aus!");

	AddDetail( ({ "sueden" }),
	  "Um in den Sueden zu kommen muesstest Du Dich wenigstens etwas "
	  "bewegen.");

	AddDetail( ({ "wand", "waende" }),
	  "An einer der Waende siehst Du einen kleinen schwarzen Punkt.");

	AddDetail( ({ "punkt", "schwarzer punkt" }),
	  "Ein kleiner schwarzer Punkt ist an der Wand. Vielleicht "
	  "solltest Du ihn einmal naeher betrachten?");

	AddDetail( ({ "kaefer" }),
	  "Der Kaefer ist klein und schwarz und irgendwie findest Du ihn "
	  "recht ekelig. Du kannst ihn sicherlich zerdruecken.");

	AddDetail( ({ "decke" }),
	  "Die Decke ist ganz schwarz. So schwarz, dass Du sie von "
	  "hier nicht erkennen kannst.");

	AddDetail( ({ "schwarz" }),
	  "Ganz schwarz!");

	AddDetail( ({ "nichts" }),
	  "Erklaer mir bitte, wie Du Nichts untersuchen willst?");

	AddDetail( ({ "gefuehl" }),
	  "Du hast ein mulmiges Gefuehl im Magen.");

	AddDetail( ({ "magen" }),
	  "Das Gefuehl macht sich in Deinem ganzen Magen breit. ");

	AddDetail( ({ "raum", "gang" }), QueryProp(P_INT_LONG));

	AddDetail( ({ "mistviech" }),
	  "So eine Rotznase!");

	AddDetail( ({ "rotznase" }),
	  "Eine richtige Rotzruebe! Beisst Dich da!");

	AddDetail( ({ "rotzruebe" }),
	  "Ein absoluter Rueckevolutionierer!");

	AddDetail( ({ "rueckevolutionierer" }),
	  "Gesichtsgulli!");

	AddDetail( ({ "gesichtsgulli" }),
	  "Gichthaxen!");

	AddDetail( ({ "gichthaxen" }),
	  "Heckenbefruchter!");

	AddDetail( ({ "heckenbefruchter" }),
	   "Schiffsschaukelbremser!");

	AddDetail( ({ "schiffsschaukelbremser" }),
	   "Servolenker!");

	AddDetail( ({ "servolenker" }),
	   "Zitronenschuettler!");

	AddDetail( ({ "zitronenschuettler" }),
	   "Zipfelklatscher!");

	AddDetail( ({ "zipfelklatscher" }),
	  "Tschurifetzen!");

	AddDetail( ({ "tschurifetzen" }),
	  "Brauchst einen? ;)");


	AddDetail( ({ "boden" }),
	  "Du stehst auf ihm und bist froh, dass er eben ist. Mehr "
	  "interessiert Dich aber wirklich nicht.");

	AddDetail( ({ "sockel", "sockeln" }),
	  "Sie sind quadratisch. Also viereckig. ");

	AddDetail( ({ "quadrat", "viereck" }),
	  "Die Sockel haben vier Ecken.");

	AddDetail( ({ "ecken", "eck" }),
	  "Vier.");

//SMELLS

	AddSmell(DEFAULT_SMELL,
	  "Es riecht nach Stein. ");

	AddSmell( ({ "stein" }),
	  "Du atmest tief ein. Richtig steinige Luft hier!");

	AddSmell( ({ "luft" }),
	  "Steinig!");

//SOUNDS

	AddSound(DEFAULT_SOUND, 
          "Manchmal hoerst Du Schreie. Sie kommen aus dem Norden.");

	AddSound( ({ "schreie", "schrei" }),
	  "Jetzt sind sie verstummt.");

	AddSound( ({ "norden" }),
	  "Momentan ist es ruhig.");



//COMMANDS

	AddCmd( ({ "betracht", "betrachte" }), "c_betrachten");
	AddCmd( ({ "zerdrueck", "zerdruecke" }), "c_zerdruecken");

}

int c_betrachten(string str)
{
	if(str != "punkt"   &&
	   str != "schwarzen punkt" )
	{
		notify_fail("Was moechtest Du hier betrachten?\n");
		return 0;
	}
	else
	{
		write(BS("Du betrachtest den Punkt eingehend und stellst "
			"fest, dass es sich hierbei um einen "
			"Kaefer handelt."));
		return 1;
	}
}

int c_zerdruecken(string str)
{
	if(str != "kaefer" )
	{
		notify_fail("Was moechtest Du hier zerdruecken?\n");
		return 0;
	}
	else
	{
		write(BS("Als Du versuchst den Kaefer zu zerdruecken "
			"beisst er Dir in die Hand. So ein Mistviech!"));
		TP->do_damage(12);
		say(CTPN + " wird von etwas Kleinem in die Hand gebissen.\n");
		return 1;
	}
}


