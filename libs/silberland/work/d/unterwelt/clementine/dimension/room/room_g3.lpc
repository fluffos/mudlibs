// CTHULHU - Statue
// fertig: 14.2.2009


inherit "std/room";
inherit "/gilden/bardengilde/obj/std_spellprovider";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../alte.h"
#include "/gilden/bardengilde/barden_extern.h"

int anz_cthulhu;

void reset()
{
	::reset();
	anz_cthulhu = 1;
}

void create()
{

  	::create();
	anz_cthulhu = 1;
	SetProp(P_INT_SHORT, "In einer Tempelanlage");
	SetProp(P_INT_LONG, 
		"Die Statue eines riesigen Wesens - halb Mensch, halb Tintenfisch - "
		"steht inmitten des Raumes, und floesst Dir gewaltigen "
		"Respekt ein. An ihrem Sockel kannst Du eine "
		"Inschrift ausfindig machen. Ein "
		"undurchsichtiger Nebel umgibt diese leblose Kreatur, sodass "
		"Du nicht einmal mehr die Waende um Dich herum zu erkennen "
		"vermagst. Haben sie da gerade die Augen dieses Monsters bewegt? ");
	SetProp(P_LIGHT, 0);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INDOORS, 1);

	AddExit( "nordosten", ROOM "room_x3");


  	AddDetail( ({ "nebel" }),
	  "Dichter, absolut undurchsichtiger Nebel umgibt die Statue dieser "
	  "leblosen Kreatur. Ist sie wirklich leblos, oder passiert gleich ein "
	  "Unglueck?!");

	AddDetail( ({ "leblose kreatur" }),
	  "Geh lieber nicht zu nah hin und fass die Statue auf gar keinen Fall "
	  "an!");

	AddDetail( ({ "fall" }),
	  "Wenn Dir Dein Leben lieb ist, dann tu was man Dir sagt!");

	AddDetail( ({ "unglueck" }),
	  "Da Du das Wort Unglueck noch untersuchen kannst, bist Du scheinbar "
	  "noch am Leben.");

	AddDetail( ({ "wort" }),
	  "Es gibt hier einige Worte.");

	AddDetail( ({ "worte", "woerter" }),
	  "Mehrere Worte aneinandergereiht ergeben Saetze.");

	AddDetail( ({ "saetze", "satz" }),
	  "Mehrere Saetze aneinandergereiht ergeben Geschichten.");

	AddDetail( ({ "geschichte", "geschichten" }),
	  "Geschichten gibt es einige, aber zum Untersuchen solltest Du "
	  "Dir dann doch den passenden Platz aussuchen.");

	AddDetail( ({ "untersuchen" }),
	  "Was moechtest Du untersuchen?");

	AddDetail( ({ "platz" }),
	  "Dieser Raum, in dem die Shogotten Cthulhu anbeten ist wohl kaum "
	  "der richtige Ort!");

	AddDetail( ({ "shogotten", "shogotte" }),
	  "Derzeit siehst Du keinen Shogotten.");

	AddDetail( ({ "ort" }),
	  "Geh doch einmal in eine Bibliothek!");

	AddDetail( ({ "bibliothek" }),
	  "Es gibt eine kleine in Polaris und zwei im Kristallwald.");

	AddDetail( ({ "polaris" }),
	  "Durch einen Riss in der Welt kamst Du von Polaris hier her.");

	AddDetail( ({ "riss", "welt" }),
	  "Der Riss zwischen den Welten scheint groesser zu werden.");

	AddDetail( ({ "welten" }),
  	  "Huete Dich vor dem Riss zwischen den Welten!");

	AddDetail( ({ "kristallwald" }),
	  "Der Kristallwald ist ganz weit weg von hier.");

	AddDetail( ({ "raum" }),
	  "Du befindest Dich in dem Raum eines Tempels.");


	AddDetail( ({ "leben" }),
	  "Verschwinde, solange es noch moeglich ist!");

	AddDetail( ({ "waende" }),
	  "Vielleicht gibt es hier ja gar keine und Du bist nur vom Nichts "
	  "umgeben. ");
	
	AddDetail( ({ "wand" }),
	  "Durch den undurchsichtigen Nebel kannst Du wirklich keine Wand "
	  "erkennen.");

	AddDetail( ({ "sockel" }),
	  "Der Sockel besteht wie die Statue auch aus Stein. Du kannst eine "
	  "Inschrift an ihm ausmachen.");

	AddDetail( ({ "inschrift" }),
	  "Eine Inschrift wurde in den Sockel gemeisselt. Du kannst sie "
	  "sicherlich lesen.");

	AddDetail( ({ "stein" }),
	  "Der Statue und der Sockel, auf dem die Statue thront bestehen aus "
	  "tiefschwarzem Felsgestein. ");

	AddDetail( ({ "gestein", "felsgestein", "fels" }),
	  "Das Felsgestein ist tiefschwarz und scheint auch nicht von normalen "
	  "Werkzeugen bearbeitbar zu sein. Welche enorme Macht wohl hier "
	  "am Werk gewesen sein muss?");

	AddDetail( ({ "werkzeuge", "werkzeug" }),
	  "Mit keinem Dir bekannten Werkzeug koenntest Du das Felsgestein "
	  "bearbeiten.");

	AddDetail( ({ "macht" }),
	  "Enorme, unmenschliche Macht muss hier am Werk gewesen sein.");

	AddDetail( ({ "werk" }),
	  "Die Statue muss ein Werk anderer Goetter gewesen sein.");

	AddDetail( ({ "goetter" }),
	  "Wer sie wohl sind?!");

	AddDetail( ({ "alte", "grosse alte", "alten", "grossen alten" }),
	  "Wenn die Sterne richtig stehen, werden sie zu neuem "
	  "Leben erwachen. Cthulhu ihr Anfuehrer wird auferstehen um "
	  "erneut seine Schreckensherrschaft ueber die Erde auszuueben.");

	AddDetail( ({ "herrschaft", "schreckensherrschaft" }),
	  "Er wird kommen und alles vernichten.");

	AddDetail( ({ "nichts" }),
	  "Das Nichts verschlingt alles, was ihm sich naehert!");

   	AddDetail( ({ "decke" }),
	  "Die Decke scheint weit ueber der Statue zu beginnen. Naeheres "
	  "laesst sich von hier unten nicht erkennen.");

	AddDetail( ({ "naeheres" }),
	  "Der Nebel laesst Dich nichts naeheres von hier unten erkennen.");

    	AddReadDetail( ({ "inschrift" }),
	  "**************************************\n"
	  "* Es ist nicht tot, was ewig liegt,  *\n"
	  "* bis dass die Zeit den Tod besiegt. *\n"
	  "**************************************\n");

	AddDetail( ({ "cthulhu" }),
	  "Die Statue zeigt Cthulhu - ein riesiges Wesen - halb Mensch, halb "
	  "Tintenfisch. Ihm moechtest Du nicht mal im Hellen begegnen.");

	AddDetail( ({ "statue" }),
	  "Vor Dir thront die riesige Statue eines grauenvollen Wesen. ");

	AddDetail( ({ "wesen" }),
	  "Halb Mensch, halb Tintenfisch - ein grauenvoller Anblick!");

	AddDetail( ({ "anblick" }),
	  "Deine Knie beginnen zu schlottern.");

	AddDetail( ({ "ausmass", "ausmasses", "ausmasse" }),
	  "Die Kreatur ist einfach riesig! Der Kopf aehnelt einem "
	  "Tintenfisch, das Gesicht besteht aus einem Gewirr von "
	  "Tentakeln. ");

	AddDetail( ({ "gewirr" }),
	  "Das Gesicht besteht aus vielen Tentakeln.");

	AddDetail( ({ "gesicht" }),
	  "Einfach grauenvoll! Es besteht aus einem Gewirr von Tentakeln.");

	AddDetail( ({ "tentakel" }),
	  "Dir ist, als ob sie sich bewegen...");

	AddDetail( ({ "knie" }),
	  "Dein Koerper will nur eines: weg von hier!");

	AddDetail( ({ "koerper" }),
	  "Noch ist Dein Koerper ganz... wielange noch?!");

	AddDetail( ({ "hellen" }),
	  "Dem Wesen, das die Statue darstellt moechtest Du nicht einmal im "
	  "Hellen begegnen.");

	AddDetail( ({ "mensch", "tintenfisch" }),
	  "Das Wesen der Statue ist halb Mensch, halb Tintenfisch.");

        AddDetail( ({ "erde" }),
	  "Du befindest Dich gerade in einem Tempel auf dieser Erde.");

	AddDetail( ({ "tempel" }),
	  "Du befindest Dich gerade in einem Tempel!");

	AddDetail( ({ "monster" }),
	  "Eine furchteinfloessende Kreatur immensen Ausmasses steht vor "
	  "Dir. Hoffentlich wird der Stein nicht lebendig!");

	AddDetail( ({ "stein" }),
	  "Du betest instaendig, dass der Stein nicht lebendig wird und "
	  "diese furchtbare Kreatur entweichen laesst.");

	AddDetail( ({ "kreatur" }),
	  "Du hast Angst!");

	AddDetail( ({ "augen" }),
	  "Die Statue scheint Dich mit ihrem Blick zu verfolgen. Als ob sie "
	  "jede Deiner Bewegungen aus dem Augenwinkel betrachtet und nur "
	  "auf den richtigen Zeitpunkt wartet.");

	AddDetail( ({ "zeitpunkt", "richtiger zeitpunkt" }),
	  "Der richtige Zeitpunkt um Dir den Kopf abzureissen.");

	AddDetail( ({ "kopf" }),
	  "Wenn Dir Dein Kopf lieb ist, dann verschwinde hier schleunigst.");

	AddDetail( ({ "augenwinkel" }),
	  "Dir wird ganz unheimlich!");

	AddDetail( ({ "raumes" }), QueryProp(P_INT_LONG));

	AddDetail( ({ "respekt" }),
	  "Das Aussehen der Statue floesst Dir gewaltigen Respekt ein.");

	AddDetail( ({ "aussehen" }),
	  "Wirklich furchteinfloessend!");

	AddDetail( ({ "angst" }),
	  "Angst ueberkommt Dich wenn Du die Statue siehst.");

	AddDetail( ({ "boden" }),
 	  "Der Boden ist pechschwarz. Er scheint aus Marmor gefertig worden "
  	  "zu sein.");

	AddDetail( ({ "marmor" }),
	  "Der Boden besteht aus pechschwarzem glatten Marmor. Der Nebel, "
	  "der die Statue umgibt macht es Dir jedoch unmoeglich Dein "
	  "Spiegelbild in ihm zu erkennen. ");

	AddDetail( ({ "spiegelbild" }),
	  "Es ist aufgrund des Nebels unmoeglich Dein Spiegelbild zu "
	  "erkennen.");

	AddDetail( ({ "seltsames" }),
	  "Das Seltsame sieht aus wie ein schwarzes Kissen. ");

	AddDetail( ({ "kissen" }),
	  "Tatsaechlich! Ein schwarzes Kissen liegt nicht sehr weit vor der "
	  "Statue auf dem kalten Marmorboden. ");

	AddDetail( ({ "marmorboden" }),
	  "Der Boden besteht aus Marmor.");

	AddDetail( ({ "schwarzes kissen" }),
	  "Vermutlich dient es den Shogotten zum Beten.");

	AddDetail( ({ "beten" }),
	  "Die Shogotten verehren jede dieser scheusslichen Kreaturen als "
	  "ihre allmaechtigen Herrscher.");

	AddDetail( ({ "herrscher" }),
	  "Du bist froh, wenn Du ihnen nicht begegnest.");

        AddDetail( ({ "blick" }),
	  "Unheimlich!");

	AddDetail( ({ "bewegungen", "bewegung" }),
	  "Die Statue scheint Dich zu beobachten.");

	AddDetail( ({ "blut" }),
	  "Sehen kannst Du keines!");

// SOUND

	AddSound(DEFAULT_SOUND, "Es herrscht absolute Stille.");

	AddSound( ({ "stille" }),
	   "Hier ist es absolut still... oder truegt der Schein?");

	AddSound( ({ "schein" }),
	   "Du hoerst kein Sterbenswoertchen.");

	AddSound( ({ "sterbenswoertchen", "woertchen" }),
	   "Absolute Stille.");

	AddSound( ({ "statue" }),
	   "In der Statue scheint es zu Knacksen.");

	AddSound( ({ "knacksen", "knacks" }),
	   "Dir wird ganz unheimlich!");

// SMELL

	AddSmell(DEFAULT_SMELL,
	    "Es riecht nach Moder.");

	AddSmell( ({ "moder" }),
	    "Scheint wohl von der Feuchtigkeit des Nebels zu stammen.");

	AddSmell( ({ "feuchtigkeit", "nebel" }),
	    "Es riecht modrig und auch etwas suesslich...");

	AddSmell( ({ "suesse" }),
	    "Der Geruch kommt Dir bekannt vor...");

	AddSmell( ({ "geruch" }),
	    "BLUT!");

	AddSmell( ({ "blut" }),
	    "Es riecht nach frischem Blut! Du solltest lieber schnell hier "
	    "weg.");

//COMMANDS

	AddCmd( ({ "fass", "fasse" }), "c_fassen");
	AddCmd( ({ "erkenne", "erkenn" }), "c_erkennen");
	AddCmd( ({ "nimm", "nehm", "nehme" }), "c_nehmen");
	AddCmd( ({ "bet", "bete" }), "c_beten");

}

int c_fassen(string str)
{
	if(str != "statue an" &&
	   str != "kreatur an" )
	{
		notify_fail("Was moechtest Du anfassen?\n");
		return 0;
	}
	if(anz_cthulhu < 1)
	{
		write(BS("Vollen Mutes beruehrst Du die Statue! "
			 "Nichts passiert."));
		return 1;
	}
	else
	{
		write("Du fasst vollen Mutes die Statue an.\n"
			 "\n"
			 "Ein gewaltiger Donner laesst Dich erschaudern.\n"
			 "Irgendetwas hat sich veraendert!\n");
		say(CTPN + " beruehrt die Statue.\n");
		TP->heal_self(150);
		anz_cthulhu--;
		return 1;
	}	
}

int c_erkennen(string str)
{
	if(str != "spiegelbild"   &&
	   str != "spiegelbild im marmor")
	{
		notify_fail("Was moechtest Du erkennen?\n");
		return 0;
	}
	else
	{
		write(BS("Du versuchst angestrengt Dein Spiegelbild im "
			 "Marmor zu erkennen, doch der Nebel ist viel zu "
			 "dicht. Dennoch faellt Dir auf einmal etwas "
			 "Seltsames auf."));
		return 1;
	}
}

int c_nehmen(string str)
{
	if(str != "kissen"   &&
	   str != "schwarzes kissen" )
	{
		notify_fail("Was moechtest Du hier nehmen?\n");
		return 0;
	}
	else
	{
		write(BS("Du traust Dich einfach nicht!"));
		say(CTPN+ " fuerchtet sich!\n");
		return 1;
	}
}

int c_beten(string str)
{
	if(str != "zu cthulhu"    &&
	   str != "cthulhu an"    &&
	   str != "statue an"     &&
	   str != "zu statue"     )
	{
		notify_fail("Zu wem moechtest Du beten?\n");
		return 0;
	}
	else
	{
		write("Du betest zu Cthulhu.\n"
		      "Ein Teil Deiner Lebenskraft schwindet.\n");
       		TP->do_damage(10);
		say(CTPN+ " scheint "+this_player()->QueryPossPronoun(MALE,
		    WEN, SINGULAR)+ " Verstand zu verlieren!\n");

		if(this_player()->QueryProp(P_BARD_GROUP) == BARD_GROUP_ALESTRA && 
	       this_player()->QuerySkill("hinter dem sternenwall") == 0) {
			if(this_player()->QueryProp("yog_killer")) {
				call_out("LearnBardSpell", 4, this_player(), "hinter dem sternenwall", 
					"Chthulhu erhoehrt dein Gebet und schenkt dir das Wissen, um einen "
					"seiner Diener in diese Welt zu rufen! Er wird deine Feinde fressen!",
					"spiele 'hinter dem sternenwall'");
			} else {
				write("Cthulhu hat dich nicht fuer wuerdig befunden! Du hast etwas vergessen!\n");
			}
		}

		return 1;
	}
}

