// Ein Stein, der gar nichts kann

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../alte.h"

void create()

{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Kieselstein");
  SetProp(P_LONG,
     "Ein kleiner Kieselstein. Er sieht wirklich toll aus! Was man "
     "mit ihm wohl alles anstellen kann? ");

  AddDetail( ({ "anstellen" }), 
     "Es ist ein Stein! Denk nach! :)");

  SetProp(P_NAME, "Kieselstein");
  AddId( ({ "stein", "kiesel", "kieselstein" }) );
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_STONE);
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_INFO, "Der Stein sieht total super aus!\n");

  AddCmd( ({ "wirf", "werf", "werfe" }), "c_werfen");

}

int c_werfen(string str)
{
	if(str != "kieselstein"   &&
	   str != "stein"         )
	{
		notify_fail("Was moechtest Du werfen?\n");
		return 0;
	}
	else
	{
		write(BS("Du wirfst den Stein auf den Boden. Aber "
			"weil Du Angst hast, jemand koennte ihn Dir "
			"wegnehmen hebst Du ihn schnell wieder auf."));
	        say(CTPN + " wirft einen Stein, hebt ihn aber gleich wieder "				"auf.\n");
		return 1;
	}
}
 


