
// YOGSOTHOTHS PEITSCHE


inherit "std/weapon";

#include <properties.h>
#include <combat.h>

 
void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Daemonenpeitsche");
  SetProp(P_LONG,
    "Das ist die legendaere Daemonenpeitsche. Sie ist aus der Haut von "
    "einem boesen Daemon gemacht und daher sehr maechtig.");
  SetProp(P_NAME, "Daemonenpeitsche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "peitsche", "daemonenpeitsche" }) );
  SetProp(P_INFO, 
    "Diese Peitsche wurde aus der Haut eines boesen Daemonen gemacht "
    "und verursacht daher magischen Schaden.\n" );

  SetProp(P_VALUE, 5000);
  SetProp(P_WEIGHT, 2000 + random(500));
  SetProp(P_WC, 180 + random(20));
  SetProp(P_WC_FIX, 20);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_WEAPON_TYPE, WT_WHIP);
  SetProp(P_DAM_TYPE, ({ DT_WHIP, DT_MAGIC }));
  SetProp(P_MATERIAL, 
    ([MAT_LEATHER:80, MAT_MISC_MAGIC:10, MAT_MISC_UNHOLY:10]));


}
