
inherit "std/weapon";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../alte.h"

void create() 
{
  if(!is_clone(this_object()))return;
  ::create();

  SetProp(P_SHORT, "Ein dunkles Shogottenschwert");
  SetProp(P_LONG, 
      "Ein scharfes Schwert von einem Shogotten. Es ist in den richtigen "
      "Haenden eine sehr gute Waffe. Nur leider sind Deine Haende wohl nicht "
      "die richtigen. Am Ende des mit Stoff umwickelten Griffes sitzt ein "
      "blauer Edelstein.");
  AddDetail( ({ "griff" }), 
      "Der Griff wurde mit Stoff umwickelt. Ganz unten sitzt ein Edelstein.");
  AddDetail( ({ "edelstein","saphir" }), 
      "Es scheint sich um einen Saphir zu handeln.");
  SetProp(P_NAME, "Schwert");
  SetProp(P_GENDER, NEUTER);
  
  AddId( ({ "schwert", "shogottenschwert" }));

  SetProp(P_WEIGHT, 1250);
  SetProp(P_VALUE, 1000);
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_WC, 140);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, 
      ([MAT_IRON:70, MAT_SAPPHIRE:10, MAT_CLOTH:10, MAT_MISC_UNHOLY:10]));

}
