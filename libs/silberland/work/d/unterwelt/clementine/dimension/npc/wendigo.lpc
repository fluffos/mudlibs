
// WENDIGO

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h>
#include <class.h>
#include <moving.h>
#include <new_skills.h>
#include "../alte.h"

create()
{
  if (!is_clone(ME)) return;
  
  ::create();
  
  SetProp(P_SHORT, "Wendigo");
  SetProp(P_LONG, "Wendigo, der auf den Winden geht.");
  SetProp(P_NAME, "Wendigo");
  SetProp(P_GENDER, MALE);
  AddId( ({ "\nalter", "alter", "wendigo" }) );
  AddClass(CL_DEMON);
  create_default_npc(40);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, -900);
  
  SetProp(P_RACE, "Daemon");
  SetProp(P_HANDS, ({" mit der fuerchterlichen Magie der Grossen Alten",
          QueryProp(P_HANDS)[1],DT_MAGIC}));
  SetProp(P_NOMAGIC,60);
  
  set_living_name("wendigo");
  
  SetProp(P_KILL_MSG, "Die Zeit ist gekommen! Wir sind wieder da!");
  SetProp(P_MSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGOUT, "poltert davon");
  SetProp(P_MSGOUT, "poltert davon");
  
  SetProp(P_BODY, 260);
  SetProp(P_AGGRESSIVE, 0.4);
  SetProp(P_SPELLRATE, 50);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -0.3, DT_WATER:  -0.1, DT_AIR:    -0.1, 
      DT_LIGHTNING: -0.3, DT_EXPLOSION: -0.3, DT_SOUND:  -0.3, DT_LIGHT:  -0.3,
      DT_ELECTRIC:  -0.1, DT_ACID:      -0.0, DT_POISON: -0.2, DT_TERROR: -1.0,
      DT_HOLY:       0.2, DT_UNHOLY:    -1.0, DT_MAGIC:  -0.3 ]) );
  
  AddSpell(1,400,
    "Wendigo schreit fuerchterlich.\n",
    "Wendigo schreit fuerchterlich.\n",
    ({DT_SOUND, DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,800,
    "Wendigo reisst Dir die Seele aus dem Leib.\n",
    "Wendigo reisst @WEM die Seele aus dem Leib.\n",
    ({DT_RIP, DT_PIERCE}),([SP_SHOW_DAMAGE:1]));
  
  SetAttackChats(25, ({
    "Wendigo faengt wie wahnsinnig an zu lachen.\n"}) );


  SetProp(P_CORPSE, NPC "cthulhu");

}

void die(int poisondeath)
{
  
  object item;
  if((item=present("\npaladintaskitem", this_player())) && 
	  item->GetTask(14, this_player()))
      item->SetFlag(10);
  write_file(LOG "wendigo.kills",
    dtime(time())+": "+CAP(getuid(PL))+" killt Wendigo.\n");
  ::die(poisondeath);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  write_file(LOG "wendigo.deads",
    sprintf(ctime()+": Wendigo hat gerade "+CAP(getuid(player))
	  +" umgebracht - %d EP!\n", lostexp) );
  return;
  
}

