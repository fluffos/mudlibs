//  28.06.98 Angrox: Class CL_DEMON added
//

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include <class.h>
#include "../alte.h"

create()
{
  if(!is_clone(this_object())) 
  return;
  
  ::create();
  
  SetProp(P_SHORT, "Ein Shogotte");
  SetProp(P_LONG,
   	"Ein Diener der Grossen Alten. Geschaffen aus unheiligem "
	"Protoplasma. Eine furchtbare Kreatur, die ihre Gestalt "
	"nach Belieben veraendern kann.");
  SetProp(P_NAME, "Shogotte");
  SetProp(P_GENDER, MALE);
  
  AddId( ({ "shogotte", "diener" }) );
  
  AddClass(CL_DEMON);
  
  create_default_npc(16);
  
  set_living_name("shogotte");
  
  SetProp(P_HANDS, ({ " mit den Maechten der Finsternis",
		QueryProp(P_HANDS)[1], DT_MAGIC }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ALIGN, -900);
  SetProp(P_RACE, "Daemon");

  SUID;
  CLONEME(ARMOUR "kutte");
  command("ziehe kutte an");
  CLONEME(WEAPON "schwert");
  command("zuecke schwert");
  
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_MNPC_AREA, ROOM "room");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room_x1" );
  SetProp(P_MNPC_FLAGS, 
	  MOV_INDOORS + MOV_MOVES + MOV_INFIGHT + MOV_BACKWARDS);

}

