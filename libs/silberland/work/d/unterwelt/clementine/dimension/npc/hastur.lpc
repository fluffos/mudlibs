
// HASTUR

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h>
#include <class.h>
#include <moving.h>
#include <new_skills.h>
#include "../alte.h"


create() 
{
  if (!is_clone(ME)) return;

  ::create();
  
  SetProp(P_SHORT, "Hastur");
  SetProp(P_LONG, 
    "Das ist Hastur. Ein Wesen von geringerer Macht, trotzdem noch "
    "schrecklicher als Goetter in ihrem Zorn.");
  SetProp(P_NAME, "Hastur");
  SetProp(P_GENDER, MALE);
  AddId( ({ "\nalter", "alter", "hastur" }) );
  AddId(CL_DEMON);
  create_default_npc(28);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, -850);
  
  SetProp(P_RACE, "Daemon");
  SetProp(P_HANDS, ({" mit der fuerchterlichen Magie der Grossen Alten",
          QueryProp(P_HANDS)[1],DT_MAGIC}));
  SetProp(P_NOMAGIC,20);
  
  SetProp(P_KILL_MSG, "Die Zeit ist gekommen! Wir sind wieder da!");
  SetProp(P_MSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGOUT, "poltert davon");
  SetProp(P_MSGOUT, "poltert davon");
  
  SetProp(P_BODY, 170);
  SetProp(P_AGGRESSIVE, 0.5);
  SetProp(P_SPELLRATE, 70);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.4, DT_COLD:      -0.3, DT_WATER:  -0.0, DT_AIR:    -0.0, 
      DT_LIGHTNING: -0.5, DT_EXPLOSION: -0.2, DT_SOUND:  -0.1, DT_LIGHT:  -0.5,
      DT_ELECTRIC:  -0.1, DT_ACID:      -0.1, DT_POISON: -0.0, DT_TERROR: -1.0,
      DT_HOLY:       0.2, DT_UNHOLY:    -1.0, DT_MAGIC:  -0.1 ]) );

  AddSpell(1,500,
    "Hastur schreit fuerchterlich.\n",
    "Hastur schreit fuerchterlich.\n",
    ({ DT_SOUND, DT_MAGIC }),([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,900,
    "Hastur reisst Dir die Seele aus dem Leib.\n",
    "Hastur reisst @WEM die Seele aus dem Leib.\n",
    ({ DT_RIP, DT_PIERCE }),([SP_SHOW_DAMAGE:1]));
  
  SetAttackChats(25, ({
    "Hastur faengt wie wahnsinnig an zu lachen.\n"}) );


  SetProp(P_CORPSE, NPC "tsa");
  

}

void die(int poisondeath)
{
  object item;
  if((item=present("\npaladintaskitem", this_player())) && 
	  item->GetTask(14, this_player()))
      item->SetFlag(4);
  write_file(LOG "hastur.kills",
    dtime(time())+": "+CAP(getuid(TP))+" killt Hastur.\n");
  ::die(poisondeath);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  	write_file(LOG "hastur.deads",
    sprintf(ctime()+": Hastur hat gerade "+CAP(getuid(player))
	  +" umgebracht - %d EP!\n", lostexp) );
  return;
  
}


