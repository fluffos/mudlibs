// CTHULHU

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h>
#include <class.h>
#include <moving.h>
#include <new_skills.h>
#include "../alte.h"


create() 
{
  if (!is_clone(ME)) return;

  ::create();

  SetProp(P_SHORT, "Cthulhu"); 
  SetProp(P_LONG, 
    "Vor Dir steht Cthulhu. Falls Du echt noch Zeit findest, ihn zu "
    "untersuchen bist Du beneidenswert. Er ist fast 10 Meter gross und "
    "furchteinfloessend. Er ist der Heerfuehrer der GROSSEN ALTEN und "
    "schlafender Herrscher ueber die versunkene Stadt R'lyeh."); 
  SetProp(P_NAME, "Cthulhu");
  SetProp(P_GENDER, MALE);
  AddId( ({ "\nalter", "cthulhu", "alter" }) );
  AddClass(CL_DEMON);
  create_default_npc(45);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 1000);
  SetProp(P_ALIGN, -1000);
  
  SetProp(P_RACE, "Daemon");
  SetProp(P_BODY, 350);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_HANDS, ({" mit fuerchterlichen Reisszaehnen",
          QueryProp(P_HANDS)[1],DT_MAGIC }));
  SetProp(P_NOMAGIC,70);
  
  SetProp(P_KILL_MSG, "Die Zeit ist gekommen! Wir sind wieder da!");
  SetProp(P_MSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGOUT, "poltert davon");
  SetProp(P_MSGOUT, "poltert davon");
  SetProp(P_SPELLRATE, 100);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.9, DT_COLD:      -0.9, DT_WATER:  -0.9, DT_AIR:    -0.4, 
      DT_LIGHTNING: -0.9, DT_EXPLOSION: -0.9, DT_SOUND:  -0.4, DT_LIGHT:  -0.9,
      DT_ELECTRIC:  -0.1, DT_ACID:      -0.4, DT_POISON: -0.3, DT_TERROR: -1.0,
      DT_HOLY:       0.1, DT_UNHOLY:    -1.0, DT_MAGIC:  -0.3 ]) );

  AddSpell(1,700,
    "Cthulhu wirft einen grossen Feuerball nach Dir.\n",
    "Cthulhu wirft einen grossen Feuerball nach @WEM.\n",
    ({ DT_FIRE, DT_MAGIC }),([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,900,
    "Cthulhu veraetzt Dich.\n",
    "Cthulhu veraetzt @WEN.\n",
    ({ DT_ACID, DT_MAGIC }),([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,1100,
    "Cthulhu stoesst einen unmenschlichen Schrei aus.\n",
    "Cthulhu stoesst einen unmenschlichen Schrei aus.\n",
    ({DT_SOUND,DT_PIERCE}),([SP_SHOW_DAMAGE:1]));
 
 SetAttackChats(25, ({
       "Cthulhu kichert: GANZ SCHOEN DUNKEL HIER WAS!\n"}) );
 
 SUID;
 CLONEME(ARMOUR "statring");
 command_me("trage ring");

}

void die(int poisondeath)
{
  
  object item;
  write_file(LOG "cthulhu.kills",
    dtime(time())+": "+CAP(getuid(TP))+" killt Cthulhu.\n");
  if((item=present("\npaladintaskitem", this_player())) && 
	  item->GetTask(14, this_player()))
      item->SetFlag(2);
    
  ::die(poisondeath);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
	write_file(LOG "cthulhu.deads",
    sprintf(ctime()+": Cthulhu hat gerade "+CAP(getuid(player))
	  +" umgebracht - %d EP!\n", lostexp) );
  return;
  
}
