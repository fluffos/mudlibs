
//  CTHUGA DER FLAMMENDE

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <class.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../alte.h"


create() 
{
  if (!is_clone(ME)) return;
  
  ::create();
  
  SetProp(P_SHORT, "Cthuga der Flammende");
  SetProp(P_LONG, 
     "Vor Dir steht Cthuga der Flammende. Er ist der juengste unter den "
     "Grossen Alten aber nicht minder schrecklich.");
  SetProp(P_NAME, "Cthuga");
  SetProp(P_GENDER, MALE);
  AddId( ({ "\nalter", "cthuga", "alter" }));
  AddClass(CL_DEMON);

  create_default_npc(27);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, -800);
  SetProp(P_BODY, 180);
  SetProp(P_RACE, "Daemon");
  SetProp(P_HANDS, ({ " mit der fuerchterlichen Magie der Grossen Alten",
          QueryProp(P_HANDS)[1],DT_MAGIC }) );
  
  set_living_name("cthuga");
  
  SetProp(P_KILL_MSG, "Die Zeit ist gekommen! Wir sind wieder da!");
  SetProp(P_MSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGOUT, "poltert davon");
  SetProp(P_MSGOUT, "poltert davon");
  
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_SPELLRATE, 70);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.3, DT_COLD:      -0.3, DT_WATER:   0.1, DT_AIR:    -0.0, 
      DT_LIGHTNING: -0.4, DT_EXPLOSION: -0.3, DT_SOUND:  -0.3, DT_LIGHT:  -0.4,
      DT_ELECTRIC:  -0.0, DT_ACID:      -0.2, DT_POISON: -0.0, DT_TERROR: -1.0,
      DT_HOLY:       0.1, DT_UNHOLY:    -1.0, DT_MAGIC:  -0.3 ]) );

  AddSpell(1,400,
    "Cthuga schreit fuerchterlich.\n",
    "Cthuga schreit fuerchterlich.\n",
    ({ DT_SOUND, DT_MAGIC }),([SP_SHOW_DAMAGE:1]));

  AddSpell(2,800,
    "Cthuga reisst Dir die Seele aus dem Leib.\n",
    "Cthuga reisst @WEM die Seele aus dem Leib.\n",
    ({ DT_RIP, DT_PIERCE }),([SP_SHOW_DAMAGE:1]));

  SetAttackChats(25, ({
     "Cthuga faengt wie wahnsinnig an zu lachen.\n"}) );


  SetProp(P_CORPSE, NPC "hastur");
  
}
void die(int poisondeath)
{
  object item;
  write_file(LOG "cthuga.kills",
    dtime(time())+": "+CAP(getuid(TP))+" killt Cthuga.\n");
  if((item=present("\npaladintaskitem", this_player())) && 
	  item->GetTask(14, this_player()))
      item->SetFlag(1);
  
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  	write_file(LOG "cthuga.deads",
    sprintf(ctime()+": Cthuga hat gerade "+CAP(getuid(player))
	+" umgebracht - %d EP!\n", lostexp));
  return;
} 

