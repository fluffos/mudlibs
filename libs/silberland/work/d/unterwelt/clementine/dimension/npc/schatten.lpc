//Schatten aus Unterwelt leicht modifiziert fuer die Dimension

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h>
#include <moving.h>
#include <class.h>
#include <new_skills.h>
#include "../alte.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,
    "War da etwas? Nein, Du musst Dich getaeuscht haben. Oder doch? "
    "Da in der Dunkelheit bewegt sich doch etwas, oder? Irgendwie hast Du "
    "das Gefuehl, dass der Schatten vor Dir lebendig ist."
  );

  SetProp(P_NAME, "Schatten");
  SetProp(P_GENDER, MALE);
  AddId(({ "schatten" }));
  create_default_npc(9+random(4));

  SetProp(P_BODY, QueryProp(P_BODY)-15);
  SetProp(P_HANDS, ({" schattenhaft", 120, ({ DT_TERROR, DT_UNHOLY }) }));
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 100+random(200));

  SetProp(P_ALIGN, -850);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0.01);
  SetProp(P_WIMPY, 0);
  SetProp(P_TRANSPARENT, 0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     1.5, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.8, DT_UNHOLY:   -0.9, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_NOCORPSE, 1);
  SetProp(P_DIE_MSG,  " entschwindet.\n");

  SetChats(5, ({
    "Du bist nicht allein.\n",
    "In Deinen Augenwinkeln nimmst Du eine Bewegung wahr.\n",
    "Du fuehlst Dich beobachtet.\n",
    "Irgendetwas macht ein schlurfendes Geraeusch.\n",
    "Huch? Was war das?\n",
    "Da bewegt sich ein Schatten.\n"}) );
  SUID;

  if(random(50)>40)  CLONEME(OBJ "splaetz" );

  AddCmd( ({"unt", "untersuche", "schau", "schaue"}), "hmpf");
}

int hmpf(string str)
{
  if(!id(str)) return 0;

  write(QueryProp(P_LONG));
  return 1;
}

