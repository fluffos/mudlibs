inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h>
#include <moving.h>
#include <class.h>
#include <new_skills.h>
#include "../alte.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Die Hand eines Trolls");
  SetProp(P_LONG,
    "Trollerie, trollera! Was hamma denn da? "
    "Was fuer eine tolle Trollhand. Beim Gedanken sie zu schlachten "
    "laeuft Dir das Wasser im Mund zusammen. ");

  SetProp(P_NAME, "Trollhand");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "hand", "trollhand" }) );
  create_default_npc(34+random(4));

  SetProp(P_BODY, QueryProp(P_BODY)-15);
  SetProp(P_HANDS, ({" haendisch", 120, ({ DT_TERROR, DT_UNHOLY }) }));
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 10+random(10));

  SetProp(P_KILL_NAME, "Eine Trollhand");
  SetProp(P_DEFAULT_INFO, "hat doch keinen Mund!");

  SetProp(P_ALIGN, -850);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_TRANSPARENT, 0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       1.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   1.0
     , DT_SOUND:     1.0, DT_LIGHT:     1.5, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      1.0
     , DT_HOLY:      1.0, DT_UNHOLY:   -0.9, DT_MAGIC:       1.0
     , DT_MIND:      1.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    1.0, DT_SQUEEZE:   0.0, DT_WHIP:        1.0
     , DT_RIP:       1.0
     ])
  );

  SetProp(P_NOCORPSE, 0);
  SetProp(P_DIE_MSG,  " wird nun nie wieder Schattenspiele spielen.\n");

  SetChats(5, ({
    "Die Trollhand sucht ihre Finger zusammen.\n",
    "Die Hand scharrt im Dreck.\n",
    "Die Trollhand sucht einen Troll.\n",
    "Die Trollhand spielt >Baeumchen ruettel Dich<.\n",
    "Die Hand dreht sich um die eigene Achse.\n",
    "Die Trollhand spritzt Dir Blut ins Gesicht.\n",
    "Die Hand macht Schattenspiele.\n"}) );


}

