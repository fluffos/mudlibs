
// TSATHOGGUA

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h>
#include <moving.h>
#include <class.h>
#include <new_skills.h>
#include "../alte.h"

create()
{
  if (!is_clone(ME)) return;

  ::create();
  
  SetProp(P_SHORT, "Tsathoggua");
  SetProp(P_LONG, 
    "Das ist Tsathoggua. Ein Wesen von geringerer Macht, trotzdem noch "
    "schrecklicher als Goetter in ihrem Zorn.");
  SetProp(P_NAME, "Tsathoggua");
  SetProp(P_GENDER, MALE);
  AddId( ({ "\nalter", "tsa", "alter", "tsathoggua" }) );
  AddClass(CL_DEMON);
  create_default_npc(32);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, -1000);
  
  SetProp(P_RACE, "Daemon");
  SetProp(P_HANDS, ({" mit der fuerchterlichen Magie der Grossen Alten",
          QueryProp(P_HANDS)[1],DT_MAGIC }));
  SetProp(P_NOMAGIC,40);
  
  
  SetProp(P_KILL_MSG, "Die Zeit ist gekommen! Wir sind wieder da!");
  SetProp(P_MSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGOUT, "poltert davon");
  SetProp(P_MSGOUT, "poltert davon");
  
  SetProp(P_BODY, 180);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_SPELLRATE, 70);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.8, DT_COLD:      -0.4, DT_WATER:  -0.2, DT_AIR:    -0.0, 
      DT_LIGHTNING: -0.4, DT_EXPLOSION: -0.4, DT_SOUND:  -0.3, DT_LIGHT:  -0.5,
      DT_ELECTRIC:  -0.3, DT_ACID:      -0.2, DT_POISON:  0.2, DT_TERROR: -1.0,
      DT_HOLY:       0.3, DT_UNHOLY:    -1.0, DT_MAGIC:  -0.3 ]) );

  AddSpell(1,600,
    "Tsathoggua schreit fuerchterlich.\n",
    "Tsathoggua schreit fuerchterlich.\n",
    ({DT_SOUND, DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,1000,
    "Tsathoggua reisst Dir die Seele aus dem Leib.\n",
    "Tsathoggua reisst @WEM die Seele aus dem Leib.\n",
    ({DT_RIP, DT_PIERCE}),([SP_SHOW_DAMAGE:1]));
  
  SetAttackChats(25, ({
    "Tsathoggua faengt wie wahnsinnig an zu lachen.\n"}) );
  
  SUID;
  CLONEME(ARMOUR "muetze");
  command_me("trage muetze");
  
  SetProp(P_CORPSE, NPC "sho");

}

void die(int poisondeath)
{
  
  object item;
  if((item=present("\npaladintaskitem", this_player())) && 
	  item->GetTask(14, this_player()))
      item->SetFlag(9);
  write_file(LOG "tsa.kills",
    dtime(time())+": "+CAP(getuid(TP))+" killt Tsathoggua.\n");
  ::die(poisondeath);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  
  if(killer == TO)
    write_file(LOG "tsa.deads",
    sprintf(ctime()+": Tsathoggua hat gerade "+CAP(getuid(player))
	  +" umgebracht - %d EP!\n", lostexp) );
  return;


}
