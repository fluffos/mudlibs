
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../alte.h"

create() 
{

  if (!is_clone(ME)) return;
  
  ::create();
  
  SetProp(P_SHORT, "Azathoth der Daemonensultan");
  SetProp(P_LONG, 
    "Vor Dir steht Azathoth der Daemonensultan und Beherrscher der "
    "Grossen Alten. Auch er ist fast 3 Meter gross und sein Anblick raubt "
    "Dir fast den Verstand.");

  SetProp(P_NAME, "Azathoth");
  SetProp(P_GENDER, MALE);
  AddId( ({ "\nalter", "azathoth", "alter", "sultan", "daemonensultan", "daemon" }));

  create_default_npc(25);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 270);
  SetProp(P_ALIGN, -900);
  
  SetProp(P_RACE, "Daemon");
  SetProp(P_BODY, 200);
  SetProp(P_HANDS, ({" mit schleimigen Tentakelarmen",
          QueryProp(P_HANDS)[1],DT_MAGIC}));
  SetProp(P_NOMAGIC,50);
  
  SetProp(P_KILL_MSG, "Die Zeit ist gekommen! Wir sind wieder da!");
  
  SetProp(P_MSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGOUT, "poltert davon");
  SetProp(P_MSGOUT, "poltert davon");
  
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_SPELLRATE, 70);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.3, DT_COLD:      -0.3, DT_WATER:  -0.0, DT_AIR:    -0.0, 
      DT_LIGHTNING: -0.3, DT_EXPLOSION: -0.3, DT_SOUND:  -0.3, DT_LIGHT:  -0.3,
      DT_ELECTRIC:  -0.0, DT_ACID:      -0.0, DT_POISON: -0.0, DT_TERROR: -1.0,
      DT_HOLY:       0.1, DT_UNHOLY:    -1.0, DT_MAGIC:  -0.3 ]) );
  
  AddSpell(1,400,
    "Azathoth wirft einen riesigen Feuerball nach Dir.\n",
    "Azathoth wirft einen riesigen Feuerball nach @WEM.\n",
    ({DT_FIRE,DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
 
  AddSpell(2,800,
    "Azathoth beschwoert die Maechte der Grossen Alten.\n",
    "Azathoth beschwoert die Maechte der Grossen Alten.\n",
    ({DT_ACID, DT_MAGIC}),([SP_SHOW_DAMAGE:1]));

  AddSpell(3,1200,
    "Azathoth raubt Dir den Verstand.\n",
    "Azathoth raubt @WEM den Verstand.\n",
    ({DT_COLD, DT_MAGIC}),([SP_SHOW_DAMAGE:1]));


  SetProp(P_CORPSE, NPC "nya");

}
void die(int poisondeath)
{
  object item;
  write_file(LOG "az.kills",
    dtime(time())+": "+CAP(getuid(TP))+" killt Azathoth.\n");
  if((item=present("\npaladintaskitem", this_player())) && 
	  item->GetTask(14, this_player()))
      item->SetFlag(0);
  ::die(poisondeath);

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  	write_file(LOG "az.deads",
  	sprintf(ctime()+": Azathoth hat gerade "+CAP(getuid(player))
	+" umgebracht - %d EP!\n", lostexp));
  return;
}

