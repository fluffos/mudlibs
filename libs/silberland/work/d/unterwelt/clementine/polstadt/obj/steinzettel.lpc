inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../polstadt.h"

create()
{
 if(!is_clone(this_object())) return;
 ::create();

 SetProp(P_SHORT, "Ein Zettel");
 SetProp(P_LONG,
   "Ein kleiner, schon etwas vergilbter Zettel, auf den jemand etwas "
   "geschrieben hat. ");
 SetProp(P_NAME, "Zettel");
 AddId( "zettel" );
 SetProp(P_GENDER, MALE);
 SetProp(P_MATERIAL, MAT_PAPER);
 SetProp(P_AC, 0);
 SetProp(P_WEIGHT, 1);
 SetProp(P_VALUE, 0);
 SetProp(P_NOBUY, 1);

 AddReadDetail( ({ "zettel" }),
   "\n"
   "+-----------------------------------+\n"
   "| Gebt gut Acht auf Euch, Ihr Hexen |\n"
   "|    und Ihr Hexen Beschuetzer!     |\n"
   "|  Nahe - mit schnellem Schritte -  |\n"
   "|   fast lautlos - die Gefahr !!!   |\n"
   "|      Huetet Euch Ihr Hexen,       |\n"
   "|     gebt gut Acht und flieht      |\n"
   "|     solange Ihr noch koennt!      |\n"
   "|Folgt dem geheimen Gange zum Licht!|\n" 
   "+-----------------------------------+\n"
   "\n");

}

