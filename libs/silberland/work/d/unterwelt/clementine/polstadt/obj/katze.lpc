
// EMMAS STOFFTIER


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../polstadt.h"


create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein kleines Kaetzchen");
  SetProp(P_LONG,
     "Ein kleines flauschiges Kaetzchen aus Pluesch, mit rosaroter Schleife "
     "um den Hals. Bis auf die schwarze Schwanzspitze ist das ganze Fell "
     "schneeweiss und laed zum Kuscheln ein. Abgesehn von den strahlend "
     "gruenen Kulleraugen scheint Dich das kleine Stupsnaeschen besonders "
     "in seinen Bann gezogen zu haben. ");
  SetProp(P_NAME, "Kaetzchen");
  SetProp(P_NAME_ADJ, "klein");
  AddId( ({ "stofftier", "kaetzchen" }) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 230);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_ARTICLE, 1);

  AddCmd( ({ "drueck", "druecke" }), "c_druecken");
  AddCmd( ({ "kuschel", "kuschle", "kuschl", "kuschele" }), "c_kuscheln");

}

int c_druecken(string str)
{
 if(str != "nase"          &&
    str != "stupsnase"     &&
    str != "naeschen"      &&
    str != "stupsnaeschen"   )
 {
  notify_fail("Was moechtest Du druecken?\n");
  return 0;
 }
 else
 {
  write(BS("Du drueckst das kleine Stupsnaeschen woraufhin das "
           "Kaetzchen sich ganz fest an Dich kuschelt und leise schnurrt. "));
  return 1;
 }
}
 

int c_kuscheln(string str)
{
 if(str != "kaetzchen"     &&
    str != "mit kaetzchen" &&
    str != "mit stofftier" &&
    str != "stofftier"      )
 {
  notify_fail("Womit moechtest Du kuscheln?\n");
  return 0;
 }
 else
 {
  write(BS("Du kuschelst Dich ganz vorsichtig an das Kaetzchen an. "
           "Hach, wie schoen! So ein weiches flauschiges Fell! Du willst "
           "gar nicht mehr aufhoeren. "));
  return 1;
 }
}

    



