
// SARIDIAS PUPPE


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../polstadt.h"

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Puppe");
  SetProp(P_LONG,
     "Eine kleine zierliche Puppe aus Stoff blickt Dir mit ihren grossen "
     "Kulleraugen mitten ins Gesicht. Ihre blonden Haare wurden mit roten "
     "Schleifchen zu zwei Zoepfchen gebunden, die rechts und links von "
     "ihrem Koepfchen abstehen. Es scheint als wuerde sie ihre kleinen "
     "Aermchen in Deine Richtung ausstrecken, um Dir zu sagen, dass Du sie "
     "ganz fest an Dich druecken sollst. ");
  SetProp(P_NAME, "Puppe");
  AddId( ({ "puppe" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 230);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_ARTICLE, 1);

}

