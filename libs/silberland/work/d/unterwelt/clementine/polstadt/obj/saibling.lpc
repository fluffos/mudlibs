
inherit "std/food";

#include <food.h>
#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Stueck Saibling");
  SetProp(P_LONG,
    "Ein leckeres Stueck Saibling. Jede Katze wuerde Dich dafuer "
    "sicherlich beneiden. ");
  SetProp(P_NAME, "Stueck Saibling");
  AddId( ({ "stueck", "saibling" }) );
  SetProp(P_ARTICLE, 1);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 0);
  SetProp(P_GENDER, NEUTER);

  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 10,10}),
        F_SOAK: 3,
        F_MSG: "Du verschlingst ein leckeres Stueck Saibling.",
        F_MSG_ROOM: "verschlingt ein Stueck Fisch."]) );
}


