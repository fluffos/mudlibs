
inherit "std/food";

#include <food.h>
#include "../polstadt.h"


create()
{
  if (!is_clone(ME)) return;
    ::create();

  AddId( ({ "kekserl", "keks" }) );
  SetProp(P_SHORT, "Ein Kekserl");
  SetProp(P_LONG,
    "Mhmm! Sieht das Kekserl aber lecker aus! Ob es wohl auch genauso gut "
    "schmeckt?! "); 
  SetProp(P_NAME, "Kekserl");
  SetProp(P_VALUE, 10);
  SetProp(P_WEIGHT, 60);
  SetProp(P_NOBUY, 0);
  SetProp(P_MATERIAL, ({ MAT_MISC_FOOD }) );
  SetProp(P_GENDER, NEUTER);

  SetProp (P_FOOD_INFO, 
    ([ F_HEAL     : 4,
       F_SOAK     : 4, 
       F_MSG      : "Du mampfst ein super leckeres Kekserl.",
       F_MSG_ROOM : "mampft ein Kekserl."
     ]) );

}

