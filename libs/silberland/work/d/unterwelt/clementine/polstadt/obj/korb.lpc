
inherit "std/container";
inherit "/std/container/restrictions.lpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"
#include <container.h>
#include <verben.h>

create()
{
    
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Katzenkorb");
  SetProp(P_LONG,
    "Ein, aus Stroh geflochtener Katzenkorb, an dessen Vorderseite ein "
    "Gitter angebracht wurde. Durch einen Griff laesst er sich ganz "
    "einfach tragen. ");
  SetProp(P_NAME, "Katzenkorb");
  AddId( ({ "korb", "katzenkorb", "\nqmkorb" }) );
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 3000);
  SetProp(P_VALUE, 200);
  SetProp(P_ARTICLE, 1);
  SetProp(P_MATERIAL, MAT_WOODEN_PLANT);
  SetProp(P_NOSELL, 1);
  ::add_openclose_commands();
  SetProp(P_CNT_STATUS, CNT_STATUS_OPEN);

  AddCmd( ({ "lege", "leg", "steck", "stecke" }), "c_stecken");
  AddCmd( CMD_NEHMEN, "c_nehmen");

}

int c_stecken(string str)
{
 object ob;
 
 notify_fail("Was moechtest Du in den Katzenkorb stecken?\n");
 
 if(!str && str == "") return 0;
 
 if(IsClosed()) return 0;

 if(str == "katze in korb" || str == "marisol in korb"  ||
    str == "katze in katzenkorb" || str == "marisol in katzenkorb")
 { 
  ob = present("\nkatzekorb", ENV(TP));
  if(!ob) return 0;
  if(present("\nkatzekorb"))
  { 
   write(BS("Aber in den Korb passt doch nur eine Katze hinein!")); 
   return -1;
  }
  write(BS("Vorsichtig legst Du die kleine Marisol in den Katzenkorb."));
  ob->move(TO, M_TPORT | M_NOCHECK | M_SILENT );
  say(CTPN+ " legt vorsichtig die kleine Marisol in einen Katzenkorb.\n");
  return 1;
 }
 return 0;
}


varargs int PreventInsert(object ob)
{
  return 1;
}

remove()
{
 if(present("\nkatzekorb"))
 present("\nkatzekorb")->remove();
 ::remove();
}

int c_nehmen(string str)
{
 if(str != "katze aus korb"         &&
    str != "marisol aus korb"       &&
    str != "marisol aus katzenkorb" &&
    str != "katze aus katzenkorb"    )
 {
  notify_fail("Was moechtest Du genau tun?\n");
  return 0;
 }
 else
 {
  if(IsClosed()) return 0;
  if(present("\nkatzeklo"))
  {
   write(BS("Aber Du sollst Blaithin doch die Katze in dem Korb bringen, und "
           "nicht alleine!"));
  }
  else
  {
   write(BS("Da ist doch gar keine Katze drinnen!"));
  }
  return 1;
 }
}
 


