
// SPRINGSCHNUR


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../polstadt.h"


create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Springschnur");
  SetProp(P_LONG,
     "Oh toll! Eine Springschnur! Es ist wohl schon eine Ewigkeit her, dass "
     "Du so etwas in der Hand gehalten hast - ein Seil an dessen Enden zwei "
     "Holzkloetze befestigt wurden. Na los! Probier sie doch schnell aus! ");
  SetProp(P_NAME, "Springschnur");
  AddId( ({ "schnur", "springschnur" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([ MAT_CANNABIS:80, MAT_MISC_WOOD:20]) );
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 230);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_ARTICLE, 1);

}

