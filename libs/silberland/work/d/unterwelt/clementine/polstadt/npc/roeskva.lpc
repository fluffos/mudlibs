
// ROESKVA DIE MUTIGE/TUECHTIGE    //
// im Laden unterirdisches Polaris //


inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h> 
#include "../polstadt.h"

create()
{   
 if (!is_clone(this_object()))
 return;

  ::create();
    
  SetProp(P_SHORT, "Roeskva" );
  SetProp(P_LONG, "bla");
  SetProp(P_NAME, "Roeskva");
  set_living_name("roeskva");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "hexe", "roeskva", "mutige", "tuechtige" }) );
  SetProp(P_LOG_INFO, "/clementine/roeskva");

  create_default_npc(38);
  SetProp(P_ALIGN, 960);
  SetProp(P_HANDS, ({ " mit ihren magischen Haenden", QueryProp(P_HANDS)[1],
                      DT_MIND }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS,
     ([ DT_MAGIC: -0.8,
     DT_POISON: -1, DT_TERROR: -1,     DT_FIRE:-0.5,
     DT_COLD:0.8,   DT_WATER:0,
     DT_AIR:0,      DT_LIGHTNING:-0.5, DT_EXPLOSION:0,
     DT_SOUND:0,    DT_LIGHT:0,        DT_ELECTRIC:1,
     DT_HOLY:-1,    DT_UNHOLY:0, ]) );

  SUID;
  CLONEME("/p/armour/boots/lederschuhe.lpc");
// kleid mit vielen taschen, schuerze etc... //
  command( "trage alles" );
  CLONEME("/obj/money");
  present("geld")->AddAmount(499);

  SetProp(P_DIE_MSG, " bricht nieder.\n");

  SetProp(P_MURDER_MSG, "Du hast noch nicht gewonnen!\n");
  SetProp(P_KILL_NAME, "Roeskva");
  SetProp(P_KILL_MSG, "lacht schallend.\n");
  SetProp(P_MSG_FLAGS, ([ P_KILL_MSG:1, P_MURDER_MSG:0 ]) );
  SetProp(P_REJECT, ({ REJECT_KEEP,
     "Roeskva steckt @WEN kichernd ein.\n" }) );
   

}

