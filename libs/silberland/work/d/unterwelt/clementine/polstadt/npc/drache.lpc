inherit "p/std/dragons/dragon";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../polstadt.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();    

  create_default_dragon(5, 9, 2, 28);
  
  SetProp(P_SHORT, "Yulongxnwzzknaing, der Diamantdrache" );
  SetProp(P_LONG,
     "Yulongxnwzzknaing ist ein riesiger diamantfarbener Drache. Mit seinen "
     "verschlingenden Augen starrt er Dich an. Die Adern an seiner Haut "
     "scheinen erwartungsvoll zu zucken. Seine spitzen langen Zaehne "
     "kommen Dir wie riesige Berggipfel vor. Anscheinend hatte er schon "
     "lange keinen Imbiss mehr. ");
  SetProp(P_NAME, "Yulongxnwzzknaing" );
  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS));
  
  AddId( ({ "yulongxnwzzknaing" }) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME_ADJ, 0);

  SetProp(P_DIE_MSG, " erliegt seinem Leiden.\n");
  SetProp(P_NOCORPSE, 0);
  
  SetProp(P_MURDER_MSG, "Warte bis die Zeit reif ist. Ich komme wieder! ");
  SetProp(P_KILL_NAME, "Yulongxnwzzknaing" );
  SetProp(P_KILL_MSG, "*Mampf* Lecker! ");

  SetProp(P_REJECT, ({ REJECT_KEEP, "Der Drache knurrt. " }) );
  
  SetChats(1, ({
     "Der Drache schnarcht laut.\n",
     "Der Drache blaest Luft durch seine Nuestern.\n" }) );

  SetAttackChats(5, ({ 
     "Der Drache vernichtet Dich.\n",
     "Yulongxnwzzknaing wirft Dich zu Boden.\n" }) );

  SetProp(P_SPELLRATE, 52);

 
  AddDetail( ({ "zaehne", "imbiss" }),
     "Der Drache lechzt foermlich nach einem kleinen Imbiss. ");
 
  AddDetail( ({ "adern", "haut" }),
     "Seine dicke Haut ist mit Adern ueberzogen, die erwartungsvoll "
     "zucken. ");

  AddDetail( ({ "augen" }),
     "Riesige Augen, die sich schon freuen, Dich verschlingen zu koennen. ");


}
  




die(int poisondeath)
{
write_file(LOG("dragon.kills"),
    dtime(time())+": "+CAP(getuid(TP))+" toetet den Drachen.\n");
::die(poisondeath);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
 if( killer == TO )
    write_file(LOG ("dragon.deads"),
       sprintf( ctime()+": Der Drache hat gerade "+CAP(getuid(player))
       +" umgebracht - %d EP!\n", lostexp));
 return ;
}

