// MIMONA - HEILERIN UNTERIRDISCHES POLARIS           //
//                                                    //
// created by Clementine@SL                           //
//                                                    //
//****************************************************//


inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h> 
#include "../polstadt.h"

mapping kampf;

create()
{   

 kampf=([]);

 if (!is_clone(this_object()))
 return;

  ::create();
    
  SetProp(P_SHORT, "Mimona, die Heilerin");
  SetProp(P_LONG, 
    "Du stehst vor Mimona, der hiesigen Heilerin. Ihr dunkles gewelltes Haar "
    "reicht ihr bis ueber die Schultern. Ihr Wesen scheint von einer "
    "sonderbaren Aura eingehuellt zu sein, und es scheint als wuerde sie ueber "
    "all den Dingen auf dieser Welt stehen. In der rechten Hand traegt sie "
    "einen hoelzernen Stab, an dessen Spitze sich eine leuchtend blaue "
    "Kugel befindet. ");
  SetProp(P_NAME, "Mimona");
  set_living_name( "mimona");
  SetProp(P_ARTICLE, 0 );
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "mimona", "hexe", "heilerin" }) );
  
  create_default_npc(48);
  SetProp(P_ALIGN, 1100);
  SetProp(P_HANDS, ({ " mit Weisheit", QueryProp(P_HANDS)[1],
                      DT_MIND }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS,
     ([ DT_MAGIC: -0.1,
     DT_POISON: -1, DT_TERROR: -1,     DT_FIRE:-0.5,
     DT_COLD:0.3,   DT_WATER:0,
     DT_AIR:0,      DT_LIGHTNING:-0.5, DT_EXPLOSION:0,
     DT_SOUND:0.3,  DT_LIGHT:0,        DT_ELECTRIC:0.3,
     DT_HOLY:-1,    DT_UNHOLY:0, ]) );

  SUID;
  CLONEME("/p/armour/boots/lederschuhe.lpc");
// kleid mit vielen taschen, etc... //
// saeckchen, mit pulver, guertel mit taschen etc bla //
  command( "trage alles" );
  CLONEME("/obj/money");
  present("geld")->AddAmount(199);
  
  SetProp(P_DIE_MSG, " bricht nieder.\n");
  
  SetProp(P_MURDER_MSG, "Dich heil ich nie nie wieder!!!\n");
  SetProp(P_KILL_NAME, "Mimona");
  SetProp(P_KILL_MSG, "Ups...das wollt ich jetzt aber nicht :)\n");
  SetProp(P_REJECT, ({ REJECT_KEEP,
     "Mimona macht einen anmutigen Knicks.\n" }) );

// SPELLS

  SetProp(P_SPELLRATE, 89);

  AddDefaultSpell(1, 200, DS_ANTIMAGIC);
  AddDefaultSpell(1, 150, DS_FROG);
  AddDefaultSpell(1, 100, DS_PARALYZE);
  AddDefaultSpell(1, 90, DS_MASS_POISON);
  AddDefaultSpell(1, 110, DS_MASS_DAMAGE);

  
  AddSpell(2, 250,
    "Mimona richtet ihren Stab auf Dich.\n",
    "Mimona richtet ihren Stab auf @WEN.\n",
    DT_AIR, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 300,
    "Mimona wird von gleissenden Blitzen eingehuellt.\n",
    "Mimona wird von gleissenden Blitzen eingehuellt.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 160,
    "Ein riesiger Feuerball kommt aus Mimonas Stab.\n",
    "Ein riesiger Feuerball kommt aus Mimonas Stab.\n",
    DT_FIRE, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 400,
    "Mimona schliesst die Augen und konzentriert sich.\n",
    "Mimona schliesst die Augen und konzentriert sich.\n",
    DT_MIND, ([SP_SHOW_DAMAGE:1]) );



// DETAILBEGINN

  AddDetail( ({ "stab", "kugel" }),
    "So nahe kommst Du nicht heran!");


// INFOS


  AddInfo( ({ "clementine", "cleme" }),
    "Clementine ist eine sehr gute Freundin von mir. Sie hat mir "
    "viel beigebracht. ", "sagt: ");

  AddInfo( ({ "angrox", "grox" }),
    "Hmm, lecker! Schnitzerl!!!", "sagt: ");

  AddInfo( ({ "schnitzerl" }),
    "Die mag er besonders!", "sagt: ");

  AddInfo( ({ "heilerin" }),
    "Ich arbeite als Heilerin, ja, weil ich anderen helfen moechte.", "sagt: ");

  AddInfo( ({ "mimona" }),
    "Das ist mein Name!", "sagt: ");

  AddInfo( ({ "ausgang", "eingang" }),
	"Solange man mir nichts Boeses moechte, ist man in meinem Haus jederzeit "
	"gerne willkommen. Du kannst es betreten und verlassen, wann immer Du "
	"moechtest. Aber huete Dich vor meinem Zorn!", "sagt: ");

  AddInfo( ({ "zorn" }),
	"Ich mag es ueberhaupt nicht, wenn mir wer etwas Boeses moechte!",
	"sagt: ");

  AddInfo( ({ "boeses", "boese" }),
	"Ich verabscheue alles Boese!", "sagt: ");
	


}

reset()
{
  kampf=([]);
  ::reset();
}


mixed _query_noattack()
{
  if(TP==ME)
    return 0;
  if(!member(kampf, getuid(TP))) {
    tell_room(environment(TP), BS("Mimona unterhaelt sich "
          "schmunzelnd mit "+CTPN+"."), ({ TP }) );
    kampf[getuid(TP)] = 0;
    return("sagt: Du moechtest wirklich gegen mich antreten im fairen "
    	"Kampf?\nMimona sagt: Das solltest Du Dir aber vorher sehr gut "
		"ueberlegen,\nMimona sagt: denn das Aussehen von Menschen sagt "
        "oft nichts ueber\nMimona sagt: ihre Faehigkeiten aus.");
  }
  else if (!kampf[getuid(TP)]) {
    tell_object(TP, "Mimona sagt: Nun gut, so soll es sein!\n"
		"Mimona murmelt: Moegen die Herrscher des Ostens, Sueden, Westens\n"
        "Mimona murmelt: und Nordens mit mir sein, und mich beschuetzen!\n"
        "Ploetzlich verschwindet der Ausgang auf magische Weise.\n");
    tell_room(environment(TP), "Mimona sagt: Nun gut, so soll es sein!\n"
        "Mimona murmelt ein paar Worte.\n "
        "Ploetzlich verschwindet der Ausgang auf magische Weise.\n",
        ({ TP }));
    kampf[getuid(TP)]=1;
  }

  if(member(environment(ME)->QueryProp(P_EXITS), "norden")!=-1)
    environment(ME)->RemoveExit("norden");

  return 0;
}




