
inherit "std/mnpc";
inherit "std/npc/spells";

#include <class.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include <combat.h>
#include "../polstadt.h"

create()
{
   if (!is_clone(this_object()))
   return;

   ::create();

   SetProp(P_SHORT, "Saridia");
   SetProp(P_LONG, "Vor Dir steht Saridia - ein kleines Maedchen mit zwei "
	   "roten langen Zoepfen, die rechts und links ueber ihre Schultern "
	   "baumeln. Die Sommersprossen in ihrem Gesicht erinnern Dich an "
	   "etwas... Mit ihren hellgruenen Augen grinst sie Dir frech ins "
	   "Gesicht. ");
   SetProp(P_NAME, "Saridia");
   SetProp(P_GENDER, FEMALE);
   SetProp(P_ARTICLE, 0);
   create_default_npc(13);
   SetProp(P_HANDS, ({ " mit schokoladigen Haenden", QueryProp(P_HANDS)[1],
	   DT_BLUDGEON }) );
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_ALIGN, 900);
   SetProp(P_RACE, "Mensch");
   SetProp(P_SIZE, 134);
   SetProp(P_RESISTANCE_STRENGTHS ,
	 ([DT_FIRE:      0.5, DT_COLD:      1.0, DT_WATER:  0.0, DT_AIR:    0.0,
       DT_LIGHTNING: -1.0, DT_EXPLOSION: -0.2, DT_SOUND: -1.0, DT_LIGHT:  0.0,
       DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.6,
       DT_HOLY:     -1.0, DT_UNHOLY:    0.8, DT_MAGIC: -0.7 ]) );
   
   SetProp(P_REJECT, ({ REJECT_KEEP, "Saridia kichert froehlich.\n" }) );
	
   AddId( ({ "saridia", "kind", "maedchen" }) );
	
   SetProp(P_MSGIN, "kommt angelaufen");
   SetProp(P_MSGOUT, "laeuft");
   SetProp(P_MMSGIN, "kommt angelaufen" );
   SetProp(P_MMSGOUT, "laeuft nach" );

   SetProp(P_MNPC_AREA, ROOM);
   SetProp(P_MNPC_FLAGS,
	            MOV_INDOORS+MOV_OUTDOORS+MOV_MOVES+MOV_SPECIAL );
   SetProp(P_MNPC_WAIT, ({40, 30, random(20)}) );
   SetProp(P_MNPC_DEFAULTROOM, ROOM "room_i8");

   SetChats(4,
	 ({ "Saridia grinst frech.\n",
	    "Saridia huepft um Dich herum.\n",
		"Saridia spielt mit ihrer Puppe.\n"
	 }));

   SetProp(DEFAULT_INFO, "kichert schelmisch\n");

}

	 
