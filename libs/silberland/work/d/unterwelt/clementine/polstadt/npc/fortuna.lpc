// Fortuna, die Runenlegerin wandert mittels T_PORT quer durchs SL ;)

inherit "std/mnpc";
inherit "std/npc/spells";
#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include <combat.h>
#include "../polstadt.h"

string *orte;
string *runen;

void create()
{
 if (!is_clone(this_object()))
 return;

  ::create();

  SetProp(P_SHORT, "Fortuna, die Runenlegerin");
  SetProp(P_LONG,
    "Das Gesicht faltig, die Haende schon leicht zittrig, aber ihre "
    "Augen strahlen, als waere Fortuna keine 20 Jahre alt. Beim Hereinkommen "
    "hat sie kurz Notiz von Dir genommen, kuemmert sich aber nun wieder um "
    "ihre Runen. Wenn Du also etwas wissen moechtest, so waere es ratsam sie "
    "einfach anzusprechen. ");
  SetProp(P_NAME, "Fortuna" );
  set_living_name( "fortuna" );
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "hexe", "fortuna", "legerin", "runenlegerin" }) );

  SetProp(P_LOG_INFO, "/clementine/fortuna");

  create_default_npc( 48 );
  SetProp(P_ALIGN, 900 );
  SetProp(P_BODY, 490 );
  SetProp(P_SIZE, 173);
  SetProp(P_RACE, "Mensch");
  SetProp(P_HANDS, ({ " mit der Macht der Runen", QueryProp(P_HANDS)[1],
                       DT_MIND }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_MAGIC: -0.5,
     DT_POISON: -1, DT_TERROR: -1, DT_FIRE:0.5,  DT_COLD:1,   DT_WATER:0,
     DT_AIR:0,   DT_LIGHTNING:-0.5, DT_EXPLOSION:-0.4,
     DT_SOUND:0, DT_LIGHT:0,  DT_ELECTRIC:1,
     DT_HOLY:-1,  DT_UNHOLY:1, ]) );

  SUID;
  CLONEME("/p/armour/boots/lederschuhe.lpc");
  CLONEME("/p/armour/cloak/lederschuerze.lpc");
  CLONEME("/d/unterwelt/clementine/polaris/armour/amulett.lpc");
  CLONEME("p/armour/armour/weste.lpc");
  CLONEME("/p/armour/belt/guertel.lpc");
  CLONEME("/p/armour/trousers/rock.lpc");
  command("trage alles");
  CLONEME("/obj/money");
  present("geld")->AddAmount(1999);
 // CLONEME("/p/daemon/itemd/obj/runes/runebag.lpc"); 
  

  SetProp(P_NOCORPSE, "loest sich in Nebel auf.\n");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-15,T_RANGE_MAX:45]));
  SetProp(P_MURDER_MSG, "Aber meine Runen nehm ich mit!\n");
  SetProp(P_KILL_NAME, "Fortuna");
  SetProp(P_KILL_MSG, "Meine Runen luegen nie!\n");
  SetProp(P_MSGIN, "materialisiert sich vor Dir");
  SetProp(P_MSGOUT, "schwebt scheinbar");
  SetProp(P_INFO, ("Fortuna ist immer auf Wanderschaft."));
  
 
  SetProp(P_SPELLRATE, 99);

  AddDefaultSpell(3, 60, DS_MASS_BLIND,
    "Fortuna schleudert einige Runen quer durch den Raum.\n",
    "Fortuna schleudert einige Runen quer durch den Raum.\n");

  AddDefaultSpell(2, 20, DS_REDUCE_AC,
    "Fortuna schreit: ELHAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAZ!\n",
    "Fortuna schreit: ELHAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAZ!\n");

  AddSpell(2, 450,
    "Fortuna bruellt: Sowilho schwinde! und blickt boese in Deine "
    "Richtung.\n",
    "Fortuna bruellt: Sowilho schwinde! und blickt @WEN boese an.\n",
    DT_COLD, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(5, 620,
    "Fortuna konzentriert sich auf die Macht der Runen.\n",
    "Fortuna konzentriert sich auf die Macht der Runen.\n",
    DT_MIND, ([SP_SHOW_DAMAGE:1]) ); 

  AddSpell(3, 342,
    "Fortuna huellt sich mit der Rune Kenaz ein.\n",
    "Fortuna schleudert Feuer gen @WEM.\n",
    DT_FIRE, ([SP_SHOW_DAMAGE:1]) );

   SetChats(14, ({
    "Fortuna murmelt ein paar Worte.\n",
    "Fortuna zieht eine Rune aus ihrem Beutel und betrachtet sie.\n",
    "Fortuna fuehrt magische Bewegungen aus.\n",
    "Fortuna murmelt etwas.\n"}) );


  


  call_out("transen", 150+random(10));


  orte= ({
	"/d/unterwelt/clementine/polaris/room/kueche",
	"/d/huegelland/raballion/hobbits/room/baum2",
	"/d/dschungel/feyaria/tijara/room/kraeuter_b6",
	"/gilden/druidenzirkel",
	"/d/ebene/ronja/feenquest/room/taverne",
	"/d/kristallwald/sargola/dorf/room/biblio",
	"/d/wueste/gwenshara/estadt/room/basari/basari_2x2",
	"/d/unterwelt/clementine/polaris/room/keller"});

  runen= ({ "Ansuz", "Fehu", "Uruz", "Thurisaz", "Raidho", "Kenaz", 
            "Gebo", "Wunjo", "Hagalaz", "Nauthiz", "Isa", "Jera", 
	    "Eihwaz", "Algiz", "Sowilo", "Perthro", "Tiwaz", "Berkana",
	    "Ehwaz", "Mannaz", "Laguz", "Ingwaz", "Dagaz", "Othala" });



// INFOS !!!


// RUNEN



  AddInfo(DEFAULT_INFO, ({ 
   "will eigentlich gerade nicht gestoert werden.\n",
   "murmelt ein paar Zauberformeln.\n",
   "sagt: Ich hab Dich leider akustisch nicht verstanden.\n",
   "fragt: Koenntest Du das nochmal wiederholen?\n",
   "sagt: Frag doch die Goetter!\n",
   "sagt: Frag Dein Inneres!\n",
   "sagt: Willst Du das wirklich wissen?\n",
   "sagt: Interessant, dass Du fragst.\n"}) );

  AddInfo( ({ "runenbeutel" }),
   "Den brauch ich fuer meine Runen!", "sagt: ");

  AddInfo( ({ "beutel" }),
   "Meinst Du meinen Runenbeutel?", "fragt: ");

  AddInfo( ({ "fortuna" }),
   "Man nennt mich Fortuna, da man sagt ich bringe das Glueck. ", "sagt: ");

  AddInfo( ({ "glueck" }),
   "Das Glueck kommt von Dir selbst, oder gar nicht. ", "sagt: ");

  AddInfo( ({ "spieler" }),
   "Was moechtest Du denn wissen?", "sagt: ");

  AddInfo( ({ "formeln", "zauberspruch", "zaubersprueche", "zauberformeln", 
    "zauberworte", "zauberwort", "zauberwoerter" }),
   "Ich bin eine Hexe! Natuerlich verwende ich manchmal Zaubersprueche. ",
   "sagt: ");

  AddInfo( ({ "hexe" }),
   "Ich bin eine. ", "sagt: ");

  AddInfo( ({ "gefjon" }),
    "Gefjon bedeutet die grosszuegige Geberin.", "sagt: ");

  AddInfo( ({ "harbard" }),
    "lacht: Harbard der alte Graubart!");

  AddInfo( ({ "clementine", "cleme" }),
    "Clementine ist eine absolute Chaotin. Aber wenn Du etwas ueber "
    "Runen wissen willst, oder eine genauere Deutung haben moechtest, dann "
    "frag besser sie.", "sagt: ");

  AddInfo( ({ "chaotin" }),
    "Du meinst Clementine?!", "fragt: ");

  AddInfo( ({ "deutung" }),
    "Runen zu deuten geschieht meist intuitiv. ", "sagt: ");

  AddInfo( ({ "intuition" }),
    "Hast Du die?!", "fragt: ");

  AddInfo( ({ "gwenshara" }),
    "Gwenshara hat mir mal einen Beistrich geschenkt. ", "sagt: ");

  AddInfo( ({ "beistrich" }),
    "Den hab ich dringendst gebraucht. ", "sagt: ");

  AddInfo( ({ "odin", "freya", "thor", "loki", "woody", "dusty", 
		"tyr", "freyr" }),
    "betet zu den Goettern.");

  AddInfo( ({ "hyrokkin" }),
    "Die wohnt wo in Polaris. ", "sagt: ");

  AddInfo( ({ "polaris" }),
    "Schoen, nicht wahr?", "fragt: ");

  AddInfo( ({ "runenlegung", "runenlegen", "runenziehen", "runenziehung" }),
   "Wenn Du wissen willst, was Dir Deine Zukunft beschert, dann zieh "
   "doch einfach eine Rune!", "sagt: ");

  AddInfo( ({ "runen", "rune" }),
    "Die Runen sind ein spannendes Orakel, magst Du eine ziehen?", "fragt: ");

  AddInfo( ({ "orakel" }),
    "Mit den Runen kann man in die Zukunft, aber auch in die "
    "Vergangenheit von Menschen sehen. ", "sagt: ");

  AddInfo( ({ "vergangenheit" }),
    "Manchmal ist es wichtig die Vergangenheit zu betrachten, damit man "
    "in die Zukunft gehen kann. ", "sagt: ");

  AddInfo( ({ "gegenwart" }),
    "Die Gegenwart ist jetzt und hier.", "sagt: ");

  AddInfo( ({ "zukunft" }),
    "Mit den Runen kannst Du auch Deine Zukunft sehen!", "sagt: ");

  AddInfo( ({ "gott", "goetter" }),
    "Sie meinen es heute gut mit uns!", "sagt: ");

  AddInfo( ({ "heute", "tag" }),
    "Was fuer ein wundervoller Tag!", "sagt: ");

  AddInfo( ({ "futhark" }),
    "Das Futhark ist eine alte Sprache. ", "sagt: ");

  AddInfo( ({ "sprache" }),
    "Du meinst die Sprache der Runen?", "fragt: ");

  AddInfo( ({ "fehu" }),
   "Fehu ist die Rune des Wohlstandes. Dabei gilt dass geistiger "
   "Reichtum genauso wichtig ist wie materieller. Fehu gibt Dir alles mit, "
   "was Du zum Leben brauchst. Es geht nur darum, dass Du Deine Chancen nutzt. "
   "Lass Deinen Gedanken Taten folgen! In der Liebe steht Fehu fuer "
   "Leidenschaft. ", "sagt: ");

  AddInfo( ({ "uruz" }),
   "Uruz ist die Rune der Energie. Die Urkraft verbindet Dich mit Deinen "
   "Wurzeln. Woher kommst Du, wonach lebst Du, was brauchst Du? Alles was "
   "da ist kann wachsen, wenn Du es willst. In der Liebe steht Uruz fuer "
   "Fruchtbarkeit. Deine Beziehung vertraegt jetzt einen festeren Rahmen. ",
   "sagt: ");

  AddInfo( ({ "thurisaz" }),
   "Thurisaz ist die Rune der aktiven Verteidigung. Aktive Abwehr von "
   "Dingen die Du nicht willst, weil sie Dir nicht gut tun. Zeige ruhig "
   "oefter Deine Zaehne! Brich aus Deinem alltaeglichen Kreislauf aus, "
   "damit Du wieder Du selbst sein kannst! Zerstoerungen und Veraenderungen "
   "sind manchmal notwendig um Neues zu schaffen. ", "sagt: ");

  AddInfo( ({ "ansuz" }),
   "Ansuz ist die Rune des Wortes. Ansuz begleitet Dich auf dem Weg Deiner "
   "Selbstfindung. Das richtige Wort zur richtigen Zeit. So unterstuetzt "
   "Dich Ansuz damit Du zur richtigen Zeit Deine richtigen Worte findest. "
   "In der Liebe haelt Ansuz Dich dazu an frischen Wind in Dein Liebesleben "
   "zu bringen und die Dinge manchmal auch aus der Sicht Deines Partners "
   "zu sehen. Wie Odins Atem weht Ansuz altes weg. ", "sagt: ");

  AddInfo( ({ "raidho" }),
   "Raidho ist die Rune der Bewegung. Sie bietet Dir Schutz auf Reisen. "
   "Bring Bewegung in Dein Leben, bilde Dich weiter! Wenn Du nicht nachdenkst "
   "und Dich nur im Kreise drehst, wirst Du auf der Stelle bleiben! "
   "In der Liebe gilt, dass eine Beziehung durch stetige Weiterentwicklung "
   "fruchtbar und lebenswert wird. ", "sagt: ");

  AddInfo( ({ "kenaz" }),
    "Kenaz ist die Rune des Feuers. Kenaz laesst Dich Dein Lebensfeuer neu "
    "entzuenden. Feuer steht fuer Energie, die Du aufbringst um etwas "
    "zu tun. Das Feuer verbrennt etwas, damit etwas Neues entstehen kann. Du "
    "hast es in der Hand etwas Sinnvolles zu tun! Lass Dein inneres "
    "Licht leuchten! Wie soll in der Liebe der Funke ueberspringen, wenn Du "
    "nicht den ersten Schritt tust?", "sagt: ");

  AddInfo( ({ "gebo" }),
    "Gebo ist die Rune des Gebens und Nehmens. Dabei geht es nicht unbedingt "
    "um materielle Gueter, sondern um Wissen und Liebe. In dem Moment, in "
    "dem Du bereit bist, etwas von Dir zu geben, wirst Du selbst reich belohnt "
    "werden. Finde heraus, was Dich ausmacht. Was nimmst Du, was bist "
    "Du bereit zu geben? Gebo steht fuer Harmonie in allen Lebensbereichen. "
    "Verbindung und Verschmelzung von Polaritaeten. ", "sagt: ");

  AddInfo( ({ "wunjo" }),
    "Wunjo ist die Rune der Lebensfreude. Wunjo steht fuer Harmonie, Glueck, "
    "Lachen, Humor, und auch Liebe. Wunjo erhellt Dein Herz und schenkt Dir "
    "Lebenslust. Alles steht jetzt unter einem guten Stern. Aber vergiss "
    "nicht: Jeder ist seines Glueckes Schmied!", "sagt: ");

  AddInfo( ({ "hagalaz" }),
    "Hagalaz ist die Rune der Runen. Sie steht fuer Vollkommenheit und "
    "Transformation, aber auch das Mysterium der Schoepfung. "
    "Mit Hagalaz kehrt Dein Gleichgewicht wieder zu Dir "
    "zurueck. Wer in Harmonie lebt, kann kreativ und fruchtbar sein. ",
    "sagt: ");

  AddInfo( ({ "naudhiz", "nauthiz" }),
    "Naudhiz ist die Rune des Schicksals. Sie ist wie das Rad des Schicksals, "
    "mal laeuft alles gut, mal weniger. Wer sich seinem Schicksal einfach "
    "so ergibt, hat entweder resigniert oder hat Angst vor Veraenderung. "
    "Beide Varianten stehen einem erfuellten Leben imn Weg. Nauthiz ist "
    "genau die Hilfe, die Du in einer Notsituation gebrauchen kannst. Lass "
    "Nauthiz Dein Schluessel sein und geh in Dich. ", "sagt: ");

  AddInfo( ({ "isa" }),
    "Isa ist die Rune der Stille. In der Ruhe liegt die Kraft, nutze sie! "
    "Isa verbindet alles miteinander - alles hat einen Ursprung. Erkenne "
    "die Zusammenhaenge und ziehe Deine Konsequenzen daraus. Nimm Dein "
    "Leben selbst in die Hand! In der Liebe laeuft es mit Isa meistens nicht "
    "so rund. ", "sagt: ");

  AddInfo( ({ "jera" }),
    "Jera ist die Rune der Jahreszeiten. Alles ist in einen Kreislauf "
    "eingebunden. Nach dem Winter wird immer der Fruehling folgen. Achte "
    "auf Deinen natuerlichen Kreislauf, dann wirst Du die Fruechte Deiner "
    "Arbeit ernten koennen!", "sagt: ");

  AddInfo( ({ "eihwaz" }),
    "Eihwaz ist die Rune des Weltenbaumes. Eihwaz begleitet Dich auf allen "
    "Reisen durch die Welten und beschuetzt Dich. Es ist wichtig, dass Du "
    "Dich von dem trennst, was Dich kaputt macht. Du lebst im Hier und Jetzt! "
    "Weisst Du auch, wie es sich anfuehlt?!", "sagt: ");

  AddInfo( ({ "perthro" }),
    "Perthro ist die Rune der Weissagung. Alles was Du in Deine Beziehung "
    "hineingibst, bekommst Du auch wieder zurueck. Was Du in den Wald "
    "hineinrufst, kommt auch wieder raus. Erkenne, dass Du derjenige bist, "
    "der seine Plaene durchfuehren muss! Du bist nicht allein!", "sagt: ");

  AddInfo( ({ "elhaz", "algiz" }),
    "Algiz ist die Rune des goettlichen Schutzes. Woody steht Dir jetzt "
    "bei! Hoere auf Deinen Koerper, das ist Dein bester Schutz! Vergiss nicht "
    "das man auch viel verpassen kann, wenn man sich dauernd vor etwas "
    "schuetzt. Verwurzel Dich mit der Erde und strecke Deine Arme gen "
    "Himmel - schenk Dir das Vertrauen, dass auch andere Dir entgegenbringen! ",
    "sagt: ");

  AddInfo( ({ "sowilo" }),
    "Sowilo ist die Rune der Sonne. Mit Sowilo geht die Sonne auf :) Aber "
    "nicht nur die, auch die Lebenslust ist da. Mit der Sonne im Herzen wirst "
    "Du in allen Dingen Erfolg haben! Heute sieht man das Zeichen von "
    "Sowilo noch auf Stromkaesten. Es sieht aus wie ein Blitz - strotzend "
    "vor Energie. Aber vergiss nicht, dass zuviel Energie Dinge auch "
    "zunichte machen kann. ", "sagt: ");

  AddInfo( ({ "tiwaz" }),
    "Tiwaz ist die Rune des Sieges. Sie sieht wie eine Pfeilspitze aus. "
    "Manchmal muss man eine Auseinandersetzung fuehren, wenn man seine Ziele "
    "erreichen moechte. Lass Tiwaz Deine Pfeilspitze sein. Lass sie "
    "vor Deinen Augen einen Weg einschlagen, den Du verfolgst. Bring sie ins "
    "Ziel. ", "sagt: ");

  AddInfo( ({ "berkano", "berkana" }),
    "Berkana ist die Rune der Frauen. Sie steht aber auch oft fuer "
    "Verschleierung und Geheimnistuerei - typisch Frau also. "
    "Berkana raet Dir gerade jetzt auf Deine Intuition und Deine Traeume "
    "zu hoeren. Was schlummert alles im Verborgenen? Was sind Deine "
    "weiblichen Aspekte? Kennst Du sie?! ", "sagt: ");

  AddInfo( ({ "ehwaz" }),
    "Ehwaz ist die Rune des Vertrauens. Zu zweit geht alles besser! "
    "Partnerschaften beruhen auf gegenseitigen Respekt und auf die "
    "Annehmen des anderen. Begreife, dass Polaritaeten keine Feinde sind, "
    "sondern einander ergaenzen. Hoere Vorschlaege von anderen "
    "urteilsfrei an - vertraue!", "sagt: ");

  AddInfo( ({ "mannaz" }),
    "Mannaz ist die Rune der Menschheit. Soziales Verhalten ist wichtig fuer "
    "das Zusammenleben unter Menschen. Ein vernuenftiges Miteinander ist "
    "nur moeglich, wenn die Mitglieder einer Gruppe verantwortungsvoll, "
    "tolerant und grosszuegig sind. Mannaz steht auch fuer die "
    "uneingeschraenkte Liebe zueinande voller Vertrauen und Hingabe. ", 
    "sagt: ");

  AddInfo( ({ "laguz" }),
    "Laguz ist die Rune des Wassers. Laguz waescht alle unerwuenschten "
    "Energien fort. Damit alles fliesst braucht auch Dein Koerper genug "
    "Fluessigkeit. Verbinde Dich mit dem Wasser und lasse es fliessen. "
    "Stell Dir Wellen am Meer vor - wie Ebbe und Flut nehmen sie etwas "
    "und bringen sie etwas. ", "sagt: " );

  AddInfo( ({ "ingwaz" }),
    "Ingwaz ist die Rune der Maenner. Zuviel maennliche Energie bringt "
    "Ungeduld und Hektik mit. Alles muss schnell gehen... Nimm Dir mehr "
    "Ruhe und Gelassenheit fuer Dein Leben. Durch Deine Hektik entgeht "
    "Dir sonst etwas. Verfolge Deine Ziele, denn Du weisst, was Du willst. ",
    "sagt: ");

  AddInfo( ({ "dagaz" }),
    "Dagaz ist die Rune der Polaritaeten. Balance zwischen Tag und Nacht. "
    "Verdraenge nicht alles was unangenehm ist. Deine Schattenseite ist "
    "mindestens genauso liebenswert wie Dein sonniges Gemuet. Nimm Deine "
    "Maske ab und zeig wer Du wirklich bist. Finde Deinen Rythmus, Deinen "
    "Ausgleich - auch in der Liebe. ", "sagt: ");

  AddInfo( ({ "othala", "odhala" }),
   "Othala die Rune der Erde. Traditionen koennen einen festen Rahmen "
   "geben, aber manchmal muessen sie auch veraendert werden. Du musst nicht "
   "immer auf Biegen und Brechen an allem festhalten, nur um anderen "
   "einen Gefallen zu tun. Schaff Dir ein Zuhause in dem Du Dich wohlfuehlst. "
   "Du bist Dir selbst der naechste! Wenn es Dir gut geht, strahlst Du "
   "das auch auf andere aus!", "sagt: ");
 
  AddInfo( ({ "silberland" }),
   "Ein schoener Ort zu wohnen!", "sagt: ");

  AddInfo( ({ "wanderschaft" }),
    "Ich bin gerne auf Wanderschaft. So komm ich durch das ganze "
    "Silberland!", "sagt: ");

  AddCmd( ({ "zieh", "ziehe" }), "runenorakel");

}

void transen()
{
  string ort;
  ort=orte[random(sizeof(orte))];
  move(ort, M_TPORT);
  call_out("transen", 150+random(10));
}

int runenorakel(string str)
{
	if(str != "runen"  &&
	   str != "rune"   &&
	   str != "eine rune" )
	{
		notify_fail("Moechtest Du eine Rune ziehen?\n");
		return 0;
	}
	else
	{
	 string rune;
	 rune=runen[random(sizeof(runen))];
	 write(BS("Fortuna streckt Dir ihren Beutel hin.""\n"
		"Du wuehlst darin herum und ziehst die Rune >"+rune+ "<. "
		"Danach legst Du sie wieder in den Beutel. "));
	 return 1;
	}
}




die(int poisondeath)
{
write_file(LOG "polstadt.kills", 
        dtime(time())+": "+CAP(getuid(TP))+" toetet Fortuna.\n");
::die(poisondeath);
}


 

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
 if( killer == TO )
    write_file(LOG "polstadt.kills",
       sprintf( ctime()+": Fortuna hat gerade  "+CAP(getuid(player))
       +" umgebracht - %d EP!\n", lostexp));
 return ;
}

