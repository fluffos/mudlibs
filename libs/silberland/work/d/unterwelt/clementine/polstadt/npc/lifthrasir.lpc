
// LIFTHRASIR - die vor Leben Strotzende  //
// altes waschweib - tratschweib         //


inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../marisol.h"

create()
{
 if (!is_clone(this_object()))
 return;

  ::create();

  SetProp(P_SHORT, "Lifthrasir");
  SetProp(P_LONG, "bla");
  SetProp(P_NAME, "Lifthrasir");
  set_living_name("lifthrasir");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "hexe", "lifthrasir", "strotzende" }) );
  SetProp(P_LOG_INFO, "/clementine/lifthrasir");

  create_default_npc(28);
  SetProp(P_ALIGN, 800);
  SetProp(P_HANDS, ({ " mit ihrem Tratschmaul", QueryProp(P_HANDS)[1],
                      DT_MIND }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS,
     ([ DT_MAGIC: -0.8,
     DT_POISON: -1, DT_TERROR: -1,     DT_FIRE:-0.5,
     DT_COLD:0.8,   DT_WATER:0,
     DT_AIR:0,      DT_LIGHTNING:-0.5, DT_EXPLOSION:0,
     DT_SOUND:0,    DT_LIGHT:0,        DT_ELECTRIC:1,
     DT_HOLY:-1,    DT_UNHOLY:0, ]) );

 SUID;
  CLONEME("/p/armour/boots/lederschuhe.lpc");
// kleid mit vielen taschen, schuerze etc... //
  command( "trage alles" );
  CLONEME("/obj/money");
  present("geld")->AddAmount(9);

  SetProp(P_DIE_MSG, " erzaehlt Dir noch schnell ein Geruecht und stirbt.\n");

  SetProp(P_MURDER_MSG, "Erzaehl ich halt Lars mal wieder ein Geruecht.\n");
  SetProp(P_KILL_NAME, "Lifthrasir");
  SetProp(P_KILL_MSG, "Ich werd Dir beibringen ueber meine Geschichten zu "
                      "lachen.\n");
  SetProp(P_REJECT, ({ REJECT_KEEP,
     "Lifthrasir bedankt sich.\n" }) );


}

 
