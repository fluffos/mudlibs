//*******************************************//
//                                           //
// BLAITHIN                                  //
// Ladenbesitzerin in Polari                 //
// Bei ihr beginnt die <Suche nach Marisol>  //
//                                           //
//*******************************************//



inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../polstadt.h"

string gibkorb();

#define QUESTKEY "Finde die kleine Marisol"

void create()
{
 if (!is_clone(this_object()))
 return;

  ::create();

  SetProp(P_SHORT, "Blaithin");
  SetProp(P_LONG,
     "Vor Dir steht Blaithin, die Besitzerin dieses Ladens. Ihr blondes "
     "langes Haar wellt sich sanft ueber ihr weisses wallendes Kleid. "
     "Ihn ihren tuerkisen Augen meinst Du ein kindliches unvoreingenommenes "
     "Wesen erkennen zu koennen. Aber lass Dich von ihrem jugendlichem "
     "Erscheinungsbild nicht taeuschen, sie hat in ihrem Leben sicherlich "
     "schon einige Erfahrungen gesammelt. "); 
  SetProp(P_NAME, "Blaithin");
  set_living_name("blaithin");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "hexe", "blaithin", "besitzerin", "\nhebelblaithin" }) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_LOG_INFO, "/clementine/blaithin");
 
 
  create_default_npc(32);
  SetProp(P_HANDS, ({ " mit Weisheit", QueryProp(P_HANDS)[1],
                      DT_MIND }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS,
     ([ DT_MAGIC: -0.8,
     DT_POISON: -1, DT_TERROR: -1,     DT_FIRE:-0.5,
     DT_COLD:0.4,   DT_WATER:0,
     DT_AIR:0,      DT_LIGHTNING:-0.5, DT_EXPLOSION:0,
     DT_SOUND:0,    DT_LIGHT:0,        DT_ELECTRIC:1,
     DT_HOLY:-1,    DT_UNHOLY:0, ]) );

  SUID;
  CLONEME("/p/armour/boots/lederschuhe.lpc");
  command( "trage alles" );
  CLONEME("/obj/money");
  present("geld")->AddAmount(199);

  SetProp(P_DIE_MSG, " gleitet zu Boden.\n");
  SetProp(P_MURDER_MSG, "Ich habe keine Angst vor dem Tod, weil ich weiss, "
                        "dass ich mein Leben bewusst gelebt habe.\n");
  SetProp(P_KILL_MSG, "Zieh Deine Erfahrung daraus!\n");
  SetProp(P_REJECT, ({ REJECT_KEEP,
     "Blaithin macht einen liebevollen Knicks.\n" }) );

// INFOS !!!

  AddInfo( ({ "marisol" }),
    "Meine kleine Marisol ist verschwunden. Ich war auf dem Weg durch die "
    "Unterwelt, wo ich nach bestimmten Kraeutern suchte, da tauchte auf "
    "einmal eine Maus auf, und Marisol lief ihr natuerlich sofort hinterher. "
    "Nach stundenlanger Suche hab ich sie immer noch nicht finden koennen, "
    "und hab mich auf den Heimweg begeben. Bitte hol sie wieder zu mir "
    "zurueck!", "weint: ");

  AddInfo( ({ "katze" }),
    "Ich hab sogar ein Bild meiner suessen kleinen Marisol, moechtest Du es "
    "haben?", "fragt: ");

  AddInfo( ({ "hilfe" }),
    "Wuerdest Du mir wirklich helfen wollen? Du musst wissen, es gibt auch "
    "einen kleinen Trick, der Dir bei der Suche sicherlich behilflich sein "
    "wird. ", "sagt: ");

  AddInfo( ({ "trick" }),
    "Meine Kleine frisst aeusserst gerne Saibling. Vielleicht koenntest Du "
    "ja einen beschaffen, und sie damit anlocken. ", "sagt: ");


  AddInfo( ({ "korb", "katzenkorb" }), #'gibkorb);

}

string gibkorb()
{
 object ob;
 if(ob=present("\nqmkorb", TP))
 {
  write(BS("Blaithin sagt: Aber Du hast doch schon einen!"));
 }
 else
 {
  tell_object(TP,
       "Blaithin drueckt Dir einen Katzenkorb in die Hand.\n");
  ob = clone_object(OBJ "korb");
  ob->move(TP, M_NOCHECK);
         
  return("sagt: Hier hast Du ihn.\n"
         "Blaithin sagt: Bitte bring mir meine kleine Marisol "
         "heil zurueck!\n" );
 }
}


