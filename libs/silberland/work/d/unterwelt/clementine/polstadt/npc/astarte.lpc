
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../polstadt.h"

create()
{
 if (!is_clone(this_object()))
 return;

  ::create();
 
  SetProp(P_SHORT, "Astarte, die Weise" );
  SetProp(P_LONG,
     "Vor Dir steht Astarte, die Aelteste aller Hexen, aber sicherlich " 
     "auch die erfahrenste. Ihr graues Haar "
     "faellt wallend von ihren Schultern. "
     "Unmengen von Kraeutersaeckchen "
     "hat sie um ihren Bund befestigt. Freundlich und weise blinzelt sie "
     "Dich mit ihren Augen an. ");
  SetProp(P_NAME, "Astarte" );
  set_living_name( "astarte" );
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "astarte", "hexe", "weise" }) );

  create_default_npc( 67 );
  SetProp(P_XP, 10910075 );
  SetProp(P_ALIGN, 900 );
  SetProp(P_BODY, 490 );
  SetProp(P_SIZE, 173);
  SetProp(P_RACE, "Mensch");
  SetProp(P_HANDS, ({ " mit Weisheit", QueryProp(P_HANDS)[1],
                       DT_MIND }) );
  SetProp(P_MAX_HANDS, 2);
  
  SetChats(5, ({
     "Astarte blinzelt Dich an.\n",
     "Astarte versinkt in Gedanken.\n",
     "Astarte seufzt.\n",
     "Astarte blickt sich aengstlich um.\n" }) );


  SetProp(P_DIE_MSG, " loest sich gaenzlich auf.\n");
  SetProp(P_NOCORPSE, 1 );

  SetProp( P_REJECT, ({ REJECT_KEEP, "Astarte freut sich.\n" }) );

  SetProp(P_DEFAULT_INFO, "zuckt ratlos mit den Schultern.\n");

  AddInfo( ({ "hexe", "hexen"}),
     "Im Allgemeinen wurden wir Hexen ja eigentlich immer "
     "geduldet und geschaetzt - auch die Kirche achtete uns. Doch "
     "frueher oder spaeter entwickelte sich ein wahnhafter Hass gegen "
     "uns. Die Hysterie griff um sich. Sogar Familienangehoerige wurden "
     "der Hexerei beschuldig, dabei wollten wir doch alle nur "
     "in Frieden nebeneinander leben.\n"
     "Zwei Maenner verfassten eines Tages "
     "ein Schriftstueck.\n"
     "Sie nannten es Malleus Maleficarum. Es wurde als Art "
     "Handbuch gehandelt und galt als Anleitung zum Aufspueren und "
     "Ausrotten von Hexen.\n", "sagt: ");


  AddInfo( ({ "malleus maleficarum" }),
     "Mit dem Buch war es jedem moeglich bei der Vernichtung der "
     "Hexen mitzuwirkn. "
     "Seitdem sind schon viele Jahre vergangen.\n", "sagt: ");

  AddInfo( ({ "jahr", "jahre" }),
     "Es sind schon viele Jahre vergangen seitdem...die Situation "
     "hat sich laengst gelegt, aber ein neues Problem naehert "
     "sich mit einer imensen Geschwindigkeit und macht uns allen "
     "grosse Angst.\n", "sagt: ");

  AddInfo( ({ "angst" }),
     "Wir Hexen haben grosse Angst.\n", "sagt: ");

  AddInfo( ({ "problem" }),
     "Hoere gut zu!\n"
     "Die meisten Buecher wurden verbrannt, doch eines blieb "
     "erhalten. Ein maechtiger Zauberer der schwarzen Magie besitzt es. "
     "Aber es gibt einen Trick ihn zu toeten, doch in all meiner Sorge "
     "habe ich diesen vergessen. Vielleicht findest Du irgendwo noch "
     "einen Hinweis darauf, ich muesste es irgendwo notiert haben.\n",
     "sagt: ");

  AddInfo( ({ "hinweis" }),
     "Ich habe es irgendwo notiert, aber ich kann mich nicht mehr "
     "daran erinnern.", "sagt: ");

  AddInfo( ({ "frieden", "friede" }),
     "sagt: Wir wollten alle nur Frieden, doch eines Tages geschah etwas.\n");

  AddInfo( ({ "kirche" }),
     "sagt: Auch die Kirche bat uns oft um Rat.\n");

  AddInfo( ({ "buecher", "buch" }),
     "sagt: Ich habe viele Buecher, suchst Du ein bestimmtes?\n");

} 

 


