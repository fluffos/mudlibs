
inherit "std/npc";
inherit "std/npc/spells";

#include <class.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../polstadt.h"

create()
{
 if (!is_clone(this_object()))
 return;

  ::create();

  SetProp(P_SHORT, "Marisol, die kleine Katze");
  SetProp(P_LONG, 
    "Eine kleine grau-schwarze Katze, deren Fell marmoriert ist. Sehr "
    "auffallend sind ihre orange leuchtenden Augen, durch die sie Dich "
    "anblinzelt.\n"
    "     .       .\n"         
    "     \\\`-\"\'\"-\'/\n"
    "      } 6 6 {\n"    
    "     =.  Y  ,=\n"   
    "       /^^^\\   .\n"
    "      /     \\  )\n"      
    "     (  )-(  )/\n" 
    "      \"\"   \"\"\n"
    "\n");   
  SetProp(P_NAME, "Marisol");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  create_default_npc(5);
  SetProp(P_HANDS, ({ " mit ihren Krallen", QueryProp(P_HANDS)[1],
          DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ALIGN, 1000);
  SetProp(P_RACE, "Katze");
  SetProp(P_SIZE, 23);
  SetProp(P_NOATTACK, "faehrt ihre Krallen aus, und flitzt durch Deine Beine.");

  AddId( ({ "katze", "marisol", "\nkatzekorb" }) );
  AddId( ({ "FELL_WUSCHEL" }) );

  SetProp(P_MSGIN, "schleicht herein");

 SetProp(P_DEFAULT_INFO, "miaut Dich an.\n");
 SetProp(P_REJECT, ({ REJECT_DROP,
   "Marisol weicht Dir aus.\n" }) );


} 


void bla()
{
 object raum;
 if(ENV(TO)->IsOpen() && ENV(TO)->id("\nqmkorb"))
 { 
  raum = ENV(TO);
  while(ENV(raum))
  {
   raum = ENV(raum);
  }
  raum->Message(BS("Marisol springt aus dem offenen Katzenkorb."),
  MSGFLAG_VISUAL);
  TO->remove();
 }
 call_out("bla", 15+random(10));
 return;
}

void init()
{

 if(!is_clone(TO)) return;

 ::init();

 if(!TP) return;
 if(!interactive(TP)) return;
 
 if(find_call_out("bla") != -1) return;

 call_out("bla", 0);

}


void StartReaction(string verb, string gruppe, string adverb, int touch)
{
 if(find_call_out("react")!= -1) 
 return;
 switch(gruppe)
 {
  case "boese":
	call_out("react", 0, TP, "faehrt ihre Krallen aus.", 0);
    break;
  
  case "lieb":
    call_out("react", 0, TP, "kuschelt sich an Dich an.", "kuschelt sich "
                         "an "+CTPN +" an.");
    break;
 
  case "froehlich":
    call_out("react", 0, TP, "schnurrt.", 0);
    break;

  case "frech":
    call_out("react", 0, TP, "miaut zufrieden.", 0);
    break;
 }
}


void react(string victim, string others)
{
 if(present(TP, ENV(TO)))
 {
  if(!others)others = victim;
  tell_object(TP, BS(Name(WER, 1) + " "+victim) );
  tell_room(ENV(TO), BS(Name(WER, 1)+ " "+others), ({ TP, TO }) );
 }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
 return StartReaction(verb, gruppe, adverb, touch);
}

