inherit "std/mnpc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../polstadt.h"

create()
{
  if (!is_clone(this_object()))
  return;

  ::create();

  SetProp(P_SHORT,"Anamcara");
  SetProp(P_LONG, "");
  SetProp(P_NAME, "Anamcara");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Mensch");
  SetProp(P_ARTICLE, 0); 
  SetProp(P_SMELL, "Anamcara riecht holzig!\n");

  set_living_name("anamcara");
  AddId( ({ "hexe", "anamcara", "bewohnerin" }) );
  create_default_npc(36);
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, 800);
  SetProp(P_HANDS, ({ " mit ihrer Weisheit", QueryProp(P_HANDS)[1],
                      DT_MIND }) );
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_RESISTANCE_STRENGTHS,
     ([ DT_MAGIC: -0.5,
     DT_POISON: -1, DT_TERROR: -1, DT_FIRE:-1,  DT_COLD:-0.2,   DT_WATER:0.4,
     DT_AIR:0,   DT_LIGHTNING:-0.5, DT_EXPLOSION:0,
     DT_SOUND:0, DT_LIGHT:0,  DT_ELECTRIC:1,
     DT_HOLY:0,  DT_UNHOLY:0, ]) );

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_MURDER_MSG, "Buesse!\n");
  SetProp(P_KILL_NAME, "Anamcara");
  SetProp(P_KILL_MSG, "Gegen mich kann man nicht siegen!\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Anamcara sagt: Ich bin mit dem wenigen, was ich besitze gluecklich.\n"}) );

  SetProp(P_MNPC_AREA, ({"/d/kristallwald/sargola/wald/room/", "/d/kristallwald/sargola/see/room/"}));
  SetProp(P_MNPC_DEFAULTROOM, "/d/kristallwald/sargola/wald/room/1002");

  

// INFOS

  SetProp(P_DEFAULT_INFO, "sagt: Da kann ich Dir leider nicht weiterhelfen. ");

  AddInfo( ({ "anamcara" }),
    "So heisse ich! Anamcara bedeutet uebersetzt Seelenfreund. ", "sagt: ");

  AddInfo( ({ "seelenfreund" }),
    "Ein schoener Name, nicht wahr? ", "sagt: ");

  AddInfo( ({ "tessa", "moppy" }),
    "Wenn Du wissen moechtest, wann Tessa Geburtstag hat, dann solltest Du "
    "sie selbst danach fragen. ", "sagt: ");

  AddInfo( ({ "astarte" }),
    "ruft: Die Goetter moegen sie beschuetzen! ");

  AddInfo( ({ "hexen", "hexe" }),
    "Darueber moechte ich nicht sprechen. ", "sagt: ");

  AddInfo( ({ "name" }),
    "Ich heisse Anamcara! ", "sagt: ");

  AddInfo( ({ "spieler", "spielern" }),
    "Von manchen Spielern kenne ich den Baum. Frag mich einfach nach deren "
    "Namen. ", "sagt: ");

// SPIELERINFOS

  AddInfo( ({ "slay", "slayven" }),
    "sagt: Slayven ist eine Haselnuss. ");

  AddInfo( ({ "juny" }),
    "sagt: Juny ist ein Feigenbaum. ");

  AddInfo( ({ "eldar", "sauron" }),
    "sagt: Eldar ist eine Ulme. ");

  AddInfo( ({ "yeza", "nell" }),
    "sagt: Yeza ist eine Kiefer. ");

  AddInfo( ({ "trintrasil" }),
    "sagt: Trintrasil ist eine Kastanie. ");

  AddInfo( ({ "sengir" }),
    "sagt: Sengir ist ein Nussbaum. ");

  AddInfo( ({ "macalla" }),
    "sagt: Macalla ist ein Nussbaum. ");

  AddInfo( ({ "tyron" }),
    "sagt: Tyron ist ein Nussbaum. ");

  AddInfo( ({ "buzzom" }),
    "sagt: Buzzom ist eine Eberesche. ");

  AddInfo( ({ "roc" }),
    "sagt: Roc ist ein Nussbaum. ");

  AddInfo( ({ "levitikus", "levi" }),
    "sagt: Levitikus ist eine Pappel. ");

  AddInfo( ({ "failin" }),
    "sagt: Failin ist eine Pappel. ");

  AddInfo( ({ "utx" }),
    "sagt: Utx ist ein Zuergelbaum. ");

  AddInfo( ({ "gridi" }),
    "sagt: Gridi ist eine Linde. ");
  
  AddInfo( ({ "pro", "protheg" }),
    "sagt: Protheg ist eine Kastanie. ");

  AddInfo( ({ "dante" }),
    "sagt: Dante ist eine Kiefer.");

  AddInfo( ({ "babba", "nutella" }),
    "sagt: Babba ist eine Weide. ");

  AddInfo( ({ "skunk" }),
    "sagt: Skunk hat ist ein Zuergelbaum. ");

  AddInfo( ({ "snoopie", "smurfi" }),
    "sagt: Snoopie ist ein Zuergelbaum. ");

  AddInfo( ({ "invis", "invisible" }),
    "sagt: Invisible ist eine Eberesche. "); 
 
  AddInfo( ({ "cherub", "fangorn" }),
    "sagt: Cherub ist ein Ahorn. ");

  AddInfo( ({ "semira" }),
    "sagt: Semira ist eine Kastanie. ");

  AddInfo( ({ "creative", "crea" }),
    "sagt: Creative ist eine Ulme. ");

  AddInfo( ({ "engywuck" }),
    "sagt: Engywuck ist ein Apfelbaum. ");

  AddInfo( ({ "elvira" }),
    "sagt: Elvira ist ein Zuergelbaum. ");

  AddInfo( ({ "fester" }),
    "sagt: Fester ist ein Apfelbaum. ");

  AddInfo( ({ "hotaru" }),
    "sagt: Hotaru ist ein ");

  AddInfo( ({ "clementine" }),
    "sagt: Ich sag Dir nicht, was Clementine ist :P ");
  
  AddInfo( ({ "hactar" }),
    "sagt: Hactar ist eine Ulme. ");

  AddInfo( ({ "kleine" }),
    "sagt: Kleine solltest Du lieber selbst danach fragen! ");

  AddInfo( ({ "aurora" }),
    "sagt: Aurora ist ein Apfelbaum. ");

  AddInfo( ({ "kailani" }),
    "sagt: Kailani ist eine Kiefer. ");

  AddInfo( ({ "flak", "devries" }),
    "sagt: Devries ist ein Ahorn. ");



// BAUMHOROSKOPINFOS !!!


  AddInfo( ({ "baum", "baeume" }),
    "Wenn Du mich nach einem bestimmten Baum fragst, dann erzaehle ich Dir "
    "gerne mehr ueber seine Bedeutung. ", "sagt: ");

  AddInfo( ({ "bedeutung" }),
    "Jeder Baum hatte bei den Kelten eine andere Bedeutung.", "sagt: ");

 

  AddInfo( ({ "baumhoroskop", "keltisches baumhoroskop", "horoskop" }),
    "Damit kenne ich mich sehr gut aus. Leider ist das Keltische "
    "Baumhoroskop in den vergangenen Jahren in Vergessenheit und in den "
    "Schatten anderer Horoskope geraten. Auch ein Baum ist ein Unikat, der "
    "wie die anderen Rassen licht- und sonnenabhaengig ist. So lassen sich "
    "schon Parallelen in ihren Lebenslaeufen feststellen. Denn nur wer im "
    "Einklang mit Natur und Umwelt lebt, um die eigenen Staerken und "
    "Schwaechen weiss, der kann dem Leben die Stirn bieten.\n"
    "Wenn Du wissen moechtest, welcher Baum fuer Dich steht, so frag mich "
    "einfach nach Geburtstag. ", 
    "sagt: ");

  AddInfo( ({ "geburtstag" , "geburtsdatum", "datum", "geburtstage" }),
    "23.12. - 01.01. / 25.06. - 04.07. *Apfelbaum*\n"
    "02.01. - 11.01. / 05.07. - 14.07. *Tanne*\n"
    "12.01. - 24.01. / 15.07. - 25.07. *Ulme*\n"
    "25.01. - 03.02. / 26.07. - 04.08. *Zuergelbaum*\n"
    "04.02. - 08.02. / 05.08. - 13.08. *Pappel*\n"
    "09.02. - 18.02. / 14.08. - 23.08. *Zypresse*\n"
    "19.02. - 29.02. / 24.08. - 02.09. *Kiefer*\n"
    "01.03. - 10.03. / 03.09. - 12.09. *Weide*\n"
    "11.03. - 20.03. / 13.09. - 22.09. *Linde*\n"
    "21.03. *Eiche*\n"
    "23.09. *Oelbaum*\n"
    "22.03. - 31.03. / 24.09. - 03.10. *Haselnuss*\n"
    "01.04. - 10.04. / 04.10. - 13.10. *Eberesche*\n"
    "11.04. - 20.04. / 14.10. - 23.10. *Ahorn*\n"
    "21.04. - 30.04. / 24.10. - 11.11. *Nussbaum*\n"
    "01.05. - 14.05.  *Pappel*\n"
    "15.05. - 24.05. / 12.11. - 21.11. *Kastanie*\n"
    "25.05. - 03.06. / 22.11. - 01.12. *Esche*\n"
    "04.06. - 13.06. / 02.12. - 11.12. *Hainbuche*\n"
    "14.06. - 23.06. / 12.12. - 21.12. *Feigenbaum*\n"
    "24.06. *Eiche*\n"
    "22.12. *Buche*\n",
    "sagt: ");



  AddInfo( ({ "esche" }),
    "Die Esche - Der Ehrgeiz\n"
    "Die Esche hat ein ungewoehnliches anziehendes Wesen und ist beliebt "
    "bei Freunden und Fremden. Aufgrund ihres lebhaften Charakters, impulsiv "
    "und fordernd, macht sie stets das, was sie fuer richtig haelt und pfeift "
    "auf Kritik oder gar boshafte Bemerkungen. Sie steht immer ueber der "
    "Masse. Die Esche ist ehrgeizig, intelligent, begabt und fast immer eine "
    "glaenzende Persoenlichkeit. Hochgesteckte Ziele erreicht sie meist "
    "spielend, doch wenn ihr das nicht gelingt, zieht sie sich von der Welt "
    "zurueck. Meist sucht sie das Ungewoehnliche und spielt mit dem Schicksal. "
    "Obwohl sich die Esche im allgemeinen wohlwollend und freundschaftlich "
    "verhaelt, kann sie auch egoistisch sein und ihrer Umgebung ihre "
    "Forderungen aufdraengen. Aber was soll man anderes erwarten, schliesslich "
    "handelt es sich bei der Esche ja nie um eine durchschnittliche "
    "Persoenlichkeit. Stets kann man ihr vertrauen und auf sie bauen. "
    "In der Liebe ist dieser schwaermerische Individualist treu und umsichtig. "
    "Manchmal ueberwiegt der Verstand das Gefuehl, aber wenn sich die Esche "
    "einmal fuer das Leben zu zweit entschieden hat, dann ist es ihr ernst "
    "damit. Ob es stuermt oder schneit, ob gute oder schlechte Tage kommen, "
    "im Schatten ihrer Zweige wird es Dir immer gut gehen. ", "sagt: ");


  AddInfo( ({ "apfelbaum" }),
    "Der Apfelbaum - Die Liebe\n"
    "Der Apfelbaum verkoerpert die Anziehungskraft auf das andere Geschlecht. "
    "Deshalb bleibt es oft nicht ohne Folge, dass in diesem Zeitraum "
    "geborene haeufig zu Flirts und Abenteuer bereit sind. Da jedoch der "
    "sehnlichste Wunsch dieser Menschen ist, zu lieben und geliebt zu werden, "
    "werden sie bei einer Partnerschaft, die fuer sie richtig und wahrhaftig "
    "erscheint, treu und vernuenftig sein. Dem Apfelbaum fehlt die "
    "Eigenschaft, sich eigennuetzig zu verhalten, so ist er sehr beliebt, "
    "geht aber auch sehr haeufig das Risiko ein, ausgenutzt zu werden und "
    "sein letztens Hemd herzugeben. Er lebt gern in den Tag hinein und denkt "
    "selten an die Zukunft. Der Apfelbaum fuehrt ein ruheloses, interessantes "
    "und aufregendes Leben.", "sagt: ");

  AddInfo( ({ "tanne" }),
    "Die Tanne - Das Geheimnisvolle\n"
    "In dieser Zeit geborene sind Aestheten, sie lieben Schmuck und schoene "
    "Gebrauchsgegenstaende. Im allgemeinen ist die Tanne mit einem langen "
    "Leben gesegnet, es kommt aber vor, da� sie an chronischen Krankheiten "
    "leidet. Sie steht im Leben und identifiziert sich mit Ihrem Umfeld und "
    "ist ihm gegenueber zu grossen Opfern bereit. Mit einer Tanne umzugehen "
    "ist dennoch nicht immer einfach, denn sie ist haeufig launisch, stur und "
    "kann selbst in grosser Gesellschaft einsam bleiben, denn sie ist "
    "Fremden gegenueber teilweise sehr abweisend. Dabei faellt ihr die "
    "Neigung zum Egoismus nicht immer selbst auf. Die Ansprueche sind sehr "
    "bescheiden. In der Liebe ist sie meist der unzufriedene Partner. Sie "
    "verlangt viel, ist aber nicht bereit viel zu geben, bleibt dabei aber "
    "stets leidenschaftlich und treu. Ihre ungewoehnlich hohe Intelligenz "
    "eroeffnet ihr viele Ausbildungsmoeglichkeiten, die sie auch rege nutzt, "
    "um dann am Ende meist etwas ganz anderes auszuueben. Die Tanne hat oft "
    "Feinde, aber auch treue Freunde, die sie unterstuetzen, wie auch sie "
    "ein zuverlaessiger Mensch ist, der seine Freunde auch in groesster Not "
    "nicht im Stich laesst. ", "sagt: ");

  AddInfo( ({ "zuergelbaum" }),
    "Der Zuergelbaum (Nesselbaum, Wood Of Life) - Die Zuversicht\n"
    "Der Zuergelbaum ist ein hochgewachsener maechtiger Baum von seltener "
    "Schoenheit. Er versteht es ausgezeichnet, sich allen Lebenslagen "
    "anzupassen - obwohl er fuer sich den hoechsten Komfort ersehnt. "
    "In dieser Zeit Geborene erfreuen sich ueberaus starker Gesundheit, "
    "sind nicht gerade schuechtern und neigen leicht dazu, andere "
    "von oben herab zu betrachten. Ihre Selbstsicherheit und Entschlossenheit "
    "verstaerken sich manchmal zu Ungeduld und Reizbarkeit. Sie moechten ihre "
    "Mitmenschen beeindrucken. Es faellt dem Zuergelbaum bei "
    "seinem Fleiss auch nicht "
    "schwer. Rueckschlaege koennen ihn nicht entmutigen. Er wird immer an "
    "sich glauben. Einmal gesteckte Ziele werden immer erreicht - selbst auf "
    "der Gefuehlsebene. Seine Partner betten sich gern in dem Schatten der "
    "grossen Energie eines Zuergelbaumes und sehen in ihm eine feste Stuetze. "
    "Der Zuergelbaum ist schwer zufrieden zu stellen, sehr waehlerisch und "
    "wartet das ganze Leben auf die grosse Liebe. "
    "Bei der Arbeit beweist er "
    "Fuehrungsqualitaeten und kann rasche Entscheidungen treffen. Trotz seiner "
    "Sehnsucht nach Abenteuern fuehrt er meist ein einfaches, wenn auch "
    "erfuelltes Berufsleben. ", "sagt: ");

  AddInfo( ({ "kastanie" }),
    "Die Kastanie - Die Redlichkeit\n"
    "Die Kastanie ist von einer nicht alltaeglichen Schoenheit und gewinnt "
    "erst durch naeheres Kennenlernen. Sie bemueht sich nei um Gunst der "
    "anderen und will niemanden beeindrucken. Sie besitzt ein ausgepraegtes "
    "Gerechtigkeitsgefuehl, reagiert lebhaft und interessiert, kann sich fuer "
    "eine Idee begeistern und voll einsetzen, kann sich aber auch still "
    "zurueckziehen. In Gesellschaft ist sie reizbar und empfindlich, doch "
    "meist nur aus Mangel an Selbstvertrauen, Sie findet nur schwer einen "
    "Partner obwohl sie sich nach einer festen Beziehung sehnt. Fuer ihre "
    "Familie tut sie alles und weiss sich in allen Lebenslagen zu helfen. ",
    "sagt: ");

  AddInfo( ({ "ulme" }),
    "Die Ulme - Die gute Gesinnung\n"
    "Die Ulme hat meist eine schoen anzusehende Gestalt, die zu pflegen "
    "und kleiden sie versteht und um so attraktiver wirkt. Dabei hat sie im "
    "Grunde bescheidene Ansprueche und wird sich oder anderen das Leben "
    "nicht schwer machen. Sie stellt jedoch an andere hohe Ansprueche und "
    "neigt dazu anderen ihre Fehler uebel zu nehmen. Dies resultiert aus "
    "ihrer Eigenschaft als Fuehrungsperson. Sie gehorcht nur sehr ungern. "
    "In der Freizeit wie in der Familie. Sie kraenkelt oft, jedoch nicht "
    "ernsthaft, obwohl sie nach aussen hin eine robuste, widerstandsfaehige "
    "Natur abgibt. Die Ulme ist humorvoll und praktisch veranlagt und "
    "verfuegt ueber einen ueberdurchschnittlichen Verstand, was ihr die "
    "Moeglichkeit gibt, ihre Leben weit im Voraus zu planen und so alle "
    "gegebenen Moeglichkeiten weise ausschoepfen kann. ", "sagt: ");

  AddInfo( ({ "zypresse" }),
    "Die Zypresse - Die Treue\n"
    "Die Zypresse ist stark und solide gebaut und wirkt oft eher staemmig. "
    "Durch ihren biegsamen Charakter erleichtert sie sich das Leben. Sie "
    "braucht wenig zum Glueck, denn sie nimmt das Leben wie es kommt und kann "
    "unter allen Umstaenden heiter, zufrieden und voll Optimismus sein. "
    "Wichtig sind nur zwei Dinge: ein gesundes Auskommen und viel Anerkennung. "
    "Die Zypresse scheut die Einsamkeit und moechte immer von Familie "
    "und Freunden umgeben sein. In der Liebe ist sie stuermisch, "
    "unersaettlich und nicht zufrieden zu stellen. Ihren Freunden gegenueber "
    "verhaelt sie sich wohlwollend und treu. Ihr Wesen ist wenig sentimental, "
    "einerseits pedantisch, andererseits auch nachlaessig. Sie mag keine "
    "Diskussionen, liebt es aber sehr, sich auszusprechen. Dank ihrer wachen "
    "Intelligenz und ihrer Faehigkeit, zu reflektieren wird sich die Zypresse "
    "ihr Leben ausgewogen einrichten: Arbeit und Vergnuegen in einem "
    "gleichmaessigen Verhaeltnis. Dennoch fehlt ihr immer irgendetwas in "
    "ihrem Leben. ", "sagt: ");

  AddInfo( ({ "pappel" }),
    "Die Pappel - Die Ungewissheit\n"
    "Die Pappel ist sehr schoen anzusehn und scheint nicht zu altern. "
    "Im Allgemeinen hat sie ein sehr sicheres Auftreten und beweist ihren "
    "Mut nur, wenn es wirklich sein muss, doch selbst dann hat sie das "
    "Gefuehl auf einsamen Posten zu stehen. Die Zeit lastet schwer auf ihren "
    "Schultern und spielt dementsprechend eine zentrale Rolle in ihrem "
    "Leben. Obwohl sie Wohlwollen und eine angenehme Umgebung braucht, "
    "ist sie meist einsam und allein, da sie sehr waehlerisch ist. Ihre "
    "uebergrosse Empfindsamkeit macht ihr das Leben mit anderen schwer. "
    "Ihre Empfindungen und Erlebnisse behaelt sie meist tief in ihrem Inneren. "
    "Sie ist kuenstlerisch und philosophisch veranlagt und ein guter "
    "Organisator. Ihre schoenste Eigenschaft ist die Zuverlaessigkeit in "
    "schweren Situationen. Partnerschaften nimmt sie sehr ernst und trennt "
    "sich nur sehr selten von einem Partner. Durch Liebe wird das "
    "unabhaengige Wesen der Pappel weich und abhaengig. ", "sagt: ");

  AddInfo( ({ "kiefer" }),
    "Die Kiefer - Das waehlerische Wesen\n"
    "Die Kiefer ist ein Zeichen unter dem besonders die Frauen gedeihen. "
    "Sie sind ich ihrer Reize bewusst und sogar etwas in sich selbst verliebt. "
    "Kiefern bewegen ich gern in netter Gesellschaft. Trotz scheinbarer "
    "Schwaeche ist sie sehr widerstandsfaehig und versteht es, sich das Leben "
    "so angenehm wie moeglich zu machen. Sie findet sich ueberall zurecht "
    "und wird immer etwas fuer sich erreichen, Sie ist ein guter Kamerad "
    "und richtiger Kumpel, Freundschaft betrachtet sie aber mit "
    "Zurueckhaltung. Sie verliebt sich sehr schnell und brennend, jedoch "
    "verschwindet ihre Liebe auch wieder genau so schnell. Sie gibt schnell "
    "auf und wird deshalb viele Enttaeuschungen erleben, bis sie ihrem "
    "Ideal begegnet. Sie ist ein ausgezeichneter Organisator und findet "
    "in ihrer Arbeit Ausgleich, solange nicht wieder eine Empfindung "
    "in ihr Leben eintritt, die sie immer sehr ernst nimmt und sich damit "
    "manchmal um Kopf und Kragen denkt. ", "sagt: ");


  AddInfo( ({ "weide" }),
    "Die Weide - Die Melancholie\n"
    "Dieser Baum ist schoen, doch voller Wehmut. Die weibliche Trauerweide "
    "ist von unbestreitbarer Anmut und die maennliche findet beim anderen "
    "Geschlecht viel Anerkennung. Sie ist ausgesprochen einfuehlsam in der "
    "Liebe und gegenueber anderen Mitmenschen. Die Trauerweide ist "
    "kuenstlerisch veranlagt und liebt das Schoene in jeder Gestalt. Es "
    "zieht sie hinaus in die Welt, auf Ausfluege und Reisen, wobei sie "
    "jedoch auch immer wieder nach Hause zurueckkehrt, da sie an Haus und "
    "Familie haengt. Die Trauerweide besitzt die Faehigkeit, manche "
    "Ereignisse vorauszuahnen. Dadurch versetzt sie ihre Umgebung immer wieder "
    "in Erstaunen. In der Liebe leidet sie oft, aber manchmal findet sie "
    "in der Partnerschaft die ersehnte Zuflucht. Dann jedoch fuehlt sie "
    "sich oft insgeheim unverstanden und zu gering geschaetzt. ", "sagt: ");

  AddInfo( ({ "linde" }),
    "Die Linde - Der Zweifel\n"
    "Je aelter sie wird, um so mehr freut sich die Linde des Wohlwollens und "
    "der Anerkennung von Verwandten und Freunden. Ruhig und gelassen nimmt "
    "sie an, was das Leben ihr bringt. Muehe, Kampf und Hetze sind ihre "
    "Feinde, da ihr Charakter leicht traege, zur Bequemlichkeit neigend, sanft "
    "und nachgiebig ist. Dauernd traeunmt sie von einem Leben in Wohlstand, "
    "von Zielen, die sie nicht erreichen kann, Das ist auch der Grund, warum "
    "sie oft mit ihrem Schicksal hadert, unzufrieden ist oder gar jammert "
    "und klagt. Trotzdem ist das Leben mit ihr leicht und angenehmn, denn die "
    "Linde ist gut und Aufopferungsbereit fuer alle, die ihr nahestehen. Sie "
    "ist intelligent und vielseitig begabt; doch kommen ihre Faehigkeiten "
    "meist nicht voll zur Entfaltung, da es ihr an der notwendigen Ausdauer "
    "fehlt. Manche Linden kommen in ihrer klagenden Einstellung sogar bis "
    "zu einer gewissen Wunderlichkeit; andere schliessen sich fest und voll "
    "Ergebenheit an andere Menschen an, wenn sie in ihnen eine verwandte "
    "Seele vermuten. In der Liebe findet sie allerdings selten das "
    "ertraeumte Glueck. ", "sagt: ");

  AddInfo( ({ "oelbaum" }),
    "Der Oelbaum - Die Weisheit\n"
    "Obwohl der Oelbaum eher unscheinbar wirkt, hat er durchaus auch seine "
    "Reize. Er liebt die Sonne und die Waerme wahrer Gefuehle bringt ihn voll "
    "zum Erbluehen. Wenn er erkrankt, dann meistens an Rheuma, von dem er dann "
    "ein Leben lang geplagt wird. Er ist vernuenftig und ausgeglichen und geht "
    "Aggressionen und Gewalt immer aus dem Weg. Seine grosse Diskretion haelt "
    "ihn davon ab, sich in das Leben anderer einzumischen, Diese Toleranz und "
    "Zurueckhaltung bedeutet aber nicht, dass ihm die Angelegenheiten seiner "
    "Mitmenschen gleichgueltig sind, im Gegenteil, diese bewegen ihn tief. "
    "Sein heiteres Gemuet, sein ruhiger Charakter, sein ausgepraegter "
    "Gerechtigkeitssinn und sein einfuehlsames Verhalten helfen ihm, die "
    "Situation seiner Mitmenschen zu verstehen und daran Anteil zu nehmen. "
    "In der Liebe scheint er frei von Efiersucht zu sein� zumindest zeigt er "
    "sie nie. Er toleriert die Freiheit des Partners, auch wenn es ihm "
    "weh tun sollte. Doch das ist keine Schwaeche oder Resignation, sondern "
    "einfach seine Lebenseinstellung. Er ist intelligent, kann in sich "
    "gehen, liebt Buecher und befindet sich gern in der Gesellschaft "
    "kluger Menschen. ", "sagt: ");

  AddInfo( ({ "eberesche" }),
    "Die Eberesche - Das Feingefuehl\n"
    "Die scheinbare Zartheit der Eberesche truegt, sie ist stark, ausdauernd "
    "und stellt sich den Schicksalsschlaegen und Stuermen des Lebens aufrecht "
    "entgegen. Obwohl man auf ihrem Gesicht oefter das Laecheln als die "
    "Traenen findet, erleidet sie jeden Kummer - fremden oder eigenen - tief "
    "und intensiv. Zwar ist sie ohne Egoismus, aber doch stets bemueht, nicht "
    "nur die Blicke auf sich zu ziehen, sondern auch viele Angelegenheiten "
    "in ihre Regie zu nehmen. Sie liebt das Leben, die Bewegung, die "
    "Unruhe und sogar Komplikationen - sie ist abhaengig udn unabhaengig "
    "zugleich! Manchmal kompliziert sie auch das Leben durch unnoetiges "
    "Abwaegen und Analysieren. Ihr guter Geschmack und ihre "
    "Einfuehlungsvermoegen machen sie fuer kuenstlerische Berufe geeignet, "
    "aber auch in anderen Bereichen kann sie viel erreichen. Sie ist ein "
    "guter Gesellschafter, aber Fehler vergibt sie nie und meistens "
    "ist sie es, die eine Beziehung aufgibt. Aufgrund ihrer Sensibilitaet "
    "koennte sie manches vorausahnen, wenn sie nur daran glauben wuerde. ", 
    "sagt: ");

  AddInfo( ({ "ahorn" }),
    "Der Ahorn - Die Eigenwilligkeit\n"
    "Der Ahorn ist ein Mensch, der aus der Menge herausragt und - ob im guten "
    "oder schlechten - sich durch Originalitaet und Phantasie abhebt. "
    "Einerseits schuechtern und zurueckhaltend besitzt er doch ungeheuren "
    "Ehrgeiz und Stolz. Fuer Schmeicheleien ist er durchaus empfaenglich und "
    "er liebt es, wenn man ueber ihn spricht. Falls es sich als notwendig "
    "erweist kann er sehr bescheiden leben, ist jedoch nervlich nicht sehr "
    "belastbar, obwohl er groesstenteils von guter Gesundheit ist. Der Ahorn "
    "beherbergt viele Komplexer in seinem Inneren, ist aber sehr intelligent, "
    "lernt spielend einfach und hat ein ausgezeichnetes Gedaechtnis. In der "
    "Liebe ist der Ahorn sehr kompliziert, da er manchmal versucht, anderen "
    "seinen Willen aufzuzwingen. Das Leben des Ahorns ist sehr vielseitig "
    "und interessant, jedoch nicht immer einfach. ", "sagt: ");

  AddInfo( ({ "nussbaum" }),
    "Der Nussbaum - Die Leidenschaft\n"
    "Der Nussbaum hat einen unbeugsamen Charakter, sonderbar und voller "
    "Kontraste. Er vereint in seinem Geist Egoismus und edlen Charakter, "
    "Aggressivitaet und Offenheit. Seine Reaktionen sind spontan und "
    "unerwartet und sein Ehrgeiz ist grenzenlos. Das Fehlen von Flexibilitaet "
    "und seine Unnachgiebigkeit macht ihn jedoch zu einem schwierigen Partner. "
    "Er erfreut sich grosser Autoritaet, ist deswegen aber noch nicht "
    "allerorts beliebt. Er kann ein Stratege von vielseitiger Intelligenz "
    "sein. In Liebesangelegenheiten reagiert er oft eifersuechtig, in "
    "emotionalen sehr leidenschaftlich. Der Nussbaum ist in seinem "
    "Charakterzug extrem. Eine Begegnung mit ihm fuehrt zwangslaeufig zu "
    "Ueberraschungen. Zu positiven, wie auch negativen. ", "sagt: ");

  AddInfo( ({ "hainbuche" }),
    "Die Hainbuche - Der gute Geschmack\n"
    "Die Hainbuche ist von kuehler Schoenheit, die nicht nur in jungen Jahren "
    "viele Blicke auf sich zieht. Sie achtet sehr auf ihr Aeusseres und ihre "
    "Kondition, sie beweist stets einen guten Geschmack. Obwohl sie manchmal "
    "zum Egoismus neigt. tut sie das nur, um sich das Leben so angenehm wie "
    "moeglich zu gestalten. Sie fuehrt ein vernuenftiges, diszipliniertes "
    "Leben. Doch unter der duennen Schale der Vernunft, schlummern viele "
    "verschiedene Wuensche. So sucht sie Waerme, den gefuehlvollen Partner, "
    "Beifall, Bewunderung und Anerkennung. In der Liebe sucht sie das "
    "Nichtalltaegliche, spinnt Traeume und ist seltem gluecklich mit ihren "
    "Gefuehlen. Sie wird oefter geliebt als sie wieder liebt. Die Hainbuche "
    "ueberlegt zu oft und manchmal zu lange; immer glaubt sie falsch zu "
    "waehlen. Immer hat sie Angst betrogen zu werden und misstraut fast allen "
    "Menschen. Aber sie ist sehr pflichtbewusst, manchmal bis zur "
    "Uebertreibung. Und das kann dann schwer auf ihrem Privatleben lasten. "
    "Trotzdem schlaegt sie haeufig eine kuenstlerische Laufbahn ein. ", 
    "sagt: ");

  AddInfo( ({ "feigenbaum", "feige" }),
    "Die Feige - Die Empfindsamkeit\n"
    "Die Feige ist eine starke, aber etwas eigenwillige Persoenlichkeit, die "
    "nicht jedem gefaellt. Sie ist unabhaengig in ihrem Urteil und duldet "
    "keinen Widerspruch. Sie liebt das Leben im allgemeinen und im "
    "besonderen das familiaere. Doch nicht nur im Kreis der Familie fuehlt sie "
    "sich wohl, sondern sie moechte immer von liebenden Menschen aller Art "
    "umgeben sein. Sie ist ausgesprochen herzlich zu Kindern und Tieren. In "
    "der Liebe ist sie eher flatterhaft, was ihr haeufig Komplikationen, "
    "Sorgen und manchmal sogar Leiden einbringt. Sie ist humorvoll und bekennt "
    "sich insgeheim zur Bequemlichkeit und Faulheit. Trotzdem steht sie mit "
    "beiden beinen fest im Leben und plant geschickt und zielbewusst. Ihre "
    "Begabung und ihre Intelligenz sind fast immer praktischer Natur. ", 
    "sagt: ");

  AddInfo( ({ "haselnuss" }),
    "Die Haselnuss - Das Aussergewoehnliche\n"
    "Die Haselnuss ist eher unauffaellig als eindrucksvoll, doch uebt sie "
    "immer einen eigentuemlichen Einfluss auf ihre Umgebung aus. Ihre "
    "Genuegsamkeit und ihr persoenlicher Charme helfen ihr, die sich selbst "
    "gesteckten Ziele zu erreichen. Wenn sie Wert darauf legt, kann sie sehr "
    "gut Menschen fuer sich gewinnen. Ihre grosse Mitmenschlichkeit bringt "
    "ihr Popularitaet und Wertschaetzung, die sie mag. In der Liebe ist sie "
    "zuweilen launisch, aber trotzdem ein ehrlicher und toleranter Partner. "
    "Ihre Haupteigenschaften sind grosse Intelligenz, Intuition und "
    "scharfe Urteilskraft. Haselnussbaeume haben ein ungewoehnliches, aber oft "
    "kein leichtes Leben. ", "sagt: ");
 

 AddInfo( ({ "birke" }), 
   "Die Birke - Das Schoepferische\n"
   "Die Birke ist ein schoener und zarter Baum: lebhaft, anziehend und "
   "elegant. Immer sympathisch und freundlich ist sie als Gesellschaft gern "
   "gesehen und begehrt, denn sie wird niemals Umstaende bereiten und auch nie "
   "den Geldbeutel ihres Gastgebers belasten. Selbst frei von Ueberheblichkeit "
   "und Snobismus, verabscheut sie alles Vulgaere und Poebelhafte. Sie liebt "
   "das Leben in der Natur, kann sich aber auch mit Leichtigkeit jeder anderen "
   "Lebenssituation anpassen, wenn man sie nur in Ruhe arbeiten laesst. "
   "Und lassen sie sich nicht durch ihr zartes Aussehen taeuschen, sie kann "
   "arbeiten wie ein Berserker. Das Liebesleben der Birke ist nicht besonders "
   "leidenschaftlich, dafuer ist sie aber in ihren Gefuehlen bestaendig und "
   "treu. Sie tut alles nur denkbare, damit ihr Partner mit ihre gluecklich "
   "wird. Und nie wird sie ihre Wahl bereuen, es sei denn, sie hat es "
   "besonders schlecht angetroffen. Ihre Intelligenz ist ueberdurchschnittlich "
   "und mit Vorstellungskraft gepaart. Ihre Intelligenz, Phantasie und ihre "
   "Fleiss sollten ihr eigentlich alle Tueren oeffnen. Doch der Ehrgeiz der "
   "Birke ist nicht sonderlich ausgepraegt. Ein gemuetliches Zuhause, "
   "Zufriedenheit bei der Arbeit und ein gutes Buch genuegen ihr voellig.", 
   "sagt: ");

 AddInfo( ({ "eiche" }), 
   "Die Eiche - Die robuste Natur\n"
   "Die Eiche ist prachtvoll und voller Lebenskraft, schoen und ohne "
   "jegliche Zerbrechlichkeit. Die weibliche Eiche braucht nie Anlehnung, da "
   "sie in jeder Beziehung, koerperlich oder geistig-moralisch, der staerkere "
   "Teil einer Verbindung ist. Sie ist standhaft und wuerdevoll. Die Eichen "
   "erfreuen sich gluecklicherweise meist bester Gesundheit, denn sie haben "
   "eine ausgesprochene Abneigung gegen Krankheiten, Aerzte, Medikamente und "
   "jeder Art von sich haengen lassen - nur der Anblick von Blut macht sie "
   "nervoes. Neben Kraft und Staerke ist Mut die hervorstechende Eigenschaft "
   "der Eiche. Dieser Mut, der immer auf Stolz und niemals auf Uebermut "
   "basiert, ist stets vom Bewusstsein der Gefahr begleitet. Aber ob Gefahr "
   "oder nicht, die Eiche meistert jede Situation mit Tapferkeit. Ihre starke "
   "unbeugsame Wesensart kommt sie oft teuer zu stehen und bringt ihr "
   "haeufig Unannehmlichkeiten. Selbst sehr tolerant, achtet die Eiche die "
   "Freiheit und die Weltanschauung anderer ohne Einschraenkung. Sie ist stets "
   "gastfreundlich und ihren Mitmenschen gegenueber wohlgesonnen, aber auch "
   "unabhaengig und duldet keinerlei Druck. In jungen Jahren verliebt sie sich "
   "haeufig auf den ersten Blick und glaubt dabei immer, die grosse Liebe "
   "ihres Lebens gefunden zu haben. Mit zunehmenden Alter jedoch neigt sie "
   "mehr zu einer Partnerschaft auf Vernunftbasis. Da sie in den "
   "zwischenmenschlichen Beziehungen manchmal egozentrisch sein kann, huetet "
   "sie sich davor, bei einem Empfang eine Eiche als Tischnachbar zu "
   "bekommen. Denn wenn das geschieht, koennten sie wirklich zu bedauern sein! "
   "Die Bestaendigkeit der Eiche liebt keine Veraenderungen. Sie ist mit "
   "handfester, praktischer Intelligenz ausgestattet und steht mit beiden "
   "Beinen fest auf dem Boden der Tatsachen. Bei der Arbeit ist sie meist ein "
   "Mensch der Tat, aber sie kann auch sehr intuitiv vorgehen.", "sagt: ");

 AddInfo( ({ "buche" }),
   "Die Buche - Das Gestalterische\n"
   "Die Buche ist schoen und edel und ist sehr auf ihr Aeusseres bedacht, "
   "manchmal sogar leicht uebertrieben. Sie beweist viel Geschmack, sowohl "
   "in der Auswahl ihrer Kleidung als auch in ihrer Bleibe, wenn sie nur die "
   "notwendigen Mittel dazu hat. Sie ist ein Materialiste. Sie plant nicht nur "
   "kuehne Projekte, sie realisiert sie auch. Ihr Leben ist hervorragend "
   "organisiert. Einerseits praktisch und lebensnah, ist sie doch andersseits "
   "durchaus edler und tiefer Gefuehle faehig. Sie ist sparsam, aber weder "
   "geizig noch verschwenderisch. Fuer fuehrende Positionen ist sie sehr gut "
   "geeignet. Fuer und wider waegt sie genau ab und geht kein unnoetiges "
   "Risiko ein. In der Liebezeichnet sie sich nicht gerade durch Phantasie "
   "aus, sondern auch dabei ist sie eher vernuenftig. DieBuche wuenscht sie "
   "alles was man haben muss - ein komfortables Haus, Kinder Fernsehen, "
   "Autos - es darf auch etwas mehr sein. Sie ist haeuslich und die Ferien "
   "verbringt sie immer im Kreis der Familie. Fast versessen ist sie darauf, "
   "immer in Form zu bleiben. Diaet, Sport - Hauptsache die Figur und die "
   "Schoenheit bleiben bis ins hohe Alter erhalten. ", "sagt: ");
  
   

}


