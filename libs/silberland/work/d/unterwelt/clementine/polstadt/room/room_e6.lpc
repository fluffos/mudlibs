
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
     "Du befindest Dich in einer kleinen Seitenstrasse von Polaris. "
     "Rechts und links des Weges befinden sich einige Buesche und "
     "Straeucher, die Du allerdings noch nie zuvor an anderen Orten "
     "des Silberlandes entdecken konntest. Im Sueden kommst Du wieder auf "
     "einen der belebteren Wege zurueck, waehrend hingegen im Norden "
     "ein farbenfrohes Lichterspiel Deine ganze Neugierde erweckt. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "sueden", ROOM "room_f6" );
  AddExit( "norden", ROOM "room_d6" );

}

