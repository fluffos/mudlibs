
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG,
    "Der Weg endet hier scheinbar im Sueden vor einer Huette. Ueber ihrer "
    "Tuer haengt ein bunt bemaltes Schild, auf dem sich, abgesehen von "
    "Buchstaben, auch eine Zeichnung befindet. Im Osten ragt ein "
    "grosser Felsbrocken in die Hoehe, der ein Vorbeikommen schier unmoeglich "
    "macht. Wie ueberall in Polaris wird der lehmige Weg von kleinen "
    "Irrlichtern gesaeumt, die Dich leiten sollen.\n"
    "Die Tuer der Huette im Sueden steht sperrangelweit offen. "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "westen", ROOM "room_i3" );
  AddExit( "sueden", ROOM "room_j4" );

}

