
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
    "Fast lautlos wanderst Du auf dem Pfad dahin, immer begleitet von "
    "dem Schein der Lichter. Kalte schwarze Felsbloecke liegen noerdlich des "
    "Weges. Einige sonderbare Zeichen wurden in sie eingraviert. Im Sueden "
    "steht ein Haus aus Lehm, aus dem der Geruch von Raeucherwaren dringt, der "
    "Dir seltsam vertraut vorkommt. Anscheinend lebt hier die hiesige "
    "Heilerin. "); 
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "westen", ROOM "room_g3" );
  AddExit( "nordosten", ROOM "room_f5" );
  AddExit( "sueden", ROOM "room_h4" );

}

