//x
//****************************//
// Geheimraum unter room_g1.c //
//****************************//


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


void create()
{
 ::create();

  SetProp(P_INT_SHORT, "In einem super geheimen Geheimversteck");
  SetProp(P_INT_LONG, 
    "Der Raum hier ist wirklich winzig. Die Decke ist gerade so hoch, "
    "dass man noch aufrecht stehen kann. Ueberall tuermen sich Regale, "
    "in denen die verschiedensten Gegenstaende aufbewahrt werden. "
    "Der Boden besteht aus festgetrampelter Erde. Eine Treppe nach oben "
    "befindet sich genau in der Mitte des Raumes, doch das Loch, durch das "
    "Du hier hinuntergekommen bist, ist laengst wieder verschlossen. Du "
    "musst Dir also etwas anderes einfallen lassen. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_HOUSE]) );
  

  AddRoomMessage( ({
    "Von irgendwoher hoerst Du seltsame Stimmen.\n" }), 50  );


// DETAILBEGINN

  AddDetail( ({ "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "boden" }),
    "Der Boden (falls man das so nennen kann,) ist nichts anderes als "
    "festgetrampelte Erde.");

  AddDetail( ({ "erde" }),
    "Die Erde ist bereits ziemlich festgetrampelt, sodass es fasst wirkt als "
    "wuerdest Du auf festem Stein stehen. ");

  AddDetail( ({ "stein" }),
    "Es ist zwar Erde, aber fuehlt sich von der Festigkeit an wie Stein. ");

  AddDetail( ({ "festigkeit" }),
    "Boah ist das fest ey ;)");

  AddDetail( ({ "decke" }),
    "Die Decke ist hier ziemlich niedrig, gerade mal so hoch, dass man noch "
    "darunter aufrecht stehen kann. Das Loch ueber das Du hineingekommen bist "
    "ist irgendwie verschwunden. Seltsam. ");

  AddDetail( ({ "loch" }),
    "Es ist irgendwie nicht mehr zu sehen?! Wie gehts hier bloss raus?!");

  AddDetail( ({ "treppe" }),
    "Die Treppe befindet sich in der Mitte des Raumes. Nach fuenf Stufen "
    "endet sie bei der Decke. Aber dort ist irgendwie kein Ausgang zu sehen. ");
 
  AddDetail( ({ "ausgang" }),
    "Wo ist der bloss?!");

  AddDetail( ({ "stufen" }),
    "Die Treppe hat genau fuenf Stufen. ");

  AddDetail( ({ "stufe" }),
    "Davon siehst Du fuenf. ");

  AddDetail( ({ "stufe 1", "stufe eins" }),
    "Stufe 1 sieht aus wie Stufe 2.");

  AddDetail( ({ "stufe 2", "stufe zwei" }),
    "Stufe 2 sieht aus wie Stufe 3.");

  AddDetail( ({ "stufe 3", "stufe drei" }),
    "Stufe 3 sieht aus wie Stufe 4.");

  AddDetail( ({ "stufe 4", "stufe vier" }),
    "Stufe 4 sieht aus wie Stufe 5.");

  AddDetail( ({ "stufe 5", "stufe fuenf" }),
    "Stufe 5 sieht aus wie Stufe 6. ");

  AddDetail( ({ "stufe 6", "stufe sechs" }),
    "Hrhr, Du Depp :) Es gibt doch gar keine Stufe 6!");

  AddDetail( ({ "depp" }),
    "Eigentlich sollte man Dir wegen sowas Lebenspunkte abziehen. ");

  AddDetail( ({ "lebenspunkte", "punkte" }),
    "Oder noch besser: Attribute!");

  AddDetail( ({ "attribute" }),
    "Wenn Du jetzt das Wort 'Frosch' untersuchst, dann verwandel ich Dich "
    "in einen! Dann hast Du auch weniger Attribute (voruebergehend). ");

  AddDetail( ({ "wort" }),
    "Frosch!");

  AddSpecialDetail( ({ "frosch" }), "froschfkt");

  AddDetail( ({ "mitte" }),
    "Da ist eine Treppe!"); 

  AddDetail( ({ "regal", "regale" }),
    "Die Waende sind mit Regalen zugestellt, in denen sich alle moeglichen "
    "Gegenstaende und Dinge befinden. ");

  AddDetail( ({ "dinge" }),
    "Seltsame Dinge befinden sich in den Regalen!");

  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind genau wie der Boden aus Erde. Allerdings kannst Du sie "
    "vor lauter Regalen kaum erkenne. ");

  AddDetail( ({ "gegenstaende" }),
    "In den Regalen befinden sich alle moeglichen Gegenstaende. Du erkennst "
    "verschiedenste Dosen, Flaschen, Schachteln und sogar haufenweise "
    "Kleidung und Schuhe. ");

  AddDetail( ({ "kleidung" }),
    "Alles Moegliche sieht man hier: Hosen, Hemden, Schuerzen und sogar "
    "einen Hut!");

  AddDetail( ({ "moegliche", "verschiedenes" }),
    "Wirklich sehr viel Verschiedenes!"); 

  AddDetail( ({ "hut" }),
    "Ein wirklich huebscher schwarzer Hut. Wie Du wohl damit aussehen "
    "wuerdest?!"); 

  AddDetail( ({ "dosen" }),
    "Was der Besitzer darin wohl alles aufhebt?! Du willst es gar nicht so "
    "genau wissen. ");

  AddDetail( ({ "besitzer" }),
    "Hoffentlich erwischt er Dich nicht dabei, wie Du gerade in seinen "
    "Sachen schnueffelst. ");

  AddDetail( ({ "sachen" }),
    "Die gehoeren zwar nicht Dir, aber darin rumschnueffeln kannst Du wirklich "
    "gut. ");

  AddDetail( ({ "hosen" }),
    "Sind nicht unbedingt die neuesten, aber erfuellen wohl noch gute "
    "Dienste. ");

  AddDetail( ({ "dienste" }),
    "Sie haben weder Loecher noch Flecken, und das ist ja wohl das "
    "Wichtigste. ");

  AddDetail( ({ "wichtigstes", "wichtigste" }),
    "Das ist defintiv ziemlich wichtig. ");

  AddDetail( ({ "flecken", "loecher" }),
    "Keine zu sehen. ");

  AddDetail( ({ "hemden" }),
    "Die Hemden sind nich unbedingt ganz Dein Geschmack, aber auch nicht "
    "wirklich unertraeglich. ");

  AddDetail( ({ "geschmack" }),
    "Du wuerdest Dir solche Hemden nicht kaufen. ");

  AddDetail( ({ "schuerzen", "schuerze" }),
    "Die Schuerzen liegen schoen zusammengefaltet im Regal. Vielleicht "
    "arbeitet ja ihr Besitzer in einer Kneipe. ");

  AddDetail( ({ "kneipe" }),
    "Hier ist keine Kneipe. ");

  AddDetail( ({ "schachteln", "schachtel" }),
    "Sie sehen schon ziemlich alt aus, und sind auch schon leicht "
    "verstaubt. Was da wohl drinnen ist?!");  

  AddDetail( ({ "flaschen" }),
    "Die Flaschen stehen da einfach im Regal rum, und interessieren Dich "
    "jetzt auch nicht weiter. "); 

  AddDetail( ({ "schuhe" }),
    "Es sind jetzt nicht die Highheels von Lola, die Du heimlich privat ja "
    "so gerne traegst, aber es sind immerhin Schuhe. Schwarz, flach, gutes "
    "Profil. ");

  AddDetail( ({ "profil" }),
    "Vorhanden und gut. "); 

  AddDetail( ({ "lola" }),
    "Die ist irgendwo im Gebirge. ");

  AddDetail( ({ "gebirge" }),
    "Das Gebirge solltest Du woanders suchen. ");

  AddSpecialDetail( ({ "highheels", "heels" }), "heelsfkt");

  AddDetail( ({ "lauchcremesuppe", "suppe" }),
    "Ekelhafte grausame Suppe! In Ermangelung an Brot, Nudeln und Reis isst "
    "die arme Cleme das grad beim Proggen. ");

  AddDetail( ({ "cleme", "proggen", "clementine" }),
    "_Das_ arme Clementine isst beim Proggen gerade grausliche Suppe! Arm!!!");

  AddDetail( ({ "reis", "nudeln", "brot" }),
    "Ist leider alles aus :(");


// SMELLS

  AddSmell(DEFAULT_SMELL, "Es riecht hier lecker nach den verschiedensten "
    "Kraeutern und Dueften. ");

  AddSmell( ({ "kraeuter", "duefte" }),
    "Herrlich!");

    

// SOUNDS

  AddSound(DEFAULT_SOUND, "Momentan ist es ganz still hier!");

  AddSound( ({ "stille" }),
    "                            ");

  AddSound( ({ "stimmen", "stimme" }),
    "Du hoerst: Dieses Geheimwort, dass man murmeln muss, ist schon etwas "
    "seltsam. ");

  AddSound( ({ "geheimwort", "wort" }),
    "'dieschoenstenpausensindlila'");


  AddCmd( ({ "setz", "setze" }), "c_setzen");
  AddCmd( ({ "murmel", "murml" }), "c_murmeln");
  AddCmd( ({ "oeffne" }), "c_oeffnen");
 
}

heelsfkt(string str)
{
 string s;
 if(TP->QueryProp(P_GENDER) == FEMALE)
 {
  s = "Naja Dein Freund findet zwar, dass Du darin aussiehst wie eine "
           "aeh vom anderen Gewerbe, aber Dir gefallen sie. ";
 }
 if(TP->QueryProp(P_GENDER) == MALE) 
 { 
  TP->command_me("-a ich trag privat gerne highheels (am liebsten "
         "aus rotem lack) ... findet ihr das schlimm?");
  s = "";
 }
/* else
 {
  s = "Ist ja nichts Schlimmes, dass Du die privat gerne traegst...";
 }
*/ return BS(s);
}
 

froschfkt(string str)
{
 TP->SetProp(P_FROG, 1);
 return "";
}

int c_setzen(string str)
{
 if( str != "hut auf" )
 {
  notify_fail("Was moechtest Du aufsetzen?!\n");
  return 0;
 }
 else
 {
  write(BS("Als Du den Hut aufsetzt durchfaehrt Dich ein kalter Schauer. "
           "Schnell legst Du ihn wieder ins Regal. "));
  say(CTPN + " fummelt an einem Regal rum.\n");
  return 1;
 }
}


int c_murmeln(string str)
{
 if(str != "dieschoenstenpausensindlila")
 {
  notify_fail("Was moechtest Du murmeln?\n");
  return 0;
 }
 else
 {
  write(BS("Du murmelst die super super geheimen Zauberworte und findest "
           "Dich ploetzlich woanders wieder. "));
  TP->move(ROOM "room_g1", M_GO,
      "ploetzlich", "verschwindet", "erscheint");
  say(CTPN + " murmelt seltsame Sachen und verschwindet.\n");
  return 1;
 }
}


int c_oeffnen(string str)
{
 if( str != "schachteln"  &&
     str != "schachtel"   )
 {
  notify_fail("Was magstn oeffnen?! ;)\n");
  return 0;
 }
 else
 {
  write(BS("Du oeffnest eine der Schachteln und findest darinnen haufenweise "
           "kleine Paeckchen mit der Aufschrift 'Lauchcremesuppe'. Igitt! "
           "Schnell machst Du die Schachtel wieder zu. ")); 
  say(CTPN + " stammelt was von Lauchcremesuppe.\n");
  return 1;
 }
} 
