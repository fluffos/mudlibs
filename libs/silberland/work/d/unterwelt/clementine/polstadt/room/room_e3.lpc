//x


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"

object *spieler;

void create()
{

::create();
  
  spieler = ({ });
  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG,
    "Der Weg endet hier im Norden abrupt bei dunklem Felsgestein. "
    "Einige seltsame Flechten haben sich bereits auf dem fast schwarzen "
    "Fels angesiedelt, und erhellen Deinen Weg auf mystische Weise. "
    "Im Osten kannst Du eine gelbgestrichene Huette erkennen, "
    "ueber deren Eingang ein hoelzernes Schild baumelt. Nach Sueden scheint "
    "Dich der Weg tiefer in die Stadt zu fuehren. "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "sueden", ROOM "room_f3");
//([ EX_DEST: ROOM "room_f3",
//                        EX_TESTFUNC: "exit_test" ]) );
  AddExit( "osten", ROOM "room_e4"); 
//([ EX DEST: ROOM "room_e4",
//                       EX_TESTFUNC: "exit_test" ]) );

  NewDoor( "osten", ROOM "room_e4", ({ "tuer", "tuere", "birkentuer" }),
     ({ DOOR_CLOSED,
        DOOR_RESET_CL,
        D_NAME, "Birkentuer",
        D_GENDER, FEMALE,
        D_SHORT, "Im Osten befindet sich eine %se Birkentuer.",
        D_LONG, "Eine alte Birkentuer, die wenn der Wind geht "
                "leise knirscht. "
                "Man kann sie mit Hilfe eines "
                "Riegels oeffnen und wieder schliessen. ",
        D_MSGS, ({ "in die Post", "geht", "steht ploetzlich vor Dir" }),
        D_OPENMSG, ({ "Mit lautem Knarren schiebst Du den Riegel beiseite "
                      "und die Tuer oeffnet sich. ",
                      "Mit lautem Knaaren schiebt %s den Riegel beiseite.",
                      " wird mit lautem Knarren von aussen geoeffnet." }),
        D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du die Tuer.",
                       "Mit einem lauten Rumms schliesst %s die Tuer.",
                       " wird mit lautem Knarren von aussen geschlossen." }),
        D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen. " }) );


// DETAILBEGINN

  AddReadDetail( ({ "schild" }),
    "+----------------------------+\n"
    "|                            |\n"
    "|    POSTAMT VON POLARIS     |\n"
    "|                            |\n"
    "+----------------------------+\n");

  AddDetail( ({ "schild", "holzschild" }), 
    "Ein einfaches Holzschild - Du kannst es lesen!");

  AddDetail( ({ "weg" }),
    "Natuerlich befindest Du Dich auf einem Weg, oder dachtest Du, Du stehst "
    "in der Pampa?");

  AddDetail( ({ "pampa" }),
    "Eigentlich ein wunderschoenes Landstueck. ");

  AddDetail( ({ "stueck", "landstueck" }),
    "Wundervoll, einfach nur wundervoll. Eine Reise dorthin zahlt sich aus!");

  AddDetail( ({ "reise" }),
    "Zuerst solltest Du Dich mal hier umsehen, wenn Du schon einmal da bist. ");

  AddDetail( ({ "huette" }),
    "Im Osten befindet sich eine gelb gestrichene Huette. Anscheinend das "
    "hiesige Postamt. Vielleicht wirfst Du einmal einen Blick hinein?");

  AddDetail( ({ "waende" }),
    "Die Waende der Huette wurden gelb gestrichen. An einigen Stellen "
    "platterlt die Farbe schon etwas ab. ");

  AddDetail( ({ "farbe" }),
    "Gelb natuerlich!");

  AddDetail( ({ "gelb" }),
    "Huebsch, gell?!");

  AddDetail( ({ "stellen" }),
    "Man koennte hier ja durchaus einmal neu drueberstreichen. ");

  AddDetail( ({ "blick" }),
    "Trau Dich doch!");

// wirf blick in huette

  AddDetail( ({ "weise" }),
    "Sehr sehr seltsam. ");

  AddDetail( ({ "norden" }),
    "Da geht es definitiv nicht weiter. ");

  AddDetail( ({ "osten" }),
    "Im Osten steht eine Huette. ");

  AddDetail( ({ "sueden" }),
    "Folge dem Weg, und Du wirst sehen, was im Sueden auf Dich wartet. ");

  AddDetail( ({ "westen" }),
    "Im Westen befindet sich undurchdringliches Dickicht. ");

  AddDetail( ({ "dickicht" }),
    "Zwischen den dornigen Bueschen, und den Schlingpflanzen gibt es "
    "sicherlich kein Durchkommen. Man wuerdet sich hoechstens "
    "verletzen, oder sogar steckenbleiben. ");

  AddDetail( ({ "buesche" }),
    "Die Aeste der Buesche haben einige Dornen, deren Bekanntschaft Du "
    "lieber nicht machen moechtest. ");

  AddDetail( ({ "bekanntschaft" }),
    "Lieber nicht zu nahe kommen!");

  AddDetail( ({ "pflanzen", "schlingpflanzen" }),
    "Sie umschlingen wirklich alles was hier im Westen waechst. Komm ihnen "
    "lieber nicht zu nahe. ");

  // func durhczwaengen und co -> para steckengeblieben schlingplfnazen bzw von anbdrem befreien lassen muessen random ansonsten schgrammen...

  AddDetail( ({ "eingang" }),
    "Der befindet sich im Osten. ");

  AddDetail( ({ "stadt" }),
    "Dass Du Dich momentan in Polaris aufhaeltst, sollte mittlerweile klar "
    "sein. ");

  AddDetail( ({ "polaris" }),
    "Tja, jetzt stehst Du hier, in der Stadt Polaris - und nun?!");

  AddDetail( ({ "post", "postamt", "amt" }),
    "Ob die gelb angestrichene Huette ueberhaupt das Postamt ist?! Du "
    "erfaehrst es nur, wenn Du nach Osten gehst. ");

  AddDetail( ({ "himmel" }),
    "Alles ueber Dir ist schwarz. Man kann nicht wirklich genau sagen, ob es "
    "nun Himmel ist, oder irgendwo sogar eine Felsdecke...");

  AddDetail( ({ "felsdecke", "decke" }),
    "Alles verlaeuft sich im schwarzen Nichts. Du muesstest schon eine "
    "total hohe Leiter haben, um dort nach oben klettern zu koennen. ");

  AddDetail( ({ "leiter" }),
    "Eine sehr sehr hohe waere notwendig, um Naeheres ueber die "
    "Beschaffenheit des Etwas ueber Dir zu erfahren. ");

  AddDetail( ({ "naeheres" }),
    "So einfach ist es nicht!");

  AddDetail( ({ "beschaffenheit" }),
    "Du kannst es von hier aus nicht erkennen. "); //leiter troll? hoch? 

  AddDetail( ({ "nichts" }),
    "Bist Du neugierig? Dann find es heraus!");

  AddDetail( ({ "etwas" }),
    "Tja, was ist es denn?! ");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus normaler festgetrampelter Erde. ");

  AddDetail( ({ "erde" }),
    "Ganz normale Erde. Es ist wirklich nichts Aussergewoehnliches zu "
    "erkennen. ");

  AddDetail( ({ "aussergewoehnliches" }),
    "...");

  AddDetail( ({ "flechten", "flechte" }),
    "Der schwarze Fels scheint ihnen zu gefallen. Sie haben ihn schon fast "
    "gaenzlich ueberwuchert. Seltsamerweise leuchten sie auch...");

  AddDetail( ({ "leuchten" }),
    "Die Flechten auf den Felsen leuchten in der Dunkelheit. Ob das "
    "mit den Flechten oder eher dem Felsen zu tun hat, kann man nicht "
    "erkennen. Vielleicht macht auch genau diese Kombination die richtige "
    "Mischung. ");

  AddDetail( ({ "kombination", "mischung" }),
    "Es ist sehr fraglich, ob die Flechte auch ohne den Felsen so leuchten "
    "wuerde. Ausprobieren koennte man es natuerlich einmal. ");

  AddDetail( ({ "fels", "felsen" }),
    "Der Fels ist fast schwarz und von etlichen Flechten ueberwuchert, die "
    "Dir Licht spenden. ");

  AddDetail( ({ "licht" }),
    "Es kommt von den Flechten. ");

  AddDetail( ({ "gestein", "felsgestein" }),
    "Im Norden tuermt sich schwarzes Felsgestein, und schneidet Dir somit "
    "den Weg dorthin ab. Aber wahrscheinlich gibt es dort ohnehin nichts "
    "zu sehen...");

  AddDetail( ({ "riegel" }),
    "Damit kann man die Tuer aufmachen und sogar zumachen!");

  AddDetail( ({ "hilfe" }),
    "Mach die Tuer doch einfach mal auf!");

  AddDetail( ({ "dornen" }),
    "Aua....");

  AddDetail( ({ "aeste", "ast" }),
    "Alle haben sie Dornen!");

// SOUNDS

  AddSound(DEFAULT_SOUND, "Nur manchmal hoerst Du den Wind pfeifen. ");

  AddSound( ({ "wind" }),
    "Manchmal pfeift er leise. ");

// SMELLS 

  AddSmell(DEFAULT_SMELL, "Es riecht hier undefinierbar sonderbar :)");


// COMMANDS

  AddCmd( ({ "reiss", "reisse" }), "c_reissen");
  AddCmd( ({ "wirf", "werfe", "werf" }), "c_werfen");
  AddCmd( ({ "zwaeng", "zwaenge" }), "c_zwaengen");
//  AddCmd( ({ "kletter", "klettre", "klettere" }), "c_klettern");
 
}

int c_reissen(string str)
{
 if(str != "flechte von fels"  &&
    str != "flechte von felsen" )
 {
  notify_fail("Was moechtest Du wovon reissen?\n");
  return 0;
 }
 else
 {
  write(BS("Mit aller Kraft reisst Du an einer Flechte an, doch als Du "
           "sie endlich vom Felsen abbekommst, loest sie sich einfach auf! "
           "Frechheit!"));
  return 1;
 }
}

int c_werfen(string str)
{
 if(str != "blick in huette" )
 {
  notify_fail("Was moechtest Du wohin werfen?\n");
  return 0;
 }
 else
 {
  write(BS("Trau Dich doch einfach, und geh hinein!"));
  return 1;
 }
}

int c_zwaengen(string str)
{
 if( str != "durch dickicht" &&
     str != "durch buesche"   )
 {
  notify_fail("Wodurch moechtest Du Dich zwaengen?\n");
  return 0;
 }
 else
 {
  write(BS("Beim Versuch Dich durch das Dickicht zu zwaengen versagst Du "
    "elendig und bleibst mit Deinem Arm stecken! Man sollte halt nicht "
    "ueberall Dinge hineinstecken ;)"));
  TP->SetProp(P_PARALYZED,
      ([ PARALYZE_TIME: 100,
         PARALYZE_MSG: "Tja, Arm abhacken waere ne tolle Loesung! Ansonsten "
            "wuerd ich Dir raten, Dir schon mal genug Essen bringen zu lassen, "
            "denn hier steckst Du unter Garantie noch laenger...\n",
         PARALYZE_MSG_OTHER: "%s steckt im Dickicht fest! Muahaha!\n",
         PARALYZE_END: "Endlich schaffst Du es, Deinen Arm zu befreien, "
            "und reisst Dich vom Dickicht los!\n",
         PARALYZE_END_OTHER: "%s reisst sich vom Dickicht los.\n" ]));
  TP->do_damage(40+random(10), this_object());
  return 1;
 }
}
