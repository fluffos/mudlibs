
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, "Polaris Stadt");
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "westen", ROOM "room_i6" ); //versteckt
  AddExit( "norden", ROOM "room_h7" ); 
  AddExit( "sueden", ROOM "room_j7" ); 

  SetProp(P_HIDE_EXITS, ({ "westen" }) );

}

