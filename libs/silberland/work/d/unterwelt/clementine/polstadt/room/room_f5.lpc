
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"

// schatten

create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
     "Im Norden wird der Weg durch schwere Brocken aus Stein begrenzt. "
     "Auf der anderen Seite wachsen einige Baeume. Von einem der Aeste "
     "baumelt eine kleinere Laterne, die trotz ihrer Groesse genuegend "
     "Licht spendet, um Deine gesamte Umgebung zu erhellen. Aus "
	 "suedwestlicher Richtung dringt ein angenehmer Duft verschiedenster "
	 "Kraeuter in Deine Nase. Herrlich! ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "osten", ROOM "room_f6" );
  AddExit( "suedwesten", ROOM "room_g4" );

}

