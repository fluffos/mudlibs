
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG,
    "Begleitet von dem Schein der Lichtlein dringst Du immer tiefer in diese, "
    "Dir mystisch erscheinende Stadt ein. Weit und breit ist kein einziger "
    "Bewohner auszumachen, dennoch ueberkommt Dich immer wieder das Gefuehl, "
    "von Blicken verfolgt und beobachtet zu werden. Einige Steine liegen "
    "etwas unplatziert auf dem lehmigen Weg. Ob sie von irgendeiner "
    "Bedeutung fuer Dich sind? ");  
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "norden", ROOM "room_g2" );
  AddExit( "suedosten", ROOM "room_i3" );

}

