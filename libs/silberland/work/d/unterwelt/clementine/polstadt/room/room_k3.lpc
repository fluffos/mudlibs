
// VALKYRJA - KARTENLEGERIN


inherit "std/room";

#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
     "Gleich beim Hereinkommen ist Dir ein grosses Schild neben dem "
     "Eingang aufgefallen, auf das mit grossen Lettern der Name <<VALKYRJA>> "
     "gemalt wurde. Die Huette an sich ist ziemlich spaerlich eingerichtet - "
     "ein einfach gezimmertes Bett, ein schlichter Kasten, ein schmutziger "
     "Spiegel. Nur in der Mitte des Raumes thront ein aussergewoehnlich "
     "prunkvoll gestalteter Holztisch, auf dem sich viele verschiedene und "
     "buntbemalte Kartenstapel tuermen. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddExit( "osten", ROOM "room_k4" ); // versteckt (spiegel)
  AddExit( "nordosten", ROOM "room_j4" );

  SetProp(P_HIDE_EXITS, ({ "osten" }) );

// DETAILBEGINN

  AddDetail( ({ "raum", "huette" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "schild" }),
    "Ein grosses Schild haengt neben dem Eingang. Du kannst es lesen." );

  AddReadDetail( ({ "schild" }),
    "+-----------------------+\n"
    "| >> V A L K Y R J A << |\n"
    "+-----------------------+\n");

  AddDetail( ({ "letter" }),
    "Da! Auf dem Schild! Dicke fette Buchstaben! ");

  AddDetail( ({ "buchstaben" }),
    "Auf dem Schild sind 7 verschiedene Buchstaben aufgemalt. Ein Buchstabe "
    "ist doppelt. ");

  AddDetail( ({ "buchstabe" }),
    "Einer ist doppelt! Kuck doch hin!");

  AddDetail( ({ "a" }),
    "Hmm, warum hat der Name Valkyrja zwei A's ?!");

  AddDetail( ({ "name" }),
    "Valkyrja.");

  AddDetail( ({ "valkyrja" }),
    "Die ist gerade nicht da.");

  AddDetail( ({ "boden" }),
    "Der Boden wurde anscheinend erst vor kurzer Zeit geputzt, zumindest "
    "ist er sehr sauber. ");

  AddDetail( ({ "zeit" }),
    "Zeit ist etwas, was viele Leute auf der Welt sich selbst wegnehmen, damit "
    "sie dann rummotzen und jammern koennen, dass sie keine haben. ");

  AddDetail( ({ "leute", "welt" }),
    "Kannst ja auch mal rumjammern! Vielleicht spendiert Dir jemand eine "
    "Runde Mitleid. ");

  AddDetail( ({ "runde", "mitleid" }),
    "Vielleicht kommst Du eine Runde Mitleid, wenn Du rumjammerst. ");

  AddDetail( ({ "spiegel" }),
    "Wuah sieht der Spiegel dreckig aus! Er ist schon nur noch schwarz, "
    "sodass Du nicht mal Dich selbst erkennen kannst. Einige werden nun "
    "sagen, dass das vielleicht sogar besser so ist, aber er gehoert "
    "wirklich dringend mal geputzt. Der Rahmen des Spiegels hingegen wirkt "
    "mit seinen Verzierungen ziemlich edel und wertvoll. ");

  AddDetail( ({ "spiegelrahmen", "rahmen" }),
    "Er hat ziemlich schoene Verzierungen eingeschnitzt. Sicherlich ist er "
    "von grossem Wert. ");

  AddDetail( ({ "wert" }),
    "Wahrscheinlich ist er ziemlich viel wert. Aber mitnehmen wuerde ich ihn "
    "an Deiner Stelle nicht!");

  AddDetail( ({ "stelle" }),
    "Bin ich gluecklicherweise nicht...");
  
  AddDetail( ({ "verzierungen", "verzierung" }),
    "Die geschnitzten Verzierungen erinnern Dich irgendwie an Runen. ");

  AddDetail( ({ "runen" }),
    "Tatsaechlich! Das sind Runen. Ob man sie lesen kann?");

  AddReadDetail( ({ "runen" }),
    "Du liest: 'Mit den Augen sieht man nur das Offensichtliche. Fuer "
    "das Verborgene braucht man sein Herz.'");

  AddDetail( ({ "stoff" }),
    "Tatsaechlich. Schwarzer Stoff. Er wurde hinter den Spiegelrahmen "
    "gespannt und dient nun als Vorhang.");

  AddDetail( ({ "vorhang" }),
    "Was da wohl dahinter ist?");

  AddDetail( ({ "mitte" }),
    "Da steht ein Tisch.");

  AddDetail( ({ "hereinkommen", "kommen" }),
    "Dir ist natuerlich sofort dieses grosse Schild neben dem Eingang "
    "aufgefallen.");

  AddDetail( ({ "eingang", "ausgang" }),
    "Der Eingang ist natuerlich gleichzeitig auch ein Ausgang, wie Du "
    "natuerlich sofort erkannt hast!"); 
 
  AddDetail( ({ "bett" }),
    "Es dient sicherlich nur der Nachtruhe und nicht anderen Dingen ;) Sonst "
    "waere es wohl gemuetlicher...");

  AddDetail( ({ "nachtruhe" }),
    "Es dient dem Besitzer wohl ausschliesslich dafuer. ");

  AddDetail( ({ "besitzer" }),
    "Valkyrja!");

  AddDetail( ({ "dinge" }),
    "Tja, ich kenn Deine Phantasien nicht... ,)");

  AddDetail( ({ "phantasien", "phantasie" }),
    "Na auf jeden Fall ist das Bett nur fuers normale Schlafen gedacht...");

  AddDetail( ({ "fall", "kurzform" }),
    "Kurzform: Bett ist fuers Muetzen und .");

  AddDetail( ({ "muetzen" }),
    "Schlafen!");

  AddDetail( ({ "schlafen" }),
    "Bist Du muede? Dann leg Dich doch hin!"); 

  AddDetail( ({ "holztisch", "tisch" }),
    "Ein schoener Holztisch steht in der Mitte der Huette. Dich interessiert "
    "weniger sein Aussehen, als die vielen bunten Kartenstapeln auf seiner "
    "Tischplatte. ");

  AddDetail( ({ "kartenstapel", "stapel", "karten" }),
    "Viele bunte Kartenstapel liegen auf dem Tisch, und dienen Valkyrja als "
    "Instrument der Hellsicht. Ob sie Dir wohl auch einmal die Karten legen "
    "wuerde?");

  AddDetail( ({ "hellsicht" }),
    "Valkyrja benutzt die Karten um in die Zukunft zu sehen.");
  
  AddDetail( ({ "zukunft" }),
    "Lass Dich von der Zukunft ueberraschen, oder frag Valkyrja. "); //zukunft

  AddDetail( ({ "instrument" }),
    "Die Karten sind fuer die Hexe das Instrument der Hellsicht, das sie "
    "perfekt beherrscht.");

  AddDetail( ({ "tischplatte", "platte" }),
    "Da liegen viele bunte Stapel.");

  AddDetail( ({ "aussehen" }),
    "Das interessiert Dich nicht so sehr, wie die vielen Karten. ");

  AddDetail( ({ "waende", "wand" }),
    "Ja, Waende gibt es hier auch - ist in Huetten so ueblich!"); 
    
  AddDetail( ({ "hexe" }),
    "Ja wo ist sie denn?!");

  AddDetail( ({ "decke" }),
    "Eine sehr schlichte Decke, an der sich nichts Auffaelliges finden "
    "laesst. Und wenn Du jetzt das Wort Auffaelliges untersuchst, dann zieh "
    "ich Dir LPs ab!");

  AddDetail( ({ "wort" }),
    "Grr...");

  AddDetail( ({ "lps" }),
    "Hast eh zuviele!");

  AddDetail( ({ "holz" }),
    "Naja, aus welchem Holz wirds wohl sein?");

  AddDetail( ({ "birkenholz" }),
    "Wenn Du es ohnehin schon weisst, dann wuerd ich es nicht mehr untersuchen "
    "wenn ich Du waere.");

  AddDetail( ({ "kasten" }),
    "Der Kasten ist schlicht, seine Tueren zu, aber sie scheinen wohl "
    "nicht verschlossen zu sein. ");

  AddDetail( ({ "tueren" }),
    "Er hat zwei Tueren, die zu sind. Da sie aber kein Schloss haben, "
    "sind sie wohl nicht verschlossen. ");

  AddDetail( ({ "schloss" }),
    "Keines da."); 

  AddSpecialDetail( ({ "auffaelliges" }), "spielerwilllpsverlieren");

// valkyrja fragen nach karten und so heimlich auf ne liste deutend... 
// tageskarte ziehen.... 

// SMELLS

  AddSmell(DEFAULT_SMELL, "Es riecht hier sehr eigenartig, aber nicht "
    "schlecht. Irgendwie undefinierbar.");

// SOUNDS

  AddSound(DEFAULT_SOUND, "Hier ist es total still.");



// COMMANDS


  AddCmd( ({ "oeffne" }), "c_oeffnen");
  AddCmd( ({ "leg", "lege", "lieg", "liege" }), "c_liegen");
  AddCmd( ({ "nehm", "nimm", "nehme" }), "c_nehmen"); 
  AddCmd( ({ "putz", "putze" }), "c_putzen");
  AddCmd( ({ "jammer", "jammere", "jammre", "motz", "motze" }), "c_jammern");

}

int c_oeffnen(string str)
{
 if( str != "tueren" && 
     str != "kasten"  )
 {
  notify_fail("Was moechtest Du oeffnen?\n");
  return 0;
 }
 else
 {
  write(BS("Du oeffnest den Kasten, aber da er komplett leer ist, schliesst "
    "Du ihn einfach wieder."));
  return 1;
 }
}
 

spielerwilllpsverlieren(string str)
{
 write(BS("NICHTS VORHANDEN!!! *auszuck*"));
 TP->AddHp(-20);
 return"";
}


int c_liegen(string str)
{
 if( str != "in bett" )
 {
  notify_fail("Wo moechtest Du Dich reinlegen?\n");
  return 0;
 }
 else
 {
  write(BS("Alleine in das Bett legen?! DU?! Na, wirklich nicht! Ich kenn Dich "
    "doch! Du schlaefst nie allein! Ansonsten kannst das auch im Stehen "
    "machen! :)"));
  return 1;
 }
}


int c_nehmen(string str)
{
 if(str != "spiegel mit"        &&
    str != "spiegelrahmen mit"  &&
    str != "rahmen mit"         )
 {
  notify_fail("Was moechtest Du mitnehmen?\n");
  return 0;
 }
 else
 {
  write(BS("Na hallo! Du wirst doch nicht Valkyrjas Spiegel mitnehmen wollen?! "
           "Wenn Du Geld brauchst, dann raeum gefaelligst Seherhaeuser aus!"));
  say(CTPN + " will Valkyrja den Spiegel stehlen.\n");
  return 1;
 }
}

 


int c_putzen(string str)
{
 if(str != "spiegel" )
 {
  notify_fail("Was moechtest Du hier putzen?\n");
  return 0;
 }
 else
 {
  write(BS("Bei Deinem Versuch den Spiegel zu putzen, greift Deine Hand gegen "
           "schwarzen Stoff?! Vielleicht solltest Du Dir den doch noch mal "
           "genauer ansehen. "));
  say(CTPN + " schaut auf einmal verdutzt.\n");
  return 1;
 }
}
 



int c_jammern(string str)
{
 if( str != "rum" )
 {
  notify_fail("Moechtest Du rumjammern? Dann jammer doch rum?!");
  return 0;
 }
 else
 {
  write(BS("Du jammerst fuerchterlich rum, da Du Polaris noch nicht ganz "
           "durchgeforscht hast, und deswegen keine Zeit hast Dich mit Deinem "
           "RL zu befassen!"));
  TP->command_me("-a:winselt um Mitleid." );
  say(CTPN + " jammert rum.\n");
  return 1;
 }
}


  
   


 

