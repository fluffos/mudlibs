
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
	  "Du stehst mitten auf einer Kreuzung, und musst Dich jetzt wohl oder "
	  "uebel fuer einen der Wege entscheiden. Auf dem Boden siehst Du "
	  "unzaehlige Fusspuren, die in jede erdenkliche Richtung zeigen. "
	  "Eine kleine steinerne Statue "
	  "wurde hier errichtet. Sie zeigt das Abbild einer jungen huebschen "
	  "Frau, die wohl so eine Art Schutzpatronin der Hexen ist. "
	  "In den Sockel wurden seltsame Zeichen eingraviert. Scheint soetwas "
	  "wie ein Wegweiser zu sein. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "norden", ROOM "room_e6" );
  AddExit( "osten", ROOM "room_f7" );
  AddExit( "westen", ROOM "room_f5" );
  AddExit( "sueden", ROOM "room_g6" );  

}

