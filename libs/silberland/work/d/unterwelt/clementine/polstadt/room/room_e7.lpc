inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"

#define MAX_PERSONEN 1

string *spieler_penta;

void create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
    "Du stehst in einer alten, ziemlich verkommenen Huette. Ein ekelhafter "
    "Geruch von Moder macht sich ueberall breit. "
    "Bis auf einen Tisch ist hier alles vollkommen leer. Sogar "
    "die Fenster wurden mit Brettern zugenagelt. Nur auf dem "
    "schon alten morschen Holzboden siehst Du eine seltsame "
    "Zeichnung. Unzaehlige Fusspuren fuehren zu ihr hin. Was das wohl zu "
    "bedeuten hat? Ist die Huette vielleicht doch nicht so verlassen, "
    "wie es auf den ersten Blick scheint?");
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "sueden", ROOM "room_f7" );


// DETAILBEGINN

  AddDetail( ({ "huette", "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "geruch", "moder" }),
    "Probiers mal mit riechen!");  //riechen

  AddDetail( ({ "fenster" }),
    "Die Fenster wurden mit festen Brettern zugenagelt. ");

  AddDetail( ({ "bretter", "holzbretter" }),
    "Die Bretter mit denen die Fenster zugenagelt wurden, bestehen aus "
    "festen dicken Holz. ");

  AddDetail( ({ "holz" }),
    "Es ist schon ziemlich alt, aber erfuellt noch seinen Zweck. ");
  
  AddDetail( ({ "zweck" }),
    "Der wird noch gewaehrleistet. ");

  AddDetail( ({ "blick" }),
    "Auf den ersten Blick scheint hier alles alt, unbewohnt und verstaubt "
    "zu sein. ");

  AddDetail( ({ "staub" }),
    "Davon findest Du hier genug. ");

  AddDetail( ({ "holzboden", "boden" }),
    "Der Boden unter Deinen Fuessen ist im Laufe der Jahre schon morsch "
    "geworden, aber man trotzdem noch wunderbar ueber ihn marschieren. "
    "In der Mitte siehst Du eine seltsame Zeichnung. ");

  AddDetail( ({ "fuesse" }),
    "Mit denen stehst Du gerade auf dem Holzboden. ");

  AddDetail( ({ "mitte" }),
    "In der Mitte des Raumes siehst Du eine Zeichnung auf dem Boden. ");

  AddDetail( ({ "tisch", "holztisch" }),
    "Ein einfacher Holztisch steht hier herum. Die Tischplatte kommt Dir "
    "irgendwie seltsam vor. ");

  AddDetail( ({ "tischplatte", "platte" }),
    "Die Platte des Tisches weist eine ziemlich lustige Maserung auf. ");

  AddDetail( ({ "maserung" }),
    "Die Maserung sieht ziemlich lustig aus. Eine Stelle sieht sogar "
    "aus wie ein Kreis. ");

  AddDetail( ({ "kreis" }),
    "Was man alles mit so einem Kreis wohl machen kann?");

  AddDetail( ({ "stelle" }),
    "Sieht aus wie ein Kreis!");

  AddDetail( ({ "laufe", "jahre" }),
    "Im Laufe der Jahre scheinen wohl schon viele Fuesse ueber diesen "
    "Boden gewandert zu sein. ");
 
  AddDetail( ({ "decke" }),
    "Die Decke der Huette ist ziemlich niedrig, sodass man sie fast mit der "
    "Hand erreichen kann. "); 

  AddDetail( ({ "hand" }),
    "Vielleicht schaffst Du es ja mit Deiner Hand die Decke zu erreichen. ");

  AddDetail( ({ "wand", "waende" }),
    "An den Waenden kann man eigentlich nichts Aussergewoehnliches erkennen. "
    "An der Suedwand befand sich sicherlich mal eine Tuer, allerdings sieht "
    "man mittlerweile nur mehr die verrosteten Scharniere. Rechts und links "
    "von ihr waren einstmals auch zwei Fenster. ");

  AddDetail( ({ "suedwand" }),
    "Die Fenster der Suedwand wurden schon laengst mal mit Brettern "
    "zugenagelt, eine Tuer gibt es mittlerweile auch nicht mehr. ");

  AddDetail( ({ "tuer" }),
    "Es ist keine mehr zu sehen. Allerdings erkennst Du noch alte "
    "Scharniere, in denen frueher sicherlich mal eine eingehangen war. ");

  AddDetail( ({ "scharnier", "scharniere" }),
    "Die Scharniere sind schon alt und verrostet. Man muesste sie komplett "
    "auswechseln, wenn man eine neue Tuer anbringen wollen wuerde. ");

  AddDetail( ({ "aussergewoehnliches" }),
    "Nichts zu sehen. Die Waende bestehen alle aus Holz, Bilder kann man "
    "keine erkennen, was nicht heissen soll, dass nie welche aufgehangen "
    "waren. ");

  AddDetail( ({ "bilder", "bild" }),
    "Du kannst keine Bilder sehen. Aber vielleicht laesst sich irgendwie "
    "feststellen, ob hier mal welche gehangen sind?! Was koennte man da "
    "bloss mit der Wand machen, um zu schauen, ob irgendwo Naegel "
    "eingeschlagen sind?!");

  AddDetail( ({ "naegel" }),
    "Man kann keine Naegel sehen?! ");
  
  AddDetail( ({ "zeichnung" }),
    "Die Zeichnung am Boden sieht irgendwie aus wie ein Stern. Unzaehlige "
    "Spuren fuehren in sein Zentrum, kehren aber nicht mehr zurueck?!");

  AddDetail( ({ "zentrum" }),
    "Viele Spuren fuehren in den 'Stern', aber nicht mehr hinaus. ");

  AddDetail( ({ "stern" }),
    "Die Zeichnung sieht aus wie ein Stern mit vielen Linien, die kreuz "
    "und quer gehen. ");

  AddDetail( ({ "linien", "linie" }),
    "Die Zeichnung hat mehrere!");

  AddDetail( ({ "pentagramm" }),
    "Die Zeichnung in der Mitte des Raumes stellt natuerlich ein Pentagramm "
    "dar. Was anderes haettest Du bei den Hexen hier auch nicht erwartet. ");

  AddDetail( ({ "hexen", "hexe" }),
    "In Polaris leben die Hexen. Sowohl an der Oberflaeche, als auch hier im "
    "Verborgenen. ");

  AddDetail( ({ "verborgenes", "verborgenen", "verborgen" }),
    "Die unterirdische Stadt Polaris ist nicht so leicht zu finden. ");

  AddDetail( ({ "stadt" }),
    "Polaris ist eigentlich eine ziemlich grosse Stadt, in der man vieles "
    "nur finden kann, wenn man weise genug ist. "); 
   
  AddDetail( ({ "polaris" }),
    "Polaris ist hier ueberall. ");
  
  AddDetail( ({ "oberflaeche" }),
    "Auch an der Oberflaeche leben Hexen. ");

  AddDetail( ({ "spuren", "fusspuren", "fussspuren" }),
    "Die Spuren fuehren alle zu einer Zeichnung am Boden, kehren aber von "
    "dieser nicht mehr zurueck?!");

// SMELLS

  AddSmell(DEFAULT_SMELL, "Es riecht hier fuerchterlich modrig.");

  AddSmell( ({ "moder", "geruch" }),
    "Igitt das stinkt. Doch zwischen dem modrigen Geruch erschnueffelst Du "
    "noch etwas anderes.");

  AddSmell( ({ "anderes" }),
    "Riecht nach billigem Aftershave. ");

  AddSmell( ({ "aftershave" }),
    "Ob das von Andronicus ist?!");

  AddSmell( ({ "andro", "andronicus" }),
    "Kannst ihn ja mal fragen, oder noch besser: mail andronicus");


// SOUNDS
 
  AddSound(DEFAULT_SOUND, "Das Holz knackst manchmal. ");

  AddSound( ({ "holz" }), 
    "*knacks*");



  AddCmd( ({ "tast", "taste" }), "c_tasten");
  AddCmd( ({ "erreich", "erreiche" }), "c_erreichen");
  AddCmd( ({ "stell", "stelle", "betret", "betrete" }), "c_stellen");
  AddCmd( ({ "verlass", "verlasse" }), "c_verlassen");
  AddCmd( ({ "drueck", "druecke" }), "c_druecken");
  


  spieler_penta = ({ }); 

  

}


int c_tasten(string str)
{
 if( str != "wand ab")
 {
  notify_fail("Was moechtest Du abtasten?\n");
  return 0;
 }
 else
 {
  write(BS("Du tastest die Waende gruendlichst ab, kannst aber keine "
           "Naegel finden. "));
  say(CTPN + " tastet die Wand ab.\n");
  return 1;
 }
}
 



int c_erreichen(string str)
{
 if( str != "decke mit hand" )
 {
  notify_fail("Was moechtest Du womit erreichen?\n");
  return 0;
 }
 else
 {
  if(TP->QueryProp(P_RACE) != "Zwerg" &&
     TP->QueryProp(P_RACE) != "Fee"   )
  {
   write(BS("Wow! Du erreichst mit Deiner Hand tatsaechlich die Decke."));
   say(CTPN + " fuchtelt bloed rum.\n");
   return 1;
  }
  else
  {
   write(BS("Leider erreichst Du die Decke nicht :("));
   say(CTPN + " fuchtelt bloed rum.\n");
   return 1;
  }
 }
}



int c_druecken(string str)
{
 if( str != "kreis")
 {
  notify_fail("Was moechtest Du druecken?\n");
  return 0;
 }
 else
 {
  if(member(spieler_penta, getuuid(TP)) != -1)
  {
   write(BS("Du drueckst auf den Kreis, der daraufhin irgendeinen "
            "geheimen Mechanismus ausloest. "));
   this_player()->move(ROOM "zugang", M_GO, 
                  "irgendwohin", "verschwindet", "erscheint");
   spieler_penta = ({ });
   return 1;
  }
  else
  {
   write(BS("Du drueckst den Kreis, doch nichts passiert."));
   return 1;
  }
 }
}
 
 

int exit_test(string dir)
{
 if(!TP)               return 1;
 if(!interactive(TP))  return 1;

 if(member(spieler_penta, getuid(TP)) == -1) return 1;
 write(BS("Du stehst doch noch in dem Pentagramm!"));
 return 0;
}

int c_stellen(string str)
{
 notify_fail("Wohin moechtest Du Dich stellen?\n");
 
 if(!str || str == "") return 0;
 if(!(str == "in pentagramm" )) return 0;
 
 if(member(spieler_penta, getuuid(TP)) != -1)
 {
  tell_object(TP, BS("Aber Du stehst doch bereits im Pentagramm!"));
  return -1;
 }
 
// verlasse penta is gegenteil!
 if(sizeof(spieler_penta) >= MAX_PERSONEN)
 {
  write(BS("Leider ist im Pentagramm gerade kein Platz mehr frei."));
  return -1;
 }

 spieler_penta += ({ getuuid(TP) });
 write(BS("Du stellst Dich in das Pentagramm."));
 say(CTPN+ " stellt sich in ein Pentagramm.\n");
 return 1;

}

int c_verlassen(string str)
{
 notify_fail("Was moechtest Du verlassen?\n");

 if(!str || str == "") return 0;
 if(!(str == "pentagramm" )) return 0;

 if(member(spieler_penta, getuuid(TP)) == -1)
 {
  write(BS("Aber Du stehst doch gar nicht im Pentagramm!"));
  return -1;
 }

 spieler_penta -= ({ getuuid(TP) });
 write(BS("Du verlaesst das Pentagramm."));
 say(CTPN+ " verlaesst ein Pentagramm.\n");
 return 1;

}

void BecomesNetDead(object player)
{
 if(member(spieler_penta, getuuid(player)) != -1)
 {
  spieler_penta -= ({ getuuid(player) });
  tell_room(TO, player->Name()+" nickt ein und schlafwandelt aus dem "
                               "Pentagramm.\n");
 }
}

void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
 spieler_penta -= ({ getuuid(player) });
}


