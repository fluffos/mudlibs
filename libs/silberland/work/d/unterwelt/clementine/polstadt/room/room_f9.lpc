
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
	  "Du stehst auf einem kleinen Platz im Osten von Polaris. "
	  "Im Nordosten siehst Du eine Huette, vor der einige Blumen wachsen. "
	  "Direkt an der Hauswand befindet sich ein kleines Holzbaenkchen, das zum "
	  "Ausruhen wie geschaffen ist. Ueber dem Eingang baumelt ein bunt "
	  "bemaltes Schild mit lustigen Symbolen. Genau in der Mitte des Platzes "
	  "waechst ein grosser Baum. Er scheint schon ziemlich alt zu sein, "
	  "zumindest hat er einen dicken Stamm und unzaehlige verzweigte Aeste. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "nordosten", ROOM "room_e10" );
  AddExit( "westen", ROOM "room_f8" );
  AddExit( "suedosten", ROOM "room_g10" );

}

