inherit "std/post";

#include "../polstadt.h"


void create()
{

::create();

  SetProp(P_INT_SHORT, "In einer Postzentrale");
  SetProp(P_INT_LONG, 
    "Du befindest Dich in der Postzentrale von Polaris. Die Waende, und selbst "
    "der Boden wurden mit gelber Farbe ausgestrichen, wie es fuer Postaemter "
    "ueblich ist. Zwei kleine Schreibkabinen stehen an der Wand, um Dir "
    "beim Lesen bzw. Schreiben Deiner Post die noetige Ruhe gewaehrleisten zu "
    "koennen. Betritt die Kabine, oder tipp einfach: <post>/<mail>, bzw. "
    "<mail spielername>, um Deinen Papierkram erledigen zu koennen. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

  AddExit( "westen", ROOM "room_e3" );

  NewDoor( "westen", ROOM "room_e3", ({ "tuer", "tuere", "birkentuer" }),
     ({ DOOR_CLOSED,
        DOOR_RESET_CL,
        D_NAME, "Birkentuer",
        D_GENDER, FEMALE,
        D_SHORT, "Im Westen befindet sich eine %se Birkentuer.",
        D_LONG, "Eine alte Birkentuer, die wenn der Wind geht "
                "leise knirscht. "
                "Man kann sie mit Hilfe eines "
                "Riegels oeffnen und wieder schliessen. ",
        D_MSGS, ({ "hinaus", "geht wieder", "steht ploetzlich vor Dir" }),
        D_OPENMSG, ({ "Mit lautem Knarren schiebst Du den Riegel beiseite "
                      "und die Tuer oeffnet sich. ",
                      "Mit lautem Knaaren schiebt %s den Riegel beiseite.",
                      " wird mit lautem Knarren geoeffnet." }),
        D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du die Tuer.",
                       "Mit einem lauten Rumms schliesst %s die Tuer.",
                       " wird mit lautem Knarren geschlossen." }),
        D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen. " }) );



// DETAILBEGINN

  AddDetail( ({ "boden" }),
    "Der, aus Brettern bestehende Boden, wurde mit einer auffaellig grellen, "
    "gelben Farbe angestrichen. ");

  AddDetail( ({ "decke" }),
    "Die gelb bestrichene Decke befindet sich hoch ueber Deinem Kopf, sodass "
    "Du ihre Umrisse wirklich nur schwer erkennen kannst. ");

  AddDetail( ({ "waende", "wand" }),
    "Selbst die Waende wurden mit gelber Farbe ausgestrichen. Zwei kleine "
    "Schreibkabinen stehen direkt an ihnen, in denen Du wohl ungestoert "
    "Deine Post lesen koenntest. Ein Kerzenhalter direkt neben dem Eingang "
    "laesst den Raum in gedaempften Licht erstrahlen. ");

  AddDetail( ({ "postzentrale", "zentrale", "post" }),
    "Du befindest Dich der Postzentrale von Polaris, wo Du ungestoert "
    "Deine Mails lesen und schreiben kannst. ");

  AddDetail( ({ "polaris" }),
    "Polaris? Noch nie gehoert diesen Namen. ");

  AddSpecialDetail( ({ "name", "namen" }), "namefunc" );
 
  AddDetail( ({ "lesen" }),
    "Wenn Du Mails lesen moechtest, so tippe einfach: 'mail'");
  
  AddDetail( ({ "schreiben" }),
    "Wenn Du Mails schreiben moechtest, so tippe einfach: 'mail "
    "<spielername>' ");

  AddDetail( ({ "papierkram" }),
    "Um Deinen Papierkram endlich zu beseitigen, solltest Du dringendst "
    "Deinen Mailkram ordnen. ");

  AddDetail( ({ "mailkram" }),
    "In Deinem Fall waere es sinnvoll, mal einige Mails zu loeschen, bevor "
    "Dein Postfach gaenzlich ueberquillt. ");

  AddDetail( ({ "postfach" }),
    "Das quillt bestimmt schon voellig ueber. Du solltest es dringendst mal "
    "aufraeumen. ");

  AddDetail( ({ "fall" }),
    "Der freie Fall hat so manch einen schon das Leben gekostet...");

  AddDetail( ({ "hilfe" }),
    "Mit Hilfe des Riegels laesst sich die Tuere ganz leicht oeffnen, und "
    "natuerlich auch wieder schliessen. ");

  AddDetail( ({ "riegel" }),
    "Ein Riegel an der Tuer dient dazu, sie zu schliessen, bzw. sie oeffnen "
    "zu koennen. ");

  AddDetail( ({ "wind" }),
    "Nur manchmal weht ein sanftes Lueftchen, und bringt die alte morsche "
    "Birkentuere zum Knirschen. ");

  AddDetail( ({ "knirschen" }),
    "Das Wort kannst Du nicht untersuchen, aber vielleicht koenntest "
    "Du es ja 'erlauschen'. "); //erlausche...

  AddDetail( ({ "wort" }),
    "Ein kleines Vampirbambi beisst Dich in den Arm. ");

  AddDetail( ({ "vampirbambi", "bambi" }),
    "Angeblich gibt es hier mehrere. ");

  AddDetail( ({ "arm" }),
    "Dein Arm weist eine tiefe Bisswunde auf. Vielleicht solltest Du Dich "
    "verarzten lassen. ");

  AddDetail( ({ "bisswunde", "wunde" }),
    "Sieht schlimm aus! ");

  AddDetail( ({ "lueftchen" }),
    "Momentan kannst Du keines spueren. ");

  AddDetail( ({ "farbe" }),
    "Das typische grelle Postgelb, wie es ueberall verwendet wird. ");

  AddDetail( ({ "postgelb" }),
    "Jede Post sollte aus logischen Gruenden, in dieser gelben Farbe "
    "angestrichen sein. ");

  AddDetail( ({ "gruende" }),
    "Ein Gefuehl sagt Dir, dass Du Dir das ueberirdischen Polaris mal "
    "genauer anschauen solltest. ");

  AddDetail( ({ "gefuehl" }),
    "Du spuerst, dass Du unbedingt einmal dorthin musst. ");

  AddDetail( ({ "mails" }),
    "Du wirst doch wissen was Mails sind?! Wenn nicht, so untersuche: "
    "'ichbindoofundjedersolleswissen' ");

  AddDetail( ({ "bretter" }),
    "Die hoelzernen Bretter des Bodens wurden gelb angestrichen. "
    "Einige weisen schon tiefe Furchen auf. ");

  AddDetail( ({ "furchen", "risse" }),
    "Die Bretter weisen bereits tiefe Furchen und Risse auf, was wohl "
    "auf ein reges Treiben hier zurueckschliessen laesst. ");

  AddDetail( ({ "treiben" }),
    "Viele Abenteurer scheinen diesen Ort schon betreten zu haben. ");

  AddDetail( ({ "ort"}),
    "Das Postamt von Polaris. ");

  AddDetail( ({ "abenteurer" }),
    "Gehoerst Du auch zu ihnen? ");

  AddDetail( ({ "leben" }),
    "Das Leben ist kostbar, gib acht darauf! ");

  AddDetail( ({ "kopf" }),
    "Alles noch da.\n"
    "Du atmest erleichert auf.\n");

  AddDetail( ({ "umrisse" }),
    "Die Umrisse der Decke kannst Du nur sehr schwer erkennen, da sie sich "
    "hoch ueber Dir befindet. ");
 
  AddDetail( ({ "gelb" }),
    "Fast alles hier ist gelb. ");

  AddDetail( ({ "eingang" }),
    "Neben dem Eingang im Westen wurde ein Kerzenhalter befestigt, der "
    "den Raum in gedaempften Licht erstrahlen laesst. ");

  AddDetail( ({ "kerzenhalter", "halter" }),
    "Eine etwas abgebrannte Kerze befindet sich in ihm. ");

  AddDetail( ({ "westen" }),
    "Westen ist dort, wo Dein linker kleiner Finger links ist. :) ");
 
  AddDetail( ({ "finger" }),
    "Er zeigt nach Westen. ");

  AddDetail( ({ "raum" }),
    "Du befindest Dich in Polaris' Postamt. Blick Dich doch genauer hier "
    "um, wenn Du moechtest. ");

  AddDetail( ({ "kerze" }),
    "Die Kerze ist schon etwas abgebrannt. ");

  AddDetail( ({ "ruhe" }),
    "Die zwei Schreibkabinen dienen dazu, dass Du auch genuegend "
    "Ruhe und Konzentration zum Bearbeiten Deiner Mails hast. ");

  AddDetail( ({ "bearbeiten" }),
    "Oder was Du hier auch immer machen moechtest. ");

  AddDetail( ({ "konzentration" }),
    "Die muss gewaehrleistet sein! ");

  AddDetail( ({ "postamt", "postaemter" }),
    "Du befindest Dich doch gerade in einem. "); 


// SOUNDS

  AddSound(DEFAULT_SOUND,
	  "Hier ist es absolut still. ");

  AddSound( ({ "stille" }),
	  "Waere schoen, wenn es manchmal ueberall so ruhig ist...");


// SMELLS

  
  AddSmell(DEFAULT_SMELL,
	  "Es riecht hier einfach nach Post. ");

  AddSmell( ({ "post" }),
	  "Igitt, der Geruch von Papier und Pappe verbinden sich zu einer "
	  "ekelhaften Wolke, die direkt in Deine Nase fliegt. ");

  AddSmell( ({ "pappe", "papier", "wolke", "geruch" }),
	  "Ekelhaft!!!");
  

  
// CMDS

  
  AddSpecialDetail( ({ "ichbindoofundjedersolleswissen" }), "dooffunc");
  AddSpecialDetail( ({ "licht" }), "lichtfunc");
  
  AddCmd( ({ "erlausche", "erlausch" }), "c_erlauschen");
  AddCmd( ({ "zuend", "zuende" }), "c_zuenden");
  AddCmd( ({ "loesche", "loesch" }), "c_loeschen");
  
}

lichtfunc(string str)
{
  if(QueryProp(P_LIGHT) <= 0)
  {
    write(BS("Die Kerze ist aus.\n"));
	return "";
  }
  if(QueryProp(P_LIGHT) > 0)
  {
	write(BS("Die Kerze spendet gedaempftes Licht.\n"));
	return "";
  }
}


int c_zuenden(string str)
{
  if (str != "kerze an")
  {
	notify_fail("Was moechtest Du hier anzuenden?\n");
	return 0;
  }
  if (QueryProp(P_LIGHT) > 0)
  {
	write("Aber die Kerze brennt doch schon laengst!\n");
	return 1;
  }
    write( "Du zuendest die Kerze im Halter an.\nEs wird etwas heller.\n" );
	say(CTPN+ " zuendet eine Kerze an.\n" );
    SetProp(P_LIGHT, 1);
	return 1;
}

int c_loeschen( string str )
{
  if (str != "kerze" )
  {
    notify_fail( "Was moechtest Du hier denn loeschen?\n" );
	return 0;
  }
  if (QueryProp(P_LIGHT) <= 0)
  {
	write("Aber die Kerze brennt doch gar nicht!\n" );
	return 1;
  }
	write("Du fuehrst einige seltsame Bewegungen aus, die dazu fuehren, "
	      "dass die Kerze in der Halterung ausgeht.\n" );
	SetProp(P_LIGHT, 0);
	return 1;
}

void reset()
{
    ::reset();
	if (QueryProp(P_LIGHT) <= 0)
    {
	  tell_room( this_object(),
	      "Wie von Geisterhand entzuendet sich die Kerze auf einmal "
		  "von selbst.\n" );
	  SetProp(P_LIGHT, 1);
	 }

}





int c_erlauschen(string str)
{
  if( str != "knirschen" )
  {
	notify_fail("Was moechtest Du hier erlauschen?\n");
	return 0;
  }
  else
  {
	write(BS("Wuah so ein ekeliges Geraeusch, "
		  "sofort haeltst Du Dir die Ohren zu!"));
	say(CTPN + " haelt sich die Ohren zu.\n");
	return 1;
  }
}


string namefunc( string str )
{
 this_player()->command_me("-allgemein Ich heisse "+CTPN +" und untersuche "
                           "total sinnlose Details!!!!!!");
 return "";
}

string dooffunc( string str )
{
 this_player()->command_me("-allgemein Ich habe soeben das Wort: "
      "'ichbindoofundjedersolleswissen' untersucht, weil ich wirklich "
      "so ein fuerchterlich doofes Nockerl bin, und nicht einmal weiss, "
      "was das Wort Mails bedeutet!!!");
 return "";
}

