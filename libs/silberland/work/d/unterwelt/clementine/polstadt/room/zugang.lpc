inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


int anz_zettel;

reset()
{
 ::reset();
 anz_zettel = 1;
}


create()
{

  ::create();

  anz_zettel = 1;
  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG,
    "Das Chaos beherrscht den ganzen Raum und hinterlaesst den Eindruck, "
    "als waere die Huette ueberstuerzt verlassen worden. In ihrer Mitte "
    "steht ein Tisch, daneben ein umgefallener Sessel. Kreuz und "
    "quer verstreut liegen die unterschiedlichsten Werkzeuge, "
    "zerbrochene Gefaesse, und verblichenen Fetzen eines Buches. "
    "An der Westwand befindet sich noch ein alter Kamin, neben ihm eine "
    "Kiste mit Torfstuecken. Dunkler Staub hat hier schon alles "
    "fuer sich vereinamt, und unter einer dicken Schicht begraben. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddExit( "osten", "d/unterwelt/clementine/polaris/room/room11" );

  AddRoomMessage( ({
    "Hatschiii!!! Aufgrund des vielen Staubs musst Du niesen.\n",
    "Hust! Hust! Hier liegt wirklich sehr viel Staub!\n",
    "*krrkkk* *raschel*\n" }), 30  );

  AddCmd( ({ "kletter", "klettre", "klettere" }), "c_klettern");

// DETAILBEGINN

  AddDetail( ({ "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "huette" }),
    "Die Huette scheint ziemlich abrupt verlassen worden zu sein. Anders "
    "kannst Du Dir das hier herrschende Chaos nicht erklaeren. ");

  AddDetail( ({ "chaos" }),
    "Ueberall hier herrscht Chaos. Umgefallene Moebel, zerbrochene Gefaesse, "
    "Papierfetzen und andere Dinge liegen zerstreut am Boden. ");

  AddDetail( ({ "boden" }),
    "Ueber dem ganzen Chaos was am Boden liegt, den Moebeln, den Gefaessen, "
    "... hat sich bereits eine dicke Staubschicht gebildet. ");

  AddDetail( ({ "staubschicht", "schicht", "staub" }),
    "Fast alles hier wurde unter einer dunklen dicken Staubschicht begraben. "
    "Igitt! Ekelig! ");

  AddDetail( ({ "kamin" }),
    "An der Westwand steht noch der alte Kamin, mit dem frueher hier "
    "geheizt wurde. Er besteht aus Backsteinen. Dort wo man einst "
    "das Brennmaterial hingelegt hatte um Feuer zu machen siehst Du nur ein "
    "Haeufchen Asche. ");

  AddDetail( ({ "haeufchen", "asche" }),
    "Im Kamin ist nur mehr ein Haeufchen Asche zu sehen. Doch halt! Was ist "
    "das fuer ein seltsames Muster in der Asche?!");

  AddDetail( ({ "muster" }),
    "Das solltest Du mal naeher betrachten. ");

  AddDetail( ({ "spuren" }),
    "Es scheint als wuerden sie in den Kamin fuehren...");

  AddDetail( ({ "westwand" }),
    "An der Westwand befindet sich ein Kamin. Daneben steht eine "
    "Kiste. ");

  AddDetail( ({ "ostwand" }),
    "Dort kommst Du wieder hinaus. ");

  AddDetail( ({ "suedwand", "nordwand" }),
    "Du erkennst nichts besonderes.");

  AddDetail( ({ "besonderes" }),
    "Nichts zu sehen. ");

  AddDetail( ({ "wand", "waende" }),
    "Welche Wand meinst Du?!");

  AddDetail( ({ "moebel" }),
    "Du erkennst unter anderem einen Tisch und einen Sessel. Alles sieht "
    "schon etwas morsch und ziemlich alt aus. ");

  AddDetail( ({ "dinge", "ding", "gegenstaende" }),
    "Hier liegen wirklich die verschiedensten Gegenstaende quer verstreut "
    "auf dem Boden. ");

  AddDetail( ({ "kiste" }),
    "Die Kiste steht direkt neben dem Kamin. Ein paar Stuecke Torf liegen "
    "noch in ihr, die wohl einstmals fuers Heizen gedacht waren. ");

  AddDetail( ({ "heizen" }),
    "Die Huette scheint frueher mit Torfstuecken beheizt worden zu sein. ");

  AddDetail( ({ "torf", "torfstuecke", "torfstueck", "stuecke", "steck" }),
    "In der Kiste liegen noch eine Stuecke Torf. Sie scheinen schon ziemlich "
    "alt zu sein, aber vielleicht kann man sie sogar noch verheizen?!");

  AddDetail( ({ "mitte" }),
    "Ein Tisch steht in der Mitte des Raumes. ");

  AddDetail( ({ "sessel" }),
    "Der Sessel liegt umgefallen am Boden. Der einstige Bewohner dieser "
    "Huette scheint sie ziemlich ueberstuerzt verlassen zu haben. ");

  AddDetail( ({ "tisch" }),
    "Ein Tisch steht genau in der Mitte des Raumes. Er sieht schon ziemlich "
    "alt aus, und seine Tischplatte ist mit einer dicken Staubschicht "
    "ueberzogen. ");

  AddDetail( ({ "tischplatte", "platte" }),
    "Die ist auch schon mit ziemlich viel Staub bedeckt!");

  AddDetail( ({ "backsteine", "steine"  }),
    "Der Kamin wurde aus roten Backsteinen gefertigt. Einer faellt Dir "
    "irgendwie besonders auf. ");

  AddDetail( ({ "backstein", "stein" }),
    "Ein Backstein sticht irgendwie hervor. Er scheint etwas lose zu sein. ");

  AddDetail( ({ "brennmaterial", "material" }),
    "Als Brennmaterial wurde sicherlich Torf genutzt. Allerdings thront im "
    "Kamin mittlerweile nur mehr ein Haeufchen Asche. "); 

  AddDetail( ({ "bewohner" }),
    "Der Bewohner scheint hier schon lange nicht mehr zu leben. Warum "
    "er seine Huette so ploetzlich verlassen hat?!");

  AddDetail( ({ "decke", "holzdecke" }),
    "Eine simple Holzdecke befindet sich ueber Dir. In einigen Ecken "
    "siehst Du auch Spinnweben. ");

  AddDetail( ({ "ecken" }),
    "In einigen Ecken befinden sich Spinnweben. ");

  AddDetail( ({ "weben", "spinnweben" }),
    "Sie haengen einfach in den Ecken. Spinnen siehst Du zum Glueck keine. ");

  AddDetail( ({ "spinne", "spinnen" }),
    "Keine zu sehen. (ZUM GLUECK!)");

  AddDetail( ({ "glueck" }),
    "Glueck ist, dass Du keine Spinnen sehen kannst. Sonst haette die hier "
    "zustaendige Magierin naemlich ganz viele grausliche Details ueber "
    "Spinnen schreiben muessen. ");

  AddDetail( ({ "details", "detail" }),
    "Hier gibt es wirklich genug!");

  AddDetail( ({ "magierin" }),
    "Clementine ist hier zustaendig, bei Beschwerden schreibst Du aber "
    "am besten ans Salzamt.");
 
  AddDetail( ({ "salzamt" }),
    "Das kuemmert sich sicherlich gerne um Deine Beschwerden. ");

  AddDetail( ({ "beschwerden" }),
    "Hast Du welche?!");

  AddDetail( ({ "clementine", "cleme" }),
    "Die hat das ganze hier gepfutscht. ");

  AddDetail( ({ "feuer" }),
    "Momentan brennt keines, deshalb kannst Du auch keines sehen!");

  AddDetail( ({ "werkzeuge", "werkzeug" }),
    "Du erkennst einige seltsame Geraete, die aussehen, als stammen sie "
    "aus laengst vergangener Zeit. Viel kannst Du damit wirklich nicht "
    "anfangen, also verschwendest Du lieber nicht Deine kostbare Zeit mit "
    "soetwas. ");

  AddDetail( ({ "zeit" }),
    "Die vergeht doch manchmal wirklich schneller als man denkt. "); 
  
  AddDetail( ({ "geraete", "geraet" }),
    "Krallenfoermige ovalfoermige seltsame Schaufeln, nadelfoermige "
    "zylindrische Stifte, ...");

  AddDetail( ({ "stift", "stifte", "schaufel", "schaufeln" }),
    "Du weisst wirklich nicht wofuer man soetwas braucht. "); 

  AddDetail( ({ "holz", "birke", "birkenholz" }),
    "Das Holz, das hier verwendet wurde ist eindeutig Birke. ");

  AddDetail( ({ "eindruck" }),
    "Man hat in der Huette den Eindruck, als waere sie ziemlich "
    "ueberstuerzt verlassen worden. ");

  AddDetail( ({ "buch" }),
    "Von dem Buch blieb nichts ausser ein paar verblichene Fetzen "
    "Papier uebrig. ");

  AddDetail( ({ "papierfetzen", "fetzen" }),
    "Verblichene Fetzen Papier liegen auf dem Boden. ");

  AddDetail( ({ "papier" }),
    "Es ist schon ganz verblichen. ");

  AddReadDetail( ({ "fetzen", "papierfetzen" }), 
    "\n"
    ".-,--.,--,-.\n"
    "| k e y ! f|\n"
    "| i sk 2 ka|\n"
    "|s rand sk3|\n"
    "| lies alle|\n"
    "|s mit beda|\n"
    "|cht, dann |\n"
    "|ist das hi|\n"
    "|er fuer di|\n"
    "|ch gemacht|\n"
    "'--'---\"---'\n"
    "\n");

  AddDetail( ({ "gefaesse", "gefaess" }),
    "Die Gefaesse liegen zerbrochen aúf dem Boden. Falls sie jemals "
    "mit etwas gefuellt waren, so kann man das mittlerweile nicht mehr "
    "erkennen. ");

  AddDetail( ({ "scherben" }),
    "Auch einige Scherben kannst Du auf dem Boden sehen. Sie scheinen "
    "wohl von den zerbrochenen Gefaessen zu stammen. ");


// SMELLS

  AddSmell(DEFAULT_SMELL, "Hier riecht es ziemlich staubig. ");
  
  AddSmell( ({ "staub" }),
    "Hatschiiiiiiiiiiiiiiiii!");


// SOUNDS

  AddSound(DEFAULT_SOUND, "Es ist hier fast still, nur manchmal wird diese "
    "Stille durch leises Rascheln unterbrochen. ");

  AddSound( ({ "stille" }),
    "Absolut ruhig hier, nur manchmal hoerst Du etwas Rascheln.");

  AddSound( ({ "raschel", "rascheln" }),
    "*raschel* *raschel* Das Rascheln erzeugst Du wohl selbst. ");
    
 


  AddCmd( ({ "betracht", "betrachte" }), "c_betrachten");
  AddCmd( ({ "verheize", "verheiz" }), "c_verheizen" );
  AddCmd( ({ "wisch", "wische" }),  "c_wischen");
  AddCmd( ({ "zieh", "ziehe" }), "c_ziehen");

}

int c_ziehen(string str)
{
 object ob;
 if( str != "backstein heraus"     &&
     str != "stein heraus"         &&
     str != "backstein raus"       &&
     str != "stein raus"           &&
     str != "an backstein"         &&
     str != "an stein"              )
 {
  notify_fail("An was moechtest Du ziehen?\n");
  return 0;
 }
 else
 { 
  if(anz_zettel <1)
  {
   write(BS("Irgendwie sitzt der Backstein doch fester, als Du angenommen "
            "hast. Du gibst auf!"));
   say(CTPN + " sieht enttaeuscht aus.\n");
   return 1;
  }
  else
  {
   write(BS("Als Du den losen Backstein herausziehst, faellt Dir ein kleiner "
            "Zettel in die Haende. Vorsichtig steckst Du den Stein wieder an "
            "seinen gewohnten Platz, damit niemand etwas merkt. "));
   ob = clone_object(OBJ "steinzettel");
   if(ob->move(this_player(), M_GET) != 1)
   {
    tell_object(this_player(), "Du kannst nichts mehr tragen!\n");
    ob->move(this_object(), M_NOCHECK);
   }
   anz_zettel--;
   say(CTPN+ " tut geheimnisvoll.\n");
   return 1;
  }  
 }
}


int c_wischen(string str)
{
 if( str != "staub" )
 {
  notify_fail("Was moechtest Du wischen?\n");
  return 0;
 }
 else
 {
  write(BS("Du beginnst muehevoll den Staub mit Deiner Hand wegzuwischen, "
           "doch leider scheiterst Du klaeglich. Es liegt hier wirklich "
           "viel zu viel von diesem Staub!"));
  say(CTPN + " versucht Staub zu wischen.\n");
  return 1;
 }
}


int c_verheizen(string str)
{
 if( str != "torf"        &&
     str != "torfstuecke"  )
 {
  notify_fail("Was moechtest Du verheizen?\n");
  return 0;
 }
 else
 {
  write(BS("Neeeeeeein! Du wuerdest Dir doch bloss Deine Haende "
           "schmutzig machen!"));
  say(CTPN + " kuckt sich auf die Haende.\n");
  return 1;
 }
}
 
 

int c_betrachten( string str)
{
 if( str != "muster" )
 {
  notify_fail("Was moechtest Du betrachten?\n");
  return 0;
 }
 else
 {
  write(BS("Huch, da sind ja seltsame Spuren..."));
  return 1;
 }
}


int c_klettern(string str)
{
  if( str != "in kamin")
  {
	notify_fail("Wohin moechtest Du klettern?\n");
	return 0;
  }
  else
  {
	write(BS("Muehsam zwaengst Du Dich in den Kamin.")+"\n"+BS(
		  "Huch, verdammt! Da ist ja ein Loch!")+"\n"+BS(
		  "Du faellst...und faellst...und faellst...") +"\n"+BS(
		  "PLUUUUUUUUUUUUUUUUMPS! Du landest unsanft.") +"\n" );
	this_player()->move(ROOM "room_e7", M_GO,
		         "wohin", "kriecht", "faellt herein");
    return 1;
  }
}

