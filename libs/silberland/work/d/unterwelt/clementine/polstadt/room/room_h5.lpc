inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
     "Vor Dir tuermen sich dutzende Regale, die hoch hinauf bis zur Decke "
     "reichen. In ihnen scheint sich das gesamte gesammelte Wissen der hier "
     "lebenden Hexen zu befinden. Dicke schwere Waelzer mit sonderbaren "
     "Einbaenden kannst Du erkennen, aber auch lose eingereihte Pergamente, "
     "die fast alle, in einer Dir fremden Schrift, geschrieben wurden. "
     "Einige Sitzgelegenheiten bieten hier Platz zum Lesen und Studieren "
	 "der unzaehligen Werke. Bei Fragen kannst Du Dich sicherlich auch immer "
	 "an Voelva, die Bibliothekarin wenden. ");
     
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddExit( "nordosten", ROOM "room_g6" );
  AddExit( "suedosten", ROOM "room_i6" ); // versteckt

  SetProp(P_HIDE_EXITS, ({ "suedosten" }) );

  AddCmd( ({ "sag", "sage", "ruf", "rufe", "'" }), "kickfunc");
  
}

kickfunc(string str)
{
  if(!str)
  {
    write(BS("Was moechtest Du?\n"));
    return 1;
  }
  else
  {
	write(BS("Von allen Seiten zischt es: Sei gefaelligst leise hier!!!")
		+"\n"+BS("Hochkant wirst Du hinausgeworfen!") +"\n");
	this_player()->move( ROOM "room_g6", M_GO,
		"raus", "fliegt", "plumpst herein");
	return 1;
  }
}

		
	

