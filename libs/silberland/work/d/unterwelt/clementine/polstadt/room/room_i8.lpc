// saridias ausgangsraum

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


int wo,wasser,anzahl,unterwegs;

reset() {
  ::reset();
  anzahl=3+random(2);
}


create()
{

  ::create();

  wo=0;
  wasser=0;
  unterwegs=0;
  anzahl=3;


  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
	"Du stehst auf einem kleinen Platz, der mit Laternen erhellt wird. "
    "Um einen, mit Kletterpflanzen und Straeuchern umwachsenen Brunnen "
    "wurden kreisfoermig einige Holzbaenke angeordnet. Immer wieder siehst "
	"Du ein paar Hexen, die sich kurz miteinander unterhalten, und dann "
	"weiterhuschen. Vielleicht erzaehlt man Dir ja auch die neuesten "
	"Geruechte und Geschichten, wenn Du etwas wartest. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "sueden", ROOM "room_j8" );
  AddExit( "nordwesten", ROOM "room_h7" );
  AddExit( "nordosten", ROOM "room_h9" );


  AddCmd( ({ "trink", "trinke" }), "c_trinken");
  AddCmd( ({ "lasse", "lass" }), "c_lassen" );




// DETAILBEGINN


  AddSpecialDetail( ({ "brunnen" }), "brunnen");

  AddDetail( ({ "seil" }),
     "An diesem Seil kann man wohl den Eimer hinauf- oder hinunterlassen. ");

  AddDetail( ({ "steinbrunnen" }),
     "Der Steinbrunnen dient den Hexen wohl als Trinkwasservorrat. ");

  AddDetail( ({ "trinkwasservorrat" }),
     "Wasser ist lebensnotwendig fuer jeden. ");

  AddDetail( ({ "wasser" }),
     "Ohne Fluessigkeit wuerde man innerhalb von ein paar Tagen sterben. ");

  AddDetail( ({ "fluessigkeit" }),
     "Bist Du durstig?");

  AddDetail( ({ "trinkwasser" }),
    "Trinkwasser dient dem Trinken. ");

  AddDetail( ({ "trinken" }),
    "Viel Trinken ist wichtig fuer Deine Gesundheit. ");

  AddDetail( ({ "gesundheit" }),
    "Die ist Dir doch wichtig, oder? ");

  AddDetail( ({ "gestell" }),
    "An einem metallernen Gestell ueber dem Brunnen wurde ein Seil "
    "angebunden. ");

  AddSpecialDetail( ({ "eimer" }), "eimer");


}


string brunnen()
{
 string str;
 str="Ein kleiner Steinbrunnen befindet sich hier. Er scheint "
     "randvoll mit Wasser gefuellt zu sein. Ueber dem Brunnen "
     "wurde ein Gestell angebracht. ";
 if (wo==1)
 return BS(str+"Ein Seil haengt tief in den Brunnen hinein.");
 return BS(str+"Ein kleiner Eimer haengt an einem Seil dran. ");
}


string eimer()
{
 string str;
 str="Ein kleiner Eimer aus Blech, der an einem Seil angebunden ist. ";
 if (wo==1)
   return BS(str+"Der Eimer ist zu weit unten, "
                 "als das Du etwas genauer erkennen "
                 "koenntest.");
  if (wasser==0)
    return BS(str+"Der Eimer ist leer.");
  return BS(str+"Der Eimer ist voller frischem Wasser.");
}

int c_lassen(string str )
{
 notify_fail("Der Eimer ist doch noch unterwegs!\n");
 if(unterwegs != 0) return 0;
 notify_fail("Was moechtest Du hier genau machen?\n");
 if( str == "eimer hinunter" ||
     str == "eimer herab"    ||
     str == "eimer hinab"    ||
     str == "eimer runter"   )
 {
  if( wo==1)
  {
  write("Aber der Eimer ist doch schon unten!\n");
  return 1;
  }
  if(wasser == 1)
  {
  write("Aber der Eimer ist doch schon randvoll mit Wasser gefuellt!\n");
  return 1;
  }
 write(BS("Vorsichtig laesst Du den Eimer nach unten. "));
 say(CTPN+ " laesst vorsichtig den Eimer nach unten.\n");
 unterwegs=1;
 wo=1;
 call_out("runter1",5);
 return 1;
 }

 if( str == "eimer hinauf" ||
     str == "eimer rauf"   ||
     str == "eimer herauf" )
 {
  if (wo==0)
   {
     write("Aber der Eimer ist doch schon oben.\n");
     return 1;
   }
    write(BS("Vorsichtig ziehst Du den Eimer nach oben. "));
    say(CTPN+ " zieht vorsichtig den Eimer nach oben.\n");
    unterwegs=1;
    wo=0;
    call_out("rauf1",5);
    return 1;
  }
 return 0;
}

void runter1() {
tell_room(ME,
    BS("Der Eimer platscht in das Wasser und fuellt sich.\n"));
    call_out("runter2",5);
}

void runter2() {
  tell_room(ME,
    BS("Mit einem lauten Glucksen hat sich der Eimer jetzt mit Wasser "
       "gefuellt.\n"));
  unterwegs=0;
  wasser=1;
}

void rauf1() {
  tell_room(ME,
    BS("Der Eimer gleitet weiter nach oben.\n"));
  call_out("rauf2",5);
}

void rauf2() {
  tell_room(ME,
    BS("Der Eimer ist jetzt ganz oben angekommen.\n"));
  unterwegs=0;
  anzahl--;
  if (anzahl < 0) {
    wasser=0;
    tell_room(ME,
      BS("Leider ist auf dem Weg nach oben das ganze Wasser entwichen.\n"));
  }
}

int c_trinken(string str )
{
 notify_fail("Was moechtest Du trinken?\n");
 if(str != "wasser"           &&
    str != "wasser aus eimer" &&
    str != "aus eimer"        )
 {
  return 0;
 }
 if(unterwegs==1)
 {
  write(BS("Aber der Eimer ist doch noch unterwegs!"));
  return 1;
 }
 if(wo==1)
 {
  write(BS("Aber der Eimer ist doch noch viel zu weit unten! "));
  return 1;
 }
 if(wasser==0)
 {
  write(BS("Aber in dem Eimer ist doch gar kein Wasser! "));
  return 1;
 }
 wasser=0;
 TP->heal_self(30+random(40));
 write(BS("Du trinkst den Eimer komplett leer und fuehlst Dich sofort "
          "erfrischt. "));
 say(CTPN+ " trinkt den Eimer vollstaendig leer.\n");
 return 1;

}

