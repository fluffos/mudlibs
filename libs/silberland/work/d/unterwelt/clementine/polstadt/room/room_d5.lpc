
inherit "std/pub";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <pub.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In einer Kneipe");
  SetProp(P_INT_LONG, 
    "Hinter etlichen Tischen und Sessel kannst Du eine riesenlange Theke "
    "an der Rueckwand des Lokals erkennen. An der Nordwand befindet sich ein "
    "grosser Kamin, ueber dessen offenem Feuer ein metallener Kessel baumelt. "
    "Der Duft der von ihm ausgeht laesst Dir das Wasser im Munde "
    "zusammenlaufen. Anscheinend wird in ihm die leckere Hexensuppe gebraut, "
    "die Roeskva als eine ihrer Spezialitaeten anpreist. Direkt neben dem "
    "Eingang haengt eine Tafel, die Dir einen kleinen Ueberblick ueber "
    "die hier angebotenen Speisen und Traenke gibt. "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER | PUB_NEEDSKEEPER );
  SetProp(P_PUBKEEPER_ID, "roeskva" );
  SetProp(P_PUBKEEPER_NAME, "Roeskva" );
  SetProp(P_PUBKEEPER_GENDER, FEMALE );
  SetProp(P_PUBMSG_NOINVITE, "Roeskva sagt: Dumm bin ich noch lange nicht!\n");
  SetProp(P_PUBMSG_FIGHTING, " kaempft doch gerade!\n"); 
  SetProp(P_PUBMSG_NOENEMY, "Roeskva sagt: Glaubst Du doch nicht wirklich!\n");



  AddExit( "osten", ROOM "room_d6" );


// ESSEN UND TRINKEN

  AddDrink( "Birkentee", ({ "tee", "birkentee" }),
     20, 10, 0, 2,
     ({ "Roeskva bringt Dir ein Heferl Birkentee, was Du rasch austrinkst.\n",
        "Roeskva bringt && ein Heferl Birkentee, was &! rasch "
        "austrinkt.\n" }) );

  AddDrink( "Birkenschnaps", ({ "birkenschnaps", "schnaps" }),
     25, 16, 3, 2,
     ({ "In einem Zug leerst Du ein Stamperl Birkenschnaps.\n",
        "&& leert in einem Zug ein Stamperl Birkenschnaps.\n" }) );

  AddDrink( "Moorsaft", ({ "moorsaft", "saft" }),
     50, 20, 0, 3,
     ({ "Roeskva zapft Dir ein Glas Moorsaft von einem Fass ab, und wirft es "
        "Dir dann zu.\n",
        "Roeskva zapft && ein Glas Moorsaft ab, und wirft es &3 dann "
        "zu.\n" }) );
 
  AddDrink( "Irrlichtwein", ({ "irrlichtwein", "wein" }),
     100, 30, 2, 4,
     ({ "Du bekommst ein Glaeschen Irrlichtwein. Rasch trinkst Du es leer. "
        "Mhm...war das lecker!\n",
        "&& bekommt ein Glaeschen Irrlichtwein, und sieht auf einmal "
        "viel froehlicher aus.\n" }) );
 
  AddDrink( "Molchmilch", ({ "molchmilch", "milch" }),
     240, 40, 0, 3,
     ({ "Roeskva presst Dir schnell ein Glas frischer Molchmilch. "
        "Voller Gier kippst Du es schnell hinunter.\n",
        "Roeskva bringt && ein Glas frischer Molchmilch, was &! mit "
        "voller Gier hinunterkippt.\n" }) );

  AddDrink( "Wunschpunsch", ({ "wunschpunsch", "punsch" }),
     400, 20, 3, 4,
     ({ "Roeskva bringt Dir einen Wunschpunsch. Rasch trinkst Du ihn aus, "
        "machst dann die Augen zu, und wuenscht Dir was.\n",
        "&& trinkt einen Wunschpunsch leer, und schliesst dann die Augen, "
        "um sich was zu wuenschen.\n" }) );


  AddFood( "Hexensuppe", ({ "suppe", "hexensuppe" }),
     30, 5, 2, 
     ({ "Du schluerfst einen Teller Hexensuppe.\n", 
        "&& schluerft einen Teller mit Hexensuppe.\n"}) ); 

   AddFood( "Kroetenhaut", ({ "kroetenhaut", "haut" }),
     70, 10, 3, 
     ({ "Roeskva braet Dir ein Stueck Kroetenhaut frisch heraus, dass Du "
        "gierig in Deinen Mund stopfst.\nHmmm...lecker!\n",
        "&& bekommt ein Stueck Kroetenhaut.\n" }) );
   
   AddFood( "Sumpfleichenaugen", ({ "sumpfleichenaugen", "augen",  
                                    "leichenaugen" }),
     50, 7, 2,
     ({ "Roeskva serviert Dir einen Teller mit Sumpfleichenaugen.\n",
        "&& bekommt einen Teller mit Sumpfleichenaugen von Roeskva "
        "serviert.\n" }) );

   AddFood( "Schlammragout", ({ "schlammragout", "ragout" }),
     150, 30, 10,
     ({ "Roeskva bringt Dir einen Teller vollgefuellt mit frischem "
        "Schlammragout.\nRasch schlingst Du alles hinunter.\n",
        "Roeskva bringt && einen Teller mit Schlammragout, den &1 gierig "
        "hinunterschlingt.\n" }) );

   AddFood( "Froschschenkel", ({ "froschschenkel", "schenkel" }),
     300, 55, 20,
     ({ "Gierig verschlingst Du die Froschschenkel und bekommst "
        "auf einmal Gusta auf Fliegen.\n",
        "&& verschlingt gierig Froschschenkel und blickt sich "
        "seltsamer Weise nach Fliegen um.\n" }) );


   AddFood( "Rindensteak", ({ "steak", "rindensteak" }),
     500, 100, 27,
     ({ "Roeskva geht in die Kueche, und kommt rasch mit einem "
        "frisch gebratenem Rindensteak wieder zurueck.\nHmm...schmeckt "
        "das aber gut!\nDu beginnst zu sabbern...\n",
        "Roeskva geht in die Kueche und bringt && ein frisch gebratenes "
        "Rindensteak, was &1 sofort runterschlingt...\n" }) );


//nebelschwaden, 
//Hexenkraut, 
//Sumpfbier, Heidekraut,   
//Grosser Zauber, Untergang, Schleichender Tod, 
//Rote Warze, 


// DETAILBEGINN

  AddDetail( ({ "lokal" }),
    "Das Lokal sieht gemuetlich und ziemlich urig aus, sodass Du richtig "
    "Lust bekommst hier laenger zu verweilen. ");

  AddDetail( ({ "lust" }),
    "Irgendwie fuehlst Du Dich hier wohl. ");

  AddDetail( ({ "raum", "huette" }), QueryProp(P_INT_LONG) ); 

  AddDetail( ({ "kneipe" }),
    "Du stehst in der Kneipe 'Zum Hexenkessel'. ");

  AddDetail( ({ "zum hexenkessel", "name" }),
    "'Zum Hexenkessel' ist der Name dieser Kneipe. ");

  AddDetail( ({ "wasser", "mund", "munde" }),
    "Alles duftet hier so lecker, dass Du auf einmal riesigen Hunger "
    "verspuerst. ");

  AddDetail( ({ "hunger" }),
    "Probier doch einmal eine der leckeren Speisen von Roeskva. ");

  AddDetail( ({ "roeskva" }),
    "Ist sie gerade nicht hier? Sie scheint wohl noch Besorgungen zu haben. "
    "Uebe Dich einen Augenblick in Geduld, sie kommt sicher bald wieder. ");

  AddDetail( ({ "geduld", "augenblick" }),
    "Warte einfach kurz. ");

  AddDetail( ({ "besorgungen" }),
    "Vielleicht besorgt sie gerade Zutaten fuer ihre leckere Suppe. ");

  AddDetail( ({ "zutaten" }),
    "Die sind natuerlich strengstens geheim!");

  AddDetail( ({ "suppe", "hexensuppe" }),
    "Roeskva ist fuer ihre koestliche Hexensuppe im ganzen Silberland "
    "beruehmt. Und angeblich schmeckt sie ja wirklich hervorragend! ");

  AddDetail( ({ "silberland" }),
    "Fast jeder kennt Roeskvas leckere Suppe hier. ");

  AddDetail( ({ "kessel", "hexenkessel" }),
    "Ein riesiger Hexenkessel baumelt ueber dem offenen Feuer des Kamins. "
    "In ihm koechelt es und abundzu sieht man sogar ein paar Blubberblasen. ");

  AddDetail( ({ "blasen", "blubberblasen" }),
    "Im Kessel kocht und blubbert es. ");

  AddDetail( ({ "duft" }),
    "Riech doch mal! ");

  AddDetail( ({ "eingang" }),
    "Neben dem Eingang im Osten haengt eine Tafel. ");

  AddDetail( ({ "tafel" }),
    "Die Tafel scheint Dir einen kleinen Ueberblick ueber die Speisen und "
    "Getraenke der Kneipe zu geben. Mit <menue> kannst Du sie lesen. ");

  AddDetail( ({ "speisen" }),
    "Lies doch einfach mal die Karte, dann siehst Du, was man hier Leckeres "
    "kaufen kann. ");

  AddDetail( ({ "leckeres" }),
    "Probier doch einfach mal was. ");

  AddDetail( ({ "karte" }),
    "Tipp: 'menue' ");

  AddDetail( ({ "traenke", "getraenke" }),
    "Roeskva bietet Dir hier wirklich sehr wohlschmeckende Getraenke an. Du "
    "solltest unbedingt mal ihren selbst gebrannten Birkenschnaps probieren. ");

  AddDetail( ({ "birkenschnaps", "schnaps" }),
    "Man erzaehlt sich, dass der selbstgebrannte Birkenschnaps von Roeskva "
    "wirklich ausgezeichnet schmeckt. ");

  AddDetail( ({ "ueberblick" }),
    "Die Tafel soll Dir einen kleinen Ueberblick ueber Roeskvas Angebot "
    "geben. ");

  AddDetail( ({ "angebot" }),
    "Das Angebot ist eigentlich ziemlich umfangreich. Ausserdem gibt es hier "
    "immer wieder Koestlichkeiten zum Probieren. ");

  AddDetail( ({ "koestlichkeiten", "probieren" }),
    "Roeskva laesst manchmal Gaeste wie Dich Eigenkreationen von ihr testen. ");

  AddDetail( ({ "kreationen", "eigenkreationen" }),
    "Frag sie doch einmal danach. Vielleicht hat sie wieder etwas Neues "
    "gezaubert. "); //roeskva einbaun!

  AddDetail( ({ "neues" }),
    "Einfach mal Roeskva fragen!");

  AddDetail( ({ "gaeste", "gast" }),
    "Manchmal laesst Roeskva Gaeste ihre neuesten Kreationen testen. ");
     
  AddDetail( ({ "kamin" }),
    "Der Kamin sieht einfach toll aus. Er reicht fast bis zur Decke und wurde "
    "'stufenartig' erbaut, sodass man bis nach oben kraxeln kann, um es sich "
    "dort gemuetlich zu machen. Unten hat er eine offene Feuerstelle, ueber "
    "der noch ein Kessel haengt. "); //katze sitzt oben! auf balken->fetzn! 
//kraxeln

  AddDetail( ({ "stelle", "feuerstelle" }),
    "Na dort, wo das Feuer brennt!");
 
  AddDetail( ({ "spezialitaet", "spezialitaeten" }),
    "Hier kannst Du sicherlich diese leckere Hexensuppe probieren. ");

  AddDetail( ({ "decke", "holzdecke" }),
    "Die Decke besteht aus Holz. Ein fester Querbalken fuehrt zusaetzlich zu "
    "den Holzbalken von der Sued - zur Nordwand. ");

  AddDetail( ({ "holzbalken" }),
    "Die Decke besteht aus mehreren Holzbalken, die zusaetzlich noch von "
    "einem Querbalken gestuetzt werden. ");

  AddDetail( ({ "balken" }),
    "Holzbalken oder Querbalken? ");

  AddDetail( ({ "querbalken", "querbalke" }),
    "Er stuetzt die restlichen Holzbalken der Decke ab. An ihm wurde auch "
    "eine Lampe befestigt, die zusaetzlich zum Kaminfeuer den Raum erhellt. "
    "Ein weisses Stoffstueck faellt Dir auf. ");
 
  AddDetail( ({ "stueck", "stoff", "stoffstueck" }),
    "Es liegt auf dem Querbalken. ");

// klettern irgendwie rauf zum fetzen

  AddDetail( ({ "theke" }),
    "Die Theke befindet sich an der Rueckwand des Lokals und ist wirklich "
    "immens lang. Dahinter steht normalerweise Roeskva und bedient ihre "
    "Kundschaft. ");

  AddDetail( ({ "kundschaft" }),
    "Los kauf was! Dann gehoerst Du auch zur Kundschaft. ");

  AddDetail( ({ "wand" }),
    "Welche Wand?!");

  AddDetail( ({ "rueckwand", "rueckseite" }),
    "Die Rueckwand befindet sich an der Rueckseite des Lokals. Sie wurde "
    "weiss gestrichen. Davor siehst Du eine lange Theke. ");

  AddDetail( ({ "weiss" }),
    "Schoene strahlende weisse Farbe!");

  AddDetail( ({ "farbe" }),
    "Strahlend weiss!"); 

  AddDetail( ({ "waende" }),
    "Die Waende sind allesamt aus Holz, die Rueckwand wurde zusaetzlich "
    "noch weiss gestrichen. ");

  AddDetail( ({ "holz" }),
    "Huebsches Holz, dass sich sicherlich auch sehr gut zum Verheizen eignen "
    "wuerde. Aber dann wuerde ja die Huette zusammenbrechen...");

  AddDetail( ({ "verheizen" }),
    "Vielleicht findet sich ja hier auch noch etwas anderes, dass man "
    "verheizen koennte. "); // fetzen!

  AddDetail( ({ "lampe" }),
    "Lampe ist etwas uebertrieben... es sieht eher aus wie eine kleine "
    "Laterne. ");

  AddDetail( ({ "laterne" }),
    "Die Laterne baumelt von dem Querbalken der Decke. Sie hat vier Seiten "
    "aus Glas, und ein spitzzulaufendes Dach aus Eisen. In ihr brennt eine "
    "dicke weisse Kerze. ");

  AddDetail( ({ "kerze" }),
    "Sie scheint wohl erst vor kurzem in die Laterne gesteckt worden zu "
    "sein. ");

  AddDetail( ({ "wachs" }),
    "Ja! Die Kerze besteht natuerlich auchs Wachs. ");

  AddDetail( ({ "seiten", "seite" }),
    "Die Laterne hat 4 gleich grosse Seiten und ein Dach. ");

  AddDetail( ({ "dach" }),
    "Das Dach ist aus Eisen, damit auch garantiert nichts anbrennen kann. ");

  AddDetail( ({ "eisen" }),
    "Es ist ganz schwarz, und wirklich gut verarbeitet worden. Anscheinend "
    "stammt es aus Felonia. ");

  AddDetail( ({ "felonia" }),
    "Nur Eisen aus Felonia gewaehrleistet wirklich noch Qualitaet. ");

  AddDetail( ({ "qualitaet" }),
    "Die Qualitaet ist natuerlich sehr wichtig. ");

  AddDetail( ({ "glas" }),
    "Das Glas ist logischerweise durchsichtig, da man ja sonst die Kerze "
    "gar nicht sehen wuerde. ");

  AddDetail( ({ "boden" }),
    "Der Boden ist fuer eine Kneipe wirklich sehr sehr sauber, was Dich etwas "
    "verwundert, aber nicht weiter stoert. ");

  AddDetail( ({ "nordwand" }),
    "An der Nordwand steht ein grosser Kamin, den Du Dir vielleicht einmal "
    "naeher anschauen solltest. ");

  AddDetail( ({ "sessel" }),
    "Hier stehen einige Sessel herum. Wahrscheinlich sind diese normalerweise "
    "auch alle belegt, aber Du scheinst die Einwohner doch etwas verschreckt "
    "zu haben. ");

  AddDetail( ({ "einwohner" }),
    "Die Einwohner von Polaris trauen keinen Fremden wie Dir. ");

  AddDetail( ({ "fremder", "fremde" }),
    "Du!");

  AddDetail( ({ "stadt", "polaris" }),
    "Die Stadt hier heisst Polaris. ");

  AddDetail( ({ "tische", "tisch" }),
    "Schon als Du hereingekommen bist, sind Dir die vielen Tische und ihre "
    "Sessel aufgefallen. Anscheinend hat Roeskva normalerweise viele "
    "Besucher. ");

  AddDetail( ({ "besucher" }),
    "Viele Besucher bedeutet fuer Roeskva viel Arbeit. ");

  AddDetail( ({ "arbeit" }),
    "Ohne Arbeit waere Roeskva wahrscheinlich sowieso nur langweilig. ");

  AddDetail( ({ "kaminfeuer", "feuer" }),
    "Das Feuer im Kamin knistert leise vor sich hin. Ueber ihm baumelt ein "
    "grosser Kessel. ");
 

// SOUNDS

  AddSound(DEFAULT_SOUND, "Du hoerst das Feuer im Kamin knistern. ");

  AddSound( ({ "kamin" }),
    "Dort brennt das Feuer!");

  AddSound( ({ "feuer" }),
    "Es knistert vor sich hin. Nur manchmal wird das Knistern von einem "
    "anderen Geraeusch unterbrochen. ");

  AddSound( ({ "geraeusch" }),
    "*klirr* *klirr*");

  AddSound( ({ "knistern" }),
    "*knister* *knister* ");
   
  AddSound( ({ "klirren" }),
    "Scheint als waere gerade ein Glas wo herunter gefallen. ");

  AddSound( ({ "glas" }),
    "Nichts mehr zu hoeren. ");


// SMELLS

  AddSmell(DEFAULT_SMELL, "Hier riecht es einfach koestlich!");

  AddSmell( ({ "kessel", "suppe", "bruehe", "hexensuppe" }),
    "Die Suppe im Kessel riecht hervorragend! Ob sie genauso gut schmeckt?!");


// AddCmd( ({ "kraxl", "kraxle", "kraxel" }) "c_kraxeln");  
// AddCmd( ({ "setz", "setze" }), "c_setzen"); // sessel
// AddCmd( ({ "steh", "stehe" }), "c_stehen"); // aufstehen sessel
// AddCmd( ({ "kraul", "kraule" }), "c_kraulen"); // katze kraulen
// AddCmd( ({ "verheize", "verheiz" }), "c_verheizen"); //fetzen verheizen
// AddCmd( ({ "kletter", "klettre", "klettere" }), "c_klettern"); //auf querbalken den fetzen holn und gleich retour kamin. 


 
}





