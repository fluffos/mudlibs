
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
     "Mmhmm, riecht das lecker! Aus dem Westen stroemt ein himmlischer "
     "Duft in Deine Nase; dort scheint wahrlich ein Koenner am Werk zu sein. "
     "Gleich neben dem Eingang lehnt eine riesenlange Tafel, die die "
     "Koestlichkeiten, welche in der Kneipe angeboten werden, anpreist. "
     "Am Wegrand waechst ein kleines Baeumchen in dessen Geaest einige "
     "bunte Lampions haengen. Obwohl diese Stadt wirklich ihre Eigenheiten "
     "zu haben scheint, kommst Du Dir hier irgendwie gut aufgehoben vor. ");   
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "westen", ROOM "room_d5" );
  AddExit( "sueden", ROOM "room_e6" );

}

