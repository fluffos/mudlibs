
// versammlungraum zugang zu T

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
	  "Du stehst im Versammlungsraum der Hexen. Jeder Bewohner von "
	  "Polaris hat hier die Moeglichkeit seine Anliegen und Wuensche "
	  "vorzutragen. Die Termine fuer solche Treffen werden natuerlich "
	  "nie oeffentlich angeschlagen, sondern mit Hilfe von geheimen "
	  "Botschaften verbreitet. Unzaehlige Baenke und Sesseln stehen "
	  "hier, sodass auch wirklich jeder einen Platz bei solchen "
	  "Versammlungen finden kann. "
	  "An der Suedwand befindet sich ein grosses Rednerpult. "
	  "Im Eck daneben haengt eine Tafel, "
	  "auf der alles Moegliche notiert wurde. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "norden", ROOM "room_h10" );
  AddExit( "suedwesten", ROOM "room_j9" ); //versteckter zugang zu T

  SetProp(P_HIDE_EXITS, ({ "suedwesten" }) );

}

