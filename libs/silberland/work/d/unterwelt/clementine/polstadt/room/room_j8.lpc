
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
	  "Der Weg endet in einer Sackgasse. Im Sueden und Osten erkennt "
	  "man nur undurchdringliche Buesche und Baeume. Nach Norden kommst "
	  "Du auf den Platz. Im Westen befindet sich eine Huette, allerdings "
	  "kannst Du weit und breit keinen Eingang ausmachen. Sie scheint schon "
	  "einige Jahre hier zu stehen, zumindest sind die Bretter der Wand "
	  "morsch, und haetten eine Reparatur ziemlich noetig. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

//  AddExit( "westen", ROOM "room_j7" ); verstecken - huette aber kein eingang sichtbar blabla
  AddExit( "norden", ROOM "room_i8" );

  AddCmd( ({ "murmle", "murmel", "murml" }), "c_murmeln");
	
}

int c_murmeln(string str)
{
  if (str != "hex hex")
  {
	notify_fail("Was moechtest Du murmeln?\n");
	return 0;
  }
  else
  {
	write(BS("Du murmelst die magischen Worte 'HEX HEX', und schwebst durch "
		  "die Hauswand im Westen."));
	this_player()->move(ROOM "room_j7", M_GO,
		"einfach", "verschwindet", "steht ploetzlich da");
	return 1;
  }
}

			
