inherit "std/laden";

#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
     "Du befindest Dich in Ailbhes kleinem Reich in Polaris. Die Waende sind, "
     "so wie das in Laeden ueblich ist, mit Regalen zugestellt, in denen sich "
     "alle moeglichen Dinge befinden. Eine lange Verkaufstheke befindet sich "
     "an der Nordwand. Auf ihr stehen einige bunt bemalte Zuckerlglaeser. "
     "Dahinter siehst Du eine immens lange Tafel auf die alles Moegliche "
     "draufgekritzelt wurde. Von der Decke baumelt eine sternfoermige "
     "gelbe Laterne, die den Raum bis in die kleinsten Winkel und Ecken "
     "erhellt. Kauf doch etwas! "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  SetProp(P_KILL_NAME, "Eine abenteuerliche Holzkonstruktion" );

  AddExit( "norden", ROOM "room_d10" ); //versteckt wegen gilde
  AddExit( "suedwesten", ROOM "room_f9" );

  SetProp(P_HIDE_EXITS, ({ "norden" }) );  // ecken winkeln mauseloch


// DETAILBEGINN

  AddDetail( ({ "nordwand" }),
    "An der Nordwand befindet sich eine lange Verkaufstheke, auf der alle "
    "moeglichen Sachen rumkugeln, dahinter haengt eine lange Tafel. ");

  AddDetail( ({ "westwand" }),
    "An der Westwand siehst Du Regale!");

  AddDetail( ({ "waende" }),
    "Der Laden hat ganze vier Waende! Wow! ");

  AddDetail( ({ "wand" }),
    "Welche Wand denn nun schon wieder?! Ist es so schwer, dass Du Dich "
    "mal deutlich ausdrueckst?! Du weisst doch, dass das in Polaris immer "
    "genau beschrieben ist! *grmpf* ");

  AddDetail( ({ "polaris" }),
    "Polaris?! Noch nie gehoert...");

  AddDetail( ({ "tafel" }),
    "Da steht ja etwas drauf! ");

  AddReadDetail( ({ "tafel" }), "@@zeigefunc@@");
    

  AddDetail( ({ "laden", "raum" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "decke" }),
    "Die Decke ist in weiss gehalten. Von ihr baumelt eine sehr huebsche "
    "sternfoermige Laterne. ");

  AddDetail( ({ "glaeser", "zuckerlglaeser" }),
    "Die Zuckerlglaeser auf der Theke sind bunt bemalt. In ihnen siehst Du "
    "ganz ganz viele leckere Zuckerl. Ob man sich da eins nehmen darf?!");

// nimm zuckerl etc nur fuer kinder ausnahme feen und so...?!

  AddDetail( ({ "zuckerl" }),
    "Die Zuckerl in den Glaesern sehen alle total lecker aus und schmecken "
    "sicherlich auch so. Vielleicht schenkt Dir Ailbhe ja eines...");

  AddDetail( ({ "ailbhe" }),
    "Ist sie nicht da? Schade. ");

  AddDetail( ({ "dinge" }),
    "Na schau Dir doch mal die Tafel an, dann siehst Du was es hier alles "
    "gibt. ");

  AddDetail( ({ "laeden" }),
    "In Laeden gibt es normalerweise Regale. Zumindest sind Regale in Laeden "
    "aeusserst praktisch, sonst muesste man ja alles auf den Boden legen. ");

  AddDetail( ({ "regale", "regal" }),
    "Die Regale sind ziemlich abenteuerliche Konstruktionen aus Holz, aber sie "
    "scheinen zu halten. In ihnen siehst Du viele tolle Sachen, die Du am "
    "liebsten alle besitzen wuerdest. ");

  AddDetail( ({ "sachen" }),
    "Hier gibt es soviele tolle Sachen, dass Du am liebsten gleich hier "
    "einziehen moechtest. ");

  AddDetail( ({ "konstruktion", "konstruktionen" }),
    "Die Regale sehen allesamt ziemlich abenteuerlich aus. Lieber nicht dran "
    "ruetteln, sonst stuerzen sie womoeglich noch ein!");

// ruettel begraebt andrer spieler raushelfen aufstellen regal wieda!
// torian :) 
 

}

zeigefunc(string str)
{
 TP->command_me("zeige");
 return "";
}

