
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


void create()
{

  ::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
    "Kuehler Wind weht Dir von Norden entgegen, und laesst ein mulmiges "
    "Gefuehl in Deinem Koerper aufkommen. Starke Gefuehle von Einsamkeit, "
    "aber auch von Sehnsucht steigen in Dir auf, und verunsichern Dich. "
    "In der Dich umgebenen Stille fuehlst Du Dich auf einmal ziemlich "
    "verlassen. Doch so ausgestorben, wie die Stadt zu sein scheint, ist "
    "sie vielleicht gar nicht. Zumindest befindet sich im Westen eine "
    "Huette, an deren Wand ein Schild haengt. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "westen", ROOM "room_f2" );
  AddExit( "norden", ROOM "room_e3" );
  AddExit( "sueden", ROOM "room_g3" );


  NewDoor( "westen", ROOM "room_f2", ({ "tuer", "tuere", "birkentuer" }),
     ({ DOOR_OPEN,
        DOOR_RESET_OP,
        D_NAME, "Birkentuer",
        D_GENDER, FEMALE,
        D_SHORT, "Im Westen befindet sich eine %se Birkentuer.",
        D_LONG, "Eine alte Birkentuer, die wenn der Wind geht "
                "leise knirscht. "
                "Man kann sie mit Hilfe eines "
                "Riegels oeffnen und wieder schliessen. ",
        D_MSGS, ({ "in den Laden", "geht", "steht ploetzlich vor Dir" }),
        D_OPENMSG, ({ "Mit lautem Knarren schiebst Du den Riegel beiseite "
                      "und die Tuer oeffnet sich. ",
                      "Mit lautem Knaaren schiebt %s den Riegel beiseite.",
                      " wird mit lautem Knarren von aussen geoeffnet." }),
        D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du die Tuer.",
                       "Mit einem lauten Rumms schliesst %s die Tuer.",
                       " wird mit lautem Knarren von aussen geschlossen." }),
        D_RESET_OPENMSG, " wird durch einen Windstoss geoeffnet. " }) );








// DEGAILBEGINN


  AddDetail( ({ "westen" }),
    "Im Westen befindet sich eine Huette. ");

  AddDetail( ({ "huette" }),
    "Im Westen befindet sich eine Huette. Ein Schild haengt dort an der "
    "Wand. ");

  AddDetail( ({ "schild", "holzschild" }),
    "Ein Schild aus Holz haengt an der Wand. Darauf befinden sich "
    "komische Zeichen. ");

  AddDetail( ({ "zeichen" }),
    "Die komischen Zeichen sind Buchstaben. ");

  AddDetail( ({ "buchstaben" }),
    "Vielleicht solltest Du das Schild einfach mal lesen.");

  AddDetail( ({ "holz" }),
    "Es gibt viel Holz hier. Auch das Schild an der Huette ist aus Holz. ");

  AddReadDetail( ({ "schild" }),
    "+-----------------------------------------+\n"
    "|                                         |\n"
    "|     Tritt ein, bring Liebe herein!      |\n"
    "|                                         |\n"
    "+-----------------------------------------+\n");

  AddDetail( ({ "liebe" }),
    "Dieses Detail kannst Du nicht untersuchen. ");

  AddDetail( ({ "detail", "details" }),
    "Es sind die Kleinigkeiten, die oft wichtig sind. ");

  AddDetail( ({ "kleinigkeiten", "kleinigkeit" }),
    "Jaja, so ist das. ");

  AddDetail( ({ "osten" }),
    "Im Osten kannst Du nur Felsgestein erkennen. ");

  AddDetail ( ({ "felsgestein", "fels", "gestein" }),
    "Dunkles kaltes Felsgestein. ");

  AddDetail( ({ "sueden" }),
    "Nach Sueden scheint es auf eine belebtere Strasse zu gehen. ");

  AddDetail( ({ "norden" }),
    "Der Weg endet weiter nach Norden scheinbar in einer Sackgasse. ");

  AddDetail( ({ "sackgasse", "gasse" }),
    "Du musst schon nach Norden gehen, um Dich dort weiter umzusehen. ");

  AddDetail( ({ "weg" }),
    "Du stehst doch gerade auf einem Weg! ");

  AddDetail( ({ "strasse" }),
    "Im Sueden befindet sich eine belebtere Strasse. ");

  AddDetail( ({ "boden" }),
    "Der Boden unter Dir ist steinig. ");

  AddDetail( ({ "steine" }),
    "Du befindest Dich auf einem steinigen Boden. ");

  AddDetail( ({ "decke" }),
    "Die Decke ueber Dir ist weit weg. Nur ein Spieler hat es je geschafft "
    "dort hochzukommen. ");

  AddDetail( ({ "spieler" }),
    "Du solltest unbedingt Dusko danach fragen!");

  AddDetail( ({ "dusko" }),
    "Falls er nicht online ist, mail ihm einfach!");

  AddDetail( ({ "mail", "email", "mailen" }),
    "Dusko freut sich sicherlich!");




}
