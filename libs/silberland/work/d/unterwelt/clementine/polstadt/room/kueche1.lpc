  AddDetail( ({ "ecke" }),
    "In einer Ecke lehnt ein Besen, der ziemlich interessant aussieht. ");

  AddDetail( ({ "regale", "regal" }),
    "An den Waenden haengen einige Regale. Auf ihnen stehen einige Glaeser mit "
    "den verschiedensten Inhalten. ");



  AddDetail( ({ "muster" }),
    "Sieht aus wie Zeichen... Ob man sie lesen kann?");

  AddDetail( ({ "zeichen" }),
    "Versuch sie doch mal zu lesen!");

  AddReadDetail( ({ "zeichen" }),
    "\n"
    "H N I K A R\n"
    "\n");

  AddDetail( ({ "boden" }),
    "Der Boden sieht gepflegt und sauber aus. ");

  AddDetail( ({ "decke" }),
    "Eine ganz normale Decke befindet sich ueber Dir, und Du kannst "
