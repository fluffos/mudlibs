
inherit "std/room";

#include "../polstadt.h"

int anz_alk;
int anz_pudding;
int anz_schleim;

reset()
{
 ::reset();
 anz_alk = 1;
 anz_pudding = 3;
 anz_schleim = 1;
}

create()
{

  ::create();

  anz_schleim = 1;
  anz_pudding = 3;
  anz_alk = 1;
  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
