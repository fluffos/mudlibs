  AddSmell( ({ "essen" }),
    "Du bekommst Hunger!!! HUNGA HUNGA HUNGA!!! :)");

  AddSmell( ({ "gewuerze" }),
    "Das duftet hier alles herrlich!");


// SOUNDS

  AddSound(DEFAULT_SOUND, "Das Feuer in der Feuerstelle knackst noch ein "
