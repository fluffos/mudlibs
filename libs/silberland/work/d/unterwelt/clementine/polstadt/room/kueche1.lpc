  AddSound( ({ "feuerstelle", "feuer", "knacksen" }),
    "Das Feuer scheint wohl bald zu erlischen. ");


// COMMANDS


  AddCmd( ({ "koste", "kost" }), "c_kosten");
  AddCmd( ({ "trink", "trinke" }), "c_trinken");
  AddCmd( ({ "feg", "fege" }), "c_fegen");
  AddCmd( ({ "lass", "lasse" }), "c_lassen"); 

}

int c_kosten(string str)
{
 if( str != "glitschiges"      &&
     str != "schleim"          &&
     str != "kroetenschleim"   &&
     str != "beerenpudding"    &&
     str != "pudding"          &&
     str != "rotes"            &&
     str != "rotes mit kugeln" && 
     str != "bruehe"           &&
     str != "abwaschwasser"     )
 {
  notify_fail("Was moechtest Du denn kosten?\n");
  return 0;
 }
 if( str == "bruehe" && "abwaschwasser")
 {
  write(BS("Igitt! Brr! Das ist ja Abwaschwasser im dritten Kessel! *wuerg* "
    "*kotz* *brech*! Igitt!"));
  TP->AddHp(-10);
  say(CTPN + " verzieht angewidert das Gesicht.\n");
  return 1;
 }
 if( str == "schleim" && "kroetenschleim" && "glitschiges" )
 {
  if( anz_schleim < 1)
  {
   write(BS("Schade, da war wohl wer schneller..."));
   return 1;
  }
  else
  {
   write(BS("Hmm, das ist dann wohl der Kroetenschleim...So aufregend "
     "schmeckt das wirklich nicht...Dennoch stopfst Du Dir Deinen Bauch "
     "bis zum Anschlag voll!"));
   TP->heal_self(19);
   TP->SetProp(P_FOOD, TP->QueryProp(P_MAX_FOOD));
   say(CTPN + " kostet den Inhalt von Kessel zwei.\n");
   anz_schleim--;
   return 1;
  }
 }
 else
 {
  if( anz_pudding < 1)
  {
   write(BS("Seufz... Du kannst leider nichts mehr in dem Kessel erwischen. "
     "Dabei sah das so lecker aus... :("));
   say(CTPN + " kuckt traurig.\n");
   return 1;
  }
  else
  {
   write(BS("Boah! Der Beerenpudding ist lecker! Mhjam! Du solltest Dir "
    "unbedingt unten in der Kneipe einen bestellen!"));
   say(CTPN + " sabbert.\n");
   TP->heal_self(5);
   anz_pudding--; 
   return 1;
  }
 }
}


int c_trinken(string str)
{
 if(str != "aus rosaroter flasche")
 {
  notify_fail("Woraus moechtest Du trinken?\n");
  return 0;
 }
 else
 { 
  if(anz_alk < 1)
  { 
   write(BS("Mist da war wohl jemand schneller! Die Flasche ist schon leer!"));
   say(CTPN + " kuckt enttaeuscht.\n");
   return 1;
  }
  else  
  {
   write(BS("Du trinkst die ganze rosarote Flasche leer und fuehlst Dich mit "
     "einem Schlag besser und froehlicher. Mhmjam! Meeeeeeeeeeeehr!"));
   say(CTPN + " besaeuft sich heimlich, damit er Dich ertraegt.\n");
   TP->heal_self(100);
   TP->SetProp(P_ALCOHOL, TP->QueryProp(P_MAX_ALCOHOL));
   anz_alk--; 
   return 1;
  }  
 }
}


int c_fegen(string str)
{
 if( str != "mit besen" )
 {
  notify_fail("Womit moechtest Du fegen?\n");
  return 0;
 }
 else
 {
  write(BS("Du schnappst Dir den Besen und versuchst mit ihm ueber den "
    "Boden zu wischen. Mit einem gewaltigen Satz huepft er Dir "
    "aus der Hand! War wohl nichts ... :( "));
  say("Der Besen huepft herum!\n");
  return 1;
 }
}

int c_lassen(string str)
{
 if( str != "von gefuehl leiten" )
 {
  notify_fail("Wovon moechtest Du Dich leiten lassen?\n");
  return 0;
 }
 else
 {
  write(BS("Du vertraust auf Dein Gefuehl und laesst Dich von ihm leiten... "
    "Vor Deinem geistigen Auge erscheint ploetzlich eine rosarote Flasche.. "));
  say(CTPN+ " konzentriert sich.\n");
  return 1;
 }
}
  
