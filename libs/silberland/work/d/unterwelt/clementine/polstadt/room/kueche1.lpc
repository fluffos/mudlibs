  AddDetail( ({ "lust" }),
    "Keine vorhanden!");

  AddDetail( ({ "kochen" }),
    "Man verwendet hier wohl viele Kraeuter zum Kochen. Schmeckt sicher "
    "total lecker. ");
 
  AddDetail( ({ "inhalt", "inhalte" }),
    "Viele verschiedene Kraeuter, Gewuerze, ... befinden sich in den "
