  AddDetail( ({ "sonderbares" }),
    "Nichts, was _Du_ hier erkennen koenntest..."); 

  AddDetail( ({ "ende" }),
    "Denk mit...");

  AddDetail( ({ "gast" }),
    "Du bist Gast in diesem Haus, deswegen verhalte Dich bitte auch so...");

  AddDetail( ({ "haus" }),
    "Grmpf!");

  AddDetail( ({ "kessel" }),
    "Hier befinden sich drei grosse Kessel. In jedem von ihnen scheint "
