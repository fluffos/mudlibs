  AddDetail( ({ "kessel eins", "kessel 1" }),
    "Scheint irgendetwas Rotes mit Kugeln zu sein....");

  AddDetail( ({ "rotes", "kugeln" }),
    "Ob das Beerenpudding ist?!");

  AddDetail( ({ "beerenpudding", "pudding" }),
    "Sieht auf jeden Fall lecker aus!");

  AddDetail( ({ "kessel zwei", "kessel 2" }),
    "Im zweiten Kessel scheint etwas sehr Glitschiges drinnen zu sein. ");

  AddDetail( ({ "glitschiges" }),
    "Du kannst es gerne kosten!");

  AddDetail( ({ "kessel drei", "kessel 3" }),
    "Sieht aus wie ne braune Bruehe... ");
  
  AddDetail( ({ "bruehe" }),
    "Hmm... sieht nicht unbedingt sehr lecker aus...");

  AddDetail( ({ "essen", "rest" }),
    "Paar Reste Essen scheinen sich noch in den Kesseln zu befinden. "); 


// SMELLS

  AddSmell(DEFAULT_SMELL, "Irgendwie riecht es hier ueberall lecker nach "
