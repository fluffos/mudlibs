
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
	  "Kleine Irrlichter brennen rechts und links am Weg, und wirken "
	  "wie kleine Sternchen. Im Norden steht ein Haus, das wohl "
	  "schon lange nicht mehr bewohnt wird. Anders als die meisten Huetten "
	  "in Polaris wurde es nicht aus Holz, sondern Stein erbaut. "
	  "Mittlerweile ist dieser allerdings fast vollkommen mit Efeu "
	  "ueberwuchert. Die Fenster des Haeuschens sind mit Brettern vernagelt "
	  "worden. Gewiss gab es hier auch einmal eine Holztuer, "
	  "zumindest deuten noch ein paar verrostete Scharniere darauf hin. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "norden", ROOM "room_e7" );
  AddExit( "osten", ROOM "room_f8" );
  AddExit( "westen", ROOM "room_f6" );

}

