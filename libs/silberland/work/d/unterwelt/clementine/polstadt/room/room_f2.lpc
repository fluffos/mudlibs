inherit "std/laden";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include "../polstadt.h"


int anz_geld;

reset()
{
 ::reset();
 anz_geld = 1;
}

create()
{

::create();

  anz_geld = 1;
  SetProp(P_INT_SHORT, "In einem Laden");
  SetProp(P_INT_LONG, 
    "Du stehst in einem kleinen Laden mitten in Polaris, der durch einige "
    "Kerzen an der Decke erhellt wird. Die Waende sind "
    "bis oben hin mit Regalen zugestellt, in denen sich Waren verschiedenster "
    "Art befinden. Ein grosser Ladentisch steht an der Rueckwand, "
    "auf dem Blaithin wohl alle moeglichen Geschaefte zu taetigen scheint. "
    "Direkt neben dem Eingang haengt ein grosses Schild. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  
  AddExit( "osten", ROOM "room_f3" );

  AddItem(NPC "blaithin", REFRESH_DESTRUCT);

  NewDoor( "osten", ROOM "room_f3", ({ "tuer", "tuere", "birkentuer" }),
     ({ DOOR_OPEN,
        DOOR_RESET_OP,
        D_NAME, "Birkentuer",
        D_GENDER, FEMALE,
        D_SHORT, "Im Osten befindet sich eine %se Birkentuer.",
        D_LONG, "Eine alte Birkentuer, die wenn der Wind geht "
                "leise knirscht. "
                "Man kann sie mit Hilfe eines "
                "Riegels oeffnen und wieder schliessen. ",
        D_MSGS, ({ "hinaus", "geht wieder", "kommt an" }),
        D_OPENMSG, ({ "Mit lautem Knarren schiebst Du den Riegel beiseite "
                      "und die Tuer oeffnet sich. ",
                      "Mit lautem Knaaren schiebt %s den Riegel beiseite.",
                      " wird mit lautem Knarren von aussen geoeffnet." }),
        D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du die Tuer.",
                       "Mit einem lauten Rumms schliesst %s die Tuer.",
                       " wird mit lautem Knarren von aussen geschlossen." }),
        D_RESET_OPENMSG, " wird durch einen Windstoss geoeffnet. " }) );


  
// DETAILBEGINN


  AddDetail( ({ "huette", "haus", "raum", "laden" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "schild" }),
    "Direkt neben dem Eingang haengt ein grosses Schild. Du kannst "
    "es sicherlich lesen. ");

  AddReadDetail( ({ "schild" }),
    "\n"
    "+---------------------------------------------+\n"
    "|                                             |\n"
    "|    WILLKOMMEN IN MEINEM HUEBSCHEN LADEN!    |\n"
    "|                                             |\n"
    "|    Was es hier alles gibt siehst Du mit     |\n"
    "|            folgenden Befehlen:              |\n"
    "|                                             |\n"
    "|    * zeige                                  |\n"
    "|    * zeige rue(stungen)                     |\n"
    "|    * zeige waf(fen)                         |\n"
    "|    * zeige ver(schiedenes)                  |\n"
    "|                                             |\n"
    "|    * kaufe    <gegenstand> bzw. <nummer>    |\n"
    "|    * verkaufe <gegenstand> bzw. alles       |\n"
    "|    * schaetz  <gegenstand>                  |\n"
    "|                                             |\n"
    "+---------------------------------------------+\n"
    "\n"); 

  AddDetail( ({ "waren" }),
    "Die Waren kannst Du Dir alle mit dem Befehl <zeige> ansehen. ");

  AddDetail( ({ "befehl" }),
    "Tipp einfach: 'zeige'. ");

  AddDetail( ({ "art" }),
    "Ganz viele unterschiedliche Waren befinden sich in den Regalen, und "
    "warten darauf von Dir gekauft zu werden. ");

  AddDetail( ({ "ladentisch", "tisch" }),
    "Ein grosser Ladentisch steht an der Rueckwand. Seine Oberflaeche hat "
    "schon einige Kratzer und Risse. ");

  AddDetail( ({ "kratzer", "risse" }),
    "Die Kratzer und Risse scheinen wohl vom regen Handel zu stammen. ");

  AddDetail( ({ "handel" }),
    "Hier wird mit allen moeglichen Dingen gehandelt. Blaithin scheint eine "
    "gute Geschaeftsfrau zu sein. ");

  AddDetail( ({ "blaithin" }),
    "Falls sie gerade nicht hier ist, goennt sie sich eine wohl verdiente "
    "Pause. ");

  AddDetail( ({ "pause" }),
    "Wer so hart wie Blaithin arbeitet, der darf auch mal eine Pause "
    "einlegen. ");

  AddDetail( ({ "geschaeftsfrau", "frau" }),
    "Damit ist Blaithin gemeint. ");

  AddDetail( ({ "dinge", "ding" }),
    "Sieh Dir doch mal naeher die Regale an, dann siehst Du auch, was es "
    "hier zu kaufen gibt. ");

  AddDetail( ({ "eingang" }),
    "Durch die Birkentuer beim Eingang bist Du in diesen Laden gekommen. "
    "Ausserdem haengt daneben ein grosses Schild, welches Du vielleicht "
    "einmal studieren solltest. ");

  AddDetail( ({ "ausgang" }),
    "Der Eingang ist zugleich natuerlich auch der Ausgang. ");

  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche des langen Ladentisches sieht schon etwas aelter aus. "
    "Sie hat schon einige Kratzer und Risse. Auch eine Kassa kannst Du "
    "darauf erkennen. ");

  AddDetail( ({ "kassa" }),
    "Eine alte Kassa aus Eisen steht auf dem Ladentisch. Sie hat einige Tasten "
    "mit Nummern drauf und einen kleinen Hebel seitlich. ");

  AddDetail( ({ "tasten" }),
    "\n"
    " ___  ___  ___ \n"
    "| 1 || 2 || 3 |\n"
    "|___||___||___|\n"
    " ___  ___  ___ \n"
    "| 4 || 5 || 6 |\n"
    "|___||___||___|\n"
    " ___  ___  ___ \n"
    "| 7 || 8 || 9 |\n"
    "|___||___||___|\n"
    " ___  ___  ___ \n"
    "| 0 || E || L |\n"
    "|___||___||___|\n"
    "\n");

// druecken der tasten
// hebel ziehen kling kling lade auf wenn blai ned da geld

  AddDetail( ({ "e", "eingabe" }),
    "Der Buchstabe E auf den Tasten bedeutet Eingabe. ");

  AddDetail( ({ "l", "loeschen" "l-taste" }),
    "Mit der L-Taste kann man wohl loeschen. ");

  AddDetail( ({ "taste" }),
    "Drueck doch mal eine!");

  AddDetail( ({ "polaris" }),
    "Du stehst mitten in einem Laden in Polaris. ");

  AddDetail( ({ "kerzen", "kerze" }),
    "Die Kerzen die in einem Leuchter an der Decke brennen erhellen den "
    "ganzen Raum und huellen ihn in ein angenehm gedaempftes Licht. ");

  AddDetail( ({ "licht" }),
    "Die Kerzen schaffen ein angenehm gedaempftes Licht im ganzen Laden. ");

  AddDetail( ({ "leuchter" }),
    "Ein Leuchter haengt an der Decke - in ihm befinden sich weisse "
    "Kerzen aus gut riechendem Wachs. ");

  AddDetail( ({ "wachs" }),
    "Das Wachs der Kerzen ist weiss und riecht irgendwie sehr gut. ");
      
  AddDetail( ({ "maigloeckchen" }),
    "Du kannst hier keine entdecken, aber irgendwie erinnert Dich das Wachs "
    "der Kerzen an sie. ");

  AddDetail( ({ "hilfe", "riegel" }),
    "Mit Hilfe des Riegels kann man die Tuer auf- und zumachen. ");

  AddDetail( ({ "buchstabe", "buchstaben" }),
    "Welchen Buchstaben meinst Du denn?");

  AddDetail( ({ "waende", "wand", "rueckwand" }),
    "Die Waende des Ladens wurden in einem zarten Rosa gestrichen. "
    "Einerseits wirkt es etwas kitschig, aber andererseits fuehlst Du Dich "
    "in diesem 'Rosa' ziemlich wohl. ");

  AddDetail( ({ "rosa" }),
    "Die Waende wurden in einem zarten Rosa gestrichen, und Du kommst Dir vor "
    "wie in einem kitschigen Liebesfilm. ");

  AddDetail( ({ "liebesfilm", "film" }),
    "Irgendjemand hat Dir mal erzaehlt, dass es in Liebesfilmen immer so "
    "ein kitschiges Rosa gibt - selbst ansehen tust Du Dir solche Filme ja "
    "nicht! Oder etwa doch?! :)");

  AddDetail( ({ "filme", "liebesfilme"  }),
    "Die Filme sind zwar immer sehr schnulzig, aber irgendwie gefallen sie "
    "Dir doch etwas - zumindest ein ganz kleines bisserl!");

  AddDetail( ({ "geschaefte", "geschaeft" }),
    "Blaithin kauft und verkauft hier Waren unterschiedlichster Art. ");

  AddDetail( ({ "eisen" }),
    "Die Kassa auf dem Ladentisch besteht aus Eisen. ");

  AddDetail( ({ "nummer", "nummern" }),
    "Kuck Dir doch einmal die Tasten naeher an, dann siehst Du auch, dass "
    "die Nummern auf ihnen von 0 - 9 gehen. ");

  AddDetail( ({ "hebel" }),
    "Der Hebel seitlich der Kassa sieht so aus, als koennte man ihn ziehen. ");

  AddDetail( ({ "decke" }),
    "Die Decke ist ebenfalls in rosa gehalten. Ein Leuchter haengt von ihr "
    "herunter und erhellt den Raum. ");

  AddDetail( ({ "boden", "holzboden" }),
    "Ueber den dunklen Holzboden unter Dir sind bestimmt schon viele "
    "Abenteurer gegangen. Obwohl er sicherlich taeglich gekehrt wird, sieht "
    "er ziemlich schmutzig aus. ");

  AddDetail( ({ "holz" }),
    "Das Holz ist ziemlich dunkel, und befindet sich unter Dir :)");

  AddDetail( ({ "abenteurer" }),
    "Sicher sind schon viele ueber diesen Boden gegangen. Vielleicht hat "
    "jemand hier sogar seine Initialen hinterlassen?");

  AddDetail( ({ "initialen" }),
    "Angestrengt suchst Du den ganzen Boden nach Initialen ab. Tatsaechlich! "
    "Irgendwer hat ihr etwas in den Boden eingeritzt. Sieht aus wie ein "
    "Schriftzug!");

  AddDetail( ({ "schriftzug" }),
    "Lies dochmal!");

  AddReadDetail( ({ "schriftzug" }),
    "Du liest: Ausse mim Feidl und de Weiber! (c) Hihi");
 

// hinterlasse initialen -> eins auf die finger
// katzenkorb regale! hinweise marisol!


// SMELLS

  AddSmell( ({ "kerzen", "kerze", "wachs" }),
    "Das Wachs der Kerzen riecht irgendwie ganz besonders und erinnert "
    "Dich an Maigloeckchen. ");

  AddSmell( ({ "maigloeckchen" }),
    "Du kannst hier zwar keine Maigloeckchen erkennen, aber das Wachs "
    "der Kerzen duftet irgendwie genauso. ");


// SOUNDS

  AddSound( ({ "wind" }),
    "Der Wind laesst die Tuer manchmal leise knirschen. ");
 


  AddCmd( ({ "zieh", "ziehe" }), "c_ziehen");
 

}


int c_ziehen(string str)
{
 object ob;
 if( str != "hebel" )
 {
  notify_fail("Was moechtest Du ziehen?\n");
  return 0;
 }
 else
 {
  if(present("blaithin"))
  {
   write(BS("Aber die Besitzerin des Laden ist doch da! Da kannst Du doch "
            "nicht so einfach an ihre Kassa gehen!"));
   return 1;
  }
  if(anz_geld < 1)
  {
   write(BS("Du ziehst den Hebel und hoerst auf einmal ein lautes >KLING<. "
            "Die Lade der Kassa springt auf, und der Hebel schellt wieder "
            "zurueck. Schade! Da ist ja gar kein Geld drinnen! Enttaeuscht "
            "schliesst Du die Lade wieder. "));
   say(CTPN + " zieht an einem Hebel und kuckt danach enttaeuscht.\n");
   return 1;
  }
  else  
  {
   write(BS("Du ziehst den Hebel und hoerst auf einmal ein lautes >KLING<. "
            "Die Lade der Kassa springt auf, und der Hebel schellt wieder "
            "zurueck. Schnell nimmst Du alle Muenzen heraus, und schliesst "
            "danach sorgfaeltig die Lade. "));
   say(CTPN + " zieht an einem Hebel und steckt heimlich etwas ein.\n");
   TP->AddMoney(1034);
   anz_geld--;
   return 1;
  }
 }
}

 
     


  


