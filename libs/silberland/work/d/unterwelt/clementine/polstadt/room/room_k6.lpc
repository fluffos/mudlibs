
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG,
     "Im Westen kannst Du deutlich eine Holzhuette erkennen, vor der sich "
     "ein Dir voellig unbekanntes Gewaechs hochrankt. Die Tuer "
     "steht einen kleinen Spalt offen, und laedt freundlich zum Betreten ein. "
     "Anders als in dem restlichen Teil der Stadt lassen sich hier keine "
     "Irrlichter finden, nur ein schwacher Lichtstrahl aus dem Inneren der "
     "Huette projeziert so manche Lichtspiele auf den Boden. Noerdlich fuehrt "
     "der Weg zurueck in bewohntere Gefilde. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "westen", ROOM "room_k5" );
  AddExit( "nordwesten", ROOM "room_j5" );

}

