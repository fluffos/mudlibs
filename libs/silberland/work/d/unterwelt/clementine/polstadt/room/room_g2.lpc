
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
    "Du befindest Dich mitten in Polaris. Rechts und links des lehmigen "
    "Pfades kannst Du kleine Irrlichter erkennen, die alles in einem "
    "sanften Licht erstrahlen lassen. Nach Osten und Sueden fuehren "
    "Dich verzweigte Wege tiefer in die Stadt hinein. Eine bereits etwas "
    "verfallene Huette, aus der ein wenig Rauch aufzusteigen scheint, "
    "befindet sich westlich von Dir. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "westen", ROOM "room_g1" );
  AddExit( "osten", ROOM "room_g3" );
  AddExit( "sueden", ROOM "room_h2" );

  NewDoor( "westen", ROOM "room_g1", ({ "tuer", "tuere", "birkentuer" }),
      ({ DOOR_CLOSED,
         DOOR_RESET_CL,
         D_NAME, "Tuer",
         D_GENDER, FEMALE,
         D_SHORT, "Im Westen befindet sich eine %se Tuer.",
         D_LONG, "Eine alte morsche Tuer, die wenn der Wind geht "
                 "leise knirscht. "
                 "Man kann sie mit Hilfe eines "
                 "Riegels oeffnen und wieder schliessen. ",
         D_MSGS, ({ "in die Huette", "geht", "steht ploetzlich vor Dir" }),
         D_OPENMSG, ({ "Mit lautem Knarren schiebst Du den Riegel beiseite "
                       "und die Tuer oeffnet sich. ",
                       "Mit lautem Knaaren schiebt %s den Riegel beiseite.",
                       " wird mit lautem Knarren geoeffnet." }),
         D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du die Tuer.",
                        "Mit einem lauten Rumms schliesst %s die Tuer.",
                        " wird mit lautem Knarren geschlossen." }),
         D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen. " }) );



}

