// HYMIRS Huette 


inherit "std/room";

#include "../polstadt.h"


int anz_keks;

reset()
{
 ::reset();
 anz_keks = 1;
}


create()
{

  ::create();

  anz_keks = 1;
  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG,
    "Die Huette scheint von innen gar nicht so verfallen, wie Du anfangs "
    "dachtest. Es ist die Behausung von Hymir, die wie fuer einen Einsiedler "
    "ueblich, ziemlich spaerlich eingerichtet wurde. Bett in der einen Ecke, "
    "Tisch mit Stuhl in der anderen. An einer der Waende haengt ein Regal, "
    "in dem sich einige Flaeschchen und unzaehlige kleine Doeschen befinden. "
    "Ein kleines Feuer aus trockenen Aesten lodert in der Mitte des Raumes "
    "vor sich hin. "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "nordosten", ROOM "room_i3" );

  NewDoor( "nordosten", ROOM "room_i3", ({ "tuer", "tuere", "birkentuer" }),
      ({ D_FLAGS | DOOR_CLOSED,
         DOOR_RESET_CL,
         D_NAME, "Tuer",
         D_GENDER, FEMALE,
         D_SHORT, "Die alte morsche Tuer der Huette ist %s. ",
         D_LONG, "Eine alte morsche Tuer, die wenn der Wind geht "
                 "leise knirscht. "
                 "Man kann sie oeffnen und sogar schliessen! ",
         D_MSGS, ({ "in die Huette", "geht", "steht ploetzlich vor Dir" }),
         D_OPENMSG, ({ "Mit lautem Knarren schiebst Du den Riegel beiseite "
                       "und die Tuer oeffnet sich. ",
                       "Mit lautem Knaaren schiebt %s den Riegel beiseite.",
                       " wird mit lautem Knarren geoeffnet." }),
         D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du die Tuer.",
                        "Mit einem lauten Rumms schliesst %s die Tuer.",
                        " wird mit lautem Knarren geschlossen." }),
         D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen. " }) );



// DETAILBEGINN

  AddDetail( ({ "hymir", "bewohner", "einsiedler" }),
    "Hymir ist so ein richtiger, grimmiger, alter Einsiedler, der "
    "normalerweise nicht sehr erfreut ueber unangemeldeten Besuch ist. "
    "Momentan scheint er allerdings gar nicht hier zu sein, sodass Du "
    "etwas Zeit hast, Dich hier umzusehen. ");

  AddDetail( ({ "zeit" }),
    "Du hast etwas Zeit Dir Hymirs Behausung anzusehen. ");

  AddDetail( ({ "behausung", "haus", "raum", "huette" }),
    QueryProp(P_INT_LONG) );

  AddDetail( ({ "bett" }),
    "Ein einfaches Bett aus Holz steht in der Ecke. In ihm liegt eine "
    "Wolldecke. ");

  AddDetail( ({ "wolldecke" }),
    "Die Wolldecke ist ein wenig kratzig, doch das scheint Hymir wohl nicht "
    "zu stoeren. "); 

  AddDetail( ({ "decke" }),
    "Die Decke besteht aus einfachen Holzbalken. Oder meinst Du etwa "
    "die Wolldecke?");

  AddDetail( ({ "holzbalken", "balken" }),
    "Die Decke besteht aus ganz normalen Holzbalken. Sie sind fein "
    "saeuberlich aneinander gereiht worden. ");

  AddDetail( ({ "ecke" }),
    "Hier gibt es sogar mehrere Ecken!");

  AddDetail( ({ "ecken" }),
    "Es gibt hier vier Ecken. Toll, nicht wahr?!");

  AddDetail( ({ "besuch" }),
    "Besuch ist hier nicht wirklich gerne gesehen, da aber der Herr des "
    "Hauses ohnehin gerade nicht da ist, kannst Du Dich ruhig etwas "
    "umsehen. ");

  AddDetail( ({ "herr" }),
    "Hymir!");

  AddDetail( ({ "tisch" }),
    "Ein einfacher Tisch. Absolut schmucklos. Nicht einmal ein "
    "Broeserl kannst Du erkennen. ");

  AddDetail( ({ "broeserl" }),
    "Es ist keines zu sehen. Ob Hymir immer auswaerts isst? Anders kannst "
    "Du Dir diese Sauberkeit nicht erklaeren. ");

  AddDetail( ({ "sauberkeit" }),
    "Hier ist es fast klinisch rein. Hymir scheint penibelst auf die "
    "Reinheit seiner Huette zu achten. ");

  AddDetail( ({ "reinheit" }),
    "Die scheint Hymir am Herzen zu liegen. ");

  AddDetail( ({ "herzen" }),
    "Hymir ist es anscheinend sehr wichtig, wenn es sauber und schoen rein "
    "ist. ");

  AddDetail( ({ "stuhl", "sessel" }),
    "Ein ganz einfacher, aus Holz gezimmerter Stuhl. Er sieht ziemlich "
    "schlicht aus, ohne jeglichen Schnickschnack. Ob der bequem ist? Probiers "
    "einfach mal aus!");

  AddDetail( ({ "schnickschnack" }),
    "Nichts in der Art zu sehen. ");

  AddDetail( ({ "art" }),
    "Du gehoerst der Art Dodl mit der Rodl an, wenn Du sowas untersuchst. ");

  AddDetail( ({ "dodl", "rodl" }),
    "DU!");

  AddDetail( ({ "holz" }),
    "Hier ist fast alles aus Holz!");

  AddDetail( ({ "wind" }),
    "Mometan ist er nicht zu spueren. ");

  AddDetail( ({ "boden" }),
    "Anders als die Decke und die Waende besteht der Boden einfach aus fester "
    "Erde. In der Mitte brennt ein kleines Feuer, dass sich von ein paar "
    "trockenen Aesten naehrt. ");

  AddDetail( ({ "aeste" }),
    "Ein paar Aeste liegen in der Feuerstelle und brennen. ");

  AddDetail( ({ "erde" }),
    "Der Boden besteht aus Erde - sie ist natuerlich ganz fest, sodass "
    "man nicht einsinken kann. ");

  AddDetail( ({ "mitte" }),
    "----------> . <---------- Der Punkt ist genau in der Mitte :)");

  AddDetail( ({ "punkt" }),
    ".");

  AddDetail( ({ "regal" }),
    "Ein Holzbrett, dass an der Wand angebracht wurde, "
    "dient dem Besitzer als Regal. Auf ihm befinden sich ein paar "
    "Flaeschchen sowie einige Doeschen. ");

  AddDetail( ({ "flasche", "flaeschchen", "flaschen" }),
    "Ein paar Flaeschchen stehen auf dem Regal. Was da wohl drinnen ist? ");

  AddDetail( ({ "doeschen", "dosen" }),
    "Zwischen all den bunten Doeschen sticht eines besonders hervor, da es "
    "keinen Deckel hat. ");

  AddDetail( ({ "deckel" }),
    "Keiner da. ");

  AddDetail( ({ "dose" }),
    "Hmm, die Dose ist offen. Zumindest hat sie keinen Deckel mehr. "
    "Vielleicht kannst Du hineinkucken?!"); 

  AddDetail( ({ "keksdose", "kekse", "kekserl", "keks" }),
    "Mhmm, lecker! Nimm doch mal ein Kekserl!");  

  AddDetail( ({ "feuer" }),
    "In der Mitte der Huette brennt ein kleines Feuer. ");

  AddDetail( ({ "stelle", "feuerstelle" }),
    "Sie befindet sich in der Mitte des Raumes. Einige Aeste liegen in ihr "
    "und brennen. ");

  AddDetail( ({ "rauch", "qualm" }),
    "Eigentlich muesste ein Feuer in einer Huette ja ziemlich rauchen und "
    "qualmen, aber irgendwie scheint das hier anders zu sein. ");

  AddDetail( ({ "holzbrett", "brett" }),
    "Das Regal ist eigentlich nur ein simples Brett, dass an der Wand "
    "montiert wurde. ");

  AddDetail( ({ "waende" }),
    "Die Waende sind schmucklos und leer; nur an einer kannst Du ein "
    "kleines Regal erkennen, auf dem einige Dinge stehen. ");

  AddDetail( ({ "dinge" }),
    "Sieh sie Dir doch einfach naeher an!");

  AddDetail( ({ "wand" }),
    "Abgesehn von einem Regal an der Wand ist alles hier absolut "
    "schmucklos. ");

  AddDetail( ({ "besitzer" }),
    "Er heisst Hymir. Zumindest stand das draussen an der Tuer. ");

  AddDetail( ({ "riegel" }),
    "Mit dem kann man die Tuer auf- und zumachen.");



//SMELLS

  AddSmell(DEFAULT_SMELL, "Es riecht hier leicht verbrannt. ");


// SOUNDS

  AddSound(DEFAULT_SOUND, "Die Aeste im Feuer knacksen leise. ");

  AddSound( ({ "aeste", "feuer" }),
    "*knacks* *knacks* ");

  AddSound( ({ "knacksen" }),
    "Das Knacksen knackst!");


// COMMANDS

  AddCmd( ({ "nimm", "nehm", "nehme" }), "c_nehmen");
  AddCmd( ({ "kuck", "kucke" }), "c_kucken");
  AddCmd( ({ "oeffne" }), "c_oeffnen");




}

int c_nehmen(string str)
{
 object ob;
 if(str != "keks aus dose"    &&
    str != "kekserl aus dose"  )
 {
  notify_fail("Was moechtest Du aus der Dose nehmen?\n");
  return 0;
 }
 else
 {
  if(anz_keks < 1)
  {
   write(BS("Och... :( Du kannst leider kein Kekserl erwischen. Vielleicht "
            "kommst Du spaeter noch einmal her."));
   say(CTPN + " kuckt ganz enttaeuscht.\n");
   return 1;   
  }
  else
  {
   write(BS("Du langst mit Deiner Hand in die Dose und fischt ein schoenes "
            "rundes Kekserl raus."));
   say(CTPN+ " fummelt in einer Dose herum.\n");
   ob = clone_object(OBJ "keks");
   if(ob->move(TP, M_GET) != 1)
   {
    tell_object(TP, "Das kannst Du nicht mehr tragen!\n");
    ob->move(TO, M_NOCHECK);
   }
   anz_keks--;
   return 1;
  }
 }
}

int c_kucken(string str)
{
 if(str != "in dose hinein"    &&
    str != "in keksdose"       &&
    str != "in dose"           &&
    str != "in keksdose hinein" )
 {
  notify_fail("Wo moechtest Du hineinkucken?\n");
  return 0;
 }
 else
 {
  write(BS("Ooooooooooh! Da sind ja Kekse drinnen!!! Mhmm!!!"));
  say(CTPN + " freut sich.\n");
  return 1;
 }
}

int c_oeffnen(string str)
{
 if(str != "flaeschchen"  &&
    str != "flasche"      &&
    str != "flaschen"     )
 {
  notify_fail("Was moechtest Du oeffnen?\n");
  return 0;
 }
 else
 {
  write(BS("Du oeffnest eines der Flaeschchen und riechst daran! Igitt! "
           "Das stinkt nach verfaultem Rattenblut!!! *wuerg* Schnell machst "
           "Du die Flasche wieder zu."));
  say("Igitt, es stinkt auf einmal ekelhaft!\n");
  return 1;
 }
}


