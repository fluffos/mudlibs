
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
     "Kleine Irrlichter leiten Dich auf dem lehmigen Weg durch diese "
     "geheimnisvolle Stadt. Weit und breit ist kein einziger Bewohner in "
     "Sicht. Nur aus der Kneipe im Westen kannst Du vereinzelnd einige "
     "Stimmen sowie Glaeserklirren vernehmen. "
     "Noerdlich von Dir ragt ein grosser Felsbrocken in die Hoehe, der "
     "ein Durchkommen an dieser Stelle des Weges absolut unmoeglich macht. "
     "Weiter suedlich meinst Du die Umrisse einer weiteren Huette erkennen "
     "zu koennen. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "westen", ROOM "room_j4" );
  AddExit( "suedosten", ROOM "room_k6" );

}

