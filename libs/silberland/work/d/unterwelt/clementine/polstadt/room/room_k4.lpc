inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG,
    "Ueberall am Boden stehen zahlreiche Kerzen, die Dich sanft in ihr Licht "
    "einhuellen, An den Waenden befinden sich seltsame Zeichen, die wohl nur "
    "fuer die Besitzerin Bedeutung zu haben scheinen. Ein kunstvoll "
    "gefertigter Tisch mit feinst eingearbeiteten Ornamenten nimmt "
    "die Mitte des Raumes in seinen Besitz. Auf ihm befindet sich eine kleine "
    "Raeucherschale, von der ein aeusserst angenehmer Duft ausgeht. "  
    "Durch den Spiegel im Westen scheinst Du wieder zu Valkyrja "
    "zurueckzukommen. "); 
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "westen", ROOM "room_k3" ); // versteckt (spiegel)
  SetProp(P_HIDE_EXITS, ({ "westen" }) );

// DETAILBEGINN

  AddDetail( ({ "tafel" }),
