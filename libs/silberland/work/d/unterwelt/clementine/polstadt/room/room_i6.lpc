
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, "Polaris Stadt");
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "osten", ROOM "room_i7" );
  AddExit( "nordwesten", ROOM "room_h5" );

  SetProp(P_HIDE_EXITS, ({ "nordwesten" }) );
}

