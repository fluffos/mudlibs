
// SCHULE
 
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
    "Gleich beim Hereinkommen faellt Dir die grosse dunkle Steintafel an der "
	"Ostwand auf. Davor steht ein grosser Schreibtisch, auf dem sich einige "
	"Heftchen sowie ein paar Kreidestuecke tuermen. "
	"Ausserdem siehst Du einige kleinere Tischchen, mit dazugehoerenden "
	"Baenken. Sie bieten jeweils Platz fuer zwei Kinder. Gleich neben "
	"dem Eingang haengt eine metallerne Glocke, mit einem Strick dran. "
	"Anscheinend ist das hier die Schule von Polaris. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "norden", ROOM "room_i7" );
  //  AddExit( "osten", ROOM "room_j8" ); versteckt hinter tafel klettern


  AddCmd( ({ "zwaeng", "zwaenge" }), "c_zwaengen");
  
}

int c_zwaengen(string str)
{
  if( str != "hinter tafel" )
  {
	notify_fail("Nanu? Wohin willst Du denn?\n");
	return 0;
  }
  else
  {
	write(BS("Du zwaengst Dich hinter die Tafel, und stehst ploetzlich "
		  "ganz woanders!"));
	this_player()->move(ROOM "room_j8", M_GO,
		"einfach", "verschwindet", "ist ploetzlich da");
	return 1;
  }
}

	
