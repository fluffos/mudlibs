//x


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


void create()
{

::create();

  SetProp(P_INT_SHORT, "In einer Huette");
  SetProp(P_INT_LONG, 
    "Du stehst in einer kleinen Huette, die nur spaerlich eingerichtet "
    "wurde. Die Bretter, aus denen der Boden besteht, scheinen schon "
    "ziemlich alt zu sein. Auch die Waende sehen nicht so aus, als wuerden "
    "sie noch laenger bestehen koennen. "
    "In der Mitte des Raumes steht ein kleiner Tisch samt Stuhl, "
    "rechterhand kannst Du ein Bett erkennen. An der Nordwand lodert ein "
    "kleines Feuer, ueber dem ein alter Kessel aus Eisen baumelt. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddExit( "osten", ROOM "room_g2" );
  
  NewDoor( "osten", ROOM "room_g2", ({ "tuer", "tuere", "birkentuer" }),
     ({ DOOR_CLOSED,
        DOOR_RESET_CL,
        D_NAME, "Tuer",
        D_GENDER, FEMALE,
        D_SHORT, "Im Osten befindet sich eine %se morsche Tuer.",
        D_LONG, "Eine alte morsche Tuer, die wenn der Wind geht "
                "leise knirscht. "
                "Man kann sie mit Hilfe eines "
                "Riegels oeffnen und wieder schliessen. ",
        D_MSGS, ({ "hinaus", "geht", "steht ploetzlich vor Dir" }),
        D_OPENMSG, ({ "Mit lautem Knarren schiebst Du den Riegel beiseite "
                      "und die Tuer oeffnet sich. ",
                      "Mit lautem Knaaren schiebt %s den Riegel beiseite.",
                      " wird mit lautem Knarren von aussen geoeffnet." }),
        D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du die Tuer.",
                       "Mit einem lauten Rumms schliesst %s die Tuer.",
                       " wird mit lautem Knarren von aussen geschlossen." }),
        D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen. " }) );


// DETAILBEGINN

  AddDetail( ({ "huette" }),
    "Die Huette ist nur spaerlich eingerichtet. Ein Bett, ein Tisch und "
    "daneben ein Sessel. Ein kleines Feuerchen lodert an der Nordwand. ");

  AddDetail( ({ "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "bett" }),
    "Das Bett sieht auf den ersten Blick nicht unbedingt sooooooooo "
    "kuschelig aus, aber ist sicherlich auch nicht allzu unbequem. "
    "An seinem Kopfende liegt ein Polster, eine dicke Wolldecke wurde "
    "uebers Bett geschlagen. ");

  AddDetail( ({ "polster" }),
    "Der Polster ist nicht sehr gross, aber ein Kopf passt sicher "
    "genau drauf. ");

  AddDetail( ({ "kopf" }),
    "Der Kopf passt von der Groesse her sicherlich auf den Polster. ");
 
  AddDetail( ({ "groesse" }),
    "Es geht sich mit Sicherheit aus.");

  AddDetail( ({ "sicherheit" }),
    "Garantiert!");

  AddDetail( ({ "kopfende" }),
    "Am Kopfende des Bettes liegt ein Polster. ");

  AddDetail( ({ "ende" }),
    "Welches Ende meinst Du denn? Wovon das Ende? "
    "Falls Du nicht genau weisst, was Du meinst, solltest Du vielleicht auch "
    "mal 'ende' tippen. ");

  AddDetail( ({ "osten" }),
    "Dort ist die Tuer!");

  AddDetail( ({ "blick", "blicke" }),
    "Mit Blicken kann man oft nicht alles sofort erfassen. Aber mit "
    "Ausprobieren kommt man fast immer weiter. ");

  AddDetail( ({ "ausprobieren" }),
    "Du kannst Dich ja mal ins Bett legen! Dann weisst Du ob es "
    "ueberhaupt kuschelig ist, und wenn ja wie sehr :)");

  AddDetail( ({ "mitte" }),
    "Dort steht ein Tisch mit einem Sessel. ");

  AddDetail( ({ "sessel", "stuhl" }),
    "Ein einfacher Sessel aus Holz steht neben dem Tisch. Man kann sich "
    "(Du haettest es fast nicht erwartet) draufsetzen!");

  AddDetail( ({ "holz" }),
    "Ein bunter Mix verschiedener Holzarten befindet sich hier. Die einzige "
    "Art, die Du wirklich von den anderen unterscheiden kannst, ist Birke. ");
   
  AddDetail( ({ "birke" }),
    "Birke ist ein ziemlich helles Holz, deshalb sticht es Dir hier "
    "so ins Auge. ");
    
  AddDetail( ({ "auge", "aug" }),
    "Birkenholz sticht hier deutlich hervor. ");

  AddDetail( ({ "birkenholz" }),
    "Vielleicht sticht das Birkenholz nicht mehr hervor, als die anderen. "
    "Allerdings kannst Du dieses als einziges bestimmen. "); 

  AddDetail( ({ "wolldecke" }),
    "Die Wolldecke liegt zusammengefaltet ueber dem Bett. Der hiesige "
    "Bewohner scheint wohl ziemlich ordentlich zu sein. ");

  AddDetail( ({ "bewohner" }),
    "Leider ist er momentan nicht da. ");

  AddDetail( ({ "decke", "holzdecke" }),
    "Die Decke ueber Dir besteht aus Holz. Oder meinst Du etwa die Wolldecke?");
 
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus Brettern, die fein saeuberlich aneinander gelegt "
    "wurden, und dann sorgfaeltig vernagelt. ");

  AddDetail( ({ "bretter" }),
    "Die Bretter am Boden wurden fein saeuberlich verlegt, und dann vernagelt. "
    "Nirgends ist auch noch so eine kleine Unebenheit zu erkennen. ");

  AddDetail( ({ "unebenheit" }),
    "Es ist absolut keine zu sehen. Hier war jemand sehr sorgfaeltig bei der "
    "Arbeit. ");

  AddDetail( ({ "arbeit" }),
    "Wenn Du schon mal einen Boden verlegt haettest, dann wuerdest Du wissen, "
    "wieviel Arbeit sowas macht. Und ich spreche da aus Erfahrung! *aechz* ");

  AddDetail( ({ "erfahrung" }),
    "Schoen, dass Dir das bisher erspart blieb - mir leider nicht :) ");

  AddDetail( ({ "holzart", "art", "holzarten", "arten" }),
    "Hier gibt es die verschiedensten Holzarten - die einzig erkennbare "
    "bleibt fuer Dich allerdings die Birke ;)");

  AddDetail( ({ "riegel" }),
    "Damit geht die Tuer auf und zu!");

  AddDetail( ({ "mix" }),
    "Sieht ziemlich bunt aus, aber dennoch gemuetlich eingerichtet hier. ");

  AddDetail( ({ "hilfe" }),
    "Tipp mal: 'oeffne tuer' !");

  AddDetail( ({ "nordwand" }),
    "An der Nordwand lodert ein kleines Feuer. Ueber ihm baumelt ein "
    "Kessel. ");

  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen wie die restliche Huette auch, aus Holz. Die "
    "einzig wirklich interessante Wand ist die Nordwand. ");

  AddDetail( ({ "kessel" }),
    "Ein alter Kessel aus festem Eisen baumelt ueber dem Feuer. Darin "
    "blubbert eine seltsam aussehende Bruehe. ");

  AddDetail( ({ "bruehe" }),
    "Sie blubbert vor sich hin. Was das wohl ist? Vielleicht kannst Du "
    "sie ja kosten?!"); 

  AddDetail( ({ "eisen" }),
    "Der Kessel besteht aus schwarzem festen Eisen. ");

  AddDetail( ({ "feuer", "feuerchen" }),
    "Ein kleines Feuerchen lodert an der Nordwand. Der Boden wurde an dieser "
    "Stelle mit etwas Erde aufgeschuettet, damit das Holz des "
    "Bodens nicht Feuer faengt. Auf dieser Erde liegen einige Torfstuecke, "
    "die lustig vor sich hin kohlen. Darueber baumelt ein Kessel auf einem "
    "Gestell. ");

  AddDetail( ({ "gestell" }),
    "Daran baumelt der Kessel. ");
  
  AddDetail( ({ "wind" }),
    "Wind kann man hier nicht sehen!");

  AddDetail( ({ "stelle" }),
    "Eine Stelle am Boden wurde mit etwas Erde aufgeschuettet, damit die "
    "Holzbretter darunter kein Feuer fangen. ");

  AddDetail( ({ "holzbretter" }),
    "Die Holzbretter des Bodens scheinen schon alt zu sein, da sie leise "
    "knirschen wenn man drueber geht. ");

  AddDetail( ({ "erde" }),
    "Ganz normale Erde wurde hier aufgeschuettet, damit hier nichts "
    "abbrennt. ");

  AddDetail( ({ "stuecke", "torfstuecke", "torf" }),
    "Sie brennen lustig vor sich hin und erwaermen so den Inhalt des "
    "darueberbaumelnden Kessels. ");

  AddDetail( ({ "inhalt" }),
    "Der sieht zwar ziemlich seltsam aus, aber neugierig bist Du schon, "
    "was das sein koennte. ");

  AddDetail( ({ "tisch" }),
    "Der Tisch ist absolut leer. Nicht mal ein Staubkorn zu sehen. Wo der "
    "Bewohner wohl seine restlichen Sachen aufbewahrt? ");

  AddDetail( ({ "sachen" }),
    "Hier ist nichts zu sehen. Und wenn hier etwas waere, wuerde es wohl "
    "sehr gut versteckt sein, und somit fast unauffindbar. ");

  AddDetail( ({ "korn", "staubkorn", "staub" }),
    "Absolut nichts zu sehen. ");


    
  
// SOUNDS

  AddSound(DEFAULT_SOUND, "Wenn der Wind pfeift, hoerst Du manchmal die "
    "Tuer knarren. ");

  AddSound( ({ "knarren", "tuer" }),
    "Momentan knarrt rein gar nichts hier. ");

  AddSound( ({ "wind", "pfeifen" }),
    "Leider pfeift der Wind momentan nicht. ");

  AddSound( ({ "knirschen" }),
    "Du hoppst ein paar Schritte ueber den Boden, und vernimmst ein leises "
    "*knirsch* *knirsch* ");

  AddSound( ({ "schritte" }),
    "Die Schritte klingen ungefaehr so: PLUUUUUUUUUUUUUUUUUMPS!");

  AddSound( ({ "boden" }),
    "Er knirscht wenn man drueber geht. ");


// SMELLS

  AddSmell(DEFAULT_SMELL, "Irgendetwas riecht hier sehr lecker!");

  AddSmell( ({ "kessel", "geruch" }),
    "Der gute Geruch kommt vom Kessel!");

  AddSmell( ({ "bruehe", "inhalt" }),
    "Aussehen tut die Bruehe zwar nicht so gut, aber irgendwie riecht sie "
    "koestlich!"); 


  
   
  AddCmd( ({ "koste", "kost" }), "c_kosten");
  AddCmd( ({ "schiebe", "schieb", "verschieb", "verschiebe" }), "c_schieben");

}

int c_kosten(string str)
{
 if( str != "inhalt"   &&
     str != "bruehe"    )
 {
  notify_fail("Was moechtest Du kosten?\n");
  return 0;
 }
 else
 {
  write(BS("Du faehrst mit Deiner Hand in die Bruehe und verbrennst Dich dabei "
           "natuerlich tierisch. Nichts ist mit dem Kosten! Nur AUA AUA! "
           "Aber vielleicht gibts ja einen anderen Weg an die Bruehe "
           "ranzukommen?")); //noe gibt es nicht ich bin naemlich faul!//
  say(CTPN + " steckt seine Hand in die Bruehe und verzieht das Gesicht.\n");
  TP->do_damage(20+random(10), this_object());
  return 1;
 }
}

int c_schieben(string str)
{
 if(str != "tisch"          &&
    str != "tisch weg"      &&
    str != "tisch beiseite"  )
 {
  notify_fail("Was moechtest Du verschieben?\n");
  return 0;
 }
 else
 {
  write(BS("Du schiebst den Tisch beiseite, und ein Ausgang wird "
           "sichtbar. "));
  AddSpecialExit( "unten", "geheimfkt");
  return 1;
 }
}

int geheimfkt(string dir)
{
 RemoveExit("unten");
 write("Du gehst ueber eine Treppe nach unten.\n");
 TP->move(ROOM "geheim", M_GO,
          "ueber eine Treppe", "geht", "kommt herunter");
 say(BS("Wie von Geisterhand verschwindet der Ausgang, und der Tisch steht "
     "ploetzlich wieder genau in der Mitte. "));
 return 1;
}



