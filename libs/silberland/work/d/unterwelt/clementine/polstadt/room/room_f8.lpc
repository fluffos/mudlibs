
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
	  "Ein paar Baeume saeumen den erdigen Weg. Von ihren Aesten haengen "
	  "kleine Laternen, die Licht spenden. Am noerdlichen Wegrand liegt ein "
	  "grosser Felsbrocken, auf den etwas gemalt wurde. Nach Sueden fuehrt "
	  "der Pfad tiefer in die Stadt hinein, weiter oestlich scheint sich "
	  "ein kleiner Platz zu befinden, und in westlicher Richtung erweckt "
	  "ein verfallenes Haus Deine Neugier. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "westen", ROOM "room_f7" );
  AddExit( "osten", ROOM "room_f9" );
  AddExit( "sueden", ROOM "room_g8" );

}

