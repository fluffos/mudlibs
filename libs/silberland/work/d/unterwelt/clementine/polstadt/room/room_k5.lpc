  AddDetail( ({ "bretter", "holzbretter" }),
    "Die Decke besteht aus normalen Holzbrettern. ");

  AddDetail( ({ "loch" }),
    "Wo ist hier ein Loch?");

  AddDetail( ({ "astloch" }),
    "Ein Brett hat ein Astloch. Ob man da durchschauen kann?");
// durchschauen, nix sehen, zunge reinstecken?! ;) stecken bnleiben?

  AddDetail( ({ "brett" }),
    "Sieht sehr interessant aus.");

  AddDetail( ({ "baeume", "baum" }),
    "An den Waenden haengen Bilder von den verschiedensten Baeumen. "
