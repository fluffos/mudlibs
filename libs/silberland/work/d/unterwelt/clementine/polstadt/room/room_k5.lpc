int c_heben(string str)
{
 object ob;
 if(str != "polster auf" )
 {
  notify_fail("Was moechtest Du aufheben?\n");
  return 0;
 }
 else
 {
  if(anz_eis < 1)
  {
   write(BS("Du hebst den Polster auf und machst ein ziemlich enttaeuschtes "
            "Gesicht. Irgendwer hat Dir wohl das Eis vor der Nase "
            "weggeschnappt. *heul* Wuetend wirfst Du den Polster wieder ins "
            "Bett."));
   say(CTPN + " sieht ziemlich wuetend aus.\n");
   return 1;
  }
  else
  {
   write(BS("Du hebst den Polster auf und findest ein Eis darunter. Schnell "
            "steckst Du es ein und legst den Polster wieder sorgefaeltig aufs "
            "Bett."));
   say(CTPN + " macht sich am Bett zu schaffen.\n");
   ob = clone_object("/d/polar/thor/xandim/obj/jolly"); //eis!!!
   if(ob->move(TP, M_GET) != 1)
   {
    tell_object(TP, "Das kannst Du leider nicht mehr tragen!\n");
    ob->move(TO, M_NOCHECK);
   }
   anz_eis--;
   return 1;
  }
 }
}


string zungenfun(string str)
{
 TP->command_me("-allgemein meine zunge ist super gelenkig!");
 return "";
}
 

int c_drehen(string str)
{
 if( str != "kruemel um"   &&
     str != "kruemel"      &&
     str != "teil"         &&
     str != "teil um"      )
 {
  notify_fail("Was moechtest Du umdrehen?\n");
  return 0;
 }
 else
 {
  write(BS("Du drehst das seltsame schwarze Teil um... WUAAAAAAAAAAAAH!!! "
    "Das Ding hat Beine!!! Igitt!!! Ein Kaefer!!! Angewidert schuettelst Du "
    "Dich."));
  say(CTPN + " schuettelt sich ploetzlich wie ein Hampelmann auf Drogen.\n");
  return 1;
 }
}


int c_schliessen(string str)
{
  if(str != "tuer" &&
     str != "tuere"  )
  {
   notify_fail("Was moechtest Du schliessen?\n");
   return 0;
  }
  else
  {
   write(BS("Aber dann kommt doch niemand mehr herein! Die Tuer "
            "bleibt schoen offen!!!"));
   say(CTPN+ " ruettelt an der Tuer\n.");
   return 1;
  }
}



int c_oeffnen(string str)
{
	if(str != "kasten")
	{
		notify_fail("Was moechtest Du oeffnen?\n");
		return 0;
	}
	else
	{
		write(BS("Trotz Deiner Neugierde, weisst Du schlussendlich "
		"doch noch, was sich gehoert! Und fremde Kaesten sind "
		"nun mal tabu!"));
		return 1;
	}
}

int c_sitzen(string str)
{
	if(str != "auf sessel")
	{
		notify_fail("Worauf moechtest Du sitzen?\n");
		return 0;
	}
	else
	{
		write(BS("Du willst Dich gerade auf den Sessel setzen, als "
		"Dich Deine innere Stimme ganz ploetzlich davon abhaelt."));
		return 1;
	}
}

int c_probieren(string str)
{
	if(str != "zu sitzen" &&
	   str != "setzen"    &&
	   str != "hinsetzen"  )
	{
		notify_fail("Was moechtest Du probieren?\n");
		return 0;
	}
	else
	{
		write(BS("Setz Dich doch einfach!"));
		return 1;
	}
}

