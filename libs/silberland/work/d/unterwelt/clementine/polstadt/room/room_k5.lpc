  AddDetail( ({ "fenster" }),
    "Keines zu sehen, aber die Tuer steht ja sowieso offen. ");

  AddDetail( ({ "hexen", "hexe" }),
    "Hier in Polaris leben fast ausschliesslich Hexen. ");

  AddDetail( ({ "polaris" }),
    "Du stehst in einer Huette in Polaris. ");

  AddDetail( ({ "bezug" }),
    "Anamcara scheint wohl Baeume zu lieben. Aber am besten fragst Du sie "
    "selbst einfach danach. ");

  AddDetail( ({ "kasten" }),
    "Der Kasten sieht interessant aus. Oder bist Du vielleicht einfach nur "
    "sehr neugierig?!");



  AddDetail( ({ "sessel" }),
    "Also ob der Sessel ueberhaupt jemanden aushaelt wagst Du zu "
    "bezweifeln. Aber ausprobieren koennte man es ja einmal...");

// setzen bricht zusammen ausser fee

  AddDetail( ({ "mitte" }),
    "Mittlerweile solltest Du schon gelernt haben, dass die Mitte eines "
    "Raumes immer in der Mitte ist. ");

  AddDetail( ({ "kerzen" }),
    "Hier ist doch nur eine!");

  AddDetail( ({ "lichtquelle", "quelle" }),
    "Díe Kerze!");

  AddDetail( ({ "decke" }),
    "Die Decke besteht, wie Du es wahrscheinlich schon vermutet "
