  AddDetail( ({ "mudden" }),
    "Igitt! Mudden! Sowas Unnuetzes!");

  AddDetail( ({ "unnuetzes", "unnuetz" }),
    "Anstatt hier soviel zu untersuchen koenntest Du raus in die Natur "
