inherit "std/room";

#include "../polstadt.h"


int anz_eis;

void reset()
{
  ::reset();
  anz_eis = 1;
}



void create()
{

  ::create();

  
  anz_eis = 1;
  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG,
    "Du findest Dich in einem kleinen Raum wieder, an dessen Waenden ueberall "
    "Bilder von Baeumen haengen. Neben der Tuer kannst Du eine flackernde "
    "Kerze erkennen, die der hiesigen Bewohnerin wohl als einzige Lichtquelle "
    "zu dienen scheint. Ansonsten ist alles hier ziemlich spaerlich "
    "eingerichtet worden. Ein einfach gezimmertes Bett aus Birkenholz, "
    "daneben ein Kasten. In der Mitte des Raumes steht ein Tisch mit einem "
    "etwas gebrechlich aussehenden Sessel davor. ");   
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "osten", ROOM "room_k6" );
  
  AddItem(NPC "anamcara", REFRESH_DESTRUCT);


// DETAILBEGINN

  AddDetail( ({ "raum", "huette" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "bilder" }),
    "An den Waenden haengen ueberall Bilder von Baeumen. Die "
    "Bewohnerin scheint wohl einen sehr engen Bezug zu ihnen zu haben. ");

  AddDetail( ({ "bild" }),
    "Hier haengen mehrere Bilder. Welches moechtest Du ansehen? "
    "(Syntaxhilfe: unt bild 1)");

  AddDetail( ({ "bewohnerin", "anamcara" }),
    "Anamcara lebt hier schon ziemlich lange. Scheinbar ist sie momentan "
    "gerade ausser Haus, aber Du kannst gerne auf sie warten, und es Dir "
    "in der Zwischenzeit gemuetlich machen. ");

  AddDetail( ({ "zwischenzeit", "zeit" }),
    "Sie kommt sicherlich bald wieder. ");

  AddDetail( ({ "haus" }),
    "Sieh Dich hier ruhig um! Vielleicht findest Du ja etwas "
    "Interessantes. ");

  AddDetail( ({ "interessantes" }),
    "Du musst schon selbst suchen, ob etwas fuer Dich dabei ist. ");

  AddDetail( ({ "kerze" }),
    "Die Kerze neben der Tuer flackert schon leicht, dennoch spendet "
    "sie noch genug Licht. ");

  AddDetail( ({ "licht" }),
    "Es scheint wohl genau richtig fuer Anamcara zu sein. Weder zu grell, "
    "noch zu dunkel - eben gerade recht!");

  AddDetail( ({ "tuer" }),
    "Die Tuer aus Birkenholz steht weit offen. Besuch scheint hier gerne "
    "gesehen zu sein. ");

  AddDetail( ({ "besuch" }),
    "Du bist doch auch ein Besucher!");

  AddDetail( ({ "besucher" }),
    "Bist Du keiner? Dann husch husch fort mit Dir!");

  AddDetail( ({ "birkenholz" }),
    "Fast alles wurde hier aus Birkenholz gezimmert. Scheinbar beziehen "
    "es die Hexen aus der Naehe. ");

  AddDetail( ({ "naehe" }),
    "Ein kleines Birkenwaeldchen scheint wohl in der Naehe zu sein. "
    "Zumindest wuerde das die Holzwahl erklaeren. ");

  AddDetail( ({ "holzwahl", "wahl" }),
    "Na weil doch fast ausschliesslich Birkenholz verwendet wird!");

  AddDetail( ({ "birkenwaeldchen", "waeldchen" }),
    "Liegt wohl ganz in der Naehe!");

  AddDetail( ({ "holz" }),
    "Hier wurde fast ausschliesslich Birkenholz fuer das Erbauen der "
    "Huetten und Moebel verwendet. ");

  AddDetail( ({ "moebel" }),
    "Alles ist ziemlich spaerlich eingerichtet worden - ein Bett, ein "
    "Kasten, ein Tisch und ein Sessel. ");

  AddDetail( ({ "waende", "wand" }),
    "Normale Holzwaende, sie wurden nicht einmal nachbehandelt. An "
    "ihnen haengen einige Bilder. ");

  AddDetail( ({ "holzwaende", "holzwand" }),
    "Die Waende wurden in natura belassen. Sie wurden nicht einmal "
