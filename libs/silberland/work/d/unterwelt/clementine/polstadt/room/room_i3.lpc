
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG,
    "Im Suedwesten steht eine etwas verfallene Huette, die dennoch bewohnt "
    "wird, was Du anhand des aufsteigenden Rauches deutlich erkennen kannst. "
    "Ein kleiner Busch waechst vor ihr und erweckt aus irgendeinem Grund "
    "Deine Aufmerksamkeit. Der Weg nach Osten endet in einer Sackgasse, "
    "trotzdem scheinen unzaehlige Fusspuren in genau diese Richtung "
    "zu fuehren. ");  
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "osten", ROOM "room_i4" );
  AddExit( "nordwesten", ROOM "room_h2" );
  AddExit( "suedwesten", ROOM "room_j2" );

  NewDoor( "suedwesten", ROOM "room_j2", ({ "tuer", "tuere", "birkentuer" }),
      ({ DOOR_CLOSED,
         DOOR_RESET_CL,
         D_NAME, "Tuer",
         D_GENDER, FEMALE,
         D_SHORT, "Die alte morsche Tuer im Suedwesten ist %s. ",
         D_LONG, "Eine alte morsche Tuer, die wenn der Wind geht "
                 "leise knirscht. "
                 "Ein paar Buchstaben wurden in sie eingeritzt. ",
         D_MSGS, ({ "in die Huette", "geht", "steht ploetzlich vor Dir" }),
         D_OPENMSG, ({ "Mit lautem Knarren schiebst Du den Riegel beiseite "
                       "und die Tuer oeffnet sich. ",
                       "Mit lautem Knaaren schiebt %s den Riegel beiseite.",
                       " wird mit lautem Knarren geoeffnet." }),
         D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du die Tuer.",
                        "Mit einem lauten Rumms schliesst %s die Tuer.",
                        " wird mit lautem Knarren geschlossen." }),
         D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen. " }) );



  AddDetail( ({ "buchstaben", "buchstabe" }),
    "Wer lesen kann ist klar im Vorteil.");

  AddDetail( ({ "hymir" }),
    "Anscheinend wohnt er in dieser Huette.");

  AddReadDetail( ({ "buchstabe", "buchstaben" }),
    "Du liest:\n"
    "\n"
    "          +-----------+\n"
    "          | H Y M I R |\n"
    "          +-----------+\n"
    "\n");



}

