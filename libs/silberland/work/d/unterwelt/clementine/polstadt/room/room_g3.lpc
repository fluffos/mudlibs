
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
    "Der lehmige Pfad schlaengelt sich durch die Strasse und Gassen von "
    "dieser Stadt. Kleine Irrlichter befinden sich ueberall entlang "
    "des Weges, um den Hexen ihren Weg zu erhellen. Ueberall stehen Huette, "
    "seltsamerweise kann man allerdings kaum irgendwo Eingaenge ausmachen. "
    "Die Stadt scheint wie ausgestorben zu sein, nirgends Bewohner, die "
    "ihren Geschaeften nachgehen. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

  AddExit( "westen", ROOM "room_g2" );
  AddExit( "osten", ROOM "room_g4" );
  AddExit( "norden", ROOM "room_f3" );

}

