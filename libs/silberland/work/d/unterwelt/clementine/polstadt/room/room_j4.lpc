
inherit "std/pub";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <pub.h>
#include "../polstadt.h"


void create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG,
    "Du stehst in der Kneipe <Zum lustigen Hexer>, die sich in einer der "
    "verstrickten Seitengassen von Polaris befindet. Die vielen Tische und "
    "Stuehle im Lokal lassen Dich darauf schliessen, dass sich hier wohl "
    "oefter alle Bewohner treffen, um den neuesten Klatsch und Tratsch "
    "auszutauschen. Momentan ist das Lokal allerdings wie leergefegt. Dennoch "
    "liegt ein angenehmer Duft von Essen in der Luft, scheinbar ist die Kueche "
    "nicht allzuweit entfernt. Hinter der langen Theke kannst Du eine grosse "
    "Speisekarte erkennen. "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );


  AddExit( "norden", ROOM "room_i4" );
  AddExit( "osten", ROOM "room_j5" ); // versteckt
  AddExit( "suedwesten", "fort#" + ROOM "room_k3" ); // versteckt

  SetProp(P_HIDE_EXITS, ({ "osten", "suedwesten" }) );

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER | PUB_NEEDSKEEPER );
  SetProp(P_PUBKEEPER_ID, "hnikar" );
  SetProp(P_PUBKEEPER_NAME, "Hnikar" );
  SetProp(P_PUBKEEPER_GENDER, MALE );
  SetProp(P_PUBMSG_NOINVITE, "Hnikar lacht schallend.\n");
  SetProp(P_PUBMSG_FIGHTING, " kaempft doch gerade!\n");
  SetProp(P_PUBMSG_NOENEMY, "Hnikar sagt: Von mir bekommst Du nie wieder "
                            "etwas!\n");


  AddItem(NPC "hnikar", REFRESH_DESTRUCT);  

// ESSEN UND TRINKEN

  AddDrink( "Wurzeltee", ({ "tee", "wurzeltee" }),
    20, 10, 0, 2,
    ({ "Hnikar bringt Dir ein Heferl selbstgemachten Wurzeltee. "
       "Du trinkst es rasch aus und fuehlst Dich danach bereit "
       "fuer neue Abenteuer.\n", 
       "&& trinkt ein Heferl Tee, und fuehlt sich gleich gestaerkt.\n" }) );
  
  AddDrink( "Blocksbergschnaps", ({ "schnaps", "bocksbergschnaps" }),
    35, 11, 3, 2,
    ({ "Du bekommst ein Glaserl Schnaps vor die Nase gesetzt, dass Du "
       "schnell durch Deine trockene Kehle rinnen laesst.\n",
       "&& trinkt ein Glaserl Schnaps.\n" }) );

  AddDrink( "Hexenschuss", ({ "schuss", "hexenschuss" }),
    70, 17, 1, 3,
    ({ "Hnikar stellt ein blubberndes Getraenkt vor Dich.\n",
       "&& bekommt ein blubberndes Getraenk serviert.\n" }) );

  AddDrink( "Weihwasser", ({ "wasser", "weihwasser" }),
    300, 25, 0, 3,
    ({ "Du bekommst ein Glas zugeschubst, dass Du in einem Zuge leerst.\n",
       "&& leert in einem Zuge ein Glas.\n" }) );

  AddDrink( "Hexengift", ({ "gift", "hexengift" }),
    500, 40, 3, 4,
    ({ "Hnikar stellt eine kochende Fluessigkeit vor Dir ab.\nVorsichtig "
       "nippst Du daran...Das schmeckt sooooooooooooo gut...\nDu leerst "
       "den Rest des Glases in einem Zug leer.\n",
       "&& trinkt ein Glas mit kochender Fluessigkeit leer.\n" }) ); 
  
  AddFood( "Beerenpudding", ({ "pudding", "beerenpudding" }),  
    30, 10, 1,
    ({ "Du bekommst frischen Beerenpudding serviert.\n",
       "&& bekommt frischen Beerenpudding serviert.\n" }) );
  
  AddFood( "Kroetenschleim", ({ "kroetenschleim", "schleim" }),
    50, 15, 2,
    ({ "Hnikar bringt Dir frisch abgezapften Kroetenschleim.\n",
       "&& ist frisch abgezapften Kroetenschleim.\n" }) );

  AddFood( "Spinnenbeinchen (knusprig)", ({ "beinchen", "spinnenbeinchen" }),
   100, 20, 4,
    ({ "Hnikar serviert Dir einen Teller mit frischen knusprigen "
       "Spinnenbeinchen, die Du sofort aufisst.\n",
       "Hnikar bringt && einen Teller mit frischen Spinnenbeinchen.\n" }) );

  AddFood( "Sumpfhuhn (klein)", ({ "sumpfhuhn", "huhn" }),
    300, 40, 4,
    ({ "Du verschlingst voller Gier ein kleines gebratenes Sumpfhuhn.\n",
       "&& verschlingt ein gebratenes Sumpfhuhn.\n" }) ); 

  AddFood( "Fliegender Besen", ({ "fliegender", "besen", "fliegender besen" }),
    1000, 100, 6,
    ({ "Hnikar serviert Dir ein koestliches Mahl, dass er anhand eines "
       "Geheimrezeptes gekocht hat.\n",
       "&& bekommt etwas Koestliches zu essen, und seufzt gluecklich.\n" }) );
  


// DETAILBEGINN

  AddDetail( ({ "kneipe", "lokal", "raum" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "hnikar" }),
    "Er scheint wohl gerade nicht da zu sein. ");

  AddDetail( ({ "klatsch", "tratsch" }),
    "Wenn Du Deine Ohren spitzt, kannst Du vielleicht einige Wortfetzen "
    "erhaschen. ");

  AddDetail( ({ "wortfetzen", "fetzen" }),
    "Sehen kannst Du sie nicht. Aber lausch doch mal!");

  AddDetail( ({ "seitengasse", "seitengassen", "gassen", "gasse" }),
    "Die Kneipe hier befindet sich in einer Seitengasse von Polaris. ");

  AddDetail( ({ "polaris" }),
    "Polaris, die Stadt, die die Hexen eigentlich aus dem Nichts erschaffen "
    "haben. Ob Du Dich hier je wirklich auskennen wirst?! Ueberall gibt es "
    "kleine Seitengassen, versteckte Winkel und Geheimgaenge.");

  AddDetail( ({ "geheimgaenge", "gaenge" }),
    "Vielleicht ist hier ja sogar ja einer an der Ostwand... man kann nie "
    "wissen.");

  AddDetail( ({ "winkel" }),
    "In Polaris gibt es so einige, was man auf den ersten Blick nicht "
    "zu erkennen vermag. ");

  AddDetail( ({ "blick" }),
    "Hoffentlich verschliesst sich Deiner nicht vor dem Unmoeglichen. ");

  AddDetail( ({ "unmoegliches", "unmoeglichen", "unmoeglich" }),
    "Manchmal muss darauf vertrauen Unmoegliches moeglich zu machen. ");

  AddDetail( ({ "duft" }),
    "Riechen!"); 

  AddDetail( ({ "luft" }),
    "Wie?! Du kannst Luft sehen?! Ich nicht :(");

  AddDetail( ({ "essen" }),
    "So ein kleiner leckerer Imbiss koennte Dir sicherlich nicht schaden. ");

  AddDetail( ({ "imbiss" }),
    "Bestell Dir doch was!");

  AddDetail( ({ "kueche" }),
    "Wo ist sie bloss versteckt?! Einfach immer der Nase nach!"); 

  AddDetail( ({ "nase" }),
    "Du schnupperst ein wenig in der Luft herum. Mhmmjam! Lecker!");

  AddDetail( ({ "karte", "speisekarte" }),
    "Die Speisekarte haengt direkt hinter der Theke. Mit <menue> kannst Du sie "
    "lesen. ");

  AddDetail( ({ "theke" }),
    "Die Theke ist ziemlich lang und hat sicherlich schon einige Schlaegereien "
    "gesehen... und anscheinend auch ueberlebt :)");

  AddDetail( ({ "schlaegereien", "schlaegerei" }),
    "Die Theke scheint alle ueberlebt zu haben. Na gut, sie hat einige "
    "Kratzer und Furchen mittlerweile, vielleicht sogar einige Dellen, aber "
    "sie ist immer noch gut in Schuss. ");

  AddDetail( ({ "schuss" }),
    "Um Getraenke und Speisen draufzustellen reicht sie auf jeden Fall noch. ");

  AddDetail( ({ "fall" }),
    "Nix gibts!");

  AddDetail( ({ "hexer" }),
    "Der Name der Kneipe ist: Zum lustigen Hexer. Warum das so ist?! Da "
    "solltest Du mal Hnikar danach fragen."); //hnikar!!!

  AddDetail( ({ "name" }),
    "Was meinst Du?!");

  AddDetail( ({ "ostwand" }),
    "Die Ostwand sieht eigentlich ziemlich normal aus... Scheint aus "
    "stabilem Material zu sein. ");

  AddDetail( ({ "material" }),
    "Scheint stabil zu sein. Du koenntest ja einmal dagegen klopfen. ");

  AddDetail( ({ "illusion" }),
    "Ist die Wand im Osten nur eine Illusion?! ");

  AddDetail( ({ "getraenke", "speisen" }),
    "Das kannst Du alles hier bekommen. ");

  AddDetail( ({ "waende" }),
    "Die Waende sehen einfach aus wie normale Waende. ");

  AddDetail( ({ "wand" }),
    "Welche Wand willst Du genauer untersuchen?!");

  AddDetail( ({ "ohren" }),
    "Na lausch mal!");

  AddDetail( ({ "stadt" }),
    "Seltsam ist es hier schon ein wenig. ");

  AddDetail( ({ "nichts" }),
    "Bevor sich die Hexen hier ansiedelten, gab es hier einfach gar nichts. ");

  AddDetail( ({ "hexen" }),
    "Die leben hier. ");

  AddDetail( ({ "decke" }),
    "Hmm, was gibt es ueber die Decke zu sagen?! Sie ist ueber Dir?! Hoch "
    "ueber Dir! Und mit hoch, mein ich hoch! Also unerreichbar sozusagen! "
    "Absolut unerreichbar!");

  AddDetail( ({ "boden" }),
    "Sauber ist was anderes. Aber Du hast es ja gerne schmuddelig, nicht "
    "wahr?! Kleine Drecksau :)");

  AddDetail( ({ "drecksau", "sau" }),
    "Momentan siehst Du hier nur eine ;)");

  AddDetail( ({ "nordwand" }),
    "Da gehts raus.");

  AddDetail( ({ "suedwand" }),
    "Da ist eine Theke und eine Speisekarte. ");

  AddDetail( ({ "westwand" }),
    "Also die Westwand ist definitiv im Westen. Aber fuer eine Westwand "
    "sieht sie doch etwas seltsam aus... Liegt das vielleicht an dem "
    "komischen Gekritzel auf ihr?! ");

  AddDetail( ({ "gekritzel" }),
    "Hmm, da steht ja was! Sieht aus wie .... Buchstaben!!!");

  AddDetail( ({ "buchstaben" }),
    "Bisserl schief, aber durchaus lesbar!");

  AddReadDetail( ({ "buchstaben" }),
    "\n"
    "Hmm, der erste Buchstabe scheint wohl ein G zu sein... der 3te ein H, und "
    "dann kommen noch ein S und ein W... Aber was soll der zweite Buchstabe "
    "sein... ?!\n"
    "\n"
    "Vielleicht haettest Du doch oefter die Schule besuchen sollen anstatt "
    "diese seltsamen Pilze zu essen...\n"
    "\n");

  AddDetail( ({ "kratzer", "furchen", "furche", "delle", "dellen" }),
    "Du kannst nicht genau sagen wie alt die Furchen, Kratzer und Dellen an "
    "der Theke schon sind, aber sicherlich stammen sie nicht nur von voriger "
    "Woche. ");

  AddDetail( ({ "woche" }),
    "Ach, ich vergess immer, dass Spieler wie Du nicht mehr in Wochen, sondern "
    "Reboots denken. ");

  AddDetail( ({ "reboots", "reboot" }),
    "Also, extra fuer Dich uebersetzt: Die Furchen, ... sind sicherlich nicht "
    "erst vom letzten Reboot, sondern garantiert aelter. ");

  AddDetail( ({ "tische", "tisch" }),
    "Die vielen Tische lassen Dich darauf schliessen, dass die Kneipe "
    "normalerweise gut besucht ist. Allerdings kannst Du momentan keinen "
    "'Einheimischen' erkennen, der hier sein Mahl einnimmt. ");

  AddDetail( ({ "mahl" }),
    "Essen!");

  AddDetail( ({ "einheimischer", "einheimische" }),
    "Keiner hier. ");

  AddDetail( ({ "spieler" }),
    "Sowas wie Du!");

  AddDetail( ({ "stuehle", "sessel", "stuhl" }),
    "Hier stehen wirklich genug herum. Magst Dich vielleicht auf einen "
    "setzen?");

  AddDetail( ({ "bewohner" }),
    "Wo sind denn alle?! Vielleicht moegen sie Dich einfach nicht...");


// SOUNDS

  AddSound(DEFAULT_SOUND, "Ziemlich ruhig hier. Aber wahrscheinlich auch nur "
    "weil momentan keine Gaeste da sind. ");

  AddSound( ({ "gaeste", "gast" }),
    "Du lauscht an Dir selbst.... Du erlauscht etwas Hohles...");

  AddSound( ({ "hohles" }),
    "Wohl nicht viel drin in Dir...");

  AddSound( ({ "wortfetzen", "fetzen", "worte", "wort", "klatsch", "tratsch" }),
    "Schade. Leider ist momentan niemand hier, dem Du lauschen koenntest. ");


// SMELLS

  AddSmell(DEFAULT_SMELL, "Der Duft von Essen liegt in der Luft, sodass "
    "Dir schon das Wasser im Mund zusammenlaeuft. ");

  AddSmell( ({ "luft" }),
    "Die Luft riecht ausnahmslos gut. ");

  AddSmell( ({ "mund" }),
    "Ob Du wirklich an Deinem Mund riechen willst?!");

  AddSmell( ({ "duft", "essen" }),
    "Mhmm, riecht das aber lecker!");

  AddSmell( ({ "wasser" }),
    "Nix gibts!");

// CMDS


  AddCmd( ({ "folg", "folge" }), "c_folgen");
  AddCmd( ({ "sitz", "setze", "setz" }), "c_setzen");
  AddCmd( ({ "erreich", "erreiche" }), "c_erreichen");
  AddCmd( ({ "klopf", "klopfe" }), "c_klopfen");

}


int c_folgen(string str)
{
 if( str != "nase"        &&
     str != "meiner nase" )
 {
  notify_fail("Wem oder was moechtest Du folgen? Deiner Nase?!\n");
  return 0;
 }
 else
 {
  write(BS("Du folgst Deiner Nase, und findest Dich auf einmal ganz woanders "
   "wieder."));
  TP->move(ROOM "kueche1", M_TPORT );
  return 1;
 }
}


int c_setzen(string str)
{
 if(str != "auf stuhl"  &&
    str != "auf sessel" )
 {
  notify_fail("Worauf magst Dich denn setzen?\n");
  return 0;
 }
 else
 {
  write(BS("Gerade als Du Dich setzen willst, faellt Dir der Satz ein, den "
    "Deine Oma immer zu Dir gesagt hat: 'Wer rastet, der rostet!'... Recht "
    "hatte sie! Also bleibst Du lieber stehen. "));
  return 1;
 }
}


int c_erreichen(string str)
{
 if(str != "decke" )
 {
  notify_fail("Was moechtest Du erreichen?\n");
  return 0;
 }
 else
 {
  write(BS("ABSOLUT UNERREICHBAR HEISST ABSOLUT UNERREICHBAR! Oder was "
           "glaubst Du, was das heisst?!"));
  say(CTPN + " macht sich zum Affen. Uh uh uh!\n");
  return 1;
 }
}



int c_klopfen(string str)
{
 if(str != "gegen material" &&
    str != "gegen ostwand"  )
 {
  notify_fail("Wo moechtest Du dagegen klopfen?\n");
  return 0;
 }
 else
 {
  write(BS("Huch! Also Du versuchst gegen die Ostwand zu klopfen, klopft "
   "Deine Hand ins Leere?! Vielleicht ist das hier alles nur eine "
   "Illusion?!"));
  return 1;
 }
}

  


