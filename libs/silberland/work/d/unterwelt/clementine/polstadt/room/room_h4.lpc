inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
	  "Du stehst in einer kleinen Huette, in der es wirklich Unmengen von "
	  "Dingen zu sehen gibt. An der Suedwand ist eine kleine Feuerstelle, "
	  "ueber der ein riesengrosser Kessel baumelt. Die Waende sind fast alle "
	  "mit Regalen zugestellt, in denen alle moeglichen Flaeschchen und "
	  "Doeschen stehen. Ueber Deinem Kopf baumeln unzaehlige von Kraeutern, "
	  "die an Schnueren zum Trocknen aufgehaengt wurden. Direkt neben "
	  "dem Eingang steht ein kleiner Tisch, den Du wegen der vielen Regale "
	  "fast nicht gesehen haettest. ");
  
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  
  AddExit( "norden", ROOM "room_g4" );
  AddItem( NPC "mimona", REFRESH_DESTRUCT);



// DETAILBEGINN

  
  AddDetail( ({ "huette", "haus", "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "mimona", "heilerin" }),
	  "Wo die wohl gerade ist?!");

  AddDetail( ({ "kopf" }),
	  "Dein Kopf ist noch dort wo er sein sollte, aber wenn Du das aendern "
	  "moechtest, kannst Du gerne den Henker aufsuchen. ");

  AddDetail( ({ "henker" }),
	  "Er freut sich garantiert ueber einen Besuch! ");

  AddDetail( ({ "kessel", "hexenkessel" }),
	  "Ein riesengrosser Hexenkessel baumelt an einem Gestell ueber der "
	  "Feuerstelle. Was da wohl drinnen sein mag? "); //reinschaun blubbern

  AddDetail( ({ "feuerstelle", "stelle" }),
	  "Wild und aufbrausend tobt das Feuer in der Feuerstelle. Unzaehlige "
	  "Holzscheite liegen in ihr, und lassen manchmal sogar ein paar Funken "
	  "auf den Boden ueberspringen. Du wunderst Dich warum nicht schon "
	  "laengst die ganze Huette Feuer gefangen hat. ");

  AddDetail( ({ "scheite", "holzscheite" }),
	  "Sie liegen alle im Feuer, und bruzzeln vor sich hin. Vielleicht "
	  "findest Du aber hier noch andere zum Nachlegen?! "); //scheite

  AddDetail( ({ "feuer" }),
	  "Es fackelt lichterloh in der Feuerstelle. Immer wieder hoerst Du ein "
	  "Knistern und Knacksen aus dieser Richtung. "); //la knacksen, ...

  AddDetail( ({ "knacksen", "knistern" }),
	  "Lausch doch mal!");

  AddDetail( ({ "boden", "lehmboden" }),
	  "Der Boden, oder zumindest den Teil des Bodens, den Du trotz des "
	  "vielen Geruempels noch sehen kannst, besteht hauptsaechlich aus Lehm.");

  AddDetail( ({ "lehm" }),
	  "Die meisten Huetten in Polaris wurden aus Lehm gefertigt. Steine "
	  "hier her zu transportieren, duerfte ja nicht unbedingt ein einfacher "
	  "Weg sein. ");

  AddDetail( ({ "steine" }),
	  "Man findet hier nicht soviele. ");

  AddDetail( ({ "huetten" }),
	  "Geh raus und erforsche sie! ");

  AddDetail( ({ "polaris" }),
	  "Du bist mitten in der Stadt!");

  AddDetail( ({ "stadt" }),
	  "Fuer jede unsinnige Frage haette ich gerne bitte 10 Cent, dann koennt "
	  "ich mich schon laengst zur Ruhe setzen. ");

  AddDetail( ({ "ruhe" }),
	  "Hab ich dank Dir bald. ");

  AddDetail( ({ "10 cent", "10", "cent" }),
	  "Und schon wieder bin ich reicher geworden!");

  AddDetail( ({ "frage" }),
	  "Her mit der Kohle!");

  AddDetail( ({ "kohle" }),
	  "Wenn Du das Wort 'Krxxlskrweudkageakwniusadf' untersuchst, dann "
	  "nehm ich Dir Deine ganzen Muenzen weg! Also Vorsicht! ");

  AddSpecialDetail( ({ "krxxlskrweudkageakwniusadf" }), "moneyfunc");
  
  AddDetail( ({ "muenzen" }),
	  "Die sind dann alle weg!");

  AddDetail( ({ "vorsicht" }),
	  "Vorsicht solltest Du hier wirklich haben!");

  AddDetail( ({ "wort" }),
	  "Ein Wort ist ein Wort ist ein Wort ist ein Wort ...");

  AddDetail( ({ "nachlegen" }),
	  "Vielleicht gibts hier ja noch mehr... ");

  AddDetail( ({ "funken" }),
	  "Immer wieder springen ein paar Funken von der Feuerstelle auf den Boden "
	  "ueber. Warum steht denn nicht schon laengst die ganze Huette in "
	  "Flammen?");

  AddDetail( ({ "flammen" }),
	  "Du siehst nur welche in der Feuerstelle. ");

  AddDetail( ({ "geruempel" }),
	  "Unzaehlige von Regalen, Flaeschchen und anderen Dingen befinden sich "
	  "in der Huette. Fuer Dich sieht es hier nach dem perfekten Chaos aus, "
	  "aber Mimona scheint sich hier dennoch auszukennen. ");

  AddDetail( ({ "chaos" }),
	  "So koennte man diese Unordnung hier nennen. ");

  AddDetail( ({ "unordnung" }),
	  "So nennst Du es jetzt... Aber vielleicht hat alles hier auch ein "
	  "gewisses System?! Zumindest muss das so sein, denn Mimona findet sich "
	  "hier zurecht. ");

  AddDetail( ({ "system" }),
	  "Du solltest Mimona mal danach fragen. ");
  
  AddDetail( ({ "besuch" }),
	  "Darueber waere er sicherlich hocherfreut. ");

  AddDetail( ({ "eingang" }),
	  "Der Eingang, der natuerlich zugleich auch der Ausgang dieser "
	  "Huette ist, befindet sich noerdlich von Dir. Neben ihm steht ein "
	  "kleiner Tisch. ");

  AddDetail( ({ "ausgang" }),
	  "Nach Norden kommst Du im Normalfall raus!");

  AddDetail( ({ "normalfall" }),
	  "Solange Du Dich hier artig benimmst, kannst Du diese Huette nach "
	  "Norden jederzeit verlassen. ");

  AddDetail( ({ "decke" }),
	  "Die Decke befindet sich hoch ueber Dir. Unter ihr wurden einige "
	  "Schnuere gespannt, an denen Kraeuter zum Trocknen aufgehaengt sind. ");

  AddDetail( ({ "trocknen" }),
	  "Es gibt einige Kraeuter, die sich getrocknet einfach besser "
	  "verwenden lassen als frisch. Ausserdem kann man getrocknete Kraeuter "
	  "laenger lagern, und sie erst dann wieder hervorholen, wenn man sie "
	  "wirklich benoetigt. ");

  AddDetail( ({ "schnuere" }),
	  "Sie wurden direkt unter der Decke von einer Wand zur anderen gespannt. "
	  "An ihnen baumeln unzaehlige von Kraeutern. ");

  AddDetail( ({ "waende" }),
	  "An fast allen Waenden stehen Regale, nur an der Suedwand befindet "
	  "sich stattdessen eine Feuerstelle. ");

  AddDetail( ({ "wand" }),
	  "Welche Wand meinst Du genau?");

  AddDetail( ({ "suedwand" }),
	  "An der Suedwand befindet sich eine Feuerstelle, ueber der auf einem "
	  "Dreibein ein riesiger Kessel baumelt. ");

  AddDetail( ({ "dreibein" }),
	  "So nennt man das Gestell an dem der Kessel haengt. ");

  AddDetail( ({ "nordwand" }),
	  "Dort befindet sich der Ausgang und ein kleiner Tisch. Sonst ist "
	  "allerdings auch dort alles mit Regalen zugestellt. ");

  AddDetail( ({ "westwand", "ostwand" }),
	  "Ueberall ist alles voll mit Regalen. Wie kann Mimona hier ueberhaupt "
	  "nur etwas finden?");

  AddDetail( ({ "unmengen", "mengen" }),
	  "Mimona scheint wohl alles zu sammeln, was sie irgendwo findet. "
	  "Zumindest wuerde das diese Massen an Zeug hier in der Huette "
	  "erklaeren. ");

  AddDetail( ({ "massen", "zeug" }),
	  "Hier gibt es wirklich gigantisch viel!");

  AddDetail( ({ "gestell" }),
	  "Das Gestell besteht aus schwerem Gusseisen, dass sicherlich ein "
	  "Zwerg in muehevoller Handarbeit gefertigt hat. Es scheint ziemlich "
	  "stabil zu sein, und haelt sicherlich so einiges aus. ");

  AddDetail( ({ "einiges" }),
	  "Also ruetteln kannst Du sicherlich problemlos daran. "); //ruetteln

  AddDetail( ({ "handarbeit", "arbeit" }),
	  "Irgendwer hat an diesem Gestell sicher ein paar Monate gegarbeitet. "
	  "Auf einem der Beine siehst Du ein paar Kratzer. ");

  AddDetail( ({ "beine" }),
	  "Der Dreibein hat natuerlich 3 Beine, waere ja sonst unlogisch!");

  AddDetail( ({ "bein 1", "bein eins", "bein 3", "bein drei" }),
	  "Schwer und aus Eisen!");

  AddDetail( ({ "gusseisen", "eisen" }),
	  "Das Eisen eignet sich fuer solche Konstruktionen einfach am besten. ");

  AddDetail( ({ "konstruktionen" }),
	  "Wirklich beeindruckend. ");

  AddDetail( ({ "bein zwei", "bein 2" }),
	  "Das zweite Bein des Gestells ist ebenfalls aus schwerem Eisen, "
	  "allerdings kannst Du hier auch ein paar Zeichen erkennen. ");

  AddDetail( ({ "kratzer" }),
	  "Du muesstest Dir das Bein schon naeher ansehen, um feststellen zu "
	  "zu koennen, was das genau ist. ");

  AddDetail( ({ "zeichen" }),
	  "Sieht aus wie ein paar Initialen. ");

  AddDetail( ({ "initialen" }),
	  "H."
	  "\n"
	  "Was das wohl bedeuten soll?");

  AddDetail( ({ "bein" }),
      "Hier gibts mehrere!");

  AddDetail( ({ "monate" }),
	  "Das hat sicherlich laenger gedauert. ");

  AddDetail( ({ "zwerg" }),
	  "Nur Zwerge haben diese einmalige Gabe, aus schweren Eisenteilen so "
	  "durchdachte Konstruktionen zu machen. ");

  AddDetail( ({ "teile", "eisenteile" }),
	  "Du solltest lieber einen Zwerg danach fragen. ");

  AddDetail( ({ "gabe" }),
	  "So sind sie wenigstens etwas nuetzlich. ");

  AddDetail( ({ "tisch", "holztisch" }),
	  "Ein kleiner Tisch aus Holz steht direkt neben dem Eingang. Er besteht "
	  "aus einem kleinen Baumstumpf mit darueberliegender Tischplatte, und "
	  "sieht eigentlich ziemlich unscheinbar aus. ");

  AddDetail( ({ "tischplatte", "platte" }),
	  "Die Tischplatte besteht aus Holz und hat eine ziemlich regelmaessige "
	  "Maserung...");

  AddDetail( ({ "maserung" }),
	  "Eigentlich ziemlich regelmaessig, aber vielleicht faellt Dir bei "
	  "naeherem Betrachten mehr auf. "); // betrachte

  AddDetail( ({ "stumpf", "baumstumpf" }),
	  "Ein normaler kleiner Baumstrumpf aeh.. -stumpf. Auf ihm liegt eine "
	  "Tischplatte. ");

  AddDetail( ({ "strumpf", "baumstrumpf" }),
	  "Wo siehst Du denn hier Struempfe?");

  AddDetail( ({ "struempfe" }),
	  "Anscheinend verbloeden programmieren und forschen gleichermassen. ");

  AddDetail( ({ "betrachten" }),
	  "Nicht untersuchen - machen!");

  AddDetail( ({ "holz" }),
	  "Normales Holz, dass man in normalen Waeldern so findet. ");

  AddDetail( ({ "waelder", "wald" }),
	  "Hier ist weder Waelder noch ein Wald. ");

  AddDetail( ({ "teil" }),
	  "Ein eher kleiner Teil. ");

  AddDetail( ({ "weg" }),
	  "Steine sind einfach schwerer zu beschaffen. ");

  AddDetail( ({ "dinge" }),
	  "Sieh Dich nur gut um, es koennte sich als nuetzlich erweisen. ");

  AddDetail( ({ "flaeschchen", "flaschen", "flasche" }),
	  "Unzaehlige Flaeschchen stehen in den Regalen. Sie haben die "
	  "unterschiedlichsten Formen und Farben. Einige von ihnen tragen "
	  "Aufschriften, andere nicht. Ein paar von ihnen sind sicherlich auch "
	  "mit Giften befuellt... also lieber nicht beruehren. "); //beruehren gift

  AddDetail( ({ "gifte", "giften", "gift" }),
	  "Man kann ja nie wissen, was sich in so einer Flasche befindet. ");
 
  AddDetail( ({ "doeschen", "dosen" }),
	  "Viele verschiedene stehen in den Regalen. Die meisten von ihnen sind "
	  "allerdings rund... Ein rotes sticht Dir besonders ins Auge. ");

  AddDetail( ({ "auge", "aug" }),
	  "*STICH* *STICH* STICH* ");

  AddDetail( ({ "rotes" }),
	  "Ein rotes WAS willst Du untersuchen?");

  AddDetail( ({ "was" }),
	  "Ja, das frag ich mich auch! Also was moechtest Du untersuchen?");

  AddDetail( ({ "rotes doeschen", "rote dose" }),
	  "Es ist rot und rund. Sieht huebsch aus! "); // oeffnen

  AddDetail( ({ "aufschrift", "aufschriften" }), 
	  "Einige Flaschen tragen Aufschriften. "); // LESEN!
 
  AddDetail( ({ "farben", "farbe" }),
	  "Gruen, gelb, blau, braun, tuerkis, rosa, orange, lila, violett, grau, "
	  "schwarz, weiss, ocker, rot, ...");

  AddDetail( ({ "rot", "gelb", "ocker", "weiss", "schwarz", "grau", "lila", 
      "violett", "orange", "tuerkis", "braun", "blau", }),
	  "Das sind alles sehr huebsche Farben! ");

  AddDetail( ({ "gruen" }),
	  "Hier gibts verschiedene gruene Flaschen. Welche meinst Du denn? "
	  "Die grasgruene, froschgruene, pistaziengruene, kiwigruene, waldgruene, "
	  "moosgruene, popelgruene, blaugruene, gelbgruene, hellgruene, "
	  "dunkelgruene, mintgruene, olivgruene (nicht zuverwechseln mit oliv! "
	  "sondern eine mischung von olive und blau! Oliv ist immer noch ein "
	  "Gelbton!), laubgruene, tannengruene, meergruene oder spinatgruene "
	  "Flasche?");

  AddDetail( ({ "gelbton" }),
	  "Oliv ist ein Gelbton!");
  
  AddDetail( ({ "spinatgruene flasche", "meergruene flasche", 
	  "tannengruene flasche", "laubgruene flasche", "olivgruene flasche", 
	  "dunkelgruene flasche", "hellgruene flasche", "gelbgruene flasche",
	  "blaugruene flasche", "moosgruene flasche", "waldgruene flasche", 
	  "pistaziengruene flasche", "froschgruene flasche",
	  "grasgruene flasche" }),
	  "Hmm... absolut uninteressant. Tut mir leid. ");
	  
  AddDetail( ({ "kiwigruene flasche" }),
	"Du musterst die kiwigruene Flasche eingehend... Irgendwie fad. ");
	
  AddDetail( ({ "popelgruene flasche" }),
	"Igitt, so eine ekelhafte Farbe hast Du ja noch nie gesehen!");


  AddDetail( ({ "mintgruene flasche" }),
	"Welche mintgruene Flasche willst Du denn genauer untersuchen? "
	"Die bauchige mintgruene, die schmale mintgruene, die lange mintgruene, "
	"die fast ausgeleerte mintgruene, die glaeserne mintgruene, "
	"die steinerne mintgruene, die verklebte mintgruene, die runde mintgruene, "
	"die eckige mintgruene, die volle mintgruene, die leere mintgruene, oder "
	"die komische mintgruene Flasche? ");

  AddDetail( ({ "runde mintgruene flasche" }),
	"Sie sieht sehr interessant aus. Vielleicht kann man sie ja trinken?!");
  // trinken heilt

  AddDetail( ({ "steinerne mintgruene flasche" }),
	"Trinken kann man sie mit Sicherheit, aber ob das ratsam ist?!");
  // trinken gift
  
  AddDetail( ({ "sicherheit" }),
	"Die hat man normalerweise nie!");

  AddDetail( ({ "bauchige mintgruene flasche", "schmale mintgruene flasche", 
	"lange mintgruene flasche", "fast ausgeleerte mintgruene flasche", 
	"glaeserne mintgruene flasche", "eckige mintgruene flasche", 
	"komische mintgruene flasche" }),
	"Sieht nicht besonders spannend aus.");

  AddDetail( ({ "leere mintgruene flasche" }),
	"Da ist ja gar nichts drinnen!");

  AddDetail( ({ "volle mintgruene flasche" }),
	"Die ist ja voll!");

  AddSpecialDetail( ({ "verklebte mintgruene flasche" }), "klebenfunc"); //klebrige finger
  
  AddDetail( ({ "rot" }),
	  "Hier gibt es verschiedene rote Flaschen. Welche moechtest Du genau "
	  "untersuchen? Tipp: unt <farbe> flasche. (Rostrot, blutrot, feuerrot, "
	  "kirschrot, tomatenrot, hellrot, dunkelrot, ziegelrot, mahagonirot, "
	  "weinrot, orangerot, berserkerstirnbandrot, zinnoberrot, kaminrot, "
	  "magentarot.)");

  AddDetail( ({ "rostrote flasche", "blutrote flasche", "feuerrote flasche", 
	  "kirschrote flasche", "tomatenrote flasche", "hellrote flasche", 
	  "dunkelrote flasche", "mahagonirote flasche", "weinrote flasche", 
	  "berserkerstirnbandrote flasche", "zinnoberrote flasche", 
	  "magentarote flasche" }),
	  "Nein, die Flaschen sehen naeher betrachtet doch fad aus! ");

  AddDetail( ({ "ziegelrote flasche" }),
	  "Hmm... interessant! Aber nicht interessant genug!");

  AddDetail( ({ "orangerote flasche" }),
	  "Welche willst Du denn genau untersuchen? Die kleine orangerote Flasche, "
	  "die grosse orangerote Flasche, die alte orangerote Flasche, die "
	  "neue orangerote Flasche, die schmale orangerote Flasche, die "
	  "bauchige orangerote Flasche, die halbleere orangerote Flasche, "
	  "die antike orangerote Flasche, die sonderbare orangerote Flasche, "
	  "die geschwungene orangerote Flasche, die glatte orangerote Flasche, "
	  "die verklebte orangerote Flasche, die kantige orangerote Flasche, "
	  "die hintere orangerote Flasche, die vordere orangerote Flasche, "
	  "die spinnwebverhangene orangerote Flasche, oder welche? ");
  
  AddDetail( ({ "bauchige orangerote flasche" }),
	  "Diese Flasche sieht wirklich sehr interessant aus. Versuch doch "
	  "einmal ihr Etikett zu lesen! "); //LESEN HEILT !! KAMPF !!
  
  AddDetail( ({ "etikett" }),
	  "Lesen!");   // LESEN 

  AddDetail( ({ "kaminrote flasche" }),
	  "Wow, eine kaminrote Flasche. Und nun?");
	  
  AddDetail( ({ "formen", "form" }),
	  "Die Flaschen haben verschiedene Formen: eckig, kantig, rund, "
	  "gewellt, spitz zulaufend, zylindrisch, schmal, lang, bauchig, "
	  "traubenfoermig, tailliert, kuerbisfoermig, ... ");

  AddDetail( ({ "eckige flasche", "kantige flasche", "runde flasche", 
      "gewellte flasche", "spitz zulaufende flasche", "zylindrische flasche", 
	  "schmale flasche", "lange flasche", "bauchige flasche", 
	  "traubenfoermige flasche", "taillierte flasche" }),
	  "Kommst Du Dir nicht extrem bloed vor beim Untersuchen dieser Woerter?");

  AddDetail( ({ "untersuchen" }),
	  "Sinnlos, oder?!");

  AddDetail( ({ "woerter" }),
	  "Hier gibts viele!");
  
  AddDetail( ({ "kuerbisfoermige flasche" }),
	  "Huch, das ist ja gar keine Flasche, sondern ein Kuerbis?!");

  AddDetail( ({ "kuerbis" }),
	  "Was macht denn der hier?! Schmeckt sicher lecker! Ob man ihn mal "
	  "kosten kann?!"); // KOSTEN

  AddDetail( ({ "kraeuter", "kraeutern" }),
	  "Hier haengen sehr viele Kraeuter! Du kannst unteranderem Ringelblume, "
	  "Lavendel, Kamille, Rosmarin, Thymian, Sanddorn, Weissdorn, Brennessel, "
	  "Schafgarbe und Zinnkraut erkennen. ");

  AddDetail( ({ "zinnkraut", "rosmarin", "kamille", "thymian", "sanddorn", 
	  "schafgarbe", "brennessel", "weissdorn", "ringelblume", "lavendel" }),
	  "Mimona hat sehr viele Kraeuter zum Trocknen aufgehaengt. Sie braucht "
	  "sie wohl fuer alle moeglichen Traenke und Tinkturen. Wenn Du naeheres "
	  "ueber ein bestimmtes Kraut wissen moechtest, dann such doch die "
	  "Bibliothek hier in Polaris auf. ");

  AddDetail( ({ "bibliothek" }),
	  "Du wirst sie schon selbst finden. ");

  AddDetail( ({ "kraut" }),
	  "Hier gibt es viele verschiedene. ");

  AddDetail( ({ "traenke", "tinkturen" }),
	  "Na was dachtest Du, was sich in den Flaschen befindet?!");

  AddDetail( ({ "stich" }),
	  "AUTSCH!!!");

  AddDetail( ({ "regal", "regale" }),
	  "Hier befinden sich irgendwie ueberall Regale. In ihnen siehst Du "
	  "alle moeglichen Flaeschchen und Doeschen. Vielleicht solltest Du Dich "
	  "hier doch etwas genauer umsehen. "); // sehe genauer um --> forschen!

  

// SMELLS

  
  AddSmell(DEFAULT_SMELL, 
	  "Es riecht hier nach verbranntem Holz, und vielen verschiedenen "
	  "Kraeutern. ");

  AddSmell( ({ "holz" }),
	  "Der Rauch steigt Dir in die Nase..");

  AddSmell( ({ "rauch" }),
	  "Naja, dieser Geruch ist nicht unbedingt betoerend. ");

  AddSmell( ({ "geruch" }),
	  "Es riecht wirklich verbrannt hier!");

  AddSmell( ({ "kraeuter", "kraeutern" }),
	  "Die vielen verschiedenen Duefte der Kraeuter vermischen sich zu "
	  "einem wohlriechenden Ganzen hier. ");

  AddSmell( ({ "ganzes", "ganzen" }),
	  "Du fuehlst Dich ziemlich wohl hier. ");

  AddSmell( ({ "duefte", "duft" }),
	  "Mhmmm.... das riecht aber gut!");

  
  
// SOUNDS

  
  AddSound(DEFAULT_SOUND,
	  "Ganz deutlich hoerst Du ein Knistern und Knacksen aus der Feuerstelle. "
	  "Huch?! War das gerade ein BLUBB?");

  AddSound( ({ "blubb" }),
	  "Konzentriert lauscht Du nochmal nach dem Blubb... Da schon wieder! "
	  "Wird wohl aus dem Kessel kommen... ");

  AddSound( ({ "kessel" }),
	  "Ja, Du hattest recht. Irgendetwas blubbert im Kessel vor sich hin. ");

  AddSound( ({ "knistern", "knacksen" }),
	  "Die Holzscheite verbrennen langsam in der Feuerstelle. ");

//  AddSound( ({ "holzscheite", "scheite" }), #'brennspielerbrenn );

  
// CMDS 

  
  
}


