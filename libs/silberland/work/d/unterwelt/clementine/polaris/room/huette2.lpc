inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../marisol.h"
#include <moving.h>


int anz_zettel;

reset()
{
  ::reset();
  anz_zettel = 1;
}

create()
{
  ::create();
 
  anz_zettel = 1; 
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "In einer Holzhuette");
  SetProp(P_INT_LONG, 
     "Du stehst in einer kleinen Holzhuette, die einsam und verlassen "
     "einfach hier steht. Eigentlich befindet sich in dieser Huette "
     "gar nichts, mit Ausnahme einer alten Holztruhe, die an der "
     "Nordwand steht. " 
     "Auf dem Holzboden hat sich schon sehr viel "
     "Staub angesammelt, und auch die Waende sind in keinem " 
     "besonders guten Zustand. Ein sehr eigenartig stechender "
     "Geruch liegt in der Luft. Dir wird richtig uebel davon. "
     "Welchen Zweck wohl diese Huette "
     "mal erfuellt hat, ist Dir wirklich unklar. ");
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_HOUSE]) );
  
  AddExit( "norden", ROOM ("room6") );


// DETAILBEGINN

  AddDetail( ({ "truhe", "holztruhe" }),
     "Eine verschlossene Truhe steht an der Nordwand. "
     "Sie sieht sehr alt aus, und ueber ihr hat sich bereits eine "
     "ordentliche Schicht Staub angesammelt. "
     "Seltsamerweise kannst Du auch ein paar Fingertapser erkennen. ");

  AddDetail( ({ "fingertapser", "tapser" }),
     "Im Staub befinden sich die Abdruecke von Fingern. ");

  AddDetail( ({ "abdruecke" }),
     "Irgendjemand war hier sehr neugierig wie es scheint. ");

  AddDetail( ({ "finger" }),
     "Anscheinend hat wohl jemand versucht die Truhe zu oeffnen. ");   
    
  AddDetail( ({ "waende" }),
     "Die Waende bestehen alle aus Holz, und sehen wirklich schon sehr "
     "mitgenommen aus. ");

  AddDetail( ({ "boden", "holzboden" }),
     "Der alte Holzboden besteht aus Dielen, ueber denen sich im "
     "Laufe der Zeit schon sehr viel Staub angesammelt hat. ");

  AddDetail( ({ "staub" }),
     "Ueberall wo Du hinsiehst liegt nur Staub. Eklig einfach! ");

  AddDetail( ({ "schicht" }),
     "Ueber dem Boden und der Truhe hat sich bereits eine dicke "
     "Schicht Staub gebildet. ");

  AddDetail( ({ "dielen", "holzdielen" }),
     "Die Dielen knarren unter Deinen Fuessen. Das Holz hat bereits tiefe "
     "Furchen, die Du trotz des Staubs erkennen kannst. ");

  AddDetail( ({ "fuesse" }),
     "Wie von selbst machst Du einen Schritt nach dem anderen.\n"
     "*knarr*");

  AddDetail( ({ "schritt" }),
     "Du setzt einen Fuss vor den anderen - das nennt man Schritt. ");

  AddDetail( ({ "fuss" }),
     "Du bemerkst ein leichtes Ziehen in Deinem rechten Fuss. ");

  AddDetail( ({ "ziehen" }),
     "Scheint wohl von den Anstrengungen zu kommen. ");

  AddDetail( ({ "anstrengungen" }),
     "Wer viel sieht, legt auch meistens einen weiten Weg zurueck. ");

  AddDetail( ({ "weg" }),
     "Du erkundest gerade den Weg durch Polaris. ");

  AddDetail( ({ "polaris", "stadt" }),
     "Polaris ist die Stadt, in der Du Dich gerade befindest. ");

  AddDetail( ({ "furchen" }),
     "Die Zeit hinterlaesst ihre Spuren an den Dielen. ");

  AddDetail( ({ "spuren" }),
     "Du untersuchst die Dielen genauer und merkst auf einmal ein "
     "Glitzern. ");

  AddDetail( ({ "glitzern" }),
     "Als Du dem Glitzern nachgehst, ist es auf einmal verschwunden. "
     "Eine Diele kommt Dir nun aber etwas seltsam vor. ");

  AddDetail( ({ "diele" }),
     "Du tastest die Diele ab und siehst auf einmal einen kleinen Gnom. ");

  AddDetail( ({ "gnom" }),
     "Der Gnom fluestert: Schau Dir einmal die Ostwand an.\n"
     "Schon ist er wieder verschwunden. ");

  AddDetail( ({ "ostwand" }),
     "Die Ostwand besteht, wie alle Waende, aus Holz. Auf einmal "
     "bemerkst Du aber einen Fackelhalter. ");

  AddDetail( ({ "fackelhalter", "halter" }),
     "Seltsam...Der war vorhin doch noch nicht da. ");

  AddDetail( ({ "huette", "holzhuette" }),
     "Du stehst in einer verlassenen Holzhuette. ");

  AddDetail( ({ "holz" }),
     "Alles besteht hier, wie sollte es anders sein, aus "
     "Birkenholz. ");

  AddDetail( ({ "birkenholz" }),
     "So nennt man das Holz der Birken. ");

  AddDetail( ({ "birken" }),
     "Du hast sicherlich schon welche gesehen. ");

  AddDetail( ({ "zweck" }),
     "Den wirklichen Zweck dieser Huette konntest Du noch nicht "
     "wirklich feststellen. ");

  AddDetail( ({ "nordwand" }),
     "An der Nordwand, gleich neben dem Eingang steht eine Truhe "
     "aus Holz. ");

  AddDetail( ({ "eingang" }),
     "Der Eingang ist gleichzeitig der Ausgang hier. ");

  AddDetail( ({ "ausgang" }),
     "Eigentlich ist Eingang fast immer das gleiche wie Ausgang. Es "
     "kommt nur auf die Betrachtungsweise an. ");

  AddDetail( ({ "betrachtungsweise" }),
     "Man geht hinein und auch wieder hinaus. Oder suchst Du "
     "diese Huette auf um zu sterben? ");

  AddDetail( ({ "wand" }),
     "Alle Waende bestehen aus Holz und sehen sehr mitgenommen aus. "
     "Du kannst auch einige Loecher erkennen. ");

  AddDetail( ({ "loecher" }),
     "Sie stammen wahrscheinlich von Holzwuermern. ");

  AddDetail( ({ "holzwuermer", "wuermer" }),
     "Du kannst leider keine erkennen. Aber die Loecher stammen mit "
     "einer grossen Wahrscheinlichkeit von ihnen. ");

  AddDetail( ({ "wahrscheinlichkeit" }),
     "Zu 99,9 % ");

  AddDetail( ({ "ausnahme" }),
     "Die Huette ist komplett leer, bis auf eine etwas groessere "
     "Truhe. ");

  AddDetail( ({ "zeit" }),
     "Zeit kommt und Zeit geht. Deine Zeit kommt sicher auch bald hier. ");

  AddDetail( ({ "zustand" }),
     "Die Huette befindet sich in einem katastrophalen Zustand. "
     "Niemand scheint sich um sie zu kuemmern. ");

  AddDetail( ({ "decke" }),
     "Die Decke ist nicht so hoch hier. Sie weist schon einige Spalten "
     "auf. ");

  AddDetail( ({ "spalten" }),
     "Wenn es regnet muesste man hier sicherlich Kuebel aufstellen. "
     "Denn durch die Spalten wuerde der Regen durch die Decke kommen. ");

  AddDetail( ({ "regen" }),
     "Momentan regnet es doch nicht! ");

  AddDetail( ({ "kuebel", "kuebeln" }),
     "Regnet es denn???");
  
  AddDetail( ({ "luft" }),
     "Ein stechender Geruch erfuellt die Luft. ");

  AddDetail( ({ "geruch" }),
     "Probier es doch einmal mit riechen. ");

  AddDetail( ({ "laufe" }),
     "Im Laufe der Zeit verfaellt die Huette immer mehr. ");
 
  AddDetail( ({ "westwand" }),
     "Blick Dich ruhig etwas hier um. ");


// DETAILENDE


// SMELLS

  AddSmell(DEFAULT_SMELL,
     "Ekelig! In der Luft liegt wirklich ein fuerchterlicher Gestank. "
     "Dir wird sofort uebel und Dein Magen revoltiert. ");

  AddSmell( ({ "geruch", "gestank" }),
     "Die ganze Luft hat einen stechenden Geruch. Du kannst ihn aber "
     "nicht naeher lokalisieren.\n"
     "Voller Abscheu haeltst Du Dir die Nase zu. ");

  AddSmell( ({ "nase" }),
     "Du kannst nicht an Deiner Nase riechen. ");

  AddSmell( ({ "abscheu" }),
     "Es stinkt hier gewaltig nach Ausduenstungen. ");

  AddSmell( ({ "ausduenstungen" }),
     "Du haeltst Dir die Nase zu. ");

  AddSmell( ({ "magen" }),
     "Deinem Magen geht es furchtbar schlecht. Aber daran riechen "
     "kannst Du nicht. ");


// SOUNDS

  AddSound(DEFAULT_SOUND,
     "Es ist ganz still hier. Ueberhaupt nichts zu hoeren.\n"
     "Doch halt! War da nicht gerade ein leises Kratzen?");

  AddSound( ({ "kratzen" }),
     "Da!\n"
     "Schon wieder!\n" 
     "Irgendjemand oder irgendetwas scheint "
     "komische Kratzgeraeusche von sich zu geben. ");

  AddSound( ({ "kratzgeraeusche" }),
     "Du kannst die Richtung nicht genau erlauschen. ");

  AddSound( ({ "richtung" }),
     "Die weisst Du nicht, und erlauschen kannst Du sie schon gar nicht. ");
   
      

  AddCmd( ({ "oeffne" }), "c_oeffnen" );
  AddCmd( ({ "drehe", "dreh" }), "c_drehen" );
}

int c_oeffnen( string str )
{
 object ob;

 if(str != "truhe" && str != "holztruhe" )
 {
  notify_fail("Was moechtest Du hier oeffnen?\n");
  return 0;
 }
 
 if( str == "truhe" ||
     str == "holztruhe" ) 
 {
  if( anz_zettel < 1 )
  {
   write(BS("Du oeffnest die Truhe, findest aber nichts Brauchbares, und "
            "schliesst sie deshalb wieder. Vielleicht solltest Du es "
            "spaeter noch einmal probieren.\n"));
   return 1;
  }
  else
  {
   write(BS("Du oeffnest die Truhe und findest darin einen Zettel, "
            "den Du sofort einsteckst. Vorsichtig schliesst Du die "
            "Truhe wieder, damit niemand etwas bemerkt. "));
   ob = clone_object(OBJ ("dzettel"));
   if(ob->move(this_player(), M_GET) != 1)
   {
    tell_object(this_player(), "Soviel kannst Du nicht mehr tragen!\n");
    ob->move(this_object(), M_NOCHECK);
   }
   anz_zettel--;
   say(CTPN+ " blickt sich um und werkt etwas an der Truhe herum.\n");
   return 1;
  }
 }
}

int c_drehen( string str )
{
 if(str != "fackelhalter" && str != "halter")
 {
  notify_fail("Was moechtest Du hier drehen?\n");
  return 0;
 }
 else
 {
  write(BS(
           "Auf einmal oeffnet sich unter Deinen Fuessen ein "
           "versteckter Ausgang und legt ein Loch frei. ")+"\n"+BS(
           "Du verlierst das Gleichgewicht und plumpst hinein. ")+"\n"+
           BS("Unsanft landest Du auf einem harten "
           "Boden. "));
  this_player()->move(ROOM ("keller"), M_GO, 
           "durch ein Loch", "faellt", "faellt herein");
  say("Der Ausgang verschwindet ploetzlich wieder.\n");
  return 1;
 }

}

