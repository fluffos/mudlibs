inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

void create()
{

  ::create();

  SetProp(P_INT_SHORT, "In einem Geheimraum" );
  SetProp(P_INT_LONG, 
     "Du scheinst Dich in einer Geheimbibliothek zu befinden. "
     "Die Waende sind auch hier bis zur Decke mit Regalen "
     "zugemauert. Der Fussboden ist ueberhaeuft mit Buecherstapeln "
     "und Kisten. Alles sieht sehr unordentlich aus, und Du fragst "
     "Dich ob hier ueberhaupt niemand Ordnung macht. An einer der Waende "
     "kannst Du einen Fackelhalter samt Fackel entdecken. Vielleicht lohnt "
     "es sich ja, Dich hier ein bisschen genauer umzublicken. ");

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_HOUSE]) );

  AddExit( "oben", ROOM ("bib") );  


// DETAILBEGINN

  AddDetail( ({ "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "geheimbibliothek", "bibliothek" }),
     "Du bist etwas verwundert, ueberhaupt diesen Raum entdeckt zu "
     "haben. Es scheint als waere hier eine Art Geheimbibliothek, "
     "ueberall tuermen sich Kisten auf dem Boden und die Waende sind "
     "mit Regalen vollgemauert. ");

  AddDetail( ({ "regal", "regale" }),
     "Die Regale bestehen alle aus Holz, und reichen vom Boden bis "
     "zur Decke. In ihnen hat jemand anscheinend grosses Wissen angesammelt. "
     "Sie sind vollkommen mit Buechern und alten Schriften "
     "vollgestopft. Etwas Seltsames scheint sich in ihnen zu befinden. ");

  AddDetail( ({ "seltsames" }),
     "So leicht wirst Du es Dir wohl doch nicht machen! ");

  AddDetail( ({ "wissen" }),
     "Das Wissen in den Buechern stammt aus alter Zeit. Irgendwer "
     "hat sich hier sehr viel Muehe gemacht und die Schriften "
     "sorgfaeltig gesammelt. Mit der Zeit scheint dieser Raum wohl "
     "in Vergessenheit geraten zu sein. ");

  AddDetail( ({ "muehe" }),
     "Diese Person muss sich wirklich total viel Muehe gemacht haben. "
     "Vielleicht wollte sie jemanden auch nur vor grossen Fehlern "
     "bewahren? Du wirst es nicht erfahren wenn Du Dich nicht naeher "
     "damit auseinandersetzt. ");

  AddDetail( ({ "person" }),
     "Wenn Du nur wuesstest wer diese Person war, und was sie eigentlich "
     "damit bezwecken wollte. Irgendwo muss es doch einen Anhaltspunkt "
     "geben. ");    

  AddDetail( ({ "anhaltspunkt", "punkt" }),
     "Du bist Dir sicher, dass es einen Hinweis irgendwo hier versteckt "
     "geben muss. ");

  AddDetail( ({ "hinweis", "hinweise" }),
     "Ja den gibt es sicher, stellt sich nur die Frage wo. ");

  AddDetail( ({ "frage" }),
     "Diese Person wollte sicherlich etwas Bestimmtes bezwecken. ");

  AddDetail( ({ "bestimmtes" }),
     "Ja, Du bist Dir sicher, dass sie Dich und andere warnen wollte - "
     "warnen vor einer bestimmten Gefahr. ");

  AddDetail( ({ "gefahr" }),
     "Vielleicht findest Du ja Hinweise in einem der alten Buecher. ");

  AddDetail( ({ "alte buecher", "alten buecher" }),
     "Tatsaechlich, Du siehst Dir die Buecher nochmals genauer an, und "
     "entdeckst ein sonderbares Buch. ");

  AddDetail( ({ "sonderbares buch" }),
     "Ein ganz in Leder eingebundenes schwarzes Buch. Es scheint uralt zu "
     "sein. Du koenntest versuchen es zu lesen, wenn Du mutig genug bist. "
     "Vielleicht stehen ja ein paar nuetzliche Informationen drinnen. ");

  AddDetail( ({ "leder"}),
     "Schwarzes Leder umhuellt es. ");
 
  AddDetail( ({ "information", "informationen" }),
     "Nun lies doch endlich! ");

  AddDetail( ({ "boden", "fussboden" }),
     "Auf dem kalten Steinboden stapeln sich Buecherberge und Kisten. "
     "Es sieht hier einfach nur unordentlich aus. Aber vielleicht kannst "
     "Du ja trotzdem das eine oder andere entdecken. ");

  AddDetail( ({ "steinboden" }),
     "Der Boden besteht aus Stein. ");
 
  AddDetail( ({ "stein" }),
     "Der Stein fuehlt sich sehr kalt an, aber das wundert Dich nicht "
     "weiter. ");

  AddDetail( ({ "buecherstapel", "stapel", "buecherberge", "berge", "bergen" }),
     "Irgendwer hat hier eine grosse Menge an altem Wissen angesammelt. "
     "Du stoeberst etwas gelangweilt in einem der Berge, aber hier etwas "
     "zu finden wuerde an ein Wunder grenzen. ");

  AddDetail( ({ "wunder" }),
     "Doch abundzu gibt es Wunder, ueber die man sich freuen sollte. "
     "Dennoch kannst Du nichts in den Stapeln finden. ");

  AddDetail( ({ "stapeln" }),
     "Nein Du findest einfach nichts. An Deiner Stelle wuerd ich die "
     "Suche aufgeben. ");

  AddDetail( ({ "stelle" }),
     "Ich bin froh nicht an Deiner Stelle zu sein. ");

  AddDetail( ({ "suche" }),
     "Wonach suchst Du hier eigentlich? Nach Forscherpunkten?? ");

  AddDetail( ({ "forscherpunkt", "forscherpunkte", "forscherpunkten" }),
     "Den hast Du Dir noch lang nicht verdient. ");

  AddDetail( ({ "vergessenheit" }),
     "Manchmal geraten Dinge in Vergessenheit auch wenn man sie noch so "
     "versucht zu pflegen oder zu halten. Manchmal geraten auch Menschen "
     "in Vergessenheit, vielleicht will man sie auch nur vergessen, damit "
     "man sich nicht mit ihnen auseinandersetzen muss. So wie dieser "
     "Raum mit der Zeit in Vergessenheit geriet. ");

  AddDetail( ({ "dinge", "ding" }),
     "Wir versuchen oft Dinge zu vergessen, aber meistens verdraengen wir "
     "sie einfach nur. Und irgendwann kommt dann ein Tag wo alles in uns "
     "wieder hochkommt, und wir uns eingestehen muessen manches nicht "
     "verarbeitet zu haben. ");

  AddDetail( ({ "tag" }),
     "So ein Tag wie heute. Kennst Du nicht das eine Sprichwort? ");

  AddDetail( ({ "sprichwort" }),
     "Vom Himmel hoch jauchzend, zu Tode betruebt. ");

  AddDetail( ({ "himmel" }),
     "Der Himmel ist gross und weit, aber hier findest Du ihn nicht. ");

  AddDetail( ({ "tod", "tode" }),
     "Wenn Menschen sterben vergessen wir sie oft, aber auch die "
     "Lebenden werden von uns oft vergessen, weil wir alle zuviel "
     "Egoismus zeigen, bzw. dieser fuer uns oft wichtiger erscheint. ");

  AddDetail( ({ "menschen", "mensch" }),
     "Such sie draussen in Deinem Leben. ");

  AddDetail( ({ "leben" }),
     "Du gruebelst ueber Dein Leben nach und kommst zu dem Schluss, "
     "dass Du nie Dinge verdraengst! Damit kannst Du Dich echt "
     "gluecklich schaetzen. ");

  AddDetail( ({ "lebende", "lebenden" }),
     "Die solltest Du besser draussen suchen. ");

  AddDetail( ({ "egoismus" }),
     "Ein bisschen Egoismus schadet nie, solang man andere damit nicht "
     "verletzt. ");

  AddDetail( ({ "schluss" }),
     "Tipp mal: schlaf ein ");

  AddDetail( ({ "zeit" }),
     "Die Zeit ist eine der Maechte, die wir nicht beeinflussen koennen. ");

  AddDetail( ({ "maechte" }),
     "Es gibt viele Maechte, die wir nicht beeinflussen koennen. Die Zeit, "
     "den Wind, die Sonne, ... . Aber vielleicht schaffen wir das auch noch "
     "einmal. Wenn wir unsere Welt komplett zerstoert haben, und uns selbst "
     "mit dazu. ");

  AddDetail( ({ "wind", "sonne" }),
     "Der Wind und die Sonne sind wohl die schoensten Maechte von allen. ");

  AddDetail( ({ "welt" }),
     "Diese Welt heisst Silberland. ");

  AddDetail( ({ "silberland" }),
     "Das Silberland ist eine sehr schoene Welt. Die wir zum Glueck nicht "
     "dermassen zerstoeren koennen =) ");

  AddDetail( ({ "glueck" }),
     "Das Glueck ist das einzige, was sich verdoppelt, wenn man es teilt. ");

  AddDetail( ({ "holz" }),
     "Das Holz stammt wahrscheinlich aus dem Dschungel. ");

  AddDetail( ({ "dschungel" }),
     "Dorthin kommst Du am besten mit dem Handelsschiff von Derlim aus. ");

  AddDetail( ({ "derlim", "hobbingen" }),
     "Du bist sicher durch Derlim hierher gekommen. ");

  AddDetail( ({ "handelsschiff", "schiff" }),
     "Versuch einfach Dein Glueck beim Steg von Derlim. ");

  AddDetail( ({ "steg" }),
     "Den musst Du in Derlim suchen. ");

  AddDetail( ({ "kisten" }),
     "Die Kisten liegen ueberall auf dem Boden. Sie sind alle geoeffnet "
     "und viele Buecher und Schriften stapeln sich in ihnen. ");

  AddDetail( ({ "buecher", "buch", "schriften", "schrift" }),
     "Die Buecher und Schriften scheinen offenbar sehr alt zu sein. "
     "Du bist noch immer ziemlich verwundert, in diesem Raum ueberhaupt "
     "soetwas zu finden. Also erwartet haettest Du das sicherlich nicht. ");

  AddDetail( ({ "decke" }),
     "So wie der Boden besteht auch die Decke aus Stein. Einige "
     "Spinnweben haengen von ihr herab. Nach 'oben' kannst Du diesen "
     "Raum wieder verlassen. ");

  AddDetail( ({ "spinnweben" }),
     "Sie haengen einfach nur von der Decke herunter. Spinnen kannst Du "
     "nicht sehen. ");

  AddDetail( ({ "spinnen", "spinne" }),
     "Ich sagte doch, dass Du keine sehen kannst!!!!!! "
     "Oder etwa doch?" );

  AddDetail( ({ "menge" }),
     "Eine grosse Menge Wissen hat hier wer angesammelt. "); 

  AddDetail( ({ "fehler", "fehlern" }),
     "Wir alle machen Fehler, niemand ist vollkommen. Aber Fehler "
     "kann man wieder gut machen! ");

  AddDetail( ({ "wand", "waende" }),
     "Vor lauter Regalen kannst Du die Waende kaum erkennen. Nur an "
     "einer siehst Du einen Fackelhalter samt Fackel. ");

  AddDetail( ({ "fackelhalter", "halter" }),
     "Ein einfacher Fackelhalter. In ihm steckt eine Fackel. "
     "Du koenntest ja probieren sie mal anzuzuenden oder gar zu loeschen." );

  AddDetail( ({ "fackel" }),
     "Sie scheint ziemlich abgebrannt zu sein und spendet nur wenig Licht. ");

  AddDetail( ({ "licht" }),
     "Allzuviel Licht gibt es hier nicht. ");

  AddDetail( ({ "ordnung" }),
     "Niemand macht sich hier anscheinend Gedanken ueber Ordnung. ");

  AddDetail( ({ "gedanken", "gedanke" }),
     "Du beginnst zu denken. Aber Gedanken ueber Ordnung kommen auch Dir "
     "nicht in den Sinn. ");

  AddDetail( ({ "sinn", "sinne" }),
     "Du hast 5 Sinne normalerweise: fuehlen, schmecken, riechen, sehen "
     "und hoeren. Aber es gibt sicherlich noch mehr... ");

  AddDetail( ({ "art", "arten" }),
     "Jeder hat seine eigene Art und das ist auch gut so. ");
 
  AddDetail( ({ "halterung" }),
     "In der Halterung befindet sich eine Fackel. ");  
 
  AddReadDetail( ({ "sonderbares buch", "schwarzes buch" }),
     "Die ALTEN waren, die ALTEN sind und die ALTEN werden sein. Nicht in den "
     "Raeumen, die uns bekannt sind, sondern zwischen ihnen gehen sie gelassen "     "und unbeirrt umher, ohne Dimension und fuer unsere Augen unsichtbar. "
     "YOG-SOTHOTH kennt das Tor. YOG-SOTHOTH ist das Tor. YOG-SOTHOTH ist "
     "Schluessel und Waechter des Tores. Vergangenheit, Gegenwart, Zukunft, "
     "alles ist YOG-SOTHOTH. Er weiss wo einst die GROSSEN ALTEN herausbrachen "     "und wo sie wieder herausbrechen werden. Aber huete Dich vor ihnen! ");

// DETAILENDE


// SOUNDS

  AddSound(DEFAULT_SOUND,
     "Die Fackel knistert ruhig vor sich hin. Sonst vernimmst Du kaum "
     "Laute. ");

  AddSound( ({ "laut", "laute" }),
     "Nein eigentlich hoerst Du gar nichts. ");

  AddSound( ({ "fackel", "knistern" }),
     "Die Fackel gibt abundzu ein leises Knistern von sich. ");


// SMELLS

  AddSmell(DEFAULT_SMELL,
     "Die Buecher riechen alle vermodert. Ein irrsinniger Gestank erfuellt "
     "den Raum. Es gibt hier wohl keine Lueftung. ");

  AddSmell( ({ "buecher" }),
     "Igitt das stinkt, bald musst Du Dich uebergeben. ");

  AddSmell( ({ "lueftung" }),
     "Du versuchst eine Lueftung zu erriechen scheiterst aber klaeglich. ");

  AddSmell( ({ "gestank" }),
     "Der Gestank scheint von den Buechern auszugehen. Sie muessen hier "
     "wohl schon ewig lange lagern. ");

  

  AddCmd( ({ "teil", "teile" }), "c_teilen" );
  AddCmd( ({ "zuende", "zuend" }), "c_zuenden" );  
  AddCmd( ({ "loesch", "loesche" }), "c_loeschen" );
  AddCmd( ({ "sehe", "seh", "sieh" }), "c_sehen" );
  AddCmd( ({ "fuehle", "fuehl" }), "c_fuehlen" );
  AddCmd( ({ "schmecke", "schmeck" }), "c_schmecken" );
  AddCmd( ({ "hoere", "hoer" }), "c_hoeren" );


}

int c_fuehlen( string str )
{
 if ( !str) 
 {
  write(BS( "Du streckst Deine Arme aus und fuehlst.\n"
            "Gar nicht so einfach, hast Du das etwa verlernt?\n"));
  say(CTPN+ " fuchtelt komisch in der Gegend herum.\n");
  return 1;
 }
 return 0;
}

int c_schmecken( string str )
{
 if( !str) 
 {
  write(BS( "Du streckst Deine Zunge in die Luft schmeckst aber nichts!\n"));
  say(CTPN+ " streckt "+this_player()->QueryPossPronoun(NEUTER, WEN, PLURAL)+
             " Zunge komisch in die Luft.\n");
  return 1;
 }
 return 0;
}

int c_hoeren( string str )
{
 if( !str) 
 {
  write(BS( "Du ziehst mit Deinen Haenden Deine Ohren lang, kannst "
            "allerdings nicht hoeren - probiers mal mit lauschen!\n"));
  say(CTPN+ " versucht "+this_player()->QueryPossPronoun(NEUTER,WEN,PLURAL)+
             " Ohren langzuziehen.\n");
  return 1;
 }
 return 0;
}

int c_teilen( string str )
{
 if (str != "glueck" )
 {
  notify_fail("Was moechtest Du hier teilen?\n" );
  return 0;
 }
 if (str == "glueck" )
 {
  write(BS( "Du teilst Glueck mit jemandem den Du gerne hast.\n" ));
  return 1;
 }
}

 int c_sehen( string str )
 {
  if (str != "spinnen" )
  {
   notify_fail( "Was moechtest Du hier sehen?\n" );
   return 0;
  }
  if (str == "spinnen" )
  {
    write( break_string("Tatsaechlich kannst Du einige Spinnen erkennen. "
           "Aber sie beschaeftigen Dich nicht weiter. "));
    return 1;
  }
} 
 int c_zuenden( string str ) 
{ 
 if (str != "fackel an")
  
 {
  notify_fail( "Was moechtest Du hier anzuenden?\n" ); 
  return 0; 
  
 }
  if (QueryProp(P_LIGHT) > 0)
  {
    write( "Aber die Fackel brennt doch schon laengst!\n" );
    return 1;
  }
    write( "Du zuendest die Fackel im Halter an.\nEs wird etwas heller.\n" );
    say(CTPN+ " zuendet eine Fackel an.\n" );
    SetProp(P_LIGHT, 1);
    return 1;
}

int c_loeschen( string str )
{
  if (str != "fackel" )
  {
    notify_fail( "Was moechtest Du hier denn loeschen?\n" );
    return 0;
  }
  if (QueryProp(P_LIGHT) <= 0)
  {
    write( "Aber die Fackel brennt doch gar nicht!\n" );
    return 1;
  }
    write( "Du fuehrst einige seltsame Bewegungen aus, die dazu fuehren, "
           "dass die Fackel in der Halterung ausgeht.\n" );
    SetProp(P_LIGHT, 0);
    return 1;
}

void reset()
{
  ::reset();
  if (QueryProp(P_LIGHT) <= 0)
  {
    tell_room( this_object(),
            "Wie von Geisterhand entzuendet sich die Fackel auf einmal "
            "von selbst.\n" );
    SetProp(P_LIGHT, 1);
  }

}









































