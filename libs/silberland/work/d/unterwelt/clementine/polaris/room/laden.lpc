inherit "std/laden";

#include <properties.h>
#include <language.h>
#include "../marisol.h"
#include <laden.h>

create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem kleinen Laden");
  SetProp(P_INT_LONG, 
        "Du befindest Dich in einem kleinen verlassenen Laden. Die "
        "Waende sind alle mit Regalen zugemauert, in denen sich "
        "alle moeglichen Arten von Ausruestung befinden. "
        "Im Norden steht eine grosse Theke, an der man Waren "
        "erstehen kann. Blick Dich hier ruhig einige Zeit um, "
        "vielleicht findest Du ja etwas Brauchbares. "
        "An einer Wand gleich neben dem Eingang kannst Du "
        "ein grosses Schild erkennen. "
        "Nach Sueden kommst Du wieder auf die Strasse zurueck. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:18, ENV_TERRAIN:TT_HOUSE ]) ); 
 
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "harbad");
  SetProp(P_SHOPKEEPER_NAME, "Harbad");
  SetProp(P_SHOPKEEPER_GENDER, MALE);

  SetStorageRoom(ROOM ("store.lpc") );

  AddExit( "sueden", ROOM ("room6") );

  AddItem(NPC ("harbad"), REFRESH_DESTRUCT);

  NewDoor( "sueden", ROOM ("room6"), ({"tuer", "tuere", "birkentuer" }),
     ({ D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
        D_NAME, "Birkentuer",
        D_GENDER, FEMALE,
        D_SHORT, "Im Sueden befindet sich eine %se Birkentuer.",
        D_LONG, "Eine alte Birkentuer, die wenn der Wind geht "
                "leise knirscht. "
                "Man kann sie mit Hilfe eines "
                "Riegels oeffnen und wieder schliessen. ",
        D_MSGS, ({ "hinaus", "geht wieder", "kommt herein" }),
        D_OPENMSG, ({ "Mit lautem Knarren schiebst Du den Riegel beiseite "
                      "und die Tuer oeffnet sich. ",
                      "Mit lautem Knaaren schiebt %s den Riegel beiseite.",
                      " wird mit lautem Knarren von aussen geoeffnet." }),
        D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du die Tuer.",
                       "Mit einem lauten Rumms schliesst %s die Tuer.",
                       " wird mit lautem Knarren von aussen geschlossen." }),
        D_RESET_OPENMSG, " wird durch einen Windstoss geoeffnet. " }) );


// DETAILBEGINN

  AddDetail( ({ "boden" }),
     "Der Boden besteht aus alten Holzdielen. Bei jedem Deiner "
     "Schritte knirschen sie etwas. ");

  AddDetail( ({ "schritte", "schritt" }),
     "Du machst einen Schritt nach vorne.\n"
     "Knirschen erfuellt den Raum.\n");

  AddDetail( ({ "knirschen" }),
     "Versuch doch lieber zu lauschen!");

  AddDetail( ({ "holzdielen", "dielen" }),
     "Die Holzdielen knirschen bei jedem Deiner Schritte. Sie "
     "scheinen schon sehr alt zu sein und bestehen wie alles andere "
     "hier aus Birkenholz. ");

  AddDetail( ({ "birkenholz", "holz" }),
     "Das Holz stammt sicher von einer moorigen Gegend. ");

  AddDetail( ({ "gegend" }),
     "Weiter in westlicher Richtung befindet sich ein Moor. ");

  AddDetail( ({ "moor" }),
     "Geh hin und erkunde es, wenn Du mutig genug bist!");

  AddDetail( ({ "richtung", "richtungen" }),
     "Richtungen gibt es viele!");

  AddDetail( ({ "waende" }),
     "An den Waenden wurden grosse hohe Regale aufgestellt, in denen "
     "verschiedene Arten von Waren gelagert werden. ");

  AddDetail( ({ "regale", "regal" }),
     "In den Regalen liegen verschiedene Arten von Ruestungen und alle "
     "moeglichen Gebrauchsgegenstaende. Der Besitzer hat sie alphabetisch "
     "geordnet damit die Ordnung gewahrt wird. ");

  AddDetail( ({ "besitzer" }),
     "Er scheint gerade nicht hier zu sein. Leider kannst Du allerdings "
     "in seiner Abwesenheit weder Gegenstaende kaufen noch verkaufen. ");
     
  AddDetail( ({ "abwesenheit" }),
     "Der Besitzer scheint gerade nicht da zu sein. ");

  AddDetail( ({ "muenzen" }),
     "Mach mal 'unt muenzen' dann siehst Du wieviel Du mithast. ");

  AddDetail( ({ "preis" }),
     "Der Besitzer des Ladens hat sicherlich faire Preise gesetzt, es "
     "wuerde sich nicht lohnen ihn zu betruegen. ");

  AddDetail( ({ "ordnung" }),
     "'Ordnung muss sein!' das sagte sogar schon Platon. ");

  AddDetail( ({ "platon" }),
     "Kennst Du Platon denn nicht? Er ist schliesslich Zweitie von Dejot!");

  AddDetail( ({ "dejot", "zweitie" }),
	 "Ihr muesst schon Katran fragen, warum ich das Detail einbauen hab "
	 "muessen.");

  AddDetail( ({ "katran", "detail" }),
	 "Nicht nerven!");

  AddDetail( ({ "arten", "art" }),
     "In diesem Laden kannst Du verschiedene Arten von Gegenstaenden "
     "erstehen. Sie wurden alle alphabetisch in den Regalen geschlichtet. ");

  AddDetail( ({ "laden" }),
     "Du stehst in einem kleinen verlassenen Laden in Polaris. ");

  AddDetail( ({ "polaris" }),
      "Man erzaehlt sich, dass in Polaris Hexen hausen sollen. ");

  AddDetail( ({ "hexen" }),
      "Noch hast Du keine gesehen - oder doch?");

  AddDetail( ({ "gegenstaende", "ruestungen", "gebrauchsgegenstaende",
                "ausruestung", "brauchbares" }),
      "Wenn Du wissen moechtest, was es hier so gibt, lies einfach "
      "das Schild am Eingang. ");

  AddDetail( ({ "eingang" }),
      "Durch eine Birkentuer bist Du hier hereingekommen und durch dieselbige "
      "kannst Du den Laden auch wieder verlassen. ");   
 
  AddDetail( ({ "schild" }),
      "Ein grosses Schild haengt gleich beim Eingang, Du kannst es lesen!");

  AddDetail( ({ "raum" }),
      "Ein kleiner Laden. ");

  AddDetail( ({ "strasse" }),
      "Im Sueden kommst Du durch eine Tuer wieder auf die Strasse. ");

  AddDetail( ({ "theke" }),
      "Eine Theke aus Holz dient zum An- und Verkauf von Waren. ");

  AddDetail( ({ "ankauf", "verkauf" }),
      "Lies doch das Schild!");

  AddDetail( ({ "riegel" }),
      "Mit dem Riegel ist es Dir moeglich die Tuer zu oeffnen oder "
      "zu schliessen. ");

  AddDetail( ({ "hilfe" }),
      "Der Riegel hilft Dir die Tuere zu schliessen oder auch zu oeffnen. ");

  AddDetail( ({ "wind" }),
      "Manchmal laesst der Wind die alte Tuere in ihren Angeln quietschen. ");

  AddDetail( ({ "angeln", "angel" }),
      "Ohne Angeln wuerde die Tuer wohl in der Luft schweben, und das ist "
      "aufgrund der Schwerkraft gar nicht moeglich. ");

  AddDetail( ({ "schwerkraft", "erdanziehungskraft" }),
      "Ohne Schwerkraft oder Erdanziehungskraft wuerden wir schwerelos im "
      "Raum schweben. Dabei waere schweben doch manchmal wirklich schoen, "
      "nicht? ");

  AddDetail( ({ "luft" }),
      "Sehen kannst Du Luft bestimmt nicht! ");

  AddDetail( ({ "zeit" }),
      "Nimm Dir Zeit und blick Dich hier um. ");

  AddDetail( ({ "wand" }),
      "An der Wand gleich beim Eingang haengt ein grosses Schild. Du "
      "solltest es vielleicht lesen! ");
 
  AddDetail( ({ "waren" }),
      "Hast Du denn Waren anzubieten oder willst Du vielleicht sogar "
      "welche kaufen? ");

  AddDetail( ({ "decke", "holzdecke" }),
      "Eine morsche Holzdecke befindet sich dicht ueber Dir. Der Raum "
      "ist nicht so hoch. An der Decke kannst Du einige Fackelhalter "
      "samt Fackeln erkennen. ");

  AddDetail( ({ "fackelhalter", "halter" }),
      "Die Halter halten die Fackeln. ");

  AddDetail( ({ "fackeln" }),
      "Ohne diese Fackeln waere es in der Nacht wohl sehr finster hier. "
      "Augenblicklich brennt aber keine einzige. ");

  AddDetail( ({ "nacht" }),
      "Der Tag siegt ueber die Nacht, genauso wie das Gute ueber das "
      "Boese siegt! Aber ohne Nacht waere der Tag nicht so wie er ist, und "
      "ohne das Boese wuerde das Gute eine andere Bedeutung bekommen. ");

  AddDetail( ({ "bedeutung" }),
      "Du darfst Dir selbst eine Bedeutung aussuchen. ");

  AddDetail( ({ "gute", "boese", "gutes", "boeses" }),
      "Am besten waere wohl, wenn Du Ayla danach fragen wuerdest. ");

  AddDetail( ({ "ayla" }),
      "Ayla findest Du auf der Burg Sturmfels im Gebirge. ");

  AddDetail( ({ "burg", "sturmfels" }),
      "Du kniest nieder und betest zu Dusty. ");

  AddDetail( ({ "dusty", "goettin" }),
      "Dusty ist die allmaechtigste Goettin des Silberlandes. ");

  AddDetail( ({ "silberlandes", "silberland" }),
      "Wo befindest Du Dich denn gerade? ");

  AddDetail( ({ "tag" }),
      "Der Tag kann ohne die Nacht nicht bestehen. ");

  AddDetail( ({ "gebirge" }),
      "Hier findest Du kein Gebirge. ");

  AddDetail( ({ "flaeschchen" }),
    "Komisch, Du kannst keine Flaeschchen entdecken. ");

 
// DETAILENDE


// SOUNDS

  AddSound(DEFAULT_SOUND,
      "Eigentlich ist es hier absolut still. Nur manchmal kann man "
      "Harbad ueber seine Arbeit stoehnen hoeren. ");

  AddSound( ({ "arbeit" }),
      "Anscheinend hat der Zwerg sehr viel zu tun. ");

  AddSound( ({ "zwerg" }),
      "Hektisch geht er auf und ab und ordnet Gegenstaende alphabetisch "
      "in die Regale ein. ");

  AddSound( ({ "gegenstaende" }),
      "Sie geben kein Geraeusch von sich. ");

  AddSound( ({ "geraeusch" }),
      "Nichts zu hoeren. ");

  AddSound( ({ "regale" }),
      "Manchmal knarrt eins der Regale etwas, aber sonst ist alles still "
      "hier. ");

  AddSound( ({ "knirschen", "schritte", "schritt" }), 
      "*knirsch*");

// SMELLS

  AddSmell(DEFAULT_SMELL,
      "Es riecht etwas nach Moder. Aus einem Regal kommt ein besonders "
      "aetzender Geruch. ");

  AddSmell( ({ "moder" }),
      "Manches Gewand scheint hier wohl ewig schon zu lagern. ");

  AddSmell( ({ "gewand" }),
      "Igitt!! Das stinkt gewaltig. Also kaufen solltest Du das hier "
      "besser nicht. ");

  AddSmell( ({ "geruch" }),
      "Der Geruch geht von einem kleinen Flaeschchen aus. ");

  AddSmell( ({ "flaeschchen" }),
      "Anscheinend bewahrt Harbad in diesem Flaeschchen eine Saeure auf. ");

  AddSmell( ({ "saeure" }),
      "Wofuer diese wohl gut ist? ");

  AddSmell( ({ "regal" }),
      "Etwas stimmt hier nicht. ");



 AddReadDetail( ({ "schild" }),  
       "|-----------------------------------------------|\n"
       "|            Herzlich Willkommen !              |\n"
       "|                                               |\n"
       "| Folgende Befehle sind hier moeglich:          |\n"
       "|                                               |\n"
       "| * zeige                                       |\n"
       "| * zeige rue(stungen)                          |\n"
       "| * zeige waf(fen)                              |\n"
       "| * zeige ver(schiedenes)                       |\n"
       "|                                               |\n"
       "| * kaufe    <gegenstand> bzw. <nummer>         |\n"
       "| * verkaufe <gegenstand> bzw. alles            |\n"
       "| * schaetz  <gegenstand>                       |\n"
       "|                                               |\n"
       "|-----------------------------------------------|\n");

  AddCmd( ({ "schwebe", "schweb" }), "c_schweben");
  AddCmd( ({ "putz", "putze" }), "c_putzen");


}


int c_schweben( string str )
{
 if( !str)
 {
  write(BS("Auf einmal ist die Schwerkraft fuer Dich nicht mehr vorhanden. "
           "Langsam beginnst Du in die Luft zu steigen. Ist das schoen! "
           "Doch halt! Was ist das? Igiit die Fackelhalter wurden aber schon "
           "lang nicht mehr geputzt! Vor lauter Grausen schwebst Du wieder auf "
           "den Boden. Aus der Spass!\n"));

  say(CTPN+ " schwebt kurz in der Luft, verzieht dann aber komisch das "
            "Gesicht und landet wieder auf dem Boden.\n");
  return 1;
  }
}

int c_putzen( string str )
{
 

 if(!str || str == "" ) 
 {
  write(BS("Was moechtest Du hier putzen?\n"));
  return 1;
 }
 
 if(!(str == "fackelhalter"   ||
      str == "halter"        )) return 1; 
 {
  write(BS("Du holst ein etwas zerknittertes Tuch aus einer Tasche "
           "heraus und reinigst gruendlich die Fackelhalter. Doch siehe "
           "da - nach nur einer Sekunde sehen die Halter genauso aus wie "
           "vorher. "));

  say(CTPN+ " werkt an den Fackelhaltern herum.\n");
  return 1;
 }
}

