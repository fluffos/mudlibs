// In der Huette findet man:
// -------------------------
//
// - Sequenz
// - Tuerbsp
// - einige AddCmds
// - Heilstelle
// - Versteckte Falltuer
// - wie man in der Lib verankerte Befehle ueberschreibt...
//

inherit "std/room";

#include <moredef.h>
#include <defines.h>
#include <properties.h>
#include <moving.h>
#include <language.h>
#include "../marisol.h"
#include <room/doors.h>

create()
{

  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "In einer Holzhuette" );
  SetProp(P_INT_LONG,
     "Du stehst in einer alten Holzhuette, die abrupt verlassen worden zu "
     "sein scheint. An der Westwand glueht noch einiges abgebranntes Holz " 
     "in einer Feuerstelle. An der Nordwand kannst Du ein Fenster erkennen. "
     "Davor steht ein Tisch mit zwei Stuehlen. Auch einige private "
     "Gegenstaende stehen noch wahllos in der Gegend herum. Der Vorbesitzer "        "schien wohl keine Zeit mehr zum Packen gehabt zu haben. "                      "In einer Ecke siehst "
     "Du einen Strohsack, der wohl als Bett gedient hat. "
     "Auf dem alten Boden liegt ein etwas loechriger Teppich. ");
  
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_HOUSE]) );
  SetProp(P_INDOORS, 1);


// DETAILBEGINN

  AddDetail( ({ "boden" }),
     "Auf dem Boden liegt ein etwas loechriger Teppich. Er verdeckt "
     "den darunter liegenden Holzboden aber nur zum Teil. ");

  AddDetail( ({ "holzboden" }),
     "Ein Holzboden besteht, wie der Name schon sagt, aus Holz. In "
     "diesem Fall sicher Birkenholz. ");

  AddDetail( ({ "fall" }),
     "Nur in diesem Fall. ");

  AddDetail( ({ "name" }),
     "Lass mich raten...Du heisst nicht Kleine =) ");

  AddDetail( ({ "kleine" }),
     "Nein, Du heisst sicher nicht Kleine, sonst wuerdest Du nicht so "
     "gierig nach Forscherpunkten suchen. ");

  AddDetail( ({ "forscherpunkte", "forscherpunkten" }),
     "Nein Du bekommst sicherlich keine von mir! ");

  AddDetail( ({ "holz" }),
     "Welches Holz meinst Du denn? Birkenholz oder das in der "
     "Feuerstelle? ");  
 
  AddDetail( ({ "birkenholz" }),
     "Der Boden besteht sicher aus Birkenholz, warum sollte man auch "
     "von weit her das Holz transportieren, wenn es im nahen "
     "Birkenwaeldchen auch waechst? ");

  AddDetail( ({ "birkenwaeldchen", "waeldchen" }),
     "Das hast Du doch schon sicher auf Deinem Weg hierher gesehen. ");

  AddDetail( ({ "weg" }),
     "Dein Weg war muehsam und beschwerlich. Du bist sogar noch "
     "klitschnass! Hoffentlich erkaeltest Du Dich nicht! Waerm Dich "
     "doch etwas an der Feuerstelle. ");

  AddDetail( ({ "feuerstelle" }),
     "Eine kleine Feuerstelle befindet sich an der Westwand. Das Holz, "
     "das sich darin befindet, ist noch nicht einmal richtig verglueht. "
     "Jemand scheint es wohl da sehr eilig gehabt zu haben, denn ueber "
     "dem Feuer befindet sich sogar noch ein Topf mit warmer Suppe. ");

  AddDetail( ({ "feuer" }),
     "Das Feuer brennt nicht mehr wirklich. Nur einige Holzstuecke "
     "gluehen noch ein wenig und verbreiten etwas Rauch. ");

  AddDetail( ({ "holzstuecke" }),
     "Kleine Holzstuecke gluehen noch munter vor sich hin. Es ist sicher "
     "noch nicht solange her, dass sie jemand ins Feuer gelegt hat. ");

  AddDetail( ({ "westwand" }),
     "Die Westwand ist die einzige Wand, die nicht ausschliesslich aus "
     "Holz besteht, sondern auch zu einem gewissen Teil aus Stein. "
     "Der Grund dafuer ist wohl die kleine Feuerstelle. ");

  AddDetail( ({ "grund" }),
     "Die eine Wand besteht deshalb auch aus Stein, da sonst ja das "
     "Feuer, sofern eines da ist, uebergreifen wuerde auf das Holz. ");

  AddDetail( ({ "wand", "waende" }),
     "Welche Wand meinst Du? ");

  AddDetail( ({ "stein" }),
     "Kleine Steinchen wurden an einem Teil der Wand aufeinander gestapelt "
     "und mit Lehm verputzt. ");

  AddDetail( ({ "steinchen" }),
     "Steinchen, die man hie und da so findet. ");

  AddDetail( ({ "lehm", "lehms" }),
     "Mit Hilfe des Lehms wurden die Steinchen in die Holzwand eingefuegt. "
     "So etwas nennt man auch verputzen. ");

  AddDetail( ({ "holzwand" }),
     "Die Waende bestehen vorwiegend aus Birkenholz. Aber das solltest Du "
     "schon wissen. ");

  AddDetail( ({ "fenster" }),
     "Das Fenster hat einen hoelzernen Rahmen. Rechts und links davon "
     "wurden Vorhaenge angebracht. Blick doch mal aus dem Fenster, wenn "
     "Du wissen willst, was sich draussen befindet. ");

  AddDetail( ({ "vorhaenge", "vorhang" }),
     "Vorhaenge aus einem seltsamen Stoff zieren das Fenster. ");

  AddDetail( ({ "rahmen" }),
     "Das Fenster besteht eigentlich nur aus einem hoelzernen Rahmen, "
     "in den eine Scheibe Glas eingefasst wurde. "
     "Nur waere es komisch anstatt Fenster einfach nur Rahmen mit Glas "
     "zu sagen =)" );

  AddDetail( ({ "glas" }),
     "Durch Glas kann man durchschauen, ausser es wurde fuer 240 Jahre nicht "
     "geputzt. ");

  AddDetail( ({ "scheibe" }),
     "Die Erde gleicht einer Scheibe, oder wars doch ne Kugel? ");

  AddDetail( ({ "erde" }),
     "Na wo befinden wir uns hier gerade? ");

  AddDetail( ({ "silberland" }),
     "Geh hinaus, blick Dich um, dann weisst Du was das Silberland ist. ");
  
  AddDetail( ({ "kugel" }),
     "Nein, Du hast schon recht! Die Erde ist eine Kugel. ");

  AddDetail( ({ "jahre" }),
     "Die Jahre streichen an Dir vorueber und hinterlassen Spuren. ");
 
  AddDetail( ({ "spuren" }),
     "Schau mal in den Spiegel. Hier und dort bilden sich sogar schon Falten "
     "in Deinem Gesicht. ");

  AddDetail( ({ "spiegel" }),
     "Hast Du keinen dabei? Schade. ");

  AddDetail( ({ "falten" }),
     "Na schau doch mal genau. Siehst Du nicht diese Falte in Deinem "
     "Gesicht? ");

  AddDetail( ({ "gesicht" }),
     "Dein Gesicht ist ein Teil von Deinem Kopf! ");

  AddDetail( ({ "teil" }),
     "Teil = Teil ");

  AddDetail( ({ "falte" }),
     "Na diese Falte, diese grosse Falte hier. Siehst Du sie nicht? "
     "Na die hier! Du solltest nicht so angestrengt denken beim Forschen! ");

  AddDetail( ({ "forschen" }),
     "Tja, wuerdest Du nicht forschen, haettest Du keine Falten. Geh doch "
     "lieber etwas metzeln! ");
 
  AddDetail( ({ "kopf" }),
     "Mein Gott! Weiss ich denn wie Dein Kopf aussieht? ");

  AddDetail( ({ "gott" }),
     "Du kniest nieder und haeltst eine Andacht zu einem Gott Deiner Wahl. ");

  AddDetail( ({ "wahl" }),
     "Die hat man immer! ");

  AddDetail( ({ "andacht" }),
     "Es gibt verschiedene Arten von Andachten, die Osterandacht ist eine. ");

  AddDetail( ({ "arten", "art" }),
     "Welche Art wovon meinst Du denn? ");

  AddDetail( ({ "osterandacht" }),
     "Haben wir jetzt Ostern? Nein, also was soll die Frage? ");

  AddDetail( ({ "ostern" }),
     "Bist Du wirklich so katholisch oder tust Du nur so? ");

  AddDetail( ({ "frage" }),
     "Untersuch doch nicht jeden Schwachsinn! Wenn Du eine Frage hast, "
     "dann tipp doch mal '-a FRAGE !!!!!' ");

  AddDetail( ({ "schwachsinn" }),
     "Der schwache Sinn. ");

  AddDetail( ({ "sinn" }),
     "Also mit Dir zu reden hat nun echt keinen Sinn mehr. Untersuch doch was "
     "Sinnvolleres! ");

  AddDetail( ({ "sinnvolleres" }),
     "Nein, jetzt mag ich nichts mehr beschreiben =) ");

  AddDetail( ({ "strohsack", "sack" }),
     "In einer der Ecken liegt ein Strohsack. Er diente wohl jemandem "
     "als Schlafstaette. Wie der Name schon sagt besteht er aus einem Sack, "
     "der mit Stroh gefuellt worden ist.\nDu denkst . o O (kein so ein "
     "nettes Bett wie meines.)\n");

  AddDetail( ({ "schlafstaette", "staette" }),
     "Der Strohsack diente jemandem als Bett. ");

  AddDetail( ({ "tag", "tages", }),
     "Eines Tages wird die Zeit schon kommen. ");

  AddDetail( ({ "zeit" }),
     "Irgendwann ist die Zeit reif...Du bist Dir ganz sicher. ");
 
  AddDetail( ({ "bett" }),
     "Der Strohsack diente dieser Person als Bett. ");

  AddDetail( ({ "person" }),
     "Vielleicht lernst Du ja diese Person eines Tages kennen. ");

  AddDetail( ({ "stroh" }),
     "In dem Sack befindet sich Stroh. Es wurde wahrscheinlich mal auf einer "
     "Wiese abgemaeht und in den Sack gestopft, als es getrocknet war. ");

  AddDetail( ({ "wiese" }),
     "Wiesen gibt es viele im Silberland nur leider nicht in Polaris. "
     "Falls Du eher nach einer Weide suchst, dann wuerdest Du in Derlim "
     "fuendig werden. ");

  AddDetail( ({ "weide" }),
     "Die ist in Derlim. ");

  AddDetail( ({ "derlim", "hobbingen" }),
     "Derlim oder auch Hobbingen genannt liegt ganz in der Naehe. ");

  AddDetail( ({ "naehe" }),
     "Zu Fuss kannst Du Derlim sicherlich in wenigen Minuten erreichen. ");

  AddDetail( ({ "minuten" }),
     "Kommt darauf an wie lang Du troedelst auf Deinem Weg. ");

  AddDetail( ({ "polaris", "stadt" }),
     "Du befindest Dich in der Stadt Polaris. ");

  AddDetail( ({ "teppich" }),
     "Ein etwas loechriger Teppich verdeckt etwas den noch aelteren "
     "Boden. Zwischen den Loechern kannst Du aber den Holzboden deutlich "
     "erkennen. ");

  AddDetail( ({ "loecher" }),
     "Der Teppich hat schon einige Loecher. Er scheint wohl schon sehr "
     "alt zu sein. Wahrscheinlich ist auch, dass schon viele Menschen ueber "
     "ihn gingen. ");

  AddDetail( ({ "menschen" }),
     "Als Du nochmal den Teppich genauer unter die Lupe nimmst, fallen Dir "
     "Fusspuren auf. ");

  AddDetail( ({ "lupe" }),
     "Als Du genauer hinblickst ist gemeint. ");

  AddDetail( ({ "fusspuren", "fussspuren" }),
     "Tatsaechlich auf dem Teppich befinden sich Fusspuren, aber "
     "sicherlich nicht von nur einem Lebewesen. ");

  AddDetail( ({ "lebewesen" }),
     "Die Fusspuren stammen nicht nur von einer Person, dafuer sind sie "
     "viel zu verschieden. Du beginnst Dich zu wundern, warum dieser "
     "loechrige Teppich eigentlich keine Hinweise von Staub aufweist. ");

  AddDetail( ({ "hinweise", "staub" }),
     "Du faehrst mit dem Finger ueber den Teppich...kein Staub weit und breit. "
     "Seltsam denkst Du Dir...warum liegt hier ueberhaupt kein Staub? ");

  AddDetail( ({ "finger" }),
     "Alle noch dran. ");

  AddDetail( ({ "riegel", "riegels" }),
     "Mit dem Riegel kann man die Tuer oeffnen, sofern sie geschlossen ist. ");

  AddDetail( ({ "topf" }),
     "Ueber der Feuerstelle baumelt ein Topf, der an einem Eisengestell "
     "montiert wurde. Die Suppe darin scheint noch warm zu sein.\nDein Bauch "
     "knurrt.\n");

  AddDetail( ({ "suppe" }),
     "Riech doch mal nach der Suppe. Schmecken wuerde sie sicherlich "
     "herrlich. ");

  AddDetail( ({ "eisengestell", "gestell", "eisen" }),
     "Ein kleines Gestell aus Eisen haengt ueber der Feuerstelle. An "
     "ihm wurde ein kleiner Topf befestigt, mit dessen Hilfe wohl gekocht wird "
     "oder eher wurde. ");

  AddDetail( ({ "rauch" }),
     "Etwas Rauch steigt noch vom Feuer auf. ");

  AddDetail( ({ "hilfe" }),
     "Tipp einfach nur: 'hilfe' ");

  AddDetail( ({ "funktion" }),
      "Nicht erwuenschten Personen das Eindringen in diese Huette zu "
      "verwehren. ");

  AddDetail( ({ "vorbesitzer", "besitzer" }),
      "Der Besitzer dieser Huette scheint sie abrupt verlassen zu haben. "
      "Warum weisst Du aber bis jetzt auch noch nicht. ");

  AddDetail( ({ "huette", "holzhuette" }),
      "Es ist eine einfache Huette hier, die fast vorwiegend aus Holz "
      "besteht. Du kannst eine Feuerstelle, einen Tisch mit zwei "
      "Stuehlen und noch einiges erkennen. ");

  AddDetail( ({ "stuehle", "stuhl", "holzstuehle", "holzstuhl" }),
      "Einfache Holzstuehle stehen neben dem Tisch. Sie besitzen "
      "jeweils eine Lehne. Setz Dich doch einfach hin und entspann Dich "
      "mal nach Deinem langen Fussmarsch. ");

  AddDetail( ({ "lehne", "holzlehne" }),
      "Eine einfache Holzlehne. ");

  AddDetail( ({ "marsch", "fussmarsch" }),
      "Einige Strapazen scheinst Du schon hinter Dir zu haben, doch das "
      "Schlimmste kommt wohl noch auf Dich zu. ");

  AddDetail( ({ "strapazen" }),
      "Wenn Du nicht gerade mit einem Fortbewegungsmittel mit Raedern "
      "und Motor hergekommen bist, hast Du doch schon einige Strapazen "
      "auf Dich genommen. ");

  AddDetail( ({ "motor" }),
      "Einen Motor wirst Du hier nicht finden. ");

  AddDetail( ({ "fortbewegungsmittel" }),
      "Autos, Busse, Kutschen, Dein Steckenpferd..." );

  AddDetail( ({ "autos", "busse", "kutschen" }),
      "Sowas findest Du hier ganz bestimmt nicht..." );
 
  AddDetail( ({ "fuss", "fuesse" }),
       "Noch dran. ");
 
  AddDetail( ({ "steckenpferd" }),
      "Oh! Du findest doch tatsaechlich ein Steckenpferd. Du koenntest "
      "ja mal probieren darauf zu reiten..." );

  AddDetail( ({ "raeder" }),
      "Gibt es hier nicht! ");

  AddDetail( ({ "tisch" }),
      "Ein Tisch, an dem eigentlich vier Personen Platz haetten, steht "
      "gleich beim Fenster. Er besteht aus einer "
      "Tischplatte und den dazugehoerenden Tischfuessen. Alle "
      "bestehen aus einfachem Birkenholz. "
      "Du kannst nichts Auffaelliges erkennen. ");

  AddDetail( ({ "auffaelliges" }),
      "Nein, da ist wirklich nichts. ");

  AddDetail( ({ "tischplatte", "platte" }),
      "Auch die Platte des Tisches besteht einfach nur aus Holz. ");

  AddDetail( ({ "tischfuesse" }),
      "Mit Hilfe der Fuesse wird die Platte auf den selbigen "
      "gehalten. Deshalb nennen wir das ganze auch Tisch und nicht anders. ");
 
  AddDetail( ({ "stoff" }),
      "Aus so einem Stoff sind wohl Traeume gemacht. ");

  AddDetail( ({ "traeume" }),
      "Jeder hat doch soviele Traeume in seinem Leben. Viele verlieren "
      "diese auch oft voruebergehend aus den Augen, und widmen sich "
      "stattdessen Nichtigkeiten... ");

  AddDetail( ({ "leben" }),
      "Traeume nicht Dein Leben, sondern lebe Deinen Traum! ");

  AddDetail( ({ "traum" }),
      "Niemand kennt Deinen Traum sogut wie Du... ");

  AddDetail( ({ "augen", "auge", "aug" }),
      "Geh mit geoeffneten Augen durchs Leben, und Du wirst finden, "
      "wonach Du suchst. ");

  AddDetail( ({ "nichtigkeiten" }),

      "Ja, viele glauben noch immer das Gefuehl einfach nicht in ihr "
      "Leben hineinpasst. ");

  AddDetail( ({ "gefuehl" }),
      "Hoer auf Dein Gefuehl, denn nur Dein Gefuehl drueckt Deine "
      "wahren Wuensche aus. ");

  AddDetail( ({ "wuensche" }),
      "Eigentlich haben wir alle doch nur einen Wunsch. ");
 
  AddDetail( ({ "wunsch" }),
      "Also ich wuensch mir bloss grenzenlose Liebe und Du? ");

  AddDetail( ({ "liebe" }),
      "Wir alle brauchen Liebe um zu wachsen. ");

  AddDetail( ({ "nordwand" }),
      "An der Nordwand befindet sich das Fenster, der Tisch und "
      "die Stuehle. ");

  AddDetail( ({ "suedwand" }),
      "An der Suedwand siehst Du die Birkentuer, mit der Du die "
      "Huette wieder verlassen kannst. ");

  AddDetail( ({ "ostwand" }),
      "Erst jetzt faellt Dir ein kleines Kaestchen auf, das etwas "
      "versteckt an der Wand angelehnt steht. ");

  AddDetail( ({ "kaestchen" }),
      "Es besitzt zwei kleine Laden und besteht auch, wie sollte "
      "es anders sein aus Holz. ");

  AddDetail( ({ "laden", "lade" }),
      "Welche Lade meinst Du denn genau, die obere oder die untere? ");

  AddDetail( ({ "obere lade" }),
      "Du durchwuehlst in einem Anfall von Muenzenrausch die obere Lade, "
      "kannst allerdings ueberhaupt nichts finden. ");

  AddDetail( ({ "muenzenrausch", "rausch" }),
      "Geizhals Du gemeiner Du. ");

  AddDetail( ({ "geizhals" }),
      "Man durchwuehlt nicht die Laden fremder Leute. ");

  AddDetail( ({ "leute" }),
      "Siehst Du denn welche? ");

  AddDetail( ({ "anfall" }),
      "Ein regelrechter Rausch! ");

  AddDetail( ({ "untere lade" }),
      "Sorgfaeltig oeffnest Du die untere Lade. Eigentlich findest Du hier "
      "nur Gekritzel auf Zettel. ");

  AddDetail( ({ "gekritzel", "worte" }),
      "Wahllos aneinandergereihte Worte. ");
 
  AddDetail( ({ "zettel" }),
      "Moment! Einer davon sieht doch interessant aus. Es handelt sich dabei "
      "um einen Brief. ");

  AddDetail( ({ "brief" }),
      "Der Brief ist etwas zerknittert, aber Du koenntest probieren ihn zu "
      "lesen. ");

  AddDetail( ({ "moment" }),
      "Schon vorbei. ");

  AddDetail( ({ "platz" }),
      "Mein rechter rechter Platz ist leer, drum wuensch ich mir irgendwen "
      "her... =) ");

  AddDetail( ({ "ecke", "ecken" }),
      "Der Raum besitzt vier Ecken. ");

  AddDetail( ({ "decke", "holzdecke" }),
       "Eine einfache Holzdecke. Du kannst nichts besonderes erkennen. ");

  AddDetail( ({ "eindringen" }),
       "Einfach nur gewaltsames Eindringen. ");

  AddDetail( ({ "personen" }),
       "1, 2, 3, 4, 5, ... ");

  AddDetail( ({ "bauch" }),
       "Dein Bauch scheint grossen Hunger zu haben... ");

  AddDetail( ({ "hunger" }),
       "Dein Magen knurrt.\n");

  AddDetail( ({ "magen" }),
       "Den siehst Du hier bestimmt nicht. ");

  AddDetail( ({ "schlimmste", "schlimmstes" }),
       "Das Schlimmste kommt noch. "); 

  AddDetail( ({ "raum", "gegend" }), 
       "Schau Dich doch einfach etwas um hier. ");

  AddDetail( ({ "packen" }),
       "Also dieser Jemand hatte sicherlich keine Zeit zum Packen, "
       "denn sonst haette er nicht private Gegenstaende zurueckgelassen. ");

  AddDetail( ({ "jemand" }),
       "Im Moment befindet sich kein Magier invis in diesem Raum. ");

  AddDetail( ({ "gegenstaende", "gegenstand" }),
       "Unter den privaten Gegenstaenden kannst Du unter anderem eine "
       "Zeichnung erkennen, aber auch einige Buecher fallen Dir auf, "
       "die etwas versteckt in einer Ecke liegen. ");

  AddDetail( ({ "zeichnung" }),
       "Die Zeichnung zeigt eine Person auf einem Berg.\n" 
       "Du denkst . o O (schaut genauso aus wie der Blocksberg)\n");

  AddDetail( ({ "berg", "blocksberg" }),
       "Du scheinst ziemlich sicher zu sein, dass es sich um den "
       "Blocksberg handelt. Anscheinend war der Vorbesitzer "
       "eine Hexe. ");

  AddDetail( ({ "hexe" }),
       "Hier findest Du keine, aber vielleicht weiss irgendwer in Polaris "
       "bescheid... ");

  AddDetail( ({ "buecher" }),
       "Normale Buecher. Eines hat eine sonderbare Aufschrift. ");

  AddDetail( ({ "aufschrift" }),
       "Das EinmalEins des Hexens ");

  AddDetail( ({ "einmaleins" }),
       "Leider ist es in einer fuer Dich unverstaendlichen Sprache "
       "geschrieben. ");

  AddDetail( ({ "hexens" }),
       "Du verstehst leider ueberhaupt nichts und kommst Dir ziemlich "
       "ungebildet vor. ");

  AddDetail( ({ "sprache" }),
       "Eine sehr komische Sprache mit Dir fremden Buchstaben. ");

  AddDetail( ({ "buchstaben" }),
       "So sehr Du Dich auch bemuehst, Du kannst es einfach nicht lesen! ");

  AddDetail( ({ "magier" }),
       "Im Moment ist kein Magier invis hier. ");

  AddDetail( ({ "stelle" }),
       "Der Teppich liegt wieder an seiner gewohnten Stelle. ");

  AddDetail( ({ "moor" }),
        "Das Moor breitet sich noerdlich und westlich von der Huette "
        "aus. Es beeindruckt Dich durch seine Groesse. ");

  AddDetail( ({ "groesse" }),
        "Du kannst weder Ende noch Anfang erkennen, so gross ist es. ");
  
  AddDetail( ({ "ende", "anfang" }),
        "Siehst Du nicht! ");

// DETAILENDE


// SOUNDS
 
  AddSound(DEFAULT_SOUND,
     "Leise knistern die letzten Holzstuecke in der Feuerstelle. "
     "Sie werden wohl bald gaenzlich verbrannt sein. Manchmal "
     "kannst Du auch den Wind hoeren, der Blaetter gegen die "
     "Fensterscheibe weht. ");

  AddSound( ({ "wind" }),
     "Der Wind weht abundzu einige Blaetter gegen das Fenster "
     "und verursacht somit ein leises Rascheln. ");

  AddSound( ({ "rascheln" }),
     "Die Blaetter, die der Wind manchmal gegen die Scheibe weht, "
     "verursachen ein Rascheln. ");

  AddSound( ({ "knistern" }),
     "Leise knistern die Stueckchen in der Feuerstelle. Eigentlich ist "
     "nur mehr die Glut vorhanden. ");

  AddSound( ({ "stueckchen", "holzstueckchen" }),
     "Sie knistern in der Feuerstelle, kleine Flammen entstehen und vergehen "
     "jedoch rasch wieder. ");

  AddSound( ({ "flammen", "glut", "fenster", "fensterscheibe", "scheibe" }),
     "So etwas hoerst Du hier nicht. ");

// details zum sound

  AddDetail( ({ "flammen", "glut" }),
     "Kleine Flammen versuchen sich noch hochzuraffen, aber es ist schon "
     "zuviel Glut hier und so vergehen sie wieder. ");

  AddDetail( ({ "falltuer" }),
     "Eine schwere Falltuer hast Du unter dem Teppich erkennen koennen. "
     "Du koenntest ja einmal versuchen sie anzuheben. ");


// SMELLS

  AddSmell(DEFAULT_SMELL,
     "Der Rauch, der von der Feuerstelle aufsteigt, juckt Dich in "
     "Deiner Nase. Du riechst das Holz ganz deutlich, denn es ist vom "
     "Regen noch etwas feucht. ");

  AddSmell( ({ "suppe" }),
     "Du gehst naeher an das Feuer heran und riechst an der Suppe..."
     "..einfach herrlich! ");

  AddSmell( ({ "rauch", "feuerstelle" }),
     "Der Rauch kitzelt Dich in der Nase.\n"
     "Du musst niesen - HATSCHIII !\n");

  AddSmell( ({ "holz" }),
     "Das Holz riecht feucht und modrig, liegt wohl an dem Regen, der "
     "erst kuerzlich vorueberging. ");

  AddSmell( ({ "regen" }),
     "Gibt es etwas Schoeneres, als Regen zu riechen...auf dem nassen "
     "Asphalt zu wandern oder durch Wald, wenn es erst kuerzlich "
     "geregnet hat? ");

  AddSmell( ({ "wald", "asphalt" }),
     "Warme Luft steigt dann immer vom Boden auf, ist das nicht schoen? ");

  AddSmell( ({ "luft" }),
     "Du schnupperst kurz an der Luft und stellst fest, dass sie recht "
     "normal riecht, bis auf den Rauch der in Deine Nase steigt. ");

  AddSmell( ({ "boden", "teppich" }),
     "Du riechst am Boden.\n"
     "Igitt! Nur der Geruch des alten Teppichs steigt in Deine Nase!\n");

  AddSmell( ({ "nase" }),
     "Bloed, aber Du schaffst es nicht an Deiner eigenen Nase zu riechen. ");

  AddSmell( ({ "geruch" }),
     "Der Teppich stinkt einfach! "); 


// ADDCMDS
 
  AddCmd( ({ "setz", "sitz", "sitze", "setze" }), "c_setzen" );
  AddCmd( ({ "roll", "rolle" }), "c_rollen" );
  AddCmd( ({ "blicke", "blick" }), "c_blicken" ); 
  AddCmd( ({ "les", "lese", "lies" }), "c_lesen" );
  AddCmd( ({ "wuensch", "wuensche" }), "c_wuenschen" ); 
  AddCmd( ({ "reit", "reite" }),"c_reiten" );
  AddCmd( ({ "kost", "koste" }), "c_kosten" );
  AddCmd( ({ "waerm", "waerme" }), "c_waermen" );
  AddCmd( ({ "oeffne" }), "c_oeffnen" );
  AddCmd( ({ "schliesse" }), "c_schliessen" );
  AddCmd( ({ "hebe", "heb"}), "c_heben" );

// TUER!!!

  NewDoor( "sueden", ROOM ("room5"), ({"tuer", "tuere", "birkentuer" }),
       ({ D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
        D_NAME, "Birkentuer",
        D_GENDER, FEMALE,
        D_SHORT, "Im Sueden befindet sich eine %se Birkentuer.",
        D_LONG, "Eine vermoderte Birkentuer. Sie ist schon sehr "
                "zerfallen, trotzdem noch stabil genug um ihre "
                "Funktion zu erfuellen. Man kann sie mit Hilfe "
                "eines Riegels oeffnen und auch wieder schliessen. ",
        D_MSGS, ({ "hinaus", "geht wieder", "kommt herein" }),
        D_OPENMSG, ({ "Mit lautem Knarren schiebst Du den Riegel beiseite "
                      "und die Tuer oeffnet sich. ",
                      "Mit lautem Knarren schiebt %s den Riegel beiseite.",
                      " wird mit lautem Knarren von aussen geoeffnet." }),
        D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du die Tuer.",
                       "Mit einem lauten Rumms schliesst %s die Tuer.",
                       " wird mit lautem Knarren von aussen geschlossen." }),           D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen." }) ); 
         
        
}
  
int c_heben( string str )
{
  if( str != "falltuer an" )
  {
   notify_fail("Was willst Du anheben?\n");
   return 0;
  }
  else
  {
    write(BS(
      "Du rollst den Teppich nochmals beiseite und versuchst "
      "mit aller Kraft die schwere Falltuer anzuheben. Du "
      "muehst Dich ab, und schliesslich gelingt Dir das Unmoegliche. Du hebst "
      "die Falltuer vollstaendig auf. ")+"\n"+BS(
      "Ploetzlich verlierst Du das Gleichgewicht und stuerzt durch das Loch, "
      "das unter der Falltuer verborgen war. "
      "Erst stuerzt Du, dann rutschst Du nur noch und landest schliesslich "
      "im Inneren eines Gebaeudes. "));

    this_player()->move(ROOM ("bib"), M_GO, 
         "durch ein Loch", "faellt", "faellt herein");
    say("Die Falltuer faellt wieder zurueck und versperrt das Loch.\n");
    return 1;
  }
} 

// BEFEHL ROLLEN UEBERSCHRIEBEN

int c_rollen( string str )
{
 if( str != "teppich weg"      &&
     str != "teppich beiseite" )
 {
  notify_fail("Du rollst mit den Augen.\n");
  return 0;
 }
 else
 {
  write( "Du rollst den Teppich beiseite und entdeckst eine Falltuer!\n"
         "Wie von selbst rollt der Teppich an seine gewoehnte Stelle "
         "zurueck.\n" );
  say(CTPN+ " macht sich an einem Teppich zu schaffen.\n");
  return 1;
 }
}

// LESEN BESSER MIT ADDREADDETAIL MACHEN!!!!

int c_lesen( string str )
{
 if( str != "brief" )
 {
  notify_fail( "Was moechtest Du hier lesen?\n");
  return 0;
 }
 if( str == "brief" )
 {
  write(BS( "Nur schwer kannst Du den Brief entziffern. Er scheint in "
       "alter Sprache geschrieben worden zu sein. Einige Woerter stechen "
       "Dir allerdings doch ins Auge...Rette....Magier...Buch...Hilfe..."
       "Sicherheit...Rettung....Du verstehst nicht ganz, um was es sich "
       "handelt, aber vielleicht findest Du das ja noch heraus. "));
  say(CTPN+ " liest aufmerksam etwas durch.\n");
  return 1;
  }
}

// AUS FENSTER BLICKEN WENN ZU/OFFEN ETC... - LICHT - dunkel/hell

int c_blicken( string str )
{
 notify_fail( "Woraus moechtest Du blicken?\n" );
  
 if(!str || str == "") return 0;
 if(!(str == "aus fenster"       ||
      str == "fenster"           ||
      str == "durch fenster"     ||
      str == "aus dem fenster"   )) return 0;

 if(QueryProp(P_LIGHT) <= 0)
 {
  write("Aber die Vorhaenge sind doch geschlossen!\n");
  say(CTPN+ " gafft die geschlossenen Vorhaenge an.\n");
  return 1;
 }
 if(QueryProp(P_LIGHT) > 0)
 {
  write(BS("Du schaust aus dem Fenster und siehst vor Dir nur "
             "das Moor, wie es sich in seiner gesamten Groesse "
             "ausbreitet.\n"));
  say(CTPN+ " schaut gelangweilt aus dem Fenster.\n");
  return 1;
 }
}

int c_setzen ( string str )
{
 if( str != "auf stuhl" )
 {
  notify_fail("Worauf moechtest Du Dich hier setzen?\n");
  return 0;
 }
 if( str == "auf stuhl" )
 {
  write(BS( "Du machst es Dir kurz auf dem Stuhl bequem, stehst aber "
            "gleich wieder auf.\n"));
  say(CTPN+ " macht es sich kurz auf einem Stuhl bequem.\n");
  return 1;
 }
}

int c_wuenschen( string str )
{
 if ( !str)
 {

  write(BS( "Was moechtest Du Dir wuenschen?\n "));
  return 1;
 }
 else
 { 
  write( BS("Du wuenscht Dir etwas...hoffentlich geht es in Erfuellung.\n" ));
 
 WLOG(LOG("polaris.log"), "wuenscht sich "+str);
 return 1;
 }
}

int c_kosten( string str )
{
 if (str != "suppe")
 {
  notify_fail( "Was moechtest Du hier kosten?\n" );
  return 0;
 }
 if (str == "suppe" )
 {
  write(BS("Du kostest vorsichtig die Suppe.\nHm schmeckt gar nicht mal "
            "so schlecht...\n" ));
  return 1;
 }
}

// SEQUENZ - paralysiert

int c_reiten( string str )
{
 if (str != "auf steckenpferd")
 {
  notify_fail( "Worauf moechtest Du hier reiten?\n" );
  return 0;
 }
 if (str == "auf steckenpferd" )
 {
      TP->SetProp(P_PARALYZED,
   
   ([ PARALYZE_TIME: 16,
      PARALYZE_MSG: "Du kannst Dich jetzt nicht bewegen!\n",
      PARALYZE_MSG_OTHER: "%s versucht sich zu bewegen, ist aber "
                          "momentan nicht dazu in der Lage.\n",
      PARALYZE_END: "",
      PARALYZE_END_OTHER: ""]));
      
  call_out("sp0", 2); 
  return 1; 
 }
}

void sp0()
{
 write("\n");
 write(BS("Gekonnt wirfst Du Dich auf das Steckenpferd.\n"));
 call_out("sp1", 2);
}

void sp1()
{
 
 write("\n"); 
 write(BS("Du denkst . o O (Gar nicht mal so schwer =) )"));
 call_out("sp2", 3);
}

void sp2()
{
 write("\n");
 write(BS("Ploetzlich findest Du Dich in Deiner "
          "Kindheit wieder. Bekannte Gesichter von Freunden, die Dir "
          "zulaecheln. Deine Mutter wie sie auf Dich zukommt und Dir Dein "
          "erstes Steckenpferd schenkt. "));
 call_out("sp3", 4);
}

void sp3()
{
 write("\n");
 write(BS("...Szenenwechsel...")); 
 call_out("sp4", 2);
}

void sp4()
{
 write("\n");
 write(BS("Du mit Deinen Freunden einer Wiese... "
          "in der Hand DEIN Steckenpferd...Gemeinsam galoppiert ihr durch "
          "die Wiesenlandschaft...Die Samen des Loewenzahns beginnen zu "
          "fliegen, wie ihr daneben, DU und DEIN Steckenpferd, vorbei "
          "sprintet. "));
 call_out("sp5", 5);
}

void sp5()
{
 write("\n");
 write(BS("Du denkst . o O (Mein Gott war ich damals noch "
          "verspielt und gluecklich...)" ));
 call_out("sp6", 3);
}

void sp6()
{
 write("\n");
 write(BS("Schon ist der Traum wieder vorbei." ));
 call_out("sp7", 2);
}

void sp7()
{
 write("\n");
 write(BS( "Was ist bloss aus Deinem Steckenpferd geworden....?" ));
 call_out("sp8", 3);
}

void sp8()
{
 write("\n");
 write(BS("Du seufzt tief und kehrst in die Realitaet zurueck..." ));
 this_player()->move(ROOM("huette1") ); 
 say(CTPN+ " seufzt tief auf.\n"); 
}

int c_waermen( string str )
{
 if ( str != "haende am feuer"       &&
      str != "haende an feuerstelle" )  
 {
  notify_fail( "Wo moechtest Du Deine Haende waermen?\n" );
  return 0; 
 }
 if (!(str == "haende am feuer"   ||
       str == "haende an feuerstelle" )) return 1; 
 {
  write(BS("Du waermst Deine Haende an der Feuerstelle und fuehlst Dich "
            "sogleich um einiges besser. "));
  say(CTPN+ " fuehlt sich auf einmal um einiges besser.\n" );

  return 1;
 }
}

int c_schliessen( string str )
{
 if (str != "vorhaenge" )
 {
  notify_fail( "Was moechtest Du hier schliessen?\n" );
  return 0;
 }
 if (QueryProp(P_LIGHT) <= 0)
 {
  write( "Aber die Vorhaenge sind doch schon laengst geschlossen!\n" );
  return 1;
 }
  write( "Du schliesst Dich Vorhaenge und es wird finster.\n" );
  say(CTPN+ " schliesst die Vorhaenge und es wird finster.\n" );    
  SetProp(P_LIGHT, 0);
  return 1;
}

int c_oeffnen( string str )
{
 if (str != "vorhaenge" )
 {
  notify_fail( "Was moechtest Du hier oeffnen?\n" );
  return 0;
 }
 if (QueryProp(P_LIGHT) > 0)
 {
  write( "Aber die Vorhaenge sind doch schon laengst geoeffnet!\n" );
  return 1;
 }
  write( "Vorsichtig schlaegst Du die Vorhaenge beiseite und es wird wieder "
         "hell.\n");
  say(CTPN+ " oeffnet mit Bedacht die Vorhaenge.\n"
                              "Es wird wieder hell.\n" );
  SetProp(P_LIGHT, 1);
  return 1;
}




