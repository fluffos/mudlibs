inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{

::create();

  SetProp(P_INT_SHORT, "In einem Birkenwaeldchen");
  SetProp(P_INT_LONG,
     "Das Birkenwaeldchen wird hier zunehmend dichter. Nur im Norden "
     "lichtet es sich etwas und vor Dir breitet sich ein grosses Moor "
     "aus. Der Boden unter Deinen Fuessen fuehlt sich locker an und Du "
     "solltest aufpassen, nicht zu versinken. Rechts und links von Dir "
     "ragen die Moorbirken in den Himmel. Dunkel und duester starren sie "
     "Dich an. Du fuehlst Dich von ihren Blicken verfolgt. Lange moechtest "
     "Du hier nicht verweilen. Eine Stimme in Deinem Bauch raet Dir, "
     "rasch weiterzugehen. Seltsame Schreie dringen an Dein Ohr. "
     "Die Umrisse von Huetten kannst Du nun deutlicher erkennen. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_FOREST]) );
  

  AddExit( "westen", ROOM ("room1") );
  AddExit( "osten", ROOM ("room3") );



// DETAILBEGINN

  AddDetail( ({ "birkenwaeldchen", "birkenwald", "wald", "waeldchen" }),
     "Das Waeldchen wird immer dichter. Dunkel ragen die Moorbirken "
     "neben Dir in den Himmel. Die Staemme strahlen Dir weiss entgegen. ");

  AddDetail( ({ "norden" }),
     "Im Norden breitet sich ein grosses Moor aus. ");

  AddDetail( ({ "moor", "moore", "mooren" }),
     "Das Moor breitet sich im Norden aus. "
     "Dunkle Nebelschwaden huellen es ein. Der Geruch des Dunstes steigt "
     "Dir in die Nase. Eine mystische Stimmung breitet sich hier aus. ");

  AddDetail( ({ "birken", "moorbirken" }),
     "Die Staemme der Birken ragen gen Himmel. Duester erscheinen Dir "
     "ihre Wipfel. Es scheint so als wuerden Dich ihre Blicke verfolgen. "
     "Nur die Rinde strahlt in einem hellen Weiss. Eine Birke scheint "
     "sich von den anderen jedoch zu unterscheiden. ");
  
  AddDetail( ({ "weiss" }),
     "Weiss - strahlend weiss! ");

  AddDetail( ({ "staemme", "stamm" }),
     "Die Staemme der Birken leuchten in weisser Farbe. "
     "Es scheint, als wuerden sie sich im Nichts verlieren. ");

  AddDetail( ({ "nichts" }),
     "Soetwas findest Du hier bestimmt nicht. ");
 
  AddDetail( ({ "wipfel" }),
     "Du kannst die Wipfel der Birken kaum erkennen. "
     "Die Sonne wird verdeckt von dunklen Wolken und es faellt "
     "Dir schwer, ueberhaupt Deinen eigenen Koerper zu erkennen. "
     "Der Wind geht stark und so musst Du auch oefters Deine "
     "Augen schliessen. ");

  AddDetail( ({ "wind" }),
     "Der Wind treibt Schmutz in Deine Augen und so musst Du "
     "sie fuer einen Augenblick schliessen. ");

  AddDetail( ({ "schmutz" }),
     "Da Du im Moment Schmutz in Deinen Augen hast, kannst Du "
     "ihn nicht genauer untersuchen. ");

  AddDetail( ({ "augenblick" }),
     "Ein kleiner Moment. Schon ist er wieder vorbei. ");

  AddDetail( ({ "sonne" }),
     "Die Sonne wird von den dunklen Wolken komplett verdeckt. ");
 
  AddDetail( ({ "koerper" }),
     "Verzweifelt tastest Du Deinen Koerper ab, stellst aber "
     "zu Deiner Beruhigung fest, dass alles am richtigen Ort sitzt. ");

  AddDetail( ({ "ohr" }),
     "Dein Ohr kannst Du nicht selbst untersuchen, es sei denn Du bist "
     "ein Elefant. ");

  AddDetail( ({ "elefant" }),
     "Elefanten suchst Du besser in der Wueste. ");
 
  AddDetail( ({ "wueste" }),
     "Hier wirst Du keine finden. ");

  AddDetail( ({ "birke", "moorbirke" }),
     "Nein, Du hast Dich nicht getaeuscht. Eine Birke unterscheidet "
     "sich tatsaechlich von der Menge. Du glaubst, eine Inschrift in "
     "ihrer Rinde zu erkennen. ");

  AddDetail( ({ "inschrift" }),
     "Vielleicht koenntest Du ja versuchen, die Inschrift zu entziffern. ");

  AddDetail( ({ "rinde", "rinden" }),
     "Die Rinde der Birken strahlt Dir in einem sonderbaren Weiss "
     "entgegen. Eine Stelle sieht seltsam aus. ");

  AddDetail( ({ "stelle" }),
     "Tatsaechlich, eine Stelle der Rinde sieht sonderbar aus. "
     "Was koennte das wohl bedeuten ? ");

  AddDetail( ({ "himmel" }),
     "Dunkle Wolken stehen am Himmel. In der Ferne blitzt es bereits "
     "und ein Gewitter scheint bevorzustehen. Vielleicht solltest Du "
     "sicherheitshalber einen Unterschlupf suchen, um dem Regen zu "
     "entrinnen. ");

  AddDetail( ({ "unterschlupf" }),
     "Nein, hier wirst Du keinen finden. ");

  AddDetail( ({ "wolken" }),
     "Dunkle Wolken brauen sich ueber Dir zusammen. Es scheint, als "
     "wuerden sie sich jeden Moment entladen wollen. Sogar die Luft "
     "riecht bereits nach Regen. ");

  AddDetail( ({ "luft" }),
     "Die Luft brauchst Du zum Atmen, untersuchen kannst Du sie "
     "allerdings nicht. Probier es mal mit lauschen! ");

  AddDetail( ({ "moment" }),
     "Schon ist er vorbei. ");

  AddDetail( ({ "regen" }),
     "Such lieber einen Unterschlupf, um Dich vor dem herannahenden "
     "Regen zu schuetzen. ");

  AddDetail( ({ "Geruch" }),
     "Wie waers mit riechen? ");

  AddDetail( ({ "farbe" }),
     "Weiss. ");

  AddDetail( ({ "boden" }),
     "Auf dem Boden liegen einige abgefallene Birkenblaetter. "
     "Im Gegensatz zu vorhin ist er sehr schlammig und Du solltest "
     "achtgeben, wohin Du Deine Schritte setzt. ");

  AddDetail( ({ "schlamm" }),
    "Der Boden ist wirklich schlammig. ");

  AddDetail( ({ "schritt", "schritte" }),
     "Ein falscher Schritt koennte Dich das Leben kosten. ");

  AddDetail( ({ "tod" }),
     "Der kommt frueher als man denkt. ");

  AddDetail( ({ "gegensatz", "gegensaetze" }),
     "Gegensaetze ziehen sich an. ");

  AddDetail( ({ "blaetter", "birkenblaetter" }),
     "Auf dem schlammigen Boden liegen abgestorbene Birkenblaetter. "
     "Sie haben sich im Laufe der Zeit braun verfaerbt und verrotten "
     "langsam vor sich hin. ");

  AddDetail( ({ "zeit" }),
     "Zeit ist etwas sehr Kostbares. ");

  AddDetail( ({ "kostbares" }),
     "Es gibt vieles, was kostbar ist. ");

  AddDetail( ({ "lauf", "laufe" }),
     "Im Laufe der Zeit verfaerben sich Blaetter, damit das "
     "natuerliche Gleichgewicht erhalten werden kann. ");

  AddDetail( ({ "gleichgewicht", "natur" }),
     "Die Natur sorgt fuer ein stetiges Gleichgewicht. ");
  
  AddDetail( ({ "gewitter" }),
     "Es scheint, als wuerde es bald zu regnen anfangen. Das "
     "Gewitter scheint schon nah zu sein. ");

  AddDetail( ({ "atmen" }),
     "Das solltest Du tun, denn sonst bist Du bald tot. ");

  AddDetail( ({ "blick", "blicke" }),
     "Es scheint als wuerden Dich die Birken verfolgen. Du "
     "fuehlst Dich als waeren hunderte von Augen auf Dich gerichtet. ");

  AddDetail( ({ "augen" }),
     "Du hast gruene Augen. ");

  AddDetail( ({ "schreie", "schrei" }),
     "Lauschen hilft! ");

  AddDetail( ({ "umrisse" }),
     "Die Umrisse der Huetten kannst Du hier deutlich erkennen. "
     "Wenn Du allerdings mehr erfahren moechtest, musst Du Dich nach "
     "Osten begeben. ");

  AddDetail( ({ "osten", "westen" }),
     "Der Weg fuehrt von Osten nach Westen oder umgekehrt. ");

  AddDetail( ({ "weg" }),
     "Na was glaubst Du denn wo Du Dich befindest ?");

  AddDetail( ({ "huetten", "huette" }),
     "Weiter im Osten scheinen Huetten zu sein. ");

  AddDetail( ({ "ferne" }),
     "In der Ferne blitzt und regnet es. Vielleicht findest Du ja "
     "in einer der Huetten Unterschlupf. ");

  AddDetail( ({ "nebel", "nebelschwaden", "dunst", "dunstes" }),
     "Ueber dem Moor breitet sich Nebel aus. Der Geruch des Dunstes "
     "steigt in deine Nase. Wie von einem Schleier umgeben praesentiert "
     "sich Dir das Moor. ");

  AddDetail( ({ "schleier" }),
     "Nebel und Dunst bilden einen Schleier. ");

  AddDetail( ({ "nase" }),
     "Noch dran. ");
 
  AddDetail( ({ "stimmung" }),
     "Besonders wohl fuehlst Du Dich hier nicht. Vielleicht waere "
     "es besser rasch weiterzugehen. Das Moor scheint Dich jedoch unheimlich "
     "anzuziehen. ");

  AddDetail( ({ "fuesse" }),
     "Hoffentlich machst Du keinen falschen Schritt, denn das koennte "
     "Dich Dein Leben kosten. ");

  AddDetail( ({ "leben" }),
     "Du haengst doch sehr an Deinem Leben und moechtest nicht, "
     "dass dieses sobald zu Ende geht. ");

  AddDetail( ({ "ende", "schluss" }),
     ". ");

  AddDetail( ({ "menge" }),
     "Groessere Gruppe. ");

  AddDetail( ({ "gruppe" }),
     "Die Birken stehen in Gruppen beieinander. ");

  AddDetail( ({ "ort" }),
     "Ja, alles noch dran. ");

  AddDetail( ({ "beruhigung" }),
     "Nun bist Du beruhigt und kannst Dich wieder Deinem Leben widmen. ");

  AddDetail( ({ "bauch" }),
     "Vorsichtig beginnen Deine Haende nach Deinem Bauch zu tasten. "
     "Da war diese seltsame Stimme schon wieder. Dein Bauch beginnt zu "
     "zittern. Irgendwie merkst Du wie das Essen der letzten Woche langsam "
     "hochsteigt.\n"
     "Du denkst Dir . o O ( nur weg von hier ) ");

  AddDetail( ({ "hand", "haende" }),
     "Beide noch dran. ");

  AddDetail( ({ "stimme" }),
     "Eine Stimme sagt: nur weg von hier, aber schnell!!! ");
     
  AddDetail( ({ "essen" }),
     "Schweinsbraten und Knoedeln, und da war doch noch ein Sueppchen... ");

  AddDetail( ({ "schweinsbraten", "knoedel", "knoedeln", "sueppchen" }),
     "Naja alles was Du so gegessen hast vorige Woche. ");

  AddDetail( ({ "woche" }),
     "Die Woche davor. ");

  AddDetail( ({ "baum", "baeume" }),
     "Es sind ausschliesslich Birken die hier wachsen. Wahrscheinlich "
     "wegen dem feuchten Untergrund. ");

  AddDetail( ({ "untergrund" }),
     "Birken lieben feuchten Untergrund, deswegen kannst Du sie ja auch "
     "hier antreffen. ");

// DETAILENDE


// SOUNDS

  AddSound(DEFAULT_SOUND,
     "Du hoerst den Wind um die Wipfeln brausen. Von ueberall dringen "
     "Schreie an Dein Ohr. Das Grollen des Gewitters kannst Du schon "
     "deutlich hoeren. ");

  AddSound( ({ "schreie", "schrei" }),
     "Von ueberall kommen Schreie. Es scheint, als wuerden sie "
     "verzweifelt nach Hilfe rufen. ");

  AddSound( ({ "wind" }),
     "Der Wind braust durch die Wipfel der Birken. ");

  AddSound( ({ "wipfel" }),
     "Der Wind saust durch die Wipfel der Birken, und bringt diese zum "
     "Schaukeln. ");

  AddSound( ({ "gewitter", "gewitters" }),
     "Der Regen scheint in der Ferne schon niederzuprasseln. "
     "Ein dumpfes Grollen ist zu hoeren. ");

  AddSound( ({ "grollen" }),
     "Du spuerst richtig wie sich die Wolken aneinander reiben. "
     "Dumpfe Geraeusche dringen an Dein Ohr. ");

  AddSound( ({ "geraeusch", "geraeusche" }),
     "Viele verschiedene Geraeusche kannst Du vernehmen. ");
 
  AddSound( ({ "regen" }),
     "Der Regen prasselt in der Ferne auf die Erde. ");

  AddSound( ({ "hilfe" }),
     "Jemand ruft verzweifelt nach Hilfe. ");

  AddSound( ({ "jemand" }),
     "HIIIIIIIIIIIIILFEEEEEEEEEE !!!! ");


// SMELLS

  AddSmell(DEFAULT_SMELL,
     "Die Luft riecht foermlich schon nach Regen. Auch der Dunst, "
     "der von Norden zu kommen scheint, steigt in Deine Nase. ");

  AddSmell( ({ "dunst" }),
     "Feuchte Luft dringt in Deine Nase, der Geruch von modrig und "
     "schimmelnden Dingen macht sich breit. ");
 
  AddSmell( ({ "geruch", "gerueche" }),
     "Riech doch mal herum. ");

  AddSmell( ({ "dinge", "dingen" }),
     "Feucht und kalt macht sich der Dunst spuerbar in der Nase. ");

  AddSmell( ({ "nase" }),
     "An Deiner Nase kannst Du nicht riechen. ");

  AddSmell( ({ "regen" }),
     "Regen hat einen sehr eigenen Geruch. Das feuchte Nass kennst Du "
     "sicherlich noch aus Deiner Kindheit. ");
 
  AddSmell( ({ "nass" }), 
     "Nass riecht nass.\n"
     "Jemand zwinkert. ");

 
  AddSmell( ({ "luft" }),
     "Es riecht nach Regen und Moder. ");

  AddSmell( ({ "moder" }),
     "PFUI! ");

  AddSmell( ({ "erde" }),
     "Die Erde riecht sehr feucht hier. ");

  AddSmell( ({ "kindheit" }),
     "Du riechst in Dich hinein =). Viele Gerueche von Deiner Kindheit "
     "kommen in Dir hoch. Der Geruch von Regen aber auch von Zuckerl, "
     "wie Du sie einst von Deinen Grosseltern bekommen hast. ");

  AddSmell( ({ "grosselter", "grosseltern" }),
     "Grosseltern riechen auch immer modrig (zumindest meine =) ) ");

  AddSmell( ({ "zuckerl" }),
     "Oh dieser suesse Geruch, den Du doch so liebtest. Du beschliesst "
     "Dir morgen gleich ein Paeckchen zu kaufen. ");

  AddSmell( ({ "paeckchen" }),
     "Du riechst, dass es bei den Zwergen irgendwo ein Paeckchen Zuckerl "
     "gibt. ");

  AddSmell( ({ "zwerg", "zwerge", "zwergen" }),
     "Zwerge kannst Du hier nirgends riechen. Probiers doch einfach "
     "mal in Felonia der Stadt der Zwerge. ");

  AddSmell( ({ "felonia", "stadt" }),
     "Nicht hier. ");



  AddCmd( ({ "entziffer", "entziffere" }),
     "c_entziffern" );
      
}

  c_entziffern(string str )
{
  notify_fail( "Was willst Du hier entziffern ?\n" );
  if( str == "inschrift" )
 { 
     write( "Achte auf Dich, auf allen Deinen Wegen!!!\n"  );
     return 1;
  }
    else return 0;}
  





   
