inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{
  ::create();

  SetProp(P_INT_SHORT, "In Polaris" );
  SetProp(P_INT_LONG, 
     "Du stehst am Suedende von Polaris. Der Weg nach Sueden endet "
     "vor einem undurchdringlichem Waeldchen. "
     "Westlich von Dir befindet sich eine schon sehr zerfallene Huette. "
     "Ihre Fenster und Tuere wurden mit dicken Holzbrettern zugenagelt, "
     "anscheinend wohnt schon lange niemand mehr hier. "
     "Nach Norden hin kommst Du in den hintersten Teil von Polaris. "
     "Dort befindet sich vermutlich noch eine weitere Huette, da aus "
     "noerdlicher Richtung Rauch aufsteigt. "
     "Am Wegrand wachsen einige Pflanzen, die Dir mehr oder weniger bekannt "
     "sind. ");
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_LIGHT, 1);

  AddExit( "osten", ROOM ("room10") );
  AddExit( "norden", ROOM ("room12") );


// DETAILBEGINN

  AddDetail( ({ "westen" }),
    "Im Westen steht eine recht zerfallene Huette. ");

  AddDetail( ({ "norden" }),
    "Du musst schon nach Norden gehen um mehr erkennen zu koennen. ");

  AddDetail( ({ "osten" }),
    "Geh lieber nach Osten, dann erkennst Du auch mehr. ");

  AddDetail( ({ "sueden" }),
    "Im Sueden endet der Weg vor einem undurchdringlichem Waeldchen. ");

  AddDetail( ({ "suedende" }),
    "Du befindest Dich hier am Suedende von Polaris. ");

  AddDetail( ({ "huette" }),
    "Im Westen befindet sich eine zerfallene Huette, deren Fenster und Tuer "
    "mit Brettern zugenagelt wurden. An der Tuer wurde eine Notiz "
    "angebracht. ");

  AddDetail( ({ "notiz" }),
    "Probiers einmal mit lesen! ");

  AddReadDetail( ({ "notiz" }),
    " .-,--._.\n"
    "(       (.,--._\n"
    " )             )\n"
    "(   Wegen       )\n"
    "`.  Einsturz-  |\n"
    " |  gefahr     |\n"
    " '  gesperrt!  ,\n"
    "(    ._,.     (\n"
    " `._(    ) .-._)\n"
    "        (__)\n");

 AddDetail( ({ "boden" }),
   "Wie ueberall in Polaris besteht auch der Boden hier aus Lehm. Er fuehrt "
   "Dich von Osten nach Norden, oder von Norden nach Osten, je nachdem. ");

 AddDetail( ({ "lehm" }),
   "Woraus Lehm besteht muesstest Du mittlerweile im Schlaf aufsagen koenne, "
   "glaubs mir. Zur Erinnerung: Lehm besteht aus Erde die mit Wasser vermischt "
   "wurde, und nach gewisser Zeit im Endeffekt hart wurde. ");
  
 AddDetail( ({ "erinnerung" }),
   "Eine kleine Gedaechtnisstuetze. ");

 AddDetail( ({ "gedaechtnisstuetze", "stuetze" }),
   "Wann kapierst Du endlich aus was Lehm zusammengesetzt wird?! ");

 AddDetail( ({ "erde" }),
   "...und Wasser ergibt irgendwann Lehm. ");

 AddDetail( ({ "wasser" }),
   "...und Erde ergibt irgendwann Lehm. ");

 AddDetail( ({ "endeffekt" }),
   "Ganz am Schluss wird irgendwann Lehm draus. ");

 AddDetail( ({ "zeit" }),
   "Wer hat an der Uhr gedreht, ist es wirklich schon so spaet... ");

 AddDetail( ({ "uhr" }),
   "Hier ist keine. ");

 AddDetail( ({ "schlaf" }),
   "Tipp mal: 'schlaf ein', dann kannst Du einiges aufsagen. :) ");

 AddDetail( ({ "polaris" }),
   "Du befindest Dich am Suedende von Polaris. ");

 AddDetail( ({ "schluss" }),
   "Schluss, Aus, Basta, sprach Clementine und aergerte sich ueber eine "
   "gewisse niveaulose Detailtiefe. ");

 AddDetail( ({ "clementine" }),
   "Die ist zum Glueck nicht hier!\n"
   "Du atmest erleichtert auf. ");

 AddDetail( ({ "aus", "basta" }),
   "Dir wird fad vom Detailuntersuchen und Du bohrst gelangweilt in der "
   "Nase. ");

 AddDetail( ({ "detailtiefe", "tiefe" }),
   "Ungeheure Welten eroeffnen sich vor Dir...*gaehn* ");

 AddDetail( ({ "welten" }),
   "Ich meinte natuerlich Tiefen. ");

 AddDetail( ({ "tiefen" }),
   "Ist Dir nicht unglaublich fad? ");

 AddSpecialDetail( ({ "detailuntersuchen" }), "detailfun" );
     
 AddDetail( ({ "nase" }),
   "Mitten im Gesicht. ");

 AddDetail( ({ "gesicht" }),
   "In Deinem Gesicht befindet sich unter anderem Deine Nase. ");

 AddDetail( ({ "glueck" }),
   "Eine Portion Glueck gehoert fast ueberall dazu. ");

 AddDetail( ({ "portion" }),
   "Ein wenig. ");

 AddDetail( ({ "fenster" }),
   "Die Fenster der Huette wurden mit dicken Holzbrettern einfach zugenagelt. "
   "Nicht einmal ein kleiner Spalt ist frei, um ins Innere zu blicken. ");

 AddDetail( ({ "tuer", "tuere" }),
   "Die Tuer wurde mit dicken Holzbrettern zugenagelt. Eine Notiz befindet "
   "sich an ihr angeheftet. ");

 AddDetail( ({ "holzbretter", "bretter" }),
   "Dicke Holzbretter wurden ueber den Fenstern und der Tuer angebracht. Sie "
   "verhindern auch nur den geringsten Blick ins Innere der Huette. ");

 AddDetail( ({ "blick" }),
   "Kein einziger Spalt wo man durchblicken koennte. ");

 AddDetail( ({ "innere" }),
   "Leider kannst Du nicht ins Innere blicken. ");

 AddDetail( ({ "spalt" }),
   "Kein einziger ist zu sehen! ");

 AddDetail( ({ "teil" }),
   "Nach Norden kommst Du in den hintersten und verwinkeltsten Teil von "
   "Polaris, sozusagen das Nordende. ");

 AddDetail( ({ "nordende" }),
   "Das befindet sich anscheinend im Norden, aber da musst Du schon selbst "
   "hingehen und nachsehen. ");

 AddDetail( ({ "waeldchen" }),
   "Ein undurchdringliches Waeldchen grenzt den Weg nach Sueden hin ab. "
   "Es besteht aus verschiedenen Baeumen, ueberwiegend jedoch aus Birken. "
   "Das Unterholz macht ein Vorwaertskommen unmoeglich. ");

 AddDetail( ({ "unterholz" }),
   "Das Unterholz ist sehr dicht, und verhindert ein Vorwaertskommen. ");

 AddDetail( ({ "vorwaertskommen" }),
   "Gibts hier nicht. ");

 AddDetail( ({ "birken", "birke" }),
   "Wie eine Birke aussieht, weisst Du hoffentlich mittlerweile schon. Oder "
   "moechtest Du Dich wieder den Tiefen der Birkenseele hingeben. ");

 AddDetail( ({ "birkenseele" }),
   "Ein Forscherpunkt lacht Dich an und huepft einen Raum weiter. ");

 AddDetail( ({ "forscherpunkt" }),
   "Weg ist er :( ");

 AddDetail( ({ "raum" }),
   "Sieh Dich doch einmal um! ");

 AddDetail( ({ "baeume" }),
   "Ein typisches Mischwaeldchen. ");

 AddDetail( ({ "mischwaeldchen", "mischwald", "wald" }),
   "Ein Mischwald ist ein Wald mit Laub- und Nadelbaeumen. ");

 AddDetail( ({ "laubbaeume" }),
   "Esche, Eiche, Ahorn, Kastanie, ... ");

 AddDetail( ({ "esche", "eiche", "ahorn", "kastanie" }),
   "Alles Laubbaeume. ");

 AddDetail( ({ "nadelbaeume" }),
   "Leider bist Du in Biologie nicht so ganz der Hellste gewesen, deshalb "
   "kannst Du keine einzige Art von der anderen unterscheiden. ");

 AddDetail( ({ "biologie" }),
   "Da warst Du nicht der Staerkste, wie man merkt. ");

 AddDetail( ({ "hellste" }),
   "Du sicherlich nicht. ");

 AddDetail( ({ "staerkste" }),
   "DU NICHT! ");

 AddDetail( ({ "art", "arten" }),
   "Es ist wirklich schwer die verschiedensten Arten von Nadelbaeumen "
   "auseinanderzuhalten. ");

 AddDetail( ({ "laub", "nicht" }),
   "Nein. ");

 AddDetail( ({ "wegrand" }),
   "Am Wegrand wachsen einige Pflanzen und Graeser, nicht wirklich etwas "
   "Interessantes dabei. ");

 AddDetail( ({ "graeser" }),
   "Normale gruene Graeser, die einfach so am Wegrand wachsen. ");

 AddDetail( ({ "pflanzen" }),
   "Einige Pflanzen gedeihen am Wegrand, aber Du findest wirklich nichts "
   "Interessantes oder Auffaelliges an ihnen. ");

 AddDetail( ({ "interessantes", "auffaelliges" }),
   "Da ist wirklich nichts! ");

 AddDetail( ({ "himmel" }),
   "Der Himmel ist blau und wolkenlos. Die Sonne scheint auf alles Lebende "
   "herab und waermt auch den Boden unter Deinen Fuessen. ");

 AddDetail( ({ "wolke", "wolken" }),
   "Da sind keine! ");

 AddDetail( ({ "sonne" }),
   "Die Sonne strahlt auf alles Lebende herab. ");

 AddDetail( ({ "lebende", "lebendes" }),
   "Ueberall findet man Leben, wenn man nur genau hinsieht. Ob es jetzt in "
   "Pflanzen ist oder woanders. ");

 AddDetail( ({ "leben" }),
   "Leben umgibt Dich, auch wenn man es nicht sofort erkennen kann. ");

 AddDetail( ({ "rauch" }),
   "Aus dem Norden scheint Rauch aufzusteigen, vielleicht befindet sich "
   "dort noch eine andere Huette. ");

 AddDetail( ({ "fuesse" }),
   "Alles noch da. ");

 AddDetail( ({ "weg" }),
   "Ein lehmiger Weg schlaengelt sich durch Polaris und hat Dich bis hier her "
   "gebracht. ");

 AddDetail( ({ "richtung" }),
   "Welche? ");

// DETAILENDE


// SOUNDS

 AddSound(DEFAULT_SOUND,
   "Ausser dem Knurren Deines Magens ist hier absolute Stille. ");

 AddSound( ({ "magen" }),
   "Dein Magen schreit: HUNGER HUNGER !!! ");

 AddSound( ({ "stille" }),
   "Still! ");

 AddSound( ({ "hunger" }),
   "Vielleicht solltest Du Deinem Magen etwas zu essen geben. ");


// SMELLS

 AddSmell(DEFAULT_SMELL,
   "Es riecht hier etwas nach Rauch, wahrscheinlich kommt das aus dem "
   "Norden. Sonst kannst Du leider nichts anderes 'erriechen'. ");

 AddSmell( ({ "rauch" }),
   "Der Rauch scheint aus dem Norden zu kommen. Er kitzelt Dich auf "
   "jeden Fall sehr in Deiner Nase, und Dein Magen meldet sich nun "
   "auch wieder zu Wort. ");

 AddSmell( ({ "norden", "fall", "nase", "magen", "wort" }),
   "Soetwas kann man bestimmt nicht riechen. "); 


}


string detailfun( string str )
{
 this_player()->command_me("-allgemein Ich bohre pro Stunde 2x in der "
                           "Nase!!!!!!!");
 return "";
}

