// KNEIPE!!!
// SPECIALEXIT !!!


inherit "std/pub";

#include <properties.h>
#include <language.h>
#include "../marisol.h"
#include <pub.h>
#include <moving.h>

create()
{
  ::create();

  SetProp(P_INT_SHORT "Im Hexenbraeu" );
  SetProp(P_INT_LONG, 
     "Du befindest Dich in einer kleinen eher verlassen "
     "wirkenden Kneipe in Polaris. Vor Dir breitet sich eine lange "
     "Theke aus, wo Du Speisen und Getraenke konsumieren kannst. "
     "Rechterhand siehst Du einige Tische mit Stuehlen "
     "auf die man sich setzen kann, um sein Mahl einzunehmen, oder einfach "
     "um sich ein wenig von den Anstrengungen zu erholen. "
     "An den Waenden wurden Zeichnungen angebracht, von denen "
     "eine seltsame Aura ausgeht. " 
     "An der Nordwand kannst Du eine grosse "
     "Tafel erkennen, die Du mit 'menue' lesen kannst. ");
  SetProp(P_LIGHT, 1);

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER | PUB_NEEDSKEEPER );
  SetProp(P_PUBKEEPER_ID, "gefjon" );
  SetProp(P_PUBKEEPER_NAME, "Gefjon" );
  SetProp(P_PUBKEEPER_GENDER, FEMALE );
  SetProp(P_PUBMSG_NOINVITE, "Gefjon lacht Dich aus und sagt: Du denkst "
                             "wohl dass ich dumm bin!\n");
  SetProp(P_PUBMSG_FIGHTING, "Gefjon kaempft doch gerade!\n"); 
  SetProp(P_PUBMSG_NOENEMY, "Gefjon sagt: Du Wurm, Du glaubst doch "
                            "nicht im ernst, "
                            "dass ich Dich bediene!\n");

  AddExit( "sueden", ROOM ("room7") );

 
// ESSEN UND TRINKEN 

  AddDrink( "Birkentee", ({ "tee", "birkentee" }),
     20, 10, 0, 2,
     ({ "Wie von Geisterhand schwebt ein Heferl mit "
        "Birkentee vor Deine Nase. Du trinkst es rasch aus und fuehlst "
        "Dich danach gleich erfrischt.\n",
        "&& trinkt rasch ein Heferl mit warmen Birkentee aus und macht ein "
        "glueckliches Gesicht.\n" }) );

  AddDrink( "Daemonenblut", ({ "daemonenblut", "blut" }),
     50, 12, 5, 0,
     ({"Gefjon zapft etwas Blut von einem Fass ab und "
       "wirft Dir dann das Glas zu. Du faengst es und trinkst es aus.\n",
       "Gefjon zapft etwas Blut ab und wirf es && dann zu.\n"}) );

  AddDrink( "Hexenbraeu", ({ "braeu", "hexenbraeu" }),
     60, 23, 2, 6,
     ({ "Gefjon braut ein komisches Getraenk zusammen "
        "und reicht es Dir dann.\n",
        "&& bekommt ein komisches Getraenk.\n" }) );

  AddDrink( "Met", ({ "met" }),
     100, 23, 4, 2,
     ({ "Du bestellst ein Glas Met und ehe Du Dich versiehst steht es "
        "vor Dir. Rasch trinkst Du es aus...Boah! Das war aber lecker!\n",
        "&& trinkt ein Glas mit frischem Met und blinzelt Dich gluecklich "
        "an.\n" }) );

  AddDrink( "Weihwasser", ({ "weihwasser", "wasser" }),
     300, 25, 0, 3,
     ({ "Du bekommst ein Glas zugeschubst, dass Du in einem Zuge leerst.\n",
        "&& leert in einem Zuge ein Glas.\n" }) );

  AddDrink( "Elixier der Schatten", ({ "elixier", "schattenelixier" }),
     1500, 100, 0, 12,
      ({ "Eine blubbernde Fluessigkeit steht auf einmal vor Dir. Du "
         "trinkst sie aus und fuehlst Dich fast vollstaendig geheilt.\n",
         "&& trinkt eine blubbernde Fluessigkeit und fuehlt sich geheilt.\n"}));

  AddDrink( "Trank der Weisheit", ({ "trank" }),
     2000, 0, 0, 0,
     ({ "Du bestellst den Trank der Weisheit...welch edles Getraenk... "
        "Ploetzlich erscheint ein Schriftzug vor Dir: Hoer auf so "
        "gierig zu sein!\n",
        "&& bestellt einen seltsamen Trank und fuehlt sich gleich um "
        "einiges wissender.\n" }) );


  AddFood( "Moorhuhneier", ({ "eier", "moorhuhneier" }),
      110, 33, 12,
      ({ "Du isst ein paar Moorhuhneier.\n",
         "&& isst ein paar Moorhuhneier.\n" }) );

  AddFood( "Moorhuhn (gegrillt)", ({ "huhn", "moorhuhn", "henderl" }),
      120, 40, 15,
      ({"Du bestellst ein gegrilltes Henderl und isst es mit einem "
        "Satz auf.\n",
         "&& isst mit einem maechtigen Satz ein Huhn auf.\n" }) );

  AddFood( "Knochensalat", ({"salat", "knochensalat"}),
     170, 50, 22,
     ({"Du isst knirschend Deinen Knochensalat. *grusel*\n",
       "&& isst knirschend einen Knochensalat. *grusel*\n"}) );

  AddFood( "Libellenfluegel (paniert)", ({ "fluegel", "libellenfluegel" }),
      250, 50, 15,
      ({ "Gefjon serviert Dir panierte Libellenfluegel, die Du sofort "
         "runterschluckst.\n",
         "&& bekommt panierte Fluegel serviert und verschlingt sie.\n" }) );

  AddFood( "Froschschenkel (geduenstet)", ({ "schenkel", 
           "froschschenkel", "frosch" }),
      300, 55, 20,
      ({"Gierig verschlingst Du die Froschschenkel und bekommst "
        "auf einmal Gusta auf Fliegen.\n",
        "&& verschlingt gierig Froschschenkel und blickt sich "
        "seltsamer Weise nach Fliegen um.\n" }) );

  AddFood( "Moorleiche", ({ "leiche", "moorleiche" }),
     500, 100, 33,
     ({ "Gefjon verschwindet in der Kueche und kommt wenig spaeter mit einer "
        "frischen Moorleiche wieder, die Du sogleich aufisst.\n",
        "&& isst eine Moorleiche und verzieht seltsam das Gesicht.\n" }) );

  AddFood( "Moorschnucke (gebraten)", ({ "schnucke", "moorschnucke" }),
      1000, 200, 50,
      ({ "Gefjon braet Dir eine frische Moorschnucke, die Du gierig "
         "verschlingst.\n",  
         "&& bekommt eine gebratene Moorschnucke und verschlingt "
         "sie gierig. *ruelps*\n" }) );


// DETAILBEGINN

  AddDetail( ({ "boden" }),
     "Der Boden besteht aus alten Holzbrettern." );
 
  AddDetail( ({ "holzbretter", "bretter" }),
     "Die Bretter bestehen aus Holz. Ueber ihnen hat sich schon "
     "eine ganze Menge Schmutz und Staub angesammelt. " );

  AddDetail( ({ "schmutz", "staub" }),
     "Hatschiii!!!\n"
     "Irgendjemand sollte hier mal gruendlich "
     "saubermachen! Tu Dir keinen Zwang an wenn Du gerade Lust zum "
     "Putzen verspuerst. " );
  
  AddDetail( ({ "holz", "birkenholz" }),
     "Eindeutig Birkenholz. ");

  AddDetail( ({ "lust" }),
     "Du kannst gerne etwas saubermachen hier. ");

  AddDetail( ({ "zwang" }),
     "Wenn Du putzen moechte dann tu dies doch einfach! ");

  AddDetail( ({ "putzen" }),
     "Der Boden wuerde wirklich etwas Reinigung benoetigen. ");

  AddDetail( ({ "reinigung" }),
     "Ganz staubig ist er schon. ");

  AddDetail( ({ "menge" }),
     "Geputzt wurde hier schon lange nicht, wie es scheint. Sonst "
     "waere der Boden nicht mit Schmutz und Staub so verdreckt. ");

  AddDetail( ({ "art" }),
     "Die Decke bildet wie es scheint ein Gewoelbe. ");

  AddDetail( ({ "augen" }),
     "Aengstlich mustern sie das Pentagramm. ");

  AddDetail( ({ "koerper" }),
     "Du zitterst am ganzen Leib. ");

  AddDetail( ({ "leib" }),
     "*zitter* ");

  AddDetail( ({ "kinder" }),
     "Eigentlich wundert es Dich dass Du in Polaris noch keine "
     "Kinder gesehen hast. ");

  AddDetail( ({ "polaris" }),
     "Du befindest Dich in einer Kneipe in Polaris. ");

  AddDetail( ({ "kneipe" }),
     "Hier kannst Du Speisen und Getraenke konsumieren, oder "
     "Dich einfach nur ein wenig ausrasten und umblicken. ");

  AddDetail( ({ "speisen", "getraenke" }),
     "Die findest Du alle auf der Speisekarte. ");

  AddDetail( ({ "speisekarte", "karte" }),
     "Die Karte kannst Du mit <menue> lesen. ");

  AddDetail( ({ "decke" }),
     "Die Decke liegt hoch ueber Dir und bildet eine Art Gewoelbe. " );

  AddDetail( ({ "gewoelbe" }),
     "Das Gewoelbe besteht komplett aus Stein und weist eine "
     "eigenartige Form auf. ");

  AddDetail( ({ "stein" }),
     "Normales Felsgestein. ");

  AddDetail( ({ "felsgestein", "gestein" }),
     "So ein Gestein was man normalerweise im Gebirge findet. ");

  AddDetail( ({ "form" }),
     "Die Form erinnert Dich an ein Pentagramm. ");

  AddDetail( ({ "pentagramm" }),
     "Aengstlich blicken Deine Augen zu dem Pentagramm, Dein "
     "ganzer Koerper beginnt zu zittern.\n"
     "Auf einmal erkennst Du eine Inschrift.\n" );

  AddDetail( ({ "inschrift" }),
     "Lies sie! ");

  AddDetail( ({ "streiter", "streitern" }),
     "Bist Du denn ueberhaupt bereit fuer das Wagnis, dass "  
     "auf Dich zukommen koennte? ");

  AddDetail( ({ "ruhm", "sieg", "ehre", "macht" }),
     "Du denkst Dir . o O (Moechte das nicht jeder gerne?)" );

  AddDetail( ({ "gebirge" }),
     "Das wirst Du hier kaum finden mein liebes Kind. ");

  AddDetail( ({ "kind" }),
     "Nur Kinder fragen so dumm wie Du gerade eben, liegt wohl an "
     "der Naivitaet. ");

  AddDetail( ({ "naivitaet" }),
     "Das ist nichts Schlechtes, aber egal...");

  AddDetail( ({ "schlechtes" }),
     "Nichts ist daran schlecht.");

  AddDetail( ({ "nordwand" }),
     "An der Nordwand haengt eine grosse Tafel. ");

  AddDetail( ({ "tafel" }),
     "Auf ihr wurden verschiedene Speisen und Getraenke mit Kreide "
     "gekritzelt. Du kannst sie mit <menue> lesen. ");

  AddDetail( ({ "kreide" }),
     "Mit Kreide wurden verschiedene Getraenke und Speisen auf "
     "der Tafel verewigt. ");

  AddDetail( ({ "tische" }),
     "Rechterhand stehen einige Tische, an denen man Getraenke und "
     "Speisen einnehmen kann. Momentan sind sie alle leer. ");

  AddDetail( ({ "stuehle" }),
     "Einfache Stuehle aus Holz stehen um die Tische herum. "
     "Kein einziger ist besetzt, such Dir einfach einen Platz aus. ");

  AddDetail( ({ "platz" }),
     "Du kannst Dich hinsetzen wo Du moechtest - alle Stuehle sind "
     "frei. ");

  AddDetail( ({ "mahl" }),
     "Wenn Du Hunger hast bestell Dir doch einfach etwas. ");

  AddDetail( ({ "hunger" }),
     "Das musst Du doch schon selbst wissen, ob Du einen hast. ");

  AddDetail( ({ "anstrengungen" }),
     "Du musst bereits einen weiten Weg zurueckgelegt haben. ");

  AddDetail( ({ "weg" }),
     "Nach Deinem langen Weg haettest Du Dir eigentlich etwas Kuehles "
     "verdient. ");

  AddDetail( ({ "kuehles" }),
     "Wie waers mit einem Hexenbraeu? ");

  AddDetail( ({ "hexenbraeu" }),
     "Das Hexenbraeu ist die Spezialitaet von Gefjon. ");

  AddDetail( ({ "gefjon" }),
     "Frag Gefjon doch einmal danach, falls sie in der Naehe sein sollte. ");

  AddDetail( ({ "naehe" }),
     "Manchmal geht Gefjon auch ihren Freund Lars besuchen. ");

  AddDetail( ({ "lars" }),
     "Oh, Lars ist wohl auch Dein Freund...");

  AddDetail( ({ "freund" }),
     "Mit Deinem Freundschaftsband siehst Du genau wieviele Freunde "
     "Du hast. ");

  AddDetail( ({ "freundschaftsband", "band" }),
     "'unt fband' ");

  AddDetail( ({ "freunde" }),
     "Mach doch einfach 'fwer ort' ");

  AddDetail( ({ "spezialitaet" }),
     "Gefjon weiss sicher mehr darueber Bescheid. ");

  AddDetail( ({ "theke", "holztheke" }),
     "Eine lange Holztheke befindet sich vor Dir. Sie ist "
     "blank poliert, und sieht sehr sauber aus. ");

  AddDetail( ({ "wand" }),
     "Meinst Du eine bestimmte? ");

  AddDetail( ({ "waende" }),
     "Ueberall an den Waenden wurden viele Zeichnungen angebracht. Nur "
     "die Nordwand unterscheidet sich etwas. An ihr befindet sich eine "
     "grosse Tafel. ");

  AddDetail( ({ "zeichnungen" }),
     "Viele bunte Zeichnungen. Sie zeigen Hexen, die gerade Feste feiern "
     "und Rituale durchfuehren. ");

  AddDetail( ({ "hexen" }),
     "Viele verschiedene Hexen wurden auf den Zeichnungen abgebildet. ");

  AddDetail( ({ "feste" }),
     "Hexen feiern oft Feste, und opfern ihren Goettern. ");

  AddDetail( ({ "rituale" }),
     "Es gibt viel zu viele Rituale, aber Du kennst Dich leider zu wenig "
     "damit aus. Vielleicht weiss ja irgendeine Hexe mehr darueber. ");

  AddDetail( ({ "hexe" }),
     "Frag doch einfach jemanden. ");

  AddDetail( ({ "goetter", "goettern" }),
     "Die Hexen huldigen oft Woody und Dusty aber auch anderen. ");

  AddDetail( ({ "woody", "dusty" }),
     "Woody und Dusty sind die Erschaffer dieser Welt. ");

  AddDetail( ({ "erschaffer" }),
     "Woody und Dusty haben diese Welt gemeinsam erschaffen. ");

  AddDetail( ({ "welt" }),
     "Silberland heisst diese Welt. ");

  AddDetail( ({ "silberland" }),
     "Man muss es selbst erleben, und eine Meinung darueber bilden. ");

  AddDetail( ({ "meinung" }),
     "Hast Du schon eine? ");

  AddDetail( ({ "aura" }),
     "Von den Zeichnungen geht diese seltsame Aura aus. Schau Dir doch "
     "einmal einige Zeichnungen genauer an! (kleiner Tip: unt zeichnung <nr>)");

  AddDetail( ({ "zeichnung 1" }),
     "Diese Zeichnung zeigt ganz viele tanzende Hexen und einen Berg. ");

  AddDetail( ({ "zeichnung 2" }),
     "Die Zeichnung zeigt eine Hexe vor einem grossen Kessel. ");

  AddDetail( ({ "zeichnung 3" }),
     "Ganz viele Flaeschchen wurden hier abgebildet. ");

  AddDetail( ({ "zeichnung 4" }),
     "Auf dieser Zeichnung graben einige Hexen Aepfel in die Erde ein. ");

  AddDetail( ({ "zeichnung 5" }),
     "Du siehst ein grosses Lagerfeuer. ");

  AddDetail( ({ "zeichnung 6" }),
     "Die Zeichnung zeigt wohl eine Hexe die einen Zauberspruch lernt, "
     "denn man sieht bloss einen Frosch. ");

  AddDetail( ({ "zeichnung 7", "zeichnung 8", "zeichnung 9" }),
     "Leider kannst Du nichts genaueres erkennen. ");

  AddDetail( ({ "tip" }),
     "Ein klitzekleiner. ");

  AddDetail( ({ "frosch", "aepfel", "berg", "zauberspruch", "erde",
                "kessel", "flaeschchen", "lagerfeuer" }),
     "Du kannst es leider nicht genau erkennen. ");

  AddDetail( ({ "treppe" }),
     "Du kannst keine sehen. ");
 
// DETAILENDE


// SMELLS

  AddSmell(DEFAULT_SMELL,
     "Hmmm. Lecker! Es duftet hier nach vielen verschiedenen Speisen. "
     "Der Geruch scheint aus der Kueche zu kommen. ");

  AddSmell( ({ "speisen" }),
     "Der Geruch von koestlichen Moorhuhneiern, vermischt sich mit dem "
     "von gebratenen Moorschnucken und anderen guten Sachen. ");

  AddSmell( ({ "sachen" }),
     "Libellenfluegel, Froschschenkel, Moorhuhn, ... ");

  AddSmell( ({ "moorhuhn", "huhn", "froschschenkel", "libellenfluegel", 
               "fluegel" }),
     "Einfach herrlich! ");

  AddSmell( ({ "geruch" }),
     "Es riecht nach vielen verschiedenen Speisen. ");

  AddSmell( ({ "kueche" }),
     "Du schnupperst dem Geruch etwas nach...Er scheint von oben zu kommen?! "
     "Anscheinend fuehrt hier irgendwo eine Treppe nach oben in die Kueche. ");

  AddSmell( ({ "treppe" }),
     "Da Du keine sehen kannst, kannst Du auch nicht an ihr riechen. ");

  AddSmell( ({ "moorhuhneier", "eier", "schnucken", "moorschnucken" }),
     "Lecker! Du musst Dir sofort irgendwas bestellen, Du beginnst "
     "ja schon zum Sabbern! ");

  AddSmell( ({ "sabbern" }),
     "Das kannst Du nicht riechen, aber an Deinem rechten Mundwinkel "
     "tropft bereits irgendeine zaehe Fluessigkeit herunter. ");

  AddSmell( ({ "mundwinkel", "fluessigkeit" }),
     "PFUI !!!");

// SOUNDS

  AddSound(DEFAULT_SOUND,
     "Glaeser, Teller und Besteck klirren abundzu. Ausserdem kannst "
     "Du noch ein komisches dumpfes Geraeusch vernehmen. ");

  AddSound( ({ "geraeusch" }),
     "Du denkst Dir . o O (seltsam, das Geraeusch kommt von oben!) ");

  AddSound( ({ "besteck" }),
     "*klirr* ");

  AddSound( ({ "glaeser" }),
     "*klimper* ");

  AddSound( ({ "teller" }),
     "*klesch* *dsch* *tusch* *klampf* ");

 
  AddReadDetail( ({ "inschrift" }),
    "Ruhm und Ehre dem Pentagramm! Sieg und Macht seinen Streitern!");
 

  AddItem(NPC ("gefjon") , REFRESH_DESTRUCT);
 
  AddCmd( ({ "probiere", "probier" }), "c_probieren" );  
  AddCmd( ({ "putz", "putze", "saeuber", "saeubere" }), "c_putzen" );  
  AddCmd( ({ "klopf", "klopfe" }), "c_klopfen");


}

int c_klopfen( string str )
{
 if(str !="wand"  &&
    str != "an wand" )
 { 
  notify_fail("Was moechtest Du klopfen?\n");
  return 0;
 }
 else 
 {
  write(BS("Du klopfst gegen die Wand, und ein Ausgang wird sichtbar. "));
  AddSpecialExit( "oben", "kuechefkt"); 
  return 1; 
 }
}

int kuechefkt(string dir)
{
 RemoveExit("oben");
 write("Du gehst ueber eine Treppe nach oben.\n");
 this_player()->move(ROOM ("kueche"), M_GO,
       "ueber eine Treppe", "geht", "kommt herauf");
 say("Der Ausgang verschwindet wieder.\n");
 return 1;
}


int c_probieren( string str )
{
 if( str != "leiche" && str != "moorleiche" )
 {
  notify_fail("Was moechtest Du probieren?\n");
  return 0;
 }
 else
 {
  write(BS("Du kostest ein Stueck Moorleiche. Hmmm...ist das aber lecker! "
           "Vielleicht koenntest Du Dir ja eine ganze auch bestellen...\n"));
  WLOG(LOG("polaris.log"), "kostet Moorleiche");
  return 1;
 }
}

int c_putzen( string str )
{
 if(!str || str == "" ) 
 {
  write(BS("Was moechtest Du hier putzen?\n"));
  return 1;
 }

 if( str == "boden" )
 {
  write("Du reisst unbemerkt ein Stueck Stoff von einem Tischtuch und "
        "beginnst aeusserst genau den Boden zu putzen.\n"
        "Pfoh!!! Ist das "
        "anstrengend denkst Du Dir, doch nach getaner Arbeit bewunderst "               "Du stolz Dein Meisterwerk.\n"
        "Ploetzlich bedeckt wieder eine dicke Staubschicht den "
        "Boden - hier geht es zweifelslos nicht mit rechten Dingen zu.\n");
 return 1;
 }
}


