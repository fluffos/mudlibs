inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../marisol.h"
#include <moving.h>
#include "/gilden/bardengilde/barden_extern.h"

create()
{

::create();

  SetProp(P_INT_SHORT,  "In einem Keller");
  SetProp(P_INT_LONG,
     "Das daemmrige Licht von Kerzen zieht Dich in seinen Bann. "
     "Unaufhaltsam tropft ihr Wachs auf den pechschwarzen Boden, von dem "
     "immerwaehrend der zarte liebliche Hauch des Todes aufzusteigen scheint. "
     "An den steinernen Waenden haengen blutrote Rosen, deren Stacheln Dich "
     "an die Suesse des Jenseits erinnern. Ein riesiger von Gold umrahmter "
     "Spiegel haengt an einer der Waende, davor ein Tischchen mit kunstvoll "
     "geschnitzten Ornamenten. In der Mitte des Raumes befindet sich ein "
     "Himmelbett, von schwarzen Spitzenvorhaengen eingehuellt, die jeglichen "
     "Blick in sein Inneres verhindern. Doch huete Dich davor ein Reich zu "
     "betreten, welches nicht Dir vorherbestimmt ist...");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 6, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_KILL_NAME, "Die Sehnsucht nach dem Tod");
    
  
  AddExit( "raus", ROOM("keller3") );

  AddExit("bett", 
    ([ EX_FUNC    : "testfunc2" ]) );


// DETAILBEGINN

  
  AddDetail( ({ "licht" }),
    "Das flackernde Licht der Kerzen wirft ein unheimliches Schattenspiel "
    "an die Wand.");

  AddDetail( ({ "kerzen", "kerze" }),
    "Nur durch die spaerlichen Flammen der Kerzen wird dieser Keller etwas "
    "erhellt. ");

  AddDetail( ({ "wachs" }),
    "Staendig tropft das Wachs der Kerzen auf den tiefschwarzen Steinboden. ");

  AddDetail( ({ "boden", "steinboden" }),
    "Pechschwarz ist der Boden unter Deinen Fuessen; kalt sind die Steine, aus "
    "denen er gefertigt wurde. Es scheint als wuerden sie Dich rufen. ");

  AddDetail( ({ "hauch" }),
    "Der suesse Duft des Todes scheint Dich einzuhuellen. Sehnsucht ueberkommt "
    "Dich - ob der Tod seine rettende Hand bald nach Dir ausstrecken wird?! ");

  AddDetail( ({ "tod" }),
    "Er wartet auf Dich, laesst Dich keinen Moment aus seinen Augen. ");

  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind aus festem Stein; einige blutrote Rosen haengen an "
    "ihnen. An einer der Waende befindet sich ein riesiger goldener Spiegel. ");

  AddDetail( ({ "rosen", "rose" }),
    "Getrocknete blutrote Rosen, deren spitze Stacheln bei jeglicher "
    "Beruehrung, auch wenn sie noch so sanft ist, das Blut aus Deinen Adern "
    "fliessen lassen. ");

  AddDetail( ({ "stacheln", "stachel" }),
    "Huete Dich vor ihnen, wenn Du nicht ins Jenseits moechtest!");

  AddDetail( ({ "jenseits" }),
    "Das Jenseits will Dich sanft in seinen Bann huellen. ");

  AddDetail( ({ "bann" }),
    "Komm liebes Kind, erloese Dich selbst von den Qualen. ");

  AddDetail( ({ "qual", "qualen" }),
    "Ob der kleine Gruftie auch so Qualen durchleben muss?");

  AddDetail( ({ "gruftie" }),
    "Er ist nicht hier.");

  AddDetail( ({ "spiegel" }),
    "Er ist mit Gold umrandet, und haengt an einer der Waende. Vielleicht "
    "solltest Du hineinblicken, um mehr zu erfahren?" );

  AddDetail( ({ "gold" }),
    "Der Spiegel muss sehr wertvoll sein. ");

  AddDetail( ({ "himmelbett", "bett" }),
    "Vor lauter Vorhaengen laesst sich das Bett von hier aus kaum erkennen. ");

  AddDetail( ({ "vorhaenge", "spitzenvorhaenge" }),
    "Schwarze Spitzenvorhaenge umhuellen das Himmelbett, und verwehren Dir "
    "jeglichen Blick in sein Inneres. ");

  AddDetail( ({ "inneres" }),
    "Du kannst von hier aus nichts erkennen. ");

  AddDetail( ({ "blick" }),
    "Ob es wirklich sinnvoll ist, zu erfahren was sich in dem Bett befindet?");

  AddDetail( ({ "reich" }),
    "Ob Dir der Zutritt gewaehrt wird?");

  AddDetail( ({ "zutritt" }),
    "Der Tod erwartet Dich!");

  AddDetail( ({ "kind" }),
    "Komm und erloese Dich!!!");

  AddDetail( ({ "decke" }),
    "Schwarz - nichts als schwarz, wo man normalerweise die Decke sehen "
    "sollte." );

  AddDetail( ({ "fuesse" }), 
    "Deine Fuesse wandern auf dem schwarzen Boden entlang. ");

  AddDetail( ({ "duft" }),
    "Riechst Du ihn nicht? Immer tiefer atmest Du den suessen Duft des "
    "Todes ein, immer groesser wird die Sehnsucht, Dein Verlangen Deinem "
    "Leben ein Ende zu bereiten. ");

  AddDetail( ({ "stein" }),
    "Fester Stein. ");

  AddDetail( ({ "flammen", "flamme" }),
    "Die Flammen erhellen den Keller nur sehr spaerlich, und projizieren "
    "unheimliche Schattenspiele an der Wand. ");

  AddDetail( ({ "schattenspiele", "schattenspiel", "spiel", "spiele" }),
    "Es scheint als wuerden sich die Schatten gegenseitig bekaempfen. ");

  AddDetail( ({ "schatten" }),
    "Bald werden auch sie erloest sein. ");

  AddDetail( ({ "keller", "raum" }),
    "Du befindest Dich doch hier!");

  AddDetail( ({ "beruehrung" }),
    "Schon eine noch so sanfte Beruehrung wuerde das Blut aus Deinen Adern "
    "stroemen lassen, und Dich liebevoll in das Reich des Todes tragen. ");

  AddDetail( ({ "wichtiges" }),
    "Noch ist Dir der Zutritt verwehrt! ");

  AddDetail( ({ "blut" }),
    "Das Blut wird fliessen, blutrot aus Deinen Armen, aus Deinem ganzen "
    "Koerper. ");

  AddDetail( ({ "koerper" }),
    "Du spuerst wie Deine Lebensenergie immer schwaecher wird.");

  AddDetail( ({ "lebensenergie", "energie" }),
    "Bald wird sie ausgeloescht sein, so wie auch der Docht einer Kerze "
    "irgendwann abgebrannt ist. ");

  AddDetail( ({ "docht" }),
    "Es dauert nicht mehr lange.");

  AddDetail( ({ "ader", "adern" }),
    "Das Blut wird aus ihnen stroemen, so wie ein Fluss immerwaehrend gen "
    "Meer fliesst. ");

  AddDetail( ({ "fluss", "meer" }),
    "Finde es selbst heraus!");

  AddDetail( ({ "arme" }),
    "Leblos und blass werden sie Dir vom Koerper haengen. ");

  AddDetail( ({ "augen", "moment" }),
    "Der Tod verfolgt Dich.");

  AddDetail( ({ "hand" }),
    "Du sehnst Dich nach der rettenden Hand, die Hand, die Dich befreit. ");

  AddDetail( ({ "ende" }),
    "Lange musst Du nicht mehr darauf warten. ");

  AddDetail( ({ "leben" }),
    "Es ist vergaenglich, seinem eigenen Tod kann man nicht davonlaufen. ");

  AddDetail( ({ "sehnsucht" }),
    "Die Sehnsucht ueberkommt Dich immer mehr, Melancholie begleitet Dich auf "
    "allen Deinen Wegen. ");

  AddDetail( ({ "verlangen" }),
    "Unstillbares Verlangen. ");

  AddDetail( ({ "melancholie" }),
    "Dein staendiger Begleiter. ");

  AddDetail( ({ "begleiter" }),
    "Sehnsucht, Melancholie, Verlangen, ...");

  AddDetail( ({ "wege" }),
    "Das musst Du selbst herausfinden. ");

  AddDetail( ({ "mitte" }),
    "Genau in der Mitte steht ein riesiges, mit schwarzen Spitzenvorhaengen "
    "verkleidetes Himmelbett. ");

  AddDetail( ({ "ornamente" }),
    "Kunstvoll geschnitzte Ornamente verzieren das kleine Tischchen. Ob sie "
    "von Bedeutung fuer Dich sein koennten? ");

  AddDetail( ({ "bedeutung" }),
    "Du kannst keine finden. Zumindest nicht so :)");

  AddDetail( ({ "suesse" }),
    "Suess und lieblich. ");

  AddDetail( ({ "lade" }),
    "In der Lade befindet sich ein Glaeschen Tinte, eine Feder, und ein "
    "Pergament. Sonst ist sie leer. ");

  AddDetail( ({ "tinte", "glaeschen" }),
    "Schwarze Tinte in einem Glaeschen, die man normalerweise zum Briefe "
    "schreiben verwendet. ");

  AddDetail( ({ "briefe", "brief" }),
    "Normalerweise benoetigt man Feder, Tinte und Pergament, um einen "
    "Brief zu schreiben. ");

  AddDetail( ({ "feder" }),
    "Eine schwarze Feder zum Schreiben. ");

  AddDetail( ({ "schreiben" }),
    "Feder und Tinte dienen zum Schreiben. ");

  AddDetail( ({ "pergament" }),
    "Auf das Pergament wurde etwas geschrieben. Scheint ein Brief zu sein. ");

  AddReadDetail( ({ "pergament" }),
    "Probiers mal mit <lies brief>");

  AddReadDetail( ({ "brief" }),
    "@@brief_read_detail@@");

  AddDetail( ({ "tisch", "tischchen" }),
    "Das Tischchen wurde kunstvoll gearbeitet und ist mit Ornamenten "
    "uebersaet. Eine kleine Lade befindet sich unter der Tischplatte. ");

  AddDetail( ({ "platte", "tischplatte" }),
    "Auf der Platte liegen ein kleines Doeschen und "
    "ein schwarzer Kajal. ");

  AddDetail( ({ "kajal", "stift", "kajalstift" }),
    "Ein schwarzer Kajalstift liegt auf dem Tischchen. Man kann sich "
    "mit ihm schminken. ");

  AddDetail( ({ "doeschen" }),
    "Der Inhalt des Doeschens ist weiss. Sieht aus wie Puder!");

  AddDetail( ({ "inhalt" }),
    "In dem Doeschen befindet sich weisser Puder. ");

  AddDetail( ({ "puder" }),
    "Du kannst Dir damit sicherlich Dein Gesicht pudern. ");

  AddDetail( ({ "gesicht" }),
    "Mit dem Puder kann man sich das Gesicht pudern.");

// SMELLS

  AddSmell(DEFAULT_SMELL, 
    "Du riechst das Wachs der Kerzen. ");

  AddSmell( ({ "kerzen" }),
    "Spaerlich naehren sich die Flammen. ");

  AddSmell( ({ "flammen" }),
    "Das Wachs verbrennt langsam...");

  AddSmell( ({ "wachs", "wachses" }),
    "Ganz deutlich riechst Du den Dir vertrauten Geruch des Wachses, "
    "waehrend es langsam auf den Boden tropft. ");

  AddSmell( ({ "geruch"  }),
    "Er ist Dir sehr vertraut. ");


// SOUNDS

  AddSound(DEFAULT_SOUND, "Hier herrscht Totenstille!");
 
  AddSound( ({ "stille", "totenstille" }),
    "Absolut nichts ist zu hoeren!");

  AddSound( ({ "nichts" }),
    "                      ");

  AddSound( ({ "steine" }),
    "Komm zu uns! Der suesse Tod erwartet Dich!");


  AddCmd( ({ "beruehre", "beruehr" }), "c_beruehren");
  AddCmd( ({ "blick", "blicke" }), "c_blicken");
  AddCmd( ({ "puder", "pudere" }), "c_pudern");
  AddCmd( ({ "schminke", "schmink" }), "c_schminken");


}

int c_schminken(string str)
{
 if(str != "mit kajalstift"  &&
    str != "mit kajal"       &&
    str != "mit stift"       )
 {
  notify_fail("Womit moechtest Du Dich schminken?!\n");
  return 0;
 }
 else
 {
  if(TP->QueryProp(P_GHOST) || TP->QueryProp(P_FROG))
  { 
   write(BS("Aber in Deinem momentanen Zustand kannst Du das doch gar nicht!"));
   return -1;
  }
  else
  {
   write(BS("Schnell ziehst Du mit dem Kajal gekonnt ein paar schwarze "
           "Kreise um Deine Augen... Verflucht! Jetzt bist Du rausgefahren! "
           "Schnell wieder wegwischen!"));
   say(CTPN+ " reibt sich die Augen.\n");
   return 1;
  }
 }
}


int c_pudern(string str)
{
 if ( str != "gesicht" )
 {
  notify_fail("Was moechtest Du hier pudern?\n");
  return 0;
 }
 else
 {
  write(BS("Beim Versuch Dein Gesicht zu pudern musst Du auf einmal "
           "schrecklich niesen! Hatschiiii!"));
  say(CTPN+ " niest.\n");
  return 1;
 }
}



int c_beruehren(string str)
{
  if (str != "rosen"   &&
	  str != "stacheln"  )
  {
	notify_fail("Was moechtest Du beruehren?\n");
	return 0;
  }
  else
  {
   if(TP->QueryProp(P_GHOST))
   {
    write(BS("Das kannst Du doch gar nicht als Geist!"));
    return -1;
   }
   else
   {
    write(BS("AUAAAAAAA! Das tut weh!")); 
    TP->do_damage(60+random(10), this_object());
    return 1;
   } 
  }
}




int c_blicken(string str)
{
 if (str != "in spiegel")
 {
   notify_fail("Wo moechtest Du reinschaun?\n");
   return 0;
 }
 else
 {
  if(TP->QueryProp(P_FROG))
  {
   write(BS("Der Spiegel ist viel zu hoch oben fuer einen Frosch wie Dich."));
   return -1;
  }
  else
  {
   write(BS("Du blickst in den Spiegel und siehst Dein leichenblasses "
            "Ebenbild... auf einmal bist Du wie erstarrt. "));
   TP->SetProp(P_POISON, 1);
   TP->SetProp(P_PARALYZED,
   ([ PARALYZE_TIME: 36,
      PARALYZE_MSG: "Du verlierst grad massig an XP so nebenbei bemerkt..."
      "Wieviele? Lass Dich ueberraschen, falls Du je wieder zum >info< tippen "
      "kommst...\n",
      PARALYZE_MSG_OTHER: "%s versucht sich zu bewegen, ist aber "
      "momentan nicht dazu in der Lage.\n",
      PARALYZE_END_OTHER: ""]));
   return 1;
  }
 }
}
  
int testfunc2()
{
 if(!present("\npolaris_anh", TP))
 {
  notify_fail("Etwas Wichtiges fehlt!\n");
  return 0;
 }
 else
 {
  TP->move(ROOM("bett"), M_GO,
    "ploetzlich", "verschwindet", "steht ploetzlich vor Dir");
  return 1;
 }
}

public void bard_gs7_check() {
  object ob;
  if(!objectp(present(BARD_ID_GS7_BRIEF, this_player()))
     || present(BARD_ID_GS7_STROPHE_2, this_player())) return;
  tell_object(this_player(), 
    BS("Gerade als du den Brief wieder weglegst faellt ein kleiner, verknitterter "
       "Zettel mit der krakeligen Handschrift Edgars, dem Barden, daraus hervor. "
      "Du steckst ihn sofort ein."));
  ob = clone_object("/gilden/bardengilde/obj/quest/gs7_brief_strophe");
  ob->AddId(BARD_ID_GS7_STROPHE_2);
  ob->move(TP, M_GET|M_NOCHECK);

  present(BARD_ID_GS7_BRIEF, this_player())->check_teile();
  return;
}

public string brief_read_detail() {
  call_out("bard_gs7_check", 0);
  return 
  "\n"
  "Ich kann nicht mehr - ich bin am Ende zu seh'n, wie alles rings zu "
  "Steinen wird. Die Waerme ist uns schon Legende. Wir fassen nichts, "
  "wir haben uns verirrt. Was woll'n wir noch - wir sind verloren - was "
  "bleibt uns noch in diesem schwarzen Loch. Wir waeren besser ungeboren, "
  "und langsam sterben wir und leben doch. Wir sind nur Puppen, die zu "
  "fuehren es einer fremden Hand gelingt und dennoch koennen wir es "
  "spueren, wie schrill und stoehnend unser Herz zerspringt. So ist am "
  "Ende doch geblieben, was zu zerstoeren immer noch misslang. Ein Rest der "
  "Faehigkeit zu lieben und Angst vor dem, was uns bis hier verschlang. "
  "\n";
}
