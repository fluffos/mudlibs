inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{

::create();

  SetProp(P_INT_SHORT, "Auf einem Ast");
  SetProp(P_INT_LONG, 
    "Du stehst auf einem dicken Ast und umschlingst mit beiden Haenden fest "
    "den Stamm des Baumes, um nicht hinunterzufallen. Ueberall bist Du "
    "von dem dichten Blaetterwerk des Baumes umgeben. Ein kuehler Wind "
    "streift manchmal durch die Blaetter und verursacht ein leises Rascheln. "
    "Weiter oben kannst Du einen dicken Ast erkennen, den Du sicherlich mit "
    "etwas Geschick erreichen konntest. "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0 );


  AddCmd( ({ "kraxel", "kraxl", "kraxle" }), "c_kraxeln" );

}

int c_kraxeln(string str )
{
 if( str != "auf ast"  &&
     str != "runter"   &&
     str != "hinunter" )
 {
  notify_fail("Wohin moechtest Du kraxeln?\n");
  return 0;
 }
 if( str == "runter"   ||
     str == "hinunter" )
 {
  write(BS("Vorsichtig kraxelst Du wieder hinunter. "));
  TP->move(ROOM ("room7"), M_GO,
  "hinunter", "kraxelt", "faellt herein" );
  return 1;
 }
 if( str == "auf ast" )
 {
  write(BS("Du kraxelst auf einen anderen Ast. "));
  TP->move(ROOM ("weg2"), M_GO,
  "irgendwohin", "klettert", "klettert herauf" );
  return 1;
 }
}


