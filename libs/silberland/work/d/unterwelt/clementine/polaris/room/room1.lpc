inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{

::create();

  SetProp(P_INT_SHORT, "In einem Birkenwaeldchen");
  SetProp(P_INT_LONG,
     "Du findest Dich auf einmal in einem kleinen Birkenwaeldchen wieder. "
     "Wie eine Allee saeumen die Baeume Deinen Weg. Noerdlich von Dir breitet "
     "sich ein weites Moor aus. Doch hier bist Du sicher. Du spuerst den "
     "festen Boden unter Dir. Im Sueden wird das Waeldchen zunehmend dichter. "
     "Die Baeume stehen zu eng beieinander, so dass Du keine Moeglichkeit "
     "siehst Deinen Weg nach Sueden fortzusetzen. Froehlich tummeln sich ein "
     "paar Voegel auf den Baeumen. Die Blaetter rauschen im Wind. "
     "Auf dem Boden liegen jede Menge Birkenblaetter.  "
     "Ein paar Aeuglein scheinen Dich von Sueden her aengstlich zu fixieren. "
     "In der Luft liegt ein seltsamer aber beruhigender Geruch und Du "
     "glaubst bereits Umrisse von Huetten in der Ferne erkennen zu koennen. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0 );

  AddExit( "osten", ROOM ("room2") );
  AddExit( "westen", ANSCHLUSS_HUEGELLAND );



// DETAILBEGINN
  
  AddDetail( ({ "birkenwaeldchen", "birkenwald", "wald", "waeldchen" }),
     "Du bist umringt von lauter Birken. Ihre weisse Rinde sendet ein "
     "seltsames Licht aus. Dennoch fuehlst Du Dich hier sicher, was "
     "sich allerdings schlagartig aendern koennte. Ab und zu vernimmst Du "
     "Schreie, doch sie sollten Dich hier noch nicht weiter beschaeftigen. ");

  AddDetail( ({ "allee" }),
     "Der ganze Weg wird von Birken gesaeumt. Sie bilden eine Art "
     "Waeldchen. Du spuerst richtig, wie sich Dein Koerper mit der "
     "frischen Luft fuellt. ");

  AddDetail( ({ "birke", "birken", "moorbirke", "moorbirken" }),
     "Mit Deinem Kennerblick siehst Du sofort, dass es sich hier um "
     "sogenannte Moorbirken handelt. Man trifft sie meistens in der "
     "Naehe von Mooren, da sie feuchten Untergrund lieben. Die "
     "Rinde aller Birken strahlt Dir in einem hellen Weiss entgegen. "
     "Einige Voegel tummeln sich auf den Aesten. "); 

  AddDetail( ({ "weiss" }),
    "Strahlend weiss. ");

  AddDetail( ({ "kennerblick" }),
     "Ja, den hattest Du anscheinend gerade. ");

  AddDetail( ({ "naehe" }),
     "Das Moor befindet sich ganz in Deiner Naehe. ");

  AddDetail( ({ "ast", "aeste" }),
     "Auf den Aesten erkennst Du einige Voegel. Anscheinend haben sie hier "
     "ihre Nester gebaut. ");

  AddDetail( ({ "nest", "nester" }),
     "So nahe kommst Du leider nicht heran. ");

  AddDetail( ({ "rinde" }),
     "Die Rinde strahlt Dir in einem hellen Weiss entgegen. Eine sehr "
     "sonderbare Aura strahlt von ihr aus. ");

  AddDetail( ({ "aura" }),
     "Wirklich sonderbar. ");

  AddDetail( ({ "untergrund" }),
     "Die feuchte Erde hier bietet einen guten Untergrund. ");

  AddDetail( ({ "baum", "baeume" }),
     "Lauter Birken saeumen Deinen Weg. Im Sueden stehen sie viel "
     "viel dichter beisammen, sodass Du eigentlich keine Moeglichkeit siehst "
     "weiter in diese Richtung vorzudringen. ");
  
  AddDetail( ({ "richtung" }),
     "Sueden ist gemeint. ");

  AddDetail( ({ "weg" }),
     "Der Weg fuehrt von Westen nach Osten. Der Boden besteht aus fester "
     "Erde, Du kannst einige Blaetter erkennen. ");
 
  AddDetail( ({ "erde" }),
     "Die Erde sieht recht zertrampelt aus. Es scheint, als haetten "
     "bereits viele Abenteurer diesen Weg beschritten. ");

  AddDetail( ({ "abenteurer" }),
     "Bist Du denn nicht auch einer von ihnen? ");

  AddDetail( ({ "moor", "moore", "mooren" }),
     "Das Moor liegt weiter im Norden, aber Du kannst es schon gut "
     "von hier erkennen. Es ist komplett von Nebelschwaden und Dunst "
     "eingehuellt. ");

  AddDetail( ({ "dunst", "nebelschwaden", "nebel", "schwaden" }),
     "Nebelschwaden und Dunst huellen das Moor komplett ein. Wie "
     "ein Schleier breiten sie sich aus. Eine duestere Stimmung "
     "macht sich breit. ");

  AddDetail( ({ "schleier" }),
     "Wie ein Schleier umhuellen Nebelschwaden das Moor. ");

  AddDetail( ({ "stimmung" }),
     "Eine duestere und magische Stimmung geht von dem Moor aus. "
     "Wenn Du mutig genug bist kannst Du ja versuchen einen Weg in "
     "dieses Gelaende zu finden. ");

  AddDetail( ({ "gelaende" }),
     "Ein sumpfiges Moor breitet sich nach Norden aus. Hier siehst Du "
     "allerdings keine Moeglichkeit um dorthin zu gelangen. ");

  AddDetail( ({ "boden" }),
     "Auf dem Boden erkennst Du einige abgefallene Blaetter. Der "
     "Zersetzungsprozess nimmt hier in Ruhe seinen Lauf. ");
 
  AddDetail( ({ "zersetzungsprozess", "prozess", "zersetzung" }),
     "Alte Blaetter verfaulen, neue entstehen. ");

  AddDetail( ({ "ruhe" }),
     "Naja die Natur muss sich ja nicht hetzen. Oder glaubst Du etwa "
     "sie hat soviel Stress wie Du? ");
 
  AddDetail( ({ "stress" }),
     "Verpflichtungen bringen Stress mit sich. ");

  AddDetail( ({ "verpflichtungen" }),
     "Arbeiten, studieren, Dein Zahnarzttermin morgen... ");

  AddDetail( ({ "zahnarzttermin", "termin" }),
     "Oh hast Du etwa keinen? Dann wirds mal wieder Zeit den Arzt "
     "aufzusuchen! ");

  AddDetail( ({ "arzt", "zahnarzt" }),
     "Na los ruf ihn schon an! ");

  AddDetail( ({ "zeit" }),
     "Zeit wirds Maedls! ");

  AddDetail( ({ "maedls" }),
     "Und Jungs =) ");

  AddDetail( ({ "jungs" }),
     "Aus Punkt Schluss. ");

  AddDetail( ({ "punkt" }),
     ". ");
 
  AddDetail( ({ "ende", "schluss" }),
     "Ende und Schluss. ");

  AddDetail( ({ "lauf" }),
     "Die Natur geht immer ihren Lauf. Das haelt das Gleichgewicht im Takt. ");

  AddDetail( ({ "gleichgewicht" }),
     "Du versuchst Dein Gleichgewicht zu halten, faellst aber auf die Nase. ");
 
  AddDetail( ({ "nase" }),
     "Ja, die tut Dir jetzt weh. ");

  AddDetail( ({ "takt" }),
     "1, 2, 3, 4, trallalalla =) ");

  AddDetail( ({ "himmel" }),
     "Die Sonne strahlt vom Himmel. Es scheint fast so, als wuerde sie Dich "
     "anlaecheln. Ein paar kleine Woelkchen ziehen vorbei, doch es scheint "
     "als waere heute einfach ein schoener Tag zum Sonnen und faul in der "
     "Wiese liegen. ");

  AddDetail( ({ "sonne" }),
     "Die Sonne laechelt Dich an. Sie scheint heute besonders hell "
     "herab zu strahlen. Hoffentlich hast Du Deine Sonnenbrille eingepackt. ");

  AddDetail( ({ "sonnenbrille", "brille" }),
     "Du wirst sie doch nicht etwa vergessen haben, oder? ");

  AddDetail( ({ "woelkchen" }),
     "Kleine Woelkchen ziehen vorueber. Eine Wolke faellt Dir allerdings "
     "besonders auf. ");

  AddDetail( ({ "wolke" }),
     "Diese Wolke sieht irgendwie gefaehrlich aus. Sie hat eine dunkle Farbe, "
     "sieht wohl nach Regen aus. ");

  AddDetail( ({ "regen" }),
     "Ploetzlich prasselt ein Schwall Wasser auf Dich herab. War wohl nichts "
     "mit dem sonnen. ");

  AddDetail( ({ "schwall", "wasser" }),
     "Pudelnass beutelst Du Dich. ");

  AddDetail( ({ "tag" }),
     "Wahrlich ein schoener Tag doch irgendetwas scheint nicht zu stimmen. ");

  AddDetail( ({ "wiese" }),
     "Haettest Du ein Badetuch, koenntest Du Dich vielleicht irgendwo "
     "hinlegen und Dich sonnen. ");

  AddDetail( ({ "badetuch" }),
     "Hast Du denn eins? ");

  AddDetail( ({ "moeglichkeit", "moeglichkeiten" }),
     "Nein, Du siehst ueberhaupt keine Moeglichkeit hier nach Sueden "
     "vorzudringen. Der Wald ist einfach zu dicht. Du bist Dir sicher, "
     "im Sueden nicht einmal mehr die Hand vor Augen sehen zu koennen. ");

  AddDetail( ({ "hand" }),
     "Noch ist sie dran. ");
 
  AddDetail( ({ "augen" }),
     "Du solltest zwei davon haben. ");

  AddDetail( ({ "vogel", "voegel" }),
     "Du kannst nicht genau erkennen, um welche Voegel es sich hier handelt. "
     "Haettest wohl besser in Bio aufpassen sollen! ");

  AddDetail( ({ "blaetter", "blatt", "birkenblaetter" }),
     "Die Blaetter der Birken sind eher rundlich und weisen eine "
     "stumpfgruene Farbe auf. Als Kind bist Du immer fuerchterlich gern "
     "durch das raschelnde Laub gestapft. ");

  AddDetail( ({ "farbe" }),
     "Die Blaetter der Birken sind stumpfgruen. ");

  AddDetail( ({ "graue farbe" }),
     "Richtig duester! ");
 
  AddDetail( ({ "stumpfgruen" }),
     "Stumpfgruen ist ein eher dunkles Gruen. ");
 
  AddDetail( ({ "gruen" }),
     "Gruen, gruen, gruen blueht nicht der Enzian. ");

  AddDetail( ({ "enzian" }),
     "Wenn Du meinst hier einen zu finden irrst Du Dich sehr. ");

  AddDetail( ({ "aeuglein" }),
     "Zwei Aeuglein verfolgen Dich auf Schritt und Tritt hier. Sie "
     "gehoeren wohl zu einem aengstlichen Tier, das sich gerade vor Dir "
     "versteckt. ");

  AddDetail( ({ "schritt" }),
     "Du machst einen Schritt Richtung Sueden, aber kannst nichts erkennen. ");

  AddDetail( ({ "tritt" }),
     "Clementine tritt Dich aus der Ferne. ");

  AddDetail( ({ "tier" }),
     "Wenn Du nur wuesstest, welches Tier das sein koennte. Du haettest "
     "anscheinend doch besser in Biologie aufpassen sollen. ");
 
  AddDetail( ({ "biologie", "bio" }),
     "In der Schule hast Du wohl nicht aufgepasst, und ich erklaer Dir "
     "hier sicherlich nichts ueber Bluemchen und Bienchen. ");

  AddDetail( ({ "luft" }),
     "Die Luft ist ziemlich feucht hier. Aber dennoch kannst Du richtig "
     "frei durchatmen. Du fuehlst Dich entspannt und bereit fuer neue "
     "Abenteuer. ");

  AddDetail( ({ "abenteuer" }),
     "Die wirst Du hier sicherlich noch erleben. ");

  AddDetail( ({ "huette", "huetten" }),
     "In der Ferne siehst Du bereits die Umrisse von Huetten. Mehr kannst "
     "Du allerdings hier noch nicht erkennen. Du muesstest Dich schon selbst "
     "auf den Weg dorthin machen. Aber huete Dich vor dem Boesen! ");
 
  AddDetail( ({ "boeses", "boesen" }),
     "Huete Dich davor! ");

  AddDetail( ({ "ferne" }),
     "In weiter Ferne erkennst Du die Umrisse einiger Huetten. Vielleicht "
     "leben dort ja ein paar Bewohner, die Dir etwas zu erzaehlen haben. ");

  AddDetail( ({ "bewohner" }),
     "Du musst schon weiter nach Osten vordringen, um das festzustellen. ");

  AddDetail( ({ "umrisse", "umriss" }),
     "Du erkennst wage Umrisse in der Ferne. Anscheinend stehen weiter "
     "im Osten ein paar Huetten. Versuche Dein Glueck und erforsche sie! ");

  AddDetail( ({ "glueck" }),
     "Das wirst Du brauchen!\n" 
     "Jemand grinst Dich blutruenstig aus der Ferne an. "); 
 
  AddDetail( ({ "koerper" }),
     "Alles noch dran. ");

  AddDetail( ({ "art", "arten" }),
     "Jeder hat so seine Seltsamkeiten. ");
 
  AddDetail( ({ "seltsamkeiten", "seltsamkeit" }),
     "Ja, jeder hat seine eigene Art Dinge zu loesen, hoffentlich auch Du. ");

  AddDetail( ({ "ding", "dinge" }), 
     "Es gibt viele Arten von Dingen. ");
   
  AddDetail( ({ "natur" }),
     "Natur umgibt Dich, wo Du auch hinsiehst. ");
  
  AddDetail( ({ "bluemchen", "bienchen", "schule" }),
     "Das musst Du alleine herausfinden. ");

  AddDetail( ({ "Wind" }),
     "Man sieht Wind so schwer, probier es doch mal mit lauschen. ");

  AddDetail( ({ "geruch" }),
     "Riechen! ");

  AddDetail( ({ "licht" }),
     "Ein seltsames Licht strahlt von der Rinde aus. "
     "Vielleicht erfaehrst Du mehr darueber, wenn Du Dich weiter nach Osten "
     "durchschlaegst. ");

  AddDetail( ({ "schrei", "schreie" }),
     "Lauschen! ");

  AddDetail( ({ "norden" }),
     "Im Norden befindet sich ein duester erscheinendes Moor. ");

  AddDetail( ({ "sueden" }),
     "Im Sueden wird der Wald zunehmend dichter. ");

  AddDetail( ({ "osten", "westen" }),
     "Der Weg fuehrt von Westen nach Osten, oder umgekehrt. ");

  AddDetail( ({ "wipfel", "wipfeln" }),
     "Die Wipfel der Birken bewegen sich sanft im Wind. ");

  AddDetail( ({ "menge" }),
     "Eine Menge Blaetter liegen auf dem Boden. ");

  AddDetail( ({ "kind" }),
     "Als Kind bist Du doch so gerne durch das Laub gestapft. "
     "Vor allem wenn es im Herbst in grossen Haufen auf dem Boden "
     "lag. ");

  AddDetail( ({ "haufen" }),
     "Grosse Menge gestapelter Dinge. ");

  AddDetail( ({ "herbst", "jahreszeit" }),
     "Der Herbst ist eine Jahreszeit. ");

  AddDetail( ({ "laub" }),
     "Das Laub liegt massenhaft auf dem Boden. "); 

// DETAILENDE


// SMELLS

  AddSmell(DEFAULT_SMELL, 
     "Ein angenehmer Geruch dringt in Deine Lungen. Er uebt eine "
     "sehr beruhigende Wirkung auf Dich aus. Fuer einen kurzen Moment "
     "vergisst Du die Welt um Dich, aber es warten zuviele Abenteuer "
     "in dieser Welt auf Dich und Du beschliesst weiterzuwandern. ");

  AddSmell( ({ "geruch" }),
     "Clementine war zu faul dieses Detail zu beschreiben. ");

// SOUNDS

  AddSound(DEFAULT_SOUND,
     "Du haeltst kurz inne und lauscht. Du hoerst, wie sich die Blaetter "
     "sanft im Wind bewegen, und dadurch ein Rauschen verursachen. "
     "Aus Osten dringen seltsame Schreie an Dein Ohr. ");

  AddSound( ({ "blaetter", "blatt" }),
     "Die Blaetter rauschen im Wind. ");

  AddSound( ({ "rauschen" }),
     "Das Rauschen der Blaetter dringt an Dein Ohr. ");

  AddSound( ({ "wind" }),
     "Sanft pfeift der Wind durch die Wipfel der Birken. ");

  AddSound( ({ "schrei", "schreie" }),
     "Seltsame Schreie dringen aus Osten an Dein Ohr. Es scheint als "
     "wuerde ein Wesen um Hilfe schreien. ");

  AddSound( ({ "wesen", "hilfe" }),
     "Ja, Du kannst es nun deutlich hoeren. Irgendwer schreit hier um "
     "Hilfe. ");
  
  AddSound( ({ "wipfel" }),
     "Nein soetwas kannst Du nicht lauschen. ");

  
}



