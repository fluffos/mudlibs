inherit "std/room";

#include <moredef.h>
#include <defines.h>
#include <properties.h>
#include <moving.h>
#include <language.h>
#include "../marisol.h"


void create()
{

  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "In einer Kueche" );
  SetProp(P_INT_LONG,
     "Du stehst in Gefjons Kueche. An der Nordwand befindet sich ein langes "
     "Kasterl, auf dem alle moeglichen Kuechengeraete stehen. "
     "Die Waende sind mit Regalen zugemauert, in denen sich Geschirr befindet. "
     "In einer Ecke steht ein Eimer mit Besen. Einige "
     "Kuechenreste befinden sich auf dem sonst blitzeblank geputzten "
     "Boden. Ueber die Treppe kannst Du die Kueche wieder verlassen. ");  
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
 
  AddExit( "unten", ROOM ("kneipe") );

  AddItem("/d/unterwelt/clementine/polstadt/npc/fortuna.lpc", REFRESH_DESTRUCT);

// DETAILBEGINN

  AddDetail( ({ "kueche" }),
     "Du befindest Dich in Gefjons Kueche. Sie liegt direkt ueber "
     "der Kneipe. ");

  AddDetail( ({ "kneipe" }),
     "Nach unten kommst Du wieder in die Kneipe, in der Du sicherlich "
     "vorhin schon einmal warst. ");

  AddDetail( ({ "gefjon" }),
     "Gefjon bedient gerne ihre Gaeste. Sie hat sicherlich auch nichts "
     "dagegen wenn Du Dich hier etwas umsiehst. Solange Du nichts zerstoerst "
     "oder sogar stiehlst wird sie Dir immer freundlich gesinnt sein. ");

  AddDetail( ({ "gaeste" }),
     "Im Laufe ihres Lebens hat Gefjon sicherlich schon viele Gaeste gehabt, "
     "die sie bewirtet hat. ");

  AddDetail( ({ "leben" }),
     "Gefjon fuehrt ein sehr ruhiges Leben. ");

  AddDetail( ({ "zeit" }),
     "Die vergeht wie immer sehr schnell. ");

  AddDetail( ({ "laufe" }),
     "Soetwas kannst Du nicht untersuchen! ");

  AddDetail( ({ "nordwand" }),
     "An der Nordwand steht ein laengliches Kasterl auf dem viele "
     "Kuechengeraete liegen. Es besteht aus Holz und hat auch einige "
     "Laden. ");

  AddDetail( ({ "laden" }),
     "Was sich in denen bloss befindet? ");

  AddDetail( ({ "kuechengeraete", "geraete" }),
     "Du kannst einige Toepfe erkennen, aber auch Schalen, Besteck, Teller, "
     "Becher und vieles mehr. ");

  AddDetail( ({ "toepfe" }),
     "In diesen Toepfen kocht Gefjon wohl leckere Speisen. ");

  AddDetail( ({ "speisen" }),
     "Die Speisen werden unten in der Kneipe verkauft. Du koenntest ja dort "
     "einmal etwas bestellen. ");

  AddDetail( ({ "besteck" }),
     "Gut erzogene Menschen essen meistens mit Besteck. Aber oft ist es mit "
     "den Fingern einfacher, nicht wahr? ");

  AddDetail( ({ "fingern", "finger" }),
     "So ein Hendl mit Fingern essen hat schon was. ");

  AddDetail( ({ "hendl" }),
     "Gefjon verkauft Dir sicher eines, wenn Du moechtest. ");

  AddDetail( ({ "menschen" }),
     "Auch andere Rassen verwenden oft Besteck. ");

  AddDetail( ({ "rassen" }),
     "'hilfe rassen' wuerde Dir einiges erleichtern. ");

  AddDetail( ({ "becher" }),
     "Die Becher bestehen alle aus Holz und sind sauber gewaschen. ");

  AddDetail( ({ "holz", "birkenholz" }),
     "Normales Birkenholz, wie es hier haeufig vorkommt. ");
  
  AddDetail( ({ "teller" }),
     "Einige Reste liegen auf ihnen. Sie werden wohl erst gewaschen. ");

  AddDetail ( ({ "reste" }),
     "Reste von Moorhuhneiern und Libellenfluegel. ");

  AddDetail( ({ "moorhuhneier", "eier", "fluegel", "libellenfluegel" }),
     "Frisch sind sie sicherlich koestlichst. ");
  
  AddDetail( ({ "schalen" }),
     "Wofuer die Schalen dienen, weisst Du leider nicht genau. Vielleicht "
     "werden sie zum Brauen von Traenken benoetigt. ");

  AddDetail( ({ "brauen" }),
     "Wenn Gefjon tatsaechlich eine Hexe ist hat sie sicherlich viel "
     "mit Magie und Zaubern zu tun. ");

  AddDetail( ({ "magie", "zauber" }),
     "Du solltest besser Gefjon danach fragen. ");

  AddDetail( ({ "traenke" }),
     "Sehen kannst Du hier leider keine. Das heisst aber nicht, dass sie "
     "nicht vorhanden sind. ");

  AddDetail( ({ "hexe" }),
     "So genau hast Du das bis jetzt noch nicht feststellen koennen. ");  

  AddDetail( ({ "boden" }),
     "Die Holzbretter am Boden sind blank geputzt. Nur einige "
     "Kuechenreste liegen verstreut auf ihm. Anscheinend wurde hier "
     "gerade gekocht. ");

  AddDetail( ({ "bretter", "holzbretter" }),
     "Die Holzbretter bestehen aus Holz ;) ");

  AddDetail( ({ "kuechenreste" }),
     "Salatblaetter, Froschschenkel, undefinierbares Zeugs. ");

  AddDetail( ({ "salatblaetter" }),
     "Einige braune Salatblaetter liegen auf dem Boden. Gefjon legt "
     "sehr viel Wert auf Qualitaet und wuerde sie nie in den Salat mischen, "
     "den sie verkauft. ");

  AddDetail( ({ "qualitaet" }),
     "Braune Salatblaetter schummelt Dir Gefjon sicherlich nicht unter. ");

  AddDetail( ({ "salat" }),
     "Den kannst Du unten konsumieren. ");

  AddDetail( ({ "froschschenkel" }),
     "Ihh! Die sind nicht mehr ganz frisch! ");

  AddDetail( ({ "zeugs" }),
     "Du kannst es nicht mehr genau erkennen. ");

  AddDetail( ({ "eimer" }),
     "Ein Eimer der mit Wasser gefuellt ist steht in der Ecke. "
     "Wofuer dieser hier wohl dient?! ");

  AddDetail( ({ "besen" }),
     "Ein stinknormaler Besen, mit dem man den Boden kehren kann. Er "
     "besteht aus einem langen Holzgriff, an dem unten Stroh angebracht wurde. ");

  AddDetail( ({ "holzgriff", "griff" }),
     "In den Griff wurde etwas eingraviert. "
     "G-E-F-J-O-N steht mit grossen Buchstaben draufgeschrieben. ");

  AddDetail( ({ "buchstaben" }),
     "a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s, t, u, v, w, x, y, z.");
  
  AddDetail( ({ "stroh" }),
     "Unten an dem Griff wurde Stroh befestigt. So kehrt es sich leichter. ");

  AddDetail( ({ "wasser" }),
     "Das Wasser dient wohl zum Putzen. ");

  AddDetail( ({ "putzen" }),
     "Im Augenblick gibt es hier nichts zu putzen. ");

  AddDetail( ({ "augenblick" }),
     "Gefjon erledigt sicherlich alles in ein paar Minuten. ");

  AddDetail( ({ "minuten" }),
     "Gedulde Dich doch ein wenig. ");

  AddDetail( ({ "treppe" }),
     "Eine kleine Wendeltreppe fuehrt nach unten in die Kneipe zurueck. ");

  AddDetail( ({ "wendeltreppe" }),
     "Sie fuehrt in die Kneipe zurueck. ");

  AddDetail( ({ "decke" }),
     "Die Decke besteht aus Holz und weist Schnitzereien auf. Sie ist gerade "
     "hoch genug, sodass Du muehelos, ohne Deinen Kopf einziehen zu muessen, "
     "darunter passt. ");

  AddDetail( ({ "schnitzereien" }),
     "Die Schnitzereien haben eigenartige Motive. ");

  AddDetail( ({ "kopf" }),
     "Der ist noch da. ");

  AddDetail( ({ "motive" }),
     "Sie zeigen verschiedene Orte des Silberlands. ");

  AddDetail( ({ "orte" }),
     "Hmmm, die meisten sind Dir seltsamerweise total unbekannt. ");

  AddDetail( ({ "silberland" }),
     "Das Silberland wartet darauf von Dir entdeckt zu werden, bis in den "
     "letzen Winkel. ");

  AddDetail( ({ "winkel" }),
     "Den hast Du noch lange nicht entdeckt. ");

  AddDetail( ({ "waende", "wand" }),
     "An den Waenden haengen viele Regale und Schraenke. ");

  AddDetail( ({ "regale" }),
     "In den Regalen befindet sich ueberwiegend Geschirr. ");

  AddDetail( ({ "geschirr" }),
     "Alles was man zum Kochen halt so braucht. Toepfe, Kochloeffel, ... ");

  AddDetail( ({ "kochloeffel" }),
     "Bestimmt 10 oder mehr haengen hier. ");

  AddDetail( ({ "kochen" }),
     "Hier wird sicherlich oft fleissig gekocht. ");

  AddDetail( ({ "schraenke", "holzschraenke", "schrank", "holzschrank" }),
     "Kleine Holzschraenke befinden sich an den Waenden. Sie sind alle "
     "mit dicken Eisenschloessern versehen. ");

  AddDetail( ({ "schloesser", "eisenschloesser" }),
     "Die Schloesser haben alle ein kleines Schluesselloch. Doch ohne "
     "passenden Schluessel bekommst Du sie sicherlich nicht auf. ");

  AddDetail( ({ "schluesselloch" }),
     "Ein Schluesselloch, in welches nur ein bestimmter Schluessel passt. ");

  AddDetail( ({ "schluessel" }),
     "Wer den wohl hat? ");

  AddDetail( ({ "ecke" }),
     "In einer Ecke steht ein Eimer der mit Wasser gefuellt wurde. Ein "
     "Besen steckt in ihm. ");
 
  AddDetail( ({ "kasterl" }),
     "Ein Kasterl an der Nordwand dient Gefjon wohl als Arbeitsflaeche. Auf ihm "
     "befinden sich einige Kuechengeraete. Ausserdem kannst Du eine grosse "
     "Schuessel erkennen. ");

  AddDetail( ({ "schuessel" }),
     "Sie ist randvoll mit Wasser gefuellt. Anscheinend wird hier drinnen "
     "das Geschirr gewaschen. ");

  AddDetail( ({ "arbeitsflaeche" }),
     "Das Kasterl eignet sich sicher hervorragend zum Arbeiten. ");

  AddDetail( ({ "arbeiten" }),
     "Schneiden von Gemuese, Ausnehmen von Tierchen, ... ");

  AddDetail( ({ "gemuese" }),
     "Kostproben von Gemuese bekommst Du bei Gefjon in der Kneipe. ");

  AddDetail( ({ "kostproben" }),
     "Wie waers mit einem guten Salat? ");

  AddDetail( ({ "schneiden" }),
     "*schnipp* *schnapp* ");
  
  AddDetail( ({ "tierchen" }),
     "Moorschnucken muessen vor dem Verzehr ausgenommen zu werden. ");

  AddDetail( ({ "moorschnucken" }),
     "Geh doch in die Kneipe und bestell Dir eine. ");

  AddDetail( ({ "verzehr" }),
     "Man ist doch sehr ungern die Innereien von Moorschnucken mit. ");

  AddDetail( ({ "innereien" }),
     "Leber, Lungen, Herz, ... ");

  AddDetail( ({ "leber", "lungen" }),
     "Pfui!");

  AddDetail( ({ "herz" }),
     "Hast Du Dein Herz denn schon verloren? ");

  AddDetail( ({ "ausnehmen" }),
     "Jemand wird Dich gleich ausnehmen wenn Du weiter sowas untersuchst. ");

  AddDetail( ({ "jemand" }),
     "Jemand beobachtet Dich auf Schritt und Tritt. ");

  AddDetail( ({ "schritt", "tritt" }),
     "*tippelditapp*");

  AddDetail( ({ "a", "aal" }),
     "a wie Aal. ");

  AddDetail( ({ "b", "banane" }),
     "b wie Banane. ");

  AddDetail( ({ "c", "cholera" }),
     "c wie Cholera. ");

  AddDetail( ({ "d", "depp" }),
     "d wie Depp. ");

  AddDetail( ({ "e", "elefant" }),
     "e wie Elefant. ");

  AddDetail( ({ "f", "failin" }),
     "f wie Failin. ");

  AddDetail( ({ "g", "g-punkt", "punkt" }),
     "g wie G-Punkt. ");

  AddDetail( ({ "h", "horst" }),
     "h wie Horst. ");

  AddDetail( ({ "i", "insel" }),
     "i wie Insel. ");

  AddDetail( ({ "j", "jause" }),
     "j wie Jause. ");

  AddDetail( ({ "k", "katrin" }),
     "k wie Katrin :) ");

  AddDetail( ({ "l", "langeweile" }),
     "l wie Langeweile. ");

  AddDetail( ({ "m", "magnet" }),
     "m wie Magnet. ");

  AddDetail( ({ "n", "nase" }),
     "n wie Nase. ");

  AddDetail( ({ "o", "Omelette"}),
     "o wie Omelette. ");

  AddDetail( ({ "p", "phiole" }),
     "p wie Phiole. ");

  AddDetail( ({ "q", "querulant" }),
     "q wie Querulant. ");

  AddDetail( ({ "r", "riese" }),
     "r wie Riese. ");

  AddDetail( ({ "s", "seicherl" }),
     "s wie Seicherl. ");

  AddDetail( ({ "t", "tratschtante" }),
     "t wie Tratschtante. ");

  AddDetail( ({ "u", "ungeheuer" }),
     "u wie Ungeheuer. ");

  AddDetail( ({ "v", "verdammnis"}),
     "v wie Verdammnis. ");

  AddDetail( ({ "w", "wurst" }),
     "w wie Wurst. ");
 
  AddDetail( ({ "x" }),
     "x wie Schluessel...");

  AddDetail( ({ "z", "zuz" }),
     "z wie Zuz, oder zuende Wuz Zuz an. ");

  AddDetail( ({ "wuz" }),
     "Eigentlich ist sie ja ganz lieb ab und zu :) ");
 
// DETAILENDE


// SOUNDS

  AddSound(DEFAULT_SOUND,
     "Hier ist es absolut geraeuschlos in dem Raum. Nur von unten "
     "nimmst Du manchmal das Klappern von Geschirr wahr. ");

  AddSound( ({ "geschirr" }),
     "Manchmal kannst Du ein Glaeserklirren hoeren. ");

  AddSound( ({ "klirren", "glaeserklirren" }),
     "*ping* *klirr* ");

  AddSound( ({ "raum" }),
     "Du hoerst gar nichts. ");

  AddSound( ({ "klappern" }),
     "Es klingt, als wuerden manchmal Teller aneinanderstossen. ");

  AddSound( ({ "teller" }),
     "Gefjon bereitet wohl gerade ein Mahl zu. ");

  AddSound( ({ "mahl" }),
     "Das kannst Du nicht hoeren, aber vielleicht riechen?");

  AddSound( ({ "gefjon" }),
     "Gefjon scheint sehr beschaeftigt zu sein. ");


// SMELLS

  AddSmell(DEFAULT_SMELL,
     "Von unten dringt der Geruch von warmen Essen in Deine Nase. ");

  AddSmell( ({ "nase" }),
     "Daran kannst Du doch nicht riechen! ");

  AddSmell( ({ "geruch" }),
     "Koestlich! ");

  AddSmell( ({ "essen" }),
     "Das riecht zu gut. Du beschliesst gleich hinunter zu gehen und Dir "
     "etwas Gutes zu bestellen. ");

  AddSmell( ({ "gutes" }),
     "Liebe geht durch den Magen, sagt man. ");

  AddSmell( ({ "magen" }),
     "Du bist nicht so gelenkig. ");

  AddSmell( ({ "liebe" }),
     "Liebe ist einfach da, riechen kannst Du sie nicht! ");

  AddSmell( ({ "mahl" }),
     "Wie das duftet!!! ");
 


  AddCmd( ({ "oeffne" }), "c_oeffnen");

}

int c_oeffnen( string str )
{
 if( str != "laden" )
 {
  notify_fail("Was moechtest Du oeffnen?\n");
  return 0;
 }
 if( str == "laden" )
 {
  write(BS("Du oeffnest die Laden findest aber darin nur Geschirr. "
           "Voellig sensationslos! Deshalb schliesst Du sie wieder. "));
  return 1;
 }
}

