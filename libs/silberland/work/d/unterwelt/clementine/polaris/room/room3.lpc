inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../marisol.h"


int anz_pilz;

reset()
{
 ::reset();
 anz_pilz = 1;
}

create()
{

::create();

  anz_pilz = 1;
  SetProp(P_INT_SHORT, "In einem Birkenwaeldchen");
  SetProp(P_INT_LONG, 
     "Die Birken scheinen Dich hier von beiden Seiten zu erdruecken. "
     "Du fuehlst Dich aeusserst unwohl hier. Du solltest dem Gefuehl "
     "bald auf den Grund gehen, damit nicht Schlimmeres geschieht. "
     "Die Baumkronen verdecken den Himmel komplett, und ohne Lichtquelle "
     "koenntest Du nicht mal Deine eigene Hand vor Augen sehen. Von "
     "naechster Naehe dringt schon das Prasseln des Regens an Dein Ohr, "
     "anscheinend verhindern die Wipfel Dein Nasswerden. Du solltest rasch "
     "nach einem Unterschlupf suchen, denn die Wipfel werden dem Regen bald "
     "nicht mehr standhalten koennen. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0 );

  AddExit( "westen", ROOM ("room2") );
  AddExit( "osten", ROOM ("room4") );
  AddExit( "norden", "/d/unterwelt/ronja/moor/room/moor_c4");

// DETAILBEGINN

  AddDetail( ({ "birken", "birke" }),
     "Die Birken versuchen Dich von beiden Seiten hier zu erdruecken. "
     "Wie Gespenster wirken die einzelnen Baeume wegen der weissen "
     "Rinde auf Dich. Ihre Kronen verdecken den Himmel komplett, alles "
     "wirkt duester auf Dich und Du aengstigst Dich. ");

  AddDetail( ({ "seiten", "seite" }),
     "Von beiden Seiten bist Du von Birken umgeben, die Dich mit ihren "
     "Blicken verfolgen. Wenn Du nicht genau wissen wuerdest, dass "
     "Birken 'nicht leben', wuerdest Du jetzt schreiend davonlaufen. ");

  AddDetail( ({ "himmel" }),
     "Die Baumkronen sind zu dicht, sodass Du den Himmel ueberhaupt "
     "nicht erkennen kannst. Ueber Dir ragen sie in den Himmel und "
     "schuetzen vor herannahendem Regen. ");

  AddDetail( ({ "lichtquelle" }),
     "Ohne Lichtquelle ist dieser Teil des Waeldchens stockfinster. ");

  AddDetail( ({ "regen" }),
    "Die Luft riecht foermlich schon nach Regen. Auch ein leises Prasseln "
    "kannst Du bereits vernehmen. Nur die Wipfeln schuetzen Dich "
    "anscheinend vor dem Nasswerden. ");

  AddDetail( ({ "wipfel" }),
    "Schuetzend, aber auch unheimlich umgeben Dich die Wipfel der Birken. "
    "Es scheint, als wuerden sie jeden Moment nach Dir greifen und Dich "
    "verschlingen. ");

  AddDetail( ({ "moment" }),
    "Die Wipfel bewegen sich im Wind, sie kommen Dir immer naeher.\n"
    "Huch! Hat Dich nicht gerade etwas beruehrt?\n");

  AddDetail( ({ "boden" }),
    "Der Boden unter Deinen Fuessen nimmt langsam eine festere "
    "Gestalt an. Du kannst hier nicht mehr so leicht versinken. "
    "Einige abgestorbene Blaetter liegen auf ihm. ");

  AddDetail( ({ "blaetter", "birkenblaetter" }),
    "Einige abgestorbene Birkenblaetter liegen auf dem Boden, aber "
    "auch auf den Aesten der Baeume kannst Du welche entdecken. "
    "Die Birkenblaetter koennten leicht etwas unter sich verstecken. ");

  AddDetail( ({ "aeste" }),
    "Hoch ueber Dir prangern die weiss schimmernden Aeste der Birken. "
    "Es scheint, als koennten sie ihre Form veraendern, der Wind "
    "laesst sie hin und her schwanken. ");
      
  AddDetail( ({ "wind" }),
    "Der Wind bringt die Aeste und Wipfel der Birken zum Schaukeln. "
    "Einzelne Haarstraehnen werden sanft in Dein Gesicht geweht. ");

  AddDetail( ({ "gesicht" }),
    "Leider hast Du keinen Spiegel dabei, sonst wuerde er bei "
    "Deinem Aussehen glatt zerspringen. ");

  AddDetail( ({ "spiegel" }),
    "Nein, keiner da. ");

  AddDetail( ({ "aussehen" }),
    "Untersuch Dich doch einmal, wie Du schon wieder aussiehst!!! ");

  AddDetail( ({ "haarstraehnen", "straehnen" }),
    "Ein Besuch beim Friseur schadet Dir sicherlich nicht. ");

  AddDetail( ({ "besuch" }),
    "Du muesstest wirklich dringend einen aufsuchen. ");

  AddDetail( ({ "friseur" }),
    "Leider findest Du hier keinen weit und breit, das soll aber nicht "
    "heissen, dass es hier im Silberland keinen gibt. ");

  AddDetail( ({ "silberland" }),
    "Das Silberland ist die Dich umgebende Welt. ");

  AddDetail( ({ "welt" }),
    "Das Silberland ist wohl momentan die Welt, in der Du Dich "
    "aufhaeltst. ");

  AddDetail( ({ "schaukeln" }),
    "Sanft bewegt der Wind Aeste und Wipfel, und laesst sie hin und "
    "her schaukeln. ");

  AddDetail( ({ "blicke", "blicken" }),
    "Die Birken scheinen Dich zu verfolgen. Ihre weisse Rinde sieht "
    "gespenstig aus, und manchmal beruehren Dich sogar ihre Aeste. ");

  AddDetail( ({ "gestalt" }),
    "Langsam bildet sich aus dem moorigen Boden ein fester "
    "Untergrund. ");

  AddDetail( ({ "untergrund" }),
    "Der Untergrund ist nicht mehr so schlammig. Du entfernst Dich "
    "anscheinend immer weiter vom Moor. ");

  AddDetail( ({ "moor" }),
    "Das Moor kannst Du ganz in der Naehe betreten. ");

  AddDetail( ({ "naehe" }),
    "Ganz in der Naehe kannst Du das Moor betreten, wenn Du genug "
    "Mut hast. ");

  AddDetail( ({ "mut" }),
    "Deine Knie zittern und werden immer weicher.\n"
    "So wird das nie was mit Dir! ");

  AddDetail( ({ "rinde" }),
    "Weisse Rinde umgibt die Birken wie einen Umhang. ");

  AddDetail( ({ "umhang" }),
    "Die Rinde soll die Birken vor aeusserlichen Schaeden und "
    "Witterungsverhaeltnissen schuetzen. ");

  AddDetail( ({ "schaeden" }),
    "Du musterst die Rinde genauer, kannst aber keine wirklichen "
    "Schaeden an ihr feststellen. ");

  AddDetail( ({ "witterungsverhaeltnisse", "witterung", "verhaeltnisse" }),
    "Unterschiedliches Wetter ruft unterschiedliche Witterung hervor. ");

  AddDetail( ({ "wetter" }),
    "Sieht verdammt nach Regen aus heute. ");

  AddDetail( ({ "knie" }),
    "Weich wie Butter sind sie schon! ");

  AddDetail( ({ "butter" }),
    "Hmm...sehnsuechtig wuenscht Du Dir ein Butterbrot. ");

  AddDetail( ({ "butterbrot" }),
    "In der Unterwelt soll es gute Butterbrote geben hat mir einmal "
    "ein Voeglein gezwitschert. ");

  AddDetail( ({ "voeglein" }),
    "Das Voeglein war eine weibliche Spielerin =) ");

  AddDetail( ({ "spielerin" }),
    "Naja um es etwas zu detaillieren, es war eine weibliche hohe "
    "Spielerin. ");

  AddDetail( ({ "unterwelt" }),
    "In Polaris soll ein Tor zur Unterwelt irgendwo sein, eines von "
    "vielen. Vielleicht findest Du es ja. ");

  AddDetail( ({ "polaris" }),
    "Du befindest Dich auf dem Weg nach Polaris. ");

  AddDetail( ({ "weg" }),
    "Der Weg zieht sich durch ein Birkenwaeldchen. ");

  AddDetail( ({ "birkenwaeldchen", "waeldchen" }),
    "Dein Weg wird von Birken gesaeumt. ");

  AddDetail( ({ "form" }),
    "Der Wind schaukelt die Aeste hin und her und so scheint es, als "
    "wuerden sie ihre Form veraendern. "); 
 
  AddDetail( ({ "tor" }),
    "Man munkelt, dass es in Polaris ein Tor zur Unterwelt gibt. ");

  AddDetail( ({ "unterschlupf" }),
    "Ohne einen Unterschlupf wirst Du voraussichtlich in kuerzester "
    "Zeit pudelnass sein. ");

  AddDetail( ({ "fuesse", "fuessen" }),
    "Der Boden unter Dir wird langsam wieder fester. ");

  AddDetail( ({ "grund" }),
    "Forsch doch ein wenig! Das hat noch niemandem geschadet! ");

  AddDetail( ({ "gefuehl" }),
    "\n"
    "Deine Knie schlottern vor lauter Angst und Aufregung zugleich!\n"
    "\n"
    "Eine Stimme in Deinem Bauch meldet sich: Geh lieber schnell weiter!\n ");

  AddDetail( ({ "bauch" }),
    "Ganz mulmig ist Dir zumute. ");

  AddDetail( ({ "stimme" }),
    "Ich hoere keine Stimme - Du etwa? ");

  AddDetail( ({ "angst", "aufregung" }),
    "Du zitterst. ");

  AddDetail( ({ "teil" }),
    "Du befindest Dich in einem winzigen Teil des gesamten Waeldchens. ");

  AddDetail( ({ "prasseln" }),
    "Sehen kannst Du es nirgendswo. Probier es doch mit lauschen! ");

  AddDetail( ({ "ohr", "ohren" }),
    "Noch hast Du Deine beiden Ohren, fragt sich wie lange noch! ");

  AddDetail( ({ "kronen", "baumkronen" }),
    "Die Baumkronen der Birken verdecken den Himmel komplett und "
    "verdunkeln somit diesen Abschnitt des Waeldchens. Ueber Dir "
    "ragen sie wie Gespenster in den Himmel. ");

  AddDetail( ({ "abschnitt" }),
    "Du befindest Dich in einem kleinen Teil dieses Waeldchens. "
    "Die genauen Ausmasse wirst Du allerdings nie erfahren, denn "
    "abseits des Weges verdichten sich Baeume und Straeucher. ");

  AddDetail( ({ "ausmasse" }),
    "Du kannst nicht auf die Groesse des Waeldchens schliessen. ");

  AddDetail( ({ "groesse" }),
    "Wenn Du wissen willst, wie gross Du bist, wuerde ich Dir raten, "
    "Dich abzumessen =) ");

  AddDetail( ({ "straeucher" }),
    "Abseits des Weges wachsen einige Straeucher dicht beieinander. "
    "Einige Beeren kannst Du an ihnen erkennen. ");

  AddDetail( ({ "beeren" }),
    "Du traust Dich nicht sie zu pfluecken - womoeglich sind sie "
    "sogar noch giftig...");

  AddDetail( ({ "gespenster" }),
    "Gespenster siehst Du hier keine! Die Baeume sehen allerdings "
    "sehr gruselig aus. ");

  AddDetail( ({ "luft" }),
    "Die Luft ist zu durchsichtig, um sie zu untersuchen! ");

  AddDetail( ({ "nasswerden" }),
    "Wenn Du nicht bald ein warmes Plaetzchen findest, erwischt Dich "
    "noch der Regen! Beeil Dich und such eins, wenn Dir Dein Leben lieb "
    "ist. ");

  AddDetail( ({ "leben" }),
    "Lauf, wenn Dir was an Deinem Leben liegt! ");

  AddDetail( ({ "plaetzchen" }),
    "Wer nicht wagt, der nicht gewinnt!\n"
    "Du denkst . o O (aus irgendeinem Film kenn ich den Satz!)\n");

  AddDetail( ({ "film" }),
    "Du greifst Dir auf die Stirn.\n"
    "Aja! Faellt es Dir ploetzlich ein! - Merlin und Mim - "
    "die Hexe und der Zauberer...");

  AddDetail( ({ "satz" }),
    "Ich bin dumm. - Ein Satz mit Subjekt, Praedikat und Objekt. ");

  AddDetail( ({ "subjekt", "praedikat", "objekt" }),
    "Achso, Du hast in der Schule nicht gut aufgepasst! Na dann! ");

  AddDetail( ({ "schule" }),
    "Die liegt bei Dir wohl schon sehr sehr lange zurueck. ");

  AddDetail( ({ "merlin", "zauberer" }),
    "Merlin ist ein maechtiger Zauberer. ");

  AddDetail( ({ "mim" }),
    "Mim war eine boese und grausame Hexe. ");

  AddDetail( ({ "hexe" }),
    "Es gibt boese und gute Hexen. Hoffentlich findest Du nur gute! ");

  AddDetail( ({ "stirn" }),
    "Etwas runzlig, meinst Du nicht? ");

  AddDetail( ({ "schlimmeres" }),
    "Noch ist Dir nichts passiert, oder doch? ");

  AddDetail( ({ "baeume", "baum" }),
    "Birken mit ihrer weissen Rinde umgeben Dich. Wie riesige "
    "Giganten streben sie gegen den Himmel mit nur einem Plan. ");

  AddDetail( ({ "giganten" }),
    "Steingiganten? ");

  AddDetail( ({ "steingiganten" }),
    "Siehst Du hier welche? ");

  AddDetail( ({ "plan" }),
    "Frag doch mal die Birken nach ihrem Plan =) ");
   
  AddDetail( ({ "hand" }),
    "Du tastest wild umher. Deine Hand ist noch da. ");

  AddDetail( ({ "augen", "auge" }),
    "Du siehst hier nicht weiter als zwei Meter, nicht einmal als "
    "Dunkelelf. ");

  AddDetail( ({ "meter" }),
    "Grobe Schaetzung. ");

  AddDetail( ({ "schaetzung" }),
    "Ok, es sind 1,93257 Meter. ");

  AddDetail( ({ "dunkelelf", "dunkelelfen" }),
    "Dunkelelfen koennen mit Hilfe ihrer roten Augen sehr gut im "
    "Dunkeln sehen. Aber auch als Dunkelelf kann man hier aufgrund "
    "des Nebels nicht weiter als zwei Meter sehen. ");

  AddDetail( ({ "nebel" }),
    "Etwas Nebel steigt von allen Seiten auf. ");

  AddDetail( ({ "hilfe" }),
    "Mit den roten Augen kommen Dunkelelfen sehr gut in der "
    "Finsternis zurecht. ");

  AddDetail( ({ "finsternis" }),
    "Finsternis ist fuer viele anderen Rassen beaengstigend, aber "
    "nicht fuer Dunkelelfen. ");

  AddDetail( ({ "dunkeln" }),
    "Im Dunkeln ist gut munkeln...");

  AddDetail( ({ "rassen" }),
    "Es gibt viele verschiedene Rassen hier. Wenn Du Naeheres erfahren "
    "willst tipp: 'hilfe rassen' ");

  AddDetail( ({ "naeheres" }), 
    "Tippsel doch mal: 'hilfe rassen'. ");


  AddSpecialDetail( ({ "zeit" }), "c_zeit");

// DETAILENDE


// SOUNDS 

  AddSound(DEFAULT_SOUND,
     "Aus naechster Naehe dringt das Prasseln des Regens an Dein Ohr. "
     "Der Wind pfeift vor sich hin. Von irgendwo hoerst Du auch wieder "
     "diese seltsamen Schreie. ");

  AddSound( ({ "pfeifen" }),
	  "Pfeif, pfeif...");
  
  AddSound( ({ "schreie" }),
     "Seltsam, jetzt sind sie verstummt. ");

  AddSound( ({ "regen" }),
     "Der Regen prasselt auf die Wipfel und erzeugt leise Tropfgeraeusche. ");

  AddSound( ({ "tropfgeraeusche" }),
     "*tropf* *tropf* ");

  AddSound( ({ "prasseln" }),
     "Es klingt wie ein Wasserhahn den man nicht abdrehen kann. ");

  AddSound( ({ "wasserhahn" }),
     "*platsch* Es tropft vor sich hin. ");

  AddSound( ({ "wind" }),
     "Der Wind blaest um die Kronen der Birken. ");

  AddSound( ({ "birken" }),
     "Sie bewegen sich gleichmaessig im Wind. ");

  AddSound( ({ "kronen" }),
     "Der Regen erzeugt ein stetiges Prasseln. ");  


// SMELLS

  AddSmell(DEFAULT_SMELL,
     "Es riecht nach Regen. Ein erdiger Geruch steigt vom Boden auf. "
     "Den Wald kannst Du nun deutlicher spueren. ");

  AddSmell( ({ "wald" }),
     "Es riecht nach Baeumen und Blaettern. ");

  AddSmell( ({ "baeume" }),
     "Nass. ");

  AddSmell( ({ "blaetter" }),
     "Du gehst naeher an ein Blatt heran und schnupperst daran. "
     "Huch, Du hast Deine Nase in einen grossen Tautropfen gesteckt. ");

  AddSmell( ({ "tautropfen" }),
     "Hatschiiiiiiiiii!!!");

  AddSmell( ({ "blatt" }),
     "Es riecht sehr kuehl und nass. ");

  AddSmell( ({ "nase" }),
     "Du scheiterst bei dem Versuch an Deiner Nase zu riechen. ");

  AddSmell( ({ "versuch" }),
     "Tja, versucht hast Du es ja wenigstens. ");

  AddSmell( ({ "regen" }),
     "Einfach herrlich. ");

  AddSmell( ({ "boden" }),
     "Der Boden riecht nach feuchter Erde. ");

  AddSmell( ({ "erde" }),
     "Erdig. ");

  AddSmell( ({ "geruch" }),
     "Ein erdiger Geruch steigt vom Boden auf. Es erinnert Dich hier "
     "sehr an Deine eigene Kindheit. ");

  AddSmell( ({ "kindheit" }),
     "In Deiner Kindheit hast Du so ein Wetter geliebt. ");

  AddSmell( ({ "wetter" }),
     "Ueberall Pfuetzen, und Du mit Schaufel bewaffnet unterwegs. ");

  AddSmell( ({ "schaufel" }),
     "Kleine Kaefer hast Du sicherlich mit ihr erschlagen. ");

  AddSmell( ({ "kaefer" }),
     "Die rochen dann ziemlich tot. ");

  AddSmell( ({ "pfuetzen" }),
     "Tja in den Pfuetzen hast Du arme kleine Kaefer ertraenkt. ");


  AddCmd( ({ "wuehl", "wuehle" }), "c_wuehlen");


}

int c_wuehlen( string str )
{
 object ob;
 if( str != "in blaetter"       &&
     str != "in blaettern"      &&
     str != "in birkenblaetter"  )
 {
  notify_fail("Worin moechtest Du wuehlen?\n");
  return 0;
 }
 else
 {
  if( anz_pilz < 1 )
  {
   write(BS("Du wuehlst kraeftigst in den Blaettern, kannst aber leider "
            "ueberhaupt nichts finden. Vielleicht ein andernmal. ") );
   return 1;
  }
  else
  {
   write(BS("Du beginnst die Blaetter zu durchwuehlen...\n"
            "Auf einmal tastet Du etwas Weiches...Natuerlich steckst "
            "Du es sofort ein. ") );
   ob = clone_object(OBJ ("rotkappe"));
   if(ob->move(this_player(), M_GET) != 1)
   {
    tell_object(this_player(), "Das kannst Du nicht mehr tragen!\n");
    ob->move(this_object(), M_NOCHECK);
   }
   anz_pilz--;
   return 1;
  }
 }
}

string c_zeit( string str )
{
 this_player()->command_me("zeit");
 return ""; 
}



