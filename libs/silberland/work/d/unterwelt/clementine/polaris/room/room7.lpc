inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../marisol.h"
#include <moving.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In Polaris" );
  SetProp(P_INT_LONG, 
    "Im Norden befindet sich eine eher verlassen wirkende Huette, ueber "
    "der ein grosses Schild angebracht wurde. Der Duft von koestlichem "
    "Essen scheint von ihr auszugehen. "
    "Im Sueden glaubst Du ein Steinhaus erkennen zu koennen, allerdings "
    "wird es komplett von Nebelschwaden eingehuellt. "
    "Im Osten endet der Weg am Fusse eines steilen Huegels, der "
    "mit unzaehligen Baeumen bewachsen ist. Das Unterholz ist sehr "
    "dicht, und verhindert ein Vorwaertskommen. "
    "Auf dem lehmigen Boden kannst Du viele Spuren erkennen. ");

 
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_KILL_NAME, "Ein spitzer Ast" );
  SetProp(P_KILL_MSG, "Deine Hautfetzen stehen mir.");

 
  AddExit( "westen", ROOM ("room6") );
  AddExit( "norden", ROOM ("kneipe") );
  AddExit( "sueden", ROOM ("gruft") );


// DETAILBEGINN

  AddDetail( ({ "spuren" }),
    "Du kannst viele Spuren erkennen auf dem lehmigen Boden. Sie "
    "fuehren hauptsaechlich nach Norden und nach Sueden.\n"
    "Du wunderst Dich. ");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus festgetrampeltem Lehm. Anscheinend sind "
    "schon viele Abenteurer ueber den Weg getrampelt. ");

  AddDetail( ({ "abenteurer" }),
    "Bist Du auch einer von ihnen? ");

  AddDetail( ({ "steinhaus" }),
    "Im Sueden glaubst Du ein Steinhaus erkennen zu koennen. Allerdings "
    "ist es von dicken Nebelschwaden umgeben, und so bist Du Dir nicht "
    "ganz sicher. ");

  AddDetail( ({ "nebelschwaden", "nebel" }),
    "Im Sueden ist alles mit Nebelschwaden umhuellt, eine sehr "
    "seltsame Atmosphaere geht von ihnen aus. ");

  AddDetail( ({ "atmosphaere" }),
    "Geh doch nach Sueden, um mehr erkennen zu koennen. ");

  AddDetail( ({ "huette" }),
    "Im Norden befindet sich eine verlassen wirkende Holzhuette, ueber "
    "der ein grosses Schild haengt. Ein himmlischer Geruch geht vom "
    "Eingang der Huette aus. ");

  AddDetail( ({ "holzhuette" }),
    "Sie befindet sich im Norden. ");

  AddDetail( ({ "eingang" }),
    "Ein himmlischer Geruch stroemt durch den Eingang der Huette in "
    "Deine Nase. Anscheinend handelt es sich bei der Huette um eine "
    "Kneipe. ");

  AddDetail( ({ "kneipe" }),
    "Du musst schon nach Norden gehen, um das festzustellen. ");

  AddDetail( ({ "schild" }),
    "Du kannst es lesen! ");

  AddReadDetail( ({ "schild" }),
    "\n"
    "Willkommen in Gefjons Kneipe!\n"
    "\n" );
 
  AddDetail( ({ "lehm" }),
    "Der Boden besteht daraus. Mit der Zeit ist er ganz schoen "
    "festgetrampelt worden. ");

  AddDetail( ({ "zeit" }),
    "Die verstreicht sehr schnell beim Forschen oder? ");

  AddDetail( ({ "forschen" }),
    "Das tust Du gerade. ");

  AddDetail( ({ "nase" }),
    "Herrlich dieser Geruch. ");

  AddDetail( ({ "geruch", "duft" }),
    "Probiers mit riechen. ");

  AddDetail( ({ "essen" }),
    "Vom Norden stroemt der Duft von Essen. ");

  AddDetail( ({ "fusse" }),
    "Der Weg endet im Osten am Fusse eines steilen Huegels. ");

  AddDetail( ({ "weg" }),
    "Der Weg besteht aus Lehm. Er fuehrt nach Norden, Sueden und Westen "
    "weiter. ");

  AddDetail( ({ "baeume" }),
    "Der Huegel ist mit unzaehligen Baeumen bewachsen. Du siehst leider "
    "keine Moeglichkeit nach Osten vorzudringen - der Huegel ist "
    "einfach zu steil, die Baeume und das Unterholz zu dicht. ");

  AddDetail( ({ "unterholz" }),
    "Das dichte Unterholz verhindert ein Vorwaertskommen in oestliche "
    "Richtung. Du wuerdest Dich hier sicherlich nur verletzen! ");

  AddDetail( ({ "richtung" }),
    "Welche meinst Du? ");

  AddDetail( ({ "moeglichkeit" }),
    "Keine vorhanden. ");

  AddDetail( ({ "huegel" }),
    "Ein steiler Huegel befindet sich im Osten. Er ist mit vielen "
    "Baeumen bewachsen. ");

  AddDetail( ({ "vorwaertskommen" }),
    "Ein Vorwaertskommen nach Osten ist ein Ding der Unmoeglichkeit. ");

  AddDetail( ({ "ding" }),
    "Ding huepft weiter nach Sueden. ");

  AddDetail( ({ "unmoeglichkeit" }),
    "Ist es doch, oder? ");

  AddDetail( ({ "himmel" }),
    "Der Himmel leuchtet in einem hellen Grau. Einige "
    "Wolken scheinen aufzukommen. Die Sonne versucht vergeblich durch "
    "die Wolkenbank zu dringen. ");

  AddDetail( ({ "wolkenbank" }),
    "Die Wolken verdichten sich zunehmend. ");

  AddDetail( ({ "sonne" }),
    "Sie steht hoch ueber Dir am Himmel, wird aber von Wolken verdeckt. ");

  AddDetail( ({ "grau" }),
    "Der Himmel leuchtet in einem hellen Grau. Es wird wohl bald zum "
    "regnen anfangen. ");
 
  AddDetail( ({ "wolke", "wolken" }),
    "Einige Wolken kommen auf. Die Sonne kann sie leider nicht mehr "
    "durchbrechen. Der Himmel verwandelt sich wohl bald in ein "
    "Trauerspiel.  ");
  
  AddDetail( ({ "trauerspiel" }),
    "Die Verwandlung des Himmels geht rasch vor sich. ");

  AddDetail( ({ "verwandlung" }),
    "Die von Kafka? ");

  AddDetail( ({ "kafka" }),
    "Auszug aus Kafkas Verwandlung: Als Gregor Samsa eines Morgens "
    "aus unruhigen Traeumen erwachte, fand er sich in seinem Bett zu "
    "einem ungeheueren Ungeziefer verwandelt... --> mehr davon dann "
    "untersuche 'kave'. ");

  AddDetail( ({ "kave" }),
    "Geh doch mal auf: "
    "http://www.gutenberg2000.de/kafka/verwandl/verwa001.htm ");

  AddDetail( ({ "gregor", "samsa", "traeumen", "traeume", "bett", 
                "ungeziefer", "morgens", "morgen" }),
    "Selber denken...");

  AddDetail( ({ "westen" }),
    "Du musst schon nach Westen gehen, um zu sehn was dort ist. ");

  AddDetail( ({ "norden" }),
    "Im Norden ragt eine Holzhuette in den Himmel. Ueber ihrem "
    "Eingang haengt ein Schild. ");

  AddDetail( ({ "sueden" }),
    "Sueden liegt im Sueden. ");

  AddDetail( ({ "wegrand" }),
    "Am Wegrand befindet sich undurchdringliches Unterholz. ");

// DETAILENDE


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Vom Norden her dringt ein herrlicher Geruch in Deine Nase. "
    "Von welch Koestlichkeiten dieser Geruch wohl ausgeht? Der "
    "Essensgeruch vermischt sich mit einem typischen Waldgeruch der "
    "wohl von den Baeumen aus dem Osten kommt. ");
 
  AddSmell( ({ "geruch" }),
    "Herrlich! ");

  AddSmell( ({ "koestlichkeiten" }),
    "Du solltest unbedingt mal welche probieren. ");

  AddSmell( ({ "waldgeruch" }),
    "Er kommt wohl von den Baeumen aus dem Osten. ");

  AddSmell( ({ "baeume" }),
    "Sie riechen nach Wald. ");

  AddSmell( ({ "wald" }),
    "Frisch! ");

  AddSmell( ({ "nase" }),
    "Das kannst Du nicht :P ");

  AddSmell( ({ "essen", "essensgeruch" }),
    "Es duftet einfach herrlich! ");

  AddSmell( ({ "osten" }),
    "Du schaffst nicht 'Osten' zu riechen. ");
  

// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Vom Norden klingt ein Glaeserklirren an Dein Ohr. Manchmal "
    "durchweht ein kuehles Lueftchen Deine Haare. Du glaubst auch "
    "das Traellern einiger Voegel wahrnehmen zu koennen. ");

  AddSound( ({ "lueftchen" }),
    "Als Du versuchst an dem Lueftchen zu lauschen verstummt es "
    "ploetzlich. ");

  AddSound( ({ "glaeser", "klirren", "glaeserklirren" }),
    "Anscheinend waescht gerade jemand Geschirr ab. ");

  AddSound( ({ "geschirr" }),
    "So genau hoerst Du es von hier leider nicht. ");

  AddSound( ({ "traellern" }),
    "Einige Voegel traellern ihr Liedchen. ");

  AddSound( ({ "liedchen" }),
    "*twip* *twip* ");

  AddSound( ({ "voegel" }),
    "Vergnuegt pfeifen sie vor sich hin. Genau orten kannst Du "
    "sie leider nicht. ");

  AddSound( ({ "haare", "haaren" }),
    "Deine Haare knistern?!! ");

  AddSound( ({ "knistern" }),
    "Huch, da hat sich doch tatsaechlich eine kleine Spinne in Deinen "
    "Haaren verfangen. ");

  AddSound( ({ "spinne" }),
    "Sie krabbelt vor sich hin. Du sollest sie lieber verscheuchen. ");


  AddCmd( ({ "verscheuch", "verscheuche" }), "c_verscheuchen");
  AddCmd( ({ "zwaeng", "zwaenge" }), "c_zwaengen" );
//  AddCmd( ({ "kraxel", "kraxl", "kraxle" }), "c_kraxeln" );

}

int c_verscheuchen( string str )
{
 if( str != "spinne" )
 {
  notify_fail("Was moechtest Du verscheuchen?\n");
  return 0;
 }
 else
 {
  write(BS("Vorsichtig faengst Du die kleine Spinne mit Deinen Haenden "
           "und setzt sie am Wegrand ab. Geschwind wie der Wind "
           "krabbelt die Kleine davon. "));
  return 1;
 }
}



int c_zwaengen( string str )
{
 if( str != "durch unterholz")
 {
  notify_fail("Wodurch moechtest Du Dich zwaengen?\n");
  return 0;
 }
 else
 {
  write(BS("Beim Versuch Dich durchs Unterholz zu zwaengen, ziehst "
           "Du Dir leider nur viele Schrammen zu. "));
  TP->do_damage(40+random(10), this_object());
  return 1;
 }
}

