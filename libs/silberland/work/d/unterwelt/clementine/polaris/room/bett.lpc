
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../marisol.h"
#include <moving.h>


create()
{

::create();

  SetProp(P_INT_SHORT,  "In einem Keller");
  SetProp(P_INT_LONG,
    "Schwarze lange Spitzenvorhaenge umhuellen das gusseiserne Himmelbett "
    "und verwehren Dir jeglichen Blick nach draussen. Dicke dunkelrote "
    "Samtkissen, von denen Du kaum Deine Augen lassen kannst, liegen "
    "am Kopfende. Auf einer samtenen Decke, die uebers Bett geworfen wurde, "
    "siehst Du eine schwarze, mit giftgetraenkten Stacheln uebersaete "
    "Lederpeitsche. Am Fussende taucht die Flamme einer Kerze alles in "
    "daemmriges Licht. Eine unheimliche Sehnsucht nach laengst Vergessenem "
    "beginnt langsam in Dir hochzusteigen. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 6, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_KILL_NAME, "Mangelnde Intelligenz");
  
  AddItem(NPC( "gruftie" ), REFRESH_DESTRUCT);

  AddExit( "raus", ROOM("keller4") );



// DETAILBEGINN


  AddDetail( ({ "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "bett" }),
    "\n"
    "         ||           ||\n"
    "         ||           ||\n" 
    "         ||           ||\n"
    "         ||           ||\n"
    "   ||    ||     ||    ||\n"
    "   ||    ||_____||____||\n"
    "   ||    || | | ||| | ||\n"
    "   ||    || | | ||| | ||\n"
    "   ||    ||_|_|_|||_|_||\n"
    "   ||    /      ||    /|\n"
    "   ||   /       ||   //|\n"
    "   ||_ /________||  //||\n"
    "   || | | | | | || // ''\n"
    "   ||/| | | | | ||//    \n"
    "   ||_|_|_|_|_|_||/     \n"
    "   ||___________||\n"
    "   ||           ||\n"
    "   ''           ''\n"
    "\n");

  AddSpecialDetail( ({ "boden" }), "boden");

  AddDetail( ({ "wand", "waende" }),
    "Bitte erklaer mir mal, wo das Bett Waende haben soll?!!");

  AddDetail( ({ "vorhaenge", "spitzenvorhaenge" }),
    "Pechschwarze schwere Vorhaenge aus Spitze umhuellen das Bett wie ein "
    "Schleier, und lassen keinen Blick nach draussen zu. ");

  AddDetail( ({ "spitze" }),
    "Die Vorhaenge bestehen aus mehreren kunstvoll gehaekelten Lagen aus "
    "Spitze. ");

  AddDetail( ({ "lagen" }),
    "Es sind mehrere, da man sonst ja durch die Spitze durchsehen koennte. ");

  AddDetail( ({ "himmelbett" }),
    "Ein kunstvoll gearbeitetes Bett aus schwarzem, schweren Gusseisen. "
    "An den beiden Breitseiten hat es Gitterstaebe, an den Ecken je einen "
    "Eckpfosten, die ueber Dir dann wieder zu einem Rechteck "
    "zusammenlaufen. ");

  AddDetail( ({ "rechteck" }),
    "Da es ein Himmelbett ist, ist das natuerlich notwendig. ");

  AddDetail( ({ "eckpfosten", "pfosten" }),
    "An jeder Ecke befindet sich einer. ");

  AddDetail( ({ "ecke", "eck", "ecken" }),
    "\n"
    "1--------2\n"
    "|        |\n"
    "3--------4\n"
    "\n"
    "Das Bett hat vier Ecken mit je vier Eckpfosten - 1, 2, 3 und 4. "
    "Zwischen 1 und 3 sowie 2 und 4 befinden sich ausserdem Gitterstaebe. ");

  AddDetail( ({ "breitseiten", "seiten" }),
    "Die beiden Laengsseiten werden an den Breitseiten durch Gitterstaebe "
    "verbunden. ");

  AddDetail( ({ "laengsseiten" }),
    "Die sind laaaaaaaaaaaaaaaaaang.");

  AddDetail( ({ "staebe" }),
    "Welche Staebe meinst Du?");

  AddDetail( ({ "gitterstaebe" }),
    "Zwischen je 2 Eckpfosten befinden sich an den schmaeleren Seiten "
    "Gitterstaebe. Bei zweien von ihnen faellt Dir etwas Silbernes auf. ");

  AddDetail( ({ "silbernes" }),
    "Was koennte das wohl sein? An zweien der Gitterstaebe am Kopfende "
    "haengt etwas mit je zwei kreisrunden Oeffnungen. ");

  AddDetail( ({ "oeffnung" }),
    "Davon gibt es hier mehrere. ");

  AddDetail( ({ "oeffnungen" }),
    "Vielleicht kann man ja da etwas hineinstecken?!");

  AddDetail( ({ "etwas" }),
    "Na so etwas.... ");

  AddDetail( ({ "handschellen", "schellen" }),
    "An je zwei Gitterstaeben wurden Handschellen fest gemacht. Vielleicht "
    "kannst Du ja hier jemanden festketten?!");

  AddDetail( ({ "kerze" }),
    "Ein Kerzenstumpen steht am Bettende, und spendet spaerlich etwas "
    "Licht. ");

  AddDetail( ({ "stumpen", "kerzenstumpen" }),
    "Die Kerze ist schon ziemlich klein geworden und wird sicherlich bald "
    "ausgehen. ");

  AddDetail( ({ "ende" }),
    "Lange wird es nicht mehr dauern... das bittersuesse Ende naht... ");

  AddDetail( ({ "bettende", "fussende" }),
    "Eine fast abgebrannte Kerze steht beim Fussende und spendet ein wenig "
    "Licht. ");

  AddDetail( ({ "stacheln", "stachel" }),
    "Die Peitsche ist mit giftgetraenkten Stacheln uebersaet. Sie scheinen "
    "urspruenglich von Rosen gewesen zu sein. Du solltest "
    "sehr vorsichtig sein, wenn Du nicht in naechster Zeit sterben willst. ");

  AddDetail( ({ "peitsche", "lederpeitsche" }),
    "Die Peitsche besteht aus feinstem Leder und wurde zusaetzlich mit "
    "Stacheln versehen. Ob man damit jemanden auspeitschen kann?");

  AddDetail( ({ "leder" }),
    "Die Peitsche besteht aus sehr sehr feinem Leder, das ueber und ueber "
    "mit Stacheln versehen ist. ");

  AddDetail( ({ "rosen", "rose" }),
    "Die Stacheln stammten einst von Rosen. ");

  AddDetail( ({ "kissen", "samtkissen" }),
    "Du bist voellig fasziniert von den grossen Samtkissen. Sie sind total "
    "weich und kuschelig. ");

  AddDetail( ({ "klingen", "rasierklingen" }),
    "Zwischen den Kissen liegen einige Rasierklingen...na hoffentlich ritzt "
    "sich damit niemand aus Versehen seinen Arm auf...");

  AddDetail( ({ "eisen", "gusseisen" }),
    "Das Himmelbett wurden aus kunstvoll geschwungenem Gusseisen gefertigt. ");

  AddDetail( ({ "zeit" }),
    "Die Zeit vergeht viel zu schnell...");

  AddDetail( ({ "vergessenem", "vergessenes" }),
    "Du sehnst Dich nach der Vergangenheit, nach Vergessenem. ");

  AddDetail( ({ "vergangenheit" }),
    "Frueher war alles besser... Du wuenschst, Du koenntest die Zeit "
    "zurueckdrehen. ");

  AddDetail( ({ "licht" }),
    "Das spaerliche Licht kommt von der Kerze. ");

  AddDetail( ({ "flamme" }),
    "Die Flamme der Kerze spendet nur spaerliches Licht. ");  

  AddDetail( ({ "sehnsucht" }),
    "Du spuerst, wie sie unaufhaltsam von Dir Besitz ergreift. ");

  AddDetail( ({ "besitz" }),
    "Die Sehnsucht huellt Dich foermlich ein...");

  AddDetail( ({ "schleier" }),
    "Wie ein Schleier umhuellen die schwarzen Vorhaenge aus Spitze das "
    "Bett und verwehren jeglichen Blick in die Aussenwelt...");

  AddDetail( ({ "welt", "aussenwelt" }),
    "Du kannst sie hier drinnen einfach vergessen; sie ist ganz fern. ");

  AddDetail( ({ "blick" }),
    "Alles kommt Dir so unbedeutend vor; Dich interessiert ploetzlich nichts "
    "mehr, was um Dich herum geschieht. ");

  AddDetail( ({ "augen" }),
    "Du kannst sie kaum von den Kissen abwenden, so sehr wirst Du von "
    "ihnen in den Bann gezogen. ");

  AddDetail( ({ "bann" }),
    "Du fuehlst Dich magisch von ihnen angezogen. ");

  AddDetail( ({ "ende" }),
    "Dein Ende ist nahe...");

  AddDetail( ({ "kopfende" }),
    "Am Kopfende des Bettes liegen schwere rote Samtkissen. ");

  AddDetail( ({ "himmel" }),
    "Der Himmel des Bettes besteht ebenfalls aus schwarzer Spitze. ");

  AddDetail( ({ "decke", "samtdecke" }),
    "Die samtene Decke ist dunkelrot und liegt auf dem Bett. ");

// SOUNDS

  AddSound(DEFAULT_SOUND, "Manchmal hoerst Du ein leises Rascheln, ansonsten "
    "herrscht hier allerdings Totenstille. ");

  AddSound( ({ "stille", "totenstille" }), 
    "Nur manchmal unterbricht ein leises Rascheln die Stille. So als ob sich "
    "hier nichts Lebendes aufhalten wuerde...");

  AddSound( ({ "lebendes" }),
    "Hmm.... ");

  AddSound( ({ "hmm" }),
    "Also bitte, sowas kann man nicht hoeren. ");

  AddSound( ({ "rascheln" }),
    "Das leise Rascheln kommt natuerlich von der Samtdecke, auf der Du "
    "Dich befindest. ");

  AddSound( ({ "samtdecke", "decke" }),
    "Sie raschelt leise, wenn Du Dich bewegst. ");

// SMELLS

  AddSmell(DEFAULT_SMELL, 
    "Es riecht nach dem Tod. Irgendwie suesslich. ");

  AddSmell( ({ "tod" }),
    "Riecht sehr seltsam. ");


// CMDS


  AddCmd( ({ "stecke", "steck" }), "c_stecken");
  AddCmd( ({ "kette" }), "c_festketten");
  AddCmd( ({ "peitsch", "peitsche" }), "c_peitschen");
  AddCmd( ({ "schneid", "ritze", "ritz", "schneide" }), "c_ritzen");
  AddCmd( ({ "hebe", "heb" }), "c_heben");
  AddCmd( ({ "kuschl", "kuschel", "kuschle" }), "c_kuscheln");
  
  
}

int c_kuscheln(string str)
{
  if( str != "in kissen"       &&
      str != "in samtkissen"    )
  {
   notify_fail("In was moechtest Du Dich kuscheln?\n");
   return 0;
  }
  else
  {
   if(TP->QueryProp(P_GHOST) )
   {
    write(BS("Du versuchst das Kissen zu umschlingen...doch Deine Haende "
             "greifen immer wieder ins Leere. "));
    return 1;
   }
   else
   {
    write(BS("Du umschlingst das Kissen, und kuschelst Dich hinein... Aua..."
    "zwischen den Kissen befindet sich ein paar Rasierklingen!!!"));
    TP->AddHp(-10);
    return 1;
   }
  }
}



int c_festketten(string str)
{
   object target;
   string opfer;
   string bla;

   if (!str) return write(BS("Wen willst Du festketten?\n")),1;
   if (sscanf(str,"%s %s",opfer,bla) != 2) return 0;
   if (!present(opfer,ENV(TP))) return write(BS("Wen willst Du "
      "festketten?\n")),1;
   if (bla != "fest") return 0;

   target=present(lower_case( opfer ),ENV(TP));
 
   if(!target) return write(BS("Aber "+CAP(opfer)+" ist gar nicht hier!\n")), -1;
 
   if(target->QueryProp(P_INVIS)) return write(BS("Wen willst Du "
     "festketten?\n")), -1;
  
   if(target->QueryProp(P_FROG)) return write(BS("Aber Froesche kann man "
      "doch nicht festketten!\n")), -1;

   if(target->QueryProp(P_GHOST)) return write(BS("Geister kann man doch nicht "
      "festketten!\n")), -1;

   if (target == TP) return write(BS("Du willst Dich selbst festketten?\n")),1;
   if (!query_once_interactive(target)) return write(BS("Das kannst Du nicht "
      "festketten.\n")),1;
   write(BS("Du versuchst "+capitalize(target->Name(WEN))+" "
      "festzuketten, doch irgendwie scheinen die Handschellen kaputt "
      "zu sein, denn sie gehen immer wieder auf.\n"));
   tell_object(target,TP->Name(WER)+" versucht, Dich am Bett festzuketten, "
      "doch zum Glueck gehen die Handschellen wieder auf.\n");
   return 1;
}



int c_heben(string str)
{
  if(str != "peitsche auf"       &&
     str != "lederpeitsche auf"   )
  {
   notify_fail("Was moechtest Du aufheben?\n");
   return 0;
  }
  else
  {
   if(TP->QueryProp(P_GHOST))
   {
    write(BS("Leider flutschen Deine Haende beim Versuch die Peitsche "
             "aufzuheben immer wieder durch sie durch. "));
    return 1;
   }
   else
   {
    write(BS("AUAAAAAAAAAAAAAAAAAAAAAA!!!! Die Peitsche hat doch Stacheln!!!\n"
    "\n"
    "Schmerzerfuellt verziehst Du Dein Gesicht. "));
    say(CTPN + "verzieht "+TP->QueryPossPronoun(NEUTER, WEN)+"Gesicht.\n");
    TP->do_damage(20);
    TP->AddPoison(3);
    return 1;
   }
  }
}


int c_peitschen(string str)
{
  if(!str)
  {
   write(BS( "Was moechtest Du genau machen???!!!\n"));
   return 1;
  }
  else
  {
   write(BS("Bevor Du jemanden auspeitschen kannst, solltest Du die "
   "Peitsche schon vorher aufheben!\n"));
   return 1;
  }
}


int c_ritzen(string str)
{
  if(str != "arm mit rasierklinge auf"     &&
     str != "unterarm mit rasierklinge auf"  )
  {
   notify_fail("Was moechtest Du Dir womit aufritzen?\n");
   return 0;
  }
  else
  {
   if(TP->QueryProp(P_GHOST) || TP->QueryProp(P_FROG))
   {
    write(BS("In Deiner momentanen Koerperform kannst Du das "
             "leider nicht machen. "));
    return 1;
   }
   else
   {
    write(BS("Schwungvoll ritzt Du Dir mit einer der Rasierklingen ueber "
    "Deinen Unterarm. Gleich darauf, beginnt Dein Arm heftig zu "
    "bluten... "));
    TP->do_damage(60+random(10), this_object());
   // obj reinclonen was lps abzieht bis reset...
    return 1;
   }
  }
}



int c_stecken(string str)
{
  if(str != "haende in oeffnungen"  &&
     str != "haende in oeffnung"    )
  {
   notify_fail("Was moechtest Du wohin stecken?\n");
   return 0;
  }
  else
  {
   write(BS("Du willst Deine eigenen Haende da nicht reinstecken. Such "
   "Dir lieber jemanden anderen, der das fuer Dich macht!"));
   return 1;
  }
}



string boden(string str)
{
  write(BS("Da Du Dich in einem Bett befindest, gibts es logischerweise "
  "hier keinen Boden!!! Dummheit gehoert bestraft!!!"));
  TP->AddHp(-30);
  return "";
}


