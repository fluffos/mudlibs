inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include "../marisol.h"


int anz_heilung;

reset()
{
  ::reset();
  anz_heilung = 3;
}

create()
{
  ::create();

  anz_heilung = 3;
  SetProp(P_INT_SHORT, "In Polaris" );
  SetProp(P_INT_LONG, 
     "Ein kleiner Weg aus Lehm schlaengelt sich zwischen Huetten vorbei "
     "durch Polaris. Im Sueden haengt ein grosses Schild ueber einer gelb "
     "angemalten Huette. Nach Westen kommst Du tiefer in diese "
     "Huettensiedlung hinein. Einige Baeume stehen rechts und links von "
     "Dir. Wie eine kleine Allee kleiden sie den Weg aus, und bieten "
     "etwas Schatten vor der vom Himmel brennenden Sonne. Ein kleines "
     "Baenkchen steht links von Dir unter einer grossen Eiche. "
     "Anscheinend ein Rastplatz fuer muede Wanderer, die durch diese "
     "Stadt ziehen. ");

  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_LIGHT, 1 );

  AddExit( "norden", ROOM ("room5") );
  AddExit( "westen", ROOM ("room9") );
  AddExit( "sueden", ROOM ("post") );


// DETAILBEGINN

  AddDetail( ({ "weg" }),
     "Ein Weg aus Lehm schlaengelt sich zwischen Huetten vorbei durch "
     "Polaris. ");

  AddDetail( ({ "sueden" }),
     "Im Sueden befindet sich eine gelb gestrichene Huette. Ueber der "
     "Eingangstuer haengt ein grosses Schild. ");

  AddDetail( ({ "schild" }),
     "Ein grosses Schild aus Holz. Auf ihm steht "
     "in grossen Lettern etwas geschrieben, Du "
     "kannst es lesen. ");

  AddReadDetail( ({ "schild" }), 
     "<*<*< POSTAMT >*>*>");
  
  AddDetail( ({ "letter", "lettern" }),
    "In grosser Schrift steht etwas auf dem Schild geschrieben. ");

  AddDetail( ({ "schrift" }),
    "Lies es doch einfach! ");

  AddDetail( ({ "holz" }),
    "Du musterst das Schild pruefend, und stellst fest dass es sich hierbei "
    "um ganz normales Birkenholz handelt. ");

  AddDetail( ({ "birkenholz" }),
    "Einfach ein ganz normales Birkenholz. ");

  AddDetail( ({ "eingangstuer", "tuer" }),
    "Die Tuer steht weit offen. Du kannst die Huette muehelos betreten. "
    "Ueber der Tuer haengt ein Schild. ");

  AddDetail( ({ "stadt" }),
    "Du befindest Dich in der Stadt Polaris. ");

  AddDetail( ({ "polaris" }),
    "Da befindest Du Dich gerade. ");

  AddDetail( ({ "eiche", "baum" }),
    "Eine grosse Eiche steht am Wegrand. Sie hat einen sehr dicken Stamm. "
    "Ihre Baumkrone spendet Dir etwas Schatten. Hoch oben in ihrer "
    "Krone kannst Du auch einige Eicheln erkennen. ");

  AddDetail( ({ "stamm" }),
    "Der ist wirklich sehr dick. Umfassen kann man ihn sicherlich nicht. ");

  AddDetail( ({ "rinde" }),
    "Wie jeder andere Baum auch, besitzt natuerlich auch die Eiche eine "
    "Rinde. ");

  AddDetail( ({ "baumkrone", "krone" }),
    "Die Baumkrone der Eiche spendet viel Schatten. Deshalb wurde "
    "wahrscheinlich auch das kleine Baenkchen hier aufgestellt. Einige "
    "Eicheln kannst Du hoch ueber Dir erkennen. ");

  AddDetail( ({ "eicheln", "eichel" }),
    "Irgendwoher hast Du mal gehoert, dass Hexen mit Eicheln zaubern "
    "koennen. ");

  AddDetail( ({ "rastplatz" }),
    "Auf dem Baenkchen kann man sich sicherlich wunderbar ausruhen. ");

  AddDetail( ({ "wanderer" }),
    "Jemand wie Du zum Beispiel. ");

  AddDetail( ({ "jemand" }),
    "Irgendjemand. ");

  AddDetail( ({ "beispiel" }),
    "Bist Du denn nicht muede? ");
 
  AddDetail( ({ "sonne" }),
    "Die Sonne steht hoch ueber Dir am Himmel. Sie leuchtet auf Dich herab. ");

  AddDetail( ({ "himmel" }),
    "Hoch am Himmel steht die leuchtende Sonne. Einige Wolken versuchen "
    "sie bereits zu verdecken, aber ohne Erfolg. ");

  AddDetail( ({ "wolken" }),
    "Einige Wolken scheinen die Sonne verdecken zu wollen. ");

  AddDetail( ({ "erfolg" }),
    "Noch haben die Wolken keine Chance gegen die am Himmel leuchtende "
    "Sonne. ");

  AddDetail( ({ "chance" }),
    "Jeder verdient wohl mal eine Chance...vielleicht sogar auch eine zweite.");

  AddDetail( ({ "zweite chance" }),
    "Hast Du eine verdient? ");

  AddDetail( ({ "boden" }),
    "Der Weg durch Polaris besteht ueberwiegend aus Lehm. Manchmal "
    "kann man auch kleine Steinchen entdecken. ");

  AddDetail( ({ "lehm" }),
    "Lehm ist ein Gemisch aus Erde und Wasser. ");

  AddDetail( ({ "wasser", "erde" }),
    "Wenn man Erde mit Wasser vermischt erhaelt man Lehm. ");

  AddDetail( ({ "gemisch" }),
    "Ein Gemisch entsteht aus dem Zusammenmischen mehrerer Substanzen. ");

  AddDetail( ({ "zusammenmischen", "mischen" }),
    "Man vermengt einfach einige Substanzen miteinander. ");

  AddDetail( ({ "substanzen" }),
    "In diesem Fall Wasser und Erde. ");

  AddDetail( ({ "fall" }),
    "Welchen Fall meinst Du? ");

  AddDetail( ({ "steinchen" }),
    "Manchmal liegen einige Steinchen quer verstreut ueber dem Weg. ");

  AddDetail( ({ "weg" }),
    "Er fuehrt durch Polaris. ");

  AddDetail( ({ "hexen" }),
    "Es sind keine zu sehen. ");

  AddDetail( ({ "schatten" }),
    "Die Baeume bieten etwas Schatten vor der Hitze. ");

  AddDetail( ({ "hitze" }),
    "Es ist sehr heiss heute. ");

  AddDetail( ({ "wegrand" }),
    "Am Wegrand steht eine riesige Eiche, zu ihrem Fusse wachsen "
    "einige Graeser. ");

  AddDetail( ({ "graeser" }),
    "Vielleicht etwas uebertrieben - einige Grashalme gedeihen am "
    "Wegrand. ");

  AddDetail( ({ "grashalme", "halme" }),
    "Gruene Grashalme wachsen am Wegrand. ");

  AddDetail( ({ "grashalm" }),
    "Pflueck ihn doch wenn Du stark genug bist. ");

  AddDetail( ({ "fusse" }),
    "Am Fusse der Eiche wachsen einige Grashalme. ");

  AddDetail( ({ "huettensiedlung", "siedlung" }),
    "Nach Westen kommst Du an weiteren Huetten vorbei. Sie bilden "
    "eine Art Siedlung. ");

  AddDetail( ({ "art" }),
    "Wie wuerdest Du mehrere Huetten aneinander nennen? ");

  AddDetail( ({ "westen" }),
    "Nach Westen kommst Du tiefer in die Huettensiedlung hinein. ");

  AddDetail( ({ "huette" }),
    "Im Sueden steht eine gelb bemalte Huette. Es scheint sich "
    "dabei um ein Postamt zu handeln. ");

  AddDetail( ({ "postamt", "postaemter" }),
    "Nur Postaemter haben diese stechende Gelb als 'Tarnfarbe'. "
    "Geh doch einfach mal nach Sueden, dann erfaehrst Du mehr. ");

  AddDetail( ({ "tarnfarbe", "farbe" }),
    "Ein herrliches Gelb. ");

  AddDetail( ({ "gelb" }),
    "Wunderbar grell leuchtend. ");

  AddDetail( ({ "sueden" }),
    "Im Sueden steht eine gelb bemalte Huette. ");

  AddDetail( ({ "huetten" }),
    "Im Westen stehen weitere Huetten. ");

  AddDetail( ({ "baeume" }),
    "Verschiedene Baeume stehen links und rechts von Dir. Eigentlich "
    "nichts Besonderes, nur eine grosse Eiche sticht Dir besonders ins "
    "Auge. ");

  AddDetail( ({ "besonderes" }),
    "Nichts zu sehen. ");

  AddDetail( ({ "auge", "augen" }),
    "Mit aller Kraft stichst Du Dir Deinen Daumen in Dein Auge. ");

  AddDetail( ({ "kraft" }),
    "Hast Du doch genug! ");

  AddDetail( ({ "daumen" }),
    "Davon hast Du zwei.\n"
    "Du atmest erleichtert auf. ");

  AddDetail( ({ "baenkchen" }),
    "Ein kleines Holzbaenkchen steht im Schatten der grossen Eiche. "
    "Es dient wohl als Rastplatz fuer muede Wanderer.");

  AddDetail( ({ "holzbaenkchen" }),
    "Ein etwas wackeliges Holzbaenkchen, dass trotzdem seinen Zweck "
    "erfuellen zu scheint. In die Lehne hat jemand sehr seltsame "
    "Zeichen eingraviert. ");

  AddDetail( ({ "zweck" }),
    "Es dient dem Entspannen. ");

  AddDetail( ({ "entspannen" }),
    "Ach, Du weisst doch was das ist. ");

  AddDetail( ({ "lehne" }),
    "In die Lehne wurden seltsame Zeichen eingeritzt. ");

  AddDetail( ({ "zeichen" }),
    "Als Du die Zeichen genauer untersuchst, musst Du leider feststellen, "
    "das diese nur von Holzwuermern entstanden sind und nichts bedeuten. ");

  AddDetail( ({ "holzwuermer" }),
    "Sie haben mit ihren Spuren wohl die Zeichen geschaffen, allerdings "
    "haben diese keine Bedeutung. ");

  AddDetail( ({ "bedeutung" }),
    "Keine. ");
 
  AddDetail( ({ "spuren" }),
    "Jedes Lebewesen hinterlaesst seine Spuren. ");

  AddDetail( ({ "lebewesen" }),
    "Auch Du gehoerst dazu. ");

  AddDetail( ({ "allee" }),
    "Die Baeume kleiden Deinen Weg aus und schaffen so eine kleine "
    "Allee. ");

// DETAILENDE


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Es ist ziemlich ruhig hier. Nur einiges Vogelgezwitscher unterbricht "
    "manchmal die Stille. ");

  AddSound( ({ "vogelgezwitscher", "gezwitscher" }),
    "Ein sanftes *tschirp* *tschirp* durchbricht manchmal die Stille. "
    "Es duerften sich wohl einige Voegel auf der Eiche befinden. ");

  AddSound( ({ "eiche"}),
    "Nein. ");

  AddSound( ({ "voegel" }),
    "Sie zwitschern vergnuegt. ");

  AddSound( ({ "stille" }),
    "Nur manchmal durchbrechen einige Voegel die Stille. ");


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Seltsam es riecht doch tatsaechlich nach Farbe. ");

  AddSmell( ({ "farbe" }),
    "Scheint wohl von dem Postamt auszugehen. ");

  AddSmell( ({ "postamt" }),
    "Ist anscheinend erst kuerzlich gestrichen worden. ");
 


  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken" );
  AddCmd( ({ "setz", "sitz", "setze", "sitze" }), "c_setzen" );
  AddCmd( ({ "kletter", "klettere" }), "c_klettern" );
  AddCmd( ({ "umfasse", "umfass" }), "c_umfassen" );



}

int c_umfassen( string str )
{
 if( str != "baum" && str != "stamm")
 {
  notify_fail("Was moechtest Du umfassen?\n");
  return 0;
 }
 else
 {
  write(BS("Du versuchst den Stamm der riesigen Eiche zu umfassen. "
           "Leider sind Deine Arme aber zu kurz. "));
  return 1;
 }
}

int c_klettern( string str )
{
 if( str != "auf baum"  &&
     str != "baum"      &&
     str != "rauf"      &&
     str != "hinauf"    &&
     str != "auf eiche" &&
     str != "eiche"     )
 {
  notify_fail("Wohin moechtest Du klettern?\n");
  return 0;
 }
 else
 {
  write(BS("Du kletterst auf die Eiche hinauf.\n"));
  this_player()->move(ROOM ("baumhaus"), M_GO,
  "irgendwohin", "klettert", "klettert herauf" );
  return 1;
 }
}

int c_setzen( string str )
{
 if( str != "auf baenkchen" )
 {
  notify_fail("Wohin moechtest Du Dich setzen?\n");
 }
 else
 {
  if( anz_heilung < 1 )
  {
   write("Du setzt Dich auf das Baenkchen.\n"
         "Aua! Irgendetwas hat Dich gepiekst!\n"
         "Du springst wieder auf.\n");
   return 1;
  }
  else
  {
   write("Du setzt Dich kurz auf das kleine Baenkchen und streckst "
        "Deine Fuesse lang.\n"
        "Ahhh tut das gut!\n"
        "Frisch erholt erhebst Du Dich wieder.\n");
   TP->self_heal(10);
   anz_heilung--;
   return 1;
  }
 }
}

int c_pfluecken( string str )
{
 if( str != "eicheln" && str != "eichel" && str != "grashalm" )
 {
  notify_fail("Was moechtest Du pfluecken?\n");
  return 0;
 }
 if( str == "eicheln"  ||
     str == "eichel"   )
 {
  write(BS("Leider haengen alle Eicheln zu hoch oben. Du kannst keine "
           "erreichen :( "));
  return 1;
 }
 if( str == "grashalm" )
 {
  write(BS("Du bist zu schwach um den Grashalm zu pfluecken!"));
  say(CTPN+ " schafft es nicht einen kleinen Grashalm zu pfluecken.\n");
  return 1;
 }

}


