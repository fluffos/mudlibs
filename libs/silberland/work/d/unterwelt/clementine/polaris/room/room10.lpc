inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include "../marisol.h"


object ob;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "In Polaris" );
  SetProp(P_INT_LONG, 
     "Du folgst dem lehmigen Weg weiter durch Polaris. "
     "Im Osten befindet sich eine gelb gestrichene Huette. "
     "Suedlich von Dir endet der Weg abrupt vor einem "
     "undurchdringlich scheinendem Waeldchen. Seltsam leer und verlassen "
     "erscheint Dir Polaris auf einmal. Kein einziger Bewohner weit und "
     "breit zu sehen. Nicht einmal irgendwelche Insekten kannst Du erkennen. "
     "Alles wirkt trueb und oed. Auch die Baeume "
     "wirken hier unheimlicher als anderswo. Am Wegrand befindet sich ein "
     "kleiner Felsbrocken, in den seltsame Zeichen eingraviert wurden. ");
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_LIGHT, 1);

  AddExit( "norden", ROOM ("room9") );
  AddExit( "westen", ROOM ("room11") );


// DETAILBEGINN

  AddDetail( ({ "osten" }),
    "Im Osten befindet sich eine gelb gestrichene Huette, doch weit und "
    "breit ist kein Eingang erkennbar. ");

  AddDetail( ({ "huette" }),
    "Eine gelb angestrichene Huette befindet sich im Osten, von hier aus "
    "kann man sie allerdings nicht betreten. ");

  AddDetail( ({ "eingang" }),
    "Er wird sich vermutlich auf der anderen Seite befinden. ");

  AddDetail( ({ "seite" }),
    "Der Eingang wird wohl auf einer anderen sein. ");

  AddDetail( ({ "gelb" }),
    "Eine wunderbar grelle Farbe. ");

  AddDetail( ({ "farbe" }),
    "Die Huette wurde mit gelber Farbe bestrichen. Vermutlich handelt es sich "
    "hier um eine Post. ");

  AddDetail( ({ "post" }),
    "Du bist Dir ganz sicher, dass die gelbe Huette eine Post ist. ");

  AddDetail( ({ "weg" }),
    "Du folgst einem lehmigen Weg durch Polaris. Er fuehrt Dich entweder "
    "nach Westen oder nach Norden. Im Sueden endet er vor einem "
    "undurchdringlich scheinenden Waeldchen. ");

  AddDetail( ({ "lehm" }),
    "Der Weg besteht aus ganz normalem Lehm und schlaengelt sich durch "
    "Polaris. ");

  AddDetail( ({ "polaris" }),
    "Wenn Du nicht weisst was oder wo Polaris ist, ist Dir wirklich nicht "
    "mehr zu helfen. ");

  AddDetail( ({ "bewohner" }),
    "Kein einziger ist weit und breit zu sehen. Seltsam... ");

  AddDetail( ({ "insekten" }),
    "Nicht einmal Insekten kannst Du erspaehen. Das ist doch seltsam, wenn "
    "man bedenkt, dass Ameisen und Kleingetier normalerweise ueberall "
    "zu finden sind, und auch ueberall ueberleben koennen. ");

  AddDetail( ({ "ameisen" }),
    "Keine einzige ist zu erkennen. ");

  AddDetail( ({ "kleingetier", "getier" }),
    "Spinnen und aehnliches. ");

  AddDetail( ({ "spinnen" }),
    "Auch keine Spinnen kannst Du erkennen. ");

  AddDetail( ({ "wegrand" }),
    "Der Wegrand ist, wie Du Dir denken kannst, der Rand des Weges. Ausser "
    "dem Felsbrocken befindet sich nichts aussergewoehnliches hier. ");

  AddDetail( ({ "rand", "weges" }),
    "Den Rand des Weges nennt man Wegrand, ist doch logisch oder? ");

  AddDetail( ({ "felsbrocken", "fels", "brocken", "stein" }),
    "Ein kleiner Felsbrocken aus dunklem Gestein befindet sich am Wegrand. "
    "Seltsame Zeichen wurden in ihn eingraviert, eine sehr seltsame "
    "Macht scheint von ihm auszugehen. ");

  AddDetail( ({ "macht" }),
    "Eine seltsame Macht scheint Dich anzuziehen und zu faszinieren. "
    "Es scheint als sei das hier irgendwas nachdem Du seit langer "
    "Zeit gesucht hast. ");

  AddDetail( ({ "zeit" }),
    "Die Zeit verstreicht beim Forschen ganz schnell. ");

  AddDetail( ({ "forschen" }),
    "Blick Dich in Ruhe hier um. ");

  AddDetail( ({ "ruhe" }),
    "Ruhig. ");

  AddDetail( ({ "gestein" }),
    "Der Felsbrocken besteht aus dunklem Gestein, es scheint fast "
    "schwarz zu sein. Nach oben hin ist er etwas abgeflachter. An seiner "
    "Vorderseite wurden seltsame Zeichen eingraviert. ");

  AddDetail( ({ "zeichen" }),
    "Zeichen, die wohl eine andere Sprache zum Ausdruck bringen. ");

  AddDetail( ({ "ausdruck" }),
    "Auf dem Felsbrocken scheint etwas in einer, Dir fremden, Sprache "
    "eingraviert worden zu sein. ");

  AddDetail( ({ "sprache" }),
    "Ein Sprache, die mit Symbolen spricht. ");

  AddDetail( ({ "symbole" }),
    "Es sind alles Dir fremde Symbole. Ob irgendjemand die alte Kunst noch "
    "beherrscht die Symbole hier zu entschluesseln oder gar zu lesen? ");
    
  AddDetail( ({ "kunst" }),
    "Es musst doch noch jemanden geben der sich damit auskennt... ");
  
  AddDetail( ({ "vorderseite" }),
    "Auf der Vorderseite wurden seltsame Symbole eingraviert. ");

  AddDetail( ({ "gravur" }),
    "Sehr sonderbar... ");

  AddDetail( ({ "rueckseite" }),
    "Du beugst Dich weit nach vorne und musterst kurz die Rueckseite. "
    "Nichts erkennbar... ");

  AddDetail( ({ "oberseite" }),
    "Die Oberseite des Steins ist etwas eingedellt, bei Regen fuellt sich "
    "die kleine Einbuchtung sicherlich mit Wasser auf. ");

  AddDetail( ({ "wasser" }),
    "Momentan befindet sich kein Wasser darin. ");

  AddDetail( ({ "regen" }),
    "Weit und breit kein Regen in Sicht. ");

  AddDetail( ({ "sicht" }),
    "Eingeschraenkte? ");

  AddDetail( ({ "einbuchtung" }),
    "Die Einbuchtung hat die Form eines Gefaesses, dass in den Stein gehauen "
    "wurde. Momentan befindet sich ueberhaupts nichts in ihr. ");

  AddDetail( ({ "gefaess", "form" }),
    "Die Einbuchtung sieht aus, wie ein, in Stein gehauenes Gefaess. "
    "Vielleicht benoetigt man diesen Stein ja hier fuer bestimmte Rituale. ");

  AddDetail( ({ "rituale" }),
    "Du vermutest, dass man den Stein fuer bestimmte Rituale benoetigt. ");

  AddDetail( ({ "vermutung" }),
    "Sicher bist Du Dir nicht. ");

  AddReadDetail( ({ "zeichen" }),
    "Sie sind in einer, Dir unleserlichen Sprache geschrieben! ");

  AddDetail( ({ "waeldchen" }),
    "Im Sueden beginnt ein undurchdringliches Waeldchen, wo sicherlich "
    "kein Durchkommen moeglich ist. ");

  AddDetail( ({ "durchkommen" }),
    "Nicht moeglich. ");

  AddDetail( ({ "moeglichkeit" }),
    "Du suchst verzweifelt nach einer Moeglichkeit, findest aber keine. ");

  AddDetail( ({ "himmel" }),
    "Du blinzelst zum Himmel hinauf.\n"
    "Die Sonne scheint Dir entgegen und waermt Dich etwas auf. ");

  AddDetail( ({ "wolken" }),
    "Wo sind denn hier Wolken? ");

  AddDetail( ({ "sonne" }),
    "Kraeftig strahlt sie vom Himmel und laesst neues Leben entstehen. ");

  AddDetail( ({ "leben" }),
    "Die Sonne laesst, mit ihrer Waerme taeglich neues Leben entstehen, hier "
    "hat sie aber offensichtlich versagt. ");

  AddDetail( ({ "waerme" }),
    "Ein wenig Waerme strahlt von jedem aus. ");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus Lehm, einige Spuren kann man auf ihm erkennen. ");

  AddDetail( ({ "spuren" }),
    "Sie kommen von Norden und fuehren nach Westen. ");

  AddDetail( ({ "baeume" }),
    "Das Waeldchen besteht aus dicht gedraengten Baeumen. Ein richtiges "
    "Mischwaeldchen. ");
 
  AddDetail( ({ "mischwaeldchen" }),
    "In einem Mischwaeldchen gibt es viele verschiedene Arten von Baeumen. "
    "Das Unterholz hier versperrt Dir aber sicherlich auch das "
    "Vorwaertskommen gen Sueden. ");

  AddDetail( ({ "unterholz" }),
    "Alles sehr dicht miteinander verwachsen hier. Abgefallene Blaetter "
    "und abgestorbene Zweige kannst Du hier genauso finden wie dicht "
    "gewachsene Straeucher. ");

  AddDetail( ({ "straeucher", "blaetter", "zweige" }),
    "So nahe kommst Du leider nicht ran! ");

  AddDetail( ({ "arten" }),
    "Ganz viele verschiedene wachsen hier nebeneinander. ");

  AddDetail( ({ "vorwaertskommen" }),
    "Das ist hier sicherlich unmoeglich, weil das Unterholz einfach zu dicht "
    "gedraengt ist, und sogar in sich verwachsen scheint. ");

// DETAILENDE

 
// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Absolute Stille, nicht einmal ein Laut ist zu vernehmen. Ganz unheimlich "
    "wird Dir zumute... ");

  AddSound( ({ "stille" }),
    "Wo es still ist, kann man einfach nichts hoeren. ");

  AddSound( ({ "laut" }),
    "Kein einziger ist zu hoeren. Du bist komplett von Stille eingehuellt. ");


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Es riecht seltsam nach Wald, und ein wenig nach Farbe?! ");

  AddSmell( ({ "farbe" }),
    "Der Geruch kommt wohl von der Huette im Osten zu kommen. Sie scheint "
    "wohl gerade frisch gestrichen zu sein. ");

  AddSmell( ({ "geruch" }),
    "Der Geruch von Farbe kommt von der Huette im Osten. Tapse sie lieber "
    "nicht an. ");

  AddSmell( ({ "wald" }),
    "Kuehle Luft geht von dem Waeldchen aus. ");
 
  AddSmell( ({ "luft", "waldluft" }),
    "Die typische Waldluft - kuehl und einfach nur kuehl. ");

 
  AddCmd( ({ "taps", "tapse" }), "c_tapsen" );
  AddCmd( ({ "entschluessel", "entschluessle", "entschluessl" }), 
                                               "c_entschluesseln" );
  

}

int c_tapsen( string str )
{
 if( str != "huette an"  &&
     str != "farbe an"   )
 {
  notify_fail("Was moechtest Du antapsen?\n");
  return 0;
 }
 if(present("\nfarbobject", this_player()))
 {
  write(BS("Aber Du hast doch schon gelbe Finger! Wozu 2mal?"));
  return 1;
 }
 else
 {
  write(BS("Du tapst auf die Huette...Iihh, Dein Finger ist jetzt ganz gelb "
           "und riecht eklig! "));
  
  clone_object(OBJ ("farbe"))->move 
  (this_player(), M_NOCHECK);
  WLOG(LOG ("polaris.log"), "hat farbige Finger"); 
 return 1;
 }
}
  

int c_entschluesseln( string str )
{
 if( str != "zeichen" &&
     str != "symbole" )
 {
  notify_fail("Was moechtest Du entschluesseln?\n");
  return 0;
 }
 else
 {
  write(BS("So sehr Du Dich auch anstrengst, entschluesseln kannst Du diese "
           "Zeichen beim besten Willen nicht. "));
  return 1;
 }
}

