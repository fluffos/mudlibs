inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../marisol.h"

create()
{

::create();

  SetProp(P_INT_SHORT, "In einem Keller");
  SetProp(P_INT_LONG, 
  "Du befindest Dich in einem kleinen Keller, der anscheinend "
  "als Vorratsraum diente. Einige Regale und Kisten stehen an den Waenden. In "
  "einer Ecke kannst Du sogar noch alte Tonkruege erkennen. "
  "Ein seltsam stechender Geruch dringt aus einem der Regale. "
  "Irgendwelche Lebensmittel scheinen dort wohl noch zu verwesen. "
  "In der Mitte des Raumes steht ein runder Holztisch, auf dem seltsame "
  "Gegenstaende liegen. Um ihn wurde ein Kreis in der Erde gezogen. "
  "Mit Hilfe einer kleinen Treppe kannst Du wieder nach oben gelangen. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 8, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

  AddExit( "oben", ROOM("huette2") );


// DETAILBEGINN

  AddDetail( ({ "decke" }),
    "Die Decke befindet sich nur knapp ueber Deinem Kopf und besteht aus alten "
    "Holzbalken. ");
 
  AddDetail( ({ "kopf" }),
    "Knapp ueber Deinem Kopf befindet sich die Decke. ");

  AddDetail( ({ "holzbalken", "balken" }),
    "Die Decke besteht aus alten Holzbalken. Sie sind schon etwas morsch und "
    "quietschen manchmal. ");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus festgetrampelter Erde. Um den Tisch wurde "
    "ein sonderbarer Kreis in die Erde gezeichnet. " );

  AddDetail( ({ "keller" }),
    "Du befindest Dich gerade in ihm. " );

  AddDetail( ({ "vorratsraum", "vorratskammer", "kammer" }),
    "Regale, Kisten und einige Tonkruege lassen darauf schliessen, dass "
    "der Raum hier einmal als Vorratskammer gedient hat. " );

  AddDetail( ({ "raum" }), 
    "Du befindest Dich anscheinend in einem Vorratsraum. ");

  AddDetail( ({ "lebensmittel" }),
    "So genau moechtest Du das nicht herausfinden, der Geruch reicht "
    "vollkommen aus. " );

  AddDetail( ({ "waende", "wand" }),
    "An den Waenden stehen ueberwiegend Regale und einige Kisten, die "
    "sich uebereinander stapeln. Hinter den Regalen kann man schemenhaft "
    "etwas Erde erkennen. " );

  AddDetail( ({ "geruch" }),
    "Probiers doch einmal mit riechen! " );

  AddDetail( ({ "treppe" }),
    "Eine kleine Treppe aus Holz fuehrt Dich wieder in die Huette. " );

  AddDetail( ({ "hilfe" }),
    "Mit Hilfe der kleinen Treppe kannst Du wieder nach oben gelangen. " );

  AddDetail( ({ "tisch", "holztisch" }),
    "Ein runder Holztisch steht genau in der Mitte des Raumes. Auf ihm "
    "liegen seltsame Gegenstaende. Es scheint als wuerde der Tisch irgendetwas "
    "verbergen. " );

  AddDetail( ({ "kreis" }),
    "Ein Kreis wurde um den Tisch in die Erde gezeichnet. Er scheint "
    "ein seltsames Energiefeld zu bilden. " );
 
  AddDetail( ({ "energiefeld", "feld" }),
    "Es geht sicherlich nicht mit rechten Dingen zu. " );

  AddDetail( ({ "gegenstand", "gegenstaende" }),
    "Viele verschiedene Gegenstaende liegen auf dem Tisch. Du kannst "
    "unter anderem eine Schuessel, einen Kelch und einen Dolch erkennen. " );

  AddDetail( ({ "dolch" }),
    "Ein Dolch mit silberner Schneide. Angeblich verwendet man ihn fuer "
    "Ritualbeschwoerungen. ");

  AddDetail( ({ "schneide" }),
    "Vorsicht! Sonst verletzt Du Dich noch. ");

  AddDetail( ({ "rituale", "ritualbeschwoerungen", "beschwoerungen" }),
    "Anscheinend wird dieser Raum fuer sie genutzt. ");


  AddDetail( ({ "kelch" }),
    "Ein silberner Kelch steht auf dem Tisch. Er ist mit einer seltsamen "
    "zaehen Fluessigkeit gefuellt. ");
  
  AddDetail( ({ "fluessigkeit" }),
    "Ob das Blut ist? ");

  AddDetail( ({ "blut" }),
    "Angeekelt wendest Du Dich ab. ");

  AddDetail( ({ "schuessel" }),
    "In der Schuessel befinden sich einige Koerner. ");

  AddDetail( ({ "koerner" }),
    "Du kannst nicht genau erkennen, um welche es sich hierbei handelt. ");

  AddDetail( ({ "ecke" }),
    "In einer Ecke kannst Du alte Tonkruege erkennen. In ihnen wurde "
    "bestimmt einmal Wein oder Oel aufbewahrt. ");

  AddDetail( ({ "kruege", "tonkruege" }),
    "Grosse Kruege aus Ton stehen in einer Ecke. Leider sind sie alle leer. ");

  AddDetail( ({ "oel" }),
    "Leider sind alle Kruege leer. ");

  AddDetail( ({ "wein" }),
    "Den Wein wird wohl schon jemand anderer getrunken haben. ");

  AddDetail( ({ "mitte" }),
    "In der Mitte des Raumes befindet sich ein alter Holztisch. Einige "
    "seltsame Dinge liegen auf ihm. ");

  AddDetail( ({ "dinge" }),
    "Sehr seltsam. ");

  AddDetail( ({ "huette" }),
    "Die Huette befindet sich direkt ueber Dir. Mit einer Treppe kannst Du "
    "wieder nach oben gelangen. ");

  AddDetail( ({ "holz" }),
    "Die Treppe besteht vollstaendig aus Holz. ");
  
  AddDetail( ({ "ton" }),
    "Daraus bestehen die Kruege. ");

  AddDetail( ({ "kisten" }),
    "Viele Kisten stehen uebereinandergestapelt an den Waenden. In ihnen "
    "wurden frueher sicher einmal Vorraete aufbewahrt. ");

  AddDetail( ({ "vorraete" }),
    "Mit der Zeit sind sie verdorben, oder Maeuse haben sie gefressen. "
    "Erkennen kannst Du naemlich keine mehr. ");

  AddDetail( ({ "maeuse", "maus" }),
    "Die sind schon laengst verschwunden. Eine Maus kann ohne Nahrung nicht "
    "ueberleben. ");

  AddDetail( ({ "erde" }),
    "Der ganze Raum hier wurde ins Erdreich gegraben. Sowohl Boden als auch "
    "Waende bestehen aus Erde. Ein sehr merkwuerdiger Kreis wurde in den "
    "Boden eingeritzt. ");

  AddDetail( ({ "erdreich" }),
    "Der Keller befindet sich unter der Erde, und weist die perfekte "
    "Temperatur zum Aufbewahren von Nahrungsmitteln auf. ");

  AddDetail( ({ "nahrungsmittel" }),
    "Hier sind keine mehr. ");
 
  AddDetail( ({ "nahrung" }),
    "Hier gibts keine mehr. ");

  AddDetail( ({ "temperatur" }),
    "Ganz schoen kuehl hier. ");

  AddDetail( ({ "aufbewahren" }),
    "Die Nahrungsmittel wurden sicherlich einmal in den Regalen und Kisten "
    "aufbewahrt. ");

  AddDetail( ({ "regale" }),
    "Einige Regale stehen an der Wand. Etwas Staub hat sie bereits "
    "ueberzogen. Dennoch kannst Du Glaeser, Flaschen und kleine Doeschen "
    "erkennen. ");

  AddDetail( ({ "staub" }),
    "Etwas Staub hat bereits die Regale ueberzogen. ");

  AddDetail( ({ "glaeser", "marmeladeglaeser" }),
    "Leere Marmeladeglaeser stehen in den Regalen. In einem Glas kannst Du "
    "noch etwas Inhalt erkennen. ");

  AddDetail( ({ "inhalt" }),
    "Was darin wohl verborgen sein mag?");
  
  AddDetail( ({ "glas" }),
    "Eine dunkle dicke Masse befindet sich in dem Glas. ");

  AddDetail( ({ "masse" }),
    "Was das wohl sein mag? ");

  AddDetail( ({ "flaschen" }),
    "Leere Flaschen stehen in den Regalen herum. ");

  AddDetail( ({ "doeschen" }),
    "Kleine Doeschen aus Glas stehen auf den Regalen. Auf einigen kannst "
    "Du kleine Zettelchen erkennen, auf denen etwas geschrieben steht. ");

  AddDetail( ({ "zettelchen" }),
    "Lies sie. ");

  AddDetail( ({ "salbe", "ringelblumensalbe" }),
    "Sie ist anscheinend in den kleinen Doeschen drinnen. Ob die noch "
    "gut ist?");
 
  AddReadDetail( ({ "zettelchen" }),
    "Ringelblumensalbe" ); 
 
// DETAILENDE


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Nur manchmal hoerst Du ein Knirschen, das von der Decke zu kommen "
    "scheint. ");

  AddSound( ( {"knirschen" }),
    "Vielleicht geht gerade jemand oben in der Huette auf und ab. ");

  AddSound( ({ "decke" }),
    "Die Decke ist schon alt und morsch, manchmal dringt ein leises Knirschen "
    "von ihr. ");

  AddSound( ({ "stimme" }),
    "Deinem Bauch scheinen die Koerner wohl nicht sehr zu schmecken. "); 


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Ein seltsamer stechender Geruch scheint aus einem der Regale zu kommen. "
    "Ausserdem liegt der Duft von Erde in der Luft. ");

  AddSmell( ({ "geruch" }),
    "Igitt, wie das stinkt! ");

  AddSmell( ({ "duft" }),
    "Es riecht erdig. ");

  AddSmell( ({ "erde" }),
    "Die Erde riecht feucht und nach Erde. ");

  AddSmell( ({ "luft" }),
    "In der Luft vermischt sich ein stechender Geruch mit einem erdigen. ");

  AddSmell( ({ "regale" }),
    "Aus einem der Regale kommt ein grauslich stechender Geruch. Anscheinend "
    "verwesen hier irgendwelche Lebensmittel. ");

  AddSmell( ({ "regal" }),
    "Du versuchst den Geruch zu lokalisieren, versagst aber. ");


  AddSmell( ({ "lebensmittel" }),
    "Igitt! Irgendetwas scheint hier noch zu verwesen. ");
 



  AddCmd( ({ "stell", "stelle" }), "c_stellen");    
  AddCmd( ({ "koste", "kost" }), "c_kosten");
  AddCmd( ({ "trink", "trinke" }), "c_trinken");
  AddCmd( ({ "ess", "esse", "iss" }), "c_essen");

}

c_stellen( string str )
{
 if( str != "in kreis")
 {
  notify_fail("Wohin moechtest Du Dich stellen?\n");
  return 0;
 }
 else
 {
  write(BS("Du stellst Dich in den Kreis, und wirst auf einmal von starker "
           "Energie woanders hingezogen. "));
  this_player()->move(ROOM ("keller2"), M_GO, 
         "ploetzlich weg", "ist", "steht ploetzlich vor Dir");
  return 1;
 }
}


c_kosten(string str)
{
 if(str != "masse" )
 {
  notify_fail("Was moechtest Du kosten?\n");
  return 0;
 }
 else
 {
  write(BS("Du traust Dich nicht die Masse zu kosten. "));
  return 1;
 }
}


c_trinken(string str)
{
 if( str != "aus kelch"    &&
     str != "fluessigkeit" )
 {
  notify_fail("Woraus moechtest Du trinken?\n");
  return 0;
 }
 else
 {
  write("Vorsichtig nippst Du an dem Kelch.\n"
        "Igiiittt, schmeckt das ekelig!\n"
        "Sofort spuckst Du diese zaehe Fluessigkeit wieder aus.\n");
  return 1;
 }
}

c_essen(string str)
{
 if(str != "koerner")
 {
  notify_fail("Was moechtest Du essen?\n");
  return 0;
 }
 else
 {
  write("Eine Stimme in Deinem Bauch meldet sich:\n"
        "Moechtest Du wirklich so frueh sterben?\n"
        "Du denkst . o O (lieber nichts von den Koernern essen!)\n");
  return 1;
 }
}

