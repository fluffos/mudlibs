inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG, 
     "Ein lehmiger Weg schlaengelt sich durch die Strassen von Polaris. "
     "Im Norden siehst Du eine etwas groessere Huette, ueber deren "
     "Eingang ein Schild angebracht wurde. Im Sueden befindet "
     "sich eine weitere Huette, von der ein seltsamer Geruch ausgeht. "
     "Im Westen und im Osten stehen einige andere Huetten, die Du "
     "deutlich erkennen kannst. Der Himmel wird von "
     "einer dichten Wolkenbank eingehuellt. Eine feuchte Brise weht Dir, von "       "Westen kommend, in Dein Gesicht. ");
 
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  

  AddExit( "osten", ROOM ("room7") );
  AddExit( "westen", ROOM ("room5") );  
  AddExit( "sueden", ROOM ("huette2") );
  AddExit( "norden", ROOM ("laden") );  


  NewDoor( "norden", ROOM ("laden"), ({"tuer", "tuere", "birkentuer" }),
     ({ D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL,
        D_NAME, "Birkentuer",
        D_GENDER, FEMALE,
        D_SHORT, "Im Norden befindet sich eine %se Birkentuer.",
        D_LONG, "Eine alte Birkentuer, durch die man in den Laden "
                "gelangt. Mit Hilfe eines Riegels laesst sie "
                "sich oeffnen und schliessen. ",
        D_MSGS, ({ "nach Norden", "geht", "kommt herein" }),
        D_OPENMSG, ({ "Mit lautem Knarren schiebst Du den Riegel beiseite "
                      "und die Tuer oeffnet sich. ",
                      "Mit lautem Knaaren schiebt %s den Riegel beiseite.",
                      " wird mit lautem Knarren von aussen geoeffnet." }),
        D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du die Tuer.",
                       "Mit einem lauten Rumms schliesst %s die Tuer.",
                       " wird mit lautem Knarren von aussen geschlossen." }),           D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen. " }) );



// DETAILBEGINN

  AddDetail( ({ "weg" }),
     "Der Weg fuehrt Dich durch die Strassen von Polaris. ");

  AddDetail( ({ "strassen" }),
     "Strassen gibt es hier viele. Meinst Du eine Bestimmte?");

  AddDetail( ({ "lehm" }),
     "Der Weg besteht komplett aus Lehm. Vereinzelt liegen einige "
     "kleine Steinchen verstreut auf ihm. ");

  AddDetail( ({ "steinchen" }),
     "Manche sind eckig, andere rund, und einige sogar oval. Sie sind alle "
     "verschieden und doch gleich. ");

  AddDetail( ({ "strasse" }),
     "Die Strasse nennt sich hier Weg. ");

  AddDetail( ({ "huette", "huetten" }),
     "Du siehst hier ganz viele Huetten. Meinst Du vielleicht eine "
     "ganz Bestimmte? ");

  AddDetail( ({ "bestimmte" }),
     "Welche? ");

  AddDetail( ({ "groessere huette", "grosse huette", "nordhuette" }),
    "Sie befindet sich im Norden, und besteht wie die anderen Huetten, "
    "aus Birkenholz. Ueber ihrem Eingang haengt ein Schild. ");

  AddDetail( ({ "norden" }),
    "Eine groessere Huette befindet sich im Norden. Durch eine Tuer "
    "kannst Du in ihr Inneres vordringen. ");

  AddDetail( ({ "inneres", "innere" }),
    "Von aussen wirst Du das schwer sehen koennen. ");

  AddDetail( ({ "himmel" }),
    "Durch die Wolkenbank siehst Du vor lauter Wolken den Himmel kaum. "
    "Nur selten kannst Du seine graue Farbe erkennen. ");

  AddDetail( ({ "farbe" }),
    "Nur manchmal siehst Du ausser den Wolken auch die graue Farbe des "
    "Himmels. Ein Gewitter kommt Richtung Westen. ");

  AddDetail( ({ "gewitter" }),
    "Noch ist es trocken. Aber sobald Regen aufkommt, wird keine trockene "
    "Stelle ueberbleiben. ");
  
  AddDetail( ({ "regen" }),
    "Noch hast Du Zeit einen Unterschlupf zu suchen. ");

  AddDetail( ({ "zeit" }),
    "Ein wenig Zeit bleibt Dir noch. ");

  AddDetail( ({ "unterschlupf" }),
    "Eine Huette waere sicherlich ein sicherer. ");

  AddDetail( ({ "stelle" }),
    "Wenn der Regen mal hier ist, wird es kein trockenes Plaetzchen mehr "
    "geben. ");

  AddDetail( ({ "plaetzchen" }),
    "Zimtplaetzchen?");

  AddDetail( ({ "zimtplaetzchen" }),
    "Siehst Du eines? ");

  AddDetail( ({ "trockenes plaetzchen" }),
    "Das wird es bei stroemendem Regen nicht mehr geben. ");

  AddDetail( ({ "wolkenbank" }),
    "Der Himmel wird von einer dichten Wolkenbank eingehuellt. Eigentlich "
    "sind es mehrere Wolken, die sich sehr verdichtet haben. ");

  AddDetail( ({ "wolken" }),
    "Die Wolken verdichten sich ueber Dir und bilden eine lueckenlose "
    "Wolkenbank. ");

  AddDetail( ({ "luecke" }),
    "Du kannst leider keine erkennen. "); 

  AddDetail( ({ "polaris" }),
    "Du befindest Dich in der Huettensiedlung von Polaris. ");

  AddDetail( ({ "siedlung", "huettensiedlung" }),
    "Sieh Dich doch um! Ueberall stehen lauter Huetten dicht beieinander. ");

  AddDetail( ({ "holz" }),
    "Vermutlich Birkenholz. ");

  AddDetail( ({ "birkenholz" }),
    "Birkenholz wie man es ueberall hier findet. ");

  AddDetail( ({ "boden" }),
    "Der Weg ist aeusserst lehmig. ");

  AddDetail( ({ "eingang" }),
    "Eine schlichte Holztuer ist der Eingang zur Huette im Norden. Ueber "
    "ihm wurde ein Schild angebracht. ");
 
  AddDetail( ({ "holztuer" }),
    "Eine alte Birkentuer, mit deren Hilfe man in den Laden gelangt. ");

  AddDetail( ({ "geruch" }),
    "Schnuppern!");

  AddDetail( ({ "brise" }),
    "Eine feuchte Brise weht Dir in Dein Gesicht. Ein paar Tropfen bleiben "
    "auf Deiner Wange haengen. ");

  AddDetail( ({ "wange" }),
    "Wahrscheinlich ist sie nun etwas feucht und leicht rosa. "
    "Sicher bist Du Dir allerdings nicht. ");

  AddDetail( ({ "tropfen" }),
    "Die Tropfen wurden von der Brise 'mitgebracht'. ");

  AddDetail( ({ "gesicht" }),
    "Dich froestelt leicht. ");

  AddDetail( ({ "laden" }),
    "Die groessere Huette vor Dir scheint ein Laden zu sein. Zumindest "
    "deutet alles daraufhin. ");

  AddDetail( ({ "suedliche huette", "kleinere huette", "suedhuette" }),
    "Eine weitere Huette befindet sich im Sueden. Sie sieht "
    "schon sehr morsch und zerfallen aus. Ein eigenartig "
    "stechender Geruch weht aus ihrer Richtung. ");

  AddDetail( ({ "westhuetten", "westliche huetten" }),
    "Du kannst deutlich die Umrisse von den Huetten im Westen erkennen. "
    "Um Naeheres zu erfahren muesstest Du Dich allerdings weiter in "
    "westliche Richtung begeben. " );

  AddDetail( ({ "oestliche huetten", "osthuetten" }),
    "Im Osten befindet sich eine weitere Huette. Sie sieht nicht so "
    "verfallen und unheimlich aus, wie die anderen. " );

  AddDetail( ({ "osthuette", "weitere huette" }),
    "Du musst schon naeher rangehen um etwas erkennen zu koennen. ");

  AddDetail( ({ "richtung", "richtungen" }),
    "Richtungen gibt es viele. ");

  AddDetail( ({ "schild" }),
     "Ein Schild aus Holz. ");

// DETAILENDE


// SMELLS

  AddSmell(DEFAULT_SMELL,
     "Sehr viele verschiedene Gerueche wirken auf Dich ein. Aus dem "
     "Sueden scheint ein sehr stechender Duft zu kommen, aus dem Osten "
     "hingegen duftet es schon nach Essen. ");

  AddSmell( ({ "essen" }),
     "Leider kannst Du nichts genaueres 'erriechen'. ");

  AddSmell( ({ "osten", "norden", "westen", "sueden" }),
     "Das geht aber nicht! ");

  AddSmell( ({ "gerueche", "geruch" }),
     "Es vermischen sich hier zuviele Gerueche, sodass Du leider keinen "
     "genau deuten kannst. ");

  AddSmell( ({ "duft", "duefte" }),
     "Undefinierbare Duefte vermischen sich hier miteinander. "
     "Einmal riecht es wunderbar nach frischem Essen, das andere Mal "
     "nach einem Hauch der Verwesung. ");

  AddSmell( ({ "hauch", "verwesung", "hauch der verwesung" }),
     "Igiitt das stinkt aber entsetzlich! ");


// SOUNDS

  AddSound(DEFAULT_SOUND,
     "Aus dem Norden dringt ein stetes Gemurmel an Dein Ohr. Ein sanfter "
     "Windhauch streift zwischen den Huetten vorbei und erzeugt einen leisen "
     "Pfeifton. Alles in allem ist es hier aber eigentlich recht ruhig. ");

  AddSound( ({ "ruhe" }),
     "Still. ");

  AddSound( ({ "norden", "sueden", "osten", "westen" }),
     "Negativ. ");

  AddSound( ({ "gemurmel" }),
     "Von hier aus kannst Du leider nichts genaueres hoeren. ");

  AddSound( ({ "genaueres" }),
     "Irgendjemand scheint hier vor sich hinzubrabbeln. ");

  AddSound( ({ "irgendjemand" }),
     "Scheint wohl der Besitzer des Ladens zu sein. ");

  AddSound( ({ "besitzer" }),
     "Er stoehnt wohl gerade ueber die viele Arbeit. ");

  AddSound( ({ "arbeit" }),
     "Der Besitzer scheint wohl ein sehr beschaeftigter Mann zu sein. ");

  AddSound( ({ "mann" }),
     "Vielleicht solltest Du Dich im Norden genauer umsehen. ");

  AddSound( ({ "laden", "ladens", "ohr" }),
     "Negativ. ");

  AddSound( ({ "huetten", "huette" }),
     "Du presst Dein Ohr an eine Huette. Und hoerst etwas?! ");

  AddSound( ({ "etwas" }),
     "Du scheinst Dich getaeuscht zu haben. ");

  AddSound( ({ "pfeifton", "ton" }),
     "Ein sanfter Windhauch streift zwischen den Huetten vorbei und erzeugt "
     "einen leisen Pfeifton. ");

  AddSound( ({ "windhauch" }),
     "Du spuerst den Windhauch eigentlich nur, manchmal erzeugt er einen "
     "leisen Pfeifton. ");


  AddReadDetail( ({ "schild" }),
    "******************************\n"
    "* Handel mit Waren aller Art *\n"
    "*      Treten Sie ein !      *\n"
    "******************************\n");


  AddCmd( ({ "spuere", "spuer" }), "c_spueren");
  AddCmd( ({ "tritt", "trete", "tret" }), "c_treten");
  AddCmd( ({ "schnupper", "schnuppere", "schnuppre" }), "c_schnuppern");


}

int c_spueren( string str )
{
 if( str != "windhauch" )
 {
  notify_fail("Was moechtest Du spueren?\n");
  return 0;
 }
 else
 {
  write(BS("Dich froestelt leicht. Es ist auf einmal richtig kuehl hier. "
           "Du bekommst sogar eine Gaensehaut. "));
  return 1;
 }
}


int c_schnuppern( string str )
{
 if( str != "geruch"    &&
     str != "an geruch" &&
     str != "am geruch"  )
 {
  notify_fail("Haeh?\n");
  return 0;
 }
 else
 {
  write(BS("Du haeltst Deine Nase besonders hoch, um mehr zu riechen. "
           "Doch wer hoch hinaus will, faellt meistens auch tief. Und nur "
           "weil Du Deine Nase hoeher in die Luft reckst, riechst Du "
           "trotzdem nichts anderes :P "));
  return 1;
 }
}

int c_treten( string str )
{
 if( str != "ein" )
 {
  notify_fail("Wenn Du schon was nach tritt tippst, dann sag mir "
              "wen oder wie ich das soll.\n");
  return 0;
 }
 else
 {
  write(BS("Wie waers wenn Du einfach die Tuer oeffnest?"));
  return 1;
 }
}
        
