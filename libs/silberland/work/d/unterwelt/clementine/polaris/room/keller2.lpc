
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../marisol.h"
#include <moving.h>

create()
{

::create();

  SetProp(P_INT_SHORT,  "In einem Keller");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem leeren Keller. Seine Waende und der Boden "
    "bestehen aus fester dunkler Erde. Einige Flechten haben sich an den "
    "Waenden angesiedelt und speichern Wasser in sich. Spinnennetze, "
    "die schon ziemlich verstaubt sind, vegetieren in den Ecken vor sich hin. "
    "Die Luft ist ziemlich abgestanden und feucht. Du wunderst Dich, wofuer "
    "dieser Raum einst benutzt wurde, aber lange moechtest Du hier "
    "nicht verweilen. "); 
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 6, ENV_TERRAIN: TT_CAVE]) );
 

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus festgetrampelter Erde, in die ein sonderbarer "
    "Kreis gezeichnet wurde. ");

  AddDetail( ({ "kreis" }),
    "Der Kreis scheint ein seltsames Energiefeld zu bilden. ");

  AddDetail( ({ "energiefeld", "feld" }),
    "Wahrlich sonderbare Energie geht von ihm aus. ");

  AddDetail( ({ "energie" }),
    "Ob man sie irgendwie spueren kann? ");

  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen aus Erde. Einige Flechten haben sich schon an "
    "ihnen festgekrallt, und speichern Wasser in sich. ");

  AddDetail( ({ "wasser" }),
    "Das Wasser wird von den Flechten gespeichert. ");

  AddDetail( ({ "flechten", "flechte" }),
    "Sie wachsen an den Waenden. Vielleicht kannst Du sie ja herunter "
    "reissen?! ");

  AddDetail( ({ "netze", "spinnennetze", "spinnennetz", "netz" }),
    "In den Ecken befinden sich Spinnennetze, die langsam aber sicher, "
    "im Laufe der Zeit sehr viel Staub auf sich gezogen haben. ");

  AddDetail( ({ "staub" }),
    "Staub gibt es hier wirklich reichlich. ");

  AddDetail( ({ "spinnen", "spinne" }),
    "Die sind schon vor langer Zeit von hier verschwunden, da sich nicht "
    "genug Nahrung bekommen haben. ");

  AddDetail( ({ "nahrung" }),
    "Du kannst Dir nicht vorstellen, dass es hier ueberhaupt einmal "
    "Nahrung gab. ");

  AddDetail( ({ "zeit" }),
    "Zeit kommt, Zeit geht. ");

  AddDetail( ({ "luft" }),
    "Die Luft riecht ziemlich abgestanden und ist sehr feucht. ");

  AddDetail( ({ "raum" }),
    "Du stehst in einem Keller. ");

  AddDetail( ({ "keller" }),
    "Ein leerer verlassener Keller. Du wunderst Dich, wofuer er wohl "
    "einst benoetigt wurde. ");

  AddDetail( ({ "loch" }),
    "Hinter den Flechten ist ein Loch! Vielleicht kannst Du einfach durch "
    "die Flechten durchgehen!!");


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Absolute Stille. ");

  AddSound( ({ "stille" }),
    "Du hoerst ueberhaupt nichts. ");


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Die Luft riecht abgestanden und feucht. ");

  AddSmell( ({ "luft" }),
    "Lange moechtest Du hier nicht bleiben. ");

  AddDetail( ({ "erde" }),
    "Waende und Boden bestehen vollkommen aus dunkler Erde. ");

  AddDetail( ({ "decke" }),
    "Die Decke befindet sich hoch ueber Dir, sodass Du sie kaum "
    "erkennen kannst. ");

  AddDetail( ({ "ecken", "ecke" }),
    "In den Ecken befinden sich ueberall Spinnennetze, auf denen sich "
    "schon Staub gesammelt hat. ");

  AddDetail( ({ "laufe" }),
    "Untersuch doch nicht jeden Bloedsinn. ");

  AddDetail( ({ "bloedsinn" }),
    "Ein kleiner Krampus sagt: Ruhe jetzt! ");

  AddDetail( ({ "krampus" }),
    "Er ist schon wieder weg. ");

  AddDetail( ({ "ruhe" }),
   "Es ist absolut ruhig hier. ");

  AddDetail( ({ "vorhang" }),
   "Geh doch mal durch!");

  AddCmd( ({ "reiss", "reisse" }), "c_reissen");
  AddCmd( ({ "spuer", "spuere" }), "c_spueren");
  AddCmd( ({ "stelle", "stell" }), "c_stellen");
  AddCmd( ({ "gehe", "geh" }), "c_gehen");

}

int c_reissen( string str )
{
 if( str != "flechten herunter" &&
     str != "flechte herunter"  &&
     str != "flechte runter"    && 
     str != "flechten runter"    )
 {
  notify_fail("Was moechtest Du herunter reissen?!?\n");
  return 0;
 }
 else
 {
  write(BS("Als Du versuchst die Flechten herunterzureissen, stellst Du "
           "fest, dass sie eigentlich nur wie ein Vorhang ein Loch "
           "verdecken. "));
  return 1;
 }
}

int c_gehen(string str)
{
 if(str != "durch flechten"       &&
    str != "durch flechten durch" )
 {
  notify_fail("Wo moechtest Du durchgehen?\n");
  return 0;
 }
 else
 {
  write(BS("Du gehst einfach durch die Flechten durch, und findest Dich "
           "ploetzlich woanders wieder."));
  TP->move(ROOM ("keller3"), M_GO,
    "verschwunden", "ist", "steht ploetzlich vor Dir" );
  return 1;
 }
}


int c_spueren( string str )
{
 if( str != "energie" )
 {
  notify_fail("Was moechtest Du spueren?\n");
  return 0;
 }
 else
 {
  write(BS("Du kannst die Energie so fast nicht spueren. Vielleicht "
           "solltest Du Dich lieber in den Kreis stellen. "));
  return 1;
 }
}



int c_stellen( string str )
{
 if(str != "in kreis" )
 {
  notify_fail("Wohin moechtest Du Dich stellen?\n");
  return 0;
 }
 else
 {
  write(BS("Du stellst Dich in den Kreis, und wirst auf einmal von starker "
           "Energie woanders hingezogen. "));
  this_player()->move(ROOM ("keller"), M_GO, 
         "ploetzlich weg", "ist", "steht ploetzlich vor Dir");
  return 1;
 }
}

