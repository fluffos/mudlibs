inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include "../marisol.h"

int mauer;

create()
{
  ::create();
  
  mauer=1;

  SetProp(P_INT_SHORT, "In Polaris" );
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf einem Weg durch Polaris. "
    "Er schlaengelt sich an Baeumen vorbei zu weiteren Huetten, "
    "die Du bereits von der Ferne wahrnehmen kannst. "
    "Vereinzelt liegen Steinchen auf dem Weg und auch einige Pflanzen "
    "gedeihen hier. Der Himmel strahlt in einem hellen Blau, die Sonne "
    "waermt Deine Haut, keine einzige Wolke ist zu sehen. "
    "Im Osten erkennst Du die Umrisse einer riesigen Eiche. "
    "Weiter im Westen befindet sich eine zerfallene Hausmauer, die "
    "von Efeuranken und anderen Schlingpflanzen umwuchert wird. ");
    
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_LIGHT, 1);
  SetProp(P_KILL_NAME, "Eine umfallende Mauer" );


  AddExit( "osten", ROOM ("room8") );
  AddExit( "sueden", ROOM ("room10") );


// DETAILBEGINN

  AddDetail( ({ "huette", "huetten" }),
    "Im Sueden befinden sich weitere Huetten, doch von hier kannst Du kaum "
    "etwas erkennen. ");

  AddDetail( ({ "weg", "boden" }),
    "Der Weg besteht hauptsaechlich aus Lehm und fuehrt zwischen Baeumen "
    "vorbei zu weiteren Huetten. Einige kleine Steinchen liegen vereinzelt "
    "auf ihm herum. ");

  AddDetail( ({ "steinchen" }),
    "Kleine Steinchen liegen hier einfach so in der Gegend herum. Sie scheinen "
    "zu nichts zu gebrauchen sein. ");

  AddDetail( ({ "gegend" }),
    "Sieh Dich doch einfach mal um! ");

  AddDetail( ({ "pflanzen" }),
    "Einige Pflanzen kann man am Wegrand erkennen. Vorwiegend Brennesseln und "
    "andere Wildpflanzen. ");

  AddDetail( ({ "wildpflanzen" }),
    "Brennesseln gedeihen hier anscheinend praechtig, auch anderes Unkraut "
    "waechst hier. ");

  AddDetail( ({ "unkraut" }),
    "Nicht alles was man als Unkraut bezeichnet ist auch wirklich welches, "
    "aber da Du Dich mit Pflanzen prinzipiell nicht so gut auskennst, "
    "darfst Du das hier ruhig Unkraut nennen. ");

  AddDetail( ({ "brennessel", "brennesseln" }),
    "Brennessel sollen heilende Wirkung haben. ");

  AddDetail( ({ "wirkung" }),
    "Vielleicht solltest Du einen Bewohner danach fragen. ");

  AddDetail( ({ "bewohner" }),
    "Keiner hier. ");

  AddDetail( ({ "osten" }),
    "Im Osten scheint eine riesige Eiche zu wachsen. ");

  AddDetail( ({ "eiche" }),
    "Sie ist riesig, das kannst Du sogar schon von hier erkennen. Um "
    "Naeheres zu erfahren solltest Du allerdings weiter nach Osten gehen. ");

  AddDetail( ({ "naeheres" }),
    "Dafuer musst Du schon nach Osten gehen. ");
    
  AddDetail( ({ "westen" }),
    "Im Westen befindet sich eine zerfallene Hausmauer. Sie ist mit "
    "Efeuranken und anderen Schlingpflanzen umwuchert. ");

  AddDetail( ({ "lehm" }),
    "Der Boden besteht aus Lehm. ");

  AddDetail( ({ "wegrand" }),
    "Am Wegrand wuchern einige wilde Pflanzen. Neben ihnen kannst Du einige "
    "kleine schwarze Punkte sich bewegen sehen. ");

  AddDetail( ({ "punkte" }),
    "Kleine schwarze Punkte bewegen sich neben den Pflanzen und bilden "
    "eine Spur. ");

  AddDetail( ({ "spur" }),
    "Eine Spur aus schwarzen kleinen Punkten. ");

  AddDetail( ({ "ameisen", "ameise" }),
    "Oh! Tatsaechlich! Ein paar Ameisen scheinen wohl hier in der Naehe einen "
    "Ameisenhaufen gebaut zu haben, indem sie leben. ");

  AddDetail( ({ "ameisenhaufen", "haufen" }),
    "Leider kannst Du keinen erkennen. ");

  AddDetail( ({ "naehe" }),
    "Wo? ");
    
  AddDetail( ({ "himmel" }),
    "Der Himmel erstrahlt in einem hellen Blau. Die Sonne scheint auf Dich "
    "herab und waermt Deine Haut. Weit und breit ist keine einzige "
    "Wolke zu sehen. Wirklich ein herrlicher Tag! ");

  AddDetail( ({ "wolke", "wolken" }),
    "Keine einzige Wolke ist zu sehen. Es ist wirklich ein schoener Tag "
    "heute. ");

  AddDetail( ({ "tag" }),
    "Er ist ganz herrlich heute. Weit und breit ist keine einzige "
    "Wolke zu sehen. ");

  AddDetail( ({ "blau" }),
    "Der Himmel ueber Dir erstrahlt in einem hellen Blau, in dem man "
    "versinken koennte. ");

  AddDetail( ({ "sonne" }),
    "Die Sonne strahlt leuchtend vom Himmel herab und waermt Deine Haut. ");

  AddDetail( ({ "haut" }),
    "Alles noch dran, und schoen warm ausserdem. ");

  AddDetail( ({ "polaris" }),
    "So heisst doch die Stadt, in der Du Dich befindest. ");

  AddDetail( ({ "stadt" }),
    "Polaris! ");

  AddDetail( ({ "ferne" }),
    "Von der Ferne erkennst weitere Huetten, aber "
    "Du musst schon naeher rangehen um sie genauer zu untersuchen. ");

  AddDetail( ({ "umrisse" }),
    "Im Osten scheint eine gewaltige Eiche zu wachsen. Sogar von hier "
    "kann man bereits die Umrisse erkennen. ");

  AddDetail( ({ "baeume" }),
    "Der Weg durch Polaris schlaengelt sich an Baeumen vorbei zu weiteren "
    "Huetten. Besonders im Norden stehen die Baeume sehr dicht, und auch "
    "das Unterholz laesst keine Luecke offen. ");

  AddDetail( ({ "norden" }),
    "Im Norden stehen Birken dicht gedraengt beieinander. ");

  AddDetail( ({ "birken", "birke" }),
    "Sie bilden ein undurchdringliches Waeldchen im Norden. ");

  AddDetail( ({ "waeldchen" }),
    "Das Waeldchen sieht sehr unspektakulaer aus. ");

  AddDetail( ({ "luecke" }),
    "Das Unterholz laesst ueberhaupt keine Luecke offen. Weder Loecher noch "
    "Spalten kann man erkennen. Faszinierend. ");

  AddDetail( ({ "spalten", "spalte", "loecher", "loch" }),
    "Ueberhaupt keine vorhanden. "); 

  AddDetail( ({ "unterholz" }),
    "Das Unterholz ist im Norden besonders dicht. Es besteht vorwiegend aus "
    "spitzem Geaest und einigen Dornenbueschen. Dahinter baeumen sich hohe "
    "Birken auf. ");

  AddDetail( ({ "geaest", "blaetter", "aeste", "kleinholz"  }),
    "Das Unterholz besteht aus sehr viel spitzem Kleinholz, verschiedene Aeste "
    "und abgestorbene Blaetter. ");

  AddDetail( ({ "buesche", "dornenbuesche" }),
    "Einige Dornenbuesche bilden Teil des Unterholzes. Ein Weiterkommen in "
    "noerdliche Richtung ist aussichtslos. ");

  AddDetail( ({ "weiterkommen" }),
    "Unmoeglich! ");

  AddDetail( ({ "teil" }),
    "Die Dornenbuesche verschmilzen einfach mit dem Unterholz. ");

  AddSpecialDetail( ({ "mauer", "hausmauer" }), "mauer" );

  AddDetail( ({ "haus" }),
    "Was wohl mit dem Besitzer passiert ist? ");

  AddDetail( ({ "besitzer" }),
    "Vielleicht ist er ja auch verstorben. ");

  AddDetail( ({ "schlingpflanzen", "efeuranken", "ranken" }),
    "Im Laufe der Jahre haben Schlingpflanzen begonnen sich an der Mauer "
    "breit zu machen. Sie haben alles ueberwuchert, an ein paar Stellen sieht "
    "man noch die kahlen Stellen des alten Mauerwerks. ");

  AddDetail( ({ "mauerwerk" }),
    "An einigen Stellen sieht man noch das alte Mauerwerk durchblinzeln, sonst "
    "ist die Mauer komplett mit Schlingpflanzen ueberwuchert worden. ");

  AddDetail( ({ "stellen" }),
    "An ein paar Stellen haben sich die Pflanzen noch nicht durchsetzen "
    "koennen. ");
 
  AddDetail( ({ "laufe", "jahre" }),
    "Das Haus steht wohl schon seit laengerem nicht mehr hier. Leider "
    "kann man nicht erkennen ob es mutwillig zerstoert, oder einfach "
    "etwas anderem zum Opfer gefallen ist. ");

  AddDetail( ({ "opfer" }),
    "Das Haus koennte auch einem Brand zum Opfer gefallen sein. ");

  AddDetail( ({ "brand" }),
    "Man kann leider nicht mehr erkennen, warum von dem Haus nur mehr "
    "eine Mauer stehen blieb. ");

  AddDetail( ({ "hyrxikadenstrauch", "hyrxikaden", "hyrxikade" }),
    "Die Hyrxikade ist eine sehr seltene Pflanze, die hochgiftig ist! "
    "Halte Dich lieber fern von ihr... ");

// DETAILENDE


// SOUNDS
 
  AddSound(DEFAULT_SOUND,
    "Einige Voegel pfeifen eine lustige Melodie. Sonst ist es recht still "
    "hier. ");

  AddSound( ({ "voegel" }),
    "Einige Voegel pfeifen ein lustiges Liedchen. ");

  AddSound( ({ "liedchen" }),
    "Es scheint aus dem Osten zu kommen. ");

  AddSound( ({ "osten" }),
    "*tweep* *tweep* ");

  AddSound( ({ "melodie" }),
    "Ein froehliche Melodie kommt von Osten. ");


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Es duftet herrlich nach vielen verschiedenen Blumen, aber auch nach "
    "Wald. ");

  AddSmell( ({ "wald" }),
    "Vom Wald kommt ein angenehm erfrischender Geruch.\n"
    "Du atmest tief durch. ");

  AddSmell( ({ "geruch" }),
    "Wirklich angenehm. ");

  AddSmell( ({ "blumen" }),
    "Es duftet nach den verschiedensten Blumen hier, man kann gar nicht so "
    "genau feststellen wieviele verschiedene das wohl sein moegen. ");
   


  AddCmd( ({ "kletter", "klettere" }), "c_klettern" ); 
  AddCmd( ({ "entferne", "entfern" }), "c_entfernen" ); 
  AddCmd( ({ "zieh", "ziehe" }), "c_ziehen");
  AddCmd( ({ "reiss", "reisse" }), "c_reissen" );

} 

 void reset()
 {
  ::reset();
  mauer=1;
 }


int c_klettern( string str )
{
 if( str != "ueber mauer"     &&
     str != "ueber hausmauer" )
 {
  notify_fail("Wohin des Weges?\n");
  return 0;
 }
 else
 {
  write(BS("Du scheiterst bei dem Versuch ueber die Mauer zu klettern "
           "und stuerzt aus Versehen in den giftigen Hyrxikadenstrauch. "));
  TP->do_damage(10+random(10), this_object());
  TP->AddPoison(2);
  WLOG(LOG ("polaris.log"), "ist vergiftet");
  return 1;
 }
}


string mauer()
 {
  if(mauer)
  {
  return(BS( "Im Westen scheint frueher einmal ein Haus gestanden zu haben, "
          "doch alles was heute davon uebergeblieben zu sein scheint, "
          "ist eine einzige Mauer, die noch dazu mit Schlingpflanzen "
          "ueberwuchert ist."));
   }
   else
   {
   return(BS( "Sie scheint erst kuerzlich komplett eingestuerzt zu sein, "
              "und liegt am Boden."));
  }
 }

int c_entfernen( string str )
{
 if( str != "ranken"          &&
     str != "efeuranken"      &&
     str != "schlingpflanzen" &&
     str != "pflanzen"        )
 {
  notify_fail("Was moechtest Du entfernen?\n");
  return 0;
 }
 if(mauer)
 {
  write(BS("Die Pflanzen haben ihre Wurzeln schon zu tief in der Mauer "
           "verankert. Wenn Du weiter an ihnen daran ziehst, reisst "
           "Du die Mauer bestimmt um - und das gibt Tote! "));
  return 1;
 }
 else
 {
  write(BS("Du Pflanzen haben sich schon zu tief in der Mauer verankert! "));
  return 1;
 }
}


int c_ziehen( string str )
{
 if( str != "an pflanzen"   &&
     str != "an efeu"       )
 {
  notify_fail("Woran moechtest Du ziehen?\n");
  return 0;
 }
 if(mauer)
 {
  write(BS("Wenn Du weiter an den Pflanzen reisst stirbst Du ziemlich bald!"));
  return 1;
 }
 else
 {
  write(BS("Die Pflanzen haben sich zu sehr mit ihren Wurzeln in dem "
           "Mauerwerk verankert. ")); 
 return 1;
 }
}


  
int c_reissen( string str )
{
 if(str != "an pflanzen" &&
    str != "an wurzeln" )
 { 
  notify_fail("Woran moechtest Du reissen?\n");
  return 0;
 } 
 
 if(mauer)
 {
  write(BS("Du reisst immer fester an den Pflanzen an, langsam beginnt "
           "sich die Mauer in Deine Richtung zu bewegen!!! "));
  TP->do_damage(100+random(10), this_object());
  WLOG(LOG ("polaris.log"), "versucht ueber die mauer zu klettern" );
  mauer=0;
  return 1;
 }
 else
 {
  write(BS("Die Pflanzen sitzen einfach zu fest!"));
  return 1;
 }
} 

  
