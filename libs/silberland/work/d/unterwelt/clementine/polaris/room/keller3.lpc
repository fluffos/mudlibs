
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../marisol.h"
#include <moving.h>

create()
{

::create();

  SetProp(P_INT_SHORT,  "In einem Keller");
  SetProp(P_INT_LONG,
     "Vor Dir erstreckt sich ein riesiges Kellergewoelbe, in dessen Ecken "
     "sich bereits viele Spinnen breit gemacht haben und kunstvoll ihre "
     "Netze weben. Kuehl und unheimlich wirken die schwarzen Waende auf Dich, "
     "als ob sich etwas Schreckliches in der Naehe befinden wuerde. Ein "
     "gespenstiger Luftzug laesst Deinen ganzen Koerper erschaudern. "
     "Auf dem Boden liegen einige schwarze Rosen, die mit Stacheldraht umgarnt "
     "wurden. Dir ist, als ob der Tod jeden Augenblick seine knoechrige Hand "
     "auf Deine Schulter legen koennte, um Dich mit seinem eiskalten Atem "
     "anzuhauchen, damit jeder Funken Leben in Dir ausgeloescht wird. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 6, ENV_TERRAIN: TT_CAVE]) );

  AddExit(  "norden", ROOM("keller2") );

  AddDetail( ({ "waende", "wand" }),
    "An einer der schwarzen Waende wurde mit blutroter Schrift etwas "
    "geschrieben. ");

  AddDetail( ({ "schrift" }),
    "Blutrote Schrift prangt von einer der Waende. Vielleicht solltest Du "
    "sie lesen? ");

  AddReadDetail( ({ "schrift" }),
    "\n"
    "Im Lichte der Nacht\n"
    "tanze ich ueber die Graeber\n"
    "und danke den Goettern\n"
    "im Angesicht des Todes\n"
    "fuer das Leben.\n"
    "\n" );

  AddDetail( ({ "blut" }),
    "Das Blut, mit dem etwas an die Wand gekritzelt wurde, scheint noch "
    "frisch zu sein. ");

  AddDetail( ({ "spinnen", "spinne" }),
    "Schwarze Spinnen befinden sich ueberall in den Ecken der alten "
    "Mauern, und weben kunstvoll ihre Netze... Vorher sie wohl ihre Nahrung "
    "bekommen? ");

  AddDetail( ({ "netze", "netz" }),
    "Fein gewebte Netze, um jedes Lebewesen einzufangen, damit es nachher "
    "genussvoll verspeist werden kann. ");

  AddDetail( ({ "lebewesen" }),
    "So etwas wie Du. ");

  AddDetail( ({ "boden" }),
    "Der Boden unter Deinen Fuessen ist pechschwarz. Eine Eiseskaelte geht "
    "von ihm aus und scheint alles in sich zu verschlingen. ");

  AddDetail( ({ "eiseskaelte", "kaelte" }),
    "Dich froestelt beim alleinigen Gedanken daran. ");

  AddDetail( ({ "gedanken", "gedanke" }),
    "Verschwinde lieber schleunigst von hier. ");

  AddDetail( ({ "rosen", "rose" }),
    "Schwarze Rosen liegen auf dem Boden, alle wurden mit Stacheldraht "
    "umwebt. Stich Dich lieber nicht, denn das koennte Deinen Tod "
    "bedeuten. ");

  AddDetail( ({ "stacheldraht", "draht" }),
    "Welch dunkler Geselle hier wohl sein Unwesen getrieben hat?!");

  AddDetail( ({ "geselle", "gesell" }),
    "Der Tod ist naeher als Du denkst! ");

  AddDetail( ({ "tod" }),
    "Jeden Augenblick koennte er seine Hand auf Deine Schulter legen, um "
    "Dein Leben endgueltig auszuloeschen. Es ist lediglich eine Frage der "
    "Zeit. ");
   
  AddDetail( ({ "frage" }),
    "Hast Du Dich nicht einmal gefragt, was mit dem Gruftie passiert ist, "
    "der hier einst lebte? ");

  AddDetail( ({ "zeit" }),
    "Lauf um Dein Leben, solange Du noch die Kraft hast!");

  AddDetail( ({ "kraft", "kraefte" }),
    "Du spuerst schon foermlich wie Deine Kraefte schwinden, und Du in Dir "
    "selbst zusammenbrechen wirst. ");

  AddDetail( ({ "luftzug" }),
    "Gespenstig! ");

  AddDetail( ({ "schreckliches", "naehe" }),
    "Lange wird Dein Leben nicht mehr anhalten. ");

  AddDetail( ({ "leben" }),
    "Dein Leben gleicht dem einer Marionette, denn fuer den Tod ist das alles "
    "nur ein Spiel. ");

  AddDetail( ({ "spiel" }),
    "Lauf!");

  AddDetail( ({ "marionette" }),
    "Hast Du wirklich gedacht, dass Du etwas wert bist? ");

  AddDetail( ({ "gruftie" }),
    "Du sehnst Dich nach der Vergangenheit, als Du ihn noch jeden Tag "
    "knutschen konntest. ");

  AddDetail( ({ "vergangenheit" }),
    "So wie er, wirst Du selbst bald Vergangenheit sein. ");

  AddDetail( ({ "decke" }),
    "Die Decke laesst sich von hier gar nicht mehr erkennen. ");

  AddDetail( ({ "gewoelbe", "kellergewoelbe" }),
    "Genau da befindest Du Dich gerade. ");

  AddDetail( ({ "atem" }),
    "Du spuerst ein leichtes Froesteln in Deiner Nackengegend. ");

  AddDetail( ({ "froesteln" }),
    "Als ob Dich jemand von hinten anhauchen wuerde. ");

  AddDetail( ({ "nackengegend" }),
    "Der Tod scheint nahe zu sein. ");

  AddDetail( ({ "hand", "haende" }),
    "Bald wirst auch Du die knoechernen Haende des Todes spueren, und ihm "
    "Angesicht zu Angesicht gegenueberstehen. ");

  AddDetail( ({ "angesicht" }),
    "Kein Sterblicher kehrte je von hier zurueck. ");

  AddDetail( ({ "sterblicher" }),
    "Lauf! ");

  AddDetail( ({ "funken", "lebenskraft" }),
    "Deine Lebenskraft schwindet immer mehr. ");   

  AddDetail( ({ "augenblick" }),
    "Bald ist er gekommen. ");

  AddDetail( ({ "unwesen" }),
    "Du hast jetzt 2 Lebenspunkte und 3 Magiepunkte. ");

  AddDetail( ({ "nahrung" }),
    "...");

  AddDetail( ({ "spiel" }),
    "Gleich ist es vorbei...");

  AddDetail( ({ "tag" }),
    "Du sehnst Dich so sehr nach ihm...");

  AddDetail( ({ "mauern", "mauer" }),
    "Du bist eingeschlossen von ihnen. ");

  AddDetail( ({ "schulter" }),
    "Da!\n"
    "Was war das?");

  AddDetail( ({ "fuessen", "fuesse" }),
    "Unter Dir. ");

  AddDetail( ({ "koerper" }),
    "Dein Koerper erschaudert. ");

  AddDetail( ({ "ecken", "ecke" }),
    "In den Ecken leben Spinnen, die froehlich ihrer naechsten Mahlzeit "
    "entgegen sehen. ");

  AddDetail( ({ "mahlzeit" }),
    "Sie schielen Dich bereits an und scheinen immer naeher zu kommen. ");


  AddSound(DEFAULT_SOUND,
    "Todesstille. ");

  AddSound( ({ "todesstille", "stille" }),
    "Du fuehlst eine Leere in Dir aufkommen. ");

  AddSound( ({ "leere" }),
    "Ist der Tod schon so nahe? ");

  AddSound( ({ "tod" }),
    "Der Tod kommt lautlos...");

  AddSmell(DEFAULT_SMELL,
    "BLUUUUUUUUUUUUUUUUUUUUUUUUUUUT!");

  AddSmell( ({ "blut" }),
    "Ein suesslich stechender Geruch umgibt Dich. ");

  AddSmell( ({ "geruch" }),
    "Du zitterst. ");



  AddCmd( ({ "knutsch", "knutsche" }), "c_knutschen");

}

int c_knutschen( string str )
{
 if( str != "gruftie" )
 {
  notify_fail("Knutsche wen ab?");
  return 0;
 }
 else
 {
  write(BS("Du gibst dem Gruftie im Geiste einen hingebungsvollen und "
           "leidenschaftlichen Kuss."));
  TP->move(ROOM ("keller4"), M_GO,
      "verschwunden", "ist", "steht ploetzlich vor Dir");
  return 1;
 }
}

