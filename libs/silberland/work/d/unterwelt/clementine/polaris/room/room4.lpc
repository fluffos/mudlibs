inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include "../marisol.h"


int anz_schluessel;

reset()
{
 ::reset();
 anz_schluessel = 1;
}

create()
{

::create();
     
  anz_schluessel = 1;
  SetProp(P_INT_SHORT, "In einem Birkenwaeldchen");
  SetProp(P_INT_LONG, 
     "Der Regen durchnaesst Deinen ganzen Koerper, die Wipfeln verhindern "
     "hier nicht mehr den Regen, dafuer sind sie zu licht. Im Sueden stehen "
     "die Birken immer noch dicht gedraengt. Nur im Nordosten lichtet sich "
     "alles ein wenig und Du kannst deutlich eine Huette erkennen. Im Osten "
     "kannst Du die sagenumwobene Stadt Polaris betreten. "
     "Der Wald wird wohl bald ein Ende nehmen. Auch der Boden "
     "wird schon etwas fester. Er scheint nur vom Regen "
     "momentan total aufgeweicht "
     "zu sein. Pfuetzen begleiten Dich auf Deinem Weg, der Boden ist voll "
     "von ihnen. Du solltest aufpassen in keine zu treten, sonst wird "
     "noch Deine Fussbekleidung nass. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0 );

  AddExit( "westen", ROOM ("room3") );
  AddExit( "osten", ROOM ("room5") );


// DETAILBEGINN

  AddDetail( ({ "sagen", "sage" }),
     "Die Sage sagt, dass sich in Polaris ein Hexenvoelkchen niedergelassen "
     "hat. So mancher hat hier schon sein Glueck gefunden, aber einige "
     "sind seit dem Betreten dieser Stadt auch verschollen, und nie wieder "
     "aufgetaucht. ");

  AddDetail( ({ "pfuetzen" }),
     "Schwups! Schon bist Du in eine hineingetreten. Richtig ungeschickt! "
     "Deine Fuesse sind schon platschnass. ");

  AddDetail( ({ "pfuetze" }),
     "Huch, schon wieder bist Du in eine hineingetreten! ");

  AddDetail( ({ "fussbekleidung" }),
     "Wenn Du in eine Pfuetze trittst, werden sicherlich Deine Stiefel "
     "ganz nass und Du erkaeltest Dich womoeglich noch. ");

  AddDetail( ({ "stiefel" }),
     "Die sind doch schon ganz durchnaesst. Du solltest wirklich mehr "
     "aufpassen, sonst holst Du Dir noch eine Grippe. ");

  AddDetail( ({ "grippe" }),
     "Moechtest Du denn eine? Dann lauf doch einfach nackt im Regen "
     "herum! ");

  AddDetail( ({ "stamm", "staemme" }),
     "Die Staemme der Birken besitzen eine weiss strahlende Rinde. ");

  AddDetail( ({ "regen" }),
     "Der Begriff Regen ist hier wirklich untertrieben. Wie aus Schaffeln "
     "regnet es, da die Wipfel der Baeume zu licht sind. Du solltest "
     "Dich beeilen und einen sicheren Ort aufsuchen. ");

  AddDetail( ({ "ort" }),
     "Einen Ort der vor Regen geschuetzt ist zum Beispiel. ");

  AddDetail( ({ "beispiel" }),
     "Eine Huette waere ein Beispiel und die schuetzt sicher auch vor "
     "Regen und Gewitter. ");

  AddDetail( ({ "polaris" }),
     "Gleich hast Du Polaris erreicht. Im Osten kannst Du schon "
     "einige Huetten deutlich erkennen. Man wird Dich sicherlich "
     "freundlich aufnehmen. ");

  AddDetail( ({ "osten" }),
     "Ein kleiner Schritt nach Osten und Du betrittst Polaris. ");

  AddDetail( ({ "schritt" }),
     "*tippelditapp*");

  AddDetail( ({ "stadt" }),
     "Viele erzaehlen, dass Polaris eine wunderbare Stadt ist, andere "
     "verfluchten sie. Mach Dir doch einfach selbst ein Bild davon. ");

  AddDetail( ({ "bild" }),
     "Du koenntest von den Farbfeen ein wunderbares Bild der Stadt "
     "Polaris malen lassen. ");

  AddDetail( ({ "farbfeen" }),
     "Frag doch einfach mal Pu Litza danach. ");
  
  AddDetail( ({ "pu litza", "pu", "litza" }),
     "Angeblich wohnt er irgendwo im Dschungel. ");

  AddDetail( ({ "dschungel" }),
     "Du bist weit entfernt von ihm. ");

  AddDetail( ({ "gewitter" }),
     "Du bist Dir noch nicht ganz sicher ob sich ein Gewitter "
     "anbahnt. ");

  AddDetail( ({ "boden" }),
     "Der Boden unter Deinen Fuessen wird immer fester. Er scheint "
     "nur momentan vom Regen total aufgeweicht zu sein. Ueberall "
     "bedecken in Pfuetzen, die mit Regenwasser gefuellt sind. ");

  AddDetail( ({ "regenwasser", "wasser" }),
     "Der Regen hat ueberall auf dem Weg Pfuetzen entstehen lassen. ");

  AddDetail( ({ "weg" }),
     "Der Weg fuehrt von Westen nach Osten und umgekehrt. "
     "Im Osten erkennst Du eine kleine Stadt, nach Westen fuehrt der "
     "Weg nach Derlim zurueck. ");

  AddDetail( ({ "derlim", "hobbingen" }),
     "Derlim wird aufgrund seiner Bewohner auch oft Hobbingen genannt. "
     "Die Bewohner selbst nennen sich Hobbits. ");

  AddDetail( ({ "ort" }),
     "Ueberzeug Dich doch einfach selbst mal davon. ");

  AddDetail( ({ "hobbits" }),
     "Hobbits sind kleine knuddelige Pelztierchen. Sie haben den Ort "
     "Derlim gegruendet. ");

  AddDetail( ({ "pelztierchen", "tierchen" }),
     "Ein dicker Pelz umgibt die Hobbits. ");

  AddDetail( ({ "pelz" }),
     "Der Pelz dient als Schutz. ");

  AddDetail( ({ "schutz" }),
     "Ja, er schuetzt sogar etwas vor Regen. ");

  AddDetail( ({ "hexenvoelkchen", "voelkchen" }), 
     "Man erzaehlt sich, dass in Polaris einige Hexen ihr Zuhause gefunden "
     "haben. Aber vielleicht ist an der Sage auch nichts Wahres dran. ");

  AddDetail( ({ "hexen" }),
     "Angeblich wohnen welche weiter im Osten. ");

  AddDetail( ({ "zuhause" }),
     "Laut Sage haben sie sich in Polaris niedergelassen. ");

  AddDetail( ({ "wahres" }),
     "Nicht alles was man sich erzaehlt oder anderen muss der wahr sein. ");

  AddDetail( ({ "ende" }),
     "Der Wald lichtet sich schon etwas nach Osten, Du kannst einige "
     "Huetten erkennen, und es scheint als liegt der Geruch von Essen "
     "in der Luft. ");

  AddDetail( ({ "essen" }),
     "Dein Magen knurrt schon gewaltig. ");

  AddDetail( ({ "magen" }),
     "*knurr*");

  AddDetail( ({ "koerper" }),
     "Der Regen durchnaesst Dich von Kopf bis Fuss. Du solltest Dir "
     "schleunigst trockenes Gewand besorgen. ");

  AddDetail( ({ "kopf", "fuss" }),
     "Alles waschelnass!");

  AddDetail( ({ "gewand" }),
     "Dein Gewand ist komplett durchgenaesst. Entweder Du besorgst "
     "Dir rasch ein Neues, oder Du suchst ein Plaetzchen, wo Du Dich "
     "aufwaermen kannst. ");

  AddDetail( ({ "neues" }),
     "Cleme war definitiv am 27.07.2002 zu faul um das Detail zu beschreiben!");

  AddDetail( ({ "cleme", "detail" }),
     "Nix gibts!");

  AddDetail( ({ "plaetzchen" }),
     "Vielleicht findest Du ja einen Feuerplatz, wo man Dir erlaubt "
     "Dich aufzuwaermen. ");

  AddDetail( ({ "feuerplatz" }),
     "Hier ist keiner, Du musst weitersuchen. ");

  AddDetail( ({ "glueck" }),
     "Glueck ist das einzige was man anderen geben kann, ohne es "
     "selbst zu besitzen. ");

  AddDetail( ({ "betreten" }),
     "Einige sind verschollen seit sie Polaris betreten haben. ");

  AddDetail( ({ "schaffeln" }),
     "Es schuettet wie aus Giesskannen. ");

  AddDetail( ({ "giesskannen", "giesskanne" }),
     "Wie kommst Du darauf hier nach einer Giesskanne zu suchen? ");

  AddDetail( ({ "luft" }),
     "Du versuchst die Luft zu untersuchen, doch entweicht sie Dir. ");

  AddDetail( ({ "geruch" }),
     "Riech lieber...");

  AddDetail( ({ "himmel" }),
     "Als Du versuchst zum Himmel raufzuschauen, treffen Dich ein paar "
     "Regentropfen genau in die Augen.\n"
     "Du aergerst Dich.\n"
     "Auch egal, denkst Du Dir, den Himmel kann ich sowieso nicht "
     "wirklich untersuchen, weil ich viel zu weit weg bin. ");

  AddDetail( ({ "regentropfen", "tropfen" }),
     "Ueberall platschen Regentropfen auf den Boden. *platsch* ");

  AddDetail( ({ "augen" }),
     "Deine Augen haben sich durch einige Regentropfen rot verfaerbt. "
     "Wuah gruselig! ");

  AddDetail( ({ "huette" }),
     "Im Nordosten, wo sich der Wald etwas lichtet, kannst Du deutlich "
     "eine Huette erkennen. Geh einfach naeher ran, damit Du mehr erkennen "
     "kannst. ");

  AddDetail( ({ "wald" }),
     "Der Wald scheint nach Osten sein Ende zu nehmen. Die Baeume stehen "
     "nicht mehr so dicht. Und in einiger Entfernung nimmst Du Huetten "
     "wahr. Wahrscheinlich triffst Du dort auch auf Bewohner. "
     "Im Westen allerdings wird er zunehmend dichter. ");

  AddDetail( ({ "huetten" }),
     "Sie sind nicht mehr so weit weg. ");

  AddDetail( ({ "entfernung" }),     
     "Bald hast Du es geschafft. ");

  AddDetail( ({ "bewohner" }),
     "Wer suchet, der findet. ");

  AddDetail( ({ "westen" }),
     "Nach Westen wird der Wald zunehmend dichter. ");

  AddDetail( ({ "wipfel", "wipfeln" }),
     "Die Wipfel der Birken sind nicht sehr dicht hier. "
     "Ihre gruenen Blaetter sind schon ganz nass vom Regen und "
     "haengen schlaff herunter. ");

  AddDetail( ({ "blaetter", "birkenblaetter" }),
     "Gruene Birkenblaetter haengen von den Aesten. Einige Regentropfen "
     "sammeln sich auch auf ihnen. ");

  AddDetail( ({ "aeste" }),
     "Stramme weisse Aeste besitzen die Birken. ");

  AddDetail( ({ "fuesse", "fuessen" }),
     "Deine Fuesse sind schon waschelnass. Du Tollpatsch bist doch "
     "glatt in eine Pfuetze gestiegen! ");

  AddDetail( ({ "tollpatsch" }),
     "Trollpatsch wuerde besser klingen. ");

  AddDetail( ({ "trollpatsch" }),
     "Naja, aber wenn Du kein Troll bist, muesste es auch anders heissen - "
     "Zwergenpatsch vielleicht. ");

  AddDetail( ({ "troll", "trolle" }),
     "Die Trolle sind sehr tolpatschig. Nicht einmal Fackeln koennen "
     "sie am Anfang anzuenden. ");

  AddDetail( ({ "fackel", "fackeln" }),
     "Hier findest Du keine Fackel. ");

  AddDetail( ({ "zwergenpatsch" }),
     "Man koennte genausgut Elfenpatsch, Delfenpatsch, Menschenpatsch, "
     "Hobbitpatsch, ... sagen, aber das klingt einfach nicht so gut. ");

  AddDetail( ({ "elfenpatsch", "delfenpatsch", "menschenpatsch", 
                "hobbitpatsch" }),
     "Lassen wir das Thema. ");

  AddDetail( ({ "thema" }),
     "Schlag eins vor...");
  
  AddDetail( ({ "birken" }),
     "Die Birken wachsen gerade in den Himmel hinauf. Ihre "
     "Aeste sind allerdings nicht sehr dicht. Einige gruene Blaetter "
     "wachsen auf ihnen. Ihre Rinde strahlt in einem hellen weiss. ");

  AddDetail( ({ "rinde" }),
     "Weiss strahlt Dir die Rinde entgegen, eine Stelle unterscheidet "
     "sich allerdings von den anderen. ");

  AddDetail( ({ "stelle" }),
     "Hmm..sieht aus wie ein Loch. ");

  AddDetail( ({ "loch" }),
     "Was kann man bloss mit einem Loch anfangen...");

  AddDetail( ({ "baeume" }),
      "Eigentlich wachsen hier nur Birken. Eine reine Monokultur. "
      "Fuer moorige Gegenden sind Birken allerdings sehr typisch, weil "
      "sie sich auf dem weichen Untergrund wohlfuehlen. ");

  AddDetail( ({ "monokultur", "monokulturen" }),
      "Monokulturen sind sehr anfaellig fuer Schaedlinge. ");

  AddDetail( ({ "schaedlinge" }),
      "Du siehst hier keine Schaedlinge. Anscheinend ein sehr "
      "gesunder Wald. ");

  AddDetail( ({ "gegenden", "gegend" }),
      "Du befindest dich in einer moorigen Gegend. ");

  AddDetail( ({ "untergrund" }),
      "Der Boden wird hier schon allmaehlich fester. ");

  

// DETAILENDE


// SOUNDS

  AddSound(DEFAULT_SOUND,
      "Ueberall tropft der Regen neben Dir auf den Boden. Du "
      "lauscht angestrengt dem Plaetschern. ");

  AddSound( ({ "regen" }),
      "Regentropfen tropfen neben Dir auf den Boden, einige kannst "
      "Du auch auf Deiner Haut spueren. ");

  AddSound( ({ "haut" }),
      "Es zischt immer leise, wenn Dich ein Regentropfen trifft. Deine "
      "Haut ist ganz heiss von den Anstrengungen. ");

  AddSound( ({ "regentropfen", "tropfen" }),
      "*platsch* ");

  AddSound( ({ "anstrengungen" }),
      "Du hast schon einen laengeren Weg hinter Dir und bist ziemlich "
      "erhitzt. ");

  AddSound( ({ "weg" }),
      "Ein langer Weg. ");

  AddSound( ({ "plaetschern" }),
      "Es schuettet fuerchterlich. ");

  AddSound( ({ "boden" }),
      "Du lauscht dem Prasseln. ");

  AddSound( ({ "prasseln" }),
      "Die Regentropfen erzeugen es. ");


// SMELLS

  AddSmell(DEFAULT_SMELL,
      "Es riecht ueberall nach Naesse. Der Boden ist voellig "
      "durchweicht. ");

  AddSmell( ({ "naesse" }),
      "Es riecht nach Regen, liegt wohl daran dass es regnet?! ");

  AddSmell( ({ "regen" }),
      "Als Du versuchst den Regen zu riechen, gelangen viele "
      "Wassertropfen in Deine Nase. ");

  AddSmell( ({ "nase" }),
      "Nein. ");

  AddSmell( ({ "wassertropfen", "tropfen" }),
      "Sie riechen nach Wasser. ");
 
  AddSmell( ({ "wasser" }),
      "Huch, Wasser ist ja geruchslos. ");

  AddSmell( ({ "boden" }),
      "Der Boden riecht nach nasser Erde. ");

  AddSmell( ({ "erde" }),
      "Du stopfst Dir etwas Erde in Deine Nase, damit Du sie besser riechen "
      "kannst. Pfui! ");

  AddSmell( ({ "essen" }),
      "Duftet sehr lecker! ");


  AddSpecialDetail( ({ "begriff" }), "begriffun" );
  AddCmd( ({ "greif", "greife" }), "c_greifen" );

   
}

string begriffun( string str )
  {
   this_player()->command_me("-allgemein Ich bin begriffsstutzig...");
   return "";
  }


int c_greifen( string str )
{
  object ob;
  if(str != "in loch" && str != "loch" )
   {
    notify_fail("Wo willst Du reingreifen?\n");
    return 0;
   }
   
   else
  
   {
    if( anz_schluessel < 1 )
   {
     write(BS("Du greifst in das Loch, findest aber nichts. "
           "Doch halt, was ist das? "
           "Du ertastest eine kleine Vertiefung. "
           "Sie hat die Form eines Schluessels. Anscheinend hat Dir "
           "wer den Schluessel gerade vor der Nase weggeschnappt."));
     return 1;
    }
    else
    {
     write(BS("Du greifst in das Loch und ziehst einen Gegenstand "
              "heraus.\n"));
     say(CTPN+ " kuckt Dich lieb an.\n");
     ob = clone_object(OBJ ("key_huette1"));
     if(ob->move(this_player(), M_GET) != 1)
     {
      tell_object(this_player(), "Das kannst Du nicht mehr tragen!\n");
      ob->move(this_object(), M_NOCHECK);
     }
     anz_schluessel--;
     return 1;
   }
  }
 }


   
      
 

  
     



  
    





