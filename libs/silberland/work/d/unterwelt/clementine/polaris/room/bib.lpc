inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../marisol.h"
#include <moving.h>

create()
{

::create();
  
  SetProp(P_INT_SHORT,  "Eine Geheimbibliothek");
  SetProp(P_INT_LONG,
     "Nachdem sich Deine Augen endlich an die hier herrschenden "
     "Lichtverhaeltnisse gewoehnt haben, erkennst Du, "
     "dass Du Dich in einer Bibliothek "
     "befindest. Teilweise hat sich hier schon der Schimmel "
     "angesiedelt. An den Waenden stehen hohe Regale, die bis oben hin mit "
     "Buechern gefuellt sind. Der Boden ist mit einer Staubschicht "
     "ueberzogen. Etwas Mystisches liegt in der Luft. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );  

  AddExit("raus", ROOM ("huette1") );
 
  AddItem(NPC ("howard"), REFRESH_DESTRUCT );

// DETAILBEGINN

  AddDetail( "lichtverhaeltnisse",
   ([ 0: "Nur muehsam gewoehnen sich Deine Augen an die duesteren "
         "Lichtverhaeltnisse. Der Raum wird lediglich von einer Fackel "
         "beleuchtet. Ohne die waere es hier wohl total stockfinster. ",
   "dunkelelf": "Es ist relativ dunkel hier wohl fuer andere Rassen, aber "
                "Dir als Dunkelelf ist dies relativ egal. Der Raum wird "
                "von einer einzelnen Fackel beleuchtet. "]) );

  AddDetail( ({ "dunkelelf" }),
     "Na kuck Dich doch einfach an! ");

   AddDetail( ({ "rassen" }),
      "Andere Rassen haben es hier wohl schwer, da der Raum kaum "
      "beleuchtet ist. ");

  AddDetail( ({ "regal", "regale", "buecherregal", "buecherregale" }),
     "Die bis zur Decke reichenden Regale sind voller modriger Baende und "
     "erstrecken sich endlos weiter in fensterlose Nischen und Innenraeume. "
     "Irgendwas an den Regalen erweckt Deine Aufmerksamkeit.");

  AddDetail( ({ "baende", "band" }),
     "Offensichtlich scheinen die Buecher und Schriften hier uralt "
     "zu sein. Irgendjemand scheint sie wohl hier gesammelt zu haben. ");

  AddDetail( ({ "buecher", "buch" }),
     "Modrige Buecher fuellen die Regale. Welche Geheimnisse sich "
     "wohl in ihnen verbergen? ");

  AddDetail( ({ "schrift", "schriften" }),
     "Ganze Schriftrollen lagern hier in den Regalen und modern vor "
     "sich hin. Wer diese wohl hier hergebracht hat? ");

  AddDetail( ({ "schriftrollen", "schriftrolle", "rollen", "rolle" }),
     "Die Rollen sehen besonders vergilbt aus. ");

  AddDetail( ({ "aufmerksamkeit" }),
     "Einige Buecher erregen Deine Aufmerksamkeit. Du fragst Dich "
     "was sie wohl in ihren alten vergilbten Blaettern verbergen. ");

  AddDetail( ({ "blaetter" }),
     "Die Blaetter von allen Buechern sind schon sehr vergilbt. "
     "Sie scheinen altes Wissen aufzubewahren. Ein Blatt scheint "
     "auch fuer Dich lesbar zu sein. ");
 
  AddDetail( ({ "blatt" }),
     "Wow da steht etwas drauf...Probiers mal mit lesen. ");

  AddDetail( ({ "wissen" }),
     "Ein Wissen aus laengst vergangener Zeit. ");

  AddDetail( ({ "geheimnis", "geheimnisse" }),
     "Geheimnisse aus uralter Zeit. ");

  AddDetail( ({ "zeit" }),
     "Heute glauben wir, der Erde all ihre Geheimnisse entrissen zu haben, "
     "glauben, dass Technik und Wissenschaft auf jede Frage eine Antwort zu "
     "finden vermag. Wir stossen in die Tiefen des Alls vor, mit Teleskopen "
     "und Raumfahrzeugen, wir erforschen den Grund der Ozeane und die letzten "
     "weissen Flecken auf unserem Globus. Wir glauben so viel zu wissen! ");

   AddDetail( ({ "erde" }),
     "Doch die Erde birgt wahrlich noch Geheimnisse. Nur wir Menschen sind "
     "so arrogant und glauben alles zu wissen. Doch das Wissen der Alten "
     "Goetter koennte uns soviel lehren. ");

   AddDetail( ({ "globus" }),
     "Oh, erst jetzt faellt Dir der Globus auf, der einsam und verlassen "
     "in einer Nische steht. Du faehrst mit dem Finger ueber deinen Globus "
     "und stellst fest, dass die Menschheit noch laengst nicht alle "
     "Geheimnisse gelueftet hat. ");

   AddDetail( ({ "teleskop", "teleskope" }),
     "Mit Teleskopen koennen wir Sterne und Planeten beobachten, ihren "
     "Weg verfolgen und uns ein Bild ueber sie machen. Aber das heisst "
     "noch lange nicht, dass wir sie kennen. ");

   AddDetail( ({ "stern", "sterne", "planet", "planeten" }),
     "Unter freiem Himmel muessen sie wunderbar aussehen. Vielleicht "
     "kannst Du ja auch mal eine Sternschnuppe entdecken. ");
  
   AddDetail( ({ "sternschnuppe" }),
     "Siehst Du hier irgendwo einen Himmel? ");

   AddDetail( ({ "himmel" }),
     "Du muesstest schon woanders hingehen um den Himmel betrachten "
     "zu koennen. ");

   AddDetail( ({ "finger" }),
     "Dein Finger streift langsam ueber den Globus. ");
  
   AddDetail( ({ "weg" }),
     "Die Sterne und auch die Planeten folgen im Gegensatz zu uns "
     "immer ihren Wegen. ");

   AddDetail( ({ "wege", "wegen" }),
     "Geh hinaus in die Welt und suche deinen Weg! ");

   AddDetail( ({ "welt" }),
     "Die Welt ist gross und es gibt viel zu entdecken. ");

   AddDetail( ({ "technik", "wissenschaft" }),
     "Die Wissenschaft und die Technik verhilft uns viele "
     "Erklaerungen und Loesungen zu finden. Aber sie kann uns nicht "
     "dabei helfen unseren Weg fuer uns selbst zu finden. ");

   AddDetail( ({ "erklaerungen", "loesungen", "loesung", "erklaerung" }),
     "Es gibt viele Erklaerungen und Loesungen aber meistens erscheinen "
     "sie uns unverstaendlich. ");

   AddDetail( ({ "ozean", "ozeane" }),
     "Hier wirst Du sie nicht finden. ");

   AddDetail( ({ "raumfahrzeug", "raumfahrzeuge" }),
     "Mit Raumfahrzeugen versuchen wir den Rest des Alls zu erforschen, "
     "um der Spur unseres Lebens naeher zu kommen. ");

   AddDetail( ({ "all" }),
     "Das All erstreckt sich in unendliche Weiten. ");
 
   AddDetail( ({ "weiten" }),
     "Das All ist weit. ");

   AddDetail( ({ "rest" }),
     "Wie wirst Du den Rest Deines Lebens verbringen? ");

   AddDetail( ({ "leben", "lebens" }),
     "Finde Deinen Lebensweg und Du wirst gluecklich. ");

   AddDetail( ({ "flecken", "fleck" }),
     "Die schlauen Koepfe dieser Welt glauben nicht, dass es "
     "noch weisse, unentdeckte Flecken gibt auf dieser Welt. ");

   AddDetail( ({ "koepfe", "kopf" }),
     "Man sollte immer seinen eigenen Kopf haben. ");

   AddDetail( ({ "wand", "waende" }),
     "An den Waenden stehen Regale die bis zur Decke mit Buechern gefuellt "
     "sind. Eine Wanduhr faellt dir auf.");

   AddDetail( ({ "decke" }), 
     "In dem schummrigen Licht dieses Raumes kannst Du die Decke kaum "
     "erkennen. ");

   AddDetail( ({ "licht" }),
     "Das Licht dieses Raumes geht von einer einzelnen Fackel aus. ");

   AddDetail( ({ "fackel", "fackelhalter" }),
     "An einer Wand kannst Du einen Fackelhalter samt Fackel erkennen. ");

   AddDetail( ({ "boden" }),
     "Der Boden ist von einer Staubschicht ueberzogen. ");
    
   AddDetail( ({ "staub", "staubschicht", "schicht" }),
     "Staub liegt ueberall. Doch halt! Ist da nicht im Staub auf dem Boden "
     "eine Formel zu erkennen? "); 
 
   AddDetail( ({ "formel" }),
     "In der Formel scheinst Du etwas Unheilvolles und Verbotenes zu "
     "erkennen. ");

   AddDetail( ({ "unheilvolles", "verbotenes" }),
     "Die Formel sieht aeusserst wichtig aus... ");

   AddDetail( ({ "tor", "tore" }),
     "Ueberall auf der Welt haben die Grossen Alten ihre Tore hinterlassen. "
     "Durch diese Tore kann man ihre Welt betreten.");

   AddDetail( ({ "grosse alte", "daemonen", "alte", "grossen", "grossen alten",                  "yogsothoth", "alten", "alter" }),

      "Die siehst Du zum Glueck nicht.");

   AddDetail( ({ "glueck" }),
      "Du scheinst wirklich Glueck zu haben. ");

   AddDetail( ({ "uhr", "wanduhr" }),
      "Es scheint als haette es etwas ganz besonderes mit der Wanduhr auf "
      "sich. Versuch sie doch mal zu betreten, wenn Du mutig genug bist.");

   AddDetail( ({ "tiefe", "tiefen" }),
      "Die Tiefe Deiner Seele kann besonders tief sein. ");

   AddDetail( ({ "seele" }),
      "Deine Seele kennst Du hoffentlich besser als jemand anderer. ");
 
   AddDetail( ({ "raum", "raumes" }),
      "Du befindest Dich in einer Geheimbibliothek. ");

   AddDetail( ({ "bibliothek", "geheimbibliothek" }),
      "Buecher und Schriften stapeln sich in den Regalen. Etwas "
      "Mystisches geht von ihnen aus. ");
 
   AddDetail( ({ "mystisches", "mystik" }),
      "Eine gewisse Mystik geht von den Buechern aus, vielleicht kannst "
      "Du ja mehr erfahren wenn Du Dich hier ein bisschen umblickst. ");

   AddDetail( ({ "lebensweg" }),
      "Du bist hier um Deinen Lebensweg zu finden. Menschen koennen "
      "Dich immer ein Stueck begleiten, aber Teile musst Du auch alleine "
      "gehen. ");

   AddDetail( ({ "stueck", "teil", "teile" }),
      "Kurze Stuecke und Teile. ");

   AddDetail( ({ "augen", "auge" }),
      "Deine Augen muessen sich erst an das spaerliche Licht gewoehnen. ");

   AddDetail( ({ "luft" }),
      "Die Luft ist erfuellt von Moder. Wenn Du mehr erfahren willst dann "
      "probiers doch lieber mit 'riechen'. ");

   AddDetail( ({ "schimmel" }),
      "An den Waenden hat sich schon etwas Schimmel gebildet. Das liegt "
      "wohl an der Luft. ");

   AddDetail( ({ "moder" }),
      "Rieche! ");

   AddDetail( ({ "nische", "nischen", "innenraeume", "innenraum" }),
      "Die Nischen und Innenraeume sind alle mit Buechern vollgestapelt. "
      "Soviele Buecher hast Du kaum woanders in Deinem Leben gesehen. ");

   AddDetail( ({ "goetter" }),
      "Frueher gab es viele Goetter. Man betete zu ihnen, doch mit der "
      "Christianisierung gerieten sie in Vergessenheit. ");

   AddDetail( ({ "Christianisierung" }),
      "Man versuchte den Menschen mit Gewalt den christlichen Glauben "
      "aufzudraengen. ");

   AddDetail( ({ "gewalt" }),
      "Bitte nicht hier! ");
 
   AddDetail( ({ "glaube", "glauben" }),
      "Jeder Mensch sollte seinen eigenen Glauben leben duerfen. "
      "Jeder Mensch ist anders, sowohl Du als auch ich. ");

   AddDetail( ({ "mensch" }),
      "Bist Du denn kein Mensch? ");

   AddDetail( ({ "vergessenheit", "vergessen" }),
      "Mit Gewalt versucht man Menschen zum Vergessen zu zwingen. "); 

   AddDetail( ({ "antwort", "antworten" }),
      "Manche Antworten kann man nur fuer sich selbst herausfinden. ");

   AddDetail( ({ "frage", "fragen" }),
      "Falls Du Fragen hast so wende Dich doch bitte an einen der "
      "hier Anwesenden. ");

   AddDetail( ({ "anwesende", "anwesenden" }),
      "Tipp mal 'kwer' =) ");

   AddDetail( ({ "menschheit" }),
      "Du, ich, wir, einfach alle... ");

   AddDetail( ({ "grund" }),
      "Manchmal muss man etwas auf den Grund gehen, um sich weiter "
      "zu entwickeln. ");

   AddDetail( ({ "spur", "spuren" }),
      "Folge der Spur, sie wird Dich leiten. ");

   AddDetail( ({ "bild" }),
      "Du solltest Dir schon Dein eigenes Bild von allem machen. ");

   AddDetail( ({ "hinweis" }),
      "Denken musst Du schon selbst. ");

// DETAILENDE


// SMELLS

   AddSmell(DEFAULT_SMELL, 
      "In der Luft liegt der Geruch von Moder. Wahrscheinlich "
      "liegt das an all den alten Buechern. ");

   AddSmell( ({ "moder" }),
      "Igitt. Du steckst Deine Nase in einen Haufen Buecher! ");

   AddSmell( ({ "haufen" }),
      "Ihh der Haufen riecht nach alten vermoderten Buechern! ");

   AddSmell( ({ "nase" }),
      "Wenn Du es schaffst an Deiner Nase zu riechen bekommst Du "
      "eine Million Goldmuenzen. ");

   AddDetail( ({ "muenzen", "goldmuenzen", "million" }),
      "Schade nicht geschafft =) ");
 
   AddSmell( ({ "buecher" }),
      "Die Buecher stinken nach alten Kleidern. ");

   AddSmell( ({ "kleid", "kleider", "kleidern" }),
      "Pfui! ");

   AddSmell( ({ "geruch" }),
      "Es stinkt erbaermlich nach Moder. ");

   AddSmell( ({ "luft" }),
      "Es stinkt modrig. ");
 

// SOUNDS

   AddSound(DEFAULT_SOUND,
      "Du vernimmst das Knarren einiger Balken ueber Dir. Sonst "
      "ist es eigentlich sehr ruhig hier. ");

   AddSound( ({ "balken" }),
      "Erkennen kannst Du sie nicht, da es zu dunkel ist. Nur abundzu "
      "kannst Du ein Knarren hoeren. ");

   AddSound( ({ "knarren" }),
      "Das Knarren scheint von den Balken zu kommen. Vielleicht laeuft "
      "ja grad irgendjemand ueber Deinem Kopf hinweg. ");
 
   AddReadDetail( ({ "blatt" }),
     "\n"
     "Verschieben mag ein Hinweis sein, doch draufkommen musst "
     "Du dennoch ganz allein!\n");


   AddCmd( ({ "bete", "bet" }), "c_beten" );
   AddCmd( ({"beweg", "bewege", "druecke", "verschiebe", "verschieb",
             "drueck", "druecke"}), "beweg_etwas" );
   AddCmd( ({ "wische", "wisch" }), "wische_fkt" );
   AddCmd( ({"betrete", "betritt", "betret" }), "c_betreten");

 
}   

c_beten( string str )
{
 if ( !str)
 {
 write("Du murmelst etwas Unverstaendliches.\n");
 say(CTPN+ " murmelt etwas Unverstaendliches.\n");
 return 1;
 }
}


int beweg_etwas(string str)
{
  notify_fail("Was willst Du bewegen?\n");
  if(str !="buecherregal" && str!="regal") return 0;
  write(BS(
    "Mit einem leisen >Klick< verschiebt sich das Regal und gibt einen "
    "Ausgang nach Unten frei."));
  AddSpecialExit( "unten", "bib" ); 
  return 1;
}

bib()
{
  RemoveExit("unten");
  write("Du gehst ueber eine Treppe nach Unten.\n");
  this_player()->move(ROOM  ("geheim"), M_GO, 
     "ueber eine Treppe", "geht", "kommt herunter");
  say("Das Regal verschiebt sich wieder in seine Ausgangsposition.\n");

  return 1;
}

wische_fkt(string str)
{
  notify_fail("Was willst Du wischen?\n");
  if(str=="staub")
  {
     write("Yogsothoth ist das Tor, Yogsothoth kennt das Tor...\n");
     return 1;
  }
 
  return 0;

}

int c_betreten( string str )
{
 if( str != "uhr"     &&
     str != "wanduhr" )
 {
  notify_fail("Was moechtest Du betreten?\n");
  return 0;
 }
 else
 {
 write("Du ueberschreitest die Grenze zum Wahnsinn.\n");
 this_player()->move((ANSCHLUSS_DIMENSION), M_GO, 
       "in die Wanduhr", "klettert", "faellt herein" );
// say("Die Zeiger der Wanduhr drehen sich einmal im Kreis und nehmen "
//     "ihre Ausgangsposition ein.\n");
 return 1;
 }
}

  
  
  
