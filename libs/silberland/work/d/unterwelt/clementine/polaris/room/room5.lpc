inherit "std/room";

#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <language.h>
#include "../marisol.h"
#include <room/doors.h>
#include <moving.h>


int anz_gbeeren;
int anz_heilung;

reset()
{
  ::reset();
  anz_gbeeren = 3;
  anz_heilung = 3;
}

create()
{

  ::create();

  anz_gbeeren = 3;
  anz_heilung = 3;
  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG,
     "Du befindest Dich am Westende der Stadt Polaris. "
     "Im Norden siehst Du nun "
     "deutlich eine Holzhuette. Nach Sueden und Osten fuehren Wege weiter "
     "durch diese mystische Stadt, nach Westen kommst Du in ein kleines "
     "Birkenwaeldchen. Vereinzelte Straeucher befinden sich "
     "am Wegrand. Der Boden besteht aus festgetrampeltem Lehm. "
     "Im Osten kannst Du bereits die Umrisse von weiteren Huetten "
     "erkennen. Die Stadt ist wohl gar nicht so verlassen, wie Du "
     "anfangs dachtest. Du findest hier sicherlich bald einige Bewohner. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INDOORS, 0 );

  AddExit( "osten", ROOM ("room6") );
  AddExit( "westen", ROOM ("room4") );
  AddExit( "sueden", ROOM ("room8") );

  NewDoor( "norden", ROOM ("huette1"), ({"tuer", "tuere", "birkentuer" }),
     ({ D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL | DOOR_NEEDKEY |
        DOOR_CLOSEKEY,      
        D_NAME, "Birkentuer",
        D_GENDER, FEMALE,
        D_SHORT, "Im Norden befindet sich eine %se Birkentuer.",
        D_LONG, "Eine alte Birkentuer, durch die man in die Huette "
                "gelangt. Du kannst ein kleines Schloss erkennen. ",
        D_MSGS, ({ "nach Norden", "geht", "kommt herein" }),
        D_OPENMSG, ({ "Du ruettelst mit Gewalt am Riegel "
                      "- langsam oeffnet sich die Tuer.",
                      "Mit lautem Knarren oeffnet %s die Tuer.",
                      " wird mit lautem Knarren von aussen geoeffnet." }),
        D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du die Tuer.",
                       "Mit einem lauten Rumms schliesst %s die Tuer.",
                       " wird mit lautem Knarren von aussen geschlossen." }),           D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen. " }) ); 
       
        
 
// DETAILBEGINN
       

  AddDetail( ({ "schloss" }),
    "Anscheinend benoetigt man einen Schluessel zum Oeffnen der Tuere. ");

  AddDetail( ({ "schluessel" }),
    "Hast Du denn einen?");

  AddDetail( ({ "oeffnen" }),
    "Man braucht einen Schluessel um die Tuere zu oeffnen. ");

  AddDetail( ({ "polaris" }),
     "Man erzaehlt sich, dass diese Stadt von Hexen bewohnt wird. "
     "Sie erscheint Dir schon jetzt sehr mystisch. Allerdings gibt "
     "Dir das Wetter etwas zu denken. ");

  AddDetail( ({ "wetter" }),
     "Der Himmel ist stark bewoelkt. Einige dunkle Wolken machen sich "
     "schon breit. ");

  AddDetail( ({ "himmel" }),
     "Der Himmel erstrahlt in einem dunklem Grau. Es ist sehr stark "
     "bewoelkt und einige dunkle Wolken machen sich breit. ");

  AddDetail( ( { "grau" }),
     "Kein sehr schoenes Wetter. ");

  AddDetail( ({ "wolke", "wolken" }),
     "Sie verdecken schon teilweise den Himmel. Es sieht schon sehr nach "
     "Regen ueberall aus. ");

  AddDetail( ({ "regen" }),
     "Hoffentlich beginnt es nicht bald zu regnen. ");

  AddDetail( ({ "stadt" }),
     "Diese Stadt hier nennt sich Polaris. ");

  AddDetail( ({ "holzhuette", "huette" }),
     "Im Norden befindet sich eine einfache Holzhuette. Sie wurde "
     "aus Birkenholz erbaut. Eine Tuer befindet sich an ihrer Vorderseite. "
     "Einige Astloecher kannst Du erkennen. Vielleicht ist es Dir ja "
     "moeglich ins Innere der Huette zu spaehen. Mehr wuerdest Du allerdings "
     "natuerlich erfahren, wenn Du sie einfach betrittst. ");        

  AddDetail( ({ "vorderseite" }),
    "An der Vorderseite der Huette kannst Du deutlich eine Tuer erkennen. "
    "Sie besteht, so wie die Huette auch, aus Birkenholz. ");

  AddDetail( ({ "birkenholz" }),
    "So nennt man das Holz der Birken. ");

  AddDetail( ({ "birken" }),
    "Auf Deinem Weg wirst Du sicherlich schon einige gesehen haben. ");

  AddDetail( ({ "weg", "wege" }),
    "Woher kommst Du, wohin gehst Du?!");

  AddDetail( ({ "holz" }),
    "Das Holz stammt von Birken. ");

  AddDetail( ({ "astloecher" }),
    "Kleine Astloecher kann man an der Vorderseite der Huette erkennen. "
    "Vielleicht kann man ja durch eines hindurchspaehen. ");

  AddDetail( ({ "astloch" }),
    "Das ist sicher gross genug um wenigstens etwas ins Innere spaehen zu "
    "koennen. ");

  AddDetail( ({ "innere", "inneres" }),
    "Das Innere der Huette kannst Du so sicherlich nicht erkennen. ");

  AddDetail( ({ "boden" }),
    "Der Boden unter Deinen Fuessen besteht aus festgetrampeltem Lehm. "
    "Anscheinend ist diese Strasse hier sehr belebt. ");

  AddDetail( ({ "strasse" }),
    "Du befindest Dich auf der Strasse durch Polaris. ");

  AddDetail( ({ "lehm" }),
    "Lehm entsteht aus Schlamm mit Wasser normalerweise. Wenn diese Masse "
    "erhaertet, bleibt Lehm ueber. ");

  AddDetail( ({ "schlamm" }),
    "Wenn man Schlamm mit Wasser vermischt, entsteht irgendwann Lehm daraus. ");

  AddDetail( ({ "wasser" }),
    "Wasser hat sich hier mit Erde vermischt und so entstand Schlamm daraus. "
    "Aus dem Schlamm entstand dann im Laufe der Zeit Lehm. ");

  AddDetail( ({ "erde" }),
    "Erde mit Wasser vermischt ergibt Schlamm, das solltest Du "
    "mittlerweile schon mitbekommen haben. ");

  AddDetail( ({ "zeit" }),
    "Die Zeit heilt alle Wunden. ");

  AddDetail( ({ "wunden" }),
    "Sowohl physische als auch psychische. ");

  AddDetail( ({ "laufe" }),
    "Du laeufst einmal um Deine eigene Achse. ");

  AddDetail( ({ "achse" }),
    "Hmmm. Hier faellt jemandem wohl kein Detail mehr ein. ");

  AddDetail( ({ "detail" }),
     "Faellt Dir denn eins ein? ");

  AddDetail( ({ "masse" }),
     "Erde und Wasser ergeben ein Gemisch, aus dem irgendwann Lehm "
     "entsteht. ");

  AddDetail( ({ "gemisch" }),
     "Drei Teile Erde und ein Teil Wasser muesste reichen. ");

  AddDetail( ({ "teil", "teile" }),
     "Es koennten auch vier Teile Erde sein und nur ein halber Teil "
     "Wasser. ");

  AddDetail( ({ "wegrand" }),
     "Am Wegrand wachsen vereinzelt einige Straeucher. Auch ein paar "
     "Grashalme kann man darunter erkennen. ");

  AddDetail( ({ "grashalme", "halme" }),
     "Gruene Grashalme wachsen am Wegrand. Einer von ihnen weist einen "
     "sehr seltsamen schwarzen Punkt auf. ");

  AddDetail( ({ "punkt" }),
     "Sehr seltsam...");

  AddDetail( ({ "grashalm", "halm" }),
     "Es scheint, als wuerde auf einem Grashalm ein seltenes Insekt sitzen. ");

  AddDetail( ({ "insekt" }),
     "Dieses Insekt ist rot und weist komische schwarze Punkte auf. ");

  AddDetail( ({ "punkte" }),
     "Was koennte das bloss sein?");

  AddDetail( ({ "kaefer" }),
     "Ja, das ist sicherlich ein Kaefer, aber welcher?");

  AddDetail( ({ "marienkaefer" }),
     "Tatsaechlich! Auf einem der Grashalme sitzt ein Marienkaefer. Es "
     "scheint als wuerde er Dir zuzwinkern. Vielleicht solltest Du es ja "
     "ebenso machen. ");
 
  AddDetail( ({ "fuesse" }),
     "Deine Fuesse sehen aeusserst schmutzig aus. Du solltest ihnen "
     "unbedingt mal ein Bad goennen. ");

  AddDetail( ({ "bad" }),
     "Eine Quelle waere genau das Richtige momentan. Dann koenntest Du "
     "Deine Fuesse etwas im kuehlen Nass baumeln lassen. ");

  AddDetail( ({ "quelle" }),
     "Du kannst leider keine entdecken. Wer suchet der findet heisst es "
     "aber normalerweise. ");

  AddDetail( ({ "nass" }),
     "Waere das nicht angenehm? ");

  AddDetail( ({ "richtige" }),
     "Richtig oder falsch, das ist hier die Frage. ");

  AddDetail( ({ "frage" }),
     "Waehle Deine Fragen weise, dann gelangst Du an Dein Ziel. ");

  AddDetail( ({ "ziel" }),
     "Der Weg ist das Ziel. ");

  AddDetail( ({ "eimer" }),
     "Ein Eimer, der mit Wasser gefuellt ist, befindet sich etwas versteckt "
     "hinter einem Strauch. Es ist zwar nicht die erhoffte Quelle, dennoch "
     "koenntest Du Deine Fuesse ja kurz hineinstecken. ");

  AddDetail( ({ "westende" }),
     "Du befindest Dich am Westende der Stadt Polaris. Sie erstreckt "
     "sich nach Osten und Sueden weiter. ");

  AddDetail( ({ "waeldchen", "birkenwaeldchen" }),
     "Ein kleines Birkenwaeldchen befindet sich im Westen. Du kannst "
     "es ohne Probleme betreten. ");

  AddDetail( ({ "probleme" }),
     "Probleme wirst Du sicherlich keine haben, wenn Du weiter nach "
     "Westen vordringst. ");

  AddDetail( ({ "straeucher" }),
     "Einige Straeucher stehen am Wegrand. Leider kannst Du nicht genau "
     "erkennen, um welche Art es sich dabei handelt. ");

  AddDetail( ({ "art" }),
     "Es steht fest, dass es gruene Straeucher sind, aber mehr kannst "
     "Du leider nicht erkennen. ");

  AddDetail( ({ "gruene straeucher" }),
     "Gruene Straeucher befinden sich vereinzelt am Wegrand. Vielleicht "
     "findest Du auch irgendwo Beeren. ");

  AddDetail( ({ "beeren" }),
     "Ein Strauch hat tatsaechlich einige Beeren an seinen Zweigen "
     "haengen. ");

  AddDetail( ({ "zweige" }),
     "An den Zweigen eines Strauches haengen einige Beeren. ");

  AddDetail( ({ "strauch" }),
     "Auf einem der Straeucher haengen einige Beeren. Vielleicht kannst "
     "Du sie ja pfluecken. ");

  AddDetail( ({ "hexen" }),
     "In Polaris sollen welche leben. Vielleicht hast Du ja schon die "
     "eine oder andere Bekanntschaft gemacht. ");

  AddDetail( ({ "bekanntschaft" }),
     "Solltest Du unbedingt tun, falls Du noch nicht die Gelegenheit "
     "dazu hattest. ");

  AddDetail( ({ "gelegenheit" }),
     "Die wird sich schon noch ergeben. ");

  AddDetail( ({ "umrisse" }),
     "Im Osten siehst Du schon die Umrisse von mehreren Huetten. Dort "
     "trifft man sicher auf Leben. ");

  AddDetail( ({ "leben" }),
     "Du musst schon naeher rangehen um etwas erkennen zu koennen. ");

  AddDetail( ({ "bewohner" }),
     "Von denen hast Du bestimmt schon einige Geschichten gehoert. ");

  AddDetail( ({ "geschichten" }),
     "Es wird herum erzaehlt, dass die Bewohner von Polaris der Magie "
     "kundig sind. ");

  AddDetail( ({ "magie" }),
     "Es scheint eine besonders maechtige Magie zu sein. ");

  AddDetail( ({ "sonne" }), 
     "Die Sonne scheint Dich an. ");

// DETAILENDE


// SOUNDS

  AddSound(DEFAULT_SOUND,
     "Es ist aussergewoehnlich ruhig hier. Im Westen dringt das Prasseln "
     "des Regens an Dein Ohr. Aber hier sieht es ganz und gar nicht nach "
     "Regen aus. Im Gegenteil es scheint sogar die Sonne. ");

  AddSound( ({ "sonne" }),
     "Die Sonne ist zu weit weg, um an ihr zu lauschen. ");

  AddSound( ({ "regen", "prasseln" }),
     "Von Westen her dringt ein Prasseln an Dein Ohr. Anscheinend regnet "
     "es dort. Aber warum hier nicht? ");

  AddSound( ({ "gegenteil" }),
     "Ob das sinnvoll ist?! ");

  AddSound( ({ "ohr" }),
     "Die Ohren wachsen zwar im Laufe Deines Lebens, aber daran lauschen "
     "kannst Du sicherlich nicht. ");

  AddSound( ({ "leben" }),
     "Du lauscht an Deinem Leben. Es klingt hohl?!");

  AddSound( ({ "ohren" }),
     "Daran kannst Du nicht lauschen. Wann kapierst Du das endlich?!");

  AddSound( ({ "laufe" }),
     "Wie willst Du dem Laufe Deines Lebens denn lauschen? ");

  AddSound( ({ "westen" }),
     "Spiel Dich hier lieber nicht, sonst tappst Du in eine Falle. ");

  AddSound( ({ "falle" }),
     "Aus! ");
 
  AddSound( ({ "aus" }),
     "Wage es nicht nochmal. ");


// SMELLS

  AddSmell(DEFAULT_SMELL,
     "Es riecht nach nichts. ");

  AddSmell( ({ "nichts" }),
     "Nichts riecht heute besonders gut. ");
  

  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken" );
  AddCmd( ({ "steck", "stecke" }), "c_stecken" );
  AddCmd( ({ "suche", "such" }), "c_suchen");
  AddCmd( ({ "zwinker", "zwinkere" }), "c_zwinkern" ); 
  AddCmd( ({ "spaeh", "spaehe" }), "c_spaehen" );

}

int c_spaehen( string str )
{
 if( str != "durch astloch" &&
     str != "in huette"     &&
     str != "in inneres"    )
 {
  notify_fail("Wodurch moechtest Du spaehen?\n");
  return 0;
 }
 else
 {
  write(BS("Du presst ein Auge an das Astloch und versuchst etwas ins "
           "Innere der Huette zu spaehen. Leider ist Dein Blickfeld so "
           "eingeschraenkt, dass Du ueberhaupt nichts erkennen kannst. "));
  return 1;
 }
}
 
int c_zwinkern( string str )
{
 if( str != "marienkaefer zu")
 {
  notify_fail("Zwinkere wie? Zwinkere wem zu?\n");
  return 0;
 }
 else
 {
  write(BS("Froehlich zwinkerst Du dem Marienkaefer zu. Ploetzlich erhebt "
           "er sich in die Luefte dreht eine Runde um Dich und landet wieder "
           "auf seinem Grashalm. "));
  say(CTPN+ " zwinkert ploetzlich froehlich.\n");
  return 1;
 }
}

int c_suchen( string str )
{
 if( str != "quelle" )
 {
  notify_fail("Du suchst, findest aber nichts.\n");
  return 0;
 }
 else
 {
  write(BS("Leider kannst Du keine Quelle entdecken. Du findest allerdings, "
           "einen hinter einem Strauch versteckten Eimer, der mit Wasser "
           "gefuellt ist. "));
  return 1;
 }
}
  
int c_stecken( string str )
{
 if( str != "fuesse in eimer" &&
     str != "fuesse in wasser" )
 {
  notify_fail("WAS soll ich WOHIN stecken?\n");
  return 0;
 }
 else
 {
 if(anz_heilung < 1 )
  {
   write(BS("Du steckst Deine Fuesse in den Eimer mit Wasser, doch nichts "
            "passiert."));
   return 1;
  }
 else
 { 
  write(BS("Du steckst beide Fuesse in den Eimer mit Wasser und fuehlst "
           "Dich darauf gleich etwas erfrischt. Schmutzig sind sie trotzdem "
           "noch. "));
  TP->heal_self(5);
  anz_heilung--;
  return 1;
  }
 }
}

int c_pfluecken( string str )
{
 object ob;

 if( str != "beeren" && str != "beere")
 {
  notify_fail("Was moechtest Du pfluecken?\n");
  return 0;
 }
 else
 { 
  if( anz_gbeeren < 1 )
  {
  write(BS("Leider sind keine Beeren mehr da die Du pfluecken koenntest. "
           "Da war wohl jemand schneller als Du. "));
  return 1;
  }
  else
  {
  write(BS("Du pflueckst eine schoene rote Beere vom Strauch."));
  ob = clone_object(OBJ ("gbeeren.lpc"));
  if(ob->move(this_player(), M_GET) != 1)
  {
   tell_object(this_player(), "Das kannst Du nicht mehr tragen!\n");
   ob->move(this_player(), M_NOCHECK);
  }
  WLOG(LOG ("polaris.log"), "pflueckt eine " +str);
  anz_gbeeren--; 
  return 1;
  }
 }
}
  
  

