
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../polstadt.h"


create()
{

  ::create();

  SetProp(P_INT_SHORT, "In Polaris");
  SetProp(P_INT_LONG,
    "Das Chaos beherrscht den ganzen Raum und hinterlaesst den Eindruck, "
    "als waere die Huette ueberstuerzt verlassen worden. In ihrer Mitte "
    "steht ein Tisch, daneben ein umgefallener Sessel. Kreuz und "
    "quer verstreut liegen die unterschiedlichsten Werkzeuge, "
    "zerbrochene Gefaesse, und verblichenen Fetzen eines Buches. "
    "An der Westwand befindet sich noch ein alter Kamin, neben ihm eine "
    "Kiste mit Torfstuecken. Dunkler Staub hat hier schon alles "
    "fuer sich vereinamt, und unter einer dicken Schicht begraben. ");
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddExit( "osten", ANSCHLUSS_POLARIS );

  AddRoomMessage( ({
    "Hatschiii!!! Aufgrund des vielen Staubs musst Du niesen.\n",
    "Hust! Hust! Hier liegt wirklich sehr viel Staub!\n",
    "*krrkkk* *raschel*\n" }), 30  );

  AddCmd( ({ "kletter", "klettre", "klettere" }), "c_klettern");

// DETAILBEGINN

  AddDetail( ({ "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "huette" }),
    "Die Huette scheint ziemlich abrupt verlassen worden zu sein. Anders "
    "kannst Du Dir das hier herrschende Chaos nicht erklaeren. ");

  AddDetail( ({ "chaos" }),
    "Ueberall hier herrscht Chaos. Umgefallene Moebel, zerbrochene Gefaesse, "
    "Papierfetzen und Dinge liegen zerstreut am Boden. ");

  AddDetail( ({ "boden" }),
    "Ueber dem ganzen Chaos was am Boden liegt, den Moebeln, den Gefaessen, "
    "... hat sich bereits eine dicke Staubschicht gebildet. ");

  AddDetail( ({ "staubschicht", "schicht", "staub" }),
    "Fast alles hier wurde unter einer dunklen dicken Staubschicht begraben. "
    "Igitt! Ekelig! ");

  AddDetail( ({ "kamin" }),
    "An der Westwand steht noch der alte Kamin, mit dem frueher hier "
    "geheizt wurde. Er besteht aus Backsteinen. Dort wo man einst "
    "das Brennmaterial hingelegt hatte um Feuer zu machen siehst Du nur ein "
    "Haeufchen Asche. ");

  AddDetail( ({ "haeufchen", "asche" }),
    "Im Kamin ist nur mehr ein Haeufchen Asche zu sehen. Doch halt! Was ist "
    "das fuer ein seltsames Muster in der Asche?!");

  AddDetail( ({ "muster" }),
    "Das solltest Du mal naeher betrachten. ");

  AddDetail( ({ "spuren" }),
    "Es scheint als wuerden sie in den Kamin fuehren...");

  AddCmd( ({ "betracht", "betrachte" }), "c_betrachten");

 

}

int c_betrachten( string str)
{
 if( str != "muster" )
 {
  notify_fail("Was moechtest Du betrachten?\n");
  return 0;
 }
 else
 {
  write(BS("Huch, da sind ja seltsame Spuren..."));
  return 1;
 }
}


int c_klettern(string str)
{
  if( str != "in kamin")
  {
	notify_fail("Wohin moechtest Du klettern?\n");
	return 0;
  }
  else
  {
	write(BS("Muehsam zwaengst Du Dich in den Kamin.")+"\n"+BS(
		  "Huch, verdammt! Da ist ja ein Loch!")+"\n"+BS(
		  "Du faellst...und faellst...und faellst...") +"\n"+BS(
		  "PLUUUUUUUUUUUUUUUUMPS! Du landest unsanft.") +"\n" );
	this_player()->move(ROOM "room_e7", M_GO,
		         "wohin", "kriecht", "faellt herein");
    return 1;
  }
}

