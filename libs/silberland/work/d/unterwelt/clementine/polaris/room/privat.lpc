  AddDetail( ({ "zimmer" }),
    "Es gehoert Hyrokkin. ");

// DETAILENDE


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Es riecht hier nach Kraeutern. ");

  AddSmell( ({ "kraeuter" }),
    "Danach riecht es hier. ");


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Hier ist es absolut ruhig. ");


  AddCmd( ({ "setz", "sitz", "sitze", "setze" }), "c_setzen");
  AddCmd( ({ "kuschel", "kuschle", "kuschl" }), "c_kuscheln" );
  AddCmd( ({ "stoeber", "stoebere" }), "c_stoebern" );
  AddCmd( ({ "oeffne" }), "c_oeffnen" );
     

}

int c_setzen(string str)
{
  if(str != "auf stuhl"       &&
	 str != "auf stuhl drauf"  )
  {
	notify_fail("Worauf moechtest Du Dich setzen?\n");
	return 0;
  }
  else
  {
	write(BS("Der Stuhl ist so hart, dass Dir sofort Dein Popo weh tut, "
		  "und Du wieder aufstehst."));
	say(CTPN + " reibt sich den Popo.\n");
	return 1;
  }
}


int c_oeffnen(string str)
{
  object ob;
 if( str != "fenster"       && 
     str != "kasten"        &&
     str != "fluegeltueren" &&
     str != "tueren"        )
 {
   notify_fail("Was moechtest Du oeffnen?\n");
   return 0;
 }
 
 if(str == "fenster")
 {
  write(BS("Du oeffnest das Fenster, doch ein Windstoss schliesst "
           "es sofort wieder. "));
  say(CTPN+ " oeffnet das Fenster.\n");
  return 1;
 }
 
 if( str == "kasten"         ||
     str == "fluegeltueren"  ||
     str == "tueren"         )
 {
  if( anz_puppe < 1)
  {
   write(BS("Du oeffnest den Kasten, findest aber nichts. "
            "Gelangweilt schliesst Du ihn wieder. "));
   return 1;
  }
  else
  {
   write(BS("Du oeffnest den Kasten und findest einen Gegenstand, den "
            "Du sofort einsteckst."));

	ob = clone_object(OBJ ("voodoo.lpc") );
	if (ob->move(this_player(), M_GET) != 1)
   {
     tell_object(this_player(), "Du kannst nicht soviel tragen!\n");
     ob->move(this_object(), M_NOCHECK);
   }
   anz_puppe--;
   return 1;
  }
 }
}

int c_stoebern( string str )
{
 if( str != "in sachen" )
 {
  notify_fail("Worin moechtest Du stoebern?\n");
  return 0;
 }
 if( str == "in sachen" )
 {
  write(BS("Du blickst Dich vorsichtig um, ob eh niemand hier ist, "
           "der Dich beobachtet. Dann beginnst Du ploetzlich wie ein "
           "Wahnsinniger in Hyrokkins Sachen zu stoebern. Finden tust "
           "Du aber leider nichts. "));
  return 1;
 }
}

int c_kuscheln( string str )
{
 if( str != "in polster"        &&
     str != "in polster hinein" &&
     str != "an polster"        &&
     str != "in bett"           )
 {
  notify_fail("Woran oder worein moechtest Du Dich kuscheln?\n");
  return 0;
 }
 if( str == "an polster"         ||
     str == "in polster hinein"  ||
     str == "in polster"         )
 {
  write(BS("Du kuschelst Dich sanft in einen Polster hinein. "
           "Am liebsten wuerdest Du nie wieder aufstehen so flauschig "
           "ist er...Doch was ist das? Da steht doch ein Zettel hervor! "));
  return 1;
 }
 if( str == "in bett" )
 {
  write(BS("Du machst es Dir in diesem wundervollen weichen Bett "
           "gemuetlich. Bevor Du wieder aufstehst streckst Du noch "
           "einmal Deine Fuesse lang. "));
  return 1;
 }
}


  
  
