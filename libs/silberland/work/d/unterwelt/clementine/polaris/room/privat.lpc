inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../marisol.h"
#include <moving.h>

int anz_puppe;

reset()
{
  ::reset();
  anz_puppe = 1;
}

create()
{
  ::create();
  
  anz_puppe = 1;
  SetProp(P_INT_SHORT, "In einem Zimmer");
  SetProp(P_INT_LONG, 
     "Du stehst in Hyrokkins privatem Raum. Er befindet sich genau "
     "ueber ihrem Laden. An der Ostwand kannst Du ein Fenster erkennen, "
     "vor dem ein Tisch mit einem Sessel steht. An der Nordwand befindet "
     "sich ein kleines Bett. Daneben steht ein kleines Tischchen auf dem "
     "einige Buecher liegen. An der Westwand befindet sich ausserdem "
     "ein grosser Kasten. Einige Regale bekleiden die Waende. "
     "In der Mitte des Zimmers liegt ein grosser runder Teppich. Durch "
     "ein Loch bei der Suedwand fuehrt eine Treppe nach unten. "); 

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN:TT_HOUSE]) );

  AddExit( "unten", ROOM ("huette3") );


