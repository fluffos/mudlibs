  AddDetail( ({ "blumen" }),
    "In der Vase sind keine Blumen! ");

  AddDetail( ({ "wasser" }),
    "Die Vase ist mit frischem Wasser gefuellt. ");

  AddDetail( ({ "treppe" }),
