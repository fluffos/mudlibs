  AddDetail( ({ "regale" }),
    "In den Regalen befinden sich einige Flaeschchen und Dosen. ");

  AddDetail( ({ "flaeschchen" }),
    "Hyrokkin braucht sie sicher zum Mixen von Traenken und Tinkturen. ");

  AddDetail( ({ "mixen" }),
