  AddDetail( ({ "buch" }),
    "Welches Buch meinst Du denn genau? ");

  AddDetail( ({ "blaues buch" }),
    "Das blaues Buch traegt eine blaue Aufschrift. ");

  AddDetail( ({ "aufschrift" }),
    "Welche Aufschrift meinst Du denn? ");

  AddDetail( ({ "blaue aufschrift" }),
    "              --Buchhaltung--                \n"
    "steht mit grossen Buchstaben dort geschrieben. ");

  AddDetail( ({ "buchstaben" }),
    "Davon gibt es hier viele. ");

  AddDetail( ({ "gelbes buch" }),
    "Das gelbe Buch traegt einen sehr sonderbaren Titel. ");

  AddDetail( ({ "titel" }),
    "        --Wie schuetzt man sich gegen Zauber--      \n"
    "Scheint wohl nicht unbedingt eine Bettlektuere zu sein. ");

  AddDetail( ({ "bettlektuere" }),
    "Das gelbe Buch fordert bestimmt Konzentration beim Lesen. ");

  AddDetail( ({ "lesen" }),
    "Hyrokkin liest wohl sehr gerne. ");

  AddDetail( ({ "konzentration" }),
