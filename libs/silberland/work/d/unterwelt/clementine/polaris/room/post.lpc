inherit "std/post";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einer Postzentrale" );
  SetProp(P_INT_LONG,
     "Du befindest Dich hier im Postamt von Polaris. "
     "Alles hier wurde mit gelber Farbe ausgemalt wie es "
     "fuer Postzentralen ueblich ist. "
     "An einer Wand siehst Du einen Schalter bei dem man wohl "
     "Briefe und Pakete aufgeben kann. "
     "Wie in jeder anderen Post kannst Du hier Briefe lesen und "
     "schreiben. Wenn Du Post lesen oder schreiben willst, tippe "
     "'post' oder 'mail', bzw. 'mail <spielername>'. ");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) ); 
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);

  AddExit( "norden", ROOM ("room8") );


// DETAILBEGINN

  AddDetail( ({ "postamt", "post" }),
     "Du befindest Dich in der Post von Polaris. Hier kannst Du "
     "Deinen Mitspielern Briefe schreiben oder auch empfangene "
     "Briefe lesen. ");

  AddDetail( ({ "postzentrale", "postzentralen" }),
     "Die Postzentralen sind normalerweise gelb gestrichen, damit "
     "man sie auch schon aus der Ferne erkennen kann. ");

  AddDetail( ({ "ferne" }),
     "Dieses Postgelb kann man schon von weit her erkennen. ");

  AddDetail( ({ "postgelb", "gelb" }),
     "Es ist einfach nur einzigartig. Jeder weiss, dass so ein Gelb nur "
     "zu einer Post gehoeren kann. ");

  AddDetail( ({ "farbe" }),
     "Die Post wurde absichtlich mit gelber Farbe gestrichen, damit man "
     "sie schon aus grosser Entfernung erkennen kann. ");

  AddDetail( ({ "entfernung" }),
     "Stell Dir vor: Du einsam und verlassen in einem "
     "Birkenwaeldchen, ganz durchnaesst vom Regen, kein Unterschlupf "
     "der sich findet, DOCH DA ! Ein gelbes Leuchten ! Eine Post ! Und "
     "Du bist gerettet. ");

  AddDetail( ({ "leuchten" }),
     "Dieses Gelb siehst Du auch noch vom Mond. ");

  AddDetail( ({ "mond" }),
     "Im Augenblick kannst Du keinen sehen. ");

  AddDetail( ({ "augenblick" }),
     "Schon vorbei. ");

  AddDetail( ({ "birkenwaeldchen", "waeldchen" }),
     "Im Nordwesten wirst Du sicher fuendig. ");

  AddDetail( ({ "nordwesten" }),
     "Suchen musst Du schon alleine. ");

  AddDetail( ({ "regen", "unterschlupf" }),
     "Bei starkem Regen ist es immer ratsam einen Unterschlupf zu suchen. ");

  AddDetail( ({ "schalter" }),
     "An einer Wand kannst Du einen Schalter erkennen, bei dem man wohl "
     "Briefe und Pakete aufgeben kann. Daneben haengt ein Schild. ");

  AddDetail( ({ "schild" }),
     "Du kannst es lesen! ");

  AddDetail( ({ "briefe", "pakete" }),
     "Du koenntest ja mal versuchen welche aufzugeben. ");

  AddDetail( ({ "mitspieler", "spieler" }),
     "Tipp doch einfach: 'kwer' oder 'fwer' ");

  AddDetail( ({ "boden" }),
     "Du stehst auf einem einfachen Lehmboden. ");

  AddDetail( ({ "lehmboden" }),
     "Der Boden besteht vollstaendig aus Lehm, aber da alles hier "
     "ueberdacht ist, brauchst Du Dir keine Sorgen bei Regen machen. ");

  AddDetail( ({ "lehm", "matsch", "gatsch" }),
     "Lehm ist ein anderes Wort fuer Gatsch bzw. Matsch. ");

  AddDetail( ({ "wort" }),
     "Schick Clementine doch einfach ein Mail dann kannst Du mehrere "
     "Woerter aneinander reihen und testen. ");

  AddDetail( ({ "woerter" }),
     "Manchmal ergeben mehrere Woerter aneinandergereiht etwas "
     "Sinnvolles. ");

  AddDetail( ({ "sinnvolles" }),
     "Dein Script funktioniert anscheinend gut. ");

  AddDetail( ({ "script" }),
     "Hoffentlich hast Du keines, denn dieser Raum wird geloggt. ");
  
  AddDetail( ({ "raum" }),
     "Blick Dich einfach in Ruhe hier um. ");

  AddDetail( ({ "ruhe", "hektik" }),
      "Keine Hektik hier bist Du sicher. ");

  AddDetail( ({ "clementine", "magierin" }),
      "Clementine ist die Magierin, die alles hier verbrochen hat. ");

  AddDetail( ({ "mail" }),
      "Wenn Du eines schreiben willst dann tippe einfach nur: 'mail' ");

  AddDetail( ({ "polaris" }),
      "Du befindest Dich mitten in Polaris. Es wirkt alles sehr verlassen "
      "hier aber lass Dich nicht taeuschen. ");

  AddDetail( ({ "waende" }),
      "Die Waende bestehen aus Holz und wurden alle gelb gestrichen. ");

  AddDetail( ({ "holz", "birkenholz" }),
      "Birkenholz um es genauer auszudruecken. Es stammt sicherlich von dem "
      "Waeldchen im Nordwesten. ");

  AddDetail( ({ "sorgen" }),
      "Hast Du denn welche?");

  AddDetail( ({ "wand" }),
      "An einer der gelben Waende kannst Du einen Schalter erkennen. ");

  AddDetail( ({ "decke", "holzdecke" }),
      "Eine Holzdecke schuetzt vor eventuellem Regen. Seltsamerweise "
      "haengt hier ein Leuchter mit fuenf Fackeln. ");

  AddDetail( ({ "leuchter" }),
      "Der Leuchter baumelt von der Decke. In ihm sind fuenf Fackeln, die "
      "dazu dienen den Raum zu erhellen. ");

  AddDetail( ({ "fackeln" }),
      "Fuenf Fackeln stecken im Leuchter, und erhellen den Raum. Doch halt "
      "eine brennt ja gar nicht! ");

  AddDetail( ({ "fackel" }),
      "Eine Fackel brennt tatsaechlich nicht mehr. Vielleicht sollte man "
      "sie wieder anzuenden. ");

  AddDetail( ({ "raum" }),
      "Du stehst im Postamt von Polaris. ");

// DETAILENDE


// SMELLS

  AddSmell(DEFAULT_SMELL,
      "Hier riecht es einfach nach Post. ");

  AddSmell( ({ "post" }),
      "Es riecht nach Briefen und Paketen. ");

  AddSmell( ({ "briefe" }),
      "Einfach nur papierig. ");

  AddSmell( ({ "pakete" }),
      "Sie riechen nach Pappe. ");

  AddSmell( ({ "pappe" }),
      "Pappig. ");


// SOUNDS

  AddSound(DEFAULT_SOUND,
      "Hier ist es absolut ruhig, Du kannst in Ruhe Deine Post lesen. ");

  AddSound( ({ "ruhe" }),
      "Es ist absolut still hier. ");

  AddSound( ({ "post" }),
      "Deine Post macht keine Geraeusche. ");

  AddSound( ({ "geraeusche" }),
      "Keine zu hoeren. ");

  AddReadDetail( ({ "schild" }),
     "Wenn Du an diesem Schalter Briefe oder Pakete aufgeben moechtest, "
     "so tipp einfach: aufgebe <name> ");

  AddCmd( ({ "schaukel", "schaukle", "schaukl" }), "c_schaukeln");
  AddCmd( ({ "zuende", "zuend" }), "c_zuenden");
  AddCmd( ({ "aufgeben", "aufgebe" }), "c_aufgeben");

}


c_aufgeben( string str )
{
 if( str != "paket" && str != "brief")
 {
  notify_fail("Was moechtest Du aufgeben?\n");
  return 0;
 }
 else 
 {
  write("Du gehst naeher zu dem Schalter ran und versuchst das Ding "
        "aufzugeben.\n"
        "Auf einmal hallt eine Stimme von irgendwoher:\n"
        "ICH BIN IN PAUSE !!! EINE FRECHHEIT MICH ZU STOEREN !!!\n"
        "Du denkst Dir . o O (oops, lieber schnell weg von hier)\n");
   say(CTPN+ " wird von einer lauten Stimme angeschriehen.\n");
   return 1;
   }
}

c_zuenden( string str )
{
 if( str != "fackel an")
 {
  notify_fail("Was moechtest Du hier anzuenden?\n");
  return 0;
 }
 else
 {
  write(BS("Du versuchst mit aller Muehe die Fackel anzuzuenden, "
           "scheiterst aber. Anscheinend ist sie schon zu sehr "
           "abgebrannt. "));
  return 1;
  }
}

c_schaukeln( string str )
{
 if(str != "mit leuchter" && str != "auf leuchter")
 {
  notify_fail("Womit moechtest Du schaukeln?\n");
  return 0;
 }
 else 
 {
  write(BS("Du springst mit aller Kraft hoch und schaffst es, Dich an dem "
           "Leuchter festzuhalten. Einige Zeit schaukelst Du "
           "genuesslich dahin, "
           "doch auf einmal macht es <RUMMS> und Du landest auf Deinen "
           "vier Buchstaben...Da hat Dich wohl Deine Kraft verlassen.\n"));
  say(CTPN+ " blickt auf Dich von oben herab und lacht laut.\n");
  return 1;
 }
} 

     


