  AddCmd( ({ "trink", "trinke" }), "c_trinken");
  AddCmd( ({ "schliesse", "schliess" }), "c_schliessen");
  AddCmd( ({ "lasse", "lass" }), "c_lassen" );
  
}

int c_pfluecken( string str )
{
 object ob;

 if( str != "gaensebluemchen" && 
     str != "weisses bluemchen" )
 {
  notify_fail("Was moechtest Du pfluecken?\n");
  return 0;
 }
 else
 {
  if( anz_bluemchen < 1 )
  {
   write(BS("Du traust Dich nicht ein Gaensebluemchen zu pfluecken. "
            "Vielleicht solltest Du spaeter hier wieder vorbeikommen. "));
   return 1;
  }
  else
  {
   write(BS("Sorgfaeltig pflueckst Du ein kleines Gaensebluemchen und "
            "freust Dich. "));
   
   ob = clone_object("/d/kristallwald/sargola/lichtung/obj/gaensebluemchen");
   if(ob->move(this_player(), M_GET) != 1)
   {
    tell_object(this_player(), "Das kannst Du nicht mehr tragen!\n");
    ob->move(this_object(), M_NOCHECK);
   }
   anz_bluemchen--;
   return 1;
  }
 }
}



int c_zwaengen( string str )
{
 if(str != "durch unterholz" &&
    str != "unterholz"       )
 {
  notify_fail("Wodurch moechtest Du Dich zwaengen?\n");
  return 0;
 }
 else
 {
  write(BS("Bei Deinem Versuch Dich durchs Unterholz zu zwaengen, ziehst "
           "Du Dir viele Schrammen zu. "));
  TP->do_damage(30+random(10), this_object());
  return 1;
 }
}
 

int c_suchen(string str )
{
 if( str != "moeglichkeit" )
 {
  notify_fail("Du suchst, findest aber nichts.\n");
  return 0;
  }
 else
 {
  write(BS("Du suchst verzweifelt nach einer Moeglichkeit das "
           "kleine Waeldchen zu durchqueren. Scheiterst aber an dem "
           "dichten Unterholz. "));
  return 1;
 }
}
  

string brunnen()
{
 string str;
 str="Ein kleiner Steinbrunnen befindet sich hier. Er scheint "
     "randvoll mit Wasser gefuellt zu sein. Ueber dem Brunnen "
     "wurde ein Gestell angebracht. ";
 if (wo==1)
 return BS(str+"Ein Seil haengt tief in den Brunnen hinein.");
 return BS(str+"Ein kleiner Eimer haengt an einem Seil dran. ");
}


string eimer()
{
 string str;
 str="Ein kleiner Eimer aus Blech, der an einem Seil angebunden ist. ";
 if (wo==1)
   return BS(str+"Der Eimer ist zu weit unten, "
                 "als das Du etwas genauer erkennen "
                 "koenntest.");
  if (wasser==0)
    return BS(str+"Der Eimer ist leer.");
  return BS(str+"Der Eimer ist voller frischem Wasser.");
}

int c_lassen(string str )
{
 notify_fail("Der Eimer ist doch noch unterwegs!\n");
 if(unterwegs != 0) return 0;
 notify_fail("Was moechtest Du hier genau machen?\n");
 if( str == "eimer hinunter" ||
     str == "eimer herab"    ||
     str == "eimer hinab"    ||
     str == "eimer runter"   )
 {
  if( wo==1)
  {
  write("Aber der Eimer ist doch schon unten!\n");
  return 1;
  }
  if(wasser == 1)
  {
  write("Aber der Eimer ist doch schon randvoll mit Wasser gefuellt!\n");
  return 1;
  }
 write(BS("Vorsichtig laesst Du den Eimer nach unten. "));
 say(CTPN+ " laesst vorsichtig den Eimer nach unten.\n");
 unterwegs=1;
 wo=1;
 call_out("runter1",5);
 return 1;
 }
 
 if( str == "eimer hinauf" ||
     str == "eimer rauf"   ||
     str == "eimer herauf" )
 {
  if (wo==0) 
   {
     write("Aber der Eimer ist doch schon oben.\n");
     return 1;
   }
    write(BS("Vorsichtig ziehst Du den Eimer nach oben. "));
    say(CTPN+ " zieht vorsichtig den Eimer nach oben.\n");
    unterwegs=1;
    wo=0;
    call_out("rauf1",5);
    return 1;
  } 
 return 0;
}

void runter1() {
tell_room(ME,
    BS("Der Eimer platscht in das Wasser und fuellt sich.\n"));
    call_out("runter2",5);
}

void runter2() {
  tell_room(ME,
    BS("Mit einem lauten Glucksen hat sich der Eimer jetzt mit Wasser "
       "gefuellt.\n"));
  unterwegs=0;
  wasser=1;
}

void rauf1() {
  tell_room(ME,
    BS("Der Eimer gleitet weiter nach oben.\n"));
  call_out("rauf2",5);
}

void rauf2() {
  tell_room(ME,
    BS("Der Eimer ist jetzt ganz oben angekommen.\n"));
  unterwegs=0;
  anzahl--;
  if (anzahl < 0) {
    wasser=0;
    tell_room(ME,
      BS("Leider ist auf dem Weg nach oben das ganze Wasser entwichen.\n"));
  }
}


int c_schliessen( string str )
{
 if( str != "augen" )
 {
  notify_fail("Was moechtest Du schliessen?\n");
  return 0;
 }
 if( str == "augen" )
 {
  write(BS("Du schliesst Deine Augen damit die Sonne keine "
           "Chance hat Deine Netzhaut zu zerstoeren. Nach einiger "
           "Zeit oeffnest Du sie wieder. "));
  return 1;
 }
}


int c_trinken(string str )
{
 notify_fail("Was moechtest Du trinken?\n");
 if(str != "wasser"           &&
    str != "wasser aus eimer" &&
    str != "aus eimer"        )
 {
  return 0;
 }
 if(unterwegs==1)
 {
  write(BS("Aber der Eimer ist doch noch unterwegs!"));
  return 1;
 }
 if(wo==1)
 {
  write(BS("Aber der Eimer ist doch noch viel zu weit unten! "));
  return 1;
 }
 if(wasser==0)
 {
  write(BS("Aber in dem Eimer ist doch gar kein Wasser! "));
  return 1;
 }
 wasser=0;
 TP->heal_self(30+random(40));
 write(BS("Du trinkst den Eimer komplett leer und fuehlst Dich sofort "
          "erfrischt. "));
 say(CTPN+ " trinkt den Eimer vollstaendig leer.\n");
 return 1;
 
}

