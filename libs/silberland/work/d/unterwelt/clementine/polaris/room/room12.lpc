// NETTER RAUM MIT BRUNNEN !!!!
// ADDSPECIALDETAILS MIT SEIL bei BRUNNEN 

inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include "../marisol.h"

int wo,wasser,anzahl,unterwegs;
int anz_bluemchen;

reset() {
  ::reset();
  anz_bluemchen = 1;
  anzahl=3+random(2);
}


create()
{
  ::create();

  wo=0;
  wasser=0;
  unterwegs=0;
  anzahl=3;
  anz_bluemchen=1;

  SetProp(P_INT_SHORT, "In Polaris" );
  SetProp(P_INT_LONG, 
     "Im Norden breitet sich ein kleines Waeldchen aus. "
     "Die Baeume sind dicht "
     "gedraengt, sodass Du keine Moeglichkeit siehst "
     "nach Norden vorzudringen. "
     "Im Westen befindet sich eine einfache "
     "Holzhuette ueber deren Eingang ein "
     "Schild haengt. Wie ueberall in Polaris "
     "besteht auch der Weg hier aus Lehm. "
     "Am Wegrand wachsen vereinzelt einige "
     "Graeser, auch ein paar Blumen kannst Du "
     "erkennen. Ein kleiner Brunnen befindet sich oestlich von Dir. ");
  SetProp(P_INDOORS, 0);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_KILL_NAME, "Clementine's Rache" );
  SetProp(P_KILL_MSG, "Wer nicht lesen will der STIRBT!!!");

  AddExit( "sueden", ROOM ("room11") );
  AddExit( "westen", ROOM ("huette3") );


