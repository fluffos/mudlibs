  AddDetail( ({ "tier" }),
    "Wo ist denn eines? ");

  AddDetail( ({ "waeldchen" }),
    "Es breitet sich im Norden aus. Die Baeume sind leider viel zu "
    "dicht gedraengt, sodass es keine Moeglichkeit gibt in den Wald "
    "vorzudringen. ");

  AddDetail( ({ "wald" }),
    "Er besteht aus hohen Birken und breitet sich vor Dir im Norden aus. ");

  AddDetail( ({ "moeglichkeit" }),
    "Siehst Du keine, oder doch? ");

  AddDetail( ({ "unterholz" }),
    "Das Unterholz ist zu dicht, um sich durchzuzwaengen. ");

  AddDetail( ({ "kennerblick" }),
    "Der laesst Dich nie im Stich. ");

  AddDetail( ({ "stich" }),
