  AddDetail( ({ "baeume" }),
    "Alles Birken. ");

  AddDetail( ({ "baum" }),
    "Meinst Du einen Bestimmten? ");

  AddDetail( ({ "bestimmten" }),
    "Welchen? ");

  AddDetail( ({ "blech" }),
    "Das Blech des Eimers erfuellt seinen Zweck. ");

  AddDetail( ({ "zweck" }),
    "Der Eimer transportiert das Wasser! ");

// DETAILENDE


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Im Brunnen schwappt das Wasser leise gegen die Steinwaende und "
    "erzeugt ein friedliches Plaetschern. Ein Summen kannst Du "
    "deutlich hoeren. ");

  AddSound( ({ "summen" }),
    "Es stammt wohl von den Bienen die auf der Suche nach Nektar sind. ");

  AddSound( ({ "bienen" }),
    "*summmmm* *summmmm* ");

  AddSound( ({ "plaetschern" }),
    "Das Brunnenwasser schwappt gleichmaessig gegen die Innenwaende des "
    "Brunnens. ");

  AddSound( ({ "wasser", "brunnenwasser" }),
    "*platsch* ");
  
  AddSound( ({ "steinwaende", "innenwaende", "nektar", "suche" }),
    "Dem kannst Du nicht lauschen. ");

  AddSound( ({ "brunnen", "brunnens" }),
    "Du beugst Dich ueber den Brunnen und hoerst nun deutlich ein "
    "Plaetschern. ");


// SMELLS

  AddSmell(DEFAULT_SMELL,
    "Es riecht nach verschiedenen Blumen. Vom Westen her weht ein "
    "leichtes Lueftchen und Du glaubst Feuer vermischt mit Essen "
    "zu riechen. ");

  AddSmell( ({ "blumen" }),
    "Sie duften herrlich. ");

  AddSmell( ({ "feuer" }),
    "Es scheint aus der Huette zu kommmen. ");

  AddSmell( ({ "huette" }),
    "Sie riecht nach Holz. ");

  AddSmell( ({ "holz", "birkenholz" }),
    "Birkenholz. ");

  AddSmell( ({ "westen" }),
    "Aus dem Westen vernimmst Du den Geruch von Feuer und Essen. ");

  AddSmell( ({ "essen" }),
    "Vielleicht wird dort gerade etwas gekocht. ");

  AddSmell( ({ "lueftchen" }),
    "Es riecht frisch und bringt den Geruch von Essen mit. ");

  AddSmell( ({ "geruch" }),
    "Der Geruch von Feuer vermischt mit Essen flitzt in Deine Nase. ");

  AddSmell( ({ "nase" }),
