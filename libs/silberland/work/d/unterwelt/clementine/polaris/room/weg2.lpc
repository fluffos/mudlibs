inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{

  ::create();

  SetProp(P_INT_SHORT, "Auf einem Ast");
  SetProp(P_INT_LONG, 
     "bla"); 
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 0 );
  
  AddCmd( ({ "kraxel", "kraxl", "kraxle" }), "c_kraxeln" );
  AddCmd( ({ "schwinge", "schwing" }), "c_schwingen" );

}

int c_kraxeln(string str )
{
 if( str != "runter"   &&
     str != "hinunter" )
 {
  notify_fail("Wohin moechtest Du kraxeln?\n");
  return 0;
 }
 if( str == "runter"   ||
     str == "hinunter" )
 {
  write(BS("Vorsichtig kraxelst Du wieder hinunter. "));
  TP->move(ROOM ("weg1"), M_TPORT | M_NOCHECK,
  "hinunter", "kraxelt", "faellt herein" );
  return 1;
 }
}

int c_schwingen( string str )
{
 if( str != "mit liane zu baum"            &&
     str != "mit liane zum baum"           &&
     str != "mit liane zum naechsten baum" )
 {
  notify_fail("Womit und wohin moechtest Du schwingen?\n");
  return 0;
 }
 if( str == "mit liane zu baum"            ||
     str == "mit liane zum baum"           ||
     str == "mit liane zum naechsten baum" )
 {
  write(BS("Du schnappst Dir die Liane und schwingst mit ihr "
           "zum naechsten Baum. Als Du Halt unter Deinen Fuessen "
           "spuerst laesst Du die Liane los und sie schwingt "
           "von selbst zurueck. "));
  TP->move(ROOM ("weg3"), M_TPORT | M_NOCHECK,
  "irgendwohin", "verschwindet", "ist auf einmal da" );
  return 1;
 }
}

