inherit "std/laden";

#include <properties.h>
#include <language.h>
#include "../marisol.h"
#include <laden.h>
#include <moving.h>

int sell;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Holzhuette" );
  SetProp(P_INT_LONG,
     "Du stehst im Hexenladen von Polaris. Die Waende "
     "sind fast alle mit Regalen zugemauert, in denen sich verschiedene "
     "Kraeuter und Flaeschchen befinden. Hinter der Budel erkennst "
     "Du eine Treppe die nach oben fuehrt. Anscheinend befinden "
     "sich dort die privaten Raeume von Hyrokkin, der Besitzerin. "
     "An der Ostwand kannst Du eine kleine Feuerstelle erkennen "
     "ueber der ein Kessel haengt. Neben dem Eingang haengt eine "
     "Tafel, die Du lesen solltest. ");
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_HOUSE]) );
  
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "hyrokkin");
  SetProp(P_SHOPKEEPER_NAME, "Hyrokkin");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
 
  SetStorageRoom(ROOM ("liste.lpc") );
 
  AddExit( "osten", ROOM ("room12") );

  AddItem(NPC ("hyrokkin"), REFRESH_DESTRUCT);

 
// DETAILBEGINN
 
  AddDetail( ({ "treppe" }),
     "Eine hoelzerne Treppe kannst Du hinter der Budel erkennen. "
     "Sie fuehrt wahrscheinlich in die privaten Raeume von "
     "Hyrokkin. ");

  AddDetail( ({ "raeume" }),
     "Die befinden sich wohl ueber dem Laden. Eine Treppe fuehrt dort "
     "hinauf. Sie ist sehr steil. Nur mit Muehe wirst Du da hinaufkommen. ");

  AddDetail( ({ "muehe" }),
     "Einige Muehe wird Dich das Hinaufkraxeln sicherlich kosten. ");

  AddDetail( ({ "hinaufkraxeln" }),
     "Das wird Dich sicher etwas Muehe kosten. Aber ohne Fleiss kein "
     "Preis. ");

  AddDetail( ({ "fleiss" }),
     "Wer fleissig forscht, wird sicher noch eine Belohnung bekommen. ");

  AddDetail( ({ "belohnung" }),
     "Wie waere es mit einem heissbegehrten Forscherpunkt?");

  AddDetail( ({ "forscherpunkt" }),
     "Fleissig forschen, dann bekommst Du vielleicht einen. ");

  AddDetail( ({ "preis" }),
     "Forschen zahlt sich immer aus! ");

  AddDetail( ({ "besitzerin" }),
     "Hyrokkin ist die Besitzerin dieses Ladens. Sie scheint schon "
     "seit einer halben Ewigkeit hier zu leben. ");

  AddDetail( ({ "ewigkeit" }),
     "Sicherlich schon sehr sehr lange. ");

  AddDetail( ({ "budel" }),
     "Die Budel besteht aus Holz. Einige Kratzer kannst Du erkennen, die "
     "wohl von den Verkaufstaetigkeiten stammen. Normalerweise steht "
     "Hyrokkin hinter der Budel und verkauft Spielern wie Dir "
     "Waren. ");

  AddDetail( ({ "hyrokkin" }),
     "Sie scheint wohl gerade nicht hier zu sein. Gedulde Dich einfach "
     "ein wenig. ");

  AddDetail( ({ "waren" }),
     "Das Warenangebot kannst Du mit <zeige> lesen. ");

  AddDetail( ({ "warenangebot", "angebot" }),
     "Tipp doch einfach 'zeige' ein, dann siehst Du, was man hier "
     "alles kaufen kann. ");

  AddDetail( ({ "kratzer" }),
     "Hier haben wohl schon viele Gegenstaende ihren Besitzer "
     "gewechselt. Die Kratzer deutet eindeutig darauf hin. ");

  AddDetail( ({ "gegenstaende" }),
     "Du weisst leider nicht genau, welche Gegenstaende hier "
     "einmal ge- oder verkauft wurden. ");

  AddDetail( ({ "besitzer" }),
     "Bevor Du Dir zum Beispiel hier eine Hose kaufst, solltest Du "
     "gruendlich drueber nachdenken. Vielleicht war der Vorbesitzer "
     "ja ein stinkender Zwerg. ");

  AddDetail( ({ "zwerg" }),
     "Oder doch ein schmieriger Oger?");

  AddDetail( ({ "oger" }),
     "Koennte auch ein dummer Troll gewesen sein. ");

  AddDetail( ({ "vorbesitzer" }),
     "Man kann nie wissen. ");

  AddDetail( ({ "hose" }),
     "Das war nur ein Beispiel. ");

  AddDetail( ({ "beispiel" }),
     "Ein Beispiel damit Du mehr verstehst. ");

  AddDetail( ({ "troll" }),
     "Koennte natuerlich auch von einem haesslichen Dunkelelfen stammen. ");

  AddDetail( ({ "dunkelelf", "dunkelelfen" }),
     "Oder so einem hinterlistigen Elfen mit so spitzen Ohren?");

  AddDetail( ({ "ohren", "elfenohr" }),
     "So ein Elfenohr ist eine wahre Delikatesse. ");

  AddDetail( ({ "delikatesse" }),
     "Mjammm. ");

  AddDetail( ({ "elfen", "elf" }),
     "Natuerlich koennte die Hose auch von einem Menschen stammen. ");

  AddDetail( ({ "menschen", "mensch" }),
     "Die sind doch alle gleich, nicht wahr? ");

  AddDetail( ({ "decke" }),
     "Die Decke besteht aus Holz. Du kannst ein kleines Loch erkennen, "
     "durch das eine Treppe nach oben fuehrt. ");

  AddDetail( ({ "loch" }),
     "Eine kreisrunde Aushoehlung durch die eine Treppe in die oberen "
     "Raeumlichkeiten zu fuehren scheint. ");

  AddDetail( ({ "raeumlichkeiten" }),
     "Dort sind sicher Hyrokkins private Raeume. ");

  AddDetail( ({ "aushoehlung" }),
     "Ein stinknormales Loch, durch das eine Treppe fuehrt. ");

  AddDetail( ({ "wand" }),
     "Meinst Du eine bestimmte Wand? ");

  AddDetail( ({ "ostwand" }),
     "An der Ostwand befindet sich eine kleine Feuerstelle, ueber der "
     "ein Kessel an einem Metallgestell haengt. ");

  AddDetail( ({ "feuerstelle" }),
     "In der Feuerstelle befinden sich Kohlen. Rundherum wurden "
