       "*                                         *\n"
       "*******************************************\n");
     



// DETAILENDE


// SOUNDS

  AddSound(DEFAULT_SOUND,
     "Leise vergluehen die letzten Kohlen in der Feuerstelle. "
     "Manchmal weht eine leichte Brise durch den Laden und versorgt "
     "ihn so mit Frischluft. Ausserdem kannst Du manchmal Hyrokkins leises "
     "Murmeln verstehen. ");

  AddSound( ({ "kohlen" }),
     "Einige Kohlen knistern noch in der Feuerstelle. Sie werden wohl "
     "bald verglueht sein. ");

  AddSound( ({ "laden" }),
     "Nur manchmal kannst Du das Murmeln von Hyrokkin bemerken, oder einem "
     "leichten Windhauch. ");

  AddSound( ({ "brise", "windhauch" }),
     "Ein kuehles Lueftchen weht manchmal durch den Laden und versorgt "
     "ihn so mit etwas Frischluft. ");

  AddSound( ({ "frischluft", "luft" }),
     "Hoeren kannst Du sie nicht, aber vielleicht riechen. ");

  AddSound( ({ "murmeln" }),
     "Hyrokkin scheint beschaeftigt auf und ab zu gehen, und dabei "
     "leise vor sich hin zu murmeln. ");

  AddSound( ({ "feuerstelle" }),
     "In der Feuerstelle vergluehen die letzten Kohlen und erzeugen so ein "
     "leises Knistern. ");

  AddSound( ({ "knistern" }),
     "Das kommt eindeutig von den Kohlen, die in der Feuerstelle "
     "vergluehen. ");


// SMELLS

  AddSmell(DEFAULT_SMELL,
     "Es riecht nach verschiedenen Kraeutern und Blumen. Manchmal weht "
     "auch ein frisches Lueftchen durch den Laden. ");

  AddSmell( ({ "frischluft", "luft", "lueftchen" }),
     "Herrlich! Du laesst gierig die Luft in Deine Lungen stroemen. ");

  AddSmell( ({ "lungen" }),
     "Die fuehlen sich total erleichtert an. ");

  AddSmell( ({ "kraeuter" }),
     "Es riecht nach zuvielen verschiedenen Kraeutern, Du kannst "
     "sie leider nicht auseinander halten. ");

  AddSmell( ({ "ringelblume" }),
     "Die duftet herrlich. ");

  AddSmell( ({ "laden" }),
     "Im Laden riecht es vielen verschiedenen Kraeutern und Blumen. Du "
     "kannst auch noch den Geruch von Kohlen orten. ");

  AddSmell( ({ "kohlen", "geruch" }),
     "Der Geruch von Kohlen scheint von der Feuerstelle zu kommen. ");

  AddSmell( ({ "feuerstelle" }),
     "Kommt eindeutig aus dem Osten. ");

  AddSmell( ({ "osten" }),
     "Das geht nicht! ");

  AddSmell( ({ "blumen" }),
     "Sie duften einzigartig hier. Vielleicht solltest Du Dir ja welche "
     "kaufen und sie einer von Dir geliebten Person schenken. ");

  AddSmell( ({ "person" }),
     "An welcher Person moechtest Du denn riechen? ");

  
  AddCmd( ({ "kraxl", "kraxle", "kraxel" }), "c_kraxeln");    
  AddCmd( ({ "entziffer", "entziffere" }), "c_entziffern");

}

sell()
{
 notify_fail("Hyrokkin kauft nichts an!\n");
 return 0;
}
force_sell() { return sell(); }
evaluate()   { return sell(); }

int c_entziffern( string str )
{
 if( str != "etikett" )
 {
  notify_fail("Was moechtest Du entziffern?\n");
  return 0;
 }
 if( str == "etikett" )
 {
  write(BS("Du versuchst mit aller Kraft ein Etikett zu entziffern. "
           "Aber das einzige was Du lesen kannst, oder glaubst lesen "
           "zu koennen ist der Buchstabe C - hilft Dir nicht viel weiter "
           "oder?"));
  return 1;
 }
}


int c_kraxeln( string str )
{
 if( str != "nach oben" && str != "rauf" && str != "hinauf" ) 
     
     
 {
  notify_fail("Wohin moechtest Du kraxeln?\n");
  return 0;
 }
 if( str == "nach oben" ||
     str == "hinauf"    ||
     str == "rauf"      )
 {
  write(BS("Du kraxelst geschwind die Treppe hinauf.\n"));
  
  this_player()->move(ROOM  ("privat"), M_GO,
  "ueber eine Treppe", "geht", "kommt herauf" );
  return 1;
 }
}  
 



