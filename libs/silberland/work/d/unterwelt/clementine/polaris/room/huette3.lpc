  AddDetail( ({ "blume" }),
     "Hmm, der Form nach scheint es sich um eine Ringelblume zu "
     "handeln. ");

  AddDetail( ({ "ringelblume" }),
     "Wenn Du Dir nicht sicher bist solltest Du Hyrokkin einmal "
     "danach fragen. ");

  AddDetail( ({ "form" }),
     "Gruener Stengel und eine orange Bluete. ");

  AddDetail( ({ "stengel" }),
     "Der ist eindeutig gruen. ");

  AddDetail( ({ "bluete" }),
     "Die Bluete ist orange und besteht aus langen schmalen "
     "Bluetenblaettern. ");

  AddDetail( ({ "bluetenblaetter", "blaetter" }),
     "Die sind orange - eindeutig. ");
  
  AddDetail( ({ "c" }),
     "Copyrights by Clementine :) ");

  AddDetail( ({ "clementine" }),
     "Clementine ist eine furchtbar unfaehige Magierin. ");

  AddDetail( ({ "magierin" }),
     "Sie scheint wohl diesen Laden programmiert zu haben. ");

  AddDetail( ({ "copyrights" }),
     "Die gehoeren Clementine. ");

  AddDetail( ({ "tafel" }),
     "Du kannst sie lesen. ");

  AddDetail( ({ "schild" }),
     "Erst jetzt bemerkst Du ein etwas unscheinbares Schild. "
