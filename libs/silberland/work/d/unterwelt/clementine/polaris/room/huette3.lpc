  AddDetail( ({ "handarbeit" }),
     "Zwerge sind bekannt fuer ihre Handarbeit. ");

  AddDetail( ({ "zwerge" }),
     "Sie leben weiter im Norden. ");

  AddDetail( ({ "norden" }),
     "Da kommst Du von hieraus nicht hin. ");

  AddDetail( ({ "liebe" }),
