  AddDetail( ({ "sprache" }),
     "Leider kannst Du nicht einen einzigen Buchstaben entziffern. ");

  AddDetail( ({ "buchstaben", "buchstabe" }),
     "So sehr Du Dich auch bemuehst, aber Du kannst das wirklich nicht "
