     "Huette in Brand setzen. ");

  AddDetail( ({ "brand" }),
     "Ein Brand hier waere fuerchterlich. ");

  AddDetail( ({ "kohlen" }),
     "Schwarze Kohlen liegen in der Feuerstelle. Sie gluehen noch etwas. "
