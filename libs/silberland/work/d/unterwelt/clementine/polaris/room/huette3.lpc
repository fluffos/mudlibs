  AddDetail( ({ "trank" }),
     "Hyrokkin braut wohl oefters in diesem Kessel leckere "
     "Zaubertraenke. ");

  AddDetail( ({ "zaubertraenke" }),
     "Da musst Du schon die Hexe danach fragen. ");

  AddDetail( ({ "hexe" }),
     "Sie ist wohl gerade nicht hier. ");

  AddDetail( ({ "steine" }),
     "Steine wurden um die Feuerstelle angebracht, damit kein "
     "Funke auf die Holzwaende ueberschlagen kann. ");

  AddDetail( ({ "holzwaende" }),
     "Du vermutest, dass alle Waende hier aus Holz bestehen. ");

  AddDetail( ({ "funken", "funke" }),
     "Ein einziger Funke koennte die Huette sofort in Brand stecken. ");
 
  AddDetail( ({ "metallgestell", "gestell" }),
     "An einem Gestell ueber der Feuerstelle wurde ein Kessel "
     "befestigt. ");

  AddDetail( ({ "kessel" }),
     "Ein typischer Hexenkessel mit allem was dazugehoert. "
     "Er besteht aus Metall und baumelt an einem Gestell. "
