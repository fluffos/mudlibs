inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../marisol.h"
#include <moving.h>
#include "/gilden/bardengilde/barden_extern.h"

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Am Eingang einer Gruft" );
  SetProp(P_INT_LONG, 
     "Du befindest Dich am Eingang einer duesteren und anscheinend verlassenen "
     "Gruft. Der Hauch von Verwesung liegt in der Luft "
     "und ein kuehler Wind streift Dir ab und zu Deine Haare ins Gesicht. "
     "Um Dich herum ragen Grabsteine einsam gen Himmel. "
     "Spinnweben haben sich schon laengst auf ihnen angesammelt, alles "
     "wirkt verlassen und fahl. Die Farben Grau und Schwarz dominieren "
     "einfach alles hier, nicht mal Du in Deinem bunten Aufzug kannst "
     "daran etwas aendern. " );
  SetProp(P_LIGHT, 1);
  
  AddExit( "norden", ROOM ("room7") );

  AddItem( NPC ("larva"), REFRESH_DESTRUCT);


// DETAILBEGINN

  AddDetail( ({ "gruft" }),
     "Die Gruft befindet sich wohl unter Dir. Hier kannst Du nur eine "
     "Art Steinhaus erkennen, das wohl als Eingang zu dienen scheint. ");

  AddDetail( ({ "steinhaus", "haus" }),
     "Ein kleines Steinhaus scheint Dir die Moeglichkeit zu bieten, die "
     "Gruft zu betreten. Etwas verfallen und duester wirkt es, doch "
     "das liegt vermutlich auch an der Atmosphaere die es umgibt. Das "
     "Steinhaus besteht wie der Name schon sagt aus Steinen. Ausserdem "
     "kannst Du eine etwas verrostete Tuer erkennen. ");

  AddDetail( ({ "eingang" }),
     "Das Steinhaus scheint der Eingang zu der Gruft zu sein. ");

  AddDetail( ({ "moeglichkeit" }),
     "Das Haus bietet Dir die Moeglichkeit die Gruft zu betreten. ");

  AddDetail( ({ "steine", "steinen" }),
     "Das Steinhaus besteht fast komplett aus Steinen, wuerde "
     "es aus Holz bestehen wuerde es sicher Holzhaus heissen. ");

  AddDetail( ({ "holzhaus" }),
     "Ein Holzhaus besteht aus Holz. Hier kannst Du aber keines "
