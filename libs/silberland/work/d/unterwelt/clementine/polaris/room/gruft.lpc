  AddDetail( ({ "wochen" }),
     "Wochen vergehen oft wie im Flug...");

  AddDetail( ({ "jahre", "jahr" }),
     "Ein Jahr hat 365 Tage. ");

  AddDetail( ({ "tage", "tag" }),
     "Ein Tag hat 24 Stunden. ");    

  AddDetail( ({ "stunden", "stunde" }),
      "Eine Stunde hat 60 Minuten. ");

  AddDetail( ({ "minute", "minuten" }),
      "Eine Minute hat 60 Sekunden. ");

  AddDetail( ({ "sekunde", "sekunden" }),
      "Eine Sekunde hat 10 Zehntelsekunden. ");

  AddDetail( ({ "zehntelsekunden", "zehntelsekunde" }),
      "Eine Zehntelsekunde hat 10 Hundertstelsekunden. ");

  AddDetail( ({ "hundertstelsekunden", "hundertstelsekunde" }),
