  AddDetail( ({ "regen" }),
      "Noch regnet es nicht, aber alles deutet darauf hin. ");

  AddDetail( ({ "flug" }),
      "Im wiegenden Tanz verfliegt die Schwere der Welt, drum dreht euch "
      "und lacht solang es gefaellt! ");

  AddDetail( ({ "tanz", "schwere", "welt" }),
      "Das war bloss ein Zitat. ");

  AddDetail( ({ "zitat" }),
      "Zitat - angef�hrte Schriftstelle/bekannter Ausspruch/gefluegeltes Wort/"
      "woertliche Wiedergabe. ");

  AddDetail( ({ "schriftstelle", "ausspruch", "wiedergabe" }),
      "Zitat.");

  AddDetail( ({ "gefuehl" }),
      "Du denkst . o O (hoffentlich ist es nicht bald Mitternacht).\n"
      "Du blickst verstohlen auf die Uhr...besser wenn Du bald von hier "
      "verschwindest. ");

  AddDetail( ({ "uhr" }),
      "Hast Du eine? ");

  AddDetail( ({ "ketten" }),
      "Siehst Du hier welche? ");

  AddDetail( ({ "boden" }),
      "Der Boden besteht aus dunkler Erde und wird von dichten "
      "Schwaden aus Nebel eingehuellt. Grabsteine ragen rechts und links "
      "von Dir aus der Erde. ");

  AddDetail( ({ "erde" }),
      "Fast schwarze Erde bedeckt den Boden. Sie scheint sehr "
      "humusreich zu sein - liegt wohl an den Toten. ");

  AddDetail( ({ "aufzug" }),
      "Na sieh Dich doch an! Oder tipp einfach: inv ");

  AddDetail( ({ "haare", "haaren", "haar" }),
      "Der Wind zersaust Dein Haar, sodass Dir einzelne Straehnen "
      "ins Gesicht wehen. ");

  AddDetail( ({ "straehnen", "straehne" }),
      "Manchmal weht Dir der Wind einzelne Straehnen deines Haares ins "
      "Gesicht. ");

  AddDetail( ({ "gesicht" }),
      "Dein Gesicht strahlt komischerweise nicht in der gewohnten "
      "fleischrosa Strahlung sondern wirkt eher fahl und grau. ");

  AddDetail( ({ "strahlung" }),
      "Normalerweise strahlt Dein Gesicht in einem sanften Rosa. ");

  AddDetail( ({ "rosa" }),
      "Rosa ist eine Farbe. ");
 
  AddDetail( ({ "grau", "schwarz" }),
      "Alles wird hier von Grau und Schwarz dominiert. Einsam und "
      "verlassen lassen sie dieses Gebiet wirken. ");

  AddDetail( ({ "gebiet" }),
      "Du befindest Dich am Eingang einer Gruft. Rund um Dich befindet "
      "sich eine Art Friedhof auf dem viele Graeber stehen. ");

  AddDetail( ({ "friedhof" }),
      "Alles wirkt wie ein Friedhof. Die Graeber deuten an, dass hier wohl "
      "viele Tote schon begraben wurden. ");

  AddDetail( ({ "hauch", "verwesung" }),
      "Es riecht fuerchterlich! ");

  AddDetail( ({ "schwaden", "nebel", "nebelschwaden" }),
      "Nebelschwaden steigen vom Boden auf und huellen die verlassenen "
      "Graeber ein. ");

  AddDetail( ({ "farben", "farbe" }),
      "Es gibt viele Farben, meinst Du eine bestimmte? ");

  AddDetail( ({ "wind" }),
      "Ein kuehler Wind kommt von nordwestlicher Richtung. ");

  AddDetail( ({ "richtung" }),
      "Nach Norden kommst Du wieder nach Polaris. ");

  AddDetail( ({ "polaris" }),
      "Im Norden! ");

  AddDetail( ({ "norden" }),
      "Tipp doch einfach: n ");

  AddDetail( ({ "art" }),
      "Der Eingang zur Gruft sieht einem Steinhaus sehr aehnlich. ");

  AddDetail( ({ "grabsteine" }),
      "Grabsteine werden normalerweise auf Graebern aufgestellt damit "
      "man erkennen kann, wann wer wo gestorben ist. "
      "Ein Grabstein unterscheidet sich von den anderen etwas. ");

  AddDetail( ({ "grabstein" }),
      "Einer von den Grabsteinen sieht etwas merkwuerdig aus. "
      "Efeuranken haben sich mit den Jahren breit gemacht. ");

  AddDetail( ({ "efeuranken", "ranken" }),
      "Durch die Ranken kannst Du leider nichts erkennen. ");
  
  AddDetail( ({ "inschrift" }),
      "Lies sie doch einfach! ");

  AddDetail( ({ "graeber" }),
      "Die Graeber sehen sehr verdaechtig aus. Genau "
      +this_player()->QueryProp(P_DEADS)+ " plus 1 kannst Du zaehlen. "
      "Irgendwie seltsam denkst Du Dir.\n"
      "Auf jedem Grab steht "
      "ein Grabstein, der den Namen "
      +CTPN + " traegt !!!");
  
  AddDetail( ({ "grab" }),
      "Such Dir ruhig eins aus - frueher oder spaeter landest Du "
      "sowieso hier!\n"
      "Jemand grinst Dich aus der Ferne boese an.\n");     
 
  AddDetail( ({ "tapfere schneiderlein", "tapfere schneider",
                "tapferes schneiderlein" }),
      "Richtig! Du bist aber klug! =)"); 

// DETAILENDE

  AddSound(DEFAULT_SOUND, 
    "Absolute Stille!");

  AddSound( ({ "stille" }),
	"\n");
 
  AddSmell(DEFAULT_SMELL, "Es riecht hier seltsam.");
  
  AddSmell( ({ "verwesung" }),
    "Pfui, das stinkt!!!! ");
 
  AddReadDetail( ({ "inschrift" }),
    "\n"
    "*************************************************\n"
    "*                                               *\n"
    "*               Hier ruht "+sprintf("%-11s", this_player()->name())+"           *\n" 
    "*                  kurz nach                    *\n"
    "*                    "+sprintf("%-27s", this_player()->QueryPossPronoun(MALE, WEM, 
SINGULAR))+"*\n"
    "*                  "+sprintf("%3d", this_player()->QueryProp(P_DEADS))+". Tod                     *\n"
    "*             spurlos verschwunden.             *\n"
    "*                                               *\n"
    "*   Moegen die Geister der Dunkelheit von Dir   *\n"
    "*                  ablassen!                    *\n"
    "*                                               *\n" 
    "*               Ruhe in Frieden!                *\n" 
    "*                                               *\n"
    "*************************************************\n" ); 


  AddSpecialDetail( ({ "name" }), "namefun" );
  
  AddCmd( ({ "blick", "blicke" }), "c_blicken" ); 
  AddCmd( ({ "entferne", "entfern" }), "c_entfernen" );
  AddCmd( ({ "betrete", "betret", "betritt"}), "c_betreten"); 

}

int c_betreten( string str )
{
 notify_fail("Was willst Du betreten?\n");
 if( str=="steinhaus" || str=="haus"  || str=="gruft")
  {
    write("Du oeffnest eine verrostete Tuer und betrittst das Haus.\n");
    this_player()->move((ANSCHLUSS_UNTERWELT),
    M_TPORT | M_NOCHECK, "in das Haus", "geht", "kommt herein");
    say("Die Tuer des Steinhauses faellt wieder zu.\n");
    return 1;
  }
  return 0;
}


 namefun( string str )
    
    {
     return(BS("Dein Name ist "+CTPN +", nicht wahr?\n")); 
     } 
 

c_blicken( string str )
{
 if( str != "auf uhr" )
 {
  write(BS("Worauf moechtest Du blicken?\n"));
  return 1;
 }
 if( str == "auf uhr" )
 {
  write(BS("Es ist "+ctime(time())[11..12] +" Uhr und "+
        ctime(time())[14..15] +" Minuten, ausserdem siehst Du, dass heute der"+
        ctime(time())[7..9] +"te ist.\n" ));
  return 1;
 }
}
      
public int c_entfernen(string str) {
    notify_fail("Was moechtest Du entfernen?\n");
    if(str != "efeu" && 
       str != "efeuranken" &&
       str != "ranken") return 0;

  write(BS("Du entfernst vorsichtig die Efeuranken und kannst eine "
           "Inschrift erkennen.\n")); 
  say(CTPN + " macht sich an einem der "
           "Grabsteine zu schaffen.\n");

  call_out("bard_gs7_check", 0);
  return 1;
}

public void bard_gs7_check() {
    object ob;
    if(!objectp(present(BARD_ID_GS7_BRIEF, this_player()))
       || present(BARD_ID_GS7_STROPHE_3, this_player())) return;
    tell_object(this_player(), 
      BS("Zwischen den Ranken faellt dir ein kleiner Zettel mit der krakeligen "
         "Handschrift des Barden Edgar auf. Sofort steckst du ihn ein."));
    ob = clone_object("/gilden/bardengilde/obj/quest/gs7_brief_strophe");
    ob->AddId(BARD_ID_GS7_STROPHE_3);
    ob->move(TP, M_GET|M_NOCHECK);

    present(BARD_ID_GS7_BRIEF, this_player())->check_teile();
    return;
  }
