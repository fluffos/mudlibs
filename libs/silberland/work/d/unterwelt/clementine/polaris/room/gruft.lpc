  AddDetail( ({ "schauspiel" }),
     "Du willst gar nicht wissen, was dann passiert! ");
  
  AddDetail( ({ "arbeit" }),
     "Die Spinnen haben sicherlich Wochen, oder sogar Jahre gebraucht, "
