  AddDetail( ({ "holz" }),
     "Das Holz ist schon sehr alt und morsch, erfuellt aber trotzdem noch "
     "seine Funktion. ");
 
  AddDetail( ({ "funktion" }),
     "Die Funktion von Holz ist Dir doch sicherlich klar. ");

  AddDetail( ({ "witterung" }),
     "Wind, Regen, Schnee, Sonne, ... ");

  AddDetail( ({ "wind", "regen", "schnee", "sonne" }),
     "Der Hocker steht sicherlich schon mehrere Jahre hier oben. ");

  AddDetail( ({ "jahre" }),
     "Du gruebelst. ");

  AddDetail( ({ "tischchen" }),
     "Ein kleines Tischchen steht hier herum. Doch irgendetwas Seltsames "
