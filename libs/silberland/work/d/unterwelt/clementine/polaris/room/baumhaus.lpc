  AddDetail( ({ "gemuetlichkeit", "mystik" }),
    "Sogar ein Laie, wie Du es bist, kann das spueren und einfangen. ");

  AddDetail( ({ "laie" }),
    "Du bist ein Laie in der Welt der Maechte. ");

  AddDetail( ({ "welt", "maechte" }),
    "Geh hinaus und siehe selbst. ");

  AddDetail( ({ "raum" }),
    "Du befindest Dich in einem Baumhaus, dass auf einer grossen "
    "Eiche errichtet wurde. ");

  AddDetail( ({ "hauch" }),
    "Das Geflecht vermittelt einen Hauch von Mystik. ");

  AddDetail( ({ "kronen", "baumkronen", "krone", "baumkrone" }),
    "Leider kannst Du sie nicht genau erkennen. ");

// DETAILENDE


// SOUNDS

  AddSound(DEFAULT_SOUND,
    "Sanft rascheln manchmal Blaetter im Wind und einige Voegel "
    "zwitschern eine froehliche Melodie. Gelegentlich vernimmst Du von "
    "weither ein Grollen. ");

  AddSound( ({ "blaetter" }),
    "Gelegentlich rascheln die Blaetter im Wind. Sie erzeugen ein friedliches "
    "auf und ab. ");

  AddSound( ({ "wind" }),
	"Manchmal streift der Wind durch das Geaest und die Blaetter "
    "wiegen sich sanft zu seinem Lied. ");

  AddSound( ({ "lied" }),
    "Der Wind nuetzt die Blaetter als sein Werkzeug, um ein ganz eigenes "
    "Lied zu erzeugen. ");

  AddSound( ({ "werkzeug" }),
    "Sein Werkzeug sind die Blaetter. ");

  AddSound( ({ "grollen" }),
    "Das Grollen kommt von weither. Anscheinend scheint ein Gewitter im "
    "Kommen zu sein. ");

  AddSound( ({ "gewitter" }),
    "Du hoerst nur gelegentliches Grollen, was eventuell auf ein Gewitter "
    "schliessen laesst. ");

  AddSound( ({ "voegel" }),
    "Einige Voegel scheinen in der Baumkrone zu sitzen und vor sich hin zu "
    "traellern. ");

  AddSound( ({ "melodie" }),
    "*zwitscher* *zwitscher* ");

  AddSound( ({ "geaest" }),
    "Sowas kannst Du nicht genau hoeren! ");


// SMELLS  

  AddSmell(DEFAULT_SMELL, 
    "Es duftet herrlich nach Natur, ganz deutlich kannst Du den frischen "
    "Geruch der Blaetter wahrnehmen. Manchmal durchzieht eine Brise das "
    "Baumhaus. ");

  AddSmell( ({ "brise" }),
    "Sie bringt den Geruch von frischen Kraeutern mit sich. Anscheinend "
    "sind die Kraeuter noch nicht ganz trocken und verstroemen einen "
    "frischen beruhigenden Duft. ");

  AddSmell( ({ "duft", "geruch" }),
    "Einfach herrlich! ");

  AddSmell( ({ "natur" }),
    "Alles riecht herrlich frisch nach Wald, Natur, Baeumen, Blaettern, "
    "Aesten und noch vielem mehr. ");

  AddSmell( ({ "baumhaus" }),
    "Im Baumhaus riecht es nach vielen verschiedenen Kraeutern. ");

  AddSmell( ({ "wald", "baeume", "blaetter", "aeste" }),
    "Herrlich entspannend duftet hier alles. Am liebsten moechtest Du "
    "diesen Duft fuer immer einfangen. ");

  AddSmell( ({ "kraeuter" }),
    "Wie die duften! Mhmm.... "); 



  AddCmd( ({ "greif", "greife" }), "c_greifen" );
  AddCmd( ({ "erahn", "erahne" }), "c_erahnen" );
  AddCmd( ({ "setz", "setze", "sitz" }), "c_setzen");
  AddCmd( ({ "hock", "hocke" }), "c_hocken");
  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken");

}

int c_greifen( string str )
{
  object ob;
  if( str != "in furchen"  &&
      str != "in furche"   ) {
    notify_fail("Wo moechtest Du hineingreifen?\n");
    return 0;
  }

  if(objectp(present(BARD_ID_GS7_BRIEF, TP)) && 
     !objectp(present(BARD_ID_GS7_STROPHE_1, TP))) {
    write(BS("Mit den Fingerspitzen fuehlst du das Eck eines kleinen Zettels. "
          "Geschickt fummelst die ihn hervor und steckst ihn ein. Merkwuerdig. "
          "Wer hat den denn da rein gesteckt?"));
    ob = clone_object("/gilden/bardengilde/obj/quest/gs7_brief_strophe");
    ob->AddId(BARD_ID_GS7_STROPHE_1);
    ob->move(TP, M_GET|M_NOCHECK);
    present(BARD_ID_GS7_BRIEF, this_player())->check_teile();
  } else {
    write(BS("Du streckst Deine Hand in eine tiefscheinende Furche hinein... "
              "Aua!!!!!!!!!!!!!!!! Da wohnt anscheinend ein Tierchen mit "
              "scharfen Zaehnen!"));
    TP->do_damage(30+random(10), this_object());
  }
  WLOG(LOG ("polaris.log"), "greift in Bau");
  return 1;
}
  

int c_erahnen( string str )
{
 if( str != "ende" )
 {
  notify_fail("Was moechtest Du erahnen?\n");
  return 0;
 }
 if( str == "ende" )
 {
  write(BS("Du richtest Deine Augen auf den Stamm, und schwenkst Deinen "
           "Blick langsam am Stamm entlang nach oben. Irgendwann "
           "verschwindet er zwischen Blaettern und Zweigen. Ein Ende ist "
           "wirklich nicht einmal zu erahnen. "));
  return 1;
 }
}

int c_setzen( string str )
{
 if( str != "auf hocker" )
 {
  notify_fail("Worauf moechtest Du Dich setzen?\n");
  return 0;
 }
 if( str == "auf hocker" )
 {
  write(BS("So geht das leider nicht. Was macht man normalerweise mit "
           "einem Hocker? "));
  return 1;
 }
}

int c_hocken( string str )
{
 if( str != "auf hocker" )
 {
  notify_fail("Worauf moechtest Du Dich hocken?\n");
  return 0;
 }
 if( str == "auf hocker" )
 {
  write(BS("Du musterst den Hocker. Irgendwie sieht der doch recht instabil "
           "aus. Lieber nicht draufhocken! "));
  return 1;
 }
}

int c_pfluecken( string str )
{
 object ob;

 if( str != "eichel"  &&
     str != "eicheln" )
 {
  notify_fail("Was moechtest Du pfluecken?\n");
  return 0;
 }
 if( str == "eichel"  ||
     str == "eicheln" )
 {
  if(anz_eichel < 1 )
  {
   write(BS("Leider kannst Du keine Eichel in Deiner Reichweite erspaehen. "
            "Der Eichelhaeher muss sie wohl schon alle ergattert und "
            "versteckt haben. "));
   return 1;
  }
  else
  {
   write(BS("Du pflueckst eine schoene brauen Eichel von einem der Aeste. "));
   ob = clone_object(OBJ ("eichel"));
   if(ob->move(this_player(), M_GET) != 1)
   {
    tell_object(this_player(), "Du kannst nicht soviel tragen!\n");
    ob->move(this_object(), M_NOCHECK);
   }
   WLOG(LOG ("polaris.log"), "pflueckt eine " +str);
   anz_eichel--;
   return 1;
  } 
 }  
}
 
