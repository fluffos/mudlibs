inherit "std/room";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include "../marisol.h"
#include "/gilden/bardengilde/barden_extern.h"


int anz_eichel;
reset()
{
  ::reset();
  anz_eichel = 2;
}

create()
{
  ::create();
  
  anz_eichel = 2;
  SetProp(P_INT_SHORT, "Auf einem Baum");
  SetProp(P_INT_LONG, 
     "Auf dieser riesigen Eiche hat jemand ein Baumhaus errichtet. "
     "Maechtige stramme Aeste befinden sich ueberall und verdecken den "
     "Himmel hoch ueber Dir. An einigen Aeste kann man sogar noch "
     "Eicheln erkennen. Eine lange Schnur wurde "
     "zwischen zwei besonders dicken Aesten "
     "gespannt. Der Boden besteht aus alten Holzbrettern. Ein kleines "
     "Tischchen mit einem Hocker steht hier herum. "); 
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0);
  
  AddExit( "unten", ROOM ("room8") );

  AddItem(NPC ("eichelh") );


// DETAILBEGINN

  AddDetail( ({ "himmel" }),
     "Vor lauter Aesten, Zweigen und Blaetter ist es Dir leider unmoeglich "
     "den Himmel zu erkennen. ");

  AddDetail( ({ "boden" }),
     "Der Boden besteht aus alten Holzbrettern, die zusammengenagelt einen "
     "festen Untergrund bilden. ");

  AddDetail( ({ "untergrund" }),
     "Mehrere Holzbretter wurden mit Naegeln aneinander gehaemmert und bilden "
     "so einen festen Untergrund. ");

  AddDetail( ({ "bretter", "holzbretter" }),
     "Die Holzbretter sehen alle schon sehr alt aus, einige sind auch "
     "sicherlich schon sehr morsch. Trotzdem bilden sie eine feste Unterlage "
     "fuer das Baumhaus. ");

  AddDetail( ({ "unterlage" }),
     "Na sieh Dir doch den Boden an!");

  AddDetail( ({ "naegel" }),
     "Die meisten der Naegel, die hier verwendet wurden, sind schon sehr "
     "rostig. ");

  AddDetail( ({ "rost" }),
     "Mit der Zeit beginnt der Rost ueberall zu nagen. ");

  AddDetail( ({ "zeit" }),
     "Zeit kommt und Zeit geht. ");

  AddDetail( ({ "schnur" }),
     "Eine besonders feste Schnur wurde zwischen zwei Aesten gespannt. "
     "Auf ihr baumeln ein paar Kraeuter. ");

  AddDetail( ({ "kraeuter" }),
     "Sicher wurden sie hier zum Trocknen aufgehaengt. ");

  AddDetail( ({ "trocknen" }),
     "So nennt man den Vorgang, bei dem Dingen ihre Feuchtigkeit entzogen "
     "wird. ");

  AddDetail( ({ "dinge" }),
     "Pflanzen, Obst, Gemuese, .... ");

  AddDetail( ({ "pflanzen" }),
     "Gibt es hier einige. ");

  AddDetail( ({ "gemuese", "obst" }),
     "Sowas kann man meistens essen. ");

  AddDetail( ({ "feuchtigkeit" }),
     "Den Kraeutern wird beim Trocknen ihre Feuchtigkeit entzogen um "
     "haltbar gemacht zu werden. ");

  AddDetail( ({ "vorgang" }),
     "Trocknen ist ein physikalischer Vorgang. ");

  AddDetail( ({ "physikalischer vorgang" }),
