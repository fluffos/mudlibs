  AddDetail( ({ "hexen", "hexe" }),
    "Hier ist nirgends eine. ");

  AddDetail( ({ "ritual", "rituale" }),
    "Leider kannst Du Dir ueberhaupt kein Bild von den Ritualen machen, "
