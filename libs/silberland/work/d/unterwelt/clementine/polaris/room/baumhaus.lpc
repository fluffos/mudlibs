  AddDetail( ({ "maserung" }),
     "Wirklich sehr aussergewoehnlich. ");

  AddDetail( ({ "silberfaeden", "faeden" }),
     "Die Faeden wurden sorgfaeltig in das Holz eingearbeitet. Bei "
     "Sonnenlicht funkelt hier sicherlich alles in weissem Licht. ");

  AddDetail( ({ "licht" }),
     "Die Faeden reflektieren sicherlich wunderbar alles bei Sonnenlicht. ");

  AddDetail( ({ "sonnenlicht" }),
     "Leider scheint momentan keine Sonne. ");

  AddDetail( ({ "sonne" }),
     "Wo?");

  AddDetail( ({ "weisses licht" }),
