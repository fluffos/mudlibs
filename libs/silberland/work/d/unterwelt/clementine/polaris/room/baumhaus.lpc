  AddDetail( ({ "rassen", "kreaturen" }),
    "Es sind zuviele, um sie einzeln zu erwaehnen. ");

  AddDetail( ({ "tiere" }),
    "Ueberall umgibt Dich Leben...");

  AddDetail( ({ "leben" }),
    "Geniesse es!");

  AddDetail( ({ "blicke", "blick" }),
    "Du laesst Deinen Blick herumschweifen. ");

  AddDetail( ({ "kreislauf" }),
    "Die Natur bildet einen Kreislauf. Aber das weisst Du doch sicherlich. ");

  AddDetail( ({ "witterungsverhaeltnisse" }),
    "Es gibt ganz verschiedene Witterungsverhaeltnisse...Sie wechseln sich "
