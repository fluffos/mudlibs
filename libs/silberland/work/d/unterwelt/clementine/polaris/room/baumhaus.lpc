  AddDetail( ({ "nirgendwo" }),
    "Wo soll das sein? ");  

  AddDetail( ({ "baumhaus" }),
    "Du befindest Dich in dem Baumhaus. Schau Dich doch einfach einmal "
    "etwas um, bevor Du dumme Woerter untersuchst! ");

  AddDetail( ({ "woerter", "wort" }),
    "Gibt es viele, was soll das?!!");

  AddDetail( ({ "aeste", "ast" }),
    "Maechtige stramme Aeste befinden sich ueberall, und verdecken "
    "sogar den Himmel hoch ueber Dir. An ihnen wachsen dunkelgruene und "
