  AddDetail( ({ "blaetter", "blatt" }),
    "Die typischen Blaetter der Eiche kennst Du doch sicherlich. Sie "
    "haben eine dunkelgruene ledrige Oberseite und eine etwas behaarte "
    "Unterseite. An ihren Stielen wachsen meistens die begehrten Fruechte "
    "der Eiche. ");

  AddDetail( ({ "oberseite", "unterseite" }),
    "Du solltest Dir so ein Blatt mal aus der Naehe ansehen! ");

  AddDetail( ({ "naehe" }),
    "Eigentlich befinden sich ganz viele Blaetter in Deiner Naehe. ");

  AddDetail( ({ "stiele", "stiel" }),
    "Stiel ist ein anderes Wort fuer Stengel. ");

  AddDetail( ({ "stengel" }),
    "Ich korrigiere: das heisst STAENGEL =) neue Rechtschreibreform ist "
    "doch so schoen! :) ");

  AddDetail( ({ "staengel" }),
    "Schoen nicht wahr?! ");

  AddDetail( ({ "rechtschreibreform" }),
    "Danach solltest Du unbedingt mal jemanden fragen! ");
 
  AddDetail( ({ "zweige" }),
    "Die Zweige haengen ueberall dicht herab. Sie bilden ein "
    "undurchdringliches Geflecht rund um das Baumhaus. ");

  AddDetail( ({ "geflecht" }),
    "Um das Baumhaus befindet sich ein undurchdringliches Geflecht aus "
    "Zweigen, Aesten und Blaetter, das dem ganzen Raum einen Hauch von "
