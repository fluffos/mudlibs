
inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include <language.h>
#include "../marisol.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
 
  SetProp(P_SHORT, "Ein Holzschluessel");
  SetProp(P_LONG,
     "Der Schluessel besteht aus Birkenholz. Welches Schloss mag "
     "er wohl aufsperren?");
  SetProp(P_NAME, "Holzschluessel");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 20);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MATERIAL, MAT_BIRCH_WOOD);
  AddId( ({ "holzschluessel", "schluessel", "polaris_holzschluessel" }) );

}

string QueryDoorKey()
{
  return(ROOM("huette1"))+":"+(ROOM("room5"));
}

