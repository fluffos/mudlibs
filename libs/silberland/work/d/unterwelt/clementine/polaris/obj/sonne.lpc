
inherit "std/thing";

#include "../marisol.h"
#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Sonne");
  SetProp(P_LONG, 
    "Du haeltst eine kleine leuchtende Sonne in den Haenden. Leider kannst "
    "Du das Material gar nicht so genau mit Deinen Augen erfassen, es liegt "
    "weit jenseits des Realen, jenseits der kopflastigen Realitaet. "
    "Sie ist wie ein gluehender Ball, der seine Energie aus dem Licht "
    "aufnimmt, um sie dann Dir zu geben, damit es Dir gut geht. "
    "Dort wo das Reich der Phantasie und der Traeume beginnt, liegt ihr "
    "Ursprung, das Zentrum ihrer Kraft. ");
  SetProp(P_NAME, "Sonne");
  AddId( ({ "sonne" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_MAGIC);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Die Sonne verkoerpert Deine Phantasie, Du moechtest sie "
                    "wirklich nicht hergeben oder eintauschen.\n");
  SetProp(P_INFO, "Du kannst die kleine Sonne fest an Dich druecken.\n");
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NODROP, 0);



  AddDetail( ({ "auge", "augen" }),
    "Manche Dinge koennen Deine Augen einfach nicht erfassen, da manches "
    "weiter liegt, als es die Vorstellungskraft zulaesst. ");

  AddDetail( ({ "realitaet", "realen" }),
    "Die ist zum Glueck ziemlich weit entfernt :)");

  AddDetail( ({ "glueck" }),
    "Glueck umgibt Dich einfach. ");

  AddDetail( ({ "ball", "feuerball" }),
    "Ein gluehender Feuerball, der unheimlich viel Energie in sich traegt, "
    "damit es Dir ja immer gut geht. ");

  AddDetail( ({ "licht" }),
    "Falls das Licht einmal nicht reichen sollte, zum Aufladen, wird ein "
    "kleines Gurkerl die Sonne sicherlich aufladen. ");

  AddDetail( ({ "gurkerl" }),
    "Ein Gurkerl, das Dich lieb hat. ");

  AddDetail( ({ "traeume" }),
    "Arm sind jene, die keine haben. ");

  AddDetail( ({ "phantasie" }),
    "Im Reich der Phantasie wurde diese Sonne geschaffen, denn Phantasie "
    "ist wichtiger als Wissen, sie ist wichtiger als alles andere, weil "
    "sie das Leben lebenswert macht. ");

  AddDetail( ({ "leben" }),
    "Du freust Dich einfach hier zu sein. ");

  AddDetail( ({ "reich" }),
    "Das Reich der Phantasie und der Traeume lebte einst in den Koepfen aller "
    "Bewohner dieses Planetens. Doch eines Tages meinte jemand, man muesse "
    "sich verstellen, um geliebt zu werden, und leider folgten viele "
    "seinem Beispiel. Mit der Zeit wurden die Menschen einsam, da sie der "
    "Phantasie und ihren Traeumen keinen Platz mehr liessen. Ein hartes Los, "
    "doch vielleicht macht das Gefuehl fuer Zugehoerigkeit einer Gesellschaft "
    "das alles weg...");

  AddDetail( ({ "liebe" }),
    "Ich Dich lieben tun :)");

  AddDetail( ({ "gesellschaft", "zugehoerigkeit", "gefuehl" }),
    "Man lehrte den Menschen, dass sie ohne die Gesellschaft nichts wert "
    "waeren, und sie glaubten es. ");

  AddDetail( ({ "menschen" }),
    "Kleine Maxis auf der Suche nach Weisheit :)");

  AddDetail( ({ "maxis" }),
    "Ich und Du, und wir, und hmm :)");

  AddDetail( ({ "weisheit" }),
    "Jeder muss selbst herausfinden, was Weisheit fuer ihn bedeutet. ");

  AddDetail( ({ "energie" }),
    "All die Energie, die Du fuers Leben brauchst. ");

  AddDetail( ({ "zentrum" }),
    "Das Reich Deiner Phantasie und Deiner Traeume bildet das Zentrum "
    "der Kraft Deiner Sonne. ");

  AddDetail( ({ "kraft" }),
    "Hmm, Kraft ja eh, mir fallt nix ein, bin unkreativ, muss Bloedsinn "
    "machen hier *grins*. "); 

  AddDetail( ({ "bloedsinn" }),
    "Bloedsinn machen, ist manchmal ziemlich befreiend. "); 

  AddDetail( ({ "material" }),
    "Sieht ziemlich magisch anziehend aus :)");

  AddDetail( ({ "los" }),
    "...");

  AddDetail( ({ "haende" }),
    "Du haeltst die Sonne behutsam in Deinen Haenden. ");


  AddCmd( ({ "drueck", "druecke" }), "c_druecken"); 

}

int c_druecken(string str)
{
 if(str != "sonne" 				&&
    str != "sonne fest" 		&&
    str != "sonne fest an mich" )
 {
  notify_fail("Was moechtest Du fest an Dich druecken?\n");
  return 0;
 }
 else
 {
  write(BS("Die kleine Sonne teilt Dir mit: Da gibts jemanden, der Dich "
           "gaaaanz viel lieb Die kleine Sonne teilt Dir mit: hat! "));
  return 1;
 }
}

