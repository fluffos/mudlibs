inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Zettel" );
  SetProp(P_LONG, 
     "Ein kleiner unscheinbarer Zettel, auf den jemand etwas "
     "gekritzelt hat. Du kannst ihn lesen. ");
  SetProp(P_NAME, "Zettel" );
  SetProp(P_GENDER, MALE);
  AddId( "zettel" );
  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  
  AddCmd( ({ "lies", "lese", "les" }), "c_lesen" );

}

int c_lesen( string str )
{
 if(str != "zettel")
 {
  notify_fail("Was moechtest Du lesen?\n");
  return 0;
 }
 if(str == "zettel")
 {
  write(BS("Drehen soll des Raetsels Loesung sein!"));
  return 1;
 }
}

