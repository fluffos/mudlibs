
inherit "std/thing";

#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT, 0);
  SetProp(P_NAME, "farbe" );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  AddId( ({ "\nfarbobject" }) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_AUTOLOADOBJ,1);

 
}

string extra_look() 
{
 return
 (environment()->Name(WER) )+" hat ganz gelbe stinkende Finger.\n";
}
 
