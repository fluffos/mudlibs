
inherit "std/armour";

#include <combat.h>
#include <properties.h>
#include <language.h>
#include "../marisol.h"


create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Amulett");
  SetProp(P_LONG, 
    "An einer duennen Lederschnur wurde ein sonnenfoermiger Anhaenger "
    "aus Silber aufgefaedelt. Irgendetwas Sonderbares scheint es "
    "mit diesem Amulett auf sich zu haben. ");
  SetProp(P_NAME, "Amulett");
  AddId( ({ "amulett", "\npolaris_anh" }) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_LEATHER:40, MAT_SILVER:60]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, "Sei bloss vorsichtig, und lass das Amulett nicht "
                    "fallen!\n");
  SetProp(P_INFO, "Das Amulett schafft Freunde.\n");

  
  AddDetail( ({ "sonderbares" }),
    "Der Sonnenanhaenger mit seinen Strahlen wirkt eigenartig auf Dich. ");

  AddDetail( ({ "anhaenger" }),
    "Der Anhaenger hat die Form einer strahlenden Sonne. ");

  AddDetail( ({ "sonnenanhaenger", "strahlen" }),
    "Unzaehlige Strahlen gehen von der Sonne aus, dennoch scheint es, "
    "als wuerden auch alle diese Strahlen, wieder in den Mittelpunkt "
    "zurueckkehren. ");

  AddDetail( ({ "sonne" }),
    "Die Sonne scheint etwas zu symbolisieren. ");

  AddDetail( ({ "silber" }),
    "Aus feinstem Silber wurde der Anhaenger erschaffen. ");

  AddDetail( ({ "schnur" }),
    "Der Anhaenger wurde auf einer Lederschnur aufgefaedelt. ");
 
  AddDetail( ({ "mittelpunkt" }),
    "Die Strahlen kommen und gehen in den Mittelpunkt. ");

  AddCmd( ({ "lass", "lasse" }), "c_lassen");

}

int c_lassen( string str )
{
 if( str != "amulett fallen")
 {
  notify_fail("Was moechtest Du fallen lassen?\n");
  return 0;
 }
 else
 {
  tell_room(environment(this_player()),
            "Das Amulett faellt auf den Boden und zerbricht "
            "in 375 Teile.\n");
  RemoveCmd( ({ "lass", "lasse" }) );
  call_out("remove", 0);
  return 1;
 }
}

