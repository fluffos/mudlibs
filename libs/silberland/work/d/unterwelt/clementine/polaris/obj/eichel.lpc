inherit "std/food";

#include <food.h>
#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  SetProp(P_SHORT, "Eine Eichel" );
  SetProp(P_LONG, 
    "Du haeltst eine kleine Eichel in den Haenden. In der Magie "
    "wird sie oft zum Brauen von Zaubertraenken gebraucht. "
    "Auch viele leckere Rezepte kann man angeblich aus Eicheln "
    "herstellen. ");
  SetProp(P_NAME, "Eichel");
  AddId( ({ "eichel" }) );
  SetProp(P_MATERIAL, MAT_FRUIT);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_INFO, "Eicheln sind manchmal giftig!\n"); 
 
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 10,10}),
        F_SOAK: 3,
        F_MSG: "Du verschlingst eine Eichel.",
        F_MSG_ROOM: "verschlingt eine Eichel."]) );
}

void BeimEssen()
{ 
 if(random(100)<30)
 SetProp(P_FOOD_INFO, QueryProp(P_FOOD_INFO)+([F_POISON:1]));
}  
  

