
inherit "/std/food";

#include <properties.h>
#include <food.h>
#include "../marisol.h"

create()
{
  if (!is_clone(ME)) return;
  ::create(); 

  SetProp(P_SHORT, "Eine rote Beere" );
  SetProp(P_LONG, 
     "Eine kleine rote Beere. Sie sieht sehr lecker aus. Ob man sie "
     "essen kann? ");
  SetProp(P_NAME, "Beere");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 1);
  SetProp(P_WEIGHT, 30);
  SetProp(P_NOBUY, 1);
  SetProp(P_INFO, "Sie sieht hinterhaeltig lecker aus!!\n");
  SetProp(P_MATERIAL, ({ MAT_FRUIT }) );
  AddId("beere");

  
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 5,5 }),
        F_SOAK: 2,
        F_MSG: "Du isst genuesslich eine rote Beere.\n",
        F_MSG_ROOM: "isst ganz genuesslich eine rote Beere. Die muss "
                    "wirklich gut schmecken. "]) );
   
}

void BeimEssen()
{
 if(this_player()->QueryProp(P_LEVEL)>=20)
 {
  SetProp(P_FOOD_INFO, QueryProp(P_FOOD_INFO)+([F_POISON:4]) );
  write("Auf einmal beginnst Du zu roecheln...\n"
        "Die Beere scheint Dir nicht sonderlich zu bekommen.\n" );
 }
 else
 { 
  SetProp(P_FOOD_INFO, QueryProp(P_FOOD_INFO) );
 }
}

