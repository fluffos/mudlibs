inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../marisol.h"

string owner;

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Voodoopuppe");
  SetProp(P_LONG,
     "Diese zauberhafte Puppe hat Clementine extra fuer Dich "
     "anfertigen lassen, damit Du Jemandem auch mal die Augen ausstechen "
     "kannst. Diese Puppe laesst sich ueberall hinmitnehmen. Und wenn "
     "sie einmal schmutzig geworden ist, kannst Du sie muehelos in die "
     "Waschmaschine stecken - Jemand hat da sicherlich nichts dagegen. "
     "Um den Hals der Puppe haengt ein kleiner Zettel. ");
  SetProp(P_NAME, "Puppe");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "puppe", "voodoopuppe" }) );
  SetProp(P_MATERIAL, MAT_COTTON );
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 13);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, "Diese wunderbare Puppe wuerdest Du um nichts in der "
     "Welt eintauschen wollen. ");

  AddDetail( ({ "zettel" }),
     "Du kannst ihn lesen. ");

  AddReadDetail( ({ "zettel" }),
     "Du kannst dieser Puppe einen Namen Deiner Wahl geben: "
     "<benenne 'name' > ");
     
  AddCmd( ({ "stech", "steche", "stich" }), "c_stechen");
  AddCmd( ({ "steck", "stecke" }), "c_stecken");
  AddCmd( ({ "benenn", "benenne" }), "namen_aendern" );
  AddCmd( ({ "wuerg", "wuerge" }), "c_wuergen" );
  
  owner="";

}

int namen_aendern(string str)
{
  object ob;
  
  notify_fail("Wie moechtest Du Deine Puppe nennen?\n");
  if(!str || !stringp(str) ||
     strlen(str=implode(explode(str," "),"_"))>80) return 0;
  
  str=lower_case(str); //damit die ids immer richtig arbeiten
  
  if(str=="clementine")
  {
    write(BS("Das laesst Du lieber!!!!"));
    return 1;
  }
  if(str == "kleine")
  {
    write(BS("Nana ned boese werden!"));
    return 1;
  }
  if(str == "feyaria" )
  {
    write(BS("Das lassen wir mal lieber!!!"));
    return 1;
  }
  if(str == "tessa" )
  {
    write(BS("Dafuer stirbst Du gleich! "));
    return 1;
  }
  if(str == "ronja" )
  {
    write(BS("Das laesst Du lieber oder moechtest Du Feinde?"));
    return 1;
  }
  if(str == owner) //der P_NAME vergleich war unzureichen, die globale Var
  {               // ist geeigneter
    write(BS("Die Puppe heisst doch schon "+CAP(owner)+".\n"));
    return 1;
  }
  
  //Optional: Gibt es den Spieler überhaupt?
  if(!objectp(find_player(str)) && !objectp(find_netdead(str)) )
  {
    tell_object(TP, BS("Es gibt keinen Spieler '"+str+"'!"));
    return 1;
  }
  
  //Puppe wird angepasst
  RemoveId(owner);
  owner=str;
  AddId( ({ owner }) );
  str=CAP(str);    

  write(BS("Deine Puppe hoert ab nun auf den Namen "+str+".\n"));
  SetProp(P_NAME, "Puppe namens "+str); //meinst du nicht eher P_SHORT?
  SetProp(P_LONG,
     "Diese zauberhafte Puppe hat Clementine extra fuer Dich anfertigen "
     "lassen, damit Du "+str+" auch mal die Augen ausstechen "
     "kannst. Diese Puppe laesst sich ueberall hinmitnehmen. Und wenn "
     "sie einmal schmutzig geworden ist, kannst Du sie muehelos "
     "in die Waschmaschine stecken - "+str+" hat da sicherlich nichts "
     "dagegen. Um den Hals der Puppe haengt ein kleiner Zettel. ");

 WLOG("/d/unterwelt/clementine/polaris/log/voodoo.log",
      "benennt die Puppe "+str);
 return 1;
}


//-- golabe Variable jetzt auch für andere nutzbar ---------------------------
mixed get_owner()
{
  if(!stringp(owner) || strlen(owner)<1) return 0; //Fehlererkennung
  return owner;
}


int c_stecken( string str )
{
 if( str != "puppe in waschmaschine")
 {
  notify_fail("Wohin moechtest Du Deine Puppe stecken?\n");
  return 0;
 }
 if( str == "puppe in waschmaschine" )
 {
  write(break_string("Du steckst Deine wunderbare Puppe "
           "in eine Waschmaschine. "
           "Ups jetzt hast Du bloederweise den SuperUltraSchleudergang "
           "erwischt - Schade aber auch!!! Zu dumm :) !!! "
           "Schon ist der Waschgang wieder vorbei. Du nimmst Deine "
           "etwas zerzauste Puppe aus der Maschine. Wirklich bloed :) "));
    return 1;
 }
}
int c_stechen( string str )
{
 if( str != "augen aus" &&
     str != "augen"     &&
     str != "in augen" )
 {
  notify_fail("Was moechtest Du ausstechen?\n");
  return 0;
 }

 if( str == "augen aus" ||
     str == "in augen"  ||
     str == "augen"     )
 {
  write(break_string("Du stichst dieser wunderbaren Puppe die Augen aus "
        "und kreischt dabei echt vergnuegt. Mann macht das Spass !!!! "
        "Gleich nochmal !!! "));
  say(this_player()->Name() + " kreischt unendlich vergnuegt und "
        "sticht dabei einer Voodoopuppe die Augen aus. *sabber*\n");
   return 1;
 }
}

int c_wuergen( string str )
{
 if( str != "puppe" )
 {
  notify_fail("Was moechtest Du wuergen?\n");
  return 0;
 }
 if( str == "puppe" )
 {
  write(break_string("Froehlich umfasst Du den Hals Deiner Puppe und "
        "drueckst gnadenlos zu. Haha! Das macht Spass! "));
  say(this_player()->name() + " umfasst den Hals einer Puppe und drueckt "
        "mit einem ur breiten Grinser zu.\n");
  return 1;
 }
}

