inherit "std/armour";

#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>
#include <language.h>

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Das kleine Dubistdu");
  SetProp(P_LONG,
    "Das ist Dein kleines Dubistdu. Auch wenn es Dir oft auf die Nerven geht, "
    "bleibt es immer ein Teil von Dir, und eigentlich moechtest Du es auch "
    "nicht mehr missen in Deinem Leben. ");
  SetProp(P_NAME, "ein kleines Dubistdu");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOSELL, "Dieses kleine Dubistdu ist Dir zu sehr ans Herz "
     "gewachsen, Du moechtest es garantiert nicht hergeben.\n");
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AC, 0);
  AddId( ({ "dubistdu", "stofftier", "\ndudu" }) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_INFO, "Du kannst es streicheln.\n");

  AddCmd( ({ "streichel", "streichle", "streichl" }), "c_streicheln");

}

c_streicheln( string str )
{
 if( !id(str) )
 {
  notify_fail("Was moechtest Du streicheln?\n");
  return 0;
 }
 else
 {
  write("Du streichelst Dein kleines Dubistdu.\n"
        "\n"
        "Auf einmal hoerst Du es leise quietschen...\n"
        "\n"
        "'Du bist ok, so wie Du bist!!!!'\n"
        "\n");
  return 1;
 }
}


string extra_look()
{
 return(environment()->Name(WER))+" hat ein kleines Dubistdu unterm Arm "
       "geklemmt.\n";
}
