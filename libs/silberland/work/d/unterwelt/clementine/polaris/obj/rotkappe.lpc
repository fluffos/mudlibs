
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Pilz");
  SetProp(P_LONG,
    "Aufgrund des roten Hutes, und des weissen schmalen Stiels, koennte der "
    "Pilz eigentlich eine Rotkappe sein, aber so sicher bist Du Dir "
    "leider nicht. ");
  SetProp(P_NAME, "Pilz");
  AddId( ({ "rotkappe", "pilz", "\npolaris_pilz" }) );
  SetProp(P_MATERIAL, MAT_FRUIT);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 40);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_GENDER, MALE);
  
  AddCmd( ({ "ess", "esse", "iss" }), "c_essen");

}

int c_essen( string str)
{
 if( str != "pilz" )
 {
  notify_fail("Was moechtest Du essen?\n");
  return 0;
 }
 else
 {
  write(BS("Man sollte keine Pilze essen, von denen man sich nicht "
           "sicher ist, ob sie giftig sind!!!") );
  return 1;
 }
}

