inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../marisol.h"

string remove_finger();
string dubistdu();

create()
{
 if (!is_clone(this_object()))
 return;

  ::create();

  SetProp(P_SHORT, "Hyrokkin, die Alte" );
  SetProp(P_LONG,
     "Vor Dir steht Hyrokkin, die Besitzerin dieses Hexenladens. "
     "Gutmuetig laechelt sie Dich mit ihrer muetterlichen Art an. "
     "Ihr ganzes Gesicht hat tiefe Falten und es scheint als waere "
     "sie schon ueber 1000 Jahre alt. Wahrscheinlich hat sie schon "
     "sehr viel in ihrem Leben gesehen und erlebt. ");
  SetProp(P_NAME, "Hyrokkin" );
  set_living_name( "hyrokkin" );
  AddId( ({ "hyrokkin", "alte", "hexe" }) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Mensch");
  SetProp(P_LOG_INFO, "/clementine/hyrokkin");

  create_default_npc( 22 );
  SetProp(P_ALIGN, 300);
  SetProp(P_HANDS, ({ " mit Weisheit", QueryProp(P_HANDS)[1],
                      DT_MIND }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS,
     ([ DT_MAGIC: -0.2,
     DT_POISON: -1, DT_TERROR: -1, DT_FIRE:-0.5, 
     DT_COLD:0.8,   DT_WATER:0,
     DT_AIR:0,   DT_LIGHTNING:-0.5, DT_EXPLOSION:0,
     DT_SOUND:0, DT_LIGHT:0,  DT_ELECTRIC:1,
     DT_HOLY:-1,  DT_UNHOLY:0, ]) );

  SUID;
  CLONEME("/p/armour/boots/lederschuhe.lpc");
  CLONEME(ARMOUR ("lederrock") );
  CLONEME("/p/armour/belt/guertel.lpc");
  CLONEME("/p/armour/armour/weste.lpc");
  CLONEME(ARMOUR ("umhang") );
  CLONEME(ARMOUR ("amulett") );
  command( "trage alles" );
  CLONEME("/obj/money");
  present("geld")->AddAmount(1499);

  SetProp(P_DIE_MSG, " bricht nieder.\n");

  SetProp(P_MURDER_MSG, "Eines Tages werde ich siegen!\n");
  SetProp(P_KILL_NAME, "Hyrokkin" );
  SetProp(P_KILL_MSG, "Unglaeubige muessen bestraft werden!\n");

  SetProp(P_REJECT, ({ REJECT_KEEP, 
     "Hyrokkin bedankt sich artig und strahlt.\n" }) );
 
  SetChats(5, ({
     "Hyrokkin nickt Dir freundlich zu.\n",
     "Hyrokkin murmelt: Kann ich was helfen?\n",
     "Hyrokkin fragt: Suchst Du vielleicht etwas Bestimmtes?\n",
     "Hyrokkin grinst lieb.\n",
     "Hyrokkin sagt stolz: Ich hab auch Geschenke!\n" }) );

  SetAttackChats(15, ({
     "Hyrokkin sagt: Du Narr!\n",
     "Hyrokkin murmelt: Das wirst Du bereuen!\n",
     "Hyrokkin sagt: Wir Hexen sind fuer einander da!\n" }) );

  SetProp(P_SPELLRATE, 60);

  AddDefaultSpell(1, 200, DS_FEAR);
  AddDefaultSpell(1, 150, DS_CURSE_ARMOUR);
  AddDefaultSpell(2, 140, DS_ANTIMAGIC);
  AddDefaultSpell(1, 100, DS_FROG);

  AddSpell(1, 250,
     "Hyrokkin wird von gleissenden Blitzen eingehuellt.\n",
     "Hyrokkin wird von gleissenden Blitzen eingehuellt.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]) ); 

  AddSpell(1, 460,
     "Hyrokkin schleudert einen gewaltigen Windstoss nach Dir.\n",
     "Hyrokkin schleudert einen gewaltigen Windstoss nach @WEM.\n",
     DT_AIR, ([SP_SHOW_DAMAGE:1]) );  

  AddSpell(1, 130,
      "Hyrokkin beschwoert ein Pentagramm und wirft eine Feuerkugel "
      "nach Dir.\n",
      "Hyrokkin beschwoert ein Pentagramm und wirft eine Feuerkugel "
      "nach @WEM.\n", DT_FIRE, ([SP_SHOW_DAMAGE:1]) );
                        

  AddSpell(1, 140,
      "Hyrokkin wirft eine Lanze aus reiner Luft nach Dir.\n",
      "Hyrokkin wirf eine Lanze aus reiner Luft nach @WEM.\n",
      DT_AIR, ([SP_SHOW_DAMAGE:1]) );


// INFOS!!!

  SetProp(P_DEFAULT_INFO, "sagt: Frag lieber einen anderen danach.\n" );

  AddInfo( ({ "astarte" }),
     "sagt: Astarte ist eine sehr weise Frau. ");

  AddInfo( ({ "frau" }),
      "sagt: Die meisten Hexen sind Frauen. ");

  AddInfo( ({ "sex" }),
      "sagt: Nein ich moechte keinen mit Dir haben. ");

  AddInfo( ({ "gefjon" }),
      "sagt: Gefjon ist die Besitzerin der Kneipe hier. ");

  AddInfo( ({ "harbad" }),
      "sagt: Harbad ist der Besitzer des Ladens. ");

  AddInfo( ({ "besitzerin", "besitzer" }),
       "sagt: Meinst Du einen bestimmten? ");

  AddInfo( ({ "hyrokkin" }),
     "sagt: Das bin ich. ");

  AddInfo( ({ "moor" }),
      "sagt: An dem bist Du sicherlich schon vorbei gekommen. ");

  AddInfo( ({ "clementine" }),
      "sagt: Clementine hat mich erschaffen! ");

  AddInfo( ({ "ronja" }),
     "sagt: Ronja ist die Mami von Clementine. ");

  AddInfo( ({ "mami" }),
     "fragt: Hast Du eine? ");

  AddInfo( ({ "feyaria" }),
     "sagt: Feyaria mag ich sehr gerne. ");

  AddInfo( ({ "drache" }),
     "In Polaris soll irgendwo ein Drache leben. Ich hab ihn allerdings "
     "noch nicht gesehen.", "sagt: ");

  AddInfo( ({ "pentagramm" }),
     "sagt: Ich habe keine Lust drueber zu reden. ");

  AddInfo( ({ "lust" }),
     "sagt: Du bist ein Luestling. ");

  AddInfo( ({ "luestling" }),
     "sagt: Ach lass mir meinen Frieden. ");

  AddInfo( ({ "frieden" }),
     "sagt: Wir wollen immer nur Frieden. ");

  AddInfo( ({ "zauberer" }),
     "sagt: Darueber moechte ich nicht reden. ");

  AddInfo( ({ "geschenke" }),
     "deutet auf ein unscheinbares Schild.\n"
     "Hyrokkin sagt: Aber wenn Du moechtest, "
     "schenk ich Dir auch ein Stofftier!" );

  AddInfo( ({ "polaris" }),
     "sagt: Na wo befindest Du Dich denn gerade? ");

  AddInfo( ({ "hexe", "hexen" }),
     "Wir sind eine Gruppe von Hexen und haben uns hier "
     "niedergelassen. ", "sagt: ");

  AddInfo( ({ "gruppe" }),
     "sagt: Ich bin nicht die einzige hier. ");

  AddInfo( ({ "dante" }),
     "Dante dieser alte Sack :)\n"
     "Eigentlich liebt Dante ja Clementine heiss und innig aber "
     "sie weist ihn ja immer wieder ab. Sonderbare Art von Beziehung.", 
     "sagt: ");
 
//  AddInfo( ({ "gelbe finger" }),
//     "Hast Du denn welche? Wenn ich sie Dir reinigen soll dann tipp "
//     "einfach: <farbeweg> ", "sagt: ");

  AddInfo( ({ "gelbe finger", "gelben finger" }), #'remove_finger, "sagt: ");

  AddInfo( ({ "stofftier", "dubistdu" }), #'dubistdu, "sagt: ");  

  AddInfo( ({ "finger" }),
     "sagt: Ich nehm schon an, dass Du Finger hast. ");

  AddInfo( ({ "post" }),
    "sagt: Die ist ganz in der Naehe. ");

  AddInfo( ({ "ringelblumen", "ringelblumensalbe" }),
    "sagt: Manchmal brauche ich sie fuer Zauber. ");

  AddInfo( ({ "zauber" }),
    "ist sehr beschaeftigt. ");

  AddInfo( ({ "kessel" }),
    "sagt: Den benoetige ich zum Kochen. ");

  AddInfo( ({ "kochen" }),
    "grinst lieb. ");

// INFOS ROTKAPPE

  AddInfo( ({ "problem" }),
    "Ich brauche unbedingt einen Leccinum versipelle, und konnte nirgends "
    "einen finden. Dabei brauch ich ihn doch so dringend zum Kochen.", 
    "schluchzt: ");

  AddInfo( ({ "leccinum", "versipelle", "leccinum versipelle" }),
    "Eine Rotkappe!", "murmelt: ");

  AddInfo( ({ "rotkappe" }),
    "Normalerweise erkennt man ihn, dank seines rotem Hutes sofort. Er "
    "hat einen weissen Stiel, mit schwarzen Schuppen, und waechst meistens "
    "unter Birken. Bitte bring ihn mir! ", "sagt: ");

  AddInfo( ({ "amulett" }),
    "Es gibt verschiedene Amulette, die wir Hexen tragen. Meistens hat "
    "jede Hexe ihren persoenlichen Talisman, aber wir haben auch eines, "
    "was uns, andere Hexen erkennen laesst, und wodurch wir bei anderen "
    "Hexen als Freunde erkannt werden. ", "sagt: ");

  AddInfo( ({ "freunde" }),
    "schweigt. ");

  AddInfo( ({ "talisman" }),
    "fragt: Hast Du auch einen? ");

  AddInfo( ({ "sonne" }),
    "Die Sonne symbolisiert fuer uns Leben, solange sie da ist, werden "
    "wir existieren. ", "sagt: ");
 
  AddInfo( ({ "hilfe" }),
    "Ich haette da wirklich ein kleines Problem.", "sagt: ");

  AddInfo( ({ "birke", "birken" }),
    "Gefjon hilft Dir sicherlich weiter. ", "sagt: ");

}

string remove_finger()
{
  object ob;
  if(ob=present("\nfarbobject",this_player()))
  {
   tell_object(this_player(),
        "Hyrokkin murmelt ein paar Zauberworte und Deine Griffel sind "
        "nicht mehr gelb.\n");
   ob->remove(1);
   return("So das wars auch schon, nun sind sie wieder sauber. ");
  }
  else
  {
   return("Aber Du hast doch gar keine gelben Finger! ");
  }
}

string dubistdu()
{
  object ob;
  if(ob=present("\ndudu", this_player()))
  {
   write(BS("Hyrokkin sagt: Aber Du hast doch schon eines!\n"));
  }
  else
  {
   write(BS("Hyrokkin schenkt Dir ein Stofftier."));
   ob = clone_object(OBJ ("dubistdu") );
   ob->move(this_player(), M_NOCHECK);
  }
}

die(int poisondeath)
{
write_file(LOG("polaris.kills"),
    dtime(time())+": "+CAP(getuid(TP))+" toetet Hyrokkin.\n");
::die(poisondeath);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
 if( killer == TO )
    write_file(LOG ("dragon.deads"),
       sprintf( ctime()+": Hyrokkin hat gerade "+CAP(getuid(player))
       +" umgebracht - %d EP!\n", lostexp));
 return ;
}


give_notify(object ob)
{
  object obj;
  if(ob->id("\npolaris_pilz"))
  {
   if(deep_present("\npolaris_anh", this_player()))
    {  
     write("Die Hexe bedankt sich bei Dir.\n"); 
    }
    else
    {
     write("Hyrokkin bedankt sich vielmals und schenkt Dir ein Amulett.\n");
     obj = clone_object(OBJ ("anhaenger"));
     WLOG(LOG("polaris.log"), "bekommt ein Amulett");
     if (obj->move(this_player(), M_GET) != 1)
     {
      tell_object(this_player(), "Du kannst nicht soviel tragen!\n");
      obj->move(this_object(), M_NOCHECK);
      }
    }
  }
 else
 {
  write("Hyrokkin bedankt sich artig und strahlt.\n"); 
  ::give_notify(ob);
 } 
}



