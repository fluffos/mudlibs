inherit "std/npc";
inherit "std/npc/spells";
inherit "/gilden/bardengilde/obj/std_spellprovider";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/gilden/bardengilde/barden_extern.h"
#include "../marisol.h"

create()
{
  if (!is_clone(this_object()))
  return;

  ::create();

  SetProp(P_SHORT,"Eine kleine traurige Hexe");
  SetProp(P_LONG,
    "Eine kleine Hexe steht vor Dir und blickt Dich traurig mit "
    "ihren gruenen Augen an. Anscheinend liegt in einem der Graeber "
    "ihre Mutter begraben. ");

  SetProp(P_NAME, "Larva" );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Mensch");
  SetProp(P_LOG_INFO, "/clementine/larva");
  SetProp(P_ARTICLE, 0);
 
  set_living_name("hexe");
  AddId( ({ "hexe", "larva" }) );

  create_default_npc(15);

  SetProp(P_SIZE, 170);
  SetProp(P_MAX_HP, 200);
  SetProp(P_ALIGN, 800);

  SetProp(P_HANDS, ({" mit ihren winzigen Haenden", QueryProp(P_HANDS)[1],
                     DT_BLUDGEON }) );

  SetProp(P_SPELLRATE, 40);

  AddSpell(1,400,
    "Die kleine Hexe verflucht Dich.\n",
    "Die kleine Hexe verflucht @WEN.\n",
     DT_HOLY, ([SP_SHOW_DAMAGE:1]) );

  SetProp(P_MURDER_MSG, "Endlich bin ich wieder bei meiner Mami!\n");

  SetChats(3, ({
    "Die kleine Hexe schnieft traurig vor sich hin.\n",
    "Die kleine Hexe weint bitterlich.\n",
    "Die kleine Hexe gruebelt ueber den Tod und den "
    "Sinn des Lebens.\n" }) );


// INFOS!!!
  
  SetProp(P_DEFAULT_INFO,
    "schluchzt: Ich bin so alleineeeeee. ");
 
  AddInfo( ({ "mutter", "mami" }),
    "Ein boeser Zauberer hat meine Mutter umgebracht. Jetzt bin ich "
    "ganz alleine...", "sagt: ");

  AddInfo( ({ "zauberer" }),
    "fuerchtet sich. ");

  AddInfo( ({ "familie" }),
    "sagt: Ich habe niemanden mehr. ");

  AddInfo( ({ "graeber" }),
    "sagt: In einem davon liegt meine Mutter begraben. ");

  AddInfo( ({ "grab" }),
    "sagt: Ich weiss nicht einmal in welchem. ");

  AddInfo( ({ "name" }),
    "sagt: Ich heisse Larva. ");

  AddInfo( ({ "larva" }),
    "sagt: Der Name bedeutet Totengeist. ");

  AddInfo( ({ "totengeist" }),
    "sagt: Totengeist bedeutet mein Name. ");

  AddInfo( ({ "clementine" }),
    "sagt: Die war schon laenger nicht mehr hier. ");

  AddInfo( ({ "sinn" }),
    "sagt: Fuer mich hat das Leben keinen Sinn mehr. ");

  AddInfo( ({ "leben" }),
    "sagt: Ich weiss gar nicht mehr, was 'leben' eigentlich heisst. ");

  AddInfo( ({ "tod" }),
    "sagt: Wenn ich sterbe, werde ich mit meiner Mutter vereint sein. ");

  AddInfo( ({ "polaris" }),
    "sagt: Hier hab ich mit meiner Mutter gewohnt. ");

  AddInfo( ({ "mitternacht" }),
    "weint. ");

  AddInfo( ({ "friedhof" }),
    "jammert: Hier ist irgendwo meine Mami begraben. ");

  AddInfo( ({ "hexe" }),
    "sagt: Ich bin erst eine kleine. ");

  AddInfo( ({ "vater" }),
    "sagt: Mein Vater hat uns damals verlassen. ");

  AddInfo( ({ "trauer", "kummer" }),
    "weint herzzerreissend. ");

  AddInfo( ({ "hilfe" }),
    "Du kannst ihn nicht besiegen. ", "schluchzt: ");

  AddInfo( ({ "dante" }),
    "Der ist mir doch wuascht!", "sagt: ");

  AddInfo( ({ "besen" }),
    "Ich hab doch keinen. ", "sagt: ");

  AddInfo( ({ "tessa" }),
    "Die kommt auch immer nur, um mich zu toeten.", "weint: ");

  AddInfo( ({ "howard", "gefjon", "hyrokkin" }),
    "Die wohnen in Polaris, koennen mir aber auch nicht helfen. ",
    "schluchzt: ");

  AddInfo( ({ "blocksberg" }),
    "Frag lieber jemand anderen. ", "sagt: ");

  AddInfo( ({ "ritual", "rituale", "zauber" }),
    "Meine Mami konnte mir leider kaum welche beibringen, weil... ", 
    "heult: ");

  AddInfo( ({ "mord", "selbstmord" }),
    "Das hat leider nie funktioniert. ", "sagt: ");

  AddInfo( ({ "sterben" }),
    "Ich hab keine Angst vor dem Tod. ", "sagt: ");

  AddInfo( ({ "schluessel" }),
    "Ich weiss nicht wovon Du redest. ", "sagt: ");

  AddInfo( ({ "dolch" }),
    "Da fragst Du besser Dune. ", "gruebelt: ");

  AddInfo( ({ "dune" }),
    "Der kommt immer und fragt mich danach. Ich weiss auch nicht warum. ", 
    "sagt: ");

  AddInfo( ({ "kindheit" }),
    "Bis meine Mutter starb war alles so wunderbar. ", "snieft: ");

  AddInfo( ({ "trost" }),
    "weint drauf los. ");

  AddInfo( ({ "moor" }),
    "Das Moor ist nicht so weit weg. ", "sagt: ");
  
  AddInfo( ({ "angst", "furcht" }),
    "Ich fuerchte nichts mehr. ", "sagt: ");

  AddInfo( ({ "sorgen" }),
    "Weswegen denn?", "sagt: ");

  AddInfo( ({ "freunde", "freund" }),
    "Die koennen mir auch nicht helfen.", "schluchzt: ");

  AddInfo( ({ "hilfe" }),
    "Niemand kann mir helfen!!!", "bruellt: ");

  AddInfo( ({ "steinhaus", "haus" }),
    "Schaus Dir doch selbst an. ", "sagt: ");

  AddInfo( ({ "unterwelt" }),
    "fuerchtet sich. ");

  AddInfo( ({ "tuer", "tueren" }),
    "Es gibt ueberall Tueren. ", "sagt: ");

  AddInfo( ({ "gruft" }),
    "Durch das Haus kommt man in eine Gruft. ", "sagt: ");

  AddInfo( ({ "grabstein" }),
    "Glaubst Du denn, dass ich mir jeden Grabstein ankucke?", "fragt: ");

  AddInfo( ({ "symbole", "symbol" }),
    "weeeeeeeeeeeeeeeeeeeint. ");

  AddInfo( ({ "einsamkeit" }),
    "Ich kenn gar nichts anderes mehr. ", "murmelt: ");

  AddInfo( ({ "probleme", "problem" }),
    "zuckt ratlos mit den Schultern. ");
    

  // Bardenzauber
  AddInfo( ({"haette ich ein herz", "zauberlied", "barden", "lied"}),
    "Einige Barden meinten, dass sie von meiner Trauer inspiriert wurden.@@barden_song_info@@.",
    "schluchzt: ");

  AddInfo( ({"kerze", "kerzen"}),
    "Die schoensten Grabkerzen gibt es am Friedhof in der Naehe von Burg Sturmfels.",
    "weint: ");


  AddCmd(({"troeste", "troest"}), "cmd_troeste");
}

public void give_notify(object ob) {
	if(ob->id(BARD_ID_GS8_KERZE)) {
		command_me("sag Danke!");
    TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 5,
                               PARALYZE_MSG: "Jetzt warte doch mal!\n",
                               PARALYZE_END: "Was fuer ein Schauspiel...\n"]));
		call_out("teach_bard_spell", 0, TP);
		ob->remove(1);
	} else {
		command_me("emote weint bitterlich und laesst "+ob->name(WEN, 1)+" fallen.");
		ob->move(ENV(TO), M_PUT);
	}
}

public void teach_bard_spell(object who) {

  tell_room(ENV(TO), BS(Name(WER)+ " zuendet die Kerze an und weit bitterlich."));
  who->SetProp(P_PARALYZED, 0);
  call_out("LearnBardSpell", 0, TP, "haette ich ein herz", 
		       "Mit diesem Lied verstroemt das Ziel unglaubliche Traurigkeit, "
           "was dessen Gegner in schreckliche, eiskalte Depression huellt.",
				 "spiele 'haette ich ein herz' auf <ziel>");
  return;
}

public string barden_song_info() {
	if(TP->QueryProp(P_GUILD) == "bardengilde" && 
       call_other("/gilden/bardengilde/master/bardenmaster", "GetBardGroup", TP) == BARD_GROUP_ALESTRA &&
       TP->QuerySkill("haette ich ein herz") == 0) {
		return " Ich weiss dich auch nicht was die meinen! Mir waere es viel wichtiger einer Kerze "
           "fuer das Grab meiner Mutter zu haben. Aber ich bin viel zu traurig um selbst eine "
           "zu holen.";
	}
	return "";
}
cmd_troeste(string str)
{
  notify_fail("Wen moechtest Du troesten?\n");
  if (!str || str == "") return 0;
  if(!id(str)) return 0;
  write("Die kleine Hexe weint sich so richtig bei Dir aus.\n");
  return 1;
}

