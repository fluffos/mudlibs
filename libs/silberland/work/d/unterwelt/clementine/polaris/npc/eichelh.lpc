inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include "../marisol.h"

create()
{
 if (!is_clone(this_object()))
 return;

  ::create();

  SetProp(P_SHORT, "Ein Eichelhaeher");
  SetProp(P_LONG, 
    "Ein kleiner Eichelhaeher sitzt vor Dir auf dem Boden. "
    "Er ist nur ungefaehr 34cm gross und hat ein roetlichbraunes "
    "Gefieder, dass nur durch einen blauen Streifen an den Fluegeln "
    "gebrochen wird. Anscheinend sammelt er hier schon Eicheln fuer "
    "seinen Wintervorrat. ");
  SetProp(P_NAME, "Eichelhaeher" );
  set_living_name( "eichelhaeher");
  SetProp(P_ARTICLE, 1 );
  SetProp(P_GENDER, MALE);
  AddId( ({ "eichelhaeher", "haeher" }) );
  create_default_npc(8);
  AddClass(CL_FLYING);
  SetProp(P_SIZE, 34);
  SetProp(P_RACE, "Vogel" );
  SetProp(P_ALIGN, 600);
  SetProp(P_HANDS, ({ " mit seinen Fluegeln", QueryProp(P_HANDS)[1],
                      DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MURDER_MSG, "*tschirp* *tschirp*" );
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
  
  SetProp(P_MSGIN, "flattert herein" );
  SetChats(3, ({
    "Der Eichelhaeher sucht nach Eicheln.\n",
    "Der Eichelhaeher tschirpt leise.\n"
    "Der Eichelhaeher sucht nach Insekten.\n" }) );
  SetProp(P_DEFAULT_INFO, "tschirpt.");
  SetProp( P_REJECT, ({ REJECT_KEEP, "Der Eichelhaeher tschirpt.\n" }) );
  SetProp(P_SOUND, "Du hoerst ein leises Zwitschern.\n");

}

     

