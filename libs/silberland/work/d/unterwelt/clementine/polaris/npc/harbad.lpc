
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../marisol.h"

create()
{
 if (!is_clone(this_object()))
 return;

  ::create();

  SetProp(P_SHORT, "Harbad, der Graubart" );
  SetProp(P_LONG,
     "Vor Dir steht ein kleiner Zwerg, der in Polaris sein neues "
     "Zuhause gefunden hat. Er scheint sehr tuechtig zu sein, sonst "
     "waere er wohl kaum der Besitzer dieses Ladens. Sein grauer "
     "Bart reicht fast bis zum Fussboden. Muede und gestresst blickt "
     "er Dich an. ");
  SetProp(P_NAME, "Harbad" );
  set_living_name( "harbad" );
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Zwerg");
  AddId( ({ "harbad", "zwerg", "besitzer", "Messermeister" }) );
  SetProp(P_LOG_INFO, "clementine/harbad");

  create_default_npc( 28 );
  SetProp(P_ALIGN, 100 );
  SetProp(P_HANDS, ({ " mit seinem langen Bart", QueryProp(P_HANDS)[1],
                      DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 2);
 
  SetProp(P_RESISTANCE_STRENGTHS,
     ([ DT_MAGIC: -0.2,
     DT_POISON: -1, DT_TERROR: -1, DT_FIRE:-1,  DT_COLD:-0.2,   DT_WATER:0.4,
     DT_AIR:0,   DT_LIGHTNING:-0.5, DT_EXPLOSION:0,
     DT_SOUND:0, DT_LIGHT:0,  DT_ELECTRIC:1,
     DT_HOLY:0,  DT_UNHOLY:0, ]) );

  SUID;
  CLONEME("/p/armour/helm/hut.lpc");
  CLONEME("/p/armour/trousers/wollhose.lpc");
  CLONEME("/p/armour/cloak/lederschuerze.lpc");
  CLONEME("/p/armour/bracers/armschuetzer.lpc");
  CLONEME("/p/armour/boots/lederschuhe.lpc");
  CLONEME("/p/armour/armour/lederruestung.lpc");
  command( "trage alles" );
  CLONEME("/p/weapon/knife/messer.lpc");
  command( "zuecke messer" );
  CLONEME("obj/money");
  present("geld")->AddAmount(439);


  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  
  SetProp(P_MURDER_MSG, "Das wirst Du mir buessen!\n");
  SetProp(P_KILL_NAME, "Harbad" );
  SetProp(P_KILL_MSG, "Was misst Du Dich auch mit mir?!\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
     "Harbad nimmt doch keine Sachen von Fremden!\n" }) );

  SetChats(4, ({
      "Harbad nickt Dir freundlich zu.\n",
      "Harbad murmelt: Kauf doch etwas!\n",
      "Harbad seufzt.\n",
      "Harbad stoehnt ueber die viele Arbeit.\n" }) );
 
  SetAttackChats(10, ({
       "Harbad schaut Dich mit giftigen Augen an.\n",
       "Harbad sagt: Du wagst es wirklich?!\n",
       "Harbad wird von spruehenden Funken eingehuellt.\n" }) );

// INFOS!!!

  SetProp(P_DEFAULT_INFO, "murmelt etwas in seinen Bart.\n");

  AddInfo( ({ "harbad" }),
     "sagt: Das bin ich. ");

  AddInfo( ({ "zwerg" }),
     "sagt: Gut erkannt, ich bin ein Zwerg. ");

  AddInfo( ({ "polaris" }),
     "Ich hab ihn Polaris mein neues Zuhause gefunden. Man hat mich "
     "hier liebevoll aufgenommen.", "sagt: " );

  AddInfo( ({ "hexen", "hexe" }),
     "Von ihnen hab ich sehr viel gelernt. Nicht nur Zauber, sondern "
     "auch vieles Wichtiges ueber mein Leben.", "sagt: ");

  AddInfo( ({ "felonia" }),
     "Frueher war ich in Felonia zu Hause. Aber ich hab mich auf den "
     "Weg gemacht die Welt zu erkunden.", "sagt: ");

  AddInfo( ({ "weg" }),
     "sagt: Ein langer und anstrengender Weg. ");

  AddInfo( ({ "zuhause" }),
     "sagt: Hier in Polaris habe ich mein neues gefunden. ");

  AddInfo( ({ "wichtiges" }),
     "sagt: Vieles. ");

  AddInfo( ({ "leben" }),
     "sagt: Die Hexen haben mir geholfen meinen Lebensweg zu finden. ");

  AddInfo( ({ "bart" }),
     "sagt: Der ist wunderschoen, nicht wahr?");  

  AddInfo( ({ "lebensweg" }),
    "sagt: Jeder muss seinen eigenen finden. ");

  AddInfo( ({ "ronja", "beste" }),
    "sagt: Ronja ist die Beste. ");

  AddInfo( ({ "clementine" }),
    "sagt: Clementine ist klug und weise :) ");

  AddInfo( ({ "kleine" }),
    "sagt: Die war noch nie hier. ");

  AddInfo( ({ "laden" }),
    "sagt: Den hab ich ganz alleine aufgebaut. ");

  AddInfo( ({ "zauber" }),
    "sagt: Ich habe einige bei den Hexen gelernt. ");

  AddInfo( ({ "hyrokkin" }),
    "sagt: Die vom Feuer gebrunzelte...eine gute Seele. ");

  AddInfo( ({ "seele" }),
    "nickt. ");

  




}
