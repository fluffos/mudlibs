
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../marisol.h"

create()
{
 if (!is_clone(this_object()))
 return;

  ::create();

  SetProp(P_SHORT, "Gefjon, die Hexe" );
  SetProp(P_LONG,
     "Gefjon ist die Inhaberin dieser Kneipe. Bei ihr kannst Du "
     "Getraenke und Speisen kaufen. Sie sieht schon sehr alt aus, "
     "doch in ihren blauen Augen kannst Du etwas sehr maedchenhaftes "
     "erkennen. Du fuehlst Dich als etwas Besonderes in ihrer "
     "Gegenwart. ");
  SetProp(P_NAME, "Gefjon" );
  set_living_name( "gefjon" );
  SetProp(P_ARTICLE, 0 );
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "gefjon", "hexe", "inhaberin", "QUESTOBJ" }) );
  SetProp(P_LOG_INFO, "/clementine/gefjon");
    

  create_default_npc( 40 );
  SetProp(P_ALIGN, 1000 );
  SetProp(P_RACE, "Mensch");
  SetProp(P_HANDS, ({ " mit magischen Haenden", QueryProp(P_HANDS)[1],
                      DT_MAGIC }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_MAGIC: -0.5, 
     DT_POISON: -1, DT_TERROR: -1, DT_FIRE:0.5,  DT_COLD:1,   DT_WATER:0,
     DT_AIR:0,   DT_LIGHTNING:-0.5, DT_EXPLOSION:-0.4,
     DT_SOUND:0, DT_LIGHT:0,  DT_ELECTRIC:1,
     DT_HOLY:-1,  DT_UNHOLY:1, ]) );

  SUID;
  CLONEME("/p/armour/boots/lederschuhe.lpc");
  CLONEME("/p/armour/cloak/lederschuerze.lpc");
  CLONEME(ARMOUR ("amulett") );
  CLONEME("p/armour/armour/weste.lpc");
  CLONEME("/p/armour/belt/guertel.lpc");
  CLONEME("/p/armour/trousers/rock.lpc");
  command("trage alles");
  CLONEME("/obj/money");
  present("geld")->AddAmount(1999); 

  SetProp(P_MURDER_MSG, "Das verzeihe ich Dir nie!!!\n");
  SetProp(P_KILL_NAME, "Gefjon");
  SetProp(P_KILL_MSG, "Das hast Du nun davon!\n");  
 

  SetProp(P_SPELLRATE, 60 );

  AddDefaultSpell(1, 180, DS_POISON);  

  AddSpell(1, 380, 
     "Gefjon formt etwas in ihren Haenden und schleudert eine magische "
     "Giftlanze nach Dir.\n",
     "Gefjon schleudert eine Giftlanze nach @WEM.\n", DT_POISON,
     ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 320,
     "Gefjon beschwoert ein Pentagramm und wirft einen Blitz nach Dir.\n",
     "Gefjon beschwoert ein Pentagramm und wirft einen Blitz nach @WEM.\n",
     DT_TERROR, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 300,
     "Gefjon geht in sich. Auf einmal wirst Du von einem Feuer eingehuellt.\n",
     "Gefjon konzentriert sich und schleudert Feuer nach @WEM.\n",
     DT_FIRE, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 350,
     "Gefjon beruehrt ihr Amulett, und blickt Dich duester an.\n",
     "Gefjon beruehrt ihr Amulett und blickt @WEN duester an.\n",
     DT_MIND, ([SP_SHOW_DAMAGE:1]) );

  SetChats(5, ({
     "Gefjon nickt Dir freundlich zu und murmelt: Darf ich Dir etwas "
     "bringen?\n",
     "Gefjon murmelt: Wo ist denn diese Fortuna schon wieder?!\n",
     "Gefjon versinkt kurz in Gedanken und betet.\n",
     "Gefjon strahlt Dich mit ihren Augen an.\n",
     "Gefjon schaut etwas verloren aus.\n" }) );

  SetAttackChats(20, ({
     "Gefjon sagt: Du haettest mich nie angreifen sollen!\n",
     "Gefjon ruft: Das wird Dir noch leid tun!\n",
     "Gefjon murmelt: Ohne mich bist Du doch machtlos...\n" }) );

  SetProp( P_DIE_MSG, " verschwindet in einer Wolke.\n" );
  SetProp( P_NOCORPSE, 1 );

// INFOS!!!

  SetProp(P_DEFAULT_INFO, "sagt: Tut mir leid, aber darauf weiss ich "
     "auch keine Antwort.\n" );

  AddInfo( ({ "fortuna" }),
    "Keine Ahnung wo die schon wieder ist. Eben war sie noch in meiner "
    "Kueche! Vielleicht besucht sie Anvar, Elsurion oder gar Walpurgis! ", 
    "sagt: ");

  AddInfo( ({ "tee", "birkentee" }),
     "sagt: Ja den bereite ich immer aus den Blaettern der Birken zu.\n");
  
  AddInfo( ({ "weisheit" }),
     "sagt: Wenn Du weise sein willst, solltest Du Dich nicht an "
     "anderen messen.\n");

  AddInfo( ({ "met" }),
     "sagt: Ach der Met, ich bereite ihn mit einem Geheimrezept zu.\n");

  AddInfo( ({ "geheimrezept", "rezept" }),
     "sagt: Wir Hexen haben viele solcher Rezepte, aber die sind "
     "strengstens geheim. Ich darf es Dir leider nicht verraten.\n");

  AddInfo( ({ "hexen", "hexe" }),
     "sagt: Ja ich bin eine Hexe, aber ich erzaehle nicht gerne davon.\n");

  AddInfo( ({ "moor" }),
     "sagt: Das Moor findest Du ganz in der Naehe.\n");

  AddInfo( ({ "antwort" }),
     "sagt: Die Antwort birgst Du selbst in Dir.\n");

  AddInfo( ({ "froesche", "frosch" }),
     "sagt: Froesche haben eine heilende Wirkung.\n");

  AddInfo( ({ "wirkung" }),
     "sagt: Finde es selbst heraus!\n");

  AddInfo( ({ "moorhuhn", "moorschnucke", "libellen", "libelle" }),
     "sagt: Such doch einmal im Moor danach.\n");

  AddInfo( ({ "zaubertraenke", "zaubertrank" }),
     "Mir hat einmal jemand erzaehlt, dass ganz in der Naehe "
     "von Midas ein Mann lebt, der viel ueber Zaubertraenke weiss. Such "
     "ihn doch einmal auf.\n", "sagt: ");

  AddInfo( ({ "astarte" }),
     "sagt: Moegen die Goetter sie beschuetzen!!!!\n");

  AddInfo( ({ "gefjon" }),
     "sagt: Gefjon bin ja ich Du Duemmchen!\n");

  AddInfo( ({ "duemmchen" }),
     "sagt: Na Du bist eins, sonst wuerdest Du mich ja nicht danach "
     "fragen.\n");

  AddInfo( ({ "mann" }),
     "sagt: Tut mir leid, aber ich habe seinen Namen vergessen.\n");

  AddInfo( ({ "name", "namen" }),
     "antwortet: Gefjon ist ein schoener Name findest Du nicht?\n");

  AddInfo( ({ "midas", "hauptstadt" }),
     "murmelt: Midas ist die Hauptstadt des Silberlandes.\n");

  AddInfo( ({ "silberland", "silberlandes" }),
     "kichert.\n");

  AddInfo( ({ "kneipe" }),
     "sagt ganz stolz: Das ist meine Kneipe hier!\n");

  AddInfo( ({ "sex" }),
     "sagt: Ihr seid doch alle gleich! Wollt immer nur das eine!\n");

  AddInfo( ({ "clementine" }),
     "sagt: Clementine das Gurkerl hat mich erschaffen!\n");

  AddInfo( ({ "gurkerl" }),
     "sagt: Och, Gurkerl sag ich oft zu ihr, weil sie die so gerne isst.\n");

  AddInfo( ({ "birken", "birke", "blaetter", "blaettern" }),
     "sagt: Das findest Du alles im Moor.\n");

  AddInfo( ({ "moorhuhneier", "eier" }),
     "sagt: Die sind eine wahre Spezialitaet.\n");

  AddInfo( ({ "spezialitaet"}),
     "sagt: Schau Dir doch einfach mal mein Angebot an.\n");

  AddInfo( ({ "speisekarte", "karte", "angebot" }),
     "sagt: Die Speisekarte kannst Du mit 'menue' lesen.\n");

  AddInfo( ({ "buch", "malleus maleficarum" }),
     "schaut ernst und sagt: Das ist eine sehr ernste Sache, am besten "
     "waere wenn Du Astarte danach fragen wuerdest.\n");

  AddInfo( ({ "hexenhammer" }),
     "sagt: Der Hexenhammer war ein Buch, aber frag lieber mal "
     "Astarte.\n");

  AddInfo( ({ "problem", "probleme" }),
     "seufzt: Probleme gibt es viele...\n");   

  AddInfo( ({ "getraenke", "speisen", "essen", "trinken" }),
     "sagt: Schau Dir einfach mal die Speisekarte an!\n");

  AddInfo( ({ "leiche", "moorleiche" }),
     "sagt: Die bereite ich immer ganz frisch zu. Probiere sie doch!\n");

  AddInfo( ({ "ronja" }),
     "sagt: Ronja ist die beste aller Magierinnen!\n");

  AddInfo( ({ "magier", "magierinnen" }),
     "sagt: Nicht alle MagierInnen sind boese, es gibt auch einige nette.\n");

  AddInfo( ({ "polaris" }),
     "sagt: Ich lebe hier schon seit meiner Kindheit.\n");

  AddInfo( ({ "kindheit" }),
     "sagt: Meine ganze Kindheit verbrachte ich in Polaris.\n");

  AddInfo( ({ "trank" }),
     "sagt: Probieren geht ueber studieren.\n");

  AddInfo( ({ "kleine" }),
     "sagt: Kleine ist eine mutige Kriegerin.\n");

  AddInfo( ({ "kriegerin" }),
     "sagt: Clementine hat sie sehr brav erzogen.\n");    

  AddInfo( ({ "hilfe" }),
     "sagt: Geh doch zu Astarte und frag sie!\n");

  AddInfo( ({ "menue" }),
     "sagt: Tipp doch einfach mal 'menue'\n");

  AddInfo( ({ "naehe" }),
     "sagt: Na suchen musst Du schon selbst!\n");

  AddInfo( ({ "sache" }),
     "zuckt ratlos mit den Schultern.\n");

  AddInfo( ({ "goetter", "goettern" }),
     "sagt: Wir Hexen beten zu verschiedenen Goettern.\n");

  AddInfo( ({ "dante", "woody", "angel", "dusty", "thor",
              "buzzom", "roc", "angrox", "creative" }),
     "sagt: Alles Magier!\n");

  AddInfo( ({ "alter" }),
     "sagt: Ich bin schon 93 Jahre alt.\n");

  AddInfo( ({ "jahre", "jahr" }),
     "aechzt: Ja die Jahre gehen dahin...\n");

  AddInfo( ({ "gift" }),
     "sagt: Das ist sehr heikel!\n");

  AddInfo( ({ "feyaria" }),
     "sagt: Feyaria ist ein Schatz!\n");

  AddInfo( ({ "schatz" }),
     "sagt: Mit einem Schatz muss man sehr behutsam umgehen.\n");  

  AddInfo( ({ "katze", "katzen", "aberglaube" }),
     "sagt: Das ist doch nur ein Aberglaube der meisten, dass wir Katzen "
     "haben...\n");

  AddInfo( ({ "blocksberg", "berg" }),
     "Der Blocksberg ist ein geheimer Ort und ich werde Dir diesen "
     "sicherlich nicht verraten!\n", "sagt: " );

  AddInfo( ({ "pentagramm" }),
     "Mit der Spitze nach oben gerichtet, stellt das Pentagramm "
     "die vier Elemente Erde, Feuer, Wasser und Luft dar, "
     "die vom Geist ueberragt werden. Es ist ein Gluecksbringer und "
     "Abwehrzeichen gegen Daemonen und andere boese Kraefte.\n", "sagt: " );

  AddInfo( ({ "daemonen", "daemon" }),
     "betet zu den Goettern. ");

  AddInfo( ({ "rituale", "ritualen" }),
     "sagt: Frag doch lieber jemand anders. ");

  AddInfo( ({ "feuer" }),
     "raet Dir die Bibliothek aufzusuchen. ");

  AddInfo( ({ "bibliothek" }),
     "sagt: Nur Astarte weiss wo sie sich befindet. ");

  AddInfo( ({ "kessel" }),
     "sagt: Mit Kesseln brauen wir Zaubertraenke. "); 

  AddInfo( ({ "wasser", "feuer", "luft", "erde" }),
     "sagt: Das gehoert zu den vier Elementen. ");

  AddInfo( ({ "elemente", "elementen" }),
     "sagt: Wasser, Feuer, Luft, Erde. ");

  AddInfo( ({ "geist" }),
     "sagt: Die vier Elemente werden vom Geist ueberragt. ");

  AddInfo( ({ "ort" }),
     "sagt: Such ihn doch. ");

  AddInfo( ({ "gluecksbringer", "abwehrzeichen" }),
     "deutet auf das Pentagramm. ");

  AddInfo( ({ "kraefte" }),
     "sagt: Frag doch lieber wen anderen danach. ");

  AddInfo( ({ "treppe" }),
     "sagt: Ja hier gibt es eine versteckte Treppe. ");

  AddInfo( ({ "kueche" }),
     "fluestert: Probiers mal mit 'klopfe wand'. ");

  AddInfo( ({ "eicheln" }),
     "Die Eicheln haben wichtige Heilkraefte, ausserdem verwenden wir "
     "Hexen gerne bei bestimmten Ritualen.\n", "sagt: ");

  AddInfo( ({ "eiche" }),
     "Die Eiche ist ein sehr maechtiger Baum. Uns Hexen ist sie heilig. "
     "Sie soll uns daran erinnern, dass "
     "in uns ein Feuer entzuendet wurde, das uns erlaubt, uns selbst zu "
     "finden. Besonders am 21. Maerz gedenken wir ihr.\n", "sagt: ");

  AddInfo( ({ "maerz" }),
     "sagt: Ich hab Dir schon zuviel erzaehlt. ");

  AddInfo( ({ "baum", "baeume" }),
     "sagt: Baeume gibt es hier sehr viele. ");

  AddInfo( ({ "rinde" }),
     "Es gibt viele verschiedene Baumrinden...moechtest Du etwas ueber die "
     "Eichenrinde wissen, dann frag mich einfach danach.\n", "sagt: ");

  AddInfo( ({ "eichenrinde" }),
     "Die Eichenrinde hat heilende Wirkung auf vieles, vielleicht fragst "
     "Du lieber wen anderen. Ich bin momentan zu beschaeftigt.\n", "sagt: ");

  AddInfo( ({ "schluessel", "x" }),
     "sagt: Das geht Dich nichts an! ");
 
  AddInfo( ({ "studieren", "probieren" }),
     "beachtet Dich nicht. ");

  AddInfo( ({ "derlim" }),
     "sagt: Eine schoene Stadt ganz in der Naehe. ");

  AddInfo( ({ "amulett" }),
     "sagt: Finger weg! ");

  AddInfo( ({ "ritual", "rituale", "sabbat", "sabbate" }),
     "sagt: Ich rede nicht gerne darueber. ");

  AddInfo( ({ "zauber", "zauberspruch", "zaubern" }),
     "sagt: Wir Hexen sprechen oefter Zauber. ");

  AddInfo( ({ "tessa", "moppy" }),
     "sagt: Tessa ist Clementines Lieblingsspielerin! ");

  AddInfo( ({ "spielerin", "lieblingsspielerin" }),
     "antwortet: Tessa. ");

  AddInfo( ({ "zauberei" }),
    "sagt: Frag lieber eine andere Hexe. ");

  AddInfo( ({ "besen" }),
    "sagt: Moechtest Du denn den Boden kehren? ");

  AddInfo( ({ "gegenwart" }),
    "sagt: Jetzt und hier ist wichtig, nicht vergangenes. ");

  AddInfo( ({ "hyorkkin", "larva", "harbad" }),
    "sagt: Die wohnen auch hier. ");

  AddInfo( ({ "symbol", "symbole" }),
    "fragt: Welche? "); 
  
  AddInfo( ({ "hexenbraeu", "braeu" }),
	"Bestell doch einfach eins! Schmeckt Dir sicher!", "sagt: ");



  SetProp( P_REJECT, ({ REJECT_KEEP, "Gefjon sagt: Du bist aber lieb!\n" }) );


}

die(int poisondeath)
{
write_file(LOG("polaris.kills"), 
	dtime(time())+": "+CAP(getuid(TP))+" toetet Gefjon.\n");
::die(poisondeath);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
 if( killer == TO )
    write_file(LOG ("polaris.kills"),
       sprintf( ctime()+": Gefjon hat gerade  "+CAP(getuid(player))
       +" umgebracht - %d EP!\n", lostexp));
 return ;
}

