
// neue infos 10.6.2007 clementine.


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "../marisol.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Howard, der Bibliothekar" );
  SetProp(P_LONG,
    "Das ist Howard, der Bibliothekar. Er huetet schon seit vielen Jahren "
    "die Geheimnisse dieser Bibliothek. Er steht Dir sicherlich gern mit "
    "gutem Rat beiseite und beantwortet Dir Deine Fragen. ");
  SetProp(P_NAME, "Howard");
  set_living_name( "howard" );
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({ "howard", "bibliothekar", "mensch" }) );
  SetProp(P_LOG_INFO, "/clementine/howard");
  
  create_default_npc(20);
  SetProp(P_ALIGN, 1000 );
  SetProp(P_RACE, "Mensch" );
  SetProp(P_HANDS, ({ " mit seinen Haenden", QueryProp(P_HANDS)[1], 
                    DT_BLUDGEON }) );
  SetProp(P_RESISTANCE, ([ DT_FIRE: -0.5 ]) );
  
  SetProp(P_MSGIN, "kommt herein" );
  SetProp(P_REJECT, ({ REJECT_KEEP, "Howard dankt.\n" }) );  
  
  SetProp(P_DEFAULT_INFO, ({
    "sagt: Darueber musst ich noch gruendlicher nachdenken.\n",
    "gruebelt. \n",
    "seufzt.\n",
    "aechzt: Immer soviele Fragen!\n",
    "sagt: Tut mir leid das weiss ich wirklich nicht.\n",
    "zuckt ratlos mit den Schultern.\n",    
    "sagt: Alles weiss selbst ich leider nicht.\n",
    "sagt: Tut mir leid ich bin momentan sehr beschaeftigt.\n",
    "sagt: Frag doch bitte jemand anderen.\n" }) );


//********** AMAZORAS ALTE DETAILS, ETWAS UMGEBSCHRIEBEN **********\\
//********** BZW. HALBWEGS DEUTSCHE SAETZE DRAUS GEMACHT **********\\

  AddInfo( ({ "diener", "kreaturen", "shogotten", "shogotte" }),
    "Die Shogotten dienen den Alten als Diener. Sie wurden von ihnen "
    "aus unheiligem Protoplasma geschaffen. Sie haben die Faehigkeit "
    "ihre Gestalt nach Belieben zu veraendern. ", "sagt: ");
  
  AddInfo( ({ "planeten", "planet" }),
    "Zumeist waren es kalte und tote Welten, denn sie vernichteten alles "
    "Leben, dessen sie habhaft wurden. ", "sagt: ");

  AddInfo( ({ "yogsothoth", "yog", "yog-sothoth" }),
    "Yog-Sothoth ist das Tor. Yog-Sothoth ist Schluessel und Waechter "
    "des Tores. Vergangenheit, Gegenwart, Zukunft, alles ist Yog-Sothoth.",
    "fluestert: ");

  AddInfo( ({ "tor", "gegenwart", "zukunft", "vergangenheit" }),
    "wimmert.");

  AddInfo( ({ "schluessel" }),
    "fluestert: Yogsothoth.\n");;

  AddInfo( ({ "azathoth", "az" }),
    "Azathoth, der Blasenschlagende im Zentrum der Unendlichkeit.",
    "fluestert: ");

  AddInfo( ({ "shubb-niggurath", "shubb", "niggurath" }),
    "Die schwarze Ziege mit den tausend Jungen.", "fluestert: ");

  AddInfo( ({ "nyarlathothep", "nya" }),
    "Die Bestie mit den tausend Armen.", "fluestert: ");

  AddInfo( ({ "wesen", "geschoepfe" }),
    "Bizarre Geschoepfe von einem fremden Planeten. 13 an der Zahl. Cthulhu, "
    "Yogsothoth, Shudde-M'ell, Azathoth, Shubb-Niggurath, Nyarlathothep, "
    "Wendigo, Glaaki, Hastur, Yibb-Tsstl, Tsathoggua, Shodagoi, Cho-Cho.",
    "fluestert: ");
 
  AddInfo( ({ "wendigo", "wen" }),
    "Wendigo, der auf den Winden geht.", "fluestert: ");
 
  AddInfo( ({ "glaaki", "kometengeborene" }),
    "Glaaki, der Kometengeborene.", "fluestert: ");
  
  AddInfo( ({ "cthuga", "flammende" }),
    "Cthuga, der Flammende.", "fluestert: ");
  
  AddInfo( ({ "hastur", "cho-cho", "cho", "shodagoi", "yibb", "yibb-tsstl",
              "tsathoggua" }),
    "Wesen von geringerer Macht, trotzdem noch schrecklicher als Goetter "
    "in ihrem Zorn!", "fluestert: ");
  
  AddInfo( ({ "cthulhu", "anfuehrer" }),
    "Allen voran steht Cthulhu, der oktopide Herr des Schreckens und der "
    "Schatten, ein Wesen, dessen Element das Meer ist, der sich aber "
    "genauso muehelos an Land oder auch in der Luft fortzubewegen vermag.",
    "fluestert: ");
  
  AddInfo( ({ "shudde", "mell", "shudde-m'ell", "shuddemell" }),
    "Shudde-M'ell, der ewig Eingegrabene und Herrscher ueber die Erde "
    "und die finsteren Reiche der Hoehlen.", "fluestert: ");
  
  AddInfo( ({ "dinge" }), 
    "Jaja, seltsame Dinge gehen hier vor. Die Zeit draengt!", 
    "wird auf einmal ganz still und murmelt kaum verstaendlich: ");

  AddInfo( ({ "satansanbeter" }),
    "Hier wimmelt es nur von Satansanbetern. Kaum vernichtest Du "
    "einen kommt auch schon der naechste.", "sagt: ");

  AddInfo( ({ "grosse alten", "grossen alten", "grosse", "alten", "daemonen",
              "grosse alte", "alte" }),
    "Es sind bizarre Geschoepfe, so unsagbar fremd. Ihre Namen waren so "
    "fremdartig wie ihre Gestalt: "
    "Yog-Sothoth, Shudde-M'ell, und Cthulhu, der ihr Anfuehrer war. "
    "Sie nannten sich selbst die GROSSEN ALTEN, und obwohl ihre Zahl klein "
    "war, herrschten sie doch ueber Tausende von Planeten.",
    "sagt: ");

  AddInfo( ({ "necronomicon" }),
    "Es wurde mir von den Satansanbetern gestohlen. Es ist ein ungeheuer "
    "wichtiges Buch und in den falschen Haenden hoechst gefaehrlich!",
    "sagt: ");

//*************** NEUE INFOS BY CLEMENTINE@SL ***************\\

  AddInfo( ({ "hexen", "hexe" }),
    "Mit ihnen komme ich sehr gut zurecht. Sie sind sehr liebenswuerdig und "
    "helfen immer wenn man ein Problem hat. ", "sagt: ");

  AddInfo( ({ "howard" }),
    "sagt: So heisse ich! ");

  AddInfo( ({ "buecher" }),
    "Buecher sind fuer mich das Wertvollste was es gibt. In ihnen "
    "wird ungeheures Wissen aufbewahrt. ", "sagt: ");
 
  AddInfo( ({ "wertvoll", "wertvolles" }),
    "sagt: Buecher!\n");
 

  AddInfo( ({ "buch" }),
    "sagt: Meinst Du ein Bestimmtes? ");

  AddInfo( ({ "wissen" }),
    "sagt: Wissen ist das einzige was einem niemand mehr wegnehmen kann. ");

  AddInfo( ({ "gefjon" }),
    "sagt: Gefjon ist die Besitzerin der Kneipe. ");

  AddInfo( ({ "hyrokkin" }),
    "sagt: Ihr gehoert der Hexenladen. ");

  AddInfo( ({ "harbad" }),
    "sagt: Harbad ist ganz in Ordnung. ");

  AddInfo( ({ "clementine" }),
    "sagt: Die schaut oefters hier vorbei. ");

  AddInfo( ({ "bestimmtes" }),
    "sagt: Welches denn? ");

  AddInfo( ({ "drache" }),
    "sagt: Man erzaehlt sich, dass es hier in der Naehe einen Drachen gibt. ");

  AddInfo( ({ "kneipe", "laden", "hexenladen" }),
    "sagt: Gar nicht so weit entfernt von hier. ");

  AddInfo( ({ "name", "namen" }),
    "sagt: Ich heisse Howard! ");

  AddInfo( ({ "wanduhr", "uhr" }),
    "sagt: Betritt sie wenn Du mutig bist...");

  AddInfo( ({ "bibliothek" }),
    "sagt: Du befindest Dich doch in ihr. ");

  AddInfo( ({ "geheimnisse"}), 
    "sagt: Es gibt sicherlich noch viele zu entdecken. ");

  AddInfo( ({ "stadt", "polaris" }),
    "sagt: Ein Hexenvoelkchen hat sich hier niedergelassen. ");

  AddInfo( ({ "voelkchen", "hexenvoelkchen" }),
    "sagt: Ich hab sie alle sehr gerne. ");

  AddInfo( ({ "regal" }),
    "fragt: Musst Du nicht weiter? ");

  AddInfo( ({ "hilfe"}),
    "fragt: Wobei soll ich Dir helfen? ");
 
  AddInfo( ({ "tod"}),
    "sagt: Frag doch einfach Lars, der kennt sich sicher damit aus. ");

  AddInfo( ({ "lars" }),
    "sagt: Dem begegnest Du sicherlich bald wieder. ");
 
  AddInfo( ({ "problem"}),
    "fragst: Hast Du denn eines? ");
  
  AddInfo( ({ "gefahr" }),
    "sagt: Ich moechte nicht darueber reden. ");
  
  AddInfo( ({ "schwarzes buch" }),
    "Das ist hoffentlich gut versteckt. Du musst wissen, dass Polaris in "
    "Wirklichkeit das Tor zu Unterwelt ist und das Tor zu den maechtigen "
    "Alten...niemand sollte sich ihnen naehern. ", "sagt: ");

  AddInfo( ({ "satan" }),
    "fragt: Stellst Du ihn mir mal vor? ");
  
  AddInfo( ({ "leben" }),
    "sagt: Ich moechte nicht darueber sprechen. ");

  AddInfo( ({ "bewohner" }),
    "sagt: Hier bin nur ich, such sie besser weiter oben. ");

  AddInfo( ({ "unterwelt" }),
    "sagt: Angeblich liegt in Polaris das Tor zur Unterwelt versteckt. ");

  AddInfo( ({ "zeit", "uhrzeit" }),
    "Ach die genaue Uhrzeit kann ich Dir leider auch nicht sagen. Meine "
    "Wanduhr ist vor einiger Zeit stehen geblieben. ", "sagt: ");
 
  AddInfo( ({ "globus"}),
    "sagt: Irgendwo stand hier noch ein alter herum. ");
 
  AddInfo( ({ "stern", "sterne"}),
    "sagt: Unter freiem Himmel sieht man wohl sicher oefter welche. ");
  
  AddInfo( ({ "erde"}),
    "Die Erde ist eine Kugel, aber Dir brauch ich das ja nicht "
    "zu erzaehlen. Du weisst das sicherlich alles schon. ", "sagt: ");  
 
  AddInfo( ({ "lebensweg"}),
    "sagt: Den musst Du wohl selbst herausfinden. ");
 
  AddInfo( ({ "birken"}),
    "Einige Birken hab ich auf meinem Weg hierher schon wachsen sehen. Aber "
    "ich bin alt, ich verbringe meine Zeit lieber hier anstatt wild "
    "herumzutollen. ", "sagt: ");
  
  AddInfo( ({ "formel"}),
    "sagt: Irgendwelche Lausbengeln spielen mir da wohl immer Streiche. ");

  AddInfo( ({ "lausbengeln", "lausbengel", "bengel", "lausebengel", 
    "streich", "streiche" }),
    "sagt: Sicherlich der kleine Sargola. ");

  AddInfo( ({ "sargola" }),
    "grinst Dich an. ");
  
  AddInfo( ({ "glaube", "religion"}),
    "sagt: Ich glaube an das, was ich sehe. ");
  
  AddInfo( ({ "vergessenheit"}),
    "Manchmal geraten Dinge einfach in Vergessenheit, da kann man oft nicht "
    "viel dagegen tun...leider...", "sagt: ");

  AddInfo( ({ "amalthea", "ring", "amaltheas ring" }),
    "Amaltheas Ring? Da solltest Du besser Oma Wetterwachs fragen!", "sagt: ");

  AddInfo( ({ "oma", "oma wetterwachs", "wetterwachs" }),
    "sagt: Die wohnt irgendwo im Moor.\n");

  AddInfo( ({ "moor" }),
    "Ich glaub das ist ganz in der Naehe!", "sagt: ");

  AddInfo( ({ "brief" }),
    "fragt: Hast Du mir einen geschrieben?\n");

  AddInfo( ({ "berg", "blocksberg" }),
    "Angeblich treffen sich die Hexen auf dem Blocksberg zu Ritualen.", 
    "sagt: ");

  AddInfo( ({ "problem", "probleme" }),
    "sagt: Ich hab keine Probleme!\n");

  AddInfo( ({ "rat" }),
    "fragt: Brauchst Du denn einen?\n");

  AddInfo( ({ "freunde" }),
    "sagt: Viele habe ich nicht.\n");

  AddDetail( ({ "bildung" }),
    "sagt: Bildung ist ja so wichtig!\n");

  AddInfo( ({ "protoplasma" }),
    "seufzt.");

  AddInfo( ({ "magie", "sache" }),
    "sagt: Magie ist eine ernste Sache!\n"); 

  AddInfo( ({ "symbol", "symbole", "zeichen" }),
    "fragt: Was meinst Du?\n");

  AddInfo( ({ "geheimnis", "geheimnisse" }),
    "fragt: Verraetst Du mir eines?\n");

  AddInfo( ({ "welt" }),
    "murmelt: Die Welt ist schlecht...\n");

  AddInfo( ({ "menschen", "menschheit" }),
    "sagt: Alles zum Untergang geweiht!\n");

  AddInfo( ({ "astarte" }),
    "sagt: Da frag mal besser Gefjon.\n");

  AddInfo( ({ "zauberer", "zauberstab", "magier", "rettung" }),
    "sagt: Frag lieber eine Hexe danach!\n");

  AddInfo( ({ "geheimbibliothek", "bibliothek"}),
    "sagt: Blick Dich ruhig um!\n");

  AddInfo( ({ "einmaleins" }),
    "Ich weiss nicht ob ich hier irgendwelche mathematischen Buecher fuer "
    "Dich hab.", "sagt: ");

  


 }
 
     
