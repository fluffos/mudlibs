inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../marisol.h"

create()
{
  if( !is_clone(this_object()) ) return;
  ::create();


  SetProp(P_SHORT, "Ein langer Lederrock");
  SetProp(P_LONG,
    "Dieser Rock besteht aus festem dunkelbraunen Leder. Er wurde "
    "in muehsamster Arbeit von Hand gefertigt. Es scheint als wuerde "
    "er sehr viel aushalten. ");
  SetProp(P_INFO, "Dieser Rock sieht sehr stabil aus. ");
  SetProp(P_NAME, "Lederrock");
  AddId( ({ "rock", "lederrock" }) );
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 650);
  SetProp(P_AC, 6);
  SetProp(P_QUALITY_DECAY, 130);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_MATERIAL, MAT_LEATHER);

  AddDetail( ({ "leder" }),
    "Stabiles dunkelbraunes Leder. ");

  AddDetail( ({ "arbeit", "hand" }),
    "Du kannst Dir gar nicht vorstellen wieviel Arbeit das ist!");

}
