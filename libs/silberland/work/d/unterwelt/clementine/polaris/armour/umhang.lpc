
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include "../marisol.h"

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein seltsamer Umhang");
  SetProp(P_LONG, 
     "Dieser Umhang wurde aus einem seltenen Stoff gefertigt. "
     "Trotz seiner eher grauen Farbe faellt er Dir besonders "
     "auf. Er scheint seinen Traeger vor bestimmten Gefahren "
     "schuetzen zu koennen. ");
  SetProp(P_INFO,"Dieser Umhang schuetzt vor gewissen Gefahren.");
  SetProp(P_NAME, "Umhang" );
  SetProp(P_NAME_ADJ, "seltsam");
  AddAdjective( ({ "seltsamen", "seltsamer", "seltsamem", "seltsames", 
                   "seltsame" }) );
  SetProp(P_GENDER, MALE);
  AddId( ({ "umhang" }) );
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([ MAT_COTTON:50, MAT_FELT:30, MAT_VELVET:20 ]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 2900);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, ([ DT_WATER : 10, DT_TERROR : 10, DT_ACID : 10,
                              0 : 30 ]) );

  AddProp(P_DAM_PROTECTION, ([DT_WATER:1, DT_TERROR:1, DT_ACID:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL:35,P_XP:30000000]) );

  AddDetail( ({ "farbe" }),
    "Eine graue unscheinbare Farbe, dennoch strahlt er irgendetwas "
    "seltsames aus. ");

  AddDetail( ({ "stoff" }),
    "Sehr selten und aussergewoehnlich. Nicht einmal Wasser koennte ihm "
    "Schaden zufuegen. ");
  
  AddDetail( ({ "seltsames" }),
    "Es scheint ein magischer Schutz gegen Giftattacken und zu lautes "
    "Bruellen zu sein. ");

  AddDetail( ({ "gefahren" }),
    "Er scheint Dich vor verschiedensten Angriffen Deiner Gegner zu "
    "schuetzen. ");

  AddDetail( ({ "wasser", "giftattacken", "bruellen" }),
    "Hmm...");


}


