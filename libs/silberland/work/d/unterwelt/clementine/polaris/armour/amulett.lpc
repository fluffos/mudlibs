inherit "std/armour";

#include <language.h>
#include <properties.h>
#include <material.h>
#include <moving.h>
#include <combat.h>
#include "../marisol.h"

create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();

  SetProp(P_SHORT, "Ein magisches Amulett");
  SetProp(P_LONG,
    "An einer duennen Lederschnur wurde dieses Amulett aufgefaedelt. "
    "Es besteht aus feinstem Silber, in seiner Mitte "
    "wurde ein tiefroter Rubin angebracht, an dessen Oberflaeche "
    "sich verschiedenste Symbole befinden. Von diesem Amulett geht eine "
    "magische Kraft aus. ");

  AddId( ({ "amulett" }) );
  SetProp(P_NAME, "Amulett");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_INFO, "Dieses Amulett ist etwas sehr Kostbares.");
  SetProp(P_MATERIAL, ([MAT_LEATHER:40, MAT_SILVER:40, MAT_RUBY:20]) ); 
  SetProp(P_WEIGHT, 150);
  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, 4);
  SetProp(P_VALUE, 1500);
  SetProp(P_QUALITY_DECAY, ([ DT_ACID : 10, DT_FIRE : 10, 0 : 30 ]) );
  SetProp(P_NOBUY, 1);
  
  SetProp(P_DAM_PROTECTION, ([ DT_ACID:1, DT_FIRE:1 ]) );
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL:20]) );

  AddDetail( ({ "symbole" }),
    "Magische Symbole wurden an der Oberseite des Rubines eingraviert. ");

  AddDetail( ({ "rubin" }),
    "So einen schoenen Rubin haben Deine Augen noch nie zuvor erblickt. ");

  AddDetail( ({ "kraft" }),
    "Von diesem Amulett scheint eine magische Kraft auszugehen. ");

  AddDetail( ({ "silber" }),
    "Das Amulett besteht aus Silber, in seiner Mitte wurde ein Rubin "
    "eingefasst. ");

  AddDetail( ({ "lederschnur", "schnur" }),
    "An einer duennen Lederschnur wurde das Amulett aufgefaedelt. ");

  AddDetail( ({ "oberflaeche", "oberseite" }),
    "An der Oberflaeche des Rubins wurden einige Symbole eingraviert. "
    "Leider kannst Du sie nicht genau erkennen. ");


  AddCmd( ({ "beruehr", "beruehre" }), "c_beruehren");

}

int c_beruehren( string str )
{
 notify_fail("Was moechtest Du genau beruehren?\n");
 if(!(str == "oberflaeche" || str == "oberseite" || str == "rubin"))
 return 0;
// }
// if( str == "oberflaeche"  ||
//     str == "oberseite"    ||
//     str == "rubin"        )
 {
  write("Vorsichtig faehrst Du mit Deinen Fingern ueber die "
        "Oberseite des Rubins.\n"
        "Dir scheint als wuerde sich ein Satz vor Deinen Augen bilden.\n"
        "\n"
        "Ehre dem Pentagramm, Sieg seinen Streitern!!!\n");
  return 1;
 }
}

