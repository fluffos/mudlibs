
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Schildkroete");
  SetProp(P_LONG,
     "Das hier ist Deine eigene Schildkroete. Gluecklich blickt sich "
     "Dich mit ihren kleinen Aeuglein an. Auch fuer ein Stofftier ist "
     "sie eher winzig. Ihr dunkelgruener Panzer ist ganz flauschig, so "
     "richtig schoen kuschelig. Um eines ihrer Beinchen wurde eine "
     "rote Schleife gebunden. ");
  SetProp(P_NAME, "Schildkroete");
  AddId( ({ "schildkroete", "kroete", "schildi" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 230);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_ARTICLE, 1);

  AddReadDetail( ({ "schleife" }),
    "<*< Knuddel und Drueck mich >*> steht da drauf. ");
   
  AddDetail( ({ "schleife" }),
    "Eine schoene rote Schleife wurde um eins ihrer Beinchen gebunden. Auf "
    "ihr steht etwas. ");

  AddDetail( ({ "panzer" }),
    "Ihr dunkelgruener Panzer ist wunderbar weich und flauschig. So richtig "
    "schoen zum Druecken. ");

  AddDetail( ({ "aeuglein", "kulleraugen" }),
    "Kleine schwarze Kulleraugen blicken Dich froehlich an. ");

  AddDetail( ({ "stofftier" }),
    "Richtig niedlich ist Deine Schildkroete. ");  

  AddDetail( ({ "beinchen" }),
    "Sie streckt alle vier Beinchen von sich. An einem von ihnen wurde "
    "eine rote Schleife herumgebunden. ");

  AddCmd( ({ "knuddl", "knuddle", "knuddel", "knuddele" }), "c_knuddeln" );
  AddCmd( ({ "flausch", "flausche" }), "c_flauschen" );
  AddCmd( ({ "drueck", "druecke" }), "c_druecken" );
 
 

}


int c_knuddeln( string str )
{
 if( !id(str) )
 {
  notify_fail("Was moechtest Du knuddeln?\n");
  return 0;
 }
 if( id(str) )
 {
  write(BS("Du knuddelst liebevoll Deine Schildkroete. "
        "Mit riesigen Augen blickt sie Dich gluecklich an, und quietscht "
        "dabei leisen. "));
  return 1;  
 }
}
 

int c_flauschen( string str )
{
 if( !id(str) )
 {
  notify_fail("Was moechtest Du flauschen?\n");
  return 0;
 }
 if( id(str) )
 {
  write(BS("Froehlich flauscht Du Deine Schildkroete von oben "
        "bis unten durch. Sie blickt Dich lieb an und quietscht dabei "                 "vergnuegt. "));
  return 1;
 }
}

int c_druecken( string str )
{
 if( !id(str)         &&
     str != "panzer"   )
 {
  notify_fail("Was moechtest Du druecken?\n");
  return 0;
 }
 if( id(str) )
 {
  write(break_string("Ganz fest umarmst Du mit Deinen Armen Deine "
        "Schildkroete und drueckst sie ganz zaertlich an Dich. "));
  return 1;
 }
 if( str == "panzer" )
 {
  write("Du drueckst zaertlich auf den Panzer Deiner "
       "Schildkroete.\n"
       "Fiiieep....\n"
       "Deine Schildkroete piepst froehlich vor sich hin.\n");
  return 1;
 }
}
 
