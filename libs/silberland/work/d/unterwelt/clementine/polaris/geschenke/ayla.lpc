inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Aylastatue");
  SetProp(P_LONG,
    "Eine wirklich gelungene Nachahmung Aylas, in Miniformat. "
    "Ihr langes verfilztes Haar und ihr eingedellter Koerper verleihen "
    "Ayla wahrhaftig das Aussehen einer Goettin. In Aylas Augen kannst Du "
    "sogar noch ihren Alkspiegel von letzter Nacht ablesen. Etwas Rotz trieft "
    "aus ihrer Nase - Pfui! Um ihren Hals haengt ein kleiner Zettel. "); 
  SetProp(P_NAME, "Aylastatue");
  AddId( ({ "ayla", "statue", "aylastatue" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 400);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_ARTICLE, 1);
 
  AddDetail( ({ "zettel" }),
    "Lesen sollte angeblich helfen! ");

  AddDetail( ({ "nacht" }),
    "Scheint wohl eine lange Nacht gewesen zu sein. ");

  AddDetail( ({ "haar", "haare" }),
     "Ueberall verfilzte lange Haare - igitt! Aber Spass machen wuerde "
     "es sicherlich sie daran zu ziehen! ");

  AddDetail( ({ "rotz" }),
     "Etwas Rotz rinnt aus ihrer etwas zu gross geratenen Nase. Schenk "
     "der armen doch mal ein Taschentuch bei Deinem naechsten Besuch. ");

  AddDetail( ({ "nase" }),
     "An einem Schoenheitswettbewerb kann die mit ihrer Nase sicherlich nicht "
     "teilnehmen! ");

  AddDetail( ({ "koerper" }),
     "Ihr Koerper ist ueberseht von Dellen, die ihr ein laecherliches "
     "Aussehen verleihen. ");

  AddDetail( ({ "aussehen" }),
     "So sieht also eine bildhuebsche Goettin aus :) ");

  AddDetail( ({ "goettin" }),
     "Blabla :) ");

  AddDetail( ({ "alkspiegel" }),
     "War wohl ne durchzechte Nacht gestern... ");

  AddDetail( ({ "augen" }),
     "Sogar die dunkelsten Flecken dieser Welt erscheinen im Gegensatz zu "
     "ihren Augenringen als schneeweiss. ");

    
 

  AddReadDetail( ({ "zettel" }),
    "+----------------------------------------+\n"
    "|                                        |\n"
    "|        GARANTIERT ROSTFREI !!!         |\n"
    "|                                        |\n"
    "|    Das ideale Geschenk fuer alle !     |\n"
    "|       Wuerg mich! Hau mich!            |\n"
    "|                                        |\n"
    "|                         (c) Clementine |\n"
    "+----------------------------------------+\n");

  
  AddCmd( ({ "zieh", "ziehe" }), "c_ziehen");
  AddCmd( ({ "wuerg", "wuerge" }), "c_wuergen");
  AddCmd( ({ "hau", "haue" }), "c_hauen");

}

int c_ziehen( string str )
{
 if( str != "ayla an haaren"        &&
     str != "statue an haaren"      &&
     str != "aylastatue an haaren"  )
 {
  notify_fail("Woran moechtest Du ziehen?\n");
  return 0;
 }
 else
 {
  write(BS("Voller Gewalt ziehst Du an Aylas Haaren! Haha, das macht "
            "Spass! Fester und mit mehr Gewalt! "));
  say(CTPN+ " zieht Ayla an den Haaren und lacht.\n");
  return 1;
 }
}
int c_wuergen( string str )
{
 if( !id(str) )
 {
  notify_fail("Wuerge Wen oder Wie?\n");
  return 0;
 }
 else
 {
  write(BS("Mit einem breitem Grinser umfasst Du mit "
           "Deinen Haenden den Hals Deiner Aylastatue und drueckst "
           "genuesslich zu. Dich ueberkommt ein Gefuehl von tiefer, totaler "
           "und absoluter Zufriedenheit! :) "));
  say(CTPN+ " ueberkommt ein Gefuehl tiefster "
            "Zufriedenheit.\n" );
  return 1;
 }
}

int c_hauen( string str )
{
if( !id(str) )
 {
  notify_fail("Wen willst Du hauen?\n");
  return 0;
 }
 else
 {
  write(BS("Du laesst Deinen Aggressionen vollen Lauf und pruegelst "
           "mit Deiner Faust auf Ayla ein. Juhuuu! Endlich bekommt dieses "
           "Miststueck das, was sie in Wirklichkeit verdient!!! "));
  say(CTPN+ " gibt Ayla den Rest!\n");
  return 1;
 }
}
 
