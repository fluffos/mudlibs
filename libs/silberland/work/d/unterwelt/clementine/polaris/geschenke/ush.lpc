inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Ushstatue" );
  SetProp(P_LONG,
    "Ein kleiner mickriger Quarzgolem, dessen Kopf einfach nur laecherlich "
    "auf seinem eckigen Riesenkoerper wirkt. Mit starren Augen gafft er Dich "
    "an. Seine Fuesse und Beine wirken grob und unbeweglich. Ush ist wirklich "
    "keine Schoenheit. Etwas scheint in seinen Popo eingeritzt worden "
    "zu sein. ");
  SetProp(P_NAME, "Ushstatue");
  AddId( ({ "ush", "statue", "ushstatue", "golem", "quarzgolem" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 560);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_ARTICLE, 1);

  AddDetail( ({ "fuesse", "beine" }),
    "Die sind einfach nur starr und unbeweglich - deshalb fluechtet er wohl "
    "nie vor Dir. ");

  AddDetail( ({ "augen", "glupschaugen" }),
    "Irgendwelche kleinen Glupschaugen. ");

  AddDetail( ({ "koerper", "riesenkoerper" }),
    "Wenn es Haesslichkeitswettbewerbe geben wuerde, wuerde Ush sicherlich den "
    "ersten Preis gewinnen. ");

  AddDetail( ({ "kopf" }),
    "Fuehlt sich etwas leer an! ");

  AddDetail( ({ "popo" }),
    "Scheint als haette jemand dort einen Zettel eingebrannt. ");

  AddDetail( ({ "zettel" }),
    "Cooles Branding :) Du kannst ihn sicherlich noch lesen. ");
  
  AddReadDetail( ({ "zettel" }),
    "+----------------------------------------+\n"
    "|                                        |\n"
    "|        GARANTIERT ROSTFREI !!!         |\n"
    "|                                        |\n"
    "|    Das ideale Geschenk fuer alle !     |\n"
    "|       Wuerg mich! Hau mich!            |\n"
    "|                                        |\n"
    "|                         (c) Clementine |\n"
    "+----------------------------------------+\n");


  AddCmd( ({ "wuerg", "wuerge" }), "c_wuergen");
  AddCmd( ({ "hau", "haue" }), "c_hauen");

}

int c_wuergen( string str )
{
 if( !id(str) )
 {
  notify_fail("Wuerge Wen oder Wie?\n");
  return 0;
 }
 else
 {
  write(BS("Froehlich grinsend umfasst Du mit Deinen Haenden den "
           "Hals Deiner Ushstatue und drueckst genuesslich zu. "
           "Als Ushs Augen schon fast herausquellen, seufzt Du erholt "
           "auf. "));
  say(CTPN+ " quietscht vergnuegt, als sie Ush halb umbringt.\n");
  return 1;
 }
}

int c_hauen( string str )
{
 if( !id(str) )
 {
  notify_fail("Wen willst Du hauen?\n");
  return 0;
 }
 else
 {
  write(BS("Mit Deiner maechtigen Faust zertruemmerst Du Ush fast den "
           "ganzen Schaedel. Da kann er mal schaun, was ihm seine "
           "Brocken nuetzen!!! Rache ist suess!!!" ));
  say(CTPN+ " freut sich auf einmal total.\n");
  return 1;
 }
}

