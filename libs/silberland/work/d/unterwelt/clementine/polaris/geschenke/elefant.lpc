inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Elefant");
  SetProp(P_LONG,
     "Ein kuscheliger plueschiger grauer Elefant. Er hat gaaaaaaaanz "
     "grosse lange Ohren, und die liebsten Kulleraugen, die "
     "Du je gesehn hast. Sein kleines Schwaenzchen wackelt "
     "froehlich hin und her. ");
  SetProp(P_NAME, "Elefant");
  AddId( "elefant");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 200);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_ARTICLE, 1);

  AddCmd( ({ "knuddel", "knuddl", "knuddle" }), "c_knuddeln");

}

int c_knuddeln( string str )
{
 if( !id(str) )
 {
  notify_fail("Was moechtest Du knuddeln?\n");
  return 0;
 }
 if( id(str) )
 {
  write(BS("Du knuddelst liebevoll Deinen Elefanten. Und er "
           "kuckt Dich noch viel lieber mit seinen Knopfaugen "
           "an und trompetet dabei leise und zufrieden. "));
  return 1;
 }
}

