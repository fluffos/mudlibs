inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../marisol.h"
create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Pinguin");
  SetProp(P_LONG,
     "Ein supertoller kuscheliger Plueschpinguin grinst Dich suess mit "
     "seinen schwarzen Augen an. Sein Fell ist ganz schwarz, bis auf den "
     "weissen Streifen auf seinem Bauch. Aus seinem Schnabel kommen "
     "manchmal sogar einige Schnattergeraeusche. Eine kleiner "
     "unscheinbarer Zettel "
     "haengt an seinem Ohr. "
     "Der Pinguin hat es sicher gern wenn Du ihn streichelst. ");
  SetProp(P_NAME, "Pinguin");
  AddId( "pinguin");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_ARTICLE, 1);

  AddReadDetail( ({ "zettel" }),
    "\n"
    "LINUX RULEZ!!!!!!!!!!!!!!\n"
    "\n");

  AddCmd( ({ "streichel", "streichl", "streichle" }), "c_streicheln");

}

int c_streicheln( string str )
{
 if( !id(str) )
 {
  notify_fail("Streichel wen?\n");
  return 0;
 }
 if( id(str) )
 {
  write(BS("Du faehrst vorsichtig ueber das Fell Deines Pinguins, "
           "und beginnst ihn von oben bis unten durchzustreicheln. "
           "Wow! Ist der kuschelig! So richtig suess! "));
  return 1;
 }
}


