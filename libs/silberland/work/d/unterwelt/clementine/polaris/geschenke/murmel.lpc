
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Murmel");
  SetProp(P_LONG,
    "Eine kleine Murmel, die in den seltensten Blautoenen im Licht "
    "funkelt. Irgendetwas scheint Dich in ihren Bann gezogen zu haben, "
    "sodass Du kaum Deine Augen abwenden moechtest. In ihrem Inneren "
    "befindet sich ein kleines Stueck Papier, auf das einige "
    "Buchstaben gekritzelt wurden.");
  SetProp(P_NAME, "Murmel");
  AddId( ({ "murmel" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 0);
  SetProp(P_INFO, "Die Murmel fluestert Dir zu: Spiel mit mir!");

  AddDetail( ({ "blautoene", "blaus", "toene" }),
	  "Die Murmel glitzert total schoen in den verschiedensten Blaus. ");

  AddDetail( ({ "bann" }),
	  "Die Murmel scheint etwas Geheimnisvolles in ihrem Inneren zu "
	  "verbergen. ");

  AddDetail( ({ "geheimnisvolles", "geheimnisvoll", "geheimnis" }),
	  "Noch liegt es im Verborgenen. ");

  AddDetail( ({ "verborgenes", "verborgenen" }),
	  "Weit entfernt von Dir...");

  AddDetail( ({ "papier", "stueck" }),
	  "Irgendetwas steht darauf geschrieben. Leider kannst Du es so "
	  "nicht naeher erkennen. ");

  AddDetail( ({ "inneres", "inneren" }),
	  "So nah kommst Du da nicht ran. ");

  AddDetail( ({ "buchstaben" }),
	  "Vielleicht muss man ja etwas Bestimmtes tun, damit man die "
	  "Buchstaben lesen kann. ");
	  
  
  AddCmd( ({ "spiele", "spiel" }), "c_spielen");

}

int c_spielen( string str )
{
 if( str != "mit murmel")
 {
  notify_fail("Womit moechtest Du spielen?\n");
  return 0;
 }
 else
 {
  write(BS("Vorsichtig laesst Du die kleine Murmel vor Dir auf dem Boden "
           "rollen. Das Buchstabengekritzel wird ploetzlich genau "
           "sichtbar: "
           "Im wiegenden Tanze verfliegt die Schwere der Welt, drum dreht "
           "euch und lacht, solang es gefaellt!"));
  return 1;
 }
}

