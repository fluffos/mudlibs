inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Balrogstatue" );
  SetProp(P_LONG,
    "Die wunderschoene Nachahmung des Balrogs in Miniaturformat. "
    "Sein Kopf aehnelt dem eines Stieres, seine ekelerregende Fratze "
    "gafft Dich an. Seine riesigen Hoerner wirken einfach nur laecherlich "
    "und sein Koerper sieht aus, als haette er Masern. Ein kleiner Zettel "
    "haengt um seinen Hals. ");
  SetProp(P_NAME, "Balrogstatue");
  AddId( ({ "balrog", "statue", "balrogstatue" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 300);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_ARTICLE, 1);
  
  AddDetail( ({ "koerper" }),
    "Es sieht aus als haette der Balrog Masern. Kleine rote Flecken "
    "bedecken seinen Koerper. ");

  AddDetail( ({ "flecken" }),
    "Hihi. ");

  AddDetail( ({ "hoerner" }),
    "Laecherliche Hoerner hat er auf dem Kopf. ");

  AddDetail( ({ "kopf", "stier" }),
    "Der Kopf aehnelt dem eines Stieres wirkt aber irgendwie einfach "
    "nur plump. ");

  AddDetail( ({ "fratze" }),
    "Eckige faule Zaehne blicken aus der Fratze. Man sollte ihn mal "
    "zum Zahnarzt schicken. ");

  AddDetail( ({ "zettel" }),
    "Du kannst ihn lesen. ");

  AddReadDetail( ({ "zettel" }),
    "+----------------------------------------+\n"
    "|                                        |\n"
    "|        GARANTIERT ROSTFREI !!!         |\n"
    "|                                        |\n"
    "|    Das ideale Geschenk fuer alle !     |\n"
    "|       Wuerg mich! Hau mich!            |\n"
    "|                                        |\n"
    "|                         (c) Clementine |\n"
    "+----------------------------------------+\n");


  AddCmd( ({ "wuerg", "wuerge" }), "c_wuergen");
  AddCmd( ({ "hau", "haue" }), "c_hauen");

}

int c_wuergen( string str )
{
 if( !id(str) )
 {
  notify_fail("Wuerge Wen oder Wie?\n");
  return 0;
 }
 else
 {
  write(BS("Lachend umfasst Du mit Deinen Haenden den Hals Deiner "
          "Balrogstatue und drueckst genuesslich zu. Ein wundervolles "
          "Gefuehl! "));
  say(CTPN+ " wuergt genuesslich eine Balrogstatue.\n");
  return 1;
 }
}

int c_hauen( string str )
{
 if( !id(str) )
 {
  notify_fail("Wen willst Du hauen?\n");
  return 0;
 }
 else
 {
  write(BS("Du holst aus und zertruemmerst dem Balrog mit Deiner "
           "maechtigen Faust fast den ganzen Kopf! Das macht "
           "soviel Spass! Endlich leidet diese Kreatur einmal richtig! "));
  say(CTPN+ " toegelt auf eine Statue ein.\n");
  return 1;
 }
}

