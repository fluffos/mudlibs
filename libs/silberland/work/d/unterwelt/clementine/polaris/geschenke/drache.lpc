


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../marisol.h"

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Drachenstatue" );
  SetProp(P_LONG, 
    "Dies ist die perfekte Nachbildung eines Drachens. "
    "Seinen riesigen Augen blicken Dich gnadenlos an. "
    "Es scheint, als wuerden sogar noch die Adern an seiner Haut zucken. Mit "
    "seinen spitzen Zaehnen koennte er Dich jeden Moment verschlingen, wenn "
    "er lebendig waere. An einer seiner Krallen haengt ein etwas "
    "unscheinbarer Zettel. ");
  SetProp(P_NAME, "Drachenstatue" );
  AddId( ({ "drache", "statue", "drachenstatue" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 320);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_ARTICLE, 1);


  AddDetail( ({ "krallen" }),
    "Da haengt doch glatt ein etwas unscheinbarer Zettel. ");
 
  AddDetail( ({ "zettel" }),
    "Du kannst doch sicherlich lesen, oder?! ");

  AddDetail( ({ "augen" }),
    "Sie starren Dich kalt an. ");

  AddDetail( ({ "nachbildung" }),
    "Die haeltst Du in Deinen Haenden. ");

  AddDetail( ({ "zaehne" }),
    "Wenn er leben wuerde, wuerde Dich dieser Drache mit seinen spitzen "
    "Zaehnen sofort verschlingen. ");

  AddDetail( ({ "adern" }),
    "Es scheint als wuerden die Adern an seinem Koerper noch zucken. ");

  AddDetail( ({ "koerper" }),
    "Furchteinfloessend waere er, wuerde er nicht bloss 'nur' eine "
    "Nachbildung sein. ");

  AddDetail( ({ "haut" }),
    "Seine rauhe Haut ist mit Adern durchzogen. ");

  AddReadDetail( ({ "zettel" }),
    "+----------------------------------------+\n"
    "|                                        |\n"
    "|        GARANTIERT ROSTFREI !!!         |\n"
    "|                                        |\n"
    "|    Das ideale Geschenk fuer alle !     |\n"
    "|       Tritt mich in den A****!         |\n"
    "|                                        |\n"
    "|                         (c) Clementine |\n"
    "+----------------------------------------+\n");

  AddCmd( ({ "trete", "tret", "tritt" }), "c_treten" );
  AddCmd( ({ "hau", "haue" }), "c_hauen" );

}

int c_treten( string str )
{
 if( str != "drache in hintern"     &&
     str != "drache in hinterteil"  &&
     str != "drache in a****"       )
 {
  notify_fail("Wenn Du schon was nach tritt tippst, dann sag mir "
              "wen oder wie ich das soll.\n");
  return 0;
 }
 else
 {
  write(BS("Mit vollem Genuss trittst Du den Drachen in seinen "
            "Allerwertesten, er soll fuer alles buessen was Dir jemals "
            "ein Drache angetan hat! Volles Abreagieren ist angesagt! "));
  say(CTPN+ " tritt einem Drachen in den Popo.\n");
  return 1;
 }
}

int c_hauen( string str )
{
 if( !id(str) )
 {
  notify_fail("Wen willst Du hauen?\n");
  return 0;
 }
 else
 {
  write(BS("Du toegelst mit voller Gewalt auf Deine Statue ein. "));
  say(CTPN+ " toegelt mit voller Gewalt auf einen "
                              "Drachen ein.\n");
  return 1;
 }
}

