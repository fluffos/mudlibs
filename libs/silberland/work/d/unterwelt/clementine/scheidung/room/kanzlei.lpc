#include <properties.h>
#include <language.h>
#include "../scheidung.h"

inherit "std/room";

void create()

{
   ::create();

   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 1 );
   SetProp(P_INT_SHORT,"Die Anwaltskanzlei");
   SetProp(P_INT_LONG,
   "Die Kanzlei von Anwalt Emil Heinrich Eduard Garaus ist "
   "zweckmaessig und solide eingerichtet, "
   "ein riesiger Schreibtisch bildet den Mittelpunkt des holzvertaefelten "
   "Zimmers. Zwei Stuehle stehen davor, ein Sessel dahinter und ein "
   "etwas kuemmerlicher Gummibaum fristet sein Leben in einer der dunklen "
   "Zimmerecken. Bis auf die eine Wand im Norden, an der eine grosse Tafel "
   "haengt, stehen allen anderen Waenden Regale mit Buechern und "
   "Aktenordnern. ");

   AddDetail( ({ "garaus", "emil", "heinrich", "eduard" }),
     "So heisst der Anwalt dieser Kanzlei.");

   AddDetail( ({ "kanzlei","anwaltskanzlei","buero","anwaltsbuero" }),
   "Die Anwaltskanzlei E. H. E. Garaus hat sich auf Scheidungen "
   "spezialisiert.");

   AddDetail( ({ "anwalt","rechtsanwalt" }),
   "Der Anwalt Emil Heinrich Eduard Garaus hat sich auf Scheidungen "
   "spezialisiert. Seine "
   "jahrelangen Erfahrungen garantieren eine schnelle und einfache "
   "Scheidung.");

   AddDetail( ({ "erfahrung","erfahrungen" }),
   "Die Erfahrungen hat er bei den vielen Scheidungen, die er "
   "durchfuehren musste, gesammelt.");

   AddDetail( ({" zimmer", "raum" }),
   "Du stehst in einem Anwaltsbuero.");

   AddDetail( ({ "stube", "amtsstube", "amtsstuben" }),
   "Du stehst in der Amtsstube eines Rechtsanwalts.");

   AddDetail(({ "scheidung", "scheidungen"}),
   "Hier kann sich jeder scheiden lassen - ob nun mit oder ohne Einwilligung"
   "des Gatten oder der Gattin.");

   AddDetail( ({ "einwilligung", "einwilligungen" }),
   "Wie leben in modernen Zeiten, da braucht man die Einwilligung des"
   "Partners nicht mehr.");

   AddDetail( ({ "zeit", "zeiten" }),
   "Ticktack...ticktack..ticktack...");

   AddDetail( ({ "gatte", "gattin", "ehegatte", "ehegattin", "ehegatten" }),
   "So nennt man die Teilnehmer einer Ehe.");

   AddDetail( ({ "ehe" }),
   "Ehe - wehe, wenn ich auf das Ende sehe.");

   AddDetail( ({ "ende" }),
   "Hier kann man das Ende eine Ehe herbeifuehren lassen.");

   AddDetail( ({"teilnehmer" }),
   "Die Teilnehmer einer Ehe kann man auch Ehepartner nennen.");

   AddDetail(({ "partner", "ehepartner", "teil", "teile"}),
   "2 Teilnehmer + 1 Hochzeit = Ehe");

   AddDetail( ({ "ehefrau", "ehefrauen" }),"Weiblicher Teil einer Ehe.");

   AddDetail( ({ "ehemann", "ehemaenner"}),"Maennlicher Teil einer Ehe.");

   AddDetail( ({ "hochzeit" }),
   "Die Hochzeit ist das Gegenteil der Scheidung.");

   AddDetail( ({ "gegenteil" }),
   "Das Gegenteil der Scheidung ist die Hochzeit.");

   AddDetail( ({ "tisch", "schreibtisch" }),
   "Der mit Papieren uebersaehte Schreibtisch nimmt fast das gesamte"
   " Zimmer ein.");

   AddDetail(({ "papier", "papiere", "scheidungspapier", "scheidungspapiere"}),
   "Auf der Tischplatte liegen vor allem die Scheidungspapiere, die der"
   " Anwalt gerade bearbeitet.");

   AddDetail( ({ "tischplatte", "platte" }),
   "Auf der Tischplatte steht ausserdem eine Oellampe, ein Stapel mit"
   " Formularen und ein Stempelstaender.");

   AddDetail( ({ "oellampe", "lampe"}),
   "Eine ganz herkoemmliche Lampe, die den Schreibtisch beleuchtet.");

   AddDetail( ({ "oel" }),"Das ist in der Lampe.");

   AddDetail( ({ "stapel", "formulare", "formular" }),
   "Die Formulare werden fuer die Scheidungen gebraucht.");

   AddDetail( ({ "stempelstaender", "staender"}),
   "In dem Stempelstaender haengen verschiedene Stempel.");

   AddDetail( ({"stempel"}),
   "Mit den Stempel werden die Formulare abgestempelt."
   " Danach ist die Scheidung amtlich.");

   AddDetail( ({ "mittelpunkt" }),
   "Den bildet der Schreibtisch.");

   AddDetail( ({ "stuehle", "stuhl", "holzstuhl", "holzstuehle" }),
   "Die beiden Holzstuehle sind schlicht gehalten.");

   AddDetail( ({ "sorte", "holzsorte", "holz"}),
   "Die Sorte kann man nicht genau erkennen.");

   AddDetail( ({ "sessel" }),
   "Auf dem Sessel sitzend fuehrt der Anwalt die Scheidungen durch.");

   AddDetail( ({ "baum", "gummibaum" }),
   "Der Gummibaum ist ziemlich verkuemmert. Kein Wunder, er steht ja"
   " auch in einer der dunklen Zimmerecken.");

   AddDetail( ({ "leben" }),"Der Gummibaum lebt so grade eben noch.");

   AddDetail( ({ "stamm" }),
   "Der Stamm sieht ziemlich geknickt aus.");

   AddDetail( ({ "knick" }),
   "Wahrscheinlich fehlt ihm Licht.");

   AddDetail( ({ "blatt", "blaetter" }),
   "Die grosssen Blaetter des Gummibaums sind etwas verstaubt.");

   AddDetail( ({ "staub" }),
   "Die ganzen Papiere stauben, so dass es hier etwas staubig ist.");

   AddDetail( ({ "licht" }),
   "Durch die Holzvertaefelung ist es hier ziemlich dunkel. Die beiden"
   " Fenster an der Nordwand lassen auch nicht viel Licht herein. Richtig"
   " hell ist es eigentlich nur in der Naehe der Oellampe.");

   AddDetail( ({ "naehe" }),"In der Naehe der Oellampe ist es hell.");

   AddDetail( ({ "holzvertaefelung", "vertaefelung"}),
   "Der Raum ist an den sichtbaren Stellen mit Holz vertaefelt.");

   AddDetail( ({"stelle", "stellen" }),
   "Sehr viele freie Stellen gibt an den Waenden nicht, weil da ja die"
   " Regale stehen.");

   AddDetail( ({ "wand", "waende" }),
   "An den Waenden stehen Regale.");

   AddDetail( ({ "boden" }),
   "Der Boden besteht aus braunen Holzdielen.");

   AddDetail( ({ "dielen", "diele", "holzdiele", "holzdielen"}),
   "Ganz gewoehnliche Holzdielen.");

   AddDetail( ({ "decke" }),
   "Eine weiss gestrichene Decke ohne Besonderheiten.");

   AddDetail( ({ "besonderheit", "besonderheiten" }),"Keine da.");

   AddDetail( ({ "nordwand"}),
   "An der Nordwand haengt eine grosse Tafel.");

   /*
   AddDetail( ({"Fenster"}),
   "Die beiden Fenster lassen nicht viel Tageslicht herein. Das liegt"
   " an den Baeumen, die davor stehen.");

   AddDetail( ({"Baeume","Laubbaeume","Tageslicht"}),
   "Vor den Fenstern stehen Laubbaeume, die wenig Tageslicht hereinlassen.");
*/
   AddDetail( ({ "regal", "regale" }),
   "Auf den Regalen stehen haufenweise Buecher ueber Scheidungsrecht.");

   AddDetail( ({ "buch", "buecher" }),
   "Die Buecher haben nur ein Thema: Scheidungsrecht.");

   AddDetail( ({ "thema", "themen", "lieblingsthema", "lieblingsthemen" }),
   "Das Lieblingsthema des Anwalts ist Scheidungsrecht.");

   AddDetail( ({ "recht", "scheidungsrecht" }),
   "Interessieren Dich etwa die Details einer Scheidung?"),

   AddDetail( ({ "detail", "details" }),
   "Och, noe! Besuch lieber ein Seminar an der Uni Deiner Wahl.");

   AddDetail( ({ "seminar", "seminare" }),
   "Der Anwalt bietet keine Seminare an.");

   AddDetail( ({ "uni", "universitaet" }),
   "Dort kannst Du Scheidungsrecht studieren.");

   AddDetail( ({ "wahl" }),
   "Wahl kommt von waehlen - oder umgekehrt...");

   AddDetail( ({ "wunder", "wuuuunder"}),
   "Ich weiss, es wird 'mal ein Wuuuunder geschehen...");

   AddDetail( ({ "ecke", "ecken", "zimmerecken", "zimmerecke" }),
   "In einer der dunklen Zimmerecken steht ein kuemmerlicher"
   " Gummibaum.");

   AddDetail( ({ "ordner", "aktenordner", "akten"}),
   "In den ledergebundenen Ordner lagern die Scheidungsurkunden"
   " von vielen Mandanten des Anwalts.");

   AddDetail( ({ "scheidungsurkunde", "scheidungsurkunden" }),
   "Die sind in den Aktenordnern abgelegt worden.");

   AddDetail( ({"leder"}),"Dunkelbraunes Leder.");

   AddDetail( ({"mandant", "mandanten"}),
   "Bist Du ein poentieller Mandant? Dann solltest Du die Tafel lesen.");

   AddDetail( ({"etwas"}),
   "Du schaust Dich etwas genauer um und siehst auf einmal etwas Graues"
   " zwischen den Buechern huschen.");

   AddDetail( ({ "graues" }),
   "Etwas Grauweisses.");

   AddDetail( ({ "grauweisses" }),
   "Ein Amtsschimmel galoppiert zwischen Buechern und Aktenordnern"
   " umher!");

   AddDetail( ({ "schimmel", "amtsschimmel" }),
   "Ein niedlicher, kleiner Schimmel wiehert Dich an und verschwindet"
   " hinter einem Gesetzesband.");

   AddDetail( ({ "gesetzesband" }),
   "Der Gesetzesband ist nicht weiter interessant.");

   AddDetail( ({"gewuenschter scheidung","gewuenschte scheidung",
               "erwuenschte scheidung", "erwuenschter scheidung" }),
   "Bei der gewuenschten Scheidung muessen beide Partner anwesend sein."
   " Frag den Anwalt nach gewuenschter Scheidung und er wird die"
   " Voraussetzungen ueberpruefen und Dich dann ueber den weiteren Ablauf"
   " informieren.");

   AddDetail( ({"unverhoffter scheidung","unverhoffte scheidung",
               "ungewollte scheidung" }),
   "Bei der unverhofften Scheidung muss der Ehepartner anwesend sein,"
   " der die Ehe aufzuloesen wuenscht. Fuer den, der nicht anwesend ist,"
   " kann diese Scheidung durchaus unverhofft kommen ;-)\n"
   "Ein Grossteil der Gebuehr wird als Spende an das Heim fuer verlassene"
   " Ehemaenner und Ehefrauen weitergeleitet. Frag den Anwalt nach"
   " unverhoffter Scheidung und er wird Dich ueber den weiteren Ablauf"
   " informieren.");

   AddDetail( ({ "ablauf" }),"Den erklaert der Anwalt.");

   AddDetail( ({ "voraussetzungen", "voraussetzung" }),"Bringen Sie die mit?");

   AddDetail( ({"grossteil","spende"}),
   "Ein Grossteil der Scheidungsgebuehren wird an das Heim fuer verlassene"
   " Ehemaenner und Ehefrauen als Spende weitergeleitet.");

   AddDetail( ({"gebuehr", "gebuehren", "scheidungsgebuehr",
			   "scheidungsgebuehren" }),
   "Die Gebuehren fuer eine Scheidung stehen auf der Tafel.");

   AddDetail( ({ "heim" }),"Das ist draussen.");

   AddDetail( ({"tafel"}),"Die Tafel kann man lesen.");

//********* Geraeusche***********

   AddSound(DEFAULT_SOUND, "Ueberall rascheln Papiere.");
   AddSound( ({ "papiere" })," Die rascheln.");
   AddSound(({ "rascheln" }),
   "Das Rascheln hoert sich an, als ob sich da etwas durch die Papiere"
   " wuehlt.");
   AddSound( ({ "etwas" }), "Mhm, hast Du Dich getaeuscht?");
   AddSound( ({ "anwalt" }), "Der Anwalt raschelt mit den Papieren.");

//*********Duefte****************

   AddSmell(DEFAULT_SMELL,"Das Buero riecht nach staubigen Papier.");
   AddSmell( ({"Papier","Staub"}),
   "Das Papier staubt. Deshalb riecht es hier vorwiegend nach Staub.");

//*******Ausgaenge***************

   AddExit("osten", ANSCHLUSS_UNTERWELT);
//   AddExit("sueden",HOME);

//*******Kommandos***************

   AddCmd( ({"lies" ,"lese", "les" }),"c_lesen");
   AddCmd( ({"fang", "fange", "nimm", "nehme", "nehm" }),"c_nehmen");

}


int c_lesen(string str)
{
   if(!str)
   {
    write("Was moechtest Du lesen?\n");
    return 1;
   }

   if(str=="buch" || str=="buecher" || str=="gesetzesband")
   {
    write("Die Buecher sind voellig uninteressant.\n");
    return 1;
   }

  if(str=="akte" || str=="akten" || str=="aktenordner" || str=="Dokumente")
  {
   write("Du willst doch wohl nicht in den Dokumenten herumschnueffel?\n");
   return 1;
  }

 if(str=="formular" || str=="formulare")
  {
   write("Die Formulare sind stinklangweilig.\n");
   return 1;
  }

 if(str=="tafel")
  {
   write
   (
   " - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n"
   "| <>               Scheidungsgebuehren                 <> |\n"
   "|                                                         |\n"
   "|                                                         |\n"
   "|   Gewuenschte Scheidung:.................500 Muenzen    |\n"
   "|                                                         |\n"
   "|   Unverhoffte Scheidung:...............5.000 Muenzen    |\n"
   "|                                                         |\n"
   "|                                                         |\n"
   "|                  unt <...> Scheidung                    |\n"
   "|                                                         |\n"
   "| <>                                                   <> |\n"
   " - - - - - - - - - - - - - - - - - - - - - - - - - - - - -\n"
   );
   say(this_player()->Name() +" liest die Tafel an der Nordwand.\n");
   return 1;
  }
 return 0;
}

int c_nehmen (string str)
{
  if (str=="schimmel" || str=="amtsschimmel" )
  {
    write(
    "Du versuchst den Amtsschimmel zu greifen, aber er entwischt Dir immer wieder.\n"
    "Lass ihn lieber weiter in Freiheit durch die Amtsstuben galoppieren!\n");
    return 1;
  }
 return 0;
}

