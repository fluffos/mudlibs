inherit "std/npc";
inherit "std/npc/spells";


#include "../scheidung.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>


void create()
{
 if (!is_clone(this_object()))
 return;

  ::create();

  SetProp(P_SHORT, "Emil Heinrich Eduard Garaus");
  SetProp(P_LONG, 
     "Vor Dir steht Emil Heinrich Eduard Garaus - oder kurz E.H.E. Garaus "
     "genannt - ein wahrer Meister auf dem Gebiet des Scheidungsrechts hier "
     "im Silberland. "
     "Seine schon etwas schuetternen Haare sind penibelst zu einem "
     "Seitenscheitel gekaemmt. Wie es sich fuer einen Anwalt gehoert "
     "traegt er selbstverstaendlich einen Anzug. ");
  SetProp(P_NAME, "Emil Heinrich Eduard Garaus");
  set_living_name( "Emil Heinrich Eduard Garaus");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Wasserelfe" );
  AddId( ({ "garaus", "e.h.e. garaus", "emil", "heinrich", "eduard",
	    "emil heinrich eduard garaus", "mensch", "anwalt" }) );
 
  create_default_npc(35);
  SetProp(P_ALIGN, 0);
  SetProp(P_BODY, 400);
  SetProp(P_FRIEND, 1);
  SetProp(P_SIZE, 163);
  SetProp(P_NOATTACK, "");
  SetProp(P_REJECT, ({ REJECT_GIVE, 
     "Emil Garaus sagt: Danke nein!\n" }) );

  SetProp(P_LOG_INFO, "/clementine/garaus");

  SetProp(P_DEFAULT_INFO, "gruebelt.\n");

  AddInfo( ({ "hilfe" }),
	"Bei einer Scheidung kann ich Sie gerne tatkraeftig unterstuetzen! "
	"Ich bin der beste auf meinem Gebiet", "sagt: ");
 
  AddInfo( ({ "scheidung", "scheidungen" }),
	"Scheidungen kommen heutzutage auch in den besten Familien vor!", 
        "sagt: ");

  AddInfo( ({ "gebiet" }),
        "Ich bin Experte auf dem Gebiet Scheidungen.", "sagt: ");

  AddInfo( ({ "hochzeit", "heirat" }),
	"Hochzeiten werden meines Erachtens nach viel zu uebereilt. Kaum ist "
	"ein Gefuehl der Verliebtheit da heiraten zwei Parteien, und sobald "
	"dieses Gefuehl wieder weg ist haben wir den Salat (und ich die "
	"Arbeit).", "sagt: ");

  AddInfo( ({ "arbeit" }),
	"Als Scheidungsanwalt hat man immer Arbeit - sie hoert nie auf.", 
	"freut sich: ");

  AddInfo( ({ "scheidungsanwalt", "anwalt" }),
	"Ich bin Scheidungsanwalt aus Ueberzeugung!", "sagt: ");

  AddInfo ( ({ "ueberzeugung" }),
	"Es gibt viel zu viele unueberlegte Hochzeiten. Ein wahrer "
	"Traumberuf!", "sagt: ");

  AddInfo( ({ "beruf", "traumberuf" }),
	"Anwalt fuer Scheidungsrecht ist mein Traumberuf!", "sagt: ");

  AddInfo( ({ "garaus", "e.h.e. garaus", "ehe garaus", "emil heinrich eduard",
	      "e. h. e. garaus", "e.h.e.", "e. h. e.", "emil garaus",
	      "emil heinrich eduard garaus", "emil", "heinrich", "eduard" }),
	"Mein Name ist Emil Heinrich Eduard Garaus - und ich mache jeder "
	"Ehe schnell den Gar aus!", "schmunzelt: ");

  AddInfo( ({ "ehe" }),
	"Die Ehe ist heutzutage ein ueberaltertes Modell des Zusammenlebens."
	"sagt: ");

  AddInfo( ({ "zusammenleben" }),
	"Nur weil man zusammenlebt, muss man noch lange nicht heiraten!", 
	"sagt: ");

  AddInfo( ({ "modell" }),
	"Die Ehe hat heutzutage ausgedient; trotzdem heiraten sehr viele.",
	"sagt: ");

  AddInfo( ({ "woody", "lamuerte", "angrox", "dante", "cirion", "iwo" }),
	 "Will der sich auch scheiden lassen?", "fragt: ");

  AddInfo( ({ "clementine" }),
	 "Falls sie sich je scheiden lassen will, kann ich gerne ihre "
	 "Scheidung durchfuehren. ", "sagt: ");

  AddInfo( ({ "liebe" }),
	 "Wer braucht schon die Liebe?! Ich lebe seit Jahrzehnten auch "
	 "gluecklich ohne ihr!", "sagt: ");

  AddInfo( ({ "glueck" }),
	"Glueck haben Sie bei einer einvernehmlichen Scheidung! Die kostet "
	"deutlich weniger!", "sagt: ");

  AddInfo( ({ "einvernehmliche scheidung", "einvernehmlicher scheidung" }),
	"Dafuer muessen aber auch beide Parteien anwesend sein!", "sagt: ");

  AddInfo( ({ "parteien" }),
	"Na Sie, und Ihr Ehepartner.", "sagt. ");

  AddInfo( ({ "ehepartner", "partner" }),
	"Der Ehepartner wird vollkommen ueberschaetzt bei Scheidungen...",
	"grinst: ");

  AddInfo( ({ "gefuehl", "gefuehle" }),
	"Gefuehle werden heutzutage einfach ueberschaetzt. ", "sagt: ");

  AddInfo( ({ "familien", "familie" }),
	"Haben Sie ueberhaupt eine?!", "sagt: ");

  AddInfo( ({ "salat" }),
	"Salat schmeckt mir!", "sagt: ");

  AddDetail( ({ "scheidungsrecht", "recht" }),
        "Ich bin _der_ Experte schlechthin wenn es um Scheidungen geht!",
	"sagt: ");

  AddDetail( ({ "experte" }),
	"Ich bin ein Experte im Scheidungsrecht. Natuerlich wuerde ich auch "
	"nie ohne einen handfesten Ehevertrag heiraten!", "sagt: ");

  AddDetail( ({ "ehevertrag", "vertrag" }),
	"Hast Du keinen?!", "bemitleidet Dich: ");

  AddDetail( ({ "verliebtheit", "verliebtsein" }),
	"Jaja, die Jugend von heute!", "sagt: ");

  AddDetail( ({ "jugend" }),
	"Nichts als Unsinn im Kopf!", "sagt: ");

  AddDetail( ({ "unsinn", "kopf" }),
	"Sie haben wohl auch nur Unsinn im Kopf gehabt, sonst waeren Sie wohl "
	"kaum hier!", "sagt. ");

  AddDetail( ({ "jahrzehnte" }),
	"Sehr sehr lange Zeit.", "sagt: ");

  AddDetail( ({ "zeit" }),
	"Wollen Sie sich jetzt scheiden lassen, oder vergeuden Sie nur meine "
	"Zeit?!", "fragt: ");

  AddInfo( ({ "max" }),
	"hirtet um Dich herum.");

}
