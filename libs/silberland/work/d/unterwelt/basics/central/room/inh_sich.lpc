#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine dunkle Hoehle" );
  SetProp(P_INT_LONG,
    "Die endlosen Gaenge der Unterwelt verbreitern sich hier zu einer "
    "kleinen Hoehle. Die Decke bleibt jedoch etwa gleich niedrig wie "
    "zuvor. Die Schatten in der Hoehle koennen nicht verbergen, dass "
    "sich ueberall etwas bewegt. Du weisst zwar nicht wieso, aber Du bist "
    "Dir sicher, dass es sich um Sichelschrecken handelt...");

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 25+random(5), ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Nichts Besonderes am Boden zu sehen. Jedenfalls keine Wuermer oder "
    "sowas."
  );

  AddDetail( ({ "decke" }),
    "Die Decke ist felsig und kahl. Sie befindet sich nicht weit ueber Dir. "
    "Du koenntest sie mit den Haenden sogar beruehren."
  );

  AddDetail( ({ "sichelschrecken" }),
    "Es scheint wohl gerade keiner Appetit auf Dich zu haben. Glueck gehabt!"
  );

  AddDetail( ({ "wand", "waende", "hoehlenwaende" }),
    "Die Hoehlenwaende sind hier mit Moos bewachsen. Von irgendwoher "
    "duerfte Feuchtigkeit einsickern."
  );

  AddDetail( ({ "moos" }),
    "Dichtes Moos waechst auf den felsigen Waenden. Einige Insekten "
    "krabbeln darauf herum."
  );

  AddDetail( ({ "feuchtigkeit" }),
    "Die Waende sind sehr feucht und bilden ideale Lebensbedingungen fuer "
    "das Moos. Moeglicherweise befindet sich ueber Dir auf der Oberwelt "
    "ein Gewaesser, das fuer diese Feuchtigkeit verantwortlich ist."
  );

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "schatten" }),
    "Ueberall bewegt sich etwas. Wehe Dir, wenn diese Kreaturen aus den "
    "Schatten treten, um Dich zu fressen!"
  );

  AddDetail( ({ "insekten", "insekt", "exemplare" }),
    "Eine seltsame Art von Insekten ist das. Kopf, Rumpf, sechs Beine und "
    "Fuehler sind ja noch normal, aber was haben diese riesigen Zangen "
    "zu bedeuten?"
  );

  AddDetail( ({ "zangen", "klauen", "klauenzangen" }),
    "Abscheuliche Klauenzangen, die die Haelfte des Insekts ausmachen. "
    "Gut, dass diese Tiere nur ein paar Zentimeter gross sind. Wenn Du "
    "ameisengross waerst, wuerdest Du Dich sofort umdrehen und um Dein "
    "Leben laufen, falls Dir das mit beschmutzter Hose gelaenge..."
  );

  AddDetail( ({ "rumpf", "kopf", "beine", "fuehler" }),
    "Alles relativ normal, wie Insekten eben. Nur scheint die Panzerung "
    "bei diesen Exemplaren ziemlich dick zu sein."
  );

  AddDetail( ({ "panzerung" }),
    "Die Panzerung der Insekten schuetzt sie wahrscheinlich ein wenig vor "
    "den Zangen ihrer Artgenossen."
  );

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Aufgeben gilt nicht!\n");
  return 0;
}

