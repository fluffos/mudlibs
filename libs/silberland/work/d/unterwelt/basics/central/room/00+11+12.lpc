#include "../def.h"

inherit "std/room";

int brocken;

void create()
{
  ::create();

  UMASTER->Customize(TO);

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2] +
    "In der Decke gaehnt ein dunkles Loch."
  );

  AddDetail( ({ "decke", "loch" }),
    "Da ist ein Loch in der Decke. Darueber scheint ein Gang oder sowas zu "
    "sein, jedenfalls koenntest Du leicht hinaufklettern. Das Loch ist sicher "
    "durch gehoerige Gewalteinwirkung entstanden, denn ueberall am Boden "
    "liegen noch Truemmer und Brocken der ehemaligen Decke herum."
  );

  AddDetail( ({ "boden" }),
    QueryProp(P_DETAILS)["boden"] +" Ausserdem liegen viele Steintruemmer "
    "herum."
  );

  AddSpecialDetail(({"brocken", "steinbrocken", "truemmer"
                    , "steintruemmer", "stein", "steine" }),
    "detail_brocken");

  AddExit("westen"  , ROOM "00+11+11");

  AddCmd(CMD_NEHMEN   , "cmd_nehmen");
  AddCmd(CMD_KLETTERN , "cmd_klettern" );

  brocken = 1;
}

void reset()
{
  ::reset();

  brocken = 1;
}

string detail_brocken(string str)
{
  string s;

  if(brocken)
  {
    s = "Viele Steinbrocken, die von der ehemaligen Decke abgebrochen "
        "sind, liegen herum. Du kannst ja einen mitnehmen, wenn sie Dir "
        "so gefallen.";
  }
  else
  {
    s = "Viele nutzlose Steine. Vollkommen uninteressant.";
  }

  return BS(s);
}

int cmd_nehmen(string str)
{
  object ob;

  notify_fail("Was moechtest Du nehmen?\n");

  if(!str || str == "") return 0;

  if(!(str == "brocken"         ||
       str == "steinbrocken"    ||
       str == "truemmer"        ||
       str == "steintruemmer"   ||
       str == "stein"           ||
       str == "steine"          )) return 0;

  if(brocken)
  {
    TELLPLAYER("Wozu? Nutzlose Steine. Machst Dir hoechstens die Haende "
               "dreckig.\n");
    return 1;
  }

  ob = clone_object(OBJ "brocken");

  if(ob->move(TP,M_GIVE) == 1)
  {
    TELLPLAYER("Du nimmst einen der vielen Steinbrocken und steckst ihn ein.\n");
    TELLOTHERS(TPN+" hebt einen Brocken vom Boden auf und steckt ihn ein.\n");
    brocken=0;
  }
  else
  {
    TELLPLAYER("Du traegst schon viel zu viel bei Dir.\n");
    ob->remove();
  }

  return 1;
}

int cmd_klettern(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");

  if(!str || str == "") return 0;

  if(!(str == "hinauf"     ||
       str == "rauf"       ||
       str == "loch"       ||
       str == "durch loch" ||
       str == "hoch"       )) return 0;

  if(TP->QueryProp(P_MV) < 55)
  {
    TELLPLAYER("Du bist viel zu erschoepft. Ruh Dich kurz aus!\n");
  }
  else
  {
    TELLPLAYER("Du springst hoch und kletterst dann muehelos nach oben.\n");

    TP->move("/d/gebirge/angrox/room/ebene4/ebene4_x6y1.lpc", M_GO, "nach oben",
       "klettert durch ein Loch in der Decke",
       "klettert durch ein Loch im Boden herein");

    TP->SetProp(P_MV, TP->QueryProp(P_MV) - 55);
  }

  return 1;
}
