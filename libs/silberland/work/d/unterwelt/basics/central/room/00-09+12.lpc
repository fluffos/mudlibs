#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  UMASTER->Customize(TO);

  AddDetail ( ({ "decke" }), GetDetail("decke")[0..<2]+
    " Ausserdem bemerkst Du einen dunklen Fleck."
  );

  AddDetail ( ({ "fleck" }),
    "Als Du den Fleck genauer betrachtest, erkennst Du, dass es "
    "sich um ein Brot mit Verhackertem handelt. Wie das wohl da an "
    "die Decke kommt???"
  );

  AddDetail ( ({ "brot" }),
    "Also irgendwie sieht das so aus, als ob es schon einmal "
    "gegessen worden waere."
  );

  AddDetail ( ({ "verhackertes" }),
    "Pfui, sieht das grauslich aus! Dir kommt schon bei dem Gedanken, "
    "das essen zu muessen alles hoch... *wuerg*"
  );

  AddExit("sueden"     , ROOM "00-10+12");
  AddExit("nordwesten" , ROOM "00-08+11");
}

