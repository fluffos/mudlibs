#include "../def.h"
#include <defines.h>
#include <moredef.h>
#include <combat.h>


inherit "std/room";
mapping users=([]);
int wand_tasten(string str);
int finger_in_loch(string str);
string unt_loch();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein eingestuerzter Gang" );
  SetProp(P_INT_LONG,
    "Auf einmal nimmt der Gang ein abruptes Ende. Der Gang geht hier nicht "
    "weiter und endet an einer roh behauenen Felswand. Es sieht so aus als "
    "wurde hier nicht mehr weitergegraben und die Bauarbeiten eingestellt. "
    "Das Skelett nahe der Wand laesst darauf schliessen, das einst Zwergen"
    "sklaven hier gegraben haben.");

  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20+random(3),
                          ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_KILL_NAME, "Ein kleiner Stich");

  AddDetail( ({ "decke" }),
    "Die Decke hier ist roh behauen. Ausser Fels kannst Du nicht viel "
    "erkennen."
  );

  AddDetail( ({ "boden" }),
    "Auf dem Boden liegt das Skelett eines Zwerges. Um seine nun "
    "skelettierten Beine sind noch Fussfesseln zu sehen."
  );
  
  AddDetail( ({ "skelett", "zwerges", "zwergenskelett","zwergenskelettes"}), 
      "Das Skelett liegt in verdrehter Haltung vor dem Gangende.");
  AddDetail( ({ "haltung" }),
      "Der Zwerg liegt in einer seltsamen Haltung: Arme und Beine " 
      "sind ausgestreckt, die Haende zeigen in Richtung Gangende.");
  AddDetail( ({ "arme", "beine","haende" }),
      "Die Arme und Beine des Zwergenskelettes sind ausgestreckt, "
      "die Arme zeigen Richtung Gangende.");
  AddDetail( ({"richtung"}),
      "Gangende. Sie zeigen in Richtung Gangende.");
  AddDetail( ({"bauarbeiten"}),
      "Die wurden wohl schon vor langem beendet.");
  AddDetail( ({"zwergensklaven"}),
      "Nun ist von dem Zwergensklaven nur mehr ein Skelett uebrig.");
  AddDetail( ({"fussfesseln", "fesseln"}),
      "Die Fussfesseln sind komplett verrostet und wohl zu nichts mehr "
      "zu gebrauchen.");

  AddDetail( ({ "gestein","fels" }),
    "Nicht das ganze Gestein ist so schwarz wie die Waende. Aber das meiste "
    "schon."
  );

  AddDetail( ({"waende"}),
      "Die Waende bestehen aus schwarzem Gestein und sind eiskalt.");

  AddDetail( ({ "einsturz","stell","einsturzstelle" }),
    "Der Gang ist hier eingestuerzt."
  );

  AddDetail( ({ "felsbrocken","brocken" }),
    "Grosse und kleine Felsbrocken liegen hier an der Einsturzstelle "
    "und versperren den Gang."
  );

  AddDetail( ({ "fels" }),
    "Tiefschwarzer Fels ist das. Unheimlich schwarz sogar."
  );
  AddDetail( ({ "ende","gangende" }),
    "Ja, der Gang hat hier ein Ende."
  );

  AddDetail( ({ "gang","gaenge" }),
    "Du befindest Dich immer noch in einem der endlosen und unheimlichen "
    "Gaenge der Unterwelt."
  );

  AddDetail( ({ "unterwelt" }),
    "Grausam und unhaumlich ist die Unterwelt. Ueberall lauern hier "
    "Gefahren auf Dich."
  );

  AddDetail( ({ "gefahren","gefahr" }),
    "Sie vorsichtig, dass Dir nicht irgendwo einmal die Decke auf den "
    "Kopf faellt."
  );

  AddDetail( ({ "kopf" }),
    "Der waere dann wohl platt."
  );

  AddDetail( ({"wand", "felswand"}),
      "Der Gang endet an einer Felswand. Sie ist voellig glatt und besteht "
      "aus schwarzem Fels, von dem eine merkwuerdige Kaelte ausgeht. Pass "
      "als auf wenn Du vorhaben solltest sie abzutasten.");

  AddSpecialDetail( ({"loch"}), "unt_loch");

  AddExit("norden"  , ROOM "00-21+07");
  AddCmd( ({"taste", "tast"}), "wand_tasten");
  AddCmd( ({"stecke", "steck"}), "finger_in_loch");
}

int wand_tasten(string str) {
  if(!str) {
    write("Was moechtest Du abtasten?\n");
    return 1;
  }
  if(member( ({"wand ab", "felswand ab"}), str) == -1) {
    write("Was wo wie? Das willst Du abtasten? Nein!\n");
    return 1;
  }
  say(BS(sprintf("%s tastet die Felswand ab.", TP->Name(WER))));
  if(sizeof(TP->QueryArmours(AT_GLOVE))) {
    write(BS("Du tastest die Wand ab. Sie ist eiskalt und glatt, bis auf "
          "das fingerdicke Loch in Kopfhoehe, das Du beinahe uebersehen "
          "haettest."));
    if(!member(users, getuid(TP))) 
      users+=([getuid(TP):1]);
    else
      users+=([getuid(TP):1]);
    return 1;
  }
  write(BS("Als Du die Wand beruehrst, bleibst Du mit Deiner Haut kleben. "
        "Die Wand ist EISKALT. Nur mit Gewalt kannst Du Dich losreissen. "
        "Hast Du keine Handschuhe dabei?"));
  TP->AddHp(random(50));
  return 1;
}

string unt_loch() {
  string plname;
  plname=getuid(TP);
  if(!member(users, plname))
    return "Sowas siehst Du da nicht!\n";
  if(users[plname] < 1 ) 
    return "Sowas siehst Du da nicht!\n";
  if(users[plname] < 2)
    users[plname]=2;
  return BS("Du koenntest einen Finger hineinstecken.");
}

int finger_in_loch(string str) {
  if(!str) return 0;
  if(str != "finger in loch") return 0;
  if(TP->QueryProp(P_GUILD) != "nekromanten") {
    if(!member(users, getuid(TP))) return 0;
    if(users[getuid(TP)] < 1 ) return 0;
  }
  write(BS("Du steckst den Finger in das Loch in der Felswand.\n"));
  if(call_other("/d/unterwelt/nekromanten/room/seqroom", "CheckInteractive")) {
    write(BS("Nichts passiert. Du bist Dir aber sicher das etwas passieren "
          "wird wenn Du es in kurzer Zeit nochmal probierst."));
    return 1;
  }
  if(TP->QueryProp(P_GUILD) != "nekromanten") 
    TP->do_damage(20)+random(20);
  if(TP->QueryProp(P_GHOST)) {
    say(BS(sprintf("%s faellt ploetzlich um.", TP->Name(WER))));
    users=m_delete(users, getuid(TP));
    return 1;
  }
  write(BS("Ploetzlich spuerst Du wie Dein Finger mit brutaler Kraft in das "
      "Loch gezogen wird. Eine unglaubliche Macht quetscht Dich zusammen, "
      "presst Dich durch das Loch hindurch.")) ;

  say(sprintf("%s ist ploetzlich verschwunden!\n", TP->Name(WER)));
  TP->move("/d/unterwelt/nekromanten/room/seqroom", M_NOCHECK|M_SILENT);
  ENV(TP)->Start();
  write_file("/d/unterwelt/nekromanten/log/nekrogebiet_gefunden.log", 
      sprintf("%s: %s\n", dtime(time()), getuid(TP)));
  users=m_delete(users, getuid(TP));
  return 1;

}

void reset() {
  ::reset();
  if(!sizeof(filter_array(all_inventory(ME), #'interactive)))
    users=([]);
}
