#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  UMASTER->Customize(TO);

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2] +
    "Am Boden liegt ein Skelett."
  );

  AddDetail( ({"skelett"}),
    "Ein angenagtes Skelett liegt am Boden. Tausende Wuermer kriechen "
    "darauf herum und befreien die Knochen von den allerletzten "
    "Resten von Fleisch."
  );

  AddDetail ( ({ "knochen" }),
    "Die Knochen duerften einem etwa schweinegrossem Tier gehoert "
    "haben, aber sicher kann man da nicht sein."
  );

  AddDetail ( ({ "reste", "fleisch", "fleischreste" }),
    "Es ist kaum mehr was uebrig."
  );

  AddExit("osten"  , ROOM "00+10+09");
  AddExit("sueden" , ROOM "00+09+08");
  AddExit("norden", "/d/unterwelt/gwenshara/hoehle/room/eingang");
}
