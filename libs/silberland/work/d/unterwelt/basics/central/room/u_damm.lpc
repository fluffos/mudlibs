#include "../def.h"

inherit "std/room";

#define P_BREATHED "breathed"

string *roomlist;

int fackel;

string sie_er(string key);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Unterhalb der Verdammnis" );
  SetProp(P_INT_LONG,
    "Du liegst mit zerschundenem Koerper und vielen offenen Wunden in etwa "
    "knoecheltiefem, lauwarmem Wasser. In wenigen Metern Entfernung kannst "
    "Du glatte Felswaende erkennen, die steil nach oben fuehren, allerdings "
    "nicht vollstaendig senkrecht. Sie scheinen sich etwas nach aussen zu "
    "neigen, je weiter nach oben sie fuehren. Auch der Boden unter Dir "
    "ist weder eben noch waagrecht, sondern voller scharfer Kanten und "
    "Spitzen. Weit ueber Dir nimmst Du schemenhafte Bewegungen wahr.");

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "wasser" }),
    "Das Wasser ist ruhig und relativ klar, bis auf die Stellen wo es von "
    "Blut rot gefaerbt ist. Hier, wo Du bist, ist das Wasser noch "
    "knoecheltief, doch an einer Seite senkt sich der Boden so weit ab, dass "
    "Du dort nicht mehr aufrecht stehen koenntest."
  );

  AddDetail( ({ "boden", "felsboden", "grund" }),
    "Steinharter Felsboden befindet sich unter der Wasseroberflaeche. "
    "Scharfe Kanten und fiese Spitzen machen einen Sturz bereits aus geringer "
    "Hoehe zu einem Risiko. Nach einer Seite hin neigt sich der Boden stark "
    "und das Wasser wird viel tiefer."
  );

  AddDetail( ({ "wand", "felswand", "waende", "felswaende" }),
    "Die Felswaende sind zwar rauh und uneben aber trotzdem viel zu glatt, "
    "um daran hochklettern zu koennen. Zu Dir nach unten hin verjuengt "
    "sich die Hoehle stark, weiter oben scheint sie viel groesser zu sein, "
    "sodass Du also in eine Art Trichter gefallen sein musst. "
    "An einer der Waende faellt Dir eine Nische auf."
  );

  AddDetail( ({ "fels" }),
    "Der typische Fels der Unterwelt. Steinhart, rauh, schwarz und "
    "unnatuerlich warm."
  );

  AddDetail( ({ "decke", "bewegungen" }),
    "Decke hat diese Hoehle keine, aber weit weit oben kannst Du erkennen, wie "
    "sich dort etwas bewegt. Auch die Umrisse des Balkengeflechts der "
    "Verdammnis kannst Du erahnen."
  );

  AddDetail( ({ "koerper" }),
    "Dein Koerper schmerzt hoellisch. Alles tut Dir weh. Du kannst nur hoffen, "
    "dass nichts gebrochen ist und Du keine bleibenden Schaeden "
    "davontraegst."
  );

  AddDetail( ({ "wunden" }),
    "Einige boese Wunden hast Du Dir durch Deinen Sturz zugezogen. "
    "Du blutest."
  );

  AddDetail( ({ "blut", "stellen" }),
    "Es handelt sich dabei hauptsaechlich um Dein eigenes Blut. Aber nicht "
    "nur. Einiges stammt auch von anderen Opfern, die frueher hier herunter"
    "gefallen sind."
  );

  AddDetail( ({ "kanten" }),
    "Scharfe Kanten, die Dir leicht haetten den Schaedel einschlagen koennen, "
    "wenn Du nur etwas ungluecklicher aufgeschlagen waerst."
  );

  AddDetail( ({ "spitzen" }),
    "Ein paar nadelfeine Spitzen ragen aus dem Wasser heraus. Sie haetten "
    "Dich sicher glatt durchbohrt, waerest Du darauf gelandet."
  );

  AddDetail( ({ "trichter", "hoehle" }),
    "Die Hoehle ueber Dir ist als trichterfoermig zu bezeichnen. Du "
    "musst auf Deinem Fall nach unten einige Male hart an den Felswaenden "
    "entlanggeschrammt sein. Dass du das ueberlebt hast, grenzt an ein "
    "Wunder."
  );

  AddDetail( ({ "nische" }),
    "Eine Nische, knapp oberhalb der Wasseroberflaeche, befindet sich in "
    "einer der Waende. Am hinteren Ende der Nische klafft ein tiefer Riss "
    "im Fels."
  );

  AddDetail( ({ "oberflaeche", "wasseroberflaeche" }),
    "Ein paar Leichenteile schwimmen im Wasser, aber sie sind schon zu "
    "verfault, als dass man erkennen koennte, von welchem Lebewesen sie "
    "stammen."
  );

  AddDetail( ({ "seite" }),
    "Auf einer Seite hat sich der Boden so weit nach unten geneigt, dass man "
    "nicht mehr aufrecht dort stehen kann (Hobbits sowieso nicht aber auch "
    "groessere Leute). Dir faellt eine schwache Stroemung im Wasser auf, die "
    "auf ein Loch weit unter der Wasseroberflaeche fuehrt."
  );

  AddDetail( ({ "loch" }),
    "Es ist Dir vorher noch nicht aufgefallen, dass auf der tiefen Seite ein "
    "Loch weit unten im Boden zu erkennen ist. Vielleicht kann man da ja "
    "hinuntertauchen? Auf jeden Fall sollte man aber vorher tief Luft holen, "
    "sonst ertrinkt man noch womoeglich."
  );

  AddDetail( ({ "stroemung" }),
    "Die Stroemung auf das Loch zu koennte weiter unten staerker werden. "
    "Ihr Ursprung ist sowohl ungewiss als auch raetselhaft, denn da wo Wasser "
    "abfliesst muss auch irgendwo wieder Wasser zufliessen, doch das scheint "
    "nirgends der Fall zu sein und trotzdem sinkt der Wasserstand nicht..."
  );

  AddDetail( ({ "wasserstand" }),
    "Gleichbleibend."
  );

  AddDetail( ({ "umrisse", "balkengeflecht","verdammnis" }),
    "Wie gesagt, Du kannst sie nur erahnen."
  );

  AddDetail( ({ "opfer", "leichenteile" }),
    "Ein paar verfaulte Leichenteile erinnern daran, dass Du nicht der erste "
    "bist, der hier heruntergefallen ist. Und andere haben nicht so viel "
    "Glueck gehabt und ueberlebt."
  );

  AddDetail( ({ "knoechel" }),
    "Hoffentlich hast Du sie Dir nicht gebrochen, beide Knoechel schmerzen "
    "naemlich."
  );

  AddDetail( ({"schaeden"}),
    "Es scheinen keine bleibenden Schaeden zu sein. Glueck gehabt."
  );

  AddSpecialDetail( ({ "riss" }),   "detail_riss");
  AddSpecialDetail( ({ "fackel" }), "detail_fackel_det");

  AddSmell( ({ DEFAULT_SMELL }),
    "Es riecht ein wenig faulig. Ist aber nicht schlimm.\n" );
  AddSound( ({ DEFAULT_SOUND }),
    "Eine leise Stimme erreicht von weit oben Dein Ohr.\n" );
  AddSound( ({ "stimme", "stimmen" }), #'sie_er);

  AddCmd( ({ "ziehe","zieh" })    , "cmd_ziehen");
  AddCmd( ({ "tauche","tauch" })  , "cmd_tauchen");
  AddCmd( ({ "hole","hol" })      , "cmd_atemholen");

  fackel   = 1;

  roomlist =
    ({ ROOM "00-08+04"
     , ROOM "00-07+04"
     , ROOM "00-07+03"
     , ROOM "00-08+02"
     , ROOM "00-09+03"
     });

}

void reset()
{
  ::reset();
  fackel = 1;
}

string detail_riss(string str)
{
  if(fackel) return "Eine Fackel hat sich im Riss verkeilt.\n";
  else return "Ein ganz normaler Riss im Fels. Nichts Besonderes.\n";
}

string detail_fackel(string str)
{
  if(fackel) return "Du koenntest versuchen, sie herauszuziehen.\n";
  else return "So etwas siehst Du hier nicht.\n";
}

int cmd_ziehen(string str)
{
  object ob;

  notify_fail("Was willst Du wo herausziehen?\n");

  if(!str || str == "") return 0;
  if(!(str == "fackel"          ||
       str == "fackel heraus"   ||
       str == "fackel raus"     ||
       str == "fackel aus riss" )) return 0;

  if(!fackel) return 0;

  TELLPLAYER(BS("Du ziehst heftig an der Fackel und bekommst sie mit einem "
                "Ruck frei.\n"));

  TELLOTHERS(TPN+" zieht eine Fackel aus einem Riss im Fels.\n");

  ob=clone_object("/obj/fackel");
  ob->move(TO, M_NOCHECK);

  if(ob->move(TP, M_GET) == ME_TOO_HEAVY)
  {
    TELLPLAYER("Du kannst die Fackel nicht mehr tragen und laesst sie "
               "fallen.\n");
  }

  fackel = 0;

  return 1;
}

int cmd_atemholen(string str)
{
  notify_fail("Was willst Du holen?\n");

  if(!str || str == "") return 0;
  if(!(str == "luft"         ||
       str == "atem"         ||
       str == "tief luft"    ||
       str == "tief atem"    )) return 0;

  TELLPLAYER(BS("Du holst ein paarmal tief Luft und fuehlst Dich nun etwas "
                "bereiter, hinunterzutauchen. Nun aber schnell, bevor dieses "
                "Gefuehl wieder verschwindet!"));

  TELLOTHERS(TPN+" holt ein paarmal tief Luft.\n");
  TP->SetProp(P_BREATHED, time());

  return 1;
}

int cmd_tauchen(string str)
{
  object ob;
  string target;

  notify_fail("Wo willst Du hintauchen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "hinunter"  ||
       str == "in loch"   ||
       str == "runter"    )) return 0;

  TELLPLAYER(BS("Mutig tauchst Du zum Loch hinunter. Sofort wirst Du vom "
                "Sog der Unterwasserstroemung erfasst und hinuntergesaugt. "
                "Der Sog nimmt staendig zu und die Fahrt wird rasend "
                "schneller."));

  TELLOTHERS(TPN+" taucht hinunter.\n");

  target = roomlist[random(sizeof(roomlist))];

  if((time() - TP->QueryProp(P_BREATHED) <= 15) || // Luftholen max. 15 sec. her
      TP->QueryProp(P_GHOST))
  {
    TELLPLAYER(BS("Du spuerst, wie Du ploetzlich steil nach oben gepresst "
                  "wirst. Ein stechender Schmerz pulsiert in Deinen Lungen, "
                  "und gerade, als Du glaubst, ersticken zu muessen, tauchst "
                  "Du auf und wirst ans Ufer eines kleinen Sees gespuelt."));

    TP->move(target, M_GO | M_NO_SHOW, "",
       "wird durch ein Loch am Grund weggesaugt",
       "wird voellig erschoepft ans Ufer gespuelt");
    TP->SetProp(P_MV, 0);
  }
  else
  {
    TELLPLAYER(BS("Du spuerst, wie Du ploetzlich steil nach oben gepresst "
                  "wirst. Ein stechender Schmerz pulsiert in Deinen Lungen. "
                  "Du merkst, dass Dir der Sauerstoff ausgeht. Verzweifelt "
                  "schnappst Du nach Luft, doch es ist zu spaet. Du schluckst "
                  "viel zu viel Wasser und ertrinkst."));

    TELLOTHERS(TPN+" wird durch ein Loch am Grund weggesaugt.\n");

    TP->move(target, M_GO|M_NO_SHOW|M_SILENT|M_NOCHECK);
    SetProp(P_KILL_NAME, "Ertrinken");
    TP->die();

    tell_room(target, "Eine Leiche wird angespuelt.\n" );
  }

  return 1;
}

string sie_er(string key)
{
  return (
    "Die Stimme sagt: 'Verdammt nochmal, "+ TP->QueryPronoun(WER)+
    " ist runtergefallen.'\n");
}
