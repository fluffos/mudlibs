#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein eingestuerzter Gang" );
  SetProp(P_INT_LONG,
    "Auf einmal hat der Gang ein abruptes Ende. Die Decke und die Waende "
    "sind hier zusammengefallen und bilden eine unueberwindliche Huerde "
    "fuer Dich. Lauter Felsbrocken und Gestein versperren den Gang. Selbst "
    "mit einer Schaufel oder Spitzhacke wird man hier kaum den Gang erweitern "
    "koennen. Ob es aber hinter dem Einsturz noch weiter geht, kannst Du "
    "auch nicht erkennen. Vielleicht solltest Du in der Zukunft noch einmal "
    "vorbeischauen.");
  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20+random(3),
                          ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "decke" }),
    "Die Decke sieht ueberhaupt nicht gut aus. Grosse Felsbrocken sind aus "
    "hier herausgebrochen und versperren den Gang komplett."
  );

  AddDetail( ({ "boden" }),
    "Auf dem dunklen Boden sind hier alle Wuermer durch die Felsbrocken "
    "erschlagen worden."
  );

  AddDetail( ({ "wuermer","wurm" }),
    "Davon liegen hier nur noch tote rum."
  );

  AddDetail( ({ "zukunft" }),
    "Vielleicht entschliesst man sich ja irgendwann, den Gang freizulegen. "
    "Dann koennte man ihn auch wieder passieren. Du solltest spaeter mal "
    "wiederkommen und das kontrollieren!"
  );

  AddDetail( ({ "schaufel","spitzhacke","hacke" }),
    "Die wuerde hier auch nichts nuetzen."
  );

  AddDetail( ({ "gestein" }),
    "Nicht das ganze Gestein ist so schwarz wie die Waende. Aber das meiste "
    "schon."
  );

  AddDetail( ({ "einsturz","stell","einsturzstelle" }),
    "Der Gang ist hier eingestuerzt."
  );

  AddDetail( ({ "felsbrocken","brocken" }),
    "Grosse und kleine Felsbrocken liegen hier an der Einsturzstelle "
    "und versperren den Gang."
  );

  AddDetail( ({ "fels" }),
    "Tiefschwarzer Fels ist das. Unheimlich schwarz sogar."
  );

  AddDetail( ({ "wand","waende" }),
    "Die tiefschwarzen Waende sind hier zusammengefallen. Bisher scheint "
    "sich niemand darum zu kuemmern. Aber in Zukunft koennte das durchaus "
    "passieren."
  );

  AddDetail( ({ "huerde" }),
    "Du wirst sie niemals ueberwinden koennen!"
  );

  AddDetail( ({ "ende" }),
    "Ja, der Gang hat hier vorerst ein Ende."
  );

  AddDetail( ({ "gang","gaenge" }),
    "Du befindest Dich immer noch in einem der endlosen und unheimlichen "
    "Gaenge der Unterwelt."
  );

  AddDetail( ({ "unterwelt" }),
    "Grausam und unhaumlich ist die Unterwelt. Ueberall lauern hier "
    "Gefahren auf Dich."
  );

  AddDetail( ({ "gefahren","gefahr" }),
    "Sie vorsichtig, dass Dir nicht irgendwo einmal die Decke auf den "
    "Kopf faellt."
  );

  AddDetail( ({ "kopf" }),
    "Der waere dann wohl platt."
  );

  AddExit("norden"  , ROOM "00-09+03");
}

