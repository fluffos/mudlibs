#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  UMASTER->Customize(TO);

  AddItem( OBJ "labschild", REFRESH_DESTRUCT );

  AddExit("westen"  , ROOM "00+07+00");
  AddExit("osten"   , ROOM "00+07+02");

  AddExit("suedostunten","/d/unterwelt/zordan/labyrinth/room/eingang");
  AddExit("suedosten"   ,"/d/unterwelt/zordan/labyrinth/room/eingang");

  SetProp(P_HIDE_EXITS,({ "suedosten" }));
}
