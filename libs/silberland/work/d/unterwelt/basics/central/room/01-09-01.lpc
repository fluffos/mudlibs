#include "../def.h"

inherit ROOM "inh_spinnennetz";

int faden_da;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Mitten in einer Spinnwebe" );
  SetProp( P_INT_LONG,
    "Klebrig windest Du Dich weiter in die Mitte der riesigen Spinnwebe. "
    "Hier haengen ein paar Kokons herum und warten nur darauf gegessen zu "
    "werden. Die Faeden laufen hier kreisfoermig zusammen und Du kannst "
    "sehr gut stehen. An den tiefen Abdruecken erkennst Du sofort, dass "
    "hier ein wahres Ungeheuer hausen muss."
  );

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 0, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "zeit" }),
    "Wer hat schon Zeit?"
  );

  AddDetail( ({ "arm" }),
    "Du vergleichst die Faeden mit Deinem Arm. Ja, sind gleich dick."
  );

  AddDetail( ({ "opfer" }),
    "Die Opfer haengen wohl schon etwas laenger in den Kokons. Du moechtest "
    "aber ueberhaupt nicht testen wie das so ist."
  );

  AddDetail( ({ "ungeheuer" }),
    "Es scheint nicht da zu sein. Sonst haettest Du sicher keine Zeit "
    "nachzusehen."
  );

  AddDetail( ({ "abdruecke","abdruck" }),
    "Gewaltig sehen die Abdruecke aus. Sie koennen nur von einem "
    "wirklich ungetuemen Ungeheuer stammen."
  );

  AddDetail( ({ "faeden" }),
    "Die Faeden sind dicker als Dein Arm und halten die Spinnwebe zusammen. "
    "Sie sind eklig klebrig. Pass besser auf, dass Du nicht komplett "
    "festkleben bleibst! Ein besonders dicker Faden haengt zum Boden herunter."
  );

  AddDetail( ({ "mitte" }),
    "Du stehst genau in der Mitte der Spinnwebe. Man koennte auch Zentrum "
    "sagen. Hier werden die Opfer in Kokons verpackt um sie dann spaeter "
    "zu verspeisen."
  );

  AddDetail( ({ "zentrum" }),
    "Ja, genau die Mitte eben."
  );

  AddDetail( ({ "kokon","kokons" }),
    "Die Kokons sind etwa so gross wie Du. Was sie genau enthalten kannst "
    "Du nicht sehen. Eigentlich moechtest Du das auch gar nicht. Sie verbreiten "
    "einen unngenehmen Geruch."
  );

  AddDetail( ({ "geruch" }),
    "Ob man den sehen kann?"
  );

  AddDetail( ({ "wand","waende" }),
    "Hm, Waende gibt es hier in der Mitte nicht."
  );

  AddDetail( ({ "boden" }),
    "Du kannst den Boden nicht richtig erkennen. Er verschwindet unter der "
    "Spinnwebe auf der Du stehst im Dunkeln."
  );

  AddDetail( ({ "dunkel","dunkeln" }),
    "Es ist halt sehr finster und Du kannst nichts sehen."
  );

  AddDetail( ({ "decke" }),
    "An der Decke haengen ein paar kleine Spinnweben."
  );

  AddDetail( ({ "spinnweben" }),
    "Die Spinnweben haengen weit weg an der Decke und Du stehst auf einer "
    "riesig grossen Spinnwebe."
  );

  AddDetail( ({ "spinnwebe" }),
    "Sie erstreckt sich ueber mehrere Meter und uebertrifft jede "
    "Spinnwebe, die Du in Deinem Leben gesehen hast."
  );

  AddDetail( ({ "meter","elfen" }),
    "Vier Elfen schaetzt Du."
  );

  AddDetail( ({ "leben" }),
    "Hier lebt man wohl nicht sehr lange."
  );

  AddSound( DEFAULT_SOUND,
    "Leise schwingt die Spinnwebe hin und her."
  );

  AddSound( ({"spinnwebe","webe"}),
    "Sie bewegt sich nicht stark und ist deshalb sehr leise."
  );

  AddSmell( DEFAULT_SMELL,
    "Ein mieser Geruch kommt aus den Kokons."
  );

  AddSmell( ({"kokons","geruch","kokon" }),
    "Die Kokons riechen nach totem Fleisch."
  );

  AddSmell( "fleisch",
    "Das Fleisch riecht alt und schon ein wenig vergammelt."
  );

  AddSpecialDetail( ({ "spannung" }), "detail_spannung");
  AddSpecialDetail( ({ "faden" }),    "detail_faden" );

  AddCmd( ({ "schneide","schneid" }), "cmd_schneiden");

  AddItem(NPC "riesenspinne", REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]) );

  AddExit("norden" , ROOM "01-08-01" );
  AddExit("sueden" , ROOM "01-10-01" );
  AddExit("osten"  , ROOM "01-09+00" );
  AddExit("westen" , ROOM "01-09-02" );

  faden_da=1;
}

void reset()
{
  ::reset();

  faden_da=1;
}

string detail_spannung(string str)
{
  if(faden_da == 1)
    return BS("Du ergreifst den Faden und pruefst die Spannung. Etwas "
              "wirklich sehr schweres muss daran haengen. Leider wird es "
              "fuer Dich wohl nie erkennbar sein.");

  return "Ups, der Faden haengt nur sehr locker nach unten.\n";
}

string detail_faden(string str)
{
  if(faden_da == 1)
    return BS("Du kannst nicht genau erkennen was daran haengt. Aber durch "
              "die Spannung in dem Faden weisst Du genau, dass dort etwas "
              "haengen muss. Es muss ziemlich schwer sein.");

  return "Der Faden baumelt ein paar Meter locker nach unten.\n";
}

int cmd_schneiden(string str)
{
  object ob;

  notify_fail("Was willst Du durchschneiden?\n");

  if(!str || str == "") return 0;
  if(!(str == "faden"         ||
       str == "faden ab"      ||
       str == "faden durch"   )) return 0;

  if(faden_da == 0)
  {
    TELLPLAYER("Der Faden wurde schon von Jemandem durchgeschnitten!\n");
    return -1;
  }

  if(!(ob = TP->QueryProp(P_WEAPON)))
  {
    TELLPLAYER("Du hast ja gar nichts zum Schneiden in der Hand!\n");
    return -1;
  }

  if(!(ob->QueryProp(P_WEAPON_TYPE) == WT_KNIFE  ||
       ob->QueryProp(P_WEAPON_TYPE) == WT_SWORD  ))
  {
    TELLPLAYER("Du hast ja gar nichts zum Schneiden in der Hand!\n");
    return -1;
  }

  TELLPLAYER(BS("Mit einem schnellen Schnitt durchtrennst Du den stramm "
                "gespannten Faden. Mit einem kleinen Ruck hebt sich die "
                "ganze Spinnwebe einen halben Meter hoch."));

  TELLOTHERS(BS(CAP_TPN+" durchtrennt etwas und mit einem kleinen Ruck hebt "
                "sich die ganze Spinnwebe einen halben Meter hoch."));

  faden_da=0;
  call_out("plumps",10+random(4));
  return 1;
}

void plumps()
{
  tell_room(TO,"Auf einmal hoerst Du tief unter Dir ein dumpfes *Plumps*.");
}
