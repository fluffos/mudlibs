#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  UMASTER->Customize(TO);

  SetProp(P_INT_LONG,
    QueryProp(P_INT_LONG)+" Ups, beinahe haettest Du das Loch im Boden "
    "uebersehen, aus dem ein eigentlich unuebersehbarer Lichtschein "
    "dringt."
  );

  SetProp(P_LIGHT, 1);

  AddDetail(({ "boden" }),
    GetDetail("boden")+" Ein zwei mal zwei Meter breites Loch ist ausserdem "
    "im Boden."
  );

  AddDetail(({ "loch" }),
    "Da kann man sich nach unten begeben."
  );

  AddDetail(({ "licht", "schein", "lichtschein" }),
    "Eigentlich relativ hell. Wie konntest Du das uebersehen?"
  );

  AddExit("sueden"  , ROOM "00+10+04");
  AddExit("unten"   , "/d/unterwelt/dante/skel/portal");
}
