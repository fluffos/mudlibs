#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  UMASTER->Customize(TO);

  SetProp(P_INT_LONG,
    QueryProp(P_INT_LONG)[0..<2] + "Eine enge Wendeltreppe fuehrt hier "
    "steil nach oben."
  );

  AddDetail( ({ "treppe", "wendeltreppe" }),
    "Die Wendeltreppe windet sich in engen Spiralen steil hinauf. Wo sie wohl "
    "hinfuehrt?"
  );

  AddDetail( ({ "stufe", "stufen" }),
    "Die Stufen wurden recht unregelmaessig aus dem Stein gehauen. Man muss, "
    "wenn man sie benutzt, sicher hoellisch aufpassen, darauf nicht "
    "umzukippen, auszurutschen oder zu verknoecheln."
  );

  AddDetail( ({ "decke" }),
    "Es gibt hier eigentlich keine Decke, weil eine Wendeltreppe nach oben "
    "fuehrt."
  );

  AddDetail( ({ "spirale", "spiralen" }),
    "Die Wendeltreppe fuehrt spiralfoermig nach oben. Sonst waers ja keine "
    "Wendeltreppe, wenn sie gerade nach oben fuehrte."
  );

  AddExit("nordosten", ROOM "00-01-14");
  AddExit("sueden"   , ROOM "00-03-15");
  AddExit("oben"     , ROOM "treppe3");
}
