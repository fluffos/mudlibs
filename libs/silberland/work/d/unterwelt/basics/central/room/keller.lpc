#include "../def.h"

inherit "/std/room";

mapping coffin;

int skeleton;
int ladder;
int nothing;

void create()
{
  int *tmp;

  ::create();

  SetProp(P_INT_SHORT, "In einem sehr dunklen Keller");
  SetProp(P_INT_LONG,
    "Ein sehr dunkler Keller. Kalte, fast schon eisige Luft dringt durch "
    "Deine Kehle in Deine Lungen. Die Kaelte laesst keinen Angstschweiss "
    "aufkommen. Allerdings pocht Dein Herz gewaltig. "
  );

  SetProp(P_LIGHT, -1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 5, ENV_TERRAIN:TT_HOUSE]) );


  AddDetail( ({"keller"}) ,
    QueryProp(P_INT_LONG)
  );

  AddDetail( ({"angstschweiss","schweiss"}) ,
    "Die kalte, eisige Luft laesst keinen Angstschweiss aufkommen."
  );

  AddDetail( ({"kehle"}) ,
    "Die kalte Luft stroemt eisig durch Deine Kehle. Aber wenn Dir Jemand "
    "die Kehle durchschneidet, dann wird Dich das nicht sonderlich "
    "interessieren. "
  );

  AddDetail( ({"herz"}) ,
    "Dein Herz pocht. Na, hoffentlich hoert das niemand oder wird gar "
    "angelockt. "
  );

  AddDetail( ({"kaelte","lunge","lungen","luft"}) ,
    "Die kalte Luft schneidet in Deinen Lungen. "
  );

  AddDetail( ({"decke"}) ,
    "Wenn Dich Dein Orientierungssinn nicht taeuscht, dann sollte sich ueber "
    "dieser Decke die Gruft der Hexen befinden. "
  );

  AddDetail( ({"wand","waende"}) ,
    "Schwarzes, massives Felsgestein. Es muss sehr viel Muehe gekostet haben, "
    "diesen Keller aus dem Gestein zu schlagen. An der einen Wand stehen "
    "drei Saerge, genau gegenueber fuehrt eine kleine Treppe nach oben. "
  );

  AddDetail( ({"treppe"}) ,
    "Du kannst nach oben steigen. Das heisst, wenn Du Dich traust."
  );

  AddDetail( ({"fels","felsen","felsgestein","gestein"}) ,
    "Hart. Massiv. Schwarz. Bedrohlich."
  );

  AddDetail( ({"gruft"}) ,
    "Die Gruft muesste sich genau ueber Dir befinden. "
  );

  AddDetail( ({"hexen","hexe"}) ,
    "Die Hexen kommen nur selten hierher. Um jemand zu begraben. Vielleicht "
    "Dich? "
  );

  AddDetail( ({"jemand","ruecken"}) ,
    "Jemand grinst hinter Deinem Ruecken."
  );

  AddDetail( ({"muehe"}) ,
    "Diesen Keller zu schaffen muss sehr muehsam gewesen sein. "
  );

  AddDetail( ({"orientierungssinn"}) ,
    "Wenn Du keinen hast, solltest Du vielleicht besser umkehren. "
  );

  AddDetail( ({"boden"}) ,
    "Der Boden ist erstaunlich glatt. "
  );

  AddSpecialDetail( ({"saerge","sarg"})      , "detail_sarg");

  AddSpecialDetail( ({"sarg 1","sarg eins"
                     ,"sarg 2","sarg zwei"
                     ,"sarg 3","sarg drei"
                     })                      , "detail_sarg_num");

  AddCmd("steig|steige&treppe&oben|rauf|hinauf|herauf",
    "cmd_steigen",
    "Wo moechtest Du heraufsteigen?"
  );

  AddCmd("steig|steige&oben",
    "cmd_steigen",
    "Wo moechtest Du heraufsteigen?"
  );

  AddCmd("steig|steige|kletter|klettere&sarg&1|eins",
    "cmd_steigen_sarg1",
    "Wohin moechtest Du steigen?"
  );

  AddCmd("steig|steige|kletter|klettere&sarg&2|zwei",
    "cmd_steigen_sarg2",
    "Wohin moechtest Du steigen?"
  );

  AddCmd("steig|steige|kletter|klettere&sarg&3|drei",
    "cmd_steigen_sarg3",
    "Wohin moechtest Du steigen?"
  );

  AddCmd( CMD_OEFFNEN                 , "cmd_oeffnen");
  AddCmd( ({"schliess", "schliesse"}) , "cmd_schliessen" );

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );

  coffin =
  ([0:0
   ,1:0
   ,2:0
   ]);

  tmp = ({0,1,2});

  skeleton = tmp[random(sizeof(tmp))]; tmp -= ({ skeleton });
  ladder   = tmp[random(sizeof(tmp))]; tmp -= ({ ladder });
  nothing  = tmp[random(sizeof(tmp))]; tmp -= ({ nothing });
}

int aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist es, hier heraus zu finden.\n");
  return 0;
}

string QueryCoffin()
{
  string s;

  s = sprintf("Skelett:%d Leiter:%d Nichts:%d ", skeleton, ladder, nothing);

  if(coffin[0, 0] == 1) s += "Sarg 1 (0) ist auf ";
  if(coffin[1, 0] == 1) s += "Sarg 2 (1) ist auf ";
  if(coffin[2, 0] == 1) s += "Sarg 3 (2) ist auf ";

  return s;
}

void reset()
{
  int sum, *tmp;

  ::reset();

  sum = 0;
  if(coffin[0,0] == 1) sum += 1;
  if(coffin[1,0] == 1) sum += 2;
  if(coffin[2,0] == 1) sum += 4;

  if(sum != 0)
  {
    tell_room(TO, BS("Ploetzlich ertoent ein Knall, so als ob Stein auf "
                     "Stein fallen wuerde. "));
  }

  coffin =
  ([0:0
   ,1:0
   ,2:0
   ]);

  tmp = ({0,1,2});

  skeleton = tmp[random(sizeof(tmp))]; tmp -= ({ skeleton });
  ladder   = tmp[random(sizeof(tmp))]; tmp -= ({ ladder });
  nothing  = tmp[random(sizeof(tmp))]; tmp -= ({ nothing });
}

int cmd_steigen(string str)
{
  TP->move(ROOM "gruft",M_GO, "hinauf", "steigt die Treppe",
                               "kommt die Treppe hinauf");

  return 1;
}

void PlayerUp(object pl)
{
  string sp, so;

  if(coffin[ladder, 0] == 0)
  {
    so = "Einer der Saerge wird geoeffnet und "+pl->name(WER)+" steigt "
         "heraus. Wie gruselig! Ob "+pl->QueryPronoun(WER)+" gerade von "
         "Lars kommt?";

    sp = "Du erklimmst die Leiter, aber so etwas aehnliches wie ein Deckel "
         "versperrt Dir den Weg. Da er sich jedoch leicht bewegen laesst, "
         "schiebst Du den Deckel beiseite und krabbelst in eine Art "
         "Keller. ";
    coffin[ladder, 0] = 1;
  }
  else
  {
    so = pl->Name(WER)+" steigt auf einmal aus einem der Saerge heraus. "
         "Wie gruselig! Ob "+pl->QueryPronoun(WER)+" gerade von Lars "
         "kommt?";

    sp = "Du erklimmst die Leiter und kletterst aus einer Art Wanne in "
         "einen dunklen Keller. ";
  }

  tell_object(TP, BS(sp));
  tell_room(TO, BS(so), ({pl}) );
  tell_room(ROOM "treppe1", BS(pl->Name(WER)+" steigt die Leiter nach oben "
                               "und verschwindet in der Dunkelheit. "),
                               ({pl}) );

  pl->move(TO, M_GO|M_SILENT);
}

int TestCoffin(int i)
{
  return coffin[i, 0];
}

void OpenCoffin(int i)
{
  coffin[i, 0] = 1;
  return;
}

void CloseCoffin(int i)
{
  coffin[i, 0] = 0;
}

int cmd_oeffnen(string str)
{
  int n;

  notify_fail("Was moechtest Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(str == "sarg" || str == "saerge")
  {
    tell_object(TP, BS("Hier stehen drei Saerge. Welchen davon moechtest "
                       "Du denn oeffnen?"));
    return -1;
  }

  n = -1;
  if(str == "sarg 1" || str == "sarg eins") n = 0;
  if(str == "sarg 2" || str == "sarg zwei") n = 1;
  if(str == "sarg 3" || str == "sarg drei") n = 2;

  if(n == -1) return 0;

  if(coffin[n, 0] == 1)
  {
    tell_object(TP, BS("Dieser Sarg ist schon offen. Du koenntest hinein "
                       "klettern wenn Du Dich traust. "));
    return -1;
  }

  coffin[n, 0] = 1;

  tell_object(TP, BS("Du oeffnest Sarg "+({"eins","zwei","drei"})[n]+"."));

  return 1;
}

int cmd_schliessen(string str)
{
  int n;

  notify_fail("Was moechtest Du schliessen?\n");

  if(!str || str == "") return 0;

  if(str == "sarg" || str == "saerge")
  {
    tell_object(TP, BS("Hier stehen drei Saerge. Welchen davon moechtest "
                       "Du denn schliessen?"));
    return -1;
  }

  n = -1;
  if(str == "sarg 1" || str == "sarg eins") n = 0;
  if(str == "sarg 2" || str == "sarg zwei") n = 1;
  if(str == "sarg 3" || str == "sarg drei") n = 2;

  if(n == -1) return 0;

  if(coffin[n, 0] == 0)
  {
    tell_object(TP, BS("Dieser Sarg ist schon geschlossen. Da kommt wirklich "
                       "keiner mehr raus. "));
    return -1;
  }

  coffin[n, 0] = 0;

  tell_object(TP, BS("Du schliesst Sarg "+({"eins","zwei","drei"})[n]+"."));

  return 1;
}

int go_coffin(int n)
{
  object npc;

  if(coffin[n, 0] == 0)
  {
    tell_object(TP, BS("Dieser Sarg ist geschlossen! Wie willst Du denn da "
                       "hineinklettern? "));
    return 1;
  }

  npc = present("UWELTSKELETT", TO);
  if(npc && (TP->QueryProp(P_LEVEL) > 15))
  {
    tell_object(TP, "Das Skelett hindert Dich daran!\n!");
    return 1;
  }

  if((n == skeleton) && (TP->QueryProp(P_LEVEL) > 15))
  {
    tell_object(TP, BS("Ui, da liegt ja ein Skelett drin, das Dich boese "
                       "anfunkelt!"));
    skeleton = -1;
    npc = clone_object(NPC "skelett");
    npc->SetProp(P_MNPC_AREA, file_name(TO));
    npc->SetProp(P_MNPC_DEFAULTROOM, file_name(TO));
    npc->SetProp(P_MNPC_FLAGS, 0);
    npc->move(TO, M_GO);

    npc->Kill(TP);
    UMASTER->Msg(CAP(getuid(TP))+" trifft auf das Skelett im Keller");
    return 1;
  }

  if(n == ladder)
  {
    tell_object(TP, BS("Du kletterst in den Sarg. In dem Sarg befindet "
                       "sich ein Loch im Boden, aus dem zwei Holme "
                       "einer wackeligen Leiter ragen. Du nimmst all Deinen "
                       "Mut zusammen und kletterst die Leiter hinab. "));

    tell_room(TO, BS(TP->Name(WER)+" klettert in einen der Saerge und "
                     "verschwindet darin."), ({ TP }) );

    tell_room(ROOM "treppe1", BS(TP->Name(WER)+" kommt die Leiter "
                                 "heruntergeklettert."));

    TP->move(ROOM "treppe1", M_GO|M_SILENT);
    return 1;
  }

  if((n == nothing) && (random(10) == 8) && TP->QueryProp(P_LEVEL) > 15)
  {
    tell_room(TO, BS(TP->Name(WER)+" klettert in einen der Saerge und "
                     "verschwindet darin."), ({ TP }) );

    tell_object(TP, BS("Du kletterst in den Sarg. Am Boden des Sarges "
                       "befindet sich ein kleines Loch mit extrem glatten "
                       "Waenden, fast wie eine Rutsche. Bevor Du noch "
                       "nachdenken kannst stolperst Du und faellst in die "
                       "Rutsche...."));

    TP->move(ROOM "rutsche:"+getuid(this_player()), M_GO|M_SILENT);
    UMASTER->Msg(CAP(getuid(TP))+" faellt in die Rutsche");

    return 1;
  }

  tell_object(TP, BS("Du steigst in den Sarg hinein. Da nichts passiert, "
                     "kletterst Du wieder hinaus."));
  tell_room(TO, BS(TP->Name(WER)+" klettert in einen der Saerge hinein. "
                   "Ob "+TP->QueryPronoun(WER)+" mass nehmen will? "
                   "Letztendlich klettert "+TP->QueryPronoun(WER)+" aber "
                   "wieder hinaus. "), ({ TP }) );
  return 1;
}

int cmd_steigen_sarg1(string str)
{
  return go_coffin(0);
}

int cmd_steigen_sarg2(string str)
{
  return go_coffin(1);
}

int cmd_steigen_sarg3(string str)
{
  return go_coffin(2);
}

string detail_sarg(string str)
{
  string s;
  int sum;

  sum = 0;
  s   = "An einer der Waende stehen drei Saerge. ";

  if(coffin[0,0] == 1) sum += 1;
  if(coffin[1,0] == 1) sum += 2;
  if(coffin[2,0] == 1) sum += 4;

  switch(sum)
  {
    case 0:
      s += "Sie sind alle geschlossen. ";
      break;

    case 1:
      s += "Sarg eins ist geoeffnet, die beiden anderen geschlossen. ";
      break;

    case 2:
      s += "Sarg zwei ist geoeffnet, die beiden anderen geschlossen. ";
      break;

    case 3:
      s += "Sarg eins und zwei sind geoffnet, Sarg drei noch geschlossen. ";
      break;

    case 4:
      s += "Sarg drei ist geoeffnet, die beiden anderen noch geschlossen. ";
      break;

    case 5:
      s += "Sarg eins und drei sind geoeffnet, Sarg zwei ist geschlossen. ";
      break;

    case 6:
      s += "Sarg eins ist geschlossen, die beiden anderen geoeffnet. ";
      break;

    default:
      s += "Sie sind alle geoeffnet. ";
      break;

  }

  return BS(s);
}

string detail_sarg_num(string str)
{
  string s;
  int n;

  n = -1;
  if(str == "sarg 1" || str == "sarg eins") n = 0;
  if(str == "sarg 2" || str == "sarg zwei") n = 1;
  if(str == "sarg 3" || str == "sarg drei") n = 2;

  if(n == -1) return "Sowas siehst Du hier nicht!\n";

  s = "Der Sarg ist direkt mit dem Boden verbunden. Es scheint so, als "
      "haette man den Sarg schon beim Ausgraben dieser Hoehle bedacht. "
      "Der Sarg ist ";

  if(coffin[n, 0] == 0)
  {
    s += "geschlossen.";
  }
  else
  {
    s += "geoeffnet. Du koenntest hineinklettern. Wenn Du Dich traust. "
         "Ansonsten mach ihn lieber wieder zu! ";
  }

  return BS(s);
}

