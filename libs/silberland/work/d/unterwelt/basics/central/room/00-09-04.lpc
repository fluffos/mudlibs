#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Vor einem grossen Tor" );
  SetProp(P_INT_LONG,
    "Auf einmal findest Du Dich in einer kleinen Hoehle wieder. Du fuehlst "
    "Dich recht gut, weil Du endlich mal nicht mehr so gebueckt gehen musst "
    "und Deinen Koerper aufrichten kannst. Der Boden ist hier tatsaechlich "
    "mal ausgebaut worden. In der Nordwand faellt Dir ein grosses, eisernes "
    "Tor auf."
  );

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "decke" }),
    "Die felsige Decke zeigt nichts besonderes. Zu erwaehnen waere "
    "vielleicht nur, dass sie sehr glatt und tief schwarz ist."
  );

  AddDetail( ({ "gaenge","gang" }),
    "Die dunkeln Gaenge kannst Du durch die zwei kleinen Loecher wieder "
    "betreten."
  );

  AddDetail( ({ "boden" }),
    "Der Boden wurde mit kleinen Platten ausbaut. Aber auch nur teilweise vor "
    "dem Tor. Der Rest ist normaler Felsboden."
  );

  AddDetail( ({ "platten" }),
    "Dir faellt nichts auf an den Platten."
  );

  AddDetail( ({ "rest","felsboden","fels" }),
    "Glatter, kalter und dunkler Fels."
  );

  AddDetail( ({ "koerper" }),
    "Dein Koerper erholt sich langsam vom gebuecktem Gehen in den langen "
    "Gaengen. Du rekelst Dich."
  );

  AddDetail( ({ "gehen" }),
    "Oder bist Du vor lauter Angst etwa durchgerannt?"
  );

  AddDetail( ({ "angst" }),
    "In dieser Hoehle verspuerst Du irgendwie keine Angst."
  );

  AddDetail( ({ "hoehle" }),
    "Die Hoehle ist einige Meter im Durchmesser und Du kannst hier endlich "
    "mal wieder vernuenftig stehen. Wie Du an den Waenden erkennen kannst, "
    "wurde diese Hoehle wohl hier hinein gebaut."
  );

  AddDetail( ({ "waende","wand" }),
    "Die Waende sind wie ueberall tiefschwarz. Sie sind allerdings ziemlich "
    "glatt, so dass Du meinst die Hoehle wurde hier gebaut. In der Nordwand "
    "ist ein grosses Tor."
  );

  AddDetail( ({ "nordwand" }),
    "In die Nordwand ist ein riesiges Tor eingelassen worden."
  );

  AddDetail( ({ "unterwelt" }),
    "In der bist Du gerade."
  );

  AddDetail( ({ "meter","durchmesser" }),
    "Du schaetzt die Hoehle auf vier Elfen im Durchmesser und drei Zwerge in "
    "der Hoehe."
  );

  AddDetail( ({ "elfen","zwerge","vergleich" }),
    "Das war doch nur ein Vergleich!"
  );

  AddDetail( ({ "hoehe" }),
    "Die Hoehle ist nicht so dermassen hoch. Aber es reicht locker aus, damit "
    "man hier gut stehen kann."
  );

  AddSound( ({ DEFAULT_SOUND }),
    "Hier herrscht eine komische Stille."
  );

  AddSound( ({ "stille" }),
    "Es ist halt sehr ruhig hier."
  );

  AddSmell( ({ DEFAULT_SMELL }),
    "Es riecht hier nicht mehr so sehr nach Tod und Verwesung. Allerdings "
    "stroemt es immer noch aus den benachbarten Gaengen herein."
  );

  AddSmell( ({ "tod" }),
    "Leicht suesslich riecht der Tod. Obwohl er ja nun alles andere als "
    "suess ist."
  );

  AddSmell( ({ "verwesung" }),
    "Hier ist die Verwesung nicht mehr so stark zu riechen. Es tut Dir "
    "trotzdem noch immer in Deiner Nase weh."
  );

  NewDoor("norden", ROOM "00-08-04", "tor",
    ({D_NAME,"Tor"
     ,D_GENDER, NEUTER
     ,D_FLAGS, (DOOR_NEEDKEY|DOOR_RESET_CL|DOOR_CLOSED)
     ,D_MSGS, ({"nach Norden"
               ,"durchschreitet das Tor"
               ,"kommt durch das Tor herein"
               })
     ,D_SHORT,"Das Tor ist %s. "
     ,D_LONG, "Ein grosses, eisernes Tor ist in der Nordwand eingelassen "
              "worden. Zahlreiche Verzierungen schmuecken es und in der "
              "Mitte kannst Du eine seltsame Einbuchtung sehen."
     ,D_OPENMSG, ({"Du oeffnest das grosse, quietschende Tor."
                  ,"%s oeffnet das grosse, quietschende Tor."
                  ," wird von der anderen Seite quietschend geoeffnet."
                  })
     ,D_CLOSEMSG,({"Du schliesst das Tor, welches krachend ins Schloss faellt."
                  ,"%s schliesst das Tor, welches krachend ins Schloss faellt."
                  ," wird von der anderen Seite geschlossen und faellt "
                   "krachend ins Schloss."
                  })
     ,D_RESET_CLOSEMSG, " faellt krachend ins Schloss."
     })
  );


  AddDetail( ({ "mitte","einbuchtung" }),
    "In der Mitte des Tores ist eine kleine Einbuchtung angebracht worden. "
    "Mit dem richtigen Schluessel kann man sie vielleicht oeffnen."
  );

  AddDetail( ({ "schluessel" }),
    "Hier liegt leider nicht der passende herum."
  );

  AddDetail( ({ "verzierungen","verzierung" }),
    "Sie zeigen fuer Dich nichts besonderes. Aber Du kannst kleine "
    "Spinnen und soetwas wie eine riesige Hoehle erkennen."
  );

  AddDetail( ({ "spinnen" }),
    "Die Spinnen sind viel groesser als Du sie kennst. Eine Spinne "
    "faellt Dir besonders auf."
  );

  AddDetail( ({ "spinne" }),
    "Diese uebergrosse Spinne vernichtet gerade andere Spinnen einzig "
    "und alleine mit ihrem Blick. Eine Aura umgibt sie auch."
  );

  AddDetail( ({ "blick" }),
    "Wenn dieser Blick tatsaechlich toeten kann, solltest Du Dich vorsehen."
  );

  AddDetail( ({ "aura" }),
    "Du kannst die Aura nur sehen, aber nichts fuehlen."
  );

  AddItem(NPC "waechterin", REFRESH_DESTRUCT);

  AddExit("sueden", ROOM "00-10-04" );
}
