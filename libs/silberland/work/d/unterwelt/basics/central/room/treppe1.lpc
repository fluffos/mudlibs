#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einer langen Wendeltreppe" );
  SetProp(P_INT_LONG,
    "Du stehst auf einer Wendeltreppe, die sich weit nach unten in die "
    "Tiefe windet. Auf dem Boden steht eine Leiter, die in einem Loch in "
    "der Decke verschwindet. Sonst gibt es hier eigentlich wenig zu "
    "sehen."
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "decke" }),
    "Sie ist roh und uneben. Eine Leiter steht auf dem Boden, deren Holme "
    "in einem Loch in der Decke verschwinden. "
  );

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus unzaehligen, nach unten fuehrenden Stufen. Eine "
    "Leiter fuehrt durch ein Loch in der Decke nach oben. "
  );

  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind roh und uneben. Kalter Fels, sonst nichts. "
    "Ausser einer kleinen, hier angeduebelten Tafel."
  );

  AddDetail( ({ "treppe", "wendeltreppe" }),
    "Die Treppe windet sich scheinbar endlos in die Tiefe. Das ist sicher "
    "kein Ort des Guten, wo diese Treppe hinfuehrt."
  );

  AddDetail( ({ "stufen", "stufe" }),
    "Die Stufen sind ebenso bucklig und uneben wie die Waende. Eine "
    "Frechheit, so etwas Gefaehrliches zu bauen. Den Hals koennte man sich "
    "hier brechen!"
  );

  AddDetail( ({ "fels" }),
    "Kalter Fels, sonst nichts."
  );

  AddDetail( ({ "tiefe" }),
    "Dort unten scheint es viel waermer zu sein als hier. Geothermik oder "
    "Hoellenfeuer?"
  );

  AddDetail( ({ "tafel", "steintafel" }),
    "Eine normale Steintafel, wie sie ueberall im Silberland fuer "
    "Verkuendungs- und Bekanntmachungszwecke verwendet wird. Die werden "
    "wahrscheinlich irgendwo maschinell hergestellt, weils so viele davon "
    "gibt. Ahja, Du kannst sie natuerlich lesen."
  );

  AddReadDetail( ({ "tafel", "steintafel" }),
    "\n       VORSICHT, STUFE!\n"
  );

  AddDetail( ({ "duebel" }),
    "Hey, gute Idee, so ein 'unt Duebel'! Koennte ja ein Forscherpunkt sein, "
    "besonders da das Wort 'Duebel' ja gar nicht als solches vorgekommen ist "
    "bis jetzt. Das muss belohnt werden! Drum als Wink mit dem Zaunpfahl: "
    "'Einer der Duebel scheint locker zu sein, vielleicht kann man ihn "
    "herausziehen?'"
  );

  AddDetail( ({"bekanntmachungszwecke","verkuendungszwecke"
              ,"bekanntmachungszweck","verkuendungszweck"}) ,
    "Viele Schilder stehen im Silberland. Ob sie auch alle immer gelesen "
    "werden? "
  );

  AddDetail( ({"frechheit","gefaehrliches"}) ,
    "Naja, wenns Dir nicht passt, dann bearbeite die Treppe halt selbst. "
  );

  AddDetail( ({"hals"}) ,
    "Toi toi toi, noch hast Du ihn Dir nicht gebrochen."
  );

  AddDetail( ({"hoellenfeuer","feuer"}) ,
    "Pass blos auf Dich auf, sonst wirst Du darin schmoren!"
  );

  AddDetail( ({"holm","holme"}) ,
    "Die Holme der Leiter verschwinden in einem Loch in der Decke. "
  );

  AddDetail( ({"leiter"}) ,
    "Eine Leiter steht auf dem Boden und verschwindet in einem Loch in "
    "der Decke. "
  );

  AddDetail( ({"ort"}) ,
    "Duester ist dieser Ort. "
  );

  AddDetail( ({"silberland"}) ,
    "Hoffentlich ist nicht das ganze Silberland so duester und trostlos "
    "wie dieser Ort. "
  );

  AddDetail( ({"loch"}) ,
    "In der Decke befindet sich ein Loch. Wo das wohl hinfuehren mag?"
  );

  AddDetail( ({"schilder"}) ,
    "Eines der vielen Schilder steht hier. "
  );

/*
*/
  AddCmd( ({ "ziehe", "zieh" }), "cmd_ziehen"  );

  AddCmd("ersteig|ersteige|steig|steige|kletter|klettere&leiter",
    "cmd_steigen",
    "Was moechtest Du ersteigen?"
  );

  AddExit("unten", ROOM "treppe2");
}

int cmd_ziehen(string str)
{
  notify_fail("Was moechtest Du herausziehen?\n");

  if(!str || str == "") return 0;
  if(str == "duebel heraus")
  {
    TELLPLAYER(BS("Du versuchst, den Duebel herauszuziehen, aber er steckt "
                  "doch zu weit drinnen. Du schaffst es einfach nicht ohne "
                  "eine Pinzette."));
    TELLOTHERS(BS(TPN+" versucht mit den Fingern, einen Duebel aus der Wand "
                      "zu ziehen, schafft es aber nicht."));
    return 1;
  }

//
// pinzette gibts keine, duebel auch keine, mehr brauchts nicht
//

  if(str == "duebel mit pinzette heraus")
  {
    TELLPLAYER("Du hast doch gar keine Pinzette dabei!\n");
    return 1;
  }

  return 0;
}

int cmd_steigen(string str)
{
  ROOM "keller"->PlayerUp(TP);

  return 1;
}


