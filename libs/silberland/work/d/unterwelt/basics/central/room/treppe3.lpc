#include "../def.h"

inherit "std/room";

int fackel_da;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer langen Wendeltreppe" );
  SetProp(P_INT_LONG,
    "Du stehst auf einer Wendeltreppe, die sich weit nach unten in die Tiefe "
    "und nach oben an die Oberflaeche windet. Es ist ziemlich eng hier, und "
    "Du willst am liebsten gleich weitergehen, weil es hier ja ohnehin nichts "
    "zu sehen gibt."
  );

  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24, ENV_TERRAIN: TT_CAVE]) );


  AddDetail( ({ "decke" }),
    "Du siehst keine Decke. Nach oben fuehrt eine lange Wendeltreppe."
  );

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus unzaehligen, nach unten fuehrenden Stufen."
  );

  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind roh und uneben. Blanker Fels, sonst nichts. "
  );

  AddDetail( ({ "treppe", "wendeltreppe" }),
    "Die Treppe windet sich scheinbar endlos in die Tiefe und in die Hoehe. "
    "Da man aber wegen der Windungen nicht weit sehen kann, koennte "
    "hinter jeder Biegung etwas lauern, das Dich angreifen will. Sei auf "
    "der Hut!"
  );

  AddDetail( ({ "stufen", "stufe" }),
    "Die Stufen sind ebenso bucklig und uneben wie die Waende. "
  );

  AddDetail( ({ "fels" }),
    "Der Fels der Waende ist hier beinahe lauwarm. Ausserdem weist er einige "
    "Kratzspuren auf, als ob etwas Scharfes daruebergeschrammt waere."
  );

  AddDetail( ({ "kratzspuren", "spuren" }),
    "Sie fuehren alle zu einem einzigen Punkt hin, bzw. gehen sie von diesem "
    "Punkt aus, so genau feststellen kann man das nicht."
  );

  AddDetail( ({ "punkt", "vertiefung" }),
    "Da scheint eine Vertiefung im Fels zu sein. Vielleicht kann man da "
    "hineingreifen?"
  );

  AddDetail( ({ "tiefe" }),
    "Dort unten scheint es viel waermer zu sein als hier. Geothermik oder "
    "Hoellenfeuer?"
  );

  AddDetail( ({ "windung", "biegung", "windungen" }),
    "Du schaust vorsichtig hinter die naechste Windung der Wendeltreppe, aber "
    "kannst nichts erkennen. Der Weg scheint frei zu sein."
  );

  AddDetail( ({ "hoehe" }),
    "Weiter oben wird es spuerbar kaelter. Erkennen kannst Du von hier aber "
    "nichts."
  );

  AddDetail( ({ "klappe" }),
    "Hmm. Eine kleine steinerne Klappe im Fels, die man kaum sieht, koennte "
    "fuer die Kratzspuren verantwortlich sein."
  );

  AddCmd( ({ "greife", "greif" }), "cmd_greifen" );

  AddExit("unten", ROOM "00-02-15");
  AddExit("oben",  ROOM "treppe2");

  fackel_da = 1;
}

void reset()
{
  fackel_da = 1;
  ::reset();
}

int cmd_greifen(string str)
{
  notify_fail("Wo willst Du hineingreifen?\n");

  if(str != "in vertiefung") return 0;

  if(fackel_da)
  {
    TELLPLAYER(BS("Du greifst in die Vertiefung und findest einen Hebel, an "
                  "dem Du fest ziehst. Ploetzlich oeffnet sich mit lautem "
                  "Knirschen eine kleine Klappe, die in der Wand verborgen "
                  "war, und eine Fackel faellt auf den Boden. Die Klappe "
                  "schliesst sich wieder und verschmilzt mit dem Fels der "
                  "Wand."));
    TELLOTHERS(BS(TPN+" fummelt irgendwie an der Felswand herum, woraufhin "
                  "sich eine Klappe, die Dir vorher gar nicht aufgefallen "
                  "ist, oeffnet, und eine Fackel vor Deine Fuesse faellt. "
                  "Die Klappe schliesst sich wieder und verschmilzt mit dem "
                  "Fels der Wand."));

    clone_object("/obj/fackel")->move(TO,M_NOCHECK);
    fackel_da = 0;
    return 1;
  }

  TELLPLAYER(BS("Du greifst in die Vertiefung und findest einen Hebel, an "
                "dem Du fest ziehst. Ploetzlich oeffnet sich mit lautem "
                "Knirschen eine kleine Klappe, die in der Wand verborgen "
                "war. Die Klappe schliesst sich jedoch sofort wieder und "
                "verschmilzt mit dem Fels der Wand. Du wartest noch ein paar "
                "Sekunden, aber weiter passiert nichts."));
  TELLOTHERS(BS(TPN+" fummelt irgendwie an der Felswand herum, woraufhin "
                "sich eine Klappe, die Dir vorher gar nicht aufgefallen ist, "
                "oeffnet. Die Klappe schliesst sich jedoch sofort wieder "
                "und verschmilzt mit dem Fels der Wand. Sonst passiert "
                "nichts."));

  return 1;
}



