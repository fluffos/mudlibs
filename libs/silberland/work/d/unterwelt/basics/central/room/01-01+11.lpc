#include "../def.h"

inherit "std/room";

mapping playerflag = ([ ]); // arm,bein,ziehen,wasserstand,schwimmen,

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem winzigen Krater");
  SetProp(P_INT_LONG,
    "Du haengst in einem tiefen Krater fest. Hier unten ist es sehr eng und "
    "Du kannst Dich kaum bewegen. Weit oben kannst Du noch den Rand des "
    "Kraters erkennen. Die Felswaende haben scharfe Kanten und Ecken. Du "
    "solltest Dich lieber beeilen, denn aus einem Loch stroemt Wasser "
    "herein. Wenn Du das nicht machst, dann wirst Du sterben!!!"
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_NOQUIT, 1);

  SetProp(P_KILL_NAME, "Fehlendes Blut");
  SetProp(P_KILL_MSG,  "Das naechste mal pass besser auf Dein Blut auf!");

  AddDetail( ({ "nordwand" }),
    "Die Nordwand ist ausserhalb Deines Bereiches."
  );

  AddDetail( ({ "bereich" }),
    "Der erstreckt sich auf alle Waende ausser der Nordwand."
  );

  AddDetail( ({ "ostwand" }),
    "An der Ostwand sind besonders viele scharfen Spitzen."
  );

  AddDetail( ({ "westwand" }),
    "Dir faellt nichts an der Westwand auf. Aber doch auf einmal scheinst "
    "Du eine kleine Zeichnung zu erkennen."
  );

  AddDetail( ({ "zeichnung" }),
    "Die Zeichnung ist rot und zeigt einen Abenteurer wie er gerade ertrinkt. "
    "Der arme Abenteurer muss die Zeichnung wohl kurz vor seinem Tod gemalt "
    "haben."
  );

  AddDetail( ({ "abenteurer" }),
    "Von dem ist nichts uebrig gebliegen."
  );

  AddDetail( ({ "tod" }),
    "Beeil Dich lieber!!"
  );

  AddDetail( ({ "suedwand" }),
    "Hoch oben an der Suedwand scheint etwas zu sein. Aber Du hast gerade "
    "besseres zu tun, als dem nachzugehen."
  );

  AddDetail( ({ "schmerzen","schmerz" }),
    "Auuuuua!!"
  );

  AddDetail( ({ "ecken","ecke" }),
    "Alle Ecken sind scharf und spitz."
  );

  AddDetail( ({ "kanten" }),
    "Die Kanten fuegen Dir bei jeder Bewegung unsagbare Schmerzen zu. Pass "
    "genau auf Dich auf, sonst passiert Dir noch was."
  );

  AddDetail( ({ "grund" }),
    "Es ist zu dunkel in den Rissen um den Grund zu sehen."
  );

  AddDetail( ({ "risse" }),
    "Die Risse im Boden sind wirklich gemein. Einer ist in etwa so gross "
    "wie Dein Bein. Langsam sammelt sich Wasser darin und steigt an. Du kannst "
    "den Grund aber auch nicht erkennen."
  );

  AddDetail( ({ "wand" }),
    "Welche Wand meinst Du?"
  );

  AddDetail( ({ "richtung" }),
    "Damit sind die Nordwand, Suedwand, Ostwand und Westwand gemeint."
  );

  AddDetail( ({ "waende","felswaende" }),
    "Du siehst Waende in noerdlicher, suedlicher, oestlicher und westlicher "
    "Richtung. Die Waende selber sind aus hartem Fels und haben ueberall "
    "scharfe Kanten und Ecken."
  );

  AddDetail( ({ "bewegung" }),
    "Du solltest Dich wirklich vorsichtig bewegen, denn nur die kleinste "
    "Bewegung schmerzt schon sehr. Aber ausruhen kannst Du Dich auch nicht."
  );

  AddDetail( ({ "fels" }),
    "Dunkler und harter Fels. Er ist sehr spitz und fast jede Bewegung von "
    "Dir schmerzt irgendwo."
  );

  AddDetail( ({ "boden" }),
    "Den Boden kannst Du vor lauter Rissen gar nicht richtig erkennen. Er "
    "ist aus hartem Fels und Wasser steigt langsam an. Aber das Wasser scheint "
    "nirgends abzulaufen."
  );

  AddDetail( ({ "krater","raum" }),
    "Der Krater, in dem Du festsitzt, laesst Dir nicht viel Bewegungsfreiraum. "
    "Er verlaeuft nach unten hin spitz zu und Du steckst drin fest. Wasser "
    "laeuft aus einem Loch herein und fuellt den Krater langsam.");

  AddDetail( ({ "bewegungsfreiraum","freiraum" }),
    "Der Krater ist so eng, dass Du Dich kaum bewegen kannst."
  );

  AddDetail( ({ "loch" }),
    "Aus einem Loch in der Wand stroemt staendig Wasser nach. Wenn Du Dich "
    "nicht beeilst, wirst Du elendig ertrinken."
  );

  AddDetail( ({ "wasser" }),
    "Der Wasserstand waechst und waechst. Ausserdem ist das Wasser sehr kalt."
  );

  AddDetail( ({ "anstrengungen","anstrengung" }),
    "Du steckst immer noch in dem Krater fest. Du solltest wirklich schnell "
    "nach einem Ausweg suchen."
  );

  AddDetail( ({ "ausweg" }),
    "Auf den ersten Blick kannst Du keinen erkennen."
  );

  AddDetail( ({ "blick" }),
    "Auch der zweite Blick verraet Dir nicht viel mehr. Leider."
  );

  AddDetail( ({ "decke","rand" }),
    "Du kannst den Rand des Kraters gerade noch so erkennen. Scharfe Spitzen "
    "versperren Dir aber den direkten Weg nach oben."
  );

  AddDetail( ({ "spitzen" }),
    "Die Spitzen sind ur scharf und ragen weit in den Krater hinein. Eine der "
    "Spitzen faellt Dir auf."
  );

  AddDetail( ({ "weg" }),
    "Einen direkten Weg raus hier kannst Du nicht erkennen. Du musst Dich "
    "schon genauer umsehen."
  );

  AddDetail( ({ "blut" }),
    "Das ist wohl tatsaechlich Dein eigenes Blut."
  );

  AddDetail( ({"bauch"}) ,
    "Kuemmer Dich nicht so um Deinen Bauch, sondern sie zu, dass Du hier "
    "schnell wieder herauskommst. "
  );

  AddDetail( ({"situation"}) ,
    "Die ist nicht gerade berauschend."
  );

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein Rauschen von Wasser."
  );

  AddSound( "rauschen",
    "Das Wasser tritt durch ein kleines Loch in den Krater ein und verursacht "
    "ein lautes Rauschen."
  );

  AddSound( "wasser",
    "Das Wasser verursacht ein nicht zu ueberhoerendes Rauschen."
  );

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach fauligem Wasser."
  );

  AddSmell( "wasser",
    "Das Wasser riecht abgestanden und faulig."
  );

  AddSpecialDetail( ({ "wasserstand" })                   , "detail_wasserstand");
  AddSpecialDetail( ({ "arm", "arme", "hand", "haende" }) , "detail_arm");
  AddSpecialDetail( ({ "bein", "beine" })                 , "detail_bein");
  AddSpecialDetail( ({ "spitze" })                        , "detail_spitze");
  AddSpecialDetail( ({ "riss" })                          , "detail_riss");
  AddSpecialDetail( ({ "vorsprung" })                     , "detail_vorsprung");
  AddSpecialDetail( ({ "rand" })                          , "detail_rand");

  AddCmd( ({ "such","suche" })       , "cmd_suchen" );
  AddCmd( ({ "loes","loese" })       , "cmd_loesen" );
  AddCmd( ({ "befrei","befreie" })   , "cmd_befreien" );
  AddCmd( CMD_KLETTERN               , "cmd_klettern" );
  AddCmd( ({ "ziehe","zieh" })       , "cmd_ziehen");
  AddCmd( ({ "schwimm","schwimme" }) , "cmd_schwimmen" );
  AddCmd( ({ "check" })              , "cmd_check" );

  playerflag=([ ]);

}

void init()
{
  ::init();

  if (living(TP) && !interactive(TP))
  {
    call_out("remove_npc",2,TP);
  }

  if(interactive(TP) && !member(playerflag, getuid(TP)))
  {
    playerflag+=([getuid(TP):0;0;0;0;0]);
  }

  if(find_call_out("wasserhoch") == -1) {
    call_out("wasserhoch",60+random(20));
  }
}

string detail_wasserstand(string str)
{
  string s;

  switch (playerflag[getuid(TP), 3]) {
    case 0:
      s = "Das Wasser ist noch nicht sehr hoch gestiegen.";
      break;

    case 1:
      s = "Das Wasser bisher nur sehr wenig angestiegen.";
      break;

    case 2:
      s = "Das Wasser kuehlt Deine Waden aus.";
      break;

    case 3:
      s = "Das Wasser geht Dir bis zu den Knien.";
      break;

    case 4:
      s = "Deine Beine sind inzwischen vollstaendig nass geworden.";
      break;

    case 5:
      s = "Du stehst schon zur Haelfte im Wasser.";
      break;

    case 6:
      s = "Dein Bauch steht unter Wasser.";
      break;

    case 7:
      s = "Deine Brust ist schon recht feucht geworden.";
      break;

    case 8:
      s= "Der Wasserstand hat Deinen Hals schon erreicht.";
      break;

    case 9:
      s = "Jeden Moment wirst Du ertrinken!!";
      break;

    default:
      s = "Du bist ertrunken, aber wen stoert das schon?";
      break;

  }

  return BS(s);
}

string detail_arm(string str)
{
  if (playerflag[getuid(TP), 0] == 1)
    return "Dein Arm ist blutig, aber dafuer frei.\n";

  return "Dein Arm ist an einer Spitze gefangen.\n";
}

string detail_bein(string str)
{
  if (playerflag[getuid(TP), 1] == 1)
    return "Dein Bein schmerzt sehr, ist dafuer aber frei.\n";

  return "Dein Bein ist in einem der Risse festgeklemmt.\n";
}

string detail_spitze(string str)
{
  if (playerflag[getuid(TP), 0] == 1)
    return BS("Diese Spitze ragt am weitesten in den Krater hinein. Blut "
              "klebt an ihr. ");

  return BS("Diese Spitze ragt am weitesten in den Krater hinein. Dein Arm "
            "ist an ihm gefangen. Bevor Du etwas anderes machen kannst, "
            "solltest Du ihn besser abloesen." );
}

string detail_riss(string str)
{
  if (playerflag[getuid(TP), 1] == 1)
    return BS("Dieser Riss ist genau so gross wie Dein linkes Bein. Aber Du "
              "hast Dein Bein ja gluecklicherweise befreien koennen.");

  return BS("Dieser Riss ist genau so gross wie Dein Bein. Dein Bein ist "
            "auch in diesem Riss eingeklemmt. Du solltest es besser "
            "befreien, sonst wirst Du hier noch ertrinken." );
}

string detail_vorsprung(string str)
{
  if ((playerflag[getuid(TP), 1] == 1) && (playerflag[getuid(TP), 0] == 1))
  {
    return BS(
      "Der kleine Vorsprung ist Dir vorher ueberhaupt nicht aufgefallen. Du "
      "warst ja auch erst zu beschaeftigt. Um jetzt endlich aus dem Krater "
      "ganz herauszukommen, solltest Du Dich erstmal weiter hoch kommen. "
      "Vielleicht schaffst Du es ja, Dich ein wenig hoeher zu ziehen.");
  }

  return "Sowas siehst Du da nicht!\n";
}

string detail_rand(string str)
{
  if ((playerflag[getuid(TP), 1] == 1) &&
      (playerflag[getuid(TP), 0] == 1) &&
      (playerflag[getuid(TP), 2] == 1))
  {
    return BS("Der Rand ist Dir jetzt sehr nahe. Jetzt kommst Du bestimmt "
              "irgendwie aus dem Krater heraus.");
  }

  return BS("Der Rand des Kraters ist sehr weit oben. Du kannst ihn von "
            "hier aus ohne weitere Anstrengungen nicht erreichen.");
}

int cmd_loesen(string str)
{
  notify_fail("Was willst Du abloesen?\n");

  if(!str || str == "") return 0;
  if(!(str == "arm ab"      ||
       str == "arm"         )) return 0;

  if(playerflag[getuid(TP), 0] == 0)
  {
    TELLPLAYER(BS("Du nimmst Deinen ganzen Mut zusammen und reisst einmal "
                  "kraeftig an Deinem Arm. Unter grossen Schmerzen kannst "
                  "Du ihn auch abloesen."));
    TELLOTHERS(BS(TPN+" schreit auf, als "+TP->QueryPronoun(WER)+" "+
                  TP->QueryPronoun(MALE,WEN,SINGULAR)+" Arm von einer "
                  "scharfen Spitze abreisst." ));

    playerflag[getuid(TP), 0] = 1;
    TP->AddHp(-10-random(10));
  }
  else
  {
    TELLPLAYER("Aber Du hast Deinen Arm schon abgeloest.\n");
  }

  return 1;
}

int cmd_befreien(string str)
{
  notify_fail("Was willst Du befreien?\n");

  if(!str || str == "") return 0;
  if(!(str == "bein"         ||
       str == "mein bein"    )) return 0;

  if(playerflag[getuid(TP), 1] == 0)
  {
    if(playerflag[getuid(TP), 0] == 0)
    {
      TELLPLAYER(BS("Du brauchst beide Haende um Dein Bein zu befreien. "
                    "Sorg erstmal dafuer!"));
        return 1;
    }

    TELLPLAYER(BS("Du greifst mit beiden Haenden Dein Bein und ziehst es "
                  "mit einem gewaltigen Ruck aus dem Riss heraus. Das tut "
                  "echt weh!"));
    TELLOTHERS(BS(TPN+" schreit auf, als "+TP->QueryPronoun(WER)+" "+
                  TP->QueryPossPronoun(NEUTER,WEN,SINGULAR)+" Bein anhebt." ));
    playerflag[getuid(TP), 1] = 1;
    TP->AddHp(-10-random(10));
  }
  else
  {
    TELLPLAYER("Aber Du hast Dein Bein schon befreit.\n");
  }

  return 1;
}

int cmd_ziehen(string str)
{
  string s1,s2;

  notify_fail("Was willst Du hochziehen?\n");

  s1 = getuid(TP)+" hoch";
  s2 = getuid(TP)+" hoeher";

  if(!str || str == "") return 0;
  if(!(str == "koerper hoch"         ||
       str == "mich hoch"            ||
       str == "dich hoch"            ||
       str == "mich hoeher"          ||
       str == "dich hoeher"          ||
       str == "koerper hoeher"       ||
       str == s1                     ||
       str == s2                     )) return 0;

  if(playerflag[getuid(TP), 2] == 0)
  {
    if(playerflag[getuid(TP), 0] == 0)
    {
      TELLPLAYER("Du brauchst dafuer beide Haende!\n");
      return 1;
    }

    if(playerflag[getuid(TP), 1] == 0)
    {
      TELLPLAYER("Dein Bein sollte dafuer schon frei sein!\n");
      return 1;
    }

    TELLPLAYER(BS("Mit aller Kraft ziehst Du Dich ein kleines Stueck zu dem "
                  "kleinen Vorsprung hoch. Leider fuegen Dir die ganzen "
                  "Kanten und Spitzen einen nicht zu unterschaetzenden "
                  "Schaden zu. Jetzt bist Du hoch genug, um den Rand gerade "
                  "so zu erreichen!"));
    TELLOTHERS(BS(TPN+" erhebt sich ein Stueck aus dem Krater.\n"));
    playerflag[getuid(TP), 2] = 1;
    TP->AddHp(-10-random(10));
  }
  else
  {
    TELLPLAYER("Aber Du hast Dich doch schon hochgezogen.\n");
  }

  return 1;
}

int cmd_klettern(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");

  if(!str || str == "") return 0;
  if(!(str == "hoch"            ||
       str == "raus"            ||
       str == "rand hoch"       ||
       str == "rand"            ||
       str == "oben"            ||
       str == "nach oben"       ||
       str == "rauf"            ||
       str == "aus krater"      ||
       str == "aus krater raus" )) return 0;

  if (playerflag[getuid(TP), 0] == 0)
  {
    TELLPLAYER("Du brauchst dafuer beide Haende!\n");
    return 1;
  }

  if (playerflag[getuid(TP), 1] == 0)
  {
    TELLPLAYER("Dein Bein sollte dafuer schon frei sein!\n");
    return 1;
  }

  if (playerflag[getuid(TP), 2] == 0)
  {
    TELLPLAYER(BS("Du bist dafuer leider zu weit unten in dem Krater und "
                  "kannst den Rand so noch nicht erreichen!"));
    return 1;
  }

  TELLPLAYER(BS("Mit Deinen letzten Kraeften kletterst Du aus dem Krater "
                "raus! Leider erwischen Dich noch die letzten Spitzen und "
                "Kanten ein wenig."));

  playerflag=m_delete(playerflag, getuid(TP));

  TP->move(ROOM "00-01+11", M_GO, "aus dem Krater heraus", "klettert",
      "kommt neben den Brettern hochgeklettert und sieht ziemlich "
      "erschoepft aus");

  TP->AddHp(-10-random(10));

  return 1;
}

int cmd_suchen(string str)
{
  if(str == "ausweg" || str == "nach ausweg")
  {
    if ((playerflag[getuid(TP), 1] == 1) &&
        (playerflag[getuid(TP), 0] == 1))
    {
      TELLPLAYER(BS("Du suchst und suchst und findest erst nichts. Doch auf "
                    "einmal faellt Dir ein kleiner Vorsprung auf." ));
      return 1;
    }
    else
    {
      TELLPLAYER("In Deiner augenblicklichen Situation bringt Dir das "
                 "Suchen nichts!\n");
      return -1;
    }
  }

  return 0;
}

int cmd_schwimmen(string str)
{
  if(playerflag[getuid(TP), 4] == 1)
  {
    TELLPLAYER(BS("Du bist schon einmal geschwommen und hast einfach keine "
                  "Kraft mehr dazu. Du musst ganz schnell einen anderen "
                  "Ausweg suchen!!!" ));
    return 1;
  }

  if(playerflag[getuid(TP), 0] == 0)
  {
    TELLPLAYER("Du brauchst dafuer beide Haende!\n");
    return 1;
  }

  if(playerflag[getuid(TP), 1] == 0)
  {
    TELLPLAYER("Dein Bein muss dafuer schon frei sein!\n");
    return 1;
  }

  TELLPLAYER(BS("Du schwimmst ein wenig und gewinnst dadurch ein wenig "
                "Zeit. Viel ist es aber nicht und das Schwimmen hat Dich "
                "soviel Kraft gekostet, so dass Du kein zweites Mal "
                "schwimmen kannst. Du musst wirklich sehr schnell einen "
                "anderen Ausweg finden, sonst wird hier Dein Leben zu Ende "
                "sein und Du wirst elendig ertrinken!!!" ));

  playerflag[getuid(TP), 4] = 1;
  playerflag[getuid(TP), 3] -= 1;

  return 1;
}

int cmd_check(string str)
{
  if(!IS_WIZARD(TP)) return 0;

  TELLPLAYER(sprintf("%d %d %d %d %d \n"
    ,playerflag[getuid(find_living(str)), 0]
    ,playerflag[getuid(find_living(str)), 1]
    ,playerflag[getuid(find_living(str)), 2]
    ,playerflag[getuid(find_living(str)), 3]
    ,playerflag[getuid(find_living(str)), 4]
  ));
  return 1;
}

void remove_tp(object ob)
{
  if((present(ob)) && (!interactive(ob)))
  {
    tell_room(TO,CAP(ob->Name())+" ertrinkt grausam. Du kannst leider nicht "
                 "helfen.\n", ({ ob }));
    ob->remove();
  }
}

void wasserhoch()
{
  object pl, *plist;
  int i,playerin;
  string s;

  if(find_call_out("wasserhoch") > -1) return; //wenn noch einer laeuft, nichts
                                               //mehr tun

  plist    = filter_array(all_inventory(TO),#'interactive);
  i        = sizeof(plist);
  playerin = 0;

  while(i--)
  {
    playerin = 1;
    pl = plist[i];

    playerflag[getuid(pl), 3] += 1;

    switch(playerflag[getuid(pl), 3])
    {
      case 2:
        s = "Du hast hier nur SEHR wenig Zeit, wenn Du vorhast NICHT zu "
            "sterben!";
        break;

      case 3:
        s = "Du solltest Dich wirklich sehr beeilen!";
        break;

      case 4:
        s = "Dein Leben ist in SEHR GROSSER Gefahr!";
        break;

      case 5:
        s = "Dir bleibt nicht mehr viel Zeit! Setz endlich Deinen Hintern "
            "in Bewegung und beeil Dich!";
        break;

      case 6:
        s = "Lars erscheint und sagt: Beeil Dich endlich, ich hab keine "
            "Zeit fuer Dich!";
        break;

      case 7:
        s = "Wenn Du Dich jetzt nicht wirklich beeilst, dann wirst Du "
            "ertrinken. Da bist Du Dir 100% sicher!";
        break;

      case 8:
        s = "Das Wasser steigt und steigt. Todesangst kommt in Dir auf und "
            "Du beschliesst Dich endlich zu beeilen! Denn Du wirst die "
            "naechsten Wassererhoehungen nicht ueberleben!";
        break;

      case 9:
        s = "Du bist jetzt ganz knapp vorm Ertrinken und schluckst schon "
            "jede Menge Wasser!!!";
        break;

      case 10:
        s = "";
        tell_object(pl,"Du ertrinkst.\n");
        tell_room(TO,CAP(pl->Name())+" ertrinkt.\n", ({ pl }) );

        playerflag=m_delete(playerflag, getuid(pl));

        SetProp(P_KILL_NAME, "Ertrinken");
        SetProp(P_KILL_MSG,  "Atme lieber Luft, das ist gesuender!");
        pl->die();
        WRITELOG(CAP(getuid(pl))+" ertrinkt im Krater");
        SetProp(P_KILL_NAME, "Fehlendes Blut");
        SetProp(P_KILL_MSG, "Das naechste mal pass besser auf Dein Blut auf!");
        break;

      default:
        s = "Das Wasser steigt weiter an. Du solltest schneller handeln.";
    }

    if(s != "") tell_object(pl,BS(s));
  }
  if (playerin == 1) call_out("wasserhoch",60+random(20));
}

void BecomesNetAlive(object pl)
{
  int zeit;

  if(!member(playerflag, getuid(pl)))
  {
    SetProp (P_KILL_NAME, "Ertrinken");
    SetProp (P_KILL_MSG,  "Atme lieber Luft, das ist gesuender!");
    pl->die();
    WRITELOG(CAP(getuid(pl))+" ertrinkt im Krater(NetAlive)");
    SetProp (P_KILL_NAME, "Fehlendes Blut");
    SetProp (P_KILL_MSG,  "Das naechste mal pass besser auf Dein Blut auf!");
  }
  else
  {
    if(find_call_out("wasserhoch") == -1)
      call_out("wasserhoch",60+random(20));
  }
}

