#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf der Spitze eines Stalagmiten");
  SetProp(P_INT_LONG,
    "Du befindest Dich an der Spitze des Stalagmiten. Die Decke ist nun "
    "knapp ueber Dir, aber sonst kannst Du nicht viel erkennen."
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 28, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "wand", "waende", "boden", "hoehle" }),
    "Das verliert sich in der Dunkelheit. Du kannst nichts Genaues "
    "erkennen."
  );

  AddDetail( ({ "dunkelheit" }),
    "Stockdunkle Dunkelheit verschluckt alles, was weiter als ein paar Meter "
    "von Dir entfernt ist."
  );

  AddDetail( ({ "decke" }),
    "Die Decke ist an dieser Stelle zum Greifen nahe. Viele Fledermaeuse "
    "benutzen die Decke der Hoehle als Schlafplatz, doch die meisten "
    "meiden diesen Ort, wo Du stehst."
  );

  AddDetail( ({ "fledermaeuse" }),
    "Die meisten Fledermaeuse schlafen weiter weg von hier."
  );

  AddDetail( ({ "spitze", "stalagmit" }),
    "Du befindest Dich auf der Spitze des Stalagmiten. Der Stalagmit wird "
    "nach unten hin wieder viel breiter."
  );

  AddDetail( ({ "stalaktit" }),
    "Auffaelligerweise befindet sich ueber diesem Stalagmiten kein Stalaktit. "
    "Der Stalagmit reicht einfach nur fast bis zur Decke."
  );

  AddDetail( ({ "fels" }),
    "Es handelt sich um den ueblichen schwarzen Fels der Unterwelt. *gaehn*"
  );

  AddDetail( ({ "stufe", "stufen" }),
    "Die Stufen fuehren wieder nach unten auf den Boden zurueck."
  );

  AddExit("unten", ROOM "00+04-06");

  AddItem(NPC "batqueen", REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]) );

  AddItem(NPC "vampbat",  REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]) );
  AddItem(NPC "vampbat",  REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]) );
  AddItem(NPC "vampbat",  REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]) );
}

void runter(object wer)
{
  if(objectp(wer) && environment(wer) == TO)
  {
    tell_object(wer, BS("Du stoerst die Fledermauskoenigin bei ihrem "
                        "Schlummer. Sie wird fuchsteufelswild, stuerzt sich "
                        "auf Dich und wirft Dich hinunter! Du faellst "
                        "hinunter und schlaegst am Boden auf."));

    wer->move(ROOM "00+04-06", M_GO | M_NO_SHOW, "in die Tiefe",
       "stuerzt", "knallt am Boden auf");

    wer->AddHp(10+random(30));
  }
}

void init()
{
  ::init();

  if((present("fledermauskoenigin", TO)) && interactive(TP) && !IS_WIZARD(TP))
  {
    call_out("runter", 0, TP);
  }
}

