#include "../def.h"

inherit "std/room";

int licht;

void create()
{
  ::create();

  UMASTER->Customize(TO);

  AddDetail( ({ "decke" }),
    "An der Decke kannst Du tatsaechlich einen kleinen Lichtpunkt erkennen."
  );

  AddSpecialDetail( ({ "lichtpunkt" }), "detail_lichtpunkt" );

  AddCmd( ({ "fange","fang" }), "cmd_fangen" );

  AddExit("suedosten"  , ROOM "00-06-06");
  AddExit("westen"     , ROOM "00-05-08");

  licht = 1;
}

void reset()
{
  ::reset();

  licht = 1;
}

string detail_lichtpunkt(string str)
{
  string s;

  if(licht)
  {
    s = "Der Lichtpunkt bewegt sich leicht. Vielleicht kann man ihn ja "
        "einfangen?";
  }
  else
  {
    s = "Oh, war wohl doch nichts da.";
  }

  return BS(s);
}

int cmd_fangen(string str)
{
  notify_fail("Was moechtest Du fangen?\n");

  if(!str || str == "") return 0;
  if(!(str == "lichtpunkt"         ||
       str == "punkt"              ||
       str == "punkt ein"          ||
       str == "lichtpunkt ein"     )) return 0;

  if(!licht)
  {
    TELLPLAYER("Aber hier laesst sich nichts fangen!\n");
    return -1;
  }

  if(!random(5))
  {
    TELLPLAYER("Geschickt faengst Du den kleinen Lichtpunkt ein.\n");
    TELLOTHERS(CAP_TPN+" faengt etwas. Nur was?\n");
    licht = 0;
    CLONE(OBJ "lichtpunkt",TP);
    return 1;
  }

  TELLPLAYER("Der Lichtpunkt ist leider zu schnell fuer Dich und entkommt.\n");
  TELLOTHERS(CAP_TPN+" versucht etwas einzufangen, doch scheitert klaeglich.\n");

  return -1;
}


