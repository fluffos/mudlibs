//
// Project: unterwelt basis Stalagmitenhoehle mit Fledermaeusen
//
//=========================================================================

#include "../def.h"

inherit "std/room";

void create()
{
  int i;

  ::create();

  SetProp(P_INT_SHORT, "In einer riesigen Stalagmitenhoehle");
  SetProp(P_INT_LONG,
    "Du bist in einer weiten Hoehle. Ihre Ausmasse kannst Du aber schlecht "
    "ueberblicken, da Dir ueberall gewaltige Stalagmiten, die wie "
    "uralte Baeume aus der Erde wachsen, die Sicht verstellen. "
    "In den Augenwinkeln siehst Du seltsam huschende Bewegungen von "
    "lautlosen Kreaturen, aber Du kannst nichts Genaues erkennen, weil "
    "die Stalagmiten immer wieder Deckung geben."
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25,ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "stalagmiten", "stalagmit" }),
    "An manchen Stellen beginnen gerade erst kleine Stalagmitenbabies "
    "damit, zu wachsen. An anderen Stellen sind bereits riesige Felsnadeln "
    "in die Hoehe gewachsen und verschwinden nach oben in der Dunkelheit. "
    "Einige sind sogar so hoch, das sie mit ebenso grossen, von der Decke "
    "haengenden Stalaktiten zusammengewachsen sind und so "
    "durchgehende Felsensaeulen bilden."
  );

  AddDetail( ({ "boden" }),
    "Der Boden ist sehr uneben. Ueberall wachsen Stalagmiten hervor. "
    "Kleine wie grosse. Du musst immer achtgeben, Dir nicht die "
    "Schienbeine wundzustossen."
  );

  AddDetail( ({ "waende", "wand", "netz" }),
    "Die Waende der Hoehle bestehen eigentlich aus vielen Fels"
    "saeulen, die immer dichter ineinander uebergehen und so ein "
    "undurchdringliches Netz aus Gestein bilden."
  );

  AddDetail( ({ "decke" }),
    "Von der Decke kannst Du nur die vielen von dort herunterhaengenden "
    "Stalaktiten erkennen."
  );

  AddDetail( ({ "fels", "gestein" }),
    "Das Gestein ist hier ziemlich normal und nicht so schleimig "
    "und auch bei weitem nicht so warm wie in den engen Gaengen "
    "ausserhalb dieser Hoehle."
  );

  AddDetail( ({ "babies", "stalagmitenbabies", "stalagmitenbaby" }),
    "Das staendige Heruntertropfen von Wasser von der Decke fuehrt "
    "langsam zu einer Anhaeufung von Kalk, wo die Tropfen auftreffen, und "
    "natuerlich auch dort, wo die Tropfen sich bilden und herunterfallen. "
    "An einigen Stellen kann man gut den Beginn eines neuen Stalagmiten "
    "bewundern. Doch selbst das juengste Stalagmitenbaby ist ururalt, denn "
    "die Tropfen sind selten, das Wachstum langsam und der Fels "
    "zeitlos."
  );

  AddDetail( ({ "hoehe", "dunkelheit", "dimensionen" }),
    "Die Dunkelheit der Hoehle laesst ihre Dimensionen schwer erkennen."
  );

  AddDetail( ({ "stellen" }),
    "Es gibt grosse und kleine Stalagmiten. An manchen Stellen beginnen "
    "gerade erst welche zu entstehen, an anderen Stellen wachsen "
    "schon seit Aeonen Stalagmiten empor."
  );

  AddDetail( ({ "felsensaeulen", "saeulen" }),
    "Da jeder Stalagmit oben an der Decke einen Stalaktitenzwilling "
    "hat, von dem die steten Wassertropfen herunterfallen, ist es nicht "
    "verwunderlich, dass die gewaltigsten Felsnadeln auf ihrem "
    "Weg nach oben auf halber Strecke eben diesem Zwilling begegnen und "
    "mit ihm zusammenwachsen. Doch damit hat das Wachstum noch lange kein "
    "Ende, denn die Tropfen fliessen halt nun an der Saeule herab und "
    "hinterlassen so eine gleichmaessige, winzige Kalkspur, die im "
    "Laufe der Aeonen die Saeule noch imposanter und breiter macht."
  );

  AddDetail( ({ "kalk", "anhaeufung" }),
    "Jeder Tropfen, der am Boden auftrifft, hinterlaesst ein paar Molekuele "
    "mehr auf dem wachsenden Stalagmiten. So waechst das Gestein in "
    "vielen Jahrtausenden bis zur Decke hinauf."
  );

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "tropfen", "wassertropfen" }),
    "Hin und wieder faellt ein Tropfen von der Decke herab. Doch das "
    "geschieht so selten, dass sich nicht einmal kleine Pfuetzen "
    "bilden koennen. Nur die Luftfeuchtigkeit ist ziemlich hoch. "
    "Weiter oben muss es wohl seltsamerweise kuehler sein, damit die "
    "Feuchtigkeit kondensieren und diese Tropfen bilden kann. Oder "
    "entstehen die Tropfen gar durch durchgesickertes Grundwasser?"
  );

  AddDetail( ({ "feuchtigkeit", "luftfeuchtigkeit" }),
    "Ziemlich hoch. Richtig schwuel hier drin."
  );

  AddDetail( ({ "nadeln", "felsnadeln" }),
    "Die groessten Stalagmiten reichen hoeher hinauf als die groessten "
    "Baeume, die Du kennst. Ein wahrhaft beeindruckender Anblick!"
  );

  AddDetail( ({ "zwilling", "zwillinge" }),
    "Jeder Stalagmit hat ueber sich einen Zwilling in Form eines "
    "Stalaktiten."
  );

  AddDetail( ({ "stalaktit", "stalaktiten" }),
    "Die Stalaktiten werden im Durchschnitt ebenso gross, wie die "
    "Stalagmiten, aber Du kannst von hier unten ihre Groesse kaum "
    "bewundern. Als Du genauer hinsiehst, erkennst Du ueberall auf "
    "den Stalaktiten kleine, dunkle Punkte."
  );

  AddDetail( ({ "punkte" }),
    "Du kneifst die Augen zusammen und erkennst, dass es sich doch "
    "tatsaechlich um Tiere handeln muss, die dort oben an den Stalaktiten "
    "haengen. Es muessen zigtausende davon sein."
  );

  AddDetail( ({ "tiere" }),
    "Das koennen eigentlich nur Fledermaeuse sein. Erstaunlich, dass "
    "man sie ueberhaupt sehen kann, wo sie doch so weit oben sind..."
  );

  AddDetail( ({ "fledermaus", "fledermaeuse" }),
    "An den Stalaktiten weit oben kannst Du viele viele Fledermaeuse "
    "ausmachen. Manchmal kommen sie auch herunter und jagen."
  );

  AddDetail( ({ "schienbein", "schienbeine" }),
    "Pass drauf auf, damit Du Dir nicht wehtust!"
  );

  AddDetail( ({ "augenwinkel", "bewegungen", "kreaturen" }),
    "Es muss sich um fliegende Kreaturen handeln. Sie sind voellig lautlos."
  );

  AddDetail( ({ "ausmasse", "ausmass" }),
    "Die Ausmasse der Hoehle duerften wirklich gross sein."
  );

  AddDetail( ({ "erde" }),
    "Der Boden besteht eher aus Fels als aus Erde."
  );

  AddDetail( ({ "baeume" }),
    "Das war nur eine Metapher. In Wirklichkeit sind das alles Stalagmiten."
  );

  AddDetail( ({ "metapher" }),
    "Nein, hier gibt es keinen Forscherpunkt fuer 'unt metapher'! "
    "Untersuch jetzt nicht weiter, wenn Dir Dein Leben lieb ist."
  );

  AddDetail( ({ "leben", "fall" }),
    "Du sollst nicht weiter untersuchen! \nUntersuch auf keinen Fall Ein Wort "
    "der naechsten Zeile:\n"
    "Bumm Zack Peng, Dich hats Erwischt!\n"
  );

  AddSpecialDetail( ({ "bumm", "zack", "peng" }), "detail_bummpeng" );

  AddDetail( ({ "deckung" }),
    "Die Stalagmiten geben den Kreaturen Deckung."
  );

  AddSound( ({ DEFAULT_SOUND, "geraeusche" }),
    "Du hoerst ein unangenehm hohes Fiepen und Pfeifen, kannst "
    "aber den Ursprung der Geraeusche nicht lokalisieren."
  );

  AddSound( ({ "fiepen", "pfeifen" }),
    "Die Geraeusche sind sehr leise, und darueber bist Du froh, weil "
    "sie sich sehr hoch und schrill anhoeren."
  );

  AddSmell( ({ DEFAULT_SMELL, "luft" }),
    "Die Luft riecht etwas abgestanden, aber trotzdem viel frischer "
    "als in den endlosen Gaengen der Unterwelt." );

  i = random(3);
  while(i--) AddItem(NPC "bat", REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]) );

  AddSpecialExit("aufgabe", "exit_aufgabe" );
  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
}

int exit_aufgabe(string str)
{
  notify_fail("Aufgeben gilt nicht!\n");
  return 0;
}

string detail_bummpeng(string str)
{
  object ob;

  SetProp(P_KILL_NAME, "Ein Untersuchescript");
  TP->SetProp(P_TITLE, "der Scripter");
  switch(random(100))
  {
    case 0..10:  if(ob=present("geld", TP)) ob->remove(); break;
    case 11..20: TP->AddPoison(100); break;
    case 21..30: TP->SetProp(P_FROG, 1); break;
    case 31..40: TP->SetProp(P_BLIND, -1); break;
    case 41..70: TP->SetProp(P_MAX_HANDS, 0);
    default: TP->do_damage(100+random(100));
  }
  return "Scripter!\nIrgendetwas Schlimmes ist passiert.\n";
}
