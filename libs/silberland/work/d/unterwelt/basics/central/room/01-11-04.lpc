#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();

  UMASTER->Customize(TO);

  AddExit("suedunten", ROOM "02-12-04" );
  AddExit("sueden",    ROOM "02-12-04" );
  AddExit("nordoben",  ROOM "00-10-04" );
  AddExit("norden",    ROOM "00-10-04" );

  SetProp(P_HIDE_EXITS, ({ "sueden","norden" }) );
}
