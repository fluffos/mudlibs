#include "../def.h"

inherit "std/room";

int offen;

void create()
{
  ::create();

  UMASTER->Customize(TO);

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2] +
    "Weiterhin faellt Dir die Ostwand auf.");

  AddDetail( ({"gewalt"}),
    "Du koenntest versuchen die Ostwand aufzubrechen.");

  AddSpecialDetail( ({"ostwand"}) ,    "detail_wand");

  AddCmd( ({"breche", "brech", "brich" }),   "cmd_brechen");
  AddCmd( CMD_KRIECHEN                   ,   "cmd_kriechen");

  AddExit("nordosten"     , ROOM "00-18+10");
  AddExit("suedwesten"    , ROOM "00-20+08");

  offen = 0;
}

void reset()
{
  ::reset();

  if(offen == 1)
  {
    offen=0;

    AddDetail( ({"gewalt"}),
      "Du koenntest versuchen die Ostwand aufzubrechen."
    );

    RemoveDetail("loch");
    tell_room(TO,"Ein Teil der Ostwand bricht zusammen und verschliesst "
                 "das Loch.\n");
  }
}

string detail_wand(string str)
{
  if(offen == 0)
    return BS("Die Ostwand sieht nicht besonders stabil aus. Mit ein wenig "
              "Gewalt laesst sie da vielleicht was machen.");

  return "In der Ostwand ist ein kleines Loch.\n";
}

int cmd_brechen(string str)
{
  notify_fail("Was willst Du aufbrechen?\n");

  if(!str || str == "") return 0;
  if(!(str == "wand auf"               ||
       str == "ostwand auf"            ||
       str == "wand mit gewalt auf"    ||
       str == "ostwand mit gewalt auf" )) return 0;

  if (offen==1)
  {
    TELLPLAYER("Aber die ist doch schon aufgebrochen worden.\n");
    return 1;
  }

  TELLPLAYER(BS("Mit all Deiner Kraft stemmst Du Dich gegen die Ostwand "
                "und Du schaffst es tatsaechlich die Ostwand aufzubrechen."));
  TELLOTHERS(TPN+" bricht ein Loch in die Ostwand.\n");

  AddDetail( ({"loch"}),
      "Es ist sogar gross genug, um durch das Loch zu kriechen."
  );

  RemoveDetail( ({"gewalt"}) );
  offen=1;

  return 1;
}

int cmd_kriechen(string str)
{
  notify_fail("Wo willst Du durchkriechen?\n");

  if(!str || str == "") return 0;
  if(!(str == "loch"         ||
       str == "durch loch"   )) return 0;

  if(offen==0)
  {
    TELLPLAYER("Durch welches Loch?\n");
    return 1;
  }

  TELLPLAYER("Du machst Dich ganz klein und kriechst durch das Loch.\n");

  TP->move("/d/unterwelt/zordan/riese/room/plateau-a2", M_GO, "durch ein Loch",
    "kriecht", "kommt hereingekrochen");

  return 1;
}

