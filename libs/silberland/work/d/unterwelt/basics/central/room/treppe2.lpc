#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einer langen Wendeltreppe" );
  SetProp(P_INT_LONG,
    "Du stehst auf einer Wendeltreppe, die sich weit nach unten in die Tiefe "
    "und nach oben an die Oberflaeche windet. Es ist ziemlich eng hier, und "
    "Du willst am liebsten gleich weitergehen, weil es hier ja ohnehin nichts "
    "zu sehen gibt."
  );

  SetProp( P_LIGHT, 0) ;
  SetProp( P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_CAVE]) );


  AddDetail( ({ "decke" }),
    "Du siehst keine Decke. Nach oben fuehrt eine lange Wendeltreppe."
  );

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus unzaehligen, nach unten fuehrenden Stufen."
  );

  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind roh und uneben. Kalter Fels, sonst nichts. "
  );

  AddDetail( ({ "treppe", "wendeltreppe" }),
    "Die Treppe windet sich scheinbar endlos in die Tiefe und in die Hoehe. "
    "Da man aber wegen der Windungen nicht weit sehen kann, koennte "
    "hinter jeder Biegung etwas lauern, das Dich angreifen will. Sei auf "
    "der Hut!"
  );

  AddDetail( ({ "stufen", "stufe" }),
    "Die Stufen sind ebenso bucklig und uneben wie die Waende. "
    "Auf einer davon liegt ein Haufen Knochen."
  );

  AddDetail( ({ "fels" }),
    "Kalter Fels, sonst nichts."
  );

  AddDetail( ({ "tiefe" }),
    "Dort unten scheint es viel waermer zu sein als hier. Geothermik oder "
    "Hoellenfeuer?"
  );

  AddDetail( ({ "knochen", "haufen" }),
    "Sie stammen sicher von einem verwegenen Abenteurer, der nicht aufgepasst "
    "hat und von einer boesen Kreatur ueberrascht worden ist! Vielleicht ist "
    "der arme Kerl aber auch einfach nur auf diesen bloeden Stufen gestolpert "
    "und hat sich das Genick gebrochen."
  );

  AddDetail( ({ "windung", "biegung", "windungen" }),
    "Du schaust vorsichtig hinter die naechste Windung der Wendeltreppe, aber "
    "kannst nichts erkennen. Der Weg scheint frei zu sein."
  );

  AddDetail( ({ "hoehe" }),
    "Weiter oben wird es spuerbar kaelter. Erkennen kannst Du von hier aber "
    "nichts."
  );

  AddExit("unten", ROOM "treppe3");
  AddExit("oben",  ROOM "treppe1");
}

