#include "../def.h"

inherit ROOM "inh_see.lpc";

//Added 23.12.2002 by Angel
int betrete ( string args )
{
  notify_fail ("Was moechtest Du betreten?\n");
  if ( args != "huette" )
     return 0;

  this_player()->move ( CENTRAL_PETSHOP, M_GO );
  return 1;
}

void create()
{
  ::create();

   //Added 23.12.2002 by Angel
  SetProp (P_INT_LONG, QueryProp(P_INT_LONG)+"In den Schatten der Hoehle "
           "geduckt, kannst Du die Umrisse einer Huette ausmachen." );

  AddCmd( ({ "betrete", "betritt" }), "betrete" );

  AddExit("sueden"       , ROOM "00-10+03");
  AddExit("nordwesten"   , ROOM "00-08+02");
  AddExit("nordosten"    , ROOM "00-08+04");

  //Added 23.12.2002 by Angel
  AddDetail ( ({ "umrisse", "umrisse" }), "Sieht ganz nach einer Huette "
                 "aus. Vielleicht kannst Du sie ja betreten?");
  AddDetail ( "huette", "Du erkennst nur ihre Umrisse in den Schatten." );
  AddDetail ( ({ "schatten", "spiel" }), "Das Spiel der Schatten ist herrlich zu beobachten." );

  //Added 23.12.2002 by Angel
  AddExit ("huette", ([ EX_DEST : CENTRAL_PETSHOP,
                        EX_MSG  : "in die Tierhandlung" ]) );
}
