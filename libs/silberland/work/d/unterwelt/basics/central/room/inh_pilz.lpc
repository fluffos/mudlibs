#include "../def.h"

inherit "std/room";

int pilze;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Gang in der Unterwelt" );
  SetProp(P_INT_LONG,
    "Der Hoehlengang, in dem Du Dich befindest, ist hier viel breiter und "
    "hoeher, als in den meisten anderen Abschnitten dieses dunklen Reiches. "
    "Die Waende und der Boden sind von tausenden Pilzen bewachsen, die "
    "ein unheimliches, fluoreszierendes Licht ausstrahlen. "
  );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 27, ENV_TERRAIN: TT_CAVE]) );

  SetProp(P_KILL_NAME, "Unvorsichtiger Umgang mit unbekannten Pilzen");

  AddDetail( ({ "boden" }),
    "Die mit Abstand groessten Pilze wachsen auf dem Boden, wobei einige "
    "sogar einen Meter und mehr erreichen."
  );

  AddDetail( ({ "wand", "waende" }),
    "Die Waende scheinen hier besonders feucht und warm zu sein, denn "
    "unendlich viele Pilze haben sich dafuer entschieden hier zu gedeihen. "
    "Die Waende des Ganges sind vollstaendig von ihnen bedeckt. Jedes "
    "winzigste Fleckchen, jeder noch so kleine Vorsprung im Fels, wird als "
    "Lebensraum genutzt. "
  );

  AddDetail( ({ "decke" }),
    "An der Decke sind keine Pilze, dort ist nur der Fels der Unterwelt zu "
    "sehen."
  );

  AddDetail( ({ "vorsprung", "vorspruenge", "fleckchen", "lebensraum" }),
    "Ueberall nichts als Pilze, Pilze und noch mehr Pilze."
  );

  AddDetail( ({ "pilze", "pilz" }),
    "Als Du die Pilze genauer betrachtest, stellst Du fest, dass es "
    "mindestens zehn oder zwoelf Arten davon gibt. Die meisten leuchten "
    "von innen her in schwacher Fluoreszenz, doch viele sind einfach "
    "nur tiefschwarz. Es scheint so, als ob diese sich vor dem Licht "
    "verstecken wuerden, unbemerkt in den Schatten ihrer Nachbarn verharrend "
    "und toedlich lauernd. Einen der vielen Pilze, egal welcher Sorte, zu "
    "pfluecken, oder gar zu essen waere auf jeden Fall leichtsinnig und "
    "moeglicherweise sehr gefaehrlich. Vielleicht haben die eine oder "
    "andere Art aber auch gewisse Heilkraefte... Wer weiss?"
  );

  AddDetail( ({ "licht", "fluoreszenz" }),
    "Die Pilze spenden nur schwaches Licht, aber es genuegt, um ohne "
    "Fackel sehen zu koennen."
  );

  AddDetail( ({ "gang", "hoehle", "hoehlengang" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "fels", "gestein" }),
    "Es ist alles von Pilzen bedeckt, nur an der Decke tritt das "
    "Gestein zutage."
  );

  AddDetail( ({ "schatten" }),
    "In den Schatten ihrer Nachbarn wachsen die dunkelsten Sorten."
  );

  AddCmd( ({ "pfluecke", "pflueck" }), "cmd_pfluecken");
  AddCmd( ({"iss","ess","esse"})     , "cmd_essen");

  pilze = random(3)+1;
}

void reset()
{
  ::reset();

  pilze=random(3)+1;
}

int cmd_pfluecken(string str)
{
  object ob;

  notify_fail("Was willst Du pfluecken?\n");

  if(!str || str == "") return 0;
  if(!(str == "pilz"   ||
       str == "pilze"  )) return 0;

  if(random(100) < 10)
  {
    TELLPLAYER(BS("Als Du einen der Pilze pfluecken willst, sticht "
                  "ploetzlich ein furchtbarer Schmerz in Deine Hand. Wellen "
                  "giftiger Pein brennen sich Deinen Arm hoch und breiten "
                  "sich langsam auf Deinen ganzen Koerper aus. Dir wird "
                  "speiuebel und alles dreht sich um Dich."));

    TELLOTHERS(BS(TP->Name(WER)+" will nach einem Pilz greifen, zieht die "
                  "Hand aber wie elektrisiert zurueck und schreit "
                  "schmerzerfuellt auf."));

    TP->do_damage(20+random(30));
    TP->AddPoison(random(10)+1);
    return 1;
  }

  if(pilze <= 0)
  {
    TELLPLAYER(BS("Im letzten Augenblick ueberlegst Du es Dir anders und "
                  "ziehst die Hand rechtzeitig zurueck. War das eine boese "
                  "Vorahnung, oder einfach Angst?"));
    return 1;
  }

  ob = clone_object(OBJ "pilz");
  if(ob->move(TP,M_GIVE) == 1)
  {
    TELLPLAYER("Du pflueckst einen der kleineren Pilze und steckst ihn ein.\n");
    TELLOTHERS(TP->Name(WER)+" pflueckt einen Pilz.\n");
    pilze--;
  }
  else
  {
    TELLPLAYER("Du Schwaechling kannst noch nicht einmal diesen Pilz heben!\n");
    ob->remove();
  }

  return 1;
}

int cmd_essen(string str)
{
  notify_fail("Was willst Du essen?\n");

  if(!str || str == "") return 0;
  if(!(str == "pilz"   ||
       str == "pilze"  )) return 0;


  TELLPLAYER("Du pflueckst wahllos einen kleinen Pilz und isst ihn auf.\n");
  TELLOTHERS(TP->Name(WER)+" pflueckt einen kleinen Pilz und isst ihn.\n");

  switch( random(100) )
  {
    case 0..5:
      tell_room(TO,"Eine Stimme droehnt: Dies war der falsche Pilz! Stirb, "
                   "Du Narr!\n"
      );
      TP->die();
      break;

    case 6..40:
      TELLPLAYER(BS("Der Pilz, den Du ausgewaehlt hast, war eine gute Wahl. "
                    "Der wuerzige Geschmack ist koestlich und betoerend. "
                    "Voller Freude merkst Du, wie reine Lebensenergie Dich "
                    "durchstroemt."));

      TP->heal_self(80+random(80));

      if(TP->QueryProp(P_POISON))
      {
        TELLPLAYER("Jegliches Gift in Deinem Koerper wird vernichtet.\n");
        TP->SetProp(P_POISON, 0);
      }
      break;

    case 41..60:
      TELLPLAYER("Aaaaaaarrghh! Dieser Schmerz! Der Pilz war eindeutig giftig!\n");
      TELLOTHERS(TP->Name()+" kruemmt sich vor Schmerzen am Boden.\n");
      TP->AddPoison(5);
      TP->SetProp(P_HP, TP->QueryProp(P_HP) / 10);
      break;

    case 61..80:
      TELLPLAYER("Der Pilz schmeckt nach ueberhaupt nichts.\n");
      break;

    default:
      TELLPLAYER("Der Pilz schmeckt bitter und wie Galle, aber sonst passiert "
                 "nichts.\n");
  }

  return 1;
}

