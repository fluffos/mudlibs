#include "../def.h"

inherit "std/room";

string target = "";
string dir    = "";

void create()
{
  ::create();

  UMASTER->Customize(TO);

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2] +
    "Weiterhin liegen ein paar Bretter herum.\n");

  SetProp(P_KILL_NAME, "Ein Sturz aus grosser Hoehe");
  SetProp(P_KILL_MSG,  "Fall langsamer, dann haste mehr davon!");

  AddSpecialDetail( ({ "bretter" }), "detail_bretter");

  AddDetail( ({ dir, "krater" }),
    "Es waere ein viel zu grosses Risiko einfach so ueber die Bretter "
    "zu gehen. Du solltest nach einer anderen Moeglichkeit suchen ueber "
    "den Krater zu kommen."
  );

  AddDetail( ({ "gewicht","fall" }),
    "Dein Gewicht ist auf jeden Fall zu gross fuer die Bretter, wenn Du "
    "einfach so ueber sie gehst. Wenn Du Dich irgendwie kleiner machst "
    "oder vorsichtiger bist, koenntest Du auf die andere Seite kommen."
  );

  AddDetail( ({ "risiko" }),
    "Das Risiko ist SEHR hoch. Genauer gesagt: Tu es NICHT!"
  );

  AddDetail( ({ "moeglichkeit","anlauf" }),
    "Mit einem grossen Anlauf koennte mal vielleicht ..."
  );

  AddDetail( ({ "seite","dunkel" }),
    "Die andere Seite liegt im Dunkeln."
  );

  AddCmd( ({ "spring","springe" }) , "cmd_springen");
  AddCmd( ({ "kriech","krieche" }) , "cmd_kriechen");

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Aufgeben gilt nicht!\n");
  return 0;
}

int exit_krater(string str)
{
  if (!interactive(TP))
  {
    TP->move(ROOM+target, M_GO);
    return 1;
  }

  if(TP->QueryProp(P_GHOST))
  {
    TELLPLAYER(BS("Da Du ein Geist bist schwebst Du einfach so ueber den "
                  "Krater." ));

    TP->move(ROOM+target, M_GO,"nach Westen weiter","schwebt",
      "schwebt herein"
    );

    return 1;
  }

  TELLPLAYER(BS("Unvorsichtig wie Du warst gehst Du einfach so nach Westen "
                "weiter. Viel zu spaet bemerkst Du erst jetzt die viel zu "
                "morschen Bretter. Und es passiert, was passieren musste: "
                "Eines der viel zu morschen Bretter bricht unter Dir "
                "zusammen ..." ));
  TELLPLAYER("Du faellst ...\n");
  TELLPLAYER("Und schlaegst sehr hart auf dem felsigen Boden auf.\n");

  TP->move(ROOM "01-01+11", M_GO, "durch die morschen Bretter", "faellt ",
    "faellt von oben herein und schlaegt hart auf");
  TP->do_damage(50+random(50));

  return 1;
}

int cmd_springen(string str)
{
  notify_fail("Worueber willst Du springen?\n");

  if(!str || str == "") return 0;
  if(!(str == "ueber krater"         ||
       str == "ueber krater rueber"  ||
       str == "rueber"               )) return 0;

  TELLPLAYER("Du nimmst einen kleinen Anlauf und springst ueber den Krater.\n");
  TP->move(ROOM+target, M_GO, "Anlauf und springt ueber den Krater",
    "nimmt","kommt ueber den Krater hereingesprungen");
  return 1;
}

int cmd_kriechen(string str)
{
  notify_fail("Worueber willst Du kriechen?\n");

  if(!str || str == "") return 0;
  if(!(str == "ueber bretter"         ||
       str == "ueber bretter rueber"  ||
       str == "ueber krater"          ||
       str == "ueber krater rueber"   )) return 0;

  TELLPLAYER("Vorsichtig kriechst Du auf den Brettern ueber den Krater.\n");
  TP->move( ROOM+target, M_GO, "vorsicht ueber den Krater", "kriecht ",
    "kommt kriechend herein");

  return 1;
}

string detail_bretter(string str)
{
  string s;

  s = "Die Bretter sehen nicht sehr stabil aus. Sie liegen ueber dem "
      "Krater im "+CAP(dir)+" und sind so dermassen morsch, dass sie Dein "
      "Gewicht wahrscheinlich nicht tragen koennen.";

  return BS(s);
}

