#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT,"Auf einer langen Rutsche");
  SetProp(P_INT_LONG,
    "Du befindest Dich auf einer lange Rutsche und rutscht in eine "
    "ungewisse Tiefe. "
  );

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_HIDE_EXITS, 1);

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );

  previous_object()->CustomizeObject();
}

int aufgabe(string str)
{
  notify_fail("Dazu ist es nun zu spaet.\n");
  return 0;
}

void init()
{
  ::init();

  if(query_once_interactive(TP)) call_out("blubber", 4, 1,TP);
}

void blubber(int step, object pl)
{
  string s;

  if(!pl)              return;
  if(!interactive(pl)) return;
  if(ENV(pl) != TO)    return;

  switch(step)
  {
    case 1:
      s = "Du rutscht immer schneller...";
      break;

    case 2:
      s = "... mal geht es links herum ...";
      break;

    case 3:
      s = "... mal rechts herum ...";
      break;

    case 4:
      s = "... Kopf Weg! Ein Felszacken ...";
      break;

    case 5:
      s = "... *Autsch* Das hat bestimmt weg getan...";
      break;

    case 6:
      s = "... sieht so aus als ob die Rutsche gleich zu Ende waere ... ";
      break;

    case 7:
      s = "... Na hoffentlich steht am Ende nicht ein Drache und will eine "
          "Fahrkarte von Dir...";
      break;

    case 8:
      s = "... Du schiesst mit einer atemberaubenden Geschwindigkeit aus der "
          "Roehre hinaus...";
      break;

    case 9:
      s = "... Aeste, Zweige und Blaetter daempfen Deinen Fall...";
      break;

    default:
      pl->move("/d/unterwelt/ronja/sternenwald/room/wr_08_04", M_GO|M_NO_SHOW,
               "", "", pl->Name()+" faellt von oben herunter.\n");

      tell_object(TP, BS("Du faellst in einen dunklen Wald auf weiches Moos. "
                         "Gewaltige Baeume ragen rings um Dich in den "
                         "Himmel und scheinen die Sterne zu beruehren. Hier, "
                         "unter den Baumkronen ist es fast voellig dunkel. "
                         "Nur hin und wieder dringt das Sternenlicht durch "
                         "das dichte Blaetterdach und versilbert den Wald. "
                         "Unverletzt stehst Du auf. "));

      return;
      break;
  }

  tell_object(pl,"\n"+s+"\n\n");
  call_out("blubber", 4, ++step, pl);
  return;
}

