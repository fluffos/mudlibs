#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "An einem unterirdischen See" );

  SetProp(P_INT_LONG,
    "Die Hoehle verbreitert sich hier sehr, um Platz zu machen fuer einen "
    "kleinen See. Rund um diesen See fuehrt ein schmaler Uferstreifen die "
    "Hoehlenwaende entlang, nur unterbrochen durch den Abfluss "
    "eines unterirdischen Flusses, der den See speist. Ein gespenstisch "
    "schoenes Licht, das von den Waenden auszugehen scheint, erfuellt den "
    "Raum und zaubert wundervolle Reflexionen in sanftem Blau auf den See, "
    "die Waende, die Decke und auf Dich. Im Sueden der Hoehle "
    "kann man noch ein Stueckchen den Fluss entlang weitergehen."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 23+random(3),
                          ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus glattem Fels, der ganz leicht zum See hin absinkt. "
    "Du musst aufpassen, dass Du nicht ausrutschst und ins Wasser faellst."
  );

  AddDetail( ({ "wand", "hoehlenwaende", "waende" }),
    "Die Waende strahlen ein sanftes, blaeuliches Leuchten aus. Das kommt "
    "von tausenden Kristallen, die in unregelmaessigen Abstaenden ueber "
    "die Waende verteilt sind."
  );

  AddDetail( ({ "decke" }),
    "Die Decke ist etwa vier bis fuenf Meter ueber Dir."
  );

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "zufluss", "nordwesten" }),
    "Der Zufluss des Sees liegt im Nordwesten der Hoehle. Dort steigen "
    "naemlich manchmal kleine Blasen auf, und man kann ein tiefschwarzes "
    "unterseeisches Loch erkennen - augenscheinlich der Zufluss, durch den "
    "der See gespeist wird."
  );

  AddDetail( ({ "abfluss", "sueden" }),
    "Richtung Sueden fliesst der Fluss, der den See speist, wieder ab."
  );

  AddDetail( ({ "fluss" }),
    "Ein kleiner Fluss speist diesen See. Er fliesst im Nordwesten unterseeisch "
    "zu, und im Sueden wieder ab, wobei er allerdings so schmal ist, dass man "
    "leicht ueber ihn hinwegsteigen kann."
  );

  AddDetail( ({ "see", "saphirsee" }),
    "Sein eisig klares Blau, das nicht nur durch die vielen Lichter in der "
    "Hoehle stammt, sondern auch von innen kommt, laesst Dich beinahe die "
    "gefahrvolle Umgebung vergessen und diese Hoehle ein paar Grad kuehler "
    "erscheinen, als sie tatsaechlich ist. Der See ist wunderschoen. "
    "Irgendwie formt sich in Deinen Gedanken ein Wort: 'Saphirsee'. Ja, das "
    "ist sein Name, Saphirsee."
  );

  AddDetail( ({ "ufer", "uferstreifen" }),
    "Entlang des Ufers ist ein schmaler Felsstreifen, an dem man bequem den "
    "See umrunden kann. Nur ganz im Sueden muss man ueber den kleinen Fluss "
    "steigen, aber das ist kein Problem."
  );

  AddDetail( ({ "oberflaeche", "wasseroberflaeche", "wasser" }),
    "Die Wasseroberflaeche bewegt sich nur ganz leicht, aufgrund der "
    "Blaeschen, die manchmal aufsteigen. Diese leise Bewegung genuegt, um "
    "tausende von Reflexionen in der Hoehle umhertanzen zu lassen."
  );

  AddDetail( ({ "fels" }),
    "Der Fels ist hier von einer Unzahl von blauen Kristallen durchzogen. Vor "
    "allem an den Waenden, aber auch am Boden unter Dir, der leicht zum Ufer "
    "abfaellt, sodass Du aufpassen musst, nicht abzurutschen."
  );

  AddDetail( ({ "blau", "licht", "reflexionen", "leuchten" }),
    "Das Licht entspringt auf magische Weise aus den vielen Kristallen in "
    "den Hoehlenwaenden. Das sanfte Blau wirkt irgendwie beruhigend und "
    "wohltuend auf Dich. Durch die sich sanft bewegende Wasseroberflaeche wird "
    "es wieder in die Hoehle zurueckgeworfen."
  );

  AddDetail( ({ "kristall", "kristalle" }),
    "Kristalle treten an vielen Stellen durch den Fels und tauchen alles um "
    "Dich herum in blaues Licht. Allein die Kraft tausender Tonnen Gestein "
    "ueber Dir hat diese Kristalle erzeugt und aus dem Fels gepresst. Sie "
    "stellen sicherlich einen grossen Wert dar, wenn man sie abbauen koennte. "
    "Die Tatsache, dass das noch niemand getan hat, verwundert Dich jedoch. "
    "Vielleicht lauert hier ja auch irgendeine Gefahr, oder eine Macht, die "
    "diese Hoehle beschuetzt."
  );

  AddDetail( ({ "macht", "gefahr" }),
    "So sehr Du Dich auch anstrengst, Du findest nichts."
  );

  AddDetail( ({ "loch" }),
    "Unter der Wasseroberflaeche im Nordwesten des Sees muendet der Fluss "
    "in den Saphirsee."
  );

  AddDetail( ({ "blasen", "blaeschen" }),
    "Da, wo der Fluss zufliesst, steigen manchmal kleine Blaeschen auf."
  );

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Aufgeben gilt nicht!\n");
  return 0;
}

