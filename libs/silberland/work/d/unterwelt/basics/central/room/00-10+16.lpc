#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  UMASTER->Customize(TO);

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2] +
    "In der Decke gaehnt ein riesiges Loch."
  );

  AddDetail(({"loch", "decke"}),
     "In der Decke ist ein grosses Loch, an dem Du das Ende einer langen "
     "Leiter erkennen kannst, die daraus hervorragt."
  );

  AddDetail(({"leiter", "sprossen"}),
     "Eine Leiter fuehrt in das Loch nach oben. Die untersten Sprossen "
     "haengen so tief, dass Du sie bequem erreichen kannst."
  );

  AddCmd( CMD_KLETTERN + ({"steig","steige"}), "cmd_klettern");

  AddExit("westen"  , ROOM "00-10+15");
}

int cmd_klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");

  if(!str || str == "") return 0;
  if(!(str == "hoch"                ||
       str == "rauf"                ||
       str == "nach oben"           ||
       str == "hinauf"              ||
       str == "leiter hoch"         ||
       str == "leiter rauf"         ||
       str == "leiter nach oben"    ||
       str == "leiter hinauf"       )) return 0;

  if(TP->QueryProp(P_MV) < 100)
  {
    TELLPLAYER("Du bist viel zu muede fuer eine Kletterpartie. Ruh Dich "
               "vorher aus.\n");
    return 1;
  }

  tell_room(TO,TPN+" klettert die Leiter hinauf.\n", ({TP}) );
  TP->move(ROOM "abfluss", M_GO|M_SILENT);

  call_other(ROOM "abfluss.lpc","goup", TP);

  return 1;
}

