#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  UMASTER->Customize(TO);

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2] +
                      "In der Nordwand befinden sich drei Portale.");

  AddDetail( ({ "portale", "portal", "tor", "tore" }),
    "Drei Portale befinden sich hier in den Waenden. Ueber jedem Portal "
    "erkennst Du eine Inschrift."
  );

  AddDetail( ({ "inschriften", "inschrift" }),
    "Die Inschriften sind tief ins Gestein gegraben, sodass man sie noch "
    "gut lesen kann."
  );

  AddReadDetail( ({ "inschrift", "inschriften" }),
    "Welche Inschrift willst Du lesen? \n"
    "  (lies inschrift <nr>)\n"
  );

  AddReadDetail( "inschrift 1" ,
    "  'Tor der Vernichtung'\n"
  );

  AddReadDetail( "inschrift 2" ,
    "  'Tor der Verdammnis'\n"
  );

  AddReadDetail( "inschrift 3" ,
    "  'Tor der Verzweiflung'\n"
  );

  AddDetail( ({ "verzweiflung", "tor 3", "portal 3" }),
    "Hinter diesem Tor gibt es keine Hoffnung mehr.\n"
  );

  AddDetail( ({ "vernichtung", "tor 1", "portal 1" }),
    "Dieses Tor zu durchschreiten, koennte Deine Vernichtung bedeuten.\n"
  );

  AddDetail( ({ "verdammnis", "tor 2", "portal 2" }),
    "Vielleicht ist dies der Weg zur ewigen Verdammnis.\n"
  );

  AddDetail( ({ "nordwand" }),
    "Drei dunkle, boese Portale befinden sich dort. Sie sind magischen "
    "Ursprungs."
  );

  AddCmd( ({"betrete","betret"}), "cmd_betreten");

  AddExit("sueden", ROOM "00+00-09");
}

int no_go()
{
  write ("Deine Angst verhindert das Durchschreiten dieses Portales.\n"
    "(Ausserdem ist das, was dahinter liegt, noch nicht angeschlossen.)\n");
  return 1;
}

int cmd_betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");

  if(!str || str == "") return 0;

  if(TP->QueryProp(P_GHOST))
  {
    notify_fail("In Deinem immateriellen Zustand geht das nicht.\n");
    return 0;
  }

  if(str == "tor 1" || str == "tor vernichtung" || str == "vernichtung" )
  {
    TELLPLAYER(BS("Mit einem mulmigen Gefuehl durchschreitest Du das Portal "
                  "zur Vernichtung."));

    TP->move("/d/unterwelt/vernichtung/eingang", M_TPORT,
             "durch das Tor der Vernichtung", "geht",
             "materialisiert sich aus dem Nichts");
    return 1;
  }

  if(str == "tor 2" || str == "tor verdammnis" || str == "verdammnis" )
  {
    TELLPLAYER(BS("Du nimmst allen Mut zusammen und betrittst das Tor der "
                  "Verdammnis."));

    TP->move("/d/unterwelt/stahldorn/dammnis/room/dam_c4", M_TPORT,
             "durch das Tor der Verdammnis", "geht",
             "materialisiert sich aus dem Nichts");
    return 1;
  }

  if(str == "tor 3" || str == "tor verzweiflung" || str == "verzweiflung" )
  {
    return no_go();
  }

  return 0;
}


