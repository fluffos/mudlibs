#include "../def.h"

inherit "/std/room";

#define MAX_AMOUNT 100

string *pl_on_symbol;
int    amount;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Gruft");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einer duesteren Gruft. Ein stiller, ruhiger Ort. "
    "Ein Hauch von Verwesung liegt in der Luft. Spinnweben haengen von den "
    "Waenden und in den Nischen flackert sanft der Schein unzaehliger Kerzen."
  );

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 5, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({"boden"}) ,
    "Der Boden besteht aus Stein. In der Mitte des Raumes ist mit Blut"
    "steinen ein Pentagramm eingezeichnet. "
  );

  AddDetail( ({"pentagramm"}) ,
    "Das Pentagramm ist das Symbol der Hexen. "
  );

  AddDetail( ({"loch"}) ,
    "Als Du Dich dem Loch naeherst, kannst Du eine Treppe erkennen, die Dich "
    "in die Gewoelbe der Gruft fuehren. Dein Herz klopft, als Du Dir "
    "vorstellst, die Treppe hinunter zu steigen."
  );

  AddDetail( ({"gewoelbe"}) ,
    "Geh doch hinunter, wenn Du Dich traust. Aber flenne nachher nicht "
    "herum, wenn Du den Schrecken der Unterwelt begegnest. "
  );

  AddDetail( ({"blutsteine","steine","blutsteinen"}) ,
    "Blutsteine sind dunkelrot, man koennte fast sagen, sie leuchten ein "
    "klein wenig."
  );

  AddDetail( ({"hexen"}) ,
    "Die Hexen benutzen diesen Ort, um ihre Toten zu begraben."
  );

  AddDetail( ({"gruft", "raum", "ort"}), QueryProp(P_INT_LONG));

  AddDetail( ({"luft"}) ,
    "Die Luft ist ein wenig stickig hier. Der Geruch von Verwesung "
    "steigt von unten empor. "
  );

  AddDetail( ({"hauch", "verwesung","duft"}),
    "Du kannst ihn schon fast riechen, den Duft der Verwesung."
  );

  AddDetail( ({"netz", "spinnweben", "netze"}),
    "Spinnweben wurden von unzaehligen Spinnen kunstvoll gewebt."
  );

  AddDetail( ({"schein", "schein"}),
    "In den Nischen flackert der Schein unzaehliger Kerzen."
  );

  AddDetail( ({"decke", "stein"}),
    "Du schaust an die Decke und hoffst, dass sie nicht einstuerzt, so stark "
    "zerbroeckelt ist der Stein schon."
  );

  AddDetail( ({"spinne", "spinnen", "opfer"}),
    "Spinnen sitzen in ihren Netzen und warten geduldig auf Opfer."
  );

  AddDetail( ({"nische", "nischen", "formen"}),
    "Ueberall stehen Kerzen, deren Schatten bizarre Formen an die Waende "
    "malen. In einer der Nischen befindet sich ein Loch im Boden. "
  );

  AddDetail ( ({"kerze", "kerzen"}),
    "Wer die wohl alle aufgestellt hat? Und wozu?"
  );

  AddDetail( ({"schatten"}),
    "Die Kerzen malen bizarre Schatten an die Waende."
  );

  AddDetail( ({"wand", "waende"}),
    "Obskure Zeichen und Runen wurden an die Waende gemalt."
  );

  AddDetail ( ({"zeichen"}),
    "Es handelt sich hier um Pentagramme und andere okkulte Zeichen."
  );

  AddDetail( ({"okkulte zeichen"}),
    "Sie berichten von geheimnisvollen Dingen."
  );

  AddDetail( ({"formel", "formeln"}),
    "Du kannst nix genaues erkennen, weil sie schon sehr vergilbt sind."
  );

  AddDetail( ({"geruch"}) ,
    "Den kann man riechen."
  );

  AddDetail( ({"mitte"}) ,
    "In der Mitte des Raumes wurde auf dem Boden ein Pentagramm in blutroter "
    "Farbe aufgemalt."
  );

  AddDetail( ({"runen"}) ,
    "Seltsame Runen sind das. Solche hast Du noch nie vorher gesehen. "
  );

  AddDetail( ({"schrecken"}) ,
    "Du wirst Ihnen noch frueh genug begegnen. "
  );

  AddSpecialDetail( ({"symbol"}) , "detail_symbol" );

  AddDetail( ({"farbe"}) ,
    "BLUTROT!"
  );

  AddDetail( ({"blutrot"}) ,
    "So weiss wie Schnee, so rot wie Blut... Ach nein, das war etwas anderes."
  );

  AddDetail( ({"tot","tote","toten"}) ,
    "Hier finden wohl die Totenrituale der Hexen statt. Ausser Hexen hat das "
    "aber noch niemand gesehen. "
  );

  AddDetail( ({"rituale","totenrituale"}) ,
    "Ausser Hexen hat noch niemand die Totenrituale der Hexen beobachtet. "
  );

  AddDetail( ({"treppe"}) ,
    "Die Treppe fuehrt nach unten in die Finsternis. "
  );

  AddDetail( ({"finsternis"}) ,
    ([0          : "Was Dich da unten wohl erwartet?"
     ,"dunkelelf": "Finsternis! Da wirst Du Dich wohl fuehlen."
     ])
  );

  AddDetail( ({"unterwelt"}) ,
    "Traust Du Dich wirklich in die Unterwelt?"
  );

  AddSmell(DEFAULT_SMELL,
    "Es riecht ein klein wenig nach Verwesung."
  );

  AddSmell (({"verwesung"}),
    "Der Geruch nach Verwesung ist schwach, aber nicht zu ueberriechen."
  );

  AddSound( DEFAULT_SOUND,
    "Es ist absolut ruhig hier."
  );

  AddExit("raus", "/d/unterwelt/clementine/polaris/room/gruft");

  AddCmd("toete&spinne|spinnen",
    "cmd_toeten",
    "Was moechtest Du zu Lars schicken?"
  );

  AddCmd("stell|stelle|betret|betrete&symbol|mitte|pentagramm",
    "cmd_stellen",
    "Wen oder was moechtest Du betreten?"
  );

  AddCmd("verlass|verlasse&symbol|mitte|pentagramm",
    "cmd_verlassen",
    "Wen oder was moechtest Du verlassen?"
  );

  AddCmd("steig|steige&treppe&unten|hinab|runter|herunter",
    "cmd_steigen",
    "Wohin moechtest Du steigen?"
  );

  AddCmd("steig|steige&unten|hinab|runter|herunter",
    "cmd_steigen",
    "Wohin moechtest Du steigen?"
  );

  pl_on_symbol   = ({ });
  amount         = 0;
}

void reset()
{
  ::reset();

  amount += 10;
  if(amount > MAX_AMOUNT) amount = MAX_AMOUNT;
}

void init()
{
  ::init();

  if(!TP)              return;
  if(!interactive(TP)) return;

  pl_on_symbol -= ({ getuuid(TP) });
}

int QueryAmount()
{
  return amount;
}

int cmd_toeten(string str)
{
  tell_object(TP, BS("Die Spinnen sind viel zu flink als das Du eine von "
                     "ihnen erwischen koenntest."));

  return 1;
}

string detail_symbol(string str)
{
  string s;

  if(member(pl_on_symbol, getuuid(TP)) == -1)
  {
    s = "Das Symbol befindet sich unuebersehbar auf dem Boden. Was wohl "
        "passiert wenn man sich in die Mitte stellt? ";
  }
  else
  {
    s = "Du stehst genau in der Mitte in des Symbols. Unheimlich. ";
  }
  return BS(s);
}

int cmd_stellen(string str)
{
  string s, who;
  int m;

  who = CAP(getuid(TP));

  if(member(pl_on_symbol, getuuid(TP) ) != -1)
  {
    tell_object(TP, "Aber da stehst Du doch schon.\n");
    return 1;
  }

  pl_on_symbol += ({ getuuid(TP) });

  tell_room(TO, BS(TP->Name(WER)+" stellt sich in die Mitte des Pentagramms."),
                ({ TP }) );

  if(TP->QueryProp(P_GENDER) == FEMALE)
  {
    if(TP->QueryProp(P_HP) == TP->QueryProp(P_MAX_HP))
    {
      s = "Du stellst Dich in die Mitte des Symbols, aber nichts passiert. ";
      UMASTER->Msg(who+" stellt sich voellig gesund auf das Pentagramm");
    }
    else if(amount == 0)
    {
      s = "Du stellst Dich in die Mitte des Symbols, aber ausser einem "
          "einem leichten Kribbeln merkst Du nich viel.";
      UMASTER->Msg(who+" stellt sich auf das entladene Pentagramm");
    }
    else
    {
      s = "Du stellst Dich in die Mitte des Symbols und eine wohlige "
          "Waerme durchfaehrt Dich. ";
      m = amount;
      if((TP->QueryProp(P_HP) + m) > TP->QueryProp(P_MAX_HP))
      {
        m = TP->QueryProp(P_MAX_HP) - TP->QueryProp(P_HP);
      }
      TP->AddHp(m);
      amount -= m;
      if(amount < 0) amount = 0;
      UMASTER->Msg(sprintf("%s heilt sich am Pentagramm mit %d, "
                           "Rest %d", who, amount, m));
    }
  }
  else
  {
    if(amount >= MAX_AMOUNT)
    {
      s = "Du stellst Dich in die Mitte des Symbols, aber ausser einem "
          "leichten Kribbeln merkst Du nich viel.";
      amount = MAX_AMOUNT;
      UMASTER->Msg(who+"stellt sich auf das voll aufgeladene Pentagramm");
    }
    else
    {
      m = TP->QueryProp(P_HP) - 1;
      if((amount + m) > MAX_AMOUNT) m = MAX_AMOUNT - amount;
      amount += m;
      TP->AddHp(-m);

      s = "Du stellst Dich in die Mitte des Pentagramms und ein stechender "
          "Schmerz zuckt durch Deine Eingeweide";

      UMASTER->Msg(sprintf("%s stellt sich auf das Pentagramm und laed es "
                           "mit %d zu %d auf", who, m, amount));
    }
  }

  tell_object(TP, BS(s));

  return 1;
}

int cmd_steigen(string str)
{
  TP->move(ROOM "keller",M_GO, "hinunter", "steigt die Treppe",
                               "kommt die Treppe hinunter");

  return 1;
}

int cmd_verlassen(string str)
{
  if(member(pl_on_symbol, getuuid(TP)) == -1)
  {
    TP->Message("Du hast das Symbol doch gar nicht betreten"
               , MSGFLAG_VISUAL);
  }
  else
  {
    TP->Message("Du trittst wieder von dem Symbol herunter."
               , MSGFLAG_VISUAL);

    pl_on_symbol = ({ getuuid(TP) });
  }

  return 1;
}


