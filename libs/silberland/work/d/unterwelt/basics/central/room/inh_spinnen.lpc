#include "../def.h"

inherit ROOM "inh_spinnennetz";

string richtung;

void create()
{
  ::create();

  richtung = "Nirgendwo";

  SetProp(P_INT_SHORT, "In einem grossen Spinnennetz" );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: random(5), ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Durch die Faeden kannst Du den Boden nicht erkennen. Er liegt einfach "
    "zu weit unten. Du bist froh auf der Spinnwebe sicher stehen zu koennen. "
    "Aber vielleicht ist es auch nur eine Frage der Zeit, bis Du durchbrichst "
    "und ins Bodenlose faellst. Es scheint aber ein Licht von dort und erhellt "
    "diese kleine Hoehle."
  );

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "licht","sonnenlicht" }),
    "Es ist irgendwie kein Sonnenlicht. Aber Du kannst genug sehen."
  );

  AddDetail( ({ "bodenlose" }),
    "Es waere toetlich."
  );

  AddDetail( ({ "frage","zeit" }),
    "Sowas siehst Du hier wirklich nicht."
  );

  AddDetail( ({ "decke" }),
    "An der Decke kannst Du noch so eben ein paar kleiner Spinnweben erkennen. "
    "Ansonsten ist es dort einfach zu dunkel."
  );

  AddDetail( ({ "spinnweben","weben" }),
    "Die Spinnweben sind nicht mit dieser riesigen Spinnwebe vergleichbar. "
    "Die kleinen an der Decke kennst Du aus jedem Haus. Aber diese hier "
    "ist einfach nur gigantisch. Sie muss von einer sehr grossen Spinne "
    "gewebt worden sein."
  );

  AddDetail( ({ "haus" }),
    "Haeh???"
  );

  AddDetail( ({ "waende","wand" }),
    "An den ansonsten dunklen Waenden sind die Faeden der Spinnwebe "
    "festgeklebt worden. Die Waende sind eigentlich rauh, doch der "
    "Klebstoff haelt die Faeden fest."
  );

  AddDetail( ({ "klebstoff" }),
    "Das ist wohl von einer Spinne gemacht worden. Es klebt wie der Teufel."
  );

  AddDetail( ({ "spinne" }),
    "Derzeit ist hier keine. Aber hier muessen irgendwo welche sein."
  );

  AddDetail( ({ "teufel","glueck" }),
    "Den Teufel kannst Du zum Glueck hier nicht sehen."
  );

  AddDetail( ({ richtung }),
    "Im "+richtung+" ist eine Wand mit ein paar dicken Faeden dran."
  );

  AddDetail( ({ "spinnwebe","webe" }),
    "Die Spinnwebe ist aus dicken Faeden gespinnt worden. Ekliger Schleim "
    "haengt an einigen Stellen herum. Ausserdem ist sie leicht in Richtung "
    "Mitte geneigt."
  );

  AddDetail( ({ "richtung" }),
    "Mit dieser Richtung war die Mitte gemeint."
  );

  AddDetail( ({ "schleim","stellen" }),
    "Gruener Schleim haengt an den Faeden. Er scheint sogar giftig zu sein."
  );

  AddDetail( ({ "mitte" }),
    "Die Mitte ist Dir nicht ganz geheuer. Wer weiss was Dich dort erwartet?"
  );

  AddDetail( ({ "spinnfaeden","spinnfaden","faeden","faden" }),
    "Die Faeden sind fast so dick wie Dein Arm. Sie halten die Spinnwebe "
    "fest zusammen."
  );

  AddDetail( ({ "arm" }),
    "Uff, Dein Arm ist noch dran."
  );

  AddSound( DEFAULT_SOUND,
    "Aus der Mitte der Spinnwebe kommt ein krabbelndes Geraeusch."
  );

  AddSound( ({ "mitte","geraeusch"}) ,
    "Das Geraeusch ist ziemlich laut und kann nur von grossen Lebewesen "
    "verursacht werden."
  );

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach verwesenden Leichen."
  );

  AddSmell( "leichen",
    "Du kannst es nicht so richtig einordnen, aber es stinkt."
  );

  AddItem(NPC "spinne2", REFRESH_DESTRUCT, ([P_MNPC_DEFAULTROOM: file_name(TO)]) );
}

string _query_int_long()
{
  string s;

  s = "Du stehst oder besser klebst im "+richtung+" einer grossen "
      "Spinnwebe. Die Spinnfaeden sind hier fest an die Waende geklebt "
      "worden. Die Decke kannst Du leider nicht so richtig erkennen. Den "
      "Boden aber erst recht nicht.";

  return BS(s);
}

