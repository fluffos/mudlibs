#include "../def.h"

inherit "std/room";

string wand;
int spinnwebe;

void create()
{
  ::create();

  UMASTER->Customize(TO);

  wand=QueryProp(P_DETAILS)["wand"][0..<2];
  RemoveDetail("wand");

  AddDetail( ({"wand"}) ,
    wand+" An der Suedwand scheint etwas zu haengen."
  );

  AddDetail( ({ "windhauch","hauch" }),
    "Tatsaechlich, es weht ein kleiner Wind durch die Spinnwebe hindurch."
  );

  AddDetail( ({ "wind" }),
    "Vielleicht kann man die Spinnwebe irgendwie entfernen und dem genauer "
    "nachgehen."
  );

  AddSpecialDetail( ({ "suedwand" })         , "detail_wand" );
  AddSpecialDetail( ({ "spinnwebe","webe" }) , "detail_spinnwebe" );

  AddCmd( ({ "entferne","entfern" }), "cmd_entfernen" );

  SetProp(P_HIDE_EXITS, ({ "sueden" }) );

  AddExit("osten"  , ROOM "00-07+00");
  AddExit("westen" , ROOM "00-07-02");

  spinnwebe = 1;
}

void reset()
{
  ::reset();

  if(spinnwebe == 0 )
  {
    tell_room(TO,"Eine kleine Spinne webt eine Spinnwebe und verschwindet "
                 "wieder.\n");
  }
  spinnwebe = 1;
  RemoveExit("suedunten");
  RemoveExit("sueden");
  RemoveDetail("ausgang");
}

int cmd_entfernen(string str )
{
  notify_fail( "Was moechtest Du entfernen?\n" );

  if(!str || str == "") return 0;
  if(!(str == "spinnwebe"    ||
       str == "webe"         )) return 0;

  TELLPLAYER(BS("Du entfernst mit Deiner Hand die Spinnwebe. Ein Ausgang "
                "wird sichtbar."));
  TELLOTHERS(TPN+" entfernt eine Spinnwebe.\n");

  spinnwebe = 0;

  AddExit("suedunten" , ROOM "01-08-01");
  AddExit("sueden"    , ROOM "01-08-01");

  SetProp(P_HIDE_EXITS, ({"sueden"}) );

  AddDetail( ({"ausgang"}) ,
    "Er fuehrt nach Suedunten."
  );

  return 1;
}

string detail_spinnwebe(string str)
{
  string s;

  if(spinnwebe==1)
  {
    s = "Das Spinnennetz ist nicht besonders gross und es sitzt auch keine "
        "Spinne darin. Es scheint aber so, als ob ein kleine Windhauch "
        "durch die Spinnwebe weht.";
  }
  else
  {
    s = "Du siehst hier keine Spinnwebe.";
  }

  return BS(s);
}

string detail_wand(string str)
{
  string s;

  if(spinnwebe == 1)
  {
    s = "Eine kleine Spinnwebe haengt dort fast auf dem Boden.";
  }
  else
  {
    s = "Du hast Dich wohl getaeuscht. Da ist gar nichts." ;
  }

  return BS(s);
}
