#include "../def.h"

inherit "std/room";

#define LW(x) (sizeof(x)==1 ? x[0] : implode(x[0..<2],", ")+" und "+x[<1])

int ready;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "An einem Lavasee" );
  SetProp(P_INT_LONG,
    "Du stehst vor einem Abgrund. Oestlich von Dir erstreckt sich eine "
    "wahrhaft gewaltige Hoehle, die sich so weit erstreckt, dass Du das andere "
    "Ende nicht erkennen kannst. Unter Dir ist ein riesiger See aus "
    "reiner, kochender Lava, die den Boden der Hoehle vollstaendig bedeckt. "
    "Die Hitze, die von der Lava ausgeht, nimmt Dir den Atem. Direkt an "
    "der Kante zur Lava steht ein Podest, auf welchem sich eine schwarze "
    "Kugel befindet. "
  );

  SetProp(P_LIGHT, 2);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 65, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Du stehst auf Felsgestein, doch direkt vor Dir ist kein Boden mehr."
  );

  AddDetail( ({ "fels", "gestein", "felsgestein" }),
    "Der Fels glueht fast, weil es hier so heiss ist."
  );

  AddDetail( ({"waende","wand"}),
    "Die Waende der Hoehle erstrecken sich in weite Ferne. Weiter als Du "
    "erkennen kannst. "
  );

  AddDetail( ({ "decke", "hoehlendecke" }),
    "Die Hoehlendecke befindet sich fast zwanzig Meter ueber Dir und etwa "
    "noch einmal so weit ueber der Lava."
  );

  AddDetail( ({"hoehle","ort"}), QueryProp(P_INT_LONG));

  AddDetail( ({"abgrund","punkt"}),
    "Der Punkt, an dem Du stehst, liegt sicher zwanzig Meter ueber der Lava "
    "des Sees, aber die Hitze ist immer noch gewaltig. Am besten Du gehst "
    "wieder schnell an einen kuehleren Ort."
  );

  AddDetail( ({ "hitze" }),
    "Es ist unertraeglich heiss. Ob da vielleicht die Lava damit zu tun hat?"
   );

  AddDetail( ({ "see", "lavasee", "lava" }),
    "Der Lavasee erstreckt sich weit nach Osten. Immer wieder spritzen "
    "gluehende Fontaenen empor, um wieder spritzend und zischend in den See "
    "zurueckzufallen. "
  );

  AddDetail( ({ "ende", "osten" }),
    "Das andere Ende des Sees ist nicht zu erkennen, weil es so weit weg ist."
  );

  AddDetail( ({ "fontaene", "fontaenen" }),
    "Gerade eben spritzt eine davon mehrere Meter in die Luft. "
    "Gut, dass das ganze sich nicht direkt unter Dir abgespielt "
    "hat, sonst haetten Dich womoeglich noch ein paar der Spritzer "
    "erwischt."
  );

  AddDetail( ({"atem"}) ,
    "Zum Glueck atmest Du noch. Waere schlimm, wenn dem nicht so waere."
  );

  AddDetail( ({"ferne"}) ,
    "Die Lava erstreckt sich bis in weite Ferne."
  );

  AddDetail( ({"gang","gaenge"}) ,
    "Die Gaenge der Unterwelt befinden sich jenseits vom Gitter."
  );

  AddDetail( ({"kante"}) ,
    "Geh lieber nicht zu nah an die Kante, sonst faellst Du noch in die "
    "gluehende Lava. "
  );

  AddDetail( ({"kugel"}) ,
    "Ganz schwarz aus einem Dir unbekannten Material ruht sie auf dem "
    "Podest. Irgendwie hat sie eine magische Aura, das kannst Du sehr "
    "deutlich fuehlen. "
  );

  AddDetail( ({"luft"}) ,
    "Due Luft ist arg heiss und brennt in Deinen Lungen."
  );

  AddDetail( ({"meter"}) ,
    "Trete einen Meter naeher an die Lava und du faellst hinein. "
  );

  AddDetail( ({"podest"}) ,
    "Nichts weiter als eine quadratrische Saeule, auf welcher eine Kugel "
    "ruht. "
  );

  AddDetail( ({"spritzer"}) ,
    "Na hoffentlich trifft Dich keiner der Spritzer, das koennte eine boese "
    "Brandwunde geben. "
  );

  AddDetail( ({"staebe"}) ,
    "Die Staebe des Gitters sehen sehr stabil aus."
  );

  AddDetail( ({"unterwelt"}) ,
    "Da befindest Du Dich gerade. Sieh dich ruhig um und stirb, Du Wurm!"
  );

  AddDetail( ({"weg"}) ,
    "Der einzige Weg hieraus ist das Gitter."
  );

  AddDetail( ({"aura"}) ,
    "Irgendwie hast Du das Gefuehl, dass man in die Kugel hineinstarren "
    "kann und dort weit entfernte Sachen sehen kann. "
  );

  AddDetail( ({"brandwunde","wunde"}) ,
    "Die kann man sich bei all der gluehenden Lava schnell zuziehen."
  );

  AddDetail( ({"glueck"}) ,
    "Hoffentlich verlaesst Dich Dein Glueck nicht und Du faellst nicht "
    "in die Lava. "
  );

  AddDetail( ({"lunge","lungen"}) ,
    "Die heisse Luft brennt in Deinen Lungen. "
  );

  AddDetail( ({"material"}) ,
    "Es ist Dir unbekannt. "
  );

  AddDetail( ({"saeule"}) ,
    "Auf der Saeule befindet sich eine Kugel. "
  );

  AddDetail( ({"wurm"}) ,
    "Ausser Dir gibt es hier keinen."
  );

  AddSpecialDetail( ({"sache","sachen"}) , "detail_sachen" );

  AddDetail( ({"gefuehl"}) ,
    "Hoffentlich kannst Du Dich darauf verlassen. "
  );

  AddSound( DEFAULT_SOUND,
    "Es blubbert und zischt ueberall."
  );

  NewDoor("suedwesten", ROOM "00-02+13", ({"tor","gitter"}),
    ({D_NAME,"Gitter"
     ,D_GENDER, NEUTER
     ,D_FLAGS, (DOOR_NEEDKEY|DOOR_RESET_CL|DOOR_CLOSED)
     ,D_MSGS, ({"nach Suedwesten"
               ,"durchschreitet das Gitter"
               ,"kommt durch das Gitter herein"
               })
     ,D_SHORT,"Das Gitter ist %s. "
     ,D_LONG, "Ein grosses, eisernes Gitter versperrt Dir den Weg nach "
              "Suedwesten. Durch die Staebe kannst Du die dunklen Gaenge "
              "der Unterwelt nur noch erahnen. "
     ,D_OPENMSG, ({"Du oeffnest das schwarze Gitter."
                  ,"%s oeffnet das schwarze Gitter."
                  ," wird von der anderen Seite quietschend geoeffnet."
                  })
     ,D_CLOSEMSG,({"Du schliesst das Gitter, welches krachend ins Schloss faellt."
                  ,"%s schliesst das Gitter, welches krachend ins Schloss faellt."
                  ," wird von der anderen Seite geschlossen und faellt "
                   "krachend ins Schloss."
                  })
     ,D_RESET_CLOSEMSG, " faellt krachend ins Schloss."
     })
  );

  AddCmd( ({"starr","starre"}) , "cmd_starren");

  ready = 1;
}

void reset()
{
  ::reset();

  ready = 1;

  Message(BS("Die Kugel auf dem Podest leuchtet kurz auf."),MSGFLAG_VISUAL);
}

int cmd_starren(string str)
{
  object npc,room;
  string s, hint;
  int i;

  notify_fail("In was moechtest Du starren?\n");

  if(!str || str == "") return 0;
  if(!(str == "in kugel"                 ||
       str == "in schwarze kugel"        ||
       str == "in kugel hinein"          ||
       str == "in schwarze kugel hinein" )) return 0;

  if(TP->CannotSee(1))
  {
    s = "Du starrst wie ein"+(TP->QueryProp(P_GENDER)==FEMALE?"e":"")+
        " Verrueckt"+(TP->QueryProp(P_GENDER)==FEMALE?"e":"er")+" in die "
        "Kugel und siehst nur schwaerze. Was hast Du erwartet? Schliesslich "
        "bist Du im Augenblick "+
        (TP->QueryProp(P_RACE)=="Dunkelelf"?"geblendet":"blind")+".";
    tell_object(TP,BS(s));
    return -1;
  }

  if(!IS_SEER(TP))
  {
    s = "Du bist bei weitem  nicht maechtig genug, um die Macht dieser Kugel "
        "zu beherrschen. Der Kampf mit den Maechten der Finsternis "
        "war zu hart...";
    tell_object(TP,BS(s));
    TP->SetProp(P_HP,TP->QueryProp(P_HP)/2);
    TP->SetProp(P_SP,TP->QueryProp(P_SP)/2);
    return -1;
  }

  if(!("/obj/erzsehermaster"->check("Erzseher",TP,"","")))
  {
    s = "Du bist nicht maechtig genug, um die Macht dieser Kugel zu "
        "beherrschen. Der Kampf mit den Maechten der Finsternis "
        "war zu hart...";
    tell_object(TP,BS(s));
    TP->SetProp(P_HP,TP->QueryProp(P_HP)*3/4);
    TP->SetProp(P_SP,TP->QueryProp(P_SP)*3/4);
    return -1;
  }

  if(TP->QueryProp(P_SP) < 200)
  {
    s = "Du bist bei weitem  nicht maechtig genug, um die Macht dieser Kugel "
        "zu beherrschen. Der Kampf mit den Maechten der Finsternis "
        "war zu hart...";
    tell_object(TP,BS(s));
    TP->SetProp(P_HP,TP->QueryProp(P_HP)/2);
    TP->SetProp(P_SP,TP->QueryProp(P_SP)/2);
    return -1;
  }

  if(!ready)
  {
    tell_object(TP,BS("Du starrst in die Kugel hinein, kannst jedoch nur "
                      "voellig verschwommene und unklare Bilder erkennen."));
    return -1;
  }

  switch(random(10))
  {
    case 0:  npc = find_living("navi");   hint = " (navi)\n";   break;
    case 1:  npc = find_living("merlin"); hint = " (merlin)\n"; break;
    default: npc = find_living("niac");   hint = " (niac)\n";   break;
  }

  if(!npc)
  {
    s = "Du starrst gebannt in die schwarze Kugel, doch Du erkennst nicht "
        "mehr als vorher auch.";

    if(IS_WIZARD(TP)) s += hint;

    tell_object(TP,BS(s));
    return -1;
  }

  if(!(room=ENV(npc)))
  {
    s = "Du starrst gebannt in die schwarze Kugel, doch Du erkennst nicht "
        "mehr als vorher auch.";

    if(IS_WIZARD(TP)) s += hint;

    tell_object(TP,BS(s));
    return -1;
  }

  s  = BS("Du starrst wie gebannt in die schwarze Kugel. Langsam dringen Bilder "
          "in Deinen Kopf und Du erkennst folgendes: ");
  s += "\n\n"+BS(room->QueryProp(P_INT_LONG))+"\n\n";
  s += BS("Langsam verblassen die Bilder wieder.... ");

  if(IS_WIZARD(TP))
  {
    s    += hint;
  }
  else
  {
    ready = 0;
    TP->AddSp(-1000);
  }

  tell_object(TP,s);

  return 1;
}

string detail_sachen(string str)
{
  string s, *things;

  things = map_objects(all_inventory(TP),"name",WEN);
  if(sizeof(things) == 0)
  {
    s = "Du traegst nichts bei Dir. ";
  }
  else
  {
    s = "Du traegst "+LW(things)+". ";
  }

  return BS(s);
}

