#include "../def.h"

inherit ROOM "inh_spinnen";

void create()
{
  ::create();

  richtung = "Norden";

  AddExit("nordoben"   , ROOM "00-07-01" );
  AddExit("norden"     , ROOM "00-07-01" );
  AddExit("sueden"     , ROOM "01-09-01" );
  AddExit("suedwesten" , ROOM "01-09-02" );
  AddExit("suedosten"  , ROOM "01-09+00" );

  SetProp(P_HIDE_EXITS, ({ "norden" }) );
}

