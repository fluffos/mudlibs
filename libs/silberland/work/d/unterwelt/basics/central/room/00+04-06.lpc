#include "../def.h"

inherit ROOM "inh_stal.lpc";

void create()
{
  ::create();

  UMASTER->Customize(TO);

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2] +
    " Links und rechts von Dir ragen je zwei riesige Stalagmiten auf.");

  AddDetail("stalagmiten", GetDetail("stalagmiten") +
    "Die beiden Exemplare neben Dir sind besonders gross."
  );

  AddDetail( ({ "exemplare" }),
    "Links und rechts von Dir ragen zwei besonders schoene Stalagmiten in "
    "die Hoehe."
  );

  AddDetail( ({ "exemplar" }),
    "Welches meinst Du? Den linken Stalagmiten oder den rechten Stalagmiten?"
  );

  AddDetail( ({ "rechter stalagmit", "rechten stalagmiten" }),
    "Der rechte Stalagmit ist besonders dick. Als Du genauer hinsiehst, kannst "
    "Du kleine Einkerbungen an ihm erkennen."
  );

  AddDetail ( ({ "schrift", "schriftzeichen" }),
    "Ja, eindeutig Schriftzeichen. Gut lesbar."
  );

  AddDetail( ({ "linker stalagmit", "linken stalagmiten" }),
    "Am linken Stalagmiten hat jemand doch tatsaechlich Stufen angebracht, "
    "an denen Du nach oben gehen kannst."
  );

  AddDetail( ({ "stufe", "stufen" }),
    "Kleine Stufen im Stalagmiten links von Dir ermoeglichen ein bequemes "
    "Erklettern des Stalagmiten. Aber ob das wirklich ungefaehrlich ist?"
  );

  AddDetail( ({ "einkerbung", "einkerbungen" }),
    "Das sieht irgendwie nach Schriftzeichen aus. Versuch mal sie zu lesen!"
  );

  AddReadDetail(({"einkerbungen", "einkerbung", "schriftzeichen", "schrift" }),
    "Eitler Narr! Lauf und Flieh!\n"
    "Sonst toetet Dich das Flattervieh!\n"
  );

  AddCmd(CMD_KLETTERN, "cmd_klettern");

  AddExit("oben", ROOM "01+04-06");
  AddProp(P_HIDE_EXITS, ({ "oben" }));

  AddExit("suedwesten", ROOM "00+03-07");
  AddExit("nordosten",  ROOM "00+05-05");
}

int cmd_klettern(string str)
{
  if(str)
    notify_fail(BS(
      "Du brauchst hier nicht zu klettern. Du kannst einfach an den "
      "Stufen nach Oben gehen."));
  return 0;
}
