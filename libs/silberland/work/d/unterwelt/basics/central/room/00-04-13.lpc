#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  UMASTER->Customize(TO);

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2] +
                      "In der Nordwand befindet sich eine Holztuer.");

  AddDetail( ({"nordwand"}) ,
    "In der Nordwand befindet sich eine Holztuer."
  );

  AddExit("nordosten",  ROOM "00-03-12");
  AddExit("westen",     ROOM "00-04-14");

  NewDoor("norden", "/d/unterwelt/archon/turm/room/vorturm", ({"tuer","holztuer"}) ,
    ({D_NAME,"Holztuer"
     ,D_GENDER, FEMALE
     ,D_FLAGS, DOOR_RESET_CL|DOOR_CLOSED
     ,D_MSGS, ({"nach Norden"
               ,"geht durch die Holztuer"
               ,"kommt durch die Holztuer herein"
               })
     ,D_SHORT,"Die Holztuer ist %s. "
     ,D_LONG, "Eine alte verfallene Holztuer. Wirklich alt und verfallen? "
              "Der erste Eindruck scheint vielleicht doch zu taeuschen. "
              "Vielleicht ist das aber gerade beabsichtigt? "
     ,D_OPENMSG, ({"Du oeffnest mit einem nervenzermuerbendem Quietschen die Holztuer."
                  ,"%s oeffnet mit einem nervenzermuerbendem Quietschen die Holztuer."
                  ," wird von der anderen Seite quietschend geoeffnet."
                  })
     ,D_CLOSEMSG,({BS("Du schliesst die Holztuer, welche nochmal gegen den schwarzen Stein knallt und zufaellt.")
                  ,BS("%s schliesst die Holztuer, welche nochmal gegen den schwarzen Stein knallt und zufaellt.")
                  ," wird von der anderen Seite geschlossen und faellt zu."
                  })
     ,D_RESET_CLOSEMSG, " faellt krachend ins Schloss."
     })
  );

}

int doortest()
{
  tell_object(TP,BS("Eine unbekannte Macht hindert sich daran, die Tuer zu "
                    "diesem Zeitpunkt zu durchschreiten. "));

  return 1;
}
