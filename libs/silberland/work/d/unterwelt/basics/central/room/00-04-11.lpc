#include "../def.h"

inherit "std/room";

int unwesen;

void create()
{
  ::create();

  UMASTER->Customize(TO);

  AddDetail( ({ "unterwelt" }),
    "Genau. Du bist in der Unterwelt. Das Boese treibt hier sein Unwesen."
  );

  AddDetail( ({ "boese" }),
    "Das Boese ist hier ueberall. Selbst hinter Dir."
  );

  AddSpecialDetail( ({ "unwesen" }), "detail_unwesen" );

  AddExit("nordwesten", ROOM "00-03-12");
  AddExit("osten"    ,  ROOM "00-04-10");

  AddCmd( ({ "erwische","erwisch" }), "cmd_fangen" );

  unwesen=1;
}

void reset()
{
  ::reset();

  unwesen = 1;
}

string detail_unwesen(string str)
{
  string s;

  if (unwesen)
  {
    s = "Huch, genau so ein Unwesen schwebt dicht ueber dem Boden. "
        "Vielleicht kannst Du es ja irgendwie erwischen?";
  }
  else
  {
    s = "Oh, war wohl doch nichts da.";
  }

  return BS(s);
}

int cmd_fangen(string str)
{
  notify_fail("Was moechtest Du fangen?\n");

  if(!str || str == "") return 0;
  if(!(str == "unwesen"         ||
       str == "unwesen"         )) return 0;

  if(!unwesen)
  {
    TELLPLAYER("Hier ist nichts, was Du erwischen koenntest!\n");
    return 1;
  }

  if (!random(5))
  {
    TELLPLAYER("Geschickt erwischst Du das Unwesen und steckst es ein.\n");
    TELLOTHERS(CAP_TPN+" faengt etwas. Nur was?\n");
    unwesen=0;
    CLONE(OBJ "unwesen",TP);
  }
  else
  {
    TELLPLAYER("Das Unwesen ist leider zu schnell fuer Dich und entkommt.\n");
    TELLOTHERS(BS(CAP_TPN+" versucht etwas einzufangen, doch scheitert "
                  "klaeglich."));
  }

  return 1;
}


