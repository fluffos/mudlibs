#include "../def.h"

inherit "std/room";

#define BONUSOBJ ({ "/d/ebene/obj/waffe/mithrilschwert", \
                    "/d/ebene/obj/waffe/silberschwert", \
                    "/d/dschungel/feyaria/dorf/armour/elfenkettenhemd", \
                    "/d/ebene/ronja/feenquest/weapon/mschwert", \
                    "+ebene/creative/ebony_tiger/armour/ring.lpc", \
                    "+ebene/creative/ebony_tiger/armour/amulett.lpc", \
 })


int gems,pearls;
string *wuehler;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Hoehle des Drachen" );
  SetProp(P_INT_LONG,
    "Dies ist die Hoehle eines Drachen, wie man unschwer an den vielen "
    "Schaetzen hier erkennen kann. Edelsteine in Huelle "
    "und Fuelle liegen hier herum. Die Berge der Schaetze reichen bis zur "
    "Decke hinauf. Der Drache hat dreieinhalb Drachenjahre "
    "dafuer aufgewendet, diesen Schatz anzuhaeufen, und wird ihn sicher nicht "
    "ohne weiteres hergeben."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28,ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist unter dem Schatz verborgen." );
  AddDetail( ({ "decke" }),
    "Sogar von der Decke haengen wertvolle Kristalle. "
    "Wie der Drache das wohl angestellt hat?" );
  AddDetail( ({ "wand", "waende" }),
    "Die Waende kannst Du nicht sehen, weil so viele Schaetze davor "
    "aufgetuermt sind." );
  AddDetail( ({ "schatz", "schaetze", "berge" }),
    "Der Schatz ist unermesslich wertvoll. Er besteht aus vielen verschiedenen "
    "Edelsteinen, die der Drache im Lauf der Jahrhunderte seiner Existenz "
    "von den Dunkelelfen geraubt und hier zusammengetragen hat. Aber auch so "
    "manch wertvolle Waffe oder Ruestung eines gescheiterten Diebs oder Helden "
    "findet sich vielleicht darunter, wenn Du den Schatz durchwuehlst." );
  AddDetail( ({ "edelstein", "edelsteine", "juwelen" }),
    "Juwelen und Edelsteine aller Arten liegen hier herum." );
  AddDetail( ({ "topase" }),
    "Topase aller Farben gibt es hier. Die meisten sind aber honig- bis "
    "dottergelb." );
  AddDetail( ({ "opale" }),
    "Schillernde Opale liegen herum." );
  AddDetail( ({ "smaragde" }),
    "Wunderschoene, tiefgruene Smaragde in allen Groessen." );
  AddDetail( ({ "diamanten" }),
    "Glasklare Diamanten, die in den Regenbogenfarben funkeln." );
  AddDetail( ({ "saphire" }),
    "Tiefblaue Saphire, wunderschoen anzusehen." );
  AddDetail( ({ "rubine" }),
    "Blutrote Rubine von unermesslichem Wert gibt es hier." );
  AddDetail( ({ "amethyste" }),
    "Mehr Amethyste als Du zaehlen kannst" );
  AddDetail( ({ "kristalle" }),
    "Du hast nie zuvor so viele schoene Edelsteine gesehen." );
  AddDetail( ({ "turmaline" }),
    "Wunderschoene Turmaline in tiefstem Dunkelgruen." );
  AddDetail( ({ "perlen" }),
    "Die Perlen sind teilweise von atemberaubender Groesse." );
  AddDetail( ({ "bergkristalle" }),
    "Bergkristalle gibt es hier tonnenweise. Einer schoener und klarer als "
    "der andere." );
  AddDetail( ({ "aquamarine" }),
    "Natuerlich gibt es hier Aquamarine vom schoensten Meerblau, das Du Dir "
    "vorstellen kannst." );
  AddDetail( ({ "onyxe" }),
    "Pechschwarze Onyxe liegen natuerlich auch hier, schliesslich sind das "
    "die Lieblingsedelsteine der Dunkelelfen." );
  AddDetail( ({ "bernsteine", "bernstein" }),
    "Goldglaenzender Bernstein mit und ohne Einschluesse darin." );
  AddDetail( ({ "zirkone" }),
    "Dunkle und helle Zirkone aller Variationen kannst Du erkennen." );
  AddDetail( ({ "granate" }),
    "Blutrote Granate in grosser Zahl liegen einfach so herum." );
  AddDetail( ({ "lapislazulis" }),
    "Du siehst urviele praechtig blaue Lapislazulis." );

  AddCmd( CMD_DURCHSUCHEN, "cmd_durchsuchen" );

  AddItem(NPC "kdrache", REFRESH_DESTRUCT);

  AddExit("westen",  ROOM "00-06-02");

  gems    = 3 + random(3);
  pearls  = 3 + random(3);
  wuehler = ({});
}


reset()
{
  ::reset();
  gems    = 3 + random(3);
  pearls  = 3 + random(3);
  wuehler = ({});
}

init()
{
  ::init();
  if(TP && interactive(TP) && member(wuehler, getuid(TP)) > -1)
    wuehler -= ({ getuid(TP) });
}

object SchatzAuswahl()
{
  int r;

  if(gems == 0 && pearls == 0) return 0;  //nix mehr da, fertig

  if((r=random(10000)) < sizeof(BONUSOBJ)) return clone_object(BONUSOBJ[r]);

  r = random(2); //0=waehle edelstein,1=waehle perle

  if(r == 0 && gems   == 0) r = 1; //korrektur falls alle edelsteine weg
  if(r == 1 && pearls == 0) r = 0; //korrektur falls alle perlen     weg

  if(r==0)
  {
    gems--;
      // Tue May 8 2001: wg. Aenderung im gemmaster veraendert [0], Angrox
    return "/obj/gemmaster"->DistributeGem(1,0,0)[0];
  }

  pearls--;
  return "/obj/pearlmaster"->DistributePearl(1,0,0);
}

int cmd_durchsuchen(string str)
{
  object dr;

  notify_fail("Was willst Du durchwuehlen?\n");

  if(!str || str == "") return 0;
  if(!(str == "schatz"         ||
       str == "schaetze"       ||
       str == "in schatz"      ||
       str == "in schaetze"    ||
       str == "in schaetzen"   )) return 0;

  if(dr=present("drache"))
  {
    write("Der Drache mag es nicht, wenn man ihn bestiehlt.\n");
    dr->Kill(TP);
    return 1;
  }

  if(member(wuehler, getuid(TP))+1)
  {
    write("Aber Du wuehlst doch schon! Du findest sicher gleich was "
          "schoenes!\n");
    return 1;
  }

  say(CAP(TPN)+" stuerzt sich auf den Schatz und wuehlt darin herum.\n");

  write(BS("Du stuerzt Dich auf die Schaetze in diesem Raum und wuehlst wie "+
           (TP->QueryProp(P_GENDER)==MALE ? "ein Wilder" : "eine Wilde") +
           " auf der Suche nach einem besonders wertvollen Stueck darin "
           "herum." ));

  wuehler += ({ getuid(TP) });

  call_out("wuehl2", 4+random(4), TP);
  return 1;
}

void wuehl2(object wer)
{
  object ob;

  if(objectp(wer) && interactive(wer) && environment(wer)==TO )
  {
    ob=SchatzAuswahl();

    if(!ob)
    {
      write(BS("Du wuehlst und wuehlst und wuehlst aber Du findest nichts "
               "was Dich wirklich interessieren wuerde."));
      return;
    }

    write(BS("Du findest Gefallen an "+ob->name(WEM, 0)+". "+
             CAP(ob->QueryPossPronoun(MALE, WER, 0))+" Wert und "+
             ob->QueryPossPronoun(FEMALE, WER, 0)+" pure Schoenheit "
             "beeindrucken Dich."));
    say(wer->Name(WER)+" durchwuehlt den Schatz und findet "
        +ob->name(WEN, 1)+".\n");
    ob->move(wer, M_GET|M_SILENT);
    wuehler -= ({ getuid(wer) });
  }
}

