#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
}

varargs int PreventInsert(object ob)
{
   object *items;

   if(living(ob))                 return ::PreventInsert(ob);
   if(interactive(ob))            return ::PreventInsert(ob);
   if(query_once_interactive(ob)) return ::PreventInsert(ob);
   if(ob->id("Waffe"))            return ::PreventInsert(ob);
   if(ob->id("Ruestung"))         return ::PreventInsert(ob);
   if(ob->id("Leiche"))           return ::PreventInsert(ob);
   if(ob->id("\nspinnenseide"))   return ::PreventInsert(ob);
   if(ob->id("Container"))        return ::PreventInsert(ob);

   filter_objects(deep_inventory(ob), "remove");
   call_out("hauwech",0,ob);
   return 0;
}

void hauwech(object ob)
{
  if(!ob)           return;
  if(!objectp(ob))  return;
  if(!ENV(ob))      return;
  if(ENV(ob) != TO) return;


  tell_room(TO,BS(ob->Name(WER)+" faellt durch das Spinnennetz in "
                  "eine scheinbar bodenlose Tiefe."));
  ob->remove();
}
