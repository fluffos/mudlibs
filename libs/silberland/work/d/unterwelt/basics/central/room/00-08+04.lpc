#include "../def.h"

inherit ROOM "inh_see.lpc";

void create()
{
  ::create();

  AddDetail(({ "ufer", "uferstreifen" }), GetDetail("ufer")[0..<2]+
    " Hier, wo du Dich befindest, scheint ein Kadaver angespuelt "
    "worden zu sein."
  );

  AddDetail ( ({ "kadaver", "abenteurer" }),
    "Ein Abenteurer ist im See ertrunken und hier ans Ufer "
    "gespuelt worden. Der Kadaver ist aufgedunsen und tot."
  );

  AddExit("norden"    , ROOM "00-07+04");
  AddExit("suedwesten", ROOM "00-09+03");
}
