#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  UMASTER->Customize(TO);

  SetProp(P_INT_LONG,
    QueryProp(P_INT_LONG)[0..<2] + "Ein kleines Schild liegt hier."
  );

  AddDetail( ({ "schild" }),
    "Du kannst es lesen."
  );

  AddReadDetail( ({ "schild" }),
    " _________________________\n"
    "<                         >\n"
    " \\         Gnome         /\n"
    "  \\          |          /\n"
    "   \\ Polaris-O         /\n"
    "    \\         \\       /\n"
    "     \\      Dhrkion  /\n"
    "      \\_____________/\n"
  );

  AddExit("suedosten",  ROOM "00-02-12");
  AddExit("westen",     ROOM "00-01-14");
  AddExit("norden",     ROOM "00+00-13");
}
