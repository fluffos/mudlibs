#include "../def.h"

inherit "std/room";

int gut,boese;

void create()
{
  ::create();

  UMASTER->Customize(TO);

  SetProp(P_INT_LONG,
    QueryProp(P_INT_LONG)[0..<2] + "Etwas abseits steht hier ein kleiner "
    "Steinblock."
  );

  AddDetail( ({ "steinblock","block" }),
    "Auf dem Block scheint eine kleine Schatulle zu liegen."
  );

  AddDetail( ({ "schatulle" }),
    "Eine kleine Schatulle liegt auf dem Steinblock. Sie ist aus purem Gold "
    "gemacht und traegt viele daemonische Verzierungen. An ihrer Oberseite "
    "sind zwei kleine besondere Zeichnungen."
  );

  AddDetail( ({ "gold" }),
    "Pures Gold ist es. Es funkelt."
  );

  AddDetail( ({ "verzierungen","verzierung" }),
    "Die Verzierungen zeigen daemonische Symbole und Runen."
  );

  AddDetail( ({ "symbole","runen","heptagramme" }),
    "Heptagramme und dergleichen sind das."
  );

  AddDetail( ({ "oberseite" }),
    "Auf der ansonsten glatten Oberflaeche sind zwei Zeichnungen deutlich "
    "zu erkennen."
  );

  AddDetail( ({ "zeichnungen","kampf" }),
    "Die Zeichnungen zeigen den Kampf des Guten gegen das Boese."
  );

  AddDetail( ({ "zeichnung" }),
    "Welche meinst Du?"
  );

  AddSpecialDetail( ({ "gute","gutes" })   , "detail_gutes" );
  AddSpecialDetail( ({ "boese","boeses" }) , "detail_boeses" );

  AddCmd( ({"plazier","plaziere","platziere","platzier" }), "cmd_platz" );

  AddExit("osten"      , ROOM "00-05-08");
  AddExit("nordwesten" , ROOM "00-04-10");
  AddExit("sueden"     , "/d/unterwelt/archon/turm/dunkelelfen/room/tunnel_01");

  gut   = 0;
  boese = 0;
}

void reset()
{
  ::reset();

  gut   = 0;
  boese = 0;
}

string detail_gutes(string str)
{
  string s;

  if(gut)
  {
    s = "Die linke zeichnung stellt das Gute komplett dar.\n";
  }
  else
  {
    s = "Die linke Zeichnung stellt das Gute dar. Es scheint aber etwas zu "
        "fehlen. Man koennte etwas darauf plazieren.\n";
  }

  return BS(s);
}

string detail_boeses(string str)
{
  string s;

  if(boese)
  {
    s = "Die rechte Zeichnung stellt das Boese komplett dar.\n";
  }
  else
  {
    s = "Die rechte Zeichnung stellt das Boese dar. Es scheint aber etwas zu "
        "fehlen. Man koennte etwas darauf plazieren.\n";
  }

  return BS(s);
}

int cmd_platz(string str)
{
  string was,wo;
  object ob;

  notify_fail("Was moechtest Du wo plazieren?\n");
  if(!str || str == "") return 0;

  if(sscanf(str, "%s auf %s zeichnung",was,wo) == 2)
  {
    if (was == "lichtpunkt" || was == "punkt")
    {
      if(!ob=present("\nlichtpunkt",TP))
      {
        TELLPLAYER("Aber Du hast sowas ja gar nicht bei Dir!\n");
        return 1;
      }

      if ((wo == "rechte") || (wo == "rechter"))
      {
        TELLPLAYER("Als Du das tust, verschwindet der Lichtpunkt mit einem "
                   "Knall!\n");
        ob->remove();
        return 1;
      }

      if(!((wo == "linke") || (wo == "linker")))
      {
        TELLPLAYER("Diese Zeichnung gibt es nicht!\n");
        return 1;
      }

      if(gut)
      {
        TELLPLAYER("Aber da ist doch schon ein Lichtpunkt plaziert worden!\n");
        return 1;
      }

      TELLPLAYER(BS("Du plazierst den Lichtpunkt direkt ueber der linken "
                    "Zeichnung. Es schwebt leicht darueber und strahlt ein "
                    "helles Leuchten aus." ));
      TELLOTHERS(CAP_TPN+" macht es etwas heller im Raum.\n");
      gut = 1;
      ob->remove();
      if(boese) call_out("fertig",4,TP);
      return 1;
    }

    if(was == "unwesen" )
    {
      if(!ob=present("\nunwesen",TP))
      {
        TELLPLAYER("Aber da hast sowas ja gar nicht bei Dir!\n");
        return 1;
      }

      if((wo == "linke") || (wo == "linker"))
      {
        TELLPLAYER("Als Du das tust, verschwindet das Unwesen mit einem "
                   "Knall!\n");
        ob->remove();
        return 1;
      }

      if(!((wo == "rechte") || (wo == "rechter")))
      {
        TELLPLAYER("Diese Zeichnung gibt es nicht!\n");
        return 1;
      }

      if(boese)
      {
        TELLPLAYER("Aber da ist doch schon ein Unwesen plaziert worden!\n");
        return 1;
      }

      TELLPLAYER(BS("Du plazierst das Unwesen direkt ueber der rechten "
                    "Zeichnung. Etwas boeses und daemonisches strahlt jetzt "
                    "von dort." ));
      TELLOTHERS(CAP_TPN+" macht es etwas dunkler im Raum.\n");
      boese = 1;
      ob->remove();
      if(gut) call_out("fertig",4,TP);
      return 1;
    }
  }

  return 0;
}

void fertig(object player)
{
  if(!present(player)) return;

  tell_object(player,BS(
    "Auf einmal fangen das Unwesen und der Lichtpunkt an sich mit den "
    "Zeichnungen zu verschmelzen. Blitze zucken und eine Dunkelheit breitet "
    "sich auf der Schatulle aus. Es beginnt ein harter Kampf zwischen Gut "
    "und Boese. Nach einer Weile aber steht fest, keines von beiden kann "
    "gewinnen. Das Gute macht einen kleinen Fehler und schleudert einen "
    "Blitz auf Dich. Genau in diesem Moment trifft Dich das Unwesen. Ein "
    "gleissender Schmerz durchfaehrt Deinen Koerper. Du machst kurz die Augen "
    "zu und als Du sie wieder oeffnest, ist der Spuk vorbei." ));

  tell_room(TO,BS(
    "Auf einmal faengt das Dunkle und das Helle an sich mit den "
    "Zeichnungen zu verschmelzen. Blitze zucken und eine Dunkelheit breitet "
    "sich auf der Schatulle aus. Es beginnt ein harter Kampf zwischen Gut "
    "und Boese. Nach einer Weile aber steht fest, keines von beiden kann "
    "gewinnen. Das Gute macht einen kleinen Fehler und schleudert einen "
    "Blitz auf "+TPN+". Genau in diesem Moment trifft aber auch das "
    "Unwesen "+TPN+". Ein gleissender Schmerz durchfaehrt den Koerper "
    "von "+TPN+". Du machst kurz die Augen zu und als Du sie wieder "
    "oeffnest, ist der Spuk vorbei." ), ({ player }));

  player->heal_self(150+random(40));
}
