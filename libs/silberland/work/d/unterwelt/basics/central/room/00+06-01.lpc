#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  UMASTER->Customize(TO);

  SetProp(P_INT_LONG, QueryProp(P_INT_LONG)[0..<2]+
    "Ein kleiner, schmaler Fluss kreuzt hier Deinen Weg."
  );

  AddDetail( ({ "fluss" }),
    "Nordwestlich von hier kreuzt ein kleiner Fluss den Weg. Du kannst aber "
    "sicher ohne Probleme druebersteigen, wenn Du nach Nordwesten gehst."
  );

  AddDetail( ({ "wasser" }),
    "Der Fluss ist nicht besonders tief und fliesst schnell nach Sueden. "
    "Darum ist hier nur wenig Wasser zu sehen."
  );

  AddExit("nordwesten"  , ROOM "00+07-02");
  AddExit("nordosten"   , ROOM "00+07+00");
}
