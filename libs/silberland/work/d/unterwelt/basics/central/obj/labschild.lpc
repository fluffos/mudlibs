#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Warnschild");
  SetProp(P_LONG,
"|~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n"
"|                      !!! ACHTUNG !!!\n"
"|\n"
"|  Vom Betreten der Hoehlen in suedoestlicher Richtung nach\n"
"|  unten  wird dringend abgeraten.  Schon viele  mutige und\n"
"|  erfahrene  Helden sind  in diese Richtung gewandert  und\n"
"|  wurden nie wieder gesehen.  Nicht einmal Schreie konnten\n"
"|  wieder bis hierher gelangen.\n"
"|\n"
"|                                                 i.A. Lars\n"
"|\n"
" ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n" );

  SetProp(P_NAME, "Warnschild");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "warnschild","schild" }) );

  SetProp(P_MATERIAL, MAT_MISC_WOOD );
  SetProp(P_WEIGHT, 100000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, "Das Warnschild laesst Du besser hier!\n");
}
