inherit "std/unit";

#include "../def.h"

void create()
{
  int m;

  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Brocken Mithrilerz");
  SetProp(P_LONG,
    "Brocken von Schiefergestein mit dicken Mithrilablagerungen darin. "
  );

  SetProp(P_NAME, ({"Erzbrocken", "Erzbrocken"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"erzbrocken", "mithrilerzbrocken", "brocken"}) );
  AddPluralId( ({"erzbrocken", "mithrilerzbrocken", "brocken"}) );
  AddId( ({"erz", "mithrilerz"}) );

  SetCoinsPerUnits(200,1);
  SetGramsPerUnits(180,1);

  m=50+random(40);
  SetProp(P_MATERIAL, ([ MAT_SLATE:m, MAT_MITHRIL:(100-m)]) );
  SetProp(P_NOBUY, 1);
}
