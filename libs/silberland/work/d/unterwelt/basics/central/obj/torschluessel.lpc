#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein kleiner Torschluessel");
  SetProp(P_LONG,
    "Das ist ein kleiner Torschluessel. Eigentlich ist er auf Anhieb "
    "nicht als Schluessel zu erkennen, da er eine runde Form hat und in "
    "eine Einbuchtung gelegt wird."
  );

  SetProp(P_NAME, "Torschluessel");
  SetProp(P_GENDER, MALE);
  AddId( ({ "\n_torschluessel","torschluessel","schluessel" }) );

  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({"kleinen","kleiner","kleinem","kleines","kleine"}) );

  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_MAGIC, 1);
}

string QueryDoorKey()
{
  return ROOM "00-08-04" ":" ROOM "00-09-04";
}

