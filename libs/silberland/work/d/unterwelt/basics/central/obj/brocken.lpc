#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein Steinbrocken");
  SetProp(P_LONG,
    "Ein simpler Gesteinsbrocken, der zu ueberhaupt nichts gut ist. ");

  SetProp(P_NAME, "Steinbrocken" );
  SetProp(P_GENDER, MALE);

  AddId( ({"stein", "steinbrocken", "gesteinsbrocken", "brocken"}) );

  SetProp(P_MATERIAL, ([ MAT_GRANITE:100]) );
  SetProp(P_WEIGHT, 670);
  SetProp(P_VALUE, 3);
}
