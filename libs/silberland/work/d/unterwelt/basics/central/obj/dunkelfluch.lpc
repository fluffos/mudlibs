#include "../def.h"

inherit "/std/thing";

string wem;
string *oldids;
string target;

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, 0);  // Das Zeug ist unsichtbar, klar.
  SetProp(P_LONG, 0);
  AddId( ({ "DUNKELFLUCH" }) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS,1);

  wem     = "irgendwas";
  target  = "none";
}

string QueryTarget()
{
  return target;
}

void darken(object ob)
{
  if(target != 0) return;

  oldids = ob->QueryProp(P_IDS) + ({"NOUNCURSE","NODESTRUCT","DARKSPELL"});

  ob->Set(P_LIGHT,  lambda( ({}), ({#'return, 0 })       ), F_QUERY_METHOD );
  ob->Set(P_CURSED, lambda( ({}), ({#'return, 1 })       ), F_QUERY_METHOD );
  ob->Set(P_IDS,    lambda( ({}), ({#'return, quote(oldids) }) ), F_QUERY_METHOD );

  target = file_name(ob);
  wem    = "d" + ob->name(WEM,0);

  ob->SetProp("darkelfcurse", file_name(TO));
}

void remove(int silent)
{
  object ob;

  ob = find_object(target);

  if(ob)
  {
    if(!silent && ENV(TO) && interactive(ENV(TO)))
    {
      tell_object(ENV(TO), BS("Der Dunkelfluch ueber "+wem+" scheint "
                              "nachzulassen"));
    }

    ob->Set(P_LIGHT,  0, F_QUERY_METHOD );
    ob->Set(P_CURSED, 0, F_QUERY_METHOD );
    ob->Set(P_IDS,    0, F_QUERY_METHOD );

    ob->SetProp("darkelfcurse", 0);
  }

  ::remove();
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  call_out("remove", 0, 1);
  return;
}

