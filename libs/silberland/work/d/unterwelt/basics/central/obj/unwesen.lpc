#include "../def.h"

inherit "std/thing";

void create()
{

  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Unwesen");
  SetProp(P_LONG,
    "Das Unwesen treibt sein Unwesen in Deinem Inventory. Wenn Du es nicht "
    "schnell los wirst, koennten schlimme Dinge geschehen!"
  );

  SetProp(P_INFO, "Das Unwesen ist durch und durch boese.\n");
  SetProp(P_NAME, "Unwesen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "unwesen","\nunwesen"}) );

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
}
