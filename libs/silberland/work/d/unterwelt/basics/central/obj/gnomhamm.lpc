#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein schwerer Hammer");
  SetProp(P_LONG, 
    "Ein schwerer Hammer, den Gnome dafuer benutzen, um Gestein zu "
    "zertruemmern, wenn sie Erz abbauen. Auf einen gegnerischen Kopf "
    "geschlagen, ist die Wirkung aber sicher auch ziemlich verheerend. "
    "Leider ist der Hammer aber eben sehr gewichtig und ist im Kampf "
    "schlecht zu fuehren." );
  SetProp(P_NAME, "Hammer");
  SetProp(P_GENDER, MALE);
  AddId( ({"hammer"}) );
  AddAdjective(({ "schwerer" }));

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 240);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_WC_FIXFACTOR, 0.1);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_BRONCE:20, MAT_STEEL:80]) );
  SetProp(P_WEIGHT, 8500);
  SetProp(P_VALUE, 3000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 75);
}


