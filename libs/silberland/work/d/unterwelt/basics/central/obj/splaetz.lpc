#include "../def.h"

inherit "std/food";

#include <food.h>

#define KEKS_SOAK 3

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein schattiges Plaetzchen");
  SetProp(P_LONG,
    "Dieses Plaetzchen ist eindeutig magischen Ursprungs. Es liegt pulsierend "
    "in Deiner Hand und verbreitet eine schaurige Kuehle. Dieses Plaetzchen "
    "wurde von verderbten Seelen geschaffen und ist ein Produkt des Boesen. "
    "Wie das wohl schmeckt?"
  );

  SetProp(P_NAME, "Plaetzchen");
  AddId( ({"plaetzchen", "keks"}) );

  SetProp(P_NAME_ADJ, ({"schattig"}) );
  AddAdjective( ({"schattigen","schattiger","schattigem","schattiges","schattige"}) );

  SetProp(P_INFO,
    "Wenn Du dieses Plaetzchen isst, springt vielleicht ein Teil der "
    "boesen Magie darin auf Dich ueber und lenkt Deine Pfade etwas mehr "
    "in die satanische Richtung."
  );

  SetProp(P_GENDER, NEUTER);
  SetProp(P_MATERIAL, ([MAT_MISC_FOOD:80,MAT_MISC_UNHOLY:20]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 30);
  SetProp(P_MAGIC, 1);
  SetProp(P_NOBUY, 1);

  SetProp (P_FOOD_INFO,
    ([F_HEAL     : ({0,0})
     ,F_SOAK     : KEKS_SOAK
     ,F_DRINK    : 0
     ,F_ALCOHOL  : 0
     ,F_POISON   : 0
     ,F_MSG      : BS("Gierig schlingst Du den Keks hinunter und fuehlst "
                      "sofort, wie Du von boesen Kraeften durchstroemt "
                      "wirst. Der Geschmack war aber nicht so "
                      "besonders... *buaeh*")
     ,F_MSG_ROOM : "verschlingt gierig ein Plaetzchen.\n"
     ])
  );
}

void Eating(object pl)
{
  pl->SetProp(P_ALIGN, (pl->QueryProp(P_ALIGN)*9-1000)/10);
}

