#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein schwarzer Schluessel");
  SetProp(P_LONG,
    "Ein Schluessel. Welches Tor er wohl aufzuschliessen vermag?"
  );

  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE);
  AddId( ({ "\nlavaschluessel","schluessel" }) );

  SetProp(P_NAME_ADJ, ({"schwarz"}) );
  AddAdjective( ({"schwarzen","schwarzer","schwarzem","schwarzes","schwarze"}) );

  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_MAGIC, 1);
}

string QueryDoorKey()
{
  return ROOM "00-02+13" ":" ROOM "lava";
}

