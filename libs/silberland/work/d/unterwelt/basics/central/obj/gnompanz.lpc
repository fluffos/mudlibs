#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Gnompanzer");
  SetProp(P_LONG,  
    "Der Panzer eines Gnoms. Gnome verstehen wirklich etwas von Metallen, "
    "wie man an diesem Panzer erkennen kann. Die Verarbeitung ist gut "
    "und die Metallqualitaet ebenfalls. Trotzdem reicht dieses Stueck "
    "natuerlich nicht an die gediegenen Arbeiten aus Zwergenhand heran. "
    "Besonders die Arme und der Hals sind schlecht geschuetzt." );
  SetProp(P_NAME, "Gnompanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "gnompanzer"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, ([ MAT_COPPER:50, MAT_IRON:50 ]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 1000);

}

