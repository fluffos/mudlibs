#include "../def.h"

inherit "std/thing";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Ein Fledermausfluegel");
  SetProp(P_LONG,
    "Ein riesiger Fluegel aus duenner, schwarzer Haut mit zarten Knochen "
    "darin. Die Fledermaus, der dieser Fluegel gehoert hat, muss gewaltig "
    "gross gewesen sein."
  );

  SetProp(P_NAME, "Fledermausfluegel");
  SetProp(P_GENDER, MALE);
  SetProp(P_INFO, BS(
   "Man kann zwei solcher Fluegel aneinandernaehen und bekommt so "
   "einen praktischen Fledermausumhang. Die Syntax hierzu lautet: 'naehe "
   "fluegel aneinander'."));

  AddId( ({"fluegel", "fledermausfluegel", "Batqueenwings\n"}) );

  SetProp(P_MATERIAL, ([MAT_SKIN:80, MAT_BONE:20 ]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 100);

  AddCmd( ({ "naehe","naeh","befestige" }), "cmd_naehen");
}

int cmd_naehen(string str)
{
  object obj;

  notify_fail("Was moechtest Du aneinandernaehen?\n");

  if(!str || str == "") return 0;
  if(!(str == "fluegel aneinander"           ||
       str == "fledermausfluegel aneinander" ||
       str == "fluegel zusammen"             ||
       str == "fledermausfluegel zusammen"   )) return 0;

  if(!(obj=present("Batqueenwings\n 2", TP)))
  {
    TELLPLAYER("Du brauchst schon zwei solcher Fluegel, um sie "
               "aneinanderzunaehen.\n");
    return 1;
  }

  TELLPLAYER(BS("Du naehst zwei Fledermausfluegel zusammen und machst Dir "
                "so einen grossen Fluegellappen, den man gut als Umhang "
                "benutzen kann."));

  TELLOTHERS(BS(TP->Name()+" naeht zwei Fledermausfluegel zusammen und "
                "macht sich so einen praktischen Umhang."));

  obj->remove();
  clone_object(ARMOUR "batcloak")->move(TP, M_NOCHECK);
  RemoveCmd( ({ "naehe","naeh","befestige" }) );
  call_out("remove", 0, 1);

  return 1;
}

