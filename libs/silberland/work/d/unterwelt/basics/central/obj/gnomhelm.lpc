#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Gnomhelm");
  SetProp(P_LONG,  
    "Ein robuster Helm, wie in Gnome tragen. Verschiedene Materialien wurden "
    "bei diesem Helm verwendet, sogar etwas Mithril ist dabei. Vor Stein"
    "schlaegen und splitterndem Fels schuetzt er ausgezeichnet. Sogar auf eine "
    "kleine Blende zum Schutz der Augen wurde nicht vergessen. An der "
    "Oberseite ist der Helm am dicksten und besteht aus massiver Bronze mit "
    "feinen Mithrildraehten darin." );

  SetProp(P_NAME, "Gnomhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "gnomhelm"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_MITHRIL:5, MAT_IRON:20, MAT_BRONCE:65, 
                        MAT_STEEL:10 ]) );
  SetProp(P_WEIGHT, 2400);
  SetProp(P_VALUE, 3000);

}
