#include "../def.h"

inherit "std/thing";

void create()
{

  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Lichtpunkt");

  SetProp(P_LONG,
    "Ein winziger Lichtpukt erhellt Dich ein wenig. Aber es reicht nicht "
    "aus, um besser sehen zu koennen."
  );

  SetProp(P_INFO, "Der Lichtpunkt ist durch und durch gut.\n");
  SetProp(P_NAME, "Lichtpunkt");
  SetProp(P_GENDER, MALE);
  AddId( ({"lichtpunkt","punkt","\nlichtpunkt"}) );

  SetProp(P_MATERIAL, MAT_LIGHT );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
}
