#include "../def.h"

inherit "std/food";

#include <food.h>

void create()
{
  if(!is_clone(TO))  return;

  ::create();

  switch(random(3))
  {
    case 0:
      SetProp(P_SHORT, "Ein schwarzer Pilz");
      SetProp(P_LONG, "Ein schwarzer Pilz, der vor boshafter "
                      "Gefaehrlichkeit regelrecht pulsiert. Vielleicht ist "
                      "das aber auch Einbildung und der Pilz ist harmlos, "
                      "wer weiss? ");
      SetProp(P_NAME_ADJ, ({"schwarz"}) );
      AddAdjective( ({"schwarzen","schwarzer","schwarzem"
                     ,"schwarzes","schwarze"}) );

      break;

    case 1:
      SetProp(P_SHORT, "Ein grauer Pilz");
      SetProp(P_LONG, "Ein unscheinbarer, grauer Pilz. Bei zu starkem Licht "
                      "betrachtet scheint er langsam zu zerbroeckeln. Er "
                      "stammt wohl aus dunkleren Gegenden. Ob es gefaehrlich "
                      "waere, ihn zu essen, kann man unmoeglich sagen, man "
                      "muesste schon hineinbeissen...");
      SetProp(P_NAME_ADJ, ({"grau"}) );
      AddAdjective( ({"grauen","grauer","grauem","graues","graue"}) );
      break;

    default:
      SetProp(P_SHORT, "Ein leuchtender Pilz");
      SetProp(P_LONG, "Dieser Pilz aus der dunelsten Unterwelt leuchtet "
                      "leicht. Als Lichtspender kann man ihn aber nicht "
                      "verwenden, dafuer fluoresziert er viel zu schwach.");
      SetProp(P_NAME_ADJ, ({"leuchtend"}) );
      AddAdjective( ({"leuchtenden","leuchtender","leuchtendem"
                     ,"leuchtendes","leuchtende"}) );

      break;
  }

  SetProp(P_NAME, "Pilz");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, ([MAT_MUSHROOM:100]) );
  SetProp(P_WEIGHT, 25);
  SetProp(P_VALUE, random(20)+1);
  AddId( ({"pilz"}) );
  SetProp(P_FOOD_INFO, ([F_HEAL : 0, F_SOAK : 0 ]) );
}

void Eating(object pl)
{
  tell_object(pl,"Du isst "+TO->name(WEN,1)+" auf.\n");
  tell_room(ENV(pl),pl->Name()+" isst "+TO->name(WEN,0)+".\n", ({pl}) );

  switch(random(100))
  {
    case 0..5:
      tell_object(ENV(pl),"Eine Stimme droehnt: Dies war der falsche Pilz! "
                          "Stirb, Du Narr!\n");
      pl->die();
      break;

    case 6..40:
      tell_object(pl,BS("Der Pilz, den Du ausgewaehlt hast, war eine gute "
                        "Wahl. Der wuerzige Geschmack ist koestlich und "
                        "betoerend. Voller Freude merkst Du, wie reine "
                        "Lebensenergie Dich durchstroemt."));

      pl->heal_self(80+random(80));

      if(pl->QueryProp(P_POISON))
        tell_object(pl,"Jegliches Gift in Deinem Koerper wird vernichtet.\n");

      pl->SetProp(P_POISON, 0);
      break;

    case 41..60:
      tell_object(pl,"Aaaaaaarrghh! Dieser Schmerz! Der Pilz war eindeutig giftig!\n");
      tell_room(ENV(pl),pl->Name()+" kruemmt sich vor Schmerzen am Boden.\n");
      pl->AddPoison(5);
      pl->SetProp(P_HP, TP->QueryProp(P_HP) / 10);
      break;

    case 61..80:
      tell_object(pl,"Der Pilz schmeckt nach ueberhaupt nichts.\n");
      break;

    default:
      tell_object(pl,BS("Der Pilz schmeckt bitter und wie Galle, aber sonst "
                        "passiert nichts.\n"));
  }


}
