#0:0
text_short ({"In einem unendlich langen Gang","Ein duesterer Gang","Ein Gang in der Unterwelt","Ein langer Gang","Ein gewundener Gang","Unter der Erde in einem Gang",})
text_long ([1:({"Du befindest Dich in einem der zahllosen dunklen Gaenge der Unterwelt.","Vorsichtig schleichst Du in den unendlichen Gaengen hier weiter.","Der Gang ist hier ein wenig enger als sonst.","Mit einem Gefuehl der Angst bewegst Du Dich weiter in den Gaengen fort.","Du tastest Dich vorsichtig weiter in der Unterwelt.",}),2:({"Die ganze Atmosphaere hier kann nur vom Boesen selber geschaffen worden sein.","Ungeheure Anspannung und boese Gedanken durchstroemen Deinen Koerper.","Nur die irrsinnige Gewalt des Boesen kann solche Gaenge erschaffen haben.","Deine Furcht vor dem Unbekannten laesst Dich kurz stocken.","Das Boese wirkt hier dermassen unheimlich, dass Du sofort umkehren moechtest.",}),3:({"Hinter jeder Biegung und in jedem Schatten, der sich bewegt, vermutest Du eine boese Kreatur.","Genau hinter Dir versuchte gerade ein Schatten, Dich in das ewige Leben zu befoerdern.","In der Dunkelheit glaubst Du, viele dunkle Gestalten zu erkennen.","Dunkle Schatten greifen Dich von allen Seiten aus an und versuchen Dich zu zerquetschen.","Nur Kreaturen des Boesen koennen hier laenger ueberleben.",}),4:({"Die Waende aus Stein sind kahl und dunkel.","Die Wand fuehlt sich kalt und feucht an.","An den Waenden kannst Du einige Spuren erkennen.","Die dunklen Waende hier floessen Dir Angst ein.","Die Waende scheinen zu pulsieren.",}),5:({"Der dreckige Boden laedt nicht gerade auf einen laengeren Aufenthalt ein.","Die Luft ist stickig und der Boden total verdreckt.","Die dicke Luft, die der Boden verbreitet, macht das Atmen hier sehr schwer.","Der dreckige Boden scheint sich, wenn auch kaum merklich, zu bewegen.","Der ganze Dreck auf dem Boden ekelt Dich an.",}),6:({"Ausserdem haengen Felsen von der Decke herab.","Die Decke ist gerade hoch genug, dass Du Dir nicht den Kopf stoesst.","Von oben tropft Wasser herab.","Die Dunkelheit der Decke uebertrifft alles, was Du bisher gesehen hast.","Die grausame Decke scheint Dich zu erdruecken.",}),])
text_details (["region":({"Du bist in der Unterwelt. Sehr schwer zu erkennen.","Es gibt keine boesere Region als die Unterwelt.","Dass gerade Du Dich in die Unterwelt traust, haettest Du Dir vorher nicht traeumen lassen.",}),"atmen":({"Nur sehr schwer kannst Du hier atmen. Die Luft erdrueckt Dich fast.","Das Atmen hier unten ist nicht leicht.","In der Luft liegt Gefahr und Verderben. Du schauderst.",}),"unterwelt":({"Es gibt nur einen Ort, an dem es so finster und dunkel ist: Die Unterwelt.","Hier ist es so finster und dunkel, dass sich nur wenige in die Unterwelt trauen.","Die Unterwelt ist das Grauen in sich. Besser Du verschwindest hier so schnell Du kannst!",}),"wasser":({"Glasklares Wasser tropft von der Decke herab.","Pflitsch. Das Wasser ist Dir auf den Ruecken getropft.","Platsch. Das dunkle Wasser tropft auf den Boden.",}),"aufenthalt":({"Der Aufenthalt in der Unterwelt ist sehr gefaehrlich.","Aufhalten sollte man sich hier lieber nicht zu lange.","Die Unterwelt wird Dir schon zeigen, dass der Aufenthalt hier nicht erwuenscht ist!",}),"schweiss":({"Purer Schweiss aus Angst ist das.","Du schwitzt schon ziemlich unter dieser Hitze hier.","Heiss und unangenehm ist es hier. Du schwitzt schon sehr arg. Aber mehr aus Angst als wegen der starken Hitze hier.",}),"licht":({"Nur sehr wenig Licht ist hier.","Das Licht reicht gerade mal so aus, dass Du hier was erkennen kannst.","Du haettest vielleicht gern ein wenig mehr Licht.",}),"hitze":({"Die Hitze hier ist kaum auszuhalten. Du keuchst.","Eine unglaubliche Hitze wird hier verbreitet.","Unbeschreibliche Hitze umgibt Dich hier. Lange haelt man es hier sicher nicht aus.",}),"leben":({"Dein Leben kannst Du hier schneller verlieren, als Du denken kannst.","Das ewige Leben ist als einziges sicher vor der Unterwelt.","Sicher wirst Du Dein Leben hier aushauchen, wenn Du noch laenger nur so hier rumstehst.",}),"spinne":({"Pfui Spinne denkst Du Dir. Aber zumindest die Spinnen hier sehen harmlos aus. Puuuuh.","Eine der Spinnen schaut Dich an und will Dich wohl anspringen. Aber sie laesst von Dir ab und laesst Dich einfach so stehen.","Die Spinnen hier sind sicherlich giftig. Du siehst wie sich die Spinnen sogar gegenseitig auffressen.",}),"luft":({"Die Luft hier ist so dick und stickig, dass Du kaum atmen kannst.","Wenn man wollte, koennte man die Luft hier sogar schneiden.","Anstrengend ist das Atmen hier. Du bekommst kaum Luft und beschliesst lieber schnell weiter zu gehen.",}),"spinnen":({"Pfui Spinne denkst Du Dir. Aber zumindest die Spinnen hier sehen harmlos aus. Puuuuh.","Eine der Spinnen schaut Dich an und will Dich wohl anspringen. Aber sie laesst von Dir ab und laesst Dich einfach so stehen.","Die Spinnen hier sind sicherlich giftig. Du siehst wie sich die Spinnen sogar gegenseitig auffressen.",}),"angst":({"Angst ist alles, was Du hier unten empfindest.","Du zitterst vor lauter Angst. Du kannst kaum noch richtig denken.","Deine Angst zwingt Dich zu zittern.",}),"schatten":({"Da war doch grad einer hinter Dir. Du drehst Dich um. Doch voller Panik wendest Du Dich wieder ab.","Voller Panik verfolgst Du einen Schatten. Aber Du musst feststellen, dass nur Deine Angst den Schatten geformt hat.","Wo ist nur Dein eigener Schatten? Du kannst ihn nicht erkennen!",}),"ruecken":({"Bis auf den Schauer kannst Du auf Deinen Ruecken nichts erkennen.","Hinter Deinem Ruecken scheint etwas zu sein.","Du moechtest gar nicht wissen, was sich hinter Deinem Ruecken abspielt.",}),"kopf":({"Wenn Du nicht sehr gut aufpasst, dann haut Dir eines der Lebewesen hier unten sicher den Kopf herunter.","Jeder grausame Schatten hier versucht, Dir Deinen Kopf zu stehlen.","Hier unten braucht man keinen Kopf, dafuer aber umso staerkere Muskeln.",}),"stein":({"Kahler, recht blanker Fels. Mehr ist es einfach nicht.","Die Steine hier sind sehr heiss. Man kann sie nicht anfassen.","Grosse Hitze wird vom Stein ausgestrahlt.",}),"decke":({"Die Decke verschwindet vollkommen in der Dunkelheit. Ertasten traust Du Dich aber nicht. Dazu ist Dir einfach zu mulmig.","Finster und ungeheuer kommt Dir die Decke vor. Als Du genauer hinsiehst, erkennst Du dicke Spinnen.","Decke kann man eigentlich schon nicht mehr dazu sagen. Ein Schauer laeuft an Dir herunter, als Du den ganzen Schleim siehst, der aus der Decke laeuft.",}),"wand":({"An einer Wand kannst Du ein paar Ueberreste sehen. In Panik schaust Du schnell weg.","Die Wand fuehlt sich kalt und rauh an. Nichts Besonderes kannst Du sehen.","Du tastest die Waende ab. In Panik hoerst Du auf, als Du ekligen Schleim entdeckst.",}),"spuren":({"Die Spuren an der Wand koennen nur von furchtbaren Gestalten stammen.","Kratzige Spuren sind quer ueber die Waende verteilt. In Panik betest Du kurz und hoffst, das verantwortliche Lebewesen nicht zu treffen.","Lebewesen wie Du koennen solch tiefe Spuren nicht in der Wand hinterlassen.",}),"form":({"Der Schleim scheint genau Deine Form anzunehmen.","Du erschrickst fuerchterlich, als der Schleim genau Deine Form annimmt.","Undefinierbar meinst Du und wendest Dich schon fast gelangweilt ab. Doch dann auf einmal kommt es. Das Grauen, die Angst vor dem was es sein koennte.",}),"schleim":({"Oerkz. Dickfluessiger, gruener Schleim haengt hier rum und starrt Dich an. Er blubbert scheinbar recht harmlos vor sich hin. Doch auf einmal scheint er kurzzeitig eine Form anzunehmen.","Baeh, dicker Schleim sabbert Dich an und macht Dich dreckig. Seine Form scheint Dich an etwas zu erinnern. Du schlabberst kurz in dem Schleim herum, findest aber nichts.","Pfui. Ein paar tote Spinnen haben sich in dem Schleim verfangen und verbreiten einen nicht so tollen Geruch. Der Schleim scheint die toten Spinnen so langsam aufzuloesen. Es waere fast so, als ob der Schleim tatsaechlich saeurehaltig ist.",}),"gestein":({"Das Gestein erscheint ganz normal. Aber es scheint halt nur so.","Scheinbar ist das Gestein ganz normal. Aber sicher bist Du Dir nicht.","Dunkles Gestein liegt hier ueberall herum. Zu wertlos, um es mitzunehmen.",}),"ort":({"Die Unterwelt ist ein Ort der Dunkelheit. Vieles hier ist nicht so, wie Du es gewohnt bist.","Du hast noch nie vorher einen so furchteinfloessenden Ort gesehen. Irgendwie moechtest Du diesen Ort so schnell wie moeglich verlassen.","Dieser Ort ist nicht geschaffen fuer Dich. Alles hier moechte Dich gerne verschlingen und zerstoeren.",}),"gefahr":({"Die Gefahr hier unten ist einfach gigantisch gross.","Es gibt wohl keine Region, die soviel Gefahr ausstrahlt, wie die Unterwelt. Du zitterst und schlotterst und fuehlst Dich gar nicht wohl.","Blass wirst Du, als Du an die Gefahr denkst. Du hoffst, dass nicht jede Region so ist, wie die Unterwelt.",}),"waende":({"Alle Waende sind total kalt. Erstaunlich eigentlich, denn die Luft ist sehr heiss hier.","Die Waende scheinen Dich zu erdruecken. Voller Angst blickst Du immer wieder zu den Waenden.","Pfui, dicker Schleim trieft die Waende herunter.",}),"boden":({"Viele Lebewesen sind hier wohl noch nicht ueber den Boden gegangen.","Dreck macht sich ueberall breit und Du moechtest eigentlich auch nicht lange verweilen.","Der Boden ist einfach nur aus normalen Fels. Oder etwa nicht?",}),"gefuehl":({"Das Gefuehl von Angst steigt in Dir auf und Du bist Dir schon lange nicht mehr sicher, ob es eine gute Idee war, hierher zu gehen.","Die Idee, dass Dein Gefuehl Dir sagen koennte: 'Geh hier weg', hattest Du wohl leider nicht.","Angst, Angst, Angst. Das ist das einzige Gefuehl, das Du hast.",}),"biegung":({"Ob hier wirklich eine ist, das siehst Du an den Ausgaengen.","War da nicht eine Kreatur hinter der naechsten Biegung?","Was Dich wohl hinter der naechsten erwartet? Das Boese vielleicht?",}),"lebewesen":({"Lebewesen wie Du trauen sich nur selten hier nach unten. Aber das bedeutet nicht, dass es hier unten keine gibt. Ueberall gibt es Anzeichen fuer andere Lebewesen. Doch begegnen moechtest Du ihnen eigentlich nicht.","Viele Anzeichen fuer Lebewesen findest Du nicht. Eigentlich nur Deine eigenen. Oder etwa nicht? Ohoh, Du weisst es nicht mehr.","Nur total finstere Lebewesen koennen hier unten ueberleben. Du gehoerst aber nicht dazu!",}),"atmosphaere":({"Die Atmosphaere hier laesst Dich in Furcht erbleichen.","Du wuerdest lieber wieder die Unterwelt verlassen. Ein unwohles Gefuehl kommt in Dir auf. Diese Atmosphaere gefaellt Dir ueberhaupt nicht.","Wie es in der Unterwelt nicht anders zu erwarten ist, ist die Atmosphaere hier sehr angespannt und gruselig.",}),"boese":({"Das Boese lauert hier ueberall. Hinter jeder Biegung lauert hier die Gefahr, dass Dich eine Kreatur des Boesen ueberfaellt und zerstueckelt.","Das Boese an sich ist nicht zu sehen. Aber Du bist Dir sicher, wenn Du noch tiefer hinunter gehst, dann wirst Du es leibhaftig sehen.","Jede Biegung, jede Kreatur verkoerpert hier das Boese.",}),"zweifel":({"Grosse Zweifel kommen in Dir auf. Du beschliesst, umzudrehen.","Die Zweifel in Dir werden immer groesser und groesser. Umkehren solltest Du.","Willst Du nicht lieber umdrehen? Die Zweifel in Dir zerfressen Dich.",}),"dreck":({"Als Du genau hinsiehst, bemerkst Du, dass der 'Dreck' eigentlich viele winzige Wuermer sind, die sich unablaessig bewegen, hin und her winden und anscheinend andauernd fressen.","Dreck? Du siehst hier keinen Dreck. Viele tausend Wuermer nagen hier unablaessig vor sich hin. Ein kalter Schauer rinnt an Dir herunter.","Du bueckst Dich und musst Dich uebergeben. Der Boden ist ueber und ueber mit Wuermern besetzt. Deshalb fuehlte sich der Boden wohl auch so weich und glitschig an. Du ekelst Dich.",}),"idee":({"Die Idee, hierher zu kommen, war eine der schlechtesten, die Du jemals hattest.","Du hast nicht die geringste Idee, was Dich in die Unterwelt getrieben hat. Jedenfalls moechtest Du so schnell wie moeglich raus hier.","Du hast keine Idee, was Dich hier noch alles erwartet. Aber das moechtest Du eigentlich auch nicht wissen. Denn es ist sicher nicht schmerzfrei.",}),"ueberreste":({"An der Wand haengen die Ueberreste einer zerstoerten Kreatur. Dich ekelt es.","Du schaust Dir die Ueberreste nur kurz an, denn dann uebergibst Du Dich und wendest Dich ab.","Ekelhafte Ueberreste kleben an der Wand. Du traust Dich nicht naeher ran, denn sie scheinen noch zu zucken.",}),"muskeln":({"Du brauchst schon starke Muskeln um hier unten zu ueberleben.","Nicht nur Muskeln sind hier wichtig, aber das weisst Du ja wohl.","Du spannst kurz Deine Muskeln an. Zu wenig denkst Du Dir und zitterst.",}),"fels":({"Woraus der Fels gemacht ist kannst Du nicht sagen. Aber er ist tiefschwarz.","Dieser Fels ist so schwarz, dass Dir echt mulmig wird. Was sich wohl hinter diesem Fels verbirgt?","Unglaublich maechtig baut sich der Fels vor Dir auf. Nur das Boese selber kann es schaffen, diesen Fels zu spalten.",}),"felsen":({"Die Felsen haengen tief von der Decke herunter. Groessere Lebewesen koennten hier nicht ueberleben.","Die Felsen sind aalglatt und haengen furchterregend herunter.","Aus dunklem Gestein sind die Felsen, die Dich zu erdruecken drohen.",}),"wuermer":({"Diese Wuermer sind so unsagbar eklig, dass Du Dich am liebsten uebergeben wuerdest. Sie fressen alles, was sie sehen, sei es ein Stein oder ein anderer Wurm. Wahrscheinlich wuerden sie auch Dich, wenn Du Dich auf den Boden legen wuerdest, langsam auffressen.","Superviele ekelhafte Wuermer kriechen auf dem Boden herum. Du hast sie zuerst gar nicht erkannt. Aber jetzt uebergibst Du Dich deshalb. Die Wuermer fressen einfach alles auf. Selbst Dich wuerden sie fressen.","Hier haben die Wuermer schon fast alles aufgefressen und wandern langsam ab. Ein kleiner Wurm hat sich aber schon auf Dich bewegt und ein paar Wuermer folgen ihm. Besser Du gehst schnell weiter, bevor sie Dich wirklich anknabbern!",}),"dunkelheit":({"Es ist hier unsagbar finster. Nur manche Gaenge haben seltsamerweise ein wenig Licht.","Die Dunkelheit verschluckt fast jedes Licht. Die Waende saugen einfach alles auf. Selbst die Decke schluckt vieles vom Licht.","Nur sehr langsam kannst Du Dich an die staendige Dunkelheit hier unten gewoehnen.",}),"kreatur":({"War da nicht gerade eine? Oder spielen Dir Deine Nerven schon Streiche?","Die Kreaturen des Boesen sind schlimmer als alles andere. Sei froh, wenn Du keiner Kreatur hier unten begegnest.","Irgendetwas oder -jemand scheint hinter Dir zu stehen. Aus Angst schaust Du aber nicht nach, ob das jetzt stimmt oder doch nicht.",}),"koerper":({"Dein ganzer Koerper straeubt sich gegen alles hier unten.","Kaum einen klaren Gedanken kannst Du formen. Dein Koerper gehorcht Dir fast nicht mehr.","Du zitterst am ganzen Koerper, obwohl die Hitze hier unten fast unertraeglich ist.",}),"gedanken":({"Du stellst Dir vor, auf wieviele verschiedene Arten man hier unten sterben kann. Dir wird ganz schlecht dabei und Du musst Dich fast uebergeben.","Um in Gedanken zu versinken, ist hier kaum die Zeit. Aber Du bist Dir sicher, dass Du hier niemals lange zum Nachdenken haben wirst.","Deine Gedanken sind so wirr, dass Du nicht einen klaren Gedanken fassen kannst.",}),"kreaturen":({"War da nicht gerade eine? Oder spielen Dir Deine Nerven schon Streiche?","Die Kreaturen des Boesen sind schlimmer als alles andere. Sei froh, wenn Du keiner Kreatur hier unten begegnest.","Irgendetwas oder -jemand scheint hinter Dir zu stehen. Aus Angst schaust Du aber nicht nach ob das jetzt stimmt oder doch nicht.",}),"nerven":({"Deine Nerven liegen eindeutig frei.","Deine Nerven halten es hier unten nicht mehr aus.","Gleich platzen Deine Nerven.",}),"gang":({"Der Gang, in dem Du stehst, floesst Dir unglaublich viel Angst ein.","Nur das Boese selber ist wohl faehig genug, solch gigantische Gaenge zu erschaffen.","Heisse Luft umstroemt Dich und Du spuerst das wahrhaft Boese ueberall.",}),"anzeichen":({"Die Anzeichen sind eindeutig. Hier hausen boese Lebewesen.","So direkt sind sie nicht zu erkennen. Du kannst sie aber genau spueren.","Du fuehlst Lebewesen und kannst auch die Anzeichen sehen.",}),"boesen":({"Du spuerst die Manifestation des Boesen in diesen Gaengen ueberall.","Das Boese wohnt hier unten. Aengstlich drehst Du Dich laufend um.","Sehen kannst Du das Boese hier nicht, aber spueren.",}),"boeses":({"Du spuerst die Manifestation des Boesen in diesen Gaengen ueberall.","Das Boese wohnt hier unten. Aengstlich drehst Du Dich laufend um.","Sehen kannst Du das Boese hier nicht, aber spueren.",}),"gewalt":({"Die Gewalt des Boesen ist so unglaublich hoch. Sie kann Dich einfach so zerfressen und zerstoeren.","Du kannst Dir die Gewalt gar nicht richtig vorstellen, so riesig ist sie.","Irrsinnig gross ist die Gewalt des Boesen. Es kann einfach alles vernichten, auch Dich.",}),"wurm":({"Jeder Wurm ist eklig. Manche sind schwarz, manche grau, manche weiss und dabei leicht durchscheinend. Sie glaenzen feucht und glitschig. Ausserdem verbreiten die Wuermer einen furchtbar grauslichen Geruch. Wenn es nur ein einziger Wurm waere, dann wuerde man ihn nicht einmal beachten. Doch alleine da, wo Du stehst, befinden sich zehntausende von ihnen.","Jeder einzelne Wurm ist in sich nicht schlimm. Aber soviele Wuermer wie hier herumschleimen, das ist schon sehr eklig. Du stellst Dir vor wie es waere, wenn Dich diese Wuermer langsam aber sicher auffressen wuerden.","Ein Wurm ist an Dir heraufgeklettert. Er ist klein, feucht und glitschig. Auuuaaaa. Der Wurm hat Dich doch glatt gebissen. Er scheint ziemlich aggressiv zu sein und frisst wohl wirklich alles, was er erwischen kann.",}),"arten":({"Das muessen hunderte sein.","Wieviele verschiedene Arten Du wohl finden wirst?","Eigentlich moechtest Du ja gar nicht alle kennenlernen.",}),"grauen":({"Das unbeschreibliche Grauen steigt in Dir auf. Panikartig schaust Du Dich um. Doch da war nichts. Oder etwa doch? Zweifel ueberkommen Dich und Du weisst nicht mehr, was Du machen sollst.","Der Zweifel an der Unterwelt waechst und waechst. Grauen, Grauen, das ist, was Dich hier staendig beschaeftigt.","Gruselig und unheimlich ist es hier. Grauenhaft ist einfach alles hier. Jede Wand, jeder Boden, alles macht Dich fertig und Du weisst nicht mehr, was Du dagegen machen sollst.",}),"schauer":({"Eiskalter Schauer laeuft Dir Deinen Ruecken hinunter. War da nicht gerade etwas, vor dem man fluechten sollte?","Dein Ruecken fuehlt sich nicht gut an, als ein grausamer Schauer auf ihm herunterfliesst. Deine Gedanken kreisen um 'Tod' und 'Sterben'...","Deine Gedanken stocken, als Dich ein fieser Schauer durchfaehrt.",}),"panik":({"Deine Panik wird immer und immer groesser. Schweiss rinnt an Dir hinunter und Du kannst kaum noch richtig denken.","Schweiss durch Panik hervorgerufen laeuft an Dir runter. Du schaust Dich schon wieder um, doch da ist immer noch nichts. Oder doch?","Panik Panik!!! Panik hast Du und davon nicht zu wenig!",}),"gaenge":({"Vielleicht hat jemand furchtbar heisse Luft hereingeblasen, die allein durch ihre Hitze diese Gaenge in den Fels geschmolzen hat.","Schauerlich heisse Luft weht in den Gaengen hier. Der Fels ist fast zu heiss, um ihn anzufassen.","Die Luft in diesen Gaengen ist durch die unertraegliche Hitze kaum vernuenftig einzuatmen. Auch die Felsen rings um Dich herum bersten fast unter der drueckenden Hitze.",}),"unbekannten":({"Du hast sehr viel Angst, das steht fest. Umkehren ist das, was Du machen solltest.","Was Dich wohl ausser grosser Angst hier unten erwartet?","Die Angst vor dem Unbekannten macht Dich fast panisch.",}),"furcht":({"Die 'Furcht' ist noch viel zu milde ausgedrueckt. Du zitterst am ganzen Koerper und traust Dich kaum weiter.","Obwohl es hier so warm ist, laesst die Furcht einen kalten Schauer durch Deinen Koerper gleiten.","Du fuerchtest Dich sehr vor dem, was Dich hier unten noch erwartet.",}),"verderben":({"Dein Verderben war es, in die Unterwelt zu gehen.","Das Verderben liegt nahe vor Dir, naemlich genau hier.","Gefahr und Verderben sind hier ueberall. Du kannst ihm nur entkommen, wenn Du ganz schnell die Unterwelt verlaesst.",}),"manifestation":({"Das Boese manifestiert sich hier einfach ueberall.","In jedem Stein, in jeder Kreatur sitzt hier das Boese. Du kannst einfach nicht mehr davor fluechten.","Die Manifestation macht sich hier ueberall bemerkbar. Du hast panische Angst vor dem, was noch kommen wird und dem, was hier ist.",}),"dunkelheit/dunkelelf":({"Es ist hier unsagbar finster. Nur manche Gaenge haben seltsamerweise ein wenig von diesem widerlichen Licht.","Die Dunkelheit verschluckt fast jedes Licht. Die Waende saugen einfach alles auf. Selbst die Decke schluckt vieles vom Licht.","In der Dunkelheit fuehlst Du Dich so richtig wohl.",}),"spinnen/dunkelelf":({"Spinnen! Du liebst Spinnen!.","Eine der Spinnen schaut Dich an und will Dich wohl anspringen. Aber sie laesst von Dir ab und laesst Dich einfach so stehen. Vermutlich weil Du ein Dunkelelf bist.","Die Spinnen hier sind sicherlich giftig. Du siehst wie sich die Spinnen sogar gegenseitig auffressen.",}),"spinne/dunkelelf":({"Spinnen! Du liebst Spinnen!.","Eine der Spinnen schaut Dich an und will Dich wohl anspringen. Aber sie laesst von Dir ab und laesst Dich einfach so stehen. Vermutlich weil Du ein Dunkelelf bist.","Die Spinnen hier sind sicherlich giftig. Du siehst wie sich die Spinnen sogar gegenseitig auffressen.",}),"gestalten;gestalt":({"Boese, dunkle Gestalten treiben sich in der Unterwelt herum. Diese Gestalten wuerden Dich wohl am liebsten sofort umbringen oder auffressen.","Finstere Gestalten lauern hier ueberall und warten nur darauf, Dich zu zerstueckeln.","Miese und hinterhaeltige Gestalten und Kreaturen warten nur auf Dich. Geh ruhig weiter und sie werden Dich schon erwischen!",}),"anspannung":({"Du kannst Dich kaum noch bewegen, so angespannt bist Du.","Was Dich wohl in dem naechsten Gang erwartet?","Du hast Angst. Und davon nicht wenig.",}),"unterwelt/dunkelelf":({"Es gibt nur einen Ort, an dem es so finster und dunkel ist: Die Unterwelt.","Hier ist es so finster und dunkel, dass sich nur wenige in die Unterwelt trauen.","Die Unterwelt ist das Grauen in sich. Hier fuehlst Du Dich wohl.",}),"seiten;seite":({"Von der Seite grinst Dich eine duestere Gestalt an.","Grauen kommt in Dir auf, als Du eine Gestalt an Deiner Seite zu sehen glaubst.","Es gibt hier unten nur boese Seiten, Du kannst keine guten Seiten erkennen.",}),"unbekanntes":({"Du hast sehr viel Angst, das steht fest. Umkehren ist das, was Du machen solltest.","Was Dich wohl ausser grosser Angst hier unten erwartet?","Die Angst vor dem Unbekannten macht Dich fast panisch.",}),"licht/dunkelelf":({"So gut wie kein Licht gibt es hier. Herrlich!.","Gesegnet sei die Dunkelheit.","Hier koennte es ruhig ein wenig dunkler sein.",}),])
npcs (["schatten":"/d/unterwelt/basics/central/npc/schatten";({"00+05-15","00-03-12","00-07-06",}),"ratte":"/d/ebene/ronja/feenquest/npc/ratte";({"00-01-13","00-08-03","00+00-09","00+07-02","00+08+07","00-01+11","00-10+16","00-10+12",}),"gnom":"/d/unterwelt/basics/central/npc/gnom";({"00+05+05","00+07+02","00+07+05",}),"skelett":"/d/unterwelt/basics/central/npc/skelett";({"00-02-15","00+01-12","00+02-08","00+07+00","00+07+00","00-01+12","00-01-06","00-05+06","00-05-09","00-08+01","00-09+12","00-15+12",}),"nekromant":"/d/unterwelt/basics/central/npc/nekromant";({"00-16+12","00-19+09",}),"spinne2":"/d/unterwelt/basics/central/npc/spinne2";({"00-02-15","00-01-06","00+05+05","00+11+12",}),"drow":"/d/unterwelt/zordan/dhrkion/npc/drow";({"00+07+00","00-04-10","00-10+12","00+00-07",}),"grotter":"/d/ebene/ronja/feenquest/npc/grotter";({"00-01-13",}),"swesen":"/d/unterwelt/basics/central/npc/swesen";({"00+00-13","00-07+00",}),])
listener ({"ronja",})
