#include "../def.h"

inherit "std/weapon";

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Gnompickel");
  SetProp(P_LONG,
    "Ein normaler Pickel, wie Gnome ihn verwenden, wenn sie Erz abbauen. "
    "Die Spitze besteht aus gehaertetem Stahl, aber der Rest ist von "
    "minderer Qualitaet."
  );

  SetProp(P_NAME, "Gnompickel");
  SetProp(P_GENDER, MALE);
  AddId( ({"pickel", "gnompickel"}) );

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 125);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_BRONCE:80, MAT_STEEL:20 ]) );
  SetProp(P_WEIGHT, 1700);
  SetProp(P_VALUE, 700);

}


