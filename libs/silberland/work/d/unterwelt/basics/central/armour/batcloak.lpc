#include "../def.h"

inherit "std/armour";

int flying;

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Ein Fledermausumhang");
  SetProp(P_LONG,
    "Ein Umhang aus riesigen Fledermausfluegeln zusammengeschneidert. "
    "Warm ist er nicht, aber er schaut ganz brauchbar aus. Ausserdem "
    "schillert er irgendwie magisch."
  );

  SetProp(P_INFO, 
      "Der Fledermausumhang schuetzt ein wenig vor Unheiligem.\n"
      "Der Fledermausumhang erlaubt Dir das Fliegen.\n");
  SetProp(P_NAME, "Fledermausumhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang", "fledermausumhang"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_SKIN:80, MAT_BONE:20 ]) );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 3000);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_UNHOLY:3]) );
  SetProp(P_DEFEND_FUNC, TO);
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:0, T_HEAT_PROT:0 ]) );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);

}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  if(member(dtyp, DT_UNHOLY) > -1)
    return 10+random(50);
}

int WearFunc(object ruest, int silent)
{
  if(!MENV->is_class_member(CL_FLYING))
  {
    flying = 1;
    MENV->AddClass(CL_FLYING);
    tell_object(MENV, 
        "Mit Hilfe des Fledermausumhangs kannst Du nun fliegen!\n");
  }
  return 1;
}

int RemoveFunc(object ruest, int silent)
{
  if(flying)
  {
    QueryProp(P_WORN)->RemoveClass(CL_FLYING);
    flying = 0;
  }
  return 1;
}
