#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Ein Chitinpanzer");
  SetProp(P_LONG,
    "Ein leichter und stabiler Panzer aus Chitin. Er duerfte einmal "
    "einem grossen Insekt oder einem Riesenhummer oder etwas aehnlichem "
    "gehoert haben. An der Innenseite kleben noch die Rueckstaende "
    "seines ehemaligen Besitzers..."
  );

  SetProp(P_NAME, "Chitinpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "chitinpanzer"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, ([ MAT_CHITIN:100 ]) );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 4000);
  SetProp(P_NOBUY, 1);
}
