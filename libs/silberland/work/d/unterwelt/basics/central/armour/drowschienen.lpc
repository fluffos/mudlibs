/*
** Boese Armschienen
** ---
** Urspruenglich Dunkeltrollumhang von Woody, macht jedoch nur -1 beim tragen...
** Idlefunktion brauchen wir nicht, is ja nur -1, dafuer mp-abzug
** keine Defendfunc mehr
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <class.h>
#include "../def.h"

#define MP 15

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Obsidianarmschienen");
  SetProp(P_LONG,
	  BS("In Deinen Haenden haeltst Du wahre Meisterarbeit! Noch nie "
	     "hast Du solch ein vollendetes Ruestungsteil gesehen. Kunstvoll "
	     "geritztes Obsidian mit je einer silbernen Spinne auf der "
	     "Oberseite der Armschienen. Eine Aura des Boesen scheint sie "
	     "zu umgeben."));
  SetProp(P_NAME, "Obsidianarmschienen");
  AddId(({"armschienen","obsidianarmschienen"}));
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 666);
  SetProp(P_LIGHT, 0);          // Erst beim Anziehen verdunkeln
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_REMOVE_FUNC, this_object());
  SetProp(P_WIELD_RESTRICTIONS, ([SR_GOOD:0,SR_EXCLUDE_RACE:({"Zwerg","Fee"})]));
  SetProp(P_ARMOUR_TYPE, AT_BRACERS);  // siehe sys/combat.h
  SetProp(P_AC, 7);
  SetProp(P_MAGIC, 1);
  SetProp(P_INFO,
	  BS("Der Traeger dieser Armschienen, soll angeblich in Dunkelheit "
	     "getaucht werden..."));
  SetProp(P_MATERIAL, ([MAT_OBSIDIAN:90,MAT_SILVER:5,MAT_EMERALD:5]));

  AddDetail(({"meisterarbeit","arbeit"}), QueryProp(P_LONG));
  AddDetail(({"ruestung","ruestungsteil"}),
	    "Noch nie hast Du so eine vollkommene Ruestung gesehen!\n");
  AddDetail("obsidian",
	    "Nur das kostbarste und reinste Obsidian wurde fuer diese "
	    "Armschienen verwendet.\n");
  AddDetail(({"oberseiten","oberseite"}),
	    "Auf den Oberseiten schlingt sich je eine Spinne aus reinem "
	    "Silber um die Armschienen.\n");
  AddDetail(({"unterseite","unterseiten"}),
	    "Die Unterseiten sind nicht so kunstvoll verziert.");
  AddDetail(({"spinne","spinnen","silber"}),
	    "Kunstvoll gefertigte Spinnen aus purem Silber schlingen sich je "
	    "um die Armschienen.\n");
  AddDetail(({"aura des boesen","aura"}),
	    "Die Obsidianarmschienen scheinen wirklich von einer Aura des "
	    "Boesen umgeben zu sein!\n");
}

private nosave void EsWird(object pl, string was)
{
  mixed u;
  int i;

  if(!objectp(pl)) return;
  if(!environment(pl)) return;
  if(!interactive(pl)) return;
  u=all_inventory(environment(pl));
  u=filter_array(u,CLOSURE(living));
  for(i=sizeof(u)-1; i>=0; i--)
    if(!u[i]->CannotSee(1))
      tell_object(u[i], "Deine Umgebung "+was+".\n");
}

nosave void SetMyLight(object pl, int x)
{
  if(!pl) x=0;         // Sicherheitsmassnahme...
  SetProp(P_LIGHT, x);
  if(x<0) EsWird(pl,"verdunkelt sich"); 
  else EsWird(pl,"scheint heller zu werden");
}

int WearFunc(object ruest, int silent)
{
  while(remove_call_out("SetMyLight")!=-1);
  call_out("SetMyLight", 2, this_player(), -1);
  return 1;
}

int RemoveFunc(object ruest,int silent)
{
  while(remove_call_out("SetMyLight")!=-1);
  call_out("SetMyLight", 2, this_player(), 0);
  return 1;
}

void reset()
{
  object pl;
  
  ::reset();

  if(!objectp(pl=QueryProp(P_WORN)))
    SetProp(P_LIGHT, 0);    
  else 
    if(interactive(pl))
      {
	tell_object(pl, BS("Ein Teil Deiner Macht geht in Deine Armschienen "
			   "ueber!"));
	pl->AddSp(-MP);
      }
}

