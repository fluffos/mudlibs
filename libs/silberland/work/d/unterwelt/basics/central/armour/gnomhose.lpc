#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Die Hose eines Gnoms");
  SetProp(P_LONG,
    "Eine ziemlich gewoehnliche Hose, wie Gnome sie tragen. "
    "Aber auch groessere Wesen, wie Menschen oder Elfen koennen sie "
    "bequem benutzen, da sie sehr elastisch ist, und sich den Koerperformen "
    "perfekt anpasst. Vorne, da wo man am empfindlichsten ist, wurde sie "
    "durch viele stabile Eisenplaettchen verstaerkt."
  );

  SetProp(P_NAME, "Gnomhose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose", "gnomhose"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_LEATHER:80, MAT_IRON:20 ]) );
  SetProp(P_WEIGHT, 180);
  SetProp(P_VALUE, 1200);
}

