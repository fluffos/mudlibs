#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Ein Paar Gnomarmschienen");
  SetProp(P_LONG,
    "Die Armschienen der Gnome haben hauptsaechlich den Zweck, die "
    "Unterarme vor herumsplitterndem Gestein zu schuetzen, wenn man einen "
    "Felsen auf der Suche nach Erzen zertruemmert. Aber auch Schwerthiebe "
    "kann man damit vielleicht manchmal abblocken. Mit Lederriemen "
    "bindet man die Armschienen fest."
  );

  SetProp(P_NAME, "Paar Gnomarmschienen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schienen", "armschienen", "gnomarmschienen"}) );

  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([ MAT_LEATHER:10, MAT_STEEL:90 ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 900);
}

