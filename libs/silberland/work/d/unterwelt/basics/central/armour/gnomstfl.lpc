#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Ein Paar Gnomstiefel");
  SetProp(P_LONG,
    "Die Stiefel eines Gnoms. Deine Fuesse sind etwas gross dafuer, aber "
    "naja, sie sind brauchbar. "
  );

  SetProp(P_NAME, "Paar Gnomstiefel");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"stiefel", "gnomstiefel"}) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 200);
}

