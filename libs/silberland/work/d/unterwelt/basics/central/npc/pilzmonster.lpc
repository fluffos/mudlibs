#include "../def.h"

inherit "std/npc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Das Pilzmonster");
  SetProp(P_LONG,
    "Ein grosser Pilz steht vor Dir. Er scheint hoechst lebendig zu sein "
    "und ist anscheinend ueber Deine Anwesenheit hier nicht erfreut, weil "
    "Du eine Gefahr fuer seine vielen kleinen Kinder, die er hier behuetet, "
    "darstellst. Bewegen kann sich der Pilz nur eingeschraenkt, da er am "
    "Boden mit seinem Myzel fest verwurzelt ist. Seine vielen Tentakel, die "
    "aus seinem Strunk und ueberall aus dem Pilzgeflecht im Boden "
    "hervorwachsen, machen diesen Nachteil jedoch wieder wett."
  );

  SetProp(P_NAME, "Pilzmonster");
  SetProp(P_GENDER, NEUTER);
  AddId(({"monster", "pilzmonster" }));
  set_living_name("pilzmonster");

  SetProp(P_SMELL, "Das Pilzmonster riecht intensiv nach Fliegenpilz.\n");

  create_default_npc(45);
  SetProp(P_HANDS, ({" mit hunderten Myzeltentakeln",QueryProp(P_HANDS)[1],
     DT_BLUDGEON }));
  SetProp(P_RACE, "Pilz");
  SetProp(P_SIZE, 230);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 200);
  SetProp(P_HEAL, -500);
  SetProp(P_AGGRESSIVE, 0.5);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_ACID:1.5, DT_POISON:-1, DT_WATER:-0.5, DT_FIRE:-0.5,
       DT_MAGIC:-0.5, DT_COLD:-0.5, DT_LIGHT:0.4, DT_LIGHTNING: -0.5,
       DT_TERROR: 0.2, DT_SLASH: 1, DT_PIERCE: 0.25, DT_RIP: 1 ]));
  SetProp(P_NOMAGIC,0);
  SetProp(P_MATERIAL, MAT_MUSHROOM);

  SetProp(P_MSGIN, "waechst aus dem Boden");
  SetProp(P_MSGOUT, "waechst");
  SetProp(P_MMSGIN, "waechst aus dem Boden");
  SetProp(P_MMSGOUT, "zieht sich in den Boden zurueck");

  SetProp(P_DIE_MSG,  " verpufft in einer riesigen Sporenwolke.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG,
     "Eine meiner 470938436553238 Sporen wird mich raechen, %s!");
  SetProp(P_KILL_MSG, "Ha! Auf Deinem Kadaver werde ich wachsen und gedeihen!");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));

  AddInfo(DEFAULT_INFO, "hat keine Ohren. Es hoert Dich nicht.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Pilzmonster interessiert sich nicht dafuer.\n" }) );

  SetProp(P_SPELLRATE,60);

  AddSpell(1,500,
    "Das Pilzmonster huellt Dich in eine Sporenwolke ein.\n",
    "Das Pilzmonster huellt @WEN in eine Sporenwolke ein.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,300,
    "Das Pilzmonster wuergt Dich mit seinen Tentakeln.\n",
    "Das Pilzmonster wuergt @WEN mit seinen Tentakeln.\n",
     DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,150,
    "Das Pilzmonster vergiftet Dich mit seinen Sporen.\n",
    "Das Pilzmonster vergiftet @WEN mit seinen Sporen.\n",
     DT_POISON, "gift_spell", ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,100,
    "Das Pilzmonster schiesst Dir ein paar Sporen in die Augen.\n",
    "Das Pilzmonster schiesst @WEM ein paar Sporen in die Augen.\n",
     DT_PIERCE, "blind_spell",([SP_SHOW_DAMAGE:1]));

  SUID;

}

void gift_spell(object enemy, int damage, mixed dam_type)
{
  enemy->AddPoison(random(5));
}

void blind_spell( object enemy, int damage, mixed dam_type)
{
  if(random(100) > 80)
  {
    tell_object(enemy, "Du bist blind!\n");
    enemy->SetProp(P_BLIND, 300);
  }
}

varargs void die(int poisondeath)
{
  object enemy, *liv;
  int i;

  if(enemy=QueryProp(P_KILLER))
    WRITELOG(CAP(Name(WER,1))+" wurde von "+CAP(getuid(enemy))+" umgebracht");

  SetProp(P_KILL_NAME, "Eine gigantische Sporenwolke");

  liv=filter_array(all_inventory(environment(TO)),#'living) - ({TO});
  i = sizeof(liv);
  while(i--)
  {
    tell_object(liv[i], BS("Das Pilzmonster bricht toedlich getroffen auf. "
                           "Milliarden giftige Sporen quellen aus dem "
                           "aufplatzenden Koerper und huellen Dich "
                           "vollstaendig ein. Du bist vergiftet!"));
    liv[i]->AddPoison(3+random(4));
    liv[i]->do_damage(30+random(30));
  }

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)
    WRITELOG(Name(WER,1)+" hat gerade "+CAP(getuid(player))+
             " umgebracht (XP-Verlust : "+lostexp+")");

  return;
}

