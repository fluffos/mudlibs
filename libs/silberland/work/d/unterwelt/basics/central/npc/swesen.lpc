inherit "std/mnpc";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schwarzwesen");
  SetProp(P_LONG,
    "Ein Wesen der Dunkelheit. Gierige Augen leuchten in der Finsternis seines "
    "restlichen Koerpers und starren Dich boese an. Die genauen Umrisse des "
    "Monsters verschwimmen zwar mit den Schatten rings umher, aber irgendwie "
    "bist Du da auch froh darueber. Geh lieber schnell weg, bevor das "
    "Schwarzwesen Dich ergreift, zerreisst und frisst."
  );

  AddId(({ "wesen", "schwarzwesen" }));

  create_default_npc(27+random(2));

  SetProp(P_HANDS, ({" mit seinen Klauen", QueryProp(P_HANDS)[1], DT_SLASH }));
  SetProp(P_RACE, "Monster");
  SetProp(P_NAME, "Schwarzwesen");
  SetProp(P_SIZE, 250+random(100));
  SetProp(P_ALIGN, -900);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_AGGRESSIVE, 0.01);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "taucht aus der Dunkelheit auf");
  SetProp(P_MSGOUT, "verschwindet# in der Dunkelheit");
  SetProp(P_MMSGIN, "taucht aus der Dunkelheit auf");
  SetProp(P_MMSGOUT, "verschwindet in der Dunkelheit");

  SetProp(P_MNPC_AREA, ROOM+"00");
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ENV(TO));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.8, DT_ELECTRIC:    0.0
     , DT_ACID:     -0.1, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.8, DT_UNHOLY:   -1.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_SPELLRATE,50);

  AddSpell(2,100,
    "Das Schwarzwesen verflucht Dich.\n",
    "Das Schwarzwesen verflucht @WEN.\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,150,
    "Das Schwarzwesen verbeisst sich in Dir.\n",
    "Das Schwarzwesen verbeisst sich in @WEM.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,450,
    "Eine dunkle Extremitaet saust ueberraschend auf Dich zu.\n",
    "Eine dunkle Extremitaet saust ueberraschend auf @WEN zu.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10, ({
    "Das Schwarzwesen kreischt.\n",
    "Das Schwarzwesen verschwindet und taucht ploetzlich woanders auf.\n",
    "Das Schwarzwesen wird beinahe unsichtbar.\n"}) );

}










