#include "../def.h"

inherit "std/npc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine winzige Spinne");
  SetProp(P_LONG,
    "Eine kleine, dunkel gezeichnete Spinne sitzt hier mitten am Boden. "
    "Ob die wohl giftig ist? Wenn nicht, stellt sie auf jeden Fall "
    "keine Gefahr dar bei dieser geringen Groesse..."
  );

  SetProp(P_NAME, "Spinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({ "winzige spinne", "spinne"}));

  create_default_npc(3);

  SetProp(P_HANDS, ({ " mit acht Beinen",30, ({DT_PIERCE, DT_POISON}) }));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 5);
  SetProp(P_ALIGN, -250);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " stirbt.\n");

  AddInfo(DEFAULT_INFO, " antwortet unhoeflicherweise nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Spinne ist viel zu klein, um sowas zu schleppen.\n" }) );

  SUID;

  if(!random(5)) CLONEME("/p/std/skills/sewing_tanning/obj/spinnenseide");
}
