inherit "std/mnpc";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp (P_SHORT, "Ein Biber");
  SetProp (P_LONG,
    "Ein kleiner, pechschwarzer Biber. Beinahe haettest Du ihn uebersehen. "
    "Was hat ihn blos dazu getrieben, seinen Wohnsitz hier am Saphirsee "
    "in der Unterwelt zu bauen?"
  );

  SetProp(P_NAME, "Biber");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));

  AddId(({"biber", "schwarzbiber"}));
  AddClass(CL_ANIMAL); // siehe /sys/class.h

  create_default_npc(7);

  SetProp(P_SIZE, 80);
  SetProp(P_WEIGHT, 6000);
  SetProp(P_HANDS, ({ " mit seinen scharfen Zaehnen", 70, DT_RIP }));

  SetProp(P_RACE, "Biber");
  SetProp(P_SIZE, 40);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 40);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_MNPC_DEFAULTROOM, ROOM "00-08+02");
  SetProp(P_MNPC_WAIT, ({ 10, 15, 15 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_MNPC_AREA, SEE_REGION);

  SetProp(P_MSGIN, "kommt aus dem See angeschwommen");
  SetProp(P_MSGOUT, "schwimmt# in den See hinaus");
  SetProp(P_MMSGIN, "kommt aus dem See angeschwommen");
  SetProp(P_MMSGOUT, "schwimmt hinaus in den See");

  AddInfo(DEFAULT_INFO, "ist nur an Daemmen interessiert.\n");

  SetProp(P_REJECT, ({ REJECT_DROP,
    Name(WER)+" schleppt lieber selbstgefaellte Baumstaemme.\n" }) );

  SetProp(P_SPELLRATE,20);

  AddSpell(1,90+random(11),
      "Der Biber erwischt Dich mit seinem Schwanz.\n",
      "Der Biber erwischt @WEN mit seinem Schwanz.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SUID;

  CLONEME("/d/ebene/obj/ruestung/biberfell");
  command("ziehe biberfell an");
}

void Flee(object oldenv)
{
  wandern();
}
