#include "../def.h"
#include <npcmaster.h>

inherit NPC "waechter_inh";

string *player;

string gib_schluessel(string str);

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Dunkelelfenwaechterin");
  SetProp(P_LONG,
    "Die Dunkelelfenwaechterin beschuetzt das Tor vor fremden Zugriffen. "
    "Sie scheint ziemlich aggressiv und recht stark zu sein. Au Backe, man "
    "hat ihr wohl die Zunge rausgeschnitten. Sie wird das Tor wohl mit ihrem "
    "Leben verteidigen und ist eine wahre Meisterin mit dem Langbogen."
  );

  SetProp(P_NAME, "Dunkelelfenwaechterin");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"dunkelelfenwaechterin","\ndunkelelfenwaechter", "dunkelelfin", "waechterin"}) );

  create_default_darkelf(14,20);
  SetProp(P_NO_SCORE, 1);
  SetProp(P_ALIGN, -650-random(100));

  AddInfo( ({"schluessel","torschluessel"}), #'gib_schluessel, "", 1);

  SetProp(P_SPELLRATE,75);

  AddSpell(1,210,
    Name(WER,1)+" spricht einen boesen Fluch ueber Dich aus.\n",
    Name(WER,1)+" spricht einen boesen Fluch ueber @WEN aus.\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1])
  );

  SUID;
  CLONEME("/d/unterwelt/zordan/dhrkion/armour/rock" );
  CLONEME(OBJ "torschluessel" );

  command_me("trage alles");
  command_me("zueck bogen");
  player = ({ });

  Customize();
}

void reset()
{
  ::reset();
  player = ({ });
}

string gib_schluessel(string str)
{
  object ob;

  if(!ENV(TO)) return "";
  if(InFight()) return "hat keine Zeit waehrend eines Kampfes zu diskutieren.";

  if(TP->QueryProp(P_RACE) != "Dunkelelf")
  {
    tell_room(ENV(TO),
      Name(WER)+" funkelt "+TP->Name(WEN)+" nur zornig an.\n", ({TP})
    );
    return "funkelt Dich nur zornig an!";
  }

  if(deep_present("\n_torschluessel",TP))
  {
    tell_room(ENV(TO),
      Name(WER)+" zeigt mit dem Finger auf "+TP->Name(WEN)+".\n", ({TP})
    );
    return "deutet auf Deinen Torschluessel!";
  }

  if(member(player,getuid(TP)) > -1)
  {
    return "zuckt resignierend mit den Schultern.";
  }

  ob = clone_object(OBJ "torschluessel");
  if(ob->move(TP,M_GET) != 1)
  {
    ob->remove();
    return "zuckt resignierend mit den Schultern.";
  }

  player += ({ getuid(TP) });
  tell_room(ENV(TO),Name(WER,1)+" gibt "+TP->name(WEM)+" etwas.\n", ({TP}) );
  return "gibt Dir einen Schluessel!";
}

