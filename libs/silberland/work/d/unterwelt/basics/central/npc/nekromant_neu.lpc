#include "../def.h"

inherit "std/mnpc";

#define ADJS ({"widerlich","ekelhaft","abstossend","verflucht","jaemmerlich"})

// mapping:id,size,weight


void debug(string msg)
{
  tell_object(find_player("ronja"),"XXX "+msg+" XXX\n\n\n");
}

void create()
{
  mapping race;
  string  raceid;

  string name, *temp, *adj;
  int gender,lv,glv;
  object cash;

  if (!is_clone(TO)) return;

  ::create();

  race =
    (["dunkelelf": "Dunkelelfen"   ;  195;  70000; "schleicht"
     ,"zwerg"    : "Zwergen"       ;  120;  75000; "geht"
     ,"mensch"   : "Menschen"      ;  175;  75000; "geht"
     ,"oger"     : "Oger"          ;  250; 200000; "stapft"
     ,"troll"    : "Troll"         ;  330; 350000; "trampelt"
     ,"hobbit"   : "Hobbit"        ;  100;  50000; "geht"
     ]);

  adj     = ADJS[random(sizeof(ADJS))];
  temp    = m_indices(race);
  raceid  = temp[random(sizeof(temp))];
  gender  = random(2) ? MALE:FEMALE;
  lv      = 15+random(15);
  glv     = lv-5+random(10);

  name    = race[raceid,0] + "nekromant" + (gender==MALE?"":"in");

  SetProp(P_NAME, name);
  SetProp(P_GENDER,gender);

  SetProp(P_NAME_ADJ, adj);
  AddAdjective( ({adj+"en",adj+"er",adj+"em",adj+"es",adj+"e"}) );

  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG,
    Name(WER,0)+". Hier hat wohl der Magier geschlampt, denn es ist keine "
    "Langbeschreibung vorhanden."
  );

  AddId( ({ (gender==MALE?"nekromant":"nekromantin"), LOWER(name), raceid }) );

  switch(raceid)
  {
    case "elf":       AddClass( ({ CL_ELF })     ); break;
    case "zwerg":     AddClass( ({ CL_DWARF })   ); break;
    case "mensch":    AddClass( ({ CL_HUMAN })   ); break;
    case "fee":       AddClass( ({ CL_FAIRY })   ); break;
    case "oger":      AddClass( ({ CL_OGRE })    ); break;
    case "troll":     AddClass( ({ CL_TROLL })   ); break;
    case "hobbit":    AddClass( ({ CL_HOBBIT })  ); break;
    case "dunkelelf": AddClass( ({ CL_DARKELF }) ); break;
  }

  create_default_npc(lv);

  SetProp(P_HANDS, ({" mit "+(gender==MALE?"seinen":"ihren")+" bleichen "
                     "Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_RACE,   CAP(raceid));
  SetProp(P_SIZE,   race[raceid,1]);
  SetProp(P_WEIGHT, race[raceid,2]);

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:50]));

  SetProp(P_ALIGN, -400-random(3)*150);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " bricht mit einem Fluch auf den Lippen zusammen.\n");
  SetProp(P_KILL_NAME, Name(WER,0));

  SetProp(P_GUILD, "nekromanten");
  SetProp(P_GUILD_LEVEL, glv);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:  -0.05*glv, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING:  0.0 , DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:   0.7/glv, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:     0.0 , DT_TERROR: -0.1*glv
     , DT_HOLY:  1.5/glv, DT_UNHOLY: -0.1*glv, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:       0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:     0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, race[raceid,3]);

  SetProp(P_MNPC_AREA, REGION4);
  SetProp(P_MNPC_WAIT, ({ 15, 40, 40 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "00-16+12");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES +
      MOV_BACKWARDS);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" darf das nicht nehmen.\n" }) );

     SetChats(10,
       ({"Verdammt noch einmal!"
        ,"In drei Teufels Namen!"
        ,"Bei allen Daemonen!"
        ,"Verflucht noch einmal!"
        ,"Zur Hoelle damit!"
        ,"Faeulnis und Verdammnis!"
        ,"Spinnenfrass und Eiterbeule!"
        ,"Bei den Niederhoellen!"
        ,"Verdammt sein alle Paladine!"
        ,"In der ewigen Verdammnis sollt ihr schmoren!"
        ,"Bei allen Niederhoellen!"
        ,"Bei der schleichenden Verdammnis!"
        ,"Verflucht in alle Ewigkeiten!"
        ,"Bei den vier Bestien!"
        ,"Verflucht sei alles Gute!"
        ,"Zombiefaeule und Mumienmoder!"
        ,"Bei allen Pestbeulen!"
        ,"Deamonendung!"
        ,"Bei Xarfai!"
        ,"Blutgierige Blutsaeufer!"
        ,"Bei allen Untoten!"
        ,"Bei der Macht der Untoten!"
        ,"Bei den Maechten der Finsternis!"
        }) );

  AddDefaultSpell(1, 8*lv, DS_BLIND,
    "Aus den Augen von "+name(WEM,1)+" schiessen zwei dunkle Strahlen genau auf Dich zu!\n",
    "Aus den Augen von "+name(WEM,1)+" schiessen zwei dunkle Strahlen genau auf @WEN zu!\n"
  );


  SUID;

  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(100)+50);
  cash->move(TO);

  CLONEME("/p/armour/ring/ring");
  CLONEME("/p/armour/boots/sandalen");

  CLONEME("/d/unterwelt/nekromanten/armour/kutte");

  if(QueryProp(P_GUILD_LEVEL)>5)
  {
    CLONEME("/d/unterwelt/nekromanten/weapon/blutpeitsche");
  }
  else
  {
    CLONEME("/d/unterwelt/nekromanten/weapon/peitsche");
  }

  command_me("zuecke peitsche");
  command_me("trage alles");

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == ME)
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde von einem Nekromant getoetet ("+lostexp+").\n");
}

