#include "../def.h"

inherit "/d/unterwelt/zordan/dhrkion/npc/drow";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_MNPC_AREA, ({ROOM+"00"}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "00-04-10");
}
