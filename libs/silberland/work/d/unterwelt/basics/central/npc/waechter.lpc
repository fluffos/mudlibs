#include "../def.h"

inherit NPC "waechter_inh";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Dunkelelfenwaechter");
  SetProp(P_LONG,
    "Der Dunkelelfenwaechter beschuetzt das Tor vor fremden Zugriffen. Einen "
    "besonders starken Eindruck macht er allerdings nicht. Au Backe, man hat "
    "ihm wohl die Zunge rausgeschnitten. Er wird Dir also keine Informationen "
    "liefern koennen. Er sieht ein wenig aggressiv aus."
  );

  SetProp(P_NAME, "Dunkelelfenwaechter");
  SetProp(P_GENDER, MALE);
  AddId( ({"dunkelelfenwaechter", "dunkelelf", "waechter"}) );

  create_default_darkelf(10,12);
  SetProp(P_ALIGN, -550-random(100));

  AddInfo(DEFAULT_INFO, "schaut Dich nur an.\n");

  SetProp(P_SPELLRATE,50);

  SUID;

  CLONEME("/d/unterwelt/zordan/dhrkion/armour/hose" );
  command_me("trage alles");
  command_me("zueck bogen");

  Customize();
}

