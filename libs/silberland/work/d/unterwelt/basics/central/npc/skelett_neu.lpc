inherit "/p/std/npc/skeleton";

#include "../def.h"

#define ADJS ({"klappernd","knirschend","modernd","zerfallend"})

void create()
{
  mapping race;
  string  raceid;

  string name, *temp, *adj, rang;
  int lv;
  object cash, weapon;

  if (!is_clone(TO)) return;

  ::create();

  race =
    (["dunkelelf": "Dunkelelfen"   ;  195;  70000
     ,"zwerg"    : "Zwergen"       ;  120;  75000
     ,"mensch"   : "Menschen"      ;  175;  75000
     ,"oger"     : "Oger"          ;  250; 200000
     ,"troll"    : "Troll"         ;  330; 350000
     ,"hobbit"   : "Hobbit"        ;  100;  50000
     ]);

  adj     = ADJS[random(sizeof(ADJS))];
  temp    = m_indices(race);
  raceid  = temp[random(sizeof(temp))];
  lv      = 10+random(11);
  rang = "";
  if(lv > 14) rang = "kaempfer";
  if(lv > 17) rang = "krieger";

  name    = race[raceid,0] + "skelett" + rang;

  SetProp(P_NAME, name);
  SetProp(P_GENDER, lv>14?MALE:NEUTER);
  SetProp(P_NAME_ADJ, adj);
  AddAdjective( ({adj+"en",adj+"er",adj+"em",adj+"es",adj+"e"}) );

  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG,
    Name(WER,0)+". Hier hat wohl der Magier geschlampt, denn es ist keine "
    "Langbeschreibung vorhanden."
  );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:80]));

  create_default_skeleton(lv);

  AddId(({"UWELTSKELETT"}));
  AddId( ({ LOWER(name), raceid }) );
  if(rang!="") {
    AddId( ({ rang }) );
    AddId( ({"Schwertexperte"}) );
  }

  SetProp(P_HANDS, ({" mit Knochenkrallen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_BODY, 150);
  SetProp(P_RACE, "Untot");
  SetProp(P_SIZE, 150+random(30));
  SetProp(P_ALIGN, -550);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_REJECT, ({ REJECT_DROP, Name(WER)+" laesst es fallen.\n" }) );
  SetProp(P_KILL_MSG, "*stampf* *hack* *nixlebengut*");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.5, DT_COLD:     -0.5, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:   -0.5, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:   -0.5, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:      -0.5
     ])
  );
/*
  SetProp(P_MNPC_AREA, ROOM+"00");
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "00+07+01");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES);
*/
  AddInfo(DEFAULT_INFO, "klappert nur mit seinen Knochen.\n");

  AddDetail( ({"flaemmchen"}),
    "Sie fuehren in den Augen einen wilden Tanz auf. Auesserst "
    "beunruhigend..."
  );

  SetProp(P_SPELLRATE, lv);
  AddSpell(20,250,
    "Das Skelett rammt seine Knochenfinger in Dich hinein.\n",
    "Das Skelett rammt seine Knochenfinger in @WEN hinein.\n");

  SUID;

  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, 70+random(70));
  cash->move(ME);

  CLONEME("/d/gebirge/angrox/obj/kettenhemd_rost");

  if(!random(3)) CLONEME("/p/std/skills/sewing_tanning/obj/stoffreste");

  command("trage kettenhemd");

  if(lv > 17) weapon=CLONEOB("/p/weapon/sword/breitschwert" );
  else if( lv > 14) weapon=CLONEOB("/p/weapon/sword/langschwert" );

  if(weapon)
  {
    weapon->TakeFlaw(10000);
    weapon->AddAdjective( ({ "rostigen", "rostiges", "rostiger" }) );
    weapon->SetProp(P_NAME_ADJ, ({ "rostig" }));
    weapon->SetProp(P_SHORT, "Ein rostiges "+Name(RAW));
    weapon->move(ME);
    command("zuecke schwert");
  }

}

int Defend(int dam, string dam_type, mixed spell, object enemy)
{
  if(enemy->id("\ndunkelelfenwaechter")) dam *= 5;
  return :: Defend(dam,dam_type,spell,enemy);
}

void init1(object pl)
{
  if(!ENV(TO))           return;
  if(!pl)                return;
  if(!living(pl))        return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, break_string("Was willst Du hier, Du armes Wuerstchen?",
                  78,"Das Skelett knirscht mit seinen Zaehnen: ",1));
  return;
}

void init2(object pl)
{
  if(!ENV(TO))           return;
  if(!pl)                return;
  if(!living(pl))        return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, break_string("Jetzt bist Du dran!",
              78,"Das Skelett knirscht mit seinen Zaehnen: ",1));
  Kill(pl);
  return;
}

void init()
{
  ::init();

  if(TP && interactive(TP) && !IS_WIZARD(TP))
  {
    if((TP->QueryProp(P_RACE) == "Dunkelelf") &&
       (TP->QueryProp(P_LEVEL) < QueryProp(P_LEVEL)))
    {
      call_out("init1",0,TP);
    }
    else
    {
      call_out("init2",0,TP);
    }
  }
}

string _query_long()
{
  string s;
  
  s="Ein voellig fleischlos"+(QueryProp(P_LEVEL)>14?"er ":"es ")+name(RAW)+". "
    +(QueryProp(P_LEVEL)>14?"Er":"Es")+" traegt ein rostiges Kettenhemd. "
    +"In den dunklen Augenhoehlen dieses Untoten flackern zwei blutrote "
    +"Flaemmchen.";

  return BS(s);
}

int SetMaster(object master)
{
  RemoveId("Schwertexperte");
  return ::SetMaster(master);
}