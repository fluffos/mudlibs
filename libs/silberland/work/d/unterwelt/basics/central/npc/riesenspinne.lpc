#include "../def.h"

inherit "std/npc";

int old;

void create()
{
  int i;

  if(!is_clone(TO)) return;

  ::create();

  old=8;

  SetProp(P_SHORT, "Eine Riesenspinne");
  SetProp(P_LONG,
    "Diese Spinne kann nicht von der Natur geschaffen worden sein. Sie ist "
    "fast doppelt so gross wie Du und strahlt eine boese Aura aus. Mit ihren "
    "acht starken Beinen ist sie sicher jedem Gegner gewachsen. Ihr Koerper "
    "ist ueber und ueber mit hartem Chitin bedeckt. Ein grosses rotes Kreuz "
    "ist auf ihrem Ruecken. Sie ist wohl sehr sehr schnell."
  );

  SetProp(P_NAME, "Riesenspinne");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"riesenspinne", "spinne", "\nspinne"}) );

  create_default_npc(25);
  SetProp(P_HANDS,({" mit einem ihrer giftigen Beine"
                   ,QueryProp(P_HANDS)[1]
                   ,({ DT_POISON,DT_PIERCE })
                   })
  );

  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 400+random(100));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 8);

  SetProp(P_AGGRESSIVE,1);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.4, DT_COLD:      0.1, DT_WATER:      -0.8
     , DT_AIR:       0.0, DT_LIGHTNING:-0.3, DT_EXPLOSION:  -0.2
     , DT_SOUND:     0.0, DT_LIGHT:    -0.8, DT_ELECTRIC:    0.1
     , DT_ACID:      0.0, DT_POISON:   -1.0, DT_TERROR:     -0.6
     , DT_HOLY:      0.1, DT_UNHOLY:    0.0, DT_MAGIC:      -0.4
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "krabbelt flink herein");
  SetProp(P_MSGOUT, "krabbelt flink");
  SetProp(P_MMSGIN, "krabbelt flink herein");
  SetProp(P_MMSGOUT, "krabelt flink");

  SetProp(P_DIE_MSG,  " bricht zusammen.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  AddInfo("zordan", "schaut Dich seltsam an.");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Die Riesenspinne zersetzt @WEN mit ihrem Gift.\n" }) );

  SetProp(P_SPELLRATE,30);

  AddSpell(9,350,
    "Die Riesenspinne spritzt Dich mit Gift voll.\n",
    "Die Riesenspinne spritzt @WEN mit Gift voll.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1])
  );

  AddSpell(1,200,
    "Die Riesenspinne schlaegt ihren Giftstachel in Dich und vergiftet Dich.\n",
    "Die Riesenspinne schlaegt ihren Giftstachel in @WEN und vergiftet @WEN .\n",
     DT_POISON, "giftspell", ([SP_SHOW_DAMAGE:1])
  );

  SUID;

  i = random(4)+4;
  CLONEME("/p/std/skills/sewing_tanning/obj/spinnenseide");
}

int _query_wimpy()
{
  return 0;
}

void init()
{
  ::init();

  if(TP && TP->id("\nspinne")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  int beine;

  beine=2+6*QueryProp(P_HP)/QueryProp(P_MAX_HP);

  ModifySkillAttribute(ME,SA_SPEED,100*beine,5);

  if( beine < old )
  {
    tell_room(MENV,"\nEin Bein der Spinne faellt voellig zerschmettert ab.\n\n");
  }

  old = beine;
  SetProp(P_MAX_HANDS, beine);

  ::Defend(dam, dam_type, spell, enemy);
}

void giftspell(object enemy, int damage, mixed dam_type)
{
  enemy->AddPoison(1+random(5));
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer ==TO )
    WRITELOG(Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht (XP-Verlust : "+lostexp+")");

  return;
}

varargs void die(int poisondeath)
{
  object enemy;

  if(enemy=QueryProp(P_KILLER))
    WRITELOG(CAP(Name(WER,1))+" wurde von "+CAP(getuid(enemy))+" umgebracht");

  ::die(poisondeath);
}

