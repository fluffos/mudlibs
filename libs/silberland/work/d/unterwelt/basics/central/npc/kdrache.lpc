#include "../def.h"

inherit "/p/std/dragons/dragon";

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SUID;

  create_default_dragon(1,10,1,20+random(10));

  SetProp(P_SHORT,
    "Zunnxa i Tomrorn, der steinalte erfahrene kupferne Drache"
  );

  SetProp(P_LONG,
    "Ein riesiges Ungetuem steht vor Dir. Der Kupferdrache scheint Dir aber "
    "nichts tun zu wollen, ausser Du vergreifst Dich an seinem Schatz. "
    "Seine freundlichen Augen verraten Dir, dass er ein guter Drache ist, "
    "der keinen Hass empfindet, ausser auf seine Todfeinde, die Dunkelelfen. "
    "Viele Schlachten hat er bereits geschlagen und keine verloren. Falls Du "
    "ihm den Schatz wegnehmen willst, dann bist Du bereits so gut wie tot."
  );

  AddId( ({"zunnxa", "tomrorn", "zunnxa i tomrorn","kupferdrache"}) );
  set_living_name("zunnxa");

  SetProp(P_AGGRESSIVE, ([ P_RACE:(["Dunkelelf":1]) ]));
}

varargs void die(int poisondeath)
{
  object enemy;

  if(enemy=QueryProp(P_KILLER))
    WRITELOG(CAP(Name(WER,1))+" wurde von "+CAP(getuid(enemy))+" umgebracht");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)
    WRITELOG(Name(WER,1)+" hat gerade "+CAP(getuid(player))+
             " umgebracht (XP-Verlust : "+lostexp+")");

  return;
}

