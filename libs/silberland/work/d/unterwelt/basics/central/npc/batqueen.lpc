#include "../def.h"

inherit NPC "bat_inh";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Die Fledermauskoenigin");
  SetProp(P_LONG,
    "Die Koenigin der Fledermaeuse sieht wahrhaft koeniglich aus. "
    "Majestaetische Fluegel und beinahe goettliche Ohren bilden den Traum "
    "aller gewoehnlichen Fledermaeuse. Ihre Macht ist gross, denn ihre "
    "Untertanen sind zahlreich. Aber auch auf sich alleine gestellt gibt sie "
    "einen extrem gefaehrlichen Gegner ab."
  );

  SetProp(P_NAME, "Fledermauskoenigin");
  SetProp(P_SIZE, 150+random(30));
  SetProp(P_ALIGN, -900);
  AddId(({ "fledermauskoenigin", "koenigin" }));
  SetProp(P_TRANSPARENT,0);

  create_default_npc(36);

  SetProp(P_HANDS, ({" mit ihren Krallen und Zaehnen",
     QueryProp(P_HANDS)[1], ({ DT_PIERCE, DT_RIP })  }));
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);

  SetProp(P_SPELLRATE, 70);

  SetAttackChats(10, ({
    "Die Fledermauskoenigin stuerzt sich aus grosser Hoehe auf Dich herab.\n",
    "Die Fledermauskoenigin will Dein Blut!\n",
    "Die Fledermauskoenigin leckt sich begierig die Zaehne, als sie Dich "
       "ansieht.\n"}) );

  AddSpell(2,200,
    "Die Fledermauskoenigin saugt sich an Dir fest.\n"
    "Du spuerst, wie Deine Erfahrung schwindet.\n",
    "Die Fledermauskoenigin saugt sich an @WEM fest.\n",
     DT_UNHOLY, "spell_sucka", ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,350,
    BS("Das schrille Ultraschallkreischen der Fledermauskoenigin laesst Dir "
       "das Blut in den Adern gefrieren."),
    "Die Fledermauskoenigin kreischt @WEN wild an.\n",
     ({ DT_TERROR, DT_SOUND }),([SP_SHOW_DAMAGE:1]));

  AddSpell(1,250,
    "Die Fledermauskoenigin kratzt Dir die Augen aus.\n",
    "Die Fledermauskoenigin kratzt @WEM die Augen aus.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,850,
    "Die Fledermauskoenigin reisst Dir die Kehle auf.\n",
    "Die Fledermauskoenigin reisst @WEM die Kehle auf.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,600,
    "Die Fledermauskoenigin wirft einen Ball des Verderbens nach Dir.\n",
    "Die Fledermauskoenigin wirft einen Ball des Verderbens nach @WEM.\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1,
    "Die Fledermauskoenigin ruft nach ihren Untertanen.\n",
    "Die Fledermauskoenigin ruft nach ihren Untertanen.\n",
     DT_MAGIC, "newbats", ([SP_SHOW_DAMAGE:1]));

  SUID;

  CLONEME(OBJ "batwing");
  CLONEME(OBJ "batwing");
}

void newbats(object enemy, int damage, mixed dam_type)
{
  object bat;

  if(present("fledermaus 5",ENV(TO))) return;

  bat = clone_object(NPC "bat");
  bat->Customize(random(3));
  bat->move(ENV(TO), M_GO);

  if(random(100)>50) clone_object(NPC "batvamp")->move(ENV(TO), M_GO);
  if(random(100)<50) clone_object(NPC "batvamp")->move(ENV(TO), M_GO);
}

