#include "../def.h"

inherit "std/mnpc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein boeser Sichelschrecken");
  SetProp(P_LONG,
    "Vor Dir steht ein Sichelschrecken. Eine boesartige, dumme Kreatur, die "
    "jeden, der ihr ueber den Weg laeuft, als Futter betrachtet. Mit seinen "
    "gewaltigen Sichelklauen und seiner dicken Chitinpanzerung gibt er "
    "einen nicht zu unterschaetzenden Gegner ab."
  );

  SetProp(P_NAME, "Sichelschrecken");
  SetProp(P_GENDER, MALE);

  AddId(({ "schrecken", "sichelschrecken"}));

  create_default_npc(19+random(4));

  SetProp(P_HANDS, ({" mit seinen Sichelklauen", 300, DT_SLASH}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 200 + random(40));
  SetProp(P_ALIGN, -850);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0.5);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_UNHOLY: -0.5, DT_HOLY: 0.8]));

  SetProp(P_DIE_MSG,  " kreischt, als er sein Leben aushaucht.\n");

  SetProp(P_MNPC_AREA,
    ({ ROOM "00-05+06", ROOM "00-05+07",ROOM "00-04+06",ROOM "00-04+07"}) );

  SetProp(P_MNPC_WAIT, ({ 10, 15, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "00-04+07");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES);

  SetProp(P_SPELLRATE, 30);

  AddSpell(1,450,
    BS("Der Sichelschrecken bekommt einen Deiner Arme mit seinen "
       "Klauenhaenden zu fassen und drueckt erbarmungslos zu."),
    BS("Der Sichelschrecken bekommt einen Arm @WESSEN mit seinen "
       "Klauenhaenden zu fassen und drueckt erbarmungslos zu."),
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1])
   );

  AddSpell(1,200,
    "Der Sichelschrecken pruegelt auf Deinen Kopf ein.\n",
    "Der Sichelschrecken pruegelt auf @WESSEN Kopf ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1])
  );

  SUID;
  CLONEME(ARMOUR "chitinpanzer" );
  command_me("trage alles");
}

void die(int poisondeath)
{
  object item;
  object ob;
  
// Fuer Zechprellerquest
  if(QueryProp(P_KILLER))
    ob = present("\nzechpreller_quest_11", QueryProp(P_KILLER));
  if(ob)
    ob->Mark();

// Fuer Paladinquest
  if(item=present("\npaladintaskitem", TP))
  {
    if (item->GetTask(13, TP))
    {
      item->SetVar(item->GetVar()+1);
      if(item->GetVar() >= 4) item->SetFlag(0);
    }
  }

  ::die(poisondeath);
}





