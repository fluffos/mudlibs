#include "../def.h"

inherit NPC "bat_inh";
inherit "/std/npc/spells.lpc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Vampirfledermaus");
  SetProp(P_LONG,
    "Diese Fledermaus will BLUT! Sie sieht zwar oberflaechlich betrachtet "
    "nicht viel anders als eine - zugegeben recht grosse - gewoehnliche "
    "Fledermaus aus, aber die messerscharfen Krallen an ihren Beinen und den "
    "Enden der Fluegel, sowie die langen Zaehne, von denen staendig Blut "
    "tropft, sagen Dir, dass dieser Gegner anders ist. Der geifernde Ausdruck "
    "auf dem duemmlichen Fledermausgesicht jagt Dir Angst ein."
  );

  SetProp(P_NAME, "Vampirfledermaus");
  SetProp(P_SIZE, 50+random(30));
  SetProp(P_ALIGN, -750);
  AddId( ({"vampirfledermaus" }) );

  create_default_npc(18);

  SetProp(P_HANDS, ({" mit ihren Krallen und Zaehnen",
     QueryProp(P_HANDS)[1], ({ DT_PIERCE, DT_RIP })  }));
  SetProp(P_AGGRESSIVE, 0.3);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE, 25);

  SetAttackChats(10, ({
    "Die Vampirfledermaus stuerzt sich aus grosser Hoehe auf Dich herab.\n",
    "Die Vampirfledermaus will Dein Blut!\n",
    "Die Vampirfledermaus leckt sich begierig die Zaehne, als sie Dich "
       "ansieht.\n"}) );

  AddSpell(1,150,
    "Die Vampirfledermaus saugt sich an Dir fest.\n"
    "Du spuerst, wie Deine Erfahrung schwindet.\n",
    "Die Vampirfledermaus saugt sich an @WEM fest.\n",
     DT_UNHOLY, "spell_sucka", ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,250,
    BS("Das schrille Ultraschallkreischen der Vampirfledermaus laesst Dir das "
       "Blut in den Adern gefrieren."),
    "Die Vampirfledermaus kreischt @WEN wild an.\n",
     ({ DT_TERROR, DT_SOUND }),([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 200, DS_BLIND,
     "Die Vampirfledermaus kratzt Dir die Augen aus!\n",
     "Die Vampirfldermaus kratzt @WEM die Augen aus!\n" );
}

