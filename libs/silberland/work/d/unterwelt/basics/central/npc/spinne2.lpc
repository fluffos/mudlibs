#include "../def.h"

inherit "std/mnpc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Spinne");
  SetProp(P_LONG,
    "Diese Spinne ist schon ein wenig groesser als seine Artgenossen ueber "
    "der Erde. Mit seinen acht Beinen kann sie Dich sicher schon erwischen. "
    "Allerdings sollte sie fuer einen erfahrenen Kaempfer kein Problem "
    "darfstellen. Auffaellig ist nur das Zusammengehoerigkeitsgefuehl der "
    "Spinnen hier unten. Ein kleines rotes Kreuz ist auf ihrem Ruecken "
    "zu sehen."
  );

  SetProp(P_NAME, "Spinne");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"spinne", "\nspinne"}) );

  create_default_npc(5+random(5));
  SetProp(P_HANDS, ({" ihren acht Beinen",QueryProp(P_HANDS)[1],({ DT_BLUDGEON,DT_PIERCE }) }));
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 10+random(10));
  SetProp(P_ALIGN, -150+random(50));
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_AGGRESSIVE,0.1);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.2, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.2
     , DT_HOLY:      0.2, DT_UNHOLY:    0.0, DT_MAGIC:      -0.2
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "krabbelt herein und flickt an der Spinnwebe herum");
  SetProp(P_MSGOUT, "krabbelt weiter");
  SetProp(P_MMSGIN, "krabbelt herein und flickt an der Spinnwebe herum");
  SetProp(P_MMSGOUT, "krabelt weiter");

  SetProp(P_MNPC_AREA, SPINNEN_REGION);
  SetProp(P_MNPC_WAIT, ({ 30, 60, 60 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "01-09-01");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_NOCORPSE,1);
  SetProp(P_DIE_MSG,  " faellt zu Boden und hinterlaesst einen Schleimfleck.\n");

  AddInfo(DEFAULT_INFO, "redet nur sehr selten.\n");

  AddInfo("zordan", "beisst Dir ins Bein.");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Spinne ist doch viel zu klein fuer @WEN.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(1,200,
    "Die Spinne spritzt Dich mit Gift voll.\n",
    "Die Spinne spritzt @WEN mit Gift voll.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1])
   );

  SetChats(1, ({
    "Die Spinne krabbelt ueber Deinen Fuss.\n",
    "Die Spinne webt einen neuen Faden.\n",
    "Die Spinne bessert eine Stelle aus.\n",
    "Die Spinne wackelt mit ihren Beinchen.\n"}) );

  SUID;

  CLONEME("/p/std/skills/sewing_tanning/obj/spinnenseide");
}

void init()
{
  ::init();

  if(TP && TP->id("\nspinne")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}
