inherit "std/mnpc";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Fledermaus");
  SetProp(P_MAX_HANDS, 4);

  AddId( ({ "fledermaus"}) );
  AddClass( ({CL_FLYING, CL_ANIMAL}) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:50]));

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "flattert herein");
  SetProp(P_MMSGOUT, "flattert weg");

  SetProp(P_MNPC_AREA, ({ ROOM "00+03-06", ROOM "00+03-07", ROOM "00+04-05",
                          ROOM "00+04-06", ROOM "00+04-07", ROOM "00+05-05",
                          ROOM "00+05-06" }));

  SetProp(P_MNPC_WAIT, ({ 5, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "00+04-06");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES);

}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void init()
{
  ::init();
  if(TP && TP->id("fledermaus")) AddDefender(TP);
}

void spell_sucka(object enemy, int damage, mixed dam_type)
{
  enemy->SetProp(P_XP, enemy->QueryProp(P_XP) - 500 - random (1000));
  enemy->SetProp(P_SP, enemy->QueryProp(P_SP) * 9 / 10);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO) KILLLOG(TO->Name(WER),CAP(getuid(player)));
}

varargs void die(int poisondeath)
{
  object enemy;

  if(enemy=QueryProp(P_KILLER)) KILLLOG(CAP(getuid(enemy)),TO->name(WER));

  ::die(poisondeath);
}


