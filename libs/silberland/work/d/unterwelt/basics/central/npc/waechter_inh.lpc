#include "../def.h"

inherit NPC "std_darkelf";

#define WAECHTERID "\ndunkelelfenwaechter"

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  AddId( ({WAECHTERID}) );

  SetProp(P_AGGRESSIVE,([P_RACE:(["Dunkelelf":0.0, 0:0.06])]) );

  AddInfo(DEFAULT_INFO, "schaut Dich nur an.\n");

  SUID;
  CLONEME("/d/unterwelt/zordan/dhrkion/weapon/langbogen" );
  command_me("zueck bogen");

  CLONEME("/d/unterwelt/zordan/dhrkion/armour/spinnenpanzer" );
  CLONEME("/p/armour/boots/lederstiefel" );
  CLONEME("/p/armour/gloves/lederhandschuhe" );

  command_me("trage alles");
}

void Customize()
{
  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" hat besseres zu tun als Deine Sachen zu schleppen.\n" }) );

  SetChats(1,
    ({Name(WER,1)+" rueckt "+QueryPossPronoun(MALE,WEN,SINGULAR)+" Panzer zurecht.\n"
     ,Name(WER,1)+" kontrolliert das Tor.\n"
     ,Name(WER,1)+" schaut Dich misstrauisch an.\n"
     ,Name(WER,1)+" schreitet vor dem Tor auf und ab.\n"
     ,Name(WER,1)+" sieht Dich argwoehnisch an.\n"
     })
   );

  AddSpell(4,100,
    Name(WER,1)+" schiesst einen magischen Pfeil auf Dich ab.\n",
    Name(WER,1)+" schiesst einen magischen Pfeil auf @WEN ab.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1])
  );

  SetProp(P_HANDS, ({" mit "+QueryPossPronoun(FEMALE,WEM,PLURAL)+
                     " dunklen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

}

int Defend(int dam, string dam_type, mixed spell, object enemy)
{
  if(enemy->id("UWELTSKELETT") || enemy->id("ratte")) dam = 0;
  return :: Defend(dam,dam_type,spell,enemy);
}

void init()
{
  ::init();
  if(TP && TP->id(WAECHTERID)) AddDefender(TP);
  if(TP && TP->id("UWELTSKELETT")) Kill(TP);
  if(TP && TP->id("ratte")) Kill(TP);
  if (QueryProp(P_ALIGN) > -500) // Damit sie boese bleiben - Feyaria
    SetProp(P_ALIGN, -700);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void reset()
{
  object room, *ob, *own_inventory;
  int i;

  ::reset();

  if(!is_clone(TO)) return;
  if(!room=ENV(TO)) return;

  own_inventory = all_inventory(TO);
  command_me("nimm alles");
  ob = all_inventory(TO) - own_inventory;

  i = sizeof(ob);

  if(i > 0)
  {
    tell_room(room,BS(TO->Name(WER,1)+" hebt allen herumliegenden Plunder "
                      "auf und wirft ihn weg."));

    while(i--) ob[i]->remove();
  }
}
