#include "../def.h"

inherit "std/mnpc";

#include <ansi.h>

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Henker");
  SetProp(P_LONG,
    "Verdammt in alle Ewigkeiten geistert dieser Henker durch die Gaenge "
    "der Unterwelt. Wieviele arme Seelen hat er schon auf dem Gewissen? "
    "Welche Suehne muss er erbringen, um seinen Tod zu finden?"
  );

  SetProp(P_RACE, "Mensch");
  SetProp(P_NAME, "Henker");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:50]));
  AddId(({"henker"}));
  AddClass(CL_HUMAN);

  create_default_npc(38);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 160+random(20));
  SetProp(P_ALIGN, -600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);

  SetProp(P_MMSGIN, "schlurft herein und haelt nach Opfern Ausschau");
  SetProp(P_MMSGOUT, "schlurft davon");
  SetProp(P_MSGIN,  "schlurft herein und haelt nach Opfern Ausschau");
  SetProp(P_MSGOUT, "schlurft#");

  SetProp(P_MNPC_DEFAULTROOM, ROOM "00-05-08");
  SetProp(P_MNPC_WAIT, ({ 30, 15, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG, " seufzt: Endlich....\n");

  AddInfo(DEFAULT_INFO, "ist zu beschaeftigt um Dir zuzuhoeren.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Henker mag nichts haben.\n" }) );

  SUID;

  SetProp(P_SPELLRATE,40);

  AddSpell(2,1, "","" ,
    ({DT_AIR}),"spell_strick"
  );

  CLONEME("/p/std/skills/sewing_tanning/obj/stoffreste");
}

void spell_strick(object enemy, int damage, mixed dam_type)
{
  string so,sp;
  object strick;

  if(present("\nhenkerstrick",enemy))
  {
    sp = " zieht den Strick um Deinen Hals heftig zu.";
    so = " zieht den Strick um "+enemy->name(WESSEN)+" Hals heftig zu.";

  }
  else
  {
    sp = " zieht einen Strick hervor und legt ihn Dir um den Hals!";
    so = " zieht einen Strick hervor und legt ihn "+enemy->name(WEN)+" um "
         "den Hals!";
    strick = clone_object(OBJ "strick");
    strick->move(enemy, M_NOCHECK); // Der Strick hat kein Gewicht!
    strick->StartDamage();
  }

  tell_room(ENV(TO),BS(Name(WER)+so),({enemy}));

  if(enemy->QueryProp(P_TTY))
  {
    tell_object(enemy,ANSI_BOLD+ANSI_RED+BS(Name(WER)+sp)+ANSI_NORMAL);
  }
  else
  {
    tell_object(enemy,BS(Name(WER)+sp));
  }

  enemy->Defend(450,DT_AIR,1,TO);

  return;
}

varargs void die(int poisondeath)
{
  object enemy;

  if(enemy=QueryProp(P_KILLER))
    WRITELOG(CAP(Name(WER,1))+" wurde von "+CAP(getuid(enemy))+" umgebracht");

  ::die(poisondeath);
}


