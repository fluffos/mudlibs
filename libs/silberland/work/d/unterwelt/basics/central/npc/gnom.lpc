inherit "std/mnpc";

#include "../def.h"

void create()
{
  object erz;

  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Hoehlengnom");
  SetProp(P_LONG,
    "Du siehst einen kleinen, aber kraeftigen Kerl. Ein typischer Vertreter "
    "der Gnomrasse. Wie die meisten seiner Artgenossen ist er begierig "
    "darauf, Erze zu schuerfen, Metallvorkommen zu ergruenden und seltene "
    "Gesteine abzubauen."
  );

  SetProp(P_RACE, "Gnom");
  SetProp(P_NAME, "Hoehlengnom");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-30,T_RANGE_MAX:50]));
  AddId(({ "gnom", "hoehlengnom" }));
  AddClass(CL_GNOME);

  create_default_npc(15+random(3));
  SetProp(P_HANDS, ({" mit seinen blossen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_SIZE, 90+random(40));
  SetProp(P_ALIGN, -200+random(400));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetAttribute(A_DEX, 20);

  SetProp(P_DIE_MSG, " krepiert jaemmerlich.\n");

  SetProp(P_MMSGIN, "kommt an und schaut sich um, ob es etwas zu schuerfen gibt");
  SetProp(P_MMSGOUT, "sucht woanders nach Erzen");
  SetProp(P_MSGIN,  "kommt an und schaut sich um, ob es etwas zu schuerfen gibt");
  SetProp(P_MSGOUT, "sucht woanders nach Erzen und geht#");

  SetProp(P_MNPC_AREA, GNOM_REGION);

  SetProp(P_MNPC_DEFAULTROOM, ROOM "00+05+05");
  SetProp(P_MNPC_WAIT, ({ 60, 50, 20 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo( ({ "erze", "erz" }),
    "Erz? Hast Du wo eine Ader entdeckt? Was fuer eine?", "sagt: " );
  AddInfo( ({ "gnom", "gnome", "hoehlengnome" }),
    "Ja, ich bin ein Gnom. Gut erkannt! Und wer bist Du?", "sagt: " );
  AddInfo( ({ "erzader", "ader" }),
    "Diese hier ist ganz ok. Wird einiges einbringen, denke ich.",
    "sagt: " );

  SetChats(5, ({
     "Der Hoehlengnom schlaegt fest auf den Fels.\n",
     "Steinsplitter fliegen umher, als der Gnom einen Felsen zerschmettert.\n",
     "Der Hoehlengnom findet einen kleinen Erzbrocken, wirft ihn aber weg.\n",
     "Der Hoehlengnom sagt: Heute ist die Ausbeute recht gut!\n",
     "Der Hoehlengnom sagt: Gute Ader hier. Leider so weit weg von zuhause.\n",
     "Der Hoehlengnom kratzt ein wenig am Gestein.\n",
     "Die Hoehle erzittert unter maechtigen Hammerschlaegen.\n",
     "Der Hoehlengnom schreckt von seiner Arbeit auf und betrachtet Dich.\n",
     "Der Hoehlengnom singt: 'Marmor, Stein und Eisenerz bricht... la la'\n",
     "Der Hoehlengnom nickt zufrieden.\n",
     "Der Hoehlengnom bricht ein paar Brocken aus der Hoehlenwand.\n",
     "Der Hoehlengnom sagt: Pfuuu, ist mir heiss!\n",
     "Der Hoehlengnom zerbroeselt etwas Erz.\n",
     "BUMM! ZACK! BUMM!\n",
     "Der Hoehlengnom prueft den Fels.\n" }) );

  SUID;

  CLONEME(ARMOUR "gnomhose");
  CLONEME(ARMOUR "gnomstfl");

  if(random(50)>35) CLONEME(ARMOUR "gnomhelm");
  if(random(50)>20) CLONEME(ARMOUR "gnompanz");
  if(random(50)>35) CLONEME(ARMOUR "gnomarm");

  command_me("trage alles");

  if(random(50)>25)
  {
    CLONEME(WEAPON "gnomhamm" );
  }
  else
  {
    CLONEME(WEAPON "gnompick" );
  }

  command_me("zuecke pickel");
  command_me("zuecke hammer");

  erz=clone_object(OBJ "erz");
  erz->move(TO, M_NOCHECK);
  erz->AddAmount(random(10));
}


