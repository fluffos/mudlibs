#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine seltsame Schnur");
  SetProp(P_LONG, "Du siehst eine dicke, gruen und gelb gestreifte Schnur. "
    "Sie verhaelt sich ziemlich seltsam. Sie ist so steif, dass man sie gar "
    "nicht um etwas wickeln oder etas binden kann, man muss sie "
    "richtiggehend verbiegen. "
    "Ueberhaupt nicht wie eine normale Schnur. Eher wie "
    "ein Draht. Aber sie besteht eindeutig nicht aus Metall. Die Oberflaeche "
    "fuehlt sich glatt an, aber doch nachgiebig... Total seltsam jedenfalls.");

  AddDetail( ({ "oberflaeche" }), 
    "Die Oberflaeche ist glatt und trotzdem nachgiebig." );

  SetProp(P_NAME, "Schnur");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([MAT_PLASTIC:25, MAT_COPPER:75]) );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 7);
  SetProp(P_NOBUY, 0);

  SetProp(P_INFO,"Diese Schnur leitet Energie sehr gut.\n");


  AddId( ({"schnur", "kabel"}) );
  AddAdjective("seltsame");
  
}

