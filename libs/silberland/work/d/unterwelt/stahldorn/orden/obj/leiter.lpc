
inherit "std/thing";

#include <moredef.h>
#include <properties.h>
#include <language.h>

create()
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Holzleiter");
  SetProp(P_LONG, 
    "Du siehst eine stabile Holzleiter. Sie ist gerade gross genug, dass man "
    "fast alles, was ein Stueckerl weiter oben haengt, erreicht. "
    "Und sie wiegt dabei gar nicht so arg viel. Ansonsten "
    "sieht man an ihr nichts Besonderes.");

  AddDetail("holz",
    "Es handelt sich um eine recht leichte, aber robuste Holzart.");

  SetProp(P_NAME, "Holzleiter");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([MAT_WOOD:100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 120);
  SetProp(P_SIZE, 60);
  SetProp(P_NOBUY, 0);

  AddId( ({"holzleiter", "leiter"}) );
  
}

