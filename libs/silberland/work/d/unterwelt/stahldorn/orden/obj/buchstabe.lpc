#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

string letter;

create()
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetLetter();
  
  SetProp(P_SHORT, "Der magische Buchstabe '" +CAP(letter)+"'");
  SetProp(P_LONG, 
      "Du siehst den Buchstaben " +CAP(letter)+
      ". Auf magische Weise schwebt der Buchstabe. Er ist "
      "zwar halb transparent, doch man kann ihn trotzdem "
      "angreifen und mitnehmen.");
  
  SetProp(P_NAME, letter);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);

  SetProp(P_INFO,"Mit magischen Buchstaben schreibt man magische "
                                "Formeln.\n");


  AddId( ({"buchstabe", lower_case(letter),"Buchstabe "+letter,"letter"}) );
  AddAdjective("magische");

}


void SetLetter()
{
  string all_letters;
  int rand;
  
  all_letters=implode(ROOM "allerheiligstes"->QueryAlleInschriften(),"");
  rand=random(strlen(all_letters)-1);
  letter=all_letters[rand..rand];
 
}

string QueryLetter()
{
  return letter;
}
	
