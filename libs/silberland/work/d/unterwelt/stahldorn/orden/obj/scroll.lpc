#include "../def.h"

inherit "std/thing";
inherit "std/spellbook";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>

#define WIRKDAUER 4

void bumm();

create()
{
  if(!is_clone(TO)) return;
  thing:: create();
  
  SetProp(P_SHORT, "Eine geheimnisvolle Schriftrolle");
  SetProp(P_LONG, "Irgendwie traust Du Dich nicht, genau hinzusehen. Du "
    "spuerst, wie viel Macht in der Rolle gebuendelt ist.");
  SetProp(P_INFO, BS(
    "Wenn Du diese Schriftrolle liest, dann wird die darin enthaltene "
    "Magie entfesselt und auf einen Schlag entladen. Pass auf, denn "
    "das koennte nicht ungefaehrlich sein!"));
  SetProp(P_NAME, "Schriftrolle");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);  
  AddId( ({"schriftrolle", "rolle"}) );
  AddAdjective("geheimnisvolle");
  
  AddCmd( ({ "lies" }), "lesen" );

  AddDetail( ({ "buchstaben" }), 
    "Du erkennst ein 'e' hier, ein 'f' dort, aber um den Gesamtzusammenhang "
    "zu verstehen, muesstest Du die ganze Schriftrolle lesen." );

}

int lesen(string str)
{
  if(!id(str)) return 0;
  
  if(TP->QueryProp(P_BLIND))
  {
    write("Du bist blind und kannst nichts erkennen.\n");
    return 1;
  }
  
  if(TP->QueryAttribute(A_INT)<10)
  {
    write(BS(
      "Du versuchst, die Rolle zu lesen, stammelst aber nur "
      "sinnloses Zeug vor Dich hin. Die Buchstaben verschwimmen vor Deinen "
      "Augen und Du kannst Dich ueberhaupt nicht konzentrieren. Vielleicht "
      "bist Du einfach nicht intelligent genug..."));
    return 1;
  }

  if(!TP->QueryProp(P_ATTACK_BUSY) && 
     TP->QueryProp(P_NEXT_SPELL_TIME)<=time() &&
     TP->QueryProp(P_SP) >= 5)  
  {
    TP->SetProp(P_ATTACK_BUSY,1);
    TP->SetProp(P_NEXT_SPELL_TIME,time()+WIRKDAUER);
    TP->restore_spell_point(-5);
    write(
      "Du entrollst die Schriftrolle und beginnst zu lesen: \n\n"
      "'  Krompfi sissti Hudriwupf  '\n"
      "'  Schlapfi gembim Nebeltupf  '\n"
      "'  Heliobirn exitus  '\n"
      "'  Lari Fari draufundschluss.  '\n"
      "Hmm. Irgendwie passiert gar nix. Hast Du auch alles richtig gelesen?\n");

    say(TP->Name()+" entrollt eine Schriftolle und sagt: \n\n"
      "'  Krompfi sissti Hudriwupf  '\n"
      "'  Schlapfi gembim Nebeltupf  '\n"
      "'  Heliobirn exitus  '\n"
      "'  Lari Fari draufundschluss.  '\n");

    RemoveCmd("lies");
    call_out("bumm", WIRKDAUER);  
//    bumm();
  }
  else
  {
    write("Darauf kannst Du Dich im Moment nicht konzentrieren.\n");
  }
  return 1;
}

void bumm()
{
  object *leute;
  int i;

//  leute = filter_array(all_inventory(environment(TP)), #'living);
  leute = FindGroup(TP,-1);

  tell_room(ENV(TP), BS(
    "Ploetzlich schiessen aus "+TP->name(WESSEN)+" Schriftrolle tausende "
    "Lichtstrahlen, waehrend die Rolle selber in einer gewaltigen Explosion "
    "zerstoert wird. Ueberall, wo die Lichtstrahlen auftreffen, steigt "
    "kraeuselnder Rauch auf." ));

  for(i=sizeof(leute)-1;i>=0;i--)
  {
      tell_object(leute[i],"Die Explosion erwischt Dich.\n");
      leute[i]->Defend(TP->QueryAttribute(A_INT)*10+random(150),
                       ({DT_EXPLOSION, DT_LIGHT}),([SP_SHOW_DAMAGE:1]),TP);
  }

}
