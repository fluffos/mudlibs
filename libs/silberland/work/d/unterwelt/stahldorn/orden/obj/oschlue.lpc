#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if(!is_clone(TO)) return;
  thing:: create();
  
  SetProp(P_SHORT, "Ein dicker Schluessel");
  SetProp(P_LONG, "Dies ist ein dicker schwarzer Schluessel. "
    "Keine Ahnung, wozu der gut ist.");
  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_IRON);
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 50);
  AddId( ({"schluessel"}) );
  AddAdjective("dicker");
  


}


mixed QueryDoorKey()
{
  return ROOM "tor:" ROOM "vorraum";
}
