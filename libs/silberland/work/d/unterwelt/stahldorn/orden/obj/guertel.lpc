inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include "../def.h"


void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Goetterguertel");
  SetProp(P_LONG, 
    "Dieser Guertel kann nicht irdischen Ursprungs sein, so goettlich gut "
    "sieht er aus. Er besteht praktisch nur aus magisch flimmernder Luft, "
    "wobei er mal heller, mal dunkler erscheint. Mal wirkt er farbig, dann "
    "wieder blass. Dieser Gegenstand ist wahrlich von grosser Macht "
    "erfuellt! Der Heilige Genofevius muss ihn bei einer seiner Heldentaten "
    "errungen haben.");
  SetProp(P_NAME, "Goetterguertel");
  SetProp(P_GENDER, MALE);
  AddId( ({"goetterguertel", "guertel"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([ MAT_AIR:50, MAT_MAGIC:50 ]) );
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 160);                                            

  AddDetail("luft", "Der Guertel flimmert, als ob er aus Luft waere.\n");

  seteuid(getuid(this_object()));

  
// identify(ob, prob, prefix, suffix, *chances, nocurse )
  "/p/daemon/itemd/itemd"->identify(this_object(),-1,100,50,({0,0,0,0,100}),1);
}


	
	
