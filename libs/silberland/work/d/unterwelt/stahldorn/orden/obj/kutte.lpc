inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Eine braune Kutte");
  SetProp(P_LONG, 
    "Eine braune Kutte von einem simplen Moench. Mit einer Kapuze dran, "
    "die hinten runterhaengt. Und einem Kordel, mit der man sie zubinden kann.\n");
  SetProp(P_NAME, "Kutte");
  SetProp(P_GENDER, FEMALE);
  AddId("kutte");
    AddAdjective( ({"braune"}) );
  
    SetProp(P_INFO, BS(
    "Diese Kutte ist stinknormal.") );
  
    AddDetail( ({ "kordel", }), 
    "Man bindet sie zu, wenn man die Kutte anzieht, sonst stolpert man ja drueber." );
  
      AddDetail( ({ "kapuze", }), 
    "Haengt hinten runter und bringt eigentlich nix." );
  
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 450);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 5);
  SetProp(P_QUALITY_DECAY, 80 );
  SetProp(P_MATERIAL, ([MAT_WOOL:100]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:3, T_HEAT_PROT:-1]) );
}
