// /d/unterwelt/stahldorn/orden/obj/hschwert.c
// adaptiert fuer den Heiligen Orden durch Stahldorn@Silberland
// vormals: /d/gebirge/feyaria/blut/weapon/hschwert.c
// Das heilige Schwert des Ordensritters
// 1997-04-12  Feyaria@SilberLand

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Das heilige Schwert");
  SetProp(P_LONG, BS( 
    "Das ist eines der wenigen heiligen Schwerter, mit denen die Ritter des "
    "heiligen Ordens kaempfen. Es funkelt im Sonnenlicht, denn die Klinge "
    "ist mit vielen silbernen Symbolen verziert.") );
  SetProp(P_INFO, BS(
    "Mit diesem Schwert kann man sicher gut gegen die Maechte des Boesen "
    "kaempfen. Aber nur wer sich an den Ehrenkodex der Ritter haelt, wird "
    "die volle Macht dieses Schwertes entfachen koennen.") );
  SetProp(P_NAME, "Schwert");
  SetProp(P_NAME_ADJ, "heilig");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schwert", "hschwert"}) );
  AddAdjective( ({"heilig", "heiliges", "heilige"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 165);
  SetProp(P_WC_FIX, 55); 
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_HOLY}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_STEEL:80, MAT_SILVER:15, MAT_IRIDIUM:5]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

  SetProp(P_WIELD_RESTRICTIONS, ([ P_FROG: 1]) );
  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );
  SetProp(P_KILL_NAME, "Das Heilige Schwert");
  SetProp(P_KILL_MSG, "Kein Boesewicht kann mich je zuecken!");

}

int WieldFunc(object waffe)
{
  int align;
  align=TP->QueryProp(P_ALIGN);
  if( align>333 ) 
    return 1;
  if( align>-50 )
  {
    write("Du bist nicht gut genug, um dieses Schwert zu fuehren.\n");
    return 0;
  }
  write( BS("Das Schwert merkt, dass Du mit den Maechten des Boesen im Bunde "
    "bist und wendet sich gegen Dich.") );
  if( align <-500 )
  {
    write("Durch Deine unglaubliche Bosheit wird das heilige Schwert "
      "vernichtet.\n");
    call_out("remove", 1);
  }
  TP->do_damage(-align/5);
  return 0;
}

int UnwieldFunc(object waffe)
{
  if( TP->QueryProp(P_ALIGN)<0 ) 
  {
    write("Das Schwert wendet sich gegen das Boese in Dir.\n");
    TP->do_damage(10);
  }
  if( TP->InFight() )
  {
    write("Der Ehrenkodex der Ritter verbietet es, das Schwert im Kampf "
      "wegzustecken.\n");
    return 0;
  }
  return 1;
}

int HitFunc( object enemy )
{
  int a, e;

  a = TP->QueryProp(P_ALIGN);
  e = enemy->QueryProp(P_ALIGN);
  if( a < 300 || e > 333 )
  {
    write("Das Schwert gehorcht Dir nicht mehr!\n");
    return -200;
  }
// bei optimalem Align maximal 50 + 100 Zuschlag
  if( e < -500+random(450) )
    return random( ( a>1000 ? 1000 : a )/20 - ( e<-1000 ? -1000 : e )/10 ); 
  return 0;
}

