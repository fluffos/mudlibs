// /d/unterwelt/stahldorn/orden/obj/h_amulet.c
// adaptiert fuer den Heiligen Orden durch Stahldorn@Silberland
// vormals: /d/gebirge/feyaria/blut/armour/h_amulet.c
// Das heilige Amulet des Ordensritters
// 1997-04-12  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";
inherit "std/restriction_checker";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein heiliges Amulett");
  SetProp(P_LONG, BS( 
    "Dieses Amulett hat die Form eines Schwertes und ist ganz aus Gold.") );
  SetProp(P_INFO, BS(
    "Dieses Amulett schuetzt den Guten vor dem Boesen.") );
  SetProp(P_NAME, "Amulett");
  SetProp(P_NAME_ADJ, "heilig");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"amulett", "h_amulet"}) );
  AddAdjective( ({"heilig", "heiliges", "heilige"}) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ({MAT_GOLD}) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 1);

  SetProp(P_WEAR_RESTRICTIONS, ([SR_BAD: 500, P_LEVEL: 15, ]) );
  SetProp(P_DEFEND_FUNC, TO );
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  if( QueryProp(P_WORN)->QueryProp(P_ALIGN)<50 )
  {
    tell_object(QueryProp(P_WORN), "Du bist nicht gut genug, um das heilige "
      "Amulett zu tragen.\n");
    DoUnwear();
  } 
  if( member(dam_type, DT_UNHOLY)!=-1)
    return 15+random(10);
  return 0;
}

