// Die Kettenbeinlinge des Ordensritters
// 1997-04-12  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Kettenbeinlinge");
  SetProp(P_LONG, BS( 
    "Die Beinlinge bestehen eigentlich nur aus zwei Roehren, die das ganze "
    "Bein bedecken. Da sie aus stabilem Kettengewebe gefertigt sind, sind die "
    "Beine sehr gut geschuetzt, allerdings wird die Bewegung dadurch "
    "ziemlich eingeschraenkt. Man muss also ein gewisses Mindestmass an "
    "Koerperkraft mit sich bringen, um mit den Kettenbeinlingen herumgehen "
    "zu koennen.") );
  SetProp(P_NAME, "Kettenbeinlinge");
  SetProp(P_PLURAL, 1);
  
  SetProp(P_GENDER, FEMALE);
  AddId( ({"beinlinge", "kettenbeinlinge"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ({MAT_IRON, MAT_METAL}) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 0);

  SetProp(P_WEAR_RESTRICTIONS, ([ A_STR: 15 ]) );

// identify(ob, prob, prefix, suffix, *chances, nocurse )
//   "/p/daemon/itemd/itemd"->identify(this_object(),-1,50,100,({0,0,50,100,100}),1);
// ITEMD->identify(this_object(),-1,100,50,({0,0,50,100,100}),1);
// DB(ITEMD);
}

