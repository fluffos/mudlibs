#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../def.h"

inherit NPC "orden";



string gibfackel(string str)
{
  if(InFight()) return "sagt: Siehst Du nicht, dass ich kaempfe?\n";
  if(TP->QueryProp(P_ALIGN) < 0) 
    return "sagt: Du bist zu boese, Dir geb ich nichts.\n";

  if(present("fackel"))
  {
    command_me("gib fackel an "+getuid(TP));
    return "sagt: Hier hast Du eine Fackel. Bittesehr.\n";
  }
  else
    return "sagt: Tut mir leid, ich haette selber gerne eine.";
}



void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Paladin");
  SetProp(P_LONG, 
    "Der Paladin vor Dir hat bereits viel erlebt. Frueher einmal hat er auch als "
    "Soeldner in Midas gearbeitet, was ihm aber zu gefaehrlich wurde. Was man an "
    "seinen vielen Narben auch erkennen kann. Spaeter heuerte er als Soldat in "
    "Kyranda an, wurde aber nie befoerdert. Irgendwann ist er sozusagen als "
    "Hilfspaladin angestellt worden. Zur absoluten Elite zaehlt er dehalb ganz "
    "sicher nicht, obwohl man ihn durchaus als kampferprobt bezeichnen kann.");
  SetProp(P_NAME, "Paladin");
  SetProp(P_GENDER, MALE);
  AddId(({ "paladin", "hilfspaladin"}));

  create_default_npc(20);

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170 + random(15));
  SetProp(P_ALIGN, 750);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in strahlendem Glanz");
  SetProp(P_MMSGOUT, "verschwindet in einem Lichtblitz");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddDetail( ({ "narbe", "narben" }),
    "Die Narben sehen schon recht alt aus und sind lange verheilt.");

  AddInfo(DEFAULT_INFO, "laesst sich nicht von seinem Wachdienst ablenken.\n");

  AddInfo("midas", 
    "Was fuer eine gefaehrliche Stadt! Lauter bewaffnete Irre laufen dort herum. "
    "Man kann nie sicher sein, nicht auf einmal hinterruecks ueberfallen und "
    "niedergemetzelt zu werden. Da geh ich nicht mehr hin.", "sagt: ");

  AddInfo("stadt", 
    "Welche Stadt meinst Du denn? Kyranda oder Midas?"
    , "sagt: ");

  AddInfo("irre", 
    "In Midas laufen lauter Irre herum. Einige meiner Kameraden haben durch die "
    "dran glauben muessen. Ich habe Glueck, dass ich ueberhaupt noch lebe!", 
    "sagt: ");

  AddInfo(({"kamerad", "kameraden"}), 
    "Ich hab schon viele Kameraden sterben sehen, das kann ich Dir sagen..."
    , "sagt: ");

  AddInfo(({"kyranda","militaerkaff"}), 
    "Ich hasse dieses Militaerkaff! Dauernd wird man angeschnauzt, weil man nicht "
    "salutiert hat, oder weil die Adjustierung nicht passt. Und macht man mal alles "
    "richtig, wird man trotzdem nicht befoerdert. Nur einen recht netten Vizeminor "
    "hatten wir, aber der hat mich auch nie befoerdert. Die Vizeminore erkennt man "
    "uebrigens an den drei Sternen und zwei Winkeln, glaub ich. Dieses "
    "Rangsystem hab ich nie so ganz kapiert..."
   , "sagt: ");

  AddInfo("rangsystem", 
    "Ich bin froh, dass wir das nicht mehr haben. Wir sind einfach alle Paladine."
    , "sagt: ");

  AddInfo(({"paladine", "paladin"}), 
    "Ich bin recht gerne Paladin. Danke der Nachfrage."
    , "sagt: ");
 
  AddInfo(({"winkel", "sterne", "vizeminor", "vizeminore"}), 
    "Oder waren es drei Winkel und zwei Sterne? *gruebel*"
    , "sagt: ");
 
  AddInfo(({"adjustierung"}), 
    "Das ist mir egal. Ich ziehe an, was mir passt."
    , "sagt: ");



  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Paladin sagt: Danke, ich werde es einem wohltaetigem Zweck "
    "spenden.\n" }) );

  SetProp(P_SPELLRATE, 25);
  AddSpell(1,300,
    "Der Paladin schiesst einen heiligen Zauber auf Dich ab.\n",
    "Der Paladin schiesst einen heiligen Zauber auf @WEN ab.\n",
     DT_HOLY,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,100,
    "Ein kleiner Blitz schiesst aus den Haenden des Paladins auf Dich zu.\n",
    "Ein kleiner Blitz schiesst aus den Haenden des Paladins auf @WEN zu.\n",
     DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,200,
    "Der Paladin ueberrascht Dich mit einer geschickten Finte.\n",
    "Der Paladin ueberrascht @WEN mit einer geschickten Finte.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  SUID;
  
  CLONEME("/obj/fackel");
  CLONEME("/p/armour/kettenhemd");
  CLONEME("/p/weapon/langschwert");
  CLONEME("/p/armour/lederstiefel");
  CLONEME("/p/armour/eisenschild");
  
  command_me("zuecke schwert");
  command_me("trage alles");

  AddInfo(({ "fackel" }), #'gibfackel);


}
