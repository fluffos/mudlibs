#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../def.h"

inherit NPC "orden";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Nonne");
  SetProp(P_LONG, 
    "Eine Nonne mit schwarzem Rock und schwarzem Kopftuch. Sie sieht Dich "
    "mit grossen und etwas verschreckten Augen an. Man sieht an ihr aber trotz"
    "ihrer Schuechternheit so etwas wie eine heilige Ausstrahlung.");
  SetProp(P_NAME, "Nonne");
  SetProp(P_GENDER, FEMALE);
  AddId(({ "nonne"}));

  create_default_npc(10);

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 150 + random(5));
  SetProp(P_ALIGN, 700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "trippelt herein");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "erscheint unauffaellig");
  SetProp(P_MMSGOUT, "geht unauffaellig");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "sagt: Bitte, ich muss mich auf meine Aufgaben "
        "konzentrieren, lass mich!\n");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Die Nonne sagt: Ich habe dem Weltlichen entsagt.\n" }) );

   //CLONEME( "/p/armour/kutte");
  
  command_me("trage alles");

}

