
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

inherit "std/npc";


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Engelchen");
  SetProp(P_LONG, 
    "Ein winziges Engelchen mit goldenen Engelsfluegeln flattert vor Dir "
    "herum. Es hat den Koerper eines Saeuglings und das Gesicht eines "
    "Kleinkindes. Grosse, runde Kulleraugen werden von lockigen, blonden "
    "Haaren umrahmt. Bis auf einen weissen Lendenschurz ist das Engelchen "
    "voellig nackt. Das Engelchen scheint ausserdem irgendwie von innen "
    "zu leuchten.");

  AddDetail( ({ "engelsfluegel", "fluegel" }), 
    "Die Fluegel bestehen aus irgendeinem weissen Material, in das lauter "
    "goldene Faeden eingewoben wurden. Trotzdem sind die Fluegel fest "
    "mit dem Koerper des Engelchens verwachsen." );
  AddDetail( ({ "koerper" }), 
    "Klein, leicht und zerbrechlich, wie der eines Saeuglings." );
  AddDetail( ({ "gesicht", "kindergesicht" }), 
    "Ein richtiges Kindergesicht hat das Engelchen." );
  AddDetail( ({ "augen", "kulleraugen" }), 
    "Sie blicken Dich treuherzig an." );
  AddDetail( ({ "haar", "haare", "locken" }), 
    "Lauter blonde Locken umrahmen das Gesicht des Engelchens." );
  AddDetail( ({ "schurz", "lendenschurz" }), 
    "Bis auf diesen einfachen - aber picobello sauberen - Lendenschurz ist "
    "das Engelchen nackt." );
  AddDetail( ({ "faeden" }), 
    "Goldene Faeden wachsen aus dem Engelchenkoerper und flechten sich "
    "magisch in die Fluegel hinein." );

  SetProp(P_LIGHT, 1);
  SetProp(P_NAME, "Engelchen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"engelchen", "engel", "engerl", "Engerl"}));

  create_default_npc(7);

  SetProp(P_HANDS, ({" mit kleinen Faeustchen",50,({DT_HOLY,DT_BLUDGEON})}));
  SetProp(P_RACE, "Engel");
  SetProp(P_SIZE, 45);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

//  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:0, DT:FIRE:0, DT_SLASH:0]) );

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "erscheint in gleissendem Licht");
  SetProp(P_MMSGOUT, "verschwindet auf einer Schaefchenwolke");

  SetProp(P_DIE_MSG,  " fliegt in den Himmel.\n");
  SetProp(P_NOCORPSE, 1 );
//  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Engelchen");
  SetProp(P_KILL_MSG, "Halleluja!");

  AddInfo(DEFAULT_INFO, "spricht nur Engelisch.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "<name> will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,80);

  AddSpell(1,160,
    "Das Engelchen schiesst mit einem Pfeil auf Dich.\n",
    "Das Engelchen beschiesst @WEN mit einem Pfeil.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,100,
    "Das Engelchen huellt Dich in ein Nebelwoelkchen.\n",
    "Das Engelchen huellt @WEN in ein Nebelwoelkchen.\n",
     DT_AIR,"paralyse",([SP_SHOW_DAMAGE:1]));

  AddSpell(1,75,
    "Das Engelchen bespritzt Dich mit etwas Weihwasser.\n",
    "Das Engelchen bespritzt @WEN mit etwas Weihwasser.\n",
     ({DT_HOLY, DT_WATER}),([SP_SHOW_DAMAGE:1]));

  AddSpell(1,250,
    "Das Engelchen brutzelt Dich mit einem Blitz.\n",
    "Das Engelchen brutzelt @WEN mit einem Blitz.\n",
     DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 1,
    "Das Engelchen stimmt einen Engelschor an.\n",
    "Das Engelchen stimmt einen Engelschor an.\n",
     DT_SOUND,"choir",([SP_SHOW_DAMAGE:1]));

  SetAttackChats(20, ({
  "Das Engelchen schwirrt um Dich herum.\n",
  "Das Engelchen flattert aufgeregt mit seinen kleinen Fluegeln.\n",
  "Das Engelchen bekommt ganz rote Pausbaeckchen.\n",
  "Das Engelchen frohlockt ein wenig.\n",
  "Das Engelchen versucht, Dich zu zwicken.\n",
  "Das Engelchen jubiliert ob eines erfolgreichen Angriffes.\n",
  "Das Engelchen singt: Halleluja!\n"
     }) );
}


// Buggt noch !!!
void paralyse(object enemy, int damage, mixed dam_type)
{
  int para;
  if (mappingp(enemy->QueryProp(P_PARALYZED)))
    para=(enemy->QueryProp(P_PARALYZED))[PARALYZE_TIME];
//   DB(para);
  enemy->SetProp(P_PARALYZED, para + 1 ); // 1 HB paralysiert
}



// Mitloggen wenn der NPC einen Spieler killt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "npc.deads",
    ctime()+": Ein Engerl hat gerade "+CAP(getuid(TP))+" umgebracht.\n");
  call_out("die",4);
}



void choir(object enemy, int damage, mixed dam_type)
{
  int num, i;
  object *alle;

  num=0;
  for (i=sizeof(alle=all_inventory(environment(TO)))-1;i>=0;i--) 
    if (alle[i]->id("Engerl") && ++num && alle[i]!=TO )
      tell_room(ENV(TO), alle[i]->Name()+" stimmt mit ein.\n");

  enemy->Defend(num * 100, DT_SOUND, ([SP_SHOW_DAMAGE:1]), TO);
}


