#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

inherit NPC "orden";


#define PAL_INDENT "Der schlaftrunkene Paladin "


void create()
{

  creation_time=time();

  if (!is_clone(TO)) return;
  ::create();

  call_out("remove_self", 20+random(10));

  SetProp(P_SHORT, "Der schlaftrunkene Paladin");
  SetProp(P_LONG, 
    "Vor Dir steht ein grummelig aussehender Mann mit zerzausten Haaren und "
    "ziemlich schlimmem Mundgeruch. Er traegt nur seine Unterwaesche und "
    "eine halb herunterhaengende Zipfelmuetze. Aus verschlafenen Augen sieht "
    "er Dich grantig an. Anscheinend macht er Dich dafuer verantwortlich, "
    "dass er aufgeweckt wurde.");
  SetProp (P_NAME, "Paladin");
  SetProp(P_GENDER, MALE);
  AddId(({ "paladin", "wache", "waechter", "mann" }));
  AddAdjective( ({"schlaftrunkener", "schlaftrunkenen"}) );
  create_default_npc(13);
  
  SetProp(P_RACE, "Mensch" );
  SetProp(P_SIZE, 170 + random(15));
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC, 0);
  SetProp(P_HANDS,({ "verschlafen", 100, DT_BLUDGEON }) );
  SetProp(P_ALCOHOL, 20);
  SetProp(P_SMELL, 
    BS("Da er gerade erst aufgestanden ist und noch nicht die Zaehne geputzt "
       "hat, hat er noch einen starken Mundgeruch. Ausserdem duerfte er vor "
       "dem Zubettgehen noch ordenlich gebechert haben, denn ganz nuechtern "
       "kommt er Dir nicht vor."));

  AddDetail( ({ "unterwaesche" }), 
    "Pfui, die ist ja schmutzig! Man sieht noch ueberall die Spuren, die sein "
    "frisch geoeltes Kettenhemd hinterlassen hat." );
  AddDetail( ({ "muetze", "zipfelmuetze" }), 
    "Sie haengt schief vom Kopf. Seine zerzausten Haare schauen darunter "
    "hervor." );
  AddDetail( ({ "kopf" }), 
    "Da sind zerzauste Haare, eine Zipfelmuetze und grantige Augen dran." );
  AddDetail( ({ "auge", "augen" }), 
    "Rotgeraendert und unausgeschlafen wirkt der Paladin auf Dich." );
  AddDetail( ({ "haare" }), 
    "Zerzaust und verwuschelt sind seine Haare." );


  SetChats(20, ({
    BS(PAL_INDENT "reibt sich die Augen."), 
    BS(PAL_INDENT "gaehnt."), 
    BS(PAL_INDENT "kratzt sich am Kopf."), 
    BS(PAL_INDENT "wundert sich."), 
    BS(PAL_INDENT "schaut sich verschlafen um und kennt sich nicht aus."), 
    break_string("Welcher Depp hat mich denn aufgeweckt?"
      ,78, PAL_INDENT "grummelt: "), 
    break_string("Sooo gut hab ich getraeumt.",78, PAL_INDENT "sagt: "), 
    break_string("Ich hab getraeumt, ich erwisch so einen elenden "
       "Dunkelelfen. HA! War das ein toller Traum. Moechte wissen, welcher "
       "Trottel mich aufgeweckt hat.",78, PAL_INDENT "sagt: "), 
    break_string("Soguthabichgeschlafenschweinereisowas."
      ,78, PAL_INDENT "murmelt: " ), 
    break_string("Ich glaub ich geh wieder bueseln."
      ,78, PAL_INDENT "sagt: "), 
    break_string("Hab ja noch fast 2 Stunden bis zur Wachabloese."
      ,78, PAL_INDENT "murmelt: "), 
    break_string("Was ist denn eigentlich los hier?"
      ,78, PAL_INDENT "fragt: "), 
               }) );
  AddInfo(({ DEFAULT_INFO }), "Wieso laesst Du mich nicht weiterschlafen, Du "
                              "sadistischer Teufel?", "sagt: ");
  AddInfo(({ "teufel", "stahldorn" }), 
     "Der Teufel? Wo?", "sagt erschrocken: ");

}


int remove_self()
{
  if (!InFight())
  {
    if(is_clone(TO) && objectp(ENV(TO)))
    {
      tell_room(ENV(TO),"Der schlaftrunkene Paladin geht wieder schlafen.\n");
      (ROOM+"wachraum")->CloseKoje();    
    }
  }
  else
  {
    call_out("remove_self", 10 + random(10));
    return 0;
  }
  return remove();
}
