// /d/gebirge/feyaria/blut/npc/ritter.c  
// Ein Ritter des heiligen Ordens
// 1997-04-12  Feyaria@SilberLand


#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include <wizlevels.h>
#include "../def.h"

inherit NPC "orden";
inherit "std/npc/spells";

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Ritter des heiligen Ordens");
  SetProp(P_LONG, BS(
    "Dieser Ritter gehoert dem alten heiligen Orden an, der sich der "
    "Bekaempfung alles Boesen gewidmet hat. Er traegt eine blinkende "
    "Kettenruestung aus bestem Stahl und einen weissen Wappenrock mit dem "
    "Wappen des alten Ordens: ein langes Schwert gekreuzt mit einer roten "
    "Rose. Scheinbar ist der Ritter schon sehr alt, denn sein dicker "
    "Schnurrbart ist schon ganz grau, aber trotzdem scheint er noch im "
    "Vollbesitz seiner kaempferischen Kraefte zu sein."));
  SetProp(P_NAME, "Ordensritter");
  SetProp(P_GENDER, MALE);
  AddId(({"ritter", "ordensritter", }));
  set_living_name("ritter");

  create_default_npc(33, 1400);
  SetProp(P_HANDS, ({" mit seinen stahlharten Faeusten", 300, DT_BLUDGEON}));
  SetAttribute(A_STR, 50);
  SetAttribute(A_DEX, 40);
  SetProp(P_XP, QueryProp(P_XP)+1500*100); 
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(15) );
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 20);
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_FIRE       :-0.2,     DT_COLD       :-0.3,     DT_LIGHTNING  :0.25,
    DT_LIGHT      :-0.7,     DT_HOLY       :-0.7,     DT_UNHOLY     :0.2]) );

  SetProp(P_MSGIN, "marschiert herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "erscheint in gleissendem Licht");
  SetProp(P_MMSGOUT, "verschwindet in gleissendem Licht");

  SetProp(P_DIE_MSG,  " stirbt fuer seinen heiligen Orden.\n");
  SetProp(P_KILL_NAME, "Ein Ritter des heiligen Ordens");
  SetProp(P_KILL_MSG, "Moegest Du fuer immer in der Hoelle schmoren!");

  AddInfo(DEFAULT_INFO, ({
    "erzaehlt Dir eine Anekdote aus der Ordensgeschichte.\n",
    "denkt sich seinen Teil.\n",
    "sagt: Dazu steht nichts in den Ordensreglen.\n",
    "sagt: Das ist gegen meinen Ehrenkodex!\n"}) );
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  AddInfo("stahldorn", "Stahldorn hat mich zu Leben erweckt.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Ordensritter sagt: Ich habe geschworen, in Armut zu leben.\n"}) );

  SetProp(P_SPELLRATE,70);
  AddSpell(5,500,
    "Der Ordensritter beschwoert himmlisches Licht auf Dich herab.\n",
    "Der Ordensritter beschwoert himmlisches Licht auf @WEN herab.\n",
     DT_LIGHT,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,750,
    "Der Ordensritter sucht Dich zu entwaffnen.\n",
    "Der Ordensritter sucht @WEN zu entwaffnen.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1,500, DS_DISARM,
    "Der Ordensritter entwaffnet Dich.\n",
    "Der Ordensritter entwaffnet @WEN.\n");
  AddSpell(1,1000,
    "Der Ordensritter vertreibt das Boese aus Dir.\n",
    "Der Ordensritter vertreibt das Boese aus @WEM.\n",
     DT_HOLY,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Ordensritter rezitiert ein Gebot aus seinem Ehrenkodex.\n",
    "Der Ordensritter versucht, das Boese von hier zu vertreiben.\n",
    "Der Ordensritter richtet seine Ruestung.\n"}) );
  SetAttackChats(10, ({
    "Der Ordensritter schimpft ueber Deine unehrenhafte Kampfweise.\n"}) );

  SUID;
  if( random(100)>90 ) CLONEME(ARMOUR "h_amulet" );
  if( random(100)>75 ) CLONEME("/p/armour/glove/kettenhandschuhe" );
  if( random(100)>60 ) CLONEME(ARMOUR "kettenbeinlinge" );
  if( random(100)>50 ) CLONEME("/p/armour/helm/kettenhaube" );
  CLONEME(PALAARMOUR "wappenmantel" );
  CLONEME("/p/armour/armour/kettenpanzer" );
  CLONEME("/p/armour/shield/turmschild" );
  command("trage alles");
  CLONEME(WEAPON "hschwert" );
  command("zuecke schwert");
}

// Mitloggen wenn einen Spieler den NPC killt:
void die(int poisondeath)
{
  write_file(LOG "ritter", dtime(time())+" "+CAP(getuid(TP))+
    " killt den Ritter.\n");
  ::die(poisondeath);
}


// Mitloggen wenn der NPC einen Spielerkillt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "kills",
  sprintf(" %s %s vom Ritter umgebracht. ( -%d XP ).\n",
      dtime(time()), CAP( player->query_real_name() ), lostexp ));
}

void init()
{
  ::init();
  if( TP && interactive(TP) )
  {
    if(!IS_LEARNING(TP) && TP->QueryProp(P_ALIGN)<-900+random(400) )
    {
      write("Der Ordensritter hat Deine Schlechtheit erkannt!\n");
      say("Der Ordensritter hat "+TP->name(WESSEN)+" Schlechtheit erkannt!\n");
      Kill(TP);
    } 
  }
}

