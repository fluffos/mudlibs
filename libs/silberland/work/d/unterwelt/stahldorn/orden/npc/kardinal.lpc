#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../def.h"

inherit NPC "orden";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Kardinal");
  SetProp(P_LONG, 
    ""
    ".");
  SetProp(P_NAME, "Kardinal");
  SetProp(P_GENDER, MALE);
  AddId(({ "kardinal"}));

  create_default_npc(35);

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 168);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "kommt unauffaellig herein");
  SetProp(P_MSGOUT, "geht leise");
  SetProp(P_MMSGIN, "kommt zu Dir herab");
  SetProp(P_MMSGOUT, "verschwindet irgendwohin");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "deutet auf seinen Mund und schuettelt den Kopf.\n");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Moench schuettelt bescheiden den Kopf und verweigert Dein "
    "Geschenk.\n" }) );

  SetProp(P_SPELLRATE, 40);
  SUID;
  CLONEME("/p/armour/robe");
  
  command_me("trage alles");
}


