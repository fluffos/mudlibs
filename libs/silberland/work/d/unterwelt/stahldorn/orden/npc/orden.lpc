#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <class.h>
#include "../def.h"

inherit "std/mnpc";

create()
{
  ::create();
  AddId("Bruder des Ordens");
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_HOLY: -0.1]));
  SetProp(P_MNPC_FLAGS, 0);
  SUID;
}


void init()
{
    ::init();
    
    if(TP->is_class_member(CL_DEMON) && !IS_LEARNING(TP))
    {
      if(member(QueryEnemies()[0], TP) == -1)
        domainshout(break_string(
          "Ein Daemon ist in den Orden eingedrungen! Toetet ihn! Zu den "
          "Waffen!", 78,"Von irgendwo ruft "+name(WER,0)+": "), ROOM,1);
      Kill(TP);
    }
    if( (TP->QueryProp(P_GHOST) && interactive(TP) && !IS_LEARNING(TP))
        || TP->id("geist") )
    {
      DB("DOMAINSHOUT");
      domainshout(break_string(
         "Ein Geist ist in den Orden eingedrungen! Vertreibt ihn! Holt "
         "den Exorzisten!", 78,"Von irgendwo ruft "+name(WER,0)+": ")/*,
           "^"+ROOM+".*",1*/);
//      write("Ein Exorzist kommt an und treibt Dich aus.\n");
//      say("Ein Exorzist kommt an und treibt "+TP->name(WEN)+" aus.\n");
//      clone_object("/room/death/death_mark")->move(TP, M_NOCHECK);
//      TP->move("/room/death", M_TPORT);
    }
    if(TP->is_class_member(CL_UNDEAD))
    {
      if(member(QueryEnemies()[0], TP) == -1)
        domainshout(break_string(
          "Ein Untoter ist in den Orden eingedrungen! Vernichtet ihn! Zu den "
          "Waffen!", 78,"Von irgendwo ruft "+name(WER,0)+": "), ROOM,1);
      Kill(TP);
    }
    
/****  HMMM Muss ich mir noch ueberlegen ****

    if (TP->QueryProp(P_ALIGN) < -500 && !IS_LEARNING(TP))
    {
	tell_room (MENV, 
	       Name()+" bruellt: Das Boese! Es muss vernichtet werden!\n");
	Kill(TP);
    }
****   */

    if(TP->id("Bruder des Ordens")) 
       AddDefender(TP);

}


void InformDefend(object enemy) {  Kill(enemy);  }

