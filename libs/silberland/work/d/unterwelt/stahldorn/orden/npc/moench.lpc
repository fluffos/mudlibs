#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../def.h"

inherit NPC "orden";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Moench");
  SetProp(P_LONG, 
    "Du siehst einen mittelmaessig grossen Moench mit brauner Robe vor Dir."
    "Sein Gesicht ist fast ganz verborgen, lediglich seine lange, weisse "
    "Nase lugt etwas unter seiner Kapuze hervor. Irgendwie sieht Sie "
    "ziemlich hoelzern und schief aus. Er hat diese Nase sicher nicht durch "
    "das Erzaehlen von Halbwahrheiten bekommen, denn er ist auffaellig "
    "schweigsam.");
  SetProp(P_NAME, "Moench");
  SetProp(P_GENDER, MALE);
  AddId(({ "moench"}));

  AddDetail( ({ "nase" }), 
    "Sie ist etwas schief. Vielleicht hat ein anderer Moench beim "
    "Boxtraining zu hart getroffen?" );

  create_default_npc(15);

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 168);
  SetProp(P_ALIGN, 850);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "kommt unauffaellig herein");
  SetProp(P_MSGOUT, "geht leise");
  SetProp(P_MMSGIN, "kommt zu Dir herab");
  SetProp(P_MMSGOUT, "verschwindet irgendwohin");

  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 5, 20, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "zentralhalle");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS | MOV_MOVES);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "deutet auf seinen Mund und schuettelt den Kopf.\n");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Moench schuettelt bescheiden den Kopf und verweigert Dein "
    "Geschenk.\n" }) );

  SetProp(P_SPELLRATE, 40);
  AddSpell(1,100,
    "Der Moench wirbelt mit seiner Robe herum und trifft Dich schmerzhaft.\n",
    "Der Moench wirbelt auf einmal durch die Gegend und trifft @WEN hart.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,150,
    "Der Moench tritt Dir mit einem gekonnten Sprung-Kick "
       "in die Bauchgegend.\n",
    "Der Moench tritt @WEM mit einem Sprung-Kick in den Bauch.\n",
     DT_HOLY,([SP_SHOW_DAMAGE:1]));

  SUID;
  //CLONEME("/p/armour/kutte");
  
  command_me("trage alles");
}


