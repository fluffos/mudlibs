
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

inherit NPC "orden";


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Erzengel");
  SetProp(P_LONG, 
    "");

  AddDetail( ({ "engelsfluegel", "fluegel" }), 
    "Die Fluegel bestehen aus irgendeinem weissen Material, in das lauter "
    "goldene Faeden eingewoben wurden. Trotzdem sind die Fluegel fest "
    "mit dem Koerper des Erzengels verwachsen." );
  AddDetail( ({ "faeden" }), 
    "Goldene Faeden wachsen aus dem Engelchenkoerper und flechten sich "
    "magisch in die Fluegel hinein." );

  SetProp(P_LIGHT, 1);
  SetProp(P_NAME, "Erzengel");
  SetProp(P_GENDER, MALE);
  AddId(({"erzengel", "engel", "Engerl"}));

  create_default_npc(28);

  SetProp(P_HANDS, ({" mit himmlischen Faeusten",150,
    ({DT_HOLY,DT_BLUDGEON})}));
  SetProp(P_RACE, "Engel");
  SetProp(P_SIZE, 205);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

//  SetProp( P_RESISTANCE_STRENGTHS, ([DT_MAGIC:0, DT:FIRE:0, DT_SLASH:0]) );

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "erscheint in gleissendem Licht");
  SetProp(P_MMSGOUT, "verschwindet auf einer Schaefchenwolke");

  SetProp(P_DIE_MSG,  " fliegt in den Himmel.\n");
  SetProp(P_NOCORPSE, 1 );
//  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Ein Erzengel");
  SetProp(P_KILL_MSG, "Halleluja!");

  AddInfo(DEFAULT_INFO, "spricht nur Engelisch.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Erzengel nimmt keine Spenden an.\n" }) );

  SetProp(P_SPELLRATE,80);

  AddSpell(1,360,
    "Der Erzengel schiesst mit einem Pfeil auf Dich.\n",
    "Der Erzengel beschiesst @WEN mit einem Pfeil.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,100,
    "Der Erzengel huellt Dich in eine Nebelwolke.\n",
    "Der Erzengel huellt @WEN in eine Nebelwolke.\n",
     DT_AIR,"paralyse",([SP_SHOW_DAMAGE:1]));

  AddSpell(1,275,
    "Der Erzengel bespritzt Dich mit etwas Weihwasser.\n",
    "Der Erzengel bespritzt @WEN mit etwas Weihwasser.\n",
     ({DT_HOLY, DT_WATER}),([SP_SHOW_DAMAGE:1]));

  AddSpell(1,250,
    "Der Erzengel brutzelt Dich mit einem Blitz.\n",
    "Der Erzengel brutzelt @WEN mit einem Blitz.\n",
     DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 1,
    "Der Erzengel stimmt einen Engelschor an.\n",
    "Der Erzengel stimmt einen Engelschor an.\n",
     DT_SOUND,"choir",([SP_SHOW_DAMAGE:1]));


  SetAttackChats(15, ({
    "@@heilung@@"}) );

}

int freund(object vielleichtfreund)
{
  return vielleichtfreund->id("Bruder des Ordens");
}

string heilung()
{
  object wen;
  object *freunde;
  freunde=filter_array(all_inventory(environment(TP)), #'freund) - ({TO});
  if(sizeof(freunde) )
  {
    wen=freunde[random(sizeof(freunde))];
    wen->heal_self(50+random(50));
    return BS("Der Erzengel schreit: 'Hallelujah! Gelobet Sei Dusty in der Hoeh!' "
           "und heilt "+wen->name(WEN)+".");
  }
  return "Der Erzengel singt: 'Hallelujah!'\n";  
}

// Buggt noch !!!
void paralyse(object enemy, int damage, mixed dam_type)
{
  int para;
  if (mappingp(enemy->QueryProp(P_PARALYZED)))
    para=(enemy->QueryProp(P_PARALYZED))[PARALYZE_TIME];
// DB(para);
  enemy->SetProp(P_PARALYZED, para + 2 ); // 2 HB paralysiert
}


// Mitloggen wenn der NPC einen Spieler killt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "npc.deads",
    ctime()+": Der Erzengel hat gerade "+CAP(getuid(TP))+" umgebracht.\n");
}

// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath)
{
  write_file(LOG "npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt den Erzengel.\n");
  ::die(poisondeath);
}


void choir(object enemy, int damage, mixed dam_type)
{
  int num, i;
  object *alle;

  num=0;
  for (i=sizeof(alle=all_inventory(environment(TO)))-1;i>=0;i--) 
    if (alle[i]->id("Engerl") && num++)
      tell_room(ENV(TO), alle[i]->Name()+" stimmt mit ein.\n");

  enemy->Defend(num * 100, DT_SOUND, ([SP_SHOW_DAMAGE:1]), TO);
}


