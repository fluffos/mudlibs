#include "../def.h"
#include <properties.h>
#include <language.h>


inherit "std/room";

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Zum Heiligen Orden" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_INT_LONG,
    "Ein schlichter, mittelgrosser Raum erwartet Dich hier. Die weiss "
    "getuenchten Waende wirken ein klein wenig kuehl auf Dich. Auffaellig "
    "sind noch zwei kleine Statuen, die man in eigenen Nischen aufgestellt "
    "hat. Erhellt wird der Raum durch einen dreiarmigen Kerzenleuchter in "
    "einer weiteren Nische.");

  AddDetail( ({ "raum" }), QueryProp(P_INT_LONG) );
  AddDetail( ({ "boden" }), 
    "Er besteht vollstaendig aus kalten Steinfliesen." );
  AddDetail( ({ "fliesen", "steinfliesen" }), 
    "Abwechselnd rote und weisse Steinfliesen bilden den Boden unter Dir." );
  AddDetail( ({ "wand", "waende" }), 
    "In den Waenden befinden sich drei Nischen. Zwei davon mit Statuen drin, "
    "eine beinhaltet lediglich einen Kerzenleuchter." );
  AddDetail( ({ "decke" }), 
    "Die Decke ist relativ weit oben." );
  AddDetail( ({ "loch", "schluesselloch" }), 
    "Das wurde fuer einen ganz schoen grossen Schluessel gemacht." );
  AddDetail( ({ "statue", "statuen" }), 
    "Beide Statuen stellen den Heiligen Stanislaus Genofevius von Ariola "
    "dar. Sie gleichen sich sehr. Auch die Haltung und der Gesichtsausdruck "
    "sind aehnlich." );
  AddDetail( ({ "nische", "nischen" }), 
    "In den Nischen stehen Statuen. Und ein Kerzenleuchter." );
  AddDetail( ({ "kerzenleuchter", "leuchter" }), 
    "Der Kerzenleuchter sieht nicht recht wertvoll aus." );
  AddDetail( ({ "kerzen", "kerze" }), 
    "Die Kerzen flackern vor sich hin und geben dem Raum ein wenig Licht, "
    "obwohl der Hauptteil der Beleuchtung eher aus den "
    "Nachbarraeumen stammt." );
  AddDetail( ({ "haltung", "gesichtsausdruck", "gesicht", "ausdruck" }), 
    "Leicht heroisch, auf jeden Fall aber heilig." );
  AddDetail( ({ "stanislaus", "genofevius", "heiliger" }), 
    "Der muss ja ein toller Hecht gewesen sein, dass man ihn hier so "
    "verehrt." );
  AddDetail( ({ "licht", "beleuchtung" }), 
    "Gerade ausreichend." );
  AddDetail( ({ "nachbarraum", "nachbarraeume" }), 
    "Einer befindet sich noerdlich, ein anderer oestlich von Dir. "
    "Am besten, Du gehst hin und siehst Dir die beiden selber an." );


  NewDoor("sueden", ROOM "tor", "portal", 
     ({D_FLAGS, DOOR_RESET_CL, 
       D_NAME, "Portal",
       D_GENDER, NEUTER, 
       D_FUNC2, "tuerzu", 
       D_SHORT, "Ein %ses Portal.",
       D_LONG, BS("Auf dieser Seite ist das Portal leider nicht so schoen "
                  "wie auf der anderen. Es fuehrt nach Sueden aus dem Orden "
                  "hinaus.") }));

  AddExit("osten", ROOM "zentralhalle");
  AddExit("norden", ROOM "wachraum");

}


