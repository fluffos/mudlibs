#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include <moving.h>


inherit "std/room";

int lochvoll;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Zentralhalle des Heiligen Ordens" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_INT_LONG,
    "Eine hohe, kuppelfoermige Halle tut sich vor Dir auf. "
    "Unzaehlige Kerzen, die so gut versteckt angebracht sind, dass man sie "
    "nur erahnen kann, verleihen dieser Oertlichkeit eine geheimnisvoll "
    "schoene Atmosphaere. Auch der interessante Geruch und die relative "
    "Kuehle tragen zur Stimmung bei. Bis auf ein paar Ordensmitglieder, die "
    "hin und wieder herein und wieder hinaus huschen ist die Halle ziemlich "
    "leer. Vier Durchgaenge fuehren in alle Richtungen hinaus.");
  AddDetail( ({ "halle", "raum", "oertlichkeit", "zentralhalle" }), 
    QueryProp(P_INT_LONG) );
  AddDetail( ({ "decke" }), 
    "Die Decke ist kuppelfoermig und relativ hoch ueber Dir. Es hat "
    "sicherlich "
    "ganz schoen lange gedauert, das alles aus dem Fels zu schlagen. Und die "
    "Bemalung der Decke ging wahrscheinlich auch nicht viel schneller, so "
    "wie sie aussieht. Die Bemalung der Kuppel wird durch vier steinerne "
    "Rippen geteilt." );
  AddDetail( ({ "wand", "waende" }), 
    "Die Waende sind im krassen Gegensatz zur Decke ziemlich schmucklos. "
    "Nur die irgendwie an und in den Waenden angebrachten Kerzen sind "
    "dort eventuell von Interesse." );
  AddDetail( ({ "boden" }), 
    "Er besteht vollstaendig aus kalten Steinfliesen." );
  AddDetail( ({ "fliesen", "steinfliesen" }), 
    "Abwechselnd rote und weisse Steinfliesen bilden den Boden unter Dir." );
  AddDetail( ({ "rote fliesen", "rote steinfliesen" }), 
    "Die roten Steinfliesen gefallen Dir besser. So eine schoene, heimelige "
    "Farbe. Sie erinnert Dich an die Liebe. An duftende Rosen in voller "
    "Bluete. An einen Sonnenuntergang an einem lauen Sommerabend. An die "
    "zaertlich geroeteten Wangen einer holden Maid. An das Blut das aus "
    "einer tiefen Bauchwunde des dreckigen Feindes quillt, waehrend er "
    "roechelnd und qualvoll stirbt..." );
  AddDetail( ({ "liebe", "rose", "rosen", "bluete", 
                "sonnenuntergang", "sommerabend", "wangen", "wange", 
                "blut", "bauchwunde", "rot" }), 
    "Einfach wunderschoen, dieses Rot." );
  AddDetail( ({ "weiss", "weisse fliesen", "weisse steinfliesen" }), 
    "Die weissen Fliesen sind sicher schlecht zu reinigen, weil man "
    "jeden kleinen Fleck sofort sieht." );
  AddDetail( ({ "fleck" }), 
    "Hmm. Da ist einer. Naja der ist klein, er gilt nicht. Dort ein "
    "etwas groesserer. SO schlecht zu reinigen sind die weissen "
    "Fliesen wohl doch nicht." );
  AddDetail( ({ "kerzen", "kerze", "interesse", }), 
    "Obwohl man von den Kerzen nicht viel erkennen kann, tauchen sie die "
    "Halle in ein zwar duesteres, aber dennoch sanft sakrales Licht." );
  AddDetail( ({ "licht", "kerzenlicht" }), 
    "Nicht viel, aber auch nicht zu wenig." );
  AddDetail( ({ "atmosphaere", "stimmung" }), 
    "Hier herrscht eine wirklich sakrale Stimmung, vermutlich ausgeloest "
    "durch den Geruch und das Kerzenlicht." );
  AddDetail( ({ "kuppel" }), 
    "Die Kuppel entspricht nicht etwa einer unten offenen Halbkugel, "
    "sondern eher vier leicht konkaven Splineflaechen, die an ihren "
    "Ueberschneidungen Kreuzrippen bilden." );
  AddDetail( ({ "splineflaechen", "flaechen", "verlaengerung", 
                "kuppelflaechen" }), 
    "Jede der Flaechen bildet eine logische, tangentiale Verlaengerung der "
    "geraden Wand darunter. Die Seitenkruemmung betraegt deshalb am Anfang "
    "noch null, aber gegen Kuppelmitte wird sie immer staerker, sodass "
    "die Winkel der Flaechen untereinander von 90 Grad unten "
    "bis fast 0 Grad ganz oben konvergieren. " );
  AddDetail( ({ "winkel" }), 
    "Der Winkel zwischen den Kuppelflaechen ist nicht konstant." );
  AddDetail( ({ "kruemmung", "seitenkruemmung" }), 
    "Die Kruemmung der Kuppelflaechen ist nicht konstant." );
  AddDetail( ({ "rippen", "kreuzrippen", "ueberschneidungen" }), 
    "Die Kreuzrippen beginnen da, wo die Waende beginnen, sich nach innen "
    "zu kruemmen. Da es vier Waende sind, gibt es auch vier Kreuzrippen. "
    "Sie sind aus roetlichem Stein, und treffen sich in der Mitte "
    "der Kuppel zu einem Kreuz. Daher der Name 'Kreuzrippen'." );
  AddDetail( ({ "mitte", "kuppelmitte", "kreuz" }), 
    "Dort treffen sich die vier Kreuzrippen. Als Du genauer hinsiehst, "
    "bemerkst Du ein kleines Loch, das man ganz leicht uebersehen koennte." );
  AddDetail( ({ "stein" }), 
    "Wahrscheinlich nur bemalt." );
  AddDetail( ({ "loch" }), 
    "Ein kleines Loch ganz oben in der Decke. Leider ist es viel zu hoch "
    "oben, als dass man mehr erkennen, oder gar hineingreifen koennte." );
  AddDetail( ({ "kuehle" }), 
    "Die Kuehle hier drinnen ist eigentlich sehr angenehm, solange man "
    "warm angezogen ist." );
  AddDetail( ({ "durchgaenge", "durchgang" }), 
    "Sie fuehren in verschiedene Richtungen." );
  AddDetail( ({ "ordensmitglieder", "ordensmitglied" }), 
    "Manchmal huscht ein Moench oder eine Nonne herein und verschwindet "
    "wieder in einem anderen Durchgang." );
  AddDetail( ({ "moench", "nonne" }), 
    "Im Moment ist grad niemand da." );
  AddDetail( ({ "fels" }), 
    "Diese Halle wurde aus dem Fels in harter Arbeit herausgemeisselt." );
  AddDetail( ({ "bemalung", "deckenbemalung" }), 
    "Deckenfresken von einzigartiger Kitschigkeit blicken auf Dich herab. "
    "" );
  AddDetail( ({ "fresko", "fresken", "deckenfresken", "deckenfresko" }), 
    "Die gestochen klare Farbgebung kombiniert mit der einzigartigen "
    "Brillianz der Pinselfuehrung geben den Fresken eine Aussagekraft, die "
    "Dir den Atem raubt. Dieser 'Kuenstler' gehoert aufgehaengt." );
  AddDetail( ({ "kitsch", "kitschigkeit", "zeug" }), 
    "Uebergewichtige Engel, gueldene Posaunen, Schaefchenwolken, "
    "Heiligenscheine, daemonenmetzelnde Helden und so Zeug halt." );
  AddDetail( ({ "helden","held" }), 
    "'Fabio'-Typen mit dicken Muskeln und schmierigem Grinsen." );
  AddDetail( ({ "engel", "figuren" }), 
    "Vom Koerperbau her sehen die Engel aus wie dicke Saeuglinge, aber die "
    "doofen Pausbaeckchengesichter passen ueberhaupt nicht dazu." );
  AddDetail( ({ "pausbaeckchengesichter", "pausbaeckchen","gesichter" }), 
    "Sieht zum Kotzen kitschig aus." );
  AddDetail( ({ "posaunen" }), 
    "Waeh. Sowas unnoetiges." );
  AddDetail( ({ "wolken", "schaefchenwolken" }), 
    "Die obligatorischen Wolken, auf denen sich dieses ganze Himmelstralala "
    "immer abspielt." );
  AddDetail( ({ "himmelstralala", "himmel" }), 
    "Naja, diese Englein die auf den Wolken herumtanzen, Hallelujas jauchzen "
    "und das alles halt." );
  AddDetail( ({ "heiligenscheine", "scheine" }), 
    "Die Figuren auf den Fresken wirken eher scheinheilig als "
    "heiligenscheinig." );
  AddDetail( ({ "kuenstler", "kerl", "sorte", "maler" }), 
    "Der Kerl, der die Deckenbemalung verbrochen hat, gehoert zu der "
    "Sorte Kuenstler, deren Bilder man nur aufhaengt, weil man den Maler "
    "selbst nicht erwischt hat." );
  AddDetail( ({ "farbgebung", "farbe", "farben" }), 
    "Knalligrosa und Himmelblau neben Schreiendgruen." );
  AddDetail( ({ "knalligrosa", "himmelblau", "schreiendgruen" }), 
    "Unter jeder Kritik." );
  AddDetail( ({ "pinselfuehrung", "brillianz" }), 
    "Hallo! Jemand zu Hause? Das nennt man ZYNISMUS! :)" );
  AddDetail( ({ "aussagekraft" }), 
    "Die Fresken sagen viel ueber den Maler aus. Besonders ueber seinen "
    "schlechten Geschmack." );
  AddDetail( ({ "muskeln", "grinsen" }), 
    "Widerlich." );

//  AddDetail( ({ "" }), 
//    "" );

  AddSmell( ({ DEFAULT_SMELL, "weihrauch", "kerzenwachs" }), 
    "Es riecht angenehm nach einer Mischung aus Weihrauch und Kerzenwachs." );


  AddExit("westen", ROOM "vorraum");
  AddExit("sueden", ROOM "exor");
  AddExit("osten", ROOM "altarraum");
  AddExit("norden", ROOM "refek");


  AddCmd( ({ "greif", "greife" }), "greifen" );

  lochvoll=1;

}

int greifen(string str)
{
  object kabel;

  notify_fail("In was moechtest Du hineingreifen?\n");
  if (str != "in loch" && str != "in loch hinein")  return 0;
  
  notify_fail(BS(
        "Das Loch ist leider viel zu weit oben, als dass Du einfach "
        "hineingreifen koenntest! Vielleicht, wenn Du eine Leiter "
        "haettest..."));
  if(!present("leiter", TO)) return 0;

  say(BS(
    TPN+" klettert flink auf eine Leiter und macht irgendwas an der Decke."));

  if(lochvoll)
  {
    kabel=clone_object(OBJ "kabel");
    kabel->move(TO);

    write(BS(
       "Du kletterst flink die Leiter hinauf und greifst in das Loch. Nach "
       "ein bisschen Herumtasten bekommst Du etwas zu fassen und ziehst fest "
       "daran.") );
    if(kabel->move(TP, M_GET) == 1)
      write(BS("Nach einem kurzen Ruck reisst etwas und Du hast ein kurzes "
      "Stueck von einer Art Schnur in den Haenden.") );
    else
      write(BS("Nach einem kurzen Ruck reisst etwas ab, aus irgendeinem "
        "Grund kannst Du es aber nicht mehr halten und es faellt zu Boden.") );
      
    lochvoll=0;
  }
  else
  {
    write(BS(
       "Du kletterst flink die Leiter hinauf und greifst in das Loch. "
       "Leider findest Du nichts.") );
  }
  
  write("Du kletterst wieder von der Leiter herunter.\n");
  return 1;
  
}

void reset()
{
  lochvoll=1;
  ::reset();
}

