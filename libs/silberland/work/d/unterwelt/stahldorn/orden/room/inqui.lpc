#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>


inherit "std/room";

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Inquisitionsraum" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 28, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_INT_LONG,
    "Hier ist eindeutig der Inquistionsraum. Hier werden Verdaechtige - oder "
    "auch Nichtverdaechtige - nach ihren Kenntnissen in verschiedenen "
    "Themengebieten befragt. An der Nordwand kannst Du ein paar hoch haengende "
    "Handschellen erkennen, Spiesse in allen Groessen und Dicken lehnen "
    "an der Westwand. Im hinteren Teil brennt lustig ein kleines Feuerchen "
    "vor sich hin, das Metallteile mit Holzgriffen zum Gluehen bringt. "
    "Dominierend im Vordergrund wirkt eine etwa zwei Meter lange Streckbank, "
    "die nicht gerade bequem aussieht. Ein Tischchen mit diversen Befragungs"
    "instrumenten steht links daneben.");

  AddDetail( ({ "boden" }), 
    "Der Boden wirkt fleckig und ungepflegt." );
  AddDetail( ({ "fleck", "flecken" }), 
    "Ein wenig Blut hier, ein bisschen Gedaerm da." );
  AddDetail( ({ "blut", "gedaerm", "details" }), 
    "Was soll ich da nur schreiben? Ich erspar Dir die unappetitlichen Details "
    "und ueberlass das Deiner Phantasie." );
  AddDetail( ({ "seile", "flaschenzuege" }), 
    "Die dienen irgendeinem unerfindlichen Zweck." );
  AddDetail( ({ "gestell", "holzgestell" }), 
    "Das Gestell an der Decke sieht robust genug aus, um sogar einen Troll "
    "in den verschiedensten Positionen zu halten. Als Du genau hinsiehst, "
    "kannst Du sogar noch die Reste eines Interviewten sehen, den man da "
    "oben anscheinend vergessen hat." );
  AddDetail( ({ "reste", "interviewten" }), 
    "Naja, recht viel ist nicht mehr uebrig, was einem Auskunft geben "
    "koennte." );
  AddDetail( ({ "zweck" }), 
    "Den weiss nur der Erbauer des Gestells. Und der Anwender. Und natuerlich "
    "erfaehrt der Gefesselte den Zweck auch sehr bald..." );
  AddDetail( ({ "decke" }), 
    "Ein seltsames Holzgestell mit Seilen und Flaschenzuegen haengt von der "
    "Decke." );
  AddDetail( ({ "spitzen", "spitze", "formen" }), 
    "Keine zwei Spitzen sind gleich geformt." );
  AddDetail( ({ "waende", "wand" }), 
    "Welche Wand meinst Du? Die Ost-, Nord-, Sued- oder Westwand?" );
  AddDetail( ({ "nordwand" }), 
    "An der Nordwand haengen in etwa dreieinhalb Metern Hoehe mehrere Paar "
    "Handschellen, die dazu dienen, jemanden am Runterfallen zu hindern." );
  AddDetail( ({ "westwand" }), 
    "Dort lehnen ein paar Spiesse und aehnlich brutales Zeug an der Wand." );
  AddDetail( ({ "suedwand" }), 
    "Dort brennt ein lustiges Feuerchen." );
  AddDetail( ({ "ostwand" }), 
    "Die Ostwand ist kahl und leer." );
  AddDetail( ({ "tischchen", "tisch" }), 
    "Massenhaft Befragungsinstrumente liegen da drauf und warten auf ihren "
    "Einsatz." );
  AddDetail( ({ "handschellen", "schellen", 
                "handschellenbefragungseinrichtungen" }), 
    "Die Handschellen an der Nordwand lassen mehrere Moeglichkeiten der "
    "Befragung zu: bottom-up und top-down, sowie bottom-down und top-up. "
    "Toll, wie variabel diese Dinger sind. "
    "Die Handschellenbefragungseinrichtungen sind derzeit unbesetzt." );
  AddDetail( ({ "feuerchen", "feuer" }), 
    "Es wird durch einen grossen Vorrat an Kohlen genaehrt. Sinn des "
    "Feuers ist es, die vielen Metallteile so zu erhitzen, dass sie in "
    "einem netten Rot zu Gluehen beginnen. Was dann mit diesen Teilen "
    "passiert, kannst Du Dir in leuchtenden Farben vorstellen." );
  AddDetail( ({ "spiess", "spiesse", "zeug" }), 
    "Spiesse zum Einfuehren, Durchbohren, Pieksen, Stechen, Schneiden und "
    "Drohen. Die Spitzen der eingeoelten Schaefte sind jedesmal voellig "
    "anders geformt, was tolle und unterschiedliche Effekte zur Folge "
    "haben kann." );
  AddDetail( ({ "schaefte" }), 
    "Die sind meistens eingeoelt. Warum, weisst Du nicht." );
  AddDetail( ({ "metallteile", "teile", "metall" }), 
    "Dabei handelt es sich neben kleineren Ausfuehrungen der Spiesse an der "
    "Westwand, vor allem um Zangen aller Art." );
  AddDetail( ({ "daumenschrauben" }), 
    "Die werden gewoehnlich benutzt, um Daumen einem gewissen aeusseren Druck "
    "auszusetzen, der den Daumenbesitzer dazu ermutigen soll, die Fragen des "
    "Inquisitors moeglichst ausfuehrlich und wahrheitsgetreu zu beantworten.");
  AddDetail( ({ "zangen", "zange", "zwickzangen", "beisszangen" }), 
    "Beiss- und Zwickzangen fuer Zehennaegel, Augenlider und aehnlich "
    "empfindliche Koerperstellen. Irgendwie hast Du keine Lust auf eine "
    "Behandlung mit diesen Dingen." );
  AddDetail( ({ "griffe", "holzgriffe" }), 
    "Damit der Inquisitor nicht die heissen Metallteile angreifen muss, und "
    "sich womoeglich ernsthafte Verbrennungen an den Handflaechen holt, "
    "muessen laut Paragraph 315, Abs. 3 der Inquisitorenarbeitsschutz"
    "bestimmungen alle direkt oder indirekt mit heissen (ueber 100 Grad "
    "Celsius) in Beruehrung befindlichen Arbeitsgeraete mit ausreichenden "
    "Schutzvorrichtungen versehen werden, welche den Bestimmungen des "
    "Paragraphen 98-4, Abs. 1, Pkt. 9, Zif. IV der Allgemeinen "
    "Inquisitionsgeraetesicherheitsbestimmungsauflage (6. Novelle) "
    "entsprechen." );
  AddSpecialDetail( ({ "streckbank", "bank", "vordergrund" }), "streckbank");
  AddDetail( ({ "instrumente", "befragungsinstrumente", 
                "arbeitsgeraete", "geraete" }), 
    "Daumenschrauben, Nadeln, Federn, heisses Oel und noch ein paar Zangen, "
    "sowie einige Peitschen." );
  AddDetail( ({ "peitschen", "peitsche" }), 
    "Damit werden die Gefangenen ausgepeitscht. Was sonst? Der Inquisitor "
    "mag diese Art von Waffen besonders gern." );
  AddDetail( ({ "nadeln" }), 
    "Je mehr Nadeln man benutzt, um den Befragten damit zu behandeln, desto "
    "schneller wird seine Sprechgeschwindigkeit, wobei ihr Kurvenverlauf "
    "exponential ansteigt. Das hat bereits der beruehmte "
    "Inquisitor Maximus Sadius del Torturro vor langer Zeit postuliert." );
  AddDetail( ({ "federn" }), 
    "Damit kann man den Befragten ordentlich an den Fussohlen kitzeln. Eine "
    "gemeine und hinterhaeltige Taktik, die besonders gut wirkt, wenn man "
    "dabei fiese Geraeusche macht wie 'killekillekillekillehihihi'." );
  AddDetail( ({ "oel" }), 
    "Aua, ist das heiss." );
  AddDetail( ({ "vorrat", "kohlen" }), 
    "Dass das lustige Feuerchen nicht so schnell ausgeht, dafuer sorgen "
    "die Kohlen, die jemand daneben gelagert hat." );
  AddDetail( ({ "gluehen", "rot" }), 
    "Nur rotgluehendes Metall kann dieses Gluehen hervorbringen." );

  AddSound( ({ "knistern", "feuer", DEFAULT_SOUND }), 
    "Das Feuer knistert froehlich." );
  AddSmell( ({ "schweiss", DEFAULT_SMELL }), 
    "Es riecht hauptsaechlich nach Schweiss." );

  AddExit("nordwesten", ROOM "exor");

}


string streckbank(string str)
{
  string ret;
  ret="";
  
  if(present("Befragter"))
    ret = "Ein leicht depressiv wirkender Dunkelelf hat darauf Platz genommen "
    "und brennt geradezu darauf, Fragen zu seiner Person, zur Fussball-WM "
    "oder zur Quantentheorie zu beantworten. ";

  return BS("Eine ganz gewoehnliche Streckbank der Marke Reiss&Zerr. " +ret);
}

