#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>


inherit "std/room";

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Dormitorium" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 24, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_INT_LONG,
    "Du siehst einen relativ grossen, schlauchfoermigen Raum mit vielen "
    "Betten an den Waenden, die in der Mitte einen engen Gang freilassen. "
    "An der gegenueberliegenden Wand haengt ein haessliches Kruzifix mit "
    "einem finster dreinblickenden Typen drauf. Auffaellig ist hier "
    "lediglich der furchtbar muffige Geruch, als ob hier seit Jahrhunderten "
    "nicht mehr gelueftet worden waere.");

  AddDetail( ({ "steinboden", "boden" }), 
    "Ein kalter und glatter Steinboden, der regelmaessig mit schmutzigem "
    "Wasser gewaschen zu werden scheint." );
  AddDetail( ({ "waende" }), 
    "Die Waende sind kahl, spartanisch, schmucklos. Ausser an der hinteren "
    "Wand, wo ein Kruzifix haengt.");
  AddDetail( ({ "wand" }), 
    "Ein Kruzifix haengt an der hintersten Wand des Saales. " );
  AddDetail( ({ "kruzifix", "kreuz", "holzkreuz" }), 
    "Ein zirka ein Meter hohes Holzkreuz, an das irgendein armer Kerl mit "
    "gigantischen Naegeln aus Gusseisen drangenagelt wurde!! Wie barbarisch! "
    "Aus zahllosen Wunden blutet der Mann, der fuerchterlich leiden muss, so "
    "wie er aussieht. Ueber dem Kreuz wurde eine kleine Plakette angebracht. "
    "Und neben dem Kreuz ist eine kleine Tafel.");
  AddDetail( ({ "tafel" }), 
    "Sie soll erklaeren, wer der Mann am Kreuz ist. Man kann sie lesen." );
  AddReadDetail( ({ "tafel" }), 
    "'Heiliger Sixtus Hirinius, Spitzname Hirni. Erster "
    "Ordensbruder, der sich in die Unterwelt wagte. Gloria seinem Namen! "
    "Sein Heldentod soll uns allen auf ewig ein Vorbild sein!'" );
  AddDetail( ({ "plakette" }), 
    "Eine einfache Plakette, auf der etwas draufsteht." );
  AddReadDetail( ({ "plakette" }), 
    "   HIRNI" );// ich hoff da fuehlt sich keiner auf den schlips getreten...
  AddDetail( ({ "typ", "mann", "kerl", "statue", "hirni", "sixtus", 
                "hirinius", "sixtus hirinius", "heiliger", "heiligen" }), 
    "Ein baertiger Mann in den Mittdreissigern... Oh! Als Du ihn genauer "
    "betrachtest, faellt Dir auf, dass es sich nur um eine ziemlich "
    "realistisch aussehende Statue handelt und nicht um einen echten "
    "Menschen. Drum hat er sich also nicht bewegt. Ist Dir doch gleich "
    "komisch vorgekommen. Das qualvoll verzerrte Gesicht des Mannes wurde "
    "mit beinahe sadistisch anmutender Genauigkeit modelliert. Ebenso wie "
    "seine vielen blutenden Wunden (*yuck*)." );
  AddDetail( ({ "augen" }), 
    "Grosse Augen. =8-)" );
  AddDetail( ({ "gesicht" }), 
    "Trotz der Schmerzen scheint es sich irgendwie streng auf einen Punkt "
    "ueber einem der Betten zu konzentrieren, als ob es dort etwas "
    "Interessantes zu sehen gaebe..." );
  AddDetail( ({ "punkt" }), 
    "Als Du die Blickrichtung verlaengerst und den Punkt genauer betrachtest, "
    "bemerkst Du ueber einem der Betten in der letzten Reihe ein kleines "
    "Poster, das Dir vorher entgangen ist." );
  AddDetail( ({ "poster" }), 
    "Hui! Ein - aehm - nett aussehendes Maedchen mit grossen... Augen sieht "
    "Dich laechelnd an. Ob so etwas hier erlaubt ist?" );
  AddDetail( ({ "maedchen" }), 
    "Geh, wo schaust Du denn hin? Schaem Dich!" );
  AddDetail( ({ "wunden" }), 
    "Viele Wunden zieren die Statue am Kreuz." );
  AddDetail( ({ "gang" }), 
    "Zwischen den Betten bleibt ein kleiner Gang frei." );
  AddDetail( ({ "decke" }), 
    "An der Decke haengen ein paar Oellampen." );
  AddDetail( ({ "lampen", "oellampen" }), 
    "Oellampen, die an der Decke haengen, erleuchten den Raum." );
  AddDetail( ({ "raum", "saal" }), QueryProp(P_INT_LONG) );
  AddDetail( ({ "bett", "betten" }), 
    "Simple Betten, die sicher nicht gerade weich sind. Sie sind zwar alle "
    "recht ordentlich gemacht, aber das Bettzeug starrt vor Dreck." );
  AddDetail( ({ "dreck" }), 
    "Pfui." );
  AddDetail( ({ "bettzeug" }), 
    "Das war wohl ehemals weiss. Jetzt wechselt die Farbe zwischen "
    "kakerlakenleichenbraun, rotzgelb und schweissgrau." );
  AddSmell( ({ "geruch",DEFAULT_SMELL }), 
    "Hier stinkt es nach ungewaschenen Fuessen und kalten Furzen. So "
    "muffig und stickig, dass Du kaum Luft bekommst." );
  AddSound( ({ DEFAULT_SOUND }), 
    "Man hoert nichts. Hier ists still." );
  AddSmell( ({ "fuesse" }), 
    "*schnueff* Nein, DEINE Fuesse sind sauber..." );
  AddSmell( ({ "furz", "furze" }), 
    "Pfui. Alt aber grauslich." );

  AddExit("sueden", ROOM "refek");
  AddExit("osten", ROOM "dormi2");

}


