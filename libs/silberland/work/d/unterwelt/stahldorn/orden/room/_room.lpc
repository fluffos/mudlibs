#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>


inherit "std/room";

create()
{
  ::create();

  SetProp( P_INT_SHORT, "" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_INT_LONG,
    ".");

}


