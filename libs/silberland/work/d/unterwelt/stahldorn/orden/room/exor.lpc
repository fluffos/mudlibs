#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>


inherit "std/room";


string weihrauch(string str);

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Exorzierkammer" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_INT_LONG,
    "Diese Kammer wird vom Orden zum Exorzieren und Daemonenaustreiben "
    "benutzt. Der Raum selber ist relativ kahl, aber die Waende sind mit "
    "tausenden magischen Symbolen vollgekritzelt. Am Boden wurde ein "
    "grosser siebenzackiger Stern aufgemalt und ueberall stehen "
    "Kerzen herum, die den Raum beleuchten. An der Ostwand befindet sich ein "
    "Buecherregal und daneben ein Schreibtisch, sowie eine Schuessel mit "
    "Weihwasser.");

  AddDetail( ({ "boden" }), 
    "Am Boden siehst Du einen siebenzackigen Stern - ein sogenanntes "
    "Heptagramm - der mit Kreide dort aufgemalt wurde. Kerzen stehen auch "
    "herum." );
  AddDetail( ({ "waende" }), 
    "Die Waende sind mit magischen Symbolen vollgeschmiert. Mit Ausnahme "
    "der Ostwand." );
  AddDetail( ({ "wand","ostwand" }), 
    "Hier hat der Exorzist einen Schreibtisch und ein Buecherregal hingest"
    "ellt." );
  AddDetail( ({ "decke" }), 
    "Von der Decke haengen dicke Knoblauchzoepfe." );
  AddDetail( ({ "knoblauch", "knoblauchzoepfe", "zoepfe" }), 
    "Sei froh, dass Du kein Vampir bist!" );
  AddDetail( ({ "kerzen", "kerze" }), 
    "Es handelt sich um weisse Kerzen, die einen speziellen Weihrauchgeruch "
    "ausstroemen, was das Exorzieren bedeutend vereinfacht." );
  AddSmell( ({ DEFAULT_SMELL}), 
    "Es riecht nach Weihrauch." );
  AddSmell( ({ "weihrauch", "kerzen" }), #'weihrauch);
  AddDetail( ({ "symbole" }), 
    "Typische, magische Symbole halt. Du hast ja sowieso keinen blassen "
    "Schimmer davon, drum werden sie gar nicht erst beschrieben." );
  AddDetail( ({ "stern", "heptagramm" }), 
    "Es wurde mit Kreide auf den Boden gezeichnet und dient zum Austreiben "
    "von boesen Geistern und Daemonen. An den sieben Ecken stehen je sieben "
    "Kerzen in geheimnisvoller Anordnung. Ausserdem pulsiert das ganze "
    "irgendwie mit heiliger Magie." );
  AddDetail( ({ "magie"}), 
    "Der Exorzist scheint ja einiges draufzuhaben." );
  AddDetail( ({ "anordnung", "ecken" }), 
    "Sieben Ecken mit je sieben Kerzen... Was das fuer einen Sinn haben soll? "
    "Wie viele Kerzen das insgesamt wohl sein moegen? Angestrengt gruebelst "
    "Du nach." );
  AddDetail( ({ "49", "neunundvierzig", "49 kerzen", "neunundvierzig kerzen"}), 
    ([ 0: "Stimmt, es sind neunundvierzig Kerzen insgesamt. Kein Wunder, "
          "dass es so stark nach ihnen riecht, bei dieser Menge.",
       "troll": "Das ist zwar richtig, aber da bist Du sicher nicht allein "
                "draufgekommen, hm? Wer hat Dir denn geholfen?",
       "oger": "Stimmt, aber schade, dass man die Kerzen nicht essen "
               "kann, 49 Menschenkeulen waeren Dir lieber.",
       "elf": "Richtig, es sind 49 Kerzen. Mit Deinem Computergehirn war "
              "die Loesung auch wirklich nicht schwer," ]));
  AddDetail( ({ "buecherregal", "regal" }), 
    "Das Regal reicht bis unter die Decke und biegt sich unter der Last der "
    "vielen Buecher darin. Das gesammelte Wissen von Generationen von "
    "Exorzisten befindet sich darin." );
  AddDetail( ({ "buecher" }), 
    "Es sind so viele Buecher, dass Du gar nicht weisst, wo Du anfangen "
    "sollst. Nimm halt mal eines aus dem Regal heraus." );
  AddDetail( ({ "buch" }), 
    "Welches dieser vielen Buecher meinst Du denn?" );
  AddReadDetail( ({ "buch" }), 
    "Dafuer muesstest Du erstmal eins aus dem Regal nehmen." );
  AddDetail( ({ "tisch", "schreibtisch" }), 
    "An diesem Tisch arbeitet der Exorzist seine Entfluchungs- und "
    "Austreibungsformeln aus, die er benoetigt." );
  AddDetail( ({ "schuessel" }), 
    "Eine kupferne Schuessel mit Weihwasser drin." );
  AddDetail( ({ "wasser", "weihwasser" }), 
    "Das Weihwasser fuerchten die Daemonen besonders." );
  AddDetail( ({ "geister", "daemonen" }), 
    "Wenn hier welche waeren, haette sie der Exorzist sicher schon "
    "ausgetrieben." );

//  AddDetail( ({ "" }), 
//    "" );

  AddCmd( ({ "blase", "blas" }), "blasen" );
  AddCmd( ({ "nimm" }), "buch" );

  AddExit("norden", ROOM "zentralhalle");
  AddExit("suedosten", ROOM "inqui");

// Lazarett kommt evtl spater dran
//  AddExit("sueden", ROOM "lazarett");

}


int buch(string str)
{
  string titel, *tit_array;
  

  if(member( ({"buch aus regal", "buch aus regal heraus","buch",
               "buch aus buecherregal", "buch aus buecherregal heraus"}),
            str) == -1) return 0;
            

  tit_array=({ "\"Das grosse Daimonicum. Beschwoerung und Austreibung.\"",
               "\"'Unsterblich' - der groesste Irrtum aller Zeiten.\"",
               "\"Grosser Almanach der Geisterkunde. Band 17, PRE - RUH\"", 
               "\"Hypertrophe Sanktuationsallergien bei Nosferata und anderen "
                 "postnekriden Manifestationen.\"",
               "\"Weihwasser selbstgemacht.\"", 
               "\"Spukgestalten, Poltergeister und andere Gruselwesen - "
                 "Augenzeugen berichten.\"", 
               "\"Der Tod kam durch den Drudenfuss (Krimi von Agatha "
                 "Antichristie)\"",
               "\"Hexenfluchentfluchungen.\"", 
               "\"Der Exorzist 4.\"",
               "\"Skeletthand und Vampirgebiss. Alles Wissenswerte.\"", 
               "\"Die Rolle des Exorzismus in der modernen Ehe.\"",
               "\"in sancto BUMM BUMM exito\"",
               "\"HURLA POCK, MARU EXXENTAH, MARU DENTAH!\"",
               "\"Mal den Teufel an die Wand.\"",
               "\"Lungenschneidt's Deutsch-Daemonisch, Daemonisch-Deutsch.\"",
//               "\".\"",
               "\"Sechshundertsechsundsechzig Daemonenwitze.\"",
               "\"Endlich tot, aber was nun?\"",
               "\"Mumienauswickeln im Handumdrehn.\"",
               "\"Des Heiligen Stanislaus Genofevius von Ariola's Kampf "
                 "wider die Nekromantie.\"" });

  titel= BS(tit_array[random(sizeof(tit_array))]);

  say(BS(
    TP->Name()+" nimmt eines der Buecher aus dem Regal, liest "
    "desinteressiert den Titel und stellt das Buch anschliessend wieder "
    "zurueck."));
  write(
    "Du nimmst eines der Buecher heraus und liest Dir den Titel durch: \n"
    +titel+
    "Voellig uninteressant also. Enttaeuscht stellst Du das Buch wieder "
    "zurueck.\n");
  return 1;
}


string weihrauch(string str)
{
  if(TP->QueryProp(P_ALIGN) < 0)
    return BS(
      "Der Weihrauchgestank ekelt Dich an. Es stinkt so intensiv, dass Du "
      "kaum atmen kannst. Am liebsten wuerdest Du die Kerzen alle ausblasen.");
  else
    return BS(
      "Es riecht wundervoll nach feinstem Weihrauch. Eine furchtbar teure "
      "Sorte, wie Du mit Kennerschnueffeln feststellst, wurde in die "
      "Kerzen eingearbeitet.");
}

int blasen(string str)
{
  notify_fail("Was willst Du ausblasen?\n");
  if(str != "kerze aus" && str != "kerzen aus") return 0;
  
  write(BS("Du blaest so fest es geht drauf, aber die Kerzen wollen "
    "einfach nicht verloeschen. Frustriert gibst Du wieder auf."));
  say(BS(
    TP->Name()+" blaest wie verrueckt auf die Kerzen, schafft es aber "
    "nicht, sie auszublasen. So ein Schwammerl."));

  return 1;
}

