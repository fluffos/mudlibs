#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>


inherit "std/room";

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Noerdliche Gebetsnische" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_INT_LONG,
    "Du befindest Dich in einem Seitenteil des Altarraumes, in dem man sich"
    " ungestoert der Anbetung der Goetter widmen kann. Diese Gebetsnische "
    "ist eindeutig Woody geweiht, was man dem lebensgrossen Woody-Bildnis "
    "und an den vielen Gebetstexten an der Wand entnehmen kann. Vor dem "
    "Bildnis wurde eine schmale Bank aufgestellt.");


  AddDetail( ({ "seitenteil", "teil" }), 
    "Du befindest darin." );
  AddDetail( ({ "nische", "gebetsnische" }), 
    "Diese Nische ist Woody geweiht." );
  AddDetail( ({ "boden" }), 
    "Der Boden besteht aus fein gemusterten und sorgfaeltig verlegten "
    "Fliesen." );
  AddDetail( ({ "fliesen" }), 
    "Ein wunderschoenes Band aus Intarsienmustern zieht sich ueber den "
    "ganzen Boden." );
  AddDetail( ({ "muster", "intarsienmuster", "band" }), 
    "Das Band zieht sich ueber den ganzen Boden." );
  AddDetail( ({ "waende", "wand" }), 
    "Ausser dem lebensgrossen Bildnis von Woody und den Gebetstexten "
    "gibt es hier nichts Besonderes." );
  AddDetail( ({ "decke" }), 
    "Eine praechtige Stuckdecke woelbt sich ueber Dir." );
  AddDetail( ({ "stuck", "verschnoerkelungen", "stuckdecke" }), 
    "Als Du genauer hinsiehst, bemerkst Du, wie die Verschnoerkelungen "
    "der Stuckdecke ein grosses 'W' formen." );
  AddDetail( ({ "gott", "bild", "bildnis", "woody" }), 
    "Baertig und wuerdevoll sitzt Woody, der Gott der allumfassenden "
    "Weisheit auf einem Thron aus Silber. Mit der linken Hand vernichtet "
    "er gerade eine Armee des Boesen, waehrend er in der Rechten eine Waage "
    "haelt, die das Gleichgewicht zwischen Magie und Physis darstellt." );
  AddDetail( ({ "gaffos","armee", "kreaturen" }), 
    "Eine haessliche Armee voller boeser Kreaturen wird unter Woodys linker "
    "Hand zermalmt." );
  AddDetail( ({ "waage", "waagschale", "waagschalen" }), 
    "Die Waage befindet sich interessanterweise nicht hundertprozentig im "
    "Gleichgewicht. Auf einer der Waagschalen drueckt ein kleiner Stahldorn "
    "ein wenig nach unten." );
  AddDetail( ({ "weisheit", "bart" }), 
    "Naja, SO lange wie auf dem Bild ist sein Bart in Wirklichkeit sicher "
    "nicht. Das mit der Weisheit kannst Du natuerlich nicht beurteilen, "
    "das waere ja Gotteslaesterung." );
  AddDetail( ({ "linke hand", "linke" }), 
    "Sie ist geballt und symbolisiert die Macht des Guten, waehrend sie ein "
    "paar laut schreiende Gaffos zerdrueckt." );
  AddDetail( ({ "rechte", "rechte hand" }), 
    "In seiner Rechten haelt er eine Waage." );
  AddDetail( ({ "gebete", "lettern", "gebetstexte", "texte" }), 
    "In wunderbaren Lettern aufgemalte Gebete, welche Woody milde stimmen "
    "und huldigen sollen." );
  AddReadDetail( ({ "gebete", "lettern", "gebetstexte", "texte" }), 
    "Eines der Gebete lautet: \n"
    "   Woody, Woody grosser Held, \n"
    "   schenk uns etwas Silbergeld. \n"
    "   Verleih der Sonne ihren Lauf \n"
    "   und schlitz den Orks die Baeuche auf.\n") ;

  AddDetail( ({ "bank", "betbank" }), 
    "Eine mit rotem Samt ausgeschlagene Betbank, die schon bessere Zeiten "
    "gesehen hat. Anscheinend wird sie oft benutzt." );
  AddDetail( ({ "samt" }), 
    "Die Betbank muss schon gehoerigen Wert fuer die Ordensmitglieder haben, "
    "wenn sie sich solch einen Luxus wie Samt darauf goennen." );
  AddDetail( ({ "stahldorn" }), 
    "Vielleicht taeuschst Du Dich auch..." );

  AddCmd( ({ "bete" }), "beten" );

  AddExit("norden", ROOM "altarraum");
}



int beten(string str)
{
  if(str == "zu woody" || str == "woody an")
  {
    write(BS(
      "Du betest so fest und intensiv zu Woody, dass Du tatsaechlich "
      "kurz glaubst zu sehen, wie er erscheint und Dich vaeterlich "
      "anblickt. Stolz erfuellt Dich, so viel Aufmerksamkeit bei Woody "
      "erregt zu haben."));
    say(TP->Name()+" betet ein wenig.");
    return 1;
  }
  else if (str == "zu dusty" || str == "dusty an")
  {
    write(break_string("Hey, komm gefaelligst in meine Gebetsnische rueber, "
      "wenn Du mich anbeten willst!", 78, "Eine Stimme ertoent: "));
    return 1;
  }
  
  notify_fail("Wen willst Du anbeten?\n");
  return 0;
}
