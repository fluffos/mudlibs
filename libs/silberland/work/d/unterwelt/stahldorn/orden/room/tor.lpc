#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>

inherit "std/room";

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Portal zum Heiligen Orden" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  SetProp(P_INT_LONG,
    "Der Hoehlengang endet hier vor einem protzigen Portal, das in der "
    "Nordwand eingelassen wurde. Fackeln an den Waenden erhellen den Raum, "
    "sodass man schoen die Pracht und den Reichtum, in dem das Portal "
    "ausgefuehrt wurde, bewundern kann. ");

  AddDetail( ({ "boden", "decke" }),
    "Boden und Decke bestehen aus schmucklosem Fels." );
  AddDetail( ({ "fels" }),
    "Der uebliche Fels der Unterwelt. Hier scheint er aber etwas heller zu "
    "sein als anderswo." );
  AddDetail( ({ "waende", "wand" }),
    "An den Waenden haengen Fackelhalterungen mit Fackeln drin." );
  AddDetail( ({ "nordwand" }),
    "In der Nordwand wurde ein grosses Portal eingelassen, das den Gang "
    "absperrt. Ueber dem Portal haengt eine Tafel, wo was draufsteht." );
  AddDetail( ({ "portal" }),
    "Das Portal ist ziemlich luxurioes ausgefuehrt. Alles ist voller "
    "goldener und silberner Verzierungen. Geschmackvolle Ornamente, die sich "
    "wie Pflanzen ineinander winden und bizarre Muster bilden, rahmen ein "
    "furchtbar kitschiges Relief eines Heiligen ein, das in der Mitte des "
    "Portals angebracht wurde. Links davon ist ein grosses Schluesselloch." );
  AddDetail( ({ "loch", "schluesselloch" }),
    "Das wurde fuer einen ganz schoen grossen Schluessel gemacht." );
  AddDetail( ({ "verzierungen", "ornamente", "muster", "einlegearbeiten" }),
    "Es handelt sich um kuenstlerisch hochwertigste Einlegearbeiten. Von "
    "meisterhafter Zwergenhand gearbeitet und beeindruckend fehlerlos in "
    "das Metall des Portals geaetzt. Ueber dem Ganzen liegt ausserdem "
    "irgendein Zauber." );
  AddDetail( ({ "metall" }), ([
    0: "Irgendein sauhartes Zeug. Mithril vielleicht.",
    "zwerg": "Das Portal besteht eindeutig aus feinstem Mithril." ]) );
  AddDetail( ({ "zauber", "verteidigungszauber" }), ([
    0: "Ein elfischer Zauber scheint auf dem Portal zu liegen. Vielleicht, "
       "um das Boese abzuwehren?",
    "elf": "Ein schwerer Verteidigungszauber liegt auf diesem Portal. "
           "Natuerlich koennen nur echte Elfenmagier einen Zauber dieser "
           "Macht aussprechen.",
    "zwerg": "Auf dem Portal liegt ein Zauber, der wahrscheinlich das Boese "
             "abwehren soll. Da hat sicher irgendein Elf dran "
             "herumgepfuscht. Ein echter Daemon macht sich wahrscheinlich "
             "in die Hose vor Lachen wenn er diese laecherliche 'Magie' "
             "ueberhaupt bemerkt. Eine robuste Selbstschussanlage oder eine "
             "Pechnase waeren da weit wirkungsvoller." ]));
  AddDetail( ({ "relief", "heiliger" }),
    "Der Heilige wurde augenscheinlich erst nachtraeglich eingefuegt. "
    "Er stuetzt sich schwer auf einen magischen Stab, waehrend er andaechtig "
    "und fromm nach oben blickt, als ob er gerade betet. Ein Heiligenschein "
    "schwebt ausserdem ueber seinem Kopf und er traegt einen auffaelligen "
    "Guertel. Alles ist knallbunt bemalt und "
    "uebertrieben protzig und reisserisch dargestellt." );
  AddDetail( ({ "guertel", "macht" }),
    "Der Guertel faellt Dir deshalb so auf, weil er seltsam verschwommen "
    "gemalt wurde. Als ob er zu flimmern scheint. Grosse Macht scheint von "
    "dem Guertel auszugehen." );
  AddDetail( ({ "heiligenschein", "kopf" }),
    "Ein Heiligenschein schwebt ueber dem Kopf des Heiligen." );
  AddDetail( ({ "stab", "magischer stab" }),
    "Der Stab ist ausser dem Guertel das einzig Interessante an diesem"
    " bloeden Relief. Er wurde "
    "goldgelb bemalt und an seiner Spitze befindet sich ein dicker blauer "
    "Stein. Der Stab scheint innerlich irgendwie magisch zu gluehen." );
  AddDetail( ({ "spitze" }),
    "An der Spitze des Stabes sitzt ein blauer Stein." );
  AddDetail( ({ "stein" }),
    "Dabei handelt es sich um einen wertvollen Edelstein." );
  AddDetail( ({ "pracht", "reichtum", "prunk" }),
    "Der Heilige Orden muss viel Geld fuer diesen Prunk ausgeben. Daran "
    "liegt ihm sicher viel. Aber es bleibt sicher auch noch genug fuer die "
    "Armen und Beduerftigen uebrig." );
  AddDetail( ({ "orden", "heiliger orden" }),
    "Der Heilige Orden bewohnt die Raeume hinter dem Portal." );
  AddDetail( ({ "fackel", "fackeln" }),
    "Die Fackeln in den Halterungen erhellen den Raum. Du nimmst aber davon "
    "Abstand, sie zu stehlen, sonst wuerde es hier ja dunkel werden. Aber "
    "vielleicht gibt Dir einer der Waechter ja eine Fackel, wenn Du ihn "
    "fragst." );
  AddDetail( ({ "halterungen", "fackelhalterungen",
                "halterung", "fackelhalterung" }),
    "Fackeln stecken in den Fackelhalterungen." );
  AddDetail( ({ "waechter" }),
    "Normalerweise bewachen zwei Paladine das Portal. Sind sie grad nicht "
    "da?" );
  AddDetail( ({ "unterwelt" }),
    "Jaja, Du befindest Dich immer noch in der Unterwelt." );
  AddDetail( ({ "tafel" }),
    "Es steht da was drauf. Lies es doch!" );
  AddDetail( ({ "gang", "hoehle", "hoehlengang" }), QueryProp(P_INT_LONG));
  AddReadDetail( ({ "tafel" }),
    "   /------------------------------------------------------------\\\n"
    "   | o                                                        o |\n"
    "   |                   W I L L K O M M E N !                    |\n"
    "   |                  ~~~~~~~~~~~~~~~~~~~~~~~                   |\n"
    "   |             Tritt ein zum Heiligen Orden der               |\n"
    "   |        Bruder- und Schwesternschaft in Verehrung des       |\n"
    "   |          Heiligen Stanislaus Genofevius von Ariola!        |\n"
    "   |                                                            |\n"
    "   |                                                            |\n"
    "   |                                                            |\n"
    "   |     (Bettler und Hausierer unerwuenscht. Daemonen,         |\n"
    "   |      Geister und Untote muessen draussen bleiben!          |\n"
    "   |           Rauchen verboten! Fluchen verboten!     )        |\n"
    "   | o                                                        o |\n"
    "   \\------------------------------------------------------------/\n" );


//  AddItem(NPC "paladin", REFRESH_DESTRUCT);
//  AddItem(NPC "paladin", REFRESH_DESTRUCT);


  AddExit("sueden", "/d/unterwelt/basics/central/room/00-15+13");

  NewDoor("norden", ROOM "vorraum", "portal",
     ({D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY,
       D_NAME, "Portal",
       D_GENDER, NEUTER,
       D_SHORT, "Ein %ses Portal.",
       D_LONG, GetDetail("portal"),
       D_TESTFUNC, "is_evil" }));

}


int is_evil()
{
  if((TP->QueryProp(P_ALIGN) < -800) && (random(100)>40) )
  {
    notify_fail("Es gelingt Dir nicht, das Portal zu durchschreiten.\n");
    write(BS(
      "Als Du durch das Portal gehen willst, prallst Du wie elektrisiert "
      "zurueck. Ein Verteidigungszauber auf dem Portal hat anscheinend "
      "Deinen boshaften Charakter erkannt."));
    say(BS(
      "Als "+TP->name(WER, 1)+" das Portal durchschreiten will, blitzt "
      "ploetzlich etwas auf und "+TP->name(WER, 1)+" wird zurueckgeworfen."));
    TP->reduce_hit_points(5+random(5));
    return 1;
  }
  else return 0;
}

void tuerzu()
{
  DOOR_MASTER->SetDoorStatus(ROOM "vorraum", -1);
  write("Das Portal faellt hinter Dir zu.\n");
  say("Das Portal faellt hinter "+TP->name(WEM)+" zu.\n");
}
