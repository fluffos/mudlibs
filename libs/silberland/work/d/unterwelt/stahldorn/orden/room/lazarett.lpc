#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>


inherit "std/room";

create()
{
  ::create();

  SetProp( P_INT_SHORT, "" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_INT_LONG,
    ".");

  AddDetail( ({ "ecke", "ecken" }), 
    "Es gibt vier Ecken im Raum. Welche meinst Du? Die Nordwestecke, die "
    "Nordostecke, die Suedwestecke, oder gar die Suedostecke?" );



  AddExit("norden", ROOM "exor");

}


