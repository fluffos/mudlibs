#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>
#include <moving.h>

inherit "std/room";

string schrift();
void schriftinit();

string *inschriften;
string aktivschrift;
string *eingesetzt;
int geloest, gepluendert;

create()
{
  ::create();

  schriftinit();

  SetProp( P_INT_SHORT, "Das Allerheiligste" );
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_INT_LONG,
    "Du befindest Dich im Allerheiligsten des Heiligen Ordens. Grelles Licht "
    "leuchtet diesen Raum aus, damit alles Uebel geblendet wird, wenn es "
    "hereinkommt. Die Waende, die Decke, selbst der Boden sind aus "
    "irgendeinem unheimlichen Grund nicht wirklich sichtbar, weil alles "
    "von heiligem Licht durchflutet wird, welches Deine Sinne benebelt. "
    "Der einzig wirklich sichtbare Bereich ist das "
    "Zentrum des Raums. Ein grosser, auffaelliger Kasten befindet sich "
    "dort.");


  AddDetail( ({ "wand", "waende", "decke", "boden" }), 
    "Es wird alles in dieses gleissende Licht gehuellt, Du kannst kaum "
    "an etwas anderes denken." );
  AddDetail( ({ "licht" }), 
    "Es scheint von ueberall her zu kommen. Sein heiliges Leuchten erfuellt "
    "den Raum nicht nur visuell, sondern auch alle Personen hier drin "
    "werden von diesem heiligen Zauber erfasst." );
  AddDetail( ({ "zauber","leuchten" }), 
    "Als ob alles Gute der Welt in diesem Raum vereint waere." );
  AddDetail( ({ "gute", "welt" }), 
    "Viel vom Guten dieser Welt ist hier konzentriert.");
  AddDetail( ({ "zentrum" }), 
    "Im Zentrum des Raumes steht ein seltsamer Kasten.");
  AddDetail( ({ "kasten" }), 
    "Huch bei dem Kasten handelt es sich in Wirklichkeit um einen "
    "glaesernen Sarkophag. Darin kannst Du eine mumifizierte Leiche "
    "und noch ein paar andere Gegenstaende erkennen. Achja, an der Seite "
    "ist uebrigens ein kleiner Knopf angebracht.");
  AddSpecialDetail( ({ "sarkophag" , "sarg"}), "sarkophagdetail");
  AddDetail( ({ "glas" }), 
    "Das Glas ist milchig truebe, man kann dennoch ein wenig hindurchsehen.");
  AddDetail( ({ "schnoerkel" }), 
    "Die Schnoerkel verlaufen in kleinen Spiralen rund um den Sarkophag.");
  AddDetail( ({ "spirale", "spiralen" }), 
    "Sie scheinen irgendwie in das Glas eingeaetzt worden zu sein. Sehr viel "
    "Zeit und Arbeit muss darin investiert worden sein." );
  AddDetail( ({ "leiche", "heiligen", "heiligen", "mensch" }), 
    "Es handelt sich unzweifelhaft um die Leiche des beruehmten Heiligen "
    "Stanislaus Genofevius von Ariola. Sie ist sehr gut erhalten, weil "
    "sie kurz nach dem Tod einbalsamiert und so fuer die Nachwelt "
    "erhalten wurde. Soweit man sehen kann, war er aber ein enttaueschend "
    "haesslicher Mensch mit einem dicken Kugelbauch und einer seltsam "
    "schraegen Nase.");
  AddDetail( ({ "stanislaus", "genofevius", "ariola" ,
                "stanislaus genofevius von ariola" }), 
    "Wie dieser haessliche Mann so ein Held werden konnte, ist Dir "
    "absolut schleierhaft. Aber er wahr wohl ein Meister seines Faches und "
    "ein Top-Kleriker, anders kann man es sich nicht erklaeren, "
    "dass er auch 'Drachenschlaechter' und 'Schrecken der Zombies' "
    "genannt wurde. Er hat sein Leben dem Kampf gegen das Boese gewidmet." );
  AddDetail( ({ "nase" }), 
    "Die Nase des Genofevius ist ganz schief. Als ob sie mehrmals "
    "bei Wirtshausschlaegereien gebrochen wurde." );
  AddDetail( ({ "bauch", "kugelbauch" }), 
    "Ein dicker, fetter Kugelbauch 'zierte' den Heiligen Genofevius." );
  AddDetail( ({ "knopf" }), 
    "Ein ganz simpler kleiner Knopf.");
  AddDetail( ({ "gegenstaende", "dinge", "sachen" }), 
    "Du bemuehst Dich, kannst aber nicht genau erkennen, worum es "
    "sich handelt.");
  AddDetail( ({ "sockel","marmorsockel" }), 
    "Der Sarkophag steht auf einem Marmorsockel. Auf diesem Sockel "
    "entdeckst Du die duenne Linie einer flimmernden magischen Schrift.");
  AddDetail( ({ "marmor" }), 
    "Ganz normaler 08/15-Marmor.");
  AddDetail( ({ "linie","schrift" }), 
    "Du kannst sie lesen!");
  AddReadDetail( ({ "linie","schrift" }), 
   #'schrift);

//  AddDetail( ({ "" }), 
//    "" );


  AddCmd( ({"greife","greif"}), "greifen");
  AddCmd( ({"oeffne"}), "oeffnen");
  AddCmd( ({"setze","setz"}), "einsetzen");
  AddCmd( ({"pluender","pluendere"}), "auspluendern");
  AddCmd( ({ "drueck","druecke" }), "druecken" );

  SUID;

  AddItem(NPC "ritter", REFRESH_REMOVE);
 }

string sarkophagdetail()
{
  string ret;
  
  ret= "Der Sarkophag besteht aus Glas. Rundherum ist er mit wunderschoenen "
       "Schnoerkeln verziert. Ausserdem steht der Sarkophag auf einem "
       "massiven Marmorsockel. ";
  if(geloest)
    ret+="Der Sarkophag ist geschlossen.";
  else
    ret+="Der Sarkophag ist offen.";
        
  return BS(ret);
}

int OstenZu() 
{
  return (ROOM "altarraum"->OstenZu());
}

int druecken(string str)
{
  if(str != "knopf") return 0;

  write("Du drueckst den Knopf.\n");
  say(TP->Name()+" drueckt einen Knopf.\n");
  if(member(m_indices(QueryProp(P_EXITS)),"westen")<0)
  {
    ROOM "altarraum"->OstenAuf();
    call_out("OstenZu", 10);
  }
  return 1;
}


int greifen(string str)
{
  if(str!="in sarg" && str!="in sarkophag")
  {
    notify_fail("In was willst Du greifen?\n");
    return 0;
  }
    
  if(geloest) 
    write("Mach einfach 'pluendere sarkophag', um Dir die Sachen darin zu "
          "nehmen.\n");
  else
    write("Der Sarkophag ist leider geschlossen.\n");
    
  return 1;
}

int oeffnen(string str)
{
  if(str!="sarg" && str!="sarkophag")
  {
    notify_fail("Was willst Du oeffnen?\n");
    return 0;
  }
    
  if(geloest) 
    write("Der Sarkophag ist bereits offen.\n");
  else
    write("So einfach geht der Sarkophag nicht zu oeffnen.\n");
    
  return 1;
}


int auspluendern(string str)
{
  object bruder;
  int i;
  
  str=explode( str, " ")[0];
  if(str != "sarkophag" && str != "sarg")
  {
    notify_fail("Was willst du auspluendern?\n");
    return 0;
  }  
  
  if(bruder=present("Bruder des Ordens"))
  {
    notify_fail(bruder->Name(WER,0)+" hindert Dich daran, "
       "den Sarg zu pluendern.\n");
    return 0;
  }  

  if(!geloest)
  {
    notify_fail("Der Sarkophag ist geschlossen! "
                "Da kannst Du nicht pluendern.\n");
    return 0;
  }  

  if(gepluendert)
  {
    notify_fail(BS("Du kramst herum, aber du findest nichts mehr im "
                   "Sarkophag, was von Wert waere."));
    return 0;
  }  


  write(BS(
    "Du pluenderst den Sarkophag aus. Ein paar Sachen fallen dabei auf den "
    "Boden."));
  say(TP->Name()+" pluendert den Sarkophag aus.\n");
  
  CLONEOB( OBJ "guertel" )->move(TP, M_NOCHECK);
  for(i=0;i<random(3)+3;i++)
     CLONEOB( OBJ "scroll" )->move(TP, M_NOCHECK);
  "/obj/gemmaster"->DistributeGem(5, 5, 1, TO);
  gepluendert=1;
  return 1;

}



int einsetzen(string str)
{
  int wo;
  string was;
  object letter;
   
  if (sscanf(str,"%s an stelle %d ein", was, wo)!=2)
  {
     notify_fail("Welchen Buchstaben willst Du an welcher Stelle "
                 "einsetzen?\n");
     return 0;
  }
    
  if(wo<1 || wo>strlen(aktivschrift))
  {
    notify_fail("An dieser Stelle kann man nichts einsetzen.\n");
    return 0;
  }

  if(strlen(was=CAP(was))!=1)
  {
    notify_fail("Immer nur einen Buchstaben nach dem "
                "anderen einsetzen!\n");
    return 0;
  }

  if((was!=aktivschrift[wo-1..wo-1])||(!letter=present("Buchstabe "+was,TP)))
  {
    notify_fail(BS("Entweder dieser Buchstabe passt da nicht, oder Du hast "
                   "ihn gar nicht dabei!"));
    return 0;
  }
  
  if(eingesetzt[wo-1]!="_")
  {
    notify_fail("Dieser Buchstabe wurde doch schon eingesetzt.\n");
    return 0;
  }
  
  letter->remove();
  eingesetzt[wo-1]=was;
  write("Du setzt den Buchstaben "+was+" an der "+wo+". Stelle ein.\n");
  say(TP->Name()+" fummelt am Sarkophag herum.\n");

  if(member(eingesetzt, "_")==-1)
  {
     write(BS("Als Du den letzten Buchstaben einsetzt, oeffnet sich "
              "ploetzlich mit lautem Knarren der Sarkophag!") );
     say(BS("Als "+TP->name()+" den letzten Buchstaben einsetzt, oeffnet "
            "sich ploetzlich mit lautem Knarren der Sarkophag!") );
     geloest=1;
  }
  

  return 1;
}


void schriftinit()
{
  int i;
  
  geloest=0;
  gepluendert=0;

  inschriften=({          "BENEVOLUS",
                          "SALUTARIS",
                          "CONFESSIO",
                          "FULMINEUS",
                          "CONSOLATOR",
                          "OBLIVIOSUS",
                          "VERBERATIO",
                          "MISERICORS",
                          "SUBLIMITARE",
                          "SACRIFICARE"});

  aktivschrift=inschriften[random(10)];
  
  eingesetzt=({ });
  for(i=0;i<strlen(aktivschrift);i++)
  {
    eingesetzt+=({"_"});
  }
 }


string schrift()
{
  string ret;
  int i;
  
  ret="Fuege die magischen Lettern ein, oder lass es sein. \n";
  for (i=0;i<sizeof(eingesetzt);i++)
  {
    ret+=eingesetzt[i]+" ";
  } 
//  nur zum debuggen ;)
//  ret+=" (" + aktivschrift + ") \n";
  return ret;
}

void SetGeloest()
{
  geloest=1;
}

string QueryInschrift()
{
  return aktivschrift;
}

string *QueryAlleInschriften()
{
  return inschriften;
}

int testfunc()
{
  return ROOM "altarraum"->testfunc();
}

void reset()
{
  ::reset();
  if(geloest)
  {
      schriftinit();
      tell_room(TO, "Der Sarkophag knallt geraeuschvoll zu.\n");
  }
}    



















