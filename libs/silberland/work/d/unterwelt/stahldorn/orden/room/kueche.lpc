#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>


inherit "std/room";

int brett_da;

create()
{
  ::create();

  brett_da=1;

  SetProp( P_INT_SHORT, "Kueche des Heiligen Ordens" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_INT_LONG,
    "In diesem Raum ist die Kueche des Ordens untergebracht. Zur Zeit "
    "hat noch kaum einer Hunger, drum passiert hier recht wenig. Auf einigen "
    "der Kuechentische liegt etwas zur Haelfte geschaeltes Gemuese herum und "
    "am Herd koechelt ein grosser Topf mit Haferschleim vor sich hin. "
    "Ausserdem siehst Du noch ein grosses Spuelbecken.");

  AddDetail( ({ "boden", "fussboden" }), 
    "Ein einfacher Fussboden. Manchmal wird zusammengekehrt." );
  AddDetail( ({ "decke" }), 
    "An der Decke gibt es nichts Wichtiges zu sehen." );
  AddDetail( ({ "wand", "waende" }), 
    "Ein Herd und mehrere Tische stehen an den Waenden. Darueber wurden "
    "Regale angebracht, damit man Kraeuter, Gewuerze, Toepfe, Pfannen, "
    "Kochgeschirr, Teller und Saucen bequem aufbewahren kann." );
  AddDetail( ({ "raum", "kueche" }), QueryProp(P_INT_LONG) );
  AddDetail( ({ "tische", "kuechentische" }), 
    "Die meisten Tische sind gerade, bis auf magere Gemuesereste von der "
    "letzten Eintopfzubereitung leer, nur auf einem Tisch ganz in der Ecke "
    "liegt noch etwas anderes." );
  AddSpecialDetail( ({ "tisch", "kuechentisch", "ecke" }), "tisch_det");
  AddSpecialDetail( ({ "brett", "schneidbrett" }), "brett_det" );
  AddDetail( ({ "gemuese", "gemuesereste" }), 
    "Die Gemuesereste hier sind alt und nicht mehr zu geniessen." );
  AddDetail( ({ "herd" }), 
    "Ein Topf steht auf dem Herd." );
  AddDetail( ({ "topf" }), 
    "Im Topf schwimmt eine dicke graue Suppe. Eindeutig Haferschleim, "
    "anscheinend das Lieblingsessen der Ordensbewohner." );
  AddDetail( ({ "suppe","schleim", "haferschleim", "lieblingsessen" }), 
    "Kleine Blaeschen lassen den Haferschleim blubbern. " );
  AddDetail( ({ "regale", "regal"}), 
    "Die Regale sind voller Kraeuter, Gewuerze, Toepfe, Pfannen, Teller "
    "und Saucen." );
  AddDetail( ({ "blaeschen" }), 
    "BLUBB BLUBB BLUBB" );
  AddDetail( ({ "becken", "spuelbecken" }), 
    "Neben dem mit Wasser gefuellten Becken hat jemand abgewaschenes Besteck "
    "und Geschirr aufgestapelt." );
  AddDetail( ({ "wasser", "spuelwasser" }), 
    "Das Wasser wurde zum Abwaschen des Geschirrs verwendet, ist aber noch "
    "frisch genug fuer einen weiteren Spuelgang." );
  AddDetail( ({ "toepfe", "pfannen", "pfanne" }), 
    "Es handelt sich um Toepfe und Pfannen in den verschiedensten Groessen. "
    "Von der Extra Large Pfanne fuer Gigaomelettes bis zum Jumbo-Mega-Topf "
    "fuer das beliebte Hektolitergulasch." );
  AddDetail( ({ "teller" }), 
    "Hunderte Teller. So viele Leute koennen hier im Orden doch gar nicht "
    "wohnen, dass man so viele Teller braucht." );
  AddDetail( ({ "kraeuter", "gewuerze" }), 
    "Da die Nonnen hier gewuerzarm und natuerlich kochen (man koennte auch "
    "sagen, sie kochen fad und geschmacklos), werden die Gewuerze kaum "
    "benutzt. Obwohl die Auswahl relativ gross ist. Schade eigentlich." );
  AddDetail( ({ "saucen" }), 
    "Einige Instant-Fertigsaucen lagern auf den Regalen. Sie sehen aber "
    "unappetitlich aus." );
  AddDetail( ({ "geschirr", "kochgeschirr", "besteck" }), 
    "Geschirr und Besteck gibt es hier in Huelle und Fuelle. Ein grosser "
    "Teil davon liegt neben dem Spuelbecken aufgeschlichtet herum, der Rest "
    "lagert in den Regalen an den Waenden." );

  AddCmd( ({ "koste" }), "kosten" );
  AddCmd( ({ "wasche", "wasch" }), "abwaschen" );
  AddCmd( ({ "raeume", "raeum" }), "wegraeumen" );
  
  AddExit("suedosten", ROOM "refek");

}


int abwaschen(string str)
{
  if(!brett_da) return 0;
  
  notify_fail("Was willst Du abwaschen?\n");
  if (str != "brett ab" && str !="schneidbrett ab") return 0;
  
  write(BS(
    "Du nimmst das Schneidbrett und waeschst es im uebriggebliebenen "
    "Spuelwasser ab. Danach legst Du es wieder schoen ordentlich in eines "
    "der Regale. Brav." ));
  say(BS(
    TP->Name()+" nimmt ein Brett von einem der Tische, waescht es ab und "
    "legt es auf ein Regal."));
  brett_da=0;
  return 1;    
}

int kosten(string str)
{
  notify_fail("Was willst Du kosten?\n");
  if (str != "haferschleim" && str !="schleim") return 0;

  write(BS(
    "Du beugst Dich hinunter und kostest ein klein wenig vom "
    "Haferschleim. Leider ist das Zeug so heiss, dass Du Dir den Mund "
    "ordentlich verbrennst."));
  TP->reduce_hit_point(1+random(4));
  say(TP->Name()+" kostet vom Haferschleim und verbrennt sich die Zunge.\n");
  return 1;
}

int wegraeumen(string str)
{
  notify_fail("Was willst Du wegraeumen?\n");
  if (str != "geschirr weg" && str != "geschirr ab") return 0;

  write(BS(
    "Du beginnst damit, das Geschirr wieder in die Regale "
    "zurueckzuraeumen, aber da Du nicht genau weisst, wo was hingehoert, "
    "gibst Du schnell wieder auf. Fuer die ganze Arbeit haettest Du ja auch "
    "Stunden gebraucht, und darauf hast Du sowieso keine Lust."));
  say(TP->Name()+" raeumt ein paar Geschirrstuecke in die Regale.\n");
  return 1;
}

void reset()
{
  brett_da=1;
  ::reset();
}

string tisch_det(string str)
{
  if(brett_da)
    return BS(
       "Auf einem der Kuechentische in der hinteren Ecke hat jemand "
       "ein Schneidbrett vergessen." );
  else
    return "Der Tisch ist leer, Du musst Dich getaeuscht haben.\n";
}

string brett_det(string str)
{
  if(brett_da)
    return "Es ist schmutzig und gehoert dringend abgewaschen.\n";
  else 
    return "So etwas siehst Du hier nicht.\n";
}

