#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>


inherit "std/room";

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Dormitorium" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 24, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_INT_LONG,
    "Du siehst einen relativ grossen, schlauchfoermigen Raum mit vielen "
    "Betten an den Waenden, die in der Mitte einen engen Gang freilassen. "
    "Auffaellig ist hier "
    "lediglich der furchtbar muffige Geruch, als ob hier seit Jahrhunderten "
    "nicht mehr gelueftet worden waere.");

  AddDetail( ({ "steinboden", "boden" }), 
    "Ein kalter und glatter Steinboden, der regelmaessig mit schmutzigem "
    "Wasser gewaschen zu werden scheint." );
  AddDetail( ({ "wand","waende" }), 
    "Die Waende sind kahl, spartanisch, schmucklos.");
  AddDetail( ({ "gang" }), 
    "Zwischen den Betten bleibt ein kleiner Gang frei." );
  AddDetail( ({ "decke" }), 
    "An der Decke haengen ein paar Oellampen. Ausserdem siehst Du zwei kleine "
    "Loecher in der Decke." );
  AddDetail( ({ "loecher", "loch", "ameisenstrasse" }), 
    "Hunderte Ameisen krabbeln bei dem einen Loch heraus und beim anderen "
    "wieder hinein. Du hast soeben eine Ameisenstrasse entdeckt." );
  AddDetail( ({ "ameise", "ameisen" }), 
    "Die meisten laufen nur so herum, ein paar tragen auch irgendwas." );
  AddDetail( ({ "lampen", "oellampen" }), 
    "Oellampen, die an der Decke haengen, erleuchten den Raum." );
  AddDetail( ({ "raum", "saal" }), QueryProp(P_INT_LONG) );
  AddDetail( ({ "bett", "betten" }), 
    "Simple Betten, die sicher nicht gerade weich sind. Sie sind zwar alle "
    "recht ordentlich gemacht, aber das Bettzeug starrt vor Dreck. Ein "
    "einziges ist ungemacht und zwei Fuesse schauen unter der Bettdecke "
    "hervor." );
  AddDetail( ({ "fuesse", "fuss" }), 
    "Die Fuesse gehoeren anscheinend zu einem der hier wohnenden "
    "Ordensmitglieder. "
    "Du beschliesst, seinen Schlaf nicht zu stoeren." );
  AddDetail( ({ "bettdecke" }), 
    "Unter der Bettdecke liegt jemand." );
  AddDetail( ({ "dreck" }), 
    "Pfui." );
  AddDetail( ({ "bettzeug" }), 
    "Das war wohl ehemals weiss. Jetzt wechselt die Farbe zwischen "
    "kakerlakenleichenbraun, rotzgelb und schweissgrau." );
  AddSmell( ({ "geruch",DEFAULT_SMELL }), 
    "Hier stinkt es nach ungewaschenen Fuessen und kalten Furzen. So "
    "muffig und stickig, dass Du kaum Luft bekommst." );
  AddSound( ({ DEFAULT_SOUND }), 
    "Von irgendwo her ertoent manchmal ein grunzendes Schnarchen, das Du aber "
    "nicht genau lokalisieren kannst (oder willst)." );
  AddSound( ({ "schnarchen" }), 
    "Ein rasselndes Geraeusch. Man sollte dem Verursacher sagen, dass das "
    "nicht gesund klingt. Vielleicht ist es ja was Ernstes. Auf jeden Fall "
    "hoert es sich so an, als ob er gleich abkratzt." );
  AddSmell( ({ "fuesse" }), 
    "*schnueff* Nein, DEINE Fuesse sind sauber..." );
  AddSmell( ({ "furz", "furze" }), 
    "Pfui. Alt aber grauslich." );


  AddExit("suedwesten", ROOM "refek");
  AddExit("westen", ROOM "dormi1");

}


