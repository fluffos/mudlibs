#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>


inherit "std/room";

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Noerdliche Gebetsnische" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_INT_LONG,
    "Du befindest Dich in einem Seitenteil des Altarraumes, in dem man sich"
    " ungestoert der Anbetung der Goetter widmen kann. Diese Gebetsnische "
    "ist eindeutig Dusty geweiht, was man dem lebensgrossen Dusty-Bildnis "
    "und an den vielen Gebetstexten an der Wand entnehmen kann. Vor dem "
    "Bildnis wurde eine schmale Bank aufgestellt.");


  AddDetail( ({ "seitenteil", "teil" }), 
    "Du befindest darin." );
  AddDetail( ({ "nische", "gebetsnische" }), 
    "Diese Nische ist Dusty geweiht." );
  AddDetail( ({ "boden" }), 
    "Der Boden besteht aus fein gemusterten und sorgfaeltig verlegten "
    "Fliesen." );
  AddDetail( ({ "fliesen" }), 
    "Ein wunderschoenes Band aus Intarsienmustern zieht sich ueber den "
    "ganzen Boden." );
  AddDetail( ({ "muster", "intarsienmuster", "band" }), 
    "Das Band zieht sich ueber den ganzen Boden." );
  AddDetail( ({ "waende", "wand" }), 
    "Ausser dem lebensgrossen Bildnis von Dusty und den Gebetstexten "
    "gibt es hier nichts Besonderes." );
  AddDetail( ({ "decke" }), 
    "Eine praechtige Stuckdecke woelbt sich ueber Dir." );
  AddDetail( ({ "stuck", "verschnoerkelungen", "stuckdecke" }), 
    "Als Du genauer hinsiehst, bemerkst Du, wie die Verschnoerkelungen "
    "der Stuckdecke ein grosses 'D' formen." );
  AddDetail( ({ "goettin", "bild", "bildnis", "dusty" }), 
    "Wow!!! Also Dusty ist echt eine tolle Goettin! Ihre betont laessige "
    "Haltung laesst ihre super Figur besonders gut zur Geltung kommen. "
    "Das anmutige Laecheln auf ihrem Gesicht bezaubert die Schar der "
    "Glaeubigen, die ihr auf dem Bild zu Fuessen liegen. Eine machtvolle "
    "Aura umgibt sie in all ihrer Herrlichkeit." );
  AddDetail( ({ "schar", "glaeubige" }), 
    "Voller Verzueckung bringen sie ihrer Goettin Opfergaben dar." );
  AddDetail( ({ "gaben", "opfergaben" }), 
    "Blumen, Weihrauch, Obst und Myrrhe." );
  AddDetail( ({ "blumen", "weihrauch", "obst", "myrrhe" }), 
    "All dies wird von Dusty laechelnd als Opfergabe in Empfang genommen." );
  AddDetail( ({ "figur" }), 
    "Eine ziemlich idealisierte Figur. So schlank und vollbusig ist sie in "
    "Wirklichkeit sicher nicht. :)" );
  AddDetail( ({ "gesicht", "laecheln" }), 
    "Ihr Laecheln koennte sogar Stahl zum Schmelzen bringen." );
  AddDetail( ({ "aura", "glanz", "haar" }), 
    "Ein heller Glanz umspielt ihr Haar wie eine sanfte Fruehlingsbrise." );
  AddDetail( ({ "gebete", "lettern", "gebetstexte", "texte" }), 
    "In wunderbaren Lettern aufgemalte Gebete, welche Dusty milde stimmen "
    "und huldigen sollen." );
  AddReadDetail( ({ "gebete", "lettern", "gebetstexte", "texte" }), 
    "Eines der Gebete lautet: \n"
    "   Dusty unser Engelein\n"
    "   lass ueppig unsre Ernte sein,\n"
    "   verschone unsre Kinder und\n"
    "   hau den Orks die Koepfe wund.\n") ;

  AddDetail( ({ "bank", "betbank" }), 
    "Eine mit rotem Samt ausgeschlagene Betbank, die schon bessere Zeiten "
    "gesehen hat. Anscheinend wird sie oft benutzt." );
  AddDetail( ({ "samt" }), 
    "Die Betbank muss schon gehoerigen Wert fuer die Ordensmitglieder haben, "
    "wenn sie sich solch einen Luxus wie Samt darauf goennen." );

  AddCmd( ({ "bete" }), "beten" );

  AddExit("sueden", ROOM "altarraum");
}



int beten(string str)
{
  if(str == "zu dusty" || str == "dusty an")
  {
    write(BS(
      "Du betest so fest und intensiv zu Dusty, dass Du tatsaechlich "
      "kurz glaubst zu sehen, wie sie erscheint und Dich mit ihrem "
      "bezaubernden Laecheln beglueckt. Dein Herz huepft vor Freude."));
    say(TP->Name()+" betet ein wenig.");
    return 1;
  }
  else if (str == "zu woody" || str == "woody an")
  {
    write(break_string("Hey, komm gefaelligst in meine Gebetsnische rueber, "
      "wenn Du mich anbeten willst!", 78, "Eine Stimme ertoent: "));
    return 1;
  }
  
  notify_fail("Wen willst Du anbeten?\n");
  return 0;
}
