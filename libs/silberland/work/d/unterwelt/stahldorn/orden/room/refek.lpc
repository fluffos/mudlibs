#include "../def.h"
#include <rooms.h>
#include <properties.h>
#include <language.h>

inherit "std/pub";

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Refektorium" );
  SetProp( P_INT_LONG, 
    "Dies ist das Refektorium, also der Speisesaal des Ordens. Das erkennt "
    "man an den Tischen und Stuehlen, die herumstehen und an den Schuesseln "
    "mit und ohne Nahrung darin. Ein paar Nonnen gehen umher, um die Essens"
    "willigen zu versorgen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 24, ENV_TERRAIN: TT_HOUSE]) );
  AddDetail( ({ "refektorium", "speisesaal", "raum" }), QueryProp(P_INT_LONG));
  AddDetail( ({ "tische", "tisch" }), 
    "Einfache Holztische." );
  AddDetail( ({ "stuhl", "stuehle" }), 
    "Sehr spartanisch und unbequem." );
  AddDetail( ({ "wand", "waende" }), 
    "Nackerte Waende umgeben den Raum. Uninteressant." );
  AddDetail( ({ "decke" }), 
    "Die Decke ist aehnlich uninteressant wie die Waende." );
  AddDetail( ({ "boden" }), 
    "Am Boden wurde schoen gleichmaessig der Inhalt einer Haferschleim"
    "schuessel verteilt. Er hat wohl nicht sehr gemundet." );
  AddDetail( ({ "haferschleim", "inhalt" }), 
    "Ein breiiger Gatsch. Allerdings schon eingetrocknet." );
  AddDetail( ({ "gatsch" }), 
    "Gatsch ist ein oesterreichischer Ausdruck fuer "
    "Batz.");
  AddDetail( ({ "batz" }), 
    "So was aehnliches wie Schlaz." );
  AddDetail( ({ "schlaz" }), 
    "Ein Schlaz ist ein batziger Gatsch." );
  AddDetail( ({ "schuessel", "schuesseln" }), 
    "Hier wird Nahrung in Schuesseln verpackt um sie (die Nahrung) besser "
    "essen zu koennen. Die Schuesseln sind meist noch eher voll, weils "
    "kaum einem so richtig schmeckt." );
  AddDetail( ({ "nahrung" }), 
    "Tipp einfach 'menue', dann siehst Du was es hier gibt. Gross ist die "
    "Auswahl sowieso nicht." );
  AddDetail( ({ "auswahl" }), 
    "Na tipp doch endlich 'menue'!" );
  AddDetail( ({ "nonne", "nonnen" }), 
    "Ein paar Nonnen gehen aus und ein. Manchmal tragen sie was zum Essen "
    "wenn sie rausgehen, und manchmal leere Schuesseln, wenn sie reinkommen. "
    "Seltsam." );
  AddDetail( ({ "essenswillige" }), 
    "Sie sind nicht besonders zahlreich. Die Kueche scheint wohl eher im "
    "unteren Level angesiedelt zu sein." );


  AddDrink("Weihwasser", 
           ({"wasser", "weihwasser"}),
           1, 5, 0, 3, "weihfunc");

  AddDrink("Hollersaft", 
           ({"hollersaft", "saft"}),
           200, 23, 0, 5,
           ({ "Eine Nonne bringt Dir ein riesengrosses Glas Hollersaft. "
              "Hmmmmm, schmeckt der lecker. So schoen suess und fruchtig.",
              "&& trinkt ein Glas Hollersaft leer, das eine Nonne &3 "
              "bringt."}));

  AddDrink("Klosterfrau Hornissengeist", 
           ({"hornissengeist", "geist", "klosterfrau"}),
           300, 36, 6, 1,
           ({
             "Eine der Nonnen nickt wissend und holt eine Flasche Hornissen"
             "geist aus ihrer Kutte. Du trinkst den Inhalt in einem Zug aus "
             "und fuehlst das Brummen der Hornissen sofort in deinem "
             "Schaedel, die diesem Getraenk den Namen gaben.",
             "&& beginnt zu Brummen, als &1 eine kleine Flasche mit Hornissen"
             "geist trinkt."}));

  AddDrink("goettlicher Nektar", 
           ({"nektar", "goettlichen nektar"}),
           1500, 0, 0, 40, "nektarfunc");



  AddFood("Hostie", ({"hostie"}),
           1, 0, 0,
           ({
             "Die Nonne steckt Dir eine Hostie in den Mund. Schmeckt nach "
             "nichts, bewirkt nichts, klebt aber laestig am Gaumen fest.",
             "&& isst eine Hostie."}));

  AddFood("Eine Packung Kardinalschnitten", 
           ({"kardinalschnitten", "schnitten" }),
           50, 6, 2,
           ({
             "Die Nonne gibt Dir eine Packung Kardinalschnitten, die Du "
             "sofort aufreisst und aufisst. Enttaeuschenderweise bestehen "
             "die Schnitten gar nicht aus einem Kardinal. Nichtmal ein "
             "Bischof ist drin. Nur simple Waffeln aus ungesaeuertem Brot.",
             "&& beisst herzhaft in eine Art Waffel."}));

  AddFood("Haferschleim", ({"schleim", "haferschleim"}),
           100, 10, 3,
           ({
             "Du wirfst einer der Nonnen ein paar Muenzen zu und schnappst "
             "Dir eine Schuessel mit Haferschleim. Er schmeckt fad und etwas "
             "eingetrocknet.",
             "&& isst eine Schuessel mit Haferschleim."}));

  AddFood("Gemueseeintopf", ({"eintopf", "gemueseeintopf"}),
           150, 25, 10, 
           ({"Du bestellst Gemueseeintopf. Die Nonne macht ein erstauntes "
           "Gesicht, eilt aber dann doch kurz in den Nebenraum, um Dir das "
           "Gewuenschte zu bringen. Du bereust Deine Entscheidung sofort, "
           "als Du den ersten Bissen hinuntergewuergt hast.",
           "&& loeffelt unter den strengen Blicken einer Nonne eine Schuessel "
           "mit Gemueseeintopf aus und macht kein besonders glueckliches "
           "Gesicht dabei." }) );

  AddFood("Buchstabensuppe", 
           ({"suppe", "buchstabensuppe" }),
           250, 30, 8, "buchstabenfunc");


  AddFood("goettliches Ambrosia", 
           ({"ambrosia", "goettliches ambrosia" }),
           1500, 0, 40, "ambrosiafunc");


  AddExit("nordosten", ROOM "dormi2");
  AddExit("norden", ROOM "dormi1");
  AddExit("nordwesten", ROOM "kueche");
  AddExit("sueden", ROOM "zentralhalle");

}


int weihfunc(object spender, object saeufer)
{
  tell_object(saeufer, BS(
    "Du schlabberst etwas am Weihwasser herum." ) );
  tell_room(TO, BS(
    saeufer->Name()+" schlabbert etwas am Weihwasser herum." ), ({saeufer}) );

  if(saeufer->QueryProp(P_ALIGN) < -100)
  {
    tell_object(saeufer, BS(
      "Ein Blitz trifft Dich in den Hintern. Vielleicht ist Weihwasser in "
      "Deinem jetzigen Zustand nicht die beste Wahl?") );
    tell_room(TO, 
      saeufer->Name()+" wird von einem Blitz in den Hintern getroffen und "
      "bruellt schmerzerfuellt auf.", ({saeufer}) );
    saeufer->reduce_hit_point(5);
  }
}

int nektarfunc(object spender, object saeufer)
{
  int align;
  
  if((align=saeufer->QueryProp(P_ALIGN))<-100)
  {
    tell_object(saeufer, BS(
      "Du bekommst einen Becher voll mit leuchtendem Nektar in die Hand "
      "gedrueckt. Gierig trinkst Du das Zeug, spuckst es aber sofort wieder "
      "aus, weil es so widerlich suess und heilig schmeckt." ) );
    tell_room(TO, BS(
      saeufer->Name()+" trinkt einen Becher voll mit leuchtendem Nektar, " 
      "spuckt aber alles wieder aus."), ({saeufer}) );
  }  
  else
  {
    tell_object(saeufer, BS(
      "Du bekommst einen Becher voll mit leuchtendem Nektar in die Hand "
      "gedrueckt. Gierig trinkst Du das Zeug, und fuehlst sofort die wohlige "
      "Waerme, die sich in Deinem Bauch ausbreitet. Kein Wunder, dass die "
      "Goetter darauf stehen, es schmeckt wirklich saugut." ) );
    tell_room(TO, BS(
      saeufer->Name()+" trinkt einen Becher voll mit leuchtendem Nektar, " 
      "und sieht zufrieden aus."), ({saeufer}) );
    saeufer->heal_self(align/3);
  }
  
}


int buchstabenfunc(object spender, object fresser)
{

  
 tell_object(fresser, BS(
    "Du bekommst eine Schuessel Buchstabensuppe serviert. "
    "Bevor Du sie schluerfst, spielst Du noch ein wenig mit den lustigen "
    "Buchstaben herum. Interessant! Du kannst zum Beispiel aus den "
    "Buchstaben das Wort "+ROOM "allerheiligstes"->QueryInschrift()+
    " bilden! Hihi! :)" ) );
 tell_room(TO, BS(
    fresser->Name()+" schluerft eine Schuessel mit Buchstabensuppe."), 
        ({fresser}) );

}

int ambrosiafunc(object spender, object fresser)
{
  int align;
  
  if((align=fresser->QueryProp(P_ALIGN))<-100)
  {
    tell_object(fresser, BS(
      "Du bekommst einen Teller voll mit leuchtendem Ambrosia in die Hand "
      "gedrueckt. Gierig isst Du das Zeug, spuckst es aber sofort wieder "
      "aus, weil es so widerlich suess und heilig schmeckt." ) );
    tell_room(TO, BS(
      fresser->Name()+" isst einen Teller voll mit leuchtendem Ambrosia, " 
      "spuckt aber alles wieder aus."), ({fresser}) );
  }  
  else
  {
    tell_object(fresser, BS(
      "Du bekommst einen Teller voll mit leuchtendem Ambrosia in die Hand "
      "gedrueckt. Gierig isst Du das Zeug, und fuehlst sofort die wohlige "
      "Waerme, die sich in Deinem Bauch ausbreitet. Kein Wunder, dass die "
      "Goetter darauf stehen, es schmeckt wirklich saugut." ) );
    tell_room(TO, BS(
      fresser->Name()+" isst einen Teller voll mit leuchtendem Ambrosia, " 
      "und sieht zufrieden aus."), ({fresser}) );
    fresser->heal_self(align/3);
  }
}

