inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  object ob;
  
  ::create();
  
  SetProp(P_INT_SHORT, "Container");
  SetProp(P_INT_LONG, "Container.\n");

  AddItem( "/p/armour/bracers/lederarmschienen", REFRESH_REMOVE);
  AddItem( "/p/armour/shield/messingschild", REFRESH_REMOVE);
  AddItem( "/p/armour/armour/messingruestung", REFRESH_REMOVE);

  ob=clone_object("/obj/money");
  ob->AddAmount(50+random(60));
  ob->move(TO);
}


void reset()
{
  object ob;
  
  ::reset();
  if (!present("geld"))
  {
    ob=clone_object("/obj/money");
    ob->AddAmount(50+random(60));
    ob->move(TO);
  }
}
