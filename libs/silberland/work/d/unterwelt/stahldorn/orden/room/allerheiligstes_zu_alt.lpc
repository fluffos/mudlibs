#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>


inherit "std/room";

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Das Allerheiligste" );
  SetProp( P_LIGHT, 10 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_INT_LONG,
    "Du befindest Dich im Allerheiligsten des Heiligen Ordens. Grelles Licht "
    "leuchtet diesen Raum aus, damit alles Uebel geblendet wird, wenn es "
    "hereinkommt. Die Waende, die Decke, selbst der Boden sind aus "
    "irgendeinem unheimlichen Grund nicht wirklich sichtbar, weil alles "
    "von heiligem Licht durchflutet wird, welches Deine Sinne benebelt. "
    "Der einzig wirklich sichtbare Bereich ist das "
    "Zentrum des Raums. Einige auffaellige Dinge befinden sich dort, aber "
    "das groesste ist ein glaeserner Sarkophag.");


  AddDetail( ({ "wand", "waende", "decke", "boden" }), 
    "Es wird alles in dieses gleissende Licht gehuellt, Du kannst kaum "
    "an etwas anderes denken." );
  AddDetail( ({ "licht" }), 
    "Es scheint von ueberall her zu kommen. Sein heiliges Leuchten erfuellt "
    "den Raum nicht nur visuell, sondern auch alle Personen hier drin "
    "werden von diesem heiligen Zauber erfasst." );
  AddDetail( ({ "zauber","leuchten" }), 
    "Als ob alles Gute der Welt in diesem Raum vereint waere." );
  AddDetail( ({ "dinge", "zentrum", "bereich" }), 
    "Im Zentrum des Raumes stehen neun Dinge: "
    "Ein glaeserner Sarkophag, eine goldene Monstranz, ein rotes Band, "
    "eine magische Blume, ein rostiger Degen, eine Flasche mit irgendwas "
    "drin, ein blau leuchtender Stein, "
    "eine schwebende Schrift und eine kleine weisse Kiste." );
  AddDetail( ({ "sarkophag" }), 
    "Der Sarkopharg besteht aus Glas. Darin kannst Du eine mumifizierte "
    "Leiche erkennen." );
  AddDetail( ({ "monstranz" }), 
    "Die Monstranz sieht aus wie eine grosser Kelch und besteht aus "
    "reinem Gold und ist mit vielen Edelsteine verziert und strahlt "
    "eine gewisse Heiligkeit aus und macht Dich ganz verlegen und ist "
    "wunderschoen und Du moechtest sie unbedingt haben und und und..." );
  AddDetail( ({ "band" }), 
    "Das Band ist rot. Das Band ist aus Seide. Es ist also ein rotes "
    "Seidenband. Zusaetzlich ist es mit goldenen Faeden durchwirkt. "
    "Es ist also ein golddurchwirktes rotes Seidenband. Das Band liegt "
    "auf den Sarkopharg. Es ist also ein auf dem Sarkopharg liegendes, "
    "golddurchwirktes rotes Seidenband" );
  AddDetail( ({"rotes band"}),
    "Das rote Band ist aus Seide. Es ist also ein rotes "
    "Seidenband. Zusaetzlich ist es mit goldenen Faeden durchwirkt. "
    "Es ist also ein golddurchwirktes rotes Seidenband. Das Band liegt "
    "auf den Sarkopharg. Es ist also ein auf dem Sarkopharg liegendes, "
    "golddurchwirktes rotes Seidenband" );
  AddDetail( ({"rotes seidenband", "seidenband"}),
    "Das rote Seidenband ist rot und aus Seide. "
    "Zusaetzlich ist es mit goldenen Faeden durchwirkt. "
    "Es ist also ein golddurchwirktes rotes Seidenband. Das Band liegt "
    "auf den Sarkopharg. Es ist also ein auf dem Sarkopharg liegendes, "
    "golddurchwirktes rotes Seidenband" );     
  AddDetail( ({ "auf dem Sarkopharg liegendes golddurchwirktes "
    "rotes seidenband", "golddurchwirktes rotes seidenband" }), 
    "Stahldorn teilt Dir mit: Man kanns mit den langen Details auch ein wenig "
    "uebertreiben, weisst Du? :-)");    
  AddDetail( ({ "faeden", "faden", "goldene faeden", "goldener faden",
                "golfaeden", "goldfaden"}),
    "Das rote Seidenband ist mit goldenen Faeden durchwirkt. "
    "Es sind also in rotes Seidenband eingewirkte Goldfaeden.");
  AddDetail( ({ "kiste" }), 
    "Die Kiste ist klein." );
  AddDetail( ({ "blume", "rose" }), 
    "Bei der Blume handelt es sich um eine Rose, die aus dem Boden heraus "
    "waechst." );
  AddDetail( ({ "degen" }), 
    "Der Degen ist rostig und daher sehr stumpf." );
  AddDetail( ({ "flasche" }), 
    "Die Flasche ist mit einer roten Fluessigkeit gefuellt." );
  AddDetail( ({ "fluessigkeit"}),
    "Die Fluessigkeit ist rot und ist in der Flasche drinnen.");
  AddDetail( ({ "stein" }), 
    "Der Stein leuchtet in einem magischen Licht." );
  AddDetail( ({ "schrift" }), 
    "Die Schrift schwebt magisch im Raum. Du kannst sie lesen." );
  AddReadDetail( ({ "schrift" }), 
    "Willst Du dass arkane Magien Dir winken,\n"
    "Dann musst Du den goettlichen Becher austrinken.\n"
    "Willst Du dass saemtliche Wunden sich schliessen \n"
    "Dann musst Du den Inhalt des Kelches geniessen. \n"
    "Drum wetz diese Klinge am Stein, \n"
    "Schneide die Rose, giess die Wurzeln mit Wein, \n"
    "Bind drum die Schleife, leg sie in die Truhe, \n"
    "Greif dann den Kelch und lass den Sarg in Ruhe!\n" );

//  AddCmd("", "mitloggen", 1);

}


int testfunc()
{
  return ROOM "altarraum"->testfunc();
}


    



















