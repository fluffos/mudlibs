  AddDetail( ({ "lampe", "oellampe" }), 
    "Eine Oellampe haengt an der Decke." );
  AddSpecialDetail( ({ "spinde", "reihe" }), 
    "spinde" );
  AddSpecialDetail( ({ "koje", "kojen", "schlafkoje", "schlafkojen" }), 
