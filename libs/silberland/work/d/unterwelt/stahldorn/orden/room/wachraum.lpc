  AddDetail( ({ "stangen", "bretter" }), 
    "Zusammengenommen bilden sie die Gestelle an der Wand." );
  AddDetail( ({ "orden" }), 
    "Dies hier ist nur der Wachraum. Wenn Du mehr vom Orden sehen willst, "
