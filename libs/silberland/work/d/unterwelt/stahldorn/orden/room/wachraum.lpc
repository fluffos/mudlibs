  AddDetail( ({ "decke" }), 
    "An der Decke haengt nur eine kleine Oellampe." );
  AddDetail( ({ "boden" }), 
    "Da ist nichts Interessantes." );
  AddDetail( ({ "wand", "waende" }), 
    "Links sind nur zwei Schlafkojen, rechts wird die Wand von den Gestellen "
