  AddDetail( ({ "lanze", "lanzen" }), 
    "Ein paar sind neu, andere alt und einige sind gar zerbrochen." );
  AddDetail( ({ "schild", "schilde" }), 
    "Die Schilde sind teilweise mit wunderschoenen Bemalungen verziert, "
    "teilweise aber auch sehr schlicht und billig." );
  AddDetail( ({ "bemalungen"}), 
    "Hauptsaechlich Einheitsabzeichen und kunstvolle Familienwappen wurden "
    "auf viele der Schilde gemalt." );
  AddDetail( ({ "einheitsabzeichen", "abzeichen","wappen",
                "familienwappen", "symbole" }), 
    "Kreuze, Loewen, gekreuzte Klingen, geballte Faeuste, Blumen, Drachen, "
    "Berge, Banner und viele andere Symbole der Heraldik finden sich in "
    "allen Farben auf den Schilden" );
  AddDetail( ({ "loewen" }), 
    "Furchterregend." );
  AddDetail( ({ "kreuz", "kreuze" }), 
    "Die haeufigsten Symbole auf den Schilden. Schliesslich gehoeren sie "
    "dustyfuerchtigen Paladinen, nicht irgendwelchen Strolchen." );
  AddDetail( ({ "klingen", "faeuste", "geballte faeuste" }), 
    "Sie symbolisieren militaerische Macht." );
  AddDetail( ({ "blumen", "schnoerkel" }), 
    "Die Blumen sind oft eher stilisierte, ausufernde Schnoerkel, als "
