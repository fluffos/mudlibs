  AddSmell( ({ "wein", "becher" }), 
    "Die Becher am Tisch riechen ein bisschen nach Wein." );
  AddDetail( ({ "essensreste" }), 
    "Nicht mehr viel uebrig. Das wird wohl noch zusammengekratzt und von "
