  AddDetail( ({ "spind" }), 
    "Welchen Spind meinst Du?" );
  AddSpecialDetail( ({ "spind 1" }), 
    "spind1" );
  AddSpecialDetail( ({ "spind 2" }), 
    "spind2" );
  AddSpecialDetail( ({ "spind 3" }), 
    "spind3" );
    

  AddSmell( ({ DEFAULT_SMELL }), 
    "Es riecht etwas muffig und nach Wein" );
  AddSound( ({ DEFAULT_SOUND, "koje", "schnarchen" }), #'kojen_sound );


//  AddDetail( ({ "" }), 
//    "" );

  AddExit("sueden", ROOM "vorraum");

  AddCmd( ({ "oeffne" }), "oeffnen" );
  AddCmd( ({ "nehme","nimm" }), "nehmen" );
  AddCmd( ({ "stecke", "steck" }), "stecken" );

}

int nehmen(string str)
{

  string arg;
  object *liste, obj;
  int    i, spind;
         
  if (!str) return 0;

  if ( (sscanf(str, "%s von gestell", arg)==1) ) 
  {
     notify_fail(BS("Das gehoert den Paladinen, also laesst Du es lieber da, "
              "bevor sie boese werden und Dich womoeglich angreifen.") );
     return 0;
  }
  else
  {
    if (sscanf(str, "%s aus spind %d", arg, spind)!=2 || spind<1 || spind>3)
      return 0;
  
    switch(spind)
    {
      case 1: if (spind_eins==IST_ZU)
              {
                write("Aber Spind 1 ist doch zu!\n");
                return 1;
              }
              break;
      case 2: if (spind_zwei==IST_ZU)
              {
                write("Aber Spind 2 ist doch zu!\n");
                return 1;
              }
              break;
      case 3: if (spind_drei==IST_ZU)
              {
                write("Aber Spind 3 ist doch zu!\n");
                return 1;
              }
      default: 
    }

    call_other( ROOM "spind"+spind, "???", 0);
    liste = all_inventory(find_object( ROOM "spind"+spind));
    for(i=(sizeof(liste))-1; i>=0;i--)
    {
      obj = liste[i];
      if (member(obj->QueryProp(P_IDS), arg)!=-1)
      {
        if (obj->move(TP)==ME_TOO_HEAVY)
        {
          write("Du kannst "+obj->name(WEN)+" nicht mehr tragen.\n");
          obj->move( ENV(TP) );
        }
        else
          write("Du nimmst "+obj->name(WEN)+" aus dem Spind.\n");
        say(TPN+" nimmt "+obj->name(WEN)+" aus dem Spind.\n");
        return 1;  // nur einmal nehmen
      }
    }
  }

  return 0;
}



int oeffnen(string was)
{

  string arg;
         
  if (!was) return 0;
  
  if ( was == "koje" || was == "schlafkoje" || 
       was == "vorhang" || was == "vorhaenge" ) 
  {
    if (koje_besetzt)
    {
      write(BS(
        "Du ziehst die Vorhaenge zur Seite und willst in die Koje schauen, "
        "aber aus ihr springt der veraergerte Insasse und blickt Dich "
        "grantig an."));
      say(BS(TP->Name()+" oeffnet die Vorhaenge einer der Schlafkojen, "
             "woraufhin ein schlaftrunkener Mann herausklettert."));
      CLONEOB(NPC "schlafwache")->move(TO, M_GO); 
      koje_besetzt=0;
      return 1;
    }
    else
    {
      write("Aber die Kojen sind doch beide schon offen!\n");
      return 1;
    }
  }
  else
  {
    if ( (sscanf(was, "spind%s", arg)==1) )
    {
      switch(arg)
      {
        case " 1": if(spind_eins==IST_OFFEN)
                  write("Aber Spind 1 ist doch schon offen!\n");
                else
                {
                  write("Du oeffnest Spind 1.\n");
                  spind_eins=1;
                }
                break;
        case " 2": if(spind_zwei==IST_OFFEN)
                  write("Aber Spind 2 ist doch schon offen!\n");
                else
                {
                  write("Du oeffnest Spind 2.\n");
                  spind_zwei=1;
                }
                break;
        case " 3": if(spind_drei==IST_OFFEN)
                  write("Aber Spind 3 ist doch schon offen!\n");
                else
                {
                  write("Du oeffnest Spind 3.\n");
                  spind_drei=1;
                }
                break;
        default: notify_fail("Welchen Spind meinst Du?\n");
                 return 0;
      }
      return 1;
     } 
  }

  return 0;
}

string spinde(string det)
{
  return
      "In den Spinden bewahren die Wachen ihre persoenlichen Dinge auf. \n"+
      "Insgesamt gibt es drei davon:\n"+
      "Der erste Spind ist "+(!spind_eins?"geschlossen.\n":"offen.\n")+
      "Der zweite Spind ist "+(!spind_zwei?"geschlossen.\n":"offen.\n")+
      "Der dritte Spind ist "+(!spind_drei?"geschlossen.\n":"offen.\n");
}

string kojen(string det)
{
  string ret;
  ret = "Dort koennen sich die Wachen auch mal kurz ausruhen. Die eine Koje "
        "ist offen und leer, ";
  ret+=
     koje_besetzt?
       "von der anderen siehst Du nur die zugezogenen Vorhaenge."
     :
       "die andere auch.";
  return BS(ret);
}

string kojen_sound(string det)
{
  return (koje_besetzt?"Ein leichtes Schnarchen dringt aus der Koje.\n":
                       "Man hoert nichts.\n");
}


void CloseKoje() {  koje_besetzt=1; }

void reset()
{
  CloseKoje();
  spind_eins=IST_ZU;
  spind_zwei=IST_ZU;
  spind_drei=IST_ZU;

  ::reset();
}


string spindinhalt(int spind)
{
  string text, raum;
  object *liste;
  int i;
  
  text="";
  raum=ROOM "spind"+spind;
  call_other( raum, "???", 0);
  liste = all_inventory(find_object( raum ));
  if(!sizeof(liste))
    text +="Nichts";
  else
  {
    if (sizeof(liste)==1)
      text += liste[0]->Name(WER);
    else
      text += implode(map_objects(liste[0..<2], "name", WER), ", ")+
              " und "+liste[<1]->name(WER);
  }

  return BS(CAP(text)+".");
}



string spind1(string str)
{
  string ret;

  ret=BS("Ein simpler Spind aus Metall dient dazu, die persoenlichen Dinge "
         "der Paladine aufzubewahren.");
  
  ret+=
     (spind_eins==IST_OFFEN)?
       ("Er ist offen und enthaelt:\n"+spindinhalt(1))
     :
       ("Er ist geschlossen.\n");
  return ret;
}



string spind2(string str)
{
  string ret;

  ret=BS("Ein simpler Spind aus Metall dient dazu, die persoenlichen Dinge "
         "der Paladine aufzubewahren.");
  
  ret+=
     (spind_zwei==IST_OFFEN)?
       ("Er ist offen und enthaelt:\n"+spindinhalt(2))
     :
       ("Er ist geschlossen.\n");
  return ret;
}


string spind3(string str)
{
  string ret;

  ret=BS("Ein simpler Spind aus Metall dient dazu, die persoenlichen Dinge "
         "der Paladine aufzubewahren.");
  
  ret+=
     (spind_drei==IST_OFFEN)?
       ("Er ist offen und enthaelt:\n"+spindinhalt(3))
     :
       ("Er ist geschlossen.\n");
  return ret;
}


int stecken(string str)
{
  string arg;
  object store, obj;
  int    i,spind;
  
  if (!str) return 0;
  if (sscanf(str, "%s in spind %d", arg,spind)!=2) return 0;
  if (spind<1 || spind>3)
  {
    notify_fail("Welchen Spind meinst Du?\n");
    return 0;
  }
  switch(spind)
  {
    case 1: if (spind_eins==IST_ZU)
            {
              write("Aber Spind 1 ist doch zu!\n");
              return 1;
            }
            break;
    case 2: if (spind_zwei==IST_ZU)
            {
              write("Aber Spind 2 ist doch zu!\n");
              return 1;
            }
            break;
    case 3: if (spind_drei==IST_ZU)
            {
              write("Aber Spind 3 ist doch zu!\n");
              return 1;
            }
    default: 
  }
  
  call_other( ROOM "spind"+spind, "???", 0);
  store = find_object( ROOM "spind"+spind);
  if (obj = present(arg, TP))
  {
      write("Du steckst "+obj->name(WEN)+" in den Spind.\n");
      say(TPN+" steckt "+obj->name(WEN)+" in den Spind.\n");
      obj->move(store, M_PUT);
  }
  else
    write(CAP(arg)+"? Sowas hast Du gar nicht dabei.\n");
  return 1;
}

