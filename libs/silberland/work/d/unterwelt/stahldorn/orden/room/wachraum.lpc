  AddDetail( ({ "helm", "helme" }), 
    "Helme in verschiedenen Ausfuehrungen." );
  AddDetail( ({ "harnisch", "harnische", "panzer", "brustpanzer" }), 
    "Ja auch ein paar Brustpanzer werden hier aufbewahrt." );
  AddDetail( ({ "waffe" }), 
    "Welche Waffe meinst Du?" );
  AddDetail( ({ "ausruestung" }), 
    "Viele Waffen und Ruestungen. Allerdings gehoeren sie den hier dienenden "
