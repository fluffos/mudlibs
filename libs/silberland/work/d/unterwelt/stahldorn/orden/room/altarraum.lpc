#include "../def.h"
#include <properties.h>
#include <language.h>
#include <rooms.h>


inherit "std/room";

int schale_voll, kelch_voll;

void initialize()
{
  kelch_voll=1;
  schale_voll=1;
}

create()
{
  ::create();

  initialize();

  SetProp( P_INT_SHORT, "Altarraum im Heiligen Orden" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_INT_LONG,
    "Vor Dir erstreckt sich der Altarraum des Heiligen Ordens. Wie der "
    "Name schon sagt, ist das wichtigste Stueck in diesem Raum der Altar. "
    "Davor stehen mehrere Reihen Kirchenbaenke, auf denen die "
    "Ordensmitglieder Platz nehmne koennen, wenn hier eine Messe "
    "stattfindet. Im Norden und Sueden gehts zu zwei Gebetsnischen. "
    "Eine dunkle Tafel steht ausserdem noch neben den Baenken.");
    
  AddDetail( ({ "tafel", "schiefertafel" }), 
    "Eine einfache Schiefertafel mit einem daran montierten Gefaess fuer die "
    "Kreide. Es steht etwas auf der Tafel." );
  AddReadDetail( ({ "tafel", "schiefertafel" }), 
    "\nHeute singen wir:\n"
    "~~~~~~~~~~~~~~~~~\n"
    "Psalm 437\n"
    "614\n"
    "1210 ('Hallelujah sei Dusty in der Hoeh')\n"
    "903c-f\n"
    "125\n"
    "Und danach als Leckerbissen: 502! :) \n\n" );
  AddDetail( ({ "gefaess" }), 
    "Ein kleines schalenfoermiges Gefaess wurde an die Tafel montiert. Da "
    "kann man wohl die Kreidestueckchen, mit denen man auf die Tafel malt, "
    "hineinlegen. Leider ist das Gefaess zur Zeit leer." );
  AddDetail( ({ "boden" }), 
    "Der Boden besteht aus kalten Steinfliesen. Ausser in der Mitte fuehrt "
    "ein relativ schmaler Laeufer vom Durchgang im Westen zum Altar im "
    "Osten." );
  AddDetail( ({ "laeufer", "teppich", "gang" }), 
    "Ein weinroter Teppich fuehrt zwischen den Kirchenbaenken hindurch und "
    "die Stufen hinauf zum Altar." );
  AddDetail( ({ "stein","steinfliesen","fliesen" }), 
    "Die Steinfliesen am Boden sind quadratisch und abwechselnd weinrot "
    "und weiss." );
  AddDetail( ({ "decke" }), 
    "Die Decke ist kahl und uninteressant." );
  AddDetail( ({ "waende", "wand" }), 
    "Waende gibt es kaum, da man ja Westen ein breiter Durchgang in den "
    "Nebenraum fuehrt, im Norden und Sueden die Gebetsnischen sind und im "
    "Osten der Altar steht." );
  AddDetail( ({ "altar", "stueck", "westen" }), 
    "Der Altar steht auf einem etwas erhoehten Bereich dieses Raumes, "
    "den man ueber ein paar Stufen besteigen muss. Er ist aufklappbar und "
    "auf seinen Fluegeln sind bunte Heiligenbilder aufgemalt. Auf dem "
    "Altar befinden sich ein Kelch, eine Schale und ein Buch. " );
  AddDetail( ({ "stufen", "stufe" }), 
    "Es gibt insgesamt drei davon und sie fuehren zum Altar. Ein weinroter "
    "Teppich liegt ausserdem auf ihnen." );
  AddDetail( ({ "nischen", "nische", "gebetsnische", "gebetsnischen", 
                "norden", "sueden" }), 
    "Am besten, Du gehst naeher ran, von hier aus kannst Du zu wenig "
    "erkennen." );
  AddDetail( ({ "bank", "baenke", "kirchenbank", "kirchenbaenke" }), 
    "Extrem unbequeme Baenke aus irgendeinem dunklen Holz wurden in "
    "mehreren Reihen hier aufgestellt. Sieht so aus, als ob die Baenke "
    "schon ziemlich lange hier stuenden. In der Mitte wurde ein mit einem "
    "Teppich ausgelegter Gang freigelassen, damit man direkt zu den Stufen, "
    "die zum Altar fuehren, durchgehen kann." );
  AddDetail( ({ "reihe", "reihen" }), 
    "Die Kirchenbaenke wurden in mehreren Reihen aufgestellt, sonst wuerden "
    "nicht alle Ordensmitglieder hier Platz haben." );
  AddDetail( ({ "messe" }), 
    "Noch findet keine Messe statt, aber es wird bereits eine vorbereitet." );
  AddDetail( ({ "raum", "altarraum" }), 
    QueryProp(P_INT_LONG) );
  AddDetail( ({ "durchgang", "osten" }), 
    "Ein Durchgang fuehrt nach Osten in den Nebenraum." );
  AddDetail( ({ "fluegel" }), 
    "Die Fluegel sind aufgeklappt und man kann die Bilder darauf bewundern.");
  AddDetail( ({ "bilder"," heiligenbilder", "heilige", "heiligen", 
                "heiliger" }), 
    "Der eine Heilige segnet gerade ein paar heilige Krieger, waehrend der "
    "andere Dich mit wilden Augen anstarrt." );
  AddDetail( ({ "augen", "auge", "aug" }), 
    "Als Du das Auge des Heiligen genauer betrachtest, faellt Dir auf, dass "
    "es eigentlich ein Knopf ist, den man druecken kann." );
  AddDetail( ({ "krieger" }), 
    "Wilde und rohe Typen, die bis an die Zaehne bewaffnet und gierig "
    "danach sind, Blut zu vergiessen." );
  AddDetail( ({ "knopf" }), 
    "Man kann ihn druecken." );
  AddSpecialDetail( ({ "kelch", "wein" }), 
    "kelch" );
  AddDetail( ({ "buch" }), 
    "Es ist auf Seite 693 aufgeschlagen." );
  AddReadDetail( ({ "buch", "seite","seite 693" }), 
    "...und es begab sich im Jahre Siebzehn nach Kunugorn,\n"
    "   dass anhub ein gar fuerchterlich Geschrey ob der Horden\n"
    "   der Finsternis und der garstigen Wesen der Dunkelheit\n"
    "   welche krochen hervor aus den Tiefen der Hoelle, um zu \n"
    "   knechten die Fleissigen, zu peinigen die Guten und \n"
    "   Gottesfuerchtigen und zu toeten die Mutigen. Denn stark war\n"
    "   der Arm des Unaussprechlichen und gross war die Macht...\n" );
  AddSpecialDetail( ({ "schale","hostien" }), 
    "schale" );


//  AddDetail( ({ "" }), 
//    "" );
    

  AddExit("sueden", ROOM "nische2");
  AddExit("westen", ROOM "zentralhalle");
  AddExit("norden", ROOM "nische1");

  AddCmd( ({ "trink", "trinke" }), "trinken" );
  AddCmd( ({ "iss" }), "essen" );
  AddCmd( ({ "drueck","druecke" }), "druecken" );
  AddCmd( ({ "blaettere","blaetter" }), "blaettern" );

}

string kelch(string str)
{
  string ret;
  
  ret="Es handelt sich um einen einfachen Kelch aus Metall. ";
  if (kelch_voll)
    return BS(ret+"Er ist mit weissem Wein gefuellt.");
  else
    return BS(ret+"Er ist leer.");
}


string schale(string str)
{
  string ret;
  
  ret="Es handelt sich um einen einfachen Schale aus Holz. ";
  if (schale_voll)
    return BS(ret+"In ihr befinden sich ein paar Hostien.");
  else
    return BS(ret+"Sie ist leer.");

}

int trinken(string str)
{
  notify_fail("Was willst Du trinken?\n");
  if(str != "wein" && str != "aus kelch") return 0;
  if (kelch_voll)
  {
    write("Du trinkst den Wein und fuehlst Dich besser.\n");
    say(TP->Name()+" trinkt einen Kelch voll Wein aus.\n");
    kelch_voll=0;
    TP->heal_self(75+random(25));
  }
  else
    write("Der Kelch ist aber leer!\n");
  return 1;
}


int essen(string str)
{
  notify_fail("Was willst Du essen?\n");
  if(str != "hostie" && str != "hostien") return 0;
  if (schale_voll)
  {
    write("Du futterst die Hostien alle auf und fuehlst Dich besser.\n");
    say(TP->Name()+" isst ein paar Hostien.\n");
    schale_voll=0;
    TP->heal_self(25+random(15));
  }
  else
    write("Die Schale ist aber leer!\n");
  return 1;
}

int testfunc()
{
    remove_call_out("OstenZu");
    call_out("OstenZu",10);
    return 1;
  
}


void OstenAuf()
{

    AddExit("osten", 
      ([ EX_DEST: ROOM "allerheiligstes",
         EXG_ID: "Bruder des Ordens",
         EXG_PLMSG:"Ein Ordensmitglied haelt Dich zurueck!\n",
         EXG_RMMSG:BS("@Wer@ will nach Osten gehen, ein Ordensmitglied haelt "
                   "ihn aber zurueck."),
         EX_TESTFUNC: "testfunc" ]));
    tell_room(TO,"Ploetzlich erscheint im Osten neben dem Altar ein weiterer "
                 "Ausgang.\n");
    ROOM "allerheiligstes"->AddExit("westen",
          ([ EX_DEST: ROOM "altarraum",
             EX_TESTFUNC: "testfunc" ]));
    tell_room(ROOM "allerheiligstes",
      "Ploetzlich erscheint ein Ausgang nach Westen.\n");
}

void OstenZu()
{
  remove_call_out("OstenZu");
  if(member(m_indices(QueryProp(P_EXITS)),"osten")>-1)
  {
    RemoveExit("osten");
    tell_room(TO,"Der Ausgang nach Osten schliesst sich wieder.\n");
    ROOM "allerheiligstes"->RemoveExit("westen");
    tell_room(ROOM "allerheiligstes",
      "Der Ausgang nach Westen schliesst sich wieder.\n");
  }
}


int druecken(string str)
{
  if(str != "knopf") return 0;

  write("Du drueckst den Knopf.\n");
  say(TP->Name()+" drueckt einen Knopf.\n");
  if(member(m_indices(QueryProp(P_EXITS)),"osten")<0)
  {
    OstenAuf();
    call_out("OstenZu", 10);
  }
  return 1;
}

int blaettern(string str)
{
  notify_fail("Worin willst Du blaettern?\n");
  if(member(({"buch um", "seite um", "in buch"}), str) < 0) return 0;

  write(BS("Du blaetterst im Buch, "
        "doch ploetzlich kommt von irgendwo ein leichter Windstoss und "
        "schlaegt wieder die Seite 693 auf."));
  say(TP->Name()+" blaettert in einem Buch.\n");
  return 1;
}


void reset()
{
  ::reset();
  initialize();
}
