#include "../def.h"

#include <ansi.h>

#define BSI(x,y) break_string(x,78,y,1)

string *roomlist;
string current_room;

void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

  seteuid(getuid(this_object()));

  roomlist = ({ "a3", "a5", "b2", "b4", "b5", "b6", "c2", "c3", "c4", "c5"
              , "d3", "d4", "d6", "e1", "e2", "e3", "e5", "f4" });

  current_room = "a3";

  return;
}

void Msg(string s)
{
  object pl;

  write_file(LOG "verdammnis.log", ctime()+": "+s+".\n");

  pl = find_player("ronja");

  if(!pl)              return;
  if(!interactive(pl)) return;

  s = BSI(s,"Verdammnis: ");
  if(pl->QueryProp(P_TTY)) s = ANSI_BOLD+ANSI_RED+s+ANSI_NORMAL;
  tell_object(pl,s);
}

string QueryCurrentRoom()
{
  return ROOM + "dam_" + current_room;
}

string QueryCurrentField()
{
  return current_room;
}

string GetNewRoom(string *excl)
{
  string *rooms;

  rooms = roomlist - ({ current_room }) - excl;

  return rooms[random(sizeof(rooms))];
}

void move(object room, object pl)
{
  tell_room(QueryCurrentRoom(),
    BS("Das Feld wird immer blasser, bis es ganz verschwindet.\n")
  );

  current_room = GetNewRoom( ({ }) );

  tell_room(QueryCurrentRoom(),
    BS("Ein Feld materialisiert sich vor Dir und bleibt etwas ueber "
       "der Plattform schweben.")
  );
}


