#include "../def.h"

inherit ROOM "inh_dammnis.lpc";

void create()
{
  richtungen = ({ "norden", "sueden", "westen", "osten" });
  zielraeume = ({ "c5", "c3", "b4", "d4" });
  viecher    = ({ });

  long_text  = "Eine spitze Felsnadel waechst hier sozusagen aus dem Boden "
               "und verschwindet weit oben in der Dunkelheit.";

  ::create();

  AddDetail( ({ "nadel", "felsnadel" }),
    "Eine extrem duenne, spitze Felsnadel. Man kann sie leicht mit "
    "einer Hand umfassen."
  );

  AddCmd( ({"umfasse","umfass"}) , "cmd_umfassen");
}

int cmd_umfassen(string str)
{
  notify_fail("Was willst Du umfassen?\n");

  if(!str || str == "") return 0;
  if(!(str == "felsnadel" ||
       str == "nadel"     )) return 0;

  tell_object(TP, "Du umfasst die Felsnadel mit einer Hand. Geht "
                  "problemlos.\n");
  return 1;
}

