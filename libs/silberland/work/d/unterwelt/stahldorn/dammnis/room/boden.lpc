#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer felsigen Hoehle. Zumindest glaubst Du, "
    "dass es sich um eine Hoehle handelt, denn es ist nirgendwo eine Decke zu "
    "sehen. Nur ganz ganz weit oben kannst Du ein seltsames Gewirr von Balken "
    "erkennen. Es ist ziemlich kuehl. Wenn Du ausatmest, steigt eine kleine "
    "Dampfwolke auf."
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus kaltem Fels. Ueberall liegen Skelette und die "
    "Ueberreste zerschmetterter Koerper herum. "
    "Achja, an einer Stelle wird der Fels "
    "durch einen im Boden eingelassenen Steinquader unterbrochen."
  );

  AddDetail( ({ "waende" }),
    "Die Waende bestehen aus kaltem Fels."
  );

  AddDetail( ({ "decke" }),
    "Du kannst keine Decke erkennen, weil sie zu weit oben ist. "
    "Aber weit ueber Dir ist ein Gewirr von Balken."
  );

  AddDetail( ({ "quader", "steinquader" }),
    "Dabei handelt es sich sicher um eine Falltuer."
  );

  AddDetail( ({ "tuer", "falltuer" }),
    "Die kann man sicher oeffnen, indem man dran zieht."
  );

  AddDetail( ({ "gewirr", "balken" }),
    "Irgendetwas bewegt sich da oben, aber Du bist Dir nicht ganz sicher."
  );

  AddDetail( ({ "dampf", "dampfwolke", "wolke" }),
    "Eine kleine Dampfwolke steigt auf, wenn Du ausatmest. Ganz schoen kalt "
    "hier."
  );

  AddDetail( ({ "fels", "gestein", "stein" }),
    "Der Fels ist uralt und glatt abgeschliffen. Als ob die Hoehle "
    "kuenstlichen Ursprunges waere."
  );

  AddDetail( ({ "kerle" }),
    "Du wuerdest sicherlich sehr viel Mitleid haben, wenn Du sie gekannt "
    "haettest."
  );

  AddDetail( ({ "mitleid" }),
    "Haettest Du sicherlich sehr viel!"
  );

  AddDetail( ({ "sturz" }),
    "Der Aufprall scheint wohl zu hart gewesen zu sein."
  );

  AddDetail( ({ "aufprall" }),
    "Sei froh, dass Du noch lebst!"
  );

  AddDetail( ({ "stelle" }),
    "Die sieht aber interessant aus!"
  );
 
  AddDetail( ({ "hoehle" }),
    QueryProp(P_INT_LONG) );

  AddDetail( ({ "skelette", "ueberreste", "koerper" }),
    "Arme Kerle. Die duerften von oben heruntergefallen sein und den Sturz "
    "nicht verkraftet haben."
  );

  AddSmell( ({ DEFAULT_SMELL }),
    "Es riecht furchtbar muffig und stickig.\n" );

  AddCmd(({"oeffne","zieh","ziehe"}) , "cmd_oeffnen");
  AddCmd(({"atme", "atem"})          , "cmd_atmen");

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist es, hier heraus zu finden.\n");
  return 0;
}

int cmd_oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");

  if(!str || str == "") return 0;
  if(!(str == "tuer"        ||
       str == "falltuer"    ||
       str == "an tuer"     ||
       str == "an falltuer" )) return 0;

  tell_object(TP,"Du oeffnest die Falltuer und kletterst hinunter.\n");
  tell_room(TO,TP->Name()+" oeffnet eine Falltuer und klettert hinunter.\n",
    ({ TP })
  );

  TP->move("/d/unterwelt/basics/central/room/u_damm", M_GO);

  return 1;

}

int cmd_atmen(string str)
{
  notify_fail("Atme wie?\n");

  if(!str || str == "") return 0;
  if(!(str == "aus"))    return 0;

  tell_object(TP, BS("Du atmest heftig durch den Mund aus. Eine kleine "
                     "Dampfwolke bildet sich und loest sich langsam auf."));
  tell_room(TO,TP->Name()+" schnauft so heftig, das es dampft.\n", ({ TP }) );

  return 1;
}
