#include "../def.h"

inherit "std/mnpc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Hoellenhund");
  SetProp(P_LONG,
    "Dieser Hoellenhund hat keine drei Koepfe, wie in alten Ueberlieferungen "
    "immer wieder berichtet wird, sondern nur einen. Dieser ist mit "
    "langen, feurigen Zaehnen bewaffnet. Ein muskuloeser Koerper, "
    "krallenbewehrte Pfoten an den kraeftigen Beinen und ein langer, "
    "peitschenhafter Schwanz ergaenzen das eher an eine Echse denn einen "
    "Hund erinnernde Bild."
  );

  SetProp(P_NAME, "Hoellenhund");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50, T_RANGE_MAX:50]));

  AddId( ({ "hund", "hoellenhund" }) );
  AddClass( CL_DEMON );

  create_default_npc(10);

  SetProp(P_HANDS, ({" mit Feuerzaehnen", 110, ({ DT_PIERCE, DT_FIRE }) }));
  SetProp(P_XP, QueryProp(P_XP) * 2 );
  SetProp(P_RACE, "Daemon" );
  SetProp(P_SIZE, 90 + random (20));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 15);
  SetProp(P_NOMAGIC, 0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      1.0, DT_UNHOLY:   -0.5, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_DIE_MSG,  " loest sich toedlich getroffen auf.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "knurrt hoellisch laut.\n");

  SetProp(P_MNPC_AREA, (ROOM "dam_") );
  SetProp(P_MNPC_WAIT, ({ 5, 25, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "dam_a3");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS | MOV_MOVES | MOV_INFIGHT | MOV_MAYLOAD);

  SetProp(P_SPELLRATE, 35);

  SetAttackChats( 10,
    ({"Der Hoellenhund knurrt boese.\n"
     ,"Der Hoellenhund schnappt nach Dir.\n"
     ,"Der Hoellenhund wirbelt herum.\n"
     })
  );

  AddSpell(1, 350,
    "Der Hoellenhund beisst Dich kraeftig.\n",
    "Der Hoellenhund beisst @WEN kraeftig.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1])
  );

  AddSpell(2, 100,
    "Der Hoellenhund beisst Dich mittelkraeftig.\n",
    "Der Hoellenhund beisst @WEN mittelkraeftig.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1])
  );

  AddSpell(1,250,
    "Der Hoellenhund springt Dir an die Gurgel.\n",
    "Der Hoellenhund springt @WEM an die Gurgel.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1])
  );

  AddSpell(2,90,
    "Der Hoellenhund trifft Dich mit seinem Peitschenschwanz.\n",
    "Der Hoellenhund trifft @WEN mit seinem Peitschenschwanz.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1])
  );

  SUID;

  switch(random(3))
  {
    case 0:
      "/obj/gemmaster"->DistributeGem(1,6,0,1);
      break;
    case 1:
      "/obj/pearlmaster"->DistributePearl(1,6,0,1);
      break;
    default:
      "/obj/gemmaster"->DistributeGem(1,3,0,1);
      "/obj/pearlmaster"->DistributePearl(1,3,0,1);
      break;
  }
}

