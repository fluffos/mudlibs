#include "../def.h"

inherit "std/mnpc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Hoellenfuerst");
  SetProp(P_LONG,
    "Vor Dir steht ein dunkler Fuerst der Hoelle, ein Daemon, der Deine "
    "Anwesenheit hier unten ganz und gar nicht erfreulich zu finden "
    "scheint. Dementsprechend schlecht ausgepraegt ist auch seine "
    "Gastfreundschaft. In seiner Gegenwart werden Sterbliche sich "
    "rasch ihrer Sterblichkeit bewusst..."
  );

  SetProp(P_NAME, "Hoellenfuerst");
  SetProp(P_GENDER, MALE);

  AddId(({ "fuerst", "hoellenfuerst" }));
  AddClass( CL_DEMON );

  create_default_npc(17);

  SetProp(P_HANDS, ({" mit Hoellenhaenden", 180, ({ DT_BLUDGEON, DT_FIRE }) }));
  SetProp(P_XP, QueryProp(P_XP) * 2 );
  SetProp(P_RACE, "Daemon" );
  SetProp(P_SIZE, 220 + random (20));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 20);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 15);
  SetProp(P_NOMAGIC, 0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      1.0, DT_UNHOLY:   -0.5, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_DIE_MSG,  " loest sich toedlich getroffen in einer Flamme auf.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "hoert Dir nicht zu.\n");


  SetProp(P_MNPC_AREA, (ROOM "dam_") );
  SetProp(P_MNPC_WAIT, ({ 5, 20, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "dam_a3");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS | MOV_MOVES | MOV_OUTDOORS | MOV_MAYLOAD);

  SetProp( P_REJECT, ({ REJECT_DROP,
    "@WER faellt durch den Hoellenfuersten durch.\n" }) );

  SetProp(P_SPELLRATE, 70);

  SetAttackChats( 25,
    ({"Der Hoellenfuerst schreit: Verdammt seist Du fuer alle Ewigkeit!\n"
     ,"Der Hoellenfuerst fleht um teuflischen Beistand.\n"
     ,"Der Hoellenfuerst starrt Dich mit glutroten Augen an.\n"
     ,"Der Hoellenfuerst versucht, Dich zu verbrennen.\n"
     ,"Der Hoellenfuerst lacht Dich aus.\n"
     ,"Der Hoellenfuerst sagt: Zur Hoelle mit Dir!\n"
     })
  );

  AddSpell(2,120,
    "Der Hoellenfuerst jagt Dir schreckliche Angst ein.\n",
    "Der Hoellenfuerst jagt @WEM schreckliche Angst ein.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1])
  );

  AddSpell(1,200,
    "Eine feurige Wolke umgibt Dich ploetzlich.\n",
    "@WER ist ploetzlich von einer feurigen Wolke umgeben.\n",
     DT_FIRE
  );

  AddSpell(2,80,
    "Der Hoellenfuerst verdammt Dich.\n",
    "Der Hoellenfuerst verdammt @WEN\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1])
  );

  SUID;

  switch(random(3))
  {
     case 0:
       "/obj/gemmaster"->DistributeGem(1,6,0,1);
       break;
     case 1:
       "/obj/pearlmaster"->DistributePearl(1,6,0,1);
       break;
     default:
       "/obj/gemmaster"->DistributeGem(1,3,0,1);
       "/obj/pearlmaster"->DistributePearl(1,3,0,1);
       break;
  }
}

varargs void die(int poisondeath)
{
  object enemy,item;

  if(enemy = QueryProp(P_KILLER))
  {
    if((item = present("\npaladintaskitem", enemy)) &&
        item->GetTask(8, enemy))
    {
      item->SetFlag(0);
    }
  }

  ::die(poisondeath);
}

