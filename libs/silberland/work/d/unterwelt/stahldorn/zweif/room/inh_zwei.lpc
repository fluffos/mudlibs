#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

#ifndef ZWEIF_KEY_MASTER
#define ZWEIF_KEY_MASTER OBJ "kmaster"
#endif

string *tueren, position;

create()
{
  int i;
  ::create();
  position = file_name(this_object())[<2..<1];
  tueren = ZWEIF_KEY_MASTER->doors_in_room(position);

  SetProp( P_INT_SHORT, "Ein sechseckiger Raum" );
  SetProp( P_INT_LONG, BS(  
    "Du befindest Dich in einem merkwuerdigen sechseckigen Raum. Jede der "
    "sechs Waende ist in einer anderen Farbe gehalten, und zwar von Norden "
    "im Uhrzeigersinn in der Reihenfolge: rot, orange, gelb, gruen, blau "
    "und violett. Die Decke und der Boden hingegen sind weiss. ") );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28]) );

  AddDetail( ({ "wand", "waende" }),
    "Welche Wand meinst Du denn? Die Nordwestwand? Die Suedwand?\n" );
  AddDetail( ({ "nordwand", "norden" }),
    "Die Nordwand wurde rot gestrichen." );
  AddDetail( ({ "nordostwand", "nordosten" }),
    "Die Nordostwand wurde orange gestrichen." );
  AddDetail( ({ "suedostwand", "suedosten" }),
    "Die Suedostwand wurde gelb gestrichen." );
  AddDetail( ({ "suedwand", "sueden" }),
    "Die Suedwand wurde gruen gestrichen." );
  AddDetail( ({ "suedwestwand", "suedwesten" }),
    "Die Suedwestwand wurde blau gestrichen." );
  AddDetail( ({ "nordwestwand", "nordwesten" }),
    "Die Nordwestwand wurde violett gestrichen." );
  AddDetail( ({ "osten", "westen" }),
    "Da der Raum die Form eines gleichmaessigen Sechseckes aufweist, "
    "befindet sich sowohl im Osten, wie auch im Westen nur je eine 60 Grad "
    "Ecke. Sonst nichts." );
  AddDetail( ({ "ecke", "ecken" }),
    "An den Ecken stossen immer je zwei farbige Waende zusammen. Sie weisen "
    "einen Winkel von haargenau sechzig Grad auf." );
  AddDetail( ({ "winkel" }),
    "Sechzig Grad. Plusminus Null.\n" );
  AddDetail( ({ "boden" }),
    "Der Boden ist weiss, wie die Decke. Sonst faellt Dir nichts daran auf.");
  AddDetail( ({ "decke" }),
    "Die Decke ist weiss, wie der Boden. Sonst faellt Dir nichts daran auf.");
  
//  AddDetail( ({ "" }),
//    "" );
//  AddSound( ({ "" }),
//    "" );
//  AddSmell( ({ "" }),
//    "" );

  for(i=sizeof(tueren)-1; i>=0; --i)
  {
    string color;

    color = get_door_col(tueren[i]);
//    DB(color);
//    DB(get_dest_room(tueren[i]));
    NewDoor( tueren[i], get_dest_room(tueren[i]), 
       ({ "tuer", color + "e tuer" }), 
       ({ D_FLAGS, DOOR_NEEDKEY|DOOR_RESET_CL, 
          D_NAME, color + "e Tuer",
          D_GENDER, FEMALE,
          D_SHORT, "Eine "+color+"e Tuer (%s).", 
          D_LONG, BS("In der "+CAP(tueren[i])+"\b\bwand befindet sich eine "
                     +color+"e Tuer mit einem maechtigen Schloss. Ein "
                     +"Schluessel mit "
                     +ZWEIF_KEY_MASTER->query_lock_shape(position, tueren[i])
                     +" wuerde hier wahrscheinlich passen."), 
        //  D_KEYTESTFUNC, "door_unlock" 
        }) );
  } 
}

string newpos(string oldpos, int xmod, int ymod)
{ return sprintf("%c%c",oldpos[0]+xmod,oldpos[1]+ymod); }


string get_door_col(string dir)
{
   switch(dir)
   {
     case "norden": return "rot";
     case "nordosten": return "orangen";
     case "suedosten": return "gelb";
     case "sueden": return "gruen";
     case "suedwesten": return "blau";
     case "nordwesten": return "violett";
     default: return "buggend";
   }
}

string get_dest_room(string dir)
{
  string ret;
  ret = ROOM "zweif_"; 

  switch (dir)
  {
    case "norden": return (ret+ newpos(position,0,2)); 
    case "nordosten": return (ret+ newpos(position,1,1));
    case "suedosten": return (ret+ newpos(position,1,-1));
    case "sueden": return (ret+ newpos(position,0,-2));
    case "suedwesten": return (ret+ newpos(position,-1,-1));
    case "nordwesten": return (ret+ newpos(position,-1,1));
    default: return "BUG!";
  }
}


int door_unlock()
{


}



