#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

#ifndef ZWEIF_KEY_MASTER
#define ZWEIF_KEY_MASTER OBJ "kmaster"
#endif

mapping keys;   //Die Schluessel am Bund. 


create()
{
  if(!is_clone(this_object())) return;
  ::create();

  keys=([ "A": 0, "B": 0, "C": 0, "D": 0, "E": 0, "F": 0, "G": 0, "H": 0,
          "I": 0, "J": 0, "K": 0, "L": 0, "M": 0, "N": 0, "O": 0, "P": 0,
          "Q": 0, "R": 0, "S": 0, "T": 0, "U": 0, "V": 0, "W": 0, "X": 0,
          "Y": 0, "Z": 0, "?": 0 ]);

  SetProp(P_MATERIAL, MAT_IRON);
  SetProp(P_NAME, "Schluesselbund");
  AddId( ({"bund", "schluesselbund"}));
  SetProp(P_VALUE, 1000);
  SetProp(P_WEIGHT, 700);
  SetProp(P_GENDER, MALE);
  SetProp(P_NEVERDROP, 1);

  AddKey("A");
  AddKey("D");
}

int AddKey(string schluessel)
{
  if(!member(keys, schluessel)) return -1;
  if(keys[schluessel]) return 0; 
  keys[schluessel] = 1;
  return 1;
}

int RemoveKey(string schluessel)
{
  if(!keys[schluessel])  return 0;
  keys[schluessel] = 0;
  return 1;
}

int QueryKeyOnRing(string schluessel) { return keys[schluessel]; }

string *QueryKeysOnRing()
{
  string *ret, *str;
  int i;

  ret = ({});
  str = m_indices(keys);
  for(i=sizeof(str)-1; i>=0; i--)
     if(keys[str[i]]) ret+=({str[i]});

  return ret;
}

_query_short() { 
    return "Ein Schluesselbund mit "+sizeof(QueryKeysOnRing())+" Schluesseln";} 

_query_long()
{
  string ret, *schlu;
  int i;

  ret="Du siehst einen simplen Metallring mit Schluesseln dran.\n";
  for(i=sizeof(schlu=QueryKeysOnRing())-1; i>=0; i--)
  {
    ret += "Ein Schluessel mit "+
            ZWEIF_KEY_MASTER->query_key_shape(schlu[i])+".\n";
  }
  return ret;
}


string *QueryDoorKey() 
{ return 
  ZWEIF_KEY_MASTER->WhatCanIOpenWith(file_name(all_environment(TO)[<1])[<2..<1],  QueryKeysOnRing()); 
}




