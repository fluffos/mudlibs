#include "../def.h"

inherit "std/thing";

#define DIR_N "norden"
#define DIR_NO "nordosten"
#define DIR_NW "nordwesten"
#define DIR_S "sueden"
#define DIR_SO "suedosten"
#define DIR_SW "suedwesten"

mapping keys;   // Wie viele Zacken, Kerben und Rillen haben die Schluessel?
mapping doors;  // Welcher Raum hat welche Tueren in welche Richtungen und
                // mit welchem Schluessel oeffnet man sie?

create()
{
  if(is_clone(this_object())) remove();
  ::create();

  doors = ([ "a1": ({ DIR_N, DIR_NO }); ({ "C", "F" }),
             "a3": ({ DIR_S }); ({ "C" }),
             "a5": ({ DIR_N, DIR_SO }); ({ "B", "E" }),  
             "a7": ({ DIR_N, DIR_S }); ({ "A", "B" }), 
             "a9": ({ DIR_S, DIR_SO }); ({ "A", "D" }), 
             "b2": ({ DIR_SW, DIR_NO }); ({ "F", "J" }), 
             "b4": ({ DIR_NW, DIR_NO }); ({ "E", "I" }), 
             "b6": ({ DIR_NO }); ({ "H" }), 
             "b8": ({ DIR_NW, DIR_SO }); ({ "D", "G" }), 
             "c1": ({ DIR_N, DIR_NO }); ({ "L", "O" }), 
             "c3": ({ DIR_N, DIR_SO, DIR_S, DIR_SW }); ({ "K", "N", "L", "J" }),
             "c5": ({ DIR_S, DIR_SW }); ({ "K", "I" }), 
             "c7": ({ DIR_SO, DIR_SW, DIR_NW }); ({ "M", "H", "G" }), 
             "d2": ({ DIR_N, DIR_SW, DIR_NW }); ({ "Q", "O", "N" }), 
             "d4": ({ DIR_SO, DIR_S }); ({ "S", "Q" }), 
             "d6": ({ DIR_N, DIR_NW }); ({ "P", "M" }), 
             "d8": ({ DIR_SO, DIR_S }); ({ "R", "P" }), 
             "e1": ({ DIR_N, DIR_NO }); ({ "V", "Y" }), 
             "e3": ({ DIR_N, DIR_S, DIR_NW }); ({ "U", "V", "S" }), 
             "e5": ({ DIR_N, DIR_NO, DIR_S }); ({ "T", "X", "U" }), 
             "e7": ({ DIR_NO, DIR_S, DIR_NW }); ({ "W", "T", "R" }),
             "f2": ({ DIR_N, DIR_SW }); ({ "Z", "Y" }) ,
             "f4": ({ DIR_S, DIR_NO }); ({ "Z", "?" }), 
             "f6": ({ DIR_SW }); ({ "X" }),
             "f8": ({ DIR_SW }); ({ "W" }),
             "g5": ({ DIR_SW }); ({ "?" }) ]);

  keys=(["A": 1; 1; 1,    //Zacken, Kerben, Rillen
         "B": 1; 1; 2,
         "C": 1; 1; 3,
         "D": 1; 2; 1,
         "E": 1; 2; 2,    
         "F": 1; 2; 3,
         "G": 1; 3; 1,
         "H": 1; 3; 2,
         "I": 1; 3; 3,
         "J": 2; 1; 1,
         "K": 2; 1; 2,
         "L": 2; 1; 3,  //Schluessel L hat 2 Zacken, 1 Kerbe und 3 Rillen.
         "M": 2; 2; 1,
         "N": 2; 2; 2,
         "O": 2; 2; 3,
         "P": 2; 3; 1,
         "Q": 2; 3; 2,
         "R": 2; 3; 3,
         "S": 3; 1; 1,
         "T": 3; 1; 2,
         "U": 3; 1; 3,
         "V": 3; 2; 1,
         "W": 3; 2; 2,
         "X": 3; 2; 3,
         "Y": 3; 3; 1,
         "Z": 3; 3; 2,
         "?": 3; 3; 3 ]);
}

string int2str(int num)
{
   switch(num)
   {
     case 1: return "einer";
     case 2: return "zwei";
     case 3: return "drei";
     default: return "viele";
   }
}


string query_key_shape(string schluessel)
{
  int zacken, kerben, rillen;

  zacken = keys[schluessel, 0];
  kerben = keys[schluessel, 1];
  rillen = keys[schluessel, 2];
//DB(int2str(zacken));
  return ( int2str(zacken) + " Zacke"+((zacken>1)?"n":"") + ", " +
           int2str(kerben) + " Kerbe"+((kerben>1)?"n":"") + " und " +
           int2str(rillen) + " Rille"+((rillen>1)?"n":"") );
}

string query_lock_shape(string pos, string dir) {
//    DB(doors[pos,1][member(doors[pos,0], dir),
    return query_key_shape(doors[pos,1][member(doors[pos,0], dir)]); }


string *doors_in_room(string pos) { return doors[pos,0]; }

string *WhatCanIOpenWith(string pos, string *str)
{
  int i, j;
  string *ret, *tmp, *tmp2, dest;

  ret = ({});
  tmp = doors[pos, 0];
  tmp2 = doors[pos, 1];
  pos = ROOM "zweif_" + pos;

  j=sizeof(tmp);
  for (i=0; i<j; i++) {
     dest=find_object(pos)->get_dest_room(tmp[i]);
     if(member(str, tmp2[i]) > -1)
     {  
       if(pos < dest)
          ret += ({ pos + ":" + dest });
       else
          ret += ({ dest + ":" + pos });
     }
  }
  return ret;
}


