/********************************************************************
 * NPC: Eine Riesenspinne feur die Koenigin als Haustier            *
 * Datei: /d/unterwelt/angel/dhrkion/npc/shareia.c                  *
 * Letzte Ueberarbeitung: 20.12.2002                                *
 ********************************************************************/

#include "../def.h"
#include "/sys/mnpc.h"

inherit "std/mnpc";

void gift(object enemy, int damage, mixed dam_type)
{
  enemy->AddPoison(1+random(6));
}

void create()
{

  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Shareia, die Riesenspinne der Dunkelelfenkoenigin");
  SetProp(P_LONG,
    "Shareia stellt einen nahezu ueberwaeltigenden Anblick dar: Mit ueber 5 Meter Laenge, "
    "pechschwarzer, dichter Behaarung und leuchtend roten Augen vereint sie alle Merkmale "
    "die Lloth bei ihren vielbeinigen Untertanen schaetzt. Shareia wurde zwar nicht von Lloth "
    "persoenlich zum Schutze der Koenigin befohlen, wuerde aber dennoch auf alle Faelle ihr "
    "Leben fuer das der Koenigin einsetzen."
  );

  SetProp(P_NAME, "Shareia");
  SetProp(P_ARTICLE, 0);

  set_living_name("shareia");

  SetProp(P_GENDER, FEMALE);
  AddId( ({"riesenspinne", "spinne", "shareia", "NOWIMPY", "NOCONTROL"}) );

  create_default_npc(26);

  SetProp(P_HANDS,({" mit giftigen Beine und geifernden Zangen"
                   ,QueryProp(P_HANDS)[1]
                   ,({ DT_POISON, DT_PIERCE })
                   })
  );

  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 550);
  SetProp(P_ALIGN, -600);
  SetProp(P_MAX_HANDS, 8);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.4, DT_COLD:      0.1, DT_WATER:      -0.8
     , DT_AIR:       0.0, DT_LIGHTNING:-0.3, DT_EXPLOSION:  -0.2
     , DT_SOUND:     0.0, DT_LIGHT:    -0.8, DT_ELECTRIC:    0.1
     , DT_ACID:      0.0, DT_POISON:   -1.0, DT_TERROR:     -0.6
     , DT_HOLY:      0.1, DT_UNHOLY:    0.0, DT_MAGIC:      -0.4
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_NOMAGIC, 0);

  SetProp(P_MSGIN, "krabbelt flink herein");
  SetProp(P_MSGOUT, "krabbelt flink");
  SetProp(P_MMSGIN, "krabbelt flink herein");
  SetProp(P_MMSGOUT, "krabelt flink");

  SetProp(P_MNPC_AREA, ({"/gilden/dunkelelfen", "/d/unterwelt/zordan/dhrkion/room/palast-d3",
                         "/d/unterwelt/zordan/dhrkion/room/palast-e3", "/d/unterwelt/zordan/dhrkion/room/palast-f3"}) );
  SetProp(P_MNPC_WAIT, ({ 30, 30, 15 }));
  SetProp(P_MNPC_DEFAULTROOM, "/gilden/dunkelelfen");
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);

  SetProp(P_DIE_MSG,  " bricht zusammen und bleibt regungslos am Boden liegen.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  // Entschaerft: Von 8 Attacken auf 2 reduziert
  ModifySkillAttribute(ME, SA_SPEED, 200, 5);

  AddInfo( "angel", "sieht Dir in die Augen und nickt.");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name()+" zersetzt @WEN mit ihrem Gift.\n" }) );

  SetProp(P_SPELLRATE, 40);

  AddSpell(1, 250,
    Name()+" schlaegt ihre Giftzangen in Dich und vergiftet Dich.\n",
    Name()+" schlaegt ihre Giftzangen in @WEN und vergiftet @WEN .\n",
     DT_POISON, "gift", ([SP_SHOW_DAMAGE:1])
  );

  AddSpell(6, 400,
    Name()+" spritzt Dich mit Gift voll.\n",
    Name()+" spritzt @WEN mit Gift voll.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1])
  );

  AddSpell(2, 600,
     Name()+" haelt Dich fest und beisst Dich.\n",
     Name()+" haelt @WEN fest und beisst @WEN.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1])
  );

   AddSpell(1, 750,
     Name()+" stranguliert Dich beinahe mit ihrem Faden.\n",
     Name()+" stranguliert @WEN beinahe mit ihrem Faden.\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1])
   );

  SUID;

  CLONEME("/p/std/skills/sewing_tanning/obj/spinnenseide");
}

int _query_wimpy()
{
  return 0;
}

void init()
{
  ::init();

  if(TP && TP->id("\ndunkelelfenkoenigin") || TP->id("mystixfis"))
    AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer ==TO )
    write_file( "/d/unterwelt/angel/dhrkion/log/die.log", sprintf("%s: "+Name(WER)+" toetet %s, (XP-Verlust : "+lostexp+").\n",dtime(time()), capitalize(TP->query_real_name()) ) );
  return;
}

varargs void die(int poisondeath)
{
  object enemy;

  if(enemy=QueryProp(P_KILLER))
    write_file( "/d/unterwelt/angel/dhrkion/log/kill.log", sprintf("%s: %s toetet "+Name(WEN)+".\n",dtime(time()), capitalize(TP->query_real_name()) ) );

  ::die(poisondeath);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  DHRKIONMASTER->addfeind(enemy);
  ::Defend(dam, dam_type, spell, enemy);
}