/********************************************************************
 * NPC: Tierverkaeufer                                              *
 * Datei: /d/unterwelt/angel/petshop/npc/tanthyon.c                 *
 * Letzte Ueberarbeitung: 22.12.2002                                *
 ********************************************************************/

#include "../def.h"

inherit "/p/service/angel/haustiere/std_petshop_vendor";

// Imported from std_darkelf.c  (by Ronja@Silberland)
varargs void create_default_darkelf(int level, int glevel, int aggressive)
{

  if(!intp(level))      level      = 1;
  if(level < 1)         level      = 1;
  if(!intp(glevel))     glevel     = level;
  if(!glevel)           glevel     = level;
  if(glevel < 1)        glevel     = 0;
  if(!intp(aggressive)) aggressive = 0;
  if(aggressive < 0)    aggressive = 0;
  if(aggressive > 100)  aggressive = 100;

  AddClass( ({CL_NIGHTVISION, CL_DARKELF}) );
  AddId( ({"dunkelelf","elf","DUNKELELFNPC"}) );

  SetProp(P_RACE,"Dunkelelf");

  SetProp(P_GUILD, "dunkelelfen");
  SetProp(P_GUILD_LEVEL, glevel);
  SetProp(P_TEMPERATURE_RANGE,([T_RANGE_MIN:-15,T_RANGE_MAX:55]));


  SetProp(P_SIZE,185);
  SetProp(P_WEIGHT, 72000);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN,"schleicht herein");
  SetProp(P_MSGOUT,"schleicht");
  SetProp(P_MMSGIN,"tritt aus einem Schatten hervor");
  SetProp(P_MMSGOUT,"verschwindet in einem Schatten");
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.6, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.7, DT_UNHOLY:   -0.4, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  if(glevel >= 10) //terrorblitz
  {
    AddSpell(2,150+glevel*7,
      Name(WER)+" wirft einen Terrorblitz auf Dich.\n",
      Name(WER)+" wirft einen Terrorblitz auf @WEN.\n",
      ({DT_TERROR}) , ([SP_SHOW_DAMAGE:1])
    );
  }

  if(glevel >= 12) //ausweichen
  {
    AddSpell(2,1,"","",DT_MAGIC, "spell_ausweichen");
  }

  if(glevel >= 15) //dunkellanze
  {
    AddSpell(2,150+glevel*7,
      Name(WER)+" wirft eine Dunkellanze auf Dich.\n",
      Name(WER)+" wirft eine Dunkellanze auf @WEN.\n",
      ({DT_UNHOLY}), ([SP_SHOW_DAMAGE:1])
    );
  }

  create_default_npc(level);
}

create()
{
  ::create();
  SetProp( P_NAME, "Tanthyon" );
  SetProp( P_ARTICLE, 0 );
  SetProp( P_RACE, "Dunkelelf" );
  SetProp( P_SHORT, "Tanthyon, der Haustierverkaeufer" );
  SetProp( P_LONG, "Vor Dir steht Tanthyon, der Verkaeufer im Tierladen der Unterwelt. "
                   "Seine langen, schneeweissen Haare traegt er zu einem Zopf geflochten und "
                   "seine blut roten Augen funkeln Dich giftig an. Es sieht so aus als sei mit "
                   "ihm nicht gut Kirschenessen." );

  SetProp( P_ALIGN, -400);

  create_default_darkelf(15,15,0);

  set_living_name("tanthyon");

  SetChats(1, ({
    name()+" blickt Dich missmutig an.\n",
    name()+" fragt: Wirds bald? Ich habe nicht den ganzen Tag Zeit!\n",
    BS(name()+" sagt: Wenn Ihr ein Haustier der Unterwelt wollt koennt ihr es ohnehin nur hier kaufen, also ziert Euch nicht so!\n"),
    name()+" fragt: Was wollt Ihr?\n",
    name()+" betreut die Haustiere in ihren Kaefigen.\n" }) );

  AddDetail ( "haare", "Lang, weiss wie Schnee und zu einem Zopf geflochten.");
  AddDetail ( "zopf", "Steht ihm sogar ganz gut.");
  AddDetail ( "augen", "Aus Tanthyons blutroten Augen funkelt pure Bosheit.");
  AddDetail ( "bosheit", "Sei einfach vorsichtig mit dem Mann!");

  AddInfo ( DEFAULT_INFO, "sagt: Stehlt mir nicht meine Zeit mit nutzlosen Fragen!" );
  AddInfo ( ({"haustier", "haustiere"}), "sagt: Ich bin der einzige der welche in der Unterwelt verkauft." );
  AddInfo ( "unterwelt", "Die meisten Wildtiere wuerden Euch zerreissen, nur wenige sind als Haustiere geeignet.", "sagt: " );
  AddInfo ( "tiere", "Je staerker das Tier, desto schwerer ist es zu zaehmen, darum sind auch die "
            "Prachtexemplare dieses Ladens beinahe unerschwinglich.", "sagt: " );
  AddInfo ( ({ "exemplare", "prachtexemplare" }), "Meine Riesenspinnen sind wirklich Lloth gefaellige Prachtexemplare, "
               "aber Ihr sehr mir nicht unbedingt so reich aus diese Wahl in erwaegung zu ziehen.", "meint: " );
  AddInfo ( "wahl", "Waehlt einfach das Tier, das am besten zu Euch passt.", "meint: " );
  AddInfo ( ({ "preis", "preise" }), "Speziell die maechtigen und boesen Tiere haben ihren Preis, und ich kann verstehen "
             "wenn Ihr nicht all das Geld auf einmal mitnehmen koennt. Dafuer gibt es hier im Laden Gutscheine.", "sagt: " );
  AddInfo ( ({ "gutschein", "gutscheine" }), "Mit Gutscheinen koennt Ihr Tiere kaufen, doch fuer Futter und Zubehoer nehme "
               "ich nur Muenzen.", "sagt: " );
  AddInfo ( "futter", "Wer sein Haustier fuettert, haelt es bei Laune, aber gebt ihm nicht zu viel auf einmal, sondern mehrere "
            "kleine Mahlzeiten.", "sagt: " );
  AddInfo ( "zubehoer", "meint: Ihr koennt alles was ihr braucht hier im Laden erwerben." );
  AddInfo ( "laden", "sagt: Ich bin der Verkaeufer in diesem Laden und nehme meine Arbeit sehr ernst." );
  AddInfo ( ({ "arbeit", "teil"}), "Ich verkaufe Haustiere und schaue auf ihr Wohlbefinden hier im Laden, sonst wuerde Lloth mich strafen.", "sagt: " );
  AddInfo ( "verkaeufer", "sagt: Das Verkaufen von Haustieren ist nur ein Teil meiner Arbeit." );
  AddInfo ( "laune", "Die Loyalitaet des Haustieres ist wichtig, wenn man es nicht eines Tages verlieren will.", "sagt: " );
  AddInfo ( "loyalitaet", "Wenn Ihr Euer Haustier nicht nett behandelt, wird es Euch eines Tages verlassen.", "meint: " );
  AddInfo ( "lloth", "Sprecht ihren Namen nicht achtlos aus, oder ihr Zorn wird Euch treffen!" );
  AddInfo ( "zorn", "Das wollt Ihr gar nicht wissen, glaubt mir!" );


  SetAttackChats(5, ({
    name()+" schreit: Lloth wird Euch strafen!\n",
    name()+" droht: Verschwindet, oder ich lasse die Riesenspinnen auf Euch los!\n",
    name()+" schreit: Hinfort mit Euch\n" }) );

   AddId ("tanthyon");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return;
  switch(gruppe)
  {
    case "fies":
      call_out("react", 0, "blickt Dich finster an.", "blickt "+TP->name(WEN)+" finster an." );
      break;
    case "aergerlich":
      call_out("react", 0, "sagt: Lasst mich mit Eurem Aerger in Ruhe, "+TPN+"!", 0);
      break;
    case "traurig":
      call_out("react", 0, "Geht zu den Sichelschrecken, dann ist es bald vorbei, "+TPN+"!", 0 );
      break;
    case "albern":
      call_out("react", 0, "schaut grimmig drein.", 0);
      break;
    case "neutral":
      call_out("react", 0, "ignoriert Dich voellig.", "ignoriert "+TP->name(WEN)+" voellig.");
      break;
    case "intim":
      call_out("react", 0, "lasst mich in Ruhe, "+TPN+"!", 0 );
      break;
    case "froh":
      call_out("react", 0, "schoen fuer Euch, "+TPN+".", 0 );
      break;
    case "aengstlich":
      call_out("react", 0, "ohne Mut kommt Ihr hier nicht weit, "+TPN+", also werdet Eure Angst gefaelligst los, Memme!", 0 );
      break;
    case "frech":
      call_out("react", 0, "grummelt Dich an.", "grummelt "+TP->name(WEN)+" an.");
      break;
    case "nett":
      call_out("react", 0, "was wollt Ihr von mir, "+TPN+"?", 0 );
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    if( !others ) others = victim;
    tell_object(TP, BS(Name(WER, 1) + " "+victim) );
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void GiveIntroduction ()
{
   write ( "Tanthyon gibt Dir noch ein kleines, schwarzes Pfeifchen und meint:\n"+
         "Seid nett zu Eurem neuen Gefaehrten, denn selbst das treuste Tier vertraegt nicht alles.\n"
         "Solltet Ihr Futter oder Zubehoer suchen, koennt ihr alles noetige im Laden kaufen.\n" );
   say ( "Tanthyon gibt "+this_player()->Name(WEM)+" noch ein kleines, schwarzes Pfeifchen und meint:\n"+
         "Seid nett zu Eurem neuen Gefaehrten, denn selbst das treuste Tier vertraegt nicht alles.\n"
         "Solltet Ihr Futter oder Zubehoer suchen, koennt ihr alles noetige im Laden kaufen.\n", ({this_player()}) );
}