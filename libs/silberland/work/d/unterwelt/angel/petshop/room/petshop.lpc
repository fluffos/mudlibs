/********************************************************************
 * Raum: Tierhandlung in der Unterwelt                              *
 * Datei: /d/unterwelt/angel/petshop/room/petshop.c                 *
 * Letzte Ueberarbeitung: 22.12.2002                                *
 ********************************************************************/

inherit "/p/service/angel/haustiere/std_petshop";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"
#include <laden.h>


string query_pet_sound ()
{
   return ({ "Das Rasseln einer Riesenmantis.", "Das Klicken einer Spinne.", "Das Flattern einer Fledermaus.",
             "Das Schlaengeln eines Wurmes.", "Das Knacken einer Riesenspinne.", "Das Kreischen einer Riesenfledermaus." })[random(6)]+"\n";
}

void create()
{
  ::create();

  // Laden-Konstanten:
  SetProp(P_SHOPKEEPER_NAME, "Tanthyon" );
  SetProp(P_SHOPKEEPER_GENDER, MALE );
  catch(call_other(ROOM "pet_store", "???"));
  SetStorageRoom(ROOM "pet_store");

  SetProp(P_LIGHT, 0 );
  SetProp(P_INT_SHORT, "Die Tierhandlung in der Unterwelt" );
  SetProp(P_INT_LONG,
    "Du befindest Dich in der Tierhandlung der Unterwelt. Es handelt sich um eine Art Huette, welche "
    "scheinbar vollstaendig aus Stein errichtet wurde. Selbst die Einrichtung, also die Regale und der "
    "Tisch scheinen aus Stein gehauen zu sein. Hinter dem Tisch kannst Du einen kleinen Schemel - "
    "ebenfalls aus Stein - ausmachen. Auf dem Tisch liegt eine steinerne Tafel.\n"
  );
  SetProp ( P_PET_KONFIG_TOOL, "/p/service/angel/haustiere/obj/pfeife");

  AddPet( "giftspinne", "/p/service/angel/haustiere/npc/spinne" );
  AddPet( "riesenspinne", "/p/service/angel/haustiere/npc/rspinne" );
  AddPet( "riesenmantis", "/p/service/angel/haustiere/npc/rmantis" );
  AddPet( "wurm", "/p/service/angel/haustiere/npc/wurm" );
  AddPet( "riesenfledermaus", "/p/service/angel/haustiere/npc/rfledermaus" );
  AddPet( "fledermaus", "/p/service/angel/haustiere/npc/fledermaus" );

  AddReadDetail ( ({ "tafel", "preistafel"}), GetPriceList() );

  AddDetail ( "tafel", "Die Tafel besteht aus Stein, auf ihr sind scheinbar die Preise der Haustiere notiert." );
  AddDetail ( "stein", "Sieht aehnlich aus wie der Stein in den Hoehlen." );
  AddDetail ( "boden", "Der Boden besteht aus massivem Stein." );
  AddDetail ( "decke", "Die Decke besteht, wie auch Boden und Waende, aus massivem Stein." );
  AddDetail ( ({ "waende", "wand" }), "Hier scheint beinahe alles aus Stein zu sein, auch die Waende." );
  AddDetail ( "unterwelt", "Sag nicht es sei Dir nicht aufgefallen dass Du Dich in der Unterwelt befindest." );
  AddDetail ( "fenster", "Fenster sind Dir keine aufgefallen, wozu auch? Licht fiele ohnehin keines herein." );
  AddDetail ( "licht", "Licht ist hier unten generell unerwuenscht." );
  AddDetail ( "einrichtung", "Die Einrichtung hier ist relativ spaerlich: Ausser einem Tisch und einem "
              "Schemel stehen nur einige wenige Regale an den Waenden." );
  AddDetail ( ({ "regal", "regale" }), "Diese Regale dienen wohl der Aufbewahrung von Tierfutter und Zubehoer." );
  AddDetail ( ({ "tierfutter", "futter", "zubehoer" }), "Vielleicht moechtest Du ja davon etwas kaufen?" );
  AddDetail ( "aufbewahrung", "Diese Regale scheinen fuer die Aufbewahrung von Futter und Zubehoer gut geeignet." );
  AddDetail ( ({ "tierhandlung", "handlung", "laden" }), "Sieh Dich doch einfach weiter um." );
  AddDetail ( "tanthyon", "Tanthyon scheint nicht im Laden zu sein. Moeglicherweise war er ZU unfreundlich zu einer Kundschaft ..." );
  AddDetail ( "kundschaft", "Nun jemand der etwas kaufen moechte, so wie Du." );
  AddDetail ( "verkaeufer", "Der Verkaeufer hier heisst Tanthyon. Er kuemmert sich um die Haustiere und wuerde "
              "Dir sicher auch eines verkaufen solltest Du genuegend Geld besitzen." );
  AddDetail ( "schemel", "Auf dem Schemel hat sich schon Staub angesammelt, scheinbar benutzt ihn Tanthyon nie." );
  AddDetail ( "staub", "Nur der Schemel ist staubig, sonst ist alles reinlich gehalten." );
  AddDetail ( ({"tiere", "haustiere"}), "Da liest Du am besten auf der steinernen Tafel nach." );
  AddDetail ( "tisch", "Wie alles hier ist auch dieser Tisch aus massivem Stein, muss viel Arbeit gewesen "
              "sein, dafuer haelt er fuer alle Ewigkeit." );
  AddDetail ( ({ "preis", "preise" }), "Die Preise kannst Du der steinernen Tafel entnehmen, welche auf dem Tisch liegt." );
  AddDetail ( "tierkaefige", "An den Waenden stehen Kaefige in den verschiedensten Groessen." );
  AddDetail ( ({ "kaefige", "kaefig" }), "In diesen Kaefigen warten unzaehlige Tiere darauf einen neuen Besitzer zu finden." );
  AddDetail ( "tiere", "Eine Uebersicht aller waehlbaren Tiere findest Du auf der steinernen Tafel." );
  AddDetail ( "uebersicht", "Lies doch einfach die Tafel!" );
  AddDetail ( "besitzer", "Moechtest Du nicht auch ein Haustier haben?" );
  AddDetail ( ({ "haustier", "tier", "tierchen" }), "Verdiene etwas Geld, dann kannst Du Dir auch eines leisten." );
  AddDetail ( "kaefig", "Die Tiere in den Kaefigen sehen relativ ruhig aus, scheinbar macht Tanthyon seinen Job gut." );
  AddDetail ( "job", "Tanthyon bringt seinen Schutzbefohlenen auf alle Faelle mehr Achtung entgegen als Dir." );
  AddDetail ( "schutzbefohlenen", "Damit sind die Haustiere gemeint.");
  AddDetail ( ({ "faelle", "achtung" }), "Nun es scheint so als moege Tanthyon keine Leute." );
  AddDetail ( "leute", "Vielleicht sind ihm die Tiere einfach lieber." );
  AddDetail ( "geld", "Bei diesen Preisen ist es fraglich ob Du Dir jemals ein Haustier wirst leisten koennen!" );
  AddDetail ( "menge", "Kommt darauf an welches Tierchen Du moechtest und wieviel Geld Du locker machen kannst." );
  AddDetail ( ({ "groessen", "groesse" }), "Jedes Tier hat einen Kaefig mit angemessener Groesse." );
  AddDetail ( "arbeit", "Dies alles auf massivem Stein herauszuhauen war sicherlich eine moerderische Arbeit. Wer das wohl gemacht hat, vielleicht Sklaven?" );
  AddDetail ( ({ "hoehlen", "hoehle" }), "Der Laden befindet sich in einer Hoehle mitten in der Unterwelt." );
  AddDetail ( ({ "art", "huette" }), "Nun es aehnelt einer Huette sehr, nur dass diese eben aus massivem Stein besteht." );
  AddDetail ( "ewigkeit", "Verfallen wird diese Huette sicher nicht so schnell." );
  AddDetail ( ({"sklaven"}), "Nur Sklaven koennen eine solche schwere Arbeit verrichten. So etwas nennt man dann ...");
  AddDetail ( ({ "sklavenarbeit" }), "Das waere gut moeglich und wuerde auch zu den Sitten hier unten passen." );
  AddDetail ( "sitten", "Die Sitten hier sind rauh und alles andere als einladend." );

  AddRoomMessage ( ({
    "Iiiiiiiiiiiii!\n",
    "*knack* *knack*!\n",
    "*rassel* *rassel*!\n",
    "Shhwshhhwshhw!\n",
    "*flatter* *flatter*!\n" }), 15 );

  AddSmell ( DEFAULT_SMELL, "Hier riecht es nach den verschiedensten Tieren." );
  AddSmell ( "tiere", "Eingesperrte Tiere riechen nicht besonders angenehm." );

  AddSound ( DEFAULT_SOUND, "Du hoerst die verschiedensten Geraeusche." );
  AddSound ( ({ "geraeusche", "tiere", "tiergeraeusche" }), #'query_pet_sound );

  AddItem ( NPC "tanthyon", REFRESH_DESTRUCT );

  AddExit ("raus", ([ EX_DEST : PETSHOP_CENTRAL,
                      EX_MSG  : "hinaus aus dem Laden" ]) );

}
