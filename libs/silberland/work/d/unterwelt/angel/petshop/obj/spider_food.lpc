/********************************************************************
 * ITEM: Spinnenfutter                                              *
 * Datei: /d/dschungel/angel/petshop/obj/cat_food.c                 *
 * Letzte Ueberarbeitung: 23.12.2002                                *
 ********************************************************************/

inherit "/std/thing.lpc";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create ()
{
  ::create();
  SetProp( P_SHORT, "Spinnenfutter" );
  SetProp( P_NAME, "Spinnenfutter" );
  SetProp( P_LONG, "Dieses Tierfutter scheint ein Mix aus verschiedensten Larvensorten zu sein."
                   "Sie sind allesamt getrocknet und zu einem unfoermigen Klumpen gepresst." );

  SetProp( P_VALUE, 20 );
  SetProp( P_WEIGHT, 100 );

  AddDetail ( "tierfutter", "Offenbar schmeckt Spinnen so etwas.");
  AddDetail ( ({ "mix", "larven", "sorten", "larvensorten" }), BS("Da alles trocken und verklumpt ist "
                 "kannst Du nicht feststellen welche Larven verwendet wurden. Frisches Futter "
                 "schmeckt einer Spinne sicher besser."));
  AddDetail ( "klumpen", "Sehr unfoermig, dieser Klumpen." );

  SetProp(P_SMELL, "Das Spinnenfutter riecht etwas muffig.\n");

  AddId( ({"spinnenfutter", "futter"}) );
}