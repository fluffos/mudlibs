/********************************************************************
 * ITEM: Fledermausfutter                                           *
 * Datei: /d/dschungel/angel/petshop/obj/bird_food.c                *
 * Letzte Ueberarbeitung: 23.12.2002                                *
 ********************************************************************/

inherit "/std/thing.lpc";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create ()
{
  ::create();
  SetProp( P_SHORT, "Fledermausfutter" );
  SetProp( P_NAME, "Fledermausfutter" );
  SetProp( P_LONG, "Dieses Tierfutter scheint ein Mix aus verschiedensten Fliegen- und Larvensorten zu sein."
                   "Sie sind allesamt getrocknet und zu einem unfoermigen Klumpen gepresst." );

  SetProp( P_VALUE, 20 );
  SetProp( P_WEIGHT, 100 );

  AddDetail ( "tierfutter", "Offenbar schmeckt Fledermaeusen so etwas.");
  AddDetail ( ({ "mix", "fliegen", "larven", "sorten", "larvensorten", "fliegensorten" }), BS("Da alles trocken und verklumpt ist "
                 "kannst Du nicht feststellen welche Fliegen und Larven verwendet wurden. Frisches Futter schmeckt einer "
                 "Fledermaus sicher besser."));
  AddDetail ( "klumpen", "Sehr unfoermig, dieser Klumpen." );

  SetProp(P_SMELL, "Das Fledermausfutter riecht etwas muffig.\n");

  AddId( ({"fledermausfutter", "futter"}) );
}