/********************************************************************
 * ITEM: Wurmfutter                                                 *
 * Datei: /d/dschungel/angel/petshop/obj/snake_food.c               *
 * Letzte Ueberarbeitung: 23.12.2002                                *
 ********************************************************************/

inherit "/std/thing.lpc";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create ()
{
  ::create();
  SetProp( P_SHORT, "Wurmfutter" );
  SetProp( P_NAME, "Wurmfutter" );

  SetProp( P_LONG, "Puah! Dieses Futter ist wohl das grausigste was Du jemand an Futtermittel gesehen hast. "
                   "Jetzt leider undefinierbares organisches Material ist von Schimmel und Faeulnis durchzogen und "
                   "scheint sich bald aufzuloesen." );

  SetProp( P_VALUE, 10 );
  SetProp( P_WEIGHT, 100 );

  AddDetail ( ({ "material" }), "Was das war kannst Du beim besten Willen nicht mehr feststellen." );
  AddDetail ( ({ "schimmel", "faeulnis" }), "Anscheinend lieben Wuermer solches Zeug, Dich kann man jedenfalls damit verjagen." );

  SetProp(P_SMELL, BS("Iiiihgit!!! Das ist ja gesundheitsschaedigend wie das riecht!"));

  AddId( ({"wurmfutter", "futter"}) );
}