 ********************************************************************/

inherit "/std/thing.lpc";

#include "../def.h"
#include "/p/service/angel/haustiere/std_pet.h"

void create ()
{
  ::create();
  SetProp( P_SHORT, "Mantisfutter" );
  SetProp( P_NAME, "Mantisfutter" );

  SetProp( P_LONG, "Dieses Futter besteht aus langen, getrockneten Fleischstreifen, die sich zaeh wie Leder anfuehlen. "
                   "Du fragst Dich ob das wohl einer Mantis schmecken kann." );
  SetProp( P_VALUE, 50 );
  SetProp( P_WEIGHT, 100 );

  AddDetail ( ({ "fleisch", "fleischstreifen", "streifen" }), "Das Fleisch wurde getrocknet und in duenne Streifen geschnitten die ca. ellenlang sind.");
  AddDetail ( ({"mantis", "beduerfnis", "beduerfnisse"}), "Frisches Futter entspricht wohl aeher den Beduerfnissen der Mantis, aber zur Not tut es dieses Futter sicher auch." );
  AddDetail ( "not", "Wenn Du nichts anderes hast, muss es wohl reichen." );

  SetProp(P_SMELL, "Das Mantisfutter riecht nicht angenehm.\n");

  AddId( ({"mantisfutter", "futter"}) );
}