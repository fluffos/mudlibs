
inherit "std/virtual/v_compiler";

#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

#include "../def.h"

#define P_VALID_NAME "valid_name"


create()
{
  ::create();
  SetProp(P_COMPILER_PATH, DUNGROOM("") );
  SetProp(P_STD_OBJECT, DUNGROOM("room"));
  SetProp(P_VALID_NAME, ({"room"}) );
}


string Validate(string file)
{
  string path, who, name, foo;
  int x,y,z;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%d:%d:%d.lpc", name, x, y, z) == 4) &&
      (member(QueryProp(P_VALID_NAME), name) != -1))
  {
    SetProp(P_STD_OBJECT, DUNGROOM(name));
    return file;
  }
}


int CustomizeObject()
{
  string name,foo,bar;
  string *helper;
  mapping *exits;
  int x,y,z;
  int i;
  
  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%d:%d:%d",foo, x, y, z)!=4)
    return 0;


  walk_mapping(DUNGMASTER->GiveExits(x,y,z), "AddExit", previous_object());

  if (DUNGMASTER->NeedsGuard(x,y,z))
    PO->AddItem( DUNGNPC("guard"), REFRESH_NONE );

  if (DUNGMASTER->QueryField(x,y,z)=="D")
    PO->AddAdvance(z);
  if (DUNGMASTER->QueryField(x,y,z)=="U")
    {
      PO->AddRegress(z);
      if (z>=20 && z%5==0) PO->AddEscapePoint(z);
      if (z==1) PO->AddItem(DUNGOBJ("iwoleiche"), REFRESH_REMOVE);
    }


  PO->SetProp(P_INT_LONG, DUNGMASTER->QueryLong(x,y,z));
  PO->SetProp(P_INT_SHORT, DUNGMASTER->QueryShort(x,y,z));
  PO->SetProp(P_DUNGLEVEL, z);

  return 1;
  
}

