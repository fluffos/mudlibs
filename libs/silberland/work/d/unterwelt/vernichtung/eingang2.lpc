
#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

#include "def.h"

#pragma strong types;

inherit "std/room";

void create()
{
  if(IS_CLONE(TO)) return;
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_INT_SHORT, "In einem Tempel der Schaendung");
  SetProp (P_INT_LONG, "Vorsichtig tastest Du Dich durch die Halle vor. "
    "Nicht, dass es etwas zu sehen gaebe aber dennoch fuehlst Du, dass "
    "hier irgendetwas Abstossendes vorgegangen sein muss. Is ist sicher "
    "besser sich nicht all zu lange hier aufzhalten - vielleicht kehren "
    "ja jene die das hier geschaffen haben zurueck. @@lowlevel@@");
  
  AddDetail( ({ "abstossendes", "dinge", "sinn" }), "Dier wuerden so "
    "schreckliche Dinge in den Sinn kommen, dass Du es unterlaesst Sie Dir "
    "vorzustellen.");
  AddDetail( ({ "halle", "hoehle" }), "Du befindest Dich in in einer "
    "tempelartigen Halle - einer in den Fels geschlagenen Hoehle.");
  AddDetail( ({ "wand", "waende" }), "Die Waende bestehen aus "
    "schroffem Fels.");
  AddDetail( ({ "fels", "felsen" }), "Kalt, hart. Wie Iwo und Angrox *<8-)");
  AddDetail( ({ "decke", "staub" }), "Von der Decke rieselt der Staub der "
    "Zeiten und bedeckt den Fussboden mit einer duennen Staubschicht.");
  AddDetail( ({ "staubschicht", "schicht" }), "Als waer lange Zeit niemand "
    "hier gewesen.");
  AddDetail( ({ "fussboden", "boden" }), "Eine duenne Staubschicht bedeckt den "
    "Boden.");

  AddExit("sueden", DUNGROOM("../eingang"));
  AddExit("norden", DUNGROOM("../eingang3"));
}

string lowlevel()
{
  if (TP->QueryProp(P_LEVEL) < 30) return "\nDU SOLLTEST AUF DER STELLE UMKEHREN.";
  return "";
}