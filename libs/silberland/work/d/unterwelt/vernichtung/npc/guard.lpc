
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include <defines.h>
#include <moredef.h>
#include <class.h>
#include "../def.h"

void SetNpcType();
void SetNpcLevel(int lvl);

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Npc");
  SetProp(P_LONG, "hat noch keine long.");
  SetProp(P_NAME, "Npc");
  SetProp(P_GENDER, MALE);
  
  AddClass( ({ CL_UNDEAD }) );
  
  AddId( ({"dungnpc", "\ndungguard"}) );

  create_default_npc(1);
  
  SetProp(P_NOCORPSE, 1);
  
  SetProp(P_DIE_MSG, " bricht zusammen und zerfaellt zu Staub.\n");

  AddInfo(DEFAULT_INFO, "beachtet Deine Frage nicht.\n");

  SetProp(P_MURDER_MSG, "Frueher oder spaeter kriegen wir euch alle!");

  SetProp(P_XP, 0);

  SetNpcType();
  call_out("SetNpcLvl", 0); 
  SUID;
}


void SetNpcType()
{
  int i;
  string *members;
  
  i = random(sizeof(DUNGNPCTYPES));
  
  members = m_indices(DUNGNPCTYPES);
  
  SetProp(P_NAME, CAP(members[i]));
  SetProp(P_SHORT, sprintf("Ein %s", CAP(members[i])));
  SetProp(P_LONG, DUNGNPCTYPES[members[i],0]);
  AddId( ({ members[i] }) );
  
}


void SetNpcLvl ()
{
  int lvl;

  string npc, adj;

  if (!lvl) lvl = MENV->QueryProp(P_DUNGLEVEL)+DUNGNPCMINLVL;

  MENV->SetProp(P_DUNG_NO_UNLOAD, 1);

  adj=({"wahnsinnig", "verrueckt", "irr", "verwirrt"})[random(4)];
  create_default_npc(lvl);
  
  SetProp(P_XP, lvl*1000);

  SetProp(P_HANDS, ({" mit seinen Klauen",lvl*10,DT_BLUDGEON}));
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 190+random(20)+random(lvl));
  SetProp(P_ALIGN, 0-random(500)+random(lvl));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.2, DT_SOUND:  0.0, DT_LIGHT:  0.2,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.1, DT_UNHOLY:    -0.2, DT_MAGIC:  -0.1 ]) );

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "wandert zaehnefletschend weiter");

  SetProp(P_AGGRESSIVE, (float)(lvl/100));
  SetProp(P_SPELLRATE,10+random(lvl/2));
  SetProp(P_TRANSPARENT, 0);
  npc=lower_case(QueryProp(P_NAME)); 
  switch(npc) 
    {
       case "ghoul": 
         AddClass(CL_UNDEAD);
         SetProp(P_GENDER, MALE);  
         SetProp(P_RESISTANCE_STRENGTHS, 
            QueryProp(P_RESISTANCE_STRENGTHS)+([DT_FIRE:0.1]));
         SetProp(P_ALIGN, -900);
         SetProp(P_NOCORPSE, 0);
         break;
       case "daemon": 
         AddClass(CL_DEMON);             
         SetProp(P_BODY,(int)(QueryProp(P_BODY)*1.5));
         SetProp(P_GENDER, MALE);  
         SetProp(P_ALIGN, -800);
         break;
       case "daemonenjaeger":
         SetProp(P_NAME_ADJ, adj);
         AddId( ({"jaeger"}));
         SetProp(P_SHORT, "Ein "+adj+"er Daemonenjaeger");
         SetProp(P_ALIGN, random(1000));
         SetProp(P_GENDER, MALE);  
         SetProp(P_RESISTANCE_STRENGTHS, 
            QueryProp(P_RESISTANCE_STRENGTHS)+([DT_UNHOLY:0.1, DT_HOLY:-0.2]));
         SetProp(P_NOCORPSE, 0);
         SetProp(P_MURDER_MSG, "Uah! %s ich war auf Deiner Seite!");
         break;
       case "geisteraustreiber":
         SetProp(P_NAME_ADJ, adj);
         AddId( ({"austreiber"}));
         SetProp(P_SHORT, "Ein "+adj+"er Geisteraustreiber");
         SetProp(P_ALIGN, random(1000));
         SetProp(P_GENDER, MALE);  
         SetProp(P_RESISTANCE_STRENGTHS, 
            QueryProp(P_RESISTANCE_STRENGTHS)+([DT_UNHOLY:0.1, DT_HOLY:-0.2]));
         SetProp(P_MURDER_MSG, "Danke %s das Du mich von dem Wahnsinn befreit hast!");
         SetProp(P_NOCORPSE, 0);
         break;
       case "knochengolem":
         SetProp(P_HANDS, ({" mit seinen Knochenklauen",lvl*15,DT_RIP}));
         SetProp(P_GENDER, MALE);
         SetProp(P_NOCORPSE, 0);
         SetProp(P_MURDER_MSG, "Alles nur Glueck, %s!"); 
         SetProp(P_ALIGN, random(1000)*-1); 
         AddId("golem");
         break;  
       case "seele":
         SetProp(P_HANDS, ({" mit psionischer Kraft", lvl*7, DT_MIND}));
         SetProp(P_GENDER, FEMALE);  
         SetProp(P_NAME_ADJ, "verdammt");
         SetProp(P_SHORT, "Eine verdammte Seele");
         SetProp(P_ALIGN, -1000+random(2000)+1);
         SetProp(P_RESISTANCE_STRENGTHS, 
            QueryProp(P_RESISTANCE_STRENGTHS)+([DT_UNHOLY:0.0, DT_HOLY:-0.0,
                                                DT_MAGIC:-0.1, DT_MIND:-0.1]));
         break;
         
    }

  AddSpell(4,(int)(lvl*8),
    TO->Name(WER) + " bruellt Dich markerschuetternd an.\n",
    TO->Name(WER) + " bruellt @WEN markerschuetternt an.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

  AddSpell(1+random((int)(lvl/10)),(int)(lvl*10),
    TO->Name(WER) + " schlaegt nach Dir mit voller Wucht.\n",
    TO->Name(WER) + " schlaegt nach @WEM mit voller Wucht.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1+random((int)(lvl/10)),(int)(lvl*10),
    TO->Name(WER) + " rammt Dir seine Klauen in den Leib.\n",
    TO->Name(WER) + " rammt @WEN seine Klauen in den Leib.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(5, ({
    TO->Name(WER) + " kreischt furchterregend.\n",
    TO->Name(WER) + " schlaegt wild um sich.\n",
    TO->Name(WER) + " wirft Dir einen erschreckenden Blick zu.\n"}) );

}

varargs void die(int poisd)
{
  DUNGTOPMASTER->NotifyNpcDeath(TP);
  if (present("\ndungcrystal", TO))
    tell_room(MENV, BS("Ein Kristall faellt zu Boden."));
  ::die(poisd);

  return;
}
