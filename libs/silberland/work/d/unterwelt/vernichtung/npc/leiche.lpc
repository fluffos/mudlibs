
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include <defines.h>
#include <moredef.h>
#include <class.h>
#include "../def.h"

string listfunc();
string runefunc();

void create() {

  if (!is_clone(TO)) return;
  ::create();

  seteuid(getuid(TO));

  SetProp(P_SHORT, "Die Leiche eines Daemonenjaegers");
  SetProp(P_LONG, "Als Du die zerfetzte Leiche naeher betrachtest "
    "siehst Du dass der Daemonenjaeger noch gar nicht ganz tot ist.");
  SetProp(P_NAME, "Leiche");
  SetProp(P_GENDER, FEMALE);
  
  AddId( ({"leiche", "jaeger", "daemonenjaeger"}) );

  create_default_npc(1);
  
  SetProp(P_DIE_MSG, " bricht zusammen und zerfaellt zu Staub.\n");

  AddInfo(DEFAULT_INFO, "roechelt mitleiderregend.\n");

  SetProp(P_MURDER_MSG, "Frueher oder spaeter kriegen wir euch alle!");

  SetProp(P_XP, 0);

  SetProp(P_NOMAGIC,100);

  SetProp(P_NOATTACK, "ist schon fast tot.\n");

  AddInfo( ({ "liste" }), #'listfunc);

  AddInfo( ({ "rune" }), #'runefunc);

  AddInfo( ({ "angrox", "iwo" }),
    "Ja, Angrox und Iwo sind mir an diesem grausamen Ort begegnet. "
    "Ich fuerchte jedoch dass sie es nicht geschafft haben.", "sagt: ");
  AddInfo( ({ "ort", "pandaemoneum" }), "Die Hoehlen und Gaenge hier unter der Erde "
    "nennen sich das Pandaemoneum. Niemand ausser mir ist von dort "
    "je lebend zurueckgekehrt.", "sagt: ");
  AddInfo( ({ "hoehlen", "gaenge" }), "Gottlose Gestalten treiben sich "
    "dort unten herum.", "sagt: ");
  AddInfo( ({ "gestalten" }), "Totes Fleisch - mit Hilfe von Maechten zurueck "
    "auf diese Welt geholt deren Praesenz alleine schon das Leben verraet.",
    "sagt: ");
  AddInfo( ({ "maechte" }), "Werauchimmer diese hier an dem Ort "
    "der Schaendung angerufen hat - die Goetter moegen ihre Seelen und "
    "ihr Gedankengut fuer immer ausloeschen.", "sagt: ");
  SetProp(P_NOCORPSE,1);
  SetProp(P_MAX_HP,10);
  SetProp(P_HP, 0);
  SetProp(P_HP_DELAY, 100000000); 
  SetProp(P_FRIEND,1);

  SUID;
}

heart_beat()
{
  ::heart_beat();
  SetProp(P_HP,0);
}

string listfunc()
{
  tell_object(TP, "Der halbtote Daemonenjaeger zeigt Dir eine Liste.\n");

  DUNGTOPMASTER->ReadToplist(TP);
  
  return "stoehnt vor Schmerz.";
}


string runefunc()
{
  object rune;
  int lvl;
  int i;
  int given;

  given = 0;

  lvl = DUNGTOPMASTER->QueryPlayerLevel(TP);

  if (lvl < 20) return "stoehnt: Tut mir leid, fuer Dich habe ich keine Rune.";

  // Fuer jeden Escape-Point eine Rune geben
  for (i=20; i <= lvl; i+=5)
    {
      if (present(sprintf("\ndungrunelvl%d",i), TP)) continue;

      given++;

      rune = clone_object(DUNGOBJ("rune"));

      rune->SetLevel(i);

      rune->move(TP, M_GET + M_NOCHECK);

      tell_room(ENV(ME), BS(sprintf("%s gibt %s %s.", TO->Name(WER), 
        TP->name(WEM), rune->name(WER))), ({ TP }));
      
      tell_object(TP, BS(sprintf("%s gibt Dir %s.", TO->Name(WER), 
        rune->name(WER))));
 
    }

  if (!given)
    return "stoehnt: Du hast bereits alle!";
  else
    return "stoehnt: Hier bitte, viel Glueck!";
   
}

