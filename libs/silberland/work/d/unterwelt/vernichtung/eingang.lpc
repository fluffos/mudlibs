
#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include <combat.h>
#include <wizlevels.h>

#include "def.h"

#pragma strong types

inherit "std/room";

void create()
{
  if(IS_CLONE(TO)) return;
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_INT_SHORT, "In einem Tempel der Schaendung");
  SetProp (P_INT_LONG, "Vor Dir breitet sich ein tempelaehnliches "
    "Gewoelbe aus. Maechtige Saeulen die mehr den Eindruck erwecken "
    "zierde zu sein als Tragwerk fuer die Decke flankieren die "
    "Halle welche sich weiter nach Norden erstreckt. Weiter entfernt "
    "kannst Du einen Altar erblicken.");

  SetProp(P_KILL_NAME, "Ein Genickbruch");

  AddDetail( ({ "gewoelbe", "halle" }), "Eine gigantische in den Fels geschlagene "
    "Hoehle.");
  AddDetail( ({ "fels", "felsen" }), "Jener aus dem alles runderum besteht. "
    "Verdammt hart wahrscheinlich. Du solltest besser nicht mit dem Kopf "
    "dagegen laufen.");
  AddDetail( ({ "decke" }), "Die Decke besteht aus behauenem schroffen Fels.");
  AddDetail( ({ "tragwerk", "saeulen" }), "Die Saeulen sind wohl nur zur "
    "Zierde da. Wohl kaum, dass das massive Gestein eine Stuetze benoetigt.");
  AddDetail( ({ "stuetze", "zierde" }), "Die Saeulen zieren den Tempel als "
    "waeren es Stuetzen.");
  AddDetail( ({ "tempel" }), "Es sieht eher aus als wuerden hier die Goetter "
    "geschaendet anstelle geehrt.");
  AddDetail( ({ "altar" }), "Der Altar steht weiter noerdlich.");
  AddDetail( ({ "wand","waende" }), "Der Anblick des behauenen starken Fels begeistert "
    "Dich. Voellig hingerissen streichelst Du ihn.");
  AddDetail( ({ "eindruck" }), "Du drueckst mit dem Daumen Deinen Kopf ein. "
    "Jetzt hast Du einen Eindruck den Du sehen kannst.");
  AddDetail( ({ "daumen" }), "Der steckt in Deinem Kopf. Jetzt tuts aber.");
  AddDetail( ({ "boden" }), "Der Boden ist etwas staubig. Es war wohl "
    "laengere Zeit niemand hier.");


  AddCmd( ({"laufe", "lauf"}), "headcrash");

  AddExit("norden", DUNGROOM("../eingang2"));
  AddSpecialExit("raus", "remove_dun_items");
}


int headcrash(string str)
{
  notify_fail("Womit meochtest Du wogegen laufen?\n");
  if (str != "mit kopf gegen wand" && str != "mit kopf gegen fels") return 0;

  tell_object(TP, BS("Du laeufst mit voller Wucht mit dem Kopf gegen den Fels."));
  tell_room(ME, BS(TP->Name(WER) + " laueft mit voller Wucht mit dem Kopf "
    "gegen die Wand."), ({ TP }));
  tell_object(TP, "Du brichst Dir das Genick.\n");
  TP->AddHp(-1000);
  TP->SetProp(P_GHOST, 1);
  TP->move("/room/death/death_room", M_SILENT + M_NOCHECK);
  return 1;
}

int remove_dun_items() {
  object *inv;
  int i;

  TP->move("/d/unterwelt/basics/central/room/00+01-09", M_GO);
  if(IS_WIZARD(TP)) return 1;
  inv=filter_array(all_inventory(TP), "id_check");
  if(!sizeof(inv)) return 1;
  for(i=sizeof(inv)-1;i>=0;i--)
    inv[i]->remove();
  tell_object(TP, BS("Ein paar Deiner Besitztuemer loesen sich auf!"));
  TP->move("/d/unterwelt/basics/central/room/00+01-09", M_GO);
  return 1;
}

nosave int id_check(object ob) {
  if(ob->id("\ndungnoleave")) return 1;
  return 0;
}


void init()
{
  ::init();
  call_other(DUNGMASTER, "startup");
}

