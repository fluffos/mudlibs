
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>

#include "../def.h"

create()
{
  ::create();
  SetProp (P_SHORT, "Ein Kristall");
  SetProp (P_LONG, "Eine merkwuerdige Aura umgibt den Kristall. Du "
             "fuehlst dass es etwas damit auf sich hat. Tief im Inneren "
             "scheint es als wuerde etwas funkeln.");
  SetProp (P_NAME, "Kristall");
  SetProp (P_GENDER, MALE);
  AddId (({"kristall", "\ndungcrystal", "\dungnoleave"}));
  SetProp (P_WEIGHT, 5);
  SetProp (P_VALUE, 200);
  SetProp (P_MATERIAL, MAT_CRYSTAL);
  SetProp (P_INFO, BS("Er scheint wohl magische Kraefte zu besitzen."));

  AddDetail("funkeln", "Vielleicht spielen Dir auch nur Deine Augen einen "
            "Streich");
  AddCmd( ({"fuege", "fueg", "setze", "setz"}), "build_crystal");
}

nosave int build_crystal(string str) {
  object *crystals, *good_crystals;
  string col, *colors;
  int i,lvl, cry_lvl;
  colors=({}); 
  good_crystals=({});
  notify_fail("Was moechtest Du zusammensetzen?\n");
  if(str!="kristall zusammen" && str!="kristalle zusammen") return 0;
  crystals=filter_array(deep_inventory(TP), "crystal_check");
  cry_lvl=crystals[i]->QueryProp(P_DUNGLEVEL);
  for(i=sizeof(crystals)-1;i>=0;i--) {
    col=crystals[i]->QueryProp(P_CRYSTAL_COLOR);
    lvl=crystals[i]->QueryProp(P_DUNGLEVEL);
    if(member(colors,col)==-1 && cry_lvl==lvl) {
      colors+=({col});
      good_crystals+=({crystals[i]});
    }
  }
  if(sizeof(colors)!=8) {
    write(BS("Du bastelst an den Kristallen herum, aber irgendwie scheint "
          "es nicht zusammenzupassen."));
    return 0;
  }
  call_out("glow", 0, good_crystals);  
  return 1;
}

nosave int crystal_check(object ob) {
  if(ob->id("\ndungcrystal")) return 1;
  return 0;
}


void SetColor(int level, string color)
{
  SetProp(P_SHORT, sprintf("Ein %ser Kristall", color));
  SetProp (P_INFO, "Er scheint wohl magische Kraefte zu besitzen.\n"
                   "Er schimmert " + color + ".");
  SetProp(P_CRYSTAL_COLOR, color);
  SetProp(P_DUNGLEVEL, level);
}


void init()
{
  object *crystals;
  object ob_inv;
  string *colors;

  ::init();
  
  if (MENV && interactive(MENV)) return;
 /* 
  crystals = ({ TO });
  colors   = ({ QueryProp(P_CRYSTAL_COLOR) }); 
  
  for (ob_inv=first_inventory(MENV);ob_inv;ob_inv=next_inventory(MENV))
    {
      if (!ob_inv->id("\ndungcrystal")) continue;
      if (member(crystals, ob_inv)!=-1) continue;
      if (member(colors, ob_inv->QueryProp(P_CRYSTAL_COLOR))!=-1) continue;
      colors += ({ ob_inv->QueryProp(P_CRYSTAL_COLOR) });
      crystals += ({ ob_inv });
      ob_inv->SetProp(P_NOGET, "faellt Dir aus der Hand.\n");
    }
    
  if (sizeof(crystals)==8) call_out("glow", 0, crystals);
*/
}


void glow(object *crystals)
{
  int i;
  object ob; 
  tell_object(MENV, BS("Ploetzlich beginnen die Kristalle zu leuchten."));
  tell_object(MENV, BS("Die Kristalle formen sich zu einem geometrischen Koerper."));
  ob=clone_object(DUNGOBJ("octahedron"));
  ob->SetProp(P_DUNGLEVEL, QueryProp(P_DUNGLEVEL));  
  ob->move(MENV, M_NOCHECK);
  for (i=0;i<sizeof(crystals);i++)
    crystals[i]->remove();
}
