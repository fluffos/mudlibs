
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include <defines.h>
#include <moredef.h>
#include <class.h>
#include "../def.h"


void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Die Leiche Iwos");
  SetProp(P_LONG, "Du siehst die sterblichen Ueberreste Iwos.");
  SetProp(P_NAME, "Leiche");
  SetProp(P_GENDER, FEMALE);
  
  AddId( ({"leiche", "iwo"}) );

  SetProp(P_NOGET, "Du wagst es nicht den toten Koerper zu entweihen.");
  
  SUID;
}


string listfunc()
{
  tell_object(TP, "Der halbtote Daemonenjaeger zeigt Dir eine Liste.\n");

  DUNGTOPMASTER->ReadToplist(TP);
  
  return "stoehnt vor Schmerz.";
}
