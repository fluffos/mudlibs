
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>

#include "../def.h"

create()
{
  ::create();
  SetProp (P_SHORT, "Ein Rune");
  SetProp (P_LONG, "Du solltest sie dringend Iwo zeigen");
  SetProp (P_NAME, "Rune");
  SetProp (P_GENDER, FEMALE);
  AddId (({"rune", "\ndungrune", "\ndungautoload&nodrop"}));
  SetProp (P_WEIGHT, 0);
  SetProp (P_VALUE, 1);
  SetProp (P_MATERIAL, MAT_STONE);
  SetProp (P_INFO, BS("Du solltest sie wohl sehr gut aufbewahren."));
  SetProp (P_NODROP, 1);
  SetProp (P_NEVERDROP, 1);
  // Hmmm
  //SetProp (P_AUTOLOADOBJ, 1);
  SetProp (P_NOBUY, 1);
  SetProp (P_NOSELL, "Du findest dass die Rune viel zu kostbar ist.");
}


void SetLevel(int level)
{
  SetProp(P_DUNGLEVEL, level);
  SetProp(P_LONG, DUNGRUNES[(level-20)/5]);
  AddId( ({ sprintf("\ndungrunelvl%d",level) }));
  return;
}
