
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>

#include "../def.h"

int glow = 0;

create()
{
  ::create();
  SetProp (P_SHORT, "Ein Kristalloktaeder");
  SetProp (P_LONG, "Der Oktaeder schimmert in allen Farben. Du spuerst "
                   "foermlich die Kraft, die von ihm ausgeht.");
  SetProp (P_NAME, "Kristalloktaeder");
  SetProp (P_GENDER, MALE);
  AddId (({"kristall", "oktaeder", "\ndungcrystaloctahedron", "\ndungnoleave"}));
  SetProp (P_WEIGHT, 40);
  SetProp (P_VALUE, 1600);
  SetProp (P_MATERIAL, MAT_CRYSTAL);
  SetProp (P_INFO, BS("Er scheint wohl magische Kraefte zu besitzen."));

  AddDetail("funkeln", "Alle.");
  AddDetail("kraft", "Spueren, nicht sehen.");
}

void init()
{
  ::init();
  if(glow) return;
  if (MENV->QueryProp(P_DUNGLEVEL) == QueryProp(P_DUNGLEVEL)
      && MENV->QueryProp(P_NEW_EXITS)
      && member(MENV->QueryProp(P_NEW_EXITS), "unten"))
    {
      call_out("glow", 0);
      SetProp(P_NOGET, "Der Kristalloktaeder laesst sich nicht bewegen.\n");
      DUNGMASTER->LoadInOut(QueryProp(P_DUNGLEVEL)+1);
    } 
}

void glow()
{
  if (glow) return;
  tell_room(ENV(ME), BS(TO->Name(WER, 1) + " beginnt zu leuchten."));
  DUNGMASTER->SolvedMap(QueryProp(P_DUNGLEVEL));
  glow = 1;
}
