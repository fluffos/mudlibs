
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>

#include "../def.h"

create()
{
  ::create();
  SetProp (P_SHORT, "Ein ekliger Pilz");
  SetProp (P_LONG, "Dieses Gewaechs der Finsternis ist alles andere "
                   "als appetitlich - aber man sollte selbst eine "
                   "so abstossende Pflanze nicht unterschaetze.");
  SetProp (P_NAME, "Pilz");
  SetProp (P_GENDER, MALE);
  AddId (({"pilz", "\ndungmushroom", "\ndungnoleave"}));
  SetProp (P_WEIGHT, 5);
  SetProp (P_VALUE, 200);
  SetProp (P_MATERIAL, MAT_MISC_PLANT);
  SetProp (P_INFO, BS("Er scheint wohl besondere Kraefte zu besitzen."));

  AddCmd( ({ "iss", "esse" }), "eat");
}


void SetLevel(int level)
{
  SetProp(P_DUNGLEVEL, level);
}


int eat(string str)
{
  notify_fail("Was moechtest Du essen?\n");
  if (strstr(str, "pilz")==-1 && str != "alles" && str != "alle") return 0;

  if (TP != ENV(ME)) return 0;
  
  tell_object(TP, "Du ist angewidert den ekligen Pilz.\n");
  
  if (random(2))
    TP->AddHp(QueryProp(P_DUNGLEVEL) * (2 + random(5)));
  else
    TP->AddSp(QueryProp(P_DUNGLEVEL) * (2 + random(5)));

  ME->remove();

  if (str != "alle" && str != "alles") return 1;
  return 0;
}
