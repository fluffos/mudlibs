
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>

#include "../def.h"

create()
{
  ::create();
  SetProp (P_SHORT, "Ein bisschen Moos");
  SetProp (P_LONG, 
      "Das Moos, welches Du in den Haenden haeltst, ist saftig und "
      "sieht lecker aus. Du weisst nicht warum, aber Du hast das Verlangen "
      "es zu essen.");
  SetProp (P_NAME, "Moos");
  SetProp (P_GENDER, MALE);
  AddId (({"moos", "\ndungmoos", "\ndungnoleave"}));
  SetProp (P_WEIGHT, 5);
  SetProp (P_VALUE, 200);
  SetProp (P_MATERIAL, MAT_MISC_PLANT);
  SetProp (P_INFO, BS("Es scheint ungiftig zu sein."));

  AddCmd( ({ "iss", "esse" }), "eat");
}


void SetLevel(int level)
{
  SetProp(P_DUNGLEVEL, level);
}


int eat(string str)
{
  notify_fail("Was moechtest Du essen?\n");
  if (strstr(str, "moos")==-1 && str != "alles" && str != "alle") return 0;

  if (TP != ENV(ME)) return 0;
  
  tell_object(TP, "Du isst das Moos.\n");
  
  if (random(2))
    TP->AddHp(QueryProp(P_DUNGLEVEL) * (1 + random(4)));
  else
    TP->AddSp(QueryProp(P_DUNGLEVEL) * (1 + random(4)));

  ME->remove();

  if (str != "alle" && str != "alles") return 1;
  return 0;
}
