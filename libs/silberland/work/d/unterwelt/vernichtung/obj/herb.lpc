
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>

#include "../def.h"

create()
{
  ::create();
  SetProp (P_SHORT, "Ein Kraut");
  SetProp (P_LONG, "Ein Kraut. Du erkennst nicht welches... und - wenn man "
    "es genau nimmt ist es Dir egal. Du verspuerst einfach nur den Drang es "
    "zu vernaschen.");
  SetProp (P_NAME, "Kraut");
  SetProp (P_GENDER, MALE);
  AddId (({"kraut", "\ndungherb", "\ndungnoleave"}));
  SetProp (P_WEIGHT, 5);
  SetProp (P_VALUE, 200);
  SetProp (P_MATERIAL, MAT_MISC_PLANT);
  SetProp (P_INFO, BS("Es scheint ungiftig zu sein."));

  AddCmd( ({ "iss", "esse" }), "eat");
}


void SetLevel(int level)
{
  SetProp(P_DUNGLEVEL, level);
}


int eat(string str)
{
  int rnd;

  notify_fail("Was moechtest Du essen?\n");
  if (!str) return 0;
  if (strstr(str, "kraut")==-1 && str != "alles" && str != "alle") return 0;

  if (TP != ENV(ME)) return 0;
  
  tell_object(TP, "Du vernascht erfreut das Kraeutchen.\n");
  
  rnd = random(3);
  
  if (rnd==2)
    TP->AddHp(QueryProp(P_DUNGLEVEL) * (1 + random(4)));
  else if(rnd==1)
    TP->AddSp(QueryProp(P_DUNGLEVEL) * (1 + random(4)));
  else TP->SetProp(P_POISON, 0);

  ME->remove();

  if (str != "alle" && str != "alles") return 1;
  return 0;
}
