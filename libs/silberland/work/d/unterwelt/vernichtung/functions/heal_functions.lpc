/*
 * Heal functions fur dungeon
 * Iwo@SL
 */

private string col;

int AddHeal()
{
  SetProp(P_DUNG_NO_UNLOAD, 1);
  call_other(TO, DUNGHEALFUNCS[random(sizeof(DUNGHEALFUNCS))]);
  return 1;
}


void HealFunc1()
{
  RemoveDetail("boden");
  AddDetail(({"boden"}), "Der staubige Boden ist von organischen Resten "
    "uebersaet. Zwischen den Faulenden Ueberbleibseln wachsen ein paar Pilze.");
  AddDetail( ({ "pilz", "pilze" }), "Sie sehen nicht besonders appetitlich "
    "aus. Trotzdem solltest Du sie wohl probieren.");
  AddCmd( ({"pflueck", "pfluecke"}), "HealFunc1Cmd");
}

int HealFunc1Cmd(string str)
{
  object ob;

  notify_fail("Was moechtest Du pfluecken?\n");
  if (member( ({ "pilz", "pilze", "schwammerl" }), str) == -1) return 0;

  notify_fail("Du hast schon alle Pilze gepflueckt.\n");
  if (heal_used>=3) return 0;
 
  ob = clone_object(DUNGOBJ("mushroom"));
  
  ob->SetProp(P_DUNGLEVEL, TO->QueryProp(P_DUNGLEVEL));
  
  tell_object(TP, "Du pflueckst einen Pilz und steckst ihn ein.\n");
  tell_room(ME, BS(sprintf("%s scheint gerade etwas vom Boden aufgehoben "
          "zu haben.", TP->Name(WER,1))), ({TP}));  

  if (ob->move(TP, M_GET) == ME_TOO_HEAVY)
    {
      tell_object(TP, "Du kannst den Pilz nicht mehr tragen.\n");
      ob->move(ME);
    }

  heal_used++;

  return 1;
}


void HealFunc2()
{
  RemoveDetail("boden");
  AddDetail(({"boden"}), "Der Untergrund scheint hier weicher zu sein "
    "als sonst wo.");
  AddDetail( ({ "untergrund", "grund" }), "Sicherlich lohnt es etwas zu graben.");
  AddCmd( ({"grab", "grabe"}), "HealFunc2Cmd");
}

nosave int HealFunc2Cmd(string str)
{
  object ob;

  notify_fail("Wo moechtest Du graben?\n");
  if (member( ({ "boden", "erde", "untergrund" }), str) == -1) return 0;

  if (!present("schaufel", TP))
    {
      tell_object(TP, BS("Du graebst mit den blossen Haenden im "
                         "harten Untergrund."));
      tell_room(ME, BS(TP->Name(WER) + " graebt mit blossen Haenden rum."), ({TO }));
      TP->AddHp(-3);
    } 

  notify_fail("Du graebst aber findest nichts.\n");
  if (heal_used>=1) return 0;

  tell_object(TP, "Du findest eine Wurzel welche Du sofort verspeist.\n");
  
  TP->AddHp(1000);
  TP->AddSp(1000);

  heal_used++;

  return 1;
}


void HealFunc3()
{
  RemoveDetail("boden");
  AddDetail(({"boden"}), "Obwohl der Boden hier voellig veroedet ist scheint "
    "an dieser Stelle etwas zu wachsen.");
  AddDetail( ({ "stelle", "etwas", "gewaechs" }), "Ups, hier wachsn ein paar "
    "Kraeuter.");  
  AddCmd( ({"pflueck", "pfluecke"}), "HealFunc3Cmd");
}


nosave int HealFunc3Cmd(string str)
{
  object ob;

  notify_fail("Was moechtest Du pfluecken?\n");
  if (member( ({ "kraut", "kraeuter" }), str) == -1) return 0;

  notify_fail("Du hast schon alle Kraeuter gepflueckt.\n");
  if (heal_used>=5) return 0;
 
  ob = clone_object(DUNGOBJ("herb"));
  
  ob->SetProp(P_DUNGLEVEL, TO->QueryProp(P_DUNGLEVEL));
  
  tell_object(TP, "Du pflueckst ein Kraut und steckst es ein.\n");
  tell_room(ME, BS(sprintf("%s scheint gerade etwas vom Boden aufgehoben "
          "zu haben.", TP->Name(WER,1))), ({TP}));
  
  if (ob->move(TP, M_GET) == ME_TOO_HEAVY)
    {
      tell_object(TP, "Du kannst das Kraut nicht mehr tragen.\n");
      ob->move(ME);
    }

  heal_used++;

  return 1;
}

void HealFunc4()
{
  col=({"gruen", "blau"})[random(2)];
  RemoveDetail("waende");
  RemoveDetail("wand");
  AddDetail(({"wand", "waende"}), 
      "An der kahlen Wand hat sich ein Schimmelpilz entwickelt. Er leutet "
      "in einem "+col+"en Licht.");
  AddDetail( ({"pilz", "schimmelpilz"}),
      "Du hast das Verlangen Deine Hand auf diesen Pilz zu legen. Wer weiss "
      "was dann passiert?");
  AddCmd( ({"lege", "leg"}), "HealFunc4Cmd");
}

nosave int HealFunc4Cmd(string str)
{
  string was;
  notify_fail("Auf was moechtest Du Deine Hand legen?\n");
  if(sscanf(str, "hand auf %s", was)!=1) return 0;

  if (heal_used>=5) {
    write("Nichts passiert.\n");
    return 1;
  } 
  
  tell_object(TP, BS("Du legst Deine Hand auf den leuchtenden Schimmelpilz. "
      "Nach einer kurzen Zeit durchflutet eine angenehme Waerme Deinen "
      "Koerper."));
  tell_room(ME, BS(sprintf("%s legt %se Hand auf etwas an der Wand.",
          TP->Name(WER,1), TP->QueryPossPronoun(WESSEN))), ({TP}));
  if(col=="gruen") 
   TP->AddHp(ME->QueryProp(P_DUNGLEVEL)*8); 
  else 
   TP->AddSp(ME->QueryProp(P_DUNGLEVEL)*8); 
  heal_used++;

  return 1;
}

void HealFunc5()
{
  RemoveDetail("boden");
  AddDetail(({"boden"}), 
      "Der Boden hier ist oed und kahl, aber doch scheinen ein paar Moose "
      "hier zu wachsen.");
  AddDetail( ({"moos", "moose"}),
      "Die Moose wachsen am Boden. Einige davon koennten durchaus geniessbar "
      "sein. Vielleicht solltest du die Moose mal durchsuchen?");
  AddCmd( ({"durchsuche", "durchsuch"}), "HealFunc5Cmd");
}

nosave int HealFunc5Cmd(string str)
{
  object ob;
  notify_fail("Was moechtest Du durchsuchen?\n");
  if(str!="moos"&&str!="moose") return 0;

  notify_fail(BS("Du suchst, aber es sind leider keine brauchbaren Moose "
      "mehr da."));
  if (heal_used>=3) return 0;
 
  ob = clone_object(DUNGOBJ("moos"));
  
  ob->SetProp(P_DUNGLEVEL, TO->QueryProp(P_DUNGLEVEL));
  
  tell_object(TP, BS("Du findest tatsaechlich ein Moos, dass so aussieht "
      "als koennte es Dich etwas heilen.\n"));
  tell_room(ME, BS(sprintf("%s scheint gerade etwas vom Boden aufgehoben "
          "zu haben.", TP->Name(WER,1))), ({TP}));  

  if (ob->move(TP, M_GET) == ME_TOO_HEAVY)
    {
      tell_object(TP, "Du kannst das Kraut nicht mehr tragen.\n");
      ob->move(ME);
    }

  heal_used++;

  return 1;
}

nosave string HealFunc6Cmd()
{
  if (heal_used>=3) return BS("Leider kannst Du nichts entziffern.");
  TP->AddHp(ME->QueryProp(P_DUNGLEVEL)*2+20);
  TP->AddSp(ME->QueryProp(P_DUNGLEVEL)*2+20);
  return BS("Als Du die Runen zu entziffern versuchst, spuerst Du wie "
      "Dein Koerper sich regeneriert.");
}
void HealFunc6()
{
  RemoveDetail("waende");
  RemoveDetail("wand");
  AddDetail(({"wand", "waende"}), 
      "Die Waende sind vollkommen kahl. Allerdings kannst Du einen kleinen "
      "Schriftzug entdecken.");
  AddDetail( ({"schriftzug"}),
      "Es handelt sich dabei um kleine Runen.");
  AddDetail( ({"runen"}),
      "Hm. Du koenntest sie lesen.");
  AddReadDetail( ({"runen"}), #'HealFunc6Cmd);
}

