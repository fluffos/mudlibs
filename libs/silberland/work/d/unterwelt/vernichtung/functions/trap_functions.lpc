/*#include "../def.h"
#include <properties.h>
#include <defines.h>
#include <moredef.h>
#include <combat.h>
*/

private int d_level;
private int disable_trap=0;
private string trap;

int AddTrap() {
  string *traps;
  traps=TRAPS;

  d_level=ME->QueryProp(P_DUNGLEVEL);

  trap=traps[random(sizeof(traps))];

  disable_trap=0;

  SetProp(P_DUNG_NO_UNLOAD, 1);

  return 1; 
}

int CallTrap() {
  if(!trap) return 0;
  if(!interactive(TP)) return 0;
  d_level=ME->QueryProp(P_DUNGLEVEL);
  call_other(ME, trap);
  return 1;
}

nosave int cave_collapsion() {
  if(ME->query_disable_status()) return 0;
  ME->set_disable_trap();
  if(TP->QueryAttribute(A_DEX) > random((int)(2*d_level/3))) {
    tell_object(TP, BS("Von der Decke loesen sich ein paar Brocken und fallen "
          "auf dich herab! Geschickt weichst Du aus!"));
    tell_room(ME, BS(sprintf("Von der Decke loesen sich ein paar Brocken "
          "und fallen auf %s, doch %s weicht geschickt aus!", TP->name(WER,1),
          TP->QueryPronoun(WER, 1))),({TP})); 
    return 1;
  }
  tell_object(TP, BS("Von der Decke loesen sich ein paar Brocken und "
        "fallen herunter! Einer der Felsbrocken trifft Dich!"));
  tell_room(ME, BS(sprintf("Von der Decke loesen sich ein paar Brocken "
          "und fallen herunter! Einer davon trifft %s!", TP->name(WEN,1))),
      ({TP}));
  ME->do_room_damage(TP, random((int)(d_level*1.5)), "Ein Felsbrocken", "");
  return 1;
}

nosave int stalactit_drop() {
  object *arm;
  int def, dam, i;
  if(ME->query_disable_status()) return 0;
  ME->set_disable_trap();

  tell_object(TP, BS("Ein Stalagtit loest sich von der Hoehlendecke "
        "und trifft Dich am Kopf!"));
  tell_room(ME, BS(sprintf("Ein Stalagtit loest sich von der Decke und "
          "trifft %s am Kopf.", TP->name(WEN,1))), ({ TP }));
  arm=TP->QueryProp(P_ARMOURS);
  if(sizeof(arm)) {
    for(i=sizeof(arm)-1;i>=0;i--)  {
      if(arm[i]->QueryProp(P_ARMOUR_TYPE)==AT_HELMET) {
        def=arm[i]->QueryProp(P_AC);
        arm[i]->TakeFlaw(30);
      }
    }        
  }
  dam=10+random(d_level)-def;
  if(dam<1) {
    tell_object(TP, "Dank Deines Helmes erleidest Du keinen Schaden!\n");
    dam=0;
  }
  ME->do_room_damage(TP, dam, "Ein Stalagtit","Ein durchschlagendes Erlebnis, "
      "gell?");
  return 1;
}

nosave int poison_cloud() {
  if(random(4)) return 0;
  tell_object(TP, "Ploetzlich schiesst eine gruene Wolke durch einen "
      "Spalt! *HUST* Baeh, das stinkt!");
  tell_room(ME, BS(sprintf("Ploetzlich schiesst eine uebelriechende gruene "
          "Wolke aus einem Spalt und huellt %s ein!", TP->name(WEN, 1))),
      ({TP}));
  TP->AddPoison(random(2)+1);
  return 1;
}

nosave int get_blind() {
  if(random(2) || ME->query_disable_status()) return 0;
  if(!random(4)) ME->set_disable_trap();
  tell_object(TP, BS("WAH!!! Auf einmal brennen Deine Augen so, dass Du sie "
      "nicht mehr aufhalten kannst! Du reibst an ihnen herum, und als Du "
      "sie wieder oeffnest stellst Du fest, dass Du nichts mehr siehst!"));
  tell_room(ME, BS(sprintf("Irgendetwas rieselt von der Decke direkt auf "
          "%s! %s beginnt %se Augen zu reiben und als %s sie wieder "
          "aufmacht ist %s blind!", TP->name(WEN,1), 
          CAP(TP->QueryPronoun(WER,1)), TP->QueryPossPronoun(WESSEN), 
          TP->QueryPronoun(WER,1), TP->QueryPronoun(WER,1))),({TP}));
  TP->SetProp(P_BLIND, d_level*2);
  return 1;
}

nosave int acid() {
  object *arm;
  int def, dam, i;
  if(ME->query_disable_status()) return 0;
  if(!random(3)) ME->set_disable_trap();

  tell_object(TP, BS("Argl! Du bist gerade in eine Saeurepfuetze getreten!"));
  tell_room(ME, BS(sprintf("%s ist gerade in eine Saeurepfuetze getreten.",
                    TP->name(WEN,1))),({TP}));
  arm=TP->QueryProp(P_ARMOURS);
  if(sizeof(arm)) {
    for(i=sizeof(arm)-1;i>=0;i--)  {
      if(arm[i]->QueryProp(P_ARMOUR_TYPE)==AT_BOOT) {
        if(!random(20)) {
          arm[i]->DoUnwear(1);
          arm[i]->remove();
          tell_object(TP, BS("Mit einem haesslichen Zischen loest sich Dein "
              "Schuhwerk auf."));
        }
        else {
          def=arm[i]->QueryProp(P_AC);
          arm[i]->TakeFlaw(30);
        }
      }
    }        
  }
  dam=15+random(d_level)-def;
  if(dam<1) {
    tell_object(TP, "Dank Deines Schuhwerks erleidest Du keinen Schaden!\n");
    dam=0;
  }
  ME->do_room_damage(TP, dam, "Saeure","Echt aetzend, oder?");
  ME->RemoveDetail(({"saeure", "saeurepfuetze"}));
  ME->AddDetail( ({"saeure", "saeurepfuetze"}),
      "Diese kleine Saeurepfuetze hast Du komplett uebersehen!");
  return 1;
}

nosave int roots() {
  if(random(3)) return 0;
  tell_object(TP, BS("Du verhedderst Dich mit Deinem Fuss in einer kleinen "
        "Wurzel und stuerzt!"));
  tell_room(ME, BS(sprintf("%s stolpert und faellt hin. So ein Tollpatsch.",
          TP->Name(WER))), ({TP}));
  ME->do_room_damage(TP, random(d_level/2), "Hinfallen","Ich wars nicht, der "
      "harte Boden war schuld!");
  ME->RemoveDetail("wurzel");
  ME->AddDetail("wurzel", "Huch, tatsaechlich eine kleine Wurzel. Die hast "
      "Du glatt uebersehen.");
  return 1;
} 


nosave void set_disable_trap() {
  disable_trap=1;
}
nosave int query_disable_status() {
  return disable_trap;  
}

nosave void do_room_damage(object pl, int dam, string kill_name, 
    string kill_msg) 
{
  mixed old_kill_msg, old_kill_name;
  //TELL("angrox", sprintf("VERD: room_dam, TP:%O, dam: %d\n", TP,dam));
  old_kill_msg=ME->QueryProp(P_KILL_MSG);
  old_kill_name=ME->QueryProp(P_KILL_NAME);
  if(kill_msg!="")
    ME->SetProp(P_KILL_MSG, kill_msg);
  else
    ME->SetProp(P_KILL_MSG, 0);
  ME->SetProp(P_KILL_NAME, kill_name);
  pl->do_damage(dam);
  ME->SetProp(P_KILL_MSG, old_kill_msg);
  ME->SetProp(P_KILL_NAME, old_kill_name);
  return;
}
