
#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

#include "def.h"

#pragma strong types;

inherit "std/room";

void create()
{
  if(IS_CLONE(TO)) return;
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_INT_SHORT, "In einem Tempel der Schaendung");
  SetProp (P_INT_LONG, "Vor Dir pflanzet sich majestaetisch der riesige "
    "Altar oder Opfertisch - wasauchimmer das Gebilde darstellen soll. "
    "Dir ist ein bisschen gruselig beim Betrachen der Situation - aber "
    "ein erfahrener Krieger und Forscher wie Du es bist bleibt "
    "auch bei den uebelsten Anblicken ruhig und besonnen.");

  AddDetail( ({ "altar", "opfertisch", "tisch" }), "Die Kanaele "
    "welche mit irgendeiner dunklen eingetrockneten Fluessigkeit "
    "gefuellt sind verwandeln sich in purers Entsetzen als Dir "
    "daemmert was sie einmal abgeleitet haben.");
  AddDetail( ({ "kanaele", "kanal", "nase", "stelle" }), "Die Kanaele laufen zusammen zu "
    "einer Nase welche genau an der optimalen Stelle ist um einen Kelch "
    "darunter zu halten.");
  AddDetail( ({ "entsetzen" }), "Wie Du ein eigenes sehen willst moecht ich "
    "schon gerne wissen.");
  AddDetail( ({ "fluessigkeit", "blut" }), "Bevor er eingetrocknet ist war "
    "dies wohl mal der Saft des Lebens.");
  AddDetail( ({ "saft" }), "Eigentlich bist Du durstig. (Dieses Detail wurde "
    "Dir spendiert von CocaCola :)");
  AddDetail( ({ "boden" }), "Er ist etwas schmutzig und von etwas Staub "
    "bedeckt. War wohl lange niemand hier.");
  AddDetail( ({ "staub" }), "Nicht viel - aber es reicht um daraus zu "
    "schliessen, dass schon einige Zeit niemand mehr einen Fuss hierher "
    "gesetzt hat.");
  AddDetail( ({ "decke" }), "Du hast Angst dass Dir ein Stueckchen "
    "Fels auf den Kopf fallen koennte.");
  AddDetail( ({ "stueckchen" }), "Noch siehst Du gottseidank keines, aber "
    "sollte eines abbrechen wuerde es wahrscheinlich ziemlich schnell "
    "auf Dich zufallen.");
  AddDetail( ({ "fels" }), "Du betrachtest intensiv den Fels, beschliesst "
    "aber dann die naehere Untersuchung einem Geologen zu ueberlassen.");
  AddDetail( ({ "gebilde", "form" }), "'Tisch' wuerde wohl die Form am "
    "Treffendsten beschreiben.");
  AddDetail( ({ "waende", "wand" }), "Wie nicht anders zu erwarten siehst "
    "Du beim betrachten der Wand nur Fels. Nicht unschoen - aber auch nicht "
    "besonders aufregend. Du wendest Dich gelangweilt ab.");
       
  AddExit("sueden", DUNGROOM("../eingang2"));
  AddExit("unten", DUNGROOM("room:1:9:1"));
  AddCmd( ({ "reib", "reibe", "rubbe", "rubbel" }), "EscapeCmd");

  AddItem(DUNGNPC("leiche"), REFRESH_DESTRUCT);
}


int EscapeCmd(string str)
{
  string cmd;
  object rune;
  cmd = TP->query_verb();
  if (cmd=="reib") cmd += "en";
  else if (cmd="rubbe") cmd += "ln";
  else cmd += "n";
  notify_fail(sprintf("Was willst Du %s?\n", cmd));
  if (!str || !rune = present(str, TP)) return 0;
  tell_room(ENV(TP), BS(TP->Name(WER) + " reibt an etwas herum."), ({ TP }));
  notify_fail("Du reibst an der Rune rum.\n");
  if (!rune->QueryProp(P_DUNGLEVEL) 
      || rune->QueryProp(P_DUNGRUNE_LAST_USED)+1000>time()) return 0;
  tell_object(TP, "Die Rune leuchtet auf.\n");
  call_out("Escape", 2, TP, rune->QueryProp(P_DUNGLEVEL));
  DUNGMASTER->LoadInOut(rune->QueryProp(P_DUNGLEVEL));
  rune->SetProp(P_DUNGRUNE_LAST_USED, time());
  return 1;
}                               


void Escape(object pl, int lvl)
{
  return pl->move(DUNGMASTER->NextLevelStart(lvl-1) ,M_GO, 0,
                    "zerfaellt zu Staub",
                    "erhebt sich aus der Asche");
}

