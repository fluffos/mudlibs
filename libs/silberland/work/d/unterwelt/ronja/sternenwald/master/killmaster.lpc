#include "../def.h"

mapping dragonkills;
mapping unicornkills;

// 0: Anzahl Kills

void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

  seteuid(getuid(this_object()));

  dragonkills  = ([]);
  unicornkills = ([]);
  restore_object(SAVEFILE);
  return;
}

//*************************************************************************
//* Drachenfunktionen                                                     *
//*************************************************************************

int SetDragonKill(string uid)
{
  if(member(dragonkills,uid))
  {
    dragonkills[uid,0] += 1;
  }
  else
  {
    dragonkills += ([uid:1]);
  }

  save_object(SAVEFILE);
  return 1;
}

int DeleteDragonKill(string uid)
{
  dragonkills = m_delete(dragonkills, uid);
  save_object(SAVEFILE);
  return 1;
}

int dragoncompare(string a,string b)
{
  if(dragonkills[a,0] < dragonkills[b,0])
  {
    return 1;
  }
  else if(dragonkills[a,0] == dragonkills[b,0])
  {
    if(a > b) return 1; else return 0;
  }

  return 0;
}

string *GetDragonKillList()
{
  return sort_array(m_indices(dragonkills),"dragoncompare",TO);
}

int GetNumberOfDragonKills(string uid)
{
  if(member(dragonkills,uid))
  {
    return dragonkills[uid,0];
  }
  else
  {
    return 0;
  }

}

mapping QueryDragonKills()
{
  return dragonkills;
}

//*************************************************************************
//* Einhornfunktionen                                                     *
//*************************************************************************

int SetUnicornKill(string uid)
{
  if(member(unicornkills,uid))
  {
    unicornkills[uid,0] += 1;
