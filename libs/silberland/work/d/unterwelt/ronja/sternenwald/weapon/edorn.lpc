#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <ansi.h>

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Eisdorn");
  SetProp(P_LONG,
    "Ein Eisdorn. Kalt liegt er in Deiner Hand, und doch schmilzt er nicht."
  );

  SetProp(P_NAME, "Eisdorn");
  SetProp(P_GENDER, MALE);
  AddId( ({"dorn","eisdorn","\neisdorn"}) );

  SetProp(P_INFO,BS("Dieser Eisdorn sieht aus, als ob man ihn an irgendetwas "
                    "befestigen koennte. Wenn man den Eisdorn tief in den "
                    "Gegner bohren koennte, waere er bestimmt eine maechtige "
                    "Waffe. Doch im Nahkampf kann der Eisdorn seine toedliche "
                    "Wirkung nicht recht entfalten."));

  SetProp(P_NOBUY, 1);
  SetProp(P_ITEMD_NO_MAGIC,1);
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 45);
  SetProp(P_DAM_TYPE, ({DT_PIERCE,DT_COLD}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_ICE:95,MAT_MAGIC:5]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 5);
  SetProp(P_SIZE, 30);
}

