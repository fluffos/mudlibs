#include "../def.h"

inherit WEAPON "std_horn";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>

create()
{
  if (!is_clone(TO))return;

  ::create();

  SUID;

  ltext = "Dieses Horn ist schwarz. Schwaerzer als die Nacht, sogar "
          "schwaerzer als der Raum zwischen den Sternen. Die manifestierte "
          "Dunkelheit. Du kannst die Windungen des Horns nur fuehlen, "
          "und auch die Spitze des Hornes kannst Du nur erahnen, nicht "
          "jedoch sehen.";

  SetProp(P_INFO ,"Das Horn eines schwarzen Einhornes ist in der "
                  "Lage, einen Raum zu verdunkeln.");

  SetProp(P_NAME_ADJ,"schwarz");
  AddAdjective( ({"schwarzer","schwarzes","schwarzen","schwarzem"}) );

  SetProp(P_LIGHT,0);
}

void reset()
{
  object env;

  ::reset();

  if(!is_clone(TO)) return;

  env = ENV(TO);

  if(!env) return;

  if(interactive(env))
  {
    if(random(10) == 3)
    {
      tell_object(env,"Das schwarze Horn zerfaellt zu Staub.\n");
      call_out("remove",0);
    }
    else
    {
      tell_object(env,"Die Magie des schwarzen Einhornes laedt sich mit "
                      "Deiner Magie wieder auf.\n");
      if(env->QueryProp(P_SP) > 180)
      {
        SetProp(P_LIGHT,-2);
      }
      else
      {
        SetProp(P_LIGHT,-1);
      }

      env->SetProp(P_SP,0);
    }
  }
  else
  {
    SetProp(P_LIGHT,0);
  }

}

void init()
{
  object env;

  ::init();

  if(!(env=ENV(TO))) return;
  if(!interactive(env)) SetProp(P_LIGHT,0);
}


