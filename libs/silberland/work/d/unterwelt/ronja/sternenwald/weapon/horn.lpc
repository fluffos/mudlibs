#include "../def.h"

inherit WEAPON "std_horn";

#define MAX_COUNT 1
#define MAX_HEAL 3

int count,total_heal;

void create()
{
  if (!is_clone(TO))return;

  ::create();

  SUID;

  ltext = "Das Horn eines Einhornes. Fast tut es Dir leid, dass deswegen "
          "ein Einhorn sterben musste. Lang und gewunden ist es, es laesst "
          "sich sicherlich wie einen Speer einsetzen.";

  SetProp(P_NAME, "Horn");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_INFO ,"Einhoerner sollen gut sein gegen Vergiftungen. Vielleicht "
                  "hilft es, wenn Du die Spitze beruehrst?\n");
  SetProp(P_VALUE, 1500);

  AddCmd( ({"beruehr","beruehre"}) , "cmd_beruehren" );

  total_heal = 1;
  count = MAX_COUNT;
}

void reset()
{
  object room;

  ::reset();

  if(count < MAX_COUNT) count = MAX_COUNT;
}

void SetHeal(int i)
{
  string fname,s;

  total_heal = i;
  fname = file_name(PO);

  if(fname[0..strlen(ZONE)-1] == ZONE) return;
  s = sprintf("HORN->SetHeal(%d) gesetzt von %s",i,fname);
  SWMASTER->Msg(s);
  DB(s);
}

int cmd_beruehren(string str)
{
  int amount;

  string sp,so;

  notify_fail("Was moechtest Du beruehren?\n\n");

  if(!syntaxok(str)) return 0;

  if(count == 0)
  {
    TELLPLAYER("Die Magie des Einhornes muss sich erst wieder sammeln.\n");
    return 1;
  }

  amount = TP->QueryProp(P_POISON);
  if(amount == 0)
  {
    TELLPLAYER("Du beruehrst die Spitze des Einhorns, doch nichts "
               "passiert.\n");
    TELLOTHERS(CTPN+" berueht die Spitze eines Horn, doch anscheinend "
               "passiert nichts.\n");
    return 1;
  }

  if(amount > MAX_HEAL) amount = MAX_HEAL;
  if(amount > total_heal) amount = total_heal;

  total_heal -= amount;
  TP->AddPoison(-amount);
  count--;

  if(TP->QueryProp(P_POISON) == 0)
  {
    sp = "Du beruehrst die Spitze des Hornes und fuehlst, wie die Gifte "
         "aus Deinem Koerper verschwinden. ";
  }
  else
  {
    sp = "Du beruehrst die Spitze des Hornes und fuehlst, wie die Gifte "
         "teilweise aus Deinem Koerper verschwinden. ";
  }

  so = CTPN+" beruehrt die Spitze eines Hornes und sieht gleich etwas "
       "besser aus. ";

  if(total_heal <= 0)
  {
    sp += "Die heilende Kraft und Magie des Hornes hat sich "
          "erschoepft und es zerfaellt zu Sternenstaub.";
    so += CAP(TP->Name(WESSEN))+" "+Name(RAW)+" zerfaellt zu Sternenstaub.";
  }

  TELLPLAYER(BS(sp));
  TELLOTHERS(BS(so));
  if(total_heal <= 0) remove();
  return 1;
}

int QueryCount()
{
  return count;
}

int QueryHeal()
{
  return total_heal;
}

