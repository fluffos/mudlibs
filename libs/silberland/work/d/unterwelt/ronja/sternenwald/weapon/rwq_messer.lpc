#include "../def.h"

inherit "/std/weapon";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <language.h>

string owner;

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein Schlachtermesser");
  SetProp(P_LONG,
    "Ein fast armlanges Messer mit scharf geschliffener Klinge, wie "
    "es Metzger zum Zerlegen von Fleisch oder zum Schlachten von "
    "Tieren verwenden. Im hoelzernen Griff ist der Name 'Plexus' "
    "eingraviert."
  );

  SetProp(P_NAME, "Schlachtermesser");

  AddId( ({ "messer", "schlachtermesser", "RWQ_Messer" }) );

  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 1);

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 15);
  SetProp(P_WC_BONUS, (["\ndunkelelfensklave":60]) );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_MATERIAL, ([MAT_STEEL:100]) );
  SetProp(P_SIZE, 30);

  owner = 0;
}

string SetOwner(object pl)
{
  return (owner = getuuid(pl));
}

string QueryOwner()
{
  return owner;
}

void removeme(object player)
{
  tell_object(player,BS("Als Du das Messer nimmst, laesst Du es ungeschickter"
                        "weise fallen und die sproede Klinge zerbirst. Du "
                        "bist aber auch ein Tolpatsch!"));

  tell_room(ENV(player),BS("Als "+TPN+" das Messer nimmt, laesst "+
                           player->QueryPronoun(WER)+" es fallen und "
                           "es zerbirst. So ein Tolpatsch!"),
                           ({ player }) );

  remove();
}

void init()
{
  ::init();

  if(ENV(TO) && living(ENV(TO)))
  {
    if(!owner)
    {
      SetOwner(ENV(TO));
      return;
    }

    if(owner != getuuid(ENV(TO))) call_out("removeme",0,ENV(TO));
  }
}


