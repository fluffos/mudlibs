#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Seidenguertel");
  SetProp(P_LONG,
    "Dieser Seidenstrick ist aus feinster Spinnenseide gesponnen. "
    "Er hat gerade die richtige Laenge, um ihn um die Taille zu "
    "tragen und ihn als Guertel zu benutzen."
  );

  SetProp(P_NAME, "Seidenguertel");
  SetProp(P_GENDER, MALE);
  AddId( ({"seidenguertel", "guertel"}) );

  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_SILK );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100+random(20));
  SetProp( P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Dunkelelf","Drider"})]));
}
