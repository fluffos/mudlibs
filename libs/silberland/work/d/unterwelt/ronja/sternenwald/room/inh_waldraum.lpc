#include "../def.h"
#include <ansi.h>

inherit ROOM "inh_sternenwald";

#define OFFEN 1
#define ZU 0

#define MOEGLICH 1
#define NICHT_MOEGLICH 0

#define RWQMASTER "/d/unterwelt/zordan/dhrkion/master/rwqmaster"

int nranken;

int loch;
int einbrechen;
int propability;

string einbrecher;

void SetPropability(int n);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Sternenwald" );

  AddSpecialDetail( ({"boden"}),                            "detail_boden");
  AddSpecialDetail( ({"loch","erdloch","rumpelwichtloch"}), "detail_loch" );

  AddDetail( ({ "unterholz", "strauch", "straeucher" }),
    "Das Unterholz ist hier besonders dicht. Schlingpflanzen, die von den "
    "Baeumen herunter haengen, haben sich mit den Straeuchern verfilzt und "
    "bilden ein undurchdringliches Wirrwarr. "
  );

  AddDetail( ({ "himmel" }),
    "Du kannst nur hin und wieder zwischen den Baumkronen den "
    "sternenuebersaehten Himmel sehen."
  );

  AddDetail( ({ "sternenwald", "wald", "ort", "name" }),
    "Dies ist der wunderschoene Sternenwald - ein mythischer Ort voller "
    "tiefer Geheimnisse und wundersamer Wesen."
  );

  AddDetail( ({ "geheimnisse", "geheimnis" }),
    "Das musst Du schon selber herausfinden ..."
  );

  AddDetail( ({ "wesen" }),
    "Wunderbare Wesen kannst Du in diesem Wald antreffen."
  );

  AddDetail( ({ "moos" }),
    "Das Moos ist weich und wo es vom Sternenlicht beruehrt wird, schimmert "
    "es silbrig."
  );

  AddDetail( ({ "sternenlicht", "licht", "sterne", "stern" }),
    "Der Wald ist nach den Sternen benannt, die ewig ueber ihm schimmern "
    "und ihn in ihrem silbernen Licht baden."
  );

  AddDetail( ({ "kronen", "baumkronen", "dach", "blaetterdach","blaetter" }),
    "Die gewaltigen Baeume haben dichte Kronen, die nur manchmal das "
    "Sternenlicht bis zum Boden durchlassen."
  );

  AddDetail( ({ "baum", "baeume" }),
    "Die Baeume in diesem Wald sind uralt. Ihre maechtigen Staemme ragen "
    "wie die Saeulen einer riesigen Kathedrale in den Himmel."
  );

  AddDetail( ({ "stamm", "staemme" }),
    "Die Staemme sind glatt und so dick, dass es wohl vier oder fuenf "
    "Trolle braeuchte, um sie zu umfassen."
  );

  AddDetail( ({ "saeule", "saeulen" }),
    "Die Staemme der Baeume ragen glatt und gerade wie Saeulen in den "
    "Himmel.");

  AddDetail( ({ "troll", "trolle" }),
    "Gross, stark, gefraessig... und dumm."
  );

  AddDetail( ({ "kathedrale" }),
    "Dieser Wald wirkt auf Dich wie eine gewaltige, der Natur geweihte "
    "Kathedrale.");

  AddDetail( ({ "natur", "wunder" }),
    "Die Natur hat in diesem Wald ein magisches Wunder vollbracht."
  );

  AddDetail( ({ "zeit" }),
    "Der Sternenwald scheint zeitlos zu sein."
  );

  AddDetail( ({ "gewirr", "wirrwarr", "durcheinander" }),
    "Ein Gewirr von Schlingpflanzen waechst von den Baeumen herunter, und "
    "bildet mit den Straeuchern des Unterholzes ein undurchdringliches "
    "Durcheinander. "
  );

  AddDetail( ({ "messer" }),
    "Hast Du eins dabei?"
  );

  AddSpecialDetail( ({"schlingpflanze", "schlingpflanzen"}) , "detail_schlingpflanze");
  AddSpecialDetail( ({"ranken","ranke"})                    , "detail_ranken");

  AddSound( DEFAULT_SOUND,
    "Von Zeit zu Zeit raunt leise ein Luftzug durch die Blaetter - "
    "ansonsten herrscht eine fast ehrfurchtgebietende Stille." );

  AddSound( ({"zeit"}),
    "Die Zeit verstreicht lautlos."
  );

  AddSound( ({"luftzug"}),
    "Leise raunt manchmal ein Luftzug durch die Blaetter. "
  );

  AddSound( ({ "luftzug", "blaetter" }),
    "Leise fluestern die Blaetter wenn ein Luftzug hindurch faehrt."
  );

  AddSound( ({ "stille" }),
    "pssssssssssst ..."
  );

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "exit_aufgabe" );

  AddCmd( ({ "reiss", "reisse" })     , "cmd_reissen" );
  AddCmd( ({ "schneid", "schneide" }) , "cmd_schneiden" );
  AddCmd( ({ "hokuspokus" })          , "cmd_event" );

  if(random(6) > 4) nranken = 1 + random(2);

  loch == ZU;
  SetPropability(0);
}

void SetEvent()
{
  if(random(100) < propability)
  {
    einbrechen = MOEGLICH;
  }
  else
  {
    einbrechen = NICHT_MOEGLICH;
  }
}

void SetPropability(int n)
{
  propability = n;
  if(propability < 0)  propability =   0;
  if(propability >100) propability = 100;
  SetEvent();
}

int aufgabe(string str)
{
  notify_fail("Aufgeben gilt nicht!\n");
  return 0;
}

void reset()
{
  ::reset();

  if(random(6) > 4) nranken = 1 + random(2);

  if(loch == OFFEN)
  {
  }

  loch == ZU;
  SetEvent();
}

void init()
{
  string s;

  ::init();

  if(!TP)                          return;
  if(!interactive(TP))             return;
  if(IS_WIZARD(TP))                return;
  if(einbrechen == NICHT_MOEGLICH) return;

  if((TP->QueryProp(P_LEVEL) > 5) || (RWQMASTER->IsQuester(getuuid(TP))))
  {
    call_out("einbrechen",2,TP);
  }

  return;
}

string _query_int_long()
{
  string s;

  s = "Du stehst mitten im riesigen Sternenwald. Gewaltige Baeume ragen "
      "rings um Dich in den Himmel und scheinen die Sterne zu beruehren, "
      "die diesem Wald den Namen gegeben haben. Hier, unter den Baumkronen "
      "ist es fast voellig dunkel. Nur hin und wieder dringt das Sternen"
      "licht durch das dichte Blaetterdach und versilbert den Wald. ";

  s = BS(s);

  if((nranken == 0) && (propability == 0)) return s;

  if(TP && interactive(TP) && IS_WIZARD(TP))
  {
    if(TP->QueryProp(P_TTY)) s += ANSI_BOLD+ANSI_RED;

    switch(nranken)
    {
      case 0:
        break;

      case 1:
        s += "Es gibt 1 Ranke hier.";
        break;

      default:
        s += sprintf("Es gibt %d Ranken hier.",nranken);
        break;
    }

    if(propability > 0)
    {
      if(nranken > 0) s += "\n";

      s += sprintf("Rumpelwichtwahrscheinlichkeit: %d%%; ",propability);
      s += "Einbrechen: " + (einbrechen == MOEGLICH?"":"nicht ") + "moeglich; ";
      s += "Loch: " + (loch == OFFEN?"offen ":"zu ");
    }

    s += "\n";

    if(TP->QueryProp(P_TTY)) s += ANSI_NORMAL;
  }

  return s;
}

string detail_boden(string str)
{
  string s;
  object player;

  s = "Der Boden ist mit federndem Moos ueberzogen. Niedriges aber dichtes "
      "Unterholz waechst zwischen den Baeumen. ";

  if(loch == OFFEN)
  {
    s += "An einer Stelle ist ein Loch im Boden, so als ob etwas eingebrochen "
         "waere. ";

    player = find_player(einbrecher);

    if(player && (ENV(player) == TO) && player->QueryProp(P_PARALYZED))
    {
      s += CAP(player->Name(WER))+" haengt mit "+TPPP(MALE,WEM,SINGULAR)+
           " Fuss darin fest.";
    }
  }

  return BS(s);
}

string detail_loch(string str)
{
  string s;
  object player;

  if(loch == ZU) return "Sowas siehst Du da nicht!\n";

  s = "Im Boden befindet sich ein Loch. Na hoffentlich ist dies keine "
      "Wohnhoehle der Rumpelwichte, denn die labern Dir immer ein Ohr ab. ";

  player = find_player(einbrecher);
  if(player && (ENV(player) == TO) && player->QueryProp(P_PARALYZED))
  {
    s += CAP(player->Name(WER))+" haengt mit "+TPPP(MALE,WEM,SINGULAR)+
         " Fuss darin fest.";
  }

  return BS(s);
}

string detail_schlingpflanze(string key)
{

  string s;

  s = "Du hast keine Ahnung, was das fuer Pflanzen sein koennten. "
      "Ihre Ranken erinnern an ineinander verdrillte Fasern. Mit "
      "den Straeuchern des Unterholzes bilden sie ein wirres "
      "Durcheinander. ";

  switch(nranken)
  {
    case 0:
      break;

    case 1:
      s += "Nur eine Ranke haengt lose von einem Baum herab." ;
      break;

    default:
      s += "Nur zwei oder drei der Ranken haengen lose von einem Baum "
           "herab. ";
    break;
  }

  return BS(s);
}

string detail_ranken( string key)
{
  string s;

  switch(nranken)
  {
    case 0:
      s ="Die Schlingpflanzen sind derart mit dem Unterholz verfilzt, dass "
         "Du die einzelnen Ranken nicht voneinander trennen kannst.";
      break;

    case 1:
      s = "Du findest eine Ranke, die Du vielleicht abreissen koenntest.";
      break;

    default:
      s = "Du findest mehrere Ranken, Die du vielleicht abreissen koenntest.";
      break;
  }

  return BS(s);
}

int cmd_reissen(string str)
{
  object obj;

  notify_fail("Was moechtest Du abreissen?\n");

  if(!str || str == "") return 0;
  if(!(str == "ranke ab"         ||
       str == "ranken ab"        ||
       str == "ranke"            ||
       str == "ranken"           ||
       str == "an ranke"         ||
       str == "an ranken"        )) return 0;

  if(nranken <= 0)
  {
    TELLPLAYER(BS("Die Ranken sind so stark miteinander verfilzt, dass Du "
                  "keine von ihnen abreissen kannst."));
    return -1;
  }

  if(present("RWQ_Kleber",TP))
  {
    TELLPLAYER(BS("Du hast erstmal genug Kleber an Dir und laesst von "
                  "Deinem Vorhaben ab."));
    return -1;
  }

  if(sizeof(TP->QueryProp(P_HANDS_USED_BY)) != 0)
  {
    TELLPLAYER("Du musst schon beide Haende frei haben, um die Ranken "
               "abreissen zu koennen.\n");
    return -1;
  }

  TELLPLAYER(BS("Du reisst heftig an der Ranke, aber Du kannst sie "
                "nicht abreissen. Stattdessen zerdrueckst Du einige der "
                "Fasern, und aus dem verletzten Gewebe tritt ein weisslicher, "
                "dicker Saft aus, der Dir Deine Haende verklebt."));

  TELLOTHERS(BS(TP->Name(WER) + " reisst heftig an einer Ranke, kann sie "
                "allerdings nicht abreissen. Stattdessen tritt klebriger "
                "Saft aus und verklebt " + TP->name(WEN, 2) + "."));

  RWQMASTER->Msg(TPUID+" reisst Ranken ab und wird verklebt.");
  RWQMASTER->GetTwines();

  obj = clone_object(OBJ "rwq_kleber");
  obj->move(TP,M_NOCHECK|M_GET);
  obj->StartMessage(TP);

  nranken--;
  return 1;
}

int cmd_schneiden(string str)
{
  object ranke, weapon;
  int i,meldung;

  notify_fail("Was moechtest Du abschneiden?\n");

  if(!str || str == "") return 0;
  if(!(str == "ranke ab"         ||
       str == "ranken ab"        ||
       str == "ranke"            ||
       str == "ranken"           ||
       str == "an ranke"         ||
       str == "an ranken"        )) return 0;

  if(nranken <= 0)
  {
    TELLPLAYER(BS("Du findest in dem Gebuesch keine Ranken, die Du "
                  "abschneiden koenntest."));
    return -1;
  }

  if(!(weapon = TP->QueryProp(P_WEAPON)))
  {
    TELLPLAYER("Du hast ja gar nichts zum Schneiden in der Hand!\n");
    return -1;
  }

  if(!(weapon->QueryProp(P_WEAPON_TYPE) == WT_KNIFE  ||
       weapon->QueryProp(P_WEAPON_TYPE) == WT_SWORD  ))
  {
    TELLPLAYER("Du hast ja gar nichts zum Schneiden in der Hand!\n");
    return -1;
  }

  TELLPLAYER(BS("Geschickt schneidest Du alle Ranken ab, ohne dass groessere "
                "Mengen des klebrigen Saftes austreten. "));

  TELLOTHERS(BS(TP->Name(WER) + " schneidet geschickt alle Ranken "
                "heraus."));

  RWQMASTER->Msg(sprintf("%s schneidet sich %d Ranken ab.",TPUID,nranken));

  meldung = 1;
  i       = nranken;


  while(i--)
  {
    ranke = clone_object(OBJ "rwq_ranke");

    if(ranke->move(TP,M_GET) != 1)
    {
      if(meldung)
      {
        TELLPLAYER(BS("Die Ranken sind Dir jedoch zu schwer und so legst "
                      "Du einige erstmal ab."));
        meldung = 0;
      }
      ranke->move(TO,M_NOCHECK|M_SILENT);
    }
  }

  nranken = 0;

  return 1;
}

int cmd_event(string str)
{
  notify_fail("Wie bitte?\n");

  if(!IS_WIZARD(TP)) return 0;

  if(propability ==0)
  {
    tell_object(TP,BS("Die Wahrscheinlichkeit fuer Rumpelwichte betraegt "
                      "hier 0%. Der Event wird trotzdem ausgeloest. "));
    einbrechen = MOEGLICH;
  }

  call_out("einbrechen",0,TP);

  return 1;
}

void wicht(object player,int num)
{
  object wicht;
  string s;

  wicht = clone_object(NPC "rumpelwicht");
  wicht->move(TO,M_GO,"","","kommt aus dem Loch gekrochen");
  player->AddPursuer(wicht);

  num++;
  if(num < 4)
  {
    call_out("wicht",2,player,num);
  }
  else
  {
    if(IS_WIZARD(player))
    {
      s = "*** Spielerlaehmung Ende ***\n";
      if(TP->QueryProp(P_TTY))
      {
        s = ANSI_BOLD+ANSI_RED+s+ANSI_NORMAL;
      }
      tell_object(TP,s);
    }
  }
}

void einbrechen(object player)
{
  string s;

  if(!present(player))             return;
  if(einbrechen == NICHT_MOEGLICH) return;

  loch       = OFFEN;
  einbrechen = NICHT_MOEGLICH;
  einbrecher = getuid(player);

  SWMASTER->Msg(CAP(einbrecher)+" bricht in das Rumpelwichtloch ein");

  tell_object(player,
    BS("Du brichst mit einem Fuss in ein Erdloch ein. Na hoffentlich hast Du "
       "jetzt keine Rumpelwichte aufgeschreckt, denn die reden Dir bestimmt "
       "ein Ohr ab. ")
  );

  tell_room(TO,
    BS(TPN+" bricht mit einem Fuss in ein Erdloch ein."), ({player})
  );

  player->SetProp(P_PARALYZED,
        ([PARALYZE_TIME: 15,
          PARALYZE_MSG: "Dein Fuss steckt in einem Erdloch fest.\n",
          PARALYZE_MSG_OTHER: "steckt mit einem Fuss in einem Loch in der Erde fest.\n",
          PARALYZE_END: "Du hast Deinen Fuss wieder freibekommen.\n",
          PARALYZE_END_OTHER: TPN+" kann sich aus dem Loch wieder befreien.\n"]));

  if(IS_WIZARD(player))
  {
    s = "*** Spielerlaehmung Start ***\n";
    if(TP->QueryProp(P_TTY))
    {
      s = ANSI_BOLD+ANSI_RED+s+ANSI_NORMAL;
    }
    tell_object(TP,s);
  }

  call_out("wicht",2,player,0);
}


