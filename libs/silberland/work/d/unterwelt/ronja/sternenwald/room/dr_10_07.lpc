#include "../def.h"

inherit ROOM "inh_dryaden";

void create()
{
  ::create();

  ltext  = "eine majestaetische Linde, von der";
  stext1 = "Eine gewaltige, uralte Linde";
  stext2 = "der grossen Linde";
  key    = ({"linde","baum"});

  Customize();

  AddExit("norden",     ROOM "dr_09_07");
  AddExit("nordosten",  ROOM "dr_09_08");
  AddExit("osten",      ROOM "dr_10_08");
  AddExit("sueden",     ROOM "fr_11_07");
  AddExit("westen",     ROOM "wr_10_06");
  AddExit("nordwesten", ROOM "wr_09_06");
}
