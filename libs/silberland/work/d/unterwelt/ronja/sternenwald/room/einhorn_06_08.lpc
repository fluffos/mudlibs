#include "../def.h"

inherit "std/room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Einhornhuegel" );
  SetProp( P_INT_LONG,
    "Du trittst auf einen flachen, mit langem, duftendem Gras bewachsenen "
    "Huegel hinaus. Er ist perfekt rund und an seinem hoechsten Punkt "
    "trohnt wie eine Krone ein einzelner Rosenbusch. Seine grossen "
    "reinweissen Blueten leuchten wie Silber im Sternenlicht. Die "
    "heilige Aura dieses Ortes laesst Dich erschaudern. "
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HILL]) );

  AddDetail( ({ "boden" }),
     "Hier loest langes, duftendes Gras die allgegenwaertigen Moospolster"
     " ab.");
  AddDetail( ({ "gras" }),
     "Das Gras ist seidigweich und saftig - es wogt und wispert, wenn"
     " ein Luftzug darueber faehrt.");
  AddDetail( ({ "luftzug" }),
     "Manchmal spuerst Du einen leichten Luftzug.");
  AddDetail( ({ "himmel" }),
     "Hier kannst du den sternenuebersaehten Himmel gut sehen.");
  AddDetail( ({ "moos", "moospolster" }),
     "Sonst waechst in diesem Wald fast nur Moos auf dem Boden.");
  AddDetail( ({ "sternenlicht", "licht", "sterne", "stern" }),
     "Der Wald ist nach den Sternen benannt, die ewig ueber ihm schimmern"
     " und ihn in ihrem silbernen Licht baden.");
  AddDetail( ({ "sternenwald", "ort", "wald" }),
     "Dies ist der wunderschoene Sternenwald - ein mythischer Ort voller"
     " tiefer Geheimnisse und wundersamer Wesen.");
  AddDetail( ({ "geheimnisse", "geheimnis" }),
     "Das musst Du schon selber herausfinden ...");
  AddDetail( ({ "wesen" }),
     "Wunderbare Wesen kannst Du in diesem Wald antreffen. - Eines"
     " davon lebt auf diesem Huegel.");
  AddDetail( ({ "huegel", "ort","einhornhuegel" }),
     "Dies ist der wunderschoene und heilige Einhornhuegel.");
  AddDetail( ({ "punkt","krone" }),
     "Am hoechsten Punkt des Huegels drohnt ein Rosenbusch.");
  AddDetail( ({ "busch", "rosenbusch" }),
     "Der Rosenbusch traegt grosse, reinweisse, absolut perfekte Blueten,"
     " die einen berauschenden Duft verstroemen.");
  AddDetail( ({ "blueten", "bluete", "rosenblueten", "rosenbluete",
                "rose", "rosen", "duft" }),
     "Die weissen Rosenblueten schimmern silbern im Sternenlicht und"
     " sind so atemberaubend schoen, dass Du sie am liebsten ewig"
     " betrachten moechtest.");
  AddDetail( ({ "silber" }),
     "Wie aus feinstem Silber geschmiedet schimmern die Rosenblueten im"
     " Sternenlicht.");
  AddDetail( ({ "aura" }),
     "Du merkst sofort, dass dies ein besonderer Ort ist.");

  AddSound( DEFAULT_SOUND,
     "Von Zeit zu Zeit wispert ein Luftzug durch das Gras -"
     " ansonsten herrscht eine fast ehrfurchtgebietende Stille." );

  AddSound( ({ "luftzug", "gras" }),
     "Leise wispert das Gras wenn ein Luftzug hindurch faehrt." );
  AddSound( ({ "stille" }),
     "pssssssssssst ..." );

  AddSmell( DEFAULT_SMELL,
     "Es riecht berauschend nach Rosenblueten.");

  AddSmell( ({ "rosen", "rosenblueten", "duft", "blueten", "rose", "bluete" }),
     "Suess und berauschend umschwebt Dich der Duft der Rosen.");


  AddExit("suedwesten", ROOM "wr_07_07");

  AddItem(NPC "weinhorn", REFRESH_DESTRUCT);
  AddItem(OBJ "uschild",  REFRESH_DESTRUCT);

}

public void init() {
   ::init();
 
   if(interactive(this_player())) {
     check_bard_awf_quest(this_player());
   }
 }
