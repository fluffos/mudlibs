#include "../def.h"

inherit ROOM "inh_felsraum.lpc" ;

int    *scheibe;
string *line;

create()
{
  ::create();

  SetProp(P_INT_LONG,
     "Du stehst auf einem schmalen Pfad, der um den grossen Sternenwald "
     "herumfuehrt. Auf einer Seite ragt eine hohe Felswand aus schwarzem "
     "Vulkangestein ueber Dir auf, auf der anderen erheben sich die "
     "majestaetischen Baumriesen des Sternenwaldes in den Nachthimmel. "
     "Mitten in der Felswand erkennst Du ein Artefakt. "
  );

  AddSpecialDetail( ({"scheibe","scheiben"}) , "detail_scheiben" );

//  AddCmd( ({"dreh","drehe"})                        , "cmd_drehen");
//  AddCmd( ({"werf","werfe","wirf","steck","stecke"}), "cmd_werfen");

  AddExit("norden", ROOM "wr_10_06");
  AddExit("osten",  ROOM "fr_11_07");
  AddExit("sueden", ROOM "greif_12_06");
  AddExit("westen", ROOM "fr_11_05");

  scheibe = ({ random(3), random(3), random(3) });
  scheibe = ({ 0,1,2 });

  while((scheibe[0] == scheibe[1]) && (scheibe[1] == scheibe[2]))
  {
    scheibe = ({ random(3), random(3), random(3) });
  }
}

void DrawCircle(int snum, int pos)
{
  int c,l;

  switch(pos)
  {
    case 0 : l =  5; c =  6; break;
    case 1 : l =  9; c =  9; break;
    case 2 : l =  9; c =  3; break;
  }

  c += snum*20;

  line[l+0][c  ..c+2] = "/^\\";
  line[l+1][c  ..c+2] = "'-'";
}

void DrawSquare(int snum, int pos)
{
  int c,l;

  switch(pos)
  {
    case 0 : l =  8; c =  9; break;
    case 1 : l =  8; c =  3; break;
    case 2 : l =  3; c =  6; break;
  }

  c += snum*20;

  line[l+0][c  ..c+2] = " _ ";
  line[l+1][c  ..c+2] = "|_|";
}

void DrawX(int snum, int pos)
{
  int c,l;

  switch(pos)
  {
    case 0 : l =  8; c =  0; break;
    case 1 : l =  3; c =  6; break;
    case 2 : l =  8; c = 12; break;
  }

  c += snum*20;

  line[l+0][c  ..c+3] = "\\\\//";
  line[l+1][c  ..c+3] = " XX ";
  line[l+2][c  ..c+3] = "//\\\\";
}

string detail_scheiben(string str)
{
  string s,l,digit;
  int i,j,k;

  line = ({});
//                       1         2         3         4         5
//             012345678901234567890123456789012345678901234567890123456789
  for(i=0;i<14;i++)
    line += ({"                                                            "});

  k = 0;
  for(i=0;i<3;i++)
  {
    line[ 0][k  ..k+15] = "        __      ";
    line[ 1][k  ..k+15] = "        \\/      ";
    line[ 4][k  ..k+15] = "    .-'\"\"'-.    ";
    line[ 5][k  ..k+15] = "  .'        '.  ";
    line[ 6][k  ..k+15] = " /            \\ ";
    line[ 7][k  ..k+15] = ";              ;";
    line[ 8][k  ..k+15] = ";              ;";
    line[ 9][k  ..k+15] = " \\            / ";
    line[10][k  ..k+15] = "  '.        .'  ";
    line[11][k  ..k+15] = "    '-....-'    ";

    k+=20;
  }

  k = 0;
  for(i=0;i<3;i++)
  {
    DrawCircle(i,scheibe[i]);
    DrawSquare(i,scheibe[i]);
    DrawX(i,scheibe[i]);
  }

  s = "";
  for(i=0;i<14;i++) s += line[i]+"\n";

  s += BS("In der Wand befinden sich drei Scheiben, welche jeweils drei Symbole "
          "haben. Unterhalb jeder Scheibe befindet sich ein Loch und so etwas "
          "wie eine Auffangschale. ");

  return s;
}

int cmd_werfen(string str)
{
  int n,lochnum;
  string was;

  notify_fail("Was moechtest Du wohinein werfen?\n");

  if(!str || str == "") return 0;

           n = sscanf(str,"%s in loch %d",was,lochnum);
  if(n!=2) n = sscanf(str,"%s in loch nummer %d",was,lochnum);
  if(n!=2) return 0;

  if(!(was == "kugel" || was == "kupferkugel")) return 0;
  if(lochnum < 1 || lochnum > 3) return 0;

  switch(lochnum)
  {
    case 1 :
      if(++scheibe[0] > 2) scheibe[0] = 0;
      if(++scheibe[1] > 2) scheibe[1] = 0;
      break;

    case 2 :
      if(++scheibe[0] > 2) scheibe[0] = 0;
      if(++scheibe[1] > 2) scheibe[1] = 0;
      if(++scheibe[2] > 2) scheibe[2] = 0;
      break;

    case 3 :
      if(++scheibe[1] > 2) scheibe[1] = 0;
      if(++scheibe[2] > 2) scheibe[2] = 0;
      break;
  }

  return 1;
}

