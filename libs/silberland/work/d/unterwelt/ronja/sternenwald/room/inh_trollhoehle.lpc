#include "../def.h"

inherit ROOM "inh_sternenwald";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Hoehle der Juwelentrolle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer grossen Hoehle aus schwarzem "
    "Vulkangestein. Decke und Waende kannst Du allerdings kaum erkennen, "
    "da sie dicht mit den Ranken einer seltsamen Pflanze bewachsen sind. "
    "Die Pflanze ueberwuchert die Waende voellig, ueberzieht die Decke mit "
    "einem dichten Baldachin, von dem unzaehlige Ranken haengen. Das "
    "Seltsamste jedoch ist, dass die ganze Pflanze mit einem intensiven "
    "hellgruenen Licht die ganze Hoehle ausleuchtet. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist ebenfalls von der Pflanze bewachsen, aber laengst "
    "nicht so dicht wie Decke und Waende. Ausserdem kannst Du ueberall "
    "am Boden zerdrueckte Teile der Pflanze sehen. Etwas sehr schweres "
    "scheint hier regelmaessig durch die Hoehle zu stapfen.");
  AddDetail( ({ "pflanze" }),
    "Die Pflanze hat lange Ranken, die zwischen armdick und so fein "
    "wie ein Haar sind. Die Blaetter sind klein aber sehr zahlreich. "
    "Die ganze Pflanze strahlt in einem starken hellgruenen Licht. ");
  AddDetail( ({ "teile", "teil" }),
    "Hauptsaechlich Ranken und Blaetter.");
  AddDetail( ({ "hoehle" }),
    "Du befindest Dich gerade in einer Hoehle.");
  AddDetail( ({ "ranken", "ranke", "blaetter", "blatt" }),
    "Ein Teil der Pflanze, die die ganze Hoehle ueberwuchert.");
  AddDetail( ({ "haar" }),
    "Nun, ich nehme doch an, dass Du welches hast ... irgendwo ;).");
  AddDetail( ({ "licht" }),
    "Das Licht ist hellgruen und leuchtet die ganze Hoehle aus.");
  AddDetail( ({ "decke" }),
    "Die Decke ist ziemlich hoch oben, wirkt aber durch den dichten "
    "Bewuchs und die herunterhaengenden Ranken viel naeher.");
  AddDetail( ({ "bewuchs" }),
    "Die Pflanze bildet einen dichten Bewuchs in der ganzen Hoehle.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind von der Pflanze komplett ueberwuchert.");
  AddDetail( ({ "gestein", "vulkangestein" }),
    "Tief schwarzes, zum Teil poroeses, zum Teil aber auch fast "
    "glasartiges Vulkangestein.");
  AddDetail( ({ "baldachin" }),
    "Wie ein schwerer Baldachin zieht sich die Pflanze quer ueber die "
    "Decke und verbirgt sie voellig.");

  AddSound( DEFAULT_SOUND,
    "In der Hoehle ist es so still, dass Du fast glaubst, die "
    "Pflanze wachsen zu hoeren." );

  AddSound( ({ "pflanze" }),
    "Naja, da hast Du Dich dann wohl doch getaeuscht ..." );
}

