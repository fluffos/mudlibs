#include "../def.h"

inherit ROOM "inh_dryaden";

void create()
{
  ::create();

  ltext  = "ein majestaetischer Nussbaum, von dem";
  stext1 = "Ein gewaltiger, uralter Nussbaum";
  stext2 = "dem grossen Nussbaum";
  key    = ({"nussbaum","baum"});

  Customize();

  AddExit("norden",     ROOM "dr_08_08");
  AddExit("osten",      ROOM "fr_09_09");
  AddExit("suedosten",  ROOM "fr_10_09");
  AddExit("sueden",     ROOM "dr_10_08");
  AddExit("suedwesten", ROOM "dr_10_07");
  AddExit("westen",     ROOM "dr_09_07");
  AddExit("nordwesten", ROOM "dr_08_07");
}
