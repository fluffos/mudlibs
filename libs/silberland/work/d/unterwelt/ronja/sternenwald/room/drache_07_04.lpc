#include "../def.h"

inherit ROOM "inh_sternenwald";

#define MAX_HEILUNG 500
#define RESET_HEILUNG 100

#define FAKTOR_HEILUNG_D  9
#define FAKTOR_HEILUNG_X 13

int heilung, geld;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Die Regenbogenlichtung" );
  SetProp(P_INT_LONG,
    "Du stehst auf einer grossen Lichtung in deren Mitte sich ein glattes "
    "Steinbecken befindet. Aus seinem Inneren jagt mit einem Tosen immer "
    "wieder eine Wasserfontaene hoch in die Luft. Die Wassertroepfchen "
    "schimmern in allen Farben - seltsam eigentlich - es gibt hier ja "
    "nur silbernes Sternenlicht! Trotzdem ist es so. Wie ein riesiger "
    "Regenbogen, der hier den Boden beruehrt, haengen die schillernden "
    "Farben in der Luft...");

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "boden" }),
     "Der Boden ist mit federndem Moos ueberzogen. In der Mitte der"
     " Lichtung befindet sich ein weites Steinbecken.");
  AddDetail( ({ "mitte" }),
     "Naja, in der Mitte eben ...");
  AddDetail( ({ "himmel" }),
     "Hier kannst du den sternenuebersaehten Himmel gut sehen.");
  AddDetail( ({ "lichtung", "regenbogenlichtung", "ort" }),
     "Dies ist wohl die sagenhafte Regenbogenlichtung.");
  AddDetail( ({ "becken", "steinbecken" }),
     "Ein grosses, weites Becken aus glattem, schwarzem Stein. Auf dem "
     "Boden des Beckens kannst Du jede Menge Muenzen erkennen. "
  );

  AddDetail( ({"muenzen"}) ,
    "Es sind ganz normale Muenzen."
  );

  AddDetail( ({"menge"}) ,
    "Viele, viele Muenzen."
  );

  AddDetail( ({ "stein", "vulkangestein" }),
     "Wohl dasselbe Vulkangestein, aus dem auch die Felswand ist,"
     " die diesen Wald umschliesst.");
  AddDetail( ({ "felswand" }),
     "Dort bist Du bestimmt vorbeigekommen.");
  AddDetail( ({ "moos" }),
     "Das Moos ist weich und wo es vom Sternenlicht beruehrt wird, schimmert"
     " es silbrig.");
  AddDetail( ({ "sternenlicht", "licht", "sterne", "stern" }),
     "Der Wald ist nach den Sternen benannt, die ewig ueber ihm schimmern"
     " und ihn in ihrem silbernen Licht baden.");
  AddDetail( ({ "sternenwald", "ort", "wald" }),
     "Dies ist der wunderschoene Sternenwald - ein mythischer Ort voller"
     " tiefer Geheimnisse und wundersamer Wesen.");
  AddDetail( ({ "geheimnisse", "geheimnis" }),
     "Das musst Du schon selber herausfinden ...");
  AddDetail( ({ "wesen" }),
     "Wunderbare Wesen kannst Du in diesem Wald antreffen. - Eines davon"
     " lebt auf dieser Lichtung.");
  AddDetail( ({ "inneres" }),
     "Aus dem Inneren des Steinbeckens schiesst Wasser empor.");
  AddDetail( ({ "wasser", "fontaene", "wasserfontaene" }),
     "Das Wasser schillert in allen Farben.");
  AddDetail( ({ "farbe", "farben" }),
     "Alle Farben des Regenbogens ...");
  AddDetail( ({ "regenbogen" }),
     "Dieser Ort wird nicht umsonst die Regenbogenlichtung genannt.");
  AddDetail( ({ "wassertroepfchen", "troepfchen" }),
     "Winzige Troepfchen schillern wie Juwelen in allen Farben.");
  AddDetail( ({ "juwel", "juwelen" }),
     "Hast Du noch nie Juwelen gesehen?");
  AddDetail( ({ "luft" }),
     "Die Luft ist voller schillernder Farben.");

  AddSound( DEFAULT_SOUND,
     "Du hoerst das Tosen des Wassers." );

  AddSound( ({ "tosen", "wasser" }),
     "Es ist recht laut hier." );

  AddCmd(CMD_NEHMEN, "cmd_nehmen");
  AddCmd(CMD_WERFEN, "cmd_werfen");

  AddExit("norden",     ROOM "wr_06_04");
  AddExit("nordosten",  ROOM "wr_06_05");
  AddExit("osten",      ROOM "wr_07_05");
  AddExit("suedosten",  ROOM "wr_08_05");
  AddExit("sueden",     ROOM "wr_08_04");
  AddExit("suedwesten", ROOM "wr_08_03");
  AddExit("westen",     ROOM "wr_07_03");
  AddExit("nordwesten", ROOM "wr_06_03");

  AddItem(NPC "drache", REFRESH_DESTRUCT);
  AddItem(OBJ "dschild",REFRESH_DESTRUCT);

  heilung = MAX_HEILUNG;
  geld = 0;
}

void reset()
{

  heilung += RESET_HEILUNG;
  if(heilung > MAX_HEILUNG) heilung = MAX_HEILUNG;

  if(geld)
  {
    "p/daemon/zentralbank"->PayIn(geld, 100);
    geld = 0;
  }

  ::reset();
}

int cmd_nehmen(string str)
{
  notify_fail("Was moechtest Du woraus nehmen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "muenze aus becken"         ||
       str == "muenzen aus becken"        ||
       str == "muenze aus steinbecken"    ||
       str == "muenzen aus steinbecken"   )) return 0;

  TELLPLAYER(BS("Du streckst Deine Hand aus, um in das Wasser zu greifen "
                "und ein paar Muenzen zu nehmen. Als Deine Hand das Wasser "
                "beruehrt, durchfaehrt Dich ein rasender Schmerz."
  ));

  TELLOTHERS(BS(CTPN+" streckt "+QueryPossPronoun(FEMALE,WEN,SINGULAR)+" Hand "
                "aus um in das Becken zu greifen, zieht die Hand jedoch "
                "ruckartig und mit schmerzerfuelltem Gesichtsausdruck wieder "
                "zurueck."
  ));

  if(TP->QueryProp(P_LEVEL) < 15)
  {
    TP->AddHp(-500);
    TELLPLAYER(BSI("Deine Gier wird Dich eines Tages vergiften und Dich "
                   "vernichten. ","Eine Stimme in Deinem Kopf droehnt: "));
    SWMASTER->Msg(TPUID+" bekommt am Steinbecken alle HP abgezogen");
  }
  else
  {
    TP->AddPoison(5);
    TELLPLAYER(BSI("Deine Gier hat Dich bereits innerlich vergiftet. Moege "
                   "diese Vergiftung real werden!","Eine Stimme droehnt in "
                   "deinem Kopf: "));
    SWMASTER->Msg(TPUID+" wird am Steinbecken vergiftet");
  }
  return 1;
}

int cmd_werfen(string str)
{
  int besitz,menge,syntaxok,heil_menge;
  string was,wohin;
  object room,drache,einhorn;

  notify_fail("Was moechtest Du wo hinein werfen?\n");
  if(!str || str == "") return 0;

  syntaxok = 0;

  if(!syntaxok && sscanf(str,"%d %s in %s",menge,was,wohin) == 3)
  {
    syntaxok = 1;
  }

  if(!syntaxok && sscanf(str,"%s in %s",was,wohin)==2)
  {
    menge = (was == "muenze") ? 1 : TP->QueryMoney();
    syntaxok = 1;
  }

  if(!syntaxok) return 0;
  if(!(wohin == "becken" || wohin == "steinbecken"))
  {
    TELLPLAYER("Wo hinein moechtest Du etwas werfen?\n");
    return 1;
  }

  if(!(was == "muenze" || was == "muenzen"))
  {
    TELLPLAYER("Du ueberlegst es Dir doch noch anders.\n");
    return 1;
  }

  besitz = TP->QueryMoney();
  if(!besitz)
  {
    TELLPLAYER("Du hast ja gar keine Muenzen!\n");
    return 1;
  }

  if(menge <= 0)
  {
    TELLPLAYER("Du wirfst doch nichts in das Becken.\n");
    return 1;
  }

  if(menge > besitz)
  {
    TELLPLAYER("Soviele Muenzen hast Du ja gar nicht!\n");
    return 1;
  }

  drache=present("astabegetazztrax",TO);
  if(drache && drache->IsEnemy(TP))
  {
    if(menge>1)
    {
      TELLPLAYER("Du wirfst "+menge+" Muenzen in das Becken, aber nichts "
                 "passiert.\n");
    }
    else
    {
      TELLPLAYER("Du wirfst eine Muenze in das Becken, aber nichts "
                 "passiert.\n");
    }
    TELLOTHERS(CTPN+" wirft etwas in das Steinbecken.\n");

    SWMASTER->Msg(sprintf("%s will im Kampf gegen den Regenbogendrachen "
                        "%d Muenzen opfern",TPUID,menge)
    );

    return 1;
  }

  call_other(ROOM "einhorn_06_08","???");
  room = find_object(ROOM "einhorn_06_08");
  if(objectp(room)) einhorn = present("\nWEISSESEINHORN",room);
  if(objectp(einhorn) && einhorn->IsEnemy(TP))
  {
    if(menge>1)
    {
      TELLPLAYER("Du wirfst "+menge+" Muenzen in das Becken, aber nichts "
                 "passiert.\n");
    }
    else
    {
      TELLPLAYER("Du wirfst eine Muenze in das Becken, aber nichts "
                 "passiert.\n");
    }
    TELLOTHERS(CTPN+"+ wirft etwas in das Steinbecken.\n");
    SWMASTER->Msg(sprintf("%s will im Kampf gegen das weisse "
                        "Einhorn %d Muenzen opfern",TPUID,menge)
    );
    return 1;
  }

  TP->AddMoney(-menge);
  geld += menge;

  if(TP->QueryProp(P_RACE) == "Dunkelelf")
  {
    heil_menge = menge / FAKTOR_HEILUNG_D;
  }
  else
  {
    heil_menge = menge / FAKTOR_HEILUNG_X;
  }

  if(heil_menge > heilung) heil_menge = heilung;
  heilung -= heil_menge;
  SWMASTER->Msg(sprintf("%s opfert %d Muenzen und erhaelt %d "
                      "Heilung",TPUID,menge,heil_menge));

  if(heil_menge > 0)
  {
    TELLPLAYER("Eine wundersame Kraft durchfaehrt Dich.\n");
    TP->heal_self(heil_menge);
  }
  else
  {
    if(menge == 1)
    {
      TELLPLAYER("Die Muenze versinkt mit einem leisen *PLOPP* im "
                 "Steinbecken.\n");
    }
    else
    {
      TELLPLAYER("Die Muenzen versinken mit einem leisen *PLOPP* im "
                 "Steinbecken.\n");
    }
  }

  return 1;
}

