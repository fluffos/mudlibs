#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Greifenfelsen" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einem tiefen Felskessel. Vor Dir "
    "erhebt sich ein fast voellig regelmaessiger Quader aus Obsidian. "
    "Seine tiefschwarzen Seiten sind so spiegelglatt, dass Du Dich darin "
    "betrachten kannst. Der Felskessel ist sehr karg, hat dabei aber "
    "eine seltsame Schoenheit. Du fuehlst Dich an die kuehle Eleganz "
    "einer Schwertklinge oder an die simple Aesthetik eines Eiszapfen "
    "erinnert ...");

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_MOUNTAIN]) );

  AddDetail( ({ "boden", "grund" }),
     "Der Boden ist aus dem selben schwarzen Gestein wie die Felswand.");
  AddDetail( ({ "wand", "felswand" }),
     "Die Felswand ragt rings um Dich auf. Das Gestein ist glatt und"
     " tiefschwarz.");
  AddDetail( ({ "gestein", "vulkangestein", "felsen", "fels" }),
     "Tief schwarzes, zum Teil poroeses, zum Teil aber auch fast"
     " glasartiges Vulkangestein.");
  AddDetail( ({ "himmel" }),
     "Du kannst einen kleinen Ausschnitt des sternenuebersaehten Himmels"
     " sehen.");
  AddDetail( ({ "ausschnitt" }),
     "In diesem tiefen Felskessel kannst du nicht viel vom Himmel sehen.");
  AddDetail( ({ "felskessel", "kessel" }),
     "Die Felswand bildet hier einen tiefen Kessel, auf dessen Grund Du"
     " stehst.");
  AddDetail( ({ "quader" }),
     "Ein grosser Quader mit glaenzend schwarzen Seiten und scharfen"
     " Kanten.");
  AddDetail( ({ "seiten", "kanten" }),
     "Die machen einen Quader gewoehnlich aus.");
  AddDetail( ({ "obsidian" }),
     "Obsidian ist schwarzes, scharfkantiges, glasartiges Vulkangestein.");
  AddDetail( ({ "schoenheit", "eleganz", "aesthetik" }),
     "Obwohl der Felskessel sehr karg ist, ist er doch seltsam schoen.");
  AddDetail( ({ "schwertklinge", "schwert", "klinge" }),
     "Wenn Du irgendwann einmal ein Schwert gesehen hast, weisst Du, was"
     " ich meine.");
  AddDetail( ({ "eiszapfen", "zapfen" }),
     "Glitzernde Eiszapfen sind doch sehr schoen, oder?");

  AddSpecialDetail( ({ "bild","spiegelbild"}),       "detail_spiegelbild");

  AddSound( DEFAULT_SOUND,
     "Es herrscht eine fast ehrfurchtgebietende Stille." );

  AddSound( ({ "stille" }),
     "pssssssssssst ..." );

  AddCmd( ({"betrachte","betracht","schau","schaue"})  , "cmd_betrachten");

  AddExit( "norden", ROOM "fr_11_06");
}

string detail_spiegelbild(string str)
{
  string s, *armours;
  object waffe;

  s = "Eitel wie Du bist, betrachtest Du Dir Dein Spiegelbild. ";

  if(TP->QueryProp(P_GHOST))
  {
    s += "Du siehst im Moment recht geisterhaft aus. ";
  }
  else if(TP->QueryProp(P_FROG))
  {
    s += "Du siehst im Moment aus wie ein Frosch. ";
  }
  else
  {
    s += "Du bist fuer "+TP->QueryArticle(WEN,0,1)+
         TP->_query_racestring()[WEN];

    switch(1000*TP->QueryProp(P_SIZE)/TP->QueryProp(P_AVERAGE_SIZE))
    {
      case 0..800:     s += " ziemlich winzig. "; break;
      case 801..850:   s += " eher winzig. "; break;
      case 851..900:   s += " recht klein. "; break;
      case 901..950:   s += " eher klein. "; break;
      case 951..1050:  s += " mittelgross. "; break;
      case 1051..1100: s += " relativ gross. "; break;
      case 1101..1150: s += " ziemlich gross. "; break;
      case 1151..1200: s += " sehr gross. "; break;
      default:         s += " riesig. "; break;
    }
  }

  armours = map_objects(TP->QueryProp(P_ARMOURS),"name",WEN);
  if(sizeof(armours) == 0)
  {
    s += "Du bist nackt. ";
  }
  else
  {
    s += "Du traegst "+LW(armours)+". ";
  }

  if((waffe=TP->QueryProp(P_WEAPON)))
  {
    s += "Du hast "+waffe->name(WEN,0)+" gezueckt. ";
  }

  return BS(s);
}

int cmd_betrachten(string str)
{
  notify_fail("Was moechtest Du betrachten?\n");

  if(!str || str == "") return 0;
  if(!(str == "bild"           ||
       str == "spiegelbild"    ||
       str == "bild an"        ||
       str == "spiegelbild an" ||
       str == "dich an"        ||
       str == "mich an"        )) return 0;

  TELLPLAYER(detail_spiegelbild(""));
  TELLOTHERS(TPN+" betrachtet eitel "+TPPP(NEUTER,WEN,SINGULAR)+
             " Spiegelbild. \n");
  return 1;
}


