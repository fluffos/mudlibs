#include "../def.h"

inherit ROOM "inh_waldraum";

string ltext,stext1,stext2,*key;
int dryade_da;
int raupen;

void Customize();

void create()
{
  ::create();

  ltext   = "ein besonders majestaetischer Baum, von dem";
  stext1  = "Ein gewaltiger, uralter Baum";
  stext2  = "dem grossen Baum";
  key     = ({"baum"});

  AddDetail( ({ "dryade", "baumgeist" }),
    "Eine Dryade ist ein maechtiger Baumgeist. Normalerweise sieht man sie "
    "so gut wie nie, nur wenn ihr Baum bedroht ist, kommen sie hervor."
  );

  AddDetail( ({"krone","baumkrone","kronen","baumkronen"}) ,
    "Die Kronen der Baeume sind weit ueber Dir. Da - scheint sich in "
    "einer der Kronen nicht etwas zu verstecken?"
  );

  AddDetail( ({"etwas"}) ,
    "Fuer einen kurzen Moment hast Du geglaubt, in einer der Baumkronen "
    "wuerde sich etwas verstecken."
  );

  AddDetail( ({"moment"}) ,
    "Zack - schon vorbei."
  );

  AddSpecialDetail( ({"raupe","raupen"}) , "detail_raupen");
  Customize();

  AddCmd( ({"bedroh","bedrohe"})        , "cmd_bedrohen");
  AddCmd( ({"faell","faelle"})          , "cmd_faellen");
  AddCmd( ({"schuettel","schuettele","schuettle","schuettl"})
                                        , "cmd_schuetteln");
  dryade_da = 1;

  raupen = random(3);
}

string _query_int_long()
{
  string s;

  s = "Du stehst mitten im riesigen Sternenwald. Gewaltige Baeume ragen "
      "rings um Dich in den Himmel und scheinen die Sterne zu beruehren, "
      "die diesem Wald den Namen gegeben haben. Hier, unter den Baumkronen "
      "ist es fast voellig dunkel. Nur hin und wieder dringt das "
      "Sternenlicht durch das dichte Blaetterdach und versilbert den Wald. "
      "Besonders auffaellig ist "+ltext+" ein ganz besonderer Zauber "
      "auszugehen scheint." ;

  return BS(s);
}

void Customize()
{
  AddSpecialDetail( key , "detail_baum" );

  AddDetail( ({ "zauber", "naturzauber" }),
    "Starker Naturzauber scheint hier zu wirken - das liegt wohl daran, "
    "dass in "+stext2+" eine Dryade wohnt.");

}

int check_if_player(object ob)
{
  return (interactive(ob) && !(ob->QueryProp(P_INVIS)));
}

void reset()
{
  ::reset();
  dryade_da = 1;
  raupen = random(3);
}

string detail_baum(string str)
{
  string s;

  if(raupen > 0)
  {
    s = stext1 + " - ein Baum einer Dryade wuerdig! Auf einigen Blaettern "
        "siehst Du ein paar Raupen sitzen. ";
  }
  else
  {
    s = stext1 + " - ein Baum einer Dryade wuerdig!";
  }

  return BS(s);
}

string detail_raupen(string str)
{
  string s;

  if(raupen > 0)
  {
    s = "Du kannst sie so gerade von hier unten erkennen. Wenn Du sie naeher "
        "untersuchen willst, musst Du sie irgendwie herunterbekommen. ";
  }
  else
  {
    s = "Sowas siehst Du da nicht!";
  }

  return BS(s);
}

int cmd_schuetteln(string str)
{
  string syntax;
  object raupe;

  notify_fail("Was moechtest Du schuetteln?\n");

  syntax = key + ({"raupe runter","raupe herunter","raupe herab"
                  ,"raupen runter","raupen herunter","raupen herab"
                  });

  if(!str || str == "")         return 0;
  if(member(syntax, str) == -1) return 0;

  TELLOTHERS(TPN+" ruettelt wie wild an einem Baum herum.\n");

  if(raupen <= 0)
  {
    TELLPLAYER("Du schuettelst den Baum, aber nichts passiert.\n");
    return -1;
  }

  if(raupen == 1)
  {
    TELLPLAYER(BS("Du schuettelst den Baum durch und durch und es faellt "
                  "eine einzige armselige Raupe herunter."));
  }
  else
  {
    TELLPLAYER(BS("Du schuettelst den Baum durch und durch und es fallen "
                  "einige Raupen herunter."));
  }

  while(raupen--)
  {
    raupe = clone_object(NPC "raupe");
    raupe->move(TO, M_GO, "", "", "faellt auf den Boden");
  }

  raupen = 0;
  return 1;
}


int cmd_bedrohen(string str)
{
  object *spieler;
  int i;

  notify_fail("Was moechtest Du bedrohen ?\n");

  if(!str || str == "") return 0;
  if(!id(str)) return 0;

  TELLPLAYER(BS("Du baust Dich vor dem Baum auf, holst tief Luft und machst "
             "\"Buh!\""));

  TELLOTHERS(BS(CTPN+" stellt sich vor dem Baum auf, plustert sich "
             "furchtbar auf und sagt: \"Buh!\""));

  spieler=filter_array(all_inventory(TO), "check_if_player") - ({TP});
  i = sizeof(spieler);
  while(i--) spieler[i]->command_me("lach");

  return 1;
}

int cmd_faellen(string str)
{
  object weapon,dryade;

  notify_fail("Was moechtest Du faellen?\n");

  if(!str || str == "") return 0;
  if(!id(str)) return 0;

  weapon = TP->QueryProp(P_WEAPON);

  if(!objectp(weapon))
  {
    TELLPLAYER("Du willst einen Baum mit blossen Haenden faellen?"
               " Spassvogel.\n");
    return 1;
  }

  if(weapon->QueryProp(P_WEAPON_TYPE) != WT_AXE)
  {
    TELLPLAYER(BS(weapon->Name(WER,0)+" ist nicht zum Baeume faellen "
                  "geeignet."));
    return 1;
  }

  if(!dryade_da)
  {
    TELLPLAYER(BS("Als Du so ausholst, um den Baum zu faellen, tut Dir dieser "
                  "maechtige Baum dann doch leid und Du laesst es bleiben. "));
    return 1;
  }

  dryade_da = 0;

  dryade = clone_object(NPC "dryade");

  if(id("eiche"))    dryade->Customize(25);
  if(id("buche"))    dryade->Customize(22);
  if(id("kastanie")) dryade->Customize(15);
  if(id("nussbaum")) dryade->Customize(12);
  if(id("linde"))    dryade->Customize(20);
  if(id("weide"))    dryade->Customize(18);

  dryade->move(TO,M_GO,"","","kommt erzuernt aus der Baumkrone angeflattert");
  dryade->Kill(TP);
  return 1;
}


public void InformBardSongPlayed(object bard, int success) {
  object dryade;
  if(success < 100) {
    tell_object(bard, BS("Dein Spiel war wohl nicht gut genug um eine Dryade anzulocken."));
    return;
  }

  dryade = clone_object(NPC "dryade");
  dryade->move(TO,M_GO,"","","wird von der Musik angelockt.");
}
