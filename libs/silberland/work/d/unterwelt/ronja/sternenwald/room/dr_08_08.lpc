#include "../def.h"

inherit ROOM "inh_dryaden";

void create()
{
  ::create();

  ltext  = "eine majestaetische Buche, von der";
  stext1 = "Eine gewaltige, uralte Buche";
  stext2 = "der grossen Buche";
  key    = ({"buche","baum"});

  Customize();

  AddExit("nordosten",    ROOM "fr_07_09");
  AddExit("osten",        ROOM "fr_08_09");
  AddExit("suedosten",    ROOM "fr_09_09");
  AddExit("sueden",       ROOM "dr_09_08");
  AddExit("suedwesten",   ROOM "dr_09_07");
  AddExit("westen",       ROOM "dr_08_07");
  AddExit("nordwesten",   ROOM "wr_07_07");
}
