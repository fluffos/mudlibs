#include "../def.h"

inherit ROOM "inh_dryaden";

void create()
{
  ::create();

  ltext  = "eine majestaetische Kastanie, von der";
  stext1 = "Eine gewaltige, uralte Kastanie";
  stext2 = "der grossen Kastanie";
  key    = ({"kastanie","baum"});

  Customize();

  AddExit("norden",      ROOM "dr_08_07");
  AddExit("nordosten",   ROOM "dr_08_08");
  AddExit("osten",       ROOM "dr_09_08");
  AddExit("suedosten",   ROOM "dr_10_08");
  AddExit("sueden",      ROOM "dr_10_07");
  AddExit("westen",      ROOM "wr_09_06");
}
