#include "../def.h"

inherit "std/room";

int heilung;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Bei der Nymphenquelle" );
  SetProp( P_INT_LONG,
    "Hier scheint Dir der Wald besonders dunkel. Kein einziger "
    "Lichtstrahl dringt durch die dichten Baumkronen. Trotzdem hast "
    "Du keine Angst, denn ein leises, froehliches Plaetschern "
    "bringt dich unwillkuerlich zum Laecheln. Eine kleine Quelle "
    "sprudelt zwischen moosbewachsenen Steinen hervor und sammelt "
    "sich in einem winzigen Teich.");

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({ "boden" }),
     "Der Boden ist mit federndem Moos ueberzogen. Niedriges aber dichtes "
     "Unterholz waechst zwischen den Baeumen");
  AddDetail( ({ "angst" }),
     "Angst hast Du hier keine - dazu wirkt das Plaetschern der Quelle "
     "zu freundlich.");
  AddDetail( ({ "laecheln" }),
     "Versuch es doch mal! Du wirst sehen, wie gut das tut!");
  AddDetail( ({ "plaetschern" }),
     "Lausche ihm doch.");
  AddDetail( ({ "quelle" }),
     "Die Quelle sprudelt zwischen den Steinen hervor und fliesst "
     "plaetschernd und kichernd in einen winzigen Teich.");
  AddDetail( ({ "stein", "steine" }),
     "Kopfgrosse, runde Steine, die voellig mit Moos ueberwachsen sind.");
  AddDetail( ({ "wasser" }) ,
     "Das Wasser ist still und klar und sieht eiskalt aus.");
  AddDetail( ({ "teich" }),
     "Der Teich ist winzig, scheint jedoch sehr tief zu sein.");
  AddDetail( ({ "unterholz" }),
     "Das Unterholz ist nicht sehr hoch aber teilweise ziemlich dicht.");
  AddDetail( ({ "himmel" }),
     "Hier kannst du den Himmel gar nicht sehen.");
  AddDetail( ({ "sternenwald", "wald", "ort", "name" }),
     "Dies ist der wunderschoene Sternenwald - ein mythischer Ort voller "
     "tiefer Geheimnisse und wundersamer Wesen.");
  AddDetail( ({ "geheimnisse", "geheimnis" }),
     "Das musst Du schon selber herausfinden ...");
  AddDetail( ({ "wesen" }),
     "Wunderbare Wesen kannst Du in diesem Wald antreffen. - Eines davon "
     "lebt hier.");
  AddDetail( ({ "moos" }),
     "Das Moos ist weich und ueberzieht Boden und Steine gleichermassen.");
  AddDetail( ({ "sternenlicht", "licht", "sterne", "stern" }),
     "Der Wald ist nach den Sternen benannt, die ewig ueber ihm schimmern "
     "und ihn in ihrem silbernen Licht baden.");
  AddDetail( ({ "kronen", "baumkronen", "dach", "blaetterdach" }),
     "Die gewaltigen Baeume haben dichte Kronen, die hier nicht das "
     "geringste Licht bis zum Boden durchlassen.");
  AddDetail( ({ "baum", "baeume" }),
     "Die Baeume in diesem Wald sind uralt. Ihre maechtigen Staemme ragen "
     "wie die Saeulen einer riesigen Kathedrale in den Himmel");
  AddDetail( ({ "stamm", "staemme" }),
     "Die Staemme sind glatt und so dick, dass es wohl vier oder fuenf "
     "Trolle braeuchte, um sie zu umfassen.");
  AddDetail( ({ "saeule", "saeulen" }),
     "Die Staemme der Baeume ragen glatt und gerade wie Saeulen in den "
     "Himmel.");
  AddDetail( ({ "troll", "trolle" }),
     "Gross, stark, gefraessig ..." );
  AddDetail( ({ "kathedrale" }),
     "Dieser Wald wirkt auf Dich wie eine gewaltige, der Natur geweihte "
     "Kathedrale.");
  AddDetail( ({ "natur", "wunder" }),
     "Die Natur hat in diesem Wald ein magisches Wunder vollbracht.");

  AddSound( DEFAULT_SOUND,
     "Die Quelle plaetschert leise und freundlich vor sich hin." );

  AddSound( ({ "plaetschern" }),
     "Das Plaetschern ist freundlich und klingt manchmal sogar wie "
     "leises Kichern." );
  AddSound( ({ "kichern" }),
     "Ein leises, froehliches Kichern ..." );

  AddCmd( ({"trink","trinke"})      , "cmd_trinken");

  AddExit("norden",     ROOM "wr_09_04");
  AddExit("nordosten",  ROOM "wr_09_05");
  AddExit("osten",      ROOM "wr_10_05");
  AddExit("suedosten",  ROOM "fr_11_05");
  AddExit("sueden",     ROOM "fr_11_04");
  AddExit("westen",     ROOM "wr_10_03");
  AddExit("nordwesten", ROOM "wr_09_03");

  AddItem(NPC "nymphe", REFRESH_DESTRUCT);

  heilung = 1;
}

void reset()
{
  ::reset();

  heilung = 1;
}

int cmd_trinken(string str)
{
  string s;

  notify_fail("Was moechtest Du trinken?\n");

  if(!str || str == "") return 0;
  if(!(str == "wasser"         ||
       str == "wasser aus teich"         )) return 0;

  s = "Du kniest nieder und trinkst etwas von dem Wasser. ";
  if(heilung)
  {
    s += "Obwohl das Wasser eiskalt ist, fuehlst Du Dich gleich etwas "
         "besser. ";
    heilung = 0;
    TP->heal_self(35);

    SWMASTER->Msg(TPUID+" trinkt aus dem Teich(Nymphe)");
  }

  TELLPLAYER(BS(s));
  TELLOTHERS(TPN+" kniet nieder und trinkt etwas Wasser.\n");
  return 1;
}


