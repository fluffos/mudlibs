#include "../def.h"

inherit ROOM "inh_waldfelsraum";

void create()
{
  ::create();

  AddExit("norden"   , ROOM "fr_09_01");
  AddExit("nordosten", ROOM "wr_09_02");
  AddExit("suedosten", ROOM "fr_11_02");
  AddExit("suedoben" , ROOM "eingang");
  AddExit("sueden"   , ROOM "eingang");

  AddProp(P_HIDE_EXITS, ({"sueden"}) );

  AddItem(NPC "blumengeist", REFRESH_DESTRUCT);
}
