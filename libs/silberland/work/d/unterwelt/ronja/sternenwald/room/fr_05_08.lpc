#include "../def.h"

inherit ROOM "inh_waldfelsraum";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst auf einem schmalen Pfad, der um den grossen Sternenwald "
    "herumfuehrt. Die hohe Felswand, die den Rand des Sternenwaldes "
    "beschliesst, macht hier einen weiten Bogen. Im Norden siehst Du ein "
    "kleines Haeuschen, das sich dicht an die dunklen Felsen anschmiegt. "
    "Auf der anderen Seite erheben sich die majestaetischen Baumriesen "
    "des Sternenwaldes in den Nachthimmel. Die dichten Baumkronen lassen "
    "kaum Licht durch. Nur manchmal faellt ein Schaft silbernen "
    "Sternenlichts vor Dir auf den Weg. "
  );

  AddDetail( ({"bogen"}) ,
    "Die hohe Felswand, die den Rand des Sternenwaldes beschliesst, macht "
    "hier einen weiten Bogen. "
  );

  AddDetail( ({"haeuschen","haus"}) ,
    "Im Norden steht ein kleines Haeuschen, das sich dicht an die dunklen "
    "Felsen anschmiegt. Es besteht nahezu voellig aus Holz und hat eine "
    "knarrende Holztuer, die im Moment gerade offen steht. Wer mag wohl "
    "dort wohnen? "
  );

  AddDetail( ({"holztuer","tuer"}) ,
    "Die Holztuer steht offen, so dass Du das Haus nach Norden hin betreten "
    "kannst. "
  );

  AddDetail( ({"holz"}) ,
    "Das Holz scheint von einem der umliegenden Baeume zu stammen."
  );

  AddDetail( ({"moment"}) ,
    "Die Holztuer steht im Moment gerade offen."
  );

  AddExit("norden", "/d/unterwelt/torian/haus/room/eingang");
  AddExit("suedosten",  ROOM "fr_06_09");
  AddExit("suedwesten", ROOM "wr_06_07");
  AddExit("westen",     ROOM "fr_05_07");
}
