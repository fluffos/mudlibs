#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_FOREST]) );

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "exit_aufgabe" );
}

int exit_aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist es... ja was nur?\n");
  return 0;
}
