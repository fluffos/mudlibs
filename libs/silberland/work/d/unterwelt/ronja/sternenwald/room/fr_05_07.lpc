#include "../def.h"

inherit ROOM "inh_waldfelsraum";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst auf einem schmalen Pfad, der um den grossen Sternenwald "
    "herumfuehrt. Die hohe Felswand, die den Rand des Sternenwaldes "
    "beschliesst, macht hier einen weiten Bogen. Im Norden siehst Du die "
    "Umrisse eines kleinen Haeuschens, das sich dicht an die dunklen "
    "Felsen anschmiegt. Auf der anderen Seite erheben sich die "
    "majestaetischen Baumriesen des Sternenwaldes in den Nachthimmel. "
    "Die dichten Baumkronen lassen kaum Licht durch. Nur manchmal faellt "
    "ein Schaft silbernen Sternenlichts vor Dir auf den Weg. "
  );


  AddDetail( ({"bogen"}) ,
    "Die hohe Felswand, die den Rand des Sternenwaldes beschliesst, macht "
    "hier einen weiten Bogen. "
  );

  AddDetail( ({"haeuschen"}) ,
    "Im Norden steht ein kleines Haeuschen, das sich dicht an die dunklen "
    "Felsen anschmiegt. Von hier aus kannst Du noch nicht sehr viel "
    "erkennen. "
  );

  AddDetail( ({"umrisse"}) ,
    "Von hier aus kannst Du noch nicht sehr viel erkennen."
  );

  AddExit("osten",      ROOM "fr_05_08");
  AddExit("sueden",     ROOM "wr_06_07");
  AddExit("suedwesten", ROOM "wr_06_06");
  AddExit("westen",     ROOM "fr_05_06");

  AddItem(NPC "einhorn", REFRESH_DESTRUCT);
}
