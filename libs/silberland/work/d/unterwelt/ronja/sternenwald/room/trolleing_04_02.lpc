#include "../def.h"

inherit ROOM "inh_waldfelsraum";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Am Rand des Sternenwaldes" );
  SetProp( P_INT_LONG,
     "Du stehst auf einem schmalen Pfad, der um den grossen Sternenwald "
     "herumfuehrt. Auf einer Seite ragt eine hohe Felswand aus schwarzem "
     "Vulkangestein ueber Dir auf, auf der anderen erheben sich die "
     "majestaetischen Baumriesen des Sternenwaldes in den Nachthimmel. "
     "Im Osten siehst Du einen schmalen Spalt im Fels, aus dem Licht "
     "dringt."
  );

  AddDetail( ({ "spalt" }),
     "Ein sehr schmaler Spalt scheint sich im Fels zu oeffnen."
  );

  AddDetail( ({ "licht", "lichtstrahl" }),
     "Ein feiner aber starker Lichtstrahl ergiesst sich vor Dir auf den "
     "Pfad."
  );

  AddExit("osten",      ROOM "th_04_03");
  AddExit("suedwesten", ROOM "fr_05_01");
}
