#include "../def.h"

inherit ROOM "inh_waldraum";

void create()
{
  ::create();

  SetPropability(33);

  AddExit("nordosten",  ROOM "fr_06_09");
  AddExit("osten",      ROOM "fr_07_09");
  AddExit("suedosten",  ROOM "fr_08_09");
  AddExit("suedwesten", ROOM "dr_08_07");

  AddItem(NPC "blumengeist", REFRESH_DESTRUCT);
  AddItem(NPC "wilddrude",   REFRESH_DESTRUCT);
}
