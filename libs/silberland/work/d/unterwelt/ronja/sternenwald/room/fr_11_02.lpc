#include "../def.h"

inherit ROOM "inh_waldfelsraum";

void create()
{
  ::create();

  AddExit("nordosten"  , ROOM "wr_10_03");
  AddExit("osten"      , ROOM "fr_11_03");
  AddExit("nordwesten" , ROOM "fr_10_01");
  AddExit("westoben"   , ROOM "eingang");
  AddExit("westen"     , ROOM "eingang");

  AddProp(P_HIDE_EXITS, ({"westen"}) );
  AddItem( NPC "blumengeist", REFRESH_DESTRUCT);
}
