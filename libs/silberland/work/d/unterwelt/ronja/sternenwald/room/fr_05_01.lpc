#include "../def.h"

inherit ROOM "inh_waldfelsraum";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
     "Du stehst auf einem schmalen Pfad, der um den grossen Sternenwald "
     "herumfuehrt. Auf einer Seite ragt eine hohe Felswand aus schwarzem "
     "Vulkangestein ueber Dir auf, auf der anderen erheben sich die "
     "majestaetischen Baumriesen des Sternenwaldes in den Nachthimmel. "
     "Die dichten Baumkronen lassen kaum Licht durch. Nur manchmal faellt "
     "ein Schaft silbernen Sternenlichts vor Dir auf den Weg. Im Norden "
     "kannst Du schwach die Umrisse eines schlichten, unauffaelligen "
     "Gebaeudes erkennen."
  );

  AddDetail( ({"gebaeude","umrisse", "norden"}) ,
    "Geh doch einfach mal hin."
  );

  AddExit("nordosten", ROOM "trolleing_04_02");
  AddExit("suedosten", ROOM "wr_06_02");
  AddExit("sueden",    ROOM "fr_06_01");
  AddExit("norden",    "/d/unterwelt/hactar/deathshome/room/deathshome");

  AddItem(NPC "einhorn", REFRESH_DESTRUCT);
}
