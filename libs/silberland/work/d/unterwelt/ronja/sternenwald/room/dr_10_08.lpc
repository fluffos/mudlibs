#include "../def.h"

inherit ROOM "inh_dryaden";

void create()
{
  ::create();

  ltext  = "eine majestaetische Weide, von der";
  stext1 = "Eine gewaltige, uralte Weide";
  stext2 = "der grossen Weide";
  key    = ({"weide","baum"});

  Customize();

  AddExit("norden",     ROOM "dr_09_08");
  AddExit("nordosten",  ROOM "fr_09_09");
  AddExit("osten",      ROOM "fr_10_09");
  AddExit("sueden",     ROOM "fr_11_08");
  AddExit("suedwesten", ROOM "fr_11_07");
  AddExit("westen",     ROOM "dr_10_07");
  AddExit("nordwesten", ROOM "dr_09_07");
}
