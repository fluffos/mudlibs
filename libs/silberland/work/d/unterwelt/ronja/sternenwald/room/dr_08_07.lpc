#include "../def.h"

inherit ROOM "inh_dryaden";

void create()
{
  ::create();

  ltext  = "eine majestaetische Eiche, von der";
  stext1 = "Eine ganz besondere Eiche";
  stext2 = "der grossen Eiche";
  key    = ({"eiche","baum"});

  Customize();

  AddExit( "norden",     ROOM "wr_07_07");
  AddExit( "nordosten",  ROOM "wr_07_08");
  AddExit( "osten",      ROOM "dr_08_08");
  AddExit( "suedosten",  ROOM "dr_09_08");
  AddExit( "sueden",     ROOM "dr_09_07");
  AddExit( "nordwesten", ROOM "wr_07_06");
}
