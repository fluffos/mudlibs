#include "../def.h"

inherit "std/room";

mapping spieler;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Vor dem Sternenwald" );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_FOREST]) );


  AddDetail( ({"plattform"}) ,
    "Du befindest Dich auf ihr. Von hier aus kannst Du die Auslaeufer "
    "des Sternenwaldes sehen. "
  );

  AddDetail( ({ "boden", "pfad" }),
     "Der Pfad, auf dem du stehst, ist aus dem selben schwarzen Gestein "
     "wie die Felswand. Kleine Moospolster und einige Ranken des "
     "Unterholzes haben sich jedoch bereits auf dem Felsen festgesetzt. ");

  AddDetail( ({"ranken"}) ,
    "Einige Ranken des Unterholzes wachsen bereits die Felsen empor."
  );

  AddDetail( ({ "gang" }),
     "Der Gang, durch den Du hierhergekommen bist.");
  AddDetail( ({ "auslaeufer","teil" }),
     "Dies ist wohl nur ein Auslaeufer. Der Wald scheint riesig zu sein.");
  AddDetail( ({ "seite" }),
     "Der Pfad ist schmal und wird auf einer Seite von der Felswand und"
     " auf der anderen vom Wald begrenzt.");
  AddDetail( ({ "wand", "felswand" }),
     "Die Felswand ragt hoch ueber Dir auf. Das Gestein ist glatt und"
     " tiefschwarz.");
  AddDetail( ({ "gestein", "vulkangestein", "felsen" }),
     "Tief schwarzes, zum Teil poroeses, zum Teil aber auch fast"
     " glasartiges Vulkangestein.");
  AddDetail( ({ "unterholz" }),
     "Das Unterholz, das zwischen den Baeumen waechst, ist nicht sehr"
     " hoch aber teilweise ziemlich dicht.");
  AddDetail( ({ "himmel", "nachthimmel" }),
     "Du kannst nur hin und wieder zwischen den Baumkronen den"
     " sternenuebersaehten Himmel sehen.");
  AddDetail( ({ "sternenwald", "wald", "ort", "name","rand" }),
     "Du stehst am Rand des Sternenwald - ein mythischer Ort voller"
     " tiefer Geheimnisse und wundersamer Wesen.");
  AddDetail( ({ "geheimnisse", "geheimnis" }),
     "Das musst Du schon selber herausfinden ...");
  AddDetail( ({ "wesen" }),
     "Wunderbare Wesen kannst Du in diesem Wald antreffen.");
  AddDetail( ({ "moos", "moospolster" }),
     "Das Moos ist weich und wo es vom Sternenlicht beruehrt wird,"
     " schimmert es silbrig.");
  AddDetail( ({ "sternenlicht", "licht", "sterne", "stern" }),
     "Der Wald ist nach den Sternen benannt, die ewig ueber ihm schimmern"
     " und ihn in ihrem silbernen Licht baden.");
  AddDetail( ({ "kronen", "baumkronen", "dach", "blaetterdach" }),
     "Die gewaltigen Baeume haben dichte Kronen, die nur manchmal das"
     " Sternenlicht bis zum Boden durchlassen.");
  AddDetail( ({ "baum", "baeume", "baumriesen" }),
     "Die Baeume sind uralt. Ihre maechtigen Staemme ragen"
     " wie die Saeulen einer riesigen Kathedrale in den Himmel. ");
  AddDetail( ({ "stamm", "staemme" }),
     "Die Staemme sind glatt und so dick, dass es wohl vier oder fuenf"
     " Trolle braeuchte, um sie zu umfassen.");
  AddDetail( ({ "saeule", "saeulen" }),
     "Die Staemme der Baeume ragen glatt und gerade wie Saeulen in den "
     "Himmel.");
  AddDetail( ({ "troll", "trolle" }),
     "Gross, stark, gefraessig ..." );
  AddDetail( ({ "kathedrale" }),
     "Dieser Wald wirkt auf Dich wie eine gewaltige, der Natur geweihte "
     "Kathedrale.");
  AddDetail( ({ "natur", "wunder" }),
     "Die Natur hat in diesem Wald ein magisches Wunder vollbracht.");

  AddSound( DEFAULT_SOUND,
     "Von Zeit zu Zeit raunt leise ein Luftzug durch die Blaetter - "
     "ansonsten herrscht eine fast ehrfurchtgebietende Stille." );

  AddSound( ({ "luftzug", "blaetter" }),
     "Leise fluestern die Blaetter, wenn ein Luftzug hindurch faehrt." );

  AddSound( ({ "raunen" }),
     "Leise raunt ab und an ein Luftzug durch die Blaetter." );

  AddSound( ({ "stille" }),
     "pssssssssssst ..." );

  AddExit("nordunten", ROOM "fr_10_01");
  AddExit("norden"   , ROOM "fr_10_01");
  AddExit("ostunten" , ROOM "fr_11_02");
  AddExit("osten"    , ROOM "fr_11_02");
  AddExit("suedoben" , ANSCHLUSS);
  AddExit("sueden"   , ANSCHLUSS);

  SetProp(P_HIDE_EXITS, ({"norden","osten","sueden"}) );

  spieler = ([]);
}

void init()
{
  object room;
  string s;

  ::init();

  if(TP && interactive(TP) && objectp(room=TP->QueryProp(P_LAST_COMMAND_ENV)))
  {
    s = explode(file_name(room),"/")[<1];
    if(member(spieler,getuid(TP)))
    {
      spieler[getuid(TP)] = s;
    }
    else
    {
      spieler += ([ getuid(TP):s ]);
    }
//    DB(sprintf("%O\n",spieler));
  }
}

string _query_int_long()
{
  string s,tpuid;

  s = "Du trittst aus dem dunklen Gang und bleibst erstaunt stehen. "
      "Du befindest Dich auf einer kleiner Plattform und erblickst "
      "die Auslaeufer eines Waldes, der unter einem sternenuebersaeten "
      "Nachthimmel liegt! Sollte dies der sagenumwobene Sternenwald sein?" ;

  tpuid = getuid(TP);

  if(member(spieler,tpuid))
  {
    switch(spieler[tpuid])
    {
      case "fr_10_01" :
      case "fr_11_02" :
        s = "Du befindest Dich wieder auf der kleinen Plattform, von der "
            "aus Du die Auslaeufer des Sternenwaldes erblickst.";
        break;

    }
  }

  s += " Auf einer Seite ragt eine hohe Felswand aus schwarzem Vulkangestein "
       "ueber Dir auf, auf der anderen Seite erheben sich majestaetische "
       "Baumriesen. ";

  return BS(s);
}
