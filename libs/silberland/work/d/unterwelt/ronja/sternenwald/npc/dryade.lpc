inherit "std/npc";
inherit "/gilden/bardengilde/obj/std_spellprovider";

#include "../def.h"

void Customize(int level);

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Dryade");
  SetProp(P_LONG,
    "Eine Baumdryade. Dryaden sind mit den Feen verwandt, doch leben sie "
    "in den Waeldern. Dort suchen sie sich einen Baum heraus, den sie "
    "fortan beschuetzen. Der Baum gewaehrt ihnen Schutz und Unterkunft "
    "und bewacht ihre wenigen Habseligkeiten. "
  );

  SetProp(P_NAME, "Dryade");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));

  AddId(({"dryade", "baumgeist", "geist"}));
  AddClass(CL_FAIRY); // siehe /sys/class.h

  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 45);
  SetProp(P_WEIGHT, 35000);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

  SetProp(P_DIE_MSG, " verschwindet mit einem Aufschrei in der Baumspalte.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MURDER_MSG, "Wer kuemmert sich jetzt um meinen Baum?");
  SetProp(P_KILL_MSG, "Lass gefaelligst meinen Baum in Ruhe!");


  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Die Dryade versteckt @WEN in einer Baumspalte.\n" }) );

  SUID;

  Customize(15);

  AddInfo(DEFAULT_INFO, "sieht dich mit grossen Augen an.\n");

  AddInfo( ({"barden", "musik"}), 
    "Ich liebe die Musik der Barden! Moechtest du ein Lied fuer mich spielen?",
    "sagt: ");

  AddInfo( ({"ode", "sterne", "ode an die sterne"}), 
    "Die Sterne hier sind wunderschoen! Wollen wir sie gemeinsam betrachten? "
    "Und gemeinsam ein Lied ueber ihr schoenes Funkeln dichten? Hach...",
    "seufzt: ");

  AddCmd("beobachte|beobacht|betrachte|betracht&sterne|himmel&mit&dryade|fee|geist|baumgeist",
         "cmd_sterne_beobachten", "Was willst du mit wem betrachten?");

  SetProp(P_NOATTACK, "tanzt um einen Baum herum. Da willst du nicht stoeren.");
}

public void sequenz_fertig(object pl) {
  SetProp("sterne_beobachten", 0);

  if(pl->QueryProp(P_GUILD) != "bardengilde") {
    tell_object(pl, BS("Du fuehlst eine Welle der Euphorie und Inspiration."));
    pl->AddHp(20);
    pl->AddSp(20);
  }

  LearnBardSpell(pl, "ode an die sterne", "Dieses Lied ruft entweder einen Stern, oder etwas Dunkelheit herbei.",
                 "spiele 'ode an die sterne'");
  return;
}

public int cmd_sterne_beobachten() {
  if(QueryProp("sterne_beobachten")) {
    write(BS(Name(WER, 1) + " ist gerade beschaeftigt."));
    return -1;
  }

  SetProp("sterne_beobachten", 1);

  tell_object(this_player(), 
    BS("Gemeinsam mit " + name(WEM, 1) +"legst du dich ins feuchte Moos und ihr beobachtet "
       "den Sternenhimmel ueber dem Wald. Sie zeigt dir einige ihrer Lieblingssterne und "
       "kuschelt sich wohlig an dich."));

  tell_room(environment(this_object()), BS(sprintf("%s legt sich gemeinsam mit der Dryade ins Moos, um Sterne zu beobachten.", this_player()->Name(WER))), ({this_player()}));

  this_player()->SetProp(P_PARALYZED, 
    ([PARALYZE_TIME: 10,
      PARALYZE_MSG: "Hier mit der Dryade zu kuscheln ist viel schoener...\n",
      PARALYZE_MSG_OTHER: "%s schmust mit der Dryade.\n",
      PARALYZE_END: "Nach einer Weile erhebt ihr euch seufzend wieder...\n",
      PARALYZE_END_OTHER: "%s und die Dryade erheben sich wieder aus dem Moos."])
  );

  call_out("sequenz_fertig", 10, this_player());
  
  return 1;
}

public void reset() {
  ::reset();
  if(QueryProp(P_NOATTACK) && !QueryProp("sterne_beobachten")) {
    tell_room(environment(this_object()), BS(sprintf("%s verscchmilzt mit einem Baum.", Name(WER, 1))));
    remove(1);
  }
}

void Customize(int level)
{
  create_default_npc(level);
  SetProp(P_HANDS, ({" mit magischer Energie",QueryProp(P_HANDS)[1],DT_WATER}));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.0, DT_COLD:     -1.0, DT_WATER: -1.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_SPELLRATE,2*level);

  AddSpell(1,0,
    Name(WER,1)+" laesst die Luft um Dich herum zaeh wie Wasser werden.\n",
    Name(WER,1)+" laesst die Luft um @WEN herum zaeh wie Wasser werden.\n",
    DT_WATER, "spell_water"
  );

  SetProp(P_NOATTACK, 0);

  AddInfo(DEFAULT_INFO, "ist total zornig weil jemand ihren Baum bedroht.\n");

}

void spell_water(object enemy, int damage, mixed dam_type)
{
  int dauer;
  int level;

  level = QueryProp(P_LEVEL);
  dauer = level+30;
  enemy->ModifySkillAttribute(TO, SA_SPEED, 50, dauer);
  enemy->Defend(level*level+200, dam_type, 0, TO);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(interactive(enemy) && (
     (enemy->QueryProp(P_LEVEL)+10) < TO->QueryProp(P_LEVEL)))
  {
    TELLPLAYER(BSI("Werd' erst einmal gross.",Name(WER,1)+" laechelt Dich "
                   "freundlich an: "));
    TELLOTHERS(Name(WER,1)+" laechelt "+TPN+" freundlich an.\n");
    enemy->StopHuntFor(TO,1);
    StopHuntFor(enemy,1);
    return 0;
  }

  return ::Defend(dam,dam_type,spell,enemy);
}

varargs void die(int poisondeath)
{
  object enemy,room,ob;

  if(room=ENV(TO))
  {
    tell_room(room,
      BS("Mit ihrer letzten Kraft oeffnet die Dryade eine Spalte "
         "in ihrem Baum, wobei etwas von ihren Habseligkeiten "
         "herauskullert.")
    );

    switch(random(9))
    {
      case 0 :
        ob = clone_object(OBJ "hf");
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

      case 1 :
        GEMMASTER->DistributeGem(1,1,1,room);
        break;

      case 2 :
        ob = clone_object("/obj/money");
        ob->AddAmount(150+random(150));
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

      case 3 :
        ob = clone_object("/d/unterwelt/zordan/dhrkion/armour/weste");
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

      case 4 :
        ob = clone_object("/d/unterwelt/basics/central/obj/erz");
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

      case 5 :
        ob = clone_object("/d/unterwelt/basics/central/obj/brocken");
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

      case 6 :
        ob = clone_object("/d/unterwelt/basics/central/obj/splaetz");
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

      case 7 :
        ob = clone_object(ARMOUR "chitinhose_alt");
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

      case 8 :
        ob = clone_object(ARMOUR "seidenguertel");
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

    }
  }

  ::die(poisondeath);
}

