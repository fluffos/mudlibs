#include "../def.h"

inherit "/std/mnpc";
inherit "/std/npc/spells";

void Customize();

object horn;
int    callouts;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:40]));
  AddId(({"einhorn","\nSTERNENWALDEINHORN"}));
  AddClass(CL_ANIMAL);

  SetProp(P_FARBE, random(5));
  SetProp(P_GESCHLECHT, random(3));

  Customize();

  SetProp(P_TRANSPARENT,0);
  SetProp(P_MNPC_AREA, ({ ROOM "wr", ROOM "fr" }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "wr_07_07");
  SetProp(P_MNPC_WAIT, ({ 30, 30, 20 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "wiehert Dich freudig an.\n");

  SetChats(3,
   ({"Das Einhorn wiehert laut.\n"
    ,"Das Einhorn schnaubt.\n"
    ,"Das Einhorn senkt seinen Kopf und zeigt mit dem Horn auf Dich.\n"
    ,"Das Einhorn hebt sein Horn zum Himmel.\n"
    })
  );

  SUID;

  callouts = 0;
}

void Customize()
{
  int level,size,weight,gender,farbe,geschlecht;
  string str,id,strsein;

  farbe      = QueryProp(P_FARBE);
  geschlecht = QueryProp(P_GESCHLECHT);

  switch(geschlecht)
  {
    case T_HENGST :
      str = "Vor Dir steht ein zartgliedriger aber dennoch majestaetischer "
            "Einhornhengst. Seine Bewegungen sind voller Anmut und Kraft. Sein "
            "wunderschoenes, gewundenes Horn scheint die Sterne selbst zu "
            "beruehren. ";
      strsein = "sein";
      break;

    case T_STUTE :
      str = "Vor Dir steht eine zartgliedrige aber dennoch majestaetische "
            "Einhornstute. Ihre Bewegungen sind voller Anmut und Kraft. Ihr "
            "wunderschoenes, gewundenes Horn scheint die Sterne selbst zu "
            "beruehren. ";
      strsein = "ihr";
      break;

    case T_FOHLEN :
      str = "Vor Dir steht ein zartgliedriges aber dennoch majestaetisches "
            "Einhornfohlen. Seine Bewegungen sind voller Anmut und Kraft. Sein "
            "wunderschoenes, gewundenes Horn scheint die Sterne selbst zu "
            "beruehren. ";
      strsein = "sein";
      break;
  }

  switch(farbe)
  {
    case T_BRONZEN  :
      str += CAP(strsein)+" Fell, "+strsein+"e Maehne, "+strsein+" Schweif "
             "sind wie fluessige Bronze";

      horn = clone_object(WEAPON "horn");
      horn->SetHeal(farbe);
      horn->SetProp(P_NAME_ADJ,"bronzen");
      horn->AddAdjective( ({"bronzenem","bronzenen","bronzenes","bronzener"}) );
      horn->move(TO,M_GET|M_NOCHECK);

      break;

    case T_KUPFERN  :
      str += CAP(strsein)+" Fell, "+strsein+"e Maehne, "+strsein+" Schweif "
             "sind wie fluessiges Kupfer";

      horn = clone_object(WEAPON "horn");
      horn->SetHeal(farbe);
      horn->SetProp(P_NAME_ADJ,"kupfern");
      horn->AddAdjective( ({"kupfernem","kupfernen","kupfernes","kupferner"}) );
      horn->move(TO,M_GET|M_NOCHECK);

      break;

    case T_SILBERN  :
      str += CAP(strsein)+" Fell, "+strsein+"e Maehne, "+strsein+" Schweif "
             "sind wie fluessiges Silber";

      horn = clone_object(WEAPON "horn");
      horn->SetHeal(farbe);
      horn->SetProp(P_NAME_ADJ,"silbern");
      horn->AddAdjective( ({"silbernem","silbernen","silbernes","silberner" }) );
      horn->move(TO,M_GET|M_NOCHECK);

      break;

    case T_GOLDEN   :
      str += CAP(strsein)+" Fell, "+strsein+"e Maehne, "+strsein+" Schweif "
            "sind wie fluessiges Gold";

      horn = clone_object(WEAPON "horn");
      horn->SetHeal(farbe);
      horn->SetProp(P_NAME_ADJ,"golden");
      horn->AddAdjective( ({"goldenem","goldenen","goldenes","goldener"}) );
      horn->move(TO,M_GET|M_NOCHECK);

      break;

    case T_SCHWARZ  :
      str += CAP(strsein)+" Fell, "+strsein+"e Maehne, "+strsein+" Schweif "
             "sind schwaerzer als die Dunkelheit, die Dich umgibt";

      horn = clone_object(WEAPON "shorn");
      horn->move(TO,M_GET|M_NOCHECK);

      break;

  }

  if(farbe == T_SCHWARZ)
  {
    str += " und schaut Dich mit "+strsein+"en Augen listig an. ";
  }
  else
  {
    str += " und "+strsein+" Blick verraet Weisheit und Guete gleichermassen. ";
  }

  SetProp(P_LONG, str);

  SetProp(P_NAME,
    ({"Einhornhengst","Einhornstute","Einhornfohlen"})[geschlecht]);

  SetProp(P_NAME_ADJ,
    ({"bronzen","kupfern","silbern","golden","schwarz"})[farbe]);

  AddAdjective(
    ({  ({"bronzenem" ,"bronzenen"  ,"bronzenes"  ,"bronzener" })
       ,({"kupfernem" ,"kupfernen"  ,"kupfernes"  ,"kupferner" })
       ,({"silbernem" ,"silbernen"  ,"silbernes"  ,"silberner" })
       ,({"goldenem"  ,"goldenen"   ,"goldenes"   ,"goldener"  })
       ,({"schwarzem" ,"schwarzen"  ,"schwarzes"  ,"schwarzer" })

    })[farbe]);

  level = 18;

  switch(geschlecht)
  {
    case T_HENGST:
      level +=  4; size = 180; weight = 400000; gender = MALE;
      str = " mit seinem Horn"; id = "hengst";
      break;

    case T_STUTE:
      level +=  2; size = 160; weight = 300000; gender = FEMALE;
      str = " mit ihrem Horn"; id = "stute";
      break;

    case T_FOHLEN:
      level -= 10; size = 100; weight = 100000; gender = NEUTER;
      str = " mit seinem Horn"; id = "fohlen";
      break;
  }

  level += 2 * farbe;

  create_default_npc(level);
  SetProp(P_RACE, "Einhorn");
  SetProp(P_SIZE, size+random(30));
  SetProp(P_ALIGN, 160*farbe+200);
  if(farbe == T_SCHWARZ) SetProp(P_ALIGN, -QueryProp(P_ALIGN));
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_WEIGHT,weight);
  SetProp(P_HEAL,0);
  SetProp(P_HANDS, ({str,QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_GENDER,gender);
  AddId( ({ id, "einhorn"+id }) );
  SetProp(P_WIMPY,0);

  SetProp(P_SHORT,name(WER));
  AddId(lower_case(QueryProp(P_NAME)));

  SetProp(P_MMSGIN, "galoppiert herein");
  SetProp(P_MMSGOUT,"galoppiert davon");

  SetProp(P_MSGIN, "galoppiert herein");
  SetProp(P_MSGOUT,"galoppiert# davon");

  if(farbe == T_SCHWARZ)
  {
    SetProp(P_RESISTANCE_STRENGTHS ,
      ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0,
        DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
        DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON:-1.0, DT_TERROR: 0.0,
        DT_HOLY:     -1.0, DT_UNHOLY:    0.2, DT_MAGIC: -1.0 ]) );
  }
  else
  {
    SetProp(P_RESISTANCE_STRENGTHS ,
      ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0,
        DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
        DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON:-1.0, DT_TERROR: 0.0,
        DT_HOLY:      0.2, DT_UNHOLY:   -1.0, DT_MAGIC: -1.0 ]) );
  }

  SetProp(P_SPELLRATE, 50);

  AddSpell(3, (farbe+1)*100,
    "Das Einhorn schlaegt mit seinen Hufen aus und trifft Dich.\n",
    "Das Einhorn schlaegt mit seinen Hufen aus und trifft @WEN.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 200+farbe*50, DS_MASS_BLIND,
    "Ein extremes Leuchten geht vom Einhorn aus.\n",
    "Ein extremes Leuchten geht vom Einhorn aus.\n",farbe+3 );

  if(farbe == T_SCHWARZ)
  AddDefaultSpell(2, 200, DS_PARALYZE,
    "Das Einhorn beruehrt Dich mit dem Horn und Du erstarrst zu Stein.\n",
    "Das Einhorn beruehrt Dich mit dem Horn und @WER erstarrt zu Stein.\n");

  AddSpell(1,0,
    "Das Einhorn schleudert Dich mit einem gezielt Tritt hinfort.\n",
    "Das Einhorn schleudert @WEN mit einem gezielt Tritt hinfort.\n",
    DT_BLUDGEON, "wegschleudern");

  return;
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(interactive(enemy) &&
     ((enemy->QueryProp(P_LEVEL)+10) < TO->QueryProp(P_LEVEL)))
  {
    TELLPLAYER(BSI("Werd' erst einmal gross.",Name(WER,1)+" laechelt Dich "
                   "freundlich an: "));
    TELLOTHERS(Name(WER,1)+" laechelt "+TPN+" freundlich an.\n");
    enemy->StopHuntFor(TO,1);
    StopHuntFor(enemy,1);
    return 0;
  }

  return ::Defend(dam,dam_type,spell,enemy);
}

void wegschleudern(object enemy, int damage, mixed dam_type)
{
  object *rooms;
  int farbe;

  farbe = QueryProp(P_FARBE);

  enemy->Defend(500+farbe*100, dam_type, ([SP_SHOW_DAMAGE:1]), TO);

  if(enemy->QueryProps(P_GHOST)) return;

  rooms = m_values(MENV->QueryProp(P_EXITS));
  if(!sizeof(rooms)) return;

  enemy->move(rooms[random(sizeof(rooms))], M_GO,
    "wird vom Einhorn fortgeschleudert", "",
    "fliegt in hohem Bogen herein");
  enemy->SetProp(P_PARALYZED, 10);
}

varargs void die(int poisondeath)
{
  object enemy;

  if(random(10) == 5 && objectp(horn))
  {
    horn->remove();

    if(ENV(TO))
    {
      tell_room(ENV(TO),BS("Das Horn des Einhornes erlischt und zerfaellt zu "
                           "Sternenstaub."));
    }
  }

  ::die(poisondeath);
}

void lpweg(object pl)
{
  pl->AddHP(-15);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  string s;
  if(++callouts > 5) return;

  switch (gruppe)
  {
    case "fies":
      Kill(TP);
      break;

    case "frech":
      call_out("react", 0, TP,
        "wirft Dir einen veraechtlichen Blick zu",
        "wirft "+TPN+" einen veraechtlichen Blick zu"
      );
      break;

    case "traurig":
      s = QueryPossPronoun(MALE,WEN,SINGULAR);
      call_out("react", 0, TP,
        "reibt "+s+" Kopf an deiner Schulter",
        "reibt "+s+" Kopf an "+TP->Name(WESSEN)+" Schulter"
      );
      break;

    case "neutral":
      call_out("react", 0, TP,
        "schnaubt kurz",
        "schaut "+TPN+" unschluessig an"
      );
      break;

    case "nett":
      call_out("react", 0, TP,
        "wackelt mit den Ohren",
        "wackelt mit den Ohren"
      );
      break;

    case "albern":
      s = QueryPronoun(WER);
      call_out("react", 0, TP,
        "wiehert Dich an. Oder lacht "+s+" Dich aus?",
        "wiehert "+TPN+" an");
      break;

    case "aengstlich":
      call_out("react", 0, TP,
        "geht ein paar Schritte zurueck",
        "geht ein paar Schritte zurueck"
      );
      break;

    case "intim":
      s = QueryPossPronoun(FEMALE,WEM,SINGULAR);
      call_out("react", 0, TP,
        "schlabbert Dich mit "+s+" Zunge ab",
        "schlabbert "+TPN+" mit "+s+" Zunge ab"
      );
      break;

    case "froh":
      call_out("react", 0, TP,
        "wiehert froehlich",
        "wiehert froehlich"
      );
      break;

    case "aergerlich":
      call_out("react", 0, TP,
        "schnaubt boese auf, dreht sich um und schlaegt mit den Hinterhufen "
        "nach Dir",
        "schnaubt boese auf, dreht sich um und schlaegt mit den Hinterhufen "
        "nach "+TPN
      );
      call_out("lpweg",0,TP);
      break;

  }
}

void react(object to, string vic, string oth)
{
  if (present(to, ENV(TO))) {
    tell_object(to, BS(Name(WER, 1)+" "+vic+"."));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+oth+"."), ({to}));
  }
  callouts--;
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

