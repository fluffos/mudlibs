#include "../def.h"

inherit "std/mnpc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Graugnom");
  SetProp(P_LONG,
    "Ein Graugnom. Dieser kleine, lustige Geselle lebt in kleinen Hoehlen "
    "in der Erde und ernaehrt sich von Nuessen, Samen und was sich sonst "
    "auf dem Waldboden findet. Sein Fell ist voellig grau, woher er dann "
    "auch seinen Namen hat. Mit richtigen Gnomen hat er allerdings nur "
    "wenig zu tun, denn die Graugnome sind eher putzige Kerlchen. "
  );

  SetProp(P_NAME, "Graugnom");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:30]));

  AddId( ({"graugnom","gnom"}) );
  AddClass(CL_ANIMAL); // siehe /sys/class.h

  create_default_npc(5+random(5));
  SetProp(P_HANDS, ({" mit seinen Krallen",QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 40+random(20));
  SetProp(P_ALIGN, -200+random(400));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,8);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 30);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "krabbelt unter einem Gebuesch hervor");
  SetProp(P_MMSGOUT, "versteckt sich in einer Erdspalte");

  SetProp(P_MNPC_AREA, ({ ROOM "wr", ROOM "fr" }) );
  SetProp(P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_OUTDOORS );
  SetProp(P_MNPC_WAIT, ({ 120, 90, 30 }) );

  AddInfo(DEFAULT_INFO, "schaut Dich nur mit seinen grossen Augen an.\n");

  SetProp(P_REJECT, ({ REJECT_DROP,
    "Dem Graugnom sind Deine Sachen zu schwer.\n" }) );
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(enemy->QueryProp(P_LEVEL) < 2 * TO->QueryProp(P_LEVEL))
  {
    return ::Defend(dam, dam_type, spell, enemy);
  }

  enemy->StopHuntFor(TO,1);
  StopHuntFor(enemy,1);
  TELLPLAYER("Der Graugnom fluechtet vor Dir.\n");
  TELLOTHERS("Der Graugnom fluechtet vor "+TPN+".\n");
  wandern();
  return 0;
}

