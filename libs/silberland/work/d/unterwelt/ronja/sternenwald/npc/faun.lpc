#include "../def.h"

inherit "std/mnpc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Faun");
  SetProp(P_LONG,
    "Ein Faun. Lustig sieht er ja schon aus, mit seinem Unterleib wie eine "
    "kleine Ziege und dem Oberleib eines Menschen. Und da er auf seinen "
    "Hinterhufen nicht so recht laufen kann, sieht es umso komischer aus "
    "wenn er durch den Wald hoppelt. Allerdings kann er ganz schoen boese "
    "werden, wenn man ihn auslacht. Und seine 2 kleinen Hoerner auf dem Kopf "
    "koennen doch ziemlich gefaehrlich werden. Und der Faun weiss sie "
    "einzusetzen. Aber ansonsten sind Faune recht nette Kerlchen."
  );

  SetProp(P_NAME, "Faun");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:30]));

  AddId(({"faun"}));
  AddClass(CL_ANIMAL); // siehe /sys/class.h

  create_default_npc(10+random(5));
  SetProp(P_HANDS, ({" mit seinen beiden Hoernern",QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Faun");
  SetProp(P_SIZE, 120+random(30));
  SetProp(P_ALIGN, 200+random(200));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,20);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 20);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "hoppelt herein");
  SetProp(P_MSGOUT, "hoppelt");
  SetProp(P_MMSGIN, "kommt hinter einem Baum hervor");
  SetProp(P_MMSGOUT, "versteckt sich schnell");

  SetProp(P_MNPC_AREA, ({ ROOM "wr", ROOM "fr" }) );
  SetProp(P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_OUTDOORS |
                         MOV_INFIGHT );
  SetProp(P_MNPC_WAIT, ({ 120, 90, 30 }) );

  AddInfo(DEFAULT_INFO, "scheint Deine Sprache nicht zu verstehen.\n");

  SetProp(P_REJECT, ({ REJECT_DROP,
    "Der Faun will Deine Sachen nicht tragen.\n" }) );

  AddCmd( ({"lach","lache"}), "cmd_lachen" );
}

int cmd_lachen(string str)
{
  notify_fail("Wen moechtest Du auslachen?\n");

  if(!str || str == "")    return 0;
  if(!(str == "faun aus")) return 0;

  tell_room(ENV(TO),TPN+" lacht den Faun aus.\nDer Faun aergert sich: Na warte!\n");
  Kill(TP);

  return 1;
}



