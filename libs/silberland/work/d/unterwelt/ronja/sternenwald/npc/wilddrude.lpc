#include "../def.h"
#include <npcmaster.h>

inherit "std/mnpc";

int level;
string adstr;

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  level = random(3);
  adstr = ({"jung","alt","ausgewachsen"})[level];

  SetProp(P_SHORT, "Eine "+adstr+"e Wilddrude");
  SetProp(P_LONG,
    "Eine "+adstr+"e Wilddrude mit pechschwarzen Federn. Mit ihren starken "
    "Faengen erlegt sie normalerweise ihre Beute, aber im Kampf sind es "
    "gefuerchtete Waffen. Pechschwarz glaenzen ihre Federn. Mit ihren "
    "scharfen Augen entgeht ihr nichts im Unterholz. "
  );

  SetProp(P_NAME, "Wilddrude");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:30]));

  SetProp(P_NAME_ADJ, adstr );
  AddAdjective( ({adstr+"en",adstr+"er",adstr+"em",adstr+"es",adstr+"e"}) );

  AddId(({"wilddrude","drude"}));
  AddClass(CL_FLYING); // siehe /sys/class.h

  create_default_npc(12+3*level+random(2));
  SetProp(P_HANDS, ({" mit ihren scharfen Krallen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 60+10*level+random(20));
  SetProp(P_ALIGN, -200+random(400));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,10+3*level);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 20);
  SetProp(P_NO_SCORE, 1);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:      -1.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:    -1.0, DT_LIGHT:     0.2, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_NOMAGIC,0);

  SetProp(P_DIE_MSG,  " stuerzt toedlich getroffen auf die Erde.\n");

  SetProp(P_MSGIN, "fliegt ueber deinem Kopf");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "fliegt ueber deinem Kopf");
  SetProp(P_MMSGOUT, "fliegt");

  SetProp(P_MNPC_AREA, ({ ROOM "wr", ROOM "fr" }) );
  SetProp(P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_OUTDOORS );
  SetProp(P_MNPC_WAIT, ({ 60, 30, 30 }) );

  AddInfo(DEFAULT_INFO, "kraechzt nur laut.\n");

  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    " zerreist @WEN in der Luft.\n" }) );

  AddDetail( ({"feder","federn"}) ,
    "Die Federn der Wilddrude sind pechscharz. Schwaerzer noch als die "
    "Umgebung. "
  );

  AddSpecialDetail( ({"umgebung"}) , "detail_umgebung");

  AddDetail( ({"augen"}) ,
    "Mit ihren scharfen Augen entgeht der Wilddrude nichts. Aber auch "
    "gar nichts. "
  );

  AddDetail( ({"krallen","fang","faenge","faengen"}) ,
    "Mit den Faengen schlaegt die Wilddrude ihre Beute. Aber auch im Kampf "
    "stellen sie eine starke Waffe dar. "
  );

  AddDetail( ({"waffe"}) ,
    "Im Kampf nutzt die Wilddrude ihre gefuerchteten Krallen."
  );

}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(enemy->QueryProp(P_LEVEL) - TO->QueryProp(P_LEVEL) < 11)
  {
    return ::Defend(dam, dam_type, spell, enemy);
  }

  enemy->StopHuntFor(TO,1);
  StopHuntFor(enemy,1);
  wandern();
  return 0;
}

string detail_umgebung(string str)
{
  string s;

  s = "Du siehst nichts besonders.";
  if(ENV(TO)) s = ENV(TO)->QueryProp(P_INT_LONG);

  return BS(s);
}

