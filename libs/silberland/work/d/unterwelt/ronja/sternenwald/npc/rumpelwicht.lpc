#include "../def.h"

inherit "std/npc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Rumpelwicht");
  SetProp(P_LONG,
    "Rumpelwichte wohnen normalerweise in Baumhoehlen. Nur selten wohnen "
    "sie in Erdhoehlen, denn selber machen koennen sie sie nicht. Rumpelwichte "
    "kommen so gut wie nie an das Tageslicht. Was hat diesen Rumpelwicht "
    "bloss dazu verleitet, aus der Erde zu kommen? Hat ihn etwas erzuernt?"
  );

  SetProp(P_NAME, "Rumpelwicht");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:30]));

  AddId(({"rumpelwicht","wicht","\nrumpelwicht","NOWIMPY","NOCONTROL"}));
  AddClass(CL_ANIMAL); // siehe /sys/class.h

  create_default_npc(5+random(5));
  SetProp(P_HANDS, ({" mit seinen kleinen Haendchen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Rumpelwicht");
  SetProp(P_SIZE, 20+random(10));
  SetProp(P_ALIGN, 200+random(200));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt davon");
  SetProp(P_MMSGIN, "krabbelt herein");
  SetProp(P_MMSGOUT, "krabbelt davon");

  AddInfo(DEFAULT_INFO, "fragt: Wiesu machst Du unser Dach putt?");

  SetProp(P_REJECT, ({ REJECT_DROP,
    "Der Rumpelwicht will Deine Sachen nicht tragen.\n" }) );

  SetChats(18, ({
     Name(WER)+" ruft: Wiesu denn blus?\n"
    ,Name(WER)+" sagt: Wiesu machst unser Dach putt?\n"
    ,Name(WER)+" schimpft: Wiesu tust Du su?\n"
    ,Name(WER)+" piepst: Macht putt unser Dach, wiesu denn blus?\n"
    ,Name(WER)+" seufzt: Tut den Fuss in unser Dach, wiesu denn blus?\n"
    ,Name(WER)+" piepst: Pfui, pfui, pfui!\n"
  }) );

  SetAttackChats(18, ({
     Name(WER)+" ruft: Wiesu denn blus?\n"
    ,Name(WER)+" sagt: Wiesu machst unser Dach putt?\n"
    ,Name(WER)+" schimpft: Wiesu tust Du su?\n"
    ,Name(WER)+" piepst: Macht putt unser Dach, wiesu denn blus?\n"
    ,Name(WER)+" seufzt: Tut den Fuss in unser Dach, wiesu denn blus?\n"
    ,Name(WER)+" piepst: Pfui, pfui, pfui!\n"
  }) );

  AddCmd( ({"fang","fange"}) , "cmd_fangen");
}

void init()
{
  ::init();
  if(TP && interactive(TP) && TP->QueryProp(P_GHOST)) TP->RemovePursuer(TO);
}

int cmd_fangen(string str)
{
  object ob;

  notify_fail("Was mochtest Du fangen?\n");

  if(!str || str == "") return 0;
  if(!(str == "rumpelwicht"   ||
       str == "rumpelwichte"  ||
       str == "wicht"         ||
       str == "wichte"        )) return 0;


  if(!ob=present("RWQ_NETZ",TP))
  {
    TELLPLAYER("*Autsch* Der Rumpelwicht beisst Dir in den Finger!\n");
    return -1;
  }

  if(ob->QueryRW() > 5)
  {
    TELLPLAYER("In dem Netz befinden sich bereits genug Rumpelwichte.\n");
    return -1;
  }

  if(!random(3))
  {
    TELLPLAYER("Der Rumpelwicht entschluepft Dir geschickt.\n");
    return -1;
  }

  TELLPLAYER("Geschickt faengst Du einen Rumpelwicht und steckst ihn in das Netz.\n");

  ob->AddRW(1);
  ob->RoomMessage();

  RemoveCmd( ({"fang","fange"}) );
  call_out("remove",0);

  return 1;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(member(player->QueryPursuers(),TO) != -1)
  {
    player->RemovePursuers(TO);
    if(ENV(TO)) tell_room(ENV(TO),"Der Rumpelwicht trollt sich von "
                                  "dannen.\n");
    call_out("remove", 0);
  }
}



