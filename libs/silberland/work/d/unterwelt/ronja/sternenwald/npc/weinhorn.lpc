#include "../def.h"

inherit "/std/npc";
inherit "/std/npc/spells";

int    callouts;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein Einhorn");
  SetProp(P_LONG,
    "Vor Dir steht ein zartgliedriger aber dennoch majestaetischer "
    "Einhornhengst. Seine Bewegungen sind voller Anmut und Kraft. Sein "
    "wunderschoenes, gewundenes Horn scheint die Sterne selbst zu "
    "beruehren. Sein Fell, seine Maehne, und sein Schweif strahlen in "
    "einem extrem hellen Weiss und sein Blick verraet Weisheit und Guete "
    "gleichermassen. "
  );

  SetProp(P_NAME, "Einhornhengst");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:40]));
  AddId(({"einhorn","einhornhengst","hengst",
          "\nSTERNENWALDEINHORN","\nWEISSESEINHORN"}) );

  AddClass(CL_ANIMAL);

  SetProp(P_FARBE, T_WEISS);
  SetProp(P_GESCHLECHT, T_HENGST);

  SetProp(P_NAME_ADJ, "weiss");
  AddAdjective( ({"weissem","weissen","weisses","weisser"}) );

  create_default_npc(45);
  SetProp(P_RACE, "Einhorn");
  SetProp(P_SIZE, 180+random(30));
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_WEIGHT,250000);
  SetProp(P_HEAL,0);
  SetProp(P_HANDS, ({" mit seinem Horn",QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_GENDER,MALE);
  SetProp(P_TRANSPARENT,0);
  SetProp(P_WIMPY,0);

  SetProp(P_MMSGIN, "galoppiert herein");
  SetProp(P_MMSGOUT,"galoppiert davon");

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.5
     , DT_HOLY:     -0.2, DT_UNHOLY:    1.0, DT_MAGIC:      -1.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_SPELLRATE, 50);

  AddSpell(3, 600,
    "Das Einhorn schlaegt mit seinen Hufen aus und trifft Dich.\n",
    "Das Einhorn schlaegt mit seinen Hufen aus und trifft @WEN.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 450, DS_MASS_BLIND,
    "Ein extremes Leuchten geht vom Einhorn aus.\n",
    "Ein extremes Leuchten geht vom Einhorn aus.\n",10);

  AddDefaultSpell(1, 200, DS_PARALYZE,
    "Das Einhorn beruehrt Dich mit dem Horn und Du erstarrst zu Stein.\n",
    "Das Einhorn beruehrt @WEN mit dem Horn und @WER erstarrt zu Stein.\n");

  AddSpell(1,1,
    "Die Spitze des Horns leuchtet rot auf.\n",
    "Die Spitze des Horns leuchtet rot auf.\n",
    DT_MAGIC, "spell_heilen"
  );

  AddSpell(2,1,
    "Das Einhorn schleudert Dich mit einem gezielten Tritt hinfort.\n",
    "Das Einhorn schleudert @WEN mit einem gezielten Tritt hinfort.\n",
    DT_BLUDGEON, "wegschleudern");

  AddInfo(DEFAULT_INFO, "wiehert Dich freudig an.\n");

  SetChats(3,
   ({"Das Einhorn wiehert laut.\n"
    ,"Das Einhorn schnaubt.\n"
    ,"Das Einhorn senkt seinen Kopf und zeigt mit dem Horn auf Dich.\n"
    ,"Das Einhorn hebt sein Horn zum Himmel.\n"
    })
  );

  SUID;

  CLONEME(WEAPON "whorn");

  callouts = 0;
}

void reset()
{
  ::reset();

  callouts = 0;
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(interactive(enemy) && (enemy->QueryProp(P_LEVEL) < 20))
  {
    TELLPLAYER(BSI("Werd' erst einmal gross.",Name(WER,1)+" laechelt Dich "
                   "freundlich an: "));
    TELLOTHERS(Name(WER,1)+" laechelt "+TPN+" freundlich an.\n");
    enemy->StopHuntFor(TO,1);
    StopHuntFor(enemy,1);
    return 0;
  }

  if(!random(6))
  {
    TELLPLAYER(Name(WER,1)+" senkt seinen Kopf und wirft Deinen Angriff "
               "auf Dich zurueck!\n");
    TELLOTHERS(Name(WER,1)+" senkt seinen Kopf und wirft den Angriff von "
               +TP->name(WEM)+" zurueck!\n");
    enemy->Defend(dam,dam_type,spell,TO);
    return ::Defend(0,dam_type,spell,enemy);
  }

  return ::Defend(dam,dam_type,spell,enemy);
}

void wegschleudern(object enemy, int damage, mixed dam_type)
{
  object *rooms;

  enemy->Defend(1000, dam_type, ([SP_SHOW_DAMAGE:1]), TO);

  if(enemy->QueryProp(P_GHOST)) return;

  rooms = m_values(MENV->QueryProp(P_EXITS));
  if(!sizeof(rooms)) return;

  enemy->move(rooms[random(sizeof(rooms))], M_GO,
    "vom Einhorn fortgeschleudert", "wird",
    "fliegt in hohem Bogen herein");
  enemy->SetProp(P_PARALYZED, 10);
}

void spell_heilen(object enemy, int damage, mixed dam_type)
{
  int n;

  if(QueryProp(P_HP) > 2*QueryProp(P_MAX_HP)/3) return;
  n = (random(100)+100);
  if(n > QueryProp(P_SP)) n = QueryProp(P_SP);
  AddSp(-n);
  AddHp(n/5);
}

varargs void die(int poisondeath)
{
  object enemy, horn;

  horn = present("\nEINHORNHORN",TO);
  if(horn && !random(10))
  {
    horn->remove();

    if(ENV(TO))
    {
      tell_room(ENV(TO),BS("Das Horn des Einhornes erlischt und zerfaellt zu "
                           "Sternenstaub."));
    }
  }

  if(enemy=QueryProp(P_KILLER))
  {
    SWMASTER->Msg(CAP(Name(WER,1))+" wurde von "+CAP(getuid(enemy))+" umgebracht");
    if(interactive(enemy)) KMASTER->SetUnicornKill(getuid(enemy));
  }

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    SWMASTER->Msg(Name(WER,1)+" hat gerade "+UID(player)+" umgebracht");
  }

  return;
}

void lpweg(object pl)
{
  pl->AddHP(-15);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(callouts > 5) return;
  callouts++;

  switch (gruppe)
  {
    case "fies":
      Kill(TP);
      break;

    case "frech":
      call_out("react", 0, TP,
        "wirft Dir einen veraechtlichen Blick zu",
        "wirft "+TPN+" einen veraechtlichen Blick zu"
      );
      break;

    case "traurig":
      call_out("react", 0, TP,
        "reibt seinen Kopf an deiner Schulter",
        "reibt seinen Kopf an "+TP->Name(WESSEN)+" Schulter"
      );
      break;

    case "neutral":
      call_out("react", 0, TP,
        "schnaubt kurz",
        "schaut "+TPN+" unschluessig an"
      );
      break;

    case "nett":
      call_out("react", 0, TP,
        "wackelt mit den Ohren",
        "wackelt mit den Ohren"
      );
      break;

    case "albern":
      call_out("react", 0, TP,
        "wiehert Dich an. Oder lacht er Dich aus?",
        "wiehert "+TPN+" an");
      break;

    case "aengstlich":
      call_out("react", 0, TP,
        "geht ein paar Schritte zurueck",
        "geht ein paar Schritte zurueck"
      );
      break;

    case "intim":
      call_out("react", 0, TP,
        "schlabbert Dich mit seiner Zunge ab",
        "schlabbert "+TPN+" mit seiner Zunge ab"
      );
      break;

    case "froh":
      call_out("react", 0, TP,
        "wiehert froehlich",
        "wiehert froehlich"
      );
      break;

    case "aergerlich":
      call_out("react", 0, TP,
        "schnaubt boese auf, dreht sich um und tritt mit den Hinterhufen "
        "nach Dir",
        "schnaubt boese auf, dreht sich um und tritt mit den Hinterhufen "
        "nach "+TPN
      );
      call_out("lpweg",0,TP);
      break;

    default:
      callouts--;
      break;
  }
}

void react(object to, string vic, string oth)
{
  if (present(to, ENV(TO))) {
    tell_object(to, BS(Name(WER, 1)+" "+vic+"."));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+oth+"."), ({to}));
  }
  callouts--;
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

