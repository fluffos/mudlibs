#include "../def.h"

inherit "std/npc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine kleine Raupe");
  SetProp(P_LONG,
    "Eine kleine Raupe, die kurz vor dem verpuppen steht. Richtig dick und "
    "fett ist sie, und auf ihrem Ruecken hat sie kleine, aber giftig "
    "aussehende Stacheln. "
  );

  SetProp(P_NAME, "Raupe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"raupe", "seidenraupe"}));

  create_default_npc(3);
  SetProp(P_HANDS, ({" mit ihren giftigen Stacheln", 30, DT_POISON}));
  SetProp(P_RACE, "Raupe");
  SetProp(P_SIZE, 10);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_WEIGHT, 10);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "kriecht her");
  SetProp(P_MMSGOUT, "kriecht weg");

  SetProp(P_DIE_MSG,  " wird zerquetscht.\n");
  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Raupe kann Deine Sachen doch gar nicht tragen.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -1.0, DT_COLD:     -1.0, DT_WATER:      -1.0
     , DT_AIR:      -1.0, DT_LIGHTNING:-1.0, DT_EXPLOSION:   0.5
     , DT_SOUND:    -1.0, DT_LIGHT:    -1.0, DT_ELECTRIC:   -1.0
     , DT_ACID:     -1.0, DT_POISON:   -1.0, DT_TERROR:     -1.0
     , DT_HOLY:     -1.0, DT_UNHOLY:   -1.0, DT_MAGIC:      -1.0
     , DT_MIND:     -1.0, DT_SLASH:    -1.0, DT_BLUDGEON:   -1.0
     , DT_PIERCE:   -1.0, DT_SQUEEZE:   0.5, DT_WHIP:       -1.0
     , DT_RIP:      -1.0
     ])
  );

  SUID;

  CLONEME("/p/std/skills/sewing_tanning/obj/raupenseide");

  AddCmd( ({"zertrete","zertritt","zertret"}), "cmd_zertreten");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(random(600)<enemy->QueryProp(P_SIZE) )
  {
    tell_object(enemy,"Die Raupe ist so klein, dass Du sie gar nicht triffst.\n");
    return ::Defend(0, dam_type, spell, enemy);
  }

  return ::Defend(dam/4, dam_type, spell, enemy);
}

int cmd_zertreten(string str)
{
  object *schuhe;
  int dam;

  notify_fail("Wen willst Du zertreten?\n");

  if(!id(str)) return 0;

  if(TP->QueryProp(P_ATTACK_BUSY))
  {
    TELLPLAYER("He! Nicht so schnell!\n");
    return 2;
  }

  TP->SetProp(P_ATTACK_BUSY, 2);

  schuhe=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_BOOT);
  if(sizeof(schuhe) && objectp(schuhe[0]))
  {
    TELLPLAYER("Du zertrittst die Raupe.\n");
    TELLOTHERS(CAP(TPN)+ " zertritt eine Raupe.\n");

    dam = 2000 + random( schuhe[0]->QueryProp(P_WEIGHT) *
          TP->QueryAttribute(A_STR) );

    ::Defend(dam/100, DT_SQUEEZE, 0, TP);
    return 1;
  }

  TELLPLAYER(BS("Schmerzhaft trittst Du mit blossen Fuessen auf die "
                "Raupe. Ob das eine gute Idee war?"));
  TP->AddHp(-5-random(10));

  return -1;
}
