#include "../def.h"

inherit "std/mnpc";

#define LF "\n"

// ----- Globale Variablen

string *angreifer;  //  Liste der hochgradigen Spieler, die den Geist bereits
                    //  einmal angegriffen haben

string *troom;      //  liste der teleportraeume

int nroom;

void loesche_angreifer(object enemy)
{
  if(member(angreifer,getuid(enemy)) > -1)
    angreifer -= ({ getuid(enemy) });
}

int    stufe;
string ltext, idtext, idblum;

void create()
{

  if (!is_clone(this_object())) return;

  ::create();

  troom = ({"/d/ebene/lostboy/steppe/room/steppe9"
           ,"/d/gebirge/monimor/room/gang"
           ,"/d/dschungel/feyaria/felseninsel/room/klippe"
           ,"/d/dschungel/dante/weg/room/vorsprung2"
           ,"/d/dschungel/feyaria/dorf/room/lich-003"
           ,"/d/ebene/Silberwald/room/erde5"
           });

  nroom = sizeof(troom);
  angreifer = ({});

  //  Die Kampfwerte der NPCs muessen noch gesetzt werden. Sie sollten so gestaltet sein,
  //  dass der jeweilige NPC fuer einen Spieler gleicher Stufe ein bezwingbarer Gegner
  //  ist.

  ltext  = "Ein durchscheinendes, kleines Wesen, das durch den Wald "
           "schwebt. In seinem Inneren, pulsierend wie ein Herz, ";

  switch(1 + random(45))
  {
    case 1..3:
      ltext += "ein winziges Gaensebluemchen.";
      idtext = "gaensebluemchengeist";
      idblum = "gaensebluemchen";
      stufe  = 2;
      break;

    case 4..6:
      ltext += "eine winzige Sternblume.";
      idtext = "sternblumengeist";
      idblum = "sternblume";
      stufe  = 2;
      break;

    case 7..9:
      ltext += "ein winziges Vergissmeinnicht.";
      idtext = "vergissmeinnichtgeist";
      idblum = "vergissmeinnicht";
      stufe  = 3;
      break;

    case 10..12:
      ltext += "eine winzige Kornblume.";
      idtext = "kornblumengeist";
      idblum = "kornblume";
      stufe  = 3;
      break;

    case 13..15:
      ltext += "ein winziges Veilchen.";
      idtext = "veilchengeist";
      idblum = "veilchen";
      stufe  = 4;
      break;

    case 16..18:
      ltext += "ein winziges Schneegloeckchen.";
      idtext = "schneegloeckchengeist";
      idblum = "schneegloeckchen";
      stufe  = 4;
      break;

    case 19..21:
      ltext += "ein kleiner Loewenzahn.";
      idtext = "loewenzahngeist";
      idblum = "loewenzahn";
      stufe  = 5;
      break;

    case 22..24:
      ltext += "eine kleine Butterblume.";
      idtext = "butterblumengeist";
      idblum = "butterblume";
      stufe  = 5;
      break;

    case 25..28:
      ltext += "eine kleine Schluesselblume.";
      idtext = "schluesselblumengeist";
      idblum = "schluesselblume";
      stufe  = 6;
      break;

    case 29..31:
      ltext += "eine kleine Glockenblume. ";
      idtext = "glockenblumengeist";
      idblum = "glockenblume";
      stufe  = 7;
      break;

    case 32..33:
      ltext += "ein Hahnenfuss.";
      idtext = "hahnenfussgeist";
      idblum = "hahnenfuss";
      stufe  = 8;
      break;

    case 34..36:
      ltext += "eine Margerite.";
      idtext = "margeritengeist";
      idblum = "margerite";
      stufe  = 9;
      break;

    case 37..38:
      ltext += "ein Enzian.";
      idtext = "enziangeist";
      idblum = "enzian";
      stufe  = 10;
      break;

    case 39..40:
      ltext += "eine gelb-orange Tulpe.";
      idtext = "tulpengeist";
      idblum = "tulpe";
      stufe = 11;
      break;

    case 41..42:
      ltext += "eine weisse Lilie.";
      idtext = "liliengeist";
      idblum = "lilie";
      stufe  = 12;
    break;

    case 43..44:
      ltext += "eine blutrote Rose.";
      idtext = "rosengeist";
      idblum = "rose";
      stufe  = 13;
    break;

    case 45:
      ltext += "eine leuchtende, violett-gelbe Orchidee.";
      idtext = "orchideengeist";
      idblum = "orchidee";
      stufe  = 14;
      break;

    default:
      break;
  }

  SetProp(P_SHORT, "Ein "+CAP(idtext));
  SetProp(P_LONG, ltext);
  SetProp(P_NAME, CAP(idtext));

  SetProp(P_GENDER, MALE);
  AddId( ({"geist","blumengeist",idtext}) );

  create_default_npc(stufe);
  SetProp(P_HANDS, ({" mit etwas, das wie Haende aussieht,",QueryProp(P_HANDS)[1],
                     DT_BLUDGEON}));
  SetProp(P_ALIGN, 250 + random(30) * stufe);
  SetProp(P_RACE, "Blumengeist");
  SetProp(P_NOCORPSE, 1);

  SetProp(P_SIZE, stufe*10);
  SetProp(P_MAX_HANDS, 4);

  SetProp(P_MSGIN, "schwebt um Dich herum");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt");
  SetProp(P_MMSGOUT, "schwebt hinfort");

  SetProp(P_DIE_MSG,  " verpufft lautlos.\n");
  AddInfo(DEFAULT_INFO, "scheint Dich nicht hoeren zu koennen.\n");

//  Die Geister sollen sich im Sternenwald bewegen koennen. Dazu die
//  Einstellungen fuer MNPCs.

  SetProp(P_MNPC_AREA, ({ ROOM "wr", ROOM "fr" }) );
  SetProp(P_MNPC_FLAGS, MOV_MOVES | MOV_BACKWARDS | MOV_OUTDOORS |
                         MOV_INFIGHT );
  SetProp(P_MNPC_WAIT, ({ 90, 90, 30 }) );

//  SetProp(P_REJECT, ({ REJECT_DROP,
//    "Deine Sachen fallen einfach durch den Blumengeist hindurch.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

}

// ----- Bei einem Angriff auf einen Blumengeist soll fuer hochgradige Spieler
//       zunaechst eine Warnung erfolgen, und beim zweiten Versuch etwas
//       unangenehmes passieren.

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  string s;

  //  Bei Spielern, die weniger als 11 Stufen ueber dem NPC liegen,
  //  gibts nur den normalen Kampf

  if(!interactive(enemy) ||
     (enemy->QueryProp(P_LEVEL) - TO->QueryProp(P_LEVEL) < 11))
  {
    return ::Defend(dam, dam_type, spell, enemy);
  }

  if(!IsEnemy(enemy))
  {
    // NPC hat sich Spieler noch nicht gemerkt (1. Angriff)
    if(member(angreifer,getuid(enemy)) == -1)
    {
      tell_object(enemy,
        LF+BS("Du willst wirklich diesen schwaechlichen Gegner "
              "angreifen? Schaem Dich!! Er hat doch nicht die geringste "
              "Chance gegen Dich, Du Feigling. Aber bitte, wenn Du "
              "unbedingt willst, dann tu es. Aber wundere Dich nicht, "
              "wenn das in einem Wald wie diesem Konsequenzen hat..."));

      // Angreifer merken. Beim naechsten Angriff passiert etwas anderes.
      angreifer += ({ getuid(enemy) });

      // Der Blumengeist merkt sich einen Angriff 60 Sekunden.
      call_out("loesche_angreifer", 60, enemy);

      // Kampf fuer den Spieler beenden
      enemy->StopHuntFor(TO,1);
      StopHuntFor(enemy,1);

      return 0;
    }
    else
    {
      // In 33% Der Angriffe wird der Spieler irgendwohin teleportiert.
      if(random(3) == 2)
      {
        tell_object(enemy,
          BS("Ploetzlich hoerst Du in Deinem Kopf eine dunkle "
             "droehnende Stimme: 'Ein Feigling wie Du hast in meinem "
             "Wald nichts verloren. VERSCHWINDE HIER!'"));

        tell_object(enemy,
          BS("Dann verlierst Du voellig die Orientierung, "
             "als Dich eine gewaltige Macht davon schleudert."));

        tell_room(ENV(TO),
          BS(enemy->name(WER)+" loest sich vor Deinen Augen "
             "ploetzlich in Nichts auf und ist einfach weg."), ({enemy}) );

        enemy->StopHuntFor(TO,1);
        StopHuntFor(enemy,1);

        enemy->move(troom[random(nroom)],M_TPORT,
                    "","","erscheint mit einem *PUFF*");

        return 0;
      }
    }
  }

  // Alle Angriffe hoehergradiger Spieler sind schlichtweg erfolglos. Man
  // koennte allenfalls mitloggen, wie lange sie es trotzdem versuchen...

  s = ({"Der Blumengeist weicht geschickt aus."
       ,"Der Blumengeist versteckt sich im Unterholz."
       ,"Der Angriff bleibt einfach ohne Wirkung."
       ,"Der Blumengeist loest sich kichernd auf."
       ,"Der Blumengeist schwebt aus Deiner Reichweite."
       })[random(5)];

  tell_object(enemy, BS(s));
  return ::Defend(0, dam_type, spell, enemy);
}

void die(int poisondeath)
{
  object ob;

  ob = clone_object(OBJ "blumenherz");
  if (ob)
  {
    ob->move(TO,M_NOCHECK|M_SILENT);
    ob->Customize(idblum);
  }
  ::die( poisondeath);
}

give_notify(ob)
{
  object room;

  if(!room=ENV(TO))
  {
    ob->remove();
  }
  else
  {
    tell_room(room,BS(ob->Name(WER)+" faellt einfach durch den Geist "
                         "hindurch."));
    ob->move(room,M_PUT|M_SILENT);
  }
  return 0;
}

