inherit "std/npc";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Nymphe");
  SetProp(P_LONG,
    "Diese Nymphe hat sich hier im Sternenwald in diesem Teich ein Zuhause "
    "geschaffen. Nymphen sind mit den Nixen verwandt, leben aber wie diese "
    "nicht im Meer, sondern in kleineren bis mittleren Teichen. Diese Nymphe "
    "hier hat langes, blondes Haar und laechelt Dich an. "
  );

  SetProp(P_NAME, "Nymphe");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));

  AddId(({"nymphe", "wassernymphe", "nixe"}));
  AddClass(CL_FAIRY); // siehe /sys/class.h

  SetProp(P_RACE, "Nixe");
  SetProp(P_SIZE, 160);
  SetProp(P_WEIGHT, 56000);
  SetProp(P_ALIGN, 350);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_DIE_MSG,  " verschwindet in den Tiefen des Teiches.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "singt nur leise vor sich hin.\n");

  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    "Die Nymphe versenkt Deine Sachen im Teich.\n" }) );

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit Gesang an",QueryProp(P_HANDS)[1],DT_SOUND}));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:     -1.0, DT_COLD:     -1.0, DT_WATER: -1.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.3, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.2, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_SPELLRATE,25);

  AddSpell(1,1,
    Name(WER,1)+" beschwoert eine riesige Wasserwoge aus der Quelle.\n",
    Name(WER,1)+" beschwoert eine riesige Wasserwoge aus der Quelle.\n",
    DT_WATER, "spell_water"
  );

  SUID;
}

void spell_water(object enemy, int damage, mixed dam_type)
{
  enemy->ModifySkillAttribute(TO, SA_SPEED, 10, 10);
  enemy->Defend(300, dam_type, 0, TO);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(interactive(enemy) &&
     ((enemy->QueryProp(P_LEVEL)+10) < TO->QueryProp(P_LEVEL)))
  {
    TELLPLAYER(BSI("Werd' erst einmal gross.",Name(WER,1)+" laechelt Dich "
                   "freundlich an: "));
    TELLOTHERS(Name(WER,1)+" laechelt "+TPN+" freundlich an.\n");
    enemy->StopHuntFor(TO,1);
    StopHuntFor(enemy,1);
    return 0;
  }

  return ::Defend(dam,dam_type,spell,enemy);
}

varargs void die(int poisondeath)
{
  object enemy,room,ob;

  if(room=ENV(TO))
  {
    tell_room(room,BS("Die Nymphe springt in die Quelle, dabei wird etwas an "
                      "das Ufer gespuelt. "));

    switch(random(9))
    {
      case 0 :
        ob = clone_object(OBJ "hf");
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

      case 1 :
        GEMMASTER->DistributeGem(1,1,1,room);
        break;

      case 2 :
        ob = clone_object("/obj/money");
        ob->AddAmount(150+random(150));
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

      case 3 :
        ob = clone_object("/d/unterwelt/zordan/dhrkion/armour/weste");
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

      case 4 :
        ob = clone_object("/d/unterwelt/basics/central/obj/erz");
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

      case 5 :
        ob = clone_object("/d/unterwelt/basics/central/obj/brocken");
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

      case 6 :
        ob = clone_object("/d/unterwelt/basics/central/obj/splaetz");
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

      case 7 :
        ob = clone_object(ARMOUR "chitinhose_alt");
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

      case 8 :
        ob = clone_object(ARMOUR "seidenguertel");
        ob->move(room,M_NOCHECK|M_SILENT);
        break;

    }
  }

  ::die(poisondeath);
}

