#include "../def.h"

inherit "/p/std/dragons/dragon.lpc";
inherit "/std/npc/spells";

#define HIGH_DAMAGE 150
#define LOW_DAMAGE 70

int     age,level,align,scales;
mapping std_resistance;

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  level  = 0;
  age    = 11;
  align  = 1;
  scales = 25 + random(15);

  create_default_dragon(level,age,align,scales);

  SetProp(P_SHORT,"Tanniym Jrz Astabegetazztrax, der Regenbogendrache");
  SetProp(P_LONG,
    "Vor Dir steht der Regenbogendrachen. Du kannst gar nicht sagen, "
    "welche Farbe er denn nun hat, denn mal ist er blau, dann wieder rot. "
    "Seine Farbenspiel umfasst das gesamte Spektrum des Regenbogens und "
    "zwischendurch leuchtet er irrisierend wie ein Regenbogen in allen "
    "Farben auf. Ob das sein Gemuet wiederspiegelt? Oder ob es nur eine Laune "
    "der Natur ist?\n"
    "Es sieht so aus, als ob der Drache auf etwas langem liegen wuerde, "
    "so als ob er es bewachen oder beschuetzen wuerde."
  );

  AddId(({"tanniym", "jrz", "astabegetazztrax","tanniym jrz astabegetazztrax",
          "regenbogendrache"}));
  set_living_name("astabegetazztrax");

  SetProp(P_NAME, "Astabegetazztrax");
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME_ADJ, 0);
  SetProp(P_SIZE, 15000);

  SetProp(P_SPELLS,0);

  SetProp(P_SPELLRATE,55);


  AddDetail( ({"etwas","langes","etwas langes"}) ,
    "Du kannst es nicht genau erkennen, aber es sieht fast aus wie Lanze."
  );

  AddDetail( ({"lanze"}) ,
    "Sollte dies etwa... sollte dies wirklich... Du fragst Dich, ob das "
    "vielleicht die sagenumworbene Eisschattenlanze sein koennte. "
  );

  AddDetail( ({"eisschattenlanze"}) ,
    "Du wuerdest alles daran setzen, diese Lanze zu bekommen."
  );

  AddDefaultSpell(1,500,DS_FEAR);

  AddSpell(2,1,
    BS("Der Regenbogendrache faerbt sich violett und laesst die Luft "
       "um Dich herum gefrieren."),
    BS("Der Regenbogendrache faerbt sich violett und laesst die Luft "
       "um @WEN herum gefrieren."),
    ({DT_COLD}),"spell_ice"
  );

  AddSpell(2,1,
    BS("Der Regenbogendrache faerbt sich blau und laesst eine Wasserhose "
       "um Dich herum entstehen."),
    BS("Der Regenbogendrache faerbt sich blau und laesst eine Wasserhose "
       "um @WEN herum entstehen."),
    ({DT_WATER}),"spell_water"
  );

  AddSpell(2,1,
    BS("Der Regenbogendrache faerbt sich gruen und huellt Dich in eine "
       "Giftwolke ein."),
    BS("Der Regenbogendrache faerbt sich gruen und huellt @WEN in eine "
       "Giftwolke ein."),
    ({DT_ACID}),"spell_poison"
  );

  AddSpell(2,1,
    BS("Der Regenbogendrache faerbt sich gelb und entfacht einen Sturm "
       "um Dich herum."),
    BS("Der Regenbogendrache faerbt sich gelb und entfacht einen Sturm "
       "um @WEN herum."),
    ({DT_AIR}),"spell_sturm"
  );

  AddSpell(2,1,
    BS("Der Regenbogendrache faerbt sich rot und stoesst einen Flammenball "
       "aus."),
    BS("Der Regenbogendrache faerbt sich rot und stoesst einen Flammenball "
       "aus."),
    ({DT_FIRE}),"spell_flammenball"
  );

  AddSpell(1,1,
    "Der Drache schleudert Dir seinen Schwanz entgegen.\n",
    "Der Drache schleudert @WEM seinen Schwanz entgegen.\n",
    ({DT_BLUDGEON}), "spell_wegschleudern"
  );

  std_resistance = QueryProp(P_RESISTANCE_STRENGTHS);

  CLONEME(WEAPON "elanze");
}

void spell_ice(object enemy, int damage, mixed dam_type)
{
  int f;

  f = random(HIGH_DAMAGE - LOW_DAMAGE) + LOW_DAMAGE;

  SetProp(P_RESISTANCE_STRENGTHS , std_resistance+([DT_COLD:-0.9]));
  enemy->Defend(f*age+60, dam_type, ([SP_SHOW_DAMAGE:1]), TO);
}

void spell_water(object enemy, int damage, mixed dam_type)
{
  int f;

  f = random(HIGH_DAMAGE - LOW_DAMAGE) + LOW_DAMAGE;

  SetProp(P_RESISTANCE_STRENGTHS , std_resistance+([DT_WATER:-0.9]));
  enemy->Defend(f*age+60, dam_type, ([SP_SHOW_DAMAGE:1]), TO);
}

void spell_poison(object enemy, int damage, mixed dam_type)
{
  int f;

  f = random(HIGH_DAMAGE - LOW_DAMAGE) + LOW_DAMAGE;

  SetProp(P_RESISTANCE_STRENGTHS , std_resistance+([DT_POISON:-0.9]));
  enemy->Defend(f*age+60, dam_type, ([SP_SHOW_DAMAGE:1]), TO);
}

void spell_sturm(object enemy, int damage, mixed dam_type)
{
  int f;

  f = random(HIGH_DAMAGE - LOW_DAMAGE) + LOW_DAMAGE;

  SetProp(P_RESISTANCE_STRENGTHS , std_resistance+([DT_AIR:-0.9]));
  enemy->Defend(f*age+60, dam_type, ([SP_SHOW_DAMAGE:1]), TO);
}

void spell_flammenball(object enemy, int damage, mixed dam_type)
{
  int f;

  f = random(HIGH_DAMAGE - LOW_DAMAGE) + LOW_DAMAGE;

  SetProp(P_RESISTANCE_STRENGTHS , std_resistance+([DT_FIRE:-0.9]));
  enemy->Defend(f*age+60, dam_type, ([SP_SHOW_DAMAGE:1]), TO);
}

void spell_wegschleudern(object enemy, int damage, mixed dam_type)
{
  object *rooms;
  int f;

  f = random(HIGH_DAMAGE - LOW_DAMAGE) + LOW_DAMAGE;

  SetProp(P_RESISTANCE_STRENGTHS , std_resistance+([DT_BLUDGEON:-0.9]));
  enemy->Defend(f*age+200, dam_type, ([SP_SHOW_DAMAGE:1]), TO);

  if(enemy->QueryProp(P_GHOST)) return;

  rooms = m_values(MENV->QueryProp(P_EXITS));
  if(!sizeof(rooms)) return;

  enemy->move(rooms[random(sizeof(rooms))], M_GO,
    "wird vom Drachen fortgeschleudert", "",
    "fliegt in hohem Bogen herein");
  enemy->SetProp(P_PARALYZED, 10);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(interactive(enemy) && enemy->QueryProp(P_LEVEL) < 20)
  {
    TELLPLAYER(BSI("Werd' erst einmal gross.","Der Drache laechelt Dich "
                   "mitleidig an: "));
    TELLOTHERS("Der Drache laechelt "+TPN+" mitleidig an.\n");
    enemy->StopHuntFor(TO,1);
    StopHuntFor(enemy,1);
    return 0;
  }

  if(!random(20))
  {
    TELLPLAYER(Name(WER,1)+" leuchtet in allen Farben auf und wirft Deinen "
               "Angriff auf Dich zurueck!\n");
    TELLOTHERS(Name(WER,1)+" leuchtet in allen Farben auf und wirft "+
               TP->name(WESSEN)+" Angriff zurueck!\n");
    enemy->Defend(dam,dam_type,spell,TO);
    return ::Defend(0,dam_type,spell,enemy);
  }

  return ::Defend(dam,dam_type,spell,enemy );
}

varargs void die(int poisondeath)
{
  object enemy;

  if(objectp(enemy=QueryProp(P_KILLER)) && !IS_WIZARD(enemy))
  {
    SWMASTER->Msg(Name(WER,1)+" wurde von "+CAP(getuid(enemy))+" umgebracht");
    if(interactive(enemy)) KMASTER->SetDragonKill(getuid(enemy));
  }

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)
  {
    SWMASTER->Msg(Name(WER,1)+" hat gerade "+UID(player)+" umgebracht, XP : "+lostexp);
  }
  return;
}

