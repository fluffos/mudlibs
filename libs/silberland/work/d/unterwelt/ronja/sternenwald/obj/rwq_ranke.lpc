#include "../def.h"
#include "properties.h"
#include "language.h"

inherit "std/unit";

string owner;

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Eine lange Ranke");
  SetProp(P_LONG,
    "Die lange Ranke einer Dir unbekannten Pflanze. Die ist ganz schoen "
    "klebrig. Mit ihren ineinander verdrillten Fasern erinnert sie an "
    "ein Seil. Aber dazu ist sie, obwohl sie ziemlich reissfest zu sein "
    "scheint, doch etwas zu duenn. Vielleicht kann man aus diesen "
    "Ranken ja trotzdem etwas knuepfen oder flechten."
  );

  SetProp( P_NAME, ({"Ranke","Ranken" }) );
  AddId( ({ "ranke", "RWQ_Ranke" }) );

  AddSingularId( ({"ranke"}) );
  AddPluralId( ({"ranken"}) );
  AddId( ({"RWQ_RANKE"}) );

  SetProp(P_NAME_ADJ, ({"lang"}) );
  AddAdjective( ({"langen","langer","langem","langes","lange"}) );

  SetProp(P_GENDER, FEMALE);

  SetCoinsPerUnits(5,1);
  SetGramsPerUnits(150,1);

  AddCmd( ({ "knuepf", "knuepfe" })                        , "cmd_knuepfen");
  AddCmd( ({ "mach", "mache", "dreh", "drehe", "flechte" }), "cmd_flechten");

  owner = 0;
}

string SetOwner(object pl)
{
  return (owner = getuuid(pl));
}

string QueryOwner()
{
  return owner;
}

void removeme(object player)
{
  if(QueryProp(P_AMOUNT) == 0) return;

  if(QueryProp(P_AMOUNT) == 1)
  {
    tell_object(player,BS("Als Du die Ranke nimmst, zerfaellt diese in "
                          "zahllose Blaetter, Fasern und Stengel. Die Ranke "
                          "war wohl schon ziemlich welk."));

    tell_room(ENV(player),BS("Als "+TPN+" die Ranke nimmt, zerfaellt diese "+
                             "in zahllose Stengel, Blaetter und Fasern. War "
                             "wohl doch schon ziemlich verwelkt, die Ranke. "
                             "So ein Pech aber auch."),
                            ({ player }) );
  }
  else
  {
    tell_object(player,BS("Als Du die Ranken nimmst, zerfallen diese in "
                          "zahllose Blaetter, Fasern und Stengel. Die Ranken "
                          "waren wohl schon ziemlich welk."));

    tell_room(ENV(player),BS("Als "+TPN+" die Ranken nimmt, zerfallen diese "
                             "in zahllose Stengel, Blaetter und Fasern. Waren "
                             "wohl doch schon ziemlich verwelkt, die Ranken. "
                             "So ein Pech aber auch."),
                            ({ player }) );

  }

  SetProp(P_AMOUNT,0);
}

void init()
{
  ::init();

  if(!TP)              return;
  if(!interactive(TP)) return;

  if(!owner) owner = getuuid(TP);
  if(owner != getuuid(TP)) call_out("removeme",0,TP);
}

int cmd_knuepfen(string str)
{
  int     anz_ranken;
  object  netz;

  notify_fail( "Was moechtest Du aus der Ranke knuepfen?\n");
  if(!str || str == "") return 0;

  if(str == "seil"             ||
     str == "seil aus ranke"   ||
     str == "seil aus ranken"   )
  {
    tell_object(TP,BS("Ein Netz wird geknuepft. Ein Seil wuerde man "
                      "wohl eher flechten. Und aus zweien dieser Ranken laesst "
                      "sich bestimmt ein recht gutes Seil flechten."));
    return 1;
  }

  if(str == "netz"            ||
     str == "netz aus ranke"  ||
     str == "netz aus ranken"  )
  {
    if(present("RWQ_NETZ", TP))
    {
      tell_object(TP, BS("Du hast doch schon ein Netz! Zwei brauchst Du "
                         "nun wirklich nicht. "));
      return -1;
    }

    anz_ranken = QueryProp(P_AMOUNT);

    switch (anz_ranken)
    {
    case 1:
      tell_object(TP,BS("Aus einer Ranke?? Da fehlen Dir aber noch jede "
                        "Menge."));
      break;

    case 2:
    case 3:
      tell_object(TP,BS("Mit so wenigen Ranken?? Da fehlen Dir aber noch "
                        "jede Menge."));
      break;

    case 4:
      write( break_string( "Mit so wenigen Ranken? Du schaetzt, dass Du etwa"
             " noch einmal so viele Ranken fuer ein vernuenftiges Netz"
             " brauchst."));
      break;

    case 5:
    case 6:
      tell_object(TP,BS("Die Ranken, die Du hast, reichen dafuer noch "
                        "nicht. Du schaetzt, dass Du noch zwei oder drei "
                        "weitere fuer ein vernuenftiges Netz brauchst."));
      break;

    case 7:
      tell_object(TP,BS("Die Ranken, die Du hast, reichen dafuer noch "
                        "nicht. Du schaetzt, dass Du noch eine oder zwei "
                        "weitere fuer ein vernuenftiges Netz brauchst."));
      break;

    default:
      tell_object(TP,BS("Du bist Dir ziemlich sicher, das Du genuegend "
                        "Ranken fuer ein Netz zusammen hast. Du legst sie "
                        "auf dem Boden aus und knuepfst ein Netz daraus. "
                        "Kritisch betrachtest Du Dein Werk. Schoen sieht "
                        "es ja nicht gerade aus, aber halten duerfte es. "
                        "Du steckst das Netz ein."));

      tell_room(ENV(TP),BS(TP->name(WER, 2) + " knuepft aus einer "
                           "Menge Ranken ein Netz und steckt es ein."), ({TP}) );

      netz = clone_object(OBJ "rwq_netz");
      netz->move(TP, M_GET|M_NOCHECK); // das netz wiegt weniger als 8 ranken, daher ohne check
      netz->SetOwner(TP);

      anz_ranken -= 8;
      SetProp(P_AMOUNT,anz_ranken);
      break;
    }
    return 1;
  }

  return 0;
}

int cmd_flechten( string str)
{
  int anz_ranken;
  object seil;

  notify_fail( "Was moechtest Du aus der Ranke flechten?\n");
  if(!str || str == "") return 0;

  if(str == "netz"             ||
     str == "netz aus ranke"   ||
     str == "netz aus ranken"   )
  {
    tell_object(TP,BS("Ein Netz wird geknuepft. Ein Seil wuerde man "
                      "wohl eher flechten. Und aus zweien dieser Ranken laesst "
                      "sich bestimmt ein recht gutes Seil flechten."));
    return 1;
  }

  if(!(str == "seil"            ||
       str == "seil aus ranke"  ||
       str == "seil aus ranken" )) return 0;

  anz_ranken = QueryProp(P_AMOUNT);

  if(anz_ranken < 2)
  {
    tell_object(TP,"Mit einer Ranke?? Du brauchst zwei.\n");
    return 1;
  }

  tell_object(TP,"Im Nu hast Du Dir ein ganz brauchbares Seil geflochten!\n");

  tell_room(ENV(TP),BS(TP->name(WER, 2)+" hat sich aus zwei Ranken "
                       " ein Seil geflochten und steckt es ein."),({TP}));

  seil = clone_object("/obj/seil");
  seil->SetProp(P_LONG, "Ein Seil, das aus den Ranken einer Dir "
                        "unbekannten Pflanze zu bestehen scheint. Aber es "
                        "sieht haltbar aus und Du kannst es bestimmt wie "
                        "jedes andere Seil benutzen.");
  seil->move(TP, M_GET|M_NOCHECK); // seil wiegt genausoviel wie zwei ranken
  anz_ranken -= 2;
  SetProp(P_AMOUNT,anz_ranken);
  return 1;
}
