#include "../def.h"

inherit OBJ "schild";

void create()
{
  if (!is_clone(TO))return;

  ::create();

  title1 = "Noch niemand hat den weissen Einhornhengst besiegt!\n";
  title2 = "Folgende Helden haben bereits den weissen Einhornhengst "
           "besiegt: \n\n";
}

mapping GetData()
{
  return KMASTER->QueryUnicornKills();
}




