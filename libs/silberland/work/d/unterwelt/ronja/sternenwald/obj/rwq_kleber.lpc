#include "../def.h"

inherit "/std/thing";

#define FIX 5

string *stext, *otext;
int nstext, notext;

int started;

void nerven(int step,object player)
{
  int zeile;

  if(!started)
  {
    call_out("remove",0);
    return;
  }

  if(step < 6)
  {
    zeile = step;
  }
  else if(step < 15)
  {
    zeile = random(nstext-FIX)+FIX;
  }
  else
  {
    TELLPLAYER(BS("Endlich ist das Zeug trocken, und Du kannst Dir "
                  "die Reste von den Haenden wischen."));
    remove();
    return;
  }

  tell_object(player,BS(stext[zeile]));
  tell_room(ENV(player),
    BS(sprintf(otext[random(notext)],player->Name(WER,2))),({player})
  );

  call_out("nerven",2+random(5),++step,player);

  return;
}

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, 0);  // Das Zeug ist unsichtbar, klar.
  SetProp(P_LONG, 0);
  AddId( ({ "RWQ_Kleber" }) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  stext = ({"Und wie dieser Saft klebt!!!"
           ,"Vergeblich versuchst Du, Dir den Saft von den Fingern zu"
                  "rubbeln. Jetzt kleben sie nur aneinander..."
           ,"Wild fluchend fuchtelst du herum und kommst mit den Fingern in "
                  "Deine Haare. AUA - das reisst ..."
           ,"So, wie der klebt, darfst Du nichts anfassen. Sonst haengst Du "
                  "bestimmt daran fest."
           ,"Vielleicht waere es das naechste Mal doch besser, ein Messer zu "
                  "benuetzen."
           ,"Du fuehlst Dich richtig klebrig."
           ,"Du hast das Gefuehl, der Saft klebt schon ueberall an Dir."
           ,"Alles ist klebrig - Deine Kleidung, Deine Waffen, Deine Haare - "
                  "einfach alles. Verfluchtes Zeug!"
           ,"Oh verdammt, jetzt klebt Dir Deine Hand an der Hose fest. So "
                  "ein Mist!!"
           ,"Dieser Saft verklebt Dir die Finger."
           ,"Was fuer ein Dreckszeug."
           ,"Du klebst."
           });

  otext = ({"Der Saft scheint ziemlich klebrig zu sein."
           ,"Vergeblich versucht %s, den Saft von den Fingern zu rubbeln."
           ,"Wild fluchend fuchtelt %s herum und kommt mit den Fingern an "
                  "die Haare. AUA - das scheint ganz schoen zu reissen..."
           ,"%s sieht ungluecklich aus."
           ,"%s sieht irgendwie klebrig aus..."
           ,"%s kommt mit der Hand an die Hose und klebt daran fest."
           });

  nstext = sizeof(stext);
  notext = sizeof(otext);

  started = 0;
}

void init()
{
  ::init();
}

void StartMessage(object player)
{
  started = 1;
  player->Set(P_MAX_HANDS, lambda( ({}), ({#'return, 0 }) ), F_QUERY_METHOD );
  call_out("nerven",2,0,player);
}

void BecomesNetDead(object player)
{
  if(player = ENV(TO)) started = 0;
}
