#include "../def.h"
#include <food.h>

inherit "/std/food";

int heal;

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Eine Blume");
  SetProp(P_LONG,
    "Diese Blume war das Herz eines Blumengeists.");

  SetProp(P_NAME, "Blumenherz");
  AddId( ({ "blume", "herz", "blumenherz" }) );

  SetProp(P_INFO,"Angeblich haben diese Blumenherzen heilende Kraefte.");

  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 50);

  heal = 10;

  SetProp(P_FOOD_INFO, ([ F_HEAL    : ({ heal, heal }),
                          F_SOAK    : 5,
                          F_MSG     : "Du isst die Blume.",
                          F_MSG_ROOM: "isst eine Blume?!" ]) );

  call_out("verwelken", 120 + random(120),0);
}

void verwelken(int i)
{
  string s,*words;

  if(i == 0)
  {
    if(ENV(TO))
    {
      if(interactive(ENV(TO)))
      {
        tell_object(ENV(TO),"Das Blumenherz faengt an zu verwelken!\n");
      }
      else
      {
        tell_room(ENV(TO),"Das Blumenherz faengt an zu verwelken!\n");
      }
    }

    words = explode(QueryProp(P_SHORT)," ");

    s = words[0];
    switch(QueryProp(P_GENDER))
    {
      case MALE   : s += " verwelkender "; break;
      case FEMALE : s += " verwelkende " ; break;
      case NEUTER : s += " verwelkendes "; break;
    }
    s += implode(words[1..], " ");

    SetProp(P_SHORT, s);

    s  = QueryProp(P_LONG);
    s += capitalize(QueryPronoun(WER))+" ist schon am verwelken.";
    SetProp(P_LONG,BS(s));

    SetProp(P_NAME_ADJ, QueryProp(P_NAME_ADJ) + ({"verwelkend"}) );
    AddAdjective( ({"verwelkenden","verwelkender","verwelkendem","verwelkendes","verwelkende"}) );

    heal /= 2;
    SetProp(P_FOOD_INFO, ([ F_HEAL    : ({ heal, heal/2 }),
                            F_SOAK    : 5,
                            F_MSG     : "Du isst die Blume.",
                            F_MSG_ROOM: "isst eine Blume?!" ]) );

    call_out("verwelken",10*(12+random(12)),1);
  }
  else
  {
    remove();
  }
}

void Customize(string id)
{
  string  stext, ltext, ntext;
  int     gender, stufe;

  switch (id)
  {
    case "gaensebluemchen":
      stext    = "Ein Gaensebluemchen";
      ltext    = "Dieses Gaensebluemchen";
      ntext    = "Gaensebluemchen";
      gender   = NEUTER;
      stufe    = 2;
      break;
    case "sternblume":
      stext    = "Eine Sternblume";
      ltext    = "Diese Sternblume";
      ntext    = "Sternblume";
      gender   = FEMALE;
      stufe    = 2;
      break;
    case "vergissmeinnicht":
      stext    = "Ein Vergissmeinnicht";
      ltext    = "Dieses Vergissmeinnicht";
      ntext    = "Vergissmeinnicht";
      gender   = NEUTER;
      stufe    = 3;
      break;
    case "kornblume":
      stext    = "Eine Kornblume";
      ltext    = "Diese Kornblume";
      ntext    = "Kornblume";
      gender   = FEMALE;
      stufe    = 3;
      break;
    case "veilchen":
      stext    = "Ein Veilchen";
      ltext    = "Dieses Veilchen";
      ntext    = "Veilchen";
      gender   = NEUTER;
      stufe    = 4;
      break;
    case "schneegloeckchen":
      stext    = "Ein Schneegloeckchen";
      ltext    = "Dieses Schneegloeckchen";
      ntext    = "Schneegloeckchen";
      gender   = NEUTER;
      stufe    = 4;
      break;
    case "loewenzahn":
      stext    = "Ein Loewenzahn";
      ltext    = "Dieser Loewenzahn";
      ntext    = "Loewenzahn";
      gender   = MALE;
      stufe    = 5;
      break;
    case "butterblume":
      stext    = "Eine Butterblume";
      ltext    = "Diese Butterblume";
      ntext    = "Butterblume";
      gender   = FEMALE;
      stufe    = 5;
      break;
    case "enzian":
      stext    = "Ein Enzian";
      ltext    = "Dieser Enzian";
      ntext    = "Enzian";
      gender   = MALE;
      stufe    = 6;
      break;
    case "schluesselblume":
      stext    = "Eine Schluesselblume";
      ltext    = "Diese Schluesselblume";
      ntext    = "Schluesselblume";
      gender   = FEMALE;
      stufe    = 7;
      break;
    case "glockenblume":
      stext    = "Eine Glockenblume";
      ltext    = "Diese Glockenblume";
      ntext    = "Glockenblume";
      gender   = FEMALE;
      stufe    = 8;
      break;
    case "hahnenfuss":
      stext    = "Ein Hahnenfuss";
      ltext    = "Diese Hahnenfuss";
      ntext    = "Hahnenfuss";
      gender   = MALE;
      stufe    = 9;
      break;
    case "margerite":
      stext    = "Eine Margerite";
      ltext    = "Diese Margerite";
      ntext    = "Margerite";
      gender   = FEMALE;
      stufe    = 10;
      break;
    case "tulpe":
      stext    = "Eine Tulpe";
      ltext    = "Diese Tulpe";
      ntext    = "Tulpe";
      gender   = FEMALE;
      stufe    = 11;
      break;
    case "lilie":
      stext    = "Eine weisse Lilie";
      ltext    = "Diese wundervolle weisse Lilie";
      ntext    = "Lilie";
      gender   = FEMALE;
      stufe    = 12;
      break;
    case "rose":
      stext    = "Eine blutrote Rose";
      ltext    = "Diese wunderbare rote Rose";
      ntext    = "Rose";
      gender   = FEMALE;
      stufe    = 13;
      break;
    case "orchidee":
      stext    = "Eine leuchtende, violett-gelbe Orchidee";
      ltext    = "Diese atemberaubende, leuchtende, violett-gelbe Orchidee";
      ntext    = "Orchidee";
      gender   = FEMALE;
      stufe    = 14;
      break;

    default:
      return;
  }

  SetProp(P_SHORT, stext);
  SetProp(P_LONG, ltext + " war das Herz eines Blumengeists.");

  SetProp(P_NAME, ntext);
  AddId( ({ id }) );
  SetProp(P_GENDER, gender);

  heal = 5 + random( 11) + 4 * stufe;

  SetProp( P_FOOD_INFO, ([ F_HEAL    : ({heal, heal/2 }),
                           F_SOAK    : 5 + 2 * stufe,
                           F_MSG     : "Du isst die Blume.",
                           F_MSG_ROOM: "isst eine Blume?!" ]) );

  return;
}

