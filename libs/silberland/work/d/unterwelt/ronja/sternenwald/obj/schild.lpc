#include "../def.h"

inherit "std/thing";

mapping list;
string title1, title2;

void create()
{
  if (!is_clone(TO))return;

  ::create();

  SetProp(P_SHORT, "Ein Schild");
  SetProp(P_LONG,
    "Ein Schild, recht einfach zusammengezimmert. Du kannst es lesen."
  );

  SetProp(P_NAME, "Schild");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schild"}) );

  SetProp(P_MATERIAL, ([MAT_WOOD:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 450);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET,"Das Schild steckt fest in der Erde!\n");

  AddCmd( ({"les","lese","lies"})      , "cmd_lesen");

  title1 = "Noch nichts uwrde auf diesem Schild verewigt!\n";
  title2 = "Folgende Helden wurden auf diesem Schild verewigt: \n\n";
}

void reorder(string uid, int n)
{
  if(member(list,n))
  {
    list[n, 0] += ({ uid });
  }
  else
  {
    list += ([n : ({ uid }) ]);
  }
}

mapping GetData()
{
  return ([ ]);
}

int cmd_lesen(string str)
{
  string s, *uids;
  int i, n, *keys;

  notify_fail("Was moechtest Du lesen?\n");

  if(!str || str == "") return 0;
  if(!id(str))          return 0;

  list = ([ ]);
  walk_mapping(GetData(), "reorder");

  keys = sort_array(m_indices(list), #'>);

  i = sizeof(keys);

  if(i == 0)
  {
    s = title1;
  }
  else
  {
    s = title2;

    while(i--)
    {
      uids = map_array(sort_array( list[keys[i], 0], #'>), #'capitalize);

      s += break_string(LW(uids), 78, sprintf("%3d mal: ", keys[i]),
                        BS_INDENT_ONCE);
    }
  }

  TP->More(s+"\n");

  return 1;
}

