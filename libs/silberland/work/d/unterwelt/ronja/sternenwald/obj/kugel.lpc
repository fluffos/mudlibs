#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(TO))return;

  ::create();

  SetProp(P_SHORT, "Ein Kugel");
  SetProp(P_LONG,
    "Eine kleine, kupferne Kugel. Auf ihrer Obeflaeche kannst Du einige "
    "feine Linien erkennen. "
  );

  SetProp(P_NAME, "Kugel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kugel","\nFLUCHKUGEL"}) );

  SetProp(P_NAME_ADJ, "kupfern");
  AddAdjective( ({ "kleinen", "kleines", "kleine", "kleiner" ,
                   "kupfern", "kupfernes", "kupferne", "kupferner"
                }) );

  SetProp(P_MATERIAL, ([MAT_COPPER:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 450);
  SetProp(P_NOBUY, 1);

}


