#include "../def.h"

inherit "std/thing";

int seite,count;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine durchsichtige Kugel");

  SetProp(P_NAME, "Kugel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kugel","kompass"}) );

  SetProp(P_NAME_ADJ, ({"durchsichtig"}) );
  AddAdjective( ({"durchsichtigen","durchsichtiger","durchsichtigem","durchsichtiges","durchsichtige"}) );

  SetProp(P_MATERIAL, ([MAT_GLASS:25,MAT_OIL:50,MAT_MISC_DEAD:10,MAT_HORN:10,MAT_MISC_UNHOLY:5]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 450);
  SetProp(P_NOBUY, 1);

  AddCmd( ({"dreh","drehe"}), "cmd_drehen");
  AddCmd( ({"reib","reibe"}), "cmd_reiben");

  seite = 0;
  count = 0;
}

int cmd_drehen(string str)
{
  _notify_fail("Was moechtest Du drehen?\n");

  if(!str || str == "") return 0;
  if(!(str == "kugel"         ||
       str == "kugel um"      ||
       str == "kompass"       ||
       str == "kompass um"    )) return 0;

  seite = 1 - seite;

  TELLPLAYER("Du drehst "+name(WEN,1)+" um, so dass Du nun die andere Seite "
             "siehst.\n");
  return 1;
}

string direction(int posx, int posy, int targetx, int targety)
{
  string s;
  int dx,dy;

  s = "";

  dx = targetx - posx;
  dy = targety - posy;

  if(dx >= 0 && dy >= 0)
  {
    if(to_float(dy) < dx/2.0)
    {
      s = "Osten";
    }
    else if(to_float(dy) > 2.0*dx)
    {
      s = "Norden";
    }
    else
    {
      s = "Nordosten";
    }
  }
  else if(dx < 0 && dy >= 0)
  {
    if(to_float(dy) < -dx/2.0)
    {
      s = "Westen";
    }
    else if(to_float(dy) > -2.0*dx)
    {
      s = "Norden";
    }
    else
    {
      s = "Nordwesten";
    }
  }
  else if(dx <= 0 && dy <= 0)
  {
    if(to_float(dy) > dx/2.0)
    {
      s = "Westen";
    }
    else if(to_float(dy) < 2.0*dx)
    {
      s = "Sueden";
    }
    else
    {
      s = "Suedwesten";
    }
  }
  else if(dx >= 0 && dy <= 0)
  {
    if(to_float(dy) > -dx/2.0)
    {
      s = "Osten";
    }
    else if(to_float(dy) < -2.0*dx)
    {
      s = "Sueden";
    }
    else
    {
      s = "Suedosten";
    }
  }

  return s;
}

string display_dir_2_sternenwald()
{
  string s, fname;
  int posx, posy, posz, ok;

  s = "";

  if(!(TP && interactive(TP))) return BS(s);

  fname = file_name(ENV(TP));

  if((fname[0..26] == "/d/unterwelt/zordan/dhrkion") ||
     (fname == "/gilden/dunkelelfen")                 )
  {
    s += "Der Finger pendelt ein wenig zwischen Norden und Nordwesten. ";
    return s;
  }

  if(fname[0..29] == "/d/unterwelt/ronja/sternenwald")
  {
    s += "Der Finger dreht sich wie wild im Kreis. Anscheinend bist Du "
         "bereits im Sternenwald.";
    return s;
  }

  if(fname == "/d/unterwelt/basics/central/room/00+05-15")
  {
    s += "Der Finger zeigt exakt nach Norden. ";
    return s;
  }

  if(fname[0..26] != "/d/unterwelt/basics/central")
  {
    s += "Der Finger dreht sich nur ziel- und planlos im Kreis.";
    return s;
  }

  fname = explode(fname,"/")[<1];

  if(sscanf(fname,"%d%d%d",posz,posy,posx) != 3)
  {
    s += "Der Finger dreht sich nur ziel- und planlos im Kreis.";
    return s;
  }

  s = "Der Finger dreht sich ein wenig und pendelt sich schliesslich nach "
      + direction(posx,posy,-15,5) + " ein.";

  return BS(s);
}

string display_dir_2_dhrkion()
{
  string s, fname;
  int posx, posy, posz, ok;

  s = "";

  if(!(TP && interactive(TP))) return BS(s);

  fname = file_name(ENV(TP));

  if((fname[0..26] == "/d/unterwelt/zordan/dhrkion") ||
     (fname == "/gilden/dunkelelfen")                 )
  {
    s += "Die Kralle dreht sich wie wild im Kreis. Du schaust Dich "
         "erstaunt um, und tatsaechlich, Du befindest Dich mitten in Dhrkion.";
    return s;
  }

  if(fname[0..29] == "/d/unterwelt/ronja/sternenwald")
  {
    s += "Die Kralle pendelt sich nach Suedosten ein.";
    return s;
  }

  if(fname == "/d/unterwelt/basics/central/room/00-08-04")
  {
    s += "Die Kralle zeigt exakt nach Sueden. ";
    return s;
  }

  if(fname == "/d/unterwelt/basics/central/room/02-13-03")
  {
    s += "Die Kralle zeigt exakt nach Sueden. ";
    return s;
  }

  if(fname[0..26] != "/d/unterwelt/basics/central")
  {
    s += "Die Kralle dreht sich nur ziel- und planlos im Kreis.";
    return s;
  }

  fname = explode(fname,"/")[<1];

  if(sscanf(fname,"%d%d%d",posz,posy,posx) != 3)
  {
    s += "Die Kralle dreht sich nur ziel- und planlos im Kreis.";
    return s;
  }

  s = "Die Kralle dreht sich ein wenig und pendelt sich schliesslich nach "
      + direction(posx,posy,-3,-13) + " ein.";

  return BS(s);
}

int cmd_reiben(string str)
{
  notify_fail("Was moechtest Du reiben?\n");

  if(!str || str == "") return 0;
  if(!(str == "kugel"     ||
       str == "an kugel"  ||
       str == "kompass"   ||
       str == "an kompass")) return 0;

  count++;

  if(count > 150)
  {
    TELLPLAYER(BS("Du reibst an der Kugel, doch ungeschickterweise faellt "
                  "sie dir dabei aus der Hand und zerbricht."));
    call_out("remove",0);
    return -1;
  }

  if(seite == 0)
  {
    TELLPLAYER(BS(display_dir_2_sternenwald()));
  }
  else
  {
    TELLPLAYER(BS(display_dir_2_dhrkion()));
  }

  return 1;
}

string _query_long()
{
  string s;

  s = "Eine durchsichtige Kugel, die in zwei Haelften geteilt ist. Die Kugel "
      "selbst ist mit einer klaren, dickfluessigen Fluessigkeit gefuellt. ";

  if(seite == 0)
  {
    s += "In der Fluessigkeit schwimmt etwas laengliches, das aussieht... "
         "Nein! Du taeuschst Dich nicht! Da schwimmt tatsaechlich ein kleiner "
         "Finger darin! Offensichtlich ein Rumpelwichtfinger von der Groesse "
         "her. Sollte der Finger dieses wohl schon laengst verstorbenen "
         "Rumpelwichtes noch immer einen solchen Heimdrang haben, dass er "
         "Dir die Richtung zum Sternenwald zeigen kann? Vielleicht genuegt "
         "es, wenn man an der Kugel reibt, und sich so der Finger "
         "ausrichtet? "
    ;
  }
  else
  {
    s += "In der Fluessigkeit schwimmt die Kralle eines toten Tieres. Bei "
         "genauem hinsehen stellst Du fest, das es eine Driderkralle ist. "
         "Ob sie Dir den Weg zur Goettin Lloth oder wenigstens nach "
         "Dhrkion anzeigen kann? Vielleicht muss man ja nur an der Kugel "
         "reiben, damit sich die Kralle ausrichtet. "
    ;
  }

  s += "Wenn Du die allerdings die andere Seite der Kugel sehen moechtest, "
       "so musst Du die Kugel nur umdrehen. ";

  return BS(s);
}
