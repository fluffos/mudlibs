#include "../def.h"

inherit OBJ "schild";

void create()
{
  if (!is_clone(TO))return;

  ::create();

  title1 = "Noch niemand hat den Regenbogendrachen besiegt!\n";
  title2 = "Folgende Helden haben bereits den Regenbogendrachen besiegt: \n\n";
}

void GetData()
{
  return KMASTER->QueryDragonKills();
}


