#include "../def.h"

inherit "/std/thing";

string owner;

void material();

void create()
{
  if(!is_clone(TO)) return;

  ::create();
  SetProp(P_SHORT,"Ein Stueck Wachs");

  AddId( ({"wachs","kerzenwachs","stueck wachs","stueck kerzenwachs"
          ,"\nWACHS"}) );
  SetProp(P_NAME, "Stueck Wachs");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 75);
  SetProp(P_NOBUY, 1);

  SetProp(P_PUPPE, 0);
  SetProp(P_PUPPE_KLEID,0);
  SetProp(P_PUPPE_AUGEN,0);
  SetProp(P_PUPPE_HERZ, "none");
  SetProp(P_PUPPE_HAARE, 0);


  AddDetail( ({"wachs","kerzenwachs"}) ,
    "Ganz normales Kerzenwachs. Schon ein wenig weich, weil Du es so "
    "lange mit Dir rumtraegst. "
  );

  AddSpecialDetail( ({"kopf"
                     ,"rumpf"
                     ,"bein","beine"
                     ,"arm","arme"
                     ,"auge","augen"
                     ,"herz"
                     ,"haar","haare"
                     ,"kleid","kleidchen"
                     })                           , "detail_puppe");

  AddCmd( ({"form","forme","knet","knete"})       , "cmd_formen" );
  AddCmd( ({"drueck","druecke","steck","stecke"}) , "cmd_stecken");
  AddCmd( ({"befestig","befestige"})              , "cmd_befestigen");
//AddCmd( ({"zieh","ziehe"})                      , "cmd_ziehen");

  AddDetail( ({"modell"}) ,
    "Wenn das was werden soll, stell Dich halt in die Naehe der Person, "
    "welcher die Puppe aehnlich werden soll."
  );

  material();

  owner = "";
}

void removeme(object pl)
{
  object room;

  if(!pl)               return;
  if(!interactive(pl))  return;
  if(!(room = ENV(pl))) return;

  tell_room(room, BS("Als "+pl->Name()+" "+TO->name(WEN,1)+" nimmt, zer"
                     "broeselt es zu vielen kleinen Broeckchen."), ({pl}) );


  tell_room(room, BS("Als Du "+TO->name(WEN,1)+" nimmst, zer"
                     "broeselt es zu vielen kleinen Broeckchen."), ({pl}) );

  remove();
}

void init()
{
  object pl;

  ::init();

  if(!(pl = ENV(TO)))  return;
  if(!interactive(pl)) return;

  if(owner == "")
  {
    owner = getuuid(pl);
    return;
  }

  if(owner != getuuid(pl))
  {
    call_out("removeme",0,pl);
  }
}

string _query_long()
{
  string s;

  if(!QueryProp(P_PUPPE))
  {
    s = "Ein Stueckchen Kerzenwachs. Ob man daraus wohl wieder eine Kerze "
        "formen koennte?";
    return BS(s);
  }

  s = "Ein Stueck Wachs, aus dem Du eine kleine Puppe geformt hast. "
      "Kopf, Rumpf, 2 Beine und 2 Arme, alles da. ";

  if(QueryProp(P_PUPPE_HERZ) != "none")
  {
    s += "In den Rumpf hast Du einen "+QueryProp(P_PUPPE_HERZ)+" als "
         "Herz gedrueckt, aber das kann man von aussen nicht mehr sehen. ";
  }

  switch(QueryProp(P_PUPPE_AUGEN))
  {
    case 1:
      s += "Im Kopf befindet sich bereits ein Onyx als Auge. ";
      break;

    case 2:
      s += "Im Kopf stecken zwei Onyxe, die die Augen darstellen sollen. ";
      break;
  }

  if(QueryProp(P_PUPPE_HAARE))
  {
    s += "Am Kopf ist ein einzelnes Haar befestigt. ";
  }

  if(QueryProp(P_PUPPE_KLEID))
  {
    s+= "Die Puppe hat ein niedliches Kleidchen an. ";
  }

  return BS(s);
}

void material()
{
  int edelstein;

  SetProp(P_MATERIAL, ([MAT_WAX:100]) );
  edelstein  = (QueryProp(P_PUPPE_AUGEN) > 0) ? 1 : 0;
  edelstein += QueryProp(P_PUPPE_AUGEN);
  edelstein *= 10;
  if(edelstein)
    SetProp(P_MATERIAL, ([MAT_WAX:100-edelstein,MAT_MISC_JEWEL:edelstein]) );
}

int cmd_formen(string str)
{
  string s;

  notify_fail("Was willst Du formen?\n");

  if(!str || str == "") return 0;
  if(!(str == "kerze"         ||
       str == "pueppchen"     ||
       str == "puppe"         ))return 0;

  if(QueryProp(P_PUPPE))
  {
    TELLPLAYER(BS("Du hast Dir soviel Muehe mit dieser Puppe gemacht, "
                  "dass Du sie lieber so laesst wie sie ist. Eigentlich "
                  "ist sie ja ganz gut geworden, also warum noch weiter "
                  "daran herum formen?"
    ));
    TELLOTHERS(TPN+" starrt gedankenverloren ein kleines Pueppchen an.\n");
    return -1;
  }

  switch(str)
  {
    case "kerze" :
      s = "Du versuchst aus dem Wachs wieder eine Kerze zu formen, "
          "doch irgendwie wird das nichts. Das Ding ist krumm und "
          "schief und niemals eine Kerze. Abgesehen davon hast Du auch "
          "ueberhaupt keinen Docht. ";
      break;

    case "pueppchen" :
    case "puppe" :
      if(ENV(TP) && present("\nWETTERWACHS",ENV(TP)))
      {
        s = "Du formst aus dem Wachs eine Puppe nach dem Vorbild von "
            "Oma Wetterwachs. Sieht ihr fast sogar aehnlich. ";
        SetProp(P_PUPPE,1);
        SetProp(P_SHORT,"Ein kleine Puppe aus Wachs");
        AddId( ({"puppe","pueppchen","wachspuppe","\nWACHSPUPPE"}) );
        SetProp(P_NAME, "Puppe");
        SetProp(P_GENDER, FEMALE);
        SetProp(P_NAME_ADJ, ({"klein"}) );
        AddAdjective( ({"kleinen","kleiner","kleinem","kleines","kleine"}) );
        MOORMASTER->Msg(TPUID+" formt eine Puppe aus Wachs");
      }
      else
      {
        s = "Du knetest und formst, aber irgendwie will es Dir nicht "
            "so recht gelingen, auch nur ansatzweise eine Puppe aus dem "
            "Wachs zu formen. Dir fehlt halt ein Modell.";
      }
      break;

    default :
      s = "Du knetest auf einem Stueck Wachs herum.";
  }

  TELLPLAYER(BS(s));
  TELLOTHERS(TPN+" knetet auf einem Stueck Wachs herum.\n");
  return 1;
}

int cmd_stecken(string str)
{
  int n;
  string s, was, wohin;
  object ob;

  notify_fail("Was moechtest Du wohin stecken?\n");

  if(!str || str == "") return 0;

  n=sscanf(str, "%s in %s", was, wohin);
  if(n!=2){n=sscanf(str, "%s an %s", was, wohin);}
  if(n!=2){return 0;}

  if(wohin == "arme")  wohin = "arm";
  if(wohin == "beine") wohin = "bein";

  if(!(wohin == "arm"    ||
       wohin == "bein"   ||
       wohin == "wachs"  ||
       wohin == "kopf"   ||
       wohin == "rumpf"  ||
       wohin == "puppe"  )) return 0;

  if(!(ob = present(was,TP)))
  {
    TELLPLAYER("Sowas hast Du doch gar nicht bei Dir!\n");
    return -1;
  }

  if(!(was == "rubin"    ||
       was == "granat"   ||
       was == "cuprit"   ||
       was == "jaspis"   ||
       was == "onyx"     ))
  {
    TELLPLAYER("Das macht nun wirklich keinen Sinn.\n");
    return -1;
  }

  if(!QueryProp(P_PUPPE))
  {
    TELLPLAYER(BS("Du steckst "+ob->name(WEN,1)+" in das Wachs, aber "
                  "irgendwie will das nicht das nicht so recht was "
                  "werden. Liegt vermutlich daran, dass das Wachs noch "
                  "nicht so recht in Form ist. Du nimmst "+
                  ob->name(WEN,1)+" wieder an Dich."
    ));
    TELLOTHERS(TPN+" knetet auf einem Stueck Wachs herum.\n");
    return -1;
  }

  s = "*** Oups hier bugt noch was. ***";

  switch(wohin)
  {
    case "arm" :
      switch(was)
      {
        case "rubin" :
        case "granat" :
        case "cuprit" :
        case "jaspis" :
          s = "Seit wann ist das Herz in den Armen?";
          break;

        case "onyx" :
          s = "Seit wann sind die Augen in den Armen?";
          break;

        default :
          s = "Das macht nun wirklich keinen Sinn.";
      }
      break;

    case "bein" :
      switch(was)
      {
        case "rubin" :
        case "granat" :
        case "cuprit" :
        case "jaspis" :
          s = "Seit wann ist das Herz in den Beinen?";
          break;

        case "onyx" :
          s = "Seit wann sind die Augen in den Beinen?";
          break;

        default :
          s = "Das macht nun wirklich keinen Sinn.";
      }
      break;

    case "kopf" :
      switch(was)
      {
        case "rubin" :
        case "granat" :
        case "cuprit" :
        case "jaspis" :
          s = "Seit wann ist das Herz im Kopf?";
          break;

        case "onyx" :
          switch(QueryProp(P_PUPPE_AUGEN))
          {
            case 0 :
              s = "Du steckst einen Onyx als Auge in den Kopf.";
              SetProp(P_PUPPE_AUGEN,1);
              ob->remove();
              material();
              break;

            case 1 :
              s = "Du steckst noch einen Onyx in den Kopf, so dass "
                  "nun 2 Onyxe als Augen im Kopf stecken. ";
              SetProp(P_PUPPE_AUGEN,2);
              ob->remove();
              material();
              break;

            case 2 :
              s = "Du hast doch schon 2 Onyxe als Augen in den Kopf "
                  "Kopf steckt. Schau Dir dochmal Oma Wetterwachs an, "
                  "hat die etwa drei Augen?";
              break;

          }
          break;

        default :
          s = "Das macht nun wirklich keinen Sinn.";
          break;
      }
      break;

    case "rumpf" :
      switch(was)
      {
        case "rubin" :
        case "granat" :
        case "cuprit" :
        case "jaspis" :
          s = "Du steckst den "+CAP(was)+" in den Rumpf. Von aussen "
              "ist das nicht zu erkennen, aber irgendwie scheint "
              "die Puppe lebendiger geworden zu sein. ";
          SetProp(P_PUPPE_HERZ,CAP(was));
          ob->remove();
          material();
          break;

        case "onyx" :
          s = "Seit wann sind die Augen im Rumpf?";
          break;

        default :
          s = "Das macht nun wirklich keinen Sinn.";
      }
      break;

    default :
      s = "Ja, schoen und gut. Und wohin genau? Kopf? Arm? Bein? Rumpf?";
  }

  TELLPLAYER(BS(s));
  TELLOTHERS(TPN+" fummelt an einem Stueck Wachs herum.\n");

  return 1;
}

int cmd_befestigen(string str)
{
  object haar;

  notify_fail("Was moechtest Du am Wachs befestigen?\n");

  if(!str || str == "") return 0;
  if(!(str == "haar"                                  ||
       str == "haar von oma wetterwachs"              ||
       str == "haar von der oma"                      ||
       str == "haar an wachs"                         ||
       str == "haar von oma wetterwachs an wachs"     ||
       str == "haar von der oma an wachs"             ||
       str == "haar an puppe"                         ||
       str == "haar von oma wetterwachs an puppe"     ||
       str == "haar von der oma an puppe"             ||
       str == "haar an pueppchen"                     ||
       str == "haar von oma wetterwachs an pueppchen" ||
       str == "haar an kopf"                          ||
       str == "haar von oma wetterwachs an kopf"      ||
       str == "haar von der oma an kopf"              ||
       str == "haar an kopf"                          ||
       str == "haar von der oma an pueppchen"         )) return 0;

  if(!(haar=present("\nOMAHAAR",TP)))
  {
    TELLPLAYER(BS("Du hast doch aber gar keine Haare von Oma Wetterwachs "
                  "dabei."));
    return -1;
  }

  if(!QueryProp(P_PUPPE))
  {
    TELLPLAYER(BS("Du versuchst das Haar am Wachs zu befestigen. "
                  "Irgendwie will das nicht das nicht so recht was "
                  "werden. Liegt vermutlich daran, dass das Wachs noch "
                  "nicht so recht in Form ist. "
    ));
    TELLOTHERS(TPN+" knetet auf einem Stueck Wachs herum.\n");
    return -1;
  }

  TELLPLAYER("Du befestigst das Haar von Oma Wetterwachs an Deiner Puppe.\n");
  haar->remove();
  SetProp(P_PUPPE_HAARE, 1);

  return 1;
}

string detail_puppe(string str)
{
  string s;

  if(!QueryProp(P_PUPPE)) return "Sowas siehst Du da nicht!\n";

  if(str == "kopf")
    return BS("Naja, hat entfernt Aehnlichkeit mit Oma Wetterwachs.");

  if(str == "rumpf")
    return BS("Das zeigst Du besser niemanden.\n");

  if(str == "bein" || str == "beine")
    return BS("Krumm und schief, aber sind das die Beine von Oma Wetter"
              "wachs nicht auch?");

  if(str == "arm" || str == "arme")
    return BS("Die Arme sind Dir noch am besten gelungen.");

  if(str == "auge" || str == "augen")
  {
    switch(QueryProp(P_PUPPE_AUGEN))
    {
      case 0:
        return "Sowas siehst Du da nicht!\n";
        break;

      case 1:
        return BS("Im Kopf befindet sich bereits ein Onyx als Auge.");
        break;

      case 2:
        return BS("Im Kopf stecken zwei Onyxe, die die Augen darstellen "
                  "sollen. ");
        break;
    }
  }

  if((str == "herz") && (QueryProp(P_PUPPE_HERZ) != "none"))
  {
    return BS("In den Rumpf hast Du einen "+QueryProp(P_PUPPE_HERZ)+" als "
              "Herz gedrueckt, aber das kann man von aussen nicht mehr "
              "sehen. ");
  }

  if( ((str == "haar") || (str == "haare")) && QueryProp(P_PUPPE_HAARE) ==1)
  {
    return BS("Am Kopf der Puppe hast Du ein Haar von Oma Wetterwachs "
              "befestigt.");
  }

  if(str == "kleid" || str == "kleidchen")
  {
    if(QueryProp(P_PUPPE_KLEID))
    {
      return BS("Die Puppe hat ein niedliches Kleidchen an. ");
    }
  }

  return "Sowas siehst Du da nicht!\n";
}

