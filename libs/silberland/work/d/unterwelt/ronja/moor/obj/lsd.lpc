#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);

  AddId("LSD");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);

  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_NOSELL,1);

  AddCmd( CMD_UNTERSUCHEN, "cmd_untersuchen");

  call_out("remove",10*60);
}

int cmd_untersuchen(string str)
{
  string s;

  if(random(10) > 5) return 0;

  switch(random(20))
  {
    case 0  :
      s = "Ploetzlich kommt ein Kuechenschrank auf Dich zu und "
          "tanz einen Runde Walzer mit Dir, waehrend Oma Wetterwachs "
          "mit dem Kochloeffel dirigiert.";
      break;

    case 1 :
      s = "War das nun ein Schmetterling oder doch ein Flamingo?";
      break;

    case 2 :
      s = "Du siehst viele, viele bunte Smarties. Du kriegst einen "
          "absoluten Heisshunger auf Schokolade. ";
      break;

    case 3 :
      s = "Erstaunt bemerkst Du, dass sich die Welt nicht mehr um die "
          "Sonne dreht, sondern es dreht sich alles um Dich. ";
      break;

    case 4 :
      s = "Bei Deinem Heisshunger kommt Dir so in den Sinn, ob Du das "
          "nicht essen koenntest. ";
      break;

    case 5 :
      s = "Es ist alles so schoen bunt hier. Du siehst Rot, Gruen, Gelb "
          "und noch viele andere Farben. Du kannst Dich gar nicht "
          "entscheiden. ";
      break;

    case 6 :
      s = "Ploetzlich erscheint ein brauner Drache. Wo der wohl herkommt? "
          "Naja, so stark wie Du Dir vorkommst, haust Du den bestimmt locker "
          "um. ";
      break;

    case 7 :
      s = "Hier ist es aber schoen. Voegel zwitschern, Hasen hoppeln "
          "ueber die Wiesen und die Blumen duften herrlich. Du bist "
          "bestimmt im Paradies.";
      break;

    case 8 :
      s = "Huch eine Maus! Hoffentlich tut Dir die nichts! Am besten "
          "schnell weglaufen. ";
      break;

    case 9 :
      s = "Ich hab Dich auch lieb!";
      break;

    case 10 :
      s = "Ein Specht fliegt herein. Der schaut aber witzig aus. Der "
          "hat vier Beine, sein Ruecken ist total eben und Fluegel "
          "hat er auch keine." ;
      break;

    case 11 :
      s = "Ein blaues Licht erscheint und wird immer groesser, groesser "
          "groesser und noch groesser. Dann wird es wieder kleiner, kleiner "
          "und noch kleiner, bis es wieder verschwunden ist. ";
      break;

    case 12 :
      s = "HISlaH ghobe lu' or luq Qo' nuqneH qaStaH nuq? nuqjatlh? jIyaj maj "
          "majQa' nuqDaq 'oH puchpa''e' yI'el HIghoS naDevvo' yIghoS "
          "lojmIt yIpoSmoH! yIDoghQo' Hab SoSlI' Quch! Heghlu'meH QaQ jajvam "
          "tlhIngan maH! ";
      break;

    case 13 :
      s = "Du hoerst auf einmal Musik. Du drehst Dich um, und siehst "
          "ein Orchester, bestehend aus zwei Meter grossen Grillen, "
          "die wie wild ihre Streichinstrumente bearbeiten.";
      break;

    case 14 :
      s = "Du hoerst auf einmal piepsige stimmen und schaust verdutzt "
          "auf den Boden. Was ist DAS?? Da tanzen zehn Maeuse um Deine "
          "Fuesse eine Polonaise! Du hoerst genauer hin: \"... hier "
          "fliegen gleich die Loecher aus dem Kaese, denn nun geht sie "
          "los uns're Poooloooonaehhhhse...\" Du reibst Dir die Augen "
          "und als Du wieder hinschaust sind die Maeuse weg. Anscheinend "
          "sind sie weitergetanzt.";
      break;

    case 15 :
      s = "Rew sad tseil tsi food.";
      break;

    default :
      s = "Du siehst nichts als bunte Farben, Formen, wabernde Kreise "
          "in gelb, dann rosa. Auf einmal laueft ein gelber Elefant "
          "durch Dich hindurch. Mit einem *Puff* verwandelt er sich in "
          "eine grosse Geburtstagstorte, die vor Deinen Augen davon "
          "schwebt.";
      break;

  }

  s += " \n\n\nLangsam kehrt Dein normales sehen wieder zurueck.";
  TELLPLAYER(break_string(s,78,0,BS_LEAVE_MY_LFS));
  TELLOTHERS(BS(TPN+" steht ploetzlich stocksteif im Raum und hat "
                    "einen leeren Blick.\n"));
  return 1;
}



