#include "../def.h"

inherit "std/thing";

string owner;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Nadel und Faden");
  SetProp (P_LONG,
    "Eine ganz normale Nadel und ein helles Stueck Faden. Bestimmt kannst "
    "Du damit etwas naehen oder flicken.");

  AddId ( ({ "nadel", "faden", "nadel und faden", "\nNADELFADEN" }) );

  SetProp(P_NAME, "Nadel und Faden");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_INFO, "Mit der Nadel und dem Faden kannst Du bestimmt"
                  "etwas nettes naehen.\n");

  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_INFO, "Der Faden eignet sich ideal zum Naehen.\n");
  SetProp(P_MATERIAL, ([MAT_WOOL:80,MAT_MISC_METAL:20]) );

  AddCmd( ({"naeh","naehe"})      , "cmd_naehen");

  owner = "";
}

void removeme(object pl)
{
  object room;

  if(!pl)               return;
  if(!interactive(pl))  return;
  if(!(room = ENV(pl))) return;

  tell_room(room, BS("Als "+pl->Name()+" die Nadel nimmt, sticht "+
                     pl->QueryPronoun()+" sich in den Finger und laesst"
                     "die Nadel fallen. Wo ist sie denn nun blos hin"
                     "gefallen?"), ({pl}) );

  tell_object(pl, BS("Als Du die Nadel nimmt, stichst "
                     "Du dir in den Finger und laesst"
                     "die Nadel fallen. Wo ist sie denn nun blos hin"
                     "gefallen?"));

  remove();
}

void init()
{
  object pl;

  ::init();

  if(!(pl = ENV(TO)))  return;
  if(!interactive(pl)) return;

  if(owner == "")
  {
    owner = getuuid(pl);
    return;
  }

  if(owner != getuuid(pl))
  {
    call_out("removeme",0,pl);
  }
}

int cmd_naehen(string str)
{
  object ob;

  notify_fail("Was moechtest Du naehen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "kleid"                      ||
       str == "kleid aus taschentuch"      ||
       str == "kleidchen"                  ||
       str == "kleidchen aus taschnetuch"  ))return 0;


  if(!(ob = present("\nTASCHENTUCH",TP)))
  {
    TELLPLAYER("Du hast nichts bei Dir, aus dem Du etwas naehen koenntest.\n");
    TELLOTHERS(TPN+" schaut entgeistert Nadel und Faden an.\n");
    return 1;
  }

  if(ob->id("\nBTASCHENTUCH"))
  {
    TELLPLAYER(BS("Das Taschentuch wurde schon mal benutzt. Daraus kann man "
                  "nichts gescheites mehr naehen."));
    TELLOTHERS(BS(TPN+" analysiert ganz genau den Schleim in "
                  +TPPP(NEUTER,WEM,SINGULAR)+" Taschentuch."));
    return 1;
  }

  TELLPLAYER(BS("Du naehst Dir aus dem Taschentuch ein suesses Puppenkleid. "
                "Gerade als Du fertig bist, laesst Du die Nadel fallen. "
                "\"Naja auch egal, sagst Du Dir\", und betrachtest zufrieden "
                "Dein Machwerk. "));


  TELLOTHERS(BS(TPN+" naeht sich aus dem Taschentuch etwas und laechelt dann "
                "ziemlich kindlich."));

  clone_object(OBJ "kleid")->move(TP,M_GET|M_NOCHECK); // kleid und taschentuch wiegen gleich viel
  call_out("remove",0);
  ob->remove();
  return 1;
}


