#include "../def.h"

inherit "/std/thing";

int zaehler;

int hau_wech();

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "" );
  AddId( ({"\nHUMPELN"}) );
  SetProp(P_NAME, "");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 0);
  SetProp(P_MATERIAL, ([MAT_MISC_MAGIC :100]) );

  AddDetail( ({"bein"}) ,
    "Du hast Dir Dein Bein ganz schoen verstaucht. Das wird wohl noch ne "
    "Weile dauern, bis das wieder abgeklungen ist."
  );

  zaehler = 2;
}

void reset()
{
  ::reset();

  zaehler--;

  if(zaehler <= 0) call_out("hau_wech",0);
}

mixed humpeln()
{
  object pl;

  if(!(pl = ENV(TO)))                                return 0;
  if(!interactive(pl))                               return 0;
  if(!ENV(pl))                                       return 0;
  if(!pl->QueryProp(P_GHOST))                        return 0;
  if(file_name(ENV(pl)) == "/room/netztot")          return 0;
  if(file_name(ENV(pl)) == "/room/death/death_room") return 0;
  if(random(100) > 40)                               return 0;

  return BS("Schmerzverzerrt verziehst Du Dein Gesicht. Du hast Dir Dein "
            "Bein boese verstaucht.");
}

void hau_wech()
{
  object pl;

  if(!(pl = ENV(TO)))  return;
  if(!interactive(pl)) return;

  tell_object(pl,"Deine Verstauchung am Bein scheint geheilt zu sein.\n");
  pl->SetProp(P_TMP_MOVE_HOOK, 0 );

  TO->remove();
  return;
}

string extra_look()
{
  if(ENV(TO) && interactive(ENV(TO)))
  {
    return capitalize(ENV(TO)->QueryPronoun(WER))+" scheint Schmerzen am Bein zu haben.\n";
  }
  return "";
}

