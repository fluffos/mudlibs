#include "../def.h"

inherit "/std/thing";

void create()
{
  if (!is_clone(ME)) return;

  ::create();
  SetProp(P_SHORT,"Ein Haar");
  SetProp(P_LONG,
    "Da stimmt was nicht."
  );
  AddId( ({"haar","\nSPIELERHAAR"}) );
  SetProp(P_NAME, "Haar");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 1);
  SetProp(P_MATERIAL, ([MAT_HAIR:100]) );
//  SetProp(P_NOGET,1);
  SetProp(P_NODROP, 1);
  SetProp(P_NOBUY, 1);
}


