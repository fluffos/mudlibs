#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Giesskanne");

  SetProp(P_NAME, "Giesskanne");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kanne","giesskanne", "\nGIESSKANNE"}) );

  SetProp(P_VALUE, 700);
  SetProp(P_WEIGHT, 3000);
  SetProp(P_MATERIAL, ([MAT_MISC_METAL:100]) );

  SetProp(P_NOBUY, 1);

  SetProp(P_GIESSKANNE, 0);

  AddCmd( ({"fuell","fuelle"}) , "cmd_fuellen");
  AddCmd( ({"giess","giesse"}) , "cmd_giessen");

}

string _query_long()
{
  string s;

  s = "Eine huebsche alte Giesskanne. Sie ist zwar schon etwas verbeult, "
      "erfuellt aber durchaus noch ihren Zweck. ";

  if(!QueryProp(P_GIESSKANNE))
  {
    return BS(s + "Sie ist leer. ");
  }
  else
  {
    return BS(s + "Sie enthaelt etwas Wasser. ");
  }

}

int cmd_fuellen(string str)
{
  int n, menge;
  string wen;

  notify_fail("Was moechtest Du womit fuellen?\n");

  if(!str || str == "") return 0;

           n = sscanf(str, "%s mit wasser", wen);
  if(n!=1) n = sscanf(str, "%s mit wasser auf", wen);
  if(n!=1) n = sscanf(str, "%s mit wasser aus tonne", wen);
  if(n!=1) n = sscanf(str, "%s mit wasser aus regentonne", wen);
  if(n!=1) n = sscanf(str, "%s mit wasser aus tonne auf", wen);
  if(n!=1) n = sscanf(str, "%s mit wasser aus regentonne auf", wen);
  if(n!=1) wen = str;

  if(!id(wen)) return 0;

  if(QueryProp(P_GIESSKANNE))
  {
    TELLPLAYER("Aber es ist doch schon Wasser in der Giesskanne drin.\n");
    return -1;
  }

  if(!present(wen, TP))
  {
    TELLPLAYER("Du musst die Giesskanne schon nehmen, bevor Du sie fuellen "
               "kannst.\n");
    return -1;
  }

  if(ENV(TO) && interactive(ENV(TO)) && ENV(ENV(TO)) )
  {
    switch (ENV(ENV(TO))->QueryProp(P_WASSERMENGE))
    {
      case 0  :
        TELLPLAYER("Du hast keine Idee, wie Du hier die Giesskanne "
                   "auffuellen koenntest.\n");
        break;

      case -1 :
        TELLPLAYER(BS("Eventuell koennte man ja das Wasser aus der "
                      "Regentonne benutzen, um die Giesskanne aufzufuellen. "
                      "Wenn welches drin waere, natuerlich nur."
        ));
        break;

      default :
        TELLPLAYER(BS("Du tauchst die Giesskanne in die Regentonne und "
                      "fuellst so etwas Wasser in die Giesskanne."
        ));

        TELLOTHERS(TPN+" macht sich an der Regentonne zu schaffen.\n");

        SetProp(P_GIESSKANNE,1);
        ENV(ENV(TO))->SetProp(P_WASSERMENGE,-1);
        break;
    }
    return 1;
  }

  return 0;
}

int cmd_giessen(string str)
{
  object pl;

  notify_fail("Du siehst hier nichts, was gegossen werden muesste.\n");

  if(pl = find_player(str))
  {
    if(!QueryProp(P_GIESSKANNE))
    {
      TELLPLAYER("Es ist doch ueberhaupt kein Wasser in der Giesskanne "
                 "drin!\n");
      TELLOTHERS(BS(TPN+" wirft einen erstaunten in "
                    +TPPP(FEMALE,WESSEN,SINGULAR)+" Giesskanne."));
      return -1;
    }

    if(ENV(PL) == ENV(TP))
    {
      tell_object(TP,"Du uebergiesst "+pl->Name()+" mit Wasser und lachst "
                     "Dich halbtot dabei.\n");
      tell_object(pl,BS(TPN+" haelt die Giesskanne ueber Dich und ueber"
                        "giesst Dich mit Wasser. Sehr komisch!"));
      tell_room(ENV(TP),BS(TPN+" uebergiesst "+pl->Name()+" mit Wasser "+
                           "aus einer Giesskanne, wobei "+pl->Name()+
                           " pudelnass wird.") , ({TP,pl}) );

      TP->command_me("lach");
      SetProp(P_GIESSKANNE,0);
    }
    else
    {
      TELLPLAYER(pl->Name()+" ist doch gar nicht hier.\n");
    }
    return 1;
  }

  if(str == "beet" || str == "beete")
  {
    TELLPLAYER("Welches Beet meinst Du denn?\n");
    return -1;
  }

  if(str == "gemuesebeet" || str == "gemuesebeete")
  {
    if(!QueryProp(P_GIESSKANNE))
    {
      TELLPLAYER("Es ist doch ueberhaupt kein Wasser in der Giesskanne "
                 "drin!\n");
      TELLOTHERS(TPN+" wirft einen erstaunten in "+TPPP(WESSEN,SINGULAR)+
                 " Giesskanne.\n");
      return -1;
    }

    TELLPLAYER("Du giesst das Gemuesebeet.\n");
    TELLOTHERS(TPN+" giesst das Gemuesebeet.\n");
    SetProp(P_GIESSKANNE,0);
    return 1;
  }

  return 0;
}
