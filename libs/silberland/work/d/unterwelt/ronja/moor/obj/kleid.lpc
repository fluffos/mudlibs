#include "../def.h"

inherit "/std/thing";

void create()
{
  if(!is_clone(TO)) return;

  ::create();
  SetProp(P_SHORT,"Ein kleines Puppenkleid");
  SetProp(P_LONG,
    "Ein kleines Puppenkleid. Wenn Du das einer Puppe anziehst, dann "
    "sieht die Puppe bestimmt sehr nett aus. "
  );
  AddId( ({"kleid","puppenkleid","\nPUPPENKLEID"}) );
  SetProp(P_NAME, "Puppenkleid");

  SetProp(P_NAME_ADJ, ({"klein"}) );
  AddAdjective( ({"kleinen","kleiner","kleinem","kleines","kleine"}) );

  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 20);
  SetProp(P_MATERIAL, ([MAT_CLOTH:100]) );

  AddCmd( ({"zieh","ziehe"}),  "cmd_anziehen" );
}

int cmd_anziehen(string str)
{
  object ob;

  notify_fail("Was willst Du wem anziehen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "puppe kleid an"         ||
       str == "puppe puppenkleid an"   ||
       str == "puppenkleid puppe an"   ))return 0;

  if(!(ob=present("\nWACHSPUPPE",TP)))
  {
    TELLPLAYER("Du hast doch gar keine Puppe dabei.\n");
    TELLOTHERS(TPN+" spielt mit einem Puppenkleid herum.\n");
    return 1;
  }

  TELLPLAYER("Du ziehst der Puppe das Kleid an.\n");
  TELLOTHERS(TPN+" zieht einer Puppe ein Puppenkleid an.");
  ob->SetProp(P_PUPPE_KLEID,1);
  call_out("remove",0);
  return 1;
}


