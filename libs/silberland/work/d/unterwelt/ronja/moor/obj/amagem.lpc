#include "../def.h"

inherit "std/thing";

string owner;

void create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein weisser Edelstein");
  SetProp(P_LONG,
    "Ein weisser Edelstein. Ein wenig Licht strahlt von ihm aus. Aber "
    "ansonsten hast Du einen solchen Edelstein noch nie gesehen. "
  );

  SetProp(P_INFO,
    "Von diesem Edelstein scheint eine ganz besondere Macht auszugehen.\n");
  SetProp(P_NAME, "Edelstein");
  SetProp(P_GENDER, MALE);

  AddId( ({"EDELSTEIN","edelstein","\namagem"}) );

  SetProp(P_MATERIAL, MAT_MISC_JEWEL );
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "weiss");

  owner = 0;
}

void SetOwner(object player)
{
  owner = getuuid(player);
}

string QueryOwner()
{
  return owner;
}

void init()
{
  object pl;

  ::init();

  if(!(pl = ENV(TO)))  return;
  if(!interactive(pl)) return;

  if(!owner) SetOwner(pl);
}

