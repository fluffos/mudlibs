#include "../def.h"

inherit "/std/thing";

string owner;

void create()
{
  if (!is_clone(this_object())) return;

  ::create();
  SetProp(P_SHORT,"Ein Tweekrieger");
  SetProp(P_LONG,
    "Ein Tweekrieger ist ein spezieller Spaten, mit dem man gestochenen "
    "Torf abheben kann."
  );
  AddId( ({"tweekrieger","\nTWEEKRIEGER"}) );
  SetProp(P_NAME, "Tweekrieger");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 1200);
  SetProp(P_MATERIAL, ([MAT_STEEL:30,MAT_WOOD:70]) );

  AddCmd( ({"hebe","heb"}),  "cmd_heben" );

  owner = "";
}

void removeme(object pl)
{
  object room;

  if(!pl)               return;
  if(!interactive(pl))  return;
  if(!(room = ENV(pl))) return;

  tell_room(room, BS("Als "+pl->Name()+" den Tweekrieger nimmt, zerbricht er "
                     "in zwei Teile. Entaeuscht wirft "+pl->QueryPronoun()+
                     " die Teile weg."));
  remove();
}

void init()
{
  object pl;

  ::init();

  if(!(pl = ENV(TO)))  return;
  if(!interactive(pl)) return;

  if(owner == "")
  {
    owner = getuuid(pl);
    return;
  }

  if(owner != getuuid(pl))
  {
    call_out("removeme",0,pl);
  }
}

int cmd_heben(string str)
{
  object torf;

  notify_fail("Was willst du anheben ?\n");

  if(-1 == member(({"torf"
                   ,"torf an"
                   ,"stueck torf"
                   ,"stueck torf an"
                   ,"torf aus kuhle"
                   ,"torf aus der kuhle"
                   ,"stueck torf aus kuhle"
                   ,"stueck torf aus der kuhle"
                   }),str))
  {
    return 0;
  }

  if( (torf=present("\nTORFNASS", ENV(TP))) && (ENV(TP)->moor_ist_da()==2)   )
  {
    TELLPLAYER(BS("Du hebst das Stueck Torf aus der Kuhle."
    ));
    torf->move(ROOM "moor_b4.lpc",M_PUT || M_SILENT);
    tell_room(ENV(torf),"Ein Stueck Torf wird aus der Kuhle geworfen.\n");
//  TP->do_exhaust(TP->QueryProp(P_MV));
    return 1;
  }

  if( present("\nTORFNASS", ENV(TP)) )
  {
    TELLPLAYER(BS("Du hebst das Stueck Torf an, aber es faellt Dir sofort wieder herunter."
    ));
    return 1;
  }

  return 0;
}

