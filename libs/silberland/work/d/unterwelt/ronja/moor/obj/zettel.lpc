#include "../def.h"

inherit "/std/thing";

int gefaltet;

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT,"Ein kleiner Zettel");
  SetProp(P_LONG,
    "Ein kleiner, zusammengefalteter Zettel."
  );

  AddId( ({"zettel","\nEINKAUFSZETTEL"}) );

  SetProp(P_NAME_ADJ, ({"klein"}) );
  AddAdjective( ({"kleinen","kleiner","kleinem","kleines","kleine"}) );

  SetProp(P_NAME, "Zettel");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 5);
  SetProp(P_MATERIAL, ([MAT_PAPER:100]) );

  AddCmd( CMD_LESEN                                      , "cmd_lesen");
  AddCmd( ({"falte","entfalte","falt","klappe","klapp"}) , "cmd_falten");

  gefaltet = 1;
}

int cmd_falten(string str)
{
  notify_fail("Was moechtest Du auseinander falten?\n");

  if(!str || str == "") return 0;
  if(!(str == "zettel"             ||
       str == "zettel auseinander" ||
       str == "zettel auf"         )) return 0;

  TELLPLAYER("Du faltest den Zettel auseinander.\n");
  gefaltet = 0;
  SetProp(P_LONG,
    "Ein kleiner Zettel. Du kannst ihn lesen."
  );

  return 1;
}

int cmd_lesen(string str)
{
  notify_fail("Was moechtest Du lesen?\n");

  if(!str || str == "") return 0;
  if(!(str == "zettel"             ||
       str == "den zettel"         )) return 0;

  if(gefaltet)
  {
    TELLPLAYER("Der Zettel ist zusammengefaltet, so kannst Du ihn nicht lesen.\n");
    return 1;
  }

  TELLPLAYER("/------------------\\\n"
             "|Einkaufsliste     |\n"
             "|3 Eier            |\n"
             "|1 Pfund Butter    |\n"
             "|1 Landbrot        |\n"
             "|250 g Kaese       |\n"
             "|3 Soleros         |\n"
             "\\------------------/\n\n\n"
             "Scheint so, als ob Ronja den verloren hat.\n");
  return 1;
}


