#include "../def.h"

inherit "/std/thing";

int schmutzig;

string owner;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein Taschentuch");
  SetProp(P_LONG,
    "Ein kleines Taschentuch. Es wurde wohl mal aus etwas anderem genaeht. "
    "Es erfuellt aber seinen Zweck sehr gut. "
  );

  AddId( ({"tuch","taschentuch","\nTASCHENTUCH"}) );
  SetProp(P_NAME, "Taschentuch");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 20);
  SetProp(P_MATERIAL, ([MAT_CLOTH:100]) );

  AddDetail( ({"zweck"}) ,
    "Man kann sich damit die Nase putzen."
  );

  AddCmd( ({"putz","putze"}),  "cmd_putzen" );

  schmutzig = 0;
  owner = "";
}

void addslime()
{
  schmutzig = 1;

  SetProp(P_SHORT,"Ein schmutziges Taschentuch");
  SetProp(P_LONG,
    "Ein kleines Taschentuch. Es wurde wohl mal aus etwas anderem genaeht. "
    "Jemand hat es wohl schon benutzt. Igitt. "
  );

  SetProp(P_NAME_ADJ, ({"schmutzig"}) );
  AddAdjective( ({"schmutzigen","schmutziger","schmutzigem","schmutziges","schmutzige"}) );

  AddId( ({"\nBTASCHENTUCH"}) );
  SetProp(P_MATERIAL, ([MAT_CLOTH:95,MAT_SLIME:5]) );
}

void init()
{
  object pl;

  ::init();

  if(owner == "" && objectp(pl = ENV(TO)) && interactive(pl))
  {
    owner = getuuid(pl);
    return;
  }
}

varargs int move(mixed dest, int method,
                 string dir, string textout, string textin)
{
  object env;

  env = ENV(TO);

  if(owner == "" && objectp(dest) && interactive(dest))
  {
    owner == getuuid(dest);
  }

  if(objectp(env)          && interactive(env) &&
     owner == getuuid(env) && schmutzig == 0    )
  {
    tell_object(env, BS("Du nimmst das Taschentuch und schneuzt noch mal "
                        "kraeftig rein."));
    tell_room(ENV(env),BS(env->Name()+" schneuzt noch mal kraeftig in das "
                          "Taschentuch."), ({ env }) );
    addslime();
  }

  return ::move(dest,method,dir,textout,textin);
}

int cmd_putzen(string str)
{
  notify_fail("Was willst Du Dir putzen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "nase"         ||
       str == "deine nase"   ||
       str == "die nase"     )) return 0;

  if(schmutzig)
  {
    TELLPLAYER("Aber das Taschentuch wurde schon einmal benutzt!\n");
    return -1;
  }

  TP->command_me("schneuz");
  TELLPLAYER("Du putzt Dir mit dem Taschentuch die Nase.\n");

  addslime();

  MOORMASTER->Msg(TPUID+" schneuzt sich ins Taschentuch");
  return 1;
}


