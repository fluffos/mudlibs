#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein schwerer Schluessel");
  SetProp(P_LONG,
    "Ein schwerer Schluessel aus Eisen. Wo der wohl reinpasst?"
  );

  SetProp(P_NAME, "Schluessel");
  AddId( ({"schluessel", "OMA_WETTERWACHSENS_SCHLUESSEL"}) );

  SetProp(P_NAME_ADJ, ({"schwer"}) );
  AddAdjective( ({"schweren","schwerer","schwerem","schweres","schwere"}) );

  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 30);
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, ([MAT_IRON:100]) );

  AddDetail( ({"eisen"}) ,
    "Das Eisen ha sich im Laufe der jahre dunkel gefaerbt, jedoch befindet "
    "kein Rost an ihm. "
  );

  AddDetail( ({"rost"}) ,
    "Dieser Schluessel ist schon sehr alt. Aber Rost findest Du keinen "
    "an ihm. Als Du den Schluessel genauer untersuchst, faellt Dir eine "
    "Kerbe auf. "
  );

  AddDetail( ({"kerbe"}) ,
    "Hoffentlich zerbricht der Schluessel nicht an der Kerbe."
  );

}

