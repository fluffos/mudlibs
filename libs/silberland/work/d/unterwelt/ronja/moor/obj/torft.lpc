inherit "std/thing";

#include "../def.h"

string owner;

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Stueck trockener Torf");

  SetProp(P_LONG,
    "Ein Stueck getrockneter Torf. Damit kann man bestimmt gut heizen."
  );

  SetProp(P_NAME, "Stueck Torf");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"torf","\nTORFTROCKEN"}) );

  SetProp(P_NAME_ADJ, ({"trocken"}) );
  AddAdjective( ({"trockenen","trockener","trockenem","trockenes","trockene"}) );

  SetProp(P_MATERIAL, ([MAT_MISC_HERBAL:85,MAT_EARTH:15]) );
  SetProp(P_WEIGHT, 4000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);

  owner = "";
}

void removeme(object pl)
{
  object room;

  if(!pl)               return;
  if(!interactive(pl))  return;
  if(!(room = ENV(pl))) return;

  tell_room(room, BS("Als "+pl->Name()+" "+TO->name(WEN,1)+" nimmt, faellt "+
                     TO->QueryPronoun()+" herunter und zerbroeselt."), ({pl}) );

  tell_object(pl, BS("Als Du "+TO->name(WEN,1)+" nimmst, faellt "+
                     TO->QueryPronoun()+" herunter und zerbroeselt."));

  remove();
}

void init()
{
  object pl;

  ::init();

  if(!(pl = ENV(TO)))  return;
  if(!interactive(pl)) return;

  if(owner == "")
  {
    owner = getuuid(pl);
    return;
  }

  if(owner != getuuid(pl))
  {
    call_out("removeme",0,pl);
  }
}

void SetOwner(string uuid)
{
  owner = uuid;
}

string QueryOwner()
{
  return owner;
}

