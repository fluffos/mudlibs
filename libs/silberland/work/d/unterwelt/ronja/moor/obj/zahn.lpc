#include "../def.h"

inherit "std/thing";

object owner;

create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Schneidezahn");
// P_LONG wird ueber _query_long() gebildet

  SetProp(P_NAME, "Schneidezahn");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);

  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP,"Das ist doch aber ein Teil von Dir!\n");
  SetProp(P_NEVERDROP,1);
  SetProp(P_NOSELL,"Das ist ein Teil von Dir!\n");

  SetProp(P_MATERIAL, ([MAT_BONE:100]) );

  AddId ( ({"zahn","schneidezahn", "\nlispeln","NODESTRUCT","UNZERSTOERBAR"}) );
  owner=0;
}

init()
{
  ::init();
  if (owner && interactive(owner))
     {
            owner->SetProp(P_PERM_STRING, 0);
            owner=0;
     }
  if (environment()==TP)
     {
           owner=TP;
           owner->SetProp(P_PERM_STRING, this_object());
     }

}

string permutate_string(string str)
{
  string *woerter;
  string transformed;

  woerter=new_explode(str," sch");
  str=implode(woerter," f");

  woerter=new_explode(str,"Sch");
  str=implode(woerter,"F");

  woerter=new_explode(str,"sch");
  str=implode(woerter,"ch");

  woerter=new_explode(str,"S");
  str=implode(woerter,"F");

  woerter=new_explode(str,"sz");
  str=implode(woerter,"ff");

  woerter=new_explode(str,"ss");
  str=implode(woerter,"ff");

  woerter=new_explode(str,"s");
  str=implode(woerter,"f");

  woerter=new_explode(str,"Z");
  str=implode(woerter,"Tsch");

  woerter=new_explode(str,"z");
  str=implode(woerter,"tsch");

  woerter=new_explode(str,"X");
  str=implode(woerter,"Ksch");

  woerter=new_explode(str,"x");
  str=implode(woerter,"ksch");

  woerter=new_explode(str,"tio");
  str= implode(woerter,"schu");

  transformed = str;

  return transformed;
}

string _query_long()
{
  if ( objectp(owner) )
  return BS("Das ist "+owner->name(WESSEN)+" Schneidezahn. Es muss ziemlich weh getan "+
         "haben, als er herausgebrochen ist.");
  else
  return BS("Das ist scharfer Schneidezahn. Es muss ziemlich weh getan "+
         "haben, als er herausgebrochen ist.");

}

string extra_look()
{
  return capitalize(ENV(TO)->QueryPronoun(WEM))+
                    " fehlt ein Schneidezahn, deswegen lispelt "+
                    ENV(TO)->QueryPronoun(WER)+" auch.\n";
}

