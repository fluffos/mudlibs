#include "../def.h"

inherit "/std/thing";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Eine Gabel");
  SetProp(P_LONG,
    "Eine ganz normale Gabel mit einem fein ziselierten Griff und drei Zinken."
  );

  AddId( ({"gabel","\nGABEL","\nMOORGABEL"}) );
  SetProp(P_NAME, "Gabel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 75);
  SetProp(P_MATERIAL, ([MAT_TIN:100]) );


  AddDetail( ({"griff"}) ,
    "Der Griff ist fein ziseliert. Du kannst eine klitzkleine Gravur erkennen."
  );

  AddDetail( ({"gravur"}) ,
    "Die Gravur ist ziemlich klein und nur schwer zu erkennen."
  );

  AddReadDetail( ({"gravur"}) ,
    "Made in Silberland"
  );

  AddDetail( ({"zinken"}) ,
    "Damit kann man in etwas hineinstechen, um es aufzunehmen."
  );

  AddCmd( ({"stech","steche","stich",
            "erstech","ersteche","erstich"}),  "cmd_stechen" );

}

int cmd_stechen(string str)
{
  int n;
  string wohinein;
  object puppe,oma;

  notify_fail("In was willst Du stechen ?\n");

  if(!str || str == "") return 0;

           n=sscanf(str, "in %s", wohinein);
  if(n!=1) n=sscanf(str, "mit gabel in %s", wohinein);
  if(n!=1) n=sscanf(str, "gabel in %s", wohinein);
  if(n!=1) n=sscanf(str, "auf %s", wohinein);
  if(n!=1) wohinein = str;

  if(!(puppe=present(wohinein,TP)))
  {
    TELLPLAYER("Sowas hast Du doch gar nicht bei Dir.\n");
    return -1;
  }

  if(!(puppe->id("\nWACHSPUPPE")))
  {
    TELLPLAYER(BS("Du stichst ein paarmal in "+puppe->name(WEN)+" hinein, "
                  "aber ausser ein paar kleinen Loechern erreichst Du "
                  "gar nichts."));
    return -1;
  }

  if(!(oma=present("\nWETTERWACHS",ENV(TP))))
  {
    TELLPLAYER("Du stichst in die Puppe mit der Gabel hinein, aber nichts "
               "passiert.\n");
    return -1;
  }

  n = 0;
  if(puppe->QueryProp(P_PUPPE_KLEID) != 0)     n++;
  if(puppe->QueryProp(P_PUPPE_AUGEN) == 2)     n++;
  if(puppe->QueryPorp(P_PUPPE_HERZ) != "none") n++;
  if(puppe->QueryProp(P_PUPPE_HAARE) != 0)     n++;

  if(n != 4)
  {
    TELLPLAYER(BS("Du stichst in die Puppe hinein und fuehlst etwas Magie "
                  "aufkommen. Doch anscheinend ist die Magie nicht stark "
                  "genug. Eventuell fehlt an der Puppe noch etwas."));
    return -1;
  }

  oma->give_gem(TP);

  MOORMASTER->Msg(TPUID+" sticht in die Puppe");
  return 1;
}

