#include "../def.h"

inherit "std/mnpc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp (P_SHORT, "Eine Moorschnucke");
  SetProp (P_LONG,
    "Eine Moorschnucke. Frueher wurde diese Schafrasse wesentlich haeufiger "
    "in moorigen Gegenden gehalten, denn Moorschnucken sind gut an die "
    "feuchte Umgebung angepasst und auch sehr genuegsam. Durch ihr geringes "
    "Gewicht und ihre langen Beine sinken sie auch nicht so stark ein. Ob "
    "diese Schnucke hier wild lebt?"
  );

  SetProp(P_NAME, "Moorschnucke");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));

  AddId ( ({"moorschnucke", "schnucke"}) );

  create_default_npc(8);
  SetProp(P_RACE, "Schaf");
  SetProp(P_SIZE, 50+random(10));
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 4);

  SetChats( 2, ({
    "Die Moorschnucke aest etwas von dem Gras.\n",
    "Maeaeaeaeaeaeh.\n",
    "Die Moorschnucke beaeugt Dich interessiert.\n"
  }) );

  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "sucht woanders nach Futter");
  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht# um nach Futter zu suchen");
  SetProp(P_MNPC_AREA, ({ROOM "moor_b4"
                        ,ROOM "moor_c3"
                        ,ROOM "moor_c4"
                        ,ROOM "moor_d2"
                        ,ROOM "moor_d3"
                        ,ROOM "moor_d4"
                        ,ROOM "moor_e2"
                        ,ROOM "moor_f2"
                        ,ROOM "moor_f3"
                        }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "moor_d3");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "sagt: Maeaeaeaeaeah.\n");

}
