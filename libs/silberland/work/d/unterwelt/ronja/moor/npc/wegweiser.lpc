#include "../def.h"

inherit "std/npc";

int richtung;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Wegweiser");
  SetProp(P_LONG,
    "Ein alter Wegweiser. Der hat auch schon bessere Tage erlebt. Seine "
    "blaue Farbe blaettert schon ab, zahlreiche Wurmloecher sind zu sehen. "
    "Von den vier moeglichen Schildern ist nur noch eines vorhanden, die "
    "anderen sind abgebrochen und nicht mehr vorhanden."
  );

  AddDetail( ({"tage","tag"}) ,
    "Der Wegweiser scheint schon ziemlich alt zu sein, niemand scheint "
    "ihn reparieren zu wollen. Frueher war er schoen blau angestrichen, "
    "und er hatte auch noch seine vier Schilder, die jedem die Wege im "
    "Moor zeigten. "
  );

  AddDetail( ({"farbe"}) ,
    "Die blaue Farbe ist schon seit sehr langer Zeit nicht mehr erneuert "
    "worden, sie blaettert bereits grossflaechig ab."
  );

  AddDetail( ({"wurmloecher","wurmloch","loch","loecher"}) ,
    "Zahlreiche Holzwuermer setzen dem armen Wegweiser zu."
  );

  AddDetail( ({"holzwurm","holzwuermer"}) ,
    "Die kannst Du nicht sehen, denn die stecken alle in ihren Loechern."
  );

  AddDetail( ({"schilder"}) ,
    "Du kannst nur noch ein einziges entdecken."
  );

  AddSpecialDetail( ({"schild"}) , "detail_schild" );

  AddReadDetail( ({"schild"}) ,
    "Auf dem Schild kannst Du gerade noch 'HEXENHAUS' lesen."
  );

  SetProp(P_NAME, "Wegweiser");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"wegweiser","NOWIMPY"}));

  create_default_npc(8);
  SetProp(P_NOATTACK, "lebt doch gar nicht!\n");
  SetProp(P_RACE, "Wegweiser");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_WIMPY,0);
  SetProp(P_LOG_INFO, "/ronja/wegweiser");

  AddInfo(DEFAULT_INFO, "kennt nur den richtigen Weg.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Wegweiser braucht @WEN nicht.\n" }) );

  SetChats(4, ({
    "Der Wegweiser knarrt ein wenig vor sich hin.\n",
    "Der Wegweiser zieht sich einen Holzwurm heraus.\n",
    "Der Wegweiser dreht sich etwas im Wind.\n",
  }) );

  SUID;

  AddCmd( ({"frag","frage"})  , "cmd_fragen");
  AddCmd( ({"dreh", "drehe"}) , "cmd_drehen");

  richtung = random(4);

  SUID;
}

reset()
{
  ::reset();
  waehle_richtung();
}

int check_if_player(object ob)
{
  return (interactive(ob) && !(ob->QueryProp(P_INVIS)));
}

int waehle_richtung()
{
  int temp;

  temp = random(4);
  while(temp == richtung)
  {
    temp = random(4);
  }
  richtung = temp;

  return 1;
}

string detail_schild(string str)
{
  string s;

  s  = "Nur noch ein einzelnes Schild ist an diesem Wegweiser befestigt. "
       "Es zeigt momentan nach "
       + ({"Norden","Osten","Sueden","Westen"})[richtung] +
       ". Aber Du bist Dir nicht ganz sicher, ob das auch die richtige "
       "Richtung ist. Am besten fragst Du jemanden nach dem Weg, sonst "
       "trittst Du noch daneben und das koennte im Moor fatale Folgen haben. ";

  return BS(s);
}

int cmd_fragen(string str)
{
  MOORMASTER->Msg(TPUID+" fragt den Wegweiser nach "+TP->_unparsed_args());

  notify_fail("Wen moechtest Du nach dem Weg fragen?\n");

  if(!str || str == "") return 0;
  if(!(str == "wegweiser nach weg"           ||
       str == "wegweiser nach richtigen weg" ||
       str == "wegweiser nach richtigem weg" )) return 0;

  TELLPLAYER(BS("Der Wegweiser dreht sich etwas, so dass sein Schild nach "
    "Nordosten zeigt. Kurz danach kommt etwas Wind auf, und der Wegweiser "
    "dreht sich wieder etwas."
  ));
  TELLOTHERS("Eine kleine Brise dreht den Wegweiser etwas.\n");

  waehle_richtung();
  return 1;
}

int cmd_drehen(string str)
{
  object *spieler;
  int i;

  notify_fail("Was moechtest du drehen?\n");

  if(!str || str == "") return 0;
  if(!(str == "wegweiser"         ||
       str == "den wegweiser"     )) return 0;

  TELLPLAYER(BS("Du versuchst den Wegweiser zu verdrehen, und tatsaechlich "
    "geht das ganz einfach. So vertrauenserweckend ist der also gar nicht. "
    "Du solltest wirklich jemanden nach dem Weg fragen."));

  TELLOTHERS(BS(TPN+" verdreht den Wegweiser. Was das bloss soll? Andere "
    "Spieler in einen Hinterhalt locken?"));

  waehle_richtung();

  spieler = filter_array(all_inventory(ENV(TO)), "check_if_player");

  i = sizeof(spieler);
  while(i--){if(spieler[i] != TP)spieler[i]->command_me("argl");}

  return 1;
}

