#include "../def.h"

inherit "std/npc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Drachenlibelle");
  SetProp(P_LONG,
    "Die Drachenlibelle schwirrt ueber dem Moorsee, immer auf der Lauer "
    "nach Insekten. Ihre Fluegel sirren in der Luft und sind kaum zu "
    "erkennen. Wenn die Sonne richtig scheinen wuerde, wuerden die Fluegel "
    "bestimmt praechtig im Licht glitzern. Der Koerper der Libelle ist gruen "
    "und an ihrem Koerper glitzern einige Tautropfen. "
  );

  SetProp(P_NAME, "Drachenlibelle");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"libelle", "drachenlibelle","\nDRACHENLIBELLE","SCHUPPEN_WUSCHEL"}) );
  AddClass(CL_ANIMAL);


  AddDetail( ({"fluegel"}) ,
    "Die Fluegel der Libelle sirren in der Luft."
  );

  AddDetail( ({"insekten"}) ,
    "Im Moment siehst Du keine Insekten. Aber es sind bestimmt welche da, "
    "denn sonst wuerde die Libelle hier nicht auf die Jagd gehen. "
  );

  AddDetail( ({"koerper"}) ,
    "Der gruene Koerper der Libelle glitzert etwas im fahlen Licht. "
  );

  AddDetail( ({"tropfen","tautropfen"}) ,
    "Am Koerper der Libelle befinden sich einige Tautropfen, die ihm fahlen "
    "Licht etwas glitzern. "
  );

  AddDetail( ({"glitzern"}) ,
    "Es sind die Tautropfen, die im fahlen Licht glitzern. "
  );

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit ihren maechtigen Kiefern",QueryProp(P_HANDS)[1],
                     DT_PIERCE}));
  SetProp(P_RACE, "Libelle");
  SetProp(P_SIZE, 40);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 6);

  SetProp(P_MSGIN, "schwirrt um dich herum");
  SetProp(P_MSGOUT, "schwirrt");
  SetProp(P_MMSGIN, "schwirrt");
  SetProp(P_MMSGOUT, "schwirrt weg");

  SetProp(P_DIE_MSG,  " schlaegt noch ein letztes mal mit den Fluegeln.\n");
  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Drachenlibelle kann Deine Sachen doch gar nicht tragen.\n" }) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_SPELLRATE,40);

  AddSpell(1,400,
    "Die Drachenlibelle speit einen Feuerstrahl auf Dich.\n",
    "Die Drachenlibelle speit einen Feuerstrahl auf @WEN.\n",
    ({DT_FIRE,DT_MAGIC}),
    ([SP_SHOW_DAMAGE:1])
  );

  AddDefaultSpell(1, 100, DS_POISON,
    "Die Drachenlibelle spuckt Dich mit Speichel voll!\n",
    "Die Drachenlibelle spuckt @WEN mit Speichel voll!\n"
  );

  AddDefaultSpell(1, 250, DS_BLIND,
    "Die Drachenlibelle fliegt Dir direkt ins Auge!\n",
    "Die Drachenlibelle fliegt Dir direkt ins Auge!\n"
  );

}


