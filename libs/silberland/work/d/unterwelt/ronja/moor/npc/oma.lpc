void reset()
{
  ::reset();

  spieler  = ({});
  callouts = 0;
}

int give_gem(object player)
{
  object ob;

  if(ENV(TO) != ENV(player)) return -2;

  if(member(spieler,getuuid(player)) != -1)
  {
    tell_object(player,BSI("Du fuehrst mich nicht noch mal so schnell mit "
                           "dieser Voodoo Magie hinters Licht. "
                           "Verschwinde!\n","Oma Wetterwachs schimpft: "));
    return -1;
  }

  spieler += ({ getuuid(player) });

  tell_object(player,
    BSI("Voodoo! Nur das nicht! Hier, ich gebe Dir auch einen Edelstein. "
        "Den Ring dazu habe ich nicht, wenn die Feen wuessten... Ach was "
        "sage ich da! Nur lass mich mit dem Voodoozeugs zufrieden. Damit "
        "Du Dich nicht noch selbst verletzt, nehme ich Dir Dein Voodookram "
        "gleich mal ab."
       ,Name(WER,0)+"sagt aengstlich: ")
  );

  ob = present("\nMOORGABEL",player);
  if(ob) ob->remove();

  ob = present("\nWACHSPUPPE",player);
  if(ob) ob->remove();

  ob = clone_object(OBJ "amagem");
  ob->move(player,M_GET|M_NOCHECK|M_SILENT);

  MOORMASTER->Msg(TPUID+" kriegt Amaltheas Edelstein");
  return 1;
}

int zeug_darf_weg(object ob)
{
  if( ob->QueryProp(P_CURSED))    return 0;
  if( ob->QueryProp(P_NEVERDROP)) return 0;
  if( ob->id("QUESTOBJ"))         return 0;
  if( ob->QueryProp(P_NODROP))    return 0;
  if(!ob->QueryProp(P_SHORT))     return 0;
  if( ob->QueryProp(P_INVIS))     return 0;
  if(!ob->QueryProp(P_NAME))      return 0;
  return 1;
}

void spell_muenzen(object enemy, int damage, mixed dam_type)
{
  int geld;

  geld = enemy->QueryDeepMoney();

  if(geld > 0)
  {
    enemy->AddMoney(-geld);
    TO->AddMoney(geld);

    tell_room(ENV(TO),"Oma Wetterwachs strahlt wie ein Honigkuchenpferd!\n");
    MOORMASTER->Msg(CAP(getuid(enemy))+" gibt Oma "+geld+" Muenzen");
  }
  else
  {
    tell_object(enemy,"Oma Wetterwachs weint: Du bist ja genauso arm wie ich!\n");
    command_me("wein");
  }
}

void spell_unfug(object enemy)
{
  int n;
  object ob;

  switch(random(7))
  {
    case 0:
      enemy->SetProp(P_WIMPY_DIRECTION, "raste");
      if(enemy->HasAlias("raste"))
      {
        enemy->command_me("unalias raste");
        MOORMASTER->Msg("Alias 'raste' bei "+CAP(getuid(enemy))+" geloescht");
      }
      MOORMASTER->Msg(CAP(getuid(enemy))+" kriegt die Fluchtrichtung verstellt");
      break;

    case 1:
      enemy->SetProp(P_WIMPY, 0);
      tell_object(enemy,"Oma Wetterwachs staunt: Du bist aber mutig!\n");
      MOORMASTER->Msg(CAP(getuid(enemy))+" kriegt Wimpy auf 0");
      break;

    case 2:
      enemy->SetProp(P_WIMPY, enemy->QueryProp(P_MAX_HP)-1);
      tell_object(enemy,"Oma Wetterwachs staunt: Du bist aber feige!\n");
      MOORMASTER->Msg(CAP(getuid(enemy))+" kriegt Wimpy auf Max");
      break;

    case 3:
      tell_object(enemy,"Oma Wetterwachs schubst Dich aus der Kueche!\n");
      enemy->move(ROOM "eingang", M_GO);
      MOORMASTER->Msg(CAP(getuid(enemy))+" wird hinausgeschubst");
      break;

    case 4:
      if(enemy->HasAlias("zieh"))
      {
        enemy->command_me("unalias zieh");
        MOORMASTER->Msg("Alias 'zieh' bei "+CAP(getuid(enemy))+" geloescht");
      }

      enemy->command_me("zieh alles aus");
      MOORMASTER->Msg(CAP(getuid(enemy))+" muss alles ausziehen");
      break;

    case 5:
      if(enemy->HasAlias("wirf"))
      {
        enemy->command_me("unalias wirf");
        MOORMASTER->Msg("Alias 'wirf' bei "+CAP(getuid(enemy))+" geloescht");
      }

      enemy->comand_me("wirf alles weg");
      MOORMASTER->Msg(CAP(getuid(enemy))+" wirft alles weg");
      break;

    case 6:
      switch(enemy->QueryProp(P_GUILD))
      {
        case "dunkelelfen":
          enemy->SetProp(P_ALIGN, 1000);
          MOORMASTER->Msg("Oma Wetterwachs macht "+CAP(getuid(enemy))+" heilig");
          tell_object(enemy,"Oma Wetterwachs sagt: Du bist eigentlich ganz "
                            "nett!\n");
          break;

        case "berserker":
          ob = enemy->QueryProp(P_WEAPON);

          if(objectp(ob))
          {
            n = ob->QueryProp("wc_org");
            if(n == 0) ob->SetProp("wc_org", ob->QueryProp(P_WC));

            n = ob->QueryProp(P_WC) - 2;
            if(n < 60) n = 60;
            ob->SetProp(P_WC, n);
          }

          MOORMASTER->Msg("Oma Wetterwachs verschlechtert "+CAP(getuid(enemy))+" "+ob->name(WEN));
          tell_object(enemy, "Oma Wetterwachs laesst Funken um Deine Waffe "
                             "herum entstehen.\n");
          break;

        case "druidenzirkel":
          enemy->SetProp(P_ALCOHOL, enemy->QueryProp(P_MAX_ALCOHOL));
          MOORMASTER->Msg("Oma Wetterwachs macht "+CAP(getuid(enemy))+" betrunken");
          tell_object(enemy, "Oma Wetterwachs prostet Dir zu!\n");
          break;

        case "zechpreller":
          enemy->SetProp(P_ALCOHOL, 0);
          MOORMASTER->Msg("Oma Wetterwachs macht "+CAP(getuid(enemy))+" nuechtern");
          tell_object(enemy, "Oma Wetterwachs macht Dich nuechtern.\n");
          break;

        case "paladine":
          enemy->SetProp(P_ALIGN, -1000);
          MOORMASTER->Msg("Oma Wetterwachs macht "+CAP(getuid(enemy))+" boese");
          tell_object(enemy,"Oma Wetterwachs sagt: Du bist aber nicht nett!\n");
          break;

      }
  }
}

void spell_heilen(object enemy, int damage, mixed dam_type)
{
  int n;

  switch(random(100))
  {
    case  0 .. 35 : n = 10; break;
    case 36 .. 60 : n = 20; break;
    case 61 .. 77 : n = 30; break;
    case 78 .. 91 : n = 40; break;
    case 92 .. 99 : n = 50; break;
    default       : n = 25; break;
  }

  MOORMASTER->Msg("Oma Wetterwachs heilt sich mit "+n+" Punkten von "+CAP(getuid(enemy)));

  heal_self(n);
  enemy->do_damage(n);
}

void spell_ruestungweg(object enemy, int damage, mixed dam_type)
{
  object ob;

  if(enemy->HasAlias("gib"))
  {
    enemy->command_me("unalias gib");
    MOORMASTER->Msg("Alias 'gib' bei "+CAP(getuid(enemy))+" geloescht");
  }

  if (ob=present("ruestung", enemy) )
  {
    MOORMASTER->Msg("Oma Wetterwachs bekommt "+ob->name(WEN)+" von "+CAP(getuid(enemy)));
    enemy->command_me("gib oma ruestung");
    command("zieh ruestung an");
  }
  else if (ob=present("panzer", enemy) )
  {
    MOORMASTER->Msg("Oma Wetterwachs bekommt "+ob->name(WEN)+" von "+CAP(getuid(enemy)));
    enemy->command_me("gib oma panzer");
    command("zieh panzer an");
  }
  else
  {
    enemy->do_damage(10)+random(5);
    tell_object(enemy,"Oma Wetterwachs kichert: Du bist ja fast nackig!\n");
    command("kicher");
    enemy->command_me("schaem");
  }
}

void spell_waffeweg(object enemy, int damage, mixed dam_type)
{
  object weapon;

  weapon = enemy->QueryProp(P_WEAPON);
  if(!weapon) return;

  if(zeug_darf_weg(weapon))
  {
    tell_object(enemy,BS("Oma Wetterwachs murmelt etwas unverstaendliches und "
                         "auf einmal fliegt Deine Waffe in hohem Bogen aus "
                         "der Kueche heraus"));

    tell_room(ENV(TO),BS("Oma Wetterwachs murmelt etwas in einer "
                         "unverstaendlichen Sprache und auf einmal fliegt "+
                         enemy->name(WESSEN)+" Waffe in hohem Bogen aus der "
                         "Kueche."), ({enemy}) );
    weapon->move(ROOM "eingang",M_NOCHECK|M_PUT);
    tell_room(ROOM "eingang",BS(weapon->Name(WER,0)+" fliegt in hohem Bogen "
                                "herein."));
  }
  else
  {
    tell_object(enemy,BS("Oma Wetterwachs murmelt etwas unverstaendliches und "
                         "auf einmal spruehen seltsame Funken aus Deine"+
                         (weapon->QueryProp(P_GENDER)==FEMALE?"r ":"m ")+
                         weapon->name(RAW)+"."));

    tell_room(ENV(TO),BS("Oma Wetterwachs murmelt etwas in einer "
                         "unverstaendlichen Sprache und auf einmal spruehen "
                         "seltsame Funken aus "+enemy->name(WESSEN)+" Waffe "
                         "."), ({enemy}) );
    weapon->Damage(2+random(2));
  }

}

void die(int poisondeath)
{
  MOORMASTER->Msg("Oma Wetterwachs wurde von "+TPUID+" umgebracht");
  domainshout(CAP(getuid(TP))+" hat Oma Wetterwachs gemeuchelt!\n");
  ::die(poisondeath );
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    MOORMASTER->Msg("Oma Wetterwachs hat gerade "+UID(player)+" umgebracht");
    command("nimm alles aus leiche");
    heal_self(1000);
  }
  return;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(++callouts > 5) return;

  switch (gruppe)
  {
    case "fies":
      Kill(TP);
      break;

    case "frech":
      TP->AddHp(-3*TP->QueryProp(P_HP)/4);
      TP->AddSp(-3*TP->QueryProp(P_SP)/4);
      call_out("react", 0, TP,
        "wirft Dir einen boesen Blick zu",
        "wirft "+TPN+" einen boesen Blick zu"
      );
      break;

    case "traurig":
      call_out("react", 0, TP,
        "meint: Das wird schon wieder",
        "meint: Das wird schon wieder"
      );
      break;

    case "nett":
      call_out("react", 0, TP,
        "freut sich jemand Nettem zu begegnen",
        "freut sich jemand Nettem zu begegnen"
      );
      break;

    case "albern":
      call_out("react", 0, TP,
        "runzelt die Stirn",
        "runzelt die Stirn");
      break;

    case "aengstlich":
      call_out("react", 0, TP,
        "sagt: Vor mir brauchst Du doch keine Angst zu haben",
        "sagt: Vor mir brauchst Du doch keine Angst zu haben"
      );
      break;

    case "intim":
      call_out("react", 0, TP,
        "fluestert: Aber doch nicht hier vor allen Leuten",
        "fluestert etwas."
      );
      break;

    case "froh":
      call_out("react", 0, TP,
        "freut sich mit Dir",
        "freut sich"
      );
      break;

    case "aergerlich":
      call_out("react", 0, TP,
        "sagt: Jetzt beruhige Dich doch erstmal",
        "sagt: Jetzt beruhige Dich doch erstmal"
      );
      break;
  }
}

void react(object pl, string pstr, string ostr)
{
  if(!ENV(pl)) return;
  if(!ENV(TO)) return;
  if(ENV(TO) == ENV(pl))
  {
    tell_object(pl, BS(Name(WER, 1)+" "+pstr+"."));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+ostr+"."), ({pl}));
  }
  callouts--;
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

