  SetProp(P_SHORT, "Oma Wetterwachs");
  SetProp(P_LONG,
    "Oma Wetterwachs lebt hier zurueckgezogen in ihrem kleinen Haeuschen. "
    "Ab und zu kriegt sie wohl Besuch von ihren Hexenkolleginnen, "
    "aber ansonsten kommt sie nur noch selten aus dem Moor heraus. "
  );

  AddId( ({"oma"
