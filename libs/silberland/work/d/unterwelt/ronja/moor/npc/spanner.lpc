#include "../def.h"

inherit "std/npc";

int spanner;

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Birkenspanner");
  SetProp(P_LONG,
    "Der Birkenspanner lebt nur in der Naehe von Birken. Seine Fluegel sind "
    "dem Muster der Birkenrinde angepasst, so dass man ihn nur schwer "
    "ausmachen kann, wenn er sich auf einer Birke niederlaesst. "
  );

  SetProp(P_NAME, "Birkenspanner");
  SetProp(P_GENDER, MALE);
  AddId( ({"spanner", "birkenspanner","\nBIRKENSPANNER"}) );
  AddClass(CL_ANIMAL);

  create_default_npc(3);
  SetProp(P_HANDS, ({" mit seinen weissen Fluegeln", 20, DT_BLUDGEON}));
  SetProp(P_RACE, "Schmetterling");
  SetProp(P_SIZE, 10);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 6);

  SetProp(P_MSGIN, "flattert von einem Baumstamm auf");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "flattert her");
  SetProp(P_MMSGOUT, "flattert weg");

  SetProp(P_DIE_MSG,  " schlaegt noch ein letztes mal mit den Fluegeln.\n");
  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Birkenspanner kann Deine Sachen doch gar nicht tragen.\n" }) );

  SetProp(P_RESISTANCE, ({ DT_BLUDGEON, DT_FIRE, DT_WATER, DT_POISON,
                           DT_TERROR, DT_ACID, DT_LIGHT, DT_SOUND}));
  SetProp(P_VULNERABILITY, ({ DT_SQUEEZE, DT_EXPLOSION}));

  call_out("landung",60);

}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(enemy->QueryAttribute(A_DEX) > random(100) )
  {
    TELLPLAYER("Der Birkenspanner ist so geschickt, dass Du ihn gar "
               "nicht triffst.\n");
    return ::Defend(0, dam_type, spell, enemy);
  }
  return ::Defend(dam/4, dam_type, spell, enemy);
}

void landung()
{
  tell_room(ENV(TO), "Der Birkenspanner setzt sich wieder auf einen "
                     "Birkenstamm.\n");
  remove();
  return;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)
  {
    MOORMASTER->Msg(Name(WER,1)+" hat gerade "+CAP(getuid(player))+
                    " umgebracht (XP-Verlust : "+lostexp+")");
  }

  return;
}

varargs void die(int poisondeath)
{
  object enemy;

  if(enemy=QueryProp(P_KILLER))
  {
    MOORMASTER->Msg(CAP(Name(WER,1))+" wurde von "+CAP(getuid(enemy))+
                    " umgebracht");
  }

  ::die(poisondeath);
}

