#include "../def.h"

inherit "std/mnpc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp (P_SHORT, "Ein Moorhuhn");
  SetProp (P_LONG,
    "Ein Moorhuhn, welches hier im Silberland Asyl gefunden hat und unter "
    "Ronjas persoenlichem Schutz steht."
  );

  SetProp(P_NAME, "Moorhuhn");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));

  AddId ( ({"moorhuhn", "huhn","FEDERN_WUSCHEL"}) );

  create_default_npc(8);
  SetProp(P_NOATTACK, "hat Asyl beantragt und steht unter dem persoenlichen "
                      "Schutz von Ronja.");
  SetProp(P_RACE, "Huhn");
  SetProp(P_SIZE, 20+random(10));
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 4);

  SetChats( 2, ({
    "Das Moorhuhn schaut sich veraengstigt um.\n",
    "Das Moorhuhn sucht nach etwas essbarem.\n",
    "Das Moorhuhn zuckt zusammen.\n"
  }) );

  SetProp(P_MMSGIN, "flattert herein");
  SetProp(P_MMSGOUT, "bekommt Angst und flattert davon");
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "bekommt Angst und fluechtet#");
  SetProp(P_MNPC_AREA, ({ROOM "moor_b4"
                        ,ROOM "moor_c3"
                        ,ROOM "moor_c4"
                        ,ROOM "moor_d2"
                        ,ROOM "moor_d3"
                        ,ROOM "moor_d4"
                        ,ROOM "moor_e2"
                        ,ROOM "moor_f2"
                        ,ROOM "moor_f3"
                        }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "moor_d3");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "schaut Dich veraengstigt an.\n");

}
