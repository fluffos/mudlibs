#include "../def.h"

inherit "std/npc";

void create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Moorleiche");
  SetProp(P_LONG,
    "Dass das Moor ein konservierende Wirkung hat, hast Du "
    "ja schon gehoert. Aber eine solche Wirkung? Gestorben, "
    "aber doch nicht tot, blickt Dich diese Kreatur aus "
    "Augenhoehlen ohne Augen an."
  );

  SetProp(P_NAME, "Moorleiche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"moorleiche","leiche","NOWIMPY","NOCONTROL"}) );
  AddClass(CL_UNDEAD);

  create_default_npc(25);

  SetProp(P_HANDS, ({" mit verfaulten Fingern",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ALIGN, -600);
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 100);
  SetProp(P_WIMPY, 0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -1.0
     , DT_HOLY:      0.0, DT_UNHOLY:   -1.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:   -0.3
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_RACE, "Leiche");

  SetProp(P_DIE_MSG, " faellt zurueck in den Moorsee.\n");

  SetProp(P_MSGIN, "steigt aus dem Moor");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "steigt aus dem Moor");
  SetProp(P_MMSGOUT, "Verschwindet im Moor");

  SUID;

  SetProp(P_AGGRESSIVE, 1);
}

die(arg)
{
  MOORMASTER->Msg("Die Moorleiche wurde von "+TPUID+" umgebracht");
  ::die(arg);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    MOORMASTER->Msg("Eine Moorleiche hat gerade "+UID(player)+" umgebracht");
  }
  return;
}

