#include "../def.h"

#include <ansi.h>

void create()
{
  if (is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

  seteuid(getuid(this_object()));

  return;
}

void Msg(string s)
{
  object pl;

  write_file(LOG "moor.log",ctime()+": "+s+".\n");

  pl = find_player("ronja");

  if(!pl)              return;
  if(!interactive(pl)) return;

  s = BSI(s+".","MOORMASTER: ");
  if(pl->QueryProp(P_TTY)) s = ANSI_BOLD+ANSI_RED+s+ANSI_NORMAL;
  tell_object(pl,s);
}


