#include "../def.h"

inherit ROOM "moor_inh.lpc" ;

#define LW(x) (sizeof(x)==1 ? x[0] : implode(x[0..<2],", ")+" und "+x[<1])

string *spieler;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine alte Torfstecherei.");
  SetProp(P_INT_LONG,
    "Du befindest Dich an einer Stelle im Moor, wo frueher wohl Torf "
    "gestochen wurde. Ganz verlassen sieht die Torfstecherei jedoch nicht "
    "mehr aus, ihre Bluetezeit duerfte aber schon lange vorbei sein. Die "
    "oberste Erdschicht ist teilweise abgetragen, wodurch eine Moorkuhle "
    "entstanden ist. Unweit von der Moorkuhle steht ein kleiner Schuppen. "
  );

  AddDetail( ({"torfstecherei","stecherei"}) ,
    "Frueher hat man hier wohl jede Menge Torf gestochen. Aber jetzt sind "
    "nur noch wenige Torfsoden vorhanden. Ganz verlassen scheint die "
    "Stecherei aber nicht zu sein, denn man sieht ganz deutlich, dass hier "
    "noch vor kurzem jemand Torf gestochen hat. "
  );

  AddDetail( ({"menge"}) ,
    "Frueher wurde hier wohl viel Torf gestochen, jedenfalls ist die "
    "Moorkuhle ganz schoen gross. "
  );

  AddSpecialDetail( ({"moorkuhle","kuhle"}) , "detail_kuhle");

  AddDetail( ({"wasser"}) ,
    "Unten in der Moorkuhle steht etwas brackiges Wasser."
  );

  AddDetail( ({"torfsoden","torf"}) ,
    "Unten in der Moorkuhle kannst Du noch einige Torfsoden sehen, aus "
    "denen Du etwas Torf stechen koenntest. "
  );

  AddDetail( ({"stelle"}) ,
    "Hier an dieser Stelle befindet sich eine alte, verlassene Torfstecherei."
  );

  AddDetail( ({"moor"}) ,
    "Hier an dieser Stelle wurde frueher Torf gestochen."
  );

  AddDetail( ({"buelten"}) ,
    "Ein Buelten ist ein grosser Haufen schon getrockneten Torfs. "
    "Damit kann man bestimmt ein huebsches Feuerchen machen."
  );

  AddDetail( ({"feuer","feuerchen"}) ,
    "Hier brennt keines, aber an geeignter Stelle koennte man mit dem "
    "getrocknetem Torf schon etwas einheizen."
  );

  AddDetail( ({"haufen"}) ,
    "Dann und wann wird hier anscheinend doch noch Torf gestochen, denn Du "
    "siehst einen Buelten mit Torf, den jemand zum Trocknen aufgeschichtet "
    "hat. Wenn Du ein Stueck trockenen Torf haben moechtest, dann koenntest "
    "Du ja ein Stueck nassen Torf gegen ein Stueck trockenen Torf tauschen. "
    "Das faellt bestimmt keinem auf. "
  );

  AddDetail( ({"erdschicht","schicht"}) ,
    "Die ist an dieser Stelle abgetragen, weil hier noch jemand Torf sticht."
  );

  AddDetail( ({"bluetezeit"}) ,
    "Frueher hat man hier wohl sehr viel Torf gestochen, aber jetzt scheint "
    "jemand nur noch fuer seinen eigenen Bedarf Torf zu gewinnen."
  );

  AddDetail( ({"alter","alters"}) ,
    "Der Schuppen ist sehr alt, denn das Holz sieht sehr ausgetrocknet aus. "
    "Auch die Angeln sind schon ziemlich rostig. Trotz alledem ist der "
    "Schuppen noch sehr stabil."
  );

  AddDetail( ({"holz"}) ,
    "Das Holz des Schuppens ist schon so alt, dass Du gar nicht mehr "
    "feststellen kannst, von welchen Baeumen es eigentlich stammt."
  );

  AddDetail( ({"baeume","baeumen"}) ,
    "Hier gibt es weit und breit keine. Es sei denn, Du meinst die Baeume, "
    "die vor langer Zeit abstarben und letztendlich das Moor und den Torf "
    "bildeten."
  );

  AddDetail( ({"bedarf","eigenbedarf"}) ,
    "Viel Bedarf scheint nicht mehr fuer Torf zu bestehen. Der Haufen, der "
    "hier liegt, deckt ja grade mal den Eigenbedarf eines einzelnen."
  );

  AddDetail( ({"angel","angeln"}) ,
    "Die sehen arg rostig aus. Da es aber sehr stabile Angeln sind, wird es "
    "noch sehr lange dauern, bis sie durchgerostet sind."
  );

  AddDetail( ({"arbeit"}) ,
    "Ja, das muss wohl ein ganzen Stueckchen Arbeit gewesen sein, den ganzen "
    "Torf zu stechen und zu einem Buelten stapeln."
  );

  AddDetail( ({"stueckchen"}) ,
    "Ein Stueckchen ist ein kleines Stueck."
  );

  AddDetail( ({"stueck"}) ,
    "Ein Stueck ist ein Teil eines Ganzen."
  );

  AddDetail( ({"teil","teile"}) ,
    "Ein Teil ist ein Stueck von einem Ganzen."
  );

  AddDetail( ({"ganzen","ganzes"}) ,
    "Alle Teile zusammen ergeben ein Ganzes."
  );


  AddCmd( CMD_TRINKEN ,                                   "cmd_trinken" );
  AddCmd( ({"tausch","tausche"}) ,                        "cmd_tauschen");
  AddCmd( ({"zuende", "zuend", "entzuend", "entzuende"}), "cmd_zuenden" );
  AddCmd( ({"mach", "mache"}),                            "cmd_machen"  );
  AddCmd( ({"geh","gehe"}),                               "cmd_gehen"   );
  AddCmd( ({"betrete","betret"}),                         "cmd_betreten");

  NewDoor("schuppen", ROOM "schuppen" , ({"schuppen","tuer"}) ,
    ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL
     ,D_SHORT, "Ein alter Schuppen."
     ,D_LONG,  "Ein alter Schuppen, der aber trotz seines Alters noch sehr "
               "stabil aussieht. Neben dem Schuppen befindet sich ein "
               "Buelten. "
     ,D_NAME,  "Schuppen"
     ,D_GENDER,MALE
     ,D_MSGS,    ({"hinein","geht in den Schuppen","kommt herein"})
     ,D_OPENMSG, ({"Mit einem lauten Knarren oeffnest Du den Schuppen."
                  ,"Mit einem lauten Knarren oeffnet %s den Schuppen."
                  ," wird mit lauten Knarren von aussen geoeffnet."
                  })
     ,D_CLOSEMSG, ({"Mit einem lauten Knarren schliesst Du den Schuppen."
                   ,"Mit einem lauten Knarren schliesst %s den Schuppen."
                   ," wird mit lauten Knarren von aussen geschlossen."
                   })
     ,D_RESET_CLOSEMSG, " wird durch einen kleinen Windstoss geschlossen."
    })
  );

  AddSpecialExit( "norden"      , "keinausgang"  );
  AddSpecialExit( "nordosten"   , "keinausgang"  );
  AddExit( "osten", ([EX_DEST:ROOM "moor_c4",EX_TESTFUNC:"exit_osten" ]) );
  AddSpecialExit( "suedosten"   , "keinausgang"  );
  AddSpecialExit( "sueden"      , "keinausgang"  );
  AddSpecialExit( "suedwesten"  , "keinausgang"  );
  AddSpecialExit( "westen"      , "keinausgang"  );
  AddSpecialExit( "nordwesten"  , "keinausgang"  );
  AddSpecialExit( "runter"      , "exit_runter"  );

  spieler = ({ });
}

void SetThisDoor(int dstatus)
{
  DOOR_MASTER->SetDoorStatus(ROOM "schuppen",dstatus,TO);
}

int QueryThisDoor()
{
  return DOOR_MASTER->QueryDoorStatus(ROOM "schuppen",TO);
}

void reset()
{
  ::reset();

  spieler = ({ });
}

int check_if_player(object ob)
{
  return (interactive(ob) && !(ob->QueryProp(P_INVIS)));
}

int cmd_trinken(string str)
{
  notify_fail("Was willst Du trinken?\n");

  if(!str || str == "") return 0;
  if(!(str == "wasser aus kuhle"       ||
       str == "wasser"                 )) return 0;

  TELLPLAYER("Dazu muesstest Du erst runter in die Kuhle.\n");
  return 1;
}

int cmd_zuenden(string str)
{
  notify_fail("Das kannst Du nicht anzuenden.\n");

  if(!str || str == "") return 0;
  if(!(str == "torf"      ||
       str == "torf an"   )) return 0;

  TELLPLAYER(BS("Dann wuerde der Torf hier nutzlos verbrennen und die "
                "ganze Arbeit waere umsonst gewesen."));
  return 1;
}

int cmd_machen(string str)
{
  notify_fail("Was willst Du machen?\n");

  if(!str || str == "") return 0;
  if(!(str == "feuer"           ||
       str == "feuerchen"       ||
       str == "feuerchen an"    ||
       str == "feuer an"        )) return 0;

  TELLPLAYER(BS("Dann wuerde der Torf hier nutzlos verbrennen und die "
                "ganze Arbeit waere umsonst gewesen."));
  return 1;
}

int cmd_gehen(string str)
{
  notify_fail("Wo hinein moechtest Du gehen?\n");

  if(!str || str == "") return 0;
  if(!(str == "in schuppen"            ||
       str == "in den schuppen"        ||
       str == "in schuppen hinein"     ||
       str == "in den schuppen hinein" )) return 0;

  TP->command_me("schuppen");
  return 1;
}

int cmd_tauschen(string str)
{
  object torf;

  notify_fail("Was moechtest Du tauschen?\n");

  if(!str || str == "") return 0;

  if(!(str == "torf aus"                              ||
       str == "nassen torf gegen trockenen torf aus"  ||
       str == "nassen torf gegen trockenen torf"      ||
       str == "torf"                                  )) return 0;

  if(member(spieler, getuuid(TP)) != -1)
  {
    TELLPLAYER(BS("Lass den Torf erstmal wieder trocknen, das faellt sonst "
                  "bestimmt auf."));
    return -1;
  }

  if(!torf=present("\nTORFNASS",TP))
  {
    TELLPLAYER(BS("Den Torf hier hat jemand bestimmt muehsam gestochen und "
                  "getrocknet. Wenn Du schon etwas wegnimmst, dann solltest "
                  "Du wenigstens ein frisches Stueck Torf dabei haben, damit "
                  "Du den Buelten wieder auffuellen kannst."
    ));
    return -1;
  }

  TELLPLAYER(BS("Du nimmst ein Stueck von dem trockenem Torf und ersetzt es "
                "durch ein frisches Stueck. Das muss zwar erst trocknen, "
                "aber Du bekommst wenigstens nicht ganz so grosse "
                "Gewissensbisse. "
  ));

  torf->remove();

  torf=clone_object(OBJ "torft.lpc");
  torf->SetOwner(getuuid(TP));
  if (torf->move(TP,M_GET|M_SILENT) != 1)
  {
    torf->move(ME,M_GET|M_SILENT);
    TELLPLAYER(BS("Warum auch immer, der trockene Torf ist Dir zu schwer und "
                "faellt Dir zu Boden."
    ));
  }

  spieler += ({ getuuid(TP) });

  return 1;
}

int cmd_betreten(string str)
{
  notify_fail("Was moechtest Du betreten?\n");

  if(!str || str == "") return 0;
  if(!(str == "schuppen"         ||
       str == "den schuppen"     )) return 0;


  if(QueryThisDoor() == D_STATUS_CLOSED)
  {
    TELLPLAYER(BS("Du versuchst den Schuppen zu betreten, rennst aber mit "
                  "voller Wucht gegen die geschlossene Schuppentuer. "));
    TELLOTHERS(BS(CTPN+" rennt mit voller Wucht gegen die geschlosse "
                  "Schuppentuer. Was das wohl sollte?"));
    TP->AddHp(-15);
    return -1;
  }

  TP->command_me("schuppen");

  return 1;
}


int exit_runter(string dir)
{
  TP->move(ROOM "kuhle", M_GO, "in die Kuhle", "hopst"
                             , "kommt von oben herein gehopst");
  return 1;
}

int exit_osten(string str)
{
  object tweekrieger, stikker;
  int stat;

  if(!objectp(TP)) return 1;
  if(!interactive(TP)) return 1;

  stat = 0;
  if(tweekrieger = deep_present("\nTWEEKRIEGER",TP))
  {
    stat += 2;
    tweekrieger->remove();
  }

  if(stikker = deep_present("\nSTIKKER",TP))
  {
    stat +=1;
    stikker->remove();
  }

  switch(stat)
  {
    case 1 :
      TELLPLAYER(BS("Bevor Du nach Osten gehst, faellt Dir ein, dass Du "
                    "noch den Stikker bei Dir hast. Als Waffe ist der eh "
                    "nicht zu gebrauchen, daher bringst Du ihn noch rasch "
                    "in den Schuppen zurueck."
      )+"\n");
      break;

    case 2 :
      TELLPLAYER(BS("Bevor Du nach Osten gehst, faellt Dir ein, dass Du "
                    "noch den Tweekrieger bei Dir hast. Den kannst Du "
                    "ausserhalb vom Moor sowieso zu nichts gebrauchen, "
                    "deshalb bringst Du ihn wieder in den Schuppen zurueck."
      )+"\n");
      break;

    case 3 :
      TELLPLAYER(BS("Bevor Du nach Osten gehst, faellt Dir ein, dass Du "
                    "noch den Tweekrieger und den Stikker bei Dir hast. "
                    "Da das aber ganz spezielle Werkzeuge sind, die Du "
                    "ausserhalb vom Moor sowieso nicht nutzen kannst, "
                    "bringst Du sie noch schnell in den Schuppen zurueck."
      )+"\n");
      break;
  }

  ROOM "schuppen"->DeletePlayer(getuuid(TP));
  return 1;
}

string detail_kuhle(string key)
{
  string s;
  object *pl;
  object ob;

  s = "Durch das Torfstechen ist eine ziemlich grosse Moorkuhle entstanden. "
      "Unten in der Moorkuhle steht schwarz und unheimlich etwas Wasser. "
      "Dort unten kann man sicherlich noch das eine oder andere Stueck Torf "
      "stechen. ";

  if(ob=find_object(ROOM "kuhle"))
  {
    pl=filter_array(all_inventory(ob), "check_if_player");

    switch(sizeof(pl))
    {
      case 0  :
        break;

      case 1  :
        s += "In der Kuhle steht " + pl[0]->name()+".";
        break;

      default :
        s += "In der Kuhle stehen " + LW(map_objects(pl,"name")) + ".";
        break;
    }
  }

  return BS(s);
}


