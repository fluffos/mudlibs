#include "../def.h"

inherit ROOM "moor_inh.lpc" ;

int blaetter;
int spanner;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem kleinen Birkenwaeldchen");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem kleinen Birkenwald. Waren es bisher die "
    "Nebelschwaden, die diese Gegend fahl und unwirklich erschienen "
    "liessen, so sind es diesmal die weissen Staemme der Birken. Wie "
    "knochige Finger ragen sie aus dem Boden heraus und recken sich in den "
    "Himmel. Auf dem Boden liegt rotbraunes Laub. Das sollte Dich jedoch "
    "nicht vergessen lassen, dass sich darunter noch immer ein heim"
    "tueckisches Moor verbirgt. Im Norden kannst Du zwischen den Birken"
    "staemmen einen kleinen Erdhuegel erkennen. "
  );

  AddDetail( ({"erdhuegel"}) ,
    "Den kannst Du von hier aus nicht erforschen. "
  );

  AddDetail( ({"birkenwald","wald","birkenwaeldchen","waeldchen"
              ,"birkenwaeldchens"}) ,
    "Du befindest Dich mittendrin."
  );

  AddDetail( ({"boden"}) ,
    "Der Boden ist mit rotbraunem Laub bedeckt. Darunter kann sich jedoch "
    "ueberall noch das Moor verbergen, in dem Du versinken koenntest."
  );

  AddDetail( ({"nebelschwaden"}) ,
    "Die Nebelschwaden kannst Du nur noch am Rand des Birkenwaldes "
    "erkennen, doch die fahlweissen Staemme strahlen eine ebenso un"
    "heimliche Stimmung aus."
  );

  AddDetail( ({"gegend"}) ,
    "Dieses Gegend wird von den Leuten nur 'Das Todesmoor' genannt."
  );

  AddDetail( ({"staemme","stamm","birke","birken","finger"
              ,"birkenstamm","birkenstaemme","birkenstaemmen"
              }) ,
    "Wie knochige Finger ragen die weissen Staemme der Birken aus dem Boden "
    "hervor. Dich ueberlaeuft ein Schauer. Hat sich da auf der Rinde einer "
    "der Birken nicht etwas bewegt?"
  );

  AddSpecialDetail( ({"rinde","etwas"}) , "detail_rinde" );

  AddDetail( ({"himmel"}) ,
    "Der Himmel ist von einem Dunstschleier bedeckt, hinter dem Du die Sonne "
    "nur schemenhaft erkennen kannst. "
  );

  AddDetail( ({"laub"}) ,
    "Du nimmst etwas von dem rotbraunen Laub in die Haende, aber die "
    "trockenen Blaetter zerbroeseln sofort. Nachdenklich laesst Du das Laub "
    "wieder aus Deinen Haenden rieseln. "
  );

  AddDetail( ({"leute","leuten"}) ,
    "In Derlim erzaehlt man sich wahre Schauergeschichten ueber dieses Moor. "
    "Deswegen wagt sich wohl auch niemand mehr hierher. "
  );

  AddDetail( ({"derlim"}) ,
    "Derlim liegt von hieraus ungefaehr in suedlicher Richtung."
  );

  AddDetail( ({"todesmoor"}) ,
    "Viele gingen hinein, doch nur wenige kamen wieder heraus."
  );

  AddDetail( ({"stimmung"}) ,
    "Die Stimmung in diesem Moor ist gedrueckt und unheimlich."
  );

  AddDetail( ({"schauer"}) ,
    "Dich schauert, doch wieso kannst Du Dir nicht genau erklaeren. Ein Teil "
    "traegt bestimmt die unheimliche Stimmung dazu bei, einen anderen Teil "
    "die schaurigen Geschichten, die Du von dieser Gegend gehoert hast. "
  );

  AddDetail( ({"teil"}) ,
    "Das fuehrt jetzt nicht weiter."
  );

  AddDetail( ({"haende","hand"}) ,
    "Ist das jetzt sinnvoll, seine Haende jetzt zu untersuchen? Sauber "
    "machen kannst Du sie eh nicht hier."
  );

  AddDetail( ({"blaetter","birkenblaetter"}) ,
    "Birkenblaetter sollen eine heilsame und beruhigende Wirkung haben."
  );

  AddDetail( ({"wirkung"}) ,
    "Wenn man Birkenblaetter isst, so soll das sehr heilsam und beruhigend "
    "sein. "
  );

  AddDetail( ({"geschichte","geschichten","schauergeschichte"
              ,"schauergeschichten"}) ,
    "Wahre Schauergeschichten erzaehlen sich die Leute in Derlim ueber das "
    "Moor. "
  );

  AddDetail( ({"rand"}) ,
    "Der Rand des Birkenwaeldchens ist nur ein paar Schritte weit entfernt."
  );

  AddCmd( CMD_ESSEN                           ,  "cmd_essen");
  AddCmd( ({"reiss","reisse","rupf","rupfe"}) ,  "cmd_reissen");

//AddSpecialExit( "norden"      , "keinausgang"  );
  AddSpecialExit( "nordosten"   , "keinausgang"  );
  AddExit(        "osten"       , ROOM "moor_e2" );
  AddExit(        "suedosten"   , ROOM "moor_e3" );
  AddExit(        "sueden"      , ROOM "moor_d3" );
  AddSpecialExit( "suedwesten"  , "keinausgang"  );
  AddSpecialExit( "westen"      , "keinausgang"  );
  AddSpecialExit( "nordwesten"  , "keinausgang"  );

  blaetter = 3;
  spanner  = 1;
}

void reset()
{
  ::reset();

  blaetter = 3;
  spanner  = 1;
}

int cmd_essen(string str)
{
  string s;

  notify_fail("Was moechtest Du essen?\n");

  if(!str || str == "") return 0;
  if(!(str == "blaetter"         ||
       str == "birkenblaetter"   ||
       str == "blatt"            ||
       str == "blaetter"         )) return 0;

  s = "Nun, die vertrockneten Blaetter auf dem Boden sehen nicht sehr "
      "appetittlich aus. Daher versuchst Du an frische Blaetter heran "
      "zukommen. Du springst etwas hoch und schaffst es tatsaechlich, "
      "ein paar Blaetter abzustreifen, die Du sogleich verspeist. "
      ;

  if(blaetter && (random(5)==3))
  {
    s += "Du fuehlst Dich sogleich etwas besser.";
    TP->AddHp(8+random(8));
    blaetter--;
    MOORMASTER->Msg(TPUID+" heilt sich mit Birkenblaettern");
  }
  else
  {
    s += "Naja, das mit der heilsamen Wirkung muss wohl doch ein Geruecht "
         "sein, denn Du kannst keine Wirkung feststellen. Oder es waren die "
         "falschen Blaetter."
         ;
    MOORMASTER->Msg(TPUID+" isst Birkenblaetter ohne Wirkung");
  }

  TELLPLAYER(BS(s));
  TELLOTHERS(BS(TPN+" springt durch den Wald herum und reisst Blaetter von "
                "den Baeumen. Ob "
                +(TP->QueryProp(P_GENDER)==MALE ? "ihm" : "ihr")
                +" nicht ganz wohl ist?"
  ));
  return 1;
}

int cmd_reissen(string str)
{
  notify_fail("Was moechtest Du abreissen?\n");

  if(!str || str == "") return 0;
  if(!(str == "blaetter"                             ||
       str == "blaetter ab"                          ||
       str == "birkenblaetter"                       ||
       str == "birkenblaetter ab"                    ||
       str == "blaetter von baeume"                  ||
       str == "birkenblaetter von baeume"            ||
       str == "blaetter von den baeumen"             ||
       str == "birkenblaetter von den baeumen"       ||
       str == "blaetter von den baeumen ab"          ||
       str == "birkenblaetter von den baeumen ab"    )) return 0;

  TELLPLAYER(BS("Du springst durch den Wald herum und reisst ein paar "
                "Blaetter von den Baeumen."));
  TELLOTHERS(BS(TPN+" springt durch den Wald herum und reisst Blaetter von "
                "den Baeumen. Ob "
                +(TP->QueryProp(P_GENDER)==MALE ? "ihm" : "ihr")
                +" nicht ganz wohl ist?"
  ));
  MOORMASTER->Msg(TPUID+" reisst Birkenblaetter ab");

  return 1;
}

string detail_rinde(string str)
{
  string s;
  object ob;

  if(!spanner)
  {
    return BS("Du scheuchst einen Birkenspanner auf, der sich jedoch "
              "sogleich wieder auf einem anderen Baumstamm niederlaesst. ");
  }

  if(present("\nBIRKENSPANNER", TO))
  {
    return "War wohl doch nur eine Taeuschung.\n";
  }

  ob=clone_object(NPC "spanner.lpc");
  ob->move(TO,M_GO);
  spanner = 0;

  MOORMASTER->Msg(TPUID+" scheucht den Birkenspanner auf");

  return "";
}
