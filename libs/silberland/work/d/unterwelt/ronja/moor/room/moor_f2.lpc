#include "../def.h"

inherit ROOM "moor_inh.lpc" ;

int exit_test();

void create()
{
  ::create();

  AddSpecialExit( "norden"      , "keinausgang" );
  AddSpecialExit( "nordosten"   , "keinausgang" );
  AddSpecialExit( "osten"       , "keinausgang" );
  AddSpecialExit( "suedosten"   , "keinausgang" );
  AddExit(        "sueden"      , ([EX_DEST : ROOM "moor_f3", EX_TESTFUNC : #'exit_test ]) );
  AddExit(        "suedwesten"  , ([EX_DEST : ROOM "moor_e3", EX_TESTFUNC : #'exit_test ]) );
  AddExit(        "westen"      , ([EX_DEST : ROOM "moor_e2", EX_TESTFUNC : #'exit_test ]) );
  AddSpecialExit( "nordwesten"  , "keinausgang" );

  AddItem(NPC "pflanze.lpc", REFRESH_DESTRUCT);
}

int exit_test()
{
  object *pflanzen;
  int i;

  if(TP && interactive(TP))
  {
    pflanzen = filter_objects(all_inventory(TO), "id", "\nSONNENTAU");
    i = sizeof(pflanzen);

    while(i--)
    {
      if(member(pflanzen[i]->klebspieler(),getuid(TP)) > -1)
      {
        TELLPLAYER("Aber Du haengst doch an einer Leimrute fest !\n");
        return 0;
      }
    }
  }

  return 1;
}


