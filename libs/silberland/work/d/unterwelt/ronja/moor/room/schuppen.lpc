#include "../def.h"

inherit "/std/room";

string *spieler_astloch;
string *spieler_stikker;
string *spieler_zettel;
string *spieler_twee;

int staubflag;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Schuppen" );
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem alten Schuppen. Hier wurden frueher "
    "wohl die ganzen Werkzeuge aufbewahrt, die man zum Torf stechen "
    "so braucht. Die anhaltende Feuchtigkeit hat dem Schuppen "
    "allerdings nur wenig zusetzen koennen, denn obwohl man dem "
    "Schuppen sein Alter durchaus ansieht, macht er einen sehr "
    "soliden Eindruck."
  );

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"angeln"}) ,
    "Die Schuppentuer ist mit zwei massiven Eisenbeschlaegen am "
    "Schuppen angebracht."
  );

  AddSpecialDetail(
    ({"eisenbeschlaege","eisenbeschlaegen","beschlag","beschlaege"
     ,"oberen beschlag","eisenbeschlag"}) ,
    "detail_beschlag"
  );

  AddSpecialDetail( ({"platte"}), "detail_platte");

  AddDetail( ({"zettel"}) ,
    "Der Zettel wurde von jemanden hinter dem Eisenbeschlag "
    "versteckt. Mittlerweile ist er aber wohl etwas verrutscht, so "
    "dass man bei genauem Hinsehen ein klein wenig davon erkennen "
    "kann. Vielleicht gelingt es Dir ja, den Zettel hervor "
    "zuziehen?"
  );

  AddDetail( ({"eisen"}) ,
    "Das Eisen ist schon ein wenig rostig."
  );

  AddDetail( ({"rost","rostflecken"}) ,
    "An den Angeln haben sich schon ein paar Rostflecken gebildet, "
    "aber ansonsten sehen sie noch sehr stabil aus."
  );

  AddSpecialDetail( ({"unteren Beschlag"}) ,  "detail_beschlag" );

  AddDetail( ({"decke"}) ,
    "Die Decke ist ueber Dir. Schwere Holzbalken tragen das Dach."
  );

  AddDetail( ({"dach","holzbalken","balken"}) ,
    "Das Dach wird durch schwere Holzbalken getragen. Viel mehr "
    "kannst Du nicht erkennen, da es dort oben recht dunkel ist. "
    "Von einem der Balken scheint etwas herunterzuhaengen."
  );

  AddDetail( ({"etwas"}) ,
    "An einem der Balken siehst Du einen kleinen dunklen Schemen. "
    "Sieht aus wie ein kleines Saeckchen, das da zwischen den "
    "Balken herunterbaumelt."
  );

  AddDetail( ({"saeckchen","schemen"}) ,
    "Der Schemen sieht zwar wie ein Saeckchen aus, aber Du hast "
    "doch den Eindruck, dass es sich um etwas Lebendiges handeln "
    "muss. Wie bloss koennte man das aufscheuchen?"
  );

  AddDetail( ({"lebendiges"}) ,
    "Was koennte das bloss sein?"
  );

  AddDetail( ({"boden"}) ,
    "Der Boden ist mit schweren Holzdielen ausgelegt, so dass man "
    "nicht im Moor einsinkt."
  );

  AddDetail( ({"holzdielen","diele","holzdiele","dielen"}) ,
    "Den Boden des Schuppens bilden vier grosse Holzdielen."
  );

  AddDetail( ({"kante","kanten"}) ,
    "An einigen Stellen beruehren sich die Kanten der Holzdielen, an "
    "anderen Stellen befinden sich bis zu handgrosse Spalten "
    "zwischen den Holzdielen. Greif ruhig hinein, Du wirst schon "
    "sehen, was Du davon hast."
  );

  AddDetail( ({"spalte","spalten"}) ,
    "Na greif schon hinein. Wird Dich schon nichts beissen."
  );

  AddDetail( ({"wand","waende"}) ,
    "Die Waende sind aus schweren Brettern zusammengezimmert. Im "
    "Laufe der Zeit haben sie sich voellig schwarz gefaerbt, wohl "
    "weil das dunkle Wasser in ihnen hochsteigt und sie so schwarz "
    "faerbt. In den Ecken hat sich etwas Staub angesammelt."
  );

  AddDetail( ({"bretter","brettern"}) ,
    "Die Bretter, welche die Waende bilden, sind kohlrabenschwarz. "
    "Anscheinend steigt im laufe der Zeit das dunkle Moorwasser im "
    "Holz empor und verdunstet dort, wobei sich die Bretter "
    "schwarz faerben."
  );

  AddDetail( ({ "schwarz", "schwaerze" }),
       ([ 0: "Schliesse Deine Augen. Was Du dann siehst, ist schwarz.",
         "dunkelelf":
             "Eine Farbe, die Dir sehr am Herzen liegt." ]) );

  AddDetail( ({"farbe","farben"}) ,
    "Ausser schwarz gibt es hier keine anderen Farben."
  );

  AddDetail( ({"eck","ecke","ecken","staub","haufen","staubhaufen"}) ,
    "In einer der Ecken hat sich etwas Staub abgesetzt. Ob der "
    "Staub etwas verbirgt? Zumindest hat der Haufen die Form "
    "eines Schwertes, ganz so, als ob der Staub ein Schwert "
    "ueberdecken wuerde. Es ist bestimmt lohnenswert, einmal den "
    "Staub zu durchwuehlen."
  );

  AddDetail( ({"form"}) ,
    "Also, ein Schwert hat ungefaehr diese Form :                  \n"
    "                                                              \n"
    "              (@|                                             \n"
    " ,,           ,)|_____________________________________        \n"
    "//\\\\8@8@8@8@8@8 / _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \\    \n"
    "\\\\//8@8@8@8@8@8 \\_____________________________________/    \n"
    " ``           `)|                                             \n"
    "              (@|                                             \n"
  );


  AddDetail( ({"schwert","schwertes"}) ,
    "Nein, ein Schwert siehst Du hier nicht. Aber der Haufen Staub "
    "da hinten in der Ecke, der sieht so aus, als ob er ein "
    "Schwert zudecken wuerde."
  );

  AddDetail( ({"zeit"}) ,
    "Ueber Jahrzehnte muss dieser Schuppen schon hier stehen."
  );

  AddDetail( ({"jahrzehnte","jahrzehnt"}) ,
    "Naja, es koennten auch mehr als 10 Jahre sein."
  );

  AddDetail( ({"jahr","jahre","jahren"}) ,
    "Das Jahr hat 365 Tage, ausser Schaltjahre, die haben einen Tag mehr."
  );

  AddDetail( ({"tag","tage","schaltjahr","schaltjahre"}) ,
    "Fuer solche allgemeine Fragen gehst Du am besten in eine "
    "Bibliothek. Da kannst Du den ganzen Tag schmoekern."
  );

  AddDetail( ({"fragen","antworten"}) ,
    "Eine Bibliothek kann Dir viele Antworten auf Deine Fragen bieten."
  );

  AddDetail( ({"bibliothek"}) ,
    "Hier ist keine Bibliothek, hier ist nur ein Schuppen, in dem "
    "wohl frueher einmal Werkzeuge aufbewahrt wurden. "
  );

  AddDetail( ({"werkzeug","werkzeuge"}) ,
    "Hier wurde wohl frueher das Werkzeug aufgehoben, was man so "
    "zum Torf stechen braucht. Allerdings ist auf den ersten Blick "
    "kein Werkzeug zu sehen."
  );

  AddDetail( ({"wasser","grundwasser","moorwasser"}) ,
    "Das Grundwasser steht im Moor sehr hoch, daher saugen sich die "
    "Pfosten voll und faerben sich im Laufe der Zeit schwarz."
  );

  AddDetail( ({"feuchtigkeit"}) ,
    "Feuchtigkeit ist ein anderes Wort fuer geringe Mengen an Wasser."
  );

  AddDetail( ({"menge"}) ,
    "Nein, eine Menge Wasser nennt man nicht mehr Feuchtigkeit."
  );

  AddDetail( ({"torf"}) ,
    "Hier im Schuppen siehst Du keinen Torf. Du musst schon im Moor "
    "schauen, wenn Du welchen brauchst und ihn da stechen."
  );

  AddDetail( ({"schuppen"}) ,
    "Du befindest dich in ihm. Schau Dich ruhig um, vielleicht "
    "findet sich hier ja etwas brauchbares."
  );

  AddDetail( ({"moor"}) ,
    "Das Moor befindet sich ausserhalb des Schuppens. Wenn Du lieber "
    "im Moor forschst, musst Du nach draussen gehen."
  );

  AddDetail( ({"eindruck"}) ,
    "Dein erster Eindruck taeuscht Dich nicht. Dieser Schuppen ist "
    "uralt und wurde frueher zum Lagern von Werkzeug verwendet. Doch "
    "davon ist jetzt nichts mehr zu sehen."
  );

  AddDetail( ({"alter"}) ,
    "Du versuchst das Alter dieses Schuppens zu bestimmen, aber Du "
    "findest keinen Anhaltspunkt. Auch die Jahresringe der Pfosten "
    "helfen Dir nicht weiter, da die Pfosten schwarz gefaerbt sind "
    "und Du natuerlich auch keine vollstaendigen Jahresringe "
    "erkennen kannst."
  );

  AddDetail( ({"anhaltspunkt"}) ,
    "Dich muss das Alter des Schuppens ja wahnsinnig interessieren, "
    "wenn Du so penetrant versuchst, das Alter des Schuppens "
    "herauszubekommen. Du untersuchst den Schuppen noch einmal sehr "
    "genau und findest oberhalb der Tuer ein paar Zeichen eingeritzt."
  );

  AddDetail( ({"tuer"}) ,
    "Durch die Tuer kannst Du wieder nach draussen gelangen."
  );

  AddDetail( ({"zeichen"}) ,
    "Das koennten Buchstaben, aber auch Ziffern sein. Das Holz ist "
    "an dieser Stelle arg verwittert, so dass Du es nicht erkennen "
    "kannst."
  );

  AddDetail( ({"buchstaben","buchstabe","ziffer","ziffern"}) ,
    "Die Zeichen ueber der Tuer sind nur sehr schwer zu entziffern. "
    "Vielleicht solltest Du Dich mal etwas strecken, um sie besser "
    "lesen zu koennen."
  );

  AddDetail( ({"geheimnis"}) ,
    "Naja, das Alter des Schuppens ist sicher kein Geheimnis, aber "
    "irgendwie fuxt es Dich schon, dass Du hier staendig Hinweise "
    "bekommst, aber das Alter nicht herauszufinden ist."
  );

  AddDetail( ({"hinweise","pfosten"}) ,
    "Wenn schon die Zeichen ueber der Tuer nicht entzifferbar sind, "
    "schaust Du Dir die Pfosten nochmals sehr genau an. Aber auch "
    "jetzt findest Du nichts besonders, einen hervorstehenden Splint, "
    "das Loch eines Holzwurmes, ein paar Astloecher... wie "
    "gewoehnliche Pfosten nunmal so aussehen."
  );

  AddDetail( ({"splint"}) ,
    "Ein kleiner Splint steht aus einem der Pfosten ab. Wenn er "
    "Dich zu sehr stoert, kannst Du ihn ja abreissen."
  );

  AddDetail( ({"loch"}) ,
    "In den Pfosten hat wohl vor Jahren schon ein Holzwurm einen Gang "
    "gegraben. Das muss allerdings wirklich schon einige Zeit her sein, "
    "denn das Holz ist mit der Zeit steinhart geworden."
  );

  AddDetail( ({"holzwurm","wurm","holzwurmes"}) ,
    "Der letzte Holzwurm muss schon vor langer Zeit hier ausgezogen "
    "sein, denn das Holz ist steinhart. Hier wird sicherlich kein "
    "Holzwurm mehr gluecklich."
  );

  AddDetail( ({"gang"}) ,
    "Du kneifst ein Auge zu und spaehst in den Gang, den der Holzwurm "
    "in den Pfosten gebohrt hat. Doch der Gang ist nur wenige "
    "Millimeter tief."
  );

  AddDetail( ({"millimeter"}) ,
    "Das dachte ich mir, dass Du nicht weisst, wieviel ein Millimeter "
    "ist. Damit auch Du es verstehst: Der Gang ist in etwa so tief : --"
  );

  AddDetail( ({"astloecher"}) ,
    "Waere das Holz nicht so hart, wuerdest Du es glatt fuer "
    "Kiefernholz halten, denn dieses Holz ist ja beruechtigt fuer "
    "seine vielen Astloecher. Obwohl der Pfosten "
    "arg dunkel gefaerbt ist, kannst Du die Astloecher genau erkennen, "
    "denn sie sind noch dunkler als das Holz und heben sich "
    "deutlich ab. Bei einem Astloch wuerdest Du sogar sagen, es ist "
    "extrem dunkel."
  );

  AddDetail( ({"astloch"}) ,
    "Du schaust Dir dieses extrem dunkle Astloch genau an. Hey, in "
    "diesem Astloch ist gar kein Holz vorhanden. Du kneifst ein Auge "
    "zu und blinzelst mit dem anderen in das Astloch, um etwas zu "
    "erkennen. Viel ist es nicht, aber Du bist Dir sicher dass sich "
    "hinter diesem Astloch ein groesserer Hohlraum befindet. "
    "Anscheinend kann man etwas in dieses Astloch stecken."
  );

  AddDetail( ({"hohlraum"}) ,
    "Ja, hinter dem Astloch befindet sich ein kleiner Hohlraum. Bloss "
    "wie willst Du den untersuchen?"
  );

  AddDetail( ({"tolpatsch"}) ,
    "Ja, genau Dich meine ich! Steckst mal wieder Deine Finger "
    "ueberall rein. Das letzte mal musstest Du Deinen Finger mit "
    "Gewalt herauszerren und hast Dir dabei boese die Haut abgeschuerft."
  );

  AddSpecialDetail( ({"haut","finger"}) , "detail_finger" );

  AddDetail( ({"anatomie"}) ,
    "Ich kann Dir wirklich nur nahe legen, in eine Bibliothek zu gehen, "
    "wenn Dich das wirklich interessiert."
  );

  AddDetail( ({"buch"}) ,
    "Hier im Moor ist es so feucht, da wuerde jedes Buch sofort "
    "vermodern. Aber in Bibliotheken, da gibt es haufenweise Buecher."
  );

  AddDetail( ({"kiefer","kiefernholz",}) ,
    "Kieferholz ist viel zu weich, um einen solchen Schuppen zu bauen."
  );

  AddDetail( ({"holz"}) ,
    "Um welches Holz es sich hier handelt, laesst sich nicht mehr "
    "feststellen."
  );

  AddSpecialDetail( ({"auge","augen"}) , "detail_finger");

  AddDetail( ({"blick"}) ,
    "Weder auf den ersten noch auf den zweiten Blick siehst Du hier "
    "Werkzeuge. Ein dritter Blick wird Dir auch nicht mehr bringen."
  );

  AddDetail( ({"dritter blick","dritten blick"}) ,
    "Ok, Du wirfst auch noch einen dritten Blick, aber es bleibt "
    "dabei: Es hilft Dir nichts."
  );

  AddDetail( ({"jahresringe"}) ,
    "Die Jahresringe nutzen Dir natuerlich nicht viel, weil Du ja "
    "keine komplette Baumscheibe hast, an der Du die Jahresringe "
    "abzaehlen koenntest."
  );

  AddDetail( ({"baumscheibe"}) ,
    "Hier ist keine."
  );

  AddSound( DEFAULT_SOUND,
    "Die Holzdielen knarren ein wenig, wenn Du ueber sie laeufst, da "
    "sich ihre Kanten aneinander reiben."
  );

  AddCmd( ({"strecke","streck"})   , "cmd_strecken");
  AddCmd( ({"reiss","reisse"})     , "cmd_reissen");
  AddCmd( ({"steck","stecke"})     , "cmd_stecken");
  AddCmd( ({"zerr","zerre"})       , "cmd_zerren");
  AddCmd( ({"scheuch","scheuche"}) , "cmd_scheuchen");
  AddCmd( CMD_DURCHSUCHEN          , "cmd_durchsuchen");
  AddCmd( CMD_GREIFEN              , "cmd_greifen");
  AddCmd( ({"heb","hebe"})         , "cmd_heben");
  AddCmd( ({"zieh","ziehe"})       , "cmd_ziehen");

  NewDoor("raus", ROOM "moor_b4" , ({"schuppen","tuer","schuppentuer"}) ,
    ({D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME,  "Schuppentuer"
     ,D_GENDER,FEMALE
     ,D_LONG, "Die Schuppentuer haengt schon etwas schief in den Angeln, "
              "sieht aber ansonsten noch recht stabil aus."
     ,D_TESTFUNC, "exit_test"
     ,D_MSGS,    ({"nach draussen","geht","kommt aus dem Schuppen heraus"})
     ,D_OPENMSG, ({"Mit einem lauten Knarren oeffnest Du den Schuppen.",
                   "Mit einem lauten Knarren oeffnet %s den Schuppen.",
                   " wird mit lauten Knarren von innen geoeffnet."})
     ,D_CLOSEMSG, ({"Mit einem lauten Knarren schliesst Du den Schuppen.",
                   "Mit einem lauten Knarren schliesst %s den Schuppen.",
                   " wird mit lauten Knarren von innen geschlossen."})
     ,D_RESET_CLOSEMSG, " wird durch einen kleinen Windstoss geschlossen."
     })
  );

  spieler_astloch = ({ });
  spieler_stikker = ({ });
  spieler_zettel  = ({ });
  spieler_twee    = ({ });
  staubflag       = 0;
}

void DeletePlayer(string uid)
{
  spieler_stikker -= ({ uid });
  spieler_twee    -= ({ uid });
}

void reset()
{
  ::reset();

  spieler_stikker = ({ });
  spieler_zettel  = ({ });
  spieler_twee    = ({ });
}

int check_if_player(object ob)
{
  return (interactive(ob) && !(ob->QueryProp(P_INVIS)));
}

int staubwolke()
{
  if(!staubflag){call_out("staubweg",180);}

  staubflag = 1;
  SetProp(P_INT_SHORT, "In einer Staubwolke" );

  SetProp( P_INT_LONG,
    "Du befindest Dich in einem alten Schuppen. Jedoch wurde vor kurzem "
    "eine grosse Staubwolke aufgewirbelt, so dass Du nichts erkennen kannst."
  );

  AddCmd( CMD_UNTERSUCHEN, "cmd_untersuchen");
  return 1;
}

int staubweg()
{
  SetProp(P_INT_SHORT, "In einem Schuppen" );

  SetProp( P_INT_LONG,
    "Du befindest dich in einem alten Schuppen. Hier wurden frueher wohl "
    "die ganzen Werkzeuge aufbewahrt, die man zum Torf stechen so braucht. "
    "Die anhaltende Feuchtigkeit hat dem Schuppen allerdings nur wenig "
    "zusetzen koennen, denn obwohl man dem Schuppen sein Alter durchaus "
    "ansieht, macht er einen sehr soliden Eindruck."
  );

  tell_room(TO,BS("Langsam senkt sich der Staub wieder und Du kannst wieder "
                  "etwas erkennen."));
  RemoveCmd( CMD_UNTERSUCHEN );
  staubflag = 0;
  return 1;
}

int exit_test()
{
  if(!objectp(TP))     return 0;
  if(!interactive(TP)) return 0;

  if(member(spieler_astloch, getuuid(TP)) == -1) return 0;

  TELLPLAYER(BS("Aber Du steckst doch mit Deinem Finger in einem Astloch "
                "fest und kannst daher den Schuppen gar nicht verlassen."));

  return 1;
}

int cmd_strecken(string str)
{
  TELLPLAYER(BS("Du reckst und streckst Dich, aber die Zeichen kannst Du "
                "doch nicht entziffern. So wird das Alter des Schuppens "
                "wohl doch ein Geheimnis fuer Dich bleiben."
  ));

  TELLOTHERS(BS(CTPN+" reckt und streckt sich und macht sich lang. Sieht "
                "irgendwie nach Turnuebungen aus."
  ));

  return 1;
}

string detail_platte(string str)
{
  string s;

  if(member(spieler_stikker, getuuid(TP)) > -1)
  {
    s = "Gerade eben hattest Du sie noch in der Hand. Aber wenn "
        "man sie wieder anbringt ist nichts davon zu sehen. ";
  }
  else
  {
    s = "Sowas siehst Du da nicht!";
  }

  return BS(s);
}

string detail_finger(string str)
{
  string s;

  s  = "Wenn Du etwas ueber Koerperteile wissen willst, dann geh in die "
       "naechste Bibliothek und lies ein Buch ueber ";

  switch (TP->QueryProp(P_RACE))
  {
    case "Fee":
      s += "die Anatomie der Feen.";
      break;

    case "Mensch":
      s += "menschliche Anatomie.";
      break;

    case "Elf":
      s+= "elfische Anatomie.";
      break;

    case "Zwerg":
      s += "zwergische Anatomie.";
      break;

    case "Hobbit":
      s += "die Anatomie der Hobbits.";
      break;

    case "Troll":
      s += "trollische Anatomie. Sofern Du das verstehen kannst.";
      break;

    case "Dunkelelf":
      s += "die Anatomie der Dunkelelfen.";
      break;

    case "Oger":
      s += "die Anatomie der Oger.";
      break;

    default:
      s += "Anatomie.";
      break;
  }

  return BS(s);
}

string detail_beschlag(string str)
{
  string s;

  if(member(spieler_zettel, getuuid(TP)) > -1)
  {
    s = "Die Eisenbeschlaege sind schon etwas rostig, sehen aber ansonsten "
        "noch sehr stabil aus. "
        ;
  }
  else
  {
    s = "Die Eisenbeschlaege sind schon etwas rostig, sehen aber ansonsten "
        "noch sehr stabil aus. Hinter dem oberen Beschlag scheint jemand "
        "einen Zettel versteckt zu haben."
        ;
  }

  return BS(s);
}

int cmd_reissen(string str)
{
  notify_fail("Was moechest Du abreissen?\n");

  if(!str || str == "") return 0;
  if(!(str == "splint"               ||
       str == "splint ab"            ||
       str == "splint von balken ab" ||
       str == "splint von balken"    )) return 0;

  TELLPLAYER(BS("Du versuchst, den Splint vom Balken abzureissen. Wozu das "
                "wohl gut sein soll? Und es kommt natuerlich, wie es kommen "
                "muss: Du stichst Dir in den Finger."
  ));

  TELLOTHERS(BS(TPN+" steckt sich schnell den Zeigefinger in den Mund. Ob "+
                TP->QueryPronoun(WER)+" sich in den Finger gestochen hat?"
  ));

  SetProp(P_KILL_NAME,"Ein kleiner Holzsplitter");
  TP->do_damage(10);

  return 1;
}

int cmd_stecken(string str)
{
  notify_fail("Das kannst Du nicht in das Astloch stecken.\n");

  if(!str || str == "") return 0;
  if(!sizeof(regexp( ({str}), "\\<finger\\>.*\\<astloch\\>"))) return 0;

  if(member(spieler_astloch,getuuid(TP)) > -1)
  {
    TELLPLAYER(BS("Das hast Du doch schon gemacht, oder was glaubst Du "
                  "weswegen Du jetzt festhaengst?"));
    return -1;
  }

  TELLPLAYER(BS("Du steckst einen Finger in das Astloch und versuchst "
                "den Hohlraum dahinter zu ertasten. Der Hohlraum ist recht "
                "gross und es scheint ein Gegenstand darin versteckt zu "
                "sein, den Du natuerlich nicht durch das Astloch "
                "herausziehen kannst. Als Du den Finger herausziehen "
                "willst, merkst Du, dass Du feststeckst. Du bist aber auch "
                "ein Tolpatsch."));

  spieler_astloch += ({ getuuid(TP) });

  return 1;
}

int cmd_zerren_1()
{
  if(member(spieler_astloch, getuuid(TP)) == -1)
  {
    TELLPLAYER("Du steckst doch gar nicht fest!\n");
  }
  else
  {
    TELLPLAYER(BS("Du zerrst und zerrst, aber der Finger bleibt in dem "
                  "Astloch drin stecken."));
  }
  return -1;
}

int cmd_zerren_2()
{
  object stikker;

  if(-1 == member(spieler_astloch, getuuid(TP)))
  {
    TELLPLAYER("Du steckst doch gar nicht fest!\n");
    return -1;
  }

  TELLPLAYER(BS("Du zerrst mit aller Gewalt Deinen Finger aus dem Astloch "
                "heraus, dabei schuerfst Du Dir die ganze Haut am Finger "
                "ab. Autsch, das tut ganz schoen weh."));

  spieler_astloch -= ({ getuuid(TP) });
  SetProp(P_KILL_NAME,"Eine eigentlich unbedeutende Hautabschuerfung");
  TP->do_damage(15);
  if(TP->QueryProp(P_GHOST)) return -1;

  TELLPLAYER(BS("Durch Dein Zerren hast Du eine geheime Platte "
                "herausgerissen. Hinter der Platte befand sich "
                "tatsaechlich ein Hohlraum, wie Du schon vermutet "
                "hattest."));

  if(member(spieler_stikker,getuuid(TP)) > -1)
  {
    TELLPLAYER(BS("Allerdings ist der Hohlraum leer. Du bringst die Platte "
                  "wieder an, damit keiner Dein Missgeschick mitbekommt. "
                  "Die Platte fuegt sich wieder nahtlos in den Pfosten ein. "
                  "Auch wenn Du nun weisst, dass sich dort eine geheime "
                  "Platte verbirgt, so kannst Du sie nicht erkennen."
    ));
    return -1;
  }

  stikker = clone_object(WEAPON "stikker");
  if(stikker->move(TP,M_GET|M_SILENT) != 1)
  {
    stikker->move(TO,M_NOCHECK|M_SILENT);
    TELLPLAYER(BS("Ein dolchartiger Gegenstand faellt heraus und landet "
                  "vor Deinen Fuessen. Du verschliesst den Hohlraum "
                  "wieder mit der Platte. Nichts deutet mehr auf den "
                  "Hohlraum oder gar die Platte hin."));
  }
  else
  {
    TELLPLAYER(BS("In dem Hohlraum befindet sich ein dolchartiger Gegenstand, "
                  "den Du sofort nimmst. Danach verschliesst Du den Hohlraum "
                  "wieder mit der Platte."));
  }

  spieler_stikker += ({ getuuid(TP) });
  MOORMASTER->Msg(TPUID+" findet den Stikker");

  return 1;
}

int cmd_zerren(string str)
{
  notify_fail("Was moechtest Du wo heraus zerren?\n");

  if(!str || str == "") return 0;

  if( (str == "finger aus loch"            ||
       str == "finger aus loch heraus"     ||
       str == "finger aus loch raus"       ||
       str == "finger aus astloch"         ||
       str == "finger aus astloch heraus"  ||
       str == "finger aus astloch raus"    ||
       str == "finger heraus"              ||
       str == "finger raus"                ))
  {
    return cmd_zerren_1();
  }

  if( (str == "finger mit gewalt aus loch"            ||
       str == "finger mit gewalt aus loch heraus"     ||
       str == "finger mit gewalt aus loch raus"       ||
       str == "finger mit gewalt aus astloch"         ||
       str == "finger mit gewalt aus astloch heraus"  ||
       str == "finger mit gewalt aus astloch raus"    ||
       str == "finger mit gewalt heraus"              ||
       str == "finger mit gewalt raus"                ))
  {
    return cmd_zerren_2();
  }

  return 0;
}

int cmd_scheuchen(string str)
{
  MOORMASTER->Msg(TPUID+" versucht etwas aufzuscheuchen");

  notify_fail("Was moechtest Du aufscheuchen?\n");

  if(!str || str == "") return 0;
  if(!(str == "etwas auf"  ||
       str == "etwas"      )) return 0;

  TELLPLAYER(BS("Du hopst und huepfst in der Gegend herum und wedelst dabei "
                "mit den Armen in der Luft herum. Das sieht ziemlich affig "
                "aus. Hoffentlich hat Dich keiner gesehen. Und aufgescheucht "
                "hast Du auch nichts."));

  TELLOTHERS(BS(TPN+" huepft und hopst in der Gegend herum und wedelt "
                "zusaetzlich mit den Armen. Das sieht ziemlich albern aus."
  ));

  return 1;
}

int cmd_durchsuchen(string str)
{
  object *spieler;
  int i;

  notify_fail("Was willst Du durchsuchen?\n");

  if(!str || str == "") return 0;
  if(!(str == "staub"           ||
       str == "in staub"        ||
       str == "im staub"        ||
       str == "staubhaufen"     ||
       str == "in staubhaufen"  ||
       str == "im staubhaufen"  ||
       str == "haufen"          ||
       str == "in haufen"       ||
       str == "im haufen"       )) return 0;

  TELLPLAYER(BS("Du faengst an, in dem Staub herumzuwuehlen, wirbelst "
                "dabei aber jede Menge Staub auf und kannst dadurch so gut "
                "wie nichts mehr sehen."));

  TELLOTHERS(BS(TPN+" wuehlt in einer Ecke des Schuppens herum und wirbelt "
                "dabei jede Menge Staub auf, der Dir letztendlich die Sicht "
                "nimmt."));

  staubwolke();

  spieler = filter_array(all_inventory(TO),"check_if_player");
  i = sizeof(spieler);
  while(i--) spieler[i]->command_me("hust");

  MOORMASTER->Msg(TPUID+" wuehlt eine Menge Staub auf");

  return 1;
}

int cmd_untersuchen(string str)
{
  TELLPLAYER("Durch die aufgewirbelte Staubwolke kannst Du nichts erkennen.\n");
  return 1;
}

int cmd_greifen(string str)
{
  notify_fail("Wo hinein moechtest Du greifen?\n");

  if(!str || str == "") return 0;
  if(!(str == "spalte"             ||
       str == "in spalte"          ||
       str == "in spalte hinein"   ||
       str == "spalt"              ||
       str == "in spalt"           ||
       str == "in spalt hinein"    )) return 0;

  SetProp(P_KILL_NAME,"Ein rostiger Nagel");
  TELLPLAYER(BS("Du denkst Dir nur:\"Pah, was soll da schon passieren\" und "
                "steckst Deine Hand in eine der Spalten. Da durchzuckt Dich "
                "auch schon ein stechender Schmerz, denn Du hast genau in "
                "einen rostigen Nagel gegriffen."));

  TELLOTHERS(BS(TPN+" kniet nieder und scheint auf dem Boden etwas zu "
                "suchen. Ploetzlich zuckt "+TP->QueryPronoun(WER)+
                " zusammen."));
  TP->do_damage(20);
  if(TP->QueryProp(P_GHOST)) return 1;

  TELLPLAYER(BS("*Autsch* Das hat weh getan. Als Du Deine Hand vor Schmerz "
                "zurueckziehst, bemerkst Du, dass die Holzdielen anscheinend "
                "nur sehr lose auf dem Untergrund aufliegen und sich wohl "
                "anheben lassen."));
  return 1;
}

int cmd_heben(string str)
{
  object tweekrieger;

  notify_fail("Was willst Du anheben?\n");

  if(!str || str == "") return 0;
  if(!(str == "diele"          ||
       str == "diele an"       ||
       str == "diele hoch"     ||
       str == "holzdiele"      ||
       str == "holzdiele an"   ||
       str == "holzdiele hoch" )) return 0;

  if(member(spieler_twee, getuuid(TP)) != -1)
  {
    TELLPLAYER(BS("Unter der Holzdiele befindet sich jedoch nichts und so "
                  "legst Du die Holzdiele wieder an ihren Platz."));
    return -1;
  }

  tweekrieger = clone_object(OBJ "tweekrieger");
  if(tweekrieger->move(TP,M_GET|M_SILENT) != 1)
  {
    TELLPLAYER(BS("Unter der Holzdiele liegt in einem Versteck etwas, was "
                  "auf den ersten Blick aussieht wie eine Schaufel oder ein "
                  "Spaten. Du versuchst das Ding an Dich zunehmen, doch wird "
                  "Dir das alles zu schwer und die Holzdiele knallt Dir auf "
                  "die Fuesse."));
    tweekrieger->remove();
    SetProp(P_KILL_NAME,"Eine schwere Holzdiele");
    TP->do_damage(5);
    return -1;
  }

  TELLPLAYER(BS("Unter der Holzdiele liegt ein schaufelartiger Gegenstand, "
                "den Du sogleich an Dich nimmst. Danach legst Du das Brett "
                "wieder ordentlich an seinen Platz."));

  spieler_twee += ({ getuuid(TP) });
  MOORMASTER->Msg(TPUID+" findet den Tweekrieger");

  return 1;
}

int cmd_ziehen(string str)
{
  object zettel;

  notify_fail("Was moechtest Du hervorziehen?\n");

  if(!str || str == "") return 0;

  if( (str == "finger aus loch"            ||
       str == "finger aus loch heraus"     ||
       str == "finger aus loch raus"       ||
       str == "finger aus astloch"         ||
       str == "finger aus astloch heraus"  ||
       str == "finger aus astloch raus"    ||
       str == "finger heraus"              ||
       str == "finger raus"                ))
  {
    return cmd_zerren_1();
  }

  if( (str == "finger mit gewalt aus loch"            ||
       str == "finger mit gewalt aus loch heraus"     ||
       str == "finger mit gewalt aus loch raus"       ||
       str == "finger mit gewalt aus astloch"         ||
       str == "finger mit gewalt aus astloch heraus"  ||
       str == "finger mit gewalt aus astloch raus"    ||
       str == "finger mit gewalt heraus"              ||
       str == "finger mit gewalt raus"                ))
  {
    return cmd_zerren_2();
  }

  if(str == "zettel"                             ||
     str == "zettel hervor"                      ||
     str == "zettel hinter beschlaegen hervor"   ||
     str == "zettel hinter beschlag hervor"       )
  {
    if(member(spieler_zettel, getuuid(TP)) > -1)
    {
      TELLPLAYER("Was fuer einen Zettel?\n");
      return -1;
    }

    MOORMASTER->Msg(TPUID+" findet den Einkaufszettel");

    zettel = clone_object(OBJ "zettel");

    if(zettel->move(TP,M_GET|M_SILENT) != 1)
    {
      zettel->move(TO,M_NOCHECK|M_SILENT);
      TELLPLAYER(BS("Du ziehst den Zettel hinter dem Beschlag hervor. Aber Du "
                    "mickriger Schwaechling bist noch nichtmal in der Lage, "
                    "einen Zettel hochzuheben, deswegen segelt der Zettel "
                    "sanft auf den Boden."));
    }
    else
    {
      TELLPLAYER("Geschickt ziehst Du den Zettel hinter dem Beschlag hervor.\n");
      spieler_zettel += ({ getuuid(TP) });
    }

    TELLOTHERS(TPN+" fummelt an der Schuppentuer herum.\n");
    return 1;
  }

  return 0;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  spieler_astloch -= ({ getuuid(player) });
}

void BecomesNetDead(object pl)
{
  spieler_astloch -= ({ getuuid(pl) });
}

