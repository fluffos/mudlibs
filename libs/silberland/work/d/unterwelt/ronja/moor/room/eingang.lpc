#include "../def.h"

inherit "/std/room";

#define LW(x) (sizeof(x)==1 ? x[0] : implode(x[0..<2],", ")+" und "+x[<1])

int bildschief;

string sound(string str);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Flur" );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"einrichtung"}) ,
    "Die Einrichtung besteht nur aus einem Teppich, einer alten Truhe und "
    "einem Bild an der Wand. "
  );

  AddDetail( ({"decke"}) ,
    "Die befindet sich ueber Dir und ist in demselben Stil gehalten wie die "
    "Waende."
  );

  AddDetail( ({"stil"}) ,
    "Die Decke ist genau in demselben Stil gehalten wie die Waende."
  );

  AddDetail( ({"wand","waende"}) ,
    "An den Waenden kannst Du das Fachwerk erkennen. Alte Balken sind "
    "sauber mit Lehm ausgekleidet und verputzt. An einer der Waende haengt "
    "ein Bild."
  );

  AddDetail( ({"boden"}) ,
    "Auf dem Boden liegt ein schon etwas abgewetzter Teppich, damit nicht "
    "der ganze Schmutz in das Haus getragen wird."
  );

  AddDetail( ({"tueren"}) ,
    "Die Tueren stehen alle offen, so dass Du ungehindert in alle Raeume "
    "gehen kannst. Die Tuer im Sueden scheint allerdings etwas besonderes "
    "zu sein."
  );

  AddDetail( ({"raum","flur"}) , QueryProp(P_INT_LONG));

  AddDetail( ({"schild"}) ,
    "Es ist ein kleines Metallplaettchen, welches mit zwei Naegeln an der "
    "Tuer befestigt wurde. "
  );

  AddDetail( ({"naegel","naegeln"}) ,
    "Damit das Metallplaettchen nicht herunterfaellt, ist es mit zwei "
    "Naegeln an der Tuer befestigt."
  );

  AddDetail( ({"raeume"}) ,
    "Geh hinein und sieh Dich um. Oder lass es. Ganz wie Du willst."
  );

  AddDetail( ({"lied","lieder"}) ,
    "Im allgemeinen kann man Lieder nur hoeren."
  );

  AddDetail( ({"hexenhaus","hexenhauses","haus"}) ,
    "Du befindest Dich im Hexenhaus."
  );

  AddDetail( ({"teppich"}) ,
    "Der Teppich ist aus Kokosfasern gemacht. Dadurch wird er sehr stabil "
    "und nimmt auch den ganzen Schmutz auf, den so Leute wie Du von aussen "
    "hereinschleppen."
  );

  AddSpecialDetail( ({"leute"}) , "detail_leute");

  AddDetail( ({"kokosfasern","kokosfaser","faser","fasern"}) ,
    "Kokosfasern gewinnt man aus Kokospalmen."
  );

  AddDetail( ({"kokospalmen","palmen"}) ,
    "Siehst Du hier welche? Nein? Eben, waere ja auch etwas komisch, "
    "wenn mitten im Flur des Hexenhauses Kokospalmen wachsen wuerden. "
    "Und was nicht da ist, kann man nicht untersuchen."
  );

  AddDetail( ({"schmutz"}) ,
    "Schmutz, wie er sich an Deinen Fuessen befindet."
  );

  AddSpecialDetail( ({"bild"}) , "detail_bild" );

  AddDetail( ({"metallplaettchen","plaettchen"}) ,
    "Das Metallplaettchen ist aus Metall. Wer haette das gedacht? Da "
    "es aber weiss lackiert ist, kannst Du nicht mehr feststellen, woraus "
    "das Plaettchen gefertigt worden ist. In schwarzen Buchstaben steht "
    "\"BIBLIOTHEK\" darauf. "
  );

  AddDetail( ({"metall"}) ,
    "Vermutlich Eisen. Oder was anderes. Aber so wichtig ist es nun auch "
    "wieder nicht."
  );

  AddDetail( ({"eisen"}) ,
    "Da musst Du mal bei den Zwergen vorbeischauen und fragen, die kennen "
    "sich damit bestens aus. "
  );

  AddDetail( ({"zwerge","zwergen"}) ,
    "Die Zwerge wohnen in Felonia, welches sich weit im Nordosten im "
    "Gebirge befindet. "
  );

  AddDetail( ({"gebirge"}) ,
    "Das Gebirge befindet sich weit im Nordosten. Von hier aus kannst Du "
    "es nicht sehen."
  );

  AddDetail( ({"felonia","heimat"}) ,
    "Felonia ist die Heimat der Zwerge, es befindet sich weit entfernt "
    "im Gebirge. "
  );

  AddDetail( ({"buchstaben","buchstabe"}) ,
    "Sie sind schwarz, damit sie sich vom weissen lackierten Metall"
    "plaettchen gut abheben und gut lesbar sind."
  );

  AddDetail( ({"aufschrift"}) ,
    "Die Buchstaben der Aufschrift sind erhaben und ausserdem schwarz "
    "lackiert, so dass man sie gut ablesen kann."
  );

  AddDetail( ({"fachwerk"}) ,
    "Das Fachwerk besteht aus starken Balken mit einer angenehmen Toenung. "
    "Die Ausfachung wurde mit Lehm verputzt. "
  );

  AddDetail( ({"balken"}) ,
    "Es sind schwere, starke Balken, die die Waende bilden. Und stark "
    "muessen sie sein, denn sie tragen ja schliesslich noch das Dach. "
  );

  AddDetail( ({"ausfachung"}) ,
    "Woraus die Ausfachung besteht, kannst Du nicht erkennen, aber sie "
    "wurde mit einem sehr hellen, fast weissem Lehm verputzt, der sehr "
    "gut mit den dunkel getoenten Balken harmoniert. "
  );

  AddDetail( ({"lehm"}) ,
    "Die Ausfachung wurde sauber mit sehr hellem, fast weissem Lehm "
    "verputzt. So hellen Lehm hast Du noch nie gesehen. Vermutlich "
    "wurde sehr viel Kalkstein verwendet, um gewoehnlichen Lehm "
    "aufzuhellen. "
  );

  AddDetail( ({"kalkstein"}) ,
    "Kalkstein ist ein sehr weisser Stein. Fein gemahlen ergibt sich ein "
    "sehr helles Steinmehl, mit dem dieser Lehm aufgehellt wurde. "
  );

  AddDetail( ({"stein"}) ,
    "Hier sind keine. Allenfalls draussen im Garten, da sind Kieselsteine."
  );

  AddDetail( ({"kieselsteine"}) ,
    "Draussen im Garten auf dem Weg befinden sich welche. "
  );

  AddDetail( ({"weg"}) ,
    "Wenn Du Dich recht erinnerst, befanden sich draussen auf dem Weg "
    "Kieselsteine."
  );

  AddDetail( ({"garten"}) ,
    "Der befindet sich im Westen."
  );

  AddDetail( ({"mehl"}) ,
    "Mehl findet Du vermutlich in der Kueche. Oder bei einem Baecker. Oder "
    "in einer Muehle. Auf alle Faelle nicht hier. "
  );

  AddDetail( ({"kueche"}) ,
    "Die Kueche scheint sich im Norden zu befinden."
  );

  AddDetail( ({"baecker"}) ,
    "Hier findest Du bestimmt keinen Baecker. Wohl zu wenig Kundschaft."
  );

  AddDetail( ({"muehle"}) ,
    "Eine Muehle in einem Hexenhaus? Eine Pfeffermuehle vielleicht, aber "
    "bestimmt keine ausgewachsene Muehle. "
  );

  AddDetail( ({"pfeffermuehle"}) ,
    "Hier wirst Du wohl keine finden, aber eventuell in der Kueche?"
  );

  AddDetail( ({"kalksteinmehl","steinmehl"}) ,
    "Kalksteinmehl wird aus Kalksteinen gewonnen, indem man es ganz fein "
    "zu Steinmehl mahlt."
  );

  AddDetail( ({"toenung"}) ,
    "Die Toenung der Balken ist dunkelbraun. An einigen Stellen erkennst Du "
    "jedoch dunkle Verfaerbungen."
  );

  AddDetail( ({"verfaerbungen"}) ,
    "Es sind sehr dunkle, fast schwarze Stellen."
  );

  AddDetail( ({"stelle","stellen"}) ,
    "Die dunklen Stellen sehen aus wie Loecher."
  );

  AddDetail( ({"loecher"}) ,
    "Als Du Dir die Loecher etwas naeher ansiehst, erkennst Du, dass es sich "
    "lediglich um Astloecher handelt."
  );

  AddDetail( ({"astloecher","astloch"}) ,
    "An diesen Stellen sind die Aeste aus dem Stamm gewachsen, bevor "
    "dieser zu einem Balken verarbeitet wurde. "
  );

  AddDetail( ({"aeste","ast"}) ,
    "Jetzt sind natuerlich keine mehr da."
  );

  AddDetail( ({"stamm"}) ,
    "Es muss ein maechtiger Baum gewesen sein, aus dem dieser Stamm "
    "hergestellt wurde. "
  );

  AddDetail( ({"baum"}) ,
    "Tja, der Baum existiert nicht mehr. Nur noch diese Balken sind von ihm "
    "uebrig geblieben. "
  );

  AddDetail( ({"dach"}) ,
    "Das Dach kannst Du von hieraus nicht sehen, schliesslich ist ja noch "
    "die Decke dazwischen. "
  );

  AddSpecialDetail( ({"fuesse","fuessen","fuss"}) , "detail_fuesse");

  AddSound( ({DEFAULT_SOUND, "lied", "melodie"}) , #'sound );

  AddCmd( ({"betracht","betrachte"})              , "cmd_betrachten");
  AddCmd( ({"schau","schaue"})                    , "cmd_schauen");
  AddCmd( ({"haenge","haeng","drehe","dreh"
           ,"rueck","ruecke","schieb","schiebe"
           ,"korrigier","korrigiere"})            , "cmd_haengen");

  AddExit( "norden"      , ROOM "kueche"       );
  AddExit( "nordosten"   , ROOM "bad"          );
  AddExit( "osten"       , ROOM "wohnzimmer"   );
  AddExit( "suedosten"   , ROOM "schlafzimmer" );
  AddExit( "westen"      , ROOM "garten"       );


  NewDoor( ({"sueden"}), ROOM "bibliothek" , ({"tuer","eingang"}) ,
    ({D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME, "Tuer"
     ,D_GENDER, FEMALE
     ,D_SHORT, "Eine %se Tuer."
     ,D_LONG, "An der Tuer haengt ein kleines Schild mit der Aufschrift: "
              "BIBLIOTHEK"
     ,D_MSGS,    ({"in die Bibliothek","geht","kommt herein"})
     ,D_OPENMSG, ({"Du oeffnest die Tuer zur Bibliothek.",
                   "%s oeffnet die Tuer zur Bibliothek.",
                  " schwingt auf, als ob sie von aussen geoffnet wuerde."})
     ,D_CLOSEMSG, ({"Du schliesst die Tuer zur Bibliothek.",
                   "%s schliesst die Tuer zur Bibliothek.",
                  " wird von aussen geschlossen."})
     ,D_RESET_CLOSEMSG,
                  " schliesst sich wie von Geisterhand."

    })
  );

  AddItem(NPC "kleiderstaender.lpc", REFRESH_DESTRUCT);
  AddItem(OBJ "truhe.lpc", REFRESH_DESTRUCT);

  bildschief = 1;
}

void reset()
{
  ::reset();

  if(!bildschief)
  {
    tell_room(TO,BS("Von der einen Wand ertoent ein merkwuerdiges Kratzen, "
                    "so als wuerde etwas an der Wand entlang gleiten. "));
    bildschief = 1;
  }
}

int check_if_player(object ob)
{
  return (interactive(ob) && !(ob->QueryProp(P_INVIS)));
}

string _query_int_long()
{
  string s,sd;
  object room;

  s = "Du befindest Dich im Flur des Hexenhauses. Es sieht so gar nicht "
      "nach Hexenhaus aus. Auf dem Boden liegt ein Teppich, an einer Wand "
      "steht eine alte Truhe. Sonst kannst Du keine weitere Einrichtung "
      "sehen. Diverse Tueren fuehren in andere Raeume" ;

  call_other(ROOM "kueche.lpc", "???"); //raum laden

  room = find_object(ROOM "kueche.lpc");

  if(present("oma",room))
  {
    s += ", im Norden scheint jemand ein Lied zu singen"
    ;
  }
  s += ".";

  s = BS(s);

  if(QueryProp(P_DOOR_INFOS))
    sd = ((string)call_other(DOOR_MASTER,"look_doors"));

  if(sd && sd != "") s += sd;

  return s;
}

void summ(object player)
{
  player->command_me("summ");
}

string sound(string str)
{
  string s;
  object room;

  call_other(ROOM "kueche.lpc", "???"); //raum laden
  room = find_object(ROOM "kueche.lpc");

  if(!present("oma",room))
  {
    return "Es ist absolut still hier.\n";
  }

  switch(str)
  {
    case DEFAULT_SOUND:
      s = "Im Norden scheint jemand leise ein Lied zu singen.";
      break;

    case "lied":
      s = "Aus dem Norden erklingt leise ein Lied. Anscheinend singt dort "
          "jemand. Allerdings kennst Du das Lied nicht, aber die Melodie "
          "gefaellt Dir.";
      break;

    case "melodie":
      s = "Die Melodie geht so richtig ins Ohr, und Du faengst an mit"
          "zusummen.";
      call_out("summ",0,TP);
      break;
  }
  return BS(s);
}

string detail_bild(string str)
{
  string s;

  s = "An der Wand haengt ein Bild. ";

  if(bildschief) s += "Allerdings haengt es ein wenig schief. ";

  s += "Wenn Du wissen willst, was es darstellt, dann betrachte es "
       "doch einfach.";

  return BS(s);
}

string detail_leute(string str)
{
  string s;
  object *spieler;

  spieler=filter_array(all_inventory(TO), "check_if_player") - ({TP});

  switch(sizeof(spieler))
  {
    case 0:
      s = "Ausser Dir ist sonst niemand da.";
      break;

    case 1:
      s = "Ausser Dir siehst Du noch "+spieler[0]->Name()+".";
      break;

    default:
      s = "Du siehst "+LW(map_objects(spieler,"name"))+".";
  }

  return BS(s);
}

string detail_fuesse(string str)
{
  object *schuhe;
  string s;

  schuhe=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_BOOT);
  if(sizeof(schuhe) && objectp(schuhe[0]))
  {
    s = "An Deinen Fuessen traegst Du "+schuhe[0]->Name(WEN)+".";
  }
  else
  {
    s = "Du bist barfuss. Schau Dir bloss mal Deine Fuesse an, wie "
        "dreckig die sind."
    ;
  }

  return BS(s);
}

int cmd_schauen(string str)
{
  notify_fail("Worunter moechtest Du schauen?\n");

  if(!str || str == "") return 0;
  if(!(str == "unter teppich"         ||
       str == "unter den teppich"         )) return 0;

  TELLPLAYER("Du schaust unter den Teppich.\n");
  MOORMASTER->Msg(TPUID+" schaut unter den Teppich im Eingang");

  return 1;
}

int cmd_betrachten(string str)
{
  string s;

  notify_fail("Was moechtest Du betrachten?\n");

  if(!str || str == "") return 0;
  if(!(str == "bild"         ||
       str == "bild an wand"         )) return 0;

  s  = "                                       \n";
  s += "                                       \n";
  s += "                                       \n";
  s += "      ,-~-,       ,-~~~~-,    /\\  /\\   \n";
  s += "(\\   / ,-, \\    ,'        ', /  ~~  \\  \n";
  s += " \\'-' /   \\ \\  /     _      #  <0 0> \\ \n";
  s += "  '--'     \\ \\/    .' '.    # =  Y  =/ \n";
  s += "            \\     / \\   \\   `#-..!.-'  \n";
  s += "             \\   \\   \\   `\\ \\\\         \n";
  s += "              )  />  /     \\ \\\\        \n";
  s += "             / /`/ /`__     \\ \\\\__     \n";
  s += "            (____)))_)))     \\__)))    \n\n\n";

  s += BS("Ob das wohl die Katze von Oma Wetterwachs ist?");

  TELLPLAYER(s);
  TELLOTHERS(CTPN+" starrt Loecher in die Luft.\n");
  return 1;
}

int cmd_haengen(string str)
{
  notify_fail("Was willst Du gerade hinhaengen?\n");

  if(!str || str == "") return 0;

  if(!(str == "bild gerade"        ||
       str == "bild gerade auf"    ||
       str == "bild gerade hin"    ||
       str == "bild aufrecht"      ||
       str == "bild aufrecht hin"  ||
       str == "bild zurecht"       ||
       str == "bild waagrecht"     ||
       str == "bild aufrecht hin"  ||
       str == "bild richtig"       ||
       str == "bild richtig hin"   ||
       str == "bild richtig auf"   )) return 0;

  if(bildschief)
  {
    TELLPLAYER("Du haengst das Bild wieder gerade hin.\n");
    MOORMASTER->Msg(TPUID+" haengt das Bild im Eingang wieder gerade hin");
    bildschief = 0;
  }
  else
  {
    TELLPLAYER("Das Bild haengt doch gar nicht schief.\n");
  }
  return 1;
}
