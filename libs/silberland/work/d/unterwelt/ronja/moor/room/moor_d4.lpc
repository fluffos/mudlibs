#include "../def.h"

inherit ROOM "moor_inh.lpc" ;

void create()
{
  ::create();

  AddExit(        "norden"      , ROOM "moor_d3" );
  AddSpecialExit( "nordosten"   , "keinausgang"  );
  AddSpecialExit( "osten"       , "keinausgang"  );
  AddSpecialExit( "suedosten"   , "keinausgang"  );
  AddSpecialExit( "sueden"      , "keinausgang"  );
  AddSpecialExit( "suedwesten"  , "keinausgang"  );
  AddExit(        "westen"      , ROOM "moor_c4" );
  AddExit(        "nordwesten"  , ROOM "moor_c3" );

}

