#include "../def.h"

inherit "/std/room";

#define ANZ_STUEHLE 2
#define LW(x) (sizeof(x)==1 ? x[0] : implode(x[0..<2],", ")+" und "+x[<1])

int wasser_in_spuele;
int semmel;

string *spieler_stuhl;
string *spieler_buch;
string *spieler_spuel;
string *spieler_gabel;

int exit_test();

string sound(string str);
string omasound(string str);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Kueche" );
  SetProp( P_INT_LONG,
    "Hier bereitet Oma Wetterwachs ihre leckeren Sachen zu. Jaja, unter "
    "Kennern sind ihre Kochkuenste weit bekannt. Du siehst einen Herd, "
    "einen Kuechenschrank, einen Tisch und Stuehle. Neben dem Herd ist eine "
    "Spuele. An einer der Waende haengt ein Regal."
  );

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"kueche"}) ,
    QueryProp(P_INT_LONG)
  );

  AddDetail( ({"kochkunst","kochkuenste"}) ,
    "Oma Wetterwachsens Kochkuenste sind weithin bekannt. Allerdings bist Du "
    "ja nicht deswegen hierher gekommen, oder etwa doch?"
  );

  AddDetail( ({"boden"}) ,
    "Der Boden ist tip-top sauber, kein Kruemel und kein Schmutz ist zu sehen."
  );

  AddDetail( ({"schmutz"}) ,
    "So sehr Du auch suchst, Du kannst keinen Schmutz entdecken. Naja, das "
    "Geschirr in der Spuele ist schmutzig und muss gespuelt werden, aber "
    "das macht Oma Wetterwachs bestimmt, wenn sie mit kochen fertig ist."
  );

  AddSpecialDetail( ({"spuele"}) , "detail_spuele");

  AddDetail( ({"wasserhahn","hahn"}) ,
    "Ein ganz normaler Wasserhahn. Wenn Du ihn aufdrehst, wird vermutlich "
    "Wasser herauskommen."
  );

  AddSpecialDetail( ({"wasser","spuelwasser"}) , "detail_wasser");

  AddDetail( ({"geschirr"}) ,
    "In der Spuele liegen ein paar Teller, ein Messer und eine Gabel."
  );

  AddDetail( ({"teller"}) ,
    "Davon hat Oma Wetterwachs vermutlich vorhin gegessen."
  );

  AddDetail( ({"messer"}) ,
    "Ein Messer zum Essen. Absolut nicht als Waffe geeignet."
  );

  AddDetail( ({"waffe"}) ,
    "Oma Wetterwachs braucht sowas nicht."
  );

  AddDetail( ({"gabel"}) ,
    "Eine normale Gabel, wie man sie zum zivilisierten Essen braucht. Du "
    "glaubst, Dich erinnern zu koennen, das schon mal gehoert zu haben. "
    "Aber Abenteurer haben keine Zeit fuer solche Sachen."
  );

  AddDetail( ({"kruemel"}) ,
    "Nichts. Keine Kruemel. Obwohl Du Dich total freuen wuerdest, wenn Du "
    "wenigstens mal einen klitzekleinen Kruemel von Omas sagenumwobenen "
    "Torten abbekommen koenntest. "
  );

  AddDetail( ({"torte","torten"}) ,
    "Du bist aber auch ein Schleckermaul. Vielleicht backt Oma Wetterwachs "
    "Dir ja eine zum Geburtstag, wenn Du sie danach fragst. "
  );

  AddDetail( ({"schleckermaul"}) ,
    "Ja, genau Dich meine ich. Statt Abenteuer zu bestehen, stehst Du hier "
    "in der Kueche von Oma Wetterwachs und suchst Torten!"
  );

  AddDetail( ({"pfunde","pfund","huefte"}) ,
    "Du hast ein paar Pfund zuviel auf der Huefte, streng Dich mal ein wenig "
    "an, dass Du sie wieder loskriegst. "
  );

  AddDetail( ({"abenteuer"}) ,
    "Es gibt genug Abenteuer fuer Dich zu bestehen, da brauchst Du hier nicht "
    "in der Kueche herumzustehen und nach Leckerchen Ausschau halten. Schau "
    "Dich doch mal an, ein paar Pfund weniger wuerden Dir bestimmt gut stehen."
  );

  AddSpecialDetail( ({"leckerchen","schleckereien"}) , "detail_leckerchen" );

  AddDetail( ({"ausschau","fenster"}) ,
    "Du schaust aus dem Fenster und blickst in den Garten. Hinter dem Garten "
    "kannst Du das Moor nur erahnen."
  );

  AddDetail( ({"Garten"}) ,
    "Der Garten befindet sich draussen. Da musst Du Dich schon hinbemuehen, "
    "wenn Du genaueres ueber ihn wissen willst."
  );

  AddSpecialDetail( ({"tisch"}) , "detail_tisch" );

  AddDetail( ({"kaffeestunde"}) ,
    "Nein, im Moment ist keine Kaffeestunde."
  );

  AddDetail( ({"moment"}) ,
    "Zack - vorbei."
  );

  AddDetail( ({"zack"}) ,
    "Auf jeden Fall nicht Zick."
  );

  AddDetail( ({"zick"}) ,
    "Etwas anderes als Zack."
  );

  AddDetail( ({"fall"}) ,
    "Pass auf dass Du nicht hinfaellst!"
  );

  AddDetail( ({"nanny","nanny ogg","ogg"}) ,
    "Eine Kollegin von Oma Wetterwachs, die ab und an mal zu Besuch kommt."
  );

  AddDetail( ({"besuch"}) ,
    "Im Moment bist Du zu Besuch bei Oma Wetterwachs."
  );

  AddSpecialDetail( ({"stuhl","stuehle"}) , "detail_stuhl");

  AddDetail( ({"moor"}) ,
    "Das Moor kannst Du nur erahnen."
  );

  AddSpecialDetail( ({"geburtstag"}) , "detail_geburtstag");

  AddDetail( ({"decke"}) ,
    "Die Decke traegt insbesonders ueber dem Herd unuebersehbar Spuren von "
    "dem vielen Kochen. Nicht dass die Decke schmutzig oder unappetitlich "
    "waere, aber Dampfschwaden und Fettspritzer hinterlassen mit der Zeit "
    "doch ihre Spuren. Naja, Oma Wetterwachs ist halt nicht mehr die juengste "
    "und es ist schon beschwerlich fuer sie, die Decke immer wieder neu zu "
    "streichen."
  );

  AddDetail( ({"dampfschwaden","schwaden","fett","spritzer","fettspritzer","spuren"}) ,
    "Mit der Zeit haben sich an der Decke die Spuren vom vielen Kochen doch "
    "angesammelt. Oma Wetterwachs ist halt nicht mehr die juengste und es ist "
    "nicht so einfach fuer sie, die Decke zu streichen. "
  );

  AddDetail( ({"wand","waende"}) ,
    "An der Nordwand steht der Herd, an dem Oma Wetterwachs ihre leckeren "
    "Speisen kocht. Ueber dem Herd ist ein Regal angebracht. Die Westwand "
    "hat ein Fenster, unter dem ein Tisch steht. An der Ostwand steht ein "
    "grosser Kuechenschrank, und nach Sueden kannst Du die Kueche verlassen."
  );

  AddDetail( ({"speisen","speise"}) ,
    "Offen herumliegen tut nichts, aber vielleicht verwahrt Oma Wetterwachs "
    "ja alles im Kuechenschrank auf? "
  );

  AddDetail( ({"westwand"}) ,
    "In der Westwand befindet sich ein Fenster, davor stehen ein Tisch und "
    "ein paar Stuehle."
  );

  AddDetail( ({"nordwand"}) ,
    "An der Nordwand steht ein Herd, an dem Oma Wetterwachs ihre koestlichen "
    "Speisen zubereitet. Ueber dem Herd haengt ein Regal. "
  );

  AddDetail( ({"suedwand"}) ,
    "Nach Sueden kannst Du die Kueche wieder verlassen."
  );

  AddDetail( ({"ostwand"}) ,
    "An der Ostwand steht ein riesiger Kuechenschrank."
  );

  AddDetail( ({"abenteurer"}) ,
    "Wahre Abenteurer schleichen nicht in anderer Leute Kuechen herum und "
    "suchen nach Schleckereien."
  );

  AddSpecialDetail( ({"leute"}) , "detail_leute" );

  AddDetail( ({"oma","wetterwachs"}) ,
    "Oma Wetterwachs scheint grade nicht da zu sein."
  );

  AddDetail( ({"regal"}) ,
    "Auf dem Regal liegt nur ein einzelnes Buch."
  );

  AddDetail( ({"buch","kochbuch"}) ,
    "Es ist ein dickes Buch mit einem ledernen Einband. Fremde "
    "Schriftzeichen zieren den Buchruecken und den Buchdeckel."
  );

  AddDetail( ({"einband"}) ,
    "Der Einband besteht aus feinstem Leder. Das Leder allerdings ist von "
    "einer ganz besonderen Art, denn die typische Lederstruktur ist nur "
    "haarfein ausgepraegt."
  );

  AddDetail( ({"leder","lederstruktur"}) ,
    "Das Leder ist ausgezeichnet gegerbt worden, denn Du kannst keine "
    "Unregelmaessigkeiten erkennen. "
  );

  AddDetail( ({"unregelmaessigkeit","unregelmaessigkeiten"}) ,
    "Die Lederstruktur zeigt keinerlei Unregelmaessigkeiten? Oder doch? Als "
    "Du nochmals ganz genau hinschaust, kannst Du einen kleinen Fleck "
    "erkennen. "
  );

  AddDetail( ({"fleck"}) ,
    "Nur bei genauem Hinsehen kannst Du einen klitzekleinen Fleck erkennen. "
    "Hier muss Oma Wetterwachs wohl ein kleiner Fettspritzer auf das Buch "
    "gekommen sein. Wieso sie den nicht weggewischt hat? "
  );

  AddDetail( ({"buchruecken","buchdeckel"}) ,
    "Auf dem Buchruecken und Buchdeckel siehst Du fremde Schriftzeichen. "
    "Solche hast Du noch nie gesehen. "
  );

  AddDetail( ({"schriftzeichen"}) ,
    "Die Schriftzeichen sind Dir voellig fremd, Du hast keine Ahnung, was "
    "sie bedeuten koennten."
  );

  AddDetail( ({"ahnung"}) ,
    "KEINE Ahnung!"
  );

  AddReadDetail( ({"buch","kochbuch"}) ,
    "Du blaetterst ein wenig in dem Buch herum und siehst nur leere Seiten! "
    "Entgeistert schaust Du nochmal nach und siehst auf der ersten Seite "
    "merkwuerdige Schriftzeichen. Langsam daemmert es Dir, dass Oma "
    "Wetterwachs dieses Buch verhext hat, so dass nur sie es lesen kann."
  );

  AddDetail( ({"sachen"}) ,
    "Hier in der Kueche gibt es viele Sachen, schau Dich ruhig um."
  );

  AddDetail( ({"zeit","details"}) ,
    "Dass Du die Zeit hast, Dich um solche Details zu kuemmern..."
  );

  AddDetail( ({"herd"}) ,
    "Das ist noch ein Herd der alten Art. Neben der Ofenklappe ist ein "
    "Backraum. Oben ist eine schwere, gusseiserne Platte, wo man mehrere "
    "Ringe entfernen kann, um darauf Toepfe abzustellen. Rings um die Platte "
    "verlaeuft eine Stange, an der man Handtuecher aufhaengen koennte."
  );

  AddDetail( ({"topf","toepfe","kochtoepfe","kochtopf"}) ,
    "Auf dem Herd steht ein Topf. Was da wohl drin ist?"
  );

  AddDetail( ({"ofenklappe","ofen","klappe"}) ,
    "Hinter der Ofenklappe brennt wohl das Feuer, um die Hitze zum Kochen "
    "zu liefern. "
  );

  AddDetail( ({"feuer"}) ,
    "Sehen kannst Du es nicht, aber der Herd strahlt eine gewisse Hitze ab, "
    "so dass Du vermutest, dass im Herd ein Feuer brennt. "
  );

  AddDetail( ({"hitze"}) ,
    "Der Herd strahlt eine gewisse Hitze ab. Wohl weil ein Feuer darin brennt."
  );

  AddDetail( ({"stange"}) ,
    "Um die Herdplatte laeuft eine Stange, damit die Kochtoepfe nicht aus "
    "Versehen herunterfallen oder heruntergezogen werden koennen. "
    "Andererseits kann man ueber die Stange auch Handtuecher haengen, damit "
    "man sie schnell zur Hand hat, wenn man sich die Haende abtrocknen moechte."
  );

  AddDetail( ({"hand","haende"}) ,
    ([ "troll": "Du siehst zwei Haende, Du kannst damit glatt bis zwei zaehlen.",
       "zwerg": "Du siehst zwei Haende, Du kannst damit bis zehn zaehlen.",
             0: "Du siehst zwei Haende, gut, dass Du sie nicht zum Zaehlen brauchst."
     ])
  );

  AddDetail( ({"handtuch","handtuecher"}) ,
    "Momentan haengen keine Handtuecher ueber der Stange."
  );

  AddDetail( ({"ring","ringe"}) ,
    "Die Ofenplatte hat mehrere Ringe, die man herausnehmen kann. Dadurch "
    "kann man die Hitze besser regulieren."
  );

  AddDetail( ({"platte","ofenplatte","herdplatte"}) ,
    "Auf der schweren, gusseisernen Platte wird gekocht. Dazu gibt es "
    "mehrere Ringe, die man entfernen kann und dadurch die Hitze zum "
    "Kochen reguliert."
  );

  AddDetail( ({"suppe","schleimsuppe","kroetenschleimsuppe","frage"}) ,
    "Probieren oder nicht probieren, das ist hier die Frage."
  );

  AddSpecialDetail( ({"backraum"}) ,  "detail_backraum" );

  AddSound( ({DEFAULT_SOUND}) , #'sound );

  AddSound( ({"herd"}) ,
    "Auf dem Herd steht ein Topf, in dem eine Suppe blubbert."
  );

  AddSound( ({"topf"}) ,
    "In dem Topf blubbert eine Suppe leise vor sich hin."
  );

  AddSound( ({"suppe"}) ,
    "*BLUBB* *BLUBB*"
  );

  AddSound( ({"oma","melodie","lied","liedchen","text","sprache"
             ,"silben","wort","woerter","woertern"}) , #'omasound);

  AddSmell( ({DEFAULT_SMELL}) ,
    "Es riecht nach Essen."
  );

  AddSmell( ({"essen"}) ,
    "Das koennte die Suppe auf dem Herd sein."
  );

  AddSmell( ({"suppe"}) ,
    "Riecht lecker!"
  );

  AddCmd( ({"dreh","drehe"})        , "cmd_drehen");
  AddCmd( CMD_TRINKEN               , "cmd_trinken");
  AddCmd( CMD_NEHMEN                , "cmd_nehmen");
  AddCmd( CMD_SETZEN                , "cmd_setzen");
  AddCmd( ({"steh","stehe"})        , "cmd_stehen");
  AddCmd( ({"streich","streiche"})  , "cmd_streichen");
  AddCmd( ({"werf","werfe","wirf"}) , "cmd_werfen");
  AddCmd( ({"schau","schaue"})      , "cmd_schauen");
  AddCmd( ({"wisch","wische"})      , "cmd_wischen");
  AddCmd( CMD_OEFFNEN               , "cmd_oeffnen");
  AddCmd( ({"probier","probiere","nasch","nasche"}) , "cmd_probieren");
  AddCmd( ({"entfern","entferne"})  , "cmd_entfernen");

  AddCmd("spuel|spuele|wasch|wasche|putz|putze|reinig|reinige"
    "&geschirr|teller|messer|gabel|geschirr",
    "cmd_spuelen",
    "Was moechtest Du spuelen?\n"
  );

  AddExit("sueden", ([EX_DEST : ROOM "eingang", EX_TESTFUNC : #'exit_test ]) );

  AddItem(NPC "oma.lpc", REFRESH_DESTRUCT);
  AddItem(OBJ "kuechenschrank.lpc", REFRESH_REMOVE);

  wasser_in_spuele = 0;
  semmel           = 1;

  spieler_stuhl    = ({ });
  spieler_buch     = ({ });
  spieler_spuel    = ({ });
  spieler_gabel    = ({ });
}

void reset()
{
  string s;

  ::reset();

  s = "Oma Wetterwachs geht zur Spuele, raeumt das saubere Geschirr weg, "
      "laesst das restliche Wasser aus der Spuele ablaufen und legt wieder "
      "etwas dreckiges Geschirr in die Spuele";


  if(!present("\nWETTERWACHS",TO))
  {
    s = "Der Geist von " + s + " und verschwindet wieder";
  }

  s += ".";

  tell_room(TO,BS(s));

  wasser_in_spuele = 0;
  semmel           = 1;

  spieler_buch     = ({ });
  spieler_spuel    = ({ });
  spieler_gabel    = ({ });

  return;
}

int check_if_player(object ob)
{
  return (interactive(ob) && !(ob->QueryProp(P_INVIS)));
}

string *QuerySpueler()
{
  return spieler_spuel;
}

int isSitting(object pl,int silent)
{
  if(member(spieler_stuhl,getuuid(pl)) > -1)
  {
    if(!silent) tell_object(pl,"Aber Du sitzt doch auf einem Stuhl!\n");
    return 1;
  }
  return 0;
}

int exit_test()
{
  if(TP && interactive(TP) && isSitting(TP,0)) return 0;
  return 1;
}

string detail_geburtstag(string str)
{
  string s;

  if(TP->QueryProp(P_CREATION_DATE) > 0)
  {
    s = "Dein Geburtstag ist am " + dtime(TP->QueryProp(P_CREATION_DATE))[5..11] + ".";
  }
  else
  {
    s = "Du weisst nicht, wann Dein Geburtstag ist? Kein Wunder, wenn Du "
        "nie Geschenke bekommst.";
  }
  return BS(s);
}

string detail_leckerchen(string str)
{
  string s;

  if(TP->QueryProp(P_GENDER) != FEMALE)
  {
    s = "Bist Du ein Weichei oder ein knallharter Abenteurer?";
  }
  else
  {
    s = "Bist Du eine verweichlichte Kaffeetante oder eine Abenteurerin?";
  }
  return BS(s);
}

string detail_spuele(string str)
{
  string s;

  if(member(spieler_spuel,getuuid(TP)) > -1)
  {
   s = "In der Spuele liegt etwas Geschirr, dass Du vor kurzem gespuelt hast.";
  }
  else
  {
    s = "In der Spuele liegt etwas dreckiges Geschirr.";
  }

  if(wasser_in_spuele)
  {
    s += " Ausserdem befindet sich noch etwas Wasser in der Spuele.";
  }
  s += " Direkt vor Dir befindet sich ein Wasserhahn.";
  return BS(s);
}

int cmd_drehen(string str)
{
  notify_fail("Was willst Du aufdrehen?\n");

  if(!str || str == "") return 0;
  if(!(str == "wasserhahn"    ||
       str == "hahn"          ||
       str == "wasserhahn auf"||
       str == "hahn auf"      )) return 0;

  if(isSitting(TP,0)) return -1;

  if(wasser_in_spuele)
  {
    TELLPLAYER(BS("Es befindet sich schon Wasser in der Spuele. Da Du die "
                  "Kueche nicht unter Wasser setzen willst, drehst Du auch "
                  "den Wasserhahn nicht auf. "
    ));
    return -1;
  }

  TELLPLAYER(BS("Du drehst den Wasserhahn auf, und tatsaechlich kommt "
                "Wasser heraus. Du laesst etwas Wasser in die Spuele "
                "laufen und drehst den Hahn dann wieder zu. Du willst "
                "ja schliesslich nicht die ganze Kueche unter Wasser setzen."
  ));
  TELLOTHERS(BS(CTPN+" dreht den Wasserhahn ueber der Spuele auf und laesst "
                "etwas Wasser in die Spuele laufen."
  ));
  wasser_in_spuele = 1;

  return 1;
}

string detail_wasser(string str)
{
  if(wasser_in_spuele)
  {
    return BS("In der Spuele befindet sich etwas Wasser, mit dem Du das "
              "Geschirr spuelen koenntest.");
  }
  return "Du siehst in der Kueche kein Wasser.\n";
}

string detail_backraum(string str)
{
  string s;
  object ob;

  if(semmel)
  {
    ob=clone_object("/d/gebirge/dusty/zwerge/obj/baeckerei/semmel");

    if(ob->move(TP,M_GET|M_SILENT) != 1)
    {
      s = "Im Backraum befindet sich eine Semmel, die Du jedoch "
          "nicht mehr tragen kannst. Daher laesst Du sie wo sie ist. ";
      ob->remove();
    }
    else
    {
      s = "Du oeffnest den Backraum des Herdes und findest eine frische "
          "Semmel, die Du sogleich an Dich nimmst.";
      semmel = 0;
    }
  }
  else
  {
    s = "Du offnest den Backraum des Herdes und findest nur noch ein paar "
        "Kruemel.";
  }

  return BS(s);
}

string detail_stuhl(string key)
{
  string s;
  string *spname;
  object pl;
  int i;

  s = "Ohne Stuehle waere es ein wenig ungemuetlich am Tisch";

  spname = ({ });
  i = sizeof(spieler_stuhl);
  while(i--)
  {
    pl = find_player(explode(spieler_stuhl[i],"_")[0]);
    if(pl && interactive(pl))
    {
      spname += ({ pl->Name() });
    }
    else
    {
      spieler_stuhl -= ({ spieler_stuhl[i] });
    }
  }

  switch(sizeof(spname))
  {
    case 1  :
      s += ". Auf einem der Stuehle sitzt "+spname[0];
      break;

    case 2  :
      s += ". Am Tisch sitzen " + LW(spname);
      break;

  }

  return BS(s+".");
}

string detail_tisch(string key)
{
  string s;
  string *spname;
  object pl;
  int i;

  s = "An diesem Tisch wird Oma Wetterwachs wohl essen oder ihr Essen "
      "zubereiten. Manchmal wird sie wohl auch ihre Kaffeestunde mit Nanny "
      "Ogg hier abhalten" ;

  spname = ({ });
  i = sizeof(spieler_stuhl);
  while(i--)
  {
    pl = find_player(explode(spieler_stuhl[i],"_")[0]);
    if(pl && interactive(pl))
    {
      spname += ({ pl->Name() });
    }
    else
    {
      spieler_stuhl -= ({ spieler_stuhl[i] });
    }
  }

  switch(sizeof(spname))
  {
    case 1  :
      s += ". Am Tisch sitzt "+spname[0];
      break;

    case 2  :
      s += ". Am Tisch sitzen " + LW(spname);
      break;

  }

  return BS(s+".");
}

string detail_leute(string key)
{
  string s;
  object *spieler;

  spieler=filter_array(all_inventory(TO), "check_if_player");

  switch(sizeof(spieler))
  {
    case 0  :
      s = "Es ist keiner da, noch nichtmal Du.";
      break;

    case 1  :
      s = "Ausser "+(present("oma",TO)?"Oma Wetterwachs und ":"")+
          "Dir ist niemand da.";
      break;

    default :
      s = "Momentan sind "+(present("oma",TO)?"Oma Wetterwachs, ":"");
      spieler -= ({TP});
      s += implode(map_objects(spieler,"name"),", ") +
           " und Deine Wenigkeit im Raum.";
  }

  return BS(s);
}

int cmd_trinken(string str)
{
  notify_fail("Was moechtest Du trinken?\n");

  if(!str || str == "") return 0;
  if(!(str == "wasser"             ||
       str == "wasser aus spuele"  )) return 0;

  if(isSitting(TP,0)) return -1;

  if(wasser_in_spuele)
  {
    TELLPLAYER(BS("Wasser aus der Spuele trinken? Auf gut deutsch: "
                  "Spuelwasser trinken? Du hast ja einen merkwuerdigen "
                  "Geschmack. Naja, Du wirst schon sehen, was Du davon hast."
    ));
    TELLOTHERS(TPN+" trinkt wahrhaftig das Spuelwasser. IGITT!\n");
    wasser_in_spuele = 0;
    TP->AddPoison(1);
    return 1;
  }

  return 0;
}

int cmd_nehmen(string str)
{
  object gabel,oma;
  string sp,so;

  notify_fail("Was willst Du nehmen?\n");

  if(!str || str == "") return 0;

  if(isSitting(TP,0)) return 1;

  if(member(({"buch","kochbuch","dickes buch","dickes kochbuch"}),str) > -1)
  {
    if((oma=present("oma",TO)) && member(spieler_buch,getuuid(TP)) > -1)
    {
      TELLPLAYER("Oma Wetterwachs sagt: Jetzt reicht es aber!\n");
      TELLOTHERS(BS("Oma Wetterwachs wird reichlich boese, als "+TPN+" zum "
                    "wiederholten Mal versucht, das Kochbuch zu nehmen."));
      oma->Kill(TP);
      return 1;
    }
    else
    {
      sp = "Du nimmst das Buch an Dich, aber auf einmal reisst sich das "
           "Buch los und fliegt um Dich herum, wobei es Dir immer wieder "
           "auf den Kopf schlaegt. Nach einer Weile fliegt es wieder auf "
           "das Regal und legt sich dorthin. ";
      so = TPN+" nimmt ein Buch vom Regal. Ploetzlich fliegt das Buch auf "
           "und attackiert "+TP->QueryPronoun(WEN)+". Kurz danach fliegt das "
           "Buch wieder auf das Regal zurueck. ";

      if(present("oma",TO))
      {
        sp += "Du hoerst Oma Wetterwachs noch sagen: Lass gefaelligst mein "
              "Kochbuch liegen, sonst werde ich ernstlich boese.";
        so += "Du hoerst Oma Wetterwachs schimpfen.";
        spieler_buch += ({getuuid(TP)});
      }

      TELLPLAYER(BS(sp));
      TELLOTHERS(BS(so));
      SetProp(P_KILL_NAME,"Ein Kochbuch");
      TP->do_damage(20);
    }
    MOORMASTER->Msg(TPUID+" versucht das Kochbuch zu nehmen");
    return 1;
  }

  if(str == "teller" || str == "teller aus spuele")
  {
    TELLPLAYER(BS("Das sind wertvolle Teller aus Porzellan. Die gehen "
                  "bestimmt kaputt auf Deinen Abenteuerreisen. Daher "
                  "laesst Du sie liegen."
    ));
    return -1;
  }

  if(str == "messer" || str == "messer aus spuele")
  {
    TELLPLAYER(BS("Du nimmst das Messer aus der Spuele und betrachtest es "
                  "genau. Es ist ein ganz normales Messer, wie man es zum "
                  "Essen benoetigt. Als Waffe ist es voellig unbrauchbar, "
                  "daher legst Du es wieder zurueck."
    ));
    return -1;
  }

  if(str == "topf" || str == "kochtopf")
  {
    TELLPLAYER(BS("Du schaust in den Kochtopf: Kroetenschleimsuppe. Du "
                  "denkst Dir, dass das ja nun nicht unbedingt sein muss "
                  "und laesst den Kochtopf stehen."
    ));
    return -1;
  }

  if(str == "gabel" || str == "gabel aus spuele")
  {
    if(member(spieler_gabel,getuuid(TP)) > -1)
    {
      TELLPLAYER(BS("Du hast Dir vorhin erst eine Gabel genommen. Wenn Du "
                    "so weiter machst, wird Oma Wetterwachs bald keine "
                    "Gabeln mehr haben. Also maessige Dich etwas."));
      return -1;
    }

    if(member(spieler_spuel,getuuid(TP)) > -1)
    {

      gabel=clone_object(OBJ "gabel");
      if(ME_TOO_HEAVY==gabel->move(TP,M_GET|M_SILENT))
      {
        TELLPLAYER(BS("Du Schwaechling kannst noch nicht einmal mehr eine "
                      "kleine Gabel tragen."));
        gabel->remove();
      }
      else
      {
        TELLPLAYER("Du nimmst eine saubere Gabel aus der Spuele.\n");
        TELLOTHERS(TP->Name()+" nimmt etwas aus der Spuele.\n");
        spieler_gabel += ({ getuuid(TP) });
        MOORMASTER->Msg(CTPN+" nimmt eine Gabel aus der Spuele");
      }
      return 1;
    }
    else
    {
      TELLPLAYER(BS("Also fuer eine schmutzige Gabel hast Du nun wirklich "
                    "keine Verwendung."
      ));
      return -1;
    }
  }
  return 0;
}

int cmd_spuelen(string str)
{
  if(isSitting(TP,0)) return -1;

  if(member(spieler_spuel,getuuid(TP)) > -1)
  {
    TELLPLAYER(BS("Du hast doch vor kurzem erst gespuelt, das reicht. Am "
                  "Ende sieht Dich noch jemand!"));
    return -1;
  }

  if(!wasser_in_spuele)
  {
    TELLPLAYER("Es befindet sich kein Wasser in der Spuele!\n");
    return -1;
  }

  TELLPLAYER(BS("Du spuelst das Geschirr ab. Fuer einen Abenteurer sogar "
                "recht gut. Ordentlich wie Du bist, laesst Du auch das "
                "dreckige Wasser ablaufen. "
  ));
  TELLOTHERS(TPN+" macht sich am Geschirr in der Spuele zu schaffen.\n");
  wasser_in_spuele = 0;
  spieler_spuel += ({ getuuid(TP) });
  MOORMASTER->Msg(TPUID+" spuelt Geschirr");
  return 1;
}

int cmd_setzen(string str)
{
  string s;

  notify_fail("Worauf willst Du Dich setzen?\n");

  if(!str || str == "") return 0;

  if(str == "stuhl" || str == "auf stuhl" || str == "an tisch")
  {

    if(isSitting(TP,1))
    {
      TELLPLAYER("Aber Du sitzt doch schon!\n");
      return -1;
    }

    if(TP->QueryProp(P_INVIS))
    {
      TELLPLAYER(BS("Du bist unsichtbar. Stell Dir vor die anderen sehen nicht "
                    "dass Du auf einem der Stuehle sitzt und setzen sich auf "
                    "Dich drauf...."));
      return -1;
    }

    if(sizeof(spieler_stuhl) == ANZ_STUEHLE)
    {
      TELLPLAYER(BS("Du wuerdest Dich ja gerne auf einen der Stuehle setzen, "
                    "doch leider sind alle Stuehle besetzt. Du koenntest "
                    "hoechstens jemand von seinem Stuhl werfen."
      ));
      TELLOTHERS(BS(TPN+" schaut luestern auf einen der Stuehle und will "
                    "sich setzen, doch es sind alle Stuehle besetzt."
      ));
      return -1;
    }

    TELLPLAYER("Du setzt Dich auf einen der Stuehle.\n");
    TELLOTHERS(TPN+" setzt sich auf einen der Stuehle.\n");
    spieler_stuhl += ({getuuid(TP)});
    return 1;
  }

  if(str == "kueche unter wasser")
  {
    if(present("oma",TO))
    {
      TELLPLAYER(BSI("He! Was soll denn das? Wenn Du hier randalieren willst, "
                     "dann fliegst Du raus!","Oma Wetterwachs schimpft: "));
      TELLOTHERS(BS("Oma Wetterwachs schimpft heftig mit "+TPN+" und gibt "+
                    (TP->QueryProp(P_GENDER) == MALE?"ihm":"ihr")+
                    " einen kraeftigen Tritt in den Hintern.")
      );

      SetProp(P_KILL_NAME,"Oma Wetterwachsens Tritt in den Hintern");
      TP->do_damage(25);

      if(TP->QueryProp(P_GHOST)) return -1;

      TP->move(ROOM "eingang",M_GO,"",
        "fliegt in hohem Bogen aus der Kueche",
        "kommt in hohem Bogen aus der Kueche hereingeflogen"
      );
    }
    else
    {
      TELLPLAYER(BS("Nene, am Ende musst Du wieder alles aufwischen. Das "
                    "muss ja nun auch nicht sein. "));
    }

    return -1;
  }

  return 0;
}

int cmd_werfen(string str)
{
  string wen;
  object spieler;
  int n;

  notify_fail("Wen willst Du vom Stuhl werfen?\n");

  if(!str || str == "") return 0;

           n = sscanf(str,"%s von stuhl",wen);
  if(n!=1) n = sscanf(str,"%s vom stuhl",wen);
  if(n!=1) n = sscanf(str,"%s von stuhl herunter",wen);
  if(n!=1) n = sscanf(str,"%s vom stuhl herunter",wen);
  if(n!=1) n = sscanf(str,"%s von dem stuhl",wen);
  if(n!=1) n = sscanf(str,"%s von dem stuhl herunter",wen);

  if(n!=1) return 0;

  if(isSitting(TP,0)) return -1;

  if(!spieler=find_player(wen))
  {
    TELLPLAYER(capitalize(wen)+" ist doch gar nicht da!\n");
    return -1;
  }

  wen = capitalize(wen);

  if(spieler->QueryProp(P_INVIS))
  {
    TELLPLAYER(wen+" ist doch gar nicht da!\n");
    return -1;
  }

  if(spieler == TP)
  {
    TELLPLAYER(BS("Warum willst Du Dich selbst vom Stuhl werfen? Sei froh, "
                  "dass Du einen Sitzplatz hast."
    ));
    return -1;
  }

  if(!present(spieler,TO))
  {
    TELLPLAYER(CAP(spieler->name())+" ist zwar da, aber nicht hier.\n");
    return 1;
  }

  if(member(spieler_stuhl,getuuid(spieler)) == -1)
  {
    TELLPLAYER(wen+" sitzt doch gar nicht am Tisch.\n");
    return -1;
  }

  if(TP->QueryAttribute(A_STR)-5+random(11) >= spieler->QueryAttribute(A_STR))
  {
    MOORMASTER->Msg(TPUID+" wirft "+UID(spieler)+" vom Stuhl");
    tell_object(TP,      BS("Mit roher Gewalt wirfst Du "+wen+" von "+spieler->QueryPossPronoun(MALE,WEM,SINGULAR)+" Stuhl herunter."));
    tell_object(spieler, BS(CTPN+" scheint boese auf Dich zu sein und wirft Dich mit roher Gewalt vom Stuhl herunter."));
    tell_room(TO,        BS(CTPN+" wirft "+wen+" mit roher Gewalt vom Stuhl herunter.\n"),({TP,spieler}));
    spieler_stuhl -= ({getuuid(spieler)});
  }
  else
  {
    MOORMASTER->Msg(TPUID+" versucht "+UID(spieler)+" vom Stuhl zu werfen");
    tell_object(TP,      BS("Du versuchst "+wen+" vom Stuhl zu werfen, aber "+wen+" ist viel staerker als Du."));
    tell_object(spieler, BS(CTPN+" scheint boese auf Dich zu sein und versucht Dich vom Stuhl herunterzuwerfen, aber Du bist viel staerker."));
    tell_room(TO,        BS(CTPN+" versucht "+wen+" vom Stuhl zu werfen, aber "+wen+" ist viel staerker als "+TPN+"."),({TP,spieler}));
  }
  return 1;
}

int cmd_stehen(string str)
{
  notify_fail("Wovon willst Du aufstehen?\n");

  if(!str || str == "") return 0;

  if(!(str == "auf"           ||
       str == "von stuhl auf" ||
       str == "vom stuhl auf" )) return 0;

  if(!isSitting(TP,1))
  {
    notify_fail("Aber Du sitzt doch gar nicht!\n");
    return 0;
  }

  TELLPLAYER("Du stehst wieder auf.\n");
  TELLOTHERS(TPN+" erhebt sich von einem der Stuehle.\n");
  spieler_stuhl -= ({getuuid(TP)});
  return 1;
}

int cmd_streichen(string str)
{
  notify_fail("Was willst Du streichen?\n");

  if(!str || str == "") return 0;

  if(!(str == "decke"     ||
       str == "decke an"  )) return 0;

  if(isSitting(TP,0)) return -1;

  if(present("oma wetterwachs",TO))
  {
    TELLPLAYER(BSI("Nein danke, das brauchst Du nicht zu tun, "
               "ich habe den Maler schon bestellt.","Oma Wetterwachs sagt: "
    ));
  }
  else
  {
    TELLPLAYER(BS("Du denkst darueber nach, die Decke fuer Oma Wetterwachs "
                  "zu streichen, ueberlegst es Dir dann aber doch anders."
    ));
  }

  return 1;
}

int cmd_schauen(string str)
{
  notify_fail("Woraus oder wo hinein moechtest Du schauen?\n");

  if(!str || str == "") return 0;

  if((str == "aus fenster" || str == "fenster" ))
  {
    TELLPLAYER(BS("Du schaust aus dem Fenster und erblickst ein wenig "
                  "vom Garten. Jenseits des Gartens siehst Du nur "
                  "das trostlose Moor. "
    ));

    TELLOTHERS(TPN+" schaut vertraeumt aus dem Fenster.\n");
    return 1;
  }

  if((str == "in topf" || str == "in topf hinein" ))
  {
    if(isSitting(TP,0)) return -1;

    TELLPLAYER(BS("Hmmmm, leckere Kroetenschleimsuppe. Du bist Dir "
                  "unschluessig, ob Du davon probieren solltest oder "
                  "nicht. Riechen tut es ja gar nicht mal so schlecht."
    ));
    return 1;
  }

  return 0;
}

int cmd_oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(str == "ofenklappe" || str == "ofen" || str == "klappe")
  {
    if(isSitting(TP,0)) return -1;

    SetProp(P_KILL_NAME,"Eine heisse Ofenklappe");
    TELLPLAYER(BS("Du versuchst die Ofenklappe zu oeffnen, aber die ist "
                  "ganz schoen heiss. Vor lauter Schmerzen ziehst Du die "
                  "Hand zurueck."
    ));

    TELLOTHERS(BS(TPN+" versucht die Ofenklappe zu oeffnen, zieht aber "
      "schmerzerfuellt "+TPPP(FEMALE,WESSEN,SINGULAR)+" Hand zurueck."
    ));
    SetProp(P_KILL_NAME,"Eine heisse Ofenklappe");
    TP->do_damage(20);
    return 1;
  }

  if(str == "wasserhahn" || str == "hahn")
  {
    return cmd_drehen("hahn auf");
  }

  return 0;
}

int cmd_entfernen(string str)
{
  notify_fail("Was willst Du entfernen?\n");

  if(-1 == member(({"ring"
                   ,"ringe"
                   ,"ring von ofen"
                   ,"ring von ofenplatte"
                   ,"ringe von ofen"
                   ,"ringe von ofenplatte"
                   ,"ring vom ofen"
                   ,"ringe vom ofen"
                   ,"ring heraus"
                   ,"ringe heraus"
                   }),str))
  {
    return 0;
  }

  if(isSitting(TP,0)) return -1;

  TELLPLAYER(BS("Die Ringe sehen ziemlich heiss aus, selbst mit Handschuhen "
                "duerftest Du Dich daran verbrennen. Ja, wenn Du einen "
                "gescheiten Feuerhaken haettest, dann waere das was anderes, "
                "aber so laesst Du es dann doch bleiben."
  ));
}

int cmd_wischen(string str)
{
  notify_fail("Was willst Du wegwischen?\n");

  if(!str || str == "") return 0;
  if(!(str == "fleck weg"        ||
       str == "fettfleck weg"    ||
       str == "spritzer weg"     ||
       str == "fettspritzer weg" )) return 0;

  if(isSitting(TP,0)) return -1;

  TELLPLAYER(BS("Du versuchst den Fettspritzer zu entfernen, aber "
                "anscheinend hat sich dieser kleiner Fettspritzer als er "
                "noch heiss war ins Leder eingebrannt. Nicht sehr schoen, "
                "aber auch nicht sonderlich tragisch."
  ));
  return 1;
}

int cmd_probieren(string str)
{
  notify_fail("Wovon moechtest Du probieren?\n");

  if(!str || str == "") return 0;
  if(!(str == "von suppe"                 ||
       str == "suppe"                     ||
       str == "von kroetenschleimsuppe"   ||
       str == "kroetenschleimsuppe"       )) return 0;

  if(isSitting(TP,0)) return -1;

  TELLPLAYER("IIiih baeh, das schmeckt ja scheusslich...\n");
  TP->AddPoison(2);
  TP->command_me("wuerg");
  clone_object(OBJ "lsd")->move(TP,M_GET+M_NOCHECK+M_SILENT);
  MOORMASTER->Msg(CTPN+" probiert von der Kroetenschleimsuppe");

  return 1;
}

string sound(string str)
{
  string s;

  s = "Auf dem Herd blubbert leise ein Topf mit Suppe";

  if(present("oma",TO))
  {
    s += " und Oma Wetterwachs summt eine lustige Melodie";
  }

  s += ".";
  return BS(s);
}

void summ(object player)
{
  player->command_me("summ");
}

string omasound(string str)
{
  string s;

  if(!present("oma",TO))
  {
    return "Du kannst nichts Besonderes hoeren.\n";
  }

  switch(str)
  {
    case "oma":
      s = "Oma Wettwachs summt eine lustige Melodie.";
      break;

    case "melodie":
    case "lied":
    case "liedchen":
      s = "Die Melodie geht so richtig ins Ohr, und Du faengst an mitzusummen. "
          "Mit dem Text kannst Du allerdings nichts anfangen.";
      call_out("summ",0,TP);
      break;

    case "text":
      s = "Du verstehst nichts, vermutlich ist es eine Dir unbekannte Sprache.";
      break;

    case "sprache":
      s = "So fremd scheint die Sprache doch nicht zu sein, denn einzelne Silben "
          "kommen Dir bekannt vor. Vielleicht nuschelt Oma Wetterwachs ja auch nur "
          "etwas.";
      break;

    case "silben":
      s = "Die Silben formen sich zu Dir bekannten Woertern.";
      break;

    case "wort":
    case "woerter":
    case "woertern":
      s = "Du glaubst so etwas wie \"Feuer spruehe, Kessel gluehe\" zu verstehen.";
      break;

  }
  return BS(s);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  spieler_stuhl -= ({getuuid(player)});
  return;
}

void BecomesNetDead(object pl)
{
  spieler_stuhl -= ({getuuid(pl)});
  return;
}

