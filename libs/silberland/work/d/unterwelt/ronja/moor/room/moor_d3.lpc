#include "../def.h"

inherit ROOM "moor_inh.lpc" ;

void create()
{
  ::create();

  AddExit(        "norden"      , ROOM "moor_d2" );
  AddExit(        "nordosten"   , ROOM "moor_e2" );
  AddExit(        "osten"       , ROOM "moor_e3" );
  AddSpecialExit( "suedosten"   , "keinausgang"  );
  AddExit(        "sueden"      , ROOM "moor_d4" );
  AddExit(        "suedwesten"  , ROOM "moor_c4" );
  AddExit(        "westen"      , ROOM "moor_c3" );
  AddSpecialExit( "nordwesten"  , "keinausgang"  );

  AddItem(NPC "wegweiser"   , REFRESH_DESTRUCT);
  AddItem(NPC "moorhuhn"    , REFRESH_DESTRUCT);
  AddItem(NPC "moorschnucke", REFRESH_DESTRUCT);
}

