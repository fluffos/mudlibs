    "fremder Leute zu durchsuchen?"
  );

  AddSpecialDetail( ({"leute"}) , "detail_leute" );

  AddDetail( ({"schlafmuetze"}) ,
    "Als Schlafmuetze bezeichnet man jemand, der ganzen Tag verschlaeft. Das "
    "macht Oma Wetterwachs aber nicht, die ist immer frueh munter."
  );

  AddDetail( ({"schrank","kleiderschrank"}) ,
    "Der Kleiderschrank ist einfach riesig. Er verdeckt die gesamte Westwand. "
