  AddSmell( ({DEFAULT_SMELL,"luft" }) , #'smell);

  AddCmd( CMD_NEHMEN                          , "cmd_nehmen");
  AddCmd( ({"zuende","zuend"})                , "cmd_anzuenden");
  AddCmd( ({"lueft","luefte"})                , "cmd_lueften");
  AddCmd( ({"lauf","laufe"})                  , "cmd_laufen");
  AddCmd( ({"reisse","reisse"})               , "cmd_reissen");
  AddCmd( CMD_UNTERSUCHEN                     , "cmd_untersuchen" );
  AddCmd( ({"steh","stehe","steige","steig"}) , "cmd_aufstehen");
  AddCmd( ({"werf","werfe","wirf"}) , "cmd_werfen");
  AddCmd( ({"kriech","krieche","krabbel","krabble","krabbele","leg"
           ,"lege"}), "cmd_insbett");
  AddCmd( CMD_OEFFNEN                         , "cmd_oeffnen");
  AddCmd( ({"schliess","schliesse"})          , "cmd_schliessen" );
  AddCmd( ({"betracht"
           ,"betrachte"
           ,"blick"
           ,"blicke"
           })                                 , "cmd_betrachten" );

  AddCmd("kuschel|kuschele|kuschle|knautsch|kanutsche&kissen",
    "cmd_kuscheln",
    "Was moechtest Du kuscheln?\n"
  );

  AddExit("nordwesten",
    ([EX_DEST : ROOM "eingang", EX_TESTFUNC : #'exit_test ])
  );

  vorhangstatus(AUF);
  fensterstatus(ZU);

  spieler_bett  = "";
  mief          = 1;
  spieler_tuch  = ({ });
  spieler_wachs = ({ });
}

void reset()
{
  int n;
  string s,r,pln;
  object pl;

  ::reset();

  spieler_tuch  = ({ });
  spieler_wachs = ({ });

  mief = (fenster==AUF) ? 0 : 1;

  n = 0;
  if(vorhang == ZU)  n+=1;
  if(fenster == AUF) n+=2;
  if(spieler_bett != "")
  {
    pl = find_player(explode(spieler_bett,"_")[0]);
    if(pl && interactive(pl))
    {
      n+=4;
      pln = pl->name();
    }
    else
    {
      spieler_bett = "";
    }
  }

  if(n == 0) return;

  r = "Oma Wetterwachs kommt herein und murmelt: Wieso ";
  s = r;

  switch(n)
  {
    case 1:
      r += "sind denn die Vorhaenge geschlossen? Kurzentschlossen "
           "oeffnet sie die Vorhaenge.";
      break;

    case 2:
      r += "ist denn das Fenster offen? Kurzentschlossen "
           "schliesst sie das Fenster.";
      break;

    case 3:
      r += "sind denn die Vorhaenge geschlossen und das Fenster auf? "
           "Kurzentschlossen oeffnet sie die Vorhaenge und schliesst das "
           "Fenster.";
      break;

    case 4:
      r += "liegt denn "+pln+" in meinem Bett? Kurzentschlossen "
           "wirft sie "+pl->QueryPronoun(WEN)+" aus dem Bett.";
      s += "liegt denn "+pln+" in meinem Bett? Kurzentschlossen "
           "wirft sie Dich unsanft aus dem Bett.";
      break;

    case 5:
      r += "sind denn die Vorhaenge geschlossen? Und wieso liegt "+pln+
           " in meinem Bett? Kurzentschlossen oeffnet sie die Vorhaenge "
           "und wirft "+pln+" aus dem Bett.";
      s += "sind denn die Vorhaenge geschlossen? Und wieso liegt "+pln+
           " in meinem Bett?  Kurzentschlossen oeffnet sie die Vorhaenge "
           "und wirft Dich unsanft aus dem Bett.";
      break;

    case 6:
      r += "ist denn das Fenster offen? Und wieso liegt "+pln+
           " in meinem Bett? Kurzentschlossen schliesst sie das Fenster"
           " und wirft "+pln+" aus dem Bett.";
      s += "ist denn das Fenster offen? Und wieso liegt "+pln+
           " in meinem Bett? Kurzentschlossen schliesst sie das Fenster "
           "und wirft Dich unsanft aus dem Bett.";
      break;

    case 7:
      r += "sind denn die Vorhaenge geschlossen und das Fenster auf? "
           "Und wieso liegt "+pln+" in meinem Bett? "
           "Kurzentschlossen oeffnet sie die Vorhaenge, schliesst das "
           "Fenster und wirft "+pln+" aus dem Bett.";
      s += "sind denn die Vorhaenge geschlossen und das Fenster auf? "
           "Und wieso liegt "+pln+" in meinem Bett? "
           "Kurzentschlossen oeffnet sie die Vorhaenge, schliesst das "
           "Fenster und wirft Dich unsanft aus dem Bett.";
      break;
  }

  s += " Danach schlurft sie wieder davon.";
  r += " Danach schlurft sie wieder davon.";

  if(spieler_bett != "")
  {
    tell_object(pl,BS(s));
    tell_room(TO,BS(r),({pl}));
  }
  else
  {
    tell_room(TO,BS(r));
  }

  vorhangstatus(AUF);
  fensterstatus(ZU);
  spieler_bett = "";
  return;
}

int exit_test()
{
  if(TP && interactive(TP) && spieler_bett == getuuid(TP))
  {
    TELLPLAYER("Aber Du liegst doch im Bett!\n");
    return 0;
  }
  return 1;
}

int isInBed(object pl,int silent)
{
  if(spieler_bett != "" && spieler_bett == getuuid(pl))
  {
    if(!silent) tell_object(pl,"Aber Du liegst doch noch im Bett!\n");
    return 1;
  }
  return 0;
}

int check_if_player(object ob)
{
  return (interactive(ob) && !(ob->QueryProp(P_INVIS)));
}

void vorhangstatus(int n)
{
  if(n == AUF)
  {
    vorhang = AUF;
    SetProp(P_LIGHT, 1);
  }
  else
  {
    vorhang = ZU;
    SetProp(P_LIGHT, 0);
  }
  return;
}

void fensterstatus(int n)
{
  if(n == AUF)
  {
    fenster = AUF;
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 8, ENV_TERRAIN: TT_HOUSE]) );
    mief = 0;
  }
  else
  {
    fenster = ZU;
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN: TT_HOUSE]) );
  }
  return;
}

string detail_luft(string str)
{
  string s;

  if(fenster == AUF)
  {
    s = "Das Fenster ist offen und es kommt im Moment jede Menge "
        "frische Luft herein.";
  }
  else
  {
    if(mief)
    {
      s = "Hier wurde wohl laenger nicht gelueftet. Frische Luft "
          "im Zimmer taete mal ganz gut.";
    }
    else
    {
      s = "Hier wurde vor kurzem gut gelueftet.";
    }
  }

  return BS(s);
}

string detail_fenster(string str)
{
  string s;

  s = "An der Ostwand ist ein Fenster, aus dem Du herausschauen kannst. "
      "Damit es auch richtig dunkel werden kann sind vor dem Fenster "
      "Vorhaenge angebracht. ";

  if(fenster == AUF)
  {
    s += "Momentan ist das Fenster geoeffnet, wohl damit frische "
         "Luft hineinkommen kann. ";
  }
  else
  {
    s += "Momentan ist das Fenster geschlossen.";
  }

  return BS(s);
}

string detail_vorhang(string str)
{
  string s;

  s = "Vor dem Fenster haengen dunkelblaue Vorhaenge aus einem dicken "
      "Stoff, damit man den Raum ordentlich verdunkeln kann, wenn man "
      "schlafen moechte. ";

  if(vorhang == AUF)
  {
    s += "Momentan sind die Vorhaenge geoeffnet, damit es hell ist "
         "im Schlafzimmer.";
  }
  else
  {
    s += "Die Vorhaenge sind geschlossen. Deswegen ist es wohl auch "
         "dunkel im Schlafzimmer.";
  }

  return BS(s);
}

string detail_unter_bett(string str)
{
  string s;

  s = "Du schaust unter das Bett und findest - nichts. Dabei warst Du jetzt "
      "so stolz darauf, endlich mal gleich daran zu denken, auch unter "
      "das Bett zu schauen, und dann findet man dort nichts.";

  MOORMASTER->Msg(TPUID+" schaut unter das Bett");

  return BS(s);
}

string detail_fenster_raus(string str)
{
  string s;

  if(vorhang == ZU)
  {
    s = "Durch die geschlossenen Vorhaenge kannst Du nicht hinduchschauen.";
  }
  else
  {
    s = "Du schaust aus dem Fenster, aber es ist mittlerweile so neblig, "
        "dass Du nichts erkennen kannst.";
  }

  MOORMASTER->Msg(TPUID+" schaut aus dem Fenster");

  return BS(s);
}

string detail_in_spiegel(string str)
{
  cmd_betrachten("dich");
  return "";
}

string detail_bett(string str)
{
  string s;
  object pl;

  s = "Das Bett ist ein altes Bett aus Metall. Es steht an der Wand. "
      "An dem Kopfteil ist das Metallgitter hoeher als am Fussteil. "
      "Wohl damit man sich ein Kissen in der Ruecken stopfen kann "
      "und dann abends noch gemuetlich lesen kann. Die Matratze ist "
      "mit einem weissen Bettbezug ueberzogen, darauf liegen eine "
      "dicke Daunendecke und ein riesiges Kissen. ";

  pl = find_player(explode(spieler_bett,"_")[0]);
  if(pl && interactive(pl))
  {
    s += pl->Name()+" hat es sich im Bett bequem gemacht.";
  }
  else
  {
    spieler_bett = "";
  }

  return BS(s);
}

string detail_leute(string str)
{
  string s;
  object *spieler;

  spieler=filter_array(all_inventory(TO), "check_if_player") - ({TP});

  switch(sizeof(spieler))
  {
    case 0:
      s = "Ausser Dir ist sonst niemand da.";
      break;

    case 1:
      s = "Ausser Dir siehst Du noch "+spieler[0]->Name()+".";
      break;

    default:
      s = "Du siehst "+LW(map_objects(spieler,"name"));
  }

  return BS(s);
}

string detail_unsinn(string str)
{
  string s;

  s = "Es zeugt von Deinem Eifer, aber das jetzt weiter zu untersuchen "
      "bringt weder Forscherpunkte noch bringt es Dich sonstwie weiter.";

  MOORMASTER->Msg(TPUID+" untersucht : -"+str+"-");

  return BS(s);
}

int cmd_lueften(string str)
{
  if(isInBed(TP,0)) return -1;

  notify_fail("Wenn Du lueften moechtest, dann mach doch einfach das Fenster "
              "auf.\n");
  return 0;
}

int cmd_oeffnen(string str)
{
  object ob;

  if(isInBed(TP,0)) return -1;

  notify_fail("Was moechtest Du oeffnen?\n");

  if(str == "schrank" || str == "kleiderschrank")
  {
    TELLPLAYER("Der Kleiderschrank sagt: Lass das !\n");
    TELLOTHERS(TPN+" fummelt am Kleiderschrank herum und erschrickt auf "
               "einmal.\n");
    MOORMASTER->Msg(TPUID+" versucht den Kleiderschrank zu oeffnen");
    return 1;
  }

  if(str == "tuer")
  {
    TELLPLAYER("Welche Tuer meinst Du? Die linke, rechte oder die "
               "Spiegeltuer?\n");
    TELLOTHERS(TPN+" steht raetselratend vor dem Kleiderschrank.\n");
    return -1;
  }

  if(str == "linke tuer")
  {
    TELLPLAYER("Du ruettelst an der linken Tuer herum, aber die laesst sich "
               "nicht oeffnen.\n");
    TELLOTHERS(TPN+" ruettelt an der linken Schanktuer herum, kriegt sie "
               "aber nicht auf.\n");
    MOORMASTER->Msg(TPUID+" oeffnet die linke Schranktuer");
    return 1;
  }

  if(str == "rechte tuer")
  {
    TELLPLAYER(BS("Du oeffnest die rechte Schranktuer und entdeckst eine "
                  "Menge Unterwaesche. Verschaemt schliesst Du den Schrank "
                  "wieder."));
    TELLOTHERS(BS(TPN+" oeffnet die rechte Schranktuer, kriegt einen "
                  "hochroten Kopf und schliesst die Tuer wieder."));
    MOORMASTER->Msg(TPUID+" oeffnet die rechte Schranktuer");
    return 1;
  }

  if(str == "spiegeltuer")
  {
    TELLPLAYER(BS("Du untersuchst die Spiegeltuer genauer und stellst fest, "
                  "dass es gar keine Tuer ist. "));
    TELLOTHERS(TPN+" untersucht die Spiegeltuer sehr genau.\n");
    MOORMASTER->Msg(TPUID+" versucht die Spiegeltuer zu oeffnen");
    return 1;
  }

  if(str == "schublade" || str == "schubladen")
  {
    TELLPLAYER(BS("Welche Schubladen moechtest Du oeffnen? Die untere "
                  "oder obere Schublade?"));
    TELLOTHERS(TPN+" betrachtet die Schubladen und scheint zu ueberlegen.\n");
    return -1;
  }

  if(str == "untere schublade")
  {
    TELLPLAYER("Die untere Schublade scheint zu klemmen.\n");
    TELLOTHERS(TPN+" ruettelt an der unteren Schublade herum.\n");
    return 1;
  }

  if(str == "obere schublade")
  {
    if(member(spieler_tuch,getuuid(TP)) > -1)
    {
      TELLPLAYER(BS("Du oeffnest die obere Schublade nochmal, findest aber "
                    "kein einziges Taschentuch mehr. Enttaeuscht machst Du "
                    "die Schublade wieder zu."));
      TELLOTHERS(BS(TPN+" oeffnet die obere Schublade, sieht kurz hinein "
                    "und schliesst sie sogleich wieder. "));
      return -1;
    }

    ob = clone_object(OBJ "taschentuch");
    if(ob->move(TP,M_GET|M_SILENT) != 1)
    {
      TELLPLAYER(BS("Du oeffnest die obere Schublade und siehst einen "
                    "Stapel frischer Taschentuecher. Du denkst Dir: sowas "
                    "kann man immer gebrauchen und nimmst Dir eines. Doch "
                    "unter der nun viel zu grossen Last brichst Du laut "
                    "schnaufend zusammen. Du schaffst es gerade noch die "
                    "Schublade zu schliessen. "));
      TELLOTHERS(BS(TPN+" oeffnet die obere Schublade, greift hinein und "
                    "nimmt etwas hinaus. "+TPP(WER)+" bricht aber unter der "
                    "Last zusammen. Das muss etwas sehr schweres gewesen "
                    "sein, was da in der Schublade war. Mit letzter Kraft "
                    "schliesst "+TPN+" die Schublade wieder."));
      ob->remove();
      return -1;
    }
    else
    {
      TELLPLAYER(BS("Du oeffnest die Schublade und siehst einen Stapel "
                    "Taschentuecher. Sowas kann man immer gebrauchen "
                    "denkst Du Dir und steckst eines ein. Sorgsam "
                    "wie Du nunmal bist schliesst Du die Schublade "
                    "wieder. "));
      TELLOTHERS(BS(TPN+" oeffnet die obere Schublade, greift hinein, "
                    "holt etwas heraus und schliesst die Schublade "
                    "wieder. "));
      spieler_tuch += ({ getuuid(TP) });
    }

    return 1;
  }

  if(str == "fenster")
  {
    if(TP->CannotSee(1))
    {
      TELLPLAYER("Du kannst doch gar nichts sehen.\n");
      TELLOTHERS(TPN+" tapst herum.\n");
      return -1;
    }

    if(fenster == AUF)
    {
      TELLPLAYER("Aber das Fenster ist doch schon auf.\n");
      TELLOTHERS(TPN+" macht sich am Fenster zu schaffen.\n");
    }
    else
    {
      TELLPLAYER("Du oeffnest das Fenster und laesst etwas frische Luft "
               "herein.\n");
      TELLOTHERS(TPN+" oeffnet das Fenster und laesst etwas frische "
               "Luft herein.\n");
      MOORMASTER->Msg(TPUID+" oeffnet das Fenster");
      fensterstatus(AUF);
    }
    return 1;
  }

  if(str == "vorhang" || str == "vorhaenge")
  {
    if(TP->CannotSee(1))
    {
      TELLPLAYER("Du kannst doch gar nichts sehen.\n");
      TELLOTHERS(TPN+" tapst herum.\n");
      return 1;
    }

    if(vorhang == AUF)
    {
      TELLPLAYER("Aber die Vorhaenge sind doch schon offen.\n");
      TELLOTHERS(TPN+" macht sich an den Vorhaengen zu schaffen.\n");
    }
    else
    {
      TELLPLAYER("Du oeffnest die Vorhaenge und es wird hell.\n");
      TELLOTHERS(TPN+" oeffnet die Vorhaenge und es wird hell.\n");
      MOORMASTER->Msg(TPUID+" oeffnet die Vorhaenge");
      vorhangstatus(AUF);
    }
    return 1;
  }

  return 0;
}

int cmd_kuscheln(string str)
{

  TP->Message(BS("Nicht doch, wenn Dich jemand sieht, wie Du hier "
                 "als beinharter Abenteurer Dich in ein Kissen kuschelst!"),
              MSGFLAG_VISUAL);


  TO->Message(TP->Name(WER)+" sieht sich verstohlen um.\n",
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

int cmd_schliessen(string str)
{
  if(isInBed(TP,0)) return -1;

  notify_fail("Was willst Du schliessen?\n");

  if(!str || str == "") return 0;
  if(str == "schrank"          ||
     str == "kleiderschrank"   ||
     str == "tuer"             ||
     str == "linke tuer"       ||
     str == "rechte tuer"      ||
     str == "schublade"        ||
     str == "schubladen"       ||
     str == "untere schublade" ||
     str == "obere schublade"   )
  {
    TELLPLAYER("Das ist doch aber gar nicht offen.\n");
    return -1;
  }

  if(str == "fenster")
  {
    if(TP->CannotSee(1))
    {
      TELLPLAYER("Du kannst doch gar nichts sehen.\n");
      TELLOTHERS(TPN+" tapst herum.\n");
      return -1;
    }

    if(fenster == ZU)
    {
      TELLPLAYER("Aber das Fenster ist doch schon zu.\n");
      TELLOTHERS(TPN+" macht sich am Fenster zu schaffen.\n");
      return -1;
    }
    else
    {
      TELLPLAYER("Du schliesst das Fenster.\n");
      TELLOTHERS(TPN+" schliesst das Fenster.\n");
      MOORMASTER->Msg(TPUID+" schliesst das Fenster");
      fensterstatus(ZU);
    }
    return 1;
  }

  if(str == "vorhang" || str == "vorhaenge")
  {
    if(TP->CannotSee(1))
    {
      TELLPLAYER("Du kannst doch gar nichts sehen.\n");
      TELLOTHERS(TPN+" tapst herum.\n");
      return 1;
    }

    if(vorhang == ZU)
    {
      TELLPLAYER("Aber die Vorhaenge sind doch schon geschlossen.\n");
      TELLOTHERS(TPN+" macht sich an den Vorhaengen zu schaffen.\n");
    }
    else
    {
      TELLPLAYER("Du schliesst die Vorhaenge und es wird dunkel.\n");
      TELLOTHERS(TPN+" schliesst die Vorhaenge und es wird dunkel.\n");
      MOORMASTER->Msg(TPUID+" schliesst die Vorhaenge");
      vorhangstatus(ZU);
    }
    return 1;
  }

  return 0;
}

int cmd_betrachten(string str)
{
  notify_fail("Wo willst Du Dich betrachten?\n");

  if(!str || str == "") return 0;
  if(!(str == "dich"              ||
       str == "dich im spiegel"   ||
       str == "spiegel"           ||
       str == "in spiegel"        )) return 0;

  if(isInBed(TP,0)) return -1;

  TELLPLAYER(BS("Du betrachtest Dich im Spiegel. Ein wenig fett bist "
                "Du geworden, besonders an den Hueften. Und das Leben "
                "als Abenteurer ist nicht ohne Spuren an Dir vorbei"
                "gegangen. Ein Bad waere dringend mal angesagt."
  ));
  TELLOTHERS(TPN+" betrachtet sich eitel im Spiegel.\n");
  MOORMASTER->Msg(TPUID+" betrachtet sich im Spiegel");
  return 1;
}

int cmd_werfen(string str)
{
  int n;
  string wen;
  object pl;

  notify_fail("Wen moechtest Du aus dem Bett werfen?\n");

  if(!str || str == "") return 0;

  n = sscanf(str, "%s raus", wen);
  if(n==0){n = sscanf(str, "%s hinaus", wen);}
  if(n==0){n = sscanf(str, "%s aus bett", wen);}
  if(n==0){n = sscanf(str, "%s aus bett hinaus", wen);}
  if(n==0){n = sscanf(str, "%s aus bett heraus", wen);}
  if(n==0){n = sscanf(str, "%s aus bett raus", wen);}
  if(n==0){return 0;}

  if(isInBed(TP,1))
  {
    TELLPLAYER("Aber Du liegst doch selbst im Bett!\n");
    return -1;
  }

  if(spieler_bett == "")
  {
    TELLPLAYER("Aber das Bett ist doch leer!\n");
    return -1;
  }

  if(!(pl = find_player(wen)))
  {
    TELLPLAYER(CAP(wen)+" ist doch gar nicht da.");
    return -1;
  }

  if(spieler_bett != getuuid(pl))
  {
    TELLPLAYER(pl->Name()+" liegt doch gar nicht im Bett.\n");
    return -1;
  }

  if(TP->QueryAttribute(A_STR)-5+random(10) >
     pl->QueryAttribute(A_STR) )
  {
    tell_object(TP,"Du wirfst "+pl->Name()+" unsanft aus dem Bett.\n");
    tell_object(pl,TPN+" wirft Dich unsanft aus dem Bett. So eine Gemeinheit!\n");
    tell_room(TO,TPN+" wirft "+pl->Name()+" unsanft aus dem Bett.\n", ({TP,pl}) );
    MOORMASTER->Msg(TPUID+" wirft "+pl->Name()+" aus dem Bett");
    spieler_bett = "";
  }
  else
  {
    tell_object(TP,BS("Du wuerdest "+pl->Name()+" gerne aus dem Bett werfen, "
                      "bist aber viel zu schwach dafuer."));
    tell_object(pl,TPN+" ruettelt an Dir herum. Was soll denn das?\n");
    tell_room(TO,BS(TPN+" ruettelt an "+pl->Name()+" herum. Ob "+CAP(TPP(WER))+
                    " "+pl->Name()+" aus dem Bett werfen will? Wenn ja, "
                    "dann ist "+CAP(TPP(WER))+" viel zu schwach dafuer."
                   ), ({TP,pl}) );
    MOORMASTER->Msg(TPUID+" versucht, "+pl->Name()+" aus dem Bett zu werfen");
  }

  return 1;

}

int cmd_nehmen(string str)
{
  object ob;

  notify_fail("Was willst Du nehmen?\n");

  if(!str || str == "") return 0;
  if(!(str == "wachs"                    ||
       str == "wachs von staender"       ||
       str == "wachs von kerzenstaender" )) return 0;

  if(isInBed(TP,0)) return -1;

  if(member(spieler_wachs,getuuid(TP)) > -1)
  {
    TELLPLAYER(BS("Es ist nur noch sowenig Wachs vorhanden, dass es sich "
                  "nicht lohnt, davon etwas zu nehmen."));
    return -1;
  }

  ob=clone_object(OBJ "wachs.lpc");
  if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
  {
    TELLPLAYER(BS("Du hast schon soviel Sachen bei Dir, dass Du "
                  "selbst ein Stueckchen Wachs nicht mehr tragen kannst."
    ));
    ob->remove();
  }
  else
  {
    TELLPLAYER("Du puhlst etwas Wachs vom Kerzenstaender herunter.\n");
    TELLOTHERS(TPN+" beschaeftigt sich eingehend mit dem Kerzenstaender.\n");
    spieler_wachs += ({ getuuid(TP) });
    MOORMASTER->Msg(TPUID+" nimmt ein Stueck Wachs");
    return 1;
  }

  return -1;
}

int cmd_anzuenden(string str)
{
  notify_fail("Was wilst Du anzuenden?\n");

  if(!str || str == "") return 0;
  if(!(str == "kerze an"      ||
       str == "kerze"         ))return 0;

  if(isInBed(TP,0)) return -1;

  TELLPLAYER(BS("Der Docht ist viel zu kurz und die Kerze schon fast voellig "
             "abgebrannt. Diese Kerze kannst Du nicht mehr anzuenden."));
  TELLOTHERS(TPN+" untersucht eine Kerze genauestens.\n");
  MOORMASTER->Msg(TPUID+" versucht die Kerze anzuzuenden");
  return 1;
}

int cmd_aufstehen(string str)
{
  notify_fail("Woraus moechtest Du steigen?\n");

  if(!str || str == "") return 0;
  if(!(str == "auf"             ||
       str == "aus bett"        ||
       str == "aus bett aus"    ||
       str == "aus bett heraus" )) return 0;

  if(spieler_bett != getuuid(TP)) return 0;

  TELLPLAYER("Du stehst wieder aus dem Bett auf. Ahhhh, hat das gut getan.\n");
  TELLOTHERS(TPN+" steigt aus dem Bett und streckt sich erstmal.\n");
  MOORMASTER->Msg(TPUID+" steht aus dem Bett auf");
  spieler_bett = "";
  return 1;
}

int cmd_insbett(string str)
{
  object pl;

  notify_fail("Wo hinein moechtest Du Dich legen?\n");

  if(!str || str == "") return 0;
  if(!(str == "in bett"          ||
       str == "ins bett"         ||
       str == "in bett hinein"   ||
       str == "ins bett hinein"  )) return 0;

  if(isInBed(TP,1))
  {
    TELLPLAYER("Aber Du liegst doch schon im Bett!\n");
    return -1;
  }

  pl = find_player(explode(spieler_bett,"_")[0]);
  if(!(pl && interactive(pl)))
  {
    spieler_bett = "";
  }

  if(spieler_bett != "")
  {
    tell_object(TP,BS("Da liegt aber schon "+pl->Name()+" drin, und "
                      "fuer euch beide ist das Bett zu klein. "+
                       pl->Name()+" schlummert aber auch so suess, "
                       "dass Du "+pl->QueryPronoun(WEN)+" nicht aus "
                       "dem Bett werfen moechtest."));

    tell_object(pl,BS(TPN+" will sich zu Dir ins Bett legen, aber "
                      "das Bett ist zu klein fuer euch beide."));

    tell_room(TO, TPN+" will sich ins Bett legen, aber da liegt schon "+
              pl->Name()+" drin.\n",  ({TP,pl}) );
    return -1;
  }

  TELLPLAYER("Du legst Dich ins Bett und kuschelst Dich so richtig ein.\n");
  TELLOTHERS(TPN+" legt sich ins Bett. Na hoffentlich schnarcht "+TPP(WER)+
             " nicht so laut.\n");
  MOORMASTER->Msg(TPUID+" legt sich ins Bett");
  spieler_bett = getuuid(TP);
  return 1;
}

int cmd_untersuchen(string str)
{
  if(isInBed(TP,1))
  {
    TELLPLAYER(BS("Du liegst im Bett und es ist herrlich kuschlig. "
                  "Du hast ueberhaupt keine Lust zu forschen.\n"));
    return -1;
  }
  return 0;
}

int cmd_reissen(string str)
{
  notify_fail("Was willst Du herausreissen?\n");

  if(!str || str == "") return 0;
  if(!(str == "fussboden aus"         ||
       str == "holzfussboden aus"     ||
       str == "fussboden raus"        ||
       str == "holzfussboden raus"    ||
       str == "fussboden heraus"      ||
       str == "holzfussboden heraus"  )) return 0;

  if(isInBed(TP,0)) return -1;

  TELLPLAYER(BS("Du schaust Dir den Fussboden an und denkst an die "
                "ganze Arbeit, nur um herauszubekommen, ob da nun "
                "Steine unter dem Holzfussboden sind oder nicht. "
                "Schliesslich laesst Du es dann doch sein. "
  ));

  TELLOTHERS(TPN+" starrt gedankenverloren auf den Fussboden.\n");
  MOORMASTER->Msg(TPUID+" will unter den Holzfussboden schauen");
  return 1;
}

int cmd_laufen(string str)
{
  notify_fail("Worueber willst Du laufen?\n");

  if(!str || str == "") return 0;

  if(str == "ueber fussboden"         ||
     str == "ueber holzfussboden"     ||
     str == "ueber holz"              ||
     str == "ueber boden"              )
  {
    if(isInBed(TP,0)) return -1;

    TELLPLAYER(BS("Du laeufst ueber den Holzfussboden und tatsaechlich - "
                  "er knarzt nicht im geringsten."
    ));
    TELLOTHERS(TPN+" laeuft im Schlafzimmer auf und ab.\n");
    MOORMASTER->Msg(TPUID+" laeuft im Schlafzimmer auf dem Boden herum");
    return 1;
  }

  if(str == "ueber laeufer")
  {
    TELLPLAYER(BS("Du laeufst ueber den Laeufer, merkst aber nichts "
                  "besonderes."));
    TELLOTHERS(TPN+" laeuft im Schlafzimmer auf und ab.\n");
    MOORMASTER->Msg(TPUID+" laeuft im Schlafzimmer auf dem Laeufer herum");
    return 1;

  }

  return 0;
}

string smell(string str)
{
  string s;

  if(fenster == AUF)
  {
    s = "Das Fenster ist offen und es kommt im Moment jede Menge "
        "frische Luft herein.";
  }
  else
  {
    if(mief)
    {
      s = "Hier wurde wohl laenger nicht gelueftet. Frische Luft "
          "im Zimmer taete mal ganz gut.";
    }
    else
    {
      s = "Hier wurde vor kurzem gut gelueftet.";
    }
  }

  return BS(s);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(spieler_bett == getuuid(player))
  {
    spieler_bett = "";
    tell_room(TO,player->Name()+" purzelt aus dem Bett heraus.\n");
  }
  return;
}

void BecomesNetDead(object player)
{
  if(spieler_bett == getuuid(player))
  {
    spieler_bett = "";
    tell_room(TO,player->Name()+" purzelt aus dem Bett heraus.\n");
  }

  return;
}

