#include "../def.h"

inherit "/std/room";

#define LW(x) (sizeof(x)==1 ? x[0] : implode(x[0..<2],", ")+" und "+x[<1])

#define AUF 1
#define ZU 0

int vorhang;
int fenster;
int mief;

string *spieler_tuch;
string *spieler_wachs;
string  spieler_bett;

int vorhangstatus(int i);
int fensterstatus(int i);

int exit_test();
int cmd_betrachten(string str);

string smell(string str);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Schlafzimmer" );

  SetProp( P_INT_LONG,
    "Das Schlafzimmer von Oma Wetterwachs. Es ist recht spartanisch "
    "eingerichtet. An der Suedwand steht ein grosses Bett, an der Westwand "
    "ein riesiger Schrank. Rund um das Bett ist ein Laeufer ausgelegt und "
    "neben dem Bett steht ein kleines Nachtschraenkchen. "
  );

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"zimmer","raum","schlafzimmer"}) ,
    QueryProp(P_INT_LONG)
  );

  AddDetail( ({"wand","waende"}) ,
    "An der Suedwand steht das Bett, an der Westwand ein riesiger "
    "Kleiderschrank. An der Nordwand haengt noch ein Bild, und an der "
    "Ostwand befindet sich ein Fenster. "
  );

  AddDetail( ({"decke"}) ,
    "Meinst Du die Bettdecke oder die Zimmerdecke?"
  );

  AddDetail( ({"zimmerdecke"}) ,
    "An der Zimmerdecke siehst Du nichts besonderes. Noch nicht mal "
    "eine Lampe. "
  );

  AddDetail( ({"lampe"}) ,
    "An der Zimmerdecke haengt keine Lampe. Wenn die Vorhaenge geschlossen "
    "sind, muss man den Raum wohl anders erleuchten. "
  );

  AddSpecialDetail( ({"fenster"}) , "detail_fenster" );

  AddSpecialDetail( ({"vorhang","vorhaenge"}) , "detail_vorhang" );

  AddSpecialDetail( ({"unter bett"}), "detail_unter_bett");

  AddSpecialDetail( ({"aus fenster","aus fenster hinaus"
                     ,"aus fenster heraus"}) , "detail_fenster_raus");

  AddSpecialDetail( ({"in spiegel","in spiegel hinein"}), "detail_in_spiegel");
