    "       .-'    `'-.`'-.      '-.               \n"
    "     .'           )   `\\       '.             \n"
    "   .'            /      \\   ^V^  '.           \n"
    "  /           __/________\\__       \\          \n"
    " /  ^V^      '--}}}}}}}\"}}--'       \\         \n"
    ";              {{{{{{  aa\\__         ;        \n"
    "|              }}}}} ,___ __}        |        \n"
    "|             {{{{{\\  \\_//           |        \n"
    "|              }}}}//'--u            |        \n"
    "|        _     .--'`U\\               |        \n"
