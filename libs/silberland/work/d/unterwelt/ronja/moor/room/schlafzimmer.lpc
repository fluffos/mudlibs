  AddDetail( ({"linke tuer"}) ,
    "Eine ganz nomale Kleiderschranktuer. Vielleicht kann man sie ja oeffnen?"
  );

  AddDetail( ({"rechte tuer"}) ,
    "Die rechte Tuer sieht aus wie die linke Tuer, natuerlich spiegelverkehrt."
