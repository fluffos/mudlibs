  );

  AddDetail( ({"kopf"}) ,
    "Wo hast Du den bloss gelassen?"
  );

  AddDetail( ({"metall"}) ,
    "Das Metall, aus welchem das Bett gefertigt ist, wurde schwarz lackiert. "
