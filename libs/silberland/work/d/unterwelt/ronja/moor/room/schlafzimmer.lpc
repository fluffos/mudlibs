  );

  AddDetail( ({"suedwand"}) ,
    "Das Kopfteil des Bettes steht gegen die Suedwand."
  );

  AddDetail( ({"kopfteil"}) ,
    "Der Kopfteil des Bettes ist gegen die Wand gestellt."
  );

  AddDetail( ({"fussteil"}) ,
    "Naja, wenn das Kopfteil an der Wand steht, wird das Fussteil wohl in "
