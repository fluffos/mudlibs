  );

  AddDetail( ({"ostwand"}) ,
    "In der Ostwand befindet sich ein Fenster."
  );

  AddDetail( ({"moor"}) ,
    "Das befindet sich draussen."
  );

  AddDetail( ({"kundschaft"}) ,
    "Das waere wohl nur Oma Wetterwachs. Aber die alleine reicht nicht "
