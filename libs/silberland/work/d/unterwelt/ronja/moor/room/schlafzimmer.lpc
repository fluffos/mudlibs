  );

  AddDetail( ({"schublade","schubladen"}) ,
    "Welche Schublade meinst Du? Die untere oder obere Schublade?"
  );

  AddDetail( ({"untere Schublade","obere Schublade"}) ,
    "Eine ganz gewoehnliche Schublade. Du kannst sie oeffnen."
  );

  AddDetail( ({"nachtschraenkchen","tischchen","schraenkchen"}) ,
    "Eigentlich ist es ja kein Schraenkchen, sondern eher ein Tischchen. "
