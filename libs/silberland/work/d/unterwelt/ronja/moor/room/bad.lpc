#include "../def.h"

inherit "/std/room";

int    fliesen_nass;
int    hahn_zu;

string *haare;
string *spieler;
string *spieler_haare;

int    exit_test(string str);
string tropfen(string key);
void   wasserhahn_zu();
void   wasserhahn_auf();
void   grund_zustand();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Badezimmer" );
  SetProp(P_INT_LONG,
    "Du befindest Dich in Oma Wetterwachsens Badezimmer. Du siehst ein "
    "Waschbecken, darueber ein kleines Regal, einen kleinen Schemel und "
    "eine grosse Badewanne. In einer Ecke steht ein kleiner Eimer."
  );

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"bad", "badezimmer","zimmer","raum"}) ,
    QueryProp(P_INT_LONG)
  );

  AddDetail( ({"boden","fussboden"}) ,
    "Der Boden besteht aus mittelgrossen Fliesen, wohl damit man gut sauber "
    "machen kann. Allerdings kann man auch leicht auf den Fliesen "
    "ausrutschen, wenn sie nass sind. "
  );

  AddSpecialDetail( ({"fliesen"}) , "detail_fliesen" );

  AddDetail( ({"wand","waende"}) ,
    "Die Waende sind ebenso wie der Fussboden gefliest."
  );

  AddDetail( ({"decke"}) ,
    "An der Decke haengt eine Kristallkugel. Wozu die wohl gut ist?"
  );

  AddDetail( ({"kugel","kristallkugel"}) ,
    "An der Kristallkugel ist eine kurze Schnur befestigt."
  );

  AddDetail( ({"schnur"}) ,
    "Die Schnur verschwindet in einem kleinen Loch in der Kristallkugel. "
    "Am anderen Ende ist ein Knoten, damit man die Schnur besser greifen "
    "kann."
  );

  AddDetail( ({"knoten"}) ,
    "Der Knoten wurde schon vor Jahren in die Schnur gemacht und hat sich "
    "total festgezogen. Den kannst Du nicht mehr loesen."
  );

  AddDetail( ({"ende"}) ,
    "Am Ende der Schnur hat jemanden einen Knoten gemacht."
  );

  AddDetail( ({"loch"}) ,
    "Durch ein kleines Loch verschwindet die Schnur in der Kristallkugel. Ob "
    "die Schnur herausfaellt, wenn man daran zieht?"
  );

  AddDetail( ({"waschbecken","becken"}) ,
    "An der Nordwand befindet sich ein Waschbecken. Es ist blitzblank, nur "
    "ein paar Wassertropfen befinden sich darin. Ob der Wasserhahn nicht "
    "richtig zugedreht ist?"
  );

  AddSpecialDetail( ({"wasserhahn","hahn"}) , "detail_hahn");

  AddDetail( ({"nordwand"}) ,
    "An der Nordwand befindet sich ein Waschbecken. Darueber haengt ein "
    "kleines Regal."
  );

  AddDetail( ({"ostwand","suedwand","westwand"}) ,
    "Daran siehst Du nichts besonderes."
  );

  AddDetail( ({"wassertropfen","tropfen"}) ,
    "Im Waschbecken befinden sich ein paar Wassertropfen, grade so als ob "
    "der Wasserhahn tropfen wuerde. Vielleicht hat jemand auch nur vor "
    "kurzem den Wasserhahn aufgedreht."
  );

  AddDetail( ({"oma","wetterwachs","oma wetterwachs"}) ,
    "Die ist nicht hier."
  );

  AddDetail( ({"ecke","ecken"}) ,
    "Du schaust Dir die Ecken genau an, auch sie sind blitzblank sauber. "
    "Oma Wetterwachs ist halt ordentlich. In einer der Ecke steht ein Eimer."
  );

  AddDetail( ({"eimer","putzeimer"}) ,
    "Sieht aus wie ein Putzeimer. Er ist aus Holz, oben befindet sich ein "
    "Drahtreifen, damit die Bohlen nicht auseinanderfallen. Er hat "
    "ein Seil als Henkel. Im Eimer liegt ein Putzlumpen."
  );

  AddDetail( ({"holz","holzart"}) ,
    "Die Holzart laesst sich nicht mehr feststellen."
  );

  AddDetail( ({"reifen","drahtreifen","rand"}) ,
    "Aussen am oberen Rand ist ein Drahtreifen angebracht, der die "
    "Holzbohlen zusammen haelt. So wie es aussieht ist der Reifen aus "
    "Eisen, aber Rost siehst Du keinen."
  );

  AddDetail( ({"eisen"}) ,
    "Es befindet sich kein Rost daran."
  );

  AddDetail( ({"rost"}) ,
    "KEIN Rost!"
  );

  AddDetail( ({"bohlen","holzbohlen"}) ,
    "Der Eimer besteht aus 16 Holzbohlen, welche durch einen Drahtreifen "
    "zusammen gehalten werden."
  );

  AddDetail( ({"henkel","seil"}) ,
    "Als Henkel hat man einfach ein Seil genommen und am Eimer befestigt."
  );

  AddDetail( ({"putzlumpen","lumpen"}) ,
    "Damit koenntest Du die Fliesen aufwischen."
  );

  AddDetail( ({"schemel"}) ,
    "Der Schemel besteht aus 3 kleinen Beinen, welche in eine Holzscheibe "
    "eingelassen sind. Zum Sitzen ist der Schemel viel zu klein."
  );

  AddDetail( ({"holzscheibe"}) ,
    "Die Holzscheibe dient als Sitzflaeche. An ihr sind die Beine des "
    "Schemels befestigt."
  );

  AddDetail( ({"sitz","flaeche","sitzflaeche"}) ,
    "Die Sitzflaeche ist dazu da, dass man sich auf den Schemel setzen "
    "kann. Muss man Dir denn alles vorkauen?"
  );

  AddDetail( ({"bein","beine","beinen"}) ,
    "Der Schemel hat drei kleine Beine."
  );

  AddDetail( ({"regal"}) ,
    "Das Regal besteht aus einem Dir unbekanntem Material. Es ist aeusserst "
    "glatt und reinweiss. Auf dem Regal liegen eine Schatulle und eine "
    "Buerste."
  );

  AddDetail( ({"material"}) ,
    "Das Material ist reinweiss, voellig glatt und Dir total unbekannt."
  );

  AddDetail( ({"schatulle"}) ,
    "Auf dem Regal liegt eine Schatulle. Sie ist verschlossen."
  );

  AddDetail( ({"buerste","haarbuerste"}) ,
    "Eine Buerste, um sich die Haare zu buersten. Es befinden sich einige "
    "Haare daran."
  );

  AddSpecialDetail( ({"haar","haare"}) , "detail_haare" );


  AddDetail( ({"badewanne","wanne"}) ,
    "Oma Wetterwachs ist sehr reinlich, daher hat sie auch eine Badewanne."
  );

  AddSound( ({DEFAULT_SOUND, "tropfen", "hahn", "wasserhahn"}) , #'tropfen );

  AddCmd( ({"mach","mache"})                    , "cmd_machen");
  AddCmd( CMD_NEHMEN                            , "cmd_nehmen");
  AddCmd( ({"zieh","ziehe"})                    , "cmd_ziehen");
  AddCmd( ({"dreh","drehe"})                    , "cmd_drehen");
  AddCmd( ({"loes","loese"})                    , "cmd_loesen");
  AddCmd( ({"wisch","wische"})                  , "cmd_wischen");
  AddCmd( ({"setz","setze","sitz","sitze"})     , "cmd_sitzen");
  AddCmd( CMD_OEFFNEN                           , "cmd_oeffnen");
  AddCmd( ({"buerst","buerste"})                , "cmd_buersten");

  AddCmd("bad|bade&badewanne|wanne",
    "cmd_baden",
    "Worin moechtest Du baden?\n"
  );

  AddExit( "suedwesten"  ,
    ([EX_DEST : ROOM "eingang", EX_TESTFUNC : #'exit_test ])
  );

  haare = ({ });
  restore_object(ROOM "bad");
  grund_zustand();
}

void reset()
{
  ::reset();
  grund_zustand();
  return;
}

void wasserhahn_zu()
{
  hahn_zu = 1;
  AddRoomMessage(0);
  return;
}

void wasserhahn_auf()
{
  hahn_zu = 0;
  AddRoomMessage( ({ "*PLOPP*\n"}), 15, "geraeusch_zusatz" );
  return;
}

void grund_zustand()
{
  fliesen_nass = 0;
  wasserhahn_auf();
  spieler = ({ });
  spieler_haare = ({ });

  if(QueryProp(P_LIGHT))
  {
    SetProp(P_LIGHT, 0);
    tell_room(TO,"Die Kristallkugel an der Decke hoert auf zu leuchten.\n");
  }
  return;
}

void geraeusch_zusatz(int msg)
{
  if( (msg == 0) && (random(10) < 3) )
  {
    tell_room(this_object(), "Tropft da ein Wasserhahn?\n" );
  }
  return;
}

string tropfen(string key)
{
  if(hahn_zu)
  {
    return "Du kannst nichts besonderes hoeren.\n";
  }
  else
  {
    return "Das Tropfen des Wasserhahnes geht Dir ganz schoen auf die "
           "Nerven.\n";
  }
}

string constr(string s)
{
   if(s == getuid(TP)) return "Dir";

   return capitalize(s);
}

int exit_test(string str)
{
  object ob;

  if(!objectp(TP)) return 1;
  if(!interactive(TP)) return 1;
  if(!fliesen_nass) return 1;
  if(present("\nHUMPELN",TP)) return 1;

  TELLPLAYER(BS("Du rutscht auf den nassen Fliesen aus. *AUTSCH* Das hat "
                "weh getan. Zu allem Unglueck hast Du Dir auch noch den "
                "Fuss verstaucht. "
  ));

  TELLOTHERS(BS("Auweh. "+TPN+" rutscht auf den Fliesen aus und knallt "
                "voll auf den Fussboden. Das muss wehgetan haben. "
                "Schmerzverzerrt verzieht "+TPN+" "+TPPP(NEUTER,WESSEN,0)+
                " Gesicht.\n"
  ));

  ob=clone_object(OBJ "humpeln.lpc");
  ob->move(TP,M_GET|M_SILENT);
  TP->SetProp(P_TMP_MOVE_HOOK, ({time()+2700, ob, "humpeln"}) );
  MOORMASTER->Msg(TPUID+" ist im Bad gestuerzt");
  return 0;
}

int cmd_ziehen(string str)
{
  notify_fail("Woran willst Du ziehen?\n");

  if(!str || str == "") return 0;
  if(!(str == "an schnur")) return 0;

  if(TP->CannotSee(1))
  {
    TELLPLAYER("Du kannst leider nicht sehen, wo sich die Schnur "
               "befindet.\n");
    return -1;
  }

  if(QueryProp(P_LIGHT) == 0)
  {
    tell_object(TP, BS("Du ziehst kurz an der Schnur. Die Kristallkugel "
                       "an der Decke faengt an zu leuchten."));

    tell_room(TO, BS("Ploetzlich faengt etwas an der Decke an zu leuchten "
                     "und es wird hell."), ({TP}) );

    SetProp(P_LIGHT, 1);
  }
  else
  {
    tell_object(TP, BS("Du ziehst kurz an der Schnur. Die Kristallkugel "
                       "an der Decke hoert auf zu leuchten."));

    tell_room(TO, BS("Die Kristallkugel an der Decke hoert auf einmal"
                     "auf zu leuchten."), ({TP}) );

    SetProp(P_LIGHT, 0);
  }

  return 1;
}

int cmd_machen(string str)
{
  notify_fail("Willst Du etwas sauber machen?\n");
  if(!str || str == "") return 0;
  if(!(str == "sauber"      ||
       str == "bad sauber"  )) return 0;

  if(fliesen_nass)
  {
    TELLPLAYER("Schoen und gut - bloss wie?\n");
  }
  else
  {
    TELLPLAYER("Aber es ist doch sauber!\n");
  }
  return 1;
}

int cmd_baden(string str)
{
  TP->Message(BS("Abenteurer wie Du nehmen vielleicht einmal im Jahr ein "
                 "Bad. Wenn ueberhaupt. Und stell Dir vor, Oma Wetterwachs "
                 "kaeme dann herein!"), MSGFLAG_VISUAL);

  TO->Message(TP->Name(WER)+" betrachtet kurz die Badewanne.\n",
              MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}

int cmd_nehmen(string str)
{
  string wessen;
  int i,l;
  object ob;

  notify_fail("Was willst Du nehmen?\n");

  if(!str || str =="") return 0;

  if(str == "bad" || str == "ein bad")
  {
    return cmd_baden("in badewanne");
  }

  if(str == "eimer" || str == "lumpen" || str == "putzlumpen")
  {
    TELLPLAYER(BS("Lass das mal schoen hier, das wird Dir auf Deinen weiteren "
                  "Abenteuern nicht weiterhelfen."
    ));
    return 1;
  }

  if(str == "buerste" || str == "haarbuerste")
  {
    TELLPLAYER(BS("So eitel bist Du ja nun auch nicht, dass Du der armen "
                  "Oma auch noch die Haarbuerste klauen musst."
    ));
    return 1;
  }

  if(str == "haar"              ||
     str == "haare"             ||
     str == "haar aus buerste"  ||
     str == "haare aus buerste"  )
  {
    TELLPLAYER("Wessen Haare moechtest Du aus der Buerste nehmen?\n");
    return -1;
  }

             i = sscanf(str,"%s haare",wessen);
  if(i != 1) i = sscanf(str,"%s haar",wessen);
  if(i != 1) i = sscanf(str,"%s haar aus buerste",wessen);
  if(i != 1) i = sscanf(str,"%s haare aus buerste",wessen);
  if(i != 1) i = sscanf(str,"haare von %s aus buerste",wessen);
  if(i == 1)
  {
    if(wessen == "")
    {
      TELLPLAYER("Wessen Haare willst Du nehmen?\n");
      return -1;
    }

    if(wessen == "omas"                ||
       wessen == "oma wetterwachsens"  ||
       wessen == "oma"                 ||
       wessen == "oma wetterwachs"      )
    {
      if(member(spieler_haare,getuuid(TP)) > -1 || present("\nOMAHAAR", TP))
      {
        TELLPLAYER(BS("Du hast doch vorhin schon ein Haar von Oma "
                      "Wetterwachs genommen."));
        return -1;
      }

      TELLPLAYER("Du nimmst Dir ein Haar von Oma Wetterwachs aus der Buerste.\n");
      MOORMASTER->Msg(TPUID+" nimmt Haare von Oma Wetterwachs");
      spieler_haare += ({ getuuid(TP) });

      ob=clone_object(OBJ "haar");
      ob->SetProp(P_LONG, "Ein Haar. Es stammt von Oma Wetterwachs.");
      ob->AddId( ({"\nOMAHAAR","QUESTOBJ"}) );
      ob->move(TP,M_NOCHECK);

      return 1;
    }

    i = member(haare,wessen);
    if(i == -1){i = member(haare,wessen[0..<2]);}
    if(i == -1)
    {
      TELLPLAYER("Haare von dieser Person finden sich nicht in der Buerste.\n");
    }
    else
    {
      if(getuid(TP) == haare[i])
      {
        TELLPLAYER("Du hast genug eigene Haare auf dem Kopf.\n");
        return -1;
      }
      if(present("\n"+haare[i]+"haar",TP))
      {
        TELLPLAYER("Du hast schon ein Haar von "+capitalize(haare[i])+".\n");
        return -1;
      }
      TELLPLAYER("Du ziehst ein Haar aus der Buerste.\n");
      ob=clone_object( OBJ "haar" );
      ob->SetProp(P_LONG, "Ein Haar. Es stammt von "+capitalize(haare[i])+".");
      ob->AddId("\n"+haare[i]+"haar");
      if(haare[i] == "ronja")
      {
        ob->SetProp(P_VALUE, 1000000);
      }
      ob->move(TP,M_NOCHECK);
      MOORMASTER->Msg(TPUID+" nimmt Haare von "+capitalize(haare[i]));

    }
    return 1;
  }

  return 0;
}

int cmd_drehen(string str)
{
  string *woerter;
  string was,wie,rest;
  int n;

  woerter = explode(str, " ");
  switch(n = sizeof(woerter))
  {
    case 0  : was = ""        ; wie = ""        ; rest = ""; break;
    case 1  : was = woerter[0]; wie = ""        ; rest = ""; break;
    case 2  : was = woerter[0]; wie = woerter[1]; rest = ""; break;
    default :
      was = woerter[0];
      wie = woerter[1];
      rest = implode(woerter[2..]," ");
      break;
  }

  if(was == "wasserhahn"){was = "hahn";}

  notify_fail("Was willst Du drehen?\n");
  if(n==0){return 0;}
  if(was != "hahn"){return 0;}

  notify_fail("Willst Du den Wasserhahn auf oder zudrehen?\n");
  if(was == "hahn" && !(wie == "zu" || wie == "auf")){return 0;}

  if(wie == "zu")
  {
    TELLPLAYER(BS("Du drehst den Wasserhahn prompt falsch herum, das "
                  "Wasser schiesst aus dem Hahn heraus und spritzt Dich "
                  "total nass. Auch die Fliesen auf dem Boden sind nun "
                  "patschnass. Schnell drehst Du den Wasserhahn wieder zu."
    ));
    TELLOTHERS(BS(TPN+" dreht den Wasserhahn voll auf und spritzt Dich "
                  "ganz nass. Auch der Boden ist nicht verschont geblieben. "
                  "So ein Tolpatsch."
    ));
    fliesen_nass = 1;
    wasserhahn_auf();
    MOORMASTER->Msg(TPUID+" dreht den Wasserhahn auf");
  }

  if(wie == "auf")
  {
    if(!hahn_zu)
    {
      TELLPLAYER(BS("Du drehst den Wasserhahn prompt in die falsche "
                    "Richtung und drehst den Wasserhahn damit zu statt auf. "
                    "Wenigstens hoert das nervige Tropfen damit auf."));
      TELLOTHERS(BS(TPN+" fummelt am Wasserhahn herum und stellt endlich "
                    "das nervige Tropfen ab."));
      wasserhahn_zu();
      MOORMASTER->Msg(TPUID+" dreht den Wasserhahn zu");
    }
    else
    {
      TELLPLAYER(BS("Du drehst den Wasserhahn prompt in die falsche Richtung "
                    "und drehst den Wasserhahn damit zu statt auf. Doch der "
                    "Wasserhahn ist bereits zu, zu-er gehts nicht."));
    }
  }

  return 1;
}

int cmd_loesen(string str)
{
  notify_fail("Was willst Du loesen?\n");

  if(!str || str =="") return 0;
  if(!(str == "knoten")) return 0;

  TELLPLAYER(BS("Du fummelst an dem Knoten herum, aber es ist wie es ist: Du "
                "kannst ihn nicht loesen."));
  return 1;
}

int cmd_wischen(string str)
{
  string s,suffix;

  notify_fail("Was willst Du aufwischen?\n");

  if(!str || str =="") return 0;
  if(!(str == "fliesen auf"           ||
       str == "fliesen"               ||
       str == "boden"                 ||
       str == "boden auf"             ||
       str == "fussboden"             ||
       str == "fussboden auf"         ||
       str == "wasser"                ||
       str == "wasser auf"            ||
       str == "wasser mit lumpen auf" )) return 0;

  if(fliesen_nass)
  {
    TELLPLAYER(BS("Du nimmst den Putzlumpen aus dem Eimer und wischst die "
                  "nassen Fliesen auf. Ordentlich wie Du bist wringst Du "
                  "noch den Putzlumpen aus und legst ihn wieder in den Eimer."
    ));

    s = TPN+" nimmt den Putzlumpen aus dem Eimer, kniet nieder und wischt "
        "die Fliesen auf. Du wusstest gar nicht, dass sich ";

    suffix = "en.";
    switch(TP->QueryProp(P_RACE))
    {
      case "Mensch"    : s += "Menschen"; break;
      case "Elf"       : s += "Elfen"   ; break;
      case "Zwerg"     : s += "Zwerge"; break;
      case "Hobbit"    : s += "Hobits"; break;
      case "Troll"     : s += "Trolle"; break;
      case "Fee"       : s += "Feen"; break;
      case "Oger"      : s += "Oger"; break;
      case "Dunkelelf" : s += "Dunkelelfen"; break;
      default          : s += TPN; suffix="t."; break;
    }

    s += " auf so etwas versteh"+suffix+" Kurz danach wringt "+
         TPN+" den Lumpen noch aus und legt ihn wieder in den Eimer.";

    TELLOTHERS(BS(s));
    fliesen_nass = 0;
    MOORMASTER->Msg(TPUID+" putzt das Bad");

  }
  else
  {
    TELLPLAYER("Hier gibt es nichts aufzuwischen.\n");
  }

  return 1;
}

int cmd_oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;
  if(!(str == "schatulle")) return 0;

  TELLPLAYER(BS("Die Schatulle ist verschlossen. Du hast auch keinen "
                "passenden Schluessel dabei."));
  return 1;
}

int cmd_sitzen(string str)
{
  notify_fail("Worauf willst Du sitzen?\n");

  if(!str || str == "");
  if(!(str == "auf schemel"      ||
       str == "dich auf schemel" )) return 0;

  TELLPLAYER(BS("Du setzt Dich auf den kleinen Schemel, aber der kann Dein "
                "Gewicht nicht tragen und bricht unter Dir zusammen. "
                "Verstohlen stehst Du wieder auf und baust verschaemt den "
                "Schemel wieder zusammen."
  ));
  TELLOTHERS(BS(TPN+" setzt sich auf den kleinen Schemel, der aber unter "+
                TP->QueryPossPronoun(NEUTER,WEM,0)+" Gewicht zusammenbricht. "
                "Verstohlen schaut "+TP->QueryPronoun(WER)+" sich um und "
                "baut den Schemel wieder zusammen."
  ));
  MOORMASTER->Msg(TPUID+" setzt sich auf den Schemel");
  return 1;
}

int cmd_buersten(string str)
{
  notify_fail("Was willst Du buersten?\n");

  if(!str || str == "") return 0;
  if(!(str == "haar"   ||
       str == "haare"  )) return 0;

  if(TP->QueryProp(P_FROG))
  {
    TELLPLAYER("Du bist viel zu klein, um an die Buerste heranzukommen.\n");
    return -1;
  }

  if(present("\nfeuerelementar_enthaare", TP))
  {
    TELLPLAYER("Aber Du bist doch voellig enthaart!\n");
    return -1;
  }

  if(member(spieler,getuuid(TP)) == -1)
  {
    TELLPLAYER(BS("Du nimmst die Haarbuerste vom Regal und buerstest Dir "
                  "Deine Haare. Das ziept ganz schoen, solltest Du "
                  "vielleicht oefter machen."));

    spieler += ({ getuuid(TP) });
  }
  else
  {
    TELLPLAYER(BS("Du nimmst die Haarbuerste vom Regal und buerstest Dir "
                  "Deine Haare. Da Du sie Dir jedoch vor kurzer Zeit schon "
                  "gebuerstet hast, nutzt das im Moment nicht viel."));
  }

  TELLOTHERS(BS(TPN+" buerstet sich die Haare. Du wusstest gar nicht, wie "
                "eitel " + TP->QueryPronoun(WER)+" ist."));

  if(member(haare,getuid(TP)) > -1)
  {
    return -1;
  }

  if(sizeof(haare) < 5)
  {
    haare += ({ getuid(TP) });
  }
  else
  {
    haare = haare[<4..] + ({ getuid(TP) });
  }
  save_object(ROOM+"bad");
  MOORMASTER->Msg(TPUID+" buerstet sich die Haare");
  return 1;
}

string detail_fliesen(string str)
{
  string s;

  s = "Damit man das Bad leicht sauber machen kann, sind der Boden "
      "und die Waende gefliest. ";

  if(fliesen_nass)
  {
    s += "Allerdings hat irgendjemand hier mit Wasser herumgespielt, so dass "
         "die Fliesen auf dem Fussboden nun nass und rutschig sind.";
  }

  return BS(s);
}

string detail_hahn(string str)
{
  string s;

  s = "Oma Wetterwachs scheint den Luxus von fliessendem Wasser zu haben. "
      "Wasserleitungen sind im Silberland extrem selten, aber hier sind "
      "sowohl in der Kueche als auch im Badezimmer fliessend Wasser "
      "vorhanden. ";

  if(!hahn_zu)
  {
    s += "Allerdings scheint der Wasserhahn nicht ganz dicht zu sein. ";
  }

  return BS(s);
}

string detail_haare(string str)
{
  int i,n;
  string s;

  n = sizeof(haare);
  if(n == 0)
  {
    s = "Hmmm, in der Buerste befinden sich noch ein paar Haare von Oma "
        "Wetterwachs.";
  }
  else
  {
    s = "In der Buerste befinden sich einige Haare von Oma Wetterwachs. "
        "Aber Moment mal... Da sind auch andere Haare dazwischen. Hmmm, "
        "sieht so aus als... Ja richtig, da sind auch Haare von ";
    s += constr(haare[0]);

    for(i=1;i<n-1;i++)
    {
      s += ", " + constr(haare[i]);
    }
    if(n>1)
    {
      s += " und "+constr(haare[n-1]);
    }
    s += " dazwischen.";
  }
  return BS(s);
}
