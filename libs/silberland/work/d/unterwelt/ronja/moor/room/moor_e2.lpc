#include "../def.h"

inherit ROOM "moor_inh.lpc" ;

int boese;
int leiche;
int heilung;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "An einem kleinen Moorsee" );
  SetProp( P_INT_LONG,
    "Du stehst vor einem kleinen Moorsee. Tiefschwarz liegt der See vor "
    "Dir, nicht eine Welle kraeuselt seine Oberflaeche. Schwer und "
    "bedrueckend ist die Atmosphaere hier. War es im uebrigen Moor bisher "
    "schon unheimlich, so liegt foermlich eine Spannung in der Luft, als ob "
    "etwas Furchtbares diese truegerische Stille jederzeit zerreissen "
    "koennte."
  );

  AddDetail( ({"luft","lueftchen"}) ,
    "Die Luft ist kuehl und frisch."
  );

  AddDetail( ({"stille"}) ,
    "Du kannst absolut nichts hoeren."
  );

  AddDetail( ({"atmosphaere"}) ,
    "Es ist absolut still hier. Zu still, eher truegerisch."
  );

  AddDetail( ({"welle","wellen"}) ,
    "Absolut ruhig liegt der See vor dir. Und da kein Lueftchen geht, gibt "
    "es auch keine Wellen auf dem See. Um Wellen zu sehen, muesstet Du "
    "schon etwas in den See hineinwerfen."
  );

  AddDetail( ({"see","moorsee"}) ,
    "Du stehst an einem kleinen, tiefschwarzen See. Angeblich soll ein "
    "Moorbad ja sehr gesund sein, aber ob diese Stille hier nicht "
    "truegerisch ist?"
  );

  AddDetail( ({"oberflaeche"}) ,
    "Keine Welle und kein Lueftchen kraeuseln die Oberflaeche."
  );

  AddDetail( ({"bad","moorbad"}) ,
    "In der dunklen, stinkigen Bruehe willst Du ein Bad nehmen?"
  );

  AddDetail( ({"bruehe"}) ,
    "Anders kann man das nicht bezeichnen."
  );

  AddDetail( ({"ufer"}) ,
    "Am Ufer sieht Du ein paar Kieselsteine liegen."
  );

  AddDetail( ({"steine","kieselsteine","stein","kieselstein"}) ,
    "Ganz normale Kieselsteine. Ein wenig schmutzig, aber sonst kannst Du "
    "nichts besonderes daran erkennen."
  );

  AddDetail( ({"furchtbares"}) ,
    "Da denkst Du lieber nicht dran."
  );

  AddSound( DEFAULT_SOUND, "Es ist absolut still hier.");

  AddSmell( DEFAULT_SMELL, "Der Moorsee vor Dir stinkt ganz schoen.");

  AddSpecialExit( "norden"      , "keinausgang"  );
  AddSpecialExit( "nordosten"   , "keinausgang"  );
  AddExit(        "osten"       , ROOM "moor_f2" );
  AddExit(        "suedosten"   , ROOM "moor_f3" );
  AddExit(        "sueden"      , ROOM "moor_e3" );
  AddExit(        "suedwesten"  , ROOM "moor_d3" );
  AddExit(        "westen"      , ROOM "moor_d2" );
  AddSpecialExit( "nordwesten"  , "keinausgang"  );

  AddCmd( CMD_BADEN,  "cmd_baden");
  AddCmd( CMD_NEHMEN, "cmd_nehmen");
  AddCmd( CMD_WERFEN, "cmd_werfen");

  boese     = random(100) < 30;
  if(boese)
  {
    leiche  = 1;
    heilung = 0;
  }
  else
  {
    leiche  = 0;
    heilung = 1;
  }

  AddItem(NPC "drachenlibelle.lpc", REFRESH_DESTRUCT);
}

void reset()
{
  ::reset();

  boese     = random(100) < 30;
  if(boese)
  {
    leiche  = 1;
    heilung = 0;
  }
  else
  {
    leiche  = 0;
    heilung = 1;
  }
}

int cmd_baden(string str)
{
  object moorleiche;

  notify_fail("Worin willst Du baden?\n");

  if(!str || str == "") return 0;
  if(!(str == "in see"       ||
       str == "im see"       ||
       str == "im moorsee"   ||
       str == "in moorsee"   )) return 0;

  if(boese && leiche)
  {
    TELLPLAYER(BS("Da Du gehoert hast, dass Moorbaeder ganz gesund sein "
       "sollen, machst Du Dich daran, im See zu baden. Doch gerade als Du "
       "einen Fuss in den See steckst, faengt sich die Oberflaeche an zu "
       "kraeuseln. Schnell ziehst Du Deinen Fuss wieder zurueck und harrst "
       "der unheilvollen Dingen, die sich da ankuendigen."
    ));
    leiche = 0;
    moorleiche=clone_object(NPC "moorleiche");
    moorleiche->move(TO,M_GO,"aus dem Moorsee"
                            ,"steigt","steigt aus dem Moorsee");
    MOORMASTER->Msg(TPUID+" badet im boesen Moorsee");

    return -1;
  }

  if(heilung)
  {
    TELLPLAYER(BS("Da Du gehoert hast, dass Moorbaeder ganz gesund sein "
      "sollen, machst Du Dich daran, im See zu baden. Du steigst in die "
      "schwarze Bruehe, und fuehlst Dich tatsaechlich erfrischt und "
      "erholt. Du steigst aus dem Moorsee heraus und das ganze Moor perlt "
      "von Dir ab. Wirklich erstaunlich, Du bist ueberhaupt nicht "
      "schmutzig."
    ));
    heilung = 0;
    TP->AddHp(175);
    TP->AddSp(175);
    MOORMASTER->Msg(TPUID+" badet im guten Moorsee");

    return 1;
  }

  TELLPLAYER(BS("Da Du gehoert hast, dass Moorbaeder ganz gesund sein "
    "sollen, machst Du Dich daran, im See zu baden. Du steigst in die "
    "schwarze Bruehe, aber irgendeine Wirkung kannst Du nicht fest"
    "stellen. Du steigst aus dem Moorsee heraus und das ganze Moor "
    "perlt von Dir ab. Wirklich erstaunlich, Du bist ueberhaupt nicht "
    "schmutzig."
  ));
  MOORMASTER->Msg(TPUID+" badet umsonst im Moorsee");

  return -1;
}

int cmd_nehmen(string str)
{
  string s, msg;

  notify_fail("Was willst Du nehmen?\n");

  if(!str || str == "") return 0;
  if(str == "moorbad" || str == "bad")
  {
    return cmd_baden("in see");
  }

  if(!(str == "stein" || str == "kieselstein")) return 0;

  s = "Du nimmst einen Kieselstein, der am Ufer herumliegt, betrachtest ihn "
      "einen kurzen Augenblick und wirfst ihn dann in den Moorsee. Mit "
      "einem dumpfen *PLOMP* versinkt er darin. ";

  if(boese && leiche)
  {
    s += "Da siehst Du, wie eine Hand aus dem Moor hervorkommt. Schnell "
         "duckst Du Dich nieder und siehst wie sich eine Moorleiche aus "
         "dem See erhebt. Anscheinend kann sie Dich aber nicht sehen und "
         "verschwindet nach einer Weile wieder.";
    msg = TPUID+" wirft einen Kieselstein in den boesen Moorsee";
  }
  else
  {
    s += "Ein paar Wellen versuchen sich auszubreiten, doch das Moor "
         "erstickt jede Wellenbewegung im Keim.";
     msg = TPUID+" wirft einen Kieselstein in den guten Moorsee";
  }

  TELLPLAYER(BS(s));
  TELLOTHERS(TPN+" wirft einen Kieselstein in den Moorsee.\n");
  MOORMASTER->Msg(msg);

  return 1;
}

int cmd_werfen(string str)
{
  int n;
  string was,wohin,s,msg;
  object ob;

  notify_fail("Was moechtest Du in den See werfen?\n");

  if(!str || str == "") return 0;
  n = sscanf(str, "%s in %s", was, wohin);
  if(n != 2) return 0;

  if(!(wohin == "see"            ||
       wohin == "moorsee"        ||
       wohin == "see hinein"     ||
       wohin == "moorsee hinein" )) return 0;

  if(!ob=present(was,TP))
  {
    if(deep_present(was,TP))
    {
      TELLPLAYER(BS("Wenn Du etwas in den See werfen willst, solltest Du "
                    "es auch in den Haenden halten."
      ));
    }
    else
    {
      TELLPLAYER("Sowas hast Du doch gar nicht bei Dir.\n");
    }
    return 1;
  }

  if(( ob->QueryProp(P_CURSED))    ||
     ( ob->QueryProp(P_NEVERDROP)) ||
     ( ob->id("QUESTOBJ"))         ||
     ( ob->QueryProp(P_NODROP))    ||
     (!ob->QueryProp(P_SHORT))     ||
     ( ob->QueryProp(P_INVIS))     ||
     (!ob->QueryProp(P_NAME))       )
  {
    TELLPLAYER("Davon willst Du Dich gar nicht trennen.\n");
    return 1;
  }

  ob->id(was); // P_REQUESTED_AMOUNT wieder geradestellen

  s = "Du wirfst "+ob->name(WEN)+" in den See. Mit einem leisen *PLOMP* "
      "entstehen ein paar kleinere Wellen, die es aber noch nicht einmal "
      "bis zum Ufer schaffen. ";

  msg = TPUID+" wirft "+ob->name(WEN)+" in den guten Moorsee";

  if(boese && leiche)
  {
    s += "Da siehst Du, wie eine Hand aus dem Moor hervorkommt. Schnell "
         "duckst Du Dich nieder und siehst wie sich eine Moorleiche aus "
         "dem See erhebt. Anscheinend kann sie Dich aber nicht sehen und "
         "verschwindet nach einer Weile wieder.";

    msg = TPUID+" wirft "+ob->name(WEN)+" in den boesen Moorsee";
  }

  TELLPLAYER(BS(s));
  TELLOTHERS(BS(TPN+" wirft "+ob->name(WEN)+" in den Moorsee.\n"));

  MOORMASTER->Msg(msg);
  ob->remove();

  return 1;
}
