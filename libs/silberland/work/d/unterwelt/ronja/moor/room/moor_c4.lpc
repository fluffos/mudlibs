#include "../def.h"

inherit ROOM "moor_inh.lpc" ;

void create()
{
  ::create();

  AddExit(        "norden"      , ROOM "moor_c3" );
  AddExit(        "nordosten"   , ROOM "moor_d3" );
  AddExit(        "osten"       , ROOM "moor_d4" );
  AddSpecialExit( "suedosten"   , "keinausgang"  );
  AddExit(        "sueden"      , ANSCHLUSS      );
  AddSpecialExit( "suedwesten"  , "keinausgang"  );
  AddExit(        "westen"      , ROOM "moor_b4" );
  AddSpecialExit( "nordwesten"  , "keinausgang"  );

}

