#include "../def.h"

inherit ROOM "moor_inh.lpc" ;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Moorkuhle.");
  SetProp(P_INT_LONG,
    "Du stehst in einer Moorkuhle. Frueher wuerde hier noch viel Torf "
    "gestochen, aber dies scheint nun vorbei zu sein. Allerdings deuten ein "
    "paar Spuren im Moor daraufhin, dass sich hier jemand ab und an "
    "vielleicht doch noch etwas Torf sticht."
  );

  AddDetail( ({"moor"}) ,
    "Rund um Dich ist ueberall Moor. Allerdings scheint dies hier die "
    "geeignetste Stelle zu sein, um Torf zu stechen."
  );

  AddDetail( ({"torf","torfsoden","soden"}) ,
    "Hier ist wohl die beste Stelle, um Torf zu stechen. Der Torf ist zwar "
    "arg nass, aber wenn er getrocknet worden ist, gibt er bestimmt prima "
    "Duenger oder Brennmaterial ab."
  );

  AddDetail( ({"kuhle","moorkuhle"}) ,
    "Du stehst mittendrin."
  );

  AddDetail( ({"spur","spuren","fussspuren","fussspur"}) ,
    "Fussspuren. Hier hat wohl jemand vor kurzem noch Torf gestochen. "
    "Teilweise haben sich die Spuren mit Wasser gefuellt."
  );

  AddDetail( ({"wasser","wasserpfuetze","wasser"}) ,
    "In den Spuren hat sich bereits Wasser gesammelt. Tiefschwarz steht "
    "es darin. Du kannst darin Dein Spiegelbild betrachten."
  );

  AddDetail( ({"spiegelbild","bild"}) ,
    "Du kannst es betrachten, wenn Du wirklich so eitel bist."
  );

  AddDetail( ({"duenger"}) ,
    "Torf ist auch ein ideales Duengemittel, aber da das stechen von Torf "
    "fuer ein Moor eher problematisch ist, sollte man zum Duengen eher "
    "andere Mittel verwenden und Torf wirklich nur noch stechen, wenn es "
    "anders nicht geht."
  );

  AddDetail( ({"brennmaterial"}) ,
    "Torf ist zwar kein besonders gutes Brennmaterial, aber ein Stueck Torf "
    "brennt ziemlich lange, wenn es einmal angezuendet wurde."
  );

  AddDetail( ({"duengemittel","mittel"}) ,
    "Da fragst Du am besten Blu Menerde, der ist Gaertner."
  );

  AddDetail( ({"blu","blu menerde","menerde","gaertner"}) ,
    "Blu Menerde ist der beste Gaertner im ganzen Silberland. Er wohnt weit "
    "weg im Gebirge."
  );

  AddDetail( ({"silberland"}) ,
    "Du bist mittendrin. Gehe hinaus und erforsche es !"
  );

  AddDetail( ({"gebirge"}) ,
    "Ich wuerd sagen, das Gebirge befindet sich nord-nordoestlich von hier. "
    "Von hier aus kannst Du grade mal die hoechsten Gipfel erahnen."
  );

  AddDetail( ({"gipfel"}) ,
    "Die lassen sich gerade mal erahnen."
  );

  AddCmd( CMD_TRINKEN                  , "cmd_trinken" );
  AddCmd( ({"betrachte","betrachten"}) , "cmd_betrachten");

  AddSpecialExit( "raus"        , "exit_raus"    );

}

int moor_ist_da()
{
  return 2;
}

int exit_raus(string dir)
{
  object torf;

  if(!random(5))
  {
    TELLPLAYER(BS("Ohje, durch Deine Versuche herauszuklettern "
                  "sinkst Du nur noch tiefer ein."));
    TELLOTHERS(BS(TPN+" versucht aus der Kuhle zu klettern, aber "
                      "versinkt nur noch mehr im Moor."));
    return 1;
  }

  while(torf=present("\nTORFNASS", TP)) // if ->while mann kann ja mehrer torfe dabei haben (feyaria)
  {
    TELLPLAYER(BS("Als Du den Rand der Kuhle erklimmst, um daraus "
      "herauszuklettern, entgleitet Dir der Torf wieder. Er bricht "
      "auseinander und die Reste kullern wieder hinunter in die Kuhle."
    ));
    torf->remove();
  }

  TP->move(ROOM "moor_b4", M_GO, "aus der Kuhle", "klettert",
                                 "kommt aus der Kuhle heraus");
  return 1;
}

int cmd_trinken(string str)
{
  notify_fail("Was willst Du trinken?\n");

  if(!str || str == "") return 0;
  if(!(str == "wasser"           ||
       str == "wasser aus kuhle" )) return 0;

  TELLPLAYER("Uuuuhhh, das Wasser war total brackig und abgestanden.\n");
  TP->AddPoison(3);
  return 1;
}

int cmd_betrachten(string str)
{
  notify_fail("Was willst Du betrachten?\n");

  if(!str || str == "") return 0;
  if(!(str == "spiegelbild"         ||
       str == "mein spiegelbild"    ||
       str == "da spiegelbild"      )) return 0;

  TELLPLAYER("Du betrachst eitel Dein eigenes Spiegelbild und erkennst "
             "... Dich.\n");

  TELLOTHERS(BS(TPN+" betrachtet total eitel "+TPPP(NEUTER,WEN,SINGULAR)+
                 " eigenes Spiegelbild in einer Wasserpfuetze."));
  return 1;
}
