#include "../def.h"

inherit "/std/room";

#define PAUSE 8
#define LF "\n\n"

int haare;
int feuer;
int dampf;

string obwen;
string obwer;
string obname;
string *obids;
string obfile;

void feuerstatus(int x);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer merkwuerdigen Bibliothek" );

  dampf = 0;
//SetProp(P_INT_LONG, "\t@@longdesc@@" );

  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"wand","waende"}) ,
    "Die Waende bestehen aus hartem Felsgestein. Von der alten Huette "
    "ist keine Spur mehr zu sehen. "
  );

  AddDetail( ({"spur"}) ,
    "Nichts deutet daraufhin, dass Du Dich in einem Hexenhaus befindest. "
    "Irgendwas muss passiert sein, als Du durch die Tuer gekommen bist. "
  );

  AddDetail( ({"nichts"}) ,
    "Du untersuchst nichts. Und findest: Nichts."
  );

  AddDetail( ({"felsen","felsgestein","fels","gestein","steine","stein"}) ,
    "Granithartes Felsgestein. Da hat graben wohl keinen Sinn."
  );

  AddDetail( ({"sinn","sinne"}) ,
    "Streng Deine 7 Sinne mal an, um hinter das Geheimnis dieser Bibliothek "
    "zu kommen. "
  );

  AddDetail( ({"geheimnis"}) ,
    "Diese Bibliothek hat sicherlich eines, bloss welches?"
  );

  AddDetail( ({"granit"}) ,
    "So hart wie das Felsgestein ist, muss es wohl aus Granit bestehen."
  );

  AddDetail( ({"boden"}) ,
    "Auch der Boden besteht aus hartem Felsen, der nur grob behauen "
    "wurde und somit reichlich uneben ist. Wasser hat sich in diversen "
    "Pfuetzen gesammelt. "
  );

  AddDetail( ({"pfuetze","pfuetzen"}) ,
    "Am Boden hat sich das Wasser in einigen Pfuetzen gesammelt."
  );

  AddDetail( ({"pfuetzenwasser","kesselwasser","stalaktitwasser"}) ,
    "Hmmm, naja. Wasser halt. Einfaches Wasser."
  );

  AddDetail( ({"decke"}) ,
    "Felsen, nichts als Felsen. An einer Stelle hat sich ein kleiner "
    "Stalaktit gebildet."
  );

  AddDetail( ({"stelle","stalaktit"}) ,
    "Ein kleiner Stalaktit hat sich an der Decke gebildet. An seiner "
    "Spitze haengt ein Wassertropfen."
  );

  AddDetail( ({"spitze","wassertropfen","tropfen"}) ,
    "Durch diese ewige Tropferei hat sich der Stalaktit ueberhaupt erst "
    "gebildet. Das Wasser hier scheint ziemlich kalkhaltig zu sein."
  );

  AddDetail( ({"tropferei"}) ,
    "Wenigstens fallen die Tropfen recht lautlos herab, denn so eine "
    "ewige Tropferei kann einem ganz schoen auf die Nerven gehen. "
  );

  AddDetail( ({"nerven"}) ,
    "Die wuerden ganz schoen blank liegen, wenn man diese ewige Tropferei "
    "auch noch hoeren koennte. "
  );

  AddDetail( ({"zimmer"}) ,
    "Eigentlich hattest Du ja ein Zimmer erwartet, doch ganz bestimmt keine "
    "feuchte, dunkle Hoehle."
  );

  AddDetail( ({"waschkueche"}) ,
    "Der Kessel in der Mitte der Hoehle erinnert Dich ein wenig an eine "
    "Waschkueche. Doch eine Waschkueche sieht normalerweise anders aus, "
    "ausserdem stand Bibliothek aussen an der Tuer."
  );

  AddDetail( ({"bibliothek"}) ,
    "Alles was eine Bibliothek ausmacht, fehlt hier. Und das wichtigste "
    "natuerlich auch: Du siehst nicht ein einziges Buch."
  );

  AddDetail( ({"buch","buecher"}) ,
    "Schon komisch, draussen steht Bibliothek dran, aber Du siehst hier kein "
    "einziges Buch. Ehrlich gesagt, ist es auch viel zu feucht hier drin "
    "und Buecher wuerden hier sehr schnell vermodern. "
  );

  AddDetail( ({"huette"}) ,
    "Vorhin warst Du noch in der Huette von Oma Wetterwachs. Diese Tuer "
    "muss etwas besonderes sein."
  );

  AddDetail( ({"oma","wetterwachs","oma wetterwachs"}) ,
    "Oma Wetterwachs ist im Moment nicht hier."
  );

  AddDetail( ({"moment"}) ,
    "Zack - vorbei."
  );

  AddDetail( ({"wasser"}) ,
    "Moechtest Du das Stalaktitwasser, das Pfuetzenwasser oder das Kessel"
    "wasser untersuchen?"
  );

  AddDetail( ({"mitte"}) ,
    "In der Mitte der Hoehle steht auf drei Steinen ein grosser Kessel. "
  );

// brennbare sachen : zunder der koehler, gebuesch vom hasenbraten und
// feuerholz beim dschungelwaechter

  AddSpecialDetail( ({"steine","steinen"}) , "detail_steine" );

  AddDetail( ({"hoehle","felshoehle","raum"}) , QueryProp(P_INT_LONG) );

  AddDetail( ({"kessel"}) ,
    "Der Kessel besteht aus einem merkwuerdigen, roten Metall. Er ist "
