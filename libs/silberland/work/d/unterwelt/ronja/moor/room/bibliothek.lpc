  );

  AddDetail( ({"beule"}) ,
    "An einer der Beulen siehst Du eine merkwuerdige, dunkelbraune Masse."
  );

  AddDetail( ({"masse"}) ,
    "Sieht aus wie eingetrocknetes Blut. Ob sich da jemand den Kopf "
    "angeschlagen hat? "
  );

  AddDetail( ({"kopf"}) ,
    "Deiner ist noch da. Noch."
  );

  AddSpecialDetail( ({"blut"}) , "detail_blut");

  AddSpecialDetail( ({"haar","haare"}) , "detail_haare" );

  AddDetail( ({"glatze"}) ,
    "Zum Glueck hast Du noch keine."
  );

  AddDetail( ({"unglueckliche"}) ,
    "Das laesst sich jetzt nicht mehr so ohne weiteres feststellen, "
    "wer das nun war. "
  );

  AddDetail( ({"metall"}) ,
    ([0: "Das Metall glaenzt rot, so etwas hast Du bisher noch nicht gesehen.",
     "zwerg": "Es ist eindeutig Kupfer."])
  );

  AddDetail( ({"kupfer"}) ,
    ([0: "Was soll das denn sein?",
      "zwerg": "Du siehst nichts besonderes am Kupfer."])
  );

  AddDetail( ({"kratzer"}) ,
    "Einige Kratzer scheinen lediglich Gebrauchsspuren zu sein, "
    "andere sehen mehr aus wie fremdartige Schriftzeichen. "
  );

  AddDetail( ({"gebrauchsspuren","gebrauch","spuren"}) ,
    "Durch den staendigen Gebrauch des Kessels hat er eine Menge Kratzer und "
    "Beulen abbekommen. "
  );

  AddDetail( ({"menge"}) ,
    "Es sind mehr Kratzer am Kessel, als Du zu zaehlen gewillt bist. "
  );

  AddDetail( ({"schriftzeichen","zeichen"}) ,
    "Das was Du fuer Schriftzeichen haeltst, laeuft aussen auf dem Rand des "
    "Kessels herum, was Dich nur noch bestaerkt, dass hier geheime Saetze "
    "eingraviert sind. "
  );

  AddDetail( ({"rand"}) ,
    "Der Rand des Kessels ist wulstartig nach aussen gebogen, damit man das "
    "Wasser besser ausschuetten kann. "
  );

  AddDetail( ({"saetze"}) ,
    "Die Schriftzeichen sind zu Saetzen und Woertern gruppiert."
  );

  AddDetail( ({"woerter","woertern"}) ,
    "Da die Schriftzeichen in einer fremden Sprache sind, kannst Du sie "
    "natuerlich nicht verstehen."
  );

  AddDetail( ({"sprache"}) ,
    "Die Sprache ist Dir voellig unbekannt. Ob es wohl keine "
    "Schriftzeichen, sondern magische Symbole sind?"
  );

  AddDetail( ({"symbole","symbol"}) ,
    "Die Symbole haben merkwuerdige Formen."
  );

  AddDetail( ({"formen","form"}) ,
    "Es gibt geschwungene, gerade, kreisfoermige, unfoermige und noch viel "
    "viel mehr Formen. Eine Form sieht sogar aus wie eine Schlange. "
  );

  AddDetail( ({"geschwungene form"
              ,"gerade Form"
              ,"kreisfoermige Form"
              ,"unfoermige Form"}) ,
    "Diese Formen sehen aus wie gewoehnliche Kratzer. "
  );

  AddDetail( ({"schlange","schlangenlinie","schlangenlinien"}) ,
    "Eine der Formen erregt Deine Aufmerksamkeit, denn sie hat die Form "
    "einer Schlange. Natuerlich nur angedeutet. Es koennte natuerlich auch "
    "eine Blindschleiche sein. "
  );

  AddDetail( ({"aufmerksamkeit"}) ,
    "Die brauchst Du, um hinter das Raetsel der Schriftzeichen zu kommen."
  );

  AddDetail( ({"raetsel"}) ,
    "Mit diesem Kessel hat es bestimmt etwas Besonderes auf sich."
  );

  AddDetail( ({"besonderes"}) ,
    "Das versuchst Du ja gerade herauszubekommen."
  );

  AddDetail( ({"phantasie"}) ,
    "Hoffentlich geht die nicht mit Dir durch."
  );

  AddDetail( ({"blindschleiche"}) ,
    "Naja, da geht Deine Phantasie wohl etwas mit Dir durch. Denn wenn Du "
    "es Dir genau ueberlegst, dann sieht es lediglich wie eine Wellenlinie "
    "aus. "
  );

  AddDetail( ({"wellenlinie","linie"}) ,
    "Als Du so ganz intensiv die Wellenlinie untersuchst, entdeckst Du "
    "einige Unregelmaessigkeiten in den Schwuengen. "
  );

  AddDetail( ({"schwung","schwuenge","schwuengen"}) ,
    "Das Auf und Ab in der Wellenlinie bezeichnet man auch als Schwung. "
    "Du kannst einige Unregelmaessigkeiten darin entdecken. "
  );

  AddDetail( ({"unregelmaessigkeit","unregelmaessigkeiten"}) ,
    "Links und rechts der Wellenlinie sind noch haarfeine Striche "
    "zu erkennen. Allerdings nur fuer das geuebte Auge. "
  );

  AddDetail( ({"auge"}) ,
    "Du hast ein geuebtes Auge, sonst waeren Dir ja nicht die "
    "Unregelmaessigkeiten aufgefallen. "
  );

  AddDetail( ({"striche"}) ,
    "Ob die Striche wirlich eine Bedeutung haben? Dir scheint es jedoch, "
    "als ob die Striche kuenstlichen Ursprungs sind. "
  );

  AddDetail( ({"bedeutung"}) ,
    "Du bist Dir nicht darueber im klaren, ob die Striche an der "
    "Wellenlinie der Symbole, die Du fuer Schriftzeichen hieltest und Dir "
    "erst wie Schlangenlinien vorkamen, laengs des Randes des Kessels auf "
    "den Steinen in der Hoehle des Hexenhauses im Moor eine Bedeutung "
    "haben. "
  );

  AddDetail( ({"moor"}) ,
    "Wenn Du das Moor untersuchen moechtest, dann geh hinein. "
    "Beziehungsweise hinaus. Von hieraus ist das eher schwierig. "
  );

  AddDetail( ({"hexenhaus","hexenhauses"}) ,
    "Du bist Dir ziemlich sicher, dass diese Hoehle nicht im Hexenhaus "
    "ist. Anscheinend ist die Tuer etwas besonderes. "
  );

  AddDetail( ({"ursprung","ursprungs"}) ,
    "Der Ursprung der Striche ist mit ziemlicher Sicherheit kuenstlich."
  );

  AddDetail( ({"sicherheit"}) ,
    "So langsam bekommst Du Zweifel, ob die Striche natuerlichen "
    "oder kuenstlichen Ursprungs sind. "
  );

  AddDetail( ({"zweifel"}) ,
    "Nein, diese Striche muessen kuenstlichen Ursprungs sein und damit "
    "irgendeine Bedeutung haben. Die Knicke in den Strichen sind "
    "ausserordentlich exakt. "
  );

  AddDetail( ({"knicke"}) ,
    "Die Knicke, welche seitwaerts an den Strichen zu finden sind, "
    "haben einen Winkel von 90 Grad."
  );

  AddDetail( ({"grad","winkel"}) ,
    "Soweit Du es feststellen kannst, sind es 90 Grad."
  );

/*
Feuer, Beulen, Auf, Asche, Anfang, Ab

*/

  AddCmd( ({"schuett","schuette"})          , "cmd_schuetten" );
  AddCmd( ({"grab","grabe"})                , "cmd_graben" );
  AddCmd( ({"stolper","stolpere"})          , "cmd_stolpern" );
  AddCmd( ({"reiss","reisse"})              , "cmd_reissen" );
  AddCmd( ({"leg","lege","steck","stecke"}) , "cmd_legen" );
  AddCmd( ({"zuend","zuende"})              , "cmd_anzuenden" );
  AddCmd( CMD_NEHMEN                        , "cmd_nehmen");
  AddCmd( CMD_SAGEN                         , "cmd_spruehen1");
  AddCmd( ({"feuer"})                       , "cmd_spruehen2");
  AddCmd( CMD_UNTERSUCHEN                   , "cmd_untersuchen");

  NewDoor( ({"norden"}), ROOM "eingang" , ({"tuer","eingang"}) ,
    ({D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME, "Tuer"
     ,D_GENDER, FEMALE
     ,D_SHORT, "Eine %se Tuer."
     ,D_LONG, "Durch diese Tuer kannst Du diese merkwuerdige Bibliothek "
              "wieder verlassen."
     ,D_MSGS,    ({"hinaus","geht","kommt herein"})
     ,D_OPENMSG, ({"Du oeffnest die Tuer.",
                   "%s oeffnet die Tuer.",
                  " schwingt auf, als ob sie von innen geoffnet wuerde."})
     ,D_CLOSEMSG, ({"Du schliesst die Tuer.",
                    "%s schliesst die Tuer.",
                    " wird von innen geschlossen."})
     ,D_RESET_CLOSEMSG, " schliesst sich wie von Geisterhand."
     })
  );

  haare = 3;
  feuerstatus(0);
}

void init()
{
  ::init();

  if(TP && interactive(TP)) call_out("MakeSomething",0,TP);
}

void reset()
{
  ::reset();
  haare = 3;
}

string _query_int_long()
{
  string s,sd;

  if(dampf)
  {
    s = "Dichte Dampfschwaden nehmen Dir die Sicht.";
  }
  else
  {
    s = "Hoppla, stand da an der Tuer nicht etwas von Bibliothek? Das hier "
        "sieht noch nicht einmal wie ein Zimmer aus. Du befindest Dich in "
        "einer mittelgrossen Felshoehle, in der Mitte steht ein grosser "
        "Kessel. Wenn das ein ordentlicher Raum waere und gefliest, "
        "koennte es eine Waschkueche sein, aber es ist wirklich "
        "eine Felshoehle.";
  }

  s = BS(s);

  if(QueryProp(P_DOOR_INFOS))
    sd = ((string)call_other(DOOR_MASTER,"look_doors"));

  if(sd && sd != "") s += sd;

  return s;
}

void trancemsg(object player)
{
  string s;

  if(!interactive(player)) return;

  tell_object(player,"In Deiner Trance erscheint der allwissende "
                     "Daemon Ashz.\n");

//if(present("\nAMARING",player))
  if(1)
  {
    if(RINGMASTER->QueryAshVisited(getuuid(player)))
    {
      s = "Du schon wieder? Leicht vergesslich, was? Dann sag ich Dir halt "
          "nochmal, wie Du Oma Wetterwachs dazu 'ueberreden' kannst, Dir "
          "Amaltheas Perle zu geben. ";
    }
    else
    {
      s = "Ach Herrje, schon wieder einer. Jaja, ich weiss, Du suchst den "
          "Ring von Amalthea, der Fee. Deine Oma ist krank, und Du "
          "brauchst den Ring ja so dringend. Ihr langweilt mich alle. "
          "Damit Du nicht noch mehr nervst, sage ich Dir, wie Du "
          "Amaltheas Perle bekommst. Oma Wetterwachs hat sie, "
          "sie rueckt Sie aber bestimmt nicht freiwillig heraus. ";
    }

    s += "Um Amaltheas Edelstein von "
         "ihr zu bekommen, musst Du sie mit Magie bekaempfen. Suche Dir etwas, "
         "aus dem Du eine Puppe formen kannst, stecke einen roten Edelstein "
         "als Herz hinein und druecke zwei schwarze Edelsteine als Augen in "
         "den Kopf. Zu guter letzt zieh der Puppe noch ein Kleidchen an und "
         "sorge dafuer, dass etwas von Oma Wetterwachsens Koerper an der "
         "Puppe vorhanden ist. Dann brauchst Du noch etwas, mit dem Du "
         "gleichzeitig drei Stiche machen kannst. ";

    s += "Geh zu Oma Wetterwachs und stich damit in die Puppe. So wirst Du "
         "Oma Wetterwachs dazu kriegen, Dir Amaltheas Edelstein zu geben. Und "
         "jetzt verschwinde. ";

    s = BSI(s,"Der Daemon seufzt: ");
    RINGMASTER->SetAshVisited(getuuid(player));
    player->More(s);
  }
  else
  {
    tell_object(player,
      BSI("Du Wurm wagst es, mich in eure trostlose Dimension zu holen? "
          "Was glaubst Du eigentlich, wer Du bist? Sei froh, dass ich "
          "heute gut gelaunt bin und einen dringenden Termin habe, "
          "sonst wuerde ich mich mal etwas naeher mit Dir befassen. "
         ,"Der Daemon Ashz faucht Dich an: "
    ));
  }

  tell_object(player,"Der Daemon Ashz verschwindet mit einem "
                     "lauten *PUFF* wieder.\n");
  return;
}

void feuerstatus(int x)
{
  switch(x)
  {
    case 0 :
      feuer = 0;

      obwer  = "";
      obwen  = "";
      obname = "";
      obids  = ({});
      obfile = "";

      SetProp(P_LIGHT, 0 );
      RemoveDetail( ({"feuer"}) );
      AddDetail( ({"asche"}) ,
        "Hier hat wohl jemand vor kurzem etwas verbrannt, denn die Asche "
        "ist noch handwarm. "
      );
      break;

    case 1 :
      feuer = 1;
      SetProp(P_LIGHT, 0 );
      RemoveDetail( ({"asche"}) );
      RemoveDetail( ({"feuer"}) );
      break;

    case 2 :
      feuer = 2;
      SetProp(P_LIGHT, 1 );
      RemoveDetail( ({"asche"}) );
      AddDetail( ({"feuer"}) ,
        "Unter dem Kessel brennt ein Feuer und erwaermt das Wasser."
      );
      break;
  }
}

void feueraus(int i,object player)
{
  switch(i)
  {
    case 1 :
      tell_room(TO,LF+BS("Der Torf brennt mit starker Flamme und das Wasser "
                      "wird allmaehlich heiss."
      )+LF);
      break;

    case 2 :
      tell_room(TO,LF+BS("Das Wasser faengt langsam an zu kochen und "
                         "Dampfschwaden ziehen durch die Hoehle."
      )+LF);
      break;

    case 3 :
      if(present(player,TO))
      {
        tell_room(TO,LF+BS("Dicke Dampfschwaden ziehen durch den Raum und "
                           "nehmen einem jede Sicht. Schemenhaft siehst Du, "
                           "wie sich "+player->Name()+" ueber den Kessel "
                           "beugt und kurz danach ohnmaechtig wird. Kurz "
                           "danach werden die Dampfschwaden so dicht, dass "
                           "Du nichts mehr erkennen kannst."
        )+LF, ({player}) );
        tell_object(player,LF+BS("Dicke Dampfschwaden ziehen durch die "
                                 "Hoehle. Neugierig beugst Du Dich ueber "
                                 "den Kessel, aber der Dampf scheint nicht "
                                 "nur aus Wasser zu bestehen. Irgendwas "
                                 "raubt Dir die Sinne und Du faellst in "
                                 "Trance."
        )+LF);
        player->SetProp(P_PARALYZED,
          ([PARALYZE_TIME: PAUSE,
            PARALYZE_MSG: "Aber Du bist doch ohnmaechtig !\n",
            PARALYZE_MSG_OTHER: "",
            PARALYZE_END: "Du erwachst wieder aus Deiner Trance.\n",
            PARALYZE_END_OTHER: TPN+" wird wieder munter.\n"])
        );
      }
      else
      {
        player = 0;
        tell_room(TO,LF+BS("Dicke Dampfschwaden ziehen durch den Raum und "
                           "nehmen Dir jede Sicht."
        )+LF);
      }

      dampf = 1;
      break;

    case 4 :
      if(player)
      {
        tell_room(TO,LF+BS("Das Feuer scheint schwaecher zu werden, denn der "
                           "Dampf ist schon nicht mehr so dicht."
        )+LF, ({player}) );
        trancemsg(player);
      }
      else
      {
        tell_room(TO,LF+BS("Das Feuer scheint schwaecher zu werden, denn der "
                           "Dampf ist schon nicht mehr so dicht."
        )+LF);
      }
      break;

    case 5 :
      tell_room(TO,LF "Das Feuer unter dem Kessel geht langsam aus.\n" LF);
      dampf = 0;
      break;

    case 6 :
      feuerstatus(0);
      tell_room(TO,LF "Das Feuer glimmt noch etwas, bevor es ganz "
                      "erlischt.\n" LF);
      break;
  }

  if(i<6)call_out("feueraus",PAUSE,++i,player);
  return;
}

int cmd_reissen(string str)
{
  notify_fail("Was willst Du ausreissen?\n");

  if(-1 == member(({"haar aus","haare aus"}),str))
  {
    return 0;
  }

  TELLPLAYER(BS("Du ueberlegst Dir ein paar Haare auszureissen, "
                "laesst es dann aber doch. Schliesslich willst Du keine "
                "Glatze haben. "
  ));
  TELLOTHERS(TPN+" rauft sich die Haare.\n");
  return 1;
}

int cmd_schuetten(string str)
{
  notify_fail("Was willst Du ausschuetten?\n");

  if(-1 == member(({"wasser aus","wasser aus kessel aus"}),str))
  {
    return 0;
  }

  TELLPLAYER(BS("Der Kessel ist viel zu gross und zu schwer, so dass Du ihn "
                "ihn nicht umkippen und so das Wasser ausschuetten kannst. "
                "Ist auch gut so, denn das gaebe eine ziemliche Sauerei."
  ));

  TELLOTHERS(BS(TPN+" stemmt sich mit aller Gewalt gegen des Kessel. Was "+
                TPP(WER)+" wohl vorhat?"
  ));
  MOORMASTER->Msg(TPUID+" will den Kessel in der Bbliothek ausschuetten");
  return 1;
}

int cmd_graben(string str)
{
  TELLPLAYER(BS("Durch den Granit graben? Das ist sinnlos, Granit ist so "
                "hart und stabil wie... wie... hmmm... wie Granit eben. "
  ));
  return 1;
}

int cmd_stolpern(string str)
{
  TELLPLAYER(BS("Du stolperst absichtlich, faellst und haust Dir prompt "
                "den Kopf am Kessel blutig. "));
  TELLOTHERS(TPN+" stolpert und schlaegt sich den Kopf am Kessel blutig.\n");
  SetProp(P_KILL_NAME,"Stolpern");
  TP->do_damage(10);
  return 1;
}

int cmd_legen(string str)
{
  int n;
  object ob;
  string was;

  notify_fail("Was willst Du unter den Kessel legen?\n");

  if(!str || str == "") return 0;
  n = sscanf(str, "%s unter kessel", was);
  if(n != 1){n = sscanf(str, "%s zwischen steine", was);}
  if(n != 1){return 0;}

  if(!(ob=present(was,TP)))
  {
    TELLPLAYER("So etwas hast Du doch gar nicht bei Dir.\n");
    return 1;
  }

  if( !(ob->id("AST")           ||
        ob->id("gestruepp")     ||
        ob->id("zunder")        ||
        ob->id("holzkohle")     ||
        ob->id("torf")
       ))
  {
    TELLPLAYER("Das ist nicht geeignet, um unter dem Kessel ein "
               "Feuer zu entzuenden.\n");
    return 1;
  }

  if(feuer == 1)
  {
    TELLPLAYER("Aber da liegt doch schon was unter dem Kessel.\n");
    return 1;
  }

  if(feuer == 2)
  {
    TELLPLAYER(BS("Du solltest warten, bis das Feuer ganz erloschen ist, "
               "bevor Du etwas nachlegst."));
    return 1;
  }

  obwer  = ob->name(WER,0);
  obwen  = ob->name(WEN,0);
  obname = ob->QueryProp(P_NAME);
  obids  = ob->QueryProp(P_IDS);
  obfile = BLUE_NAME(ob);
  feuerstatus(1);

  TELLPLAYER("Du legst "+ob->name(WEN,1)+" unter den Kessel.\n");
  TELLOTHERS(TPN+" legt "+ob->name(WEN,0)+" unter den Kessel.\n");
  MOORMASTER->Msg(TPUID+" legt "+ob->name(WEN,0)+" unter den Kessel in der "
           "Bibliothek");
  ob->remove();
  return 1;
}

int cmd_anzuenden(string str)
{
  int n;
  string was;

  notify_fail("Was moechtest Du anzuenden?\n");

  if(!str || str =="") return 0;
  n = sscanf(str, "%s an", was);
  if(n != 1){n = sscanf(str, "%s unter kessel an", was);}
  if(n != 1){n = sscanf(str, "%s zwischen steine an", was);}
  if(n != 1){n = sscanf(str, "%s zwischen steinen an", was);}
  if(n != 1)return 0;

  if((feuer != 1) || (-1 == member(obids,was)))
  {
    return 0;
  }

  if(member(obids,"\nTORFNASS") > -1)
  {
    TELLPLAYER("Dieses Stueck Torf ist nicht trocken und kann daher nicht "
               "brennen.\n");
    return 1;
  }

  if(TP->QueryProp(P_SP) < 10)
  {
    TELLPLAYER("Du hast nicht genuegend Magie, um "+obwen+" zu entzuenden.");
    return 1;
  }

  TP->AddSp(-10);

  if(member(obids,"\nTORFTROCKEN") > -1)
  {
    TELLPLAYER(BS("Mit einem kleinen Feuerball versuchst Du den Torf "
                  "anzuzuenden, aber so ganz will Dir das nicht gelingen."
    ));
    TELLOTHERS(BS(TPN+" versucht mit einem kleinen Feuerball den Torf "
                  "anzuzuenden, aber so ganz will es "+TPN+" nicht gelingen."
    ));
    return 1;
  }

  TELLPLAYER(BS("Du zuendest "+obwen+" an, doch dieses mickrige Feuer "
                "ist nicht in der Lage, das Wasser im Kessel auch nur "
                "nennenswert zu erwaermen. Nach kurzer Zeit erlischt das "
                "Feuer wieder."
  ));
  MOORMASTER->Msg(TPUID+" zuendet "+obwen+" normal an");
  feuerstatus(0);
  return 1;
}

int cmd_nehmen(string str)
{
  object ob;

  notify_fail("Was willst Du nehmen?\n");

  if(str == "asche")
  {
    TELLPLAYER(BS("Du untersuchst die Asche nochmals und kommst zu dem "
                  "Schluss, dass Du sie doch nicht brauchst. "
    ));
    return 1;
  }

  if(feuer == 0) return 0;

  if((sizeof(obids)==0) || (-1 == member(obids,str)))
  {
    return 0;
  }

  if(feuer == 2)
  {
    TELLPLAYER(CAP(obwer)+" brennt gerade, und die Finger willst Du Dir "
               "nicht verbrennen.\n");
    return 1;
  }

  ob = clone_object(obfile);
  if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
  {
    TELLPLAYER(CAP(obwer)+" ist Dir zu schwer.\n");
  }
  else
  {
    TELLPLAYER("Du nimmst "+obwen+" an Dich.\n");
    TELLOTHERS(TPN+" zieht "+obwen+" unter dem Kessel hervor.\n");
    MOORMASTER->Msg(TPN+" zieht "+obwen+" unter dem Kessel hervor");
    feuerstatus(0);
  }

  return 1;
}

int cmd_untersuchen(string str)
{
  if(dampf)
  {
    TELLPLAYER("Dichte Dampfschwaden nehmen Dir die Sicht.\n");
    return 1;
  }

  if((sizeof(obids)) > 0 && (member(obids,str) > -1))
  {
    TELLPLAYER(BS(CAP(obwer)+" liegt unter dem Kessel. Da kann man es "
                  "nur schlecht untersuchen.\n"));
    return 1;
  }

  return 0;
}

void spruehen()
{
  if(TP->QueryProp(P_SP) < 40)
  {
    TELLPLAYER(BS("Du murmelst den kleinen Spruch, den Du bei Oma "
                  "Wetterwachs gehoert hast. Du spuerst Deine Magie etwas "
                  "schwinden, aber anscheinend hast Du nicht genug davon. "
    ));
    TELLOTHERS(TPN+" murmelt ein paar unverstaendliche Worte.\n");
    return;
  }

  if(feuer == 0)
  {
    TELLPLAYER(BS("Du murmelst den kleinen Spruch, den Du bei Oma "
                  "Wetterwachs gehoert hast. Unter dem Kessel glimmt etwas "
                  "auf, aber sonst passiert nichts."
    ));
    TELLOTHERS(BS(TPN+" murmelt ein paar Worte worauf irgendetwas unter dem "
                  "Kessel kurz aufglimmt. "
    ));
    return;
  }

  if(feuer == 2)
  {
    TELLPLAYER(BS("Du murmelst den kleinen Spruch, den Du bei Oma "
                  "Wetterwachs gehoert hast. Aber es passiert nichts, das "
                  "Feuer brennt munter weiter. "
    ));
    TELLOTHERS(TPN+" murmelt ein paar unverstaendliche Worte.\n");
    return;
  }

  if(member(obids,"\nTORFNASS") > -1)
  {
    TELLPLAYER(BS("Du murmelst den kleinen Spruch, den Du bei Oma "
                  "Wetterwachs gehoert hast. Der Torf faengt etwas an zu "
                  "qualmen, aber das war es auch schon. "
    ));
    TELLOTHERS(BS(TPN+" murmelt ein paar Worte worauf ein kleines Woelkchen "
                  "unter dem Kessel erscheint, welches aber sofort "
                  "wieder erlischt. "
    ));
    return;
  }

  if(member(obids,"\nTORFTROCKEN") > -1)
  {
    TELLPLAYER(BS("Du murmelst den kleinen Spruch, den Du bei Oma Wetterwachs "
                  "gehoert hast und ploetzlich faengt der Torf an zu brennen."
    ));
    TELLOTHERS(BS(TPN+" murmelt ein paar Worte und ploetzlich faengt der "
                  "Torf an zu brennen."
    ));
    feuerstatus(2);
    MOORMASTER->Msg(TPUID+" spricht den richtigen Spruch, um den Torf anzuzuenden");
    call_out("feueraus",PAUSE,1,TP);
    return;
  }

  TELLPLAYER(BS("Du murmelst den kleinen Spruch, den Du bei Oma Wetterwachs "
                "gehoert hast und "+obwer+" verpufft in einer kleinen "
                "Stichflamme."
  ));
  TELLOTHERS(BS(TPN+" murmelt ein paar Worte und eine kleine Stichflamme "
                "laesst unter dem Kessel "+obwen+" schlagartig verbrennen."
  ));
  feuerstatus(0);

  return;
}

int cmd_spruehen1(string str)
{
  notify_fail("Was moechtest Du sagen?\n");

  if(!str || str == "") return 0;
  if(!(str == "feuer spruehe,kessel gluehe"    ||
       str == "feuer spruehe, kessel gluehe"   ||
       str == "feuer spruehe kessel gluehe"    ||
       str == "feuer spruehe ,kessel gluehe"   ||
       str == "feuer spruehe , kessel gluehe"  )) return 0;

  spruehen();
  return 1;
}

int cmd_spruehen2(string str)
{
  if(!str || str == "") return 0;
  if(str == "spruehe,kessel gluehe"    ||
     str == "spruehe, kessel gluehe"   ||
     str == "spruehe kessel gluehe"    ||
     str == "spruehe ,kessel gluehe"   ||
     str == "spruehe , kessel gluehe"   )
  {
    spruehen();
    return 1;
  }

  return 0;
}

string detail_blut(string str)
{

  string s;

  s = "Das Blut ist schon etwas aelter und eingetrocknet. ";

  if(haare)
  {
    s += "Ein paar Haare kannst Du auch noch sehen. ";
  }

  s += "Ist der Unglueckliche nur gestolpert oder hat man ihm "
       "absichtlich den Kopf am Kessel blutig geschlagen? ";

  return BS(s);
}

string detail_haare(string str)
{
  string s;

  if(haare)
  {
    s = "An dem Blut kleben auch noch einige Haare. Du versuchst eines davon "
        "herauszuziehen, was Dir auch tatsaechlich gelingt, aber kaum hast Du "
        "es in den Fingern, faellt es Dir auch schon herunter. Naja, auf dem "
        "Boden kannst Du jedenfalls lange suchen, bis Du es wiederfindest. ";
    haare--;
  }
  else
  {
    s = "Du hast noch ein paar Haare auf dem Kopf. Reiss die nicht auch noch "
        "aus, sonst hast Du bald eine Glatze. ";
  }

  return BS(s);
}

string detail_steine(string str)
{
  string s;

  switch(feuer)
  {
    case 0 :
      s = "Der grosse Kessel ruht auf drei Steinen. Zwischen den Steinen "
          "siehst Du noch etwas Asche, gerade so, als ob jemand vor kurzem "
          "noch ein Feuer unter dem Kessel entzuendet haette. ";
      break;

    case 1 :
      s = "Der grosse Kessel ruht auf drei Steinen. Zwischen den Steinen "
          "siehst Du "+obwen+".";
      break;

    case 2 :
      s = "Der grosse Kessel ruht auf drei Steinen. Zwischen den Steinen "
          "siehst Du ein Feuer brennen.";
      break;

  }

  return BS(s);
}


