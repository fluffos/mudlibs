#include "../def.h"

inherit "/std/room";

int beetgegossen;
int weg;
string *spieler_kanne;
string *spieler_harke;
string *spieler_wand;

void grund_zustand();
int  exit_test(string str);

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Garten" );

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_FOREST]) );

  SetProp(P_WASSERMENGE, 1);

  AddDetail( ({"himmel"}) ,
    "Die Duesternis des Moores ist hier nicht mehr vorhanden, aber dennoch "
    "hat es die Sonne schwierig, sich gegen den Dunst und den Nebel "
    "durchzusetzen."
  );

  AddDetail( ({"boden"}) ,
    "Du gehst auf einem kleinen Weg, der vom Zaun zum Haus fuehrt. Links und "
    "rechts des Weges befinden sich Blumenbeete und Gemuesebeete, auch "
    "ein kleiner Kraeutergarten wurde angelegt."
  );

  AddDetail( ({"zaun"}) ,
    "Der Zaun grenzt den Garten gegen das Moor ab. Er besteht aus "
    "mehreren Holzpfaehlen, die mit Streben verbunden sind."
  );

  AddDetail( ({"holzpfahl","holzpfaehle","holzpfaehlen","holzpfaehlen"}) ,
    "Man hat hier einfach Holzpfaehle in den Boden gerammt, um den Garten "
    "vom Moor zu trennen. Die Holzpfaehle sind mit Streben untereinander "
    "verbunden."
  );

  AddDetail( ({"streben"}) ,
    "Die Streben wurden an den Holzpfaehlen angenagelt, damit alles "
    "einigermassen stabil wird."
  );

  AddDetail( ({"nagel","naegel"}) ,
    "Die Naegel, mit denen die Streben angenagelt sind, sind schon "
    "allesamt ziemlich rostig."
  );

  AddDetail( ({"rost"}) ,
    "Die Naegel sind wohl wegen der hohen Feuchtigkeit hier alle verrosttet."
  );

  AddDetail( ({"feuchtigkeit"}) ,
    "Die hohe Luftfeuchtigkeit kommt wohl von dem Moor im Westen."
  );

  AddDetail( ({"westen"}) ,
    "Im Westen ist das Moor."
  );

  AddDetail( ({"garten","vorgarten"}) ,
    "Im Garten hat jemand neben Blumen und Gemuese auch einen kleinen "
    "Kraeutergarten angelegt. Ganz hinten steht ein kleines, merkwuerdiges "
    "Haeuschen."
  );

  AddDetail( ({"haeuschen"}) ,
    "Das Haeuschen ist mannshoch und hat ca. 1 Quadratmeter Grundflaeche. "
    "Die ganze vordere Wand ist eine Tuer."
  );

  AddDetail( ({"quadratmeter","grundflaeche"}) ,
    "Naja, vielleicht ein bisschen mehr als einen Quadratmeter, vielleicht "
    "ein bisschen weniger."
  );

  AddDetail( ({"wand","vordere Wand"}) ,
    "Die ganze vordere Wand ist eine einzige Tuer."
  );

  AddDetail( ({"seitenwand","seitliche Wand","seitenwaende","seitliche Waende"}) ,
    "Die Seitenwaende sehen aus wie die vordere Wand, nur dass es halt "
    "keine Tueren sind und keine Loecher vorhanden sind."
  );

  AddSpecialDetail( ({"hintere wand"}) , "detail_wand");

  AddDetail( ({"tuer"}) ,
    "Die Tuer ist verschlossen. Etwa in Augenhoehe befindet sich ein "
    "kleines Loch."
  );

  AddDetail( ({"augenhoehe"}) ,
    "Das ist die Hoehe vom Boden bis zu Deinen Augen."
  );

  AddDetail( ({"hoehe"}) ,
    "Du blickst in die Hoehe und siehst: den Himmel."
  );

  AddDetail( ({"auge","augen"}) ,
    "Scheinen beide noch da zu sein."
  );

  AddDetail( ({"loch"}) ,
    "Das Loch hat die Form eines Herzens."
  );

  AddDetail( ({"form"}) ,
    "                              \n"
    "                              \n"
    "      .-\"\"\"-.    .-\"\"\"-.      \n"
    "     /       '..'       \\     \n"
    "    |                    |    \n"
    "    |                    |    \n"
    "     \\                  /     \n"
    "      \\                /      \n"
    "       `\\            /'       \n"
    "         `\\        /'         \n"
    "           `\\    /'           \n"
    "             `\\/'             \n"
    "                              \n"
  );

  AddDetail( ({"herz","herzen","herzens"}) ,
    "In die Tuer des Haeuschens hat jemand ein Loch in Form eines Herzens "
    "gesaegt."
  );

  AddDetail( ({"moor"}) ,
    "Das Moor befindet sich im Westen."
  );

  AddDetail( ({"lebkuchen"}) ,
    "Der Lebkuchen sieht richtig lecker aus. Ob man da wohl von naschen kann? "
  );

  AddDetail( ({"beet","beete"}) ,
    "Du siehst Blumenbeete, Gemuesebeete und ein Kraeuterbeet."
  );

  AddDetail( ({"kraeuterbeet","kraeutergarten","kraeuter","kraut","kraeutergarten"}) ,
    "Im Kraeuterbeet wachsen jede Menge Pflanzen, die Du nicht kennst."
  );

  AddDetail( ({"hexenhaus","haus","lebkuchenhaus"}) ,
    "Es ist ganz so, wie es in den alten Maerchen beschrieben wird: Ueber und "
    "ueber mit herrlichen Lebkuchen bedeckt. "
  );

  AddDetail( ({"blumenbeete","blumenbeet","blumen","blumenbeeten"}) ,
    "Ueberall in den Blumenbeeten bluehen Blumen und lassen Dich das duestere "
    "Moor schnell vergessen. "
  );

  AddSpecialDetail( ({"weg"}) , "detail_weg" );

  AddDetail( ({"sonne"}) ,
    "Die Sonne hat ein klein wenig Schwierigkeiten, gegen den Dunst und den "
    "Nebel des Moores anzukaempfen, aber im grossen und ganzen ist es "
    "hier freundlich genug, um sich wohl zu fuehlen und jede Menge Pflanzen "
    "wachsen zu lassen. "
  );

  AddDetail( ({"menge"}) ,
    "Viele halt."
  );

  AddDetail( ({"nebel","dunst"}) ,
    "Davon ist hier nur noch wenig zu sehen. "
  );

  AddDetail( ({"maerchen"}) ,
    "Geschichten, die man kleinen Kindern vorliest. Wie hiess das nochmal "
    "mit der Hexe und den beiden Kindern? Du merkst wie alt Du wirst, wenn "
    "Du Dich an sowas schon nicht mehr erinnern kannst."
  );

  AddDetail( ({"holzhuette","huette"}) ,
    "Statt einer alten, verfallenen Holzhuette, wie Du es eigentlich erwartet "
    "hast, steht hier ein Lebkuchenhaus."
  );

  AddDetail( ({"duesternis"}) ,
    "Die Duesternis des Moores ist hier nicht mehr vorhanden."
  );

  AddDetail( ({"steine","stein","kieselsteine","kiestelsteinen","kieselstein"}) ,
    "Sie sollen verhindern, dass etwas auf dem Weg waechst."
  );

  AddDetail( ({"hexe"}) ,
    "Das Haeuschen sieht so gar nicht aus, als ob eine Hexe darin wohnen "
    "wuerde. Eher koennte es aus einem Maerchen entstammen."
  );

  AddDetail( ({"gemuesebeet","gemuesebeete","gemuesepflanzen"}) ,
    "Zahlreiche Gemuesepflanzen wurden gepflanzt, aber noch nicht eine ist "
    "reif. Vielleicht sollte man das Gemuese etwas duengen und giessen? "
  );

  AddDetail( ({"gemuese"}) ,
    "Noch nichts ist gewachsen. Vielleicht fehlt etwas Duenger oder Wasser?"
  );

  AddDetail( ({"duenger"}) ,
    "Ein wenig Duenger koennte wirklich nicht schaden."
  );

  AddDetail( ({"schwierigkeiten"}) ,
    "Hast Du welche?"
  );

  AddDetail( ({"pflanzen"}) ,
    "Jede Menge Pflanzen wachsen hier: Blumen, Gemuese und Kraeuter."
  );

  AddDetail( ({"kinder","kindern"}) ,
    "Von Kindern ist weit und breit keine Spur. Am Haeuschen findet sich "
    "auch kein Kaefig um Kinder gefangenzuhalten und auch kein Ofen, um "
    "sie zu braten."
  );

  AddDetail( ({"blumeenbeete","blumenbeet"}) ,
    "Auf dem Blumenbeet bluehen so viele Blumen, dass es eine Pracht ist. "
    "Deswegen verkneifst Du es Dir auch, welche zu pfluecken."
  );

  AddDetail( ({"wasser","hauswand"}) ,
    "Neben der Hauswand entdeckst Du eine Regentonne."
  );

  AddDetail( ({"spur","spuren"}) ,
    "Keine Spur einer Spur!"
  );

  AddDetail( ({"ofen"}) ,
    "Nein, kein Ofen da."
  );

  AddDetail( ({"kaefig"}) ,
    "KEIN Kaefig heisst, dass KEIN Kaefig da ist."
  );

  AddSpecialDetail( ({"tonne","regentonne"}) , "detail_tonne");

  AddCmd( ({"nasch","nasche"})     , "cmd_naschen");
  AddCmd( ({"pflueck","pfluecke"}) , "cmd_pfluecken");
  AddCmd( CMD_OEFFNEN              , "cmd_oeffnen");
  AddCmd( ({"klopf","klopfe"})     , "cmd_klopfen");
  AddCmd( CMD_NEHMEN               , "cmd_nehmen");
  AddCmd( ({"hark","harke"})       , "cmd_harken");

  AddExit( "osten"  , ([EX_DEST : ROOM "eingang", EX_TESTFUNC : #'exit_test ]) );
  AddExit( "westen" , ([EX_DEST : ROOM "moor_f3", EX_TESTFUNC : #'exit_test ]) );

  beetgegossen  = 0;
  weg           = 0;
  spieler_kanne = ({ });
  spieler_harke = ({ });
  spieler_wand  = ({ });
}

string _query_int_long()
{
  string s;

  s = "";

  if(TP && interactive(TP) && objectp(TP->QueryProp(P_LAST_COMMAND_ENV)))
  {
    switch(file_name(TP->QueryProp(P_LAST_COMMAND_ENV)))
    {
      case "/d/unterwelt/ronja/moor/room/eingang":
        s = "Du trittst aus dem Haus und befindest Dich in einem kleinen "
            "huebschen Vorgarten. ";
        break;

      case "/d/unterwelt/ronja/moor/room/garten":
        s = "Du stehst in einem kleinen huebschen Vorgarten. ";
        break;

      default:
        s = "Unvermittelt hoert das Moor auf und Du stehst in einem "
            "kleinen huebschen Vorgarten. ";
        break;
    }
  }

  s += "Der Garten ist von einem kleinen Zaun umgeben. Neben einigen "
       "Blumenbeeten siehst Du auch ein Kraeuterbeet. Mitten im Garten "
       "steht auch ein kleines Haus. Und es sieht tatsaechlich wie ein "
       "Hexenhaus aus, denn es ist ueber und ueber mit Lebkuchen "
       "bedeckt. Eher haettest Du erwartet, eine alte, verfallene Holzhuette "
       "vorzufinden. Aber es ist wirklich ein Lebkuchenhaus. ";

  return BS(s);
}

void QueryPlayer(object name)
{
  object wiz;

  wiz = find_player(name);

  if(!wiz)              return;
  if(!interactive(wiz)) return;

  tell_object(wiz,sprintf("W: %O\nK: %O\nH: %O\n",spieler_wand,spieler_kanne,spieler_harke));
}

void reset()
{
  ::reset();

  spieler_kanne = ({ });
  spieler_harke = ({ });
  spieler_wand  = ({ });

  beetgegossen = 0;

  if(QueryProp(P_WASSERMENGE) == -1)
  {
    tell_room(TO,BS("Eine kleine Regenwolke entsteht genau ueber der Regentonne "
                    "und regnet hinein, bis sich die Wolke aufgeloest hat."));
    SetProp(P_WASSERMENGE, 1);
  }
}

void init()
{
  ::init();
  if(TP && interactive(TP)) weg += 3;
  if(weg>49) weg=49;
}

int exit_test(string str)
{
  int st;
  string s;
  object ob;

  if(!objectp(TP))     return 1;
  if(!interactive(TP)) return 1;

  st = 0;
  s = "";

  if(ob=present("\nHARKE",TP))
  {
    ob->DoUnwield(1);
    ob->remove();
    spieler_harke -= ({ getuuid(TP) });
    st += 1;
  }

  if(ob=present("\nGIESSKANNE",TP))
  {
    ob->remove();
    spieler_kanne -= ({ getuuid(TP) });
    st += 2;
  }

  switch(st)
  {
    case 1 :
      s = "Du stellst noch schnell die Harke wieder dahin, wo Du sie "
          "gefunden hast.";
      break;

    case 2 :
      s = "Du entleerst die Giesskanne und stellst sie wieder hinter das "
          "Haeuschen.";
      break;

    case 3 :
      s = "Du entleerst die Giesskanne und stellst sie wieder hinter das "
          "Haeuschen. Die Harke stellst Du dabei auch gleich wieder dahin, "
          "wo sie vorher stand. ";
      break;
  }

  TELLPLAYER(BS(s));
  return 1;
}

string detail_tonne(string str)
{
  if(QueryProp(P_WASSERMENGE) > 0)
  {
    return "Es befindet sich noch etwas Wasser in der Regentonne.\n";
  }
  else
  {
    return "Die Regentonne ist leer.\n";
  }
}

string detail_weg(string str)
{
  string s;

  s = "Der Weg ist mit kleinen, weissen Kieselsteinen bedeckt, damit nichts "
      "darauf waechst. ";

  switch(weg)
  {
    case  0 ..  9 :
      s += "Der Weg wurde vor kurzem geharkt und sieht wirklich sehr "
           "ordentlich aus.";
      break;

    case 10 .. 19 :
      s += "Der Weg wurde vor kurzem geharkt, aber man kann deutlich "
           "sehen, dass vor kurzem jemand darauf herum gelaufen ist. ";
      break;

    case 20 .. 29 :
      s += "Man sieht deutlich, dass hier bereits eine Menge Leute "
           "ueber den Weg gelaufen sind. Langsam koennte der Weg "
           "mal wieder geharkt werden.";
      break;

    case 30 .. 39 :
      s += "Der Weg ist ziemlich zertreten. Damit er wieder schoen "
           "aussieht, muesste er wirklich mal wieder geharkt werden.";
      break;

    default       :
      s += "Der Weg sieht arg zertreten aus. Er muesste dringend mal "
           "geharkt werden.";
      break;
  }

  return BS(s);
}

string detail_wand(string str)
{
  int st;
  string s;

  st = 0;
  s = "Die Wand an sich zeigt nichts auffaelliges oder besonderes. ";

  if(member(spieler_wand, getuuid(TP)) == -1)
  {
    spieler_wand += ({ getuuid(TP) });
  }

  if(member(spieler_wand, getuuid(TP)) > -1) st =  3;
  if(member(spieler_kanne,getuuid(TP)) > -1) st -= 2;
  if(member(spieler_harke,getuuid(TP)) > -1) st -= 1;

  switch(st)
  {
    case 1 :
      s += "An der hinteren Wand lehnt eine Harke.";
      break;

    case 2 :
      s += "Aber anscheinend hat jemand eine Giesskanne hinter dem Haueschen "
           "versteckt. Denn wieso sonst sollte eine Giesskanne hinter dem "
           "Haeuschen stehen?";
      break;

    case 3 :
      s += "Allerdings lehnt an der Wand eine Harke und auf dem Boden steht "
           "eine Giesskanne. ";
      break;
  }

  return BS(s);
}

int cmd_naschen(string str)
{
  object zahn;

  notify_fail("Wovon willst Du naschen?\n");

  if(!str || str == "") return 0;
  if(!(str == "lebkuchen"         ||
       str == "von lebkuchen"     ||
       str == "vom lebkuchen"     ||
       str == "suessigkeiten"     ||
       str == "von suessigkeiten" )) return 0;

  if(deep_present("\nlispeln", TP))
  {
    TELLPLAYER(BS("Nein, noch einen Zahn moechtest Du wegen diesem "
                  "ungeniessbaren Zeug nicht verlieren. "
    ));
    return -1;
  }

  if((zahn = present("zahnschutz",TP)) && zahn->QueryProp(P_WORN))
  {
    TELLPLAYER(BS("Du versuchst von dem Lebkuchen zu naschen, aber das "
                  "Zeug ist ja Steinhart! Zum Glueck traegst Du aber einen "
                  "Zahnschutz, am Ende waer Dir noch ein Zahn abgebrochen!"
    ));
    return -1;
  }

  TELLPLAYER(BS("Du versuchst von dem Lebkuchen zu naschen, aber das "
                "Zeug ist ja steinhart! An dem harten Lebkuchen brichst "
                "Du Dir auch noch einen Schneidezahn ab. Verflixt, das "
                "tut ganz schoen weh!"
  ));

  TELLOTHERS(BS(TPN+" versucht, von dem Lebkuchen zu naschen, verzieht "
                "aber nur schmerzerfuellt das Gesicht."
  ));

  zahn=clone_object(OBJ "zahn.lpc");
  zahn->move(TP,M_GET|M_SILENT|M_NOCHECK);
  MOORMASTER->Msg(TPUID+" verliert einen Zahn");

  return 1;
}

int cmd_pfluecken(string str)
{
  notify_fail("Was willst Du pfluecken?\n");

  if(!str || str == "") return 0;
  if(!(str == "blumen"  ||
       str == "blume"   )) return 0;

  TELLPLAYER(BS("Die Blumenbeete sehen so huebsch aus, dass Du es Dir "
                "verkneifst, welche zu pfluecken."
  ));

  return 1;
}

int cmd_oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(!str || str == "") return 0;
  if(!(str == "tuer")) return 0;

  TELLPLAYER(BS("Die Tuer ist fest verschlossen. Anscheinend sogar von "
                "innen. Ob da jemand drin ist? Vielleicht klopfst Du ja "
                "mal an die Tuer."
  ));

  TELLOTHERS(BS(CTPN+" ruettelt an der Tuer des Haeuschens, aber die Tuer "
                "scheint fest verschlossen."
  ));

  return 1;
}

int cmd_klopfen(string str)
{
  notify_fail("Woran willst Du klopfen?\n");

  if(!str || str == "") return 0;
  if(!(str == "an tuer"  ||
       str == "tuer"     ||
       str == "an tuere" ||
       str == "tuere"    )) return 0;

  domainshout("Jemand ruft: BESETZT!\n", ROOM, 1);
  TELLPLAYER("Jemand ruft: BESETZT!\n");
  MOORMASTER->Msg(TPUID+" klopft an die Klotuer");
  return 1;
}

int cmd_harken(string str)
{
  object harke;

  notify_fail("Was willst Du harken?\n");

  if(!str || str == "") return 0;
  if(!(str == "weg"         ||
       str == "kiesel"      ||
       str == "kieselstein" ||
       str == "kieselsteine")) return 0;

  if(!(harke=present("\nHARKE",TP)))
  {
    TELLPLAYER("Du hast ja gar nichts zum Harken dabei.\n");
    return -1;
  }

  if(!harke->QueryProp(P_WIELDED))
  {
    TELLPLAYER("Du musst die Harke erstmal zuecken.\n");
    TELLOTHERS(TPN+" fuchtelt mit einer Harke wild in der Gegend herum.\n");
    return -1;
  }

  MOORMASTER->Msg(TPUID+" harkt den Weg im Garten");

  if(weg<10)
  {
    TELLPLAYER(BS("Der Weg sieht aber noch ganz passabel aus, da muss im "
                  "Moment nichts geharkt werden."));
    return -1;
  }

  TELLPLAYER(BS("Du harkst den Weg im Garten, so dass er wieder schoen "
                "ordentlich aussieht."
  ));

  TELLOTHERS(BS(CTPN+" harkt den Weg, so dass er wieder schoen ordentlich "
                "aussieht. Hat "+TP->QueryPronoun(WER)+" das Abenteuerdasein "
                "aufgegeben und wird nun Gaertner?"
  ));

  weg = 0;
  return 1;
}

int cmd_nehmen(string str)
{
  object ob;

  notify_fail("Was willst Du nehmen?\n");

  if(!str || str == "") return 0;

  if(str == "harke")
  {

    if((member(spieler_wand ,getuuid(TP)) == -1) ||
       (member(spieler_harke,getuuid(TP)) >  -1)  )
    {
      TELLPLAYER("Sowas siehst Du hier nicht.\n");
      return -1;
    }

    ob=clone_object(WEAPON "harke.lpc");
    if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
    {
      TELLPLAYER(BS("Du hast schon soviel Sachen bei Dir, dass Du selbst diese mickrige "
                    "Harke nicht mehr tragen kannst."
      ));
      ob->remove();
    }
    else
    {
      TELLPLAYER("Du nimmst die Harke an Dich. Wer weiss, wozu sie nuetzlich ist.\n");
      TELLOTHERS(TPN+" untersucht das kleine Haeuschen ganz genau.\n");
      MOORMASTER->Msg(TPUID+" findet die Harke");
      spieler_harke += ({ getuuid(TP) });
    }

    return 1;
  }

  if(str == "kanne" || str == "giesskanne")
  {

    if((member(spieler_wand, getuuid(TP)) == -1) ||
       (member(spieler_kanne,getuuid(TP)) >  -1)  )
    {
      TELLPLAYER("Sowas siehst Du hier nicht.\n");
      return -1;
    }

    ob=clone_object(OBJ "giesskanne.lpc");
    if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
    {
      TELLPLAYER(BS("Du hast schon soviel Sachen bei Dir, dass Du selbst "
                    "diese mickrige Giesskanne nicht mehr tragen kannst."
      ));
      ob->remove();
    }
    else
    {
      TELLPLAYER("Du nimmst die Giesskanne an Dich. Willst Du Gaertner werden?\n");
      TELLOTHERS(TPN+" untersucht das kleine Haeuschen ganz genau.\n");
      MOORMASTER->Msg(TPUID+" findet die Giesskanne");
      spieler_kanne += ({ getuuid(TP) });
    }

    return 1;
  }

  return 0;
}

