  );

  AddDetail( ({"platz"}) ,
    "Da kein Baum im Wohnzimmer ist, ist genug Platz fuer Moebel. "
  );

  AddDetail( ({"teppich","teppiche"}) ,
    "Auf dem Boden liegen zwei sehr schoene Teppiche, damit der ganze Boden "
