#include "../def.h"

inherit "/std/room";

#define LW(x) (sizeof(x)==1 ? x[0] : implode(x[0..<2],", ")+" und "+x[<1])

int feuer;
nosave string stuhl_sitzer;
nosave string *spieler_faden;

void setze_temperatur();
string sound(string str);
int exit_test();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Wohnzimmer" );
  SetProp( P_INT_LONG,
    "Du befindest Dich jetzt mitten im Wohnzimmer von Oma Wetterwachs. "
    "Es ist sehr gemuetlich eingerichtet und hat einen Hauch von "
    "Nostalgie. Das liegt wohl auch an den antiken Moebeln, die im Zimmer "
    "verteilt stehen. In der Mitte des Wohnzimmers steht unuebersehbar "
    "ein niedriger Tisch mit vielen Schnoerkeleien und einem scheinbar "
    "selbstgehaekelten Tischdeckchen. Darauf wird Oma Wetterwachs wohl "
    "immer ihren Tee ihren Gaesten servieren. Um den Tisch herum steht "
    "eine Couch, die gemuetlich und einladend wirkt. Vor dem Tisch steht "
    "noch ein alter Schaukelstuhl. Durch das Fenster faellt ein bisschen "
    "Licht herein und laesst dadurch das ganze Zimmer in einem "
    "maerchenhaften Glanz erscheinen."
  );

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"zimmer","raum","wohnzimmer"}) ,
    QueryProp(P_INT_LONG)
  );

  AddDetail( ({"moebel","moebeln"}) ,
    "Du siehst zwei Glasschraenke, einen Tisch, eine Couch und einen "
    "Schaukelstuhl. Ob Du die Teppiche zu den Moebeln rechnen willst, "
    "ueberlasse ich Dir. "
  );

  AddDetail( ({"tisch"}) ,
    "Mitten im Zimmer steht ein Tisch, an dem sich Oma Wetterwachs wohl "
    "entspannt oder ihren Gaesten einen Tee serviert. Der Tisch hat viele "
    "Schnoerkeleien an der Tischplatte und an den Beinen."
  );

  AddDetail( ({"platte","tischplatte"}) ,
    "Auch die Tischplatte ist mit zahllosen Schnoerkeleien verziert. "
    "Auf der Tischplatte liegt ein kleines Deckchen. "
  );

  AddDetail( ({"bein","beine","beinen","tischbein","tischbeine"}) ,
    "4 Beine hat dieser Tisch, und jedes ist mit zahllosen Schnoerkeleien "
    "verziert. "
  );

  AddDetail( ({"4"}) ,
    "Du bist wohl ganz besonders wild auf Forscherpunkte, was?"
  );

  AddDetail( ({"schnoerkeleien","schnoerkel","schnoerkeln"}) ,
    "Der Tisch ist mit zahllosen Schnoerkeln uebersaeht. Da hat sich wohl "
    "jemand sehr viel Muehe gemacht, das alles hinein zu schnitzen. "
  );

  AddDetail( ({"muehe"}) ,
    "Von der Muehe, die diese Schnoerkeleien bereitet haben, ist nicht mehr "
    "viel zu sehen. Aber das ist immer so, von den vielen Muehen ist "
    "hinterher kaum noch was zu sehen. "
  );

  AddDetail( ({"mitte"}) ,
    "In der Mitte des Zimmers steht ein Tisch."
  );

  AddDetail( ({"tee"}) ,
    "Anscheinend erwartet Oma Wetterwachs niemand, denn weder steht "
    "Tee auf dem Tisch noch hast Du den Eindruck, dass Oma Wetterwachs "
    "demnaechst welchen servieren wird. "
  );

  AddDetail( ({"eindruck"}) ,
    "Du siehst weder ein Teelicht, noch Tassen auf dem Tisch. Daher "
    "hast Du den Eindruck, dass Oma Wetterwachs wohl niemanden erwartet "
    "und daher wohl auch keinen Tee gekocht hat. "
  );

  AddDetail( ({"teelicht","tasse","tassen"}) ,
    "Du siehst weder Tassen noch ein Teelicht auf dem Tisch. Nur ein Deckchen "
    "liegt auf dem Tisch. Anscheinend erwartet Oma Wetterwachs niemand. "
  );

  AddDetail( ({"tischdeckchen","deckchen"}) ,
    "Auf dem Tisch liegt ein kleines Deckchen. Vermutlich hat es Oma "
    "Wetterwachs selbst gehaekelt. "
  );

  AddSpecialDetail( ({"gast","gaeste","gaesten"}) , "detail_gaeste" );

  AddDetail( ({"boden"}) ,
    "Der Boden ist ein Parkett aus Eiche, auf dem zwei grosse Teppiche "
    "ausgebreitet wurden. "
  );

  AddDetail( ({"eiche","eichen"}) ,
    "Eichen sind maechtige, schoene Baeume. Aus einer hat man allerdings "
    "dieses schoene Parkett gemacht."
  );

  AddDetail( ({"parkett","eichenparkett"}) ,
    "Das Parkett ist aus Eiche und lugt an den Raendern der Teppiche hervor. "
    "Sonst koenntest Du es ja auch gar nicht sehen. "
  );

  AddDetail( ({"rand","raender","raendern"}) ,
    "An den Raendern der Teppiche lugt ein schoenes Eichenparkett hervor."
  );

  AddDetail( ({"baum","baeume"}) ,
    "Ein Baum? Hier im Wohnzimmer? Wenn hier ein Baum waere, dann waere "
