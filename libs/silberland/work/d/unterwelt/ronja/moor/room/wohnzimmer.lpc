    "angemessen auszuleuchten, aber gerade diese Groesse taucht den Raum "
    "in einen maerchenhaften Glanz, wodurch er sehr anheimelnd wirkt. "
  );

  AddDetail( ({"holzkreuz","kreuz","fensterkreuz"}) ,
    "Das Fensterkreuz teilt das Fenster in vier gleichgrosse Teile. "
  );

  AddDetail( ({"groesse"}) ,
    "Von Groesse kann man eigentlich nicht sprechen, denn das Fenster "
    "an sich ist ja schon klein und das Fensterkreuz teilt das Fenster "
    "ja nochmals in 4 kleinere Teile. "
  );

  AddDetail( ({"teil","teile"}) ,
    "Jedes der vier Teile ist gleich gross."
  );

  AddDetail( ({"westwand"}) ,
    "An der Westwand stehen zwei Glasschraenke, ausserdem geht es hier wieder "
    "hinaus. "
  );

  AddDetail( ({"suedwand"}) ,
    "In die Suedwand wurde ein Kamin eingebaut, in dem ein kleines Feuer "
    "brennt und vor dem ein Gitter steht, damit keine Holzscheite in den "
    "Raum kullern koennen. "
  );

  AddDetail( ({"gitter"}) ,
    "Vor dem Kamin ist ein schmiedeeisernes Gitter angebracht, welches "
    "verhindern soll, dass ein Holzscheit aus dem Kamin in das Zimmer "
    "kullert. "
  );

  AddDetail( ({"brand"}) ,
    "Momentan brennt es nur im Kamin."
  );

  AddDetail( ({"kamin"}) ,
    "Ein Kamin ist in die Suedwand eingelassen. In ihm prasselt ein "
    "Feuer. Vor dem Kamin sind ein paar Fliesen, damit keine Funken "
    "den Teppich in Brand setzen, ausserdem ist ein Gitter rund "
    "um den Kamin vorhanden, damit die brennenden Holzscheite "
    "nicht zufaellig aus dem Kamin herausrutschen und das Wohnzimmer "
    "in Brand setzen. Links vom Kamin haengt ein Feuerhaken."
  );

  AddDetail( ({"fliesen"}) ,
    "Vor dem Kamin sind ein paar Fliesen, damit eventuell herausfliegende "
    "Funken nicht den Teppich ankokeln. "
  );

  AddDetail( ({"feuerhaken","haken"}) ,
    "Der Feuerhaken ist mit einer duennen Kette an der Wand befestigt, "
    "damit er immer dort bleibt, wo er hingehoert. Er dient dazu, das "
    "Feuer zu schueren. "
  );

  AddDetail( ({"kette"}) ,
    "Die Kette sieht auf den ersten Blick recht zierlich aus. Doch haelt sie "
    "eventuell mehr aus, als es den Anschein hat. "
  );

  AddDetail( ({"blick"}) ,
    "Auf den ersten Blick sieht die Kette recht zierlich aus."
  );

  AddDetail( ({"anschein"}) ,
    "Vielleicht ist diese Kette magisch und haelt wesentlich mehr aus. "
    "Ansonsten koenntest Du den Feuerhaken leicht abreissen. "
  );

  AddSpecialDetail( ({"feuer", "glut"}) , "detail_feuer" );

  AddDetail( ({"glasschrank","glasschraenke","schrank","schraenke"}) ,
    "Die Schraenke haben Tueren aus Glas, in ihnen befindet sich jede "
    "Menge Porzellan."
  );

  AddDetail( ({"menge"}) ,
    "Wirklich eine ganze Menge Porzellan. Jetzt benimm Dich bloss nicht "
    "wie ein Elefant im Porzellanladen. "
  );

  AddDetail( ({"porzellanladen","elefant"}) ,
    "Das ist doch nur eine Redensart."
  );

  AddDetail( ({"redensart","redensarten"}) ,
    "Redensarten sind nicht gegenstaendlich und lassen sich daher nicht "
    "untersuchen. "
  );

  AddDetail( ({"porzellan"}) ,
    "Sehr feines Porzellan, wenn Du es genauer untersuchen moechtst, "
    "musst Du es schon aus dem Schrank herausnehmen. "
  );

  AddDetail( ({"tuer","tueren"}) ,
    "Die Tueren bestehen fast vollstaendig aus Glas, nur ein feiner "
    "Holzrahmen haelt das Glas. Und irgendwie muss das Glas ja auch am "
    "Schrank befestigt werden. "
  );

  AddDetail( ({"rahmen","holzrahmen"}) ,
    "Der Holzrahmen fasst das Glas ein."
  );

  AddDetail( ({"glas"}) ,
    "Das Glas ist glasklar."
  );

  AddSpecialDetail( ({"schaukelstuhl","stuhl"}) , "detail_stuhl" );

  AddDetail( ({"kufen","bein","beine"}) ,
    "Die Beine des Schaukelstuhles enden unten in zwei Kufen. Sonst "
    "koennte man ja auch gar nicht damit schaukeln. "
  );

  AddDetail( ({"spuren","spur"}) ,
    "Der Teppich ist dort, wo der Schaukelstuhl steht, etwas abgewetzt."
  );

  AddDetail( ({"couch","sofa"}) ,
    "Ein Sofa mit Polstern, die herrlich bequem aussehen."
  );

  AddDetail( ({"polster","polstern"}) ,
    "Die Polster auf der Couch sehen aber verflixt weich aus. Ob Du da "
    "bequem drin sitzt? Wenn Du es nicht ausprobierst, wirst Du es nie "
    "erfahren. "
  );

  AddDetail( ({"hauch"}) ,
    "Hauch von Nostalgie bedeutet, dass es gerade noch so eben erkennbar ist."
  );

  AddDetail( ({"oma","wetterwachs","oma wetterwachs"}) ,
    "Oma Wetterwachs ist gerade nicht hier."
  );

  AddDetail( ({"glanz","licht"}) ,
    "Durch das Fenster faellt etwas Licht in das Zimmer, das dadurch "
    "in einem eigentuemlichen, fast maerchenhaften Glanz erstrahlt. "
  );

  AddDetail( ({"nostalgie"}) ,
    "Nostalgie ist die Sehnsucht an vergangene Zeiten."
  );

  AddDetail( ({"sehnsucht"}) ,
    "Ueberkommt Dich nicht auch die Sehnsucht, wenn Du an die alten "
    "Zeiten denkst? "
  );

  AddDetail( ({"zeit","zeiten"}) ,
    "Im Wohnzimmer befindet sich keine Uhr, so dass Du die Zeit "
    "nicht ablesen kannst. "
  );

  AddDetail( ({"uhr"}) ,
    "Nein, es ist wirklich keine da."
  );

  AddDetail( ({"forscherpunkt","forscherpunkte"}) ,
    "Sowas bekommt man fuers forschen."
  );

  AddDetail( ({"funke","funken"}) ,
    "Ab und zu spruehen Funken aus den Holzscheiten."
  );

  AddDetail( ({"holz"}) ,
    "Hier gibt es Holzscheite, Holzrahmen, Holzbalken und vieles mehr "
    "aus Holz. "
  );

  AddDetail( ({"scheite","holzscheite","holzscheit"}) ,
    "Die Holzscheite liegen im Kamin und verbrennen dort."
  );

  AddSound( ({DEFAULT_SOUND,"kamin","funken","knistern","scheite"
             ,"scheit","holzscheit","holzscheite"}) , #'sound );

  AddCmd( ({"schaukel","schaukele","schaukle"
           ,"wipp","wippe"})                     , "cmd_schaukeln" );
  AddCmd( ({"schubs","schubse"})                 , "cmd_schubsen" );
  AddCmd( ({"steh","stehe","steige","steig"})    , "cmd_aufstehen");
  AddCmd( CMD_SETZEN                             , "cmd_setzen");
  AddCmd( ({"reiss","reisse"})                   , "cmd_reissen");
  AddCmd( ({"schuer","schuere"})                 , "cmd_schueren");
  AddCmd( ({"streich","streiche"})               , "cmd_streichen");
  AddCmd( CMD_OEFFNEN                            , "cmd_oeffnen");
  AddCmd( CMD_NEHMEN                             , "cmd_nehmen");
  AddCmd( ({"hebe","heb","schau","schaue","blick","blicke","siehe","sieh"})
                                                 , "cmd_heben");

  AddExit("westen", ([EX_DEST : ROOM "eingang", EX_TESTFUNC : #'exit_test ]) );

  spieler_faden = ({ });
  stuhl_sitzer  = "";
  feuer         = 3;
  restore_object(ROOM "wohnzimmer");
  setze_temperatur();
}

void setze_temperatur()
{
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18+2*feuer, ENV_TERRAIN: TT_HOUSE]) );
}

void reset()
{
  ::reset();

  if(feuer > 0)
  {
    feuer--;
    setze_temperatur();
  }
  else
  {
    feuer = 0;
  }

  if(stuhl_sitzer = "") AddRoomMessage(0);

  spieler_faden = ({ });

  save_object(ROOM "wohnzimmer");
  return;
}

string sound(string str)
{
  string s;

  if(feuer > 3)
  {
    s = "Leise stieben immer wieder Funken mit einem Knistern im Kamin empor.";
  }
  else
  {
    s = "Es ist absolut ruhig im Wohnzimmer.";
  }
  return BS(s);
}

int exit_test()
{
  if(!objectp(TP)) return 1;
  if(!interactive(TP)) return 1;

  if(stuhl_sitzer == getuuid(TP) )
  {
    TELLPLAYER("Aber Du sitzt doch noch im Schaukelstuhl!\n");
    return 0;
  }

  return 1;
}

int check_if_player(object ob)
{
  return (interactive(ob) && !(ob->QueryProp(P_INVIS)));
}

string detail_feuer(string str)
{
  string s;

  switch(feuer)
  {
    case 0:
      s = "Von einem Feuer zu sprechen ist wohl zuviel, denn zwischen "
          "den Holzscheiten ist nur noch ganz schwach die Glut zu erkennen.";
      break;

    case 1:
      s = "Nur noch vereinzelt zuengeln einzelene Flammen zwischen den "
          "Holzscheiten empor. Es dauert wohl nicht mehr lange, und das "
          "Feuer geht aus.";
      break;

    case 2:
      s = "Kraftlos zuengeln einige Flammen an den Holzscheiten empor, "
          "so richtig brennen tun sie nicht mehr.";
      break;

    case 3:
      s = "Leise knisternd zuengeln die Flammen an den Holzscheiten "
          "empor. Manchmal stieben mit leisem knacken einieg Funken "
          "empor. ";
      break;

    case 4:
      s = "Kraeftig zuengeln die Flammen an den Holzscheiten empor und "
          "und verbreiten eine angenehme Waerme. Laut knisternd stieben "
          "immer wieder Funken nach oben hinweg. ";
      break;

    default:
      s = "Hell lodern brennen die Holzscheite und fallen von Zeit zu "
          "Zeit mit einem lauten Knacken zusammen. Fast ist es direkt "
          "vor dem Kamin schon zu heiss. Laut knisternd stieben Funken "
          "immer wieder nach oben hinweg. " ;
      break;
  }

  return BS(s);
}

string detail_stuhl(string str)
{
  string s,tmp;
  object pl;

  s = "Ein schoener, alter Schaukelstuhl. Da sitzt Oma Wetterwachs "
      "bestimmt oft drin, denn der sieht so richtig bequem aus. "
      "Dass dieser Schaukelstuhl oft benutzt wird, kannst Du am Teppich "
      "sehen, denn da haben die Kufen des Stuhles unuebersehbar "
      "ihre Spuren hinterlassen. ";

  if(stuhl_sitzer != "")
  {
    if(stuhl_sitzer == getuuid(TP))
    {
      s += "Du hast es Dir darin so richtig bequem gemacht.";
    }
    else
    {
      tmp = explode(stuhl_sitzer,"_")[0];
      pl  = find_player(tmp);
      if(pl)
      {
        s += pl->Name()+" schaukelt zufrieden darin.";
      }
      else
      {
        stuhl_sitzer = "";
        AddRoomMessage(0);
      }
    }
  }

  return BS(s);
}

string detail_gaeste(string str)
{
  string s;
  object *spieler;

  spieler = filter_array(all_inventory(TO), "check_if_player") - ({TP});

  switch(sizeof(spieler))
  {
    case 0:
      s = "Ausser Dir ist sonst niemand da.";
      break;

    case 1:
      s = "Ausser Dir ist nur "+spieler[0]->Name()+" da.";
      break;

    default:
      s = "Ausser Dir sind noch "+LW(map_objects(spieler,"name"))+" da.";
      break;
  }

  return BS(s);
}

int cmd_oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");

  if(!str || str == "") return 0;
  if(!(str == "tuer"         ||
       str == "tueren"       ||
       str == "glastueren"   ||
       str == "schrank"      ||
       str == "glastuer"         ))return 0;

  if(!exit_test()) return 1;

  TELLPLAYER(BS("Du versuchst einen der Glasschraenke zu oeffnen, doch "
                "das Glas faengt gefaehrlich an zu vibrieren, so als ob "
                "es gleich aus dem Rahmen fallen wuerde. Da Du nichts "
                "kaputt machen moechtest, schliesst Du die Tuer lieber wieder "
                "vorsichtig und laesst es bleiben. "
  ));
  TELLOTHERS(TPN+" macht sich am Glasschrank zu schaffen.\n");
  MOORMASTER->Msg(TPUID+" versucht den Glasschrank zu oeffnen");
  return 1;
}

int cmd_nehmen(string str)
{
  notify_fail("Was willst Du nehmen?\n");

  if(!str || str == "") return 0;

  if(str == "porzellan"                     ||
     str == "porzellan aus schrank heraus"  ||
     str == "porzellan aus schrank"          )
  {
    if(!exit_test()) return 1;

    TELLPLAYER("Dazu musst Du den Schrank erst oeffnen.\n");
    TELLOTHERS(TPN+" gafft in den Glasschrank hinein.\n");
    MOORMASTER->Msg(TPUID+" gafft in den Glasschrank");
    return 1;
  }

  if(str == "haken"         ||
     str == "feuerhaken"     )
  {
    if(!exit_test()) return 1;

    TELLPLAYER(BS("Der Feuerhaken ist mit einer kleinen Kette an der Wand "
                  "befestigt, damit er immer da bleibt, wo er hingehoert. "
                  "Du koenntest ihn hoechstens abreissen."
    ));
    TELLOTHERS(TPN+" fummelt an dem Feuerhaken herum.\n");
    MOORMASTER->Msg(TPUID+" versucht den Feuerhaken zu nehmen");
    return 1;
  }

  if(str == "deckchen" || str == "tischdeckchen")
  {
    TELLPLAYER("Das Deckchen scheint auf magische Weise am Tisch zu kleben.\n");
    TELLOTHERS(TPN+" fummelt am Tischdeckchen herum.\n");
    MOORMASTER->Msg(TPUID+" versucht das Deckchen zu nehmen");
    return 1;
  }

  if(str == "scheit" || str == "scheite" || str == "holzscheite" ||
     str == "holzscheit" ||
     str == "scheit aus kamin" || str == "scheite aus kamin " ||
     str == "holzscheit aus Kamin")
  {
    TELLPLAYER(BS("Du nimmst einen Holzscheit aus dem Kamin. *AUTSCH* der "
                  "is ja gluehend heiss. Schmerzerfuellt laesst Du ihn "
                  "wieder fallen. "
    ));
    TELLOTHERS(BS(TPN+" nimmt einen gluehenden Holzscheit aus dem Kamin "
                  "und verbrennt sich fuercherlich die Hand. Was das bloss "
                  "sollte?"
    ));
    SetProp(P_KILL_NAME,"Ein gluehender Holzscheit");
    TP->do_damage(50);
    MOORMASTER->Msg(TPUID+" nimmt ein brennendes Holzscheit");
    return 1;
  }

  return 0;
}

int cmd_heben(string str)
{
  notify_fail("Was moechtest Du anheben?\n");

  if(!str || str == "") return 0;
  if(!(str == "teppich"         ||
       str == "teppich hoch"    ||
       str == "teppich auf"     ||
       str == "teppich an"      ||
       str == "unter teppich"   ))return 0;

  if(!exit_test()) return 1;

  TELLPLAYER(BS("Du hebst den Teppich an einer Ecke an und schaust "
                "darunter, findest aber nichts besonderes. "
  ));
  TELLOTHERS(TPN+" hebt den Teppich etwas an. Merkwuerdig, wozu denn blos?\n");
  MOORMASTER->Msg(TPUID+" hebt den Teppich hoch");
  return 1;
}

int cmd_streichen(string str)
{
  object nadel;

  notify_fail("Worueber moechtest Du streichen?\n");

  if(!str || str == "") return 0;
  if(!(str == "ueber flor"         ||
       str == "ueber teppiche"     ||
       str == "ueber teppich"      )) return 0;

  if(!exit_test()) return 1;

  TELLOTHERS(TPN+" befuehlt den Teppich.\n");

  if(member(spieler_faden,getuuid(TP)) > -1)
  {
    TELLPLAYER("Du streichst ueber den Teppich. Hmmm, ja, der ist wirklich "
               "sehr samtig.\n");
    return -1;
  }

  TELLPLAYER(BS("Du streichst ueber den Teppich. Hmmm, ja, der ist wirklich "
                "sehr samtig. *Autsch* Irgendetwas hat Dich in den Finger "
                "gestochen. Vorsichtig ziehst Du eine Nadel mit Faden aus "
                "dem Teppich. Die muss Oma Wetterwachs wohl verloren haben. "
  ));

  TP->AddHp(-10);
  nadel = clone_object(OBJ "nadelfaden");

  if(ME_TOO_HEAVY==nadel->move(TP,M_GET|M_SILENT))
  {
    TELLPLAYER("Selbst diese kleine Nadel ist zu schwer fuer Dich, "
               "Du Schwaechling.\n");
    nadel->remove();
    return -1;
  }

  spieler_faden += ({ getuuid(TP) });
  MOORMASTER->Msg(TPUID+" findet Nadel und Faden");
  return 1;
}

int cmd_schueren(string str)
{
  notify_fail("Was willst Du schueren?\n");

  if(!str || str == "") return 0;
  if(!(str == "feuer"                 ||
       str == "feuer mit haken"       ||
       str == "feuer mit feuerhaken"  ))return 0;

  if(!exit_test()) return 1;

  if(feuer > 3)
  {
    TELLPLAYER("Das Feuer lodert noch hell und kraeftig, es braucht "
               "nicht geschuert zu werden.\n");
    TELLOTHERS(TPN+" spielt mit dem Feuerhaken herum.\n");
    return -1;
  }

  TELLPLAYER(BS("Du nimmst den Feuerhaken und schuerst damit kraeftig das "
                "Feuer. Hell lodert es wieder auf."));
  TELLOTHERS(BS(TPN+" schuert das Feuer mit dem Feuerhaken. Hell lodert "
                "es wieder auf."));
  MOORMASTER->Msg(TPUID+" schuert das Feuer");
  feuer = 5;
  setze_temperatur();
  return 1;
}

int cmd_reissen(string str)
{
  int n;
  string was,wovon;

  notify_fail("Was moechtest Du wovon abreissen?\n");

  if(!str || str == "") return 0;

  if(str == "haken" || str = "feuerhaken")
  {
    was   = "haken";
    wovon = "kette";
    n     = 2;
  }
  else
  {
    n = sscanf(str, "%s von %s", was, wovon);
    if(n!=2) n=sscanf(str, "%s von %s ab", was, wovon);
  }

  if(n != 2) return 0;
  if(!(was == "haken" || was == "feuerhaken" )) return 0;
  if(!(wovon =="wand" || wovon == "kette"    )) return 0;

  if(!exit_test()) return 1;

//  TELLPLAYER("+++"+was+"+++"+wovon+"+++\n");

  TELLPLAYER(BS("Du versuchst den Feuerhaken loszureissen, doch die Kette "
                "ist stabiler als Du gedacht hast."
  ));
  TELLOTHERS(TPN+" reisst wie wild an dem Feuerhaken herum.\n");
  MOORMASTER->Msg(TPUID+" versucht den Feuerhaken abzureissen");
  return 1;
}

int setze_auf_couch()
{
  if(!exit_test()) return 1;

  TELLPLAYER(BS("Du setzt Dich auf die Couch, sinkst aber in den weichen "
                "Polstern sofort tief ein. Das ist Dir viel zu unbequem, "
                "daher stehst Du sofort wieder auf. "
  ));
  TELLOTHERS(TPN+" setzt sich auf die Couch, steht aber sofort wieder auf.\n");
  MOORMASTER->Msg(TPUID+" versucht sich auf die Couch zu setzen");
  return 1;
}

int setze_in_stuhl()
{
  string tmp;
  object pl;

  if(stuhl_sitzer == getuuid(TP) )
  {
    TELLPLAYER("Du sitzt doch schon laengst im Schaukelstuhl!\n");
    return -1;
  }

  if(stuhl_sitzer != "")
  {
    tmp = explode(stuhl_sitzer,"_")[0];
    pl = find_player(tmp);
    if(!pl)
    {
      stuhl_sitzer = "";
      AddRoomMessage(0);
    }
  }

  if(stuhl_sitzer != "")
  {
    tell_object(TP,BS("Da sitzt aber schon "+pl->Name()+" drin. Wenn Du "
                  "auch unbedingt im Schaukelstuhl sitzen willst "
                  "dann musst Du schon "+pl->QueryPronoun(WEN)+
                  " aus dem Schaukelstuhl schubsen. "
    ));

    tell_room(TO,TPN+" schaut luestern auf den Schaukelstuhl.\n", ({TP}) );

    return -1;
  }

  TELLPLAYER("Du setzt Dich in den Schaukelstuhl.\n");
  TELLOTHERS(TPN+" setzt sich in den Schaukelstuhl. Hmmm, da wuerdest Du "
             "gerne sitzen.\n");
  stuhl_sitzer = getuuid(TP);
  AddRoomMessage( ({ "Der Schaukelstuhl knarrt etwas.\n"}), 60 );
  MOORMASTER->Msg(TPUID+" setzt sich in den Schaukelstuhl");
  return 1;
}

int cmd_setzen(string str)
{
  notify_fail("Worauf willst Du Dich setzen?\n");

  if(!str || str == "") return 0;

  if(str == "sofa"              ||
     str == "auf sofa"          ||
     str == "aufs sofa"         ||
     str == "couch"             ||
     str == "auf couch"         ) return setze_auf_couch();

  if(str == "schaukelstuhl"     ||
     str == "in schaukelstuhl"  ||
     str == "auf schaukelstuhl" ||
     str == "stuhl"             ||
     str == "in stuhl"          ||
     str == "auf stuhl"         ) return setze_in_stuhl();

  return 0;
}

int cmd_aufstehen(string str)
{
  notify_fail("Aber Du sitzt doch gar nicht im Schaukelstuhl?\n");

  if(!str || str == "") return 0;
  if(!(str == "auf"                    ||
       str == "aus stuhl"              ||
       str == "aus stuhl auf"          ||
       str == "aus schaukelstuhl"      ||
       str == "aus schaukelstuhl auf"  ))return 0;

  if(stuhl_sitzer != getuuid(TP)) return 0;

  TELLPLAYER("Seufzend stehst Du wieder aus dem Schaukelstuhl auf.\n");
  TELLOTHERS(TPN+" steht traurig vom Schaukelstuhl auf.\n");
  MOORMASTER->Msg(TPUID+" steht aus dem Schaukelstuhl auf");
  AddRoomMessage(0);
  stuhl_sitzer = "";
  return 1;
}

int cmd_schubsen(string str)
{
  int n;
  string wen,was;
  object pl;

  notify_fail("Wen moechtest Du aus dem Schaukelstuhl schubsen?\n");

  if(!str || str == "") return 0;

  was = "stuhl";
  n = sscanf(str, "%s raus", wen);
  if(n!=1){n = sscanf(str, "%s hinaus", wen);}

  if(n!=1) n = sscanf(str, "%s aus %s", wen,was);
  if(n!=2) n = sscanf(str, "%s aus %s hinaus", wen,was);
  if(n!=2) n = sscanf(str, "%s aus %s heraus", wen,was);
  if(n!=2) n = sscanf(str, "%s aus %s raus", wen,was);
  if(n!=2) return 0;

  if(!(was == "stuhl" || was == "schaukelstuhl")) return 0;

  if(stuhl_sitzer == "")
  {
    TELLPLAYER("Aber es sitzt doch niemand im Schaukelstuhl!\n");
    return -1;
  }

  if(!(pl = find_player(wen)))
  {
    TELLPLAYER(CAP(wen)+" ist doch gar nicht da.");
    return -1;
  }

  if(stuhl_sitzer != getuuid(pl))
  {
    TELLPLAYER(CAP(wen)+" sitzt doch gar nicht im Schaukelstuhl.\n");
    return 1;
  }

  wen = pl->Name();

  if(TP->QueryAttribute(A_STR)-5+random(10) >
     pl->QueryAttribute(A_STR) )
  {
    tell_object(TP,"Du wirfst "+pl->Name(WEN)+" unsanft aus dem Schaukelstuhl.\n");
    tell_object(pl,TPN+" wirft Dich unsanft aus dem Schaukelstuhl. So eine Gemeinheit!\n");
    tell_room(TO,TPN+" wirft "+pl->Name(WEN)+" unsanft aus dem Schaukelstuhl.\n", ({TP,pl}) );
    stuhl_sitzer = "";
    AddRoomMessage(0);
    MOORMASTER->Msg(TPUID+" schubst "+pl->Name(WEN)+" aus dem Schaukelstuhl");
  }
  else
  {
    tell_object(TP,BS("Du wuerdest "+pl->Name(WEN)+" gerne aus dem Schaukelstuhl werfen, "
                      "aber "+pl->QueryPronoun()+" haelt sich zu gut fest."));
    tell_object(pl,TPN+" schaukelt Dich wild im Schaukelstuhl. Was soll denn das?\n");
    tell_room(TO,BS(TPN+" schaukelt "+pl->Name(WEN)+" heftig im Schaukelstuhl. Ob "+CAP(TPP(WER))+
                    " "+pl->QueryPronoun()+" aus dem Schaukelstuhl werfen will? Wenn ja, dann ist "+
                    CAP(TPP(WER))+" viel zu schwach dafuer."
                   ), ({TP,pl}) );
    MOORMASTER->Msg(TPUID+" versucht "+pl->Name(WEN)+" aus dem Schaukelstuhl zu schubsen");
  }

  return 1;

}

int cmd_schaukeln(string str)
{
  int i;
  object *spieler;

  notify_fail("Wo willst Du schaukeln?\n");

  if(!str) str = "";

  if(!(str == "schaukelstuhl"         ||
       str == "stuhl"                 ||
       str == "in schaukelstuhl"      ||
       str == "in stuhl"              ||
       str == ""                      )) return 0;

  if(stuhl_sitzer != getuuid(TP))
  {
    TELLPLAYER("Aber Du sitzt doch gar nicht im Schaukelstuhl.\n");
    TELLOTHERS(TPN+" wankt hin und her.\n");
    return -1;
  }

  if(random(10) > 4)
  {
    TELLPLAYER("Du schaukelst genuesslich in dem Schaukelstuhl.\n");
    TELLOTHERS(BS(TPN+" schaukelt zufrieden im Schaukelstuhl. Das wuerdest Du "
                  "jetzt auch gerne machen."));
    MOORMASTER->Msg(TPUID+" schaukelt im Schaukelstuhl");
  }
  else
  {
    TELLPLAYER(BS("Du schaukelst viel zu heftig, faellst aus dem "
                  "Schaukelstuhl heraus - und landest mit allen vieren "
                  "von Dir gestreckt auf dem Teppich."
    ));
    TELLOTHERS(BS(TPN+" schaukelt viel zu heftig und faellt aus dem "
               "Schaukelstuhl und landet alle viere von sich gestreckt-"
               "auf dem Teppich."
    ));
    MOORMASTER->Msg(TPUID+" faellt aus dem Schaukelstuhl");
    stuhl_sitzer = "";
    AddRoomMessage(0);

    spieler = filter_array(all_inventory(TO), "check_if_player");

    i = sizeof(spieler);
    while(i--){if(spieler[i] != TP)spieler[i]->command_me("lach");}
  }

  return 1;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(stuhl_sitzer == getuuid(player))
  {
    stuhl_sitzer = "";
    AddRoomMessage(0);
  }
  return;
}

void BecomesNetDead(object player)
{
  if(stuhl_sitzer == getuuid(player))
  {
    stuhl_sitzer = "";
    AddRoomMessage(0);
  }
  return;
}

