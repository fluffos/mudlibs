
#include <properties.h>
#include <combat.h>
#include <language.h>

#include "../def.h"

inherit "std/weapon";

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Harke");
  SetProp(P_LONG,
    "Eine ganz normale Harke, wie man sie im Garten braucht, um allerlei Dinge zu harken."
  );
  SetProp(P_NAME, "Harke");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"harke", "\nHARKE"}) );

  SetProp(P_VALUE, 70);
  SetProp(P_WEIGHT, 1500);
  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_WC, 20);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_WOOD:60, MAT_IRON:40]) );

  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP,1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_NOSELL,1);

}




