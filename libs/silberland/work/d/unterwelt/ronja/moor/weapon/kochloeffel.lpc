#include "../def.h"

inherit "std/weapon";

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Suppenloeffel");
  SetProp(P_LONG,
    "Ein ganz normaler Kochloeffel aus Holz. Oder? Ob nicht eventuell doch "
    "ein wenig Magie dabei ist? Oder gar ein getarnter Zauberstab?"
  );

  SetProp(P_NAME, "Kochloeffel");
  SetProp(P_GENDER, MALE);
  AddId( ({"kochloeffel", "loeffel"}) );

  SetProp(P_WC_BONUS, (["\nWETTERWACHS": 170]) );
  SetProp(P_WEAPON_TYPE, WT_MISC );
  SetProp(P_WC, 45);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_WOOD : 100]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 2);
}
