/*

  Der Mithrilsaebel um dem Riesen das Herz rauszuschneiden Zordan@SL

*/

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "../def.h"

create() {
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Ein funkelnder Mithrilsaebel");
  SetProp (P_LONG,
    "Ein Mithrilsaebel ist mit Sicherheit eine sehr gefuerchtete Waffe fuer "
    "jeden Gegner. Mit ihm kann man bestimmt einem Gegner das Herz "
    "herausschneiden. Sein Griff ist mit einer Menge Edelsteine versetzt. " );
  SetProp(P_INFO, BS("Das Mithrilschwert ist mit einer besonders auffaelligen "
                     "Aura umgeben." ) );
  SetProp (P_NAME, "Mithrilsaebel");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 7000);
  SetProp (P_WEIGHT, 800);
  SetProp (P_WEAPON_TYPE, WT_SWORD);
  AddId ( ({ "saebel", "mithrilsaebel","\n_quest_saebel" }) );
  SetProp (P_DAM_TYPE, DT_SLASH);
  SetProp (P_WC, 160);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, ([MAT_MISC_JEWEL:10, MAT_OCTARINE:30, MAT_MITHRIL:60]) );
  SetProp (P_WIELD_RESTRICTIONS, ([A_STR:15,A_DEX:15]) );
}

