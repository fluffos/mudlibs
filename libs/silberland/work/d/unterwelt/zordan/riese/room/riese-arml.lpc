
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Am linken Arm des Riesen" );
  SetProp( P_INT_LONG, "Vorsichtig erkletterst Du den linken Arm des Riesen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21]) );

  AddExit( "links", "zur Brust#"+"./riese-brust" );
}
