
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "An einer Haengebruecke" );
  SetProp( P_INT_LONG,
    "Du stehst jetzt auf dem Plateau direkt an einer Haengebruecke, welche durch "
    "dicke Pfosten am Plateau befestigt ist. Ziemlich normal wuerdest Du diesen "
    "Platz ansehen, waere da nicht dieses gewisse Etwas in der Luft." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddExit( "norden",     "./plateau-e2" );
  AddExit( "westen",     "./plateau-d3" );
  AddExit( "nordwesten", "./plateau-d2" );
  AddGuardedExit( "suedosten", "./bruecke1" ,"brueckenwaechter", "@@waechter@@");

#include "plateau.h"

  AddDetail( ({ "haengebruecke","bruecke" }),
    "Die Haengebruecke ist hier an zwei dicken Pfosten befestigt. Sie besteht "
    "aus dicken Holzplanken und ein paar Seilen." );

  AddDetail( ({ "pfosten" }),
    "Die beiden Pfosten sind tief in den Boden gerammt und halten so die "
    "ganze Bruecke." );

  AddDetail( ({ "holz" }),
    "Ganz normales Holz. Allerdings sieht es schon uralt aus. Dafuer ist es "
    "aber komischerweise bisher nicht verrottet. Seltsam." );

  AddDetail( ({ "holzplanken","planken","ueberschreiten" }),
    "Dicke Holzplanken ermoeglichen das relativ bequeme Ueberschreiten der "
    "Schlucht zwischen dem Plateau und einer in der Ferne zu sehende "
    "Felsplatte." );

  AddDetail( ({ "schlucht" }),
    "Die Schlucht ist etwa 20 Meter breit. Nach unten geht es unendlich weit." );

  AddDetail( ({ "ferne","felsplatte" }),
    "In der Ferne kannst Du soetwas wie eine Felsplatte und einen grossen "
    "Schatten sehen." );

  AddDetail( ({ "schatten" }),
    "Leider kannst Du von hier aus nichts genaueres erkennen. Du muesstest "
    "schon todesmutig ueber die arg schwankende Bruecke gehen." );

  AddDetail( ({ "platz" }),
    "Also hier wuerde ich sicher nicht rumideln !!" );

  AddDetail( ({ "etwas" }),
    "Das Etwas in der Luft kuendigt Tot und Verderben an. Solltest Du es "
    "jemals wagen, ueber die Bruecke zu gehen, dann solltest Du echt mit "
    "allem rechnen. Auch mit einem Besuch bei Lars." );

  AddDetail( ({ "tot","verderben","stimme" }),
    "Eine innere Stimme sagt Dir, dass davon besonders viel auf der anderen "
    "Seite der Bruecke ist." );

  AddDetail( ({ "seite" }),
    "Da kommst Du natuerlich nur ueber die Bruecke hin. Rueberspringen ist "
    "einfach unmoeglich. Dafuer ist die Schlucht zu breit." );

  AddDetail( ({ "lars","kerl","besuch" }),
    "Ein kleiner netter Kerl, den Du vielleicht auf der anderen Seite der Bruecke "
    "kennenlernen wirst." );

  AddDetail( ({ "luft","hauch" }),
    "Ein gewisser Hauch von Tot liegt in der Luft." );

  AddDetail( ({ "seile" }),
    "Die Seile halten einmal die Holzplanken und einmal sind sie dafuer da, "
    "dass man sich beim Ueberqueren der Bruecke festhalten kann. Denn die "
    "Bruecke schwankt so stark, dass man sehr leicht runterfallen kann. Ein "
    "Seil sieht irgendwie anders aus." );

  AddDetail( ({ "seil","sterne" }),
    "Ohoh, das Seil ist ein wenig angeritzt worden. Ob es Dich noch sicher "
    "tragen kann, steht in den Sternen." );

  AddDetail( ({ "ueberqueren","author","gewaehr" }),
    "Ueberqueren kann man zumindest mal versuchen. Aber der Author gibt "
    "keine Gewaehr, dass die Bruecke haelt." );

  AddItem( NPC "bwaechter" , REFRESH_DESTRUCT);

}

string waechter() {
  if (present("\n_erlaubnis",TP)) {
    write("Der Waechter sagt: Ahja, Du hast die Erlaubnis zu passieren.\n");
    TP->move( ROOM "bruecke1" , M_GO, 0,
        "grinst den Waechter an und geht nach Suedosten", 
        "kommt wankend auf die Bruecke");
    return "Der Waechter ruft Dir nach: Viel Glueck !\n";
  }
  if (TP->QueryAttribute(A_INT)<15) {
    return "Der Waechter sagt: Du bist nicht intelligent genug !\n";
  }
  if (TP->QueryAttribute(A_STR)<15) {
    return "Der Waechter sagt: Du bist nicht stark genug !\n";
  }
  if (TP->QueryAttribute(A_DEX)<15) {
    return "Der Waechter sagt: Du bist nicht geschickt genug !\n";
  }
  if (TP->QueryAttribute(A_CON)<15) {
    return "Der Waechter sagt: Du bist nicht ausdauernd genug !\n";
  }
  return "Der Waechter schreit: Du brauchst die Erlaubnis von Sica !\n";
}
