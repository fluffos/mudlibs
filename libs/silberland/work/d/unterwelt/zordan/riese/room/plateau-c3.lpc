
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Am Anfang eines Plateaus" );
  SetProp( P_INT_LONG,
    "Du stehst jetzt ganz am Anfang im Westen des kleinen Plateaus. "
    "Der Boden wird hier schon unebener, aber es ist immer noch eine "
    "Leichtigkeit, sich hier zu bewegen. Im Norden steht in einiger "
    "Entfernung ein kleines Gebilde und im Osten ein etwas eigenartig "
    "aussehender Felsblock." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddExit( "nordwesten", "./plateau-b2" );
  AddExit( "nordosten",  "./plateau-d2" );
  AddExit( "osten",      "./plateau-d3" );
  AddExit( "suedosten",  "./plateau-d4" );

#include "plateau.h"

  AddDetail( ({ "anfang" }),
    "Erst hier faengt das Plateau so richtig an. Es breitet sich in alle "
    "oestlichen Richtungen weiter aus." );

  AddDetail( ({ "richtungen" }),
    "Die da waeren Osten, Nordosten und Suedosten." );

  AddDetail( ({ "leichtigkeit" }),
    "Du kannst Dich hier wirklich leicht bewegen. Kleine Steine liegen zwar "
    "im Weg, aber die stoeren eigentlich nicht weiter." );

  AddDetail( ({ "steine" }),
    "Verschiedene Steine liegen hier auf dem Boden herum. Aber Du beachtest "
    "sie nicht weiter, da sie eigentlich voellig wertlos fuer Dich sind." );

  AddDetail( ({ "weg","ziel" }),
    "Der Weg ist das Ziel, oder andersrum ?" );

  AddDetail( ({ "entfernung","stueck" }),
    "Das Gebilde ist noch ein gutes Stueck entfernt. Von hier aus siehst "
    "Du noch keine Moeglichkeit, es naeher zu untersuchen." );

  AddDetail( ({ "moeglichkeit" }),
    "Die wird sich ja vielleicht weiter im Osten ergeben. Wer weiss das schon. "
    "Oder aber Du geraetst immer tiefer in Schwierigkeiten hinein und kommst "
    "nicht mehr heraus..." );

  AddDetail( ({ "schwierigkeiten" }),
    "Noch kannst Du keine entdecken. Aber wer weiss schon, was noch so alles "
    "kommt." );

  AddDetail( ({ "gebilde" }),
    "Leider kannst Du von hier aus noch nichts erkennen. Aber Du kannst "
    "erkennen, dass ein wenig Rauch aus dem Gebilde aufsteigt." );

  AddDetail( ({ "rauch" }),
    "Er saeuselt es dem Gebilde heraus und verschwindet in der Dunkelheit." );

  AddDetail( ({ "felsblock" }),
    "Der Felsblock im Osten sieht schon komisch aus. Vielleicht solltest "
    "Du mal hingehen und ihn naeher untersuchen." );

}
