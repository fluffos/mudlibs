
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int glitz_found;

reset() {
  ::reset();
  glitz_found=0;
}

create() {
  ::create();

  glitz_found=0;

  SetProp( P_INT_SHORT, "Ein kleiner Vorsprung" );
  SetProp( P_INT_LONG,
    "Du bist vom Plateau aus direkt in ein grosses Nest gesprungen. Ein "
    "recht grosser Greifvogel bewacht hier seinen Nachwuchs. An der Felswand "
    "kannst Du sicher wieder leicht nach oben klettern. Es scheint hier "
    "besonders warm zu sein." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 36, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Der gesamte Boden ist mit einem riesigen Nest ausgestattet." );

  AddDetail( ({ "wand","waende","felswand" }),
    "Die Waende der Hoehle kannst Du auch von hier aus nicht erkennen. Die "
    "Felswand kannst Du allerdings leicht wieder raufklettern." );

  AddDetail( ({ "decke" }),
    "Die Decke der Hoehle kannst Du nicht erkennen." );

  AddDetail( ({ "hoehle","ausmass" }),
    "Die Hoehle ist einfach nur gigantisch gross. Niemals wird man wohl "
    "ihr gesamtes Ausmass erkunden." );

  AddDetail( ({ "plateau" }),
    "Das ist oben. Du musst schon wieder raufklettern, um dort wieder "
    "hinzukommen." );

  AddDetail( ({ "nest","durchmesser" }),
    "Das Nest ist etwa zwei Meter im Durchmesser. Ein grosser Vogel sitzt "
    "darin neben seinem Nachwuchs. Zwischen den Voegeln scheint etwas zu "
    "glitzern. Das macht Dich schon ein wenig neugierig." );

  AddDetail( ({ "nachwuchs","groesse" }),
    "Fuer den grossen Vogel kleiner Nachwuchs. Aber fuer normale Voegel "
    "haben sie schon eine beachtliche Groesse erreicht." );

  AddDetail( ({ "voegel" }),
    "Der grosse Vogel ist schon fast einen Meter gross. Der Nachwuchs ist "
    "dagegen mit seiner Armlaenge noch recht klein geraten." );

  AddDetail( ({ "armlaenge","zentimeter" }),
    "Eine Armlaenge entpricht etwa vierzig Zentimetern." );

  AddDetail( ({ "meter" }),
    "Na wieviel ein Meter ist, wirst Du ja wohl noch wissen .." );

  AddItem( NPC "vnachwuchs" , REFRESH_DESTRUCT);
  AddItem( NPC "vnachwuchs" , REFRESH_DESTRUCT);
  AddItem( NPC "greifvogel" , REFRESH_DESTRUCT);

  AddSpecialDetail( ({ "glitzern" }), "glitzerfkt" );
  AddSpecialDetail( ({ "klinge" }),   "klingefkt" );

  AddCmd( ({ "kletter","klettere" }),        "kletterfkt" );
  AddCmd( ({ "greif","greife" }), "greiffkt" );


}

kletterfkt(string str) {
  object ob;
  notify_fail("Wohin moechtest Du klettern ?\n");
  if( str=="rauf" || str=="felswand" || str == "felswand rauf" || str=="hoch" ) {
    write( "Du kletterst die Felswand wieder rauf.\n" );
    TP->move( ROOM "plateau-d4" , M_GO, 0,
        "klettert die Felswand rauf", 
        "kommt von unten rauf");
    if (ob=present("\n_ablenken",TP)) {
      ob->remove();
    }
    return 1;
  } 
  return 0;
}

glitzerfkt(string str) {
  if (!glitz_found) {
    return BS("Bei dem Glitzern scheint es sich um eine kleine Klinge zu "
          +"handeln. Du koenntest versuchen sie zu greifen.");
  } 
  return "Hm, Du musst Dich wohl getaeuscht haben.\n";
}

klingefkt(string str) {
  if (!glitz_found) {
    return BS("Wo soll hier eine Klinge sein?\n");
  } 
  return "Die Klinge liegt mitten im Nest. Du koenntest nach ihr greifen.\n";
}

greiffkt(string str) {
  notify_fail("Nach was moechtest Du greifen ?\n");
  if( (str=="nach klinge" || str=="klinge") && (!glitz_found) ) {
    if ((present("\n_quest_klinge",TP)) || ((!present("\n_leader",TP)) && (!present("\n_helper",TP)))) {
      write( "Du greifst nach der Klinge doch ein kleiner Vogel sitzt genau drauf.\n" );
      say(CAP_TPN+" greift nach etwas doch zieht die Hand vorsichtig zurueck.\n");
    } else {
      glitz_found=1;
      write( "Du greifst nach der Klinge und steckst sie ein.\n" );
      say(CAP_TPN+" greift nach etwas und steckt es ein.\n");
      CLONE(OBJ "klinge",TP);
    }
    return 1;
  } 
  return 0;
}
