
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Am Kopf des Riesen" );
  SetProp( P_INT_LONG, "Du kletterst weiter zum Kopfbereich des Riesen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21]) );

  AddExit( "unten",     "zur Brust#"+"./riese-brust" );
}
