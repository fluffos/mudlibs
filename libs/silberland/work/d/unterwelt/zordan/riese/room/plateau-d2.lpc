
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int situation,detail;

reset() {
  ::reset();
  situation=0;
  detail=0;
}

create() {
  ::create();

  situation=0;
  detail=0;

  SetProp( P_INT_SHORT, "Auf einem Plateau" );
  SetProp( P_INT_LONG,
    "Leicht bergab geht es hier nach Norden weiter. Das kleine Plateau bietet "
    "an dieser Stelle nicht viele Besonderheiten. Fast koennte man entspannt "
    "hier ausruhen. Aber der Schein kann sich sicherlich schnell in eine "
    "gefaehrliche Situation verwandeln." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddExit( "norden",     "./plateau-d1" );
  AddExit( "suedosten",  "./plateau-e3" );
  AddExit( "osten",      "./plateau-e2" );
  AddExit( "sueden",     "./plateau-d3" );
  AddExit( "suedwesten", "./plateau-c3" );

#include "plateau.h"

  AddDetail( ({ "stelle" }),
    "Eigentlich koennte man sich hier sogar ziemlich wohl fuehlen. Aber "
    "beklemmende Angst kommt auf einmal in Dir auf." );

  AddDetail( ({ "angst" }),
    "Du kannst Deine Zaehne kaum noch zusammenhalten, so ein arger Schauer "
    "laeuft Dir den Ruecken runter." );

  AddDetail( ({ "schauer","ruecken" }),
    "Erschrocken blickst Du Dich um. Puh, das war zum Glueck nur Einbildung." );

  AddDetail( ({ "glueck" }),
    "Hast Du ein Glueck, da war wohl wirklich nichts." );

  AddDetail( ({ "einbildung" }),
    "So langsam wirst Du schon ganz verrueckt davon und entscheidest Dich, "
    "schnell weiterzugehen." );

  AddDetail( ({ "besonderheiten" }),
    "Hier gibt es eingentlich keine. Erwaehnenswert ist eigentlich nur das "
    "kleine Zelt im Westen." );

  AddDetail( ({ "zelt" }),
    "Nanu, wie kommt hier ein Zelt her ? Von hier kannst Du es allerdings "
    "nicht erreichen." );

  AddDetail( ({ "schein" }),
    "Im Schein des Lichtes siehst Du ein grausames Ungeheuer." );

  AddDetail( ({ "licht" }),
    "Das Licht erhellt das Plateau nur wenig, aber ausreichend." );

  AddDetail( ({ "ungeheuer" }),
    "Ein riesiger Vogel kommt auf Dich zugeflogen." );

  AddDetail( ({ "vogel" }),
    "Der Vogel ist jetzt schon sehr nah. Seine Krallen versuchen Dich zu "
    "erwischen und den Rand runter zu werfen." );

  AddDetail( ({ "krallen" }),
    "Nicht nur die Krallen sind ungeheuer gross, auch sein grosser Schnabel "
    "koennte Dich sofort toeten." );

  AddDetail( ({ "schnabel" }),
    "Der Vogel schreit noch einmal kurz auf und verschwindet dann wieder. "
    "Soviel Glueck hat man selten." );

  AddSpecialDetail( "situation" , "detailfkt" );

  AddCmd( ({ "j","ja","nick" }), "situationfkt" );
}

situationfkt(string str) {
  object ob;
  if (situation==0 && detail==1) {
    write( "Wie Du willst: Ein fast unsichtbarer Geist kommt und gibt Dir Saures.\n" );
    say( TPN+" fordert sein Glueck heraus und wird angegriffen.\n" );
    (ob=clone_object(NPC "geist"))->move(environment(TP), M_NOCHECK);
    TP->AddPursuer(ob);
    situation=1;
    return 1;
  } 
  return 0;
}

string detailfkt(string str) {
  detail=1;
  return "Moechtest Du wirklich in solch eine kommen ???? Dann nicke JETZT !\n" ;
}