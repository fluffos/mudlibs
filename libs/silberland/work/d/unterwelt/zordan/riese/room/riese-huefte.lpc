
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "An der Huefte des Riesen" );
  SetProp( P_INT_LONG, "Du erreichst den Hueftbereich des Riesen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21]) );

  AddExit( "oben",        "zur Brust#"+"./riese-brust" );
  AddExit( "rechtsunten", "zum linken Bein#"+"./riese-beinl" );
  AddExit( "linksunten",  "zum rechten Bein#"+"./riese-beinr" );
}
