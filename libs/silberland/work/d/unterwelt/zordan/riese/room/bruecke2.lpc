
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Eine Haengebruecke" );
  SetProp( P_INT_LONG,
    "Du hangelst Dich auf einer Haengebruecke weiter in die Mitte. Die Planken "
    "unter Dir knirschen schon ganz schoen. Zwei Seile sind neben Dir angebracht. "
    "Du kannst weder den Boden noch die Decke sehen. Ein unwohles Gefuehl kommt "
    "in Dir auf." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

#include "bruecke.h"

  AddDetail( ({ "mitte" }),
    "Du stehst jetzt ziemlich genau in der Mitte der Haengebruecke. Hier "
    "schwankt es wirklich sehr stark ! Du solltest unbedingt sehr schnell "
    "weitergehen !" );

  AddSmell( ({ DEFAULT_SMELL }),
    "Es riecht nach Tod und Verwesung." );

  AddSmell( ({ "tod","verwesung" }),
    "Hier riecht es wirklich unangenehm. Besser Du gehst schnell, bevor "
    "Du auch bald so riechst." );

  AddSound( ({ DEFAULT_SOUND }),
    "Du hoerst unendlich viele Stimmen." );

  AddSound( ({ "stimmen" }),
    "Die Stimmen dringen von ueberall an Dein Ohr. Sie schreien, jammern, "
    "fluchen und wimmern. Aber niemand ist zu erkennen." );

  AddExit( "suedosten",    "./bruecke3" );
  AddExit( "nordwestoben", "./bruecke1" );
  AddExit( "nordwesten",   "./bruecke1" );

  SetProp( P_HIDE_EXITS, ({ "nordwesten" }));
}
