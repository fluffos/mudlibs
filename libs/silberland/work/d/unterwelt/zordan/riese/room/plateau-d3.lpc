
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int greifen;

reset() {
  ::reset();
  greifen=0;
}

create() {
  ::create();

  greifen=0;

  SetProp( P_INT_SHORT, "Mitten auf einem Plateau" );
  SetProp( P_INT_LONG,
    "Wagemutig hast Du Dich genau auf die Mitte des kleinen Plateaus getraut. "
    "Hier befindet sich ein mittelgrosser Felsblock, der ein komisches "
    "Aussehen hat. Seltsam, im Osten scheint sich doch tatsaechlich eine "
    "Konstruktion zu befinden." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddExit( "norden",     "./plateau-d2" );
  AddExit( "nordosten",  "./plateau-e2" );
  AddExit( "osten",      "./plateau-e3" );
  AddExit( "sueden",     "./plateau-d4" );
  AddExit( "westen",     "./plateau-c3" );

#include "plateau.h"

  AddDetail( ({ "mitte" }),
    "Mitten auf dem Plateau stehst Du jetzt. Von hier aus hast Du einen recht "
    "guten Ausblick. Im Osten kannst Du eine Konstruktion sehen." );

  AddDetail( ({ "felsblock","block" }),
    "Der Felsblock scheint nicht ganz natuerlich hier hergekommen zu sein. "
    "Das zeigen Dir die unwirklichen Uebergaenge des Bodens zum Block. "
    "Irgendjemand oder Irgendetwas muss den Felsblock hierher gebracht "
    "haben." );

  AddDetail( ({ "uebergaenge","uebergang" }),
    "Die Uebergaenge zeigen ganz deutlich, dass der Felsblock nicht "
    "hierhergehoert. Ein Uebergang faellt Dir durch einen grossen Spalt "
    "besonders auf." );

  AddDetail( ({ "spalt" }),
    "In dem Spalt ist es sehr dunkel. Ob sich da etwas drin befindet ?" );

  AddDetail( ({ "irgendjemand","jemand" }),
    "Du ueberlegst: Ein Jemand kann soetwas nicht schaffen. Dafuer ist der "
    "Felsblock einfach zu schwer." );

  AddDetail( ({ "irgendetwas" }),
    "Du bist Dir sicher, dass eine uebernatuerliche Kraft diesen Felsblock "
    "hierhergebracht hat. Aber zu welchem Grund nur ?" );

  AddDetail( ({ "kraft" }),
    "Die muss wirklich gigantisch gewesen sein !" );

  AddDetail( ({ "grund" }),
    "Du schaust Dir den Felsblock noch genauer an und kannst sehen, dass er "
    "mit einem gewaltigen Rumms hier gelandet sein muss." );

  AddDetail( ({ "rumms" }),
    "Du schaust nach oben zur Decke. Aber da ist ja nichts. Aber was war das ? "
    "Ein Schatten hat sich sehr weit im Osten bewegt." );

  AddDetail( ({ "schatten" }),
    "Also wenn der Schatten so weit weg ist, dann muss das, was den Schatten "
    "erzeugt, sehr sehr gross sein." );

  AddDetail( ({ "aussehen" }),
    "Das Aussehen des Blockes ist wirklich seltsam. Er gehoert hier irgendwie "
    "nicht her." );

  AddDetail( ({ "konstruktion" }),
    "Du vermutest sehr vage, dass es eine Bruecke sein koennte. Aber Du bist "
    "Dir da nicht ganz sicher." );

  AddDetail( ({ "bruecke" }),
    "Also um das genau herauszufinden, muss Du schon nach Osten gehen." );

  AddDetail( ({ "ausblick","richtungen" }),
    "Du erkennst, dass sich im Nordosten des Plateaus noch was befindet. "
    "Was es ist, kannst Du aber von hier nicht sehen. Desweiteren breitet "
    "sich das Plateau in fast alle Richtungen aus, wobei im Nordwesten "
    "auch noch etwas zu sein scheint." );

  AddCmd( ({ "greif","greife" }), "greifenfkt" );
}

greifenfkt(string str) {
  object ob;
  notify_fail("Wo willst Du reingreifen?\n");
  if( str=="in spalt"||str=="in spalte" ) {
    greifen++;
    switch(greifen) {
     case 1:
      write(BS("Du greifst in den Spalt und schreist schmerzerfuellt auf. "
               "Der Spalt ist die Wohnung von ein paar Spinnen, die Dich "
               "auch schon angreifen !"));
      say(BS(CAP_TPN+" greift in eine Spalte und ein paar Spinnen greifen "
                 +TPN+" sofort an.\n"));
      (ob=clone_object(NPC "hoehlenspinne"))->move(environment(TP), M_NOCHECK);
      TP->AddPursuer(ob);
      (ob=clone_object(NPC "hoehlenspinne"))->move(environment(TP), M_NOCHECK);
      TP->AddPursuer(ob);
      break;
     case 2:
      if ((present("\n_quest_griff",TP)) || (!present("\n_leader",TP)) || (present("\n_helper",TP))) {
        write(BS("Du greifst in den Spalt und findest absolut nichts. " ));
        say(BS(CAP_TPN+" greift in eine Spalte."));
        greifen--;
      } else {
        write(BS("Du greifst in den Spalt und findest einen seltsamen Griff, "
                 "den Du sofort einsteckst." ));
        say(BS(CAP_TPN+" greift in eine Spalte."));
        CLONE(OBJ "griff",TP);
      }
      break;
     default:
      write(BS("Du greifst in den Spalt und findest absolut nichts. " ));
      say(BS(CAP_TPN+" greift in eine Spalte."));
      break;
    }
    return 1;
  } 
  return 0;
}

