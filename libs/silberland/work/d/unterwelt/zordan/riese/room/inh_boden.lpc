
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>

string *richtungen, *zielraeume, *rutschrichtungen;
int x,y;
string *hiddenexits;

init() {
  object ob;
  ::init();
  if(living(TP) && interactive(TP)) {
    call_other(RIESEMASTER,"rutschen");
    call_other(RIESEMASTER,"bewege_fuss");
  }
  if(living(TP) && !interactive(TP)) {
    if (TPN == "ein Fuss") {
      call_out("fussschlag",1,TP);
    }
  }
}

create() {
  int i;
  ::create();

  hiddenexits= ({ });

  SetProp(P_INT_LONG,
    "Du stehst auf einer wankenden Felsplatte innerhalb einer riesigen "
    "Hoehle. Die Decke ist zu weit oben, so dass sie in der Dunkelheit "
    "verschwindet. In der Mitte der Felsplatte scheint ein kleiner "
    "Huegel zu sein. " );

  AddDetail( ({ "felsplatte" , "platte" }),
    "Du stehst auf einer dicken, aus Fels bestehenden Felsplatte. Die Platte "
    "vibriert und wankt leicht. Sie ist in eine Richtung geneigt." );

  AddDetail( ({ "fels" }),
    "Ein leicht roetlicher Fels ist unter Deinen Fuessen. Richtig glatt ist "
    "er nicht. Kleine Loecher und Erhebungen befinden sich ueberall." );

  AddDetail( ({ "fuesse" }),
    "Du schaust an Dir runter. Ahja, da sind Deine Fuesse. Komisch, oder ?" );

  AddDetail( ({ "loecher" , "loch" }),
    "Die Loecher sind einfach zu klein, als das man reingreifen koennte." );

  AddDetail( ({ "erhebungen" , "erhebung" , "schwierigkeiten" }),
    "Kleine Erhebungen saeumen den Fels. Sie sind allerdings so klein, dass "
    "Du keine Schwierigkeiten hast ueber sie hinwegzugehen." );

  AddDetail( ({ "hoehle" }),
    "Die Hoehle breitet sich einfach nur gigantisch aus. Die Decke kannst "
    "Du nicht erkennen. In einiger Entfernung schimmert aber eine Wand." );

  AddDetail( ({ "entfernung" }),
    "Ziemlich weit weg. Ziemlich unerreichbar, wie Dir scheint." );

  AddDetail( ({ "wand","waende","ende" }),
    "Sehr weit weg kannst Du das Ende der Hoehle erkennen. Erreichen kannst "
    "Du sie aber nicht, da es zwischen der Felsplatte und den Waenden "
    "unendlich in die Tiefe geht." );

  AddDetail( ({ "tiefe" , "rand" }),
    "Um hinunter zu sehen, musst Du schon an den Rand der Platte gehen." );

  AddDetail( ({ "dunkelheit" }),
    "Hier auf der Felsplatte ist es erstaunlicherweise erleuchtet. Aber "
    "zur Decke hin wird es immer dunkler." );

  AddDetail( ({ "decke" , "oben" }),
    "Du versucht angestrengt die Decke zu erspaehen. Aber kurz danach gibst "
    "Du auf. Es wird nach Oben hin einfach zu dunkel." );

  AddDetail( ({ "mitte" , "huegel" }),
    "Genau in der Mitte der Felsplatte kannst Du einen kleinen Huegel erkennen. "
    "Du musst aber schon hingehen, um mehr zu sehen." );

  AddDetail( ({ "boden" }),
    "Du stehst auf einer riesigen Felsplatte." );

  AddSpecialDetail( "richtung","richtungfkt" );

  SetProp( P_INT_SHORT, "Eine wankende Felsplatte" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  SetProp (P_KILL_NAME, "Der freie Fall");
  SetProp (P_KILL_MSG,  "Zweihundert Meter waren wohl zuviel fuer Dich.");

  AddSmell( ({ DEFAULT_SMELL }),
    "Es riecht nach Tod und Verwesung." );

  AddSmell( ({ "tod","verwesung" }),
    "Hier riecht es wirklich unangenehm. Besser Du gehst schnell, bevor "
    "Du auch bald so riechst." );

  AddSound( ({ DEFAULT_SOUND }),
    "Du hoerst unendlich viele Stimmen." );

  AddSound( ({ "stimmen" }),
    "Die Stimmen dringen von ueberall an Dein Ohr. Sie schreien, jammern, "
    "fluchen und wimmern. Aber niemand ist zu erkennen." );

  // Ausgaenge setzen
  for(i=sizeof(richtungen)-1; i>=0; i--)
    AddExit(richtungen[i], zielraeume[i]);

  for(i=sizeof(rutschrichtungen)-1; i>=0; i--) {
    AddSpecialExit(rutschrichtungen[i], "rutschfkt" );
    hiddenexits+=({ rutschrichtungen[i] });
  }
  if (sizeof(hiddenexits) != 0) { SetProp(P_HIDE_EXITS, hiddenexits); }
}

int posx() { return x; }
int posy() { return y; }

int fussschlag(object ob) {
  ob->fuss_schlag();
}

string richtungfkt(string str) {
  return call_other(RIESEMASTER,"richtung");
}

int rutschfkt(string richtg) {
  if(living(TP) && interactive(TP)) {
    write(BS("Durch einen kurzen Ruck auf der Felsplatte verlierst Du den "
             "Halt am Rand der Felsplatte. Du versuchst noch, Dich am Rand "
             "festzukrallen. Doch zu spaet. Du stuerzt in die Tiefe ... "
             "Du zaehlst die Sekunden ... 1 ... 2 ...... 13 ... ZUVIELE ! "
             "Ein kurzes Knacken kannst Du noch hoeren. Dann ist Stille." ));
//    shout(TPN+" ruft: AAaaaaahhhhhhhhhh ...");
    say(BS(CAP_TPN+" faellt ueber den Rand der Felsplatte. Du versucht noch zu "
               "helfen. Es ist aber zu spaet ...\n"));
//    TP->move( ROOM "sturz.lpc", M_TPORT|M_SILENT);
//    TP->die();

//  Und ab in die Verdamnis :)   

    TP->move( "/d/unterwelt/stahldorn/dammnis/room/dam_c4.lpc", M_TPORT|M_SILENT|M_NO_SHOW);
    TP->do_damage(50+random(50));
    return 1;
  }
  return 0;
}
