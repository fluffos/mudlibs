
#include "../def.h"

inherit ROOM "inh_boden.lpc";

#include <properties.h>

create() {
  x=2;
  y=1;
  richtungen = ({ "suedwesten", "sueden",     "osten"      , "nordwesten"   });
  zielraeume = ({ "./boden-a2", "./boden-b2", "./boden-c1" , "./bruecke4"  });
  rutschrichtungen = ({ "norden" , "westen" });
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst auf einer wankenden Felsplatte innerhalb einer riesigen "
    "Hoehle. Die Decke ist zu weit oben, so dass sie in der Dunkelheit "
    "verschwindet. In der Mitte der Felsplatte scheint ein kleiner "
    "Huegel zu sein. Im Nordwesten kannst Du eine Haengebruecke sehen." );
   
  TIEFE

  AddDetail( ({ "haengebruecke", "bruecke" }),
    "Ueber die Haengebruecke kommst Du zurueck auf das Plateau." );

  AddDetail( ({ "plateau" }),
    "Das liegt weit im Nordwesten und Du kannst von hier nichts erkennen." );

  AddItem( OBJ "leiche" , REFRESH_DESTRUCT);

}
