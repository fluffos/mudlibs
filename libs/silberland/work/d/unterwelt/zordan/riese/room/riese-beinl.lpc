
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Am linken Bein des Riesen" );
  SetProp( P_INT_LONG, "Du hangelst Dich weiter in den linken Beinbereich des Riesen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21]) );

  AddExit( "linksoben", "zur Huefte#"+"./riese-huefte" );
  AddSpecialExit( "unten", "fussfkt" );
}

int fussfkt(string str) {
  object wohin,fuss;
  wohin=ENV(find_living("riese_fuss_links"));
  if (wohin) {
    write("Du springst runter zum linken Fuss.\n");
    TP->move( wohin , M_GO, 0,
        "springt hinunter zum linken Fuss", 
        "springt von oben herein");
  } else {
    write("Du springst runter und landest mitten auf der Felsplatte.\n");
    TP->move( ROOM "boden-c3" , M_GO, 0,
        "springt hinunter", 
        "springt von oben herein");
  }
  return 1;
}
