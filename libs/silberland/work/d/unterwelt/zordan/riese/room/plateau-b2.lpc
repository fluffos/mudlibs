
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

init() {
  object ob;
  ::init();
  if (ob=present("\n_erlaubnis",TP)) {
    ob->remove();
    write("Sica teilt Dir mit: Du hast soeben die Erlaubnis "
          "fuer die Bruecke verloren.\n");
  }    
}

create() {
  ::create();

  SetProp( P_INT_SHORT, "Eingang zu einer Hoehle" );
  SetProp( P_INT_LONG,
    "Hier endet jetzt der Durchgang und eine riesige Hoehle breitet sich "
    "vor Deinen Augen aus. Direkt vor Dir ist ein kleines Plateau, "
    "welches Du nach Suedosten erreichen kannst. Weiter im Osten ist ein "
    "komisches Gebilde aufgestellt." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddExit( "westen",    "./plateau-a2" );
  AddExit( "suedosten", "./plateau-c3" );

#include "plateau.h"

  AddDetail( ({ "durchgang" }),
    "Der Durchgang befindet sich im Westen. Durch ihn kannst Du die "
    "gefaehrliche Hoehle wieder verlassen." );

  AddDetail( ({ "augen","schauen" }),
    "Deine Augen kreisen durch die ganze Hoehle. Dir wird fast schwindelig "
    "vom vielen Schauen und Du konzentrierst Dich wieder auf die aktuelle "
    "Situation." );

  AddDetail( ({ "situation" }),
    "Noch befindest Du Dich in keiner misslichen Situation. Das kann sich in "
    "dieser sehr gefaehrlichen Hoehle aber schnell aendern !" );

  AddDetail( ({ "gebilde" }),
    "Von hier aus kannst Du nicht genau deuten, um was es sich da im Osten "
    "handelt. Du muesstest schon das Risiko eingehen und weiter nach "
    "Suedosten gehen, wenn Du mehr herausfinden willst." );

  AddDetail( ({ "risiko" }),
    "Du schaetzt das Risiko ab und kommst zu dem Schluss: Das Risiko ist hier "
    "unglaublich hoch." );

  AddDetail( ({ "schluss" }),
    "Vielleicht ist hier bald Schluss fuer Dich, wenn Du noch weiter in "
    "die Hoehle vordringst." );

}
