
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Eine Haengebruecke" );
  SetProp( P_INT_LONG,
    "Du hangelst Dich auf einer Haengebruecke weiter. Die Planken unter Dir "
    "knirschen schon ganz schoen. Zwei Seile sind neben Dir angebracht. "
    "Du kannst weder den Boden noch die Decke sehen. Ein unwohles "
    "Gefuehl kommt in Dir auf." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

#include "bruecke.h"

  AddSmell( ({ DEFAULT_SMELL }),
    "Es riecht nach Tod und Verwesung." );

  AddSmell( ({ "tod","verwesung" }),
    "Hier riecht es wirklich unangenehm. Besser Du gehst schnell, bevor "
    "Du auch bald so riechst." );

  AddSound( ({ DEFAULT_SOUND }),
    "Du hoerst unendlich viele Stimmen." );

  AddSound( ({ "stimmen" }),
    "Die Stimmen dringen von ueberall an Dein Ohr. Sie schreien, jammern, "
    "fluchen und wimmern. Aber niemand ist zu erkennen." );

  AddExit( "suedostunten", "./bruecke2" );
  AddExit( "suedosten",    "./bruecke2" );
  AddExit( "nordwesten",   "./plateau-e3" );

  SetProp( P_HIDE_EXITS, ({ "suedosten" }));

}
