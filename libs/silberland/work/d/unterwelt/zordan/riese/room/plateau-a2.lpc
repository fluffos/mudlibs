
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Ein schmaler Durchgang" );
  SetProp( P_INT_LONG,
    "Du stehst gebueckt in einem kleinen Durchgang. Der harte Fels hier kann "
    "nur von Zwergenhand gebaendigt worden sein. Auf dem Boden liegt ueberall "
    "Staub verteilt. Ein wenig Licht kommt aus dem Osten." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddExit( "osten", "./plateau-b2" );
  AddExit( "westen", "/d/unterwelt/basics/central/room/00-19+09" );

  AddDetail( ({ "durchgang" , "gang" }),
    "Der kleine Durchgang fuehrt vom Westen her Richtung Osten. Er wurde wohl "
    "mit Zwergenhand in den Fels getrieben. Viel Staub liegt auf dem Boden "
    "und Dir wird ein wenig unwohl bei dem Gedanken, weiter nach Osten zu "
    "gehen." );

  AddDetail( ({ "westen","loch" }),
    "Der Durchgang fuehrt durch ein kleines Loch auch weiter nach Westen." );

  AddDetail( ({ "osten" }),
    "Der Durchgang fuehrt auch weiter nach Osten. Von dort kommt ein wenig "
    "Licht." );

  AddDetail( ({ "fels" }),
    "Roter Fels ist ueberall zu sehen. Er fuehlt sich leicht rauh an. Aber "
    "nicht so stark, wie man es vermuten koennte." );

  AddDetail( ({ "zwergenhand" , "hand" }),
    "Du bist Dir sicher, dass nur Zwerge diesen Gang gegraben haben koennen. "
    "Keine andere Rasse waere dazu faehig, denn der Fels ist einfach zu hart." );

  AddDetail( ({ "zwerge","bergwerker"  }),
    "Zwerge sind die besten Bergwerker weit und breit." );

  AddDetail( ({ "rasse" }),
    "Ja, auch Du gehoerst einer Rasse an, komisch, oder ?" );

  AddDetail( ({ "boden" }),
    "Der Boden ist eigentlich recht glatt. Viel Staub liegt hier ueberall "
    "herum." );

  AddDetail( ({ "staub" }),
    "Viel Staub liegt hier ueberall herum. Hier war wohl schon lange Zeit "
    "niemand mehr. Eine einzige Spur kannst Du erkennen." );

  AddDetail( ({ "spur" }),
    "Du bist Dir sicher: Das kann nur Deine eigene sein." );

  AddDetail( ({ "gedanken" , "gedanke", "kraft", "tod" }),
    "Du solltest Dir ernsthaft Gedanken darueber machen, ob Du weiter "
    "nach Osten gehen solltest. Eine innere Kraft sagt Dir: Das koennte "
    "sehr schnell Dein Tod sein." );

  AddDetail( ({ "decke" }),
    "Gebueckt drehst Du Deinen Kopf nach oben. Gar nicht so einfach. Die Decke "
    "selber ist auch aus hartem Gestein und fuehlt sich auch ein wenig rauh "
    "an." );

  AddDetail( ({ "gestein","stein","fall" }),
    "Das Gestein hier kannst Du nicht naeher definieren. Aber es ist auf "
    "jeden Fall harter Fels." );

  AddDetail( ({ "licht","fackel" }),
    "Schwaches, gedaempftes Licht kommt aus dem Osten in den Durchgang rein. "
    "Es reicht aber leicht aus, so dass Du sicher keine Fackel brauchst." );

  AddDetail( ({ "kopf" }),
    "Die Decke haengt so niedrig, dass Du Dir fast den Kopf anschlaegst. "
    "Aber zum Glueck bist Du geschickt genug." );

  AddDetail( ({ "glueck" }),
    "Davon wirst Du ettliches brauchen, wenn Du weiter nach Osten gehst." );

  AddDetail( ({ "wand","waende" }),
    "Die Waende sind, wie alles andere hier auch, aus reinem Fels. "
    "Ein paar Kratzspuren kann man erkennen. Aber ansonsten sind die Waende "
    "recht glatt." );

  AddDetail( ({ "kratzspuren","spuren" }),
    "Die stammen wohl noch aus der Zeit der Erschaffung dieses Durchganges." );

  AddDetail( ({ "zeit" }),
    "Die Zeit vergeht, besser Du gehst nach Westen ... " );

  AddDetail( ({ "erschaffung" }),
    "Zwerge haben diesen Durchgang vor langer Zeit erschaffen. Warum kannst "
    "Du Dir aber noch nicht denken." );

}
