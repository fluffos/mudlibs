
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einem kleinen Zelt" );
  SetProp( P_INT_LONG,
    "Du betrittst das kleine Zelt. Neben der kleinen Feuerstelle in der Mitte "
    "des Zeltes ist ein kleines Regal aufgebaut. Richtig sauber ist es hier "
    "nicht, denn ueberall wimmelt es nur so von Staub. Ein kleiner Mann sitzt "
    "in seinem Schaukelstuhl neben dem Feuer." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddExit( "nordosten", "./plateau-d1" );

  AddItem( NPC "sica" , REFRESH_DESTRUCT);

  AddDetail( ({ "decke" }),
    "Ein Zelt hat keine Decke. Das solltest Du schon wissen." );

  AddDetail( ({ "wand","waende" }),
    "Die Waende des Zeltes bestehen aus einfachen Zeltplanen." );

  AddDetail( ({ "zeltplanen","planen" }),
    "Die Planen schaukeln ein wenig im Wind und sind aus normalen Stoff "
    "hergestellt worden." );

  AddDetail( ({ "wind" }),
    "Der stetige Wind in der Hoehle laesst die Planen nie zur Ruhe kommen." );

  AddDetail( ({ "hoehle" }),
    "Die Hoehle ist ausserhalb." );

  AddDetail( ({ "zeit","annahme" }),
    "Die Zeit scheint hier sehr langsam zu vergehen. Der alte Mann unterstuetzt "
    "diese Annahme allerdings nicht so sehr." );

  AddDetail( ({ "ruhe" }),
   "Hier ist es einigermassen ruhig." );

  AddDetail( ({ "stoff" }),
   "Einfach ganz normaler Stoff.");

  AddDetail( ({ "regal" }),
    "In dem Regal aus Holz befinden sich eine Menge Buecher." );

  AddDetail( ({ "holz" }),
    "Ganz normales Holz. Alt, aber normal." );

  AddDetail( ({ "menge","buecher" }),
    "Ein Ansammlung von Buechern ist in dem Regal verstaut. Du haettest "
    "niemals die Zeit, alle zu lesen. Besonders auffallen tut Dir ein "
    "kleines Buch, dass als einziges nicht verstaubt ist." );

  AddDetail( ({ "ansammlung" }),
    "Du schaetzt, das es ungefaehr einhundertfuenfzig Buecher sein muessen." );

  AddDetail( ({ "buch","ausgeburt","boeses","boesen" }),
    "Titel: Die Ausgeburt des Boesen." );

  AddDetail( ({ "bett" }),
    "Das kleine Bett ist ungemacht und wohl schon seit laengerem nicht mehr "
    "benutzt worden. Der kleine Mann schlaeft wohl immer in seinem "
    "Schaukelstuhl." );

  AddReadDetail( ({ "buch" }),
    "Du durchblaetterst das Buch nur kurz und liest eine Geschichte ueber "
    "einen boesen Zwerg, der vor langer Zeit einem boesen Magier Saeure ins "
    "Gesicht geschuettet hat. Daraufhin hat der Magier den Zwerg in eine "
    "riesige, boesartige Gestalt verwandelt und in eine grosse Hoehle "
    "verbannt." );

  AddDetail( ({ "feuerstelle" }),
    "Die Feuerstelle ist genau in der Mitte des Zeltes." );

  AddDetail( ({ "mitte" }),
    "Ohje, die Feuerstelle befindet sich genau dort." );

  AddDetail( ({ "feuer" }),
    "Das Feuer beleuchtet das Zelt und ein kleiner Spiess befindet sich auf "
    "dem Feuer." );

  AddDetail( ({ "spiess","braten" }),
    "Ein schoener Braten. Aber der Mann wird Dir niemals erlauben, etwas "
    "davon zu nehmen." );

  AddDetail( ({ "schaukelstuhl","stuhl" }),
    "Ein gemuetlicher Stuhl aus Holz traegt einen kleinen, alten Mann. "
    "Er knarrt unter dem Gewicht ein wenig." );

  AddDetail( ({ "gewicht" }),
    "Schwer wird der Mann nicht sein. Aber es knarrt trotzdem." );

  AddDetail( ({ "zelt" }),
    "Das Zelt ist eigentlich recht spaerlich ausgestattet. Nur ein kleines "
    "Feuer, ein Regal und ein kleines Bett stehen hier herum." );

  AddDetail( ({ "boden" }),
    "Der Boden ist recht staubig und ist tatsaechlich aus hartem Fels. Ein "
    "kleiner Berberteppich liegt herum." );

  AddDetail( ({ "berberteppich","teppich" }),
    "Der Berberteppich ist recht alt und staubig. Sicher nicht mehr viel wert." );

  AddDetail( ({ "staub" }),
    "Der Staub befindet sich wirklich in jeder Ecke des Zeltes. Sauber "
    "gemacht wurde hier wohl schon lange nicht mehr." );

  AddDetail( ({ "ecke","ecken","sprichwort" }),
    "Mit Ecke sind nicht die Ecken des Zeltes gemeint, sondern es war nur ein "
    "Sprichwort." );

  AddDetail( ({ "fels" }),
    "Der Fels sieht genauso wie der auf dem Plateau draussen." );

  AddDetail( ({ "plateau" }),
    "das Plateau ist nicht im Zelt, mannomann." );
}
