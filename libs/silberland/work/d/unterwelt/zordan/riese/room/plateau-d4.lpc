
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Am suedlichen Ende eines Plateaus" );
  SetProp( P_INT_LONG,
    "Jetzt stehst Du am suedlichsten Ende des Plateaus. Von hier aus kann "
    "man eigentlich nichts erkennen und es ist auch ziemlich langweilig hier. "
    "Die Decke und der Boden sind wie ueberall hier auf dem Plateau." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddExit( "nordwesten", "./plateau-c3" );
  AddExit( "norden",     "./plateau-d3" );

#include "plateau.h"

  AddDetail( "ende" ,
    "Wenn Du weiter in suedliche Richtung gehst, dann wirst Du sicher "
    "sterben. Denn dort geht es hunderte Meter runter." );

  AddDetail( ({ "rand" }),
    "Du legst Dich auf den Rand des Plateaus und schaust nach unten. Du kannst "
    "den Boden der Hoehle nicht erkennen. Es geht hunderte von Metern senkrecht "
    "nach unten. Aber was ist das ? Ein kleiner Vorsprung ist nur drei "
    "Meter unter Dir." );

  AddDetail( ({ "vorsprung" }),
    "Du denkst . o O (Vielleicht kann man ja runter springen ?)" );

  AddCmd( ({ "spring","springe" }), "springenfkt" );
}

springenfkt(string str) {
  if( str=="runter" || str=="auf vorsprung" || str == "vorsprung" ) {
    write(BS("Du nimmst all Deinen Mut zusammen und springst auf den Vorsprung "
             "runter."));
    TP->move( ROOM "plateau-c4" , M_GO, 0,
        "nimmt allen Mut zusammen und springt hinunter", 
        "springt von oben herein");
    return 1;
  } 
  return 0;
}
