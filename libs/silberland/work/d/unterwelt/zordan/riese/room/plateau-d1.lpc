
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Ein winziger Pfad" );
  SetProp( P_INT_LONG,
    "Du wandelst weiter auf einem winzigen Pfad. Nicht mehr als einen halben "
    "Meter breit ist der Pfad hier. Neben Dir geht es steil in die unendlose "
    "Tiefe der Hoehle. Nach Sueden kannst Du wieder auf das Plateau und nach "
    "Suedwesten in ein kleines Zelt auf einem Felsvorsprung gehen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddExit( "sueden",     "./plateau-d2" );
  AddExit( "suedwesten", "./plateau-c2" );


#include "plateau.h"

  AddDetail( ({ "pfad" }),
    "Der winzige Pfad fuehrst vom Sueden her in einem grossen Bogen zu dem "
    "kleinen Felsvorsprung mit dem Zelt darauf." );

  AddDetail( ({ "bogen","dreiviertelkreis","kreis" }),
    "Etwas mehr als ein Dreiviertelkreis schlaegt dieser Bogen." );

  AddDetail( ({ "tiefe" }),
    "Mehrere hundert Meter geht es runter. Besser Du bleibst auf dem Pfad." );

  AddDetail( ({ "zelt" }),
    "Ein kleines graues Zelt steht im Suedwesten. Aus dem Zelt steigt "
    "eine kleine Rauchfahne auf." );

  AddDetail( ({ "rauch","rauchfahne" }),
    "Der Rauch schlaengelt sich vom Zelt aus nach oben. Wohin kannst Du wegen "
    "der starken Dunkelheit nicht erkennen." );

  AddDetail( ({ "felsvorsprung","vorsprung" }),
    "Gerade gross genug fuer das kleine Zelt ist der Felsvorsprung." );

}
