
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int anzahl;

reset() {
  ::reset();
  anzahl=5;
}

create() {
  ::create();

  anzahl=5;

  SetProp( P_INT_SHORT, "An einer kleinen Quelle" );
  SetProp( P_INT_LONG,
    "Hier am oestlichsten Rand des Plateaus entspringt eine kleine Wasserquelle "
    "aus dem Boden. Im Suedosten kannst Du eine leicht schwankende Haengebruecke "
    "sehen und sehr weit im Westen ein kleines Gebilde. Nach Norden und Osten "
    "geht es hunderte von Metern hinunter in den sicheren Tod." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddExit( "westen",     "./plateau-d2" );
  AddExit( "sueden",     "./plateau-e3" );
  AddExit( "suedwesten", "./plateau-d3" );

#include "plateau.h"

  AddDetail( ({ "boden","tod" }),
    "Der Boden besteht aus hartem Fels. Du stehst am Rand eines kleinen "
    "Plateaus. Solltest Du abrutschen, dann faellst Du sicher in den Tod. "
    "Aus einem kleinen Loch im Fels fliesst ein wenig Wasser eine kleine "
    "Rinne entlang und dann den Rand hinunter." );

  AddDetail( ({ "wasserquelle","quelle" }),
    "Aus einem kleinen Loch im Boden sprudelt langsam aber gemaechlich ein "
    "wenig Wasser heraus. Es gleitet durch eine kleine Rinne an den Rand "
    "des Plateaus und dann hinunter in die Tiefe." );

  AddDetail( ({ "haengebruecke","bruecke" }),
    "Die Bruecke wankt im Wind und sieht nicht sehr vertrauenswuerdig aus. "
    "Wenn Du sie naeher betrachten willst, dann musst Du nach Sueden gehen." );

  AddDetail( ({ "wind" }),
    "Ein seichter Wind pfeift hier durch die Hoehle. Und das obwohl alle "
    "Seiten geschlossen scheinen." );

  AddDetail( ({ "seiten" }),
    "Du schaust Dich um und wirklich, alles ist zu. Wo kommt der Wind bloss "
    "her." );

  AddDetail( ({ "gebilde" }),
    "Das Gebilde scheint ein Wohnort zu sein. Ein wenig Rauch kommt heraus." );

  AddDetail( ({ "rauch" }),
    "Der Rauch kommt aus dem Gebilde heraus und verschwindet nach oben in der "
    "unendlichen Dunkelheit der Hoehle." );

  AddDetail( ({ "tod" }),
    "Untersuch das folgende Detail nicht und Du stirbst bestimmt !" );

  AddDetail( ({ "detail","jemand" }),
    "Jemand kringelt sich am Boden ;)" );

  AddDetail( ({ "rinne" }),
    "Die Rinne fuehrt von der Quelle aus zum noerdlichen Rand des Plateaus "
    "und verschwindet in der Tiefe." );

  AddDetail( ({ "wohnort" }),
    "Leider bist Du Dir nicht ganz sicher ob es einer ist. Nachschauen kannst "
    "Du ja mal." );

  AddDetail( ({ "loch" }),
    "Um das Loch hat sich schon eine kleine Pfuetze gebildet. Wasser kommt "
    "aus dem Inneren des Felses. Wieso, weshalb oder gar warum weiss wohl "
    "niemand so genau." );

  AddDetail( ({ "wasser" }),
     "Das Wasser sieht klar und frisch aus. Vielleicht solltest Du ein "
     "bisschen davon probieren." );

  AddDetail( ({ "pfuetze","durchmesser","zentimeter" }),
    "Die Pfuetze hat einen Durchmesser von ungefaehr fuenfzig Zentimetern und "
    "ist reichtlich gefuellt mit Wasser." );

  AddDetail( ({ "tiefe" }),
    "Mehrere hundert Meter geht es steil runter. Niemand wuerde einen Sturz "
    "ueberleben." );

  AddDetail( ({ "innere","inneren" }),
    "Wegen dem Wasser kannst Du nichts erkennen." );

  AddDetail( ({ "sturz" }),
    "Du rutscht aus und ...\nfaellst langsam aber sicher ...\nin Richtung des "
    "Randes...\nerschrocken besinnst Du Dich...\nund greifst mit einer "
    "sagenhaften Reaktion...\nnach einem Halt...\nPuha, das war knapp...\n"
    "Du ziehst Dich wieder auf das Plateau." );

  AddDetail( ({ "reaktion","halt","schussel" }),
    "Schussel." );

  AddCmd( ({ "trink","trinke" }) , "trinkfkt" );
}

trinkfkt(string str) {
  notify_fail("Was moechtest Du trinken ?\n");
  if( str=="wasser" || str=="von wasser" ) {
    if (anzahl-- > 0) {
      write( "Du fuellst Deine Hand mit Wasser und nimmst einen Schluck.\n" );
      say(CAP_TPN+" nimmt einen Schluck Wasser zu sich.\n");
      TP->SetProp(P_HP,TP->QueryProp(P_HP)+20+random(10));
      TP->SetProp(P_SP,TP->QueryProp(P_SP)+40+random(10));
    } else {
      write( "Du fuellst Deine Hand mit Wasser. Leider rinnt das Wasser durch Deine Finger.\n" );
      say(CAP_TPN+" fuellt seine Hand mit Wasser und faengt an zu fluchen.\n");
    }
    return 1;
  } 
  return 0;
}
