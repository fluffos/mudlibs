
#include "../def.h"

inherit ROOM "inh_boden.lpc";

#include <properties.h>

create()
{
  x=3;
  y=3;
  richtungen = ({ "norden",     "osten",      "sueden",     "westen"      });
  zielraeume = ({ "./boden-c2", "./boden-d3", "./boden-c4", "./boden-b3"  });
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst genau in der Mitte auf einer wankenden Felsplatte innerhalb "
    "einer riesigen Hoehle. Die Decke ist zu weit oben, so dass sie in der "
    "Dunkelheit verschwindet. Hier ist ein kleiner Huegel zu sehen." );
 
  AddDetail( ({ "mitte" , "huegel" }),
    "Genau in der Mitte der Felsplatte steht ein kleiner Huegel. "
    "Durch ein kleines Loch im Huegel kannst Du sehen, dass die gesammte "
    "Felsplatte nur durch einen spitzen Fels unter der Felsplatte getragen "
    "wird. Durch den Druck der Platte ist mit der Zeit ein kleiner Huegel "
    "entstanden." );

  AddDetail( ({ "druck" ,"tonnen" }),
    "Die Felsplatte wird schon einige Tonnen wiegen." );

  AddDetail( ({ "zeit" }),
    "Es wird Zeit hier abzuhauen !!" );
}
