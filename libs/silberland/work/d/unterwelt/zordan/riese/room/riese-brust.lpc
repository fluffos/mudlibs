
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "An der Brust des Riesen" );
  SetProp( P_INT_LONG, "Du hangelst Dich weiter in den Brustbereich des Riesen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 21]) );

  AddExit( "oben",   "zum Kopf#"+"./riese-kopf" );
  AddExit( "rechts", "zum linken Arm#"+"./riese-arml" );
  AddExit( "links",  "zum rechten Arm#"+"./riese-armr" );
  AddExit( "unten",  "zur Huefte#"+"./riese-huefte" );
}
