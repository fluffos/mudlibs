/*

  Kettenhandschuhe, nur fuer Zwerge Zordan@SL

*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create() {
  if (!is_clone(this_object())) return;
  ::create();

  AddId ( ({"handschuhe","kettenhandschuhe"}) );
  SetProp (P_SHORT, "Ein Paar Kettenhandschuhe");
  SetProp (P_LONG, 
    "Das ist ein Paar Kettenhandschuhe aus vielen kleinen eisernen Ringen. "
    "Im Inneren ist eine duenne Lederschicht, damit die Ringe den Traeger "
    "nicht verletzen koennen." );

  SetProp (P_INFO, 
    "Nur Zwerge sind wohl in der Lage, diese Handschuhe vernuenftig zu "
    "benutzen." );

  AddDetail( "ringe" ,
    "Aus vielen hundert kleinen Ringen sind diese Handschuhe hergestellt "
    "worden. Nur ein Zwergenschmied ist dazu faehig." );

  AddDetail( "lederschicht",
    "Die Lederschicht soll den Traeger vor Verletzungen durch die Handschuhe "
    "schuetzen." );

  SetProp (P_NAME, "Paar Kettenhandschuhe");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 500);
  SetProp (P_VALUE, 1200);

  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Zwerg"})]) );
  SetProp (P_MATERIAL, ([MAT_STEEL:40, MAT_LEATHER:10, MAT_IRON:50]));

  SetProp (P_ARMOUR_TYPE, AT_GLOVE);  // siehe sys/combat.h
  SetProp (P_AC, 7);
}
