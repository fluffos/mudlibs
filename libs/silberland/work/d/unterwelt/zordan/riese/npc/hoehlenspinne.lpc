
/*
    Miese kleine Hoehlenspinnen Zordan@SL
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

int beine;

void create() {
  if (!is_clone(TO)) return;
  ::create();

  beine=4;

  SetProp(P_SHORT, "Eine Hoehlenspinne");
  SetProp(P_LONG,
    "Eine kleine Hoehlenspinne sitzt auf Deinem Koerper und versucht Dich "
    "zu beissen. Abschuetteln laesst sie sich nicht, da sie richtig klebrige "
    "Beine hat. Ihre fiesen Augen bohren sich in dein Gesicht. Sie will "
    "Blut, das merkst Du." );

  SetProp(P_NAME, "Hoehlenspinne");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hoehlenspinne", "spinne"}) );

  create_default_npc(7);
  SetProp(P_HANDS, ({" mit ihrem scharfen Gebiss", 80+random(20), DT_BLUDGEON}));
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 4);
  SetProp(P_ALIGN, -50-random(10));
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_AGGRESSIVE,1);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Spinne beisst Dich dafuer.\n" }) );
}

Attack(object enemy) {
  if( beine>=4) {
    SetProp(P_HANDS, ({" mit einem ihrer Beine", 120+random(20), DT_BLUDGEON}));
    MyAttack(enemy);
  }
  if( beine>=3) {
    SetProp(P_HANDS, ({" mit einem ihrer Beine", 120+random(20), DT_BLUDGEON}));
    MyAttack(enemy);
  }
  if( beine>=2) {
    SetProp(P_HANDS, ({" mit einem ihrer Beine", 120+random(20), DT_BLUDGEON}));
    MyAttack(enemy);
  }
  SetProp(P_HANDS, ({" mit ihrem scharfem Gebiss", 120+random(20), DT_BLUDGEON}));
  MyAttack(enemy);
}

void MyAttack(object enemy) {
  // uebernommen von Gelbschwanzechse Feyaria@SL
  int damage,damage_type;
  object weaponob;
  string damage_msg, damage_msg2, wtype;
  mixed res,spell;
  mapping ainfo;

  weaponob = QueryProp(P_WEAPON);
  spell=0;
  res = QueryProp(P_HANDS);
  damage = random( res[1]+1 );
  damage = (2*damage + 10*QueryAttribute(A_STR))/3;
  damage_type = res[2];
  damage_msg = damage_msg2 = res[0];
  wtype=WT_HANDS;

  ainfo=([SI_ENEMY:enemy,
	  SI_SKILLDAMAGE:damage,
	  SI_SKILLDAMAGE_TYPE:damage_type,
	  P_WEAPON:weaponob,
	  P_WEAPON_TYPE:wtype]);

  say( "  "+capitalize(ME->name(WER,2)) + " greift " + enemy->name(WEN,1)
       + damage_msg + " an.\n", enemy );
  tell_object( enemy, "  "+capitalize(ME->name(WER,1)) + " greift Dich"
	       + damage_msg2 + " an.\n" );
  
  enemy->Defend(damage,damage_type,spell,this_object());
}

void die(int poisondeath) {
  if( --beine!=0 ) {
    say("Ein Bein der Spinne faellt ab.\n");
    SetProp(P_HP,QueryProp(P_MAX_HP)*beine/4);
    Kill(PL);
    return;
  }
 ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  object ob;
  player->RemovePursuer(ME);
  ob=present("hoehlenspinne",MENV);
  if (objectp(ob)) player->RemovePursuer(ob);
  ob=present("hoehlenspinne 2",MENV);
  if (objectp(ob)) player->RemovePursuer(ob);
  ob=present("hoehlenspinne",player->QueryProp(P_LAST_COMMAND_ENV));
  if (objectp(ob)) player->RemovePursuer(ob);
  ob=present("hoehlenspinne 2",player->QueryProp(P_LAST_COMMAND_ENV));
  if (objectp(ob)) player->RemovePursuer(ob);
}
