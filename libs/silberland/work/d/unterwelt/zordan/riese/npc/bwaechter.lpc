
/*
   Der SEHR starke Brueckenwaechter Zordan@SL
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Brueckenwaechter");
  SetProp(P_LONG,
    "Ein stattlicher Waechter steht hier an der Haengebruecke und laesst nur "
    "erfahrende Abenteurer passieren. Eine leicht schimmernde Aura scheint "
    "ihn zu umgeben. Er traegt ausschlisslich Kettenzeug. Mit seiner Gestalt "
    "stellt er sicher auch einen sehr starken Gegner dar. Wahrscheinlich "
    "kann er Dich mit einem einzigen Schlag toeten !!!" );
  SetProp(P_NAME, "Brueckenwaechter");
  SetProp(P_GENDER, MALE);
  AddId( ({ "brueckenwaechter","waechter" }) );

  create_default_npc(40);
  SetProp(P_HANDS, ({" erwuergt Dich",250,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 1500+random(200));
  SetProp(P_BODY, 150+random(50));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 90+random(10));
  SetProp(P_ALIGN, -200-random(20));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_MAGIC:-0.7 ]) );

  SetProp( P_REJECT, ({ REJECT_KEEP, "Ah, danke.\n" }) );

  SetProp( P_NOATTACK,"lacht nur ueber Dich.");

  SetProp(P_SPELLRATE,75);

  AddSpell(2,300,
    "Der Brueckenwaechter schlaegt Dir hart auf den Arm.\n",
    "Der Brueckenwaechter schlaegt @WEN hart auf den Arm.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,400,
    "Der Brueckenwaechter haut Dir mitten in die Fresse.\n",
    "Der Brueckenwaechter haut @WEN mitten in die Fresse.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,400,
    "Der Brueckenwaechter gibt Dir einen Kinnhaken.\n",
    "Der Brueckenwaechter gibt @WEN einen Kinnhaken.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,1000,
    "Der Brueckenwaechter haemmert schlimm auf Deinen Schaedel ein.\n",
    "Der Brueckenwaechter haemmert schlimm auf den Schaedel von @WEN ein.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1500,
    "Der Brueckenwaechter versucht Dich mit seinem Todesschlag zu toeten.\n",
    "Der Brueckenwaechter versucht @WEN mit seinem Todesschlag zu toeten.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Brueckenwaechter schaut Dich verachtungsvoll an.\n",
    "Der Brueckenwaechter sagt: Ich lasse hier niemanden ohne Erlaubnis durch.\n",
    "Der Brueckenwaechter schreitet vor der Haengebruecke auf und ab.\n",
    "Der Brueckenwaechter mustert Dich aufmerksam.\n"}) );

  SetAttackChats(20, ({
    "Der Brueckenwaechter bruellt: Wetten, Du gehst vor mit zu Lars ?\n",
    "Der Brueckenwaechter grinst: Wart nur ab, bis mein Todesschlag trifft !\n",
    "Der Brueckenwaechter versucht Dich in die Tiefe zu werfen.\n"}) );

  SUID;
  CLONEME( "/d/gebirge/angrox/obj/zwergenaxt" );
  command("zuecke zwergenaxt");
  if (random(100)<80) { CLONEME( "/p/armour/trousers/kettenhose" ); }
  if (random(100)<70) { CLONEME( "/d/gebirge/angrox/obj/kettenhemd" ); }
  if (random(100)<70) { CLONEME( "/p/armour/boots/kampfstiefel" ); }
  CLONEME( "/d/gebirge/dusty/zwerge/armour/kettenzeug" );
  CLONEME( ARMOUR "kettenhandschuhe" );
  command("trage alles");

  AddInfo(DEFAULT_INFO, "sagt: Darueber weiss ich nichts.\n");

  AddInfo( ({ "bruecke" , "haengebruecke" }),
    "Ich bewache diese Bruecke mit meinem Leben. Ich tue das, damit niemand "
    "hier vorbeigeht, ohne eine gewisse Erfahrung und Erlaubnis zu haben.",
    "sagt: " );

  AddInfo( ({ "leben" }),
    "Wenn Dir Dein Leben wichtig ist, dann greife mich lieber nicht an ! "
    "Ich koennte Dich mit einem einzigen Schlag toeten !",
    "erklaert: " );

  AddInfo( ({ "schlag","herz" }),
    "Diesen Schlag habe ich von einem sehr alten Zwerg gelernt. Damit kann "
    "man einem Gegner das Herz heraustrennen.",
    "sagt barsch: " );

  AddInfo( ({ "erfahrung" }),
    "Eine meiner Aufgaben ist es, niemanden ohne einen gewissen Grad der "
    "Erfahrung hier durchzulassen. Nur sehr gute Leute duerfen hier durch.",
    "sagt: " );

  AddInfo( ({ "grad","abenteurer" }),
    "Der Grad ist ziemlich hoch gewaehlt. Mein Erschaffer will nicht, dass "
    "schwache Abenteurer in den Tod rennen.",
    "erlaeutert: " );

  AddInfo( ({ "erschaffer" }),
    "Mein Erschaffer ist Zordan.","sagt: " );

  AddInfo( ({ "tod" }),
    "Der kommt sehr schnell auf der anderen Seite der Bruecke.",
    "meint: " );

  AddInfo( ({ "seite" }),
    "Auf dieser Seite ist man noch relativ sicher, wenn man vorsichtig ist. "
    "Aber auf der anderen Seite erwartet einen . Ohoh, das darf ich nicht "
    "verraten",
    "sagt: " );

  AddInfo( ({ "erlaubnis" }),
    "Das musst Du schon Sica fragen gehen.","sagt: " );

  AddInfo( ({ "hoehle" }),
    "Die Hoehle ist ziemlich gross und groessenteils noch unerforscht. "
    "Ein paar Abenteurer haben es versucht, wurden aber nie wieder gesehen.",
    "seufzt: " );

  AddInfo( ({ "name" }),
    "Ich habe keinen Namen. Wer braucht schon sowas ?","erklaert: " );

  AddInfo( ({ "sica","zelt" }),
    "Sica ist bestimmt in seinem Zelt. So wie schon die letzten vierzig Jahre.",
    "sagt: " );

  AddInfo( ({ "jahr","jahre" }),
    "Wie die Jahre doch vergehen. Aber es kommen immer wieder verrueckte "
    "Abenteurer hier vorbei und wollen ueber die Bruecke. *tststst*",
    "sagt: " );

  AddInfo( ({ "riese" }),
    "Woher weisst Du von dem ? Besser Du gehst nicht zu ihm, er ist ein sehr "
    "starker Gegner. Ich bin ihm einmal entkommen. Ich gehe sicher nie wieder "
    "zu ihm.","schreckt auf: " );

  AddInfo( ({ "gegner","kampf" }),
    "Ich habe schon viele meiner Gegner im Kampf besiegt.","sagt: " );

}

void die(int poisondeath) {
  write("Mit seinem letzten Atemzug versucht der Waechter Dich noch zu erwischen.\n");
  PL->do_damage(30+random(30));
  write_file(LOG "waechter.kills",
    ctime()+": "+CAP(getuid(PL))+" killt den Waechter.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  write_file(LOG "waechter.deads",
    ctime()+": Waechter hat "+CAP(getuid(PL))+" umgebracht.\n");
  command_me("nimm alles aus leiche");
  command_me("trage_beste_ruestungen");
  command_me("zuecke_beste_waffe");
  command_me("trage alles");
}

int _query_wimpy() { return 0; }
