
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Vogel");
  SetProp(P_LONG,
    "Dieser kleine Vogel ist wohl der Nachwuchs vom grossen Greifvogel. Er ist "
    "noch nicht in der Lage zu fliegen und bettelt die ganze Zeit um was zu "
    "fressen. Sein kleiner Schnabel ist schon recht gut ausgebildet." );
  SetProp(P_NAME, "Vogel");
  SetProp(P_GENDER, MALE);
  AddId( ({"vogel"}) );

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit seinem kleinen Schnabel",50+random(50),DT_PIERCE}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 30+random(10));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, "macht soooo ein wehleidiges Gesicht. Du laesst ihn in Ruhe.");
 
  SetProp(P_MSGIN, "hopst herein");
  SetProp(P_MSGOUT, "hopst");

  AddInfo(DEFAULT_INFO, "kann Dich nicht verstehen.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der kleine Vogel interessiert sich nicht dafuer.\n" }) );

}
