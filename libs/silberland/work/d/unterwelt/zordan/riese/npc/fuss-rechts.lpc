
/*

  Der riesige, rechte Fuss eines Riesen  Zordan@SL

*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <room/exits.h>
#include "../def.h"

int delay;

reset() {
  ::reset();
  delay=0;
}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  delay=0;

  enable_commands();

  SetProp(P_SHORT, "Ein gewaltiger, rechter Fuss");
  SetProp(P_LONG,
    "Das ist der gewaltige, rechte Fuss eines Riesen. "
    "Der Fuss ist fast so gross wie Du selbst. " );
  SetProp(P_NAME, "Fuss");
  SetProp(P_GENDER, MALE);
  AddId(({"fuss", "\nriese_fuss_rechts" }));
  set_living_name("riese_fuss_rechts");

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinem grossen Zeh",15000,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 15000);   // NO attack / unbesiegbar
  SetProp(P_BODY, 15000);     // NO attack / unbesiegbar
  SetProp(P_RACE, "keine");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 5);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);

  SetProp(P_MSGIN, "stampft herein. Der Fels erzittert unter der Wucht");
  SetProp(P_MSGOUT, "wird vom Riesen# bewegt");
  SetProp(P_MMSGIN, "erscheint in einer Wolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_NOATTACK, "wuerde Dich auf einen Schlag zerquetschen." );

  SetProp(P_NOCORPSE, 1 );
  SetProp( P_REJECT, ({ REJECT_DROP, "Wie soll der Fuss was tragen ???\n" }) );

  SetChats(1, ({
  "Ein Zeh vom Fuss bewegt sich leicht.\n",
  "Die Felsplatte erzittert.\n"}) );

  AddCmd( ({ "kletter","steig","klettere","steige" }), "kletterfkt");

}

int kletterfkt(string str) {
  notify_fail("Wohin willst Du denn ?\n");
  if ( str=="fuss" || str=="auf fuss" || str=="auf den fuss" ) {
    write("Du kletterst mit Muehe und Not auf den Fuss rauf.\n");
    TP->move( ROOM "riese-beinr" , M_GO, 0,
        "klettert auf den Fuss rauf", 
        "kommt heraufgeklettert");
    return 1;
  }
  return 0;
}

int _query_wimpy() { return 0; }

int befehl(string richtung) { 
  if(TO->command_me(richtung)) { return 1; }
  return -1;
}

int fuss_schlag() {
  object *env;
  int i;
  if (delay != 0) { return 0; }
  env=all_inventory(environment(TO));
  for( i=0 ; i<sizeof(env) ; i++ ) {
   if ( living(env[i]) && interactive(env[i])) {
    switch(random(4)) {
     case 1:
      tell_object(env[i],"Der Fuss begraebt Dich unter sich.\n" );
      env[i]->do_damage(100+random(100),TO);
      break;
     case 2:
      tell_object(env[i],"Der Fuss erwischt Dich unglaublich hart.\n" );
      env[i]->do_damage(50+random(50),TO);
      break;
     default:
      tell_object(env[i],"Der Fuss schlaegt dicht neben Dir auf den Boden auf.\n" );
      break;
    }
   }
  }
  delay=1;
  call_out("reset_delay",1);
  return 1;
}

int reset_delay() {
  delay=0;
  return 1;
}
