
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein grosser Greifvogel");
  SetProp(P_LONG,
    "Vor Dir hockt ein grosser Greifvogel in seinem Nest und pflegt seinen "
    "Nachwuchs. Er ist einfach zu riesig und zu schnell, als dass man ihn "
    "wohl toeten koennte. Mit misstrauischen Augen beobachtet er jeden Deiner "
    "Schritte. Besser Du machst nichts unbedachtes." );
  SetProp(P_NAME, "Greifvogel");
  SetProp(P_GENDER, MALE);
  AddId( ({"greifvogel", "vogel" }) );

  create_default_npc(50);
  SetProp(P_HANDS, ({" mit seinem riesigen Schnabel",2000,DT_PIERCE}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 300+random(50));
  SetProp(P_ALIGN, -200-random(100));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 100);
  SetProp(P_NOATTACK,"ist ein zu starker Gegner fuer Dich." );

  SetProp(P_MSGIN, "fliegt herein und landet");
  SetProp(P_MSGOUT, "steigt auf und fliegt");

  AddInfo(DEFAULT_INFO, "kann Dich doch nicht verstehen.\n");

  AddDetail( ({ "augen","auge" }),
    "Die zuckenden Augen des Greifvogels beobachten jeden Deiner Schritte. "
    "Hass und Angst um seinen Nachwuchs kannst Du aus den Augen lesen." );

  AddDetail( ({ "gefieder","feder","federn" }),
    "Das Gefieder des Greifvogels uebertrumpf diesen Raum mit einer "
    "unvergleichlichen Schoenheit. Am liebsten wuerdest Du dem Greifvogel "
    "eine Feder ausreissen. Aber Du traust Dich nicht." );

  AddDetail( ({ "schritt","schritte" }),
    "Da der Greifvogel Angst um seinen Nachwuchs hat, beobachtet er Dich "
    "ganz genau." );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Greifvogel kann nichts tragen.\n" }) );

  SetChats(1, ({
  "Der Greifvogel mustert jeden Deiner Schritte.\n",
  "Der Greifvogel kraechzt markerschuetternd.\n",
  "Der Greifvogel versucht Dich aus dem Nest zu schubsen.\n",
  "Der Greifvogel putzt seine Federn.\n",
  "Der Greifvogel fuettert seinen Nachwuchs.\n"}) );

  AddCmd( ({ "greif","greife" }), "greiffkt" );
  AddCmd( ({ "lenke","lenk" }),   "lenkfkt" );

}

greiffkt(string str) {
  object *env;
  int i;
  int abgelenkt;
  notify_fail("Nach was moechtest Du greifen ?\n");
  if( str=="nach klinge" || str=="klinge" ) {
    env=all_inventory(ENV(TP));
    abgelenkt=0;
    for( i=0 ; i<sizeof(env) ; i++ ) {
      if ( living(env[i]) && interactive(env[i])) {
        if (present("\n_ablenken",env[i])) { abgelenkt=1; }
      }
    }
    if (abgelenkt==1) { return 0; }
    write( BS("Du versuchst nach der Klinge zu greifen. Doch der grosse "
              "Greifvogel denkt Du willst seinem Nachwuchs was tun und "
              "haelt Dich davon ab. Vielleicht sollte jemand den Greifvogel "
              "ablenken ?") );
    tell_room(environment(),
      BS(CAP_TPN+" versucht nach etwas im Nest zu greifen. Doch der grosse "
            +"Greifvogel haelt jeden davon ab. Vielleicht solltest Du "
            +"den Greifvogel irgendwie ablenken, damit "+TPN+" schnell "
            +"greifen kann ?"), ({TP}) );
    return 1;
  } 
  return 0;
}

lenkfkt(string str) {
  object *env;
  int i;
  int abgelenkt;
  notify_fail("Wen moechtest Du ablenken ?\n");
  if( str=="vogel ab" || str=="greifvogel ab" ) {
    if (!present("\n_ablenken",TP)) {
      env=all_inventory(ENV(TP));
      abgelenkt=0;
      for( i=0 ; i<sizeof(env) ; i++ ) {
        if ( living(env[i]) && interactive(env[i])) {
          if (present("\n_ablenken",env[i])) { abgelenkt=1; }
        }
      }
      if (abgelenkt==1) {
        notify_fail("Es reicht aus, wenn einer den Greifvogel ablenkt.\n");
        return 0;
      }
      write( BS("Du lenkst Den Greifvogel jetzt ein wenig ab. Er achtet nur "
                "noch auf Dich und nichts anderes mehr.") );
      tell_room(environment(),
        BS(CAP_TPN+" lenkt den Greifvogel geschickt ab. Er achtet nicht mehr "
              +"auf Dich."), ({TP}) );
      CLONE(OBJ "ablenken",TP);
    } else {
      write( BS("Aber Du lenkst den Greifvogel doch schon ab !") );
    }
    return 1;
  } 
  return 0;
}
