
/*
    Eine verwesende Leiche in der Unterwelt, um Stimming zu machen ;)
    Zordan@SL
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
   if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine verwesende Leiche");
  SetProp(P_LONG,
    "Eine stark verweste Leiche liegt hier auf dem Boden. Bei dem Anblick "
    "der Knochen und der halb verwesten Koerperteilen wird Dir fast schlecht. "
    "Dem Abenteurer hat wohl ein Ungetuem der Unterwelt sehr arg zugesetzt. "
    "Sein Koerper wurde genau in der Mitte einfach zerrissen und sein Kopf "
    "zerquetscht. Die ehemaligen Arme und Beine verschimmeln langsam, "
    "aber stetig." );
  SetProp(P_NAME, "verwesende Leiche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"leiche"}) );

  create_default_npc(1);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, 100);
  SetProp(P_NOATTACK,"ist doch schon tot !?!");

  AddInfo(DEFAULT_INFO, "wird wohl nie wieder antworten koennen.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Einer Leiche kann man doch nichts geben.\n" }) );
}

string long() {
  return BS(
    "Eine stark verweste Leiche liegt hier auf dem Boden. Bei dem Anblick "
    "der Knochen und der halb verwesten Koerperteilen wird Dir fast schlecht. "
    "Dem Abenteurer hat wohl ein Ungetuem der Unterwelt sehr arg zugesetzt. "
    "Sein Koerper wurde genau in der Mitte einfach zerrissen und sein Kopf "
    "zerquetscht. Die ehemaligen Arme und Beine verschimmeln langsam, "
    "aber stetig." );
}
