
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein boeser Geist");
  SetProp(P_LONG,
    "Ein grimmiger, fast durchsichtiger Geist schwebt um Dich herum. Er "
    "versucht Dir das Grauen zu lehren." );
  SetProp(P_NAME, "Geist");
  SetProp(P_GENDER, MALE);
  AddId( "geist" );

  create_default_npc(26);
  SetProp(P_HANDS, ({" mit skalpelscharfen Fingern" ,250, DT_PIERCE}));
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 200+random(20));
  SetProp(P_ALIGN, -150-random(50));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_MAGIC:-0.9]) );
  SetProp(P_NOMAGIC,40);

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "erscheint auf einmal");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " loest sich auf.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Deine Sachen fallen so zu Boden.\n" }) );
}
