
/*

  QUESTITEM fuer den Fuehrer der QuestZordan@SL

*/

inherit "std/thing";

#include <properties.h>
#include "../def.h"

string helper1,helper2;

init() {
  object ob1,ob2;
  
  ::init();
  if (!living(MENV)) {
    if (helper1 != "") {
      ob1=find_player(LOWER(helper1));
      if (!ob1) ob1=find_netdead(LOWER(helper1));
      if (ob1) {
        if (ob2=present("\n_helper",ob1)) {
          ob2->remove();
          if (ob2) ob2->destruct();
          ob1->Message("Sica teilt Dir mit: Das Team gegen den "
                       "Riesen loest sich auf!\n", MSGFLAG_TELL);
        }
      }
    }
    if (helper2 != "") {
      ob1=find_player(LOWER(helper2));
      if (!ob1) ob1=find_netdead(LOWER(helper2));
      if (ob1) {
        if (ob2=present("\n_helper",ob1)) {
          ob2->remove();
          if (ob2) ob2->destruct();
          ob1->Message("Sica teilt Dir mit: Das Team gegen den "
                       "Riesen loest sich auf!\n", MSGFLAG_TELL);
        }
      }
    }
    TO->remove();
  }
}

create() {
  if (!is_clone(this_object())) return;
  ::create();

  helper1="";
  helper2="";

  SetProp (P_IDS, ({"\n_leader"}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, 0);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_WEIGHT, 0);
}

void setvars(string a,string b) {
  helper1=a;
  helper2=b;
}

string gethelfer1() {
  return helper1;
}

string gethelfer2() {
  return helper2;
}
