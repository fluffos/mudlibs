
/*

 Das Herz des Riesen Zordan@SL
 QuestItem -> Autoload

*/


#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Das grosse Herz eines Riesen");
  SetProp(P_LONG,
    "In Deiner Hand haeltst Du das grosse Herz eines Riesen. Durch die letzten "
    "Zuckungen stroemt noch ein wenig Blut heraus. Das Herz ist noch recht "
    "warm und glitscht in Deiner Hand." );
  SetProp(P_INFO, "Das Herz scheint nicht ganz normal zu sein.\n");
  SetProp(P_NAME, "Herz");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "herz","\n_quest_herz" }) );

  SetProp(P_MATERIAL, ([MAT_FLESH:80, MAT_MISC_MAGIC:20]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 100);
  SetProp(P_NOSELL, "Das Herz ist nicht verkaeuflich.\n");
  SetProp(P_NOBUY,1);
  SetProp(P_AUTOLOAD,1);
}
