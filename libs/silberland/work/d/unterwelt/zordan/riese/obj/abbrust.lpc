
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Die zerfetzte Brust");
  SetProp(P_LONG,
    "Klaffende Wunden ueberstroemen die Brust des Riesen. Das Herz schlaegt "
    "sehr schnell und unregelmaessig. Die Atmung setzt teilweise auch schon "
    "aus. Du bist der Meinung, dem Riesen kann es einfach nicht mehr gut "
    "gehen und entschliesst Dich, weiter auf ihn einzudreschen. Allerdings "
    "nicht mehr hier." );
  SetProp(P_NAME, "Brust");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "brust","\n_brust_ab"}) );

  SetProp(P_MATERIAL, MAT_FLESH );
  SetProp(P_WEIGHT, 200000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOGET, "Die Brust kannst Du nicht nehmen!\n");
}
