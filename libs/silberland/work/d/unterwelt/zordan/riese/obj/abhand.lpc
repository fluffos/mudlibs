
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine zerfetzte Hand");
  SetProp(P_LONG,
    "Vor Dir baumelt die total zerfetzte Hand des Riesen. Die Hand wird "
    "sicher niemandem mehr gefaehrlich werden. Blut stroemt aus den Adern und "
    "der Geruch von Faeulniss steigt auf." );
  SetProp(P_NAME, "Hand");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "hand","\n_hand_ab"}) );

  SetProp(P_MATERIAL, MAT_FLESH );
  SetProp(P_WEIGHT, 100000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOGET, "Die Hand ist viel zu schwer fuer Dich!\n");
}
