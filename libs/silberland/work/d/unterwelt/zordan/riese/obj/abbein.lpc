
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein zerfetztes Bein");
  SetProp(P_LONG,
    "Vor Dir erkennst Du das total zerfetztes Bein des Riesen. Der Riese kann "
    "damit zwar noch stehen, aber gefaehlich wird es sicher keinem mehr werden. "
    "Ausserdem hat der Riese dadurch bestimmt einiges an Bewegungsfreiheit "
    "verloren." );
  SetProp(P_NAME, "Bein");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "bein","\n_bein_ab"}) );

  SetProp(P_MATERIAL, MAT_FLESH );
  SetProp(P_WEIGHT, 200000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOGET, "Das Bein ist viel zu schwer fuer Dich!\n");
}
