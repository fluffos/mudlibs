
/*

 Der Griff fuer den Mithrilsaebel Zordan@SL
 QuestItem -> Autoload

*/


#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein funkelnder Griff");
  SetProp(P_LONG,
    "In Deiner Hand hast Du einen mit Edelsteinen uebersetzen Griff eines "
    "Saebels. Er funkelt im Licht und strahlt eine magische Energie aus." );
  SetProp(P_INFO, "Der Griff ist mit einer magischen Aura umgeben.\n");
  SetProp(P_NAME, "Griff");
  SetProp(P_GENDER, MALE);
  AddId( ({ "griff","\n_quest_griff" }) );

  SetProp(P_MATERIAL, ([MAT_MISC_JEWEL:20, MAT_OCTARINE:20, MAT_MITHRIL:60]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOSELL, "Du wuerdest diesen Griff niemals verkaufen.\n");
  SetProp(P_NOBUY,1);
  SetProp(P_AUTOLOAD,1);

  AddDetail( ({ "energie","aura" }),
    "Eine magische Aura umgibt den Griff und macht ihn besonders wertvoll.");

}


