
/*

 Die Klinge fuer den Mithrilsaebel Zordan@SL
 QuestItem -> Autoload

*/


#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine leuchtende Klinge");
  SetProp(P_LONG,
    "Eine ueber und ueber leuchtende Klinge aus reinstem Mithril." );
  SetProp(P_INFO, "Die Klinge ist mit einer magischen Aura umgeben.\n");
  SetProp(P_NAME, "Klinge");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "klinge","\n_quest_klinge" }) );

  SetProp(P_MATERIAL, ([MAT_MITHRIL:100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 15000);
  SetProp(P_NOSELL, "Du wuerdest diese Klinge niemals verkaufen.\n");
  SetProp(P_NOBUY,1);
  SetProp(P_AUTOLOAD,1);

  AddDetail( ({ "energie","aura" }),
    "Eine magische Aura umgibt die Klinge und macht sie besonders wertvoll.");

}


