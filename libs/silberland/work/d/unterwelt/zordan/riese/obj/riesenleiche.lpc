
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

int geschnitten;

reset() {
  ::reset();
  if (geschnitten) {
    tell_room(MENV,"Die Leiche vergammelt und ist verschwunden.\n");
    call_out("remove",0);
  }
}

create() {
  if (!is_clone(TO) )  return;
  ::create();

  geschnitten=0;

  SetProp(P_SHORT, "Die gigantische Leiche eines Riesen");
  SetProp(P_LONG, 
    "Vor Dir liegt die gigantische Leiche eines Riesen. Mehrere Meter im "
    "Durchmesser floesst sie Dir immer noch Angst ein. Abgetrennte Arme und "
    "Beine liegen herum. Der Kopf ist aufgeschlagen und Gehirnmasse fliesst "
    "heraus. Dir wird fast uebel bei dem Gestank, den der rauschende Bach "
    "von Blut hier verbreitet. Das Herz liegt in seinen letzten Zuckungen." );
  SetProp(P_NAME, "Leiche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "leiche" , "\n_quest_leiche" }) );
  SetProp(P_MATERIAL, MAT_FLESH );
  SetProp(P_WEIGHT, 500000);
  SetProp(P_VALUE, 100000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOGET, "Wie in Woody's Namen willst Du eine solche Leiche tragen ?\n");

  AddDetail( ({ "riese" }),
    "Der Riese ist mausetot.");

  AddDetail( ({ "arme","beine","gliedmassen" }),
    "Die Gliedmassen sind nach einem harten Kampf voellig zerstueckelt und "
    "lauwarmes Blut stroemt aus allen Adern heraus." );

  AddDetail( ({ "kopf","gehirnmasse","gehirn" }),
    "Der Kopf muss wohl sehr hart auf die Felsplatte aufgeschlagen sein. "
    "Voellig zerschmettert haben sich riesige Loecher gebildet und "
    "eine Menge Gehirnmasse fliesst heraus. Dir ekelt bei dem Anblick." );

  AddDetail( ({ "bach","blut" }),
    "Unmenschlich viel Blut fliesst in riesigen Baechen in alle Richtungen "
    "von der Leiche weg." );

  AddDetail( ({ "zuckungen" }),
    "Ab und zu bewegt sich das Herz noch. Du erschreckst immer fuerchterlich "
    "wenn es gerade noch ein wenig zuckt." );

  AddDetail( ({ "herz","waffe" }),
    "Das Herz liegt fast voellig offen vor Dir. Um es aber herauszuschneiden, "
    "wirst Du schon eine besondere Waffe benoetigen." );

  AddCmd( ({ "schneid","schneide" }), "schneidfkt" );

  call_out("remove",3600);

}

int schneidfkt(string str) {
  object ob;
  string leader;
  notify_fail ( "Was willst Du herausschneiden ?\n" );
  if ( str == "herz" || str == "herz heraus" ) {
    if (geschnitten != 0) {
      notify_fail("Das Herz wurde schon herausgetrennt. "
                  +"Nur noch die Reste zucken hier herum.\n");
      return 0;
    }
    notify_fail("Du hast keine Waffe gezueckt, mit der "
                +"man das Herz herausschneiden koennte.\n");
    if( ob=present("\n_quest_saebel",TP)) {
      notify_fail("Du musst den Mithrilsaebel schon zuecken.\n");
      if( ob->QueryProp(P_WIELDED) == TP) {
         if (ob=present("\n_helper",TP)) {
           leader=ob->getleader();
           notify_fail("Du ekelst Dich zu sehr vor dem Blut. Besser "
                       +leader+" schneidet das Herz heraus.\n");
           return 0;
         }
         if (!present("\n_leader",TP)) {
           notify_fail("Du ekelst Dich zu sehr vor dem Blut und weichst zurueck.\n");
           return 0;
         }
         write("Du schneidest unter stroemendem Blut das Herz des Riesen heraus.\n");
         tell_room(ENV(TP),TPN
           +" schneidet unter stroemendem Blut das Herz des Riesen heraus.\n", ({TP}) );
         geschnitten=1;
         CLONE( OBJ "riesenherz", TP );
         SetProp(P_LONG, 
    "Vor Dir liegt die gigantische Leiche eines Riesen. Mehrere Meter im "
    "Durchmesser floesst sie Dir immer noch Angst ein. Abgetrennte Arme und "
    "Beine liegen herum. Der Kopf ist aufgeschlagen und Gehirnmasse fliesst "
    "heraus. Dir wird fast uebel bei dem Gestank, den der rauschende Bach "
    "von Blut hier verbreitet." );
         RemoveDetail("herz");
         RemoveDetail("waffe");
         return 1;
      }
    }
  }
  return 0; 
}
