
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Die zerfetzte Huefte");
  SetProp(P_LONG,
    "Total hinueber ist die Huefte des Riesen. Qualvolle Schmerzen muessen "
    "den Riesen plagen. Blut stroemt von ueberall her und besudelt Dich. "
    "Einige innere Organe kannst Du auch schon erkennen. Alles deutet auf "
    "ein baldiges Ende des Riesen hin." );
  SetProp(P_NAME, "Huefte");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "huefte","\n_huefte_ab"}) );

  SetProp(P_MATERIAL, MAT_FLESH );
  SetProp(P_WEIGHT, 400000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOGET, "Die Huefte kannst Du sicher nicht tragen!\n");
}
