
/*

   Greifvogel ablenken

*/

inherit "std/thing";

#include <properties.h>
#include "../def.h"

init() {
  ::init();
  if (!living(MENV)) TO->remove();
}

create() {
  ::create();
  if (!is_clone(this_object())) return;

  SetProp (P_IDS, ({"\n_ablenken"}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, 0);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_WEIGHT, 0);

  AddCmd( ({ "greif","greife" }), "greiffkt" );

}


greiffkt(string str) {
  write("Du bist zu sehr mit dem Ablenken des Greifvogels beschaeftigt !\n");
  return 1;
}
