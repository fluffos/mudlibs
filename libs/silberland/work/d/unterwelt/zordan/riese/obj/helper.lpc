
/*

  QUESTITEM fuer einen Gehilfen der QuestZordan@SL

*/

inherit "std/thing";

#include <properties.h>
#include "../def.h"

string leader,helper;

init() {
  object ob1,ob2;

  ::init();
  if (!living(MENV)) {
    if (helper != "") {
      ob1=find_player(LOWER(helper));
      if (!ob1) ob1=find_netdead(LOWER(helper));
      if (ob1) {
        if (ob2=present("\n_helper",ob1)) {
          ob2->remove();
          if (ob2) ob2->destruct();
          ob1->Message("Sica teilt Dir mit: Das Team gegen den "
                       "Riesen loest sich auf!\n", MSGFLAG_TELL);
        }
      }
    }
    if (leader != "") {
      ob1=find_player(LOWER(leader));
      if (!ob1) ob1=find_netdead(LOWER(leader));
      if (ob1) {
        if (ob2=present("\n_leader",ob1)) {
          ob2->remove();
          if (ob2) ob2->destruct();
          ob1->Message("Sica teilt Dir mit: Das Team gegen den "
                       "Riesen loest sich auf!\n", MSGFLAG_TELL);
        }
      }
    }
    TO->remove();
  }
}

create() {
  if (!is_clone(this_object())) return;
  ::create();

  leader="";
  helper="";

  SetProp (P_IDS, ({"\n_helper"}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, 0);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_WEIGHT, 0);
}

void setvars(string a,string b) {
  leader=a;
  helper=b;
}

string getleader() {
  return leader;
}

string gethelfer() {
  return helper;
}
