#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create()
{

  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Langbogen");
  SetProp(P_LONG,
    "Das ist ein Langbogen, wie nur Dunkelelfen ihn tragen. Mit ihm ist "
    "man durchaus in der Lage, jedem Angreifer Paroli zu bieten. Er ist aus "
    "einem sehr biegsamen Holz mit einer duennen Sehne aus Seide gemacht "
    "worden. Fuer Dunkelelfen ist es sicher eine mehr als gute Waffe. "
    "Allerdings ist sie auch ein wenig zerbrechlich durch ihre zierliche "
    "Gestalt."
  );

  SetProp(P_NAME, "Langbogen");
  SetProp(P_GENDER, MALE);
  AddId( ({"langbogen", "bogen"}) );

  SetProp(P_WEAPON_TYPE, WT_BOW );
  SetProp(P_WC, 120);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_SILK:20, MAT_MISC_WOOD:40, MAT_MISC_FLEXIBLE:40 ]) );
  SetProp(P_WEIGHT, 750);
  SetProp(P_VALUE, 900+random(50));
  SetProp(P_QUALITY_DECAY, 20 );
  SetProp(P_WC_FIXFACTOR, 0.35 );
  SetProp(P_WC_BONUS, (["\ndunkelelf": 20,
                          "\ndunkelelfenwaechter": 60,
                          "\ndunkelelfenwaechterin": 100,
                          "\nwache": 80,
                          "\ndrider":120,
                          "\ndunkelelfin": 60,]) );
}
