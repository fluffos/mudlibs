#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO))  return;

  ::create();

  SetProp(P_SHORT, "Ein Bierkrug");
  SetProp(P_LONG,
    "Dieser voluminoese Bierkrug liegt nicht sehr gut in Deiner Hand. Er "
    "ist ja auch eigentlich nicht zum Kaempfen gedacht. Aber ein "
    "geschickter Wirt hat schon so manchem Gegner den Schaedel damit "
    "gespalten."
  );

  SetProp(P_NAME, "Bierkrug");
  SetProp(P_GENDER, MALE);
  AddId( ({"bierkrug", "krug", "\n_plexu_bierkrug"}) );

  SetProp(P_WEAPON_TYPE, WT_MISC );
  SetProp(P_WC, 40);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, ([MAT_GLASS:95, MAT_CRYSTAL:5 ]) );
  SetProp(P_WEIGHT, 250+random(50));
  SetProp(P_VALUE, 1000+random(200));

  SetProp(P_WC_BONUS, (["plexu": 210]) );
}
