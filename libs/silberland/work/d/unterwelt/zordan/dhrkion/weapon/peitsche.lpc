// vielkoepfige Schlangenpeitsche der boesen Dunkelelfenhohepriesterin
// und der Dunkelelfenkoenigin
// Stahldorn@Silberland, 4.Juni 1998  

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

int snakes;

create()
{
  if( !is_clone(TO) )  return;
  ::create();

  snakes=({3, 5, 7, 9})[random(40)/10];
         
  SetProp(P_SHORT, "Eine "+int2str(snakes)+"koepfige Schlangenpeitsche");
  SetProp(P_LONG, 
    "An einem praechtig verarbeiteten Peitschengriff aus extrem hartem "
    "vulkanischem Glas sitzen "+int2str(snakes)+" graessliche Schlangen mit "
    "staendig sich in Bewegung befindlichen Koepfen. Ein Biss von so einem "
    "Schlangenkopf ist sicher aeusserst schmerzhaft und giftig. Leider muss "
    "man allerdings beide Haende benutzen, um die Peitsche zu zuecken, damit "
    "man nicht selbst gebissen wird.");
  SetProp(P_NAME, "Schlangenpeitsche");
  SetProp(P_INFO, BS(
     "Die wabernden und zuckenden Schlangen geben dieser Waffe "
     "eine unheilvolle, aber maechtige Kraft. Je mehr Schlangen am "
     "Peitschengriff befestigt sind, desto haerter schlaegt man zu..."));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_DAM_TYPE, ({DT_WHIP, DT_POISON}) );
  SetProp(P_WC, snakes*10 + 110);   // also: 140, 160, 180, 200
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MISC_LIVING:30, MAT_OBSIDIAN:70]));
  SetProp(P_WC_BONUS, (["\nkoenigin":250, "\npriesterin":250]));
  SetProp(P_WEIGHT, 2200);
  SetProp(P_VALUE, 7000);
  SetProp(P_WIELD_FUNC, TO);
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_WC_FIX, 0 );
  SetProp( P_WIELD_RESTRICTIONS, ([A_INT:15 , P_LEVEL:25 ]) );

  AddId("peitsche");
  AddId("schlangenpeitsche");

  AddDetail( ({ "kopf", "koepfe", "schlangenkopf", "schlangenkoepfe" }), 
    "Graessliche Schlangenkoepfe mit spitzen Zaehnen und zischenden Maeulern, "
    "aus denen schwarze Zungen zucken." );
  AddDetail( ({ "schlange", "schlangen" }), 
    "Es sind "+int2str(snakes)+" an der Zahl. Sie bewegen sich staendig vor "
    "und zurueck, als suchten sie etwas. Vielleicht wittern sie Dich?" );
  AddDetail( ({ "zaehne", "maeuler", "zungen" }), 
    "Schwarz, gefaehrlich und boese." );
  AddDetail( ({ "griff", "peitschengriff" }), 
    "Der Griff ist aus dunkelviolettem Vulkanglas, auch Obsidian genannt. "
    "Die derart kunstvolle Bearbeitung eines so schwierigen Materials zeugt "
    "von der hohen Kunstfertigkeit und dem grossen Wert dieser Waffe." );
}


int HitFunc(object enemy)
{

  if(enemy->QueryProp(P_POISON))
    return random(snakes*10);
  else if (random(100) < snakes*10) 
  {
    write(BS("Eine der Schlangen verbeisst sich in "+enemy->name(WEM)+" und "
          "injiziert "+enemy->QueryPronoun(WEM)+" eine kleine Portion Gift."));
    tell_object(enemy, BS("Ein Schlangenkopf beisst Dich. Brennend heisser "
          "Schmerz zuckt durch Deinen Koerper. Du bist leicht vergiftet.") );
    say("Ein Schlangenkopf der Schlangenpeitsche beisst "
        +enemy->name(WEN)+".\n", ({enemy}));
    enemy->SetProp(P_POISON, 1);
  }
  return 0;
}

int WieldFunc(object waffe)
{
  if (!interactive(TP)) return 1;

  if( TP->QueryProp(P_GUILD) != "nekromanten" && 
      TP->QueryProp(P_GUILD) != "dunkelelfen" )
  {
    write(BS("Die grauenhafte Boesartigkeit dieser Waffe und Deine Angst vor "
      "den Schlangen lassen Dich zurueck"
      "schrecken. Du muesstest schon in eine andere, so richtig boese Gilde "
      "eintreten, um die Peitsche zu zuecken."));
    return 0;
  }
  return 1;
}

string int2str(int num)
{
  return ({ "drei", "fuenf", "sieben", "neun" })[(num-1)/2 - 1];
}

