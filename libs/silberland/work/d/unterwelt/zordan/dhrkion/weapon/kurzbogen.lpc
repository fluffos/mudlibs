
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if (!is_clone(TO) )  return;

  ::create();
  SetProp(P_SHORT, "Ein Kurzbogen");
  SetProp(P_LONG,
    "Das ist ein Kurzbogen, wie nur Dunkelelfen ihn tragen. Mit ihm ist man "
    "durchaus in der Lage, jedem Angreifer Parole zu bieten. Er ist aus einem "
    "sehr biegsamen Holz mit einer duennen Sehne aus Seide gemacht worden. "
    "Er ist ein wenig kleiner als ein Langbogen und wird deshalb auch "
    "Kurzbogen genannt." );
  SetProp(P_NAME, "Kurzbogen");
  SetProp(P_GENDER, MALE);
  AddId( ({"kurzbogen", "bogen"}) );

  SetProp(P_WEAPON_TYPE, WT_BOW );
  SetProp(P_WC, 100);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_SILK:20, MAT_MISC_WOOD:40, MAT_MISC_FLEXIBLE:40 ]) );
  SetProp(P_WEIGHT, 550);
  SetProp(P_VALUE, 600+random(50));
  SetProp(P_WC_BONUS, (["\ndunkelelf": 30,
                          "\ndrider":110,
                          "\npalastwache": 120,
                          "\ndunkelelfin": 60,]) );
}
