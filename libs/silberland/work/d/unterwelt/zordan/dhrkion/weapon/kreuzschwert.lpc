
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Kreuzschwert");
  SetProp(P_LONG,
    "Das Kreuzschwert besteht zu etwa einem Drittel aus purem Chitin. Dadurch "
    "ist es ein sehr leichtes, aber auch scharfes Schwert. Nur besondere "
    "Schwertmeister koennen mit diesem Schwert umgehen. In seinem Griff "
    "ist der Koerper einer Kreuzspinne zu erkennen. Daher stammt wohl auch "
    "der Name des Schwertes." );
  SetProp(P_INFO, "Das Kreuzschwert mag Wasser nicht besonders!\n");
  SetProp(P_NAME, "Kreuzschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"kreuzschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 185);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_CHITIN:30, MAT_STEEL:70 ]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 800);
  SetProp(P_QUALITY_DECAY, 500  );
  SetProp(P_WC_FIX, 50 );
  SetProp(P_WC_BONUS, (["\nodania": 250 ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:30, A_STR:25, A_DEX:25]) );
}


