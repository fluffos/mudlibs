#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Dunkelelfendolch");
  SetProp(P_LONG,
    "Der Dolch ist aus einem dunklem Elfenbein gemacht worden. Seine "
    "scharfe Klinge ist aber aus dem wertvollen Mithril. Diese Waffe ist "
    "wohl nur von den Dunkelelfen zu tragen. Andere Rassen koennten sich "
    "vermutlich damit sogar verletzen."
  );

  SetProp(P_NAME, "Dunkelelfendolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch","dunkelelfendolch"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 60);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_WC_FIXFACTOR, 0.4);
  SetProp(P_QUALITY_DECAY, 350);
  SetProp(P_MATERIAL, ([MAT_MITHRIL:70, MAT_IVORY:30]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 200+random(2)*100);
  SetProp(P_WIELD_RESTRICTIONS, ([SR_INCLUDE_RACE: ({"Dunkelelf"})]) );

  SetProp(P_WC_BONUS, (["syphonius": 110,"dunkelelf": 90,"dunkelelfin": 100]) );
}
