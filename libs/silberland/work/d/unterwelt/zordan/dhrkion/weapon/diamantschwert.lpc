
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Diamantschwert");
  SetProp(P_LONG,
    "Dieses mit Diamantspat versetzte Schwert hat eine glaenzende Klinge "
    "aus Mithril. Sein Griff passt sich fast perfekt an Deine Haende an und "
    "gibt Dir gute Moeglichkeiten im Kampf zu bestehen." );
  SetProp(P_INFO, "Das Schwert ist durch das Mithril sehr scharf.\n");
  SetProp(P_NAME, "Diamantschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"diamantschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 160);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_MITHRIL:30, MAT_DIAMOND:40, MAT_STEEL:30 ]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 1400);
  SetProp(P_QUALITY_DECAY, 400 );
  SetProp(P_WC_FIXFACTOR, 0.4 );
  SetProp(P_WC_BONUS, (["\ndunkelelf": 20,
                          "\ndunkelelfenwaechter": 40,
                          "\ndunkelelfenwaechterin": 80,
                          "\nwache": 60,
                          "\npalastwache": 80,
                          "\ndrider":100,
                          "\ndunkelelfin": 40,]) );
}
