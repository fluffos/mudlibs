
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include "../def.h"

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp( P_SHORT,"Ein grosser Schmiedehammer");
  SetProp( P_LONG,
    "Der grosse Schmiedehammer eignet sich besonders gut, um damit "
    "wirklich gute Waffen zu schmieden. Er ist schon ganz schoen schwer "
    "und liegt sicher nicht sehr gut in der Hand. Sollte man ihn jedoch "
    "auf den Schaedel eines Gegner preschen, wird er verherrenden Schaden "
    "anrichten koennen.\n");

  SetProp( P_NAME, "Schmiedehammer");
  AddId( ({"hammer","schmiedehammer" }));
  SetProp( P_GENDER, MALE);
  SetProp( P_WC, 110);        
  SetProp( P_WC_FIXFACTOR, 0.1);
  SetProp( P_WEIGHT, 4500);
  SetProp( P_VALUE, 500+random(50));
  SetProp( P_WEAPON_TYPE, WT_CLUB);
  SetProp( P_NR_HANDS, 2);
  SetProp( P_WIELD_RESTRICTIONS, ([A_STR:15]) );
  SetProp( P_MATERIAL, ([MAT_WOOD:60, MAT_IRON:40]) );

  SetProp(P_WC_BONUS, (["fjuro": 110,]) );
}
