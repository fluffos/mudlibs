
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine schwere Bleiweste");
  SetProp(P_LONG,
    "Diese dicke Bleiweste schuetzt den Traeger sicher vor viel Schaden und "
    "Feuer. Sie wiegt aber auch dementsprechend viel und kann nur von "
    "besonders starken Leuten getragen werden." );
  SetProp(P_INFO, BS("Es sieht so aus, als ob sie sehr gut gegen Feuer "
    "und ein wenig gegen Saeure schuetzen kann.") );
  SetProp(P_NAME, "Bleiweste");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"bleiweste","weste"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 8 );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 600+random(30));
  SetProp(P_MATERIAL, ([MAT_LEAD:100]) );

  AddProp( P_DAM_PROTECTION, ([DT_FIRE:2,DT_ACID:1]) );
  SetProp( P_WEAR_RESTRICTIONS, ([A_STR:20]) );
}
