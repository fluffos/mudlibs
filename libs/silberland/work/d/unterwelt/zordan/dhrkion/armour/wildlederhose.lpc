#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Wildlederhose");
  SetProp(P_LONG,
    "Eine eng anliegende, schwarze Hose aus samtweichem Wildleder. "
    "Die Aussennaehte sind sparsam mit dunkelgruener Seide in feinen, "
    "verschlungenen Mustern bestickt. "
  );

  SetProp(P_NAME, "Hose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose","lederhose","wildlederhose"}) );

  SetProp(P_NAME_ADJ, "schwarz");
  AddAdjective( ({"schwarzen","schwarzer","schwarzem","schwarzes","schwarze"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_LEATHER:90, MAT_SILK:10 ]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 120);
}
