
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine huebsche Weste");
  SetProp(P_LONG,
    "Diese kleine Weste eignet sich hervorragend, um damit Kleider besser "
    "hervorzuheben. Kleine Stickereien und huebsche Muster verzieren sie."
    "Aber auch ohne das dazugehoerigem Kleid kann sie Dich bestimmt besser "
    "aussehen lassen." );
  SetProp(P_NAME, "Weste");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"weste"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7 );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_WOOL:100]) );
}
