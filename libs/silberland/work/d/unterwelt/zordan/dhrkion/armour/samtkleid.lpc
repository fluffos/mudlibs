#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Ein samtenes Kleid");
  SetProp(P_LONG,
    "Ein langes, hochgeschlossens Kleid aus Samt und Seide. Auf der linken "
    "Seite ist das Kleid hochgeschlitzt, was ein grosser Vorteil im Kampf "
    "aufgrund der hoeheren Bewegungsfreiheit ist. Andererseits wirken "
    "schlanke Dunkelelfinnen sehr anmutig und auch anziehend, wenn sie "
    "dieses Kleid tragen. Maenner dagegen duerften recht laecherlich "
    "darin wirken. Das Kleid ist mit feinen Stickereien verziert. "
  );

  SetProp(P_NAME, "Kleid");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"kleid","samtkleid"}) );

  SetProp(P_NAME_ADJ, ({"lang","dunkelblau"}) );
  AddAdjective( ({"langen","langer","langem","langes","lange"}) );
  AddAdjective( ({"dunkelbauen","dunkelbauer","dunkelbauem","dunkelbaues","dunkelbaue"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 25 );
  SetProp(P_MATERIAL, ([MAT_VELVET:80, MAT_SILK:20 ]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 500+random(100));


  AddDetail( ({"stickerei","stickereien"}) ,
    "Bei genauerem Hinsehen erkennst Du, dass es sich bei den Stickereien... "
    "ja wirklich, die Stickereien bestehen aus feinem, silberigen Feenhaar."
  );

}

string extra_look()
{
  string s;

  s = "";
  if(QueryProp(P_WORN))
  {
    if(ENV(TO)->QueryProp(P_GENDER) == MALE)
    {
      s = "Er sieht in dem langen, dunkelblauem Kleid ziemlich daemlich aus.\n";
    }
    else
    {
      s = "Sie sieht in dem langen, dunkelblauen Kleid sehr elegant und "
          "anziehend aus.\n";
    }
  }

  return s;
}

