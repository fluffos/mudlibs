
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Hornring");
  SetProp(P_LONG,
    "Ein kleiner Ring aus Horn ist nicht gerade sehr huebsch anzusehen. "
    "Er scheint auch schon sehr sehr alt zu sein." );
  SetProp(P_INFO, BS("Diesen Ring umgibt eine heilige Aura.") );
  SetProp(P_NAME, "Hornring");
  SetProp(P_GENDER, MALE);
  AddId( ({"hornring", "ring"}) );

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 2 );
  SetProp(P_MATERIAL, MAT_HORN );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100+random(20));

  AddProp( P_DAM_PROTECTION, ([DT_HOLY:1]) );
}
