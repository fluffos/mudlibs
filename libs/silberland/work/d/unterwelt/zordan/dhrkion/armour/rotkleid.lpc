#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Ein weinrotes Kleid");
  SetProp(P_LONG,
    "Ein Kleid aus weinroter Seide. Es hat weite Aermel und einen tiefen, "
    "geschwungenen Ausschnitt. Der Rock ist weit und reicht bis zum Boden. "
    "Das eng anliegende Oberteil und die Aermel sind mit kleinen, goldenen "
    "spinnennetzen bestickt. "
  );

  SetProp(P_NAME, "Kleid");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"kleid"}) );

  SetProp(P_NAME_ADJ, "weinrot");
  AddAdjective( ({"weinroten","weinroter","weinrotem","weinrotes","weinrote"}) );
  AddAdjective( ({"roten","roter","rotem","rotes","rote"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 19 );
  SetProp(P_MATERIAL, ([MAT_SILK:100 ]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 500+random(100));

  SetProp( P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]) );
}
