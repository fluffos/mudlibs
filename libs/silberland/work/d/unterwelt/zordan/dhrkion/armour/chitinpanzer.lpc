
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Chitinruestung");
  SetProp(P_LONG,
    "Diese Ganzkoerperruestung aus Chitin schuetzt seinen Traeger vor jeder "
    "Art von Angriff. Viele tausend kleine Spinnenkoerper wurden in ihm "
    "verarbeitet. Nur ein perfekter Schmied kann so ein Wunderwerk "
    "vollbringen. Die Ruestung ist recht gross und sicher nur von Dunkelelfen zu "
    "tragen." );
  SetProp(P_NAME, "Chitinruestung");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"chitinruestung", "ruestung"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 30);
  SetProp(P_MATERIAL, MAT_CHITIN );
  SetProp(P_WEIGHT, 1300);
  SetProp(P_VALUE, 1300+random(200));
  SetProp( P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Dunkelelf","Drider"})]));
}
