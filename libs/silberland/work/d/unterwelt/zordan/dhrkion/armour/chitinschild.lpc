//Auf Anfrage ein Chitinschild fuer Delfen. 
//(c) Cleme 2011 


inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../def.h"

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Chitinschild");
  SetProp(P_LONG,
    "Dieses robuste Schild aus Chitin wurde wohl aus sehr sehr vielen "
    "Spinnenkoerpern hergestellt. Sie wurden kunstvoll aneinandergereiht "
    "und bieten so sicherlich einen guten Schutz. Leider ist das Schild "
    "recht gross und daher nur von Dunkelelfen zu tragen.");
  SetProp(P_NAME, "Chitinschild");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"chitinschild", "schild"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 22);
  SetProp(P_MATERIAL, MAT_CHITIN );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 800+random(100));
  SetProp( P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Dunkelelf"})]));
}

