#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ledersandalen");
  SetProp(P_LONG,
    "Die Sohle dieser Sandalen besteht aus festem Leder. Das Leder ist "
    "flexibel genug, um auch im Kampf wendig zu sein, und doch fest "
    "genug, so dass man einen guten und sicheren Stand hat. Doch auch "
    "im normalen Alltag tragen Dunkelelfen gerne diese Sandalen, "
    "da sie sehr bequem und zudem sehr edel aussehen. "
  );

  AddDetail( ({"leder"}) ,
    "Koennte sich eventuell um Einhornleder handeln."
  );

  AddDetail( ({"einhornleder","einhorn"}) ,
    "Fuer dieses Paar Sandalen musste ein Einhorn sterben."
  );

  SetProp(P_NAME, "Sandalen");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"sandalen","sandale","ledersandalen"}) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 3 );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 100);
  SetProp(P_MATERIAL, ([MAT_LEATHER:75,MAT_SILK:25]) );

  SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE      : 180 ]) );

}
