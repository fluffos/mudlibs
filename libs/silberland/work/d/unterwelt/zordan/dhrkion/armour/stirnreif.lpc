inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <moredef.h>

string *gemlist;
string gem;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  gemlist = ({"rubin","aquamarin","topas","smaragd","saphir","opal"
             ,"onyx","bernstein","granat","bergkristall","diamant"
             ,"amethyst","zirkon","tuerkis","turmalin","achat"
             ,"lapislazuli"
             });

  gem = gemlist[random(sizeof(gemlist))];

  SetProp(P_SHORT, "Ein silberner Stirnreif");
  SetProp(P_LONG,
    "Ein silberner Stirnreif, wie er sowohl von weiblichen als auch von "
    "maennlichen Dunkelelfen getragen wird. Der Stirnreif besteht aus "
    "fein ziseliertem Silber und laesst die weissen Haare der Dunkelelfen "
    "lang den Ruecken hinunterfallen. Auf der Stirn ist der Reif etwas "
    "dicker. Dort ist in einer Fassung ein Edelstein eingelassen. "
  );

  SetProp(P_NAME, "Stirnreif");
  SetProp(P_GENDER, MALE);
  AddId( ({"stirnreif", "reif"}) );

  SetProp(P_NAME_ADJ, "silbern");
  AddAdjective( ({"silbernen","silberner","silbernem","silbernes","silberne"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 1);
  SetProp(P_MATERIAL, ([MAT_SILVER:95,MAT_MISC_JEWEL:5]) );
  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 100);


  AddDetail( ({"fassung"}) ,
    "In die Fassung wurde ein Edelstein eingelassen."
  );

  AddDetail( ({"edelstein"}) ,
    "Es ist ein wunderschoen geschliffener "+CAP(gem)+"."
  );

  AddDetail( ({gem}) ,
    "Der "+CAP(gem)+" ist wirklich wunderschoen geschliffen. Ob man den "
    "herausbrechen kann?"
  );

  AddCmd( ({"brech","breche","brich"}) ,"cmd_brechen");
}

int cmd_brechen(string str)
{
  string was;
  int ok;

  notify_fail("Was willst Du aus dem Stirnreif herausbrechen?\n");

  if(!str || str == "") return 0;

  was = "";
  ok  = 0;

  if(!ok && (sscanf(str, "%s aus stirnreif heraus", was) == 1)) ok = 1;
  if(!ok && (sscanf(str, "%s aus stirnreif aus", was)    == 1)) ok = 1;
  if(!ok && (sscanf(str, "%s aus stirnreif", was)        == 1)) ok = 1;
  if(!ok && (sscanf(str, "%s aus reif heraus", was)      == 1)) ok = 1;
  if(!ok && (sscanf(str, "%s aus reif aus", was)         == 1)) ok = 1;
  if(!ok && (sscanf(str, "%s aus reif", was)             == 1)) ok = 1;
  if(!ok && (sscanf(str, "%s heraus",was)                == 1)) ok = 1;
  if(!ok && (sscanf(str, "%s raus",was)                  == 1)) ok = 1;

//tell_object(TP,sprintf("(%s) %d /%s/ \n",TP->_unparsed_args(),ok,was));

  if(!ok) return 0;

  if(!(was == gem || was == "edelstein"))
  {
    tell_object(TP,"So etwas befindet sich nicht an dem Stirnreif.");
     return 1;
  }

  tell_object(TP,BS("Du brichst den "+CAP(gem)+" aus der Fassung heraus, aber "
                "der Stirnreif geht dabei kaputt."));

  "/obj/gemmaster"->DistributeGem(1, 0, 0, TP, ({gem}) );

  RemoveCmd( ({"brech","breche","brich"}) );
  call_out("remove",0);
  return 1;
}

string extra_look()
{
  string s;

  s = "";
  if(QueryProp(P_WORN))
  {
    s = CAP(ENV(TO)->QueryPronoun(WER))+" traegt einen edlen Stirnreif.\n";
  }

  return s;
}

