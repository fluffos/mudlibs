
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine leichte Hose");
  SetProp(P_LONG,
    "Eine leicht offene Hose mit keinen Besonderheiten daran. Ausser vielleicht, "
    "dass sie komplett schwarz und ziemlich unmodisch ist." );
  SetProp(P_NAME, "Hose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 7);
  SetProp(P_MATERIAL, ([MAT_COTTON:80, MAT_CLOTH:20 ]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 1200);
}
