
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Chitinarmschienen");
  SetProp(P_LONG,
    "Diese robusten Armschienen sind aus Chitin gemacht. Ihre harte Oberflaeche "
    "schuetzt hervorragend vor Angriffen jeder Art. Leider sind sie so gross "
    "geraten, so dass nur Dunkelelfen in der Lage sind sie zu tragen." );
  SetProp(P_NAME, "Chitinarmschienen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PLURAL, 1);
  AddId( ({"chitinarmschienen", "armschienen"}) );

  SetProp(P_ARMOUR_TYPE, AT_BRACERS );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, MAT_CHITIN );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 400+random(20));
  SetProp( P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Dunkelelf","Drider"})]));
}
