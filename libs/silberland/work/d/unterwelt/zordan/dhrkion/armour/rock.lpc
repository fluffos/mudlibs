inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>

void create()
{
  if( !is_clone(this_object()) ) return;

  ::create();

  SetProp(P_SHORT, "Ein Rock");
  SetProp(P_LONG,
    "Ein langer Rock aus weichem Einhornleder. Seltsame dunkelelfische "
    "Runen wurden mit einem Brenneisen eingebrannt. "
  );

  SetProp(P_NAME, "Rock" );
  SetProp(P_GENDER, MALE);
  AddId( ({"rock"}) );
  SetProp(P_INFO, "Natuerlich tragen nur Frauen so einen Rock.\n");

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 120);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE ]) );

  AddSpecialDetail( ({"rune","runen"}) , "detail_rune" );
}

string detail_rune(string str)
{
  string s;

  if(TP->QueryProp(P_RACE) == "Dunkelelf")
  {
    s = "Seltsame, magische Worte. Sie stammen wohl noch aus der "
        "Altvorderenzeit und ihre Bedeutung wurde vergessen. ";
  }
  else
  {
    s = "Als "+TP->QueryProp(P_RACE)+" kannst Du die Runen nicht lesen.";
  }

  return BS(s);
}

