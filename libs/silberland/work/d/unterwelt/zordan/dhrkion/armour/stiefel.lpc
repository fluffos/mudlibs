#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Hohe Schaftstiefel");
  SetProp(P_LONG,
    "Der Schaft dieser Stiefel reicht bis unter die Kniee und schuetzt daher "
    "die Fuesse besonders gut. Die Stiefel selbst sind so schwarz, dass "
    "es so aussieht, als ob sie das Licht selbst verschlucken wuerden. "
    "Die Stiefel sind mit silbrigen Sprenkeln verziert, so dass sie wie "
    "ein Sternenhimmel bei tiefscharzer Nacht aussehen. "
  );

  SetProp(P_PLURAL, 1);

  SetProp(P_NAME, "Schaftstiefel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schaftstiefel","stiefel"}) );

  SetProp(P_NAME_ADJ, ({"hoh","schwarz"}) );
  AddAdjective( ({"hohen","hoher","hohem","hohes","hohe"
    ,"schwarzen","schwarzer","schwarzem","schwarzes","schwarze"})
  );

  SetProp(P_INFO,BS(Name(WER,1)+" bieten guten Schutz vor Kaelte, stellen aber "
                    "bei Hitze eine Belastung dar."));

  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:3, T_HEAT_PROT:-2 ]) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 7 );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 420);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );

  SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE      : 180 ]) );

}
