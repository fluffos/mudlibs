
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

int filled;

create() {
  if( !is_clone(TO) ) return;
  ::create();

  filled=0;

  SetProp(P_SHORT, "Ein kleiner Ring aus Kristall");
  SetProp(P_LONG,
    "Der kleine Ring aus Kristall ist wunderbar verziert und sicher eine "
    "ganze Menge wert. Eine kleine Einkerbung auf seiner Oberseite macht "
    "Dich neugierig. Die Inschrift auf seiner Innenseite kannst Du leider "
    "nicht entziffern." );

  AddDetail( ({ "kristall" }),
    "Kristallklar schimmert der kleine Ring.");
  AddDetail( ({ "oberseite" }),
    "Auf der Oberseite hat der kleine Ring eine Einkerbung.");
  AddDetail( ({ "innenseite","seite" }),
    "Auf der Innenseite kannst Du eine Inschrift erkennen.");
  AddReadDetail( ({ "inschrift","schrift" }),
    "Du kannst sie leider nicht entziffern.");
  AddDetail( ({ "licht" }),
    "Der kleine Ring reflektiert das Licht sehr merkwuerdig.");
  AddDetail( ({ "farbe","farben" }),
    "Alle Farben des Regenbogens sind vorhanden.");
  AddDetail( ({ "regenbogen","bogen" }),
    "Tatsaechlich, ein kleiner Regenbogen geht von dem Ring aus.");
  AddSpecialDetail( ({ "einkerbung" }), "einfkt");
  AddSpecialDetail( ({ "reflexion","reflexionen",
                       "reflektion","reflektionen" }), "reffkt");

  SetProp(P_INFO, BS(
    "Der kleine Ring reflektiert das Licht in vielen verschiedenen Farben.") );
  SetProp(P_NAME, "Ring");
  SetProp(P_NAME_ADJ,"klein");
  SetProp(P_GENDER, MALE);
  AddId( ({"ring", "lichtring", "kristallring", "\n_licht_ring","NOUNCURSE"}) );
  AddAdjective( ({ "klein","kleiner" }) );

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([ MAT_CRYSTAL:80, MAT_MAGIC:20 ]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 2000);
  SetProp(P_CURSED,0);
  SetProp(P_NOBUY, 1);

  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );
}

init() {
  ::init();
  if(query_once_interactive(TP)) {
    add_action("steckfkt","stecke");
    add_action("steckfkt","steck");
  }
}

nosave int steckfkt(string str) {
  string was,wohin;
  object ob;
  notify_fail("WAS soll ich WOHIN stecken?\n");
  if(!str) return 0;
  if((sscanf(str,"%s in %s",was,wohin) != 2) &&
     (sscanf(str,"%s in %s ein",was,wohin) != 2) &&
     (sscanf(str,"%s in %s rein",was,wohin) != 2)) return 0;
  if(!ob=present(was,TP)) return 0;
  if(wohin != "einkerbung") return 0;
  if(was != "erz" && was != "mithrilerzbrocken" && 
     was != "erzbrocken" && was != "brocken") {
    write(BS(
      "Das lohnt sich nicht in Verbindung mit dem kleinen Kristallring."));
    return 1;
  }
  if(!ob=present("mithrilerzbrocken",TP)) return 0;
  if(!QueryProp(P_WORN)) {
    write(BS(
      "Du musst den kleinen Ring aus Kristall dafuer schon tragen."));
    return 1;
  }
  if(filled) {
    write(BS(
      "Es steckt doch noch ein kleiner Brocken aus Erz in der Einkerbung "
      "drin."));
    return 1;
  }
  say(BS(
    CAP_TPN+" nimmt einen kleinen Erzbrocken und steckt ihn in einen kleinen "
            "Ring aus Kristall."));
  ob->AddAmount(-1);
  if(QueryProp(P_CURSED)) {
    write(BS(
      "Du nimmst einen kleinen Brocken Erz und brichst ein passendes Stueck "
      "fuer die Einkerbung heraus. Das kleine Stueck setzt Du vorsichtig in "
      "die Einkerbung ein. Mit einem lauten Knall zerspringt der Brocken."));
    TP->AddHp(-(10+random(10)));
    return 1;
  }
  filled=1;
  write(BS(
    "Du nimmst einen kleinen Brocken Erz und brichst ein passendes Stueck "
    "fuer die Einkerbung heraus. Das kleine Stueck setzt Du vorsichtig in "
    "die Einkerbung ein. Ein magisches Leuchten umhuellt den Brocken."));
  return 1;
}

nosave string nr2str(int nr) {
  switch(nr) {
    default: 
      return sprintf("%d",nr);
    case  0:
      return "null";
    case  1:
      return "ein";
    case  2:
      return "zwei";
    case  3:
      return "drei";
    case  4:
      return "vier";
    case  5:
      return "fuenf";
    case  6:
      return "sechs";
    case  7:
      return "sieben";
    case  8:
      return "acht";
    case  9:
      return "neun";
    case 10:
      return "zehn";
    case 11:
      return "elf";
    case 12:
      return "zwoelf";
  }
}

nosave string light2str(int nr) {
  switch(nr) {
    default:
      return "unbekannt hell";
    case -10000 .. -3:
      return "unglaublich dunkel";
    case -2 .. -1:
      return "sehr dunkel";
    case 0:
      return "dunkel";
    case 1:
      return "hell";
    case 2 .. 3:
      return "sehr hell";
    case 4 .. 10000:
      return "unglaublich hell";
  }
}

string reffkt() {
  int i,nr,total,raum,liv,livl,obj,objl;
  object env,ob,*inv;
  string str;
  if(!QueryProp(P_WORN)) {
    return BS(
      "Die Reflektionen des Ringes verteilen sich im Raum. Etwas Besonderes "
      "kannst Du darin aber nicht erkennen.");
  }
  if(!filled || !env=ENV(QueryProp(P_WORN))) {
    return BS(
      "Die Reflektionen des Ringes verteilen sich ueber Deine Hand. Etwas "
      "besonderes kannst Du darin aber nicht erkennen.");
  }
  inv=deep_inventory(env);
  raum=env->QueryProp(P_LIGHT);
  total=env->_query_total_light();
  liv=livl=obj=objl=0;
  for (i=0;i<sizeof(inv);i++) {
    ob=inv[i];
    nr=ob->QueryProp(P_LIGHT);
    if(nr==0) continue;
    if(!living(ob)) {
      obj++;
      if(nr<0) nr++;
      objl+=nr;
    } else {
      liv++;
      if(nr<0) nr++;
      livl+=nr;
    }
  }
  write(BS(
    "Du konzentrierst Dich und schaust Dir die Reflektionen ganz genau an:"));
  write(BS(
    "---------------------------------------------------------------------"));
  if(raum==total) {
    write(BS(
      "An diesem Ort ist es wie es sein sollte "+light2str(raum)+"."));
  } else {
    write(BS(
      "An diesem Ort ist es normalerweise "+light2str(raum)+"."));
    write(BS(
      "Allerdings ist es hier derzeit "+light2str(total)+"."));
  }
  if(obj!=0 || liv!=0) {
    str="Der Unterschied zu den normalen Lichtverhaeltnissen wird durch ";
    if(obj!=0) {
      if(obj==1)
        str+="einen Gegenstand, der "+light2str(objl)+" ist, ";
      else 
        str+=nr2str(obj)+" Gegenstaende, die insgesamt "+
             light2str(objl)+" sind, ";
    }
    if(obj!=0 && liv!=0) str+="und ";
    if(liv!=0) {
      if(liv==1)
        str+="ein Lebewesen, das "+light2str(livl)+" ist, ";
      else
        str+=nr2str(liv)+" Lebewesen, die insgesamt "+
             light2str(livl)+" sind, ";
    }
    str+="hervorgerufen.";
    write(break_string(str,69));
  }
  write(BS(
    "---------------------------------------------------------------------"));
  if(!random(5)) {
    write(BS(
      "Der kleine Erzbrocken in der Einkerbung hat seine magische Faehigkeit "
      "verloren und zerspringt in tausende Stuecke."));
    filled=0;
  }
  return "";
}

string einfkt() {
  if(filled) {
    return BS(
      "Ein kleiner Brocken aus Erz wurde in die Einkerbung gesteckt.");
  }
  return BS(
    "Es sieht so aus, als koennte man ganz spezielle Dinge aus Erz in diese "
    "Einkerbung stecken.");
}

varargs int DoWear(int silent, int all) {
  int ret;
  ret = ::DoWear (silent, all);
  if(QueryProp(P_WORN) && !TP->id("Dunkelelfenspieler") && interactive(TP)) {
    if(random(5)) {
      write(BS(
        "Der kleine Ring aus Kristall zieht sich sehr fest um Deinen Finger."));
      SetProp(P_CURSED,1);
    }
  }
  return ret;
}

int RemoveFunc(object me) {
  if(!QueryProp(P_CURSED)) return 1;
  write(BS(
    "Je mehr Du an dem kleinen Ring aus Kristall herumfummelst, umso staerker "
    "zieht er sich um Deinen Finger."));
  say(BS(
    CAP_TPN+" zerrt an einem kleinen Ring aus Kristall herum, bekommt ihn aber "
    "selbst mit roher Gewalt nicht herunter."));
  TP->AddHp(-(10+random(10)));
  return 0;
}

int DefendFunc(mixed dam_type, int spell, object enemy) {
  object ob;
  if(!random(1000)) {
    if(!QueryProp(P_CURSED) && ob=QueryProp(P_WORN)) {
      tell_object(ob,BS(
        "Der kleine Ring aus Kristall wird hart getroffen und zerbroeselt in "
        "viele kleine tausend Teile."));
      DoUnwear(1);
      call_out("remove",0);
    }
  }
  if(QueryProp(P_CURSED)) return -(10+random(10));
  return 0;
}
