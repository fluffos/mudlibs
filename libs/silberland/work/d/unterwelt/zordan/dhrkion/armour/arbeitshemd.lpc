#include "../def.h"

inherit "/std/armour";

#include <properties.h>
#include <combat.h>
#include "/p/daemon/itemd/itemd.h"

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Arbeitshemd");
  SetProp(P_LONG,
    "Ein Arbeitshemd, wie es die Sklaven in Dhrkion tragen muessen. "
    "Eigentlich sieht es aus wie ein Sack aus groebstem Leinen, indem "
    "man an der Seite zwei Loecher fuer die Arme und in der Mitte ein "
    "Loch fuer den Kopf geschnitten hat. "
  );

  SetProp(P_NAME, "Arbeitshemd");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"hemd", "arbeitshemd","sklavenhemd"}) );

  SetProp(P_ITEMD_NO_MAGIC,1);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 3);

}

