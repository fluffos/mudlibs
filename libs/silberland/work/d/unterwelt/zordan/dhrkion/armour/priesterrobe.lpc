
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Priesterrobe");
  SetProp(P_LONG,
    "Die Robe gehoerte einst einer hohen Dunkelefenpriesterin. Sie ist komplett "
    "aus Samt und Seide gemacht. An ihrer Ausstrahlung bemerkt man sofort, dass "
    "sie boesen Maechten entsprungen sein muss. Tragen kann man sie wohl auch "
    "nur dann, wenn man besonders gute Faehigkeiten an den Tag legt." );
  SetProp(P_INFO, BS(
    "Es koennte sein, dass unerwartete Dinge passieren." ));
  SetProp(P_NAME, "Priesterrobe");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"priesterrobe","robe"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_SILK:60, MAT_VELVET:40 ]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 500+random(500));
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1, A_INT:20]) );
  SetProp(P_DEFEND_FUNC, TO );
}

int DefendFunc(mixed dam_type, int spell, object enemy) {
  int i;
  object owner;
  if (random(3)) return 0;
  if (member(dam_type, DT_HOLY) != -1) {
    i=random(100)+100;
    owner=QueryProp(P_WORN);
    tell_object(owner,BS(
      "Die Robe wandelt einen Zauberspruch Deines Gegners und schlaegt ihn zurueck."));
    tell_object(enemy,BS(
      "Die Robe Deines Gegners leuchtet ketzerisch auf und Dich trifft ein Schlag." ));
    if (MENV && interactive(MENV)) MENV->SetProp(P_SP,MENV->QueryProp(P_SP)-1);
    enemy->Defend(i, DT_UNHOLY, ([SP_SHOW_DAMAGE:1,SP_NAME:"Robe"]), owner );
    return i;
  }
/*  entfernt weil wohl dich zu maechtig *schnief* ;))))
    if (member(dam_type, DT_UNHOLY) != -1) {
    i=random(10)+10;
    owner=QueryProp(P_WORN);
    tell_object(owner,BS(
      "Die Robe wandelt einen Zauberspruch Deines Gegners und schlaegt ihn zurueck."));
    tell_object(enemy,BS(
      "Die Robe Deines Gegners leuchtet heilig auf und Dich trifft ein Schlag." ));
    enemy->Defend(5*i, DT_HOLY, ([SP_SHOW_DAMAGE:1,SP_NAME:"Robe"]), owner );
    return i;
  }
*/
  return 0;
}
