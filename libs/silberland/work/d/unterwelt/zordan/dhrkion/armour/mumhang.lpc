#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  string *farben;
  int rf,nf;

  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein pechschwarzer Umhang");
  SetProp(P_LONG,
    "Mystixfis's Umhang ist kaum zu erkennen. Die dunkle Aura des Magiers "
    "ist fast einst mit dem Umhang, und wo Du eben noch die Dunkelheit "
    "fuehlen konntest erkennst Du einmal den scharzen, magischen Umhang. "
  );

  SetProp(P_NAME_ADJ, ({"schwarz","pechschwarz"}) );
  AddAdjective( ({"schwarzen"
                 ,"schwarzer"
                 ,"schwarzem"
                 ,"schwarzes"
                 ,"schwarze"
                 ,"pechschwarzen"
                 ,"pechschwarzer"
                 ,"pechschwarzem"
                 ,"pechschwarzes"
                 ,"pechschwarze"
                 }) );

  AddDetail( ({"seide"}) ,
    "Beste Magieseide!"
  );

  SetProp(P_NAME, "Umhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7 );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_SILK:100]) );
}
