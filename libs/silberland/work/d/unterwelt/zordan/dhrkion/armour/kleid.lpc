
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein huebsches Kleid");
  SetProp(P_LONG,
    "Das ist ein sehr huebsches Kleid einer Dunkelelfin. Solch schoene "
    "Kleider tragen die weiblichen Bewohner von Dhrkion eigentlich immer. "
    "Es hat verschiedene Farben und einige Spitzen. Damit arbeiten sollte "
    "man allerdings nicht, zu schade waere es fuer die Seide. Trotzdem "
    "haelt es durch seine geschickte Herstellung tatsaechlich ein paar "
    "Schlaege aus." );
  SetProp(P_NAME, "Kleid");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"kleid"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 19 );
  SetProp(P_MATERIAL, ([MAT_WOOL:80, MAT_SILK:20 ]) );
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 500+random(100));

  SetProp( P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE]) );
}
