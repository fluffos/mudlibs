
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine Chitinkrone");
  SetProp(P_LONG,
    "Diese Krone aus Chitin gehoerte einst der Dunkelelfenkoenigin. Sie ist "
    "reichlich mit Edelsteinen aller Art verziert. Sie glitzert leicht "
    "und verleiht der Traegerin den Respekt, den sie verdient." );
  SetProp(P_NAME, "Chitinkrone");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"chitinkrone", "krone"}) );

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, MAT_CHITIN );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 2000+random(200));
  SetProp( P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Dunkelelf"})]));
}
