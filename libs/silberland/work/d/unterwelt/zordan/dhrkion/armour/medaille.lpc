
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Medaille");
  SetProp(P_LONG,
    "Diese kleine Medaille aus Platin bekommen nur besonders gute Koeche "
    "verliehen. Wie Du an diese Medaille gekommen bist, wissen wohl nur die "
    "Goetter." );
  SetProp(P_INFO, BS("Irgendwie scheint sie immer direkt ueber Deinem Herzen "
    "haengen zu wollen und bietet daher besonderen Schutz.") );
  SetProp(P_NAME, "Medaille");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"medaille"}) );

  SetProp(P_ARMOUR_TYPE, AT_AMULET );
  SetProp(P_AC, 5 );
  SetProp(P_MATERIAL, MAT_PLATINUM );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1000+random(200));
  SetProp(P_NOBUY, 1);

}
