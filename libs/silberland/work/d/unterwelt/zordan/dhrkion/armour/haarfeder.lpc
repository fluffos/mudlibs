
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Feder");
  SetProp(P_LONG,
    "Diese kleine Feder stammt von einem riesigem Vogel in der Unterwelt. "
    "Man erkennt gleich an der Beschaffenheit, dass das Bekommen dieser "
    "Feder nicht sehr einfach ist. Sie schmueckt haeufig die weiblichen "
    "Dunkelelfen. Man traegt sie in den Haaren." );
  SetProp(P_NAME, "Feder");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"feder"}) );

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC,0 );
  SetProp(P_MATERIAL, ([MAT_FEATHER:100 ]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 500+random(100));
  SetProp(P_NOBUY, 1);
  SetProp(P_WORN_TEXT, "angesteckt");

}
