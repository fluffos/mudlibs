inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create()
{
  if( !is_clone(this_object()) ) return;

  ::create();

  SetProp(P_SHORT, "Ein lederner Guertel");
  SetProp(P_LONG,
    "Ein schmaler Guertel aus Schlangenleder. Der Kopf der Schlange "
    "wurde dabei als Schnalle praepariert, die man mit den den Zaehnen "
    "der Schlange verschliessen kann. "
  );

  SetProp(P_NAME, "Lederguertel");
  SetProp(P_GENDER, MALE);
  AddId( ({"lederguertel", "guertel","schlangenlederguertel"}) );

  SetProp(P_NAME_ADJ, "ledern");
  AddAdjective( ({"ledernen","lederner","ledernem","ledernes","lederne"}) );

  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 1+random(2));
  SetProp(P_MATERIAL, ([MAT_LEATHER:98, MAT_BONE:2 ]) );
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 160);
}

