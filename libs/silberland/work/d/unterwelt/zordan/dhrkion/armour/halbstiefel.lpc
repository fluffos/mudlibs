#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Elegante Halbstiefel");
  SetProp(P_LONG,
    "Die Halbstiefel bestehen aus einer festen Sohle, der Schaft aus weichem "
    "Fohlenleder. Wie fast alle Kleidungsstuecke der Dunkelelfen sind die "
    "Halbstiefel perfekt fuer den Kampf entworfen und zeigen doch eine "
    "Eleganz, wie sie die Dunkelelfen lieben. "
  );

  SetProp(P_PLURAL, 1);

  SetProp(P_NAME, "Halbstiefel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"halbstiefel","stiefel"}) );

  SetProp(P_NAME_ADJ, "elegant");
  AddAdjective( ({"eleganten","eleganter","elegantem","elegantes","elegante"}) );

  SetProp(P_ARMOUR_TYPE, AT_BOOT );
  SetProp(P_AC, 5 );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 250);
  SetProp(P_MATERIAL, ([MAT_LEATHER:95,MAT_SILK:5]) );

  SetProp(P_WEAR_RESTRICTIONS, ([P_SIZE      : 180 ]) );

}
