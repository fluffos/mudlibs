
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Mithrilring");
  SetProp(P_LONG,
    "Dieser kleine Ring ist aus Mithril gemacht. In einer Fassung "
    "ist ein kleiner Rubin eingesetzt worden." );
  SetProp(P_NAME, "Ring");
  SetProp(P_GENDER, MALE);
  AddId( ({"ring"}) );

  SetProp(P_ARMOUR_TYPE, AT_RING );
  SetProp(P_AC, 2);
  SetProp(P_MATERIAL, ([MAT_MITHRIL:80, MAT_METAL:10, MAT_RUBY:10 ]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 100+random(20));

  SetProp(P_QUALITY_DECAY,200);

}
