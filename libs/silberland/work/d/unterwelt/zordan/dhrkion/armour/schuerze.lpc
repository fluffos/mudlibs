
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine dunkle Schuerze");
  SetProp(P_LONG,
    "Eine dunkle, aber eher kleine Schuerze ist eigentlich nur fuer den "
    "Gebrauch in einer Kneipe zu verwenden. Sie ist fast komplett aus Leder, "
    "so dass sie vielleicht sogar etwas vor Wasser schuetzen koennte. An ihr "
    "sind ein paar Knoepfe und zwei Taschen befestigt worden. Allerdings sind "
    "die Taschen leer." );
  SetProp(P_INFO, BS("Du meinst die Schuerze wirkt ganz gut gegen Wasser.") );
  SetProp(P_NAME, "Schuerze");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schuerze"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5 );
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 300+random(50));

  AddProp( P_DAM_PROTECTION, ([DT_WATER:1]) );

}
