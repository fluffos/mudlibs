
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Chitinguertel");
  SetProp(P_LONG,
    "Der kleine Guertel aus Chitin passt sich dem Unterleib seines "
    "Traegers einfach nur perfekt an. Er glitztert leicht im Licht, weil die "
    "vielen, vielen Spinnenkoerper eine glatte Oberflaeche haben." );
  SetProp(P_NAME, "Chitinguertel");
  SetProp(P_GENDER, MALE);
  AddId( ({"chitinguertel", "guertel"}) );

  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_CHITIN );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 300+random(20));
  SetProp( P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Dunkelelf","Drider"})]));
}
