#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Eine dunkelgruene Tunika");
  SetProp(P_LONG,
    "Eine knielange Tunika aus dunkelgruener Seide. Sie hat lange, weite "
    "Aermel und ist an beiden Seiten vom Saum bis zur Huefte geschlitzt. "
    "Der V-foermige Ausschnitt wird mit einem duennen Lederband geschnuert. "
    "Aermel und Saum sind mit schwarzen Seidenfaeden bestickt. "
  );

  SetProp(P_NAME, "Tunika");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"tunika"}) );

  SetProp(P_NAME_ADJ, "dunkelgruen");
  AddAdjective( ({"dunkelgruenen","dunkelgruener","dunkelgruenem"
                 ,"dunkelgruenes","dunkelgruene"}) );
  AddAdjective( ({"gruenen","gruener","gruenem","gruenes","gruene"}) );

  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC,0);
  SetProp(P_MATERIAL, ([MAT_SILK:100 ]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 300);
}
