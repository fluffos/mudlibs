#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  string *farben;
  int rf,nf;

  if( !is_clone(TO) ) return;
  ::create();

  farben = ({"dunkelgruen","dunkelblau","dunkelviolett","dunkelgrau"});
  nf = sizeof(farben);
  rf = random(nf);

  SetProp(P_SHORT, "Ein "+farben[rf]+"er Umhang");
  SetProp(P_LONG,
    "Ein Umhang, wie er einem Dunkelelfen wuerdig ist. "+CAP(farben[rf])+
    " schimmert die Seide. Trotzdem der Umhang leicht und elegant ist, "
    "bietet er im Kampf doch einen guten Schutz. "
  );

  SetProp(P_NAME_ADJ, farben[rf]);
  AddAdjective( ({farben[rf]+"en"
                 ,farben[rf]+"er"
                 ,farben[rf]+"em"
                 ,farben[rf]+"es"
                 ,farben[rf]+"e"
                 })
  );

  AddDetail( ({"seide","spinnenseide"}) ,
    "Beste Spinnenseide!"
  );

  SetProp(P_NAME, "Umhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"umhang"}) );

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 7 );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 400);
  SetProp(P_MATERIAL, ([MAT_SILK:100]) );
}
