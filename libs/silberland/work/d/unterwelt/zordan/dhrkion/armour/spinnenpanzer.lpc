
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Spinnenpanzer");
  SetProp(P_LONG,
    "Der Panzer wurde aus den Haeuten einer Spinne gemacht. Er schimmert "
    "dadurch leicht silbern und verleiht dem Traeger ein stattliches "
    "Aussehen. Durch die geschickt verwobenen Einzelteile bietet der "
    "Spinnenpanzer einen wirklich guten Schutz." );
  SetProp(P_INFO, BS("Du bist Dir nicht sicher, aber es scheint so, "
    "als ob der Panzer ein wenig vor Feuer schuetzt.") );
  SetProp(P_NAME, "Spinnenpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"spinnenpanzer", "panzer" }) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 27 );
  SetProp(P_MATERIAL, ([MAT_BONE:20, MAT_CHITIN:20, MAT_HORN:60 ]) );
  SetProp(P_WEIGHT, 2100);
  SetProp(P_VALUE, 500+random(100));
  AddProp(P_DAM_PROTECTION, ([DT_FIRE:1]) );
}
