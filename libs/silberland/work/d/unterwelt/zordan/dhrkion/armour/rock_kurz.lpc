inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <defines.h>

void create()
{
  if( !is_clone(this_object()) ) return;

  ::create();

  SetProp(P_SHORT, "Ein kurzer Rock");
  SetProp(P_LONG,
    "Dieser Minirock bringt lange Beine besonders gut zur Geltung. "
    "Natuerlich kann nicht Jede einen solchen Minirock tragen, die "
    "entsprechende Figur muss man schon dazu haben. Dieser Rock wurde "
    "aus gegerbten Feenfluegeln gefertigt und schimmert leicht silbrig, "
    "besonders im Mondlicht. "
  );

  SetProp(P_NAME, "Rock" );
  SetProp(P_GENDER, MALE);
  AddId( ({"rock","minirock","\nfeen_fluegel_rock"}) );

  SetProp(P_NAME_ADJ, "kurz");
  AddAdjective( ({"kurzen","kurzer","kurzem","kurzes","kurze"}) );

  SetProp(P_INFO, "Natuerlich tragen nur Frauen einen solch kurzen Rock.\n");

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 3);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]) );
  SetProp(P_WEIGHT, 170);
  SetProp(P_VALUE, 100);
  SetProp(P_WEAR_RESTRICTIONS, ([P_GENDER:FEMALE ]) );

}

