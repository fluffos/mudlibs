#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine eklige Wurmhaut");
  SetProp(P_LONG,
    "Diese kleine Wurmhaut gehoerte mal einem kleinen Wurm aus der Unterwelt. "
    "Eklig glitscht sie in Deinem Inventar hin und her."
  );

  SetProp(P_NAME, "Wurmhaut");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"wurmhaut","haut" }) );

  SetProp(P_NAME_ADJ, ({"eklig"}) );
  AddAdjective( ({"ekligen","ekliger","ekligem","ekliges","eklige"}) );

  SetProp(P_MATERIAL, ([MAT_FLESH:100]) );
  SetProp(P_WEIGHT, 5);
  SetProp(P_VALUE, 50);
}
