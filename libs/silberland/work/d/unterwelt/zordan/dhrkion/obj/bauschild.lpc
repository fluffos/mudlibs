
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Baustellenschild");
  SetProp(P_LONG,
    ".------------------------------------------------------------------------.\n"
    "|                                                                        |\n"
    "|                      ACHTUNG BAUSTELLE !!!!                            |\n"
    "|                      ======================                            |\n"
    "|                                                                        |\n"
    "| Hier entsteht das  Haus von Elvira und Zordan.  Waehrend der Bauphase  |\n"
    "| ist es Unbefugten bei Todesstrafe verboten, die Baustelle zu betreten. |\n"
    "|                                                                        |\n"
    "| Eltern haften fuer ihre Kinder.                                        |\n"
    "|                                                                        |\n"
    "|                                        gez. i.A. von Elvira und Zordan |\n"
    "|                                             Die Koenigin               |\n"
    "|                                                                        |\n"
    " ------------------------------------------------------------------------ \n"
  );
  SetProp(P_NAME, "Baustellenschild");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "baustellenschild","schild" }) );

  SetProp(P_MATERIAL, MAT_MISC_WOOD );
  SetProp(P_WEIGHT, 100000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, "Das Baustellenschild ist fest im Boden verankert.\n");

  AddReadDetail( ({ "schild","baustellenschild" }) , "@@lesfkt@@" );

}

string lesfkt() {
  return QueryProp(P_LONG);
}
