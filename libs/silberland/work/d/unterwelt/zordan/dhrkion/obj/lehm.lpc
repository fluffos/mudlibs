#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein kleiner Lehmklumpen");
  SetProp(P_LONG,
    "Ein kleiner dreckiger Lehmklumpen aus Dhrkion. Eigentlich ziemlich "
    "wertlos und zu nichts zu gebrauchen."
  );

  SetProp(P_INFO, "In seinem Innneren scheint etwas zu sein.\n");
  SetProp(P_NAME, "Lehmklumpen");
  SetProp(P_GENDER, MALE);
  AddId( ({ "lehmklumpen","klumpen","\n_runenquest_lehm"
          , "QUESTOBJ", "NODESTUCT" }) );

  SetProp(P_NAME_ADJ, ({"klein"}) );
  AddAdjective( ({"kleinen","kleiner","kleinem","kleines","kleine"}) );

  SetProp(P_MATERIAL, ([MAT_EARTH]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);

  AddCmd( ({"brich","brech","breche"
           ,"oeffne","zerbrich","zerlege"
           ,"zerbrech","zerbreche"             }) , "cmd_brechen" );
}

int cmd_brechen(string str)
{
  object gem;
  int ok;
  string was;

  notify_fail("Was willst Du aufbrechen?\n");

  if(!str || str == "") return 0;

  ok = id(str);
  if(ok) was = str;

  if(!ok) if(sscanf(str,"%s auf",         was) == 1) ok = 1;
  if(!ok) if(sscanf(str,"%s auseinander", was) == 1) ok = 1;

  if(ok == 0)  return 0;
  if(!id(was)) return 0;

  if(present("\n_runenquest_edelstein",TP))
  {
    tell_object(TP, "Der Lehmklumpen zerfaellt zu Staub.\n");
    call_out("remove", 0);
    return -1;
  }

  if((RUNENMASTER->IsRuneHere(getuuid(TP), 8) == 0))
  {
    tell_object(TP, "Der Lehmklumpen zerbroeselt zu Staub.\n");
    call_out("remove", 0);
    return -1;
  }

  tell_object(TP, BS("Du nimmst den Lehmklumpen in beide Haende und mit "
                     "einem kraeftigen Ruck brichst Du den Lehmklumpen "
                     "auseinander. Ein kleiner Edelstein war darin, den "
                     "Du gleich einsteckst." ));

  gem = clone_object(OBJ "edelstein");
  gem->move(TP, M_NOCHECK);
  call_out("remove", 0);

  return 1;
}
