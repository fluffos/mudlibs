
inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../def.h"

init() {
  ::init();
  if(TP->QueryProp(P_LEVEL) < 10) {
    SetProp (P_FOOD_INFO, ([F_HEAL:5+random(5), F_SOAK:4,
                            F_ALCOHOL:0, F_POISON:0]));
  } else {
    SetProp (P_FOOD_INFO, ([F_HEAL:0,    F_SOAK:0,
                            F_ALCOHOL:0, F_POISON:0]));
  }
}

create() {
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Rothehaxe");
  SetProp (P_LONG, "Das ist die Haxe einer Rothe. Die ist bestimmt sehr lecker.\n");
  SetProp (P_NAME, "Rothehaxe");
  SetProp (P_GENDER, FEMALE);
  AddId ( ({ "rothehaxe","haxe" }) );
  SetProp (P_VALUE, 50);
  SetProp (P_WEIGHT, 250);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL:5+random(5), F_SOAK:4,
                          F_ALCOHOL:0, F_POISON:0]));
}

BeimEssen() {
  write ("Du verzehrst genuesslich die Rothehaxe und fuehlst Dich sau wohl.\n");
  say (CAP_TPN+" verspeist genuesslich eine Rothehaxe.\n");
  return ::BeimEssen();
}
