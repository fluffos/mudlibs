mapping getcolors() {

  return ([

    0x52:ANSI_RED+ANSI_INVERS,   // Gilde

    0x35:ANSI_BLUE+ANSI_INVERS,  // Kneipe

    0x58:ANSI_GREEN+ANSI_INVERS, // Post

    0x55:ANSI_PURPLE+ANSI_INVERS,// Tempel

    0x74:ANSI_INVERS,            // Laden

    0x36:ANSI_RED,               // Zelle

    0x37:ANSI_RED,               // Zelle

    0x46:ANSI_RED,               // Zelle

    0x17:ANSI_YELLOW,            // Park

    0x18:ANSI_YELLOW,            // Park

    0x29:ANSI_YELLOW,            // Park

    0x39:ANSI_YELLOW,            // Park

    0x89:ANSI_YELLOW,            // Rothe

    0x99:ANSI_YELLOW,            // Rothe

    0x8a:ANSI_YELLOW,            // Rothe

    0x9a:ANSI_YELLOW,            // Rothe

  ]);

}



