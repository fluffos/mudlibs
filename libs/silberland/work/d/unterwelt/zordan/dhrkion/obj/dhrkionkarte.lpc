"                        o<_       _>o         Rothe-Rothe ",

"                           \\_   _/                        ",

"                             `o´                          ",

""});

}





string long() {

  string *map,fn,term;

  mapping pos,cols;

  int x,x1,x2,y,i,j;



  map=getmap()[0..];

  if (!TP) return implode(map,"\n");



  term=TP->QueryProp(P_TTY);

  switch(term) {

    case "ansi":  cols=getcolors(); break;

    case "vt100": cols=gethilite(); break;

    default:;

  }



  // Position des Spielers eintragen

  if (environment(TP)) {

    pos=getpos();

    fn=file_name(environment(TP));

    if (fn[0..32]=="/d/unterwelt/zordan/dhrkion/room/") fn=fn[33..];

    x=pos[fn,0];y=pos[fn,1];

    if (x||y) {

      if (mappingp(cols)) {

        switch(term) {

          case "ansi":  cols[16*x+y]=ANSI_RED+ANSI_INVERS; break;

          case "vt100": cols[16*x+y]=ANSI_INVERS; break;

          default:;

        }

      }

      x*=6;

      if (x > 54) x=54;

      y*=2;

      if (y > 22) y=22;



#define IS_LETTER(c) ( (((c&223)>='A') && ((c&223)<='Z')) || \
    ((c>='0') && (c<='9')) )



      x1=x; while (IS_LETTER(map[y][x1])) map[y][x1--]=' ';

      x2=x+1; while (IS_LETTER(map[y][x2])) map[y][x2++]=' ';

      map[y][x-1..x+1]="XXX";

    }

  }



  // Karte einfaerben:

  if (mappingp(cols)) {

    for (i=11;i>=0;i--) {

      y=2*i;

      for (j=10;j>=0;j--) {

        // x=6*j;

        x=6*j;

        x2=x;

        while(IS_LETTER(map[y][x])) x--;

        while (IS_LETTER(map[y][x2])) x2++;

        if (map[y][x2]=='!') x2++;

        if (fn=cols[16*j+i]) {

          map[y]=

            map[y][0..x]+

            fn+map[y][(x+1)..(x2-1)]+ANSI_NORMAL+

            map[y][x2..];

        }

      }

    }

  }



  return implode(map,"\n");

}



create()

{

  if (!is_clone(this_object()))

     return;

  ::create();

  SetProp(P_SHORT,"Eine Karte von Dhrkion");

  SetProp(P_NAME,"Karte");

  SetProp(P_GENDER,FEMALE);

  AddId(({"karte", "dhrkionkarte", "dhrkionplan","plan","stadtplan" }));

  AddCmd ( ({ "lies","les","lese" }), "lies");

  SetProp(P_WEIGHT,20);

  SetProp(P_VALUE,0);

  SetProp(P_MATERIAL, MAT_PAPYRUS);

}



int lies(string str)

{

  if (!str || str=="" || !id(str)) return 0;

  write(long());

  return 1;

}



try_remove() {

  if (!environment() || !living(environment())) {

    if (environment())

      tell_room(environment(),"Eine Karte loest sich auf.\n");

    remove();

  }

}



move(dest,meth) {

  mixed res;



  while (remove_call_out("try_remove")!=-1) ;

  res=::move(dest,meth);

  if (!environment() || !living(environment()))

    call_out("try_remove",30);

  return res;

}

