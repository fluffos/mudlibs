#include "../def.h"

inherit "/std/container";

#include <properties.h>
#include <language.h>

string *player;
int    loch,ftime,rtime;

void debug(string msg)
{
  object pl;

  if(pl=find_player("ronja"))
    tell_object(pl,"XXX "+msg+" XXX\n\n\n");
}

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein alter Leinensack");
  SetProp(P_LONG,
    "Ein alter Sack, mit dem man die unterschiedlichsten Sachen "
    "transportieren kann. Ein wenig schmutzig ist er schon, so als ob "
    "vor kurzem noch Kartoffeln oder sowas damit transportiert worden "
    "sind."
  );

  AddId( ({"sack", "leinensack"}) );

  SetProp(P_NAME_ADJ, ({"alt"}) );
  AddAdjective( ({"alten","alter","altem","altes","alte"}) );

  SetProp(P_NAME, "Sack");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 150);
  SetProp(P_MAX_WEIGHT, 5000);
  SetProp(P_VALUE, 50);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]) );

  AddDetail( ({"sachen"}) ,
    "In den Sack kann man bestimmt viele Sachen stecken."
  );

  AddDetail( ({"kartoffel","kartoffeln"}) ,
    "Der Sack ist so schmutzig, als waeren vor kurzem noch frisch geerntete "
    "Kartoffeln darin gewesen. "
  );

  AddDetail( ({"schmutz"}) ,
    "Der Schmutz haengt an dem Leinen fest."
  );

  AddDetail( ({"leinen","tuch","tuecher","leinentuch","leinentuecher"}) ,
    "Der Sack besteht aus zwei groben Leinentuechern, welche einfach "
    "zusammengenaeht wurden. Dann hat man den Sack einfach umgestuelpt, "
    "so dass sich die Naehte innen befinden, welche Du von aussen nur "
    "noch fuehlen kannst. "
  );

  AddDetail( ({"naht","naehte"}) ,
    "Die Naehte befinden sich innen im Sack."
  );

  AddSpecialDetail( ({"stelle","loch"}) , "detail_stelle" );

  AddCmd( ({"fuehl","fuehle","erfuehl","erfuehle"})      , "cmd_fuehlen");
  AddCmd( ({"tast","ertast","taste","ertaste"})          , "cmd_ertasten");

  player = ({ });
  ftime  = 3;
  rtime  = 4;
}

void reset()
{
  ::reset();

  player = ({ });
}

void init()
{
  ::init();

  if(ENV(TO) && interactive(ENV(TO))) call_out("raus",ftime+random(rtime));
}

int cmd_fuehlen(string str)
{
  notify_fail("Was moechtest Du erfuehlen?\n");

  if(!str || str == "") return 0;
  if(!(str == "naht"           ||
       str == "naehte"         )) return 0;

  tell_object(TP,"Du kannst die Naehte ganz genau ertasten.\n");
  tell_room(ENV(TP),TP->Name(WER)+" untersucht einen alten Sack ganz genau.\n",
    ({ TP })
  );

  return 1;
}

int cmd_ertasten(string str)
{
  notify_fail("Was moechtest Du ertasten?\n");

  if(!str || str == "") return 0;
  if(!(str == "naht"           ||
       str == "naehte"         )) return 0;

  tell_object(TP,BS("Du tastest die Naehte ganz genau ab. Doch was ist das? "
                    "An einer Stelle fuehlen sich die Naehte aber ganz "
                    "komisch an."));

  tell_room(ENV(TP),TP->Name(WER)+" untersucht einen alten Sack ganz genau.\n",
    ({ TP })
  );

  if(member(player,getuid(TP)) == -1) player += ({ getuid(TP) });
  return 1;
}

string detail_stelle(string str)
{
  string s;

  if(member(player,getuid(TP)) == -1)
  {
    s = "Sowas siehst Du da nicht.";
  }
  else
  {
    s = "An einer Stelle scheinen die Naehte offen zu sein! Na, wenn da man "
        "nicht alles wieder herausfaellt, was Du in den Sack steckst! ";
  }

  return BS(s);
}

int PreventInsert(object ob)
{
  if(TP && interactive(TP) && objectp(ENV(TP)))
  {
    if(find_call_out("raus") == -1) call_out("raus",ftime+random(rtime));
  }
  return 0;
}

void raus()
{
  if(sizeof(all_inventory(TO)) == 0) return;
  if(ENV(TO) && interactive(ENV(TO)) && ENV(ENV(TO)))
  {
//  debug(sprintf("%O",all_inventory()));
    all_inventory()[0]->move(ENV(ENV(TO)),M_NOCHECK|M_SILENT);
    call_out("raus",ftime+random(rtime));
  }
}


