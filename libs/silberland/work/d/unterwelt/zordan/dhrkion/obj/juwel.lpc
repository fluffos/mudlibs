#include "../def.h"

inherit "std/thing";

string owner;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein winziges Juwel");
  SetProp(P_LONG,
    "Ein so winziges Juwel hast Du noch nie zuvor gesehen. Du bist kaum "
    "in der Lage, ueberhaupt irgendwelche Facetten zu erkennen. Leicht gruen "
    "erscheint Dir seine Oberflaeche, obwohl auch manchmal ein wenig rot "
    "hervorzustechen scheint. Einen grossen Wert hat das Juwel auf den "
    "ersten Blick sicher nicht. Aber als Sammlerobjekt ist es sicher "
    "unbezahlbar!"
  );

  SetProp(P_INFO, "Dieses Juwel scheint das private Sammlerstueck "
                  "von einer Frau zu sein.");

  SetProp(P_NAME, "Juwel");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "juwel", QUESTJUWELID, "NODESTRUCT", "QUESTOBJ" }) );

  SetProp(P_NAME_ADJ, ({"winzig"}) );
  AddAdjective( ({"winzigen","winziger","winzigem","winziges","winzige"}) );

  SetProp(P_MATERIAL, ([MAT_MISC_JEWEL:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);

  owner = "";
}

void SetOwner(string uuid)
{
  if(owner == "") owner = uuid;
}

string QueryOwner()
{
  return owner;
}

void init()
{
  ::init();

  if(!TP)                  return;
  if(!interactive(TP))     return;
  if(owner != getuuid(TP)) return;

  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);

}
