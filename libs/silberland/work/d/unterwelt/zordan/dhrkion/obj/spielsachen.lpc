
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein wenig Spielzeug");
  SetProp(P_LONG,
    "Weiss der Teufel, wie Du an das Spielzeug gekommen bist. Jedenfalls "
    "sind die Spielsachen von Dunkelelfenkindern und Du kannst wirklich "
    "nichts damit anfangen." );
  SetProp(P_NAME, "Spielzeug");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"spielzeug","zeug"}) );

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10+random(10));
  SetProp(P_NOBUY, 1);
}
