
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Anzeigetafel haengt an der Wand");
  SetProp(P_LONG,
    "Eine grosse Anzeigetafel ist an der Wand befestigt worden. Auf ihr "
    "stehen ein paar Namen. Du kannst Sie lesen." );
  SetProp(P_NAME, "Anzeigetafel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"tafel","anzeigetafel"}) );

  SetProp(P_MATERIAL, MAT_MISC_WOOD);
  SetProp(P_WEIGHT, 50000); 
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_AUTOLOADOBJ, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NOGET, "Die Anzeigetafel ist mit der Wand verbunden.\n");
  AddReadDetail( ({ "tafel","anzeigetafel" }) , "@@tafelfkt@@");
}  

string tafelfkt() {
  string out;
  int i;
  out="Du liest die Anzeigetafel:\n";

  if(present(QUESTRUNE,TP)) {
    out += "\nNanu, hinter Tafel scheint irgendwas zu sein.\n";
  }

  out+="\n******************************************************************************\n"
  +"*\n"
  +"*                              BEKANNTMACHUNG:\n"
  +"*\n"
  +"*  Ihre Hoheit die Koenigin gibt bekannt, dass folgende Personen zur Zeit\n"
  +"*  Feinde von Dhrkion sind und  das jeder Bewohner angehalten ist,  diese\n"
  +"*  Personen zu verfolgen und zu toeten:\n"
  +"*\n"
  +break_string(DHRKIONMASTER->getfeinde(),74,"*  ")
  +"*\n"
  +"*  Aufgrund viel  zu haeufiger  Uebergriffe werden  folgende Personen auf\n"
  +"*  unbeschraenkte Zeit zum Inhumieren freigegeben:\n"
  +"*\n"
  +DHRKIONMASTER->getpermfeinde()
  +"*\n"
  +"******************************************************************************\n";

  say(TPN+" liest die Anzeigetafel.\n" );
  TP->More(out);

  return "";
}
