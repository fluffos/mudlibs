
/*
    Eine verwesende Leiche in der Unterwelt, um Stimming zu machen ;)
    Zordan@SL

    Eros: 02.09.2021
    Id NOT_LIVING, NOCONTROL eingefuegt -> Konflikt mit Kontrolliere Spell
*/

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO))  return;
  ::create();

  SetProp(P_SHORT, "Eine verwesende Leiche");
  SetProp(P_LONG,
    "Eine stark verweste Leiche liegt hier auf dem Boden. Bei dem Anblick "
    "der Knochen und der halb verwesten Koerperteilen wird Dir fast schlecht. "
    "Die ehemaligen Arme und Beine verschimmeln langsam, aber stetig. Die "
    "Leiche verbreitet einen wirklich unangenehmen Geruch." );
  SetProp(P_NAME, "verwesende Leiche");
  SetProp(P_GENDER, FEMALE);

  AddId( ({"leiche", "NOT_LIVING", "NOCONTROL"}) );

 AddDetail( "knochen", 
   "Die Knochen liegen wohl schon laenger hier. An vielen Stellen haengen aber "
   "noch verwesende Koerperteile dran." );

 AddDetail( ({"arme","beine","arm","bein" }), 
   "Sie sind schon recht verschimmelt." );

  SetProp(P_MATERIAL, MAT_FLESH );
  SetProp(P_WEIGHT, 50000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOGET, "Was willst Du mit einer Leiche ? Schaenden ?\n");
}
