#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein schoener Edelstein");
  SetProp(P_LONG,
    "Ein besonders grosser und huebscher Edelstein befindet sich "
    "zwischen Deinen Besitztuemern. Er ist sicher viel zu schade zum "
    "Verkaufen."
  );

  SetProp(P_NAME, "Edelstein");
  SetProp(P_GENDER, MALE);
  AddId( ({ "edelstein","\n_runenquest_edelstein"
          , "QUESTOBJ", "NODESTUCT" }) );

  SetProp(P_NAME_ADJ, ({"schoen"}) );
  AddAdjective( ({"schoenen","schoener","schoenem","schoenes","schoene"}) );

  SetProp(P_MATERIAL, ([MAT_MISC_JEWEL:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}
