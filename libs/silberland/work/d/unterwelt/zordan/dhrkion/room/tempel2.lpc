#include "../def.h"

inherit "std/room";

string *foundby;

void create()
{
  ::create();

  foundby = ({ });

  SetProp( P_INT_SHORT, "Ein sehr heiliger Ort" );
  SetProp( P_INT_LONG,
    "Dunkelheit."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_NOQUIT, 1);
  SetProp(P_NO_TPORT, NO_TPORT_OUT + NO_TPORT_IN);

  SetProp(P_HIDE_EXITS, 1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    "der wind Pfeift Um Diesen raum Und Verursacht So Einen Leisen "
    "pfeifton. ansonsten Ist Es Hier Eigentlich Mehr Oder Weniger Sehr "
    "Ruhig."
  );

  AddSound( ({"wind"}),
    "sehr Leise Weht Der wind Um Den raum Herum Und Dadurch Entsteht Ein "
    "pfeifton."
  );

  AddSound( ({"pfeifton"}),
    "der pfeifton Ist In Seiner stimmlage Ziemlich Hoch."
  );

  AddSound( ({"pfeifen"}),
    "das pfeifen Entsteht Nicht In Diesem raum Und Ist Darum So Leise."
  );

  AddSound( ({"boden"}),
    "auf Dem boden Laufen Wohl Ein Paar Kleine tiere. du Hoerst Das "
    "trippeln Der tiere."
  );

  AddSound( ({ "trippeln","tiere" }) ,
    "es Sind Wohl Sehr Kleine tiere, Denn Das trippeln Ist Sehr Sehr Leise "
    "Und Auch Sehr Sehr Schnell."
  );

  AddSound( ({"decke"}) ,
    "von Der decke Her Pfeift Es."
  );

  AddSound( ({ "wand","waende" }) ,
    "draussen Wehr Ein Starker wind. an Den waenden Bricht Er Sich Und "
    "Ein Leises pfeifen Entsteht Dadurch."
  );

  AddSmell( DEFAULT_SMELL,
    "die luft Riecht Ein Wenig Staubig Und Abgestanden. leichter moder Kommt "
    "Aus Einer dir Nicht Feststellbaren richtung. manchmal Zieht An dir Auch "
    "Der hauch Von raeucherstaebchen vorbei."
  );

  AddSmell( ({"luft"}),
    "die luft Riecht Abgestanden Und Staubig."
  );

  AddSmell( ({"staub"}),
    "der staub Riecht Ziemlich Schlecht. der gestank Scheint Besonders Aus "
    "Dem norden Zu Kommen."
  );

  AddSmell( ({"norden"}),
    "so Sehr Nach staub Kann Eigentlich Nur Ein Sehr Altes buch Riechen."
  );

  AddSmell( ({"gestank"}),
    "der gestank Ist Kaum Auszuhalten."
  );

  AddSmell( ({"buch"}),
    "das buch Riecht Wirklich Nach Sehr Altem staub. ob Man Damit Etwas "
    "Machen Kann?"
  );

  AddSmell( ({"moder"}),
    "iiiihhh, Der moder Stinkt Bestialisch."
  );

  AddSmell( ({"richtung"}),
    "du Kannst Hier Keine richtungen Ausmachen."
  );

  AddSmell( ({"hauch","rauch" }),
    "es Ist Nur Sehr Wenig, Was deine nase Erreicht."
  );

  AddSmell(({ "raeucherstaebchen","staebchen"}) ,
    "sie Riechen Leicht Suess. sie Muessen Wohl In Unmittelbarer naehe "
    "stehen. aber Sehen Kannst du Sie Nicht. komisch Eigentlich."
  );

  AddSmell( ({"naehe"}),
    "hmmm, Ganz Nah Sind Eigentlich Nur Die raeucherstaebchen Zu Riechen."
  );

  AddSmell( ({"boden"}),
    "der boden Riecht Staubig."
  );

  AddSmell( ({"decke"}),
    "die decke Ist Wohl Zu Weit Oben. jedenfalls Kannst du Nichts Spezielles "
    "Von Der decke Riechen."
  );

  AddSmell( ({"wand","waende" }),
    "von Dort Kommt Nichts Besonderes."
  );

  AddCmd( ({ "lies","lese","les" }), "cmd_lesen" );
  AddCmd( ({ "sag","sage" }), "cmd_sagen" );
  AddCmd( ({ "taste","ertaste" }), "cmd_ertasten" );
  AddCmd( ({ "unt","untersuch","untersuche","schau","schaue",
             "betracht","betrachte" }), "cmd_untersuchen" );

  AddSpecialExit( "unten", "exit_unten" );
}

void init()
{
  ::init();

  if(TP && interactive(TP)) call_out("greet",4, TP);
}

void reset()
{
  ::reset();

  foundby = ({ });
}

void QuestLog(string s)
{
  write_file("/log/quests/runen", dtime(time())+": "+s+"\n");
}

int exit_unten(string str)
{
  if(RUNENMASTER->IsQuester(getuuid(TP)))
  {
    tell_object(TP, BS("etwas In dir Haelt dich Davon Ab Nach Unten Zu "
                       "Gehen. du Bist dir Sicher, Dass du deine aufgabe "
                       "Hier Oben Erst Erfuellen Musst, Bevor du Wieder "
                       "Nach Unten Gehen Kannst." ));
    return 1;
  }

  tell_object(TP,BS("vorsichtig Ertastest du Die treppe Und Gehst Wieder "
                    "Nach Unten." ));

  TP->move(ROOM "tempel",M_GO,0,
    "Geht Die treppe Runter",
    "kommt die Trepper herunter"
  );

  return 1;
}

void greet(object player)
{
  if(ENV(player) == TO)
  {
    tell_object(player, BS("du Bist dir Nicht Sicher Wo du Gelandet Bist. "
                           "es Muss Wohl Aber Ein Sehr Boesartiger Und "
                           "Heiliger ort Sein. es Ist Hier So Finster, Dass "
                           "du Nicht Einmal Die Eigene hand Vor augen Sehen "
                           "kannst. du Fuehlst dich Wie In Eine Andere "
                           "welt Versetzt. sehen Kannst du Hier Absolut "
                           "Nichts. du Musst dir Schon Etwas Einfallen "
                           "Lassen." ));
  }
}

int cmd_ertasten(string str)
{
  notify_fail("was Willst du Ertasten?\n");

  if(!str || str == "") return 0;
  if((str == "buch"      ||
      str == "runen"     ||
      str == "runenbuch" ))
  {
    if(!RUNENMASTER->IsQuester(getuuid(TP))) return 0;

    tell_object(TP, BS("du Kannst Tatsaechlich Ein Kleines runenbuch "
                       "Ertasten. vielleicht Kann Man Es Ja Lesen?" ));

    if(member(foundby,getuuid(TP)) == -1) foundby += ({ getuuid(TP) });

    return 1;
  }

  if(str == "tiere" || str == "tier" )
  {
    tell_object(TP, BS("die Kleinen tiere Sind Eigentlich Sehr Weich Und "
                       "Haben Sogar Ein fell. aber Genau Zuordnen Kannst "
                       "du Sie Nicht. du Bist Schon Froh, Dass dich Keines "
                       "Der tiere Gebissen Hat."));

    return 1;
  }

  if(str == "raeucherstaebchen")
  {
   tell_object(TP, BS("du Tastest Um dich Rum. aber Irgendwie Kannst du "
                      "Die raeucherstaebchen Nicht Erreichen." ));

    return 1;
  }

  if(str == "decke")
  {
    tell_object(TP, "die decke Ist Zu Weit Oben.\n" );
    return 1;
  }

  if(str == "wand" || str == "waende" )
  {
    tell_object(TP, BS("du Scheinst Mitten Im raum Zu Stehen. jedenfalls "
                       "Kannst du Die waende Nicht Erreichen." ));

    return 1;
  }

  if(str == "boden")
  {
    tell_object(TP, BS("du Kannst Die treppe Nach Unten Erstaunlicherweise "
                       "Nicht Ertasten." ));

    return 1;
  }

  if(str == "staub")
  {
    tell_object(TP, "der staub Fuehlt Sich Ein Wenig Glitschig An.\n" );
    return 1;
  }

  return 0;
}

int cmd_lesen(string str)
{
  string s;

  if(!RUNENMASTER->IsQuester(getuuid(TP))) return 0;

  if(member(foundby,getuuid(TP)) == -1)
  {
    tell_object(TP, "welches buch Denn?\n");
    return 1;
  }

  if(str != "runenbuch" && str != "buch" && str != "runen")
  {
    tell_object(TP, "sowas Hast du Noch Nicht Gefunden!\n");
    return 1;
  }

  tell_object(TP, BS("es Ist Viel Zu Dunkel Um Das runenbuch Zu Lesen. "
                     "aber du Kannst Darauf Ein Paar runen Fuehlen:" ));

  s = RUNENMASTER->QuerySorceress(getuuid(TP));
  s = RUNENMASTER->Translate(getuuid(TP), s);

  tell_object(TP, s+"\n\n");

  tell_object(TP, BS("es Scheint So, Als Ob Das Wort Der name Einer frau "
                     "Ist. wenn du Es Hast, Solltest du Es Einfach Nur "
                     "Sagen." ));

  return 1;
}

int cmd_sagen(string was)
{
  int ret;
  string uid;

  if(!RUNENMASTER->IsQuester(getuuid(TP)))            return 0;
  if(RUNENMASTER->QuerySorceress(getuuid(TP)) != was) return 0;

  tell_object(TP, BS("du Sprichst Den runenzauber Aus Und Auf Einmal "
                     "Beginnt Der Ganze raum Zu Beben. quietschen Und "
                     "knarren Kannst du Aus Jeder ecke Hoeren. ein "
                     "Rotes Licht Schwebt Aus Dem nichts Auf dich Zu Und "
                     "Huellt dich Ein. dein koerper Scheint Sich "
                     "Aufzuloesen Und Nach draussen Zu Schweben. "
                     "unter dir Siehst du Nacheinander Alle bloecke Und "
                     "Wie Eine Schwarze masse Den marktplatz verdunkelt. "
                     "nach deiner reise Kehrst du In Den Dunklen raum "
                     "zurueck. du Entschliesst dich Den Dunklen raum Sofort "
                     "Zu Verlassen, Da du deine aufgabe Erfuellt Hast." ));

  uid = CAP(getuid(TP));
  ret = TP->GiveQuest(QUESTNAME);

  switch(ret)
  {
    case 1:
      RUNENMASTER->Msg(uid + " loest die Quest");
      QuestLog(uid + " loest die Quest.\n" );
      RUNENMASTER->DeleteQuester(getuuid(TP));
      break;

    case -1:
      RUNENMASTER->Msg(uid + " loest die Quest wiederholt");
      QuestLog(uid + " loest die Quest zum wiederholten Mal.");
      RUNENMASTER->DeleteQuester(getuuid(TP));
      break;

    case -2:
      RUNENMASTER->Msg(uid + " loest die noch nicht eingetragene Quest");
      QuestLog(uid + " loest die nicht eingetragene Quest");
      tell_room(TO, "Die Quest ist noch nicht eingetragen.\n");
      RUNENMASTER->DeleteQuester(getuuid(TP));
      break;

    case -3:
      RUNENMASTER->Msg(uid + " loest die Quest, aber unbefugter Zugriff");
      QuestLog(uid + " loest die Quest, Fehler unbefugter Zugriff.");
      tell_room(TO, "Unbefugter Zugriff.\n");
      RUNENMASTER->DeleteQuester(getuuid(TP));
      break;

    case -4:
      RUNENMASTER->Msg(uid + " loest die nicht aktive Quest");
      QuestLog(uid+" loest die nicht aktive Quest");
      tell_room(TO, "Die Quest ist derzeit deaktiviert.\n");
      RUNENMASTER->DeleteQuester(getuuid(TP));
      break;

    default:
      RUNENMASTER->Msg(sprintf("%s loest die Quest mit Fehler %d", uid, ret));
      QuestLog(sprintf("%s loest die Quest mit Fehler %d", uid, ret));
      tell_room(TO, sprintf("Unbekannter Fehler bei der Questvergabe: %d\n",ret));
//    Questdaten bleiben im Master erhalten...
      break;
  }

  ROOM "weg-e4"->Darken();
  ROOM "weg-e6"->Darken();
  ROOM "weg-d5"->Darken();
  ROOM "weg-f5"->Darken();

  TP->move( ROOM "tempel", M_GO, 0,
    "Geht Die treppe Runter",
    "kommt die Trepper herunter" );

  if(present("\npriesterin", ENV(TP)))
  {
    tell_object(TP, BSI("Vielen, vielen Dank, "+CAP_TPN+". Du hast es "
                        "geschafft und die Aufgabe fuer mich erledigt. "
                        "Ganz Dhrkion wird fuer immer in Deiner Schuld "
                        "stehen.", "Die Priesterin sagt: "));
  }

  return 1;
}

varargs string GetDetail(mixed key, mixed race)
{
  if(TP->QueryProp(P_RACE) == "Dunkelelf")
  {
    return "Selbst Deine Augen koennen in dieser boesartigen Dunkelheit "
           "nichts erkennen.\n";
  }

  return "Es ist zu dunkel!\n";
}

int cmd_untersuchen(string str)
{
  if(TP->QueryProp(P_RACE) == "Dunkelelf")
  {
    tell_object(TP, "Selbst Deine Augen koennen in dieser boesartigen "
                    "Dunkelheit nichts erkennen.\n");

    return 1;
  }

  write("Es ist zu dunkel!\n");

  return 1;
}

