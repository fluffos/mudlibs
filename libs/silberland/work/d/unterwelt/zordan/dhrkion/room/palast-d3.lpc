/*
   Dhrkion, die Dunkelelfenstadt - Zordan@SL
*/

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create() {
  ::create();
  SetProp( P_INT_SHORT, "Wachbereich eines Palastes" );
  SetProp( P_INT_LONG,
    "Vor dem eigentlichen Thronsaal wurde dieser Wachbereich eingerichtet. "
    "Wachen gehen hier auf und ab und passen sehr aufmerksam auf. Nur durch "
    "ein Loch im Nordosten kannst Du den Thronsaal erreichen. Ungebetene "
    "Gaeste werden wohl einfach vor Ort und Stelle erledigt, was man an "
    "den ueberall verteilten Leichen erkennen kann." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 19, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "blut","blutspritzer","spritzer" }),
    "Die muessen wohl noch von der letzten Leiche stammen. Es sieht ziemlich "
    "unappetietlich aus.");

  AddDetail( ({ "decke" }),
    "An der Decke sind noch ein paar Blutspritzer zu erkennen.");

  AddDetail( ({ "waende","wand","felswaende","felswand" }),
    "Einfache Felswaende sind es. In einer Wand ist ein Loch.");

  AddDetail( ({ "ort","stelle" }),
    "Naja, sie werden hier getoetet und nicht erst weggebracht. Manchmal "
    "soll die Koenigin sogar selber mit in den Kampf eingreifen.");

  AddDetail( ({ "kampf" }),
    "Das kann nur bedeuten, dass die Koenigin selber nicht  zu schwach sein "
    "kann. Also sei gewarnt!");

  AddDetail( ({ "sinn" }),
    "Was hast Du denn im Sinn?");

  AddDetail( ({ "gaeste","gast" }),
    "Gaeste die nichts boeses vorhaben, sind sicher herzlich willkommen. "
    "Wenn sie aber was boeses im Sinn haben, werden sie einfach getoetet "
    "und die Leichen so liegen gelassen.");

  AddDetail( ({ "wachen","wache" }),
    "Die Wachen gehen hier auf und ab und passen auf die Koenigin auf. "
    "Sie sind sicher sehr stark. Was Dir auffaellt ist, dass immer eine "
    "weibliche Wache mit dabei ist. Die weiblichen Wachen sind wohl auch "
    "um einiges gefaehrlicher als die maennlichen Wachen.");

  AddDetail( ({ "thronsaal","saal" }),
    "Du kannst den Thronsaal durch das Loch erreichen. Sehen kannst Du ihn "
    "aber noch nicht.");

  AddDetail( ({ "wachbereich","bereich" }),
    "Hier werden die Feinde der Koenigin abgefangen und erledigt. Ein paar "
    "Verrueckte haben es wohl auch schon versucht. Deren Leichen sieht "
    "man jetzt ueberall auf dem Boden liegen.");

  AddDetail( ({ "leichen","leiche" }),
    "Frische und alte Leichen liegen hier auf dem Boden verteilt herum. "
    "Sie verbreiten einen nicht so schoenen Geruch und aussehen tut es "
    "auch nicht besonders.");

  AddDetail( ({ "geruch" }),
    "Der stammt wohl von den verwesenden Leichen.");

  AddDetail( ({ "boden" }),
    "Der Boden ist aus einfachem Fels und es liegen viele Leichen einfach "
    "so herum.");

  AddDetail( ({ "feinde","feind" }),
    "Normalerweise hat die Koenigin keine Feinde. Aber man weiss ja nie, "
    "was Verrueckte immer so vorhaben.");

  AddDetail( ({ "koenigin" }),
    "Die Koenigin ist sicher im Thronsaal.");

  AddDetail( ({ "verrueckte","wesen" }),
    "Das sind doch glatt nicht so intelligente Wesen, die der Koenigin "
    "an den Leib wollen.");

  AddDetail( ({ "leib" }),
    "Na die wollen sie umlegen, jetzt alles klar?");

  AddDetail( ({ "loch" }),
    "Ein nicht zu kleines Loch in der Wand fuehrt in den Thronsaal.");

  AddDetail( ({ "ohr" }),
    "Es scheint noch da zu sein.");

  AddSound( ({ DEFAULT_SOUND }),
    "Nicht ein Laut dringt an Dein Ohr.");
    
  AddSound( ({ "laut" }),
    "Naja gut, ein paar leise Stimmen sind schon zu hoeren.");
    
  AddSound( ({ "stimmen" }),
    "Was sie sagen kannst Du nun wirklich nicht hoeren.");
    
  AddSmell( ({ DEFAULT_SMELL }),
    "Es riecht nach verwesenden Leichen.");

  AddSmell( ({ "leichen","leiche","geruch" }),
    "Buah, stinken die Leichen erbaermlich.");

  AddItem( NPC "palastwache", REFRESH_DESTRUCT);
  AddItem( NPC "palastwache", REFRESH_DESTRUCT);

  AddExit( "osten",      "./palast-e3" );
  AddSpecialExit( "nordosten",  "exitfkt" );

}

int exitfkt(string str) {
  if (present("\npalastwache")) {
    if(DHRKIONMASTER->checkfeind(TP)) {
      write("Die Palastwache hindert Dich daran!\n");
      return 1;
    }
  }
//  TP->move(ROOM "palast-e2", M_GO, "nach Nordwesten");
  TP->move( "/gilden/dunkelelfen", M_GO, "nach Nordosten");
  return 1;
}
