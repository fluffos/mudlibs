#include "../def.h"

inherit ROOM "inh-wegblock";

void create()
{
  ::create();

  thisroom = 0;

  SetProp( P_INT_SHORT, "Marktplatz von Dhrkion" );
  SetProp( P_INT_LONG,
    "Nur wenige Dunkelelfen ueberqueren in komischer Eile den "
    "noerdlichsten Teil des Marktplatzes. Kaum ein Blick trifft Dich von "
    "denen. Im Norden kannst Du einen prunktvollen Eingang erkennen. Im "
    "Sueden baut sich der riesige Tempel majaestetisch auf. Auch hier "
    "steht ein kleiner Steinblock auf dem Boden."
  );

  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1);
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "tempel" }),
    "Der Tempel im Sueden geht bis in die Dunkelheit hinauf zur Decke. "
    "Doch hier ist es seltsamerweise hell. Warum kannst Du Dir echt nicht "
    "erklaeren.");

  AddDetail( ({ "dunkelheit" }),
    "Normalerweise ist es ueberall in Dhrkion dunkel. Nur auf dem Marktplatz "
    "scheint ein Licht zu scheinen.");

  AddDetail( ({ "licht" }),
    "Das Licht kommt tatsaechlich aus dem Tempel und ueberstrahlt den "
    "Marktplatz. Augenblick mal, das ist ja Sonnenlicht!");

  AddDetail( ({ "stelle" }),
    "Du kannst eine Rune an einer Stelle einfuegen. Aber keine Stelle "
    "faellt Dir besonders auf.");

  AddDetail( ({ "sonnenlicht" }),
    "Das haut Dich jetzt tatsaechlich um. Aus dem Tempel scheint ein wenig "
    "Sonnenlicht und erhellt den Marktplatz.");

  AddDetail( ({ "steinblock","block" }),
    "Der Steinblock ist fast drei mal so hoch wie Du und komplett aus Stein. "
    "Er ist ein wenig angeschraegt und zeigt Richtung Tempel. "
    "Du kannst zuerst nicht so richtig erkennen, was daran so besonders sein "
    "soll. Erst bei einer genaueren Untersuchung faellt Dir was auf.");

  AddDetail( ({ "richtung","spitze" }),
    "Der Steinblock steht ein wenig schraeg, so dass seine Spitze direkt "
    "auf den Tempel zeigt.");

  AddDetail( ({ "untersuchung" }),
    "Auf der Oberseite des Steinblockes scheint etwas zu sein.");

  AddDetail( ({ "kopf" }),
    "Du bist der Meinung der ist noch da, wo er hingehoert.");

  AddDetail( ({ "meinung" }),
    "Oder hast Du keine?");

  AddDetail( ({ "stein","fels" }),
    "Eben kein Fels, sondern einfacher Stein.");

  AddDetail( ({ "blick" }),
    "Man meidet es hier auffaellig, sich gegenseitig ins Gesicht zu sehen.");

  AddDetail( ({ "gesicht" }),
    "Du versuchst eines genauer zu sehen. Aber es gelingt Dir wirklich nicht.");

  AddDetail( ({ "eingang" }),
    "Der Eingang ist ein wenig verziert und er fuehrt direkt in ein "
    "gigantisches Bauwerk, das fast den Tempel uebertrifft. Aber nur fast.");

  AddDetail( ({ "decke","hoehle" }),
    "Du kannst die Decke der Hoehle nicht erkennen.");

  AddDetail( ({ "waende","wand" }),
    "Hier sind keine Waende zu sehen.");

  AddDetail( ({ "boden" }),
    "Ganz normaler Boden aus Felsplatten.");

  AddDetail( ({ "felsplatten","platten" }),
    "Auf einer der Platten steht ein recht grosser Steinblock.");

  AddDetail( ({ "dunkelelfen" }),
    "Nur sehr wenige Dunkelelfen ueberqueren diesen Teil des Marktplatzes. "
    "Warum wird Dir eigentlich gar nicht so richtig klar. Fuer Dich sieht "
    "es hier genauso aus wie ueberall hier.");

  AddDetail( ({ "eile" }),
    "Naja, sie rennen zwar nicht, aber ihre Schritte sind groesser und "
    "schneller als normalerweise.");

  AddDetail( ({ "schritte","schritte" }),
    "Die grossen Dunkelelfen machen schon grosse Schritte. Doch hier machen "
    "sie halt noch groessere Schritte.");

  AddDetail( ({ "marktplatz" }),
    "Der Marktplatz ist schon ein wenig groesser. Mitten auf dem Marktplatz "
    "befindet sich der heilige Tempel der Dunkelelfen. Du stehst im "
    "noerdlichen Teil des Marktplatzes und kannst den Tempel im Sueden sehen. "
    "Im Norden scheint es in ein fast genauso wichtiges Bauwerk zu gehen.");

  AddDetail( ({ "bauwerk" }),
    "Du bist Dir nicht sicher. Aber dort koennte der Herrscher von Dhrkion "
    "in einem Palast leben.");

  AddDetail( ({ "dhrkion","stadt" }),
    "Du stehst auf dem Marktplatz von Dhrkion.");

  AddDetail( ({ "herrscher","herrscherin" }),
    "Es koennte natuerlich auch eine Herrscherin sein. Hm.");

  AddDetail( ({ "palast" }),
    "Richtig. Jetzt erkennst Du, dass das Bauwerk ein Palast ist. Vielleicht "
    "ist das der Grund, warum die Dunkelelfen sich nicht gerne hier aufhalten?");

  AddDetail( ({ "grund" }),
    "Naja, fragen kannst Du keinen. Niemand antwortet Dir hier.");

  AddDetail( ({ "teil" }),
    "Dieses ist der noerdliche Teil des Marktplatzes.");

  AddDetail( ({ "wind" }),
    "Leider fliegt nichts herum, deshalb kannst Du den Wind nicht sehen. "
    "Vielleicht ein wenig spueren oder hoeren.");

  AddDetail( ({ "nase" }),
    "Puh, sie ist noch da wo sie hingehoert.");

  AddSound( DEFAULT_SOUND,
    "Gespenstisch ruhig ist es in diesem Teil des Marktplatzes. Du kannst "
    "fast nichts hoeren. Nur der kaum vorhandene Wind verursacht ein "
    "leises Pfeifen.");

  AddSound( ({ "wind","pfeifen" }),
    "Nur die sanfte Bewegung von Luft, auch Wind genannt, verursacht hier "
    "ein sehr leises Pfeifen. Es scheint aber irgendwie unterdrueckt zu werden. "
    "Deshalb ist es auch kaum zu hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Unheimlich geruchslos ist es hier. Du haeltst Deine Nase nochmal "
    "richtig in die Hoehe. Doch nichts. Gar nichts. Sehr seltsam.");

  AddSpecialDetail("oberseite","detail_oberseite" );

  AddItem(NPC "sklave2", REFRESH_DESTRUCT);

  AddExit("norden",     ROOM "palast-e3" );
  AddExit("suedwesten", ROOM "weg-d5" );
  AddExit("suedosten",  ROOM "weg-f5" );
}

string detail_oberseite(string str)
{
  string s;

  if((s = DisplayRunes(TP)) == "")
  {
    s = BS("Du reckst Deinen Kopf so hoch Du kannst und springst sogar "
           "hoch um zu sehen, was auf der Oberseite zu sein scheint. Aber "
           "es gelingt Dir einfach nicht, mehr zu sehen. Enttaeuscht "
           "gibst Du auf.");
  }

  return s;
}

