/*

  Inherit fuer die Mooshoehlen der Rothe der Dunkelelfenstadt - Dhrkion Zordan@SL

*/

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

int tropfen;

reset() {
  ::reset();
  tropfen=1;
}

create() {
  ::create();
  tropfen=1;
  SetProp( P_INT_SHORT, "In einer Mooshoehle" );
  SetProp( P_LIGHT,   0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 20+random(5), ENV_TERRAIN: TT_CAVE]) );

  SetProp(P_INT_LONG,
    "Diese kleine, feuchte Hoehle ist der geeignete Platz um Rothe zu zuechten. "
    "Durch die hohe Feuchtigkeit hat sich viel Moos auf dem Gestein angereichert "
    "und viele Pilze wachsen auf dem Boden. Spuren sind hier ueberall zu sehen." );

  AddDetail( ({ "decke" }),
    "Die wirklich niedrige Decke ist mit Abertausenden von Tropfen uebersaeht.");

  AddDetail( ({ "feuchtigkeit" }),
    "Die Feuchtigkeit in dieser Hoehle ist wirklich kaum noch zu ueberbieten. "
    "Du hast schon Probleme beim Atmen.");

  AddDetail( ({ "probleme" }),
    "Und das sind nicht Deine einzigen Probleme...");

  AddDetail( ({ "atmen" }),
    "Das Atmen faellt Dir sehr schwer.");

  AddDetail( ({ "wand","waende" }),
    "Die Wand besteht aus Gestein. Auch an ihr waechst viel Moos. Bis zu einer "
    "gewissen Hoehe ist es auch schon angeknabbert worden.");

  AddDetail( ({ "hoehe" }),
    "Weiter hoch kommen die Rothe wohl nicht. Das ist auch ganz gut so. Denn "
    "dann kann sich das Moos immer von oben her ausbreiten.");

  AddDetail( ({ "spuren","spur","abdruecke" }),
    "Seltsam. Das sind nicht nur Hufabdruecke, sondern auch Abdruecke von "
    "anderen Rassen.");

  AddDetail( ({ "rassen" }),
    "Goblins, Orks, Elfen, Menschen ... uswusf. Aber seltsamerweise keine "
    "von Dunkelelfen.");

  AddDetail( ({ "hufabdruecke" }),
    "Die stammen sicherlich von den Rothe.");

  AddDetail( ({ "boden" }),
    "Auf dem dunklen Boden wachsen viele Pilze. Ausserdem kannst Du ein "
    "paar Spuren erkennen.");

  AddDetail( ({ "gestein" }),
    "Das dunkle Gestein ist ueber und ueber mit Moos bedeckt.");

  AddDetail( ({ "pilz","pilze" }),
    "Viele Pilze wachsen hier auf dem Boden. Sie sind in fast jeder Farbe "
    "und Form vorhanden. Du laesst aber lieber die Finger davon, denn Du weisst "
    "einfach nicht, welche davon giftig sind.");

  AddDetail( ({ "finger" }),
    "Ja, Deine Finger sind noch dran. Wer weiss wie lange noch.");

  AddDetail( ({ "farbe" }),
    "Du faengst nicht an sie zu zaehlen.");

  AddDetail( ({ "formen","form" }),
    "Die interessieren Dich einfach nicht.");

  AddDetail( ({ "hoehle" }),
    "Diese Hoehle ist natuerlichen Ursprungs. Sie ist sehr feucht und bietet "
    "mit seinem ganzen Moos und Pilzen den Rothe sehr viel zu essen.");

  AddDetail( ({ "ursprung","laufe","jahre" }),
    "Die Hoehle ist wirklich einfach so entstanden. Wahrscheinlich hat das "
    "Wasser im Laufe der Jahre diese Hoehle ausgeschwemmt.");

  AddDetail( ({ "platz" }),
    "Dieser Platz ist gigantisch gut dafuer geeignet. Kein Wunder, dass die "
    "Dunkelelfen diesen Platz auch dafuer benutzen.");

  AddDetail( ({ "wunder" }),
    "Nein, das ist wirklich kein Wunder.");

  AddDetail( ({ "dunkelelfen","dhrkion" }),
    "Die Dunkelelfen leben in Dhrkion. Das liegt nordwestlich von Dir.");

  AddDetail( ({ "moos" }),
    "Das saftig gruene Moos ist das geeignete Futter fuer Rothe.");

  AddDetail( ({ "futter" }),
    "Man braucht sich nicht weiter um Futter zu kuemmern. In dieser Hoehle "
    "waechst das Moos und die Pilze durch die hohe Feuchtigkeit schnell nach.");

  AddDetail( ({ "rothe" }),
    "Im Moment ist wohl kein Rothe da.");

  AddDetail( ({ "moment" }),
    "Aber die Dunkelelfen werden schon fuer neue sorgen.");

  AddDetail( ({ "geraeusche" }),
    "Die kann man doch nicht sehen.");

  AddDetail( ({ "gras" }),
    "Es riecht nur so, es ist aber keines da.");

  AddDetail( ({ "wasser" }),
    "Durch die hohe Feuchtigkeit sammelt sich Wasser an der Decke an. Wenn "
    "die Tropfen gross genug geworden sind, fallen sie auf den Boden. Das "
    "macht lustige Geraeusche.");

  AddDetail( ({ "groesse" }),
    "Von ganz klein bis fast gross genug zum runterfallen.");

  AddSmell( ({ DEFAULT_SMELL }),
    "Es riecht nach frischen Moos." );

  AddSmell( ({ "moos" }),
    "Fuer Rothe riecht das Moos wohl wie eine Delikatesse. Fuer Dich aber "
    "eher nach ein wenig vergammeltem Gras." );

  AddSound( ({ DEFAULT_SOUND }),
    "Wasser platscht von der Decke herunter." );

  AddSound( ({ "wasser","geraeusche","geraeusch" }),
    "*plitsch* *platsch* *tropf*" );

  AddSpecialDetail( "tropfen" , "tropfenfkt" );
  AddCmd( ({ "schrei","schreie" }) ,"schreifkt" );
  
}

string tropfenfkt(string str) {
  if (tropfen) return BS(
      "Abertausende Tropfen jeder Groesse haengen an der Decke. Fang hier bloss "
      "nicht laut an zu schreien. Du koenntest dadurch plitschnass werden.");
  return BS(
    "Seltsamerweise haengen hier nicht mehr viele Tropfen an der Decke.");
}

int schreifkt(string str) {
  notify_fail("Wie moechtest Du schreien?\n");
  if (str != "laut" ) return 0;
  if (tropfen == 0) {
    write("Du schreist wie ein Wilder laut auf. Doch nichts passiert.\n");
    say(CAP_TPN+" schreit wie ein Wilder laut auf. Du wunderst Dich.\n");
    return 1;
  }
  tropfen=0;
  write(BS(
    "Du schreist wie ein Wilder laut auf. Durch die Vibrationen fallen "
    "abertausende von Tropfen von der Decke herunter. Du wirst plitschnass.\n"));
  say(BS(
    CAP_TPN+" schreit wie ein Wilder laut auf. Durch die Vibration fallen "
    "abertausende von Tropfen von der Decke herunter. Du wirst plitschnass.\n"));
  return 1;
}
