#include "../def.h"

inherit ROOM "inh-wohngebiet";

string *krug;

void create()
{
  ::create();

  AddDetail( ({ "hoehle" }),
    "Eine Hoehle ist offen und vielleicht koenntest Du sie ja tatsaechlich "
    "betreten.");

  AddItem(NPC "spielkind", REFRESH_DESTRUCT);

  AddCmd( ({"betrete","betret","betritt" }), "cmd_betreten" );

  AddExit( "westen",     "./weg-f6" );
  AddExit( "sueden",     "./weg-g7" );
  AddExit( "suedwesten", "./weg-f7" );

  krug = ({ });
}

void reset()
{
  ::reset();

  krug = ({ });
}

int cmd_betreten(string str)
{
  object ob;
  string s;
  int ok;

  notify_fail("Was moechtest Du betreten?\n");

  if(!str || str == "") return 0;
  if(!(str == "hoehle"         ||
       str == "die hoehle"     )) return 0;

  tell_room(TO,BS(TPN+" versucht eine der Hoehlen zu betreten und wird von "
                  "einer altersschwachen Dunkelelfin hinausgejagt. Alle "
                  "Anwesenden grinsen haemisch. "), ({ TP }) );


  ok = 0;
  if(RUNENMASTER->IsRuneHere(getuuid(TP), 7) == 1) ok = 1;
  if(member(krug, getuuid(TP)) > -1)               ok = 0;

  s = "Leicht beschwingt versuchst Du die offenstehende Hoehle zu "
      "betreten. Mit einem Fuss stehst Du schon auf der Schwelle als auf "
      "einmal eine alte Dunkelelfin mit ihrem Besen auf Dich zugerannt "
      "kommt und Dir einen gehoerigen Schlag auf Deinen Hintern gibt und "
      "Dich aus der Hoehle rauswirft. ";

  if(!ok)
  {
    tell_object(TP,BS(s + "Alle Anwesenden grinsen haemsisch. "));
    return -1;
  }

  s += "Die Dunkelelfin wirft Dir noch einen Bierkrug nach und trifft "
       "Dich hart am Kopf.";

  krug += ({ getuuid(TP) });

  ob = clone_object(WEAPON "bierkrug");
  ob->AddId( ({"\n_runenquest_krug"}) );
  ob->move(TO, M_NOCHECK);

  tell_object(TP, BS(s));

  TP->AddHP(-20-random(20));

  return 1;
}
