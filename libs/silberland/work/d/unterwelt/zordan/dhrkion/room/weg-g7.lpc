#include "../def.h"

inherit ROOM "inh-wohngebiet";

#include <properties.h>
#include <language.h>
#include <moving.h>

void create()
{
  ::create();

  AddDetail( ({ "waende" }),
    "Unzaehlbar viele Waende gibt es hier. Die Wohnungen haben halt alle "
    "mindestens vier davon. Eine Wand faellt Dir besonders auf."
  );

  AddDetail( ({ "wand" }),
    "Eine Wand steht besonders nahe am Rand von Dhrkion."
  );

  AddDetail( ({ "rand" }),
    "Du ueberlegst: Vielleicht waere es ja tatsaechlich moeglich mit "
    "Hilfe der Wand ueber den Schutzwall vor die Stadt zu springen."
  );

  AddDetail( ({ "hilfe" }),
    "Hilfe kannst Du hier unten nicht erwarten."
  );

  AddDetail( ({ "schutzwall","wall" }),
    "Der Schutzwall ist deutlich im Suedosten zu sehen. Eine Wand steht "
    "besonders nah dran."
  );

  AddItem( NPC "drow", REFRESH_DESTRUCT);

  AddCmd( ({ "spring","springe" }) , "cmd_springen" );

  AddExit( "westen",     "./weg-f7" );
  AddExit( "norden",     "./weg-g6" );
  AddExit( "nordwesten", "./weg-f6" );

  AddExit("suedunten","/d/unterwelt/zaknafein/eheringquest/room/start");
  AddExit("sueden","/d/unterwelt/zaknafein/eheringquest/room/start");

  SetProp(P_HIDE_EXITS, QueryProp(P_HIDE_EXITS) + ({ "sueden" }));
}

int cmd_springen(string str)
{
  notify_fail("Wie moechtest Du GENAU springen?\n");

  if(!str || str == "") return 0;
  if(!(str == "mit hilfe wand ueber schutzwall"           ||
       str == "mit hilfe wand ueber schutzwall vor stadt" ||
       str == "mit hilfe wand ueber wall"                 ||
       str == "mit hilfe wand ueber wall vor stadt"       )) return 0;

  tell_object(TP,BS("Du nimmst einen gewaltigen Anlauf und springst gekonnt "
                    "auf die Wand und von dort aus mit dem Ueberschuss an "
                    "Energie ueber den Schutzwall vor die Stadt." ));

  TP->move( ROOM "wall-h7" , M_GO, 0,
        "springt ueber eine Wand",
        "kommt ueber den Schutzwall angesprungen");

  return 1;
}

