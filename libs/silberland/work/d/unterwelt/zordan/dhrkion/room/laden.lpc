#include "../def.h"

inherit "/std/laden";

#include <laden.h>

int schrank,seil;

void create()
{
  ::create();

  schrank=seil=0;

  SetStorageRoom( ROOM "laden-store");

  SetProp(P_INT_SHORT, "Der Laden von Syphonius" );
  SetProp(P_INT_LONG,
    "Gemuetlich und schnuckelig hat Syphonius seinen kleinen Laden "
    "eingerichtet. Ueberall liegen brauchbare, aber auch unbrauchbare "
    "Dinge herum. An der Decke haengen diverse Regale herunter. Aber auch "
    "auf dem Boden stehen ein paar kleine Schraenke. Auf der Holztheke "
    "selber liegen nur ein paar Sachen. Den restlichen Platz behaelt sich "
    "Syphonius wohl zum Handeln frei. Eigentlich bemerkt man auch "
    "ueberhaupt nicht, dass der Laden in einen kleinen Felsblock gehauen "
    "wurde, denn die Waende sind mit Teppichen und anderem Ramsch "
    "vollgehaengt."
  );

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_CAVE]) );

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "syphonius");
  SetProp(P_SHOPKEEPER_NAME, "Syphonius");
  SetProp(P_SHOPKEEPER_GENDER, MALE);

  AddDetail( ({ "ramsch" }),
    "Der Ramsch ist wie der Name schon sagt ueberhaupt nichts wert. "
    "Absolut wertlos.");

  AddDetail( ({ "tueren" }),
    "Ziemlich normale Tueren sind das am Schrank.");

  AddDetail( ({ "platz" }),
    "Syphonius scheint zum Handeln immer ein wenig Platz zu benoetigen. "
    "Er verhandelt wohl immer auch mit seinen Armen und Beinen.");

  AddDetail( ({ "arme","beine","arm","bein" }),
    "Wie wild schlaegt er damit um sich, damit er einen besseren Preis "
    "bekommt. Manche haben sich auch schon darueber so aufgeregt, dass sie "
    "den Laden fluchtartig verlassen haben. Trotzdem laesst Syphonius sich "
    "davon nicht abbringen, weiterhin so zu handeln.");

  AddDetail( ({ "handeln","handel","meister" }),
    "Syphonius ist ein Meister im Handeln. Wenn Du nicht genau aufpasst, "
    "dann wird er Dich unter die Theke handeln. Aber normalerweise ist er "
    "eigentlich ganz fair und betruegt sehr selten. Trotzdem sollte man "
    "aufpassen, welchen Preis man fuer seine Dinge bekommt oder bezahlt.");

  AddDetail( ({ "felsblock","block" }),
    "Der Laden wurde in einen etwas groesseren Felsblock gebaut. Von den "
    "Felsen kann man aber bei all den vielen Dingen hier nicht mehr viel "
    "sehen.");

  AddDetail( ({ "waende","wand","felswaende" }),
    "Die Felswaende sind mit minderwertigen Teppichen vollgehaengt und "
    "zeigen auch sonst nichts Besonderes. Vielleicht waere noch der "
    "besonders grosse Vorhang im Norden zu erwaehnen.");

  AddDetail( ({ "teppiche","teppich" }),
    "Die Teppiche sind nicht besonders wertvoll. Aber fuer die eigene "
    "Wohnung sicher ausreichend, damit man sich wohl fuehlt.");

  AddDetail( ({ "besonderes" }),
    "Wo?");

  AddDetail( ({ "vorhang","norden" }),
    "Der Vorhang im Norden scheint ziemlich dick zu sein. Als Du versuchst "
    "dahinter zu schauen, haellt Dich eine unbekannte Macht davon zurueck. "
    "Du bekommst einen richtigen Schreck dabei.");

  AddDetail( ({ "macht" }),
    "Diese Macht ist ziemlich gross. Du bekommst den Vorhang nicht "
    "zurueckgeschlagen.");

  AddDetail( ({ "schreck" }),
    "Du erschrickst fuerchterlich dabei.");

  AddDetail( ({ "boden","steinboden" }),
    "Auf dem Steinboden stehen ein paar Moebel und diverse kleine "
    "Schraenke herum.");

  AddDetail( ({ "holztheke","theke" }),
    "Die Theke ist komplett aus Holz und auf ihr sind schon jede Menge "
    "Kratzer zu erkennen. Sie steht vorteilhaft im Eingangsbereich, so "
    "dass man den Laden nicht ohne zu bezahlen verlassen kann.");

  AddDetail( ({ "eingangsbereich" }),
    "Im Eingangsbereich steht nur die Theke.");

  AddDetail( ({ "kratzer" }),
    "Die Kratzer muessen wohl von den vielen Geschaeften Syphonius' "
    "stammen. Jedesmal wenn er etwas kauft oder verkauft geht es "
    "schliesslich ueber die Theke.");

  AddDetail( ({ "geschaefte" }),
    "Syphonius macht wohl gute Geschaefte. Aber ein Halsabschneider ist er "
    "sicher nicht.");

  AddDetail( ({ "halsabschneider" }),
    "Bist Du etwa einer? Dann sei gewarnt.");

  AddDetail( ({ "sachen","verkauf" }),
    "Die Sachen stehen wohl nicht zum Verkauf dort. Sie zieren nur den "
    "Laden und wirken auch wirklich gemuetlich.");

  AddDetail( ({ "decke" }),
    "Grosse Regale sind an der steinernen Decke befestigt worden. "
    "Ansonsten besteht die Decke wirklich nur aus natuerlichem "
    "Felsgestein. Was hier eindeutig fehlt ist eine Lampe, aber das bist "
    "Du ja eh schon von Dhrkion gewohnt.");

  AddDetail( ({ "regale" }),
    "In den Regalen aus Holz bewahrt Syphonius jede Menge seiner Waren "
    "auf. Sie sind mit Seilen an der Decke befestigt worden und beruehren "
    "den Boden nicht einmal.");

  AddDetail( ({ "regal" }),
    "Das eine Regal haengt ein wenig schief.");

  AddDetail( ({ "seile" }),
    "Mit dicken Seilen sind die Regale an der Decke befestigt worden. Ein "
    "Seil sieht ein wenig locker aus.");

  AddDetail( ({ "felsgestein","gestein","fels" }),
    "Ganz normaler Fels wie ueberall in Dhrkion.");

  AddDetail( ({ "lampe" }),
    "Wo ist hier eine?");

  AddDetail( ({ "dhrkion","stadt" }),
    "Du bist in dem Laden von Dhrkion gelandet. Hier kannst Du Dinge "
    "kaufen aber auch verkaufen. Syphoinus ist aber gut im Handeln. Also "
    "sei auf der Hut.");

  AddDetail( ({ "hut" }),
    "Er wird Dich nicht betruegen. Aber manchmal ist er schon ein wenig "
    "seltsam und uebertreibt bei den Preisen.");

  AddDetail( ({ "preise","preis" }),
    "Normalerweise sind sie hier recht gut fuer alle. Aber manchmal ist "
    "Syphonius ein wenig mutig und macht schlechte Preise.");

  AddDetail( ({ "menge" }),
    "Hier lagern wirklich sehr viele Waren.");

  AddDetail( ({ "waren","ware" }),
    "Sorgfaeltig und sauber bewahrt Syphonius seine ganzen Waren auf. "
    "Sie scheinen auch ganz guter Qualitaet zu sein. Die wirklich "
    "unbrauchbaren Dinge schmeisst er wohl immer sofort weg. Allerdings "
    "muss man auch sagen, dass er die wirklich sehr guten Dinge wohl "
    "fuer sich behaelt.");

  AddDetail( ({ "holz" }),
    "Holz aus dem Silberwald ist es.");

  AddDetail( ({ "silberwald","wald" }),
    "Der Silberwald liegt an der Oberflaeche. Ein weiter Weg fuehrt dort "
    "hinauf. Schliesslich bist Du in der Unterwelt ein gutes Stueck unter "
    "der Oberflaeche.");

  AddDetail( ({ "oberflaeche","flaeche" }),
    "Die liegt hunderte Meter ueber Dir.");

  AddDetail( ({ "meter","definition","suchen","ort" }),
    "Ich gehe hier nicht weiter auf die Definition eines Meters ein. "
    "Darueber gibt es im SilberLand einen Ort, wo das genau erklaert "
    "wird. Schoenes Suchen, Zordan.");

  AddDetail( ({ "qualitaet" }),
    "Die Qualitaet der Waren hier ist gut bis sehr gut.");

  AddDetail( ({ "weg" }),
    "Der Weg ist weit und sicher nicht ungefaehrlich.");

  AddDetail( ({ "unterwelt" }),
    "Wie Du so langsam bemerken solltest, bist Du in der gefuerchteten "
    "Unterwelt gelandet. Gefaehrlich ist es hier unten, da kannst Du Dir "
    "ganz sicher sein!");

  AddDetail( ({ "stueck" }),
    "Dieses 'Stueck' sind mehrere hundert Meter.");

  AddDetail( ({ "silberland","land" }),
    "Du bist im SilberLand. Schoen, dass Du es auch bemerkst ;)");

  AddDetail( ({ "zordan" }),
    "Ein kleiner Schelm erscheint in einer Schwefelwolke, wuselt eine "
    "Weile aufgeregt und nervend um Dich herum und klingelt dabei mit "
    "seinen Glocken wie ein Wilder. Dann zeigt er Dir eine lange Nase "
    "und verschwindet in einer Gedankenwolke. Sachen gibt es ...");

  AddDetail( ({ "dinge" }),
    "Kleine und grosse, brauchbare und unbrauchbare Dinge liegen hier "
    "ueberall herum. Auf den ersten Blick fallen Dir die vielen "
    "Kindersachen auf. Ungewoehnlich findest Du. Aber auch die normalen "
    "Dinge des Lebens kann man hier bekommen: Moebel fuer die eigene "
    "Wohnung, Kleidung, aber auch Waffen, Ruestungen und viel Allerlei.");

  AddDetail( ({ "blick","kindersachen" }),
    "Ist schon seltsam, wieviele Kindersachen Syphonius in seinem Laden "
    "anbietet. Ob man hier einen grossen Nachwuchs heranzieht?");

  AddDetail( ({ "lebens","leben","muenzen" }),
    "Na von Muenzen alleine kann man ja nicht leben.");

  AddDetail( ({ "moebel","wohnung" }),
    "Ein paar Moebel bietet Syphonius auch an. Es sind nicht viele. Aber "
    "man koennte seine Wohnung damit schon ganz gut ausstatten. Genauer "
    "ansehen tust Du Dir die Moebel aber nicht. Zu langweilig, findest "
    "Du.");

  AddDetail( ({ "kleidung","ruestung" }),
    "Die kannst Du Dir mit 'zeige ruestungen' ansehen.");

  AddDetail( ({ "waffen" }),
    "Die kannst Du Dir mit 'zeige waffen' ansehen.");

  AddDetail( ({ "allerlei" }),
    "Das kannst Du Dir mit 'zeige verschiedenes' ansehen.");

  AddDetail( ({ "nachwuchs" }),
    "Du bist Dir echt nicht sicher, ob man hier viele Kinder hat, oder ob "
    "man mit vielen Kindern zu tun hat. Das ist naemlich ein kleiner "
    "Unterschied.");

  AddDetail( ({ "kinder" }),
    "Viele sehen in eigenen Kindern den Sinn des Lebens.");

  AddDetail( ({ "unterschied" }),
    "Der Unterschied ist doch eindeutig: Einmal gehoert den Eltern der "
    "Nachwuchs und einmal nicht. Du gruebelst ein wenig nach.");

  AddDetail( ({ "eltern" }),
    "Wenn die Kinder nicht den angeblichen Eltern gehoeren, wem dann?");

  AddDetail( ({ "sinn" }),
    "Macht das alles hier Sinn?");

  AddDetail( ({ "laden" }),
    "Wirklich gemuettlich und sauber haelt Syphonius seinen Laden. Viele "
    "Dinge hat er in seinem Angebot. Seine Regale sind recht gut gefuellt "
    "und die Schraenke sind auch nicht gerade leer. Der Laden selber "
    "wurde in einen groesseren Felsblock geschlagen.");

  AddDetail( ({ "angebot" }),
    "Das reichhaltige Angebot von Syphonius kannst Du Dir mit 'zeige' "
    "ansehen.");

  AddDetail( ({ "staub","rede" }),
    "Nur wenig Staub ist es. Wirklich nicht der Rede wert.");

  AddDetail( ({ "ohr" }),
    "Du greifst an Dein Ohr. Es ist noch da. Du atmest erleichtert auf.");

  AddSound( ({ DEFAULT_SOUND }),
    "Ein paar dumpfe Schlaege scheinen aus dem Norden zu kommen.");

  AddSound( ({ "schlaege","schlag","norden" }),
    "Jemand scheint im Norden Metall zu bearbeiten. Jedenfalls dringen "
    "ein paar dumpfe Schlaege an Dein Ohr.");

  AddSmell( ({ DEFAULT_SMELL }),
    "Die Luft hier ist staubig und trocken.");

  AddSmell( ({ "luft" }),
    "Die Luft riecht wirklich nach nicht viel. Ein wenig Staub liegt in "
    "der Luft aber sonst...");

  AddSmell( ({ "staub" }),
    "Der Staub ist wohl schon Jahrhunderte alt. Er riecht ein wenig "
    "abgestanden." );

  AddItem(NPC "syphonius", REFRESH_DESTRUCT);
  AddItem("/gilden/spinnenkrieger/obj/spinnenautomat", REFRESH_REMOVE);

  AddSpecialDetail( ({"schrank"})       , "detail_schrank" );
  AddSpecialDetail( ({"schraenke"})     , "detail_schraenke" );
  AddSpecialDetail( ({"seil"})          , "detail_seil" );
  AddSpecialDetail( ({"syphonius"})     , "detail_syphonius" );
  AddSpecialDetail( ({ "name","namen"}) , "detail_name" );

  AddCmd( ({"befestige", "befestig"}) , "cmd_befestigen" );
  AddCmd( CMD_OEFFNEN                 , "cmd_oeffnen" );

  AddExit( "suedwesten",  ROOM "weg-f5" );
}

void reset()
{
  ::reset();

  schrank = 0;
  seil    = 0;
}

string detail_syphonius(string str)
{
  if(!present("syphonius"))
  {
    return "Oh, der ist wohl gerade unterwegs, kommt aber bestimmt bald "
           "wieder.\n";
  }

  return "Er er ist doch da. Schau ihn doch direkt an!\n";
}

string detail_name(string str)
{
  return "Alles hat einen Namen, sogar Du "+TPN+"!\n";
}

string detail_schraenke(string str)
{
  if (schrank==0)
  {
    return BS("In den Schraenken sind viele Waren von Syphonius "
              "enthalten. Sie sind alle bis auf einen geoeffnet und man "
              "kann direkt die Waren sehen.");
  }

  return BS("In den Schraenken sind viele Waren von Syphonius enthalten. "
            "Sie sind alle geoeffnet und man kann direkt die Waren sehen.");
}

string detail_seil(string str)
{
  if (seil==0)
  {
    return "Vielleicht sollte man es besser wieder richtig befestigen?\n";
  }

  return "Da war wohl schon jemand schneller. Das Seil ist doch fest.\n";

}

int cmd_befestigen(string str)
{
  notify_fail("Was moechtest Du befestigen?\n");

  if(!str || str == "")     return 0;
  if(seil == 1)             return 0;
  if(!(str == "seil"     ||
       str == "das seil" )) return 0;


  tell_object(TP, BS("Du nimmst das lockere Ende des Seils und befestigst "
                     "es wieder richtig an der Decke und an dem Regal. "
                     "Oha, das war ja glatt ein gutes Werk. Jetzt wird "
                     "das Regal erstmal eine gute Weile halten." ));
  seil = 1;

  return 1;
}

int cmd_oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");

  if(!str || str == "") return 0;
  if(!(str == "schrank"     ||
       str == "den schrank" )) return 0;

  if(schrank == 1)
  {
    tell_object(TP, "Der Schrank ist doch schon offen!\n");
    return -1;
  }

  if(seil == 0)
  {
    tell_object(TP, BS("Du bekommst den Schrank nicht auf, weil seine "
                       "Tueren irgendwie verklemmt sind. Die Regale "
                       "daneben scheinen schuld zu sein." ));
    return -1;
  }

  tell_object(TP, "Du oeffnest den Schrank.\n");
  tell_room(TO, CAP_TPN+" oeffnet einen Schrank.\n", ({TP}) );
  schrank = 1;

  return 1;
}

string detail_schrank(string str)
{
  string s;

  if(schrank == 0) return "Der Schrank ist geschlossen.\n";

  switch(RUNENMASTER->GetRune(getuuid(TP), 1))
  {
    case 1:
      s = "Du findest in dem Schrank eine kleine Rune, die Du sofort "
          "an Dich nimmst.";
      break;

    case -1:
      s = "Du findest in dem Schrank eine kleine Rune, die jedoch viel zu "
          "schwer ist und Du sie deshalb liegen laesst. ";
      break;

    default:
      s = "Der Schrank ist offen. Zu Deiner Enttaeuschung ist er aber "
          "gaehnend leer.";
      break;
  }

  return BS(s);
}

varargs int do_sell(object ob, int force, string prefix, int limit)
{
  if(ob->id("Lichtquelle") || ob->id("fackel"))
  {
    write(prefix+"Sowas kauft mir hier doch niemand ab !\n");
    return 1;
  }

  if(ob->QueryProp(P_LIGHT) > 0)
  {
    write(prefix+"Ein leuchtendes Objekt braucht doch hier keiner.\n");
    return 1;
  }

  return ::do_sell(ob,force,prefix,limit);
}
