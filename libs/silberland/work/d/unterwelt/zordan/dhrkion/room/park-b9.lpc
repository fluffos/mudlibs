#include "../def.h"

inherit ROOM "inh-park.lpc";

int haut;

void create()
{
  ::create();

  AddDetail( ({ "wand","waende" }),
    "Vor langer Zeit waren die Waende wohl mal mit Moos bewachsen. Jetzt "
    "ist es dafuer aber viel zu trocken in dieser Hoehle. Ein Gegenstand "
    "scheint sich an der Wand verfangen zu haben.");

  AddDetail( ({ "gegenstand" }),
    "Vielleicht kannst Du ihn nehmen?");

  AddItem(creatures, REFRESH_DESTRUCT);
  AddItem(creatures, REFRESH_DESTRUCT);

  AddCmd( CMD_NEHMEN, "cmd_nehmen" );

  AddExit( "nordwesten"  , ROOM "park-a8"  );
  AddExit( "osten"       , ROOM "park-c9" );
  AddExit( "nordunten"   , ROOM "tunnel1" );

  haut = 1;
}

void reset()
{
  ::reset();

  haut = 1;
}

int cmd_nehmen(string str)
{
  object ob;
  string s;
  int ret;

  notify_fail("Wo moechtest Du genau nehmen?\n");

  if(!str || str == "") return 0;

  if(!(str == "gegenstand"     ||
       str == "den gegentand"  )) return 0;

  tell_room(TO, CAP_TPN+" bueckt sich nieder.\n", ({ TP }) );

  ret = -1;

  if(haut == 1)
  {
    s = "Du schaust Dir die Wand genauer an und siehe da. Eine "
        "Schlangenhaut klebt daran. Es ist die Haut einer Satanskobra "
        "und Du bist heilfroh, dass die Schlange sich wohl schon lange "
        "verzogen hat. ";

    ob = clone_object("/d/dschungel/dante/weg/armour/dhaut");

    if(ob->move(TP, M_GET) == 1)
    {
      s += "Deinen Fund steckst Du natuerlich sofort ein. ";
      haut = 0;
      ret  = 1;
    }
    else
    {
      s += "Da sie Dir aber zu schwer ist, haengst Du sie weder da hin, wo "
           "Du sie gefunden hast. ";
      ob->remove();
    }
  }
  else
  {
    s = "So ein Mist, Du hast Dich wohl getaeuscht. Da ist ja gar "
        "nichts." ;
  }

  tell_object(TP, BS(s));

  return ret;
}
