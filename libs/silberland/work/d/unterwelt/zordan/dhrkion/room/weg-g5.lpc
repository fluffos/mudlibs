#include "../def.h"

inherit "std/room";

void create()
{

  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse in Dhrkion" );
  SetProp( P_INT_LONG,
    "Du gehst weiter auf der Hauptstrasse in Dhrkion. Die Strasse zeigt "
    "hier keine Besonderheiten. Sie geht einfach nach Osten und Westen "
    "weiter. Im Norden kannst Du einen Eingang zu einer besonders grossen "
    "Hoehle erkennen und im Sueden mehrere Erhebungen." );

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "norden","sueden","westen","osten" }),
    "Norden - Sueden - Westen - Osten - was mag das bloss sein?");

  AddDetail( ({ "hoehle" }),
    "Die Hoehle scheint etwas Wichtiges zu enthalten. Man sieht auch ein "
    "paar Bewohner diese Hoehle betreten und spaeter wieder verlassen.");

  AddDetail( ({ "wichtiges" }),
    "Die Bewohner kommen manchmal mit anderen Sachen wieder raus, als sie "
    "reingegangen sind. So seltsam findest Du das aber eigentlich nicht.");

  AddDetail( ({ "sachen" }),
    "Was das fuer Sachen sind, kannst Du nicht erkennen.");

  AddDetail( ({ "besonderheiten" }),
    "Die Strasse hat zwar keine. Die Stadt aber schon.");

  AddDetail( ({ "besonderheit" }),
    "Die Besonderheit hier ist eigentlich nur, dass Du sowas untersuchst ;)");

  AddDetail( ({ "eingang" }),
    "Dieser Eingang ist einfach nur riesig, aber erreichen kannst Du ihn "
    "von hier aus leider nicht. Du musst wohl den Weg ueber den Marktplatz "
    "behmen.");

  AddDetail( ({ "weg" }),
    "Nein, Du erkennst wirklich keinen direkten zu dem Eingang.");

  AddDetail( ({ "hauptstrasse","strasse" }),
    "Die Hauptstrasse durchquert Dhrkion vom Osten in den Westen. Sie wurde "
    "einfach in die Felsen geschlagen bzw. wurden die damals vorhandenen "
    "Felsen begradigt.");

  AddDetail( ({ "dhrkion","stadt" }),
    "Du stehst im Osten von Dhrkion. Bis auf die Erhebungen im Sueden kannst "
    "Du eigentlich von hier aus keine besonderen Sachen sehen.");

  AddDetail( ({ "sachen" }),
    "Vielleicht sollte man das alluebertreffende Felsstueck mitten in der "
    "Stadt noch bemerken. Es reicht weiter hinauf, als Du sehen kannst. Die "
    "Decke verschlingt es geradezu.");

  AddDetail( ({ "fels","felsen" }),
    "Die Felsen sind hier sehr hart. Es muss eine ebenso harte Arbeit gewesen "
    "sein, hier eine Strasse anzulegen.");

  AddDetail( ({ "erhebungen" }),
    "Die Erhebungen im Sueden fallen Dir besonders auf, da dort wohl das "
    "taegliche Leben spielt. Manchmal kannst Du sogar einen Kopf zwischen "
    "den Erhebungen sehen. Eine Erhebung faellt Dir besonders auf.");

  AddDetail( ({ "felsstueck","stueck" }),
    "Genau kannst Du von hier aus noch nicht sagen, was das genau ist. Du "
    "musst schon weiter nach Westen auf den Marktplatz gehen, um mehr zu "
    "erfahren.");

  AddDetail( ({ "decke" }),
    "Die Decke verschwindet in der Dunkelheit. Sie nimmt auch das grosse "
    "Felsstueck in der Mitte der Stadt mit.");

  AddDetail( ({ "arbeit" }),
    "Sehr harte Arbeit muss das gewesen sein. Du moechtest sie nicht "
    "verrichten und lieber weiter forschen gehen.");

  AddDetail( ({ "leben" }),
    "Hier lebt wirklich alles, sogar die kleinen Viecher auf dem Boden.");

  AddDetail( ({ "kopf","koepfe" }),
    "Ab und zu kannst Du einen Kopf zwischen den Erhebungen im Sueden "
    "sehen. Das sind wohl die Bewohner von Dhrkion. Aber die Koepfe "
    "verschwinden zu schnell wieder, als dass Du sie ansprechen koenntest.");

  AddDetail( ({ "erhebung" }),
    "Eine der Erhebungen erinnert Dich an Deine Kindheit. Sie sieht aus "
    "wie ein grosser Lolli.");

  AddDetail( ({ "marktplatz","platz" }),
    "Der Marktplatz liegt weiter im Westen. Geh doch mal hin, wenn Du handeln "
    "moechtest.");

  AddDetail( ({ "dunkelheit" }),
    "Eine allzugegen antreffende Dunkelheit umhuellt diese Stadt. Die "
    "Bewohner hier moegen wohl kein Licht.");

  AddDetail( ({ "mitte" }),
    "Die Mitte dieser Stadt bildet dieses riesige Felsstueck.");

  AddDetail( ({ "viecher","wuermer","wurm" }),
    "Iks, kleine Wuermer kriechen hier herum. Du passt aber sorgsam darauf "
    "auf, dass Du keinen zertrittst. Schliesslich willst Du ja nicht dafuer "
    "verantwortlich sein, wenn es hier anfaengt zu regnen.");

  AddDetail( ({ "boden" }),
    "Der Boden ist aus normalem Fels gehauen. Ein winziges Schild liegt "
    "auf dem Boden herum.");

  AddDetail( ({ "schild" }),
    "Das Schild liegt so auf dem Boden herum. Du kannst es lesen.");

  AddDetail( ({ "kindheit" }),
    "Hattest Du etwa keine? Nene, falls Du das sagen wuerdest, luegst Du!");

  AddDetail( ({ "lolli" }),
    "Hmmmm, lecker. Was man wohl mit einem Lolli machen kann?");

  AddDetail( ({ "bewohner","dunkelelfen" }),
    "Die Bewohner hier sind Dunkelelfen.");

  AddDetail( ({ "licht" }),
    "Licht hasst man hier wie die Pest. Besser Du machst Deines aus, man "
    "weiss ja nie, an wen man hier geraet!");

  AddDetail( ({ "pest" }),
    "Aber Du glaubst fast, dass man die Pest mehr mag...");

  AddDetail( ({ "wand","waende" }),
    "Hm, davon gibt es hier keine.");

  AddDetail( ({ "stimmenwirrwarr" }),
    "Wie willst Du sowas sehen?");

  AddDetail( ({ "luft" }),
    "Ganz normale Luft. Ein wenig stickig vielleicht. Aber das stoert nicht "
    "weiter.");

  AddReadDetail( ({ "schild" }),
    "Herzlich Willkommen in Dhrkion.");

  AddSound( DEFAULT_SOUND,
    "Stimmenwirrwarr kommt aus dem Norden und Sueden.");

  AddSound( ({ "stimmenwirrwarr","wirrwarr","stimmen" }),
    "Im Norden scheint man zu handeln und im Sueden sich ganz normal zu "
    "unterhalten.");

  AddSmell( ({ DEFAULT_SMELL , "duft" }) ,
    "Es liegt kein besonderer Duft in der Luft.");

  AddItem(NPC "spinne", REFRESH_DESTRUCT);
  AddItem(NPC "sklave2", REFRESH_DESTRUCT);

  AddCmd( ({ "schleck","schlecke" }),"cmd_schlecken" );

  AddExit("westen", ROOM "weg-f5" );
  AddExit("osten",  ROOM "weg-h5" );
}

int cmd_schlecken(string str)
{
  notify_fail("Woran moechtest Du schlecken?\n");

  if(!str || str == "") return 0;
  if(!(str == "lolli"   ||
      str == "an lolli" )) return 0;

  tell_object(TP, BS(
    "Schade eigentlich, dass der Lolli nicht real ist. Sonst wuerdest "
    "Du jetzt gerne an einem schlecken. Wasser laeuft in Deinem Munde "
    "zusammen und Du bist gluecklich, als Du Dich an Deine Kindheit "
    "erinnerst. Erschrocken wendest Du Dich aber wieder Deiner Forscherei "
    "zu. Ist ja auch wichtiger als ein nicht vorhandener Lolli."));

  return 1;
}

