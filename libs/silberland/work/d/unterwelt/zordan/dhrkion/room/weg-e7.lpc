#include "../def.h"

inherit "std/room";

string *found;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine kleine Senke" );
  SetProp( P_INT_LONG,
    "Du findest Dich in einer finsteren Senke im Sueden von Dhrkion "
    "wieder. Hier scheint die Stadt vor langer Zeit mal zu Ende gewesen "
    "zu sein, was Du an alten Waellen erkennen kannst. Viele Spuren "
    "fuehren in Richtung Osten aber nur sehr wenige nach Westen. Im "
    "Sueden kannst Du eine kleine Hoehle mit einem grossen 'P' darueber "
    "sehen."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "ende" }),
    "Die Stadt war hier mal zu Ende. Das ist sie aber nicht mehr.");

  AddDetail( ({ "boden" }),
    "Auf dem sandigen Boden kannst Du viele Spuren entdecken.");

  AddDetail( ({ "hoehle" }),
    "Die Hoehle liegt ein wenig versteckt in einem kleinen Fels im Sueden. "
    "Ein grosses Schild mit einem 'P' haengt ueber dem Eingang.");

  AddDetail( ({ "schild" }),
    "Das Schild ist aus Holz gemacht.");

  AddDetail( ({ "holz" }),
    "Ganz normales Holz.");

  AddDetail( ({ "eingang","zugang" }),
    "Der Eingang ist einfach nur ein in den Fels geschlagener Zugang zu der "
    "Hoehle. Ein kleiner Vorhang versperrt die Sicht in die Hoehle.");

  AddDetail( ({ "p","h","a" }),
    "Ein P ist ein P und ein H ein H sowie ein A ein A, ha ha :)");

  AddDetail( ({ "fels" }),
    "Der Fels hier sieht genauso aus wie ueberall in der Stadt.");

  AddReadDetail( ({ "schild" }),
    "'P'");

  AddDetail( ({ "vorhang","sicht" }),
    "Der leicht schmutzige Vorhang versperrt Dir die Sicht in die Hoehle. "
    "Wenn Du mehr sehen willst, musst Du die Hoehle schon betreten.");

  AddDetail( ({ "decke" }),
    "Du kannst auch hier die dunkle Decke nicht erkennen.");

  AddDetail( ({ "waende" }),
    "Oh Wunder, hier ist tatsaechlich eine Wand.");

  AddDetail( ({ "wunder" }),
    "Naja, mitten in der Stadt gibt es sonst keine Waende. Also ist es doch "
    "schon verwunderlich, oder?");

  AddDetail( ({ "wand" }),
    "Die Wand steht einsam und verlassen schon halb verfallen nordwestlich "
    "von Dir. Auf ihr kannst Du ein komisches Gekritzel erkennen.");

  AddDetail( ({ "gekritzel" }),
    "Du kannst das Gekritzel nicht genau erkennen, da die Wand schon "
    "ziemlich dreckig geworden ist. Es koennte ja mal jemand die Wand "
    "reinigen. Aber wer macht sowas schon freiwillig.");

  AddDetail( ({ "waelle" }),
    "Alte Waelle sind hier zu sehen. Sie sind allerdings schon sehr "
    "zertreten, so dass man sie eigentlich nur noch erahnen kann. Sie "
    "bildeten wohl frueher mal einen richtige Schutzwall.");

  AddDetail( ({ "spuren","fussspuren" }),
    "Unglaublich viele Spuren fuehren nach Osten, aber nur sehr wenige nach "
    "Westen. Man meidet wohl den Bereich im Westen. Die Spuren sind aber "
    "auch nur Fussspuren, Wagenspuren gibt es keine.");

  AddDetail( ({ "bereich" }),
    "Der Bereich erscheint Dir ein wenig unheimlich. Vor allem weil von "
    "dort auch laute Schreie kommen.");

  AddDetail( ({ "richtung" }),
    "Eine Richtung ist halt nur eine Richtung. Man, mehr ist es nicht...");

  AddDetail( ({ "wagenspuren" }),
    "Kannst Du lesen? Falls ja, nimm dies: KEINE WAGENSPUREN!!!");

  AddDetail( ({ "zeit" }),
    "Die Zeit laeuft immer weiter. Auch wenn Du schlaefst oder rastest. "
    "Nie bleibt die Zeit stehen. Tolle Weisheit, oder?");

  AddDetail( ({ "weisheit" }),
    "Hast DU eine?");

  AddDetail( ({ "schmerzen" }),
    "Die Schmerzen muessen qualvoll sein, so laut wie die Schreie sind.");

  AddDetail( ({ "schreie" }),
    "Du kannst keine Schreie sehen.");

  AddDetail( ({ "senke" }),
    "Die Senke stellte frueher wohl auch mal einen Durchgang in die Stadt "
    "dar. Da man aber wohl weiteren Platz benoetigte, hat man den "
    "Schutzwall weiter in den Sueden verlegt. Uebrig blieb nur diese "
    "Senke.");

  AddDetail( ({ "durchgang" }),
    "Den alten Durchgang kannst Du nicht mehr erkennen. Zuviele Jahre sind "
    "ins Land gegangen.");

  AddDetail( ({ "dhrkion","stadt" }),
    "Du stehst ziemlich tief, so dass Du kaum etwas von der Stadt erkennen "
    "kannst. Spuren fuehren in alle Richtungen, aber Hoehlen kannst Du "
    "nur eine einzige erkennen, naemlich die im Sueden.");

  AddDetail( ({ "platz" }),
    "Der Platz wurde wohl fuer die vielen Dunkelelfen zu knapp. Da hat "
    "man sich anscheinend entschlossen, die Stadt nach Sueden auszudehnen.");

  AddDetail( ({ "schutzwall","wall" }),
    "Der muss wohl noch hinter der Hoehle im Sueden liegen. Denn erkennen "
    "kannst Du ihn von hier aus noch nicht.");

  AddDetail( ({ "jahre","jahr" }),
    "Das muessen wohl viele Jahre gewesen sein.");

  AddDetail( ({ "silberland","land" }),
    "Das Land in dem auch Du Dich befindest ist das SilberLand. Ein Land "
    "voller Freude, aber auch Schrecken.");

  AddDetail( ({ "richtungen" }),
    "Alle Richtungen halt.");

  AddDetail( ({ "hoehlen" }),
    "Du kannst nur eine einzige Hoehle im Sueden erkennen.");

  AddDetail( ({ "dunkelelfen" }),
    "In Dhrkion leben die Dunkelelfen. Gut erkannt. Und davon gibt es "
    "inzwischen sogar mehr als man denkt.");

  AddDetail( ({ "freude" }),
    "Viel Freude kann Dir das SilberLand bringen.");

  AddDetail( ({ "schrecken" }),
    "Der Schrecken lauert ueberall in der Unterwelt. Auch hier in "
    "Dhrkion.");

  AddDetail( ({ "unterwelt","name" }),
    "Wie der Name schon sagt, liegt die Unterwelt unter der Erde. Das "
    "Boese hat wie die Dunkelelfen sein Zuhause hier unten.");

  AddDetail( ({ "erde" }),
    "Unter der Erde liegt die ganze Unterwelt in viele Hoehlen kann man "
    "sich hier fortbewegen.");

  AddDetail( ({ "boese","schreckliches" }),
    "Das Boese lauert ueberall hier unten. Vor allem wenn man ein Licht "
    "angemacht hat, kann einem Schreckliches passieren!");

  AddDetail( ({ "licht" }),
    "Licht heisst man hier nicht willkommen. Besser Du machst Deines "
    "schnell aus!");

  AddDetail( ({ "zuhause","zuhaus","heimat" }),
    "In Dhrkion haben die Dunkelelfen ihre Heimat. Wo ist Deine?");

  AddDetail( ({ "dreck" }),
    "Hier weht sehr viel dunkler Dreck umher.");

  AddSound( ({DEFAULT_SOUND}),
    "Relativ ruhig ist es hier. Nur ein paar seltene Schreie kannst Du "
    "hoeren.");

  AddSound( ({"schreie"}),
    "Die Schreie kommen aus dem Westen und hoeren sich nicht gut an. "
    "Irgendjemand scheint qualvolle Schmerzen zu erleiden.");

  AddSmell( ({ DEFAULT_SMELL }),
    "Du kannst hier nichts besonderes riechen.");

  AddItem(NPC "drow"  , REFRESH_DESTRUCT);
  AddItem(NPC "spinne", REFRESH_DESTRUCT);

  AddCmd( ({ "reinige","saeubere","saeuber" }), "cmd_reinigen");
  AddCmd( CMD_NEHMEN,                           "cmd_nehmen");

  AddSpecialDetail( ({ "sand" }),               "detail_sand");
  AddSpecialDetail( ({ "lehm","lehmklumpen" }), "detail_lehm");

  AddExit( "norden",    ROOM "weg-e6" );
  AddExit( "westen",    ROOM "gef-d7" );
  AddExit( "nordosten", ROOM "weg-f6" );
  AddExit( "osten",     ROOM "weg-f7" );
  AddExit( "sueden",    ROOM "post"   );

  found = ({ });
}

void reset()
{
  ::reset();

  found = ({ });
}

string detail_sand(string str)
{
  string s;

  if((RUNENMASTER->IsRuneHere(getuuid(TP), 8) == 0) ||
     (present("\n_runenquest_edelstein",TP))        ||
     (member(found, getuuid(TP)) != -1)              )
  {
    return "Das ist ganz normaler Sand.\n";
  }

  return "Tief im Sand vergraben kannst Du einen Lehmklumpen erkennen.\n";
}

string detail_lehm(string str)
{
  string s;

  if((RUNENMASTER->IsRuneHere(getuuid(TP), 8) == 0) ||
     (present("\n_runenquest_edelstein",TP))        ||
     (member(found, getuuid(TP)) != -1)              )
  {
    return "Sowas siehst Du hier nicht.\n";
  }

  return "Ein kleiner Lehmklumpen ist das. Du koenntest ihn vielleicht "
         "nehmen.\n";
}

int cmd_nehmen(string str)
{
  object ob;
  int ret;

  notify_fail("Was moechtest Du nehmen?\n");

  if(!str || str == "") return 0;

  if(!(str == "lehm"        ||
       str == "lehmklumpen" ||
       str == "klumpen"     )) return 0;

  if((RUNENMASTER->IsRuneHere(getuuid(TP), 8) == 0) ||
     (present("\n_runenquest_edelstein",TP))         )
  {
    return 0;
  }

  if(member(found, getuuid(TP)) != -1) return 0;

  if(present("\n_runenquest_lehm",TP))
  {
    tell_object(TP, "Du hast genug Lehm bei Dir und willst nicht mehr.\n");
      return -1;
  }

  ret = -1;
  ob  = clone_object(OBJ "lehm");
  if(ob->move(TP,M_GET) == 1)
  {
    tell_object(TP, "Vorsichtig nimmst Du den Lehmklumpen an Dich.\n");
    found += ({ getuuid(TP) });
    ret = 1;
  }
  else
  {
    tell_object(TP, "Der Lehmklumpen ist Dir aber viel zu schwer.\n");
    ob->remove();
  }

  return ret;
}

int cmd_reinigen(string str)
{
  notify_fail("Was moechtest Du reinigen?\n");

  if(!str || str == "") return 0;
  if(!(str == "wand" )) return 0;

  tell_object(TP, BS("Vorsichtig reinigst Du die Wand und ein paar "
                     "Schriftzeichen kommen zum Vorschein. Auf Ihr "
                     "kannst Du noch schnell die Buchstaben: "
                     "'Gef eng is' erkennen, bevor der umherfliegende "
                     "Dreck die Wand wieder verschmutzt." ));

  tell_room(TO, CAP_TPN+" fummelt an einer dreckigen Wand herum.\n",
                ({ TP }) );

  return 1;
}

