/*
   Dhrkion, die Dunkelelfenstadt - Zordan@SL
*/

#include "../def.h"

inherit ROOM "rothe_inh.lpc";

#include <properties.h>

void create()
{
  ::create();

  NewDoor( "nordwesten","./wall-g8","gitter",
    ({ D_NAME,"Gitter",
       D_GENDER, NEUTER,
       D_FLAGS, (DOOR_RESET_CL|DOOR_CLOSED),
       D_MSGS, ({"nach Nordwesten", "geht durch das offene Gitter",
                                "kommt durch das offene Gitter herein" }),
       D_SHORT,"Ein Gitter im Nordwesten ist %s. ",
       D_FUNC2, "gitterzu",
       D_LONG,
         "Dieses kleine Gitter im Nordwesten verschliesst eine kleine Hoehle. "
         "Du kannst es leicht oeffnen."
    }) );

  AddItem( NPC "rothe", REFRESH_DESTRUCT);

  AddExit( "osten"   , "./rothe-i9"  );
  AddExit( "sueden"  , "./rothe-h10" );
}

gitterzu()
{
  call_other(DOOR_MASTER, "SetDoorStatus", ROOM "wall-g8", -1);

  write("Das Gitter faellt hinter Dir zu.\n");
  say("Das Gitter faellt hinter "+TPN+" zu.\n");
}

