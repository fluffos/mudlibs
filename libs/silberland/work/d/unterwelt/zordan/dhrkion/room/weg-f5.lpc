#include "../def.h"

inherit ROOM "inh-wegblock";

void create()
{
  ::create();

  thisroom = 1;

  SetProp( P_INT_SHORT, "Marktplatz von Dhrkion" );
  SetProp( P_INT_LONG,
    "Recht gemuetlich geht es im oestlichen Bereich des Marktplatzes zu. "
    "Ein paar Dunkelelfen sprechen noch ueber die letzten Geschaefte. In "
    "einer kleinen Senke steht ein Steinblock. Ueber einer kleine Hoehle "
    "im Nordosten haengt ein kleines Schild. Im Westen steht ein gigantisches "
    "Bauwerk und ueberstrahlt stolz ganz Dhrkion." );

  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "steinblock","block" }),
    "Der Steinblock ist komplett aus Stein und ist viel groesser als Du. "
    "Auf seiner Spitze scheint etwas eingraviert worden zu sein. Der "
    "Block selber ist auch ein wenig in Richtung des Bauwerkes geneigt.");

  AddDetail( ({ "stelle" }),
    "Du kannst eine Rune an einer Stelle einfuegen. Aber keine Stelle "
    "faellt Dir besonders auf.");

  AddDetail( ({ "stein" }),
    "Normaler, harter Stein halt.");

  AddDetail( ({ "richtung" }),
    "Diese Richtung ist also dann wohl nach Westen, wie Du messerscharf "
    "kombinierst.");

  AddDetail( ({ "senke" }),
    "Eine kleine Senke ist hier mittig eingelassen worden. In ihr steht "
    "ein grosser Steinblock.");

  AddDetail( ({ "waende","wand" }),
    "Wo sollen Waende auf einem Marktplatz stehen?");

  AddDetail( ({ "bauwerk" }),
    "Du kannst von hier aus nicht genau sehen, um was fuer ein Bauwerk es "
    "sich genau handelt. Aber Deine Erfahrung sagt Dir, dass es ein "
    "heiliger Ort sein muss.");

  AddDetail( ({ "ort" }),
    "Der Ort strahlt einfach etwas Heiliges aus. Zum Leid der Dunkelelfen ist "
    "hier ein seltsames Licht.");

  AddDetail( ({ "leid" }),
    "Bei Licht leiden die Dunkelelfen. Das Leid ist sogar recht gross.");

  AddDetail( ({ "heiliges" }),
    "Es ist eigentlich mehr ein Gefuehl. Aber stark genug um Dich zu verwirren.");

  AddDetail( ({ "gefuehl" }),
    "Hast Du eines oder nicht?");

  AddDetail( ({ "schild","holz" }),
    "Das Schild ist aus Holz.");

  AddReadDetail( ({ "schild" }),
    "Syphonius' Waren - treten Sie ein und lassen Sie uns gute Geschaefte machen.");

  AddDetail( ({ "stadt","dhrkion" }),
    "Du bist auf dem Marktplatz von Dhrkion gelandet.");

  AddDetail( ({ "bereich" }),
    "Du bist in einem kleinen Bereich des Marktplatzes. Genauer gesagt "
    "im Osten. Hier ist leider noch nicht viel los.");

  AddDetail( ({ "dunkelelfen","haendler" }),
    "Die Dunkelelfen achten nicht auf Dich und unterhalten sich angeregt "
    "weiter.");

  AddDetail( ({ "geschaefte","geschaeft" }),
    "Man macht wohl viele gute Geschaefte in Dhrkion. Die Dunkelelfen sind "
    "gute Haendler und verstehen es, ihren Profit zu machen.");

  AddDetail( ({ "profit" }),
    "Aber nur auf Profit aus zu sein kann auch sehr gefaehrlich sein.");

  AddDetail( ({ "worte" }),
    "Wie willst Du die sehen?");

  AddDetail( ({ "erde","boden" }),
    "Ein wenig Erde liegt auf dem Boden. Hier scheint man den Marktplatz "
    "wohl in naher Zukunft zu erweitern.");

  AddDetail( ({ "zukunft" }),
    "Wann das genau sein wird, steht wohl in den Sternen.");

  AddDetail( ({ "sterne","stern" }),
    "Du bist in einer Hoehle. Sterne kannst Du hier nicht sehen.");

  AddDetail( ({ "hoehle","decke" }),
    "Die Hoehle ist schon wirklich riesig. Aber die Decke kannst Du wegen "
    "einer allgemeinen Dunkelheit nicht sehen. Im Nordwesten ist eine "
    "kleinere Hoehle inmitten der Stadt. Viele Dunkelelfen gehen auch dort "
    "hinein und kommen auch wieder raus.");

  AddDetail( ({ "dunkelheit" }),
    "Aber halt. Hier ist doch tatsaechlich Licht. Wieso das nur?");

  AddDetail( ({ "licht" }),
    "Wow, Sonnenlicht kommt aus dem Bauwerk im Westen und bestrahlt den "
    "Marktplatz. Das ist aber wirklich ungewoehnlich.");

  AddDetail( ({ "sonnenlicht" }),
    "Du kannst es kaum fassen, aber es ist wirklich Sonnenlicht!");

  AddDetail( ({ "marktplatz" }),
    "Hier findet noch kein richtiger Handel statt. Aber ein paar Dunkelelfen "
    "stehen herum und reden miteinander.");

  AddDetail( ({ "handel" }),
    "Der wird mehr im Westen getrieben.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur ein paar Dunkelelfen verhandeln.");

  AddSound( ({ "dunkelelfen","elfen" }),
    "Sie reden zu leise, als das Du die Worte genau verstehen koenntest. "
    "Eigentlich geht es Dich ja auch ueberhaupt nichts an.");

  AddSound( ({ "worte" }),
    "Die paar Brocken die Du mitbekommst, gehen wohl ueber eine seltsames "
    "Licht, das man hier in Dhrkion bekommen kann.");

  AddSmell( DEFAULT_SMELL,
    "Hier liegt nur der Geruch von alter Erde in der Luft.");

  AddSmell( ({ "geruch","erde","luft" }),
    "Leicht feuchte Erde verbreitet hier einen angenehmen Geruch.");

  AddItem( NPC "drow", REFRESH_DESTRUCT);

  AddSpecialDetail( ({"erfahrung"}), "detail_erfahrung");
  AddSpecialDetail( ({"spitze"}),    "detail_spitze");

  AddExit( "nordosten",  ROOM "laden" );
  AddExit( "nordwesten", ROOM "weg-e4" );
  AddExit( "suedwesten", ROOM "weg-e6" );
  AddExit( "osten",      ROOM "weg-g5" );
}

string detail_erfahrung(string str)
{
  string erf;
  int i;

  i = TP->QueryProp(P_XP);

  if      (i <     1000) erf="Du bist noch sehr unerfahren.";
  else if (i <    10000) erf="Du bist sehr wenig erfahren.";
  else if (i <    50000) erf="Du bist wenig erfahren.";
  else if (i <   100000) erf="Deine Erfahrung ist schon recht ordentlich.";
  else if (i <   500000) erf="Deine Erfahrung ist praechtig.";
  else if (i <  1000000) erf="Deine Erfahrung ist gut.";
  else if (i <  5000000) erf="Deine Erfahrung ist sehr gut.";
  else if (i < 10000000) erf="Deine Erfahrung ist unglaublich gut.";
  else if (i < 20000000) erf="Deine Erfahrung ist mit Wenigen zu messen.";
  else if (i < 30000000) erf="Deine Erfahrung ist meisterhaft.";
  else                   erf="Deine Erfahrung ist perfekt.";

  return erf+"\n";
}

string detail_spitze(string str)
{
  string s;

  if((s = DisplayRunes(TP)) == "")
  {
    s = BS("Der Steinblock steht zwar in einer Senke. Aber was jetzt "
           "genau auf den Steinblock eingraviert wurde, kannst Du leider "
           "nicht erkennen.");
  }

  return s;
}

