#include "../def.h"

inherit ROOM "inh-wegblock";

#define DA 1
#define WEG 0

int aal;

void create()
{
  ::create();

  aal      = DA;
  thisroom = 3;

  SetProp(P_INT_SHORT, "Marktplatz von Dhrkion" );
  SetProp(P_INT_LONG,
    "Auf dem westlichsten Teil des Marktplatzes haben ein paar Haendler "
    "ihre Waren auf kleinen Decken ausgebreitet und bieten sie zum Verkauf "
    "an. Viele Stimmen gelangen aus dem ungewoehnlichen Holzhaus im Westen. "
    "Eine definierte Mitte im Osten hat der Marktplatz nicht. Denn dort "
    "steht das auffaelligste Bauwerk ganz Dhrkion: ein riesiger Tempel. "
    "Genau mittig steht hier weiterhin ein kleiner Steinblock."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "steinblock","block" }),
    "Der Steinblock steht hier genau in der Mitte und niemand traut sich "
    "seine Waren in dessen Naehe anzubieten. Er ist ein wenig hoeher als Du "
    "und hat anscheinend ein paar seltsame Zeichen eingraviert.");

  AddDetail( ({ "stelle" }),
    "Du kannst eine Rune an einer Stelle einfuegen. Aber keine Stelle "
    "faellt Dir besonders auf.");

  AddDetail( ({ "naehe" }),
    "Jeder haelt einen gewissen Abstand zu dem Steinblock.");

  AddDetail( ({ "abstand","meter" }),
    "Naja, ein paar Meter sind es, mehr nicht.");

  AddDetail( ({ "aura" }),
    "Eine wirklich maechtige Aura umgibt den Tempel. Aber eigentlich kann "
    "man sie nur spueren und nicht sehen.");

  AddDetail( ({ "dunkelelfen" }),
    "Viele Dunkelelfen treiben hier Handel und sind recht vergnuegt dabei."
  );

  AddDetail( ({ "bauwerk","tempel" }),
    "Der Tempel sticht Dir wirklich ins Auge *pieks*. Er geht bis ueber "
    "die Decke koennte man denken. Und er strahlt auch eine heilige Aura "
    "aus. Von hier aus kannst Du ihn leider nicht betreten.");

  AddDetail( ({ "auge" }),
    "Naja, ist nochmal gut gegangen und Dein Auge ist noch ganz ;)");

  AddDetail( ({ "decke","ende" }),
    "Du kannst das Ende der Decke nicht sehen. Selbst der Tempel "
    "verschwindet einfach so im Dunkeln.");

  AddDetail( ({ "dunkel","dunkelheit" }),
    "Eigentlich ist es ueberall in Dhrkion duster. Nur hier auf dem "
    "Marktplatz ist es seltsamerweise taghell.");

  AddDetail( ({ "wand","waende" }),
    "Die Waende des Holzhauses sind aus Holz und die der Tempel sind aus "
    "Fels."
  );

  AddDetail( ({ "fels","felsgestein" }),
    "Das ist ganz normales Felsgestein. Ein wenig dunkler als normal. Aber "
    "das stoert nicht weiter.");

  AddDetail( ({ "holzhaus","haus" }),
    "Das Holzhaus faellt Dir deshalb besonders auf, weil sonst alle "
    "Bauten in Hoehlen oder Erhebungen gebaut worden sind. Aus dem "
    "Haus steigt ein wenig Rauch auf und es riecht angenehm.");

  AddDetail( ({ "rauch" }),
    "Der Rauch kommt aus dem Holzhaus im Westen und verbreitet einen "
    "angenehmen Geruch.");

  AddDetail( ({ "geruch" }),
    "Hmmmm. Lecker.");

  AddDetail( ({ "erhebungen" }),
    "Du kannst hier keine Erhebungen erkennen.");

  AddDetail( ({ "hoehlen" }),
    "Du stehst zwar in einer riesigen Hoehle, aber kleine Hoehlen in dieser "
    "Hoehle siehst Du hier nicht.");

  AddDetail( ({ "hoehle" }),
    "Ganz Dhrkion ist in eine grosse Hoehle gebaut worden.");

  AddDetail( ({ "dhrkion","stadt" }),
    "Du bist in der Dunkelelfen-stadt Dhrkion und stehst auf dem "
    "Marktplatz."
  );

  AddDetail( ({ "holz" }),
    "Das ist ganz normales Holz.");

  AddDetail( ({ "bauten" }),
    "Na das sind die anderen Bauten. Du kannst von hier nur den Tempel "
    "im Osten sehen. Aber der faellt wirklich auf.");

  AddDetail( ({ "decken" }),
    "Auf kleinen Decken haben die Haendler ihre Waren ausgebreitet, damit "
    "sie nicht schmutzig werden. Allerdings faellt Dir auf, dass der Boden "
    "ueberhaupt nicht dreckig ist.");

  AddDetail( ({ "boden" }),
    "Auf dem Boden haben die Haendler ihre Waren auf Decken gelegt. In der "
    "Mitte steht hier ein kleiner Steinblock. Am Rande des Marktplatzes "
    "kannst Du ein Loch erkennen."); //Martkplatzes -> Marktplatzes | Malar 2004

  AddDetail( ({ "loch" }),
    "Das Loch fuehrt tief hinab, eine steile Treppe verschwindet in der "
    "Dunkelheit.");

  AddDetail( ({ "treppe" }),
    "Eine steile Treppe fuehrt hinab in die Dunkelheit. Du kannst hinunter "
    "steigen. Wenn Du Dich trauen solltest.");

  AddDetail( ({ "mitte" }),
    "Na was eine Mitte ist, weisst Du ja wohl.");

  AddDetail( ({ "teil" }),
    "Du bist ganz im Westen des Marktplatzes. Hier treibt man regen "
    "Handel."
  );

  AddDetail( ({ "marktplatz" }),
    "Auf diesem Teil des Marktplatzes treibt man regen Handel. Viele "
    "Haendler haben ihre Waren ausgebreitet und bieten sie zum Verkauf an."
  );

  AddDetail( ({ "verkauf" }),
    "Der Verkauf scheint wirklich gut zu gehen. Allerdings kannst Du hier "
    "nicht viel erwerben, da Du keine Genehmigung fuer den Handel hast.");

  AddDetail( ({ "genehmigung" }),
    "Die wirst Du wohl auch nie bekommen.");

  AddDetail( ({ "waren" }),
    "Die Haendler bieten hier wirklich alles moegliche an. Von Aal bis "
    "Zuber ist fast alles zu bekommen.");

  AddDetail( ({ "aal","weile" }),
    "Du suchst eine Weile nach einem Aal und siehe da, ein alter, "
    "stinkender Aal wird tatsaechlich angeboten.");

  AddDetail( ({ "zuber" }),
    "Du suchst und suchst. Aber leider hat kein Haendler einen dabei.");

  AddDetail( ({ "haendler" }),
    "Alle Haendler sind Dunkelelfen und bieten auf ihren Decken viele "
    "verschiedene Waren an.");

  AddDetail( ({ "handel" }),
    "Der Handel blueht wirklich. Viele Geschaefte macht man hier.");

  AddDetail( ({ "geschaefte","geschaeft" }),
    "Das sind mal gute aber auch mal schlechte Geschaefte.");

  AddDetail( ({ "stimmen" }),
    "Die Stimmen kommen aus dem Holzhaus. Sehen kann man sie aber nicht.");

  AddDetail( ({ "ohr" }),
    "Du fasst Dir an Dein Ohr. Ein der Dunkelelfen sieht es und schaut "
    "Dich verwundert an. Aber es scheint noch da zu sein.");

  AddDetail( ({ "schnaps" }),
    "Hier kannst Du keinen Schnaps sehen.");

  AddDetail( ({ "essen" }),
    "Hier riecht es zwar nach Essen. Aber sehen kannst Du keines.");

  AddSound( DEFAULT_SOUND,
    "Laute Stimmen aus der im Westen liegenden Holzhaus und der rege Handel "
    "dringen an Dein Ohr.");

  AddSound( "stimmen",
    "Man scheint sich bei einem kleinen Schnaps aufgeregt zu unterhalten."
  );

  AddSound( ({ "handel","dunkelelfen","elfen" }) ,
    "Ein paar Dunkelelfen verhandeln lautstark miteinander.");

  AddSmell( DEFAULT_SMELL,
    "Der Geruch von frisch zubereitetem Essen kommt aus dem Westen.");

  AddSmell( "essen",
    "Das Essen riecht einfach nur gigantisch gut und ueberstroemt den "
    "gesamten Marktplatz.");

  AddItem(NPC "drow", REFRESH_DESTRUCT);

  AddCmd( ({ "kauf","kaufe" }) ,        "cmd_kaufen" );
  AddCmd( ({ "spuer","spuere" }) ,      "cmd_spueren");
  AddCmd( ({ "steig","steige" }) ,      "cmd_steigen");

  AddSpecialDetail( ({ "zeichen","gravur" }),    "detail_zeichen");

  AddExit( "nordwesten", ROOM "weg-c4" );
  AddExit( "nordosten",  ROOM "weg-e4" );
  AddExit( "suedosten",  ROOM "weg-e6" );
  AddExit( "westen",     ROOM "kneipe" );
}

void reset()
{
  ::reset();

  aal = DA;
}

int cmd_spueren(string str)
{
  notify_fail("Was moechtest Du spueren?\n");

  if(!str || str == 0) return 0;
  if(str != "aura")    return 0;

  tell_object(TP, BS("Du nimmst Dir einen Augenblick Ruhe und versuchst "
                     "die Aura zu spueren. Und tatsaechlich. Du spuerst "
                     "in Dir eine leichte Waerme und eine sehr starke "
                     "Aura." ));

  return 1;
}

int cmd_kaufen(string str)
{
  notify_fail("Was moechtest Du kaufen?\n");

  if(!str || str == "") return 0;
  if(str != "aal")      return 0;

  if(aal == DA)
  {
    tell_object(TP, BS("Du kaufst einen der stinkenden Aale und isst ihn "
                       "auf. Er riecht zwar nicht sehr gut. Aber schmecken "
                       "tut er noch hervorragend." ));

    aal = WEG;
    TP->heal_self(50+random(10));

    return 1;
  }

  tell_object(TP, BS("Alle Aale sehen nicht mehr besonders lecker aus. "
                     "Du laesst lieber die Finger davon. Nachher sind sie "
                     "noch giftig." ));

  return -1;
}

string detail_zeichen(string str)
{
  string s;

  if((s = DisplayRunes(TP)) == "")
  {
    s = BS("Du versuchst Dir die Zeichen naeher anzusehen. Doch einer "
           "der Dunkelelfen hindert Dich daran und Du kannst nichts "
           "erkennen.");
  }

  return s;
}

int cmd_steigen(string str)
{
  notify_fail("Was moechtest Du hinuntersteigen?\n");

  if(!str || str == "") return 0;
  if(!(str == "treppe hinab"            ||
       str == "treppe hinunter"         ||
       str == "treppe runter"           ||
       str == "treppe herunter"         )) return 0;


  TP->move(ROOM "tunnel3",M_GO,"","verschwindet in einem Loch im Boden",
           "kommt die Treppe hinunter");
  return 1;
}


