#include "../def.h"

inherit "std/room";

#define SDMASTER "/obj/sehertormaster"
#define P_SEERDOOR_DISCOVER "rw_sehertor_disc"

int *button,*hebel;

void create()
{
  ::create();

  button = ({ 0,0,0,0,0,0,0 });
  hebel  = ({ 0,0,0,0,0,0,0 });

  SetProp( P_INT_SHORT, "Eine kleine Hoehle" );
  SetProp( P_INT_LONG,
    "In dieser Hoehle faellt Dir sofort die grosse Platte in der Nordwand "
    "auf. Der Rest der Hoehle liegt tief im Dunkeln versteckt. Ein paar "
    "Steine und Spuren sind auf dem Boden zu erkennen."
  );

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddSpecialDetail( ({ "platte" }), "detail_platte");

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "nordwand" }),
    "In der Nordwand ist eine riesige Platte."
  );

  AddDetail( ({ "rest" }),
    "Dort ist es viel zu dunkel und auch voellig uninteressant."
  );

  AddDetail( ({ "dunkel","dunkeln" }),
    "Selbst mit Deinen Augen findet sich dort nichts."
  );

  AddDetail( ({ "augen","auge" }),
    "Du kannst Deine Augen noch so sehr anstrengen. Dort ist einfach "
    "nichts."
  );

  AddDetail( ({ "steine","stein" }),
    "Die sind wohl von der Decke gefallen und liegen jetzt auf dem Boden."
  );

  AddDetail( ({ "decke" }),
    "Die Decke ist recht hoch. Sie scheint ein wenig bruechig, aber "
    "noch stabil."
  );

  AddDetail( ({ "spur","spuren" }),
    "Du kannst hier viele Spuren sehen. Komisch. Hier muessen viele Leute "
    "vorbeigekommen sein."
  );

  AddDetail( ({ "leute" }),
    "Na Leute wie Du halt. Irgendwas hat Dich ja auch hierher gebracht."
  );

  AddDetail( ({ "wand","waende" }),
    "Die Waende sind aus normalem Fels. Bis auf die Nordwand faellt Dir "
    "nichts Besonderes auf."
  );

  AddDetail( ({ "boden" }),
    "Auf dem felsigen Boden liegen nur ein paar Steine und es finden sich "
    "viele Spuren."
  );

  AddDetail( ({ "fels" }),
    "Harter Fels. Undurchdringlich."
  );

  AddSound( DEFAULT_SOUND,
    "Hier ist es sehr ruhig."
  );

  AddSmell( DEFAULT_SMELL,
    "Du kannst hier nichts riechen."
  );

  AddItem("/obj/sehertor", REFRESH_REMOVE, ([P_SEERDOOR_DISCOVER: 0]) );

  AddCmd( ({ "dreh","drehe" }) , "cmd_drehen" );

  AddExit("nordwesten", ROOM "wall-d10");
  AddExit("nordosten" , ROOM "wall-f10");
}

int checkbutton()
{
  if(button[1]==1 && button[2]==1 && button[3]==1 &&
     button[4]==1 && button[5]==1 && button[6]==1) return 1;

  return 0;
}

int checkhebel()
{
  if(hebel[1]==1 && hebel[2]==1 && hebel[3]==1 &&
     hebel[4]==1 && hebel[5]==1 && hebel[6]==1) return 1;

  return 0;
}

string detail_platte()
{

  write("    __________    \n");
  write("   |          |   \n");

  if (hebel[1]==1)  write("   ---");

  else write(" ---  ");

  if (button[1]==1) write(" X  ");

  else write(" O  ");

  if (button[2]==1) write("X ");

  else write("O ");

  if (hebel[2]==1)  write("---  ");

  else write("  ---");

  write("\n   |          |   \n");

  if (hebel[3]==1)  write("   ---");

  else write(" ---  ");

  if (button[3]==1) write(" X  ");

  else write(" O  ");

  if (button[4]==1) write("X ");

  else write("O ");

  if (hebel[4]==1)  write("---  ");

  else write("  ---");

  write("\n   |          |   \n");

  if (hebel[5]==1)  write("   ---");

  else write(" ---  ");

  if (button[5]==1) write(" X  ");

  else write(" O  ");

  if (button[6]==1) write("X ");

  else write("O ");

  if (hebel[6]==1)  write("---  ");

  else write("  ---");

  write("\n   |__________|   \n");

  if (checkbutton() && checkhebel())
  {
    write("Die Platte laesst sich jetzt vielleicht drehen.\n");
  }

  return "\n";
}

void setz()
{
  button = ({ 0,1,1,1,1,1,1 });
  hebel  = ({ 0,1,1,1,1,1,1 });
}

int changebutton(int i)
{
  button[i] = 1 - button[i];

  return checkbutton();
}

int changehebel(int i)
{
  hebel[i] = 1 - hebel[i];

  return checkhebel();
}

int cmd_drehen(string str)
{
  if(!checkbutton()) return 0;
  if(!checkhebel())  return 0;

  notify_fail("Was willst Du drehen?\n");

  if(!str || str == "") return 0;
  if(str != "platte" )  return 0;

  write("Du drehst die Platte herum und ...\n");

  if(IS_SEER(TP))
  {
    if (SDMASTER->DiscoverDoor(ROOM "wall-e11") )
    {
      write("... ploetzlich siehst Du ein Sehertor vor Dir.\n");
      write_file(LOG "sehertor",
        ctime()+": "+CAP(getuid(PL))+" entdeckt das Sehertor in Dhrkion.\n");
    }
    else
    {
      write("... Du denkst . o O ( Ich Wurstseher, dass kannste ich doch "
            "schon )\n");
    }

  }
  else
  {
    write(BS("... eine innere Stimme sagt Dir, dass Du spaeter mit viel "
             "mehr Erfahrung nochmal herschauen solltest. Denn hier "
             "verbirgt sich ein grosses Geheimnis.\n"));
  }

  write("Ein Rumpeln geht durch den Raum und die Platte dreht sich "
        "zurueck.\n");

  button=({ 0,0,0,0,0,0,0 });
  hebel= ({ 0,0,0,0,0,0,0 });

  return 1;
}

int _query_tport_cost_in()
{
  int bonus, align;

  if(!TP)              return 0;
  if(!interactive(TP)) return 0;

  bonus = 0;

  if(TP->QueryProp(P_RACE)  == "Dunkelelf") bonus -= 2;

  if(TP->QueryProp(P_GUILD) == "paladine")  bonus += 2;

  align = TP->QueryProp(P_ALIGN);
  if(align < -1000) align = -1000;
  if(align >  1000) align =  1000;
  bonus += align*8/2000;

  return bonus;
}

int _query_tport_cost_out()
{
  int bonus, align;

  if(!TP)              return 0;
  if(!interactive(TP)) return 0;

  bonus = 0;

  if(TP->QueryProp(P_RACE)  == "Dunkelelf") bonus -= 2;

  if(TP->QueryProp(P_GUILD) == "paladine")  bonus += 2;

  align = TP->QueryProp(P_ALIGN);
  if(align < -1000) align = -1000;
  if(align >  1000) align =  1000;
  bonus += align*8/2000;

  return bonus;
}



