
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int genommen;

reset() {
  ::reset();
  genommen=0;
}

create() {
  ::create();

  genommen=0;

  SetProp( P_INT_SHORT, "Eine kleine Hoehle" );
  SetProp( P_INT_LONG,
    "Dieser Hoehlenabschnitt ist fast komplett eingestuerzt. Viele Steine "
    "und Felsbrocken liegen am Boden. Die Decke ist hier sehr hoch. Du musst "
    "schon vorsichtig gehen hier, sonst verletzt Du Dich noch." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle","hoehlenabschnitt","abschnitt" }),
    QueryProp(P_INT_LONG));

  AddDetail( ({ "steine" }),
    "Viele Steine liegen hier am Boden herum. Einer faellt Dir besonders auf.");

  AddDetail( ({ "stein" }),
    "Der Stein sagt: Lass mich ja liegen!!\nDu erschrickst fuerchterlich.");

  AddDetail( ({ "fels" }),
    "Das ist harter, dunkler Fels.");

  AddDetail( ({ "felsbrocken","brocken" }),
    "Die sind wohl aus der Decke herausgebrochen.");

  AddDetail( ({ "decke" }),
    "Die Decke ist zum groessten Teil eingestuerzt.");

  AddDetail( ({ "teil" }),
    "Viel ist von der Decke nicht mehr nach. Ein riesges Loch gaehnt in "
    "ihr.");

  AddDetail( ({ "loch" }),
    "Das Loch in der Decke ist riesig und reicht viel weiter, als Dein "
    "Auge sehen kann nach oben weg.");

  AddDetail( ({ "auge","schwein" }),
    "Uff, noch da. Schwein gehabt.");

  AddDetail( ({ "wand","waende" }),
    "Die Waende sehen noch sehr stabil aus. Aus ihnen sind wohl noch "
    "keine Brocken herausgebrochen.");

  AddDetail( ({ "boden" }),
    "Der Boden ist voll von Steinen und Felsbrocken.");

  AddSound( DEFAULT_SOUND,
    "Aus dem Suedosten hoerst Du Schritte.");
    
  AddSound( ({ "schritt","schritte" }) ,
    "Du musst schon hingehen um mehr zu sehen.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach frischer Luft.");

  AddSmell( "luft",
    "Durch die Decke stroemt frische Luft herein. Es riecht angenehm.");

  AddSpecialDetail( "hebel","hebel");

  AddCmd( ({ "nimm","nehm","nehme" }) , "nimmfkt" );
  AddCmd( ({ "zieh","ziehe" }) , "ziehfkt" );

SetProp( P_HIDE_EXITS, ({ "vorne" }) );
  AddExit( "nordosten", "./wall-e9" );
  AddExit( "suedosten", "./wall-e11" );
}

int nimmfkt(string str) {
  if (genommen==1) return 0;
  if (str != "stein") return 0;
  genommen=1;
  write(BS(
    "Du versuchst den Stein zu nehmen. Doch er beisst Dir sofort in Deine "
    "Hand. Bei dem Versuch sie zurueckzuziehen, streifst Du auf einmal "
    "ein paar Hebel mit Deiner Hand."));
  return 1;
}

string hebel() {
  if (genommen==0) return 0;
  return BS(
    "Du kannst hier acht Hebel sehen.");
}

int ziehfkt(string str) {
  string was;
  int nummer;
  nummer=0;
  was="";
  if (genommen==0) return 0;
  notify_fail("Was willst Du ziehen?\n");
  if (!str) return 0;
  notify_fail("Welchen Hebel willst Du ziehen?\n");
  if (str == "hebel") return 0;
  notify_fail("Was willst Du ziehen?\n");
  if (sscanf(str,"%s %d",was,nummer) != 2) return 0;
  if (was != "hebel") return 0;
  notify_fail("Welchen hebel willst Du ziehen?\n");
  if ( nummer<1 || nummer>8 ) return 0;
  write("Du ziehst den "+nummer+". Hebel.\n");

  switch (nummer) {
    case 1: call_other( ROOM "wall-e11" , "changehebel" , 1);
            call_other( ROOM "wall-e11" , "changehebel" , 3);
            break;
    case 2: call_other( ROOM "wall-e11" , "changehebel" , 4);
            call_other( ROOM "wall-e11" , "changehebel" , 6);
            break;
    case 3: call_other( ROOM "wall-e11" , "changehebel" , 1);
            call_other( ROOM "wall-e11" , "changehebel" , 5);
            break;
    case 4: call_other( ROOM "wall-e11" , "changehebel" , 3);
            call_other( ROOM "wall-e11" , "changehebel" , 4);
            break;
    case 5: call_other( ROOM "wall-e11" , "changehebel" , 2);
            call_other( ROOM "wall-e11" , "changehebel" , 4);
            break;
    case 6: call_other( ROOM "wall-e11" , "changehebel" , 2);
            call_other( ROOM "wall-e11" , "changehebel" , 3);
            break;
    case 7: call_other( ROOM "wall-e11" , "changehebel" , 4);
            call_other( ROOM "wall-e11" , "changehebel" , 5);
            break;
    case 8: call_other( ROOM "wall-e11" , "changehebel" , 5);
            call_other( ROOM "wall-e11" , "changehebel" , 6);
            break;
    default: write("BUUUUUUUUUUUUG :(((((((\n");
             break;
  }
  return 1;
}
