/*

  Inherit fuer den Schutzwall der Dunkelelfenstadt - Dhrkion Zordan@SL

*/

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

#include "wall.h"

void insertprop(string str);
string *details,richtung,langadd;

create() {
  int i,nr;
  string lang,str;
  mapping map;
  ::create();
  lang="";
//  richtung="";
//  langadd="";
  details=({ });
  SetProp( P_INT_SHORT, "An einem Schutzwall" );
  SetProp( P_LIGHT,   0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 25+random(5), ENV_TERRAIN: TT_CAVE]) );

  for(i=1;i<=4;i++) {
    nr=random(3)+1;
    switch(i) {
      case 1: map=DET_LANG1; break;
      case 2: map=DET_LANG2; break;
      case 3: map=DET_LANG3; break;
      case 4: map=DET_LANG4; break;
    }
    lang+=map[nr];
    if ((str=map[nr,1]) != "") insertprop(str);
    if ((str=map[nr,2]) != "") insertprop(str);
    if ((str=map[nr,3]) != "") insertprop(str);
  }
  if (langadd != 0) { lang+=langadd; }
  SetProp(P_INT_LONG, lang);

  AddSmell( ({ DEFAULT_SMELL }),
    "Ein leicht modriger Geruch dringt von ueberall auf Dich ein. Aus "
    "Richtung des Schutzwalles kommt der Geruch von Essen." );

  AddSmell( ({ "geruch" }),
    "Genauer spezifizieren kannst Du den Geruch von hier aus nicht." );

  AddSmell( ({ "moder" }),
    "Ih, das riecht nicht gut." );

  AddSmell( ({ "essen" }),
    "Es riecht koestlich. Aber Du musst schon hinter den Schutzwall gehen, "
    "um mehr zu erfahren oder gar zu kosten." );

  AddSound( ({ DEFAULT_SOUND }),
    "Leises Knirschen unter Deinen Schuhen und sehr leise Stimmen hinter "
    "dem Schutzwall kannst Du hoeren." );

  AddSound( ({ "knirschen" }),
    "Das Knirschen unter Deinen Schuhen kommt von den kleinen Kieselsteinen, "
    "die hier ueberall herumliegen." );

  AddSound( ({ "stimmen" }),
    "Reger Betrieb scheint hinter dem Schutzwall zu herrschen. Von hier aus "
    "kannst Du aber nichts erkennen." );

  AddDetail( ({ "schutzwall","wall" }),
    "Im "+CAP(richtung)+" baut sich vor Dir ein gigantischer Schutzwall auf. "
    "Er ist zu hoch, um ueber ihn drueber zu klettern und besteht aus "
    "massiven Felsen und dicken Steinen. Auf dem Schutzwall selber kann "
    "man wohl nicht stehen, da er nach oben spitz zulaeuft." );

  AddDetail( ({ "fels","felsen" }),
    "Die Felsen sind aus nicht ganz normalen Stein, wie Du sofort erkennen "
    "kannst. Sie sind so hart, dass sie wohl niemals nachgeben wuerden. " );

  AddDetail( ({ "stein","steine" }),
    "Wie solch harte Steine ueberhaupt entstehen koennen, kannst Du Dir "
    "echt nicht vorstellen. Nichts wuerde sie jemals spalten koennen." );

  AddDetail( ({ richtung }),
    "Im "+CAP(richtung)+" ist der Schutzwall." );

  AddDetail( ({ "stadt","dhrkion" }),
    "Von hier aus kannst Du nicht viel von der Stadt erkennen. Das einzige "
    "was Du schemenhaft erkennen kannst, ist ein riesiges Gebilde mitten "
    "in der Stadt, welches bis an die Decke zu reichen scheint." );

  AddDetail( ({ "gebilde" }),
    "Das Gebilde ist zu weit entfernt, als dass Du mehr sehen "
    "koenntest. Aber es wirklich riesig und faellt sehr auf." );

  AddDetail( ({ "detail","bla" }),
    "Bla Bla bla bl bl allbla blla blal." );

  AddDetail( ({ "zordan","schelm","vogel" }),
    "Ein kleiner Schelm erscheint und zeigt Dir einen Vogel ;)" );

  AddDetail( ({ "kieselsteine","kieselstein" }),
    "Kleine Kieselsteine liegen auf dem Boden. Sie sind leicht dunkel, "
    "zeigen aber sonst nichts besonderes." );
}

void insertprop(string str) {
  string str2,temp;
  mapping map;
  int nr;
  if (member_array(str,details) != -1) return;
  if (str == "") return;
  map=DET_ALL1;
  if (!stringp(map[str])) map=DET_ALL2;
  if (!stringp(map[str])) return;
  nr=random(3);
  details+=({ str });
  AddDetail( str , map[str,nr] );
  if ((str2=map[str,3]) != "") insertprop(str2);
  if ((str2=map[str,4]) != "") insertprop(str2);
  if ((str2=map[str,5]) != "") insertprop(str2);
}
