#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Tunnel aus Dhrkion" );
  SetProp( P_INT_LONG,
    "Du findest Dich in einem engen Tunnel. Boden, Decke und Waende "
    "bestehen aus dunklem, rauhen Fels. Im Suedwesten versperrt ein Netz "
    "aus dicken, verworrenen Spinnweben den Weg. ");

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30+random(5), ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "suedwesten", "tunnel", "weg" }),
    "Im Suedwesten wird der Tunnel durch ein Netz versperrt."
  );

  ADD_DROW_DETAIL( ({ "netz", "spinnweben", "luecke", "durchkommen" }),
    "Du findest nicht die kleinste Luecke in diesem Netz. Hier ist fuer "
    "Dich kein Durchkommen."
    ,
    "Obwohl Du nicht die kleinste Luecke in diesem Netz findest, bist Du "
    "Dir ziemlich sicher, dass Du das Netz vorsichtig beiseite schieben "
    "und durchschluepfen koenntest. "
  );

  AddDetail( ({ "boden", "decke", "wand", "waende" }),
    "Boden, Decke und Waende des Tunnels bestehen aus dunklem, rauhen Fels."
  );

  AddDetail( ({ "fels" }),
    "Der Tunnel wurde in den natuerlichen Fels geschlagen."
  );

  AddExit( "norden", ROOM "tunnel3" );

  AddCmd( ({"schieb","schiebe"})     , "cmd_schieben");
  AddCmd( ({"schluepf","schluepfe"}) , "cmd_schluepfen");
}

void webcheck(object pl)
{
  if(pl->QueryProp(P_RACE) != "Dunkelelf")
  {
    tell_object(pl,"Du kommst durch dieses Netz nicht hindurch!\n");
    tell_room(TO,BS(pl->name(WER) + " versucht vergeblich, "
                 " sich durch das Netz zu zwaengen."), ({pl}) );
    return;
  }

  if(DHRKIONMASTER->checkfeind(pl))
  {
    tell_object(pl,"Die Spinnen in dem Netz zischen Dich an und Du "
                   "schreckst zurueck.\n");
    tell_room(TO,pl->Name(WER)+" erschrickt auf einmal.\n", ({pl}) );
    return;
  }

  pl->move(ROOM "tunnel1",M_GO,"","schluepft durch das Spinnennetz",
           "kommt durch das Spinnennetz durchgeschlueoft");
  return;
}

int cmd_schluepfen(string str)
{
  notify_fail("Wodurch moechtest Du schluepfen?\n");

  if(!str || str == "") return 0;
  if(!(str == "durch netz"                  ||
       str == "durch spinnennetz"           ||
       str == "durch spinnweben"            ||
       str == "durch netz durch"            ||
       str == "durch spinnennetz durch"     ||
       str == "durch spinnweben durch"      ||
       str == "durch netz hindurch"         ||
       str == "durch spinnennetz hindurch"  ||
       str == "durch spinnweben hindurch"   )) return 0;

  webcheck(TP);
  return 1;
}

int cmd_schieben(string str)
{
  notify_fail("Was moechtest Du beiseite schieben?\n");

  if(!str || str == "") return 0;
  if(!(str == "netz zur seite"         ||
       str == "netz beiseite"          ||
       str == "spinnennetz zur seite"  ||
       str == "spinnennetz beiseite"   ||
       str == "spinnweben zur seite"   ||
       str == "spinnweben beiseite"    )) return 0;

  webcheck(TP);
  return 1;
}

