#include "../def.h"

inherit ROOM "rothe_inh.lpc";

void create()
{
  ::create();

  AddDetail( ({ "gestein" }), GetDetail("gestein")[0..<2]+
    " Ein dunkler Fleck faellt Dir auf.");

  AddDetail( ({ "fleck" }),
    "Der kleine Fleck entpuppt sich vor Dir als kleine Oeffnung." );

  AddDetail(({ "oeffnung" }),
    "Die Oeffnung ist leider zu klein, als das Du mit der Hand reingreifen "
    "koenntest." );

  AddDetail(({ "meinung" }),
    "Wenn Du nicht dieser Meinung bist, kannst Du ja auch wieder "
    "gehen :)" );

  AddDetail(({ "hand" }),
    "Du schaust Dir noch einmal Deine Hand und die Oeffnung an. Nein, "
    "sie passt wirklich nicht hinein. Trotzdem bist Du der Meinung, dass "
    "man sicher etwas aus dieser Oeffnung fischen koennte." );

  AddItem( NPC "rothe", REFRESH_DESTRUCT);
  AddItem( NPC "sklave1", REFRESH_DESTRUCT);

  AddExit( "westen"   , ROOM "rothe-h9"  );
  AddExit( "sueden"  ,  ROOM "rothe-i10" );

  AddCmd( ({"angel","angle"})  , "cmd_angeln");
  AddCmd( ({"greif","greife"}) , "cmd_greifen");
}

//--------------------------------------------------------------------------
// Runenquest -> 4. Ort wo eine Rune sein kann
//--------------------------------------------------------------------------

int cmd_angeln(string str)
{
  string s;
  object ob;

  notify_fail("Mit was moechtest Du wo angeln?\n");

  if(!str || str == "") return 0;
  if(!(str == "mit angel in oeffnung")) return 0;

  if(!(ob = present("angel",TP)))
  {
    tell_object(TP, "Schelm Du. Du hast ja gar keine Angel.\n");
    return -1;
  }

  if(ob != TP->QueryProp(P_WEAPON))
  {
    tell_object(TP, "Du solltest die Angel schon in die Hand nehmen.\n");
    return -1;
  }

  if(random(5))
  {
    tell_object(TP, BS("Du angelst eine Weile in der Oeffnung herum. Auf "
                       "einmal spuerst Du einen Widerstand und ziehst die "
                       "Angel wieder heraus. Doch auf dem Weg aus der "
                       "Oeffnung heraus laesst der Widerstand auf einmal "
                       "nach." ));
    return -1;
  }

  switch(RUNENMASTER->GetRune(getuuid(TP), 4))
  {
    case 1:
      s = "Du angelst eine Weile in der Oeffnung herum. Auf einmal spuerst "
          "Du einen Widerstand und ziehst die Angel wieder heraus. Du hast "
          "eine kleine Rune gefunden.";
      break;

    case -1:
      s = "Du angelst eine Weile in der Oeffnung herum. Auf einmal spuerst "
          "Du einen Widerstand und ziehst die Angel wieder heraus. Doch "
          "gerade als Du den Gegenstand nehmen willst wird Dir alles zu "
          "schwert und der Gegenstand kullert wieder in die Oeffnung. ";
      break;

    default:
      s = "Du angelst eine Weile in der Oeffnung herum. Auf einmal "
          "spuerst Du einen Widerstand und ziehst die Angel wieder "
          "heraus. Doch auf dem Weg aus der Oeffnung heraus laesst der "
          "Widerstand auf einmal nach.";
      break;
  }


  tell_object(TP, BS(s));

  return 1;
}

int cmd_greifen(string str)
{
  notify_fail("In was moechtest Du greifen?\n");

  if(!str || str == "") return 0;
  if(!(str == "in oeffnung" ||
       str == "oeffnung"    )) return 0;

  tell_object(TP, BS("Deine Hand ist einfach zu gross um in die Oeffnung "
                     "zu greifen. Du solltest Dir einen Gegenstand suchen "
                     "und eventuell in der Oeffnung angeln oder so "
                     "aehnlich." ));
  return 1;
}
