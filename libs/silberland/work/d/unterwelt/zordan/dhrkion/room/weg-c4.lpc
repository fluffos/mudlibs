#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf der Hauptstrasse in Dhrkion" );
  SetProp( P_INT_LONG,
    "Du gehst weiter auf der Hauptstrasse in Dhrkion. Sie macht hier eine "
    "kleine Biegung in den Norden. Im Sueden steht ein kleines Gebaeude "
    "aus Holz. Viel weiter im Nordosten kannst Du einen prachtvollen Bau "
    "erahnen. Geschickt hat man die natuerliche Form der Felsen hier "
    "fuer eine sehr leicht begehbare Strasse genutzt."
  );

  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "wand","waende","sueden" }),
    "Im Sueden sind die Waende eines Gebaeudes zu sehen.");

  AddDetail( ({ "bau" }),
    "Der Bau uebertrifft alles andere hier. Es scheint ein sehr wichtiger "
    "Ort zu sein. Ueber die Hauptstrasse sollte man ihn irgendwie erreichen "
    "koennen.");

  AddDetail( ({ "ort","heiliges" }),
    "Der Ort strahlt bis hier etwas Heiliges aus.");//strahl + t Malar 2004

  AddDetail( ({ "form" }),
    "Die Strasse macht wohl genau deshalb eine Biegung hier. Man hat "
    "tatsaechlich die natuerlichen Ausdehnungen der Felsen genutzt und der "
    "Strasse genau diesen Verlauf gegeben.");

  AddDetail( ({ "ausdehnungen","ausdehnung" }),
    "Maechtig bauen sich die Felsen hier auf. Sie zu entfernen, damit die "
    "Strasse keine Biegung haette, wuerde eine Menge Schweiss hervorrufen.");

  AddDetail( ({ "menge" }),
    "Eine GROSSE Menge.");

  AddDetail( ({ "schweiss" }),
    "Mit Schweiss alleine wuerde man die Felsen natuerlich nicht entfernen "
    "koennen. Vielleicht koennte auch Magie dafuer sorgen. Aber wer weiss "
    "das schon...");

  AddDetail( ({ "magie" }),
    "Die Magie ist hier wohl allgegenwaertig.");

  AddDetail( ({ "decke" }),
    "Du kannst keine Decke sehen. Es ist einfach zu dunkel.");

  AddDetail( ({ "boden" }),
    "Auf dem Boden laeuft die Hauptstrasse weiter nach Westen und Osten. "
    "Ein kleines Schild wurde hier augestellt.");

  AddDetail( ({ "schild" }),
    "Das Schild besteht aus ganz normalem Holz.");

  AddDetail( ({ "osten","westen","norden","sueden" }),
    "Was mag das wohl sein? Streng Dich doch mal selber an.");

  AddDetail( ({ "biegung","verlauf" }),
    "Die Biegung geht vom Sueden in den Norden und dann zurueck in den "
    "Sueden.");

  AddDetail( ({ "gebaeude" }),
    "Das Gebaeude passt gar nicht so richtig in die Stadt, weil es als "
    "einziges aus Holz gebaut worden ist. Erreichen kannst Du es von hier "
    "aus aber nicht. Ein feiner Duft kommt aber bis hier aus dem Gebaeude "
    "heraus.");

  AddDetail( ({ "holz" }),
    "Ganz normales Holz wuerdest Du sagen. Allerdings ist es dunkelschwarz.");

  AddDetail( ({ "duft" }),
    "Den kannst Du nicht sehen, nur riechen!");

  AddDetail( ({ "hauptstrasse","strasse" }),
    "Die Hauptstrasse durchquert Dhrkion vom Westen nach Osten. Sie ist "
    "durch die vielen Jahre schon gut ausgetrammpelt. Richtig befestigt ist "
    "sie aber nicht. Der harte Fels sorgt fuer einen guten Untergrund.");

  AddDetail( ({ "dhrkion","stadt" }),
    "Du bist im Westen von Dhrkion. Viel zu sehen gibt es hier noch nicht.");

  AddDetail( ({ "jahre","jahr" }),
    "Wie alt Dhrkion genau ist kannst Du nicht abschaetzen. Aber uralt "
    "wuerdest Du schaetzen.");

  AddDetail( ({ "fels","felsen" }),
    "Der harte Fels ist ein wenig roetlich angehaucht. Woher das Rot "
    "kommt kannst Du aber zuerst nicht erkennen.");

  AddDetail( ({ "untergrund" }),
    "Der Untergrund besteht hier nur aus reinem, harten Fels.");

  AddDetail( ({ "rot" }),
    "Koennte es auch Blut sein? Sicher bist Du Dir da aber nicht.");

  AddDetail( ({ "blut" }),
    "Tatsaechlich. Blut ist auf dem Boden verteilt. Nicht viel, aber "
    "dennoch genug, dass Du es erkennen kannst. Ob man davon kosten kann?");

  AddReadDetail( ({ "schild" }),
    "Herzlich Willkommen in Dhrkion.");

  AddDetail( ({ "gegroehle" }),
    "Das kommt aus dem Sueden.");

  AddDetail( ({ "meinung","alkohol","spiel" }),
    "Bist Du immer der Meinung anderer? Vor allem wenn Alkohol im Spiel ist, "
    "kommt es oft zu Streit.");

  AddDetail( ({ "streit" }),
    "Fang hier unten bloss keinen an!");

  AddDetail( ({ "essen" }),
    "Du kannst hier kein Essen erkennen. Aber riechen...");

  AddDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "Lautes Gegroehle kommt aus dem Sueden.");

  AddSound( ({ "gegroehle" }),
    "Man scheint sich nicht einer Meinung zu sein. Alkohol ist wohl auch "
    "im Spiel.");

  AddSmell( ({ DEFAULT_SMELL , "duft" }) ,
    "Aus dem Sueden kommt der Duft von feinstem Essen herueber.");

  AddSmell( ({ "essen" }) ,
    "Du musst schon dorthin gehen, um davon zu kosten.");

  AddItem(NPC "spinne", REFRESH_DESTRUCT);

  AddCmd( "koste","cmd_kosten" );

  AddExit("suedwesten", ROOM "weg-b5" );
  AddExit("suedosten",  ROOM "weg-d5" );
}

int cmd_kosten(string str)
{
  notify_fail("Wovon moechtest Du kosten?\n");

  if(!str || str == "") return 0;
  if(!(str == "blut"         ||
       str == "vom blut"     ||
       str == "von dem blut" )) return 0;

  tell_object(TP, BS(
      "Du bueckst Dich nieder und kostest ein wenig von dem Blut. Es "
      "schmeckt ein wenig salzig und alt. Es scheint aber nicht von Tieren "
      "zu stammen, da bist Du Dir ziemlich sicher." ));

  return 1;
}
