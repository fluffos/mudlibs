#include "../def.h"

inherit ROOM "inh-gef";

int decken;

void create()
{
  ::create();

  decken=0;

  SetProp( P_INT_SHORT, "Eine Zelle" );
  SetProp( P_INT_LONG,
    "So eine finstere Zelle hast Du noch nie gesehen. Die Waende bestehen "
    "aus einem seltsamen Material, das jeden einzelnen Lichtstrahl aufzu"
    "saugen scheint. Das hier drei kleine Betten verteilt in der Zelle "
    "stehen, faellt Dir erst beim zweiten Blick auf. Ein kleiner Tisch mit "
    "drei Stuehlen steht derweil auf dem recht sauberen Boden herum. "
  );

  SetProp(P_LIGHT, -1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "zelle" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "kinder" }),
    "Diese Zelle ist fuer Kinder gemacht. Du faengst fuerchterlich an zu "
    "fluchen. Du koenntest ja versuchen, sie zu befreien."
  );

  AddDetail( ({ "decke" }),
    "Die Decke verschwindet doch tatsaechlich in der Dunkelheit."
  );

  AddDetail( ({ "dunkelheit" }),
    "Dort kannst Du wirklich nichts sehen!"
  );

  AddDetail( ({ "boden" }),
    "Der felsige Boden ist hier wirklich sauber."
  );

  AddDetail( ({ "stuehle","stuhl" }),
    "Winzige Stuehle, wie fuer Kinder gemacht, stehen um den Tisch herum."
  );

  AddDetail( ({ "tisch" }),
    "Ein kleiner Tisch aus Holz steht mitten in der Zelle. Er ist fuer Dich "
    "aber viel zu klein. Drei Stuehle sind um ihn verteilt aufgestellt "
    "worden."
  );

  AddDetail( ({ "blick" }),
    "Der erste Blick ging zu dem Tisch und den Stuehlen."
  );

  AddDetail( ({ "betten" }),
    "Die Betten sind viel zu klein fuer Dich. Sie sind aus Holz und haben "
    "sogar eine Matratze und kleine Decken."
  );

  AddDetail( ({ "holz" }),
    "Sehr dunkels Holz ist das. Du hast keine Ahnung, wo man das bekommen "
    "kann."
  );

  AddDetail( ({ "ahnung","details" }),
    "Hast Du ueberhaupt eine Ahnung, wie sinnlos es ist, solche Details "
    "zu untersuchen?"
  );

  AddDetail( ({ "decken" }),
    "Suesse, kleine Decken liegen auf den Betten. Sie sind nicht gemacht."
  );

  AddDetail( ({ "matratzen","matratze" }),
    "Saubere kleine Matratzen liegen auf den Betten. Sie wurden wohl noch "
    "vor kurzer Zeit benutzt."
  );

  AddDetail( ({ "zeit" }),
    "Das kann wirklich nicht lange her sein."
  );

  AddDetail( ({ "waende","wand" }),
    "Die Waende sind mit einem seltsamen Material uberzogen worden. Sie sind "
    "aber recht sauber. Nur ein paar Kritzeleien sind auf ihnen zu erkennen."
  );

  AddDetail( ({ "kritzeleien" }),
    "Kleine Bilder sind das wohl."
  );

  AddDetail( ({ "bilder","kindermalerei","malerei" }),
    "Die Bilder erinnern Dich an Kindermalerei."
  );

  AddDetail( ({ "material" }),
    "Du kannst das Material nicht genauer bestimmen. Aber es scheint so, als "
    "ob es jeden einzelnen Lichtstrahl aufsaugt."
  );

  AddDetail( ({ "lichtstrahl" }),
    "Jeder Lichtstrahl wird einfach so von den Waenden verschluckt."
  );

  AddSound( ({ DEFAULT_SOUND }),
    "Du bist zu ueberwaelltigt von dem Anblick und vermagst kein Geraeusch "
    "auseinanderzuhalten."
  );

  AddSmell( ({ DEFAULT_SMELL }),
    "Der Geruch verwesender Leichen ist hier deutlich zu riechen."
  );

  AddSmell( ({ "geruch","leichen","leiche" }),
    "Baeh stinkt das hier nur. Du haeltst Dir die Nase zu."
  );

  AddItem( NPC "kind", REFRESH_DESTRUCT);
  AddItem( NPC "kind", REFRESH_DESTRUCT);
  AddItem( NPC "kind", REFRESH_DESTRUCT);

  AddSpecialDetail( "decken","detail_decken");

  AddCmd( ({ "befreie","befrei" })    , "cmd_befreien" );
  AddCmd( ({ "mach","mache" })        , "cmd_machen" );
}

void reset()
{
  ::reset();

  decken=0;
}

int cmd_befreien(string str)
{
  object ob;

  notify_fail("Wen moechtest Du befreien?\n");

  if(!str || str == "") return 0;
  if(!(str == "kinder"     ||
       str == "die kinder" )) return 0;

  if(QueryThisDoor() == D_STATUS_CLOSED)
  {
    tell_object(TP,"Die Tuer ist aber geschlossen!\n");
    return -1;
  }

  if(!present("kind"))
  {
    tell_object(TP,"Welche Kinder denn?\n");
    return -1;
  }

  ob = present("kind");
  while(objectp(ob))
  {
    ob->remove();
    ob = present("kind");
  }

  tell_object(TP,BS("Du nimmst die Kinder an die Hand und bringst sie aus "
                    "dem Gefaengnis raus. Draussen rennen sie sofort weg "
                    "und Du kannst sie nicht einmal mehr sehen. Eines der "
                    "Kinder kommt aber zurueck und gibt Dir ein kleines "
                    "Kuesschen auf die Wange. Freudestraenen rinnen dem "
                    "Kind die Wange herunter. Danach rennt es dann auch "
                    "fuer immer weg. Du fuehlst Dich gut aufgrund dieser "
                   "Tat und gehst zurueck in die Zelle." ));
  return 1;
}

int cmd_machen(string str)
{
  notify_fail("Was moechtest Du machen?\n");
  if(!str || str == "") return 0;
  if(!(str == "decken" ||
       str == "bett"   )) return 0;

  if(decken == 0)
  {
    tell_object(TP,BS("Hoeflich wie Du bist schuettelst Du die Decken "
                      "einmal kraeftig durch und machst das Bett wieder "
                      "ordentlich."));
    tell_room(TP,BS(CAP_TPN+" nimmt die Decken und schuettelt sie kraeftig "
                    "durch."), ({ TP }) );
    decken = 1;
    return 1;
  }

  tell_object(TP,"Aber die Decken sind schon gemacht worden.\n");
  return -1;
}

string detail_decken(string str)
{
  string s;

  if(decken==0)
  {
    s = "Suesse, kleine Decken liegen auf den Betten. Sie sind nicht "
        "gemacht.";
  }
  else
  {
    s = "Suesse, kleine Decken liegen auf den Betten. Jemand hat sie wohl "
        "frisch gemacht.";
  }

  return BS(s);
}
