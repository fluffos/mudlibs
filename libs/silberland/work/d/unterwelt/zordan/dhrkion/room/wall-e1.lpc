/*
   Dhrkion, die Dunkelelfenstadt - Zordan@SL
*/

#include "../def.h"
#include <properties.h>

inherit ROOM "wall_inh.lpc";

create() {
  richtung = "sueden";
  ::create();

  SetProp(P_HIDE_EXITS, ({ "norden" }) );

  AddItem( NPC "drider", REFRESH_DESTRUCT);

  AddExit( "suedwesten" , "./wall-d2" );
  AddExit( "suedosten"  , "./wall-f2" );
  AddExit( "nordoben"  , "/d/unterwelt/basics/central/room/02-13-03" );
  AddExit( "norden"  , "/d/unterwelt/basics/central/room/02-13-03" );

}
