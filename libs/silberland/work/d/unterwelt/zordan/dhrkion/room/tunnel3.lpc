#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Tunnel aus Dhrkion");
  SetProp(P_INT_LONG,
     "Du findest Dich in einem engen Tunnel. Boden, Decke und Waende "
     "bestehen aus dunklem, rauhen Fels. Du weisst zwar nicht, wo der "
     "Tunnel hinfuehrt, aber Du hast trotzdem keine Angst. Hier innerhalb "
     "der Stadt bist Du sicher. Zumindest als Dunkelelf."
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);

  AddDetail( ({ "boden", "decke", "wand", "waende" }),
    "Boden, Decke und Waende des Tunnels bestehen aus dunklem, rauhen Fels."
  );

  AddDetail( ({ "fels" }),
    "Der Tunnel wurde in den natuerlichen Fels geschlagen."
  );

  AddDetail( ({ "angst" }),
    "So lange Du Dich innerhalb der Stadt befindest, brauchst Du keine "
    "Angst zu haben."
  );

  AddDetail( ({ "stadt", "dhrkion" }),
     "Dhrkion."
  );

  AddDetail( ({ "dunkelelf" }),
    "Wenn Du keiner bist, was machst Du dann hier?"
  );

  AddExit( "sueden", ROOM "tunnel2" );
  AddExit( "oben"  , ROOM "weg-d5");
}


