#include "../def.h"

inherit "std/room";

#include <bank.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Tempel von Dhrkion" );
  SetProp(P_INT_LONG,
    "Das Wort 'prunkvoll' trifft den Reichtum und Schoenheit dieser "
    "Ruhestaette nicht genug. Unzaehlbar viele Edelsteine, massenhaft Gold "
    "und sonstige, wertvolle Dinge verzieren aber auch jeden Teil dieses "
    "Tempels. Alleine der Altar vor dem Spinnenabbild duerfte in seinem "
    "Wert alles andere auf dieser Welt uebertreffen. An den Waenden und an "
    "der Decke hat man verschiedene, kleinere Abbilder angebracht. "
    "Was Dir noch besonders auffaellt ist, dass hier nicht ein einziger "
    "Lichtstrahl erzeugt wird. Eine kleine Wendeltreppe scheint nach oben "
    "zu fuehren. Eine kleine Tafel steht an einer Wand."
  );

  SetProp(P_LIGHT, -1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "tempel" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "wendeltreppe","treppe" }),
    "Du kannst sie nicht richtig sehen. Aber sie scheint wirklich nach "
    "oben zu fuehren. Ein kleines Schild haengt am Fusse der Treppe.");

  AddDetail( ({ "schild" }),
    "Das Schild ist aus Gold.");

  AddDetail( ({ "prunk" }),
    "Kein Wort wuerde jemals den Reichtum und Schoenheit dieser "
    "Ruhestaette genuegend beschreiben koennen.");

  AddReadDetail( ({ "schild" }),
    "!!! ACHTUNG !!! Betreten bei Todesstrafe verboten !!! ACHTUNG !!!");

  AddDetail( ({ "fusse","anfang" }),
    "Das ist der Anfang der Treppe. Mehr nicht.");

  AddDetail( ({ "boden" }),
    "Der Boden ist mit goldenen Platten ausgelegt worden. Vor dem Altar "
    "sind kleine Einbuchtungen in die Platten geschlagen worden.");

  AddDetail( ({ "platten" }),
    "Die Platten sind nicht einmal so gross, bestehen aber dafuer "
    "aus purem Gold.");

  AddDetail( ({ "einbuchtungen","einbuchtung" }),
    "In die Einbuchtungen legen sich die Dunkelelfen beim Beten.");

  AddDetail( ({ "beten","haupttaetigkeit","taetigkeit" }),
    "Beten ist die Haupttaetigkeit, die die Dunkelelfen hier nachgehen.");

  AddDetail( ({ "decke" }),
    "An der Decke haengen mehrer Leuchter. Ansonsten kannst Du lauter "
    "Verzierungen erkennen.");

  AddDetail( ({ "leuchter" }),
    "Die Leuchter sind aus Edelstein. Sie verbreiten aber kein Licht. "
    "Man hat sie wohl wegen dem Flair hier dort angebracht.");

  AddDetail( ({ "flair" }),
    "Normalerweise ist Flair ja recht schoen. Hier herrscht aber mehr "
    "das Boese als das Gute.");

  AddDetail( ({ "boese","boesen" }),
    "Dieses ist ein Tempel des Boesen. Das merkt man ueberall.");

  AddDetail( ({ "gute" }),
    "Das Gute wirst Du hier wohl kaum finden.");

  AddDetail( ({ "verzierungen","verzierung","geschnoerkel" }),
    "Normalerweise wuerdest Du ja sagen: Geschnoerkel. Aber hier im "
    "heiligstem Tempel der Dunkelelfen traust Du Dich nicht einmal einen "
    "Gedanken darueber zu machen.");

  AddDetail( ({ "gedanken","gedanke" }),
    "Deine Gedanken sind ein wenig verwirrt.");

  AddDetail( ({ "verwirrung" }),
    "Jetzt bist Du total verwirrt.");

  AddDetail( ({ "wand","waende" }),
    "An den Waenden sind dutzende von kleinen Abbildern angebracht worden. "
    "Die Waende selber sind komplett aus Gold. Alleine die Waende "
    "hier haben einen unschaetzbaren Wert. An einer steht eine Tafel.");

  AddDetail( ({ "dunkelheit" }),
    "Die Dunkelheit herrscht hier ueberall.");

  AddDetail( ({ "lichtstrahl","strahl","art" }),
    "Jegliche Art von Lichtstrahl wird hier von den Waenden und der Decke "
    "einfach so geschluckt. Absolute Dunkelheit ist auch ueberall dort, "
    "wo Du nicht mehr alles so genau erkennen kannst.");

  AddDetail( ({ "abbilder" }),
    "Die Abbilder sind zum Teil kleine Kopien des grossen Abbildes aber "
    "sie stellen auch andere Situationen mit der Spinnengoettin dar.");

  AddDetail( ({ "kopie","kopien" }),
    "Es sind sogar haargenaue Kopien.");

  AddDetail( ({ "situationen","situation" }),
    "Das sind solche wie: Ernten, Bauen, Toeten, Boeses, Gift, Licht.");

  AddDetail( ({ "ernten","bauen","toeten","boeses","gift" }),
    "Du hast leider keine Zeit Dir die Abbilder genauer anzusehen. Man "
    "schaut Dich naemlich schon misstrauisch an.");

  AddDetail( ({ "zeit" }),
    "Wer hat in dieser Zeit schon viel Zeit?");

  AddDetail( ({ "spinnenabbild","abbild" }),
    "So etwas Faszinierendes hast Du noch nie gesehen. Das Abbild zeigt "
    "eine riesige Spinnengoettin mit acht Beinen, wie sie einem "
    "Dunkelelfen Leben einhaucht. Das Abbild selbst ist am Rande aus Gold "
    "und ansonsten wie der Altar komplett aus Edelsteinen.");

  AddDetail( ({ "rand" }),
    "Der Rand des Abbildes ist komplett aus Gold.");

  AddDetail( ({ "beine","bein","spinnenbeine","spinnenbein" }),
    "Haarige Spinnenbeine streichen sanft ueber den Dunkelelfen und "
    "man sieht deutlich wie wieder Leben in den Dunkelelfen stroemt.");

  AddDetail( ({ "welt","welten","silberland" }),
    "Es gibt zwei Welten im SilberLand: Die Unterwelt und die Oberwelt.");

  AddDetail( ({ "unterwelt" }),
    "In der bist Du gerade. Boese und gemein ist sie.");

  AddDetail( ({ "oberwelt" }),
    "In ihr herrscht das Sonnenlicht und viele gute und freundliche "
    "Wesen leben dort.");

  AddDetail( ({ "wesen" }),
    "Natuerlich gibt es in der Oberwelt auch boese Wesen. Die meisten "
    "kommen direkt aus der Unterwelt.");

  AddDetail( ({ "wert","sachen" }),
    "Du kannst den Wert all dieser Sachen nicht einmal abschaetzen. Zu "
    "gigantisch wirkt alles auf Dich ein.");

  AddDetail( ({ "altar" }),
    "Ein riesiger Altar, komplett aus Edelsteinen gefertigt, thront "
    "maechtig ueber den ganzen Tempel. Wirklich nur das Abbild darueber "
    "ist noch ein "
    "wenig auffaelliger. Auf dem Altar krabbeln ein paar Spinnen herum, und "
    "viele Dunkelelfen liegen vor dem Altar und beten.");

  AddDetail( ({ "teil" }),
    "Aber auch wirklich JEDER Teil des Tempels ist verziert worden. "
    "Entweder mit Edelsteinen, Gold oder anderen Dingen.");

  AddDetail( ({ "dinge" }),
    "Einige nicht ganz so wertvolle Dinge. Aber immer noch weit mehr wert "
    "als jede Muenze. Sie aufzuzaehlen uebersteigt Deine Faehigkeiten.");

  AddDetail( ({ "faehigkeiten" }),
    "Jaja, schon gut.");

  AddDetail( ({ "muenze" }),
    "Als Du an Muenzen denkst faellt Dir eine kleine Opferschale auf.");

  AddDetail( ({ "opferschale","schale" }),
    "In ihr liegen haufenweise Muenzen. Vielleicht ist es gar nicht so "
    "schlecht, auch was zu opfern. Die Schale selber besteht komplett aus "
    "Gold.");

  AddDetail( ({ "gold" }),
    "Wenn etwas hier nicht aus Edelstein gemacht ist, dann ist es aus "
    "Gold. Es schimmert ein wenig.");

  AddDetail( ({ "edelsteine","edelstein" }),
    "Unsagbar viele Edelsteine sind in diesem Tempel verarbeitet worden. "
    "Das Volk der Dunkelelfen muss sehr reich sein.");

  AddDetail( ({ "volk","jeder" }),
    "Jeder gehoert einem Volk an, auch Du.");

  AddDetail( ({ "lloth","spinnengoettin","goettin" }),
    "Lloth ist die Spinnengoettin der Dunkelelfen. Sie hat den Dunkelelfen "
    "das Leben geschenkt und wacht und beschuetzt sie vor boesen Feinden. "
    "Zu sehen bekommst Du sie sicherlich nicht. Es fehlen deshalb auch "
    "Beschreibungen ueber sie.");

  AddDetail( ({ "beschreibungen","beschreibung" }),
    "Du wirst nirgends welche ueber sie finden. Selbst die Priesterinnen "
    "werden Dir nur sagen koennen, dass Lloth eine Spinne ist.");

  AddDetail( ({ "spinne","spinnen" }),
    "Dutzende Spinnen krabeln hier herum und pflegen ihre Netze. Sie zu "
    "toeten ist wohl ein krasses Vergehen.");

  AddDetail( ({ "spinnennetz","spinnennetze","netze","netz" }),
    "Wieviele Spinnennetze hier ueberall haengen kannst Du nicht sagen. "
    "Nur das niemand sie entfernt.");

  AddDetail( ({ "vergehen" }),
    "Vergehen werden hier sofort bestraft. Toetest Du auch nur eine "
    "Spinne, wird man Dich sofort umbringen.");

  AddDetail( ({ "leben" }),
    "Lloth kann das Leben geben aber auch sofort wieder nehmen.");

  AddDetail( ({ "feinde","feind" }),
    "Das Sonnenlicht ist einer ihrer aergsten Feinde. Das solltest Du Dir "
    "unbedingt merken.");

  AddDetail( ({ "sonnenlicht","licht" }),
    "Deshalb ist es hier unten ueberall auch so dunkel. Lloth hasst das "
    "Licht genauso wie die Dunkelelfen selber.");

  AddDetail( ({ "ruhestaette","staette" }),
    "Dieses ist die Ruhestaette der Dunkelelfen. Hier huldigen sie ihren "
    "Verstorbenen und beten zu ihrer Goettin Lloth.");

  AddDetail( ({ "verstorbenen" }),
    "Das sind die toten Dunkelelfen.");

  AddDetail( ({ "schoenheit" }),
    "Schoenheit ist rein subjektiv. Du findest diesen Tempel aber schoen "
    "genug, um hier nach Deinem Ableben Deinen Koerper wieder zu bekommen. "
    "Vor allem fuer Dunkelelfen wurde dieser Tempel eingerichtet.");

  AddDetail( ({ "dunkelelfen","elfen" }),
    "Ein paar Dunkelelfen liegen vor dem Altar und beten. Andere wiederum "
    "scheinen geradezu in Trance gefallen zu sein.");

  AddDetail( ({ "trance" }),
    "In solch eine Trance kannst Du nicht geraten. Es sind nur die hohen "
    "Priesterinnen der Goettin Lloth, die das koennen.");

  AddDetail( ({ "priesterinnen" }),
    "Einige davon stehen herum, liegen hier und beten oder sind in eine "
    "tiefe Trance gefallen.");

  AddDetail( ({ "priester" }),
    "Du kannst keinen einzigen maennlichen Priester sehen.");

  AddDetail( ({ "reichtum" }),
    "Der Reichtum in diesem Tempel ist unglaublich. Soviel wie hier wirst "
    "Du wohl nie wieder sehen.");

  AddDetail( ({ "wort" }),
    "Jedes Wort hier wird von den boesen Maechten gehoert. Also pass bloss "
    "auf, was Du hier sagst und tust.");

  AddDetail( ({ "macht","maechte" }),
    "Man kann die boesen Maechte in diesem Tempel genau spueren und "
    "fuehlen. Sie strahlen eine unglaubliche Aura aus.");

  AddDetail( ({ "aura" }),
    "Die Aura umgibt Dich und durchstroemt auch Deinen Koerper.");

  AddDetail( ({ "koerper" }),
    "Wenn die Maechte gewillt sind, geben sie Dir ja vielleicht Deinen "
    "Koerper nach einem Ableben wieder. Beten waere vielleicht nicht "
    "schlecht dafuer.");

  AddDetail( ({ "ableben" }),
    "Ableben ist nur ein anderes Wort fuer Sterben.");

  AddDetail( ({ "sterben" }),
    "Sterben kann man hier leicht.");

  AddDetail( ({ "tafel" }),
    "Auf dieser Tafel stehen die besten Dunkelelfen. Du kannst sie lesen.");

  AddDetail( ({ "ruhe" }),
    "Die Ruhe kann man weder sehen noch spueren.");

  AddSound( ({ DEFAULT_SOUND }),
    "Die absolute Ruhe herrscht hier.");

  AddSound( ({ "ruhe" }),
    "Wie willst Du die hoeren?");

  AddSmell( ({ DEFAULT_SMELL }) ,
    "Es riecht nach, ja, nach nichts.");

  AddSmell( ({ "nichts" }) ,
    "Nichts zu riechen ist schon ne Kunst fuer sich.");

  AddReadDetail( ({"heldentafel", "tafel"}), "@@detail_tafel@@");

  AddItem(NPC "priesterin", REFRESH_DESTRUCT);
  AddItem(OBJ "truhe",      REFRESH_DESTRUCT);

  AddItem("/p/service/obj/zettel/zettelmaschine", REFRESH_REMOVE);

  AddCmd( ({"bete","bet"})  ,    "cmd_beten");
  AddCmd( ({"opfer","opfere"}),  "cmd_opfern");
  AddCmd( ({"toete"}), "cmd_toeten" );

  AddExit("sueden", ROOM "weg-e6" );

  AddSpecialExit("oben", "exit_oben");
}

int cmd_beten()
{
  string sp, so;

  sp = "Du legst Dich vor dem Altar auf den Bauch nieder und haeltst ein "
       "kurzes Gebet zu den boesen Maechten.";

  so = CAP_TPN+" legt sich auf den Boden nieder und haelt ein boeses Gebet.";

  if(TP->QueryProp(P_GHOST))
  {
    sp += "Eine innere Ruhe kommt in Dir auf. Dein Gebet laesst Dich in "
          "eine tiefe Trance sinken. Frieden und Leben sind die Zeichen, "
          "die Du in diesem Moment spueren kannst. Doch auf einmal zerreist "
          "diese Stille und boese Gedanken durchfahren Deinen Geist. Tod "
          "und Zerstoeren, dunkle Maechte und dann auf einmal formt sich "
          "das Abbild einer riesigen Spinne. Du bist Dir sicher: Das kann "
          "nur Lloth sein. Lloth haelt in einer ihrer Spinnenbeine Dein "
          "neues Herz, das jetzt noch boeser und furchteregender geworden "
          "sein wird. Mit einem Aufschrei nimmst Du das Herz entgegen und "
          "kehrst in die Welt der Sterblichen zurueck.";

    so += "Nachdem ein kurzer Blitz den Koerper von "+TPN+" durchfaehrt, "
          "weilt "+TPN+" wieder unter den Lebenden.";

    TP->SetProp(P_GHOST, 0);
    TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-100);
  }

  tell_object(TP, BS(sp));
  tell_room(TO, BS(so), ({ TP }) );

  return 1;
}

int cmd_opfern(string str)
{
  int now,wieviel;
  string dummy;

  int ok, menge, besitz;
  object ob;

  notify_fail("Was willst Du opfern?\n");

  if(!str || str == "") return 0;

  ok = 0;
  if(str == "muenze")
  {
    menge = 1;
    ok    = 1;
  }

  if(!ok) if(sscanf(str, "%d muenzen", menge) == 1) ok = 1;

  if(!ok) return 0;

  besitz = TP->QueryMoney();
  if(besitz <= 0)
  {
    tell_object(TP, "Du hast ja gar kein Geld!\n");
    return -1;
  }

  if(menge > besitz)
  {
    tell_object(TP, "Soviel Geld hast Du gar nicht!\n");
    return -1;
  }

  TP->AddMoney(-menge);
  ZENTRALBANK->PayIn(menge);

  tell_object(TP, BS("Du legst "+menge+" Muenze"+(wieviel==1?"":"n")+" in "
                     "die Opferschale."));

  tell_room(TO, CAP_TPN+" legt ein paar Muenzen in eine Opferschale.\n",
               ({ TP }) );

  now = TP->QueryProp(P_ALIGN);

  if (now > -500 )
  {
    TP->SetProp(P_ALIGN, now-wieviel/100);
    if(TP->QueryProp(P_ALIGN) < -800) TP->QueryProp(P_ALIGN, -800);

    if(menge > 100)
    {
      tell_object(TP, "Du fuehlst Dich ein wenig boeser als vorher.\n");
    }
    else
    {
      tell_object(TP, "Es ist Dir peinlich so wenig zu opfern.\n");
    }
  }
  else
  {
    tell_object(TP, "Es passiert nichts weiter.\n");
  }

  return 1;
}

// Runenquest -> Zugang nach oben nur wenn alle Runen fertig

int exit_oben(string str)
{
  object ob;

  if(!present("priesterin",TO))
  {
    tell_object(TP,BS(
      "Als Du versuchst nach oben zu gehen, bemerkst Du auf einmal eine "
      "starke Macht, die Dich davon abhaelt. Du bist Dir sicher, dass Du "
      "erst jemanden fragen musst, der fuer Dich diese Macht baendigt.\n"));

    return 1;
  }

  if(!RUNENMASTER->IsQuester(getuuid(TP)))
  {
    tell_object(TP, BS(
      "Die Priesterin sagt: Du darfst nicht nach oben gehen, "
      +CAP_TPN+".\n"));
    return 1;
  }

  if(!RUNENMASTER->QueryAllDone(getuuid(TP)))
  {
    tell_object(TP, BSI(
      CAP_TPN+", Du hast noch nicht alle Runen gefunden oder noch nicht "
      "alle richtig eingesetzt. Vorher kann ich Dir den Zugang nach oben "
      "nicht gestatten.", "Die Priesterin sagt: " ));
    return 1;
  }

  tell_object(TP, BSI(
    "Super "+CAP_TPN+", Du hast alle Runen gefunden und richtig "
    "eingesetzt. Jetzt wird es aber hoechste Zeit, dass Du nach oben "
    "gehst und den Dunkelzauber aussprichst. Aber denke daran: Du kannst "
    "den Raum oben nicht mehr verlassen, bevor Du nicht den Zauber "
    "ausgesprochen hast!", "Die Priesterin sagt erfreut: ")+
                  BS(
    "Die Priesterin faesst Dir an den Kopf und Du bemerkst einen kleinen "
    "Stich. Du weisst, dass Du jetzt bereit bist nach oben zu gehen und "
    "tust es auch sofort.")
  );

  TP->move(ROOM "tempel2", M_GO, 0,
    "geht die Wendeltreppe nach oben",
    "kommt die Treppe rauf" );

  return 1;
}

int cmd_toeten(string str)
{
  object ob;

  if(!str || str == "") return 0;
  if(!(str == "spinne"   ||
       str == "spinnen"  )) return 0;

  if(ob = present("\npriesterin"))
  {
    tell_object(TP, BS(
      "Du versucht eine der Spinnen zu toeten. Die Hohenpriesterin schlaegt "
      "die Augen weit auf und versucht Deinen Frevel zu raechen."));
    ob->Kill(TP);
    return 1;
  }

  tell_object(TP, BS(
    "Du zertrittst eine der Spinnen. Aber irgendwie hast Du das Gefuehl, "
    "dass das kein so guter Gedanke war. Und Du hast recht. Auf einmal "
    "stoesst eine dunkle Lanze aus dem Abbild und trifft Dich sehr sehr "
    "hart."));

  TP->do_damage(100+random(100));

  return 1;
}

string detail_tafel()
{
  TP->more("/etc/topdunkelelfen.read",1);
  return "";
}
