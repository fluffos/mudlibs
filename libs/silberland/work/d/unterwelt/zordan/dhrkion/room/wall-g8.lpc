/*
   Dhrkion, die Dunkelelfenstadt - Zordan@SL
*/

#include "../def.h"

inherit ROOM "wall_inh.lpc";

#include <properties.h>

create() {
  richtung = "norden";
  ::create();

  NewDoor( "suedosten","./rothe-h9","gitter",
    ({ D_NAME,"Gitter",
       D_GENDER, NEUTER,
       D_FLAGS, (DOOR_RESET_CL|DOOR_CLOSED),
       D_MSGS, ({"nach Suedosten", "geht durch das offene Gitter",
                                "kommt durch das offene Gitter herein" }),
       D_SHORT,"Ein Gitter im Suedosten ist %s. ",
       D_FUNC2, "gitterzu",
       D_LONG,
         "Dieses kleine Gitter verschliesst eine kleine Hoehle im Suedosten. "
         "Du kannst es leicht oeffnen."
    }) );

  AddExit( "nordosten"  ,  "./wall-h7" );
  AddExit( "westen"      , "./wall-f8" );
}

gitterzu() {
  call_other(DOOR_MASTER, "SetDoorStatus", ROOM "rothe-h9", -1);
  write("Das Gitter faellt hinter Dir zu.\n");
  say("Das Gitter faellt hinter "+TPN+" zu.\n");
}
