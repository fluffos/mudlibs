#include "../def.h"

inherit ROOM "inh-wegblock";

void create()
{
  ::create();

  thisroom = 2;

  SetProp( P_INT_SHORT, "Marktplatz von Dhrkion" );
  SetProp( P_INT_LONG,
    "Prachtvoll baut sich vor Dir im Norden der Tempel der Dunkelelfen "
    "auf. Ehrfurchtsvoll und leicht gebueckt geht man hier. Handel treibt "
    "man auf dem suedlichsten Teil des Marktplatzes nicht. Eine kleine "
    "Senke fuehrt Dich im Sueden an einem Steinblock vorbei in den "
    "Wohnbereich von Dhrkion. Der Boden ist mit reich verzierten Platten "
    "ausgelegt."
  );

  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "steinblock","block" }),
    "Der Steinblock steht genau vor dem Tempel und ist auch nicht ohne "
    "Grund leicht in Richtung des Tempels geneigt. Er ist fast doppelt so "
    "hoch wie Du und komplett aus Stein.");

  AddDetail( ({ "stelle" }),
    "Du kannst eine Rune an einer Stelle einfuegen. Aber keine Stelle "
    "faellt Dir besonders auf.");

  AddDetail( ({ "stein" }),
    "Wirklich ganz normaler Stein.");

  AddDetail( ({ "richtung" }),
    "Er ist leicht zum Tempel geneigt worden. Welchen Grund koennte das "
    "nur haben?");

  AddDetail( ({ "grund" }),
    "Aha, ganz oben auf den Steinblock wurde etwas geschrieben. Da der "
    "Steinblock nicht ganz so gross ist, koennte man die Schriftzeichen "
    "eventuell sogar lesen.");

  AddDetail( ({ "schriftzeichen","zeichen" }),
    "Sie erinnern Dich irgendwie an Runen.");

  AddDetail( ({ "licht" }),
    "Das Licht ist hier wirklich besonders. Denn es erinnert Dich glatt "
    "an das Sonnenlicht.");

  AddDetail( ({ "sonnenlicht" }),
    "Das seltsame Sonnenlicht kommt aus den oberen Etagen des Tempels und "
    "ueberstrahlt den ganzen Marktplatz.");

  AddDetail( ({ "etagen","etage" }),
    "Du kannst die oberen Etagen des Tempels nur schemenhaft erkennen. Aus "
    "einer von ihnen kommt aber dieses Sonnenlicht.");

  AddDetail( ({ "waende","wand" }),
    "Genau wo Du stehst, gibt es keine Waende.");

  AddDetail( ({ "boden" }),
    "Der Boden ist hier mit reicht verzierten Platten ausgelegt worden. "
    "Ueber manche Platten geht niemand drueber. Auch Du haeltst Dich daran.");

  AddDetail( ({ "platten" }),
    "Viele Platten sind auch mit Edelsteinen verziert worden. Auf manchen "
    "kannst Du Abbilder erkennen. Ueber genau diese Platten geht niemand. "
    "Sie sehen auch noch nagelneu aus.");

  AddDetail( ({ "abbilder","abbild" }),
    "Sie zeigen in vielen Formen die Goettin der Dunkelelfen.");

  AddDetail( ({ "goettin" }),
    "Die Goettin der Dunkelelfen ist Lloth, die Spinnengoettin.");

  AddDetail( ({ "lloth","spinnengoettin" }),
    "Wenn Du mehr ueber sie erfahren willst, musst Du schon den Tempel "
    "im Norden betreten.");

  AddDetail( ({ "formen","form" }),
    "Zu viele um sie alle zu zaehlen.");

  AddDetail( ({ "senke" }),
    "Die Senke im Sueden sieht noch nicht sehr alt aus. Leicht bergab "
    "kannst Du sie aber leicht betreten und die Dunkelelfen in ihrem "
    "Wohnbereich besuchen gehen.");

  AddDetail( ({ "wohnbereich","bereich" }),
    "Der neue Bereich von Dhrkion ist fuer die Wohnungen der Dunkelelfen "
    "erschlossen worden. Er liegt weiter im Sueden. Von hier aus kannst "
    "Du aber auch noch keine Wohnungen erkennen.");

  AddDetail( ({ "wohnungen" }),
    "Von hier aus kannst Du noch keine sehen. Du musst schon weiter nach "
    "Sueden gehen.");

  AddDetail( ({ "teil" }),
    "Du bist auf dem suedlichstem Teil des Marktplatzes.");

  AddDetail( ({ "tempel" }),
    "Der Tempel uebertrifft alles in Dhrkion. Er ist stark mit allen "
    "moeglichen Edelsteinen verziert und strahlt eine sehr starke, "
    "heilige Aura aus. Er reicht vom Boden aus bis in die Dunkelheit der "
    "Decke.");

  AddDetail( ({ "dunkelheit" }),
    "Die herrscht fast ueberall in Dhrkion. Besonders stark kann man sie "
    "an der Decke beobachten. Wo nicht einmal die Dunkelelfen selber etwas "
    "sehen koennen.");

  AddDetail( ({ "decke" }),
    "Du kannst die Decke wirklich nicht erkennen.");

  AddDetail( ({ "aura" }),
    "Nicht nur Du kannst diese Aura wirklich spueren. Auch die anwesenden "
    "Dunkelelfen bekommen aus mit und gehen deshalb auch ein wenig "
    "gebueckt an dem Tempel vorrueber.");

  AddDetail( ({ "dunkelelfen" }),
    "Die Dunkelelfen sind hier recht still und gehen leicht gebueckt "
    "an dem Tempel vorbei. Handel treiben sie hier nicht.");

  AddDetail( ({ "handel" }),
    "Der wird wohl mehr im Westen auf dem Marktplatz getrieben.");

  AddDetail( ({ "marktplatz","platz" }),
    "Der Marktplatz erstreckt sich weit inmitten von Dhrkion. Du stehst "
    "im Sueden des Platzes direkt vor dem Tempel.");

  AddDetail( ({ "dhrkion","stadt" }),
    "Du stehst direkt vor dem Tempel von Dhrkion. Deshalb treibt man hier "
    "auch keinen Handel.");

  AddDetail( ({ "edelsteine","edelstein" }),
    "Der Tempel ist mit abertausenden von Edelsteinen verziert. Unglaublich "
    "wertvoll muss das alles sein. Sie glitzern in einem fuer Dhrkion "
    "ungewoehnlichem Licht.");

  AddSound( DEFAULT_SOUND,
    "Still und ruhig ist es hier.");

  AddDetail( ({ "duft" }),
    "Der Duft kommt aus dem Norden.");

  AddDetail( ({ "weihrauch" }),
    "Den kannst Du nur riechen.");

  AddDetail( ({ "raeucherstaebchen" }),
    "Die kannst Du nicht sehen, nur riechen.");

  AddSmell( ({ DEFAULT_SMELL,"duft" }),
    "Der Duft von Weihrauch und Raeucherstaebchen kommen aus dem Norden.");

  AddSmell( ({ "weihrauch","rauch" }),
    "Die Dunkelelfen muessen sehr religioes sein, wenn sie schon den "
    "Marktplatz mit solchen Geruechen ueberfluten.");

  AddSmell( ({ "raeucherstaebchen","staebchen" }),
    "Der Rauch riecht sehr suesslich und entzueckt Deine Nase.");

  AddItem( NPC "drow", REFRESH_DESTRUCT);
  AddItem( NPC "odania", REFRESH_DESTRUCT);
  AddItem( NPC "sklave2", REFRESH_DESTRUCT);

  AddCmd( ({ "lese","lies","les" }) , "cmd_lesen" );

  AddSpecialDetail( ({ "runen" }), "detail_runen" );

  AddExit( "norden",     ROOM "tempel" );
  AddExit( "nordwesten", ROOM "weg-d5" );
  AddExit( "nordosten",  ROOM "weg-f5" );
  AddExit( "sueden",     ROOM "weg-e7" );
}

string detail_runen(string str)
{
  if(RUNENMASTER->IsQuester(getuuid(TP)))
  {
    return "Du solltest die Runen lieber lesen.\n";
  }

  return BS("Da Du nichts ueber Runen weisst, sagen Dir diese Runen auch "
            "ueberhaupt nichts.");
}

int cmd_lesen(string str)
{
  string s;

  notify_fail("Was moechtest Du lesen?\n");

  if(!str || str == "") return 0;
  if(!(str == "schriftzeichen" ||
       str == "zeichen"        ||
       str == "runen"          ||
       str == "rune"           )) return 0;

  if((s = DisplayRunes(TP)) != "")
  {
    tell_object(TP, s);
    return 1;
  }

  tell_object(TP, BS("Du willst gerade die Schriftzeichen lesen, als "
                     "eine Priesterin aus dem Tempel kommt und Du Dich "
                     "lieber abwendest. Vielleicht solltest Du es viel "
                     "spaeter noch einmal versuchen." ));

  return -1;
}

