#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eingang zum Palast" );
  SetProp( P_INT_LONG,
    "Du betrittst den Eingang zu einem riesigem Palast. Im Norden ist der "
    "Thronsaal durch fensterartige Gebilde zu sehen. Erreichen "
    "kann man ihn allerdings direkt von hier aus nicht. Der Ausgang "
    "des Palastes ist durch ein grosses, sehr stabiles Tor abschliessbar. "
    "Der ganze Palast ist in eine riesige Hoehle mit einem kleinen Aufbau "
    "errichtet worden. Nur jahrelange Arbeit kann so ein gewaltiges "
    "Bauwerk hervorbringen." );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist mit einfachen Platten ausgelegt worden.");

  AddDetail( ({ "platten" }),
    "Das sind ganz normale Platten aus Fels.");

  AddDetail( ({ "decke" }),
    "Du kannst an der Decke nichts erkennen. Es ist dort einfach zu "
    "dunkel.");

  AddDetail( ({ "bauwerk","werk" }),
    "Viel kann man von hier noch nicht sehen. Aber Du bist Dir ziemlich "
    "sicher, dass dieser Palast jeden anderen Palast uebertrifft.");

  AddDetail( ({ "aufbau" }),
    "Den Aufbau kannst Du nur erahnen. Aber die Hoehle war einst wohl "
    "nicht ganz so hoch, so dass man einen kleinen Aufbau darauf "
    "aufgesetzt hat.");

  AddDetail( ({ "hoehle" }),
    "Das ganze hier war einmal eine riesige Hoehle, die man durch "
    "geschickte Arbeiten und Errichten von Waenden zu einem Palast "
    "gemacht hat.");

  AddDetail( ({ "errichten" }),
    "Es wurden diverse Waende und Raeume in diese Hoehle gebaut. Viele "
    "davon kann man als Sterblicher nicht betreten. Aber zumindest den "
    "Thronsaal kannst Du Dir ansehen.");

  AddDetail( ({ "sterblicher","sterbliche","frage" }),
    "Du bist sterblich, das steht ausser Frage.");

  AddDetail( ({ "arbeiten","arbeit","haende" }),
    "Du bist Dir nicht ganz sicher. Aber ob das alles hier mit Haenden "
    "gebaut wurde, magst Du doch bezweifeln.");

  AddDetail( ({ "thronsaal","saal" }),
    "Durch die Gebilde kannst Du den Thronsaal schwach erkennen. "
    "Eigentlich kannst Du dort nur Schatten und den Thron selber sehen. "
    "Einzelheiten sind von hier aus nicht zu sehen. Es scheint Dir so, als "
    "ob das normale Volk nicht weiter als bis hier gehen darf und nur "
    "durch die Gebilde die Herrscher sehen kann.");

  AddDetail( ({ "herrscher" }),
    "Wer oder was das ist, kannst Du von hier nicht sehen.");

  AddDetail( ({ "volk","faehigkeiten" }),
    "Du gehoerst mit Deinen Faehigkeiten nicht mehr zum normalen Volk und "
    "darfst den Thronsaal bestimmt einfach so betreten.");

  AddDetail( ({ "einzelheiten" }),
    "Dafuer musst Du schon den Thronsaal selber betreten.");

  AddDetail( ({ "thron","beine","bein" }),
    "Viel kannst Du von dem gigantischen Thron nicht sehen. Aber er "
    "scheint auf Beinen zu stehen.");

  AddDetail( ({ "schatten" }),
    "Ein grosser und mehrere kleine Schatten bewegen sich in der "
    "Dunkelheit.");

  AddDetail( ({ "dunkelheit" }),
    "Auch hier ist alles dunkel. Das wundert Dich aber schon nicht mehr.");

  AddDetail( ({ "fenster" }),
    "Nein, die Gebilde erinnern nur an Fenster. Sie sind es aber nicht, "
    "denn man kann nur hindurchsehen, aber nicht hindurchgreifen.");

  AddDetail( ({ "norden","gebilde" }),
    "Im Norden sind kleine, fensterartige Gebilde in die Wand eingelassen "
    "worden. Durch sie hindurch kannst Du den Thronsaal schon erkennen.");

  AddDetail( ({ "waende","wand" }),
    "Die Waende bestehen wohl aus Fels, sind aber mit ein paar "
    "Verzierungen geschmueckt worden. In der noerdlichen Wand sind ein "
    "paar Gebilde eingebaut worden.");

  AddDetail( ({ "verzierungen","verzierung" }),
    "Schnoerkellose Verzierungen zeigen sich hier. Sie geben dem Raum nur "
    "ein schoeneres Aussehen.");

  AddDetail( ({ "aussehen" }),
    "Der Raum sieht eigentlich noch ganz nett aus. Aber fuer so wuerdig "
    "haeltst Du ihn nicht.");

  AddDetail( ({ "eingang" }),
    "Dieser Eingang ist nicht besonders prunktvoll oder so gestaltet "
    "worden. Ein einfacher Hoehlengang ist es geworden. Es fuehren Gaenge "
    "weiter nach Osten und Westen.");

  AddDetail( ({ "hoehlengang","gang" }),
    "Der Hoehlengang ist dreigeteilt und fuehrt durch ein grosses Tor "
    "wieder durch den Ausgang raus.");

  AddDetail( ({ "gaenge" }),
    "Durch die finsteren Gaenge kann man wohl den Thronsaal erreichen.");

  AddDetail( ({ "tor" }),
    "Ein massives Tor aus viel Holz und Fels. Kein Metall ist zu sehen. "
    "Seltsam, aber man scheint es jahrelang nicht mehr geschlossen zu "
    "haben. Du meinst sogar, dass man es nie wieder bewegen koennen wird.");

  AddDetail( ({ "holz" }),
    "Starkes, festes Holz ist am Tor angebracht worden.");

  AddDetail( ({ "fels" }),
    "Das ist ganz normaler Fels.");

  AddDetail( ({ "metall" }),
    "Metall? Wo?");

  AddDetail( ({ "osten","westen" }),
    "Dort geht es weiter in den Palast hinein.");

  AddDetail( ({ "palast" }),
    "Hier ist der Palast als solches kaum zu erkennen. Aber das gesamte "
    "Bauwerk ist wohl riesengross. Du wirst aber nur einen geringen "
    "Teil betreten koennen.");

  AddDetail( ({ "teil","teile" }),
    "Die anderen Teile sind fuer Dich gesperrt.");

  AddDetail( ({ "ausgang" }),
    "Der Ausgang fuehrt durch ein grosses Tor wieder hinaus.");

  AddDetail( ({ "leichen","leiche" }),
    "Hier liegen keine Leichen rum. Aber es stinkt trotzdem danach.");

  AddSound( ({ DEFAULT_SOUND }),
    "Ziemlich still ist es hier.");

  AddSmell( ({ DEFAULT_SMELL }),
    "Seltsam, es riecht nach verwesenden Leichen.");

  AddSmell( ({ "leichen","leiche","geruch" }),
    "Der Geruch kommt mehr aus dem Westen und Osten.");

  AddItem(NPC "diener", REFRESH_DESTRUCT);
  AddItem("/d/unterwelt/angel/dhrkion/npc/shareia", REFRESH_DESTRUCT);
  AddItem(OBJ "schild", REFRESH_REMOVE);

  AddCmd( ({ "schliesse","schliess"
           ,"oeffne","bewege","beweg" }) , "cmd_oeffnen" );
  AddCmd( ({ "greife","greif" })         , "cmd_greifen" );
  AddCmd( ({ "schieb","schiebe" })       , "cmd_schieben" );

  AddSpecialDetail( ({"hinter tafel"})   , "detail_tafel" );

  AddExit( "osten",   ROOM "palast-f3" );
  AddExit( "westen",  ROOM "palast-d3" );
  AddExit( "sueden",  ROOM "weg-e4" );
}

int cmd_oeffnen(string str)
{
  notify_fail("Was moechtest Du bewegen?\n");

  if(!str || str == "") return 0;
  if(!(str == "tor"     ||
       str == "das tor" )) return 0;

  tell_object(TP, BS("Du versucht mit all Deiner Kraft das Tor zu "
                     "bewegen. Aber Du scheiterst jaemmerlich. Das Tor "
                     "ist einfach schon zu lange nicht mehr bewegt worden. "
                     "Jetzt haengt es einfach nur noch herum und "
                     "berichtet von alten Taten." ));
  return 1;
}

int cmd_greifen(string str)
{
  notify_fail("Durch was moechtest Du greifen?\n");

  if(!str || str == "") return 0;
  if(!(str == "durch gebilde" ||
       str == "durch das gebilde" )) return 0;

  tell_object(TP, BS("Das Gebilde besteht aus einem durchsichtigem "
                     "Material. Aber es ist kein Glas. Jedenfalls stoesst "
                     "Du Dir nur die Hand an und kannst nicht durch "
                     "das Gebilde greifen." ));
  return 1;
}

string detail_tafel(string str)
{
  if(!RUNENMASTER->IsQuester(getuuid(TP))) return 0;

  return BS("Hinter der Tafel scheint wirklich etwas zu sein. Verschieben "
            "koennte man sie ja vielleicht sogar.");
}

//--------------------------------------------------------------------------
// Runenquest -> 6. Ort wo eine Rune sein kann
//--------------------------------------------------------------------------

int cmd_schieben(string str)
{
  string s;

  notify_fail("Was moechtest Du wohin schieben?\n");

  if(!str || str == "") return 0;
  if(!(str == "tafel beiseite"       ||
       str == "tafel zur seite"      ||
       str == "tafel auf seite"      ||
       str == "tafel auf die seite"  ||
       str == "tafel weg"            )) return 0;

  if(!RUNENMASTER->IsQuester(getuuid(TP)))
  {
    tell_object(TP, BS("Du versuchst die Tafel zu verschieben, doch "
                       "irgendwie klemmt sie und laesst sich nicht "
                       "verschieben."));
    return 1;
  }

  switch(RUNENMASTER->GetRune(getuuid(TP), 6))
  {
    case 1:
      s = "Du schiebst die Tafel beiseite und findest dahinter eine kleine "
          "Rune. Du steckst sie ein und bringst die Tafel in ihre "
          "Ausgangsposition zurueck.";
      break;

    case -1:
      s = "Du schiebst die Tafel beiseite und findest dahinter eine kleine "
          "Rune. Als Du sie einstecken willst, merkst Du, dass sie Dir "
          "zu schwer ist. Daher laesst Du sie erstmal liegen und schiebst "
          "die Tafel wieder zurueck, damit sie niemand anderes findet. ";
      break;

    default:
      s = "Du schiebst die Tafel beiseite und findest dahinter nur ein "
          "paar kleine Spinnen in ihren Netzen. Du laesst die Spinnen in "
          "Ruhe und schiebst die Tafel in ihre Ausgangsposition zurueck.";
      break;
  }

  tell_object(TP, BS(s));

  return 1;
}
