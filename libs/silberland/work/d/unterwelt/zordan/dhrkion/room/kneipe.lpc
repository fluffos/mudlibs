public void schnaps_trinken() {
  object task;

  write(BS("Plexu nimmt ein kleines Schnapsglas aus dem Regal und fuellt es "
            "Dir mit einem dunklen Schnaps. Du trinkst den Schnaps und er "
            "schmeckt wirklich hervorragend. Deine Zunge, Hals und Dein Magen "
            "sehnen sich nach mehr davon."));
  say(BS("Plexu nimmt ein kleines Schnapsglas aus dem Regal und fuellt es "
         +TPN+" mit einem dunklen Schnaps. "+TPN+" schuettet den Schnaps mit einem "
         "gluecklichen Laecheln hinunter."));

  if(objectp(task=present(BARD_ID_GS10_TASK, TP))) {
    task->MarkFood(11);
  }
}

void reset()
{
  ::reset();

  geld = 100 + random(200);
}

int cmd_zaehlen(string str)
{
  notify_fail("Was moechtest Du zaehlen?\n");

  if(!str || str == "") return 0;
  if(!(str == "sorten"         ||
       str == "die sorten"     )) return 0;

  tell_object(TP,BS("Trotz Warnung setzt Du Dich hin und faengst an all die "
                    "verschiedenen Sorten zu zaehlen. 1 - 2 - 3 - 4 *Minuten "
                    "spaeter* 56 - 57. Doch auf einmal schubst Dich ein "
                    "betrunkener Dunkelelf und Du kommst durcheinander. Also "
                    "faengst Du nochmal an. Doch nach einer Weile musst Du "
                    "enttaeuscht feststellen, dass es einfach unmoeglich "
                    "ist, all diese Sorten zu zaehlen. Naja, 'jedenfalls "
                    "hast Du es versucht' sagst Du Dir und gehst wieder "
                    "Deiner Arbeit nach." ));

  return 1;
}

int cmd_verstehen(string str)
{
  notify_fail("Was moechtest Du verstehen?\n");

  if(!str || str == "") return 0;
  if(!(str == "eigenes wort"         ||
       str == "das eigene wort"      ||
       str == "dein eigenes wort"    ||
       str == "mein eigenes wort"    )) return 0;

  if(geld == 0)
  {
    tell_object(TP,BS("Deine Ohren sind wohl verstopft. Du hoerst nicht "
                      "mehr als vorher!"));

    return 1;
  }

  tell_object(TP,BS("Da Du in normaler Lautstaerke Dein eigenes Wort nicht "
                    "verstehen kannst, faengst Du furchtbar an zu schreien. "
                    "Erschrocken blicken alle anwesenden Dunkelelfen zu "
                    "Dir auf. Erst jetzt wird Dir bewusst, dass Du \"Gebt "
                    "mir all euer Geld!\" geschrien hast. Dein Kopf laeuft "
                    "rot an. Doch auf einmal werfen Dir die Dunkelelfen "+
                    geld+" Muenzen zu. Peinlich, peinlich. Du steckst die "
                    "Muenzen ein und tust ganz unschuldig." ));

  tell_room(TO,BS(TPN+" bruellt wie ein wilder Stier und die Dunkelelfen "
                  "werfen "+TP->QueryPronoun(WEM)+" auf einmal eine Menge "
                  "Muenzen zu.") , ({TP}) );

  TP->AddMoney(geld);
  geld = 0;

  return 1;
}

int getfeinde (object ob) {
  object plexob;
  if (plexob = find_living("plexu"))
    if (plexob->IsEnemy(ob)) return 1;
  return 0;
}

menuefkt(string str) {
  notify_fail ("Plexu ist gerade nicht da. Du solltest es spaeter nochmal versuchen.\n");
  if (present("plexu")) {
    notify_fail("Du kaempfst doch gegen Plexu. Warum sollte er Dir sein Menue zeigen?\n");
    if (getfeinde(TP)) return 0;
    write("Plexu laechelt Dich an und zeigt Dir seine Karte:\n\n"
      "Willkommen in meiner bescheidenen Kneipe.\n"
      "Ich hoffe Dir wird etwas von meiner Karte gefallen, Plexu.\n\n" );
    return ::menue(str);
  }
  return 0;
}

int rothemilch (object z, object e)
{
  string ename;
  ename=CAP(e->name());

  if(e->QueryProp(P_LEVEL)<10)
  {
    tell_object(e, BS("Plexu bringt Dir ein Glas mit herrlich duftender "
                      "Rothemilch. Du trinkst die Milch und ein herrlicher "
                      "Geschmack verbreitet sich in Deinem Mund. Natuerlich "
                      "hattest Du einen Milchbart, den Du genuesslich mit "
                      "Deine Zunge entfernst." ));

    tell_room(TO, BS("Plexu bringt "+ename+" ein Glas mit herrlich duftender "
                     "Rothemilch. "+ename+" trinkt die Milch und hatte "
                     "natuerlich einen Milchbart, der aber sofort mit der "
                     "Zunge entfernt wurde." ), ({e}) );

    e->heal_self(20+random(10));
    return 1;
  }

  tell_room(TO,"Plexu bricht vor Lachen zusammen.\n"+
               break_string("Also "+ename+" ist nun wirklich nicht mehr so "
               "ein kleines Kind und trinkt Rothemilch!",78,"Plexu sagt: ")+
               "Die herumstehenden Dunkelelfen lachen "+ename+" aus. Mann, "
               "ist das peinlich.\n");

  return -1;
}


