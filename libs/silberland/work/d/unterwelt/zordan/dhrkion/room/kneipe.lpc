  );

  AddDetail( ({ "unter theke" }),
    "Unter der Theke scheint Plexu seine besten Getraenke zu verstauen."
  );

  AddDetail( ({ "bestecke","besteck" }),
    "Die Bestecke sind aus ganz normalem Metall hergestellt. Benutzt Du denn "
    "auch ein Besteck zum Essen oder isst Du etwa mit den Fingern?"
  );

  AddDetail( ({ "glaeser","glas","gefaesse","gefaess" }),
    "Saemtliche Gefaesse sind aus Glas und schimmern auch leicht."
  );

  AddDetail( ({ "schimmern" }),
    "Das Schimmern der Glaeser ist wirklich beeindruckend."
  );

  AddDetail( ({"plexu","wirt"}) ,
    "Oh, der ist wohl gerade nicht da.\n"
  );

  AddSound( ({ DEFAULT_SOUND }),
    "Die Dunkelelfen unterhalten sich sehr angestrengt ueber den vergangenen "
    "Tag. Glaeser und Bestecke klirren aneinander."
  );

  AddSound( ({ "dunkelelfen","elfen" }),
    "Leider unterhalten sie sich nicht gerade laut. Du kannst nichts von "
    "dem was sie sagen verstehen. Aber niemand hier ist so still wie Du."
  );

  AddSound( ({ "glaeser","glas","bestecke","besteck","klirren" }),
    "Beim Essen und Zuprosten klirrt es aus jeder Ecke des Raumes. Man macht "
    "wohl keinen Akt daraus, sich es hier richtig gut ergehen zu lassen und "
    "lautstark zu feiern."
  );

  AddSmell( ({ DEFAULT_SMELL }),
    "Es riecht nach feinem Essen und alkoholischen Getraenken."
  );

  AddSmell( ({ "essen" }),
    "Es riecht verdammt gut. Vielleicht solltest Du etwas davon probieren."
  );

  AddSmell( ({ "getraenke","getraenk" }),
    "Man kann in jedem der Glaeser den Alkoholgehalt quasi spueren. Aber "
    "riechen natuerlich noch viel mehr."
  );

  AddItem(NPC "plexu", REFRESH_DESTRUCT);

  AddCmd( ({ "zaehl","zaehle" }),     "cmd_zaehlen" );
  AddCmd( ({ "verstehe","versteh" }), "cmd_verstehen" );
  AddCmd( ({ "menue","menu" }) ,                            "menuefkt");

  AddExit("osten","./weg-d5");
