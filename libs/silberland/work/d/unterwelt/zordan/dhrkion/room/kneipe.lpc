     })
  );

  AddFood("Rothefilet", ({"rothefilet","filet"}),
    1500, ({80,100,}), 18,
    ({"Plexu bringt Dir einen Teller auf dem ein kleines Filetstueck einer "
      "Rothe hervorragend zubereitet worden ist. Dir laeuft schon das "
      "Wasser im Mund zusammen. Mit winzigen Bissen verspeisst Du das "
      "Filet und denkst . o O ( Ich will mehr !)"
     ,
      "Plexu bringt && einen Teller auf dem ein kleines Filetstueck einer "
      "Rothe hervorragend zubereitet worden ist. && laeuft schon das "
      "Wasser im Mund zusammen. Mit winzigen Bissen verspeisst && das "
      "Filet und Du hoerst ihn lauten denken . o O ( Ich will mehr !)"
