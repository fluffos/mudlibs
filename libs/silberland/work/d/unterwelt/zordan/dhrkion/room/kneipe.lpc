  );

  AddDetail( ({ "durst" }),
    "Durst? Genau! Du hast Durst als Du all die leckeren Getraenke siehst."
  );

  AddDetail( ({ "rausch","dinge" }),
    "In den kann man schnell verfallen, wenn man zuviel Alkohol geniesst. "
    "Manchmal tut man dann auch Dinge, die man nuechtern nicht machen wuerde."
  );

  AddDetail( ({ "alkohol","drogen" }),
    "Nur eine der vielen Drogen. Aber er schmeckt ja auch soooo gut ;)"
  );

  AddDetail( ({ "getraenk","getraenke","feine getraenke" }),
    "Die Getraenke sehen sehr lecker aus. Lass Dir doch mal das 'Menue' von "
    "Plexu geben und such Dir etwas aus."
  );

  AddDetail( ({ "ecken","ecke" }),
    "Die Kneipe hat insgesamt vier Ecken."
  );

  AddDetail( ({ "finger" }),
    "Deine Finger sind zwar nicht ganz sauber. Aber das stoert hier nicht."
  );

  AddDetail( ({ "essen" }),
    "Leckeres Essen wird hier serviert. Schau Dir doch mal das 'Menue' von "
