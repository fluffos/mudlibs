#include "../def.h"

// inherit "/d/unterwelt/zordan/dhrkion/room/pub";
inherit "std/pub.lpc";

#include <rooms.h>
#include <properties.h>
#include <language.h>
#include <pub.h>
#include <moving.h>
#include "/gilden/bardengilde/barden_extern.h"

int geld;

void create()
{
  ::create();

  geld = 100+random(200);

  SetProp( P_INT_SHORT, "Plexus Kneipe" );
  SetProp( P_INT_LONG,
    "Ungewoehnlich grell fuer diese Gegend erscheint Dir die Kneipe von "
    "Plexu. Erst spaeter bemerkst Du, dass das Licht hier von seltsamen "
    "Gebilden in Wand und Decke entsteht. Viele Dunkelelfen haben sich hier "
    "versammelt, um sich nach einem harten Arbeitstag bei einem kleinen "
    "Drink auszuruhen. Die Kneipe selber besteht vollstaendig aus Holz. An "
    "der Theke kannst Du Dir bestimmt das 'Menue' von Plexu geben lassen."
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_CAVE]) );

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "plexu");
  SetProp(P_PUBKEEPER_NAME, "Plexu");
  SetProp(P_PUBMSG_NOKEEPER,
    "Plexu ist zur Zeit nicht da. Du solltest es spaeter nochmal versuchen.\n");
  SetProp(P_PUBMSG_NOENEMY,
    "Glaubst Du Plexu ist so dumm und verkauft Dir was wenn Du gegen ihn kaempfst?\n");
  SetProp(P_PUBMSG_NOINVITE,
    "Plexu wird kaum seinen Feinden etwas bringen.\n");
  SetProp(P_PUBMSG_FIGHTING,
    "Plexu hat leider gerade wichtigere Dinge zu tun.\n");

  AddDrink("Felsquellwasser", ({"felsquellwasser", "quellwasser","wasser"}),
    10, 5, 0, 2,
    ({"Plexu nimmt ein kleines Kristallglas und fuellt es mit einer etwas "
      "braeunlich aussehenden Fluessigkeit. Du nimmst das Glas und trinkst "
      "es aus. Zuerst kommt Dir das kalte und etwas dickfluessige Wasser "
      "komisch auf der Zunge vor. Letztendlich fuehlst Du Dich aber erfrischt."
     ,
      "Plexu nimmt ein kleines Kristallglas und fuellt es mit einer etwas "
      "braeunlich aussehenden Fluessigkeit. && nimmst das Glas und trinkt "
      "es aus. Zuerst sieht &! nicht so gluecklich aus. Aber letztendlich "
      "scheint es doch zu schmecken."
     })
  );

  AddDrink("Rothemilch", ({"rothemilch", "milch"}),
    15, 0, 0, 7,
    "rothemilch"
  );

  AddDrink("Paladinblut", ({"paladinblut", "blut"}),
    120, ({ 15,20,0 }), 0, 5,
    ({"Plexu fuellt Dir einen Becher mit einer dunkelroten Fluessigkeit. "
      "Als Du den Becher austrinkst, merkst Du, dass die Fluessigkeit "
      "wirklich warm und klebrig ist. Aber vielleicht ist es ja auch nur "
      "Himbeersirup, denkst Du Dir und trinkst den Becher in einem Zug aus. "
     ,
      "Plexu fuellt && einen kleinen Becher mit einer dunkelroten "
      "Fluessigkeit. &! trinkt den Becher mit einem Zug aus. Dich gruselt "
      "etwas, Blut zu trinken. "
     })
  );

  AddDrink("Plexus Spezial", ({"plexus spezial", "plexu spezial", "spezial"}),
    960, ({ 110,0,10 }), 17, 4,
    ({"Plexu grinst Dich an und verschwindet kurz. Er kommt kurz darauf "
      "mit einer winzigen Flasche wieder und fuellt Dir damit ein noch "
      "viel winzigereres Glaeschen. Verrueckt wie Du bist schluckst Du die "
      "paar Tropfen schnell runter. Dein Koerper scheint die Fluessigkeit "
      "zu moegen, Dein Geist allerdings nicht."
     ,
      "Plexu grinst && an und verschwindet kurz. Er kommt kurz darauf "
      "mit einer winzigen Flasche wieder und fuellt &3 damit ein noch "
      "viel winzigereres Glaeschen. Verrueckt wie && ist schluckt &! die "
      "paar Tropfen schnell runter."
     })
  );

  AddDrink("Dunkelschnaps", ({"dunkelschnaps", "schnaps"}),
    800, ({ 40,60,10 }), 7, 1, "schnaps_trinken"
  );

  AddDrink("Muntermacher", ({"muntermacher", "macher"}),
    1000, ({ 40,50,10 }), -2, 5,
    ({"Plexu fuellt Dir einen kleinen Krug mit einer dampfenden Sosse. "
      "Als Du den Krug leerst zuckt Dein ganzer Leib. Du fuehlst Dich "
      "danach allerdings wirklich munterer und nuechterner."
     ,
      "Plexu fuellt && einen kleinen Krug mit einer dampfenden Sosse. "
      "Als &! den Krug leert zuckt &? ganzer Leib."
     })
  );
/*
  AddFood("Wuermersuppe", ({"wuermersuppe","wuermer", "suppe"}),
    20, ({10,15,5}), 8,
    ({"Plexu nimmt einen Teller und fuellt Dir eine ekelhafte Suppe hinein. "
      "Kleine Wuermer schwimmen in ihr und Du magst die Suppe eigentlich "
