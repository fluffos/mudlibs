
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Eine kleine Hoehle" );
  SetProp( P_INT_LONG,
    "In diesem Hoehlenabschnitt ist eher weniger los. Ein paar Spuren "
    "auf dem Boden verraten allerdings, dass hier staendig etwas los sein "
    "muss." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle","abschnitt","hoehlenabschnitt" }), 
    QueryProp(P_INT_LONG));

  AddDetail( ({ "spur","spuren" }),
    "Die Spuren sind massenhaft vorhanden. Sie erinnern Dich auch an Deine "
    "eigenen.");

  AddDetail( ({ "boden" }),
    "Auf dem Boden waechst ein wenig Moos und bis auf die Spuren ist er "
    "eher langweilig.");

  AddDetail( ({ "moos" }),
    "Das Moos waechst hier nicht so schoen. Es fehlt wohl das Wasser.");

  AddDetail( ({ "wasser" }),
    "Ein wenig Wasser rieselt durch eine kleine Ritze im Osten und "
    "befeuchtet das Moos.");

  AddDetail( ({ "ritze","ritz" }),
    "Die ist wirklich winzig klein und es fliesst nur sehr sehr wenig "
    "Wasser hindurch.");

  AddDetail( ({ "decke" }),
    "Die Decke ist nicht weit ueber Dir. Aber Du kannst hier leicht "
    "stehen.");

  AddDetail( ({ "wand","waende" }),
    "Die Waende sind hier aus sehr robustem Fels. An der Westwand faellt "
    "Dir etwas auf.");

  AddDetail( ({ "fels" }),
    "Sehr harter und robuster Fels.");

  AddDetail( ({ "westwand" }),
    "Huch, an der Westwand befinden sich vier Knoepfe. Weiss der Kuckuck "
    "wofuer die sind.");

  AddDetail( ({ "kuckuck" }),
    "*Kuckuck*");

  AddDetail( ({ "knoepfe","knopf" }),
    "Was koennte man bloss mit einem Knopf machen?");

  AddSound( DEFAULT_SOUND,
    "Du kannst nichts hoeren. Oder doch? Ein paar Schritte kommen aus dem "
    "Suedwesten.");
    
  AddSound( "schritt","schritte",
    "Die Schritte kommen aus dem Suedwesten.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach nichts.");

  AddCmd( ({ "drueck","druecke" }) , "drueckfkt" );

  AddExit( "nordwesten", "./wall-e9" );
  AddExit( "suedwesten", "./wall-e11" );
}

int drueckfkt(string str) {
  string was;
  int nummer;
  nummer=0;
  was="";
  notify_fail("Was willst Du druecken?\n");
  if (!str) return 0;
  notify_fail("Welchen Knopf willst Du druecken?\n");
  if (str == "knopf") return 0;
  notify_fail("Was willst Du druecken?\n");
  if (sscanf(str,"%s %d",was,nummer) != 2) return 0;
  if (was != "knopf") return 0;
  notify_fail("Welchen Knopf willst Du druecken?\n");
  if ( nummer<1 || nummer>4 ) return 0;
  write("Du drueckst den "+nummer+". Knopf.\n");

  switch (nummer) {
    case 1: call_other( ROOM "wall-e11" , "changebutton" , 1);
            call_other( ROOM "wall-e11" , "changebutton" , 3);
            break;
    case 2: call_other( ROOM "wall-e11" , "changebutton" , 1);
            call_other( ROOM "wall-e11" , "changebutton" , 4);
            break;
    case 3: call_other( ROOM "wall-e11" , "changebutton" , 2);
            call_other( ROOM "wall-e11" , "changebutton" , 6);
            break;
    case 4: call_other( ROOM "wall-e11" , "changebutton" , 3);
            call_other( ROOM "wall-e11" , "changebutton" , 5);
            break;
    default: write("BUUUUUUUUUUUUG :(((((((\n");
             break;
  }
  return 1;
}
