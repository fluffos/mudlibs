#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  AddCmd( ({"quit","ende","disco"}) , "cmd_ende");

  NewDoor("raus", ROOM "gef-d7" , ({"tuer","tor"}) ,
    ({D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL
     ,D_SHORT, "Eine schwere Eisentuer."
     ,D_LONG,  "Eine schwere Eisentuer, welche sehr stabil aussieht. Die "
               "grossen Angeln halten die Tuer fest in den Mauern. Wenn "
               "die Tuer verschlossen wird, gibt es wohl kein entrinnen aus "
               "dieser Zelle. "
     ,D_NAME,  "Tuer"
     ,D_GENDER,FEMALE
     ,D_OPENTESTFUNC, "doortest"
     ,D_MSGS,    ({"durch die Tuer","verlaesst die Zelle","kommt herein"})
     ,D_OPENMSG, ({"Mit einem leisen Quietschen oeffnest Du die Tuer.",
                   "Mit einem leisen Quietschen oeffnet %s die Tuer.",
                   " wird mit leisem Quietschen von aussen geoeffnet."})
     ,D_CLOSEMSG, ({"Mit einem leisen Quietschen schliesst Du die Tuer.",
                   "Mit einem leisen Quietschen schliesst %s die Tuer.",
                   " wird mit leisem Quietschen von aussen geschlossen."})
     ,D_RESET_CLOSEMSG, " wird von einen kleinen Windstoss geschlossen."
     })
  );

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist es, hier heraus zu finden.\n");
  return 0;
}

void SetThisDoor(int dstatus)
{
  DOOR_MASTER->SetDoorStatus(ROOM "gef-d7",dstatus,TO);
}

int QueryThisDoor()
{
  return DOOR_MASTER->QueryDoorStatus(ROOM "gef-d7",TO);
}

int doortest()
{
  tell_object(TP,BS(
    "Die Tuer ist aber geschlossen! Oh mein Gott, Du bekommst langsam "
    "echte Panik und schuettelst und ruettelst an der Tuer. Doch es hilft "
    "alles nichts. Ohne Hilfe von Draussen wirst Du hier nicht wieder "
    "herauskommen!!!\n" )
  );

  tell_room(TO,CAP_TPN+" ruettelt verzweifelt an der Tuer.\n", ({TP}) );

  return 1;
}

int cmd_ende(string str)
{
  tell_object(TP,"Eine innere Macht haelt Dich davon ab!\n");
  return -1;
}

