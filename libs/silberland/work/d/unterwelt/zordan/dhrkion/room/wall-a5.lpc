#include "../def.h"

inherit ROOM "wall_inh.lpc";

void create()
{
  richtung = "osten";
  langadd = "";
  ::create();

  AddDetail( "durchgang",
    "Durch den Durchgang kannst Du Dhrkion betreten." );

  AddDetail( "osten",
    "Im Osten ist ein kleiner Durchgang mit einem Tor in den Schutzwall "
    "eingelassen." );

  AddItem( NPC "drider", REFRESH_DESTRUCT);

  AddExit( "suedosten"  , "./wall-b6" );
  AddExit( "nordosten"  , "./wall-b4" );

  NewDoor("osten", ROOM "weg-b5" , ({"tor","stadttor"}) ,
    ({D_FLAGS,DOOR_OPEN
     ,D_SHORT, "Ein maechtiges Stadttor. Es ist %s."
     ,D_LONG,  "Eim maechtiges Stadttor, welches im Angriffsfall geschlossen "
               "wird. Damit ist Dhrkion sehr gut geschützt und kann leicht "
               "verteidigt werden. Das Tor besteht aus Holz, ist aber "
               "mit Metall verstaerkt worden. "
     ,D_NAME,  "Tor"
     ,D_GENDER,NEUTER
     ,D_OPENTESTFUNC,  "opendoortest"
     ,D_CLOSETESTFUNC, "closedoortest"
     ,D_MSGS,  ({"Dhrkion durch das Stadttor","betritt"
                ,"kommt durch das Stadttor herein"})
     })
  );

}

void SetThisDoor(int dstatus)
{
  DOOR_MASTER->SetDoorStatus(ROOM "weg-b5",dstatus,TO);
}

int QueryThisDoor()
{
  return DOOR_MASTER->QueryDoorStatus(ROOM "weg-b5",TO);
}

int opendoortest()
{
  tell_object(TP, BS("Das Tor ist viel zu schwer, als das Du es mit der Hand "
                   "oeffnen koenntest. "));

  tell_room(TO, BS(CAP_TPN+" versucht das Tor mit der Hand zu oeffnen, ist "
                   "aber viel zu schwach dazu."), ({ TP }) );

  return 1;
}

int closedoortest()
{
  tell_object(TP, BS("Das Tor ist viel zu schwer, als das Du es mit der "
                     "Hand schliessen koenntest. "));

  tell_room(TO, BS(CAP_TPN+" versucht das Tor mit der Hand zu schliessen, "
                   "ist aber viel zu schwach dazu."), ({ TP }) );

  return 1;
}

