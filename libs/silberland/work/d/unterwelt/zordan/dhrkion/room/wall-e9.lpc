/*
   Dhrkion, die Dunkelelfenstadt - Zordan@SL
*/

#include "../def.h"
#include <properties.h>

inherit ROOM "wall_inh.lpc";

create() {
  richtung = "norden";
  ::create();

  AddItem( NPC "drider", REFRESH_DESTRUCT);

  AddExit( "nordosten"   , "./wall-f8" );
  AddExit( "nordwesten"  , "./wall-d8" );
  AddExit( "suedosten"   , "./wall-f10" );
  AddExit( "suedwesten"  , "./wall-d10" );
}
