#include "../def.h"

inherit "std/room";

string *creatures;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer kleinen Hoehle" );
  SetProp(P_INT_LONG,
    "Du findest Dich in einer winzigen Hoehle wieder. Hier findet sich "
    "eigentlich nicht viel. Nur ein paar kleine Tiere befinden sich in "
    "ihr. Der Boden, die Decke und die Waende sind aus dunklem Fels."
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "fels" }),
    "Der Fels ist wie ueberall in der Unterwelt tief schwarz.");

  AddDetail( ({ "unterwelt" }),
    "Ja genau, in der Unterwelt befindest Du Dich gerade.");

  AddDetail( ({ "felsgestein","gestein" }),
    "Das Gestein ist sehr dunkel. Du hast aber keine Lust es zu hacken.");

  AddDetail( ({ "lust" }),
    "Ne, Du hast wirklich keine Lust dazu.");

  AddDetail( ({ "tiere","tier" }),
    "Das sind wirklich sehr kleine Tiere. Genau richtig fuer einen "
    "Anfaenger.");

  AddDetail( ({ "boden" }),
    "Der Boden ist aus ganz normalem Felsgestein. Es liegt nichts herum.");

  AddDetail( ({ "wand","waende" }),
    "Vor langer Zeit waren die Waende wohl mal mit Moos bewachsen. Jetzt "
    "ist es dafuer aber viel zu trocken in dieser Hoehle.");

  AddDetail( ({ "moos" }),
    "Du findest jetzt kein Moos mehr. Alles ist verdorrt.");

  AddDetail( ({ "decke" }),
    "Die Decke ist gerade hoch genug, dass Du aufrecht drin stehen "
    "kannst.");

  AddDetail( ({ "hoehle" }),
    "In dieser Hoehle passiert nicht viel. Sie ist klein und wurde wohl "
    "mal vor langer Zeit gebraucht. Jetzt aber nicht mehr.");

  AddDetail( ({ "zeit" }),
    "Das muss schon ewig her sein.");

  AddSmell( ({ DEFAULT_SMELL }),
    "Es riecht hier eigentlich nach gar nichts." );

  AddSound( ({ DEFAULT_SOUND }),
    "In weiter Ferne hoert man Wasser rauschen." );

  AddDetail( ({ "wasser" }),
    "Du kannst es nicht sehen, nur rauschen hoeren.");

  AddSound( ({ "wasser","rauschen" }),
    "Undefinierbar weit weg hoerst Du Wasser rauschen." );

  AddSpecialDetail( "anfaenger","detail_anfaenger" );

  AddSpecialExit( "ausgang", "exit_ausgang" );
  SetProp(P_HIDE_EXITS, ({"ausgang"}) );

  creatures = ({NPC "kakalake"
               ,NPC "ameise"
               ,NPC "schmetterling"
               ,NPC "wurm"
               });

}

int exit_ausgang(string str)
{
  notify_fail("Ja, wo ist der denn, der Ausgang?\n");
  return 0;
}

string detail_anfaenger(string str)
{
  if(IS_SEER(TP)) return BS(
    "Als Seher solltest Du das wirklich besser wissen!!! Du Wurstie!!!");

  if(TP->QueryProp(P_LEVEL)>30) return BS(
    "Dich als Anfaenger zu bezeichnen waere eine Luege der uebelsten Sorte.");

  if (TP->QueryProp(P_LEVEL)>20) return BS(
    "Nein, Du bist nun wirklich kein Anfaenger mehr.");

  if (TP->QueryProp(P_LEVEL)>15) return BS(
    "Eigentlich solltest Du schon eine Menge kennen.");

  if (TP->QueryProp(P_LEVEL)>10) return BS(
    "Du duerftest schon ein paar Sachen kennen.");

  if (TP->QueryProp(P_LEVEL)>5) return BS(
    "Du hast Dich zumindest schon ein wenig umgesehen.");

  return "Du bist blutiger Anfaenger. Genau richtig bist Du hier.\n";
}
