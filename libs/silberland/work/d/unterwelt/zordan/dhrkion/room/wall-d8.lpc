#include "../def.h"

inherit ROOM "wall_inh.lpc";

create() {
  richtung = "nordosten";
  langadd="Im Suedwesten ist eine kleine Hoehle. Du kannst sie betreten.";
  ::create();
  AddExit( "suedosten"   , "./wall-e9" );
  AddExit( "westen"      , "./wall-c8" );
  AddExit( "suedwesten"  , "./park-c9" );
}
