#include "../def.h"

inherit ROOM "inh-gef.lpc";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Zelle");
  SetProp(P_INT_LONG,
    "In dieser Zelle scheint man den Gefangenen einen anderen Willen "
    "aufzwingen zu wollen. Ueber einem glutrotem Feuer ist ein kleines "
    "Gestell aus Metall angebracht. An den stinkenden Ueberresten an dem "
    "Gestell kannst Du genau erkennen, dass der letzte Gefangene wohl "
    "nicht so einsichtig gewesen sein kann und man ihn quallvoll "
    "umgebracht haben muss. Die Waende und der Boden sind mit dicken "
    "Ballen verstaerkt worden, damit die Schreie wohl nicht so nach "
    "draussen dringen koennen. Eine Tuer fuehrt Dich wieder raus hier."
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 50, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "zelle" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "decke" }),
    "Auch die Decke ist mit diesen Ballen verstaerkt worden. Allerdings "
    "sind die Ballen dort schon ziemlich schwarz geworden. Das muss wohl "
    "am Russ liegen."
  );

  AddDetail( ({ "russ" }),
    "Dicker schwarzer Russ ist auf den Ballen an der Decke."
  );

  AddDetail( ({ "waende","wand","boden" }),
    "Die sind mit dicken Ballen verstaerkt worden, damit man die lauten "
    "Schreie der Gefangenen draussen nicht hoeren kann."
  );

  AddDetail( ({ "ballen" }),
    "Die Ballen sind aus Wolle."
  );

  AddDetail( ({ "wolle","laut" }),
    "Das ist ganz dicke Wolle, die keinen Laut durch sich hindurch lassen."
  );

  AddDetail( ({ "ueberreste" }),
    "Buah. Du schreckst zusammen und wendest Dich ab."
  );

  AddDetail( ({ "gestell" }),
    "Auf dem Gestell aus Metall bindet man die Gefangenen fest und braet "
    "sie. Es haengen noch Ueberreste des letzten Gefangenen daran herunter."
  );

  AddDetail( ({ "metall" }),
    "Das ist ein besonders hitzebestaendiges Metall."
  );

  AddDetail( ({ "feuerstelle" }),
    "Die Feuerstelle wurde gemauert. Nur Verrueckte wuerden in die "
    "Feuerstelle greifen."
  );

  AddDetail( ({ "verrueckte" }),
    "Bist Du so verrueckt?"
  );

  AddDetail( ({ "schreie" }),
    "Derzeit ist hier kein Gefangener auf dem Feuer. Deshalb ist es auch "
    "so still. Du moechtest auch eigentlich gar nicht dabei sein, wenn "
    "hier ein Gefangener liegt. Das wuerdest naemlich Du sein."
  );

  AddDetail( ({ "feuer" }),
    "In einer gemauerten Feuerstelle brennt ein hell loderndes Feuer. Es "
    "wird wohl von den vorherigen Gefangenen gefuettert. Oerkz. Deshalb "
    "stinkt es hier auch so."
  );

  AddDetail( ({ "gefangenen","gefangene","gefangener" }),
    "Hierher bringt man die armen Gefangenen und zwingt ihnen den Willen "
    "ihrer Koenigin auf. Wenn sie darauf nicht reagieren, werden sie wohl "
    "einfach umgebracht."
  );

  AddDetail( ({ "willen" }),
    "Hier zaehlt nur der Wille der Koenigin."
  );

  AddDetail( ({ "koenigin","palast" }),
    "Die Koenigin sitzt sicher warm in ihrem Palast. Sie hat das absolute "
    "Sagen."
  );

  AddDetail( ({ "sagen" }),
    "??? Das bezweifelst Du wohl nicht, oder?"
  );

  AddSound( ({ DEFAULT_SOUND }),
    "Du bist zu ueberwaeltigt von dem Anblick und vermagst kein Geraeusch "
    "auseinanderzuhalten."
  );

  AddSmell( ({ DEFAULT_SMELL }),
    "Der Geruch verwesender Leichen ist hier deutlich zu riechen."
  );

  AddSmell( ({ "geruch","leichen","leiche" }),
    "Baeh stinkt das hier nur. Du haeltst Dir die Nase zu."
  );

  AddCmd( ({ "greife","greif" })      , "cmd_greifen" );
}

//--------------------------------------------------------------------------
// Runenquest -> 2. Ort wo eine Rune sein kann
//--------------------------------------------------------------------------

int cmd_greifen(string str)
{
  object ob, *handschuhe;
  string s;
  int i;

  notify_fail("In was moechtest Du greifen?\n");

  if(!str || str =="") return 0;
  if(!(str == "feuerstelle"                   ||
       str == "in feuerstelle"                ||
       str == "in die feuerstelle"            ||
       str == "in feuerstelle trotz warnung"  )) return 0;


  handschuhe = filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_GLOVE);

  if (str == "in feuerstelle trotz warnung" )
  {
    if(!sizeof(handschuhe) || !objectp(handschuhe[0]))
    {
      tell_object(TP,BS("Du greifst in die Feuerstelle und es passiert was "
                        "geschehen musste. Du verbrennst Dir beide Haende "
                        "so dermassen, dass Du hoellisch aufschreist und "
                        "Deine Waffe nicht mehr fuehren kannst!"));

      if(ob=TP->QueryProp(P_WEAPON)) ob->DoUnwield();

      SetProp(P_KILL_NAME, "Ein heisses Feuer");
      SetProp(P_KILL_MSG, "*BRUZZEL*");

      TP->do_damage(30+random(30));

      return -1;
    }
  }

  if(!sizeof(handschuhe) || !objectp(handschuhe[0]))
  {
    tell_object(TP,BS("Mit Deinen blossen Haenden wuerdest Du Dir sofort "
                      "Deine Haende verbrennen! Du kannst aber \"greife "
                      "in Feuerstelle trotz Warnung\" machen, wenn Du "
                      "wirklich unbedingt willst." ));
    return -1;
  }

  switch(RUNENMASTER->GetRune(getuuid(TP), 2))
  {
    case 1:
      s = "Du greifst in die Feuerstelle und findest tatsaechlich eine "
          "kleine Rune. Du steckst sie sofort ein.";
      break;

    case -1:
      s = "Du greifst in die Feuerstelle und findest tatsaechlich eine "
          "kleine Rune, die jedoch viel zu schwer ist und Du sie deshalb "
          "liegen laesst. ";
      break;

    default:
      s = "Du greifst in die Feuerstelle und tastest eine kurze Zeit "
          "darin herum. Doch finden kannst Du leider nichts!";
      break;
  }

  tell_object(TP,BS(s));

  return 1;
}

