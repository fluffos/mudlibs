#include "../def.h"

inherit ROOM "inh-wohngebiet";

#include <properties.h>
#include <language.h>

int found;

void create()
{
  ::create();

  found = 0;

  AddDetail( ({ "pfad" }),
    "Welchen Pfad meinst Du? Es gibt hier dutzende davon. Auf einem stehst "
    "Du halt gerade so herum. Seltsam, genau hier scheint ein kleines Loch "
    "im Boden zu sein.");

  AddDetail( ({ "loch" }),
    "Ein unscheinbares Loch ist hier tatsaechlich im Boden. Was da wohl "
    "drin sein mag?");

  AddItem( NPC "drow", REFRESH_DESTRUCT);

  AddCmd( ({ "greif","greife" }), "cmd_greifen" );

  AddExit( "osten",      ROOM "weg-g6" );
  AddExit( "suedosten",  ROOM "weg-g7" );
  AddExit( "sueden",     ROOM "weg-f7" );
  AddExit( "suedwesten", ROOM "weg-e7" );
}

void reset()
{
  ::reset();

  found = 0;
}

//--------------------------------------------------------------------------
// Runenquest -> 3. Ort wo eine Rune sein kann
//--------------------------------------------------------------------------

int cmd_greifen(string str)
{
  string s;

  notify_fail("Wo hinein willst Du greifen?\n");

  if(!str || str == "") return 0;
  if(!(str == "loch"           ||
       str == "in loch"        ||
       str == "in loch hinein" )) return 0;

  tell_room(TO,TPN+" greift in ein Loch im Boden.\n", ({TP}) );

  if(found == 0)
  {
    tell_object(TP,BS("Du greifst in das Loch und findest eine Fackel, die "
                      "Du sofort einsteckst. Irgendwie bist Du aber der "
                      "Meinung, dass noch mehr in dem Loch sein koennte." ));

    CLONE("/obj/fackel",TP);
    found = 1;
    return 1;
  }

  switch(RUNENMASTER->GetRune(getuuid(TP), 3))
  {
    case 1:
      s = "Du greifst in das kleine Loch im Boden und findest eine kleine "
          "Rune. Du steckst sie natuerlich sofort ein.";
      break;

    case -1:
      s = "Du greifst in das kleine Loch im Boden und kannst etwas kleines "
          "ertasten. Aber es ist zu schwer, um es herauszuziehen. ";
      break;

    default:
      s = "Du greifst in das Loch und irgendein Tier beisst Dir in den "
          "Finger.";
      TP->AddHp(-5-random(5));
      break;
  }

  tell_object(TP, BS(s));

  return 1;
}
