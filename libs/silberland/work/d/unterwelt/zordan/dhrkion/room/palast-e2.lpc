int entfroschfkt(string str) {
  if (TP->QueryMoney() < ENTFROSCHEPREIS) {
    write(MAGIER("Das Entfroschen ist nicht einfach und deshalb muss ich Dir "
      "dafuer "+ENTFROSCHEPREIS+" Muenzen abnehmen. Soviel hast Du aber leider "
      "nicht bei Dir."));
    return 1;
  }
  if (TP->QueryProp(P_FROG)) {
    write(MAGIER("Ok, so sei es."));
    write(BS(
      "Der Magier spricht eine magische Formel aus und Du fuehlst eine "
      "starke Magie durch Deinen Koerper fliessen. Du hast jetzt Deinen "
      "normalen Koerper wieder und gibst dem Magier die "+ENTFROSCHEPREIS+
      "Muenzen."));
    TP->SetProp(P_FROG, 0);
    TP->AddMoney(-ENTFROSCHEPREIS);
    ZENTRALBANK->PayIn(ENTFROSCHEPREIS);
  } else {
    write(MAGIER("Aber Du bist doch gar kein Frosch. Wozu soll ich Dich dann "
      "entfroschen?"));
  }
  return 1;
}

int entgiftefkt(string str) {
  int preis;
  preis=TP->QueryProp(P_POISON) * ENTGIFTEPREIS;
  if (TP->QueryMoney() < preis) {
    write(MAGIER("Das Entgiften ist wirklich schwer und deshalb muss ich Dir "
      "dafuer "+preis+" Muenzen berechnen. Soviele Muenzen hast Du aber leider "
      "zur Zeit nicht bei Dir."));
    return 1;
  }
  if (!TP->QueryProp(P_POISON)) {
    write(MAGIER("Aber Du bist ja gar nicht vergiftet. Fuer meine Untersuchung "
      "muss ich Dir aber trotzdem "+ENTGIFTEPREIS+" Muenzen abnehmen."));
    TP->AddMoney(-ENTGIFTEPREIS);
  } else {
    write("Der Magier faengt an Dich zu untersuchen.\n");
    switch(TP->QueryProp(P_POISON)) {
      default: write(MAGIER("Uiui. Du bist kurz vorm Sterben. Besser ich "
                 "beeil mich."));
               break;
      case  1: write(MAGIER("Du bist nur sehr leicht vergiftet. Das bekommen "
                 "wir schnell hin."));
               break;
      case  2: write(MAGIER("Du bist nur wenig vergiftet. Das ist nicht schwer."));
               break;
      case  3: write(MAGIER("Du bist schon ganz gut vergiftet. Aber das "
                 "schaffe ich schon. Nur keine Angst."));
               break;
      case  4: write(MAGIER("Du bist wirklich gut vergiftet. Mal sehen ob ich "
                 "das schaffe."));
               break;
      case  5: write(MAGIER("Du bist schon hart am Kaempfen mit dem Gift. "
                 "Das naechste Mal sei bloss vorsichter."));
               break;
      case  6: write(MAGIER("Du kaempfst schon sehr hart mit dem Gift. Ich "
                 "werde Dir ein wenig mehr Gegengift geben."));
               break;
      case  7: write(MAGIER("Du bist schwer vergiftet. Solch ein schweres "
                 "Gift sieht man selten."));
               break;
      case  8: write(MAGIER("Du bist sehr schwer vergiftet. Ob mein Gegengift "
                 "da noch was machen kann, weiss ich nicht genau."));
               break;
      case  9: write(MAGIER("Wo hast Du Dich bloss rumgetrieben? Dich hat "
                 "es ja wirklich schwer getroffen."));
               break;
    }
    write(BS("Der Magier floesst Dir ein Gegengift ein und kurz darauf "
      "bist Du wieder komplett geheilt. Erfreut schaut Dich der Magier an "
      "und Du gibst ihm die "+preis+" Muenzen in die Hand."));
    TP->AddMoney(-preis);
    ZENTRALBANK->PayIn(preis);
    TP->SetProp(P_POISON, 0);
  }
  return 1;
}

string koeniginfkt(string str) {
  if(!present("koenigin")) {
    return "Oh, wo ist sie denn hin?\n";
  } else {
    return "Sie sitzt doch auf ihrem Thron!\n";
  }
}
