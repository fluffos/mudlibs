#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Wohngebiet in Dhrkion");
  SetProp( P_INT_LONG,
    "Du stehst jetzt im Wohnbereich von Dhrkion. Unschwer zu erkennen sind "
    "diverse Erhebungen und Hoehlen ueberall hier. Der Koenigin scheint "
    "das Wohlergehen ihres Volkes sehr am Herzen zu liegen. So schoen und "
    "reich verziert stellt sich hier alles dar. Auf den schmalen Pfaden "
    "zwischen den Wohnungen laufen einige Dunkelelfen geschaeftig hin und "
    "her. "
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "wand","waende" }),
    "Unzaehlbar viele Waende gibt es hier. Die Wohnungen haben halt alle "
    "mindestens vier davon. Nicht eine Wand faellt Dir besonders auf."
  );

  AddDetail( ({ "boden" }),
    "Auf dem Boden findet sich ein wenig Erde und wo Du stehst scheint ein "
    "kleiner Pfad zu sein."
  );

  AddDetail( ({ "erde" }),
    "Die frische Erde kommt von den Neubauten der letzten Zeit. Du "
    "kannst die frische Erde foermlich riechen. "
  );

  AddDetail( ({ "decke" }),
    "Du kannst nichts an der Decke erkennen."
  );

  AddDetail( ({ "pfad" }),
    "Welchen Pfad meinst Du? Es gibt hier dutzende davon. Auf einem stehst "
    "Du halt gerade so herum."
  );

  AddDetail( ({ "pfade" }),
    "Zwischen den Behausungen sind verschlungene Pfade in die Felsen "
    "geschlagen worden, damit auch jeder seine Behausung sicher erreichen "
    "kann. Allerdings sind sie auch nicht so dermassen ausgebaut worden. "
    "Es reicht halt aus, mehr nicht."
  );

  AddDetail( ({ "volk" }),
    "Das Volk der Dunkelelfen ist groesser als viele denken oder besser "
    "gesagt wissen."
  );

  AddDetail( ({ "wohlergehen" }),
    "Den Dunkelelfen geht es hier wirklich gut. Niemand scheint sich zu "
    "beschweren. Oder traut sich etwa nur keiner?"
  );

  AddDetail( ({ "koenigin" }),
    "Die Koenigin scheint fuer ihre Untertanen wirklich ein offenes Herz "
    "zu haben. Man versucht in dieser unwirklichen Umgebung den Dunkelelfen "
    "doch ein Gefuehl der Heimat zu vermitteln."
  );

  AddDetail( ({ "untertanen","untertan" }),
    "Alle die sich in Dhrkion befinden sind der Koenigin Untertan. Auch Du!"
  );

  AddDetail( ({ "herz" }),
    "Das Herz der Koenigin erscheint doch tatsaechlich friedvoll. Aber Du "
    "bist Dir recht sicher, dass es das in neun von zehn Faellen nicht ist."
  );

  AddDetail( ({ "umgebung","unterwelt" }),
    "Die Unterwelt ist eine boesartige und dunkle Umgebung."
  );

  AddDetail( ({ "gefuehl","heimat" }),
    "Die Dunkelelfen fuehlen sich hier heimisch. Ja, so ist es wirklich."
  );

  AddDetail( ({ "faelle","fall" }),
    "Oder waren es 99 von 100?"
  );

  AddDetail( ({ "stelle" }),
    "Diese Stelle hier ist einfach nur genial gelegen."
  );

  AddDetail( ({ "fels","felsen" }),
    "Die Felsen scheinen hier nicht so hart zu sein wie sonst ueberall "
    "in der Stadt. Eine echt geeignete Stelle fuer ein paar schoene "
    "Behausungen."
  );

  AddDetail( ({ "erdreich" }),
    "Zwischen manchen Felsen kannst Du sogar das Erdreich erahnen. Allerdings "
    "ist es meistens wirklich blanker Fels."
  );

  AddDetail( ({ "neubauten" }),
    "Es sind nicht viele Neubauten. Aber ein oder zwei neue Hoehlen oder "
    "Erhebungen kannst Du schon erkennen."
  );

  AddDetail( ({ "duft" }),
    "Sowas wie Duft kannst Du nicht sehen."
  );

  AddDetail( ({ "wohnbereich","bereich" }),
    "Der Wohnbereich von Dhrkion ist noch nicht so alt. Aber es sind "
    "viele alte und neue Behausungen hier gebaut worden. Wenn Du "
    "Dunkelelf und gewisse Voraussetzungen mitbringen kannst, dann wende "
    "Dich doch mal an einen Magier, wenn Du auch hier wohnen moechtest."
  );

  AddDetail( ({ "dhrkion","stadt" }),
    "Du bist in den Wohnbereich von Dhrkion vorgestossen. Viele Dunkelelfen "
    "jeden Alters sind hier unterwegs."
  );

  AddDetail( ({ "behausungen","behausung","wohnungen","wohnung" }),
    "Es gibt hier zwei Arten von Behausungen. Hoehlen und kleine Erhebungen."
  );

  AddDetail( ({ "dunkelelf" }),
    "Schau in Dich und Du wirst sehen ob Du einer bist."
  );

  AddDetail( ({ "dunkelelfen" }),
    "Die Dunkelelfen hier gehen keiner speziellen Arbeit nach, denn hier "
    "wohnen sie schliesslich. Gearbeitet wird woanders."
  );

  AddDetail( ({ "voraussetzungen","voraussetzung" }),
    "Du musst schon den Seher(in)status und einen gewissen Grad an "
    "Erfahrung mitbringen. Wie gross der sein muss, kann Dir sicher ein "
    "verantwortlicher Magier sagen."
  );

  AddDetail( ({ "magier","ronja","zordan" }),
    "Derzeit sind Ronja und Zordan dafuer zustaendig."
  );

  AddDetail( ({ "alter" }),
    "Ob jung oder alt. Jederman fuehlt sich hier echt wohl."
  );

  AddDetail( ({ "arten" }),
    "Wie gesagt sind es zwei Arten: Hoehlen oder Erhebungen."
  );

  AddDetail( ({ "zutritt" }),
    "Hier steht zwar kein Schild 'Betreten verboten'. Aber Zutritt hast "
    "Du trotzdem keinen."
  );

  AddDetail( ({ "schild" }),
    "Welches Schild?"
  );

  AddDetail( ({ "hoehlen" }),
    "In den unterschiedlich grossen Hoehlen wohnen eher zurueckgezogene "
    "Dunkelelfen. Zutritt hast Du da sicher keinen, es sei denn man hat "
    "es Dir ausdruecklich erlaubt."
  );

  AddDetail( ({ "erhebungen" }),
    "In den Erhebungen wohnen eher die juengeren Dunkelelfen. Ihnen scheint "
    "das Licht auch nicht mehr soviel wie den alten Dunkelelfen auszumachen. "
    "Aber verschlossen fuer Dich sind trotzdem alle Behausungen."
  );

  AddDetail( ({ "hoehle" }),
    "Dir faellt keine Hoehle besonders auf."
  );

  AddDetail( ({ "erhebung" }),
    "Dir faellt keine Erhebung besonders auf."
  );

  AddSound( DEFAULT_SOUND,
    "Erstaunlich ruhig ist es hier im Wohngebiet. Naja, die Dunkelelfen "
    "sind nunmal ein sehr diszipliniertes Volk. "
  );

  AddSmell( ({ DEFAULT_SMELL }),
    "Ein winziger Hauch von Erde erreicht Deine Nase."
  );

  AddSmell( ({ "hauch","erde" }),
    "Frische Erde liegt hier leicht verteilt. Sie riecht sogar sehr frisch. Daraus "
    "kannst Du erahnen, dass hier wohl staendig im Erdreich gearbeitet wird."
  );

  AddSpecialExit( "ausgang", "exit_ausgang" );
  SetProp(P_HIDE_EXITS, ({"ausgang"}) );
}

int exit_ausgang(string str)
{
  notify_fail("Ja, wo ist der denn, der Ausgang?\n");
  return 0;
}

