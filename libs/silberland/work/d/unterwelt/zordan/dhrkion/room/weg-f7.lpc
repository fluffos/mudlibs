#include "../def.h"

inherit ROOM "inh-wohngebiet";

#include <properties.h>
#include <language.h>

void create()
{

  ::create();

  AddDetail( ({ "erhebung" }),
    "Dir faellt eine Erhebung besonders auf."
  );

  AddItem( NPC "spielkind", REFRESH_DESTRUCT);

  AddCmd( ({ "erkletter","erklimme","erklettere","erklimm" }), "cmd_klettern" );

  AddExit( "osten",      "./weg-g7" );
  AddExit( "nordosten",  "./weg-g6" );
  AddExit( "norden",     "./weg-f6" );
  AddExit( "westen",     "./weg-e7" );
}

int cmd_klettern(string str)
{

  notify_fail("Was moechtest Du erklettern?\n");

  if(!str || str == "") return 0;
  if(!(str == "erhebung"         ||
       str == "auf erhebung"     )) return 0;

  tell_object(TP,
    "Du erkletterst wagemutig die Erhebung und hast vor Deinem Sturz "
    "hinunter\neinen tollen Ausblick ueber Dhrkion:\n\n"
    "            S   o\n"
    "    |       |   |\n"
    "    o       L   o\n"
    "  /   \\   /       \\\n"
    "o   T   o - o - o - o\n"
    "  \\ | /           /\n"
    "    o   S - S   o\n"
    "|   | / | x |   |\n"
    "G - o - S - S   o\n"
    "    |         /\n"
    "o   P   o - o\n"
    "  \\   /\n"
    "    o\n" );

  tell_room(TO,BS(TPN+" klettert auf eine der Erhebungen und faellt wieder auf "
                  "den Pfad.\n"), ({TP}) );

  return 1;
}

