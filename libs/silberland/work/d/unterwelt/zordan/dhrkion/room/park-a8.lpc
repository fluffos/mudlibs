#include "../def.h"

inherit ROOM "inh-park.lpc";

int patschen;

void create()
{
  ::create();

  AddDetail( ({ "boden" }),
    "Der Boden ist aus ganz normalem Felsgestein. Da leuchtet doch was "
    "hinter einem Stein. Vielleicht kannst Du danach greifen?");

  AddDetail( ({ "stein" }),
    "Hinter dem Stein liegt etwas. Greif doch mal dahinter.");

  AddItem(creatures, REFRESH_DESTRUCT);
  AddItem(creatures, REFRESH_DESTRUCT);

  AddExit("norden"      , ROOM "park-a7");
  AddExit("suedosten"   , ROOM "park-b9");
  AddExit("ostunten"    , ROOM "tunnel1");

  AddCmd( ({ "greif","greife" }), "cmd_greifen" );

  patschen = 1;
}

void reset()
{
  ::reset();

  patschen = 1;
}

int cmd_greifen(string str)
{
  string s;
  object ob;
  int ret;

  notify_fail("Wo moechtest Du genau greifen?\n");

  if(!str || str == "") return 0;
  if(!(str == "hinter stein"     ||
       str == "hinter den stein" ||
       str == "stein"            )) return 0;

  tell_room(TO, CAP_TPN+" bueckt sich und greift nach etwas.\n", ({ TP }) );

  ret = -1;

  if(patschen == 1)
  {
    s = "Du greifst hinter den Stein und findest ein paar Patschen. Die "
        "muss wohl mal jemand hier verloren haben. ";

    ob = clone_object("/d/ebene/obj/ruestung/patschen");
    if(ob->move(TP, M_GET) == 1)
    {
      s += "Du steckst sie ein.";
      patschen = 0;
      ret      = 1;
    }
    else
    {
      s+= "Da Dir die Patschen allerdings zu schwer sind, versteckst Du sie "
          "wieder, um sie vielleicht spaeter zu holen, wenn Du staerker "
          "geworden bist. ";
    }
  }
  else
  {
    s = "Ach schade, Du greifst hinter den Stein und findest leider "
        "nichts.";
  }

  tell_object(TP, BS(s));

  return ret;
}
