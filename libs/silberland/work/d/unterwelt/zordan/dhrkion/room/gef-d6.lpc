#include "../def.h"

inherit ROOM "inh-gef";

void create()
{

  ::create();

  SetProp( P_INT_SHORT, "Eine Zelle" );
  SetProp( P_INT_LONG,
    "Du findest Dich in einer bitterkalten Gefaengniszelle wieder. Kein "
    "Fenster, ein einfacher Tisch mit einem Stuhl und eine kleine Liege "
    "sind neben den verfaulenden Leichenresten die einzigen Dinge, die Du "
    "hier erkennen kannst. Blut lief wohl mal die Waende herunter, denn "
    "die Waende sind komplett rot."
  );

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_CAVE]) );

  SetProp (P_KILL_MSG,  "Ich habe Selbstmord begangen!");

  AddDetail( ({ "gefaengniszelle","zelle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "gestank" }),
    "Der ist so dermassen grausam, dass Du Dir die Nase zuhalten musst."
  );

  AddDetail( ({ "nase" }),
    "Du hast die Nase geschlossen. Ist auch besser, um zu ueberleben..."
  );

  AddDetail( ({ "waende","wand" }),
    "Die blutverschmierten Waende zeugen von grosser Qual der Gefangenen."
  );

  AddDetail( ({ "qual" }),
    "Man will die Gefangenen hier wohl nur quaelen."
  );

  AddDetail( ({ "gefangene","gefangener" }),
    "Du kannst Dir gut vorstellen, dass die sich nach einer Weile wirklich "
    "selber umbringen wollten."
  );

  AddDetail( ({ "weile","stunden" }),
    "Oder gar nur nach ein paar Stunden?"
  );

  AddDetail( ({ "leichenreste","reste","leichen","boden" }),
    "Alte Leichenresten liegen verstreut am Boden und verpesten die ganze "
    "Zelle. Der Gestank ist kaum auszuhalten."
  );

  AddDetail( ({ "blut" }),
    "Altes, aber auch frisches Blut lief mal die Waende herunter. Jemand "
    "scheint etwas auf die Wand geschrieben zu haben. Den Text kannst Du "
    "leider nicht mehr genau entziffern."
  );

  AddReadDetail( ({ "text" }),
    "'Toete Lloth', 'Gruesst meine Frau' und 'ICH WAR HIER' kannst Du "
    "zwar schwer, aber doch noch entziffern."
  );

  AddDetail( ({ "text" }),
    "Der wurde mit Blut geschrieben.");

  AddDetail( ({ "dinge" }),
    "In dieser Zelle ist nicht viel zu finden."
  );

  AddDetail( ({ "liege" }),
    "Die kleine Liege in der Ecke ist ein kleines Gestell mit einer "
    "harten Matratze."
  );

  AddDetail( ({ "matratze" }),
    "Die Matraze ist schon sehr alt und dreckig. Sie besteht aus einfacher "
    "Wolle."
  );

  AddDetail( ({ "wolle" }),
    "Die Wolle sieht eklig aus. Du wuerdest Dich wohl niemals auf diese "
    "Matraze legen."
  );

  AddDetail( ({ "holz" }),
    "In dem Holz findest Du ein paar Kratzspuren."
  );

  AddDetail( ({ "kratzspuren","spuren" }),
    "Da hat sich wohl mal jemand gelangweilt und an dem Holz herumgepuhlt."
  );

  AddDetail( ({ "gestell" }),
    "Ein einfaches Gestell aus Holz."
  );

  AddDetail( ({ "stuhl" }),
    "Ein kleiner Stuhl, auf dem jede Rasse ihre letzten Stunden zaehlen kann."
  );

  AddDetail( ({ "stunden","stunde" }),
    "Viele Stunden hat man wohl nicht mehr, wenn man erst einmal hier "
    "in der Zelle gelandet ist."
  );

  AddDetail( ({ "rasse","rassen" }),
    "Davon gibt es viele. Auch Du gehoerst einer an."
  );

  AddDetail( ({ "fenster" }),
    "Ich bitte Dich, hier ist KEIN Fenster."
  );

  AddDetail( ({ "tisch" }),
    "Das ist wirklich ein sehr einfacher Tisch. Nicht eine scharfe Kante "
    "hat er. Er sieht auch nicht besonders oft benutzt aus."
  );

  AddDetail( ({ "kante" }),
    "Es koennte ja einer auf die Idee kommen, sich damit selber umzubringen."
  );

  AddDetail( ({ "idee" }),
    "Diese Idee kaeme Dir natuerlich nie. Aber man geht halt sicher."
  );

  AddDetail( ({ "decke" }),
    "Du kannst nichts an der Decke finden. Leider auch kein Seil."
  );

  AddDetail( ({ "seil" }),
    "Mit einem Seil koennte man sich ja glatt erhaengen."
  );

  AddSound( ({ DEFAULT_SOUND }),
    "Du bist zu ueberwaelltigt von dem Anblick und vermagst kein Geraeusch "
    "auseinanderzuhalten."
  );

  AddSmell( ({ DEFAULT_SMELL }),
    "Der Geruch verwesender Leichen ist hier deutlich zu riechen."
  );

  AddSmell( ({ "geruch","leichen","leiche" }),
    "Baeh stinkt das hier nur. Du haeltst Dir die Nase zu."
  );

  AddDetail( ({ "ecke" }),
    "Die Zelle hat vier Ecken. In einer steht eine Liege in einer anderen "
    "ein Tisch."
  );

  AddItem( OBJ "leiche",       REFRESH_REMOVE);
  AddItem( NPC "aufsaessiger", REFRESH_DESTRUCT);

  AddCmd( ({ "erhaenge","erhaeng" })  , "cmd_erhaengen" );
  AddCmd( ({ "ich" })                 , "cmd_ich" );
}

int cmd_erhaengen(string str)
{
  tell_object(TP,BS("Wenn Du Dich jetzt wirklich erhaengen willst, dann gib "
                    "\"ich erhaenge mich jetzt selbstmoerderisch\" ein.\n"));
  return -1;
}

int cmd_ich(string str)
{
  notify_fail("Gut, dass das ein Typo von Dir war.\n");

  if(!str || str == "") return 0;
  if(str != "erhaenge mich jetzt selbstmoerderisch") return 0;

  notify_fail("Hier ist kein Seil und Du hast keines dabei.\n");

  if(!present("seil",TP)) return 0;

  SetProp(P_KILL_NAME, CAP_TPN );

  tell_object(TP,BS("So verrueckt wie Du bist nimmst Du Dein Seil in die "
                    "Hand und legst es fest um Deinen Hals. Dann bindest Du "
                    "es an der Decke fest und steigst auf die Leiche. Mit "
                    "einem letzen Ruck springst Du von der Leiche runter!"));
  tell_object(TP,"Du hast Dich soeben selber erhaengt ....\n");

  TP->die();
  return 1;
}

