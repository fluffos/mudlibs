/*
   Dhrkion, die Dunkelelfenstadt - Zordan@SL
*/

#include "../def.h"

inherit "/std/post";

#include <properties.h>
#include <language.h>
#include <bank.h>

int found;

create() {
  ::create();
  found=0;
  SetProp( P_INT_SHORT, "Eine kleine Posthoehle" );
  SetProp( P_INT_LONG,
    "Minihoehle ist der erste Gedanke der Deinen Kopf durchstroemt, als Du "
    "die 'Post'hoehle betrittst. Gerade mal ein kleiner Schalter und zwei "
    "Kabinen haben hier Platz. Der Zustand der Hoehle ist auch mehr als "
    "zweifelhaft. Unzaehlbare Briefe und Pakete liegen verstreut am Boden. "
    "Man scheint hier nicht viel Wert auf solche Dinge zu legen und hat "
    "diese Hoehle wohl in einer kurzen Blitzaktion geschaffen." );
  SetProp( P_LIGHT, -2 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "dinge" }),
    "Mit Dinge ist hier die Post an sich gemeint.");

  AddDetail( ({ "boden" }),
    "Auf dem steinernen Boden liegen viele Briefe und Pakete herum. Kaum "
    "Staub ist zu sehen.");

  AddDetail( ({ "wert" }),
    "Einen hohen Wert schenkt man hier einer Post wohl nicht. Aber das "
    "koennte sich ja mit der Zukunft auch aendern.");

  AddDetail( ({ "zukunft" }),
    "Wer weiss schon, was die Zukunft bringen wird.");

  AddDetail( ({ "blitzaktion","aktion" }),
    "Die Hoehle wurde sehr schnell gebaut. Die Waende sind noch nicht "
    "einmal richtig bearbeitet worden und ueberall stehen spitze Kanten "
    "und Ecken hervor.");

  AddDetail( ({ "waende","wand" }),
    "Die Waende sind aus Fels und kaum bearbeitet worden. In der Westwand "
    "ist der Schalter eingelassen worden.");

  AddDetail( ({ "kanten","ecken" }),
    "Die Kanten und Ecken sind zwar nicht gefaehrlich, aber man koennte "
    "sich daran schneiden und verletzen, wenn man nicht genug Vorsicht "
    "walten laesst.");

  AddDetail( ({ "vorsicht" }),
    "Naja, vorsichtig sollte man sein. Aber nicht uebervorsichtig.");

  AddDetail( ({ "zustand" }),
    "Der Zustand der Post ist wirklich saumaessig. Niemand ist da und niemand "
    "scheint sich besonders engagiert darum zu kuemmern.");

  AddDetail( ({ "niemand" }),
    "???");

  AddDetail( ({ "briefe" }),
    "Unsagbar viele Briefe sind in der ganzen Hoehle verteilt. "
    "Ob es nun Schlamperei oder eher ein Unfall war, vermagst Du nicht "
    "zu sagen. Jedenfalls weisst Du noch nicht so genau, was Du Dir dabei "
    "denken sollst.");

  AddDetail( ({ "pakete","paket" }),
    "Kein Wunder das hier Pakete herumliegen. Denn im ganzen SilberLand "
    "werden keine Pakete zugestellt. Wer es dennoch versucht, hat selber "
    "Schuld.");

  AddDetail( ({ "wunder" }),
    "Nein, das ist nun wirklich kein Wunder!");

  AddDetail( ({ "silberland","land" }),
    "In dem bist Du gerade. Schon vergessen?");

  AddDetail( ({ "schuld" }),
    "Da bist Du dann wirklich selber Schuld, wenn Du versuchst ein Paket "
    "zu versenden!");

  AddDetail( ({ "schlamperei" }),
    "Die koennte es gewesen sein. Eine Schlamperei ist es aber, dass hier "
    "kein Dunkelelf sauber macht.");

  AddDetail( ({ "dunkelelf","dunkelelfen","volk" }),
    "Die Dunkelelfen sind normalerweise ein ziemlich sauberes Volk. Aber "
    "um die Post scheint sich niemand so richtig zu kuemmern.");

  AddDetail( ({ "unfall" }),
    "Der koennte es auch gewesen sein. Spuren eines Kampfes kannst Du "
    "aber nicht sehen. Vielleicht ist der Verantwortliche nur gerade "
    "nicht da.");

  AddDetail( ({ "verantwortliche" }),
    "Wer das wohl ist? Du wirst es wohl nie herausfinden...");

  AddDetail( ({ "spuren" }),
    "Nein, keine Spuren da.");

  AddDetail( ({ "kampf" }),
    "Hier hat kein Kampf stattgefunden. Also warum danach suchen?");

  AddDetail( ({ "verwantwortliche" }),
    "Der fehlt hier ganz eindeutig *seufz*");

  AddDetail( ({ "kopf" }),
    "Pfoah, fast haettest Du Dir diesen an der Decke gestossen. Die Hoehle "
    "ist auch nicht besonders hoch geraten.");

  AddDetail( ({ "decke" }),
    "An der Decke ist nur ungewoehnlich, dass dort nicht ein einziger "
    "Edelstein eingefasst ist. Sonst ist es ja in Dhrkion so ueblich.");

  AddDetail( ({ "edelsteine","edelstein" }),
    "Nein wirklich, es ist nicht ein einziger zu sehen!");

  AddDetail( ({ "stadt","dhrkion" }),
    "Du bist in der Post von Dhrkion gelandet.");

  AddDetail( ({ "Kabinen" }),
    "Du kannst die Kabinen betreten und relativ ungestoert Deine Briefe "
    "lesen und welche schreiben.");

  AddDetail( ({ "post" }),
    "Ja genau. Du bist in einer Post.");

  AddDetail( ({ "platz","allernoetigste" }),
    "Sehr wenig Platz ist in dieser Hoehle. Gerade mal das Allernoetigste "
    "passt hinein.");

  AddDetail( ({ "minihoehle","hoehle" }),
    "Die Hoehle ist wirklich sehr klein geraten. Sie scheint auch noch "
    "nicht all zu lange hier zu sein, denn es liegt kaum Staub herum und "
    "Du bist Dir echt ziemlich sicher, dass hier niemand sauber macht.");

  AddDetail( ({ "staub" }),
    "Nur sehr wenig Staub liegt herum. Normalerweise wuerde man sich nicht "
    "einmal daran stoeren. Aber da hier nie einer sauber macht, faellt "
    "er halt doch in seiner geringen Menge auf.");

  AddDetail( ({ "menge" }),
    "Sehr, sehr wenig.");

  AddDetail( ({ "gedanke" }),
    "Bei dem Gedanken an eine Post moechtest Du gerne auch gleich "
    "einen Brief schreiben.");

  AddDetail( ({ "brief" }),
    "Einen Brief kannst Du einfach so schreiben und dann an dem Schalter "
    "abgeben. Allerdings sitzt dort im Moment niemand und Du weisst daher "
    "nicht, wie lange Dein Brief bis zur Zustellung brauchen wird.");

  AddDetail( ({ "schalter" }),
    "Der Schalter ist eigentlich nur ein kleines Loch, dass in der Westwand "
    "in den Felsen geschlagen wurde. Im Moment ist der Schalter unbesetzt.");

  AddDetail( ({ "moment" }),
    "Im Moment ist der Schalter wirklich unbesetzt.");

  AddDetail( ({ "zustellung" }),
    "Die Zustellung der Briefe koennte hier ein wenig laenger als normal "
    "dauern. Jedenfalls meinst Du das.");

  AddDetail( ({ "loch" }),
    "Du blickst durch das kleine Loch in der Westwand und siehst dahinter "
    "nur eine kleine Aushoehlung.");

  AddDetail( ({ "westwand" }),
    "In der Westwand ist der Schalter eingebaut worden. Ansonsten faellt "
    "Dir nichts auf.");

  AddDetail( ({ "felsen","fels" }),
    "Die Felsen sind auch hier sehr hart und leicht geroetet.");

  AddDetail( ({ "aushoehlung" }),
    "In die Aushoehlung passt nur eine Person hinein, die die Briefe "
    "entgegennimmt. Wie man allerdings in die Aushoehlung hinein gelangt, "
    "kannst Du beim besten Willen nicht erkennen. Eigentlich ist es ja auch "
    "ziemlich unwichtig.");

  AddDetail( ({ "person" }),
    "Die Aushoehlung ist hoch genug fuer einen Dunkelelfen.");

  AddDetail( ({ "willen","wille" }),
    "Dein Wille kann noch so gross sein. In die Aushoehlung wirst Du nicht "
    "gelangen.");

  AddDetail( ({ "papier" }),
    "Das Papier oder besser gesagt die Briefe liegen auf dem Boden verteilt "
    "herum.");

  AddDetail( ({ "kleintiere","tiere" }),
    "Die kleinen Tiere sind so schnell, dass Du nicht einmal genau sagen "
    "kannst, was fuer Tiere das genau sind. Maeuse wuerdest Du tippen. "
    "Aber ganz sicher bist Du Dir nicht.");

  AddDetail( ({ "maeuse","maus" }),
    "Tatsaechlich, ein paar kleine Maeuse nagen an dem Papier.");

  AddSound( ({ DEFAULT_SOUND }),
    "Ein paar Kleintiere knabbern an den umherliegenden Briefen.");
    
  AddSound( ({ "knabbern","kleintiere","tiere" }),
    "Sehen kannst Du die Tiere nicht, aber sie knabbern leise an den nicht "
    "zugestellten Briefen.");
    
  AddSmell( ({ DEFAULT_SMELL }),
    "Es riecht hier nach altem Papier.");

  AddSmell( ({ "papier" }),
    "Das Papier riecht alt und schon leicht vermodert.");

  AddCmd( ({ "sende","versende","versend" }) , "sendefkt" );
  AddCmd( ({ "lies","lese","les" }) ,  "lesefkt" );
  AddCmd( ({ "oeffne" }) ,  "oeffnefkt" );


  AddExit( "norden","./weg-e7");
}

reset() {
  ::reset();
  found=0;
}

int sendefkt(string str) {
  int preis;
  notify_fail("Was moechtest Du versenden?\n");
  if (!str) return 0;
  if (str[0..5] == "paket " || str[0..9] == "ein paket ") {
    preis=random(100)+100;
    if (TP->QueryMoney()>preis) {
      write(BS(
        "Du nimmst Dir eine Briefmarke und ein Paket vom Schalter und "
        "legst dafuer "+preis+" Muenzen ab. Dann klebst Du die Briefmarke "
        "auf das Paket, schreibst die Adresse darauf und legst das Paket zu "
        "all den anderen Paketen. Ob das Paket jemals ankommen wird? Du bist "
        "Dir jedenfalls ziemlich unsicher." ));
      TP->AddMoney(-preis);
      ZENTRALBANK->PayIn(preis);
    } else {
      write(BS(
        "Du stiehlst Dir eine Briefmarke und ein Paket vom Schalter, weil Du "
        "nicht genug Muenzen bei Dir hast. Dann klebst Du die Briefmarke "
        "auf das Paket, schreibst die Adresse darauf und legst das Paket zu "
        "all den anderen Paketen. Ob das Paket jemals ankommen wird? Du bist "
        "Dir jedenfalls ziemlich unsicher." ));
    }
    return 1;
  }
  return 0;
}

int lesefkt(string str) {
  notify_fail("Was moechtest Du lesen?\n");
  if (str == "brief" || str == "briefe" || str == "einen brief") {
    if (found==0) {
      write(BS(
        "Dir wird richtig mulmig zumute, als Du einen der Briefe vom Boden "
        "aufsammelst und anfaengst ihn zu lesen. Er handelt von einem "
        "trauerndem Zwerg, der sein Kind wiederhaben moechte. Als Empfaenger ist "
        "doch tatsaechlich die Koenigin der Dunkelelfen angegeben. Du denkst "
        "kurz ueber den Brief nach, legst ihn aber sehr schnell wieder ab, als "
        "ein Dunkelelf ganz kurz in die Hoehle reinschaut und wieder verschwindet. "
        "Ob er Dich bei Deiner ruchlosen Tat gesehen hat, kannst Du leider nicht "
        "sagen! Aber bei dem Chaos, das hier ist, bist Du Dir eigentlich sicher, "
        "dass es ihn nicht weiter interessiert hat." ));
      found=1;
    } else {
      write(BS(
        "Du durchwuehlst die Briefe auf dem Boden, kannst aber keinen "
        "interessanten Brief mehr finden. Vielleicht ist es auch besser so. "
        "Denn eigentlich unterliegen Briefe ja dem Postgeheimnis und duerfen "
        "von anderen nicht einfach so gelesen werden." ));
    }
    return 1;
  }
  return 0;
}

int oeffnefkt(string str) {
  notify_fail("Was moechtest Du oeffnen?\n");
  if (str == "paket" || str == "pakete" ) {
    write(BS(
      "Du traust Dich nicht eines der Pakete zu oeffnen. Wer weiss schon, "
      "was sich darin befindet." ));
    return 1;
  }
  return 0;
}
