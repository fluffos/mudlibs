#include "../def.h"

inherit ROOM "wall_inh.lpc";

create() {
  richtung = "nordosten";
  langadd="Im Suedwesten kannst Du eine sehr kleine Hoehle sehen.";
  ::create();
  AddExit( "sueden"      , "./wall-b7" );
  AddExit( "nordwesten"  , "./wall-a5" );
  AddExit( "suedwesten"  , "./park-a7" );
}
