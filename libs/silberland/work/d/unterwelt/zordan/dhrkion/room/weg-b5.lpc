#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Durchgang" );
  SetProp(P_INT_LONG,
    "Im Westen dieses kleinen Durchganges ist ein kleiner Torbogen. "
    "Mit Hilfe einer an der Wand befestigten Konstruktion kann man "
    "im Falle eines Angriffes die Stadt abschotten. Zwei Edelsteine "
    "an der Decke scheinen das Licht regelrecht aufzusaugen. "
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "wagenspuren" }),
    "Nein, davon sind wirklich keine hier."
  );

  AddDetail( ({ "leute" }),
    "Leute wie Du und ich. So sagt man doch."
  );

  AddDetail( ({ "spuren" }),
    "Die Spuren stammen von Leuten wie Dir. Es erstaunt Dich nicht, dass Du "
    "keine Wagenspuren erkennen kannst. Denn wie sollen die auch hier "
    "unten hergelangen?"
  );

  AddDetail( ({ "boden" }),
    "Der Boden hier ist erstaunlicherweise nicht aus Fels. Er besteht aus "
    "lockerer Erde. Ein paar Spuren kannst Du leicht ausmachen."
  );

  AddDetail( ({ "decke" }),
    "Bis auf die zwei Edelsteine kannst Du nichts besonderes an der Decke "
    "erkennen."
  );

  AddDetail( ({ "edelsteine","edelstein" }),
    "Ziemlich wertvoll aussehende Edelsteine sind in der Decke eingelassen. "
    "Sie scheinen jegliches Licht regelrecht aufzusaugen. "
  );

  AddDetail( ({ "angriff","angriffe" }),
    "Es hat wohl schon viele Angriffe auf Dhrkion gegeben. Doch alle wurden "
    "wohl bisher erfolgreich abgewehrt."
  );

  AddDetail( ({ "fall" }),
    "Besser waere es fuer Dich, wenn dieser Fall nicht eintritt!"
  );

  AddDetail( ({ "schein","licht" }),
    "Licht ist hier sehr unerwuenscht. Besser Du machst es aus. Zwei "
    "Edelsteine an der Decke scheinen auch das letzte bisschen Licht "
    "aufzusaugen."
  );

  AddDetail( ({ "lichtquelle","bewohner" }),
    "Lass Dich damit bloss nicht erwischen. Es koennte sein, dass ein "
    "paar Bewohner darauf ziemlich energisch reagieren!"
  );

  AddDetail( ({ "oberflaeche","einlaesse","einlass" }),
    "Du untersuchst die Oberflaeche genauer. Eigentlich ist sie wirklich "
    "sehr glatt. Doch durch kleine Einlaesse wird das Licht so gebrochen, "
    "dass das Metall nicht glaenzen kann."
  );

  AddDetail( ({ "metall" }),
    "Dieses Metall scheint trotz der glatten Oberflaeche nicht im Schein "
    "Deiner Lichtquelle zu glaenzen."
  );

  AddDetail( ({ "kette","ringe","ring" }),
    "Die Kette ist wie das Rad aus Metall und besteht aus vielen kleinen "
    "Ringen."
  );

  AddDetail( ({ "rad" }),
    "Das kleine Rad ist aus einem seltsamen Metall gemacht. An ihm haengt "
    "eine kleine Kette, die knapp oberhalb des Rades in der Wand "
    "verschwindet."
  );

  AddDetail( ({ "konstruktion","oeffnen","schliessen" }),
    "Die Konstruktion ist fuer das Oeffnen und Schliessen des Tores. Mit "
    "einem kleinen Rad kann man dieses bewerkstelligen."
  );

  AddDetail( ({ "wand","waende" }),
    "Die Waende bestehen aus ganz normalem Fels. An einer Wand ist "
    "ein kleines Rad angebracht."
  );

  AddDetail( ({ "hilfe" }),
    "Hilfe kannst Du hier unten kaum erwarten. Auch danach schreien "
    "duerfte nichts bringen. Man wuerde Dich eh nicht hoeren."
  );

  AddDetail( ({ "fels" }),
    "Der Fels ist dunkel und ein wenig staubig. Aber er ist so dermassen "
    "fest, so dass es unmoeglich fuer Dich ist, ihn abzubauen."
  );

  AddDetail( ({ "holz" }),
    "Ganz normales Holz."
  );

  AddDetail( ({ "torbogen","bogen" }),
    "Der Torbogen besteht aus einfachem Holz. Er ist fest in den Fels "
    "eingelassen und haelt ein massives Tor."
  );

  AddDetail( ({ "kopf" }),
    "Wenn Du Deinen Kopf wirklich verlieren willst, bist Du hier genau "
    "richtig."
  );

  AddDetail( ({ "probleme","art","weise" }),
    "Probleme werden in Dhrkion nur auf eine Art und Weise geloest: "
    "Kopf ab."
  );

  AddDetail( ({ "sicherheit" }),
    "Du solltest die Sicherheit der Stadt besser nicht gefaehrden."
  );

  AddDetail( ({ "durchgang","gang" }),
    "Dieser Durchgang dient fuer die Sicherheit von Dhrkion. Falls es "
    "inner- oder ausserhalb der Stadt Probleme gibt, schliesst man das "
    "Tor."
  );

  AddDetail( ({ "dhrkion","stadt" }),
    "Du bist jetzt fast in Dhrkion. Nach Nordosten kannst Du die Stadt "
    "betreten."
  );

  AddDetail( ({ "westen" }),
    "Nach Westen kannst Du Dhrkion verlassen. Natuerlich nur, wenn das "
    "Tor nicht herabgelassen ist."
  );

  AddDetail( ({ "stimmen" }),
    "Die kommen aus dem Osten."
  );

  AddDetail( ({ "erde" }),
    "Ja stimmt, auf dem Boden liegt ein wenig Erde herum. Sie riecht auch "
    "ganz deutlich."
  );

  AddSound( DEFAULT_SOUND,
    "Aus dem Osten kommen viele Stimmen."
  );

  AddSound( ({"stimmen"}) ,
    "Normaler Stadtlaerm wuerdest Du sagen. Aber um mehr zu erfahren, "
    "musst Du schon die Stadt betreten."
  );

  AddSound( ({ "stadtlaerm","laerm" }) ,
    "Sehr laut ist es allerdings nicht. Man unterhaelt sich wohl ein wenig "
    "zurueckhaltend."
  );

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nur nach Erde."
  );

  AddSmell( "erde",
    "Die Erde riecht ein wenig modrig, aber angenehm frisch und belebt."
  );

  AddExit( "nordosten", ROOM "weg-c4" );

  NewDoor("westen", ROOM "wall-a5" , ({"tor","stadttor"}) ,
    ({D_FLAGS, DOOR_OPEN
     ,D_SHORT, "Ein maechtiges Stadttor. Es ist %s."
     ,D_LONG,  "Eim maechtiges Stadttor, welches im Angriffsfall geschlossen "
               "wird. Damit ist Dhrkion sehr gut geschützt und kann leicht "
               "verteidigt werden. Das Tor besteht aus Holz, ist aber "
               "mit Metall verstaerkt worden. "
     ,D_NAME,  "Tor"
     ,D_GENDER, NEUTER
     ,D_OPENTESTFUNC,  "opendoortest"
     ,D_CLOSETESTFUNC, "closedoortest"
     ,D_MSGS,  ({"durch das Tor","verlaesst Dhrkion"
                ,"kommt durch das Stadttor aus Dhrkion heraus"})
     })
  );

  AddItem(NPC "wache", REFRESH_DESTRUCT);
  AddItem(NPC "wache", REFRESH_DESTRUCT);

  AddCmd( ({ "dreh","drehe" }) , "cmd_drehen" );
  AddCmd( ({ "ziehe","zieh" }) , "cmd_ziehen" );
}

void SetThisDoor(int dstatus)
{
  DOOR_MASTER->SetDoorStatus(ROOM "wall-a5",dstatus,TO);
}

int QueryThisDoor()
{
  return DOOR_MASTER->QueryDoorStatus(ROOM "wall-a5",TO);
}

int opendoortest()
{
  tell_object(TP, BS("Das Tor ist viel zu schwer, als das Du es mit der Hand "
                   "oeffnen koenntest. "));

  tell_room(TO, BS(CAP_TPN+" versucht das Tor mit der Hand zu oeffnen, ist "
                   "aber viel zu schwach dazu."), ({ TP }) );

  return 1;
}

int closedoortest()
{
  tell_object(TP, BS("Das Tor ist viel zu schwer, als das Du es mit der "
                     "Hand schliessen koenntest. "));

  tell_room(TO, BS(CAP_TPN+" versucht das Tor mit der Hand zu schliessen, "
                   "ist aber viel zu schwach dazu."), ({ TP }) );

  return 1;
}

int cmd_drehen(string str)
{
  object ob;

  notify_fail("Was moechtest Du drehen?\n");

  if(!str || str == "") return 0;
  if(!(str == "rad"     ||
       str == "das rad" ||
       str == "an rad"  )) return 0;

  if(ob = present("\nwache",TO))
  {
    if(!(TP->QueryProp(P_RACE) == "Dunkelelf" &&
         DHRKIONMASTER->getfeinde() == "Keine."))
    {
      tell_object(TP,BS(ob->Name(WER,1)+" schnauzt Dich an: He, lass Deine "
                      "Finger da weg!"));

      tell_room(TO,BS(ob->Name(WER,1)+" schnauzt "+TPN+" an: He, lass Deine "
                      "Finger da weg!"), ({TP}) );
      return -1;
    }
  }

  if(QueryThisDoor() == D_STATUS_CLOSED)
  {
    tell_object(TP, "Du drehst an dem Rad und das Tor oeffnet sich "
                    "langsam.\n");

    tell_room(TO, BS(CAP_TPN+" dreht an einem Rad und das Tor oeffnet sich "
                     "langsam.\n"), ({TP}) );

    tell_room(ROOM "wall-a5",
      "Das Tor wird von innerhalb Dhrkions geoeffnet.\n"
    );

    SetThisDoor(D_STATUS_OPEN);
    return 1;
  }

  tell_object(TP, "Du drehst an dem Rad und das Tor schliesst sich.\n");
  tell_room(TO,BS(CAP_TPN+" dreht an einem Rad und das Tor schliesst "
                  "sich.\n"), ({TP}) );

  tell_room(ROOM "wall-a5",
    "Das Tor wird von innerhalb Dhrkions verschlossen.\n"
  );

  SetThisDoor(D_STATUS_CLOSED);
  return 1;
}

int cmd_ziehen(string str)
{
  notify_fail("An was moechtest Du ziehen?\n");

  if(!str || str =="") return 0;
  if(!(str == "kette"     ||
       str == "an kette"  )) return 0;

  tell_object(TP, BS("Du versuchst an der Kette zu ziehen und klemmst Dir "
                     "prompt Deinen Finger ein."));

  tell_room(TO, BS(CAP_TPN+" versucht an der Kette zu ziehen und verletzt "
                   "sich dabei."), ({TP}) );

  TP->AddHp(-20-random(10));

  return 1;
}
