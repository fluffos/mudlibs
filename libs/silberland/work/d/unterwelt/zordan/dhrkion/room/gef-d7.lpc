#include "../def.h"

inherit "std/room";

#define BSI(x,y) break_string(x,78,y,1)

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein Gefaengniseingang" );
  SetProp(P_INT_LONG,
    "Eine dunkle Katakombe ist wohl der Zugang zu den Gefaengniszellen in "
    "Dhrkion. Mattes Licht strahlt von seltsamen Steinen an der Decke herab. "
    "Auf dem staubigen Boden steht ein kleiner Tisch, der etwas seltsam "
    "aussieht. Dicke Tueren aus Metall versperren den Zutritt zu den "
    "einzelnen Zellen im Westen, Nordwesten und Norden."
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "katakombe","gefaengnis" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "boden" }),
    "Der blutverschmierte Boden ist eigentlich recht unauffaellig."
  );

  AddDetail( ({ "zutritt" }),
    "Den bekommst Du nur durch die Tueren."
  );

  AddDetail( ({ "metall" }),
    "Das Metall ist sehr hart und Du man wird es niemals aufbrechen koennen."
  );

  AddDetail( ({ "blutspritzer","spritzer" }),
    "Oha, das bedeutet nichts gutes. Auf dem Tisch scheint man die Leichen "
    "aus den Zellen zu zerkleinern."
  );

  AddDetail( ({ "leichen","leiche" }),
    "Puh, derzeit liegt keine auf dem Tisch. Du atmest erleichtert auf."
  );

  AddDetail( ({ "blut" }),
    "Dunkelrotes Blut. Sogar noch recht frisch!"
  );

  AddDetail( ({ "tisch" }),
    "Auf dem schon recht grossen Tisch befinden sich viele Blutspritzer."
  );

  AddDetail( ({ "waende","wand" }),
    "Die Waende sind aus sehr stabilem Fels. Es sind drei Tueren in den "
    "Waenden."
  );

  AddDetail( ({ "decke" }),
    "Die Decke ist aus dunklem Fels mit ein paar Steinen drin."
  );

  AddDetail( ({ "widerstandsfaehigkeit","faehigkeit" }),
    "Die Widerstandsfaehigkeit ist wirklich sehr sehr hoch!"
  );

  AddDetail( ({ "magieresistenz","resistenz" }),
    "Oha, Du bist Dir jetzt echt sicher, dass der Fels magieresistent ist."
  );

  AddDetail( ({ "fels" }),
    "Einfach nur dunkler Fels wie ueberall hier. Aber halt. Er scheint "
    "besonders widerstandsfaehig zu sein. Sogar schon fast magieresistent."
  );

  AddDetail( ({ "steine" }),
    "Die Steine haben wohl mal frueher mehr geleuchtet. Ihr Licht ist ermattet "
    "und strahlt nur noch sehr wenig."
  );

  AddDetail( ({ "dhrkion","stadt" }),
    "Die grausame Stadt der Dunkelelfen hat sogar ein Gefaengnis. Naja, war "
    "ja auch nicht anders zu erwarten."
  );

  AddDetail( ({ "dunkelelfen" }),
    "Die Dunkelelfen sperren hier ihre Feinde ein. Was sie dann mit ihnen genau "
    "machen, kannst Du von hier aus nicht sehen."
  );

  AddDetail( ({ "feinde","feind" }),
    "Wenn Du einer bist, dann landest Du sicher bald in einer der Zellen."
  );

  AddDetail( ({ "zugang" }),
    "Hier kannst Du Dich noch relativ frei bewegen. Aber das kann sich ja "
    "schlagartig aendern und Du koenntest in einer der Zellen landen."
  );

  AddDetail( ({ "zellen","gefaengniszellen","zelle" }),
    "Es sind drei Zellen zu sehen. Dicke Tueren versperren Dir den Zugang "
    "zu ihnen. Sie befinden sich im Norden, Nordwesten und Westen."
  );

  AddDetail( ({ "licht" }),
    "Das Licht ist sehr matt und erhellt die Katakombe nur sehr wenig."
  );

  AddDetail( ({ "schreie" }),
    "Du kannst sie nur hoeren."
  );

  AddDetail( ({ "opfer" }),
    "Die sitzen wohl in den Zellen."
  );

  AddDetail( ({"schild","schilder"}) ,
    "An jeder der Tueren ist ein kleines Schild angebracht. Darauf steht "
    "wohin in diese Tuer fuehrt. "
  );

  AddDetail( ({"tueren"}) ,
    "Davon siehst Du drei."
  );

  AddSound( DEFAULT_SOUND,
    "Laute Schreie kommen aus den Gefaengniszellen."
  );

  AddSound( ({ "schreie" }),
    "Markerschuetternde Schreie kommen direkt aus den Zellen. Du moechtest "
    "ueberhaupt nicht wissen, was man darin mit den Opfern macht."
  );

  AddSound( ({ "opfer" }),
    "Die armen Opfer schreien sich fast die Seele aus dem Leib."
  );

  AddSound( ({ "zelle","zellen" }),
    "Aus den Zellen kommen laute Schreie."
  );

  AddSmell( ({ DEFAULT_SMELL }),
    "Es riecht nach Tod und Verderben."
  );

  AddSmell( ({ "tod" }),
    "Normalerweise kann man den Tod nicht riechen. Hier aber schon. "
    "Fauliger Schwefelgeruch kommt von ueberall her und stiehlt Dir fast "
    "Deine Sinne."
  );

  AddSmell( ({ "schwefelgeruch","schwefel" }),
    "Oerkz. Atme das bloss nicht zu lange ein!"
  );

  AddSmell( ({ "verderben" }),
    "Es riecht nach Verderben. Definieren kannst Du es nur nicht genauer."
  );

  AddItem(NPC "gef-waechter", REFRESH_DESTRUCT);

  AddExit("osten", ROOM "weg-e7");

  NewDoor("norden", ROOM "gef-d6" ,
    ({"tuer","tuer1","tuer 1",
      "zelle1","zelle 1",
      "tuer zu zelle 1","tuer zu zelle1"}) ,
    ({D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL
     ,D_SHORT, "Eine schwere Eisentuer."
     ,D_LONG,  "Eine schwere Eisentuer, welche sehr stabil aussieht. Die "
               "grossen Angeln halten die Tuer fest in den Mauern. Wenn "
               "die Tuer verschlossen wird, gibt es wohl kein entrinnen aus "
               "der Zelle. Diese Tuer fuehrt zu Zelle 1, wie Du auf einem "
               "kleinen Schild an der Tuer lesen kannst. "
     ,D_NAME,  "Tuer"
     ,D_GENDER,FEMALE
     ,D_OPENTESTFUNC, "doortest"
     ,D_MSGS,    ({"durch die Tuer","verlaesst die Zelle","kommt herein"})
     ,D_MSGS,    ({"in eine der Zellen","geht durch die Tuer","kommt herein"})
     ,D_OPENMSG, ({"Mit einem leisen Quietschen oeffnest Du die Tuer.",
                   "Mit einem leisen Quietschen oeffnet %s die Tuer.",
                   " wird mit leisem Quietschen von aussen geoeffnet."})
     ,D_CLOSEMSG, ({"Mit einem leisen Quietschen schliesst Du die Tuer.",
                   "Mit einem leisen Quietschen schliesst %s die Tuer.",
                   " wird mit leisem Quietschen von aussen geschlossen."})
     ,D_RESET_CLOSEMSG, " faellt krachend ins Schloss."
     })
  );

  NewDoor("nordwesten", ROOM "gef-c6" ,
    ({"tuer","tuer2","tuer 2",
      "zelle2","zelle 2",
      "tuer zu zelle 2","tuer zu zelle2"}) ,
    ({D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL
     ,D_SHORT, "Eine schwere Eisentuer."
     ,D_LONG,  "Eine schwere Eisentuer, welche sehr stabil aussieht. Die "
               "grossen Angeln halten die Tuer fest in den Mauern. Wenn "
               "die Tuer verschlossen wird, gibt es wohl kein entrinnen aus "
               "der Zelle. Diese Tuer fuehrt zu Zelle 2, wie Du auf einem "
               "kleinen Schild an der Tuer lesen kannst. "
     ,D_NAME,  "Tuer"
     ,D_GENDER,FEMALE
     ,D_OPENTESTFUNC, "doortest"
     ,D_MSGS,    ({"in eine der Zellen","geht durch die Tuer","kommt herein"})
     ,D_OPENMSG, ({"Mit einem leisen Quietschen oeffnest Du die Tuer.",
                   "Mit einem leisen Quietschen oeffnet %s die Tuer.",
                   " wird mit leisem Quietschen von aussen geoeffnet."})
     ,D_CLOSEMSG, ({"Mit einem leisen Quietschen schliesst Du die Tuer.",
                   "Mit einem leisen Quietschen schliesst %s die Tuer.",
                   " wird mit leisem Quietschen von aussen geschlossen."})
     ,D_RESET_CLOSEMSG, " faellt krachend ins Schloss."
     })
  );

  NewDoor("westen", ROOM "gef-c7" ,
    ({"tuer","tuer3","tuer 3",
      "zelle3","zelle 3",
      "tuer zu zelle 3","tuer zu zelle3"}) ,
    ({D_FLAGS,DOOR_CLOSED|DOOR_RESET_CL
     ,D_SHORT, "Eine schwere Eisentuer."
     ,D_LONG,  "Eine schwere Eisentuer, welche sehr stabil aussieht. Die "
               "grossen Angeln halten die Tuer fest in den Mauern. Wenn "
               "die Tuer verschlossen wird, gibt es wohl kein entrinnen aus "
               "der Zelle. Diese Tuer fuehrt zu Zelle 3, wie Du auf einem "
               "kleinen Schild an der Tuer lesen kannst. "
     ,D_NAME,  "Tuer"
     ,D_GENDER,FEMALE
     ,D_OPENTESTFUNC, "doortest"
     ,D_MSGS,    ({"in eine der Zellen","geht durch die Tuer","kommt herein"})
     ,D_OPENMSG, ({"Mit einem leisen Quietschen oeffnest Du die Tuer.",
                   "Mit einem leisen Quietschen oeffnet %s die Tuer.",
                   " wird mit leisem Quietschen von aussen geoeffnet."})
     ,D_CLOSEMSG, ({"Mit einem leisen Quietschen schliesst Du die Tuer.",
                   "Mit einem leisen Quietschen schliesst %s die Tuer.",
                   " wird mit leisem Quietschen von aussen geschlossen."})
     ,D_RESET_CLOSEMSG, " faellt krachend ins Schloss."
     })
  );

}

int QueryDoor(string dir)
{
  switch(dir)
  {
    case "norden" :
      return DOOR_MASTER->QueryDoorStatus(ROOM "gef-d6",TO);
      break;

    case "nordwesten" :
      return DOOR_MASTER->QueryDoorStatus(ROOM "gef-c6",TO);
      break;

    case "westen" :
      return DOOR_MASTER->QueryDoorStatus(ROOM "gef-c7",TO);
      break;
  }

  return D_STATUS_LOCKED;
}

void SetDoor(string dir, int dstatus)
{
  switch(dir)
  {
    case "norden" :
      DOOR_MASTER->SetDoorStatus(ROOM "gef-d6",dstatus,TO);
      break;

    case "nordwesten" :
      DOOR_MASTER->SetDoorStatus(ROOM "gef-c6",dstatus,TO);
      break;

    case "westen" :
      DOOR_MASTER->SetDoorStatus(ROOM "gef-c7",dstatus,TO);
      break;
  }

  return;
}

int doortest()
{
  if(present("gefaengniswache",TO))
  {
    tell_object(TP,
      "Der Gefaengniswaechter schnauzt Dich an: He, lass das!\n"
      "Ganz perplex laesst Du von Deinem Vorhaben ab.\n" //hat->ab | Malar 2004
    );

    tell_room(TO,CAP_TPN+" wird vom Gefaengniswaechter angeschnauzt.\n", ({TP}) );

    return 1;
  }

  return 0;
}

void init()
{
  ::init();

  if(TP && TP->id("gefaengniswache"))
  {
    call_out("mach_die_tuer_zu",0,TP);
  }
}

void mach_die_tuer_zu(object wache)
{
  int s;
  object room;
  string str;

  s = 0;

  if(QueryDoor("norden")     == D_STATUS_OPEN) s++;
  if(QueryDoor("westen")     == D_STATUS_OPEN) s++;
  if(QueryDoor("nordwesten") == D_STATUS_OPEN) s++;

  if(s > 0)
  {
    str = BS("Au weia. Jemand hat die Tuer von aussen geschlossen. Ohne "
             "Hilfe wirst Du hier wohl nicht mehr herauskommen. ");

    tell_room(TO, BSI("Wieso sind denn hier die Tueren offen?",
                      "Die Gefaengniswache wundert sich: "));

    tell_room(TO, "Kurzentschlossen schliesst die Gefaengnisswache die "
                  "Tueren wieder ab.\n");

    if(QueryDoor("norden") == D_STATUS_OPEN)
    {
      SetDoor("norden",D_STATUS_CLOSED);
      room = find_object(ROOM "gef-d6");
      if(room)
      {
        tell_room(room, str);
      }
    }

    if(QueryDoor("westen") == D_STATUS_OPEN)
    {
      SetDoor("westen",D_STATUS_CLOSED);
      room = find_object(ROOM "gef-c7");
      if(room)
      {
        tell_room(room, str);
      }
    }

    if(QueryDoor("nordwesten") == D_STATUS_OPEN)
    {
      SetDoor("nordwesten",D_STATUS_CLOSED);
      room = find_object(ROOM "gef-c6");
      if(room)
      {
        tell_room(room, str);
      }
    }
  }
}


