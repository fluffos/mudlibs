  AddDetail( ({ "holzscheit","scheit" }),
    "Er scheint leicht zu funkeln. Vielleicht solltest Du dem naeher "
    "nachgehen.");

  AddDetail( ({ "funkeln" }),
    "Ein leichtes Funkeln kommt von einem der Holzscheite.");
  
  AddDetail(({"tuer"}),
    "Eine kleine Tuer. Wohin sie wohl fuehrt?");
  
  AddSound( ({ DEFAULT_SOUND }),
    "Laut prasselt das Feuer umher.");
    
  AddSound( ({ "feuer","knacken","knistern" }),
