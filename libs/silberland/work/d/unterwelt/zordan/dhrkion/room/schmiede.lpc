string fjurofkt(string str) {
  if(!present("fjuro")) {
    return "Der besorgt wohl gerade Nachschub und ist bald wieder da.\n";
  } else {
    return "Er steht doch hier. Schau ihn Dir direkt an!\n";
  }
}

sell() {
  notify_fail("Du kannst hier nichts verkaufen!\n" );
  return 0;
}

force_sell() { 
  return sell(); 
}

evaluate() { 
  return sell(); 
}

string wandel(string str) {
  string x;
  switch(str) {
    case WT_SWORD    : x="Schwerter"; break;
    case WT_AXE      : x="Aexte"; break;
    case WT_CLUB     : x="Keulen"; break;
    case WT_SPEAR    : x="Speere"; break;
    case WT_KNIFE    : x="Messer"; break;
    case WT_WHIP     : x="Peitschen"; break;
    case WT_CHAIN    : x="Kettenwaffen"; break;
    case WT_BOW      : x="Bogen"; break;
    case AT_ARMOUR   : x="Ruestungen"; break;
    case AT_HELMET   : x="Helme"; break;
    case AT_AMULET   : x="Amulette"; break; 
    case AT_RING     : x="Ringe"; break;
    case AT_GLOVE    : x="Handschuhe"; break;
    case AT_CLOAK    : x="Umhaenge"; break;
    case AT_BOOT     : x="Schuhe"; break;
    case AT_SHIELD   : x="Schilder"; break;
    case AT_TROUSERS : x="Hosen"; break;
    default: x="nanu, das kenne ich gar nicht!";
  }
  return x;
}

int verbrennefkt(string str) {
  notify_fail("Was moechtest Du verbrennen?\n");
  if (str=="holzscheit" || str=="den holzscheit" || str=="scheit" || str=="den scheit" ) {
    write("Du verbrennst den Holzscheit.\n"); // -> edelstein mit fkt von crea einfuegen
    return 1;
  }
  return 0;
}

