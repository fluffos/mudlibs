/*
   Dhrkion, die Dunkelelfenstadt - Zordan@SL
*/

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <bank.h>
#include <combat.h>
#include <wizlevels.h>

#define WEBS(x) break_string( x, 78, "Fjuro sagt: " )

#define WAFFE 45
#define RUESTUNG 180
#define REST_WAFFE 3
#define REST_RUESTUNG 3
#define MAXZEIT 20
#define VGL_PREIS 450

#define REPAIR_TYPES "Speedy's Repairtypes"

create() {
  ::create();
  SetProp( P_INT_SHORT, "In der Schmiede von Fjuro" );
  SetProp( P_INT_LONG,
    "Leicht bergab geht es in dieses Kellergewoelbe. Der ganze Raum ist leicht "
