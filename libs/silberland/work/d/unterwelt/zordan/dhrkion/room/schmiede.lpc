int reparierefkt(string str) {
  object ob;
  int dam, wert, maxwert, damrest, preis, damrest_pct;
  int i;
  if(!present("fjuro")) {
    notify_fail("Fjuro ist leider gerade nicht da!\n");
    return 0;
  }
  notify_fail("Fjuro fragt Dich: Was moechtest Du reparieren lassen?\n");
  if( !str || !stringp(str)) return 0;
  if( !ob = present(str,TP) ) {
    write(WEBS("Willst Du mich verarschen ? Sowas hast Du gar nicht!" ));
    return 1;
  }
  dam=ob->QueryProp(P_DAMAGED);
  if(member(QueryProp(REPAIR_TYPES), ob->QueryProp(P_WEAPON_TYPE)) >= 0 ) {
    write( WEBS(
      "Aha, ich soll also eine Waffe reparieren, auf die ich "+
      "spezialisiert bin. Mal sehen was ich da machen kann ... " ));
    wert=ob->QueryProp(P_WC);
    damrest_pct=REST_WAFFE;
    preis=WAFFE;
  } else if(member(QueryProp(REPAIR_TYPES), ob->QueryProp(P_ARMOUR_TYPE)) >= 0 ) {
    write( WEBS(
      "Aha, Du moechtest also eine Ruestung repariert haben, auf die "+
      "ich besonders spezialisiert bin. Mal sehen was sich fuer Dich machen kann ... " ));
    wert=ob->QueryProp(P_AC);
    damrest_pct=REST_RUESTUNG;
    preis=RUESTUNG;
  } else if(ob->QueryProp(P_WEAPON_TYPE)) {
    write( WEBS(
      "Tut mir sehr leid, aber mit solchen Waffen kenne ich mich "+
      "leider nicht gut genug aus." ));
    return 1;
  } else if(ob->QueryProp(P_ARMOUR_TYPE)) {
    write( WEBS(
      "Tut mir furchtbar leid, aber mit solchen Ruestungen kenne ich mich "+
      "tastsaechlich nicht aus." ));
    return 1;
  } else {
    write( WEBS( 
      "Ich kenne mich nur mit Waffen und Ruestungen aus!") );
    return 1;
  }
  write("Fjuro prueft "+ob->name(WEN,1)+" eingehend.\n");
  maxwert = wert + dam;
  damrest = (maxwert * damrest_pct) / 100;
  if (dam <= damrest) {
    write( WEBS(
      "Ohje, die Schaeden an "+ob->name(WEM,1)+" sind so gering, "+
      "da kann ich Dir im Moment wirklich nicht weiterhelfen!") );
    return 1;
  }
  preis=preis*(dam-damrest);
  write( WEBS(
    "Die gruendliche Reparatur "+ob->name(WESSEN,1)+" wuerde Dich nur "+
    preis+" Muenzen kosten."));
  if (IS_WIZARD(TP)) write( "Magierinfo: damaged: "+dam+"\n" );
  if (IS_WIZARD(TP)) write( "Magierinfo: damrest: "+damrest+"\n" );
  write( BS(
    "Willst Du die Reparatur durchfuehren lassen? (ja/nein) -> ") );
  input_to("reparierefkt2", 0, ob, dam-damrest, preis, time());
  return 1;
}

void reparierefkt2(string str, object ob, int damrep, int preis, int zeit) {
  if( !TP ) return;
  if(!present("fjuro")) {
    write("Fjuro ist leider gerade nicht da!\n");
    return;
  }
  if( environment(TP) != TO) {
    write("Du solltest schon bei Fjuro bleiben um zu antworten!\n" );
    return;
  }
  if( time() > (zeit+MAXZEIT)) {
    write( WEBS(
      "Du hast Dir viel zuviel Zeit gelassen! Ueberlege es Dir noch einmal. "+
      "Mein Angebot bleibt natuerlich bestehen!" ));
    return;
  }
  if( (str != "ja" ) && (str != "j") ) {
    write( WEBS(
      "Schade, aber das ist ganz alleine Deine Entscheidung!") );
    return;
  }
  if( !ob ) {
    write( WEBS(
      "Nanu, wo hast Du den Gegenstand denn gelassen?") );
    return;
  }
  if( environment(ob) != TP ) {
    write( WEBS(
      "Huch, wo ist denn "+ob->name(WER,1)+" so ploetzlich "+
      "hin?") );
    return;
  }
  if( damrep > ob->QueryProp(P_DAMAGED) ) {
    write( WEBS(
      "Huch, irgendwas stimmt da nicht, "+ob->name(WER,1)+" ist ja gar "+
      "nicht mehr so stark beschaedigt wie vorhin! Probier es doch bitte "+
      "noch einmal. Falls es dann immer noch nicht gehen sollte, "+
      "wende Dich bitte an einen Magier!") );
    return;
  }
  if( TP->QueryMoney() < preis ) {
    write( WEBS(
      "Ich koennte und wuerde Dir ja gerne helfen und den Gegenstand "+
      "reparieren. Problem ist aber nur, dass Du die erforderlichen "+ 
      preis+" Muenzen nicht bei Dir hast." ));
    return;
  }
  TP->AddMoney(-preis);
  ZENTRALBANK->PayIn(preis);
  if( ob->QueryProp(P_WEAPON_TYPE) )
    ob->SetProp(P_WC, ob->QueryProp(P_WC)+damrep);
  else
    ob->SetProp(P_AC, ob->QueryProp(P_AC)+damrep);
  ob->SetProp(P_DAMAGED, ob->QueryProp(P_DAMAGED)-damrep);
  write( BS(
    "Fjuro nimmt Dir "+preis+" Muenzen ab und beginnt mit der "+
    "Reparatur "+ob->name(WESSEN,1)+". Kurze Zeit spaeter ist er fertig und "+
    "drueckt "+ob->QueryPronoun(WEN)+" Dir in wesentlich besserem Zustand "+
    "als zuvor in die Hand.") );
  write( WEBS(
    "Vielen Dank fuer Dein Vertrauen zu mir, "+TPN+".\n" ));
}

