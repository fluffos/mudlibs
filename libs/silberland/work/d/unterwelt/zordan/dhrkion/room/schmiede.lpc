  AddDetail( ({ "teil" }),
    "Ein Teil ist halt nicht alles.");

  AddDetail( ({ "holz" }),
    "Ein kleiner Holzstapel in der Ecke sorgt fuer das Feuer.");

  AddDetail( ({ "holzstapel","stapel" }),
    "Etwa zwergengross stellt sich der Holzstapel heraus. Ein Holzscheit "
