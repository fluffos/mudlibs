#include <exploration.h>

#define SAVEFILE "/d/unterwelt/zordan/dhrkion/master/rwquest"
#define BSI(x,y) break_string(x,78,y,1);

#include <ansi.h>
#include <properties.h>

mapping quest;
// 0: Timestamp Start Quest
// 1: Flag ob Plexu Messer bekommen hat
// 2: Flag ob Plexu Netz mit Rumpelwichten bekommen hat
// 3: Future use
// 4: Future use
// 5: Future use
// 6: Future use

void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }

  seteuid(getuid(this_object()));

  quest = ([]);
  restore_object(SAVEFILE);
  return;
}

int TestKnife(string uuid)
{
  if(member(quest, uuid)) return quest[uuid,1];
  return 0;
}

void AddKnife(string uuid)
{
  if(member(quest,uuid))
  {
    quest[uuid,1] = 1;
  }
  else
  {
    quest += ([uuid: ctime(time());1;0;0;0;0;0]);
  }

  save_object(SAVEFILE);
}

int TestNetz(string uuid)
{
  if(member(quest, uuid)) return quest[uuid,2];
  return 0;
}

int AddNetz(string uuid)
{
  if(member(quest,uuid))
  {
    quest[uuid,2] = 1;
  }
  else
  {
    quest += ([uuid: ctime(time());0;1;0;0;0;0]);
  }

  save_object(SAVEFILE);
}

int IsQuester(string uuid)
{
  return member(quest, uuid);
}

void DeleteQuester(string uuid)
{
  if(!member(quest, uuid)) return;
  quest = m_delete(quest, uuid);
  save_object(SAVEFILE);
}

void StartQuest(string uuid)
{
  if(IsQuester(uuid)) return 0;

  quest += ([uuid: ctime(time());0;0;0;0;0;0]);
  save_object(SAVEFILE);
}

void GetTwines()
{
  EPMASTER->GiveExplorationPoint("swaldranken", EP_MISC);
}

void Msg(string s)
{
  object pl;

  pl = find_player("ronja");

  if(!pl)              return;
  if(!interactive(pl)) return;

  s = BSI(s,"RWQ: ");
  if(pl->QueryProp(P_TTY)) s = ANSI_BOLD+ANSI_RED+s+ANSI_NORMAL;
  tell_object(pl,s);
}


