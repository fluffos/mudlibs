

// Id "NOCONTROL" eingefuegt -> wegen Konflikt mit Dhrkionmaster
// Eros: 02.09.2021

inherit "/d/unterwelt/basics/central/npc/std_darkelf";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create()
{

  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Diener");
  SetProp(P_LONG,
    "Dieser nackte Diener sorgt fuer das Wohlergehen der Koenigin. Er wird "
    "jeden ihrer Wuensche von den Augen ablesen und ihr die gewuenschten "
    "Dinge bringen. Warum er nackt ist weiss wohl auch nur die Koenigin. "
    "Er geht auch die ganze Zeit ein wenig gebueckt und wirkt daher klein." );

  SetProp(P_NAME, "Diener");
  SetProp(P_GENDER, MALE);


  AddId(({"diener", "NOCONTROL"}));
  create_default_darkelf(5,5,0);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_SIZE, 150+random(20));
  SetProp(P_ALIGN, -200-random(100));  // Changed by Angel 21.12.2002
                                       // Die treuen Diener der Dunkelelfenkoenigin haben
                                       // sicher kein Align "gut"
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.3, DT_COLD:      0.0, DT_WATER:  0.1, DT_AIR:    0.0,
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.2,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.2,
      DT_HOLY:      0.3, DT_UNHOLY:    -0.1, DT_MAGIC:  -0.1 ]) );

  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt gebueckt an");
  SetProp(P_MSGOUT, "geht gebueckt");
  SetProp(P_MNPC_AREA, ROOM "palast-" );
  SetProp(P_MNPC_WAIT, ({ 5, 40, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "palast-e3");

  SetProp(P_MNPC_FLAGS,
    MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_MAYLOAD + MOV_SPECIAL);

  SetProp(P_DIE_MSG,  " kann der Koenigin nichts mehr bringen.\n");

  AddInfo(DEFAULT_INFO, "hat keine Zunge mehr!\n");

  AddInfo("zordan", "nickt zustimmend.");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Diener laesst @WEN einfach fallen.\n" }) );

  SetProp(P_SPELLRATE,10);

  AddSpell(1,100,
    "Der Diener wirft Dich zu Boden.\n",
    "Der Diener wirft @WEN zu Boden.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

}

void die(int poisondeath) {
  write_file(LOG "spieler.kills",
    ctime()+": "+CAP(getuid(PL))+" killt den Diener.\n");

//  DHRKIONMASTER->addkiller(PL); passiert im std_darkelf

  ::die(poisondeath);

}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde vom Diener getoetet ("+lostexp+").\n");
}

