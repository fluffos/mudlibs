
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

init() {
  ::init();
  if(TP && DHRKIONMASTER->checkfeind(TP)) {
    if (!IsEnemy(TP)) {
      Kill(TP);
    }
  }
  if (TP && TP->id("\nkoenigin")) AddDefender(TP);
  if (TP && TP->id("\npriesterin")) AddDefender(TP);
  if (TP && TP->id("\ndrider")) AddDefender(TP);
}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein winziger Drider");
  SetProp(P_LONG,
    "Vor Dir steht ein winziger Drider. Sein Spinnenrumpf haelt einen "
    "normalen Dunkelelfenkoerper. Seine Gestalt ist ziemlich furchteregend "
    "und seine acht Beine machen ihn auch nicht gerade huebscher. Drider "
    "sind sehr gefuerchtet fuer ihre Kampfkraft. Also nimm Dich in Acht vor "
    "ihm. Dieser hier ist aber kleiner als Drider sonst sind." );
  SetProp(P_NAME, "Drider");
  SetProp(P_GENDER, MALE);
  AddId( ({"\ndrider", "drider"}) );

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit einem seiner vielen Beine",130,DT_RIP}));
  SetProp(P_RACE, "Drider");
  SetProp(P_SIZE, 100+random(20));
  SetProp(P_ALIGN, -250+random(3)*50);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");

  SetProp(P_DIE_MSG,  " verschindet in der Dunkelheit.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "kann nicht antworten.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der kleine Drider nimmt Deine Sachen nicht.\n" }) );
}

reset() {
  ::reset();
  if (!is_clone(TO)) return;
  call_out("wech",2);
}

void wech() {
  tell_room(MENV,"Der Drider verschwindet in der Dunkelheit.\n");
  ME->remove();
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy) {
  DHRKIONMASTER->addfeind(enemy);
  ::Defend(dam, dam_type, spell, enemy);
}

void InformDefend(object enemy) {
  Kill(enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME) {
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde von einem Minidrider getoetet ("+lostexp+").\n");
    DHRKIONMASTER->feindtot(player);
  }
}
