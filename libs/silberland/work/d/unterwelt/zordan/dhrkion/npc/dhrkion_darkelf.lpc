#include "../def.h"

inherit STDDARKELF;
inherit "std/npc/spells";
inherit "/std/player/moneyhandler";

#define THISID "\nDHRKIONINHABITANT"
#define MAXCALLOUTS 8

mapping reactions;
int callouts;
int can_speak;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  AddId( ({THISID}) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.3, DT_UNHOLY:   -0.7, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  reactions = ([ ]);
  callouts  = 0;
  can_speak = 1;
}

int QueryGrade()
{
  return 0;
}

void reset()
{
  ::reset();

  callouts = 0;
}

void die(int poisondeath)
{
  object enemy;
  string s;

  if(enemy = QueryProp(P_KILLER))
  {
    if(id("mystixfis"))
    {
      s = "Mystixfis("+QueryGrade()+")";
    }
    else
    {
      s = TO->name(WEN);
    }

    DMASTER->NPCKilled(enemy, s);
  }

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  string s;

  if(killer == TO)
  {
    if(id("mystixfis"))
    {
      s = "Mystixfis("+QueryGrade()+")";
    }
    else
    {
      s = TO->name(WEM);
    }

    DMASTER->PlayerKilled(player, s, lostexp);
  }
}

string DefaultReplace(string str, object pl)
{
  str = regreplace(str, "@TPWER",     pl->name(WER, 1),    1);
  str = regreplace(str, "@TPWESSEN",  pl->name(WESSEN, 1), 1);
  str = regreplace(str, "@TPWEM",     pl->name(WEM, 1),    1);
  str = regreplace(str, "@TPWEN",     pl->name(WEN, 1),    1);

  str = regreplace(str, "@NPCWER",    TO->name(WER, 1),    1);
  str = regreplace(str, "@NPCWESSEN", TO->name(WESSEN, 1), 1);
  str = regreplace(str, "@NPCWEM",    TO->name(WEM, 1),    1);
  str = regreplace(str, "@NPCWEN",    TO->name(WEN, 1),    1);

  return str;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(callouts > MAXCALLOUTS) return;
  if(!adverb)      adverb = "";

  if(touch && member(reactions, "touch"))
  {
    callouts++;
    call_out("reaction", 0, TP, DefaultReplace(reactions["touch", 0], TP)
                              , DefaultReplace(reactions["touch", 1], TP)
                              ,                reactions["touch", 2]);
  }

  if(member(reactions, verb))
  {
    callouts++;
    call_out("reaction", 0, TP, DefaultReplace(reactions[verb, 0], TP)
                              , DefaultReplace(reactions[verb, 1], TP)
                              ,                reactions[verb, 2]);
  }

  if(member(reactions, gruppe))
  {
    callouts++;
    call_out("reaction", 0, TP, DefaultReplace(reactions[gruppe, 0], TP)
                              , DefaultReplace(reactions[gruppe, 1], TP)
                              ,                reactions[gruppe, 2]);
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string splayer, string sother, string func)
{
  callouts--;

  if(!ENV(TO))           return;
  if(ENV(pl) != ENV(TO)) return;

  if(strlen(splayer)) tell_object(pl,    CAP(BS(splayer)));
  if(strlen(sother))  tell_room(ENV(TO), CAP(BS(sother)), ({ pl }) );
  if(strlen(func))    call_other(TO, func, pl, TO);
}

