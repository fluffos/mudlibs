inherit "std/mnpc";

#include "../def.h"

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include <class.h>

// mapping:id,size,weight

mapping race;
string  raceid;

void debug(string msg)
{
  tell_object(find_player("ronja"),"XXX "+msg+" XXX\n\n\n");
}

void create()
{
  string name, *temp;
  int gender,level;

  if (!is_clone(TO)) return;

  ::create();

  race =
    (["elf":    "Elfen"   ;  195;  70000; "geht"
     ,"zwerg":  "Zwergen" ;  120;  75000; "geht"
     ,"mensch": "Menschen";  175;  75000; "geht"
     ,"fee":    "Feen"    ;   60;  20000; "flattert"
     ,"oger":   "Oger"    ;  250; 200000; "stapft"
     ,"troll":  "Troll"   ;  330; 350000; "trampelt"
     ,"hobbit": "Hobbit"  ;  100;  50000; "geht"
     ]);

  temp    = m_indices(race);
  raceid  = temp[random(sizeof(temp))];
  gender  = random(2) ? MALE:FEMALE;
  level   = random(4)+4;

  if(raceid == "fee") gender = FEMALE;
  name   = race[raceid,0] + "sklav" + (gender==MALE?"e":"in");

  SetProp(P_NAME, name);
  SetProp(P_GENDER,gender);

  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG,
    Name(WER,0)+". Hier hat wohl der Magier geschlampt, denn es ist keine "
    "Langbeschreibung vorhanden."
  );

  create_default_npc(level);

  AddId( ({ (gender==MALE?"sklave":"sklavin"), LOWER(name), raceid, "\ndunkelelfensklave" }) );

  switch(raceid)
  {
    case "elf":     AddClass( ({ CL_ELF })    ); break;
    case "zwerg":   AddClass( ({ CL_DWARF })  ); break;
    case "mensch":  AddClass( ({ CL_HUMAN })  ); break;
    case "fee":     AddClass( ({ CL_FAIRY })  ); break;
    case "oger":    AddClass( ({ CL_OGRE })   ); break;
    case "troll":   AddClass( ({ CL_TROLL })  ); break;
    case "hobbit":  AddClass( ({ CL_HOBBIT }) ); break;
  }

  SetProp(P_HANDS, ({" mit "+(gender==MALE?"seinen":"ihren")+" blossen "
                     "Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_RACE,   CAP(raceid));
  SetProp(P_SIZE,   race[raceid,1]);
  SetProp(P_WEIGHT, race[raceid,2]);

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:50]));

  SetProp(P_ALIGN, 150+random(150));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 40);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, race[raceid,3]);

  SetProp(P_MNPC_AREA, ROOM);
  SetProp(P_MNPC_WAIT, ({ 20, 30, 40 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "rothe-h9");
  SetProp(P_MNPC_FLAGS, 0);

  SetProp(P_DIE_MSG,  " ist endlich frei.\n");

  AddInfo(DEFAULT_INFO, "hat keine Zunge mehr!!!\n");

  AddInfo("zordan", "nickt.");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" darf das nicht nehmen.\n" }) );

  SetProp(P_SPELLRATE,0);

  CLONEME(ARMOUR "arbeitshemd");
  command("trage alles");
}

