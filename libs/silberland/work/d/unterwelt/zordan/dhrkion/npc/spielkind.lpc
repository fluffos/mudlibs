#include "../def.h"

inherit "/d/unterwelt/basics/central/npc/std_darkelf";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Kinderschar");
  SetProp(P_LONG,
    "Dunkelelfenkinder werden schon sehr frueh mit den Kuensten der Magie "
    "und des Kampfes vertraut gemacht, da die Unterwelt zahlreiche "
    "Gefahren birgt. Bereits ab 5 Jahren werden die Kinder der Dunkelefen "
    "fast schon militärisch geschult. Diese Ausbildung ist mit 12 Jahren "
    "abgeschlossen. Ab diesem Zeitpunkt dürfen Dunkelelfenkinder auch "
    "Erwachsene ansprechen, ohne vorher gefragt worden zu sein. "
  );

  SetProp(P_NAME, "Kinderschar");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kinder","schar","kinderschar"}) );

  SetProp(P_NOATTACK,
    "faengt an wild durcheinander zu laufen und Du kannst nicht\n"
    "eines der Kinder erwischen." );

  create_default_darkelf(1,0,0);

  SetProp(P_HANDS, ({" nicht",10,DT_BLUDGEON}));
  SetProp(P_SIZE, 100+random(10));
  SetProp(P_ALIGN, -100);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt auf dem Weg zur Schule herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt auf dem Weg zur Schule herein");
  SetProp(P_MMSGOUT, "geht zur Schule");

  SetProp(P_MNPC_AREA, ({ROOM "weg-f7", ROOM "weg-g7",
                         ROOM "weg-f6", ROOM "weg-g6"}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "weg-f7");
  SetProp(P_MNPC_WAIT, ({ 10, 40, 20 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddDetail( ({ "eltern" }),
    "Die sind sicher nicht weit weg.");

  AddDetail( ({ "altersbereich","bereich","jahre" }),
    "Sie sind wohl zwischen 6 und elf Jahre alt.");

  AddInfo(DEFAULT_INFO, "darf nicht zu Fremden sprechen.\n");

  AddInfo("zordan", "Der bringt uns immer was tolles mit.","sagen: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Kinder nehmen nichts von Fremden an.\n" }) );

  SetProp(P_SPELLRATE,0);

  SetChats(1,
    ({"Die Kinder ueben marschieren.\n"
     ,"Die Kinder sind mucksmaeuschenstill.\n"
     ,"Die Kinder formieren sich neu.\n"
     ,"Die Kinder ueben sich im Schattenkampf.\n"
     ,"Die Kinder stellen sich wie zum Kampf auf.\n"
     ,"Die Kinder konzentrieren sich auf ihre Magiekuenste.\n"
     })
  );

}

