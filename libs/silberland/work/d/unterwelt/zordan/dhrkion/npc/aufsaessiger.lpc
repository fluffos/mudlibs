
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

#define ARTEN ({ "Elfen","Zwergen","Menschen","Hobbit","Troll","Ork", \
                 "Hexen","Oger","Goblin","Goblin" })

#define ARTENID ({ "elf","zwerg","mensch","hobbit","troll","ork", \
                 "hexe","oger","goblin","goblin" })

void create() {
  int art;
  if (!is_clone(TO)) return;
  ::create();
  art=random(sizeof(ARTEN));
  SetProp(P_SHORT, "Ein aufsaessiger "+ARTEN[art]+"sklave");
  SetProp(P_LONG,
    "Dieser aufsaessige "+ARTEN[art]+"sklave hat wohl nicht die Worte eines "
    "Dunkelelfen befolgt. Zur Strafe hat man ihm den Mund mit einem " 
    "gemeinen Zauberspruch verklebt. Nur ein kleines Loch gestattet es "
    "ihm noch etwas zu trinken. Die Kleider hat man ihm vom Leib gerissen "
    "und seinem Koerper schon ganz gut zugesetzt.");
  SetProp(P_NAME, ARTEN[art]+"sklave");
  SetProp(P_GENDER, MALE);
  AddId(({ LOWER(ARTEN[art])+"sklave", "sklave",ARTENID[art] }) );

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit seinen kaputten Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, ARTEN[art]);
  SetProp(P_SIZE, 150+random(30));
  SetProp(P_ALIGN, random(100));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "wird auf den Boden geworfen");

  SetProp(P_DIE_MSG,  " ist von seinen Quallen befreit.\n");

  AddInfo(DEFAULT_INFO, "kann nichts sagen, weil sein Mund verklebt wurde.\n");
  AddInfo("zordan", "weint.");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der "+ARTEN[art]+"sklave ist zu schwach um @WEN zu tragen.\n" }) );

  SetProp(P_SPELLRATE,0);
  SetChats(1, ({
    "Der "+ARTEN[art]+"sklave wimmert.\n",
    "Der "+ARTEN[art]+"sklave schaut Dich an und weint.\n", 
    "Der "+ARTEN[art]+"sklave scharrt mit dem Fuss auf dem Boden.\n",
    "Der "+ARTEN[art]+"sklave geht in der Zelle auf und ab.\n",
    "Der "+ARTEN[art]+"sklave grunzt.\n"}) );

}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME) {
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde vom Sklaven getoetet ("+lostexp+").\n");
    DHRKIONMASTER->feindtot(player);
  }
}
