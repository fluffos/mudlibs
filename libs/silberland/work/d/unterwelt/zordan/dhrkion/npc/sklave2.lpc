#include "../def.h"

inherit NPC "inh_sklave";

#include <properties.h>
#include <language.h>
#include <mnpc.h>

string besenchat();

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, race[raceid,3]);
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, race[raceid,3]);

  SetProp(P_MNPC_AREA,
    ({ ROOM "weg"
     , ROOM "kneipe"
     , ROOM "laden"
     , ROOM "post"
     , ROOM "wall"
     })
  );

  SetProp(P_MNPC_WAIT, ({ 20, 30, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "weg-e6");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  switch(random(100))
  {
    case  0..49:
      CLONEME("/d/ebene/ronja/feenquest/weapon/besen");
      command_me("zueck besen");
      SetProp(P_LONG,
        Name(WEM,1)+" wurde befohlen, ganz Dhrkion sauber zu halten. "
        "Gehorsam hat "+QueryPronoun(WER)+" sich einen Besen genommen und "
        "eilt nun durch ganz Dhrkion, um alles zu fegen. "
      );
      SetChats(6,
        ({Name(WER,1)+" schaut nach, ob hier gefegt werden muss.\n"
         ,#'besenchat
         })
      );
      break;

    case 50..99:
      SetProp(P_LONG,
        Name(WER,1)+" ist wohl Lastentraeger, jedenfalls deutet der alte "
        "Leinensack ganz darauf hin. "+QueryPronoun(WER)+" muss wohl "
        "den lieben langen Tag Sachen fuer die Dunkelelfen durch ganz "
        "Dhrkion tragen. "
      );

      CLONEME(OBJ "sack");
      break;
  }

}

string besenchat()
{
  command_me("fege mit besen");
  return "";
}

