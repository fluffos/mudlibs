#include "../def.h"

inherit NPC "inh_sklave";

#include <properties.h>
#include <language.h>
#include <mnpc.h>

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_LONG,
    Name(WER,1)+" wurde hier in die Hoehle gesperrt, "
    "um auf die Rothe aufzupassen. "+CAP(QueryPronoun(WER))+" traegt nur ein "
    "einfaches Arbeitsgewand und scheint auch sonst kein besonderer Gegner "
    "zu sein."
  );

  SetProp(P_MMSGIN, "kommt an und schaut sich nach den Rothen um");
  SetProp(P_MMSGOUT, "geht# um Rothe zu hirten");
  SetProp(P_MSGIN,  "kommt an");
  SetProp(P_MSGOUT, race[raceid,3]+"#");

  SetProp(P_MNPC_AREA, ROOM "rothe-" );
  SetProp(P_MNPC_WAIT, ({ 20, 30, 40 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "rothe-h9");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  command_me("zueck messer");
}

