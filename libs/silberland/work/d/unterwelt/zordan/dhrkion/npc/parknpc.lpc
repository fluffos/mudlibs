#include "../def.h"

inherit "std/mnpc";

#include <npcmaster.h>

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Anfaengertierchen");
  SetProp(P_LONG,
    "Das Anfaengertierchen duerfte hier gar nicht herumlaufen."
  );

  SetProp(P_NAME, "Anfaengertierchen");
  AddId( ({"anfaengertierchen" ,"tier" }) );

  SetProp(P_MNPC_AREA, ROOM "park-" );
  SetProp(P_MNPC_WAIT, ({ 20, 30, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "park-a8");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS|MOV_INDOORS|MOV_MOVES|MOV_BACKWARDS);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SUID;
}

void die(int poisondeath)
{
  object enemy, ob;

  enemy = QueryProp(P_KILLER);

  if(!enemy)                       return ::die(poisondeath);
  if(!interactive(enemy))          return ::die(poisondeath);
  if(present(QUESTJUWELID, enemy)) return ::die(poisondeath);

  if(JUWELENMASTER->AddKill(getuuid(enemy)) > 7)
  {
    ob = clone_object(OBJ "juwel");
    ob->move(TO, M_NOCHECK);
    ob->SetOwner(getuuid(enemy));

    tell_object(enemy, "Aus der Leiche scheint ewas hervorzuglitzern!\n");
  }

  ::die(poisondeath);

  if(JUWELENMASTER->GetKills(getuuid(enemy)) > 7)
  {
    tell_object(enemy, "Aus der Leiche scheint ewas hervorzuglitzern!\n");
  }
}


