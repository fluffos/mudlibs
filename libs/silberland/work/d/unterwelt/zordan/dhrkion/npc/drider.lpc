#include "../def.h"

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>

#define GROESSE ({ "klein","normal","gross","riesig" })

int art;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  art=random(sizeof(GROESSE));

  SetProp(P_SHORT, "Ein "+GROESSE[art]+"er Drider");
  SetProp(P_LONG,
    "Dieser "+GROESSE[art]+"e Drider hat einen spinnenartigen Rumpf "
    "mit einem Dunkelelfenkoerper darauf. Seine acht Beine geben ihm im "
    "Kampf schnelles Reaktionsvermoegen. Gerade deshalb steht er auch vor "
    "der Stadt, um Angreifer gleich in die Flucht zu schlagen. Seine hellweissen "
    "Haare und roten Augen truegen nicht ueber die hohe Intelligenz und "
    "Kampfkraft hinweg.");

  SetProp(P_NAME, "Drider");
  SetProp(P_GENDER, MALE);
  AddId( ({"drider", "\ndrider","Schwertexperte"}));
  AddClass(CL_DARKELF);

  SetProp(P_NAME_ADJ, ({GROESSE[art]}) );
  AddAdjective( ({GROESSE[art]+"en",GROESSE[art]+"er",GROESSE[art]+"em",GROESSE[art]+"es",GROESSE[art]+"e"}) );

  create_default_npc(24+art*2);
  SetProp(P_HANDS, ({" mit seinen Spinnenbeinen",QueryProp(P_HANDS)[1]+30,DT_PIERCE}));
  SetProp(P_RACE, "Drider");
  SetProp(P_SIZE, 150+art*10);
  SetProp(P_ALIGN, -300-art*100);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_AGGRESSIVE,([P_RACE:(["Dunkelelf":0.0, 0:0.02])]) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.1, DT_COLD:      0.1, DT_WATER:  -0.1, DT_AIR:    0.0,
      DT_LIGHTNING: -0.1, DT_EXPLOSION: 0.1, DT_SOUND:  0.0, DT_LIGHT:  0.1,
      DT_ELECTRIC:  0.1, DT_ACID:      0.1, DT_POISON: -0.8, DT_TERROR: -0.2,
      DT_HOLY:      0.2, DT_UNHOLY:    -0.2, DT_MAGIC:  -0.2 ]) );

  SetProp(P_NOMAGIC,20);

  SetProp(P_MNPC_AREA, ROOM "wall-");
  SetProp(P_MNPC_WAIT, ({ 2+art*3, 20+art*3, 20+art*3 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "wall-a5");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_MSGIN, "kommt hereingekrabbelt");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "kommt hereingekrabbelt");
  SetProp(P_MMSGOUT,"krabbelt davon");

  SetProp(P_DIE_MSG,  " sackt in sich zusammen.\n");

  AddInfo(DEFAULT_INFO, "grummelt Dich nur an.\n");

  SetProp(P_LOG_INFO, "dhrkion.log");
  AddLibrary( NPC "dhrkion.lib",1);

  AddInfo("zordan", "Zordan hat mich erschaffen.","sagt: ");

  AddInfo( ({"abloese","abloesung"}),
    "Ich werde hier niemals abgeloest werden.",
    "sagt: ");

  AddInfo( ({"schutzwall","wall"}),
    "Ich werde niemanden ueber den Schutzwall gehen lassen.",
    "sagt: ");

  AddInfo( ({"wache","wachen"}),
    "Ich passe hier auf und bekaempfe Feinde in vorderster Front.",
    "sagt: ");

  AddInfo( ({"stadt","dhrkion"}),
    "Die Stadt ist hinter dem Schutzwall. Feinde werde ich dort nicht hinein"
    "lassen, solange ich noch lebe.",
    "sagt: ");

  AddInfo( ({"feind","feinde"}),
    "Ich halte Ausschau nach Feinden und vernichte sie!",
    "sagt: ");

  AddInfo( ({"tor"}),
    "Das Tor wird bei Angriffen sofort geschlossen.",
    "sagt: ");

  AddInfo( ({"drider"}),
    "Richtig, ich bin einer.",
    "sagt: ");

  AddInfo( ({"name"}),
    "Ich habe und brauche keinen.",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER)+" behaelt @WEN einfach so und sagt kein Wort dazu.\n" }) );

  SetProp(P_SPELLRATE,40+art*10);

  AddSpell(3,200+art*10,
    Name(WER)+" reisst Dir das Gesicht auf.\n",
    Name(WER)+" reisst @WEM das Gesicht auf.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1])
  );

  AddSpell(2,250+art*10,
    Name(WER)+" zerfetzt Dich mit einem seiner Beine.\n",
    Name(WER)+" zerfetzt @WEN mit einem seiner Beine.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1])
  );

  AddSpell(3,300+art*10,
    Name(WER)+" bespritzt Dich mit Gift.\n",
    Name(WER)+" bespritzt @WEN mit Gift.\n",
    DT_POISON,([SP_SHOW_DAMAGE:1])
  );

  AddSpell(1,350+art*50,
    Name(WER)+" trifft Dich mit seinem Giftstachel mitten ins Herz.\n",
    Name(WER)+" trifft @WEN mit seinem Giftstachel mitten ins Herz.\n",
    DT_POISON,([SP_SHOW_DAMAGE:1])
  );

  SetChats(1, ({
    Name(WER,1)+" sagt: Verschwinde hier!\n",
    Name(WER,1)+" schaut Dich laessig an.\n",
    Name(WER,1)+" sagt: Mach hier bloss keinen Aerger.\n",
    Name(WER,1)+" fragt: Willst Du mich abloesen?\n",
    Name(WER,1)+" haelt nach Feinden ausschau.\n",
    Name(WER,1)+" kratzt sich mit einem seiner Beine.\n",
    Name(WER,1)+" schaut Dich an und wendet sich ab.\n",
    Name(WER,1)+" kontrolliert den Schutzwall.\n"})
  );

  SetAttackChats(10, ({
    Name(WER,1)+" tritt Dich unfair.\n",
    Name(WER,1)+" sagt: Du bist doch kein Gegner fuer mich.\n",
    Name(WER,1)+" ruft um Hilfe.\n",
    Name(WER,1)+" haut Dir mitten ins Gesicht.\n",
    Name(WER,1)+" spuckt Dich an.\n",
    Name(WER,1)+" umschlingt Dich mit seinen Beinen.\n",
    Name(WER,1)+" windet sich geschickt in Deinen Ruecken.\n"})
  );


  SUID;

  switch(random(5))
  {
    case 0: CLONEME(WEAPON "langbogen" ); command("zuecke langbogen"); break;
    case 1: CLONEME(WEAPON "kurzbogen" ); command("zuecke kurzbogen"); break;
    case 2: CLONEME( "/p/weapon/sword/degen");
            command( "zuecke degen"); break;
    case 3: CLONEME( "/p/weapon/sword/rapier");
            command( "zuecke rapier"); break;
    case 4: CLONEME(WEAPON "diamantschwert" );
            command("zuecke schwert"); break;
  }

  if (random(100)<80)
  {
    switch(random(2))
    {
      case 0: CLONEME( "/d/kristallwald/sargola/dorf/armour/armschienen" ); break;
      case 1: CLONEME( ARMOUR "chitinarmschienen" ); break;
    }
  }

  if (random(100)<40)
  {
    switch(random(3))
    {
      case 0: CLONEME( "/d/ebene/obj/ruestung/platinhelm"); break;
      case 1: CLONEME( "/p/armour/helm/mithrilhelm"); break;
      case 2: CLONEME( "/p/armour/helm/titanhelm"); break;
    }
  }

  if (random(100)<20)
  {
    CLONEME( ARMOUR "chitinguertel" );
  }

  switch(random(3))
  {
    case 0: CLONEME( ARMOUR "chitinpanzer" ); break;
    case 1: CLONEME( ARMOUR "chitinpanzer" ); break;
    case 2: CLONEME( ARMOUR "spinnenpanzer" ); break;
  }

  command("trage alles");
}

void init()
{
  ::init();
  if(TP && TP->id("\ndrider")) AddDefender(TP);
  if(TP && TP->is_class_member(CL_DARKELF)) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void die(int poisondeath)
{
  write_file(LOG "spieler.kills",
    ctime()+": "+CAP(getuid(PL))+" killt einen Drider ("+art+").\n");
  if (present("\npaladintaskitem", PL))
    DHRKIONMASTER->addkiller(PL);
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == ME) {
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde von einem Drider ("+art+") getoetet ("+lostexp+").\n");
    DHRKIONMASTER->feindtot(player);
  }
}

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "sagt: Man bist Du eine Memme, "+TPN+"!",
        "sagt: Man bist Du eine Memme, "+TPN+"!");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "haut Dir eine runter.",
        "haut "+TPN+" eine runter.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "schaut Dich nur an und reagiert nicht.",
        "schaut "+TPN+" nur an und reagiert nicht.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Lass das "+TPN+" oder ich werde Dich vernichten!",
        "sagt: Lass das "+TPN+" oder ich werde Dich vernichten!");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "sagt: Mach das noch einmal "+TPN+" und ich toete Dich!",
        "sagt: Mach das noch einmal "+TPN+" und ich toete Dich!");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "sagt: Schoen fuer Dich, "+TPN+".",
        "sagt: Schoen fuer Dich, "+TPN+".");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "schreit: Hoer auf damit, "+TPN+"!",
        "schreit: Hoer auf damit, "+TPN+"!");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "sagt: Ich mag soetwas nicht, "+TPN+"!",
        "sagt: Ich mag soetwas nicht, "+TPN+"!");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "schaut Dich nur an.",
        "schaut "+TPN+" nur an.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "sagt: Pfffff.",
        "sagt: Pfffff.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

