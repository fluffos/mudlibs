#include "../def.h"

inherit "/d/unterwelt/basics/central/npc/std_darkelf";

#define GESCH ({ "maennliche","weibliche" })
#define DEB(x) if(find_player("ronja")) tell_object(find_player("ronja"), "\nXXX "+x+"\n\n")

void create()
{
  int ge;

  if (!is_clone(TO)) return;

  ::create();

  ge=random(2);

  SetProp(P_LONG,
    "Vor Dir steht eine "+GESCH[ge]+" Dunkelelfenwache. Sie ist einzig und "
    "allein fuer die Bewachung des Tores zustaendig. Wenn es zu einem "
    "Angriff innerhalb oder ausserhalb der Stadt kommt, wird das Tor "
    "geschlossen und man muss erst einmal an der Dunkelelfenwache vorbei. "
    "Sie steht ziemlich aufmerksam vor dem Tor und wird jeden Deiner "
    "Schritte beobachten."
  );

  SetProp(P_NAME, "Dunkelelfenwache");
  AddId( ({"dunkelelfenwache", "elfenwache", "wache"
          ,"\nwache","Schwertexperte","NOCONTROL", "NOWIMPY"}) );

  if(ge)
  {
    SetProp(P_SHORT, "Eine weibliche Elitewache");
    AddId( "elitewache" );

    create_default_darkelf(25,20,30);

    SetProp(P_HANDS, ({" mit ihren dunklen Haenden",180,DT_BLUDGEON}) );
    SetProp(P_NAME_ADJ, ({"weiblich"}) );
    AddAdjective( ({"weiblichen","weiblicher","weiblichem"
                   ,"weibliches","weibliche"}) );
  }
  else
  {
    SetProp(P_SHORT, "Eine maennliche Dunkelelfenwache");

    create_default_darkelf(20,17,10);

    SetProp(P_HANDS, ({" mit seinen dunklen Haenden",140,DT_BLUDGEON}) );
    SetProp(P_NAME_ADJ, ({"maennlich"}) );
    AddAdjective( ({"maennlichen","maennlicher","maennlichem"
                   ,"maennliches","maennliche"}) );
  }

  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, 210+random(20));
  SetProp(P_ALIGN, -200-random(50));

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:      0.1, DT_WATER:      -0.1
     , DT_AIR:       0.0, DT_LIGHTNING: 0.1, DT_EXPLOSION:   0.2
     , DT_SOUND:     0.0, DT_LIGHT:     0.1, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.5
     , DT_HOLY:      0.2, DT_UNHOLY:   -0.5, DT_MAGIC:      -0.5
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "kommt an und beginnt den Wachdienst");

  SetProp(P_DIE_MSG,  " bewacht jetzt gar nichts mehr.\n");

  AddInfo(DEFAULT_INFO, "beachtet Dich nicht weiter.\n");

  SetProp(P_LOG_INFO, "dhrkion.log");
  AddLibrary( NPC "dhrkion.lib",1);

  AddInfo("zordan", "Zordan hat mich zum Wachdienst eingeteilt.","seufzt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Die Dunkelelfenwache sagt: Danke.\n" }) );

  //AddCmd( ({ "dreh","drehe" }) , "drehfkt" );

  SetProp(P_SPELLRATE,20+ge*50);

  AddSpell(3,150+ge*50,
    "Die Dunkelelfenwache wirft Dich zu Boden.\n",
    "Die Dunkelelfenwache wirft @WEN zu Boden.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,200+ge*50,
    "Die Dunkelelfenwache tritt Dich unfair.\n",
    "Die Dunkelelfenwache tritt @WEN unfair.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,300+ge*50,
    "Die Dunkelelfenwache blendet Dich mit einem Zauberspruch.\n",
    "Die Dunkelelfenwache blendet @WEN mit einem Zauberspruch.\n",
     DT_LIGHT,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,350+ge*50,
    "Die Dunkelelfenwache zerkratzt Dir das Gesicht.\n",
    "Die Dunkelelfenwache zerkratzt @WEN das Gesicht.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Die Dunkelelfenwache schaut Dich misstrauisch an.\n",
    "Die Dunkelelfenwache kontrolliert das Tor.\n",
    "Die Dunkelelfenwache ueberprueft die Funktion des Tores.\n",
    "Die Dunkelelfenwache sagt: Lunger hier nicht herum!\n",
    "Die Dunkelelfenwache sagt: Verzieh Dich lieber!\n",
    "Die Dunkelelfenwache raunzt Dich an: Verschwinde hier!\n",
    "Die Dunkelelfenwache faucht: Mach hier bloss keinen Aerger!\n",
    "Die Dunkelelfenwache geht vor dem Tor auf und ab.\n"}) );

  SetAttackChats(10, ({
    "Die Dunkelelfenwache sagt: Ich werde Dich toeten!\n",
    "Die Dunkelelfenwache tritt Dir in den Hintern.\n",
    "Die Dunkelelfenwache schreit um Hilfe.\n",
    "Die Dunkelelfenwache verteidigt sich gekonnt.\n",
    "Die Dunkelelfenwache sagt energisch: Das war ein grosser Fehler!\n"}) );

  SUID;

  switch(random(4))
  {
    case 0:
      CLONEME(WEAPON "langbogen" );
      command("zuecke langbogen");
      break;

    case 1:
      CLONEME("/p/weapon/sword/degen");
      command("zuecke degen");
      break;

    case 2:
      CLONEME("/p/weapon/sword/rapier");
      command("zuecke rapier");
      break;

    case 3:
      CLONEME(WEAPON "diamantschwert" );
      command("zuecke schwert");
      break;
  }

  if(random(100)<80) CLONEME("/p/armour/boots/lederstiefel");
  if(random(100)<80) CLONEME("/p/armour/gloves/lederhandschuhe");
  if(random(100)<70) CLONEME(ARMOUR "chitinguertel");
  if(random(100)<70) CLONEME(ARMOUR "chitinschild");

  if(random(100)<60)
  {
    switch(random(2))
    {
      case 0:
        CLONEME("/d/kristallwald/sargola/dorf/armour/armschienen" );
        break;

      case 1:
        CLONEME( ARMOUR "chitinarmschienen" );
        break;
    }
  }

  if(random(100)<40)
  {
    switch(random(3))
    {
      case 0: CLONEME( "/p/armour/cloak/baerenfell"); break;
      case 1: CLONEME( "/d/dschungel/feyaria/kueste/armour/jaguarfell"); break;
      case 2: CLONEME( "/p/armour/cloak/wolfsfell"); break;
    }
  }

  if(random(100)<40)
  {
    switch(random(2))
    {
      case 0: CLONEME( ARMOUR "hose" ); break;
      case 1: CLONEME( ARMOUR "chitinhose" ); break;
    }
  }

  if(random(100)<20)
  {
    switch(random(3))
    {
      case 0: CLONEME( "/d/ebene/obj/ruestung/platinhelm"); break;
      case 1: CLONEME( "/p/armour/helm/mithrilhelm"); break;
      case 2: CLONEME( "/p/armour/helm/titanhelm"); break;
    }
  }

  if(random(100)<10)
  {
    switch(random(3))
    {
      case 0: CLONEME( ARMOUR "mithrilring" ); break;
      case 1: CLONEME( "/d/gebirge/eros/ruestung/platinring"); break;
      case 2: CLONEME( "/d/ebene/lamuerte/burg/obj/titanring"); break;
    }
  }

  switch(random(2))
  {
    case 0: CLONEME( ARMOUR "chitinpanzer" ); break;
    case 1: CLONEME( ARMOUR "spinnenpanzer" ); break;
  }
  command("trage alles");

}

int _query_wimpy()
{
  return 0;
}

int open_door()
{
  object room;

  room = ENV(TO);

  if(!objectp(room))                           return -1;
  if(room->QueryThisDoor() == D_STATUS_OPEN)   return -2;
  if(DHRKIONMASTER->getfeinde() != "Keine.")   return -3;

  room->SetThisDoor(D_STATUS_OPEN);

  tell_room(room, BSI("Da keine Feinde mehr in sicht sind, kann man das Tor "
                      "gefahrlos wieder oeffnen.",Name(WER,1)+" murmelt: "));

  if(file_name(room) == ROOM "weg-h5")
  {
    tell_room(ROOM "wall-i5",
      "Das Stadttor wird von innerhalb Dhrkions geoeffnet!\n"
    );
  }

  if(file_name(room) == ROOM "weg-b5")
  {
    tell_room(ROOM "wall-a5",
      "Das Stadttor wird von innerhalb Dhrkions geoeffnet!\n"
    );
  }

  return 1;
}

void close_door(int msg)
{
  object room, guard;

  room = ENV(TO);
  if(!objectp(room)) return;

  if(room->QueryThisDoor() == D_STATUS_OPEN)
  {
    tell_room(room, "Die Wache ruft: Wir werden angegriffen! Schliesst "
                    "schnell die Tore!\n");
    room->SetThisDoor(D_STATUS_CLOSED);

    if(file_name(room) == ROOM "weg-h5")
    {
      tell_room(ROOM "wall-i5",
        "Das Stadttor wird von innerhalb Dhrkions geschlossen!\n"
      );
    }

    if(file_name(room) == ROOM "weg-b5")
    {
      tell_room(ROOM "wall-a5",
        "Das Stadttor wird von innerhalb Dhrkions geschlossen!\n"
      );
    }
  }

  if(msg != 1) return;

  if(file_name(room) == ROOM "weg-h5")
  {
    call_other(ROOM "weg-b5","???");
    room = find_object(ROOM "weg-b5");
    if(!objectp(room)) return;

    guard = present("\nwache",room);
    if(!objectp(guard)) return;

    guard->close_door(0);
    return;
  }

  if(file_name(room) == ROOM "weg-b5")
  {
    call_other(ROOM "weg-h5","???");
    room = find_object(ROOM "weg-h5");
    if(!objectp(room)) return;

    guard = present("\nwache",room);
    if(!objectp(guard)) return;

    guard->close_door(0);
    return;
  }
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  DHRKIONMASTER->addfeind(enemy);

  if(!IsEnemy(enemy)) close_door(1);

  ::Defend(dam, dam_type, spell, enemy);
}

void init()
{
  object room;

  ::init();

  if(!is_clone(TO))   return;
  if(!(room=ENV(TO))) return;

  if(TP && TP->id("\nwache")) AddDefender(TP);

  if(TP && DHRKIONMASTER->checkfeind(TP) && !IsEnemy(TP))
  {
    call_out("angriff",0,TP);
  }
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void angriff(object enemy, string str)
{
  if(enemy && present(enemy))
  {
    tell_object(enemy,
      Name(WER,1)+" erkennt Dich als Feind und greift Dich an.\n"
    );
    close_door(1);
    Kill(enemy);
  }
}

void reset()
{
  object room;

  ::reset();

  if(!is_clone(TO))     return;
  if(!(room = ENV(TO))) return;

  open_door();
}

void die(int poisondeath)
{
  write_file(LOG "spieler.kills",
    ctime()+": "+CAP(getuid(PL))+" killt die Torwache.\n");
//  DHRKIONMASTER->addkiller(PL); passiert bereits im std_darkelf
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == ME)
  {
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde von der Wache getoetet ("+lostexp+").\n");
    DHRKIONMASTER->feindtot(player);
  }
}
