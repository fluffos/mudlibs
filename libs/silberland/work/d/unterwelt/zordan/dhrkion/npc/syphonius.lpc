
inherit "/d/unterwelt/basics/central/npc/std_darkelf";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Syphonius, der Haendler");
  SetProp(P_LONG,
    "Fuer einen Dunkelelfen ist Syphonius etwas klein geraten. Auch seine "
    "Haare leuchten nicht so hell wie die der anderen Dunkelelfen. Dafuer "
    "hat er aber besonders leuchtende Augen. Viel Erfahrung im Kampf "
    "scheint er aber nicht zu haben. Er sieht schon fast eher aengstlich aus.");

  SetProp(P_NAME, "Syphonius");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId( ({"syphonius","haendler"}) );
  set_living_name("syphonius");

  create_default_darkelf(15+random(3),15,10);
  SetProp(P_HANDS, ({" mit seiner Faust",160,DT_BLUDGEON}));
  SetProp(P_RACE, "Dunkelelf");
  SetProp(P_SIZE, 180+random(10));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 200);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.2, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:  0.0, DT_LIGHT:  0.1,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.2,
      DT_HOLY:      0.1, DT_UNHOLY:    -0.2, DT_MAGIC:  -0.1 ]) );

  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "schlurft");

  SetProp(P_DIE_MSG,  " verkauft erstmal nichts mehr.\n");

  SetProp(P_LOG_INFO, "dhrkion.log");
  AddLibrary( NPC "dhrkion.lib",1);

  AddInfo(DEFAULT_INFO, "sagt: Moechtest Du nichts kaufen?\n");

  AddInfo("zordan", "Der hat leider immer so wenig Zeit.","schnieft: ");

  AddInfo( ({"angebot","angebote"}),
    "Wenn Du mein Angebot sehen willst, dann geb 'zeige' ein.",
    "sagt: ");

  AddInfo( ({"geschaeft","geschaefte"}),
    "Oh danke, meine Geschaefte laufen gut.",
    "sagt: ");

  AddInfo( ({"kaufen"}),
    "Wenn Du etwas kaufen moechtest, dann geb 'kauf xx' ein.",
    "sagt: ");

  AddInfo( ({"qualitaet"}),
    "Meine Waren haben die beste Qualitaet!",
    "sagt stolz: ");

  AddInfo( ({"handel","handeln","verhandeln"}),
    "Tstst, ich verhandle niemals ueber meine Preise.",
    "sagt: ");

  AddInfo( ({"syphonius"}),
    "Ja?",
    "fragt: ");

  AddInfo( ({"laden"}),
    "Das hier ist mein Laden. Leider geht er nicht so gut in letzter Zeit.",
    "sagt: ");

  AddInfo( ({"zeit"}),
    "Zuviele schlechte Geschaefte in letzter Zeit.",
    "seufzt: ");

  AddInfo( ({"schwert","schwerter"}),
    "Magst Du Dir nicht eines kaufen?",
    "fragt: ");

  AddInfo( ({"waffen","ruestungen","verschiendes"}),
    "Tipp doch mal 'zeige' ein.",
    "sagt: ");

  AddInfo( ({"schild","schilder"}),
    "Schilder habe ich leider selten.",
    "sagt: ");

  AddInfo( ({"bogen","boegen"}),
    "Meine Boegen sind die besten im ganzen SilberLand.",
    "sagt: ");

  AddInfo( ({"waren","ware"}),
    "Meine Ware ist wirklich unglaublich gut. Schau Dich doch mal um.",
    "sagt: ");

  AddInfo( ({"schrank"}),
    "Der ist halt leer denke ich mal.",
    "sagt: ");

  AddInfo( ({"vorhang"}),
    "Hinter dem Vorhang wohnt der Schmied.",
    "sagt: ");

  AddInfo( ({"schmied"}), "@@schmiedfkt@@" , 1 );

  AddInfo( ({"preis","preise"}),
    "Na billig sind meine Waren nicht. Dafuer aber besonders gut.",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Syphonius sagt: Danke, ich werde @WEN sicher gut verkaufen koennen.\n" }) );

  SetProp(P_SPELLRATE,20);

  AddSpell(1,200,
    "Syphonius dringt tief in Deinen Geist ein.\n",
    "Syphonius dringt tief in den Geist von @WEN ein.\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,250,
    "Syphonius tritt Dir mitten in den Bauch.\n",
    "Syphonius tritt @WEN in den Bauch.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,300,
    "Syphonius versucht Dir die Luft abzudruecken.\n",
    "Syphonius versucht @WEN die Luft zu entziehen.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Syphonius sagt: Meine Ware ist bester Qualitaet!\n",
    "Syphonius zeigt Dir ein paar seiner Sachen.\n",
    "Syphonius schaut Dich kurz an.\n",
    "Syphonius fragt Dich: Moechten Sie nicht etwas kaufen?\n",
    "Syphonius fragt Dich: Haben Sie etwas anzubieten?\n",
    "Syphonius poliert eine seiner vielen Waffen.\n"}) );

  SetAttackChats(10, ({
    "Syphonius sagt: Dir verkaufe ich nie wieder etwas!\n",
    "Syphonius ruft: Hilfe, Wachen !!!\n",
    "Syphonius faengt fast an zu weinen.\n",
    "Syphonius hat eine Traene im Gesicht.\n"}) );

  SUID;
  CLONEME(WEAPON "dolch" );
  command("zuecke dolch");
  CLONEME(ARMOUR "hose" );
  CLONEME(ARMOUR "mithrilring" );
  CLONEME("/p/armour/boots/lederstiefel" );
  command("trage alles");
}

reset() {
  ::reset();
  if ((MENV) && (file_name(MENV) != "/d/unterwelt/zordan/dhrkion/room/laden")) {
    SetProp(P_WIMPY, 200);
    ME->move( ROOM "laden" , M_GO, 0,
      "eilt zurueck in seinen Laden",
      "schluft herein");  }
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy) {
  DHRKIONMASTER->addfeind(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void die(int poisondeath) {
  write_file(LOG "spieler.kills",
    ctime()+": "+CAP(getuid(PL))+" killt Syphonius.\n");
//  DHRKIONMASTER->addkiller(PL); uebernimmt das inherit
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME) {
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde von Syphonius getoetet ("+lostexp+").\n");
    DHRKIONMASTER->feindtot(player);
  }
}

string schmiedfkt() {
  tell_room(ENV(TO),BS(
    "Syphonius nickt und bringt "+TPN+" hinter den Vorhang und erscheint "
    "gleich wieder."),({ TP }));
  tell_object(TP,BS(
    "Syphonius bringt Dich durch den Vorhang zu ihm. Sofort geht Syphonius "
    "in seinen Laden zurueck." ));
  PL->move( ROOM "schmiede", M_SILENT+M_GO );
  return "";
}

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "umarmt Dich.",
        "umarmt "+TPN+".");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "seufzt.",
        "seufzt.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert.",
        "kichert.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "sagt: Tstst. Verlass doch bitte meinen Laden, "+TPN+".",
        "sagt: Tstst. Verlass doch bitte meinen Laden, "+TPN+".");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt.",
        "laechelt.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "erschreckt fuerchterlich. Damit hat er nicht gerechnet.",
        "erschreckt fuerchterlich. Damit hat er nicht gerechnet.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "freut sich.",
        "freut sich.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "fragt Dich: Moechtest Du nicht lieber etwas kaufen?",
        "fragt "+TPN+": Moechtest Du nicht lieber etwas kaufen?");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TPN+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
