#include "../def.h"

inherit "/d/unterwelt/basics/central/npc/std_darkelf";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Eine Palastwache");
  SetProp(P_LONG,
    "Diese weibliche Wache ist einzig und alleine fuer den Schutz der "
    "Koenigin hier. Sie wird die Koenigin mit ihrem Leben verteidigen. "
    "Ihre Figur entspricht genau dem Ideal einer Dunkelelfin. Langes, "
    "leuchtend weisses Haar, rotgoldene Augen und ihre Groesse sprechen "
    "einfach nur fuer sich."
  );

  SetProp(P_NAME, "Palastwache");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"palastwache","wache","\npalastwache","elfenwaechterin","Schwertexperte"}) );

  create_default_darkelf(17,15,80);
  SetProp(P_HANDS, ({" mit ihren dunklen Haenden",140,DT_BLUDGEON}));
  SetProp(P_SIZE, 200+random(20));
  SetProp(P_ALIGN, -100+random(50));
  SetProp(P_QP, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.2, DT_COLD:      0.1, DT_WATER:  0.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:  0.0, DT_LIGHT:  0.2,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.3, DT_UNHOLY:    -0.1, DT_MAGIC:  -0.2 ]) );

  SetProp(P_MSGIN, "kommt an und beginnt ihren Wachdienst");
  SetProp(P_MSGOUT, "macht ihren Wachdienst woanders weiter und geht");

  SetProp(P_DIE_MSG,  " wird die Koenigin nicht mehr beschuetzen koennen.\n");

  AddInfo(DEFAULT_INFO, "sagt: Frag nicht solch einen Quatsch und verschwinde.\n");

  SetProp(P_LOG_INFO, "dhrkion.log");
  AddLibrary( NPC "dhrkion.lib",1);

  AddInfo("zordan", "Den mag ich nicht besonders.","sagt: ");

  AddInfo( ({"besuch"}),
    "Du darfst die Koenigin jederzeit besuchen.",
    "sagt: ");

  AddInfo( ({"audienz"}),
    "Du brauchst nicht extra um eine Audienz bitten. Unsere Koenigin ist "
    "fuer jeden zu sprechen.",
    "sagt: ");

  AddInfo( ({"koenigin"}),
    "Die beschuetze ich mit meinem Leben.",
    "sagt: ");

  AddInfo( ({"leben"}),
    "Ein maennlicher Dunkelelf ist nichts wert und daher sein Leben auch "
    "nicht.",
    "sagt: ");

  AddInfo( ({"palast"}),
    "Ich halte hier Wache.",
    "sagt: ");

  AddInfo( ({"wache","palastwache"}),
    "Genau, ich halte hier Wache.",
    "sagt: ");

  AddInfo( ({"tafel"}),
    "Wer auf der Tafel steht wird einfach so umgebracht.",
    "sagt: ");

  SetProp( P_REJECT,
    ({ REJECT_DROP, "Die Palastwache sagt: Ich darf nichts annehmen. Befehl "
                    "der Koenigin.\n" })
  );

  SetProp(P_SPELLRATE,33);

  AddSpell(3,250,
    "Die Palastwache drischt wie eine Wilde auf Dich ein.\n",
    "Die Palastwache drischt wie eine Wilde auf @WEN ein.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,400,
    "Die Palastwache bekommt kurz geistige Unterstuetzung von Lloth.\n",
    "Die Palastwache bekommt kurz geistige Unterstuetzung von Lloth.\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Die Palastwache rueckt ihren Panzer zurecht.\n",
    "Die Palastwache schaut Dich kurz an.\n",
    "Die Palastwache schaut Dich skeptisch an.\n",
    "Die Palastwache lehnt sich auf seine Waffe.\n",
    "Die Palastwache sagt: Wehe Du machst Aerger in Dhrkion.\n",
    "Die Palastwache sagt: Verzieh Dich hier bloss!\n",
    "Die Palastwache mustert Dich aufmerksam.\n"}) );

  SetAttackChats(10, ({
    "Die Palastwache sagt: Du kommst hier niemals durch!\n",
    "Die Palastwache sagt: Du hast keine Chance gegen mich!\n",
    "Die Palastwache sagt: Ich werde die Koenigin mit meinem Leben beschuetzen.\n",
    "Die Palastwache streichelt ihre Waffe.\n"}) );


  SUID;

  switch(random(3))
  {
    case 0:
      CLONEME(WEAPON "kurzbogen" );
      command("zuecke kurzbogen");
      break;

    case 1:
      CLONEME(WEAPON "diamantschwert" );
      command("zuecke schwert");
      break;

    case 2:
      CLONEME( "/d/kristallwald/sargola/dorf/weapon/bogen");
      command( "zuecke bogen");
      break;
  }

  CLONEME("/d/kristallwald/sargola/dorf/armour/armschienen");
  CLONEME("/d/kristallwald/sargola/dorf/armour/schild");
  CLONEME("/p/armour/boots/lederstiefel");

  if(random(100)<10)
  {
    CLONEME( "/d/dschungel/feyaria/dorf/armour/elfenkettenhemd" );
  }
  else
  {
    CLONEME( ARMOUR "spinnenpanzer" );
  }

  if(random(100) < 35) CLONEME(ARMOUR "umhang");
  if(random(100) < 15) CLONEME(ARMOUR "stirnreif");

  CLONEME(ARMOUR "rock_kurz");

  command("trage alles");
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  DHRKIONMASTER->addfeind(enemy);

  if(!spell)
  {
    if(!random(3))
    {
      tell_object(enemy,
        "Die Palastwache weicht Deinem Schlag leicht aus.\n");
      tell_room(MENV,
        "Die Palastwache weicht einem Schlag von "+enemy->Name()+" aus.\n", ({ enemy }));
      dam=dam/2;
    }
  }
  else
  {
    if(!random(3))
    {
      tell_room(MENV,
        "Die Palastwache wird kurz von einer dunklen Aura umgeben.\n");
      dam=dam/2;
    }
  }

  return ::Defend(dam, dam_type, spell, enemy);
}

void init()
{
  ::init();

  if(TP && DHRKIONMASTER->checkfeind(TP))
  {
    if (!IsEnemy(TP)) {
      call_out("angriff",0,TP,"Die Palastwache sagt: Du bist ein Feind von "
                              "Dhrkion!!!\n");
      Kill(TP);
    }
  }

  if(TP && TP->id("\npalastwache")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void angriff(object enemy,string str)
{
  if(enemy && present(enemy))
  {
    tell_object(enemy,str);
  }
}

void die(int poisondeath)
{
  write_file(LOG "spieler.kills",
    ctime()+": "+CAP(getuid(PL))+" killt die Palastwache.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == ME)
  {
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde von der Palastwache getoetet ("+lostexp+").\n");
    DHRKIONMASTER->feindtot(player);
  }
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht ueber Dich.",
        "lacht ueber "+TPN+".");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: Lass das, "+TPN+"!!!",
        "sagt: Lass das, "+TPN+"!!!");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "sagt: Hoer auf damit "+TPN+", oder ich werde Dich toeten.",
        "sagt: Hoer auf damit "+TPN+", oder ich werde Dich toeten.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Ok, das reicht jetzt aber "+TPN+".",
        "sagt: Ok, das reicht jetzt aber "+TPN+".");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "sagt: Das wagst Du kein zweites Mal, "+TPN+".",
        "sagt: Das wagst Du kein zweites Mal, "+TPN+".");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "sagt: Geh doch zu Deiner Mami, "+TPN+".",
        "sagt: Geh doch zu Deiner Mami, "+TPN+".");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "greift Dich deshalb an !!!",
        "greift "+TPN+" deshalb an !!!");
      Kill(TP);
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "winkt einfach ab.",
        "winkt einfach ab.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "gruebelt vor sich hin.",
        "gruebelt vor sich hin.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "lacht ueber Dich.",
        "lacht ueber "+TPN+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere)
{
  if (present(ob, ENV(TO)))
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
