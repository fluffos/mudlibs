#include "../def.h"

inherit "/d/unterwelt/basics/central/npc/std_darkelf";

/*
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
*/

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Gefaengniswache");
  SetProp(P_LONG,
    "Diese etwas aelter aussehende Gefaengniswache ist wohl kein besonderer "
    "Schutz vor Angriffen. Die Wache steht hier nur herum und pass wohl auf, "
    "das niemand die Zellen von Aussen oeffnet. Von Innen erwartet man wohl "
    "keinen Ausbruch. Denn diese Wache waere den Ausbrechern wohl auch nicht "
    "gewachsen." );

  SetProp(P_NAME, "Gefaengniswache");
  SetProp(P_GENDER, FEMALE);
  AddId(({"gefaengniswache", "wache", "dunkelelf", "DHDKIONWACHE" }));

  create_default_darkelf(9,10,0);
  SetProp(P_HANDS, ({" mit seinen alten Haenden",50,DT_BLUDGEON}));
  SetProp(P_SIZE, 190+random(20));
  SetProp(P_ALIGN, -50+random(50));
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "kommt an und legt die Fuesse hoch");
  SetProp(P_MSGOUT, "verschwindet");

  SetProp(P_DIE_MSG,  " hat erst einmal Pause.\n");

  AddInfo(DEFAULT_INFO, "sieht Dich gelangweilt an.\n");

  SetProp(P_LOG_INFO, "dhrkion.log");
  AddLibrary( NPC "dhrkion.lib",1);

  AddInfo("zordan", "Ach der kann mir gestohlen bleiben.","sagt: ");

  AddInfo( ({"gefangene","gefangenen"}),
    "Die sitzen natuerlich in den Zellen.",
    "sagt: ");

  AddInfo( ({"faehigkeiten"}),
    "Frueher war ich viel besser.",
    "seufzt: ");

  AddInfo( ({"leiche","leichen"}),
    "Ich hatte noch keine Lust die Leiche zu entfernen. Ausserdem vergammelt "
    "sie eh nach einer Zeit von ganz alleine.",
    "sagt: ");

  AddInfo( ({"rumsitzen"}),
    "Ja, ich hocke hier den ganzen Tag gelangweilt herum.",
    "sagt: ");

  AddInfo( ({"schluessel"}),
    "Einen Schluessel braucht man fuer die Zellen nicht. Man kann sie eh "
    "nur von hier aus oeffnen.",
    "sagt: ");

  AddInfo( ({"gefaengnis"}),
    "Ich bin hier zum Aufpassen eingeteilt worden. Aber da hier eh nie etwas "
    "passiert ist mir ganz schoen langweilig. Meine Knochen sind auch schon "
    "ganz wabbelig geworden.",
    "sagt: ");

  AddInfo( ({"aufpassen"}),
    "Naja, ich achte darauf, dass niemand ausbricht.",
    "sagt: ");

  AddInfo( ({"knochen"}),
    "Durch das ewige Rumsitzen und Nichtstun sind meine Knochen schon ganz "
    "schoen eingerostet.",
    "sagt: ");

  AddInfo( ({"tuer","tueren","oeffnen"}),
    "Die Zellen lassen sich nur von hier oeffnen.",
    "sagt: ");

  AddInfo( ({"zelle","zellen","typ","typen"}),
    "Wir haben hier drei Zellen. Fuer jeden Typ eine andere.",
    "sagt: ");

  AddInfo( ({"kind","kinder"}),
    "Wir halten die kleinen in einer Zelle und erziehen sie um.",
    "sagt: ");

  AddInfo( ({"sklave","sklaven"}),
    "Die meisten passen auf die Rothe auf. Aber manchmal wird auch einer "
    "eingesperrt. Ich glaube im Moment sitzt sogar einer.",
    "sagt: ");

  AddInfo( ({"blut","tisch"}),
    "Hm, was weiss ich darueber schon.",
    "sagt: ");

  AddInfo( ({"ausbrecher","ausbrecherin"}),
    "Hier ist noch nie jemand ausgebrochen. Falls ja hab ich es jedenfalls "
    "nicht bemerkt. Das liegt auch mehr daran, dass man hier niemals wieder "
    "ohne Hilfe rauskommen wird.",
    "sagt: ");

  AddInfo( ({"hilfe"}),
    "Wenn Du erstmal in einer Zelle sitzt, dann kannst Du sie alleine nicht "
    "mehr verlassen. Also sei gewarnt!!!",
    "sagt: ");

  AddInfo( ({"name","gefaengniswache"}),
    "Ich habe keinen Namen. Maennliche Dunkelelfen bekommen selten einen.",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Die Gefaengniswache behaelt Dein Geschenk einfach ohne was zu sagen.\n" }) );

  SetProp(P_SPELLRATE,23);
  AddSpell(1,50,
    "Die Gefaengniswache gibt Dir einen Teil seines Alters.\n",
    "Die Gefaengniswache gibt @WEN einen Teil seines Alters.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,50,
    "Die Gefaengniswache tritt Dir in den Hintern.\n",
    "Die Gefaengniswache tritt @WEN in den Hintern.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,50,
    "Die Gefaengniswache wuergt Dich stark.\n",
    "Die Gefaengniswache wuergt @WEN stark.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Die Gefaengniswache schaut Dich ablehnend an.\n",
    "Die Gefaengniswache legt die Fuesse auf den Tisch.\n",
    "Die Gefaengniswache ruelpst.\n",
    "Die Gefaengniswache ist fast eingenickt.\n",
    "Die Gefaengniswache popelt sich in der Nase.\n",
    "Die Gefaengniswache lehnt sich gegen eine Wand.\n"}) );
  SetAttackChats(10, ({
    "Die Gefaengniswache sagt: Pfff. Das konnte ich frueher auch mal.\n",
    "Die Gefaengniswache aechzt.\n",
    "Die Gefaengniswache verteidigt sich nicht gerade sehr.\n",
    "Die Gefaengniswache sagt: Du kannst mir gestohlen bleiben.\n"}) );

  SUID;
  CLONEME( WEAPON "kurzbogen" );
  command( "zuecke kurzbogen");
  CLONEME(ARMOUR "hose" );
  CLONEME(ARMOUR "hornring" );
  command("trage alles");

}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME) {
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde von der Gefaengniswache getoetet ("+lostexp+").\n");
    if (!present(QUESTRUNE,TP)) DHRKIONMASTER->feindtot(player);
  }
}

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "schaut Dich verwundert an.",
        "schaut "+TPN+" verwundert an.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "fragt Dich: Was kann ich denn dafuer?",
        "fragt "+TPN+": Was kann ich denn dafuer?");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "laechelt froehlich.",
        "laechelt froehlich");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "zwickt Dir in den Hintern.",
        "zwickt "+TPN+" in den Hintern.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "bewegt sich kein Stueck.",
        "bewegt sich kein Stueck.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "sagt: Hehe, "+TPN+".",
        "sagt: Hehe, "+TPN+".");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "ist kalt wie ein Eisblock.",
        "ist kalt wie ein Eisblock.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt und grinst Dich an.",
        "laechelt und grinst "+TPN+" an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "schaut verdutzt.",
        "schaut verdutzt.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TPN+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
