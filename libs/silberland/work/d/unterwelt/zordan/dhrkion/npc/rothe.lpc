
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Rothe");
  SetProp(P_LONG,
    "Diese Rothe erinnert Dich irgendwie an eine Kuh. Ihre kleinen Hoerner "
    "werden wohl kaum jemanden beeindrucken. Aber fuer die Paarung werden sie "
    "wohl gebraucht. Die Rothe ist kaum groesser als ein Zwerg und Dunkelelfen "
    "zuechten sie um an ihr Fleisch, welches wirklich sehr gut schmeckt, zu "
    "kommen.");
  SetProp(P_NAME, "Rothe");
  SetProp(P_GENDER, FEMALE);
  AddId(({"rothe"}));

  create_default_npc(2);
  SetProp(P_HANDS, ({" mit ihren kleinen Hoernern",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Rothe");
  SetProp(P_SIZE, 80+random(20));
  SetProp(P_ALIGN, 200+random(50));
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_WIMPY, 5);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "laeuft herein und faengt an Moos und Pilze zu essen");
  SetProp(P_MSGOUT, "laeuft");

/*
  SetProp(P_MNPC_AREA, ROOM "rothe-" );
  SetProp(P_MNPC_WAIT, ({ 15, 30, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "rothe-h9");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
*/
  SetProp(P_DIE_MSG,  " laesst das Moos jetzt in Ruhe.\n");

  AddInfo(DEFAULT_INFO, "hat noch nie ein Wort gesprochen.\n");
  AddInfo("zordan", "schaut Dich neugierig an.");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Rothe kann doch nichts tragen.\n" }) );

  SetProp(P_SPELLRATE,0);

  SetChats(1, ({
    "Die Rothe isst einen Pilz.\n",
    "Die Rothe schnaubt.\n",
    "Die Rothe stampft mit einem Huf auf.\n",
    "Die Rothe glotzt Dich dumm an.\n",
    "Die Rothe frisst gemuetlich vor sich hin.\n",
    "Die Rothe knabbert an dem Moos.\n"}) );
  SetAttackChats(10, ({
    "Die Rothe quiekt.\n",
    "Die Rothe schaut Dich traurig an.\n"}) );
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde von einer Rothe getoetet ("+lostexp+").\n");
}

void die(int poisondeath) {
  CLONEME( OBJ "rothehaxe" );
  ::die(poisondeath);
}
