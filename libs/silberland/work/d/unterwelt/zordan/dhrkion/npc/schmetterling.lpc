#include "../def.h"

inherit NPC "parknpc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein dunkler Schmetterling");
  SetProp(P_LONG,
    "Der Schmetterling schwirrt um Deinen Kopf herum und macht Dich ganz "
    "nervoes."
  );

  SetProp(P_NAME, "Schmetterling");
  SetProp(P_GENDER, MALE);
  AddId( ({"schmetterling"}) );

  create_default_npc(2);
  SetProp(P_HANDS, ({" mit seinem Fluegel",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Schmetterling");
  SetProp(P_SIZE, 2);
  SetProp(P_ALIGN, -40);
  SetProp(P_HEAL, 1);

  SetProp(P_MSGIN, "kommt angeflattert");
  SetProp(P_MSGOUT, "flattert weiter");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Schmetterling koennte damit nicht mehr fliegen.\n" }) );
}

