    "Juwel finden koennen. Bringe mir dieses Juwel zurueck und Du "
    "bekommst von mir dafuer sogar eine Belohnung.",
    "sagt: ");

  AddInfo( ({"belohnung"}),
    "Als Belohnung wuerde ich Dir eine meiner Karten von Dhrkion geben!",
    "sagt: ");

  AddInfo( ({"viecher","viech"}),
    "Die Viecher im Anfaengerpark sind nicht wirklich stark. Es sollte "
    "fuer Dich ein leichtes sein, das richtige Viech zu finden und zu "
    "toeten!",
    "sagt: ");

  AddInfo( ({"karten"}),
    "Ich habe daheim viele dieser Karten. Wenn Du mir eine kleine Aufgabe "
    "erfuellst, dann schenke ich Dir eine.",
    "sagt: ");

  AddInfo( ({"omar"}),
    "Omar, der in Avir lebt, bezeichnet sich selbst als der groesste "
    "Schwertmeister. Pah! So ein Unsinn. Es wird Zeit diese Sache "
    "ein fuer alle mal zu klaeren! Wenn er dich zu mir geschickt hat, "
    "wird es Zeit fuer eine Lloth-wuerdige Intrige!", "zischt: ");

  AddInfo( ({"schwert", "kreuzschwert"}),
    "Wenn du an mein Schwert willst, um es Omar dem selbsternannten "
    "Schwertmeister zu geben, dann gibt es nur zwei Wege: Entweder "
    "du besiegst mich, oder du laesst dich auf meine Intrige ein!", "zischt: ");

  AddInfo( ({"intrige"}),
    "Omar will mein Kreuzschwert? Dann soll er es haben! Ich werde es so "
    "vergiften, dass es ihn dahin rafft, wenn er es auch nur beruehrt! Bitte "
    "mich einfach um mein vergiftetes Schwert (<bitte odania um vergiftetes "
    "schwert>)", "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Odania sagt: Schlepp Deine Sachen gefaelligst selber!\n"
    "Odania wirft @WEN auf den Boden." }) );

  SetProp(P_SPELLRATE, 75);

  AddSpell(15, 400,
    "Odania sticht Dir ihr Schwert in den Bauch.\n",
    "Odania sticht @WEM ihr Schwert in den Bauch.\n",
     DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(15, 500,
    "Odania fuegt Dir eine tiefe und schmerzende Wunde zu.\n",
    "Odania fuegt @WEM eine tiefe und schmerzende Wunde zu.\n",
     DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_CURSE_WEAPON,
    "Odania verflucht Deine Waffe!!!\n",
    "Odania verflucht @WESSEN Waffe!!!\n" );

  AddDefaultSpell(5, 1, DS_REDUCE_AC,
    "Odania schlaegt sehr hart auf Deine Ruestung ein!!!\n",
    "Odania schlaegt sehr hart auf @WESSEN Ruestung ein!!!\n" );

  SetAttackChats(10,
    ({"Odania schwingt ihr Schwert.\n"
     ,"Odania fuehrt eine gekonnte Parade aus.\n"
     ,"Odania federt leicht zur Seite.\n"
     ,"Odania holt zu einem weiten Schlag aus.\n"
     ,"Es fliegen helle Funken umher.\n"
     ,"Odanias Schwertklinge saust an Deinem Kopf vorbei.\n"
     ,"Odania wird immer wilder!\n"
     ,"Der Kampf erregt grosses Aufsehen.\n"
     ,"Odanias Bewegungen werden immer flinker.\n"
     })
  );

  SUID;

  CLONEME(WEAPON "kreuzschwert" );
  command( "zuecke kreuzschwert");

  switch(random(100))
  {
    case  0..33: CLONEME(ARMOUR "chitinpanzer" );
                 break;
    case 34..66: CLONEME("/d/ebene/obj/ruestung/titanpanzer" );
                 break;
    default:     CLONEME("/p/armour/armour/ringelpanzer" );
                 break;
  }

  switch(random(100))
  {
    case  0..33: CLONEME("/p/armour/boots/lederschuhe" );
                 break;
    case 34..66: CLONEME("/p/armour/boots/lederstiefel" );
                 break;
    default:     CLONEME(ARMOUR "stiefel");
                 break;
  }

  switch(random(100))
  {
    case  0..33: CLONEME("/p/armour/trousers/lederhose" );
                 break;
    case 34..66: CLONEME(ARMOUR "chitinhose" );
                 break;
    case 67..99: CLONEME(ARMOUR "hose" );
    default:     break;
  }

  if(random(100)<20) CLONEME("/p/armour/ring/ring" );
  if(random(100)<33) CLONEME("/d/ebene/ronja/feenquest/armour/spitz" );

  command("trage alles");

  CLONEME(OBJ "dhrkionkarte" );

  AddCmd("bitte|bitt&odania&um&vergiftetes&schwert", "cmd_schwert", "Wen willst du um was bitten?");
}

public int cmd_schwert() {
  object schwert;
  schwert = present("kreuzschwert");

  if(!objectp(schwert)) {
    command_me("sag Ich habe gerade kein Schwert, " + TPN + ". Komm spaeter wieder.");
    return -1;
  }

  command_me("stecke schwert weg");
  if(schwert->move(TP, M_GET) != 1) {
    command_me("sag Komm wieder, wenn du mein Schwert tragen kannst!");
    command_me("zuecke schwert");
    return -1;
  }
  
  command_me("emote vergiftet ihr Schwert.");
  tell_object(TP, Name(WER) + " gibt dir ihr Kreuzschwert.\n");
  tell_room(ENV(TO), Name(WER) + " gibt " + TPN + " ihr Kreuzschwert.\n", ({TP}));

  schwert->SetProp(P_POISON, 10);
  schwert->SetProp(P_WC, 110);
  schwert->SetProp(P_WC_FIX, 25);
  schwert->SetProp(P_WIELD_RESTRICTIONS, 0);
  schwert->SetProp(P_SHORT, "Ein vergiftetes Kreuzschwert");
  schwert->SetProp(P_NAME_ADJ, "vergiftet");
  return 1;
}

public void reset() {
  if(!is_clone(TO)) return;
  ::reset();

  if(!objectp(present("kreuzschwert"))) {
    CLONEME(WEAPON "kreuzschwert" );
    command( "zuecke kreuzschwert");
  }
}

void init()
{
  ::init();

  if(TP && DHRKIONMASTER->checkfeind(TP))
  {
    if (!IsEnemy(TP) && living(TP))
    {
      call_out("angriff",0,TP,"Odania erkennt Dich sofort als Feind.\n");
      Kill(TP);
    }
  }

  if(JUWELENMASTER->IsQuester(getuuid(TP)))
  {
    call_out("macht_quest", 0, TP);
  }
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  object waf;
  int done;

  DHRKIONMASTER->addfeind(enemy);
  done=0;
  if(done!=1 && !spell && random(10)==3) {
    if(objectp(waf=enemy->QueryProp(P_WEAPON))) {
      if(ME->QueryProp(P_WEAPON)) {
        enemy->drop_obj(waf);
        if(environment(waf) == MENV) {
          tell_object(enemy,BS(
            "Odania pariert Deine Attacke besonders geschickt und Deine Waffe "
            "faellt zu Boden!"));
          tell_room(MENV,BS(
            "Odania pariert "+enemy->name(WESSEN)+" Attacke besonders geschickt "
            "und "+enemy->QueryPossPronoun(2)+" Waffe faellt zu Boden!"),
            ({ enemy }) );
          dam=dam*(25+random(50))/100;
          done=1;
        }
      }
    }
  }
  if(done!=1 && !spell && objectp(waf=enemy->QueryProp(P_WEAPON))) {
    if(waf->QueryProp(P_WEAPON_TYPE)==WT_SWORD) {
      if(ME->QueryProp(P_WEAPON)) {
        if(scroll==5) {
          tell_object(enemy,BS(
            "Odania pariert Deine Schwertattacke besonders gut!"));
          tell_room(MENV,BS(
            "Odania pariert "+enemy->name(WESSEN)+
            " Schwertattacke besonders gut!"),({ enemy }) );
        }
        scroll--;
        if(scroll<0) scroll=5;
        dam=dam*(25+random(50))/100;
        done=1;
      }
    }
  }
  if(done!=1 && spell) dam=dam*3/4;
  ::Defend(dam, dam_type, spell, enemy);
}

void InformDefend(object enemy)
{
  if(!IsEnemy(enemy) && living(enemy))
  {
    call_out("angriff", 0, enemy, "Odania hilft sofort Ihren Freunden.\n");
    Kill(enemy);
  }
}

void angriff(object enemy, string str)
{
  if(ENV(enemy) == ENV(TO)) tell_object(enemy, str);
}

void die(int poisondeath) {
  object ob;
  
// Fuer Zechprellerquest

  if(QueryProp(P_KILLER))
    ob = present("\nzechpreller_quest_11", QueryProp(P_KILLER));
  if(ob)
    ob->Mark();

  
  if(objectp(ob=present(RANGER_TASK_SCHNITZELJAGD, TP))) {
    ob->OdaniaKilled();
  }

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME) {
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde von Odania getoetet ("+lostexp+").\n");
    DHRKIONMASTER->feindtot(player);
  }
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(touch)
  {
    call_out("Reaction", 0, TP);
  }
}

void Reaction(object pl)
{
  if(ENV(TO) != ENV(pl)) return;

  if(pl->QueryProp(P_LEVEL) < 10)
  {
    tell_room(ENV(TO), BSI("Du wagst es mich anzufassen??? Waerst Du "
                           "schon erfahrener, "+pl->name()+", dann wuerde "
                           "ich Dich sofort toeten!!!\n",
                           "Odania bruellt: "));
    return;
  }

  if(!IsEnemy(pl))
  {
    tell_room(MENV, BSI("Du wagst es mich anzufassen??? Dafuer sollst Du "
                        "sterben, "+pl->name()+"!!!\n", "Odania bruellt: "));
    Kill(pl);
    return;
  }

  tell_room(ENV(TO), BS("Odania ist fuchsteufelswild und drischt "
                        "doppelt auf "+pl->name()+" ein.\n"), ({ pl }) );

  tell_object(pl, BS("Odania ist fuchsteufelswild und drischt "
                     "doppelt auf Dich ein.\n"));

  Attack(pl);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

string quest_info()
{
  string text, s;
  object ob;

  if(JUWELENMASTER->IsQuester(getuuid(TP)))
  {
    tell_object(TP, BSI("Du hast mich doch schon einmal danach gefragt, "
                        "aber leider wohl bisher versagt oder noch nicht "
                        "das richtige Viech getoetet.", "Odania sagt "
                        "enttaeuscht: "));

    return "uebt weiter ihren Schwertkampf.";
  }

  if(TP->QueryQuest(QUESTJUWELNAME))
  {
    tell_object(TP, BSI("Du hast mir doch mein Juwel schon wiedergebracht. "
                        "Moechtest Du vielleicht eine neue Karte haben?",
                        "Odania wundert sich: "));
    return "schaut Dich fragend an.";
  }

  JUWELENMASTER->StartQuest(getuuid(TP));
  JUWELENMASTER->Msg(ctime()+": "+CAP(getuid(TP))+" beginnt die "
                     "Juwelen-Quest");

  tell_object(TP, BSI("Um mir zu beweisen, dass Du ueberhaupt in der Lage "
                      "bist, kaempfen zu koennen, muesstest Du mir einen "
                      "abhandenen Gegenstand besorgen. Er ist fuer mich "
                      "ein besonderes Sammlerstueck, nur leider habe ich "
                      "selber keine Zeit mich darum zu kuemmern.",
                      "Odania fordert: "));

  return "schaut Dich fragend an.";
}

string karte_info()
{
  object ob;
  string s;

  if(JUWELENMASTER->IsQuester(getuuid(TP)))
  {
    tell_object(TP, BSI("Zuerst musst Du mir mein Juwel bringen, dann "
                        "bekommst Du auch eine Karte von mir!", "Odania "
                        "runzelt die Stirn: "));

    if(IS_WIZARD(TP))
    {
      tell_object(TP, "Magierinfo: Du hast bisher "+
                      JUWELENMASTER->GetKills(getuuid(TP))+
                      " NPCs getoetet.\n");
    }

    return "wendet sich von Dir ab.";
  }

  if(present("dhrkionkarte", TP))
  {
    return "sagt: "+TPN+", aber Du hast ja schon eine Karte!";
  }

  if(TP->QueryQuest(QUESTNAMEJUW))
  {
    tell_object(TP, BSI("WAS? Du hast Deine Karte verloren? Pass gefaelligst "
                        "das naechste Mal besser auf!", "Odania zuernt: "));

    tell_room(ENV(TO), BS("Odania wirft "+TPN+" eine Karte. vor die Fuesse, "
                          "die "+TP->QueryPronoun()+" schnell aufhebt und "
                          "einsteckt. "), ({ TP }) );

    s = "wirft Dir eine Karte vor die Fuesse";
    ob = clone_object(OBJ "dhrkionkarte");
    if(ob->move(TP, M_GET) == 1)
    {
      s += ", die Du schnell einsteckst.";
    }
    else
    {
      s += ".";
      ob->move(ENV(TO), M_NOCHECK);
    }

    return s;
  }

  tell_object(TP, BSI("Ich habe schon vor langer Zeit Karten von Dhrkion "
                      "angefertigt. Ich wuerde Dir sogar gerne eine "
                      "davon schenken. Aber nur, wenn Du eine kleine "
                      "Aufgabe erfuellst!", "Odania sagt: "));

  return "wedelt ganz stolz mit einer Karte von Dhrkion.";
}

void QuestLog(string s)
{
  write_file("/log/quests/juwel", dtime(time())+": "+s+"\n");
}

void macht_quest(object pl)
{
  object juwel, ob;
  string uid;
  int ret;

  if(ENV(pl) != ENV(TO)) return;

  if(!(juwel = present(QUESTJUWELID,pl))) return;

  if(!JUWELENMASTER->IsQuester(getuuid(TP)))
  {
    tell_room(ENV(TO), BSI("Ah, "+pl->Name()+". Du hast ja mein Juwel "
                           "gefunden!!!", "Odania schreit erfreut auf: ")+
                           "Nimmt Dir das Juwel ab.\n");

    juwel->remove();
    return;
  }

  if(juwel->QueryOwner() != getuuid(TP))
  {
    tell_room(ENV(TO), BSI("Ah, "+pl->Name()+". Du hast ja mein Juwel "
                           "gefunden!!!", "Odania schreit erfreut auf: ")+
                           "Nimmt Dir das Juwel ab.\n");

    juwel->remove();
    return;
  }

  if(JUWELENMASTER->GetKills(getuuid(TP)) <= 7)
  {
    tell_room(ENV(TO), BSI("Ah, "+pl->Name()+". Du hast ja mein Juwel "
                           "gefunden!!!", "Odania schreit erfreut auf: ")+
                           "Nimmt Dir das Juwel ab.\n");

    juwel->remove();
    return;
  }

  tell_room(ENV(TO), BSI("Ah, "+pl->name()+". Du hast ja mein Juwel "
                         "gefunden!!!", "Odania schreit erfreut auf: "));

  tell_room(ENV(TO),
    BS(pl->Name()+" gibt Odania ein winziges Juwel."), ({ pl })
  );

  tell_object(pl, "Du gibst Odania ihr Juwel zurueck.\n");

  juwel->remove();

  ob = clone_object(OBJ "dhrkionkarte");
  if(ob->move(TP, M_GET) == 1)
  {
    tell_room(ENV(TO), BS(
      "Strahlend ueberreicht Odania "+pl->Name(WEM)+" eine Karte von "
      "Dhrkion."), ({ pl })
    );

    tell_object(pl, BSI(
      "Du hast Deine Aufgabe erfolgreich erfuellt. So nimm diese Karte von "
      "Dhrkion als Zeichen meiner Anerkennung. Solltest Du diese Karte "
      "einmal verlieren, so brauchst Du mich nur wieder danach zu fragen.",
      "Odania sagt: ")+"Strahlend ueberreicht Odania Dir eine Karte von "
      "Dhrkion.\n");
  }
  else
  {
    tell_room(ENV(TO), BS(
      "Odania versucht "+pl->Name(WEM)+" eine Karte von Dhrkion zu geben, "
      "wirft sie "+pl->QueryPronoun(WEM)+" dann aber vor die Fuesse."),
      ({ pl })
    );

    tell_object(pl, BSI(
      "Du hast Deine Aufgabe erfolgreich erfuellt. Aber Du Schwaechling "
      "kannst noch nicht einmal diese jaemmerlich leichte Karte tragen! ",
      "Odania sagt: ") + "Odania wirft Dir eine Karte vor die Fuesse!\n");

    ob->move(ENV(TO), M_NOCHECK);
  }

  uid = CAP(getuid(TP));
  ret = TP->GiveQuest(QUESTJUWELNAME);

  switch(ret)
  {
    case 1:
      JUWELENMASTER->Msg(uid + " loest die Quest");
      QuestLog(uid + " loest die Quest.\n" );
      JUWELENMASTER->DeleteQuester(getuuid(TP));
      break;

    case -1:
      JUWELENMASTER->Msg(uid + " loest die Quest wiederholt");
      QuestLog(uid + " loest die Quest zum wiederholten Mal.");
      JUWELENMASTER->DeleteQuester(getuuid(TP));
      break;

    case -2:
      JUWELENMASTER->Msg(uid + " loest die noch nicht eingetragene Quest");
      QuestLog(uid + " loest die nicht eingetragene Quest");
      tell_room(ENV(TO), "Die Quest ist noch nicht eingetragen.\n");
      JUWELENMASTER->DeleteQuester(getuuid(TP));
      break;

    case -3:
      JUWELENMASTER->Msg(uid + " loest die Quest, aber unbefugter Zugriff");
      QuestLog(uid + " loest die Quest, Fehler unbefugter Zugriff.");
      tell_room(ENV(TO), "Unbefugter Zugriff.\n");
      JUWELENMASTER->DeleteQuester(getuuid(TP));
      break;

    case -4:
      JUWELENMASTER->Msg(uid + " loest die nicht aktive Quest");
      QuestLog(uid+" loest die nicht aktive Quest");
      tell_room(ENV(TO), "Die Quest ist derzeit deaktiviert.\n");
      JUWELENMASTER->DeleteQuester(getuuid(TP));
      break;

    default:
      JUWELENMASTER->Msg(sprintf("%s loest die Quest mit Fehler %d", uid, ret));
      QuestLog(sprintf("%s loest die Quest mit Fehler %d", uid, ret));
      tell_room(ENV(TO), sprintf("Unbekannter Fehler bei der Questvergabe: %d\n",ret));
//    Questdaten bleiben im Master erhalten...
      break;
  }

  return;
}
