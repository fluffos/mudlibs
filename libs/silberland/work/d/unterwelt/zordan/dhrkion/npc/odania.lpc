                          ROOM "weg", ROOM "gef", ROOM "palast",
                          ROOM "tempel", "/d/seher/haus"}) );

  SetProp(P_MNPC_WAIT, ({ 20, 20, 5 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "tempel");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES +
                        MOV_SPECIAL + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " stoesst sich ihr eigenes Schwert in die "
                      "Rippen und stirbt.\n");

  AddInfo(DEFAULT_INFO,
    ({"sagt: Stoer mich nicht mit solch unwichtigen Sachen!\n"
     ,"macht einfach weiter mit ihren Uebungen.\n"
     ,"sagt: Psssst, ich muss mich konzentrieren!\n"
     ,"sagt energisch: RUHE!\n"
     ,"fragt: Hast Du eigentlich schon eine Karte von Dhrkion?"
     })
  );

  AddLibrary(NPC "dhrkion.lib",1);

  AddInfo( ({"zordan"}) ,
    "Das Seicherl kann ja nicht einmal mit einem Schwert umgehen!"
    ,
    "lacht: ");

  AddInfo( ({"ueben","uebung"}),
    "Ich uebe jederzeit und ueberall den Schwertkampf.",
    "sagt: ");

  AddInfo( ({"schwertkampf","kampf"}),
    "Ich habe noch nie einen fairen Schwertkampf verloren!",
    "sagt: ");

  AddInfo( ({"odania"}),
    "Ja, so heisse ich. Stoer mich nicht weiter!",
    "sagt: ");

  AddInfo( ({"schwert"}),
    "Ich bin eine Schwertmeisterin. Mit meinem besonderen Schwert bin "
    "ich quasi unbesiegbar!!",
    "sagt stolz: ");

  AddInfo( ({"schwertmeisterin","meisterin"}),
    "Viele behaupten, dass ich mit dem Schwert eine wahre Meisterin bin.",
    "sagt: ");

  AddInfo( ({"parade","parieren"}),
    "Besonders gut beherrsche ich die Parade, bei der mein Gegner "
    "seine Waffe verliert!",
    "sagt voller Stolz: ");

  AddInfo( ({"magie","antimagie","attacken","attacke"}),
    "Durch meine Mutter wurde ich gegen magische Attacken besonders "
    "geschuetzt.",
    "fluestert: ");

  AddInfo( ({"karte"}), #'karte_info);

  AddInfo( ({"quest","aufgabe","lage"}), #'quest_info);

  AddInfo( ({"hilfe"}),
    "Ich brauche Deine Hilfe nicht wirklich. Aber Du koenntest Dich ja "
    "vielleicht in einer kleinen Aufgabe beweisen?",
    "sagt: ");

  AddInfo( ({"gegenstand"}),
    "Bei diesem Gegenstand handelt es sich um ein winziges Juwel. "
    "Ich habe dieses Juwel in der Naehe des Anfaengerparks verloren. ",
    "sagt: ");

  AddInfo( ({"naehe","anfaengerpark","park","anfaenger"}),
    "Der Anfaengerpark liegt im Suedwesten ausserhalb der Stadt! Du musst "
    "zuerst durch eines der beiden Tore gehen und Dich dann eben "
    "suedwestlich halten.",
    "sagt: ");

  AddInfo( ({"tore","tor"}),
    "Die Tore werden bei Gefahr geschlossen. Du kannst dann weder in die "
    "Stadt noch nach draussen kommen.",
    "sagt: ");

  AddInfo( ({"juwel"}),
    "Ich glaube, eines dieser Viecher im Anfaengerpark hat mein Juwel "
