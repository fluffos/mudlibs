#include "../def.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"

#define DEBUGMASTER "/players/torian/master/master"

inherit STDDARKELF;
inherit "std/npc/spells.lpc";

int scroll;
string karte_info();
string quest_info();

#define QUESTNAMEJUW "Finde das Juwel" //April 2004 by Malar - Sonst wird bei
                                    //der Belohnung nach den Runen der Priesterin
                                    //gefragt, so dass die Spieler, welche die
                                    //Runenquest noch nicht haben, auch keine
                                    //Belohnung dieser Quest bekamen.

void create()
{
  if (!is_clone(TO)) return;
  ::create();

// Check fuer doppelte Odanias ... Wer auch immer staendig dazwischen funkt
  if(file_name(previous_object())!="/d/unterwelt/zordan/dhrkion/room/weg-e6") 
  {
    DEBUGMASTER->Msg("Wer war das denn?");
    if(previous_object()->Name())
