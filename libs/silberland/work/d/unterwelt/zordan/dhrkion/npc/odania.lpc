  AddId( ({"odania", "schwertmeisterin"}) );

  create_default_darkelf(32, 25, 0);

  SetProp(P_HANDS, ({" mit ihren dunklen Haenden",340+random(100),DT_UNHOLY}));
  SetProp(P_SIZE, 195+random(30));
  SetProp(P_ALIGN, -600-random(2)*75);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_BODY, QueryProp(P_BODY)*3/2);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.1, DT_COLD:     -0.1, DT_WATER:      -0.1
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:  -0.1
     , DT_SOUND:    -0.1, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.2
     , DT_HOLY:      0.1, DT_UNHOLY:   -0.8, DT_MAGIC:      -0.2
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
