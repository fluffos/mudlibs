#include "../def.h"

inherit NPC "parknpc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Wurm");
  SetProp(P_LONG,
    "Dieser eklige Wurm schleimt ueber den Boden und hinterlaesst eine "
    "Schleimspur. Sein gewundener Koerper ist nicht gerade widerstands"
    "faehig. Wahrscheinlich kannst Du ihn mit einem winzigen Schlag "
    "oder Tritt zu Lars schicken");

  SetProp(P_NAME, "Wurm");
  SetProp(P_GENDER, MALE);
  AddId(({"wurm"}));

  create_default_npc(1);
  SetProp(P_HANDS, ({" mit seinem schleimigen Ende",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Wurm");
  SetProp(P_SIZE, 3);
  SetProp(P_ALIGN, 30);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");

  SetProp(P_DIE_MSG,  " liegt zerquetscht am Boden.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Wurm kann @WAS doch nicht tragen.\n" }) );

  SUID;
  CLONEME( OBJ "wurmhaut" );
}

