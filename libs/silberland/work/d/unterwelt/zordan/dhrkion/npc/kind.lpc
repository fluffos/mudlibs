#include "../def.h"

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

mapping race;

void create()
{
  string name, *temp, raceid;
  int gender,level;

  if (!is_clone(TO)) return;

  ::create();

  race =
    (["elf":    "Elfen"   ;  195;  70000; "geht"
     ,"zwerg":  "Zwergen" ;  120;  75000; "geht"
     ,"mensch": "Menschen";  175;  75000; "geht"
     ,"fee":    "Feen"    ;   60;  20000; "flattert"
     ,"oger":   "Oger"    ;  250; 200000; "stapft"
     ,"troll":  "Troll"   ;  330; 350000; "trampelt"
     ,"hobbit": "Hobbit"  ;  100;  50000; "geht"
     ]);

  temp    = m_indices(race);
  raceid  = temp[random(sizeof(temp))];
  gender  = random(2) ? MALE:FEMALE;
  level   = 1;

  if(raceid == "fee") gender = FEMALE;
  name    = race[raceid,0] + (gender==MALE?"junge":"maedchen");

  SetProp(P_LONG,
    "Dieses kleine Kind wurde wohl gewaltsam seinen "+race[raceid,0]+
    "eltern entrissen und hier eingesperrt. Es weint und ist ziemlich "
    "eingeschuechtert. Man versucht wohl dieses Kind anders zu erziehen und "
    "hat wohl ziemlichen Erfolg damit."
  );

  SetProp(P_NAME, name);

  if(gender == MALE)
  {
    SetProp(P_SHORT, "Ein kleiner "+name);
    SetProp(P_GENDER, MALE);
    AddId( ({"junge"}) );
    level++;
  }
  else
  {
    SetProp(P_SHORT, "Ein kleines "+name);
    SetProp(P_GENDER, NEUTER);
    AddId( ({"maedchen"}) );
  }

  AddId( ({"kind", LOWER(name),raceid }) );

  SetProp(P_NAME_ADJ, ({"klein"}) );
  AddAdjective( ({"kleinen","kleiner","kleinem","kleines","kleine"}) );

  create_default_npc(level);
  SetProp(P_HANDS, ({" nicht",1,DT_BLUDGEON}));
  SetProp(P_RACE,   raceid);
  SetProp(P_SIZE,   race[raceid,1]/3);
  SetProp(P_WEIGHT, race[raceid,2]/3);
  SetProp(P_ALIGN, 150+random(50));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK,"wuerdest Du niemals angreifen.");

  SetProp(P_MSGIN, "wird hereingeschmissen");
  SetProp(P_MSGOUT, "geht");

  AddInfo(DEFAULT_INFO, "kann vor lauter Angst nichts sagen.\n");

  AddInfo("zordan", "Der fiese Kerl hat uns nicht geholfen.","weint: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" ist aus Angst nicht in der Lage etwas zu tragen!\n" }) );

  SetProp(P_SPELLRATE,100); // gag fuer die druiden ;)))

  SetChats(1,
    ({Name(WER,1)+" lehnt sich an Deine Schulter.\n"
     ,Name(WER,1)+" starrt entgeistert an die Decke.\n"
     ,Name(WER,1)+" schluchzt laut.\n"
     ,Name(WER,1)+" bettelt Dich um Hilfe an.\n"
     ,Name(WER,1)+" steht wie angewurzelt in einer Ecke.\n"
     ,Name(WER,1)+" sagt: Ich will zu meiner MAMA!\n"
     ,Name(WER,1)+" weint.\n"
     })
  );
}

