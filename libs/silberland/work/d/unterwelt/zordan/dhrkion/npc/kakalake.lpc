#include "../def.h"

inherit NPC "parknpc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Kakerlake");
  SetProp(P_LONG,
    "Diese fiese Kakerlake krabelt am Boden entlang und sucht sich ein "
    "neues Opfer. Hoffentlich wird sie selber kein Opfer fuer angehende "
    "Abenteurer."
  );

  SetProp(P_NAME, "Kakerlake");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kakerlake"}) );

  create_default_npc(3);
  SetProp(P_HANDS, ({" mit ihrem kleinen Gebiss",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Kakerlake");
  SetProp(P_SIZE, 3);
  SetProp(P_ALIGN, -20);
  SetProp(P_HEAL, 3);

  SetProp(P_MSGIN, "huscht herein");
  SetProp(P_MSGOUT, "huscht");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Kakerlake traegt nichts.\n" }) );
}

