#include "../def.h"

inherit STDDARKELF;

#include <bank.h>

#define RBS(x) break_string(x, 78, Name(WER,1)+" sagt: ", 1)
#define MIN_WEAPON_COST 50
#define MIN_ARMOUR_COST 200

int rep_money, dam_rest_wc, dam_rest_ac, callouts;

void create()
{
  if (!is_clone(TO)) return;

  dam_rest_wc = 0;
  dam_rest_ac = 0;
  rep_money   = 0;

  ::create();

  SetProp(P_SHORT, "Fjuro, der Schmied");
  SetProp(P_LONG,
    "Ein staemmiger Kerl haelt einen riesigen Schmiedehammer in seiner Hand "
    "und bearbeitet das Metall auf dem Amboss. Seine Haare sind schon ganz "
    "dunkel von dem ganzen Rauch im Raum geworden. Seine stattliche Figur "
    "stellt sicherlich einen starken Gegner dar. Eigentlich ist er ja sogar "
    "recht freundlich. Richtig ungewoehnlich fuer einen Dunkelelfen."
  );

  SetProp(P_NAME, "Fjuro");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);

  AddId( ({"fjuro","Reparateur","NOWIMPY"}) );
  set_living_name("fjuro");

  create_default_darkelf(30, 25, 0);

  SetProp(P_HANDS, ({" mit seinen schmutzigen Haenden",300,DT_BLUDGEON}));

  SetProp(P_SIZE, 210+random(20));
  SetProp(P_ALIGN, -200-random(50));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.1, DT_COLD:      0.0, DT_WATER:      -0.2
     , DT_AIR:      -0.2, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.1, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.5
     , DT_HOLY:      0.4, DT_UNHOLY:   -0.5, DT_MAGIC:      -0.5
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "kommt an und faengt an zu arbeiten");
  SetProp(P_MSGOUT, "geht");

  SetProp(P_DIE_MSG,  " bricht in einem lauten Schrei zusammen.\n");

  AddInfo(DEFAULT_INFO, "sagt: Was genau kann ich fuer Dich tun?\n");

  SetProp(P_LOG_INFO, "dhrkion.log");
  AddLibrary( NPC "dhrkion.lib",1);

  AddInfo( ({"reparatur", "reparieren", "repariere"}),
    "Wenn Du willst, kann ich Deine Waffen und Ruestungen reparieren. Gib "
    "dazu einfach 'repariere <name>' ein. Leider muss ich aber einiges an "
    "Geld dafuer verlangen.", "sagt: ");

  AddInfo("zordan", "Zordan ist eine miese Kakerlake.","sagt: ");

  AddInfo( ({"schmied","fjuro"}),
    "Genau, das bin ich.",
    "grinst: ");

  AddInfo( ({"schmiede"}),
    "Das hier ist meine Schmiede. Du stehst mittendrin.",
    "sagt: ");

  AddInfo( ({"waren","ware"}),
    "Meine Waren sind allerbester Guete.",
    "sagt: ");

  AddInfo( ({"preis","preise"}),
    "Bitte lies das Schild.",
    "sagt: ");

  AddInfo( ({"vergleichen","vergleiche"}),
    "Ich kann zwei Gegenstaende miteinander vergleichen und Dir die "
    "Unterschiede sagen.",
    "sagt: ");

  AddInfo( ({"repariere","reparieren"}),
    "Ich bin sehr gut im Reparieren von Waffen und Ruestungen.",
    "sagt: ");

  AddInfo( ({"spezialgebiet"}),
    "Frag mich nicht, sondern geb es bitte einfach so ein.",
    "sagt: ");

  AddInfo( ({"verschoener","verschoenern"}),
    "Ich kann Deine Sachen verschoenern. Leider ist das aber im Moment noch "
    "nicht moeglich, da mein Nachschubweg unterbrochen ist.",
    "sagt: ");

  AddInfo( ({"verbesser","verbessern"}),
    "Ich kann Deine Waffen und Ruestungen ein wenig verbessern. Leider "
    "fehlen mir dazu im Moment die noetigen Rohstoffe.",
    "sagt: ");

  AddInfo( ({"rohstoffe","nachschub"}),
    "Schau doch wieder mal rein. Vielleicht kann ich dann ja schon helfen!!!",
    "sagt: ");

  AddInfo( ({"name"}),
    "Mein Name ist Fjuro.",
    "sagt: ");

  AddInfo( ({"rune","runen" }), "@@info_runen@@" );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Fjuro kann das leider nicht mehr tragen.\n" }) );

  SetProp(P_SPELLRATE,30);

  AddSpell(5,300,
    "Fjuro haut Dir mit seinem Hammer direkt auf den Kopf.\n",
    "Fjuro haut @WEN mit seinem Hammer direkt auf den Kopf.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,350,
    "Fjuro versucht Dich unwillig zu machen.\n",
    "Fjuro versucht @WEN unwillig zu machen.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,400,
    "Fjuro gibt Dir einen Fusstritt zwischen die Beine.\n",
    "Fjuro gibt @WEN einen Fusstritt zwischen die Beine.\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,200,
    "Fjuro hat die Schnauze voll und wirft Dich raus.\n",
    "Fjuro hat die Schnauze voll und wirft @WEN einfach raus.\n",
     DT_BLUDGEON, "spellfkt");


  SetChats(1,
    ({"Fjuro fragt Dich: Was kann ich schoenes fuer Sie tun?\n"
     ,"Fjuro fragt Dich: Moechten Sie nicht etwas reparieren lassen?\n"
     ,"Fjuro schaut das fast fertige Schwert nochmal nachdenklich an.\n"
     ,"Fjuro bringt das Feuer richtig zum Gluehen.\n"
     ,"Fjuro spannt seine starken Muskeln an.\n"
     ,"Fjuro bedient einen Dunkelelfen und wendet sich wieder seiner "
      "Arbeit zu.\n"
     ,"Fjuro fuegt dem Eisen einen besonders harten Schlag zu.\n"
     })
  );

  SetAttackChats(10,
    ({"Fjuro verflucht Dich laut.\n"
     ,"Fjuro gibt Dir eine Ohrfeige.\n"
     ,"Fjuro holt zu einem besonders hartem Schlag aus.\n"
     ,"Fjuro draengt Dich fast nach Draussen.\n"
     })
  );

  AddCmd( ({"repariere", "reparatur"}), "reparatur");

  SUID;
  CLONEME(WEAPON "hammer" );
  command("zuecke hammer");
  CLONEME( "/p/armour/gloves/lederhandschuhe" );
  CLONEME( ARMOUR "hose" );
  CLONEME( ARMOUR "bleiweste" );
  command("trage alles");

  callouts = 0;
}

void reset()
{
  ::reset();

  if(rep_money) ZENTRALBANK->PayIn(rep_money);
  rep_money = 0;
  callouts  = 0;
}

varargs void die(int poisondeath)
{
  object enemy;

  if(enemy = QueryProp(P_KILLER))
  {
    write_file(LOG "spieler.kills",
      ctime()+": "+CAP(getuid(enemy))+" killt Fjuro.\n");

    tell_object(enemy, BS("Fjuro versucht Dich noch mit zu Lars zu "
                          "ziehen, indem er Dich in das Feuer drueckt."));

    tell_room(ENV(TO), BS("Fjuro drueckt "+enemy->name(WEN)+" noch mit "
                          "allerletzter Kraft ins Feuer, bevor er stirbt."));

    enemy->do_damage(30+random(40));
  }

  ::die(poisondeath);
}

void spellfkt(object enemy, int damage, mixed dam_type)
{
  enemy->Defend(damage, dam_type, ([SP_SHOW_DAMAGE:1,SP_NAME:"rauswurf"]), TO );
  enemy->move( ROOM "laden", M_SILENT+M_GO );
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  DHRKIONMASTER->addfeind(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "spieler.deads", ctime()+": "+CAP(getuid(player))+
      " wurde von Fjuro getoetet ("+lostexp+").\n");
    DHRKIONMASTER->feindtot(player);
  }
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(++callouts > 5) return;

  switch(gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "sagt: Du bist ja eine Memme, "+TPN+".",
        "sagt: Du bist ja eine Memme, "+TPN+".");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt.",
        "grummelt.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "sagt: Lass das, ich hass das, "+TPN+".",
        "sagt: Lass das, ich hass das, "+TPN+".");
      break;

    case "fies":
    case "frech":
      call_out("reaction", 0, TP,
        "tritt Dich.",
        "tritt "+TPN+".");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "sagt: Schoen fuer Dich, "+TPN+".",
        "sagt: Schoen fuer Dich, "+TPN+".");
      break;

    case "intim":
      if (TP->QueryProp(P_GENDER) == MALE)
      {
        call_out("reaction", 0, TP,
          "tritt Dir feste ins Gemaecht.",
          "tritt "+TPN+" feste ins Gemaecht.");
      }
      else
      {
        call_out("reaction", 0, TP,
          "kuschelt sich an Dich an.",
          "kuschelt sich an "+TPN+" an.");
      }
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "fragt Dich: Na und? Sowas ignoeriere ich doch einfach.",
        "fragt "+TPN+": Na und? Sowas ignoeriere ich doch einfach.");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "schaut Dich einfach nur an.",
        "schaut "+TPN+" einfach nur an.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "sagt: Du Flache, "+TPN+".",
        "sagt: Du Flache, "+TPN+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere)
{
  callouts--;

  if(ENV(ob) == ENV(TO))
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

int rep_auswahl(object ob)
{
  if(ob->QueryProp(P_WEAPON_TYPE) == WT_SWORD ||
     ob->QueryProp(P_WEAPON_TYPE) == WT_KNIFE  )
  {
    tell_room(ENV(TO), "Fjuro sagt: "+ob->Name(WER,1)+" ist super. Darauf "
                       "bin ich spezialisiert.\n");
    return 1;
  }

  if(ob->QueryProp(P_WEAPON_TYPE))
  {
    tell_room(ENV(TO), "Fjuro sagt: Ich kann leider nur Schwerter, Dolche "
                       "und Messer reparieren!\n");
    return 0;
  }

  if(ob->QueryMaterial(MAT_CHITIN) > 0)
  {
    tell_room(ENV(TO), "Fjuro sagt: "+ob->Name()+" besteht aus Chitin, da "
                       "kann ich helfen!\n");
    return 1;
  }

  tell_room(ENV(TO), "Fjuro sagt: Ich kann nur Ruestungen aus Chitin "
                     "reparieren!\n");
  return 0;
}

int reparatur( string str)
{
  object ob;

  int dam, value, wert, kosten, min_kosten, damrest, damrest_pct;

  if(TP->InFight())
  {
    notify_fail("Im Kampf geht das nicht!\n");
    return 0;
  }

  notify_fail("Fjuro fragt: Was willst Du reparieren lassen?");

  if(!str || str == "") return 0;

  if(!(ob = present(str, TP))) return 0;

  if((dam = ob->QueryProp(P_DAMAGED)) == 0)
  {
    tell_object(TP, BSI("Aber "+ ob->name(WER,1)+ " braucht gar keine "
                        "Reparatur.", Name(WER)+" meint: "));
    return 1;
  }

  if((value = ob->QueryProp(P_VALUE)) == 0)
  {
    tell_object(TP, BSI("Ich repariere keine wertlosen Sachen!",
                        Name(WER,1)+" murmelt: "));
    return 1;
  }

  if( ob->QueryProp(P_WEAPON_TYPE))
  {
    if(ob->Query(P_WC, F_QUERY_METHOD))
    {
      write(RBS("Das scheint verzaubert zu sein. Komm doch wieder, wenn "
                "der Zauber erloschen ist!"));
       return 1;
    }

    wert = ob->QueryProp(P_WC);
    min_kosten  = MIN_WEAPON_COST * dam;
    damrest_pct = dam_rest_wc + random(dam_rest_wc/2);
  }
  else if( ob->QueryProp(P_ARMOUR_TYPE))
  {
    if(ob->Query(P_AC, F_QUERY_METHOD))
    {
      write(RBS("Das scheint verzaubert zu sein. Komm doch wieder, wenn "
                "der Zauber erloschen ist!"));
      return 1;
    }

    wert = ob->QueryProp(P_AC);
    min_kosten  = MIN_ARMOUR_COST * dam;
    damrest_pct = dam_rest_ac + random(dam_rest_ac/2);
  }
  else
  {
    write(RBS("Ich kann nur Waffen und Ruestungen reparieren."));
    return 1;
  }

  if(!rep_auswahl(ob)) return 1;

  if( damrest_pct )
  {
    damrest = ((wert+dam) * damrest_pct) / 100;
    if(damrest < 1) damrest = 1;
    if(dam <= damrest)
    {
      write(RBS("Hmmm, die Schaeden an "+ob->name(WEM,1)+" sind minimal, "
                "da kann ich auch nichts mehr weiter tun!"));
      return 1;
    }
  }

  kosten = 3 * value * dam /  (dam+wert) ;
  if(kosten < min_kosten ) kosten = min_kosten;
  write(RBS("Die Reparatur "+ob->name(WESSEN,1)+" wuerde "+kosten +
        " Muenzen kosten!"));
  write(Name(WER,1)+" fragt Dich: Willst Du das bezahlen?\n");
  write(" (ja/nein) -> ");
  input_to("reparieren2",0, ob, dam, kosten, time());
  return 1;
}

void reparieren2(string str, object ob, int damrep, int kosten, int zeit)
{
  if(!TP) return;
  if(ENV(TP) != ENV(TO))
  {
    write("Dazu ist es jetzt zu spaet!\n");
    return;
  }

  if(time() > (zeit+15))       // 15 Sekunden Zeit
  {
    write(RBS("Du hast Dir zuviel Zeit gelassen! Ueberlege es Dir "
              "noch einmal... unser Angebot bleibt natuerlich bestehen!"));
    return;
  }

  if ((str!="ja") && (str!="j"))
  {
    write(RBS("Na gut, wie Du meinst. Viel Spass noch damit!"));
    return;
  }

  if (!ob)
  {
    write(RBS("Nanu, wo ist denn der fragliche Gegenstand "
        "so ploetzlich hinverschwunden??"));
    return;
  }

  if(ENV(ob) != TP)
  {
    write(RBS("Nanu, wo ist denn "+ob->name(WER,1)+
        " so ploetzlich hinverschwunden??"));
    return;
  }

  if (damrep > ob->QueryProp(P_DAMAGED))
  {
    write(RBS("Huch, irgendwas stimmt da nicht, "+ob->name(WER,1)+
        " ist ja gar nicht mehr so arg beschaedigt wie vorhin!"
        " Probier es doch bitte noch einmal..."));
    return;
  }

  if(TP->QueryMoney() < kosten)
  {
    write(RBS("Das Problem ist nur, dass Du "+kosten+" Muenzen "
              "gar nicht dabeihast! Das beste ist, Du holst Dir etwas "
              "Geld von der Bank oder pumpst Dir etwas..."));
    return;
  }

  if( ob->QueryProp(P_CURSED) )
  {
    write(RBS(ob->Name(WER,1)+" ist verflucht! Darum kann ich "+
        ob->QueryPronoun(WEN)+" nicht reparieren. Versuch doch mal, "
        "den Fluch loszuwerden und komm dann wieder her."));
    return;
  }

  ob->SetProp(P_DAMAGED, ob->QueryProp(P_DAMAGED)-damrep);

  if( ob->QueryProp(P_WEAPON_TYPE))
  {
    ob->SetProp(P_WC,ob->QueryProp(P_WC)+damrep);
    if( ob->QueryProp(P_WC) > MAX_WEAPON_CLASS )
    {
      write("Illegale Waffenklasse!!!! Erzmagier verstaendigen!!!!\n");
      call_other( "/secure/master", "runtime_error",
        "Illegale Waffenklasse beim Reparieren!\n", file_name(this_object()),
        getuid(this_player()), 178);
      ob->SetProp(P_WC,ob->QueryProp(P_WC)-damrep);
      ob->SetProp(P_DAMAGED, ob->QueryProp(P_DAMAGED)+damrep);
      return;
    }
  }
  else if( ob->QueryProp(P_ARMOUR_TYPE))
  {
    ob->SetProp(P_AC,ob->QueryProp(P_AC)+damrep);
    if( ob->QueryProp(P_AC) > VALID_ARMOUR_CLASS[ob->QueryProp(P_ARMOUR_TYPE)] )
    {
      write("Illegale Ruestungsklasse!!!! Erzmagier verstaendigen!!!!\n");
      call_other( "/secure/master", "runtime_error",
        "Illegale Ruestungsklasse beim Reparieren!\n", file_name(this_object()),
        getuid(this_player()), 189);
      ob->SetProp(P_AC,ob->QueryProp(P_AC)-damrep);
      ob->SetProp(P_DAMAGED, ob->QueryProp(P_DAMAGED)+damrep);
      return;
    }
  }
  TP->AddMoney(-kosten);
  rep_money+=kosten;
  write(BS(Name(WER,1)+" nimmt Dir "+kosten+" Muenzen ab und beginnt "
    "mit der Reparatur "+ob->name(WESSEN,1)+"."));
  TP->SetProp(P_PARALYZED, ([PARALYZE_TIME:1+damrep/10,
        PARALYZE_MSG: BS( "Du wartest noch auf die Reparatur "
           +ob->name(WESSEN,1)+".\n"),
        PARALYZE_END: BS(Name(WER,1)+" ist fertig und drueckt Dir "
           +ob->name(WEN,1)+" in wesentlich besserem Zustand als zuvor in "
           "die Hand."),
        PARALYZE_MSG_OTHER:TP->Name()+" wartet auf eine Reparatur.\n",
        PARALYZE_END_OTHER: BS(Name(WER,1)+ " gibt "+ob->name(WEN,1)+" an "+
            TP->name(WEN)+".")]) );
}


string info_runen(string str)
{
  object ob;

  if(RUNENMASTER->IsRuneHere(getuuid(TP), 8) == 1)
  {
    tell_object(TP, BSI("Hm, es koennte durchaus sein, dass ich so eine "
                        "Rune habe. Aber ich gebe sie Dir nur, wenn Du "
                        "mir einen Gefallen tust. Damals als Dhrkion "
                        "weiter ausgebaut wurde, habe ich meinen "
                        "groessten und schoensten Edelstein verloren. "
                        "Bring mir diesen Edelstein und Du bekommst von "
                        "mir die Rune dafuer.", "Fjuro fluestert: " ));
    return "wendet sich wieder seinem Feuer zu.";
  }

  tell_object(TP, BSI("Ein paar Dunkelelfen haben von ein paar Runen und "
                      "der Priesterin erzaehlt.", "Fjuro sagt: " ));

  return "geht wieder an seine Arbeit.";
}

void give_notify(object ob)
{
  if(!(ob->id("\n_runenquest_edelstein")))
  {
    tell_object(TP, BSI("Was soll ich damit?", "Fjuro runzelt die Stirn: ")+
                    BS("Fjuro wirft "+ob->name(WEN)+" ins Feuer."));
    ob->remove();
    return;
  }

  if(RUNENMASTER->GetRune(getuuid(TP), 8) == 1)
  {
    tell_object(TP, BSI("Vielen Dank! Hier hast Du wie versprochen die "
                        "Rune.", "Fjuro sagt: ")+ "Fjuro gibt Dir eine "
                        "kleine Rune.\n");
  }
  else
  {
    tell_object(TP, BSI("Oh, ein wunderbarer Edelstein. Danke.",
                        "Fjuro sagt: "));
  }

  ob->remove();
  return;
}
