#include "../def.h"

inherit NPC "parknpc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine kleine Ameise");
  SetProp(P_LONG,
    "Ups, die ist ja suess. Eine winzige Ameise krabbelt ueber den Boden. "
    "Fast haettest Du sie uebersehen und unter Dir vergraben."
  );

  SetProp(P_NAME, "Ameise");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"ameise"}) );

  SetProp(P_NAME_ADJ, ({"klein"}) );
  AddAdjective( ({"kleinen","kleiner","kleinem","kleines","kleine"}) );


  create_default_npc(2);
  SetProp(P_HANDS, ({" mit ihren Zangen",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Ameise");
  SetProp(P_SIZE, 2);
  SetProp(P_ALIGN, random(50));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 2);

  SetProp(P_MSGIN, "krabbelt rein");
  SetProp(P_MSGOUT, "krabbelt");

  SetProp(P_DIE_MSG,  " streckt alle Sechse von sich.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Ameise ist doch viel zu klein dafuer.\n" }) );

  SUID;

  CLONEME("/d/ebene/obj/waffe/azange" );
  command("zuecke zange");
}

