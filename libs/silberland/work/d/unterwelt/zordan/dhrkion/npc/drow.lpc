#include "../def.h"

inherit "/d/unterwelt/basics/central/npc/std_darkelf";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include <class.h>
#include <npcmaster.h>

int callouts;
int gender;
int level;
int glevel;

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  gender = random(2) ? MALE:FEMALE;
  level  = 10+random(5);

  if(gender == MALE)
  {
    SetProp(P_SHORT, "Ein Dunkelelf");
    SetProp(P_LONG,
      "Vor Dir steht ein Dunkelelf mittleren Alters. Er geht wohl seiner "
      "alltaeglichen Arbeit nach und beachtet Dich auch nicht weiter. Sein "
      "typisch weisses Haar haengt schon ein wenig ueber seine dunkelroten "
      "Augen."
    );
    SetProp(P_NAME, "Dunkelelf");
    glevel = 12;
  }
  else
  {
    SetProp(P_SHORT, "Eine Dunkelelfin");
    SetProp(P_LONG,
      "Eine recht huebsche Dunkelelfin faellt durch ihre besonders hell "
      "leuchtenden Augen auf. Ihr langes Haar faellt weit ihren Ruecken "
      "hinunter. Viel arbeiten tut sie aber anscheinend nicht, denn sie "
      "ist sehr sauber. Die Arbeit uebernimmt wohl ihr Ehemann, wenn sie "
      "denn einen hat."
    );
    SetProp(P_NAME, "Dunkelelfin");
    AddId( ({"dunkelelfin","elfin"}) );

    level += 3;
    glevel = 15;
  }

  AddId( ({"\ndunkelelf","Schwertexperte"}) );
  SetProp(P_GENDER,gender);

  create_default_darkelf(level,glevel,25);
  SetProp(P_HANDS, ({" mit "+(gender==MALE?"sein":"ihr")+"en Haenden",
                     level*10+random(20),DT_BLUDGEON}));
  SetProp(P_SIZE, 190+random(20)+level/2);
  SetProp(P_ALIGN, (gender==MALE?-600:-800)+random(4)*200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NO_SCORE, 1);

  if(gender==FEMALE) RemoveId( ({"dunkelelf","elf"}) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:      0.1, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.2, DT_EXPLOSION:   0.2
     , DT_SOUND:     0.0, DT_LIGHT:     0.5, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.2, DT_UNHOLY:   -0.2, DT_MAGIC:      -0.2
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_MNPC_AREA, ({ROOM}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "weg-d5");
  SetProp(P_MNPC_WAIT, ({ 10, 40, 20 }));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " verflucht Dich und geht Lars besuchen.\n");

  AddInfo(DEFAULT_INFO, "beachtet Deine Frage nicht.\n");

  SetProp(P_LOG_INFO, "dhrkion.log");
  AddLibrary( NPC "dhrkion.lib",1);

  AddInfo("zordan", "Ich mag ihn sehr.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER)+" sagt: Danke.\n" }) );

  SetProp(P_SPELLRATE,20+level);

  if(random(10) < 5) AddSpell(4,150,
    Name(WER,1)+" schiesst einen magischen Pfeil auf Dich ab.\n",
    Name(WER,1)+" schiesst einen magischen Pfeil auf @WEN ab.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));

  if(random(10) < 5) AddSpell(1,230,
    Name(WER,1)+" gibt Dir eine harte Kopfnuss.\n",
    Name(WER,1)+" gibt @WEM eine harte Kopfnuss.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  if(random(10) < 5) AddSpell(1,250,
    Name(WER,1)+" schreit Dir sehr laut ins Ohr.\n",
    Name(WER,1)+" schreit @WEN sehr laut an.\n",
     DT_SOUND,([SP_SHOW_DAMAGE:1]));

  SetAttackChats(10,
    ({Name(WER)+" schreit um Hilfe.\n"
     ,Name(WER)+" schaut Dir tief in die Augen.\n"
     ,Name(WER)+" verflucht Dich.\n"
     ,Name(WER)+" sagt: Du wirst dafuer im Gefaengnis landen!\n"
     ,Name(WER)+" versucht zu Lloth zu beten.\n"
     ,Name(WER)+" reibt sich die Haende.\n"
     ,Name(WER)+" versucht Dir das Leben zu entziehen.\n"
     })
  );

  SUID;

  switch(random(4))
  {
    case 0 : CLONEME(WEAPON "dolch"); command("zueck dolch");break;
    case 1 : CLONEME(WEAPON "diamantschwert"); command("zueck schwert"); break;
    case 2 : CLONEME(WEAPON "kurzbogen"); command("zueck bogen"); break;
  }

  if(random(100) < 20) CLONEME(ARMOUR "guertel");
  if(random(100) < 35) CLONEME(ARMOUR "umhang");
  if(random(100) < 15) CLONEME(ARMOUR "stirnreif");

  if(random(100) < 50) CLONEME("/d/unterwelt/ronja/sternenwald/weapon/edorn");

  switch(random(3))
  {
    case 0: CLONEME(ARMOUR "sandalen"); break;
    case 1: CLONEME(ARMOUR "halbstiefel"); break;
    case 2: CLONEME(ARMOUR "stiefel"); break;
  }

  if(gender == FEMALE)
  {

    switch(random(3))
    {
      case 0: CLONEME(ARMOUR "rock"); break;
      case 1: CLONEME(ARMOUR "rock_kurz"); break;
      case 2: CLONEME(ARMOUR "samtkleid"); break;
    }

    if(random(100) < 10) CLONEME(ARMOUR "tunika");
    if(random(100) < 10) CLONEME(ARMOUR "haarfeder");
  }
  else
  {
    CLONEME(ARMOUR "wildlederhose");
    if(random(100) < 60) CLONEME(ARMOUR "tunika");
  }

  command("trage alles");

  callouts = 0;
}

void angriff(object enemy,string str)
{
  if(enemy && present(enemy))
  {
    tell_object(enemy,str);
    Kill(enemy);
  }
}

void shout_to_slave(object liv)
{
  string s,indent;

  if(liv && objectp(liv) && living(liv) && ENV(TO) && present(liv,ENV(TO)))
  {
    s      = "Was lungerst denn Du hier herum? Los los, an die Arbeit.";
    indent = Name(WER,1)+" faucht " + liv->name(WEN,1) + " an: ";
    tell_room(ENV(TO),break_string(s,78,indent,1));
    liv->wandern();
  }
}

void init()
{
  ::init();

  if(TP && DHRKIONMASTER->checkfeind(TP))
  {
    if((random(100) < TP->QueryProp(P_LEVEL)) && !IsEnemy(TP))
    {
      call_out("angriff",0,TP,Name(WER)+" erkennt Dich als Feind und "
                              "greift Dich deshalb an.\n");
    }
  }

  if(TP && TP->id("\ndunkelelf")) AddDefender(TP);

  if(TP && (TP->id("sklave") || TP->id("sklavin")))
  {
    call_out("shout_to_slave",0,TP);
  }
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde von einem Dunkelelfen "
                                       "getoetet ("+lostexp+").\n");
    DHRKIONMASTER->feindtot(player);
  }
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(callouts > 5) return;
  callouts++;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "sagt: "+TPN+" ist sicher kein Dunkelelf.",
        "sagt: "+TPN+" ist sicher kein Dunkelelf.");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "sagt: Lass Deine Wut an einem anderen aus, "+TPN+"!",
        "sagt: Lass Deine Wut an einem anderen aus, "+TPN+"!");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert.",
        "kichert.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Nanana, "+TPN+".",
        "sagt: Nanana, "+TPN+".");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "sagt: Nanana, "+TPN+".",
        "sagt: Nanana, "+TPN+".");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "ist das ziemlich egal.",
        "ist das ziemlich egal.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "schmeichelt sich an Dich ran.",
        "schmeichelt sich an "+TPN+" ran.");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "sagt: Lass Dich damit bloss nicht erwischen, "+TPN+".",
        "sagt: Lass Dich damit bloss nicht erwischen, "+TPN+".");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "sagt: Mir doch schnuppe, "+TPN+".",
        "sagt: Mir doch schnuppe, "+TPN+".");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "sagt: Wein Dich woanders aus, "+TPN+".",
        "sagt: Wein Dich woanders aus, "+TPN+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere)
{
  if (present(ob, ENV(TO)))
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  callouts--;
  if(callouts < 0) callouts = 0;
}

