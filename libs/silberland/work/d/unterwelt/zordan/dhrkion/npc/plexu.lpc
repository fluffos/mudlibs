    "zurueckgebracht. "
    ,
    "sagt: "
  );

  AddInfo( ({"einhorn","einhoerner"}) ,
    "Einhornsteak habe ich noch vorraetig! Wenn Du eines moechtest, dann "
    "bestell Dir doch eines, die sind sehr schmackhaft. "
    ,
    "sagt: "
  );

  AddInfo( ({"wicht","rumpelwicht","braten","spiessbraten",
             "rumpelwichtspiessbraten","rumpelwicht am spiess","spiess"}) ,
    "Rumpelwicht am Spiess ist sehr schmackhaft. Probier doch mal, noch "
    "habe ich einige wenige auf Lager. "
    ,
    "sagt: "
  );

  AddInfo( ({"hilfe"}) ,
    "Ja, ich koennte etwas Hilfe gebrauchen, denn mein Vorrat an "
    "Rumpelwichten ist bald aufgebraucht. Koenntest Du mir ein paar "
    "Rumpelwichte fangen? Ich wuerde mich wirklich freuen, wenn Du mir "
    "Deine Hilfe anbieten wuerdest."
    ,
    "sagt verzweifelt: "
  );

  AddInfo( ({"rune","runen"})    ,"@@info_runen@@" );
  AddInfo( ({"bierkrug","krug"}) ,"@@info_krug@@" );

  AddCmd( ({"probier","probiere"})      , "cmd_probieren");
  AddCmd( ({"hilf","helf","qqhelfe"})   , "cmd_helfen" );
  AddCmd( ({"biet","biete"})            , "cmd_bieten" );

  SetProp(P_SPELLRATE,50);

  AddSpell(1,250,
    BS("Plexu bedient sich bei einem seiner Gerichte und wirft Dir "
