    BS("Plexu bedient sich bei einem seiner Gerichte und wirft @WEM den "
       "Teller an den Kopf."),
     DT_BLUDGEON, "spell_essen"
  );

  SetChats(3,
    ({"Plexu macht ein leckeres Gericht fertig und stellt es auf die Theke.\n"
     ,"Plexu ruehrt in einem Drink herum.\n"
     ,"Plexu fragt Dich: Moechten Sie das Menue sehen?\n"
     ,"Plexu fragt Dich: Was darf ich Ihnen bringen?\n"
     ,"Plexu geht kurz nach hinten und kommt sofort mit etwas in der Hand wieder.\n"
     ,"Plexu macht einen Drink und bringt ihn einem Dunkelelfen an den Tisch.\n"
     ,"Plexu jammert: Mein Rumpelwichtvorrat geht zur Neige!\n"
     ,"Plexu seufzt: Wo bleibt nur meine Rumpelwichtlieferung?\n"
     ,"Plexu stoehnt leise auf: Ohne Rumpelwichte keinen Braten!\n"
     ,"Plexu fragt Dich: Koenntest Du mir nicht ein paar Rumpelwichte bringen?\n"
     })
  );

  SetAttackChats(10,
    ({"Plexu schreit: Dir geb ich nie wieder was zu trinken!\n"
     ,"Plexu lacht ueber Deinen letzten Angriff.\n"
     ,"Plexu bruellt: Das wirst Du mir buessen!\n"
     })
  );

  SUID;
  CLONEME(WEAPON "bierkrug" );
  command("zuecke bierkrug");

  CLONEME(ARMOUR "schuerze" );
  CLONEME(ARMOUR "medaille" );
  command("trage alles");
}

void QuestLog(string s)
{
  write_file("/log/quests/rumpelwichte",dtime(time())+" : "+s+"\n");
}

void QuestPrize(object player, object room, int silent)
{
  int align,result;
  string tpuid;

  if(!player)                                return;
  if(!interactive(player))                   return;
  if(!RWQMASTER->IsQuester(getuuid(player))) return;
  if(!RWQMASTER->TestKnife(getuuid(player))) return;
  if(!RWQMASTER->TestNetz(getuuid(player)))  return;

  tpuid = capitalize(getuid(player));

  if(!silent)
  {
    tell_room(room,BSI("Da bist Du ja wieder "+player->Name()+", ich hatte "
                       "mich ja noch gar nicht bedankt!",
                       "Plexu freut sich: "));
  }

  result = player->GiveQuest(RWQ_NAME);
  RWQMASTER->DeleteQuester(getuuid(player));

  switch(result)
  {
    case  1:
      align = player->QueryProp(P_ALIGN) - 400;
      if(align < -1000) align = -1000;
      player->SetProp(P_ALIGN, align);
      QuestLog(tpuid+" loest die Quest zum ersten Mal." );
      break;

    case -1:
      align = player->QueryProp(P_ALIGN) - 50;
      if(align < -1000) align = -1000;
      player->SetProp(P_ALIGN, align);
      QuestLog(tpuid+" loest die Quest zum wiederholten Mal.");
      break;

    case -2:
      QuestLog(tpuid+" loest die Quest, aber die Quest ist nicht eingetragen.");
      tell_room(room,"Die Quest ist noch nicht eingetragen.\n");
      break;

    case -3:
      QuestLog(tpuid+" loest die Quest, Fehler unbekannter Zugriff.");
      tell_room(room,"Unbefugter Zugriff.\n");
      break;

    case -4:
      QuestLog(tpuid+" loest die Quest, aber die Quest ist nicht aktiv.");
      tell_room(room,"Die Quest ist derzeit deaktiviert.\n");
      break;

     default:
      QuestLog(sprintf("%s loest die Quest, aber unbekannter Fehler %d",tpuid,result));
      tell_room(room,sprintf("Unbekannter Fehler bei der Questvergabe: %d\n",result));
      break;
  }

}

void entferne_rumpelwicht()
{
  object room, *ob;
  int i;
  string s;

  if(!(room=ENV(TO))) return;

  ob = filter_objects(all_inventory(room),"id","\nrumpelwicht");

  i = sizeof(ob);
  if(i == 0) return;


  if(i == 1)
  {
    s = "\nPlexu sagt: Oh! Ein Rumpelwicht, den werde ich mir gleich "
        "fangen!\nGeschickt faengt Plexu den Rumpelwicht ein und bringt "
        "ihn in die Kueche.\n";
  }
  else
  {
    s = "\nPlexu sagt: Oh! Rumpelwichte, die werde ich mir gleich fangen!\n"
        "Geschickt faengt Plexu die Rumpelwichte ein und bringt sie in "
        "die Kueche.\n";
  }

  tell_room(room, s);

  while(i--) ob[i]->remove();

}

void init()
{
  ::init();

  if(TP && TP->id("\nrumpelwicht"))
    call_out("entferne_rumpelwicht",4);

  if(TP                                &&
     interactive(TP)                   &&
     RWQMASTER->IsQuester(getuuid(TP)) &&
     RWQMASTER->TestKnife(getuuid(TP)) &&
     RWQMASTER->TestNetz(getuuid(TP))   )
    call_out("QuestPrize",0,TP,ENV(TO),0);
}

int _query_wimpy()
{
  return 0;
}

void spell_essen(object enemy, int damage, mixed dam_type)
{
  AddHp(30+random(20));
  enemy->Defend(damage, dam_type, ([SP_SHOW_DAMAGE:1,SP_NAME:"teller"]), TO );
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(enemy->QueryProp(P_LEVEL)<10)
  {
    tell_object(enemy,"Plexu lacht ueber Dich und sagt: Komm wieder wenn "
                      "Du groesser geworden bist!\n");
    enemy->StopHuntFor(TO);
    TO->StopHuntFor(enemy);
    return 0;
  }

  DHRKIONMASTER->addfeind(enemy);

  if((QueryProp(P_HP) < 100) &&
     (!spell)                &&
     (random(80) < enemy->QueryProp(P_LEVEL)) )
  {
    tell_room(ENV(TO),BS("Plexu holt unter seiner Theke eine Flasche hervor "
                         "und trinkt schnell davon. Er sieht auf einmal "
                         "frischer und erholter aus." ));
    AddHp(20+random(40));
  }

  return ::Defend(dam, dam_type, spell, enemy);
}

varargs void die(int poisondeath)
{
  object enemy;

  if(enemy=QueryProp(P_KILLER))
    write_file(LOG "spieler.kills",ctime()+": "+CAP(getuid(PL))+" killt Plexu.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "spieler.deads",
      ctime()+": "+CAP(getuid(player))+" wurde von Plexu getoetet ("+lostexp+").\n");
    DHRKIONMASTER->feindtot(player);
  }
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "sagt: Nimm doch einen Drink "+TPN+", dann geht es bestimmt besser!",
        "sagt: Nimm doch einen Drink "+TPN+", dann geht es bestimmt besser!");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "feuert Dir Eine mitten ins Gesicht.",
        "feuert "+TPN+" Eine mitten ins Gesicht.");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TPN+" an.");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "sagt: Hast Du aber ne fiese Charakter, "+TPN+"!",
        "sagt: Hast Du aber ne fiese Charakter, "+TPN+"!");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "sagt: Tststst.",
        "sagt: Tststst.");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "freut sich.",
        "freut sich.");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "schreit: Ich hab genug mit meiner Frau zu tun, "+TPN+"!",
        "schreit: Ich hab genug mit meiner Frau zu tun, "+TPN+"!");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "sagt: Das solltest Du in Dhrkion lieber lassen, "+TPN+"!",
        "sagt: Das solltest Du in Dhrkion lieber lassen, "+TPN+"!");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "schaut Dich einfach nur an.",
        "schaut "+TPN+" einfach nur an.");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich und bietet was zu trinken an.",
        "troestet "+TPN+" und bietet was zu trinken an.");
      break;

  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere)
{
  if(present(ob, ENV(TO)))
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

/*-------------------------------------------------------------------------*/

int cmd_helfen(string str)
{
  object kompass;

  notify_fail("Wem moechtest Du helfen ?\n");

  if(!str || str == "") return 0;
  if(!(str == "plexu" ||
       str == "wirt"     )) return 0;

  if(RWQMASTER->IsQuester(getuuid(TP)))
  {
    tell_object(TP,
      BSI("Hallo, hast du schon ein paar Rumpelwichte gefangen? Mein Vorrat "
          "geht wirklich bald zur Neige!"
          ,"Plexu sagt: "
      )
    );

    return 1;
  }

  tell_object(TP,
    BSI("Du willst mir wirklich helfen? Pass auf: Mein Rumpelwichtvorrat "
        "geht bald zur Neige. Geh in den Sternenwald und fang mir ein "
        "paar lebende Rumpelwichte. Dazu machst Du Dir am besten ein Netz "
        "aus klebrigen Ranken, damit die Rumpelwichte Dir nicht entwischen "
        "koennen. Und ein Schlachtermesser brauche ich auch, meines ist "
        "irgendwie abhanden gekommen. Es muss aber ein Dunkelelfenmesser "
        "sein, denn ich schlachte nur nach der Dunkelelfenzeremonie. "
        "Hier habe ich noch einen Kompass fuer Dich, der Dir den Weg "
        "in der Sternenwald und wieder zurueck zeigen kann.","Plexu sagt: "
    )
  );

  RWQMASTER->StartQuest(getuuid(TP));

  QuestLog(CAP(getuid(TP))+" startet explizit die Quest.");

  kompass=clone_object("/d/unterwelt/ronja/sternenwald/obj/kompass");

  if(ME_TOO_HEAVY==kompass->move(TP,M_GIVE|M_SILENT))
  {
    tell_object(TP,BS("Plexu versucht Dir einen Kompass zu geben, erkennt "
                      "aber, dass Du ihn gar nicht mehr tragen kannst und "
                      "legt ihn auf den Tresen."));
    tell_room(ENV(TO),BS(TPN+" ist in ein intensives Gespraech mit Plexu "
                         "verwickelt."), ({TP}) );
    kompass->move(ENV(TO),M_PUT|M_SILENT|M_NOCHECK);
  }
  else
  {
    tell_object(TP,"Plexu drueckt Dir eine Kugel in die Hand.\n");
    tell_room(ENV(TO),TPN+" hat etwas von Plexu bekommen.\n", ({TP}) );
  }

  return 1;
}

/*------------------------------------------------------------------------*/

int cmd_probieren(string str)
{
  notify_fail("Was moechtest Du probieren?\n");

  if(!str || str == "") return 0;
  if(!(str == "braten"                  ||
       str == "spiessbraten"            ||
       str == "rumpelwichtspiessbraten" ||
       str == "rumpelwicht am spiess"   ||
       str == "rumpelwicht"             ||
       str == "rumpelwichte"            )) return 0;

  tell_object(TP,BSI("Wenn Du einen Rumpelwichtspiessbraten haben moechhtest "
                     "musst Du schon einen bestellen. Umsonst gibts hier "
                     "nichts!","Plexu raunt Dich an: "));

  return 1;
}

int cmd_bieten(string str)
{
  notify_fail("Wem moechtest Du Deine Hilfe anbieten ?\n");

  if(-1 == member(({"plexu hilfe an","plexu hilfe an"}),str))
  {
    return 0;
  }

  return cmd_helfen("plexu");
}

string info_runen(string str)
{
  if(RUNENMASTER->IsRuneHere(getuuid(TP), 7) == 1)
  {
    tell_object(TP,BSI("Hehe, ich habe eine kleine Rune, ja. Aber ich gebe "
                       "sie Dir nicht einfach so. Einer meiner Gaeste hat "
                       "einen Bierkrug gestohlen. Bring mir diesen Bierkrug "
                       "her und Du bekommst dafuer die Rune.",
                       "Plexu fluestert: "));
  }
  else
  {
    tell_object(TP,BSI("Ein paar Dunkelelfen haben von ein paar Runen und "
                       "der Priesterin erzaehlt. Aber leider kann ich Dir "
                       "nicht weiterhelfen.","Plexu sagt: "));
  }

  return "geht wieder seiner Arbeit nach.";
}

string info_krug(string str)
{
  object ob;

  if(RUNENMASTER->IsRuneHere(getuuid(TP), 7) == 1)
  {
    tell_object(TP,BSI("Bring mir den Bierkrug wieder und Du bekommst von "
                       "mir dafuer die Rune. Den Bierkrug hat mir einer "
                       "meiner Gaeste entwendet und sicher mit nach Hause "
                       "genommen.","Plexu fluestert: "));
  }
  else
  {
    tell_object(TP,"Meine Bierkruege sind eindeutig die besten im ganzen "
                   "Silberland.\n");
  }

  return "geht wieder seiner Arbeit nach.";
}

//--------------------------------------------------------------------------
//
// questfunktionen
//
//--------------------------------------------------------------------------

//--------------------------------------------------------------------------
// Runenquest -> 7. Ort wo eine Rune sein kann
//--------------------------------------------------------------------------

void handle_krug(object ob)
{
  switch(RUNENMASTER->GetRune(getuuid(TP), 7))
  {
    case 1:
      tell_object(TP, BSI("Vielen, vielen Dank! Hier hast Du wie "
                          "versprochen die Rune.", "Plexu freut sich: ")+
                      "Plexu gibt Dir eine kleine Rune.\n");
      ob->remove();
      break;

    case -1:
      tell_object(TP, BSI("Danke! Aber ich sehe gerade, dass Du Deine "
                          "Belohnung nicht mehr tragen kannst. Naja, ich "
                          "hab dir ja eine versprochen, also gebe ich "
                          "Dir den Krug wieder zurueck.", "Plexu macht sich "
                          "ueber Dich laecherlich: "));
      ob->move(TP, M_GIVE|M_SILENT|M_NOCHECK);

    default:
      tell_object(TP, BSI("XAha, einer meiner Bierkruege. Danke.",
                          "Plexu sagt: "));
      ob->remove();

      break;
  }
}

void handle_messer(object ob)
{
  if(RWQMASTER->TestKnife(getuuid(TP)))
  {
    tell_object(TP,BSI("Ah ja, ein Drowschlachtmesser. Vielen Dank, jetzt "
                       "habe ich aber wirklich genug davon. Nun "
                       "fehlen nur noch ein paar frische Rumpelwichte. ",
                       "Plexu ist erfreut: "));
  }
  else
  {
    tell_object(TP,BSI("Ah ja, ein Drowschlachtmesser. Vielen Dank. Jetzt "
                       "fehlen nur noch ein paar frische Rumpelwichte. ",
                       "Plexu ist erfreut: "));

    if(!RWQMASTER->IsQuester(getuuid(TP)))
    {
      QuestLog(CAP(getuid(TP))+" startet implizit die Quest.");
    }
  }

  RWQMASTER->AddKnife(getuuid(TP));

  QuestLog(CAP(getuid(TP))+" gibt Plexu das Messer.");

  ob->remove();
}

void handle_net(object ob)
{
  if(!RWQMASTER->TestKnife(getuuid(TP)))
  {
    tell_object(TP,BSI("Ja, und womit soll ich die Rumpelwichte nun "
                       "schlachten. Die Jammern einem ja ein Ohr ab, behalte "
                       "die mal lieber. ",
                       "Plexu sagt unzufrieden: "));
    ob->move(TP, M_GIVE|M_SILENT|M_NOCHECK);
    return;
  }

  if(ob->QueryRW() < 5)
  {
    tell_object(TP,BSI("Das sind ja viel zu wenig Rumpelwichte in dem Netz, "
                       "das lohnt ja gar nicht den Aufwand die zu schlachten "
                       "und den Ofen zum Braten anzuheizen. Bring mit noch ein "
                       "paar mehr.", "Plexu seufzt: "));

    ob->move(TP,M_GIVE|M_SILENT|M_NOCHECK);
    return;
  }

  tell_room(ENV(TO),BSI("Ja! Rumpelwichte! Und wie schoen fett sie sind! Das "
                        "werden ja ganz leckere Braten!","Plexu jubelt: "));

  tell_room(ENV(TO),BS("Plexu nimmt das Netz mit den Rumpelwichten und "
                       "verschwindet in der Kueche."));

  ob->remove();
  RWQMASTER->AddNetz(getuuid(TP));

  QuestLog(CAP(getuid(TP))+" gibt Plexu das Netz.");

  call_out("schlachten",4,TP,TO,ENV(TO),0);
  TO->move("/room/npcasylraum",M_GO|M_SILENT|M_NOCHECK);
}

void give_notify(object ob)
{
  if(ob->id("\n_runenquest_krug"))
  {
    handle_krug(ob);
    return;
  }

  if(ob->id("\n_plexu_bierkrug"))
  {
    tell_object(TP, BSI("Aha, einer meiner Bierkruege. Danke.",
                        "Plexu sagt: "));
    ob->remove();
    return;
  }

  if(ob->id("RWQ_Messer"))
  {
    handle_messer(ob);
    return;
  }

  if(ob->id("RWQ_NETZ"))
  {
    handle_net(ob);
    return;
  }

  tell_room(ENV(TO), BS("Plexu kann mit "+ob->name(WEM)+" nicht anfangen "
                        "und wirft "+ob->QueryPronoun(WEN)+" weg.\n"));

  ob->move(ENV(TO), M_PUT|M_NOCHECK);
}

void schlachten(object player, object wirt, object kneipe, int stufe)
{
  int result,align;

  switch(stufe)
  {
    case 0:
      tell_room(kneipe,BS("Du hoerst wie Plexu in der Kueche das Messer wetzt."));
      break;

    case 1:
      tell_room(kneipe,BS("Die Rumpelwichte jammern noch lauter. Zum Glueck "
                          "kannst Du aber nichts verstehen."));
      break;

    case 2:
      tell_room(kneipe,BS("Die Rumpelwichte schreien laut auf, als Plexu Ihnen "
                          "an die Kehle geht."));
      break;

    case 3:
      tell_room(kneipe,BS("Nach und nach verstummen die Schreie."));
      break;

    case 4:
      tell_room(kneipe,BS("Danach herrscht Stille in der Kueche."));
      break;

    case 5:
      tell_room(kneipe,BS("Die Rumpelwichte schweigen."));
      break;

    default:
      tell_room(kneipe,"Plexu kommt blutverschmiert in die Kneipe.\n");
      tell_room(kneipe,BSI("Jetzt habe ich wieder ausreichend Rumpelwichtbraten.","Plexu grinst: "));

      if(player && interactive(player))
      {
        if(ENV(player) == kneipe)
        {
          QuestPrize(player,kneipe,1);
        }
        else
        {
          tell_room(kneipe,BSI("Ja wo ist denn nun "+player->Name()+" hin?",
                               "Plexu wundert sich: "));
        }
      }
      else
      {
        QuestLog("Quest wurde geloest, aber Spielerobjekt ist ungueltig.");
      }

      wirt->move(kneipe,M_GO|M_SILENT|M_NOCHECK);

      return;
      break;

  }

  stufe++;
  call_out("schlachten",4,player,wirt,kneipe,stufe);
}
