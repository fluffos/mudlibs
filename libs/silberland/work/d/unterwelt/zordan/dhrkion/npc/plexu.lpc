  SetProp(P_MMSGOUT, "verschwindet hinter der Theke");
  SetProp(P_MSGIN, "kommt herein und faengt an die Leute zu bedienen");
  SetProp(P_MSGOUT, "geht#");

  SetProp(P_DIE_MSG, " wird erstmal keinen Umsatz mehr machen.\n");

  AddInfo(DEFAULT_INFO, "fragt: Willst Du das Menue sehen oder was?\n");

  SetProp(P_LOG_INFO, "dhrkion.log");
  AddLibrary( NPC "dhrkion.lib",1);

  AddInfo( ({"zordan"}) ,
    "Einer meiner liebsten Gaeste. Er kommt oft vorbei.","sagt: "
  );

  AddInfo( ({"spinnenragout","ragout"}),
    "Willst Du das wirklich essen?",
    "fragt: "
  );

  AddInfo( ({"zweikampf"}),
    "Naja, ganz fair war ich nicht.",
    "grinst: "
  );

  AddInfo( ({"medaille"}),
    "Die habe ich mal in einem Zweikampf errungen. Das ist aber schon "
    "lange her.",
    "sagt stolz: "
  );

  AddInfo( ({"flasche","flaschen"}),
    "Nimm Deine Haende da weg!",
    "sagt energisch: "
  );

  AddInfo( ({"farben"}),
    "Sind die Farben nicht schoen?",
    "fragt: "
  );

  AddInfo( ({"sorte","sorten"}),
    "Ich habe so viele Sorten. Ich kann sie selber schon nicht mehr "
    "zaehlen.",
    "sagt: "
  );

  AddInfo( ({"regal","regale"}),
    "Was gehen Dich meine Regale an?",
    "fragt: "
  );

  AddInfo( ({"suppe","wuermersuppe"}),
    "Die macht meine Frau. Ich persoenlich finde sie nicht so toll.",
    "sagt: "
  );

  AddInfo( ({"zutritt"}),
    "Der ist Dir strengstens untersagt!",
    "sagt: "
  );

  AddInfo( ({"hinten"}),
    "Nach hinten darf nur ich gehen. Da hast Du keinen Zutritt.",
    "sagt: "
  );

  AddInfo( ({"faehigkeiten","faehigkeit"}),
    "Ich habe mehr Faehigkeiten als Du denkst.",
    "schmunzelt: "
  );

  AddInfo( ({"wirt"}),
    "Ja stimmt, ich bin der Wirt dieser Kneipe.",
    "sagt: "
  );

  AddInfo( ({"frau"}),
    "Die ist in unserer Hoehle und spannt sich aus.",
    "sagt: "
  );

  AddInfo( ({"hoehle"}),
    "Die ist im Suedosten der Stadt.",
    "sagt: "
  );

  AddInfo( ({"menue"}),
    "Tipp einfach so 'menue' ein.",
    "sagt: "
  );

  AddInfo( ({"plexu","name"}),
    "Ich bin Plexu der Wirt. Was darf ich Ihnen bringen?",
    "sagt: "
  );

  AddInfo( ({"kneipe"}),
    "Das ist meine Kneipe. Sie laeuft eigentlich wirklich gut.",
    "sagt: "
  );

  AddInfo( ({"tisch","stuhl"}),
    "Im Moment ist leider alles besetzt. Aber ich kann Dich an der Theke "
    "bedienen.",
    "sagt: "
  );

  AddInfo( ({"theke"}),
    "Mach es Dir gemuetlich und bestell doch was.",
    "sagt: "
  );

  AddInfo( ({"rumpelwicht","rumpelwichte","wicht","wichte"}) ,
    "Die Rumpelwichte wohnen in Erdhoehlen im Sternenwald. Sie sind am "
