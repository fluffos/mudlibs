#include "../def.h"

inherit STDDARKELF;

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Plexu, der Wirt");
  SetProp(P_LONG,
    "Plexu steht hinter seiner Theke und bedient die Dunkelelfen. Er hat "
    "wirklich sehr schoenes, blondes Haar und fuer einen Dunkelelfen "
    "gar nicht mal so rote Augen. Seine Haende sind sehr geschickt in der "
    "Zubereitung von Speisen und Getraenken. Seine Gestalt wirkt nicht "
    "gerade zierlich. Als erfahrener Wirt wird er auch sicher einer "
    "Schlaegerei Einhalt gebieten koennen."
  );

  SetProp(P_NAME, "Plexu");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId( ({"plexu","wirt","NOWIMPY","NOCONTROL"}) );

  set_living_name("plexu");

  create_default_darkelf(21+random(2),20,0);
  SetProp(P_HANDS, ({" mit feuchten Haenden",250,DT_BLUDGEON}));
  SetProp(P_MAX_HP, 600+random(100));
  SetProp(P_SIZE, 200+random(10));
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC,10);

