    ,
    "sagt: "
  );

  AddInfo( ({"wald","sternenwald"}) ,
    "Der Sternenwald befindet sich im Nordwesten von Dhrkion. Dort sind "
    "die Rumpelwichte zu Hause. "
    ,
    "sagt: "
  );

  AddInfo( ({"rumpelwichtvorrat","vorrat"}) ,
