    ,
    "sagt: "
  );

  AddInfo( ({"netz"}) ,
    "Das knuepfe ich mir immer aus Ranken, welche ich im Sternenwald finde."
    ,
    "sagt: "
  );

  AddInfo( ({"ranken"}) ,
    "Die findet man im Unterholz im Sternenwald."
    ,
    "sagt: "
  );

  AddInfo( ({"unterholz"}) ,
    "Ziemlich dicht, das Unterholz im Sternenwald. Aber mit ein bisschen "
