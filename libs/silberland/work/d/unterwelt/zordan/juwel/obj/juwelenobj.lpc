
/*

  Das Questitem fuer die Juwelen-Quest Zordan@SL

*/

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

int kills;
int gotall;
int first;

init() {
  ::init();
  if (MENV && !query_once_interactive(MENV)) call_out("remove",0);
}

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,  0);
  SetProp(P_NAME, "");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "\n_juwelen_quest",
            "/d/unterwelt/zordan/juwel/obj/juwelenobj" }) );

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
  kills=0;
  gotall=0;
  first=0;
}

void AddKill(object pl) {
  if (pl != MENV) {
    call_out("remove",0);
    return;
  }
  kills++;
  if(kills>7 && gotall==0)
  {
    while(remove_call_out("got_all_kills") != -1)
      ;
    if(!first)
    {
      call_out("got_all_kills",4,pl);
      first=1;
    }
  }
}

nosave void got_all_kills(object pl) {
  object ob;
  
  if (gotall!=0) { // wer pfuscht da herum???
    call_out("remove",0);
    return;
  }
  if (pl != MENV) { // kein Env? Wo ist mein Spieler hin? :(
    call_out("remove",0);
    return;
  }
  if(PO != TO) { // jaja...
    call_out("remove",0);
    return;
  }
  if(!interactive(pl)) return; // sollte halt nicht netztot sein :-)
  gotall=1;
  tell_object(pl,BS(
    "Ploetzlich siehst Du ein winziges Funkeln aus Richtung der Leiche."));
  tell_object(pl,BS(
    "Neugierig schaust Du Dir das Funkeln naeher an und erkennst ein "
    "winziges Juwel, das Du sofort an Dich nimmst!"));
  if(ENV(MENV)) tell_room(ENV(MENV),BS(
    CAP_TPN+" bueckt sich nach der Leiche und fischt etwas heraus."),({ pl }) );
  ob=clone_object(OBJ "juwel");
  if (ob) ob->move(TP,M_NOCHECK);
  return;  
}

int QueryKills() {
  return kills;
}

int QueryAll() {
  return gotall;
}
