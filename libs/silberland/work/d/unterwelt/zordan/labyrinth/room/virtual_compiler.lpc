
/*

   Virtual Compiler fuer das Labyrinth Zordan@SL

   return TP->move(ROOM "labyrinth:"+getuid(TP)), M_GO, "nach xxx");

*/

#include "../def.h"

inherit "std/virtual/v_compiler";

#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>

#define P_ROOMS "raum"

create() {
  ::create();
  SetProp(P_COMPILER_PATH, ROOM "" );
  SetProp(P_STD_OBJECT, ROOM "labyrinth" );
  SetProp(P_ROOMS, ({ "labyrinth" }) );
}

string Validate(string file) {
  string filename, wer;
  file=::Validate(file);
  if((sscanf(file, "%s:%s", filename, wer)==2) &&
     (member(QueryProp(P_ROOMS), filename)!=-1)) {
     return file;
  }
  return 0;
}

int CustomizeObject() {
  string filename, raum, wer;
  if(!(filename=::CustomizeObject()) ||
    sscanf(filename, "%s:%s", raum, wer)!=2)
    return 0;
  return 1;
}
