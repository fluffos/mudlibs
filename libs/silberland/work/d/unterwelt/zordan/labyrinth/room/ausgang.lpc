
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int ladeoffen,schluessel;

reset() {
  object ob,*env;
  int i;
  ::reset();
  ladeoffen=0;
  schluessel=1;
  if (ob=present("gnom",ME)) {
    ob->move("/room/void",M_NOCHECK);
    env=all_inventory(ob);
    for( i=0;i<sizeof(env);i++ ) env[i]->remove();
    ob->remove();
  }
  if (ob=present("gnom",ME)) {
    ob->move("/room/void",M_NOCHECK);
    env=all_inventory(ob);
    for( i=0;i<sizeof(env);i++ ) env[i]->remove();
    ob->remove();
  }
}

init() {
  ::init();
  if (interactive(TP)) {
    write_file(LOG "labyrinth.log",
      ctime()+": "+CAP(getuid(PL))+" betritt den Ausgang vom Labyrinth.\n");
    if (find_call_out("gnomkomm") == -1) {
      if (!IS_WIZARD(TP)) {
        call_out("gnomkomm",360+random(60),TP);
      }
    }
  }
}

create() {
  ::create();

  ladeoffen=0;
  schluessel=1;

  SetProp( P_INT_SHORT, "In einer geheimen Kammer" );
  SetProp( P_INT_LONG,
    "Du findest Dich auf einmal in einer kleinen Kammer wieder. Recht kuehl "
    "ist es hier. Eine kleine Liegestelle, ein kleiner Tisch und ein "
    "paar Stuehle sind das einzige was mitten in der Kammer steht. An den "
    "Waenden stehen noch ein paar Regale herum. Verlassen sieht die Kammer "
    "aber wirklich nicht aus. Aengstlich schaust Du Dich um. Es scheint so, als "
    "ob die Eigentuemer jeden Moment kommen koennten." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "decke" }),
    "Die Decke ist aus Fels. An ihr haengt eine kleine Lampe.");

  AddDetail( ({ "lampe" }),
    "Die kleine Lampe erhellt die Kammer ausreichend. Sie schaukelt ein "
    "wenig. An ihrer Unterseite scheint etwas zu kleben.");

  AddDetail( ({ "regale" }),
    "Die Regale sind aus Holz und enthalten nicht viele Sachen. Eines von "
    "ihnen scheint etwas anders zu sein.");

  AddDetail( ({ "regal" }),
    "Das Regal hat als einziges eine kleine Lade.");

  AddDetail( ({ "eigentuemer" }),
    "Die koennten jeden Moment kommen. Es ist sicher besser Du beeilst Dich "
    "ein wenig.");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus nacktem Fels.");

  AddDetail( ({ "fels" }),
    "Ganz normaler, allerdings heller Fels.");

  AddDetail( ({ "moment" }),
    "Lange dauert das sicher nicht mehr!");

  AddDetail( ({ "stuehle" }),
    "Die hoelzernen Stuehle sind fuer Dich viel zu klein. Bis auf einen "
    "werden sie wohl auch benutzt.");

  AddDetail( ({ "stuhl" }),
    "Der Stuhl ist bei genauerer Betrachtung naemlich kaputt.");

  AddDetail( ({ "betrachtung" }),
    "LaSs DaS, SoNsT BaU iCh dOcH IrGendWann MaL sCripTfAllen EiN... "
    "DeIn nAme wUrDe jeDenFaLls GEspEicHeRt.");

  AddDetail( ({ "waende","wand" }),
    "Die Waende sind mit ein paar Teppichen ausgestattet worden. Ein paar "
    "Regale befinden sich daran angelehnt.");

  AddDetail( ({ "teppiche" }),
    "Die Teppiche sind aus normalem Stoff gewoben und verleihen der "
    "Kammer ein wohnliches Aussehen.");

  AddDetail( ({ "teppich" }),
    "Keiner der Teppiche ist besonders schoen.");

  AddDetail( ({ "stoff" }),
    "Er faesst sich ein wenig feucht an. Das ist aber auch alles.");

  AddDetail( ({ "aussehen" }),
    "Ob man sich hier wohl fuehlen koennte? Du zweifelst.");

  AddDetail( ({ "kammer" }),
    QueryProp(P_INT_LONG));

  AddDetail( ({ "liegestelle","stelle" }),
    "Die kleine Liegestelle ist vor nicht allzu langer Zeit benutzt worden. "
    "Sie sieht durch ihr Holz nicht gerade bequem aus.");

  AddDetail( ({ "zeit" }),
    "Du schaetzt das es nur Minuten waren.");

  AddDetail( ({ "holz" }),
    "Ganz normales Holz. Allerdings ist es recht hell gehalten.");

  AddDetail( ({ "tisch" }),
    "Auf dem Tisch steht eine kleine Vase. Er hat nur drei Beine und wirkt "
    "deshalb eigentlich nicht sehr stabil.");

  AddDetail( ({ "vase" }),
    "Ein paar unechte Blumen sind in der rosa Vase recht huebsch plaziert "
    "worden.");

  AddDetail( ({ "sachen" }),
    "Das sind nicht viele Sachen. Da Du aber nicht in den Sachen der "
    "Eigentuemer schnuppern moechtest, laesst Du sie links liegen.");

  AddDetail( ({ "beine","rand" }),
    "Ein Tisch auf drei Beinen steht zwar viel ruhiger auf jedem Boden. "
    "Allerdings ist er nicht sonderlich stabil am Rand.");

  AddDetail( ({ "bein" }),
    "Ich hack Dir gleich ein Bein ab...");

  AddDetail( ({ "blumen","wiesenblumen" }),
    "Das sollen wohl gemischte Wiesenblumen sein. Allerdings sind sie nicht "
    "so gut gelungen.");

  AddDetail( ({ "spucke" }),
    "Iiiihh, ist die Spucke eklig. Du wendest Dich ab.");

  AddSmell( ({ DEFAULT_SMELL }),
    "Leicht suesslicher Geruch wie von einer Pfeife dringt in Deine Nase.");

  AddSmell( ({ "geruch","pfeife" }),
    "Der Geruch nach einer Pfeife liegt in der Luft. Hoechstwahrscheinlich "
    "raucht der Eigentuemer.");

  AddSmell( ({ "blumen" }),
    "Die unechten Blumen riechen nach gar nichts.");

  AddSound( ({ DEFAULT_SOUND }),
    "Die Lampe an der Decke quietscht ein wenig.");

  AddSound( ({ "lampe","quietschen" }),
    "Quiiiiiieeetsch.");

  AddSpecialDetail( ({ "lade" }),       "ladefkt");
  AddSpecialDetail( ({ "unterseite" }), "unterseitefkt");

  AddCmd( "oeffne","oeffnefkt" );

  AddSpecialExit( "norden", "nordenfkt" );
}

int nordenfkt(string str) {
  object ob;
  if (ob=present(SCHLUESSEL,TP)) {
    ob->remove();
    write("Der kleine Schluessel loest sich auf einmal auf.\n");
  }
  return TP->move(ROOM "labyrinth:"+getuid(TP),
         M_GO, "in das Labyrinth nach Norden");
}

string unterseitefkt(string str) {
  object ob;
  if((present(SCHLUESSEL,TP)) || (schluessel==0)) {
    return BS(
      "Ih, da haengt nur Spucke dran. Wie kommt die denn dahin?");
  }
  ob=clone_object( OBJ "schluessel" );
  ob->move(TP,M_NOCHECK);
  schluessel=0;
  return BS(
    "Nanu, ein kleiner Schluessel wurde an der Lampe versteckt. Du nimmst "
    "den kleinen Schluessel an Dich." );
}

string ladefkt(string str) {
  if (ladeoffen==1) return BS(
    "Die Lade ist offen und leer." );
  return BS(
    "Die Lade ist zu und verschlossen." );
}

int oeffnefkt(string str) {
  object ob;
  notify_fail("Was moechtest Du oeffnen?\n");
  if (!str) return 0;
  if (str == "lade") {
    if (ladeoffen==1) {
      write("Die Lade ist doch schon offen.\n");
      return 1;
    } else {
      write("Die Lade ist fest verschlossen.\n");
      return 1;
    }
  }
  if (str != "lade mit schluessel") return 0;
  if (ladeoffen==1) {
    write("Die Lade ist doch schon offen.\n");
    return 1;
  }
  if (ob=present(SCHLUESSEL,TP)) {
    ob->remove();
    if (random(10)) {
      ladeoffen=1;
      write("Du oeffnest die Lade mit dem kleinen Schluessel.\n");
      write("Folgendes war darin, was Du gleich an Dich genommen hast:\n\n");
      if(!present("\n_temperatur_salbe",TP)) {
        ob=clone_object( OBJ "salbe" );
        ob->move(TP,M_NOCHECK);
        write(BS("Eine kleine Tube mit Salbe darin."));
      }
      "/obj/gemmaster"->DistributeGem(3, 6, 1, TP);
      write(BS("Einen grossen Haufen Edelsteine."));
      ob=clone_object( OBJ "fleck" );
      ob->move(TP,M_NOCHECK);
      write("\n");
      write(BS(
        "Ausserdem fuehlst Du Dich so gut, dass Du einer geliebten Person "
        "jetzt einen Knutschfleck verpassen kannst. Syntax: knutschfleck "
        "<person>. Das geht allerdings nur EINMAL!!!" ));
    } else {
      write(BS(
        "Sowas bloedes. Du brichst den Schluessel an der Lade ab und wirst "
        "sie wohl nicht mehr aufbekommen." ));
    }
    write("\n");
    write(BS(
      "Auf einmal kommen zwei Gnome wuetend herein und starren Dich "
      "unglaeubig an. Die beiden Gnome schnappen Dich, nehmen Dir die Karte "
      "weg und bringen Dich aus dem Labyrinth raus." ));
    say(BS(
      "Auf einmal kommen zwei Gnome wuetend herein und starren "+CAP_TPN+
      " unglaeubig an. Die beiden Gnome schnappen sich "+CAP_TPN+"." ));
    if(ob=present(KARTE,TP)) ob->remove();
    TP->move(ROOM "eingang", M_GO,0, 
      "wird von zwei Gnomen weggebracht",
      "wird von zwei Gnomen hereingeworfen");

    return 1;
  }
  write("Du hast keinen passenden Schluessel fuer die Lade.\n");
  return 1;
}

void gnomkomm(object pl) {
  object ob;
  if (!present("gnom")) {
    if (present(pl,ME)) {
      ob=clone_object( NPC "gnom1" );
      ob->move(ME,M_GO);
      ob->Kill(pl);
      ob=clone_object( NPC "gnom2" );
      ob->move(ME,M_GO);
      ob->Kill(pl);
    }
  }
}
