
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Eingang zu einem Labyrinth" );
  SetProp( P_INT_LONG,
    "Du stehst in einer halb zugeschuetteten Hoehle und stoesst Dir fast "
    "den Kopf. Seltsamerweise hat hier jemand eine Fackel an der Wand "
    "angebracht. Eine duenne Staubschicht ist auf dem Boden. In der "
    "Suedwand kannst Du ein kleines Loch sehen, durch das Du leicht gehen "
    "kannst." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }),
    QueryProp(P_INT_LONG));

  AddDetail( ({ "boden" }),
    "Auf dem Boden ist nur eine duenne Staubschicht und ein paar Felsbrocken "
    "zu sehen.");

  AddDetail( ({ "felsbrocken","brocken" }),
    "Die Felsbrocken sind wohl von der Decke heruntergestuerzt.");

  AddDetail( ({ "decke" }),
    "Die Decke haengt erstaunlich niedrig. Ein paar Felsbrocken sind aus "
    "ihr herausgebrochen und auf den Boden gefallen.");

  AddDetail( ({ "loch" }),
    "Durch das Loch kannst Du leicht nach Sueden gehen.");

  AddDetail( ({ "suedwand" }),
    "In der Suedwand ist ein recht grosses Loch.");

  AddDetail( ({ "kopf" }),
    "Die Hoehle ist groessenteils zugefallen. Deshalb ist hier nicht mehr "
    "viel Platz fuer Dich.");

  AddDetail( ({ "platz" }),
    "Es reicht gerade so aus, damit Du Dich hier aufhalten kannst.");

  AddDetail( ({ "fackel" }),
    "Die Fackel haengt in einer kleinen Halterung an der Ostwand und leuchtet "
    "einfach so vor sich hin.");

  AddDetail( ({ "halterung" }),
    "Die Halterung ist wohl schon sehr alt. Sehr stabil sieht sie auch "
    "nicht mehr aus.");

  AddDetail( ({ "ostwand" }),
    "An der Ostwand haengt eine kleine Fackel in einer Halterung.");

  AddDetail( ({ "wand","waende" }),
    "An der Ostwand haengt eine kleine Fackel und in der Suedwand kannst "
    "Du durch ein Loch gehen. Die Waende selber sind aus normalem Stein.");

  AddDetail( ({ "stein" }),
    "Harter Fels koennte man auch sagen. Er ist dunkelschwarz.");

  AddDetail( ({ "fels" }),
    "Wie auch sonst ueberall in der Unterwelt ueblich ist dieser Fels "
    "sehr dunkel.");

  AddDetail( ({ "unterwelt" }),
    "Ja, in der bist Du gerade. Fies und gemein ist sie. Denk immer daran!!!");

  AddDetail( ({ "staubschicht","schicht" }),
    "Die Staubschicht ist nicht sehr hoch. Bis auf Deine Spuren kannst "
    "Du nichts erkennen.");

  AddDetail( ({ "spuren" }),
    "Deine Spuren haben die Groesse Deiner Fuesse. Komisch, oder?");

  AddDetail( ({ "groesse" }),
    "Der Magier hier erspart sich das mal ;))");

  AddDetail( ({ "fuesse" }),
    "Ja, die sind sogar noch da. Eigentlich sollte man sie Dir jetzt "
    "einfach mal abhacken.");

  AddDetail( ({ "staub" }),
    "Der Staub ist ziemlich fein und verteilt sich ueberall in der Hoehle.");

  AddSpecialExit( "nordwestoben", "nordenfkt" );
  AddSpecialExit( "nordwesten", "nordenfkt" );
  AddSpecialExit( "sueden", "suedenfkt" );

  SetProp(P_HIDE_EXITS,({ "nordwesten" }));

}

int suedenfkt(string str) {
  object ob;
  int temp;
  if(!present(KARTE,TP)) {
    temp=4+TP->QueryProp(P_LEVEL)/25;
    ob=clone_object( OBJ "karte" );
    ob->move(TP,M_NOCHECK);
    ob->create3dmaze(temp,temp,temp);
    write(BS(
      "Als Du durch das Loch kletterst faellt Dir eine kleine Karte auf. Du "
      "steckst sie vorsichtshalber ein."));
  }
  return TP->move(ROOM "labyrinth:"+getuid(TP),
         M_GO, "in das Labyrinth nach Sueden");
}

int nordenfkt(string str) {
  object ob;
  if(ob=present(KARTE,TP)) {
    write("Deine Karte bleibt an einem Felsen haengen und zerfaellt zu Staub.\n");
    ob->remove();
  }
  return TP->move( "/d/unterwelt/basics/central/room/00+07+01",
         M_GO, "nach Nordwestoben");
}
