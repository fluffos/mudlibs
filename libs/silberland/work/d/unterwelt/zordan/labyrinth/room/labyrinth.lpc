
/*

   Der virtuelle Raum des Labyrinths Zordan@SL

*/

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

init() {
  object ob,*env;
  int i;
  int dir;
  ::init();
  if (interactive(TP)) {
    env=all_inventory(TO);
    for( i=0;i<sizeof(env);i++ ) {
      if(!living(env[i])) {
        write(BS(
          "In Deinem Augenwinkel kannst Du gerade noch erkennen, wie eine "
          "Gestalt Deine Sachen hinter Dir aufsammelt und wieder "
          "verschwindet." ));
        env[i]->remove();
      }
    }
    RemoveExit("norden");
    RemoveExit("sueden");
    RemoveExit("osten");
    RemoveExit("westen");
    RemoveExit("unten");
    RemoveExit("oben");
    SetProp( P_LIGHT, 1 );
    if (random(100) > 90) SetProp( P_LIGHT, 0 );
    if(ob=present(KARTE,TP)) {
      dir=ob->getexits();
      if (dir == 0) {             // keine Ausgaenge ????
        write(BS(
          "Auf einmal kommt ein kleiner Gnom herein und nimmt Dich an die "
          "Hand und bringt Dich an den Eingang zurueck." ));
        TP->move(ROOM "eingang",
            M_GO, "zum Eingang zurueck");
        return;
      }
      if (dir & M_UNTEN)   AddSpecialExit("unten",  "ausgang");
      if (dir & M_OBEN)    AddSpecialExit("oben",   "ausgang");
      if (dir & M_NORDEN)  AddSpecialExit("norden", "ausgang");
      if (dir & M_SUEDEN)  AddSpecialExit("sueden", "ausgang");
      if (dir & M_WESTEN)  AddSpecialExit("westen", "ausgang");
      if (dir & M_OSTEN)   AddSpecialExit("osten",  "ausgang");
      if (dir & M_EINGANG) AddExit("norden", ROOM "eingang");
      if (dir & M_AUSGANG) AddExit("sueden", ROOM "ausgang");
    } else {                      // keine karte mehr ? raus hier ...
      write(BS(                   
        "Auf einmal kommt ein kleiner Gnom herein und nimmt Dich an die "
        "Hand und bringt Dich an den Eingang zurueck." ));
      TP->move(ROOM "eingang",
          M_GO, "zum Eingang zurueck");
    }
  }
}

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einem Labyrinth" );
  SetProp( P_INT_LONG,
    "Du befindest Dich noch immer in dem Labyrinth. Die Waende sind genauso "
    "wie der Boden und die Decke aus hartem Felsgestein. Die Luft ist hier "
    "sehr stickig. Sonstige Lebewesen kannst Du keine entdecken." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "labyrinth" }),
    "Du bist immer noch mittendrin. Du solltest weiter nach dem Ausgang "
    "suchen.");

  AddDetail( ({ "ausgang" }),
    "Den Ausgang kannst Du so einfach nicht sehen.");

  AddDetail( ({ "waende","wand" }),
    "Die Waende sind aus ganz normalem Felsgestein. Ein paar Kratzer kannst "
    "Du hier und da erkennen.");

  AddDetail( ({ "kratzer" }),
    "Die haben wohl Leute wie Du hier gemacht, nachdem sie wochenlang in "
    "in dem Labyrinth herumgeirrt sind.");

  AddDetail( ({ "leute" }),
    "Davon sind keine mehr zu sehen.");

  AddDetail( ({ "decke" }),
    "Die Decke ist aus ganz normalem Fels. Sie ist leicht hoch genug um "
    "hier leicht zu stehen.");

  AddDetail( ({ "boden" }),
    "Ein wenig Staub liegt auf dem Boden. Ansonsten ist er wie alles hier "
    "aus ganz normalem Fels.");

  AddDetail( ({ "fels" }),
    "Sehr harter Fels. Du wirst ihn nicht zerschlagen koennen.");

  AddDetail( ({ "felsgestein","gestein" }),
    "Ziemlich das Haerteste an Gestein was Du bisher gesehen hast.");

  AddDetail( ({ "staub" }),
    "Du kannst in dem Staub leider keine Hinweise oder Spuren finden.");

  AddDetail( ({ "spuren","hinweise" }),
    "KEINE.");

  AddDetail( ({ "lebewesen","wesen" }),
    "Bis auf Dich ist hier niemand.");

  AddDetail( ({ "luft" }),
    "Die Luft ist sehr stickig. Kein Windhauch wehr hier durch das "
    "Labyrinth.");

  AddSound( DEFAULT_SOUND,
    "Du glaubst ein Kratzen zu hoeren.");

  AddSound( "kratzen",
    "Hm, das scheint aus dem Sueden zu kommen.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft hier riecht ziemlich abgestanden.");

  AddSmell( "luft",
    "Baeh, die muss schon Jahrhunderte hier so stehen.");
}

int ausgang(string str) {
  object ob;
  int dir;
  if(ob=present(KARTE,TP)) {
    switch(str) {
      case "norden" : dir=M_NORDEN;
                      break;
      case "sueden" : dir=M_SUEDEN;
                      break;
      case "osten" :  dir=M_OSTEN;
                      break;
      case "westen" : dir=M_WESTEN;
                      break;
      case "unten" :  dir=M_UNTEN;
                      break;
      case "oben" :   dir=M_OBEN;
                      break;
      default:
                           // was soll das fuer eine richtung sein ???
        write(BS(           
          "Auf einmal kommt ein kleiner Gnom herein und nimmt Dich an die "
          "Hand und bringt Dich an den Eingang zurueck." ));
        TP->move(ROOM "eingang",
           M_GO, "zum Eingang zurueck");
        return 1;
        break;
      }
    ob->moveplayer(dir);
    return TP->move(ROOM "labyrinth:"+getuid(TP),
           M_GO, "in das Labyrinth nach Sueden");
  } else {                  // nanu, wo ist die karte hin ????
    write(BS(                
      "Auf einmal kommt ein kleiner Gnom herein und nimmt Dich an die "
      "Hand und bringt Dich an den Eingang zurueck." ));
    TP->move(ROOM "eingang",
        M_GO, "zum Eingang zurueck");
    return 1;
  }
}
