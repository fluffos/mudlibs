
/*

   Da Anatol ein Header moechte :)

   Das hier ist ein kleener Knutschfleck den man verteilen kann.
   Gemacht hat den der Wurstmagier Zordan@SL . Beschwerden gehen an Lars@SL

   03.12.2005 Woody: little fixes
   26.11.2004 Feyaria: Typofix 
   25.01.2004 Cleme: Typofix 
*/

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

int lastguck = 0;
object clon = 0;
string name;

void init()
{
  ::init();
  if (MENV && !interactive(MENV))
    call_out("remove",0);
  else if (clon == 0)
    clon = TP;
  else if (TP != clon)
    if (find_call_out("undweg") == -1)
      call_out("undweg",1800);
}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  AddId( ({ "knutschfleck","fleck" }) );
  SetProp(P_SHORT, "Ein Knutschfleck");
  SetProp(P_LONG, 
    "Du kannst diesen Knutschfleck jemandem, den Du sehr magst, auf den Hals "
    "druecken. Dazu gibst Du einfach 'knutschfleck <person>' ein." );
  SetProp(P_INFO,
    "Was soll es schon so besonderes an einem Knutschfleck geben?\n");
  SetProp(P_NAME, "Knutschfleck");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, "Den Knutschfleck wuerdest Du niemals hergeben.\n");
  SetProp(P_NEVERDROP, 1);

  AddCmd("knutschfleck","knutschfkt");
}

string extra_look() {
  if ((MENV) && (MENV == clon)) return "";
  return CAP(environment()->QueryPronoun(WER)) +
    " hat einen dicken Knutschfleck von "+name+" am Hals.\n";
}

void undweg()
{
  if (MENV) {
    tell_object(MENV,BS(
      "Der Knutschfleck von "+name+" verblasst und verschwindet." ));
  }
  ME->remove();
}

int knutschfkt(string str)
{
  object ob;
  string *ignore;
  notify_fail( "Wem moechtest Du einen Knutschfleck saugen?\n" );
  if (!str) return 0;
  if (ob=find_player(str)) {
    if (ob->QueryProp(P_INVIS) != 0) return 0;
    notify_fail( "Dir selber kannst Du keinen Knutschfleck saugen!\n" );
    if (TP==ob) return 0;
    notify_fail( CAP(str)+" muss schon hier im Raum sein!\n" );
    if (!present(ob,ENV(MENV))) return 0;
    notify_fail( CAP(str)+" muss ein Spieler sein!\n" );
    if (!interactive(ob)) return 0;
    notify_fail( CAP(str)+" hat schon einen Knutschfleck!\n" );
    if (present("knutschfleck2",ob)) return 0;
    notify_fail( "Du kannst dem eigenen Geschlecht keinen Knutschfleck machen!\n" );
    if (TP->QueryProp(P_GENDER) == ob->QueryProp(P_GENDER)) return 0;
    notify_fail( ob->Name()+" ignoriert Deinen Knutschfleckversuch!\n" );
    if (pointerp(ignore=ob->QueryProp(P_IGNORE))) {
       if (member(ignore,getuid(TP)) >= 0) return 0;
       if (member(ignore,"knutschfleck") >= 0) return 0;
       if (member(ignore,"knutschfleck."+getuid(TP)) >= 0) return 0;
    }
    name=TPN;
    tell_object(TP,BS(
      "Du drueckst Dich zaertlich an " + ob->name(WEN) +
      " und kuesst " + ob->QueryPronoun(WEN) +
      " leidenschaftlich. Dann faengst Du an, " +
      ob->QueryPossPronoun(MALE, WEN) +
      " Hals auszusaugen. Nach ein paar Minuten bist Du zufrieden und "
      "hinterlaesst einen deutlich leuchtenden Knutschfleck."));
    tell_object(TP,"Du grinst " + ob->name(WEN) + " an.\n");
    tell_object(ob,BS(
      TP->Name(WER,1) +
      " drueckt Dich zaertlich an sich und kuesst Dich leidenschaftlich. "
      "Auf einmal faengt "+TP->QueryPronoun(WER)+" aber gemeinerweise an "
      "Deinem Hals auszusaugen. Du moechtest " + TP->QueryPronoun(WEN) +
      " abschuetteln. Doch es ist zu spaet. Es entsteht ein stark "
      "leuchtender Knutschfleck an Deinem Hals."));
    tell_object(ob,CAP(TPN)+" grinst Dich an.\n");
    tell_room(ENV(TP),
      BS( TP->Name() + " drueckt sich zaertlich an " +
      ob->name(WEN) + " und kuesst " + ob->QueryPronoun(WEN) +
      " leidenschaftlich. Doch dann faengt " +
      TP->QueryPronoun(WER) + " an, an dem Hals von " + ob->name(WEM) +
      " zu saugen. Es entsteht ein wunderbar leuchtender Knutschfleck." ),
      ({ TP,ob }) );
    ME->SetProp(P_SHORT, 0);
    ME->SetProp(P_LONG,  0);
    ME->AddId("knutschfleck2");
    ME->RemoveId("knutschfleck");
    ME->RemoveId("fleck");
    ME->RemoveCmd(0);
    ME->move(ob,M_SILENT + M_NOCHECK);
    return 1;
  }
  return 0;
}

mixed QueryProp(string prop)
{
  if ( (prop==P_SHORT) &&       // Property muss stimmen
       environment() &&         // Tragender Spieler muss existieren
       TP &&                    // Anderer Spieler muss existieren...
       (environment() != TP) && // ...und darf nicht gleich Traeger sein
       (environment() != clon) &&       // Darf auch nicht Uebertraeger sein
       ! IS_WIZARD(TP) &&       // Und bei Magiern wird nichts ausgeloest
       (query_once_interactive(TP) || ! TP->QueryProp(P_GHOST)) &&
                                // Spieler oder Nicht-Geist-NPC
       (lastguck != time()))    // Um Scroll zu vermeiden
  {
    lastguck = time();
    tell_object(MENV,
      TP->Name() + " schaut sich Deinen Knutschfleck an und grinst.\n"); 
  }
  return ::QueryProp(prop); 
}
