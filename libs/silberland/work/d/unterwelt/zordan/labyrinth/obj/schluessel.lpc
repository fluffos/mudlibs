
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

init() {
  ::init();
  if (MENV && !interactive(MENV)) call_out("remove_me",0);
}

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Schluessel");
  SetProp(P_LONG,
    "Das ist ein kleiner Schluessel aus Silber. Er ist wirklich nichts "
    "besonderes." );
  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE);
  AddId( ({ "schluessel",SCHLUESSEL }) );

  SetProp(P_MATERIAL, MAT_SILVER );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);
}

remove_me() {
  if (MENV) {
    tell_room(MENV,"Der kleine Schluessel loest sich auf einmal auf.\n");
  }
  ME->remove();
}