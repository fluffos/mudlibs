
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>

void init() {
  ::init();
  if(MENV && !interactive(MENV)) call_out("remove",0);
}

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0); 
  SetProp(P_NAME, 0);
  AddId( ({"\n_temperatur_schutz"}) );
  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0 );
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_INVIS, 1);
}

void anfang(int zeit) {
  if( file_name(PO)[0..38]!="/d/unterwelt/zordan/labyrinth/obj/salbe" ) {
    call_out("remove",0);
    return;
  }
  SetProp(P_TEMPERATURE_PROTECTION, ([ 
    T_COLD_PROT:5+random(5), 
    T_HEAT_PROT:5+random(5) ]) );
  DoWear(1);
  call_out("ende", zeit);
}

void ende() {
  tell_object(MENV, "Die Salbe auf Deiner Haut ist vertrocknet.\n");
  DoUnwear(1);
  call_out("remove",0);
}
