
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

int anzahl;

create() {
  if (!is_clone(TO)) return;
  ::create();

  anzahl=3;

  SetProp(P_SHORT, "Eine Tube mit Salbe");
  SetProp(P_LONG,
    "Die kleine Tube enthaelt eine leicht stinkende Salbe. Die Salbe ist "
    "fast komplett durchsichtig. Du nimmst ein wenig und verteilst es auf "
    "Deiner Hand. Die Stelle juckt zuerst ein wenig, dann fuehlt es sich "
    "aber eigentlich recht gut an." );
  SetProp(P_INFO, 
    "Wenn Du die Salbe auftraegst, koennte Dich das vor ein ein paar "
    "natuerlichen Erscheinungen schuetzen.");
  SetProp(P_NAME, "Tube");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "salbe","tube","\n_temperatur_salbe" }) );

  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 50*anzahl);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);

  AddCmd( "trage" , "tragefkt" );

}

long() {
  return BS(
    "Die kleine Tube enthaelt eine leicht stinkende Salbe. Die Salbe ist "
    "fast komplett durchsichtig. Du nimmst ein wenig und verteilst es auf "
    "Deiner Hand. Die Stelle juckt zuerst ein wenig, dann fuehlt es sich "
    "aber eigentlich recht gut an. Es sind noch "+anzahl+" Anwendungen darin.");
}

int tragefkt(string str) {
  object ob;
  notify_fail("Was willst Du auftragen?\n");
  if (str != "salbe auf") return 0;
  if (present("\n_temperatur_schutz",TP)) {
    write("Derzeit ist schon genug dieser Salbe auf Deiner Haut aufgetragen.\n");
    return 1;
  }
  write(BS(
    "Du nimmst etwas Salbe aus der Tube und verteilst sie ueber Deinen "
    "ganzen Koerper. Erst juckt es wie Hoelle an Deinem ganzen Koerper. Aber "
    "auf einmal hoert es auf und die Auswikrungen Deiner Umwelt scheinen "
    "ein wenig geringer geworden zu sein."));
  say(BS(
    CAP_TPN+" nimmt etwas Salbe aus einer Tube und verteilt sie ueber sich."));
  anzahl--;
  if (anzahl<1) call_out("remove",0);
  ob=clone_object("/d/unterwelt/zordan/labyrinth/obj/tempprot");
  ob->anfang(15*60);
  ob->move(TP,M_NOCHECK);
  return 1;
}
