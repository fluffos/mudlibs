
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein grosser Gnom");
  SetProp(P_LONG,
    "Dieser fiese, grosse Gnom hat nichts anderes im Sinn als Dich zu toeten, "
    "weil Du seine geheime Kammer gefunden hast.");
  SetProp(P_NAME, "Gnom");
  SetProp(P_GENDER, MALE);
  AddId( ({"gnom" }) );

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Gnom");
  SetProp(P_SIZE, 80+random(10));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      -0.5, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.3, DT_TERROR: 0.3,
      DT_HOLY:      -0.5, DT_UNHOLY:    0.0, DT_MAGIC:  -0.9 ]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt wuetend an");
  SetProp(P_MSGOUT, "geht wieder in das Labyrinth");
  SetProp(P_MMSGIN, "geht wieder in das Labyrinth");
  SetProp(P_MMSGOUT, "geht wieder in das Labyrinth");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "will Dich nur toeten.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der grosse Gnom lacht Dich aus.\n" }) );

  SetProp(P_SPELLRATE,50);

  AddSpell(2,200,
    "Der kleine Gnom tritt Dir fies zwischen die Beine.\n",
    "Der kleine Gnom tritt @WEM fies zwischen die Beine.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,300,
    "Der kleine Gnom haut Dir mitten ins Gesicht.\n",
    "Der kleine Gnom haut @WEM mitten ins Gesicht.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,400,
    "Der kleine Gnom bruellt Dir hoellisch laut ins Ohr.\n",
    "Der kleine Gnom bruellt @WEM hoellisch laut ins Ohr.\n",
     DT_SOUND,([SP_SHOW_DAMAGE:1]));

  SUID;

  if(random(50)>35) CLONEME( "/d/unterwelt/basics/central/armour/gnomhelm" );
  if(random(50)>25) CLONEME( "/d/unterwelt/basics/central/armour/gnompanz" );
  if(random(50)>35) CLONEME( "/d/unterwelt/basics/central/armour/gnomarm" );
  if(random(50)>35) CLONEME( "/d/unterwelt/basics/central/armour/gnomhose" );
  if(random(50)>20) CLONEME( "/d/unterwelt/basics/central/armour/gnomstfl" );
  command_me("trage alles");
  if(random(50)>25) {
    CLONEME( "/d/unterwelt/basics/central/obj/gnomhamm" );
    command_me("zuecke hammer");
  } else {
    CLONEME( "/d/unterwelt/basics/central/obj/gnompick" );
    command_me("zuecke pickel");
  }
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  write_file(LOG "gnom.deads",
    ctime()+": Der grosse Gnom hat gerade "+CAP(getuid(PL))+" umgebracht.\n");
}

int _query_wimpy() { return 0; }

