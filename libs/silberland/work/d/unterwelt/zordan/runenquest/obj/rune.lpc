#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

int nummer;
string chr;

void init()
{
  ::init();

  if (MENV && !query_once_interactive(MENV)) call_out("remove",0);
}

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine kleine Rune");
  SetProp(P_LONG,
    "Eigentlich darf das hier nicht stehen -> SOFORT Magier "
    "verstaendigen!!!"
  );

  SetProp(P_INFO, "Diese kleine Rune strahlt eine starke Magie aus.\n");
  SetProp(P_NAME, "Rune");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "rune","\n_quest_rune","NODESTRUCT","NOUNCURSE","QUESTOBJ" }) );

  SetProp(P_MATERIAL,
    ([ MAT_MISC_STONE:60,MAT_MISC_MAGIC:30,MAT_MISC_UNHOLY:10]) );

  SetProp(P_NAME_ADJ, ({"klein"}) );
  AddAdjective( ({"kleinen","kleiner","kleinem","kleines","kleine"}) );

  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_CURSED, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  AddDetail( ({ "magie" }),
    "Diese Rune strahlt eine wirklich sehr starke Magie aus. Fast "
    "knistert es in Deinen Haaren deswegen.");

  chr = "";
}

void SetChar(string s)
{
  chr = s;
}

string QueryChar()
{
  return chr;
}

void setrune(int nr) {
  nummer=nr;
}

int getrune() {
  return nummer;
}
