
/*

    Die Dunkelheit der Dunkelelfen    Zordan@SL

*/


inherit "std/thing";

#include <properties.h>
#include "/gilden/dunkelelfen/dunkelelfen.h"

init() {
  ::init();
  if (MENV && living(MENV)) call_out("undweg",0);
}

reset() {
  ::reset();
  if(!IS_CLONE(TO)) return;
  call_out("undweg",0);
}

create() {
  ::create();
  if(!IS_CLONE(TO)) return;
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0 );
  SetProp(P_NAME, "Dunkelheit");
  SetProp(P_GENDER, FEMALE);
  AddId( D_DUNKEL );
  SetProp(P_WEIGHT, 100000);
  SetProp(P_VALUE, 0);
  SetProp(P_LIGHT, 0);
}

remove_me(int dauer) {
//  call_out("undweg", dauer); wir sparen uns den callout und lassen
//                             die dunkelheit einen reset lang leben :)
}

undweg() {
  if (QueryProp(P_LIGHT) >0) {
    tell_room(MENV,BS("Eine dunkle Wolke schwebt herein und es wird dunkler."));
  } else {
    tell_room(MENV,BS("Eine dunkle Wolke schwebt weg und es wird heller."));
  }
  remove();
}
