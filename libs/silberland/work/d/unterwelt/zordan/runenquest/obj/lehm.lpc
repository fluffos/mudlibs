
/*

   Ein kleiner Lehmhaufen . In ihm ist eine kleiner Edelstein Zordan@SL

*/

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

/*
init() {
  ::init();
  if (MENV && !query_once_interactive(MENV)) call_out("remove",0);
}
*/

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Lehmklumpen");
  SetProp(P_LONG,
    "Ein kleiner dreckiger Lehmklumpen aus Dhrkion. Eigentlich ziemlich "
    "wertlos und zu nichts zu gebrauchen." );
  SetProp(P_INFO, "In seinem Innneren scheint etwas zu sein.\n");
  SetProp(P_NAME, "Lehmklumpen");
  SetProp(P_GENDER, MALE);
  AddId( ({ "lehmklumpen","klumpen","\n_runenquest_lehm" }) );

  SetProp(P_MATERIAL, MAT_EARTH );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);

  AddCmd( ({ "brich","brech","breche","oeffne","zerbrich","zerlege",
             "zerbrech","zerbreche" }) , "brechfkt" );
}

int brechfkt(string str) {
  object ob;
  if(!(ob=present(QUESTRUNE,TP))) return 0;
  if(!(ob->runehier(8))) return 0;
  if(present("\n_runenquest_edelstein",TP)) return 0;
  notify_fail("Was willst Du aufbrechen?\n");
  if(str != "lehm auf" && str != "lehm auseinander" &&
     str != "lehmklumpen auf" && str != "lehmklumpen auseinander" &&
     str != "lehmklumpen" && str != "klumpen")
    return 0;
  write(BS(
    "Du nimmst den Lehmklumpen in beide Haende und mit einem kraeftigen "
    "Ruck brichst Du den Lehmklumpen auseinander. Ein kleiner Edelstein "
    "war darin, den Du gleich einsteckst." ));
  ob=clone_object("/d/unterwelt/zordan/runenquest/obj/edelstein");
  ob->move(TP,M_NOCHECK);
  ME->remove();
  return 1;
}
