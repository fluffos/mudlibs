string translate(string str) {
  string ret1,ret2,ret3,ret4,ret5,ret6,ret7,f,n,f1,f2;
  int i;
  if (!str) return "";
  if (!stringp(str)) return "";
  ret1=ret2=ret3=ret4=ret5=ret6=ret7="";
  f=VT_GREEN;
  n=VT_NORMAL;
  f2=VT_BLUE;
  f1=VT_CYAN;
  for (i=0;i<strlen(str);i++) {
    ret1 = ret1+f2+" "+"_______"[0..strlen(runenstr[str[i..i],0])+1]+"  ";
    ret2 = ret2+f2+"/"+"       "[0..strlen(runenstr[str[i..i],0])+1]+f1+"\\ ";
    ret3 = ret3+f2+"\\ "+n+f+runenstr[str[i..i],0]+f1+" / ";
    ret4 = ret4+f2+"| "+n+f+runenstr[str[i..i],1]+f1+" | ";
    ret5 = ret5+f2+"| "+n+f+runenstr[str[i..i],2]+f1+" | ";
    ret6 = ret6+f2+"/ "+n+f+runenstr[str[i..i],3]+f1+" \\ ";
    ret7 = ret7+f2+"\\"+f1+"_______"[0..strlen(runenstr[str[i..i],0])+1]+"/ "+n;
  }
  return ret1+"\n"+ret2+"\n"+ret3+"\n"+ret4+"\n"+ret5+"\n"+ret6+"\n"+ret7+"\n";
}

string erklaere1(string str) {
  return runenstr[str[0..0],4];
}

string erklaere2(string str) {
  return runenstr[str[0..0],5];
}

string erklaere3(string str) {
  return runenstr[str[0..0],6];
}

