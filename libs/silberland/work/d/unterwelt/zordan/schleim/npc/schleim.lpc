
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

// habs mal auf 5 stufen begrenzt, aber 7 sind geproggt

#define groesse ({ "mikroskopisch kleiner","winziger","kleiner", \
                   "mittelgrosser","grosser","sehr grosser", \
                   "riesiger","gigantischer" })

#define farbe ({ "gruen","rot","blau","grau","schwarz","weiss","gelb", \
                 "violett","tuerkis","braun" })

int mysize,mycolor;

init() {
  ::init();
  if (TP && TP->id("\n_schleimball")) AddDefender(TP);
}

void InformDefend(object enemy) {
  Kill(enemy);
}

void setvars(int size) {
  int f;
  f=random(10);
  mysize=size;
  mycolor=f;
  SetProp(P_SHORT, "Ein "+farbe[f]+"er, "+groesse[size]+" Schleimball");
  SetProp(P_LONG,
    "Vor Dir wabert ein "+groesse[size]+" Schleimball auf dem Boden entlang. "
    "Er hat keine Haut im herkoemmlichen Sinne, sondern seine Oberflaeche "
    "vibriert in einem sattem "+CAP(farbe[f])+". Auf dem Boden "
    "hinterlaesst er eine eklige, "+farbe[f]+"e Schleimspur, auf der man "
    "vielleicht sogar ausrutschen kann. Extremente kannst Du an dem "
    "Schleimball keine erkennen. Durch seine Gestalt ist er mit normalen "
    "Waffen wohl kaum zu schlagen!");
  SetProp(P_NAME, "Schleimball");
  SetProp(P_NAME_ADJ, farbe[f] );
  AddAdjective( ({ farbe[f]+"er, "+groesse[size],
                   farbe[f]+"er, "+groesse[size] }) );
  SetProp(P_GENDER, MALE);
  AddId( ({"schleimball", "ball", "\n_schleimball"}) );
  create_default_npc(5+size*2+f/2);
  SetProp(P_HANDS, ({" mit einer "+farbe[f]+"en Schleimkugel",
                   QueryProp(P_HANDS)[1]+20*size+10*f,
                   ({ DT_MAGIC, DT_ACID }) }));
  SetProp(P_RACE, "Schleimball");
  SetProp(P_SIZE, 10+size*30+f*2);
  SetProp(P_ALIGN, -(size*50+f*10));
  SetProp(P_MAX_HANDS, 0);

  SetProp(P_MNPC_AREA, (ROOM "schleim-") );
  SetProp(P_MNPC_WAIT, ({ size*2+1, size*3+1, size*3+1 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "schleim-b22");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_MAYLOAD +
                        MOV_SPECIAL + MOV_INFIGHT );

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([
      DT_SLASH:     -0.8,
      DT_BLUDGEON:  -0.8,
      DT_PIERCE:    -0.8,
      DT_SQUEEZE:   -0.8,
      DT_WHIP:      -0.8,
      DT_RIP:       -0.8,
      DT_FIRE:      -(0.01+0.01*(float)size+0.01*(float)f),
      DT_COLD:      -(0.01+0.01*(float)size+0.01*(float)f),
      DT_WATER:     -(0.1+0.1*(float)size+0.005*(float)f),
      DT_AIR:       -(0.2+0.1*(float)size+0.005*(float)f),
      DT_LIGHTNING: -(0.3+0.1*(float)size),
      DT_EXPLOSION: -(0.01+0.01*(float)size+0.01*(float)f),
      DT_SOUND:     -0.9,
      DT_LIGHT:     -0.9,
      DT_ELECTRIC:  -(0.01+0.01*(float)size+0.01*(float)f),
      DT_ACID:      -(0.01+0.01*(float)size+0.01*(float)f),
      DT_POISON:    -0.9,
      DT_TERROR:    -0.9,
      DT_HOLY:      -(0.01+0.01*(float)size+0.01*(float)f),
      DT_UNHOLY:    -0.9,
      DT_MAGIC:     -(0.1+0.05*(float)size+0.02*(float)f)
    ]) );

  if (size <= 2) {
    SetProp(P_DIE_MSG, " zerplatzt und schleimt alles voll.\n");
    SetProp(P_NOCORPSE, 0);
  } else {
    SetProp(P_DIE_MSG, " zerplatzt in zwei kleinere Schleimbaelle.\n");
    SetProp(P_NOCORPSE, 1);
  }

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Der Schleimball verschlingt @WEN sofort.\n" }) );

/*
  SetProp(P_SPELLRATE,0);
  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAGE:1]));
*/

  SetChats(1, ({
    "Der "+farbe[f]+"e Schleimball schleimt Dir die Fuesse voll.\n",
    "Der "+farbe[f]+"e Schleimball blubbert.\n",
    "Der "+farbe[f]+"e Schleimball schleimt den Boden voll.\n",
    "Der "+farbe[f]+"e Schleimball vibriert.\n",
    "Der "+farbe[f]+"e Schleimball dreht sich im Kreis.\n",
    "Der "+farbe[f]+"e Schleimball wird flach wie eine Flunder.\n",
    "Der "+farbe[f]+"e Schleimball verliert ein wenig Schleim.\n",
    "Der "+farbe[f]+"e Schleimball aendert seine Form laufend.\n",
    "Der "+farbe[f]+"e Schleimball zuckt kurz in sich zusammen.\n"}) );

  return;
}

void create() {
  if (!is_clone(TO)) return;
  ::create();
  setvars(7);
  SetProp(P_MSGIN, "wabert herein");
  SetProp(P_MSGOUT, "wabert");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SUID;
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "spieler.deads",
      ctime()+": Schleimball ("+mysize+"/"+mycolor+") hat gerade "
             +CAP(getuid(player))+" umgebracht ("+lostexp+").\n");
}

void die(int poisondeath) {
  object ob;
  int i;
  if (mysize > 2) {
    if (MENV) {
      ob=clone_object("/d/unterwelt/zordan/schleim/npc/schleim");
      ob->setvars(mysize-1);
      ob->move(MENV,M_NOCHECK + M_SILENT);
      if (TP) ob->Kill(TP);
      ob=clone_object("/d/unterwelt/zordan/schleim/npc/schleim");
      ob->setvars(mysize-1);
      ob->move(MENV,M_NOCHECK + M_SILENT);
      if (TP) ob->Kill(TP);
    }
  }
  if (TP && interactive(TP)) call_other(SCHLEIMMASTER,"addkill",TP);
  ::die(poisondeath);
}

// Reactions

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "intim":
    case "nett":
    case "froh":
    case "albern":
      call_out("reaction", 0, TP,
        "schleimt Dich voll.",
        "schleimt "+CAP_TPN+" voll.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

reset() {
  ::reset();
  if (mysize != 7) {
    if (MENV) {
      tell_room(MENV,BS(
        "Der "+farbe[mycolor]+"e Schleimball faengt auf einmal ganz heftig "
        "an zu pulsieren. Mit einem lauten Knall zerplatzt er und es fliegen "
        "viele kleine Schleimklumpen durch den Raum."));
    }
    call_out("remove",0);
  }
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy) {
  object ob;
  string str;
  
  if(spell && mappingp(spell)) {
    str=spell[SP_NAME];
    if (stringp(str) && str != 0 && str != "" && LOWER(str) == "spalten") {
      if (mysize > 2) {
        if (MENV) {
          SetProp(P_DIE_MSG, " zerplatzt durch das Spalten in zwei "
                             "kleinere Schleimbaelle.\n");
          dam=0;
          ME->die();
        }
      }
    }
  }
  if (dam!=0) 
    ::Defend(dam, dam_type, spell, enemy);
}
