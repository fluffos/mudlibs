      ctime()+": "+CAP(getuid(PL))+" hat "+(pl->QueryProp(P_LEVEL)/10+1)+
      "Schleimbaelle bekommen.\n");
  }
*/
}

mapping getkills() {
  return kills;
}


int check(object u) {
  if (ENV(u) && strstr(file_name(ENV(u)),"/unterwelt/zordan/schleim/") != -1) {
    if (IS_LEARNER(u)) return 0;
    if (getuid(u)==ROOTID) return 0;
    if (u->QueryProp(P_NPC)) return 0;
    return 1;
  }
  return 0;
}

void rotate(int dir) {
  int i;
  object raum;
  for (i=0;i<sizeof(rooms);i++) {
    if (!raum=find_object(ROOM + rooms[i])) {
      call_other(ROOM + rooms[i],"???");  // bei Bedarf Raeume laden
      raum=find_object(ROOM + rooms[i]);
      if (!raum) { 
        write_log("error.log",
          sprintf("Raum %O konnte nicht geladen werden!!!\n",
          raum));
        return;
      }              // uiuiui, hier stimmt was nicht :(
    }
    call_other(raum,"dorotate",dir);
  }
  i=sizeof(filter_array(users(),"check"));
  if (i>0)
    if (find_call_out("rotate") == -1)
      call_out("rotate",60+random(60),random(6)+1);
}

void enter(object pl) {
  if (find_call_out("rotate") != -1) return;
  call_out("rotate",60+random(60),random(6)+1);
}
