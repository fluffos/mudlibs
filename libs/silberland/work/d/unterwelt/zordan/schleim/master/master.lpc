
/*
   Der Master fuer die Schleimhoehle
*/

#include "../def.h"
#include <wizlevels.h>
#include <moving.h>

#define rooms  ({ "schleim-a11", "schleim-a12", "schleim-a21", \
                  "schleim-a22", "schleim-b11", "schleim-b12", \
                  "schleim-b21", "schleim-b22" })

query_prevent_shadow() { return 1; }

nosave mapping kills;

create() {
  if (is_clone(TO)) { 
    destruct(TO); return 1;
  }
  kills=([ ]);
}

reset() {
}

int addkill(object pl) {
  object ob;
  kills[getuid(pl),0]++;
/*
  if (kills[getuid(pl),0] > 50) {
    kills[getuid(pl),0]=0;
    ob=clone_object( OBJ "schleimball" );
    ob->SetProp(P_AMOUNT,pl->QueryProp(P_LEVEL)/10+1);
    ob->move(pl,M_NOCHECK + M_SILENT);
