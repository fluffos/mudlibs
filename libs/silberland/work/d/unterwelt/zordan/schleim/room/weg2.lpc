
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


int offen,zbank;

reset() {
  ::reset();
  offen=0;
  if (zbank>0) {
    "/p/daemon/zentralbank"->PayIn(zbank, 100);
    zbank=0;
  }
}

create() {
  ::create();

  offen=0;
  zbank=0;

  SetProp( P_INT_SHORT, "Eine schleimige Hoehle" );
  SetProp( P_INT_LONG,
    "Der Schleim nimmt hier immer mehr zu. Fast alles ist inzwischen damit "
    "bedeckt. Der Geruch ist kaum noch auszuhalten und Du hast schon "
    "Schwierigkeiten, Dich fortzubewegen. Deine Fuesse stehen in diesem "
    "Gang schon mehr im Schleim als auf festem Felsen." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
    "Dieser Gang ist schon fast komplett zugeschleimt.");

  AddDetail( ({ "schleim" }),
    "Der Schleim kommt hier in allen moeglichen Farben vor. Er hat sich "
    "schon sehr stark ausgebreitet. Doch was war das? Hat sich der Schleim "
    "nicht gerade bewegt???");

  AddDetail( ({ "farbe","farben" }),
    "So ziemlich alle Farben die Du kennst kommen vor. Manche leuchten, "
    "andere sind aber auch matt.");

  AddDetail( ({ "schwierigkeiten","schwierigkeit","schritt" }),
    "Mit jedem Schritt wird das Bewegen immer schwerer. Du ueberlegst Dir, "
    "nicht vielleicht doch besser umzudrehen.");

  AddDetail( ({ "bewegen" }),
    "Egal was Du machst, immer wieder bleibst Du irgendwo am Schleim kleben.");

  AddDetail( ({ "fuesse","fuss" }),
    "Deine Fuesse stehen im Schleim und Du kannst sie nur noch schwer "
    "bewegen.");

  AddDetail( ({ "decke" }),
    "Die Decke ist komplett vollgeschleimt.");

  AddDetail( ({ "boden" }),
    "Auf dem Boden gibt es noch ein paar wenige Stellen, die nicht "
    "zugeschleimt sind. Diese Stellen versuchst Du auch zu nutzen.");

  AddDetail( ({ "stellen","stelle" }),
    "An diesen Stellen ist der nackte Fels zu erkennen.");

  AddDetail( ({ "fels","felsen" }),
    "Harter Fels, wie ueberall in der Unterwelt.");

  AddDetail( ({ "unterwelt" }),
    "Wo bist Du hier nur gelandet?");

  AddDetail( ({ "wand","waende" }),
    "Die Waende sind fast komplett zugeschleimt. Es sind nur noch sehr "
    "wenige Aussparungen zu erkennen.");

  AddDetail( ({ "aussparungen" }),
    "Viele Aussparungen sind das nicht mehr. Eine faellt Dir ins Auge.");

  AddDetail( ({ "auge" }),
    "*plitsch* Etwas Schleim ist Dir in Auge getropft. IIiiihhhh.");

  AddDetail( ({ "untersuchen" }),
    "Vielleicht sollte man irgendwie den Schleim um die Aussparung "
    "wegbekommen?");

  AddDetail( ({ "geruch" }),
    "Waeh!");

  AddSound( ({ DEFAULT_SOUND,"wind" }) ,
    "Ein unheimlicher Wind pfeift hier.");
    
  AddSmell( DEFAULT_SMELL,
    "Es stinkt bestialisch. Du bekommst kaum noch Luft.");

  AddSmell( ({ "luft","gestank","geruch" }),
    "Die Luft ist mit einem ekligen Gestank erfuellt. Dir wird schlecht.");

  AddSpecialDetail( ({ "aussparung" }), "ausfkt" );
  AddSpecialDetail( ({ "schlitz" }),    "schlitzfkt" );

  AddExit( "westen", "./weg1" );
  AddExit( "nordosten",  "./weg3" );

  AddCmd( ({ "wirf", "werfe", "werf" }), "wirffkt" );
  AddCmd( ({ "entfern", "entferne", "beseitige" }), "wegfkt" );

}

string ausfkt() {
  if (!offen) return BS(
    "Diese Aussparung sieht aber seltsam aus. Ein wenig Schleim haengt "
    "nach darum und macht ein weiteres Untersuchen schwierig.");
  return BS(
    "Diese Aussparung sieht aber seltsam aus. Nachdem der Schleim entfernt "
    "wurde, kannst Du einen kleinen Schlitz erkennen.");
}

string schlitzfkt() {
  if (!offen) return 0;
  return BS(
    "Hm, der Schlitz ist genau senkrecht von oben nach unten und gar nicht "
    "so gross. Was man da wohl einwerfen koennte?");
}

int wirffkt(string str) {
  object ob;
  int wieviel, anzahl, ob_ist;
  string wo, was;

  if(!offen) return 0;
  if(!str) return 0;
  if(sscanf(str, "%d %s in %s", wieviel, was, wo)!=3) return 0;
  if(was != "muenzen" && wo != "schlitz") {
    write(BS("Was willst Du wohin werfen?"));
    return 1;
  }
  if(was != "muenzen" && wo == "schlitz") {
    write(BS("Das kannst Du nicht in den Schlitz werfen!"));
    return 1;
  }
  
  if(was == "muenzen" && wo != "schlitz") {
    write(BS("Wo willst Du Deine Muenzen hineinwerfen?"));
    return 1;
  }
  if(!(ob=present(was, TP))) {
    write(BS("Du hast ja ueberhaupt gar keine Muenzen dabei!"));
    return 1;
  }
  anzahl=TP->QueryMoney();
  if(anzahl<wieviel) {
    write(BS("Soviele Muenzen hast Du ja gar nicht dabei!"));
    return 1;
  }
  write(BS(
    "Du nimmst die "+wieviel+" Muenzen und wirfst sie in den Schlitz hinein. "
    "Bei jeder einzelnen Muenze durchfaehrt Dich ein winziger Schauer und "
    "Du fuehlst Dich dabei immer wieder ein wenig besser."));
  say(BS(CAP_TPN+" wirft etwas in einen Schlitz hinein."));

  ob_ist = ob->QueryProp(P_AMOUNT);     // fuer Bug-Ausnutz-Strafe...
  // ob->AddAmount(-wieviel);   // BUG (Woody) !!! "ob" kann (wg. Boerse)
                                // auch ein Geldobjekt <wieviel sein!
  TP->AddMoney(-wieviel);       // viiiiiiiiiiiel sicherer so

  if ((ob_ist<wieviel) && (ob_ist==1))  // wer geschummelt hat...
  {
    SetProp(P_KILL_NAME, "Ein nicht gemeldeter Bug");   // (woody)
    TP->do_damage(50+random(51));                       // kriegt Haue :)
  }
  else
    TP->heal_self(wieviel/(9+random(2)));       // sonst alles OK

  SetProp(P_KILL_NAME, 0);      // (woody)
  zbank+=wieviel;
  return 1;
}

int wegfkt(string str) {
  if (offen) return 0;
  notify_fail("Was willst Du beseitigen?\n");
  if ( str != "schleim") return 0;
  offen=1;
  write(BS(
    "Vorsichtig entfernst Du den Schleim von der Aussparung. Der Schleim "
    "bleibt aber an Dir kleben und frisst sich leicht in Deine Haut!"));
  say(BS(
    CAP_TPN+" entfernt ein wenig Schleim und schreit laut auf."));
  SetProp(P_KILL_NAME, "Aetzender Schleim");    // (woody)
  TP->do_damage(20+random(20));
  return 1;
}
