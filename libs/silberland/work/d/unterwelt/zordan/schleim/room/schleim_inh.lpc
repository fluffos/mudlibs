
/*
  Inherit fuer die Schleimhoehle
*/

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <wizlevels.h>

mapping ausgaenge;

// muss leider sein, sonst kommen die raeume durcheinander
query_prevent_shadow() {
  return 1;
}

init() {
  ::init();
  if (interactive(TP))
    call_other(SCHLEIMMASTER,"enter",TP);
}

create() {
  int i;
  ::create();
  SetProp( P_INT_SHORT, "In einer schleimigen Hoehle" );
  SetProp( P_LIGHT,   0 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_NOQUIT,  1 ); // tja ...
  SetProp( P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 20+random(5), ENV_TERRAIN: TT_CAVE]) );

  SetProp(P_INT_LONG,
    "Du findest Dich in einer riesigen Kugel aus purem Schleim wieder. Sie "
    "scheint keine Waende zu haben, denn der Schleim um Dich herum pulsiert "
    "und bewegt sich in alle moeglichen Richtungen. Nicht zuletzt diese "
    "Tatsache laesst den Gedanken in Dir aufkommen, dass die ganze Kugel "
    "eine Art Lebewesen ist." );

  AddDetail( ({ "kugel" }),
    "Du bist tatsaechlich im Inneren einer riesigen Kugel aus Schleim. "
    "Die Kugel selber scheint nicht wirklich leblos zu sein.");

  AddDetail( ({ "schleim" }),
    "Der Schleim erstreckt sich von ueberall in allen Farben in alle "
    "Richtungen. Richtig eklig ist Dir zumute.");

  AddDetail( ({ "farbe","farben" }),
    "Alle Farben des Regenbogens sind vorhanden. Von Tiefschwarz bis Weiss.");

  AddDetail( ({ "regenbogen","bogen" }),
    "Hier ist kein Regenbogen. Nur die Farben eines Regenbogens.");

  AddDetail( ({ "wand","waende" }),
    "Diese Kugel aus Schleim hat keine richtigen Waende.");

  AddDetail( ({ "richtungen","richtung" }),
    "Einfach alle Richtungen. So schwer zu verstehen?");

  AddDetail( ({ "tatsache","tatsachen" }),
    "Mehrere Tatsachen stossen Dich darauf. Denn auch der Boden vibriert "
    "unter Dir.");

  AddDetail( ({ "gedanke","gedanken" }),
    "Die ganze Kugel scheint wirklich eine Art Lebewesen zu sein. Aber "
    "viel erkennen kann man eigentlich nicht. Eigentlich willst Du das "
    "auch gar nicht so genau wissen, sondern lieber wieder gehen.");

  AddDetail( ({ "art","lebewesen" }),
    "Welche Art Lebewesen das ist, kannst Du nicht erkennen. Es besteht "
    "jedenfalls aus viel Schleim, soviel steht fest.");

  AddDetail( ({ "boden" }),
    "Unter Deinen Fuessen vibriert der Boden. Du stehst auf einem Haufen "
    "Schleim und es platscht bei jedem Schritt.");

  AddDetail( ({ "schritt" }),
    "Natuerlich nur dann, wenn Du Dich bewegst.");

  AddDetail( ({ "haufen" }),
    "Haufen ist vielleicht so nicht richtig. Der Schleim ist halt einfach "
    "ueberall. Grauslich.");

  AddDetail( ({ "fuss","fuesse" }),
    "Du stehst mitten im Schleim.");

  AddDetail( ({ "decke" }),
    "Wie es keine Waende gibt, so gibt es auch keine Decke. Schleim "
    "ueberall!");

  AddDetail( ({ "inneren" }),
    "Du bist mittendrin und weisst gar nicht mehr so genau, wo Du eigentlich "
    "bist. Oder geschweige denn, wie man hier bloss wieder rauskommen soll.");

  AddDetail( ({ "nase" }),
    "Du atmest schon lange nicht mehr durch die Nase. Es stinkt einfach "
    "viel zu sehr.");

  AddDetail( ({ "hoehlen" }),
    "Die liegen wohl noch sehr viel weiter unten.");

  AddDetail( ({ "finsternis" }),
    "Hier ist es recht dunkel. Aber weiter unten in den Hoehlen ist es "
    "sicher noch dunkler.");

  AddSound( DEFAULT_SOUND,
    "Es blubbert aus allen Richtungen vor sich hin.");

  AddSmell( DEFAULT_SMELL,
    "Ein wirklich grausamer Gestank dringt in Deine Nase.");

  AddSmell( "gestank",
    "Dieser Schleim riecht wirklich furchtbar. Du drohst fast zu ersticken!");

  AddSmell( "schleim",
    "Der Schleim muss aus den tiefsten Hoehlen der Finsternis stammen. Er "
    "stinkt bestialisch.");

  for (i=0;i<sizeof(ausgaenge);i++) {
    AddSpecialExit(m_indices(ausgaenge)[i],"schleimweg");
  }

  AddCmd( ({ "schlaf","schlafe" }), "schlaffkt");
}

mixed schleimweg(string richt) {
  if (!interactive(TP))
    return ROOM + ausgaenge[richt];
  if (random(100) < 30) {
    notify_fail(BS(
      "Du bleibst leider an etwas Schleim kleben und kommst nicht nach "
      +CAP(richt)+" weiter."));
    return 0;
  } else if (TP->InFight() && random(100) < 60) {
    notify_fail(BS(
      "Der Schleimball schleimt sich an Dir fest und Du kommst "
      "deshalb nicht so schnell nach "+CAP(richt)+" weiter."));
    return 0;
  }
  return ROOM + ausgaenge[richt];
}

int schlaffkt(string str) {
  if (str != "wirklich ein") {
    write(BS(
      "!!! ACHTUNG !!! Das Einschlafen in diesen Raeumen ist HOECHST "
      "gefaehrlich. DU uebernimmst die VOLLE Verantwortung, wenn Du mit "
      "dem Kommando 'schlafe wirklich ein' hier jetzt einschlaefst !!!"));
    return 1;
  }
  write(BS(
    "Ok, es DEINE Entscheidung gewesen... einen schoenen Schlaf..."));
  write_log("schlafe.log",
    sprintf("%s von %s ist in den Raeumen selber eingeschlafen.\n",
    getuid(TP),TP->QueryProp(P_CALLED_FROM_IP)));
  TP->disconnect("ein");
  return 1;
}

BecomesNetDead(object pl) {
  write_log("schlafe.log",
    sprintf("%s von %s ist in den Raeumen disconnected!!!\n",
    getuid(pl),pl->QueryProp(P_CALLED_FROM_IP)));
}

/*

  fuer das rotieren der Kugel

  1: rechtskipp
  2: linkskipp
  3: linksdrehung
  4: rechtsdrehung
  5: vorne
  6: hinten

*/

void dorotate(int dir) {
  int i;
  string aus,neu,temp,wohin;
  mapping ausneu;
  //  if(TP && IS_WIZARD(TP))
  //    tell_room(TO,"test: "+getuid(previous_object())+"\n");
  if (getuid(previous_object()) != "d.unterwelt.zordan") return;
  ausneu=([ ]);
  for (i=0;i<sizeof(ausgaenge);i++) {
    aus=m_indices(ausgaenge)[i];
    temp=ausgaenge[aus];
    RemoveSpecialExit(aus);
    switch (dir) {
      case 1:  if (aus == "norden") neu="norden";
               if (aus == "sueden") neu="sueden";
               if (aus == "westen") neu="oben";
               if (aus == "osten")  neu="unten";
               if (aus == "oben")   neu="osten";
               if (aus == "unten")  neu="westen";
               wohin="kippt auf einmal nach Rechts.";
               break;
      case 2:  if (aus == "norden") neu="norden";
               if (aus == "sueden") neu="sueden";
               if (aus == "westen") neu="unten";
               if (aus == "osten")  neu="oben";
               if (aus == "oben")   neu="westen";
               if (aus == "unten")  neu="osten";
               wohin="kippt auf einmal nach Links.";
               break;
      case 3:  if (aus == "norden") neu="westen";
               if (aus == "sueden") neu="osten";
               if (aus == "westen") neu="sueden";
               if (aus == "osten")  neu="norden";
               if (aus == "oben")   neu="oben";
               if (aus == "unten")  neu="unten";
               wohin="dreht sich auf einmal links herum.";
               break;
      case 4:  if (aus == "norden") neu="osten";
               if (aus == "sueden") neu="westen";
               if (aus == "westen") neu="norden";
               if (aus == "osten")  neu="sueden";
               if (aus == "oben")   neu="oben";
               if (aus == "unten")  neu="unten";
               wohin="dreht sich auf einmal rechts herum.";
               break;
      case 5:  if (aus == "norden") neu="unten";
               if (aus == "sueden") neu="oben";
               if (aus == "westen") neu="westen";
               if (aus == "osten")  neu="osten";
               if (aus == "oben")   neu="norden";
               if (aus == "unten")  neu="sueden";
               wohin="dreht sich auf einmal nach Vorne.";
               break;
      case 6:  if (aus == "norden") neu="oben";
               if (aus == "sueden") neu="unten";
               if (aus == "westen") neu="westen";
               if (aus == "osten")  neu="osten";
               if (aus == "oben")   neu="sueden";
               if (aus == "unten")  neu="norden";
               wohin="dreht sich auf einmal nach Hinten.";
               break;
      default: break;
    }
    ausneu+=([ neu:temp ]);
  }
  ausgaenge=copy_mapping(ausneu);
  for (i=0;i<sizeof(ausgaenge);i++) {
    AddSpecialExit(m_indices(ausgaenge)[i],"schleimweg");
  }
  tell_room(ME,BS(
    "Die Schleimkugel, in der Du Dich befindest, "+wohin));
}
