
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#define exit  ({ "schleim-a11","schleim-a12","schleim-a21","schleim-a22", \
                 "schleim-b11","schleim-b12","schleim-b21","schleim-b22" })

init() {
  ::init();
  if (TP && !interactive(TP) && TP->id("\n_schleimball")) {
    TP->move( ROOM "schleim-a11", M_GO + M_SILENT);
  }
}

create() {
  ::create();

  SetProp( P_INT_SHORT, "Eine extrem schleimige Hoehle" );
  SetProp( P_INT_LONG,
    "Jetzt hast Du es also geschafft. Du bist ueberall umgeben von ekligem "
    "Schleim! Der Schleim hat die Temperatur in diesem Gang so weit "
    "heruntergekuehlt, dass Du sehr stark frierst! Im Sueden kannst Du "
    "ein kleines Loch sehen." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: -40, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }),
    "In der Hoehle ist es zu dunkel. Du muesstest sie schon betreten, "
    "um mehr sehen zu koennen. Allerdings sagt Dir Dein Gespuerr, dass "
    "es vielleicht Deine letzte Tat sein koennte!");

  AddDetail( ({ "tat" }),
    "Es kann, muss aber nicht. Aber es wird hoechstwahrscheinlich!");

  AddDetail( ({ "gespuerr" }),
    "Du hast Angst.");

  AddDetail( ({ "boden","decke","wand","waende" }),
    "Alles voller Schleim!");

  AddDetail( ({ "gang" }),
    "Man kann eigentlich gar nicht mehr Gang dazu sagen, denn einfach "
    "ueberall ist Schleim in allen Farben und Formen vorhanden.");

  AddDetail( ({ "farben","formen" }),
    "Du versuchst genauer zu untersuchen. Aber der Schleim bewegt sich "
    "und deshalb kannst Du nichts genaueres erkennen.");

  AddDetail( ({ "sueden","loch" }),
    "Hinter dem Loch scheint eine grosse Hoehle zu sein. Aber kann man "
    "eigentlich Loch dazu sagen? Eigentlich sieht es eher aus wie ein "
    "grosses Maul!");

  AddDetail( ({ "maul" }),
    "Das Maul koennte zu einem riesigen Lebewesen gehoeren. Besser Du kommst "
    "ihm nicht zu nahe!");

  AddDetail( ({ "lebewesen" }),
    "Eigentlich siehst Du nur Schleim und kein Lebewesen.");

  AddDetail( ({ "schleim" }),
    "Der Schleim ist einfach ueberall hier. Ueber Dir, unter Dir, neben Dir, "
    "ja sogar auf Dir! Er verbreitet einen unglaublichen Gestank und in "
    "Dir kommt Angst und Schrecken auf!");

  AddDetail( ({ "angst" }),
    "Du hast Angst.");

  AddDetail( ({ "schrecken" }),
    "Kann es noch schlimmer kommen? Vermutlich schon!");

  AddDetail( ({ "temperatur" }),
    "Es ist hier kaelter als in einer polaraehnlichen Region.");

  AddDetail( ({ "region" }),
    "Die ist weit weg. Aber hier ist es kaelter!");

  AddSound( ({ DEFAULT_SOUND,"schleim" }),
    "Der Schleim blubbert vor sich hin.");

  AddSmell( ({ DEFAULT_SMELL,"luft","gestank" }),
    "Du bekommst keine Luft mehr vor lauter Gestank!");

  AddExit(        "suedwesten", "./weg2" );
  AddSpecialExit( "hoehle",  "hoehlefkt" );
}

int hoehlefkt(string str) {
  string ex;
  if (TP->QueryProp(P_LEVEL) < 20 || TP->QueryProp(P_GUILD_LEVEL) < 5) {
    write(BS(
      "Du nimmst allen Mut zusammen und willst in die Hoehle gehen. Doch "
      "auf einmal verlaesst Dich Dein Mut und zitternd bleibst Du stehen."));
    return 1;
  }
  write(BS(
    "Du nimmst allen Mut zusammen und gehst in die Hoehle." ));
  ex=ROOM+exit[random(sizeof(exit))];
  return TP->move( ex, M_GO, "in die Hoehle");
}
