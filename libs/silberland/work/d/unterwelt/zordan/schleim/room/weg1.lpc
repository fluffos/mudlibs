

#include "../def.h"



inherit "std/room";



#include <properties.h>

#include <language.h>



create() {

  ::create();



  SetProp( P_INT_SHORT, "Eine seltsame Hoehle" );

  SetProp( P_INT_LONG,

    "Auf einmal aendert sich das Bild der Gaenge. Der Boden ist nicht mehr "

    "so seltsam und auch der andere Rest scheint jetzt irgendwie anders zu "

    "sein. Die Felsen hier haben erstaunlicherweise gar keine Spitzen mehr. "

    "Ein seltsamer Geruch stroemt aus dem Osten herein." );

  SetProp( P_LIGHT, 0 );

  SetProp( P_INDOORS, 1 );

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );



  AddDetail( ({ "rest" }),

    "Alles ist hier irgendwie anders geworden. Friedlich erscheint es. "

    "Aber solch ein Frieden kann auch sehr gefaehrlich sein.");



  AddDetail( ({ "felsen","fels" }),

    "Die Felsen haben keine Spitzen mehr. Sie scheinen abgebrochen oder "

    "von Schleim bedeckt zu sein. Jedenfalls wirst Du Dich hier sicher "

    "nirgends mehr schneiden.");



  AddDetail( ({ "spitze","spitzen" }),

    "Die fehlen oder sind von Schleim bedeckt.");



  AddDetail( ({ "bild" }),

    "Es wirkt nicht mehr so schauerlich. Eigentlich sogar eher friedlich. "

    "Doch dieser Frieden kann sicher arg taeuschen!");



  AddDetail( ({ "frieden" }),

    "Ob Du den hier finden wirst? Du wagst es zu bezweifeln.");



  AddDetail( ({ "gaenge","gang" }),

    "Die Gaenge haben hier ihr Bild veraendert. Statt Dreck und Wuermer "

    "findet sich auf einmal ein wenig Schleim ueberall.");



  AddDetail( ({ "dreck","wuermer","wurm" }),

    "Davon ist nichts mehr vorhanden.");



  AddDetail( ({ "schleim" }),

    "Kleine Schleimhaufen liegen auf dem Boden und haengen an den Waenden. "

    "Der Schleim riecht nicht gerade angenehm.");



  AddDetail( ({ "schleimhaufen","haufen" }),

    "Die Haufen aus Schleim sind noch relativ klein.");



  AddDetail( ({ "boden" }),

    "Waere nicht etwas Schleim auf dem Boden, koennte man wohl sagen, "

    "diese Hoehle wurde von einem Lebewesen geschaffen.");



  AddDetail( ({ "hoehle","maechte","macht" }),

    "Die Hoehle wurde ganz sicher von boesen Maechten geschaffen!");



  AddDetail( ({ "lebewesen" }),

    "Derzeit kannst Du noch keines sehen.");



  AddDetail( ({ "decke" }),

    "Die Decke ist nicht weit ueber Dir. An ihr klebt ein wenig Schleim.");



  AddDetail( ({ "wand","waende" }),

    "Die Waende sind recht glatt. Aber trotzdem haengt hier und da ein "

    "wenig Schleim daran.");



  AddSound( ({ DEFAULT_SOUND, "wind" }) ,

    "Der Wind pfeift durch den Gang.");



  AddSmell( DEFAULT_SMELL,

    "Aus dem Osten stroemt ein seltsamer Geruch herein.");



  AddSmell( "geruch",

    "Genau identifizieren kannst Du den Geruch noch nicht. Aber es "

    "scheint bestialisch zu stinken.");



  AddExit( "westen", "/d/unterwelt/basics/central/room/00+07+08" );

  AddExit( "osten",  "./weg2" );

}

