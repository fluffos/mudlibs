
/*Bezuege zum RL sind rein zufaellig ;) */

#include "../def.h"
inherit ROOM "haus_inh";
#include <properties.h>
#include <language.h>

create () {
        ::create();
	SetProp(P_INT_SHORT, "In Soias Kinderzimmer");
	SetProp( P_LIGHT, -1);
	SetProp( P_INDOORS, 1 );
	SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
	SetProp(P_INT_LONG, 
		"Du stehst in Soias Kinderzimmer. Hier herrscht ein echtes "
		"Chaos, wie man es in einem Kinderzimmer halt gewohnt ist. "
		"Ueberall liegt Spielzeug auf dem Boden verteilt und der kleine "
		"Arbeitstisch ist mit lauter Zetteln bedeckt. Ansonsten ist "
		"das Zimmer recht gut moebliert. Du kannst ein kleines Kinderbett "
		"in der Ecke sehen, einen riesigen Kasten mit Baukloetzen und "
		"einen Laufstall. Ausserdem steht auf einem Schraenkchen noch "
		"ein Kaefig. Du kannst allerdings keine Fenster in den Waenden "
		"sehen. Vielleicht solltest Du Zordan und Elvira mal "
		"vorschlagen, dass ihr Sohn das Zimmer ein bisschen aufraeumt."
		);

	AddDetail( ({"kinderzimmer","zimmer"}),
		"Ein Kinderzimmer ist eigentlich dafuer da, dass ein Kinder "
		"darin austoben koennen. Aber Soia scheint ein bisschen "
		"uebertrieben zu haben. Bei dem ganzen Chaos hier, kommt man "
		"gar nicht voran. Soia sollte vielleicht doch ein wenig aufraeumen."
		);

	AddDetail( ({"chaos","durcheinander"}),
		"In diesem Zimmer herrscht das absolute Chaos. Nirgends hast "
		"Du schon so ein Durcheinander gesehen. Soia haelt wohl nicht "
		"viel vom aufraeumen, da sein ganzes Spielzeug auf dem Boden "
		"verteilt zu seien scheint."
		);

	AddDetail( ({"spielzeug","spielsachen"}),
		"Ueberall siehst Du nur Spielzeug. Du fragst Dich wofuer Soia "
		"soviel Spielzeug braucht und woher er es hat. Seine Eltern "
		"scheinen ihn ja sehr zu moegen, wenn sie ihm soviel zum spielen "
		"geben."
		);

	AddDetail( ({"eltern"}),
		"Zordan und Elvira, dieses Traumpaar des SLs sind Soias Eltern. "
		"Er hat richtig Glueck gehabt solche Eltern zu haben, da sie "
		"anscheinend viel bieten und sehr tolerant sind, zumindest was "
		"das aufraeumen angeht."
		);

	AddDetail( ({"traumpaar"}),
		"Zordan und Elvira sind das absolute Traumpaar des Silberlandes, "
		"weil sie sehr liebevoll und hilfsbereit sind. Jeder im "
		"Silberland koennte auf ihre Hilfe vertrauen."
		);
		
	AddDetail( ({"zordan","papa"}),
		"Zordan ist Soias grosser und starker Papa. Er ist Dunkelelf "
		"und man sollte sich wohl besser nicht mit ihm anlegen."
		);

	AddDetail( ({"elvira","mama"}),
		"Elvira ist Soias liebevolle und reizende Mama. Sie ist (wie "
		"sollte es anders sein) Dunkelelfin und kuemmert sich sehr "
		"um Soia."
		);
	
	AddDetail( ({"dunkelelf","dunkelelfin","dunkelelfen"}),
		"Dunkelelfen sind einfach nur boese und verabscheuen das Licht. "
		"Aber dennoch gibt es einige nette von ihnen, wie zum Beispiel "
		"Zordan, Elvira und Soia."
		);

	AddDetail ( ({"beispiel"}),
		"Nur ein Beispiel. Obwohl man eigentlich kein anderes nennen "
		"koennte."
		);
	
	AddDetail( ({"boden"}),
		"Der Boden ist mit Spielzeug uebersaet. Keine einzige Stelle "
		"scheint nicht mit Spielzeug verdeckt zu sein. Du fragst Dich "
		"wie Soia in diesem Zimmer ueberhaupt voran kommt."
		);

	AddDetail( ({"stelle"}),
		"Keine einzige Stelle auf dem Boden ist nicht vom Spielzeug "
		"verdeckt, so dass du nichts vom Teppich erkennen kannst."
		);

	AddDetail( ({"teppich"}),
		"Tatsaechlich findest Du doch eine Stelle, die nicht vom Spielzeug "
		"verdeckt ist. Der Teppich scheint mit lauter bunten Figuren "
		"gemuster zu sein."
		);

	AddDetail( ({"figuren"}),
		"Clowns, Teddy-Baeren, kleine Aeffchen, Lokomotiven, Autos, "
		"Baelle, Aexte, Blumen, und und und ..."
		);
	
	AddDetail( ({"clowns","teddy","baeren","aeffchen","lokomotiven","autos","baelle","blumen"}),
		"Das sind alle Figuren, die Du auf dem Teppich erkennen kannst."
		);

	AddDetail( ({"aexte","axt"}),
		"Vorsicht!! Die koennen Dir vielleicht gefaehrlich werden. "
		);

	AddDetail( ({"vorsicht"}),
		"Deine Vorsicht scheint versagt zu haben, denn Du bist mitten "
		"in eine Script-Falle getappt. Alle Deine Forscherpunkte "
		"werden = 0 gesetzt. Das bedeutet alles von vorne, aber ohne "
		"Scripts!"
		);
	
	AddDetail( ({"arbeitstisch","tisch","tischchen"}),
		"Arbeitstisch? Soia scheint wohl doch nicht den ganzen Tag zu "
		"spielen, denn dieses kleine Tischchen	ist uebersaet mit "
		"irgendwelchen Zettel. Soia scheint das ganze Spielzeug nur "
		"als Taeuschung zu nutzen."
		);

	AddDetail( ({"zettel"}),
		"Du kannst auf dem Zetteln nur irgendwelche Formeln erkennen, "
		"die Du nicht verstehst. Soia scheint als an irgendwas was hier "
		"zu arbeiten."
		);

	AddDetail( ({"formeln"}),
		"Lauter Formeln, die Du nicht verstehst. Frag Soia doch mal nach."
		);

	AddDetail( ({"taeuschung"}),
		"In Wirklichkeit ist Soia ein geniales Genie, das den ganzen "
		"Tag nur am arbeiten ist. Das Spielzeug und das Chaos dienen "
		"vielleicht nur als Taeuschung."
		);

	AddDetail( ({"kinderbett","bett","ecke"}),
		"Das Bett sieht recht bequem aus. Es liegt eine mollige Decke "
		"drauf und auch noch ein kleiner Schmusehund. Das Bett ist "
		"allerdings auch nicht gemacht."
		);
		
	AddDetail( ({"decke","kuscheldecke"}),
		"So eine richtig kuschelige, mollige Kuscheldecke, mit der man "
		"den ganzen Tag nur knuddeln moechte."
		);

	AddDetail( ({"schmusehund","hund"}),
		"Knuddel ihn doch mal."
		);

	AddDetail( ({"kasten"}),
		"Soia scheint wohl gerne zu bauen, da der Kasten ueberquillt "
		"mit Baukloetzen."
		);

	AddDetail( ({"baukloetze","kloetze"}),
		"Es sind Baukloetze, die man ganz leicht aufeinanderstecken "
		"kann und so ein festen Halt haben."
		);	
	
	AddDetail( ({"genie"}),
		"Soia ist vielleicht ein Genie. Vielleicht ist er aber auch nur ein "
		"kleiner Junge, der von nichts etwas weiss."
		);		


	AddDetail( ({"junge"}),
		"Ein kleiner Junge der von nichts etwas weiss und auch noch nicht "
		"viel gesehen."
		);					
	
	AddDetail( ({"laufstall","stall"}),
		"Ein Laufstall fuer kleine Kinder. Sie werden dareingesetzt um "
		"angeblich laufen zu lernen. Aber Du denkst, dass Eltern mal "
		"ein Weilchen Ruhe vor ihren Kindern haben moechten."
		);
	AddDetail( ({"ruhe"}),
		"Hin und wieder brauch jeder nun mal seine Ruhe."
		);

	AddDetail( ({"schraenkchen"}),
		"Ein kleines Schraenkchen, das neben Soias Bett steht. Da sind "
		"vielleicht die Klamotten von Soia drin. Auf dem Schraenkchen "
		"steht noch ein Kaefig."
		);

	AddDetail( ({"klamotten"}),
		"Die Klamotten, die man nunmal im Leben braucht."
		);

	AddDetail( ({"kaefig"}),
		"In dem Kaefig bewegt sich Etwas. Du kannst noch nicht genau "
		"erkennen, was sich darin bewegt."
		);

	AddDetail( ({"etwas"}),
		"HUCH !!! Eine Spinne krabbelt in dem Kaefig herum. Was Soia "
		"doch fuer Haustiere hat. Widerlich!"
		);
	
	AddDetail( ({"haustiere","geschmack"}),
		"Soia scheint einen komischen Geschmack fuer Haustiere zu haben. "
		);

	AddDetail( ({"spinne"}),
		"Die Spinne scheint eine Schwarze Witwe zu sein. Sie hat einen "
		"dicken Schwarzen Panzer hinten, sechs Beine und eine kleine "
		"Kopf, dessen Augen Dich die ganze Zeit verfolgen zu scheinen."
		);

	AddDetail( ({"witwe","witwen"}),
		"Normalerweise werden Ehefrauen, die ihren Mann verloren haben "
		"Witwen genannt. Hier jedoch ist eine Spinne genannt."
		);

	AddDetail( ({"panzer"}),
		"Der Panzer soll die Spinne schuetzen, genau wie Dich Dein "
		"Panzer schuetzen sollte."
		);

	AddDetail( ({"beine"}),
		"Beine braucht die Spinne um sich fortzubewegen, genau wie Du "
		"Deine Beine brauchst um Dich fortzubewegen."
		);

	AddDetail( ({"kopf"}),
		"Einen Kopf braucht die Spinne zum denken, genau wie Du Deinen "
		"Kopf zu denken brauchst."
		);

	AddDetail( ({"augen"}),
		"Falls Du jetzt denkst hier kommt so etwas wie: 'Augen brauch "
		"die Spinne ... ' hast Du Dich geirrt. Die Augen der Spinne "
		"verfolgen Dich die ganze Zeit. Was will die Spinne wohl von "
		"Dir? "
		);

	AddDetail( ({"zeit"}),
		"Die Zeit wird's zeigen."
		);

	AddDetail( ({"waende"}),
		"Die Waende bestehen aus schwarzen Gestein. Du kannst keine "
		"Fenster entdecken. Nur an einer Wand faellt Dir etwas auf."
		);

	AddDetail( ({"fenster"}),
		"Es sind keine Fenster eingebaut, so dass auch kein Licht ins "
		"Zimmer kommen kann, weil Soia Licht hasst."
		);

	AddDetail( ({"licht"}),
		"Soia hasst das Licht, genau wie all die anderen Dunkelelfen."
		);

	AddDetail( ({"wand"}),
		"An einer Wand haengt ein Bild."
		);

	AddDetail( ({"bild","familienfoto","foto"}),
		"Es scheint ein Familienfoto zu sein, weil Zordan, Elvira "
		"und Soia schick angezogen und laechlend vor ihrem Haus stehen."
		);

 	
	AddCmd( ({"knuddel","knuddle"}), "knuddel_hund");
	AddCmd( ({"raeum","raeume"}),"aufraeumen"); /*Hier sollte eigentlich*/
	AddExit( "osten", "./flur" );		           /*'raeume auf' hin,*/
                                                                  	          /*aber ich weiss nicht*/
					         /*wie das geht ;) */

}

knuddel_hund( str )
{
	notify_fail( "Knuddle wen ?\n" );
	if( str == "schmusehund" )
	{
		write( "Du knuddelst den kleinen Schmusehund. Er scheint das zu moegen.\n");
				return 1;
				say( this_player()->name(WER,2)+" knuddelt Soias Schmusehund.\n");
				return 1;
	}
}

aufraeumen( str )
{	
	notify_fail( "Was willst Du aufraeumen ?\n" );
	if (str == "zimmer" )
	{
		write(	"Du moechtest Soia zwar gerne einen Gefallen tun, aber Du kannst doch nicht "
  		           	"einfach seine Tarnung auffliegen lassen. \n");
		return 1;
	}
	return 0;
}
