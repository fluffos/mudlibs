
#include "../def.h"

inherit ROOM "haus_inh";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Der Vorratsraum in Elviras und Zordans Haus" );
  SetProp( P_INT_LONG,
    "Du bist im Vorratsraum." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: -10, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");
    
  AddSmell( DEFAULT_SMELL,
    "");

  AddCmd( ({ "tue" }), "command" );

  AddExit( "sueden", "./kueche" );
}
