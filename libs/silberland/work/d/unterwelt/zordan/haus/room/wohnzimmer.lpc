
#include "../def.h"

inherit ROOM "haus_inh";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Das Wohnzimmer in Elviras und Zordans Haus" );
  SetProp( P_INT_LONG,
    "Du bist im Wohnzimmer." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");
    
  AddSmell( DEFAULT_SMELL,
    "");

  AddCmd( ({ "tue" }), "command" );

  AddExit( "norden",     "./esszimmer" );
  AddExit( "westen",     "./eingang" );
  AddExit( "nordosten",  "./zordan" );
  AddExit( "osten",      "./elvira" );
}
