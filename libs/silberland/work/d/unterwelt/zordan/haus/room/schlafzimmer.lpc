
#include "../def.h"

inherit ROOM "haus_inh";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Das Schlafzimmer in Elviras und Zordans Haus" );
  SetProp( P_INT_LONG,
    "Du bist im Schlafzimmer." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "" }),
    "");

  AddReadDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");
    
  AddSmell( DEFAULT_SMELL,
    "");

  AddExit( "westen", "./flur" );
}
