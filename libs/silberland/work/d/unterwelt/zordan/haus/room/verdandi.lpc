//#pragma strong_types

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include <moving.h>




void create()
{
  string WIZNAME;

  ::create();
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Im Kinderzimmer von Verdandi");
  SetProp(P_INT_LONG,
   		"Du bist hier in Verdandis Kinderzimmer gelandet. Auf den ersten Blick "
   		"erkennst Du schon, dass hier ein Maedchen wohnen muss, denn es ist alles "
   		"dementsprechend eingerichtet. Die Waende sind rosa gestrichen und die Regale "
   		"quellen fast ueber mit Stofftieren. Der Blickfang in diesem Zimmer ist aber "
   		"sicherlich die kleine rosa Wiege und das grosse Puppenhaus. Man kann hier "
   		"wirklich sehen, dass sich Verdandis Eltern sehr bemueht haben, dieses Zimmer "
   		"so schoen wie moeglich einzurichten.");
   
  SetProp(P_ENVIRONMENT, ([ ENV_TEMPERATURE:19, ENV_TERRAIN:TT_HOUSE ]) );
  SetProp(P_INDOORS, 1);
  
  AddDetail( ({"kinderzimmer", "zimmer"}), QueryProp(P_INT_LONG) );
  		
  AddDetail("verdandi",
  		"Verdandi ist die Tochter von Zordan und Elvira. Ausserdem ist sie die kleine "
  		"Schwester von Soia.");
  		
  AddDetail( ({"tochter", "sohn"}),
  		"Zordan und Elvira haben eine kleine Tochter und einen schon etwas groesseren "
  		"Sohn.");
  		
  AddDetail( ({"zordan", "mann"}),
  		"Er ist nicht nur ein sehr wichtiger Mann hier in Dhrkion, sondern auch ein "
  		"ausgezeichneter Vater, der sich wirklich liebevoll um seine Kinder kuemmert.");
  		
  AddDetail("elvira",
  		"Sie ist die Mutter von Verdandi und Soia. Leider ist sie nicht allzu oft "
  		"zuhause, sondern durchstreift meistens das SilberLand und haelt alle moeglichen "
  		"Bestien von ihren Kindern fern. In dieser Zeit kuemmert sich dann meist Zordan "
  		"um die Kleinen.");
  		
  AddDetail("schwester",
  		"Verdandi ist Soias Schwester.");
  		
  AddDetail("soia",
  		"Auch Verdandis Bruder Soia hat ein eigenes Zimmer in diesem Haus. Wenn Du "
  		"hier raus und dann nach Westen gehst, kommst Du direkt in sein Zimmer.");
  		
  AddDetail("dhrkion",
  		"Dhrkion ist die Geburtsstadt aller Dunkelelfen.");
  		
  AddDetail("bruder",
  		"Verdandis Bruder heisst Soia.");
  		
  AddDetail("vater",
  		"Verdandi sagt immer, sie haette den liebsten Vater, den es gibt. Allerdings "
  		"hatte sie noch nie einen anderen, wodurch ihr irgendwie der Vergleich fehlt. ;)");
  		
  AddDetail("mutter",
  		"Sie duerfte gerade nicht da sein.");
  		
  AddDetail( ({"kinder", "kleine", "kleinen"}),
  		"Damit sind Soia und Verdandi gemeint.");
  		
  AddDetail("silberland",
  		"Da befindest Du Dich gerade.");
  		
  AddDetail( ({"bestien", "bestie"}),
 		"Hm, noch hast Du hier im Zimmer keine gefunden. Sei lieber froh darueber und "
 		"hoffe, dass Dich auch keine anspringt, wenn Du hier weiter forschst.");
 		
  AddDetail("westen",
  		"Von hier aus kannst Du nicht nach Westen gehen.");
  		
  AddDetail("geburtsstadt",
  		"In Dhrkion kommen alle Dunkelelfen auf die Welt.");
  		
  AddDetail("blick",
  		"Du siehst Dich um und merkst gleich an der Einrichtung, dass hier ein Maedchen "
  		"wohnen muss.");
  		
  AddDetail("einrichtung",
  		" ");
  		
  		






  AddExit("nordosten", "./flur");
}
