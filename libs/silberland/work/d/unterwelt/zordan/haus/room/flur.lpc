
#include "../def.h"

inherit ROOM "haus_inh";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Im Flur von Elviras und Zordans Haus" );
  SetProp( P_INT_LONG,
    "Der Flur ist ein langer Gang in suedliche Richtung. Von ihm aus fuehren "
    "mehrere Eingaenge in angrenzende Wohnraeume. Zurueck in den "
    "Eingangsbereich versperrt ein wallender Vorhang und ganz im Sueden "
    "eine Tuer Deine Sicht. Auf dem langen Teppich stehen diverse Schraenke "
    "und Vitrinen. Die ansonsten kahlen Waende sind mit zahlreichen Bildern "
    "verziehrt." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "flur","raum" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "herz" }),
    "Das kleine Herz sieht man haeufiger in einer Tuer von einem Bad.");

  AddDetail( ({ "bad" }),
    "Das Bad liegt wohl im Sueden. Darum auch die Tuer davor.");

  AddDetail( ({ "vitrine","vitrinen" }),
    "Die Vitrinen enthalten allerlei Haushaltswaren. Auf einigen von ihnen "
    "stehen kleine Vasen mit Blumen.");

  AddDetail( ({ "sachen","sache" }),
    "Bist Du ein Hausdiener oder warum interessierst Du Dich so sehr dafuer?");

  AddDetail( ({ "hausdiener","diener" }),
    "Elvira und Zordan haben sicher welche. Schau Dich doch mal um.");

  AddDetail( ({ "haushalt" }),
    "Elvira und Zordan lassen sich ihren Haushalt sicher fuehren und machen "
    "selber wenig.");

  AddDetail( ({ "haushaltswaren","waren","ware" }),
    "Dabei handelt es sich um so kleine Sachen, die man in einem Haushalt "
    "nunmal so braucht. Komischerweise sind sie verschlossen.");

  AddDetail( ({ "bilder","bild" }),
    "Die Bilder zeigen wohl verschiedene Verwandte von Elvira und Zordan.");

  AddDetail( ({ "schrank","schraenke" }),
    "Diverse Schraenke stehen an den Waenden. Sie sind nicht aus Holz. Soviel "
    "steht schonmal fest. Aber woraus sie bestehen, kannst Du gar nicht "
    "sagen. Sie sind allesamt geschlossen. Auf ein paar von den Schraenken "
    "liegen kleine Decken.");

  AddDetail( ({ "decken" }),
    "Das sind kleine gestickte Decken um die Schraenke nicht so trostlos "
    "aussehen zu lassen.");

  AddDetail( ({ "verwandte","bekannte","bekannten" }),
    "Du erkennst keinen Bekannten auf diesen Bildern. Sie sind wohl einfach "
    "schon viel zu alt.");

  AddDetail( ({ "wand","waende" }),
    "Die Waende sind mit zahlreichen Bildern vollgehaengt. Ein einer Wand "
    "kannst Du einen kleinen Knopf erkennen.");

  AddDetail( ({ "knopf" }),
    "Der Knopf ist ganz unscheinbar neben dem Vorhang angebracht worden.");

  AddDetail( ({ "teppich" }),
    "Der Teppich scheint ein wenig orientalisch zu sein. In dieser Laenge "
    "hast Du noch keinen gesehen. Er zeigt verschiedene Muster.");

  AddDetail( ({ "laenge","schritt","schritte" }),
    "Der Teppich ist mehrere Schritte lang.");

  AddDetail( ({ "muster","abbildung","abbildungen" }),
    "Die Muster sind sehr verschieden und scheinen verschiedene Rassen "
    "darzustellen.");

  AddDetail( ({ "rasse","rassen" }),
    "Die Muster zeigen Abbildungen verschiedenster Rassen. Es wundert Dich "
    "nicht, dass gerade die Dunkelelfen deutlich hervorgehoben wurden.");

  AddDetail( ({ "boden" }),
    "Der Boden ist sauber geputzt und ein langer, roter Teppich liegt darauf.");

  AddDetail( ({ "decke" }),
    "An der Decke haenge zwei kleine Zierlampen.");

  AddDetail( ({ "zierlampen","lampen","lampe","zierlampe" }),
    "Da Elvira und Zordan Dunkelelfen sind, brauchen sie keine Lampen. Um "
    "das Ambiente aber zu erhoehen, haben sie zwei kleine Zierlampen an "
    "der Decke befestigt.");

  AddDetail( ({ "dunkelelfen","dunkelelf" }),
    "Elvira und Zordan sind Dunkelelfen. Ihre Kinder aber wohl alle nicht!?!");

  AddDetail( ({ "eingangsbereich","bereich" }),
    "Der Flur grenzt direkt an den Eingangsbereich. Ein wallender Vorhang "
    "trennt diese beiden Wohnraeume aber voneinander ab.");

  AddDetail( ({ "vorhang" }),
    "Der Vorhang haengt von der Decke bis zum Boden und trennt den "
    "Eingangsbereich vom Flur. Er ist aus feinstem Stoff und sicher sehr "
    "wertvoll.");

  AddDetail( ({ "stoff","seide" }),
    "Samtweich fuehlt sich der Stoff an, obwohl es keine Seide ist.");

  AddDetail( ({ "mahagoni","mahagoniholz","holz" }),
    "Das Holz ist das reinste und feinste Mahagoni, das Du in Deinem Leben "
    "zu Gesicht bekommen hast.");

  AddDetail( ({ "gesicht" }),
    "Dein Gesicht kannst Du vielleicht im Bad ansehen?");

  AddDetail( ({ "leben" }),
    "Moegest Du noch lange und friedlich leben.");

  AddDetail( ({ "sicht" }),
    "Deine Sicht wird durch einen Vorhang und eine Tuer versperrt.");

  AddDetail( ({ "eingaenge","eingang" }),
    "Die Eingaenge fuehren in weitere Wohnraeume weiter. Du kannst von hier "
    "aus aber keinen deutlich erkennen.");

  AddDetail( ({ "wohnraeume","raeume","teil" }),
    "Hier in diesem Teil ist es sehr ruhig und Du vermutest das sich die "
    "Familie von Elvira und Zordan hier in der Nacht zurueckzieht.");

  AddDetail( ({ "nacht" }),
    "Derzeit ist es nicht Nacht. Aber sobald es Nacht wird ziehen sie "
    "sich hierher zurueck.");

  AddDetail( ({ "zordan","herr","hausherr" }),
    "Zordan ist der Hausherr.");

  AddDetail( ({ "familie" }),
    "Elvira, Zordan und ihre Kinder bilden eine schon nicht mehr kleine "
    "Familie. Daher gibt es hier auch schon soviele Wohnraeume.");

  AddDetail( ({ "kind","kinder" }),
    "Die leben wohl in ihren eigenen Raeumen im Westen und Suedwesten.");

  AddDetail( ({ "gang" }),
    "Der Flur ist eigentlich nur ein Verbindungsstueck fuer die Wohnraeume. "
    "Aber vor allem Elvira hat auch diesen Raum himmlisch ausgestattet.");

  AddDetail( ({ "verbindungsstueck" }),
    "Der Flur bildet genau so eines.");

  AddDetail( ({ "elvira","herrin","hausherrin" }),
    "Elvira ist die Hausherrin. Das solltest Du inzwischen aber schon wissen. "
    "Sie hat es sogar geschafft einem normalen Flur ein wundervolles "
    "Ambiente zu verleihen.");

  AddDetail( ({ "himmel" }),
    "Der Himmel bildet hier die normale Decke.");

  AddDetail( ({ "richtung","richtungen","himmelsrichtungen" }),
    "Hier geht es in fast alle Himmelsrichtungen weiter. Nur nach Norden "
    "und nach Sueden versperren ein Vorhang und eine Tuer die Sicht.");

  AddDetail( ({ "ambiente" }),
    "Es ist hier einfach wundervoll und Du koenntest Dich glatt wie "
    "daheim fuehlen.");

  AddDetail( ({ "blume","blumen" }),
    "Ein paar Blumen stehen in kleinen Vasen auf ein paar der Vitrinen.");

  AddDetail( ({ "vase","vasen","stuecke","kunststuecke",
                "stueck","kunststueck" }),
    "Die Vasen sind wahre Kunststuecke. Nur ein wahrer Meister kann diese "
    "stilvollen Vasen herstellen. Sie sind verschiedenfarbig und haben "
    "unterschiedliche Formen.");

  AddDetail( ({ "meister" }),
    "Man koennte fast meinen nur ein goettlicher Meister koennte solche "
    "Vasen herstellen.");

  AddDetail( ({ "formen","form" }),
    "Von rund bis eckig, schlank und dick. Es sind viele Formen vorhanden.");

  AddSound( DEFAULT_SOUND,
    "Laute Geraeusche kommen aus dem Westen und Suedwesten. Dagegen ist es "
    "hier ansonsten sehr still und ruhig.");
    
  AddSound( "geraeusche",
    "Irrst Du Dich oder koennten das spielende Kinder sein?");
    
  AddSound( ({ "kinder","kind" }),
    "Tatsaechlich, das sind spielende Kinder und sie sind dabei nicht gerade "
    "leise.");
    
  AddSmell( DEFAULT_SMELL,
    "Ein angenehmer Duft liegt in der Luft.");

  AddSmell( "duft",
    "Der Flur riecht nach frischen Blumen.");

  AddSmell( "luft",
    "Der angenehme Duft von Blumen liegt in der Luft.");

  AddSmell( ({"blumen","blume" }),
    "Die Blumen riechen einfach himmlisch und verleihen dem Flur ein "
    "wundervolles Ambiente.");

  AddSpecialDetail( ({ "tuer" }), "tuerfkt" );

  AddCmd( ({ "oeffne" }),               "oeffnefkt" );
  AddCmd( ({ "putz","putze" }),         "putzefkt" );
  AddCmd( ({ "schliesse","schliess" }), "schliessefkt" );
  AddCmd( ({ "druecke","drueck" }),     "drueckefkt" );

  AddExit( "norden",     "./eingang" );
  AddExit( "osten",      "./schlafzimmer" );
  AddExit( "westen",     "./soia" );
  AddExit( "suedwesten", "./verdandi" );
  AddExit( "suedosten",  "./gaeste" );
  AddSpecialExit( "sueden",     "suedenfkt" );
}

string tuerfkt() {
  string str;
  if(call_other(ROOM "bad","checktuer")) 
    return BS("Die Tuer ist aus feinstem Mahagoniholz gefertigt und versperrt "
              "Dir den Weg nach Sueden. Durch ein kleines Herz in der Tuer "
              "glaubst Du etwas zu erkennen.");
  else
    return BS("Die Tuer ist aus feinstem Mahagoniholz gefertigt und steht "
              "sperrangelweit offen.");
}

int oeffnefkt(string str) {
  notify_fail("Was moechtest Du denn gerne oeffnen?\n");
  if(!str) return 0;
  if (str == "tuer" ) {
    if(call_other(ROOM "bad","checktuer")) {
      if(call_other(ROOM "bad","checkzu")) {
        write(BS(
          "Die Tuer wurde wohl von der anderen Seite verschlossen. Du kannst "
          "sie von dieser Seite daher nicht oeffnen. Du musst wohl warten."));
        return 1;
      } else {
        write(BS(
          "Du oeffnest sanft die Tuer und kannst hinter ihr ein wundervolles "
          "Bad erkennen."));
        say(CAP_TPN+" oeffnet die Tuer zum Bad.");
        call_other(ROOM "bad","dotuer",0);
        return 1;
      }
    } else {
      write(BS(
        "Aber die Tuer steht doch schon sperrangelweit offen."));
      return 1;
    }
  }
  if(str=="schrank" || str=="schraenke") {
    write(BS(
      "Du oeffnest einen der Schraenke. Doch enttaeuscht musst Du ein "
      "richtiges Chaos darin feststellen. Ohne noch lange darin herumzuwuehlen "
      "schliesst Du den Schrank wieder und laesst es dabei bewenden."));
    return 1;
  }
  if(str=="vitrine" || str=="vitrinen") {
    write(BS(
      "Die Virtrinen kann man auch so betrachten. Du findest keine "
      "Moeglichkeit auch nur eine davon zu oeffnen."));
    return 1;
  }

  return 0;
}

int schliessefkt(string str) {
  notify_fail("Was moechtest Du denn gerne schliessen?\n");
  if(!str) return 0;
  if (str == "tuer" ) {
    if(call_other(ROOM "bad","checktuer")) {
      write(BS(
        "Aber die Tuer ist doch schon geschlossen."));
        return 1;
    } else {
      write(BS(
        "Sanft entschwebt Dir die Tuer und sie faellt zu."));
      say(CAP_TPN+" schliesst die Tuer zum Bad.");
      call_other(ROOM "bad","dotuer",1);
      return 1;
    }
  }
  return 0;
}

suedenfkt() {
  if(call_other(ROOM "bad","checktuer")) {
    write(BS(
      "Die Tuer in den Sueden ist derzeit leider geschlossen."));
    return 1;
  }
  return ROOM "bad";
}

int drueckefkt(string str) {
  notify_fail("Was moechtest Du denn gerne druecken?\n");
  if(!str) return 0;
  if (str == "knopf" ) {
    write(BS(
      "Du drueckst auf den Knopf. Es macht einfach nur *KLICK*. Aber "
      "ansonsten scheint irgendwie gar nichts zu passieren. Sollte dieser "
      "Knopf etwa mal fuer das Licht gedacht gewesen sein und jetzt nicht "
      "mehr gebraucht werden?"));
    say(CAP_TPN+" drueckt auf einen kleinen Knopf.");
    return 1;
  }
  return 0;
}

int putzefkt(string str) {
  write(BS(
    "Hier ist wirklich alles suuuper sauber. Du brauchst nicht noch selber "
    "etwas zu putzen."));
  return 1;
}

