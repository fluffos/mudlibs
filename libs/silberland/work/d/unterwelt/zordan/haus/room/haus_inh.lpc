/*

  Inherit fuer das Wohnhaus von Elvira und Zordan

*/

inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>

create() {
  ::create();
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_HOUSE]) );

  AddCmd( "showroom", "elvirafkt" ); 
}

elvirafkt(string str) {
  string file;
  if (str) return 0;
  if (getuid(TP) != "zordan" && getuid(TP) != "elvira" && getuid(TP) != "soia" && getuid(TP) != "verdandi")
    return 0;
  write("Der Sourcecode von diesem Raum:\n");
  write("===============================\n");
  if (ENV(TP)) {
    file=read_file(file_name(ENV(TP))+".lpc");
    TP->More(file);
  }
  return 1;
}

