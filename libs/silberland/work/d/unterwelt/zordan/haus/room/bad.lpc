/*
// Das Badezimmer von Elvira und Zordan
*/

#include "../def.h"

inherit ROOM "haus_inh";

#include <properties.h>
#include <language.h>

string womit;          // welches symbol wurde gedrueckt ?
mapping symbole=([ ]); // hier sind die moeglichen symbole gespeichert

int tuer,verschluss;

reset() {
  ::reset();
  womit="";
  tuer=1;
  verschluss=0;
}

create() {
  int i;
  string *ind;
  ::create();

  symbole=([
    "wellen":"Wasser";"das Wasser",
    "muenzen":"Muenzen";"die Muenzen",
    "bierfass":"Bier";"das Bier",
    "weinrebe":"Wein";"der Wein",
    "kuh":"Milch";"die Milch"
  ]);
  womit="";
  tuer=1;
  verschluss=0;

  SetProp( P_INT_SHORT, "In Elvira und Zordans Badezimmer");
  SetProp( P_INT_LONG, BS(
    "Eine riesig, prunkvoll vergoldete Badewanne sticht Dir beim Betreten "
    "des Bades sofort ins Auge. Wenn Du die Gelegenheit hier ein Bad zu "
    "nehmen nicht nutzt ist Dir bestimmt nicht mehr zu helfen! Die Waende "
    "sind verfliest und strahlen etwas Mystisches aus. Die Westwand ist "
    "ein einziger grosser Spiegel. An der Ostwand kannst Du eine kleine "
    "WCTuer mit einem Schild darueber erkennen."));
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"bad","badezimmer","zimmer"}), QueryProp(P_INT_LONG));
  AddDetail ( ({ "badewanne","wanne" }),
	"Momentan ist die riesige Badewanne leer. Du kannst auch keine Wasser"
	"haehne entdecken. Doch Du bist ueberzeugt dass man hier baden kann..."
	"also wird sich der Mechanismus auch irgendwo finden.");
  AddDetail( ({"boden","teppich"}),
	"Der Boden ist wie die Waende verfliest. Ein flauschiger Teppich ist "
	"darauf ausgebreitet.");
  AddDetail( ({"tuer"}),
	"Es gibt hier zwei Tueren. Eine ist die WCTuer und die andere fuehrt "
        "zurueck in den Flur.");
  AddDetail( ({"flur"}),
	"Der lange Flur liegt noerdlich vom Bad.");
  AddDetail( ({"auge"}),
	"Das Auge zu untersuchen scheint hier wenig sinnvoll :))");
  AddDetail( ({"gelegenheit"}),
	"Nein die Syntax lautet nun nicht nutze Gelegenheit sondern nimm Bad! "
	"Das solltest Du Dir allerdings wirklich nicht entgehen lassen!");
  AddDetail( ({"syntax"}),
	"Elvira und Zordan haben sich sehr bemueht, dass es mit der Syntax "
        "scheitert!");
  AddDetail( ({"waende","wand","westwand","ostwand"}),
	"Die Waende sind verfliest und strahlen etwas Mystisches aus. Die "
        "Westwand ist ein einziger grosser Spiegel. An der Ostwand kannst "
        "Du eine kleine WCTuer mit einem Schild darueber erkennen.");
  AddDetail( ({"mystisches","etwas","fliesen"}),
	"Jetzt wo Du die Fliesen genauer betrachtest kannst Du lauter "
        "verschiedene Symbole entdecken.");
  AddDetail( ({"symbole","fliese"}),
	"Jede Fliese traegt ein eigenes Symbol. Du sieht da ein paar Wellen, "
        "daneben ein paar Muenzen, weiters ein Bierfass daneben eine "
        "Weinrebe, eine Kuh, eine Almwiese und ein seltsames Kreuz. Was das "
        "nun zu bedeuten hat?");
  AddDetail( ({"elvira","zordan"}),
	"Du beneidest die Beiden um dieses schoene Bad und denkst vielleicht "
        "sollte ich ja auch heiraten und ein Haus bauen!");
  AddDetail( ({"haus"}),
	"Naja wenn schon kein Haus dann zumindest ein grosses bad :))");
  AddDetail( ({"mechanismus"}),
	"Der Mechanismus scheint irgendwie mit den mit Symbolen verzierten "
	"Fliesen zu tun zu haben!");
  AddDetail( ({"wctuer","wc","drang","erleichterung"}),
	"Wie Du schon vermutet hast fuehrt diese WCTuer zum WC. Also wenn Du "
        "den Drang zu Erleichterung verspuerst so wage es und oeffne sie!");
  AddSound( DEFAULT_SOUND,
	"Du hoerst ein Murmeln - was das wohl sein mag?");
  AddSmell( DEFAULT_SMELL,
	"Der Duft von Badeoelen steigt Dir in die Nase.");
  AddSound( "murmeln", 
	"Du verstehst nur Wortfetzen : Gedicht rezitieren, Thema Liebe, "
        "verfuehrerische Belohnung .... kaeme auf einen Versuch drauf an "
        "denkst Du Dir und kramst in Deinem Hirn nach ein paar Versen.");
  AddDetail(({"symbol","wellen","muenzen","bierfass","fass","weinrebe",
              "rebe","kuh","almwiese","wiese","kreuz"}),
	"Als Du die Symbole so einzeln betrachtest bemerkst Du dass sie ein "
	"wenig hervorstehen...irgendwie sieht es so aus als koennte man sie "
	"hineindruecken!");

  AddSpecialDetail( "wanne","wanne_fkt");

  // hier tragen wir jetzt alle symbole ein
  ind=m_indices(symbole);
  for (i=0;i<sizeof(ind);i++) {
    AddSpecialDetail( ({ ind[i], ind[i]+"symbol" }) ,"symbole_fkt");
  }

  AddCmd( ({"oeffne"}),                            "oeffnefkt");
  AddCmd( ({"drueck","druecke"}),                  "druecken");
  AddCmd( ({"leere","entleere","entleer","leer"}), "leeren");
  AddCmd( ({ "schliesse","schliess" }), "schliessefkt" );
  AddCmd( ({ "verschliesse","verschliess" }),      "verschliessfkt" );

  AddSpecialExit("norden","nordenfkt");
}

/******************************************************
string wanne_fkt(string str)
******************************************************/

string wanne_fkt(string str) {
  if(womit == "") 
    return BS("Die Badewanne ist derzeit leider leer.");
  else 
    return BS("Die Wanne ist mit "+symbole[womit]+" gefuellt. Nun "
              "koenntest Du ein herrliches Bad nehmen.");
}

/******************************************************
string symbole()
******************************************************/

string symbole_fkt(string str) {
  if (womit == str || str == womit+"symbol") {
    return BS("Das "+CAP(womit)+"symbol ist gedrueckt und die "
              "Badewanne mit "+symbole[womit]+" gefuellt.");
  }
  if(symbole[str] == 0) str=str[0..<7];
  return BS("Das "+CAP(str)+"symbol steht leicht hervor. Man kann es "
            "eventuell hineindruecken.");
}

/******************************************************
int druecken(string str)
******************************************************/

int druecken(string str) {
  string *ind;
  ind=m_indices(symbole);
  notify_fail("Welches Symbol willst Du denn druecken?\n");
  if(str=="symbol") return 0;
  notify_fail("Was willst Du druecken?\n");
  if(!str) return 0;
  if(symbole[str] == 0) str=str[0..<7];
  if(member(ind,str) == -1) return 0;
  if(womit != "") {
    write(BS(
      "Aber die Badewanne ist schon mit "+symbole[womit]+" gefuellt!"));
    return 1;
  }
  write(BS(
    "Du drueckst das "+CAP(str)+"symbol und ploetzlich fuellt sich "
    "die Wanne mit "+symbole[str]+".\n"));
  say(BS(
    CAP_TPN+" drueckt das "+CAP(str)+"symbol und die Wanne fuellt "
            "sich mit "+symbole[str]+".\n"));
  womit=str;
  return 1;
}

/******************************************************
int entleeren(string str)
******************************************************/

int leeren(string str) {
  string temp;
  notify_fail("Was moechtest Du denn entleeren?\n");
  if( str != "wanne" && str != "badewanne") return 0;
  if (womit == "") {
    write(BS(
      "Aber die Badewanne ist doch leer!"));
    return 1;
  }
  temp=symbole[womit,1];
  write(BS(
    "Du drueckst auf den grossen roten Knopf an der Wand und mit einem "
    "lauten Blubbern verschwindet "+temp+" aus der Badewanne. "
    "Drei winzige Zwerge erscheinen und putzen die Badewanne. Jetzt ist sie "
    "bereit um mit anderen schoenen Sachen gefuellt zu werden."));
  say(BS(
    CAP_TPN+" drueckt auf den grossen roten Knopf an der Wand und mit einem "
    "lauten Blubbern verschwindet "+temp+" aus der Badewanne. "
    "Drei winzige Zwerge erscheinen und putzen die Badewanne. Jetzt ist sie "
    "bereit um mit anderen schoenen Sachen gefuellt zu werden."));
  womit="";
  return 1;
}

/******************************************************
Die Tuer zum Flur
******************************************************/

int checktuer() {
  return tuer;
}

int checkzu() {
  return verschluss;
}

void dotuer(int x) {
  tuer=x;
  if(x==0) {
    tell_room(ME,BS(
      "Jemand oeffnet die Tuer von der anderen Seite."));
  } else {
    tell_room(ME,BS(
      "Jemand schliesst die Tuer von der anderen Seite."));
  }
}

int oeffnefkt(string str) {
  notify_fail("Was moechtest Du denn gerne oeffnen?\n");
  if(!str) return 0;
  if (str == "tuer" ) {
    if(tuer) {
      write(BS(
        "Du oeffnest sanft die Tuer und kannst hinter ihr den langen "
        "Flur erkennen."));
      say(CAP_TPN+" oeffnet die Tuer zum Flur.\n");
      tuer=0;
      verschluss=0;
      return 1;
    } else {
      write(BS(
        "Aber die Tuer steht doch schon sperrangelweit offen."));
      return 1;
    }
  }
  if( member( ({"wctuer","wc"}), str) != -1) {
    write("Finsternis \n\n\n  Du faellst \n\n\n\n - Du schwebst und fuehlst "
          "die Leichtigkeit des Seins \n\n\n\n\n\n\n\n\n\n\n\n Alle Last "
          "faellt von Dir ab - Nun fuehlst Du Dich unendlich "
          "erleichtert \n\n\n\n\n\n\n\n Du landest auf einer weichen Wolke.");
    say(CAP_TPN+" verschwindet im WC und erscheint kurz darauf sichtlich "
                "erleichtert wieder.\n");
    return 1;
  }
  return 0;
}

int schliessefkt(string str) {
  notify_fail("Was moechtest Du denn gerne schliessen?\n");
  if(!str) return 0;
  if (str == "tuer" ) {
    if(tuer) {
      write(BS(
        "Aber die Tuer ist doch schon geschlossen."));
        return 1;
    } else {
      write(BS(
        "Sanft entschwebt Dir die Tuer und sie faellt zu. Du koenntest sie "
        "jetzt sogar komplett verschliessen, um Deinen Beduerfnissen "
        "in Ruhe und Gelassenheit nachzugehen."));
      say(CAP_TPN+" schliesst die Tuer zum Flur.\n");
      tuer=1;
      return 1;
    }
  }
  return 0;
}

int verschliessfkt(string str) {
  notify_fail("Was moechtest Du denn gerne verschliessen?\n");
  if(!str) return 0;
  if (str == "tuer" ) {
    if(tuer) {
      if(verschluss) {
        write(BS(
          "Die Tuer ist schon rappel zu. Niemand wird hier von der anderen "
          "Seite hereinkommen koennen."));
        return 1;
      } else {
        write(BS(
          "Du verschliesst die Tuer zum Flur von dieser Seite. Niemand wird "
          "hier mehr von der anderen Seite hereinkommen koennen."));
        say(CAP_TPN+" verschliesst die Tuer zum Flur fest.\n");
        tuer=1;
        verschluss=1;
        return 1;
      }
    } else {
      write(BS(
        "Aber die Tuer steht doch noch sperrangelweit offen. Du musst sie "
        "erst schliessen und dann verriegeln."));
      return 1;
    }
  }
  return 0;
}

// Der Ausgang nach Norden ist durch eine Tuer versperrt

nordenfkt() {
  if(tuer) {
    write(BS(
      "Die Tuer in den Flur ist derzeit geschlossen. Du musst sie vor dem "
      "Verlassen des Bades schon oeffnen."));
    return 1;
  }
  return ROOM "flur";
}
