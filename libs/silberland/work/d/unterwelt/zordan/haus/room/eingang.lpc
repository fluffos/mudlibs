
#include "../def.h"

inherit ROOM "haus_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Der Eingangsbereich in Elviras und Zordans Haus" );
  SetProp( P_INT_LONG,
    "Hier entsteht in naechster Zukunft das Wohnhaus von Elvira und Zordan. "
    "Im Moment kann man davon allerdings noch nicht viel erkennen und es "
    "liegt viel Schutt und Dreck ueberall herum. Aber die Arbeiten kommen "
    "voran. Komm doch vielleicht spaeter einmal wieder, wenn die Beiden "
    "eingezogen sind." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_HIDE_EXITS, ({ "westoben" }) );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 21, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "" }),
    "");

  AddSound( DEFAULT_SOUND,
    "");
    
  AddSmell( DEFAULT_SMELL,
    "");

//  AddExit( "norden", "./kueche" );
//  AddExit( "osten", "./wohnzimmer" );
//  AddExit( "sueden", "./flur" );
  AddSpecialExit( "norden", "nope1" );
  AddSpecialExit( "osten",  "nope2" );
  AddSpecialExit( "sueden", "nope3" );
  AddExit( "raus", "/d/unterwelt/zordan/dhrkion/room/weg-g7" );
  AddExit( "westoben", "/d/unterwelt/zordan/dhrkion/room/weg-g7" );
}

nope1() {
  if (getuid(TP) != "zordan" && getuid(TP) != "elvira" && getuid(TP) != "soia" && getuid(TP) != "verdandi") {
    write(BS(
      "Dieser Bereich des Hauses ist noch nicht der Allgemeinheit freigegeben."));
    return 1;
  }
  TP->move( ROOM "kueche", M_GO , "nach Norden");
  return 1;
}

nope2() {
  if (getuid(TP) != "zordan" && getuid(TP) != "elvira" && getuid(TP) != "soia" && getuid(TP) != "verdandi") {
    write(BS(
      "Dieser Bereich des Hauses ist noch nicht der Allgemeinheit freigegeben."));
    return 1;
  }
  TP->move( ROOM "wohnzimmer", M_GO , "nach Osten");
  return 1;
}

nope3() {
  if (getuid(TP) != "zordan" && getuid(TP) != "elvira" && getuid(TP) != "soia" && getuid(TP) != "verdandi") {
    write(BS(
      "Dieser Bereich des Hauses ist noch nicht der Allgemeinheit freigegeben."));
    return 1;
  }
  TP->move( ROOM "flur", M_GO , "nach Westen");
  return 1;
}

