#include "../def.h"

inherit "std/room";

#include <properties.h>

#define E2 "./raumE2"
#define C1 "./raumC1"

void create() 
{

  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du gehst einen schmalen, dunklen Gang entlang, der durch die Hoehle "
    "fuehrt. Die Decke ist hier sehr niedrig und gibt Dir ein etwas "
    "mulmiges Gefuehl. Die Waende rings um Dich herum sind ein wenig "
    "rauh und weisen ein paar kleinere Loecher und Spalten auf. Auf dem "
    "Boden entdeckst Du einige Spuren, die in den Westen zu fuehren scheinen.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
    "Der Gang ist hier sehr schmal und in voellige Dunkelheit getaucht. "
    "Nach Westen hin weist er ein leichtes Gefaelle auf und wird dort "
    "immer schmaler und niedriger, waehrend er im Suedosten in eine "
    "groessere Hoehle hineinfuehrt.");
  AddDetail( ({ "dunkelheit" }),
    "Es ist wirklich sehr dunkel hier im Gang. Ohne Deine Lichtquelle "
    "koenntest Du nicht einmal die Hand vor Augen sehen. Ausser "
    "natuerlich, Du bist ein Dunkelelf und kannst im Dunkeln sehen.");
  AddDetail( ({ "lichtquelle" }),
    "Was Du hier unten als Lichtquelle benutzt, musst Du schon selbst "
    "wissen.");
  AddDetail( ({ "hand" }),
    "Du bewegst Deine Hand langsam vor Deinen Augen hin und her. Du hoerst eine "
    "leise Stimme in Deinem Kopf fluestern: \"Du wirst muede...  Deine Lider werden "
    "schwer...\" Dann unterbricht ein leises Geraeusch die Leere in Deinem Kopf und "    "Du schrickst auf. Schnell konzentrierst Du Dich wieder aufs Forschen.");
  AddDetail( ({ "stimme" }),
    "Was, Du hoerst Stimmen?? Dann solltest Du dringend mal "
    "wieder Deinen Psychiater aufsuchen.");
  AddDetail( ({ "psychiater" }),
    "Vielleicht kann der Dir helfen?");
  AddDetail( ({ "augen" }),
    "Du schliesst Deine Augen und traeumst eine Weile vor Dich hin.");
  AddDetail( ({ "weile" }),
    "Eile mit Weile.");
  AddDetail( ({ "eile" }),
    "Hast Du es etwa eilig?");
  AddDetail( ({ "kopf" }),
    "Dein Kopf ist ganz leer.");
  AddDetail( ({ "lider" }),
    "Deine Lider werden schwer.");
  AddDetail( ({ "geraeusch" }),
    "War da etwas?");
  AddDetail( ({ "leere" }),
    "Nichts drin. Absolut rein gar nix.");
  AddDetail( ({ "forschen" }),
    "Na, macht das Spass? :)");
  AddDetail( ({ "spass" }),
    "Beim Forschen kann man viel Neues entdecken.");
  AddDetail( ({ "neues" }),
    "Es gibt immer wieder etwas Neues im SilberLand zu entdecken.");
  AddDetail( ({ "silberland" }),
    "Da befindest Du Dich gerade.");
  AddDetail( ({ "dunkelelf" }),
    "Dunkelelfen koennen im Dunkeln sehr gut sehen.");
  AddDetail( ({ "dunkel", "dunkeln" }),
    "Hier ist es sehr dunkel.");
  AddDetail( ({ "westen" }),
    "Im Westen faellt der Gang ein wenig ab und wird dort immer schmaler "
    "und niedriger.");
  AddDetail( ({ "gefaelle" }),
    "Es handelt sich nur um ein leichtes Gefaelle von ca. 20 bis 30 Grad.");
  AddDetail( ({ "grad" }),
    "Es koennten auch ein wenig mehr sein.");
  AddDetail( ({ "suedosten" }),
    "Im Suedosten fuehrt der Gang in eine groessere Hoehle hinein.");
  AddDetail( ({ "hoehle" }),
    "Die grosse Haupthoehle liegt in suedoestlicher Richtung, waehrend "
    "dieser Gang hier eher am Rand entlangzufuehren scheint.");
  AddDetail( ({ "haupthoehle" }),
    "Dafuer musst Du schon nach Suedosten gehen.");
  AddDetail( ({ "richtung" }),
    "Suedosten ist zum Beispiel eine.");
  AddDetail( ({ "beispiel" }),
    "Es gibt noch mehr Richtungen.");
  AddDetail( ({ "richtungen" }),
    "Nein, die zaehle ich jetzt nicht alle einzeln auf.");
  AddDetail( ({ "rand" }),
    "Dieser Gang fuehrt am Rand der Hoehle entlang.");
  AddDetail( ({ "decke" }),
    "Die Decke ist hier sehr niedrig. Dir wird ein wenig mulmig zumute.");
  AddDetail( ({ "gefuehl" }),
    "Du hast das Gefuehl, dass Dich die Decke gleich erdrueckt.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind rauh und mit kleinen Loechern und Spalten uebersaeht.");
  AddDetail( ({ "loecher" }),
    "An den Waenden befinden sich einige kleine Loecher und Spalten.");
  AddDetail( ({ "spalten" }),
    "Eine Spalte sieht anders aus als die anderen.");
  AddDetail( ({ "spalte" }),
    "Da drin scheint irgendetwas zu sein.");
  AddDetail( ({ "etwas", "irgendetwas" }),
    "Was das wohl sein koennte?");
  AddDetail( ({ "boden" }),
    "Auf dem Boden siehst Du einige Spuren, die nach Westen fuehren.");
  AddDetail( ({ "spuren" }),
    "Du siehst grosse und kleine Spuren, die von hier in den Westen zu "
    "fuehren scheinen. ");
  AddDetail( ({ "kleine spuren", "kleine spur" }),
    "Zwischen den grossen Spuren kannst Du auch ein paar kleinere "
    "entdecken.");
  AddDetail( ({ "grosse spuren", "grosse spur" }),
    "Die grossen Spuren scheinen von ein und demselbem Lebewesen zu "
    "stammen.");
  AddDetail( ({ "lebewesen" }),
    "Die Spuren stammen von einem recht grossen Lebewesen.");
  AddDetail( ({ "knochen" }),
    "Du wunderst Dich. Wie kommt denn bloss ein Knochen in die Spalte "
    "hinein? Dir faellt nur eine einzige Erklaerung dafuer ein.");
  AddDetail( ({ "erklaerung" }),
    "Ja, Du bist Dir ganz sicher. Es kann sich nur um einen echten "
    "Dinosaurierknochen handeln!");
  AddDetail( ({ "dinosaurierknochen" }),
    "Du freust Dich wahnsinnig, dass ausgerechnet DU diese "
    "sensationelle Entdeckung gemacht hast und denkst schon an die "
    "unglaublich hohe Praemie, die man Dir fuer diesen "
    "bedeutungsschweren Fund auszahlen wird.\nDu denkst . o O (Endlich "
    "kann ich die Kosten fuer mein Seherhaus abbezahlen, das ich mir "
    "eigentlich gar nicht leisten kann).");
  AddDetail( ({ "entdeckung" }),
    "Ja, das ist wirklich eine sensationelle Entdeckung, die Du da "
    "gemacht hast!");
  AddDetail( ({ "praemie" }),
    "Deine Augen verwandeln sich in blinkende Goldmuenzen.");
  AddDetail( ({ "goldmuenzen", "gold", "muenzen", "muenze", "goldmuenze" }),
    "Du kannst schon das wundervolle Klingeln unzaehliger "
    "Goldmuenzen hoeren.");
  AddDetail( ({ "fund" }),
    "Du betrachtest den Knochen noch einmal etwas genauer. Ploetzlich "
    "fallen Dir ein paar duenne Linien auf, die Du vorhin uebersehen "
    "hast.");
  AddDetail( ({ "linien" }),
    "Da scheint jemand Worte in den Knochen geritzt zu haben.");
  AddDetail( ({ "worte" }),
    "Lies sie!");
  AddDetail( ({ "kosten" }),
    "So ein Seherhaus verursacht einige Kosten.");
  AddDetail( ({ "seherhaus" }),
    "Hast Du schon eines?");
  AddDetail( ({ "hebel" }),
    "Ja, das fuehlt sich an wie ein Hebel.");

  AddReadDetail( ({ "wort", "worte" }),
    "Du liest: \"Made for Jurassic Park!\"\n" 
    "Du erbleichst, raufst Dir die Haare und rennst ein paarmal kopflos "
    "durch den Raum. Das kann doch wohl nicht wahr sein! Da hat sich "
    "jemand einen boesen Scherz mit Dir erlaubt! Wuetend wirfst Du den "
    "Knochen auf den Boden und trampelst wild darauf herum, so dass er "
    "in 1000 kleine Teilchen zerbricht.");

  AddSound( DEFAULT_SOUND,
    "Aus dem Westen dringen seltsame Geraeusche.");

  AddSound( ({ "westen" }),
    "Die Geraeusche kommen eindeutig aus dem Westen.");
  AddSound( ({ "geraeusch", "geraeusche" }),
    "Merkwuerdig, was kann das nur sein?");
  AddSound( ({ "klingeln", "goldmuenzen" }),
    "*KLING*");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig streng hier.");

  AddCmd( ({ "greife", "greif" }), "cmdgreife" );
  AddCmd( ({ "fuehle", "fuehl", "erfuehl", "erfuehle", "taste", "ertaste", "tast", "ertast" }), "cmdfuehl" );
  AddCmd( ({ "zieh", "ziehe" }), "cmdzieh" );

  AddExit( "westen", C1 );
  AddExit( "suedosten", E2 );

}
int cmdgreife(string str)
{
  notify_fail( "Worein willst Du greifen?\n" );
  if((str == "in spalte") || (str == "in spalt"))
  {
    write(BS("Du greifst in die Spalte und kannst einen laenglichen Gegenstand "
             "fuehlen."));
    say(BS(PL->Name()+" fummelt an der Wand rum.")); 
    return 1;
  }
  if((str == "in loch") || (str == "in loecher"))
  {
    write(BS("Du greifst in die Loecher findest aber nichts."));
    say(BS(PL->Name()+" fummelt an der Wand rum."));
    return -1;
  }
  return 0;
}
int cmdfuehl(string str)
{
  notify_fail( "Was willst Du fuehlen?\n" );
  if(str == "gegenstand") 
  {
    write(BS("Du umschliesst den Gegenstand mit beiden Haenden. Ob das ein Hebel "
            +"ist?"));
    say(BS(PL->Name()+" fummelt an der Wand rum.")); 
    return 1;
  }
  return 0;
}
int cmdzieh(string str)
{
  notify_fail( "Woran willst Du ziehen?\n" );
  if((str == "an hebel") || (str == "hebel"))
  {
    write(BS("Du zerrst kraeftig an dem Gegenstand herum und stellst auf "
             "einmal fest, dass es sich um einen langen, weisslichen "
             "Knochen handelt."));
    say(BS(PL->Name()+" fummelt an der Wand rum.")); 
    return 1;
  }
  return 0;
}
