#include "../def.h"

inherit "std/room";

#include <properties.h>
#define SO ROOM "raumF3"
#define O "./raumF2"
#define NW "./raumD1"
#define SW ROOM "raumD3"

object *spieler_im_netz;
string *klettern;
int netz;

void befreiungstext(object player, string str);
void SetNetz();

void create() 
{

  ::create();

  netz = DA;
  spieler_im_netz = ({ });
  klettern = ({ });

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG, "Fehler!" );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_KILL_NAME, "Eine schwere Verbrennung" );
  SetProp(P_INFO, "Eine Fackel koennte helfen das Spinnennetz zu beseitigen." );

//  SetProp(P_KILL_MSG, "");
  
  AddDetail( ({ "gang" }),
    "Der Gang fuehrt um die Saeule im Sueden herum. Im Suedwesten wird "
    "er jedoch von einem riesigen Spinnennetz eingenommen, das Dir den "
    "Weg versperrt.");
  AddDetail( ({ "saeule" }),
    "Eine riesige Saeule ragt im Sueden zur Decke hinauf. Sie hat eine "
    "glaenzende, spiegelglatte Oberflaeche und ist in der Mitte rund und "
    "schmal, waehrend sie zum Boden und zur Decke hin breiter und etwas "
    "unfoermiger wird.");
  AddDetail( ({ "decke" }),
    "Die Decke ist hier sehr hoch, so dass Du kaum etwas erkennen "
    "kannst.");
  AddDetail( ({ "waende" }),
    "Die Waende bestehen aus Vulkangestein. Die westliche Wand wird fast "
    "bis zur Decke hin von dem riesigen Spinnennetz bedeckt, das sich "
    "von dort bis zu der Saeule im Sueden hinueberzieht.");
  AddDetail( ({ "wand" }),
    "Die westliche Wand wird fast bis zur Decke hin von dem riesigen "
    "Spinnennetz bedeckt, das sich von dort bis zu der Saeule im Sueden "
    "hinueberzieht.");
  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche der Saeule glaenzt tiefschwarz und ist fast "
    "spiegelglatt. An einer Stelle sieht sie etwas seltsam aus.");
  AddDetail( ({ "stelle" }),
    "An einer Stelle weist die Oberflaeche der Saeule leichte Kratzer "
    "und Schuerfspuren auf.");
  AddDetail( ({ "schuerfspuren" }),
    "Nachdenklich laesst Du Deine Hand ueber die durch Kratzer und "
    "Schuerfspuren aufgerauhte Oberflaeche gleiten. Dein Blick geht von "
    "der Saeule zum Spinnennetz und wieder zurueck. Ob man vielleicht an "
    "der Saeule hinaufklettern und so auf die andere Seite gelangen koennte?");
  AddDetail( ({ "hand" }),
    "Noch ist Deine Hand da, wo sie hingehoert.");
  AddDetail( ({ "kratzer" }),
    "Leichte Kratzer und Schuerfspuren ueberziehen die "
    "Oberflaeche der Saeule an dieser Stelle.");
  AddDetail( ({ "blick" }),
    "Dein Blick gleitet nervoes zwischen der Saeule und dem klebrigen "
    "Spinnennetz hin und her.");
  AddDetail( ({ "mitte" }),
    "In der Mitte ist die Saeule rund und schmal, waehrend sie zum Boden "
    "und zur Decke hin breiter und unfoermiger wird.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus tiefschwarzem Vulkangestein und ist mit einer "
    "duennen Staubschicht bedeckt. Ausserdem fallen Dir ein paar "
    "merkwuerdige Flecken auf.");
  AddDetail( ({ "vulkangestein", "gestein" }),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "staubschicht", "staub" }),
    "Der Boden ist mit einer feinen Staubschicht bedeckt.");
  AddDetail( ({ "flecken" }),
    "Hmm, sieht aus wie Schleimflecken. Wo die nur herkommen?");
  AddDetail( ({ "schleimflecken" }),
    "Tatsaechlich, es handelt sich um ekligen, gruenen Schleim.");
  AddDetail( ({ "schleim" }),
    "Du kannst Dir beim besten Willen nicht vorstellen, wo der herkommt.");
  AddDetail( ({ "willen" }),
    "Du hast zwar einen starken Willen, aber wo der Schleim herkommt, "
    "weisst Du nicht.");
  AddDetail( ({ "sueden" }),
    "Im Sueden ragt eine riesige, tiefschwarz glaenzende Saeule zur "
    "Decke hinauf.");
  AddDetail( ({ "osten" }),
    "Im Osten breitet sich die Hoehle weiter aus.");
  AddDetail( ({ "gaenge" }),
    "Mehrere Gaenge zweigen von hier in verschiedene Richtungen ab.");
  AddDetail( ({ "hoehle" }),
    "Die Haupthoehle, die im Osten beginnt und hier weiterfuehrt, ist "
    "sehr gross und weitlaeufig, waehrend sie sich nach Nordwesten hin "
    "etwas verengt.");
  AddDetail( ({ "haupthoehle" }),
    "Die Haupthoehle beginnt im Osten und fuehrt hier weiter.");
  AddDetail( ({ "richtungen" }),
    "Was Richtungen sind, solltest Du aber schon wissen.");
  AddDetail( ({ "nordwesten" }),
    "Im Nordwesten fuehrt ein etwas schmalerer, dunkler Gang durch die "
    "Hoehle.");
  AddSpecialDetail( ({ "suedwesten"}), "strsuedwesten");
  AddSpecialDetail( ({ "netz", "spinnennetz", "faeden", "spinnenfaeden" }), "strnetz");
  AddSpecialDetail( ({ "weg"}), "strweg");
  AddDetail( ({ "teil" }),
    "Ein grosser Teil der Saeule und der Wand ist mit klebrigen "
    "Spinnenfaeden ueberzogen.");
  AddDetail( ({ "chance" }),
    "Aus und vorbei.");
  AddDetail( ({ "seite" }),
    "Auf der anderen Seite des Spinnennetzes gelangt man tiefer in die "
    "Hoehle hinein.");
  AddDetail( ({ "nase" }),
    "Mit Deiner Nase riechst Du fuer gewoehnlich.");
  AddDetail( ({ "treppe", "steintreppe" }),
    "Im Suedosten gelangst Du zur Steintreppe.");
  AddDetail( ({ "viere" }),
    "Du kriechst auf allen Vieren ueber den Boden.");
  AddSpecialDetail( ({ "loch" }), "strloch");
  AddDetail( ({ "bereich" }),
    "Das Loch befindet sich im unteren Bereich des Netzes, so dass Du "
    "ganz einfach hindurchgehen und nach Suedwesten gelangen kannst.");

  AddSpecialDetail( ({ "suedosten"}), "strsuedosten");
  AddSpecialDetail( ({ "lichtschimmer"}), "strlichtschimmer");
  AddSpecialDetail( ({ "licht"}), "strlicht");

  AddSound( DEFAULT_SOUND,
    "Es ist sehr still hier unten. Ab und zu glaubst Du, etwas zu "
    "hoeren, bist Dir aber nicht wirklich sicher.");
  AddSound( ({ "stille" }),
    "Hier unten ist es wirklich sehr still.");
  AddSound( ({ "etwas" }),
    "War da nicht gerade etwas? Oder hast Du Dich doch getaeuscht?");

  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht ein wenig abgestanden. Du kannst einen schwachen, "
    "leicht stechenden Geruch wahrnehmen.");
  AddSmell( ({ "geruch" }),
    "Du nimmst einen schwachen, leicht stechenden Geruch wahr, der von "
    "den Flecken am Boden auszugehen scheint.");
  AddSmell( ({ "luft" }),
    "Es war wohl schon lange niemand mehr hier unten.");
  AddSmell( ({ "schleim" }),
    "Ein schwacher, leicht stechender Geruch durchzieht den Raum. Er "
    "scheint von den merkwuerdigen Flecken am Boden auszugehen.");
  AddSmell( ({ "raum" }),
    "Ein schwacher, leicht stechender Geruch durchzieht den Raum.");
  AddSmell( ({ "flecken" }),
    "Igitt! Der Schleim stinkt!");
  AddSmell( ({ "boden" }),
    "Du laesst Dich auf alle Viere hinunter und schnueffelst mit der "
    "Nase am Boden herum. Baeh, das stinkt!");

  AddCmd( ({ "zuend", "zuende" }), "cmdanzuenden" );
  AddCmd( ({ "wische", "wisch" }), "cmdwische" );
  AddCmd( ({ "entferne", "entfern" }), "cmdentferne" );
  AddCmd( ({ "befreie", "befrei" }), "cmdbefreie" );
  AddCmd( ({ "kletter", "klettere" }), "cmdkletter" );

  AddExit ("suedwesten", ([ EX_DEST:     SW,
                            EX_TESTFUNC: "exitsw" ]) );
  AddExit ("nordwesten", ([ EX_DEST:     NW,
                            EX_TESTFUNC: "exit_test" ]) );
  AddExit ("osten", ([ EX_DEST:     O,
                            EX_TESTFUNC: "exit_test" ]) );
  AddExit ("suedosten", ([ EX_DEST:     SO,
                            EX_TESTFUNC: "exit_test" ]) );
}
string _query_int_long()
{
  string s,s2;
  object obj;
  call_other(SO, "???", 0);
  obj = find_object(SO);
  if(obj)
  {
    if(netz == DA)
      s2 = "Im Suedwesten versperrt ein riesiges klebriges Spinnennetz den Weg.";
    else
      s2 = "Im Suedwesten siehst Du ein riesiges klebriges Spinnennetz.";
    if(obj->QueryFackel())
      s = "Im Suedosten siehst Du einen schwachen Lichtschimmer, dort gelangst "
         +"Du zur Steintreppe, ";
    else
      s = "Im Suedosten gelangst Du zur Steintreppe, ";
    
      s = "Du stehst in einem breiten Gang, der um die riesige Saeule im Sueden "
         +"herumfuehrt. Es zweigen mehrere Gaenge von hier ab. "+s+"nach Osten "
         +"hin breitet sich die Hoehle weiterhin aus und nach Nordwesten "
         +"fuehrt ein etwas schmalerer, dunkler Gang weiter durch die Hoehle. "
         +s2;
  }
  else 
// Kein Sueden ... unangenehm :)
  { 
    s = "Fehler! Bitte melde ihn an Torian."; 
  }
  return BS(s);
}
string strsuedwesten(string str)
{
  string s;
  if (netz == DA)
    s = "Im Suedwesten versperrt ein riesiges klebriges Spinnennetz den Weg.";
  else
    s = "Im Suedwesten siehst Du ein riesiges klebriges Spinnennetz. Irgendjemand "
       +"hat ein grosses Loch hineingebrannt, so dass Du ungehindert dem Weg "
       +"weiter folgen kannst.";
  return BS(s);
}
string strloch(string key)
{
  string s;
  if (netz == DA)
    s = "Sowas siehst Du da nicht!"; 
  else
    s = "Im unteren Bereich des Spinnennetzes klafft ein grosses Loch. "
       +"Anscheinend hat sich dort jemand den Weg freigebrannt.";
  return BS(s);
}
string strweg(string str)
{
  string s;
  if (netz == DA)
    s = "Keine Chance, da kommst Du so nicht dran vorbei.";
  else
    s = "Der Weg nach Suedwesten ist frei.";
  return BS(s);
}
string strnetz(string str)
{
  string s, s2;
  int groesse, i;
  object player;
  s ="Ein riesiges, unheimlich klebrig aussehendes Spinnennetz ueberzieht "
    +"mit seinen langen Faeden einen grossen Teil der Saeule und der Wand";
  if (netz == DA)
  {
    s += " und versperrt so den Weg nach Suedwesten. ";
    groesse = sizeof(spieler_im_netz);
    switch(groesse)
    {
      case 0:
        s2 = " ";
        break;
      case 1:
        s2 = (spieler_im_netz[0]->Name())+" hat sich in dem Netz verfangen. Vielleicht "
             +"koenntest Du "+(spieler_im_netz[0]->QueryProp(P_GENDER)==MALE? "ihn":"sie")
             +" befreien?";
        break;
      default:
      s2 = spieler_im_netz[0]->Name();
      for (i =1; i<groesse; i++)
      {
        if(i == groesse-1)
        {
          s2 = s2+" und "+spieler_im_netz[groesse-1]->Name()+" haben sich in dem Netz "
               +"verfangen. Vielleicht koenntest Du sie befreien?";
        }
        else
        {
          s2 = s2+", "+spieler_im_netz[i]->Name();
        }
      }
    }
  }
  else
    s2 = ". Irgendjemand hat ein grosses Loch hineingebrannt.";
  return BS(s+s2);
}
string strsuedosten(string str)
{
  string s, s2;
  object obj;

  s = "Aus dem Suedosten dringt ein schwacher Lichtschimmer hierher. Dort "
     +"befindet sich wohl die Steintreppe.";
  s2 = "Im Sueden scheint sich die Steintreppe zu befinden.";
  call_other(SO, "???", 0);
  obj = find_object(SO);
  if(obj)
  {
    if (obj->QueryFackel()) { return BS(s); }
    else {return BS(s2);}
  }
  else { return "Fehler! Bitte melde ihn an Torian.\n"; }
}
string strlichtschimmer(string str)
{
  string s, s2;
  object obj;
  s = "Der Schimmer reicht nicht aus, um viel Licht zu spenden. Aber Du "
     +"glaubst, die Steintreppe, die sich im Suedosten befinden muss, "
     +"erkennen zu koennen.";
  s2 = "Sowas siehst du nicht.\n";
  call_other(SO, "???", 0);
  obj = find_object(SO);
  if(obj)
  {
    if (obj->QueryFackel()) { return BS(s); }
    else {return s2;}
  }
  else { return "Fehler! Bitte melde ihn an Torian.\n"; }
}
string strlicht(string str)
{
  string s, s2;
  object obj;
  s = "Es dringt nur sehr wenig Licht bis hierher, das nicht stark genug "
     +"ist, um diese Hoehle ausreichend zu erhellen.";
  s2 = "Sowas siehst du nicht.\n";
  call_other(SO, "???", 0);
  obj = find_object(SO);
  if(obj)
  {
    if (obj->QueryFackel()) { return BS(s); }
    else {return s2;}
  }
  else { return "Fehler! Bitte melde ihn an Torian.\n"; }
}

// Spinnennetz mit dem Staubwedel entfernen
int cmdentferne(string str)
{
  object mywedel;
  notify_fail( "Was willst Du womit entfernen?\n" );
  if(str == "netz mit staubwedel" || str == "netz mit wedel"
  || str == "spinnennetz mit staubwedel" || str == "spinnennetz mit wedel")
  {
    mywedel = present("staubwedel", PL);
    if( mywedel )
    {
      if(netz == DA)
      {
        say(BS( PL->name()+" versucht, die Spinnenweben mit einem "
                          +"Staubwedel zu entfernen.") );
        write(BS("Du versuchst, das riesige Spinnennetz mit Deinem winzigen "
                +"Staubwedel zu entfernen, musst dann jedoch leider erkennen, dass "
                +"dies wohl ein recht sinnloses Unterfangen ist. Zu allem Uebel "
                +"bleibt der Staubwedel auch noch in dem Netz haengen und "
                +"verschwindet spurlos hinter den unzaehligen Spinnenfaeden."));
        mywedel->remove();
        return 1;
      }
      else
      {
        say(BS( PL->name()+" fuchtelt mit einem Staubwedel herum.") );
        write(BS("Kein Netz da!"));
        return -1;
      }
    }
    say(BS( PL->name()+" schaut irritiert aus der Waesche."));
    write(BS("Du vollfuehrst magische Bewegungen und versuchst Dir einen "
            +"Staubwedel herbeizuzaubern. Leider versagst Du auf ganzer "
            +"Linie!"));
    return -1;
  }
  return 0;
}

// andere Spieler versuchen zu befreien aus dem Netz
int cmdbefreie(string str)
{
  object player;
  notify_fail( "Wen willst Du befreien?\n" );
  if (!stringp(str)) { return 0; }

  if(member(spieler_im_netz,TP) != -1 )
  {
    if(str == "dich" || str == lower_case(getuid(TP)))
    {
      write(BS("Du versuchst, Dich aus dem Netz zu befreien, verhedderst Dich "
            +"jedoch immer mehr und mehr in den klebrigen Faeden."));
      say(BS(PL->Name()+" versucht verzweifelt, sich aus dem Netz zu befreien, "
                       +"verheddert sich jedoch nur noch mehr in den klebrigen "
                       +"Faeden."));
      return 1;
    }
    else 
    {
      write(BS("Du solltest erstmal versuchen Dich selbst zu befreien!"));
      return -1;
    }
  }
  player = find_living(str);
  if(!player) return 0;
  if(member(spieler_im_netz,player) != -1)
  {
    say(BS( PL->name()+" versucht, "+CAP(str)+" aus dem Netz zu befreien, "
          +"bleibt jedoch ebenfalls daran haengen."));
    write(BS("Du versuchst, "+CAP(str)+" aus dem Netz zu befreien, bleibst "
          +"jedoch an den klebrigen Faeden haengen!"));
    spieler_im_netz += ({ TP });
    return 1;
  }
  return 0;
}
// Funktion zum setzen des Netzstatuses, noetig fuer Synchronisation mit 
// raumD3
void SetNetz()
{
  if(netz == DA)
    netz = WEG;
  else
    netz = DA;
  return;
}
// Aufgerufen aus raumD3 wenn dort das Netz angezuendet wird
// Alle die hier im Netz haengen werden befreit und bekommen weniger Schaden 
// (Feuer aus dem anderen Raum)
void VerbrenneNetz()
{
   string s, name;
   int groesse, i;
   object spieler;
   s = "";
   name = "Von der anderen Seite zuendet jemand";
     // wer haengt alles im Netz?
     groesse = sizeof(spieler_im_netz);
     switch(groesse)
     {
       case 0:
         break;
       case 1:
         spieler = spieler_im_netz[0];
         if(spieler)
         {
           s = spieler->Name()+" schreit angstvoll auf, als die Flammen "
               +(spieler->QueryProp(P_GENDER)==MALE? "seine":"ihre")+ " Haut "
               +"verbrennen. ";
// fuer den spieler im netz der text, andere interessieren ihn nicht
           spieler->do_damage(30+random(30), this_object());
           if(spieler == TP) { name = "Von der anderen Seite zuendet jemand"; }
           befreiungstext(spieler, name);
         }
         break;
       default: // mehr als einer im netz
         s = spieler_im_netz[0]->Name();
// Wer im Netz haengt bekommt etwas von der Flamme ab ....
// Jedem Spieler im Netz seinen eigenen Befreiungstext geben
         spieler = spieler_im_netz[0];
         if(spieler)
         {
           spieler->do_damage(30+random(30), this_object());
           if(spieler == TP) { name = "Von der anderen Seite zuendet jemand"; }
           befreiungstext(spieler, name);
         }
         for (i =1; i<groesse; i++)
         {
           spieler = spieler_im_netz[i];
           if(spieler)
           {
              spieler->do_damage(30+random(30), this_object());
              if(spieler == TP) { name = "Von der anderen Seite zuendet jemand"; }
              befreiungstext(spieler, name);
           }
// Fuer den Anzuender die Liste der Spieler im Netz erstellen
           if(i == groesse-1)
           {
             s = s+" und "+spieler_im_netz[groesse-1]->Name()+" schreien angstvoll "
                  +"auf, als die Flammen ihre Haut verbrennen, doch Du "
                  +"kuemmerst Dich nicht drum. ";
           }
           else
           {
             s = s+", "+spieler_im_netz[i]->Name();
           }
         }
         break;
     }
// damit er tell_room nicht sieht
// wer im Netz haengt hat bereits seine Meldung
     tell_room(TO,BS( "Von der anderen Seite wird zuendet jemand das Spinnennetz "
           +"mit einer Fackel an. "
           +"Eine heisse Stichflamme schiesst hinauf und die Faeden beginnen zu "
           +"brennen. "+s+"Als die Flammen erloschen sind, siehst Du, "
           +"dass ein grosses Loch entstanden ist, durch das man nun "
           +"auf die andere Seite gelangen kann."), spieler_im_netz);
  // Netz aufraeumen
  spieler_im_netz = ({ });
  SetNetz(); // Netz entfernen
  return;
}


// verdammt unelegant ... bleibt erstmal so bis mir was besseres einfaellt
int cmdanzuenden(string str)
{
   string s, name;
   int groesse, i;
   object fackel, spieler, dest;
   s = "";
   name = TP->Name()+" zuendet";
   notify_fail( "Was willst Du womit anzuenden?\n" );
// nicht folstaendige syntax
   if ((str == "netz an") || (str == "spinnennetz an"))
   {
     if(netz == WEG ) 
     {
       write(BS("Das Netz wurde bereits angezuendet!"));
       return -1;
     } 
     write(BS("Womit willst du das Spinnennetz anzuenden?"));
     return -1;
   }
// richtige syntax
   if ((str == "netz mit fackel an") || (str == "spinnennetz mit fackel an"))
   {
// netz ueberhaupt da ?
     if(netz == WEG ) 
     {
       write(BS("Das Netz wurde bereits angezuendet!"));
       return -1;
     } 
// fackel auch da ?
     fackel = present("fackel",TP);
     if( !fackel )
     {
       write(BS("Du hast gar keine Fackel!"));
       return -1;
     } 
// mit einer erloschenen fackel kann man nix abfackeln
     if(!(fackel->_query_lighted()))
     {
       write(BS("Wie waers mit einer angezuendeten Fackel?"));
       return -1;
     }

     groesse = sizeof(spieler_im_netz);
     switch(groesse)
     {
       case 0:
         break;
       case 1:
         spieler = spieler_im_netz[0];
         if(spieler)
         {
           s = spieler->Name()+" schreit angstvoll auf, als die Flammen "
               +(spieler->QueryProp(P_GENDER)==MALE? "seine":"ihre")+ " Haut "
               +"verbrennen, doch Du kuemmerst Dich nicht darum. ";
// fuer den spieler im netz der text, andere interessieren ihn nicht
           spieler->do_damage(30+random(30), this_object());
           if(spieler == TP) { name = "Du zuendest"; }
           befreiungstext(spieler, name);
         }
         break;
       default: // mehr als einer im netz
         s = spieler_im_netz[0]->Name();
// Wer im Netz haengt bekommt etwas von der Flamme ab ....
// Jedem Spieler im Netz seinen eigenen Befreiungstext geben
         spieler = spieler_im_netz[0];
         if(spieler)
         {
           spieler->do_damage(30+random(30), this_object());
           if(spieler == TP) { name = "Du zuendest"; }
           befreiungstext(spieler, name);
         }
         for (i =1; i<groesse; i++)
         {
           spieler = spieler_im_netz[i];
           if(spieler)
           {
              spieler->do_damage(30+random(30), this_object());
              if(spieler == TP) { name = "Du zuendest"; }
              befreiungstext(spieler, name);
           }
// Fuer den Anzuender die Liste der Spieler im Netz erstellen
           if(i == groesse-1)
           {
             s = s+" und "+spieler_im_netz[groesse-1]->Name()+" schreien angstvoll "
                  +"auf, als die Flammen ihre Haut verbrennen, doch Du "
                  +"kuemmerst Dich nicht drum. ";
           }
           else
           {
             s = s+", "+spieler_im_netz[i]->Name();
           }
         }
         break;
     }
// wenn der Spieler im netz haengt gibs nen text fuer ihn, andere spieler
// interessieren ihn nicht
     if(member(spieler_im_netz,TP) == -1)
     {
     write(BS("Du haeltst die Fackel vorsichtig an das Netz heran. "
             +"Ploetzlich schiesst eine heisse Stichflamme hinauf und "
             +"die Faeden beginnen zu brennen. "+s+"Nach einigen Minuten "
             +"ist das Netz im unteren Bereich voellig verbrannt. Durch "
             +"das entstandene Loch kannst Du nun auf die andere Seite "
             +"gelangen."));
     }
// damit er tell_room nicht sieht
// wer im Netz haengt hat bereits seine Meldung
     spieler_im_netz += ({ TP });
     tell_room(TO,BS(PL->Name()+" zuendet das Spinnennetz mit einer Fackel an. "
           +"Eine heisse Stichflamme schiesst hinauf und die Faeden beginnen zu "
           +"brennen. "+s+"Als die Flammen erloschen sind, siehst Du, "
           +"dass ein grosses Loch entstanden ist, durch das man nun "
           +"auf die andere Seite gelangen kann."), spieler_im_netz);
// nix netz -> nix spieler im netz
     spieler_im_netz = ({ });
     SetNetz(); // Netz entfernen
     call_other(SW, "SetNetz", 0); // auch im angrenzenden Raum
     dest = find_object(SW); // Andern Raum noch mitteilen was los ist 
     if(dest)
     {
       tell_room(dest, "Von der anderen Seite wird ein Loch in das Netz gebrannt.\n");
     }

     return 1;
   }
   return 0;
}

// Staub wegwischen
int cmdwische(string str )
{
  notify_fail( "Was willst Du wegwischen?\n" );
  if(-1 == member(({"staub","staubschicht","staub weg","staubschicht weg"}),str))
  { return 0; }
  write(BS("Du wirbelst etwas Staub auf, der sich jedoch gleich wieder legt."));
  say( BS(PL->name()+" wirbelt etwas Staub auf, der sich jedoch gleich wieder "
                    +"legt."));
  return 1;
}

// Klettern (uebers netz) mit Sequenz
int cmdkletter(string str )
{
  notify_fail( "Woran moechtest Du hinaufklettern?\n" );
  if(str != "an saeule hinauf") { return 0; }

// wer im netz haengt kann nicht klettern
  if(member(spieler_im_netz,TP) != -1)
  {
    write( BS("Du haengst noch im Netz fest! Versuch lieber, Dich zu befreien!"));
    return -1;
  }
  if(netz != DA)
  {
    write(BS("Da bereits ein grosses Loch in das Netz gebrannt wurde, entschliesst Du "
            +"Dich lieber doch nicht zu klettern."));
    return -1;
  }
// wir klettern somit koennen wir den raum nicht verlassen 
  klettern += ({ getuuid(TP) });
  write(BS("Du nimmst all Deinen Mut zusammen und beginnst vorsichtig, die "
          +"Saeule hinaufzuklettern."));
  say( BS(PL->name()+" beginnt, an der Saeule hinaufzuklettern."));
  call_out("abrutschen",5);
  return 1;
}

// Sequenz abrutschen -> abrutschen3
void abrutschen()
{
  if ((PL->QueryAttribute(A_DEX)+random(10)) < 28)
  {
    write(BS("Du bist schon ein gutes Stueckchen vorangekommen, als Du "
            +"ploetzlich abrutschst und bei Deinem panischen Versuch, nicht "
            +"hinunterzustuerzen, mit einem Bein an dem Spinnennetz "
            +"klebenbleibst."));
    say(BS("Nach ein paar Metern erfolgreichen Kletterns rutscht "+PL->Name()
          +" ab und bleibt an dem Spinnennetz kleben."));
    spieler_im_netz += ({ TP });
    call_out("abrutschen2",6);
  }
  else
  {
    write(BS("Du bist schon ein gutes Stueckchen vorangekommen, als Du "
            +"ploetzlich abrutscht und dem klebrigen Spinnennetz gefaehrlich "
            +"nahekommst."));
    say( BS("Nach ein paar Metern erfolgreichen Kletterns rutscht "+PL->Name()
           +" ab und kommt dem Spinnennetz gefaehrlich nahe."));
    call_out("abrutschen2",6);
  }
}

void abrutschen2()
{
  if(member(spieler_im_netz,TP) != -1)
  {
    write(BS("Hilflos zappelst Du eine Weile herum und verhedderst Dich immer "
            +"mehr in den Faeden."));
    say(BS( PL->Name()+" zappelt hilflos herum und verheddert sich so nur "
                       +"noch mehr in den klebrigen Faeden."));
    klettern -= ({ getuuid(TP) });
  }
  else
  {
    write(BS("Einen Moment lang ueberkommt Dich die blanke Panik, doch dann "
            +"gelingt es Dir, Dich weit genug von dem Netz zu entfernen."));
    say(BS("Einige Sekunden lang zappelt "+PL->Name()+" wild rum, dann gelingt "
          +"es "+(PL->QueryProp(P_GENDER)==MALE? "ihm":"ihr")+", sich "
          +"festzuhalten."));
    call_out("abrutschen3",4);
  }
}

void abrutschen3()
{
  write(BS("Mit klopfendem Herzen laesst Du Dich wieder an der Saeule "
          +"hinabgleiten. Vielleicht solltest Du Dir doch lieber einen anderen "
          +"Weg suchen, um auf die andere Seite zu gelangen."));
  say(BS("Mit enttaeuschtem Gesicht gleitet "+PL->Name()+" wieder zu Boden."));
  klettern -= ({ getuuid(TP) });
}

int exitsw(string dir)
{
  if(member(spieler_im_netz,TP) != -1)
  {
    write( BS("Du haengst noch im Netz fest! Versuch lieber, Dich zu befreien!"));
    return 0;
  }
  if(member(klettern,getuuid(TP)) != -1)
  {
    write(BS("Du kletterst doch gerade!"));
    return 0;
  }
  if (netz == DA)
  {
    if(!TP)              return 0;
    if(!interactive(TP)) return 0;
    spieler_im_netz += ({ TP });
    write(BS("Du versuchst, nach Suedwesten zu gehen, bleibst aber im Netz "
            +"haengen."));
    say(BS( PL->Name()+" versucht nach Suedwesten zu gehen und bleibt "
                       +"klaeglich im Netz haengen."));
    return 0;
  }
  else
    return 1;
}

int exit_test(string dir)
{

// nicht festklebende Spieler duerfen ...
  if(member(spieler_im_netz, TP) == -1) 
  {
// sofern sie nicht grade klettern ...
    if(member(klettern, getuuid(TP)) == -1) 
      return 1;
    else 
      write( BS("Du kletterst doch gerade!"));
    return 0;
  }
  else
    write( BS("Du haengst noch im Netz fest! Versuch lieber, Dich zu befreien!"));
 
  return 0;
}

// Hilfsfunktion fuers Anzuenden
// nicht optimal da der anzuender diesen text ebenfalls sieht sofern er im Netz
// haengt - andernfalls nen haufen mehr ifs und ein weiterer 10 zeilen textblock
void befreiungstext(object player, string str)
{
  tell_object(player,BS(str+" das Spinnennetz mit "
             +"einer Fackel an. Eine heisse Stichflamme schiesst hinauf und "
             +"die Faeden beginnen zu brennen. Angstvoll schreist Du auf, als "
             +"die kochende Hitze Deine Haut verbrennt. Als die Flammen "
             +"erloschen sind, siehst Du, dass ein grosses Loch entstanden ist, "
             +"durch das man nun auf die andere Seite gelangen kann. Die Faeden "
             +"um Dich herum sind voellig verbrannt, so dass Du sie einfach zur "
             +"Seite schieben und Dich aus dem Netz befreien kannst."));
}

reset()
{
  object dest;

  ::reset();
  if(netz == WEG)
  {
    tell_room(this_object(), "Das Netz im Suedwesten wird von der anderen Seite "
                            +"neu gesponnen.\n");
    SetNetz();
    call_other(SW, "SetNetz",0);
    dest = find_object(SW);
    if(dest)
    {
      tell_room(dest, "Das Netz im Nordosten wird von der anderen Seite "
                     +"neu gesponnen.\n");
    }
  }

}

// hier muss ich mir noch was fuer die spieler ausdenken die ausgelogt waren ...
void BecomesNetDead(object player)
{
  if(member(spieler_im_netz, player) != -1) 
  {
    spieler_im_netz -= ({ player });
    tell_room(TO,player->Name()+" erschlaft im Netz.\n");
  }
  if(member(klettern, getuuid(player)) != -1)
  {
    klettern -= ({ getuuid(player) });
    tell_room(TO,player->Name()+" rutscht von der Saeule herunter.\n");
  } 
}

// wer auslogte um dem netz zu entkommen haengt wieder drin, andere haben 
// pech gehabt ;-)
void BecomesNetAlive(object player)
{
  if(netz == DA)
  {
    write(BS("Du stolperst und versuchst Dich irgendwo festzuhalten. "
            +"Verzweifelt greifst Du um Dich und tatsaechlich kannst Du Dich "
            +"an einem Spinnennetz festhalten."));
    say(BS(PL->Name()+" stolpert und versucht sich verzweifelt am Spinnennetz "
                     +"festzuhalten."));
    spieler_im_netz += ({ player });
  }
}

void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
// Tote klettern nicht und kleben auch nimmer fest
  spieler_im_netz -= ({ player });
  klettern -= ({ getuuid(player) });
}
