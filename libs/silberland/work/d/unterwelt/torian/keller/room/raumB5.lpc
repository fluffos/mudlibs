
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define NO "./raumC4"
#define W "./raumA5"
#define NW "./raumA4"

int stein;
string ohren();


void create() 
{

  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du laeufst einen breiten Gang entlang, der nach Westen und "
    "Nordosten weiterfuehrt und sich im Nordwesten zu einer groesseren "
    "Hoehle ausweitet. Hier ist es ziemlich dunkel und Du kannst die "
    "Waende rechts und links von Dir nur schwach erkennen." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
    "Du stehst in einem breiten, dunklen Gang, der von hier sowohl nach "
    "Westen als auch nach Nordosten weiterfuehrt. Nordwestlich von Dir "
    "weitet er sich zu einer groesseren Hoehle aus.");
  AddDetail( ({ "westen" }),
    "Der Gang fuehrt nach Westen weiter. Es sieht allerdings fast so "
    "aus, als wuerde er dort schon nach einem kurzen Stueck abrupt "
    "aufhoeren. Ob der Gang dort eingestuerzt ist?");
  AddDetail( ({ "stueck" }),
    "Der Gang fuehrt im Westen nur ein kleines Stueck weiter. Es scheint "
    "dort einen Einsturz gegeben zu haben.");
  AddDetail( ({ "einsturz" }),
    "Beim genaueren Hinsehen kannst Du einige grosse Steinbrocken "
    "erkennen, die dort aus der Wand herausgebrochen sind.");
  AddDetail( ({ "hinsehen" }),
    "Du kneifst Deine Augen zusammen und versuchst, etwas Genaueres zu erkennen.");
  AddDetail( ({ "augen", "auge" }),
    "Du blinzelst.");
  AddDetail( ({ "genaueres" }),
    "Um Genaueres zu sehen, solltest Du dem Gang nach Westen folgen.");
  AddDetail( ({ "steinbrocken", "brocken" }),
    "Im Westen kannst Du einige Steinbrocken erkennen, die dort aus der "
    "Wand herausgebrochen sind.");
  AddDetail( ({ "wand" }),
    "Aus der Wand im Westen sind Steinbrocken herausgebrochen, die dort "
    "nun auf dem Boden verstreut sind.");
  AddDetail( ({ "nordwesten" }),
    "Im Nordwesten weitet sich der Gang zu einer grossen Hoehle aus.");
  AddDetail( ({ "hoehle" }),
    "Nordwestlich von Dir befindet sich eine grosse Hoehle. Wenn Du "
    "willst, kannst Du ja mal hingehen.");
  AddDetail( ({ "waende" }),
    "Der Gang ist hier recht breit, da zwischen den Waenden mindestens "
    "drei bis vier Meter Platz sind. An der Suedwand faellt Dir etwas "
    "auf.");
  AddDetail( ({ "meter" }),
    "Die Waende sind mindestens drei bis vier Meter voneinander entfernt.");
  AddDetail( ({ "platz" }),
    "Du streckst Deine Arme weit aus und drehst Dich ein "
    "paarmal im Kreis. Ja, hier ist mehr als genug Platz fuer Dich.");
  AddDetail( ({ "arme" }),
    "Du streckst Deine Arme weit von Dir und wedelst ein wenig "
    "damit in der Luft herum.");
  AddDetail( ({ "kreis" }),
    "Du drehst Dich ein paarmal um Dich selbst herum.");
  AddDetail( ({ "luft" }),
    "Du versuchst, ein wenig Luft mit Deinen Haenden "
    "einzufangen, doch sie schafft es immer wieder, Dir zu entweichen.");
  AddDetail( ({ "haende", "haenden" }),
    "Du fuchtelst wild in der Luft herum.");
  AddDetail( ({ "suedwand" }),
    "Ein langer rostiger Hebel ragt aus der Suedwand heraus.");
  AddDetail( ({ "hebel" }),
    "Der Hebel ist etwas verrostet. Ob man ihn irgendwie bewegen kann?");
  AddDetail( ({ "etwas" }),
    "Ein Hebel ragt aus der suedlichen Wand heraus.");
  AddDetail( ({ "nordosten" }),
    "Nach Nordosten fuehrt der Gang weiter.");
  AddDetail( ({ "boden" }),
    "Der Boden ist ein wenig mit Staub und kleinen Steinkoernchen bedeckt.");
  AddDetail( ({ "staub" }),
    "Der Boden ist etwas staubig.");
  AddDetail( ({ "steinkoernchen", "koernchen" }),
    "Viele kleine Steinkoernchen liegen hier auf dem Boden herum. Die "
    "sind wohl durch den Einsturz im Westen bis hierher gerollt.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus schwarzem Vulkangestein. In einer Ecke "
    "haengen ein paar lose, duenne Spinnweben herunter.");
  AddDetail( ({ "ecke" }),
    "In einer Ecke an der Decke kannst Du einige duenne Spinnweben "
    "erkennen, die lose herunterhaengen.");
  AddDetail( ({ "spinnweben" }),
    "Die Spinnweben haengen lose von der Decke herunter und bewegen sich "
    "bei jedem kleinen Luftzug ein wenig.");
  AddDetail( ({ "luftzug" }),
    "Wenn Du Dich bewegst, verursachst Du einen sehr schwachen Luftzug.");
  AddDetail( ({ "vulkangestein", "gestein" }),
    "Schwarzes, fast glasartiges Vulkangestein.");

  AddSpecialDetail( ({ "steinchen"}), "strsteinchen");

  AddSound( DEFAULT_SOUND,
    "Du spitzt Deine Ohren und lauscht aufmerksam in alle "
    "Richtungen. Hoeren kannst Du allerdings ... nichts.");

  AddSound( ({ "ohren" }),
    ([ 0: #'ohren, // Der Defaulttext
      "dunkelelf": "Du hast wunderschoene, spitze Ohren.\n",
      "elf":  "Du hast wunderschoene, spitze Ohren.\n" ]) );

  AddSound( ({ "richtungen" }),
    "Es riecht in allen Richtungen genau gleich. Naemlich nach gar nichts.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig staubig hier.");

  AddSmell( ({ "staub" }),
    "Das lass mal lieber bleiben, sonst musst Du bloss niesen.");

  AddExit( "nordosten", NO );
  AddExit( "nordwesten", NW );
  AddExit( "westen", W );
  
  AddCmd( ({ "zieh", "ziehe" }), "cmdziehe" );
  AddCmd( ({ "bewege", "beweg" }), "cmdbewege" );
  AddCmd( ({ "kuschel", "kuschl", "kuschele" }), "cmdkuschel" );
  AddCmd( ({ "entferne", "entfern" }), "cmdentfernen" );
  AddCmd( ({ "wische", "wisch" }), "cmdwische" );

  
  AddItem(NPC "hoehlenechse", REFRESH_DESTRUCT, 
          ([P_MNPC_DEFAULTROOM : ROOM "raumB5" ]) );

  stein = DA;
}

string strsteinchen(string str)
{
  string s;

  if (stein == DA)
    s = "Wenn man das Steinchen bloss irgendwie da wegkriegen koennte...";
  else
    s = "Was fuer ein Steinchen meinst Du denn?";
  return BS(s);
}

// Staub wischen
int cmdwische(string str )
{
  notify_fail( "Was willst Du wegwischen?\n" );
  if(-1 == member(({"staub","staub weg"}),str))
  { return 0; }
  write(BS("Du wirbelst etwas Staub auf, der sich jedoch gleich wieder legt."));
  say( BS(PL->name()+" wirbelt etwas Staub auf, der sich jedoch gleich wieder "
                    +"legt."));
  return 1;
}

// Hebel "bewegen"
int cmdbewege(string str )
{
  notify_fail( "Was willst Du bewegen?\n" );
  if(str == "hebel")
  {
    write(BS("Was ist denn \"bewegen\" fuer eine Aktion? Ziehen oder eng "
             "an den Hebel ankuscheln oder was???"));
    return 1;
  }
  return 0;
}

int cmdkuschel(string str)
{
  notify_fail( "An wen willst Du Dich ankuscheln?\n" );
  if(str == "hebel")
  {
    write(BS("Jemand kommt vorbei und haut Dir eine runter!"));
    TP->AddHp(-30 - random(10));
    return 1;
  }
  return 0;
}
// Hebel ziehen
int cmdziehe(string str)
{
  notify_fail( "Woran willst Du ziehen?\n" );
  if(stein == DA)
  {
    if(str == "hebel")
    {
        say(BS( PL->name()+" zieht an dem Hebel.") );
        write(BS("Du ziehst versuchsweise an dem Hebel, doch er scheint zu klemmen. "
                +"Vielleicht solltest Du etwas kraeftiger ziehen?"));
        return 1;
    }
    if(str == "kraeftiger an hebel" || str == "kraeftig an hebel"
    || str == "kraeftiger am hebel" || str == "kraeftig am hebel")
    {
        say(BS( PL->name()+" zieht kraeftiger an dem Hebel.") );
        write(BS("Mit aller Kraft ziehst und zerrst Du an dem Hebel herum. Keine "
                +"Chance. Verzweifelt laesst Du Deinen Blick ueber den Hebel "
                +"schweifen. Da scheint sich ein Steinchen zwischen Wand und "
                +"Hebel verklemmt zu haben."));
        return 1;
    }
  }
  else
  {
    if(str == "hebel" || str == "kraeftiger an hebel" 
    || str == "kraeftig an hebel" || str == "kraeftiger am hebel" 
    || str == "kraeftig am hebel")
    {
        say(BS( PL->name()+" zieht an dem Hebel.") );
        write(BS("Der Hebel laesst sich problemlos hinunterdruecken. Du wartest "
                +"gespannt. Und wartest... und wartest... Irgendwie hat "
                +"das wohl nichts gebracht. Schade, die ganze Muehe war umsonst."));
        return 1;
    }
  }
  return 0;
}

// Steinchen entfernen
int cmdentfernen(string str)
{
  notify_fail( "Willst Du entfernen?\n" );
  if(str == "steinchen")
  {
  	if(stein == WEG)
  	{
      write(BS("Aber da ist doch gar kein Steinchen?"));
      return -1;
    }
    else
    {
      say(BS( PL->name()+" fummelt an der Wand herum.") );
      write(BS("Du broekelst ein wenig an der Wand herum und haeltst "
              +"schliesslich das kleine Steinchen in der Hand. Da Du damit " 
              +"nichts weiter anfangen kannst, wirfst Du es in irgendeine "
              +"Ecke. Nun sollte sich der Hebel ohne Probleme bewegen lassen."));
      stein = WEG;
      return 1;
    }
  }
  if(str == "spinnweben" || str == "weben" || str == "spinnweben mit wedel"
  || str == "spinnweben mit staubwedel" || str == "weben mit wedel"
  || str == "weben mit staubwedel")
  {
  	write(BS("Die paar Spinnweben lohnen wirklich nicht."));
    return -1;
  }
  return 0;
}

reset()
{
  ::reset();

  stein = DA;
}

string ohren()
{
  string s;
  s = "Auch wenn Deine Ohren nicht so schoen spitz sind wie die "
     +(PL->QueryProp(P_GENDER)==MALE?"eines Elfen":"einer Elfe")+", sind "
     +"sie fuer "+(PL->QueryProp(P_GENDER)==MALE?"einen ":"eine ")
     +(PL->QueryProp(P_RACE))+" doch voellig in Ordnung.\n";
  return s;
}