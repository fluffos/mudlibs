#include "../def.h"

inherit "std/room";

#include <properties.h>

#define F2 "./raumF2"

int spinnwebe, klappe, knopf, staub;

string klappe();
void create() 
{

  ::create();

  spinnwebe = DA;
  klappe = DA;
  knopf = DA;
  staub = DA;

  SetProp( P_INT_SHORT, "In einer kleinen Hoehle" );
  SetProp( P_INT_LONG,
    "Du tastest Dich langsam den schmalen Gang entlang und gelangst in "
    "eine kleinere, unbeleuchtete Hoehle. Im Gegensatz zu der grossen "
    "Hoehle, aus der Du gerade gekommen bist, ist es hier recht staubig. "
    "An den Waenden und an der Decke haengen Spinnenweben, deren "
    "Bewohner allerdings wohl schon lange nicht mehr zu leben scheinen. "
    "Im Sueden kannst Du wieder zurueck in die Haupthoehle gehen." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
    "Der Gang ist sehr schmal und niedrig, so dass grosse Leute nur mit "
    "Muehe hindurchpassen.");
  AddDetail( ({ "leute" }),
    "Leute wie Du und ich.");
  AddSpecialDetail( ({ "du" }), "strDu");
  AddDetail( ({ "ich" }),
    "Da ich nicht hier bin, kannst Du mich auch nicht untersuchen. ;)");
  AddDetail( ({ "muehe" }),
    "Du ziehst Deinen Bauch ein und haeltst angestrengt die Luft an.");
  AddDetail( ({ "bauch", "baeuchlein" }),
    ([0: "Du betrachtest Deinen Bauch, kannst aber nichts besonderes entdecken.",
      "zwerg": "Du begutachtest Deinen durch ehrliche, harte Arbeit "
               "gekraeftigten Koerper und denkst . o O (Genau richtig, "
	       "wie es sich fuer einen Zwerg gehoert.).",
      "oger": "Dein Magen knurrt.",
      "troll": "Dein Magen knurrt.",
      "dunkelelf": "Bewundernd schaust Du an Deiner schlanken Gestalt herunter. "
             "Wie gut Du heute wieder mal aussiehst!",
      "fee": "Bewundernd schaust Du an Deiner schlanken Gestalt herunter. "
             "Wie gut Du heute wieder mal aussiehst!",
      "elf": "Bewundernd schaust Du an Deiner schlanken Gestalt herunter. "
             "Wie gut Du heute wieder mal aussiehst!",
      "hobbit": "Zufrieden taetschelst Du Dein rundes Baeuchlein und denkst "
                "sehnsuechtig an Deine letzte Mahlzeit." ]) );
  AddDetail( ({ "arbeit", "koerper" }),
    ([0: "Sowas siehst Du da nicht!",
      "zwerg": "Harte Arbeit staehlt den Koerper." ]) );
  AddDetail( ({ "zwerg" }),
    ([0: "Sowas siehst Du da nicht!",
      "zwerg": "Sieh Dich doch an!" ]) );
  AddDetail( ({ "magen" }),
    ([0: "Sowas siehst Du da nicht!",
      "oger":  "*KNURR*",
      "troll": "*KNURR*" ]) );
  AddDetail( ({ "gestalt" }),
    ([0: "Sowas siehst Du da nicht!",
      "fee": "Nur schwer kannst Du Deinen Blick wieder von Dir loesen.", 
      "dunkelelf": "Nur schwer kannst Du Deinen Blick wieder von Dir loesen.", 
      "elf": "Nur schwer kannst Du Deinen Blick wieder von Dir loesen." ]) );
  AddDetail( ({ "blick" }),
    ([0: "Sowas siehst Du da nicht!",
      "fee": "Unwillig wendest Du Deinen Blick wieder auf Deine Umgebung.", 
      "dunkelelf": "Unwillig wendest Du Deinen Blick wieder auf Deine Umgebung.", 
      "elf": "Unwillig wendest Du Deinen Blick wieder auf Deine Umgebung." ]) );
  AddDetail( ({ "umgebung" }),
    ([0: "Sowas siehst Du da nicht!",
      "fee": QueryProp(P_INT_LONG),
      "dunkelelf": QueryProp(P_INT_LONG), 
      "elf": QueryProp(P_INT_LONG) ]) );
  AddDetail( ({ "Mahlzeit" }),
    ([0: "Sowas siehst Du da nicht!",
      "hobbit": "Die ist schon viel zu lange her." ]) );
  AddDetail( ({ "luft" }),
    "Du laeufst ja schon ganz blau an! Schnell sperrst Du Deinen Mund "
    "weit auf und laesst gierig die frische Luft in Deine Lungen "
    "stroemen.");
  AddDetail( ({ "mund" }),
    "Dein Mund steht sperrangelweit offen.");
  AddDetail( ({ "lungen" }),
    "Deine Lungen brennen.");
  AddDetail( ({ "hoehle" }),
    "Diese Hoehle ist ziemlich klein und dunkel.");
  AddDetail( ({ "sueden" }),
    "Suedlich von Dir liegt die grosse Haupthoehle, aus der Du hierher "
    "gekommen bist.");
  AddDetail( ({ "haupthoehle" }),
    "Die liegt im Sueden.");
  AddDetail( ({ "gegensatz" }),
    "Im Gegensatz zu der Haupthoehle ist es hier recht staubig.");
  AddSpecialDetail( ({ "stelle" }), "strstelle");

  AddDetail( ({ "staub" }),
    "Der Boden ist mit einer dicken Staubschicht bedeckt.");
  AddDetail( ({ "staubschicht" }),
    "Du malst ein paar kleine Kreise in den Staub.");
  AddDetail( ({ "kreise" }),
    "Nachdenklich betrachtest Du Dein Werk. Ploetzlich faellt Dir eine "
    "Stelle auf, die irgendwie anders aussieht.");
  AddDetail( ({ "werk" }),
    "Die Kreise sind Dir wirklich sehr gut gelungen.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus schwarzem Vulkangestein und ist mit einer dicken "
    "Staubschicht bedeckt.");
  AddDetail( ({"gestein", "vulkangestein"}),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddSpecialDetail( ({ "spinnenweben", "spinnwebe", "spinnenwebe", "spinnweben" }), "strspinnenwebe");
  AddSpecialDetail( ({ "reste", "rest" }), "strreste");
  AddDetail( ({ "spinnen" }),
    "Du kannst keine entdecken.");
  AddDetail( ({ "bewohner" }),
    "Entweder haben sich die Bewohner der Spinnenweben ein "
    "anderes Plaetzchen zum Leben gesucht, oder, was wahrscheinlicher "
    "ist, sie sind schlicht und einfach dem Tode zum Opfer gefallen.");
  AddDetail( ({ "plaetzchen" }),
    "Koennte es fuer Spinnen einen schoeneren Ort zum Leben "
    "geben als diesen hier? Umgeben von Staub und Dunkelheit... "
    "Eigentlich ideal, oder?");
  AddDetail( ({ "ort" }),
    "Gefaellt es Dir hier etwa nicht?");
  AddDetail( ({ "leben" }),
    "Noch lebst Du. Aber das koennte sich schnell aendern, wenn "
    "Du nicht aufpasst.");
  AddDetail( ({ "tode" }),
    "Die Bewohner scheinen ihr Leben ausgehaucht zu haben.");
  AddDetail( ({ "opfer" }),
    "Der Tod hat schon so manches Opfer gefordert.");
  AddSpecialDetail( ({ "tod" }), "strtod");
  AddDetail( ({ "dunkelheit" }),
    "Es ist recht dunkel hier.");
  AddDetail( ({ "decke" }),
    "Die Decke ist hier wesentlich niedriger als im suedlichen Teil der "
    "Hoehle. Sie besteht aus schwarzem Vulkangestein, ebenso wie die "
    "Waende und der Boden. Du siehst einige Spinnweben in den Ecken "
    "haengen.");
  AddDetail( ({ "teil" }),
    "Im Sueden ist die Decke viel hoeher als hier.");
  AddDetail( ({ "ecke", "ecken" }),
    "In den Ecken an der Decke und an den Waenden befinden sich "
    "zahlreiche Spinnenweben.");
  AddDetail( ({ "waende", "wand" }),
    "Ueberall an den Waenden siehst Du leere, verwaiste Spinnenweben "
    "haengen.");
  AddDetail( ({ "finger" }),
    "Deine Finger sind schmutzig.");
  AddDetail( ({ "nase" }),
    "Du ruempfst Deine Nase und versuchst, moeglichst wenig Staub "
    "einzuatmen.");
  AddDetail( ({ "hausstauballergie", "allergie" }),
    "Wann warst Du denn das letzte Mal beim Arzt?");
  AddDetail( ({ "mal" }),
    "Schon ganz schoen lange her.");
  AddDetail( ({ "arzt" }),
    "Der ist jetzt leider nicht hier.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst nichts ausser Deinem eigenen Atem.");
  AddSound( ({ "atem" }),
    "Eeeeeeein --- und aaaaaaaaus...");

  AddSmell( DEFAULT_SMELL,
    "Der Staub kriecht in Deine Nase.");
  AddSmell( ({ "staub" }),
    "Lieber nicht, denk an Deine Hausstauballergie!");
  AddSmell( ({ "nase" }),
    "Wie willst Du an Deiner Nase riechen?");

  AddCmd( ({ "atme" }), "cmdatme" );
  AddCmd( ({ "wische", "wisch" }), "cmdwische" );
  AddCmd( ({ "entferne", "entfern" }), "cmdentferne" );
  AddCmd( ({ "oeffne" }), "cmdoeffne" );
  AddCmd( ({ "schliesse", "schliess" }), "cmdschliesse" );
  AddCmd( ({ "druecke", "drueck" }), "cmddruecke" );

  AddExit( "sueden", F2 );
}
string strtod(string key)
{
    string s;
    int tode;
    tode = (PL->QueryProp(P_DEADS)); 
    if(tode > 0)
      s = "Auch Dich hat der Tod schon "+ tode +" mal heimgesucht!";
    else 
      s = "Bisher hat Dich der Tod noch nicht besucht.";
    return BS(s);
}
string strspinnenwebe(string key)
{
    string s;
    if (spinnwebe == DA)
      s = "An den Waenden und an der Decke haengen Spinnenweben. Spinnen "
         +"kannst Du jedoch keine entdecken.";
    else
      s = "Es sind nur noch Reste zu sehen.";
    return BS(s);
}
string strreste(string key)
{
    string s;
    if (spinnwebe == DA)
      s = "Sowas siehst Du da nicht!";
    else
      s = "Jemand hat wohl die Spinnenweben entfernt.";
    return BS(s);
}
string strstelle(string key)
{
    string s;
    if (staub == DA)
      s = "Ob sich da etwas unter dem Staub verbirgt?";
    else
      s = "An einer Stelle hat jemand den Staub vor kurzem "
          "weggewischt, so dass Du dort eine kleine Klappe auf dem "
          "Boden erkennen kannst.";
    return BS(s);
}
string strklappe(string key)
{
    return (klappe == DA) ? "Die Klappe ist geschlossen.\n" :
                            "Die Klappe ist offen. Darunter erblickst Du einen "
                           +"kleinen Knopf.\n";
}
cmdatme(string str)
{
  write("Du holst tief Luft...");
  say(BS( PL->name()+" holt tief Luft..."));
  PL->command_me("huste");
  return 1;
}
// Knopf druecken, oeffnet bzw schliesst Tuer in D3
cmddruecke(string str )
{
  object qitem;
  
  notify_fail( "Was willst Du druecken?\n" );
  if(klappe == DA)
  {
    write(BS("Welchen Knopf meinst Du?"));
    return -1;
  }
  if( str == "knopf" )
  {
    write("Du drueckst auf den Kopf und wartest gespannt.\n"
         +"Ploetzlich ertoent ein leises Rumpeln aus der Ferne.\n");
    say(( PL->name()+" hantiert am Boden herum.\n"
         +"Ploetzlich ertoent ein leises Rumpeln aus der Ferne.\n"));
    
    if(qitem = present( QUESTITEM, TP)) // Questitem vorhanden?
  	{
  	  if(!qitem->QueryKnopf()) // Log scroll reduzieren
  	  {
  		qitem->SetKnopf();
        write_file(QUESTLOG "quest.log", 
               dtime(time())+": "+CAP(getuid(TP))+" drueckt den Knopf!\n" );
      }
    }
    if(knopf == DA) { knopf = WEG; }
    else { knopf = DA; }
    
    call_other(ROOM "raumD3", "tuer", 0);
    
    return 1;
  }
  return 0;
}

// Staubwegwischen um an die Klappe zu gelangen
cmdwische(string str )
{
  notify_fail( "Was willst Du wegwischen?\n" );
  if(-1 == member(({"staub","staubschicht","staub weg","staubschicht weg"}),str))
  {
    return 0;
  }
  {
    if ( staub == DA )
    {
        write(BS("Du wischst den Staub ein wenig weg und entdeckst eine kleine "
                 "Klappe im Boden.") );
        say( BS(PL->name()+" wischt etwas Staub vom Boden weg."));
        staub = WEG;
        AddDetail("klappe", #'strklappe);
        return 1;
    }
    else
    {
        write("Der Staub wurde bereits an der Stelle weggewischt.\n");
        return -1;
    }
  }
}
// Spinnenwebe entfernen
int cmdentferne(string str)
{
  notify_fail( "Was willst Du womit entfernen?\n" );
  if(str == "spinnenweben mit staubwedel" || str == "spinnenweben mit wedel")
  {
    if( present("staubwedel", PL) )
    {
      if(spinnwebe == DA)
      {
        say(BS( PL->name()+" entfernt die Spinnenweben mit einem "
                          +"Staubwedel.") );
        write(BS("Du entfernst die Spinnenweben mit einem Staubwedel.") );
        spinnwebe = WEG;
        return 1;
      }
      else
      {
        say(BS( PL->name()+" fuchtelt mit einem Staubwedel herum.") );
        write(BS("Keine Spinnenweben da!"));
        return -1;
      }
    }
    say(BS( PL->name()+" schaut irritiert aus der Waesche."));
    write(BS("Du vollfuehrst magische Bewegungen und versuchst Dir einen "
            +"Staubwedel herbeizuzaubern. Leider versagst Du auf ganzer "
            +"Linie!"));
    return -1;
  }
  return 0;
}
// Klappe oeffnen um an den Knopf zu kommen
int cmdoeffne(string str)
{
  notify_fail( "Was willst Du oeffnen?\n" );
  if(str == "klappe" )
  {
    if(staub == DA)
    {
      write(BS("Welche Klappe meinst Du?"));
      return -1;
    }
    if(klappe == DA)
    {
      say(BS( PL->name()+" oeffnet die Klappe."));
      write(BS("Mit spitzen Fingern oeffnest Du die Klappe und erblickst "
               "darunter einen kleinen Knopf.") );
      // Klappe offen -> knopf druecken
      klappe = WEG;
      AddDetail("knopf", 
        "Ein kleiner schwarzer Knopf. Ob Du ihn wohl druecken kannst?");
      return 1;
    }
    else
    {
      write("Die Klappe ist doch schon offen.\n");
      return -1;
    }
  }
  return 0;
}
// Was man aufmachen kann sollte man auch wieder zu machen koennen
int cmdschliesse(string str)
{
  notify_fail( "Was willst Du schliessen?\n" );
  if(str == "klappe" )
  {
    if(klappe == WEG)
    {
      say(BS( PL->name()+" schliesst die Klappe."));
      write("Du verschliesst die Klappe wieder.\n");
      // Klappe zu -> nix knopf
      klappe = DA;
      RemoveDetail("knopf");
      return 1;
    }
    else
    {
      write("Die Klappe ist schon geschlossen.\n");
      return -1;
    }
  }
  return 0;
}

string strDu(string key)
{
   PL->command_me("unt "+PL->name());
   return "";
}
int QueryKnopf()
{ 
   return knopf; 
}
reset()
{
  ::reset();
  if(staub == WEG)
    RemoveDetail("klappe");
  if(klappe == WEG)
    RemoveDetail("knopf");

  staub = DA;
  klappe = DA;
  knopf = DA;
  spinnwebe = DA;
}
