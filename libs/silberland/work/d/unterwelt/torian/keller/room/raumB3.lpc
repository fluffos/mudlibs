
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define N "./raumB2"
#define W "./raumA3"
#define SW "./raumA4"

void create() 
{

  ::create();


  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Das erste, was Dir in dieser weitlaeufigen Hoehle auffaellt, ist ein "
    "riesiges Spinnennetz, das es Dir unmoeglich macht, weiter nach "
    "Suedwesten in die Hoehle vorzudringen. Im Norden zweigt ein schmaler "
    "und dunkler Gang ab und nach Westen hin fuehrt die Hoehle weiter." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  
  SetProp(P_KILL_NAME, "Eine Verbrennung" );

  AddExit( "norden", N );
  AddExit ("suedwesten", ([ EX_DEST:     SW,
                            EX_TESTFUNC: "exit_test" ]) );
  AddExit( "westen", W );
  
  AddDetail( ({ "hoehle" }),
    "Die Hoehle breitet sich weitlaeufig zu allen Seiten hin aus. Im "
    "Norden zweigt ein schmaler und dunkler Gang ab und nach Westen hin "
    "fuehrt die Hoehle weiter. Im Suedwesten befindet sich ein riesiges "
    "Spinnennetz und versperrt Dir den Weg.");
  AddDetail( ({ "seiten" }),
    "Schwungvoll drehst Du Dich in alle Richtungen, bis Dir schwindelig wird "
    "und Du schnaufend innehaeltst.");
  AddDetail( ({ "richtungen" }),
    "Einmal im Kreis halt.");
  AddDetail( ({ "kreis" }),
    "Ein Kreis ist ein Viereck ohne Ecken.");
  AddDetail( ({ "viereck" }),
    "Verbindet man vier verschiedene Punkte A, B, C, D einer "
    "Ebene, von denen keine drei auf einer Geraden liegen, durch vier Strecken, " 
    "AB, BC, CD, DA, so erhaelt man ein Viereck.");
  AddDetail( ({ "a"}),
    "A ist der erste Buchstabe im Alphabet.");
  AddDetail( ({ "b"}),
    "B ist der zweite Buchstabe im Alphabet.");
  AddDetail( ({ "c"}),
    "C ist der ... na? Richtig, der dritte Buchstabe im Alphabet.");
  AddDetail( ({ "d"}),
    "D: Wird Dir nicht allmaehlich langweilig?");
  AddDetail( ({ "alphabet" }),
    "Das Alphabet besteht aus 26 verschiedenen Buchstaben.");
  AddDetail( ({ "buchstabe" }),
    "A, B, C, D... Dies alles sind Buchstaben. Aber das wusstest Du auch "
    "vorher schon, oder?");
  AddDetail( ({ "punkte", "punkt" }),
    ". . .");
  AddDetail( ({ "ebene" }),
    "Ein zweidimensionaler Raum.");
  AddDetail( ({ "raum" }),
    "Wenn Du Dir diesen Raum hier in Deiner Vorstellungskraft anschaust, "
    "erhaeltst Du einen dreidimensionalen Raum.");
  AddDetail( ({ "vorstellungskraft" }),
    "Die besitzt Du doch hoffentlich, oder?");
  AddDetail( ({ "geraden", "gerade" }),
    "Du zeichnest mit Deiner Hand eine imaginaere Gerade in die Luft.");
  AddDetail( ({ "hand" }),
    "Noch dran.");
  AddDetail( ({ "luft" }),
    "Ein wenig stickig ist es hier unten.");
  AddDetail( ({ "strecken", "strecke", "linie" }),
    "Eine gerade Linie von Punkt A bis Punkt B nennt man auch Strecke AB.");
  AddDetail( ({ "ab" }),
    "Die Strecke zwischen den Punkten A und B.");
  AddDetail( ({ "bc" }),
    "Die Strecke zwischen den Punkten B und C.");
  AddDetail( ({ "cd" }),
    "Die Strecke zwischen den Punkten C und D.");
  AddDetail( ({ "da" }),
    "Die Strecke zwischen den Punkten D und A.");
  AddDetail( ({ "ecken" }),
    "Ein Kreis hat eben KEINE Ecken.");
  AddDetail( ({ "gang" }),
    "Der Gang, der im Norden weiter aus dieser Hoehle hinausfuehrt, sieht "
    "sehr schmal und dunkel aus.");
  AddDetail( ({ "norden" }),
    "Im Norden fuehrt ein schmaler, dunkler Gang aus der Hoehle hinaus.");
  AddDetail( ({ "westen" }),
    "Die Hoehle breitet sich nach Westen hin noch weiter aus.");
  AddDetail( ({ "suedwesten" }),
    "Im Suedwesten versperrt Dir ein riesiges Spinnennetz den Weg, so "
    "dass Du dort wohl nicht weiterkommst.");
  AddDetail( ({ "weg" }),
    "Der Weg nach Suedwesten wird Dir durch ein riesiges Spinnennetz "
    "versperrt.");
  AddDetail( ({ "spinnennetz", "netz" }),
    "Vorsichtig naeherst Du Dich dem riesigen Spinnennetz und "
    "betrachtest es genauer. Lange, dicke Schleimfaeden ziehen sich von "
    "der einen Wand zur anderen und versperren Dir so den Weg nach "
    "Suedwesten. An einigen Stellen sieht es so aus, als ob dort etwas "
    "in die Faeden eingewickelt ist.");
  AddDetail( ({ "schleimfaeden", "faeden" }),
    "Lange Schleimfaeden ueberziehen die Waende und versperren Dir "
    "unnachgiebig den Weg. Teilweise haben sich an den Faeden schon "
    "dicke, eklige Schleimwuelste gebildet, von denen ab und zu etwas "
    "weisslicher Schleim heruntertropft.");
  AddDetail( ({ "schleimwuelste", "wuelste" }),
    "An den Faeden haben sich dicke, eklige Schleimwuelste gebildet, von "
    "denen in unregelmaessigen Abstaenden Schleim herunter auf den Boden "
    "tropft.");
  AddDetail( ({ "abstaende", "abstaenden" }),
    "In unregelmaessigen Abstaenden tropft Schleim auf den Boden.");
  AddDetail( ({ "schleim" }),
    "Du verfolgst gespannt einen Schleimtropfen, der sich gerade jetzt "
    "von einem der Wuelste loest und schliesslich mit einem leisen "
    "*PLATSCH* auf dem Boden landet.");
  AddDetail( ({ "schleimtropfen", "tropfen" }),
    "Der Schleim sieht wirklich sehr eklig und klebrig aus.");
  AddDetail( ({ "stellen" }),
    "An einigen Stellen scheint sich irgendetwas in den klebrigen "
    "Faeden verwickelt zu haben. Was das wohl sein kann?");
  AddDetail( ({ "etwas", "irgendetwas" }),
    "Als Du genauer hinsiehst, erkennst Du, dass es sich bei einem der "
    "mysterioesen Etwasse um die Ueberreste eines kleinen Tieres "
    "handelt, das sich wohl hoffnungslos in den klebrigen Faeden "
    "verwickelt hat und dann elendig zugrundegegangen ist.");
  AddDetail( ({ "etwasse" }),
    "Wenn Du weisst, was die Mehrzahl von Etwas ist, melde Dich "
    "bitte bei Torian.");
  AddDetail( ({ "mehrzahl" }),
    "Ein Etwas, mehrere ...?");
  AddDetail( ({ "torian" }),
    "Der Magier, der das alles hier verbrochen hat.");
  AddDetail( ({ "magier" }),
    "\"hilfe magier\"");
  AddDetail( ({ "tier" }),
    "Es scheint einmal eine Ratte gewesen zu sein.");
  AddDetail( ({ "ratte" }),
    "Kleine Nagetiere mit spitzen Zaehnen und einem langen Schwanz.");
  AddDetail( ({ "nagetiere" }),
    "Ratten, Maeuse...");
  AddDetail( ({ "maeuse" }),
    "Auch Maeuse sind kleine Nagetiere. Allerdings sind sie meistens "
    "viel niedlicher als Ratten.");
  AddDetail( ({ "zaehne", "zaehnen" }),
    "Mit ihren winzigen spitzen Zaehnen knabbern Ratten und Maeuse "
    "nahezu alles an, was ihnen ueber den Weg laeuft.");
  AddDetail( ({ "schwanz" }),
    "Der Schwanz einer Ratte ist viel laenger als der einer Maus.");
  AddDetail( ({ "ueberreste" }),
    "Sehr viel ist von dem Tier nicht mehr uebrig.");
  AddDetail( ({ "boden" }),
    "Der Boden und die Waende bestehen aus schwarzem Vulkangestein. Dir "
    "faellt ein dunkler Fleck auf dem Boden auf.");
  AddDetail( ({ "vulkangestein", "gestein" }),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "fleck" }),
    "Merkwuerdig. Da liegen ein paar schwarze Haare auf dem Boden. Wo "
    "die nur herkommen?");
  AddDetail( ({ "haare" }),
    "Du hockst Dich auf den Boden und befuehlst die Haare pruefend. Sie "
    "sind tiefschwarz und sehr kurz und fuehlen sich ziemlich dick an. "
    "Dir ist nicht wohl bei der ganzen Angelegenheit.");
  AddDetail( ({ "angelegenheit" }),
    "Wo die Haare herkommen, gibt es bestimmt noch mehr.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus Vulkangestein. Ein grosser Teil der Wand im "
    "Sueden bzw. im Suedwesten wird von dem riesigen Spinnennetz "
    "verdeckt, das dort den Weg versperrt.");
  AddDetail( ({ "teil" }),
    "Die Waende sind zu einem grossen Teil mit den klebrigen Faeden des "
    "Spinnennetzes ueberzogen.");
  AddDetail( ({ "decke", "hoehlendecke" }),
    "Hoch oben ueber Deinem Kopf befindet sich die Hoehlendecke. Du "
    "glaubst erkennen zu koennen, dass auch sie aus dem hier unten "
    "ueblichen schwarzen Vulkangestein besteht.");
  AddDetail( ({ "kopf" }),
    "Die Decke befindet sich weit oben ueber Deinem Kopf.");
  AddDetail( ({ "moment" }),
    "Schon vorbei.");

  AddSound( DEFAULT_SOUND,
    "Es ist ziemlich ruhig hier in der Hoehle, nur ab und zu durchbricht "
    "ein leises Tropfen die Stille.");

  AddSound( ({ "tropfen", "tropf", "platsch" }),
    "Tropf --- Platsch -------- Tropf ------ Platsch - Tropf");
  AddSound( ({ "stille" }),
    "Du lauschst einen Moment lang der Stille, bis ein leises Tropfen "
    "diese wieder durchbricht.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist hier sehr stickig und es riecht ein wenig nach "
    "Schleim. Ein sonderbarer Geruch dringt von dem Spinnennetz her an "
    "Deine Nase.");

  AddSmell( ({ "luft" }),
    "Stickig.");
  AddSmell( ({ "schleim" }),
    "Deine Nase faengt schon an zu prickeln.");
  AddSmell( ({ "geruch" }),
    "Ein leichter Verwesungsgeruch geht von dem Spinnennetz aus.");
  AddSmell( ({ "verwesungsgeruch", "verwesung" }),
    "Baeh, eklig!");
  AddSmell( ({ "spinnennetz", "netz" }),
    "Das Spinnennetz verstroemt einen leichten Geruch nach Tod und "
    "Verwesung.");
  AddSmell( ({ "tod" }),
    "Das Netz riecht nach Tod und Verwesung.");
  AddSmell( ({ "nase" }),
    "Du kratzt Dich an der Nase.");

  AddCmd( ({ "entferne", "entfern" }), "cmdentferne" );
  AddCmd( ({ "zuend", "zuende" }), "cmdanzuenden" );
  
  AddItem( "/d/ebene/ronja/feenquest/npc/ratte", REFRESH_NONE);

}

// Spinnennetz mit dem Staubwedel entfernen
int cmdentferne(string str)
{
  object mywedel;
  notify_fail( "Was willst Du womit entfernen?\n" );
  if(str == "netz mit staubwedel" || str == "netz mit wedel"
  || str == "spinnnennetz mit staubwedel" || str == "spinnennetz mit wedel"
  || str == "netz" || str == "spinnennetz")
  {
  
    mywedel = present("staubwedel", PL);
  
    if( mywedel )
    {
  
      say(BS( PL->name()+" versucht, die Spinnenweben mit einem "
                        +"Staubwedel zu entfernen und schaut enttaeuscht zu Boden.") );
      write(BS("Du versuchst, das riesige Spinnennetz mit Deinem winzigen "
              +"Staubwedel zu entfernen, musst dann jedoch leider erkennen, dass "
              +"dies wohl ein recht sinnloses Unterfangen ist. Du musst Dir wohl "
              +"etwas anderes einfallen lassen!"));
      return 1;
    }
    else
    {
      say(BS( PL->name()+" schaut irritiert aus der Waesche."));
      write(BS("Du vollfuehrst magische Bewegungen und versuchst Dir einen "
              +"Staubwedel herbeizuzaubern. Leider versagst Du auf ganzer "
              +"Linie! Du musst Dir wohl etwas anderes einfallen lassen!"));
      return -1;
    }
  }    
  return 0;
}

// Kein Durchkommen
int exit_test(string dir)
{
    if(!TP)              return 0;
    if(!interactive(TP)) return 0;
    write(BS("Du versuchst nach Suedwesten zu gehen, wirst aber von einem "
            +"grossen Netz aufgehalten. Wenn Du es nicht entfernst, wirst Du "
            +"nie daran vorbeikommen!"));
    return 0;
}

// Spinnennetz anzuenden -> Ohne Erfolg
int cmdanzuenden(string str)
{
   object fackel;
   notify_fail( "Was willst Du womit anzuenden?\n" );

// nicht folstaendige syntax
   if ((str == "netz an") || (str == "spinnennetz an"))
   {
     write(BS("Womit willst du das Spinnennetz anzuenden?"));
     return -1;
   }

// richtige syntax
   if ((str == "netz mit fackel an") || (str == "spinnennetz mit fackel an"))
   {
// fackel auch da ?
     fackel = present("fackel",TP);
     if( !fackel )
     {
       write(BS("Du hast gar keine Fackel!"));
       return -1;
     } 

// mit einer erloschenen fackel kann man nix abfackeln
     if(!(fackel->_query_lighted()))
     {
       write(BS("Die Fackel ist nicht angezuendet!"));
       return -1;
     }
     
     say(BS( PL->name()+" zuendet vorsichtig das Netz an. Ploetzlich fallen ein "
                       +"paar brennende Faeden von dem Netz herunter genau in "
                       +PL->name(WESSEN)+" Haare.") );
     write(BS("Du zuendest vorsichtig das Netz an. Ploetzlich fallen ein paar "
             +"brennende Faeden von dem Netz herunter genau in Deine Haare! Im "
             +"letzten Moment schaffst Du es sie zu loeschen."));
     // 5-19 Lp Abzug
     this_player()->do_damage(5+random(15), this_object());
     return 1;
   }
   return 0;
}
