
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define SO "./raumD5"
#define SW "./raumB5"

int hebel;

void create() 
{

  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Der dunkle Gang fuehrt von hier nach Suedwesten weiter und "
    "verbreitert sich im Suedosten zu einer kleinen Hoehle. An "
    "der rechten Seite des Ganges liegt ein grosser Haufen "
    "Geruempel vor der Wand." );

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
    "Der Gang fuehrt von hier weiter nach Suedwesten und "
    "breitet sich im Suedosten zu einer kleinen Hoehle aus.");
  AddDetail( ({ "suedwesten" }),
    "Im Suedwesten fuehrt der Gang weiter.");
  AddDetail( ({ "suedosten" }),
    "Im Suedosten verbreitert sich der Gang zu einer kleinen Hoehle.");
  AddDetail( ({ "hoehle" }),
    "Suedoestlich von Dir wird der Gang immer breiter und weitet sich "
    "schliesslich zu einer kleinen Hoehle aus.");
  AddDetail( ({ "seite" }),
    "Auf der rechten Seite des Ganges liegt ein grosser Haufen "
    "Geruempel vor der Wand.");
  AddDetail( ({ "geruempel" }),
    "Du kannst ein paar alte verrottete Holzbalken, einen Haufen ziemlich "
    "verdreckter Leinensaecke und sogar einige kaputte Werkzeugteile in "
    "dem Haufen erkennen.");
  AddDetail( ({ "holzbalken" }),
    "Die Holzbalken muessen schon eine ganze Zeitlang hier unten herumliegen, "
    "denn sie sind bereits stark verrottet und an einigen Stellen sehen sie "
    "aus, als ob sie jemand angenagt haette.");
  AddDetail( ({ "zeitlang" }),
    "Die Holzbalken muessen schon seit sehr langer Zeit hier unten liegen.");
  AddDetail( ({ "zeit" }),
    "Um zu erfahren, wie spaet es ist, solltest Du auf die Uhr gucken.");
  AddDetail( ({ "uhr" }),
    "Wenn Du dazu zu faul bist, kannst Du auch einfach \"Zeit\" eingeben.");
  AddDetail( ({ "stellen" }),
    "An einigen Stellen ist das Holz von irgendetwas oder irgendjemandem "
    "angenagt worden.");
  AddDetail( ({ "holz" }),
    "Du glaubst, dass es sich um Eichenholz handelt, bist Dir aber nicht sicher.");
  AddDetail( ({ "eichenholz" }),
    "Eichenholz ist zwar eine der unempfindlichsten Holzarten, "
    "doch irgendwann verrottet auch dieses Holz, wenn es lange "
    "irgendwo herumliegt und nicht gepflegt wird.");
  AddDetail( ({ "holzarten", "holzart" }),
    "Holz wird in der Regel aus unterschiedlichen Baumarten gewonnen.");
  AddDetail( ({ "regel" }),
    "Normalerweise gewinnt man Holz aus Baeumen.");
  AddDetail( ({ "baeume" }),
    "Es gibt viele verschiedene Baeume, so wie es auch viele verschiedene "
    "Holzarten gibt.");
  AddDetail( ({ "baumarten" }),
    "Es gibt zum Beispiel Eichen, Linden, Weiden und viele "
    "andere mehr.");
  AddDetail( ({ "beispiel" }),
    "Dies sind nur einige Beispiele.");
  AddDetail( ({ "eichen", "eiche" }),
    "Eichen werden oft sehr alt und ihr Holz ist sehr widerstandsfaehig.");
  AddDetail( ({ "linden", "linde", "lindenholz" }),
    "Linden sind nur maessig witterungsfest und ihr Holz ist sehr elastisch.");
  AddDetail( ({ "weiden", "weide", "weidenholz" }),
    "Weiden haben sehr empfindliches, weiches und wenig dauerhaftes Holz.");
  AddDetail( ({ "holzarten" }),
    "Eichenholz, Lindenholz, Weidenholz... und so weiter.");
  AddDetail( ({ "leinensaecke", "saecke" }),
    "Alte, verdreckte Leinensaecke liegen in dem Haufen herum. "
    "Sie scheinen alle leer zu sein und da sie wirklich sehr "
    "dreckig sind, schaust Du lieber nicht genauer nach.");
  AddDetail( ({ "werkzeugteile", "teile" }),
    "Von den Werkzeugteilen ist nicht mehr sehr viel uebrig. Du "
    "siehst nur alte, zerbrochene Sachen, die Dich nicht weiter "
    "interessieren. Doch halt, ganz unten scheint etwas zu sein, was "
    "noch einigermassen brauchbar zu sein scheint. Wie kommst Du da "
    "jetzt bloss dran?");
  AddDetail( ({ "sachen" }),
    "Die zerbrochenen Sachen interessieren Dich nicht weiter.");
  AddDetail( ({ "etwas" }),
    "Du weisst nicht genau, was es ist, aber es sieht nicht so "
    "kaputt aus wie die anderen Sachen auf dem Haufen.");
  AddDetail( ({ "haufen" }),
    "Ein grosser Haufen mit altem Geruempel liegt vor der Wand.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus schwarzem Vulkangestein. Vor der "
    "rechten Seite des Ganges liegt ein grosser Haufen mit "
    "altem Geruempel.");
  AddDetail( ({ "vulkangestein", "gestein" }),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "boden" }),
    "Rechts von Dir liegt ein grosser Haufen mit Geruempel auf dem Boden.");
  AddDetail( ({ "decke" }),
    "Die Decke aus Vulkangestein befindet sich ein ganzes "
    "Stueck ueber Dir.");
  AddDetail( ({ "stueck" }),
    "Zwei oder drei Meter.");
  AddDetail( ({ "meter" }),
    "Du wirst doch wohl wissen, wieviel ein Meter ist!");
  AddDetail( ({ "finger" }),
    "Pass auf, dass Du sie Dir nicht schmutzig machst.");

  AddSound( DEFAULT_SOUND,
    "Es ist mucksmaeuschenstill hier unten.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach vermodertem Holz und altem Leinen.");

  AddSmell( ({ "holz" }),
    "Die verrotteten Holzbalken verstroemen einen leichten Modergeruch.");
  AddSmell( ({ "modergeruch" }),
    "Der Modergeruch kommt von den alten Holzbalken.");
  AddSmell( ({ "leinen" }),
    "Die alten Leinensaecke riechen ein wenig unangenehm.");

  AddExit( "suedosten", SO );
  AddExit( "suedwesten", SW );
  
  AddItem( "/d/ebene/ronja/feenquest/npc/ratte", REFRESH_NONE);

  AddCmd( ({ "wuehle", "durchwuehle", "durchsuche" }), "cmdsuchen" );

  hebel = DA;
}

// Durchsuchen/wuehlen des Geruempelhaufens
int cmdsuchen(string str )
{
  object myhebel;
  object qitem;
  notify_fail( "Was willst Du durchsuchen?\n" );
  
  if(str == "geruempel" || str == "haufen")
  {
    write(BS("Du durchsuchst das Geruempel findest aber nichts Brauchbares. "
            +"Vielleicht ist unter den Saecken oder den Werkzeugen eher etwas?"));
    say( BS(PL->name()+" durchsucht den Haufen geruempel."));
    return -1;
  }
  
  if(str == "saecke" || str == "sack" || str == "leinensaecke" 
  || str == "leinensack")
  {
    write(BS("Mit spitzen Fingern hebst Du ein paar der dreckigen Saecke "
            +"hoch und schaust vorsichtig darunter. Schade, jetzt hast "
            +"Du Dir die Finger ganz umsonst schmutzig gemacht, denn "
            +"unter den Saecken ist nichts Interessantes zu sehen."));
    say( BS(PL->name()+" durchwuehlt die Leinensaecke."));
    return -1;
  }

  if(str == "werkzeug" || str == "werkzeugteile"
  || str == "teile" || str == "werkzeuge")
  {
    if(hebel == DA)
    {
      myhebel=clone_object(OBJ "metallstange");
      if(!myhebel)
      {
        write(BS("Du greifst tief in den Haufen hinein und findest "
                +"sogar etwas, leider rutscht es Dir aus den Fingern."));
      }
      if(ME_TOO_HEAVY==myhebel->move(TP,M_GET|M_SILENT))
      {
        write(BS("Du greifst tief in den Haufen hinein und findest "
               +"sogar etwas, leider ist es Dir viel zu schwer."));
        myhebel->remove();
      }
      else
      {
        if(qitem = present( QUESTITEM, TP)) // Questitem vorhanden?
        {
          if(!qitem->QueryStange()) // Log scroll reduzieren
          {
            qitem->SetStange();
            write_file(QUESTLOG "quest.log", 
               dtime(time())+": "+CAP(getuid(TP))+" findet die Metallstange!\n" );
          }
        }
        write(BS("Du greifst tief in den Haufen hinein und ziehst "
                +"schliesslich eine kurze Metallstange daraus hervor."));
        hebel = WEG;
      }
      say( BS(PL->name()+" durchwuehlt die Werkzeugteile und findet etwas."));
      return 1;
    }
    else
    {
      write(BS("Du greifst tief in den Haufen hinein, doch Du hast Dich "
              +"wohl getaeuscht. Es befinden sich nur nutzlose, voellig "
              +"zerbrochene Sachen dort."));
      say( BS(PL->name()+" durchwuehlt die Werkzeugteile und findet aber nichts."));
      return 1;
    }
  }
  return 0;
}

reset()
{
  ::reset();
  
  if(hebel == WEG)
  {
    hebel = DA;
  }
}
