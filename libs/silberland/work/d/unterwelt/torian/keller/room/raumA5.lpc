
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define O "./raumB5"

int stein, schutt, hebel;

void create() 
{

  ::create();

  SetProp( P_INT_SHORT, "In einer eingestuerzten Hoehle" );
  SetProp( P_INT_LONG,
    "Schon nach wenigen Metern hoert der Gang in dieser Richtung abrupt "
    "auf. Vor Dir tuermen sich Berge von grossen und kleinen "
    "Gesteinsbrocken auf, die aus der eingestuerzten Westwand "
    "herausgebrochen sind. Der gesamte Boden ist mit Staub und kleineren "
    "Steinkoernchen bedeckt." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "meter" }),
    "Schon nach ein paar Metern hoert der Gang abrupt auf.");
  AddDetail( ({ "gang" }),
    "Du stehst in einem breiten, ziemlich dunklen Gang, in dem "
    "unzaehlige Gesteinsbrocken herumliegen. Die Wand im Westen ist "
    "eingestuerzt, so dass Du hier nicht weiterkommst.");
  AddDetail( ({ "gesteinsbrocken" }),
    "Aus der Westwand sind viele grosse und kleine Gesteinsbrocken "
    "herausgebrochen, die sich nun unnachgiebig vor Dir auftuermen. Ein "
    "besonders grosser Steinbrocken liegt etwa einen halben Meter von "
    "dem Gesteinsberg entfernt.");
 
  AddSpecialDetail( ({ "steinbrocken", "brocken"}), "strsteinbrocken");

  AddSpecialDetail( ({ "haufen" }), "strhaufen");

  AddSpecialDetail( ({ "schutt" }), "strschutt");
  AddSpecialDetail( ({ "glaenzendes", "etwas" }), "stretwas");
  AddSpecialDetail( ({ "hebel", "metallhebel" }), "strhebel");
  AddSpecialDetail( ({ "mitte" }), "strmitte");
  AddSpecialDetail( ({ "seite" }), "strseite");

  AddDetail( ({ "glaenzendes", "etwas" }),
    "Um es genauer zu untersuchen, solltest Du den Schutt erstmal "
    "wegraeumen.");
  AddSpecialDetail( ({ "steinbrocken", "brocken"}), "strsteinbrocken");

  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche des Steinbrockens ist sehr ungleichmaessig und "
    "laesst den Stein ziemlich wackelig aussehen.");
  AddDetail( ({ "gesteinsberg", "berg" }),
    "Etwa einen halben Meter vor dem Gesteinsberg liegt ein besonders "
    "grosser Steinbrocken.");
  AddDetail( ({ "westen" }),
    "Im Westen ist der Gang eingestuerzt.");
  AddDetail( ({ "westwand" }),
    "Die Westwand ist eingestuerzt.");
  AddDetail( ({ "richtung" }),
    "In westlicher Richtung.");
  AddDetail( ({ "berge" }),
    "Riesige Berge von Gesteinsbrocken in allen erdenklichen Formen und "
    "Groessen tuermen sich vor Dir auf.");
  AddDetail( ({ "formen" }),
    "Die Gesteinsbrocken haben voellig unterschiedliche Formen und "
    "Groessen. Manche sind gross und fast viereckig, andere sind kleiner "
    "und runder geformt, waehrend wiederum andere mit vielen Spitzen und "
    "scharfen Kanten uebersaeht sind.");
  AddDetail( ({ "groessen", "groesse" }),
    "Die Groesse der Gesteinsbrocken reicht von faustgross bis zu fast "
    "einem Meter breit.");
  AddDetail( ({ "spitzen", "spitze", "kanten", "kante" }),
    "Einige der Gesteinsbrocken haben scharfe Kanten und Spitzen. Pass "
    "auf, dass Du Dich nicht daran schneidest!");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit viel Staub und kleinen Steinkoernchen bedeckt, "
    "die wohl heruntergeprasselt sind, als der Gang eingestuerzt ist.");
  AddDetail( ({ "staub" }),
    "Es liegt sehr viel Staub auf dem Boden und von der Decke rieselt "
    "etwas Staub herab.");
  AddDetail( ({ "steinkoernchen" }),
    "Viele kleine Steinkoernchen sind ueber den Boden verstreut.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen aus schwarzem Vulkangestein. Die Westwand ist "
    "eingestuerzt.");
  AddDetail( ({ "vulkangestein", "gestein" }),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "decke" }),
    "Die Decke befindet sich etwa zwei Meter ueber Dir. Etwas Staub "
    "rieselt von dort oben herab.");
  AddDetail( ({ "stein" }),
    "Der eingestuerzte Gang ist voller Steine, welchen meinst Du genau?");
  AddDetail( ({ "kleiner stein", "kleinerer stein", "kleineren stein" }),
    "Ein etwas kleinerer Stein liegt in der Naehe des grossen "
    "Steinbrockens auf dem Boden. Er waere sicherlich gut als Drehpunkt "
    "geeignet, wenn man versuchen wollte, den grossen Steinbrocken "
    "wegzustemmen.");
  AddDetail( ({ "naehe" }),
    "Nicht weit entfernt von dem grossen Steinbrocken liegt ein "
    "kleinerer Stein auf dem Boden.");
  AddDetail( ({ "drehpunkt" }),
    "Um den grossen Steinbrocken wegzustemmen, koennte man den "
    "kleineren Stein als Drehpunkt nutzen.");
  AddDetail( ({ "taschentuch" }),
    "Hast Du ueberhaupt eines bei Dir?");
  AddDetail( ({ "fall" }),
    "Es koennte ja sein, dass Du bei all dem Staub hier niesen musst.");
  AddDetail( ({ "millimeter" }),
    "Keinen Millimeter.");
  AddDetail( ({ "blick" }),
    "Du schielst.");

  AddSound( DEFAULT_SOUND,
    "Es ist ziemlich still hier. Das einzige, was Du hoeren kannst, ist "
    "der Staub, der von der Decke herunterrieselt.");

  AddSound( ({ "rieseln" }),
    "Der Staub rieselt leise vor sich hin.");
  AddSound( ({ "stille" }),
    "Es ist sehr still hier.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach Staub.");

  AddSmell( ({ "staub" }),
    "Vorsorglich holst Du schon mal Dein Taschentuch heraus fuer den Fall, "
    "dass Du gleich niesen musst.");

  AddExit( "osten", O );

  AddCmd( ({ "repariere", "reparier" }), "cmdreparier" );
  AddCmd( ({ "tausche", "tausch" }), "cmdaustauschen" );
  AddCmd( ({ "wische", "wisch" }), "cmdwische" );
  AddCmd( ({ "schneid", "schneide" }), "cmdschneide" );
  AddCmd( ({ "zieh", "ziehe", "betaetige" }), "cmdziehe" );
  AddCmd( ({ "raeume", "raeum" }), "cmdraeume" );
  AddCmd( ({ "stemm", "stemme" }), "cmdstemme" );
  AddCmd( ({ "bewege", "beweg", "ruettel", "wackel", "schuettel",
             "druecke", "drueck", "schieb", "schiebe" }), "cmdbewege" );
  stein = DA;
  schutt = DA;
  hebel = WEG;

}

string strhaufen(string str)
{
  string s;
  if (stein == DA)
    s = "Was fuer einen Haufen meinst Du?";
  else
    s = "Ein kleiner Haufen Schutt befindet sich unter dem Steinbrocken, den "
       +"Du gerade weggestemmt hast.";
  return BS(s);
}

string strmitte(string str)
{
  string s;
  if (schutt == DA)
    s = "Was fuer eine Mitte meinst Du denn?";
  else
    s = "Der Hebel ist in der Mitte durchgebrochen.";
  return BS(s);
}

string strhebel(string str)
{
  string s;
  if (schutt == DA)
    s = "Was fuer einen Hebel meinst Du denn?";
  else
  {
    if(hebel == WEG)
      s = "Ein kleiner Metallhebel steckt dort im Boden. Er ist in der Mitte "
         +"durchgebrochen, so dass er sich leider nicht mehr betaetigen "
         +"laesst.";
    else
      s = "Ein kleiner Metallhebel steckt dort im Boden. Er wurde scheinbar "
         +"vor kurzem erst repariert.";
  }
  return BS(s);
}

string strsteinbrocken(string str)
{
  string s;
  if (stein == DA)
    s = "Ein besonders grosser und sehr schwer aussehender Steinbrocken "
       +"liegt etwa einen halben Meter von dem Gesteinsberg entfernt auf dem "
       +"Boden. Er hat eine ungleichmaessige Oberflaeche und sieht ein wenig "
       +"wackelig aus.";
  else
    s = "Dort, wo vorher der grosse Steinbrocken gelegen hat, ist der Boden "
       +"etwas eingedrueckt und Du siehst einen kleinen Haufen Schutt dort "
       +"herumliegen.";
  return BS(s);
}

string strschutt(string str)
{
  string s;
  if (schutt == DA)
    s = "Unter dem Schutt siehst Du etwas Glaenzendes aufblitzen.";
  else
    s = "Der Schutt wurde zur Seite geraeumt und Du siehst einen kleinen "
       +"Metallhebel dort im Boden stecken.";
  return BS(s);
}

string strseite(string str)
{
  string s;
  if (schutt == DA)
    s = "Welche Seite?";
  else
    s = "Irgendjemand hat den Schutt zur Seite geraeumt.";
  return BS(s);
}

string stretwas(string str)
{
  string s;
  if (schutt == DA)
    s = "Um es genauer zu untersuchen, solltest Du den Schutt erstmal "
       +"wegraeumen.";
  else
    s = "Ein kleiner Metallhebel steckt dort im Boden. Er ist in der "
       +"Mitte durchgebrochen, so dass er sich leider nicht mehr betaetigen "
       +"laesst.";
  return BS(s);
}

// Schutt wegraeumen -> Zugang zum (defekten) Hebel
int cmdraeume(string str )
{
  notify_fail( "Was willst Du wegraeumen?\n" );
  if(-1 == member(({"schutt weg","schutthaufen weg", "haufen weg"}),str))
  { return 0; }

  if (schutt == DA && stein == WEG)
  {
  	write(BS("Du raeumst den Schutt ein wenig zur Seite und legst so einen "
            +"kleinen Metallhebel frei, der dort im Boden steckt."));
    say( BS(PL->name()+" macht sich an dem Schutthaufen zu schaffen."));
    schutt = WEG;
    return 1;
  }
  if (schutt == WEG)
  {
  	write(BS("Der Schutt ist bereits zur Seite geraeumt worden."));
  	return -1;
  }
  return 0;
}


// Stein bewegen -> hinweis auf stemmen
int cmdbewege(string str )
{
  notify_fail( "Was willst Du bewegen?\n" );
  if(-1 == member(({"stein","stein weg", "steinbrocken", "steinbrocken weg",
                    "brocken", "brocken weg"}),str))
  { return 0; }

  write(BS("Du ruettelst kraeftig an dem grossen Steinbrocken herum, doch er "
          +"bewegt sich keinen Millimeter von der Stelle. Erschoepft sinkst Du "
          +"neben dem Steinbrocken zu Boden. Dabei faellt Dein Blick auf einen "
          +"etwas kleineren Stein, den Du vorher vollkommen uebersehen hast."));
  say( BS(PL->name()+" macht sich an dem Steinbrocken zu schaffen."));
  return 1;
}

// Stein wegstemmen -> zugang zum schutthaufen
int cmdstemme(string str )
{
  object mybrecheisen;

  notify_fail( "Was willst Du womit wegstemmen?\n" );
  if(-1 == member(({"stein mit brecheisen weg", "steinbrocken mit brecheisen weg",
                    "brocken mit brecheisen weg"}),str))
  { return 0; }
  
  // muss nicht Brecheisen aus dem Keller sein
  mybrecheisen = present("brecheisen", TP); 
  if( mybrecheisen )
  {
    if(stein == DA)
    {
      write(BS("Du klemmst das gekruemmte Ende des Brecheisens unter dem grossen "
             +"Steinbrocken fest und bewegst das andere Ende so, dass das Eisen "
             +"direkt ueber dem kleineren Stein schwebt. Nun stuetzt Du Dich mit "
             +"aller Kraft auf das Brecheisen und versuchst, es so weit wie "
             +"moeglich in Richtung Boden zu druecken und den Stein so nach oben "
             +"zu stemmen. Du keuchst vor lauter Anstrengung, doch schliesslich "
             +"hast Du es geschafft und der Steinbrocken poltert mit lautem "
             +"Krachen zur Seite."));
      say( BS(TP->name()+" stemmt den Steinbrocken zur Seite."));
      stein = WEG;
      return 1;
    }
    else
    {
      write(BS("Der Steinbrocken wurde doch bereits weggestemmt."));
      return -1;
    }
  }
  else
  {
    write(BS("Fehlt Dir dafuer nicht etwas Entscheidendes?"));
    return -1;
  }

} 

// Hebel ziehen
int cmdziehe(string str)
{
  notify_fail( "Woran willst Du ziehen?\n" );
  if(schutt == DA || stein == DA) { return 0;}

  if(str == "hebel" || str == "an hebel")
  {
    if(hebel == DA)
    {
      say(PL->name()+" zieht an dem Hebel.\n"
               +"Ploetzlich ertoent ein leises Rumpeln aus der Ferne.\n");
      write("Du ziehst an dem Hebel.\n"
         +"Ploetzlich ertoent ein leises Rumpeln aus der Ferne.\n");
      call_other (ROOM "raumC3", "tuernorden", 0);
      tell_room(TO,BS("Der Hebel springt in seine Ausgangstellung zurueck."));
      return 1;
    }
    else
    {
      write(BS("Der Hebel ist doch zerbrochen. Du solltest ihn also erstmal "
              +"reparieren oder austauschen, bevor Du ihn betaetigen kannst."));
      return -1;
    }
  }

  return 0;
}

// hebel reparieren
int cmdreparier(string str )
{
  string race, s;

  notify_fail( "Was willst Du reparieren?\n" );
  if(schutt == DA || stein == DA) { return 0;}
  
  if(str == "hebel" || str == "metallhebel")
  {
    if(hebel == DA)
    {
  	  write(BS("Aber der Hebel ist bereits repariert!"));
      return -1;
    }
    else
    {
      race = PL->QueryProp(P_RACE);
      s = "Du versuchst mit all Deinem Geschick den Hebel zu reparieren. ";
      switch(race)
      {
        case "Dunkelelf" :
        case "Elf" :
        case "Fee" :
        case "Mensch" :
          s += "Mit Deinen schlanken Fingern verbindest Du vorsichtig das "
              +"zerbrochene Ende des Hebels mit dem restlichen Teil. Stolz "
              +"betrachtest Du dein Werk, als alles wieder auseinander faellt. ";
	  break;
        case "Hobbit" :
        case "Zwerg" :
          s = "Mit Deinen dicken Fingern verbindest Du vorsichtig das "
             +"zerbrochene Ende des Hebels mit dem restlichen Teil. Leider "
             +"machst Du damit alles nur noch Schlimmer! ";
	  break;
        case "Troll" :
        case "Oger" :
          s = "Mit Deinen dicken Wurstfingern verbindest Du das zerbrochene Ende "
             +"des Hebels mit dem restlichen Teil. Wobei Du den Hebel endgueltig "
             +"zerstoerst. ";
	  break;
        default :
          s += "Mit Deinen Fingern verbindest Du vorsichtig das "
              +"zerbrochene Ende des Hebels mit dem restlichen Teil. Stolz "
              +"betrachtest Du dein Werk, als alles wieder auseinander faellt. ";
          break;
      }
      s += "So wird das nichts. Du musst den Hebel wohl doch austauschen.";
      write(BS(s));
      return 1;
    }
  }
  return 0;
}

// hebel austauschen
int cmdaustauschen(string str )
{
  object myhebel, qitem;

  notify_fail( "Was willst Du austauschen?\n" );
  
  if(schutt == DA || stein == DA) { return 0;}
  
  if(str == "hebel aus" || str == "metallhebel aus")
  {

    if(hebel == DA)
    {
  	  write(BS("Aber der Hebel ist bereits repariert!"));
      return -1;
    }
  
    myhebel = present(QUESTHEBEL, TP);
    if( myhebel)
    {    write(BS("Du entfernst den zerbrochenen Hebel und setzt dafuer "
              +"Deinen eigenen Hebel in das dafuer vorgesehene Loch im Boden ein."));
      myhebel->remove();
      hebel = DA;
      if(qitem = present( QUESTITEM, TP)) // Questitem vorhanden?
      {
        if(!qitem->QueryHebel()) // Log scroll reduzieren
        {
          qitem->SetHebel();
          write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" tauscht den Hebel aus!\n" );
        }
      }
      return 1;
    }
    else
    {
      write(BS("Du hast nichts zum austauschen dabei!"));
  	  return -1;
    }
  }
  return 0;
}

// Staub wischen
int cmdwische(string str )
{
  notify_fail( "Was willst Du wegwischen?\n" );
  if(-1 == member(({"staub","staub weg"}),str))
  { return 0; }
  write(BS("Angesichts der Unmengen an Staub gibst Du Dein Vorhaben auf."));
  return 1;
}

// An den Kanten schneiden
int cmdschneide(string str )
{
  notify_fail( "Woran willst Du Dich schneiden?\n" );
  if(-1 == member(({"dich an kanten","dich an kante","dich an spitze",
                    "dich an spitzen", "dich", "an kante", "an kanten",
                    "an spitze", "an spitzen", "kante", "kanten", 
                    "spitze", "spitzen"}),str))
  { return 0; }
  
  write(BS("Geschickt schneidest Du Dich an den Kanten und Spitzen."));
  SetProp(P_KILL_NAME, "Dummheit" );
  this_player()->do_damage(5+random(15), this_object());
  return 1;
}

int QueryHebel()
{ 
   return hebel; 
}
reset()
{
  ::reset();
  
  if(stein == WEG)
  {
    schutt = DA;
    stein = DA;
    tell_room(TO,BS("Der grosse Steinbrocken rollt polternd in die Mitte."));
  }
  
  hebel = WEG;
}
