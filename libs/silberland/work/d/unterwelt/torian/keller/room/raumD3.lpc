
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define NO ROOM "raumE2"
#define SO "./raumE4"
#define W ROOM "raumC3"

int netz, spider;
void SetNetz();

void create() 
{

  ::create();
  
  spider = DA;
  netz = DA;

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du stehst in einem sehr engen, dunklen Gang, der keines "
    "natuerlichen Ursprunges zu sein scheint. Im Nordosten sowie im "
    "Suedosten ueberziehen zwei riesige Spinnennetze die Waende und "
    "scheinen Dir so den Weg zu versperren. Im Westen faellt Dein Blick "
    "auf eine alte rostige Gittertuer mit einem dicken Schloss davor." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 2, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
    "Dieser enge Gang scheint keines natuerlichen Ursprunges zu sein, "
    "sondern von irgendjemandem aus dem Gestein herausgeschlagen worden "
    "zu sein. Es ist sehr dunkel und die Luft ist sehr kuehl.");
  AddDetail( ({ "ursprung", "ursprungs" }),
    "Wer mag diesen Gang nur gebaut haben und vor allem zu welchem Zweck?");
  AddDetail( ({ "zweck" }),
    "Du hast keine Ahnung, warum jemand hier unten in harter Arbeit "
    "einen weiteren Gang aus dem Gestein schlagen sollte, wo hier doch "
    "eigentlich fuer alles Erdenkliche Platz genug zu sein scheint.");
  AddDetail( ({ "ahnung" }),
    "Du hast absolut keine Ahnung.");
  AddDetail( ({ "arbeit" }),
    "Es muss sehr schwere Arbeit gewesen sein, hier unten einen Gang aus "
    "dem Stein herauszuschlagen. Wer auch immer diese Strapazen auf sich "
    "genommen hat, muss einen guten Grund dafuer gehabt haben.");
  AddDetail( ({ "stein", "gestein" }),
    "Das schwarze Vulkangestein, aus dem hier unten nahezu alles zu "
    "bestehen scheint, ist sehr hart und daher extrem schwer zu "
    "bearbeiten.");
  AddDetail( ({"vulkangestein"}),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "strapazen" }),
    "Solche Strapazen wuerdest Du sicherlich nicht freiwillig auf Dich nehmen.");
  AddDetail( ({ "grund" }),
    "Es muss einen guten Grund dafuer geben, dass sich jemand solche "
    "Arbeit gemacht hat.");
  AddDetail( ({ "erdenkliche" }),
    "Alles moegliche.");
  AddDetail( ({ "platz" }),
    "Auch ohne diesen Gang ist hier unten im Keller sehr viel Platz.");
  AddDetail( ({ "keller" }),
    "Du befindest Dich immer noch im Keller von Mabruk.");
  AddDetail( ({ "mabruk" }),
    "Vielleicht war er derjenige, der diesen Gang hier gebaut hat?");
  AddDetail( ({ "luft" }),
    "Hier im Gang ist es sehr kuehl. Du frierst ein wenig.");
  AddDetail( ({ "suedosten" }),
    "Im Suedosten versperrt Dir ein riesiges Spinnennetz den Weg.");
  AddDetail( ({ "spinnennetze", "spinnennetz" }),
    "Die Spinnennetze sind riesengross und bestehen aus langen, "
    "aeusserst klebrigen Schleimfaeden, die sich ueber die Waende "
    "ziehen.");
  AddDetail( ({ "schleimfaeden", "faeden" }),
    "Lange Schleimfaeden ueberziehen die Waende und bilden so zwei "
    "riesige Spinnennetze. Sie sehen aeusserst klebrig aus.");
  AddDetail( ({ "weg" }),
    "Es fuehren zwei Wege nach Nordosten und Suedosten weiter, die Dir "
    "jedoch beide von riesigen Spinnennetzen versperrt werden.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende wurden sehr sorgfaeltig aus dem Stein herausgearbeitet. "
    "Sie sind mit klebrigen Schleimfaeden ueberzogen.");
  AddDetail( ({ "westen" }),
    "Im Westen siehst Du eine alte rostige Gittertuer mit einem dicken "
    "Schloss davor.");
/*  AddDetail( ({ "gittertuer", "tuer" }),
    "Die Tuer besteht aus langen, rostigen Eisenstreben. Ein grosses, im "
    "Gegensatz zu der Tuer ziemlich neu aussehendes Schloss sorgt "
    "dafuer, dass die Tuer fest verschlossen ist.");
*/
  AddDetail( ({ "eisenstreben" }),
    "Die Eisenstreben sind mit dunklem Rost ueberzogen.");
  AddDetail( ({ "rost" }),
    "Die Tuer scheint schon ziemlich alt zu sein, so verrostet wie sie ist.");
  AddDetail( ({ "gegensatz" }),
    "Im Gegensatz zu der rostigen Tuer sieht das Schloss ziemlich neu aus.");
  AddDetail( ({ "schloss" }),
    "Das Schloss sieht noch sehr neu aus. Anscheinend wurde es erst vor "
    "kurzem hier angebracht, um das, was hinter dieser Tuer liegt, vor "
    "neugierigen Besuchern zu schuetzen. Auf der Oberseite kannst Du "
    "eine Inschrift erkennen und auf der Unterseite befindet sich ein "
    "kleines Schluesselloch.");
  AddDetail( ({ "besucher" }),
    "Solche wie Dich.");
  AddDetail( ({ "oberseite" }),
    "Auf der Oberseite des Schlosses wurde eine Inschrift eingraviert.");
  AddDetail( ({ "inschrift" }),
    "Die Inschrift ist in einer Dir unbekannten Sprache verfasst.");
  AddDetail( ({ "sprache" }),
    "Eigentlich sind es eher Symbole.");
  AddDetail( ({ "symbole" }),
    "Ob das Schloss durch Magie zusaetzlich gesichert wurde?");
  AddDetail( ({ "magie" }),
    "Du kannst zwar nichts spueren, aber irgendeinen Sinn werden die "
    "Symbole sicher haben.");
  AddDetail( ({ "sinn" }),
    "Du weisst leider nicht welchen.");
  AddDetail( ({ "unterseite" }),
    "Auf der Unterseite des Schlosses befindet sich ein kleines Schluesselloch.");
  AddDetail( ({ "schluesselloch" }),
    "Es steckt kein Schluessel in dem Schluesselloch.");
  AddDetail( ({ "schluessel" }),
    "Du siehst keinen.");
  AddDetail( ({ "blick" }),
    "Du blickst Dich neugierig um.");
  AddDetail( ({ "boden" }),
    "Der Boden ist hier sehr eben und glatt. Ein wenig Staub liegt "
    "darauf, so dass Du Deine Fussspuren darauf erkennen kannst.");
  AddDetail( ({ "staub" }),
    "Ein wenig Staub liegt auf dem Boden.");
  AddDetail( ({ "fussspuren" }),
    "Du kannst ein paar leichte Fussspuren auf dem Boden erkennen, die "
    "Du selbst dort hinterlassen hast.");
  AddDetail( ({ "decke" }),
    "Auch die Decke wurde sehr sorgfaeltig aus dem Stein "
    "herausgeschlagen. Sie ist hier im Gang sehr niedrig.");

  AddSpecialDetail( ({ "nordosten"}), "strnordosten");

  AddSound( DEFAULT_SOUND,
    "So sehr Du Dich auch anstrengst, Du kannst absolut nichts hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach Staub.");

  AddSmell( ({ "staub" }),
    "Es riecht staubtrocken.");

  AddExit ("nordosten", ([ EX_DEST:     NO,
                            EX_TESTFUNC: "exitno" ]) );
  AddExit ("suedosten", ([ EX_DEST:     SO,
                            EX_TESTFUNC: "exitso" ]) );
//  AddExit( "nordosten", NO );
//  AddExit( "suedosten", SO );
  
  AddCmd( ({ "wische", "wisch" }), "cmdwische" );
  AddCmd( ({ "breche", "brich", "knacke" }), "cmdbrechen" );
  AddCmd( ({ "schliesse", "schliess" }), "cmdschliessen" );
  AddCmd( ({ "zuend", "zuende" }), "cmdanzuenden" );
  AddCmd( ({ "entferne", "entfern" }), "cmdentferne" );

    NewDoor("westen", W , ({"gittertuer", "tuer"}),
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Gittertuer.",
      D_LONG, "Die Tuer besteht aus langen, rostigen Eisenstreben. Ein grosses, "
             +"im Gegensatz zu der Tuer ziemlich neu aussehendes Schloss sorgt "
             +"dafuer, dass die Tuer fest verschlossen ist.",
      D_NAME,  "Gittertuer",
      D_GENDER,FEMALE,
      D_OPENTESTFUNC, "tueroeffnen",
      D_CLOSEMSG, ({"Mit viel Muehe schliesst Du die Gittertuer im Westen.",
                    "Mit viel Muehe wird die Gittertuer von %s geschlossen.",
                    " im Osten ist zugefallen!\n*RUUUUUMMMMMMMS*\n"}),
      D_RESET_CLOSEMSG,
                  " im Westen ist zugefallen!\n*RUUUUUMMMMMMMS*\n"
    })
  );

}

string strnordosten(string str)
{
  string s;
  if (netz == DA)
    s = "Im Nordosten siehst Du ein riesiges klebriges Spinnennetz, das Dir "
        "den Weg versperrt.";
  else
    s = "Im Nordosten siehst Du ein riesiges klebriges Spinnennetz. Irgendjemand "
       +"hat ein grosses Loch hineingebrannt, so dass Du ungehindert dem Weg "
       +"weiter folgen kannst.";
  return BS(s);
}

void SetNetz()
{
  if(netz == DA)
    netz = WEG;
  else
    netz = DA;
  return;
}

void tuer()
{
	object dest;
    call_other(W, "???", 0);
    dest = find_object(W);

	if (DOOR_MASTER->QueryDoorStatus(W)==D_STATUS_OPEN)
	{
		tell_room(TO, "*RUUUUUMMMMMMMS*\nDie Gittertuer im Westen ist zugefallen!\n");
	    if(dest)
	    {
	      tell_room(dest, "*RUUUUUMMMMMMMS*\nDie Gittertuer im Osten ist "
	                     +"zugefallen!\n");
	    }
	    DOOR_MASTER->SetDoorStatus(W, D_STATUS_CLOSED);
	}
	else
	{
	    tell_room(TO,BS("Du hoerst ein lautes Geraeusch und siehst wie sich die Gittertuer "
	            +"im Westen oeffnet."));
	    if(dest)
	    {
	      tell_room(dest, BS("Du hoerst ein lautes Geraeusch und siehst wie sich "
	                        +"die Gittertuer im Osten oeffnet."));
	    }
	    DOOR_MASTER->SetDoorStatus(W, D_STATUS_OPEN);
	}
}
// Die Tuer laesst sich nur von Innen oeffnen
int tueroeffnen()
{
  write("Du ruettelst ohne Erfolg an der Gittertuer.\n");
  return 1;
}

int cmdwische(string str )
{
  notify_fail( "Was willst Du wegwischen?\n" );
  if(-1 == member(({"staub","staubschicht","staub weg","staubschicht weg"}),str))
  { return 0; }
  write(BS("Du wirbelst etwas Staub auf, der sich jedoch gleich wieder legt. "
          +"Doch halt was ist das? Unglaublich Du hast Staub gefunden!!! "
          +"Enttaeuscht wendest Du Dich ab."));
  say( BS(PL->name()+" wirbelt etwas Staub auf, der sich jedoch gleich wieder "
                    +"legt."));
  return 1;
}

int cmdbrechen(string str )
{
  notify_fail( "Was willst Du aufbrechen?\n" );
  if(-1 == member(({"schloss auf", "tuer auf", "gittertuer auf"}),str))
  { return 0; }
  write(BS("Du spannst Deine Muskeln an und versuchst mit aller Kraft, das "
          +"Schloss aufzubrechen, schaffst es aber nicht."));
  say( BS(PL->name()+" versucht, das Schloss an der Gittertuer aufzubrechen, "
                    +"scheitert jedoch klaeglich."));
  return 1;
}

int cmdschliessen(string str )
{
  notify_fail( "Was willst Du aufschliessen?\n" );
  if(-1 == member(({"schloss", "tuer", "gittertuer"}),str))  { return 0; }
  write(BS("Ohne Schluessel wird das nichts! Wie waers mit roher Gewalt?"));
  return 1;
}

int exitno(string dir)
{
  if (netz == DA)
  {
  	if(!TP)              return 0;
    if(!interactive(TP)) return 0;
    write(BS("Du versuchst, nach Nordosten zu gehen, wirst aber von einem "
            +"grossen Netz aufgehalten. Wenn Du es nicht entfernst kommst Du "
            +"nie daran vorbei!"));
    return 0;
  }
  else { return 1; }
}

// Kein Durchkommen
int exitso(string dir)
{
    if(!TP)              return 0;
    if(!interactive(TP)) return 0;
    write(BS("Du versuchst, nach Suedosten zu gehen, wirst aber von einem "
            +"grossen Netz aufgehalten. Wenn Du es nicht entfernst kommst Du "
            +"nie daran vorbei!"));
    return 0;
}

// Spinnennetz anzuenden
int cmdanzuenden(string str)
{
   int groesse, i;
   string richtung, mynetz;
   object fackel, spinne, dest;
   notify_fail( "Was willst Du womit anzuenden?\n" );

// nicht vollstaendige syntax
   if ((str == "netz an") || (str == "spinnennetz an"))
   {
     write(BS("Womit willst du das Spinnennetz anzuenden?"));
     return -1;
   }

// fast richtige syntax
   if ((str == "netz mit fackel an") || (str == "spinnennetz mit fackel an"))
   {
     write("Welches Spinnennetz meinst Du?\n"
          +"Syntax: \"zuende spinnennetz im <Richtung> mit fackel an\"\n");
     return -1;
   }

   if((!str) || (sscanf(str,"%s in %s mit fackel an", mynetz, richtung) != 2)) 
   { return 0; }

   richtung = lower_case(richtung);
   mynetz = lower_case(mynetz);
   
   if(mynetz != "spinnennetz" && mynetz != "netz") { return 0; }
//   write(mynetz+"\n");
   if(richtung != "suedosten" && richtung != "nordosten")
   {
     write("In dieser Richtung gibt es kein Spinnennetz!\n");
     return -1;
   }

// fackel auch da ?
   fackel = present("fackel",TP);
   if( !fackel )
   {
     write(BS("Du hast gar keine Fackel!"));
     return -1;
   }
 
// mit einer erloschenen fackel kann man nix abfackeln
   if(!(fackel->_query_lighted()))
   {
     write(BS("Die Fackel ist nicht angezuendet!"));
     return -1;
   }

   if(richtung == "suedosten")
   {      
     if(spider == DA)
     {
       say(BS( PL->name()+" versucht, das Netz anzuzuenden, als ploetzlich "
                         +"eine riesige Spinne hereinkrabbelt und +"
                         +PL->name()+" attackiert!") );
       write(BS("Du versuchst, das Netz anzuzuenden. Ploetzlich krabbelt eine "
               +"riesige Spinne herein und attackiert Dich!"));

       spinne = clone_object(NPC "riesenhoehlenspinne");
       if(spinne)
       {
         spinne->move(TO,M_GO|M_SILENT);
         spinne->Kill(TP);
         spider = WEG;
       }
       return 1;
     }
     else
     {
       write(BS("Du versuchst, das Netz anzuzuenden. Komischerweise passiert "
               +"ueberhaupt nichts."));
       return -1;
     }
   }
     
   if(richtung == "nordosten")
   {
     say(BS( PL->name()+" zuendet das Netz im Nordosten an. Durch das so "
             +"entstandene Loch kann man auf die andere Seite gelangen."));
     write(BS("Du zuendest das Netz im Nordosten an. Durch das so "
             +"entstandene Loch kann man auf die andere Seite gelangen."));

     SetNetz();
     call_other(NO, "VerbrenneNetz", 0);
     dest = find_object(NO); // Andern Raum noch mitteilen was los ist 
     return 1;
   }
 return 0;
}
// Spinnennetz entfernen
int cmdentferne(string str)
{
  notify_fail( "Was willst Du entfernen?\n" );
  if(str == "netz" || str == "spinnnennetz" || str == "netz im nordosten"
  || str == "netz im suedosten" || str == "spinnnennetz im nordosten" 
  || str == "spinnennetz im suedosten")
  {
    write(BS("Du starrst die riesigen Spinnennetze an und gibst Dein Vorhaben "
            +"ganz schnell wieder auf."));
    return 1;
  }
  return 0;
}

reset()
{
  object dest;
  ::reset();

  if(netz == WEG)
  {
    tell_room(this_object(), "Das Netz im Nordosten wird von der anderen Seite "
                            +"neu gesponnen.\n");
    SetNetz();
    call_other(NO, "SetNetz", 0);
    dest = find_object(NO); // Andern Raum noch mitteilen was los ist 
    if(dest)
    {
     tell_room(dest, "Das Netz im Suedwesten wird von der anderen Seite "
                    +"neu gesponnen.\n");
    }
    // im andern raum auch
  }

  spider = DA;
}
