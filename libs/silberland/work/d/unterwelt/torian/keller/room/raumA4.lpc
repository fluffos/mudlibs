
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define N "./raumA3"
#define NO "./raumB3"
#define SO "./raumB5"

void create() 
{

  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Noerdlich von Dir breitet sich die Hoehle weiter aus, "
    "waehrend Dir im Nordosten durch ein riesiges Spinnennetz "
    "die Sicht versperrt wird. Im Suedosten zweigt ein breiter, "
    "aber recht dunkler Gang aus der Hoehle ab." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  
  AddExit( "norden", N );
  AddExit( "suedosten", SO );
  AddExit ("nordosten", ([ EX_DEST:     NO,
                            EX_TESTFUNC: "exit_test" ]) );

  AddDetail( ({ "hoehle" }),
    "Im Norden breitet sich die Hoehle weiter aus. Du glaubst, "
    "irgendetwas dort in der Mitte der Hoehle erkennen zu "
    "koennen, bist Dir aber nicht sicher.");
  AddDetail( ({ "norden" }),
    "Geh einfach hin. Oder hast Du etwa Angst?");
  AddDetail( ({ "angst" }),
    "Fuer einen kurzen Moment beginnen deine Knie leicht zu "
    "zittern, doch dann reisst Du Dich schnell wieder zusammen. "
    "Hoffentlich hat niemand Deine Angst bemerkt.");
  AddDetail( ({ "moment" }),
    "Nervoes schaust Du Dich um.");
  AddDetail( ({ "knie" }),
    "Deine Knie fuehlen sich etwas weich und zittrig an.");
  AddDetail( ({ "mitte" }),
    "Mitten in der Hoehle noerdlich von Dir scheint sich "
    "irgendetwas zu befinden. Du kannst jedoch von hier nicht "
    "genau erkennen, was es ist.");
  AddDetail( ({ "irgendetwas", "etwas" }),
    "Was das wohl sein koennte?");
  AddDetail( ({ "nordosten" }),
    "Du kannst leider nicht sehen, was sich im Nordosten "
    "befindet, da Dir dort ein riesiges Spinnennetz jegliche "
    "Sicht versperrt.");
  AddDetail( ({ "spinnennetz", "netz" }),
    "Ein riesiges Spinnennetz ragt vor Dir hinauf und versperrt "
    "Dir mit seinen dicken, klebrigen Schleimfaeden den "
    "weiteren Weg nach Nordosten.");
  AddDetail( ({ "schleimfaeden", "faeden", "faden", "schleimfaden" }),
    "Von den Faeden tropft weisslicher Schleim herunter. Die "
    "Schleimfaeden ziehen sich kreuz und quer ueber die Waende "
    "und versperren Dir so unnachgiebig den Weg. Wie willst Du "
    "da bloss dran vorbeikommen?");
  AddDetail( ({ "schleim" }),
    "Der weisse Schleim tropft friedlich vor sich hin bis auf "
    "den Boden, wo sich schon eine kleine Pfuetze gebildet hat.");
  AddDetail( ({ "pfuetze" }),
    "Wenn Wasser in der Pfuetze waere, koenntest Du sicherlich "
    "daraus trinken.");
  AddDetail( ({ "wasser" }),
    "Leider ist in der Pfuetze aber kein frisches, klares "
    "Wasser, sondern nur ekliger, stinkender Schleim. Tja, Pech "
    "gehabt.");
  AddDetail( ({ "pech" }),
    "Gib es einfach zu. Du hast halt Pech gehabt.");
  AddDetail( ({ "mund" }),
    "Der Schleim wuerde Deine Mundschleimhaeute sicherlich "
    "voellig veraetzen, also laesst Du das Trinken lieber bleiben.");
  AddDetail( ({ "mundschleimhaeute", "schleimhaeute" }),
    "Noch hast Du welche. NOCH.");
  AddDetail( ({ "trinken" }),
    "Du kriegst Durst.");
  AddDetail( ({ "durst" }),
    "Du lechzt nach Wasser.");
  AddDetail( ({ "weg" }),
    "Der Weg nach Nordosten wird Dir durch die klebrigen Faeden des "
    "Spinnennetzes versperrt.");
  AddDetail( ({ "sicht" }),
    "Deine Sicht wird durch das Spinnennetz stark getruebt. Da nuetzt "
    "auch Brille putzen nix mehr.");
  AddDetail( ({ "brille" }),
    "Tzz, die hast Du sicher wieder voellig vergessen aufzusetzen, oder? "
    "Kein Wunder, dass Du nix siehst.");
  AddDetail( ({ "wunder" }),
    "Du brauchst Dich wirklich nicht zu wundern.");
  AddDetail( ({ "brillenglaeser", "glaeser" }),
    "Die Glaeser Deiner Brille blitzen und glaenzen vor "
    "Sauberkeit. Leider kannst Du damit trotzdem nicht hinter "
    "das Spinnennetz schauen.");
  AddDetail( ({ "sauberkeit" }),
    "Die Glaeser Deiner Brille sind blitzsauber.");
  AddDetail( ({ "hemdsaermel", "aermel" }),
    "Dein Hemdsaermel ist schmutzig. Aber das stoert Dich nicht weiter. ");
  AddDetail( ({ "suedosten" }),
    "Im Suedosten zweigt ein dunkler, breiter Gang ab.");
  AddDetail( ({ "gang" }),
    "Ein breiter und recht dunkel aussehender Gang fuehrt nach Suedosten.");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende sind fast rundherum mit den langen Schleimfaeden des "
    "Spinnennetzes uebersaeht.");
  AddDetail( ({ "decke" }),
    "Auch hier ist die Decke aus schwarzem Vulkangestein.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus schwarzem Vulkangestein. Du siehst "
    "ein paar seltsame, schwarze Haare verstreut herumliegen.");
  AddDetail( ({ "haare" }),
    "Ein paar einzelne, schwarze Haare sind ueber den Boden verstreut.");
  AddDetail( ({ "vulkangestein", "gestein" }),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "aufgabe" }),
    "Was war gleich nochmal Deine Aufgabe?");

  AddSound( DEFAULT_SOUND,
    "Es ist ziemlich ruhig hier in der Hoehle, nur ab und zu durchbricht "
    "ein leises Tropfen die Stille.");

  AddSound( ({ "tropfen", "tropf", "platsch" }),
    "Tropf --- Platsch -------- Tropf ------ Platsch - Tropf");
  AddSound( ({ "stille" }),
    "Ein paar Sekunden lang lauschst Du konzentriert der Stille und dem "
    "leisen Pochen Deines Herzens. Als Du Dich gerade so richtig "
    "entspannt hast, durchbricht ein leises *PLATSCH* Deine Gedanken und "
    "Du widmest Dich seufzend wieder Deiner Aufgabe.");
  AddSound( ({ "sekunden" }),
    "Du hoerst geradezu, wie die Sekunden vergehen.");
  AddSound( ({ "pochen" }),
    "Dein Herz pocht leise und regelmaessig.");
  AddSound( ({ "herz", "herzen", "sorge" }),
    "Keine Sorge, Dein Herz schlaegt noch, sonst wuerdest Du hier wohl "
    "kaum so ruhig rumstehen und in der Gegend herumlauschen.");
  AddSound( ({ "gedanken" }),
    "Deine Gedanken werden von einem leisen *PLATSCH* unterbrochen.");
  AddSound( ({ "gegend" }),
    "Du lauschst in der Gegend herum.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft ist ein wenig stickig hier, ausserdem stinkt es "
    "etwas nach Schleim.");

  AddSmell( ({ "schleim" }),
    "Ein leicht schleimiger Geruch geht von dem Spinnennetz aus.");
  AddSmell( ({ "spinnennetz" }),
    "Du schnueffelst angestrengt in Richtung Spinnennetz. Ja, "
    "der Geruch kommt eindeutig von dort.");
  AddSmell( ({ "geruch" }),
    "Der Geruch geht von dem Spinnennetz aus.");
  AddSmell( ({ "luft" }),
    "Die Luft ist sehr trocken und etwas stickig.");

  AddCmd( ({ "entferne", "entfern" }), "cmdentferne" );
  AddCmd( ({ "zuend", "zuende" }), "cmdanzuenden" );
  AddCmd( ({ "trinke", "trink" }), "cmdtrinke" );
  AddCmd( ({ "putz", "putze" }), "cmdputze" );
  
}

// Brille putzen
int cmdputze(string str)
{
  notify_fail( "Was willst Du putzen?\n" );
  if(str == "brille" || str == "brillenglaeser" )
  {
      say(BS( PL->name()+" putzt "+(PL->QueryProp(P_GENDER) == MALE ? "seine" : "ihre")
                        +" Brillenglaeser.") );
      write(BS("Sorgfaeltig putzt Du Deine Brillenglaeser mit Deinem "
              +"Hemdsaermel ab und haeltst sie dann pruefend hoch. Ja, "
              +"schon viel besser."));
      return 1;
  }    
  return 0;
}

//aus der Schleimpfuetze trinken *baeh* ;)
int cmdtrinke(string str)
{
  notify_fail( "Was willst Du woraus trinken?\n" );
  if(str == "wasser aus pfuetze" || str == "wasser" )
  {
      say(BS( PL->name()+" beugt sich ueber eine Pfuetze.") );
      write(BS("Du beugst Dich erwartungsvoll ueber die Pfuetze, kannst "
              +"jedoch kein Wasser entdecken und richtest Dich enttaeuscht "
              +"wieder auf."));
      return 1;
  }
  if(str == "aus pfuetze" || str == "pfuetze" 
  || str == "schleim" || str = "schleim aus pfuetze")
  {
      say(BS( PL->name()+" beugt sich ueber eine Pfuetze.") );
      write(BS("Du beugst Dich neugierig ueber die Pfuetze, oeffnest Deinen "
              +"Mund und ... ueberlegst es Dir doch lieber wieder anders. "
              +"So appetitlich sieht der Schleim naemlich eigentlich gar "
              +"nicht aus."));
      return 1;
  }    
  return 0;
}
// Spinnennetz mit dem Staubwedel entfernen
int cmdentferne(string str)
{
  object mywedel;
  notify_fail( "Was willst Du womit entfernen?\n" );
  if(str == "netz mit staubwedel" || str == "netz mit wedel"
  || str == "spinnnennetz mit staubwedel" || str == "spinnennetz mit wedel")
  {
  
    mywedel = present("staubwedel", PL);
  
    if( mywedel )
    {
  
      say(BS( PL->name()+" versucht, die Spinnenweben mit einem "
                        +"Staubwedel zu entfernen und schaut enttaeuscht zu Boden.") );
      write(BS("Du versuchst, das riesige Spinnennetz mit Deinem winzigen "
              +"Staubwedel zu entfernen, musst dann jedoch leider erkennen, dass "
              +"dies wohl ein recht sinnloses Unterfangen ist. Du musst Dir wohl "
              +"etwas anderes einfallen lassen!"));
      return 1;
    }
    else
    {
      say(BS( PL->name()+" schaut irritiert aus der Waesche."));
      write(BS("Du vollfuehrst magische Bewegungen und versuchst Dir einen "
              +"Staubwedel herbeizuzaubern. Leider versagst Du auf ganzer "
              +"Linie! Du musst Dir wohl etwas anderes einfallen lassen!"));
      return -1;
    }
  }    
  return 0;
}

// Kein Durchkommen
int exit_test(string dir)
{
    if(!TP)              return 0;
    if(!interactive(TP)) return 0;
    write(BS("Du versuchst nach Nordosten zu gehen, wirst aber von einem "
            +"grossen Netz aufgehalten. Wenn Du es nicht entfernst, wirst Du "
            +"nie daran vorbeikommen!"));
    return 0;
}

int cmdanzuenden(string str)
{
   object fackel;
   notify_fail( "Was willst Du womit anzuenden?\n" );

// nicht folstaendige syntax
   if ((str == "netz an") || (str == "spinnennetz an"))
   {
     write(BS("Womit willst du das Spinnennetz anzuenden?"));
     return -1;
   }

// richtige syntax
   if ((str == "netz mit fackel an") || (str == "spinnennetz mit fackel an"))
   {
// fackel auch da ?
     fackel = present("fackel",TP);
     if( !fackel )
     {
       write(BS("Du hast gar keine Fackel!"));
       return -1;
     } 

// mit einer erloschenen fackel kann man nix abfackeln
     if(!(fackel->_query_lighted()))
     {
       write(BS("Die Fackel ist nicht angezuendet!"));
       return -1;
     }
     
     say(BS( PL->name()+" versuchst das Netz anzuzuenden. Als ploetzlich "
                       +"hunderte von kleinen Spinne ueber das Netz "
                       +"rennen, laesst "+PL->name()+" die Fackel vor Schreck "
                       +"fallen.") );
     write(BS("Du versuchst das Netz anzuzuenden. Ploetzlich krabbeln hunderte "
             +"von kleinen Spinnen ueber das Netz. Vor lauter Schreck laesst Du "
             +"die Fackel fallen."));
     fackel->move(this_object(),M_PUT);
     
     return 1;
   }
   return 0;
}
