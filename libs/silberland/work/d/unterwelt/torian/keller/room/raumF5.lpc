
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define NW "./raumE4"
#define W "./raumE5"

void create() 
{

  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich hier in einer kleinen Hoehle, die nach Westen hin "
    "weiterfuehrt. Ein breiter Gang zweigt im Nordwesten ab und fuehrt "
    "so um die riesige Saeule im Norden herum. Die Luft ist hier ein "
    "wenig feucht und auf dem Boden siehst Du eine Wasserlache, die sich "
    "durch das Wasser gebildet hat, das hier die Waende herabrinnt." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }),
    "Die Hoehle breitet sich nach Westen hin weiter aus. Im Nordwesten "
    "fuehrt ein breiter Gang um die grosse Saeule herum, die sich "
    "noerdlich von Dir befindet.");
  AddDetail( ({ "westen" }),
    "Im Westen breitet sich die Hoehle weiter aus.");
  AddDetail( ({ "gang" }),
    "Der Gang im Nordwesten ist recht breit und fuehrt um die Saeule im "
    "Norden herum.");
  AddDetail( ({ "nordwesten" }),
    "Ein breiter Gang fuehrt im Nordwesten um die riesige Saeule herum.");
  AddDetail( ({ "saeule", "steinsaeule" }),
    "Noerdlich von Dir ragt eine riesige Steinsaeule empor. Ihre "
    "Oberflaeche glaenzt tiefschwarz und ist fast spiegelglatt. Zum "
    "Boden und zur Decke hin ist die Saeule etwas breiter und "
    "unfoermiger als in der Mitte, wo sie nur etwa so dick ist wie ein "
    "schlanker Troll.");
  AddDetail( ({ "norden" }),
    "Im Norden ragt eine riesige Steinsaeule zur Decke empor.");
  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche der Saeule glaenzt tiefschwarz und ist fast spiegelglatt.");
  AddDetail( ({ "mitte" }),
    "In der Mitte ist die Saeule weniger dick als weiter zum Boden und "
    "zur Decke hin.");
  AddDetail( ({ "troll" }),
    "Du hast noch nie einen schlanken Troll gesehen. Ob es so etwas "
    "wirklich gibt?");
  AddDetail( ({ "luft" }),
    "Hier in der Hoehle ist die Luft etwas feucht und Dir treten kleine "
    "Schweissperlen auf die Stirn.");
  AddDetail( ({ "schweissperlen", "schweiss", "perlen" }),
    "Nur ganz kleine.");
  AddDetail( ({ "stirn" }),
    "Du wischt Dir den Schweiss von der Stirn.");
  AddDetail( ({ "wasserlache", "lache" }),
    "An den Waenden laeuft in duennen Rinnsaelen Wasser herunter, das sich "
    "am Boden in einer langsam immer groesser werdenden Lache ansammelt. "
    "Ein leichter Dunst liegt ueber dem Wasser und es riecht ein wenig "
    "nach Schwefel." );
  AddDetail( ({ "rinnsaele", "rinnsal" }),
    "Duenne Rinnsaele von Wasser sickern an den Waenden hinunter und "
    "sammeln sich am Boden in einer immer groesser werdenden Lache an.");
  AddDetail( ({ "wasser", "wasserstelle" }),
    "Das Wasser sammelt sich in einer Lache auf dem Boden an. Eine "
    "leichte Dunstschicht liegt ueber dem Wasser und es riecht ein "
    "wenig nach Schwefel. Ob es ratsam waere, von dem Wasser zu trinken?");
  AddDetail( ({ "dunstschicht" }),
    "Eine leichte Dunstschicht liegt ueber dem Wasser. Du wedelst ein "
    "wenig mit den Haenden ueber der Lache herum, doch es steigt immer "
    "neuer Dunst aus dem Wasser auf.");
  AddDetail( ({ "boden" }),
    "Auf dem Boden sammelt sich das Wasser in einer Lache an, die "
    "langsam immer groesser zu werden scheint. Leichter Dunst liegt "
    "ueber dem Wasser.");
  AddDetail( ({ "haende", "hand" }),
    "Du starrst Deine Haende beschwoerend an, doch sie schaffen es "
    "einfach nicht, die Dunstschicht ueber dem Wasser zu zerteilen. ");
  AddDetail( ({ "dunst" }),
    "Gelblicher Dunst schwebt ueber der Wasserlache.");
  AddDetail( ({ "schwefel" }),
    "Der Geruch von Schwefel dringt von der Wasserstelle her an "
    "Deine Nase. Hier sollte man wohl lieber kein Feuer "
    "anzuenden, denn wer weiss schon, was alles passieren kann, "
    "wenn Schwefel mit Feuer in Beruehrung kommt...");
  AddDetail( ({ "nase" }),
    "Ein beissender Schwefelgeruch zieht von der Wasserstelle "
    "herueber und dringt tief in Deine schon leicht geroetete "
    "Nase hinein.");
  AddDetail( ({ "feuer" }),
    "Ich an Deiner Stelle wuerde hier lieber kein Feuer anzuenden.");
  AddDetail( ({ "beruehrung" }),
    "Wenn Schwefel mit Feuer in Beruehrung kommt, kann das boese enden.");
  AddDetail( ({ "stelle" }),
    "Ich bin zum Glueck nicht an Deiner Stelle. :-)");
  AddDetail( ({ "glueck" }),
    "Da hab ich aber nochmal Glueck gehabt.");
  AddDetail( ({ "waende" }),
    "An den Waenden laeuft in duennen Rinnsaelen Wasser herab. "
    "An einigen Stellen ueberdeckt eine hauchduenne Schicht "
    "Moos die Waende.");
  AddDetail( ({ "moos" }),
    "Das Moos hat eine etwas sonderbare blaeulichgruene Farbe. "
    "Es bedeckt nur einige Stellen an den Waenden und scheint "
    "sich aus der Feuchtigkeit, die hier unten herrscht, "
    "gebildet zu haben. Es fuehlt sich sehr weich und zart an, "
    "als Du darueberstreichst.");
  AddDetail( ({ "farbe" }),
    "Das Moos hat eine blaeulichgruene Farbe und schimmert leicht.");
  AddDetail( ({ "stellen" }),
    "Einige Stellen an den Waenden sind mit Moos bedeckt, das "
    "sich durch die Feuchtigkeit hier unten gebildet hat.");
  AddDetail( ({ "feuchtigkeit" }),
    "Es ist ein wenig feucht hier in dieser Hoehle.");
  AddDetail( ({ "schicht", "moosschicht" }),
    "Eine weiche Moosschicht bedeckt die Waende an einigen "
    "Stellen wie ein hauchduenner Pelz.");
  AddDetail( ({ "pelz" }),
    "Das Moos fuehlt sich sehr weich und seidig an.");
  AddDetail( ({ "decke" }),
    "Die Decke ist hier nicht sehr hoch. Du kannst deutlich "
    "erkennen, dass sie, ebenso wie die Waende und der Boden "
    "der Hoehle, aus schwarzem Vulkangestein besteht.");
  AddDetail( ({ "vulkangestein", "gestein" }),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "geruch", "schwefelgeruch" }),
    "Normalerweise riecht man Gerueche und untersucht sie nicht.");
  AddDetail( ({ "gerueche" }),
    "Den Geruch nach Schwefel zum Beispiel.");
  AddDetail( ({ "beispiel" }),
    "Hatten wir das nicht schon mal?");

  AddSound( DEFAULT_SOUND,
    "Es herrscht fast absolute Stille hier in der Hoehle. Nur "
    "ganz selten kannst Du einen Wassertropfen hoeren, der sich "
    "von der Wand herabloest und auf dem Boden landet.");

  AddSound( ({ "stille" }),
    "Es ist so still hier, dass Du fast glaubst, das Moos an "
    "den Waenden wachsen hoeren zu koennen.");
  AddSound( ({ "moos" }),
    "Du lauschst angestrengt, und tatsaechlich! Du kannst "
    "geradezu hoeren, wie das Moos langsam und stetig vor sich "
    "hin waechst und gedeiht.");
  AddSound( ({ "hoehle" }),
    "Es ist sehr still hier in der Hoehle.");
  AddSound( ({ "wassertropfen", "tropfen", "wasser", "boden" }),
    "Ab und zu tropft etwas Wasser mit einem leisen Platschen "
    "auf den Boden.");
  AddSound( ({ "platschen" }),
    "Das Platschen ist wirklich sehr leise.");
  AddSound( ({ "waende", "wand" }),
    "\"Der Lauscher an der Wand hoert seine eigene Schand.\n\""
    "Kommt Dir das bekannt vor?");
  AddSound( ({ "lauscher" }),
    "Das bist Du.");
  AddSound( ({ "schand" }),
    "Was hast Du bloss wieder angestellt?");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach Schwefel und Moos.");

  AddSmell( ({"schwefelgeruch", "schwefel" }),
    "Der schwefelige Geruch beisst in Deiner Nase.");
  AddSmell( ({ "moos" }),
    "Das Moos verstroemt einen sehr schwachen, etwas unangenehmen Geruch.");
  AddSmell( ({ "geruch" }),
    "Es riecht ein wenig nach Schwefel und Moos.");

  AddExit( "nordwesten", NW );
  AddExit( "westen", W );
  
  AddCmd( ({ "trinke", "trink" }), "cmdtrink" );
  AddCmd( ({ "pfluecke", "pflueck" }), "cmdpfluecken" );

}

// Schwefelwasser trinken
int cmdtrink(string str )
{

  notify_fail( "Was willst Du trinken?\n" );

  if(str == "wasser")
  {
    write(BS("Mit einem etwas angeekeltem Gesichtsausdruck schoepfst Du "
            +"eine Handvoll Wasser vom Boden und trinkst. Ob das "
            +"wirklich eine so gute Idee war?"));
    say(BS(PL->name()+" schoepft ein wenig Wasser aus der Wasserlache und "
                     +"trinkt es mit angeekeltem Gesicht."));
    TP->AddPoison(1); // scriptet wer?
    write_file(QUESTLOG "wasser.log", 
      dtime(time())+": "+CAP(getuid(TP))+" vergiftet sich!\n" );

    return 1;
  }
  return 0;
}

// Moos pfluecken
int cmdpfluecken(string str )
{

  notify_fail( "Was willst Du pfluecken?\n" );

  if(str == "moos")
  {
    write(BS("Du versuchst, etwas von dem sonderbaren Moos auszureissen, "
            +"bekommst jedoch nicht genuegend zu fassen, da die "
            +"Moosschicht auf den Waenden wirklich nur hauchduenn ist."));
    say(BS(PL->name()+" versucht, ein wenig Moos zu pfluecken."));
    return 1;
  }
  return 0;
}
