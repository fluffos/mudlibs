
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define OBEN "./raumC2"

// Ugly global variables ...
string way;
mixed richtungen;

string whichway();

void create() 
{

  ::create();

// Welche Richtungen sind zulaessig
  richtungen = ({ "norden","nordosten","osten","suedosten","sueden",
                  "suedwesten","westen","nordwesten" });  
// Welche Richtung ist die richtige?
  way = whichway();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du stehst mitten in einem sehr engen und sehr dunklen Gang. Es sind "
    "nur wenige Meter Platz hier, denn der Gang ist fast komplett "
    "eingestuerzt und es liegen viele Felsbrocken auf dem Boden herum. "
    "Von der Decke ragen ein paar spitze Felsstuecke herunter." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 0, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
    "Der Gang ist zu allen Seiten hin voellig eingestuerzt, so dass Du "
    "hier in keine einzige Richtung weiterkommst.");
  AddDetail( ({ "seiten" }),
    "Der Gang ist zu allen Seiten hin eingestuerzt.");
  AddDetail( ({ "richtung" }),
    "Du bist Dir ziemlich sicher, dass Du in keine einzige "
    "Richtung weiterkommst. Du kannst natuerlich trotzdem versuchen, "
    "Dir den Weg freizugraben, doch das wird wahrscheinlich nichts nuetzen.");
  AddDetail( ({ "weg" }),
    "Der Weg ist Dir in alle Richtungen versperrt.");
  AddDetail( ({ "meter" }),
    "Es ist sehr eng hier im Gang und Du musst hoellisch "
    "aufpassen, dass Du nirgends anstoesst und Dir keine blauen Flecken holst.");
  AddDetail( ({ "flecken", "fleck" }),
    "Einen dicken blauen Fleck hast Du schon. An Deinem linken Ellbogen.");
  AddDetail( ({ "ellbogen" }),
    "An Deinem linken Ellbogen schillert ein dicker blauer "
    "Fleck in allen moeglichen Farben.");
  AddDetail( ({ "farben" }),
    "Blau, Gruen und Lila sind besonders stark vertreten.");
  AddDetail( ({ "blau" }),
    "Es heisst ja schliesslich \"blauer Fleck\".");
  AddDetail( ({ "gruen" }),
    "Obwohl es eigentlich ein blauer Fleck ist, kannst Du auch "
    "ein wenig Gruen darin erkennen.");
  AddDetail( ({ "lila" }),
    "Das Blau verfaerbt sich langsam zu einem intensiven Lila.");
  AddDetail( ({ "platz" }),
    "Du hast hier nur sehr wenig Platz, um Dich frei zu bewegen.");
  AddDetail( ({ "felsbrocken" }),
    "Viele Felsbrocken in allen moeglichen Groessen sind ueberall auf "
    "dem Boden verstreut.");
  AddDetail( ({ "groessen" }),
    "Die Felsbrocken sind unterschiedlich gross und ungleichmaessig geformt.");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit unzaehligen grossen und kleinen Felsbrocken und "
    "Steinen uebersaeht. Du kannst Dich kaum frei bewegen, so eng ist es "
    "hier unten.");
  AddDetail( ({ "steine" }),
    "Viele grosse und kleine Steine aus Vulkangestein liegen hier herum.");
  AddDetail( ({"vulkangestein"}),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "decke" }),
    "In der Decke direkt ueber Dir siehst Du ein kleines Loch, durch das "
    "eine Leiter hinauffuehrt.");
  AddDetail( ({ "leiter" }),
    "Die Leiter fuehrt geradewegs nach oben. Ihre Eisensprossen sehen "
    "schon etwas verrostet aus, dennoch macht sie einen recht stabilen "
    "Eindruck.");
  AddDetail( ({ "eisensprossen", "leitersprossen" }),
    "Die Leitersprossen sind mit Rost ueberzogen, scheinen aber noch "
    "stabil genug zu sein, um Dein Gewicht tragen zu koennen.");
  AddDetail( ({ "rost" }),
    "Die Leiter ist ein wenig rostig.");
  AddDetail( ({ "gewicht" }),
    "Auch wenn Du in letzter Zeit ein wenig an Gewicht zugelegt hast, "
    "sollte Dich die Leiter problemlos tragen koennen.");
  AddDetail( ({ "zeit" }),
    "Dafuer hast Du jetzt wirklich keine Zeit.");
  AddDetail( ({ "eindruck" }),
    "Die Leiter macht einen recht stabilen Eindruck.");
  AddDetail( ({ "loch" }),
    "Das Loch ist gerade gross genug fuer Dich.");
  AddDetail( ({ "felsstuecke", "stuecke" }),
    "Einige ziemlich scharfkantige Felsstuecke ragen von der Decke herab. "
    "Eines der Stuecke sieht ein wenig wackelig aus.");
  AddDetail( ({ "stueck" }),
    "Das Felsstueck sieht so aus, als wuerde es bald der Schwerkraft "
    "nachgeben und herunterfallen.");
  AddDetail( ({ "schwerkraft" }),
    "Dieses Felsstueck wird, wie eigentlich auch alle anderen Dinge, von "
    "der Erde angezogen.");
  AddDetail( ({ "dinge" }),
    "Zum Beispiel dieses aeusserst scharfkantige Felsstueck, das da "
    "direkt ueber Dir an der Decke haengt.");
  AddDetail( ({ "beispiel" }),
    "Dieses Felsstueck ist nur ein Beispiel.");
  AddDetail( ({ "erde" }),
    "Die Schwerkraft der Erde zieht alle Dinge in Richtung des Erdmittelpunkts.");
  AddDetail( ({ "erdmittelpunkt", "mittelpunkt" }),
    "Der Mittelpunkt der Erde befindet sich etliche Kilometer weit unter Dir.");
  AddDetail( ({ "kilometer" }),
    "Die Entfernung von Dir bis zum Mittelpunkt der Erde kannst Du nicht ganz "
    "genau bestimmen, Du bist Dir aber sicher, dass es ziemlich viele Kilometer sind.");
  AddDetail( ({ "entfernung" }),
    "Die Strecke zwischen Dir und dem Erdmittelpunkt.");
  AddDetail( ({ "strecke" }),
    "Eine Strecke ist ... aber nein, lassen wir das lieber.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind zu allen Seiten hin voellig eingestuerzt "
    "und Du siehst ueberall nur Felsbrocken und Steine herumliegen.");

  AddSound( DEFAULT_SOUND,
    "Es ist ziemlich leise hier unten, nur ein sehr schwaches, "
    "dumpfes Geraeusch dringt durch das Loch von oben herab.");

  AddSound( ({ "geraeusch", "geraeusche" }),
    "Du weisst nicht genau, was es ist, aber es hoert sich unheimlich an.");
  AddSound( ({ "loch" }),
    "Du hoerst aeusserst merkwuerdige Geraeusche von oben.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft hier unten ist abgestanden und es riecht etwas staubig. "
    "Durch das Loch an der Decke zieht ein widerlicher Gestank herunter.");

  AddSmell( ({ "luft" }),
    "Die Luft riecht trocken und abgestanden.");
  AddSmell( ({ "decke", "loch"}),
    "Ein widerlicher Gestank kommt durch das Loch herunter.");
  AddSmell( ({ "gestank" }),
    "Pfuuh! Es stinkt wirklich bestialisch!");
  AddSmell( ({ "staub" }),
    "Es riecht ein wenig staubig hier.");

  AddExit( "oben", OBEN );
  
  AddCmd( ({ "grabe", "grab" }), "grabe" );

}

int grabe(string str)
{
  string richtung;
  object obj;
  int i;
  
  if((!str) || (sscanf(str,"weg nach %s frei", richtung) != 1)) 
  { 
    write("In welche Richtung willst Du den Weg freigraben?\n"
         +"Hinweis:<grabe weg nach ... frei>\n");
    return -1; 
  }

  if(member(richtungen,richtung) == -1) 
  { 
    write("In welche Richtung willst Du den Weg freigraben?\n"
         +"Hinweis:<grabe weg nach ... frei>\n");
    return -1; 
  }

  if(!present("schaufel", TP))
  {
  	notify_fail( "Womit willst Du denn den Weg freigraben?\n");
  	return 0;
  }

  if(richtung == way)
  {
    write(BS("Muehsam graebst Du Dir einen schmalen Durchgang in die Felswand im "
             +capitalize(richtung)+" und kletterst wagemutig hindurch. "));
    say(BS(PL->Name()+" hantiert angestrengt an einer Felswand herum und "
            +"verschwindet dann spurlos.")); 
    // Spieler moven
    call_other(ROOM "schatzraum2", "???", 0);
    obj = find_object(ROOM "schatzraum2");
    if(obj)
    {
      TP->move(obj, M_NOCHECK|M_SILENT);
      obj->Message(BS(TP->Name()+" kriecht herein."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      return 1;
    }
    else
    {
      write("Fehler! Bitte melde ihn an Torian.\n");
      return 1;
    }
  }
  
  // Nicht zu erschoepft? :)
  if(!TP->do_exhaust(200 + random(200))) 
  { 
  	write(BS("Du bist zu erschoepft, um graben zu koennen!"));
  	return -1; 
  }

  switch(random(7))
  { 
    case 1:
      write(BS("Kraftvoll stoesst Du Deine Schaufel in den Steinhaufen und "
              +"buddelst fleissig herum. Ploetzlich prasseln lauter kleine und "
              +"groessere Steinbrocken auf Dich herab und verletzen Dich an der "
              +"Schulter."));
      say(BS(PL->Name()+" hantiert an einer Felswand herum und wird von "
              +"heinem Haufen herunterprasselnder Steine getroffen.")); 
      TP->do_damage(20 + random(20), TO);
    break;
    case 2:
      write(BS("Kraftvoll stoesst Du Deine Schaufel in den Steinhaufen und "
              +"buddelst fleissig herum. Ploetzlich prasseln lauter kleine und "
              +"groessere Steinbrocken auf Dich herab und verletzen Dich an am "
              +"Ruecken."));
      say(BS(PL->Name()+" hantiert an einer Felswand herum und wird von "
              +"heinem Haufen herunterprasselnder Steine getroffen.")); 
      TP->do_damage(20 + random(20), TO);
    break;
    case 3:
      write(BS("Mit aller Kraft versuchst Du, Dir einen Weg nach "
              +capitalize(richtung)+" freizugraben, doch die Felsen sind "
              +"einfach zu hart und zu schwer fuer Deine kleine Schaufel."));
      say(BS(PL->Name()+" hantiert voellig sinnlos an einer Felswand herum.")); 
    break;
    case 4:
      write(BS("Mit aller Kraft versuchst Du, Dir einen Weg nach "
              +capitalize(richtung)+" freizugraben, doch hier liegen einfach "
              +"zu viele schwere und grosse Felsen herum, als dass Du mit "
              +"Deiner Schaufel dagegen ankommen koenntest."));
      say(BS(PL->Name()+" hantiert voellig sinnlos an einer Felswand herum.")); 
    break;
    case 5:
      write(BS("Du buddelst keuchend und schnaufend in dem Steinhaufen herum, "
              +"doch es rutschen immer wieder Felsbrocken nach."));
      say(BS(PL->Name()+" hantiert angestrengt an einer Felswand herum.")); 
    break;
    case 6:
      write(BS("Du graebst und graebst und graebst nach "+capitalize(richtung)
             +", kommst aber nicht gegen die vielen Steinmassen an, die sich "
             +"vor Dir auftuermen."));
      say(BS(PL->Name()+" hantiert keuchend an einer Felswand herum.")); 
    break;
    default:
      write(BS("Du verausgabst Dich voellig bei dem Versuch, Dir einen Weg "
             +"freizugraben und sinkst erschoepft zu Boden."));
      say(BS(PL->Name()+" hantiert angestrengt an einer Felswand herum und "
             +"sinkt dann voellig erschoepft zu Boden.")); 
    break;
  }  
  return -1;
}

// Debugzwecke
string QueryWay()
{
  return way;
}
// Was ist der richtige Ausgang?
string whichway()
{
  return richtungen[random(sizeof(richtungen)-1)]; 
}

reset()
{
  ::reset();
  
// Pro Reset neuer Weg
  way = whichway();
}
