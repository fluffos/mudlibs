
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define C1 "./raumC1"
#define B3 "./raumB3"

void create() 
{

  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du gehst einen dunklen, schmalen Gang entlang, der sich im "
    "Nordosten sehr stark zu verengen scheint und im Sueden in eine "
    "groessere Hoehle hineinfuehrt. Die Waende sind mit kleinen Loechern "
    "und engen Spalten ueberzogen. Auf dem Boden sind einige Spuren zu "
    "sehen, die nach Nordosten fuehren." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddExit( "sueden", B3 );
  AddExit( "nordosten", C1 );

  AddDetail( ({ "gang" }),
    "Du folgst einem dunklen, schmalen Gang, der sich im Nordosten sehr "
    "stark zu verengen scheint und im Sueden in eine groessere Hoehle "
    "fuehrt.");
  AddDetail( ({ "nordosten" }),
    "Im Nordosten wird der Gang immer enger und niedriger.");
  AddDetail( ({ "sueden" }),
    "Suedlich von Dir befindet sich eine groessere Hoehle. Irgendetwas "
    "scheint dort zu sein, doch von hier aus kannst Du es nicht genauer "
    "erkennen.");
  AddDetail( ({ "hoehle" }),
    "Im Sueden befindet sich eine groessere Hoehle.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind mit vielen kleinen Loechern und engen Spalten "
    "ueberzogen.");
  AddDetail( ({ "loecher" }),
    "Die Loecher scheinen gerade gross genug zu sein, dass Du mit Deiner "
    "Hand hineingreifen kannst.");
  AddDetail( ({ "hand", "haende" }),
    "Du hast zwei Haende, Wahnsinn!");
  AddDetail( ({ "wahnsinn" }),
    "Die Einsamkeit ist die liebste Gespielin des Wahnsinns.");
  AddDetail( ({ "einsamkeit", "einsam" }),
    "Du fuehlst Dich beobachtet. Ob Du wirklich alleine bist?");
  AddDetail( ({ "gespielin" }),
    "Bald wird sie auch mit Dir spielen...");
  AddDetail( ({ "spalten" }),
    "Die ueblichen verdaechtigen Spalten. Na los, greif endlich rein!");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit unzaehligen kleinen und einigen groesseren Spuren "
    "bedeckt.");
  AddDetail( ({ "spuren" }),
    "Der ganze Boden ist mit unzaehligen kleinen Spuren bedeckt, die "
    "allesamt in den Norden fuehren. Eine Spur ist besonders deutlich zu "
    "erkennen.");
  AddDetail( ({ "spur" }),
    "Sie stammt unzweifelhaft von einer grossen Hoehlenechse.");
  AddDetail( ({ "hoehlenechse", "echse", "echsen", "hoehlenechsen" }),
    "Was hat die Hoehlenechse hier nur gesucht? War sie auf Futtersuche?");
  AddDetail( ({ "futtersuche" }),
    "Hoehlenechsen ernaehren sich hauptsaechlich von Spinnen oder Ratten, "
    "manchmal sind sie allerdings auch einem groesseren Stueck Fleisch "
    "nicht abgeneigt.");
  AddDetail( ({ "ratten" }),
    "Ratten stehen ebenso wie Spinnen auf dem Speiseplan der "
    "Hoehlenechsen.");
  AddDetail( ({ "spinnen" }),
    "Hier unten gibt es viele Spinnen.");
  AddDetail( ({ "speiseplan" }),
    "Hoehlenechsen ernaehren sich hauptsaechlich von Spinnen oder Ratten.");
  AddDetail( ({ "stueck", "fleisch" }),
    "Manchmal fressen die ausgewachsenen Echsen auch groessere Lebewesen als "
    "Ratten.");
  AddDetail( ({ "lebewesen", "abenteurer" }),
    "Zum Beispiel verirrte Abenteurer wie Dich.");
  AddDetail( ({ "beispiel" }),
    "Nur ein Beispiel.");
  AddDetail( ({ "sueden" }),
    "Im Sueden vergroessert sich die Hoehle.");
  AddDetail( ({ "norden" }),
    "Viele Spuren fuehren in den Norden. Etwas Vorsicht waere ratsam.");
  AddSpecialDetail( ({ "vorsicht" }), "DetailVorsicht");
  AddDetail( ({ "nordosten" }),
    "Der Gang verengt sich im Nordosten.");
  AddSpecialDetail( ({ "nase" }), "DetailNase");
  AddDetail( ({ "decke" }),
    "Die Decke ist sehr niedrig, pass bloss auf, dass Du "
    "Dir nicht den Kopf anstoesst.");
  AddDetail( ({ "kopf" }),
    "Du tastest Deinen Kopf ab.");

  AddSound( DEFAULT_SOUND,
    "Aus dem Norden dringen einige merkwuerdige Geraeusche.");
  AddSound( ({ "Norden" }),
    "Geh einfach mal hin.");
  AddSound( ({ "geraeusche" }),
    "Klingt fast wie ein Kratzen.");
  AddSound( ({ "kratzen" }),
    "Von wem diese Geraeusche wohl stammen?");

  AddSmell( DEFAULT_SMELL,
    "Ein etwas strenger Geruch durchzieht den Raum. Er kommt aus dem "
    "Norden.");
  AddSmell( ({ "geruch" }),
    "Ein strenger Geruch dringt aus dem Norden hierher.");
  AddSmell( ({ "raum" }),
    "Du haeltst Deine Nase in die Luft und schnueffelst.");
  AddSmell( ({ "luft" }),
    "Die Luft riecht hier ein wenig streng.");
  AddSmell( ({ "norden" }),
    "Der Geruch kommt aus dem Norden.");
   
  AddCmd( ({ "greife", "greif" }), "cmdgreife" );
}

string DetailVorsicht(string key)
{
  string s;
  int vorsicht;
  vorsicht = this_player()->QueryProp(P_WIMPY);
  if (vorsicht > 0)
  {
    s = "Deine Vorsicht betraegt: "+vorsicht+".";
  }
  else
  {
  	s = "Na, Du Moechtegern-Prinz-Eisenherz, wieder die Vorsicht vergessen?";
  }
  return BS(s);
}

string DetailNase(string str)
{
  this_player()->command_me("schiele");
  return "";
}

int cmdgreife(string str)
{
  notify_fail( "Wohin willst Du greifen?\n" );
  if((str == "in loecher") || (str == "in loch"))
  {
    write(BS("Du greifst neugierig in eines der Loecher und findest ... "
            +"nichts. Enttaeuscht ziehst Du Deine Hand wieder aus dem Loch "
            +"heraus."));
    say(BS(PL->Name()+" fummelt an der Wand rum.")); 
    return 1;
  }
  if((str == "in spalte") || (str == "in spalten") || (str == "in spalt"))
  {
    write(BS("Du tastest alles ab, findest aber nichts."));
    say(BS(PL->Name()+" fummelt an der Wand rum."));
    return 1;
  }
  return 0;
}
