#include "../def.h"

inherit "std/room";

#include <properties.h>

#define B1 ROOM "raumB1"
#define B2 "./raumB2"
#define D1 "./raumD1"
#define C1 "./raumC1"

int echse;
object babyechse, obj;

void create() 
{

  ::create();

  echse = DA;
  SetProp( P_INT_SHORT, "Am Rand einer Hoehle" );
  SetProp( P_INT_LONG,
    "Der schmale Gang fuehrt weiter am Rand der Hoehle entlang und "
    "verengt sich in westlicher Richtung immer mehr. Im Osten steigt er "
    "ein wenig an, waehrend er nach Westen hin weiter abfaellt. Die "
    "Waende sind mit kleinen Loechern und engen Spalten ueberzogen. Auf "
    "dem Boden siehst Du sehr viele Spuren, die nach Westen fuehren." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
    "Der Gang fuehrt am Rand der Hoehle entlang. Er ist hier sehr "
    "niedrig und verengt sich nach Westen hin immer mehr, so dass Du "
    "dort kaum noch aufrecht stehen kannst. Im Osten steigt er etwas an, "
    "waehrend das Gefaelle nach Westen hin etwas zunimmt.");
  AddDetail( ({ "rand" }),
    "Dieser dunkle Gang fuehrt am noerdlichen Hoehlenrand entlang.");
  AddDetail( ({ "hoehlenrand" }),
    "Nach Norden hin geht es nicht mehr weiter.");
  AddDetail( ({ "norden" }),
    "Ende, Schluss, aus, vorbei.");
  AddDetail( ({ "ende" }),
    "Mach doch mal \"Ende\". ;)");
  AddDetail( ({ "schluss" }),
    "Nun ist aber Schluss!");
  AddDetail( ({ "hoehle" }),
    "Die grosse Hoehle liegt weiter im Osten.");
  AddDetail( ({ "osten" }),
    "Im Osten steigt der Gang etwas an. Wenn Du ihm folgst, gelangst Du "
    "wieder in die grosse Haupthoehle.");
  AddDetail( ({ "haupthoehle" }),
    "Um in die Haupthoehle zu gelangen, musst Du dem Gang in oestlicher "
    "Richtung folgen.");
  AddDetail( ({ "richtung", "richtungen" }),
    "Osten, Westen, Norden... all dies sind Richtungen. Und es gibt noch "
    "viele derer mehr.");
  AddDetail( ({ "westen" }),
    "Nach Westen hin faellt der Gang etwas ab und wird immer enger und "
    "niedriger, so dass Du dort kaum noch aufrecht stehen kannst. Die "
    "Spuren auf dem Boden fuehren in diese Richtung.");
  AddDetail( ({ "loecher" }),
    "Die Loecher scheinen gerade gross genug zu sein, dass Du mit Deiner "
    "Hand hineingreifen kannst.");
  AddDetail( ({ "hand" }),
    "Deine Hand ist gerade klein genug, dass Du mit ihr in die Loecher "
    "hineingreifen kannst.");
  AddDetail( ({ "spalten" }),
    "An den Spalten entdeckst Du nichts besonderes.");
  AddDetail( ({ "spuren" }),
    "Du siehst unzaehlige winzig kleine Spuren auf dem Boden. "
    "Zwischendurch sind auch einige etwas groessere Spuren zu sehen.");
  AddDetail( ({ "kleine spuren", "winzige spuren" }),
    "Der ganze Boden ist mit unzaehligen kleinen Spuren bedeckt, die "
    "allesamt in den Westen fuehren. Dir faellt eine besonders winzige "
    "Spur auf, die irgendwie anders zu sein scheint als die anderen.");
  AddDetail( ({ "spur", "winzige spur" }),
    "Diese Spur scheint nicht wie die anderen nach Westen, sondern "
    "stattdessen zur Nordwand hin zu fuehren.");
  AddDetail( ({ "nordwand", "wand" }),
    "Die Nordwand ist mit kleinen Loechern und Spalten bedeckt und sieht "
    "eigentlich genauso aus wie die anderen Waende ringsherum. Doch "
    "halt, in einer Ecke der Wand siehst Du eine kleine, dunkle Nische.");
  AddDetail( ({ "ecke" }),
    "In einer Ecke an der Nordwand befindet sich eine kleine Nische.");
  AddDetail( ({ "nische" }),
    "In der Nische ist es sehr dunkel, so dass Du nichts genaueres "
    "erkennen kannst. Ploetzlich glaubst Du, eine Bewegung und einen "
    "kleinen Schatten zu sehen.");
  AddDetail( ({ "bewegung" }),
    "Vielleicht hast Du Dich doch bloss getaeuscht. Vielleicht aber auch "
    "nicht.");
  AddDetail( ({ "schatten" }),
    "Du bildest Dir ein, einen kleinen Schatten in der Nische erkennen "
    "zu koennen. Ob sich dort drinnen etwas versteckt?");
  AddDetail( ({ "etwas" }),
    "Ob Du es irgendwie aufscheuchen kannst?");
  AddDetail( ({ "grosse spuren", "groessere spuren" }),
    "Zwischen den unzaehlig vielen kleinen Spuren kannst Du auch einige "
    "etwas groessere Spuren entdecken.");
  AddDetail( ({ "waende" }),
    "Die Waende sind mit vielen kleinen Loechern und engen Spalten "
    "ueberzogen.");
  AddDetail( ({ "gefaelle" }),
    "Das Gefaelle nimmt nach Westen hin etwas zu.");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit unzaehligen kleinen und einigen groesseren Spuren "
    "bedeckt, die nach Westen fuehren.");
  AddDetail( ({ "decke" }),
    "Die Decke ist hier im Gang sehr niedrig. Pass bloss auf, dass Du "
    "Dir nicht den Kopf anstoesst.");
  AddDetail( ({ "kopf" }),
    "Autsch! Jetzt hast Du Dir den Kopf an der Decke gestossen. Das gibt "
    "bestimmt wieder eine Beule.");
  AddDetail( ({ "beule" }),
    "Besorgt befuehlst Du Deinen Kopf. Du kannst jetzt schon spueren, "
    "wie dort eine mittelgrosse Beule entsteht. Du brummst missmutig vor "
    "Dich hin und nimmst Dir vor, in Zukunft etwas vorsichtiger zu sein.");
  AddDetail( ({ "zukunft" }),
    "Wie die Zukunft aussieht, weisst Du nicht.");
  AddDetail( ({ "nase" }),
    "Deine Nase juckt schon ganz schrecklich von der vielen Herumriecherei.");
  AddDetail( ({ "herumriecherei" }),
    "Na, wie wuerdest Du das bezeichnen, was Du hier gerade tust?");

  AddSound( DEFAULT_SOUND,
    "Aus dem Westen dringen einige merkwuerdige Geraeusche.");
  AddSound( ({ "westen" }),
    "Geh einfach mal hin.");
  AddSound( ({ "geraeusche" }),
    "Vielleicht solltest Du dem mal nachgehen.");

  AddSmell( DEFAULT_SMELL,
    "Ein etwas strenger Geruch durchzieht den Raum. Er kommt aus dem "
    "Westen.");
  AddSmell( ({ "geruch" }),
    "Ein strenger Geruch dringt aus dem Westen hierher.");
  AddSmell( ({ "raum" }),
    "Du haeltst Deine Nase in die Luft und schnueffelst.");
  AddSmell( ({ "luft" }),
    "Die Luft riecht hier ein wenig streng.");
  AddSmell( ({ "westen" }),
    "Der Geruch kommt aus dem Westen.");
// wird eine hoehlenechse
  AddItem(NPC "hoehlenechse", REFRESH_DESTRUCT);
  
  AddCmd( ({ "greife", "greif" }), "cmdgreife" );
  AddCmd( ({ "scheuche", "scheuch" }), "cmdscheuch" );

  AddExit( "westen", B1 );
  AddExit( "suedwesten", B2 );
  AddExit( "osten", D1 );

}
int cmdgreife(string str)
{
  notify_fail( "Wohin willst Du greifen?\n" );
  if((str == "in loecher") || (str == "in loch"))
  {
    write(BS("Du greifst neugierig in eines der Loecher und findest ... "
            +"nichts. Enttaeuscht ziehst Du Deine Hand wieder aus dem Loch "
            +"heraus."));
    say(BS(PL->Name()+" fummelt an der Wand rum.")); 
    return 1;
  }
  if((str == "in spalte") || (str == "in spalten") || (str == "in spalt"))
  {
    write(BS("Du tastest alles ab, findest aber nichts."));
    say(BS(PL->Name()+" fummelt an der Wand rum."));
    return -1;
  }
  return 0;
}
int cmdscheuch(string str)
{
  notify_fail( "Was willst Du aufscheuchen?\n" );
  if(str == "etwas auf") 
  {
    if(echse == DA)
    {
      write(BS("Du stocherst ein wenig mit den Fingern in der Nische herum. "
              +"Auf einmal durchzuckt Dich ein stechender Schmerz und Du "
              +"ziehst schnell Deine Hand wieder heraus. Weinerlich steckst "
              +"Du Deinen blutenden Zeigefinger in den Mund und lutscht ein "
              +"wenig daran herum."));
      say(BS(PL->Name()+" stochert eine Weile in einer Nische herum und "
            +"verzieht dann schmerzhaft das Gesicht. Weinerlich steckt "
            +PL->Name()+" "+(PL->QueryProp(P_GENDER)==MALE?"seinen":"ihren")
            +" blutenden Zeigefinger in den Mund und lutscht daran herum.")); 
      call_out("echse",6);
      echse = WEG;
      return 1;
    }
    else
    {
      write(BS("Du stocherst ein wenig mit den Fingern in der Nische herum, "
              +"doch sie ist leider leer. Du hast Dich wohl doch getaeuscht."));
      say(BS(PL->Name()+" stochert eine Weile in einer Nische herum, findet "
         +"jedoch nichts und laesst enttaeuscht die Schultern haengen."));
      return -1;
    }
  }
  return 0;
}
void echse()
{
  babyechse = clone_object(NPC "babyechse");
  if(babyechse)
  {
    babyechse->SetProp(P_SHORT,"Eine mutige kleine Hoehlenechse");
    babyechse->SetProp(P_NAME_ADJ,({ "mutig", "klein" }));
    babyechse->move(TO,M_GO|M_SILENT);
  }
  else
  {
  	// debug ausgabe
  	write(BS("Konnte die Echse nicht Clonen!"));
  }
  write(BS("Eine kleine Echse springt aus der Nische und schaut Dich empoert "
          +"aus winzig kleinen Aeuglein an."));
  say(BS("Ploetzlich springt eine kleine Echse aus der Nische."));
  call_out("echse_weg",5+random(10));
}
void echse_weg()
{
  if(babyechse)
  {
  	babyechse->AddId("\nMUTIGEECHSE");
    babyechse->move(B1,M_GO|M_NOCHECK,"nach Westen","wuselt blitzschnell",
                                  "wuselt herein");
  }
}

reset()
{
  ::reset();

  echse = DA; 


  // Echse beim Nest entfernen ...
  call_other (B1, "???", 0);
  obj = find_object(B1);
  if(obj)
  {
    babyechse = present("\nMUTIGEECHSE", obj);
    if(babyechse)
    {
  	  tell_room(obj, "Die kleine Hoehlenechse laeuft mutig nach Osten.\n");
  	  babyechse->remove();
    }
  }
}
