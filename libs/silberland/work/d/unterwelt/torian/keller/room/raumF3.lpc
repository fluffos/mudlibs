#include "../def.h"

inherit "std/room";

#include <properties.h>

#define NW "./raumE2"
#define SW "./raumE4"
#define N "./raumF2"

#define KELLER  "/d/unterwelt/torian/haus/room/weinkeller"
//#define KELLER "/players/torian/bsp/haus/room/weinkeller"
#define FACKEL "/obj/fackel"
// Spieler eine Fackel pro reset, 5 Fackeln maximal
int fackel, fackelstaender;
string *spieler;

void create() 
{

  ::create();

  fackel = AUS;
  fackelstaender = 0;
  spieler = ({ });
 
  SetProp( P_INT_SHORT, "Kellertreppe" );
  SetProp( P_INT_LONG,
    "Du stehst am unteren Ende der langen Steintreppe in einer grossen "
    "Hoehle. Im Westen und im Sueden ragen riesige Saeulen hinauf, die "
    "von zwei breiten Gaengen nach Nordwesten und Suedwesten umrundet "
    "werden. Nach Norden hin wird die Hoehle etwas breiter und fuehrt "
    "tiefer in den natuerlicheren, weniger durch Menschen bearbeiteten "
    "Teil hinein.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "raum", "hoehle" }), QueryProp(P_INT_LONG));
  AddDetail( ({ "menschen", "teil" }),
    "In diesem Teil der Hoehle haben Menschen eine grobe Treppe in den "
    "Stein hinein gehauen, waehrend die Hoehle nach Norden hin fast "
    "voellig in ihrem natuerlichen Zustand belassen wurde.");
  AddDetail( ({ "zustand" }),
    "Im Norden wurde die Hoehle fast voellig in ihrem natuerlichen "
    "Zustand belassen.");
  AddDetail( ({ "norden" }),
    "Die Hoehle wird nach Norden hin etwas breiter und fuehrt tiefer in "
    "den natuerlicheren, weniger durch Menschen bearbeiteten Teil "
    "hinein.");
  AddDetail( ({ "saeulen" }),
    "Im Westen und im Sueden ragen riesige Steinsaeulen hinauf. Sie "
    "haben eine glaenzende, fast spiegelglatte Oberflaeche und sind in "
    "der Mitte rund und schmal, waehrend sie zum Boden und zur Decke hin "
    "breiter und etwas unfoermiger werden.");
  AddDetail( ({ "steinsaeule", "steinsaeulen" }),
    "Die Saeulen bestehen, wie fast alles hier unten, aus Vulkangestein.");
  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche der Saeulen glaenzt tiefschwarz und ist fast "
    "spiegelglatt.");
  AddDetail( ({ "mitte" }),
    "Mittig sind die Saeulen rund und schmal, waehrend sie zum Boden und "
    "zur Decke hin breiter und unfoermiger werden.");
  AddDetail( ({ "gaenge" }),
    "Zwei breite Gaenge umrunden die Saeulen nach Nordwesten und "
    "Suedwesten hin.");
  AddDetail( ({ "nordwesten", "suedwesten" }),
    "Nach Nordwesten und Suedwesten fuehren enge Gaenge um die Saeulen "
    "herum.");
  AddDetail( ({ "ende" }),
    "Du stehst am unteren Ende einer langen Steintreppe.");
  AddDetail( ({ "steintreppe", "treppe" }),
    "Die Treppe wurde in den Stein hinein gehauen und fuehrt in einem "
    "grossen Bogen weit hinauf.");
  AddDetail( ({ "stein" }),
    "Hier unten ist fast alles aus schwarzem Vulkangestein.");
  AddDetail( ({"gestein", "vulkangestein"}),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "bogen" }),
    "Die Treppe macht einen grossen Bogen.");
  AddDetail( ({ "westen" }),
    "Im Westen ragt eine riesige Steinsaeule auf.");
  AddDetail( ({ "sueden" }),
    "Im Sueden ragt eine riesige Steinsaeule auf.");
  AddDetail( ({ "boden" }),
    "Der Boden ist aus schwarzem Vulkangestein. In einer Ecke siehst Du "
    "einen eisernen Fackelstaender stehen.");
  AddDetail( ({ "ecke" }),
    "In der Ecke steht ein eiserner Fackelstaender. In dem Staender befinden "
    "sich ein paar Fackeln.");
  AddDetail( ({ "fackelstaender", "staender" }),
    "Der Fackelstaender besteht aus duennen Eisenstreben, die zu einem "
    "hohen Staender zusammengefuegt wurden. In dem Staender befinden "
    "sich ein paar Fackeln. Dir kommen Zweifel, warum Mabruk hier Fackeln "
    "lagern sollte.");
  AddDetail( ({ "mabruk", "besitzer" }),
    "Mabruk ist der Besitzer des Hauses und des Kellers.");
  AddDetail( ({ "haus" }),
    "Das Haus befindet sich ueber Dir.");
  AddDetail( ({ "keller" }),
    "Wo befindest Du Dich gerade?\nRichtig, am Strand.");
  AddDetail( ({ "strand", "sandstrand" }),
    ([0: "Du traeumst von einem wunderschoenen Sandstrand und viel Sonne.", 
      "dunkelelf": "Du traeumst von einem wunderschoenen Sandstrand im "
                  +"Schein des Mondes."]) );
  AddDetail( ({ "schein", "augen" }),
    ([0: "Sowas siehst Du da nicht!", // der Default-Text
      "dunkelelf": "Der Schein des Mondes ist auch fuer Deine Augen nicht "
                   "schaedlich."]) );
  AddDetail( ({ "sonne" }),
    "Du suchst die Sonne, findest aber nichts.");
  AddDetail( ({ "mond" }),
    "Du suchst den Mond, findest aber nichts.");
  AddDetail( ({ "zweifel" }),
    "Als maechtiger Magier ist Mabruk sicher nicht auf Fackeln als Lichtquellen "
    "angewiesen.");
  AddDetail( ({ "lichtquelle", "lichtquellen" }),
    "Fackeln zum Beispiel.");
  AddDetail( ({ "beispiel" }),
    "Nur ein Beispiel.");
  AddDetail( ({ "magier", "personen" }),
    "Magier sind Personen, die sich des Uebernatuerlichen bedienen.");
  AddDetail( ({ "streben", "eisenstreben" }),
    "Duenne, lange Eisenstreben wurden zu einem hohen und stabilen "
    "Fackelstaender zusammengefuegt.");
  AddDetail( ({ "decke" }),
    "Die Decke ist so hoch, dass Du sie kaum noch erkennen kannst.");
  AddDetail( ({ "fackelhalter", "halter" }),
    "Die Fackelhalter bestehen aus einfachen Eisenstaeben, die an der "
    "Wand befestigt sind. In jedem der Fackelhalter steckt eine Fackel.");
  AddDetail( ({ "eisenstab", "eisenstaebe" }),
    "Einfache Eisenstaebe, die zu Haltern geformt und an der Wand "
    "befestigt sind. Sie sind ziemlich verrostet.");
  AddDetail( ({ "eisen" }),
    "Das Eisen ist schon ziemlich verrostet.");    
  AddDetail( ({"zeit"}),
    "Anscheinend ist schon sehr lange niemand mehr hier unten gewesen.");
  AddDetail("schatten",
  	"Beim genaueren Hinsehen erkennst Du, dass es Fackelhalter sind, die "
  	"an der Wand entlang der Treppe befestigt sind.");  
  AddSpecialDetail( ({ "steintreppe", "treppe" }), "strtreppe");
  AddSpecialDetail( ({ "fackel", "fackeln"}), "strfackel");
  AddSpecialDetail( ({ "waende", "wand"}), "strwand");
 
  AddSound( DEFAULT_SOUND,
    "Es ist sehr still hier unten. Ab und zu glaubst Du, etwas zu "
    "hoeren, bist Dir aber nicht wirklich sicher.");
  AddSound( ({ "stille" }),
    "Hier unten ist es wirklich sehr still.");
  AddSound( ({ "etwas" }),
    "War da nicht gerade etwas? Oder hast Du Dich doch getaeuscht?");

  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht ein wenig abgestanden.");

  AddSmell( ({ "luft" }),
    "Es war wohl schon lange niemand mehr hier unten.");

  AddCmd( ({ "zuende", "zuend" }), "cmdzuenden" );
  AddCmd( ({ "loesch", "loesche" }), "cmdloesche" );
  AddCmd( ({ "nimm", "nehme", "nehm" }), "cmdnehmen" );

  AddExit( "norden", N );
  AddExit( "nordwesten", NW );
  AddExit( "suedwesten", SW );
  AddExit ("ostoben", ([ EX_DEST:     KELLER,
                         EX_TESTFUNC: "exit_test",
                         EX_MSG: "die Steintreppe hinauf" ]) );
  AddExit ("osten", ([ EX_DEST:     KELLER,
                       EX_TESTFUNC: "exit_test",
                       EX_MSG: "die Steintreppe hinauf" ]) );
  SetProp(P_HIDE_EXITS, ({ "osten" }));
}


string strwand(string str)
{
  string s;
  s = "Im Westen und im Sueden ragen riesige Steinsaeulen hinauf und im "
     +"Osten fuehrt die Steintreppe aus der Hoehle hinaus. ";    
  if(fackel == AUS)
  {
    s += "Entlang der Wand direkt neben der Treppe fallen Dir merkwuerdige "
        +"Schatten auf.";
  }
  else
  {
    s += "Entlang der Wand direkt neben der Treppe sind Fackelhalter "
        +"befestigt.";
  }
  return BS(s);
}
string strfackel(string str)
{
  string s;
  if(fackel == AUS)
  {
    s = "Die Fackeln sehen so aus, als ob sie schon sehr lange Zeit nicht "
       +"mehr benutzt wurden. Ob sie wohl noch brennen, wenn Du sie "
       +"anzuendest?";
  }
  else
  {
    s = "Die Fackeln brennen und werfen einen flackernden Lichtschein in "
       +"den Raum.";
  }
  return BS(s);
}
// Treppe mit angezuendeten Fackeln (Fackelhalter zu erkennen) oder ohne 
// (schatten)
string strtreppe(string str)
{
  string s;
  s = "Die Treppe wurde in den Stein hinein gehauen und fuehrt in einem "
     +"grossen Bogen weit hinauf. ";
  if(fackel == AUS)
  {
    s += "An der Wand entlang der Treppe fallen Dir merkwuerdige Schatten "
        +"auf.";
  }
  else
  {
    s += "An der Wand entlang der Treppe sind in regelmaessigen Abstaenden "
        +"einige Fackelhalter befestigt.";
  }
  return BS(s);
}
// Anzuenden der Fackeln in den Halterungen.
int cmdzuenden(string str )
{
  notify_fail( "Was willst Du anzuenden?\n" );
  if( str == "fackel an")
  {
    if(fackel == AUS)
    {
      write(BS("Du findest noch ein kleines Streichholz in Deiner Tasche "
      +"und zuendest die Fackeln vorsichtig damit an. Als das Hoelzchen fast "
      +"abgebrannt ist, wirfst Du es schnell weg, um Dir nicht Deine Finger zu "
      +"verbrennen."));
      say( PL->name()+" zuendet eine Fackel mit einem kleinen Streichholz an.\n");
      SetProp( P_LIGHT, 1 );
      fackel = AN;
      RemoveDetail("schatten");
      AddDetail( ({"lichtschein"}),
       "Der schwache, flackernde Lichtschein, der von den Fackeln ausgeht, "
       "erhellt den Raum ein wenig.");
      return 1;
    }
    else 
    {
      write("Aber die Fackeln brennen doch schon?\n");
      return -1;
    }
  }
  return 0;
}
// Loeschen der Fackeln in den Halterungen.
int cmdloesche(string str)
{
  notify_fail( "Was willst Du loeschen?\n" );
  if(str == "fackel")
  {
    if (fackel == AN)
    {
      write("Du holst kraeftig Luft und blaest die Fackeln wieder aus.\n");
      say(BS( PL->name()+" holt kraeftig Luft und blaest die Fackeln "
                     +"wieder aus."));
      SetProp( P_LIGHT, 0 );
      fackel = AUS;
      AddDetail("schatten",
       "Beim genaueren Hinsehen erkennst Du, dass es Fackelhalter sind, die "
       "an der Wand entlang der Treppe befestigt sind.");
      RemoveDetail("lichtschein");
      return 1;
    }
  }
  return 0;
}
// Fuer die angrenzenden Raeume, Lichtschein ja oder nein
QueryFackel()
{
  return fackel;
}
int cmdnehmen(string str)
{
  object meine_fackel;

  notify_fail("Was willst Du woraus nehmen?\n");

  if (str == "fackel aus staender" || str == "fackel aus fackelstaender")
  {
    meine_fackel=clone_object(FACKEL);
    if(member(spieler,getuuid(TP)) > -1) 
    {
      write("Du gibst Dich mit einer Fackel zufrieden.\n");
      return -1;
    }
    if(fackelstaender > 5)
    {
      write(BS("Es befinden sich kaum noch Fackeln im Staender, so dass "
              +"Du Dich nicht traust, noch eine weitere herauszunehmen."));
      return -1;
    } 
    if(ME_TOO_HEAVY==meine_fackel->move(TP,M_GET|M_SILENT))
    {
      write("Du kannst die Fackel nicht mehr tragen.\n");
      meine_fackel->remove();
      return -1;
    }
    else
    {
      write("Du nimmst eine Fackel aus dem Fackelstaender.\n");
      say(PL->name()+" nimmt eine Fackel aus dem Fackelstaender.\n");
      spieler += ({ getuuid(TP) });
      fackelstaender++;
      return 1;
    }
  }
  if(str == "fackel aus halter" || str == "fackel aus fackelhalter")
  {
    write("Du laesst die Fackel lieber im Halter.\n");
    return -1;
  }
return 0;
}

reset()
{
  ::reset();
  if(fackel == AN)
  {
    tell_room(this_object(), "Ein kleiner Windzug loescht die Fackeln aus.\n");
    AddDetail("schatten",
     "Beim genaueren Hinsehen erkennst Du, dass es Fackelhalter sind, die "
     "an der Wand entlang der Treppe befestigt sind.");
    RemoveDetail("lichtschein");
    fackel = AUS;  // Fackeln wieder aus.
  }
  fackelstaender = 0; // Fackel wieder da
  spieler = ({ });
}

// Wenn Zauberstab dabei ... Putmachen (nur wenn er schon kaputt ist)
int exit_test(string dir)
{
	object stab;
    if(!TP)              return 0;
    if(!interactive(TP)) return 0;
    
    stab = present(QUESTSTAB, TP);
      
    if(stab && !(stab->QueryRiss()))
    {
      write(BS("Bei dem Versuch, die Treppe hinaufzugehen, stolperst Du "
              +"und laesst vor Schreck den Zauberstab zu Boden fallen. "
              +"Erschrocken hebst Du den Zauberstab wieder auf und untersuchst "
              +"ihn aengstlich. Das Schimmern des Rubins scheint etwas schwaecher "
              +"geworden zu sein."));
      stab->SetRiss();     
      return 0;
    }
    return 1;
}
