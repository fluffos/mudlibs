
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define O ROOM "raumD3"
#define N ROOM "raumC2"

int tuerosten, tuernorden;

void create() 
{

  ::create();

  tuerosten = WEG;
  tuernorden = WEG;

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Auch hier wurde der Gang sehr sorgfaeltig aus dem Stein "
    "herausgearbeitet. Er wird hier noch enger und dunkler als zuvor. Im "
    "Osten siehst Du die Gittertuer, durch die Du hier hereingekommen "
    "bist. Noerdlich von Dir befindet sich eine schwere Eisentuer." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: -2, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gang" }),
    "Der Gang wurde sehr sorgfaeltig in harter Arbeit aus dem Gestein "
    "herausgeschlagen. Er ist sehr eng und niedrig und die Luft ist sehr "
    "kuehl hier.");
  AddDetail( ({ "arbeit" }),
    "Wer hat sich nur all die Arbeit gemacht? Und warum?");
  AddDetail( ({ "gestein" }),
    "Alles hier unten besteht aus schwarzem, hartem Vulkangestein. Es "
    "laesst sich nur sehr schwer bearbeiten.");
  AddDetail( ({ "vulkangestein" }),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "luft" }),
    "Die Luft wird immer kuehler hier. Aber da Dir noch keine Eiszapfen "
    "an den Fingerspitzen wachsen, beschwerst Du Dich nicht.");
  AddDetail( ({ "eiszapfen" }),
    "Du kannst keine Eiszapfen sehen, weder an Deinen Fingerspitzen noch "
    "sonst irgendwo.");
  AddDetail( ({ "fingerspitzen" }),
    "Deine Fingerspitzen sind kalt.");
  AddDetail( ({ "stein" }),
    "Der Gang wurde fein saeuberlich in muehseliger und langwieriger "
    "Arbeit aus dem harten Stein herausgeschlagen. Du bist Dir ziemlich "
    "sicher, dass das Ganze einen guten Grund hat, denn wer wuerde "
    "schon umsonst so viel Arbeit auf sich nehmen?");
  AddDetail( ({ "ganze" }),
    "Das alles hier.");
  AddDetail( ({ "grund" }),
    "Wenn Du Dich ein wenig clever anstellst, kommst Du dem Grund ja "
    "vielleicht noch auf die Schliche.");
  AddDetail( ({ "schliche" }),
    "Du bist schon so manchem merkwuerdigen Sachverhalt auf die Schliche genommen.");
  AddDetail( ({ "sachverhalt" }),
    "Sachverhalte wie diesem hier.");
  AddDetail( ({ "osten" }),
    "Im Osten siehst Du eine alte rostige Gittertuer.");
  AddDetail( ({ "eisenstreben" }),
    "Die Eisenstreben sind mit Rost ueberzogen.");
  AddDetail( ({ "rost" }),
    "Der Rost hat eine roetlich-braune Farbe und ueberzieht die "
    "Gittertuer an einigen Stellen.");
  AddDetail( ({ "farbe" }),
    "Der Rost ist roetlich-braun.");
  AddDetail( ({ "stellen" }),
    "Vor allem der untere Bereich der Gittertuer ist mit Rost bedeckt.");
  AddDetail( ({ "bereich" }),
    "Unten ist die Gittertuer etwas rostiger als im oberen Bereich. An "
    "einer Stelle ist der Rost etwas abgesplittert.");
  AddDetail( ({ "stelle" }),
    "An einer Stelle ist der Rost bereits etwas abgesplittert. "
    "Vielleicht kannst Du ihn ja noch weiter abkratzen?");
  AddDetail( ({ "norden" }),
    "Im Norden siehst Du eine schwere, stabile Eisentuer, die Dir den "
    "Weg versperrt.");
  AddDetail( ({ "weg" }),
    "Eine stabile Eisentuer versperrt Dir den Weg nach Norden.");
  AddDetail( ({ "tuergriff" }),
    "Du kannst keinen Tuergriff oder etwas Aehnliches sehen.");
  AddDetail( ({ "aehnliches" }),
    "Du siehst nichts, was einem Tuergriff aehnlich waere.");
  AddDetail( ({ "schluesselloch" }),
    "So sehr Du Dich auch bemuehst, Du kannst kein Schluesselloch entdecken.");
  AddDetail( ({ "tuer" }),
    "Welche Tuer meinst Du? Die Gittertuer oder die Eisentuer?");
  AddDetail( ({ "moeglichkeit" }),
    "Wie bekommt man diese Tuer bloss auf?");
  AddDetail( ({ "boden" }),
    "Der Boden ist ein wenig staubig. Du siehst ein paar Fussspuren im Staub.");
  AddDetail( ({ "fussspuren" }),
    "Huch, das sind ja Deine eigenen! Wer haette das gedacht?");
  AddDetail( ({ "staub" }),
    "Auf dem Steinboden liegt eine duenne Staubschicht.");
  AddDetail( ({ "staubschicht" }),
    "Die Schicht ist wirklich nur sehr duenn.");
  AddDetail( ({ "steinboden" }),
    "Der Boden besteht aus Vulkangestein.");
  AddDetail( ({ "waende" }),
    "Die Waende sind sehr sorgfaeltig bearbeitet worden. Du kannst keine "
    "einzige Ritze entdecken.");
  AddDetail( ({ "ritze" }),
    "Keine da.");
  AddDetail( ({ "decke" }),
    "Die Decke ist hier sehr niedrig. Stoss Dir nicht den Kopf an.");
  AddDetail( ({ "kopf" }),
    "*RUMMS*. Schon passiert.");

  AddSound( DEFAULT_SOUND,
    "Es ist extrem still hier im Gang.");

  AddSound( ({ "stille" }),
    "Es ist sehr ruhig hier. Ein wenig zu ruhig fuer Deinen Geschmack.");
  AddSound( ({ "gang" }),
    "Es herrscht voellige Stille im Gang.");
  AddSound( ({ "geschmack" }),
    "Fuer Deinen Geschmack koennte es ruhig ein wenig lauter sein.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig staubig.");

  AddSmell( ({ "staub" }),
    "Der Staub riecht irgendwie ... staubig. Was hast Du denn "
    "erwartet? Dass er nach Erdbeeren riecht?");
  AddSmell( ({ "erdbeeren" }),
    "Da hier nirgendwo Erdbeeren sind, riecht es auch nicht nach Erdbeeren.");

  AddCmd( ({ "kratze", "kratz" }), "cmdkratzen" );
  AddCmd( ({ "wische", "wisch" }), "cmdwische" );

    NewDoor("osten", O , ({"gittertuer"}) ,
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Gittertuer.",
      D_LONG, "Die Gittertuer besteht aus langen, rostigen Eisenstreben.",
      D_NAME,  "Gittertuer",
      D_GENDER,FEMALE,
      D_OPENMSG, ({"Mit viel Muehe oeffnest Du die Gittertuer im Osten.",
                   "Mit viel Muehe wird die Gittertuer von %s geoeffnet.",
                   " oeffnet sich im Westen mit einem leisen quitschen."}),
      D_CLOSEMSG, ({"Mit viel Muehe schliesst Du die Gittertuer im Osten.",
                    "Mit viel Muehe wird die Gittertuer von %s geschlossen.",
                    " im Westen ist zugefallen!\n*RUUUUUMMMMMMMS*\n"}),
      D_RESET_CLOSEMSG,
                  " im Osten ist zugefallen!\n*RUUUUUMMMMMMMS*\n"
    })
  );

    NewDoor("norden", N , ({"eisentuer"}) ,
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Eisentuer.",
      D_LONG, "Eine schwere Eisentuer verhindert, dass Du weiter nach Norden "
              "vordringen kannst. Du kannst weder einen Tuergriff noch ein "
              "Schluesselloch noch eine andere Moeglichkeit entdecken, wie sich "
              "diese Tuer oeffnen lassen koennte.",
      D_NAME,  "Eisentuer",
      D_GENDER,FEMALE,
      D_OPENTESTFUNC, "tueroeffnen",
      D_CLOSEMSG, ({"Du stemmst Dich gegen die Eisentuer im Norden und schliesst sie.",
                   "%s stemmt sich gegen die Eisentuer im Norden und schliesst sie.",
                   " wird von der anderen Seite geschlossen."}),
      D_RESET_CLOSEMSG,
                  " im Norden ist zugefallen!\n"
    })
  );

}

// Rost abkratzen
int cmdkratzen(string str )
{
  notify_fail( "Was willst Du abkratzen?\n" );
  if(str == "rost" || str == "rost ab")
  {  	
  	write(BS("Du kratzt ein wenig Rost von der Tuer ab und polierst die Stelle "
            +"anschliessend mit Deinem Aermel. So, nun ist die Tuer ein wenig "
            +"sauberer, Dein Aermel jedoch ziemlich schmutzig. Ob das wirklich "
            +"noetig war?"));
    say( BS(PL->name()+" kratzt ein wenig Rost von der Tuer ab."));
  	return 1;
  }
  return 0;
}
// Staub wischen, wiedermal
int cmdwische(string str )
{
  notify_fail( "Was willst Du wegwischen?\n" );
  if(-1 == member(({"staub","staubschicht","staub weg","staubschicht weg"}),str))
  { return 0; }
  write(BS("Du wirbelst etwas Staub auf, der sich jedoch gleich wieder legt."));
  say( BS(PL->name()+" wirbelt etwas Staub auf, der sich jedoch gleich wieder "
                    +"legt."));
  return 1;
}

void tuernorden()
{
	object dest;
    call_other (N, "???", 0);
    dest = find_object(N);

	if (DOOR_MASTER->QueryDoorStatus(N)==D_STATUS_OPEN)
	{
		tell_room(TO, "*RUUUUUMMMMMMMS*\nDie Eisentuer im Norden ist zugefallen!\n");
	    if(dest)
	    {
	      tell_room(dest, "*RUUUUUMMMMMMMS*\nDie Eisentuer im Sueden ist "
	                     +"zugefallen!\n");
	    }
	    DOOR_MASTER->SetDoorStatus(N, D_STATUS_CLOSED);
	}
	else
	{
	    tell_room(TO,BS("Du hoerst ein lautes Geraeusch und siehst wie sich die Eisentuer "
	            +"im Norden oeffnet."));
	    if(dest)
	    {
	      tell_room(dest, BS("Du hoerst ein lautes Geraeusch und siehst wie sich "
	                        +"die Eisentuer im Sueden oeffnet."));
	    }
	    DOOR_MASTER->SetDoorStatus(N, D_STATUS_OPEN);
	}
}
// Die Tuer laesst sich nur von Innen oeffnen
int tueroeffnen()
{
  write(BS("Verzweifelt suchst Du nach einem Weg die Eisentuer zu oeffnen. "
        "Findest aber weder eine Tuerklinke noch einen verborgenen Schalter."));
  return 1;
}
