
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <verben.h>

#define O "./raumB3"
#define S "./raumA4"

int spinne;
object myspinne;

void create() 
{

  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Die Hoehle breitet sich im Sueden und im Osten noch weiter aus. "
    "Einige Saeulen aus glaenzend schwarzem Vulkangestein befinden sich "
    "in der Mitte und an der westlichen Seite der Hoehle. Irgendwie hast "
    "Du ein komisches Gefuehl. Vielleicht solltest Du lieber schnell "
    "weitergehen." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }),
    "Nach Sueden und nach Osten hin breitet sich die Hoehle weiter aus. "
    "Ein paar glaenzend schwarze Saeulen ragen mitten in der Hoehle und "
    "an der Westseite empor.");
  AddDetail( ({ "sueden" }),
    "Im Sueden breitet sich die Hoehle weiter aus.");
  AddDetail( ({ "osten" }),
    "Im Osten und im Sueden fuehrt die Hoehle weiter.");
  AddDetail( ({ "saeulen", "saeule" }),
    "In der Mitte der Hoehle ragen einige unterschiedlich grosse Saeulen "
    "empor, die in einer Art Kreis oder etwas Aehnlichem angeordnet zu "
    "sein scheinen. Auch an der westlichen Hoehlenwand befinden sich ein "
    "paar dieser glaenzenden, schwarzen Saeulen.");
  AddDetail( ({ "mitte" }),
    "Mitten in der Hoehle ragen einige Saeulen zur Decke hinauf.");
  AddDetail( ({ "art" }),
    "Es koennte sich um eine Art Kreis handeln, in dem die Saeulen angeordnet "
    "sind.");
  AddDetail( ({ "kreis" }),
    "Naja, ein richtiger Kreis ist es wohl doch nicht.");
  AddDetail( ({ "aehnlichem" }),
    "Pruefend gehst Du einmal um die Saeulen herum und beschliesst, dass "
    "es sich bei der hier vorliegenden Grundform doch eher um einen "
    "Stern handelt.");
  AddDetail( ({ "grundform" }),
    "Die Art und Weise, in der die Saeulen angeordnet sind, weist starke "
    "Aehnlichkeiten mit einem Stern auf.");
  AddDetail( ({ "aehnlichkeiten", "aehnlichkeit" }),
    "Fast wie ein Stern.");
  AddDetail( ({ "weise" }),
    "Nein, so weise, wie Du glaubst, bist Du noch laaange nicht.");
  AddDetail( ({ "stern" }),
    "Fuenf der Saeulen sind recht nahe aneinander kreisfoermig "
    "angeordnet und bilden so eine Art Mittelpunkt. Zwischen jeweils "
    "zweien dieser fuenf Saeulen befindet sich in einiger Entfernung "
    "je eine weitere Saeule und bildet so eine Art Zacken. Verbindet "
    "man die Saeulen im Geiste mit einer Linie, erhaelt man die fast "
    "perfekte Form eines Sternes.");
  AddDetail( ({ "mittelpunkt" }),
    "Wenn man den freien Platz zwischen den inneren fuenf Saeulen "
    "betritt, steht man mitten im Mittelpunkt des Sternes.");
  AddDetail( ({ "platz" }),
    "In der Mitte zwischen den fuenf inneren Saeulen ist noch ein wenig "
    "Platz frei.");
  AddDetail( ({ "entfernung" }),
    "Die inneren und die aeusseren Saeulen sind etwa 5 Meter voneinander "
    "entfernt.");
  AddDetail( ({ "meter" }),
    "Du kannst die Entfernung ja mal abmessen.");
  AddDetail( ({ "zacken" }),
    "Hoffentlich faellt Dir hier unten kein Zacken aus der "
    "Krone.");
  AddDetail( ({ "krone" }),
    "Noch sind alle Zacken dran.");
  AddDetail( ({ "geiste", "geist" }),
    "Stell Dir die Linie einfach mal vor. Na, sieht das nicht aus wie "
    "ein Stern?");
  AddDetail( ({ "linie" }),
    "_______________ <-- Das ist eine.");
  AddDetail( ({ "form" }),
    "Die Form ist fast perfekt.");
  AddDetail( ({ "hoehlenwand", "seite", "westliche seite", "westseite", "westwand" }),
    "An der Westwand befinden sich ebenfalls einige der schwarzen "
    "Saeulen, die auch in der Mitte der Hoehle stehen.");
  AddDetail( ({ "vulkangestein", "gestein" }),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "gefuehl" }),
    "Ein unbehagliches Gefuehl ueberkommt Dich. Du fuehlst Dich "
    "irgendwie beobachtet. Aber hier ist doch niemand ausser Dir, oder?");
  AddDetail( ({ "decke" }),
    "Schwarzes Vulkangestein. Was hattest Du denn erwartet? Wollmaeuse?");
  AddDetail( ({ "wollmaeuse" }),
    "Keine zu sehen.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende der Hoehle sind aus dem gleichen schwarzen Vulkangestein "
    "wie der Boden und die Decke. An der westlichen Wand ragen einige "
    "Saeulen empor.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus schwarzem Vulkangestein. Erst auf den zweiten "
    "Blick faellt Dir auf, dass der gesamte Boden hier mit vielen "
    "schwarzen Haaren bedeckt ist.");
  AddDetail( ({ "blick" }),
    "Du wirfst einen weiteren Blick auf den Boden. Tatsaechlich, "
    "ueberall liegen hier dicke, kurze und tiefschwarze Haare herum. "
    "Komisch...");
  AddDetail( ({ "haare" }),
    "Die Haare haben eine tiefschwarze, aber recht stumpfe Farbe und "
    "sind sehr kurz und dick.");
  AddDetail( ({ "farbe" }),
    "Ein dumpfes Schwarz.");
  AddDetail( ({ "schwarz" }),
    "Das Gegenteil von Weiss.");
  AddDetail( ({ "weiss" }),
    "Das Gegenteil von Schwarz.");
  AddDetail( ({ "gegenteil" }),
    "Schwarz ist das Gegenteil von Weiss und umgekehrt.");
  AddDetail( ({ "oberflaeche" }),
    "Die Saeulenoberflaeche ist sehr glatt und glaenzt in einem tiefen "
    "Schwarz. Du siehst Dich selbst als Spiegelbild auf der Oberflaeche. "
    "Merkwuerdig nur, dass sich die anderen Saeulen nicht darin "
    "spiegeln.");
  AddDetail( ({ "anordnung" }),
    "Die Saeulen sind sternfoermig angeordnet.");
  AddDetail( ({ "spiegelbild" }),
    "Bewundernd streichst Du den Fingern ueber eine der Saeulen. "
    "Ploetzlich beruehrt Dich etwas an der Schulter und Du zuckst "
    "erschrocken zurueck.");
  AddDetail( ({ "finger" }),
    "Aengstlich steckst Du Deinen Finger in den Mund.");
  AddDetail( ({ "mund" }),
    "Du nuckelst ein wenig an Deinem Finger herum, bis er ganz nass und "
    "aufgeweicht ist.");
  AddDetail( ({ "schulter" }),
    "Nervoes zuckst Du zusammen. War da etwas?");
  AddDetail( ({ "etwas" }),
    "Langsam drehst Du Dich um und starrst in ein grosses rotes Augenpaar.");
  AddSpecialDetail( ({ "augenpaar", "augen" }), "straugenpaar");
  AddSpecialDetail( ({ "schritte" }), "strschritte");

  AddSound( DEFAULT_SOUND,
    "Eine unheimliche Stille herrscht hier.");

  AddSound( ({ "stille" }),
    "Es ist unheimlich still hier. Man koennte fast meinen, "
    "etwas lauert hier irgendwo nur darauf, dass Du fuer ein paar Sekunden "
    "unachtsam bist, um sich dann genuesslich ueber Dich herzumachen... Dich unter "
    "unzaehligen Qualen auseinander zu nehmen... und Dich hier nie wieder "
    "herauszulassen...");
  AddSound( ({ "sekunden" }),
    "Tick - Tack - Tick - Tack. Deine Zeit laeuft.");
  AddSound( ({ "zeit" }),
    "Sie rennt Dir davon.");
  AddSound( ({ "tick" }),
    "Tack.");
  AddSound( ({ "tack" }),
    "Tick.");
  AddSound( ({ "qualen" }),
    "Hat da nicht gerade jemand geschrien? Du zitterst wie Espenlaub.");
  AddSound( ({ "espenlaub" }),
    "Deine Knochen klappern schon.");
  AddSound( ({ "knochen" }),
    "*klapperdiklapp*");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach alter, trockener und stickiger Luft. Ausserdem "
    "stinkt es hier ein wenig.");

  AddSmell( ({ "luft" }),
    "Die Luft ist sehr trocken und stickig hier. Ein leichter Gestank "
    "durchzieht den Raum.");
  AddSmell( ({ "gestank" }),
    "Der Gestank ist zwar nicht sehr stark, aber besonders angenehm "
    "riecht er auch nicht.");
  AddSmell( ({ "raum" }),
    "Deine Nasenfluegel fangen leicht an zu beben, als Du die Luft in "
    "Dich hineinsaugst.");
  AddSmell( ({ "nasenfluegel" }),
    "Sie beben leicht");

  AddExit( "osten", O );
  AddExit( "sueden", S );
  
  AddCmd( ({ "stelle", "stell" }), "cmdstelle" );
  AddCmd( ({ "messe", "mess" }), "cmdmesse" );
  AddCmd( CMD_BETRETEN, "cmdbetrete" );

  spinne = DA;

}

int cmdstelle(string str)
{
  notify_fail( "Was willst Du Dir vorstellen?\n" );
  if ((str == "linie vor"))
  {
   write("Du stellst Dir eine Linie vor, die die Saeulen "
           +"miteinander verbindet.\n "
+"                          ___---___                                         \n"
+"                       .--         --.                                     \n"
+"                     ./               \\.                                   \n"
+"                    /                   \\                                  \n"
+"                   /                     |                                 \n"
+"                  |                       |                                \n"
+"                 |                         |                               \n"
+"                 |                         |                               \n"
+"                 |                         |                               \n"
+"                  |                       |                                \n"
+"                   \\                     /                                 \n"
+"                    \\                   /                                  \n"
+"                     `\\               /'                                   \n"
+"                       `--___   ___--'                                     \n"
+"                             ---                                           \n"
+"Mist, versagt!\n");

   return 1;
  }
  return 0;
}

int cmdbetrete(string str)
{
  notify_fail( "Was willst Du betreten?\n" );
  if ((str == "mitte" || str == "mittelpunkt" || str == "stern"))
  {
   write(BS("Neugierig zwaengst Du Dich zwischen den Saeulen hindurch und "
           +"stehst nun genau in der Mitte des Saeulensterns. Staunend "
           +"schaust Du Dich um und bewunderst die glaenzende Oberflaeche "
           +"und die fast perfekte Anordnung der Saeulen."));

   return 1;
  }
  return 0;
}

int cmdmesse(string str)
{
  notify_fail( "Was willst Du abmessen?\n" );
  if ((str == "saeulen ab" || str == "saeule ab"))
  {
   write(BS("Du misst die Entfernung zwischen den inneren und den "
           +"aeusseren Saeulen mit kleinen Schritten ab und kommst "
           +"auf ungefaehr "+(random(2)==0?"4":"5")+","+(random(100))+" Meter."));
   say(BS(PL->Name()+" misst die Entfernung zwischen den Saeulen mit kleinen "
                    +"Schritten ab."));
   return 1;
  }
  return 0;
}

string strschritte(string key)
{
  string s;
  
  if(spinne == WEG || present("terraspinne", TO))
  {
  	s = "Erschrocken weichst Du ein paar Schritte zurueck.";
  }
  else
  {
  	s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}

string straugenpaar(string key)
{
  string s;
  s = "";

  // Spinne wurde diesen Reset schon gecloned
  if(present("terraspinne", TO))
  {
    s = "Du starrst in die Augen der Spinne. Dir wird ganz mulmig.";
  }
  else
  {
  	s = "Welches Augenpaar meinst Du denn?";
  }

  if (spinne == DA)
  {
    s="Erschrocken weichst Du ein paar Schritte zurueck. Direkt "
     +"ueber Dir an der Decke haengt ein riesiges Ungetuem von Spinne.";
  	//AddItem(NPC "terraspinne", REFRESH_NONE);
  	myspinne = clone_object(NPC "terraspinne");
    if(myspinne)
    {
      myspinne->move(TO,M_GO|M_SILENT);
    }
    else
    {
      // Clonen ging wohl schief ...
      write(BS("Kein Augenpaar da, Du musst Dich wohl getaeuscht haben."));
    }
  	spinne = WEG;
  }
  
  return BS(s);
}

reset()
{
  ::reset();
  
  if(spinne == WEG)
  {
  	spinne = DA;
  	myspinne = present("terraspinne", TO);
  	if (myspinne)
  	{
  	   myspinne->remove();
  	}
  }
}
