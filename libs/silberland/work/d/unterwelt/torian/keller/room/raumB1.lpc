
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define C1 "./raumC1"

int schatz, ei;

void create() 
{
  int i;

  ::create();

  schatz = DA;
  ei = DA;

  SetProp( P_INT_SHORT, "In einer Nische" );
  SetProp( P_INT_LONG, "Du bist den Spuren auf dem Boden gefolgt und stehst "
   "nun in einer kleinen, dunklen Nische. Direkt vor Dir auf dem Boden "
   "befindet sich ein grosses, mit alten verrotteten Lappen und einigen "
   "kleineren Stofffetzen ausgepolstertes Nest, in dem sich unzaehlige kleine "
   "Hoehlenechsen tummeln. Der gesamte Hoehlenboden ist hier mit Spuren "
   "uebersaeht und in einer Ecke siehst Du ein paar Knochen liegen." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "spuren" }),
    "Der gesamte Hoehlenboden ist mit grossen und kleinen Spuren uebersaeht, "
    "die zum Nest hinfuehren.");
  AddDetail( ({ "hoehlenboden" }),
    "Ueberall auf dem Boden siehst Du grosse und kleine Spuren.");
  AddDetail( ({ "boden" }),
    "Der Boden ist mit grossen und kleinen Spuren uebersaeht. In einer "
    "Ecke siehst Du ein paar alte Knochen liegen.");
  AddDetail( ({ "kleine spuren", "kleine spur" }),
    "Die vielen kleinen Spuren auf dem Boden stammen von den unzaehligen "
    "winzigen Hoehlenechsen, die sich in dem Nest herumtummeln. Offenbar "
    "sind die kleinen Echsen schon sehr unternehmungslustig und "
    "verlassen ihr Nest ab und zu, um auf Entdeckungsreise zu gehen.");
  AddDetail( ({ "entdeckungsreise" }),
    "Auch kleine Hoehlenechsen sind sehr neugierig und wollen die Welt auf "
    "eigene Faust entdecken.");
  AddSpecialDetail( ({ "welt" }), "strwelt");
  AddDetail( ({ "faust" }),
    "Alleine ist so eine Entdeckungsreise doch viel aufregender und spannender, "
    "als an Mamas Rockzipf... Patschefuesschen.");
  AddDetail( ({ "mama", "mamas" }),
    "Wenn sie nicht hier ist, ist sie wohl gerade auf Futtersuche fuer die "
    "Kleinen.");
  AddDetail( ({ "futtersuche" }),
    "Hoehlenechsen ernaehren sich hauptsaechlich von Spinnen oder "
    "Ratten, manchmal sind sie allerdings auch einem groesseren Stueck Fleisch "
    "nicht abgeneigt.");
  AddDetail( ({ "ratten" }),
    "Ratten stehen ebenso wie Spinnen auf dem Speiseplan der "
    "Hoehlenechsen.");
  AddDetail( ({ "spinnen" }),
    "Hier unten gibt es viele Spinnen.");
  AddDetail( ({ "speiseplan" }),
    "Hoehlenechsen ernaehren sich hauptsaechlich von Spinnen oder Ratten.");
  AddDetail( ({ "stueck" }),
    "Manchmal fressen die ausgewachsenen Echsen auch groessere Lebewesen als "
    "Ratten.");
  AddDetail( ({ "lebewesen" }),
    "Zum Beispiel verirrte Abenteurer wie Dich.");
  AddDetail( ({ "beispiel" }),
    "Nur ein Beispiel.");
  AddDetail( ({ "abenteurer" }),
    "Die Knochen auf dem Boden stammen wohl auch von einem armen "
    "Abenteurer, der sich hier unten verirrt hat und dann von den Echsen "
    "als Nahrungsquelle angesehen wurde.");
  AddDetail( ({ "nahrungsquelle" }),
    "Ob Du den Echsen auch so gut schmecken wuerdest?");
  AddDetail( ({ "fleisch" }),
    "Hoehlenechsen sind groesstenteils Fleischfresser.");
  AddDetail( ({ "fleischfresser" }),
    "Keine Vegetarier.");
  AddDetail( ({ "vegetarier" }),
    "Sie sind KEINE Vegetarier.");
  AddDetail( ({ "rockzipfel" }),
    "Nun ja, hast Du etwa schon mal eine Hoehlenechse gesehen, die einen Rock "
    "trug?");
  AddDetail( ({ "rock" }),
    "Hoehlenechsen tragen fuer gewoehnlich keine Roecke.");
  AddDetail( ({ "patschefuesschen" }),
    "Irgendwann muessen sich die kleinen Echsen von der Mama "
    "loesen und auf eigenen Beinen stehen, um zu ueberleben.");
  AddDetail( ({ "beine" }),
    "Hoehlenechsen haben vier Beine.");
  AddDetail( ({ "nische" }),
    "Du stehst in einer kleinen, dunklen Nische.");
  AddDetail( ({ "lappen" }),
    "Das Nest ist mit alten, verrotteten Lappen ausgepolstert. Dir "
    "faellt eine kleine Woelbung auf.");
  AddDetail( ({ "woelbung" }),
    "Ob sich etwas zwischen den Lappen befindet?");
  AddDetail( ({ "stofffetzen" }),
    "Zwischen den alten Lappen schauen auch einige bunte Stofffetzen "
    "hervor. Auf einem der Stoffe kannst Du gerade noch ein schon sehr "
    "stark verblichenes Muster erkennen.");
  AddDetail( ({ "stoffe", "stoff" }),
    "Einer der Stoffe weist ein stark verblichenes Muster auf.");
  AddDetail( ({ "muster" }),
    "Das Muster hat die Form eines kleinen Sterns.");
  AddDetail( ({ "form" }),
    "Das Muster sieht aus wie ein kleiner Stern.");
  AddDetail( ({ "stern" }),
    "Du betrachtest den Stoff noch einmal etwas genauer und erkennst, "
    "dass es sich hierbei um ein kleines, stark verschmutztes und "
    "zerrissenes Kleidchen handelt.");
  AddDetail( ({ "kleidchen" }),
    "Das Kleidchen gehoerte wohl einmal einem kleinen Maedchen.");
  AddDetail( ({ "maedchen" }),
    "Hm, das Kleidchen sieht eigentlich doch eher aus wie das Kleid "
    "einer Fee.");
  AddDetail( ({ "kleid" }),
    "Das Kleid scheint wohl einmal einer Fee gehoert zu haben.");
  AddDetail( ({ "fee" }),
    "Wo sie jetzt wohl ist?");
  AddDetail( ({ "nest" }),
    "Das Nest ist mit alten verrotteten Lappen und kleinen Stofffetzen "
    "ausgepolstert. Du siehst unzaehlige winzige und kleine Echsen in "
    "dem Nest herumwuseln.");
  AddDetail( ({ "kleine echse", "kleine echsen", "kleine hoehlenechse", 
                "kleine hoehlenechsen" }),
    "Einige der kleineren Echsen scheinen miteinander zu spielen und "
    "rumzubalgen. Eine Echse versucht gerade, ein kleines Loch in das "
    "Nest hineinzugraben.");
  AddDetail( ({ "loch" }),
    "In dem Loch kannst Du etwas Helles aufblitzen sehen.");
  AddDetail( ({ "helle", "etwas" }),
    "Merkwuerdig. Was koennte das sein?");
  AddDetail( ({ "winzige echsen", "winzige echse", "winzige hoehlenechse",
                "winzige hoehlenechsen" }),
    "Unzaehlige winzige Hoehlenechsen wuseln in dem Nest umher, purzeln "
    "uebereinander her und klettern aufeinander herum.");
  AddDetail( ({ "grosse spuren", "grosse spur" }),
    "Die grossen Spuren gehoeren wohl zu einer ausgewachsenen Hoehlenechse.");
  AddDetail( ({ "echsen", "echse", "hoehlenechse", "hoehlenechsen" }),
    "Meinst Du die winzigen oder die kleinen Echsen?");
  AddDetail( ({ "ecke" }),
    "In einer Ecke auf dem Boden liegt ein kleiner Haufen abgenagter "
    "Knochen.");
  AddDetail( ({ "haufen" }),
    "Ein kleiner Haufen Knochen liegt in der Ecke.");
  AddDetail( ({ "knochen" }),
    "Die Knochen sehen aus, als ob sie jemand fein saeuberlich abgenagt "
    "haette.");
  AddDetail( ({ "jemand" }),
    "Wer das wohl war?");
  AddDetail( ({ "wand", "waende" }),
    "An den Waenden siehst Du ein paar kleine Loecher und Spalten.");
  AddDetail( ({ "loecher", "spalten" }),
    "Ein paar kleine Loecher und Spalten sind in den Waenden.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus Vulkangestein. Sie ist sehr niedrig hier, so "
    "dass Du nicht aufrecht stehen kannst.");
  AddDetail( ({ "vulkangestein" }),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "nase" }),
    "Du drueckst auf Deine Nase.");
  AddDetail( ({ "spielobjekt" }),
    "Diese kleinen Hoehlenechsen sind wohl sehr spielerisch veranlagt.");
  AddDetail( ({ "etwas", "helles" }),
    "Etwas scheint in dem Loch zu liegen.");
  AddDetail( ({ "raum" }), QueryProp(P_INT_LONG));
    
  AddSound( DEFAULT_SOUND,
    "Du hoerst, wie die kleinen Hoehlenechsen in dem Nest umhertollen.");

  AddSound( ({ "echsen", "hoehlenechsen" }),
    "Die Echsen tollen wild in dem Nest umher.");
  AddSound( ({ "nest" }),
    "Du hoerst ein leises Kichern.");
  AddSound( ({ "kichern" }),
    "Lacht Dich da etwa jemand aus?");
  AddSound( ({ "jemand" }),
    "Wer das wohl war?");

  AddSmell( DEFAULT_SMELL,
    "Ein etwas strenger Geruch durchzieht den ganzen Raum.");

  AddSmell( ({ "geruch" }),
    "Es riecht nach Echsen.");
  AddSmell( ({ "echsen", "echse" }),
    "Du hockst Dich hin und schnupperst am Nest herum, stehst dann aber "
    "lieber schnell wieder auf, als eine kleine Echse Deine Nase als "
    "Spielobjekt missbrauchen will.");

  AddCmd( ({ "durchwuehle", "durchwuehl", "wuehle", "wuehl" }), "cmdwuehle" );
  AddCmd( ({ "greife", "greif" }), "cmdgreife" );
  AddCmd( ({ "zieh", "ziehe" }), "cmdziehen" );
  AddCmd( ({ "fuehl", "fuehle" }), "cmdfuehle" );
  AddItem(NPC "mamaechse", REFRESH_REMOVE);
  i = random(3)+3;
  while(i--) AddItem(({ NPC "miniechse", NPC "babyechse" }), REFRESH_REMOVE);

  AddExit( "osten", C1 );
}
int cmdfuehle(string str)
{
  notify_fail( "Was willst Du fuehlen?\n" );
  if(str == "etwas")
  {
    write(BS("Es fuehlt sich rund und hart an. Vielleicht kannst Du es aus "
            +"dem Loch herausziehen?"));
    say(BS(PL->Name()+" fummelt an dem Nest herum."));
    return 1;
  }
}
int cmdziehen(string str)
{
  object echsenei;
  notify_fail( "Was willst Du herausziehen?\n" );
  if(str == "etwas heraus" || str == "etwas aus loch heraus")
  {
    if(ei != DA)
    {
      write(BS("Du greifst in das Loch hinein und und versuchst das Etwas "
              +"heraus zu ziehen. Leider rutscht es Dir aus den Fingern."));
      say(BS(PL->Name()+" fummelt an dem Nest herum."));
      return -1;
    }    
    echsenei = clone_object(OBJ "ei");
    if(echsenei->move(TP,M_GET) == 1)
    {
      write(BS("Du greifst noch einmal in das Loch hinein und ziehst einen "
              +"kleinen, rundlichen Gegenstand heraus."));
      say(BS(PL->Name()+" holt etwas aus dem Nest heraus."));
      ei = WEG;
    }  
    else
    {
      write(BS("Das Ei wuerde zur schwer werden deswegen laesst Du es "
              +"lieber im Nest liegen."));
      say(BS(PL->Name()+" fummelt an dem Nest herum."));
      echsenei->remove();      
    }  
    return 1;
  }
}
int cmdgreife(string str)
{
  notify_fail( "Worein willst Du greifen?\n" );
  if(str == "in loch" )  
  {
    write(BS("Vorsichtig schiebst Du die kleine Echse aus dem Weg "
            +"und greifst in das Loch hinein. Du fuehlst, dass etwas "
            +"in dem Loch liegt."));
    say(BS(PL->Name()+" fummelt an dem Nest herum."));
    return 1;
  }
  if(-1 == member(({"in spalte","in spalten","in loecher","in spalt"}),str))
  {
    return 0;
  }
  else
  {
    write("Die Loecher und Spalten sind zu klein.\n");
    return -1;
  } 
}
int cmdwuehle(string str)
{
  notify_fail( "Was willst Du durchwuehlen?\n" );
  if((str == "knochen") || (str == "in knochen") 
  || (str == "haufen") || (str == "in haufen"))
  {
    write(BS("Nein, Du ekelst Dich viel zu sehr."));
    return -1;
  }
  if(str == "lappen")
  {
    if(schatz != DA)
    {
      write(BS("Du wuehlst ein wenig in den alten Lappen herum, findest "
              +"jedoch nichts."));
      say(BS(PL->Name()+" wuehlt ein wenig in dem Nest herum."));
      return -1;
    } 
    else
    {
      write(BS("Du wuehlst ein wenig in den alten Lappen herum und findest "
              +"eine Handvoll Muenzen."));
      say(BS(PL->Name()+" wuehlt ein wenig in dem Nest herum und scheint "
              +"tatsaechlich etwas gefunden zu haben."));     
      TP->AddMoney(500+random(500));
      schatz = WEG;
      return 1;

    }
  }
  return 0;
}
string strwelt(string str)
{
   string s,rasse;
   int gender;
   rasse = PL->QueryProp(P_RACE);
   gender = PL->QeryProp(P_GENDER);
   switch(rasse)
   {
     case "Dunkelelf" :
       gender == FEMALE ? rasse = "Dunkelelf" : rasse = "Dunkelelfe"; 
       break;
     case "Elf" :
       gender == MALE ? rasse = "Elf" : rasse = "Elfe"; 
       break;
     case "Hobbit" :
       gender == MALE ? rasse = "Hobbit" : rasse = "Hobbitdame"; 
       break;
     case "Zwerg" :
       gender == MALE ? rasse = "Zwerg" : rasse = "Zwergin"; 
       break;
     case "Mensch" :
       gender == MALE ? rasse = "Menschen" : rasse = "Frau"; 
       break;
     case "Troll" :
       gender == MALE ? rasse = "Troll" : rasse = "Trolldame"; 
       break;
     case "Oger" :
       gender == MALE ? rasse = "Oger" : rasse = "Ogerin"; 
       break;
     case "Fee" :
       rasse = "Fee"; 
       break;
     default :
       rasse = "Was fuer eine Rasse bist Du denn? Sollte Torian Deine Rasse "
             +"tatsaechlich uebersehen haben, wende Dich doch bitte kurz an ihn.";
     break;
   }
   s = "Fuer so eine kleine Echse sieht die Welt viel groesser aus als fuer "
      +(gender==MALE? "einen grossen ":"eine grosse ")+rasse+" wie Dich.";
   return BS(s);
}
reset()
{
  ::reset();

  schatz = DA;
  ei = DA;
}
