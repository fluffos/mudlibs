#include "../def.h"

inherit "std/room";

#include <properties.h>
#define NO ROOM "raumF3"
#define SO "./raumF5"
#define SW "./raumD5"
#define NW "./raumD3"
#define S "./raumE5"

int faden, spider;

void create() 
{

  ::create();

  faden = DA;
  spider = DA;

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG, "Fehler!" );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );
  
  AddSpecialDetail( ({ "nordosten"}), "strNordosten");
  AddSpecialDetail( ({ "lichtschimmer"}), "strlichtschimmer");
  AddSpecialDetail( ({ "licht"}), "strlicht");

  AddDetail( ({ "gang", "gaenge" }),
    "Ein breiter Gang fuehrt um die Saeule herum, die noerdlich von Dir "
    "hoch zur Decke hinaufragt.");
  AddDetail( ({ "saeule", "steinsaeule" }),
    "Eine riesige Steinsaeule ragt im Norden bis zur Decke hinauf. Sie "
    "hat eine glaenzende, fast spiegelglatte Oberflaeche. In der Mitte "
    "ist sie fast kreisrund und ziemlich schmal, waehrend sie zum Boden "
    "und zur Decke hin breiter und auch etwas unfoermiger wird.");
  AddDetail( ({ "decke" }),
    "Die Decke befindet sich weit ueber Dir.");
  AddDetail( ({ "norden" }),
    "Noerdlich von Dir ragt eine riesige schwarze Steinsaeule hinauf. "
    "Bewundernd starrst Du eine Weile hinauf und bestaunst dieses Wunder "
    "der Natur.");
  AddDetail( ({ "weile" }),
    "Leise summst Du vor Dich hin: Hast Du einmal Langeweile, dauert die "
    "ne ganze Weile.");
  AddDetail( ({ "wunder" }),
    "Diese Saeule ist wirklich ein wahres Wunder.");
  AddDetail( ({ "langeweile" }),
    "Hier unten gibt es so viel Aufregendes und Neues zu entdecken, "
    "dass Du sicherlich keine Langeweile bekommen wirst.");
  AddDetail( ({ "aufregendes" }),
    "Das wirst Du schon noch herausfinden.");
  AddDetail( ({ "neues" }),
    "Warts ab.");
  AddDetail( ({ "natur" }),
    "Die Natur schafft viele Wunder. Eines siehst Du gerade vor Dir.");
  AddDetail( ({ "oberflaeche" }),
    "Die Saeule hat eine glaenzende, fast spiegelglatte Oberflaeche.");
  AddDetail( ({ "mitte" }),
    "In der Mitte ist die Saeule fast kreisrund und sehr schmal.");
  AddDetail( ({ "boden" }),
    "Neugierig betrachtest Du den Boden. Er besteht aus schwarzem "
    "Vulkangestein und ist recht gleichmaessig geformt.");
  AddDetail( ({"gestein", "vulkangestein"}),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "steintreppe", "treppe" }),
    "Im Nordosten kannst Du zur Steintreppe gelangen, die aus dem Keller "
    "hinausfuehrt.");
  AddDetail( ({ "keller" }),
    "Du befindest Dich in dem Keller unter Mabruks Haus.");
  AddDetail( ({ "mabruk" }),
    "Der ist sicherlich irgendwo oben im Haus.");
  AddDetail( ({ "haus", "mabruks haus" }),
    "Ueber Dir.");
  AddDetail( ({ "hoehle" }),
    "Suedlich von Dir liegt eine kleine, langgestreckte Hoehle, die "
    "irgendwie interessant aussieht.");
  AddDetail( ({ "nordwesten" }),
    "Du kannst nicht erkennen, was sich im Nordwesten befindet, da Dir "
    "dort ein riesiges klebriges Spinnennetz den Weg und damit auch die "
    "Sicht versperrt.");
  AddDetail( ({ "spinnennetz", "netz" }),
    "Lange, mit klebrigem Schleim ueberzogene Spinnenfaeden ueberziehen "
    "die Waende und versperren Dir den Weg nach Nordwesten. Du kannst "
    "keine Moeglichkeit erkennen, an dem Netz vorbeizukommen, ohne in "
    "den Faeden steckenzubleiben.");
  AddDetail( ({ "schleim" }),
    "Die Spinnenfaeden sind mit klebrigem Schleim in einer "
    "undefinierbaren Farbe ueberzogen.");
  AddDetail( ({ "spinnenfaeden", "faeden" }),
    "Lange klebrige Spinnenfaeden ueberziehen die Waende. Ein einzelner "
    "Faden baumelt lose von der Decke herunter und scheint nicht ganz so "
    "klebrig zu sein wie die anderen Faeden.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende werden groesstenteils von dem riesigen Spinnennetz und "
    "seinen Faeden bedeckt.");
  AddDetail( ({ "faden", "spinnenfaden" }),
    "Der Faden baumelt vor Deiner Nase hin und her. Ob es klug waere, "
    "daran zu ziehen?");
  AddDetail( ({ "nase" }),
    "Direkt vor Deiner Nase baumelt ein Spinnenfaden locker hin und her.");
  AddDetail( ({ "farbe" }),
    "Du kannst beim besten Willen nicht sagen, was das fuer eine Farbe "
    "sein koennte.");
  AddDetail( ({ "willen" }),
    "Auch wenn Du es noch so sehr willst, Du kannst es leider nicht.");
  AddDetail( ({ "moeglichkeit" }),
    "Du siehst keine Moeglichkeit, an dem Netz vorbeizukommen. "
    "Verzweifelt raufst Du Dir die Haare.");
  AddDetail( ({ "haare" }),
    "Du solltest mal wieder zum Friseur gehen.");
  AddDetail( ({ "friseur" }),
    "Spaeter, nicht jetzt.");
  AddDetail( ({ "weg", "wege" }),
    "Viele Wege fuehren zum Ziel.");
  AddDetail( ({ "ziel" }),
    "Heisst Dein Ziel vielleicht Rom?");
  AddDetail( ({ "rom" }),
    "Auch wenn viele Wege nach Rom fuehren, dieser hier fuehrt woanders hin.");
  AddDetail( ({ "sicht" }),
    "Die Sicht nach Nordwesten wird Dir durch ein riesiges Spinnennetz versperrt.");

  AddSound( DEFAULT_SOUND,
    "Du lauscht aufmerksam, kannst jedoch ausser Deinem eigenem Atem "
    "nichts hoeren.");
  AddSound( ({ "atem" }),
    "Leise atmest Du ein und aus.");

  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht ein wenig abgestanden und vom Spinnennetz weht ein "
    "leicht schleimiger Geruch herueber.");
  AddSmell( ({ "luft" }),
    "Die Luft ist hier etwas abgestanden.");
  AddSmell( ({ "spinnennetz" }),
    "Ein schleimiger Geruch zieht von dem Spinnennetz herueber.");
  AddSmell( ({ "geruch" }),
    "Es riecht nach Schleim.");
  AddSmell( ({ "schleim" }),
    "Schleimiger schleimender Schleim.");

  AddCmd( ({ "zuend", "zuende" }), "cmdanzuenden" );
  AddCmd( ({ "entferne", "entfern" }), "cmdentferne" );
  AddCmd( ({ "zieh", "ziehe" }), "cmdziehen" );


  AddExit ("nordwesten", ([ EX_DEST:     NW,
                            EX_TESTFUNC: "exit_test" ]) );
  AddExit( "sueden", S );
  AddExit( "suedwesten", SW );
  AddExit( "suedosten", SO );
  AddExit( "nordosten", NO );

}
string _query_int_long()
{
  string s;
  object obj;
  call_other(NO, "???", 0);
  obj = find_object(NO);
  if(obj)
  {
    if(obj->QueryFackel())
      s = "Im Nordosten siehst Du einen schwachen Lichtschimmer, dort gelangst "
         +"Du zur Steintreppe, ";
    else
      s = "Im Nordosten gelangst Du zur Steintreppe, ";
    
      s = "Du befindest Dich in einem breiten Gang, der um die riesige Saeule im Norden "
         +"herumfuehrt. Es zweigen mehrere Gaenge von hier ab. "+s+"die aus "
         +"dem Keller hinausfuehrt, suedlich von Dir befindet sich eine kleine, "
         +"langgestreckte Hoehle und im Nordwesten versperrt Dir ein riesiges, "
         +"aeusserst klebrig aussehendes Spinnennetz den weiteren Weg."
         +"";
  }
  else 
  { 
    s = "Fehler! Bitte melde ihn an Torian."; 
  }
  return BS(s);
}

string strNordosten(string str)
{
  string s, s2;
  object obj;

  s = "Aus dem Nordosten dringt ein schwacher Lichtschimmer hierher. Dort "
     +"befindet sich wohl die Steintreppe.";
  s2 = "Im Nordosten scheint sich die Steintreppe zu befinden.";
  call_other (NO, "???", 0);
  obj = find_object(NO);
  if(obj)
  {
    if (obj->QueryFackel()) { return BS(s); }
    else {return BS(s2);}
  }
  else { return "Fehler! Bitte melde ihn an Torian.\n"; }
}
string strlichtschimmer(string str)
{
  string s, s2;
  object obj;
  s = "Der Schimmer reicht nicht aus, um viel Licht zu spenden. Aber Du "
     +"glaubst, die Steintreppe, die sich im Nordosten befinden muss, "
     +"erkennen zu koennen.";
  s2 = "Sowas siehst du nicht.\n";
  call_other (NO, "???", 0);
  obj = find_object(NO);
  if(obj)
  {
    if (obj->QueryFackel()) { return BS(s); }
    else {return s2;}
  }
  else { return "Fehler! Bitte melde ihn an Torian.\n"; }
}
string strlicht(string str)
{
  string s, s2;
  object obj;
  s = "Es dringt nur sehr wenig Licht bis hierher, das nicht stark genug "
     +"ist, um diese Hoehle ausreichend zu erhellen.";
  s2 = "Sowas siehst du nicht.\n";
  call_other (NO, "???", 0);
  obj = find_object(NO);
  if(obj)
  {
    if (obj->QueryFackel()) { return BS(s); }
    else {return s2;}
  }
  else { return "Fehler! Bitte melde ihn an Torian.\n"; }
}

// Spinnennetz mit dem Staubwedel entfernen
int cmdentferne(string str)
{
  object mywedel;
  notify_fail( "Was willst Du womit entfernen?\n" );
  if(str == "netz mit staubwedel" || str == "netz mit wedel"
  || str == "spinnnennetz mit staubwedel" || str == "spinnennetz mit wedel")
  {
  
    mywedel = present("staubwedel", PL);
  
    if( mywedel )
    {
  
      say(BS( PL->name()+" versucht, die Spinnenweben mit einem "
                        +"Staubwedel zu entfernen.") );
      write(BS("Du versuchst, das riesige Spinnennetz mit Deinem winzigen "
              +"Staubwedel zu entfernen, musst dann jedoch leider erkennen, dass "
              +"dies wohl ein recht sinnloses Unterfangen ist. Zu allem Uebel "
              +"bleibt der Staubwedel auch noch in dem Netz haengen und "
              +"verschwindet spurlos hinter den unzaehligen Spinnenfaeden."));
      mywedel->remove();
      return 1;
    }
    else
    {
      say(BS( PL->name()+" schaut irritiert aus der Waesche."));
      write(BS("Du vollfuehrst magische Bewegungen und versuchst Dir einen "
              +"Staubwedel herbeizuzaubern. Leider versagst Du auf ganzer "
              +"Linie!"));
      return -1;
    }
  }
  return 0;
}
// Spinnennetz anzuenden
int cmdanzuenden(string str)
{
   int groesse, i;
   object fackel, spinne;
   notify_fail( "Was willst Du womit anzuenden?\n" );

// nicht vollstaendige syntax
   if ((str == "netz an") || (str == "spinnennetz an"))
   {
     write(BS("Womit willst du das Spinnennetz anzuenden?"));
     return -1;
   }

// richtige syntax
   if ((str == "netz mit fackel an") || (str == "spinnennetz mit fackel an"))
   {
// fackel auch da ?
     fackel = present("fackel",TP);
     if( !fackel )
     {
       write(BS("Du hast gar keine Fackel!"));
       return -1;
     } 

// mit einer erloschenen fackel kann man nix abfackeln
     if(!(fackel->_query_lighted()))
     {
       write(BS("Die Fackel ist nicht angezuendet!"));
       return -1;
     }
     if(spider == DA)
     {
       say(BS( PL->name()+" versucht, das Netz anzuzuenden, als ploetzlich "
                         +"eine riesige Spinne hereinkrabbelt und +"
                         +PL->name()+" attackiert!") );
       write(BS("Du versuchst, das Netz anzuzuenden. Ploetzlich krabbelt eine "
               +"riesige Spinne herein und attackiert Dich!"));

       spinne = clone_object(NPC "riesenhoehlenspinne");
       if(spinne)
       {
         spinne->move(TO,M_GO|M_SILENT);
         spinne->Kill(TP);
         spider = WEG;
       }
       return 1;
     }
     else
     {
       write(BS("Du versuchst, das Netz anzuzuenden. Komischerweise passiert "
               +"ueberhaupt nichts."));
       return -1;
     }
   }
   return 0;
}
// am Faden ziehen
int cmdziehen(string str )
{
  notify_fail( "Woran moechtest Du ziehen?\n" );
  if(str != "an faden") { return 0; }

  if(faden == DA)
  {
    write(BS("Du hoerst ein lautes *Platsch* und alles wird dunkel um Dich herum. "
            +"Erschrocken greifst Du mit beiden Haenden an Dein Gesicht und "
            +"spuerst etwas Ekliges, Schleimiges, das in Deinen Augen brennt. Du "
            +"solltest Dich beeilen und den Schleim lieber schnell entfernen, "
            +"damit Du nicht fuer immer erblindest!"));
    say(BS(PL->Name()+" zieht an dem Faden, wird von einer grossen Ladung "
            +"Schleim getroffen und taumelt blind umher."));
// blenden ueber schleim
    TP->AddPoison(1);
    clone_object(OBJ "schleim")->move(TP,M_GET|M_NOCHECK);
    faden = WEG;
    return 1;
  }
  else
  {
    write(BS("Du streckst Dich, kommst aber leider nicht an den Faden heran."));
    return -1;
  }
}

// Kein Durchkommen
int exit_test(string dir)
{
    if(!TP)              return 0;
    if(!interactive(TP)) return 0;
    write(BS("Du versuchst, nach Nordwesten zu gehen, wirst aber von einem "
            +"grossen Netz aufgehalten. Wenn Du es nicht entfernst, kommst Du "
            +"nie daran vorbei!"));
    return 0;
}

reset()
{
  ::reset();

  faden = DA;
  spider = DA;
}
