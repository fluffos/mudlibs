
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define N "./raumE4"
#define O "./raumF5"
#define W "./raumD5"

#define MAXHEILUNG 3
#define HEILUNG 60 + random(20)

int heilungen, schmutz;

void create() 
{

  ::create();

  heilungen = 0;
  schmutz = DA;
  
  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du stehst mitten in einer kleinen, laenglichen Hoehle, die sich "
    "nach Westen und nach Osten hin weiter ausstreckt. Noerdlich von "
    "hier fuehrt ein breiter Gang aus der Hoehle hinaus. Ein schwaches "
    "Schimmern von den Waenden erhellt den Raum ein wenig und Du spuerst "
    "eine leichte Feuchtigkeit in der Luft." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }),
    "Eine kleine, langgestreckte Hoehle breitet sich vor Deinen Augen aus.");
  AddDetail( ({ "westen" }),
    "Im Westen breitet sich die Hoehle weiter aus.");
  AddDetail( ({ "osten" }),
    "Die Hoehle streckt sich nach Osten hin weiter aus.");
  AddDetail( ({ "norden" }),
    "Im Norden fuehrt ein breiter Gang aus der Hoehle hinaus.");
  AddDetail( ({ "gang" }),
    "Der Gang ist dunkler als die Hoehle und fuehrt nach Norden weiter.");
  AddDetail( ({ "schimmern" }),
    "Ein schimmernder schmaler Streifen zieht sich ueber die Waende. Das "
    "Schimmern erhellt den Raum jedoch nur sehr wenig.");
  AddDetail( ({ "streifen" }),
    "Eine silbrig schimmernde Erzader verlaeuft hier in einem schmalen "
    "Streifen mitten in der Wand.");
  AddDetail( ({ "erzader" }),
    "Anscheinend handelt es sich bei dieser Erzart um reines Silbererz.");
  AddDetail( ({ "erzart", "erzarten" }),
    "Es gibt viele verschiedene Erzarten, wie zum Beispiel Silbererze, "
    "Cobalterze und Nickelerze.");
  AddDetail( ({ "beispiel" }),
    "Das war nicht nur ein Beispiel, das waren sogar drei.");
  AddDetail( ({ "silbererze", "silbererz", "silber" }),
    "Diese Erze benoetigen sehr niedrige Temperaturen, um zu "
    "erkalten und zu erstarren. Vor vielen vielen Jahren, als heisses Magma vom "
    "Erdinneren in Richtung Erdoberflaeche heraufstieg, kamen diese Metalle also "
    "sehr weit nach oben und erstarrten dort, so dass man sie nun, wenn man sehr "
    "viel Glueck hat, in einigen Hoehlen nicht weit unter der Erde finden und "
    "abbauen kann.");
  AddDetail( ({ "erze" }),
    "Silber-, Cobalt- und Nickelerze sind hier gemeint.");
  AddDetail( ({ "temperaturen" }),
    "Je weiter man sich der Erdoberflaeche vom Erdkern her naehert, umso "
    "kaelter wird es.");
  AddDetail( ({ "erdoberflaeche" }),
    "Wenn Du nicht gerade der Rasse der Dunkelelfen angehoerst, wohnst "
    "Du wahrscheinlich dort.");
  AddDetail( ({ "rasse" }),
    "Du gehoerst zur Rasse der ...");
  AddDetail( ({ "dunkelelfen" }),
    "Du bist (k)eine(r).");
  AddDetail( ({ "erdkern" }),
    "Der Mittelpunkt der Erde.");
  AddDetail( ({ "mittelpunkt" }),
    "Der Mittelpunkt der Erde befindet sich in der Mitte der Erde. Logisch, oder?");
  AddDetail( ({ "erde" }),
    "Die ist irgendwo weit ueber Dir.");
  AddDetail( ({ "mitte" }),
    "Nicht am Rand, sondern in der Mitte.");
  AddDetail( ({ "rand" }),
    "Jemand rauft sich verzweifelt die Haare in der Ferne.");
  AddDetail( ({ "jemand" }),
    "Wer war das bloss?!");
  AddDetail( ({ "haare" }),
    "Deine Haare liegen heute wieder mal phantastisch.");
  AddDetail( ({ "ferne" }),
    "Du siehst niemanden.");
  AddDetail( ({ "jahren", "jahre" }),
    "Es ist bereits etliche Jahre her.");
  AddDetail( ({ "magma" }),
    "Mit Magma bezeichnet man heisses, fluessiges Gestein.");
  AddDetail( ({ "gestein" }),
    "Hier unten siehst Du nur festes, schwarzes Vulkangestein.");
  AddDetail( ({"vulkangestein"}),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "erdinneren" }),
    "Das Magma kam aus dem Erdinneren.");
  AddDetail( ({ "richtung" }),
    "Das Magma stieg in Richtung Erdoberflaeche.");
  AddDetail( ({ "metalle", "cobalterze", "cobalt", "nickelerze", "nickel" }),
    "Silber, Cobalt und Nickel sind Metalle.");
  AddDetail( ({ "glueck" }),
    "Vielleicht hast Du ja Glueck.");
  AddDetail( ({ "waende" }),
    "Die Waende bestehen aus schwarzem Vulkangestein. Ein schwaches "
    "Schimmern geht von ihnen aus. An einer Stelle scheint das Leuchten "
    "besonders stark zu sein.");
  AddDetail( ({ "schmutzschicht" }),
    "Direkt ueber dem seltsamen Leuchten ist die Wand etwas schmutzig.");
  AddDetail( ({ "wand" }),
    "An einer Wand faellt Dir ein helles Leuchten auf.");
// Unterscheiden ob schmutz da oder nicht ...
  AddSpecialDetail( ({ "leuchten", "schmutz", "licht", "blick",
                       "drang", "weile", "bann", "augen", "stelle" }), "details_leuchten");

  AddDetail( ({ "raum" }),
    "Ein schwaches Schimmern erfuellt den Raum und erhellt ihn ein wenig.");
  AddDetail( ({ "feuchtigkeit" }),
    "Eine leichte Feuchtigkeit liegt in der Luft.");
  AddDetail( ({ "luft" }),
    "Die Luft scheint hier etwas feucht zu sein.");
  AddDetail( ({ "boden" }),
    "Der Boden ist aus schwarzem Vulkangestein.");
  AddDetail( ({ "decke" }),
    "Hier in der Hoehle ist die Decke sehr niedrig.");

  AddSound( DEFAULT_SOUND,
    "Es ist sehr still. Du kannst keinen einzigen Laut hoeren.");

  AddSound( ({ "stille" }),
    "Es ist mucksmaeuschenstill hier in der Hoehle.");
  AddSound( ({ "hoehle" }),
    "Du hoerst absolut nichts.");
  AddSound( ({ "laut" }),
    "Du hoerst keinen einzigen Laut.");

  AddSmell( DEFAULT_SMELL,
    "Du kannst die Feuchtigkeit in der Luft beinahe riechen.");

  AddSmell( ({ "feuchtigkeit" }),
    "Du schnupperst ein wenig in der feuchten Luft herum.");
  AddSmell( ({ "luft" }),
    "Die Luft ist ein wenig feucht.");

  AddExit( "norden", N );
  AddExit( "osten", O );
  AddExit( "westen", W );
  
  AddCmd( ({ "wische", "wisch" }), "cmdwische" );
  AddCmd( ({ "entferne", "entfern" }), "cmdentferne" );
  AddCmd( ({ "kratze", "kratz" }), "cmdkratze" );
  AddCmd( ({ "beruehre", "beruehr" }), "cmdberuehren" );

}

string details_leuchten(string str)
{
  string s, s2;

  s2 = "Sowas siehst du da nicht!";

  switch(str)
  {
    case "leuchten":
      s = "Um das Leuchten genauer untersuchen zu koennen, solltest Du zuerst "
          +"den Schmutz entfernen.";
      s2 = "Das helle Licht zieht Deinen Blick magisch an und eine "
          +"ganze Weile lang starrst Du voellig selbstvergessen auf das Leuchten. Du "
          +"fuehlst den unwiderstehlichen Drang, in ihm zu versinken, mit ihm eins zu "
          +"werden, es zu beruehren... ";
      break;
    case "schmutz":
      s = "Wische ihn doch einfach weg.";
      s2 = "Wenn Du es Dir recht ueberlegst, ist die Wand eigentlich "
          +"gar nicht so schmutzig.";
      break;
    case "blick":
      s = "Dein Blick wird magisch von dem hellen Licht angezogen.";
      break;
    case "licht":
      s = "Obwohl es Dich blendet, vermagst Du es nicht, Deine Augen zu schliessen.";
      break;
    case "weile":
      s = "Du starrst das Licht gebannt an.";
      break;
    case "drang":
      s = "Das Licht zieht Dich voellig in seinen Bann.";
      break;
    case "bann":
      s = "Am liebsten wuerdest Du komplett in das Licht hineintauchen.";
      break;
    case "augen":
      s = "Du schaust Dich pruefend in der Hoehle um.";
      s2 = "Deine Augen sind weit geoeffnet.";
      break;
    case "stelle":
      s = "Eine Stelle an der Wand ist ein wenig schmutzig. Hinter der "
         +"Schmutzschicht siehst Du ein sehr helles blaues Leuchten.";
      s2= "An der Stelle erkennst Du ein helles blaues Leuchten.";
      break;
    default:
      s = "Sowas siehst du da nicht!"; // wie auch immer das passieren kann ...
  }
  if(schmutz == DA)
  {
  	return (BS(s));
  }
  return (BS(s2));
}

// Schmutz entfernen
int cmdentferne(string str)
{
  notify_fail( "Was willst Du entfernen?\n" );
  if(str == "schmutz" || str == "schmutzschicht" || str == "schicht")
  {
    write(BS("So wird das aber nichts. Lass Dir was Besseres einfallen."));
    return 1;
  }
  return 0;
}


// Schmutz entfernen
int cmdkratze(string str)
{
  notify_fail( "Was willst Du abkratzen?\n" );
  if(str == "schmutz ab" || str == "schmutzschicht ab" || str == "schicht ab")
  {
    write(BS("Du brichst Dir einen Fingernagel ab! So wird das nichts."));
    TP->AddHp(-random(10));
    return 1;
  }
  return 0;
}

// Schmutz entfernen
int cmdwische(string str)
{
  notify_fail( "Was willst Du wegwischen?\n" );
  if(str == "schmutz weg" || str == "schmutzschicht weg" || str == "schicht weg")
  {
    if(schmutz == DA)
    {
      write(BS("Du wischst den Schmutz saeuberlich von der Wand."));
      say(BS( PL->name()+" werkelt an einer Wand herum."));
      schmutz = WEG;
      return 1;      
    }
  }
  return 0;
}
// Leuchten beruehren
int cmdberuehren(string str)
{
  notify_fail( "Was willst Du beruehren?\n" );
  if(str == "licht " || str == "leuchten" || str == "wand")
  {
    if(schmutz == DA)
    {
      write(BS("Bei so viel Schmutz willst Du die Wand nicht beruehren."));
      return -1;
    }
    if(heilungen < MAXHEILUNG)
    {
      write(BS("Mit einem selbstvergessenen Laecheln auf dem Gesicht streckst Du "
              +"langsam Deine Hand aus. Als Du die Wand beruehrst, strahlt sie in "
              +"einem grellend weissen Lichtblitz auf und umhuellt Deinen gesamten "
              +"Koerper. Dir wird waermer und immer waermer, bis Du schliesslich "
              +"das Gefuehl hast, am ganzen Koerper geradezu zu vergluehen vor "
              +"Hitze, doch ploetzlich erlischt das Licht und Du erkennst wieder "
              +"Deine normale Umgebung rings um Dich herum. Du fuehlst Dich "
              +"erfrischt und bist nun fuer alle Aufgaben, die noch auf Dich lauern "
              +"moegen, bereit."));
      say(BS( PL->Name()+" taumelt benommen auf die Wand zu und ein helles "
              +"gleissendes Licht umhuellt "
              +(PL->QueryProp(P_GENDER) == MALE ? "ihn." : "sie.")+" Nach kurzer "
              "Zeit erlischt das Licht wieder und alles ist wie vorher."));
      TP->heal_self(HEILUNG);
      heilungen++;
      return 1;
    }
    else
    {
      write(BS("Du streckst langsam Deine Hand aus und beruehrst die Wand. Ein "
              +"schwacher Lichtblitz leuchtet zuckend auf und verschwindet dann "
              +"wieder."));
      say(BS( PL->Name()+" legt vorsichtig seine Hand auf die Wand und loest "
              +"einen schwachen Lichtblitz aus, der kurz durch die Hoehle "
              +"zuckt und dann wieder erlischt."));
      return -1;
    }
  }
  return 0;
}

reset()
{
  ::reset();
  
  schmutz = DA;
  heilungen = 0;
}
