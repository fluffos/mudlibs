
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define NO "./raumE4"
#define O "./raumE5"
#define NW "./raumC4"

int silber;

void create() 
{

  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einer kleinen Hoehle, die sich im Osten noch "
    "weiter ausbreitet. Es zweigen zwei breite Gaenge im Nordosten und "
    "Nordwesten ab, denen Du weiter folgen kannst. Von den Waenden geht "
    "ein schwaches Schimmern aus, so dass es hier in der Hoehle nicht "
    "ganz so dunkel ist wie in den Gaengen." );
    
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }),
    "Die Hoehle ist ziemlich klein und breitet sich nach Osten hin noch "
    "weiter aus.");
  AddDetail( ({ "osten" }),
    "Im Osten breitet sich die Hoehle noch weiter aus.");
  AddDetail( ({ "gaenge" }),
    "Zwei breite Gaenge zweigen im Nordosten und im Nordwesten von der "
    "Hoehle ab.");
  AddDetail( ({ "nordosten" }),
    "Ein breiter Gang fuehrt nach Nordosten weiter.");
  AddDetail( ({ "nordwesten" }),
    "Im Nordwesten fuehrt ein breiter, recht dunkel aussehender Gang aus "
    "der Hoehle hinaus.");
  AddDetail( ({ "gang" }),
    "Der Gang sieht recht dunkel aus. Er fuehrt nach Nordwesten.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen aus schwarzem Vulkangestein. Ein schwaches "
    "Schimmern geht von ihnen aus.");
  AddDetail( ({ "vulkangestein", "gestein" }),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "schimmern" }),
    "Von den Waenden geht ein seltsames, schwaches Leuchten aus, das "
    "jedoch nicht ausreicht, um den Raum besonders stark zu erhellen.");
  AddDetail( ({ "leuchten" }),
    "Neugierig unterziehst Du die Hoehlenwaende einer genaueren "
    "Untersuchung und erkennst schliesslich, dass hier eine lange, "
    "schmale Erzader verlaeuft, von der ein silbriges Schimmern ausgeht.");
  AddDetail( ({ "hoehlenwaende" }),
    "Die Waende der Hoehle bestehen aus Vulkangestein. Etwa in "
    "Schulterhoehe von Dir kannst Du einen schwach silbrig glaenzenden "
    "Streifen erkennen, von dem das Schimmern ausgeht, welches den Raum "
    "erfuellt.");
  AddDetail( ({ "schulterhoehe" }),
    "Etwa in Schulterhoehe kannst Du einen schwach sibrig glaenzenden Streifen "
    "erkennen.");
  AddDetail( ({ "streifen" }),
    "Der Streifen entpuppt sich beim genaueren Hinsehen als eine "
    "Erzader, die hier in der Wand verlaeuft.");
  AddDetail( ({ "hinsehen" }),
    "Sieh genau hin.");
  AddDetail( ({ "untersuchung" }),
    "Du untersuchst die Hoehlenwaende ganz genau.");
  AddDetail( ({ "erzader", "silbererzader" }),
    "Eine lange, schmale Erzader durchzieht die Hoehlenwaende. Es "
    "scheint sich um reines Silbererz zu handeln.");
  AddDetail( ({ "silbererz" }),
    "Vor Millionen von Jahren stieg heisses Magma aus dem Erdinneren in "
    "die hoeheren Bereiche der Erdkruste empor. Ein Teil dieses Magmas "
    "kuehlte ab und erstarrte zu Gesteinskoerpern. Die im Magma "
    "enthaltenen Mineralien waren bei diesen Temperaturen noch fluessig. "
    "Je hoeher die Schmelzen gelangten, umso kaelter wurde die Umgebung. "
    "Da Silber-, Cobalt- und Nickelerze zum Erstarren die niedrigste "
    "Temperaturen benoetigen, stiegen diese am hoechsten.");
  AddDetail( ({ "jahren" }),
    "Vor Millionen von Jahren.");
  AddDetail( ({ "millionen" }),
    "Das ist wirklich schon seeehr lange her.");
  AddDetail( ({ "magma" }),
    "Magma ist fluessiges Gestein, das viele verschiedene Elemente enthaelt.");
  AddDetail( ({ "elemente" }),
    "Zum Beispiel Silber, Cobalt oder Nickel.");
  AddDetail( ({ "beispiel", "beispiele" }),
    "Das waren einige Beispiele.");
  AddDetail( ({ "erdinneren" }),
    "Das Magma stieg aus dem Erdinneren hinauf in Richtung Erdkruste.");
  AddDetail( ({ "richtung" }),
    "Es stieg von unten nach oben, waer ja auch bloed wenn andersrum.");
  AddDetail( ({ "erdkruste" }),
    "Man koennte auch Erdoberflaeche dazu sagen.");
  AddDetail( ({ "erdoberflaeche", "oberflaeche" }),
    "Die Oberflaeche der Erde, auf oder unter der Du lebst.");
  AddDetail( ({ "erde" }),
    "Momentan befindest Du Dich unterhalb der Erde.");
  AddDetail( ({ "bereiche" }),
    "Das Magma stieg in die hoeheren Bereiche der Erdkruste hinauf.");
  AddDetail( ({ "teil" }),
    "Nur ein Teil des Magmas kuehlte ab.");
  AddDetail( ({ "gesteinskoerper" }),
    "Ein Teil des heissen Magmas kuehlte ab und erstarrte zu "
    "Gesteinskoerpern.");
  AddDetail( ({ "mineralien", "mineral" }),
    "Mineralogen definieren Mineralien folgendermassen: Ein "
    "Mineral ist ein homogener, natuerlich vorkommender kristalliner, im "
    "allgemeinen anorganischer Festkoerper mit ganz bestimmter chemischer "
    "Zusammensetzung.");
  AddDetail( ({ "mineraloge" }),
    "Du bist kein Mineraloge.");
  AddDetail( ({ "festkoerper", "koerper" }),
    "Es gibt feste Koerper, fluessige Koerper, gasfoermige Koerper...");
  AddDetail( ({ "zusammensetzung" }),
    "Mineralien bestehen aus einem oder aus mehreren verschiedenen Elementen.");
  AddDetail( ({ "temperaturen" }),
    "Silber zum Beispiel schmilzt bei 961 Grad.");
  AddDetail( ({ "grad", "typ" }),
    "Celsius.");
  AddDetail( ({ "celsius" }),
    "Der Typ, der die Temperaturskala erfunden hat.");
  AddDetail( ({ "temperaturskala", "skala" }),
    "Die wurde von Celsius erfunden.");
  AddDetail( ({ "schmelzen" }),
    "Aufsteigendes Magma.");
  AddDetail( ({ "umgebung" }),
    "Die Umgebung wurde in Richtung Erdkruste immer kaelter.");
  AddDetail( ({ "silber" }),
    "Silber ist ein weissglaenzendes und weiches Edelmetall. Hat man "
    "einmal soviel Glueck und entdeckt eine der seltenen Silbererzadern, "
    "sollte man die Gelegenheit nutzen und danach schuerfen.");
  AddDetail( ({ "edelmetall" }),
    "Edelmetalle oxidieren nicht, das heisst, sie verbinden sich nicht mit Luft.");
  AddDetail( ({ "luft" }),
    "Edelmetalle verbinden sich nicht mit Luft.");
  AddDetail( ({ "glueck" }),
    "Man braucht wirklich sehr viel Glueck, um eine der seltenen "
    "Silbererzadern zu finden.");
  AddDetail( ({ "gelegenheit" }),
    "Nutze Deine Gelegenheit.");
  AddDetail( ({ "cobalt", "cobalterz", "cobalterze" }),
    "Cobalt ist ein sehr zaehes Schwermetall.");
  AddDetail( ({ "schwermetall" }),
    "Schwermetalle haben eine sehr hohe Dichte.");
  AddDetail( ({ "dichte" }),
    "Mehr als 4500 kg/m^3.");
  AddDetail( ({ "nickel", "nickelerz", "nickelerze" }),
    "Nickel ist ein silberweiss glaenzendes Schwermetall, das sich gut "
    "schmieden laesst.");
  AddDetail( ({ "erstarren" }),
    "Wenn ein Mineral vom fluessigen in den festen Zustand uebergeht, "
    "nennt man dies auch Erstarren.");
  AddDetail( ({ "zustand" }),
    "Fest, fluessig, gasfoermig...");
  AddDetail( ({ "raum" }),
    "Der Raum wird von einem schwachen Schimmern erfuellt.");
  AddDetail( ({ "decke" }),
    "Die Decke ist hier ein wenig niedriger als in den Gaengen.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht aus schwarzem Vulkangestein.");

  AddSound( DEFAULT_SOUND,
    "Du bildest Dir ein, ein leichtes Blubbern zu hoeren.");

  AddSound( ({ "blubbern" }),
    "Ob es das aufsteigende Magma ist?");
  AddSound( ({ "magma" }),
    "Es wird auf einmal so heiss hier drinnen...");

  AddSmell( DEFAULT_SMELL,
    "Du bist erkaeltet und kannst leider nichts mehr riechen.");

  AddExit( "nordosten", NO );
  AddExit( "osten", O );
  AddExit( "nordwesten", NW );

  AddCmd( ({ "schuerfe", "schuerf" }), "cmdschuerfen" );

  AddItem(NPC "hoehlenspinne", REFRESH_DESTRUCT, 
          ([P_MNPC_DEFAULTROOM : ROOM "raumD5" ]) );

  silber = DA;

}

int cmdschuerfen(string str )
{
  object mysilber, myspitzhacke;
  notify_fail( "Wonach willst Du schuerfen?\n" );
  
  if(str == "edelstein" || str == "edelsteine" || str == "nach edelstein" || str == "nach edelsteine")
  {
    write(BS("Nach Edelsteinen zu schuerfen ist wohl ein sinnloses Unterfangen."));
    return -1;
  }
  
  if(str == "silber" || str == "nach silber")
  {

    myspitzhacke = present("spitzhacke", TP);
    if(!myspitzhacke || !myspitzhacke->QueryProp(P_WIELDED))
    {
      write(BS("Ohne eine gezueckte Spitzhacke wird das aber nichts!"));
      return -1;
    }
    
    if(silber == DA)
    {
      mysilber=clone_object(OBJ "silberbrocken");
      if(mysilber)
      {
        if(ME_TOO_HEAVY==mysilber->move(TP,M_GET|M_SILENT))
        {
          write(BS("Du packst die Spitzhacke und beginnst zu graben ... Ploetzlich "
                +"faellt Dir was auf. Du findest etwas Glaenzendes. Da es Dir zu "
                +"schwer ist laesst Du es zu Boden fallen."));
          say( BS(PL->name()+" nimmt eine Spitzhacke und graebt herum."));
          mysilber->move(TO,M_GO|M_SILENT);
          silber = WEG;
          return 1;
        }
        else
        {
          write(BS("Du packst die Spitzhacke und beginnst zu graben ... Ploetzlich "
                  +"faellt Dir was auf. Du findest etwas Glaenzendes. Schnell "
                  +"schiebst Du es ein."));
          say( BS(PL->name()+" nimmt eine Spitzhacke und graebt herum."));
          silber = WEG;
          return 1;
        }
      }
    }
    else
    {
      write(BS("Du schuerfst ... findest aber nichts."));
      say( BS(PL->name()+" nimmt eine Spitzhacke und graebt herum."));
      return -1;
    }
  }

  if(str == "gold" || str == "nach gold")
  {
    write(BS("Das ist eine _Silberader_. Nach Gold zu schuerfen koennte etwas "
            +"laenger dauern."));
    return -1;
  }
 
  return 0;
}

reset()
{
  ::reset();
  
  if(silber == WEG)
  {
    silber = DA;
  }
}
