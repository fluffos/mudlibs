
#include "../def.h"

inherit "std/room";

#include <properties.h>

#define S ROOM "raumC3"
#define UNTEN "./schatzraum1"

void create() 
{

  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du stehst in einem sorgfaeltig aus dem Stein geschlagenen Gang, der "
    "sich hier zu einer kleinen Hoehle ausweitet. Die Waende und die "
    "Decke sind komplett von Spinnenweben bedeckt und in einer Ecke des "
    "Raumes siehst Du einen grossen dunklen Fleck. Daneben liegen einige "
    "alte, abgenagte Knochen herum." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "stein" }),
    "Der Gang wurde sorgfaeltig aus dem harten Gestein herausgearbeitet.");
  AddDetail( ({ "gang" }),
    "Der Gang weitet sich hier zu einer kleinen Hoehle aus.");
  AddDetail( ({ "hoehle" }),
    "Die Hoehle wurde ebenso sorgfaeltig bearbeitet wie der Gang. "
    "Irgendwie ist es unheimlich hier. Die Waende sind ueber und ueber "
    "mit Spinnenweben bedeckt, an einigen Stellen tropft ekliger Schleim "
    "herunter und auf dem Boden krabbeln viele kleine Spinnen herum.");
  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind ueber und ueber mit Spinnenweben bedeckt. An "
    "einigen Stellen tropft ekliger Schleim herunter und Du hast das "
    "Gefuehl, dass Du von unsichtbaren Augen beobachtet wirst. Im Sueden "
    "befindet sich eine schwere Eisentuer.");
  AddDetail( ({ "spinnenweben", "spinnweben" }),
    "Dicke Spinnenweben und schleimige Faeden ueberziehen die Waende und "
    "die Decke.");
  AddDetail( ({ "faeden" }),
    "Die Faeden sind sehr schleimig und klebrig.");
  AddDetail( ({ "decke" }),
    "Die Decke ist komplett mit Spinnenweben bedeckt.");
  AddDetail( ({ "stellen" }),
    "An einigen Stellen tropft ekliger Schleim auf den Boden herab und "
    "bildet kleine Pfuetzen.");
  AddDetail( ({ "schleim" }),
    "Ekliger, klebriger Schleim tropft von den Waenden herab.");
  AddDetail( ({ "boden" }),
    "Ueberall auf dem Boden krabbeln kleine Spinnen umher, die eifrig "
    "damit beschaeftigt zu sein scheinen, in Hoechstgeschwindigkeit "
    "immer neue Spinnenweben zu weben. Kleine Pfuetzen aus Schleim "
    "befinden sich auf dem Boden. In der Mitte der Hoehle siehst Du "
    "eine Leiter, die nach unten fuehrt.");
  AddDetail( ({ "spinnen" }),
    "Viele kleine Spinnen krabbeln auf dem Boden herum. Eine von ihnen "
    "krabbelt gerade zielstrebig auf Dich zu.");
  AddDetail( ({ "spinne" }),
    "Aengstlich beobachtest Du, wie die Spinne auf dich zukommt, doch "
    "ploetzlich scheint sie das Interesse an Dir zu verlieren und Du "
    "atmest erleichtert auf, als sie in eine andere Richtung "
    "weiterkrabbelt.");
  AddDetail( ({ "interesse" }),
    "Anscheinend hat die kleine Spinne jegliches Interesse an Dir verloren.");
  AddDetail( ({ "richtung" }),
    "Die kleine Spinne ist laengst ueber alle Berge.");
  AddDetail( ({ "berge" }),
    "Du kannst sie nirgendwo mehr sehen.");
  AddDetail( ({ "hoechstgeschwindigkeit" }),
    "Die Spinnen weben blitzschnell immer neue Spinnenweben und "
    "verteilen sie im ganzen Raum, bis er zu einem einzigen grossen Nest wird.");
  AddDetail( ({ "raum" }),
    "Die ganze Hoehle ist mit Spinnenweben ausgefuellt.");
  AddDetail( ({ "nest" }),
    "Wer mag nur in diesem grossen Nest wohnen?");
  AddDetail( ({ "pfuetzen", "pfuetze" }),
    "Kleine Pfuetzen aus Schleim befinden sich ueberall auf dem Boden.");
  AddDetail( ({ "gefuehl" }),
    "Du fuehlst Dich sehr unwohl.");
  AddDetail( ({ "augen" }),
    "Unsichtbare Augen beobachten jede Deiner Bewegungen.");
  AddDetail( ({ "bewegungen" }),
    "Du fuehlst Dich beobachtet.");
  AddDetail( ({ "gestein" }),
    "Vulkangestein");
  AddDetail( ({"vulkangestein"}),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "ecke" }),
    "In einer Ecke der Hoehle siehst Du einen grossen dunklen Fleck auf "
    "dem Boden.");
  AddDetail( ({ "fleck" }),
    "Der Fleck entpuppt sich beim genaueren Hinsehen als die Ueberreste "
    "einer grossen Hoehlenechse.");
  AddDetail( ({ "hinsehen" }),
    "Schau ruhig genauer hin.");
  AddDetail( ({ "ueberreste" }),
    "Viel ist von der Echse nicht mehr uebrig.");
  AddDetail( ({ "hoehlenechse", "echse" }),
    "Du siehst die Ueberreste einer grossen Hoehlenechse in einer Ecke "
    "liegen. Da hatte wohl jemand grossen Hunger...");
  AddDetail( ({ "knochen" }),
    "Neben den Ueberresten liegen einige alte, saeuberlich abgenagte "
    "Knochen herum. Du willst gar nicht wissen, von welchen Wesen die "
    "alle stammen...");
  AddDetail( ({ "wesen" }),
    "Du siehst grosse und kleine Knochen von Ratten, Maeusen, Hoehlenechsen, "
    "Zwergen...");
  AddDetail( ({ "hunger" }),
    "Wer gerne Hoehlenechsen frisst, schreckt wohl auch vor einer "
    "leckeren Mahlzeit wie Dir nicht zurueck.");
  AddDetail( ({ "mahlzeit" }),
    "Du wuerdest sicherlich eine leckere Mahlzeit abgeben.");
  AddDetail( ({ "ratten", "rattenknochen" }),
    "Einige abgenagte Rattenknochen liegen auf dem Boden herum.");
  AddDetail( ({ "maeuse", "maeuseknochen" }),
    "Winzige Maeuseknochen liegen hier herum.");
  AddDetail( ({ "tuergriff" }),
    "Du kannst keinen Tuergriff sehen.");
  AddDetail( ({ "seite" }),
    "Wenn Du Dich von dieser Seite gegen die Tuer stemmst, koenntest Du sie "
    "oeffnen.");
  AddDetail( ({ "schluesselloch" }),
    "So sehr Du Dich auch bemuehst, Du kannst kein Schluesselloch entdecken.");
  AddDetail( ({ "mitte" }),
    "In der Mitte der Hoehle fuehrt eine Leiter nach unten.");
  AddDetail( ({ "leiter" }),
    "Die Leiter fuehrt nach unten.");
  AddSpecialDetail( ({"wesen"}), "strwesen");
  AddSpecialDetail( ({"dunkelelfen", "elfen", "menschen", "zwergen",
                      "trollen", "ogern", "feen", "hobbits"}), "strrasse");


  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Klacken.");

  AddSound( ({ "klacken" }),
    "Ein leises Klacken dringt an Dein Ohr. Wie von tausend Spinnen ...");
  AddSound( ({ "ohr" }),
    "Beunruhigt lauschst Du dem leisen Klacken, das von den vielen "
    "kleinen Spinnen verursacht wird, die hier herumlaufen.");
  AddSound( ({ "spinnen" }),
    "Die Spinnen krabbeln blitzschnell hin und her und verursachen dabei "
    "ein leises bedrohliches Klacken.");

  AddSmell( DEFAULT_SMELL,
    "Es stinkt hier fuerchterlich nach Schleim und Eingeweiden.");

  AddSmell( ({ "schleim" }),
    "Der Schleim stinkt furchtbar.");
  AddSmell( ({ "eingeweide" }),
    "Du bekommst kaum Luft, so fuerchterlich stinkt es hier nach "
    "alten Eingeweiden.");
  AddSmell( ({ "luft" }),
    "Es stinkt fuerchterlich!");

  AddItem(NPC "tarantula", REFRESH_REMOVE);

  NewDoor("sueden", S , ({"eisentuer", "tuer"}) ,
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Eisentuer.",
      D_LONG, "Eine schwere Eisentuer verhindert, dass Du weiter nach Sueden "
              "vordringen kannst. Die Eisentuer besitzt keinen Tuergriff oder "
              "Schluesselloch, dennoch erkennst Du, dass sie nur angelehnt ist "
              "und sich daher von dieser Seite aus oeffnen laesst.",
      D_NAME,  "Eisentuer",
      D_GENDER,FEMALE,
      D_OPENMSG, ({"Du stemmst Dich gegen die Eisentuer im Sueden und oeffnest sie.",
                   "%s stemmt sich gegen die Eisentuer im Sueden und oeffnet sie.",
                   " wird von der anderen Seite aufgestemmt."}),
      D_CLOSETESTFUNC, "tuerschliessen",
      D_RESET_CLOSEMSG,
                  " im Sueden ist zugefallen!\n"
    })
  );

  AddGuardedExit("unten",UNTEN,"tarantula", 
                 "Tarantula starrt Dich hungrig an und Du weichst zurueck.\n");

  AddCmd(({"opfer","opfere"}), "cmdopfern");


}

string strrasse(string str)
{
/*
Knochen nach Rassen ...
*/
string s, race;

  s = "Schaudernd drehst Du Dich weg, als Du ein paar alte ";
  
  race = TP->QueryProp(P_RACE);
  
  if (!stringp(str)) { return("Sowas siehst Du da nicht!\n"); }
  
  if( strstr(str, lower_case(race), 0) == -1 )
  { return("Sowas siehst Du da nicht!\n"); }
  
  switch(race)
  {
    case "Dunkelelf" :
      s += "Dunkelelfen";
      break;
    case "Elf" :
      s += "Elfen";
      break;
    case "Hobbit" :
      s += "Hobbits";
      break;
    case "Zwerg" :
      s += "Zwergen";
      break;
    case "Mensch" :
      s += "Menschen";
      break;
    case "Troll" :
      s += "Trollen";
      break;
    case "Oger" :
      s += "Ogern";
      break;
    case "Fee" :
      s += "Feen";
      break;
    default : // keine bekannte Rasse ...
      return("Sowas siehst Du da nicht!\n");
    }
    
    s += "knochen auf dem Boden herumliegen siehst.";
    return(BS(s));
}
string strwesen(string str)
{
  string s, race;
  s = "Du siehst grosse und kleine Knochen von Ratten, Maeusen, Hoehlenechsen";

  race = TP->QueryProp(P_RACE);

  switch(race)
  {
    case "Dunkelelf" :
      s += ", Dunkelelfen...";
      break;
    case "Elf" :
      s += ", Elfen...";
      break;
    case "Hobbit" :
      s += ", Hobbits...";
      break;
    case "Zwerg" :
      s += ", Zwergen...";
      break;
    case "Mensch" :
      s += ", Menschen...";
      break;
    case "Troll" :
      s += ", Trollen...";
      break;
    case "Oger" :
      s += ", Ogern...";
      break;
    case "Fee" :
      s += ", Feen...";
      break;
    default : // keine bekannte Rasse ...
      s += "...";
      break;
    }
    return(BS(s));
}


// Die Tuer laesst sich nicht von Innen schliessen
int tuerschliessen()
{
  write(BS("Du siehst keinen Tuergriff und willst Dir Deine Finger nicht "
           "einklemmen!"));
  return 1;
}
// gehen haustiere?
int opfer(object ob)
{
  if(query_once_interactive(ob) || interactive(ob)) return 0;
  if(!living(ob)) return 0;

  if(ob->id("elementar")) return 0;
  if(ob->id("feuerwusel")) return 0;

  if(ob->is_class_member(({CL_DEMON,CL_UNDEAD}))) return 0;
  
  return 1;
}

int cmdopfern(string str)
{
  int opfer;

  object *opfertiere;
  object spinne, qitem;

  string petowner;

  notify_fail("Was willst Du opfern?\n");

  if(!str) return 0;
  
  if(!spinne=present("tarantula"))
  {
    write(BS("Wem willst Du ein Opfer bringen?"));
    return 1;
  }
  
  // Alle Lebewesen im Raum _ohne_ Tarantula
  opfertiere=all_inventory(TO)-({spinne});
  
  // Opferbare Tiere rausfiltern
  opfertiere=filter_array(opfertiere, "opfer");
  
  // Angegebenes Opfertier noch vorhanden?
  opfertiere= filter_objects(opfertiere, "id" , str);

  if(!sizeof(opfertiere))
  {
    write(BS("Ohne geeignetes Opfertier??? Was soll das?"));
    return -1;
  }
  else
  {
    // erstes Element == angegebenes Opfertier, faengt bei 0 an zu zaehlen
    opfer=0; 

    // Nur seine eigenen Haustiere ...
    petowner = opfertiere[opfer]->QueryProp("pet_owner_name");
    if (petowner && getuid(this_interactive()) != petowner)
    { 
      write(BS("Ohne geeignetes Opfertier??? Was soll das?"));
      return -1;
    }

    tell_room(TO, BS("Tarantula naehert sich "+opfertiere[opfer]->name(WEM)
     +" und stuerzt sich auf "+opfertiere[opfer]->QueryPronoun(WEN)+"."));

    if(qitem = present( QUESTITEM, TP)) // Questitem vorhanden?
    {
      if(!qitem->QuerySpinne()) // Log scroll reduzieren
      {
        qitem->SetSpinne();
        write_file(QUESTLOG "quest.log", 
        dtime(time())+": "+CAP(getuid(TP))+" fuettert Tarantula mit "+opfertiere[opfer]->name(WEM)+"!\n" );
      }
    }

    opfertiere[opfer]->die(1);

    tell_room(TO, BS("Anschliessend schleift Tarantula ihr Opfer in die Ecke, "
                    +"um es einzuspinnen. Der Weg nach unten ist nun frei!"));

    spinne->SetChats(10, ({
    "Tarantula spinnt ihr Opfer ein.\n",
    "Tarantula bewegt ihre acht Augen wachsam in Deine Richtung.\n"}) );

    RemoveGuardedExit("unten");
    AddExit( "unten", UNTEN );
    
    return 1;
  }
  return 0;
}

reset()
{
  object myspider;

  ::reset();
  
    RemoveExit("unten");
    AddGuardedExit("unten",UNTEN,"tarantula", 
                 "Tarantula starrt Dich hungrig an und Du weichst zurueck.\n");

  myspider=present("tarantula");
  if(myspider)
  {
    myspider->SetChats(10, ({
    "Die Tarantula mustert Dich kalt.\n",
    "Die Tarantula sucht ein Opfer.\n",
    "Die Tarantula bewegt ihre acht Augen wachsam in Deine Richtung.\n"}) );
  }
}
