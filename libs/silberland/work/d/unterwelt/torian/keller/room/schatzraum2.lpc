
#include "../def.h"

inherit "std/room";

#include <properties.h>

int truhe, kiste, schatulle, stab, edelsteine, perlen;

void bewegen(object player);

void create() 
{

  ::create();

  truhe = kiste = schatulle = stab = edelsteine = perlen = DA;

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG,
    "Du bist in einem kleinen und sehr engen Raum gelandet. Die eine "
    "Wand ist komplett eingestuerzt und Du siehst nur einen grossen "
    "Steinhaufen dort mit einem kleinen Durchschlupf darin, durch den Du "
    "hereingekrochen bist. An den anderen Waenden befinden sich einige "
    "Regale und auf dem Boden liegen viele Kisten und Kartons herum." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 0, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "raum" }),
    "Dieser Raum ist sehr eng und dunkel. Es ist sehr unordentlich hier. "
    "Ueberall sind Kisten und Kartons auf dem Boden verstreut und die "
    "Regale an den Waenden sind mit allen moeglichen Gegenstaenden "
    "vollgestopft.");
  AddDetail( ({ "kisten" }),
    "Viele Kisten liegen kreuz und quer ueber den Boden verstreut herum. "
    "Sie scheinen alle die gleiche Groesse zu haben und groesstenteils "
    "stark beschaedigt zu sein. Nur eine einzige Kiste scheint noch "
    "voellig unversehrt zu sein.");
  AddDetail( ({ "kiste" }),
    "Die Kiste scheint nicht beschaedigt zu sein.");
  AddDetail( ({ "unordnung", "hause" }),
    "Wie bei Dir zu Hause.");
  AddDetail( ({ "boden" }),
    "So eine Unordnung! Auf dem Boden liegen ueberall mehr oder weniger "
    "kaputte Kisten und Kartons herum und alles ist von einer dicken "
    "Staubschicht bedeckt. In den Ecken kannst Du Spinnweben sehen.");
  AddDetail( ({ "undordnung" }),
    "Hier ist es wirklich sehr unordentlich.");
  AddDetail( ({ "kartons" }),
    "Die Kartons, die ueberall auf dem Boden herumliegen, sind aus "
    "fester Pappe gefertigt und ziemlich schmutzig.");
  AddDetail( ({ "pappe" }),
    "Die Pappe ist stark verschmutzt.");
  AddDetail( ({ "staubschicht", "staub" }),
    "Alles ist von einer dicken Staubschicht bedeckt.");
  AddDetail( ({ "spinnweben" }),
    "Wie eigentlich alles hier unten sind auch die Spinnweben leicht verstaubt.");
  AddDetail( ({ "groesse" }),
    "Die Kisten sind alle gleich gross.");
  AddDetail( ({ "wand" }),
    "In der Richtung, aus der Du hergekommen bist, ist die Wand komplett "
    "eingestuerzt. Ein kleiner Durchschlupf befindet sich mitten in dem "
    "Steinhaufen.");
  AddDetail( ({ "richtung" }),
    "Aus welcher Richtung Du gekommen bist, solltest Du schon selber wissen.");
  AddDetail( ({ "durchschlupf" }),
    "Dort kannst Du diesen Raum wieder verlassen.");
  AddDetail( ({ "steinhaufen" }),
    "Dort, wo die Wand eingestuerzt ist, siehst Du nur noch einen grossen "
    "Steinhaufen vor Dir aufragen.");
  AddDetail( ({ "waende" }),
    "An den Waenden befinden sich einige Regale, die bis obenhin mit "
    "allerlei Krimskrams vollgestopft sind.");
  AddDetail( ({ "regale", "regal" }),
    "Die Regale an den Waenden sind ueber und ueber mit Krimskrams vollgestopft.");
  AddDetail( ({ "krimskrams" }),
    "Vielleicht ist ja etwas dabei, das Du gebrauchen kannst.");
  AddDetail( ({ "gegenstaende" }),
    "In einem der Regale siehst Du einige alte Kleidungsstuecke "
    "herumliegen, in einem anderen befinden sich eine grosse vergoldete "
    "Schale, zwei silberne Kerzenstaender, eine kleine kupferfarbene "
    "Waage und eine kleine verzierte Schatulle. Ein weiteres Regal ist "
    "mit kleinen Flaeschchen und allerlei anderen Dingen vollgestopft, "
    "deren Funktionsweise Du allerdings nicht erkennen kannst.");
  AddDetail( ({ "kleidungsstuecke", "sachen" }),
    "Anscheinend handelt es sich hierbei um Mabruks alte Magierkleidung, "
    "die er frueher getragen hat. Die Sachen sehen schon sehr abgenutzt "
    "aus.");
  AddDetail( ({ "mabruk", "magier" }),
    "Mabruk war frueher ein sehr maechtiger Magier.");
  AddDetail( ({ "magierkleidung" }),
    "Du siehst eine weite rote Kutte, eine rote Hose und rote enge "
    "Schnuerstiefel dort liegen.");
  AddDetail( ({ "kutte" }),
    "Die Kutte sieht schon sehr abgenutzt aus.");
  AddDetail( ({ "hose" }),
    "Die Hose hat ein paar Loecher und die Naehte sind an einigen Stellen "
    "aufgeplatzt.");
  AddDetail( ({ "loecher" }),
    "Die Hose hat ein paar Loecher.");
  AddDetail( ({ "naehte","stellen" }),
    "Die Naehte der Hose sind an einigen Stellen aufgeplatzt.");
  AddDetail( ({ "schnuerstiefel", "stiefel" }),
    "Die Stiefel haben stark abgenutzte Sohlen und bei einem fehlen die "
    "Schnuersenkel.");
  AddDetail( ({ "sohlen" }),
    "Die Sohlen sind stark abgenutzt.");
  AddDetail( ({ "schnuersenkel" }),
    "Einer der Schnuersenkel fehlt.");
  AddDetail( ({ "schale" }),
    "Die Schale ist vergoldet. Ihre Oberflaeche ist ein wenig zerkratzt.");
  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche der Schale ist etwas zerkratzt.");
  AddDetail( ({ "kerzenstaender" }),
    "Zwei kleine silberne Kerzenstaender liegen im Regal. Es befinden "
    "sich keine Kerzen darin.");
  AddDetail( ({ "kerze", "kerzen" }),
    "In den Kerzenstaendern befinden sich keine Kerzen.");
  AddDetail( ({ "waage" }),
    "Eine winzig kleine, kupferfarbene Waage steht in dem Regal. An "
    "ihrer Seite stecken kleine Gewichte in extra dafuer vorgesehenen "
    "Einbuchtungen.");
  AddDetail( ({ "seite" }),
    "An der Seite der Waage befinden sich kleine Einbuchtungen.");
  AddDetail( ({ "gewichte" }),
    "Die Gewichte sind sehr klein und bestehen aus Blei.");
  AddDetail( ({ "blei" }),
    "Die Gewichte sind aus Blei.");
  AddDetail( ({ "einbuchtungen" }),
    "In den Einbuchtungen stecken kleine Gewichte.");
  AddSpecialDetail( ({ "schatulle" }), "strschatulle");
  AddSpecialDetail( ({ "truhe" }), "strtruhe");
  AddSpecialDetail( ({ "abdruck", "schimmer", "stab", "kissen",
                       "samtkissen" }), "details_in_truhe");
  AddDetail( ({ "gold" }),
    "Die Schatulle ist mit Gold verziert.");
  AddDetail( ({ "flaeschchen" }),
    "Die Flaeschchen enthalten getrocknete Kraeuter.");
  AddDetail( ({ "kraeuter" }),
    "Du kannst leider nicht genau sagen, um was fuer Kraeuter es sich handelt.");
  AddDetail( ({ "dinge", "dingen" }),
    "Die Regale sind mit vielen Dingen vollgestopft, deren Funktionsweise Du "
    "nicht erkennen kannst.");
  AddDetail( ({ "funktionsweise" }),
    "Du hast keine Ahnung, wozu diese Dinge gut sind.");
  AddDetail( ({ "ahnung" }),
    "Du hast absolut keine Ahnung.");
  AddDetail( ({ "ecken" }),
    "In den Ecken haengen leicht verstaubte Spinnweben. In einer Ecke "
    "auf dem Boden steht eine kleine Truhe, die Dir bisher gar nicht "
    "aufgefallen war.");
  AddDetail( ({ "verzierungen", "verzierung" }),
    "Die Truhe ist kunstvoll verziert.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus schwarzem Vulkangestein und ist hier sehr niedrig.");
  AddDetail( ({"vulkangestein", "gestein"}),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "ecke" }),
    "Ganz hinten in einer Ecke des Raumes steht eine kleine Truhe auf dem Boden.");

  AddSound( DEFAULT_SOUND,
    "Es herrscht absolute Stille.");

  AddSound( ({ "stille" }),
    "Du kannst nichts hoeren, so sehr Du Dich auch anstrengst.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht sehr stark nach Staub. Auch ein schwacher wuerziger Geruch "
    "dringt an Deine Nase.");

  AddSmell( ({ "staub" }),
    "Alles hier im Raum ist mit Staub ueberzogen.");
  AddSmell( ({ "raum"}),
    "Es riecht staubig.");
  AddSmell( ({ "nase"}),
    "Steck Deine Nase nicht ueberall rein!");
  AddSmell( ({ "geruch"}),
    "Der Geruch kommt von einem der Regale.");
  AddSmell( ({ "regale"}),
    "Die Flaeschchen im Regal verstroemen ein schwachen wuerzigen Geruch.");
  AddSmell( ({ "flaeschchen"}),
    "Ein wuerziger Geruch stroemt aus den Flaeschchen.");

  AddCmd( ({ "verlasse" }), "cmdverlasse" );
  AddCmd( ({ "krieche", "kriech" }), "cmdkrieche" );
  AddCmd( ({ "schluepfe", "schluepf" }), "cmdschluepfe" );
  AddCmd( ({ "kletter", "klettere" }), "cmdkletter" );
  AddCmd( ({ "oeffne" }), "cmdoeffne" );
  AddCmd( ({ "nimm" }), "cmdnimm" );
}
string details_in_truhe(string key)
{
  string s;
  if(truhe == DA) { return "Sowas siehst Du da nicht!"; }

  switch(key)
  {
  	case "kissen":
  	case "samtkissen":
  	  if(stab == DA)
  	    s = "Auf dem Samtkissen liegt ein kleiner Stab.";
      else
        s = "Du siehst einen leichten Abdruck auf dem Kissen.";
      break;
    case "stab":
      s = "Der Stab scheint magisch zu sein.";
      break;
    case "abdruck":
      if(stab == WEG)
        s = "Irgendetwas scheint hier noch vor kurzem gelegen zu haben.";
      else
        s = "Sowas siehst Du da nicht!";
      break;
    case "schimmer":
      s = "Der Stab wird von einem magischen blauen Schimmer umgeben.";
      break;
    default:
      s = "Sowas siehst Du da nicht!";
  }
  return BS(s);
}
string strtruhe(string key)
{
  string s;
  s = "Eine kleine Truhe mit kunstvollen Verzierungen steht in der Ecke. ";

  if(truhe == DA) { s += "Sie ist geschlossen. "; return BS(s); }
  else { s += "Sie ist geoeffnet. "; }
  if(stab == DA)
  {
  	s += "Auf einem dunkelblauen Samtkissen in der Truhe ruht ein kleiner "
         "Stab, der von einem magischen blauen Schimmer umgeben ist. ";
  }
  else
  {
  	s += "Ein dunkelblaues Samtkissen liegt in der Truhe. An einem leichten "
        +"Abdruck kannst Du sehen, dass noch vor kurzem etwas auf dem Kissen "
        +"gelegen haben muss.";
  }
  return BS(s);
}
string strschatulle(string key)
{
  string s;

  s = "Die Schatulle ist mit reinem Gold verziert und sieht sehr wertvoll aus. "; 
  
  if(schatulle == DA)
  {
    s += "Sie ist geschlossen.";  return(BS(s));
  }
  else
  {
    s += "Sie ist geoeffnet. ";
  }
  
  if(edelsteine == DA && perlen == DA)
  {
  	s += "In ihr liegen ein paar Edelsteine und Perlen.";
  }
  else if(perlen == DA && edelsteine == WEG)
  {
    s += "In ihr liegen ein paar Perlen.";
  }
  else if(perlen == WEG && edelsteine == DA)
  {
    s += "In ihr liegen ein paar Edelsteine.";
  }
  else
  {
    s += "Die Schatulle ist leider leer.";
  }
  return(BS(s));
}

// oeffnen
int cmdoeffne(string str)
{
  notify_fail( "Was willst Du oeffnen?\n" );
  if(str == "truhe" )
  {
    if(truhe == DA)
    {
      write("Vorsichtig oeffnest Du die Truhe.\n");
      say(BS(PL->Name()+" oeffnet vorsichtig die Truhe."));
      truhe = WEG;
      return 1;
    }
    else
    {
      write("Die Truhe ist doch schon offen.\n");
      return -1;
    }
  }
  if(str == "schatulle" )
  {
    if(schatulle == DA)
    {
      write("Du oeffnest die Schatulle.\n");
      say(BS(PL->Name()+" oeffnet die Schatulle."));
      schatulle = WEG;
      return 1;
    }
    else
    {
      write("Die Schatulle ist doch schon offen.\n");
      return -1;
    }
  }
  if(str == "kiste" )
  {
      write(BS("Du oeffnest die Kiste und stellst fest, dass sie "
           +"leer ist. Enttaeuscht schliesst Du sie wieder."));
      return 1;
  }
  return 0;
}


int cmdnimm(string str)
{
  object mystab;
  object qitem;
  notify_fail("Was willst Du nehmen?\n");
  if(str == "perlen" || str == "edelsteine")
  {
  	write("Woraus willst Du die "+capitalize(str)+" nehmen?\n");
  	return -1;
  }
  if(str == "zauberstab" || str == "stab")
  {
  	write("Woraus willst Du den Zauberstab nehmen?\n");
  	return -1;
  }
  
  if(str == "edelsteine aus schatulle" )
  {
    if(edelsteine == DA)
    {
      write(BS("Du nimmst die Edelsteine aus der Schatulle."));
      say(BS(PL->Name()+" ein paar Edelsteine aus der Schatulle."));
      // Edelsteine erzeugen und moven
      // 2 + random(2), verschiedene, in den Spieler, kein besonderer Typ
      "obj/gemmaster"->DistributeGem(2, 2,1, TP);
      edelsteine = WEG;
      return 1;
    }
    else
    {
      write(BS("Welche Edelsteine meinst Du denn?"));
      return -1;
    }
  }
  
  if(str == "perlen aus schatulle" )
  {
    if(perlen == DA)
    {
      write(BS("Du nimmst die Perlen aus der Schatulle."));
      say(BS(PL->Name()+" ein paar Perlen aus der Schatulle."));
      // Perlen erzeugen und moven
      // 2 + random(2), verschiedene, in den Spieler, kein besonderer Typ
      "/obj/pearlmaster"->DistributePearl(2, 2, 1, TP);
      perlen = WEG;
      return 1;
    }
    else
    {
      write(BS("Welche Perlen meinst Du denn?"));
      return -1;
    }
  }

  if(str == "zauberstab aus truhe" || str == "stab aus truhe")
  {
  	if(qitem = present( QUESTITEM, TP))
  	{
  	  if(!qitem->QueryFertisch()) // Questproblem? Nicht alles selbst gemacht
  	  {
  	    write(BS("Irgendeine magische Macht verhindert, dass Du den Zauberstab "
  	            +"bekommen kannst! Willst Du etwa jemand anderem den Stab wegnehmen?"));
        write_file(QUESTLOG "quest.log", 
               dtime(time())+": "+CAP(getuid(TP))+" Stab - nicht alle Flags!!!\n" );
  	    return -1;
  	  }
  	  if(stab == DA)
      {
        mystab=clone_object(WEAPON "zstab");
        if(!mystab)
        {
           write(BS("Merkwuerdig, Du musst Dich wohl getaeuscht haben. Am besten "
                   +"ist wohl Du wendest Dich an Torian."));
        }
        if(ME_TOO_HEAVY==mystab->move(TP,M_GET|M_SILENT))
        {
           write(BS("Der Stab ist Dir viel zu schwer! Daher laesst Du ihn in der "
                   +"Truhe liegen."));
           mystab->remove();
        }
        else
        {
           write(BS("Sehr vorsichtig nimmst Du den Stab aus der Truhe heraus."));
           // Questflag setzen
           qitem->SetStab();
           write_file(QUESTLOG "quest.log", 
              dtime(time())+": "+CAP(getuid(TP))+" nimmt den Stab!\n" );
           stab = WEG;
        }
        say(BS(PL->Name()+" hantiert an der Truhe."));
        return 1;
      }
      else // Stab nicht da
      {
        write(BS("Welchen Zauberstab meinst Du denn?"));
        return -1;
      }
    }
    else // kein Questitem
    {
      write(BS("Du versuchst den Zauberstab aus der Truhe zu heben. Leider "
              +"schaffst Du es nicht! Du hast das Gefuehl als wuerde er Tonnen "
              +"wiegen."));
    }
  }

  return 0;
}

int cmdverlasse(string str)
{
  notify_fail( "Wie willst Du den Raum verlassen?\n" );
  return 0;
}


int cmdkrieche(string str)
{
  notify_fail( "Wodurch willst Du kriechen?\n" );
  if(str == "durch durchschlupf")
  {
    write(BS("Du schluepfst durch den Durchschlupf hindurch und gelangst "
            +"so wieder auf die andere Seite."));
    bewegen(this_player());
    return 1;
  }
  return 0;
}

int cmdkletter(string str)
{
  notify_fail( "Wodurch willst Du klettern?\n" );
  if(str == "durch durchschlupf")
  {
    write(BS("Du kletterst durch den Durchschlupf hindurch und gelangst "
            +"so wieder auf die andere Seite."));
    bewegen(this_player());
    return 1;
  }
  return 0;
}

int cmdschluepfe(string str)
{
  notify_fail( "Wodurch willst Du schluepfen?\n" );
  if(str == "durch durchschlupf")
  {
    write(BS("Du kriechst durch den Durchschlupf hindurch und gelangst "
            +"so wieder auf die andere Seite."));
    bewegen(this_player());
    return 1;
  }
  return 0;
}

void bewegen(object player)
{
  object obj;
  // Spieler moven
  call_other(ROOM "schatzraum1", "???", 0);
  obj = find_object(ROOM "schatzraum1");
  if(obj)
  {
    player->move(obj, M_NOCHECK, "","","kriecht herein");
    return;
  }
  else
  {
    write("Fehler! Bitte melde ihn an Torian.\n");
    return;
  }
}

reset()
{
  ::reset();
  
  truhe = kiste = schatulle = stab = edelsteine = perlen = DA;

}
