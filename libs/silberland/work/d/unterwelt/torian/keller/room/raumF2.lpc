#include "../def.h"

inherit "std/room";

#include <properties.h>
#define F1 "./raumF1"
#define E2 "./raumE2"
#define F3 ROOM "raumF3"

void create()
{

  ::create();

  SetProp( P_INT_SHORT, "In einer Hoehle" );
  SetProp( P_INT_LONG, "Fehler!");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));
  AddDetail( ({ "menschenhand", "teil", "hand" }),
    "Je tiefer Du in die Hoehle hineindringst, desto mehr wurde sie in ihrem "
    "natuerlichen, von Menschen unberuehrten Zustand belassen.");
  AddDetail( ({ "suedwesten" }),
    "Im Suedwesten ragt eine riesige Steinsaeule hinauf.");
  AddDetail( ({ "steinsaeule", "saeule" }),
    "Die Steinsaeule hat eine glaenzende, fast spiegelglatte Oberflaeche "
    "und ist in der Mitte rund und schmal, waehrend sie zum Boden und "
    "zur Decke hin breiter und unfoermiger wird.");
  AddDetail( ({ "zustand" }),
    "Die Hoehle wurde hier fast voellig in ihrem natuerlichen Zustand "
    "belassen.");
  AddDetail( ({ "oberflaeche" }),
    "Die Oberflaeche der Saeulen glaenzt tiefschwarz und ist so glatt, "
    "dass Du fast Dein Spiegelbild darin erkennen kannst.");
  AddSpecialDetail( ({ "bild", "spiegelbild" }), "strbild");
  AddDetail( ({ "sekunden" }),
    "1, 2, 3 - und schon wieder ist eine vorbei.");
  AddDetail( ({ "mitte" }),
    "In der Mitte ist die Saeule rund und schmal, waehrend sie zum Boden "
    "und zur Decke hin breiter und unfoermiger wird.");
  AddDetail( ({ "steintreppe", "treppe" }),
    "Um mehr zu erkennen, musst Du schon nach Sueden gehen.");
  AddDetail( ({ "westen" }),
    "Im Westen gelangst Du tiefer in die Hoehle hinein.");
  AddDetail( ({ "gang" }),
    "Ein schmaler Gang fuehrt nach Norden in eine kleinere Hoehle hinein.");
  AddDetail( ({ "menschen" }),
    "Hier unten ist das Eingreifen von Menschen kaum noch zu spueren.");
  AddDetail( ({ "norden" }),
    "Im Norden fuehrt ein schmaler Gang in eine kleinere Hoehle hinein.");
  AddDetail( ({ "eingreifen" }),
    "Viel zu oft greifen die Menschen in die Natur ein.");
  AddDetail( ({ "natur" }),
    "Hier unten ist fast alles noch genau so, wie die Natur es geschaffen "
    "hat.");
  AddDetail( ({ "boden" }),
    "Der Boden besteht auch hier aus schwarzem Vulkangestein. Es liegt "
    "ein wenig Staub auf dem Boden.");
  AddDetail( ({ "staub" }),
    "Du kannst winzige Spuren in der Staubschicht erkennen.");
  AddDetail( ({ "spuren" }),
    "Von wem koennten die nur stammen?");
  AddDetail( ({ "staubschicht" }),
    "Eine duenne Staubschicht liegt auf dem Boden.");
  AddDetail( ({ "vulkangestein" }),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({ "decke" }),
    "Du legst Deinen Kopf in den Nacken und schaust zur Decke hinauf. "
    "Sie ist so hoch, dass Du sie kaum noch erkennen kannst.");
  AddDetail( ({ "nacken" }),
    "Dein Nacken schmerzt bereits vom vielen Hinaufstarren.");
  AddDetail( ({ "hinaufstarren" }),
    "Na, was tust Du denn die ganze Zeit?");
  AddDetail( ({ "zeit" }),
    "Die Zeit rennt.");
  AddDetail( ({ "kopf" }),
    "Bedaechtig wiegst Du Deinen Kopf hin und her.");
  AddDetail( ({ "waende", "wand" }),
    "Suedwestlich von Dir ragt eine riesige Steinsaeule hinauf. Im "
    "Norden fuehrt ein schmaler Gang in eine kleinere Hoehle und nach "
    "Westen hin gelangst Du tiefer in die Hoehle hinein. Im Sueden "
    "befindet sich die Steintreppe, ueber die Du hier hinuntergestiegen "
    "bist.");

  AddSpecialDetail( ({ "sueden"}), "strsueden");
  AddSpecialDetail( ({ "lichtschimmer"}), "strlichtschimmer");
  AddSpecialDetail( ({ "licht"}), "strlicht");

  AddSound( DEFAULT_SOUND,
    "Es ist sehr still hier unten. Ab und zu glaubst Du, etwas zu "
    "hoeren, bist Dir aber nicht wirklich sicher.");
  AddSound( ({ "stille" }),
    "Hier unten ist es wirklich sehr still.");
  AddSound( ({ "etwas" }),
    "War da nicht gerade etwas? Oder hast Du Dich doch getaeuscht?");

  AddSmell( DEFAULT_SMELL,
    "Die Luft riecht ein wenig abgestanden.");
  AddSmell( ({ "luft" }),
    "Es war wohl schon lange niemand mehr hier unten.");
  AddCmd( ({ "wische", "wisch" }), "cmdwische" );
  AddItem(NPC "hoehlenspinne", REFRESH_DESTRUCT);

  AddExit( "norden", F1 );
  AddExit( "westen", E2 );
  AddExit( "sueden", F3 );
}
// Fackeln an der Treppe an ? -> Lichtschimmer zu sehen, nicht genug ums Hell 
// zu machen, Details Lichtschimmer Sueden und Licht ebenfalls entsprechend
string _query_int_long()
{
  string s;
  object obj;
  call_other(F3, "???", 0);
  obj = find_object(F3);
  if(obj)
  {
    if(obj->QueryFackel())
       s = "Im Sueden siehst Du einen schwachen Lichtschimmer; dort muss die "
    	  +"Treppe sein, ueber die Du hier heruntergestiegen bist.";
    else
      s = "Im Sueden scheint sich die Treppe zu befinden, ueber die Du hier "
         +"heruntergestiegen bist.";
    
     s = "Die Hoehle wird breiter und weitlaeufiger, je weiter Du in den "
         +"weniger durch Menschenhand bearbeiteten Teil hineingelangst. "
         +"Suedwestlich von Dir ragt eine riesige Steinsaeule hinauf. "
   	 +s+" Im Westen gelangst Du tiefer in die Hoehle hinein, waehrend der "
     	 +"Gang nach Norden hin etwas schmaler wird.";
  }
  else 
// Kein Sueden ... unangenehm :)
  { 
    s = "Fehler! Bitte melde ihn an Torian."; 
  }
  return BS(s);
}
string strsueden(string str)
{
  string s, s2;
  object obj;

  s = "Aus dem Sueden dringt ein schwacher Lichtschimmer hierher. Dort "
     +"befindet sich wohl die Steintreppe, ueber die Du in diese Hoehle "
     +"hineingelangt bist.";
  s2 = "Im Sueden scheint sich die Steintreppe zu befinden, ueber die Du in "
      +"Hoehle hineingelangt bist.";
  call_other(F3, "???", 0);
  obj = find_object(F3);
  if(obj)
  {
    if (obj->QueryFackel()) { return BS(s); }
    else {return BS(s2);}
  }
  else { return "Fehler! Bitte melde ihn an Torian.\n"; }
}
string strlichtschimmer(string str)
{
  string s, s2;
  object obj;
  s = "Der Schimmer reicht nicht aus, um viel Licht zu spenden. Aber Du "
     +"glaubst, die Steintreppe, die sich im Sueden befinden muss, "
     +"erkennen zu koennen.";
  s2 = "Sowas siehst du nicht.\n";
  call_other(F3, "???", 0);
  obj = find_object(F3);
  if(obj)
  {
    if (obj->QueryFackel()) { return BS(s); }
    else {return s2;}
  }
  else { return "Fehler! Bitte melde ihn an Torian.\n"; }
}
string strlicht(string str)
{
  string s, s2;
  object obj;
  s = "Es dringt nur sehr wenig Licht bis hierher, das nicht stark genug "
     +"ist, um diese Hoehle ausreichend zu erhellen.";
  s2 = "Sowas siehst du nicht.\n";
  call_other(F3, "???", 0);
  obj = find_object(F3);
  if(obj)
  {
    if (obj->QueryFackel()) { return BS(s); }
    else {return s2;}
  }
  else { return "Fehler! Bitte melde ihn an Torian.\n"; }
}
cmdwische(string str )
{
  notify_fail( "Was willst Du wegwischen?\n" );
  if(-1 == member(({"staub","staubschicht","staub weg","staubschicht weg"}),str))
  { return 0; }
  write(BS("Du wirbelst etwas Staub auf, der sich jedoch gleich wieder legt."));
  say( BS(PL->name()+" wirbelt etwas Staub auf, der sich jedoch gleich wieder "
                    +"legt."));
  return 1;
}
string strbild(string key)
{
  string s;
  s="Du starrst einige Sekunden lang vertraeumt auf Dein Spiegelbild "
   +"in der Saeule.";
  say( BS(PL->name()+" starrt vertraeumt auf die Saeule."));
  return BS(s);
}
