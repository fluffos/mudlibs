inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine ausgewachsene Hoehlenechse");
  SetProp(P_LONG,
    "Eine grosse, ausgewachsene Hoehlenechse laeuft unruhig vor dem Nest "
    "hin und her. Mit ihren kurzen, aber kraeftigen Beinen sieht sie "
    "etwas unbeholfen und schwerfaellig aus, doch dieser Eindruck "
    "taeuscht sicherlich. Auf dem langgestreckten, mit Schuppen "
    "bedeckten Ruecken sitzt ein Hornkamm, den sie drohend aufstellt, "
    "wenn sie Gefahr wittert.");

  SetProp(P_NAME, "Hoehlenechse");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"hoehlenechse", "echse", "SCHUPPEN_WUSCHEL", "\nmamaechse"}));
  SetProp(P_NAME_ADJ, "ausgewachsen");
  AddAdjective( ({ "ausgewachsen", "ausgewachsene", "ausgewachsenen" }) );

  AddClass(CL_ANIMAL);

  create_default_npc(25); // 25 ist vielleicht zuviel -> testen
  SetProp(P_HANDS, ({" mit ihren Krallen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 100);
  SetProp(P_WEIGHT, 80000);
  SetProp(P_ALIGN, 150);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "kriecht herein");
  SetProp(P_MMSGOUT, "kriecht");

  SetProp(P_DIE_MSG,  " bricht zischelnd zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
//  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Eine Echse");
  SetProp(P_KILL_MSG, ({MSG_EMOTE, "zischt triumphierend!"}));

  AddDetail("beine",
    "Die Hoehlenechse hat kurze, aber kraeftige Beine, auf denen sie "
    "unruhig vor dem Nest hin und her laeuft.");
  AddDetail("eindruck",
    "Der Eindruck taeuscht sicherlich.");
  AddDetail("schuppen",
    "Unzaehlige harte, kleine Schuppen bedecken den gesamten Koerper der "
    "Hoehlenechse.");
  AddDetail("koerper",
    "Der gesamte Koerper der Echse ist mit harten, kleinen Schuppen "
    "bedeckt.");
  AddDetail("gefahr",
    "Wenn die Echse Gefahr wittert, stellt sie ihren Hornkamm drohend "
    "auf.");
  AddDetail("hornkamm",
    "Der Hornkamm auf ihrem Ruecken ist drohend aufgestellt.");
  AddDetail("ruecken",
    "Auf dem langgestreckten Ruecken der Echse sitzt ein harter "
    "Hornkamm, den sie bei Gefahr drohend aufstellt.");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("torian", "Mein Meissssterrr.","zischt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Hoehlenechse will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(4,800,
    "Die ausgewachsene Hoehlenechse peitscht Dich mit ihrem Schwanz.\n",
    "Die ausgewachsene Hoehlenechse peitscht @WEN mit ihrem Schwanz.\n",
     DT_WHIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(6,600,
    "Die ausgewachsene Hoehlenechse zerkratzt Dich mit ihren harten Krallen.\n",
    "Die ausgewachsene Hoehlenechse zerkratzt @WEN mit ihren harten Krallen.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(4, ({
    "Die ausgewachsene Hoehlenechse laeuft unruhig hin und her.\n",
    "Die ausgewachsene Hoehlenechse stellt sich schuetzend vor das Nest.\n",
    "Die ausgewachsene Hoehlenechse stellt ihren Hornkamm drohend auf.\n"}) );
  SetAttackChats(10, ({
    "Die ausgewachsene Hoehlenechse zischt wuetend.\n",
    "Die ausgewachsene Hoehlenechse stellt ihren Hornkamm wuetend auf.\n"}) );

  SUID;

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt die Mamaechse.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Die Mamaechse hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "zischt veraergert und greift Dich an.",
        "zischt veraergert und greift "+TP->name(WEN)+" an.");
      Kill(TP);
      break;
    default :
      call_out("reaction", 0, TP,
        "zischt leise.",
        "zischt leise.");
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void init()
{
  ::init();
  if(TP && TP->id("\nbabyechse")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}