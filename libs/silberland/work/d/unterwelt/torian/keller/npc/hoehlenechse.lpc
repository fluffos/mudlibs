inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Hoehlenechse");
  SetProp(P_LONG,
    "Dies ist eine grosse Hoehlenechse, die die Gaenge auf Nahrungssuche "
    "durchstreift. Ihre flinken Bewegungen lassen erahnen, dass ihr "
    "schwerfaelliges Aussehen nur taeuscht. Auf dem langgestreckten, mit "
    "Schuppen bedeckten Ruecken sitzt ein Hornkamm, den sie drohend "
    "aufstellt, wenn sie Gefahr wittert.");

  SetProp(P_NAME, "Hoehlenechse");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"hoehlenechse", "echse", "SCHUPPEN_WUSCHEL"}));

  create_default_npc(16+random(5)); 
  SetProp(P_HANDS, ({" mit ihren Krallen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 80+random(20));
  SetProp(P_WEIGHT, 50000+random(20000));
  SetProp(P_ALIGN,-100+random(200));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "kriecht herein");
  SetProp(P_MMSGOUT, "kriecht");
  SetProp(P_MNPC_AREA, ({ ROOM "raum" }) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "raumC1");
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS );
  SetProp(P_DIE_MSG,  " bricht zischelnd zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Eine Echse");
  SetProp(P_KILL_MSG, ({MSG_EMOTE, "zischt triumphierend!"}));

  AddDetail("nahrungssuche",
    "Bist Du dir sicher das Du nicht auf ihrem Speisezettel stehst?");
  AddDetail("speisezettel",
    "Du koenntest definitiv, unter Umstaenden, vielleicht aber auch "
    "nur auf ihrem Speisezettel stehen.");
  AddDetail("bewegungen",
    "Die Hoehlenechse ist flinker als sie aussieht.");
  AddDetail("aussehen",
    "Ihr gedrungener, mit kleinen Schuppen uebersaehter Koerper laesst "
    "die Hoehlenechse sehr schwerfaellig Aussehen.");
  AddDetail("schuppen",
    "Unzaehlige harte, kleine Schuppen bedecken den gesamten Koerper der "
    "Hoehlenechse.");
  AddDetail("koerper",
    "Der gesamte Koerper der Echse ist mit harten, kleinen Schuppen "
    "bedeckt.");
  AddDetail("gefahr",
    "Wenn die Echse Gefahr wittert, stellt sie ihren Hornkamm drohend "
    "auf.");
  AddDetail("hornkamm",
    "Der Hornkamm auf ihrem Ruecken ist drohend aufgestellt.");
  AddDetail("ruecken",
    "Auf dem langgestreckten Ruecken der Echse sitzt ein harter "
    "Hornkamm, den sie bei Gefahr drohend aufstellt.");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Hoehlenechse will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(4,700,
    "Die Hoehlenechse peitscht Dich mit ihrem Schwanz.\n",
    "Die Hoehlenechse peitscht @WEN mit ihrem Schwanz.\n",
     DT_WHIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(6,500,
    "Die Hoehlenechse zerkratzt Dich mit ihren harten Krallen.\n",
    "Die Hoehlenechse zerkratzt @WEN mit ihren harten Krallen.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(5, ({
    "Die Hoehlenechse laeuft unruhig hin und her.\n",
    "Die Hoehlenechse mustert Dich hungrig.\n",
    "Die Hoehlenechse stellt ihren Hornkamm drohend auf.\n"}) );
  SetAttackChats(10, ({
    "Die Hoehlenechse zischt wuetend.\n",
    "Die Hoehlenechse stellt ihren Hornkamm wuetend auf.\n"}) );

  SUID;

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt die Hoehlenechse.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Eine Hoehlenechse hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "zischt veraergert und greift Dich an.",
        "zischt veraergert und greift "+TP->name(WEN)+" an.");
      Kill(TP);
      break;
    default :
      call_out("reaction", 0, TP,
        "zischt leise.",
        "zischt leise.");
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
