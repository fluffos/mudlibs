inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Terraspinne");
  SetProp(P_LONG,
    "Du siehst eine besonders prachtvolles Exemplar einer schwarzen "
    "Terraspinne vor Dir. Sie hat einen sehr robusten Koerperbau und ihr "
    "gesamter Leib ist mit dicken, schwarzen Haaren bedeckt. Sie bewegt "
    "sich keinen Zentimeter von der Stelle, sondern starrt Dich nur "
    "regungslos aus gefaehrlich glitzernden roten Augen an.");

  SetProp(P_NAME, "Terraspinne");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"terraspinne", "spinne", "ungetuem"}));

  AddClass(CL_ANIMAL);

  create_default_npc(27);
  SetProp(P_HANDS, ({" mit ihren Beinen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 100+random(50));
  SetProp(P_WEIGHT, 60000+random(15000));
  SetProp(P_ALIGN, -100+random(200));
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE: 0.2]) );
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_DIE_MSG,  " bricht zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
//  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Ein Terraspinne");
  SetProp(P_KILL_MSG, ({MSG_EMOTE, "macht sich ueber den toten Koerper her."}));

  AddDetail("exemplar",
    "Ein wirklich prachtvolles Exemplar.");
  AddDetail("ungetuem",
    "Diese Spinne kann man wirklich als Ungetuem bezeichnen mit ihren "
    "funkelnden roten Augen und ihrem komplett beharrten Koerper. Du "
    "spuerst, wie sie nur auf eine einzige unachtsame Bewegung von Dir "
    "lauert.");
  AddDetail(({"koerperbau", "koerper", "leib" }),
    "Die Terraspinne hat einen dicken, robusten Koerper, der ueber und ueber mit "
    "kurzen schwarzen Haaren bedeckt ist. Mit ihren acht langen, dicht "
    "beharrten Beinen findet sie sicher ueberall einen guten Halt.");
  AddDetail("haare",
    "Der gesamte Koerper der Spinne ist mit dicken, schwarzen Haaren "
    "bedeckt.");
  AddDetail("beine",
    "Unzaehlige dicke schwarze Haare wachsen aus ihren acht Beinen "
    "heraus.");
  AddDetail("halt",
    "Mit ihren langen, beharrten Beinen findet die Spinne ueberall einen "
    "guten Halt.");
  AddDetail("augen",
    "Mit gierig glitzernden roten Augen beobachtet die Spinne regungslos "
    "jede noch so kleine Bewegung von Dir.");
  AddDetail("bewegung",
    "Bleib lieber ganz still dort stehen, wo Du bist!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Kaut lustlos auf @WEN herum und laesst es wieder fallen.\n" }) );

  SetProp(P_SPELLRATE,60);
  AddSpell(3,750,
    "Die Terraspinne beisst Dich mit ihren kraeftigen Kieferzangen!\n",
    "Die Terraspinne beisst @WEN mit ihren kraeftigen Kieferzangen!\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(5,500,
    "Die Terraspinne laesst sich auf Dich fallen!\n",
    "Die Terraspinne laesst sich auf @WEN fallen!\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  AddSpell(6,1,
    "Die Terraspinne schleudert ein paar Haare nach Dir!\n",
    "Die Terraspinne schleudert ein paar Haare nach @WEN!\n",
    DT_BLUDGEON, "hairy");

  SetChats(2, ({
    "Du fuehlst Dich beobachtet.\n",
    "Du spuerst, wie jede Deine Bewegungen von unsichtbaren "
    "Augen verfolgt wird.\n"}) );
  SetAttackChats(10, ({
    "Die Terraspinne wirft Dir einen moerderischen Blick zu.\n"}) );

  SUID;

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt die Terraspinne.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Die Terraspinne hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  
  	  call_out("reaction", 0, TP,
        "laesst sich in Deinen Nacken fallen!!!",
        "laesst sich in "+TP->name(WEN)+" Nacken fallen!!!");
      Kill(TP);

}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void hairy(object enemy,int damage,string damtype)
{
  object myhaare;
  myhaare = present("\nHAARE", enemy);

  if(!myhaare)
  {
    clone_object(OBJ "haare")->move(enemy,M_GIVE|M_NOCHECK);
    return;  
  }

  return;

}
