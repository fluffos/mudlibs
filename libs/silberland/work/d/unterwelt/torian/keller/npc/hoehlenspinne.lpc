inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>

#include "../def.h"

#define E2 ROOM "raumE2"
#define F3 ROOM "raumF3"
#define F2 ROOM "raumF2"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Hoehlenspinne");
  SetProp(P_LONG,
    "Diese Hoehlenspinne ist ein recht grosses Exemplar ihrer Rasse. Sie "
    "ist etwas ueber einen Meter gross. Ihr Koerper ist mit einem dicken "
    "Chitinpanzer bedeckt, aus dem acht lange, haarige Beine herausschauen. "
    "Sie hat sechs Augen, die in einem engen Kreis angeordnet sind.");

  SetProp(P_NAME, "Hoehlenspinne");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"hoehlenspinne", "spinne"}));

  AddClass(CL_ANIMAL);

  create_default_npc(16+random(5));
  SetProp(P_HANDS, ({" mit ihren Beinen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 100+random(50));
  SetProp(P_WEIGHT, 60000+random(15000));
  SetProp(P_ALIGN, -100+random(200));
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE: 0.2]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MNPC_AREA, ({ ROOM "raum" }));
  SetProp(P_MNPC_WAIT, ({ 10, 10, 10 }) );
  SetProp(P_MNPC_DEFAULTROOM, F2 );
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS  );
  SetProp(P_MSGIN, "krabbelt flink herein");
  SetProp(P_MSGOUT, "krabbelt flink");
  SetProp(P_MMSGIN, "krabbelt flink herein");
  SetProp(P_MMSGOUT, "krabbelt flink");

  SetProp(P_DIE_MSG,  " bricht zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Hoehlenspinne");
  SetProp(P_KILL_MSG, ({MSG_EMOTE, "funkelt belustigt mit ihren Augen."}));

  AddDetail("exemplar",
    "Sie ist ein besonders grosses Exemplar.");
  AddDetail("rasse",
    "Diese Spinne gehoert der Rasse der Hoehlenspinnen an.");
  AddDetail("meter",
    "Diese Spinne ist etwas ueber einen Meter gross.");
  AddDetail("koerper",
    "Der Koerper der Hoehlenspinne ist mit einem dicken Chitinpanzer "
    "bedeckt, der ihr einen guten Schutz bietet.");
  AddDetail(({ "chitinpanzer", "panzer" }),
    "Der Chitinpanzer bietet einen guten Schutz.");
  AddDetail("schutz",
    "Dieser Panzer bietet einen besonders guten Schutz gegen Feuer.");
  AddDetail("feuer",
    "Vor Feuer schuetzt der Chitinpanzer besonders gut.");
  AddDetail("beine",
    "Mit ihren acht langen, haarigen Beinen krabbelt die Hoehlenspinne "
    "flink umher.");
  AddDetail("augen",
    "Die Hoehlenspinne hat sechs Augen, die in einem engen Kreis "
    "angeordnet sind.");
  AddDetail("kreis",
    "Die Augen der Spinne sind in einem engen Kreis angeordnet.");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Kaut lustlos auf @WEN herum und laesst es wieder fallen.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(4,750,
    "Die Hoehlenspinne beisst Dich mit ihren kraeftigen Kieferzangen.\n",
    "Die Hoehlenspinne beisst @WEN mit ihren kraeftigen Kieferzangen.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(6,500,
    "Die Hoehlenspinne peitscht Dich mit ihrem gesponnenen Faden.\n",
    "Die Hoehlenspinne peitscht @WEN mit ihrem gesponnenen Faden.\n",
     DT_WHIP,([SP_SHOW_DAMAGE:1]));

  SetChats(10, ({
    "Die Hoehlenspinne krabbelt flink hin und her.\n",
    "Die Hoehlenspinne spinnt einen langen Faden.\n",
    "Die Hoehlenspinne sucht ein Opfer.\n",
    "Die Hoehlenspinne bewegt ihre sechs Augen wachsam in Deine Richtung.\n",
    "Die Hoehlenspinne wickelt einen Faden auf.\n"}) );
  SetAttackChats(10, ({
    "Die Hoehlenspinne wickelt Dich in einen langen Faden ein.\n",
    "Die Hoehlenspinne starrt Dich hypnotisierend aus ihren sechs Augen an.\n",
    "Die Hoehlenspinne krabbelt wuetend hin und her.\n"}) );

  SUID;

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt die Hoehlenspinne.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Eine Hoehlenspinne hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "funkelt veraergert und greift Dich an.",
        "funkelt veraergert und greift "+TP->name(WEN)+" an.");
      Kill(TP);
      break;
    default :
      call_out("reaction", 0, TP,
        "starrt Dich an.",
        "starrt Dich an.");
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
