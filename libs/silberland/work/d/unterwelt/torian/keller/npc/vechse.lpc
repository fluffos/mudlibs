inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

#define ME this_object()

string mama = "test";
string ChatFunc();

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine winzige Babyhoehlenechse");
  SetProp(P_LONG,
    "Eine winzige Hoehlenechse wuselt auf dem Boden herum. Sie ist "
    "gerade so lang wie Deine ausgestreckte Hand und etwa zwei Finger "
    "breit. Sie scheint "+mama+" als ihre Mama anzusehen und weicht nicht"
    "von "+mama+"s Seite. Neugierig sieht sie Dich aus ihren winzigen "
    "Aeuglein an.");

  SetProp(P_NAME, "Babyhoehlenechse");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"hoehlenechse", "echse","babyhoehlenechse", "babyechse", "SCHUPPEN_WUSCHEL"}));
  SetProp(P_NAME_ADJ, "winzig");

  AddClass(CL_ANIMAL);

  create_default_npc(5); 
  SetProp(P_HANDS, ({" mit ihren Krallen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 10);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_ALIGN, 350);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_FRIEND,1);

  SetProp(P_MSGIN, "tapst herein");
  SetProp(P_MSGOUT, "folgt ihrer Mama");
  SetProp(P_MMSGIN, "tapst herein");
  SetProp(P_MMSGOUT, "folgt ihrer Mama");

  SetProp(P_DIE_MSG,  " bricht zischelnd zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Eine Echse");
  SetProp(P_KILL_MSG, ({MSG_EMOTE, "zischt triumphierend!"}));

  AddCmd( ({ "spiel", "spiele" }), "cmdspielen" );
  
  AddDetail("aeuglein",
    "Neugierig sieht sie Dich aus ihren Aeuglein an.");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" ist viel zu klein, um Deine Sachen zu tragen.\n" }) );
  
  SetChats(5, ({ "@@ChatFunc@@" }) );
    
  SetAttackChats(10, ({
    Name(WER)+" verkriecht sich aengstlich.\n"}) );

  SUID;

}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if (capitalize(getuid(player)) == mama)
  {
  	tell_room(environment(TO), BS("Die winzige Hoehlenechse weint fuerchterlich und "
                               +"rennt weg."));
    remove();
  }
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "zischt veraergert und verkriecht sich vor Dir.",
        "zischt veraergert und verkriecht sich vor "+TP->name(WEN)+".");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "wirft Dir einen veraechtlichen Blick zu.",
        "wirft "+TP->Name()+" einen veraechtlichen Blick zu.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "klettert auf Deinen Fuss und schaut Dich lieb an.",
        "klettert auf "+TP->Name(WESSEN)+" Fuss und schaut "
       +(PL->QueryProp(P_GENDER) == MALE ? "ihn":"sie")+" lieb an.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "schaut Dich unschluessig an.",
        "schaut "+TP->Name()+" unschluessig an.");
      break;
    case "nett":
    case "albern":
      call_out("reaction", 0, TP,
        "tapst um Dich herum.",
        "tapst um "+TP->Name()+" herum.");
      break;
    case "aengstlich":
      call_out("reaction", 0, TP,
        "schaut Dich neugierig an.",
        "schaut "+TP->Name()+" neugierig an.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "kuschelt sich an Dich an.",
        "kuschelt sich an "+TP->Name()+" an.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "schaut Dich froehlich an.",
        "schaut "+TP->Name()+" froehlich an.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


void init()
{
  ::init();
  if(TP && interactive(TP) && TP->QueryProp(P_GHOST)) TP->RemovePursuer(TO);
}

void SetMama(string str)
{
	mama = str;
	SetProp(P_MSGOUT, "folgt "+mama);
	SetProp(P_MMSGOUT, "folgt "+mama);
}
//debug zwecke
string QueryMama()
{
	return mama;
}
_query_long()
{
  return BS("Eine winzige Hoehlenechse wuselt auf dem Boden herum. Sie ist "
        +"gerade so lang wie Deine ausgestreckte Hand und etwa zwei Finger "
        +"breit. Sie scheint "+mama+" als ihre Mama anzusehen und weicht nicht "
        +"von "+mama+"s Seite. Neugierig sieht sie Dich aus ihren winzigen "
        +"Aeuglein an.");
}
string ChatFunc()
{
	object player;
	player = find_living(lower_case(mama));
	if(!player) return "";
	if (find_call_out("reaction") == -1)
	{
      switch(1+random(5))
      {
        case 1:
          call_out("reaction", 0, player,
          "tapst um Dich herum.\n",
          "tapst um "+player->name(WEN)+" herum.\n");
          break;
        case 2:
          call_out("reaction", 0, player,
          "kuschelt sich an Dich an.\n",
          "kuschelt sich an "+player->name(WEN)+" an.\n");
          break;
        case 3:
          call_out("reaction", 0, player,
          "will mit Dir spielen.\n",
          "will mit Dir spielen.\n");
          break;
        case 4:
          call_out("reaction", 0, player,
          "schaut Dich mit ihren winzigen Aeuglein neugierig an.\n",
          "schaut "+player->name(WEN)+" mit ihren winzigen Aeuglein neugierig an.\n");
          break;
        default:
          call_out("reaction", 0, player,
          "klettert auf Deinen Fuss.\n",
          "klettert auf "+player->name(WESSEN)+" Fuss.\n");
        break;
      }
    }
    return "";
}
// kommt noch mehr text beim spielen ...
int cmdspielen(string str)
{
  int s;
  string wer;

  notify_fail("Mit wem oder was willst Du spielen?\n");

  if(!str || str == "") return 0;
  sscanf(str,"mit %s",wer);
  if(!(TO->id(wer))) return 0;
  tell_object(TP,BS("Du hockst Dich vor die winzige Babyechse und haeltst "
   +"ihr spielerisch Deinen kleinen Finger hin. Zuerst starrt sie Dich eine "
   +"Weile lang voellig verdutzt an, doch dann laesst sie sich auf den Ruecken "
   +"fallen und strampelt mit ihren kleinen Fuesschen wild in der Luft herum. "
   +"Anschliessend springt sie blitzschnell wieder auf und saust froehlich "
   +"ein paarmal um Dich herum."));
  tell_room(environment(TO),BS(TP->Name()+" hockt sich vor die winzige Babyechse "
      +"und spielt vergnuegt mit ihr."), ({TP}));
  return 1;
}