inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine winzige Hoehlenechse");
  SetProp(P_LONG,
    "Eine winzige Hoehlenechse wuselt auf dem Boden herum. Sie ist "
    "gerade so lang wie Deine ausgestreckte Hand und etwa drei Finger "
    "breit. Neugierig sieht sie Dich aus ihren winzigen Aeuglein an.");

  SetProp(P_NAME, "Hoehlenechse");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"hoehlenechse", "echse", "SCHUPPEN_WUSCHEL","\nbabyechse"}));
  SetProp(P_NAME_ADJ, "winzig");
  AddAdjective( ({ "winzig", "winzige", "winzigen" }) );
  AddClass(CL_ANIMAL);

  create_default_npc(5); 
  SetProp(P_HANDS, ({" mit ihren Krallen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 15);
  SetProp(P_WEIGHT, 10000);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "kriecht herein");
  SetProp(P_MMSGOUT, "kriecht");

  SetProp(P_DIE_MSG,  " bricht zischelnd zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
//  SetProp(P_MURDER_MSG, "Ich komme wieder!");
  SetProp(P_KILL_NAME, "Eine Echse");
  SetProp(P_KILL_MSG, ({MSG_EMOTE, "zischt triumphierend!"}));

  AddDetail("aeuglein",
    "Neugierig sieht sie Dich aus ihren Aeuglein an.");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("torian", "Mein Meissssterrr.","zischt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die winzige Hoehlenechse will Deine Sachen nicht tragen.\n" }) );

  SetChats(2, ({
    "Die winzige Hoehlenechse wuselt um Dich herum.\n",
    "Die winzige Hoehlenechse will mit Dir spielen.\n",
    "Die winzige Hoehlenechse klettert auf Deinen Fuss.\n"}) );
  SetAttackChats(10, ({
    "Die winzige Hoehlenechse verkriecht sich aengstlich.\n"}) );

  SUID;

}

//void die(int poisondeath) {
//  write_file(LOG "npc.kills",
//    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt die Mamaechse.\n");
//  ::die(poisondeath);
//}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Die winzige H-echse hat "+CAP(getuid(player))+" umgebracht.\n");
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "zischt veraergert und verkriecht sich vor Dir.",
        "zischt veraergert und verkriecht sich vor "+TP->name(WEN));
      break;
    default :
      call_out("reaction", 0, TP,
        "zischt leise.",
        "zischt leise.");
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}


void init()
{
  ::init();
  if(TP && TP->id("\nmamaechse")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}