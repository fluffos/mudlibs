
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include "../def.h"

int riss;
string owner;

create() {
  if (!is_clone(TO)) return;
  ::create();

  riss = WEG;
  owner       = "";

  SetProp( P_SHORT,"Ein Zauberstab");
  SetProp( P_LONG,
    "Bei diesem Stab scheint es sich um einen echten Zauberstab zu "
    "handeln. An seiner Spitze ist ein grosser roter Rubin befestigt, "
    "der aber seltsamerweise kein rotes, sondern ein sonderbar "
    "schimmerndes blaues Licht ausstrahlt.");

  SetProp( P_NAME, "Zauberstab");
  AddId( ({"zauberstab", "stab", QUESTSTAB,"QUESTOBJ"}));
  SetProp( P_INFO, "Dieser Zauberstab gehoerte einst Mabruk.");
  SetProp( P_GENDER, MALE);
  SetProp( P_WC, 100);        
  SetProp( P_WC_FIX, 35);
  SetProp( P_WEIGHT, 500);
  SetProp( P_VALUE, 0);
  SetProp( P_WEAPON_TYPE, WT_CLUB);
  SetProp( P_NR_HANDS, 1);
  SetProp( P_MATERIAL, ([MAT_RUBY:20, MAT_MISC_WOOD:80]) );
  SetProp( P_DAM_TYPE,  DT_BLUDGEON );

  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_NODROP,"Den Zauberstab gibst Du nicht aus der Hand.\n");
  SetProp(P_NOSELL,1);

  AddDetail( ({"spitze"}),
    "An der Spitze des Zauberstabes ist ein grosser roter Rubin befestigt.");
  AddSpecialDetail( ({"rubin"}), "strrubin");
  AddSpecialDetail( ({"riss"}), "strriss");
  AddSpecialDetail( ({"stelle"}), "strriss");
  AddDetail( ({"macht"}),
    "Eine sehr grosse Macht geht von diesem Zauberstab aus.");
  AddDetail( ({"blau"}),
    "Das blaue Schimmern scheint magisch zu sein.");
  AddDetail( ({"licht", "schimmern"}),
    "Ein schimmerndes blaues Licht geht von dem Rubin aus.");
}

string strrubin(string key)
{
  string s;
  if(riss == WEG)
  {
    s = "Der rote Rubin schimmert in einem intensiven magischen Blau. Er scheint "
       +"die gesamte Macht, die in dem Zauberstab steckt, zu buendeln.";
  }
  else
  {
    s = "Der rote Rubin schimmert in einem intensiven magischen Blau. Er scheint "
       +"die gesamte Macht, die in dem Zauberstab steckt, zu buendeln. An einer "
       +"Stelle hat er einen winzigen Riss.";
  }
  return BS(s);
}
string strriss(string key)
{
  string s;
  if(riss == WEG) { s = "";}
  else { s = "Dadurch, dass Du den Zauberstab fallengelassen hast, ist ein "
            +"winziger Riss in dem Rubin entstanden. Du kannst nur hoffen, "
            +"dass Mabruk nichts davon bemerken wird. "; }
  return BS(s);
}
string strstelle(string key)
{
  string s;
  if(riss == WEG) { s = "";}
  else { s = "An einer Stelle siehst Du einen winzigen Riss in dem Rubin."; }
  return BS(s);
}

void SetRiss()
{
  riss = DA;
}

int QueryRiss()
{
  return riss;
}

void init()
{
  object player;

  ::init();

  if(!(player = ENV(TO)))  return;
  if(!interactive(player)) return;

  if(owner == "")
  {
    owner = getuuid(player);
    write_file(QUESTLOG "quest.log", 
      dtime(time())+": Zauberstab Cloner: "+QueryProp(P_CLONER)+"\n" );
  }
}

string QueryOwner()
{
  return owner;
}

varargs int move(mixed dest,int method)
{
  if(objectp(dest))
  {
    if(dest->id("mabruk")) method = method | M_NOCHECK;
  }

  return ::move(dest, method);
}
