inherit "/p/armour/armour_inh";

#include <combat.h>
#include <properties.h>
#include "../def.h"

object traeger;

void create()
{
  
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Spinnenring");
  SetProp(P_LONG, 
    "Ein wunderschoener Ring aus weissem Elfenbein. Auf ihm befindet sich das "
    "Abbild einer schwarzen Spinne.");
  SetProp(P_NAME, "Spinnenring");
  SetProp(P_GENDER, MALE);
  AddId( ({"ring", "spinnenring"}) );

  SetProp(P_INFO, ("Dieser Ring wurde von Lloth gesegnet, doch wehe dem der sich "
                  +"gegen Ihre Kinder vergeht!\n"));
 
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 2+random(2));
  SetProp(P_MATERIAL, ([MAT_IVORY:100 ]));
  SetProp(P_WEIGHT, 20+random(10));
  SetProp(P_VALUE, 400+random(150));
  SetProp(P_QUALITY_DECAY, 300);
  SetProp(P_DEFEND_FUNC, this_object());
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL: 25]));
  SetProp(P_MAGIC, 1);
  
  AddDetail( ({ "elfenbein" }),
    "Wunderschoenes weisses Elfenbein");
  AddDetail( ({ "abbild" }),
    "Ein genaues Abbild einer Spinne befindet sich auf dem Ring.");
  AddDetail( ({ "spinne", "lloth" }),
    "Dieser Ring scheint von Lloth gesegnet zu sein.");
}

int WearFunc()
{
  traeger=TP; // besser als jedesmal environment(this_object()) aufzurufen ...
  return 1;
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
  int prot;

  prot = 0;

  if(random(7)) return prot; // Wahrscheinlichkeit senken

  if (member(dtyp, DT_HOLY) >= 0)   /* Heilig unter den Schadenstypen */
  {
    tell_object(traeger, "Dein Spinnenring leuchtet dunkel auf!\n");
    prot = 10 + random(5);
  }

  /* Ein von Lloth gesegneter Ring wirkt nicht gegen Dunkelelfen ... */
  if (enemy->QueryProp(P_RACE) == "Dunkelelf" ||
      enemy->id("spinne") || enemy->id("drider"))
  {
    
    if(TO->QueryProp(P_CURSED) == 0)
    {
      tell_object(traeger, "\n\nDu greifst ein Wesen Lloths an!! Verflucht seist Du!\n\n");
      TO->SetProp(P_CURSED, 1);
    }
    
    tell_object(traeger, "Dein Spinnenring leuchtet hell auf!\n");
    prot -= 10 - random(5);
  
  }

  return prot;
}