
inherit "std/thing";

#include <properties.h>
#include "../def.h"

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp( P_SHORT,"Schleim");
  SetProp( P_LONG,
   "Schleim.");

  SetProp( P_NAME, "Schleim");
  AddId( ({"schleim"}));
  SetProp( P_GENDER, MALE);
  SetProp( P_WEIGHT, 0);
  SetProp( P_VALUE, 0);
  //kann eh nur bei Magiern vorkommen ...
  SetProp( P_NODROP, "Versuch den Schleim lieber zu entfernen!");
  // kein Pluendern
  SetProp( P_NEVERDROP, 1);
  SetProp( P_MATERIAL, ([ MAT_SLIME:70, MAT_MISC_ACID:30]) );
  SetProp(P_KILL_NAME, "Aetzender Schleim" );
  AddCmd("", "nix",1);

}

int nix(string str) 
{
  string p;
  // Spieler koennen noch entfernen oder reden ...
  
  p = query_verb();
    
  if (p == "ruf" || p == "rufe" || p == "schrei" || p == "schreie"
    || p == "sag" || p == "sage" || p == "rede" || p == "red")
  return 0;
    
  if (p == "entferne" || p == "entfern" )
  {
    tell_object(TP, BS("Muehselig entfernst Du den Schleim aus Deinem Gesicht "
               +"und kannst endlich wieder klar sehen. Erleichtert atmest Du "
               +"auf, als das Brennen in Deinen Augen langsam nachlaesst."));
    tell_room(environment(TP), BS(TP->Name()+" entfernt den Schleim aus "
    +(TP->QueryProp(P_GENDER) == MALE ? "seinem" : "ihrem")+" Gesicht und atmet "
    +"erleichtert auf."), ({ TP }) );
    TO->remove();
    return 1;
  }
  else
  {
    //... Magier koennen alles
  	if (IS_LEARNER(TP)) return 0;
    
    tell_object(TP, BS("Aaargh! Der Schleim brennt in Deinen Augen!"));
    TP->do_damage(1+random(5), this_object());
    return -1;
  }
}

// Laenger als ein Reset muss keiner das Zeug haben ...
reset()
{
  object ob;

  ::reset();
  if (!is_clone(TO)) return;
  ob=environment(this_object());
  
  if (!living(ob)) this_object()->remove();  // Kann nur bei Magiern vorkommen ...
  
  tell_object(ob, BS("Der Schleim trocknet und faellt zu Boden."));
  this_object()->remove();

}

// Entfernen des Schleims beim Spielertot
void NotifyPlayerDeath(object player, object killer, int lostexp) {
  object ob;
  ob=environment(this_object());
  
  if (!living(ob)) this_object()->remove();  // Kann nur bei Magiern vorkommen ...
  if(player == ob) this_object()->remove();

}