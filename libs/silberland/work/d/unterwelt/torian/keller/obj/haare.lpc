
inherit "std/thing";

#include <properties.h>
#include "../def.h"

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp( P_SHORT,"Ein Bueschel Haare");
  SetProp( P_LONG,
   "Ein Bueschel Haare.");

  SetProp( P_NAME, "Haare");
  AddId( ({"haare", "\nHAARE", "bueschel"}));
  SetProp( P_GENDER, FEMALE);
  SetProp( P_WEIGHT, 0);
  SetProp( P_VALUE, 0);
  SetProp( P_NODROP, "So leicht wirst Du die Haare nicht los!\n");
  // kein Pluendern
  SetProp( P_NEVERDROP, 1);
  SetProp( P_MATERIAL, ([MAT_HAIR:100]) );

  call_out("husten", 1 ,1);

}

// Entfernen der Haare beim Spielertot
void NotifyPlayerDeath(object player, object killer, int lostexp) {
  object ob;
  ob=environment(this_object());
  
  if (!living(ob)) this_object()->remove();  // Kann nur bei Magiern vorkommen ...
  if(player == ob) this_object()->remove();

}

void husten(int i)
{
  object ob;
  ob=environment(this_object());

// Husten
  if(ob)
  {
    if(interactive(ob))
    {
      tell_object(ob,"Die Haare kratzen in Deinem Hals!!!\n");
      ob->command_me("huste");
    }
    else
    {
      // Kein Lebewesen -> entfernen
      remove();
    }
  }
  else
  {
    // Kein Environment -> entfernen
    remove();
  }

// initialvalue: i == 1
// i == 3 -> remove
  if(i<3)
  {
    if (find_call_out("husten") != -1) return;
    call_out("husten", 2+random(3), i+random(2));
  }
  else
  {
    if (find_call_out("husten") != -1) return;
    // Env checks already done
    tell_object(ob,"Du spuckst die letzten Haare aus!\n");
    remove();
  }

  return;
}