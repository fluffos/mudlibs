
inherit "std/thing";

#include <properties.h>
#include "../def.h"

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp( P_SHORT,"Ein Silberbrocken");
  SetProp( P_LONG,
   "Ein kleiner unscheinbarer Silberbrocken. Er ist bestimmt eine Menge wert.");

  SetProp( P_NAME, "Silberbrocken");
  AddId( ({"brocken","silberbrocken" }));
  SetProp( P_GENDER, MALE);
  SetProp( P_WEIGHT, 100);
  SetProp( P_VALUE, 500+random(1000));
  SetProp( P_MATERIAL, ([MAT_SILVER:100]) );

}