
inherit "std/thing";

#include <properties.h>
#include "../def.h"

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp( P_SHORT,"Ein Echsenei");
  SetProp( P_LONG,
   "Ein kleines unscheinbares Echsenei. Seine Schale scheint schon "
   "einen kleinen Riss zu haben.");

  SetProp( P_NAME, "Echsenei");
  AddId( ({"ei","echsenei" }));
  SetProp( P_GENDER, NEUTER);
  SetProp( P_WEIGHT, 200);
  SetProp( P_VALUE, 10+random(50));
  SetProp( P_MATERIAL, ([MAT_MISC_SOLID:100]) );

  AddDetail( ({"schale"}),
    "Die Schale scheint schon einen Riss zu haben.");
  AddDetail( ({"riss"}),
    "Vielleicht kannst Du den Riss erweitern?");

  AddCmd( ({"erweiter","erweitere"}),   "cmderweiter" );
  AddCmd( ({"iss","esse", "ess"}),   "cmdessen" );
}
int cmdessen(string str)
{
  notify_fail("Was willst Du essen?\n");
  if(str == "ei" || str == "echsenei")
  {
    if (find_call_out("schluepfen") == -1)
	{
      write(BS("Du beisst einmal kraeftig auf das Ei und brichst Dir fast "
              +"einen Zahn aus."));
      say(BS( PL->name()+ " beisst einmal kraeftig auf das Ei."));
      call_out("schluepfen", 6);
      return 1;
    }
    write(BS("Du hast den Riss doch schon erweitert."));
    return -1;
  }
  return 0;
}
int cmderweiter(string str)
{
  notify_fail("Erweitere was?\n");
  if(str == "riss")
  {
    if (find_call_out("schluepfen") == -1)
	{
      write(BS("Vorsichtig erweiterst Du den Riss."));
      say(BS( PL->name()+ " erweitert vorsichtig den Riss."));
      call_out("schluepfen", 6);
      return 1;
    }
    write(BS("Du hast den Riss doch schon erweitert."));
    return -1;
  }
  return 0;
}
void schluepfen()
{
  object echse, ob, inv;

//env check ob noch im inv und so
  ob=environment(this_object());
  if(!ob) remove(); // kein environment kann gar nicht gut sein -> entfernen
  if ( (!living(ob)) && (ob->id("Container")) && (!(ob->id("Raum"))) ) 
  {
  	inv = environment(ob);
// wenn environment schief geht stimmt irgendwas ganz akut nicht -> entfernen
  	if(!inv) remove();
  	if(inv->id("Raum"))
  	{
  	  tell_room(inv, BS("Der "+ob->QueryProp(P_NAME)+" wackelt "
               +"ploetzlich."));
    }
    if(living(inv))
    {
  	  tell_object(inv, BS("Dein "+ob->QueryProp(P_NAME)+" wackelt ploetzlich."));
  	  tell_room(environment(inv), BS("Der "+ob->QueryProp(P_NAME)+" von "
  	           +inv->Name()+" wackelt ploetzlich."), ({inv}));
  	}
    if (find_call_out("schluepfen") != -1) return;
      call_out("schluepfen", 5);
    return;
  }
  if ( (!living(ob)) && (ob->id("Raum")) )
  {
    tell_room(ob, BS("Ploetzlich schluepft eine kleine Echse aus dem Ei, "
                   +"schaut sich suchend um und rennt weg."));
    remove();
  }
  else
  {
  	tell_room(environment(ob),BS("Ploetzlich schluepft eine kleine Echse "
            +"aus dem Ei. Der Riss war scheinbar gross genug, um die Schale zu "
            +"durchbrechen."));
    echse = clone_object(NPC "vechse");
    echse->SetMama(capitalize(getuid(ob)));
    ob->AddPursuer(echse); 
    echse->move(environment(ob),M_GO|M_SILENT);
    tell_object(ob,BS("Die Babyechse schaut Dich treuherzig an, ob sie Dich als ihre "
            +"Mama ansieht?!?!"));
    tell_room(environment(ob),BS("Die Babyechse schaut "+ob->Name()+" treuherzig an.")
              ,({ ob }));
    remove();
  }
}
