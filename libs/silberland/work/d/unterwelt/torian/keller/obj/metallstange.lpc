
inherit "std/thing";

#include <properties.h>
#include "../def.h"

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp( P_SHORT,"Eine Metallstange");
  SetProp( P_LONG,
   "Eine verbogene, einen halben Meter lange Metallstange, deren hohes Alter "
   "an dem vielen Rost leicht zu erkennen ist.");

  SetProp( P_NAME, "Metallstange");
  AddId( ({"stange","metallstange", QUESTHEBEL,"QUESTOBJ"}));
  SetProp( P_GENDER, FEMALE);
  SetProp( P_WEIGHT, 300);
  SetProp( P_VALUE, 0);
  SetProp( P_MATERIAL, ([MAT_IRON:100]) );

  AddDetail("meter",
    "Nur ein halber.");
  AddDetail("alter",
    "Die Metallstange ist schon sehr verrostet, was auf ein hohes Alter "
    "schliessen laesst. Als Waffe ist sie denkbar ungeeignet.");
  AddDetail("waffe",
    "Wer verwendet schon eine alte, verrostete Waffe?");
  AddDetail(({"rost", "oxidation", "eisen" }),
    "Rost entsteht durch die Oxidation von Eisen.");
}