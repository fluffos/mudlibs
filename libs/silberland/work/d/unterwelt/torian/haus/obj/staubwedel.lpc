
inherit "std/thing";

#include <properties.h>
#include "../def.h"

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp( P_SHORT,"Ein Staubwedel");
  SetProp( P_LONG,
   "Der Staubwedel ist eigentlich nur ein langer Holzstiel, an dessen "
   "Ende lange schwarze Federn befestigt wurden. Er ist besonders gut "
   "zum Entfernen von Staub und Spinnenweben geeignet.");

  SetProp( P_NAME, "Staubwedel");
  AddId( ({"wedel","staubwedel" }));
  SetProp( P_INFO, "Man kann mit ihm wedeln.");
  SetProp( P_GENDER, MALE);
  SetProp( P_WEIGHT, 200);
  SetProp( P_VALUE, 10+random(50));
  SetProp( P_MATERIAL, ([MAT_WOOD:60, MAT_FEATHER:40]) );

  AddDetail( ({"holzstiel","stiel"}),
    "Ein langer Holzstiel, an dem einige besonders grosse Federn "
    "befestigt sind.");
  AddDetail( ({"federn"}),
    "Schwarze Adlerfedern.");
  AddDetail( ({"adlerfedern"}),
    "Die Federn stammen von einem Riesenadler.");
  AddDetail( ({"riesenadler", "gebirge"}),
    "Der Riesenadler ist ein grosses und gefaehrliches Tier, das im Gebirge lebt.");
  AddDetail( ({"entfernen"}),
    "Mit dem Staubwedel lassen sich Staub und Spinnenweben besonders gut "
    "entfernen.");
  AddDetail( ({"staub", "spinnweben"}),
    "Der natuerliche Feind aller Hausfrauen (und Hausmaenner).");
  AddSpecialDetail( ({"hausfrauen", "hausmaenner", "hausfrau", "hausmann"}),
                     "strhausfrau");

  AddCmd( ({"wedel","wedl","wedele", "wedle"}),   "cmdwedel" );
}

int cmdwedel(string str)
{
  notify_fail("Wedel mit was?\n");
  if(str == "mit wedel" || str == "mit staubwedel")
  {
    write(BS("Du fuchtelst wild mit Deinem Staubwedel durch die Gegend und "
            +"wirbelst jede Menge Staub auf."));
    say(BS( PL->name()+ " wedelt mit einem Staubwedel wild in der Gegend herum "
                    +"und wirbelt jede Menge Staub auf."));
    return 1;
  }
  return 0;
}

string strhausfrau(string key)
{
 string s;
 
   s =  "Da Du Dich so fuer diesen Staubwedel interessierst, bist Du offenbar "
       +(PL->QueryProp(P_GENDER)==FEMALE?"eine":"einer")+".";
 return BS(s);
}
