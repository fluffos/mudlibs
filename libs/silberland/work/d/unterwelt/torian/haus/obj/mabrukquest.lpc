#include "../def.h"

inherit "std/thing";
#include "/secure/config.h"

#include <language.h>

int knopf,hebel,stab,spinne,fertisch, stange, hint;

create() {
  if (!is_clone(TO)) return;
  ::create();

  knopf=0;  // Tuer 1
  stange=0; // Stange fuer Tuer 2
  hebel=0;  // Tuer 2
  stab=0;   // Stab genommen
  spinne=0;  // Wesen geopfert oder spinne gekillt
  fertisch=0; // Alles geschaft
  hint=0; // Hinweis am Anfang der Quest

  SetProp(P_SHORT, 0 );
  SetProp(P_LONG,  0 );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( QUESTITEM );

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" beginnt die Quest.\n"
             +"Cloner: "+QueryProp(P_CLONER)+"\n" );

}

void SetKnopf()
{
  knopf = 1;
  return;
}

int QueryKnopf()
{
  return knopf;
}

void SetHebel()
{
  hebel = 1;
  return;
}

int QueryHebel()
{
  return hebel;
}

void SetStange()
{
  stange = 1;
  return;
}

int QueryStange()
{
  return stange;
}

void SetSpinne()
{
  spinne = 1;
  return;
}

int QuerySpinne()
{
  return spinne;
}

int QueryFertisch()
{
  // ueberpruefen ob der Spieler den Stab bekommen darf
  // Keine Moeglichkeit die Quest zu zweit zu spielen ... muss ich 
  // mir noch was gescheites fuer ueberlegen
  //if(!spinne || !stange || !hebel || !knopf) { return 0; }
 
  return 1;
}

void SetHint()
{
  hint = 1;
  return;
}

int QueryHint()
{
  return hint;
}
