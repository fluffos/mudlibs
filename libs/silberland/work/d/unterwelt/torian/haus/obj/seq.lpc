
inherit "std/thing";

#include <properties.h>
#include "../def.h"

void mabruksequence(object spieler, int curpos, mixed *daten);

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp( P_SHORT,"Sequencer");
  SetProp( P_LONG,
   "Sequencer.");

  SetProp(P_SHORT, 0 );
  SetProp(P_LONG,  0 );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( "mabruksequencer" );
  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  AddCmd("", "nix",1);

}

int nix(string str) 
{
  // Magier duerfen alles
  if (IS_LEARNER(TP)) return 0;
  // Spieler nichts ...
  tell_object(this_player(),BS("Du bist zu fasziniert von Mabruk."));
  return 1;

}

// Entfernen der Sequence beim Spielertod ... 
void NotifyPlayerDeath(object player, object killer, int lostexp) {
  object ob;
  ob=environment(this_object());
  
  while (remove_call_out("mabruksequence") != -1)

  if (!living(ob)) this_object()->remove();  // Kann nur bei Magiern vorkommen ...
  if(player == ob) this_object()->remove();
}

int Sequence(object player)
{
  if (player) 
  {
    mabruksequence(player, 0, ({
  0, "Begierig reisst Mabruk Dir den Zauberstab aus den Haenden und haelt ihn "
    +"triumphierend in die Luft.",
  6, "#Mabruk ruft laut: Jetzt werde ich meine Macht endlich wiedererlangen!",
  6, "#Mabruk spricht ein paar geheimnisvolle Worte und der Rubin des Zauberstabs "
    +"beginnt zu leuchten und immer heller zu werden.",
  6, "#Mabruk kreischt: Was hast Du getan?!?!",
  6, "#Mabruk schreit: Du hast meinen Zauberstab zerstoert! Dafuer wirst Du buessen!!! ",
  6, "#Mabruks Stimme erhebt sich zu einem lauten Tosen und er scheint sich zu "
    +"verwandeln.",
  6, "#Entsetzt beobachtest Du Mabruk. Sein Gesicht verschwimmt vor Deinen Augen, "
    +"wird immer undeutlicher und scheint sich in etwas zu verformen, was unmoeglich "
    +"von dieser Welt stammen kann.",
  8, "#Mabruks Gestalt waechst immer mehr an und schliesslich ragt er wie ein "
    +"unheilvoller und maechtiger Racheengel vor Dir auf.",
  6, "#Mabruk streckt seine Haende aus und deutet dann mit seiner linken Hand in "
     +"Deine Richtung, waehrend er beschwoerend einen finsteren Fluch vor sich "
     +"hinmurmelt. ",
  8, "#Bedrohlich kommt Mabruk immer weiter auf Dich zu und Du spuerst, wie sich "
    +"dunkle Maechte auf Dich zubewegen.",
  6, "#Voellig hilflos und veraengstigt kauerst Du auf dem Boden und wartest Dein "
    +"immer naeher rueckendes Ende ab.",
  6, "#Ploetzlich sinkt Mabruk mit einem leisen Stoehnen zu Boden und greift "
    +"sich mit schmerzverzerrtem Gesicht an den Kopf. Die unheilvolle Kraft, die "
    +"Du gespuert hast, verschwindet langsam.",
  7, "#Anscheinend reicht Mabruks Kraft noch nicht dazu aus, seinen Fluch wahr "
    +"werden zu lassen.",
  6, "#Zutiefst erleichtert und mit leicht zitternden Knien erhebst Du Dich und starrst "
    +"Mabruk dann veraechtlich an.",
  6, "#Mabruk sagt leise mit drohender Stimme: Warte nur, bis ich meine ganze Macht "
    +"wiedererlangt habe, dann werde ich Dir zeigen, was ein wahrer Magier vollbringen "
    +"kann!",
  6, "#Mabruk ruft: Und nun verschwinde aus meinem Haus!!!",
  4, "#"
    }));
  }
  return 1;
}

void mabruksequence(object spieler, int curpos, mixed *daten)
{
  object wohnzimmer;

  if (!spieler) return;
  if (daten[curpos+1][0] == 35) 
  {
    tell_object(spieler, "\n");
    tell_object(spieler, BS(daten[curpos+1][1..]));
  } 
  else 
  {
    tell_object(spieler, BS(daten[curpos+1]));
  }
  if (curpos + 2 < sizeof(daten)) {
    call_out("mabruksequence", daten[curpos+2], spieler, curpos+2, daten);
  }
  else 
  {
    // nix mehr zum schreiben, QuestFertig aufrufen
    // DB("Fertig mit Sequence!\n");

    call_other (ROOM "wohnzimmer", "???", 0);
    wohnzimmer = find_object(ROOM "wohnzimmer");
    if (wohnzimmer)
    {
      wohnzimmer->QuestFertig(spieler);
      call_out("remove",0);
    }
  }
}