inherit "std/room";

#include <language.h>
#include "../def.h"

#define KUECHE ROOM "kueche"
#define EINGANG ROOM "eingang"
#define GEHEIMRAUM ROOM "geheimraum"

// fuer die Geheimtuer im Norden
int kamin_aus;

// fuer das untersuchen des Schrankinhalts
int schrank_offen;
int zucker;

void create()
{

  ::create();

  SetProp( P_INT_SHORT, "Esszimmer" );
  SetProp( P_INT_LONG,
    "Dies hier scheint das Esszimmer zu sein. In der Mitte des Raumes "
    "steht ein kleiner Tisch mit einem einzelnen Stuhl davor. Im Norden "
    "siehst Du einen unscheinbaren Kamin. An der oestlichen Wand steht "
    "ein Schrank mit einer Glastuer und verschiedenem Geschirr dahinter. "
    "Im Westen gelangst Du in die Kueche, im Sueden in den Eingangsbereich." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  kamin_aus=0; // Feuer im Kamin ist an.
  schrank_offen=0; // Schrank ist zu.
  zucker=1; // Zucker ist in der Dose.

  AddDetail( ({ "esszimmer", "raum" }), QueryProp(P_INT_LONG));
  AddDetail( ({ "mitte" }),
    "In der Mitte des Raumes steht ein kleiner Tisch mit einem einzelnen Stuhl "
    "davor.");
  AddDetail( ({ "tisch" }),
    "Ein einfacher kleiner Tisch aus Holz. Hier scheint der Bewohner dieses "
    "Hauses seine Mahlzeiten zu sich zu nehmen.");
  AddDetail( ({ "wald", "sternenwald", "ort" }),
    "Der Sternenwald ist ein mystischer Ort voller tiefer Geheimnisse und "
    "wunderbarer Wesen.");
  AddDetail( ({"geheimnisse", "geheimniss"}),
    "Das musst Du schon selber herausfinden ...");
  AddDetail( ({ "holz" }),
    "Das Holz scheint direkt aus dem Sternenwald zu stammen.");
  AddDetail( ({"wesen"}),
    "Wunderbare Wesen kannst Du in diesem Wald antreffen.");
  AddDetail( ({ "einsiedler", "bewohner", "besitzer" }),
    "Schau Dich mal in dem Haus um, irgendwo wird er schon sein.");
  AddDetail( ({ "haus" }),
    "Das Haus, in dem Du Dich gerade befindest.");
  AddDetail( ({ "mahlzeiten" }),
    "Gewoehnlich bereitet man sich seine Mahlzeiten in der Kueche zu.");
  AddDetail( ({ "stuhl", "holzstuhl" }),
    "Ein einfacher, aber bequemer Holzstuhl mit einem kleinen Kissen darauf.");
  AddDetail( ({ "kissen" }),
    "Auf dem Stuhl liegt ein kleines weiches Kissen, welches mit Daunenfedern "
    "ausgestopft zu sein scheint.");
  AddDetail( ({ "daunenfedern", "federn"}),
    "Vorsichtig befuehlst Du das Kissen und stellst fest, dass es tatsaechlich "
    "mit weichen, flaumigen Daunenfedern gefuellt wurde. Es scheinen besonders "
    "weiche Schwanendaunen zu sein.");
  AddDetail( ({ "schwanendaunen" }),
    "Es scheinen besonders weiche Schwanendaunen zu sein.");
  AddDetail( ({ "norden" }),
    "Im Norden siehst Du einen unscheinbaren Kamin. Direkt daneben steht ein "
    "alter verbeulter Eimer.");
  AddDetail( ({ "nagel" }),
    "Ein ganz normaler Nagel.");
  AddDetail( ({ "seitenwand" }),
    "An der Seitenwand des Kamins haengt ein grosser Schuerhaken an einem "
    "Nagel.");
  AddDetail( ({ "schuerhaken", "haken" }),
    "Ein schwerer Schuerhaken aus Metall.");
  AddDetail( ({ "metall", "metalle" }),
    "Du bist Dir nicht ganz sicher, glaubst aber, dass der Schuerhaken "
    "aus Eisen besteht. An der Spitze hat sich das Metall durch den Russ "
    "dunkel verfaerbt.");
  AddDetail( ({ "eisen" }),
    "Das Eisen scheint von den Gnomen zu stammen.");
  AddDetail( ({ "gnom", "gnome" }),
    "Gnome verstehen wirklich etwas von Metallen. Die Verarbeitung ist gut und "
    "die Metallqualitaet ebenfalls.");
  AddDetail( ({ "metallverarbeitung", "verarbeitung", "metallqualitaet", "qualitaet" }),
    "Gnome verstehen wirklich etwas von Metallen, dennoch reichen sie "
    "natuerlich nicht an die Fertigkeiten der Zwerge heran.");
  AddDetail( ({ "fertigkeiten", "gebiet" }),
    "Die Fertigkeiten der Zwerge auf dem Gebiet der Metallverarbeitung "
    "sind wohl unuebertroffen.");
  AddDetail( ({ "zwerge" }),
    "Die Zwerge leben in der unterirdischen Stadt Felonia mitten im Gebirge.");
  AddDetail( ({ "gebirge", "heimat" }),
    "Das Gebirge ist die Heimat der Zwerge.");
  AddDetail( ({ "heimatstadt", "stadt", "felonia" }),
    "Felonia ist die Heimatstadt der Zwerge.");
  AddDetail( ({ "spitze" }),
    "Die Spitze des Schuerhakens ist mit einer dunklen Schicht Russ "
    "ueberzogen.");
  AddDetail( ({ "schicht" }),
    "Eine dicke Schicht Russ bedeckt die Spitze des Schuerhakens.");
  AddDetail( ({ "russ" }),
    "Huch, jetzt hast Du Dich ueber und ueber mit Russ beschmiert! "
    "Dreckspatz!");
  AddDetail( ({ "dreckspatz" }),
    "Ja, Du!");
  AddDetail( ({ "eimer" }),
    "Ein alter verbeulter Eimer. Es befindet sich genuegend Wasser in ihm, um "
    "das Feuer ohne Probleme loeschen zu koennen.");
  AddDetail( ({ "wasser" }),
    "Der Eimer ist bis obenhin voll mit Wasser.");
  AddDetail( ({ "probleme" }),
    "Auch Du solltest damit keine Probleme haben.");
  AddDetail( ({ "schrank" }),
    "Ein schwerer Schrank aus solidem Holz. Hinter der Glastuer kannst Du "
    "einiges Geschirr und Besteck sehen.");
  AddDetail( ({ "glastuer", "tuer" }),
    "Hinter der Glastuer siehst Du einige Teller und anderes Geschirr. "
    "Du kannst sie Dir ja mal genauer anschauen. Vielleicht laesst sich "
    "die Tuer sogar oeffnen?");
  AddDetail( ({ "hand" }),
    "Wo sich Deine Hand befindet, solltest Du schon selber wissen.");
  AddDetail( ({ "glueck", "viel", "ferne" }),
    "Jemand wuenscht Dir 'Viel Glueck!' aus der Ferne.");
  AddDetail( ({ "westen" }),
    "Im Westen befindet sich die Kueche.");
  AddDetail( ({ "kueche" }),
    "Wenn Du mehr wissen willst, musst Du schon nach Westen gehen.");
  AddDetail( ({ "sueden" }),
    "Im Sueden gelangst Du wieder zurueck in den Eingangsbereich.");
  AddDetail( ({ "eingangsbereich", "eingang" }),
    "Der Eingang befindet sich suedlich von Dir.");
  AddDetail( ({ "boden", "holzfussboden" }),
    "Der Holzfussboden sieht sehr sauber und gepflegt aus. Du kannst nicht "
    "ein einziges Staubkoernchen entdecken.");
  AddDetail( ({ "staub", "staubkoernchen" }),
    "So sehr Du Dich auch bemuehst, Du kannst keinen Staub erkennen.");
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus einfachen Holzbohlen.");
  AddDetail( ({ "wand", "waende" }),
    "An den Waenden sind einige Fackelhalter mit hell leuchtenden "
    "Fackeln angebracht, die den gesamten Raum in ein gedaempftes Licht "
    "tauchen. An der oestlichen Wand steht ein Schrank mit einer "
    "Glastuer und im Norden siehst Du einen Kamin. Durch die beiden "
    "Tueren im Westen und Sueden gelangst Du in die Kueche und in den "
    "Eingangsbereich zurueck.");
  AddDetail( ({ "fackelhalter","halter" }),
    "In jedem Fackelhalter steckt eine hell leuchtende Fackel.");
  AddDetail( ({ "fackel", "fackeln" }),
    "Die Fackeln spenden genuegend Licht.");
  AddDetail( ({ "licht" }),
    "Es ist offensichtlich hell genug.");
  AddDetail( ({ "tueren" }),
    "Die Tuer im Westen fuehrt in die Kueche, waehrend Du im Sueden "
    "zurueck in den Eingangsbereich gelangst.");
  AddDetail( ({"bohlen", "holzbohlen"}),
    "Einfache schlichte Holzbohlen.");

// Schrankinhalt
  AddSpecialDetail(
    ({"besteck", "teeloeffel", "loeffel",
      "geschirr",
      "teller", "tassen", "tasse",
      "porzellan",
      "unterseite",
      "inschrift", "vorteil",
      "bluemchen", "blumen", "blume",
      "glaeser",
      "teekanne", "kanne",
      "rand",
      "riss",
      "kopf",
      "milchkaennchen", "kaennchen",
      "zuckerdose", "dose",
      "zucker",
      "substanz",
     }), "details_im_schrank" );

// Feuer an oder aus -> unterschiedliche details
  AddSpecialDetail( ({ "kamin" }), "strkamin");
  AddSpecialDetail( ({ "feuer" }), "strfeuer");
  AddSpecialDetail( ({ "rueckwand", "blick" }), "strrueckwand");

  AddSound( DEFAULT_SOUND,
    "Es ist sehr still hier.");

  AddSound( ({ "stille", "still" }),
    "Du hoerst wirklich nichts.");

  AddSmell( DEFAULT_SMELL,
    "Ein angenehmer Duft stroemt aus der Kueche.");

  AddSmell( ({ "kueche" }),
    "Das solltest Du besser in der Kueche tun.");
  AddSmell( ({ "duft" }),
    "Es riecht nach Essen.");
  AddSmell( ({ "essen" }),
    "Hmmm, riecht das lecker!");

  AddCmd( ({ "loesche", "loesch" }), "cmdloesche" );
  AddCmd( ({ "oeffne" }), "cmdoeffne" );
  AddCmd( ({ "schliesse", "schliess" }), "cmdschliesse" );
  AddCmd( ({ "kriech", "krieche" }), "cmdkrieche" );
  AddCmd( ({ "greif", "greife" }), "cmdgreif" );

  AddExit( "sueden", "in den Eingangsbereich#" +EINGANG );
  AddExit( "westen", "in die Kueche#" +KUECHE );
}

// Funktion zum loeschen des Feuers im Kamin
int cmdloesche(string str )
{
  if( str == "feuer mit wasser" )
  {
    if (!kamin_aus)
    {
    write("Du loeschst das Feuer.\n");
    say( PL->name()+" loescht das Feuer.\n");
    kamin_aus=1; // Feuer im Kamin ist aus.
    return 1;
    }
    else
    {
      write("Das Feuer ist bereits geloescht.\n");
      return 1;
    }
  }
  write( "Was willst Du womit tun?\n" );
  return 1;
}

string strfeuer(string key)
{
  return (kamin_aus) ? BS("Da kein Feuer mehr im Kamin brennt, hast Du "
                         +"freien Blick auf die Rueckwand.") :
                       BS("Es brennt ein kleines Feuer im Kamin und "
                         +"waermt den Raum.") ;
}

string strrueckwand(string key)
{
  return (kamin_aus) ? BS("Nanu? Da ist ja gar keine Rueckwand! Ob man "
                         +"vielleicht durch den Kamin kriechen kann?") :
                          "Sowas siehst Du da nicht!\n" ;
}

string strkamin(string key)
{
  string s;

  s = "Direkt neben dem Kamin steht ein alter verbeulter Eimer "
     +"und an der Seitenwand haengt ein Schuerhaken an einem Nagel.";

  if (kamin_aus)
    return BS("Im Moment brennt kein Feuer im Kamin. "+s);
  else
    return BS("In dem Kamin brennt ein kleines Feuer. Obwohl es nicht sehr "
             +"gross ist, waermt es den ganzen Raum. "+s);
}
// oeffnen des Schrankes
int cmdoeffne(string str)
{
  notify_fail( "Was willst Du oeffnen?\n" );
  if(str == "schrank" || str == "tuer" || str == "schranktuer" || str == "glastuer" )
  {
    if(!schrank_offen)
    {
      say( PL->name()+" oeffnet den Schrank.\n");
      write("Du oeffnest den Schrank.\n");
      // Schrank offen -> Details untersuchbar -> details_im_schrank()
      // inschrift lesbar
      schrank_offen = 1;
      AddReadDetail( ({ "inschrift" }),
        "Du liest \"Meissen\". (Ahja...) O o . denkst Du Dir und stellst "
        "die Tasse vorsichtig wieder zurueck.");
      return 1;
    }
    else
    {
      write("Der Schrank ist doch schon offen.\n");
      return 1;
    }
  }
  return 0;
}

int cmdschliesse(string str)
{
  notify_fail( "Was willst Du schliessen?\n" );
  if(str == "schrank" )
  {
    if(schrank_offen)
    {
      say( PL->name()+" schliesst den Schrank.\n");
      write("Du schliesst den Schrank.\n");
      // Details nimmer untersuchbar, inschrift nicht mehr lesbar !
      schrank_offen = 0;
      RemoveReadDetail("inschrift");
      return 1;
    }
    else
    {
      write("Der Schrank ist doch schon zu.\n");
      return 1;
    }
  }
  return 0;
}

// move in den Geheimraum
int cmdkrieche(string str)
{
  if(str == "durch kamin")
  {
    object obj;

    if ( !kamin_aus )
    {
	   write("Durch das brennende Feuer!?\n");
	   return 1;
    }
    call_other(GEHEIMRAUM, "???", 0);
    obj = find_object(GEHEIMRAUM);
    if(obj)
    {
      PL->move(obj, M_NOCHECK, "durch den Kamin",
                          "kriecht", "kriecht herein");
      return 1;
    }
    else
    {
      write("Fehler! Bitte melde ihn an Torian.\n");
      return 1;
    }
  }
  write("Was willst Du tun?\n");
  return 1;
}

// Wenn der Schrank offen ist und noch Zucker vorhanden ...
int cmdgreif(string str)
{
  notify_fail( "Wo moechtest Du reingreifen?\n" );
  if(schrank_offen == 1)
  {
    if(str == "in zuckerdose" || str == "in dose")
    {
      if(zucker == 1)
      {
        zucker = 0;
        say(PL->name()+" greift in die Zuckerdose und freut sich.\n");
        write(BS("Du greifst in die Zuckerdose und findest tatsaechlich ein "
             +"Stueckchen Zucker. Schnell schiebst Du es Dir in den Mund und "
             +"laesst es auf der Zunge zergehen.") );
        return 1;
      }
      else
      {
        say( PL->name()+" greift in die Zuckerdose und wendet sich enttaeuscht ab.\n");
        write(BS("Du greifst in die Zuckerdose, findest jedoch leider nichts. "
              "Da war wohl jemand schneller als Du."));
        return 1;
      }
    }
  }
  return 0;
}
string details_im_schrank(string key)
{
  string s;

  if(!schrank_offen) return "Vielleicht solltest Du erst den Schrank oeffnen ?\n";

  switch(key)
  {
    case "besteck" :
    case "teeloeffel" :
    case "loeffel" :
      s = "Teeloeffel und aehnliches.";
      break;

    case "geschirr" :
      s ="Du siehst Teller, Tassen und ein paar Glaeser. Sogar eine "
         "grosse Teekanne mit Milchkaennchen und Zuckerdose befindet "
         "sich hinter der Glastuer.";
      break;

    case "teller" :
    case "tassen" :
    case "tasse" :
      s = "Die Teller und Tassen sind aus feinstem Porzellan. Du nimmst "
          "eine besonders schoene Tasse zur Hand und findest an der "
          "Unterseite eine kleine Inschrift.";
      break;
    case "porzellan" :
      s = "Feines weisses Porzellan mit kleinen Bluemchen darauf.";
      break;
    case "unterseite" :
      s = "An der Unterseite befindet sich eine kleine Inschrift.";
      break;
    case "inschrift" :
    case "vorteil" :
      s = "Wer lesen kann, ist klar im Vorteil.";
      break;
    case "bluemchen" :
    case "blumen" :
    case "blume" :
      s = "Um was fuer Blumen es sich genau handelt, kannst Du leider "
          "nicht sagen.";
      break;
    case "teekanne" :
    case "kanne" :
      s = "Die Teekanne besteht ebenfalls aus Porzellan. Sie scheint "
          "haeufig benutzt zu werden, denn am oberen Rand kannst Du "
          "schon einen kleinen Riss erkennen.";
      break;
    case "rand" :
      s = "Am oberen Rand der Teekanne siehst Du einen kleinen Riss im "
          "Porzellan.";
      break;
    case "riss" :
      s = "Du steckst Deinen Kopf tief in den Schrank hinein und "
          "begutachtest die Teekanne. Ja, dort ist doch tatsaechlich "
          "ein kleiner Riss im Porzellan.";
      break;
    case "kopf" :
      s = "Autsch, jetzt hast Du Dir den Kopf gestossen!";
      break;
    case "milchkaennchen" :
    case "kaennchen" :
      s = "Ein kleines Milchkaennchen aus Porzellan.";
      break;
    case "zuckerdose" :
    case "dose" :
      s = "Eine Zuckerdose, ebenfalls aus feinstem Porzellan. Vielleicht "
          "hast Du ja Glueck und es befindet sich noch etwas Zucker dort "
          "drin?";
      break;
    case "zucker" :
      s = "Eine suessliche weisse Substanz. Sehr lecker!";
      break;
    case "substanz" :
      s = "Zucker ist eine suessliche weisse Substanz.";
      break;
    case "glaeser" :
      s = "Einige saubere Glaeser stehen im Schrank.";
      break;
    default :
      s = "Sowas siehst Du hier nicht.";
      break;
  }

  return BS(s);
}

int QueryFire()
{
  return !kamin_aus;
}

reset()
{
  ::reset();
  if(kamin_aus)
    tell_room(this_object(), "Wie durch Geisterhand entfacht sich das Feuer "                               +"erneut.\n");

  if(schrank_offen)
  {
    tell_room(this_object(), "Durch einen sachten Windstoss wird der Schrank "
                         +"wieder geschlossen.\n");
    RemoveReadDetail("inschrift");
  }
  kamin_aus=0;  // Kamin wieder an.
  schrank_offen=0; // Schrank zu.
  zucker=1; // Neues Zuckerli
}
