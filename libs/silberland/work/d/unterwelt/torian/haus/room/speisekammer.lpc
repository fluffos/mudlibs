inherit "std/room";

#include <language.h>
#include "../def.h"

#define BRUNNEN "./brunnen"

#define DA 1
#define WEG 0

int wicht, drude, faun;

create()
{
  ::create();

  wicht = DA;
  drude = DA;
  faun = DA;

  SetProp( P_INT_SHORT, "In der Speisekammer." );
  SetProp( P_INT_LONG,
     "Dies hier ist die Speisekammer. An der Decke sind schwere Haken "
     "befestigt, von denen grosse Brocken Fleisch herabhaengen. Auf dem "
     "Boden faellt Dir ein grosser, in einem seltsamen Blau leuchtender "
     "Stein auf. Verwundert bemerkst Du, dass die Waende mit Reif "
     "ueberzogen sind.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: -1, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({"speisekammer"}),
    "Du befindest Dich in der Speisekammer.");
  AddDetail( ({"haken", "eisenhaken"}),
    "Schwere Eisenhaken sind an der Decke befestigt.");
  AddDetail( ({"brocken", "fleisch"}),
    "Ein paar grosse Brocken Einhornfleisch und einige kleinere "
    "Fleischstuecke haengen von der Decke herab.");
  AddDetail( ({"einhornfleisch"}),
    "Ja, Du hast ganz richtig gesehen, es handelt sich wirklich um "
    "zartes Einhornfleisch. Der alte Mann oben im Haus scheint auf "
    "Einhoerner wohl nicht sehr gut zu sprechen zu sein.");
  AddDetail( ({"haus"}),
    "Der alte Mann haelt sich irgendwo oben im Haus auf.");
  AddDetail( ({"hausbesitzer", "besitzer"}),
    "Vielleicht solltest Du ihn vorher fragen.");
  AddDetail( ({"mann"}),
    "Frag ihn doch mal ein wenig aus, vielleicht kann er Dir mehr "
    "darueber erzaehlen.");
  AddDetail( ({"einhorn","einhoerner"}),
    "Einhoerner sind Wesen voller Anmut und Kraft, deren Blicke Weisheit und "
    "Guete gleichermassen ausstrahlen.");
  AddDetail( ({ "anmut" }),
    "Voller Anmut und Kraft streifen die Einhoerner durch den Sternenwald.");
  AddDetail( ({ "kraft" }),
    "Du spuerst instinktiv die Kraft, die von den Einhoernern ausgeht.");
  AddDetail( ({ "blicke", "blick" }),
    "Hast Du jemals ein Einhorn gesehen? Wenn ja, weisst Du, was ich meine.");
  AddDetail( ({"weisheit", "kinn"}),
    "Weise kratzt Du Dein Kinn.");
  AddDetail( ({ "guete" }),
    "Die Guete der Einhoerner ist wohl unuebertroffen.");
  AddDetail( ({ "wald", "sternenwald", "ort" }),
    "Der Sternenwald ist ein mystischer Ort voller tiefer Geheimnisse und "
    "wunderbarer Wesen.");
  AddDetail( ({"geheimnisse", "geheimniss"}),
    "Das musst Du schon selber herausfinden ...");
  AddDetail( ({"wesen"}),
    "Wunderbare Wesen kannst Du in diesem Wald antreffen, wie zum "
    "Beispiel kleine Rumpelwichte, Wilddruden, Faune, Graugnome oder gar "
    "die sagenumwobenen Einhoerner.");
  AddDetail( ({"beispiel"}),
    "Nur ein Beispiel von vielen.");
  AddDetail( ({"rumpelwichte"}),
    "Rumpelwichte wohnen normalerweise in Baumhoehlen und kommen so gut "
    "wie nie ans Tageslicht. Wenn man sie richtig zuzubereiten weiss, "
    "ist ihr Fleisch ein echter Genuss fuer einen Feinschmecker.");
  AddDetail( ({"baumhoehlen", "erdhoehlen"}),
    "Rumpelwichte leben gerne in Baumhoehlen.");
  AddDetail( ({"tageslicht"}),
    "Sie scheuen das Tageslicht.");
  AddDetail( ({"feinschmecker", "genuss"}),
    "Wirklich etwas fuer Feinschmecker.");
  AddDetail( ({"wilddruden"}),
    "Wilddruden sind Voegel mit pechschwarzen Federn und sehr scharfen "
    "Augen, denen nicht die kleinste Bewegung entgeht.");
  AddDetail( ({"voegel"}),
    "Wilddruden sind Voegel mit pechschwarzen Federn und scharfen Augen.");
  AddDetail( ({"federn"}),
    "Ihre Federn sind pechschwarz.");
  AddDetail( ({"augen", "bewegung"}),
    "Ihren Augen entgeht nicht die kleinste Bewegung.");
  AddDetail( ({"faune"}),
    "Faune sind sonderbare Wesen. Sie haben den Unterleib einer Ziege "
    "und den Oberkoerper eines Menschen. Das Fleisch des Unterleibs ist "
    "sehr zart und saftig.");
  AddDetail( ({"unterleib"}),
    "Ihr Unterleib ist der einer Ziege.");
  AddDetail( ({"ziege"}),
    "Maeeeh!");
  AddDetail( ({"oberkoerper"}),
    "Faune haben den Oberkoerper eines Menschen.");
  AddDetail( ({"menschen", "mensch"}),
    ([0: "Du bist keiner.",
      "mensch": "Du bist einer."]) );
  AddDetail( ({"graugnome"}),
    "Diese kleinen, lustigen Gesellen leben in kleinen Hoehlen in der "
    "Erde und ernaehren sich von Nuessen, Samen und was sich sonst auf "
    "dem Erdboden findet. Ihr Fleisch ist nicht so zaeh wie das anderer "
    "Gnome."); 
  AddDetail( ({"gesellen"}),
    "Graugnome sind schon lustige Gesellen.");
  AddDetail( ({"hoehlen", "erde"}),
    "Kleine Hoehlen in der Erde.");
  AddDetail( ({"nuesse", "haselnuesse", "samen"}),
    "Alles, was sich so auf dem Erdboden findet.");
  AddDetail( ({"erdboden"}),
    "Auf dem Erdboden lassen sich oft Nuesse und Samen finden.");
  AddDetail( ({"gnome", "gnom", "kerlchen"}),
    "Graugnome haben mit richtigen Gnomen nur wenig zu tun, sie sind eher "
    "putzige Kerlchen.");
/* Das is heftig ... ka ob mans stehen lassen kann/sollte, leider stimmts 
  AddDetail( ({"kerlchen", "herz"}),
    "Ich bin klein, mein Herz ist schmutzig. Das macht das Strontium 90, "
    "ist das nicht putzig?");
  AddDetail( ({"strontium", "strontium 90", "belastung"}),
    "Besonders Haselnuesse haben oftmals eine hohe radioaktive Belastung "
    "durch Strontium 90.");
*/
  AddDetail( ({"fleischstuecke"}),
    "Die kleineren Fleischstuecke stammen von Rumpelwichten, Graugnomen, "
    "Wilddruden und Faunen.");
  AddDetail( ({"blau"}),
    "Der Stein leuchtet in einem seltsamen Blau. Es taucht den Raum in "
    "ein fast ueberirdisch wirkendes Licht. Du bist sicher, dass "
    "irgendeine geheimnisvolle Magie dahintersteckt.");
  AddDetail( ({"raum"}), QueryProp(P_INT_LONG));
  AddDetail( ({"licht"}),
    "Der ganze Raum ist in ein blaeulich schimmerndes Licht getaucht.");
  AddDetail( ({"magie"}),
    "Da kann nur Magie dahinterstecken.");
  AddDetail( ({"stein"}),
    "Auf dem Boden liegt ein grosser, in einem seltsamen Blau leuchtender "
    "Stein. Er sieht irgendwie magisch aus und es geht eine grosse Kaelte "
    "von ihm aus.");
  AddDetail( ({"kaelte"}),
    "Von dem Stein geht eine eisige Kaelte aus. Fass ihn lieber nicht an.");
  AddDetail( ({"reif"}),
    "Weisser, glitzernder Reif ueberzieht die Waende.");
  AddDetail( ({"decke"}),
    "An der Decke sind schwere Haken befestigt, von denen grosse Brocken "
    "Fleisch herabhaengen.");
  AddDetail( ({"boden"}),
    "Auf dem Boden liegt ein grosser, in einem seltsamen Blau leuchtender "
    "Stein. Um den Stein herum ist der Boden mit einer feinen Eisschicht "
    "bedeckt.");
  AddDetail( ({"eisschicht", "eis"}),
    "Eine feine Eisschicht bedeckt den Boden um den Stein herum.");
  AddDetail( ({"wand","waende"}),
    "Die Waende sind vollstaendig mit weissem Reif ueberzogen.");
  AddDetail( ({"gefuehl"}),
    "Das Gefuehl koennte Dich aber auch taeuschen.");

  AddSound( DEFAULT_SOUND,
    "Ab und zu knackt es leise. Ausserdem hoerst Du ein leises Summen.");
  AddSound( ({ "knacken", "knackt" }),
    "Das Eis knackt leise.");
  AddSound( ({ "eis" }),
    "Das Eis an den Waenden knackt ab und zu leise.");
  AddSound( ({ "waende", "wand" }),
    "Pass lieber auf, sonst friert Dir noch Dein Ohr ab.");
  AddSound( ({ "summen", "summ" }),
    "Das Summen scheint von dem geheimnisvollen Stein am Boden auszugehen.");
  AddSound( ({ "stein" }),
    "Die Magie, die in dem Stein steckt, verursacht ein leises Summen.");
  AddSound( ({ "magie" }),
    "Es summt leise.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Fleisch.");
  AddSmell( ({ "fleisch" }),
    "Du schnupperst an einem grossen Fleischstueck herum, das direkt vor "
    "Deiner Nase herumbaumelt. Dir laeuft das Wasser im Mund zusammen. "
    "Ob Du vielleicht ein kleines Stueck davon kosten darfst?");
  AddSmell( ({ "stueck", "fleischstueck" }),
    "Ob Du vielleicht ein kleines Stueck davon kosten darfst?");
    
  AddCmd( ({ "koste", "kost" }), "cmdkoste" );
  AddCmd( ({ "fass", "fasse" }), "cmdfass" );

  AddExit( "westen", "nach Westen#" +BRUNNEN );
}

int cmdfass(string str)
{

  notify_fail("Was willst Du anfassen?\n");
  
  if(str == "stein an" )
  {
    write(BS("Du fasst den Stein an und spuerst, wie Dir Deine Koerperwaerme "
         +"foermlich entzogen wird. Schnell laesst Du den Stein wieder los.")); 
    say(BS(PL->name()+" fasst den Stein an, zieht aber "
                  +(PL->QueryProp(P_GENDER)==MALE?"seine":"ihre")
                  +" Hand schnell wieder zurueck.") );

    PL->AddHp(-10);
    return 1;
  }
  return 0;
}

int cmdkoste(string str)
{
  string s, s2;

  s2 = "Du traust Dich nicht, noch mehr von dem Fleisch zu stibitzen.";

  notify_fail("Welches Fleisch willst Du kosten?\n");

  if(!str || str=="") return 0;

    switch(str)
    {
      case "rumpelwichtfleisch" :
      case "wichte" :
      case "wicht" :
        if(wicht == WEG) { s = s2; }
        else
	{  
	  s = "Du kostest ein wenig von dem zarten Fleisch und spuerst ein "
             +"wohliges Gefuehl im Magen. Mhmm, was fuer ein Genuss!";
          PL->AddSp(20+random(10));
          wicht = WEG;
	}
        break;
      case "faunfleisch" :
      case "faune" :
      case "faun" :
        if(faun == WEG) { s = s2; }
        else
	{
	  s = "Du schnappst Dir ein Stueck Faunenfleisch und beginnst zu "
             +"kauen. Irgendwie hinterlaesst das Fleisch einen merkwuerdigen "
             +"Geschmack in Deinem Mund und Du spuckst es schnell wieder aus. "
             +"Anscheinend war das Stueckchen schon etwas aelter.";
	      TP->AddPoison(1);

          faun = WEG;
	}
        break;
      case "einhornfleisch" :
      case "einhorn" :
          s = "Du hast das unbestimmte Gefuehl, dass der Hausbesitzer "
	     +"es Dir sehr uebel nehmen wuerde, wenn Du dich an dem "
	     +"Einhornfleisch vergreifen solltest, und beschliesst, "
	     +"es lieber nicht anzuruehren.";
        break;
      case "graugnomfleisch" :
      case "gnomfleisch" :
      case "graugnom" :
      case "gnom" :
          s = "Du musterst die grauen Fleischstuecke misstrauisch und wendest "
	     +"Dich dann lieber den anderen Fleischsorten zu.";
        break;
      case "drudenfleisch" :
      case "wilddrudenfleisch" :
      case "wilddrude" :
      case "drude" :
      case "druden" :
        if(drude == WEG) { s = s2; }
	else
	{
          s = "Du reisst Dir ein kleines Fluegelstueck ab und laesst das zarte "
             +"Fleisch genuesslich auf Deiner Zunge zergehen.\n"
	     +"Du denkst   . o O (Schmeckt wie Huehnchen.)";
          PL->AddHp(20+random(10));
          drude = WEG;
	}
        break;
      default :
        return 0;
    }
    write( BS(s) );
    return 1;
}
reset()
{
  ::reset();

  drude = DA;
  wicht = DA;
  faun = DA;
}
