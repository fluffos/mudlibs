inherit "std/room";

#include <language.h>
#include "../def.h"

#define BRUNNEN ROOM "brunnen"

#define JA  1
#define NEIN  0
#define DA  1
#define WEG  0
#define BRECHEISEN WEAPON "brecheisen"

int brecheisen, ratte, stuhl, besetzt;

create()
{
  ::create();

  stuhl = DA;
  brecheisen = DA;
  ratte = DA;

  SetProp( P_INT_SHORT, "Im Vorratskeller." );
  SetProp( P_INT_LONG,
     "Du befindest Dich in einem kleinen Vorratskeller. Hier bewahrt der "
     "Hausbesitzer wohl solche Dinge wie Werkzeuge und alte, nicht mehr "
     "brauchbare Einrichtungsgegenstaende auf. In einer Ecke siehst Du "
     "einen alten Schaukelstuhl und an einer Wand steht ein kleines "
     "Regal.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"vorratskeller"}),QueryProp(P_INT_LONG));
  AddDetail( ({"hausbesitzer", "besitzer"}),
    "Der alte Mann, den Du oben im Haus angetroffen hast.");
  AddDetail( ({"mann"}),
    "Er ist schon sehr alt.");
  AddDetail( ({"haus"}),
    "Das Haus befindet sich direkt ueber Dir.");
  AddDetail( ({"dinge"}),
    "Werkzeuge, alte Einrichtungsgegenstaende... solche Dinge halt.");
  AddDetail( ({"werkzeuge", "werkzeug"}),
    "Du siehst einen Hammer, eine Schachtel mit rostigen Naegeln, ein "
    "Brecheisen, eine Saege und einige andere Werkzeuge in dem Regal "
    "liegen.");
  AddDetail( ({"hammer"}),
    "Ein grosser schwerer Hammer liegt in dem Regal.");
  AddDetail( ({"schachtel"}),
    "Eine kleine Schachtel mit rostigen Naegeln.");
  AddDetail( ({"naegel"}),
    "Die Naegel sind teilweise schon verrostet, sehen aber "
    "groesstenteils noch ganz brauchbar aus.");
  AddDetail( ({"brecheisen"}),
    "Ein langes Brecheisen, das Dir vielleicht noch nuetzlich werden kann.");
  AddDetail( ({"saege"}),
    "Eine scharfe Saege, mit der sicherlich schon so manches Brett "
    "zerkleinert wurde.");
  AddDetail( ({"brett", "bretter"}),
    "So manches Brett ist schon der Saege zum Opfer gefallen.");
  AddDetail( ({"opfer"}),
    "Du gedenkst kurz der vielen Bretter, die dieser Saege schon zum "
    "Opfer gefallen sind.");
  AddDetail( ({"einrichtungsgegenstaende"}),
    "In diesem Vorratskeller werden nicht mehr gebrauchte "
    "Einrichtungsgegenstaende aufbewahrt.");
  AddDetail( ({"ecke"}),
    "In einer dunklen Ecke steht ein alter Schaukelstuhl.");
  AddSpecialDetail( ({"stuhl"}), "strstuhl");
  AddDetail( ({"holz"}),
    "Dunkles Eichenholz.");
  AddDetail( ({"eichenholz"}),
    "Das Holz stammt sicher von einer der Eichen hier im Sternenwald.");
  AddDetail( ({"eiche", "eichen"}),
    "Im Sternenwald gibt es einige Eichen. Zwar nicht sehr viele, aber "
    "es gibt sie.");
  AddDetail( ({"sternenwald","wald"}),
    "Sieh Dich dort mal genau um.");
  AddDetail( ({"bastbezug", "bezug"}),
    "Der Schaukelstuhl hat einen schoenen Bastbezug.");
  AddDetail( ({"boden"}),
    "Auf dem Boden unter dem Regal liegt eine kaputte Mausefalle. "
    "Ausserdem fallen Dir ein paar merkwuerdige Spuren auf.");
  AddDetail( ({"mausefalle"}),
    "Eine alte kaputte Mausefalle liegt unter dem Regal. Es befindet "
    "sich noch ein winziges Stueckchen Kaese darin.");
  AddDetail( ({"stueckchen"}),
    "Es ist wirklich nur ein winzig kleines Stueckchen.");
  AddDetail( ({"kaese"}),
    "Der Kaese sieht schon ziemlich alt aus und riecht auch nicht mehr "
    "besonders gut. Es hat schon jemand daran herumgeknabbert.");
  AddDetail( ({"jemand"}),
    "Oder etwas?");
  AddDetail( ({"etwas"}),
  "Vielleicht eine Ratte?");
  AddDetail( ({"spuren"}),
    "Die Spuren scheinen von Ratten zu stammen.");
  AddDetail( ({"ratte", "ratten"}),
    "Noch hast Du keine gesehen.");
  AddDetail( ({"decke"}),
    "Die Decke besteht aus schwarzem Vulkangestein.");
  AddDetail( ({"wand","waende"}),
    "Die Waende bestehen aus schwarzem Vulkangestein. In einer Wand "
    "faellt Dir direkt ueber dem Boden ein kleines Loch auf.");
  AddDetail( ({"gestein", "vulkangestein"}),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({"loch"}),
    "In dem Loch scheint sich etwas zu bewegen.");
  AddDetail( ({"regal"}),
    "In dem Regal liegen viele verschiedene Werkzeuge.");

  AddSpecialDetail( ({ "stuhl","schaukelstuhl" }), "strstuhl");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Kratzen.");
  AddSound( ({ "kratzen" }),
    "Du kannst nicht genau bestimmen, woher es kommt.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach altem Holz.");
  AddSmell( ({ "holz" }),
    "Neben dem Holzgeruch faellt Dir noch ein weiterer, unbestimmter "
    "Nebengeruch auf.");
  AddSmell( ({ "holzgeruch" }),
    "Holzig.");
  AddSmell( ({ "nebengeruch" }),
    "Es riecht nach altem Kaese.");
  AddSmell( ({ "kaese" }),
    "Meinst Du den Kaese in der Mausefalle oder Deine Socken?");
  AddSmell( ({ "mausefalle" }),
    "Riecht nach altem Gouda.");
  AddSmell( ({ "gouda" }),
    "Eigentlich weisst Du gar nicht, wie Gouda riecht.");
  AddSmell( ({ "socken" }),
    "Deine Socken mueffeln.");

  AddCmd( ({ "nimm" }), "cmdnehmen" );
  AddCmd( ({ "greif", "greife" }), "cmdgreifen" );
  AddCmd( ({ "schaukel", "schaukele", "schaukl" }), "cmdschaukel" );

  AddExit( "osten", "nach Osten#" +BRUNNEN );

}

// Funktion zum Festhalten von Gegnern
int paralyze (int zeit, object player)
{
  if (objectp(player))
     player->SetProp(P_TMP_MOVE_HOOK, ({time()+zeit, this_object(), "freeze_in_place"}) );
}

// Hilfsfunktion fuer Move_Hook
string freeze_in_place()
{
  return "Du schaukelst Doch noch!\n";
}


string strstuhl(string key)
{
  string stuhl_da, stuhl_weg;

  stuhl_da = "Der Schaukelstuhl ist aus dunklem Holz und hat einen "
            +"schoenen Bastbezug. Eigentlich sieht er noch ganz "
	    +"funktionstuechtig aus. Du wunderst Dich ein wenig, "
	    +"warum er hier unten steht und nicht mehr genutzt wird.\n";
  stuhl_weg = "Der Schaukelstuhl ist aus dunklem Holz und hat einen "
             +"schoenen Bastbezug. Leider ist er vollkommen kaputt.\n";

  if(stuhl == DA)
    return BS(stuhl_da);
  return BS(stuhl_weg);
}
// Auf dem defekten Stuhl schaukeln
int cmdschaukel(string str)
{
  mixed res;

  notify_fail("Auf was willst Du schaukeln?\n");
  if(str=="auf schaukelstuhl" || str=="auf stuhl" || str=="schaukelstuhl"
  || str=="stuhl")
  {
    if (besetzt == JA) {return write("Der Stuhl ist besetzt."),1;}
    if(stuhl == DA )
    {
      write(BS("Du schaukelst gemuetlich in dem Stuhl."));
      say(BS( PL->name()+" schaukelt in dem Schaukelstuhl."));
/*
// sonst rennt er noch weg :)
    TP->SetProp(P_PARALYZED, ([
      PARALYZE_TIME:2,
      PARALYZE_MSG:"Aber Du schaukelst doch gerade!\n",
      PARALYZE_MSG_OTHER:"%s schaukelt gerade im Schaukelstuhl.\n",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:""
    ]));
*/
      if (res=this_player()->QueryProp(P_TMP_MOVE_HOOK))
      {
        if ( pointerp(res) && sizeof(res) >= 3
             && intp(res[0]) && time() < res[0]
             && objectp(res[1]) && stringp(res[2]) )
       {
           // In diesem Fall sitzen wir gerade:
           if (res[1] == this_object())
           {
              notify_fail("Schaukelst doch schon!\n");
               return 0;
           }
           else
           {
              notify_fail("Irgendwie kannst Du Dich derzeit nicht bewegen!\n");
              return 0;
           }
        }
      }
      paralyze (5, this_player());

      call_out("zusammenbrechen",4);
      return 1;
      besetzt = JA;
    }
    else
    {
      write("Der Schaukelstuhl ist zu kaputt.\n");
      return 1;
    }
  }
  return 0;
}
void zusammenbrechen()
{
 write(BS("Ploetzlich bricht er mit einem lauten Krachen unter Dir zusammen.\n"
       +"Etwas schuldbewusst stehst Du wieder auf."));
 say(BS("Ploetzlich bricht der Stuhl unter "
      +(PL->QueryProp(P_GENDER)==MALE? "ihm":"ihr")+" zusammen.\n"
      +PL->name()+" steht etwas schuldbewusst "
      +"wieder auf.")) ;
      stuhl = WEG;
/* TP->SetProp(P_PARALYZED,0) gibt leider den unschoenen string aus das
// er sich wieder bewegen kann
    TP->SetProp(P_PARALYZED, ([
      PARALYZE_TIME:0,
      PARALYZE_MSG:"",
      PARALYZE_MSG_OTHER:"",
      PARALYZE_END:"",
      PARALYZE_END_OTHER:""
    ])); */

    this_player()->SetProp(P_TMP_MOVE_HOOK, 0);

}

// aufscheuchen der ratte aus dem loch in der wand
int cmdgreifen(string str)
{
  notify_fail("In was willst Du greifen?\n");
  if(str=="in loch")
  {
    if(ratte == DA)
    {
      write("Du greifst in das Loch und scheuchst eine Ratte auf.\n");
      say(BS(PL->name()+" greift in das Loch und scheucht eine Ratte auf."));
      AddItem( "/d/ebene/ronja/feenquest/npc/ratte", REFRESH_NONE);
      ratte = WEG;
      return 1;
    }
    else
    {
      write("Es ist nichts in dem Loch.\n");
      return 1;
    }
  }
  return 0;
}
// nehmen des brecheisens, wird spaeter in der Quest benoetigt
int cmdnehmen(string str)
{
  object mein_brecheisen;
  string s;

  notify_fail("Was willst Du nehmen?\n");

  if(!str || str=="") return 0;

    switch(str)
    {
      case "brecheisen" :
        if(brecheisen == WEG)
        {
          write(BS("Da war wohl wer schneller."));
          return -1;
        }

        mein_brecheisen=clone_object(BRECHEISEN);

        if(!mein_brecheisen)
        {
          write("Fehler");
	  return 0;
        }

        if(ME_TOO_HEAVY==mein_brecheisen->move(TP,M_GET|M_SILENT))
        {
          s = "Du kannst das Brecheisen nicht mehr tragen.";
          mein_brecheisen->remove();
        }
        else
        {
          s = "Du nimmst das Brecheisen.";
          brecheisen = WEG;
        }
        break;

      case "schachtel" :
      case "naegel" :
          s = "Solch verrostete Naegel willst Du nicht.";
        break;

      case "hammer" :
          s = "Der ist viel zu schwer fuer Dich.";
        break;

      case "saege" :
          s = "Das glaube ich nicht, Tim.";
        break;

      default :
        return 0;
    }
    write(BS(s));
    return 1;
}
reset()
{
  ::reset();
  stuhl = DA;
  brecheisen = DA;
  ratte = DA;
}
