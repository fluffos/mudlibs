inherit "std/room";

#include <language.h>
#include "../def.h"

#define TREPPE "./treppe"
#define VORRATSKELLER "./vorratskeller"
#define WEINKELLER "./weinkeller"
#define SPEISEKAMMER "./speisekammer"
#define VOLL 1
#define LEER 0
#define OBEN 1
#define UNTEN 0
#define JA 1
#define NEIN 0

int anzahl, echse, wasser, eimer, unterwegs;
object myechse;

create()
{
  ::create();

  eimer = UNTEN;
  echse = JA;
  unterwegs = NEIN;
  wasser = VOLL;
  anzahl = 2;

  SetProp( P_INT_SHORT, "Brunnen im Keller" );
  SetProp( P_INT_LONG,
     "Du stehst mitten im Keller auf einer Art Kreuzung. Ausser dem "
     "Brunnen in der Mitte des Raumes gibt es hier nicht sehr viel zu "
     "sehen. Es fuehren vier schmale Gaenge von hier weiter nach Norden, "
     "Sueden, Osten und Westen.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"keller"}),
    "Du befindest Dich in der Mitte des Kellers.");
  AddDetail( ({"art"}),
    "Man koennte auch sagen, es handelt sich um eine richtige Kreuzung. "
    "Vier Gaenge fuehren von hier weiter nach Norden, Sueden, Osten und "
    "Westen.");
  AddDetail( ({"kreuzung"}),
    "Zwei Gaenge treffen aufeinander - kniet mit mir, dasselbe Glueck zu "
    "preisen.");
  AddDetail( ({"glueck"}),
    "Glueck kann man immer gebrauchen.");
  AddSpecialDetail( ({"brunnen"}), "strbrunnen");
  AddSpecialDetail( ({"rand", "brunnenrand"}), "strrand");
  AddDetail( ({"mitte"}),
    "In der Mitte des Raumes siehst Du einen Brunnen.");
  AddDetail( ({"raum"}), QueryProp(P_INT_LONG));
  AddDetail( ({"gaenge", "gang"}),
    "Ein Gang fuehrt von Sueden nach Norden, der andere von Osten nach "
    "Westen. Oder auch umgekehrt, je nachdem.");
  AddDetail( ({"norden"}),
    "Wenn Du weiter nach Norden gehst, gelangst Du in den Weinkeller.");
  AddDetail( ({"weinkeller"}),
    "Der Weinkeller liegt im Norden.");
  AddDetail( ({"sueden"}),
    "Im Sueden kannst Du den Keller wieder verlassen.");
  AddDetail( ({"osten"}),
    "Der Gang im Osten fuehrt in die Speisekammer.");
  AddDetail( ({"speisekammer"}),
    "Die Speisekammer befindet sich im Osten.");
  AddDetail( ({"westen"}),
    "Im Westen liegt der Vorratskeller.");
  AddDetail( ({"vorratskeller"}),
    "Der Vorratskeller liegt westlich von Dir.");
  AddDetail( ({"boden"}),
    "Der Boden besteht wie die Waende aus schwarzem Vulkangestein.");
  AddDetail( ({"decke"}),
    "Die Decke sieht hier nicht mehr ganz so hoch aus wie unten an der "
    "Treppe, dennoch bist Du Dir nicht sicher, ob Du sie mit den Fingern "
    "beruehren kannst.");
  AddDetail( ({"treppe"}),
    "Ueber die Treppe im Sueden kannst Du den Keller wieder verlassen.");
  AddDetail( ({"finger"}),
    ([0: "Du schaust auf Deine Finger und denkst . o O (Meine Fingernaegel "
         "muessen mal wieder geschnitten werden.)",
      "oger": "Du schaust auf Deine Finger und denkst . o O (Meine Klauen sind schon "
         "ganz schoen lang.)",
      "troll": "Du schaust auf Deine Finger und denkst . o O (Meine Klauen sind schon "
         "ganz schoen lang.)" ]) );

  AddDetail( ({"fingernaegel", "naegel"}),
    ([0: "Du greifst in Deine Tasche, bemerkst aber zu Deinem Entsetzen, "
         "dass Du wieder einmal keine Nagelschere dabei hast.",
      "zwerg": "Du betrachtest Deine harten Fingernaegel.\n"
              +"Du denkst  . o O (Gut zum Graben.)"]) );
  AddDetail( ({"klauen", "klaue"}),
      ([ "oger": "Du starrst auf Deine langen, dreckigen Klauen und grunzt.",
         "troll": "Du starrst auf Deine langen, dreckigen Klauen und grunzt." ]) );

  AddDetail( ({"wand", "waende"}),
    "Die Waende bestehen hier unten komplett aus schwarzem "
    "Vulkangestein.");
  AddDetail( ({"gestein", "vulkangestein"}),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({"stein"}),
    "Der Stein hier ist durch die Feuchtigkeit schon etwas verwittert.");
  AddDetail( ({"feuchtigkeit"}),
    "Durch die leichte Feuchtigkeit, die hier herrscht, ist der Stein "
    "schon etwas verwittert. Ein wenig Moos hat sich am Brunnenrand "
    "abgesetzt.");
  AddDetail( ({"moos"}),
    "Der Brunnenrand ist mit weichem gruenem Moos ueberzogen.");
  AddDetail( ({"wasser"}),
    "Der Brunnen ist bis zum Rand hin mit Wasser gefuellt. Du kannst den "
    "Grund nicht mehr erkennen, so dunkel erscheint das Wasser durch die "
    "schwarzen Steinwaende. Du blickst in eine bodenlose Tiefe hinab. "
    "Ploetzlich glaubst Du, etwas glitzern zu sehen.\n");
  AddDetail( ({"grund"}),
    "Du kannst den Grund nicht erkennen.");
  AddDetail( ({"tiefe"}),
    "Du starrst in die Tiefe. Dir wird etwas schwummerig vor Augen.");
  AddDetail( ({"augen"}),
    "Dir wird schwarz vor Augen.");
  AddDetail( ({"steinwaende"}),
    "Durch die schwarzen Steinwaende wirkt das Wasser sehr dunkel.");
  AddDetail( ({"holzgestell", "gestell"}),
    "Ein einfaches Holzgestell.");
  AddDetail( ({"holz"}),
    "Das Holz stammt wohl aus dem Sternenwald.");
  AddDetail( ({"sternenwald", "wald"}),
    "Der Sternenwald liegt in der Unterwelt.");
  AddDetail( ({"unterwelt", "uwelt"}),
    "Da befindest Du Dich gerade.");
  AddDetail( ({"seil"}),
    "An dem Holzgestell wurde ein Seil befestigt, an dem Du den Eimer "
    "hinab- und wieder herauflassen kannst.");
  AddDetail( ({"nase"}),
    "Die benutzt Du zum riechen.");
  AddDetail( ({"gefuehl"}),
    "Du denkst   . o O (Ich glaub ich steh im Wald.)");
  AddSpecialDetail( ({"eimer"}), "streimer");

  AddSpecialDetail( ({"etwas", "glitzern"}), "strglitzern");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Plaetschern vom Brunnen.");
  AddSound( ({ "brunnen" }),
    "Das Wasser im Brunnen plaetschert leise vor sich hin.");
  AddSound( ({ "wasser" }),
    "*plitsch* *platsch*");
  AddSound( ({ "plaetschern" }),
    "*plaetscher*");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig modrig.");
  AddSmell( ({ "moder"}),
    "Es scheint vom Brunnen zu kommen.");
  AddSmell( ({ "brunnen" }),
    "Das Moos duftet angenehm. Ausserdem dringt ein leichter "
    "Modergeruch an Deine Nase.");
  AddSmell( ({ "moos" }),
    "Du hast fast das Gefuehl, im Wald zu stehen.");
  AddSmell( ({ "modergeruch","geruch" }),
    "Weniger angenehm.");

  AddCmd( ({ "knie", "kniee" }), "cmdknie" );
  AddCmd( ({ "beruehre", "beruehr" }), "cmdberuehre" );
  AddCmd( ({ "greif", "greife" }), "cmdgreife" );
  AddCmd( ({ "lass", "lasse" }), "cmdlasse" );
  AddCmd( ({ "spring", "springe" }), "cmdspringe" );
  AddCmd( ({ "trinke", "trink" }), "cmdtrinken" );

  AddExit( "westen", "nach Westen#" +VORRATSKELLER );
  AddExit( "norden", "nach Norden#" +WEINKELLER );
  AddExit( "sueden", "nach Sueden#" +TREPPE );
  AddExit( "osten", "nach Osten#" +SPEISEKAMMER );
}
// noch zu bearbeiten
int cmdgreife(string str)
{
  notify_fail( "Wonach willst Du greifen?\n" );
  if(str=="nach glitzern" || str =="in brunnen" || str == "glitzern")
  {
    if(echse == JA)
    {
      write("Du greifst in den Brunnen.\n");
      say( PL->name()+" greift in den Brunnen.\n");
      myechse = AddItem( NPC "brunnenechse" , REFRESH_NONE);
      echse = NEIN;
      return 1;
    }
  }
  return 0;
}

int cmdknie(string str)
{
  notify_fail( "Was willst Du tun?\n" );
  if(!str || str=="")
  {
    write("Du kniest kurz nieder und preist Dein Glueck.\n");
    say( PL->name()+" kniet kurz nieder und preist "
    +(PL->QueryProp(P_GENDER)==MALE?"sein":"ihr")+" Glueck.\n");
    return 1;
  }
  return 0;
}

int cmdspringe(string str)
{
  notify_fail( "Wohin willst du springen?\n" );
  if(str=="in brunnen" || str =="brunnen" || str == "in wasser")
  {
    write(BS("Du kletterst wagemutig auf den Rand des Brunnens, besinnst Dich "
         +"angesichts der bodenlosen Tiefe unter Dir jedoch eines Besseren "
	 +"und steigst mit wackligen Knien wieder hinunter.") );
    say(BS( PL->name()+" klettert auf den Rand des Brunnens, starrt eine Weile"
         +" ins Wasser und steigt dann mit bleichem Gesicht wieder hinunter.") );
    return 1;
  }
  return 0;
}

int cmdberuehre(string str)
{
  string race, s;
  race = PL->QueryProp(P_RACE);

  notify_fail("Was willst Du beruehren?\n");

  if(str == "decke" )
  {
    switch(race)
    {
      case "Dunkelelf" :
      case "Elf" :
      case "Untoter":
        s = "Du stellst Dich auf die Zehenspitzen und kannst "
           +"die Decke gerade eben mit den Fingerspitzen beruehren.";
	break;
      case "Hobbit" :
      case "Zwerg" :
        s = "Keine Chance, dazu bist Du viel zu klein geraten!";
	break;
      case "Mensch" :
        s = "Du stellst Dich auf die Zehenspitzen und reckst und "
           +"streckst Dich, kannst die Decke aber leider nicht "
	   +"ganz erreichen.";
	break;
      case "Troll" :
      case "Oger" :
        s = "Problemlos presst Du beide Handflaechen an die Decke "
           +"und stoesst dabei fast mit dem Kopf an.";
	break;
      case "Fee" :
        s = "Du denkst . o O (Wozu habe ich Fluegel?)\n"
	   +"Mit herablassendem Blick flatterst Du an die Decke, legst "
	   +"Deine zarten Feenhaende kurz auf die rauhe Oberflaeche und "
	   +"gleitest sanft wieder zu Boden.";
	break;
      default :
        s = "Was fuer eine Rasse bist Du denn? Sollte Torian Deine Rasse "
	   +"tatsaechlich uebersehen haben, wende Dich doch bitte kurz an ihn.";
        break;
    }
    write(BS(s));
    return 1;
  }
  return 0;
}

string streimer(string str)
{
  return (eimer == UNTEN) ? BS("Der Eimer ist nicht zu sehen. Vermutlich wurde "
                             +"er bereits heruntergelassen.") :
                              "Ein kleiner Eimer steht auf dem Brunnenrand.\n";
}

string strbrunnen(string str)
{
  string s;
  string rand;

  s = "Mitten auf der Kreuzung steht ein Brunnen aus verwittertem dunklem "
     +"Stein. Er ist bis zum Rand hin mit Wasser gefuellt. Ueber dem "
     +"Brunnen ist ein Gestell aus Holz angebracht, an dem ein Seil "
     +"befestigt wurde.";
  rand = "Auf dem Brunnenrand steht ein kleiner Eimer.";
  if (eimer == OBEN)
    return BS(s+" "+rand);
  return BS(s);
}

string strrand(string str)
{
  string s;
  string rand;

  s = "Der Brunnenrand ist mit weichem gruenem Moos ueberzogen.";
  rand = "Ein kleiner Eimer befindet sich auf dem Rand.";
  if (eimer == OBEN)
    return BS(s+" "+rand);
  return BS(s);
}

string strglitzern(string str)
{
  return (echse == JA) ? BS("Tatsaechlich, irgendetwas glitzert dort unten "
                        +"im Wasser. Aber in unbekannte Gewaesser soll man "
			+"bekanntlich nicht grei... aeh... springen, oder?"):
                         "Du hast Dich wohl doch geirrt.\n";
}

// Beim Pala-Brunnen geschaut was fuer strings kamen :)

int cmdlasse(string str) {
  notify_fail("Der Eimer ist noch unterwegs!\n");
  if (unterwegs==JA) return 0;
  notify_fail("Was willst Du genau machen?\n");
  if (str== "eimer hinab")
  {
    if (eimer==UNTEN)
    {
      write("Aber der Eimer ist doch schon unten.\n");
      return 1;
    }
    if (wasser==VOLL)
    {
      write("Wozu den Eimer hinablassen, wenn er schon voller Wasser ist?\n");
      return 1;
    }
    write(BS("Du betaetigst die Vorrichtung und der Eimer gleitet langsam "
             "nach unten."));
    say(BS(PL->name()+" laesst den Eimer langsam hinab."));
    unterwegs=JA;
    call_out("runter",3);
    return 1;
  }
  if (str== "eimer hinauf" || str == "eimer herauf")
  {
    if (echse == JA)
    {
      write("Irgendetwas blockiert den Eimer.\n");
      return 1;
    }
    if (eimer==OBEN)
    {
      write("Aber der Eimer ist doch schon oben.\n");
      return 1;
    }
    write(BS("Du betaetigst die Vorrichtung und der Eimer gleitet langsam "
             "nach oben."));
    say(BS(PL->name()+" holt den Eimer langsam rauf."));
    unterwegs=JA;
    call_out("rauf",3);
    return 1;
  }
  return 0;
}

int cmdtrinken(string str) {
  notify_fail("Was willst Du trinken?\n");
  if (str == "wasser" || str == "wasser aus eimer")
  {
    if (unterwegs==JA)
    {
      write(BS("Aber der Eimer ist doch noch unterwegs!\n"));
      return 1;
    }
    if (eimer==UNTEN)
    {
      write(BS("Aber der Eimer ist doch viel zu weit unten!\n"));
      return 1;
    }
    if (wasser==LEER)
    {
      write(BS("Aber der Eimer ist doch leer!\n"));
      return 1;
    }
    wasser=LEER;
    PL->heal_self(20+random(20)); // LP + MP auffuellen
    write(BS("Du trinkst das Wasser und fuehlst Dich sofort erfrischt "
             "und sogar gestaerkt."));
    say(BS(PL->name()+" trinkt das Wasser und sieht gestaerkt aus."));
  return 1;
  }
  return 0;
}

void runter() {
  tell_room(this_object(), BS("Der Eimer platscht in das Wasser und "
                           +"fuellt sich.\n"));
  call_out("unten",3);
// unterwegs == NEIN -> raufholen ohne fuellen nicht moeglich
}

void unten() {
  tell_room(this_object(), BS("Mit einem lauten Glucksen hat sich der "
                           +"Eimer jetzt mit Wasser gefuellt.\n"));
  unterwegs=NEIN;
  eimer = UNTEN;
  wasser=VOLL;
}

void rauf() {
  tell_room(this_object(), BS("Der Eimer gleitet weiter nach oben.\n"));
  call_out("oben",3);
}

void oben() {
  tell_room(this_object(), BS("Der Eimer ist jetzt ganz oben angekommen.\n"));
  unterwegs=NEIN;
  eimer = OBEN;
  anzahl--;
  if (anzahl < 0)
  {
    wasser=LEER;
    tell_room(this_object(), BS("Leider ist auf dem Weg nach oben das "
                             +"ganze Wasser entwichen.\n"));
  }
}

reset()
{
  ::reset();

  myechse = present("brunnenechse");

  if( myechse )
  {
    if (eimer == OBEN)
    {
    tell_room(this_object(), BS("Die Brunnenechse zieht sich wieder in den "
                            +"in den Brunnen zurueck und stoesst dabei den "
                            +"Eimer an. Mit einem lauten *Platsch* faellt er "
                            +"in den Brunnen hinein.") );
    }
    else
    tell_room(this_object(), "Die Brunnenechse zieht sich wieder in den "
                            +"Brunnen zurueck.\n");
    myechse->remove();
  }
  else
  if(eimer == OBEN)
    tell_room(this_object(), "Ploetzlich beginnt der Eimer zu wackeln. "
                            +"Mit einem lauten *Platsch* faellt er in den "
			    +"Brunnen hinein.\n");

  eimer = UNTEN;
  echse = JA;
  anzahl = 2;
}
