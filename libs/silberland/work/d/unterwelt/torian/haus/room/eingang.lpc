inherit "std/room";

#include "../def.h"

#define WOHNZIMMER ROOM "wohnzimmer"
#define ESSZIMMER ROOM "esszimmer"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Eingangsbereich" );
  SetProp( P_INT_LONG,
     "Vorsichtig betrittst Du das Haus und stehst mitten in einem "
     "kleinen, dunklen Hausflur. Die Eingangstuer knarrt ein wenig und "
     "gibt Dir ein unsicheres Gefuehl. Durch die beiden Tueren im Norden "
     "und Westen faellt etwas Licht in den Raum, so dass Du den "
     "Kleiderstaender im Osten und direkt daneben einen kleinen Spiegel "
     "ausmachen kannst.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "haus", "eingangsbereich"}),
    "Du befindest dich im Eingangsbereich des Hauses.");
  AddDetail( ({ "hausflur", "flur", "licht"}),
    "Es faellt nur ein wenig Licht durch die beiden Tueren im Norden und "
    "Westen in den ansonsten recht duesteren Hausflur hinein.");
  AddDetail( ({ "kleiderstaender", "staender"}),
    "Der Kleiderstaender ist bestimmt schon so alt wie das Haus. Ein "
    "recht schwer aussehender Mantel haengt an einem der Haken.");
  AddDetail( ({"mantel"}),
    "Ein ziemlich schwerer, wetterfester Mantel aus festem Leder haengt "
    "an dem Haken. Ploetzlich faellt Dir auch noch ein Schal auf, der wohl "
    "heruntergefallen ist und nun auf dem Boden liegt.");
  AddDetail( ({"schal"}),
    "Der Schal ist wohl von einem der Haken gefallen und bisher nicht "
    "wieder aufgehangen worden.");
  AddDetail( ({"haken"}),
    "An dem Haken haengt ein schwerer Mantel aus festem Leder.");
  AddDetail( ({"leder"}),
    "Das Leder scheint einen guten Schutz gegen Kaelte zu bieten.");
  AddDetail( ({"schutz"}),
    "Das Leder scheint sehr gut vor Kaelte zu schuetzen.");
  AddDetail( ({"kaelte"}),
    "Je aelter man wird, desto mehr muss man sich vor der Kaelte schuetzen.");
  AddDetail( ({"spiegel"}),
    "Vergeblich versuchst Du, Dich in dem Spiegel zu betrachten, doch Du "
    "kannst leider nichts mehr in ihm erkennen, da er in all den Jahren "
    "schon voellig blind geworden ist.");
  AddDetail( ({"boden", "holzfussboden", "fussboden"}),
    "Auf dem Holzfussboden liegt ein alter loechriger und schon ziemlich "
    "zertretener Teppich. Du kannst gerade noch einen Schriftzug auf ihm "
    "erkennen. ");
  AddDetail( ({"teppich"}),
    "Ein alter, zerfranster Teppich. Du kannst ja mal versuchen, die "
    "Schriftzuege zu lesen. ");
  AddDetail( ({ "schriftzuege", "schriftzug"}),
    "Probiers mal mit lesen.");
  AddDetail( ({ "tuer", "eingangstuer", "eingang"}) ,
    "Die knarrenden Geraeusche der Eingangstuer geben Dir ein unsicheres "
    "Gefuehl. Obwohl sie schon etliche Jahre auf dem Buckel hat, sieht die Tuer "
    "immer noch stabil genug aus, um unerwuenschte Eindringlinge "
    "fernzuhalten.");
  AddDetail( ({"buckel"}),
    "Die Tuer sieht genauso alt aus wie alles andere hier im Haus.");
  AddDetail( ({ "eindringlinge", "eindringling", "besucher"}),
    "In der Unterwelt gibt es viele unerwuenschte Besucher.");
  AddDetail( ({"unterwelt"}),
    "Du befindest Dich irgendwo mitten in der Unterwelt.");
  AddDetail( ({"geraeusche"}),
    "Geraeusche kann man nicht sehen, nur hoeren.");
  AddDetail( ({"gefuehl"}),
    "Das unheimliche Knarren der Tuer laesst Dir kalte Schauer ueber den "
    "Ruecken laufen.");
  AddDetail( ({"schauer"}),
    "Du froestelst.");
  AddDetail( ({"ruecken"}),
    "Dir laeuft ein kalter Schauer nach dem anderen ueber den Ruecken.");
  AddDetail( ({"tueren"}),
    "Die Tuer im Norden scheint in ein Esszimmer zu fuehren. "
    "Hinter der westlichen Tuer kannst Du nicht viel erkennen. Am "
    "besten, Du siehst einfach einmal nach, was sich dort befindet.");
  AddDetail( ({"esszimmer"}),
    "Das Esszimmer befindet sich im Norden.");
  AddDetail( ({"norden"}),
    "Im Norden befindet sich das Esszimmer." );
  AddDetail( ({"holz"}),
    "Das Holz scheint direkt aus dem Sternenwald zu stammen.");
  AddDetail( ({ "sternenwald", "ort", "wald"}),
    "Der Sternenwald ist ein mystischer Ort voller tiefer Geheimnisse und "
    "wunderbarer Wesen.");
  AddDetail( ({"wesen"}),
    "Wunderbare Wesen kannst Du in diesem Wald antreffen.");
  AddDetail( ({"geheimnisse"}),
    "Das musst Du schon selber herausfinden ...");
  AddDetail( ({"jahre", "alter"}),
    "Das Haus ist schon so alt, dass sich niemand die Muehe gemacht hat, "
    "die Jahre zu zaehlen.");
  AddDetail( ({"muehe"}),
    "Niemand hat sich die Muehe gemacht.");
  AddDetail( ({"niemand"}),
    "Nein, wirklich niemand.");
  AddDetail( ({ "augen", "auge"}),
    "Du kneifst Deine Augen fest zusammen. Pass lieber auf, sonst kriegst "
    "Du noch Falten!");
  AddDetail( ({ "falten", "falte"}),
    "Huch, da ist ja schon eine!");
  AddDetail( ({"westen"}),
    "Hinter der Tuer im Westen kannst Du nichts genaueres erkennen." );
  AddDetail( ({ "wand", "waende"}),
    "Es fuehren zwei Tueren im Norden und Westen in das Esszimmer sowie "
    "in einen weiteren Raum, von dem Du jedoch von hier aus noch nicht sehr "
    "viel erkennen kannst. An der Ostseite befinden sich ein Kleiderstaender "
    "und ein Spiegel. Im Sueden kannst du das Haus wieder verlassen.");
  AddDetail( ({"raum"}),
    "Du kannst von hier aus leider nicht mehr erkennen.");
  AddDetail( ({"ostseite", "osten"}),
    "An der Ostseite siehst Du einen Kleiderstaender und einen Spiegel.");
  AddDetail( ({"sueden"}),
    "Im Sueden kannst Du das Haus wieder verlassen.");
  AddDetail( ({"decke"}),
    "Die Decke besteht aus einfachen Holzbohlen.");
  AddDetail( ({"bohlen", "holzbohlen"}),
    "Einfache schlichte Holzbohlen.");
  AddDetail( ({"atmosphaere"}),
    "Durch den leichten Holzgeruch wirkt der Raum trotz seines nicht zu "
    "uebersehenden Alters recht gemuetlich.");
  AddDetail( ({"windzug"}),
    "Ab und zu kommt ein leichter Windzug durch die Tuer.");

  AddReadDetail( ({ "schriftzug", "schriftzuege" }),
    "Du kneifst Deine Augen zusammen und kannst die Worte \"Willkommen in "
    "meinem Heim\" erkennen.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein unheimliches Knarren von der Eingangstuer. ");
  AddSound( ({ "knarren", "tuer" }),
    "Irgendwie unheimlich... Aber schliesslich ist es ja nur eine "
    "knarrende Tuer. Oder?");
  AddSmell( DEFAULT_SMELL,
    "Das Holz verstroemt einen angenehmen Duft.");
  AddSmell( ({ "duft" }),
    "Der Duft verleiht dem Haus eine angenehme Atmosphaere.");
  AddSmell( ({ "holz", "holzgeruch" }),
    "Das Holz verstroemt einen angenehmen Duft.");

  AddCmd( ({ "haenge", "haeng" }), "cmdhaenge" );

  AddExit( "sueden", "raus#" + "/d/unterwelt/ronja/sternenwald/room/fr_05_08");
  AddExit( "westen", "ins Wohnzimmer#" + WOHNZIMMER );
  AddExit( "norden", "ins Esszimmer#" + ESSZIMMER );
}

int cmdhaenge(string str)
{
  notify_fail( "Was willst Du aufhaengen?\n" );
  if( str == "schal auf" || str == "schal auf haken" )
  {
    write(BS("Vorsichtig haengst Du den Schal wieder auf, doch ploetzlich "
            +"weht ein leichter Windzug durch die Tuer und er "
            +"faellt wieder herunter."));
    say(BS( PL->name()+" hebt den Schal auf, doch ploetzlich weht ein leichter "
       +"Windzug durch die Tuer und er faellt wieder herunter."));
    return 1;
  }
  return 0;
}
