inherit "std/room";

#include <language.h>
#include "../def.h"

#define BRUNNEN ROOM "brunnen"
#define KELLER "/d/unterwelt/torian/keller/room/raumF3"
#define DA 1
#define WEG 0

int kristall, gesicht, ausgang;
string geheimwort;

create()
{
  kristall = DA;
  gesicht =  WEG;
  ausgang = WEG;
  geheimwort = geheimwortfkt();
  
  ::create();

  SetProp( P_INT_SHORT, "Im Weinkeller" );
  SetProp( P_INT_LONG,
     "Du stehst mitten in einem grossen Weinkeller. An den Waenden sind "
     "einige Weinfaesser aus dunklem Eichenholz aufgereiht und in einer "
     "Ecke siehst Du ein kleines Weinregal, in dem die Weine in Flaschen "
     "gelagert werden.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({"weinkeller"}),
    "Dies hier ist der Weinkeller des Hauses.");
  AddDetail( ({"haus"}),
    "Du befindest Dich im Weinkeller des Hauses.");
  AddDetail( ({"weinfaesser", "faesser"}),
    "Die Weinfaesser sind aus dunklem Eichenholz und sehen sehr schwer "
    "aus. Auf jedem der Faesser ist vorne in grosser Blockschrift der "
    "Name des Weines aufgedruckt, der dort gelagert wird. Hinter einem "
    "Weinfass faellt Dir etwas auf.");
  AddDetail( ({"etwas"}),
    "Um zu sehen, was sich dort befindet, musst Du schon hinter das "
    "Weinfass schauen.");
  AddDetail( ({"eichenholz"}),
    "Weinfaesser werden haeufig aus qualitativ hochwertigem Eichenholz "
    "gefertigt.");
  AddDetail( ({"blockschrift"}),
    "Auf jedem der Faesser steht in grosser Blockschrift der Name des "
    "darin gelagerten Weines.");
  AddDetail( ({"name"}),
    "Besonders oft liest Du den Namen 'Roter Derlimer'.");
  AddDetail( ({"derlimer", "roter", "roter derlimer"}),
    "Der rote Derlimer ist der beruehmte Wein aus Derlim.");
  AddDetail( ({"derlim"}),
    "Derlim ist die Hauptstadt der Hobbits.");
  AddDetail( ({"hauptstadt"}),
    "Die Hauptstadt der Hobbits heisst Derlim.");
  AddDetail( ({"hobbit", "hobbits"}),
    ([0: "Du bist keiner.",
      "hobbit": "Du bist einer."]) );
  AddDetail( ({"wein", "weine"}),
    "Der Wein wird hier in Faessern und Flaschen gelagert.");
  AddDetail( ({"kristall"}),
    "Der Kristall pulsiert und leuchtet schwach. Du spuerst ein grosses "
    "Verlangen danach, ihn zu beruehren.");
  AddDetail( ({"verlangen"}),
    "Los, beruehre ihn!");
  AddDetail( ({"ecke"}),
    "In einer Ecke steht ein kleines Weinregal.");
  AddDetail( ({"weinfass", "fass"}),
    "Irgendetwas ist dort.");
  AddDetail( ({"weinregal", "regal"}),
    "In dem Weinregal liegen einige Flaschen mit erlesenen Weinen.");
  AddDetail( ({"flaschen"}),
    "Nach langer Reifezeit wird der Wein aus den Faessern in Flaschen "
    "umgefuellt.");
  AddDetail( ({"reifezeit"}),
    "Viele Weine benoetigen eine lange Reifezeit, um ihren "
    "Geschmack voll zu entfalten.");
  AddDetail( ({"geschmack"}),
    "Jeder Wein schmeckt anders.");
  AddDetail( ({"boden"}),
    "Der Boden besteht aus schwarzem Vulkangestein.");
  AddDetail( ({"decke"}),
    "Der Decke besteht aus schwarzem Vulkangestein.");
  AddDetail( ({"gestein", "vulkangestein"}),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({"waende", "wand"}),
    "An den Waenden sind einige Weinfaesser aus dunklem Eichenholz aufgereiht.");

  AddSpecialDetail( ({"westwand",
                      "lippen", "steinlippen",
                      "nase", "steinnase",
                      "augen", "steinaugen",
                      "gesicht",
                      "blick",}), "strwestwand");

  AddSound( DEFAULT_SOUND,
    "Es ist sehr still.");
  AddSound( ({ "stille", "still" }),
    "Du hoerst nichts.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach Wein und von den Weinfaessern geht ein "
    "leichter Holzgeruch aus.");
  AddSmell( ({ "wein" }),
    "Du bist zwar kein echter Weinkenner, aber es riecht nicht unangenehm.");
  AddSmell( ({ "weinkenner" }),
    "Bist Du doch einer?");
  AddSmell( ({ "weinfaesser", "weinfass" }),
    "Von den Weinfaessern geht ein leichter Holzgeruch aus.");
  AddSmell( ({ "holzgeruch", "geruch" }),
    "Eichenholz hat einen leicht saeuerlichen Geruch.");
  AddSmell( ({ "eichenholz", "holz" }),
    "Saeuerlich.");
    
  AddCmd( ({ "schau", "schaue" }), "cmdschaue" );
  AddCmd( ({ "beruehre", "beruehr" }), "cmdberuehre" );

  AddExit( "sueden", "nach Sueden#" +BRUNNEN );
}

int cmdschaue(string str)
{
  notify_fail( "Hinter was willst Du schauen?\n" );
  if(str=="hinter fass" || str == "hinter weinfass") 
  {
    write(BS("Ein sonderbarer Kristall befindet sich an der Wand hinter "
            +"dem Weinfass.") );
    return 1;	    
  }
  return 0;
}

int cmdberuehre(string str)
{
  string s;
  notify_fail("Was willst Du beruehren?\n");
  if(str == "kristall" )
  {
    if (kristall == DA)
    {
      write(BS("Als Du den Kristall beruehrst, leuchtet er in einem "
              +"strahlend weissen Licht auf.") );
      say(BS("Als "+PL->name()+" den Kristall beruehrt, leuchtet er in einem "
            +"strahlend weissen Licht auf."));
      kristall = WEG;
      call_out("leuchten",6);
      return 1;
    }
    else
    {
      write(BS("Du beruehrst den Kristall, doch nichts passiert."));
      return 1;
    }
  }
  return 0;
}

void leuchten() {
  tell_room(this_object(), BS("Das Leuchten erlischt wieder und alles "
                             +"scheint wie vorher."));
  call_out("westwand",6);
}

void westwand() {
  tell_room(this_object(), BS("Ploetzlich bemerkst Du, dass sich etwas an "
                             +"der Westwand geaendert hat."));
  gesicht = DA;
  AddCmd( ({"verrate", "verrat"}), "cmdverrate" );
  AddSound( ({ "lippen" }),
  "Eine leise Stimme fluestert in Dein Ohr: Verrate mir das geheime "
  "Wort und ich werde Dir auf Deinem Wege weiterhelfen.");
}

string strwestwand(string key)
{
  string s;

  if(gesicht == WEG || ausgang == DA) return "Du siehst nichts besonderes.\n";

  switch(key)
  {
    case "westwand" :
      s = "Du wirfst einen schnellen Blick auf die Westwand und erschrickst. "
         +"Ein grosses steinernes Gesicht starrt Dich aus der Wand heraus an. ";
      break;
    case "blick" :
      s = "Du erblickst ein grosses steinernes Gesicht, das Dich aus der Wand "
         +"heraus anstarrt.";
      break;
    case "gesicht" :
      s = "Aus der Wand hat sich ein grosses steinernes Gesicht geformt, das "
         +"Dich aus blicklosen Steinaugen anstarrt. Du siehst eine grosse "
         +"steinerne Nase und steinerne Lippen, die sich lautlos zu bewegen "
         +"scheinen.";
      break;
    case "steinaugen" :
    case "augen" :
      s = "Die kalten Steinaugen mustern Dich gleichgueltig.";
      break;
    case "nase" :
    case "steinnase" :
      s = "Eine grosse steinerne Nase sitzt mitten in dem Gesicht.";
      break;
    case "lippen" :
    case "steinlippen" :
      s = "Die steinernen Lippen scheinen sich lautlos zu bewegen, als "
         +"wollten sie Dir etwas sagen. Vielleicht solltest Du mal dran "
	 +"lauschen?";
      break;
    default :
      s = "Sowas siehst Du hier nicht.";
      break;
  }
  return BS(s);
}

string QueryWort()
{
// uebergeben des geheimwortes an Mabruk
  return geheimwort;
}
string geheimwortfkt()
{
  mixed geheimwoerter;
// noch ausbaubar
  geheimwoerter = ({ "Magie","Jetzt","Leben","Keller","Schlag","Wein","Bett"
                    ,"Baer","Drache","Greif" });
  return geheimwoerter[random(sizeof(geheimwoerter)-1)]; 
}
// spaeter mit dem ausgewuerfelten wert
int cmdverrate(string str)
{
  notify_fail( "Nichts passiert!\n" );
  
  if(!str || str == "") return 0;

  if ( (sscanf(str,"gesicht %s",str) == 1) ||
       (sscanf(str,"steingesicht %s",str) ==1) ||
       (sscanf(str,"%s",str) == 1))
  {
//    DB(TP->Name()+" verraet: "+str+"\nWas == "+str+"\n");

    if(str==lower_case(geheimwort))
    {
      write("Das Steingesicht sagt: Nun gut, Dir sei der Weg eroeffnet. Sei "
           +"vorsichtig auf\n"
           +"Das Steingesicht sagt: Deinem weiteren Weg.\n"
           +"Daraufhin verschwindet das Gesicht und gibt den Weg nach Westen "
           +"frei.\n");
      say(BS(PL->Name()+" murmelt etwas und die westliche Wand verschwindet."));
      ausgang = DA;
      RemoveCmd(({"verrate", "verrat"}));
      AddExit( "westunten", "nach Westunten#" +KELLER );
      AddExit( "westen", "nach Westunten#" +KELLER );
      SetProp(P_HIDE_EXITS, ({ "westen" }));
      return 1;	    
    }
  }
  return 0;
}

reset()
{
  ::reset();
  if(ausgang == DA)
  {
    tell_room(this_object(), "Die Westwand wird wieder sichtbar.\n");
    RemoveExit("westen");
    RemoveExit("westunten");
  }
  if(gesicht == DA && ausgang == WEG)
  {
  	tell_room(this_object(), "Das Steingesicht verschwindet wieder "
                            +"spurlos.\n");
    RemoveCmd(({"verrate", "verrat"}));
  }
  
  RemoveSound( ({ "lippen" }));
  
// Pro Reset neues Wort
  geheimwort = geheimwortfkt();
  gesicht = WEG;
  kristall = DA;
  ausgang = WEG;
}
