inherit "std/room";

#include "../def.h"

#define EINGANG ROOM "eingang"

void create() 
{
//  replace_program("std/room");
  ::create();

  SetProp( P_INT_SHORT, "Wohnzimmer" );
  SetProp( P_INT_LONG,
    "Du befindest Dich in einem kleinen, aber gemuetlichen Wohnzimmer. "
    "An der Dir gegenueberliegenden Seite siehst Du einen Kamin, in dem "
    "ein kleines Feuer prasselt. Direkt davor befindet sich ein bequemer "
    "Lesesessel mit leicht verblichenen Armlehnen. Rechts steht ein "
    "grosses Regal mit fremdartig aussehenden Buechern an der Wand. "
    "In der Ecke direkt daneben siehst Du ein ordentlich gemachtes Bett und "
    "durch das Fenster im Sueden kannst Du einen kleinen Teil des "
    "Sternenwaldes erkennen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "wohnzimmer", "zimmer" }), QueryProp(P_INT_LONG));
  AddDetail( ({ "seite" }),
    "An der Dir gegenueberliegenden Seite siehst Du einen Kamin, in dem "
    "ein kleines Feuer prasselt.");
  AddDetail( ({ "kamin" }),
    "In dem Kamin prasselt ein kleines Feuer. Auf dem Kaminsims befinden "
    "sich einige Trophaeen.");
  AddDetail( ({ "kaminsims", "sims" }),
    "Auf dem Kaminsims befinden sich die schoensten Trophaeen.");
  AddDetail( ({ "trophaeen", "trophaee" }),
    "Zu ihnen gehoeren ein wunderschoenes goldenes Horn eines wohl einstmals "
    "maechtigen Einhorns sowie einige funkelnde Edelsteine. Du fragst Dich, "
    "ob die Juwelentrolle sie freiwillig hergegeben haben.");
  AddDetail( ({ "horn" }),
    "Das goldene Horn ist von einer gleissenden Aura umgeben. Du erschauerst, "
    "als Du die grosse Macht spuerst, die noch immer in ihm schlummert.");
  AddDetail( ({ "aura" }),
    "Du streckst Deine Hand aus und versuchst, das Horn zu beruehren. "
    "Ploetzlich wird die Aura noch heller und blendet Dich fast. "
    "Vorsichtshalber entschliesst Du Dich, wieder auf Abstand zu gehen. "
    "Du bist erstaunt, dass noch immer soviel Macht in dem Horn steckt.");
  AddDetail( ({ "hand" }),
    "Wo sich Deine Hand befindet, solltest Du schon selber wissen.");
  AddDetail( ({ "abstand" }),
    "Du bleibst lieber auf Abstand zu dem Horn.");
  AddDetail( ({ "macht" }),
    "Du spuerst eine ueberaus maechtige Kraft von dem Horn ausgehen.");
  AddDetail( ({ "einhorn", "einhoerner" }),
    "Einhoerner sind Wesen voller Anmut und Kraft, deren Blicke Weisheit und "
    "Guete gleichermassen ausstrahlen.");
  AddDetail( ({ "wesen" }),
    "Wunderbare Wesen kannst Du in diesem Wald antreffen. Wie zum Beispiel die "
    "Einhoerner oder Juwelentrolle.");
  AddDetail( ({ "beispiel" }),
    "Das war nur ein Beispiel von vielen.");
  AddDetail( ({ "anmut" }),
    "Voller Anmut und Kraft streifen die Einhoerner durch den Sternenwald.");
  AddDetail( ({ "kraft" }),
    "Du spuerst instinktiv die Kraft, die von den Einhoernern und vor allem "
    "von ihrem praechtigen Horn ausgeht.");
  AddDetail( ({ "blicke", "blick" }),
    "Hast Du jemals ein Einhorn gesehen?");
  AddDetail( ({ "weisheit" }),
    "Weise gruebelst Du ueber den Sinn des Lebens.");
  AddDetail( ({ "sinn", "leben"}),
    "42.");
  AddDetail( ({ "guete" }),
    "Die Guete der Einhoerner ist wohl unuebertroffen, aber wehe dem, der es "
    "wagt, sie anzugreifen.");
  AddDetail( ({ "edelstein", "edelsteine" }),
    "Jeder einzelne von ihnen ist ein besonders schoenes Exemplar. Du bist Dir "
    "fast sicher, dass die Juwelentrolle diese Edelsteine nicht freiwillig "
    "rausgerueckt haben.");
  AddDetail( ({ "exemplar" }),
    "Jeder einzelne von ihnen ist ein besonders schoenes Exemplar.");
  AddDetail( ({ "juwelentroll", "troll", "juwelentrolle", "trolle" }),
    "Juwelentrolle sind grosse Wesen, die sehr an Trolle erinnern. "
    "Ihre Haut ist mit feinem Juwelenstaub ueberzogen.");
  AddDetail( ({ "haut" }),
    "Die Haut der Juwelentrolle scheint zu gluehen.");
  AddDetail( ({ "juwelenstaub", "staub" }),
    "Die Haut ist mit feinem Juwelenstaub ueberzogen.");
  AddDetail( ({ "feuer" }),
    "Das Feuer verbreitet eine angenehme Atmosphaere. Ab und zu knackt es leise.");
  AddDetail( ({ "Atmosphaere" }),
    "Das Feuer verbreitet eine angenehme Atmosphaere.");
  AddDetail( ({ "lesesessel", "sessel" }),
    "Ein altmodischer, aber dennoch sehr bequem aussehender Lesesessel. "
    "Die Armlehnen sehen schon sehr verblichen aus. Hier verbringt der "
    "Einsiedler offenbar seine Abende beim Lesen eines seiner zahlreichen "
    "Buecher im Schein des Feuers.");
  AddDetail( ({ "armlehnen", "lehnen" }),
    "Sie sehen schon sehr verblichen aus.");
  AddDetail( ({ "einsiedler", "bewohner", "besitzer" }),
    "Schau Dich mal in dem Haus um, irgendwo wird er schon sein.");
  AddDetail( ({ "haus", "hauses" }),
    "Na, wo befindest Du Dich grade ?");
  AddDetail( ({ "abende", "lesen" }),
    "Der Einsiedler verbringt seine Abende offenbar mit Lesen.");
  AddDetail( ({ "schein", "licht" }),
    "Der Schein des Feuers gibt genuegend Licht, um problemlos lesen zu koennen.");
  AddDetail( ({ "regal" }),
    "Das Regal nimmt fast die gesamte Wand ein, nur ein kleines Eckchen fuer das "
    "Bett ist noch frei. Es ist mit unzaehligen, zum Grossteil fremdartigen "
    "Buechern vollgestellt.");
  AddDetail( ({ "eckchen", "stueck" }),
    "Nur ein kleines Stueck ist noch frei, welches von dem ordentlich gemachten Bett "
    "eingenommen wird.");
  AddDetail( ({ "grossteil" }),
    "Es ist mit unzaehligen, zum Grossteil fremdartigen Buechern vollgestellt.");
  AddDetail( ({ "buecher" }),
    "Ein Grossteil der Buecher ist in einer Dir unbekannten Sprache geschrieben worden, aber "
    "hin und wieder erblickst du das eine oder andere Buch, das dir verstaendlich erscheint.");
  AddDetail( ({ "sprache" }),
    "Es scheint eine sehr alte Sprache zu sein.");
  AddDetail( ({ "buch" }),
    "Du kannst nur wenige Titel entziffern.");
  AddDetail( ({ "titel" }),
    "Drei Titel erscheinen Dir interessant.");
  AddDetail( ({ "titel eins", "titel 1" }),
    "Die Legende vom Goldenen Einhorn");
  AddDetail( ({ "titel zwei", "titel 2" }),
    "Hoehlenspinnen und ihre Gefahren");
  AddDetail( ({ "titel drei", "titel 3" }),
    "Juwelentrolle - Mythos und Magie");
  AddDetail( ({ "ecke" }),
    "In der Ecke direkt neben dem Regal befindet sich das Bett des Einsiedlers.");
  AddDetail( ({ "bett" }),
    "Das einzigste, was Dir an dem Bett auffaellt, ist, dass es sehr "
    "ordentlich gemacht wurde. Du siehst keine einzige Falte in der "
    "Bettdecke oder im Kissen. Der Bewohner dieses Hauses scheint sehr "
    "viel Wert auf Ordnung zu legen.");
  AddDetail( ({ "wert", "ordnung" }),
    "Der Bewohner dieses Hauses scheint sehr viel Wert auf Ordnung zu legen.");
  AddDetail( ({ "falte", "falten" }),
    "Du siehst keine.");
  AddDetail( ({ "bettdecke" }),
    "Eine einfache, graue Bettdecke, die dennoch sehr warm aussieht. Die Naechte "
    "hier im Sternenwald koennen doch recht kuehl werden. ");
  AddDetail( ({ "Naechte" }),
    "Die Naechte hier im Sternenwald koennen doch recht kuehl werden. ");
  AddDetail( ({ "kissen" }),
    "Das Kissen sieht genauso schlicht und grau aus wie die Bettdecke. "
    "Der Besitzer scheint nicht sonderlich viel Zeit im Bett zu "
    "verbringen, sonst haette er sicherlich schoenere Farben dafuer "
    "ausgewaehlt.");
  AddDetail( ({ "zeit" }),
    "Der Besitzer scheint nicht sehr viel Zeit im Bett zu verbringen.");
  AddDetail( ({ "farben" }),
    "Rot, Gruen, Gelb, Blau... Es gibt unendlich viele Farben auf dieser "
    "Welt. Und einige davon waeren sicherlich viel schoener als dieses "
    "eintoenige Grau.");
  AddDetail( ({ "grau" }),
    "Das Grau sieht wirklich sehr eintoenig aus.");
  AddDetail( ({ "rot" }),
    "Rot wie Blut.");
  AddDetail( ({ "blut" }),
    "Das Blut pulsiert in Deinen Adern.");
  AddDetail( ({ "adern", "ader" }),
    "Die feinen blauen Linien an Deinem Handgelenk.");
  AddDetail( ({ "handgelenk", "gelenk" }),
    "Das Gelenk an Deiner Hand.");
  AddDetail( ({ "linien" }),
    "Adern.");
  AddDetail( ({ "blau" }),
    "Blau wie das Meer.");
  AddDetail( ({ "meer" }),
    "Vom Meer bist Du hier meilenweit entfernt.");
  AddDetail( ({ "gelb" }),
    "Gelb wie die strahlende Sonne.");
  AddDetail( ({ "sonne" }),
    "Die Sonne wirst du in der Unterwelt nicht zu Gesicht bekommen.");
  AddDetail( ({ "gesicht" }),
    "Du fasst an Deine Nase.");
  AddDetail( ({ "nase" }),
    "Mitten in Deinem Gesicht.");
  AddDetail( ({ "gruen" }),
    "Gruen wie frisches Gras.");
  AddDetail( ({ "gras" }),
    "Gras ist hier in der Unterwelt sehr selten zu finden.");
  AddDetail( ({ "fenster" }),
    "Neugierig blickst Du durch das Fenster. Du kannst einen kleinen "
    "Teil des Sternenwaldes erkennen.");
  AddDetail( ({"teil"}),
    "Du siehst nur einen kleinen Teil des Sternenwaldes.");
  AddDetail( ({ "welt", "silberland" }),
    "Die Welt, in der Du Dich befindest, nennt sich SilberLand.");
  AddDetail( ({"unterwelt"}),
    "Du befindest Dich hier mitten in der Unterwelt.");
  AddDetail( ({ "wald", "sternenwald", "ort" }),
    "Der Sternenwald ist ein mystischer Ort voller tiefer Geheimnisse und "
    "wunderbarer Wesen.");
  AddDetail( ({"geheimnisse", "geheimniss"}),
    "Das musst Du schon selber herausfinden ...");
  AddDetail( ({ "holzstueckchen", "holz" }),
    "Das Holz scheint direkt aus dem Sternenwald zu stammen.");
  AddDetail( ({ "boden", "holzfussboden" }),
    "Auf dem Holzfussboden liegt ein wunderschoenes, leicht golden "
    "schimmerndes Fell. Du hast das Gefuehl, dass dieses Fell etwas ganz "
    "Besonderes ist.");
  AddDetail( ({ "fell", "einhornfell" }),
    "Verwundert bemerkst Du, dass es sich um das Fell eines Einhorns handelt. "
    "Ein heller goldener Schimmer liegt ueber ihm. Du traust Dich kaum, "
    "es zu beruehren, denn wie das Horn auf dem Kamin strahlt auch das Fell "
    "eine wundersame magische Kraft aus.");
  AddDetail( ({ "gefuehl" }),
    "Ein heller goldener Schimmer umgibt das gesamte Fell.");
  AddDetail( ({ "schimmer" }),
    "Dein Gefuehl hat Dich nicht getaeuscht. Dieses Fell ist wirklich etwas "
    "ganz Besonderes.");
  AddDetail( ({ "besonderes" }),
    "Dieses Fell scheint etwas ganz Besonderes zu sein.");
  AddDetail( ({ "wand", "waende" }),
    "An der Westwand siehst Du einen Kamin, in dem ein kleines Feuer prasselt. "
    "Im Norden steht ein grosses Regal mit fremdartig aussehenden Buechern. "
    "Durch das Fenster im Sueden kannst Du einen kleinen Teil des Sternenwaldes "
    "erkennen.");
  AddDetail( ({"westwand"}),
    "An der Westwand siehst Du einen Kamin, in dem ein kleines Feuer prasselt.");
  AddDetail( ({"decke"}),
    "Die Decke besteht aus einfachen Holzbohlen.");
  AddDetail( ({"bohlen", "holzbohlen"}),
    "Einfache schlichte Holzbohlen.");
  AddDetail( ({"gewalt"}),
    "Die Gewalt eines Feuers kann sehr zerstoererisch sein.");

  AddReadDetail( ({ "titel 1", "titel eins", "titel 3", "titel drei" }),
    "Du nimmst das Buch zur Hand und blaetterst es schnell durch, findest aber nichts "
    "interessantes.");
  AddReadDetail( ({ "titel 2", "titel zwei" }),
    "Du nimmst das Buch zur Hand und blaetterst es schnell durch. An einer "
    "Stelle siehst Du ein paar Eselsohren und beginnst interessiert zu lesen.\n"
    "\"... Die Riesenhoehlenspinnen und ihre kleineren Verwandten, die Hoehlen-"
    " spinnen, zeichnen sich durch ein besonderes Netz aus. Es versperrt "
    "haeufig ganze Gaenge oder Hoehlen, ist extrem klebrig und nahezu "
    "unzerstoerbar. Es wurde schon des oefteren berichtet, dass sich "
    "unvorsichtige Abenteurer in solch einem Netz verfangen hatten, sich nicht "
    "wieder befreien konnten und als Mahlzeit fuer die Hoehlenspinne endeten. "
    "Trotz der Staerke des Netzes und seiner Widerstandsfaehigkeit gibt es "
    "dennoch ein Mittel, es zu entfernen.\nSein Schwachpunkt ist .e.e. (das "
    "Wort ist kaum mehr lesbar), wohl dem, der eine .a.ke. (auch hier ist der "
    "Text kaum zu entziffern) dabei hat ...\"\n"
    "Etwas verwirrt stellst Du das Buch wieder zurueck ins Regal.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Prasseln des Feuers und ab und zu ein leises Knacken, "
    "wenn ein Holzstueckchen wieder der Gewalt des Feuers nachgibt.");
  AddSound( ({ "prasseln", "feuer" }),
    "Das Feuer prasselt leise vor sich hin.");
  AddSound( ({ "knackt", "knacken", "holzstueckchen" }),
    "Ab und zu knackt es leise.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach Feuer.");
  AddSmell( ({ "feuer" }),
    "Prickelt etwas unangenehm in der Nase.");
  AddRoomMessage( 
    ({"*knack*\n"}),70);
  AddItem(NPC "mabruk", REFRESH_REMOVE);

//  AddExit( "osten", "in den Eingangsbereich#" + EINGANG );
  AddExit("osten", ([EX_DEST : EINGANG, 
                     EX_MSG : "in den Eingangsbereich", 
                     EX_TESTFUNC : "exit_test" ]) );

}

int exit_test()
{
  object mabruk, qitem;
  int i;

  if(TP && interactive(TP))
  {
    mabruk = present("mabruk", TO);
    qitem = present(QUESTITEM, TP);

    if(qitem && mabruk && !mabruk->InFight() && !qitem->QueryHint())
    {
      tell_object(TP,BS("Als Du das Wohnzimmer verlassen willst haelt "
                    +"Dich Mabruk kurz auf."));
      Message(BS("Als "+TP->Name()+" das Wohnzimmer verlassen will, "
                +"wird er kurz von Mabruk aufgehalten."),
                MSGFLAG_VISUAL | MSGFLAG_NO_TP);
      mabruk->command_me("sag Im tieferen Keller ist es sehr dunkel, ich habe immer ein paar "
                     +"Fackeln dort liegen. Ausserdem dringen seit einigen Wochen merkwuerdige "
                     +"Geraeusche herauf.");
      qitem->SetHint();
      return 0;
    }
  }

  return 1;
}

void QuestFertig(object player)
{
  if (getuid(previous_object()) != getuid())
  {
    raise_error("Illegal call!");
    return;
  }

//  DB("Spieler: "+player->Name()+"\n");
  switch(player->GiveQuest(QUESTNAME)) 
  {
    case 1:  write_file(QUESTLOG "quest.log", 
               dtime(time())+": "+CAP(getuid(player))+" loest die Quest.\n" );
             write_file("/log/quests/mabruk",
               dtime(time())+": "+CAP(getuid(player))+" loest die Quest.\n" );
             break;
    case -1: write_file(QUESTLOG "quest.log", 
               dtime(time())+": "+CAP(getuid(player))+" GiveQuest schlug fehl!!! -1 "
                            +"(Bereits geloest!)\n" );
             tell_object(player, BS("Du hast die Quest bereits geloest! Sollte das nicht "
                     +"stimmen, wende Dich SOFORT an einen anwesenden Magier!"));
             break;
    case -2: write_file(QUESTLOG "quest.log", 
               dtime(time())+": "+CAP(getuid(player))+" GiveQuest schlug fehl!!! -2 "
                           +"(Quest nicht angemeldet!)\n" );
             tell_object(player, BS("Die Quest ist leider noch nicht angemeldet! Sollte es "
                     +"diese Quest dennoch geben, wende Dich SOFORT an einen "
                     +"anwesenden Magier!"));
             break;
    case -3: write_file(QUESTLOG "quest.log", 
               dtime(time())+": "+CAP(getuid(player))+" GiveQuest schlug fehl!!! -3 "
                            +"(Unbefugter Zugriff!)\n" );
             tell_object(player, BS("Unbefugter Zugriff, wende Dich bitte SOFORT an einen "
                     +"anwesenden Magier!"));
             break;
    case -4: write_file(QUESTLOG "quest.log", 
               dtime(time())+": "+CAP(getuid(player))+" GiveQuest schlug fehl!!! -4 "
                            +"(Quest deaktiviert)\n" );
             tell_object(player, BS(
               "Die Quest ist deaktiviert!"));
             break;
    default: write_file(QUESTLOG "quest.log", 
               dtime(time())+": "+CAP(getuid(player))+" UNBEKANNTER FEHLER!!\n" );
             tell_object(player, BS(
               "Unbekannter Fehler!! Bitte wende Dich SOFORT an "
               "einen anwesenden Magier!!!"));
             break;    
  }
  return;
}
