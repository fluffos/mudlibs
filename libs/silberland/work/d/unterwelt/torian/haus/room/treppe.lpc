inherit "std/room";

#include <language.h>
#include <doorroom.h>
#include "../def.h"

#define KUECHE ROOM "kueche"
#define BRUNNEN ROOM "brunnen"
#define DA 1
#define WEG 0
#define ZU 0
#define OFFEN 1
#define STAUBWEDEL OBJ "staubwedel"

int schrank;
int staubwedel;
int spinnwebe;
object myspinne;

create()
{
  ::create();

  schrank = ZU; 
  staubwedel = DA;
  spinnwebe = DA;

  SetProp( P_INT_SHORT, "Kellertreppe" );
  SetProp( P_INT_LONG,
     "Du befindest Dich im Keller des Hauses. Hier unten ist es sehr "
     "dunkel. Hinter Dir kannst Du die Treppe sehen, die Du gerade "
     "hinuntergestiegen bist. In den Hohlraum unter der Treppe ist ein "
     "Schrank eingebaut worden. An der Decke siehst Du in einer Ecke ein "
     "kleines Spinnennetz.");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  
  AddDetail( ({"keller"}),
    "Du befindest Dich im Keller des Hauses.");
  AddDetail( ({"haus", "hauses"}),
    "Das Haus, genauer gesagt die Kueche, ist direkt ueber Dir.");
  AddDetail( ({"kueche"}),
    "Die Kueche befindet sich direkt ueber Deinem Kopf.");
  AddDetail( ({"kopf"}),
    "Du schaust nach oben an die Decke und hoffst, dass sie nicht einstuerzt.");
  AddDetail( ({"treppe","holztreppe"}),
    "Eine alte, schon etwas morsche Holztreppe. Sie knarrt betraechtlich "
    "bei jedem Schritt, aber Dein Gewicht scheint sie gerade noch tragen "
    "zu koennen.");
  AddDetail( ({"holz"}),
    "Das Holz ist schon etwas morsch.");
  AddDetail( ({"schritte", "schritt"}),
    "Vorsichtig setzt Du Deinen Fuss auf die naechste Stufe. *knarr*");
  AddDetail( ({"fuss"}),
    "Pass auf, dass Du nicht stolperst.");
  AddDetail( ({"stufe", "stufen"}),
    "Die Stufen knarren bei jedem Schritt.");
  AddDetail( ({"hohlraum"}),
    "In den Hohlraum unter der Treppe wurde eine Art Schrank eingebaut.");
  AddDetail( ({"art"}),
    "Eigentlich wurden nur einige Holzlatten zwischen Wand und Treppenunterseite "
    "geklemmt, die als Regale dienen, und davor wurden ausrangierte Schranktueren "
    "befestigt, die sich sogar oeffnen und schliessen lassen. Fast wie ein "
    "richtiger Schrank eben.");
  AddDetail( ({"holzlatten", "latten"}),
    "Sorgsam zugeschnittene Holzlatten dienen als Regale.");
  AddDetail( ({"treppenunterseite"}),
    "Hast Du schon mal eine Treppe von unten gesehen? Dann solltest Du wissen, "
    "was ich meine.");
  AddDetail( ({"tuer", "tueren"}),
    "Welche Tuer meinst Du? Die vom Schrank oder die Falltuer?");
  AddDetail( ({"schranktueren", "schranktuer", "lebensabend"}),
    "Alte, ausrangierte Schranktueren, die hier ihren Lebensabend verbringen "
    "duerfen.");
  AddDetail( ({"hausbewohner", "bewohner"}),
    "Der befindet sich irgendwo in den oberen Raeumen des Hauses.");
  AddDetail( ({"raeume"}),
    "Direkt ueber Dir befindet sich die Kueche.");
  AddDetail( ({"wert"}),
    "Oben im Haus wurde wesentlich mehr Wert auf Sauberkeit gelegt als "
    "hier unten im Keller.");
  AddDetail( ({"sauberkeit"}),
    "Hier unten ist es nicht ganz so sauber wie oben.");
  AddDetail( ({"decke"}),
    "Die Decke ist ziemlich hoch an dieser Stelle. Von hier unten kannst "
    "Du sie nicht erreichen, weiter oben auf der Treppe solltest Du sie "
    "jedoch problemlos beruehren koennen.");
  AddDetail( ({"stelle"}),
    "Von hier unten kannst Du die Decke nicht erreichen.");
  AddDetail( ({"wand", "waende"}),
    "Die Waende bestehen hier unten komplett aus schwarzem "
    "Vulkangestein.");
  AddDetail( ({"gestein", "vulkangestein"}),
    "Schwarzes, fast glasartiges Vulkangestein.");
  AddDetail( ({"boden"}),
    "Der Boden ist etwas staubig.");
  AddDetail( ({"staub"}),
    "Grau und trocken.");
  AddDetail( ({"glueck"}),
    "Hat nicht jeder.");
  AddDetail( ({"ende"}),
    "Welches Ende meinst Du? Deins oder das der Treppe?");
  AddDetail( ({"treppenende", "ende der treppe"}),
    "Das Treppenende befindet sich direkt bei der Falltuer.");
  AddSpecialDetail( ({"mein ende", "dein ende"}), "strende");
  AddSpecialDetail( ({ "putzen",
                        "hausfrau", "hausmann"}), "strputzen");

  AddSpecialDetail( ({ "spinnweben","spinnwebe",
                       "netz","spinnennetz",
                       "ecke",
                       "saubermachen" }), "strnetz");
  AddSpecialDetail( ({ "schrank","regale" }), "strschrank");
  AddSpecialDetail( ({ "gewicht" }), "strgewicht");
// Schrankinhalt  
  AddSpecialDetail(
    ({"wedel", "staubwedel",
      "besenstiel", "besen", "stiel",
      "flasche",
      "flaschen",
      "putzmittel",
      "schrankwand",
      "schrankboden",
      "eimer",
      "etikett",
      "putzlappen", "lappen",
     }), "details_im_schrank" ); 

  AddSound( DEFAULT_SOUND,
    "Du hoerst ein leises Trippeln, wie von vielen kleinen Spinnen.");
  AddSound( ({ "trippeln", "trippel" }),
    "Leises Trippeln, als wenn unzaehlige Spinnen irgendwo in der "
    "Naehe waeren.");
  AddSound( ({ "spinnen" }),
    "Etwas kratzt hinter Dir. Erschrocken wirbelst Du herum und lauschst.");
  AddSound( ({ "etwas" }),
    "Doch nichts, Glueck gehabt.");
  AddSound( ({ "naehe" }),
    "Naeher als Du vielleicht glaubst.");
  AddSound( ({ "knarren", "knarrt", "treppe", "schritte" }),
    "Die Treppe knarrt betraechtlich bei jedem deiner Schritte.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht ein wenig nach Reinigungsmitteln.");
  AddSmell( ({ "reinigungsmittel", "mittel", "putzmittel" }),
    "Aus dem Schrank stroemt ein leichter Geruch nach Putzmitteln.");
  AddSmell( ({ "geruch", "schrank"}),
    "Du fuehlst Dich an ein Krankenhaus erinnert.");
  AddSmell( ({ "krankenhaus"}),
    "Du weisst zwar nicht, was ein Krankenhaus ist, aber Du glaubst, "
    "dass es dort genauso nach Putzmitteln riecht wie hier.");

  AddCmd( ({ "stolper", "stolpere" }), "cmdstolper" );
  AddCmd( ({ "oeffne" }), "cmdoeffne" );
  AddCmd( ({ "schliesse", "schliess" }), "cmdschliesse" );
  AddCmd( ({ "trinke", "trink" }), "cmdtrinke" );
  AddCmd( ({ "entferne", "entfern" }), "cmdentferne" );
  AddCmd( ({ "nimm" }), "cmdnehmen" );

  AddExit( "norden", "nach Norden#" +BRUNNEN );

    NewDoor("oben", KUECHE , ({"falltuer","tuer"}) ,
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Falltuer.",
      D_LONG, "Die Falltuer befindet sich am Ende der Treppe in der Decke.",
      D_NAME,  "Falltuer",
      D_GENDER,FEMALE,
      D_MSGS,    ({"hinauf","klettert in die Kueche","kommt herein"}),
      D_OPENMSG, ({"Du oeffnest die Falltuer in der Decke.",
                   "Die Falltuer in der Decke wird von %s geoeffnet.",
                   " wird von unten geoeffnet."}),
      D_CLOSEMSG, ({"Du schliesst die Falltuer.",
                    "Die Falltuer wird von %s geschlossen.",
                    " wird von unten geschlossen."}),
      D_RESET_CLOSEMSG,
                  " wird wie durch Geisterhand geschlossen."
    })
  );
}
string strputzen(string key)
{
  string s;

  switch (key)
  {
    case "putzen" :
      s = "Wenn Du " +(PL->QueryProp(P_GENDER)==FEMALE?"eine tuechtige Hausfrau" 
                                                      :"ein tuechtiger Hausmann") 
         +" waerst, wuesstest Du, was das ist.";
      break;
    case "hausfrau" :
    case "hausmann" :
      s= "Bist Du "+(PL->QueryProp(P_GENDER)==MALE?"einer":"eine")+"?";
      break;
  }
  return BS(s);
}
string strende(string key)
{
    return "[Tod:Lars] Das Ende von "+TP->name()+" hat begonnen.\n"
          +"[Tod:Das Ende] Huch, schon wieder vorbei ?\n";

}
string strnetz(string key)
{
  string s;

  switch(key)
  {
    case "netz" :
    case "spinnennetz" :
    case "spinnwebe" :
    case "spinnweben" :

      if(spinnwebe==DA)
      {
        s = "Das Spinnennetz scheint beim letzten Saubermachen uebersehen "
           +"worden zu sein.";
      }   
      else
      {
        s = "Du siehst nur noch winzige Spuren.";
      }   
      break;
    case "ecke" :
      if(spinnwebe==DA)
      {
        s = "An der Decke siehst Du in einer Ecke ein kleines Spinnennetz.";
      }   
      else
      {
        s = "An der Decke siehst Du in einer Ecke nur noch winzige Spuren eines "
           +"Spinnennetzes.";
      }
      break;
    case "saubermachen" :
      if(spinnwebe==DA)
      {
        s = "Hier unten im Keller scheint der Hausbewohner nicht so viel Wert "
           +"auf Sauberkeit zu legen, sonst haette er sicherlich auch das "
           +"Spinnennetz entfernt.";
      }   
      else
      {
        s = "Auch im Keller scheint der Hausbewohner regelmaessig sauber zu machen.";
      }
      break;
    case "spuren" :
      if (spinnwebe==DA)
      {
        s = "Sowas siehst Du hier nicht.";
      }
      else
      {
        s = "Wirklich winzige."; 
      }
      break;
    default :
      s = "Sowas siehst Du hier nicht.";
      break;
  }
return BS(s);
}

// Schrank auf oder nicht auf, dass ist hier die Frage
string strschrank(string key)
{
   string s;
   if(schrank==ZU)
   {
     if(key == "schrank")
     {
       s = "In dem Hohlraum unter der Treppe befindet sich eine Art "
          +"Schrank. Vielleicht kannst Du ihn ja oeffnen?";
     }   
     else
     {
       s = "Um zu sehen, was sich in dem Schrank befindet, wirst Du ihn wohl "
          +"erst oeffnen muessen.";
     }
   }
   else
   {
     if(key == "schrank")
     { 
// Nix Wedel -> Nix wedel im Schrank
       if (staubwedel == DA)
       {
         s = "In den Regalen liegen ein paar alte Putzlappen, ein Staubwedel "
            +"und einige Flaschen mit Putzmitteln. Unten auf dem Schrankboden "
            +"steht ein kleiner Eimer. Dahinter ragt ein langer Besenstiel "
            +"hervor.";
       }
       else
       {
         s = "In den Regalen liegen ein paar alte Putzlappen und einige "
            +"Flaschen mit Putzmitteln. Unten auf dem Schrankboden "
            +"steht ein kleiner Eimer. Dahinter ragt ein langer Besenstiel "
            +"hervor.";
       }
     }
     else
     {
       if (staubwedel == WEG)
       {
         s = "In den Regalen liegen ein paar alte Putzlappen und "
           +"einige Flaschen mit Putzmitteln.";
       }
       else
       {
         s = "In den Regalen liegen ein paar alte Putzlappen, ein Staubwedel und "
           +"einige Flaschen mit Putzmitteln.";
       }
     }
   }   
return BS(s);
}

// netter Satz zum Gewicht des Spielers (in Kilo)
string strgewicht(string key)
{
   string s;
   int kilo;

   kilo = (PL->QueryProp(P_WEIGHT))/1000;
 
   s = "Mit Deinen "+kilo+" Kilo bist Du ganz schoen schwer.";
   return BS(s);
}

// Fuer die die jedes verb ausprobieren ;-)
// wer ungeschickt ist faellt runter, wobei ab geschick 20 keiner mehr faellt
int cmdstolper(string str)
{
  notify_fail( "Was willst Du tun?\n" );
  if ((PL->QueryAttribute(A_DEX)+random(10)) < 21)
  {
    write(BS("Du stolperst und faellst das letzte Stueck der Treppe runter.") ); 
    say(BS( PL->name()+" faellt die Treppe runter und stoesst sich den Kopf.") );
    PL->AddHp(-15);
    return 1;
  }
  else
  {
    write(BS("Du stolperst, kannst Dich aber gerade noch an der Wand "
            +"festhalten.") );
    say(BS( PL->name()+" stolpert, kann sich aber gerade noch an der Wand "
                      +"festhalten.\n") );
    return 1;
  }
  return 0;
}
// oeffnen des Schrankes 
int cmdoeffne(string str)
{
  notify_fail( "Was willst Du oeffnen?\n" );
  if(str == "schrank" )
  {
    if(schrank == ZU)
    {
      say( PL->name()+" oeffnet den Schrank.\n");
      write("Du oeffnest den Schrank.\n");
      // Schrank offen -> Details untersuchbar -> details_im_schrank()
      schrank = OFFEN;
      return 1;
    }
    else
    {
      write("Der Schrank ist doch schon offen.\n");
      return 1;
    }
  }
  return 0;
}
// schliessen des Schrankes
int cmdschliesse(string str)
{
  notify_fail( "Was willst Du schliessen?\n" );
  if(str == "schrank" )
  {
    if(schrank == OFFEN)
    {
      say( PL->name()+" schliesst den Schrank.\n");
      write("Du schliesst den Schrank.\n");
      // Details nimmer untersuchbar
      schrank = ZU;
      return 1;
    }
    else
    {
      write("Der Schrank ist doch schon zu.\n");
      return 1;
    }
  }
  return 0;
}
// Putzmittel trinken ? sofern man drauf kommt
int cmdtrinke(string str)
{
  notify_fail( "Aus was willst Du trinken?\n" );
  if(str == "flasche" || str == "aus flasche")
  {
    if(schrank == OFFEN)
    {
      say(BS( PL->name()+" nimmt einen Schluck aus der Flasche und faengt an "
                        +"zu wuergen.") );
      write(BS("Du nimmst einen kraeftigen Schluck aus der Flasche und "
              +"faengst fuerchterlich an zu wuergen. Keuchend wirfst Du "
              +"nochmals einen Blick auf die Flasche und erkennst ein "
              +"Etikett.") );
      return 1;
    }
    else
    {
      write("Der Schrank ist geschlossen.\n");
      return 1;
    }
  }
  return 0;
}
string details_im_schrank(string key)
{
  string s;

  if(schrank == ZU) return "Vielleicht solltest Du erst den Schrank oeffnen?\n";

  switch(key)
  {
    case "wedel" :
    case "staubwedel" :
      s = "Irgendetwas fasziniert Dich an diesem dicken, bauschigen "
         +"Staubwedel, der in einem der unteren Regale liegt.";
      break;
    case "putzmittel" :
      s ="Putzmittel gebraucht man gewoehnlich zum Putzen.";
      break;
    case "schrankboden" :
      s ="Auf dem Schrankboden steht ein kleiner Eimer.";
      break;
    case "besenstiel" :
    case "stiel" :
    case "besen" :
      s ="Hinter dem Eimer lehnt ein Besen an der Schrankwand.";
      break;
    case "schrankwand" :
      s = "An der Schrankwand lehnt ein Besen.";
      break;
    case "etikett" :
      s = "Nur zur aeusseren Anwendung!";
      break;
    case "eimer" :
      s = "Ein kleiner Eimer steht auf dem Schrankboden.";
      break;
    case "putzlappen" :
    case "lappen" :
      s = "Alt und dreckig. Du laesst sie lieber liegen.";
      break;
    case "flaschen" :
      s = "Eine Flasche faellt Dir besonders auf.";
      break;
    case "flasche" :
      s = "Diese Flasche sieht irgendwie anders aus als die anderen. "
         +"Was sich wohl in ihr befindet?";
      break;
    default :
      s = "Sowas siehst Du hier nicht.";
      break;
  }

  return BS(s);
}
// entfernen der Spinnweben mit Staubwedel aus dem Schrank
int cmdentferne(string str)
{
  notify_fail( "Was willst Du womit entfernen?\n" );
  if(str == "spinnweben mit staubwedel" || str == "spinnweben mit wedel" 
     || str == "spinnennetz mit staubwedel" || str == "spinnennetz mit wedel")
  {
    if((spinnwebe == DA ) && present("staubwedel", PL) )
    {
      say(BS( PL->name()+" entfernt die Spinnweben mit einem Staubwedel und "
                     +"scheucht deren Besitzer auf.") );
      write(BS("Du entfernst die Spinnweben mit einem Staubwedel und scheuchst "
              +"deren Besitzer auf.") );
      spinnwebe = WEG;
      AddItem( "/d/unterwelt/basics/central/npc/spinne", REFRESH_NONE);
      return 1;
    }
  }
  return 0;
}
int cmdnehmen(string str)
{
  object mein_staubwedel;
  string s;

  notify_fail("Sowas siehst Du hier nicht!\n");

  if(!str || str=="") return 0;

    switch(str)
    {
      case "staubwedel" :
        if(schrank == ZU){return 0;}
        if(staubwedel == WEG){return 0;}
  
        mein_staubwedel=clone_object(STAUBWEDEL);
  
        if(ME_TOO_HEAVY==mein_staubwedel->move(TP,M_GET|M_SILENT))
        {
          s = "Du kannst den Staubwedel nicht mehr tragen.";
          mein_staubwedel->remove();
        }
        else
        {
          s = "Du nimmst den Staubwedel.";
          staubwedel = WEG;
        }
        break;

      case "besen" :
      case "stiel" :
      case "besenstiel" :
        if(schrank == ZU){return 0;}
          s = "Du ziehst den Besen aus dem Schrank, fegst ein wenig "
             +"auf dem Boden herum und verteilst den Staub schoen "
             +"gleichmaessig im ganzen Raum. Etwas unbefriedigt stellst "
             +"Du den Besen wieder zurueck in den Schrank.";
        break;

      case "putzmittel" :
      case "flaschen" :
      case "flasche" :
        if(schrank == ZU){return 0;}
          s = "Das ueberlass mal lieber der Putzfrau.";
        break; 

      case "eimer" :
        if(schrank == ZU){return 0;}
          s = "Du bueckst Dich hinunter, um den Eimer zu nehmen, "
             +"verziehst jedoch kurz darauf schmerzhaft das Gesicht.\n"
             +"Du denkst . o O (Oh, mein Rheuma!) und laesst den Eimer "
             +"lieber dort, wo er ist.";
        break; 

      case "lappen" :
      case "putzlappen" :
        if(schrank == ZU){return 0;}
          s = "Du willst Deine Finger lieber nicht dreckig machen und "
             +"laesst die alten Lappen liegen.";
        break; 

      default :
        return 0;
    }
    write( BS(s) );
    return 1;
}

reset()
{
  ::reset();
  if(schrank == OFFEN)
    tell_room(TO, "Wie von Geisterhand wird der "
                            +"Schrank wieder geschlossen.\n");
  myspinne = present("spinne");
  if (myspinne)
  {
    myspinne->remove();
    tell_room(TO, "Die winzige Spinne webt sich ein neues Netz.\n");
  }
  else
  {
    if(spinnwebe == WEG)
    {
      tell_room(TO, "Eine winzige Spinne kommt herein und webt "
                                +"sich ein neues Netz.\n");
      spinnwebe = DA;
    }
  }
  schrank = ZU;
  staubwedel = DA;
}
