inherit "std/room";

#include <defines.h>
#include <doorroom.h>
#include "../def.h"

#define KELLER ROOM "treppe"
#define ESSZIMMER ROOM "esszimmer"

string *spieler;

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Kueche." );
  SetProp( P_INT_LONG,
    "Wie Du unschwer erkennen kannst, befindest Du Dich hier in der Kueche. "
    "Du siehst einen grossen Kuechentisch, auf dem verschiedene Kochutensilien "
    "liegen, und einen Herd. An den Waenden haengen Regale mit Kochgeschirr "
    "und Gewuerzen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "kueche" }), QueryProp(P_INT_LONG));
  SetProp( P_LIGHT, 1 );
  AddDetail( ({ "kuechentisch", "tisch" }),
    "Auf dem Kuechentisch liegen viele verschiedene Kochutensilien. Die "
    "Arbeitsflaeche ist mit zahlreichen Kratzern und Kerben uebersaeht.");
  AddDetail( ({ "kratzer", "kerben" }),
    "Die vielen Kratzer und Kerben sehen so aus, als stammten sie von "
    "einem scharfen Gegenstand.");


  AddSpecialDetail( ({ "kochutensilien", "utensilien" }), "detail_utensilien");

  AddDetail( ({ "holzloeffel", "loeffel" }),
    "Die Loeffel sind aus Holz und haben lange Griffe. Damit kann man "
    "sicher gut Suppen umruehren.");
  AddDetail( ({ "holz" }),
    "Feinverarbeitetes Holz aus dem Sternenwald.");
  AddDetail( ({ "wald", "sternenwald", "ort" }),
    "Der Sternenwald ist ein mystischer Ort voller tiefer Geheimnisse und "
    "wunderbarer Wesen.");
  AddDetail( ({"geheimnisse", "geheimniss"}),
    "Das musst Du schon selber herausfinden ...");
  AddDetail( ({"wesen"}),
    "Wunderbare Wesen kannst Du in diesem Wald antreffen.");
  AddDetail( ({ "griffe" }),
    "Auch die Griffe bestehen aus Holz.");
  AddDetail( ({ "suppen", "suppe" }),
    "Suchend blickst Du Dich um. Leider kannst Du nirgendwo einen Topf "
    "mit Suppe stehen sehen. Schade, dabei hattest Du Dich schon so "
    "gefreut. :(");
  AddDetail( ({ "nudelholz" }),
    "Ein grosses Nudelholz liegt auf dem Tisch.");
  AddDetail( ({ "kuechenmesser", "messer" }),
    "Das Kuechenmesser hat eine sehr scharfe Klinge. Du bist Dir sicher, "
    "dass die Kratzer auf der Arbeitsflaeche von ihm stammen.");
  AddDetail( ({ "klinge" }),
    "Sei bloss vorsichtig!");
  AddDetail( ({ "gegenstand" }),
    "Sieh Dich mal genauer um.");
  AddDetail( ({ "arbeitsflaeche", "flaeche" }),
    "Die Arbeitsflaeche sieht schon ziemlich zerkratzt aus.");
  AddDetail( ({ "herd" }),
    "Im Moment befindet sich kein Topf auf der Herdplatte. Im unteren "
    "Bereich siehst Du eine kleine Klappe. Anscheinend dient sie zum "
    "Befeuern des Herdes mit Brennholz. Ploetzlich faellt Dir ein "
    "kleiner Schrank auf, den Du vorhin voellig uebersehen hast.");
  AddDetail( ({ "moment" }),
    "Im Moment befindet sich kein Topf auf der Herdplatte.");
  AddDetail( ({ "herdplatte", "platte" }),
    "Vorsichtig beruehrst Du die Herdplatte. Woodyseidank! Sie ist "
    "voellig kalt. Sonst haettest Du Dir jetzt wohl ziemlich die Finger "
    "verbrannt.");
  AddDetail( ({ "finger" }),
    "Noch alle dran.");
  AddDetail( ({ "bereich" }),
    "Im unteren Bereich des Herdes siehst Du eine kleine Klappe. Durch "
    "sie kann man den Herd einheizen.");
  AddDetail( ({ "klappe" }),
    "Was sich hinter der Klappe verbirgt, kannst Du leider nicht "
    "erkennen." );
  AddDetail( ({ "russ" }),
    "Die Klappe ist wirklich sehr schmutzig.");
  AddDetail( ({ "befeuern" }),
    "Die Klappe dient zum Befeuern des Herdes.");
  AddDetail( ({ "brennholz" }),
    "Brennholz findet man hier im Sternenwald sicher genug.");
  AddDetail( ({ "sternenwald", "wald", "haus" }),
    "Der Sternenwald befindet sich direkt vorm Haus.");
  AddDetail( ({ "schrank" }),
    "Ein unscheinbarer kleiner Schrank, aus dem leise Geraeusche dringen.");
  AddDetail( ({ "ohr" }),
    "Du befuehlst Deine Ohren und stellst erleichtert fest, dass sie "
    "noch beide da sind, wo sie hingehoeren.");
  AddDetail( ({ "schranktuer" }),
    "Vielleicht solltest Du es mal mit oeffnen versuchen?");
  AddDetail( ({ "regale" }),
    "Welches Regal meinst Du? Das Regal mit dem Kochgeschirr oder das "
    "Gewuerzregal?");
  AddDetail( ({ "regal" }),
    "In dem Regal sind einige Toepfe und Pfannen in den verschiedensten "
    "Groessen aufeinandergestapelt.");
  AddDetail( ({ "toepfe","topf" }),
    "Du siehst ein paar grosse Stapel Toepfe.");
  AddDetail( ({ "stapel", "augenblick" }),
    "Einer der Stapel sieht so aus, als wuerde er jeden Augenblick "
    "zusammenbrechen. Vielleicht kannst Du ihn ja vorsichtig etwas "
    "geraderuecken?");
  AddDetail( ({ "groessen" }),
    "Alle moeglichen Groessen.");
  AddDetail( ({ "pfannen" }),
    "Grosse Pfannen, kleine Pfannen, mittelgrosse Pfannen.");
  AddDetail( ({ "gewuerzregal", "kochen" }),
    "Wie der Name schon sagt, werden in dem Gewuerzregal die vielen verschiedenen "
    "Gewuerze aufbewahrt, die man so zum Kochen benoetigt.");
  AddDetail( ({ "name" }),
    "Gewuerzregal.");
  AddDetail( ({ "kochgeschirr", "geschirr" }),
    "Du siehst Toepfe und Pfannen in den verschiedensten Groessen.");
  AddDetail( ({ "gewuerze" }),
    "Du siehst Anis, Estragon, Thymian, Petersilie, Moenchspfeffer und "
    "einige andere Gewuerze, deren Art Du nicht genauer bestimmen kannst.");
  AddDetail( ({ "anis" }),
    "Pimpinella anisum.\nDu summst leise vor Dich hin: 'Kleine Hexe "
    "Pimpinella...'");
  AddDetail( ({ "pimpinella" }),
    "Kennst Du nicht die Hexe Pimpinella?");
  AddDetail( ({ "hexe" }),
    "Pimpinella ist eine kleine Hexe.");
  AddDetail( ({ "estragon" }),
    "Artemisia dracunculus.\n"
    "Du denkst   . o O (Amnesie Dracula?)");
  AddDetail( ({ "thymian" }),
    "Thymus vulgaris. Ganz schoen vulgaere Gewuerze.");
  AddDetail( ({ "petersilie" }),
    "Petroselinum crispum. Knuspriges Petroleum?");
  AddDetail( ({ "moenchspfeffer" }),
    "Du fragst Dich, wie viele Moenche der Herstellung zum Opfer fielen.");
  AddDetail( ({ "herstellung" }),
    "Das willst Du gar nicht so genau wissen.");
  AddDetail( ({ "opfer", "moenche" }),
    "Sicher unzaehlige.");
  AddDetail( ({ "art", "arten" }),
    "Du kannst die anderen Arten nicht genauer bestimmen.");
  AddDetail( ({ "waende", "wand" }),
    "An den Waenden haengen Regale mit Kochgeschirr und Gewuerzen. "
    "Ausserdem siehst Du ein paar Fackelhalter, die genuegend Licht "
    "spenden.");
  AddDetail( ({ "fackelhalter","halter" }),
    "In jedem Fackelhalter steckt eine hell leuchtende Fackel.");
  AddDetail( ({ "fackel", "fackeln" }),
    "Die Fackeln spenden genuegend Licht, um die gesamte Kueche zu erhellen.");
  AddDetail( ({ "licht" }),
    "Es ist offensichtlich hell genug.");
  AddDetail( ({ "boden", "holzfussboden" }),
    "Auch in der Kueche sieht der Holzfussboden sehr ordentlich und "
    "sauber aus. Dir fallen ein paar regelmaessige Fugen auf.");
  AddDetail( ({"fugen","fuge"}),
    "Als Du genauer hinblickst, stellst Du fest, dass die Fugen zu einer "
    "Falltuer gehoeren.");
  AddDetail( ({"haken"}),
    "Damit kannst Du die Falltuer oeffnen.");
  AddDetail( ({"oeffnen"}),
    "Mit dem Haken laesst sich die Falltuer oeffnen.");
  AddDetail( ({"decke"}),
    "Die Decke besteht aus einfachen Holzbohlen.");
  AddDetail( ({"bohlen", "holzbohlen"}),
    "Einfache schlichte Holzbohlen.");
  AddDetail( ({"nase", "gesicht"}),
    "Mitten in Deinem Gesicht.");
  AddDetail( ({"atemzug", "luft"}),
    "Du holst tief Luft.");
// Fuer die nicht "Forschen per Maus" Spieler
  AddDetail( ({"haaaaaatschi", "hatschi", "haatschi", "haaatschi", "haaaatschi", "haaaaatschi"}),
    "Gesundheit.");

  AddSound( DEFAULT_SOUND,
    "Es ist sehr still hier in der Kueche. Doch halt! War da nicht "
    "gerade etwas?!");
  AddSound( ({ "etwas" }),
    "Du hast Dich wohl doch geirrt.");
  AddSound( ({ "geraeusche","geraeusch", "schranktuer" }),
    "Du presst Dein Ohr fest an die Schranktuer. Tatsaechlich, "
    "irgendetwas scheint sich dort drin zu bewegen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht sehr lecker hier in der Kueche. Die Gewuerze duften und "
    "von irgendwoher kommt ein leichter Essensgeruch.");

  AddSmell( ({ "kueche" }),
    "Es riecht sehr angenehm.");
  AddSmell( ({ "gewuerze", "gewuerzregal" }),
    "Du schnupperst am Gewuerzregal herum. Hmmm, wie das duftet!");
  AddSmell( ({ "gewuerzregal" }),
    "Du steckst Deine Nase in das Gewuerzregal und nimmst einen tiefen "
    "Atemzug. Haaaaaatschi! Das war wohl doch etwas zuviel des Guten!");
  AddSmell( ({ "essensgeruch", "geruch", "essen" }),
    "Du weisst zwar nicht, woher dieser Geruch genau kommt, aber es "
    "riecht sehr lecker.");

  AddCmd( ({ "oeffne" }), "cmdoeffne" );
  AddCmd( ({ "ruecke", "ruecke" }), "cmdruecke" );
  AddCmd( CMD_NEHMEN              , "cmdnehmen" );

  AddExit( "osten", "in das Esszimmer#" + ESSZIMMER );

    NewDoor("unten", KELLER , ({"falltuer","tuer"}) ,
    ({DOOR_CLOSED,
      DOOR_RESET_CL,
      D_SHORT, "Eine %se Falltuer.",
      D_LONG, "Du untersuchst die Falltuer genau und findest tatsaechlich "
              "einen Haken zum oeffnen.",
      D_NAME,  "Falltuer",
      D_GENDER,FEMALE,
      D_MSGS,    ({"hinunter","klettert in den Keller","kommt herein"}),
      D_OPENMSG, ({"Du oeffnest die Falltuer im Boden.",
                   "Die Falltuer im Boden wird von %s geoeffnet.",
                   " wird von oben geoeffnet."}),
      D_CLOSEMSG, ({"Du schliesst die Falltuer.",
                    "Die Falltuer wird von %s geschlossen.",
                    " wird von oben geschlossen."}),
      D_RESET_CLOSEMSG,
                  " wird wie durch Geisterhand geschlossen."
    })
  );

  spieler = ({ });
}

void reset()
{
  ::reset();

  spieler = ({ });
}

string detail_utensilien(string str)
{
  string s;

  if(member(spieler,getuuid(TP)) == -1)
  {
    s = "Du siehst ein paar lange Holzloeffel, ein Nudelholz und ein "
        "grosses scharfes Kuechenmesser auf dem Tisch liegen.";
  }
  else
  {
    s = "Du siehst ein paar lange Holzloeffel und ein Nudelholz auf dem "
        "Tisch liegen.";
  }

  return BS(s);
}

int cmdnehmen(string str)
{
  object messer;

  notify_fail("Was moechtest Du nehmen?\n");

  if(!str || str == "") return 0;

  if(str == "messer" || str == "kuechenmesser")
  {
    if(member(spieler,getuuid(TP)) > -1) return 0;

    messer = clone_object("/d/unterwelt/ronja/sternenwald/weapon/rwq_messer");
    if(messer->move(TP,M_GET) == 1)
    {
      tell_object(TP,BS("Das Messer sieht recht brauchbar aus, daher steckst "
                        "Du es ein."));
      spieler += ({ getuuid(TP) });
    }
    else
    {
      tell_object(TP,BS("Du traegst schon soviele Sachen mit Dir herum, das "
                        "Dir das Messer zu schwer wird und Du legst es "
                        "deswegen auf den Tisch zurueck."));
      messer->remove();
    }

    return 1;
  }

  if(str == "holzloeffel")
  {
    tell_object(TP,BS("Du schaust Dir die Holzloeffel an, kommst aber zu dem "
                      "Schluss, dass Du sie nicht brauchen kannst und legst "
                      "sie wieder zurueck."));
    return 1;
  }

  if(str == "nudelholz")
  {
    tell_object(TP,BS("Du schaust Dir das Nudelholz an, kommst aber zu dem "
                      "Schluss, dass Du es nicht brauchen kannst und legst "
                      "es wieder zurueck."));
    return 1;
  }

  return 0;
}


int cmdoeffne(string str)
{
  notify_fail( "Was moechtest Du oeffnen?\n" );
  if(str == "klappe")
  {
    write(BS("Die Klappe ist ueber und ueber mit Russ beschmiert, "
          "so dass Du sie lieber nicht anfasst.") );
    return 1;
  }
  else if(str == "schranktuer")
  {
    say(BS(PL->name()+" versucht, die Schranktuer zu oeffnen, starrt sie dann "
                     +"jedoch voellig verdutzt an.") );
    write(BS("Du traust Deinen Augen kaum. Da sitzt doch tatsaechlich ein "
         +"kleiner Rumpelwicht im Schrank und schrubbt seelenruhig Toepfe, "
         +"Teller und anderes Geschirr mit einer Buerste ab, die er ab und "
         +"zu in den Eimer mit Wasser vor ihm hineintaucht. Als er Dich "
         +"erblickt, schreit er mit quiekender Stimme: 'Wiesu tust du su?' "
         +"und schlaegt Dir die Tuer wieder vor der Nase zu. Verdutzt "
         +"starrst Du die geschlossene Schranktuer an.") );
    return 1;
  }
  return 0;
}
// Zum Toepfe grade ruecken
int cmdruecke(string str)
{
  notify_fail( "Was moechtest Du gerade ruecken?\n" );
  if(str == "stapel gerade")
  {
    say(PL->name()+ " hantiert am Regal herum.\n");
    write(BS( "Du stellst Dich auf die Zehenspitzen und versuchst vorsichtig, "
             +"die Toepfe etwas ordentlicher aufzustapeln. Ploetzlich beginnt "
             +"Dir alles aus den Haenden zu rutschen! Du balancierst hektisch "
             +"von einem Bein aufs andere und kannst so gerade noch "
             +"verhindern, dass die Toepfe mit lautem Getoese zu Boden fallen. "
             +"Puh, Glueck gehabt!\n") );
    return 1;
  }
  return 0;
}
