inherit "std/room";

#include "../def.h"

#define ESSZIMMER ROOM "esszimmer"
#define LATERNE OBJ "laterne"

//#define SEHERHAUS  "/d/seher/haus/leandra:00:00"

// fuer die Kiste mit der Laterne
int kiste_offen;
int staubschicht_weg;
int laterne;

void create()
{

  ::create();

  SetProp( P_INT_SHORT, "Im Geheimraum" );
  SetProp( P_INT_LONG,
    "Du stehst in einem engen dunklen Zimmer. Ohne eine Lichtquelle "
    "waere es hier ziemlich finster. Bis auf ein mit Geruempel "
    "vollgestopftes Regal an der Ostwand ist der Raum fast leer. Dir "
    "faellt eine alte Kiste auf, die in einer Ecke auf dem Boden steht. "
    "Hinter Dir in der Suedwand siehst Du den Kamin, durch den Du "
    "hereingekrochen bist. An der Westwand lehnt eine alte Leiter." );
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );

  kiste_offen = 0; // Kiste ist zu
  staubschicht_weg = 0; // staub noch da
  laterne = 1; // Laterne ist vorhanden

  AddDetail( ({ "zimmer" }),
    "Du fuehlst Dich etwas eingeengt in diesem kleinen Zimmer.");
  AddDetail( ({ "lichtquelle" }),
    "Da Du hier alles erkennen kannst, hast Du wohl eine Lichtquelle "
    "dabei. Oder aber Du bist ein Dunkelelf, dann sollte Dich die "
    "Dunkelheit nicht weiter stoeren.");
  AddDetail( ({ "dunkelheit" }),
    "Ohne Deine Lichtquelle waere es hier sehr dunkel.");
  AddDetail( ({ "dunkelelf" }),
    "Dunkelelfen koennen mit ihren meist roten Augen auch tiefste Finsternis "
    "durchdringen.");
  AddDetail( ({ "augen" }),
    "Die meisten Dunkelelfen haben rote Augen.");
  AddDetail( ({ "finsternis" }),
    ([0: "Als Dunkelelf koenntest Du auch in tiefster Finsternis noch alles "
         "genau sehen.", // der Default-Text
      "dunkelelf": "Dir als Dunkelelf macht auch tiefste Finsternis nichts aus."]) );
  AddDetail( ({ "geruempel" }),
    "Du wuehlst ein wenig in dem Regal herum, doch Du findest nichts, was "
    "Du gebrauchen koenntest.");
  AddDetail( ({ "raum" }), QueryProp(P_INT_LONG));
  AddDetail( ({ "regal" }),
    "Das Regal ist bis obenhin vollgestopft mit wertlosem Geruempel.");
  AddDetail( ({ "ecke" }),
    "In einer Ecke steht eine alte verstaubte Kiste herum.");
  AddDetail( ({ "staub" }),
    "Die Kiste ist mit einer dicken Staubschicht bedeckt.");
  AddDetail( ({ "staubschicht" }),
    "Iiih, wie eklig.");
  AddDetail( ({ "waende", "wand", "ostwand" }),
    "An der Ostwand steht ein mit Geruempel vollgestopftes Regal. "
    "Eine alte Leiter lehnt an der Westwand.");
  AddDetail( ({ "westwand", "leiter" }),
    "Eine Leiter lehnt an der Westwand. Wo sie wohl hinfuehren mag?");
  AddDetail( ({ "decke" }),
    "Die Decke besteht aus einfachen Holzbohlen.");
  AddDetail( ({"holz"}),
    "Feinverarbeitetes Holz aus dem Sternenwald.");
  AddDetail( ({ "wald", "sternenwald", "ort" }),
    "Der Sternenwald ist ein mystischer Ort voller tiefer Geheimnisse und "
    "wunderbarer Wesen.");
  AddDetail( ({"geheimnisse", "geheimniss"}),
    "Das musst Du schon selber herausfinden ...");
  AddDetail( ({"wesen"}),
    "Wunderbare Wesen kannst Du in diesem Wald antreffen.");
  AddDetail( ({"bohlen", "holzbohlen"}),
    "Einfache schlichte Holzbohlen.");
  AddDetail( ({ "boden" }),
    "In einer Ecke auf dem Boden steht eine alte Kiste.");
  AddDetail( ({ "suedwand" }),
    "In der Suedwand befindet sich der Kamin, durch den Du gerade "
    "hereingekrochen bist.");
  AddDetail( ({ "kamin" }),
    "Durch den Kamin bist Du hier hereingekrochen. Solange niemand das "
    "Feuer auf der anderen Seite wieder entzuendet, solltest Du ohne "
    "Gefahr wieder auf demselben Wege hinausgelangen koennen.");
  AddDetail( ({ "feuer" }),
    "Hoffentlich entzuendet niemand das Feuer, solange Du Dich noch auf "
    "dieser Seite des Kamins befindest.");
  AddDetail( ({ "seite" }),
    "Sollte jemand auf der anderen Seite das Feuer wieder entzuenden, "
    "sitzt Du hier wohl fest.");
  AddDetail( ({ "gefahr" }),
    "Dir wird etwas mulmig zumute.");
  AddDetail( ({ "wege","weg" }),
    "Der Weg fuehrt zurueck durch den Kamin.");
  AddDetail( ({ "taschentuch","tuch" }),
    "Das Tuch, das Du aus Deiner Hosentasche gezogen hast.");
  AddDetail( ({ "hosentasche","tasche" }),
    "Du durchsuchst verzweifelt Deine Hosentaschen sowie alle anderen "
    "Taschen, die Du bei Dir hast und findest - Woodyseidank - in der "
    "allerletzten Deinen Autoschluessel.");
  AddDetail( ({ "letzte tasche", "allerletzte tasche" }),
    "Du denkst   . o O (Natuerlich in der letzten!)");
  AddDetail( ({ "autoschluessel" }),
    "Moment mal, hattest Du nicht ein Taschentuch gesucht? Was zum Henker "
    "ist ueberhaupt ein Autoschluessel???");
  AddDetail( ({ "henker" }),
    "Der kann Dir in der Unterwelt schnell ueber den Weg laufen.");
  AddDetail( ({"unterwelt"}),
    "Du befindest Dich hier mitten in der Unterwelt.");
  AddDetail( ({"woodyseidank", "redewendung"}),
    "Nur eine Redewendung.");
// Kiste
  AddSpecialDetail(
    ({ "kiste",
       "inhalt",
       "haufen",
       "sachen",
       "laterne",
    }), "details_in_der_kiste" );

  AddSound( DEFAULT_SOUND,
    "Es ist ziemlich still hier.");

  AddSound( ({ "stille", "still" }),
    "Die Stille ist ohrenbetaeubend.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht staubig und ein wenig nach verbranntem Holz.");

  AddSmell( ({ "staub" }),
    "Staubig.");
  AddSmell( ({ "kamin" }),
    "Verbrannt.");
  AddSmell( ({ "holz" }),
    "Das stammt wohl aus dem Kamin.");

//  AddExit( "oben", "steigt die Leiter hinauf#" +SEHERHAUS );

  AddCmd( ({ "krieche", "kriech" }), "cmdkrieche" );
  AddCmd( ({ "oeffne" }), "cmdoeffne" );
  AddCmd( ({ "wische", "wisch" }), "cmdwische" );
  AddCmd( ({ "nimm" }), "cmdnimm" );

}

string details_in_der_kiste(string key)
{
  string s;

  s = "Eine alte verstaubte Kiste.";

  if(key == "kiste" && kiste_offen)
    return BS(s+" Sie ist geoeffnet. Neugierig betrachtest Du ihren Inhalt.");
  else if(key == "kiste" && !kiste_offen)
    return BS(s+" Du koenntest versuchen, sie zu oeffnen.");
  if(!kiste_offen) return "Aber die Kiste ist doch noch geschlossen !\n";

  switch(key)

  {
    case "inhalt" :
      s = "Du erblickst einen grossen Haufen uralter Sachen.";
      break;
    case "haufen" :
      s = "So gross ist der Haufen doch nicht.";
      break;
    case "sachen" :
      if(laterne)
        s = "Zwischen all den Sachen erblickst Du nichts, was Dir hilfreich "
            "erscheint, nur eine auf seltsame Weise magisch aussehende "
            "Laterne.";
      else
        s = "Zwischen all den Sachen erblickst Du nichts, was Dir hilfreich "
            "erscheint.";
      break;
    case "laterne" :
      if(laterne)
        s = "Die Laterne ist kunstvoll verziert und sieht irgendwie "
            "magisch aus.";
      else
        s = "Welche Laterne meinst Du?";
      break;
    default :
      s = "Sowas siehst Du hier nicht.";
      break;
  }
  return BS(s);
}

// move zurueck
int cmdkrieche(string str)
{
  notify_fail( "Was willst Du tun?\n" );
  if (!stringp(str)) { return 0; }
  if( strstr(str, "durch kamin", 0) != -1 )
  {
    object obj;

    call_other (ESSZIMMER, "???", 0);
    obj = find_object(ESSZIMMER);
    if(obj)
    {
	  if ( obj->QueryFire() && str != "durch kamin trotz warnung" )
	  {
		 write ("Du fuehlst Hitze aus dem Kamin, da solltest Du jetzt nicht durchkriechen!\n");
		 write ("Wenn Du es trotzdem tun willst tippe: <krieche durch kamin trotz warnung>\n");
		 return 1;
	  }
      PL->move(obj, M_NOCHECK, "durch den Kamin",
                          "kriecht", "kriecht herein");
	  if (obj->QueryFire())
	  {
	     this_player()->AddHp(-10-random(15));
	     write ("Du ziehst Dir schlimme Verbrennungen zu!\n");
      }
      return 1;
    }
    else
    {
      write("Fehler! Bitte melde ihn an Torian.\n");
      return 1;
    }
  }
  return 0;
}

// oeffnen der Kiste
int cmdoeffne(string str)
{
  notify_fail( "Was willst Du oeffnen?\n" );
  if(str == "kiste" )
  {
    if(!kiste_offen)
    {
      if(staubschicht_weg)
      {
        say( PL->name()+" oeffnet die Kiste.\n");
        write( BS("Du oeffnest die Kiste und betrachtest ihren Inhalt.") );
        kiste_offen = 1;
        return 1;
      }
      else
      {
        say(BS( PL->name() +" oeffnet die Kiste und wird von einer Staubwolke "
                         "eingehuellt. Du hoerst "
                     +(PL->QueryProp(P_GENDER)==MALE?"ihn":"sie")+" niesen.") );
        write( BS("Du oeffnest die Kiste und wirst dabei ueber und ueber mit "
                 +"Staub bedeckt. Ha-ha-ha-haaaatschi!!!\nNach einem letzten "
                 +"traurigen Blick auf Deine ehemals saubere Kleidung "
                 +"begutachtest Du den Inhalt der Kiste genauer.") );
        kiste_offen = 1;
        return 1;
      }
    }
    else
    {
      write("Die Kiste ist doch schon offen.\n");
      return 1;
    }
  }
  return 0;
}

int cmdwische(string str)
{
notify_fail( "Was willst Du wegwischen?\n" );
if(-1 == member(({"staub","staubschicht","staub weg","staubschicht weg"}),str))
{
  return 0;
}
  if(!staubschicht_weg)
  {
    say( BS( PL->name()+" holt ein Taschentuch aus der Hosentasche und wischt "
                       +"den Staub weg.") );
    write(BS("Du ziehst ein Taschentuch aus Deiner Hosentasche und wischt die "
            +"Kiste vorsichtig sauber. Nun kannst Du sie sicher gefahrlos "
            +"oeffnen.") );
    staubschicht_weg = 1;
    return 1;
  }
  else
  {
    write("Du findest keinen Staub zum wischen.\n");
    return 1;
  }
}

int cmdnimm(string str)
{
  notify_fail("Was willst Du nehmen?\n");
  if(str == "laterne")
  {
  	write("Woraus willst Du die Laterne nehmen?\n");
  	return -1;
  }
  if(str == "laterne aus kiste" )
  {
    if(laterne)
    {
      object meine_laterne;
      meine_laterne = clone_object(LATERNE);
      if(objectp(meine_laterne))
      {
        if(meine_laterne->move(this_player(), M_GET) == ME_TOO_HEAVY)
        {
          meine_laterne->remove(1);
          write("Du kannst die Laterne nicht mehr tragen.\n");
          return -1;
        }
        say( PL->name() +" nimmt eine magische Laterne aus der Kiste.\n");
        write("Du nimmst die magische Laterne aus der Kiste.\n");
        laterne = 0;
        return 1;
      }
      else
      {
        write("Fehler! Bitte melde ihn an Torian.\n");
        return -1;
      }
    }
  }
  return 0;
}

reset()
{
  ::reset();
  if(kiste_offen)
    tell_room(TO, BS("Mit einem leisen Quietschen schliesst sich "
                               +"die Kiste wieder.") );

  kiste_offen=0;  // kiste wieder zu
  staubschicht_weg=0; // staubschicht wieder da
  laterne=1; // Neue Laterne (testweise nur ne fackel)
}
