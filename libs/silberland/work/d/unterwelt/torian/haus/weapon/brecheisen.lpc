
inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include "../def.h"

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp( P_SHORT,"Ein Brecheisen");
  SetProp( P_LONG,
    "Du haeltst eine lange, an einem Ende gebogene Eisenstange in Deiner "
    "Hand. Als Waffe ist dieses Brecheisen sicherlich nicht sehr "
    "effektiv, dafuer ist es vortrefflich zum Aufstemmen von Tueren oder "
    "Aehnlichem geeignet.");

  SetProp( P_NAME, "Brecheisen");
  AddId( ({"brecheisen"}));
  SetProp( P_INFO, "Mit diesem Brecheisen kannst Du Tueren aufstemmen. Oger "
                   "und Trolle koennen es mit einer Hand fuehren, waehrend "
                   "andere Rassen beide Haende dazu benoetigen.");
  SetProp( P_GENDER, NEUTER);
  SetProp( P_WC, 80);        
  SetProp( P_WC_FIX, 30);
  SetProp( P_WEIGHT, 2000);
  SetProp( P_VALUE, 300);
  SetProp( P_WEAPON_TYPE, WT_CLUB);
  SetProp( P_NR_HANDS, 2);
  SetProp( P_MATERIAL, MAT_IRON );
  SetProp( P_DAM_TYPE,  DT_BLUDGEON );

  AddDetail( ({"ende"}),
    "An einem Ende ist die Eisenstange gebogen und zur Spitze hin leicht "
    "geplaettet, damit man es auch zwischen enge Ritzen oder Spalten "
    "schieben und so eine bessere Hebelwirkung erzielen kann.");
  AddDetail( ({"spitze", "seite"}),
    "An der gebogenen Seite ist die Spitze leicht geplaettet.");
  AddDetail( ({"ritzen", "spalten", "ritze", "spalte"}),
    "Die geplaettete Spitze passt in fast jede Ritze und Spalte.");
  AddDetail( ({"hebelwirkung"}),
    "Durch das gebogene Ende erzielt man eine bessere Hebelwirkung als "
    "mit einer geraden Stange.");
  AddDetail( ({"eisenstange", "eisen", "stange"}),
    "Das Brecheisen besteht - wie der Name schon sagt - vollstaendig aus "
    "Eisen.");
  AddDetail( ({"name"}),
    "Brecheisen.");
  AddDetail( ({"hand"}),
    "Davon hast Du zwei.");
  AddDetail( ({"brecheisen"}),
    "Das ist ein Brecheisen, das hast Du gut erkannt.");
  AddDetail( ({"aufstemmen", "tueren", "tuer"}),
    "Mit diesem Brecheisen lassen sich hervorragend Tueren aufstemmen.");

}

int _query_nr_hands()
{
  if(environment() && environment()->QueryProp(P_RACE)=="Oger" || PL->QueryProp(P_RACE) == "Troll")
    return 1;
  else
    return 2;
}
