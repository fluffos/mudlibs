inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Brunnenechse");
  SetProp(P_LONG,
    "Eine grosse Brunnenechse mit glaenzenden dunkelgruenen Schuppen und "
    "einer langen gespaltenen Zunge, die alle paar Sekunden zischelnd "
    "aus ihrem Maul hervorschnellt. Ihre kleinen goldgesprenkelten Augen "
    "mustern Dich kaltbluetig und ihr langer Schwanz peitscht drohend "
    "hin und her. Der Hornkamm auf ihrem Ruecken ist bedrohlich aufgestellt.");

  SetProp(P_NAME, "Brunnenechse");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"brunnenechse", "echse"}));
  
  AddClass(CL_ANIMAL);

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit ihren Krallen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_MAX_HP, 300);
  SetProp(P_BODY, 100);
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 150);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 150);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,1);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE: 0.1, DT_WATER: -0.2]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "kriecht herein");
  SetProp(P_MMSGOUT, "kriecht");

  SetProp(P_DIE_MSG,  " bricht zischelnd zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Eine Brunnenechse");
  SetProp(P_KILL_MSG, ({MSG_EMOTE, "zischt triumphierend!"}));

  AddDetail("schuppen",
    "Die dunkelgruenen Schuppen glaenzen vor Feuchtigkeit.");
  AddDetail("feuchtigkeit",
    "Die Schuppen sind noch ganz feucht vom Brunnenwasser.");
  AddDetail("brunnenwasser",
    "Die Brunnenechse lebt tief unten im dunklen Brunnenwasser.");
  AddDetail("zunge",
    "Eine lange gespaltene Zunge schnellt alle paar Sekunden zischelnd "
    "aus dem Maul der Brunnenechse.");
  AddDetail("sekunden",
    "Ca. alle 3-4 Sekunden.");
  AddDetail("maul",
    "Das Maul ist leicht geoeffnet.");
  AddDetail("augen",
    "Die Brunnenechse hat kleine goldgesprenkelte Augen, die Dich "
    "kaltbluetig anstarren.");
  AddDetail("schwanz",
    "Der lange schuppige Schwanz peitscht drohend hin und her.");
  AddDetail("hornkamm",
    "Der Hornkamm auf dem Ruecken ist bedrohlich aufgestellt.");
  AddDetail("ruecken",
    "Auf dem Ruecken hat die Echse einen Hornkamm, den sie drohend "
    "aufstellt, wenn sie sich angegriffen fuehlt.");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("torian", "Mein Meissssterrr.","zischt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Brunnenechse will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(4,750,
    "Die Brunnenechse peitscht Dich mit ihrem Schwanz.\n",
    "Die Brunnenechse peitscht @WEN mit ihrem Schwanz.\n",
     DT_WHIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(6,500,
    "Die Brunnenechse zerkratzt Dich mit ihren harten Krallen.\n",
    "Die Brunnenechse zerkratzt @WEN mit ihren harten Krallen.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(10, ({
    "Die Brunnenechse zischelt leise mit ihrer Zunge.\n",
    "Die Brunnenechse peitscht mit dem Schwanz hin und her.\n",
    "Die Brunnenechse starrt Dich aus ihren kleinen Augen an.\n",
    "Die Brunnenechse mustert Dich kaltbluetig.\n",
    "Die Brunnenechse zischt.\n",
    "Die Brunnenechse stellt ihren Hornkamm drohend auf.\n"}) );
  SetAttackChats(10, ({
    "Die Brunnenechse zischt wuetend.\n",
    "Die Brunnenechse stellt ihren Hornkamm auf.\n"}) );

  SUID;

}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt die Brunnenechse.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Die Brunnenechse hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "zischt veraergert und greift Dich an.",
        "zischt veraergert und greift "+TP->name(WEN)+" an.");
      Kill(TP);
      break;
    default :
      call_out("reaction", 0, TP,
        "zischt leise.",
        "zischt leise.");
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
