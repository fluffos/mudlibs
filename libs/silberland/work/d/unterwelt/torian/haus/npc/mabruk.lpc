}
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt Mabruk.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Mabruk hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aergerlich":
    case "fies":
      call_out("reaction", 0, TP,
        "funkelt Dich boese an.",
        "funkelt "+TP->name(WEN)+" boese an.");
      break;
    default :
      call_out("reaction", 0, TP,
        "runzelt die Stirn.",
        "runzelt die Stirn.");
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

int geheimwort()
{
  string geheimwort;
  object ob;
  call_other (WEINKELLER, "???", 0);
  ob = find_object(WEINKELLER);
  geheimwort ="";
  if (ob) 
  {
    write(BS("Mabruk fluestert: Das Geheimwort lautet \""
             +ob->QueryWort()+"\".\n"));

    tell_room(environment(TO),BS("Mabruk fluestert "+PL->Name()+" etwas zu."),
    ({ TP }));
    return 1;
  }
  return 0;
}

int hilfe()
{
  if(!present(QUESTITEM,TP)) 
  {
    write(break_string("Du koenntest mir tatsaechlich helfen. Ich haette "
      +"da eine kleine Aufgabe fuer Dich. Wenn Du mir helfen willst, biete "
      +"mir einfach deine Hilfe an. Syntax: <biete mabruk hilfe an>", 78, "Mabruk sagt: "));
    tell_room(environment(TO),BS("Mabruk schaut Dich fragend an."), ({ TP }));
    return 1;
  }
  else
  {
    write(BS("Mabruk sagt: Hast du meinen Zauberstab schon gefunden?"));
    tell_room(environment(TO),BS("Mabruk schaut Dich fragend an."), ({ TP }));
    return 0;
  }
}

void give_notify(object was) 
{
  object qitem, seq;
  
  if (!was->id(QUESTSTAB)) return ::give_notify(was);
  if (!qitem=present(QUESTITEM,TP)) 
  {
    write(BS("Mabruk sagt: Oh danke, sowas wollte ich schon immer fuer "
            +"meine Experimente haben."));
    was->remove();
    return;
  }

  if(!(was->QueryOwner() == getuuid(TP)))
  {
  	write(break_string("Was soll ich damit? Das ist doch gar nicht "
  	     +"Dein Stab!!!", 78, "Mabruk flucht: "));
    write_file(QUESTLOG "quest.log", 
    dtime(time())+": "+CAP(getuid(TP))+" Fremden Stab abgegeben!\n"
         +"Owner: "+was->QueryOwner()+"\n" );
    return ::give_notify(was);
  }
  // Questitem und Zauberstab aufraeumen
  was->remove();
  qitem->remove();

  // Abschluss Sequence aufrufen welche dann QuestFertig() aufruft
  seq = clone_object(OBJ "seq");
  if(seq)
  {
  	seq->move(TP,M_GET|M_NOCHECK);
  	seq->Sequence(TP);
  	SetChats(0, ({""})); // Chats ausschalten waehrend der Sequence
    write_file(QUESTLOG "quest.log", 
    dtime(time())+": "+CAP(getuid(TP))+" Abschluss Sequenz gestartet!\n" );

  }
  else
  {
    write_file(QUESTLOG "quest.log", 
    dtime(time())+": "+CAP(getuid(TP))+" Fehler beim laden des Sequencers!\n" );
  }

  return;
}

int cmdbiete(string str) 
{
  object ob, myquestitem;

  notify_fail("Moechtest Du vielleicht Deine Hilfe anbieten?\n");
  
  if (str != "hilfe an" && str != "mabruk hilfe an") return 0;
  
  if(present(QUESTITEM,TP)) {
    write(BS("Mabruk sagt: Aber Du hast mir Deine Hilfe doch schon angeboten."));
    return 1;
  }
  if(TP->QueryQuest(QUESTNAME)) {
    write(BS("Mabruk sagt: Danke, aber Du hast mir doch bereits geholfen."));
    return 1;
  }

  myquestitem=clone_object(OBJ "mabrukquest");
  if(!myquestitem)
  {
    write(break_string("Nanu, da scheint irgendetwas schiefgelaufen zu sein. "
            +"Bitte verstaendige einen Magier!", 78, "Mabruk sagt: "));
    write_file(QUESTLOG "quest.log", 
             dtime(time())+": "+CAP(getuid(TP))+" Fehler beim Clonen des Questobjects!!!\n" );

    return 1;
  }

  myquestitem->move(TP,M_GET|M_SILENT);

  write(break_string("Ok, "+TP->Name()+". Komm wieder wenn Du den Zauberstab hast!",
    78,"Mabruk sagt: "));
  write(break_string("Wenn ich den Stab erstmal wiederhabe, werde ich der maechtigste "
        +"Magier aller Zeiten.", 78, "Mabruk kichert boese: "));
  
  return 1;
}

reset()
{
  ::reset();
    SetChats(5, ({
    "Mabruk schimpft leise vor sich hin.\n",
    "Mabruk seufzt.\n",
    "Mabruk murmelt: Wenn ich doch nur ...\n",
    "Mabruk verflucht saemtliche Einhoerner dieser Welt.\n"}) );
}