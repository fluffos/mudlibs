// dante skelette
inherit "std/mnpc";
#include <mnpc.h>     
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <class.h>


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein weissliches Goblinskelett");
  SetProp(P_LONG, BS(
  "Vor Dir siehst Du die unsterblichen Reste eines Goblins. "
  "Es grinst Dich unverschaemt an und scheint sich Dir ueberlegen zu fuehlen!"));
  SP(P_NAME_ADJ, "weisslich");
  SetProp(P_NAME, "Goblinskelett");

  SetProp(P_GENDER, NEUTER);
  AddId(({"skelett", "SKEL","goblinskelett","goblin"}));
  AddClass(CL_UNDEAD);
  
  create_default_npc(15+random(2));
  SetProp(P_HANDS, ({" mit seinen spitzen Knochenhaenden", 100+random(8)*QueryProp(P_LEVEL) ,({DT_RIP,DT_PIERCE})}));
  SetProp(P_RACE, "Skelett");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "klappert grinsend herein");
  SetProp(P_MSGOUT, "klappert grinsend");
  SetProp(P_MMSGIN, "steht ploetzlich grinsend vor Dir");
  SetProp(P_MMSGOUT, "grinst und ist dann verschwunden");
                


  SetProp(P_DIE_MSG,  " zerfaellt zu Staub.\n");
  SetProp(P_NOCORPSE, 1);

 SetProp( P_RESISTANCE_STRENGTHS,([DT_BLUDGEON:0.3, DT_FIRE: -0.5,
 DT_UNHOLY: -1.0, DT_HOLY:0.1, DT_COLD:-1.0]));      


  AddInfo(DEFAULT_INFO, "Stoere meine Totenruhe nicht.\n", "sagt: ");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");
  AddInfo(({"drache","skelettdrache"}),
  "Unser Meister!!!", "sagt: ");
  AI(({"skelett", "goblinskelett"}),
  "Ich bin eines!", "bruellt: ");
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Was soll ein Goblinskelett mit @WEM?\n" }) );

  SetProp(P_SPELLRATE,60);
  
  AddSpell(5,350,
    "Das Goblinskelett haucht Dich mit seinem Todesatem an.\n",
    "Das Goblinskelett haucht @WEN mit seinem Todesatem an.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,500,
    "Das Goblinskelett sticht Dir mit seinen spitzen Fingern ins Auge.\n",
    "Das Goblinskelett sticht @WEM mit seinen spitzen Fingern ins Auge.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
  "Das Goblinskelett grinst Dich boese an.\n",
  "Das Goblinskelett deutet Dir zu verschwinden!\n",
  "Das Goblinskelett sagt: Hau ab!!!\n",
  "Das Goblinskelett betet zum Skelettdrachen!\n",
  "Das Goblinskelett sagt: Klapper auch mal!\n",
  "Das Goblinskelett zeigt Dir ein winziges Zwergenskelett!\n",
  "Das Goblinskelett wuergt Dich!\n",
  "Das Goblinskelett klappert laut.\n"}) );

AI(({"zwergenskelett","zwergskelett"}),
"Ich muss es bewahren! Fuer Dich ist das nichts!", "sagt: ");


SUID;
CLONEME("d/unterwelt/dante/skel/winskel");
 
 /*if(!random(5))  {
 	CLONEME("/players/dante/k3");
  }
*/


}

