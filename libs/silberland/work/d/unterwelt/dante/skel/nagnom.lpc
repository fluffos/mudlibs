//narbengom

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>    
#include <npc.h>    


init() {
::init();
if(interactive(TP)) {call_out("tag", 0); }
}

void tag()
{
 if(environment(TP)!=environment(TO))
     return;
     write("Der Narbengnom grunzt: "+TPN+", hau ab! Verschwinde!\n");
     }
     


create()
{
  if (!is_clone(this_object())) return;
  ::create();

  create_default_npc (15);
SetProp (P_LONG, BS("Dies ist ein grimmig dreinschauender Gnom. Er hat ein zernarbtes"
 ", gelbes, von Pocken entstelltes Gesicht. Der Gnom scheint ausserdem sehr kampferprobt zu sein, weil "
 "er jede Menge Schrumpfkoepfe diverser Kreaturen an seinem Guertel haengen hat. "
 "UPPPS, auch ein menschlicher Kopf haengt daran, und Du fragst Dich, ob er es nun auf Deinen Kopf abgesehen hat."));

SetProp (P_NAME, "Narbengnom");
  SetProp (P_GENDER, MALE);
AddId (({"gnom", "narbengnom"}));
SetProp (P_SHORT, "Ein Narbengnom");
  SetProp (P_ALIGN, -500);
  SetProp (P_BODY, 35);
  SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 0.4, DT_TERROR:-1.0, DT_FIRE:0.6]));   
SetProp (P_HANDS, ({" mit seinen verpockten Pranken", 330+random(30), DT_BLUDGEON}) );

  SetChats (3, ({
"Der Gnom schaut sich veraengstigt nach Feinden um.\n",
"Der Gnom sucht sich einen Weg, um zu entkommen.\n",
"Der Gnom fuchtelt Dir mit einem geklauten Kriegshammer vor der Nase herum.\n",
"Der Gnom mustert Dich und ueberlegt, ob er Dich nicht als Nagel benutzen soll.\n"
  }) );

  SetAttackChats (5, ({
"Der Gnom ruft seine gelben Kameraden um Hilfe !\n",
"Du kannst nur hoffen, dass der Kampf keine weiteren Pockengesichter anlockt.\n",
  }) );


 SetProp(P_MSGIN, "steht ploetzlich vor Dir");
   SetProp(P_MSGOUT, "verschwindet");
     SetProp(P_MMSGIN, "taucht ploetzlich auf");
       SetProp(P_MMSGOUT, "verschwindet");
  SetProp (P_DIE_MSG, " bricht mit einem Todesschrei zusammen.\n" );
 SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));  
  AddInfo ("\ndefault info", "beachtet Dich gar nicht.\n"); 
  AddInfo ( ({"zwerg","zwerge","zwergen"}), "vor Deine Fuesse.\n", "spuckt ");
AddInfo( ({"gnom","gnome"}), "popelt nervoes in seiner Nase herum.\n");

 SUID;
  CLONEME("/d/unterwelt/dante/skel/gnoha");
       command("zuecke kriegshammer");
       

  SetProp(P_AGGRESSIVE,0);  
    SetProp(P_HEAL,-5);
     SetProp(P_SPELLRATE,70);             
     
      AddSpell(4,200,   
     "Der Narbengom spuckt Dich an.\n",
     "Der Narbengnom spuckt @WEN an!\n",
      DT_ACID,([SP_SHOW_DAMAGE:1]));                  


      AddSpell(1,400,   
     "Der Narbengom wuergt Dich brutal.\n",
     "Der Narbengnom wuergt @WEN brutal!\n",
   DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));      
   
   
      AddSpell(2,300,   
     "Der Narbengom tritt Dich nieder.\n",
     "Der Narbengnom tritt @WEN nieder!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));         
   
//er hat zwar wenig body und lps aber haut gewaltig zu
//runter auf 2 3 4 dante gemaess dem befehl von stahl:))




}

