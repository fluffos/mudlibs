/* das ist das skelett von max dem wirt aus midas von woody
natuerlich veraendert/vereinfacht usw
*/


inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include "/players/dante/myowndefine.h"

init() {
::init();
if(interactive(TP)) {call_out("tag", 0); }
}

    tag()
{                                                        
if(environment(TO)!=environment(TP))  return;
write(BSA(
"Hallo, "+CAP(getuid(TP))+"! Endlich einmal ein Gast!",
"Max, das Skelett sagt: "));
}


create()
{

if (!is_clone(TO)) return;
  ::create();


  AddId ( ({"max","wirt","\nmax", "NOWIMPY", "skelett"}) );
  SetProp (P_LONG, BS(
"Das ist das Skelett von Max, dem Wirt aus Midas. Irgendwie muss "
"es sich hierher verirrt haben. Sogar als Skelett uebt Max seinen "
"Beruf als Wirt noch aus!"));

AddClass(CL_UNDEAD);
  SetProp (P_NAME, "Max, das Skelett");
  SetProp (P_ARTICLE, 0);
  SetProp (P_GENDER, MALE);
  SetProp (P_SHORT, "Max, das Skelett");
  SetProp(P_RACE, "Skelett");
  SetProp (P_ALIGN, -300);
  create_default_npc(20);
  SetProp (P_MAX_HP, 1000);
  SetProp (P_SIZE, 170+random(10));
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_IGNORE, ({ "spendiere" }) );
  SetProp (P_HANDS, ({" mit seinen knoechernen Haenden", 160, DT_BLUDGEON}) );


  SUID;
  CLONEME("/p/armour/cloak/schuerze");
  command ("ziehe schuerze an");

  SetProp(P_SPELLRATE,60);


  SetChats(2, ({
    "Max, das Skelett mustert Dich erwartungsvoll.\n",
    "Max, das Skelett jongliert ein wenig gelangweilt mit drei Glaesern.\n",
    "Max, das Skelett fuellt einen Krug Bier ab.\n",
    "Max, das Skelett fuellt grinsend ein Glas mit Orangensaft.\n",
    "Max, das Skelett schuettet verachtungsvoll Cola in ein Glas.\n",
    "Max, das Skelett uebt sich auf eine Rechnung konzentriert in der Kunst der Addition.\n",
    "Max, das Skelett schaut Dich ein wenig besorgt an.\n",
  }) );

  SetAttackChats(8, ({
    "Max, das Skelett schreit: Na warte, das wirst Du bereuen!\n",
    "Max, das Skelett ruft: Hilbert, hilf mir!\n",
    "Max, das Skelett fluestert Lars etwas zu.\n",
    "Max, das Skelett stiert Dich entgeistert an.\n",
    "Du fuehlst Dich schuldig.\n"
  }) );

  SetProp (P_DIE_MSG, " bruellt laut auf und zerfaellt zu staub.\n");
  SetProp (P_DEFAULT_INFO, "antwortet: Frag nicht so doof sondern lies "+
                           "erstmal das Menue hier!\n");
SP(P_NOCORPSE, 1);
  AddInfo ( ({"max","wirt", "skelett"}),
      "brummt: Ueber mich gibts nicht viel zu erzaehlen.\n");

  AddInfo ( ({"kneipe","kneipen"}),
      "Gefaellt es Dir hier?", "fragt Dich: ");
  AddInfo ( ({"hunger","durst","essen","trinken",
              "getraenk","getraenke","speise","speisen"}),
      "Wenn Du genug Geld dabei hast, will ich Deinen Hunger und Deinen "
      "Durst gerne stillen!", "sagt: ");
  AddInfo ( ({"menue","angebot","speisekarte","karte"}),
      "sagt: Mit <menue> kannst Du Dir einen Ueberblick verschaffen!\n"
      "Max, das Skelett schaut boese.");


  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Max, das Skelett sagt: Kauf lieber was!!!\n" }) );
  
  AddSpell(5,350,
    "Max, das Skelett haucht Dich mit seinem Todesatem an.\n",
    "Max, das Skelett haucht @WEN mit seinem Todesatem an.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,500,
    "Max, das Skelett sticht Dir mit seinen spitzen Fingern ins Auge.\n",
    "Max, das Skelett sticht @WEM mit seinen spitzen Fingern ins Auge.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));


}
