inherit "/p/std/dragons/dragon";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <wizlevels.h>
#include <new_skills.h>
#include <class.h>
#include "/gilden/waldlaeufer/ranger_tasks.h"

void create()
{ 
  if (!is_clone(this_object())) return;
  ::create();    
  create_default_dragon(0,10+random(3),0,35+random(15));

  AddId(({"drache","skelettdrache", "nekromortium"}));
  SetProp(P_LONG,BS(
    "Der Skelettdrache Nekromortium ist einer der boesartigesten Drachen "
    "des Silberlands! Viele unvorsichtige Abenteurer mussten seine "
    "Bekanntschaft mit dem Leben bezahlen. Schaurig klappert er mit seinen "
    "Knochen und Deine Gaensehaut wird fast unertragbar..."));
  SetProp(P_NAME, "Nekromortium");
  SetProp(P_SHORT, "Nekromortium, der Skelettdrache");
  SetProp(P_NAME_ADJ, 0);//muss so bleiben!!!
  SetProp(P_ARTICLE, 0);
  AddClass(CL_UNDEAD);//dante

  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS)+
      ([DT_BLUDGEON: 0.6, DT_HOLY:0.3, DT_RIP:-0.5, DT_PIERCE:-0.5]));

  SetProp(P_AGGRESSIVE, 0.1);

  SP(P_SPELLRATE, 70);

  AddId(({"nekromortium","drache","skelettdrache"}));

  set_living_name("skelettdrache");

  AddSpell(2,100,
      "Der Skelettdrache versucht Dir Lebensenergie zu entziehen!\n",
      "Der Skelettdrache versucht @WEM Lebensenergie zu entziehen!\n",
      DT_MAGIC, "spell_hp", ([SP_SHOW_DAMAGE:1]));

  AddSpell(2,100,
      "Der Skelettdrache versucht Dir magische Energie abzusaugen!\n",
      "Der Skelettdrache versucht @WEM magische Energie abzusaugen!\n",
      DT_MIND, "spell_mp", ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,100,
      "Der Skelettdrache schuechtert Dich ein!\n",
      "Der Skelettdrache schuechtert @WEN ein!\n",
      DT_TERROR, "spell_vorsicht", ([SP_SHOW_DAMAGE:1]));

  SUID;
  CLONEME("d/unterwelt/dante/skel/knoring");
}


void spell_vorsicht(object enemy, int damage, mixed dam_type)
{
  int plvo;
  plvo=enemy->QueryProp(P_WIMPY);
  enemy->SetProp(P_WIMPY, plvo/2);
}

void spell_mp(object enemy, int damage, mixed dam_type)
{
  int plmp;
  int rand;

  rand=3+random(3);
  plmp=enemy->QueryProp(P_SP);

  if(deep_present("zwergenskelett", enemy)) {
    tell_object(enemy,
        "Das Zwergenskelett wehrt den Angriff des Skelettdrachen ab und lenkt einen\n"
        "schwarzen Pfeil mitten in den Kopf des Skelettdrachen.\n"
        "Nekromortium greift sich so selbst an!!!\n");

    TO->Defend(200+random(100), DT_MAGIC, 
        ([SP_SHOW_DAMAGE:1, SP_NAME: "Zwergenskelettpfeil"]), enemy);
  }

  if(!random(2))  {
    enemy->AddSp(-plmp/rand);
    tell_object(enemy,
        "Deine Magie wird schwaecher!\n");

  }
  else {
    tell_object(enemy,
        "Du schaffst es Dich der Magie des Skelettdrachen zu widersetzen!\n");  }


  //also:z.b: 170/3=56....
  //.. je mehr mps der spieler noch hat,
  //desto mehr kommt weg...
}


void spell_hp(object enemy, int damage, mixed dam_type)
{

  if(deep_present("zwergenskelett", enemy)) {
    tell_object(enemy,
        "Das Zwergenskelett wehrt den Angriff des Skelettdrachen ab und lenkt einen\n"
        "grellen, hellroten Strahl mitten in das Herz des Skelettdrachen.\n"
        "Nekromortium greift sich so selbst an!!!\n");

    TO->Defend(200+random(200), DT_MAGIC, 
        ([SP_SHOW_DAMAGE:1, SP_NAME: "Zwergenskelettrueckschlag"]), enemy);
  }

  else

  if(!random(2))  {
    tell_object(enemy,
      "Der Skelettdrache heilt sich mit Deiner Lebensenergie!\n");
    switch(random(10))
    {
      case 0..2:
        enemy->AddHp(-20-random(20));
        TO->AddHp(30);//mittelwert           
        break;
      case 3..4:
        TO->AddHp(45);
        enemy->AddHp(-30-random(30));           
        break;
      case 5..6:
        TO->AddHp(60);
        enemy->AddHp(-40-random(40));           
        break;
      case 7..8:
        TO->AddHp(75);
        enemy->AddHp(-50-random(50));           
        break;
      case 9:
        TO->AddHp(150);
        enemy->AddHp(-100-random(100));           
      default:write("BUG!\n");           
    }  
  }
  else  {
    tell_object(enemy,
        "Du kannst den Zauber des Skelettdrachen gerade noch abwehren!\n");
  }
}


_query_wimpy() { return 0;}


// Kills mitloggen
void die(int poisondeath)
{
  object ob, killer;
  if(objectp(ob=present("\nbarden_hero_killquest", QueryProp(P_KILLER)))) {
    ob->Mark();
  }

  killer = QueryProp(P_KILLER) || TP;
  if(objectp(killer)) {
    if(killer->id("\nranger_pet")) {
      killer = killer->QueryOwner();
    }

    if(killer->QueryProp(P_GUILD) == "waldlaeufer" && !RANGER_CHECK_TASK(killer, 14)) {
      killer->Message("Raziel teilt Dir mit: Hervorragende Arbeit! Das wird unsere Feinde eine Zeit aufhalten!", MSGFLAG_TELL);
      RANGER_SET_TASK(killer, 14);
    }
  }
  
  write_file("/d/unterwelt/dante/log/skelettdrachestirbt",
      ctime()+": "+CAP(getuid(TP))+" killt den Skelettdrachen.\n");
  if( !IS_LEARNER(TP) )
    domainshout(CAP(TP->query_real_name())+
        " hat den Skelettdrachen bezwungen.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/d/unterwelt/dante/log/skelettdrachetoetet",           
      ctime()+": Der Skelettdrache hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

