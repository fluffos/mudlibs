

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <moving.h>
#include <mnpc.h>


create()

{

::create();


SetProp( P_INDOORS, 1 );
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
SP(P_INT_SHORT,"Im Reich des Skelettdrachen");
SP(P_LIGHT,1);
SP(P_INT_LONG, BS(
"Du bist nun im hohlen Totenschaedel, einem Bauwerk aus laengst vergangener Zeit. "
"Weiss und grau schimmern die Waende, die aus unzaehligen Knochenplatten "
"gefertigt wurden. Viele unvorsichtige Sterbliche hat der Skelettdrache gemeuchelt "
"um sich dieses Monument zu errichten. Die Treppe fuehrt nach unten  "
"und oben endet sie an einem dunklem Loch."));

AD(({"drache","skelettdrache"}),
"Der Skelettdrache ist schon ganz nahe!!!");
AD("monument",
"Dieses Bauwerk wurde aus genau einer Million Opfer errichtet. ");
AD(({"opfer","million"}),
"Naja ganz so genau weiss, das eigentlich keiner, oder glaubst Du Drachen koennen zaehlen?\n");
AD(({"platten","knochen","knochenplatten","platte","knochenplatte"}),
"Die Knochenplatten hat man durchbohrt und mit den langen, duennen Knochen der "
"Opfer verbunden. So entstand in jahrtausender langer Arbeit dieses Bauwerk.");
AD("arbeit",
"Dafuer verwendete man Sklaven.");
AD(({"sklave","sklaven"}),
"Dante hat angeblich sehr lange hier geschuftet.");

AD(({"sterbliche","sterblicher"}),
"Viele kamen hier her, aber keiner kehrte je zurueck,");
AD("zeit",
"Vor vielen Jahren kaempfte das Gute gegen das Boese um das Heil des Silberlandes. "
"Nach tausend Jahren Kampf siegte schliesslich das Gute ueber das Boese und verbannte "
"es in diese Dimension .");
AD(({"gute","boese","heil","silberland","jahre","dimension","kampf"}),
"Hier ist die Dimension der Daemone und des Schreckens!!!");
AD("schrecken",
"Den lernst Du hier kennen.");
AD(({"daemon","daemone"}), 
"Draussen lauern sie auf Dich...");



AD(({"wand","waende"}),
"Die Waende sind glatt und glaenzen weisslich. Ab und zu hat man einen kleineren "
"Totenschaedel an die Wand genagelt. Er ist hohl und darin brennt Oel. So wird "
"das ganze Bauwerk in ein unheimlich flackerndes Licht getaucht.");
AD("licht",
"Das Licht tanzt hin und her.");
AD("oel",
"Hier flackert das Licht besonders seltsam. Das Oel scheint nicht in Ordnung zu sein.");
AD("ordnung",
"Ordnung interessiert Dich nicht, wohl aber die Oeffnung in der Wand.");
AD("oeffnung",
"Durch die Oeffnung sieht man einen kleinen Vorsprung am Schaedel. Interessant!!!");
AD("vorsprung",
"Der Vorsprung ist eine grosse Augenhoehle.");
AD(({"auge","augen","hoehlen","hoehle","augenhoehle","augenhoehle"}),
"Auge ist natuerlich keines hier, aber die Augenhoehlen sind wie ein Balkon.");
AD("balkon",
"Sehr interessant!!!");

AD(({"schaedel","totenschaedel"}),
"Das ganze Bauwerk ist ein gigantischer nachgebildeter Totenschaedel. An den Waenden "
"haengen kleinere, echte, Totenschaedel. Der Schaedel von Dante ist auch dabei, "
"seitdem rennt er kopflos herum...");
AD("dante",
"Lass das!");


AD("treppe", 
"Die Treppe fuehrt hier sowohl nach unten als auch weiter nach oben. Doch irgendetwas "
"in Dir warnt Dich eindringlichst weiter nach oben zu gehen.");

AD("decke",
"Die Decke ist von hier zu erkennen. Die ist fast ober Dir. Durch ein Loch fuehrt "
"die Treppe aufs Dach des Bauwerks.");
AD("loch", 
"Das Loch ist gross genug fuer Dich. Es fuehrt auf das Dach des Schaedels. Was wohl "
"oben auf Dich wartet?");
AD("dach",
"Durch das Loch kommst Du aufs Dach des Bauwerkes.");
AD("boden",
"Du bist nun doch schon hoch ueber dem Boden. Nach unten zu springen ist nicht "
"anzuraten. Der eigentliche Boden hier ist die Treppe, die aus duennen Knochenplatten "
"gebaut wurde. Du entdeckst einen dunklen Haufen.");
AD("haufen",
"Der Haufen ist Drachenkot.\n");
ASD(({"kot","drachenkot"}), "get");

AD("gebaeude",
 "Ein riesiger Totenschaedel.");
 AD("bauwerk",
 "Das Bauwerk ist sehr hoch, es ragt bis hoch in den Himmel.");
 AD("himmel",
 "Den kann man hier natuerlich nicht sehen, aber die Treppe "
 "scheint noch weiter nach oben zu fuehren...");
 

AIT("d/unterwelt/dante/skel/skel",REFRESH_DESTRUCT, 
([ P_MNPC_AREA:"/d/unterwelt/dante/skel/sk5",
   P_MNPC_DEFAULTROOM:"/d/unterwelt/dante/skel/sk5",
   P_MNPC_FLAGS:  MOV_BACKWARDS , 
   //das is alles absicht...
  ]));
AIT("d/unterwelt/dante/skel/skel",REFRESH_DESTRUCT, 
  ([P_MNPC_DEFAULTROOM: "/d/unterwelt/dante/skel/sk5",
  P_MNPC_FLAGS: MOV_MOVES+MOV_BACKWARDS+MOV_INDOORS,
  ]));
  
 
// AddGuardedExit("oben", "/d/unterwelt/dante/skel/dach", "SKEL",
// "Das Skelett sagt: Nein, da oben wohnt der Skelettdrache!\n");

SP(P_KILL_NAME, "Eine Skeletttreppe");
SP(P_KILL_MSG, "Du bist ja auch kein Kaenguruh, Du Kuh!");

AE("oben", "./dach");

AE("unten", "./sk4");
 
 ACD(({"spring","springe"}), "tot");
 ACD(({"kletter","klettere","steige","steig","krieche","kriech"}), "go");
 }
 
 int go(string str)
 {
 NF("Wo willst Du durch oder raus?\n");
 if(member(({"durch oeffnung raus","durch oeffnung auf balkon",
 "durch oeffnung in augenhoehle","auf balkon","auf balkon raus",
"raus", "hinaus auf balkon","hinaus in hoehle","raus auf balkon"}),str)!=-1)  {
 
 write("Du kletterst durch die Oeffnung hinaus auf den Balkon.\n");
 TP->move("d/unterwelt/dante/skel/sk7", M_GO, "hinaus aus dem Schaedel",
 "klettert"," kommt aus dem Schaedel gekrochen");
 return 1;}
 return 0; }
 
 
 int tot(string str)
 {
 NF("Willst Du nach unten springen?\n");
 if(str=="nach unten"||str=="runter"||str=="zu boden") {
 write
 ("Du Wahnsinniger nimmst Deinen ganzen Mut zusammen "
 "und springst nach unten!!!\n");
 TP->move("/d/unterwelt/dante/skel/sk3", M_TPORT, "todesmutig nach unten"
 "springt", "kommt von oben heruntergeflogen");
 TP->do_damage(50, TO); 
 write("Du verletzt Dich beim Aufprall schwer, aber Du lebst! Noch...\n");
 return 1;}
 
 return 0; }
 
 
   string get()
   {
   object ob;
   if(!present("GESTANK", TP))
   {
   ob=clone_object("d/unterwelt/dante/skel/gestank");
   ob->move(TP, M_GET);
   write("WAEH!! Der Kot stinkt! Und Du nun auch!\n");
   }
   else
   { write("Der Drachenkot stinkt fast so wie Du!\n");
   }
   return "";
   }
   
   
   
   
   
   
