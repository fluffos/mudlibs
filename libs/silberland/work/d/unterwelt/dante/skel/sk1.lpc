//raum1 hinter mauer in der dimension der daemonen
//
//
//



#include <moving.h>          
inherit "std/room";
#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <mnpc.h>

int skelnr;

create()
{
  ::create();

  skelnr = 0;


SP(P_INT_SHORT,"Im Reich des Skelettdrachen");

SP(P_INT_LONG, BS(
"Du bist nun im hohlen Totenschaedel, einem Bauwerk aus laengst vergangener Zeit. "
"Weiss und grau schimmern die Waende, die aus unzaehligen Knochenplatten "
"gefertigt wurden. Viele unvorsichtige Sterbliche hat der Skelettdrache gemeuchelt "
"um sich dieses Monument zu errichten. Im Osten kannst Du durch ein Tor wieder "
 "in den undurchdringbaren Nebel."));
   SetProp( P_LIGHT, 1 );
     SetProp( P_INDOORS, 1 );
       SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
 
 
 
 AD(({"drache","skelettdrache"}),
 "Der Skelettdrache teilt Dir mit: Ich warte auf Dich!!!");
 AD("monument",
 "Dieses Bauwerk wurde aus genau einer Million Opfer errichtet. ");
 AD(({"opfer","million"}),
 "Naja ganz so genau weiss, das eigentlich keiner, oder glaubst Du Drachen koennen zaehlen?\n");
 
 AD(({"platten","knochen","knochenplatten","platte","knochenplatte"}),
 "Die Knochenplatten hat man durchbohrt und mit den langen, duennen Knochen der "
 "Opfer verbunden. So entstand in jahrtausender langer Arbeit dieses Bauwerk.");
 AD("arbeit",
 "Dafuer verwendete man Sklaven.");
 AD(({"sklave","sklaven"}),
 "Dante hat angeblich sehr lange hier geschuftet.");
 
 AD(({"sterbliche","sterblicher"}),
 "Viele kamen hier her! Aber keiner kehrte je zurueck, alle wurden sie geschlachtet!");
 AD("zeit",
 "Vor vielen Jahren kaempfte das Gute gegen das Boese um das Heil des Silberlandes. "
 "Nach tausend Jahren Kampf siegte schliesslich das Gute ueber das Boese und verbannte "
 "es in diese Dimension.");
 AD(({"gute","boese","heil","silberland","jahre","dimension","kampf"}),
 "Hier ist die Dimension der Daemone und des Schreckens!!!");
 AD("schrecken",
 "Den lernst Du hier kennen.");
ASD(({"daemon","daemone"}), "daemcome");
 AD("nebel",
 "Er verschlingt alles...");
 
 
 AD(({"wand","waende"}),
 "Die Waende sind glatt und glaenzen weisslich. Ab und zu hat man einen kleineren "
 "Totenschaedel an die Wand genagelt. Er ist hohl und darin brennt Oel. So wird "
 "das ganze Bauwerk in ein unheimlich flackerndes Licht getaucht.");
 AD("licht",
 "Das Licht tanzt hin und her.");
 AD("oel",
 "Das Oel verbrennt in den Totenschaedeln und erzeugt so etwas Licht fuer Dich.");
 AD(({"schaedel","totenschaedel"}),
 "Das ganze Bauwerk ist ein gigantischer nachgebildeter Totenschaedel. An den Waenden "
 "haengen kleinere, echte, Totenschaedel. Der Schaedel von Dante ist auch dabei, "
 "seitdem rennt er kopflos herum...");
 AD("dante",
 "Lass das!");
 
 
 
 AD("decke",
 "Die Decke ist von hier nicht zu sehen, das Gebaeude ist viel zu hoch...");
 AD("boden",
 "Der Boden besteht aus blankpolierten Knochenplatten. Er glaenzt und schimmert hell. "
 "Manchmal glaubst Du Dein Spiegelbild darin zu erkennen.");
 ASD(({"bild","spiegelbild"}),  "show");
 AD("gebaeude",
 "Ein riesiger Totenschaedel.");
 AD("bauwerk",
 "Das Bauwerk ist sehr hoch, es ragt bis hoch in den Himmel.");
 AD("himmel",
 "Den kann man hier natuerlich nicht sehen...");
 AD("osten",
 "Im Osten liegt das Tor, durch das Du hereingekommen bist.");
 
 
 
 AddGuardedExit("norden", "/d/unterwelt/dante/skel/sk2","SKEL",
  "Das Skelett sagt: Nur wenn Du mir vorher den Schaedel spaltest!\n");


AIT("d/unterwelt/dante/skel/skel",REFRESH_DESTRUCT, ([SP(P_MNPC_AREA, 
  "/d/unterwelt/dante/skel/sk1")]));
  //damit der bursche uns net davonlaueft
  


 NewDoor("osten", ("/d/unterwelt/dante/skel/tor"),
   ({"tor"}),
   
      ({
          D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
               D_LONG, 
       "Das Tor fuehrt wieder hinaus in den undurchdringbaren Nebel.",
               D_GENDER, NEUTER,
                D_SHORT, "Ein %ses Tor.",
                D_NAME, "Tor",
                                     
                }));

 
 
}
 
string daemcome()
   {
   object ob;
   if ( skelnr < 3 )
     {
   if(!present("SKEL", environment(TP)))
       {ob=clone_object("d/unterwelt/dante/skel/skel");
            ob->move(environment(TP), M_TPORT+M_SILENT);
            ob->SetProp(P_SHORT, "Ein Skelett von "+CAP_TPN+" gerufen");
                 ob->Kill(TP);
          say(CAP_TPN+" beschwoert ein Skelett!!!\n");
	  skelnr = skelnr + 1;
	return
          "Ein Skelett bruellt: "+CAP_TPN+", Du hast mich gerufen!!!\n";
       }
         else
         {
	  say(CAP_TPN+" will sterben...\n");
	  return
            "Neben Dir steht ein Skelett, wozu einen Daemonen!\n";
         }
          return
	    "Derzeit sind keine Daemonen in der Naehe.\n";
      }
          return
            "Derzeit sind keine Daemonen in der Naehe.\n";
   }

string show()
   {
   write("Du glaubst einen grossen Skelettdrachen zu erkennen, der Dich "
   ""+CAP_TPN+" mit einem Biss verschluckt!\n");
   return "";
   }
   
void reset ()
  {
    skelnr = 0;
  }

