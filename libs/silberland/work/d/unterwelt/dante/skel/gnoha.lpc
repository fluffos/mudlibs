#include <properties.h>        
#include <combat.h>
#include <language.h>

inherit "/std/weapon";

create ()
{
        ::create();
        SetProp(P_WEAPON_TYPE, WT_CLUB);
SetProp(P_INFO, break_string("Dies ist ein schwerer, geschmiedeter Kriegshammer der alten Zwergenschmiede"
+". Er ist am Griff mit geheimen Zeichen bedeckt. Du fragst Dich, ob der Hammer"
+" magische Kraefte besitzt ?!?", 78));
        SetProp(P_DAM_TYPE, DT_BLUDGEON);
SetProp(P_GENDER, MALE);
SetProp(P_VALUE, 1900+random(500));
SetProp(P_WEIGHT, 2000);
SetProp(P_SHORT, "Ein Kriegshammer");
SetProp(P_NAME, "Kriegshammer");
 SetProp(P_WC, 220);
SetProp(P_LONG, break_string("Dieser Kriegshammer wurde von unbekannten Schmieden hergestellt."
+" Diese Schmiede besassen, wie Du an der Feinheit und Schoenheit"
+" der Waffe erkennen kannst, ein unglaubliches Wissen in der"
" Waffenschmiedekunst. Der Hammer liegt Dir, trotz seines"
+" nicht unbedeutenden Gewichts sehr gut in der Hand.\n", 78));
        AddId("waffe");
AddId("hammer");
AddId("kriegshammer");
AddId("Hammer");
        SetProp(P_NR_HANDS, 1);
  SetProp (P_MAGIC, 1);   
  SetProp (P_NOBUY, 1);    
  SetProp (P_WC_FIX, 50);    
 SetProp (P_MATERIAL, ([ MAT_STEEL:100]));    
 SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 10, A_INT:15, A_DEX:15]));
    


}
