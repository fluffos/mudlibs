
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

create()
{
  ::create();


  SetProp( P_INT_SHORT, "In einem dunklen Schacht" );
  SetProp( P_INT_LONG, BS(
   "Du steckst in einem Schacht, der aus blanken Stein gehauen wurde. "
   "Er fuehrt tief nach unten in die Dunkelheit. Die Waende sind ueber und "
   "ueber mit seltsamen Zeichen bemalt. Irgendwie spuerst Du, dass "
   "sich etwas Unheimliches und Boesartiges schon recht nahe befindet. "
   "Verabschiede Dich schon von Deinem Teddy!"));

 AD(({"fackel","fackeln"}),
  "Sie werfen gespenstische Schatten.");


AD("teddy",
"Eigentlich konntest Du den ohnehin nie leiden. Tritt ihn doch!");


AD("boesartiges",
"Du solltest Deine Vorsicht besser erhoehen...");
AD("vorsicht",
"Deine Vorsicht ist ohnehin immer auf Hosenscheisser gestellt.");
AD("hosenscheisser",
"Schau mal in den Spiegel.");
AD("spiegel",
"Eklig was Du da siehst, oder?");
AD("unheimliches",
"Bald, bald bist Du am Ziel.");
AD("ziel",
"Das Ziel ist Dein Tod, wie immer.");
AD("tod",
"Sterben ist lustig.");

AddDetail("schacht",
"Schmal, dunkel und unfreundlich.");
AddDetail("stein",
"Der Stein ist recht glatt und schwarz. Er ist ueber und ueber mit Zeichen "
"bedeckt.");
AddDetail("dunkelheit",
"Tja, wie das eben so mit der Dunkelheit ist, man sieht nicht viel in ihr...");
AddDetail("decke",
  "An der Decke entdeckst Du einen Pfeil. Nebenbei ist da auch ein Loch "
  "durch das Du heruntergeklettert bist.");
  AddDetail("loch",
  "Durch das Loch in der Decke kommst Du wieder nach oben.");

  AddDetail("pfeil",
  "Der Pfeil zeigt auf einen Spalt.");
  AddDetail("boden",
  "Boden gibt es hier auch kaum, wenn schon einen sehr schiefen, der steil nach unten fuehrt.");
  AddDetail(({"wand", "waende"}),
  "Die Waende sind glatt, manchmal ein Kratzer oder eine kleine Erhebung, "
  "aber was Dich wirklich interessiert sind die seltsamen Zeichen an der Wand. "
  "Fackeln erhellen den Schacht und tauchen alles in ein gespentisches Licht!");
  AddDetail("licht",
  "Dunkle Schatten tanzen an den Waenden.");
  AD("schatten",
  "Sie sehen gespenstisch aus...");
  AddDetail("zeichen",
  "Die Zeichen sind ueberall, was sie bedeuten weisst Du nicht genau, "
  "aber es hat wohl etwas mit einem Drachen zu tun...");
  AddDetail(({"drachen","drache"}),
  "Hmm, Du glaubst folgendes zu entziffern:\n"
  "Fremder, sei auf der Hut, Du betritst das Reich des Skelettdrachen.\n");
AddDetail(({"drache","drachen","skelettdrache"}),
"Vielleicht triffst Du ihn ja...");
AddDetail("reich",
"Hier herrscht der Skelettdrache!");
AddDetail("hut",
"Du singst 'Ich kauf mir einen Tirolerhut, der steht mir so gut...'");

  AddDetail("kratzer",
  "Laenglich oder auch nur kurz fuehren sie ueber die Waende.");
  AddDetail("erhebung",
  "Die Erhebungen sind auch nicht viel interessanter.");

AddDetail("spalt",
"Durch den Spalt kann man sich durch zwaengen.");

  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst Stimmen unter Dir.");

    AddCmd(({"zwaenge","zwaeng"}), "raus");

 AddItem("d/unterwelt/dante/skel/nagnom", REFRESH_DESTRUCT);

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach nichts.");
  AddExit("oben", "/d/unterwelt/basics/central/room/00+11+04.lpc");//sollte passen der raum

  AddExit("unten", "./portal2");

//ASE("unten", "nix");

AddSound(({"stimme","stimmen"}),
"Die Stimmen scheinen von weiter unten zu kommen.\n");

 }



int nix()  {
  write(BSA(
"Leider musste ich diesen Ausgang sperren. Wenn Dich das stoert mail mir das bitte. "
"Diese Streikmassnahme musste ich machen, weil die Balance, bestehend aus "
"Woody, Feyaria und Zordan, nichts tut und so das Silberland schaedigt und "
"das Wachstum unserer Welt behindert. Mail ihnen das ruhig!!! DANKE!!!! Und "
"bitte habe Verstaendnis dafuer!!!",
"Dante teilt Dir mit: "));

return 1; }



 int raus(string str)
    {
       notify_fail("Wo willst Du Dich durchzwaengen?!\n");
 if(str=="durch spalt"||str=="in spalt")
      {
write("Du versuchst Dich durch den Spalt zu zwaengen, bist aber mit "
"Deinen "+TP->QueryProp(P_WEIGHT)/1000+" Kilos viel zu fett. Komm wieder, "
"wenn Du duenner bist.\n");
return 1;
                                    }
     return 0;
       }


