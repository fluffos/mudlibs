//neue raeume beim schaedel in der uwelt
//dante sl 2000

inherit "std/pub";
#include <pub.h>  
#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <moving.h>


create()

{

::create();


SP(P_LIGHT, 1);
SP(P_INT_SHORT,"Im Reich des Skelettdrachen (Kneipe)");
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );




SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
 SetProp(P_PUBKEEPER_ID, "max");
      SetProp(P_PUBKEEPER_NAME, "Max das Skelett");
 SetProp(P_PUBMSG_NOKEEPER, "Sorry, aber das Skelett Max ist nicht hier.\n");
SetProp(P_PUBMSG_NOENEMY, BS(
"Max, das Skelett serviert DIR hoechstens den Tod!"));

 SetProp(P_PUBMSG_NOINVITE, BS(
 "Max, das Skelett serviert Dir sicher nichts!"));
 SetProp(P_PUBMSG_FIGHTING, "Max, das Skelett ist doch beschaeftigt!!!\n");
                            
         
SP(P_INT_LONG, BS(
"Du bist nun im hohlen Totenschaedel, einem Bauwerk aus laengst vergangener Zeit. "
"Weiss und grau schimmern die Waende, die aus unzaehligen Knochenplatten "
"gefertigt wurden. Viele unvorsichtige Sterbliche hat der Skelettdrache gemeuchelt "
"um sich dieses Monument zu errichten. Hier hat sich Max, das Skelett, "
"niedergelassen und eine kleine, sehr spartanische Kneipe errichtet. "
"Eigentlich sieht man nur eine Theke und einen Tisch mit mehrern Stuehlen."));

AD("theke",
"Die Theke wurde, wie alles hier, aus Knochen errichtet.");
AD("tisch",
"Der Tisch besteht aus schweren Knochenplatten.");
AD(({"stuhl","stuehle"}),
"Die Stuehle wurden aus Knochen geschnitzt.");
AD(({"kneipe","kneipen"}),
"Ungemuetlich und unheimlich wirkt sie auf Dich. Sicher "
"die schaurigste aller Kneipen!");

AD(({"drache","skelettdrache"}),
"Der Skelettdrache teilt Dir mit: Ich warte auf Dich!!!");
AD("monument",
"Dieses Bauwerk wurde aus genau einer Million Opfer errichtet. ");
AD(({"opfer","million"}),
"Naja ganz so genau weiss, das eigentlich keiner, oder gaubst Du Drachen koennen zaehlen?\n");
AD(({"platten","knochen","knochenplatten","platte","knochenplatte"}),
"Die Knochenplatten hat man durchbohrt und mit den langen, duennen Knochen der "
"Opfer verbunden. So entstand in jahrtausender langer Arbeit dieses Bauwerk.");
AD("arbeit",
"Dafuer verwendete man Sklaven.");
AD(({"sklave","sklaven"}),
"Dante hat angeblich sehr lange hier geschuftet.");

AD(({"sterbliche","sterblicher"}),
"Viele kamen hier her, aber keiner kehrte je zurueck,");
AD("zeit",
"Vor vielen Jahren kaempfte das Gute gegen das Boese um das Heil des Silberlandes. "
"Nach tausend Jahren Kampf siegte schliesslich das Gute ueber das Boese und verbannte "
"es in diese Dimension .");
AD(({"gute","boese","heil","silberland","jahre","dimension","kampf"}),
"Hier ist die Dimension der Daemone und des Schreckens!!!");
AD("schrecken",
"Den lernst Du hier kennen.");
AD(({"daemon","daemone"}), 
"Die Daemone lauern draussen auf Dich...");



AD(({"wand","waende"}),
"Die Waende sind glatt und glaenzen weisslich. Ab und zu hat man einen kleineren "
"Totenschaedel an die Wand genagelt. Er ist hohl und darin brennt Oel. So wird "
"das ganze Bauwerk in ein unheimlich flackerndes Licht getaucht.");


AD("licht",
"Das Licht tanzt hin und her.");
AD("oel",
"Das Oel verbrennt in den Totenschaedeln und erzeugt so etwas Licht.");

AD(({"schaedel","totenschaedel"}),
"Das ganze Bauwerk ist ein gigantischer nachgebildeter Totenschaedel. An den Waenden "
"haengen kleinere, echte, Totenschaedel. Der Schaedel von Dante ist auch dabei, "
"seitdem rennt er kopflos herum.");


AD("dante",
"Lass das!");




AD("decke",
"Die Decke ist von hier nicht zu sehen, das Gebaeude ist viel zu hoch...");
AD("boden",
"Der Boden besteht aus blankpolierten Knochenplatten. Er glaenzt und schimmert hell. "
"Manchmal glaubst Du Dein Spiegelbild darin zu erkennen. "
"Doch halt! Was ist das?! Eine merkwuerdige Vorrichtung!");
AD("vorrichtung",
"Du siehst, das der Boden hier nicht so aussieht wie sonst. "
"Ein enorm dickes, dunkles Brett, lieht da am Boden!");
AD("brett",
"Das Brett ist auf der einen Seite mit Scharnieren am Boden "
"befestigt. Auf der anderen Seite entdeckst Du eine Verriegelung.");
AD(({"seite","scharniere","scharnieren"}),
"So ist das Brett beweglich. Aber nicht fuer Dich!");
AD("verriegelung",
"Die Verriegelung scheint das Brett am Boden zu fixieren. "
"Sie hat Rost angesetzt.");
AD("rost",
"Der Rost schimmert braeunlich!");




AD(({"bild","spiegelbild"}),  
"Dein Spiegelbild schaut Dich aengstlich an.\n");
AD("gebaeude",
"Ein riesiger Totenschaedel.");
AD("bauwerk",
"Das Bauwerk ist sehr hoch, es ragt bis hoch in den Himmel.");
AD("himmel",
"Den kann man hier natuerlich nicht sehen...");
AD("sueden",
"Im Sueden liegt das Tor, durch das Du hereingekommen bist.");
AD("tor",
"Das Tor ist weit weg.");



AE("sueden", "./n1");


 AIT("d/unterwelt/dante/skel/skelmax", REFRESH_DESTRUCT);



  AddDrink("Klapperwasser", ({"wasser", "klapperwasser"}),
      30, 12, 0, 3, //4*3=12
    ({"Du trinkst ein dreckiges Klapperwasser und klapperst dann herum.",
      "&& trinkt ein dreckiges Klapperwasser."}));
  


  AddDrink("Skelettbier", ({"bier", "skelettbier"}),
      80, 25, 3, 5, //11*3=33
    ({"Du trinkst ein kuehles Skelettbier.",
      "&& trinkt ein kuehles Skelettbier."}));
  
  
      
      
  AddDrink("Knochenwasser", ({"knochenwasser", "wasser", "knochen"}),
    140, 33, 0, 7,
    ({"Du bestellt Dir ein Knochenwasser und bekommst eine warme Milch "
    "in einer Tasse serviert auf der Mamis Liebling steht.",
      "&& bestellt sich ein Knochenwasser und jammert dabei aengstlich."}));
      
      
  AddDrink("Skelettkiller", ({"killer", "skelettkiller"}),
    190, 50, 8, 10,
    ({"Du trinkst einen Skelettkiller. WOW!! Das Zeug geht ab!",
      "&& trinkt einen Skelettkiller und schaut dann mordluestern."}));

 
      
  AddDrink("Skelett Special",({"skelett","special"}),
    250, 75, 11, 12,//
    ({"Du bekommst ein voellig durchsichtiges Getraenk. Anfangs zoegerst "
      "Du, aber dann nimmst Du allen Mut zusammen und trinkst es mit einen "
      "Schluck weg.",
      "&& bekommt ein voellig durchsichtiges Getraenk. && zoegert zuerst, "
      "nimmt dann aber allen Mut zusammen und trinkt es mit einem Schluck "
      "weg."}));

 AddDrink("Brennendes Inferno",({"inferno","brennendes inferno"}),
    400, 100, 18, 15,
    ({"Du bekommst einfach einen grossen Topf brennenden Rum. "
      "Du trinkst den Topf leer, verbrennst Dir hoellisch die Zunge "
      "und weisst nun warum das Getraenk Inferno genannt wird.",
      "&& bestellt sich ein brennendes Inferno, trinkst es und hat danach einen "
      "hochroten Kopf und eine verbrannte Zunge."}));
 
      
  AddDrink("Drachenblut", ({"blut", "drachenblut"}),
    666, 150, 30, 20,
    ({"Du bekommst einen grossen Krug, der randvoll gefuellt ist mit "
      "schwarzem, dickfluessigem Blut der verschiedensten Drachen. "
      "Du ekelst Dich, trotzdem schuettest Du es in Dich hinein und "
      "fuehlst Dich danach sehr stark.",
      "&& trinkt mit Ekel und Grausen einen grossen Krug, der randvoll "
      "mit Drachenblut ist."}));
  
  
 
//FOOOOOOOOOOODDDD
    
 

  AddFood ( "Goblinauge", ({"auge", "goblinauge", 
    }),  70, 25, 4,
    ({"Du bestellst Dir ein Goblinauge und bekommst eine schleimige, "+
    "glitschrige Kugel serviert. Du wuergst das Auge runter und musst Dich "+
    "fast uebergeben.",
    "&& bekommt eine schleimige, glitschrige Kugel serviert, die && nur "
    "unter Wuergen vertilgt."}));
    
     AddFood ( "Knochenkuchen", ({"kuchen", "knochenkuchen", 
    }),  80, 20, 6,
    ({"Du bestellst Dir ein Stueck Knochenkuchen, das so leicht ist, "+
    "dass es Dir fast wieder aus dem Magen heraufschwebt.",
    "&& bekommt ein Stueck Knochenkuchen. "}));
    
  AddFood ( "Knochenbrecherhirn", ({"hirn", "knochenbrecherhirnhirn"}), 
      140, 35, 10,
    ({"Du bekommst ein halbes Knochenbrecherhirn, dass erstaunlicherweise "+
    "koestlich schmeckt.",
    "&& bekommt ein halbes Knochenbrecherhirn. "}));
    
    AddFood ( "Toter Knochenbrecher", ({"toter knochenbrecher", "knochenbrecher","toter","toten"}), 
      180, 50, 13,
    ({"Du bestellt einen toten Knochenbrecher und erhaeltst tatsaechlich einen "
    "ganzen, wenn auch kleinen gebackenen Knochenbrecher, den Du mit grosser "
    "Muehe verschlingst.",
    "&& bestellt sich eine ganzen, wenn auch kleinen toten Knochenbrecher, den "
     "&& mit Muehe tatsaechlich alleine verschlingt."}));
     
     
     
     AddFood ( "Frisches Knochenherz", ({"herz", "knochenherz","Knochen"}), 
      200, 60,17 ,
    ({"Du isst mit Gruseln ein frisches Knochenherz. Was soll den das sein?!",
    "&& isst mit Gruseln ein frisches Knochenherz."}));
    
     AddFood ( "Gnom a la Surprise", ({"gnom","surprise", "surpris"}), 
      250, 10,4 ,
    ({"Du bekommst den Gnom a la Surprise und bist sehr enttaeuscht. "
    "Die Ueberraschung besteht aus einem kleinen Marzipangnom, der nicht einmal "
    "gut schmeckt...",
    "&& bestellt sich einen Gnom a la Surprise."}));
    
     AddFood ( "Magiergeschnetzeltes", ({"magier", "geschnetzeltes","magiergeschnetzeltes"}), 
      400, 100,25 ,
    ({"Das Magiergeschnetzeltes besteht aus geschnetzelten Magiern. "
    "Du entdeckst einige Bekannte und isst sofort alles auf!",
    "&& bestellt sich ein Magiergeschnetzeltes und schaut ziemlich doof "
    "drein, als && sieht was && sich da eigentlich kommen hat lassen."}));
    
 

}


