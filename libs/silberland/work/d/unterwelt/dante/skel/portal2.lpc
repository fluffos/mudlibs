
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>

#define  KREIS (member(kreis, getuid(this_player()))!=-1)
 string *kreis=({});


int schatten=1;

create()
{
  ::create();


  SetProp( P_INT_SHORT, "In einem dunklen Schacht" );
  SetProp( P_INT_LONG, BS(
   "Du steckst in einem Schacht, der aus blanken Stein gehauen wurde. "
   "Er fuehrt tief nach unten in die Dunkelheit. Die Waende sind ueber und "
   "ueber mit seltsamen Zeichen bemalt. Im Westen siehst Du ein umheimliches, "
   "aus Stein erbautes Tor! Eine bedrohliche Aura geht von ihm aus..."));

AD("aura",
"Lebendig wirst Du, wenn Du das Tor erstmal durschreitest, nie mehr wiederkehren!");

AddDetail("schacht",
"Schmal, dunkel und unfreundlich.");
AddDetail("stein",
"Der Stein ist recht glatt und schwarz. Er ist ueber und ueber mit Zeichen "
"bedeckt.");
AddDetail("dunkelheit",
"Tja, wie das eben so mit der Dunkelheit ist, man sieht nicht viel in ihr...");
AddDetail("decke",
  "Naja, sowas wie eine Decke sieht man hier natuerlich nicht, "
  "aber ein Loch durch das man nach oben kann...");
  AddDetail("loch",
  "Das Loch fuehrt nach oben.");
  AddDetail("boden",
  "Der Boden ist aus Stein. Du entdeckst einen Kreis!\n");
  AddDetail("kreis",
  "Es ist ein magischer Kreis, von dem boese Energie ausgeht!\n");
  AddDetail("energie",
  "Sie funkelt und blitzt manchmal auf. Irgendwie lockt Dich der Kreis an...");
  AddDetail(({"wand", "waende"}),
  "Die Waende sind glatt, manchmal ein Kratzer oder eine kleine Erhebung, "
  "aber was Dich wirklich interessiert sind die seltsamen Zeichen an der Wand. "
  "Fackeln erhellen den Schacht und tauchen alles in ein gespentisches Licht! "
  "In der Westwand ist ein grosses Tor eingelassen, aus dem ab und zu Nebel "
  "dringt.");
  
  AD(({"fackel","fackeln"}),
  "Sie werfen gespenstische Schatten.");
  
  AD(({"westen","westwand"}),
  "Die Westwand weist ein grosses Tor auf. Man kann nicht erkennen, was dahinter "
  "ist, denn dichter Nebel, der sofort nach dem Tor wie eine Wand beginnt, "
  "versperrt Dir jegliche Sicht.");
  AD("sicht",
  "Ungefaehr 0 Meter.");
  AD("nebel",
  "Grau und unheimlich liegt er hinter dem Tor. Ob es klug ist ihn zu betreten...");
  AD("tor",
  "Das Tor ist aus Stein und fuehrt direkt in den toedlichen Nebel. "
  "Darueber steht etwas geschrieben.\n");
  AD("etwas",
  "Lesen.");


  AddDetail("licht",
  "Dunkle Schatten tanzen an den Waenden.");
 ASD(({"schatten"}), "come_shadow");
  AddDetail("zeichen",
  "Die Zeichen sind ueberall.");
  AddDetail("kratzer",
  "Laenglich oder auch nur kurz fuehren sie ueber die Waende.");
  AddDetail("erhebung",
  "Die Erhebungen sind auch nicht viel interessanter.");
     
  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
    "Du hoerst Stimmen unter Dir.");
    AddSound(({"stimme","stimmen"}),
    "Von wem stammen die wohl?!\n");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach nichts.");
  
  
  AddExit("oben", "./portal"); 
  AddCmd(({"betritt","betrete"}), "go");
AddItem("d/unterwelt/dante/skel/skel", REFRESH_DESTRUCT,
 ([P_MNPC_AREA: "/d/unterwelt/dante/portal2",
   P_MNPC_FLAGS: 0]));

ASE("westen", "tor");
AddSound(({"stimme","stimmen"}),
"Die Stimmen scheinen aus dem Kreis am Boden zu kommen!\n");


ASE("unten", "nix");

  
  AddReadDetail(({"etwas","inschrift", "text"}),
"Wanderer, der Du durchschreitest dieses Tor, huete Dich vor dem\n"
"Skelettdrachen. Kein Sterblicher hat jemals sein schrecklich Antlitz.\n"
"erblickt ohne mit dem Leben zu bezahlen.\n");
  
}

int nix()  {
 write(BS(
  "Du versuchst nach unten zu gelangen, doch dann faellt Dir doch "
  "der Kreis auf!"));
  return 1; }
  

 
int tor(string str)   {
 if(present("SKEL", environment(TP)))  {
 write("Das Skelett sagt: STOP! "+TPN+", so geht das nicht!\n");
 return 1;
 }
 if(!KREIS) {
 write("Du willst durch das Tor, doch irgendeine Macht haelt Dich zurueck!\n"
 "Aber irgendwie kann man sicher nach Westen gelangen.\n");
 return 1;
 }
 else {
 write("Du durchschreitest aengtlich das Tor im Westen!\n");
 return TP->move("d/unterwelt/dante/skel/geistskel", M_GO,
 "aengstlich das Tor im Westen", "durchschreitet",
 "kommt aengstlich aus dem Nebel hervor");}
  }
   
 
 
 int go(string str)
  {
   notify_fail("Was willst Du hier machen?\n");
    if( !str ) return 0;
     if( member( ({"kreis"}),str) !=-1 )
      {
      
      if(present("SKEL", environment(TP)))  {
      write("Das Skelett lacht: Nur ueber meine Gebeine!\n");
      say("Das Skelett haelt "+CAP_TPN+" auf.\n");
      return 1; }
       
       else
       
   {   
kreis += ({getuid(this_player())});          

write(BS(
"Du betrittst den Kreis und irgenwie durchstroemt Dich Energie, "
"die Dich mutig und stark macht!"));
say(CAP_TPN+" betritt einen Kreis.\n");

return 1;
}
   return 0;
   }
   return 0;
   }
   



  string come_shadow()
    {
    object ob;
        if(present("schatten", environment(TP)))
        {
        write("Ein Schatten huscht um Dich herum!\n");
        }
        
        if(!schatten)   {
        write("Die Schatten an der Wand schauen bedrohlich aus!\n");  }
        
        else
        {
        ob=clone_object("/d/unterwelt/dante/skel/schatten");
        ob->move(TO, M_NOCHECK);
        ob->Kill(TP);
        write("Ein Schatten stuerzt sich ploetzlich auf Dich!\n");
        schatten=0;
        call_out("neu", 600);//10mins
        }
   return "";
   }
        
void neu()  {
schatten=1;  }
