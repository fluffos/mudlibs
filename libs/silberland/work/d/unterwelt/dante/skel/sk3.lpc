//raum mit treppe
//dante sl 99


inherit "std/room";

#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <moving.h>


int treppedown;

create()

{

::create();




SP(P_INT_SHORT,"Im Reich des Skelettdrachen");
 SetProp( P_INDOORS, 1 );
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
   

SP(P_LIGHT,1);
SP(P_INT_LONG, BS(
"Du bist nun im hohlen Totenschaedel, einem Bauwerk aus laengst vergangener Zeit. "
"Weiss und grau schimmern die Waende, die aus unzaehligen Knochenplatten "
"gefertigt wurden. Viele unvorsichtige Sterbliche hat der Skelettdrache gemeuchelt "
"um sich dieses Monument zu errichten."));

AD(({"drache","skelettdrache"}),
"Der Skelettdrache ist schon ganz nahe!!!");
AD("monument",
"Dieses Bauwerk wurde aus genau einer Million Opfer errichtet. ");
AD(({"opfer","million"}),
"Naja ganz so genau weiss, das eigentlich keiner, oder glaubst Du Drachen koennen zaehlen?\n");
AD(({"platten","knochen","knochenplatten","platte","knochenplatte"}),
"Die Knochenplatten hat man durchbohrt und mit den langen, duennen Knochen der "
"Opfer verbunden. So entstand in jahrtausender langer Arbeit dieses Bauwerk.");
AD("arbeit",
"Dafuer verwendete man Sklaven.");
AD(({"sklave","sklaven"}),
"Dante hat angeblich sehr lange hier geschuftet.");

AD(({"sterbliche","sterblicher"}),
"Viele kamen hier her, aber keiner kehrte je zurueck,");
AD("zeit",
"Vor vielen Jahren kaempfte das Gute gegen das Boese um das Heil des Silberlandes. "
"Nach tausend Jahren Kampf siegte schliesslich das Gute ueber das Boese und verbannte "
"es in diese Dimension .");
AD(({"gute","boese","heil","silberland","jahre","dimension","kampf"}),
"Hier ist die Dimension der Daemone und des Schreckens!!!");
AD("schrecken",
"Den lernst Du hier kennen.");
AD(({"daemon","daemone"}), 
"Draussen lauern sie auf Dich...");



AD(({"wand","waende"}),
"Die Waende sind glatt und glaenzen weisslich. Ab und zu hat man einen kleineren "
"Totenschaedel an die Wand genagelt. Er ist hohl und darin brennt Oel. So wird "
"das ganze Bauwerk in ein unheimlich flackerndes Licht getaucht.");
AD("licht",
"Das Licht tanzt hin und her.");
AD("oel",
"Das Oel verbrennt in den Totenschaedeln und erzeugt so etwas Licht.");
AD(({"schaedel","totenschaedel"}),
"Das ganze Bauwerk ist ein gigantischer nachgebildeter Totenschaedel. An den Waenden "
"haengen kleinere, echte, Totenschaedel. Der Schaedel von Dante ist auch dabei, "
"seitdem rennt er kopflos herum...");
AD("dante",
"Lass das!");


ASD("treppe", "show");

AD("decke",
"Die Decke ist hier nicht zu erkennen. Was Du aber siehst ist eine Treppe.");
AD("boden",
"Der Boden besteht aus blankpolierten Knochenplatten. Er glaenzt und schimmert hell. "
"Manchmal glaubst Du Dein Spiegelbild darin zu erkennen. Ein dunkles "
"Loch fuehrt nach unten.");
AD("loch",
"Du kannst durch das Loch einfach nach unten gelangen.");

AD(({"bild","spiegelbild"}),  "Dein Spiegelbild warnt Dich eindringlichst!");
AD("gebaeude",
"Ein riesiger Totenschaedel.");
AD("bauwerk",
"Das Bauwerk ist sehr hoch, es ragt bis hoch in den Himmel.");
AD("himmel",
"Den kann man hier natuerlich nicht sehen...");
AD("sueden",
"Im Sueden liegt das Tor, durch das Du hereingekommen bist.");
AD("tor",
"Suedlich von hier.");



AddExit("sueden", "./sk2");

AddExit("westen", "/d/unterwelt/dante/skel/knoma");


 AIT("/d/unterwelt/dante/skel/goskel2", REFRESH_DESTRUCT);
 AIT("/d/unterwelt/dante/skel/srat", REFRESH_DESTRUCT);
AddExit("unten", "./gosk");

AddGuardedExit("osten", "/d/unterwelt/dante/skel/o1", "skelett",
"Das Skelett laesst Dich nicht vorbei!\n");

}
 
 
 
 string show()
 {
 if(treppedown) {
   write("Die Treppe besteht aus duennen Knochen und fuehrt nach oben.\n");
      }
      if(!treppedown) {
         write(BS("Die Treppe besteht aus duenne Knochen. Im Moment scheint sie aber "
         "nach oben gezogen worden zu sein. Irgendwie kann man das sicher aendern.\n"));
         }
         return "";
         }
         
         
 void treppe_down()
            {
            tell_room("d/unterwelt/dante/skel/sk3",
            "Wie von Geisterhand wird die Treppe langsam heruntergelassen.\n");
            AE("oben", "./sk4");
            treppedown=1;
            }
            
      void treppe_up()
            {
   tell_room("d/unterwelt/dante/skel/sk3",
   "Die Treppe wird langsam wieder nach oben gezogen.\n");
         treppedown=0;
         RemoveExit("oben", "./sk4");
            }
            //die treppe wird per reset aus dem raum sk2.c hochgezogen...
            //kann auch nur von dort heruntergelassen werden
            //runter kann man von sk4.c eh nichtJ))
            
            
            
            
            