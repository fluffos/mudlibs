void create()
{

::create();


SetProp( P_INDOORS, 1 );
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );


SP(P_INT_SHORT,"Im Reich des Skelettdrachen");
SP(P_LIGHT,1);
SP(P_INT_LONG, BS(
"Du stehst hier in einer Augenhoehle des gigantischen Schaedels. Hinter Dir die "
"kleine Oeffnung, durch die Du aus dem Schaedel geklettert bist. Vor Dir der "
"drohende Abgrund. Ober Dir das Dach des Schaedels und sonst nur dichter Nebel."));

AD("decke",
"Die Decke der Augenhoehle besteht natuerlich auch aus Knochen! WOW!! "
"Was ist das?!? Dante hat Dir eine Nachricht hinterlassen...");
ASD("dante", "finger");
AD("nachricht",
"Springen macht Spass, sterben auch. Dein DaNtE!");

AD("oeffnung",
"Durch diese Oeffnung bist Du hier herausgeklettert.");
AD("abgrund",
"Es geht tief nach unten. Viel zu tief fuer einen Sprung!");
AD("sprung",
"Lass es lieber!");

AD("nebel",
"Der Nebel hier ist so dicht, dass Du nichts erkennst. ");
AD(({"augenhoehle","augenhoehlen","auge","augen"}),
"Die Augenhoehle ist hoch ueber dem Boden. Irgendwie ist sie ja wie ein Balkon.");
AD(({"drache","skelettdrache"}),
"Der Skelettdrache lebt ober Dir am Dach. Du kannst raufklettern!!!");
AD("monument",
"Dieses Bauwerk wurde aus genau einer Million Opfer errichtet. ");
AD(({"opfer","million"}),
"Naja ganz so genau weiss, das eigentlich keiner, oder glaubst Du Drachen koennen zaehlen?\n");
AD(({"platten","knochen","knochenplatten","platte","knochenplatte"}),
"Die Knochenplatten hat man durchbohrt und mit den langen, duennen Knochen der "
"Opfer verbunden. So entstand in jahrtausender langer Arbeit dieses Bauwerk.");
AD("arbeit",
"Dafuer verwendete man Sklaven.");
AD(({"sklave","sklaven"}),
"Dante hat angeblich sehr lange hier geschuftet.");

AD(({"sterbliche","sterblicher"}),
"Viele kamen hier her, aber keiner kehrte je zurueck,");
AD("zeit",
"Vor vielen Jahren kaempfte das Gute gegen das Boese um das Heil des Silberlandes. "
"Nach tausend Jahren Kampf siegte schliesslich das Gute ueber das Boese und verbannte "
"es in diese Dimension .");
AD(({"gute","boese","heil","silberland","jahre","dimension","kampf"}),
"Hier ist die Dimension des Schreckens!!!");
AD("schrecken",
"Den lernst Du hier kennen.");
AD(({"daemon","daemone"}), 
"Draussen lauern sie auf Dich...");



AD(({"wand","waende"}),
"Die Waende der Augenhoehle bestehen ebenfalls aus Knochenplatten.");
AD("licht",
"Das Licht kommt irgendwo hinter dem Nebel her. Dein Glueck, denn Du entdeckst "
"ein Seil, dass irgendjemand vor Dir hier festgebunden hat.");
AD("seil",
"Das Seil fuehrt nach unten. Ideal zum klettern!");
AD("balkon",
"Du stehst auf dem Balkon, der eigentlich eine Augenhoehle ist.");

AD(({"schaedel","totenschaedel"}),
"Das ganze Bauwerk ist ein gigantischer nachgebildeter Totenschaedel. Du stehst "
"in einer seiner Augenhoehlen.");


AD("dach",
"Das Dach ist ober Dir.");
AD("boden",
"Der Boden besteht aus den Knochenplatten.");

AD("gebaeude",
"Ein riesiger Totenschaedel.");
AD("bauwerk",
"Das Bauwerk ist sehr hoch, es ragt bis hoch in den Himmel.");
AD("himmel",
"Du befindest Dich doch auf einem gigantischem Totenschaedel mitten in einer "
"noch viel gigantischeren Hoehle!");

AD("hoehle",
"Die Hoehle hat wirklich epische Ausmasse.");
AD(({"ausmasse","ausmass"}),
"Dante taucht auf und sagt: Also die Hoehle ist ca. so gross.\n"
"Dann zeigt er mit den Haenden ca. einen dreiviertelachtelhalben Meter und haut wieder ab.\n"
"\nDu denkst . o O 'Der Typ spinnt ja!'\n");

ACD(({"spring","springe"}), "balkon");
ACD(({"kletter","steig","klettere","steige"}), "weg");
    
    SP(P_KILL_MSG, "Und wieder einer zu Brei zermatscht!!!");
SP(P_KILL_NAME, "Ein gigantischer Totenschaedel und seine Augenhoehle");

//AIT("d/unterwelt/dante/skel/goskel2", REFRESH_DESTRUCT);


//AIT("/d/unterwelt/nekromanten/npc/skelettmagier", REFRESH_DESTRUCT);

call_out("check", 1);

}
//nur zur sicherheit!!!!!

int check()  {

object mag, ob;
mag=present("skelettmagier", TO);

if(!deep_present("ring", mag))  {
		

    ob=clone_object("/gilden/druidenzirkel/armour/elementarring");
    ob->set_ring_element("erz");
    ob->move(this_player(), M_NOCHECK);
        
                    }
                                      
       }



int weg(string str)
{
NF("Wodurch oder womit willst Du hier klettern/steigen? Runter oder rein?!\n");
if(member(({"mit seil runter","an seil runter","an seil zu boden",
 "mit seil zu boden", "am seil nach unten", "mit seil nach unten"}),str)!=-1)
    {
    write("Du kletterst am Seil nach unten.\n");
    TP->move("d/unterwelt/dante/skel/tor", M_TPORT, "am Seil nach unten",
    "klettert","kommt von oben herabgeklettert");
    return 1;
    }
    if(member(({"durch oeffnung rein","durch oeffnung in schaedel",
    "rein","in schaedel", "in schaedel rein", "hinein"}),str)!=-1)
    {
    write("Du kletterts wieder in den Schaedel hinein.\n");
    TP->move("/d/unterwelt/dante/skel/sk5", M_TPORT, "in den Schaedel hinein",
    "klettert", "kommt von draussen hereingeklettert");
    return 1;
    }
    return 0;
    }
    
    
    
    int balkon(string str)
    {
    NF("Willst Du nach unten springen?\n");
    if(str=="nach unten"||str=="runter"||str=="zum boden"||"zu boden") {
    write
    ("Du springst nach unten!!!\n");
    TP->move("/d/unterwelt/dante/skel/tor", M_TPORT, "todesmutig nach unten"
    "springt", "kommt von oben heruntergeflogen und wird hier unten zerschmettert");
    write("\nDer Aufprall ist so stark, dass Du fast zerschmettert wirst.\n");

    TP->do_damage(50, TO);

    return 1;}
    
    return 0; }
    
    
    string finger()
    {
    domainshout(CAP_TPN+" untersucht Dante! Sowas Neugieriges!!!\n");
    write("Das macht Spass!!!\n");
    return "";
    }
    
