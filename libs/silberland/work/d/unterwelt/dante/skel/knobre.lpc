
inherit "std/npc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>


void create()
{
 
 
   if (!is_clone(TO)) return;
     ::create();
     
     
       SetProp(P_SHORT, "Ein Knochenbrecher");
         SetProp(P_LONG, BS(
          "Der Knochenbrecher ist ein grosses, klobiges Wesen, das mit unzaehligen Knochenplatten "
          "gepanzert ist. Seine Feinde vernichtet er mit haertesten Schlaegen auf den Kopf.\n"));
            SetProp(P_NAME,"Knochenbrecher");
            
              SetProp(P_GENDER, MALE);
                AddId(({"knochenbrecher","brecher"}));
                  SetProp(P_ARTICLE, 1);
                    SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
                      create_default_npc(10);
                        // P_LEVEL   = x
                          // P_SP/P_HP = x*8+42       =
                            // P_HANDS   = x*10         =
                            
                            SetProp(P_HANDS, ({" mit knochenbepanzerten Armen",500+random(200),DT_BLUDGEON}));
                              SetProp(P_BODY, 100+random(20));
                              SetProp(P_SIZE, 100);
                                SetProp(P_ALIGN, -999);
                                  SetProp(P_MAX_HANDS, 2);
                                    SetProp(P_INFO, "Und wieder ein paar mp weniger...\n");
                                      SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 0.3, DT_TERROR:-1.0, DT_BLUDGEON:-1.0]));
                                      SUID;
             CLONEME("d/unterwelt/dante/skel/knomed");
                                        SetProp(P_HEAL,10);
                                          SetProp(P_AGGRESSIVE,0.2);
                                            SetProp(P_WIMPY, 0);
                                              SetProp(P_NOMAGIC,0);
                                                SetProp(P_NOCORPSE, 0);
                                                  SetProp(P_MSGIN, "steht ploetzlich vor Dir");
                                                    SetProp(P_MSGOUT, "verschwindet");
                                                      SetProp(P_MMSGIN, "taucht ploetzlich auf");
                                                        SetProp(P_MMSGOUT, "verschwindet");
                                                        
                                                        
                                                        
                                                          SetProp(P_SPELLRATE,75);
                                                          
                                                          
                                                            AddSpell(3,600,
                                                                "Der Knochenbrecher schlaegt hart auf Deinen Kopf.\n",
                                                                    "Der  Knochenbrecher schlaegt hart auf @WESSEN Kopf.\n",
                                                                         DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
                                                                         
                                                                         
                                                                           AddSpell(2,800,
                                                                               "Der Knochenbrecher schlaegt hart auf Deinen Kopf.\n",
                                                                                   "Der  Knochenbrecher schlaegt hart auf @WESSEN Kopf.\n",
                                                                                        DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
                                                                                        
                                                                                        
                                                                                        
                                                                                          AddSpell(1,1000,
                                                                                              "Der Knochenbrecher schlaegt hart auf Deinen Kopf.\n",
                                                                                                  "Der  Knochenbrecher schlaegt hart auf @WESSEN Kopf.\n",
                                                                                                       DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
                                                                                                       
                                                                                                       SetChats(3,({
                                                                                  "Der Knochenbrecher knackt mit seinen Knochen!\n",
                                      "Der Knochenbrecher spielt mit einem Unterarmknochen.\n",
  "Der Knochenbrecher fragt: Kennst Du den Terrormops?!\n",
 "Der Knochenbrecher schleudert eine Kniescheibe knapp an Deinem Kopf vorbei!\n"
                      "Der Knochenbrecher grinst knochig.\n"}));
                                                                                                       
                                          
  AddInfo(({"mops","terrormops"}),
 "Das allerschlimmste Monster dieser Dimension und ueberhaupt, ist die Wohnungskollegin "
  "von Dante!!!", "sagt zitternd: ");
AddInfo("knochen",
"Deine breche Ich Dir gleich!", "lacht: ");
 }

                                 Defend(int dam, string dtype, mixed spell, object enemy)
                                                     {
 if (!pointerp(dtype))
     dtype = ({ dtype });
                           if (sizeof(dtype & ({ DT_BLUDGEON }) ))
      {                                                                                                                                                              
                                                                                                                                                                    tell_object(enemy,
                                                                                                                                                                          "Dein Angriff prallt vom Knochenbrecher ab und trifft Dich!!!\n");
                                                                                                                                                                                enemy->Defend(dam, DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
                                                                                                                                                                                     
                                                                                                                                                                                        return ::Defend(0, dtype, spell, enemy);
                                                                                                                                                                                        
                                                                                                                                                                                                    }
                           return ::Defend(dam, dtype, spell, enemy); }

     die(arg)
             {
         write_file("/d/unterwelt/dante/log/knobre",
                  ctime()+": "+CAP(getuid(PL))+" killt den Knochenbrecher.\n");
                                                        ::die(arg);
                                                        
                                                                        }
    void NotifyPlayerDeath(object player, object killer, int lostexp)    {
           write_file("/d/unterwelt/dante/log/knobre",
     ctime()+": Der Knochenbrecher "+CAP(getuid(PL))+" umgebracht.\n");
}
