//dante sl
//dieser ring ist beim skelettdrachen dabei
//veraendert stats...
/* 
der ring geht nun nicht mehr nach 20 resets kaputt bzw wird er nicht 
mehr schlechter
bei dem harten npc!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <attributes.h>      
#include "/players/dante/myowndefine.h"

int count=0;
int inte=1+random(3);

create() {
  if (!is_clone(this_object()))
    return;
  ::create();

  SetProp (P_SHORT, "Ein Skelettdrachenring");
  SetProp (P_LONG, BS (
    "Dieser Ring ist zu Deinem Erschrecken aus menschlichen Knochen gefertigt."
    " In seiner Mitte ist ein kleiner Rubin eingesetzt umrandet von Hieroglyphen."
    " Wer mag wohl der satanische Erschaffer dieses gottlosen Stuecks gewesen"
    "sein..."));
  AddId (({"ring","knochenring","drachenring","skelettdrachenring","skelettring"}));
  SetProp (P_NAME, "Skelettdrachenring");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 1000+random(500));
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_RING);
  SetProp (P_AC, 5);
  SetProp(P_INFO, ("Dieser Ring koennte Deine Intelligenz veraendern!\n"));
  
  SetProp (P_MATERIAL, ([MAT_JEWEL:10 ,MAT_MAGIC:10, MAT_BONE:80]));
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL:25]) );

  SetProp(P_MAGIC,1);       
  AddDetail ("knochen", (
    "Aus welchem Knochen des Koerpers der Ring wohl geschnitzt wurde?\n"));
  AddDetail (({"hieroglyphen","hieroglyphen"}), 
    "Du betrachtest angeekelt diese fremden, archaischen Schriftzeichen, "
    "kannst sie aber ueberhaupt nicht deuten.");
  AddDetail("rubin", (
    "Der Rubin mit seinem vollen Rot hebt sich von seiner grausigen, fahlen "
    "Umgebung besonders schoen ab.\n"));

  AD("erschaffer",
    "Diesen Ring hat Dante aus seinem eigenen Schaedel erschaffen!");

 // SP(P_CURSED, "Der Skelettring lacht Dich nur aus!\n");
  SP(P_NODROP, "Der Skelettring lacht Dich nur aus!\n");

  SetProp (P_M_ATTR_MOD, ([ A_INT:inte]) ); 

}
