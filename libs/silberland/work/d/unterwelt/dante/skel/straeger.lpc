

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <npc.h>



init() {
::init();
if(interactive(TP)) {call_out("tag", 0); }
}

void tag()
  {
  if(environment(TP)!=environment(TO))        return;
 else 
  write(
 "Der Schaedeltraeger schaut sich Deinen Schaedel genau an und sagt dann:\n"
  ""+CAP_TPN+", Dein Schaedel gefaellt mir. Den will ich haben!\n");
  
 }
  

void create()
{

 if (!is_clone(this_object())) return;         
  ::create();  
  SetProp(P_SHORT, "Der Schaedeltraeger");
  SetProp(P_LONG, break_string(
"Dieses Wesen scheint der Alptraum eines jeden klar denkenden Menschen "
     "zu sein. Sein Leib ist eine schwarze Masse, die sich selbst um Licht des"
     " Grubenfeuers nicht aufzuhellen scheint. Die capeartigen Schwingen auf"
     " seinem Ruecken woelben sich ein wenig, als es Dich sieht. Die Beine"
     " sind krumm, und die Fuesse enden in gefaehrlich aussehenden Krallen,"
 " die faehig scheinen, das Gestein, auf dem sie sich befinden, selbst"
     " zu zerfetzen. Tief eingezogen zwischen maechtigen Schultern, haben"
     " Kopf und Gesicht entfernte Aehnlichkeit mit zerschundeter Kohle."
     " Die heimtueckischen Augen richten sich auf Dich, und ihre Tiefen"
     " locken Dich naeher an das roetliche Gluehen, dass in ihnen funkelt,"
  " eine offene Einladung zum Tod. Mit langsamen, schleppenden Schritten "
 " geht es hier herum, und sein Atem rasselt, als es Dir naeher "
 "zu kommen scheint."));
    
  SetProp(P_NAME, "Schaedeltraeger");
  SetProp(P_GENDER, MALE);
  AddId(({"traeger", "schaedeltraeger"}));
  create_default_npc(25);
  // P_LEVEL   = 20
  // P_SP/P_HP = 31*8+42  = 290
  // P_HANDS   = 31*10    = 310
  // P_BODY    = 31*20/3) = 206
  SetProp(P_BODY, 100);
  //fuer angrox: body um 20 weniger dafuer level von 18 auf 25
  SetProp(P_MAX_HP, 600);
  SetProp(P_HANDS, ({" mit toedlichen Klauen", 250, DT_RIP}) );
  SetProp(P_ALIGN, -900);    // sehr boese
  SetProp(P_RACE, "Bestie");
  SetProp(P_SIZE, 180);      // 1.80m, hmm ist gross
 SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 0.5, DT_TERROR:-1.0, DT_COLD:-1.0,
  DT_FIRE: 0.3]));
      
  SetProp(P_DIE_MSG, " bricht mit qualvollem Geheul zusammen.\n");
  SetProp(P_KILL_NAME, "Der Schaedeltraeger");
  SetProp(P_KILL_MSG, "*grins*");
     SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));  

  SetProp(P_MSGIN, "kommt dumpf knurrend hereingeschlichen");
  SetProp(P_MMSGIN, "kommt dumpf knurrend hereingeschlichen");
  SetProp(P_MMSGOUT, "fliegt kreischend auf und davon");
  SetProp(P_MSGOUT, "fliegt lautlos");
    
  SetChats(2, ({
    "Der Schaedeltraeger funkelt Dich boese an.\n",
    "Der Schaedeltraeger entbloesst seine geifernden Kiefer.\n",
    "Der Schaedeltraeger baeumt sich vor Dir auf.\n",
    "Der Schaedeltraeger scheint Hunger zu haben...\n",
    "Der Schaedeltraeger kreischt vor Siegesgewissheit.\n"
  }) );
  SetAttackChats(30, ({"Der Schaedeltraeger heult wuetend auf.\n"}) );
  
  SetProp(P_DEFAULT_INFO, "blickt Dich nur luestern an.\n");
  AddInfo("dante",
    "knurrt hasserfuellt etwas, das wie 'verdammter &%&&(' klingt.\n");
    SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));    
    
    
  SetProp(P_SPELLRATE, 60);
  AddSpell(1, 400, 
    "Der Schaedeltraeger reisst Dir mit seinen Krallen fast den Bauch auf.\n",
    "Der Schaedeltraeger reisst @WEM mit seinen Krallen fast den Bauch auf.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1])); 
  AddSpell(4, 300,
    "Der Schaedeltraeger trifft Dich mit seinen Schwingen sehr hart am Kopf.\n",
    "Der Schaedeltraeger trifft @WEN mit seinen Schwingen sehr hart am Kopf.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));  
  AddSpell(2, 300,
    "Der Schaedeltraeger geifert Dir aetzenden Speichel ins Gesicht.\n",
    "Der Schaedeltraeger geifert @WEM aetzenden Speichel ins Gesicht.\n",
    DT_ACID, ([SP_SHOW_DAMAGE:1]));   

SUID;
CLONEME("/d/unterwelt/dante/skel/gorue");
command("ziehe alles an");


}


