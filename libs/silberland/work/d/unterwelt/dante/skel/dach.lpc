//dante sl 99

inherit "std/room";

#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <moving.h>
#include <properties.h>

#define WARNEND (member(gewarnt, getuid(this_player()))!=-1)
string *gewarnt=({});


void init()  
{
  ::init();
  if(interactive(TP))  
  {
    call_out("tag", 1); 
  }
}

tag()  
{
  if(!TP || environment(TP)!=TO) return ;
  write("Eine innere Stimme raet Dir: Du solltest Dich hier nicht bewegen!!!\n");
}

void create()
{

  ::create();

  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  SP(P_INT_SHORT,"Im Reich des Skelettdrachen");
  SP(P_LIGHT,1);
  SP(P_INT_LONG, BS(
        "Du stehst nun am Dach des gigantischen Totenschaedels. Um Dich herum nichts "
        "als Nebel. Das Dach faellt ueberall um Dich herum sehr steil ab und ein Sturz aus "
        "dieser Hoehe waere Dein sicherer Tod. Nur hier, und genau nur hier, kannst Du "
        "sicher stehen. Ein falscher Schritt und Du stuerzt ab! Sei also vorsichtig!"));

  AD("sturz",
      "Bewege Dich hier NICHT weg!");
  AD("schritt",
      "Bleib ja wo Du bist!");
  AD("hoehe",
      "Sehr hoch.");
  AD("nebel",
      "Der Nebel ist hier oben extrem dicht. Komischerweise ist direkt ober dem "
      "Schaedel ueberhaupt keiner. Nur drumherum ist er besonders dicht.");
  AD("decke",
      "Gibt es hier nicht...");
  AD("tod",
      "Der lauert hier ueberall, das sei Dir versichert!");

  AD(({"drache","skelettdrache"}),
      "Der Skelettdrache ist scheinbar nicht hier!!!");
  AD("monument",
      "Dieses Bauwerk wurde aus genau einer Million Opfer errichtet. ");
  AD(({"opfer","million"}),
      "Naja ganz so genau weiss, das eigentlich keiner, oder glaubst Du Drachen koennen zaehlen?\n");
  AD(({"platten","knochen","knochenplatten","platte","knochenplatte"}),
      "Die Knochenplatten hat man durchbohrt und mit den langen, duennen Knochen der "
      "Opfer verbunden. So entstand in jahrtausender langer Arbeit dieses Bauwerk.");
  AD("arbeit",
      "Dafuer verwendete man Sklaven.");
  AD(({"sklave","sklaven"}),
      "Dante hat angeblich sehr lange hier geschuftet.");

  AD(({"sterbliche","sterblicher"}),
      "Viele kamen hier her, aber keiner kehrte je zurueck,");
  AD("zeit",
      "Vor vielen Jahren kaempfte das Gute gegen das Boese um das Heil des Silberlandes. "
      "Nach tausend Jahren Kampf siegte schliesslich das Gute ueber das Boese und verbannte "
      "es in diese Dimension .");
  AD(({"gute","boese","heil","silberland","jahre","dimension","kampf"}),
      "Hier ist die Dimension der Daemone und des Schreckens!!!");
  AD("schrecken",
      "Den lernst Du hier kennen.");
  AD(({"daemon","daemone"}), 
      "Draussen lauern sie auf Dich...");

  AD(({"wand","waende"}),
      "Gibt es hier nicht.");
  AD("licht",
      "Das Licht tanzt hin und her.");
  AD("balkon",
      "Der Balkon ist unter Dir. Du kannst sicher runterspringen!");

  AD(({"schaedel","totenschaedel"}),
      "Das ganze Bauwerk ist ein gigantischer nachgebildeter Totenschaedel, "
      "der aus unzaehligen Knochenplatten besteht.");

  AD("treppe", 
      "Die Treppe fuehrt durch das Loch im Boden wieder nach unten zurueck.");
  AD("loch", 
      "Das Loch im Boden fuehrt wieder zurueck in den Totenschaedel.");

  AD("dach",
      "Du stehst bereits auf dem Dach!");
  AD("boden",
      "Der Boden besteht aus den Knochenplatten. Ein grosses Loch fuehrt nach unten.");

  AD("gebaeude",
      "Ein riesiger Totenschaedel.");
  AD("bauwerk",
      "Das Bauwerk ist sehr hoch, es ragt bis hoch in den Himmel.");
  AD("himmel",
      "Den Himmel kann man wegen des Nebels nicht sehen.");

  AE("unten", "./sk5");
  ACD(({"spring","springe"}), "balkon");
  ASE("osten", "tot");
  ASE("westen", "tot");
  ASE("sueden", "tot");
  ASE("norden", "tot");
  ASE("nordosten", "tot");
  ASE("nordwesten", "tot");
  ASE("suedosten", "tot");
  ASE("suedwesten", "tot");

  AIT("/d/unterwelt/dante/skel/skelettdrache", REFRESH_DESTRUCT);
  SP(P_KILL_NAME, "Ein gigantischer Totenschaedel");
  SP(P_KILL_MSG, "Wer hoch hinaus will, faellt oft sehr tief");

}

int tot()
{
  if(WARNEND)  
  {
    write(
        "\nDu Wahnsinniger hast alle Warnungen missachtet und Dich vom sicheren Platz entfernt.\n");
    TP->move("d/unterwelt/dante/skel/tor", M_TPORT, "laut bruellend in den Tod",
        "stuerzt", "kommt von oben herabgestuerzt und wird am Boden zerschmettert!");
    write("\nDu prallst brutal am Boden auf und zerplatzt foermlich! Naja, nicht ganz...\n");

    TP->do_damage(100, TO); //freu freu
    return 1;
  }
  if(!WARNEND)  
  {
    gewarnt += ({getuid(this_player())});        
    write(BS(
          "Du solltest Dir das wirklich zweimal ueberlegen!!! Du stehst auf dem Dach, und "
          "viel Platz kann hier nicht sein?! Also..."));
    return 1; 
  }
}


int balkon(string str)
{
  NF("Willst Du nach unten springen?\n");
  if(str=="auf balkon"||str=="runter auf balkon"||str=="zum balkon") 
  {
    write ("Du springst vom Dach auf den Balkon.\n");
    TP->move("/d/unterwelt/dante/skel/sk7", M_TPORT, "todesmutig nach unten",
        "springt", "kommt von oben heruntergeflogen");
    return 1;
  }
  return 0; 
}
