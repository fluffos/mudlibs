//kann den schaden mindern bzw abwehren bei gewissen spells
//des skeldrachen


inherit "std/thing";

#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <mnpc.h>
int count=0;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp (P_SHORT, "Ein winziges, weissliches Skelett");
  SetProp (P_LONG,BS (
  "Dieses Skelett ist wirklich sehr klein. Es stammt wahrscheinlich von einem "
  "winzigen Zwerg, der in der Unterwelt grausam abgeschlachtet wurde. "));
  SetProp (P_NAME, "Skelett");
  SP(P_NAME_ADJ, ({"winzig", "weisslich"}));
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 2000+random(1000));
  SetProp (P_WEIGHT, 20);
  SetProp (P_NOBUY, 1);
  SP(P_INFO, 
  "Dieses Skelett kann Dir beim Kampf gegen den Skelettdrachen helfen!\n");
     
  AddId (({"skelett", "zwergenskelett"}));
  SetProp(P_MATERIAL, ([MAT_BONE:90, MAT_MISC_MAGIC:10]));
}
      reset() {
      ::reset();
      if(count>=20) {
      write("Das winzige Skelett zerfaellt zu Staub!\n");
      remove();
      }
      else 
      count++; } 
          