//dante sl 98

inherit "std/mnpc";      
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>


create()
{
  if (!is_clone(TO)) return;
    ::create();

  SetProp (P_SHORT, "Eine Skelettratte");
  SetProp (P_LONG, BS(
  "Das ist eine der ekelhaften Skelettratten. Sie besteht nur aus Knochen, "
  "laeuft aber trotzdem flink umher..."));
  
  SetProp (P_NAME, "Skelettratte");
  SetProp (P_GENDER, FEMALE);
  AddId (({"ratte","skelettratte"}));
  create_default_npc (8+random(2));
  SetProp (P_SIZE, 100);
  SetProp (P_HEAL, -1-random(3));
  SP(P_AGGRESSIVE, 0.1);
  SetProp(P_RACE, "Skelett");
  



 SetProp( P_RESISTANCE_STRENGTHS,([DT_COLD:-1.0, DT_FIRE:0.3,
   DT_HOLY:0.3]));
     
SetProp(P_MSGIN, "schleicht lauernd herein");
  SetProp(P_MSGOUT, "schleicht lauernd");
    SetProp(P_MMSGIN, "schleicht lauernd herein");
      SetProp(P_MMSGOUT, "schleicht in ihre Hoehle zurueck");
        SetProp(P_MNPC_AREA, ("/d/unterwelt/dante/skel/"));
          SetProp(P_MNPC_DEFAULTROOM, "/d/unterwelt/dante/skel/tor");
            SetProp(P_MNPC_FLAGS, MOV_MOVES +MOV_INDOORS + MOV_BACKWARDS);
              SetProp(P_MNPC_WAIT, ({5, 5, 5}));  
  
  SetProp (P_HANDS, ({" mit ihren Skelettkrallen", 70+random(20), ({DT_POISON,DT_RIP,DT_PIERCE}) }));
  SetProp (P_ALIGN, -100);
  
  SetChats(5, ({
  "Die Skelettratte huschtt an Dir vorueber.\n",
  "Die Skelettratte schnuppert nach Dir.\n",
  "Die Skelettratte pinkelt Dir auf die Fuesse.\n",
  "Die Skelettratte wuehlt im Boden.\n",
  "Die Skelettratte kratzt sich.\n",
  "Die Skelettratte sucht nach Nahrung.\n" }) );
  
}
