//gestank aus dem totenkopf

inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#include <wizlevels.h>
int x=0;

object player;
create()
{

::create();
if (!is_clone(this_object())) return;
SetProp(P_NAME, 0);
SetProp(P_SHORT, 0);
SetProp(P_NEVERDROP, 1);
SetProp(P_NODROP, 1);
AddId (({"GESTANK"}));
call_out("st1", 30);

SetProp(P_WEIGHT, 0);
}



 st1()

 {


 player=this_player();
 write(
       "Du stinkst unertraeglich. Du bist voll mit Drachenkot.\n");
  say(capitalize(player->name())+" stinkt nach Drachenkot.\n");

 call_out("st2",10);

  }

st2()
 { say(capitalize(player->name())+" stinkt wie ein verwesender Drache.\n");

 write("Du stinkst wie ein verwesender Drache.\n");
      call_out("st3",10);
       }

 st3()
 {
  
  
  if(x>=10+random(5))  {
  call_out("weg", 10); }
  
  else
  
  switch(random(10))  
    {
    case 0:
    write("Du stinkst wie ein halbtoter Drache!\n");
    say(CAP_TPN+" stinkt wie ein halbtoter Drache!\n");
    break;
    case 1:
    write("Der Drachenkot brennt auf Deiner Haut.\n");
    say(CAP_TPN+" ist voller giftigem Drachenkot.\n");
    TP->AddPoison(2);
    break;
    case 2:
    write("Du riechst wie eine Drachenkotgrube.\n");
    say(CAP_TPN+" riecht wie eine Drachenkotgrube.\n");
    break;
    case 3:
    write("Du schaemst Dich, weil Du so stinkst!\n");
    say(CAP_TPN+" schaemt sich ob seines Gestankes.\n");
    break;
    case 4:
    write("Drachenkot tropft von Deinem Kopf herab.\n");
    say("Drachenkot tropft vom Kopf von "+CAP_TPN+" herab!\n");
     break;
     case 5:
     write("Der Drachenkot tropft in Deine Augen!!! AHHHHHHHHH\n");
     TP->SetProp(P_BLIND, 120);
     say(CAP_TPN+" erblindet durch den Drachenkot.\n");
     break;
     case 6:
     write("Der Drachenkot stinkt erbaermlich. Du auch!\n");
     say(CAP_TPN+" stinkt eklig nach Drachenkot.\n");
     break;
     case 7:
     shout(CAP_TPN+" stinkt erbaermlich nach Drachenkot.\n");
     break;
     case 8:
     write("Woody teilt Dir mit: "+CAP_TPN+", Du stinkst ja!\n");
     say(CAP_TPN+" sagt: Ok, ich gestehe, ich stinke!\n");
     break;
     case 9:
     write("Du fuehlst Dich wie lebender Drachenkot.\n");
     say(CAP_TPN+" fuehlt sich wie lebendiger Drachenkot.\n");
     break;
     default: write("BUG!\n");
         }
         x++; call_out("st3", 15+random(15));
    }     
  
  
  void weg()
  {
  write("Der Drachenkot broeckelt endgueltig von Dir ab!\n");
  say(CAP_TPN+" verliert seinen Kot, den DRACHENKOT!!\n");
  remove();
  }
  
