
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();   /* WICHTIG!!! */

SetProp(P_SHORT, "Eine schimmernde Goblinruestung");
SetProp(P_LONG, BS("Dies ist eine schimmernde Goblinruestung. "
 "Sie ist aus feinen Silberfaeden gewoben. Du kannst Dir eigentlich "
 " nicht vorstellen, "
 "dass diese Ruestung wirklich das Eigentum des Schaedeltraegers ist."
 " Er hat sie sicherlich  "
 "seinem Eigentuemer geklaut."));
SetProp(P_NAME, "Goblinruestung");
SetProp(P_GENDER, FEMALE);
AddId(({"ruestung","goblinruestung"}));
SetProp(P_WEIGHT, 1800);//fuer angrox von 900 auf 1800
  SetProp(P_VALUE, 2000+random(450));
SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
 SetProp (P_MATERIAL, MAT_SILVER);     
   SetProp(P_QUALITY_DECAY, 88 );             
SetProp(P_AC, 33);
}

