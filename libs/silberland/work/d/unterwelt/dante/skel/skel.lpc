// dante skelette
inherit "std/mnpc";
#include <mnpc.h>     
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <class.h>
string *wie;
int i;
int heilen=1;

reset()  {
::reset();
heilen=1;  }


void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Skelett");
  SetProp(P_LONG, BS(
  "Das ist eines der Skelette, die der Skelettdrache um sich gescharrt hat. "
  "Es blickt Dich aus hohlen Augen an und deutet Dir zu verschwinden!"));
  AddDetail("augen",
  "Leer...");
  SetProp(P_NAME, "Skelett");
  SetProp(P_GENDER, NEUTER);
  AddId(({"skelett", "SKEL"}));
  AddClass(CL_UNDEAD);
  
  create_default_npc(10+random(6));
  SetProp(P_HANDS, ({" mit seinen spitzen Knochenhaenden", 100+random(8)*QueryProp(P_LEVEL) ,({DT_RIP,DT_PIERCE})}));
  SetProp(P_RACE, "Skelett");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0.2);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "klappert grinsend herein");
  SetProp(P_MSGOUT, "klappert grinsend");
  SetProp(P_MMSGIN, "steht ploetzlich grinsend vor Dir");
  SetProp(P_MMSGOUT, "grinst und ist dann verschwunden");
   SetProp(P_MNPC_AREA, "/d/unterwelt/dante/skel/sk");
   SetProp(P_MNPC_WAIT, ({random(10)+5, 5,15}));
   SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS +MOV_INDOORS+MOV_SPECIAL);
   SetProp(P_MNPC_DEFAULTROOM, "/d/unterwelt/dante/skel/sk2");
                


  SetProp(P_DIE_MSG,  " zerfaellt zu Staub.\n");
  SetProp(P_NOCORPSE, 1);

 SetProp( P_RESISTANCE_STRENGTHS,([DT_BLUDGEON:0.3, DT_FIRE: -0.5,
 DT_UNHOLY: -1.0, DT_HOLY:0.1, DT_COLD:-1.0]));      


  AddInfo(DEFAULT_INFO, "Stoere meine Totenruhe nicht.\n", "sagt: ");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");
  AddInfo(({"drache","skelettdrache"}),
  "Unser Meister!!!", "sagt: ");
  
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Was soll ein Skelett mit @WEM?\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(5,300,
    "Das Skelett haucht Dich mit seinem Todesatem an.\n",
    "Das Skelett haucht @WEN mit seinem Todesatem an.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,400,
    "Das Skelett sticht Dir mit seinen spitzen Fingern ins Auge.\n",
    "Das Skelett sticht @WEM mit seinen spitzen Fingern ins Auge.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
  "Das Skelett grinst Dich boese an.\n",
  "Das Skelett deutet Dir zu verschwinden!\n",
  "Das Skelett sagt: Hau ab!!!\n",
  "Das Skelett betet zum Skelettdrachen!\n",
  "Das Skelett sagt: Klapper auch mal!\n",
  "Das Skelett wuergt Dich!\n",
  "Das Skelett klappert laut.\n"}) );
  SetAttackChats(10, ({
  "Das Skelett bruellt: Kann man nicht mal hier seine Ruhe haben ?",
  "Das Skelett scheint zu Staub zu zerfallen...",
  "Das Skelett klappert laut.\n"}) );


wie=({"brutal","gemein","weiss","schwarz","blutrot","gewalttaetig",
  "unheimlich","schreckenerregend","gross","klein","riesig", 
    "grausig","dantinisch","eklig", "angroxmaessig"}); //.)))


i=random(sizeof(wie));

switch(random(3))  {
	case 0:
  break;
  case 1:
  "obj/pearlmaster"->DistributePearl(1, 1,1, 1);
  break;
  case 2:
  break;
  default:
                    }

 SetProp(P_SHORT, "Ein "+wie[i]+"es Skelett");     

AddCmd(({"klapper","klappere"}), "do_klapper");

}

 int do_klapper()   {

 if(heilen)  {
 write("Du klapperst wie ein Skelett und fuehlst Dich stark!!!\n"
 "Das Skelett grinst Dich an!\n");
 TP->heal_self(random(10));
 heilen--;
 return 1; }
 
 //viel heilen tuts ja nicht
 //fp waeren gut
 
 if(!heilen)  {
 write("Du klapperst dumm herum!\n"
 "Das Skelett lacht Dich aus und schlaegt Dir auf den Kopf!!!\n");
 TP->do_damage(10);
    return 1; } }
 
