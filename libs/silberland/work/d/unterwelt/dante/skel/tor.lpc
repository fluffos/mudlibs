
#include "/players/dante/myowndefine.h"

inherit "/d/dschungel/dante/geist/room/geist_inh";

//das da oben is nur vorlaeufig....wenn das ganze dir geist mal in der uwelt ist
//usw...unbedingt AENDERN!!!!!!!!!!!!

#include <properties.h>
#include <language.h>
#include <moving.h>

int karte, i;

create()
{
//  ::create();
  make_room();


  SetProp( P_INT_LONG, BS(
    "Der Nebel ist hier viel lichter als in der Umgebung. Ueberhaupt "
    "wirkt hier alles heller und freundlicher, doch das koennte auch "
    "taeuschen. Das Bauwerk, das Du schon aus der Entfernung gesehen hast, "
    "erweist sich nun als ein gigantischer Totenschaedel, dessen Maul "
    "ein Tor ist."));
 SetProp( P_INDOORS, 1 ); 
SetProp(P_INT_SHORT, "Vor einem Totenschaedel");
    
   AddDetail("bauwerk",
    "Das Bauwerk ist ein gigantischer Totenschaedel.");
  AddDetail("maul",
  "Das Maul des Schaedels beinhaltet nun ein Tor.");
    AddDetail("entfernung",
    "Der Totenschaedel ist turmhoch. Hoch oben erkennst Du einen Balkon.");
AD("statue",
"Sowas siehst Du hier nicht!");
AD("umgebung",
"Die Umgebung ist hier nicht so langweilig, wie es erscheinen mag.");
AD(({"decke","wand","waende"}),
"Durch den Nebel und die Groesse der Hoehle ist nichts davon zu erkennen.");
AD("groesse",
"GIGANTISCH!!!");

AD("himmel",
"Himmel ist hier natuerlich keiner zu sehen!");

AD("landschaft",
"Von der unterirdischen Landschaft ist durch den Nebel hindurch nicht "
"viel zu erkennen. Die unterirdische Hoehle muss unglaublich gross sein, "
"denn Du kannst weder Waende noch eine Decke erkennen.");
AD("hoehle",
"Wahrlich gigantisch gross.");
AD(({"inneres","innen"}),
"Geh rein!");

    AddDetail("balkon",
    "Das ist nicht ein Balkon, sondern eine Augenhoehle.");
    AddDetail(({"auge","augenhoehle","augen", "augenhoehlen"}),
    "Die Augenhoehlen sind leer und wirken unheimlich.");
   AddDetail(({"schaedel","totenschaedel"}),
   "Das Bauwerk ist kein wirklicher Totenschaedel. Es stellt nur einen dar. "
   "Gebaut wurde es aus den Knochen der Opfer des Skelettdrachen.");
   AddDetail("knochen",
  "Es sind unzaehlige Knochen. Viele, viele Opfer muessen daran geglaubt haben...");
    AddDetail("opfer",
    "Angeblich eine Million, aber wer weiss das schon...");
    AddDetail("million",
    "Ob Million oder nicht, egal, viele waren es sicher. Viel wichtiger "
    "sind aber die Ritzen zwischen den Knochen!");
    AddDetail(({"drache","skelettdrache"}),
    "Er herrscht hier und wartet auf Dich! Angeblich ist dieser Skelettdrache "
    "auch der Anfuehrer aller Daemonen!");
    AD(({"daemon","daemone","anfuehrer"}),
    "Der Skelettdrache ist der Anfuehrer aller Daemone. Auch der oberste aller "
    "Daemonen, der Namenlose, ist ihm unterstellt.");
    AD("namenlose",
    "Irgendwann lernst Du auch ihn kennen!");
    
    
    
    
AddDetail("schild",
"Lesen.");
AddReadDetail("schild",
"+----------------------------------------------+\n"
"| Hinter diesen Mauer haust der schreckliche   |\n"
"|                                              |\n"
"|               Skelettdrache!                 |\n"
"|                                              |\n"
"| Sei auf der Hut vor ihm und seinen Gesellen! |\n"
"|                                              |\n"
"+----------------------------------------------+\n");

AddDetail(({"ritze","ritzen"}),
"Die Ritzen sind schmal aber tief. Eine faellt Dir besonders auf...");

  AddDetail( ("pfad"),
 "Der Nebel ist so dicht, dass Du den Pfad nur einige wenige Meter"
 " ostwaerts erkennen kannst, dann verschwindet er in dieser unheimlichen Landschaft.");

    AddDetail( ({ "augenblick"}),
         "Fuer einen kurzen Moment reisst der Nebel auf.");
    AddDetail( ({ "leben"}),
    "Wie lange noch...?");
     AddDetail( ({ "tod"}),
     "Der Tod ist naeher als Du denkst!");          
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein dumpfes Grollen von weit her.");

AD("besondere ritze",
"Diese Ritze ist etwas tiefer, man sollte sie wohl genauer untersuchen, "
"aber was, wenn darin ein boeses Wesen lauert, bereit Dich zu zerfetzen? "
"Tja, nun bist Du kaum schlauer, aber dafuer veraengstigt. Geh lieber "
"wieder nach Hause...");
AD("hause",
"->R.I.P.<-");

ASD("wesen", "damfake");
 
 karte = 1;
    
  AddSmell( DEFAULT_SMELL,
    "Du kannst den Nebel direkt riechen.");
AddSound("grollen",
 "Das Grollen scheint aus dem Inneren des Totenschaedels zu kommen!\n");
   
 AddExit( "osten", "./geistskel" );
   
 AddCmd(({"greif","greife"}), "get");


 NewDoor("westen", ("/d/unterwelt/dante/skel/sk1"),
  ({"tor"}),
  
   ({
    D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
     D_LONG, "Das Tor ist gigantisch gross. Du siehst ein Schild.\n" ,
                D_GENDER, NEUTER,
                D_SHORT, "Ein %ses Tor.",
                 D_NAME, "Tor",
                  } ));



  for(i=0;i<random(4)+1;i++)
 AIT("/d/unterwelt/dante/skel/srat", REFRESH_DESTRUCT);

 
}

string damfake()
   {
   write("Du willst es genauer wissen!\n");
   write(BSA("He, "+CAP_TPN+", ich hab echt keine Lust Dich zu zerfetzen! "
   "Du schmeckst schlecht, bist zu fett und ueberhaupt, mein Magen macht "
   "auch nicht mehr so mit.", "Das Wesen aus der Ritze sagt: "));
   
   return "";
   }
   

reset()
{
::reset();
karte=1;
}

int get(string str)
  {
  object ob;
   notify_fail ("Wo willst Du hier hineingreifen ?\n");
   if (!str) return 0;
   if (str!="in ritze") return 0;
   if (!karte)
   {
   notify_fail("Du greifst in die Ritze, doch leider ist sie leer.\n");
   return 0;
   }
   
   write(
   "Du greifst in die Ritze und findest einen Knochen...\n");
   say(""+TPN+" macht sich an der Wand zu schaffen.\n");
      ob=clone_object("d/unterwelt/dante/skel/knochen");
      ob->move(TP, M_GET);
   karte --;
   return 1;
   }
   
