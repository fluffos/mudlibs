
#include "/players/dante/myowndefine.h"

inherit "/d/dschungel/dante/geist/room/geist_inh";

//das kann mal sobleiben...betrifft eigentlich das dir geist...
//wenn man alles aus dem dir geist nach uwelt gekommen ist, bitte HIER
//unbedingt aendern!!!!!!

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
int heilen=5;


create()
{
//  ::create();
  make_room();

SetProp(P_INT_SHORT "Im Nebel");
  SetProp( P_INT_LONG, BS(
    "Dichter Nebel umhuellt Dich hier. Du kannst nichts, aber auch gar nichts "
    "erkennen. Lichtpunkte tanzen um Dich herum und sind eine kleine "
    "Abwechslung in dieser monotonen, trueben Landschaft. "
    "Du hast keine "
    "Ahnung wo Du bist. Doch Du spuerst, dass sich ganz nahe etwas "
    "Boeses befindet, bereit Dich zu toeten."));
    AD("boeses",
    "Sehr nahe...");
     AD("ahnung",
     "Ueberhaupt keine! Aber ein Pfad verlaeuft da.");
     
SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );



SetProp(P_INDOORS, 1);    
    AD(("nebel",
     "Als der Nebel fuer einen kurzen Augenblick etwas duenner "
     "wird, glaubst Du weiter "
 "die schemenhaften Umrisse eines gewaltigen Bauwerkes zu erkennen."));

  AddDetail( ({"umrisse","umriss"}),
    "Du glaubst ein gewaltiges Bauwerk zu erkennen.");

AddDetail("wasser",
"Das Wasser sieht sehr giftig aus!");
AddDetail(({"nebelschleier","schleier"}),
"Unheimlich und duester ziehen sie an Dir vorueber!");
AddDetail("wind",
"Manchmal blaest ein sanfter Wind den Nebel umher.");
AddDetail("meter",
"Nur wenige.");
AddDetail("blitz",
"Ab und zu schiesst ein Blitz herab.");


  AddDetail( ({ "westen"}),
    "Das gewaltige Bauwerk liegt im Westen. "
     "Du wirst schon in diese Richtung gehen muessen, um mehr zu erkennen.");
  AddDetail( ({ "bauwerk"}),
    "Von hier kannst Du wegen dem dichten Nebel leider nichts genaueres erkennen.");
  AddDetail( ("pfad"),
    "Der Nebel ist so dicht, dass Du den Pfad nur einige wenige Meter"
    " nach Westen erkennen kannst, dann verschwindet er in dieser unheimlichen Landschaft.");
  AddDetail( ({ "augenblick"}),
    "Fuer einen kurzen Moment reisst der Nebel auf.");
  AD("boden",
  "Am Boden siehst Du einen Pfeil. Auch eine "
  "kleine Lache ist da zu entdecken.");
  AD("pfeil",
  "Der Pfeil zeigt direkt nach Osten.");
  
  AD("lache",
  "Das Wasser in ihr sieht eklig und giftig aus. Trinken sollte man das "
  "nicht!!! Auf keinen Fall!!!");
  AD("fall",
  "Oder doch.");
  AD("statue",
  "Sowas siehst Du da nicht!");
AD("himmel",
"Der Himmel ist hier nicht zu sehen, wie auch. Und wenn einer da waere, "
"wuerde der Nebel ihn verdecken. Also kein Himmel hier!");

AddSound("grollen",
"Das Grollen kommt direkt aus dem Westen!\n");
AD("moment",
"Kurz reisst der Nebel auf und Du siehst ein gewaltiges Bauwerk.");
AD(({"wand","decke","waende"}),
"Du koenntest die Waende hochlaufen, wenn es hier welche gaebe.");
  AddGuardedExit( "westen", "/d/unterwelt/dante/skel/tor", "schaedeltraeger",
  "Der Schaedeltraeger tritt Dich nieder!\n"); 

AddSound(({"stimme","stimmen","name"}),
  "Hm, Du scheinst Dich geirrt zu haben.\n");
  AddDetail("erde",
  "Die Erde ist teilweise von Blitzen versengt worden.");
  AddDetail("zittern",
  "Du zitterst aengstlich.");
  AddDetail("landschaft",
  "Von der Landschaft kannst Du nur schemenhafte, verzerrte Umrisse"
" erkennen. Der Nebel verhindert jede genauere Betrachtung. "
"Das erstaunliche ist aber, dass diese unheimliche Landschaft in einer "
"riesigen, unterirdischen Hoehle ist.");
AddDetail("hoehle",
"Sie muss gewaltige Ausmasse haben. Denn Du siehst nichts von ihr. Keine "
"Waende, keine Decke, nichts eben.");
AddDetail("nichts", "");
AddDetail(({"ausmasse","ausmass"}),
  "Die Hoehle ist einfach gigantisch gross.");
  
  AddExit( "osten", "./portal2" );
  AddExit( "sueden", "./geistskel" );
    AddExit( "norden", "./geistskel" ); 
  AddExit( "suedwesten", "./geistskel" ); 
   AddExit( "nordosten", "./geistskel" );
     AddExit( "nordwesten", "./geistskel" );
    AddExit( "suedosten", "./geistskel" );
AddCmd(({"trink","trinke"}), "heal");

AddItem
 ( ({"/d/unterwelt/dante/skel/straeger",
     "/d/unterwelt/dante/skel/straeger2"}), REFRESH_DESTRUCT);
  
   AddRoomMessage( ({
     "Nebelschwaden ziehen an Dir vorueber.\n",
       "Durch die Erde scheint ein leichtes Zittern zugehen.\n",
         "Die Lichtpunkte kreisen um Dich herum.\n",
            "Die Lichtpunkte tanzen durch den Nebel.\n",
               "Du glaubst ein dumpfes Grollen von sehr weit weg zu hoeren.\n",
                  "Ein greller Blitz durchzuckt den Nebel.\n",
                     "Du hast Dich voellig im Nebel verirrt.\n",
                        "Du glaubst Stimmen aus dem Nebel zu hoeren.\n",
                           "Der Wind reisst die Nebelschleier kurz auf.\n",
                              "Halt! Da war doch der Pfad, oder...\n",
                                 "Der Nebel huellt Dich ein...\n",
                                    "Hat da nicht eben jemand Deinen Namen gerufen...\n"}),90);
                                    
   
}


int heal(string str)
  {
  NF("Was willst Du trinken? Woraus?\n");
  if(str=="wasser aus lache"||str=="wasser"||str=="aus lache")  {
      if(!heilen)  {
      write("Du trinkst aus der Lache! Waeh! Eklig!\n");
      say(CAP_TPN+" trinkt aus einer ekligen Lache!\n");
      return 1;
          }
      if(heilen)  {
      write("Du trinkst aus der Lache und erstaunlicherweise schmeckt das "
      "Wasser wirklich gut und erfrischend.\n");
      TP->heal_self(25+random(25));
      heilen--;
      return 1;
         }
      return 0;
      }
    return 0;
    }
    
    reset(){
    ::reset();
    heilen=3+random(3);
    }
      
      
