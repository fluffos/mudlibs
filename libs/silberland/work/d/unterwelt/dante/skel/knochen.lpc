//schluessel fuer das tor zum skelettdrachen


inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include "/players/dante/myowndefine.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp (P_SHORT, "Ein seltsamer, duenner Knochen");
  SetProp (P_LONG,BS (
  "Dieser Knochen ist sicher kein gewoehnlicher Knochen, das ist sicher."));
  SetProp (P_NAME, "Knochen");
  SetProp(P_NAME_ADJ, ({"seltsam","duenn"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 2000);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  SP(P_INFO, "Dieser Knochen oeffnet Dir neue Wege und "
  "kann Dich auch in den Tod fuehren!\n");
  SetProp (P_NEVERDROP, 0);
  AddId (({"\nkeyskelett", "schluessel","knochen"}));
  
SetProp(P_MATERIAL, ([MAT_BONE:90, MAT_MISC_MAGIC:10]));
}
string QueryDoorKey()
{
return ("/d/unterwelt/dante/skel/sk1")+":"+("/d/unterwelt/dante/skel/tor");   
}



