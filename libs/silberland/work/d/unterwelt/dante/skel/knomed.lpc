inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>   
#include <mnpc.h>    
#include "/players/dante/myowndefine.h"



create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  AddId (({"knochenmedaillon","medaillon","medailon",}));
  SetProp (P_SHORT, "Ein rundes Knochenmedaillon");
  SetProp (P_LONG, BS(
  "Dieses Medaillon wurde aus dem Schaedel eines unvorsichtigen "
  "Hobbits gefertig. Es haengt an einer weisslichen Kette, mit der "
  "man es sich um den Hals haengen kann."));
  AD("kette",
  "He! Die Kette leuchtet seltsam. Ihr Licht interessiert Dich!");
  AD("licht",
  "Ein Lichtstrahl blendet Dich kurz und in Deinem Kopf entstehen Worte:\n"
  "Dieses Amulett ist eine Forscherpunktwuenschelrute.\n"
  "Der Befehl dazu heisst 'eigamtimgew'.\n");
      
  SetProp (P_NAME, "Knochenmedaillon");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 150);
  SetProp (P_VALUE, 5000+random(400));
  SetProp (P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  //absicht!!!
  
  SetProp (P_ARMOUR_TYPE, AT_AMULET);
  SetProp (P_AC, 1);
  SetProp(P_INFO, 
   "Das Knochenmedaillon kann einiges...\n");
  SetProp(P_MATERIAL, MAT_BONE);

  AddCmd("eigamtimgew", "fake");
}

   fake()  {
   int mp;
   object name;
   name=file_name(environment(TP));
   
   mp=TP->QueryProp(P_SP);
   if(mp<50)  {
   write("Das Knochenamulett weigerst sich Dir Forscherpunkte zu zeigen!\n");
   return 1;
   }
   else {
   TP->restore_spell_points(-50);
   write("Das Knochenamulett blitzt kurz auf und in Dir formen sich Worte:\n");
   write(
   "Dieser Raum hat mit "+strlen(name)*2+"% Wahrscheinlichkeit einen FP!\n");
   return 1;
   //raeume deren pfad mehr als 100 ergeben koennten hab ich keine gefunden
   //sicher man koennte auch ne abfrage machen...
        }
   return 0;
   }
   
