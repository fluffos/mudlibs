/*
  Umgebung der Alchemistengilde

  Room a_12_2

  30.04.2005 Georg Schardt
  05.01.2006 Typokorrektur
  26.08.2006 Umbau auf inherit

*/

#include "../def.h"
inherit ROOM "inh_lichtung";

void create()
{
  ::create();
  SetProp( P_INT_LONG,
	   "Du stehst vor der Huette auf der kleinen Lichtung. Nach Norden "
	   "und Westen kannst Du weiter auf der Wiese herumlaufen. Die Huette "
	   "scheint bewohnt zu sein, denn Du siehst weissen Rauch aus dem "
	   "Kamin aufsteigen. Durch das kleine Fenster neben der Tuer "
	   "erkennst Du niemanden. Dir bleibt wohl nichts anderes ueber, als "
	   "die Huette durch die Tuer nach Suedosten zu betreten.\n");
  AddDetail("tuer",
	    "Sie steht offen. Was wartest Du noch?");
  AddDetail("huette",
	    "Die Huette steht im Suedosten. Sie hat eine runde Form, "
	    "mehr erkennst Du von hier aus nicht. Aus dem Kamin steigt Rauch "
	    "auf. Es sieht so aus, als waere die Huette bewohnt.");
  AddDetail("form",
	    "Rund trifft es schon am besten.");
  AddDetail("fenster","In der Huette ist es zu dunkel. Du siehst nur Dein "
	    "eigenes Spiegelbild.");
  AddDetail("spiegelbild","Koenntest Dich schon noch mal kaemmen. Schaem Dich.");
  AddExit("westen",ROOM "a_11_2.lpc");
  AddExit("norden",ROOM "a_12_3.lpc");
  AddExit("suedosten", ROOM "alchemisten.lpc");
}








