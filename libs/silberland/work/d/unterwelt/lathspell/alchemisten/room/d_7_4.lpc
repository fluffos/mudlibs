#include "../def.h"
inherit ROOM "inh_gang";


void init()
{

  if (interactive(TP)) {
    AREA->Msg(TP->Name(WER)+BS(" betritt das Gebiet der Alchemisten"),1);
  }
  ::init();
}

void create()
{
  ::create();
  AddExit("suedwesten",ANSCHLUSSRAUM);
  AddExit("norden", ROOM "d_7_3");
}

void reset() 
{
  if (QueryProp(P_LIGHT)<=0)
    LICHTMASTER->licht_an(1);
}

int cmd_hacke()
{
  if (ENV(TP)->QueryProp(P_LIGHT)<1) {
    tell_object(TP,BS("Die Ranke ist doch schon zerrissen."));
  }
  LICHTMASTER->licht_aus(1);
  return 1;
}
