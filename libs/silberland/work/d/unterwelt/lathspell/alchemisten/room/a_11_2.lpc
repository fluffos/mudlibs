/*
  Umgebung der Alchemistengilde

  Room a_11_2

  30.04.2005 Georg Schardt
  05.01.2006 Typokorrektur
  26.08.2006 Umbau auf inherit

*/

#include "../def.h"
inherit ROOM "inh_lichtung";

void create()
{
  ::create();
  SetProp( P_INT_LONG,
	   "Du stehst auf der kleinen Lichtung inmitten des dunklen "
	   "Nadelwaldes. Nach Norden, Osten und Westen erstreckt "
	   "sich eine Blumenwiese mit vielen Dir bekannten und unbekannten "
	   "Wildblumen. Du hoerst Grillen zirpen und Bienen summen. "
	   "Wuerde der dunkle Waldrand nicht so bedrohlich aussehen, wuerdest "
	   "Du Dich hier richtig wohl fuehlen. So allerdings hast "
	   "Du Angst, dass jederzeit eine wilde Bestie aus dem Dickicht "
	   "springt. Im Osten siehst Du eine kleine runde Huette, aus deren "
	   "Kamin weisser Rauch weht. Geh doch mal naeher ran.");
  AddItem(NPC "huhn",REFRESH_DESTRUCT);
  AddDetail("huette",
	    "Die Huette steht im Osten. Sie hat eine runde Form, "
	    "mehr erkennst Du von hier aus nicht. Aus dem Kamin steigt Rauch "
	    "auf. Es sieht so aus, als waere die Huette bewohnt.");
  AddDetail("form","Die Huette ist rund. Nicht mehr und nicht weniger.");
  AddExit("westen",ROOM "a_10_2.lpc");
  AddExit("osten", ROOM "a_12_2.lpc");
  AddExit("norden",ROOM "a_11_3.lpc");
}
