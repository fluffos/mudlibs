#pragma strong_types
inherit "std/room";
 
#include "../def.h"


int baumweg;
string *spieler;

void create()
{
  ::create();
  
  spieler=({}); //Array für die Spieler die in Aktion sind
  SetProp( P_LIGHT, 1);
  SetProp( P_INT_SHORT,"Ein Trampelpfad");
  SetProp(P_INDOORS,0);
  SetProp( P_INT_LONG,
	   "Hier endet der Trampelpfad ploetzlich. Dein Weiterkommen wird "
	   "durch eine riesige, umgestuerzte Tanne verhindert. Dir bleibt "
	   "wohl nichts anderes uebrig, als nach Osten zurueckzugehen.\n");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_FOREST]) ); 
  AddDetail("dunkelheit","Sieh zu, dass Du eine Lichtquelle bekommst.\n");
  AddDetail("lichtquelle","Die brauchst Du bestimmt bald.\n");
  AddDetail("himmelsrichtung","Untersuchst Du immer alles?\n");
  AddDetail(({"osten"}),"Eine Himmelsrichtung.\n");
  AddDetail("boden",
	    "Du stehst auf einem lehmigen Trampelpfad. Der Boden ist mit "
	    "vielen Fussspuren uebersaeht, die scheinbar unter dem Baumstamm "
	    "weitergehen.\n");
  AddDetail(({"weg","trampelpfad","pfad"}),"Du stehst in einer Sackgasse. Du "
	    "kannst nur dem Pfad zurueck nach Osten in die Dunkelheit "
	    "folgen.\n");
  AddDetail(({"sackgasse","gasse"}),"Du kannst nur zurueck.\n");
  AddDetail(({"spuren","fussspuren"}),"Es sind so viele, dass Du sie nicht "
	    "auseinander halten kannst. Sie haben diesen Trampelpfad hier "
	    "verfestigt.\n");
  AddDetail(({"blick","weiterkommen"}),"Auf den ersten Blick sieht es so aus, "
	    "als ob man hier nicht weiterkommt.\n");
  AddDetail("himmel","Hier und da kannst Du den Himmel durch die Baeume "
	    "sehen. Daher ist es hier auch etwas heller.\n");
  AddDetail(({"nadeln","nadel"}),"Die haengen an den Nadelbaeumen.\n");
  AddDetail("streifen","Die Streifen sind auf der Unterseite der Nadeln zu "
	    "erkennen.\n");
  AddDetail( ({"kerl","kerlchen"}), "Das bist wohl Du.\n");
  AddDetail("unterseite","Die Unterseite ist nicht die Oberseite.\n");
  AddDetail(({"nadelwald","wald","nadelbaeumen","nadelbaeume","stelle"}),
	    "Der Wald lichtet sich hier ein bisschen. Ein starker Sturm hat "
	    "wohl den einen oder anderen Baum entwurzelt. Dummerweise liegt "
	    "einer quer ueber den Trampelpfad und verhindert so "
	    "Dein Weiterkommen.\n");
  AddSpecialDetail("baeume","baeume");
  AddDetail("meter","Etwa einen Zwerg hoch.\n");
  AddDetail("zwerg","Ein Zwerg misst etwa einen Meter.\n");
  AddDetail(({"dickicht","straeucher"}),
	    "Die Straeucher, die den Trampelpfad eingrenzen, sind sehr dicht "
	    "und bilden ein undurchdringbares Dickicht.\n");
  AddSpecialDetail(({"tanne","baum","baumstamm","stamm"}),"stamm");
  AddSpecialDetail("schleifspuren","schleifspuren");
  AddSpecialDetail("kratzer","kratzer");
  AddDetail("laenge","Die einen mehr, die anderen weniger.\n");
  AddSpecialDetail(({"stammoberseite","oberseite"}),"oberseite");
  AddCmd("schieb|schiebe&baum|stamm|baumstamm&beiseite|zur&seite",
	 "cmd_schiebe","Was willst Du schieben?|Wohin willst Du den "
	 "Baumstamm schieben?");
  AddCmd("kriech|krieche&unter&stamm|baumstamm|baum","cmd_krieche","Wie "
	 "willst Du kriechen?|Unter was willst Du kriechen?");
  AddCmd("kletter|klettere&ueber&stamm|baum|baumstamm","cmd_kletter","Wie "
	 "willst Du klettern?|Ueber was willst Du klettern?");
  AddExit ("osten", ([ EX_DEST: ROOM "a_9_4.lpc",
                       EX_TESTFUNC: "exit_test" ]) );
  baumweg=0;
}


//Weglaufen in ner Aktion gillt nicht :)
int exit_test(string dir) 
{
  if(!TP)              return 1;
  if(!interactive(TP)) return 1;
  if(member(spieler, getuuid(TP)) == -1) return 1;
  tell_object(TP, BS("Du bist zu beschaeftigt."));
  return 0;
}

int GetBaumweg() 
{
  return baumweg;
}

void SetBaumweg(int i) 
{
  baumweg=i;
  if (baumweg==0) {
    SetProp( P_INT_LONG,
	     "Hier endet der Trampelpfad ploetzlich. Dein Weiterkommen wird "
	     "durch eine riesige umgestuerzte Tanne verhindert. Dir bleibt "
	     "wohl nichts anderes uebrig, als nach Osten zurueckzugehen.\n");
    RemoveExit("nordwesten");
  }  else {
    SetProp( P_INT_LONG,
	     "Hier wird der Pfad etwas heller. Ein starker Windstoss hat "
	     "einen Baum umgeworfen, dieser scheint allerdings "
	     "weggeschoben worden zu sein. Du kannst nach Nordwesten "
	     "weitergehen.\n");
    AddExit("nordwesten",ROOM "a_7_5.lpc");
  }
}

void reset()
{
  ::reset();
  SetBaumweg(0);
}

int cmd_schiebe(string str)
{
  if (baumweg==1) {
    write(BS("Was fuer einen Baum meinst Du bitte?"));
    return -1;
  }
  if (member(spieler,getuuid(TP))!=-1) {
    tell_object(TP,BS("Du bist zu beschaeftigt!"));
    return -1;
  }
  if(TP->QueryProp(P_GHOST)) {
    write(BS("Als Geist wuerde Dir das ausgesprochen schwer fallen."));
    return -1;
  }
  if (TP->QueryAttribute(A_STR) <= 35) {
    write(BS("Du versuchst, den Baumstamm aus dem Weg zu schieben. "
	     +"Nach einiger Zeit gibst Du allerdings erschoepft auf."));
    return -1;
  }
  spieler+=({ getuuid(TP) });
  call_out("schieben",0,TP,1);
  return 1;
}

void schieben(object player, int count)
{
  if(!player)                return; // object richtig uebergeben?
  if(!interactive(player))   return; // Spieler noch interaktiv? 
  if(ENV(player)!=TO)            return; // Ist der Spieler noch im Raum?

  switch(count) 
    {
    case 1:
      tell_object(player,"Du packst den Baum mit beiden Haenden.\n");
      Message(BS(TP->Name(WER)+" packt sich den Baum mit beiden Haenden."),
	      MSGFLAG_VISUAL|MSGFLAG_NO_TP);      
      break;
    case 2:
      tell_object(player,"Du drueckst mit Deinem ganzen Gewicht gegen den "
		  "Stamm.\n");
      Message(BS(player->Name(WER)+" stemmt sich gegen den Stamm."),
	      MSGFLAG_VISUAL|MSGFLAG_NO_TP);      
      break;
    case 3:
      tell_object(player,"Mit aller Kraft schiebst Du den Baum ins Dickicht.\n");
      Message(BS(player->Name(WER)+" schiebt den Baum ins Dickicht."),
	      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      break;
    default:
      baumweg=1;
      tell_object(player,"Du schiebst den Baum beiseite und legst einen Ausgang "
		  "im Nordwesten frei.\n");
      AddExit("nordwesten",ROOM "a_7_5.lpc");
      SetProp( P_INT_LONG,
	       BS("Hier wird der Pfad etwas heller. Ein starker Windstoss hat "
	       "einen Baum umgeworfen, dieser scheint allerdings "
	       "weggeschoben worden zu sein. Du kannst nach Nordwesten "
		  "weitergehen."));
      spieler-=({ getuuid(TP) }); //Spieler wieder austragen
      return; //Sequenz zu Ende
      break;
    }
  call_out("schieben", 3+random(3), TP, ++count);
  return;
}

int cmd_krieche(string str)
{
  if (baumweg==1) {
    write(BS("Der Baum ist doch zur Seite geschoben."));
    return -1;
  }
  if (member(spieler,getuuid(TP))!=-1) {
    tell_object(TP,BS("Du bist zu beschaeftigt!"));
    return -1;
  }
  if (TP->QueryProp(P_RACE)=="Oger") {
    write(BS("Du versuchst, Dich unter dem Baumstamm durchzuzwaengen, bleibst "
	     "aber stecken."));
    return -1;
  }
  if (TP->QueryProp(P_SIZE)>150) {
    write(BS("Du versuchst, unter dem Stamm zu kriechen, verrenkst Dir beim "
	     "Buecken aber so schlimm den Ruecken, "
	     "dass Du es lieber sein laesst."));
    return -1;
  }
  spieler+=({ getuuid(TP) });
  call_out("kriechen",0,TP,1);
  return 1;
}

void kriechen(object player, int count)
{
  if(!player)                return; // object richtig uebergeben?
  if(!interactive(player))   return; // Spieler noch interaktiv? 
  if(ENV(player)!=TO)            return; // Ist der Spieler noch im Raum?
  
  switch(count) 
    {
    case 1:
      tell_object(player,BS("Du bueckst Dich runter und faengst an, unter den Stamm "
			    "zu kriechen."));
      Message(BS(player->Name(WER)+" faengt an, unter den Stamm zu kriechen."),
	      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      break;
    case 2:
      tell_object(player,BS("Es wird immer enger, Du haettest nicht gedacht, dass Du "
			    "so dick bist."));
      Message(BS(player->Name(WER)+" verschwindet unter dem Stamm."),
	      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      break;
    case 3:
      tell_object(player,BS("Fast glaubst Du stecken zu bleiben, aber da geht es "
			    "auf einmal besser weiter."));
      break;
    default:
      tell_object(player,"Du stehst auf der anderen Seite des Baumes.\n");
      spieler-=({ getuuid(TP) }); //Spieler wieder austragen
      TP->move(ROOM "a_7_5.lpc",M_NOCHECK|M_SILENT);      
      return; //Sequenz zu Ende
      break;
    }
  call_out("kriechen",3+random(3),TP,++count);
  return;
}

int cmd_kletter(string str)
{
  if (baumweg==1) {
    write(BS("Der Baum ist doch zur Seite geschoben."));
    return -1;
  }
  if (member(spieler,getuuid(TP))!=-1) {
    tell_object(TP,BS("Du bist zu beschaeftigt!"));
    return -1;
  }
  if (TP->QueryProp(P_RACE)=="Oger") {
    write(BS("So sehr Du auch springst und kletterst, Du schaffst es nicht, "
	     "ein Bein soweit zu heben, "
	     "um es ueber den Stamm zu bekommen."))	;
    return -1;
  }
  if (TP->QueryProp(P_SIZE)<=150) {
    write("Du bist viel zu klein, um auch nur eine Hand oben auf den Stamm "
	  "zu legen.");
    return -1;
  }
  spieler+=({ getuuid(TP) });
  call_out("klettern",0,TP,1);
  return 1;
}

void klettern(object player, int count)
{
  if (!player) return;
  if (!interactive(player)) return;
  if (ENV(TP)!=TO) return;

  switch(count)
    {
    case 1:
      tell_object(TP,"Du gehst ein paar Schritte zurueck und nimmst "
		  "Anlauf.\n");
      Message(BS(TP->Name(WER)+" geht ein paar Schritte vom Baum weg und "
		 "scheint Anlauf zu nehmen."),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      break;
    case 2:
      tell_object(TP,"Du laeufst auf den Baum zu, hoffentlich schaffst Du "
		  "das...\n");
      Message(BS(TP->Name(WER)+" laeuft auf den Stamm zu."),
	      MSGFLAG_VISUAL|MSGFLAG_NO_TP);      
      break;
    case 3:
      tell_object(TP,"Du legst eine Hand auf den Stamm und schwingst Deine "
		  "Beine gekonnt ueber den Baum.\n");
      Message(BS(TP->Name(WER)+" springt elegant ueber den Baum und ist "
		 "verschwunden."),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      break;
    default:
      tell_object(TP,"Du stehst auf der anderen Seite des Baumes.\n");
      spieler-=({ getuuid(TP) });
      TP->move(ROOM "a_7_5.lpc",M_NOCHECK|M_SILENT);      
      return; //Sequenz zu Ende
      break;
    }
  call_out("klettern",3+random(3),TP,++count);
  return;
}

string oberseite(string str)
{
  if (baumweg==1)
    return(BS("Der Baum wurde wohl zur Seite geschoben."));
  return (BS("Die zeigt nach oben."));
}

string kratzer(string str) 
{
  int size;
  string race;

  if (baumweg==1)
    return(BS("Der Baum wurde wohl zur Seite geschoben.\n"));
  size=TP->QueryProp(P_SIZE);
  race=TP->QueryProp(P_RACE);
  if ((race=="Oger")||(race=="Troll"))
    return BS("Dich interessieren diese Kratzer gar nicht. Am liebsten "
	      "wuerdest Du diesen dummen Baum einfach zur Seite schieben.");
  if (size<=150)
    return BS(sprintf("Die Kratzer befinden sich an der Stammoberseite, "
		      "die Du mit Deinen %d cm allerdings nicht sehen "
		      "kannst.",size));
  return BS("Die Kratzer sehen so aus, als ob hier jemand ueber den Stamm "
	    "geklettert ist.");
}

string schleifspuren(string str)
{
  int size;
  string race;

  if (baumweg==1)
    return(BS("Der Baum wurde wohl zur Seite geschoben.\n"));
  size=TP->QueryProp(P_SIZE);
  race=TP->QueryProp(P_RACE);
  if ((race=="Oger")||(race=="Troll")) {
    if (TP->QueryProp(P_GENDER)!=FEMALE)
      return BS("Warum immer alles untersuchen. Bist doch en starkes "
		"Kerlchen.");
    else
      return BS("Warum immer alles untersuchen. Bist doch ne starke Dame.");
  }
  if (size>150)
    return BS(sprintf("Die Schleifspuren sind unten auf dem Boden und mit "
		      "Deiner Laenge kannst Du sie gar nicht so genau "
		      "erkennen.",size));
  return BS("Es sieht so aus, als koennte man unter dem Baum "
	    "durchkriechen.");
}

string baeume(string str)
{
  if (baumweg==0)
    return BS("Die Baeume lichten sich ein wenig, daher ist es hier etwas "
	      "heller. Ein Baum liegt quer ueber den Trampelpfad.");
  return BS("Die Baeume lichten sich ein wenig, daher ist es hier etwas "
	    "heller.");
}
string stamm(string str) 
{
  if (baumweg!=1)
    return (BS("Der riesige Baumstamm liegt quer ueber den Pfad. Du kannst "
	       "wegen des dichten Dickichts nicht links oder "
	       "rechts an ihm vorbei. Allerdings erkennst Du Schleifspuren "
	       "unter dem Baum und einige Kratzer an dem Baumstamm."));
  return("Der Baumstamm wurde wohl zur Seite geschoben.");
}






