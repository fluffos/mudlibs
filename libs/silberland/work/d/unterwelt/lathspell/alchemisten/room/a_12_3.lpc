/*
  Umgebung der Alchemistengilde

  Room a_12_2

  30.04.2005 Georg Schardt
  05.01.2006 Typokorrektur
  26.08.2006 Umbau auf inherit

*/

#include "../def.h"
inherit ROOM "inh_lichtung";

int blumcnt=0;

void create()
{
  ::create();
  SetProp( P_INT_LONG,
	   "Du stehst im hintersten Winkel der kleinen Lichtung. Nach Sueden "
	   "und Westen erstreckt sich eine Blumenwiese mit vielen Dir "
	   "bekannten und unbekannten Wildblumen. Allerdings haben es die "
	   "Gaensebluemchen hier in der Ecke auf eine beachtliche Groesse "
	   "geschafft. Wuerde der dunkle Waldrand nicht so bedrohlich "
	   "aussehen, wuerdest Du Dich hier richtig wohl fuehlen. "
	   "Im Sueden siehst Du eine kleine runde Huette, aus deren "
	   "Kamin weisser Rauch weht. Geh doch mal naeher ran.");
  AddItem(NPC "biene",REFRESH_DESTRUCT);
  AddItem(NPC "biene",REFRESH_DESTRUCT);
  AddItem(NPC "biene",REFRESH_DESTRUCT);

  AddDetail(({"winkel","ecke"}),
	    "Genau da stehst Du jetzt. Also schaem Dich.");
  AddDetail(({"groesse","zuechtung"}),
	    "Sieht aus wie ne spezielle Zuechtung. Pflueck doch mal eine.");
  AddDetail("huette",
	    "Die Huette steht im Sueden. Sie hat eine runde Form, "
	    "mehr erkennst Du von hier aus nicht. Aus dem Kamin steigt Rauch "
	    "auf. Es sieht so aus, als waere die Huette bewohnt.");
  AddDetail(({"wildblumen","blumen","blume"}),
	    "Ausser den Gaensebluemchen und dem Loewenzahn kennst Du keine "
	    "der hier bluehenden Blumen.");
  AddDetail("gaensebluemchen",
	    "Gaensebluemchen sind kleine Blumen mit weissen Bluetenblaetter, "
	    "gelbem Bluetenstand und gruenen Blaettern. Diese hier haben eine "
	    "stattliche Groesse erreicht.");
  AddDetail("loewenzahn",
	    "Der Loewenzahn hat eine gelbe Bluete und gruene Blaetter.");
  AddDetail("form",
	    "Rund trifft es schon am besten.");
  AddCmd("pflueck|pfluecke&blume|bluemchen","cmd_pfluecke",
	 "Was willst Du pfluecken?");
  AddExit("westen",ROOM "a_11_3.lpc");
  AddExit("sueden",ROOM "a_12_2.lpc");
}

void reset() {
  blumcnt=0;
  BIENENMASTER->reset();
}

int cmd_pfluecke(string str)
{
  object obj;

  if (blumcnt>2) {
    write(BS("Zur Zeit erlaubt Trismegistos es nicht, dass die Blumen gepflueckt "
	     "werden.\n"));
    return 1;
  }
  blumcnt++;
  if (random(2)) {
    
    if (obj=clone_object(OBJ "gaensebluemchen.lpc")) {
      write(BS("Du pflueckst ein Gaensebluemchen."));
      ENV(TP)->Message(BS(TP->Name(WER)+" pflueckt ein Gaensebluemchen"),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      obj->move(TP);
    }
  } else {
    if (obj=clone_object(OBJ "loewenzahn.lpc")) {
      write(BS("Du pflueckst ein Loewenzahn."));
      ENV(TP)->Message(BS(TP->Name(WER)+" pflueckt ein Loewenzahn"),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      obj->move(TP);
    }
  }    
  return 1;
}
	




