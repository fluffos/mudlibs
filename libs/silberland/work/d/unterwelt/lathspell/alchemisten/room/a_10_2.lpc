/*
  Umgebung der Alchemistengilde

  Room a_10_2

  30.04.2005 Georg Schardt
  05.01.2006 Typokorrektur
  26.08.2006 Umbau auf inherit

*/

#include "../def.h"
inherit ROOM "inh_lichtung";

int pfuetze=0;

void create()
{
  ::create();
  SetProp( P_INT_LONG,
	   "Du stehst auf einer kleinen Lichtung inmitten des dunklen "
	   "Nadelwaldes. Nach Norden und Osten erstreckt "
	   "sich eine Blumenwiese mit vielen Dir bekannten und unbekannten "
	   "Wildblumen. Du hoerst Grillen zirpen und Bienen summen. "
	    "Vor Dir ist eine kleine Pfuetze im Boden. Pass auf, dass Du "
	   "nicht reinlaeufst. Hier ist der Wald nicht so dicht und die Fels"
	   "wand kommt bis an die Lichtung heran. Im Suedwesten erkennst du "
	   "eine Felsspalte."
	   );
  AddDetail("boden",
	    "Der Boden besteht hauptsaechlich aus Wiese mit einigen "
	    "Wildblumen. Da es laenger nicht geregnet hat, ist der Boden "
	    "recht trocken. Wasser gaebe es nur in der Pfuetze vor Dir.\n");
  AddDetail(({"wasser","pfuetze"}),
	    "Komisch, hier ist doch sonst alles trocken, wo kommt nur die "
	    "Pfuetze her? Wie auch immer, das Wasser sieht "
	    "klar und sauber aus.");
  AddDetail(({"felsspalte","spalte"}),
	    "Im Suedwesten verschwindet ein kleiner Pfad in einer Felsspalte");
  AddDetail("pfad",
	    "Fast waere Dir der kleine Pfad in die Felsspalte nicht aufgefallen. "
	    "Dabei bist du ueber ihn auf die Lichtung gelangt.");
  AddCmd("lauf|laufe|spring|springe&in&pfuetze|wasser","cmd_springe","In was willst du springen?");
  AddCmd("trink|trinke&aus&pfuetze","cmd_trinke","Aus was willst du trinken?");
  AddExit("suedwesten", ROOM "a_9_1.lpc");
  AddExit("osten",      ROOM "a_11_2.lpc");
  AddExit("norden",     ROOM "a_10_3.lpc");
}


void reset() {
  pfuetze=0;
}

int cmd_springe(string str)
{
  if (pfuetze==0) {
    write(BS("Du springst wie ein Verrueckter in der Pfuetze herum. Wasser spritzt nach allen "
	     "Seiten. Du, Deine Klamotten und Deine Ausruestung werden pitsche patsche nass. "
	     "Hoffentlich hat Dir keiner zugesehen.\n"));
    Message(BS(TP->Name(WER))+" springt wie ein Verruechter in der Pfuetze umher.\n",
	    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    pfuetze=1;
  } else {
    write(BS("Da ist ja gar kein Wasser mehr in der Pfuetze."));
  }
  return 1;
}

int cmd_trinke(string str)
{
  if(pfuetze==0) {
    write(BS("Du trinkst mit den Haenden aus der Pfuetze. Aaaah, das tut gut."));
    Message(BS(TP->Name(WER))+" trinkt aus der kleinen Pfuetze.\n",MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  } else {
    write(BS("Da ist ja gar kein Wasser mehr in der Pfuetze."));
  }
  return 1;
}
  






