// Umgebung der Alchemistengilde
// Room a_9_4
// 
// 30.04.2005 Georg Schardt
// 05.01.2006 Typekorrektur

#pragma strong_types
inherit "std/room";
 
#include "../def.h"

void create()
{
  ::create();
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT,"Ein dunkler Trampelpfad");
  SetProp( P_INT_LONG,
	   "Du folgst einem Trampelpfad, der sich durch den dunklen Nadelwald "
	   "schlaengelt. Links und rechts des Weges ist dichtes, "
	   "undurchdringbares Dickicht. Ab und zu hast Du das Gefuehl, dass "
	   "sich dahinter etwas bewegt. Du meinst auch, leises Scharren "
	   "und Schnaufen zu hoeren. Du hast ein wenig Angst. Nach Westen "
	   "folgst Du dem Pfad, der im weiteren Verlauf etwas heller wird. "
	   "Im Suedosten gelangst Du auf die helle, freundliche Lichtung.");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_FOREST]) ); 
  AddDetail("dunkelheit","Siehe zu, dass Du eine Lichtquelle bekommst.");
  AddDetail("lichtquelle","Die brauchst Du bestimmt bald.");
  AddDetail("himmelsrichtung","Untersuchst Du immer alles ?");
  AddDetail(({"westen","suedosten"}),"Eine Himmelsrichtung.");
  AddDetail("boden",
	    "Du stehst auf einem lehmigen Trampelpfad. Der Boden ist mit "
	    "vielen Fussspuren uebersaeht. Der Weg scheint oft "
	    "genutzt zu werden.");
  AddDetail(({"weg","trampelpfad","pfad","weges"}),
	    "Ein kleiner, schmaler Pfad durch "
	    "das Dickicht. Hier scheint oft jemand vorbeizukommen.");
  AddDetail(({"spuren","fussspuren"}),"Es sind so viele, dass Du sie nicht "
	    "auseinander halten kannst. Sie haben diesen Trampelpfad hier "
	     "verfestigt.");
  AddDetail("verlauf","Der Pfad verlaeuft nach Westen und Suedosten.");
  AddDetail("gefuehl","Dein Gefuehl hat Dich noch nie getaeuscht.");
  AddDetail("himmel","Den siehst Du nicht. Die Baeume sind zu dicht.");
  AddDetail("bestie",
	    "Du siehst keine. Du hoerst nur ab und zu ein leises Scharren "
	    "und Schnaufen hinter dem Dickicht.");
  AddDetail(({"lichtung","luecke","wiese"}),
	    "Die Lichtung ist im Suedosten. Du erkennst gerade noch die "
	    "Wiese und den hellen Sonnenschein.");
  AddDetail(({"sonne","sonnenschein"}),"Die Sonne scheint hier nicht, Du "
	    "kannst nur den Sonnenschein auf der Lichtung im Suedosten "
	    "erkennen.");
  AddDetail(({"nadeln","nadel"}),"Die haengen an den Nadelbaeumen.");
  AddDetail("streifen","Die Streifen sind auf der Unterseite der Nadeln zu "
	    "erkennen.");
  AddDetail(({"ober","oberseite"}),"Die Oberseite ist nicht die Unterseite.");
  AddDetail("unterseite","Die Unterseite ist nicht die Oberseite.");
  AddDetail(({"nadelwald","wald","nadelbaeumen","nadelbaeume","stelle"}),
	    "Der Wald ist an dieser Stelle besonders dunkel. Sei froh, dass "
	    "Du eine Lichtquelle dabei hast. In dem schwachen Licht kannst "
	    "Du leider nicht erkennen, um welche Nadelbaeume es sich "
	    "handelt.");
  AddDetail("licht","Licht gibt es hier nicht viel.");
  AddDetail("baeume",
	    "Du kannst keine Einzelheiten erkennen.");
  AddDetail("einzelheiten","Die kannst Du wegen Deiner schwachen Lichtquelle "
	    "nicht erkennen.");
  AddDetail(({"dunkelheit","anblick"}),
	    "Der Wald ist richtig dunkel. Du kannst keinen Meter weit durch "
	    "das Dickicht sehen. Alles wirkt sehr bedrohlich.");
  AddDetail("meter","Etwa einen Zwerg hoch.");
  AddDetail("zwerg","Ein Zwerg misst etwa einen Meter.");
  AddDetail(({"dickicht","straeucher"}),
	    "Die Straeucher, die den Trampelpfad eingrenzen, sind sehr dicht "
	    "und bilden ein undurchdringbares Dickicht.");
  AddDetail("angst","Wie, Angst? Bist Du ein Mann oder eine Maus? Jetzt mach "
	    "Dir mal nicht gleich in die Hose.");
  AddDetail(({"scharren","schnaufen"}),"Jetzt hoerst Du nichts mehr.");
  AddDetail("hose","Na, schon voll?\n");
  AddDetail(({"mann","maus"}),"Bist Du mehr Mann oder mehr Maus?");
  AddDetail("tier","Von hier aus kannst Du kein Tier erkennen.");
  AddSound(DEFAULT_SOUND,
	   "Du hoerst ein leises Scharren und Schnaufen.");
  AddSound(({"scharren","schnaufen"}),
	   "Das kommt aus dem Wald. Was mag das nur sein?");
  AddSmell(DEFAULT_SMELL,
	  "Neben dem typischen Waldgeruch riechst du noch etwas... animalisches.\n");
  AddSmell(({"animalisches"}),
	   "Es riecht nach einem grossen, boesen Tier.\n");

  AddExit("westen",    ROOM "a_8_4.lpc");
  AddExit("suedosten", ROOM "a_10_3.lpc");

}








