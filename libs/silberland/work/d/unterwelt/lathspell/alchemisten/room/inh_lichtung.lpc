/*
  Umgebung der Alchemistengilde

  inh_lichtung.c

  27.08.2006 Lathspell 

*/

inherit "std/room";
#include "../def.h"

void create() 
{
  ::create();
  SetProp( P_INT_SHORT,"Eine kleine Lichtung");
  SetProp( P_INT_LONG,
	   "Bitte ueberlagern.");
  SetProp(P_INDOORS,0);
  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_FOREST]) );
  AddDetail("himmelsrichtung","Untersuchst Du immer alles?\n");
  AddDetail(({"osten","westen","suedosten"}),"Eine Himmelsrichtung.\n");
  AddDetail(({"blumenwiese","wiese"}),
	    "Die Lichtung ist eine einzige kleine Blumenwiese. Die Sonne "
	    "strahlt vom Himmel, und es wirkt alles sehr gemuetlich. Du "
	    "erkennst Gaensebluemchen, Loewenzahn und noch viele Dir "
	    "unbekannte Wildblumen.\n");
  AddDetail(({"wildblumen","blumen","blume"}),
	    "Ausser den Gaensebluemchen und dem Loewenzahn kennst Du keine "
	    "der hier bluehenden Blumen.\n");
  AddDetail("gaensebluemchen",
	    "Gaensebluemchen sind kleine Blumen mit weissen Bluetenblaettern, "
	    "gelben Bluetenstaenden und gruenen Blaettern.\n");
  AddDetail("loewenzahn",
	    "Der Loewenzahn hat eine gelbe Bluete und gruene Blaetter.\n");
  AddDetail(({"blaetter","bluetenblaetter","bluetenstand","bluete",
		  "bluetenblaettern","blaettern","bluetenstaenden","blueten"}),
	    "Das gehoert zu einer Blume nun einmal dazu.\n");
  AddDetail(({"grillen","grille"}),
	    "Die Grillen scheinen sich hier sehr wohlzufuehlen. Du "
	    "hoerst sie laut zirpen. Am liebsten wuerdest Du Dich "
	    "zu ihnen auf die Wiese legen und die Sonne geniessen.\n");
  AddDetail(({"bienen","biene"}),
	    "Die Bienen werden von der grossen Anzahl Wildblumen angezogen, "
	    "die hier wachsen. Sie finden hier wohl genug zu fressen.\n");
  AddDetail(({"anzahl","menge"}),
	    "Eine gewisse Menge nennt man Anzahl.\n");
  AddDetail("boden",
	     "Der Boden besteht hauptsaechlich aus Wiese mit einigen "
	    "Wildblumen.");
  AddDetail("kamin",
	    "Aus dem Kamin kommt ein wenig weisser Rauch.\n");
  AddDetail("gedanken",
	    "Ja, auch Du hast welche.\n");
  AddDetail("rauch",
	    "Er ist weiss und kommt aus dem Kamin auf der Huette.\n");
  AddDetail("gegensatz",
	    "Das ist eigentlich gar nicht wichtig.\n");
  AddDetail("himmel",
	    "Du schaust nach oben und erkennst zwischen den Berggipfeln "
	    "den Himmel. Die Sonne ist auch noch da. Beruhigt senkst Du "
	    "den Kopf wieder.\n");
  AddDetail("kopf",
	    "Der ist auch noch da.\n");
  AddDetail("sonne",
	    "Sie scheint warm und freundlich.\n");
  AddDetail("bestie",
	    "Natuerlich siehst Du hier keine. Die Wiese ist sehr friedlich. "
	    "Du bist allerdings der festen Ueberzeugung, dass "
	    "es hier eine Bestie geben muss.\n");
  AddDetail("ueberzeugung",
	    "Oder doch nur ein Gefuehl?\n");
  AddDetail("gefuehl",
	    "Dein Gefuehl hat Dich noch nie getaeuscht.\n");
  AddDetail(({"lichtung","luecke"}),
	    "Auf der stehst Du. Sie erstreckt sich nach Norden und Westen "
	    "und ist eigentlich mehr eine kleine Luecke im Wald "
	    "als eine grosse Lichtung. Der Waldrand ist ganz nah.\n");
  AddDetail(({"nadeln","nadel"}),
	    "Die haengen an den Nadelbaeumen.\n");
  AddDetail("streifen",
	    "Die Streifen sind auf der Unterseite der Nadeln zu erkennen.\n");
  AddDetail(({"ober","oberseite"}),
	    "Die Oberseite ist nicht die Unterseite.\n");
  AddDetail("unterseite",
	    "Die Unterseite ist nicht die Oberseite.\n");
  AddDetail(({"nadelwald","wald","nadelbaeumen","nadelbaeume","ganzes","nadelwaldes"}),
	    "Der Wald, der die Lichtung umgibt, ist im Gegensatz zu der "
	    "freundlichen hellen Wiese, auf der Du stehst, dunkel und wirkt "
	    "sehr bedrohlich. Er besteht ausschliesslich aus Nadelbaeumen. "
	    "Du kannst Fichten und Tannen erkennen. Hinter dem Wald erkennst "
	    "Du eine hohe Felswand. Der Waldrand ist mit "
	    "dichten Straeuchern zugewuchert, so dass ein Weiterkommen hier "
	    "nicht moeglich ist. Allerdings hast Du beim Anblick der "
	    "Dunkelheit ein ungutes Gefuehl.\n");
  AddDetail("weiterkommen","Der Wald ist dicht und die Felswand ist nah. "
	    "Versuchs erst gar nicht.");
  AddDetail(({"felswand","talkessel","felswaenden"}),
	    "Die gesamte Lichtung ist von hohen Felswaenden umgeben. Sie liegt "
	    "in einem kleinen abgeschlossenem Talkessel.");
  AddDetail(({"baeume","baum"}),
	    "Du kannst Fichten und Tannen erkennen. Einzeln sind sie ziemlich "
	    "langweilig. Interessant ist der Wald als Ganzes.\n");
  AddDetail(({"tannen","tanne"}),
	    "Tannen sind immergruene Nadelbaeume. Sie haben flache, leicht "
	    "biegsame Nadeln, die auf der Unterseite oft zwei helle "
	    "Streifen tragen.\n");
  AddDetail(({"fichten","fichte"}),
	    "Fichten sind immergruene Nadelbaeume. Sie haben 1 bis 2 "
	    "Zentimeter lange, deutlich viereckig geformte Nadeln, die auf "
	    "der Ober- und Unterseite deutlich dunkelgruen, teilweise "
	    "blaugruen gefaerbt sind.\n");
  AddDetail("zentimeter","10 Millimeter.");
  AddDetail("millimeter","1000 Micrometer.");
  AddDetail("micrometer","1000 Nanometer.");
  AddDetail("nanometer","1000 Picometer.");
  AddDetail("picometer","100 Picometer sind 1 Angstroem.");
  AddDetail("angstroem","Tja, frag Wikipedia :)");
  AddDetail("wikipedia","Guckst du hier: www.wikipedia.de");

  AddDetail(({"dunkelheit","anblick"}),
	    "Der Wald ist richtig dunkel. Du kannst keinen Meter weit durch "
	    "das Dickicht sehen. Alles wirkt sehr bedrohlich.\n");
  AddDetail("meter",
	    "Etwa einen Zwerg hoch.\n");
  AddDetail("zwerg",
	    "Ein Zwerg misst etwa einen Meter.\n");
  AddDetail(({"dickicht","straeucher","straeuchern"}),
	    "Die Straeucher am Waldrand sind sehr dicht und bilden ein "
	    "undurchdringbares Dickicht.\n");
  AddDetail("waldrand",
	    "Dort, wo die Baeume wieder anfangen, ist der Waldrand. Er ist "
	    "mit dichten Straeuchern gesaeumt.\n");
  AddDetail(({"gefuehl"}),
	    "Der Wald wirkt sehr bedrohlich. Angst kommt in Dir auf. War da "
	    "nicht gerade ein lautes Kratzen? Und da, waren da nicht "
	    "zwei gelbe blutunterlaufende Augen? Schnell drehst Du Dich um "
	    "und magst eigentlich nicht genau untersuchen, was da ist.\n");
  AddDetail("angst",
	    "Wie, Angst? Bist Du ein Mann oder eine Maus? Jetzt mach Dir mal "
	    "nicht gleich in die Hose.\n");
  AddDetail("kratzen","Jetzt hoerst Du nichts mehr.\n");
  AddDetail("hose","Na, schon voll?\n");
  AddDetail(({"mann","maus"}),"Bist Du mehr Mann oder mehr Maus?\n");
  AddDetail("augen",
	    "Ja wirklich, ab und zu leuchten zwei Augen auf. Sie sind gross "
	    "und weit aufgerissen. Sie beobachten Dich. Starre "
	    "bloss nicht in die Augen. Wer weiss, was das ist.\n");
  AddDetail(({"gipfel","berggipfel","berggipfeln"}),
	    "Die sind sehr weit oben.");
  AddDetail(({"gras"}),
	    "Das waechst zwischen den Blumen");
  AddDetail(({"lied","zirpen"}),
	    "Zirp, zirp, zirp, ziiiiiiiiiiiiiirp");
  AddDetail("duft","Na, riech doch mal.");
  AddSmell(DEFAULT_SMELL,
	  "Du riechst neben dem Waldgeruch auch den Duft von Blumen und "
	   "Gras.\n");
  AddSmell(({"wald","waldgeruch"}),
	   "Es riecht nach Harz, Kraeutern und Waldboden.\n");
  AddSmell(({"waldboden","harz","kraeuter","kraeutern"}),
	   "Es riecht eben nach Wald.\n");
  AddSmell(({"blumen"}),
	   "Du kannst die Blumen leider nicht durchs Riechen unterscheiden.");
  AddSound(DEFAULT_SOUND,
	   "Ausser hier und da ein paar summende Bienen, hoerst Du nichts.");
  AddSound(({"bienen","biene"}),
	   "Die fliegen hier rum und saugen an den Blueten.");
  AddSound(({"grillen","grille"}),
	   "Die Grillen zirpen ein lustiges Lied.");
  AddCmd("starr|starre&in&augen","cmd_starre","In was willst Du starren?");
}

int cmd_starre(string str) 
{
  write(BS("Gerade als Du in die Augen starren willst, verschwinden sie im "
	   "Dickicht.\n"));
  return 1;
}
