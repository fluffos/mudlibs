/*
  Umgebung der Alchemistengilde

  Room a_10_3

  30.04.2005 Georg Schardt
  05.01.2006 Typokorrektur
  26.08.2006 Umbau auf inherit

*/

#include "../def.h"
inherit ROOM "inh_lichtung";

void create()
{
  ::create();
  SetProp( P_INT_LONG,
	   "Du stehst auf einer kleinen Lichtung inmitten des dunklen "
	   "Nadelwaldes. Nach Sueden und Osten erstreckt sich eine "
	   "Blumenwiese mit vielen Dir bekannten und unbekannten "
	   "Wildblumen. Du hoerst Grillen zirpen und Bienen summen. "
	   "Nach Nordosten fuehrt ein kleiner Pfad von der Lichtung weg. "
	   "Wo der Dich nur hinfuehrt? Leider kannst Du nicht weit genug "
	   "den Pfad entlang sehen, er verlaeuft sich in der Dunkelheit "
	   "des Nadelwaldes.");
  AddDetail("pfad",
	    "Wo der nur hinfuehren mag?.");
  AddDetail("dunkelheit",
	    "Sieh zu, dass Du eine Lichtquelle bekommst.");
  AddDetail("lichtquelle",
	    "Die brauchst Du bestimmt bald.");
  AddExit("nordwesten", ROOM "a_9_4.lpc");
  AddExit("osten",      ROOM "a_11_3.lpc");
  AddExit("sueden",     ROOM "a_10_2.lpc");
}









