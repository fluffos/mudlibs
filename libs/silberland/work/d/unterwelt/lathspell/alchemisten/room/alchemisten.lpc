  write(BSA("Du hast es so gewollt, durch deinen Austritt verlierst Du alles "
  "Wissen ueber die Kunst der Alchemie. Du bist nun wieder Abenteurer.\n",
  "Trismegistos sagt: "));
  say(BSA(CAP(getuid(TP))+" hat gerade die Alchemistengilde verlassen.\n",
  "Trismegistos sagt: "));
  return b;

}

