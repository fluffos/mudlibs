inherit  "/std/room";
#include "../def.h"

#define TMPFILE LOG+"turmlist.tmp"

/* mapturm aufbau:
     key: uuid(TP)
     value1: startturm default 1
     value2: array turm 1;
     value3: array turm 2;
     value4: array turm 3;
     value5: count
*/
mapping mapturm;

//stuhlposition 0=unterm tisch, 2=davor, 1=links dovr, 3=rechts davor
int stuhlpos=0;
int aufhocker=0;
int *kraeuterpos;

string inschrift(string str);
string turmlist(string str);

void create() {
  ::create();

  //  SetProp(P_GUILD_DEFAULT_SPELLBOOK,"alchemisten");
  //  SetProp(P_GUILD_RESTRICTIONS, 
  //    ([P_LEVEL: 6,A_INT  : 0, P_QP   : 0, SR_BAD: -100, SR_GOOD: 100,
  //      SR_FUN : "Test1", SR_EXCLUDE_RACE: ({"Troll"})]) );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );
  AddItem(NPC "trismegistos.lpc",REFRESH_DESTRUCT);
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS,1);
  SetProp( P_INT_SHORT,
	   "Eine schummrige dunkle Huette");
  SetProp( P_INT_LONG,
	   "Nachdem Deine Augen sich an die Dunkelheit gewoehnt haben, "
	   "erkennst Du im flackernden Schein der Flammen Deine Umgebung. In "
	   "der Mitte der kreisrunden Huette erkennst Du eine grosse "
	   "Feuerstelle, auf der ein riesiger Kupferkessel steht. Das Feuer "
	   "macht es kuschelig warm hier. Ueber der Feuerstelle verschwindet "
	   "ein Rauchabzug im dunklen Dach. Mit Deinen Augen verfolgst Du den "
	   "Lauf der Aussenwand und stellst fest, dass auf der ganzen Laenge "
	   "Regale stehen. Erst jetzt bemerkst Du, dass kleine Fenster neben "
	   "der Tuer und den Tisch mit allerlei Geraetschaften, der unter dem "
	   "Fenster steht.");
  AddDetail(({"augen"}),
	    "Die hast Du im Kopf.\n");   
  AddDetail(({"dunkelheit","schein"}),
	    "Der Raum wird nur von der Feuerstelle in der Mitte beleuchtet. "
	    "Die Flammen erzeugen ein lustiges Schattenspiel an der Wand.\n");
  AddDetail(({"mitte","feuerstelle"}),
	    "In der Mitte der kreisrunden Huette erkennst Du eine grosse "
	    "Feuerstelle. Einem Kupferkessel wird dort maechtig eingeheizt.");
  AddDetail("kopf",
	    "Du untersuchst auch alles, oder ? Greif Dir mal an selbigen.");
  AddDetail(({"wand","aussenwand","waende"}),
	    "Die Aussenwand geht einmal komplett um die Huette rum. Da die "
	    "Huette rund ist, gibt es keinerlei Ecken. Fast die gesamte Wand "
	    "ist mit Regalen vollgestellt. Nur neben der Tuer ist ein kleines "
	    "Fenster mit einem Schreibtisch.");
  AddDetail("laenge",
	    "Die Wand ist wirklich lang, und voller Regale.");
  AddDetail("ecken",
	    "Ecken? Die gibts hier nicht. Die Huette ist rund.");
  AddDetail("ecke",
	    "Welche Ecke meinst Du denn genau?");
  AddDetail(({"boden","lehmboden"}),
	    "So wie Du die Sache einschaetzt, ist es ein einfacher "
	    "Lehmboden.");
  AddDetail(({"sache","lauf","schluck"}),
	    "Na, schon so verzweifelt, dass Du alles untersuchst?");
  AddDetail(({"schreibtisch","tisch"}),
	    "Der kleine Schreibtisch steht unter dem Fenster, damit man "
	    "wenigstens ein bischen Tageslicht zum Arbeiten bekommt. Ein "
	    "Hocker ist unter den Schreibtisch geschoben, und Du erkennst "
	    "einige Dir unbekannte Geraetschaften auf dem Tisch. Ein Zettel "
	    "mit Namen faellt dir auf. Vielleicht solltest Du Dir das mal "
	    "genauer ansehen.");
  AddDetail("tageslicht",
	    "Es dringt nur sehr wenig Tageslicht durch das kleine Fenster. "
	    "Gerade genug, um an dem Schreibtisch vernuenftig arbeiten zu "
	    "koennen.");
  AddDetail("dach",
	    "Du kannst das Dach vor lauter Kraeuter, Blaetter und Zweige, die "
	    "von der Decke zum Trocknen haengen, gar nicht erkennen. "
	    "Viel interessanter waere aber, wie Du jetzt an die Kraeuter "
	    "kommst.");
  AddDetail("decke",
	    "Du schaust nach oben und Dein Blick verfaengt sich in den "
	    "Unmengen an Kraeutern, Blaetter und Zweigen, die von dort oben "
	    "herunter haengen. Wie Du da wohl dran kommst?");
  AddDetail("blick",
	    "Eisern, wie ein geiler Schaeferhund.");
  AddDetail("unmengen",
	    "Wirklich, also wirklich viele!");
  AddDetail(({"schaeferhund","hund"}),
	    "Ja, genau so schaust Du gerade aus. Wie ein geiler "
	    "Schaeferhund.");
  AddDetail(({"blaetter","kraeuter","zweige"}),
	    "Wenn man nur naeher ran kommen koennte. Sie sind einfach zu "
	    "hoch, um von hier aus was zu erkennen.");
  AddDetail(({"raum","umgebung","huette"}),QueryProp(P_INT_LONG));
	   
  AddDetail(({"schattenspiel","schatten"}),
	    "Du starrst vertraeumt auf die Schatten, die die Flammen im Raum "
	    "erzeugen. Fasziniert verfolgst Du jedes Flackern der Flammen "
	    "auf der Wand. Du glaubst es koennte Dir nie langweilig werden.");
  AddDetail("flammen",
	    "Zu jedem Feuer gehoeren Flammen. Diese hier sind besonders toll "
	    "und schlagen weit an dem Kupferkessel empor.");
  AddDetail("feuer",
	    "Das Feuer brennt wunderbar. Es scheint, als waere es gerade erst "
	    "entzuendet worden, Du glaubst aber, dass es magisch ist und wohl "
	    "immer so aussieht.");
  AddDetail("fenster",
	    "Das Fenster befindet sich direkt neben der Tuer. Es sorgt fuer "
	    "das einzige Tageslicht hier im Raum.");
  AddDetail("sitzflaeche",
	    "Da sind Fusspuren auf der Sitzflaeche. Igitt, welches Ferkel "
	    "hat sich da wieder nicht die Schuhe ausgezogen, als er auf dem "
	    "Hocker stand.");
  AddDetail(({"rauchabzug","abzug"}),
	    "Der Rauchabzug sorgt dafuer, dass man hier drin nicht erstickt. "
	    "Er ist schwarz und gehoert einfach hier her.");
  AddDetail("schuhe",
	    "Die zieht man aus, eh man auf Hocker steigt.");
  AddDetail(({"fussabdruecke","abdruecke"}),
	    "Da sind ganz klar Fussabdruecke auf der Sitzflaeche.");
  AddDetail("ferkel",
	    "Grunz, grunz. Bist Du eins?");
  AddDetail("tuer",
	    "Da gehts wohl wieder raus.");
  AddDetail(({"regale","regal"}),
	    "Das Regal geht einmal komplett an der Aussenwand entlang. Du "
	    "siehst Buecher, Buecher und nochmals Buecher, "
	    "aber auch Flaschen und Dosen mit unbekanntem Inhalt.");
  AddDetail("buecher",
	    "Die meisten Titel sagen Dir nichts. Uninteressiert wendest Du "
	    "Dich ab.");
  AddDetail("titel",
	    "Du kennst keinen einzigen.\n");
  AddDetail(({"flaschen","flasche"}),
	    "Alle Flaschen sind verschlossen und unbeschriftet. Du laesst "
	    "lieber die Finger davon.\n");
  AddDetail("finger",
	    "Die sind hoffentlich noch alle da, wo sie hingehoeren.");
  AddDetail("inhalt",
	    "Der ist Dir unbekannt, und es steht auch nichts auf den "
	    "Flaschen.");
  AddDetail("dosen",
	    "Leer, sie scheinen wohl nicht mehr gebraucht zu werden.\n");
  AddDetail(({"kupferkessel","kessel"}),
	    "Der grosse Kupferkessel steht mitten in der Huette auf dem "
	    "Feuer. Du kannst so gerade ueber den Rand schauen, ohne Dich zu "
	    "verbrennen, und siehst wie ein Trank vor sich hin koechelt. Da "
	    "Du aber nicht weisst, was er bewirkt, laesst Du ihn wie er ist.");
  AddDetail("rand",
	    "Der Rand ist heiss, pass auf.");
  AddDetail(({"trank","suppe"}),
	    "Da frag mal Trismegistos nach.");
  AddDetail("geraetschaften",
	    "Auf dem Tisch stehen einige Dir unbekannte Geraetschaften rum. "
	    "Zur Zeit langweilen sie Dich nur, doch was ist das? Du siehst "
	    "auf einmal drei kleine Tuerme die auf einem Sockel stehen.");
  AddDetail("zeit",
	    "Tick... tack... tick... tack... Hoerst Du, wie die Zeit "
	    "verrinnt?");
  AddDetail("heureka",
	    "Trismegistos hat wohl etwas entdeckt.");
  AddDetail("trismegistos",
	    "Er ist wohl gerade nicht da.");
  AddDetail("sockel",
	    "Die Tuerme stehen auf einem hoelzernen Sockel. Du siehst eine "
	    "Inschrift eingraviert.\n");
  AddDetail("inschrift",
	    "Du kannst sie lesen!\n");
  AddDetail(({"zettel","turmliste"}),
	    "Es steht Turmliste auf dem Zettel. Du kannst ihn mit <lies turmliste> "
	    "lesen.");
  AddReadDetail( ( {"inschrift"} ), #'inschrift);
  AddReadDetail( ( {"turmliste"} ), #'turmlist);
  AddSpecialDetail(({"tuerme","turm"}),"tuerme");
  AddSpecialDetail(({"hocker"}),"hocker");

  AddCmd(({"stapel"}),"tryNextStep");
  AddCmd(({"lies","lese"}),"lies");
  AddCmd("ziehe|zieh&hocker&hervor","cmd_ziehe","Was willst Du hervorziehen");
  AddCmd("schieb|schiebe&hocker&nach&links","cmd_links","Wohin willst Du den Hocker schieben?");
  AddCmd("schieb|schiebe&hocker&nach&rechts","cmd_rechts","Wohin willst Du den Hocker schieben?");
  AddCmd("schieb|schiebe&hocker&zurueck","cmd_schieb","Wohin willst Du den Hocker schieben?");
  AddCmd("durchsuche|durchsuch&kraeuter","cmd_kraeuter","Was willst Du durchsuchen?");
  AddCmd("steige|steig|stell|stelle&auf&hocker","cmd_stelle","Auf was willst Du dich stellen?");
  AddCmd("spring|springe&vom|von&hocker","cmd_spring","Wo willst du runter springen?");
  AddExit("nordwesten", ([EX_DEST: ROOM "a_12_2",
			  EX_TESTFUNC:"hockertest"]));

