#include "../def.h"
inherit ROOM "inh_gang";

//Hier ausgang sichtbar

void create()
{
  ::create();
  SetProp( P_INT_LONG,
	   "Du befindest Dich in einem kleinen Gang im Vulkangestein. "
	   "Eigentlich ist es mehr eine enge Roehre die sehr steil nach "
	   "oben fuehrt. Bestimmt ist hier frueher einmal das Lava "
	   "geflossen, denn die Decke und Waende sind aus glattem Stein. "
	   "Von der seltsamen Pflanze siehst du nur noch eine Ranke, die "
	   "sich an der Wand entlangzieht und Licht spendet. Der Boden "
	   "ist uneben und mit Steinen bedeckt. Im Nordosten weitet sich "
	   "der Gang und es scheint wieder ans Tageslicht zu gehen. "
	   );
  AddDetail( ({"tageslicht","lichtschein","licht"}),
	     "Tatsaechlich, weiter durch erkennst du einen "
	     "Lichtschein. Dort scheint es nach draussen zu gehen.");
  AddExit("suedwesten", ROOM "d_7_2.lpc");
  AddExit("nordosten",  ROOM "a_9_1.lpc");
}

void reset() 
{
  if(QueryProp(P_LIGHT)<=0)
    LICHTMASTER->licht_an(4);
}

int cmd_hacke()
{
  if (ENV(TP)->QueryProp(P_LIGHT)<1) {
    tell_object(TP,BS("Die Ranke ist doch schon zerrissen."));
  }
  LICHTMASTER->licht_aus(4);
  return 1;
}




