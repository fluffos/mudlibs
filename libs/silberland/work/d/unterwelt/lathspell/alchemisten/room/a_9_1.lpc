/*
  Umgebung der Alchemistengilde

  Room a_9_1

  20.01.2006 Lathspell 
  26.08.2006 Änderung auf Region Unterwelt
             Umbau auf inh_gang.c

*/

#include "../def.h"
inherit "std/room";


void create()
{
  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0);
  SetProp( P_INT_SHORT,"Am Waldrand");
  SetProp( P_INT_LONG,
	   "Du stehst in einer Felsspalte und blickst auf eine kleine "
	   "Lichtung. Die Sonne blendet Dich, hatten sich deine Augen "
	   "doch an das gruenliche Licht in der Roehre im Suedwesten "
	   "gewoehnt. Die Lichtung wird von einem dunklen Nadelwald "
	   "umgeben, der von hohen Felswaenden begrenzt wird. "
	   );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_FOREST]) );
  AddExit("suedwesten",ROOM "d_8_1.lpc");
  AddExit("nordosten", ROOM "a_10_2.lpc");

  AddDetail("eindruck","Na, hoffen wir das der erste Eindruck nicht "
	    "taeuscht.");
  AddDetail("ruecken",
	    "Ruecken ist hinten.");
  AddDetail(({"wiese","lichtung","teil"}),
	    "Die Wiese scheint Teil einer kleinen Lichtung zu sein. Geh doch "
	    "einfach mal naeher ran.");
  AddDetail("rand",
	    "Der Wald geht hier in eine Wiese ueber.");
  AddDetail(({"pfad","trampelpfad","trampelpfades","pfades"}),
	    "Der Verlauf des Pfades ist nur schwer zu erkennen.");
  AddDetail(({"wald","nadelwald","waldes"}),
	    "Du kannst Tannen und Fichten erkennen. Der Wald ist sehr dunkel "
	    "und dort kommt keinerlei Sonne durch, wie auf der Lichtung.");
  AddDetail(({"baeume","tannen","fichten"}),
	    "Hier wachsen hauptsaechlich Fichten und Tannen. ");
  AddDetail(({"unregelmaessigkeit"}),
	    "Im Wald wechseln sich die verschiedenen Pflanzen zufaellig ab.");
  AddDetail(({"boden","waldboden"}),
	    "Du stehst auf einem typischen Waldboden. Schwach erkennst Du "
	    "den Verlauf eines kleinen Trampelpfades.");
  AddDetail(({"verlauf"}),
	    "Der Pfad fuehrt nach Norden weiter in den Wald hinein und nach "
	    "Sueden auf den Weg zurueck.");
  AddDetail(({"felswand","talkessel","felswaenden","felswaende"}),
	    "Die gesamte Lichtung ist von hohen Felswaenden umgeben. Sie liegt "
	    "in einem kleinen abgeschlossenen Talkessel.");
  AddDetail(({"himmel"}),
	    "Vor lauter Blaettern kann man den Himmel kaum "
	    "erkennen.");
  AddDetail(({"nadeln","blaetter"}),
	    "Die sind zu weit oben, um sie untersuchen zu koennen.");
  AddDetail(({"weg"}),
	    "Der liegt im Sueden und ist etwas groesser als der Trampelpfad "
	    "auf dem Du stehst.");
  AddDetail("augen","So langsam gewoehnen sich deine Augen an das Sonnenlicht.");
  AddDetail(({"sonne","sonnenlicht","licht"}),
	    "Die Sonne scheint hell vom Himmel und es wird etwas waermer.");	    
  AddDetail("roehre",
	    "Die Roehre befindet sich in der hintersten Ecke der Felsspalte. "
	    "Sie geht steil nach unten und Du kannst nur wenig erkennen.");
  AddDetail("ecke","Ganz hinten durch halt.");
  AddDetail("felsspalte",
	    "Die Felsspalte verbindet die Roehre mit der hellen Lichtung. Sie "
	    "ist nicht sehr gross und auch nicht sehr gemuetlich.");
  AddDetail("geraeuschen","Lausch doch einfach mal");
  //// Sound n Smell
  AddSmell(DEFAULT_SMELL,
	  "Du riechst den typischen, wuerzigen Waldgeruch.");
  AddSmell(({"wald","waldgeruch"}),
	   "Es riecht nach Harz und Waldboden.");
  AddSmell(({"waldboden","harz"}),
	   "Es riecht eben nach Wald.");
  AddSound(DEFAULT_SOUND,
	   "Du lauschst den Geraeuschen eines Waldes und kannst nichts "
	   "ungewoehnliches hoeren.");
  
  
}





