/*
  Umgebung der Alchemistengilde

  Room a_11_3

  30.04.2005 Georg Schardt
  05.01.2006 Typokorrektur
  26.08.2006 Umbau auf inherit

*/

#include "../def.h"
inherit ROOM "inh_lichtung";

int warda=0;

void reset() 
{
  ::reset();
  warda=0;
}

void create()
{
  ::create();
  SetProp( P_INT_LONG,
	   "Du stehst auf der kleinen Lichtung inmitten des dunklen "
	   "Nadelwaldes. Nach Sueden, Westen und Osten erstreckt "
	   "sich eine Blumenwiese mit vielen Dir bekannten und unbekannten "
	   "Wildblumen. Du hoerst Grillen zirpen und Bienen summen. "
	   "Wuerde der dunkle Waldrand nicht so bedrohlich aussehen, "
	   "wuerdest Du Dich hier richtig wohl fuehlen. Gerade hier, so "
	   "scheint es Dir, ist die Gefahr am groessten, einer Bestie zu "
	   "begegnen. Im Suedosten siehst Du eine kleine runde Huette, aus "
	   "deren Kamin weisser Rauch weht. Geh doch mal naeher ran.");
  AddDetail("huette",
	    "Die Huette steht im Suedosten. Sie hat eine runde Form, "
	    "mehr erkennst Du von hier aus nicht. Aus dem Kamin steigt Rauch "
	    "auf. Es sieht so aus, als waere die Huette bewohnt.");
  AddDetail("form",
	    "Rund trifft es schon am besten.");
  AddDetail("gefahr","Ha ha ha, ich lach dir ins Gesicht, Gefahr.");
  AddDetail("gesicht","Auf deinem Gesicht steht die Angst geschrieben.");
  AddDetail("angst","Du fuerchtest dich wohl.");
  AddExit("westen", ROOM "a_10_3.lpc");
  AddExit("osten",  ROOM "a_12_3.lpc");
  AddExit("sueden", ROOM "a_11_2.lpc");
}

int cmd_starre(string str) 
{
  object monster;
  if (warda!=1)
    {
      if (!present("nadelmonster")) {
	write(BS("Du hoerst ein lautes Rascheln im Dickicht und die "
		 "Straeucher fangen an, sich wild zu bewegen.\n"));     
	if(monster=clone_object(NPC "nadelmonster.lpc")) {
	monster->move(TO,M_NOCHECK);
	warda=1;
	}
      }
    } else write(BS("Gerade als Du in die Augen starren willst, verschwinden "
		    "sie im Dickicht.\n"));
  return 1;

}







