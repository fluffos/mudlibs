// Umgebung der Alchemistengilde
// Room a_7_5
// 
// 30.4.2005 Georg Schardt


inherit "std/room";
#include "../def.h"

#define LANGMIT "Der Pfad endet vor einer Felswand. Eine kleine Quelle \
sprudelt aus einem Loch heraus und laeuft in ein kleines \
gemauertes Becken. Daneben steht ein kleines Holzgestell, \
welches zum Trocknen von Geschirr genutzt wird. Da hier \
gerade mal keine Baeume stehen, scheint die Sonne warm vom \
Himmel. Waere der Platz durch das dichte Dickicht und die \
Felswand nicht so beengt, koennte man hier ein tolles \
Sonnenbad nehmen. Durch den umgefallenen Baum wird man auch \
nicht so schnell beobachtet."
#define LANGOHNE "Der Pfad endet vor einer Felswand. Eine kleine Quelle \
sprudelt aus einem Loch heraus und laeuft in ein kleines \
gemauertes Becken. Daneben steht ein kleines Holzgestell, \
welches zum Trocknen von Geschirr genutzt wird. Da hier \
gerade mal keine Baeume stehen, scheint die Sonne warm \
vom Himmel. Waere der Platz durch das dichte Dickicht und \
die Felswand nicht so beengt, koennte man hier ein tolles \
Sonnenbad nehmen."

object parent;
int phiolencount;
int *spieler;

void create()
{
  ::create();
  spieler=({});
  if (!find_object(ROOM "a_8_4"))
    call_other(ROOM "a_8_4","???");
  parent=find_object(ROOM "a_8_4");
  SetProp( P_LIGHT, 1);
  SetProp( P_INT_SHORT,"Am Stein der Weisen");
  SetProp(P_INDOORS,0);
  if (objectp(parent) && parent->GetBaumweg()==1) {
    SetProp( P_INT_LONG,LANGOHNE);
  } else {
    SetProp( P_INT_LONG, LANGMIT);
  }
  RemoveExit("nordwesten");
  Message(BS("Ein starker Windstoss laesst einen Baum umkippen und der Weg "
	     "nach Nordwesten ist versperrt."),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  AddDetail("himmelsrichtung","Untersuchst Du immer alles ?");
  AddDetail("boden",
	    "Du stehst auf einem lehmigen Trampelpfad, der hier allerdings an "
	    "einer Felswand endet. Der Boden ist wegen des Wassers "
	    "stellenweise etwas matschig.");
  AddDetail(({"weg","trampelpfad","pfad"}),"Der Trampelpfad ist hier zu Ende, "
	    "Du stehst vor einer Felswand.");

  AddDetail(({"spuren","fussspuren"}),"Es sind so viele, dass Du sie nicht "
	    "auseinander halten kannst. Sie haben diesen Trampelpfad hier "
	     "verfestigt.");
  AddDetail("himmel","Da hier gerade keine Baeume stehen, kannst Du den "
	    "Himmel ueber Dir gut erkennen.");
  AddDetail(({"nadelwald","wald","nadelbaeumen","nadelbaeume","stelle"}),
	    "Der ist immer noch da, allerdings sind hier gerade keine Baeume. "
	    "Du stehst vor einer hohen Felswand, links und rechts "
	    "wachsen dichte Straeucher.");
  AddDetail("laenge","Die einen mehr, die anderen weniger.");
  AddDetail(({"becken","felsbecken"}),
	    "Das Becken wurde unter dem Loch in der Felswand aus verschieden "
	    "grossen Felsbrocken gemauert. Das Wasser aus der Quelle "
	    "sammelt sich dort und fliesst dann ueber einen kleinen Ueberlauf "
	    "ins Dickicht.");
  AddDetail(({"felsbrocken","brocken","steine","stein"}),
	    "Der Erbauer des Beckens hat sich wenig Muehe bei der Auswahl der "
	    "Steine gemacht. Er hat wohl genommen, was rumlag.");
  AddDetail("erbauer","Schau Dich nur um, vielleicht findest Du ihn hier in "
	    "der Naehe.");
  AddDetail("naehe","Na, hier auf keinen Fall.");
  AddDetail(({"fall","seite","rinde","stopfen","zeit"}),"Das ist doch "
	    "uninteressant.");
  AddDetail("blick","Da guckst Du.");
  AddDetail(({"loch","quelle"}),"Da ist ein Loch in der Felswand, aus dem "
	    "Wasser sprudelt. So etwas wird auch als Quelle bezeichnet.");
  AddDetail(({"muehe","auswahl"}),"Alles in allem ist das Becken sehr "
	    "stuemperhaft verarbeitet.");
  AddDetail("ueberlauf",
	    "Auf der linken Seite des Beckens fehlt ein Stein in der obersten "
	    "Reihe, dort kann das Wasser ins Dickicht abfliessen.");
  AddDetail("reihe","Eins nach dem anderen halt. In diesem speziellen Fall "
	    "Steine, die ganz oben liegen.");
  AddDetail("wasser",
	    "Das Wasser sprudelt aus einem faustgrossen Loch in der Wand. Es "
	    "ist ziemlich kalt und kristallklar. Es wird in dem "
	    "Felsbecken gestaut und fliesst dann ueber einen Ueberlauf ins "
	    "Dickicht.");
  AddDetail(({"dickicht","straeucher"}),
	    "Die Straeucher, die den Trampelpfad eingrenzen, sind sehr dicht "
	    "und bilden ein undurchdringbares Dickicht.");
  AddDetail(({"felswand","wand","fels","ende"}),
	    "Die Felswand steigt senkrecht nach oben auf. Nach links und "
	    "rechts wird Dein Blick durch die Straeucher begrenzt. "
	    "Hier kommst Du auf keinen Fall weiter.");
  AddDetail(({"gestell","holzgestell","rahmen","querlatten","latten",
		  "stangen","holzstangen"}),
	    "Das Holzgestell besteht aus einem Rahmen und zwei Querlatten, "
	    "auf denen senkrecht Holzstangen montiert sind. Wenn "
	    "man jetzt gespuelte Phiolen umgekehrt ueber die Holzstangen "
	    "steckt, koennen diese wunderbar in der Sonne hier trocken.");
  AddDetail("sonne",
	    "Die Sonne scheint ziemlich hell vom Himmel herunter. "
	    "Hier ist es richtig schoen.");
  AddDetail("sonnenbad","Ja, wenn Du nur die Zeit dazu haettest, und es hier "
	    "nicht so beengt waere...");
  AddDetail("kork","Kork macht man aus der Rinde von speziellen Baeumen.");
  AddDetail(({"flaeschchen","glasflaeschchen"}),"Kleine Glasflaeschchen "
	    "nennt man auch Phiolen.");
  AddSpecialDetail(({"phiolen","phiole"}),"phiole");
  AddSpecialDetail("platz","platz");
  AddSpecialDetail(({"geschirr"}),"geschirr");
  AddSpecialDetail(({"tanne","baum","baumstamm","stamm"}),"stamm");
  AddSpecialDetail("baeume","baeume");
  AddSpecialDetail("schleifspuren","schleifspuren");
  AddSpecialDetail("kratzer","kratzer");
  AddSpecialDetail(({"stammoberseite","oberseite"}),"oberseite");
  AddCmd("schieb|schiebe&baum|stamm|baumstamm&beiseite|zur&seite",
	 "cmd_schiebe",
	 "Was willst Du schieben?|Wohin willst Du den Baumstamm schieben?");
  AddCmd("kriech|krieche&unter&stamm|baumstamm|baum","cmd_krieche",
	 "Wie willst Du kriechen?|Unter was willst Du kriechen?");
  AddCmd("kletter|klettere&ueber&stamm|baum|baumstamm","cmd_kletter",
	 "Wie willst Du klettern?|Ueber was willst Du klettern?");
  AddCmd("nimm|nehme&phiole|flaeschchen|flasche","cmd_nimm",
	 "Was willst Du nehmen?");
  if (objectp(parent) && parent->GetBaumweg()==1)
    AddExit("suedosten", ROOM "a_8_4.lpc");
  phiolencount=0;
}

void reset() 
{
  ::reset();
  spieler=({});
  if (!find_object(ROOM "a_8_4."))
    call_other(ROOM "a_8_4","???");
  parent=find_object(ROOM "a_8_4");
  if (objectp(parent) && parent->GetBaumweg()==1) {
    SetProp( P_INT_LONG,LANGOHNE);
    AddExit("suedosten",ROOM "a_8_4.lpc");
  } else {
    SetProp( P_INT_LONG, LANGMIT);
    RemoveExit("suedosten");
  }
  phiolencount=0;
}

int cmd_nimm(string str)
{
  object ob;

  if (phiolencount>2) {
    write(BS("Gerade im Moment ist das Holzgestell leer. Versuch Dein Glueck "
	     "spaeter noch mal.\n"));
    Message(BS(this_player()->name()+" sucht etwas, scheint es aber nicht zu "
	       "finden."),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return -1;
  }
  phiolencount++;
  write(BS("Du drehst Dich kurz um und schaust, ob niemand kommt, dann "
	   "stibitzt Du eine Phiole vom Holzgestell.\n"));
  Message(BS(this_player()->name()+" stibitzt eine Phiole.\n"),
	  MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  ob = clone_object(OBJ "phiole.lpc");
  if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT)){
    write(BS("Die Phiole ist Dir jetzt wirklich zu schwer."));
    ob->move(this_object(), M_PUT);
  }
  return 1;
}

int cmd_schiebe(string str)
{
  if (objectp(parent) && parent->GetBaumweg()==1) {
    write(BS("Was fuer einen Baum meinst Du bitte ?\n"));
    return -1;
  }
  if (member(spieler,getuuid(TP))!=-1) {
    tell_object(TP,BS("Du bist zu beschaeftigt!"));
    return -1;
  }
  if(TP->QueryProp(P_GHOST)) {
    write(BS("Als Geist wuerde Dir das ausgesprochen schwer fallen."));
    return -1;
  }
  if (TP->QueryAttribute(A_STR) <= 35) {
    write(BS("Du versuchst den Baumstamm aus dem Weg zu schieben. "
	     +"Nach einiger Zeit gibst Du allerdings erschoepft auf.\n"));
    return -1;
  }
  spieler+=({ getuuid(TP) });
  call_out("schieben",0,TP,1);
  return 1;
}

void schieben(object player, int count)
{
  if(!player)                return; // object richtig uebergeben?
  if(!interactive(player))   return; // Spieler noch interaktiv? 
  if(ENV(player)!=TO)            return; // Ist der Spieler noch im Raum?

  switch(count) 
    {
    case 1:
      tell_object(player,"Du packst den Baum mit beiden Haenden.\n");
      Message(BS(player->Name(WER)+" packt sich den Baum mit beiden Haenden."),
	      MSGFLAG_VISUAL|MSGFLAG_NO_TP);      
      break;
    case 2:
      tell_object(player,"Du drueckst mit Deinem ganzen Gewicht gegen den Stamm.\n");
      Message(BS(player->Name(WER)+" stemmt sich gegen den Stamm."),
	      MSGFLAG_VISUAL|MSGFLAG_NO_TP);      
      break;
    case 3:
      tell_object(player,"Mit aller Kraft schiebst Du den Baum ins Dickicht.\n");
      Message(BS(player->Name(WER)+" schiebt den Baum ins Dickicht."),
	      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      break;
    default:
      if (objectp(parent))
	  parent->SetBaumweg(1);
      tell_object(player,"Du schiebst den Baum beiseite und legst einen Ausgang "
		  "im Nordwesten frei.\n");
      AddExit("nordwesten",ROOM "a_8_4.lpc");
      SetProp( P_INT_LONG,
	       "Hier wird der Pfad etwas heller. Ein starker Windstoss hat "
	       "einen Baum umgeworfen, dieser scheint allerdings "
	       "weggeschoben worden zu sein. Du kannst nach Nordwesten "
	       "weitergehen.\n");
      spieler-=({ getuuid(TP) }); //Spieler wieder austragen
      return; //Sequenz zu Ende
      break;
    }
  call_out("schieben", 3+random(3), TP, ++count);
  return;
}

int cmd_krieche(string str)
{
  if (objectp(parent) && parent->GetBaumweg()==1) {
    write(BS("Der Baum ist doch zur Seite geschoben.\n"));
    return -1;
  }
  if (member(spieler,getuuid(TP))!=-1) {
    tell_object(TP,BS("Du bist zu beschaeftigt!"));
    return -1;
  }
  if (TP->QueryProp(P_RACE)=="Oger") {
    write(BS("Du versuchst Dich, unter dem Baumstamm durchzuzwaengen, bleibst "
	     "aber stecken."));
    return 1;
  }
  if (TP->QueryProp(P_SIZE)>150) {
    write(BS("Du versuchst, unter den Stamm zu kriechen, verrenkst Dir beim "
	     "Buecken aber so schlimm den Ruecken, "
	     "dass Du es lieber sein laesst.\n"));
    return 1;
  }
  spieler+=({ getuuid(TP) });
  call_out("kriechen",0,TP,1);
  return 1;
}

void kriechen(object player, int count)
{
  if(!player)                return; // object richtig uebergeben?
  if(!interactive(player))   return; // Spieler noch interaktiv? (d.h. kein disco)
  if(ENV(player)!=TO)            return; // Ist der Spieler noch im Raum?
  
  switch(count) 
    {
    case 1:
      tell_object(player,BS("Du bueckst Dich runter und faengst an, unter den Stamm "
			    "zu kriechen."));
      Message(BS(player->Name(WER)+" faengt an, unter den Stamm zu kriechen."),
	      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      break;
    case 2:
      tell_object(player,BS("Es wird immer enger, Du haettest nicht gedacht, dass "
			    "Du so dick bist."));
      Message(BS(player->Name(WER)+" verschwindet unter dem Stamm."),
	      MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      break;
    case 3:
      tell_object(player,BS("Fast glaubst Du stecken zu bleiben, aber da geht es "
			    "auf einmal besser weiter."));
      break;
    default:
      tell_object(player,BS("Du stehst auf der anderen Seite des Baumes."));
      spieler-=({ getuuid(TP) }); //Spieler wieder austragen
      TP->move(ROOM "a_8_4.lpc",M_NOCHECK|M_SILENT);      
      return; //Sequenz zu Ende
      break;
    }
  call_out("kriechen",3+random(3),TP,++count);
  return;
}

int cmd_kletter(string str)
{
  if (objectp(parent) && parent->GetBaumweg()==1) {
    write(BS("Der Baum ist doch zur Seite geschoben.\n"));
    return 1;
  }
  if (member(spieler,getuuid(TP))!=-1) {
    tell_object(TP,BS("Du bist zu beschaeftigt!"));
    return -1;
  }
  if (TP->QueryProp(P_RACE)=="Oger") {
    write(BS("So sehr Du auch springst und kletterst, Du schaffst es nicht, "
	     "ein Bein soweit zu heben, um es ueber den Stamm zu bekommen."));
    return 1;
  }
  if (TP->QueryProp(P_SIZE)<=150) {
    write("Du bist viel zu klein, um auch nur eine Hand oben auf den Stamm "
	  "zu legen.\n");
    return 1;
  }
  spieler+=({ getuuid(TP) });
  call_out("klettern",0,TP,1);
  return 1;
}

void klettern(object player, int count)
{
  if (!player) return;
  if (!interactive(player)) return;
  if (ENV(player)!=TO) return;

  switch(count)
    {
    case 1:
      tell_object(player,"Du gehst ein paar Schritte zurueck und nimmst "
		  "Anlauf.\n");
      Message(BS(player->Name(WER)+" geht ein paar Schritte vom Baum weg und "
		 "scheint Anlauf zu nehmen."),MSGFLAG_VISUAL|MSGFLAG_NO_TP);  
      break;
    case 2:
      tell_object(player,BS("Du laeufst auf den Baum zu, hoffentlich schaffst Du "
			    "das..."));
      Message(BS(player->Name(WER)+" laeuft auf den Stamm zu."),
	      MSGFLAG_VISUAL|MSGFLAG_NO_TP);      
      break;
    case 3:
      tell_object(player,BS("Du legst eine Hand auf den Stamm und schwingst Deine "
			    "Beine gekonnt ueber den Baum."));
      Message(BS(player->Name(WER)+" springt elegant ueber den Baum und ist "
		 "verschwunden."),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
      break;
    default:
      tell_object(player,"Du stehst auf der anderen Seite des Baumes.");
      spieler-=({ getuuid(TP) });
      TP->move(ROOM "a_8_4.lpc",M_NOCHECK|M_SILENT);      
      return; //Sequenz zu Ende
      break;
    }
  call_out("klettern",3+random(3),TP,++count);
  return;
}

string oberseite(string str)
{
  if (objectp(parent) && parent->GetBaumweg()==1)
    return(BS("Der Baum wurde wohl zur Seite geschoben."));
  return (BS("Die zeigt nach oben."));
}

string kratzer(string str) 
{
  int size;
  string race;

  if (objectp(parent) && parent->GetBaumweg()==1)
    return(BS("Der Baum wurde wohl zur Seite geschoben.\n"));
  size=TP->QueryProp(P_SIZE);
  race=TP->QueryProp(P_RACE);
  if ((race=="Oger")||(race=="Troll"))
    return BS("Dich interessieren diese Kratzer gar nicht. Am liebsten "
	      "wuerdest Du diesen dummen Baum einfach zur Seite schieben.");
  if (size<=150)
    return BS(sprintf("Die Kratzer befinden sich an der Stammoberseite, die "
		      "Du mit Deinen %d cm allerdings nicht sehen kannst.",
		      size));
  return BS("Die Kratzer sehen so aus, als ob hier jemand ueber den Stamm "
	    "geklettert ist.");
}


string schleifspuren(string str)
{
  int size;
  string race;

  if (objectp(parent) && parent->GetBaumweg()==1)
    return(BS("Der Baum wurde wohl zur Seite geschoben."));
  size=TP->QueryProp(P_SIZE);
  race=TP->QueryProp(P_RACE);
  if ((race=="Oger")||(race=="Troll")) {
    if (TP->QueryProp(P_GENDER)!=FEMALE)
      return BS("Warum immer alles untersuchen. Bist doch en starkes "
		"Kerlchen.");
    else
      return BS("Warum immer alles untersuchen. Bist doch ne starke "
		"Dame.");
  }
  if (size>150)
    return BS(sprintf("Die Schleifspuren sind unten auf dem Boden und "
		      "mit Deiner Laenge kannst Du sie gar nicht so genau" 
		      "erkennen.",size));
  return BS("Es sieht so aus, als koennte man unter dem Baum "
	    "durchkriechen.");
}

string baeume(string str) 
{
  if (objectp(parent) && parent->GetBaumweg()==0)
    return BS("Hier stehen gerade keine, daher scheint hier auch die Sonne "
	      "so toll herein. "
	      "Nur ein Baum liegt quer ueber dem Pfad.");
  return BS("Hier stehen gerade keine, daher scheint hier auch die Sonne so "
	    "toll herein.");
}


string stamm(string str) 
{
  if (objectp(parent) && parent->GetBaumweg()!=1)
    return (BS("Der riesige Baumstamm liegt quer ueber dem Pfad. Du kannst "
 	       "wegen des dichten Dickichts nicht links oder "
	       "rechts an ihm vorbei. Allerdings erkennst Du Schleifspuren "
	       "unter dem Baum und einige Kratzer an dem Baumstamm."));
  return("Der Baumstamm wurde wohl zur Seite geschoben.\n");
}

string platz(string str)
{
  if (objectp(parent) && parent->GetBaumweg()!=1)
    return BS(LANGMIT);
  return BS(LANGOHNE);
}

string geschirr(string str)
{
  if (phiolencount<3)
    return BS("Hier kommt wohl oft jemand zum Spuelen vorbei. Auf dem "
	      "Holzgestell siehst Du noch drei Phiolen stecken, die noch "
	      "trocknen muessen.\n");
  return BS("Hier kommt wohl oft jemand zum Spuelen vorbei. Das Holzgestell "
	    "eignet sich hervorragend zum Abtropfen von Phiolen.\n");
}

string phiole(string str)
{
  if (phiolencount<3)
    return BS(sprintf("Phiolen sind kleine Glasflaeschchen mit nem Stopfen "
		      "aus Kork, davon siehst Du noch %d auf dem "
		      "Holzgestell.\n",
		      3-phiolencount));
  return BS("Phiolen sind kleine Glasflaeschchen mit einem Stopfen "
	    "aus Kork.\n");
}


