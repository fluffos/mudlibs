inherit "std/room";
#include "../def.h"

void create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "In einer steilen Felsroehre" );
  SetProp( P_INT_LONG,
	   "Du befindest Dich in einem kleinen Gang im Vulkangestein. "
	   "Eigentlich ist es mehr eine enge Roehre die sehr steil nach "
	   "oben fuehrt. Bestimmt ist hier frueher einmal die Lava "
	   "geflossen, denn die Decke und Waende sind aus glattem Stein. "
	   "Von der seltsamen Pflanze siehst du nur noch eine Ranke, die "
	   "sich an der Wand entlangzieht und Licht spendet. Der Boden "
	   "ist uneben und mit Steinen bedeckt. "
	   );
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12, ENV_TERRAIN: TT_CAVE]) );
  AddDetail( ({ "boden" }),
	     "Der Boden besteht aus Vulkangestein, einige kleinere und groessere "
	     "Steine liegen herum und erleichtern Dir den doch steilen Aufstieg. "
	     "Irgendwie kommen Dir die Steine so vor, als waeren sie absichtlich "
	     "hier hinterlegt worden.");
  AddDetail( "aufstieg","Oder ists ein Abstieg bei Dir?");
  AddDetail( "abstieg", "Oder ists gerade ein Aufstieg bei Dir?");
  AddDetail( ({"stein","steine","steinen","kletterhilfe"}),
	     "Die Steine sehen so aus, als waeren sie mit Absicht als Kletterhilfe "
	     "hier hingelegt worden. Anscheinend kommt hier oefters wer vorbei.");
  AddDetail( "absicht","Da hat sich wohl wer Gedanken gemacht.");
  AddDetail( "gedanken","Ab und zu hat Jemanden einen guten Gedanken.");
  AddDetail( ({"kopf","schaedel"}),
	     "Panisch packst Du Dir an den Schaedel. Uff... Er ist noch da.");
  AddDetail( "lava","Lava ist fluessiges Vulkangestein.");
  AddDetail( "weg",
	     "Welchen Weg Du Dir auch immer gewuenscht hast. Dieser hier ist "
	     "eng und steil.");
  AddDetail( ({ "pflanze" }),
	     "Die Pflanze hat lange Ranken, von denen Du hier aber nur noch eine "
	     "siehst. Die Blaetter sind klein aber sehr zahlreich. "
	     "Die ganze Pflanze strahlt in einem starken hellgruenen Licht. ");
  AddDetail( ({ "gang","roehre","lavaroehre" }),
	     "Du befindest dich gerade in einem schmalen Gang. Dies scheint eine "
	     "erstarrte Lavaroehre zu sein. Du bist froh das der Vulkan nicht mehr "
	     "aktiv ist.");
  AddDetail( "vulkan",
	     "Das alles hier scheint vulkanischen Ursprungs zu sein. Alles besteht "
	     "aus Vulkangestein.");
  AddDetail( ({"ursprung","ursprungs"}),
	     "Als der Vulkan noch aktiv war, ist an dieser Stelle fluessiges Gestein, "
	     "auch Magma genannt, aus dem Erdinneren an dieser Stelle an die "
	     "Oberflaeche gelangt und hat einen Vulkan gebildet.");
  AddDetail( "magma",
	     "Fluessiges Gestein aus dem Erdinneren.");
  AddDetail( "Erdinneren",
	     "Das ist weit unter Dir.");
  AddDetail( "stelle","Na, hier so etwa.");
  AddDetail( "oberflaeche",
	     "Die ist direkt unter Dir.");
  AddDetail( ({ "blaetter", "blatt","teil" }),
	     "Ein Teil der Pflanze, dessen Ranke an der Wand waechst.");
  AddDetail( ({ "ranke","ranken" }),
	     "Als Du genau hinsiehst, merkst du, dass die Ranke von Irgendwem "
	     "an einem duennen Draht entlanggefuehrt wurde. Wahrscheinlich um "
	     "die Roehre zu beleuchten. Die Ranke sieht nicht sehr stabil aus, "
	     "sie zerreist bestimmt leicht. Also pass auf.");
  AddDetail( ({"draht","blumendraht"}),
	     "Sieht aus wie handelsueblicher Blumendraht.");
  AddDetail( "irgendwem","Wer mag das nur gewesen sein?");
  AddDetail( ({ "licht" }),
	     "Das Licht ist hellgruen und beleuchtet schwach deinen Weg.");
  AddDetail( ({ "decke" }),
	     "Die Decke haengt ziemlich tief, pass auf dass Du Dir den "
	     "Kopf nicht stoesst.");
  AddDetail( ({ "wand", "waende" }),
	     "Die Waende bestehen aus erstarrter Lava. Sie sind sehr glatt und glasig.");
  AddDetail( ({ "gestein", "vulkangestein" }),
	     "Tief schwarzes, zum Teil poroeses, zum Teil aber auch fast "
	     "glasartiges Vulkangestein.");
  AddDetail( ({"kletterei"}),
	     "Die ist ganz schoen anstrengend.");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst nur deinen eigenen Atem.");
  AddSound( ({ "atem" }),
	    "Die Kletterei ist ganz schoen anstrengend..." );
  AddCmd("zerreisse|zerreiss&ranke","cmd_hacke","Was willst du zerreissen?");
}

