#include "../def.h"
inherit ROOM "inh_gang";

void create()
{
  ::create();
  AddExit("nordosten", ROOM "d_8_1.lpc");
  AddExit("sueden",    ROOM "d_7_3.lpc");
}

void reset() 
{
  if(QueryProp(P_LIGHT)<=0)
    LICHTMASTER->licht_an(3);
}

int cmd_hacke()
{
  if (ENV(TP)->QueryProp(P_LIGHT)<1) {
    tell_object(TP,BS("Die Ranke ist doch schon zerrissen."));
  }
  LICHTMASTER->licht_aus(3);
  return 1;
}





