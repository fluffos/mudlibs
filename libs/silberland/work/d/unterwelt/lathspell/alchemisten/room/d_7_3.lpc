#include "../def.h"
inherit ROOM "inh_gang";

void create()
{
  ::create();
  AddExit("sueden", ROOM "d_7_4.lpc");
  AddExit("norden", ROOM "d_7_2.lpc");
  
}

void reset() 
{
  if(QueryProp(P_LIGHT)<=0)
    LICHTMASTER->licht_an(2);
}

int cmd_hacke()
{
  if (ENV(TP)->QueryProp(P_LIGHT)<1) {
    tell_object(TP,BS("Die Ranke ist doch schon zerrissen."));
  }
  LICHTMASTER->licht_aus(2);
  return 1;
}




