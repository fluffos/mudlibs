#include "../def.h"
#define ROOM1 "d_7_4"
#define ROOM2 "d_7_3"
#define ROOM3 "d_7_2"
#define ROOM4 "d_8_1"

int hacked;
string *raeume=({ROOM ROOM1,ROOM ROOM2,ROOM ROOM3,ROOM ROOM4});

void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }
  seteuid(getuid(this_object()));
  hacked=0;
  return;
}

void reset()
{

}

void licht_an(int room) 
{
  //wird vom raumreset aufgerufen, macht licht an, bis zu dem raum
  //wo wieder gehackt wurde
  object obj;

  //raumbit zurücksetzen
  hacked&=~(1<<(room-1));

  //licht an in den nächsten räumen
  while (room<5) {
    //checken ob im vorraum licht aus
    if(hacked&((1<<room)-1))
      return;
    if (!find_object(raeume[room-1]))
      call_other(raeume[room-1],"???");
    obj=find_object(raeume[room-1]);
    obj->SetProp(P_LIGHT,1);
    obj->Message(BS("Die Ranke scheint sich zu erholen. Es wird heller."));
    obj->AddDetail( ({ "pflanze" }),
	     "Die Pflanze hat lange Ranken, von denen Du hier aber nur noch eine "
	     "siehst. Die Blaetter sind klein aber sehr zahlreich. "
	     "Die ganze Pflanze strahlt in einem starken hellgruenen Licht. ");
    room++;
  }
}

void licht_aus(int room) 
{
  object obj;

  hacked|=1<<(room-1);
  while (room<5) {
    if (!find_object(raeume[room-1]))
      call_other(raeume[room-1],"???");
    obj=find_object(raeume[room-1]);    
    if (obj->QueryProp(P_LIGHT)>0) {
      obj->Message(BS("Ploetzlich vertrocknet die Ranke und es wird dunkel."));
      obj->SetProp(P_LIGHT,0);
    obj->AddDetail( ({ "pflanze" }),
	     "Die Pflanze hat lange Ranken, von denen Du hier aber nur noch eine "
	     "siehst. Die Blaetter sind klein aber sehr zahlreich. "
	     "Leider ist sie ganz vertrocknet. ");

    }
    room++;
  }
}



