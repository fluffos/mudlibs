#include "../def.h"

string *enemies;

int deadcount;
int warda;


/* Standardfunktionen */

void create()
{
  if(is_clone(this_object()))
  {
    destruct(this_object());
    return;
  }
  seteuid(getuid(this_object()));
  enemies = ({ });
  deadcount=0;
  warda=0;
  return;
}

void reset()
{
  enemies = ({ });
  deadcount=0;
  warda=0;
}

/* Koenigin */

// zaehlt die getoeten bienen und ruft koeniginen sequenz auf */
void AddDead(object pl) {

  deadcount++;
  if ((deadcount >2) && (warda==0)) {
    call_out("koenigin",3,pl);
    warda=1;
  }
}

// kurze sequenz
void koenigin (object pl) 
{
  if (!pl) return;
  if (!interactive(pl)) return;
  tell_object(pl,BS("Ploetzliche Ruhe! Du haettest die kleinen Bienchen lieber "
		    "in Ruhe lassen sollen. Ein brummen geht durch die Luft "
		    "und wird stetig lauter..."));
  tell_object(ENV(pl),BS(pl->Name()+" haette die Bienchen lieber in Ruhe lasen sollen. "
			 "Ploetzlich geht ein lautes brummen durch die Luft."));
  call_out("clonekoenigin",3,pl);
}

//cloned koenigin
void clonekoenigin(object pl) 
{
  if (!pl) return;
  if (!interactive(pl)) return;
  clone_object(NPC "koenigin")->move(ENV(pl),M_GO|M_NO_SHOW);
}


/* Feindverwaltung */

void AddEnemy(object pl)
{
  string uuid;

  if(!pl)              return;
  if(!interactive(pl)) return;
  uuid = getuuid(pl);
  if(member(enemies, uuid) == -1) enemies += ({ uuid });
}

int IsEnemy(object pl)
{
  string uuid;

  if(!pl)              return 0;
  if(!interactive(pl)) return 0;
  uuid = getuuid(pl);
  if(member(enemies, uuid) != -1) return 1;
  return 0;
}

/***************************************************************************
** Die folgenden drei Funktionen sind in den entsprechenden NPC zu kopieren
** oder noch besser, man kreiiert sich seinen eigenen std_npc, der diese
** Funktionen Beinhaltet
****************************************************************************

void angriff(object pl)
{
  string shouter;

  if(!ENV(TO))           return;
  if(!ENV(pl))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;

  shouter = pl->CannotSee(1) ? "Jemand ruft: "
                             : Name(WER,1)+" ruft: ";

  tell_room(ENV(TO),
     "\n"+break_string(pl->Name(WER)+" ist uns feindlich "
             "gesinnt, auf "+pl->QueryPronoun(WEN)+" mit Gebruell!!!", 78,
             shouter)+"\n", 1);

  Kill(pl);

  return;
}

void init()
{
  ::init();

  if(!TP)                        return;
  if(!interactive(TP))           return;
  if(TP->QueryProp(P_GHOST))     return;
  if(!DORFMASTER->IsEnemy(TP))   return;

  call_out("angriff", 0, TP);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  DORFMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}

***************************************************************************/

