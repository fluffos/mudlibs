/* 
   turmlist.c

   Top-Liste der Tuerme von Hanoi


   3.10.2006 

*/

#include <ansi.h>
#include "../def.h"

#define LOGFILE LOG+"hanoi.txt"
#define TMPFILE LOG+"turmlist.tmp"

/* Globale Variabeln */

mapping liste=([]);


/* Standardfunktionen */

void create() 
{
  if (is_clone(TO)) {
    destruct(TO);
    return;
  }
  seteuid(getuid(this_object()));
}

void reset() {
  return;
}


//soriteren nach count
int count_sort(string str1, string str2) 
{
  if (liste[str1]<liste[str2]) { 
    return 0; 
  } else 
    return 1;
}

//topliste in tempdatei erstellen
//wird vom crond morgens um sechs aufgerufen
void create_list() 
{
  string str,wer,dummi1;
  int count,filepos;
  int i,len,pos;
  mixed *spieler;
  string tmp,tmp2;

  //logfile einlesen und jeden spieler mit minimalen count speichern
  filepos=0;
  while((str=read_file(LOGFILE,filepos,1))!=0) {
    if (strlen(str)!=0) {
      sscanf(str,"%s: %s loest die Tuerme von Hanoi in %d Zuegen.",dummi1,wer,count);
      if (member(liste,wer)) {
	//schaun obs bei diesem versuch besser war 
	if (liste[wer]>count) 
	  liste[wer]=count;
      } else {
	liste+=([wer: count]);
      }
    }
    filepos++;
  }
  
  //liste sortieren und top spieler, plus top 50 in datei speichern
  str="";tmp=""; tmp2=""; pos=1;
  spieler=sort_array(m_indices(liste),"count_sort",ME);
  for (i=0;i<sizeof(spieler) && pos<=50;i++) {
    if (liste[spieler[i]]==31) {
      //minimale anzahl, gut gemacht
      tmp+=CAP(spieler[i])+", ";
    } else {
      //vom rest die top 50
      tmp2+=sprintf("%-5d%-20s%-50d\n",
		    pos,
		    CAP(spieler[i]),
		    liste[spieler[i]]);
      pos++;
    }
  }
  //ausgabe formatieren
  len=strlen(tmp)-3;
  tmp=tmp[0..len];
  str+=sprintf("\n"+ANSI_BOLD+"%|78s\n%|78s\n\n"+ANSI_NORMAL+
	       "%s\n%s\n"+ANSI_BOLD+ANSI_UNDERL+"%-5s%-20s%-50s\n\n"+ANSI_NORMAL+"%s\n",
	       "Topliste der Tuerme von Hanoi",
	       "vom "+dtime(),
	       BS("Folgende Spieler haben die minimale Anzahl von 31 Zuegen erreicht:"),
	       BS(tmp),
	       "Pos",
	       "Name",
	       "Zuege",
	       tmp2);
  if (file_size(TMPFILE)>0)
    rm(TMPFILE);
  if (write_file(TMPFILE,str)==0) 
    write ("Fehler beim schreiben");
  return;
}


/* Spieler Kommando */
int cmd_create(string str)
{
  create_list();
  return 1;
}

void cmd_turmliste()
{
  string tmp;

  if (file_size(TMPFILE)<=0) {
    write("Keine Topliste vorhanden\n");
    return;
  }
  tmp=read_file(TMPFILE);
  TP->more(tmp);
  return;
}







	 
