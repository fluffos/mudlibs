// Ein Huhn zum treten
// (c) 2005 Georg Schardt aka Lathspell
//
// 13.7.05


inherit "std/npc";

#include "../def.h"

int kraft=0;

void create() {
  if(!is_clone(TO)) return;
  ::create();
  create_default_npc(3);
  SetProp(P_SHORT, "Ein kleines Huhn");
  SetProp(P_LONG,BS(
	  "Ein ganz normales Grillhuhn. Eigentlich gehoert es gar nicht hier "
	  "her, sondern auf den Bauernhof. Vielleicht kannst Du es ja einfach "
	  "mal treten."));
  SetProp(P_ARTICLE, 1);
  
  SetProp(P_NAME,"Huhn");
  SetProp(P_BODY,30);
  SetProp(P_GENDER, 0);
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 100);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 3);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "na klar, immer auf die Kleinen.");
  SetProp(P_KILL_NAME, "Ein Grillhuhn");
  SetProp(P_KILL_MSG, "Du Weichei!");
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "verschwindet");
  SetProp(P_LOG_INFO, "lathspell/huhn.rep");
  SetProp(P_HANDS,  ({ " mit scharfen Krallen", QueryProp(P_HANDS)[1],DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_REJECT, ({ REJECT_DROP, "@CAP_WER kann das nicht nehmen.\n" }) );
  AddId(({"huhn", "vogel"}));
  AddInfo(DEFAULT_INFO,"versteht Dich gar nicht.\n");
  AddCmd(({"tritt","trete"}),"cmd_tritt");
  SUID;
}


int cmd_tritt (string str) {

  int i;

  notify_fail( "Wen willst Du treten ?\n" );
  if(!str || !id(str)) return 0;

  if (find_call_out("flug") !=-1 || find_call_out("landung") !=-1 || 
      find_call_out("landung2") != -1 ) {
    write("Das Huhn fliegt doch schon.\n");
    return -1;
  }
  write(BS("Du nimmst ein bischen Anlauf und trittst mit aller Kraft gegen "
	   "das Huhn. Es fliegt im hohen Bogen durch den Raum ..."));
  ENV(TP)->Message(BS(TP->Name()+" tritt mit aller Kraft gegen das Huhn. "
                     "Es fliegt im hohen Bogen durch den Raum ..."), 
		   MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  
  kraft=TP->QueryAttribute(A_STR)/9;
  if (TP && interactive(TP))  call_out("flug",4,TP,kraft);
  return 1;
}

void flug(object player, int kraft) 
{
  int i;

  if (!player) return;
  if (!interactive(player)) return;
  if (!ENV(TO)) return;
  say("... und fliegt ...\n");
  kraft--;
  if (kraft>0)
    call_out("flug",4,player,kraft);
  else {
    if (random(10)>5)
      call_out("landung",4);
    else 
      call_out("landung2",4);
  }
  return ;
}


void landung()
{
  object *rooms;
  
  rooms=m_values(ENV(TO)->QueryProp(P_EXITS));
  if (!sizeof(rooms)) {
    say("Das Huhn landet unsanft.\n");
    return;
  }    
  TO->move(rooms[random(sizeof(rooms))],M_GO | M_NO_SHOW,
    "aus Deinem Sichtfeld","fliegt","landet unsanft.");
}

void landung2() 
{
  say("Das Huhn landet unsanft.\n");
  return; 
}


void die(int poisondeath) 
{
  AREA->Msg((CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+ " killt "+name(WEN,1),1);
  while (remove_call_out("flug")!=-1) /* continue */;
  while (remove_call_out("landung")!=-1) /* continue */;
  while (remove_call_out("landung2")!=-1) /* continue */;
  ::die(poisondeath);
}  
 

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer != ME)
    write_file(LOG "npc_huhn.kills",
	     ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+
             " umgebracht.\n");
}


// Reactions
 void StartReaction(string verb, string gruppe, string adverb, int touch) {
   string str;
   
   if (find_call_out("reaction") != -1) return;
   switch (gruppe) {
   case "aengstlich":
     break;
   case "aergerlich":
     call_out("reaction", 0, TP,
	      "sieht sehr wuetend aus.", 0);
     break;
   case "albern":
     call_out("reaction", 0, TP,
	      "gaggert.", 0);
     break;
   case "fies":
     call_out("reaction", 0, TP,
	      "hackt Dir in den Fuss!", 0);
     break;
   case "frech":
     call_out("reaction", 0, TP,
	      "hackt Dir in den Fuss.", 0);
     break;
   case "froh":
     call_out("reaction", 0, TP,
	      "grummelt.", 0);
     break;
   case "intim":
     call_out("reaction", 0, TP,
	      "grummelt.", 0);
     break;
   case "nett":
     call_out("reaction", 0, TP,
	      "schuettelt sich.", 0);
     break;
   case "neutral":
     call_out("reaction", 0, TP,
	      "schaut kurz auf.", 0);
     break;
   case "traurig":
     call_out("reaction", 0, TP,
	      "grummelt.", 0);
     break;
   }
 }

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+(andere==0?macher:andere)), ({ob}));
  }
}
