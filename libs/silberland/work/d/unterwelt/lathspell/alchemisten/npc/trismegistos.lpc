inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"
#include <npcmaster.h>

void create() {
  if (!is_clone(TO)) return;
  ::create();
  create_default_npc(25);
  SetProp(P_SHORT, "Der Alchemist Trismegistos");
  SetProp(P_LONG,
	  "Das ist Trismegistos, ein Alchemist der alten Schule. Er lernte "
	  "die Kunst der Alchemie von seinem Meister, wie dieser von seinem. "
	  "Er gibt die Geheimnisse der Alchemie nur an seine Schueler "
	  "weiter. Seine Zaubertraenke sind ueber das ganze Land bekannt. "
	  "Unter seinem spitzen Hut schauen zwei klare, schwarze Augen "
	  "hervor, die durch den langen weissen Bart erst richtig zur Geltung "
	  "kommen. Ab und zu verhaut er sich bei der Zubereitung, aber wenn "
	  "es drauf ankommt, braut er die tollsten Traenke.");
  SetProp(P_NAME, "Trismegistos");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, -4);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOATTACK, "sagt: Versuchs am besten gar nicht erst.");
//  SetProp(P_NO_SCORE,1); //keine kerbe
  SetProp(P_NOMAGIC,100);
  SetProp(P_DIE_MSG,  " stirbt einen Heldentod.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Meine Schueler werden mich raechen?");
  SetProp(P_KILL_NAME, "Trismegistos");
  SetProp(P_KILL_MSG, "Meine Traenke machen STARK, und Du warst schwach!");
  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_LOG_INFO, "lathspell/trismegistos.rep");
  SetProp(P_SPELLRATE,0);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_EXPLOSION:-1.0, DT_FIRE:-1.0, DT_WATER: -1.0, DT_COLD:  0.0,
      DT_LIGHTNING:-1.0, DT_ACID:-1.0, DT_LIGHT: -1.0, DT_AIR:   0.0,
      DT_ELECTRIC: -1.0, DT_MIND: 0.0, DT_TERROR:-1.0, DT_MAGIC:-1.0,
      DT_UNHOLY:   -1.0, DT_HOLY:-1.0, DT_POISON: 0.0, DT_SOUND:-1.0]));
  SetProp(P_HANDS, ({" mit einem grossen Topfloeffel",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp( P_REJECT, ({ REJECT_KEEP, "Trismegistos legt @WEN ins Regal\n" }) );
  AddId(({"alchemist", "zaubertrankmeister", "meister","trismegistos"}));
  set_living_name("trismegistos");
  SUID;
  AddInfo(DEFAULT_INFO,"sagt: Darueber weiss ich leider nichts.\n");
  AddInfo(({"alchemisten","alchemie"}),  //hier event. demnächst eine Sequenz, die auf das erste Abenteuer hinweist.
      "Ja, die Kunst der Alchemie. Ich lernte die hohe Kunst bei "
      "meinem Meister, und ich werde sie nur an meine Schueler "
      "weitergeben. Es erfordert hohe Konzentration, "
      "Koerperbeherrschung und strengste Geheimhaltung. Das Wissen wird "
      "seit Jahrhunderten nur so weitergegeben. Jedem Schueler wird "
      "eine Eingangspruefung abverlangt, um seine  "
      "Konzentrationsfaehigkeit zu testen.\n","sagt: ");
  AddInfo(({"zaubertraenke","zaubertrank","trank"}),
      "Ich brau die besten Traenke im ganzen Land. Das Wissen "
      "gebe ich aber nur an meine Schueler weiter.\n","sagt: ");
  AddInfo("schueler","Schueler nehme ich noch keine auf. Aber frag mich "
	  "spaeter noch einmal danach.","sagt: ");
  AddInfo("wissen","Sobald ich hier eingerichtet bin, werde ich mein Wissen "
	  "an Schueler weitergeben.","sagt: ");
  //AddInfo(({"ausbildung","beitreten"}),
  //        "Nun denn, Du kannst bei mir die hohe Kunst der Alchemie lernen. Doch wisse Schueler, es bedarf "
  //	  +"hoher Konzentration und absoluter Genauigkeit fuer diese Faehigkeit. Bist Du Dir dessen bewusst, so tippe"
  //	  +" \"tritt alchemisten bei\" um in die Gilde der Alchemisten aufgenommen zu werden.\n","sagt: ");
  //AddInfo(({"eingangspruefung","pruefung"}),
  //	  "Nun gut Schueler, als Zeichen Deiner hohen Konzentrationsfaehigkeit musst Du es schaffen, die Tuerme von Hanoi "
  //	  "unter 35 Zuegen zu loesen. Lass Dir Zeit und ueberlege jeden Zug weise.\n","sagt: ");
  AddInfo("tuerme",
      "Schau Dich um Schueler. Du wirst finden, was Du suchst.\n",
      "sagt: ");
  AddInfo("hanoi","Da gibt es Tuerme.\n","sagt: ");
}



void die(int poisondeath) {
  write_file(LOG "npc_trismegistos.deads",
 	   ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
 	   " killt "+name(WEN,1)+".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer != ME)
    write_file(LOG "npc_trsimegistos.kills",
	     ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}


// Reactions
 void StartReaction(string verb, string gruppe, string adverb, int touch) {
   string str;
   
   if (find_call_out("reaction") != -1) return;
   switch (gruppe) {
   case "aengstlich":
     break;
   case "aergerlich":
     call_out("reaction", 0, TP,
	      "sieht sehr wuetend aus.", 0);
     break;
   case "albern":
     call_out("reaction", 0, TP,
	      "kichert leise.", 0);
     break;
   case "fies":
     call_out("reaction", 0, TP,
	      "droht Dir mit beiden Haenden!", 0);
     break;
   case "frech":
     call_out("reaction", 0, TP,
	      "gibt Dir eine Ohrfeige.", 0);
     break;
   case "froh":
     call_out("reaction", 0, TP,
	      "freut sich.", 0);
     break;
   case "intim":
     call_out("reaction", 0, TP,
	      "erroetet.", 0);
     break;
   case "nett":
     call_out("reaction", 0, TP,
	      "laechelt Dich an.", 0);
     break;
   case "neutral":
     call_out("reaction", 0, TP,
	      "nickt Dir zu.", 0);
     break;
   case "traurig":
     call_out("reaction", 0, TP,
	      "schluchzt leise.", 0);
     break;
   }
 }

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+(andere==0?macher:andere)), ({ob}));
  }
}
