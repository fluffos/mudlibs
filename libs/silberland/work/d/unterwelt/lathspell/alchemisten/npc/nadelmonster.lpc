inherit "std/mnpc";
inherit "std/npc/spells.lpc";


#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();
  create_default_npc(40);
  SetProp(P_SHORT, "Ein harziges Nadelmonster");
  SetProp(P_LONG,BS(
	  "Das Nadelmonster sieht aus wie ein riesiger Tannenzapfen. Sein "
	  "Koerper ist ueber und ueber mit Harz verschmiert und "
	  "es kleben hunderte von Nadeln an seinem Koerper. Seine Arme "
	  "sind eigentlich maechtige Aeste und seine Haende riesige "
	  "scharfe Klauen."));
  AddDetail(({"klauen","haende"}),"Sie sind wirklich riesig.\n");
  AddDetail("tannenzapfen","Wie ein Tannenzapfen halt aussieht, nur mit "
	    "kurzen Beinen und langen kraeftigen Armen.\n");
  AddDetail("harz","Wirklich klebrig...\n");
  SetProp(P_ARTICLE, 1);
  SetProp(P_NAME,"Nadelmonster");
  SetProp(P_BODY,150);
  SetProp(P_GENDER, 0);
  SetProp(P_RACE, "daemon");
  SetProp(P_SIZE, 200);
  SetProp(P_WEIGHT, 160000);
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 15);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Warum hast Du das getan?");
  SetProp(P_KILL_NAME, "Ein Nadelmonster");
  SetProp(P_KILL_MSG, "Harhar, Du Narr!");
  SetProp(P_MSGIN, "springt aus dem Wald");
  SetProp(P_MSGOUT, "springt in den Wald zurueck");
  SetProp(P_MMSGIN, "springt aus dem Wald");
  SetProp(P_MMSGOUT, "springt in den Wald zurueck");
  SetProp(P_LOG_INFO, "lathspell/nadelmonster.rep");
  SetProp(P_SPELLRATE,50);
 
  //Balance ????
  SetProp(P_RESISTANCE_STRENGTHS,
	  ([ DT_FIRE:1.0, DT_POISON:-0.5, DT_MAGIC:0.1, DT_WATER: -0.3]));

  //
  AddSpell(5,400,
              "Das Nadelmonster erwischt Dich mit beiden Klauen.\n",
              "Das Nadelmonster erwischt @WEN mit beiden Klauen\n",
              ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
  AddSpell(4,300,
              "Das Nadelmonster rammt Dir den Kopf in den Bauch.\n",
              "Das Nadelmonster rammt @WEM den Kopf in den Bauch\n",
              ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(1,1,DS_PARALYZE,
		  "Das Nadelmonster klebt Dich am Boden fest.\n",
		  "Das Nadelmonster klebt @WEN am Boden fest.\n");
  SetProp(P_HANDS, ({" mit seinen grossen Klauen",QueryProp(P_HANDS)[1]+50,DT_BLUDGEON}));
  SetProp(P_REJECT, ({ REJECT_DROP, "@CAP_WER wird vom Nadelmonster zu Boden geschleudert.\n" }) );
  AddInfo(DEFAULT_INFO,"versteht Dich gar nicht.\n");
  AddId(({"monster", "nadelmonster"}));
  SUID;

}



void die(int poisondeath) {

  AREA->Msg((CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+ " killt "+name(WEN,1),1);
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer != ME)
    write_file(LOG "npc_nadelmonster.kills",
	     ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+
             " umgebracht.\n");
}


// Reactions
 void StartReaction(string verb, string gruppe, string adverb, int touch) {
   string str;
   
   if (find_call_out("reaction") != -1) return;
   switch (gruppe) {
   case "aengstlich":
     break;
   case "aergerlich":
     call_out("reaction", 0, TP,
	      "sieht sehr wuetend aus.", 0);
     break;
   case "albern":
     call_out("reaction", 0, TP,
	      "versteht gar keinen Spass.", 0);
     break;
   case "fies":
     call_out("reaction", 0, TP,
	      "baut sich drohend vor Dir auf!", 0);
     break;
   case "frech":
     call_out("reaction", 0, TP,
	      "tritt Dir in den Hintern.", 0);
     break;
   case "froh":
     call_out("reaction", 0, TP,
	      "grummelt.", 0);
     break;
   case "intim":
     call_out("reaction", 0, TP,
	      "grummelt.", 0);
     break;
   case "nett":
     call_out("reaction", 0, TP,
	      "schuettelt sich.", 0);
     break;
   case "neutral":
     call_out("reaction", 0, TP,
	      "schaut kurz auf.", 0);
     break;
   case "traurig":
     call_out("reaction", 0, TP,
	      "grummelt.", 0);
     break;
   }
 }

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+(andere==0?macher:andere)), ({ob}));
  }
}
