/* koenigin.c Bienenkoenigin

 2004 Lathspell

 29.9.2006 ueberarbeitet

*/

inherit "std/npc";
#include "../def.h"


int warda;

/* Standardfunktionen */
void create()
{
  if(!is_clone(TO)) return;
  ::create();

  create_default_npc(15);
  SetProp(P_SHORT, "Die Bienenkoenigin");
  SetProp(P_LONG,
	  "Die Bienenkoenigin ist groesser als Ihre Untertanen, und sie ist "
	  "gerade richtig boese. Du haettest lieber die kleinen suessen "
	  "Bienchen in Ruhe lassen sollen. Jetzt schau, wie Du damit fertig "
	  "wirst.");
  AddDetail( ({ "untertanen","bienchen" }),
	     "Du haettest die kleinen Bienchen in Ruhe lassen sollen.\n"
	     );
  SetProp(P_NAME, "Bienenkoenigin");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-5, T_RANGE_MAX:30]) );
  AddId( ({ "bienekoenigin","koenigin" }) );
  SetProp(P_HANDS, ({ " mit Ihrem grossen Stachel", QueryProp(P_HANDS)[1], ({DT_PIERCE,DT_POISON}) }) );
  SetProp(P_RACE, "Insekt" );
  AddClass(CL_ANIMAL);
  SetProp(P_SIZE, 20);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_WIMPY, 0);
  SetProp( P_REJECT, ({ REJECT_DROP,
		 "Die Bienenkoenigin will das nicht.\n" }) );
  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "fliegt heraus");
  SetProp(P_LOG_INFO, "lathspell/koenigin.rep");
  SetProp(P_DIE_MSG, " faellt tot vom Himmel.\n ");
  AddInfo(DEFAULT_INFO, " ignoriert Dich einfach.\n" );
  warda=0;
}

void reset() 
{
  if(!is_clone(TO)) return;
  ::reset();
  warda=0;
}

void init()
{
  ::init();
  if(!TP)                        return;
  if(!interactive(TP))           return;
  if(TP->QueryProp(P_GHOST))     return;
  if(!BIENENMASTER->IsEnemy(TP))   return;
  call_out("angriff", 0, TP);
}

// die() ueberschreiben um killer zu loggen 
void die(int poisondeath) 
{
  AREA->Msg((CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+ " killt "+name(WEN,1),1);
  ::die(poisondeath);

}  

// spieler tod melden 
void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer != ME)
    write_file(LOG "npc_koenigin.kills",
	     ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// wird beim schlag abwehren aufgerufen, hier hp checken und verstaerkung clonen 
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if (TO->QueryProp(P_HP) <100) {
    if (warda==0) {
      ENV(enemy)->Message("Harhar, "+enemy->Name()+" Du Narr, da kommt Verstaerkung.\n",
			  MSGFLAG_SOUND);
      clone_object(NPC "biene")->move(ENV(enemy),M_GO | M_NO_SHOW);
      clone_object(NPC "biene")->move(ENV(enemy),M_GO | M_NO_SHOW);
      clone_object(NPC "biene")->move(ENV(enemy),M_GO | M_NO_SHOW);
      warda=1;
    }
  }
  return ::Defend(dam, dam_type, spell, enemy);
}


// wird beim angegriffen werden aufgerufen 
void angriff(object pl)
{
  string shouter;

  if(!ENV(TO))           return;
  if(!ENV(pl))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;

  Kill(pl);

  return;
}











