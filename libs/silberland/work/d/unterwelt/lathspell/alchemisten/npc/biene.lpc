/*  biene.c Eine kleine Biene

    2004 Lathspell

    29.9.2006 ueberarbeitet
    19.11.2018 -> Id "NOCONTROL" eingefuegt -> wegen Bug im "Kontrolliere"
    Spell der Dunkelelfen - beenden der Kontrolle
    Eros

*/


inherit "std/mnpc"; 
#include "../def.h"


/* Standardfunktionen */

void create()
{
  if(!is_clone(TO)) return;
  ::create();
  create_default_npc(3);
  SetProp(P_SHORT, "Eine kleine Biene");
  SetProp(P_LONG,
	  "Eine kleine suesse Biene. Sie fliegt froehlich von Bluete zu "
	  "Bluete und nascht am leckeren Nektar. Wo wohl der Rest vom "
	  "Bienenschwarm ist ?\n");

  AddDetail( ({ "bienenschwarm","schwarm" }),
	     "Irgendwie glaubst Du, dass eine Biene selten allein kommt. "
	     "Sie hat bestimmt Verstaerkung im Ruecken.\n"
	     );

  AddDetail( ({ "nektar" }),
	     "Den finden die Bienen tief unten in den Blueten.\n"
	     );
  SetProp(P_NAME, "Biene");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-5, T_RANGE_MAX:30]) );
  create_default_npc(3);
  AddId( ({ "biene", "NOCONTROL"}) );
  SetProp(P_HANDS, ({ " mit Ihrem Stachel", 15, DT_PIERCE }) );
  SetProp(P_RACE, "Insekt" );
  AddClass(CL_ANIMAL);
  SetProp(P_SIZE, 2);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_WIMPY, 0);
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Biene kann das nicht tragen.\n" }) );
  SetProp(P_MSGIN, "sucht hier nach Nektar");
  SetProp(P_MSGOUT, "fliegt nach");
  SetProp(P_MMSGIN, "kommt herein geflogen");
  SetProp(P_MMSGOUT, "fliegt heraus");
  SetProp(P_MNPC_AREA, 
	  ({  ROOM "a_12_2", ROOM "a_12_3",
	      ROOM "a_11_2", ROOM "a_11_3",
	      ROOM "a_10_2", ROOM "a_10_3"}) );
  SetProp(P_MNPC_WAIT, ({ 15, 20, 20 }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "a_11_2");
  SetProp(P_MNPC_FLAGS, MOV_BACKWARDS|MOV_OUTDOORS|MOV_MOVES);
  SetProp(P_DIE_MSG, " faellt tot vom Himmel.\n ");
  SetProp(P_LOG_INFO, "lathspell/biene.rep");
  AddInfo(DEFAULT_INFO, " beachtet Dich gar nicht.\n" );
}

void init()
{
  ::init();
  if(!TP)                        return;
  if(!interactive(TP))           return;
  if(TP->QueryProp(P_GHOST))     return;
  if(!BIENENMASTER->IsEnemy(TP))   return;
  call_out("angriff", 0, TP);
}


// die wird überschrieben um kills zu zaehlen 
void die(int poisondeath) 
{
  object obj;

  obj=QueryProp(P_KILLER);
  
  if (!interactive(obj)) return;
  if (!ENV(TO)) return;
  if (!ENV(obj)) return;
  if (ENV(TO) != ENV(obj)) return;
  BIENENMASTER->AddDead(TP);
  ::die(poisondeath);

}  
 
//spielertod melden
void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer != ME)
    write_file(LOG "npc_huhn.kills",
	     ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+
	       " umgebracht.\n");
}


//wird beim angegriff werden aufgerufen
void angriff(object pl)
{
  string shouter;

  if(!ENV(TO))           return;
  if(!ENV(pl))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;

  shouter = pl->CannotSee(1) ? "Jemand summt: "
                             : Name(WER,1)+" summt: ";

  tell_room(ENV(TO),
	    "\n"+break_string(pl->Name(WER)+" greift mich an. Alle Stachel "
			      "auf "+pl->QueryPronoun(WEN)+"!!!", 78, 
			      shouter)+"\n");
  Kill(pl);
  return;
}


//wird beim schlag abwehren aufgerufen
int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  BIENENMASTER->AddEnemy(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}








