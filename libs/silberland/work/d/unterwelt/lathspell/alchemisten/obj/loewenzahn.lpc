inherit "std/thing";
#include <properties.h>
#include "../def.h"

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Loewenzahn");
  SetProp(P_LONG,
	  BS("Ein Loewenzahn mit gelber Bluete. Du kannst ihn zerrupfen wenn du ihn nicht mehr willst."));
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Loewenzahn");
  AddDetail("bluete","Sie ist herrlich gelb.");
  AddId(({"loewenzahn"}));
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 15);
  SetProp(P_MATERIAL, ({MAT_MISC_PLANT}));
  AddCmd("zerrupfe|rupf|rupfe&loewenzahn","cmd_rupfe","Was wills du zerrupfen?");

}

int cmd_rupfe(string str)
{
  write(BS("Du zerrupfst den Loewenzahn in kleine Stuecke.\n"));
  ENV(TP)->Message(BS(TP->Name(WER))+" zerrupft einen Loewenzahn.\n",
	  MSGFLAG_VISUAL|MSGFLAG_NO_TP);      
  TO->remove();
  return 1;
}
