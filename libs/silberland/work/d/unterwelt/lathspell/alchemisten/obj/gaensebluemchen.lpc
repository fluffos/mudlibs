inherit "std/thing";
#include <properties.h>
#include "../def.h"

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Gaensebluemchen");
  SetProp(P_LONG,
	  BS("Ein kleines weisses Gaensebluemchen. Du kannst es zerrupfen wenn du es nicht mehr willst."));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME, "Gaensebluemchen");
  AddId(({"bluemchen","gaensebluemchen"}));
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 12);
  SetProp(P_MATERIAL, ({MAT_MISC_PLANT}));
  AddCmd("zerrupfe|rupf|rupfe&bluemchen|gaensebluemchen","cmd_rupfe","Was wills du zerrupfen?");

}

int cmd_rupfe(string str)
{
  write(BS("Du zerrupfst das Gaensebluemchen in kleine Stuecke.\n"));
  ENV(TP)->Message(BS(TP->Name(WER))+" zerrupft ein Gaensebluemchen.\n",
		   MSGFLAG_VISUAL|MSGFLAG_NO_TP);      
  TO->remove();
  return 1;
}
