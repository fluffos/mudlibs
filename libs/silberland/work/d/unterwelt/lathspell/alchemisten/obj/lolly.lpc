// lolly.c
// Lolly mit Sprachfluch wenn er im Mund ist
//
// 12.01.2006 Lathspell


inherit "std/thing";
#include <properties.h>
#include "../def.h"

int inmund;
int lollyttl;
object owner;

create() {
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp( P_SHORT,"Ein leckerer Lolly");
  SetProp( P_LONG,
	   "Diesen klebrigen aber bestimmt auch suessen, leckeren Lolly hast "
	   "Du geschenkt bekommen. Du kannst Ihn lutschen.");
  SetProp( P_NAME, "Lolly");
  AddId( ({"lolly","lutscher"}));
  SetProp( P_INFO, "Ein leckerer Lolly");
  SetProp( P_GENDER, MALE);
  SetProp( P_WEIGHT, 5);
  SetProp( P_VALUE, 1);
  SetProp( P_NODROP,1);
  SetProp( P_MATERIAL, ([MAT_SUGAR:95, MAT_FRUIT:5]) );
  AddCmd("lutsche|lutsch&lolly|lutscher","cmd_lutschen","Was willst Du "
	 "lutschen?");
  AddCmd("steck|stecke&lolly|lutscher&weg","cmd_wegstecken",
	 "Was willst Du wegstecken?");
  owner=0;
  inmund=0;
  lollyttl=300;
}

init()
{
  ::init();
  if (owner && interactive(owner))
  {
    owner->SetProp(P_PERM_STRING, 0);
    owner=0;
  }
  if (environment()==this_player())
  {
    owner=this_player();
    owner->SetProp(P_PERM_STRING, this_object());
  }
}

int cmd_lutschen(string str)
{
  write(BS("Voller Vorfreude steckst Du den Lolly in den Mund und sofort "
	   "verteilt sich der suesse, fruchtige Geschmack "
	   "im Mund. Leider wird Deine Aussprache durch den langen Stil "
	   "und den sich aufloesenden Brauseball etwas "
	   "gestoert."));
  ENV(TP)->Message(TP->name()+" lutscht einen Lolly.\n",
		   MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  SetProp( P_LONG,
	   "Den Lolly hast Du gerade im Mund, Du kannst ihn wegstecken.\n");
  inmund=1;
  call_out("lollyalive",30,TP,0);
  return 1;
}

int cmd_wegstecken(string str)
{
  write(BS("Du nimmst den Lolly aus dem Mund."));
  ENV(TP)->Message(TP->name()+" nimmt einen Lolly aus dem Mund.\n", 
		   MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  SetProp( P_LONG,
	   "Diesen klebrigen aber bestimmt auch suessen, leckeren Lolly hast "
	   "Du von Trismegistos bekommen. " 
	   "Du kannst ihn lutschen.");
  inmund=0;
  return 1;
}


string add_spam(string str) 
{
  int i;
  string *strar;

  strar=new_explode(str," ");
  for (i=0; i<sizeof(strar); i++) {
    if (random(5)==5)
      strar[i]=strar[i]+" *sabber* ";
    if (random(5)==3)
      strar[i]=strar[i]+" *schleck* ";
  }
  str = implode(strar," ");
  return str;
}
 
string permutate_string (string str)
{
  string newstr;
  
  if (inmund==0) return str;
  newstr=str;
  newstr=regreplace(newstr, "er", "a", 1); 
  newstr=regreplace(newstr, "r", "", 1); 
  newstr=regreplace(newstr, "ss", "sch", 1); 
  newstr=regreplace(newstr, "ns", "nsch",1);
  newstr=add_spam(newstr);
  return newstr;
}

string extra_look()
{
  if (inmund==0) return ""
;
  if (environment()->QueryProp(P_GENDER)==2)
    return "Sie lutscht einen fruchtig, suessen Lolly.\n";
  else
    return "Er lutscht einen fruchtig, suessen Lolly.\n";
}

void lollyalive(object player, int ttl) 
{
  if(!player)                remove(); // object richtig uebergeben?
  if(!interactive(player))   remove(); // Spieler noch interaktiv? (d.h. kein disco)

  if (inmund==0) {  //spieler hat lolly wieder rausgenommen)
    lollyttl-=ttl; //lebenserwartung des lolly ist dann natuerlich kleiner;
    return;
  }
  if (ttl<lollyttl) {
    ENV(TP)->Message("Schmatz... schleck... schlabber...\n",MSGFLAG_VISUAL);
    call_out("lollyalive",20+random(10),player,ttl+30);
  } else{
    write(BS("Der Lolly neigt sich dem Ende. Du nimmst den abgenagten Stil aus dem Mund und entsorgst ihn fachgerecht.\n"));
    ENV(TP)->Message(TP->name()+" nimmt einen abgenagten Lollystil aus dem Mund und"
		     "entsorgt ihn fachgerecht.\n",MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    remove();
  }
}
