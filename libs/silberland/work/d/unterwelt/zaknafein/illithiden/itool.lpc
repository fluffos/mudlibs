/*
**   Tool fuer die Illithidenquest
**
**   Zaknafein, Mai 2001
*/


inherit "/std/thing";

#include <thing.h>
#include <properties.h>
#include <language.h>
#include <wizlevels.h>

#define BS(x) break_string( x, 76 )
#define TP this_player()
#define ILLMASTER "/d/unterwelt/zaknafein/illithiden/master/master"
#define QITEM "/d/unterwelt/zaknafein/illithiden/obj/iquestitem.lpc"
#define LOG "/d/unterwelt/zaknafein/illithiden/ill.log"
#define MIN_WIZ_LEVEL 25

create()
{
  if (!is_clone(this_object()))
     return;
 ::create();

  SetProp(P_SHORT, "Tool fuer die Illithidenquest" );
  SetProp(P_LONG,
       "Dieses Tool dient zum Testen der Illithidenquest.\n"
      +"Es stehen derzeit folgende Befehle zur Verfuegung: \n\n"
      +"Geld clonen                                 :         geld <summe>   \n"
      +"Wem folgt Masoj?                            :         masoj          \n"
      +"Wer macht gerade die Quest? (nur Spieler)   :         qwer           \n"
      +"Wer macht gerade die Quest? (auch Magier)   :         qwerwiz        \n"
      +"Wer hat alles obj_id dabei? (nur Spieler)   :         objwer <id>    \n"
      +"Wer hat alles obj_id dabei? (auch Magier)   :         objwerwiz <id> \n\n"
      +"Setzen/Abfragen von Variablen im Questitem der Illithidenquest:\n\n"
      +"Questitem clonen   :         qiclone <person>         \n"
      +"Kraut gegessen     :         kraut <person> <1/0>     \n"
      +"Schutz weg         :         sweg <person> <1/0>      \n"
      +"Zentralgehirn tot  :         ztot <person> <1/0>      \n"
      +"Aufgabe bekommen   :         aufgabe <person> <1/0>   \n"
      +"Variablen anzeigen :         vars <person>          \n\n"
      +"Funktionen im Master aufrufen:\n\n"
      +"Mapping BEHERRSCHUNG im Master loeschen :  delmap (nur im NOTFALL!)\n"
      +"Wird Spieler beherrscht?                :  beh <person> \n");

  AddId( ({ "itool" , "questtool" , "tool" }) );

  SetProp(P_NAME, "Tool");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_VALUE,1);
  SetProp(P_WEIGHT,0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_NODROP, "Du kannst das Tool nicht einfach ablegen.\n");
  SetProp(P_NOBUY, 1);
  SetProp(P_AUTOLOADOBJ,1);

  seteuid(getuid(this_object()));

  AddCmd( "geld" , "geldclonen");
  AddCmd( "masoj" , "masoj_func");
  AddCmd( "kraut" , "kraut_func");
  AddCmd( "sweg"  , "sweg_func");
  AddCmd( "ztot"  , "ztot_func");
  AddCmd( "qiclone"  , "qiclone_func");
  AddCmd( "aufgabe" , "aufgabe_func");
  AddCmd( "vars"  , "vars_anzeig");
  AddCmd( "delmap" , "delmap_func" );
  AddCmd( "beh" , "beh_func" );
  AddCmd( "qwer" , "qwer_func" );
  AddCmd( "objwer" , "objwer_func" );
  AddCmd( "qwerwiz" , "qwerwiz_func" );
  AddCmd( "objwerwiz" , "objwerwiz_func" );
}

qwer_func(str)
{
string mags;
object ob;
object *spieler;
int i;

spieler=users();
mags="";
check_wiz();
      write("Folgende Spieler haben ein Questitem dabei:\n\n");
      for (i=sizeof(spieler)-1; i>=0; i--)
       {
         if (query_wiz_level(spieler[i]) < 10 )
          {
              if (ob=present(("\niquestitem"), spieler[i]))
               write(capitalize(spieler[i]->query_real_name())+"\n");
          }
          else
           mags = mags+capitalize(spieler[i]->query_real_name())+", ";
       }

      write("\nDie Magier "+mags[0..<3]+" wurden nicht durchsucht!\n");
      return 1;
}

objwer_func(str)
{
object ob;
object *spieler;
string mags;
int i;

spieler=users();
mags="";

check_wiz();
notify_fail( "Gegenstand angeben!\n" );
if(str=="") return 0;
      write("Folgende Spieler haben '"+capitalize(str)+"' dabei:\n\n");
      for (i=sizeof(spieler)-1; i>=0; i--)
       {
         if (query_wiz_level(spieler[i]) < 10 )
          {
            if (ob=deep_present((str), spieler[i]))
             write(capitalize(spieler[i]->query_real_name())+"\n");
          }
         else
         mags = mags+capitalize(spieler[i]->query_real_name())+", ";
       }
       write("\nDie Magier "+mags[0..<3]+" wurden nicht durchsucht!\n");
       return 1;
}

qwerwiz_func(str)
{
object ob;
object *spieler;
int i;

spieler=users();
check_wiz();
      write("Folgende Spieler haben ein Questitem dabei:\n\n");
      for (i=sizeof(spieler)-1; i>=0; i--)
       {
         if (ob=present(("\niquestitem"), spieler[i]))
            write(capitalize(spieler[i]->query_real_name())+"\n");
       }
}

objwerwiz_func(str)
{
object ob;
object *spieler;
int i;

spieler=users();
check_wiz();
notify_fail( "Gegenstand angeben!\n" );
if(str=="") return 0;
      write("Folgende Spieler haben '"+capitalize(str)+"' dabei:\n\n");
      for (i=sizeof(spieler)-1; i>=0; i--)
       {
         if (ob=deep_present((str), spieler[i]))
           write(capitalize(spieler[i]->query_real_name())+"\n");
       }
      return 1;
}

beh_func(str)
{
check_wiz();
      if(ILLMASTER->BehPla(str)=="none")
       write(capitalize(str)+" wird von niemandem beherrscht.\n");
      else
       write(capitalize(str)+" wird von "+ILLMASTER->BehPla(str)+" beherrscht.\n");
      return 1;
}

delmap_func(str)
{
check_wiz();
ILLMASTER->delbeh();
return 1;
}

masoj_func(str)
{
    check_wiz();
    if(find_living("masoj"))
    {
      write("-> "+capitalize(find_living("masoj")->queryplayername())+"\n");
      return 1;
    }
    else
    {
     write("Masoj existiert im Moment nicht.\n");
     return 1;
    }
return 0;
}

aufgabe_func(str)
{
int wer;
int setz;
object ob;
check_wiz();
if(str==0) return 0;
sscanf(str, "%s %d", wer , setz);
notify_fail( "Hm?\n" );

      if(find_player(wer))
      {
       if (ob=present(("\niquestitem"), find_player(wer)))
       {
         if (setz==1)
         {
           ob->aufgabeein();
           write(BS("->1\n"));
         }
         if (setz==0)
         {
           ob->aufgabeaus();
           write(BS("->0"));
         }
         return 1;
       }
       else
       {
        write(BS(capitalize(wer+" hat KEIN ein Questitem.\n")));
        return 1;
       }
      }
      else
      {
      write(BS("Entweder hast Du einen falschen Namen eingegeben oder Du hast vergessen "
              +"0 oder 1 anzugeben.\n"));
      return 1;
      }
return 0;
}

