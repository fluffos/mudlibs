       {
        write(BS(capitalize(wer+" hat KEIN ein Questitem.\n")));
        return 1;
       }
      }
      else
      {
      write(BS("Entweder hast Du einen falschen Namen eingegeben oder Du hast vergessen "
              +"0 oder 1 anzugeben.\n"));
      return 1;
      }
return 0;
}

sweg_func(str)
{
int wer;
int setz;
object ob;
check_wiz();
if(str==0) return 0;
sscanf(str, "%s %d", wer , setz);
notify_fail( "Hm?\n" );
      if(find_player(wer))
      {
       if (ob=present(("\niquestitem"), find_player(wer)))
       {
         if (setz==1)
         {
           ob->schutzwegein();
           write(BS("->1\n"));
         }
         if (setz==0)
         {
           ob->schutzwegaus();
           write(BS("->0"));
         }
         return 1;
       }
       else
       {
        write(BS(capitalize(wer+" hat KEIN ein Questitem.\n")));
        return 1;
       }
      }
      else
      {
      write(BS("Entweder hast Du einen falschen Namen eingegeben oder Du hast vergessen "
