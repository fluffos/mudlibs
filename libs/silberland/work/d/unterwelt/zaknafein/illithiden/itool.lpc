vars_anzeig(str)
{
int wer;
object ob;
check_wiz();
if(str==0) return "Name angeben!\n";
sscanf(str, "%s", wer);
notify_fail( "Hm?\n" );

      if(find_player(wer))
      {
        if (ob=present(("\niquestitem"), find_player(wer)))
        {
            write("Variablen im Questitem von "+capitalize(wer)+":\n");
            write("\n");
            write("Kraut gegessen    : "+ob->querykrautgegessen()+"\n");
            write("Schutz weg        : "+ob->queryschutzweg()+"\n");
            write("Schale status     : "+ob->queryschale()+"\n");
            write("Gehirn tot        : "+ob->querygehirntot()+"\n");
            write("Aufgabe           : "+ob->queryaufgabe()+"\n");
            write("Masoj folgt       : "+ob->querymasojfolgt()+"\n");
            return 1;
        }
        else
        {
            write(BS(capitalize(wer+" hat KEIN ein Questitem.\n")));
            return 1;
        }
      }
      else
      {
        write(BS("Person nicht gefunden!\n"));
        return 1;
      }
return 0;
}

qiclone_func(str)
{
string wer;
object ob;
check_wiz();
if(str==0) return 0;
sscanf(str, "%s", wer);
notify_fail( "Hm?\n" );

      if(find_player(wer))
      {
       if (ob=present(("\niquestitem"), find_player(wer)))
       {
         write(BS(capitalize(wer+" hat schon ein Questitem.\n")));
         return 1;
       }
       else
       {
         clone_object(QITEM)->move(find_player(wer));
         write(BS(capitalize(wer+" hat nun ein Questitem.\n")));
         return 1;
       }
      }
      else
      {
      write("Ein Spieler dieses Namens befindet sich momentan nicht im SL.\n");
      return 1;
      }
return 0;
}

kraut_func(str)
{
int wer;
int setz;
object ob;
check_wiz();
if(str==0) return 0;
sscanf(str, "%s %d", wer , setz);
notify_fail( "Hm?\n" );

      if(find_player(wer))
      {
       if (ob=present(("\niquestitem"), find_player(wer)))
       {
         if (setz==1)
         {
           ob->krautgegessenein();
           write(BS("->1\n"));
         }
         if (setz==0)
         {
           ob->krautgegessenaus();
           write(BS("->0"));
         }
         return 1;
       }
       else
       {
        write(BS(capitalize(wer+" hat KEIN ein Questitem.\n")));
        return 1;
       }
      }
      else
      {
      write(BS("Entweder hast Du einen falschen Namen eingegeben oder Du hast vergessen "
              +"0 oder 1 anzugeben.\n"));
      return 1;
      }
return 0;
}

geldclonen(str)
{
int wieviel;
check_wiz();
if(str==0) return 0;
sscanf(str, "%d", wieviel);
notify_fail( "Hm?\n" );

      write(BS("Du hast nun "+wieviel+" Muenzen mehr.\n"));
      this_player()->AddMoney(wieviel);
      return 1;
}

void check_wiz()
{
 if(query_wiz_level(this_player()) < MIN_WIZ_LEVEL)
        {
           write("Dieses Tool ist nur fuer Magier!!!\n");

           write_file (LOG,
               sprintf ("%s  %s versuchte, das ITOOL zu benutzen!!!\n",
                  dtime(time()), capitalize(this_player()->query_real_name())));

           if(find_player("zaknafein")) tell_object(find_player("zaknafein"),
                    break_string(capitalize(this_player()->query_real_name())
                    +" versuchte, das ITOOL zu benutzen!", 78,
                     "ITOOL: "));

           this_object()->remove();
        }
}

int
_query_autoloadobj()
{
  return 1;
}
