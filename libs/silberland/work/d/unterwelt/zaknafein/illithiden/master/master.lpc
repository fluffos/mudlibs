// Master fuer die Illithidenquest
// Zaknafein, Mai 2001
//
// Zaehlt Tode und Kills mit, erstellt Top-Listen und regelt den Ulithiden-Spell 'Beherrschung'
//

#include "../files.h"

#include <properties.h>
#include <language.h>

mapping BEHERRSCHUNG = ([]); 
mapping KILLS = ([]);
mapping TODE = ([]);


int BehLog (string wer , string wen);             // wer beherrscht wen
string BehPla (string wer);                       // wird Spieler wer beherrscht?
string TopListe();                                // Funktion fuer Top-Liste
void name_ausgeb(string wer);                     // fuer TopListe()
string DeadListe();                               // Funktion fuer Todes-Liste
void dead_ausgeb(string wer);                     // fuer DeadListe()
int SumDead();                                    // Summe aller Todesfaelle
int KillLog (object wen , string wer);            // wer killte wen
int DieLog (object wem , string wer);             // wer ist an wem gestorben

void delbeh();                                    // Mapping BEHERRSCHUNG mit QuestTool loeschen

create()
{
  if (is_clone(this_object())) { destruct(this_object());  return 1;  } 
  
  restore_object(ILLMASTER);                      // nach Reboot laden
  BEHERRSCHUNG = ([ ]);
}

string BehPla (string wer)                        // Gibt den Namen des Ulithariden zurueck, von                         
{                                                 // dem der Spieler beherrscht wird.
int i;
string *uli;
uli = allocate(sizeof(BEHERRSCHUNG));

uli = m_indices(BEHERRSCHUNG);

  for (i=sizeof(BEHERRSCHUNG)-1; i>=0; i--)       // Mapping wird nach 'wer' abgesucht
   {
     if(BEHERRSCHUNG[uli[i]]==wer)      
      return uli[i];                              // Name des Ulithariden wird zurueckgegeben
   } 

return "none";                                    // Spieler wird nicht beherrscht
}

int BehLog (string wer , string wen)
{

if (!member(BEHERRSCHUNG, wer))
 BEHERRSCHUNG += ([wer: "XYZ"]);                  // Ulitharid meldet sich nach Reset wieder an

if(BEHERRSCHUNG[wer]=="XYZ")                      // Ulitharid darf Spieler beherrschen
 {
  BEHERRSCHUNG[wer]=wen;		          // Master merkt sich, wer wen beherrscht
  save_object(ILLMASTER); 
  return 1;
 }

return 0;
}

string TopListe()
{
string temp;
string liste;
int i,j;
string *names;
names = allocate(sizeof(KILLS));


names = m_indices(KILLS);
write("================================\n");
write("= Die besten Illithiden-Jaeger =\n");
write("================================\n\n");

for (j=0;j<sizeof(KILLS);j++)
{
  for (i=j; i<sizeof(KILLS); i++)
   {
     if((KILLS[names[i]])<(KILLS[names[j]]))
     {
       temp=names[j];
       names[j]=names[i];
       names[i]=temp;
     }

   }
}

for (i=sizeof(KILLS)-1; i>=0; i--)
{
name_ausgeb(names[i]);
}

return "";
}

void name_ausgeb(string wer)
{
int j;

write(capitalize(wer));
    j=strlen(wer);                                  // zur Formatierung
    for(j; j<30 ; j++) write(" "); 
write(KILLS[wer]+"\n");
}

string DeadListe()
{
string temp;
string liste;
int i,j;
string *names;
names = allocate(sizeof(TODE));


names = m_indices(TODE);
write("=======\n");
write("= RIP =\n");
write("=======\n\n");

for (j=0;j<sizeof(TODE);j++)
{
  for (i=j;i<sizeof(TODE);i++)
   {
     if((TODE[names[i]])<(TODE[names[j]]))
     {
       temp=names[j];
       names[j]=names[i];
       names[i]=temp;
     }

   }
}

for (i=sizeof(TODE)-1; i>=0; i--)
{
dead_ausgeb(names[i]);
}
write("\nDas sind jetzt schon insgesamt "+SumDead()+" Todesfaelle!\n");
return "";
}

void dead_ausgeb(string wer)
{
int j;

write(capitalize(wer));
    j=strlen(wer);                                  // zur Formatierung
    for(j; j<30 ; j++) write(" "); 
write(TODE[wer]+"\n");
}

int SumDead()
{
int j,anzahl;
string *names;
names = allocate(sizeof(TODE));

names = m_indices(TODE);

for (j=sizeof(TODE)-1;j>=0;j--)
{
anzahl=anzahl+TODE[names[j]];  
}
return anzahl;
}

int KillLog(object wen, string wer)
{
int anzahl;
string uliname;
  
if (!member(KILLS, wer))
 KILLS += ([wer: 1]);
else
 {
   anzahl = KILLS[wer];
   KILLS += ([wer: anzahl+1]);
 }

// Wenn der NPC einen Spieler beherrscht, wird dieser nun befreit:

uliname=wen->Name();                                 
if (member(BEHERRSCHUNG, uliname))
 BEHERRSCHUNG -= ([ uliname ]);

 
save_object(ILLMASTER);                              // Liste soll rebootsicher sein !
return 1;
}

int DieLog(object wem, string wer)
{
int anzahl;
  
if (!member(TODE, wer))
 TODE += ([wer: 1]);
else
 {
   anzahl = TODE[wer];
   TODE += ([wer: anzahl+1]);
 }
 
save_object(ILLMASTER);                             // Liste soll rebootsicher sein !
return 1;
}

void delbeh()
{
BEHERRSCHUNG = ([ ]); 
save_object(ILLMASTER); 
write("Mapping BEHERRSCHUNG im Master geloescht!\n");
}

void reset()
{
BEHERRSCHUNG = ([ ]); 
if(find_player("zaknafein")) tell_object(find_player("zaknafein"), 
  break_string("--->  R E S E T  <---", 78, "ILLMASTER: "));
save_object(ILLMASTER); 
}