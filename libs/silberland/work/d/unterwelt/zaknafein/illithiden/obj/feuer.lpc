/*
**                    Feuer fuer die Illithidenquest
**                       Zaknafein, Februar 2000
**
*/

inherit "/std/thing";

#include <thing.h>
#include <properties.h>
#include <language.h>
#include "../files.h"

void init()
{

  ::init();
  if(interactive(environment(this_object()))) set_heart_beat(1);
  else set_heart_beat(0);
  return;
}

create()
{
  if (!is_clone(this_object()))
     return;
 ::create();

  SetProp(P_SHORT, "Eine hell leuchtende Flamme");
  SetProp(P_LONG, "Die Flamme ist sehr heiss. Du solltest sie nicht zu "
                 +"lange tragen, wenn Du nicht sterben willst.\n");
  SetProp(P_NAME, "Flamme");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "flamme" , "\nzakfeuer" }) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_FIRE);
  SetProp(P_KILL_NAME, "Offenes Feuer" );
}

heart_beat()
{
environment()->do_damage(random(5));
}

