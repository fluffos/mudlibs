inherit "/std/thing";

#include <thing.h>
#include <properties.h>
#include <language.h>
#include "../files.h"

void init()
{

  ::init();
  if(interactive(environment(this_object()))) set_heart_beat(1);
  else set_heart_beat(0);
  return;
}

create()
{
  if (!is_clone(this_object()))
     return;
 ::create();

  SetProp(P_SHORT, "Extrem kaltes Eis");
  SetProp(P_LONG, "Du willst das Eis nur moeglichst schnell loswerden. "
                 +"Brrrr, ist das kalt! Lege es schnell ab, bevor Du "
                 +"noch erfrierst!\n");
  SetProp(P_NAME, "Eis");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "eis" , "\nzakeis" }) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_ICE);
  SetProp(P_KILL_NAME, "Eisige Kaelte" );
}

heart_beat()
{
environment()->do_damage(random(5));
}
