/*
**  Das Questitem fuer die Illithiden-Quest (unsichtbar) 
**
**  Zaknafein, Mai 2001
*/

inherit "std/thing";
#include <properties.h>
#include <language.h>

int gehirntot=0;
int masojfolgt=0;
int krautgegessen=0;
int schutzweg=0;
int schale=0;
int aufgabe=0;

void create()
{
if (!is_clone(this_object())) return; 

::create();

AddId("\niquestitem");
SetProp(P_SHORT, 0);
SetProp(P_NAME, "Questitem fuer die Illithiden-Quest");
SetProp(P_GENDER, NEUTER);
SetProp(P_NOSELL, 1);
SetProp(P_NOBUY, 1);
SetProp(P_NODROP, 1);
SetProp(P_WEIGHT, 0);
SetProp(P_NEVERDROP, 1);
SetProp(P_VALUE, 0);

}

// Kraut gegessen?

querykrautgegessen()
{
return krautgegessen;
}


krautgegessenein()
{
krautgegessen=1;
return;
}

krautgegessenaus()
{
krautgegessen=0;
return;
}

// Schalen, die das Herz schuetzen

queryschale()
{
return schale;
}

schaleweg()
{
schale=schale + 1;
}

// Herz der Illithiden getoetet?

queryschutzweg()
{
return schutzweg;
}

schutzwegein()
{
schutzweg=1;
return;
}

schutzwegaus()
{
schutzweg=0;
return;
}

// Elder Brain tot?

querygehirntot()
{
return gehirntot;
}

gehirntotein()
{
gehirntot=1;
return;
}

gehirntotaus()
{
gehirntot=0;
return;
}

// Aufgabe von Masoj bekommen?

queryaufgabe()
{
return aufgabe;
}

aufgabeein()
{
aufgabe=1;
return;
}

aufgabeaus()
{
aufgabe=0;
return;
}

// Folgt Masoj dem Spieler?

querymasojfolgt()
{
return masojfolgt;
}


masojfolgtein()
{
masojfolgt=1;
return;
}

move(dest,meth) 
{
  mixed res;
  while (remove_call_out("try_remove")!=-1) ;
  res=::move(dest,meth);
  if (!environment() || !living(environment()))
    call_out("try_remove",30);
  return res;
}

try_remove() {
  if (!environment() || !living(environment())) 
    {
      remove();
    }
}

