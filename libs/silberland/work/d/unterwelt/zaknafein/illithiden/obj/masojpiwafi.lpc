/*
**  Masojs Piwafi
**  Zaknafein, August 2001
**
*/

inherit "std/thing";
#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
 ::create();


  SetProp(P_SHORT, "Masojs Piwafi");
  SetProp(P_LONG,
    "Dieser Piwafi gehoert Masoj. Es ist ein dunkler Umhang aus Seide.\n");
  SetProp(P_NAME, "Piwafi");
  SetProp(P_GENDER, MALE);
  AddId( ({ "\nzakpiwafi" , "piwafi" , "umhang" }) );
  SetProp(P_NODROP, "Nein, den braucht Masoj ganz dringend!\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MATERIAL, MAT_SILK);
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 5000);
}
