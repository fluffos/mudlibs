/*
**           Hammer zum Abbrechen von Gestein im Steinbruch der Illithiden
**
**                             Zaknafein, Februar 2000
*/

inherit "std/weapon";

#include <properties.h>     
#include <combat.h>        
#include <language.h>      

create()
{

  if (!is_clone(this_object()))
     return;

  ::create();   

  SetProp(P_SHORT, "Ein schwerer Hammer");
  SetProp(P_LONG, "Dieser Hammer eignet sich aufgrund seiner Schwere und seiner Stabilitaet "
                 +"auzgezeichnet zum Abbrechen von Gestein. Sehr wertvoll ist er aber wohl "
                 +"nicht. Am Griff klebt noch Schweiss und Blut.\n");
  SetProp(P_NAME, "Hammer");
  SetProp(P_GENDER, MALE);
  AddId( ({ "\nzakhammer" , "hammer" }) );
  SetProp(P_VALUE, 800);
  SetProp(P_WEIGHT, 1400);  
  SetProp(P_MATERIAL, ([MAT_MISC_METAL:20, MAT_MISC_WOOD:80])); 
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_WC, 125);
  SetProp(P_NR_HANDS, 2);
}
