/*
**  unsichbares Item, das den richtigen Weg zum Gehirn festlegt
**
**  Zaknafein, Mai 2001
*/

inherit "std/thing";
#include <properties.h>
#include <language.h>

int eb1=random(8);
int eb2=random(4);
int eb3=random(4);

void create()
{
if (!is_clone(this_object())) return; 

::create();


AddId("\nwegitem");
SetProp(P_SHORT, 0);
SetProp(P_NAME, "Item fuer die Illithidenburg - NICHT ENTFERNEN!");
SetProp(P_GENDER, NEUTER);
SetProp(P_NOSELL, 1);
SetProp(P_NOBUY, 1);
SetProp(P_NODROP, 1);
SetProp(P_WEIGHT, 0);
SetProp(P_NEVERDROP, 1);
SetProp(P_VALUE, 0);


AddCmd( "showvars", "show"); // fuer Debug-Zwecke

AddCmd( "neuvars", "neu");   // fuer Debug-Zwecke
}

queryeb1()
{
return eb1;
}

queryeb2()
{
return eb2;
}

queryeb3()
{
return eb3;
}

show( str )
{
write("Ausgang Ebene 1: "+eb1+"\n");
write("Ausgang Ebene 2: "+eb2+"\n");
write("Ausgang Ebene 3: "+eb3+"\n");
return 1;	
}

neu( str )
{
eb1=random(8);
eb2=random(4);
eb3=random(4);
write("Ausgang Ebene 1: "+eb1+"\n");
write("Ausgang Ebene 2: "+eb2+"\n");
write("Ausgang Ebene 3: "+eb3+"\n");
return 1;	
}