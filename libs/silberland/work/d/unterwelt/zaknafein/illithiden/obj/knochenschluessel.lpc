/*
**   Knochenschluessel fuer das Burgtor
**
**   Zaknafein Mai 2001
*/

inherit "/std/thing";

#include <thing.h>
#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();   

SetProp(P_NAME,"Knochenschluessel");
SetProp(P_SHORT,"Ein schwerer Knochenschluessel");
SetProp(P_LONG,"Ein schwerer Schluessel aus Knochen fuer das Tor der Illithidenburg.");
SetProp(P_GENDER, MALE);
SetProp(P_WEIGHT, 530);
SetProp(P_MATERIAL, MAT_BONE);
AddId( ({ "schluessel" , "knochenschluessel" }) );
}
string QueryDoorKey()
     {
       return id_knochenschluessel;
     }
