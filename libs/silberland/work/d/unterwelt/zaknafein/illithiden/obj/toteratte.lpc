inherit "std/food";

#include <properties.h>
#include <food.h>

void create()
{
if (!is_clone(this_object())) return;
::create();

SetProp(P_SHORT, "Eine tote Ratte");
SetProp(P_LONG,
"In Deinen Haenden haeltst Du die Ueberreste einer Ratte. Ob Du sie wirklich essen solltest?\n");
SetProp(P_NAME, "Rattenleiche");
SetProp(P_VALUE, 0);
AddId(({"ratte", "leiche"}));
SetProp(P_WEIGHT, 100);
SetProp(P_FOOD_INFO, ([F_HEAL : ({30, 20}), F_SOAK : 2]));
}

void BeimEssen()
{
write("Du wuergst die Ratte runter. Buah, das schmeckte eckelhaft!\n");
say(capitalize(this_player()->query_real_name())
     +" wuergt eine tote Ratte runter und verzieht dabei das Gesicht.\n", ({ this_player() }) );
}
