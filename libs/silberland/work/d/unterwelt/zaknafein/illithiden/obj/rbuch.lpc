/*
**        Dieses Buch liefert wertvolle Informationen und ist ausserdem
**        eine Art Schluessel zu dem Raum, in dem sich die Hexe befindet.
**
**                           Zaknafein, Februar 2000
**
*/

inherit "/std/thing";

#include <thing.h>
#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
     return;
 ::create();


  SetProp(P_SHORT, "Ein rotes Buch");
  SetProp(P_LONG, "Du betrachtest das rote Buch naeher. Auf dem Einband steht in "
                 +"goldenen Buchstaben geschrieben: Manipulation von Gegenstaenden.\n");
  SetProp(P_NAME, "Buch");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "buch" , "\nzakrbuch" }) );
  AddAdjective( ({ "rote" , "rotes" }) );
  AddDetail( ({ "einband" , "buchstaben" }) ,
    "Hm, vielleicht sollte man mal einen Blick in das Buch werfen.\n" );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 10000);
  SetProp(P_NODROP, "Nein, stelle das Buch lieber wieder zurueck.\n");
  SetProp(P_MATERIAL, MAT_PAPER);
  AddCmd( ({ "lese" , "les" , "lies" })  , "lesen");
}

lesen(str)
{
if (str=="buch" || str=="rotes buch" || str=="rote buch" || str=="buch rot" )
  {
  write(BKS("Du blaetterst das Buch durch und findest tatsaechlich "
           +"eine Seite, die Dich interessiert. Dort wird beschrieben, "
           +"wie man mit Hilfe spezieller Kraeuter und weisser Magie "
           +"Gegenstaende entfluchen kann. Du solltest unbedingt die "
           +"Hexe, die hier wohnt, danach fragen.\n"));
  return 1;
  }
return 0;
}