/*
**  Eines von Masojs Schwertern (rechte Hand)
**  Zaknafein, August 2001
**
*/

inherit "std/thing";
#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
 ::create();


  SetProp(P_SHORT, "Masojs Krummschwert fuer die rechte Hand");
  SetProp(P_LONG,
    "Dies ist eines der beiden von Masoj. Nur ein wahrer Schwertmeister kann zweihaendig kaempfen!\n");
  SetProp(P_NAME, "Krummschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "\nzakschwerta" , "krumschwert" , "schwert"}) );
  SetProp(P_NODROP, "Nein, das braucht Masoj ganz dringend!\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MATERIAL, MAT_IRON);
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 5000);
}
