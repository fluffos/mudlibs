inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../files.h"

void create()
{
if (!is_clone(this_object())) return;
::create();

SetProp(P_SHORT, "Ein undefinierbares Kraut");
SetProp(P_LONG,
"Das Kraut sieht recht eigenartig aus. Was das wohl sein kann?\n");
SetProp(P_NAME, "Kraut");
SetProp(P_VALUE, 12000);
AddId(({ "spice" , "kraut", "\nzakkraut"}));
SetProp(P_NODROP, "Nein, das Kraut brauchst Du noch!\n");

SetProp(P_WEIGHT, 1);
SetProp(P_FOOD_INFO, ([F_HEAL : ({0, 0}), F_SOAK : 1]));
}

void BeimEssen()
{
object ob;
write(BKS("Du isst das Spice. Ploetzlich wirst Du ganz durstig.\n"));
if (ob=present(("\niquestitem"), this_player())) ob->krautgegessenein();
say(this_player()->name()+" isst ein Kraut. Merkwuerdig: Er wirkt ploetzlich ganz durstig.\n" , ({ this_player() }) );
}
