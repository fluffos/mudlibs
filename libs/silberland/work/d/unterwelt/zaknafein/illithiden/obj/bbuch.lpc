/*
**        Dieses Buch liefert wertvolle Informationen und ist ausserdem
**        eine Art Schluessel zu dem Raum, in dem sich die Hexe befindet.
**
**                           Zaknafein, Februar 2000
**
*/

inherit "/std/thing";

#include <thing.h>
#include <properties.h>
#include <language.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object()))
     return;
 ::create();


  SetProp(P_SHORT, "Ein blaues Buch");
  SetProp(P_LONG, "Du wirfst einen Blick auf den Einband des blauen Buches. "
                 +"Es traegt den Titel 'Geheimnisse der Illithiden'.\n");
  SetProp(P_NAME, "Buch");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "buch" , "\nzakbbuch" }) );
  AddAdjective( ({ "blaue" , "blaues" }) );
  AddDetail( ({ "einband" , "titel" }) ,
    "Dieses Buch enthaelt bestimmt wertvolle Informationen.\n" );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 10000);
  SetProp(P_NODROP, "Nein, stelle das Buch lieber wieder zurueck.\n");
  SetProp(P_MATERIAL, MAT_PAPER);
  AddCmd( ({ "lese" , "les" , "lies" })  , "lesen");
}

lesen(str)
{
if (str=="buch" || str=="blaues buch" || str=="blaue buch" || str=="buch blau" )
  {
  write(BKS("Das Buch hat ueber tausend Seiten. Du kannst es unmoeglich "
           +"jetzt durchlesen. Auf einer Seite scheint jedoch etwas sehr "
           +"wichtiges zu stehen:\n"));
  write(BKS("Das Zentalgehirn ist das Herz der Illithidengemeinde. Jeder "
           +"Illithid steht mit ihm in staendiger telepathischer Verbindung. "
           +"Es koordiniert alle Aktionen und speichert das Wissen und die "
           +"die Erfahrungen, die Generationen von Illithiden im Laufe von "
           +"Aeonen angesammelt haben. Es kann nur vernichtet werden, wenn "
           +"seine Verbindung zu den astralen Ebenen unterbrochen wird. "
           +"Hierfuer ist es erforderlich, selbst zu den astralen Ebenen, die "
           +"im Grunde eine parallele Dimension darstellen, zu wechseln, "
           +"wofuer ein sehr seltenes Kraut, das 'Spice', benoetigt wird.\n"));
 write(BKS("Du hast genug gelesen und beschliesst, die Hexe nach dem Kraut "
          +"zu fragen.\n"));
  return 1;
  }
return 0;
}