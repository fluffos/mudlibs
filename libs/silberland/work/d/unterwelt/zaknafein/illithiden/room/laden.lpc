/*
** Laden im Haus der Hexe (benoetigt 'storroom' als Lager)
**
** Zaknafein, August 2001
*/

#include "../files.h"
inherit "std/laden";

#include <properties.h>
#include <laden.h>

create()
{
  ::create();
  SetProp (P_INT_SHORT, "Im Laden der Kraeuterhexe Farima");
  SetProp (P_INT_LONG,
    "Du stehst nun im Laden der Kraeuterhexe und schaust dich genau um. Zahlreiche Regale, "
   +"die mit allerlei Geruempel vollgestopft sind, stehen um dich herum. Auf der "
   +"Verkaufstheke sitzt eine gruene Kroete, die dich mit ihren kleinen Augen aufmersam "
   +"anschaut. An einer Wand haengt eine Tafel.");

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:18]));

  SetStorageRoom(ROOM("storroom"));

/*
  --------= Kein Shop-Keeper =----------  

  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);

  SetProp(P_SHOPKEEPER_ID, "");
  SetProp(P_SHOPKEEPER_NAME, "");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
*/

  AddDetail("tafel",
    "Du kannst die Tafel lesen.");
  AddDetail( ({ "kroete" , "gehilfe" }),
    "Die kleine Kroete erledigt wohl fuer die Hexe die Geschaefte hier im Laden. "
   +"Sie ist gruen und mit Warzen uebersaet.");
  AddDetail( ({ "warzen" , "warze" }),
    "Uh, hoffentlich ist das nicht ansteckend!");
  AddDetail( ({ "geschaefte" , "laden" , "geschaeft" }),
    "Du wuerdest keiner Kroete dein Geschaeft anvertrauen...");
  AddDetail( "geruempel" ,
    "Moechtest du nicht etwas von dem Geruempel kaufen?");
  AddDetail( ({ "regale" , "regal" }),
    "Man kann die Regale vor lauter Geruempel kaum erkennen.");
  AddDetail( ({ "hexe" , "kraeuterhexe" }),
    "Der Hexe gehoert der Laden.");
  AddDetail( ({ "theke" , "verkaufstheke" }),
    "Die Kroete auf der Theke passt genau auf, was du hier machst.");
  AddDetail( ({ "wand" , "waende" }),
    "Die Waende sind mit Regalen vollgestellt.");
  AddDetail( ({ "decke" , "boden" }),
    "Boden und Decke bestehen aus Holz.");
  AddDetail( ({ "augen" , "auge" }),
    "Es sind kleine Augen, die irgendwie intelligent wirken.");
  AddDetail( "holz" ,
    "Pechschwarzes, extrem hartes Holz.");
  AddDetail( ({ "" , "" }),
    "");
  AddDetail( ({ "" , "" }),
    "");
  AddDetail( ({ "" , "" }),
    "");
  AddDetail( ({ "" , "" }),
    "");


  AddSmell( DEFAULT_SMELL , "Auch hier im Laden kann man noch den intensiven Geruch der Kraeuter "
                           +"im Nebenraum wahrnehmen.\n");
  AddSmell( ({ "kraeuter" , "kraeutern" , "duft" , "geruch" , "nebenraum" }) ,
            "Du empfindest den Geruch als sehr angenehm.\n"); 
  AddSound( DEFAULT_SOUND , "Es ist recht still hier.\n");

  AddReadDetail ("tafel",
    "Verfuegbare Befehle:\n"+
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"+
    "<unt> nummer      Gibt eine Beschreibung eines Gegenstands der Liste aus\n"+
    "<kaufe> nummer oder\n"+
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"+
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"+
    "<versetze> etwas  Du verkaufst einen Gegenstand, egal wieviel der\n"+
    "                  Haendler dafuer bezahlt.\n"+
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"+
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");

//  AddItem (NPC "", REFRESH_DESTRUCT);
  
  AddExit ("sueden", ROOM("haus2"));
}
