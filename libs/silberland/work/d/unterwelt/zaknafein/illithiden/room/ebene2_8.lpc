create()
{
  ::create();


 AddItem(NPC("vampill"), REFRESH_DESTRUCT, ([ P_MNPC_DEFAULTROOM : ROOM("ebene2_8"), 
			                        P_MNPC_AREA : ROOM("ebene2") ]) );
  AddExit("nordosten", ROOM("ebene2_9"));
  AddExit("nordwesten", ROOM("ebene2_7"));
}