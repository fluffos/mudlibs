/*     
**                 Astralebene
**
**            Zaknafein, Februar 2000
**
*/

inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20,ENV_TERRAIN:TT_OTHER])); 
  SetProp(P_INT_SHORT, "Auf einer astralen Ebene" );
  SetProp(P_INT_LONG,
    "Entsetzt schaust Du Dich um und strampelst wild den Beinen, die "
   +"einfach keinen festen Halt finden wollen. Nur langsam beruhigst Du "
   +"Dich wieder und stellst fest, dass Du im absoluten Nichts schwebst. "
   +"Als Du Dich etwas umschaust erkennst Du ein merkwuerdiges Gebilde, " 
   +"das direkt neben Dir schwebt.\nIrgendwie fuehlst Du Dich nach "
   +"Nordosten und Nordwesten hingezogen.");

  AddDetail( ({ "himmel" , "waende" , "wand" , "boden" , "decke" }) ,
    "Das Nichts hat sowas nicht!\n");
  AddDetail( "nichts",
    "Wenn man es genau nimmt, kann man das 'Nichts' nicht sehen.\n");
  AddDetail( "halt" ,
    "Du findest hier keinen Halt, da es hier keinen Boden gibt. "
   +"Was Dich nun aber wenig stoert, da Du Dich mittlerweile daran "
   +"gewoehnt hast zu schweben.\n");
  AddDetail( ({ "beine" , "beinen" , "bein" }) ,
    "Du blickst durch Deine Beine hindurch auf ein merkwuerdiges Gebilde.\n");
  AddDetail("luft"  ,
    "Luft gibt es hier wohl. Du kannst ja schliesslich atmen.\n");
  AddSpecialDetail( "gebilde" , "gebilde_schau");
  AddSpecialDetail( "herz" , "herz_schau");
  AddSpecialDetail( ({ "eis" , "feuer" , "feuerschale" , "schalen" ,  
                       "eisschale" , "schale" }), "schalen_schau");

  AddSmell( DEFAULT_SMELL , "Du riechst absolut nichts.\n");
  AddSound( DEFAULT_SOUND , "Du hoerst absolut nichts.\n");

AddCmd( ({ "kuehl" , "kuehle" }) , "kuehlen" );
AddCmd( ({ "erhitze" , "erhitz" }) , "erhitzen" ); 
AddCmd( ({ "steche" , "stech" }) , "stechen" ); 

AddSpecialExit("nordwesten" , "nw" );
AddSpecialExit("nordosten" ,  "no" );

} 

nw()
{
write("Du fliegst nach Nordwesten.\n");
this_player()->move(ROOM("aebene2"), M_GO , "" ,
       "fliegt nach Nordwesten", 
       "kommt hereingeflogen");
return 1;
}

no()
{
write("Du fliegst nach Nordosten.\n");
this_player()->move(ROOM("aebene3"), M_GO , "" ,
       "fliegt nach Nordosten", 
       "kommt hereingeflogen");
return 1;
}

gebilde_schau()
{
object ob;
if (ob=present(("\niquestitem"), this_player()))
{

  if(ob->queryschale()==0)
  {
    write(BKS("Neben Dir schwebt ein merkwuerdiges Gebilde. Es ist "
             +"von einer Schale aus Feuer umgeben, so dass Du nicht "
             +"genau erkennen kannst, worum es sich handelt. Wenn Du "
             +"die Feuerschale nur irgendwie abkuehlen koenntest...\n"));

  }

  if(ob->queryschale()==1)
  {
    write(BKS("Die Feuerschale ist nun verschwunden und gab damit den Blick "
             +"auf eine zweite Schale, eine Schale aus extrem hartem Eis frei. "
             +"Du musst etwas finden, womit Du das Eis erhitzen und zum "
             +"Schmelzen bringen kannst. Nur so wirst Du an das gelangen "
             +"koennen, was sich unter den Schalen verbirgt.\n"));

  }

  if(ob->queryschale()==2)
  {
    write(BKS("Jetzt, da Du auch die letzte Schale entfernt hast, kannst Du endlich "
             +"erkennen, was unter ihnen verborgen war. Es ist ein monstroeses "
             +"Herz, das rythmisch pulsiert. Schwach und verletzlich schwebt es nun "
             +"direkt neben Dir.\n"));
  }
  
  if(ob->queryschale()==3)
  {
    write(BKS("Neben Dir schwebt ein totes Herz.\n"));
  }
}
else
{
write(BKS("Urgs, Dein Questitem fehlt! Wie bist Du nur hierhergekommen? "
         +"Wende Dich bitte sofort an einen Magier! Moeglichst an Zaknafein, "
         +"wenn er da ist.\n"));
}
return "";
}

schalen_schau()
{
object ob;
if (ob=present(("\niquestitem"), this_player()))
{

  if(ob->queryschale()==0)
  {
    write(BKS("Du erblickst eine undurchdringbare Feuerschale. Vielleicht "
             +"laesst sie sich zerstoeren, indem man sie abkuehlt?\n"));

  }

  if(ob->queryschale()==1)
  {
    write(BKS("Eisige kaelte geht von dieser Eisschale aus. Du bist Dir "
             +"sicher, dass man sie durch Erhitzen zum Schmelzen bringen "
             +"kann.\n"));

  }

  if(ob->queryschale()>1)
  {
    write(BKS("Die Schalen wurden von Dir schon zerstoert.\n"));
  }

}
else
{
write(BKS("Urgs, Dein Questitem fehlt! Wie bist Du nur hierhergekommen? "
         +"Wende Dich bitte sofort an einen Magier! Moeglichst an Zaknafein, "
         +"wenn er da ist.\n"));
}
return "";
}

herz_schau()
{
object ob;
if (ob=present(("\niquestitem"), this_player()))
{

  if(ob->queryschale()==2)
  {
    write(BKS("Schwach und zerbrechlich schwebt das Herz neben Dir. "
             +"Du musst es jetzt nur noch toeten.\n"));

  }

  if(ob->queryschale()==3)
  {
    write(BKS("Ein totes Herz schwebt neben Dir. Du hast ganze Arbeit "
             +"geleistet!\n"));

  }
  
  if(ob->queryschale()<2)
    write("Hier ist kein Herz. Wie kommst Du nur darauf?\n");

}
else
{
write(BKS("Urgs, Dein Questitem fehlt! Wie bist Du nur hierhergekommen? "
         +"Wende Dich bitte sofort an einen Magier! Moeglichst an Zaknafein, "
         +"wenn er da ist.\n"));
}
return "";
}

kuehlen(str)
{
notify_fail( "Was moechtest Du denn womit abkuehlen?\n");
if( str == "schale mit eis ab" || str == "gebilde mit eis ab" || str == "schale mit eis" || str == "gebilde mit eis" )
{
  object ob;
  object obj;
  if (ob=present(("\niquestitem"), this_player()))
  {
    if(ob->queryschale()==0)
    {
       if (obj=present(("\nzakeis"), this_player()))
       {
         write(BKS("Du wirfst das Eis auf die Schale. Unter einem lauten "
                  +"Zischen verschwindet die Feuerschale.\n"));
         ob->schaleweg();
         obj->remove();
       }
       else write("Aber Du hast kein Eis!\n");
    }
    else write("Du musst hier nichts abkuehlen.\n");
  }
  else write("Du hast kein Questitem?!\n");
return 1;
}
return 0;
}

erhitzen(str)
{
notify_fail( "Was moechtest Du denn womit erhitzen?\n");
if( str == "schale mit flamme" || str == "gebilde mit flamme" )
{
  object ob;
  object obj;
  if (ob=present(("\niquestitem"), this_player()))
  {
    if(ob->queryschale()==1)
    {
       if (obj=present(("\nzakfeuer"), this_player()))
       {
         write(BKS("Du haeltst die Flamme an die Schale, so dass sie "
                  +"schmilzt.\n"));
         ob->schaleweg();
         obj->remove();
         clone_object(NPC("herz"))->move(this_object(), M_NOCHECK);
       }
       else write("Aber Du hast doch keine Flamme!\n");
    }
    else write("Du musst hier nichts erhitzen.\n");
  }
  else write("Du hast kein Questitem?!\n");
return 1;
}
return 0;
}
