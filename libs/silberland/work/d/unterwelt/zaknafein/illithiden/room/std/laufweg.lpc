// Standardraum fuer den Laufweg der Sklaven
// Zaknafein, Januar 2003

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>

void create()
{

   ::create();

  SetProp( P_INT_SHORT, "Laufweg der Sklaven");

  SetProp( P_INT_LONG, "Du gehst den langen, schmalen Laufweg, der sich schraubenartig um die "
                      +"Burg der Illithiden nach oben windet, entlang. Dieser Weg wird von den "
                      +"Sklavenarbeitern benutzt, um das Aeussere der Burg zu bearbeiten. "
                      +"Er wurde direkt aus dem Fels des Stalagmiten geschlagen. Auf einer "
                      +"Seite klafft ein tiefer Abgrund. "
                      +"Von dieser Stelle des Laufweges aus kannst du nach "
                      +"@@ausgaenge_str@@"
                      +"gehen.");


  SetProp (P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "seite" , "abgrund" })  ,
    "Es geht sehr steil hinab. Du kannst nur Dunkelheit erkennen!\n");
  AddDetail( "dunkelheit",
    "Aufrund der Dunkelheit kannst Du nicht genau erkennen, wie tief "
   +"der Abgrund ist.\n" );
  AddDetail( "boden",
    "Der Boden ist mit Schotter bedeckt. Man kann leicht ins Rutschen kommen.\n" );
  AddDetail( ({ "schotter" , "geld" })  ,
    "Nein! Geld ist nicht gemeint, sondern einfach nur kleine Steine.\n" );
  AddDetail( ({ "stein" , "steine" })  ,
    "Man koennte auch Schotter dazu sagen...\n" );
  AddDetail( "rutschen",
    "Das waere Dein Tod!\n" );
  AddDetail( "tod",
    "Der Tod lauert hier ueberall!\n" );
  AddDetail( ({ "laufweg" , "weg" , "weges" })  ,
    "Man sollte sich hier nur langsam bewegen, da der Boden mit Schotter "
   +"bedeckt ist und es an einer Seite des Weges toedlich steil hinabgeht.\n" );
  AddDetail( ({ "decke" , "himmel" })  ,
    "Du kannst die Decke nicht erkennen.\n" );
  AddDetail( "hoehle",
    "Du befindest Dich in einer riesigen Höhle.\n" );
  AddDetail( ({ "illithid" , "illithiden" })  ,
    "Die Illithiden bewachen die Sklaven.\n" );
  AddDetail( ({ "sklaven" , "sklavenarbeiter" , "sklavenarbeitern" , "arbeiter"})  ,
    "Die Sklaven bearbeiten das Aeussere der Burg.\n" );
  AddDetail( "aeussere",
    "Du befindest Dich ausserhalb der Burg.\n" );
  AddDetail( ({  "burg", "stalagmiten" , "stalagmit" }) , 
    "Die Burg wird aus einem riesigen Stalagmiten geschlagen.\n" );
  AddDetail( "stelle",
    "Vielleicht solltest Du lieber weitergehen, bevor Dich ein Illithid bemerkt.\n" );
  AddDetail( ({ "fels" , "gestein" })  ,
    "Der Stalagmit besteht aus hartem Fels.\n" );
  AddDetail( ({ "wand" , "waende" })  ,
    "Unzaehlige Sklaven bearbeiten die aeussere Wand der riesigen Burg.\n" );
  AddDetail( "wind" ,
    "Sehen kannst Du den Wind nicht, aber spueren. Sehr kalt.\n" );
  AddDetail( "ohren",
    "Da Du keinen Spiegel hast, kannst Du Deine Ohren nicht sehen. "
   +"Du koenntest sie Dir jedoch abschneiden, dann waere es auch so moeglich.\n" );
  AddDetail( "spiegel",
    "Hast Du etwa einen dabei?\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );


  AddSmell( DEFAULT_SMELL , "Es weht ein frischer Wind, der vollkommen geruchslos ist.\n");
  AddSmell( "wind" , "Der Wind vertreibt den Schweissgeruch der Sklaven.\n");
  AddSmell( ({ "schweiss" , "geruch" , "schweissgeruch" }) , "Du kannst keinen Schweissgeruch wahrnehmen.\n");
  AddSound( DEFAULT_SOUND , "Du hoerst das laute Haemmern der Sklaven. Es verstummt wohl nie.\n");
  AddSound( "haemmern", "Du solltest Dir vielleicht die Ohren zuhalten.\n");

}
string ausgaenge_str()
{
int i;
string *h_ausgaenge_a;
string *ausgaenge_a;

h_ausgaenge_a = allocate(sizeof(QueryProp(P_HIDE_EXITS)));
ausgaenge_a = allocate(m_sizeof(QueryProp(P_EXITS)));

h_ausgaenge_a=QueryProp(P_HIDE_EXITS);
ausgaenge_a = m_indices(QueryProp(P_EXITS));

  for (i=0;i<sizeof(h_ausgaenge_a);i++)
   {
        ausgaenge_a -= ({ h_ausgaenge_a[i] });
   }

if(sizeof(ausgaenge_a)==2)
 return ausgaenge_a[0]+" und nach "+ausgaenge_a[1]+"\n";
else 
 return ausgaenge_a[0]+" ";
}

