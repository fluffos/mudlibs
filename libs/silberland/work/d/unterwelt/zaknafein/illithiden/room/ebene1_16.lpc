/* Ebene 1 Raum 16  
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDEBENE1;

#include <properties.h>
#include <moving.h>

create()
{
  ::create();


  AddSpecialExit( "nordwestoben" , "nwobfkt" );
  AddSpecialExit( "nwoben" , "nwobfkt" );
  AddSpecialExit( "nwob" , "nwobfkt" );
  AddExit("nordosten", ROOM("ebene1_17"));
  AddExit("suedwesten", ROOM("ebene1_15"));
  SetProp(P_HIDE_EXITS, ({"nwoben" , "nwob" }) );
}

nwobfkt()
{
   object ob;
   if (ob=present(("\nwegitem"), this_player()))
    {
      if(ob->queryeb1()==5)
       {
         this_player()->move(ROOM("ebene2_11"), M_GO , "" , "geht nach nordwestoben" , "kommt herein");
         return 1;
       }
    }
   this_player()->move(ROOM("ebene1_"+to_string(random(24))), M_GO , "" , "verschwindet ploetzlich" , "erscheint ploetzlich");
   return 1;
}