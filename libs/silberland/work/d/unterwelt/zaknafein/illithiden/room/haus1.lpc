/*     
**                 Haus der Hexe
**
**            Zaknafein, Februar 2000
**
*/

inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

int rbuch=0;  // 0: blaues Regal , 1: rotes Regal , 2: in keinem Regal
int bbuch=1;  

create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20,ENV_TERRAIN:TT_HOUSE])); 
  SetProp(P_INT_SHORT, "Im Haus einer Hexe" );
  SetProp(P_INT_LONG,
    "Du stehst nun im Inneren der Holzhuette. Der Holzboden knarrt laut "
   +"unter Deinen Fuessen, wenn Du Dich bewegst und unterbricht damit "
   +"die Stille, die den Raum beherrscht. Stille? Nein, nicht ganz, leises "
   +"brodeln ertoent aus einem kupfernen Kessel, der in der Mitte des Raumes" 
   +" auf einem Ofen steht. Im Osten fuehrt eine Tuer in einen weiteren "
   +"Raum. Neben der Tuer stehen zwei Regale. ");

  AddDetail( "decke" ,
    "Die Decke besteht aus Holz.\n");
  AddDetail( ({ "wand" , "waende" }) ,
    "Die Waende sind nicht sonderlich interessant.\n");
  AddDetail( "farbe" ,
    "Buecher nach der Farbe zu sortieren... Ziemlich bloed, was?\n");
  AddDetail( "holz" ,
    "Ganz normales Holz.\n");
  AddDetail( "ofen" ,
    "Der Ofen ermoeglicht es, den Kessel zu erhitzen.\n");
  AddDetail( "mitte" ,
    "Dort steht ein Kessel. Der Boden um den Kessel sieht etwas "
   +"abgenutzt aus.\n");
  AddDetail( ({ "fuessen" , "fuesse" }) ,
    "Zaehle mal, ob Du noch beide hast...\n");
  AddDetail( "stille" ,
    "Pssst, lausche mal.\n");
  AddDetail( "raum"  ,
    "Du siehst nur den Raum, in dem Du stehst.\n");
  AddDetail(  "kessel"  ,
    "In dem Kessel brodelt eine merkwuerdige Fluessigkeit vor sich hin, "
   +"die stark nach Kraeutern riecht.\n");
  AddDetail( "fluessigkeit"  ,
    "Die Fluessigkeit sieht nicht sehr appetitlich aus. Koennten das Augen "
   +"und Hahnenfuesse sein, die darin herumschwimmen?\n");
  AddDetail( ({ "hahnenfuesse" , "augen" })  ,
    "Ja, sieht so aus. *wuerg*\n");
  AddDetail( "kupfer"  ,
    "Ja, es sieht wie Kupfer aus.\n");
  AddDetail( ({ "inneren" , "huette" , "holzhuette" }) ,
    "Ob hier die Hexe wohnt, von der man Dir erzaehlte? Du musst sie "
   +"unbedingt finden!\n");
  AddDetail( ({ "boden" , "holzboden" }) ,
    "Der Holzboden um den Kessel herum ist ziemlich abgenutzt. Koennten "
   +"dies Spuren eines Hexentanzes sein?\n"); 
  AddDetail( ({ "spur" , "spuren" , "tanz" , "hexentanzes", "hexentanz" }) ,
    "Doch, doch, es sind bestimmt Spuren eines Hexentanzes. Du bist Dir da "
   +"ziemlich sicher.\n");  
  AddDetail( "hexe" ,
    "Ein grosser Kessel, der nach verschiedenen Kraeutern duftet und "          +"Spuren, die auf einen Hexentanz hindeuten... Kombiniere: Hier "
   +"wohnt eine Hexe! Wo mag sie nur sein? Hinter der Tuer vielleicht?\n"); 
  AddDetail( "regale" ,
    "In den Regalen stehen uralte Buecher. Eines der Regale ist blau. "
   +"Das andere ist rot.\n");
  AddDetail( "buecher" ,
    "In dem roten Regal stehen rote Buecher und im blauen Regal blaue. "
   +"Hm, warum sortiert jemand seine Buecher nach der Farbe? Schau "
   +"Dir besser mal die Regale genauer an.\n"); 
  AddDetail( "buch" ,
    "Schau Dir mal die Regale genauer an. Wenn Dich ein bestimmtes Buch "
   +"interessiert, kannst Du es ja einfach nehmen.\n");
  AddDetail( "tuer" ,
    "Hm, die Tuer ist verschlossen. Ob man sie einfach oeffnen kann?\n"); 
  AddDetail( "regal" ,
    "Welches Regal meinst Du? Das rote oder das blaue?\n"); 
  AddSpecialDetail( ({ "blaues regal" , "blaue regal" }) , "bschau" );
  AddSpecialDetail( ({ "rotes regal" , "rote regal" }) , "rschau" );
  AddSpecialDetail( ({ "blaues buch" , "blaue buch" }) , "bbschau" );
  AddSpecialDetail( ({ "rotes buch" , "rote buch" }) , "rbschau" );

  AddSmell( DEFAULT_SMELL , "Es riecht hier nach verschiedenen Kraeutern.            \n");
  AddSmell( ({ "kraeuter" , "kraeutern" , "geruch" }) ,
            "Du kannst leider nicht erkennen, um welche Kraeuter "
           +"es sich handelt. Der Geruch entstroemt einem grossen "
           +"Kessel, der in der Mitte des Raumes steht.\n");
  AddSmell( "fluessigkeit" ,
            "Die Fluessigkeit riecht sehr intensiv nach Kraeutern.\n");
  AddSound( DEFAULT_SOUND , "Leise brodelt eine merkwuerdige Fluessigkeit "
                           +"im Kessel vor sich hin.\n");
 
AddCmd( ({ "stelle" , "stell" }) , "stellen" );
AddCmd( ({ "nimm" , "nehme" }) , "nehmen" ); 
AddCmd( "oeffne" , "oeffnen" ); 
AddCmd( ({ "trink" , "trinke" }) , "trinken" ); 

AddSpecialExit("westoben" , "wob" );
AddSpecialExit("westen", "wob" );
SetProp(P_HIDE_EXITS, ({ "westen" }));

} 

wob()
{
object ob;
if (ob=present(("\nzakrbuch"), this_player()))
 {
  ob->remove();
  write("Du stellst das rote Buch wieder zurueck.\n");
  if(bbuch==2) rbuch=0;
  if(bbuch==1) rbuch=0;
  if(bbuch==0)
   {
    bbuch=1;
    rbuch=0;
   }
 }
if (ob=present(("\nzakbbuch"), this_player()))
 {
  ob->remove();
  write("Du stellst das blaue Buch wieder zurueck.\n");
  if(rbuch==2) bbuch=1;
  if(rbuch==0) bbuch=1;
  if(rbuch==1)
   {
    bbuch=1;
    rbuch=0;
   }
 }
this_player()->move(ROOM("ill3"), M_GO , "" , "geht nach Westoben", 
                                               "kommt herein");
return 1;
}

rbschau()
{

if(rbuch==1)
 {
  write(BKS("Das rote Buch, das Du meinst, steht im roten Regal.\n"));  
  return "";
 }

if(rbuch==0)
 {
  write(BKS("Im blauen Regal steht ein einzelnes rotes Buch. Wenn es Dich "
           +"so interessiert, kannst Du es ja mal herausnehmen und lesen.\n"));  
  return "";
 }

write(BKS("Es gibt viele rote Buecher, aber die sind alle uninteressant.\n"));  
return "";

}

bbschau()
{

if(bbuch==0)
 {
  write(BKS("Das blaue Buch, das Du meinst, steht im blauen Regal.\n"));  
  return "";
 }

if(bbuch==1)
 {
  write(BKS("Im roten Regal steht ein einzelnes blaues Buch. Wenn es Dich "
           +"so interessiert, kannst Du es ja mal herausnehmen und lesen.\n"));  
  return ""; 
 }

write(BKS("Es gibt viele blaue Buecher, aber die sind alle uninteressant.\n"));  
return "";

}

rschau()
{

if(rbuch==1)
 {
  write(BKS("In dem roten Regal stehen nur rote Buecher.\n"));  
  return "";
 }

if(bbuch==1)
 {
  write(BKS("In dem roten Regal stehen lauter rote Buecher. Nur eines "
           +"der Buecher ist blau.\n"));  
  return "";
 }

write(BKS("In dem roten Regal stehen nur rote Buecher. Eines fehlt jedoch.\n"));  
return "";

}


bschau()
{

if(bbuch==0)
 {
  write(BKS("In dem blauen Regal stehen nur blaue Buecher.\n"));  
  return "";
 }

if(rbuch==0)
 {
  write(BKS("In dem blauen Regal stehen lauter blaue Buecher. Nur eines "
           +"der Buecher ist rot.\n"));  
  return ""; 
 }

write(BKS("In dem blauen Regal stehen nur blaue Buecher. Eines fehlt jedoch.\n"));  
return "";

}

stellen(str)
{
string farbe1;
string farbe2;
object ob;
notify_fail( "Versuche mal: stelle <farbe> buch in <farbe> regal.\n");
if(str==0) return 0;
sscanf(str, "%s buch in %s regal", farbe1, farbe2);

if(farbe1=="rotes")
{
if (ob=present(("\nzakrbuch"), this_player()))
{
 if(farbe2=="blaues")
   {
    if(bbuch == 0)
    {
     write("Nein, Du musst erst das blaue Buch herausnehmen.\n");
     return 1;
    }
    else
    {
     write("Du stellst das rote Buch in das blaue Regal.\n");
     rbuch=0;
     ob->remove();
     return 1;
    }
    
   }
  if(farbe2=="rotes")
   {
    if(bbuch == 1)
    {
     write("Nein, Du musst erst das blaue Buch herausnehmen.\n");
     return 1;
    }
    else
    {
     write("Du stellst das rote Buch in das rote Regal.\n");
     rbuch=1;
     ob->remove();
     if(bbuch==0) call_out(("raus"),0);
     return 1;
    }
   }
}
else
 {
  write("Du hast aber kein rotes Buch. Tja, vielleicht erstmal nehmen?\n");
  return 1;
 }
return 0;
}

if(farbe1=="blaues")
{

if(ob=present(("\nzakbbuch"), this_player()))
{
if(farbe2=="blaues")
   {
    if(rbuch == 0)
    {
     write("Nein, Du musst erst das rote Buch herausnehmen.\n");
     return 1;
    }
    else
    {
     write("Du stellst das blaue Buch in das blaue Regal.\n");
     bbuch=0;
     ob->remove();
     if(rbuch==1) call_out(("raus"),0);
     return 1;
    }
   }
  if(farbe2=="rotes")
   {
    if(rbuch == 1)
    {
     write("Nein, Du musst erst das rote Buch herausnehmen.\n");
     return 1;
    }
    else
    {
     write("Du stellst das blaue Buch in das rote Regal.\n");
     bbuch=1;
     ob->remove();
     return 1;
    }
   }
}
else
{
 write("Du hast aber kein blaues Buch. Tja, vielleicht erstmal nehmen?\n");
 return 1;
}
return 0;
}

}

nehmen(str)
{
string farbe1;
string muell;
if(str==0) return 0;
sscanf(str, "%s buch%d", farbe1, muell);

if(farbe1=="rotes")
{
  if(rbuch==0)
   {
    write("Du nimmst das rote Buch aus dem blauem Regal.\n");
    rbuch=2;
    clone_object(OBJ("rbuch"))->move(this_player());
    return 1;
   }
  if(rbuch==1)
   {
    write("Du nimmst das rote Buch aus dem rotem Regal.\n");
    rbuch=2;
    clone_object(OBJ("rbuch"))->move(this_player());
    return 1;
   }
}

if(farbe1=="blaues")
{
  if(bbuch==0)
   {
    write("Du nimmst das blaue Buch aus dem blauem Regal.\n");
    bbuch=2;
    clone_object(OBJ("bbuch"))->move(this_player());
    return 1;
   }
  if(bbuch==1)
   {
    write("Du nimmst das blaue Buch aus dem rotem Regal.\n");
    bbuch=2;
    clone_object(OBJ("bbuch"))->move(this_player());
    return 1;
   }
}

return 0;
}


oeffnen(str)
{
        notify_fail( "Was moechtest Du denn oeffnen?\n");
	if( str == "tuer" )
	{
          write(BKS("Nein, Du kannst die Tuer nicht einfach oeffnen. "
                   +"Das hast Du Dir fast schon gedacht...\n"));
          return 1;
	}
        return 0;
}

trinken(str)
{
	if( str == "fluessigkeit" )
	{
          object ob;
          if (ob=present(("\niquestitem"), this_player()))
          {
            if(ob->querykrautgegessen()==1)
            {
              write(BKS("Du nimmst einen Schluck von der Fluessigkeit und fuehlst "
                       +"Dich ploetzlich ganz schwach. Du verlierst das Bewusstsein.\n"));
              say (capitalize(this_player()->name())
                    +" trinkt etwas von der Fluessigkeit aus dem Kessel und bricht zusammen.\n");
              this_player()->move(ROOM("aebene1"), M_TPORT , "" ,
             "wird immer durchsichtiger und verschwindet dann schliesslich ganz", 
             "materialisiert sich neben Dir");
            }
            else
            {
              write("Vielleicht solltest Du erstmal das Spice essen?\n");
            } 
          }
          else
          {
            write(BKS("Ja, ja, Du kannst es kaum erwarten, die Bruehe "
                     +"runterzuwuergen. Faengst Du mit den Augen an "
                     +"oder knabberst Du doch lieber erst an den "
                     +"Hahnenfuessen?\n"));
          }
          return 1;
	}
        return 0;
}

void raus()
{
bbuch=1;
rbuch=0;
write(BKS("Ploetzlich oeffnet sich die Tuer und Du schluepfst schnell "
         +"hindurch, bevor sie sich wieder schliesst. Ha, Du hattest "
         +"einen guten Riecher. Ordnung zahlt sich eben doch aus!\n"));
this_player()->move(ROOM("haus2"), M_GO , "" ,
                      "schluepft schnell durch die Tuer" , "kommt herein");
}


reset()
{
  ::reset();
// Wichtig, wenn jemand mit Buechern einschlaeft oder Buecher zerstoert.
// Ueberzaehlige Buecher wird man los, indem man sie in ein Regal stellt.
// Sollte aber selten vorkommen.
rbuch=0;
bbuch=1;
}