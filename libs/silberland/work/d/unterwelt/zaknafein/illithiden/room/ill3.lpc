/* Weg zu den Illithiden
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDROOM;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

string lies_grab();
string lies_tafel();

#define MAX_APPLE 5
mapping apfel_merk = ([]);



create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Hoehle weit unter der Erde" );
  SetProp(P_INT_LONG, "In der riesigen Hoehle steht hier eine kleine Huette. "
        +"Sie ist aus grob behauenen Baumstaemmen aufgebaut und macht einen recht "
        +"einladenen Eindruck. In den Fenstern der Huette flackert ein gruenliches Licht. "
        +"Die Tuer der Huette im Osten steht einen Spalt breit auf. "
        +"Neben der Huette waechst ein Baum aus der Erde. Vor dem Baum steht ein "
        +"grosser Grabstein. ");


  AddDetail( ({ "hoehle" }) ,
    "Du kannst immer mehr die gewaltigen Ausmasse der Hoehle erahnen. Du befindest dich "
   +"bereits weit in der Hoehle, aber noch ist kein Ende auszumachen. Ganz im Gegenteil. "
   +"Das Bauwerk im Sueden wird immer groesser, je naeher du kommst. Mittlerweile hast du "
   +"die kleine Huette erreicht, die du bereits von wiet her gesichtet hattest.\n");
  AddDetail( ({ "ende" }) ,
    "Es ist keins auszumachen in der Dunkelheit.\n");
  AddDetail( ({ "bauwerk" , "sueden"}) ,
    "So langsam meinst du Konturen an dem Bauwerk im Sueden erkennen zu koennen.\n");
  AddDetail( ({ "kontur","konturen" }) ,
    "Es scheint ein sehr grosses Bauwerk zu sein, das hoch in die Hoehle ragt.\n");

  AddDetail( ({ "gegenteil" , "gegensatz" ,"gegensaetze"}) ,
    "Meister und Sklave, Macht und Ohnmacht und eben auch Leben und Tod sind Beispiele fuer Gegensaetze.\n");
  AddDetail( ({ "meister" }) ,
    "Als Meister herrscht man ueber seine Sklaven.\n");
  AddDetail( ({ "sklave" }) ,
    "Als Sklave muss man seinem Meister dienen.\n");
  AddDetail( ({ "beispiel" , "beispiele" }) ,
    "Um nur einige zu nennen.\n");
  AddDetail( ({ "macht" , "maechte" }) ,
    "Es gibt schon sonderbare Maechte.\n");
  AddDetail( ({ "ohnmacht" ,"schock" }) ,
    "Ein Zustand nahe dem Tod.\n");
  AddDetail( ({ "zustand" }) ,
    "Du bist in keinem guten Zustand.\n");
  AddDetail( ({ "leben" }) ,
    "Ach, das Leben ist schon schoen, im Gegensatz zum Tod.\n");
  AddDetail( ({ "tod" }) ,
    "Der scheint hier oefters mal jemanden abzuladen.\n");

  AddDetail( ({ "wand" , "waende" , "aussenwand" , "aussenwaende" }) ,
    "Die Aussenwaende der Huette bestehen aus grob behauenen Baumstaemmen.\n");
  AddDetail( ({ "innenwand" }) ,
    "Dazu musst du erst nach Osten in die Huette gehen.\n");
  AddDetail( ({ "decke" , "bauwerk" }) ,
    "Durch das Licht geblendet erkennst du in der Dunkelheit gar nichts mehr.\n");
  AddDetail( ({ "boden" , "untergrund" , "grund"}) ,
    "Erst jetzt bemerkst du, dass der Untergrund hier nicht mehr aus Fels besteht, "
   +"sondern aus richtiger Erde.\n");
  AddDetail( ({ "erde", "fels" }) ,
    "Die Erde wirkt nicht mehr so kalt wie der nackte Fels.\n");
  AddDetail( ({ "teil" }) ,
    "Die Erde wird zu einem grossen Teil durch die Wurzeln des Baumes bedeckt.\n");

  AddDetail( ({ "grab" , "grabstein" , "stein" }) ,
    "Vor dem Baum steht ein Grabstein. Auf ihm sind viele Namen verzeichnet. "
   +"Du kannst ihn lesen.\n");
  AddDetail( ({ "name" , "namen" }) ,
    "Sehr, sehr viele stehen auf dem Stein.\n");


  AddDetail( ({ "baum" , "gewaechs" }) ,
    "In der Naehe der Huette waechst hier in der Dunkelheit ein Baum. "
   +"Die Wurzeln faechern sich weit auf, und geben dem Baum den noetigen Halt. "
   +"Ein knorriger alter Stamm traegt die niedrige Baumkrone. Die"
   +"blutroten Blaetter wiegen sich leicht im Windzug. Am Stamm ist eine "
   +"grosse hoelzerne Tafel angebracht.\n");
  AddDetail( ({ "windzug" , "wind" }) ,
    "Die Hoehle scheint derart riesige Ausmasse zu haben, dass sogar Wind in ihr wehen kann.\n");
  AddDetail( ({ "ausmass","ausmasse" }) ,
   "Die Hoehle scheint gewaltig gross zu sein.\n");


  AddDetail( ({ "baumkrone", "krone"}) ,
    "Auch die Baumkrone sieht recht ungewoehnlich aus. Nicht nur das die Blaetter blutrot sind, "
   +"auch die schwarzen Aeste winden sich umeinander und haengen wie bei einer Trauerweide zum Boden.\n");
  AddDetail( ({ "trauerweide", "weide" , "trauer"}) ,
     "Ein passendes Gewaechs fuer ein Grab - findest du nicht?\n");
  AddDetail( ({ "ast", "aeste" }) ,
    "Die Aeste haengen wie bei einer Trauerweide zum Boden, nur sind sie bei diesem Baum auch "
   +"noch miteinander verwunden.\n");


  AddDetail( ({ "naehe" }) ,
    "Dieser merkwuerdige Baum steht ganz in der Naehe der ebenfalls merkwuerdigen Huette.\n");
  AddDetail( ({ "dunkelheit"}) ,
    "Nur das Licht aus der Huette strahlt hier in die Dunkelheit hinaus.\n");
  AddDetail( ({ "stamm", "baumstamm" }) ,
    "Ein wahrlich seltsamer Baum. Der gedrungene Stamm windet sich mehrmals in sich selbst. "
   +"Die Rinde ist alt und trocken. An einigen Stellen wurde ein Stueck herausgerissen. In "
   +"Augenhoehe haengt Tafel. Man kann sie lesen.\n");
  AddDetail( ({ "tafel" }) ,
    "Du kannst sie lesen.\n");
  AddDetail( ({ "rinde" }) ,
    "Die Rinde des Baumes ist schwarz und alt. Teilweise sind Stuecke aus ihr herausgerissen "
   +"und geben den Blick auf das darunterliegende Holz frei.\n");

  AddDetail( ({ "holz" , "blick"}) ,
    "Das Holz unter der Rinde ist blutrot.\n");
  AddDetail( ({ "stueck" , "stuecke" , "stelle","stellen" }) ,
   "An einigen Stelle wurde ein Stueck Rinde vom Baum gerissen.\n");

  AddSpecialDetail( ({ "augenhoehe"}) , "augenhoeh");
  AddDetail( ({ "wurzel", "wurzeln" , "halt" }) ,
    "Die Wurzeln bedecken einen grossen Teil der Erde hier. Dadurch findet der "
   +"alte Baum Halt. Aber woher er die Energie nimmt, um in dieser Hoehle zu "
   +"ueberleben, wirst du wohl nur herausbekommen, wenn du eine Wurzel freilegst.\n");

  AddDetail( ({ "energie" , "energiequelle"}) ,
    "Neben den Blaettern bezieht ein Baum normalerweise seine Energie ueber die Wurzeln.\n");
  AddDetail( ({ "blatt", "blaetter"}) ,
    "Von Weitem hast du die kleinen Blaetter nicht gesehen. Ihre blutrite Farbe ist ja auch "
   +"recht ungewoehnlich. Aber jetzt wo du direkt unter dem Baum stehst, siehst du auch die "
   +"kleinen Aepfel dazwischen. ");
  AddDetail( ({ "weitem" }) ,
    "Die Blaetter sind zu klein, um von Weitem entdeckt werden zu koennen.\n");

  AddDetail( ({ "apfel", "aepfel"}) ,
     "Zwischen den Blaettern haengen kleine, rote Aepfel. Bestimmt kann man sie pfluecken.\n");

  AddDetail( ({ "rot" , "blut", "fluessigkeit", "blutrot","blutrote farbe", "rote farbe"}) ,
    "Durch die Blaetter scheint eine dunkelrote Fluessigkeit zu pulsieren. Sie gibt den "
   +"Blaettern ihre Farbe. Ob man den Puls auch messen kann?\n");
  AddDetail( ({ "puls" }) ,
    "Bei dem Gedanken daran, was diese Fluessigkeit sein kann, die durch die Blaetter pulsiert, "
   +"beginnt dein Puls zu rasen.\n");
  AddDetail( ({ "gedanke", "gedanken"}) ,
    "Dir gehen die uebelsten Gedanken durch den Kopf.\n");
  AddDetail( ({ "kopf" }) ,
    "Hoffentlich bleibt der auf deinen Schultern.\n");
  AddDetail( ({ "schulter", "schultern"}) ,
    "Noch ist da dein Kopf drauf.\n");
  AddDetail( ({ "farbe" }) ,
    "Welche Farbe meinst du?\n");


  AddDetail( ({ "huette", "haus"}) ,
    "Auch wenn das Licht gruenlich ist, dass aus den Fenstern und der Tuer scheint, so macht "
   +"sie dennoch einen einladenen Eindruck auf dich. Die massigen Baumstaemme, aus denen die "
   +"Huette aufgebaut ist, verleihen ihr den Eindruck von Sicherheit und Geborgenheit. Bestimmt kann "
   +"man sich in ihr von den Grausamkeiten des Abenteureralltags ein wenig ausruhen.\n");
  AddDetail( ({ "fenster" , "fenstern"}) ,
    "Durch die Fenster scheint ein gruenliches Licht in die Dunkelheit der Hoehle. Allerdings "
   +"sind sie derart verstaubt, dass du leider nicht hineinblicken kannst.\n");
  AddDetail( ({ "staub" ,"staubschicht"}) ,
    "Eine feine Staubschicht hat sich ueber die Fenster gelegt. Vielleicht hat der Staub ja "
   +"etwas mit den Klopfgeraeuschen zu tun?\n");

  AddDetail( ({ "licht", "gruenes licht" }) ,
    "Das flackernde Licht macht trotz der seltsam gruenlichen Farbe einen einladenen "
   +"Eindruck auf dich.\n");
  AddDetail( ({ "gruen" , "gruenlich" , "gruenliche farbe", "gruene farbe" }) ,
    "Die gruenliche Farbe des Lichts kann deine Hoffnung auf Sicherheit und Geborgenheit nicht mindern.\n");
  AddDetail( ({ "tuer" , "tuere","spalt" }) ,
    "Die Tuer der Huette steht einen spaltbreit offen. Du kannst die Huette im Osten betreten.\n");
  AddDetail( ({ "baumstaemme" }) ,
    "Grosse Baumstaemme sind geschickt uebereinander gelegt und bilden so die "
   +"Aussenwaende der Huette.\n");
  AddDetail( ({ "eindruck" }) ,
    "Die Huette wirkt in dieser Umgebung sehr einladend.\n");
  AddDetail( ({ "umgebung" }) ,
    "Hier unten ist alles so grausam und finster. Da wirkt die Huette schon warm und einladend.\n");
  AddDetail( ({ "abenteureralltag" ,"alltag"}) ,
    "Der Alltag eines Abenteuerers besteht meistens aus forschen, metzeln und gemetzelt werden.\n");
  AddDetail( ({ "abenteurer" }) ,
    "Du bist doch einer.\n");
  AddDetail( ({ "grausamkeit","grausamkeiten" ,"grausam"}) ,
    "Ach, wenn die Welt doch nicht so grausam waere...\n");
  AddDetail( ({ "welt" }) ,
    "Sie ist grausam und gemein.\n");
  AddDetail( ({ "sicherheit" }) ,
    "Vielleicht bist du ja in der Huette in Sicherheit.\n");
  AddDetail( ({ "geborgenheit" }) ,
    "In der Huette scheint man sicher und geborgen zu sein.\n");




  AddDetail( ({ "koerper" , "leiche" , "leichen" , "tote" }) ,
    "Du siehst hier keine herumliegen. Aber wo ein Grabstein steht, sind meistens Tote vergraben.\n");


  AddDetail( ({ "totenruhe" , "ruhe" }) ,
    "Du laesst die Toten lieber in Ruhe.\n");
  AddDetail( ({ "kamerad", "kameraden" , "tote" }) ,
    "Hier sind schon "+ILLMASTER->SumDead()+" Kameraden von dir verstorben.\n");
  AddDetail( ({ "klopfgeraeusch" , "klopfgeraeusche" }) ,
    "Wenn du ihnen lauscht, kannst du vielleicht sogar die Richtung herausbekommen.\n");

  AddSmell( DEFAULT_SMELL , "Ein wohlrichender Duft stroemt aus der Huette.\n");
  AddSmell( ({ "duft" , "wohlrichender duft" }) ,
         "Ahh, ein Duft von Kraeutern dringt in deine Nase.\n");

  AddSound( DEFAULT_SOUND , "Du hoehrst neben den ueblichen Klopfgeraeusche ein leises brodeln.\n");
  AddSound( ({ "klopfen", "klopfgeraeusch", "klopfgeraeusche" , "geraeusch" }),
               "Irgendwo scheint jemand den Fels zu bearbeiten.\n");
  AddSound( ({ "brodeln" }),
               "Es kommt aus der Huette, als ob eine Suppe auf dem Feuer auf dich wartet.\n");




  AddReadDetail( ({ "grab" , "grabstein" ,"namen"}) , #'lies_grab );
  AddReadDetail( ({ "tafel" }) , #'lies_tafel );

  AddCmd( ({ "topliste" , "top"  }) , "topliste_func");
  AddCmd( ({ "deadliste" , "dead"  }) , "deadliste_func");
  AddCmd( ({ "reisse" ,"reiss" }) , "fake_reisse");
  AddCmd( ({ "messe","mess"  }) , "fake_messe");
  AddCmd( ({ "lege" ,"leg" }) , "wurzel_frei");
  AddCmd( ({ "plueck" , "pfluecke"  }) , "pfluecken");

  AddExit("norden", ROOM("ill2"));
  AddExit( "sueden" , ROOM("ill4"));
  AddExit( "osten" , ROOM("haus1"));
  AddExit( "ostunten" , ROOM("haus1"));
  SetProp(P_HIDE_EXITS, ({ "osten" }));
}

wurzel_frei( str )
{
  if (str=="wurzel frei" || str == "wurzeln frei") {
  write(BKS("Vorsichtig legst du eine Wurzel frei. Du musst auch gar nicht tief graben, "
          +"bis du die Energiequelle des Baumes gefunden hast. Leichen! Die Wurzeln bohren "
          +"sich in die Koerper der Toten und entziehen ihnen ihr Blut. Noch unter Schock "
          +"bedeckst du die Wurzel wieder mit Erde.\n"));
          tell_room(environment(this_player()), capitalize(this_player()->Name())
                       +" graebt in der Erde unter dem Baum.\n",({this_player()}));
          return 1;
  }
  return 0;
}

string lies_tafel()
{
write(ILLMASTER->TopListe());
return "";
}

string lies_grab()
{
write(ILLMASTER->DeadListe());
return "";
}

augenhoeh()
{
  return "Fuer dich ist die Tafel extra in einer Hoehe von "+this_player()->QueryProp(P_SIZE)+"cm angebracht.\n";
}

fake_reisse( str )
{
  notify_fail("Was willst du wo herausreissen?\n");
  if ( str=="rinde" || str=="rinde heraus" || str=="stueck" || str=="stueck rinde"
        || str=="rinde von stamm" || str=="ein stueck rinde vom stamm" || str=="ein stueck rinde heraus"
        || str=="ein stueck rinde vom stamm") {
    write(BKS("Du reisst mit einem kraeftigen Ruck ein Stueck der Rinde vom Stamm. Erschreckt laesst "
          +"du es aber sofort wieder fallen. Aus der Rinde tropft eine rote Fluessigkeit. Blut! "));
   tell_room(environment(this_player()), capitalize(this_player()->Name())
                       +" reisst ein Stueck Rinde vom Stamm.\n",({this_player()}));
    return 1;
  }
  return 0;
}

fake_messe( str )
{
  notify_fail("Was willst du messen?\n");
  if ( (str == "puls"))
  {
    write(BKS("Welchen Puls willst du messen, deinen eigenen oder den des Baumes?"));
    return 1;
  }
  if ( str=="deinen puls" || str=="meinen puls" ||str=="meinen eigenen puls" || str=="eigenen puls")
    {
      write(BKS("Puh! Bei den Erlebnissen hier unten ist dein Puls ganz schoen hoch."));
      tell_room(environment(this_player()), capitalize(this_player()->Name())
          +" misst seinen Puls.\n",({this_player()}));
      return 1;
    }
  if ( str=="puls baumes" || str=="puls an blaettern" ||str=="puls an blatt" ||
        str=="puls baums" || str=="puls am blatt" || str=="puls am baum" )
    {
      write(BKS("Tatsaechlich! Durch den Baum pulsiert diese Fluessigkeit. Ob sie das "
            +"ist, was du denkst?"));
      tell_room(environment(this_player()), capitalize(this_player()->Name())
                       +" tastet an einem Blatt des Baumes herum.\n",({this_player()}));

      return 1;
    }

  return 0;
}



fake_grab()
{
notify_fail("Du willst gerade beginnen hier in der Erde zu graben, "
           +"als dir der Grabstein wieder einfaellt. Du beschliesst, "
           +"die Totenruhe deiner verstorbenen Kameraden nicht zu "
           +"stoeren.\n");
return 0;
}

pfluecken( str )
{
int anzahl;
string name;
name=this_player()->Name();

notify_fail("Was willst du pfluecken?\n" );
  if ( str == "apfel" || str == "aepfel" || str == "apfel von baum" ||str == "aepfel von baum"
        || str == "apfel vom baum" || str=="aepfel vom baum")
  {
    if (!member(apfel_merk, name))
    {
      apfel_merk += ([name: 1]);
      write(BKS("Du streckst deinen Arm aus und pflueckst einen Apfel vom Baum.\n"));
      clone_object(OBJ("apfel"))->move(this_player(),M_NOCHECK);
      return 1;
    }
    else
    {
      anzahl = apfel_merk[name];
      if(anzahl<MAX_APPLE)
      {
        apfel_merk[name] += 1;
        write(BKS("Die Aepfel sehen echt lecker aus. Du beschliesst noch ein paar mitzunehmen.\n"));
        clone_object(OBJ("apfel"))->move(this_player(),M_NOCHECK);
        return 1;
      }
      else
      {
        write(BKS("Nun hast du wirklich genug Aepfel. Deine Kameraden sollen ja auch noch welche bekommen.\n"));
        return 1;
      }
    }
  }
return 0;
}


