/* Ebene 1 Raum 1  
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDEBENE1;

#include <properties.h>
#include <moving.h>

create()
{
  ::create();


  AddSpecialExit( "nordostoben" , "noobfkt" );
  AddSpecialExit( "nooben" , "noobfkt" );
  AddSpecialExit( "noob" , "noobfkt" );
  AddExit("nordwesten", ROOM("ebene1_9"));
  AddExit("suedosten", ROOM("ebene1_11"));
  SetProp(P_HIDE_EXITS, ({"nooben" , "noob" }) );
}

noobfkt()
{
   object ob;
   if (ob=present(("\nwegitem"), this_player()))
    {
      if(ob->queryeb1()==3)
       {
         this_player()->move(ROOM("ebene2_7"), M_GO , "" , "geht nach nordostoben" , "kommt herein");
         return 1;
       }
    }
   this_player()->move(ROOM("ebene1_"+to_string(random(24))), M_GO , "" , "verschwindet ploetzlich" , "erscheint ploetzlich");
   return 1;
}