/* Ebene 1 Raum 20
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDEBENE1;

#include <properties.h>
#include <moving.h>

create()
{
  ::create();


  AddSpecialExit( "suedwestoben" , "swobfkt" );
  AddSpecialExit( "swoben" , "swobfkt" );
  AddSpecialExit( "swob" , "swobfkt" );
  AddExit("nordwesten", ROOM("ebene1_21"));
  AddExit("suedosten", ROOM("ebene1_19"));
  SetProp(P_HIDE_EXITS, ({"swoben" , "swob" }) );
}

swobfkt()
{
   object ob;
   if (ob=present(("\nwegitem"), this_player()))
    {
      if(ob->queryeb1()==6)
       {
         this_player()->move(ROOM("ebene2_13"), M_GO , "" , "geht nach suedwestoben" , "kommt herein");
         return 1;
       }
    }
   this_player()->move(ROOM("ebene1_"+to_string(random(24))), M_GO , "" , "verschwindet ploetzlich" , "erscheint ploetzlich");
   return 1;
}