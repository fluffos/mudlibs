/* Laufweg der Sklaven
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDLAUFWEG;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Laufweg der Sklaven");

  AddExit("nordostunten", ROOM("laufweg3"));
  AddExit("nordosten", ROOM("laufweg3"));
  AddExit( "suedwestoben" , ROOM("laufweg5"));
  AddExit( "suedwesten" , ROOM("laufweg5"));
  SetProp(P_HIDE_EXITS, ({ "nordosten" , "suedwesten" }));
}