/* Weg zu den Illithiden
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDROOM;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>


#define MAX_HEALING 4 //Wenn MAX_HEALING grosser als 7 wird, muss das Mapping fuer Zahl angepasst werden
mapping zahl = ([1:"ersten" , 2:"zweiten", 3:"dritten" , 4:"vierten" , 5:"fuenften" , 6:"sechsten" , 7:"siebten"]);
#define HEALING random(40)+120
mapping heil_merk =([]);

#define MAX_TORCH 4
mapping fackel_merk = ([]);

create()

{
  ::create();

  SetProp(P_INT_SHORT, "In einer Spalte weit unter der Erde" );
  SetProp(P_INT_LONG,
    "Das Gefuehl, dass du dich hier weit unter der Erde befindest, ist noch beklemmender, "
   +"als der Anblick der Leichen, die hier vor der Oeffnung in der Wand herumliegen. "
   +"Die Felsspalte, in der du steckst, ist nur wenige Meter breit aber unheimlich hoch. "
   +"Von Suedwesten dringen Klopfgeraeusche an dein Ohr. Dort scheint es auch etwas heller "
   +"zu sein als hier. ");


  AddDetail( ({ "wand" , "waende" }) ,
    "In den wenigen Metern zwischen den Waenden liegen viele Leichen. In der Nordwand ist "
   +"eine grosse Oeffnung.\n");
  AddDetail( ({ "meter" }) ,
    "Wenigen Metern liegen zwischen den Waenden.\n");

  AddDetail( ({ "decke" }) ,
     "Die scheint hier sehr hoch zu sein. Du kannst sie nicht erkennen.\n");

  AddDetail( ({ "boden" , "weg" }) ,
    "Auf dem felsigen Boden liegen ueberall Leichen und Leichenteile herum. Du musst dir schon fast "
   +"einen Weg bahnen um nach Suedwesten weitergehen zu koennen. ");
  AddDetail( ({ "fels" , "felsen" , "gestein"}) ,
    "Du stehst fest auf dem felsigen Boden.\n");

  AddSpecialDetail( ({ "spalt" , "felsspalt" , "spalte" , "felsspalte"}) , "spalt_func");


  AddDetail( ({ "oeffnung" , "nordwand" }) ,
    "In der Nordwand befindet sich die grosse Oeffnung des Schachtes, durch den du in dieses unterirdische Reich "
   +"gekommen bist. Auf dem Boden des Schachtes liegen einige abgestuerzte Abenteurer."
   +"Aber ob du es auch durch sie wieder verlassen kannst?\n");

  AddDetail( ({ "schacht" , "schachtes" }) ,
    "Du kannst dich kaum an den Schacht erinnern. Es war so dunkel und es ging alles so schnell.\n");
  AddDetail( ({ "reich" }) ,
    "Scheinbar leben hier sehr unangenehme Wesen, denen du lieber nicht begegnen moechtest, so "
   +"viele Leichen, wie hier herumliegen.\n");
  AddDetail( ({ "abenteurer" , "kollegen" , "abenteurerkollegen" , "kamerad" , "kameraden" }) ,
      "Diese Abenteurer sind mit ihrer gesamten Ausruestung in dem Schacht ums Leben gekommen. Sie "
     +"hatten nicht so viel Glueck wie du.\n");
  AddDetail( ({ "ausruestung" }) ,
    "Das meiste liegt schon so lange hier unten, dass es wohl nicht mehr zu gebrauchen ist. "
   +"Aber vielleicht kann man ja noch etwas Brauchbares finden, wenn man die Ausruestung mal "
   +"durchwuehlt?\n");
  AddDetail( ({ "brauchbares" , "spuersinn" }) ,
     "Mit dem richtigen Spuersinn findet man immer etwas Brauchbares.\n");

  AddDetail( ({ "suedwesten" }) ,
    "Im Suedwesten scheint sich die Spalte zu erweitern. Von dort scheint auch ein bisschen Licht "
   +"in die ansonstens recht dunkle Spalte. Klopfgeraeusche dringen aus der Richtung an dein Ohr.\n");

  AddDetail( ({ "richtung" }) ,
    "Die Klopfgeraeusche und das Licht kommen von Suedwesten.\n");

  AddDetail( ({ "klopfgeraeusch" , "geraeusch" , "klopfgeraeusche" , "geraeusche" }) ,
    "Vielleicht kannst du ja selber solche Geraeusche erzeugen?\n");
  AddDetail( ({ "licht" , "schein" , "lichtschein" }) ,
     "Ohne das Licht waere es hier stockfinster.\n");


  AddDetail( ({ "gefuehl" , "erde" }) ,
    "Kein gutes Gefuehl, so weit unter der Erde zu sein.\n");

  AddDetail( ({ "anblick" }) ,
    "Ekelhaft, diese Leichen.\n");

  AddDetail( ({ "leiche" , "leichen" , "leichenteile" , "leichenteil"}) ,
     "Die Leichen sehen echt uebel aus. Die weiter unten liegenden sind schon stark verwest, so "
    +"dass fast nur noch das Skelett uebrig geblieben ist, waehrend die oberen langsam vor sich "
    +"hinfaulen.\n");

  AddDetail( ({ "skelett" , "skelette" , "skelett mit loch im schaedel"}) ,
        "Eine so oberflaechliche Untersuchung wird dich nicht weit bringen. Du solltest eine "
       +"Obduktion an den Ueberresten durchfuehren, um mehr ueber die Todesursache herauszubekommen.\n");

  AddDetail( ({ "todesursache" }) ,
    "Meistens gibt es einen guten Grund dafuer, dass eine Person aus dem Leben scheidet.\n");
  AddDetail( ({ "grund" }) ,
    "Den solltest du versuchen herauszufinden.\n");

  AddDetail( ({ "person" , "personen" , "koerper", "wesen" , "opfer" , "verstorbener" , "verstorbene" }) ,
    "Vielleicht koennen dir ja die Ueberreste dieser Personen noch weiterhelfen?\n");
  AddDetail( ({ "leichnam" }) ,
    "Die Ueberreste einer verstorbenen Person.\n");
  AddDetail( ({ "ueberrest" , "ueberreste" }) ,
    "Einige Leichen sind bereits soweit verwest, dass man nur noch von Ueberresten sprechen kann.\n");


  AddDetail( ({ "leben" }) ,
    "Ach, das Leben ist schon schoen, im Gegensatz zum Tod.\n");
  AddDetail( ({ "tod" }) ,
    "Der scheint hier oefters mal vorbeizuschauen.\n");


  AddDetail( ({ "gegensatz" , "gegensaetze" }) ,
    "Meister und Sklave, Macht und Ohnmacht und eben auch Leben und Tod sind Beispiele fuer Gegensaetze.\n");
  AddDetail( ({ "meister" }) ,
    "Als Meister herrscht man ueber seine Sklaven.\n");
  AddDetail( ({ "sklave" }) ,
    "Als Sklave muss man seinem Meister dienen.\n");
  AddDetail( ({ "beispiel" , "beispiele" }) ,
    "Um nur einige zu nennen.\n");
  AddDetail( ({ "macht" , "maechte" }) ,
    "Es gibt schon sonderbare Maechte.\n");
  AddDetail( ({ "ohnmacht" }) ,
    "Ein Zustand nahe dem Tod.\n");
  AddDetail( ({ "zustand" }) ,
    "Du bist in keinem sehr gutem Zustand.\n");

  AddDetail( ({ "sturz" , "stuerze"}) ,
    "Du hast ihn ja selbst erlebt, nur am Ende mehr Glueck gehabt.\n");
  AddDetail( ({ "hoehe" }) ,
    "Du bist ganz schoen tief gestuerzt.\n");
  AddDetail( ({ "ende" }) ,
    "Der Tod ist das absolute Ende.\n");
  AddDetail( ({ "glueck" }) ,
    "Ob du wirklich Glueck hattest, wirst du erst wissen, wenn du hier lebend wieder rausgekommen bist.\n");

  AddDetail( ({ "knochen" , "knochenbruch" , "knochenbrueche" }) ,
    "Eine unangenehme Sache, wenn man sich einen Knochen bricht. Hier unten aber fuehrt soetwas zum sicheren Tod.\n");
  AddDetail( ({ "sache" }) ,
    "Aeusserst unangenehm.\n");

  AddDetail( ({ "genickbruch" }) ,
    "Ein Genickbruch fuehrt zum sofortigen Tod. Vielleicht gar nicht mal so unangenehm, dann bekommt man "
   +"wenigstens nichts davon mit, was hier sonst mit einem bis zum Tod geschieht.\n");

  AddDetail( ({ "loch" }) ,
    "Fein saeuberlich mit zwei Finger Durchmesser in den Schaedel gebohrt.\n");
  AddDetail( ({ "finger" , "durchmesser" }) ,
    "Das Loch hat einen Durchmesser von zwei Fingern.\n");
  AddDetail( ({ "schaedel" , "schaedeldecke" }) ,
    "Ein ganz normaler Schaedel, nur mit einem Loch in der Schaedeldecke.\n");

  AddDetail( ({ "rest" }) ,
    "Alles andere ausser dem Schaedel.\n");

  AddDetail( ({ "obduktion" , "untersuchung" }) ,
    "Eine genauere Untersuchung von verstorbenen Personen nennt man Obduktion. Du koenntest ja mal eine "
   +"der Leichen obuzieren. Vielleicht bekommst du ja etwas heraus, wie sie ums Leben gekommen sind.\n");

  AddDetail( ({ "merkmal" , "merkmale" }) ,
    "Bei einer ordentlichen Obduktion beginnt man immer mit den aeusseren Merkmalen.\n");

  AddDetail( ({ "totenstarre" , "starre" }) ,
    "Bereits nach einigen Stunden setzt bei Verstorbenen die Totenstarre ein. Der Leichnam wird dann ganz starr.\n");
  AddDetail( ({ "stunde" , "stunden" }) ,
    "Nein, die Leichen, die hier rumliegen, befinden sich alle schon laenger hier. Ganz eindeutig.\n");

  AddDetail( ({ "kleidung" }) ,
    "Das Blut auf der Kleidung ist bereits eingetrocknet.\n");
  AddDetail( ({ "blut" }) ,
    "Blut wird auch als der Saft des Lebens bezeichnet.\n");
  AddSpecialDetail( ({ "saft" }) , "detail_func" );


  AddDetail( ({ "stichverletzungen" , "schnittverletzungen" , "schnittverletzung" , "stichverletzung" , "verletzungen" , "verletzung"}) ,
    "Typische Anzeichen eines fairen Kampfes.\n");
  AddDetail( ({ "anzeichen" , "kampf" , "kaempfe" }) ,
    "Bei einem fairen Kampf traegt man meistens auch Verletzungen davon.\n");
  AddDetail( ({ "haematom" , "haematome" }) ,
    "Typische Anzeichen von stumpfen Gegenstaenden oder blossen Faeusten.\n");
  AddDetail( ({ "gegenstand" , "gegenstaende" , "faust" , "faeuste" }) ,
    "Haematome kann man sich auch durch Stuerze oder bei Schlaegereien zuziehn.\n");
  AddDetail( ({ "schlaege" , "schlaegerei", "schlaegereien" }) ,
    "Du hast dich doch bestimmt auch schonmal mit jemanden gepruegelt, oder?\n");

  AddDetail( ({ "fingernagel" , "nagel" , "fingernaegel" }) ,
    "Du hast sie zur besseren Untersuchung einfach aus ihrem Bett gerissen.\n");
  AddDetail( ({ "bett" , "nagelbett" }) ,
    "Darin sind die Fingernaegel eingebettet.\n");

  AddDetail( ({ "hautfetzen" , "fetzen" }) ,
    "Die Hautfetzen, die du unter den Fingernaegeln der Leichen gefunden hast, stammen nicht "
   +"von Menschen, auch wenn sie sich recht aehnlich anfuehlen. Die Haut derjenigen, die mit "
   +"diesen Personen gekaempft haben, muss grau und ledern sein. Mehr kannst du aus den Fetzen "
   +"allerdings nicht erkennen.\n");

  AddDetail( ({ "auge" , "augen" }) ,
    "Die Augen der Leichen sind blutunterlaufen. Soetwas koennte auf Erwuergen als Todesursache "
   +"hindeuten, aber dafuer fehlen die Wuergemale am Hals der Opfer.\n");
  AddDetail( ({ "erwuergen" , "wuergen" }) ,
    "Eine Moeglichkeit, jemanden ums Leben zu bringen.\n");
  AddDetail( ({ "moeglichkeit" }) ,
    "Nur eine von vielen.\n");
  AddDetail( ({ "wuergemale" , "wuergemal" }) ,
    "Du kannst einfach keine Wuergemale finden.\n");
  AddDetail( ({ "hals" }) ,
    "Wenn man jemanden erwuergen will, wird man das wohl am Hals tun muessen.\n");
  AddDetail( ({ "bereich" , "bereiche"}) ,
    "Es gibt viele Bereiche.\n");

  AddDetail( ({ "rachenbereich" }) ,
    "Der Bereich vom Mund bis zum Kehlkopf.\n");
  AddDetail( ({ "mund" , "kehlkopf" }) ,
    "Das gehoert zum Rachenbereich.\n");
  AddDetail( ({ "nase" }) ,
    "Du bohrst in der Nase.\n");

    AddDetail( ({ "masse" , "gehirnmasse" , "gehirn" }) ,
    "Die Gehirnmasse des Menschen ist eine graue, zaehfluessige Masse. Diesen Personen scheint sie "
   +"durch Mund, Nase und ein Loch im Schaedel entfernt worden zu sein.\n");

  AddDetail( ({ "hinsehen" }) ,
    "Manchmal muss man genauer hinsehen.\n");
  AddDetail( ({ "ort" , "leere" }) ,
    "Eigentlich sollte sich das Gehirn im Schaedel befinden.\n");

  AddDetail( ({ "anschein" , "schein" , "vorstellung"}) ,
    "Eine ekelhaft Vorstellung.\n");
  AddDetail( ({ "ohr" }) ,
    "Es dient dazu, Geraeusche wahrzunehmen.\n");

  AddDetail( ({ "ruhe" }) ,
    "Davon koenntest du jetzt auch ein wenig vertragen.\n");



  AddSmell( DEFAULT_SMELL , "Es riecht hier stark nach Verwesung.\n");
  AddSmell( ({ "leiche", "leichen" , "verwesung" }) , "Der Geruch ist hier sehr stark.\n");
  AddSmell( ({"geruch"}) , "Es riecht hier sehr stark nach Verwesung.\n");
  AddSound( DEFAULT_SOUND , "Du hoehrst entfernte Klopfgeraeusche.\n");
  AddSound( ({ "klopfen", "klopfgeraeusch", "klopfgeraeusche" , "geraeusch" }),
               "Irgendwo scheint jemand das Gestein zu bearbeiten.\n");


  AddExit("suedwesten", ROOM("ill1"));
  AddSpecialExit( "oben" , "obfkt" );

AddCmd( ({ "obduziere" }) , "obduktion" );
AddCmd( ({ "klopf" , "klopfe" , "klopfen"  }) , "klopfen" );
AddCmd( ({ "wuehle" , "durchsuche" , "durchwuehle" }) , "wuehlen" );
AddCmd( ({ "bahn" , "bahne" , "raeume" , "raeum" }) , "fake_weg" );

}

spalt_func()
 {
    write(BKS(this_object()->Query(P_INT_LONG)));
    return "";
 }                               

 fake_weg( str )
 {
   notify_fail( "Was willst du dir bahnen?\n" );
   if ( (str=="weg") || (str=="weg durch leichen") ||
      (str=="leichen weg") || (str=="leichen zur seite") )
   {
     write(BKS("Hier liegen zwar sehr viele Leichen und Skelette herum, "
         +"aber noch kommt man da einigermassen gut durch.\n"));
     return 1;
   }
   return 0;
 }                                 

obfkt()
 {
  write(BKS("Du kletterst in den Schacht und machst dich auf die lange Reise an die Oberflaeche. "
        +"Aber von der Angst, dass die Illithiden dich verfolgen koennten, befluegelt, erreichst "
        +"du deinen Ausgangsort rasend schnell.\n"));
  write("\n");
  this_player()->move((ROOM("startill")), M_GO , "klettert in den Schacht" ,
    "kommt leichenblass aus dem Stollen gerannt");

   return 1;
 }                                    

obduktion( str )
{
notify_fail( "Willst du nicht lieber ein Skelett oder eine Leiche obduzieren?\n" );

if( str == "skelett" || str == "skelette" )
	{
       write(BKS("Es ist ziemlich eindeutig, dass dieses Wesen durch einen Sturz aus sehr grosser Hoehe "
                +"ums Leben kam. Das Skelett weist aeusserst viele Knochenbrueche auf. Die Todesursache "
                +"war hoechstwahrscheinlich ein Genickbruch. Du hast sehr viel Glueck gehabt, dass du "
                +"jetzt noch lebst. Aber diese Skelette, die mit dem Loch im Schaedel, sehen irgendwie "
                +"viel interessanter aus."));
        return 1;
    }


if ( str == "skelett mit loch im schaedel"  || str == "skelett mit loch in schaedel" || str == "skelette mit loch im schaedel" || str == "skelette mit loch in schaedel")
    {
      write(BKS("Sehr interessant. Dieses Skelett weist keinen Knochenbruch auf. Lediglich im Schaedel "
               +"ist ein zwei Finger breites Loch zu entdecken. Das Loch ist fein saeuberlich hineingebohrt "
               +"worden. Der Rest des Skelettes ist voellig unversehrt. Aber wie diese Person ums Leben kam, "
               +"wirst du an einem nackten Skelett kaum herausbekommen. Vielleicht kannst du ja auch so eine "
               +"Leiche mit Loch im Schaedel obduzieren?"));
        return 1;
    }

if ( str == "leiche mit loch im schaedel" || str == "leiche mit loch in schaedel" || str == "leiche mit loch im kopf" )
    {
       write(BKS("Du beginnst bei deiner Obduktion mit den aeusseren Merkmalen. Da der Leichnam schon laenger hier "
            +"unten liegt, ist bereits die Totenstarre eingetreten. Die Kleidung ist blutverschmiert, aber nicht "
            +"zerrissen. Du entfernst sie jetzt, um den Koerper genauer untersuchen zu koennen. Der nun nackte Koerper "
            +"weist keine Schnitt- oder Stichverletzungen auf, lediglich einige Haematome, "
            +"die aber unmoeglich die Todesursache sein koennen. Unter den Fingernaegeln, die du zur genaueren Untersuchung "
            +"kurzerhand aus dem Nagelbett reisst, finden sich einige Hautfetzten, die auf einen Kampf deuten lassen. "
            +"Die Augen sind stark blutunterlaufen. "));
        write("\n");
        write(BKS("Du gehst nun zu den weiter innen liegenden Bereichen ueber."));
        write(BKS("Im Rachenbereich befindet sich eine graue, zaehfluessige Masse. Bei genauerem Hinsehen entpuppt sie sich als "
            +"Gehirnmasse. Auch in den Nasenhoehlen ist sie zu finden. Durch das Loch im Schaedel kannst du auch den Ort "
            +"sehen, wo sich diese Masse eigentlich befinden soll, aber dort ist jetzt nur noch eine gaehnende Leere. Es "
            +"hat den Anschein, als ob hier jemand seinen Opfern das Gehirn aussaugt."));
        return 1;
    }
if ( str == "leiche" || str == "leichen" )
    {
      write(BKS("Die meisten Leichen sehen recht matschig aus, so als ob sie aus grosser Hoehe einfach "
              +"auf dem Boden zerplatzt sind. Die willst du gar nicht genauer untersuchen. Aber an die Skelette "
              +"traust du dich bestimmt."));
      return 1;
    }

return 0;
}                                       

klopfen( str )
  {
    notify_fail( "Wolltest du etwa auf den Boden klopfen?\n" );
    if (str=="" || "auf den boden" || str == "auf boden" )
       {
         tell_room(environment(this_player()), capitalize(this_player()->Name())+" klopft auf den Boden.\n",({this_player()}));
         write(BKS("Du klopfst auf den Boden. Aber das Geraeusch aehnelt nicht dem, "
                +"welches aus dem Suedwesten an dein Ohr dringt.\n"));
         return 1;
       }
    return 0;
  }                                    

detail_func()
{
int anzahl;
string name;
name=this_player()->Name();

 if (!member(heil_merk, name)) 
   {
    heil_merk += ([name: 1]);
    write(BKS("Du spuerst, wie die Kraft des Saftes deinen Koerper durchstroemt.\n"));
    this_player()->heal_self(HEALING);

	  write_file (LOG,
	        sprintf ("%s  %s hat sich durch den Saft heilen lassen.\n",
	        dtime(time()), capitalize(this_player()->query_real_name())));
       
          if(find_player("zaknafein")) tell_object(find_player("zaknafein"), 
                       break_string(capitalize(this_player()->query_real_name())
                              +" heilt sich durch den Saft!", 78, 
                               "ILL0: "));

   }
 else
    {
      anzahl = heil_merk[name];
       if(anzahl<MAX_HEALING)
        {
         heil_merk[name] += 1;
         write(BKS("Wunderbar, die Kraft durchstroemt dich zum "+zahl[heil_merk[name]]+" mal.\n"));
         this_player()->heal_self(HEALING);
        }
       else
        {
         write(BKS("Die Kraft scheint schwach geworden zu sein. Du solltest ihr mehr Ruhe goennen.\n"));
        }
    }
  return "";
}                                      


wuehlen( str )
{
int anzahl;
string name;
name=this_player()->Name();

notify_fail("Worin willst du herumwuehlen?\n" );
  if ( str == "in ausruestung" || str == "in ausruestung herum" || str == "ausruestung" )
  {
    if (!member(fackel_merk, name))
    {
      fackel_merk += ([name: 1]);
      write(BKS("Du wuehlst in der Ausruestung deiner verstorbenen Abenteuererkollegen herum, "
            +"und mit deinem Spuersinn findest du auch bald etwas Brauchbares.\n"));
      write(BKS("Du findest eine Fackel, und steckst sie sofort ein.\n"));
      clone_object("/obj/fackel")->move(this_player());
      return 1;
    }
    else
    {
      anzahl = fackel_merk[name];
      if(anzahl<MAX_TORCH)
      {
        fackel_merk[name] += 1;
        write(BKS("Du durchwuehlst die Ausruestung ein weiteres Mal "
                +"und findest doch tatsaechlich noch eine Fackel.\n"));
        clone_object("/obj/fackel")->move(this_player());
        return 1;
      }
      else
      {
        write(BKS("Du durchsuchst die Ausruestung deiner abgestuerzten Kameraden vergeblich.\n"));
        return 1;
      }
    }
  }
return 0;
}

reset()
{
  ::reset();
  fackel_merk = ([]);
  heil_merk =([]);
}


