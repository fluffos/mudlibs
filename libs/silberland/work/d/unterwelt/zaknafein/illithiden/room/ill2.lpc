/* Weg zu den Illithiden
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDROOM;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Hoehle weit unter der Erde" );
  SetProp(P_INT_LONG, "Mutig schreitest du durch die Dunkelheit der riesigen Hoehle. "
        +"Weder von den Waenden noch von der Decke kannst etwas erkennen. Die kleine Huette "
        +"dagegen ist nun deutlich sichtbar. In dem Widerschein der Fenster meinst du "
        +"sogar einen Baum vor ihr ausmachen zu koennen. Das Licht, dass vom Bauwerk im "
        +"Sueden herueberscheint, reicht noch nicht aus, um Einzelheiten erkennen zu koennen.");

  AddDetail( ({ "wand" , "waende" }) ,
    "Du kannst keine in der Dunkelheit ausmachen.\n");
  AddDetail( ({ "decke" }) ,
    "Du versuchst angestrengt in der Dunkelheit ueber dir die Decke zu erkennen, aber du "
   +"kannst sie beim besten Willen nicht ausmachen.\n");
  AddDetail( ({ "boden" }) ,
     "In der Dunkelheit erkennst du den kalten Fels unter dir nur schlecht. Trotzdem "
    +"meinst du einen Weg ausmachen zu koennen, der hier von Nordwesten nach Sueden "
    +"weiterfuehrt.\n");
  AddDetail( ({ "hoehle" , "riesige hoehle" }) ,
    "Diese Hoehle muss wahrlich riesige Ausmasse haben.\n");
  AddDetail( ({ "ausmass" , "ausmasse" }) ,
    "Das Ausmass der Hoehle muss riesig sein.\n");
  AddDetail( ({ "wille" , "willen" }) ,
    "Hoffentlich wird dir hier kein anderer aufgezwungen.\n");


  AddDetail( ({ "fels", "felsen" , "gestein"}) ,
    "Das schwarze Gestein wirkt kalt und bedrohlich auf dich.\n");
  AddDetail( ({ "dunkelheit" , "dunkel" }) ,
     "Die kleine Huette ist das Einzige, was du in der Dunkelheit gut erkennen kannst.\n");
  AddDetail( ({ "einzige" , "suedwesten"}) ,
    "Die kleine Huette liegt Suedwesten.\n");


  AddDetail( ({ "einzelheit" , "einzelheiten" }) ,
    "Das Bauwerk ist einfach noch zu weit weg.\n");
  AddDetail( ({ "bauwerk", "bau" ,"werk" }) ,
    "Das Bauwerk ist noch so weit von dir entfernt, dass du noch keine Einzelheiten "
   +"erkennen kannst.\n");
  AddDetail( ({ "sueden" }) ,
    "Dorthin fuehrt dich der Weg.\n");
  AddDetail( ({ "weg" }) ,
    "Eigentlich liegen hier nur keine Steine auf dem Boden.\n");
  AddDetail( ({ "steine" , "stein" }) ,
    "Gleich neben dir liegen einige herum, nur hier nicht. Es sieht so aus, als ob "
   +"hier oefters mal jemand vorbei kommt.\n");

  AddDetail( ({ "huette" , "haus" }) ,
     "Im Suedwesten liegt eine kleine Huette. Im Widerschein der Fenster meinst du "
    +"einen Baum davor erkennen zu koennen. Die Huette wirkt winzig und verloren in "
    +"dieser riesigen Hoehle. Aber mehr kannst du von hier nicht erkennen.\n");
  AddDetail( ({ "widerschein" , "schein" , "fenster"}) ,
    "Die Fenster der Huette strahlen ein gruenliches Licht aus. Im Schein des "
   +"Lichts erkennst du die Silhouette eines Baumes.\n");
  AddDetail( ({ "licht" , "farbe" , "gruen" }) ,
    "Die Farbe des Lichts ist unnatuerlich gruen.\n");
  AddDetail( ({ "silhouette" , "umriss" }) ,
    "Im Gegenlicht kannst du von hier aus nicht mehr als den Umriss erkennen.\n");
  AddDetail( ({ "gegenlicht" }) ,
     "Das Licht kommt dir von der Huette entgegen.\n");
  AddDetail( ({ "baum" }) ,
     "Von hier sieht er aus, wie ein ganz normaler Baum. Er scheint nur keine Blaetter "
    +"zu haben, was in der Dunkelheit hier kaum verwundert. Aber wie kann der Baum "
    +"hier unten nur ueberleben?\n");
  AddDetail( ({ "blatt" , "blaetter" }) ,
    "Was soll er auch damit hier unten, wo es hier eh kaum Licht gibt.\n");
  AddDetail( ({ "feuer" , "kaminfeuer" }) ,
    "Vielleicht ist der Bewohner der Huette ja so nett, und laesst es zu, "
   +"dass du dich an seinem Feuer aufwaermst?\n");
  AddDetail( ({ "bewohner", "besitzer" }) ,
    "Hoffentlich ist er nett zu dir.\n");
  AddDetail( ({ "kamin" }) ,
    "Vielleicht besitzt die Huette ja einen Kamin?\n");


  AddSmell( DEFAULT_SMELL , "Der Geruch von Feuer ist hier zu riechen.\n");
  AddSmell( ({ "geruch" , "feuer" }) ,
         "Vielleicht brennt ja in der Huette ein Kaminfeuer, "
        +"an dem du dich aufwaermen koenntest?\n");

  AddSound( DEFAULT_SOUND , "Du hoehrst entfernte Klopfgeraeusche.\n");
  AddSound( ({ "klopfen", "klopfgeraeusch", "klopfgeraeusche" , "geraeusch" }),
               "Irgendwo scheint jemand den Fels zu bearbeiten.\n");




  AddExit("nordwesten", ROOM("ill1"));
  AddExit( "sueden" , ROOM("ill3"));

}

