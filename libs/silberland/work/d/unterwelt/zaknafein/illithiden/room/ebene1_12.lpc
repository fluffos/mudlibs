#include "../files.h"

inherit STDEBENE1;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();



  AddExit("nordwesten", ROOM("ebene1_11"));
  AddExit("nordosten", ROOM("ebene1_13"));
  AddItem(NPC("illithid"), REFRESH_DESTRUCT, ([ P_MNPC_DEFAULTROOM : ROOM("ebene1_12"), 
			                        P_MNPC_AREA : ROOM("ebene1") ]) );

}