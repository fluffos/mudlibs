// Standardraum - Ebene 3 
// Zaknafein, Mai 2001 

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>

void create()
{

   ::create();

  SetProp( P_INT_SHORT, "Innerhalb der Illithidenburg auf Ebene 3");
  SetProp( P_INT_LONG, "Die Waende dieses Ganges sind mit einer scheinbar organischen "
                     +"Substanz bedeckt. Zaeher Schleim tritt hier und dort aus ihr aus "
                     +"und rinnt die Waende hinab. Du kannst von hier aus nach "
                     +"@@ausgaenge_str@@"
                     +" weitergehen. "
                     +"@@nachoben_str@@"
                     +"@@nachunten_str@@");
               
  SetProp (P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30,
                           ENV_TERRAIN: TT_HOUSE]) );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );

  AddSmell( DEFAULT_SMELL , "\n");
  AddSmell( ({ "", ""}) , "\n");
  AddSound( DEFAULT_SOUND , "\n");
  AddSound( ({ "", "" }), "\n");

}


string nachoben_str()
{
string *ausgaenge_a;
ausgaenge_a = allocate(sizeof(QueryProp(P_NEW_EXITS)));

ausgaenge_a = m_indices(QueryProp(P_NEW_EXITS));

if(member(ausgaenge_a, "suedoben" ) != -1)
 return "Wende dich nach suedoben, um eine grosse Kammer zu betreten.";

if(member(ausgaenge_a, "nordoben" ) != -1)
 return "Hier fuehrt ein Gang nach nordoben zu einer grossen Kammer.";

if(member(ausgaenge_a, "westoben" ) != -1)
 return "Du kannst eine grosse Kammer betreten, wenn du nach westoben gehst.";

if(member(ausgaenge_a, "ostoben" ) != -1)
 return "Der Ausgang nach ostoben fuehrt dich zu einer grossen Kammer.";

return "";
}

string nachunten_str()
{
string *ausgaenge_map;

ausgaenge_map=QueryProp(P_EXITS);

if(member(ausgaenge_map, "nordwestunten" ) == 1)
 return "Willst du zurueck zur zweiten Ebene, so gehe nach nordwestunten.";

if(member(ausgaenge_map, "nordostunten" ) == 1)
 return "Gehst du nach nordostunten, so gelangst du wieder zur zweiten Ebene.";

if(member(ausgaenge_map, "suedwestunten" ) == 1)
 return "Ein Gang fuehrt nach suedwestunten zur zweiten Ebene.";

if(member(ausgaenge_map, "suedostunten" ) == 1)
 return "Die zweite Ebene erreichst du, wenn du hier nach suedostunten gehst.";
return "";
}

string ausgaenge_str()
{
string *ausgaenge_map;

string ausgabe_str;

ausgabe_str="";
ausgaenge_map=QueryProp(P_EXITS);

if(member(ausgaenge_map, "suedwesten" ) == 1)
ausgabe_str = "suedwesten";

if(member(ausgaenge_map, "nordosten" ) == 1)
 if(ausgabe_str=="") ausgabe_str = ausgabe_str+"nordosten";
   else  ausgabe_str = ausgabe_str+" oder nach nordosten";


if(member(ausgaenge_map, "nordwesten" ) == 1)
 if(ausgabe_str=="") ausgabe_str = ausgabe_str+"nordwesten";
   else  ausgabe_str = ausgabe_str+" oder nach nordwesten";

if(member(ausgaenge_map, "suedosten" ) == 1)
 if(ausgabe_str=="") ausgabe_str = ausgabe_str+"suedosten";
   else  ausgabe_str = ausgabe_str+" oder nach suedosten";

return ausgabe_str;
}
