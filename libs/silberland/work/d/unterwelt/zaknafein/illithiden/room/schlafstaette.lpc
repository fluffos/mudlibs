/*    
**        Schlafstaette der Sklaven im Steinbruch der Illithiden
**
**                     Zaknafein, Februar 2000
*/



inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

int freigelegt=0;
int krautda=3; 

create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "Schlafstaette der Sklaven" );
  SetProp(P_INT_LONG,
    "Hier befindet sich die Schlafstaette der Sklaven, die hier im Steinbruch " 
   +"arbeiten. Momentan befindet sich kein Sklave hier. Du bist Dir auch sicher, "
   +"dass die Schlafstaette kaum von den Sklaven genutzt werden kann. Die Illithiden "
   +"goennen ihnen nur sehr wenig Ruhe. Der Boden ist mit Stroh bedeckt. In einer "
   +"Ecke dient ein kleines Wasserloch als Toilette. Es riecht bestialisch nach "
   +"Faekalien."
   );


  AddDetail( "faekalien" ,
    "Riechst Du das etwa nicht?\n");  
  AddDetail( ({ "wand" , "waende" }) ,
    "Die Waende bestehen auch hier aus Fels.\n");  
  AddDetail( "boden" ,
    "Der Boden ist mit Stroh bedeckt, auf dem die Sklaven schlafen.\n");
  AddDetail( "stroh" ,
    "Das Stroh ist schon ziemlich plattgedrueckt. Sehr angenehm ist es wohl nicht, "
   +"auf ihm zu schlafen. In dem Stroh faellt Dir etwas auf.\n");
  AddDetail( "etwas" ,
    "Es sieht so aus, als ragte eine Hand aus dem Stroh.\n");
  AddDetail( "hand" ,
    "An der Hand erkennst Du Spuren der Verwesung. Der zugehoerige Koerper muesste "
   +"sich noch unter dem Stroh befinden.\n");
  AddDetail( ({ "spuren" , "verwesung" }) ,
    "Das verraet Dir die blaeulichgruene Farbe.\n");
  AddDetail( "farbe" ,
    "Die Farbe deutet deutlich auf Verwesung hin.\n");
  AddDetail( "koerper" ,
    "Er liegt noch unter dem Stroh. Vielleicht kann man ihn ja freilegen.\n");
  AddDetail( "ecke" ,
    "In einer Ecke der Schlafstaette befindet sich ein Wasserloch, von dem ein uebler "
   +"Geruch ausgeht.\n");                 
  AddDetail( "wasser" ,
    "Das Wasser ist braeunlich gefaerbt und stinkt ekelhaft.\n");
  AddDetail( ({ "loch" , "wasserloch" }) ,
    "Zum Glueck musst Du grad nicht...\n");
  AddDetail( "glueck" ,
    "Wenn Du unbedingt willst, kannst Du aber trotzdem.\n");
  AddDetail( "toilette" ,
    "Das Wasserloch dient als Toilette, weshalb es hier auch so stinkt.\n");
  AddDetail( ({ "staette" , "schlafstaette" }) ,
    "Naja, diese Schlafstaette erinnert eher an einen Stall.\n");
  AddDetail( "stall" ,
    "Die Sklaven werden hier wie Vieh gehalten.\n");
  AddDetail( "vieh" ,
    "Nein, selbst Vieh wird respektvoller behandelt.\n");
  AddDetail( ({ "ruhe" , "pause" }) ,
              "Die Illithiden goennen ihren Sklaven keine Pause.\n");          
  AddDetail( ({ "sklave" , "sklaven" }) ,
    "Hier in der Schlafstaette befinden sich momentan keine. Sie arbeiten alle.\n");
  AddDetail( "haemmern" ,
    "Lausche doch mal.\n");
  AddDetail( "decke" ,
    "Die Decke besteht aus Fels.\n");
  AddDetail( "fels" ,
    "Fels, wie Du ihn ueberall im Steinbruch findest.\n");
  AddDetail( "illithiden"  ,
    "Die Illithiden kommen wohl kaum hierher.\n" );
  AddDetail( ({ "bruch" , "steinbruch" , "steinbruches" })  ,
    "Du willst nur weg von hier!\n" );
  AddDetail( ({ "nase" , "Ohren" , "ohr"  })  ,
    "Noch hast Du eine Nase und zwei Ohren, was sich hier aber schnell aendern kann.\n" );  
  AddSmell( DEFAULT_SMELL , "Es riecht hier bestialisch nach Faekalien.\n");
  AddSmell( ({ "wasser" , "geruch" , "faekalien" }) , 
                                "Du steckst Deine Nase tief in das Wasserloch und "
                               +"schnupperst ausgiebig. Du beginnst zu wuergen.\n");
  AddSound( DEFAULT_SOUND , "Leise dringt Haemmern in Deine Ohren.\n");
  AddSound( "haemmern" , "Hier ist das Haemmern nicht so laut. Es laesst sich aushalten.\n");

  AddCmd( ({ "leg" , "lege" }) , "legen" );
  AddCmd( ({ "durchsuche" , "durchsuch" }) , "durchsuchen" );
  AddExit("nordoben" , ROOM("steinbruch2"));
  AddExit("norden" , ROOM("steinbruch2"));
  SetProp(P_HIDE_EXITS, ({"norden"}) ); 
} 

reset()
{
  ::reset();
  freigelegt=0;
  krautda=3;
  RemoveDetail( ({ "koerper" , "anblick" , "hand" }) );
  AddDetail( "hand" ,
    "An der Hand erkennst Du Spuren der Verwesung. Der zugehoerige Koerper muesste "
   +"sich noch unter dem Stroh befinden.\n");
  AddDetail( "koerper" ,
    "Er liegt noch unter dem Stroh. Vielleicht kann man ihn ja freilegen.\n");
}

legen( str )
{
if( str == "koerper frei" || str == "leiche frei" || str == "den koerper frei" )
	{
           write(BKS("Du wuehlst im Stroh und legst den Koerper frei. "
                    +"Ein scheusslicher Anblick!\n"));
           say(capitalize(this_player()->name(WER,2)+" wuehlt im Stroh herum.\n"), this_player());
           freigelegt=1;
           RemoveDetail( ({ "hand" , "koerper" }) );
           AddDetail( "hand" ,
                "An der Hand erkennst Du Spuren der Verwesung. Der zugehoerige Koerper wurde "
               +"vor kurzem freigelegt.\n");
           AddDetail( "koerper" ,
                "Der Koerper wurde vor kurzem freigelegt. Schon durchsucht?\n");
           AddDetail( "anblick" ,
                "Als Du den Koerper genauer betrachtest, faellt Dir ein "
               +"blutrotes Stirnband auf.\n");
           AddDetail( ({ "stirnband" , "band" })  ,
                "Ein blutrotes Stirnband... Sehr interessant...\n");
           return 1;
        }
return 0;	
}

durchsuchen(str)
{
        notify_fail( "Wie bitte?\n" );
	if( str == "koerper" || str == "den koerper" || str == "leiche" )
	{
	  if(freigelegt==1)
            {
                object ob;
                if (krautda != 0) 
                {
                 if (ob=deep_present(("\nzakkraut"), this_player()))
                   {
                   write(BKS("Du findest leider nichts mehr.\n"));
                   return 1;
                   }
                   else
                   {
                   krautda=krautda - 1;
                   write(BKS("Du durchsuchst den Koerper und findest tatsaechlich etwas, "
                            +"was Du sofort an Dich nimmst.\n"));  
                   clone_object(OBJ("kraut"))->move(this_player(), M_NOCHECK);  
                   say(capitalize(this_player()->name(WER,2)+" durchsucht einen Koerper.\n"), this_player());
                   return 1;
                   }
                }
                else
                {
                write(BKS("Du findest leider nichts mehr.\n"));
                return 1;
                }
            }
         }
        return 0;
}
