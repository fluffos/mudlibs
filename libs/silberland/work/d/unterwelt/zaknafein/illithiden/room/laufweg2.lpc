/* Laufweg der Sklaven
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDLAUFWEG;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Laufweg der Sklaven");

  AddExit("nordwestunten", ROOM("laufweg1"));
  AddExit("nordwesten", ROOM("laufweg1"));
  AddExit( "suedwestoben" , ROOM("laufweg3"));
  AddExit( "suedwesten" , ROOM("laufweg3"));
  SetProp(P_HIDE_EXITS, ({ "nordwesten" , "suedwesten" }));
}

