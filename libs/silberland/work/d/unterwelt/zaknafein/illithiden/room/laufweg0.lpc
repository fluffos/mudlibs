/* Laufweg der Sklaven
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDLAUFWEG;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>



create()
{
  ::create();


  AddExit("nordwestunten", ROOM("ill7"));
  AddExit("nordwesten", ROOM("ill7"));
  AddExit( "suedostoben" , ROOM("laufweg1"));
  AddExit( "suedosten" , ROOM("laufweg1"));
  SetProp(P_HIDE_EXITS, ({ "nordwesten" , "suedosten" }));
}

