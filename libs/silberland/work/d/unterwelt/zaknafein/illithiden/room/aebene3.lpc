/*     
**               Astralebene - Feuer
**
**            Zaknafein, Februar 2000
**
*/

inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:60,ENV_TERRAIN:TT_DESERT])); 
  SetProp(P_INT_SHORT, "" );
  SetProp(P_INT_LONG,
    "Du fragst Dich, ob Du geradewegs in die Hoelle geflogen bist, "
   +"denn um Dich herum siehst Du nur Feuer und es ist hoellisch "
   +"heiss. Der Boden ist ein einziges Flammenmeer und um Dich "
   +"herum tanzen tausende Flammen.\n");

  AddDetail( "flamme" ,
    "Zum Greifen nahe kommt sie an Dich heran.\n");
  AddDetail( "greifen" ,
    "Ja, zum Greifen nahe...\n");
  AddDetail( "flammen"  ,
    "Die Flammen fuehren einen eigenartigen, toedlichen Tanz um Dich "
   +"herum auf.\n");
  AddDetail( "tanz" ,
    "Besonders eine Flamme huscht staendig sehr dicht an Dir vorbei. "
   +"Die Hitze, die sie dabei ausstrahlt, bekommt Dir nicht sehr gut.\n");
  AddDetail( "hitze",
    "Die Hitze ist unertraeglich.\n");
  AddDetail( ({ "meer" , "flammenmeer" , "boden" }) ,
    "Der Boden ist ein einziges Flammenmeer.\n");
  AddDetail( "hoelle",
    "Nein, in der Hoelle ist es kuehler.\n");
  AddDetail( "himmel",
    "Am Himmel erkennst Du Wolken aus Flammen.\n");
  AddDetail( "wolken",
    "Selbst die Wolken bestehen hier aus Feuer.\n");
  AddDetail( "feuer",
    "Das Feuer hier kommt Dir besonders heiss vor.\n");
  AddDetail( "teufel",
    "Den Teufel siehst Du hier nicht. Ist ihm wohl zu heiss.\n");

  AddSmell( DEFAULT_SMELL , "Es riecht nach Feuer.\n");
  AddSound( DEFAULT_SOUND , "Lautes Knistern ertoent in Deinen Ohren.\n");
  AddSound( "knistern" , "Das Knistern ist extrem laut.\n");
 
AddCmd( ({ "greife" , "greif" , "fange" , "fang" }) , "fangen" ); 

AddSpecialExit("suedwesten" , "sw" );

} 

sw()
{
write("Du fliegst nach Suedwesten.\n");
this_player()->move(ROOM("aebene1"), M_GO , "" ,
       "fliegt nach Suedwesten", 
       "kommt hereingeflogen");
return 1;
}

fangen(str)
{
notify_fail( "Was moechtest Du denn einfangen?\n");
if( str == "flamme" || str == "flamme ein" || str == "flamme" || str == "nach flamme" )
{
  object ob;
  if (ob=deep_present(("\nzakfeuer"), this_player()))
  {
    write(BKS("Nein, Du hast schon eine Flamme.\n"));
  }
  else
  {
    write(BKS("Geschickt faengst Du eine Flamme ein. Was machst Du jetzt "
             +"nur damit. Auf jeden Fall ist sie hoellisch heiss!\n"));
    clone_object(OBJ("feuer"))->move(this_player(), M_NOCHECK);      
  }
return 1;
}
return 0;
}