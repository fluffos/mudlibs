/* Kochstelle der Sklaven
** Zaknafein, Mai 2001
*/

#include "../files.h"
inherit "std/pub";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <pub.h>

create()
{
  ::create();

  RemoveItem("/obj/topliste");

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Kochstelle der Sklaven");

  SetProp (P_INT_LONG, "Hier befindet sich die Kochstelle, wo alle Sklaven mit Essen versorgt "
                      +"werden. Das Essen wird in einem grossen Kessel ueber dem offenen Feuer zubereitet. "
                      +"Einige Sklaven sitzen hier auf dem Boden und loeffeln ihre duenne Suppe aus. "
                      +"@@koch_func@@"); 

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "kerg");
  SetProp(P_PUBKEEPER_NAME, "kerg");
  SetProp(P_PUBMSG_NOKEEPER, "Irgendwie ist der Koch nicht da.\n");
  SetProp(P_PUBMSG_NOENEMY, "Kerg gibt dir sicherlich nichts mehr.\n");
  SetProp(P_PUBMSG_NOINVITE, "Kerg gibt seinen Feinden sicherlich nichts.\n");
  SetProp(P_PUBMSG_FIGHTING, "Kerg kaempft gerade um sein Leben. Da wird er wohl "
			    +"kaum die Nerven haben, dir was zu bringen.\n");


  AddDetail ( ({"kochstelle","stelle"}), 
    "Notgedrungen mussten die Illithiden eine Kochstelle einrichten. Sie haben gelernt, dass "
   +"ihre Sklaven sehr schnell sterben, wenn sie nicht versorgt werden.\n");
  AddDetail ( ({ "kessel", "topf" }) , 
    "Der riesige Kessel besteht aus Kupfer. Er ist mit Suppe gefuellt.\n");
  AddDetail ( "suppe", 
    "Die Suppe ist sehr duenn. Nur sehr wenig Fleisch befindet sich darin.\n");
  AddDetail ( "kupfer", 
    "Das Kupfer glaenzt nicht mehr rotbraun, da es inzwischen angelaufen ist.\n");
  AddDetail ( "fleisch", 
    "Du hast keine Ahnung, was fuer Fleisch das sein koennte, das in der Suppe schwimmt.\n");
  AddDetail ( "ahnung", 
    "Doch, eine duestere Ahnung steigt in dir auf. Es koennte das Fleisch toter Sklaven sein.\n");
  AddDetail ( "essen", 
    "Vielleicht gibt dir der Koch ja auch etwas? Mit 'Menue' kannst du dir anschauen, was es hier so gibt.\n");
  AddDetail ( "boden", 
    "Auf dem hartenb, felsigen Boden sitzen einige Sklaven und loeffeln ihre Suppe aus.\n");
  AddDetail ( ({ "sklaven", "sklave" }) , 
    "Die Sklaven sehen sehr abgemagert aus. Der Koch scheint sie nur unzureichend zu versogen.\n");
  AddDetail ( ({ "waende", "wand" }) , 
    "Waende gibt es hier nicht.\n");
  AddDetail ( "decke" , 
    "Die Decke dieser riesigen Hoehle kannst du nicht erkennen.\n");
  AddDetail ( "hoehle" , 
    "Du befindest dich in einer riesigen, unterirdischen Hoehle.\n");
  AddDetail ( "koch", 
    "Tja, wo ist nur der Koch?");
  AddDetail ( ({ "fels", "felsen" }) , 
    "Der Boden besteht aus hartem Fels.\n");
  AddDetail ( ({ "besteck" , "loeffel", "teller" }) , 
    "Die Sklaven essen ihre Suppe aus alten, verbeulten Tellern.\n");
  AddDetail ( ({ "feuer", "feuerstelle"  }) , 
    "Ueber dem Feuer haengt ein grosser Kessel aus Kupfer.\n");
  AddDetail ( "raetsel" , 
    "Es gibt hier sicher interessantere Raetsel, die es zu loesen gilt.\n");
  AddDetail ( "holz", 
    "Woher das Holz fuer das Feuer kommt, ist dir ein Raetsel.\n");
  AddDetail ( "loeffel" , 
    "Die Loeffel sind schon voellig verrostet.\n");
  AddDetail ( "menue", 
    "Gib einfach 'Menue' ein, dann erfaehrst du, was es hier gibt.\n");
  AddDetail ( ({ "illithiden", "illithide" }) , 
    "Du bisher auf der gesamten Sklaveninsel keinen einzigen Illithiden gesehen. "
   +"Kerg kuemmert sich hier wohl um alles.\n");  
  AddDetail ( ({ "insel", "sklaveninsel" }) , 
    "Die Sklaven leben und arbeiten hier. Die meisten Sklaven befinden sich im Steinbruch.\n");
  AddDetail ( ({ "bruch", "steinbruch" }) , 
    "Der Steinbruch befindet sich oestlich von dir.\n");

  AddSmell ( DEFAULT_SMELL, 
    "Der Schweiss der Sklaven ueberdeckt den Geruch der Suppe, die in dem Kessel brodelt, fast vollstaendig.\n");
  AddSmell (({"schweiss","sklaven"}), 
    "Widerlich.\n");
  AddSmell (({"suppe","geruch","kessel"}), 
    "Du bezweifelst sehr, dass sie gut schmecken wird.\n");
  AddSound (DEFAULT_SOUND,
    "Du hoerst lautes Klopfen.\n");
  AddSound ( ({ "klopfen" }),
    "Es kommt aus dem Steinbruch oestlich von dir.\n");

  AddDrink("Etwas truebes Wasser", ({ "wasser"  }) ,
    550, ({ 25,25,10 }), 0, 1, 
    ({"Der Koch gibt dir ein Glas mit truebem Wasser, das du schnell austrinkst.", 
      "&& trinkt ein Glas Wasser."}) );

  AddDrink("Schnaps", ({ "schnaps"  }) ,
    1250, ({ 50,50,15 }), 3, 2, 
    ({"Du kippst den Schnaps runter und schuettelst dich.", 
      "&& kippt ein Glas mit Schnaps runter."}) );

  AddDrink("Blut des Blutbaumes", ({ "blut" }) ,
    420, ({ 0,25, 30}), 1, 2, 
    ({"Kerg gib dir ein Glas mit einer roten, merkwuerdigen Fluessigkeit. Schnell trinkst du es aus.", 
      "&& trinkt ein Glas mit einer merkwuerdigen, roten Fluessigkeit."}) );

  AddFood("Ein Teller duenne Suppe", ({"suppe"}),    
  350, ({15,15,0}), 2, ({      
     "Du bekommst einen Teller mit duenner Suppe.",  
     "&& loeffelt einen Teller Suppe aus." }) );

  AddFood("Gegrillte Fledermaus", ({"maus","fledermaus"}),    
  900, ({30,30,5}), 4, ({      
     "Du bekommst eine fette Fledermaus, die Kerg ueber dem Feuer gegrillt hat. "
    +"Sie schmeckt eigentlich gar nicht so uebel.",  
     "&& isst eine gegrillte Fledermaus." }) );

  AddFood("Sichelschreckenragout", ({"sichel","schrecken","ragout" ,"sichelschreckenragout"}),    
  1300, ({50,50,0}), 8, ({      
     "Dieses Ragout ist wirklich widerlich! Kerg hat wohl bloss eine Sichelschrecke "
    +"in kleine Stuecke geschnitten und mit etwas Salz und Pfeffer aufgekocht. Du "
    +"musst erst zahlreiche Chitinsplitter entfernen, bevor du es geniessen kannst.",  
     "&& isst Sichelschreckenragout und verzieht dabei das Gesicht." }) );


  AddItem (NPC("kerg"), REFRESH_DESTRUCT);

  AddExit("suedwesten", ROOM("insel0"));
  AddExit( "osten" , ROOM("insel2"));

}

string koch_func()
   {
    if (present("kerg"))
     return "Kerg, der Koch, achtet darauf, dass sie sich beeilen und schnell wieder\n"
           +"in den Steinbruch zurueckgehen.";
    else
     return "Merkwuerdigerweise scheint sich aber im Moment niemand um die Suppe zu kuemmern, \n"
           +"die in dem Kessel brodelt.";
   }



