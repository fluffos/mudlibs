/* Ebene 2 Raum 6  
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDEBENE2;

#include <properties.h>
#include <moving.h>

create()
{
  ::create();

  AddExit("nordwesten", ROOM("ebene2_5"));
  AddExit("suedosten", ROOM("ebene2_7"));
  SetProp(P_HIDE_EXITS, ({"nooben" , "noob" }) );
  AddSpecialExit( "nordostoben" , "noobfkt" );
  AddSpecialExit( "nooben" , "noobfkt" );
  AddSpecialExit( "noob" , "noobfkt" );
}

noobfkt()
{
   object ob;
   if (ob=present(("\nwegitem"), this_player()))
    {
      if(ob->queryeb2()==1)
       {
         this_player()->move(ROOM("ebene3_3"), M_GO , "" , "geht nach nordostoben" , "kommt herein");
         return 1;
       }
    }
   this_player()->move(ROOM("ebene1_"+to_string(random(24))), M_GO , "" , "verschwindet ploetzlich" , "erscheint ploetzlich");
   return 1;
}