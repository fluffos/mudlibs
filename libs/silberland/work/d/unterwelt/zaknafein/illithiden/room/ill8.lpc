/* Weg zu den Illithiden
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDROOM;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>
#include <doors.h>
#include <rooms.h>

create()
{
  ::create();



  AddExit("norden", ROOM("ill7"));

 NewDoor("sueden",ROOM("ebene1_0"), ({ "tor" , "burgtor" }),
  ({D_NAME,"Burgtor",
  D_GENDER,NEUTER,
  D_SHORT,"Im Sueden befindet sich das %se Burgtor.",
  D_LONG,"Das Burgtor ist riesig. Es ist mit Totenschaedeln und mit einem riesigen Gebilde, "
        +"das wie der Kopf eines Illithiden aussieht, verziert.\n",
  D_FLAGS, DOOR_NEEDKEY|DOOR_CLOSED|DOOR_RESET_CL,
  D_FUNC, "wegitem_geben"
  }));
  
}
  
wegitem_geben()
{
 object ob;
   if (ob=present(("\nwegitem"), this_player()))
   {
   }
   else
    clone_object(OBJ("wegitem"))->move(this_player(), M_NOCHECK);
}

