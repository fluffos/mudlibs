/* Kammer, in der sich das 'Elder Brain' befindet
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDROOM;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>


create()
{
  ::create();


  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:37]));
  SetProp (P_INT_SHORT, "Kammer des Elder Brain");

  SetProp (P_INT_LONG, "@@gehirn_da@@"); 

  
  AddDetail ( ({"wand","waende"}), 
    "\n");
  AddDetail ( "boden", 
    "\n");
  AddDetail ( "decke", 
    "Die Decke wird durch eine relativ grosse Kuppel gebildet.\n");
  AddDetail ( "kammer", 
    "Du befindest dich in der Kammer des Elder Brain.\n");
  AddDetail ( ({"elder","brain","elder brain"}), 
    "Seine Ueberreste sind in der ganzen Kammer verteilt.\n");
  AddDetail ( ({"",""}), 
    "\n");
  AddDetail ( ({"",""}), 
    "\n");
  AddDetail ( ({"",""}), 
    "\n");

  AddSmell ( DEFAULT_SMELL, 
    "Es riecht hier sehr unangenehm.\n");
  AddSound (DEFAULT_SOUND,
    "Du hoerst schmatzende Geraeusche...\n");
  AddSound ( ({ "geraeusche" }),
    "Schmatzende Geraeusche...\n");

  AddItem (NPC("brain"), REFRESH_DESTRUCT);

  AddExit("norden", ROOM("ebene3_0"));
  AddExit("sueden", ROOM("ebene3_4"));
  AddExit("osten", ROOM("ebene3_6"));
  AddExit("westen", ROOM("ebene3_2"));


}

string gehirn_da()
   {
    if (present("\nelderbrain"))
     return( "Scheinbar schutzlos liegt das grosse Zentralgehirn, das Elder Brain, in dieser Kammer \n"
             "vor Dir. Diese graeuliche, pulsierende Masse, die fast den ganzen Raum einnimmt \n"
             "und einen abstossenden Geruch verbreitet, steuert die gesamte Illithidengemeinde. \n"
             "Wird es getoetet, so bedeutet dies eine enorme Schwaechung der Illithiden, weshalb \n"
             "es auch einen besonderen Schutz hat, der von den Astralebenen ausgeht.");
    else
     return("Dir tut sich hier ein wahrhaft widerlicher Anblick auf. Waende, Boden und Decke \n"
                "dieser Kammer sind mit Gehirnstuecken und Blut bedeckt. Extrem tapferen Helden \n"
                "muss es gelungen sein, das Elder Brain zu besiegen!");
   }



