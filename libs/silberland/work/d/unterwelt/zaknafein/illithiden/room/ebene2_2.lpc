/* Ebene 2 Raum 2  
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDEBENE2;

#include <properties.h>
#include <moving.h>

create()
{
  ::create();

  AddExit("suedwesten", ROOM("ebene2_3"));
  AddExit("nordosten", ROOM("ebene2_1"));
  AddSpecialExit( "suedostoben" , "soobfkt" );
  AddSpecialExit( "sooben" , "soobfkt" );
  AddSpecialExit( "soob" , "soobfkt" );
  SetProp(P_HIDE_EXITS, ({"sooben" , "soob" }) );
}

soobfkt()
{
   object ob;
   if (ob=present(("\nwegitem"), this_player()))
    {
      if(ob->queryeb2()==0)
       {
         this_player()->move(ROOM("ebene3_1"), M_GO , "" , "geht nach Suedostoben" , "kommt herein");
         return 1;
       }
    }
   this_player()->move(ROOM("ebene1_"+to_string(random(24))), M_GO , "" , "verschwindet ploetzlich" , "erscheint ploetzlich");
   return 1;
}