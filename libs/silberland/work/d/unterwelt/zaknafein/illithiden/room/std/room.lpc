// Standardraum fuer das Illithidengebiet
// Zaknafein, Mai 2001

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>

void create()
{

   ::create();

  SetProp( P_INT_SHORT, "Illithidengebiet");
  SetProp( P_INT_LONG, "Du befindest dich im Reich der Illithiden. Sie haben sich hier in "
                      +"dieser riesigen, unterirdischen Hoehle angesiedelt. Die Gemeinde "
                      +"befindet sich noch im Aufbau. Zahlreiche Sklaven arbeiten an der "
                      +"Illithidenburg, die aus einem riesigen Stalagmiten aus Kalkgestein "
                      +"geschlagen wird.");
               
  SetProp (P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 12,
                           ENV_TERRAIN: TT_CAVE]) );
  AddDetail( ({ "" , "" })  ,
    "\n" );

  AddSmell( DEFAULT_SMELL , "\n");
  AddSmell( ({ "", ""}) , "\n");
  AddSound( DEFAULT_SOUND , "\n");
  AddSound( ({ "", "" }), "\n");
 
}
