create()
{
  ::create();


 AddItem(NPC("vampill"), REFRESH_DESTRUCT, ([ P_MNPC_DEFAULTROOM : ROOM("ebene2_12"), 
			                        P_MNPC_AREA : ROOM("ebene2") ]) );
  AddExit("nordwesten", ROOM("ebene2_13"));
  AddExit("suedwesten", ROOM("ebene2_11"));
}