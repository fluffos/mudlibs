/* Laufweg der Sklaven
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDLAUFWEG;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Laufweg der Sklaven");

  AddExit("suedostunten", ROOM("laufweg6"));
  AddExit("suedosten", ROOM("laufweg6"));
  AddExit( "nordostoben" , ROOM("laufweg8"));
  AddExit( "nordosten" , ROOM("laufweg8"));
  SetProp(P_HIDE_EXITS, ({ "suedosten" , "nordosten" }));
}