// Standardraum - Ebene 1
// Zaknafein, August 2001

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>

void create()
{

   ::create();

  SetProp( P_INT_SHORT, "Innerhalb der Illithidenburg auf Ebene 1");
  SetProp( P_INT_LONG, "Du gehst einen langen, schmalen Gang innerhalb der "
                      +"Illithidenburg entlang. Es scheint so, als haette man "
                      +"die Gaenge direkt aus dem Fels geschlagen. Die Waende sind "
                      +"schneeweiss und gehen nach oben hin weit auseinander. "
                      +"Der Gang fuehrt von hier aus nach "
                      +"@@ausgaenge_str@@"
                      +". "+"@@nachoben_str@@");

  SetProp (P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "illithiden" , "illithide" })  ,
    "Sie lauern hier ueberall! Sehen sie dich hier, werden sie dich sicher sofort angreifen!\n" );
  AddDetail( ({ "burg" , "illithidenburg" })  ,
    "Es muss hier mehr geben als nur die eintoenigen, endloslangen Gaenge.\n" );
  AddDetail( ({ "gang" , "gaenge" })  ,
    "Du fragst dich, wieviele Sklaven wohl ihr Leben lassen mussten, um diese "
   +"Gaenge aus dem blossen Fels zu schlagen. Sie gehen nach oben hin, wo die Illithiden "
   +"schweben, weit auseinander und sind dort auch reich verziert. Der untere, schmale Teil "
   +"des Ganges dient nur Sklaven und Dienern der Illithiden.\n" );
  AddDetail( ({ "sklaven" , "sklave" })  ,
    "Im Moment sind keine hier. Jedenfalls keine lebenden. Am Boden liegen jedoch einige "
   +"Leichen. Es koennte sich dabei um ehemalige Sklaven handeln.");
  AddDetail( ({ "wand" , "waende" })  ,
    "Hier im unteren Teil des Ganges wurde der Fels nur grob bearbeitet. Weiter oben, wo "
   +"sich die Illithiden aufhalten, ist er sehr fein bearbeitet worden und weist zahlreiche "
   +"Verzierungen auf.\n" );
  AddDetail( ({ "fels" , "felsen" })  ,
    "Es handelt sich um den weissen Fels eines riesigen Stalagmiten.\n" );
  AddDetail( ({ "kerg" , "diener" })  ,
    "Kerg ist einer ihrer Diener. Du wirst aber sicher noch andere treffen...\n" );
  AddDetail( ({ "verzierungen" , "verzierung" })  ,
    "Von hier aus kannst du sie nicht genau erkennen. Du bist dir aber sicher, dass sie dir "
   +"wohl eher nicht gefallen duerften.\n" );
  AddDetail( ({ "leichen" , "leiche" })  ,
    "Vielleicht ehemalige Sklaven, aber es koennten natuerlich auch Abenteurer gewesen sein.\n" );
  AddDetail( "abenteurer" ,
    "Zu viele Abenteurer verloren hier schon ihr Leben.\n" );
  AddDetail("boden" ,
    "Auf dem Boden liegen einige Leichen und abgebrochene Steine.\n" );
  AddDetail( "decke" ,
    "Die Decke ist leich nach oben gewoelbt und reichlich verziert.\n" );
  AddDetail( ({ "stalagmiten" , "stalagmit" })  ,
    "Du durftest ihn vorhin schon von aussen bewundern. Vielleicht haettest du dich damit auch "
   +"besser zufriedengeben sollen.\n" );
  AddDetail( "leben" ,
    "Sei hier ja vorsichtig, wenn dir dein Leben lieb ist!\n" );
  AddDetail( ({ "stein" , "steine" })  ,
    "Sie sind Ueberbleibsel der Bauarbeiten hier in der Burg.\n" );
  AddDetail( ({ "ueberbleibsel" , "bauarbeiten" , "arbeit"})  ,
    "Denkst du etwas eine solche Burg entsteht von selbst? Nein! Es ist harte Arbeit!\n" );
  AddDetail( "teil"  ,
    "Werd' jetzt mal nicht unanstaendig. :)\n" );
  AddDetail( "moment"  ,
    "Die meisten Sklaven arbeiten im Moment ausserhalb der Burg.\n" );

  AddSmell( DEFAULT_SMELL , "Die Luft hier in der Burg ist recht frisch.\n");
  AddSound( DEFAULT_SOUND , "Hier herrscht eine unheimliche Stille. Sei leise, sonst bemerken dich die Illithiden noch!\n");
  AddSound("stille", "Wenn du nicht leise bist, wird man dich sofort bemerken!\n");
}

string ausgaenge_str()
{
string *ausgaenge_a;
ausgaenge_a = allocate(sizeof(QueryProp(P_EXITS)));

ausgaenge_a = m_indices(QueryProp(P_EXITS));
return ausgaenge_a[0]+" und nach "+ausgaenge_a[1];
}

string nachoben_str()
{
string *ausgaenge_a;

ausgaenge_a=QueryProp(P_HIDE_EXITS);
if(ausgaenge_a==0) return "";

if(member(ausgaenge_a, "soob" ) != -1)
 return "\nAusserdem geht es hier nach suedostoben zur naechst hoeheren Ebene.";

if(member(ausgaenge_a, "noob" ) != -1)
 return "\nHier fuehrt ein Gang nach nordostoben zur naechst hoeheren Ebene.";

if(member(ausgaenge_a, "nwob" ) != -1)
 return "\nGehst du nach nordwestoben so gelangst du zur naechst hoeheren Ebene.";

if(member(ausgaenge_a, "swob" ) != -1)
 return "\nDer Ausgang nach suedwestoben fuehrt dich zur naechst hoeheren Ebene.";


}