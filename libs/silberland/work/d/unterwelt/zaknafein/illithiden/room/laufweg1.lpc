/* Laufweg der Sklaven
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDLAUFWEG;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Laufweg der Sklaven");

  AddExit("nordwestunten", ROOM("laufweg0"));
  AddExit("nordwesten", ROOM("laufweg0"));
  AddExit( "suedostoben" , ROOM("laufweg2"));
  AddExit( "suedosten" , ROOM("laufweg2"));
  SetProp(P_HIDE_EXITS, ({ "nordwesten" , "suedosten" }));
}

