// Standardraum - Ebene 2
// Zaknafein, August 2001 

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>

void create()
{

   ::create();

  SetProp( P_INT_SHORT, "Innerhalb der Illithidenburg auf Ebene 2");
  SetProp( P_INT_LONG, "Die Gaenge hier auf der zweiten Ebene der Illithidenburg unterscheiden "
                     +"sich sehr stark von den Gaengen auf der ersten Ebene. Sie sind wesentlich "
                     +"breiter und viel niedriger. Was dich jedoch am meisten irritiert, ist die "
                     +"blutrote Farbe der Felsen aus denen die Wand besteht. Der Gang fuehrt von "
                     +"hier aus nach "
                     +"@@ausgaenge_str@@"
                     +". "
                     +"@@nachoben_str@@"
                     +"@@nachunten_str@@");
               
  SetProp (P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 24,
                           ENV_TERRAIN: TT_HOUSE]) );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );
  AddDetail( ({ "" , "" })  ,
    "\n" );

  AddSmell( DEFAULT_SMELL , "\n");
  AddSmell( ({ "", ""}) , "\n");
  AddSound( DEFAULT_SOUND , "\n");
  AddSound( ({ "", "" }), "\n");

}


string nachoben_str()
{
string *ausgaenge_a;

ausgaenge_a=QueryProp(P_HIDE_EXITS);
if(ausgaenge_a==0) return "";

if(member(ausgaenge_a, "soob" ) != -1)
 return "\nAusserdem geht es hier nach suedostoben zur naechst hoeheren Ebene.";

if(member(ausgaenge_a, "noob" ) != -1)
 return "\nHier fuehrt ein Gang nach nordostoben zur naechst hoeheren Ebene.";

if(member(ausgaenge_a, "nwob" ) != -1)
 return "\nGehst du nach nordwestoben so gelangst du zur naechst hoeheren Ebene.";

if(member(ausgaenge_a, "swob" ) != -1)
 return "\nDer Ausgang nach suedwestoben fuehrt dich zur naechst hoeheren Ebene.";


}

string nachunten_str()
{
string *ausgaenge_map;

ausgaenge_map=QueryProp(P_EXITS);

if(member(ausgaenge_map, "nordwestunten" ) == 1)
 return "\nWillst zurueck zur ersten Ebene, so gehe nach nordwestunten.";

if(member(ausgaenge_map, "nordostunten" ) == 1)
 return "\nGehst du nach nordostunten, so gelangst du wieder zur ersten Ebene.";

if(member(ausgaenge_map, "suedwestunten" ) == 1)
 return "\nEin Gang fuehrt nach suedwestunten zur ersten Ebene.";

if(member(ausgaenge_map, "suedostunten" ) == 1)
 return "\nEin Fluchtweg nach suedostunten zur ersten Ebene steht dir hier offen.";
return "";
}

string ausgaenge_str()
{
string *ausgaenge_map;

string ausgabe_str;

ausgabe_str="";
ausgaenge_map=QueryProp(P_EXITS);

if(member(ausgaenge_map, "suedwesten" ) == 1)
ausgabe_str = "suedwesten";

if(member(ausgaenge_map, "nordosten" ) == 1)
{
 if(ausgabe_str=="") ausgabe_str = ausgabe_str+"nordosten";

   else  ausgabe_str = ausgabe_str+" und nach nordosten";
}

if(member(ausgaenge_map, "nordwesten" ) == 1)
{
 if(ausgabe_str=="") ausgabe_str = ausgabe_str+"nordwesten";

   else  ausgabe_str = ausgabe_str+" und nach nordwesten";
}

if(member(ausgaenge_map, "suedosten" ) == 1)
{
 if(ausgabe_str=="") ausgabe_str = ausgabe_str+"suedosten";

   else  ausgabe_str = ausgabe_str+" und nach suedosten";
}

return ausgabe_str;
}
