/* Ebene 1 Raum 1  
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDEBENE1;

#include <properties.h>
#include <moving.h>

create()
{
  ::create();


  AddSpecialExit( "suedostoben" , "soobfkt" );
  AddSpecialExit( "sooben" , "soobfkt" );
  AddSpecialExit( "soob" , "soobfkt" );
  AddExit("nordosten", ROOM("ebene1_3"));
  AddExit("suedwesten", ROOM("ebene1_5"));
  SetProp(P_HIDE_EXITS, ({"sooben" , "soob" }) );
}

soobfkt()
{
   object ob;
   if (ob=present(("\nwegitem"), this_player()))
    {
      if(ob->queryeb1()==1)
       {
         this_player()->move(ROOM("ebene2_3"), M_GO , "" , "geht nach Suedostoben" , "kommt herein");
         return 1;
       }
    }
   this_player()->move(ROOM("ebene1_"+to_string(random(24))), M_GO , "" , "verschwindet ploetzlich" , "erscheint ploetzlich");
   return 1;
}