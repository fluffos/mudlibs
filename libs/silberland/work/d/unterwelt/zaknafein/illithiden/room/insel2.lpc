#include "../files.h"

inherit STDROOM;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();



  AddExit("suedwesten", ROOM("insel1"));
  AddExit( "westen" , ROOM("kochstelle"));
  AddExit( "ostunten" , ROOM("steinbruch"));
  AddExit( "osten" , ROOM("steinbruch"));
  SetProp(P_HIDE_EXITS, ({ "osten" }));
}

