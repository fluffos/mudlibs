/* Weg zu den Illithiden
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDROOM;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();



  AddExit("nordosten", ROOM("ill4"));
  AddExit( "osten" , ROOM("ill7"));

 AddItem(NPC("illithid"), REFRESH_DESTRUCT, ([ P_MNPC_DEFAULTROOM : ROOM("ill4"), 
			                        P_MNPC_AREA : ROOM("ill") ]) );

 
}

