/* Laufweg der Sklaven
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDLAUFWEG;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();

  AddExit( "nordostunten" , ROOM("laufweg10"));
  AddExit( "nordosten" , ROOM("laufweg10"));
  SetProp(P_HIDE_EXITS, ({ "nordosten" }));
}