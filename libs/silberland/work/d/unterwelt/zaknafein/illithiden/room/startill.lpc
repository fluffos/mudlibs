/* Weg zu den Illithiden
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDROOM;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

int ausgang_frei=0;

create()
{
  ::create();


  SetProp(P_INT_SHORT, "Ein alter Stollen" );
  SetProp(P_INT_LONG, "Unter den vielen alten, fauligen Holzbalken, die die Decke des "
           +"Stollens abstuetzen, erkennst du auch einige neue. Die Waende weisen frische "
           +"Bearbeitungsspuren auf. Es scheint so, als haette jemand vor kurzem diesen alten "
           +"Stollen freigelegt und wieder begehbar gemacht. "
           +"@@stollen_func@@");


  AddSmell( DEFAULT_SMELL , "Die Luft riecht abgestanden. Nur ein seltsam suesslicher Duft mischt sich dazwischen.\n");
  AddSmell( ({ "duft" }) , "Ja, es riecht nach Verwesung.\n");
  AddSmell( ({ "verwesung" }) , "Wenn humanoide Biomasse verwest, entsteht ein leicht "
                               +"suesslicher Duft.\n");

  AddSound( DEFAULT_SOUND , "Von sueden dringt leises Schlurfen an dein Ohr. Ausserdem verroechelt hier gerade Ragan.\n");
  AddSound( ({ "schlurfen" }), "Scheinbar warten die Sichelschrecken nur darauf, "
                               +"dass du wieder rauskommst.\n");
  AddSound( ({ "roecheln" , "verroecheln" }), "Ragan scheint es gar nicht gut zu gehen.\n");


  AddDetail( ({ "sichelschreck" , "sichelschrecke" , "sichelschrecken" , "schrecken" , "schrecke"}) ,
    "Die warten im Sueden auf dich.\n");
  AddDetail( ({ "biomasse" , "masse" ," humanoid" }) ,
    "Ragan wird sicher auch bald verwesen.\n");

  AddDetail("person" ,
    "Ragan ist gemeint.\n");

  AddDetail("ragan" ,
    "WAS?! Ist der etwa nicht da?\n");

 AddDetail("meter" ,
    "Die Pfosten sind ungefaehr drei Meter voneinander entfernt.\n");

  AddDetail( ({ "waende" }) ,
    "Die Waende bestehen aus dunklem Gestein. Ungefaehr alle drei Meter stuetzt ein Holzpfeiler die Decke "
   +"und verhindert so, dass sie dich sofort unter sich begraebt. Einige Holzpfeiler sehen recht "
   +"neu aus. Auch das Gestein weist deutliche Bearbeitungsspuren auf."
   +"An der West entdeckst du einen grossen schwarzen Fleck. Von Norden weht dir ein kalter "
   +"Hauch entgegen.\n");

  AddDetail( ({ "decke" , "stollendecke" }) ,
    "Die Decke besteht aus dunklem Gestein. Sie wird durch einige Holzpfosten daran gehindert, "
   +"auf dich herunterzustuerzen. Aber einige Gesteinsbrocken haben sich bereits geloest und "
   +"liegen nun auf dem Boden. Sie haben Furchen in der Decke hinterlassen.\n");

  AddDetail( ({ "boden" }) ,
    "Der Boden besteht aus dunklem Gestein. Er ist mit Brocken davon uebersaeht. Auch "
   +"einige alte Holzpfeiler liegen hier an der Seite. Zwischen diesem Geruempel liegt "
   +"eine uebel zugerichtete Person.\n");

  AddDetail( ({ "durcheinander" , "geruempel" , "seite" }) ,
    "Alte Holzpfeiler, verrostetes Werkzeug und Gesteinsbrocken.\n");
  AddDetail( ({ "brocken" , "gesteinsbrocken" }) ,
    "Grosse und kleine Brocken des schwarzen Gesteins.\n");

  AddDetail( ({ "holzpfeiler" , "pfeiler" , "holzbalken" , "balken" , "pfosten" , "holzpfosten" }) ,
    "Oberschenkeldicke Staemme aus Holz stuetzen die Decke. Aber so verrottet, wie die meisten "
   +"aussehen, muessen sie schon sehr lange hier unten sein. Einige sehen sehr neu aus, so "
   +"als ob gerade jemand einige der Pfeiler ausgetauscht haette.\n");

  AddDetail( ({ "holz" , "staemme" , "stamm"}) ,
    "Der Zahn der Zeit macht auch vor diesem Holz nicht halt.\n");
  AddDetail( ({ "zahn" , "zeit" , "zaehne" }) ,
    "Feuchtigkeit, Pilze und Wuermer sind die Zaehne der Zeit.\n");
  AddDetail( ({ "feuchtigkeit" , "feuchte" , "pilze" , "pilz", "wuermer" }) ,
    "Dadurch wird das Holz morsch und morsches Holz kann sicherlich keine Stollendecke abstuetzen.\n");

  AddDetail( ({ "oberschenkel" }) ,
    "Die verwendeten Holzpfosten sind so dick wie deine Oberschenkel.\n");

  AddDetail( ({ "fels" , "felsen" , "gestein" , "felsgestein" , "steine" , "stein" }) ,
    "Das Gestein ist von tiefen Furchen durchzogen. ");

  AddDetail( ({ "stollen" }) ,
    "Hier im Stollen ist es deutlich kuehler. Scheinbar ist der kuehle Hauch aus "
   +"dem Norden dafuer verantwortlich.\n");

  AddDetail( ({ "hauch" }) ,
    "Ob das der Hauch des Todes ist? Er kommt eindeutig aus noerdlicher Richtung.\n");
  AddDetail( ({ "tod" , "todes" }) ,
    "Hoffentlich bekommst du den nicht so schnell zu Gesicht.\n");
  AddDetail( ({ "gesicht" }) ,
    "Ohne Spiegel kann man wenig davon sehen.\n");
  AddDetail( ({ "spiegel" }) ,
    "Du siehst hier keinen Spiegel.\n");

  AddDetail( ({ "richtung" }) ,
    "Welche Richtung meinst du?\n");

  AddDetail( ({ "norden" }) ,
    "Im Norden ist der Stollen teilweise eingebrochen. Dort scheinen die alten Pfeiler "
    +"nicht mehr gehalten zu haben. Ein kalter Hauch kommt von dort.\n");

  AddDetail( ({ "wand" , "westwand" }) ,
    "Die Westwand besteht aus dem dunklen Gestein. Neben den Bearbeitungsspuren erkennst "
   +"du auf einer fein saeuberlich freigelegten Flaeche einen grossen, schwarzen Fleck.\n");

  AddSpecialDetail( ({ "flaeche" , "fleck" , "flecken" , "schwarzen fleck" ,"schwarzer flecken" , "spinne" , "spinnen"}) , "spinnen_unt" );

  AddDetail( ({ "lloth" , "goettin" }) ,
    "Lloth ist die Goettin der Dunkelelfen. Die Spinne wird von ihnen als heiliges Tier verehrt.\n");
  AddDetail( ({ "tier" ,"tiere", "heiliges tier"}) ,
    "Die Spinne ist das heilige Tier der Dunkelelfen.\n");
  AddDetail( ({ "dunkelelf" , "dunkelelfe" ,"dunkelelfin" }) ,
    "Die Dunkelelfen leben nicht weit von hier in der unterirdischen Stadt Dhrkion.\n");
  AddDetail( ({ "stadt" , "dhrkion" }) ,
    "Die dunkle Stadt Dhrkion ist nicht weit von hier.\n");

  AddDetail( ({ "unterwelt"}) ,
    "Eine eigene Welt unter der Erde.\n");

  AddDetail( ({ "bearbeitung" ,  "spuren" , "bearbeitungsspuren" , "spur" , "bearbeitunsgspur" }) ,
    "Die Waende scheinen erst vor kurzem mit Werkzeug bearbeitet worden zu sein."
   +"Die Arbeit hat tiefe Furchen im Gestein hinterlassen.\n");

  AddDetail( ({ "arbeit"}) ,
    "Es muss sehr anstrengend sein, hier zu arbeiten.\n");
  AddDetail( ({ "werkzeug" ,"werkzeuge" }) ,
    "In einem Stollen wird man wohl mit Spitzhacke und Schaufel arbeiten.\n");
  AddDetail( ({ "spitzhacke" , "schaufel" }) ,
    "Mit einer Spitzhacke kann man das Gestein aufbrechen und anschliessend "
   +"mit einer Schaufel wegraeumen.\n");

  AddDetail( ({ "furche" , "furchen" }) ,
    "Durch die Bearbeitung des Gesteins sind viele dunkle "
   +"Nischen und Zwischenraeume entstanden. Ideale Verstecke fuer abgrundtief boese Kreaturen.\n");

  AddDetail( ({ "nischen" ,"nische" , "zwischenraeume" , "zwischenraum" }) ,
    "Ideale Verstecke sind das.\n");
  AddDetail( ({ "versteck" , "verstecke" }) ,
    "Hoffentlich lauert dir hier nicht eine solche Kreatur auf.\n");
  AddDetail( ({ "kreatur" , "kreaturen" }) ,
    "Vielleicht eine Sichelschrecke oder noch boesartigere Kreaturen.\n");


  AddSpecialDetail( ({""}) , "" );

  AddExit( "suedoben" , ANSCHLUSS );
  AddSpecialExit( ({"nordunten" }) , "go_norden" );

  AddItem(NPC("ragan"), REFRESH_DESTRUCT);

  AddCmd( ({ "grabe" , "grab" , "buddel" , "schaufel" }) , "freilegen" );
  AddCmd( ({ "versteck" , "verstecke"  }) , "versteck" );


}

string stollen_func()
   {
    if (ausgang_frei==1)
     {
      return "Der Stollen ist in \nnoerdlicher Richtung ohne weiteres begehbar, auch wenn er "
           +"bruechig aussieht.\nWenn du nach Suedoben gehst, verlaesst du den Stollen wieder.";
     }
    else
     {
     return "Im Norden \nist der Stollen teilweise wieder eingestuerzt. "
           +"Wenn du nach Suedoben \ngehst, verlaesst du den Stollen wieder.";

     }
   }

reset()
{
  ::reset();
  if (ausgang_frei == 1)
    {
      say(BKS("Ploetzlich beginnt die Erde leicht zu beben und der Stollen bricht "
         +"teilweise zusammen. Hoffentlich haelt der suedliche Teil, sonst "
         +"bist du hier gefangen!\n"));
      ausgang_frei=0;
    }
  else
    {
      say(BKS("Plötzlich beginnt die Erde leicht zu beben. Hoffentlich haelt Stollen, "
         +"sonst bist du hier gefangen!\n"));
    }
}

freilegen( str )
{
object ob;
notify_fail( "Was moechtest du freigraben?\n" );
if( str == "ausgang" || str == "ausgang frei" || str == "stollen frei" || str == "stollen" || str == "nach norden" || str == "gang frei")
	{
          if (ob=present( "schaufel" , this_player()))
            {
              tell_room(environment(this_player()), capitalize(this_player()->Name())+" graebt den Ausgang nach Norden frei.\n",({this_player()}));
              write(BKS("Du raeumst den Ausgang mit deiner Schaufel frei. Nun kannst du problemlos weitergehen.\n"));
              ausgang_frei=1;
              return 1;
            }
          else
            {
              write(BKS("Ohne Schaufel hat das keinen Sinn. Hast du etwa keine dabei? Schade, schade, schade...\n"));
              return 1;
            }
        }
return 0;
}

go_norden()
{
if ( ausgang_frei == 1 )
  {
      this_player()->move(ROOM("dummy"), M_GO|M_SILENT|M_NO_SHOW);
      tell_room(environment(this_player()), capitalize(this_player()->Name())+" geht wagemutig nach Norden tiefer in den Stollen hinein.\n",({this_player()}));
      write("Du gehst nach Norden tiefer in den Stollen hinein.\n");
      call_out("seq1",3);
      return 1;
  }
else
  {
      tell_room(environment(this_player()), capitalize(this_player()->Name())
                       +" schaut nur ratlos.\n",({this_player()}));
      write(BKS("Der Gang ist teilweise wieder eingestuerzt. Du musst ihn erst wieder freigraben, "
             +"bevor du ihn benutzen kannst.\n"));
      return 1;
  }

}

void seq1()
{
  write("\n");
  write(BKS("Der Stollen fuehrt hier weiter in den Fels hinein."
           +" Vorsichtig gehst du weiter.\n"));
  call_out(("seq2"), 3);
}
void seq2()
{
  write("\n");
  write(BKS("Auch wenn es sehr dunkel ist, bemerkst du, wie der Stollen langsam "
           +"steiler wird und nach unten abfaellt.\n"));
  call_out(("seq3"), 3);
}
void seq3()
{
  write("\n");
  write(BKS("Der Stollen wird immer steiler. Ob es wirklich eine gute Idee war, "
           +"hier hineinzugehen?\n"));
  call_out(("seq4"), 3);
}
void seq4()
{
  write("\n");
  write(BKS("Waehrend du noch darueber nachdenkst, ist es auch schon passiert!\n"));
  call_out(("seq5"), 2);
}
void seq5()
{
  write("\n");
  write(BKS("Ploetzlich trittst du mit deinem Fuss ins Leere.\n"));
  call_out(("seq6"), 3);
}
void seq6()
{
  write("\n");
  write(BKS("Du versuchst dich irgendwo festzuhalten, aber in der Dunkelheit "
           +"sind alle Versuche, Halt zu finden, zum Scheitern verurteilt.\n"));
  call_out(("seq7"), 3);
}
void seq7()
{
  write("\n");
  write("\n");
  write(BKS("Du faellst...\n"));
  write("\n");
  call_out(("seq8"), 2);
}
void seq8()
{
  write("\n");
  write(BKS("Du versuchst, dich nicht an den vielen Steinen zu verletzen, was dir mehr"
          +" oder weniger gut gelingt.\n"));
  call_out(("seq9"), 4);
}
void seq9()
{
  write("\n");
  write(BKS("Deine Reise endet ziemlich abrupt. Du krachst in einen Haufen aus Leichen. "
           +"Scheinbar haben es vor dir schon mehrere Abenteuerer versucht - zum Glueck! "
           +"Oder wollten sie nur etwas noch schrecklicherem hier unten entkommen?\n"));
  call_out(("seq10"), 7);
}
void seq10()
{
  write("\n");
  write(BKS("Angewidert aber kaum verletzt kriechst du durch die Oeffnung aus dem Schacht heraus.\n"));
  write("\n");
  call_out(("seq_end"), 3);
}
void seq_end()
{
  tell_room(ROOM("ill0"), this_player()->name(WER,2)
               +" kommt leichenblass aus einer Oeffnung in der Wand hereingeklettert.\n");
  this_player()->move(ROOM("ill0"), M_GO|M_SILENT);

}


versteck( str )
{
notifiy_fail("Wo willst du dich verstecken?\n");
if ( str == "in Nische" || str == "in Zwischenraum" || str == "in Versteck" )
  {
    tell_room(environment(this_player()), capitalize(this_player()->Name())+" will mit dir Verstecken spielen. Du musst schmunzeln.\n",({this_player()}));
    write(BKS("Du glaubst doch wohl nicht ernsthaft, dass du dich vor den Kreaturen der Unterwelt verstecken kannst!\n"));
    return 1;
  }
return 0;
}

spinnen_unt()
  {
   if ( (this_player()->QueryProp(P_RACE)) == "Dunkelelf" )
    {
     write(BKS("Du betrachtest den Fleck genauer und meinst eine grosse Spinne "
              +"erkennen zu koennen. Erfuerchtig huldigst du deiner Goettin Lloth.\n"));
     return;
    }
    write(BKS("Du betrachtest den Fleck genauer und meinst eine grosse haessliche Spinne "
   +"erkennen zu koennen. Angewidert wendest du dich ab.\n"));
   return;
  }
