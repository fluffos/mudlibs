/*     
**               Astralebene - Eis
**
**            Zaknafein, Februar 2000
**
*/

inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:-30,ENV_TERRAIN:TT_ARCTIC])); 
  SetProp(P_INT_SHORT, "Auf einer astralen Ebene" );
  SetProp(P_INT_LONG,
    "Ploetzlich schwebst Du ueber einer riesigen Schneewueste. Es ist hier "
   +"eisigkalt. Du frierst am ganzen Leibe. Was hat das alles bloss "
   +"zu bedeuten? Es kommt Dir vor, wie in einem Traum. Wo Du auch "
   +"hinblickst - Du siehst nur Eis und Schnee. Der Boden ist mit einer " 
   +"dicken Eisschicht bedeckt, wie man es sonst nur aus der Polarregion "
   +"kennt.");

  AddDetail( "boden"  ,
    "Eine dicke Eisschicht bedeckt den Boden.\n");
  AddDetail( ({ "schicht" , "eisschicht" }) ,
    "Der Boden ist mit einer dicken und harten Eisschicht bedeckt.\n");
  AddDetail( "eis"  ,
    "Dieses Eis kommt Dir besonders kalt vor.\n");
  AddDetail( ({ "auge" , "schneewueste" , "wueste" }) ,
    "Soweit Dein Auge reicht, siehst Du nur Eis und Schnee.\n");
  AddDetail( "schnee"  ,
    "Reiner, weisser Schnee.\n");
  AddDetail( ({ "polarregion" "region" })   ,
    "Hier ist es wesentlich kaelter als in der Polarregion.\n");
  AddDetail( ({ "leibe" , "leib" })  ,
    "Deine Kleidung bietet Dir kaum Schutz vor der imensen Kaelte.\n");
  AddDetail( "traum"  ,
    "Wenn dies alles ein Traum ist, dann moechtest Du moeglichst schnell "
   +"erwachen.\n");
  AddDetail( "kaelte"  ,
    "Keine Kleidung kann Dich vor dieser eisigen Kaelte schuetzen.\n");
  AddDetail( "schutz"  ,
    "Hast Du einen?\n");

  AddSmell( DEFAULT_SMELL , "Es ist zu kalt, um etwas zu riechen.\n");
  AddSound( DEFAULT_SOUND , "Du hoerst den Wind pfeifen.\n");
  AddSound( ({ "wind" , "pfeifen" }) , 
            "Der Wind fluestert Dir zu: Moechtest Du nicht etwas Eis "
           +"vom Boden abkratzen?\n");

AddCmd( ({ "kratze" , "kratz" }) , "kratzen" ); 
AddSpecialExit("suedosten" , "so" );

} 

so()
{
write("Du fliegst nach Suedosten.\n");
this_player()->move(ROOM("aebene1"), M_GO , "" ,
       "fliegt nach Suedosten", 
       "kommt hereingeflogen");
return 1;
}

kratzen(str)
{
notify_fail( "Was moechtest Du denn abkratzen?\n");
if( str == "eis ab" || str == "eis"  )
{
  object ob;
  if (ob=deep_present(("\nzakeis"), this_player()))
  {
    write(BKS("Nein, Du hast genug Eis.\n"));
  }
  else
  {
    write(BKS("Mit viel Muehe kratzt Du etwas Eis ab und steckst es ein.\n"));
    clone_object(OBJ("eis"))->move(this_player(), M_NOCHECK);      
  }
return 1;
}
return 0;
}