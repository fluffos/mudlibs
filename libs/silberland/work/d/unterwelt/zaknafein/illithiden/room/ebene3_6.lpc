/* Ebene 3 Raum 6  
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDEBENE3;

#include <properties.h>
#include <moving.h>

create()
{
  ::create();



  AddExit("nordwesten", ROOM("ebene3_7"));
  AddExit("suedwesten", ROOM("ebene3_5"));
  AddSpecialExit( "westoben" , "wobfkt" );
}

wobfkt()
{
   object ob;
   if (ob=present(("\nwegitem"), this_player()))
    {
      if(ob->queryeb3()==3)
       {
         this_player()->move(ROOM("brainroom"), M_GO , "" , "nimmt allen Mut zusammen und geht nach Suedoben" , "kommt herein");
         return 1;
       }
    }
   this_player()->move(ROOM("ebene1_"+to_string(random(24))), M_GO , "" , "verschwindet ploetzlich" , "erscheint ploetzlich");
   return 1;
}