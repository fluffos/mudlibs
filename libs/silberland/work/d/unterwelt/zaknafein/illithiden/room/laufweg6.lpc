/* Laufweg der Sklaven
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDLAUFWEG;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Laufweg der Sklaven");


  AddExit("suedostunten", ROOM("laufweg5"));
  AddExit("suedosten", ROOM("laufweg5"));
  AddExit( "nordwestoben" , ROOM("laufweg7"));
  AddExit( "nordwesten" , ROOM("laufweg7"));
  SetProp(P_HIDE_EXITS, ({ "suedosten" , "nordwesten" }));
}