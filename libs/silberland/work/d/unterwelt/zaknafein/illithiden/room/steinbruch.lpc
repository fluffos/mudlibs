/*    
**        Steinbruch der Illithiden
**
**         Zaknafein Dezember '99
*/



inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "Im Steinbruch der Illithiden" );
  SetProp(P_INT_LONG,
    "Du stehst hier am Anfang des Steinbruches der Illithiden. Hier arbeiten "
   +"ihre Sklaven und brechen das Gestein ab, das die Illithiden zum Bau ihrer "
   +"Burg benoetigen. Lautes Haemmern droehnt in Deinen Ohren und es riecht "
   +"streng nach Schweiss. Der Weg nach Westoben fuehrt Dich aus dem Steinbruch "
   +"heraus, waehrend Du im Nordosten tiefer in diesen unterirdischen Steinbruch "
   +"eindringen kannst."
  );

  AddDetail( ({ "westoben" , "weg" }) ,
    "Dieser Weg fuehrt Dich aus dem Steinbruch heraus.\n" );
  AddDetail( "schweiss"  ,
    "Riechst Du das etwas nicht?\n" );
  AddDetail( "anfang" ,
    "Ja, der Anfang des Steinbruches. Oder der Anfang vom Ende. Ganz wie Du willst...\n");
  AddDetail( "ende" ,
    "Deinem Ende vielleicht?\n");
  AddDetail( "haemmern" ,
    "Lausche doch mal.\n");
  AddDetail( "decke" ,
    "Die Decke und die Waende sind nicht abgestuetzt. Die Illithiden machen sich wohl keine "
   +"grossen Sorgen um ihre Sklaven. Vereinzelt broeckelt schon Gestein von Waenden und Decke "
   +"ab.\n");
  AddDetail( ({ "wand" , "waende" }),
    "Du siehst Sklaven, wie sie die Waende bearbeiten und Steine herausbrechen.\n");
  AddDetail( "sorgen" ,
    "Du spottest ueber dich selbst, weil Du fuer einen kurzen Augenblick dachtest, die "
   +"die Illithiden sorgten sich um ihre Sklaven.\n");
  AddDetail( ({ "sklaven" , "sklave" }) ,
    "Sie sehen alle sehr erschoepft aus. Ihre ausdruckslosen Augen verraten Dir, dass sie nicht "
   +"Herr ihrer Sinne sind.\n");
  AddDetail( ({ "sinne" , "herr" }) , 
    "Die Illithiden kontrollieren sie vollstaendig.\n");
  AddDetail( "augen"  ,
    "Sie sind vollkommen ausdruckslos und wirken muede.\n" );
  AddDetail( "augenblick"  ,
    "Stuerzen hier die Gaenge ein, so besorgen sich die Illithiden einfach neue Sklaven, "
    "die dann die Arbeit fortsetzen.\n" );
  AddDetail( "arbeit"  ,
    "Vielleicht solltest auch Du langsam anfangen zu arbeiten.\n" );
  AddDetail( "boden"  ,
    "Der Boden ist mit Steinen uebersaeht.\n" );
  AddDetail( "ohren"  ,
    "Gut, dass du sie noch hast. Fragt sich nur wielange noch...\n" );
  AddDetail( ({ "stein" , "steine" , "steinen " }) ,
    "Unmengen an Steinen liegen am Boden\n" );
  AddDetail( ({ "bau" , "burg" }) ,
    "Wenn die Sklaven weiter so verbissen arbeiten, wird die Burg bald fertig sein.\n" );
  AddDetail( "gestein"  ,
    "Dieses Gestein eignet sich wohl sehr gut zum Bau der Burg.\n" );
  AddDetail( "illithiden"  ,
    "Ihnen bist Du bestimmt schon begegnet... leider!\n" );
  AddDetail( ({ "bruch" , "steinbruch" , "steinbruches" })  ,
    "Naja, Du waerst lieber woanders, oder?\n" );
  AddDetail( ({ "gang" , "gaenge" })  ,
    "Hoffentlich stuerzen sie nicht ein!\n" );

  AddSmell( DEFAULT_SMELL , "Es riecht hier nach dem Schweiss der Sklaven.\n");
  AddSmell( ({ "geruch", "sklaven" , "schweiss"}) , "Ein scharfer, beissender Geruch.\n");
  AddSound( DEFAULT_SOUND , "Du hoerst lautes Haemmern.\n");
  AddSound( ({ "KLOPF", "haemmern" }), "KLOPF, KLOPF, KLOPF\n");
  AddItem(NPC("sklave"), REFRESH_REMOVE,([P_AGGRESSIVE:0]));

  AddSpecialExit("westoben", "wob" );
  AddSpecialExit("westen", "wob" );
  AddExit("nordosten", ROOM("steinbruch1"));
  SetProp(P_HIDE_EXITS, ({"westen"}) ); 
} 

wob()
{
string uliname;
uliname=ILLMASTER->BehPla(this_player()->query_real_name());

  if(uliname=="none")
   {
     this_player()->move(ROOM("insel2"), M_GO , "" , "geht nach Westoben" , "kommt herein");
     return 1;
   }

  write(BKS("In Deinen Gedanken formen sich die Worte: Arbeite Sklave! Oder ich werde Dich vernichten!\n"));
  write(capitalize(uliname)+" laesst dich nicht nach Westoben gehen.\n");
  return 1;     

}