/*    
**        Steinbruch der Illithiden
**
**         Zaknafein Dezember '99
*/



inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

int anzahl=4;

create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "Im Steinbruch der Illithiden" );
  SetProp(P_INT_LONG,
    "In diesem Teil des Steinbruches siehst Du unzaehlige Sklaven, die mit Hammer "
   +"und Meissel das Gestein bearbeiten, das zuvor aus dem Fels geschlagen wurde. "
   +"Mit viel Muehe bringen sie das Gestein in eine quaderfoermige Form, so dass "
   +"man es zum Bau der Burg verwenden kann. Das laute Haemmern bringt Dich fast um "
   +"Deinen Verstand."
   );

  AddDetail( "verstand" ,
    "Du haeltst es hier kaum noch aus!\n");  
  AddDetail( "teil" ,
    "Hier wird das Gestein, das aus den Waenden geschlagen wurde, in die richtige Form gebracht.\n");  
  AddDetail( "schweiss"  ,
    "Riechst Du das etwas nicht?\n" );
  AddDetail( ({ "werkzeugen" , "werkzeuge" , "hammer" , "meissel" }) , 
    "Fuer den Rest ihres Lebens sind die Sklaven dazu verdammt, mit diesen primitiven "
   +"Werkzeugen das Gestein zu bearbeiten.\n");
  AddDetail( ({ "gedanke " , "leben" , "lebens" , "rest" }) ,
    "Vielleicht troestet Dich der Gedanke, dass die Sklaven unter diesen grausamen "
   +"Bedingungen wohl nur ein recht kurzes Leben haben.\n");
  AddDetail( "gedanke" ,
    "Naja, eigentlich troestet es Dich kaum. Es beaengstigt Dich eher.\n");
  AddDetail( "bedingungen" ,
    "Die Sklaven scheinen kaum Nahrung zu bekommen. Sie sind alle voellig abgemagert.\n");
  AddDetail( "nahrung" ,
    "Man darf hier wohl nicht sehr zimperlich sein, wenn es um Nahrung geht.\n");
  AddDetail( "form" ,
    "Erst in dieser Form ist das Gestein brauchbar.\n");
  AddDetail( "haemmern" ,
    "Lausche doch mal.\n");
  AddDetail( ({ "muehe" , "fels" , "felsen" }) ,
    "Es ist ziemlich muehsam, Gestein aus den Felsen zu schlagen. Die Haende und die Gesichter "
   +"der Sklaven sind blutig von den vielen Splittern, die dabei entstehen.\n");
  AddDetail( ({"splitter"  , "splittern" }),
    "Die Splitter haben viele Narben in den Gesichtern und Haenden der Sklaven hinterlassen.\n");
  AddDetail( ({ "haende" ,"haenden " , "hand" , "narben" , "gesichter" , "gesichtern" , "gesicht" , "narbe" }) , 
    "Haende und Gesichter sind schon durch die vielen Narben entstellt.\n");
  AddDetail( "decke" ,
    "Die Decke und die Waende sind nicht abgestuetzt. Die Illithiden machen sich wohl keine "
   +"grossen Sorgen um ihre Sklaven. Vereinzelt broeckelt schon Gestein von Waenden und Decke "
   +"ab.\n");
  AddDetail( ({ "wand" , "waende" }),
    "Die Waende bestehen aus hartem Fels.\n");
  AddDetail( "sorgen" ,
    "Du spottest ueber dich selbst, weil Du fuer einen kurzen Augenblick dachtest, die "
   +"die Illithiden sorgten sich um ihre Sklaven.\n");
  AddDetail( ({ "sklaven" , "sklave" }) ,
    "Sie sehen alle sehr erschoepft aus. Ihre ausdruckslosen Augen verraten Dir, dass sie nicht "
   +"Herr ihrer Sinne sind.\n");
  AddDetail( ({ "sinne" , "herr" }) , 
    "Die Illithiden kontrollieren sie vollstaendig.\n");
  AddDetail( "augen"  ,
    "Sie sind vollkommen ausdruckslos und wirken muede.\n" );
  AddDetail( "augenblick"  ,
    "Stuerzen hier die Gaenge ein, so besorgen sich die Illithiden einfach neue Sklaven, "
    "die dann die Arbeit fortsetzen.\n" );
  AddDetail( "arbeit"  ,
    "Vielleicht solltest auch Du langsam anfangen zu arbeiten.\n" );
  AddDetail( "boden"  ,
    "Der Boden ist mit Steinen uebersaeht.\n" );
  AddDetail( ({ "stein" , "steine" , "steinen " }) ,
    "Unmengen an Steinen liegen am Boden\n" );
  AddDetail( ({ "bau" , "burg" }) ,
    "Wenn die Sklaven weiter so verbissen arbeiten, wird die Burg bald fertig sein.\n" );
  AddDetail( "gestein"  ,
    "Dieses Gestein eignet sich wohl sehr gut zum Bau der Burg, da es sehr hart ist.\n" );
  AddDetail( "illithiden"  ,
    "Hier im Steinbruch wird die die Bosheit der Illithiden erst richtig bewusst!\n" );
  AddDetail( "bosheit" ,
    "Das sollen sie Dir buessen!\n");
  AddDetail( ({ "bruch" , "steinbruch" , "steinbruches" })  ,
    "Naja, Du waerst lieber woanders, oder?\n" );
  AddDetail( ({ "gang" , "gaenge" })  ,
    "Hoffentlich stuerzen sie nicht ein!\n" );
  
  AddDetail( ({ "ratte" , "ratten" })  ,
    "Du hast grausamen Hunger!\n" );
  AddDetail( ({ "erwaegung" , "hunger" }) ,
    "Du willst doch nicht... oder doch? Hm, vielleicht kann man sie fangen?\n" );

  AddRoomMessage( ({ "Eine Ratte huscht ueber den Boden.\n",
                     "Es stinkt hier wirklich schrecklich!\n",
                     "Ein kleiner Stein faellt von der Decke herunter.\n"
                  }), 40);
  AddSmell( DEFAULT_SMELL , "Es riecht hier nach dem Schweiss der Sklaven.\n");
  AddSmell( ({ "geruch", "sklaven" , "schweiss"}) , "Ein scharfer, beissender Geruch.\n");
  AddSound( DEFAULT_SOUND , "Du hoerst lautes Haemmern.\n");
  AddSound( ({ "KLOPF", "haemmern" }), "KLOPF, KLOPF, KLOPF\n");

  AddCmd( ({ "fange" , "fang" }) , "fangen");
  AddExit("suedwesten", ROOM("steinbruch"));
  AddExit("osten" , ROOM("steinbruch2"));
} 

reset()
{
  ::reset();
anzahl=4;
}


fangen( str )
{

notify_fail( "Was moechtest Du einfangen?\n" );
if( str == "ratte ein" || str == "ratte" )
	{
                 
           if (anzahl != 0 )        
             {
               anzahl = anzahl - 1;
               write(BKS("Du hebst einen Stein vom Boden auf und wirfst ihn auf eine Ratte. "
                        +"Die Ratte verendet quikend, als sie getroffen wird.\n"));                    
               clone_object(OBJ("toteratte"))->move(this_player());
             }
             else
             {
               write(BKS("Jetzt im Moment laesst sich keine Ratte blicken. Sie haben wohl mitbekommen, "
                        +"dass hier ein Jaeger auf sie wartet.\n"));
             }
           return 1;
        }

return 0;	
}