/*    
**  Steinbruch der Illithiden
**
**  Zaknafein, Mai 2001
*/



inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

int anzahl=10;

create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "Im Steinbruch der Illithiden" );
  SetProp(P_INT_LONG,
    "Mit grosser Anstrengung und ohne Pause arbeiten die Sklaven in dieser Hoehle. " 
   +"Unablaessig rinnt Wasser die Waende runter, so dass die Sklaven schon bis zu "
   +"den Knien im Wasser stehen, was die Arbeit noch mehr erschwert. "
   );
  AddDetail( "arbeit" ,
             "Die Arbeit wird ist hier besonders hart, da man sich hier durch kniehohes "
            +"Wasser quaelen muss.\n"); 
  AddDetail( ({ "kniee" , "knie" , "knien" }) ,
              "Gnome, Zwerge, Trolle, Oger, Menschen, Elfen und Dunkelelfen haben "
             +"zumindest eines gemeinsam: Sie haben zwei Kniee!\n");         
  AddDetail( "boden" ,
             "Den Boden kannst Du kaum erkennen, da er mit schmutzigem Wasser bedeckt ist.\n");     
  AddDetail( ({ "wand" , "waende" }) ,
              "Unablaessig rinnt Wasser die Waende runter.\n");     
  AddDetail( "wasser" ,
    "Das Wasser, das die Waende runterlaeuft, ist recht klar. Am Boden siehst Du jedoch "
   +"nur schmutziges, uebelriechendes Wasser.\n");
  AddDetail( ({ "anstrengung" , "pause" }) ,
              "Die Illithiden goennen ihren Sklaven keine Pause.\n");          
  AddDetail( ({ "sklave" , "sklaven" }) ,
    "Sklaven verschiedener Rassen findest Du hier.\n");
  AddDetail( ({ "rasse" , "rassen" }) ,
    "Es gibt Gnome, Zwerge, Trolle, Oger, Menschen, Elfen und sogar Dunkelelfen.\n");
  AddDetail( ({ "gnome" , "zwerge" , "trolle" , "oger", "menschen" , "elfen" , "Dunkelelfen" }) ,
    "Die Illithiden nehmen jeden, der stark genug ist, hier zu arbeiten.\n");
  AddDetail( "fels"  , 
    "Es ist sehr anstrengend, diesen Fels zu bearbeiten.\n");
  AddDetail("hoehle" , 
    "Die Hoehle ist wirklich riesig.\n");
  AddDetail( "haemmern" ,
    "Lausche doch mal.\n");
  AddDetail( "decke" ,
    "Die Decke besteht aus Fels.\n");
  AddDetail( "gestein"  ,
    "Das Gestein wird hier im Steinbruch abgebrochen.\n" );
  AddDetail( "illithiden"  ,
    "Die Illithiden lassen ihre Sklaven die schmutzige Arbeit machen.\n" );
  AddDetail( ({ "bruch" , "steinbruch" , "steinbruches" })  ,
    "Du willst nur weg von hier!\n" );
  
  AddSmell( DEFAULT_SMELL , "Es riecht hier nach fauligem Wasser.\n");
  AddSmell( ({ "geruch" , "wasser" }) , "Ein sehr ekelhafter Geruch, glaub' mir.\n");
  AddSound( DEFAULT_SOUND , "Auch hier hoerst Du nur monotones Haemmern.\n");
  AddSound( "haemmern" , "Du haeltst dieses Haemmern kaum noch aus.\n");

  AddCmd( ({ "trinke" , "trink"  }) , "trinken");
  AddCmd( ({ "brich" , "breche" , "schlag" , "schlage" }) , "schlagen");
  AddItem(NPC("masoj"), REFRESH_DESTRUCT,([P_AGGRESSIVE:0]));
  AddExit("suedwesten" , ROOM("steinbruch2"));

} 

reset()
{
  ::reset();
anzahl=10;
}

schlagen( str )
{

notify_fail( "Was moechtest Du herausschlagen?\n" );
if( str == "gestein aus waende" || str == "gestein heraus" || str == "gestein aus wand" || str == "gestein ab" )
	{
           write(BKS("Kommt noch...\n"));
           return 1;
        }

return 0;	
}

trinken( str )
{
notify_fail( "Welches Wasser moechtest Du trinken? Das klare oder das schmutzige?\n" );
if( str == "klares wasser" || str == "wasser klar" || str == "das klare wasser" || str == "klare wasser" )
	{
           if (anzahl != 0 )  
           {
           anzahl = anzahl -1;
           this_player()->heal_self(5+random(5));
           write(BKS("Du nimmst einen Schluck vom dem klarem Wasser und fuehlst Dich erfrischt!\n"));
           return 1;
           }
           else
           {
           write(BKS("Es hat sich noch nicht genug Wasser angesammelt. Warte noch etwas.\n"));
           return 1;
           }
        }
if( str == "schmutziges wasser" || str == "wasser schmutzig" || str == "das schmutzige wasser" || str == "schmutzige wasser" )
	{
           SetProp(P_KILL_NAME, "Ein unueberlegter Schluck" );
           this_player()->do_damage(5+random(5));
           this_player()->AddPoison(random(2));
           write(BKS("Wuahh! Das war wohl keine gute Idee...\n"));
           return 1;
        }

return 0;	
}
