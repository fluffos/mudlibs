/* Ebene 2 Raum 14  
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDEBENE2;

#include <properties.h>
#include <moving.h>

create()
{
  ::create();

  AddExit("nordwesten", ROOM("ebene2_15"));
  AddExit("suedosten", ROOM("ebene2_13"));
  AddSpecialExit( "suedwestoben" , "swobfkt" );
  AddSpecialExit( "swoben" , "swobfkt" );
  AddSpecialExit( "swob" , "swobfkt" );
  SetProp(P_HIDE_EXITS, ({"swoben" , "swob" }) );
}

swobfkt()
{
   object ob;
   if (ob=present(("\nwegitem"), this_player()))
    {
      if(ob->queryeb2()==3)
       {
         this_player()->move(ROOM("ebene3_7"), M_GO , "" , "geht nach suedwestoben" , "kommt herein");
         return 1;
       }
    }
   this_player()->move(ROOM("ebene1_"+to_string(random(24))), M_GO , "" , "verschwindet ploetzlich" , "erscheint ploetzlich");
   return 1;
}