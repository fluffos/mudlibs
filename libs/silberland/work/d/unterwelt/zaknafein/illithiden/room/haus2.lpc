/*     
**  Haus der Hexe
**
**  Zaknafein, Mai 2001
**
*/

inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20,ENV_TERRAIN:TT_HOUSE])); 
  SetProp(P_INT_SHORT, "Im Haus einer Hexe" );
  SetProp(P_INT_LONG,
    "Hier im Hinterzimmer des Hauses faellt Dein Blick sofort auf "
   +"eine grosse Arbeitsplatte, auf der verschiedene Gartenwerkzeuge "
   +"liegen. Neben den Werkzeugen liegt ein aufgeschlagenes Buch. "
   +"Auf einer kleinen Terrasse, die man von diesem Raum aus betreten " 
   +"kann, zuechtet die Hexe wohl ihre Kraeuter. Ein wuerziger Duft "
   +"liegt im Raum.");

  AddDetail("blick" ,
    "Der geuebte Blick eines Abenteurers... Das merkt man sofort.\n");
  AddDetail( ({"abenteurers" , "abenteurer" }) ,
    "Duuuuuuuuuuuuuuuuu!\n");
  AddDetail( ({ "wand" , "waende" }) ,
    "An der Nordwand faellt die ein schwarzer Vorhang auf.\n");
  AddDetail( ({ "nordwand" , "vorhang" }) ,
    "Was sich wohl hinter dem Vorhang befindet? Gehe doch mal nach norden.\n");
  AddDetail( "decke" ,
    "Sie besteht aus Holz. Eine kleine Lampe haengt von ihr herab.\n");
  AddDetail( "lampe" ,
    "Ohne die Lampe waere es wohl ziemlich duester hier. Sie strahlt ungewoehnlich hell. "
   +"Naja, die Kraeuter brauchen wohl viel Licht.\n");
  AddDetail( "licht" ,
    "Die Kraeuter brauchen viel Licht.\n");
  AddDetail( ({ "holzboden" , "boden" }) ,
    "Auf dem Holzboden liegt ein kleiner schmutziger Teppich.\n");
  AddDetail( "holz" ,
    "Schwarzes, hartes Holz.\n");
  AddDetail( ({ "erde" , "gartenerde" ,"schmutz" }),
    "Bei dem Schmutz handelt es sich um Gartenerde.\n");
  AddDetail( "teppich" ,
    "Der Teppich ist ziemlich schmutzig.\n");
  AddDetail( ({ "gartenwerkzeuge" , "werkzeuge" , "werkzeugen" }) ,
    "Alles was man zum Anbau von Kraeutern benoetigt: Schaufel, Harke und eine kleine Giesskanne.\n");
  AddDetail( ({ "schaufel" , "harke" , "giesskanne" , "kanne" , "einzelheiten"}) ,
    "Fuer solche Einzelheiten interessieren sich nur Druiden oder Hexen.\n");
  AddDetail( ({ "platte" , "arbeitsplatte" }) ,
    "Auf der Arbeitsplatte liegen einige Gartenwerkzeuge und Samen.\n");
  AddDetail( "samen" ,
    "Nur die Hexe wird wissen, um welche Samen es sich handelt.\n");
  AddDetail( "buch" ,
    "Die Seite ueber Blutmoos ist auf geschlagen.\n");
  AddDetail( ({ "seite" , "blutmoos" }) ,
    "In dem Buch steht, wie man es zuechten kann. Es waechst an den feuchten Waenden einer Grotte am besten...\n");
  AddDetail( "terrasse" ,
    "Auf ihrer Terrasse hat die Hexe ein kleines Kraeuterbeet angelegt.\n");
  AddDetail( ({ "beet" , "kraeuterbeet" }) ,
    "Es befindet sich auf der Terrasse. Es wachsen eigenartige Kraeuter dort. Von dort entstroemt auch ein "
   +"wuerziger Duft.\n");
  AddDetail( ({ "raum" , "zimmer" , "hinterzimmer" }) ,
    "Es war nicht einfach hierher zu gelangen. Die Hexe mag wohl keinen Besuch.\n");
  AddDetail( ({ "hauses" , "haus" , "hexenhaus" }) ,
    "Das Hexenhaus, in dem du sich gerade befindest, ist gemeint.\n");
  AddDetail( "kraeuter" ,
    "Du weisst nicht, um welche Kraeuter es sich handelt. Sie riechen sehr wuerzig.\n");
  AddDetail( "duft" ,
    "Naja, sehen kann man den Duft eher nicht...\n");
  AddDetail( "hexe" ,
    "Ups, ist sie nicht da?\n");
  AddDetail( "besuch" ,
    "Jetzt bist du der Besuch.\n");
  AddDetail("druiden" ,
    "Druiden und Hexen verbindet die Liebe zur Natur.\n");
  AddDetail( ({"verstaendnis", "natur" , "liebe" , "kraefte" , "kraft" }) ,
    "Die Liebe zur Natur und ihr genaues Verstaendnis sind unbedingt noetig, um sich ihrer "
   +"Kraefte zu bedienen und sie zu lenken. \n");
  AddDetail( ({ "grotten" , "grotte" }) ,
    "Du ueberlegst, wo es ueberall Grotten gibt...\n");
  AddDetail( ({ "kunst" , "anbau" }),
    "Der richtige Anbau von Kraeutern ist eine Kunst.\n");

  AddSmell( DEFAULT_SMELL , "Es riecht hier nach verschiedenen Kraeutern.\n");
  AddSmell( ({ "kraeuter" , "kraeutern" , "duft" }) ,
            "Hmmm, sehr wuerzig. Du kannst aber kaum sagen, um welche "
           +"Kraeuter es sich handelt. Dafuer kennst Dich zu schlecht "
           +"damit aus.\n");
  AddSound( DEFAULT_SOUND , "Es ist recht still hier.\n");
 
AddItem(NPC("farima"), REFRESH_REMOVE,([P_AGGRESSIVE:0]));

AddExit("raus" , ROOM("haus1") );
AddExit("norden" , ROOM("laden") );

} 

