/* Laufweg der Sklaven
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDLAUFWEG;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();


  AddItem(NPC("illithid"), REFRESH_DESTRUCT, ([ P_MNPC_DEFAULTROOM : ROOM("laufweg8"), 
			                        P_MNPC_AREA : ROOM("laufweg") ]) );

  AddExit("suedwestunten", ROOM("laufweg7"));
  AddExit("suedwesten", ROOM("laufweg7"));
  AddExit( "nordostoben" , ROOM("laufweg9"));
  AddExit( "nordosten" , ROOM("laufweg9"));
  SetProp(P_HIDE_EXITS, ({ "suedwesten" , "nordosten" }));
}