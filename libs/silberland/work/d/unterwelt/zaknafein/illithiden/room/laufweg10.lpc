/* Laufweg der Sklaven
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDLAUFWEG;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();

  AddExit("suedwestoben", ROOM("laufweg11"));
  AddExit("suedwesten", ROOM("laufweg11"));
  AddExit( "nordwestunten" , ROOM("laufweg9"));
  AddExit( "nordwesten" , ROOM("laufweg9"));
  SetProp(P_HIDE_EXITS, ({ "nordwesten" , "suedwesten" }));
}