create()
{
  ::create();

 AddItem(NPC("vampill"), REFRESH_DESTRUCT, ([ P_MNPC_DEFAULTROOM : ROOM("ebene2_4"), 
			                        P_MNPC_AREA : ROOM("ebene2") ]) );

  AddExit("nordosten", ROOM("ebene2_3"));
  AddExit("suedosten", ROOM("ebene2_5"));
}