#include "../files.h"

inherit STDEBENE1;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();



  AddExit("nordosten", ROOM("ebene1_5"));
  AddExit("suedosten", ROOM("ebene1_7"));

  AddItem(NPC("illithid"), REFRESH_DESTRUCT, ([ P_MNPC_DEFAULTROOM : ROOM("ebene1_6"), 
			                        P_MNPC_AREA : ROOM("ebene1") ]) );

}