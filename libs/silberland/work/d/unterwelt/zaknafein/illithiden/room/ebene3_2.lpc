/* Ebene 3 Raum 2  
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDEBENE3;

#include <properties.h>
#include <moving.h>

create()
{
  ::create();



  AddExit("nordosten", ROOM("ebene3_1"));
  AddExit("suedosten", ROOM("ebene3_3"));
  AddSpecialExit( "ostoben" , "oobfkt" );
}

oobfkt()
{
   object ob;
   if (ob=present(("\nwegitem"), this_player()))
    {
      if(ob->queryeb3()==1)
       {
         this_player()->move(ROOM("brainroom"), M_GO , "" , "nimmt allen Mut zusammen und geht nach Suedoben" , "kommt herein");
         return 1;
       }
    }
   this_player()->move(ROOM("ebene1_"+to_string(random(24))), M_GO , "" , "verschwindet ploetzlich" , "erscheint ploetzlich");
   return 1;
}