/* Laufweg der Sklaven (Hier findet man Masojs Piwafi.)
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDLAUFWEG;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_LONG, "Hier ist der Laufweg teiweise verschuettet. Riesige Steinbrocken "
                      +"liegen auf dem Weg und erschweren es jedem, diesen Abschnitt zu "
                      +"passieren. Man muss gefaehrlich dicht an dem Abgrund vorbeigehen "
                      +"und dabei ueber grosse Brocken steigen, wenn man weiterkommen will.");

  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "sklaven" , "sklave" })  ,
    "Hier in diesem Abschnitt befinden sich keine Sklaven.\n" );
  AddDetail( "boden" ,
    "Der Boden ist mit Gesteinsbrocken uebersaet.\n" );
  AddDetail( "abgrund" ,
    "Du schaust den Abgrund hinunter und entdeckst ein paar Leichen, die weit unten in der "
   +"Tiefe liegen.\n" );
  AddDetail( ({ "leichen" , "leiche" })  ,
    "Die armen sehen gar nicht gut aus... Du nimmst dir vor, nicht so zu enden.\n" );
  AddDetail( ({ "meter" , "tiefe" }) ,
    "Hier geht es gute 10 Meter in die Tiefe. Den Absturz ueberlebt niemand.\n" );
  AddDetail( ({ "brocken" , "steinbrocken" , "steine" , "gesteinsbrocken" })  ,
    "Die riesigen Brocken haben fast den gesamten Weg unter sich begraben.\n" );
  AddDetail( ({ "weg" , "laufweg" })  ,
    "Wegen der abgebrochenen Gesteinsbrocken ist der Laufweg hier gefahrlich schmal.\n" );
  AddDetail( "abschnitt" ,
    "Schaue dich hier gut um...\n" );
  AddDetail( "absturz" ,
    "Ein Absturz hier waere toedlich.\n" );
  AddDetail( ({ "wand" , "waende" })  ,
    "Die Waende der Burg werden von den zahlreichen Sklaven bearbeitet.\n" );
  AddDetail( "decke"   ,
    "Die Decke dieser riesigen Hoehle kannst du nicht erkennen.\n" );
  AddDetail( "hoehle"  ,
    "Die Illithiden haben sich diese riesige Hoehle tief in der Unterwelt ausgesucht, um "
   +"hier ihre Gemeinde aufzubauen, deren Zentrum die Burg darstellt, an der noch gearbeitet "
   +"wird.\n" );
  AddDetail( ({ "ort" , "unterwelt" }) ,
    "Dies hier ist der schrecklichste und gefaehrlichste Ort in der Unterwelt.\n" );
  AddDetail( ({ "burg" , "illithidenburg" , "gemeinde" , "illithidengemeinde" , "zentrum" })  ,
    "Die Burg ist das Zentrum der Macht der Illithidengemeinde.\n" );
  AddDetail( ({ "illithiden" , "illithid" })  ,
    "Ist keiner hier? Oh, aber sie kommen sicher bald...\n" );
  AddDetail( "macht",
    "Hier in der Unterwelt haben die Illithiden alle Macht!\n" );
  AddDetail( ({ "haufen" , "schutthaufen" })  ,
    "Unter dem Schutthaufen wurden wohl einige Sklaven von herabfallenden Gesteinsbrocken "
   +"begraben. Ob darunter sonst noch was liegt?\n" );

  AddSmell( DEFAULT_SMELL , "Hier riecht es leicht nach Verwesung.\n");
  AddSmell( "verwesung" , "Hier ganz in der Naehe muessen Tote liegen. Wo nur?\n");
  AddSmell( ({ "tote" , "naehe" , "geruch"}) , "Der Geruch entstroemt einem grossen Schutthaufen.\n");

  AddItem(NPC("illithid"), REFRESH_DESTRUCT, ([ P_MNPC_DEFAULTROOM : ROOM("laufweg5"), 
			                        P_MNPC_AREA : ROOM("laufweg") ]) );

  AddCmd( ({ "wuehle" , "wuehl" }) , "wuehlen_funk" );

  AddExit("nordostunten", ROOM("laufweg4"));
  AddExit("nordosten", ROOM("laufweg4"));
  AddExit( "nordwestoben" , ROOM("laufweg6"));
  AddExit( "nordwesten" , ROOM("laufweg6"));
  SetProp(P_HIDE_EXITS, ({ "nordosten" , "nordwesten" }));
}


wuehlen_funk(str)
{
object ob; 

notify_fail( "Wie bitte?\n" );
if( str == "in schutt" || str == "schutt" )
 {

  if(ob=deep_present(("\niquestitem"), this_player()))
  {
   if (ob=deep_present(("\nzakpiwafi"), this_player())) 
   {
     write(BKS("Du wuehlst nochmal in dem Schutt, findest aber nichts mehr.\n"));
     return 1;
   }
   else
   {
     write(BKS("Du wuehlst im Schutt und findest tatsaechlich etwas: einen schwarzen Umhang!\n"));  
     clone_object(OBJ("masojpiwafi"))->move(this_player(), M_NOCHECK);  
     say(capitalize(this_player()->name(WER,2)+" wuehlt im Schutt.\n"), this_player());
     return 1;
   }
  }
  else
  {
   write(BKS("Du wuehlst in dem Schutt, findest aber nichts.\n"));
   return 1;  
  } 
 }
return 0;
}
