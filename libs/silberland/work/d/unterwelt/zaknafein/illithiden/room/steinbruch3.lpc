/*    
**        Steinbruch der Illithiden
**
**         Zaknafein Dezember '99
*/



inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

int anzahl=3;

create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "Im Steinbruch der Illithiden" );
  SetProp(P_INT_LONG,
    "In dieser riesigen Hoehle arbeiten zahlreiche Sklaven. Mit schweren Haemmer " 
   +"schlagen sie Gestein aus den Waenden. Der Geruch von Schweiss und Blut "
   +"liegt hier in der Luft und der ohrenbetaeubende Laerm laesst Dich kaum klar "
   +"denken. Hin und wieder bricht ein Sklave erschoepft zusammen, wovon aber keiner "
   +"Notiz nimmt."
   );

  AddDetail( ({ "blut" , "schweiss" })  ,
    "Rieche doch mal...\n");
  AddDetail( "luft"  ,
    "Es ist recht stickig hier.\n");
  AddDetail( "boden" ,
    "Auf dem Boden liegen einige Sklaven, die wegen der harten Arbeit zusammengebrochen "
   +"sind, zwischen den Steinen.\n");
  AddDetail( "arbeit",
    "Es wird Dich viel Arbeit kosten, hier wieder herauszukommen...\n");
  AddDetail( "laerm" ,
    "Hoerst Du das etwa nicht?\n");
  AddDetail( "haemmer" ,
              "Die Haemmer muessen schon sehr stabil sein, wenn mit ihnen Gestein "
             +"aus der Wand schlagen will.\n");
  AddDetail( ({ "wand" , "waende" , "waenden" })  ,
    "Zahlreiche Sklaven bearbeiten die Waende und schlagen Gestein heraus.\n");
  AddDetail(  "sklave" ,
    "Ein Sklave ist direkt neben Dir zusammengebrochen. Was er wohl bei sich traegt?\n");
  AddDetail( "sklaven" ,
    "Sklaven verschiedener Rassen findest Du hier.\n");
  AddDetail( ({ "rasse" , "rassen" }) ,
    "Hier leiden Gnome, Zwerge, Trolle, Oger, Menschen, Elfen und sogar Dunkelelfen.\n");
  AddDetail( ({ "gnome" , "zwerge" , "trolle" , "oger", "menschen" , "elfen" , "Dunkelelfen" }) ,
    "Sie alle haben den Fehler begangen, den Illithiden zu nahe gekommen.\n");
  AddDetail( "fehler" ,
    "Hm, den gleichen Fehler hast Du auch begangen!\n");
  AddDetail( "fels"  , 
    "Es ist sehr anstrengend, diesen Fels zu bearbeiten.\n");
  AddDetail( "notiz"  , 
    "Die anderen Sklaven sind zu sehr beschaeftigt. Voellig apathisch arbeiten sie hier.\n");
  AddDetail( ({ "hoehlen" , "hoehle" })  , 
    "Die Hoehle ist wirklich riesig.\n");
  AddDetail( "decke" ,
    "Die Decke besteht aus Fels.\n");
  AddDetail( ({ "stein" , "steine" , "steinen " }) ,
    "Unmengen an Steinen liegen am Boden\n" );
  AddDetail( "gestein"  ,
    "Das Gestein wird hier im Steinbruch abgebrochen.\n" );
  AddDetail( "illithiden"  ,
    "Hierher kommen die Illithiden nie. Das haben sie auch gar nicht noetig. Sie stehen in "
   +"telepathischer Verbindung mit den Sklaven hier und kontrollieren sie vollstaendig.\n" );
  AddDetail( "verbindung" ,
    "Sehen kann man diese Verbindung nicht, aber man erkennt es an den ausdruckslosen "
   +"Gesichtern der Sklaven.\n");
  AddDetail( ({ "gesichter" , "gesicht" }) ,
    "Die Gesichter der Sklaven sind blutverschmiert und ausdruckslos. Der Tod waere "
   +"eine Erloesung!\n");
  AddSpecialDetail( ({ "erloesung" , "tod" }) , "tod" );
  AddDetail( ({ "ohr" , "ohren" })  ,
    "Zaehle mal nach. Du hast zwei davon.\n");
  AddDetail( ({ "bruch" , "steinbruch" , "steinbruches" })  ,
    "Du willst nur weg von hier!\n" );
  
  AddSmell( DEFAULT_SMELL , "Hier ist es sehr stickig und es riecht nach Schweiss und Blut.\n");
  AddSmell( ({ "schweiss", "blut" , "geruch" }) , "\n");
  AddSound( DEFAULT_SOUND , "Das Haemmern droehnt in Deinen Ohren.\n");
  AddSound( "haemmern" , "Unglaublich laut, da das Haemmern von den Waenden widerhallt.\n");

  AddCmd( ({ "durchsuche" , "durchsuch" }) , "durchsuchen");
 
  AddExit("westen" , ROOM("steinbruch2"));

} 

reset()
{
  ::reset();
anzahl=3;
}


durchsuchen( str )
{

notify_fail( "Wen moechtest Du durchsuchen?\n" );
if( str == "den sklaven" || str == "sklave" || str == "sklaven" )
	{
           object ob;
            
           if (ob=deep_present(("\nzakhammer"), this_player()))
                  write("Du durchsuchst den zusammengebrochenen Sklaven, findest aber nichts.\n");    
           else
                  {
                  if (anzahl != 0 ) 
                    {   
                    anzahl = anzahl -1;
                    clone_object(OBJ("hammer"))->move(this_player(), M_NOCHECK);
                    write("Du findest einen Hammer, den Du sofort einsteckst.\n");
                    }
                   else
                   write("Du durchsuchst den zusammengebrochenen Sklaven, findest aber nichts.\n");    
                  }
             
           return 1;
        }

return 0;	
}

tod()
{
 write("Der Tod teilt Dir mit: DIE ILLITHIDEN SIND MEINE BESTEN FREUNDE! MUAHHAHAHAHA!!!");
 return "\n";
}
