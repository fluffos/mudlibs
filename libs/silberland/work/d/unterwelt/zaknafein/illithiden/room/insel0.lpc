#include "../files.h"

inherit STDROOM;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();



  AddExit( "nordosten", ROOM("kochstelle"));
  AddExit( "osten" , ROOM("insel1"));
  AddGuardedExit("westen", ROOM("ill6") , "ulitharid",
         "Der Ulitharid stellt sich dir in den Weg!\n");


}

