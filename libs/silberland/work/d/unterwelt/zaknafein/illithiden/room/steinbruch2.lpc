/*    
**       Steinbruch der Illithiden
**
**         Zaknafein Dezember '99
*/



inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

int anzahl=2;

create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "Im Steinbruch der Illithiden" );
  SetProp(P_INT_LONG,
    "Du stehst nun in einem Gang, vom dem aus Du, wenn Du nach Osten oder Nordosten " 
   +"gehst, in die riesigen Hoehlen gelangen kannst, in denen in grossen Mengen Gestein "
   +"abgebrochen wird. Suedlich von Dir liegt wohl die Schlafstaette der Sklaven, die "
   +"hier im Steinbruch arbeiten. An den Waenden haengen viele Fackeln, die den umliegenden "
   +"Raeumen schwaches Licht spenden."
   );

  AddDetail( "fels"  , 
    "Es ist sehr anstrengend, diesen Fels zu bearbeiten.\n");
  AddDetail( ({ "raeumen" , "raum" , "raeume" })  , 
    "Meinst Du jetzt die Hoehlen oder die Schlafstaette?\n");
  AddDetail( ({ "bau", "burg" , "mengen" , "menge" }) , 
    "Die Illithiden benoetigen sehr viel Gestein zum Bau ihrer Burg.\n");
  AddDetail( ({ "hoehlen" , "hoehle" })  , 
    "Sie befinden sich im Osten und im Nordosten.\n");
  AddDetail( "gang" ,
    "Dies ist ein einfacher Gang. Hier wird nicht gearbeitet.\n");  
  AddDetail( "haemmern" ,
    "Lausche doch mal.\n");
  AddDetail( "decke" ,
    "Die Decke besteht aus Fels.\n");
  AddDetail( ({ "schlafstaette" , "staette" })  , 
    "Die Schlafstaette liegt suedlich von Dir. Du bist aber sicher, dass sie kaum genutzt wird.\n");
  AddDetail( ({ "felswaende" , "felswaenden" , "wand" , "waende" }),
    "An den Felswaenden haengen viele Fackeln, die den umliegenden Raeumen schwaches Licht spenden.\n");
  AddDetail( ({ "sklaven" , "sklave" }) ,
    "Bist Du nicht einer von ihnen?\n");
  AddDetail( "licht"  , 
    "Das Licht reicht gerade aus, um vernuenftig zu arbeiten.\n");
  AddDetail( ({ "fackeln" , "fackel" })  , 
    "Die Fackeln stecken Fackelhalter. Sie lodern vor sich hin und tauchen die umliegenden "
   +"Raeume in schwaches, flackerndes Licht.\n");
  AddDetail( ({ "halterung" , "halterungen" , "halter" , "fackelhalter" })   , 
    "Da Fackeln nicht fliegen koennen, stecken sie Fackelhaltern. Hm, ob es jemandem auffaellt, "
   +"wenn Du eine herausziehst?\n");
  AddDetail( "boden"  ,
    "Der Boden ist mit Steinen uebersaeht.\n" );
  AddDetail( ({ "stein" , "steine" , "steinen " }) ,
    "Unmengen an Steinen liegen am Boden\n" );
  AddDetail( "gestein"  ,
    "Das Gestein wird hier im Steinbruch abgebrochen.\n" );
  AddDetail( "illithiden"  ,
    "Hier im Steinbruch wird die die Bosheit der Illithiden erst richtig bewusst!\n" );
  AddDetail( "bosheit" ,
    "Du hasst sie langsam!\n");
  AddDetail( ({ "bruch" , "steinbruch" , "steinbruches" })  ,
    "Du willst nur weg von hier!\n" );
  
  AddSmell( DEFAULT_SMELL , "Es riecht hier nach Rauch.\n");
  AddSmell( ({ "fackel", "fackeln" , "rauch" , "geruch" }) , "Der typische Geruch von brennenden Fackeln.\n");
  AddSound( DEFAULT_SOUND , "Lautes Haemmern ertoent aus den umliegenden Raeumen.\n");
  AddSound( ({ "KLOPF", "haemmern" }), "KLOPF, KLOPF, KLOPF\n");

  AddCmd( ({ "ziehe" , "zieh" }) , "ziehen");
  AddExit("westen", ROOM("steinbruch1"));
  AddExit("osten" , ROOM("steinbruch3"));
  AddExit("nordosten" , ROOM("steinbruch4"));
  AddExit("suedunten" , ROOM("schlafstaette"));
  AddExit("sueden" , ROOM("schlafstaette"));
  SetProp(P_HIDE_EXITS, ({"sueden"}) ); 
} 

reset()
{
  ::reset();
anzahl=2;
}


ziehen( str )
{

notify_fail( "Was moechtest herausziehen?\n" );
if( str == "fackel heraus" || str == "fackel aus halterung heraus" || str == "fackel aus halterung" )
	{
                 
           if (anzahl != 0 )        
             {
               anzahl = anzahl - 1;
               write(BKS("Du ziehst eine Fackel aus einer Halterung heraus und "
                        +"steckst sie ein.\n"));                    
               clone_object("/obj/fackel")->move(this_player());
             }
             else
             {
               write(BKS("Du traust Dich nicht, noch mehr Fackeln zu nehmen. Das "
                        +"fiele zu sehr auf.\n"));
             }
           return 1;
        }

return 0;	
}