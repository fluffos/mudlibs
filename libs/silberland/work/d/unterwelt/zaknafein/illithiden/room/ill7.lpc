/* Weg zu den Illithiden
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDROOM;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();



  AddExit("osten", ROOM("ill6"));
  AddExit( "westen" , ROOM("ill5"));
  AddGuardedExit("sueden", ROOM("ill8") , "ulitharid",
         "Solange der Ulitharid lebt, wirst du nicht vorbeikommen!\n");
  AddExit( "suedostoben" , ROOM("laufweg0"));
  AddExit( "suedosten" , ROOM("laufweg0"));
  SetProp(P_HIDE_EXITS, ({ "suedosten" }));

  AddItem(NPC("shakar"), REFRESH_DESTRUCT);

}

