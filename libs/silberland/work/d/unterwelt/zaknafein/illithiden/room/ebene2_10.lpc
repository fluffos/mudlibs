/* Ebene 2 Raum 19  
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDEBENE2;

#include <properties.h>
#include <moving.h>

create()
{
  ::create();

  AddExit("nordosten", ROOM("ebene2_11"));
  AddExit("suedwesten", ROOM("ebene2_9"));
  AddSpecialExit( "nordwestoben" , "nwobfkt" );
  AddSpecialExit( "nwoben" , "nwobfkt" );
  AddSpecialExit( "nwob" , "nwobfkt" );
  SetProp(P_HIDE_EXITS, ({"nwoben" , "nwob" }) );
}

nwobfkt()
{
   object ob;
   if (ob=present(("\nwegitem"), this_player()))
    {
      if(ob->queryeb2()==2)
       {
         this_player()->move(ROOM("ebene3_5"), M_GO , "" , "geht nach nordwestoben" , "kommt herein");
         return 1;
       }
    }
   this_player()->move(ROOM("ebene1_"+to_string(random(24))), M_GO , "" , "verschwindet ploetzlich" , "erscheint ploetzlich");
   return 1;
}