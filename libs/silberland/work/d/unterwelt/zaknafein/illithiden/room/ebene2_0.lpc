#include "../files.h"

inherit STDEBENE2;

#include <mnpc.h>
#include <properties.h>
#include <moving.h>

create()
{
  ::create();


  AddItem(NPC("vampill"), REFRESH_DESTRUCT, ([ P_MNPC_DEFAULTROOM : ROOM("ebene2_0"), 
			                        P_MNPC_AREA : ROOM("ebene2") ]) );
  AddExit("suedosten", ROOM("ebene2_15"));
  AddExit("suedwesten", ROOM("ebene2_1"));
}