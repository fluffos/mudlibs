/* Weg zu den Illithiden
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDROOM;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Hoehle weit unter der Erde" );
  SetProp(P_INT_LONG, "Die Spalte erweitert sich hier zu einer riesigen Hoehle. "
        +"Sie scheint kein Ende zu haben und die Decke verschwindet irgendwo in der Dunkelheit. "
        +"Lediglich die Felswand in deinem Ruecken gibt dir einen festen Bezugspunkt. In einiger "
        +"Entfernung scheint eine kleine Huette zu stehen. Aus der selben Richtung dringen immer "
        +"noch die Klopfgeraeusche an dein Ohr. In suedlicher Richtung kannst du noch schemenhaft "
        +"ein grosses Bauwerk erkennen.");


  AddDetail( ({ "wand" , "waende" }) ,
    "Nur die Felswand in deinem Ruecken ist in der riesigen Hoehle zu erkennen.\n");
  AddDetail( ({ "decke" }) ,
    "Du versuchst angestrengt in der Dunkelheit ueber dir die Decke zu erkennen, aber du "
    +"kannst sie beim besten Willen nicht ausmachen.\n");
  AddDetail( ({ "boden" }) ,
    "Nackter, schwarzer Fels.\n");
  AddDetail( ({ "fels" , "felsgestein", "gestein" }) ,
    "Kuehler, schwarzer Fels. Er wirkt irgendwie bedrohlich auf dich.\n");
  AddDetail( ({ "spalt" , "spalte" , "nordosten"}) ,
    "Im Nordosten kannst du dich wieder in die Spalte zurueckziehen, Feigling.\n");
  AddSpecialDetail( ({ "feigling" }) , "feig");
  AddDetail( ({ "felswand" }) ,
    "Sie befindet sich in deinem Ruecken. Ohne sie waere die Orientierung in dieser riesigen "
    +"dunklen Hoehle noch schwieriger, als sie eh schon ist.\n");
  AddDetail( ({ "ruecken" }) ,
    "Noch ist da die Felswand, aber weiter in der Hoehle haelt dir niemand mehr deinen Ruecken frei.\n");
  AddDetail( ({ "hoehle" , "riesige hoehle" }) ,
    "Mit deinem Ruecken zur Felswand blickst du in die Dunkelheit. Nur im Suedosten "
    +"scheint eine kleine Huette zu stehen. Im Sueden meinst du weitere Lichtquellen "
    +"ausmachen zu koennen.\n");
  AddDetail( ({ "huette" , "suedosten" , "entfernung" }) ,
    "Die kleine Huette im Suedosten ist noch zu weit entfernt, um Einzelheiten erkennen zu koennen.\n");
  AddDetail( ({ "sueden" , "bauwerk", "bau", "werk" ,"lichtquelle" , "lichtquellen" }) ,
    "Die Lichtquellen im Sueden sind noch so weit entfernt, dass man nur mit viel "
   +"Phantasie darin ein Bauwerk erkennen kann.\n");
  AddDetail( ({ "dunkelheit" }) ,
    "Fast ueberall ist es hier stock finster.\n");
  AddDetail( ({ "bezugspunkt" , "orientierung" }) ,
    "Du benutzt die Felswand in deinem Ruecken als Bezugspunkt, um dich besser orientieren zu koennen.\n");
  AddDetail( ({ "einzelheiten" , "einzelheit" }) ,
    "So genau kannst du das von hier nicht erkennen. Dazu musst du wohl oder uebel naeher rangehen.\n");
  AddDetail( ({ "richtung" , "richtungen" }) ,
    "Weil du dich an der Felswand orientierst, kannst du tatsaechlich Richtungen feststellen.\n");
  AddDetail( ({ "klopfgeraeusche" , "klopfen" , "geraeusch" , "geraeusche"}) ,
    "Sperr doch mal deine Ohren auf!\n");
  AddDetail( ({ "ohr" , "ohren" }) ,
    "Damit kann man den wundervollen Geraeuschen lauschen.\n");
  AddDetail( ({ "wille" , "willen" }) ,
    "Hoffentlich wird dir hier kein anderer aufgezwungen.\n");
  AddDetail( ({ "phantasie" }) ,
    "Nur mit viel Phantasie erkennt man darin ein Bauwerk.\n");
  AddDetail( ({ "windzug" , "wind" }) ,
    "Nur in einer riesigen Hoehle kann man einen Windzug verspueren.\n");
  AddDetail( ({ "glueck" , "vorsicht"}) ,
    "Davon kann man nie genug haben.\n");
  AddDetail( ({ "ende" }) ,
    "Du versuchst ein Ende der Hoehle auszumachen, aber in dieser Dunkelheit ist das einfach unmoeglich.\n");


  AddSmell( DEFAULT_SMELL , "Ein leichter Windzug verstraeut den Verwesungsgeruch aus der Spalte sehr schnell.\n");
  AddSmell( ({ "geruch" , "verwesung" , "verwesungsgeruch"}) , "Der Geruch kommt aus der Spalte im Nordosten.\n");

  AddSound( DEFAULT_SOUND , "Du hoehrst entfernte Klopfgeraeusche.\n");
  AddSound( ({ "klopfen", "klopfgeraeusch", "klopfgeraeusche" , "geraeusch" }),
               "Irgendwo scheint jemand den Fels zu bearbeiten.\n");

  AddExit("nordosten", ROOM("ill0"));
  AddExit( "suedosten" , ROOM("ill2"));


}

feig()
{
    if ((this_player()->QueryProp(P_WIMPY))>=(this_player()->QueryProp(P_MAX_HP)-5))
    {
      write(BKS("Mit der Vorsicht und einer Menge Glueck wirst du hier eventuell ueberleben koennen."));
      return "";
    }
    else
    {
      write(BKS("Meinst du nicht, dass deine Vorsicht von gerade mal "+this_player()->QueryProp(P_WIMPY)+" ein bisschen zu niedrig ist?"));
      return "";
    }
}                                       // Ende von feig
