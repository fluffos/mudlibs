#include "../files.h"

inherit STDEBENE1;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();



  AddExit("suedwesten", ROOM("ebene1_17"));
  AddExit("nordwesten", ROOM("ebene1_19"));
  AddItem(NPC("illithid"), REFRESH_DESTRUCT, ([ P_MNPC_DEFAULTROOM : ROOM("ebene1_18"), 
			                        P_MNPC_AREA : ROOM("ebene1") ]) );

}