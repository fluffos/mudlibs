/* Ebene 1 Raum 0  
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDEBENE1;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>
#include <doors.h>
#include <rooms.h>

create()
{
  ::create();



  AddExit("suedosten", ROOM("ebene1_23"));
  AddExit("suedwesten", ROOM("ebene1_1"));

  AddItem(NPC("herek"), REFRESH_DESTRUCT);

 NewDoor("norden",ROOM("ill8"), ({ "tor" , "burgtor" }),
  ({D_NAME,"Burgtor",
  D_GENDER,NEUTER,
  D_SHORT,"Im Norden befindet sich das %se Burgtor.",
  D_LONG,"Das Burgtor ist riesig. Es ist mit Totenschaedeln und mit einem riesigen Gebilde, "
        +"das wie der Kopf eines Illithiden aussieht, verziert.\n",
  D_FLAGS, DOOR_NEEDKEY|DOOR_CLOSED|DOOR_RESET_CL
  }));
  
}

