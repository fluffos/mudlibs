/* Laufweg der Sklaven
** Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDLAUFWEG;

#include <properties.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();


  AddExit("suedwestunten", ROOM("laufweg8"));
  AddExit("suedwesten", ROOM("laufweg8"));
  AddExit( "suedostoben" , ROOM("laufweg10"));
  AddExit( "suedosten" , ROOM("laufweg10"));
  SetProp(P_HIDE_EXITS, ({ "suedosten" , "suedwesten" }));
}