/* Gewand der Ulithariden  
** Zaknafein, Mai 2001
**
**  i)    schuetzt _etwas_ vor DT_MIND
**  ii)   fuegt dem Traeger bei jedem Reset Schaden zu ( zuviel Sievert ;)
**  iii)  extrem guter Ruestungsschutz
**  iv)   tragen nur die staerksten Ulithariden
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddAdjective ("edles", "edlen");
  AddId ("gewand");
  SetProp (P_SHORT, "Ein edles Gewand");
  SetProp (P_LONG,
    "Dieses edle Gewand gehoerte mal einem maechtigen Ulithariden. Es wurde aus "
   +"einem sehr teuren Stoff und etwas, was wie Haut aussieht, geschneidert. Die "
   +"Knoepfe bestehen anscheinend aus einem knochenartigen Material. Die "
   +"Schulter- und Halsregion wird durch Metallplatten besonders geschuetzt.");
  SetProp (P_NAME, "Gewand");
  SetProp (P_NAME_ADJ, "edl");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 950);
  SetProp (P_VALUE, 5000);
  SetProp (P_QUALITY_DECAY, 400);

  SetProp (P_ARMOUR_TYPE, AT_CLOAK);  
  SetProp (P_AC, 10);
  SetProp (P_INFO, break_string("Dieses Gewand kann die Konzentration deiner Gegner stoeren und "
                               +"kann daher sehr nuetzlich sein. "
                               +"Von ihm geht aber auch eine gewisse Bedrohung aus.",78));
  SetProp (P_MATERIAL, ([MAT_CLOTH:60,MAT_PLUTONIUM:5,MAT_MISC_METAL:10,MAT_SKIN:20,MAT_BONE:5]) );

  SetProp (P_DEFEND_FUNC, this_object());

  AddDetail (({"metall","platten"}),
      "Dieses Metall ist dir voellig unbekannt. Es fuehlt sich etwas warm an.\n");
  AddDetail ( ({ "knochen" , "material" }), 
      "Die Knoepfe bestehen tatsaechlich aus Menschenknochen!\n");
  AddDetail ( ({ "regionen","region" , "halsregion" , "schulterregion"}), 
      "Die Schulter- und die Halsregion wird durch Metallplatten besonders gut geschuetzt.\n");
  AddDetail ("stoff", "Es handelt sich um einen sehr teuren und aeusserst widerstandsfaehigen Stoff.\n");
  AddDetail ( ({ "ulithariden" , "ulitharid" }), 
      "Dieses Gewand gehoerte mal einem Ulithariden.\n");
  AddDetail ("haut", 
            "Die Illithiden schmuecken sich mit der Haut und den Knochen ihrer Opfer. Sie "
           +"lassen daraus aufwendige Kleidung und Schmuckstuecke herstellen. Dies soll "
           +"nicht nur ihre Kampfkraft dokumentieren, sondern auch ihre Gegner abschrecken.\n");
  AddDetail ("menschenknochen", "Hm, jedenfalls humanoide Knochen.\n");

  SetProp(P_SMELL, 
           "Ein leichter Verwesungsgeruch entstroemt dem Gewand. Er geht " 
           +"wohl von Leichenteilen aus, aus denen das Gewand zum Teil besteht.\n");
}

void reset()
{
  ::reset();

// Schaden durch radioaktive Strahlung.
// Sorry, muss ich als angehender Teilchenphysiker einfach machen. :-) 

 if (QueryProp(P_WORN))
 {
 tell_object(QueryProp(P_WORN),
        "Ein kleiner Schwindelanfall ueberkommt dich.\n");
 SetProp(P_KILL_NAME, "Ein merkwuerdiges Kribbeln");
 QueryProp(P_WORN)->do_damage(random(20), this_object());
 }
}

int DefendFunc(string *dtyp, mixed spell, object enemy)
{
int prot,mindschaden;
prot = 0;
if (random(10) > 1) return 0;                                 // soll nur manchmal schuetzen
if ((mindschaden=(member(dtyp, DT_MIND) >= 0)))     
 {
  prot = 40 + random(20);                                     // aber dann ordentlich
  tell_object(QueryProp(P_WORN),
        "Dein Gewand stoert die Konzentration deines Gegners.\n");
 }
return prot;
}
