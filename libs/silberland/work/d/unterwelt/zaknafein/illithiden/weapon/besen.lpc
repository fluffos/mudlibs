/*
**                      Besen der Kraeuterhexe 
** 			      
**                      Zaknafein, Februar 2000
**                            
*/

inherit "std/weapon";

#include <properties.h>     
#include <combat.h>        
#include <language.h>      
#include "../files.h"

create()
{

  if (!is_clone(this_object()))
     return;

  ::create();   

SetProp(P_SHORT, "Ein Hexenbesen");
SetProp(P_LONG, "Dieser Besen dient einer Hexe nicht nur als Waffe, sondern "
               +"auch als Fortbewegungsmittel. Da Du aber keine Hexe bist, "
               +"kannst Du wohl nicht auf ihm reiten. Du spuerst deutlich, "
               +"dass eine maechtige Aura von ihm ausgeht.\n");
SetProp(P_INFO, BKS("\n"));
SetProp(P_NAME, "Hexenbesen");
SetProp(P_GENDER, MALE);
AddId( ({ "\nzakbesen" , "besen" , "hexenbesen" }) );
SetProp(P_VALUE, 8000);
SetProp(P_WEIGHT, 2400);  
SetProp(P_MATERIAL, ([MAT_PEAR_WOOD:80, MAT_STRAW:20])); 
SetProp(P_WEAPON_TYPE, WT_CLUB);
SetProp(P_DAM_TYPE, DT_BLUDGEON);
SetProp(P_WC, 125);
SetProp(P_NR_HANDS, 2);
SetProp(P_CURSED,1);
}
