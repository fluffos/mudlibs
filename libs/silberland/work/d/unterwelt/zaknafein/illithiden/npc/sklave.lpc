/*        
**            Ein Sklave der Illithiden 
**
**              Zaknafein Dezember '99
**
*/

inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>
#include "../files.h"


create()
{
  if (!is_clone(this_object())) return;

  ::create();       
  
  SetProp(P_SHORT, "Ein Menschensklave");
  SetProp(P_LONG, BKS("Der Menschensklave ist vollkommen in seine Arbeit "
                     +"vertieft. Mit einem Hammer bearbeitet er die Waende "                     
                     +"des Ganges und schlaegt Steinbrocken heraus. "
                     +"Er ist von der harten Arbeit hier im Steinbruch gezeichnet: "
                     +"Seine Haende sind blutig und angeschwollen und in seinem "
                     +"Gesicht haben sich tiefe Narben gebildet. Er muss hier "
                     +"schon eine Ewigkeit arbeiten!"));
 
  SetProp(P_NAME, "Menschensklave");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "Mensch");
  create_default_npc(5+random(5));
  SetProp(P_ALIGN, 500+random(200)); 
  SetProp(P_SIZE, 170+random(20));  
  SetProp(P_BODY, 50);
  SetProp(P_HANDS, ({" mit seinen blossen Haenden", 50, DT_BLUDGEON}) );
  SetProp(P_MAX_HANDS, 2);  
  
  SetProp(P_REJECT, ({REJECT_DROP, "Der Sklave moechte das nicht haben.\n"}));  
  AddId( ({ "menschensklave" , "sklave" , "sklaven" , "mensch"}) );

  seteuid(getuid(this_object()));

/*
  clone_object(OBJ(""))->move(this_object());
  command("ziehe alles an");
*/
  SetChats(3, ({
  "Der Sklave schlaegt einen Steinbrocken aus der Wand.\n",
  "Der Sklave wischt sich den Schweiss von seiner Stirn.\n"
  }) );
  SetProp( P_DIE_MSG, " faellt tot zu Boden.\n" );
  SetProp(P_DEFAULT_INFO,"antwortet Dir nicht. Er will nur seinen Herren dienen!\n");
  AddInfo("zaknafein",
  "fluestert: Zaknafein ist der Meister der Illithiden!\n");
 
}

