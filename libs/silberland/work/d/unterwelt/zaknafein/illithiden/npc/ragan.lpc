/*        
**  Ragan - Quest-NPC der Illithidenquest
**              
**  Zaknafein, Mai 2001
*/

inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>
#include "../files.h"

#define ILLITHIDENQUEST "Das Herz der Illithiden"
#define ILLITHIDENQUESTLOG "/log/quests/illithiden"

void init()
{
  ::init();
  if(interactive(this_player())) call_out("reaktion",4);
} 

create()
{
  if (!is_clone(this_object())) return;

  ::create();       
  
  SetProp(P_SHORT, "Ragan");
  SetProp(P_LONG, "Ragan ist schwer verletzt. Sein schwarzer Umhang ist "
                  "voellig blutverschmiert. Am Kopf hat er eine grosse "
                  "Platzwunde, so dass man das Weiss seiner Haare nur "
                  "noch erahnen kann. Sein Bauch wurde ueber die ganze "
                  "Laenge aufgeschlitzt. Mit der rechten Hand versucht "
                  "er, seine Gedaerme daran zu hindern, sich ausserhalb "
                  "seines Bauches mal ein wenig umzuschauen. Er braucht "
                  "sicher Hilfe. Frage ihn mal danach.");
  SetProp(P_NAME, "Ragan");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Dunkelelf");
  create_default_npc(40);
  SetProp(P_ALIGN, -1000); 
  SetProp(P_SIZE, 197);  
  SetProp(P_BODY, 600);
  SetProp(P_HANDS, ({" mit seinen Krummsaebeln", 450, DT_SLASH}) );
  SetProp(P_MAX_HANDS, 2);  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.2, DT_COLD:      0.0, DT_WATER:   0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:   0.0, DT_LIGHT:  0.2,
      DT_ELECTRIC:  0.1, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      -0.3, DT_UNHOLY:    -0.3, DT_MAGIC:  -0.3 , DT_MIND: -0.4]) );
  SetProp(P_WIMPY, 0);
  SetProp(P_REJECT, ({REJECT_DROP, "Ragan sagt: Ich brauch das nicht. Hilf mir lieber!\n"}));  
  set_living_name("ragan");
  AddId( ({ "NOWIMPY" , "ragan" }) );
  SetProp(P_NOATTACK, "verblutet! Was willst Du noch?");
  SetProp(P_HP, 40);

  AddCmd( ({ "biet" , "biete" }) , "biete");
  AddCmd( ({ "helf" , "helfe" , "hilf" }), "hilf");

  seteuid(getuid(this_object()));
/*
  clone_object(WEAPON(""))->move(this_object());
  command("zuecke ");
  clone_object()->move(this_object());
  clone_object()->move(this_object());
  clone_object()->move(this_object());
  clone_object()->move(this_object());
  command("ziehe alles an");
*/

  SetProp(P_SPELLRATE,50);
  SetProp(P_NOMAGIC, 25);

  AddSpell(1,550, 
	   "Ragan wirft eine Dunkellanze nach Dir.\n",
	   "Ragan wirft eine Dunkellanze nach @WEM.\n",
           DT_UNHOLY,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,650,
	   "Ragan springt Dir an den Hals und wuergt Dich fast zu Tode.\n",
	   "Ragan springt @WEM an den Hals und wuergt ihn fast zu Tode.\n",
           DT_AIR,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
  "Ragan versucht, sich seine Gedaerme wieder in den Bauch zu stopfen.\n",
  "Ragan sagt: Die Illithiden bringen den Tod!\n",
  "Ragan schaut Dich hilfesuchend an.\n"
  }) );

  SetProp( P_DIE_MSG, " schreit nochmal laut auf, bevor er stirbt.\n" );
 
  SetProp(P_DEFAULT_INFO,({ "sagt: Ich verstehe nicht, was Du meinst.\n",
                            "will was sagen, spuckt aber nur Blut." }));

  AddInfo("zaknafein",
  "Zaknafein darf mir leider nicht helfen.\n", "sagt: ");
  AddInfo( ({ "problem" , "hilfe" }) ,
  "Masoj und ich haben vor wenigen Wochen einen Weg zu den "
 +"Illithiden freigelegt. Im Namen Lloths brachen wir voller "
 +"Stolz auf, um die Illithiden zu vernichten. Ha! Wir Narren! "
 +"Wir hatten gegen sie nicht die Spur einer Chance. Mit viel "
 +"Glueck habe ich es bis hierher geschafft. Masoj hatte weniger "
 +"Glueck. Als ich ihn zuletzt sah, diente er den Illithiden als "
 +"Sklave. Er schien mir voellig apathisch und willenlos. Er war "
 +"nicht er selbst! Ich fand heraus, dass er von dem Zentralgehirn "
 +"der Illithidengemeinde kontrolliert und gesteuert wird. Ich denke, "
 +"man muss es vernichten, um ihn zu befreien. Ich weiss nur nicht wie. "
 +"Frage die Hexe, die in der Naehe der Illtihiden wohnt. Ich hab dazu "
 +"jetzt leider keine Kraft mehr! Wirst du mir helfen?\n", "keucht: ");
  AddInfo( ({ "bruder" , "masoj" }) ,
  "Masoj ist mein Bruder. Du musst ihn befreien. Bitte hilf mir!\n", "sagt: ");
  AddInfo("weg",
  "Der Weg faengt hier an. Schau Dich mal um.\n", "keucht: ");
  AddInfo( ({ "illithid" , "illithiden" }) ,
  "Die Illithiden sind absolut gefaehrlich! Unterschaetze sie bloss "
 +"nicht. Mit ihren telepathischen Kraeften koennen sie voellige "
 +"Kontrolle ueber Dich erlangen und Dich zu einem willenlosen Sklaven "
 +"machen. Selbst wenn sie diese Faehigkeiten nicht einsetzen, koennen "
 +"sie Dich nur mit der Kraft ihrer Gedanken in kleinste Teilchen zerfetzen!"
 +"\n", "warnt Dich: ");
  AddInfo("narren",
  "Wir Narren haben die Macht der Illithiden unterschaetzt!\n", "keucht: ");
  AddInfo("glueck",
  "Auf mein Glueck wuerde ich mich an Deiner Stelle nicht verlassen.\n", "sagt: ");
  AddInfo( ({ "zentralgehirn" , "gehirn" }) ,
  "Ich weiss nicht viel darueber. Frage die Hexe.\n", "bedauert: ");
  AddInfo("hexe",
  "Die Hexe wohnt in einer Holzhuette in der Naehe der Illithidengemeinde. "
 +"Sie kann Dir sicher weiterhelfen!\n", "sagt hoffnungsvoll: ");
  AddInfo( ({ "huette" , "holzhuette" }) ,
  "Sie ist nicht zu uebersehen.\n", "keucht: ");
  AddInfo( ({ "illithidengemeinde" , "gemeinde" }) ,
  "Ein Ort des Grauens!\n", "keucht: ");
  AddInfo( ({ "sklaven" , "sklave" }) ,
  "Sie benoetigen viele Sklaven zum Bau ihrer Burg. Masoj sah ich "
 +"zuletzt im Steinbruch.\n", "keucht: ");
  AddInfo("steinbruch",
  "Dort wirst Du Masoj finden.\n", "keucht: ");
  AddInfo("burg",
  "Wenn die Burg erstmal fertig ist, werden die Illithiden unbesiegbar sein.\n", "keucht: ");
  AddInfo( ({ "dunkelelf" , "dunkelelfen" }) ,
  "Wir Dunkelelfen sind die besten Krieger!\n", "sagt stolz: ");
  
  AddDetail( ({ "gedaerme" , "daerme" , "darm" }) ,
    "Sie haben eine graeuliche Farbe. Interessant...\n" );
  AddDetail( "wunde" ,
    "Naja, sein Koerper weist viele Wunden auf. Ein paar davon sind toedlich.\n" );
  AddDetail( "platzwunde" , 
    "Sieht nicht gut aus, glaube mir.\n" );
  AddDetail( "blut"  ,
    "Das Blut geht ihm langsam aus...\n" );
  AddDetail( "hand" ,
    "Die Hand ist wenigstens noch dran.\n" );
  AddDetail( "umhang" ,
    "Der Umhang ist nicht mehr zu gebrauchen.\n" );
  AddDetail( "haare" ,
    "Seine Haare kann man vor lauter Blut kaum erkennen.\n" );
  AddDetail( "bauch" ,
    "Sein Bauch sieht ziemlich uebel aus.\n" );
  AddDetail( "kopf" ,
    "Der Kopf ist wenigstens noch dran.\n" );
}

biete( str )
{
notify_fail( "Wem moechtest Du was anbieten?\n" );
if( str == "ragan hilfe an" || str == "hilfe an" )
	{
           object ob;
           if (ob=present(("\niquestitem"), this_player()))
                  write("Ragan fragt: Wo ist Masoj? Warum hast Du ihn noch "
                       +"nicht befreit?\n");    
           else
                  {
                  clone_object(OBJ("iquestitem"))->move(this_player());
                  write("Ragan sagt: Sehr gut, Ich danke Dir! Moege Lloth "
                       +"mit Dir sein!\n");

	             write_file (LOG,
	              sprintf ("%s  %s beginnt die Illithidenquest.\n",
	              dtime(time()), capitalize(this_player()->query_real_name())));
              
                     if(find_player("zaknafein")) tell_object(find_player("zaknafein"), 
                       break_string(this_player()->name(WER,2)
                              +" hat mir seine Hilfe angeboten!", 78, 
                               "Ragan teilt dir mit: "));

                  }
             
           return 1;
        }      
return 0;	 
}

hilf( str )
{
notify_fail( "Wem moechtest Du helfen?\n" );
if( str == "ragan" || str == "dunkelelf" )
	{
           object ob;
           if (ob=present(("\niquestitem"), this_player()))
                 write("Ragan fragt: Wo ist Masoj? Warum hast Du ihn noch "
                       +"nicht befreit?\n");

           else
                  {
                  clone_object(OBJ("iquestitem"))->move(this_player());
                  write("Ragan sagt: Sehr gut, Ich danke Dir! Moege Lloth "
                       +"mit Dir sein!\n");

	             write_file (LOG,
	              sprintf ("%s  %s beginnt die Illithidenquest.\n",
	              dtime(time()), capitalize(this_player()->query_real_name())));
              
                     if(find_player("zaknafein")) tell_object(find_player("zaknafein"), 
                       break_string(this_player()->name(WER,2)
                              +" hat mir seine Hilfe angeboten!", 78, 
                               "Ragan teilt dir mit: "));

                  }
             
           return 1;
        }
return 0;	 
}


reaktion()
{
object ob;
object obj;
 
if(environment(this_player())!=environment(this_object())) return;

 if (ob=present(("\niquestitem"), this_player()))
  {
    if(ob->querymasojfolgt()==1) 
     {

     write_file (LOG,
	sprintf ("%s  %s hat Masoj befreit!\n",
	dtime(time()), capitalize(this_player()->query_real_name())));
              
     if(find_player("zaknafein")) tell_object(find_player("zaknafein"), 
        break_string(this_player()->name(WER,2)
        +" hat Masoj befreit! Lloth sei Dank!", 78, 
         "Ragan teilt dir mit: "));
  
     ob->remove();

     if (obj=present(("masoj"), environment(this_object())))
        {
            obj->remove();
        }

	if (!this_player()->QueryQuest(ILLITHIDENQUEST)) 
	{
	  if( this_player()->GiveQuest(ILLITHIDENQUEST) == 1)
	  {
	        write_file (ILLITHIDENQUESTLOG,
	        sprintf ("%s  %s hat Masoj befreit.\n",
	        dtime(time()), capitalize(this_player()->query_real_name())));
	  }
	  else 
	  {
	        write_file (ILLITHIDENQUESTLOG,
	        sprintf ("%s: Fehler bei %s!\n",
	        dtime(time()), capitalize(this_player()->query_real_name())));
	  }
        }
      return;
     }
  }      
 return;
}


void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
    case "fies":
      call_out("react", 0, "grummelt: Hoer' auf, "+this_player()->name(WER, 2),
        "grummelt: Hoer auf, "+this_player()->name(WER, 2));
      break;
    case "aergerlich":
      call_out("react", 0, "suefzt", "seufzt");
      break;
    case "traurig":
      call_out("react", 0, "troestet Dich.",
	       "troestet, "+this_player()->name(WEN, 2));
      break;
    case "albern":
      call_out("react", 0, "grummelt: Ich finde das gar nicht lustig!",
	       "grummelt: Ich finde das gar nicht lustig!");
      break;
    case "neutral":
      call_out("react", 0, "schaut Dich misstrauisch an", "schaut "+this_player()->name(WEN)+" misstrauisch an");
      break;
    case "intim":
      call_out("react", 0, "gibt Dir eine harte Ohrfeige",
                   "gibt "+this_player()->name(WEM)+" eine harte Ohrfeige");
      break;
    case "froh":
      call_out("react", 0, "grinst Dich an",
             "grinst "+this_player()->name(WEN)+" an");
      break;
    case "aengstlich":
      call_out("react", 0, "macht sich ueber Dich lustig",
             "macht sich ueber "+this_player()->name(WEN)+" lustig");
      break;
    case "frech":
      call_out("react", 0, "schaut Dich boese an und zueckt seine Krummsaebel",
               "schaut "+this_player()->name(WEN)+" boese an und zueckt seine Krummsaebel");
      break;
    case "nett":
      call_out("react", 0, "sagt: Ich habe dafuer keine Zeit, "+this_player()->name(WER),
               "sagt: Ich habe dafuer keine Zeit, "+this_player()->name(WER));
      break;
  }
}

void react(string victim, string others)
{
  if (present(this_player(), environment(this_object()))) 
  {
    tell_object(this_player(), break_string(Name(WER, 1) + " "+victim+".", 74));
    tell_room(environment(this_object()), break_string(Name(WER, 1)+" "+others+".", 74), ({this_player(),this_object()}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}
