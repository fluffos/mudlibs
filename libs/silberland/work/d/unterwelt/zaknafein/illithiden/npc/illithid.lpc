/*        
**   Illithid (gibt es in verschiedenen Ausfuehrungen)
**    
**   Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDMNPC; 

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>

#define ART ({ "junger","erfahrener","bedrohlicher","aggressiver" })
int i;
string toeten_func();

create()
{
  if (!is_clone(this_object())) return;

  ::create();       
  
  i=random(sizeof(ART));

  SetProp(P_SHORT, "Ein "+ART[i]+" Illithid");
  SetProp(P_LONG, BKS("Wie alle Illithiden besitzt dieser "+ART[i][0..<2]+" Illithid einen oktopussaehnlichen "
                      "Kopf mit vier Tentakeln, die dort entspringen, wo sich eigentlich der "
                      "Mund befinden muesste. Mit den Tentakeln bohrt sich der Illithid "
                      "durch die Kopfhaut und den Schaedel seiner Opfer, um deren Gehirn "
                      "aufzusaugen. Der uebrige Koerper ist humanoid und mit einer grauen, "
                      "lederartigen Haut bedeckt. Die Illithiden sind wohl die boesartigsten "
                      "und gefaehrlichsten Bewohner des Silberlandes, da sie nicht mit "
                      "gewoehnlichen Waffen kaempfen, sondern ihre telepathischen und "
                      "telekinetischen Kraefte im Kampf einsetzen, gegen die jede Ruestung "
                      "voellig wirkungslos ist. "));
  SetProp(P_NAME, "Illithid");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "Illithid");
  create_default_npc(25+2*i);
  SetProp(P_ALIGN, -100-random(100)); 
  SetProp(P_SIZE, 170+i*random(10)); 
  SetProp(P_AGGRESSIVE, 0.2*(i+1)); 
  SetProp(P_HANDS, ({" mit seinen telepathischen Kraeften", 100+50*i, DT_MIND}) );
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_NOMAGIC, (i+1)*10); 
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.2, DT_COLD:      0.2, DT_WATER:   0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.2, DT_EXPLOSION: 0.5, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.2, DT_TERROR:  -0.5,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  -0.5 , DT_MIND: -0.5]) );
  AddId( ({ "illithid" , "\nillithid" , "NOWIMPY" }) );
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Illithid nimmt nichts von dir an.\n" }) );

  SetProp(P_MNPC_DEFAULTROOM, ROOM("ebene1_0"));
  SetProp(P_MNPC_AREA, ROOM("ebene"));
  SetProp(P_MNPC_WAIT, ({ 10, 10, 20 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS + MOV_BACKWARDS);
  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");

  seteuid(getuid(this_object()));
/*
  clone_object("" )->move(this_object());
  clone_object("" )->move(this_object());
  clone_object("" )->move(this_object());
  if (random(5)<3) clone_object("")->move(this_object());
  command("ziehe alles an");
*/

  SetProp(P_SPELLRATE, 10*i);

  AddSpell(1,200+100*i, 
	   "Der "+ART[i][0..<2]+" Illithid dringt tief in deine Gedanken ein und verwirrt sie.\n",
	   "Der "+ART[i][0..<2]+" Illithid dringt tief in @WESSEN Gedanken ein und verwirrt sie.\n",
           DT_TERROR,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,300+100*i, 
	   "Der "+ART[i][0..<2]+" Illithid zerdrueckt dich fast mit einer Gedankenwelle.\n",
	   "Der "+ART[i][0..<2]+" Illithid zerdrueckt @WEN fast mit einer Gedankenwelle.\n",
           DT_MIND,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,300+100*i, 
	   "Der "+ART[i][0..<2]+" Illithid schlitzt dir mit seinen scharfen Krallen den Bauch auf.\n",
	   "Der "+ART[i][0..<2]+" Illithid schlitzt @WEM mit seinen scharfen Krallen den Bauch auf.\n",
           DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,400+100*i,
	   "Der "+ART[i][0..<2]+" Illithid bohrt seine Tentakeln in deinen Kopf.\n",
	   "Der "+ART[i][0..<2]+" Illithid bohrt @WEM seine Tentakeln in deinen Kopf.\n",
           DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der "+ART[i][0..<2]+" Illithid schwebt weit ueber dir.\n",
    "Der "+ART[i][0..<2]+" Illithid scheint dich noch nicht bemerkt zu haben.\n",
    "Der "+ART[i][0..<2]+" Illithid nimmt telepathische Verbindung zu den anderen Illithiden auf.\n" }));

  SetProp(P_MURDER_MSG, "Die Rache wird mein sein!");
  SetProp(P_KILL_NAME, "Ein "+ART[i]+" Illithid" );
  SetProp(P_KILL_MSG, "Dein Gehirn wird mir schmecken!");
  SetProp( P_DIE_MSG, " faellt zu Boden\n" );
  SetProp(P_HEAL , i*40);
 
  SetProp(P_DEFAULT_INFO, #'toeten_func );
 
  AddDetail( ({ "tentakel" , "tentakeln"  }) ,
    "Die Tentakel dienen dem Illithiden zur Nahrungsaufnahme.\n" );
  AddDetail( "kopf"  ,
    "Dem Kopf entspringen vier Tentakeln.\n" );
  AddDetail( "gehirn"  ,
    "Er ist wohl nicht sehr waehlerisch. Deines wuerde auch genuegen...\n" );
  AddDetail( "opfer"  ,
    "Es ist nur eine Frage der Zeit, bis er dich entdeckt und du moeglicherweise sein naechstes Opfer wirst.\n" );
  AddDetail( "haut"  ,
    "Die Haut der Illithiden ist grau und von vielen Falten durchzogen.\n" );

}

string toeten_func()
   {
     Kill(this_player());
     return "hat dich nun bemerkt und greift dich sofort an.";
   }

