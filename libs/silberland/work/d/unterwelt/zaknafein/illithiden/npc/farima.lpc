/*        
**                 Hexe fuer die Illithiden-Quest
**
**             Die Hexe kann u.a. Objekte entfluchen 
**              und gibt hilfreiche Infos zur Quest. 
**        
**                   Zaknafein, Mai 2001
*/

inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object())) return;

  ::create();       
  
  SetProp(P_SHORT, "Farima, die Kraeuterhexe");
  SetProp(P_LONG, "Farima sieht aus wie eine typische Hexe. Sie ist klein "
                  "und hat eine gebueckte Haltung, was ihren Buckel besonders "
                  "betont. Auf ihrer Kartoffelnase hat sich eine riesige Warze "
                  "angesiedelt und in einer Hand haelt sie einen Besen. Sie muss "
                  "ziemlich maechtig sein, denn es beunruhigt sie kaum, dass sie "
                  "so nahe bei den Illitihiden lebt.");
  SetProp(P_NAME, "Farima");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Mensch");
  create_default_npc(32);
  SetProp(P_ALIGN, 0); 
  SetProp(P_SIZE, 157);  
  SetProp(P_BODY, 300);
  SetProp(P_HANDS, ({" mit ihrem Besen", 300, DT_BLUDGEON}) );
  SetProp(P_MAX_HANDS, 2);  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.2, DT_COLD:      0.2, DT_WATER:   0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.1, DT_ACID:      0.0, DT_POISON: -0.2, DT_TERROR: -0.2,
      DT_HOLY:      -0.5, DT_UNHOLY:    -0.5, DT_MAGIC:  0.2 ]) );
  SetProp(P_WIMPY, 0);
  set_living_name("farima");
  AddId( ({ "NOWIMPY" , "hexe" , "kraeuterhexe" , "farima"  }) );

  AddCmd( ({ "helf" , "helfe" , "hilf" }), "hilf");

  seteuid(getuid(this_object()));
  clone_object(WEAPON("besen"))->move(this_object());
  command("zuecke besen");
/*
  clone_object(ZARMOUR("chitinhose"))->move(this_object());
  clone_object(ZARMOUR("chitinarmschienen"))->move(this_object());
  clone_object(ZARMOUR("spinnenpanzer"))->move(this_object());
  clone_object(ZARMOUR("chitinguertel"))->move(this_object());
  command("ziehe alles an");
*/

  SetProp(P_SPELLRATE,50);
  SetProp(P_NOMAGIC, 40);

  AddSpell(1,400, 
	   "Die Hexe wirft einen riesigen Feuerball auf Dich.\n",
	   "Die Hexe wirft einen riesigen Feuerball auf @WEN.\n",
           DT_FIRE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,600,
	   "Die Hexe zertruemmert Dir mit ihrem Besen den Schaedel.\n",
	   "Die Hexe zertruemmert @WEM den Schaedel.\n",
           DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1,"","",DT_TERROR,"heilenspell");
  AddSpell(1,1,"","",DT_TERROR,"verfluchenspell");

  SetChats(1, ({
  "Die Hexe gisst ihre Kraeuter.\n",
  "Die Hexe schneidet ein paar Kraeuter klein.\n",
  "Farima schaut kurz nach, was Du machst.\n",
  "Farima kichert: Kein Troll ueberlebt meine Feuerbaelle. HIHIHI!\n"
  }) );

  SetProp( P_DIE_MSG, 
      " schaut unglaeubig auf ihre Wunden und stirbt kopfschuettelnd.\n" );
 
  SetProp(P_DEFAULT_INFO, ({ "fragt: Hat das was mit Kraeutern zu tun?\n",
                             "sagt: Ja, ja, lass' uns mal beim Thema bleiben.",
                             "stoehnt: Du kannst Fragen stellen..." }) );

  AddInfo( ({ "entfluchen" , "fluch" }) ,
  "Ich kann jeden Gegenstand, den Du mir gibst, entfluchen. "
 +"Umsonst ist es jedoch nicht. Ich verlange 15000 Muenzen. "
 +"Keine Muenze weniger, aber gerne mehr! HIHIHI!\n","sagt: ");
  AddInfo( ({ "spice" , "kraut" }) ,
  "Ja, das Kraut ist ungeheuer wichtig, wenn man das Zentralgehirn "
 +"der Illithiden vernichten will. Dieses Kraut, es wird auch 'Spice' "
 +"genannt, erlaubt es, zu den astralen Ebenen zu reisen. Leider ist "
 +"es ueberaus selten und ich gab meine ganzen Vorraete vor kurzem "
 +"einem Abenteurer, der es sich ebenfalls zur Aufgabe gemacht hat, "
 +"dass Zentralgehirn zu zerstoeren. Ich habe lange nichts mehr von "
 +"ihm gehoert und vermute daher, dass seine Mission fehlschlug und "
 +"dass er nun ein Sklave der Illtihiden ist. Findest Du ihn, so "
 +"findest Du das Spice. Das Spice alleine hilft Dir jedoch kaum "
 +"weiter, da Du durch einen speziellen Trank das Ziel Deiner Reise "
 +"festlegen musst. Diesen Trank, der Dich zu der astralen Ebene fuehrt, "
 +"auf der der Schutz der Gehirns verankert ist, findest Du im Nebenraum. "
 +"Trinke die Fluessigkeit aus dem Kessel, nachdem Du das Spice gegessen hast "
 +"und Deine Reise beginnt. Was Du dort genau tun musst, weiss ich leider "
 +"nicht. Du bist auf Dich allein gestellt. Viel Erfolg!\n","erklaert: ");
  AddInfo( ({ "illithidengemeinde" , "gemeinde" , "illithiden" }) ,
  "Wenn die Illithidengemeide weiter anwaechst, muss ich wohl fluechten.\n","sagt: ");
  AddInfo("abenteurer",
  "Der Abenteurer trug ein blutrotes Stirnband. Daran wirst Du ihn "
 +"erkennen.\n","sagt: ");
  AddInfo( "berserker" ,
  "Meinst Du wirklich, dass er ein Berserker war? Hm, koennte sein...\n","fragt: ");
  AddInfo("fluessigkeit",
  "Ja, trinke die Fluessigkeit, nachdem Du das Kraut gegessen hast. Sie "
 +"wird Deine Reise ausloesen und lenken.\n","sagt: ");
  AddInfo("reise",
  "Es ist Dein Schicksal, diese Reise anzutreten.\n","sagt: ");
  AddInfo("trank",
  "Die Fluessigkeit in dem Kessel meine ich.\n","sagt etwas genervt: ");
  AddInfo("sklave",
  "Passe gut auf, sonst ereilt Dich das selbe Schicksal.\n","warnt Dich: ");
  AddInfo("kraueter",
  "Kraeuter sind mein Leben.\n","sagt: ");
  AddInfo("schutz",
  "Welcher Art dieser Schutz ist, weiss ich leider nicht. Du musst es selber "
 +"herausfinden.\n","bedauert: ");
  AddInfo("ziel",
  "Das legt der Trank fest.\n","sagt: ");
  AddInfo( ({ "kraeuterhexe" , "hexe" }) ,
  "Ich bin eine sehr maechtige und weise Kraeuterhexe.\n","sagt stolz: ");
  AddInfo( "kraeuter",
  "Ja, ich kenne mich bestens mit Kraeutern aus. Moechtest du etwas bestimmtes wissen?\n","fragt: ");
  AddInfo( ({ "gehilfe" , "kroete" }) ,
  "Die Kroete im Laden ist mein Gehilfe.\n","erklaert: ");

  AddDetail( "warze"  ,
    "Wuahh! Die Warze ist echt ekelhaft.\n" );
  AddDetail( ({ "nase" , "kartoffelnase" }) ,
    "Nur Hexen haben solch ausgepraegte und haessliche Kartoffelnasen.\n" );
  AddDetail( ({ "buckel" , "haltung" }) ,
    "Naja, eine Traumfigur hat sie eher nicht...\n" );
  AddDetail( "besen" ,
    "Natuerlich dient ihr der Besen als Fortbewegungsmittel, aber "
   +"sie setzt ihn wohl auch als Waffe ein. \n" );
 
}
void heilenspell(object enemy, int damage, mixed dam_type) 
{
tell_room(environment(enemy), 
 "Die Hexe isst ein paar Kraeuter und sieht danach gestaerkt aus.\n"); 
  heal_self(random(300));
}

void verfluchenspell(object enemy, int damage, mixed dam_type) 
{
 
}

give_notify(object obj)
{
 if(obj->QueryProp(P_CURSED)!=0)
  {
      if((this_player()->QueryMoney())>=15000)
      {
       write(BKS("Farima untersucht "+obj->name(WEN,1)+" genau. Dann "
                +"steckt sie sich ein paar ausgesuchte Kraeuter in den "
                +"Mund, kaut sie und spuckt sie schliesslich auf "
                +obj->name(WEN,1)+". Dann verlangt sie Geld von Dir, das "
                +"Du ihr bereitwillig gibst.\n"));
       obj->SetProp(P_CURSED, 0);
       this_player()->AddMoney(-15000);
      }
      else write("Tja, Du hast nicht genug Geld.\n");
  }
  else write(BKS("Farima sagt: "+capitalize(obj->name(WER,1))+" ist nicht verflucht!\n"));

obj->move(this_player(),M_NOCHECK);
write("Die Hexe gibt Dir "+obj->name(WEN, 1)+" wieder.\n");

 ::give_notify(obj);
}

