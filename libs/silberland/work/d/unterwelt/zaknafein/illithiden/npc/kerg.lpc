/*        
**   Kerg, Koch auf der Sklaveninsel - dient den Illithiden 
**        
**   Zaknafein, Mai 2001
*/

#include "../files.h"

inherit STDNPC;

inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;

  ::create();       
  
  SetProp(P_SHORT, "Kerg, der Gehilfe der Illithiden");
  SetProp(P_LONG, "Kerg ist ein kleiner, boeser Mensch, der den Illithiden hilft, die Sklaven "
                 +"mit Nahrung zu versorgen. Dies tut aber er sicher nicht, weil er etwa grossherzig ist, "
                 +"sondern weil ihm die Illithiden viel Geld dafuer bezahlen. Wegen seiner Geldgier "
                 +"schreckt er auch nicht davor zurueck, den Feinden seiner Herren etwas zu verkaufen. "
                 +"Finster blickt er dir in die Augen. Er ist mit einer Peitsche und einer maechtigen "
                 +"Ruestung ausgestattet, damit er mit aufsaessigen Sklaven fertig wird.");
  SetProp(P_NAME, "Kerg");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Mensch");
  create_default_npc(28);
  SetProp(P_ALIGN, -800); 
  SetProp(P_SIZE, 167);  
  SetProp(P_HANDS, ({" mit Peitsche", 300, DT_WHIP}) );
  SetProp(P_MAX_HANDS, 2);  

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.2, DT_COLD:      0.2, DT_WATER:   0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:   0.0, DT_LIGHT:  0.2,
      DT_ELECTRIC:  0.0, DT_ACID:      -0.5, DT_POISON: 0.5, DT_TERROR: 0.0,
      DT_HOLY:      0.4, DT_UNHOLY:    -0.4, DT_MAGIC:  0.2, DT_MIND: -0.5 ]) );
  SetProp(P_WIMPY, 100);

  set_living_name("kerg");

  AddId( ({ "kerg" , "koch" , "gehilfe" , "helfer" }) );

  seteuid(getuid(this_object()));
  clone_object("/p/weapon/whip/peitsche")->move(this_object());
  command("zuecke peitsche");

  clone_object("/p/armour/trousers/mithrilbeinlinge")->move(this_object());
  clone_object("/p/armour/armour/mithrilpanzer")->move(this_object());
  clone_object("/p/armour/boots/kampfstiefel")->move(this_object());
  command("ziehe alles an");

  SetProp(P_SPELLRATE,50);
  SetProp(P_NOMAGIC, 0);

  AddSpell(1,300, 
	   "Kerg wirft einen Feuerball auf dich.\n",
	   "Kerg wirft einen Feuerball auf @WEN.\n",
           DT_FIRE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,400,
	   "Kerg bespritzt dich mit aetzender Saeure.\n",
	   "Kerg bespritzt @WEN mit aetzender Saeure.\n",
           DT_ACID,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1,"","",DT_BLUDGEON,"fesselnspell");

  SetChats(1, ({
  "Kerg schlaegt einen Sklaven mit der Peitsche.\n",
  "Kerg gibt einem Sklaven einen Teller mit duenner Suppe.\n",
  "Kerg spuckt in den Suppenkessel.\n",
  "Kerg ueberprueft seine Ausruestung.\n"
  }) );

  SetProp( P_DIE_MSG, 
      " stirbt mit einem Fluch auf seinen Lippen\n" );
 
  SetProp(P_DEFAULT_INFO, "sagt: Kaufst du jetzt was oder nicht?\n");

  AddInfo( ({ "sklaven" , "sklave" }) ,
  "Die Sklaven sind so gut wie tot. Lange haelt es hier keiner aus." ,"sagt: ");
  AddInfo( "zaknafein",
  "Zaknafein hat den Illithiden geholfen, sich hier anzusiedeln." ,"erklaert dir: ");
  AddInfo( ({ "illithiden" , "illithide" }) ,
  "Ich bin froh, dass _ich_ sie nicht zum Feind habe." ,"lacht: ");
  AddInfo( ({ "feind" , "feinde" }) ,
  "Die Illithiden sehen alle Wesen, die sich hierher verirren als Feine an." ,"meint: ");
  AddInfo( ({ "leute" , "wesen" }) ,
  "Muss ich dir alles erklaeren?" ,"sagt: ");
  AddInfo( "masoj",
  "Ich glaube, so heisst einer der Sklaven hier." ,"sagt: ");
  AddInfo( ({ "geld" , "gold" }) ,
  "Ich werde gut von den Illithiden bezahlt. Das meiste verdiene ich aber an Leuten wie dir." ,"sagt: ");
  AddInfo( "hexe"  ,
  "Eine Hexe soll hier in der Naehe wohnen. Sie soll sehr maechtig sein." ,"sagt: ");
 
}

void fesselnspell(object enemy, int damage, mixed dam_type) 
{
string gen;
string arti;

if(enemy->QueryProp(P_GENDER)==2)
 gen="sie";
else
 gen="ihn";
if(enemy->QueryProp(P_GENDER)==0) // enemy kann z.B. ein Elementar/Daemon sein !
 gen="es";

enemy->SetProp(P_DISABLE_ATTACK, 1 + random(3));
enemy->do_damage(10+random(20));

if(enemy->QueryProp(P_ARTICLE)==0)         // enemy kann z.B. ein Elementar/Daemon sein !
 {
  tell_room(environment(enemy), 
    "Kerg fesselt "+capitalize(enemy->Name())+
    " mit seiner Peitsche und wirft "+gen+" zu Boden.\n", ({ enemy }) ); 
  tell_object(enemy, 
    "Kerg fesselt dich mit seiner Peitsche und wirft dich zu Boden.\n"); 
 }
else                                       
 {
     if(enemy->QueryProp(P_GENDER)==2)
      arti="eine";
     else
      arti="einen";
     if(enemy->QueryProp(P_GENDER)==0) 
      arti="ein";

  tell_room(environment(enemy), 
    "Kerg fesselt "+arti+" "+capitalize(enemy->Name(RAW))+
    " mit seiner Peitsche und wirft "+gen+" zu Boden.\n", ({ enemy }) ); 
 }

}

