/*        
**  Das Zentralgehirn der Illithiden 'Elder Brain'
**
**  Zaknafein, Mai 2001
**
*/

#include "../files.h"

inherit STDNPC;

inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>

int maxgolem=3; // maximale Anzahl der Brain Golems, die das Brain herbeiruft

create()
{
  if (!is_clone(this_object())) return;

  ::create();       
  
  SetProp(P_SHORT, "Das Elder Brain"); 
  SetProp(P_LONG, "Scheinbar schutzlos liegt das grosse Zentralgehirn, das Elder Brain, vor dir. "
                 +"Diese graeuliche, pulsierende Masse, die fast den ganzen Raum einnimmt "
                 +"und einen abstossenden Geruch verbreitet, steuert die gesamte Illithidengemeinde. "
                 +"Wird es getoetet, so bedeutet dies eine enorme Schwaechung der Illithiden, weshalb "
                 +"es auch einen besonderen Schutz hat, der von den Astralebenen ausgeht.");  
  SetProp(P_NAME, "Elder Brain");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "Organ");            
  create_default_npc(1);
  SetProp(P_ALIGN, 0); 
  SetProp(P_SIZE, 400);  
  SetProp(P_BODY, 1);
  SetProp(P_HANDS, ({" deinen Verstand", 100, DT_MIND}) );
  SetProp(P_MAX_HANDS, 0);    
  SetProp(P_REJECT, ({REJECT_DROP, "Einem Gehirn kann man schlecht was geben...\n"}));
  SetProp(P_MSGIN, "entsteht aus dem Nichts");
  SetProp( P_DIE_MSG, " hoert auf zu pulsieren.\n" );
  SetProp(P_NOCORPSE, 1);
  SetProp(P_DEFAULT_INFO,"kann nicht sprechen!\n");
  AddId( ({ "NOWIMPY" , "brain" , "\nelderbrain" }) );
  SetProp(P_MAX_HP, 3000);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      1, DT_COLD:      1, DT_WATER:   1, DT_AIR:    1, 
      DT_LIGHTNING: 1, DT_EXPLOSION: 1, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  1, DT_ACID:      1, DT_POISON: 1, DT_TERROR: -1,
      DT_HOLY:      1, DT_UNHOLY:    1, DT_MAGIC:  -1, DT_MIND: -1 ]) );

  SetProp(P_SPELLRATE, 20);
  set_living_name("elder brain");
  SetProp(P_KILL_NAME, "Das Elder Brain" );
  AddSpell(1,1,"","",DT_MIND,"braingolem");
 
}

void braingolem(object enemy, int damage, mixed dam_type) 
{
  if(maxgolem>0)
   {
    tell_room(environment(enemy), "Ein Brain Golem formt sich aus der Gehirnmasse.\n");
    clone_object(NPC("braingolem"))->move(environment(enemy), M_NOCHECK);
    maxgolem=maxgolem-1;
   }
}

die(arg) 
{
object ob;
if (ob=present(("\niquestitem"), this_player())) 
     {
       if(ob->queryschutzweg()==1)
           {
            tell_room(environment(this_object()), capitalize(this_player()->Name())+" toetet das Elder Brain!\n");             
            ob->gehirntotein();

	      write_file (LOG,
	      sprintf ("%s  %s hat das Elder Brain getoetet.\n",
	      dtime(time()), capitalize(this_player()->query_real_name())));
              
               if(find_player("zaknafein")) tell_object(find_player("zaknafein"), 
                       break_string(this_player()->name(WER,2)
                              +" hat mich besiegt!", 78, 
                               "Das Elder Brain teilt dir mit: "));

	    :: die();
            return 0;          
           }
     }
 
 heal_self(200);
 tell_room(environment(this_object()), "Das Elder Brain regeneriert sich auf magische Weise.\n");

return 0;
}
