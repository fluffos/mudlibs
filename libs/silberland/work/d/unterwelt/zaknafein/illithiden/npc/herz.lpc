/*        
**             Das Herz der Illithiden 
**
**              Zaknafein, Mai 2001
**
*/

inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>
#include "../files.h"


create()
{
  if (!is_clone(this_object())) return;

  ::create();       
  
  SetProp(P_SHORT, #'short); // Kein 0, damit man es untersuchen kann.
  SetProp(P_LONG, #'long );  // Es soll kein 'Es ist absolut fit.' kommen.
  SetProp(P_NAME, "Herz");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "Organ");            
  create_default_npc(1);
  SetProp(P_ALIGN, 0); 
  SetProp(P_SIZE, 20);  
  SetProp(P_BODY, 1);
  SetProp(P_HANDS, ({" nicht", 0, DT_BLUDGEON}) );
  SetProp(P_MAX_HANDS, 0);    
  SetProp(P_REJECT, ({REJECT_DROP, "Wie soll ein Herz sowas tragen koennen?\n"}));
  SetProp(P_MSGIN, "erscheint unter der Schale aus Eis");
  SetProp( P_DIE_MSG, " hoert auf zu pulsieren.\n" );
  SetProp(P_NOCORPSE, 1);
  SetProp(P_DEFAULT_INFO,"kann nicht sprechen!\n");
  AddId( ({ "NOWIMPY" , "herz" , "\nzakherz" }) );
  seteuid(getuid(this_object()));
}

die(arg) 
{
object ob;
if (ob=present(("\niquestitem"), this_player())) 
     {
       if(ob->queryschale()!=2)
           {
             heal_self(100);
             write("Das Herz regeneriert sich auf magische Weise.\n");
             return 0;
           }
       ob->schutzwegein();
       ob->schaleweg();
     }

     write_file (LOG,
	sprintf ("%s  %s hat das Herz der Illithiden zerstoert!\n",
	dtime(time()), capitalize(this_player()->query_real_name())));
              
     if(find_player("zaknafein")) tell_object(find_player("zaknafein"), 
        break_string(this_player()->name(WER,2)
        +" hat soeben das Herz der Illithiden zerstoert! HILFE!!!", 78, 
         "Das Elder Brain teilt dir mit: "));

write(BKS("Toedlich getroffen zuckt das Herz noch einen kleinen Augenblick, "
         +"dann hoert schliesslich es fuer immer auf zu schlagen.\n"));

tell_room(environment(this_player()), this_player()->name(WER,2)
   +" faellt besinnungslos zu Boden und loest sich dann vor Deinen Augen auf!\n", ({ this_player() }) );

this_player()->move(ROOM("dummy"), M_GO|M_SILENT|M_NO_SHOW);
write(BKS("Du verlierst die Besinnung.\n"));
call_out(("seq1"),1);

return 0;
}

void seq1()
{
  write(BKS("\n"));
  call_out(("seq2"), 5);
}
void seq2()
{
  write(BKS("Sequenz folgt...\n"));
  tell_room(ROOM("haus1"), this_player()->name(WER,2)
               +" materialisiert sich ploetzlich neben Dir auf dem Boden.\n");
  this_player()->move(ROOM("haus1"), M_GO|M_SILENT|M_NO_SHOW);
  this_object()->remove();
}

short()
{
return "";
}

long()
{
object ob;
if (ob=present(("\niquestitem"), this_player()))
{
  if(ob->queryschale()==2)
    return "Schwach und ohne Schutz schwebt es neben Dir.\n";
  if(ob->queryschale()==3)
    return "Ein totes Herz schwebt neben Dir.\n";
  return "Sowas siehst Du hier nicht.\n";
}
return "Kein Questitem?! Informiere schnell Zaknafein!\n";    
}
