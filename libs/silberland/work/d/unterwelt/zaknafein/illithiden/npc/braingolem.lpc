/*        
**   Ein Brain Golem, beschuetzt das Elder Brain  
**
**   Zaknafein, Mai 2001
**
*/

#include "../files.h"

inherit STDNPC;
 
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;

  ::create();       

  SetProp(P_SHORT, "Ein Brain Golem");
  SetProp(P_LONG, BKS("Der Brain Golem scheint vollstaendig aus Gehirnmasse zu bestehen. Er "
                     +"wurde vom Elder Brain erschaffen, um es zu verteidigen."));

  SetProp(P_NAME, "Brain Golem");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "GOLEM");
  create_default_npc(24);
  SetProp(P_ALIGN, -500); 
  SetProp(P_SIZE, 260);  
  SetProp(P_HANDS, ({" mit seinen maechtigen Faeusten", 400, DT_BLUDGEON}) );
  SetProp(P_MAX_HANDS, 2);  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.4, DT_COLD:      0.4, DT_WATER:   0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.1, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.2,
      DT_HOLY:      0.5, DT_UNHOLY:    0.5, DT_MAGIC:  0.0, DT_MIND: 0.0 ]) );
  SetProp(P_WIMPY, 0);
  SetProp(P_REJECT, ({REJECT_DROP, "Der Brain Golem hat alles, was er braucht.\n"}));  
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_NOCORPSE, 1);

  AddId( ({"golem" , "NOWIMPY" , "brain golem" ,"golem" }) );

  SetProp(P_SPELLRATE,40);

  AddSpell(1,400, 
	   "Der Brain Golem wuergt Dich fast zu Tode.\n",
	   "Der Brain Golrem wurgt @WEN fast zu Tode.\n",
           DT_AIR,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,400,
	   "Der Brain Golem rammt Dich.\n",
	   "Der Brain Golem rammt @WEN..\n",
           DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,400, 
	   "Der Brain Golem bruellt dich an.\n",
	   "Der Brain Golrem bruellt @WEN an.\n",
           DT_SOUND,([SP_SHOW_DAMAGE:1]));

 
  SetProp(P_DIE_MSG, " vereinigt sich wieder mit dem Elder Brain.\n" );
  SetProp(P_KILL_MSG, "Das Elder Brain lebe ewiglich!");
 
  SetProp(P_DEFAULT_INFO,"kann nicht sprechen. Er kann nur kaempfen.\n");

}
