// Standard-NPC
// Zaknafein, Mai 2001

#include "../../files.h"

inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>


void create() {
  if (!is_clone(TO)) return;
  ::create();

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == this_object())
  ILLMASTER->DieLog( killer , player->query_real_name() );
  return;
}


void die(int poisondeath)
{
  ILLMASTER->KillLog(this_object() , this_player()->query_real_name() );

  return ::die(poisondeath);
}



