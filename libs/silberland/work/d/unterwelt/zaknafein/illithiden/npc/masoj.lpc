/*
**  Dunkelelfenkrieger 'Masoj' (muss befreit werden)
**
**  Zaknafein, Mai 2001
**
*/

inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../files.h"

string name;
object player;                                       // Name des Spielers, dem Masoj folgt

void init()
{
  ::init();
  if(interactive(this_player())) call_out("reaktion",0);
}

create()
{
  if (!is_clone(this_object())) return;

  ::create();

  name="XYZ";

  SetProp(P_SHORT, "Masoj");
  SetProp(P_LONG, "Vor Dir steht Masoj. Vor wenigen Wochen war er noch ein "
                  "maechtiger und stolzer Dunkelelfenkrieger. Nun ist er von "
                  "der harten Arbeit im Steinbruch gezeichnet. Seine weissen "
                  "Haare sind verfilzt und sein schwarzer Umhang ist voellig "
                  "zerfetzt. Lasse Dich aber nicht von seinem Aeusseren "
                  "taeuschen. Auch in diesem Zustand ist er ein gefaehrlicher "
                  "Gegner.");
  SetProp(P_NAME, "Masoj");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Dunkelelf");
  create_default_npc(30);
  SetProp(P_ALIGN, -1000);
  SetProp(P_SIZE, 210);
  SetProp(P_BODY, 250);
  SetProp(P_FRIEND, 1);
  SetProp(P_HANDS, ({" mit seinen Krummschwertern", 350, DT_SLASH}) );
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.1, DT_COLD:      0.0, DT_WATER:   0.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:   0.0, DT_LIGHT:  0.2,
      DT_ELECTRIC:  0.1, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.1,
      DT_HOLY:      0.3, DT_UNHOLY:    -0.3, DT_MAGIC:  0.0, DT_MIND: 0.0 ]) );
  SetProp(P_WIMPY, 0);
  SetProp(P_REJECT, ({REJECT_DROP, "Masoj nimmt nichts von dir an.\n"}));
  set_living_name("masoj");
  AddId( ({ "NOWIMPY" , "krieger" , "dunkelelfenkrieger" , "masoj" }) );
  SetProp(P_NOATTACK, "kannst du nicht angreifen.");
  AddCmd( ({ "frag" , "frage" }) , "fragen");

  seteuid(getuid(this_object()));

/*
  clone_object()->move(this_object());
  clone_object()->move(this_object());
  clone_object()->move(this_object());
  clone_object()->move(this_object());
  command("ziehe alles an");
*/

  SetProp(P_SPELLRATE,50);
  SetProp(P_NOMAGIC, 30);

  AddSpell(1,400,
	   "Wirft eine riesige Dunkellanze auf dich.\n",
	   "Wirft eine riesige Dunkellanze auf @WEN.\n",
           DT_UNHOLY,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,500,
	   "Masoj zerschnetzelt dich in kleine Stueckchen.\n",
	   "Masoj zerschnetzelt @WEN in kleine Stueckchen.\n",
           DT_SLASH,([SP_SHOW_DAMAGE:1]));

  SetProp( P_DIE_MSG, " faellt tot zu Boden. NEIN!!!\n" );

  SetProp(P_DEFAULT_INFO,"schaut Dich nur mit ausdruckslosen Augen an.\n");

  AddInfo("zaknafein",
  "sagt stolz: Zaknafein ist ein guter Freund von mir.\n");
  AddInfo("xatana",
  "\n");
  AddInfo( ({ "",""}) ,
  "\n", "sagt stolz: ");
  AddInfo( ({ "",""}) ,
  "\n", "sagt stolz: ");
  AddInfo( ({ "",""}) ,
  "\n", "sagt stolz: ");

  AddDetail( ({ "" , "" }) ,
    "\n" );
  AddDetail( ({ "" , "" }) ,
    "\n" );
  AddDetail( ({ "" , "" }) ,
    "\n" );
  AddDetail( ({ "" , "" }) ,
    "\n" );



}

reaktion()
{
object ob;
object obj;

if(environment(this_player())!=environment(this_object())) return;

if(name=="XYZ")
{
 if (ob=present(("\niquestitem"), this_player()))
  {

    if(ob->querymasojfolgt()==1)                  // falls Spieler das SL verlassen hat
     {
       write(BKS("Mosoj sagt: Da bist du ja wieder! Wir muessen schnell raus hier!\n"));
       this_player()->AddPursuer(this_object());
       name=this_player()->query_real_name();
       return;
     }

    if(ob->queryaufgabe()==1)
     {
        if ((obj=present(("\nzakpiwafi"), this_player())) && (obj=present(("\nzakschwerta"), this_player())) && (obj=present(("\nzakschwertb"), this_player())))
        {
        if (obj=present(("\nzakpiwafi"), this_player())) obj->remove();
        if (obj=present(("\nzakschwerta"), this_player())) obj->remove();
        if (obj=present(("\nzakschwertb"), this_player())) obj->remove();
        write(BKS("Mosoj sagt: Wie ich sehe hast du alle Sachen! Nun folge ich Dir!\n"));
        write(BKS("Mosoj nimmt dir die Sachen ab.\n"));
        this_player()->AddPursuer(this_object());
        ob->masojfolgtein();
        name=this_player()->query_real_name();
        player=find_player(name);
        clone_object(NPC("wache"))->move(ROOM("insel0"), M_GO, "", "fliegt eilig fort" , "kommt hereingeflogen und greift dich sofort an");
        SetProp(P_NOATTACK, 0);
        }
        else
        {
        write(BKS("Mosoj sagt: Schnell! Hole mir meinen Piwafi und meine beiden Schwerter!\n"));
        }
       return;
     }

    if(ob->querygehirntot()==1)
     {
       write(break_string("Danke! Du hast das Elder Brain zerstoert! "
                         +"Jetzt besorge mir noch meine Schwerter und meinen Piwafi, "
                         +"damit wird zusammen verschwinden koennen!",76,"Masoj erklaert dir: "));
       ob->aufgabeein();
       return;
     }
  }
}
else
{
// Spieler noch im SL? Wenn nicht: in den Steinbruch! Sonst: Gegner des Spielers angreifen!
if(!find_player(name))
  {
    this_object()->move(ROOM("steinbruch4"), M_GO, "", "geht voellig apathisch in den Steinbruch" , "kommt voellig apathisch herein und faengt an zu arbeiten");
    name="XYZ";
  }
  else
  {
   Kill(find_player(name)->InFight());
  }
}

return;
}

queryplayername()                                                     // fuer Quest-Tool
{
return name;
}
