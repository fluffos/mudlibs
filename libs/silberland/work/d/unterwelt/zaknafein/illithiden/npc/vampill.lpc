/*        
**   Vampir-Illithid
**    
**   Zaknafein, August 2001
*/

#include "../files.h"

inherit STDMNPC; 

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include <mnpc.h>

string toeten_func();

create()
{
  if (!is_clone(this_object())) return;

  ::create();       

  SetProp(P_SHORT, "Ein Vampir-Illithid");
  SetProp(P_LONG, BKS("Vampir-Illithiden gleichen den gewoehnlichen Illithiden aeusserlich "
                     +"sehr. Sie sind jedoch etwas kleiner und zierlicher, was sie erheblich "
                     +"wendiger und schneller macht. Die Tentakeln an ihrem oktopussaehnlichen "
                     +"Kopf sind nur wenig entwickelt, aber dafuer besitzen sie lange, scharfe "
                     +"Fangzaehne, mit denen sie ihre Opfer beissen, um aus den Wunden ihr Blut "
                     +"auszusaugen. Was ihre Intelligenz angeht gleichen sie eher Raubtieren."));
  SetProp(P_NAME, "Vampir-Illithid");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "Untot");
  create_default_npc(22);
  SetProp(P_ALIGN, -500-random(100)); 
  SetProp(P_SIZE, 180-random(20)); 
  SetProp(P_AGGRESSIVE, 0.8); 
  SetProp(P_HANDS, ({ " mit seinen Vampirzaehnen", 300, DT_PIERCE }) );
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_NOMAGIC, 20); 
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.3, DT_COLD:      -0.2, DT_WATER:   0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.2, DT_EXPLOSION: 0.3, DT_SOUND:   0.0, DT_LIGHT:  0.2,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: -0.2, DT_TERROR:  -1,
      DT_HOLY:      0.2, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 , DT_MIND: -0.2]) );
  AddId( ({ "vampir-illithid" , "illithid" , "vampir" , "NOWIMPY" }) );
  AddClass(CL_UNDEAD);
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Vampir-Illithid nimmt nichts von dir an.\n" }) );

  SetProp(P_MNPC_DEFAULTROOM, ROOM("ebene2_0"));
  SetProp(P_MNPC_AREA, ROOM("ebene2"));
  SetProp(P_MNPC_WAIT, ({ 10, 10, 20 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS + MOV_BACKWARDS);
  SetProp(P_MSGIN, "erscheint");
  SetProp(P_MSGOUT, "verschwindet");

  seteuid(getuid(this_object()));
/*
  clone_object("" )->move(this_object());
  clone_object("" )->move(this_object());
  clone_object("" )->move(this_object());
  if (random(5)<3) clone_object("")->move(this_object());
  command("ziehe alles an");
*/

  SetProp(P_SPELLRATE, 60);

  AddSpell(3,500, 
	   "Der Vampir-Illithid schlitzt dich mit seinen Krallen auf.\n",
	   "Der Vampir-Illithid schlitzt @WEN mit seinen Krallen auf.\n",
           DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,1,"","",DT_TERROR,"mindblast");

  AddSpell(2,500, 
	   "Der Vampir-Illithid haucht dir den Hauch des Todes entgegen!\n",
	   "Der Vampir-Illithid haucht @WEM den Hauch des Todes entgegen!\n",
           DT_UNHOLY,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,800,
	   "Der Vampir-Illithid beisst dir in den Hals und saugt dir etwas Blut aus!\n",
	   "Der Vampir-Illithid beisst @WEM in den Hals!\n",
           DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetProp(P_MURDER_MSG, "Die Rache wird mein sein!");
  SetProp(P_KILL_NAME, "Ein Vampir-Illithid" );
  SetProp( P_DIE_MSG, " stuerzt zu Boden.\n" );
  SetProp(P_HEAL , 40);
  SetProp(P_NOCORPSE, 1);
 
  SetProp(P_DEFAULT_INFO, #'toeten_func );
 
  AddDetail( ({ "tentakel" , "tentakeln"  }) ,
    "Die Tentakel brauchen sie, um ihren Opfer (also Leuten wie dir) das Gehirn auszusaugen.\n" );
  AddDetail( ({ "zaehne" , "fangzaehne" }) ,
    "Es sind gewaltige Vampirzaehne!\n" );
  AddDetail( ({ "raubtiere" , "raubtier" , "tiere"  "tier" }),
    "Vampit-Illithiden sind weitaus weniger intelligent als gewoehnliche Illithiden.\n" );
  AddDetail( "opfer"  ,
    "Es ist nur eine Frage der Zeit, bis er dich entdeckt und du moeglicherweise sein naechstes Opfer wirst.\n" );
  AddDetail( "haut"  ,
    "Die Haut der Illithiden ist grau und von vielen Falten durchzogen.\n" );

}

second_life()
{
if(1==random(5))
{
 tell_room(environment(),
    "Der Vampir-Illithid steht wieder auf und ist wieder voellig fit!\n" ); 
 clone_object(NPC("vampill"))->move(environment(),M_NOCHECK);
}
else
 tell_room(environment(),
    "Er verbrennt zu einem Haeufchen Asche und ist nun endgueltig tot (hoffentlich)!\n" );
}

string toeten_func()
   {
     Kill(this_player());
     return "hat dich nun bemerkt und greift dich sofort an.";
   }

void mindblast(object enemy, int damage, mixed dam_type)
{

enemy->SetProp(P_DISABLE_ATTACK, 2 + random(2));
enemy->do_damage(50+random(20));

  tell_room(environment(enemy),
    "Ein maechtiger Gedankenangriff macht "+enemy->name(WEN,2)+
    " fuer kurze Zeit kampfunfaehig!\n", ({ enemy }) );
  tell_object(enemy,
    "Ein maechtiger Gedankenangriff macht dich fuer kurze Zeit kampfunfaehig!\n");
}
