/*        
**   Der Ulitharid 'Herek' (fragt im Master, ob er einen Spieler beherrschen darf.)
**
**   Zaknafein, Mai 2001
**
*/

#include "../files.h"

inherit STDNPC;

inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> 
#include <moving.h>
#include <new_skills.h>

string ULITHARID;

create()
{
  if (!is_clone(this_object())) return;

  ::create();       

  SetProp(P_SHORT, "Der Ulitharid Herek");
  SetProp(P_LONG, BKS("Ulithariden sind mit den gewoehnlichen Illithiden eng verwandt. Sie sind "
                      "jedoch wesentlich groesser und edler gekleidet. Ausserdem besitzen sie zwei "
                      "zusaetzliche Tentakel. Die Tentakel dienen dazu, die Koepfe ihrer Opfer "
                      "festzuhalten und durch die Nase ins Gehirn vorzudringen, um es auszusaugen. "
                      "Sie kaempfen hauptsaechlich mit der Kraft ihres Geistes, manchmal setzen sie "
                      "jedoch auch ihre gefaehrlich scharfen Krallen ein, mit denen sie ihren Gegnern "
		      "toedliche Wunden zufuegen koennen."));
  SetProp(P_INFO, BKS("Hereks telepathische Kraefte reichen sicherlich aus, um voellige Kontrolle "
                      "ueber Dich zu erlangen. Sei extrem vorsichtig, sonst endest Du bald als "
                      "willenloser Sklave in den Steinbruechen der Illithiden!"));
  SetProp(P_NAME, "Herek");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Illithid");
  create_default_npc(34);
  SetProp(P_ALIGN, -500); 
  SetProp(P_SIZE, 230);  
  SetProp(P_BODY, 400);
  SetProp(P_HANDS, ({" mit seinen telekinetischen Kraeften", 350, DT_MIND}) );
  SetProp(P_MAX_HANDS, 2);  
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.2, DT_COLD:      0.2, DT_WATER:   0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:   0.0, DT_LIGHT:  0.2,
      DT_ELECTRIC:  0.1, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -0.2,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  -0.5, DT_MIND: -0.5 ]) );
  SetProp(P_WIMPY, 0);
  SetProp(P_REJECT, ({REJECT_DROP, "Herek schaut Dich nur wuetend an!\n"}));  
  SetProp(P_AGGRESSIVE, 0.4);
  set_living_name("herek");
  AddId( ({"herek" , "NOWIMPY" , "illithid" ,"ulitharid" }) );

  seteuid(getuid(this_object()));
  clone_object(ARMOUR("uligewand"))->move(this_object());
//  clone_object(OBJ(""))->move(this_object());
  command("ziehe alles an");


  SetProp(P_SPELLRATE,50);
  SetProp(P_NOMAGIC, 40);

  AddSpell(2,500, 
	   "Eine maechtige Gedankenwelle erdrueckt dich fast!\n",
	   "@WER wird fast von einer maechtigen Gedankenwelle erdrueckt!\n",
           DT_TERROR,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,600,
	   "Der Illithid bohrt Dir seine Tentakeln in den Kopf.\n",
	   "Der Illithid bohrt @WEM seine Tentakeln in den Kopf.\n",
           DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1,"","",DT_TERROR,"beherrschungsspell");

  SetChats(3, ({
  "Der Illithid schwebt von der Decke herab.\n",
  "Der Illithid versteckt sich in den Stalagtiten.\n",
  "Herek baut eine telepathische Verbindung zu den anderen Illithiden auf.\n"
  }) );

  SetProp( P_DIE_MSG, " faellt tot zu Boden.\n" );
  SetProp(P_MURDER_MSG, "Die Rache wird mein sein!");
  SetProp(P_KILL_NAME, "Der Ulitharid Herek");
  SetProp(P_KILL_MSG, "Schade, du haettest einen guten Sklaven abgegeben!");
 
  SetProp(P_DEFAULT_INFO,"laesst die Worte 'Diene mir und schweige!' in Deinem Geiste entstehen.\n");

  AddInfo("zaknafein",
  "laesst die Worte 'Zaknafein ist mein Meister!' in Deinen Gedanken enstehen.\n");
 
}

void beherrschungsspell(object enemy, int damage, mixed dam_type) 
{
ULITHARID=this_object()->QueryProp(P_NAME);
 if (ILLMASTER->BehLog(ULITHARID , enemy->query_real_name())==1)
 {
   tell_object(enemy,BKS("In Deinen Gedanken formen sich die Worte 'Diene mir!!!' und ein "
                         "starkes Gluecksgefuehl ueberkommt Dich...\n"));
   say(ULITHARID+" versucht "+capitalize(enemy->Name())+" zu beherrschen.\n", ({ enemy }) );

   if((this_player()->QueryProp(P_ATTRIBUTES)[A_INT]) < random(50) )
             {
 
                say(ULITHARID+" beherrscht nun "+capitalize(enemy->Name())+".\n", ({ enemy }) );
                enemy->StopHuntFor(enemy,1);  
                enemy->move(ROOM("steinbruch"), M_GO, "", "wird von "+ULITHARID+" in den Steinbruch geschickt" , "kommt voellig apathisch herein und faengt an zu arbeiten");

	      write_file (LOG,
	      sprintf ("%s  %s wird von %s beherrscht.\n",
	      dtime(time()), capitalize(enemy->Name()), ULITHARID));
              
              if(find_player("zaknafein")) tell_object(find_player("zaknafein"), 
                               break_string(capitalize(enemy->Name())+" dient uns nun als Sklave, Meister!", 78, 
                                    ULITHARID+" teilt dir mit: "));


             }
              else
             {
                say(ULITHARID+" konnte "+capitalize(enemy->Name())+" nicht beherrschen.\n", ({ enemy }) );
             }
 }
 else
 {

   say(ULITHARID+" heilt einen Teil seiner Wunden!\n"); 
   heal_self(random(150));
 }

}
