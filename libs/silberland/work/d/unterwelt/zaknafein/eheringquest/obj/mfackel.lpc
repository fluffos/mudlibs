#include "../def.h"
#include <lightsource.h>

inherit "/std/lightsource";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT,"Eine Magnesiumfackel");
  SetProp(P_LONG,"Eine Fackel, die als Brennstoff Magnesium verwendet. "
                 "Sie wird wohl auch unter Wasser brennen."
  );

  AddId( ({ "fackel" , "magnesiumfackel" , "\nwasserfest" }) );
  SetProp(P_NAME,"Magnesiumfackel");
  SetProp(P_GENDER,FEMALE);

  SetProp(P_VALUE, 100);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_MATERIAL, ([MAT_MAGNESIUM:60, MAT_MISC_WOOD:40]));
  SetProp(P_ARTICLE, 1);
  SetProp(P_FUEL, 2000);

  SetProp(P_LIGHTDESC,
    ({"glimmend"
     ,"flackernd"
     ,"leicht flackernd"
     ,"brennend"
     ,"hell lodernd"
     ,"frisch angezuendet"
     })
  );
}

