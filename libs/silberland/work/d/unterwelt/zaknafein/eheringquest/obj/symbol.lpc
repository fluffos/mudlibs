#include "../def.h"

inherit "std/thing";

void create()
{
  if(!is_clone(this_object())) return;

 ::create();

  SetProp(P_SHORT, "Ein kleines Steinsymbol");
  SetProp(P_LONG,
    "            _                \n"
    "         __| |__             \n"
    "       _|       |_           \n"
    "      |_   -|-   _|          \n"
    "        |__   __|            \n"
    "           |_|               \n"
  );

  SetProp(P_NAME, "Steinsymbol");
  SetProp(P_GENDER, NEUTER);

  AddId( ({ MAINID, "\nzaksymbol" , "steinsymbol" , "symbol" }) );

  SetProp(P_NAME_ADJ, ({"klein"}) );
  AddAdjective( ({"kleinen","kleiner","kleinem","kleines","kleine"}) );

  SetProp(P_NODROP, "Du brauchst das Symbol bestimmt noch.\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MATERIAL, MAT_MISC_STONE);
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 10);
}
