#include "../def.h"

inherit "/std/thing";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT,"Die Leiche eines Schluesseltiers");
  SetProp(P_LONG,
    "In Deinen blutigen Haenden haeltst Du die Ueberreste des armen "
    "Schluesseltiers."
  );

  SetProp(P_INFO, BS("Falls Du dieses Objekt nicht mehr brauchst, kann "
                     "Xatana Dir bestimmt helfen. Frage sie einfach mal "
                     "nach 'zerstoeren'."));

  SetProp(P_NAME,"Leiche");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 100);
  SetProp(P_MATERIAL, MAT_HORN);
  SetProp(P_NODROP, "Nein, die Leiche brauchst Du vielleicht noch.\n");

  AddId( ({ MAINID , "leiche" , "schluesseltier" , "\nzakleiche" }) );
  AddCmd(
    "iss|ess|esse&leiche|tier|schluesseltier",
    "cmd_essen",
    "Was moechtest Du essen?\n"
  );
}

int cmd_essen(string str)
{
  tell_object(TP, BS("Die Leiche besteht zu 99.9 % aus Horn. Nicht sehr "
                     "angenehm zu kauen und vielleicht brauchst Du sie "
                     "ja noch."));
  return 1;
}

string QueryDoorKey()
{
  return ID_HORNSCHLUESSEL;
}
