#include "../def.h"

inherit "/std/thing";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT,"Ein Drachenbildchen");
  SetProp(P_LONG,
    "\n"
    "                    \\||/               \n"
    "                    |  @___oo           \n"
    "          /\\  /\\   / (__,,,,|         \n"
    "         ) /^\\) ^\\/  )                \n"
    "         )   /^\\/   _)                 \n"
    "         )   _ /  / _)                  \n"
    "     /\\  )/\\/ ||  | )_)               \n"
    "    <  >      |(,,) )__)                \n"
    "     ||      /    \\)___)\\             \n"
    "     | \\____(      )___) )___          \n"
    "      \\______(_______;;; __;;;         \n"
    "                                        \n"
    "         Gruesse von Zak!               \n"
    "\n"

);

  AddId( ({ MAINID, "bildchen" , "drachenbildchen" , "\nzakbildchen" }) );

  SetProp(P_NAME, "Drachenbildchen");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 0);
  SetProp(P_MATERIAL, ([MAT_PAPER: 100]) );
  SetProp(P_VALUE, 0);

  AddCmd(
    "zerreiss|zerreisse&bildchen|drachenbildchen",
    "cmd_zerreissen",
    "Was moechtest Du zerreissen?\n"
  );
}

int cmd_zerreissen(string str)
{
  int i;

  i = random(341)+241;

  tell_object(TP, "Du zerreisst Dein Drachenbildchen in "+i+" kleine "
                  "Fetzen!\n");

  tell_room(ENV(TP), BS(CTPN+" zerreisst ein Stueck Papier in "+i+
                        " kleine Fetzen!"), ({TP}) );

  remove();
  return 1;
}

