#include "../def.h"

inherit "/std/thing";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein alter Eisenschluessel");
  SetProp(P_LONG,
    "Ein alter Eisenschluessel."
  );

  SetProp(P_NAME,"Eisenschluessel");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 0);

  SetProp(P_MATERIAL, MAT_IRON);

  AddId( ({ MAINID, "schluessel" , "eisenschluessel" }) );
}

string QueryDoorKey()
{
  return ID_EISENSCHLUESSEL;
}

