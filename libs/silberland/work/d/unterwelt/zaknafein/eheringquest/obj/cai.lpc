#include "../def.h"

#include <food.h>

inherit "std/food";

void create()
{
  if(!is_clone(this_object())) return;

  ::create( ({ "trink", "trinke" }) );

  SetProp(P_SHORT, "Ein Caipirinha");
  SetProp(P_LONG,
    "Du erblickst ein laengliches Glas, in dem sich eine klare Fluessigkeit "
    "befindet. In der Fluessigkeit schwimmen geachtelte Limetten und "
    "gestossenes Eis. An dem Glas ist ein kleiner Zettel angebracht."
  );

  SetProp(P_NAME, "Caipirinha");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);

  AddId(({ "drink", "caipirinha" , "cocktail" }));

  AddDetail( ({ "zettel" , "Zettel" }) ,
    "Du kannst ihn lesen."
  );

  AddReadDetail( ({ "zettel" , "Zettel" }) ,
    "Zutaten:\n"
    "\n"
    "1 unbehandelte Limette\n"
    "1-2 Barloeffel brauner Zucker\n"
    "4 cl Cachaca\n"
    "gestossenes Eis\n"
    "\n");

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 50);

  SetProp(P_MATERIAL, ([MAT_FRUIT:20, MAT_ICE:20, MAT_WATER:40, P_ALCOHOL:20]));

  SetProp(P_FOOD_INFO, ([F_HEAL : ({50, 30}), F_DRINK : 2, F_ALCOHOL : 20,
                       F_VERB : "trinken",
                       F_MSG:"Mit grossem Genuss trinkst Du den Caipirinha.\n",
                       F_MSG_ROOM:"geniesst einen leckeren Cocktail.\n" ]));
}

