#include "../def.h"

inherit ROOM "std_gruft";

void create()
{
  ::create();

  long1 = "Nun stehst Du in Xatanas geheimer Familiengruft. ";
  long2 = "Direkt vor Dir steht schon der erste Sarg. Wer wohl in ihm "
          "liegt? Naja, ob Du es ueberhaupt so genau wissen willst? Am "
          "Boden faellt Dir jedenfalls sofort eine Erhebung auf. ";

  AddDetail( ({ "Boden" , "boden" }) ,
    "Der Boden besteht aus grauem Granit. In einer Ecke erkennst Du eine "
    "Erhebung."
  );

  AddDetail( ({ "ecke" , "Ecke" }) ,
    "Dort erkennst Du eine Erhebung."
  );

  AddDetail( ({ "erhebung" , "Erhebung" }) ,
    "Es ist eine kreisrunde Erhebung. Du erkennst eine Zeichnung."
  );

  AddDetail( ({ "zeichnung" , "Zeichnung" }) ,
    "Die Zeichnung zeigt eine Nische mit einem Sockel."
  );

  AddDetail( ({ "nische" , "sockel" }) ,
    "Kommt Dir bekannt vor..."
  );

  AddDetail( ({ "sarg" , "saerge" }) ,
    "Der Sarg wurde aus weissem Marmor gefertigt. Zwischen den zahlreichen "
    "Verzierungen erkennst Du eine kleine Steinplatte."
  );

  AddDetail( ({ "platte" , "steinplatte" }) ,
    "               _____\n"
    "              |     |\n"
    "              |     |\n"
    "       _______|     |_______\n"
    "      |                     |\n"
    "      |  Albert Dunkelstein |\n"
    "      |_______       _______|\n"
    "              |     |\n"
    "              |     |\n"
    "              |     |\n"
    "              |     |\n"
    "              |     |\n"
    "              |     |\n"
    "              |_____|\n"
  );

  AddDetail( ({"dunkelstein","albert","albert dunkelstein"}) ,
    "Wie kann man nur so heissen..."
  );

  AddExit("norden" , ROOM "gruft2");
  AddExit("westen" , ROOM "gruft4");

  AddCmd( ({ "betrete" ,  "betritt" , "klettere" , "stell" , "steig" , "steige" , "stelle" , "kletter" }) , "cmd_steigen" );
}

int cmd_steigen(string str)
{
  notify_fail( "Worauf moechtes Du Dich stellen?\n");

  if(!str || str == "") return 0;
  if(!(str == "auf erhebung"  ||
       str == "erhebung"      ||
       str == "auf zeichnung" ||
       str == "auf sockel"    )) return 0;

  tell_object(TP, "Alles dreht sich und ploetzlich...\n");
  TP->move( ROOM "halle" , M_TPORT , "ploetzlich"
                                   , "verschwindet"
                                   , "erscheint aus dem Nichts");
  return 1;
}

