#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Keiderschrank" );
  SetProp(P_INT_LONG,
   "Du stehst nun in einem Kleiderschrank. Nur recht wenige Kleidungsstuecke "
   "haengen hier.");

  SetProp(P_LIGHT, -20);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "kleidungsstuecke" , "kleidung", "stuecke" }) ,
   "Die interessieren jetzt nicht.");
  AddDetail( ({"decke","boden","wand","waende"}) ,
   "Die Decke, der Boden und die Waende bestehen aus Holz.");
  AddDetail( "holz" ,
   "Hartes, schwarzes Holz.");
  AddDetail( ({ "schrank", "kleiderschrank" }) ,
   "Du wolltest schon immer gerne mal wissen, wie es in den Schraenken anderer Leute aussieht.");
  AddDetail( "leute" ,
   "Leute halt ...");
  AddDetail( "sinne" ,
   "Gehe im Geist mal alle Sinne durch und ueberlege, welcher hier helfen koennte.");
  AddDetail( "geist" ,
   "Ein Geist? Wo?");


  AddSmell( ({DEFAULT_SMELL}) ,
    "Es riecht hier stark nach Mottenkugeln.");
  AddSmell( ({ "kugel" , "kugeln" , "mottenkugeln" , "mottenkugel" }) ,
    "Hm, es sind wirklich Mottenkugeln. Vielleicht kann man sie "
    "ertasten?");

  AddSound( ({DEFAULT_SOUND}) ,
    "Stille. Vielleicht solltest Du Deine anderen Sinne verwenden...");

  AddCmd( ({ "taste" , "ertaste" , "ertast", "tast", "betast", "betaste"}) ,
    "cmd_tasten" );

  AddCmd( ({"yilrah"}) , "yilrah" );

  AddCmd(
    "sag|sage&yilrah",
    "cmd_sagen",
    ""
  );

  NewDoor("raus", ROOM "start" , ({"tuer","schranktuer"}) ,
    ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME,  "Schranktuer"
     ,D_GENDER, FEMALE
     ,D_SHORT, "Eine %se Schranktuer."
     ,D_LONG, "Eine einfache Tuer aus schwarzem Holz.\n"
     ,D_MSGS,    ({"aus dem Schrank","kriecht","kommt aus den Schrank gekrochen"})
     ,D_OPENMSG, ({"Du oeffnest die Schranktuer.",
                   "%s oeffnet die Schranktuer.",
                   " schliesst sich."})
     ,D_CLOSEMSG, ({"Du schliesst die Schranktuer.",
                    "%s schliesst die Schranktuer.",
                    " wird von der anderen Seite geschlossen."})
     ,D_RESET_CLOSEMSG, " faellt ins Schloss."
     })
  );

}

int cmd_tasten(string str)
{
  string s;

  notify_fail( "Was moechtest Du ertasten?\n");

  if(!str || str == "") return 0;

  switch(str)
  {
    case "kugeln":
    case "mottenkugeln":
    case "kugel":
    case "mottenkugel":
      s = "Als Du versuchst, die Mottenkugeln zu ertasten, stossen Deine "
          "Haende auf Waende.";
      break;

    case "waende":
    case "seiten":
    case "wand":
      s = "Waehrend Du mit Deiner Hand ueber die Oberflaeche, die sich wie "
          "Holz anfuehlt, gleitest, ertastest Du eine kleine Ritze.";
      break;

    case "ritze":
      s = "Du faehrst mit Deinen Fingern die Ritze entlang. Es kommt Dir "
          "vor, als waere dort eine Tuer.";
      break;

    case "decke":
    case "boden":
      s = "Decke und Boden sind vorhanden...";
      break;

    case "tuer":
    case "schranktuer":
      if(DOOR_MASTER->QueryDoorStatus(ROOM "start") == D_STATUS_CLOSED)
      {
        s= "Ja, es scheint tatsaechlich eine Tuer zu sein. Vielleicht kann "
           "man sie oeffnen.";
      }
      else
      {
        s = "Die Tuer ist offen. Mit 'raus' kannst Du den Raum verlassen.";
      }
      break;
  }

  if(!s) return 0;

  tell_object(TP, BS(s));
  return 1;
}

int yilrah(string str)
{
  if(EMASTER->QueryYilrah(TPUUID) || TP->QueryQuest(EHERINGQUEST))
  {
    tell_object(TP, "Du verlierst die Orientierung...\n");
    EMASTER->Msg(TPUID+" teleportiert sich in die Kloake!");
    TP->move(ROOM "kloake1", M_TPORT , "sich vor Deinen Augen"
                                     , "dematerialisiert"
                                     , "materialisiert sich vor Deinen "
                                       "Augen in der Nische");
    return 1;
  }

  tell_object(TP, "Hm, warum geht das nicht?\n");
  return -1;
}

int cmd_sagen(string str)
{
  return yilrah("");
}

