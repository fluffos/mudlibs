#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Kloake unterhalb von Xatanas Wohnung" );

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "wohnung" , "xatanas" , "kloake" }),
    "Du muesstest Dich irgendwo unterhalb von Xatanas Wohnung befinden.");

  AddDetail( ({ "xatana" }) ,
    "YES! Wegen der bist Du als hilfsbereiter Quester hier. (und wegen "
    "der Punkte...)" );

  AddDetail( ({ "quester" , "punkte" }) ,
    "Hechel, Punkte sammeln, aufsteigen..." );

  AddDetail( ({ "decke" }) ,
    "Die Decke haengt sehr niedrig. Sie besteht ebenfalls aus Stein." );

  AddDetail( ({ "gestein" , "stein" , "felsgestein" }) ,
    "Harter, schwarzer Stein." );

  AddSmell( ({DEFAULT_SMELL}) ,
    "Iiiiieh! Ein bestialischer Gestank! Du haelst Dir besser die Nase "
    "zu...");

  AddSmell( ({"gestank"}) ,
    "So genau moechtest Du es gar nicht wissen.");

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist es, den Ring zu finden.\n");
  return 0;
}


