#include "../def.h"
#include "/d/wasser/cirion/water.h"

inherit ROOM "std_unterwasser";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du bist nun in einen anderen Abschnitt der gefluteten´Roehre "
    "geschwommen. Auch hier ist es recht eng, so dass Du Dich gerade noch "
    "bewegen kannst. Am Boden hat sich eine dicke Schlammschicht "
    "angesammelt."
  );

  AddCmd( ({ "tauch" , "tauche" }) , "cmd_tauchen");

  AddWaterExit("westen",    ROOM "uwroom5");
  AddWaterExit("nordosten", ROOM "uwroom2");
}

