#include "../def.h"

inherit ROOM "std_gang";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst in einem dunklen Gang irgendwo unterhalb Xatanas Hoehle. "
    "Im Suedwesten faellt Dir sofort ein blaeuliches Schimmern auf. Auch "
    "hier ist der Boden mit einer dicken Staubschicht bedeckt."
  );

  AddDetail( ({"barriere"}) ,
    "Du denkst Dir, dass Du die Barriere wohl irgendwie ueberwinden musst."
  );

  AddDetail( ({ "sw" , "suedwesten" }) ,
    "Dort liegt ein Gang, der nach Suedwesten fuehrt."
  );

  AddDetail( ({ "schimmern" , "schimmer" }) ,
    "Ein blaeuliches Schimmern huellt den gesamten Gang, der nach "
    "Suedwesten fuehrt, ein."
  );

  AddDetail( ({"gang"}) ,
    "Er scheint durch eine magische Barriere blockiert zu sein."
  );

  AddDetail( ({ "xatanas" , "xatana" , "hoehle" }) ,
    "In Xatanas Hoehle fing alles an..."
  );


  AddDetail( ({ "staub" , "staubschicht" , "schicht" }) ,
    "Die Staubschicht ist recht dick. Du glaubst hier Spuren zu erkennen."
  );

  AddDetail( ({ "spur" , "spuren" }) ,
    "Es sind tatsaechlich Spuren. Sie sind nur recht undeutlich. "
    "Wahrscheinlich stammen sie von einem sehr leichten Wesen."
  );

  AddDetail( ({"wesen"}) ,
    "Das Wesen muss wohl recht leicht und flink sein."
  );

  AddExit("westen"    , ROOM "gang18");
  AddExit("osten"     , ROOM "gang79");
  AddExit("nordosten" , ROOM "gang75");

  AddSpecialExit("suedwesten" , "exit_sw" );
}

int exit_sw()
{
  object ob;

  if(!TP) return 1;
  if(!interactive(TP)) return 1;

  ob=present("\nzakhelm", TP);

//DBR(sprintf("%O", ob));

  if(ob)
  {
    if(ob->QueryProp(P_WORN)==TP)
    {
       tell_object(TP, "Du durchschreitest die magische Barriere.\n");
       TP->move(ROOM "gang77", M_GO, "nach Suedwesten"
                                   , "geht"
                                   , "schleicht herein");
       return 1;
     }
  }

  tell_object(TP, "Eine magische Barriere haelt Dich zurueck.\n");
  return 1;
}
