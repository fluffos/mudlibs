#include "../def.h"

inherit ROOM "std_gang";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst in einem schmalen, dunklen Gang irgendwo unterhalb Xatanas "
    "Hoehle. Hier haengt die Decke recht niedrig und der Boden ist mit "
    "einer dicken Staubschicht bedeckt. Na, hoffentlich wirst Du Dich "
    "nicht verlaufen. Vielleicht solltest Du Dir lieber eine Karte machen. "
  );

  AddDetail( ({"karte"}) ,
    "Waere wohl besser, wenn Du Dir eine Karte machtest."
  );

  AddDetail( ({ "horn" , "Horn" }) ,
    "Ja, es scheint Horn zu sein."
  );

  AddDetail( ({ "xatanas" , "hoehle" }) ,
    "In Xatanas Hoehle fing alles an."
  );

  AddDetail( ({ "staub" , "staubschicht" , "schicht" }) ,
    "Du erkennst hier Spuren."
  );

  AddDetail( ({ "spur" , "spuren" }) ,
    "Sie scheinen von einem recht leichten Wesen zu stammen, da sie nur "
    "undeutlich sind."
  );

  AddDetail( ({"wesen"}) ,
    "Du fragst Dich, welches Wesen diese Spuren wohl hinterlassen "
    "haben mag."
  );

  AddExit("nordosten" , ROOM "gang12");

  NewDoor("westen", ROOM "kloake2", ({ "tuer" , "horntuer" }),
    ({D_FLAGS, DOOR_NEEDKEY|DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME, "Horntuer"
     ,D_GENDER, FEMALE
     ,D_SHORT, "Im Westen siehst Du eine %se Horntuer."
     ,D_LONG,  "Hm, sie besteht tatsaechlich aus Horn. Seltsam...\n"
     ,D_FUNC, "auto_close"
     ,D_MSGS, ({"durch die Horntuer"
               ,"geht"
               ,"kommt durch die Horntuer herein"
               })
     ,D_OPENMSG, ({"Du oeffnest die Horntuer.",
                   "%s oeffnet die Horntuer.",
                   " schliesst sich."})
     ,D_CLOSEMSG, ({"Du schliesst die Horntuer.",
                    "%s schliesst die Horntuer.",
                    " wird von der anderen Seite geschlossen."})
     ,D_RESET_CLOSEMSG, " faellt zu."
     })
  );
}

void auto_close()
{
  tell_object(TP, "Die Tuer faellt hinter Dir ins Schloss.\n");
  DOOR_MASTER->SetDoorStatus(ROOM "kloake2", D_STATUS_LOCKED);
}

