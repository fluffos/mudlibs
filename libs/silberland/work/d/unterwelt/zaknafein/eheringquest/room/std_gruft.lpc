#include "../def.h"

inherit "std/room";

string long1;
string long2;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Gruft" );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "familiengruft", "gruft" }) ,
    "Hier liegen wohl die Gebeine Xatanas Vorfahren."
  );

  AddDetail( ({ "gebeine" }) ,
    "Die liegen wohl in den Saergen."
  );

  AddDetail( ({"vorfahren"}) ,
    "Hm, kannst ja mal nachschauen, wenn Du so neugierig bist..."
  );

  AddDetail( ({ "wand" , "waende" }) ,
    "Hinter den vielen Spinnweben kannst Du tatsechlich eine Wand aus "
    "grauem Granit erkennen."
  );

  AddDetail( ({ "boden" }) ,
    "Der Boden besteht aus grauem Granit. "
  );

  AddDetail( ({ "decke" }) ,
    "Die Decke verschwindet ueber Dir in der Dunkelheit."
  );

  AddDetail( ({ "granitgestein" , "stein" , "gestein" , "granit" , "Granit" }) ,
    "Glaenzendes, graues Granitgestein glitzert Dir gruselig entgegen. "
  );

  AddDetail( ({"xatana"}) ,
    "So, hier liegen also ihre Vorfahren begraben."
  );

  AddDetail( ({ "Spinnweben" , "spinnweben" }) ,
    "Passe ja auf, dass Du Dich nicht in ihnen verfaengst...\n"
  );

  AddDetail( ({ "spinnen" , "spinne" }) ,
    "In den Spinnweben haengen fette, schwarze Spinnen, die dort auf ihre "
    "Opfer warten."
  );

  AddDetail( ({ "elfenknochen" , "paladinknochen" , "knochen" }) ,
    "Wieviel Paladine oder Elfen mussten dafuer wohl sterben?"
  );

  AddDetail( ({ "paladine" , "elfen" }) ,
    "Du siehst nur noch ihre Knochen."
  );

  AddDetail( ({ "verzierungen" }) ,
    "Die Verzierungen wurden aus einem weissen Material geschnitzt."
  );

  AddDetail( ({ "material" }) ,
    "Als Du naeher hinschaust, faellt Dir auf, dass es sich bei dem "
    "Material um Knochen handelt."
  );

  AddDetail( ({ "marmor" , "Marmor" }) ,
    "Weisser, teurer Marmor."
  );

  AddDetail( ({"dunkelheit"}) ,
    "Hm, die Decke muss recht hoch sein, wenn man sie nicht erkennen kann.");

  AddDetail( ({"raum"}) ,
    "Du befindest Dich in der Familiengruft von Xatana."
  );

  AddSmell( DEFAULT_SMELL , "Es riecht hier sehr muffig und staubig.\n");

  AddSound( DEFAULT_SOUND , "Es ist absolut still.\n");

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist es, den Ring zu finden.\n");
  return 0;
}

string _query_int_long()
{
  string s;

  s  = long1;
  s += "Es sieht hier recht duester und unheimlich aus. Der ganze Raum ist "
       "von dicken Spinnweben durchzogen, in denen dicke Spinnen auf ihre "
       "Opfer warten. ";
  s += long2;

  return BS(s);
}
