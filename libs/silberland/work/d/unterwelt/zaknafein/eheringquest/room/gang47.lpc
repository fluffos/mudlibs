#include "../def.h"

inherit ROOM "std_gang";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Ende eines dunklen Ganges" );
  SetProp(P_INT_LONG,
    "Hier endet der Gang abrupt in einer Sackgasse. Du kannst hier kaum "
    "noch gerade stehen, so eng ist es hier geworden. Die Luft ist hier "
    "so stickig, dass Du kaum frei atmen kannst."
  );

  AddDetail( ({ "luft" }),
    "Die Luft ist zwar stickig, aber deshalb kannst Du sie noch lange "
    "nicht sehen.");

  AddDetail( ({ "gasse" , "sackgasse" }) ,
    "Du kannst nur noch zurueckgehen, falls Dir kein Ungeheuer den "
    "Rueckweg abgeschnitten hat... "
  );

  AddDetail( ({"sack"}) ,
    "Wer ist hier der Sack? *g*"
  );

  AddDetail( ({"ungeheuer"}) ,
    "Hoffentlich lauert Dir kein blutruenstiges Ungeheuer auf."
  );

  AddDetail( ({ "weg" , "rueckweg" }) ,
    "Er scheint frei zu sein."
  );

  AddDetail( ({"gang", "gaenge"}) ,
    "Der Gang endet hier."
  );

  AddSmell( ({DEFAULT_SMELL}) ,
    "Es riecht hier recht muffig."
  );

  AddSmell( ({"luft"}) ,
    "Die Luft ist hier ziemlich stickig."
  );

  AddExit("sueden" , ROOM "gang46");
}



