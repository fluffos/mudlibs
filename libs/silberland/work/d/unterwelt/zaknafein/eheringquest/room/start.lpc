#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In Xatanas Hoehle" );
  SetProp(P_INT_LONG,
    "Du befindest Dich in Xatanas Hoehle, die sich am Rande des Wohn"
    "gebietes von Dhrkion befindet. Wie Du es schon erwartet hast, ist es "
    "hier sehr dunkel und kuehl. An der Ostwand steht ein grosser Schreib"
    "tisch, ueber dem ein Regal angebracht ist. Gegenueber steht ein "
    "grosser, schwarzer Schrank. Natuerlich hat Xatana auch ein Bett. Es "
    "steht an der Suedwand. Dort siehst Du ein grosses Gemaelde."
  );

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( "xatana" ,
    "Xatana wohnt in dieser Hoehle.");
  AddDetail( "zaknafein" ,
    "Zaknafein wohnt zusammen mit Xatana in dieser Hoehle.");
  AddDetail( ({ "rand" , "rande" }) ,
    "Genauer gesagt, befindet sich die Hoehle im Suedosten des Wohngebietes "
    "von Dhrkion.");
  AddDetail( "silberland" ,
    "Wir alle leben im Silberland.");
  AddDetail( "hoehle" ,
    "Dunkelelfen pflegen in Hoehlen zu wohnen.");
  AddDetail( ({ "stadt" , "dhrkion"}) ,
    "Dhrkion ist die Heimatstadt der Dunkelelfen.");
  AddDetail( ({ "wohngebiet" }),
    "Hier wohnen die Dunkelelfen von Dhrkion.");
  AddDetail( "heimatstadt" ,
    "Hierher kommt Zaknafein, wenn er Heimweh hat...");
  AddDetail( "heimweh" ,
    "Dhrkion ist wirklich eine schoene Stadt. *schwaerm*");
  AddDetail( ({ "gemaelde", "bild" }),
    "Das Gemaelde zeigt eine Dunkelelfenpriesterin, die auf der Jagd nach "
    "Elfen ihre Peitsche schwingt.");
  AddDetail( ({ "dunkelelfenpriesterin", "priesterin" }),
    "Die Priesterin ist das geistige Oberhaupt der Dunkelelfen. Sie traegt "
    "eine schwarze Robe. Dir fallen sofort ihre weissen Haare und ihre "
    "spitzen Ohren auf. In ihrer Hand haelt sie eine Peitsche.");
  AddDetail( "oberhaupt" ,
    "Sie steht direkt im Dienste Lloths.");
  AddDetail( "dunkelelfen" ,
    "Dunkelelfen sind boesartig und gemein.");
  AddDetail( ({ "schlangenpeitsche" , "peitsche" }),
    "Es handelt sich um eine neunkoepfige Schlangenpeitsche.");
  AddDetail( ({ "haar" , "haare" }),
    "Dunkelelfen haben zumeist solche weissen Haare.");
  AddDetail( ({ "ohr" , "ohren" }) ,
    "Dunkelelfen haben spitze Ohren, wie Elfen auch.");
  AddDetail( "robe" ,
    "Dunkelelfen nennen diese Robe 'Piwafwi'.");
  AddDetail( "hand" ,
    "In ihrer dunkelhaeutigen Hand haelt sie eine Schlangenpeitsche.");
  AddDetail( ({ "umhang" , "schutzumhang" , "piwafwi" }),
    "Der Piwafwi ist ein magischer Schutzumhang.");
  AddDetail( "dienste" ,
    "Sie untersteht nur Lloth alleine.");
  AddDetail( ({ "lloths" , "lloth" }) ,
    "Lloth ist die Goettin der Dunkelelfen.");
  AddDetail( "goettin" ,
    "Das heilige Symbol Lloths ist die Spinne.");
  AddDetail( ({ "spinnen" , "spinne" , "symbol" }) ,
    "Weil die Spinne ein heiliges Symbol ist, toete keine Spinnen und iss "
    "kein Spinnenragout.");
  AddDetail( ({ "ragout" , "spinnenragout" }),
    "Plexu bietet welches an.");
  AddDetail( "plexu" ,
    "Plexu ist der Wirt der Kneipe in Dhrkion.");
  AddDetail( "wirt" ,
    "Wer nix wird, wird Wirt.");
  AddDetail( "kneipe" ,
    "Dort kann man fein 'tanken'.");
  AddDetail( "elfen" ,
    "Lloth gebietet den Dunkelelfen, ihr Elfen zu opfern.");
  AddDetail( "jagd" ,
    "Die Priesterin scheint nicht sonderlich zimperlich mit den Elfen "
    "umzugehen.");
  AddDetail( "chaos" ,
    "Zettel, Buecher und Schreibfedern liegen wild zerstreut auf dem Tisch.");
  AddDetail( ({ "feder" , "schreibfeder" , "schreibfedern" , "federn" }) ,
    "Es handelt sich um sehr edle Schreibfedern.");
  AddDetail( "zettel" ,
    "Viele der Zettel wurden mit raetselhaften Formeln beschrieben. Es "
    "lohnt sich wohl nicht, sie naeher zu untersuchen. Du verstaendest "
    "sie wohl nicht.");
  AddDetail( "regal" ,
    "Die schwarzen Regalbretter beugen sich unter der schweren Last der "
    "Buecher, die auf ihnen stehen.");
  AddDetail( ({ "buch" , "buecher" }) ,
    "Die Buecher erscheinen Dir geheimnisvoll und fremdartig.");
  AddDetail( ({ "formel" , "formeln"}) ,
    "Du verstehst sie wirklich nicht.");
  AddDetail( ({ "bretter" , "regalbretter" }) ,
    "Die Regalbretter bestehen wie der Schreibtisch aus hartem, tief"
    "schwarzem Holz.");
  AddDetail( "last" ,
    "Die vielen Buecher wiegen wohl so einiges. Hoffentlich bricht das "
    "Regal nicht.");
  AddDetail( "holz" ,
    "Es handelt sich um sehr hartes, tiefschwarzes Holz.");
  AddDetail( "boden" ,
    "Fast der gesamte Boden wird von einem grossen Teppich bedeckt.");
  AddDetail( ({ "waende" , "wand" }) ,
    "Die Waende bestehen aus schwarzem Stein.");
  AddDetail( "decke" ,
    "Die Decke besteht wie der Boden und die Waende aus schwarzem Stein.");
  AddDetail( "stein" ,
    "Es handelt sich um schwarzen, sehr harten Stein, der alles Licht "
    "verschluckt.");
  AddDetail( "teppich" ,
    "Der Teppich besteht aus schwarzem Stoff.");
  AddDetail( "stoff" ,
    "Hm, alles ist hier schwarz.");
  AddDetail( "licht" ,
    "Dunkelelfen hassen das Licht.");
  AddDetail( "ostwand" ,
    "An der Ostwand erkennst Du einen grossen Schreibtisch, ueber dem "
    "ein Regal angebracht ist.");
  AddDetail( "suedwand" ,
    "Vor der Suedwand steht ein grosses Bett, ueber dem ein Gemaelde "
    "haengt.");
  AddDetail( "westwand" ,
    "Vor der Westwand steht ein grosser Schrank, neben dem sich eine "
    "Nische befindet.");
  AddDetail( ({ "Nische", "nische" }),
    "Dort befindet sich die Toilette von Xatana und Zaknafein. Toiletten "
    "sind recht selten im Silberland! Sie muss wohl eine besondere "
    "Bedeutung haben...");
  AddDetail( ({ "klo" , "toilette" }),
    "Wow, eine Toilette aus schwarzem Marmor! Sie besitzt, wie es sich "
    "fuer eine vernuenftige Toilette gehoert, ein Abflussrohr und eine "
    "Kette, mit der man die Spuelung bedienen kann. Auf der Toilette steht "
    "eine Rolle Toilettenpapier.");
  AddDetail( ({ "papier", "toilettenpapier" , "rolle" }),
    "Das Toilettenpapier ist mit lustigen Motiven bemalt worden.");
  AddDetail( ({ "motiv", "motive" }),
    "Es sind Froesche! Wie kitschig!");
  AddDetail( ({ "frosch", "froesche" }),
    "Quaaaaaak!");
  AddDetail( ({ "Schrank", "schrank" }),
    "Du siehst einen grossen Schrank aus dunklem Holz. Schnitzereien "
    "verzieren ihn. Ein grosser Spiegel haengt an der Tuer. Links vom "
    "Schrank befindet sich eine dunkle Nische.");
  AddDetail( ({ "schnitzerei" , "schnitzereien" }) ,
    "Die Schnitzereien sehen recht huebsch aus.");
  AddDetail( ({ "abflussrohr", "rohr" }),
    "Das Abflussrohr fuehrt in unergruendliche Tiefen...");
  AddDetail( ({ "tiefen", "tiefe" }),
    "Vielleicht sind sie ja gar nicht so unergruendlich...");
  AddDetail( ({ "Kette", "kette" }),
    "Es ist eine einfache Kette aus Metall. Sie haengt von der Decke "
    "herab. Ihr Ende haengt in der Toilette...");
  AddDetail( "metall" ,
    "Es ist wohl Eisen.");
  AddDetail( "eisen" ,
    "Ja, es sieht so aus, als waere es Eisen.");
  AddDetail( ({ "ende", "Ende" }),
    "Ja, das Ende haengt in der Toilette. Ist wohl versehentlich passiert...");
  AddDetail( ({ "Bedeutung", "bedeutung" }),
    "Welche, musst Du ja gerade herausfinden...");
  AddDetail( ({ "bett", "Bett" }),
    "Ein grosses Bett - ideal fuer zwei Personen *g* - mit Bettwaesche aus "
    "Seide.");
  AddDetail( ({ "person" , "personen" }) ,
    "Eine maennliche und eine weibliche Person, schlage ich da vor...");
  AddDetail( ({ "Seide", "seide" }),
    "Ja, Seide! Du kannst es kaum glauben. Am liebsten moechtest Du Dich "
    "reinkuscheln, aber Xatana hat bestimmt was dagegen.");
  AddDetail( ({ "schreibtisch", "tisch" , "Tisch" , "Schreibtisch" }),
    "Auf dem Schreibtisch herrscht absolutes Chaos! Verstreut liegen "
    "Zettel, Buecher und Schreibfedern. Er besteht aus hartem, tief"
    "schwarzem Holz. Ueber dem Schreibtisch ist ein Regal angebracht.");
  AddDetail( ({ "bettwaesche" , "waesche" }),
    "Bettwaesche aus Seide... *schwaerm*");
  AddDetail( ({ "Spuelung" , "spuelung" }),
    "Man bedient sie mit der Kette.");
  AddDetail( ({ "marmor" , "Marmor" }),
    "Wow, sehr edler Marmor !!!");
  AddDetail( "spiegel" ,
    "Du kannst ja mal in den Spiegel schauen.");
  AddDetail( "kopf" , "Wie bist Du nur darauf gekommen?");

  AddSmell( DEFAULT_SMELL ,
    "Es riecht hier eigentlich ganz angenehm.");
  AddSmell( ({ "klo" , "toilette" }) ,
    "Du steckst Deinen Kopf in die Toilette und atmest kraeftig ein. "
    "Hmmm, das tat gut! Xatana schaut Dich aber etwas irritiert an...");

  AddSound( DEFAULT_SOUND ,
    "Bis auf Xatana hoerst Du hier nichts.");

  AddItem(NPC "xatana", REFRESH_REMOVE);

  AddCmd(
    "springe|spring|huepf|huepfe&toilette|klo",
    "cmd_huepfen",
    "Wohinein moechtest Du huepfen?\n"
  );

  AddCmd(
    "steig|steige|kletter|klettere&toilette|klo",
    "cmd_steigen",
    "Wohin moechtest Du klettern?\n"
  );

  AddCmd(
    "ziehe|zieh&kette",
    "cmd_ziehen",
    "Woran moechtest Du ziehen?\n"
  );

  AddCmd(
    "benutz|benutze&toilette|klo|wc",
    "cmd_benutzen",
    "Was moechtest Du benutzen?\n"
  );

  AddCmd(
    "steck|stecke&arm&toilette|klo|wc|rohr|abfluss|abflussrohr",
    "cmd_stecken",
    "Was moechtest Du wohinein stecken?\n|"
    "Was moechtest Du wohinein stecken?\n"
  );

  AddCmd(
    "schaue|schau&spiegel|spiegel",
    "cmd_schauen",
    "Wohinein moechtest Du schauen?\n"
  );

  NewDoor("schrank", ROOM "schrank" , ({"tuer","schranktuer"}) ,
    ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME,  "Schranktuer"
     ,D_GENDER, FEMALE
     ,D_SHORT, "Eine %se Schranktuer."
     ,D_LONG, "Eine einfache Tuer aus schwarzem Holz. An der Tuer haengt "
              "ein Spiegel.\n"
     ,D_MSGS,    ({"in den Schrank","kriecht","kommt in den Schrank gekrochen"})
     ,D_OPENMSG, ({"Du oeffnest die Schranktuer.",
                   "%s oeffnet die Schranktuer.",
                   " schliesst sich."})
     ,D_CLOSEMSG, ({"Du schliesst die Schranktuer.",
                    "%s schliesst die Schranktuer.",
                    " wird von der anderen Seite geschlossen."})
     ,D_RESET_CLOSEMSG, " faellt ins Schloss."
     })
  );

  AddExit( ({"nordoben","norden"}) , ZROOM "weg-g7");
  SetProp(P_HIDE_EXITS, ({ "norden" }));
}

int cmd_schauen(string str)
{
  string s;

  tell_room(TO, CTPN+" schaut in den Spiegel und ist entsetzt!\n", ({ TP }) );

  if(TP->QueryProp(P_FROG))
  {
    tell_object(TP, BS("Im Spiegel siehst Du einen kleinen, schleimigen "
                       "Frosch. Wie ekelhaft! Ups, das bist ja Du!"));
    return 1;
  }

  switch(TP->QueryProp(P_RACE))
  {
    case "Elf":
      s = "Fuer eine gebratene Version Deiner Elfenohren liesse so mancher "
          "Zwerg ziemlich was springen...";
      break;

    case "Zwerg":
      s = "Hm, selbst fuer einen Zwergen bist Du recht klein, oder?";
      break;

    case "Mensch":
      s = "Du schaust in den Spiegel, betrachtest Dich von allen Seiten "
           "und fragst Dich, wie Du wohl beim anderen Geschlecht "
           "ankommst...";
      break;

    case "Dunkelelf":
      s = "Bei Lloth, Du siehst wirklich finster und gemein aus!";
      break;

    case "Troll":
      s = "Du fragst Dich, wie Du als Troll ueberhaupt in diese Hoehle "
          "passt. Naja, da Denken eh nicht Deine Staerke ist, laesst Du "
          "diesen Gedanken schnell fallen und suchst nach etwas, was "
          "Du ordentlich verpruegeln kannst.";
      break;

    case "Oger":
      s = "Ein Blick in den Spiegel zeigt Dir, dass Du fuer einen Oger "
          "eigentlich recht schlank bist und Du denkst, dass Du wirklich "
          "mehr essen solltest!";
      break;

    default:
      s = "Du schaust in den Spiegel und siehst: Dich!";
      break;
  }

  tell_object(TP, BS(s));

  return 1;
}

int cmd_huepfen(string str)
{
  if(TP->QueryProp(P_FROG))
  {
    tell_object(TP, BS("Du nimmst einen gewaltigen Anlauf und huepfst mit "
                       "aller Kraft - was Deine Froschschenkel hergeben - "
                       "in die Toilette."));

    TP->move(ROOM "toilette", M_GO , "in die Toilette"
                                   , "huepft"
                                   , "kommt in die Toilette gesprungen");

    EMASTER->Msg(TPUID+" huepft in die Toilette");

    return 1;
  }

  tell_object(TP, "Ne, Dafuer bist Du zu gross...\n");
  return -1;
}

int cmd_steigen(string str)
{
  if(TP->QueryProp(P_FROG))
  {
    tell_object(TP, BS("Muehsam versuchst Du, in die Toilette zu klettern. "
                       "Wegen Deiner glitschigen Froschschenkel rutschst "
                       "Du jedoch staendig ab. Vielleicht solltest Du es "
                       "auf einem anderen Wege versuchen?"));
  }
  else
  {
    tell_object(TP, "Ne, Du bist zu gross...\n");
  }

  return 1;
}

int cmd_ziehen(string str)
{
  tell_object(TP, "Ne, jetzt nicht. Spaeter vielleicht.\n");
  return 1;
}

int cmd_benutzen(string str)
{
  object ob;

  if(ob = present("\nharndrang", TP))
  {
    ob->remove();
    tell_object(TP, BS("Aaaah, das war ja hoechste Zeit. Noch eine "
                       "Sekunde spaeter, und Du haettest Dir in die Hose "
                       "gemacht."));
  }
  else
  {
    tell_object(TP, "Du musst grad nicht.\n" );
  }

  return 1;
}

int cmd_stecken(string str)
{
  tell_object(TP, BS("Du steckst Deinen Arm in die Toilette. So kannst Du "
                     "den Ring aber bestimmt nicht finden!"));
  return 1;
}


