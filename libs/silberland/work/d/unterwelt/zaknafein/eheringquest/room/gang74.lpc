#include "../def.h"

inherit ROOM "std_gang";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst in einem dunklen Gang irgendwo unterhalb Xatanas Hoehle. "
    "Du bemerkst hier einen suesslichen Geruch, weshalb Dein Blick sofort "
    "auf die Ueberreste eines Abenteurers faellt. Bei diesem "
    "fuerchterlichen Anblick laeuft Dir ein kalter Schauer ueber den "
    "Ruecken."
  );

  AddDetail( ({ "xatanas" , "hoehle" }) ,
    "In Xatanas Hoehle gefiel es Dir deutlich besser."
  );

  AddDetail( ({ "anblick" , "schauer" }) ,
    "Wahrhaftig kein schoener Anblick. Vielleicht solltest Du Dich aber "
    "trotzdem dazu zwingen, Dir die Ueberreste naeher anzuschauen."
  );

  AddDetail( ({ "ueberreste" , "abenteurer" , "abenteurers" }) ,
    "Es scheint die halbverweste Leiche eines Abenteurers zu sein. Die "
    "Kleidung ist total zerfetzt und blutverschmiert. Neben der Leiche "
    "liegt ein zerbrochenes Schwert."
  );

  AddDetail( ({ "schwert" , "Schwert" }) ,
    "Das Schwert ist zerbrochen. Es muss wohl ein harter Kampf "
    "stattgefunden haben."
  );

  AddDetail( ({ "kampf" , "Kampf" }) ,
    "Hm, dieser Abenteurer unterlag wohl. Hoffentlich ergeht es Dir "
    "nicht ebenso!"
  );

  AddDetail( ({ "leiche" , "Leiche" }) ,
    "Leider tat Dir der Abenteurer nicht den Gefallen, vollstaendig zu "
    "verwesen. So bietet er wahrhaft einen schauerlichen Anblick."
  );

  AddDetail( ({ "kleidung" , "Kleidung" }) ,
    "Als Dein Blick ueber die Kleidung schweift, faellt Dir ein Zettel "
    "auf. Hm, offensichtlich wurde er so angebracht, dass man ihn leicht "
    "findet."
  );

  AddDetail( ({ "zettel" , "Zettel" }) ,
    "Auf dem blutverschmierten Zettel steht etwas geschrieben."
  );

  AddDetail( ({ "flecken" , "stellen" }) ,
    "Der gesamte Boden ist mit dunkelroten Flecken verschmiert. Es "
    "scheint Blut zu sein."
  );

  AddDetail( ({ "blut" , "blutes" }) ,
    "Ein Geschmackstest beweist: Es ist definitiv Blut!"
  );

  AddDetail( ({ "geschmackstest" , "es" }) ,
    "Igitt!"
  );

  AddDetail( ({ "ruecken" , "Ruecken" }) ,
    "Schau mal in einem Anatomiebuch nach!"
  );

  AddDetail( ({ "Anatomiebuch" , "anatomiebuch" }) ,
    "Dieses Detail wurde aus Kostengruenden nicht implementiert."
  );

  AddDetail( ({ "Detail" , "kostengrueden" , "blick" , "kostengruende" }) ,
    "Nu is aber Schluss!!!"
  );

  AddDetail( ({ "schluss" , "Schluss" }) ,
    "Hmmmm, doch nicht... Nu aber!"
  );

  AddDetail( ({ "Boden" , "boden" }) ,
    "Auch hier wurden Steinplatten verlegt. An einigen Stellen erkennst "
    "Du Flecken getrockneten Blutes."
  );

  AddDetail( ({ "gang" , "gaenge" }) ,
    "Du stehst in ihm."
  );

  AddReadDetail( ({ "zettel" , "Zettel" }),
    "Bei meinem letzten Kampf wurde ich stark verwundet. Bevor ich "
    "sterbe, moechte ich den Abenteurern, die nach mir kommen, eine "
    "Botschaft hinterlassen, damit mein Tod nicht ganz umsonst war. Ziel "
    "all meiner Bemuehungen war es, die geheime Familiengruft zu finden."
    "Ich vermute, dass die Loesung in der Struktur der Gaenge selbst "
    "verborgen ist. Leider scheinen einige Gaenge versteckt zu sein."
    "Man muss sich besonders vor den hinterhael..."
  );

  AddSmell( ({DEFAULT_SMELL}) ,
    "Du bemerkst einen suesslichen Geruch."
  );

  AddSmell( ({"geruch"}) ,
    "Es riecht hier nach Verwesung.");

  AddSmell( ({"verwesung"}) ,
    "Dir wird langsam schlecht."
  );

  AddExit("westen" ,     ROOM "gang73");
  AddExit("suedwesten" , ROOM "gang75");

  AddItem(NPC "ratte", REFRESH_DESTRUCT);
  AddItem(NPC "fmaus", REFRESH_DESTRUCT);
}

