#include "../def.h"

inherit ROOM "std_gruft";

void create()
{
  ::create();

  long1 = "Du dringst tiefer in Xatanas geheime Familiengruft ein. ";
  long2 = "Auch hier steht - direkt vor Dir - ein grosser Sarg. ";

  AddDetail( ({ "sarg" }) ,
    "Der Sarg wurde aus weissem Marmor gefertigt. Zwischen den zahlreichen "
    "Verzierungen erkennst Du eine kleine Steinplatte.\n" );

  AddDetail( ({ "platte" , "steinplatte" }) ,
    "               _____\n"
    "              |     |\n"
    "              |     |\n"
    "       _______|     |_______\n"
    "      |                     |\n"
    "      |      Gill Bates     |\n"
    "      |_______       _______|\n"
    "              |     |\n"
    "              |     |\n"
    "              |     |\n"
    "              |     |\n"
    "              |     |\n"
    "              |     |\n"
    "              |_____|\n"
  );

  AddDetail( ({ "gill" , "bates" , "gill bates" }),
    "Wer das auch immer gewesen sein mag, er hat es bestimmt verdient, "
    "hier zu liegen! *g*"
  );

  AddDetail( ({ "saergen" , "saerge" }) ,
    "Insgesamt stehen in dieser Gruft vier Saerge."
  );

  AddItem(NPC "smeagol", REFRESH_REMOVE);

  AddExit("sueden" , ROOM "gruft1");
  AddExit("westen" , ROOM "gruft3");
}

