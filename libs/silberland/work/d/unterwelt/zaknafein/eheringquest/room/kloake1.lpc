#include "../def.h"

inherit ROOM "std_kloake";

string *staub_weg;
string *in_nische;

mapping dirtext;

void create()
{
  ::create();

  in_nische=({ });
  staub_weg=({ });

  SetProp(P_INT_LONG,
    "Du befindest Dich in der Kloake unterhalb Xatanas Wohnung. Es ist "
    "hier recht duester und unheimlich. Abgesehen von einer Nische im "
    "Sueden erkennst Du hier nichts Besonderes. "
  );

  AddDetail( ({ "steinplatten" , "platten" }) ,
   "Auf den Steinplatten erkennst Du Spuren." );
  AddDetail( ({ "eisen" , "Eisen" }) ,
   "Du bist Dir aber nicht sicher, ob es wirklich Eisen ist." );
  AddDetail( ({ "sueden" , "Sueden" }) ,
   "Im Sueden befindet sich eine grosse Nische." );
  AddSpecialDetail( ({ "nische" , "Nische" }) , "detail_nische" );
  AddDetail( ({ "metall" , "Metall" }) ,
   "Es koennte Eisen sein." );
  AddSpecialDetail( "platte" , "detail_platte" );
  AddDetail( ({ "Boden" , "boden" }) ,
    "Auf dem Boden wurden Steinplatten verlegt. Du erkennst Spuren." );
  AddDetail( ({ "Waende" , "waende" , "wand" }) ,
    "Die Waende bestehen aus schwarzem Felsgestein." );
  AddDetail( ({ "spuren" , "Spuren" }) ,
    "Hm, irgendein Wesen hat hier Spuren aus getrocknetem Schlamm "
    "hinterlassen." );
  AddDetail( ({ "schlamm" , "Schlamm" }) ,
    "Der Schlamm ist schon getrocknet." );
  AddDetail( ({ "wesen" , "Wesen" }) ,
    "Um welches Wesen es sich gehandelt hat, kannst Du nicht erkennen." );

  AddSpecialDetail( ({ "staub" , "Staub" }) , "detail_staub");

  AddSound( ({DEFAULT_SOUND}) , "Hm, es ist absolut still.");

  AddCmd(
    "wische|wisch&staub",
    "cmd_wischen",
    "Was moechtest Du wegwischen?\n"
  );

  AddCmd(
    "putze|putz|reinige|reinig|saeubere",
    "cmd_reinigen",
    ""
  );

  AddCmd(
    "betritt|betret|betrete&nische",
    "cmd_betreten",
    "Was moechtest Du betreten?"
  );

  AddCmd( ({ "yilrah" }) , "yilrah" );

  AddCmd(CMD_SAGEN, "cmd_sagen");

  AddSpecialExit( ({"osten","westen", "norden", "nordunten"}) , "exitroom" );
  AddProp(P_HIDE_EXITS, ({"norden"}) );

  AddItem(NPC "schluesseltier" , REFRESH_REMOVE);

  staub_weg = ({ });
  in_nische = ({ });
}

void reset()
{
  ::reset();

  staub_weg=({ });
}

string detail_staub(string str)
{
  string s;

  if(member(staub_weg, TPUUID) != -1)
  {
    s = "Du hast den Staub weggewischt.";
  }
  else
  {
    s = "Es handelt sich um schmierigen Staub. Irgendwie stoert der... "
        "Vielleicht solltest Du ihn wegwischen?";
  }

  return BS(s);
}

string detail_platte(string str)
{
  string s;

  if(member(staub_weg, TPUUID) != -1)
  {
    s = "  __________ \n"
        " |          |\n"
        " |  Yilrah  |\n"
        " |__________|\n";
  }
  else
  {
    s = BS("Die Platte ist mit schmierigem Staub bedeckt. Du kannst "
           "nichts erkennen.");
  }

  return s;
}

string detail_nische(string str)
{
  string s;

  if(member(in_nische, TPUUID) != -1)
  {
    s = "Du befindest Dich in der Nische. Am Boden entdeckst Du eine "
        "Platte.";
  }
  else
  {
    s = "Die Nische ist recht gross. Du koenntest sie betreten. Am Boden "
        "der Nische erkennst Du eine kleine Platte aus Metall.";
  }

  return BS(s);
}

int cmd_reinigen(string str)
{
  tell_object(TP, "Vielleicht solltest Du den Staub wegwischen?\n");
  return 1;
}

int cmd_wischen(string str)
{
  if(member(staub_weg, TPUUID) != -1)
  {
    tell_object(TP, BS("Fleissig polierst du die Platte, obwohl sie schon "
                       "sauber ist. Sollen die anderen doch denken, was "
                       "sie wollen! Dir macht's halt Spass!!"));
    return 1;
  }

  tell_object(TP, "Mit Deinem Aermel wischst Du den Staub weg.\n");
  staub_weg += ({ TPUUID });

  return 1;
}

int cmd_betreten(string str)
{
  if(member(in_nische, TPUUID) != -1)
  {
    tell_object(TP, "Du stehst schon in der Nische.\n");
    return 1;
  }

  tell_object(TP, "Du stellst Dich in die Nische.\n");
  tell_room(TO, CTPN+" stellt sich in die Nische.\n", ({ TP }) );

  in_nische += ({ TPUUID });
  return 1;
}

int yilrah(string str)
{
  if(member(in_nische, TPUUID) != -1)
  {
    tell_object(TP, "Du verlierst die Orientierung...\n");
    TP->move(ROOM "schrank", M_TPORT|M_NO_SHOW , "sich vor Deinen Augen"
                                               , "dematerialisiert"
                                               , "materialisiert sich vor "
                                                 "Deinen Augen");
    in_nische -= ({ TPUUID });
    staub_weg -= ({ TPUUID });
    return 1;
  }

  tell_object(TP, "Hm, es passiert nichts.\n");
  return 1;
}

int cmd_sagen(string str)
{
  if(!str || str == "") return 0;
  if(str == "yilrah") return yilrah("");
  return 0;
}

int exitroom(string dir)
{
  string target;

  if(dir == "norden") dir = "nordunten";

  if(member(in_nische, TPUUID) != -1)
  {
    tell_object(TP, "Du verlaesst die Nische und gehst nach "+
                    CAP(dir)+".\n");
  }

  in_nische -= ({ TPUUID });
  staub_weg -= ({ TPUUID });

  switch(dir)
  {
    case "osten":
      target = ROOM "kloake2";
      break;

    case "norden":
    case "nordunten":
      target = ROOM "kloake";
      break;

    case "westen":
      target = ROOM "kloake3";

      break;
  }

  TP->move(target, M_GO , "nach "+CAP(dir) , "geht" , "kommt herein");

  return 1;
}



