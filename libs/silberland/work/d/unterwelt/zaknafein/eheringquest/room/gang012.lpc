#include "../def.h"

inherit ROOM "std_gang";

void create()
{
  ::create();

  AddDetail( ({ "staub" , "staubschicht" , "schicht" }) ,
    "Die Staubschicht ist recht dick. Du glaubst hier Spuren zu erkennen."
  );

  AddDetail( ({ "spur" , "spuren" }) ,
    "Es sind tatsaechlich Spuren. Sie sind nur recht undeutlich. "
    "Wahrscheinlich stammen sie von einem sehr leichten Wesen."
  );

  AddDetail( ({"wesen"}) ,
    "Das Wesen muss wohl recht leicht und flink sein."
  );

  AddExit("norden" , ROOM "gang013");
  AddExit("osten"  , ROOM "gang011");
}

