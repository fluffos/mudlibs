#include "../def.h"

inherit ROOM "std_gang";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst in einem dunklen Gang irgendwo unterhalb Xatanas Hoehle. "
    "Du erkennst einen grossen Steinblock im Westen. Neben dem Steinblock "
    "erkennst Du einen Knopf."
  );

  AddDetail( ({ "knopf" }),
    "Du kannst ihn druecken."
  );

  AddDetail( ({ "waende","wand" }) ,
    "Die Waende bestehen aus schwarzem Felsgestein."
  );

  AddDetail( ({ "staubschicht" , "schicht", "staub" }) ,
    "Hm, hier war lange niemand mehr."
  );

  AddExit("sueden" , ROOM "gang014");
  AddExit("norden" , ROOM "gang02");

  NewDoor("westen", ROOM "gang46" , ({"block", "steinblock"}) ,
    ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME,  "Steinblock"
     ,D_GENDER, MALE
     ,D_SHORT, "Ein massiver Steinblock."
     ,D_LONG, "Ein massiver Steinblock, den wohl selbst der staerkste "
              "Troll nicht bewegen koennte, versperrt den Weg nach "
              "Osten."
     ,D_MSGS,    ({"nach Osten","geht","kommt herein"})
     ,D_OPENTESTFUNC, "doortest"
     ,D_OPENMSG, ({"Du schiebst den Steinblock beiseite.",
                   "%s schiebt den Steinblock beiseite.",
                   " gleitet zur Seite."})
     ,D_CLOSEMSG, ({"Du verschliesst den Durchgang.",
                    "%s schliesst den Durchgang.",
                    " wird zur Seite geschoben."})
     ,D_RESET_CLOSEMSG, " verschliesst den Durchgang wieder."
     ,D_FUNC, "door_close"
     })
  );

  AddCmd(
    "druecke|drueck&knopf",
    "cmd_druecken",
    "Was moechtest Du druecken?\n"
  );
}

int doortest()
{
  tell_object(TP, BS("Du versuchst den Steinblock beiseite zu schieben, "
                     "aber der ist viel zu schwer. "));
  return 1;
}

void SetThisDoor(int dstatus)
{
  DOOR_MASTER->SetDoorStatus(ROOM "gang46",dstatus,TO);
}

int QueryThisDoor()
{
  return DOOR_MASTER->QueryDoorStatus(ROOM "gang46",TO);
}

void door_close()
{
  tell_room(TO, BS("Mit einem lauten Grummeln schiebt sich der Steinblock "
                   "wieder vor den Gang und versperrt Dir somit den "
                   "Rueckweg."));

  SetThisDoor(D_STATUS_CLOSED);
}

int cmd_druecken(string str)
{
  if(QueryThisDoor() == D_STATUS_CLOSED)
  {
    tell_object(TP, BS("Du drueckst den Knopf. Der Steinblock bewegt sich "
                       "und gibt den Weg nach Westen frei."));
    SetThisDoor(D_STATUS_OPEN);
  }
  else
  {
    tell_object(TP, BS("Du drueckst den Knopf. Der Steinblock bewegt sich "
                       "und verschliesst den Weg wieder."));
    SetThisDoor(D_STATUS_CLOSED);
  }

  return 1;
}

string detail_block(string str)
{
  string s;

  if(QueryThisDoor() == D_STATUS_OPEN)
  {
    s = "Der Steinblock hat sich zur Seite bewegt und so einen Durchgang "
        "nach Westen freigegeben.";
  }
  else
  {
    s = "Der riesige Steinblock versperrt Dir den Weg nach Westen. Er "
        "besteht aus grauem Stein und sieht ziemlich massiv aus.";
  }

  return BS(s);
}

