#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In Xatanas Kerker." );
  SetProp(P_INT_LONG,
    "Du stehst in einer finsteren Kerkerzelle. So, so, Xatana hat also "
    "einen eigenen Kerker, in dem sie hilflose Prinzessinnen einsperrt. "
    "Sie hat wirklich einen sehr fragwuerdigen Charakter! Wie dem auch "
    "sei, der Kerker ist recht karg eingerichtet. Lediglich eine harte "
    "Pritsche und einen wackeligen Holztisch, vor dem ein alter Hocker "
    "steht, findest Du hier. "
  );

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( "charakter",
    "Naja, ob es wirklich Xatanas Idee war, hier hilflose Prinzessinnen "
    "einzusperren?");
  AddDetail( ({"idee"}) ,
    "Ihr Mann ist wohl eher dafuer verantwortlich.");
  AddDetail( ({"mann"}) ,
    "Frage doch mal Xatana, wer ihr Mann ist.");
  AddDetail( ({"kloake"}),
    "Die Kloake befindet sich oestlich von Dir.");
  AddDetail( ({ "xatana", "xatanas" }) ,
    "Und der hilfst Du... tsts");
  AddDetail( ({ "prinzessinnen" , "prinzessin" }),
    "Wie kann man sowas nur armen Prinzessinnen antun?");
  AddDetail( ({ "ort" , "raum" , "kerker", "zelle" , "kerkerzelle" }) ,
    "Dies ist wohl eher nicht der richtige Ort fuer Prinzessinnen!");
  AddDetail( ({"licht"}),
    "Die Kerzen spenden nur wenig Licht.");
  AddDetail( ({ "platten", "steinplatten" }) ,
    "An den Steinplatten kannst Du nichts Besonderes erkennen.");
  AddDetail( ({ "boden" }) ,
    "Auf dem Boden wurden Steinplatten verlegt." );
  AddDetail( ({ "wand" , "Waende" , "waende" }) ,
    "Die Waende bestehen aus schwarzem Felsgestein." );
  AddDetail( ({ "decke" }) ,
    "Hier haengt die Decke nur ein wenig hoeher als in der Kloake." );
  AddDetail( ({ "stein" , "felsgestein" }) ,
    "Harter, schwarzer Stein." );
  AddDetail( ({ "pritsche" }) ,
    "Hui, die Pritsche ist aber hart, wie kann man das einer armen "
    "Prinzessin nur antun?" );
  AddDetail( ({ "hocker" }) ,
    "Ein einfacher Hocker." );
  AddDetail( ({ "kerzen" , "kerze" }) ,
    "Auf dem Tisch stehen weisse Kerzen." );
  AddDetail( ({ "holztisch" , "tisch" }) ,
    "An diesem Tisch geruht die Prinzessin wohl zu speisen. Auf dem Tisch "
    "stehen Kerzen, die dem Raum etwas Licht spenden." );
  AddDetail( ({ "maus" , "maeuse" }) ,
    "Manchmal laufen hier Maeuse ueber den Boden, was die Prinzessin wohl "
    "etwas stoert." );

  AddSmell( ({DEFAULT_SMELL}) ,
    "Die Prinzessin verbreitet einen angenehmen Geruch.");
  AddSmell( ({"geruch"}) ,
    "Hmmmm. *schwaerm*");

  AddSound( ({DEFAULT_SOUND}) ,
    "Bis auf auf die Prinzessin hoerst Du hier kaum was.");

  AddItem(NPC "prinzessin" , REFRESH_REMOVE);

  NewDoor("osten", ROOM "kloake3" , ({"tuer", "kerkertuer"}) ,
    ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL|DOOR_NEEDKEY
     ,D_NAME,  "Kerkertuer"
     ,D_GENDER, FEMALE
     ,D_SHORT, "Im Osten befindet sich eine %se Kerkertuer."
     ,D_LONG, "Eine schwere Kerkertuer. Sie verhindert wirksam, das man von "
              "hier flieht, wenn sie verschlossen ist."
     ,D_MSGS, ({"den Kerker","verlaesst","kommt aus dem Kerker heraus"})
     ,D_FUNC, "auto_close"
     ,D_OPENMSG, ({"Du oeffnest die Kerkertuer.",
                   "%s oeffnet die Kerkertuer.",
                   " schliesst sich."})
     ,D_CLOSEMSG, ({"Du schliesst die Kerkertuer.",
                    "%s schliesst die Kerkertuer.",
                    " wird von der anderen Seite geschlossen."})
     ,D_RESET_CLOSEMSG, " faellt ins Schloss."
     })
  );
}

void auto_close()
{
  tell_object(TP, "Die Kerkertuer faellt hinter Dir ins Schloss.\n");
  DOOR_MASTER->SetDoorStatus(ROOM "kloake3", D_STATUS_LOCKED);
}

