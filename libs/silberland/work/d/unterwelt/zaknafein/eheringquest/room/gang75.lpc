#include "../def.h"

inherit ROOM "std_gang";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem dunklen Gang" );

  SetProp(P_INT_LONG,
    "Vorsichtig bewegst Du Dich weiter durch die schmalen, dunklen Gaenge "
    "irgendwo unterhalb Xatanas Hoehle. Die Waende und die Decke scheinen "
    "Dich zu erdruecken. Der Boden ist mit einer dicken Staubschicht "
    "bedeckt."
  );

  AddExit("suedwesten" , ROOM "gang76");
  AddExit("nordosten"  , ROOM "gang74");

  AddItem(NPC "ratte", REFRESH_DESTRUCT);
  AddItem(NPC "fmaus", REFRESH_DESTRUCT);
}



