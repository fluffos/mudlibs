#include "../def.h"

inherit ROOM "std_gruft";

void create()
{
  ::create();

  long1 = "Du stehst nun ganz im Nordwesten der Familiengruft. ";
  long2 = "Der Sarg, der hier steht, sieht irgendwie unbenutzt aus. ";

  AddDetail( ({"nordwesten"}) ,
    "Ja, Du befindest im Nordwesten der Gruft."
  );

  AddSpecialDetail( ({ "steinplatte" , "platte" }) , "detail_platte" );

  AddDetail( ({ "saergen" , "saerge" }) ,
    "Insgesamt stehen in dieser Gruft vier Saerge.\n"
  );

  AddExit("sueden" , ROOM "gruft4");
  AddExit("osten"  , ROOM "gruft2");

  NewDoor("sarg", ROOM "sarg" , ({"sarg"}) ,
    ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME,  "Sarg"
     ,D_GENDER, MALE
     ,D_SHORT, "Ein Marmorsarg."
     ,D_LONG, "Der Sarg wurde aus weissem Marmor gefertigt. Zwischen den "
              "zahlreichen Verzierungen erkennst Du eine kleine Steinplatte."
     ,D_MSGS,    ({"in den Sarg"
                  ,"klettert"
                  ,"kommt hereingeklettert. Oh, wie kueschelig!"
                  })
     ,D_OPENMSG, ({"Du oeffnest den Sarg"
                  ,"%s oeffnet den Sarg"
                  ," wird geoeffnet."
                  })
     ,D_CLOSEMSG, ({"Du schliesst den Sarg."
                   ,"%s schliesst den Sarg."
                   ," wird geschlossen."
                   })
     ,D_RESET_CLOSEMSG, " schliesst sich wie von Geisterhand. Gruselig!"
     })
  );


}

detail_platte()
{
  string s;

  s = "               _____\n"
      "              |     |\n"
      "              |     |\n"
      "       _______|     |_______\n"
      "      |                     |\n"
      "      |                     |\n"
      "      |_______       _______|\n"
      "              |     |\n"
      "              |     |\n"
      "              |     |\n"
      "              |     |\n"
      "              |     |\n"
      "              |     |\n"
      "              |_____|\n"
      "\n"
      "Hoffentlich steht nicht bald '"+CAP(getuid(TP))+"' auf dem Kreuz...\n";

  return s;
}
