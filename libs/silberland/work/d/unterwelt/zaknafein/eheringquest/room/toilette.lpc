#include "../def.h"

inherit "std/room";

string *inseq;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In Xatanas Toilette" );
  SetProp(P_INT_LONG,
    "Du stehst in einer kleinen Pfuetze in Xatanas Toilette! Na toll! "
    "Lecker! Ob das eine gute Idee war, wird sich bald herausstellen... "
    "Du erkennst hier ein Abflussrohr und eine Kette, die neben Dir haengt."
  );

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );

  SetProp(P_NOMAGIC, 1);

  AddDetail( ({ "kette", "Kette" }),
    "Die Kette haengt von der Decke herab. Sie muss wohl durch Zufall in "
    "die Kloschuessel geraten sein...");

  AddDetail( ({ "rohr", "abflussrohr" }),
    "Dort geht es hinab in unergruendliche Tiefen... Hm, koennte mal "
    "wieder geputzt werden... Du nimmst Dir vor, Xatana darauf aufmerksam "
    "zu machen.");

  AddDetail( ({"pfuetze"}) ,
    "Glaub mir, Du moechtest es nicht naeher betrachten!"
  );

  AddDetail( ({ "xatanas" }),
    "Die Tusse von Zaknafein. Du erinnerst Dich dunkel..."
  );

  AddDetail( ({"tusse"}) ,
    "Sie ist wohl fuer die Toilettenreinigung zustaendig."
  );

  AddDetail( ({ "tiefen", "tiefe" }),
    "Vielleicht sind sie ja gar nicht so unergruendlich..."
  );

  AddDetail( ({"decke"}) ,
    "Eine Decke gibt es hier nicht."
  );

  AddDetail( ({"boden"}) ,
    "Du erkennst dort eine kleine Pfuetze."
  );

  AddDetail( ({ "waende" , "wand" }) ,
    "Die Waende der Toilette sind rundlich."
  );

  AddDetail( ({ "oertchen" , "toilette" }) ,
    "Du stehst in Xatanas Toilette."
  );

  AddDetail( ({"idee"}) ,
    "Hm, vielleicht ist es ja eine gute Idee..."
  );

  AddDetail( ({ "schuessel" , "kloschuessel" }) ,
    "Die Kette haengt in der Kloschuessel."
  );

  AddDetail( ({"zufall"}) ,
    "Vielleicht kann man diesen Zufall irgendwie nutzen?"
  );

  AddDetail( ({ "reinigung" , "toilettenreinigung" }) ,
    "Sie hat wirklich gute Arbeit geleistet."
  );

  AddDetail( ({"arbeit"}) ,
    "Es ist wirklich sehr sauber hier, wenn man mal von dem Abflussrohr "
    "absieht.");

  AddDetail( ({"zaknafein"}) ,
    "Der ist nicht hier."
  );

  AddSmell( ({DEFAULT_SMELL}) ,
    "Hm, es riecht nach Essig und Zitrone.");

  AddSmell( ({ "essig" , "zitrone" }) ,
    "Riecht sehr frisch! Solltest Du auch mal probieren..."
  );

  AddSound( ({DEFAULT_SOUND}) ,
    "Du hoerst nichts. Dies ist ja auch das 'stille Oertchen'. *g*"
  );

  AddCmd(
    "zieh|ziehe&kette",
    "cmd_ziehen",
    "Woran moechtest Du ziehen?\n"
  );

  AddCmd(
    "steig|steige|klettere|kletter|huepfe|huepf|spring|springe&raus|toilette",
    "cmd_springen",
    "Woraus moechtest Du springen?\n"
  );

  inseq = ({ });
}

int cmd_ziehen(string str)
{
  tell_object(TP, BS("Du hoerst ein gewaltiges Rauschen und eine riesige "
                     "Flutwelle kommt auf Dich zugerast. Du kannst Dich "
                     "gerade noch an der Kette festkrallen. Doch Du wirst "
                     "die Toilette runtergespuelt. Sowas!"));

  tell_room(TO, "Auf einmal wird die Spuelung der Toilette betaetigt.\n",
                ({ TP }) );

  inseq += ({ getuuid(TP) });

  EMASTER->Msg(TPUID+" zieht an der Klospuelung");

  call_out("toiseq", 0, TP, 1);

  return 1;
}

int cmd_springen(string str)
{
  if(member(inseq, getuuid(TP) ) != -1) return 0;

  tell_object(TP, "Du springst panikartig aus der Toilette!\n");

  TP->move(ROOM "start", M_GO , "in Panik aus der Toilette"
                              , "springt"
                              , "kommt aus der Toilette gesprungen");

  return 1;
}

void toiseq(object pl, int step)
{
  string s;

  if(ENV(pl) != TO) return;

  switch(step)
  {
    case 1:
      s = "Ploetzlich hoerst Du ein gewaltiges Rauschen.";
      break;

    case 2:
      s = "\nEine riesige Flutwelle rast auf Dich zu.\n";
      break;

    case 3:
      s = "\n"+BS("Du wirst von ihr erfasst und von einem gewaltigen "
          "Strudel in die Tiefe gerissen.");
      break;

     case 4:
       s = "\n"+BS("Um Dich herum ist nur noch Wasser. Vergeblich "
           "versuchst Du nach Luft zu schnappen. Dir wird langsam schwarz "
           "vor Augen.");
       break;

     default:
       tell_object(pl, "\n"+BS("Mit lautem Getoese spuckt Dich endlich "
                       "das Abflussrohr aus. Du landest in zaehem "
                       "Schlamm."));
       inseq -= ({ getuuid(pl) });
       pl->move(ROOM "kloake", M_GO, "aus dem Rohr heraus"
                                   , "puzelt"
                                   , "kommt mit einem Schwall Wasser "
                                     "runtergespuelt.");
       return;
  }

  tell_object(pl, s);
  call_out("toiseq", 4, pl, ++step);
}

