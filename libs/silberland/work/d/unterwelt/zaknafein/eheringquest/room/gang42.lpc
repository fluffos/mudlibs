#include "../def.h"

inherit ROOM "std_gang";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst in einem dunklen Gang irgendwo unterhalb Xatanas Hoehle. "
    "Hier war wohl schon lange niemand mehr. Der Boden ist mit einer "
    "dicken Staubschicht bedeckt. Unter der Staubschicht faellt Dir eine "
    "Zeichnung auf. "
  );

  AddDetail( ({ "zeichnung"}),
    "Die Zeichnung stellt einen Pfeil dar."
  );

  AddDetail( ({ "pfeil" }),
    "Der Pfeil zeigt nach Norden."
  );

  AddDetail( ({ "norden" }),
    "Dort liegt die Nordwand."
  );

  AddDetail( ({ "nordwand" }),
    "Hm, die Nordwand kommt Dir etwas merkwuerdig vor."
  );

  AddDetail( ({ "boden" }) ,
    "Auf dem Boden wurden Steinplatten verlegt. Du erkennst eine "
    "Zeichnung, die auf den Boden gemalt wurde."
  );

  AddDetail( ({ "staub" , "staubschicht" , "schicht" }) ,
    "Durch die Staubschicht hindurch kannst Du eine Zeichnung erkennen."
  );

  AddCmd(
    "taste|ertaste&wand|nordwand",
    "cmd_tasten",
    "Was moechtest Du ertasten?\n"
  );

  AddExit("norden" , ROOM "gang43");
  AddExit("westen" , ROOM "gang41");
  AddExit("osten"  , ROOM "gang45");

  AddProp(P_HIDE_EXITS, ({"norden"}) );
}

int cmd_tasten(string str)
{
  EMASTER->Nsg(TPUID+" betastet die Wand");

  tell_object(TP, "Hm, merkwuerdig... Deine Haende gleiten durch die "
                  "Wand.\n");
  return 1;
}

