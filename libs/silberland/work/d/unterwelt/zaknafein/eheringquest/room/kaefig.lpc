#include "../def.h"

inherit "/std/room";

#define AUF 1
#define ZU 0

int riegel;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem grossen Kaefig" );
  SetProp(P_INT_LONG,
    "Du stehst nun in einem grossen Kaefig, in dem anscheinend ein Tier "
    "gefangengehalten wird. In einer Ecke liegen einige Strohballen, neben "
    "denen ein Futternapf steht. An der Westwand befindet sich ein "
    "grosses Wasserbassin. "
  );

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"kaefig", "raum"})  , QueryProp(P_INT_LONG) );

  AddDetail( ({"stroh"}) ,
    "Das Stroh ist ziemlich verdreckt.");

  AddDetail( ({"dreck"}) ,
    "Du siehst sehr viel Dreck. Hier wird ja auch ein Tier gehalten.");

  AddSpecialDetail( ({ "riegel" }), "detail_riegel" );

  AddDetail( ({ "strohballen" , "ballen" }) ,
    "Die Strohballen dienen dem Tier wohl als Schlafstaette." );

  AddDetail( ({ "futternapf" , "napf" }) ,
    "Der Futternapf ist leer. Das Tier hat wohl besonders grossen Hunger. "
    "Ob es auch Fleisch mag?" );

  AddDetail( ({ "fleisch" }) ,
    "Dein Fleisch zum Beispiel..." );

  AddDetail( ({ "beispiel" }) ,
    "Du solltest Dich wohl eher ruhig verhalten..." );

  AddDetail( ({ "hunger" }) ,
    "Naja, vielleicht wird das Tier ja nicht anstaendig gefuettert, "
    "sondern ernaehrt sich eher von Fleisch, das so freiwillig "
    "hereinspaziert..." );

  AddDetail( ({ "bassin" , "wasserbassin" }) ,
    "Das Wasserbassin ist recht gross. Es hat einen Durchmesser von "
    "ungefaehr einem Meter. Das Wasser, das sich in dem Bassin befindet, "
    "ist recht truebe." );

  AddDetail( ({ "westwand" }) ,
    "An der Westwand befindet sich ein grosses Wasserbassin. " );

  AddDetail( ({ "boden" }) ,
    "Der Boden besteht hier aus festgetrampeltem Lehm.");

  AddDetail( ({ "decke" }) ,
    "Die Decke hier ist recht hoch und nach oben gewoelbt." );

  AddDetail( ({ "stein" , "felsgestein" , "gestein" }) ,
    "Das Felsgestein ist recht hart." );

  AddDetail( ({"lehm"}) ,
    "Der Boden ist mit schmutzigem, braunem Lehm bedeckt." );

  AddDetail( ({"wasser"}) ,
    "Das Wasser ist recht truebe. Du kannst den Grund nicht entdecken." );

  AddDetail( ({"grund"}) ,
    "Hm, wie tief das Bassin wohl ist?" );

  AddDetail( ({"ecke"}) ,
    "Dort liegen einige Strohballen." );

  AddDetail( ({ "waende" , "wand" }) ,
    "Die Waende bestehen auch hier aus schwarzem Felsgestein." );

  AddDetail( ({ "durchmesser" , "meter" }) ,
    "Du schaetzt, dass der Durchmesser ungefaehr einen Meter betraegt." );

  AddSpecialDetail( ({ "staette", "schlafstaette"}) , "detail_staette");

  AddSmell( DEFAULT_SMELL , "Es riecht hier sehr streng nach Tier.");
  AddSound( DEFAULT_SOUND , "Du hoerst das Tropfen von Wasser.");
  AddSound( "tropfen" , "tropf, tropf...");

  AddCmd( ({ "schieb" , "schiebe" })  , "cmd_schieben" );
  AddCmd( ({ "schwimme" , "schwimm" }), "cmd_schwimmen" );

  AddCmd(
    "springe|spring|tauche|tauch&bassin|wasserbassin",
    "cmd_tauchen",
    "In was moechtest Du tauchen?\n"
  );

  AddItem( OBJ "mfackel" ,  REFRESH_REMOVE);
  AddItem( OBJ "mfackel" ,  REFRESH_REMOVE);
  AddItem( OBJ "mfackel" ,  REFRESH_REMOVE);

  AddItem( NPC "ungetuem" , REFRESH_REMOVE);

  NewDoor("raus", ROOM "kloake3" , ({"tuer","kaefigtuer"}) ,
    ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME,  "Kaefigtuer"
     ,D_GENDER, FEMALE
     ,D_SHORT, "Eine %se Kaefigtuer."
     ,D_LONG, "Eine schwere Kaefigtuer sorgt dafuer, das nichts entkommen "
              "kann. Mit einem grossen Riegel kann man die Tuer sicherm."
     ,D_MSGS,    ({"den Kaefig","verlaesst","kommt aus dem Kaefig gekrochen"})
     ,D_OPENTESTFUNC, "doortest"
     ,D_OPENMSG, ({"Du oeffnest die Kaefigtuer.",
                   "%s oeffnet die Kaefigtuer.",
                   " schliesst sich."})
     ,D_CLOSEMSG, ({"Du schliesst die Kaefigtuer.",
                    "%s schliesst die Kaefigtuer.",
                    " wird von der anderen Seite geschlossen."})
     ,D_RESET_CLOSEMSG, " faellt ins Schloss."
     })
  );

  riegel = ZU;
}

void SetThisDoor(int dstatus)
{
  DOOR_MASTER->SetDoorStatus(ROOM "kloake3",dstatus,TO);
}

int QueryThisDoor()
{
  return DOOR_MASTER->QueryDoorStatus(ROOM "kloake3",TO);
}

int doortest()
{
  if(riegel == ZU)
  {
    tell_object(TP, "Aber der Riegel ist doch noch vorgeschoben!\n");
    return 1;
  }

  return 0;
}

string detail_staette(string str)
{
  string s;
  object tier;

  if(tier = present("\nzaktier", TO))
  {
    if(tier->QueryProp(P_SLEEP))
    {
      s = "Auf den Strohballen schlaeft ein grosses Tier.";
    }
    else
    {
      s = "Da hat bestimmt dieses Ungetuem drauf geschlaffen. ";
    }
  }
  else
  {
    s = "Die Schlafstaette ist leer.";
  }

  return BS(s);
}

string detail_riegel(string str)
{
  string s;

  s = "Mit Hilfe des Riegels kann man die Tuer oeffnen oder verschliessen. "
      "Den Riegel kann man vor- und zurueck schieben. ";

  if(riegel == ZU)
  {
    s += "Die Tuer ist momentan geschlossen und verriegelt. ";
  }
  else
  {
    if(QueryThisDoor() == D_STATUS_OPEN)
    {
      s += "Der Riegel ist zurueckgeschoben und die Tuer offen. ";
    }
    else
    {
      s += "Der Riegel ist zurueckgeschoben, die Tuer allerdings ist noch "
           "zu. ";
    }
  }

  return BS(s);
}

int cmd_schieben(string str)
{
  int syntax;

  notify_fail("Was moechtest Du zurueck schieben?\n");

  if(!str || str == "") return 0;

  syntax = 0;
  if(!syntax  && (str == "riegel weg"))     syntax = 1;
  if(!syntax  && (str == "riegel zurueck")) syntax = 1;
  if(!syntax  && (str == "riegel vor"))     syntax = 2;

  switch(syntax)
  {
    case 1:
      if(QueryThisDoor() == D_STATUS_OPEN)
      {
        tell_object(TP, BS("Aber der Riegel ist doch schon zurueckgeschoben "
                           "und die Tuer geoffnet!"));
        return 1;
      }

      if(riegel == AUF)
      {
        tell_object(TP, BS("Aber der Riegel ist doch schon zurueckgeschoben "
                           "worden."));
        return 1;
      }

      riegel = AUF;
      tell_object(TP, "Du schiebst den Riegel zurueck.\n");
      EMASTER->Msg(TPUID+" schiebt den Riegel zurueck");

      break;

    case 2:
      if(QueryThisDoor() == D_STATUS_OPEN)
      {
        tell_object(TP, BS("Du musst die Tuer erst schliessen, bevor Du den "
                           "Riegel vorschieben kannst."));
        return 1;
      }

      if(riegel == ZU)
      {
        tell_object(TP, "Aber der Riegel ist doch schon vorgeschoben.\n");
        return 1;
      }

      riegel = ZU;
      tell_object(TP, "Du verriegelst die Tuer.\n");
      EMASTER->Msg(TPUID+" schiebt den Riegelvon und verriegelt die Tuer");

      break;

    default:
      return 0;
      break;
  }

  return 1;
}

int cmd_tauchen(string str)
{
  tell_object(TP, BS("Du stellst Dich auf den Rand des Bassins und "
                     "springst hinein."));

  TP->move(ROOM "uwroom1", M_GO , "in das Wasserbassin"
                                , "springt"
                                , "springt Dir fast auf den Kopf");

  EMASTER->Msg(TPUID+" taucht in das Bassin");
  return 1;
}

int cmd_schwimmen(string str)
{
  tell_object(TP, BS("Hm, das Wasserbassin ist zu klein. Darin schwimmen "
                     "kannst Du nicht. Du kannst aber hineinspringen und "
                     "tauchen."));
  return 1;
}

