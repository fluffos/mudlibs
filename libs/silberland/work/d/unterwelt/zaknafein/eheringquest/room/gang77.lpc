#include "../def.h"

inherit ROOM "std_gang";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du stehst in einem dunklen Gang irgendwo unterhalb Xatanas Hoehle. "
    "Hier war wohl schon lange niemand mehr. Auch hier ist der Boden mit "
    "einer dicken Staubschicht bedeckt."
  );

  AddExit("suedwesten" , ROOM "gang78");
  AddExit("nordosten" ,  ROOM "gang76");

  AddItem(NPC "vampir" , REFRESH_REMOVE);
}

