#include "../def.h"

inherit ROOM "std_gang";

string *pl;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem dunklen Gang mit einem grossen Schutthaufen" );
  SetProp(P_INT_LONG,
    "Du stehst in einem dunklen Gang irgendwo unterhalb Xatanas Hoehle. "
    "Hier liegt ein grosser Schutthaufen auf dem Boden."
  );

  AddDetail( ({ "verwendung" , "Verwendung" }),
    "Fuer die Bruchstuecke gab es wohl keine Verwendung mehr, weshalb sie "
    "hier liegen."
  );

  AddDetail( ({ "xatanas" , "hoehle" }) ,
    "Dort hat alles begonnen..."
  );

  AddDetail( ({ "schutthaufen" , "haufen" }),
    "Hier hat wohl jemand saemtlichen Schutt, der sich beim Bau der "
    "Gaenge angesammelt hat, zu einem grossen Haufen zusammengefegt."
  );

  AddDetail( ({ "schutt" , "Schutt" }),
    "Du erkennst Bruchstuecke von Felsen und Platten sowie Holzreste."
  );

  AddDetail( ({ "bau" , "Bau" }),
    "Als die Gaenge angelegt wurden, fiel wohl viel Schutt an, den man "
    "hier abgeladen hat."
  );

  AddDetail( ({ "bruchstuecke" , "stuecke" }) ,
    "Fuer die Bruchstuecke gab es wohl keine Verwendung mehr."
  );

  AddDetail( ({ "felsen" , "Felsen" }),
    "Die Felsen, die in dem Schutthaufen liegen, gleichen den Felsen, aus "
    "denen die Waende hier in den Gaengen bestehen."
  );

  AddDetail( ({ "platten" , "Platten" }),
    "Es handelt sich um Bruchstuecke der Platten, die hier ueberall in "
    "den Gaengen verlegt wurden."
  );

  AddSpecialDetail( ({ "holzreste" , "reste" }), "detail_reste");
  AddSpecialDetail( ({ "stock" , "holzstock" }), "detail_stock");

  AddDetail( ({ "Boden" , "boden" }) ,
    "Auf dem Boden wurden Steinplatten verlegt. Du erblickst hier einen "
    "grossen Schutthaufen."
  );

  AddDetail( ({ "staubschicht" , "schicht" }) ,
    "Hm, hier war anscheinend lange niemand mehr. " );

  AddDetail( ({ "steinplatten"  }) ,
    "Es sind einfache Steinplatten. Man kann sie kaum erkennen, da hier "
    "so viel Schutt rumliegt."
  );

  AddCmd(
    "zieh|ziehe&stock|holzstock&aus&haufen",
    "cmd_ziehen",
    "Moechtest Du etwa etwas herausziehen?\n|"
    "Moechtest Du etwa etwas herausziehen?\n|"
    "Moechtest Du etwa etwas herausziehen?\n"
  );

  AddExit("norden" , ROOM "gang48");

  pl = ({ });
}

void reset()
{
  ::reset();

  pl = ({ });
}

cmd_ziehen(str)
{
  object stock;

  if(member(pl, getuuid(TP)) != -1)
  {
    tell_object(TP, "Welchen Stock meinst Du denn? Hier ist keiner...\n");
    return -1;
  }

  stock = clone_object("/p/weapon/club/holzstock");
  if(stock->move(TP, M_GET) != 1)
  {
    tell_object(TP, "Du Schwaechling kannst den Stock nicht mehr tragen!\n");
    stock->remove();
    return -1;
  }

  tell_object(TP, BS("Du ziehst den Holzstock aus dem Schutthaufen heraus "
                     "und steckst ihn ein."));

  EMASTER->Msg(TPUID+" nimmt sich den Holzstock");

  pl += ({ getuuid(TP) });

  return 1;
}

string detail_stock(string str)
{
  string s;

  if(member(pl, getuuid(TP)) == -1)
  {
    s = "Du koenntest den Stock aus dem Haufen herausziehen.";
  }
  else
  {
    s = "Sowas siehst Du da nicht!";
  }

  return BS(s);
}

string detail_reste(string str)
{
  string s;

  s = "Es handelt sich um Holzreste, die wohl beim Bau der Gaenge "
      "angefallen sind. ";

  if(member(pl, getuuid(TP)) == -1)
  {
    s += "Du erkennst auch einen kleinen Stock, der in dem Schutthaufen "
         "liegt.";
  }

  return BS(s);
}

