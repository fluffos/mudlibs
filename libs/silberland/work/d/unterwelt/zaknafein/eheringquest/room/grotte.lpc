#include "../def.h"

inherit "/std/room";

string *helmet;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer grossen Grotte");
  SetProp(P_INT_LONG,
    "Voellig durchnaesst stehst Du nun in einer grossen Grotte, deren "
    "Waende und Decke aus grauem Gestein bestehen. Am Boden liegen ueber "
    "den ganzen Raum verstreut kleine Gesteinsbrocken. In der Mitte der "
    "Grotte erregt ein kleiner Sockel Deine Aufmerksamkeit, da er sich "
    "wegen seiner Farbe und seiner Form stark von der Umgebung abhebt. "
    "Der suedliche Teil der Grotte liegt vollstaendig im Wasser. "
  );

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist mit kleinen grauen Steinchen bedeckt. Vereinzelt "
    "liegen hier auch groessere Gesteinsbrocken.");

  AddDetail( ({ "decke" }) ,
    "Die Decke ist leicht nach oben gewoelbt und von vielen Furchen und "
    "Spalten durchzogen." );

  AddDetail( ({ "wand" , "waende" }) ,
    "Wie die Decke sind auch die Waende von vielen Furchen und Spalten "
    "durchzogen. In eine Wand wurde eine Steinplatte eingelassen." );

  AddDetail( ({ "furchen" , "spalten" }) ,
    "Die vielen Furchen und Spalten deuten darauf hin, dass die Grotte "
    "natuerlichen Ursprungs ist." );

  AddDetail( ({ "ursprung" , "ursprungs" }) ,
    "Anders als die Raeume, durch die Du hierher gelangt bist, scheint "
    "diese Grotte natuerlichen Ursprungs zu sein." );

  AddDetail( ({ "stein" }) ,
    "Der Stein ist absolut hart und tief schwarz." );

  AddDetail( ({ "steinplatte" , "platte" }) ,
    "Die Platte besteht wie der Sockel auch aus tief schwarzem Stein. Es "
    "wurde eine Zeichnung eingearbeitet." );

  AddDetail( ({ "sockel" }) ,
    "Der Sockel besteht aus tief schwarzem Stein. Seine Oberflaeche ist "
    "vollkommen glatt." );

  AddDetail( ({ "oberflaeche" }) ,
    "Die Oberflaeche des Sockels ist perfekt glatt.");

  AddDetail( ({ "raeume" }) ,
    "Die anderen Raeume waren sicherlich nicht natuerlichen Ursprungs." );

  AddDetail( ({ "mitte" }) ,
    "In der Mitte der Grotte steht ein Sockel." );

  AddDetail( ({ "aufmerksamkeit" }) ,
    "Der Sockel faellt Dir sofort auf, da er sich sehr aufgrund seiner "
    "Farbe und seiner perfekten Form von seiner Umgebung abhebt." );

  AddDetail( ({ "form" , "Form" }) ,
    "Der Sockel ist quaderfoermig. Hm, jetzt, da Du ihn naeher "
    "betrachtest, faellt Dir ein kleiner Knopf auf." );

  AddDetail( ({ "raum" , "umgebung" , "grotte" }) ,
    "Es lohnt sich bestimmt, sich hier alles genau anzuschauen." );

  AddDetail( ({ "steinchen" }) ,
    "Die vielen Steinchen bewirken ein knirschendes Geraeusch, wenn Du "
    "gehst." );

  AddDetail( ({ "teil" }) ,
    "Dieser Teil der Grotte liegt vollig im Wasser. Du koenntest wieder "
    "hineinspringen und tauchen." );

  AddDetail( ({ "wasser" }) ,
    "Das Wasser sieht gruenlich aus und riecht recht faulig. Du kannst "
    "hineinspringen." );

  AddDetail( ({ "farbe" }) ,
    "Der Sockel ist tief schwarz, waehrend die Waende und die Decke aus "
    "grauem Gestein bestehen." );

  AddDetail( ({ "gesteinsbrocken" , "brocken" }) ,
    "Man muss aufpassen, dass man nicht ueber sie stolpert." );

  AddDetail( ({ "gestein" }) ,
    "Es handelt sich um gewoehnliches Gestein." );

  AddDetail( ({ "knopf" }) ,
    "Hm, wofuer der wohl ist?" );

  AddSpecialDetail( ({"zeichnung"}) , "detail_zeichnung" );

  AddSmell( ({DEFAULT_SMELL}) ,
    "Die Luft riecht hier abgestanden und leicht faulig.");

  AddSmell( ({"wasser"}) ,
    "Das Wasser riecht recht faulig.");

  AddSmell( ({"luft"}) ,
    "Nicht gerade frisch..." );

  AddSound( ({DEFAULT_SOUND}) ,
    "Du hoerst das Tropfen von Wasser.");

  AddSound( ({ "tropfen" , "wasser" }) ,
    "Die Geraeusche kommen aus dem suedlichen Teil der Grotte." );

  AddSound( ({"geraeusche"}) ,
    "Das Tropfen von Wasser...");

  AddSound( ({"geraeusch"}) ,
    "knirsch, knirsch...");


  AddCmd(
    "drueck|druecke&knopf",
    "cmd_druecken",
    "Was moechtest Du druecken?\n"
  );

  AddCmd(
    "springe|spring|tauche|tauch&ab|wasser|unter|hinein",
    "cmd_tauchen",
    "In was moechtest Du tauchen?\n"
  );

  AddCmd( ({ "schwimme" , "schwimm" }), "cmd_schwimmen" );

  helmet = ({ });
}

void reset()
{
  ::reset();

  helmet = ({ });
}

string detail_zeichnung(string str)
{
  string s;

  if(EMASTER->QueryMap(TPUUID))
  {
    s = "                                 \n"
        "         |                       \n"
        "         o                       \n"
        "         |                       \n"
        "       --o--o--o--o              \n"
        "         |       /               \n"
        "         o      o                \n"
        "         |     /                 \n"
        "         o -- o--o--             \n"
        "             /                   \n"
        "            o                    \n"
        "           /                     \n"
        "          o                      \n"
        "                                 \n";
  }
  else
  {
    s = "                                 \n"
        "         |                       \n"
        "         o                       \n"
        "         |                       \n"
        "       --o--o--o--o              \n"
        "         |       /               \n"
        "         o      o                \n"
        "         |     /                 \n"
        "         o -- o--o--             \n"
        "                                 \n";
  }

  return s;
}

cmd_druecken(string str)
{
  object ob;
  string s;

  if(EMASTER->QueryMap(TPUUID))
  {
    if(member(helmet, TPUUID) == -1)
    {
      s = "Du drueckst auf den Knopf und ein Helm materialisiert sich auf "
          "auf dem Podest.";
      ob = clone_object(ARMOUR "eqhelm");
      ob->move(TO, M_NOCHECK);
      helmet += ({ TPUUID });
      EMASTER->Msg(TPUID+" drueckt auf den Knopf un bekommt den Helm");
    }
    else
    {
      s = "Du drueckst auf den Knopf, und die Zeichnung an der Wand "
          "leuchtet kurz auf.";
    }

    tell_object(TP, BS(s));
    return 1;
  }

  EMASTER->SetMap(TPUUID);
  if(EMASTER->QueryMap(TPUUID))
  {
    if(member(helmet, TPUUID) == -1)
    {
      s = "Du drueckst den Knopf und bemerkst, dass sich etwas an der Wand "
          "geaendert hat. Ausserdem hat sich ein Helm auf dem Podest "
          "materialisiert. ";
      ob = clone_object(ARMOUR "eqhelm");
      ob->move(TO, M_NOCHECK);
      helmet += ({ TPUUID });
    }
    else
    {
      s = "Du drueckst den Knopf und bemerkst, dass sich etwas an der Wand "
          "geaendert hat. ";
    }
  }
  else
  {
    s = "Du drueckst auf den Knopf, aber es passiert nichts. ";
  }

  tell_object(TP, BS(s));

  return 1;
}

int cmd_tauchen(string str)
{
  tell_object(TP, "Du springst in das Wasser und tauchst ab.\n");
  TP->move(ROOM "uwroom6", M_GO, "in das Wasser und taucht ab"
                               , "springt"
                               , "springt Dir fast auf den Kopf");
  return 1;
}

int cmd_schwimmen(string str)
{
 tell_object(TP, "Du kannst hier abtauchen oder in das Wasser springen.\n");
 return 1;
}
