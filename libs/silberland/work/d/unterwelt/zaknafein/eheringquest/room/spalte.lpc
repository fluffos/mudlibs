#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer kleinen Spalte" );
  SetProp(P_INT_LONG,
    "Die befindest Dich in einer sehr engen Spalte. Selbst als Frosch "
    "bekommst Du hier langsam Platzangst."
  );

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );

  SetProp(P_NOMAGIC, 100);
  SetProp(P_NO_TPORT, 1);

  AddSpecialDetail( ({"boden"}) , "detail_boden");

  AddDetail( ({ "staub" , "dreck" }) ,
    "Staub und Dreck halt, der sich hier mit der Zeit auf dem Boden "
    "angesammelt hat." );

  AddDetail( ({ "decke" }) ,
    "Eine Decke gibt es hier nicht. Du befindest Dich ja in einer Spalte." );

  AddDetail( ({ "wand" , "waende" , "seiten" }) ,
    "Die Waende werden durch die Steinplatten gebildet." );

  AddDetail( ({ "steinplatten" , "platten" }) ,
    "Mit ihnen wurde der Boden ausgelegt..." );

  AddDetail( ({"spalte"}) ,
    "Du befindest Dich in einer Spalte zwischen zwei Steinplatten.");

  AddDetail( ({"zeit"}) ,
    "Naja, hier kann man auch schlecht putzen, musst Du zugeben.");

  AddDetail( ({ "angst" , "platzangst" }) ,
    "Beruhig Dich wieder. Du kannst ja jederzeit wieder rausspringen.");

  AddDetail( ({"frosch"}) ,
    "Tja, Du bist ein Frosch. Daran musst Du Dich wohl erstmal gewoehnen, "
    "oder?");

  AddDetail( ({"abdruck"}) ,
    "Der Schluessel hat einen Abdruck in dem Staub hinterlassen.");



  AddSmell( ({DEFAULT_SMELL}) ,
    "Es riecht recht muffig und staubig hier.");

  AddSound( ({DEFAULT_SOUND}) ,
    "Hm, es ist absolut still.");

  AddItem( OBJ"eisenschluessel", REFRESH_REMOVE);

  AddCmd(
    "huepf|spring|huepfe|springe&spalte|raus",
    "cmd_huepfen",
    "Woraus moechtest Du huepfen?\n"
  );
}

string detail_boden(string str)
{
  object ob;
  string s;

  if(ob = present(("eisenschluessel"), TO))
  {
    s = "Auf dem staubigem Boden liegt ein Eisenschluessel.";
  }
  else
  {
    s = "Auf dem staubigen Boden erkennst Du den Abdruck eines Schluessels,"
        "den wohl vor kurzem jemand aufgehoben hat. Hm, von aussen muss es "
        "so aussehen, als laege hier ein Gegenstand.";
  }

  return BS(s);
}

int cmd_huepfen(string str)
{
  tell_object(TP, "Du huepfst aus der Spalte heraus.\n");
  TP->move(ROOM "kloake3", M_GO, "aus der Spalte"
                               , "huepft"
                               , "kommt hereingehuepft");

  return 1;
}

int PreventInsert(object ob)
{
  if(query_once_interactive(ob)) return 0;
  if(ob->id("eisenschluessel"))  return 0;

  tell_object(TP, BS("Hier legst Du besser nichts ab. Wer weiss, ob Du "
                     "jemals wieder dran kommst. "));

  return 1;
}
