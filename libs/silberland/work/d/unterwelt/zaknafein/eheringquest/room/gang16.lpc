#include "../def.h"

inherit ROOM "std_gang";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine kleine Kreuzung unterhalb Xatanas Wohnung" );
  SetProp(P_INT_LONG,
    "Du stehst nun auf einer kleinen Kreuzung. In alle Himmelsrichtungen "
    "fuehren schmale Gaenge tiefer in den Dungeon hinein. Der Boden ist "
    "auch hier mit einer dicken Staubschicht bedeckt. "
  );

  AddDetail( ({"kreuzung"}) ,
    "Von hier aus fuehren Gaenge in alle vier Himmelsrichtungen."
  );

  AddDetail( ({ "richtungen" , "himmelsrichtungen" }) ,
    "Hui, hoffentlich verlaeufst Du Dich nicht."
  );

  AddDetail( ({"dungeon"}) ,
    "Du fragst Dich, was Dich hier wohl erwartet."
  );

  AddDetail( ({ "staub" , "staubschicht" , "schicht" }) ,
    "Die Staubschicht ist recht dick. Du glaubst hier Spuren zu erkennen."
  );

  AddDetail( ({ "spur" , "spuren" }) ,
    "Es sind tatsaechlich Spuren. Sie sind nur recht undeutlich. "
    "Wahrscheinlich stammen sie von einem sehr leichten Wesen."
  );

  AddDetail( ({"wesen"}) ,
    "Das Wesen muss wohl recht leicht und flink sein."
  );

  AddExit("norden" , ROOM "gang14");
  AddExit("sueden" , ROOM "gang17");
  AddExit("westen" , ROOM "gang71");
  AddExit("osten"  , ROOM "gang72");
}



