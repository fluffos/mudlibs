#include "../def.h"

inherit ROOM "std_kloake";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du befindest Dich in der Kloake unterhalb von Xatanas Wohnung. Es ist "
    "hier recht duester und unheimlich."
  );

  AddDetail( ({ "waende" , "seiten" , "wand" }) ,
    "Die Waende bestehen aus hartem Felsgestein." );
  AddDetail( ({ "boden" }) ,
    "Auf dem Boden wurden Steinplatten verlegt. Du erkennst Spuren." );
  AddDetail( ({ "waende" }) ,
    "Die Waende bestehen aus hartem Felsgestein.");
  AddDetail( ({ "steinplatten" , "platten" }) ,
    "Du kannst nichts besonderes an den Steinplatten erkennen.");
  AddDetail( ({ "spuren" }) ,
    "Hm, irgendein Wesen hat hier Spuren aus getrocknetem Schlamm "
    "hinterlassen." );
  AddDetail( ({ "schlamm" }) ,
    "Der Schlamm ist schon getrocknet." );
  AddDetail( ({ "wesen" }) ,
    "Um welches Wesen es sich gehandelt hat, kannst Du nicht erkennen. "
    "Die Spuren fuehren zur Horntuer." );
  AddDetail( ({ "material" , "horn" }) ,
    "Horn ist ein weissliches, eher weiches Material.");

  AddSound( ({DEFAULT_SOUND}) ,
    "Hm, es ist absolut still.");

  AddExit("westen" , ROOM "kloake1");

  NewDoor("osten", ROOM "gang11", ({ "tuer" , "horntuer" }),
    ({D_FLAGS, DOOR_NEEDKEY|DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME, "Horntuer"
     ,D_GENDER, FEMALE
     ,D_SHORT, "Im Osten siehst Du eine %se Horntuer."
     ,D_LONG,  "Hm, sie besteht tatsaechlich aus Horn. Seltsam...\n"
     ,D_FUNC, "auto_close"
     ,D_MSGS, ({"durch die Horntuer"
               ,"geht"
               ,"kommt durch die Horntuer herein"
               })
     ,D_OPENMSG, ({"Du oeffnest die Horntuer.",
                   "%s oeffnet die Horntuer.",
                   " schliesst sich."})
     ,D_CLOSEMSG, ({"Du schliesst die Horntuer.",
                    "%s schliesst die Horntuer.",
                    " wird von der anderen Seite geschlossen."})
     ,D_RESET_CLOSEMSG, " faellt zu."
     })
  );
}

void auto_close()
{
  tell_object(TP, "Die Tuer faellt hinter Dir ins Schloss.\n");
  DOOR_MASTER->SetDoorStatus(ROOM "gang11", D_STATUS_LOCKED, TO);
}

