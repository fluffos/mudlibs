#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem dunklen Gang" );
  SetProp(P_INT_LONG,
    "Vorsichtig bewegst Du Dich weiter durch die schmalen, dunklen Gaenge "
    "irgendwo unterhalb Xatanas Hoehle. Die Waende und die Decke scheinen "
    "Dich zu erdruecken. Der Boden ist mit einer dicken Staubschicht "
    "bedeckt."
  );

  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "hoehle" , "xatanas" }) ,
    "In Xatanas Hoehle fuehltest Du Dich wohler."
  );

  AddDetail( ({"boden"}) ,
    "Auf dem Boden wurden Steinplatten verlegt."
  );

  AddDetail( ({ "wand" , "waende" }) ,
    "Die Waende bestehen aus schwarzem Felsgestein. Sie stehen recht "
    "dicht beieinander, sodass Du Dich etwas eingeengt fuehlst."
  );

  AddDetail( ({"decke"}) ,
    "Die Decke haengt sehr niedrig. Sie besteht ebenfalls aus Stein."
  );

  AddDetail( ({ "gestein" , "stein" , "felsgestein" }) ,
    "Harter, schwarzer Stein." );

  AddDetail( ({"besonderes"}) ,
    "Es sind wirklich einfache Steinplatten."
  );

  AddDetail( ({ "staub" , "staubschicht" , "schicht" }) ,
    "Die Staubschicht ist recht dick."
  );

  AddDetail( ({ "gang" , "gaenge" }) ,
    "Die Gaenge wirken sehr trostlos und unheimlich."
  );

  AddDetail( ({ "steinplatten" , "platten" }) ,
    "Es sind einfache Steinplatten. Du kannst nichts Besonderes an ihnen "
    "erkennen."
  );

  AddSmell( DEFAULT_SMELL , "Es riecht hier sehr muffig und staubig.");

  AddSound( DEFAULT_SOUND , "Es ist absolut still.\n");

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist es, den Ring zu finden.\n");
  return 0;
}


