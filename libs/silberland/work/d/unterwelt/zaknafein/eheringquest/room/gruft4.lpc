#include "../def.h"

inherit ROOM "std_gruft";

void create()
{
  ::create();

  long1 = "Du dringst tiefer in Xatanas Familiengruft Xatana ein. ";
  long2 = "Auch hier steht - direkt vor Dir - ein grosser Sarg. ";

  AddDetail( ({ "saergen" , "sarg" }) ,
    "Der Sarg wurde aus weissem Marmor gefertigt. Zwischen den zahlreichen "
    "Verzierungen erkennst Du eine kleine Steinplatte."
  );

  AddDetail( ({ "platte" , "steinplatte" }) ,
    "               _____\n"
    "              |     |\n"
    "              |     |\n"
    "       _______|     |_______\n"
    "      |                     |\n"
    "      |  Semira Dunkelstein |\n"
    "      |_______       _______|\n"
    "              |     |\n"
    "              |     |\n"
    "              |     |\n"
    "              |     |\n"
    "              |     |\n"
    "              |     |\n"
    "              |_____|\n"
  );

  AddDetail( ({"dunkelstein","semira","semira dunkelstein"}) ,
    "Wohl ein Vorfahre von Xatana.");

  AddDetail( ({"vorfahre"}) ,
    "Dieser Vorfahre kannte sich wohl gut in der Physik aus, denkst Du Dir."
  );

  AddDetail( ({"physik"}) ,
    "Physik ist das, was nie gelingt und kaum jemand versteht..."
  );

  AddExit("norden" , ROOM "gruft3");
  AddExit("osten"  , ROOM "gruft1");

  AddItem(NPC "vampir" , REFRESH_REMOVE);
}

