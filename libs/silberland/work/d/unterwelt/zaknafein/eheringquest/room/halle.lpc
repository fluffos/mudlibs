#include "../def.h"

inherit ROOM "std_gang";

int *rad, vc;

void init_rad()
{
  int ok;

  while(!ok)
  {
    rad = ({random(10)
           ,random(10)
           ,random(10)
           ,random(10)
           });

    ok = 1;
    if(rad[0] == 1) ok = 0;
    if(rad[1] == 7) ok = 0;
    if(rad[2] == 4) ok = 0;
    if(rad[3] == 0) ok = 0;

    if(rad[0] == rad[1]) ok = 0;
    if(rad[0] == rad[2]) ok = 0;
    if(rad[0] == rad[3]) ok = 0;

    if(rad[1] == rad[2]) ok = 0;
    if(rad[1] == rad[3]) ok = 0;

    if(rad[2] == rad[3]) ok = 0;
  }
}

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer kleinen Halle" );
  SetProp(P_INT_LONG,
    "Auf Deinem Wege durch die finsteren Gaenge unterhalb Xatanas Hoehle "
    "bist Du nun in eine kleine Halle gelangt. Auch hier ist der Boden mit "
    "einer dicken Staubschicht bedeckt. An der Suedwand erkennst Du eine "
    "kleine Nische."
  );

  AddDetail( ({"xatana"}) ,
    "Hm, der Name sollte Dir doch bekannt vorkommen..." );
  AddDetail( ({"name"}) ,
    "Xatana meine ich.");
  AddDetail( ({ "weg" , "wege" }) ,
    "Dein Weg durch die Gaenge hat Dich nun hierher gefuehrt.");
  AddDetail( ({"halle"}) ,
    QueryProp(P_INT_LONG));
  AddDetail( ({"suedwand"}) ,
    "Dort befindet sich eine kleine Nische." );
  AddDetail( ({"nische"}) ,
    "Als Du die Nische naeher betrachtest, faellt Dir ein Sockel auf, der "
    "in ihr steht." );
  AddDetail( ({"sockel"}) ,
    "An der Oberseite des Sockels sind vier Raeder angebracht." );
  AddDetail( ({"oberseite"}) ,
    "Dort erkennst Du vier Raeder." );
  AddDetail( ({"raeder"}) ,
    "Hm, es sind insgesamt vier Raeder, die in einer Reihe liegen. Jedes "
    "Rad ist mit Zahlen beschriftet." );
  AddDetail( ({"gaenge"}) ,
    "Durch die Gaenge bist Du in diese Halle gelangt." );
  AddSpecialDetail( ({ "zahlen" , "reihe" , "rad" }), "detail_zahlen");

  AddExit("norden" , ROOM "gang08");
  AddExit("westen" , ROOM "gang010");

  AddCmd( ({ "stell" , "stelle", "dreh" , "drehe" }) , "cmd_stellen");

  init_rad();
  vc  = 5;
}

void reset()
{
  ::reset();

  vc = 5;
}

string PrevDigit(int i)
{
  int j;
  i == 0 ? j=9: j = i-1;
  return (string)j;
}

string ThisDigit(int i)
{
  return (string)i;
}

string NextDigit(int i)
{
  int j;
  i == 9? j = 0: j = i+1;
  return (string)j;
}

string detail_zahlen(string str)
{
  string s;

  s  = "   _____      _____      _____      _____ \n";
  s += "  |     |    |     |    |     |    |     |\n";
  s += "  |  "+PrevDigit(rad[0])+
             "  |    |  "+PrevDigit(rad[1])+
                        "  |    |  "+PrevDigit(rad[2])+
                                   "  |    |  "+PrevDigit(rad[3])+
                                              "  |\n";

  s += "  |     |    |     |    |     |    |     |\n";
  s += "  |     |    |     |    |     |    |     |\n";
  s += "--|     |----|     |----|     |----|     |--\n";
  s += "  |  "+ThisDigit(rad[0])+
             "  |    |  "+ThisDigit(rad[1])+
                        "  |    |  "+ThisDigit(rad[2])+
                                   "  |    |  "+ThisDigit(rad[3])+
                                              "  |\n";


  s += "--|     |----|     |----|     |----|     |--\n";
  s += "  |     |    |     |    |     |    |     |\n";
  s += "  |     |    |     |    |     |    |     |\n";
  s += "  |  "+NextDigit(rad[0])+
             "  |    |  "+NextDigit(rad[1])+
                        "  |    |  "+NextDigit(rad[2])+
                                   "  |    |  "+NextDigit(rad[3])+
                                              "  |\n";


  s += "  |_____|    |_____|    |_____|    |_____|\n";

  return s;
}

int cmd_stellen(string str)
{
  int n, num, val;
  object vampir;

  notify_fail("Hm, probiers mal mit 'stelle rad # auf #'.\n" );

  if(!str || str == "") return 0;

  n = sscanf(str, "rad %d auf %d", num, val);

  if(n != 2)
  {
    if(explode(str, " ")[0] == "rad" || explode(str, " ")[0] == "raeder")
    {
      tell_object(TP, "Hm, probiers mal mit 'stelle rad # auf #'.\n");
      return -1;
    }
    return 0;
  }

  if(num < 1 || num > 4)
  {
    tell_object(TP, "Ein solches Rad gibt es nicht.\n");
    return -1;
  }

  if(val < 0 || val > 9)
  {
    tell_object(TP, "Eine solche Ziffer kannst Du nicht einstellen.\n");
    return -1;
  }

  rad[num-1] = val;

  EMASTER->Msg(sprintf("%s stellt das Rad %d auf %d", TPUID, num, val));

  if(rad[0] == 1 && rad[1] == 7 && rad[2] == 4 && rad[3] == 0)
  {
    tell_object(TP, BS("Du hoerst ein leises Klicken. Kurz darauf wird Dir "
                       "ganz schwindelig, so dass Du die Orientierung "
                       "verlierst."));

    TP->move(ROOM "gruft1", M_TPORT , "sich vor Deinen Augen"
                                    , "dematerialisiert"
                                    , "materialisiert sich vor Deinen Augen");

    init_rad();

    return 1;
  }

  if(num == 4 && val != 0 && vc > 0)
  {
    tell_object(TP, "Du hast wohl einen fatalen Fehler gemacht!\n");
    vampir = clone_object(NPC "vampir");
    vampir->move(TO, M_NOCHECK);
    vampir->Kill(TP);
    vc--;
  }
  else
  {
    tell_object(TP, "Du drehst das Rad, aber es passiert nichts.\n");
  }

  return -1;
}

