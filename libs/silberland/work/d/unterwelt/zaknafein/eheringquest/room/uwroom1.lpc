#include "../def.h"
#include "/d/wasser/cirion/water.h"

inherit ROOM "std_unterwasser";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du schwimmst nun in einer gefluteten Roehre unterhalb des "
    "Wasserbassins. Es ist hier recht eng, so dass Du Dich gerade noch "
    "bewegen kannst. Am Boden hat sich eine dicke Schlammschicht "
    "angesammelt. Du kannst hier natuerlich jederzeit auftauchen und so "
    "wieder in den Kaefig gelangen."
  );

  AddDiveExit( "oben" ,   ROOM "kaefig");
  AddWaterExit( "sueden", ROOM "uwroom2");
}

