#include "../def.h"

inherit ROOM "std_kloake";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du befindest Dich in der Kloake unterhalb von Xatanas Wohnung. Es ist "
    "hier recht duester und unheimlich, trotz der Fackeln, die hier an "
    "den Waenden haengen. Westlich von Dir liegt anscheinend eine "
    "Kerkerzelle. Im Sueden erkennst Du einen grossen Kaefig, den Du "
    "durch eine kleine Tuer betreten kannst. Im Sueden befindet sich "
    "eine kleine Tuer. "
  );

  AddDetail( "kaefig"  ,
    "Der grosse Kaefig ist in die Wand eingelassen. Du koenntest ihn "
    "betreten.\n" );

  AddSpecialDetail( ({ "riegel" }), "detail_riegel" );

  AddDetail( ({ "kerkerzelle" , "zelle" , "kerker" }) ,
    "Zum Glueck stehst Du auf der 'richtigen' Seite der Gittertuer... "
    "Die Zelle macht einen sehr duesteren Eindruck." );

  AddDetail( ({ "eindruck" }) ,
    "Vielleicht befindet sich ja jemand im Kerker?" );

  AddDetail( ({ "seite" , "glueck" }) ,
    "Vielleicht aendert sich das bald?" );

  AddDetail( ({ "boden" }) ,
    "Auf dem Boden wurden Steinplatten verlegt. Zwischen den Platten "
    "befinden sich grosse Spalten.");

  AddDetail( ({ "spalten" }) ,
    "Die Platten wurden wohl nicht anstaendig verfugt. Eine Spalte ist "
    "besonders gross...");

  AddDetail( ({ "platten" , "steinplatten" }) ,
    "Es sind einfache Platten aus Stein." );

  AddDetail( ({ "spalte" , "spalte" }) ,
    "Hm, sie ist recht gross. In der Spalte erkennst Du einen Gegenstand.");

  AddDetail( ({ "gegenstand" }) ,
    "Du kannst nicht genau erkennen, worum es sich handelt." );

  AddDetail( ({ "wand" , "waende" , "seiten" , "waenden" }) ,
    "Die Waende bestehen aus hartem Felsgestein." );

  AddDetail( ({ "fackeln" }) ,
    "Die Fackeln erhellen den Raum etwas." );

  AddSound( DEFAULT_SOUND , "Hm, es ist absolut still.\n");

  AddExit("osten" , ROOM "kloake1");

  NewDoor("westen", ROOM "kerker" , ({"tuer","kerkertuer"}) ,
    ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL|DOOR_NEEDKEY
     ,D_NAME,  "Kerkertuer"
     ,D_GENDER, FEMALE
     ,D_SHORT, "Im Westen befindet sich eine %se Kerkertuer."
     ,D_LONG, "Eine schwere Kerkertuer. Was mag sich wichtiges dahinter "
              "verbergen?"
     ,D_MSGS, ({"in den Kerker","geht","kommt herein"})
     ,D_OPENMSG, ({"Du oeffnest die Kerkertuer.",
                   "%s oeffnet die Kerkertuer.",
                   " schliesst sich."})
     ,D_CLOSEMSG, ({"Du schliesst die Kerkertuer.",
                    "%s schliesst die Kerkertuer.",
                    " wird von der anderen Seite geschlossen."})
     ,D_RESET_CLOSEMSG, " faellt ins Schloss."
     })
  );

  NewDoor("kaefig", ROOM "kaefig" , ({"tuer","kaefigtuer"}) ,
    ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME,  "Kaefigtuer"
     ,D_GENDER, FEMALE
     ,D_SHORT, "Eine %se Kaefigtuer."
     ,D_LONG, "Eine schwere Kaefigtuer sorgt dafuer, das nichts entkommen "
              "kann. Mit einem grossen Riegel kann man die Tuer sicherm."
     ,D_MSGS,    ({"den Kaefig","verlaesst","kommt aus dem Kaefig gekrochen"})
     ,D_OPENTESTFUNC, "doortest"
     ,D_OPENMSG, ({"Du oeffnest die Kaefigtuer.",
                   "%s oeffnet die Kaefigtuer.",
                   " schliesst sich."})
     ,D_CLOSEMSG, ({"Du schliesst die Kaefigtuer.",
                    "%s schliesst die Kaefigtuer.",
                    " wird von der anderen Seite geschlossen."})
     ,D_RESET_CLOSEMSG, " faellt ins Schloss."
     })
  );

  AddCmd(
    "huepf|spring|huepfe|springe&spalt|spalte|spalten",
    "cmd_huepfen",
    "Wohin moechtest Du huepfen?\n"
  );

  AddCmd(
    "betrete|betret&kaefig",
    "cmd_betreten",
    "Was moechtest Du betreten?\n"
  );

  AddCmd(
    "greif|greife|nimm|nehm|nehme&gegenstand",
    "cmd_nehmen",
    "Was moechtest Du nehmen?"
  );

  AddCmd( ({ "schieb" , "schiebe" })  , "cmd_schieben" );
}

void SetThisDoor(int dstatus)
{
  DOOR_MASTER->SetDoorStatus(ROOM "kaefig",dstatus,TO);
}

int QueryThisDoor()
{
  return DOOR_MASTER->QueryDoorStatus(ROOM "kaefig",TO);
}

int doortest()
{
  return ROOM "kaefig"->doortest();
}

string detail_riegel(string str)
{
  return ROOM "kaefig"->detail_riegel(str);
}

int cmd_schieben(string str)
{
  return ROOM "kaefig"->cmd_schieben(str);
}

int cmd_betreten(string str)
{
  if(QueryThisDoor() == D_STATUS_CLOSED)
  {
    tell_object(TP, "Die Kaefigtuer ist aber noch verschlossen!\n");
    return -1;
  }

  TP->move(ROOM "kaefig", M_GO , "todesmutig den Kaefig"
                               , "betritt"
                               , "kommt in den Kaefig");
  return 1;
}

int cmd_huepfen(string str)
{
  if(TP->QueryProp(P_FROG))
  {
    tell_object(TP, "Du huepfst in den Spalt hinein.\n");
    TP->move(ROOM "spalte", M_GO, "ausser Sicht"
                                , "huepft"
                                , "kommt in die Spalte gesprungen");
    return 1;
  }

  tell_object(TP, "Du bist zu gross fuer die Spalte.\n");
  return 1;
}

int cmd_nehmen(string str)
{
  string s;

  if(TP->QueryProp(P_FROG))
  {
    s = "Du streckst Deine glibschigen Froschpfoten nach dem Gegenstand "
        "aus. Er ist jedoch zu weit entfernt, als das Du ihn so erreichen "
        "koenntest. Aber als Frosch findest Du doch bestimmt einen "
        "anderen Weg...";
  }
  else
  {
    s = "Hm, den Gegenstand bekommst Du so bestimmt nicht. Er liegt zu "
        "tief unten in der Spalte. Als Frosch haettest Du hier bestimmt "
        "mehr Chancen...\n";
  }

  tell_object(TP, BS(s));
  return 1;
}

