#include "../def.h"
#include "/d/wasser/cirion/water.h"

inherit (WROOM+"/wroom");

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer gefluteten Roehre" );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_WATER:5]));

  AddDetail( ({"wasser"}) ,
    "Das Wasser ist recht klar. Wirbel bloss keinen Schlamm auf."
  );

  AddDetail( ({ "wasserbassin" , "bassin" }) ,
    "Du befindest Dich unterhalb des Wasserbassins."
  );

  AddDetail( ({ "boden" }) ,
    "Am Boden erkennst Du eine dicke Schlammschicht."
  );

  AddDetail( ({ "waende" , "wand" }) ,
    "An den runden, glatten Waenden der Roehre kannst Du nichts "
    "Besonderes erkennen."
  );

  AddDetail( ({ "decke" }) ,
    "Eine Decke gibt es hier nicht. Du kannst hier auftauchen."
  );

  AddDetail( ({ "roehre" }) ,
    "Hier in der Roehre ist es recht eng. Sie erlaubt es Dir aber, hier "
    "zu schwimmen."
  );

  AddDetail( ({ "schlamm" , "schlammschicht" , "schicht" }) ,
    "Mit der Zeit hat sich hier auf dem Boden der Roehre Sand abgesetzt "
    "und eine schleimige Schlammschicht gebildet."
  );

  AddDetail( ({ "zeit" , "Zeit" }) ,
    "Es sieht so aus, als waere die Roehre schon recht alt."
  );

  AddDetail( ({ "sand" , "Sand" }) ,
    "Es handelt sich um sehr feinen Sand."
  );

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );
}

int aufgabe(string str)
{
  notify_fail("Deine Aufgabe ist es, den Ring zu finden.\n");
  return 0;
}

int cmd_tauchen(string str)
{
  tell_object(TP, "Du kannst hier nicht auftauchen.\n");
  return 1;
}



