#include "../def.h"

inherit ROOM "std_kloake";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du musst Dich fast uebergeben, da Du bis zum Hals in zaehem Schlamm "
    "steckst. Du moechtest so schnell wie moeglich raus hier."
  );

  AddDetail( "schlamm"  ,
    "Wuahhhh! Der stinkt aber wirklich und sieht ziemlich ekelig aus." );
  AddDetail( "hals" ,
    "Du solltest hier wohl eher nicht huepfen oder springen...");
  AddDetail( "boden" ,
    "Der Boden ist mit braeunlichem Schlamm bedeckt.");
  AddDetail( ({ "decke" }) ,
    "Die Decke haengt sehr niedrig. Sie besteht ebenfalls aus Stein."
    "An der Decke erkennst Du das Ende eines Rohres.");
  AddDetail( "nase" ,
    "Die haeltst Du Dir gerade zu.");
  AddDetail( ({ "wand" , "waende" }),
    "Die Waende sind mit Schlamm besudelt.");
  AddDetail( "wasser" ,
    "Ein wenig Wasser tropft noch vom unteren Ende des Rohres in den "
    "Schlamm.");
  AddDetail( ({ "rohres" , "rohr" , "ende" }) ,
    "Durch dieses Rohr bist Du in die Kloake gelangt.");

  AddSound( ({DEFAULT_SOUND}) ,
    "Du hoerst das Tropfen von Wasser.");
  AddSound( ({"tropfen"}) ,
    "plitsch, platsch...");

  AddCmd(
    "huepf|spring|huepfe|springe",
    "cmd_huepfen",
    "");

  AddCmd(
    "wuehle|wuehl|durchwuehl|durchwuehle|durchsuche|suche",
    "cmd_wuehlen",
    ""
  );

  AddExit(({"sueden", "suedoben"}) ,  ROOM "kloake1");

  AddProp(P_HIDE_EXITS, ({"sueden"}) );
}

int cmd_wuehlen(string str)
{
  tell_object(TP, BS("Suchen macht hier eh keinen Sinn. Und ausserdem: Wer "
                     "bis zum Hals in Sch***** steckt, sollte keine "
                     "Wellen machen!"));

  return 1;
}

int cmd_huepfen(string str)
{
  tell_object(TP, BS("Du huepfst wild im Schlamm herum, bis Du voellig "
                     "besudelt bist."));

  tell_room(TO, BS(CTPN+" huepft wild herum und bespritzt Dich mit "
                   "Schlamm. Die Sau!"));

  return 1;
}

