#include "../def.h"

inherit ROOM "std_gang";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Der Gang, in den Du nun gelangt bist, gleicht den anderen sehr. Nur "
    "erkennst Du hier an der Ostwand einen grossen, massiven Steinblock."
  );

  AddDetail( "mitte" ,
    "In der Mitte des Steinblocks befindet sich eine Mulde.\n" );

  AddDetail( ({ "ostwand" , "wand" }) ,
    "Einen sehr grossen Steinblock siehst Du dort."
  );

  AddDetail("mulde",
    "            _                \n"
   +"         __| |__             \n"
   +"       _|       |_           \n"
   +"      |_   -|-   _|          \n"
   +"        |__   __|            \n"
   +"           |_|               \n");

  AddExit("westen" , ROOM "gang45");
  AddExit("norden" , ROOM "gang47");
  AddExit("sueden" , ROOM "gang48");

  NewDoor("osten", ROOM "gang01" , ({"block", "steinblock"}) ,
    ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME,  "Steinblock"
     ,D_GENDER, MALE
     ,D_SHORT, "Ein massiver Steinblock."
     ,D_LONG, "Ein massiver Steinblock, den wohl selbst der staerkste "
              "Troll nicht bewegen koennte, versperrt den Weg nach "
              "Osten. Er besteht aus grauem Stein und sieht ziemlich "
              "massiv aus. In der Mitte erkennst Du eine Mulde."
     ,D_MSGS,    ({"nach Osten","geht","kommt herein"})
     ,D_OPENTESTFUNC, "doortest"
     ,D_OPENMSG, ({"Du schiebst den Steinblock beiseite.",
                   "%s schiebt den Steinblock beiseite.",
                   " gleitet zur Seite."})
     ,D_CLOSEMSG, ({"Du verschliesst den Durchgang.",
                    "%s schliesst den Durchgang.",
                    " wird zur Seite geschoben."})
     ,D_RESET_CLOSEMSG, " verschliesst den Durchgang wieder."
     ,D_FUNC2, "door_close"
     })
  );

  AddCmd(
    "lege|stecke|leg|steck&symbol&mulde",
    "cmd_legen",
    "Was moechtest Du wohin legen?\n|Was moechtest Du wohin legen?\n"
  );
}

int doortest()
{
  tell_object(TP, BS("Du versuchst den Steinblock beiseite zu schieben, "
                     "aber der ist viel zu schwer. "));
  return 1;
}

void SetThisDoor(int dstatus)
{
  DOOR_MASTER->SetDoorStatus(ROOM "gang01",dstatus,TO);
}

int QueryThisDoor()
{
  return DOOR_MASTER->QueryDoorStatus(ROOM "gang01",TO);
}

void door_close()
{
  tell_object(TP, BS("Mit einem lauten Grummeln schiebt sich der "
                     "Steinblock wieder vor den Gang und versperrt Dir so "
                     "den Rueckweg"));

  SetThisDoor(D_STATUS_CLOSED);
}

int cmd_legen(string str)
{
  object ob;

  if(!present("symbol", TP))
  {
    notify_fail("Du hast doch gar kein Symbol bei Dir!\n");
    return 0;
  }

  if(!(ob=present("\nzaksymbol", TP)))
  {
    notify_fail("Hmm, das Symbol passt nicht!\n");
    return 0;
  }

  EMASTER->SetBoulder(TPUUID);
  EMASTER->Msg(TPUID+" legt das Symbol in die Mulde");

  tell_object(TP, BS("Mit einem lauten Grummeln verschiebt sich der "
                     "Steinblock und gibt so den Weg nach Osten frei. "
                     "Das Symbol nimmst Du wieder an Dich.\n"));

  tell_room(TO, CTPN+" steckt etwas in die Mulde.\n", ({ TP }));

  SetThisDoor(D_STATUS_OPEN);
  return 1;

}

