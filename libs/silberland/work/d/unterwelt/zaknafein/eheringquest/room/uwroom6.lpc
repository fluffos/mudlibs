#include "../def.h"
#include "/d/wasser/cirion/water.h"

inherit ROOM "std_unterwasser";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du bist nun in einen anderen Abschnitt der gefluteten Roehre gelangt. "
    "Die Roehre ist durch ein Gitter abgesperrt. An einer Wand erkennst "
    "Du einen kleinen Knopf. "
  );

  AddDetail( "knopf" ,
    "Der Knopf ist gut sichtbar neben dem Gitter angebracht."
  );

  AddDetail( ({ "abschnitt" }) ,
    "Dieser Abschnitt der Roehre gleicht all den anderen."
  );

  AddSpecialDetail( ({"gitter"}), "detail_gitter");

  AddCmd(
    "drueck|druecke&knopf",
    "cmd_druecken",
    "Was moechtest Du druecken?\n"
  );

  AddDiveExit("oben", ROOM "grotte");
}

string detail_gitter(string str)
{
  return ROOM "uwroom5"->GetDetail("gitter");
}

cmd_druecken(string str)
{
  EMASTER->Msg(TPUID+" drueckt auf den Knopf fuer das Unterwassergitter");

  if(ROOM "uwroom5"->QueryFenceClosed())
  {
    tell_object(TP, "Du drueckst den Knopf und das Gitter hebt sich.\n");
    tell_room(TO, "Das Gitter hebt sich.\n", ({ TP }) );
    tell_room(ROOM "uwroom5", "Das Gitter hebt sich.\n" );
    ROOM "uwroom5"->OpenFence();
  }
  else
  {
    tell_object(TP, "Du drueckst den Knopf und das Gitter senkt sich.\n");
    tell_room(TO, "Das Gitter senkt sich.\n", ({ TP }) );
    tell_room(ROOM "uwroom5", "Das Gitter senkt sich.\n" );
    ROOM "uwroom5"->CloseFence();
  }

  return 1;
}


