#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Sarg" );
  SetProp(P_INT_LONG,
    "Du liegst nun in einem grossen Sarg, der Dir viel Platz bietet. "
    "Trotzdem ueberkommt Dich ein ungutes Gefuehl bei dem Gedanken, in "
    "einem Sarg zu liegen."
  );

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({ "gefuehl" , "gedanken" }) ,
    "Ein kalter Schauer laeuft Dir ueber den Ruecken." );
  AddDetail( ({ "schauer" , "ruecken" }) ,
    "Wuahhh! Schnell raus hier!");
  AddDetail( ({ "platz" }) ,
    "Fuer einen Sarg recht geraeumig hier!" );
  AddDetail( ({ "wand" , "boden" , "waende" }) ,
    "Boden und Waende bestehen aus Marmor. " );
  AddDetail( ({ "decke" , "Decke" }) ,
    "Du erkennst den Sargdeckel." );
  AddDetail( ({ "sargdeckel" , "deckel" }) ,
    "Der Sargdeckel besteht aus Marmor." );
  AddDetail( ({ "marmor" , }) ,
    "Es handelt sich um weissen Marmor." );
  AddDetail( ({ "sarg" }) ,
    "Du liegst in ihm." );

  AddSmell( DEFAULT_SMELL ,
    "Du kannst keine Gerueche ausmachen.");

  AddSmell( ({"gerueche"}) ,
    "Du kannst wirklich keine Gerueche ausmachen.");

  AddSound( DEFAULT_SOUND ,
    "Stille.");

  NewDoor("raus", ROOM "gruft3" , ({"sarg"}) ,
    ({D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL
     ,D_NAME,  "Sarg"
     ,D_GENDER, MALE
     ,D_SHORT, "Ein Marmorsarg."
     ,D_LONG, "Du liegst darin. Ist Deine Zeit schon gekommen?"
     ,D_MSGS,    ({"heraus"
                  ,"klettert"
                  ,"klettert aus dem Sarg"
                  })
     ,D_OPENMSG, ({"Du oeffnest den Sarg."
                  ,"%s oeffnet den Sarg."
                  ," wird geoeffnet."
                  })
     ,D_CLOSEMSG, ({"Du schliesst den Sarg."
                   ,"%s schliesst den Sarg."
                   ," wird geschlossen."
                   })
     ,D_RESET_CLOSEMSG, " schliesst sich wie von Geisterhand. Gruselig!"
     })
  );
}

