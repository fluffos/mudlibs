#include "../def.h"

inherit ROOM "std_gang";

string *pl;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Am Ende eines dunklen Ganges" );
  SetProp(P_INT_LONG,
    "Der Gang endet hier in einer Sackgasse. Direkt vor der Suedwand steht "
    "eine hoelzerne Truhe auf dem Boden."
  );

  AddDetail( ({ "gasse" , "sackgasse" }) ,
    "Ja, der Gang endet hier."
  );

  AddDetail( ({ "Suedwand" , "suedwand" }) ,
    "Die Suedwand ist von Ritzen und Spalten durchzogen."
  );

  AddDetail( ({ "ritzen" , "Ritzen" }) ,
    "Die Ritzen durchziehen die gesamte Suedwand. Es sieht recht merk"
    "wuerdig und gewollt aus."
  );

  AddDetail( ({ "spalten" , "Spalten" }) ,
    "Wegen der vielen Spalten und Ritzen kannst Du kaum Einzelheiten "
    "erkennen."
  );

  AddDetail( ({ "einzelheiten" , "Einzelheiten" }) ,
    "Du schaust Dir die Spalten nun sehr genau an. Nun faellt Dir an einer "
    "Spalte etwas auf."
  );

  AddDetail( ({ "spalte" , "Spalte" }) ,
    "Hm, da ist ein Loch."
  );

  AddSpecialDetail( ({ "loch" })                   , "detail_loch");
  AddSpecialDetail( ({ "pfeilspitze" , "spitze" }) , "detail_spitze");
  AddSpecialDetail( ({ "truhe" })                  , "detail_truhe");
  AddSpecialDetail( ({ "schloss" })                , "detail_schloss");
  AddSpecialDetail( ({ "gegenstand"})              , "detail_gegenstand");

  AddDetail( ({ "eindruck" }) ,
    "Die Truhe wirkt dennoch recht stabil."
  );

  AddDetail( ({ "ewigkeit" }) ,
    "Also sehr, sehr lange."
  );

  AddDetail( ({ "gang" }) ,
    "Hier fuehrte der Gang in eine Sackgasse."
  );

  AddDetail( ({ "metallstreben" , "streben" }) ,
    "Die Metallstreben sind voellig verrostet. "
  );

  AddDetail( ({ "holz" }) ,
    "Es handelt sich um sehr hartes Holz, so dass Du die Truhe wohl nicht "
    "einfach zertruemmern kannst, obwohl das Holz schon wurmstichig ist."
  );

  AddSpecialDetail( ({"falle"}) , "detail_falle" );

  AddExit("nordosten" , ROOM "gang77");

  AddCmd(
    "nehm|nehme|nimm&gegenstand",
    "cmd_nehmen",
    "Was moechtest Du nehmen?\n"
  );

  AddCmd(
    "brich|breche|brech|"
    "zerbrich|zerbrech|zerbreche|"
    "zerstoer|zerstoere|"
    "zerschlage|zerschlag|"
    "tret|trete|tritt&schloss",
    "cmd_brechen",
    "Was moechtest Du aufbrechen?\n"
  );

  AddCmd(
    "stecke|steck&holzstock|stock&loch",
    "cmd_stecken",
    "Was moechtest Du wohinein stecken?\n|"
    "Was moechtest Du wohinein stecken?\n"
  );

  AddCmd(
    "entschaerf|entschaerfe&falle",
    "cmd_entschaerfen",
    "Was moechtest Du entschaerfen?\n"
  );

  AddCmd( ({"oeffne"})      , "cmd_oeffnen");

  pl = ({ });
}

void reset()
{
  ::reset();

  pl = ({ });
}

int cmd_brechen(string str)
{
  if(!EMASTER->QueryChestLocked(TPUUID))
  {
    tell_object(TP, "Das Schloss ist doch schon zerbrochen!\n");
    return -1;
  }

  if(EMASTER->SetChestUnlocked(TPUUID))
  {
    tell_object(TP, BS("Du trittst kraeftig gegen das Schloss, so dass "
                       "es zerbricht."));
    EMASTER->Msg(TPUID+" zerbricht das Schloss");

    return 1;
  }

  tell_object(TP, BS("Du versuchst das Schloss zu zerbechen, doch irgendwie "
                     "will es Dir nicht gelingen."));
  return -1;
}

int cmd_oeffnen(string str)
{
  notify_fail("Was moechtest Du oeffnen?\n");

  if(!str || str == "") return 0;

  if(str == "truhe")
  {
    if(EMASTER->QueryChestOpened(TPUUID))
    {
      tell_object(TP, "Die Truhe ist doch schon geoeffnet.\n");
      return -1;
    }

    if(EMASTER->QueryTrapActive(TPUUID))
    {
      SetProp(P_KILL_NAME, "Ein Pfeil" );
      tell_object(TP, BS("Als Du versuchst, die Truhe zu oeffnen, schiesst "
                         "ploetzlich ein Pfeil aus einem kleinen Loch in der "
                         "Suedwand und trifft Dich sehr stark."));
      TP->do_damage(20+random(10));
      return -1;
    }

    if(EMASTER->QueryChestLocked(TPUUID))
    {
      tell_object(TP, BS("Das Schloss verhindert wirkungsvoll, dass Du die "
                         "Truhe oeffnen kannst."));
      return -1;
    }

    if(EMASTER->SetChestOpen(TPUUID))
    {
      tell_object(TP, "Du oeffnest die Truhe mit einem lauten Quietschen.\n");
      return 1;
    }

    tell_object(TP, BS("Du oeffnest die Truhe, aber der Deckel gleitet Dir "
                       "aus den Haenden und knallt wieder zu.\n"));
    return -1;
  }

  if(str == "schloss")
  {
    if(EMASTER->QueryChestLocked(TPUUID))
    {
      tell_object(TP, BS("Dazu brauchst Du einen passenden Schluessel, den Du "
                         "nicht hast."));
    }
    else
    {
      tell_object(TP, BS("Das Schloss ist zerbrochen. Man koennte es daher "
                         "durchaus als offen bezeichnen."));
    }

    return 1;
  }

  return 0;
}

int cmd_nehmen(string str)
{
  object ob;

  if(!EMASTER->QueryChestOpened(TPUUID)) return 0;

  if(member(pl, TPUUID) == -1)
  {
    ob = clone_object(OBJ "symbol");
    if(ob->move(TP, M_GET) == 1)
    {
      tell_object(TP, "Du nimmst den Gegenstand. Es handelt sich um ein "
                      "kleines Steinsymbol.\n");
      pl += ({ TPUUID });

      EMASTER->Msg(TPUID+" nimmt das Steinsymbol");
    }
    else
    {
      tell_object(TP, "Du kannst den Gegenstand nicht mehr tragen.\n ");
    }
  }
  else
  {
    tell_object(TP, "Die Truhe ist leer.\n");
  }

  return 1;
}

int cmd_stecken(string str)
{
  object ob;

  if(!EMASTER->QueryTrapActive(TPUUID))
  {
    tell_object(TP, "Das Loch ist bereits durch ein Holzstueck verstopft.\n");
    return -1;
  }

  ob = present("holzstock", TP);

  if(!ob)
  {
    tell_object(TP, BS("Dazu brauchst Du ein geeignetes Holzstueck oder "
                       "einen Holzstock." ));
    return -1;
  }

  if(EMASTER->SetTrapInactive(TPUUID))
  {
    ob->remove();
    tell_object(TP, BS("Du steckst den Holzstock in das Loch, um die Falle "
                       "zu entschaerfen. Dabei zerbrichst Du den Stock. "
                       "Naja, egal, ein Stuck Holz ist in dem Loch "
                       "geblieben und blockiert dieses."));

    tell_room(TO, CTPN+" macht irgendetwas an der Suedwand.", ({TP}) );

    EMASTER->Msg(TPUID+" blockiert die Falle");
    return 1;
  }

  tell_object(TP, BS("Irgendwie bringst Du es nicht zurande, den Stock "
                     "in das Loch zu stecken."));
  return -1;
}

int cmd_entschaerfen(string str)
{
  tell_object(TP, "Gute Idee! Blos wie?\n");
  TP->command_me("gruebel");

  return 1;
}


string detail_falle(string str)
{
  string s;

  if(EMASTER->QueryTrapActive(TPUUID))
  {
    s = "Vielleicht solltest Du sie lieber entschaerfen. Hm, du koenntest "
        "etwas in das Loch stecken.";
  }
  else
  {
    s = "Die Falle wurde entschaerft. Sehr gut!";
  }

  return BS(s);
}

string detail_loch(string str)
{
  string s;

  if(EMASTER->QueryTrapActive(TPUUID))
  {
    s = "Das Loch ist recht klein. Es faellt kaum auf. Als Du in das Loch "
        "blickst, erkennst Du eine kleine Pfeilspitze.";
  }
  else
  {
    s = "Das Loch ist mit einem kleinen Stueck Holz verstopft.";
  }

  return BS(s);
}

string detail_spitze(string str)
{
  string s;

  if(EMASTER->QueryTrapActive(TPUUID))
  {
    s = "Die Pfeilspitze befindet sich sehr tief im Loch und zeigt direkt "
        "auf Dich. Hm, vielleicht handelt es sich um eine Falle.";
  }
  else
  {
    s = "Das Loch ist durch ein Stueck Holz verstopft. Man grade aber noch "
        "eine Pfeilspitze dahinter erkennen. Naja, das Holzstueck sollte "
        "die PFeilspitze blockieren. ";
  }

  return BS(s);
}

string detail_truhe(string str)
{
  string s;

  if(EMASTER->QueryChestLocked(TPUUID))
  {
    return BS("Die Truhe macht den Eindruck, als stuende sie schon eine "
              "Ewigkeit hier. Das Holz ist schon wurmstichig und das "
              "Schloss und die Metallstreben, mit denen die Truhe "
              "verstaerkt wurde, sind voellig verrostet.");
  }

  if(EMASTER->QueryChestOpened(TPUUID))
  {
    if(member(pl, TPUUID) == -1)
    {
      return BS("Die Truhe macht den Eindruck, als stuende sie schon eine "
                "Ewigkeit hier. Das Holz ist schon wurmstichig, die "
                "Metallstreben, mit denen die Truhe verstaerkt wurde, sind "
                "voellig verrostet und das Schloss ist zerbrochen. "
                "Der Deckel der Truhe wurde geoeffnet, in der Truhe liegt "
                "ein Gegenstand.");
    }
    else
    {
      return BS("Die Truhe macht den Eindruck, als stuende sie schon eine "
                "Ewigkeit hier. Das Holz ist schon wurmstichig, die "
                "Metallstreben, mit denen die Truhe verstaerkt wurde, sind "
                "voellig verrostet und das Schloss ist zerbrochen. "
                "Der Deckel der Truhe wurde geoeffnet, die Truhe ist "
                "allerdings leer.");
    }
  }

  return BS("Die Truhe macht den Eindruck, als stuende sie schon eine "
            "Ewigkeit hier. Das Holz ist schon wurmstichig, die "
            "Metallstreben, mit denen die Truhe verstaerkt wurde, sind "
            "voellig verrostet und das Schloss ist zerbrochen. ");
}

string detail_schloss(string str)
{
  string s;

  if(EMASTER->QueryChestlocked(TPUUID))
  {
    s = "Das Schloss ist vollstaendig verrostet. Es scheint nicht sehr "
        "stabil zu sein... Vielleicht hilft da ja ein wenig Gewalt?";
  }
  else
  {
    s = "Das Schloss ist zerbrochen.";
  }

  return BS(s);
}

string detail_gegenstand(string str)
{
  string s;

  if(EMASTER->QueryChestOpened(TPUUID) &&
     (member(pl, TPUUID) == -1)         )
  {
    s = "Du kannst ihn nehmen.\n";
  }
  else
  {
    s = "Sowas siehst Du hier nicht.\n";
  }

  return BS(s);
}


