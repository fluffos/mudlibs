#include "../def.h"

inherit NPC "std_ringnpc";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein riesiges Ungetuem");

  SetProp(P_NAME, "Ungetuem");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_MSGIN, "kommt an und legt sich schlafen");
  SetProp(P_MSGOUT, "zieht sich verletzt zurueck");

  AddId( ({ "ungetuem" , "tier" , "\nzaktier"}) );
  AddClass(CL_ANIMAL); // siehe /sys/class.h

  SetProp(P_NAME_ADJ, ({"riesig"}) );
  AddAdjective( ({"riesigen","riesiger","riesigem","riesiges","riesige"}) );

  create_default_npc( 35 );
  SetProp(P_SIZE, 310);
  SetProp(P_RACE, "tier");
  SetProp(P_ALIGN, -600);
  SetProp(P_BODY, 300);
  SetProp(P_HANDS, ({" mit seinen langen Zaehnen und moerderischen Klauen", 300, DT_RIP }));
  SetProp(P_RACE, "Monster");
  SetProp(P_SLEEP, 1);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.5, DT_COLD:      -0.5, DT_WATER:   -0.2, DT_AIR:    -0.2,
      DT_LIGHTNING: 0.5, DT_EXPLOSION: 0.5, DT_SOUND:   0.1, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.1, DT_ACID:      -0.2, DT_POISON: -0.2, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_SPELLRATE,30);

  AddSpell(1,500,
    "Das Ungetuem schlaegt Dir fast den Kopf ab.\n",
    "Das Ungetuem reisst @WER fast den Kopf ab.\n",
    DT_RIP,([SP_SHOW_DAMAGE:1])
  );

  AddSpell(2,350,
    "Das Ungetuem bohrt Dir seine Klauen in die Brust.\n",
    "Das Ungetuem bohrt @WEM seine Klauen in die Brust.\n",
    DT_RIP,([SP_SHOW_DAMAGE:1])
  );

  SetProp(P_WIMPY, 0);
  SetProp(P_DIE_MSG, " faellt mit einem lautem Krachen zu Boden.\n" );

  SetProp(P_MURDER_MSG, "Wuahhhhh! Ich komme wieder, %s !");
  SetProp(P_KILL_NAME, "Ein riesiges Ungetuem");
  SetProp(P_KILL_MSG, "Hmmmm, Abenteurer sind aber lecker!");

  AddDetail( ({ "fell" , "Fell" }) ,
    "Das Fell ist recht dicht, was das Tier wohl sehr widerstandsfaehig "
    "macht."
  );

  AddDetail( ({ "maul" , "Maul" }) ,
    "Im Maul des Tieres erkennst Du scharfe Zaehne."
  );

  AddDetail( ({ "klauen" , "zaehne" }) ,
    "Sie sind scharf wie Schwerter."
  );

  AddDetail( ({ "schwerter" , "Schwerter" }) ,
    "Mit seinen Zaehnen und Klauen koennte Dir das Tier toedliche Wunden "
    "beibringen."
  );

  AddDetail( ({ "wunden" , "Wunden" }) ,
    "TOEDLICHE Wunden!"
  );

  AddCmd(({"weck","wecke","reize","reiz" }) , "cmd_wecken");
}

void reset()
{
  ::reset();

  if(!is_clone(TO)) return;

  if(sizeof(QueryEnemies()[0]) == 0)
  {
    if(ENV(TO) && (QueryProp(P_SLEEP) == 0))
    {
      tell_room(ENV(TO), "Das Ungetuem legt sich wieder schlafen.\n");
    }
    SetProp(P_SLEEP, 1);
  }
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(QueryProp(P_SLEEP))
  {
    enemy->StopHuntFor(TO,1);
    StopHuntFor(enemy,1);

    tell_object(enemy,BS("Aber das Ungetuem schlaeft doch! Weck das "
                         "Ungetuem erst auf, wenn Du wirklich sterben "
                         "willst."));
    return 0;
  }

  return ::Defend(dam, dam_type, spell, enemy);
}

string _query_long()
{
  string s;

  s = "Das Tier ist mit einem dichten Fell bewachsen. Aus seinem grossen "
      "Maul blitzen Dir extrem scharfe Zaehne entgegen. Seine Klauen sind "
      "so scharf wie Schwerter. Es sieht so aus, als sei das Tier ueberaus "
      "gefaehrlich. ";

  if(QueryProp(P_SLEEP))
  {
    s += "Du solltest es besser nicht wecken.";
  }

  return BS(s);
}

int cmd_wecken(string str)
{
  notify_fail("Wen moechtest Du wecken?\n");

  if(!str || str == "") return 0;
  if(!(str == "tier"                   ||
       str == "ungetuem"               ||
       str == "tier trotz warnung"     ||
       str == "ungetuem trotz warnung" )) return 0;

  if(!QueryProp(P_SLEEP))
  {
    tell_object(TP, "Das Ungeheuer ist schon laengst wach!\n");
    return -1;
  }

  if(str == "tier" || str == "ungetuem")
  {
    tell_object(TP, BS("Fassen wir mal zusammen: Du stehst vor einem "
                       "riesigen Ungetuem, das gluecklicherweise gerade "
                       "schlaeft und Deine einzige Sorge ist es, es "
                       "irgendwie zu wecken. *g* Naja, wenn Du es wirklich "
                       "wecken willst, so tippe lieber \"wecke tier trotz "
                       "warnung\" und bestelle Lars schoene Gruesse von "
                       "mir."));
    return -1;
  }

  if(!(str == "tier trotz warnung"     ||
       str == "ungetuem trotz warnung" )) return 0;

  if(TP->QueryProp(P_LEVEL) < 25)
  {
    tell_object(TP, BS("Du traust Dich nicht, das Tier zu wecken. Aber Du "
                       "entschliesst Dich, es spaeter noch einmal zu "
                       "versuchen."));
    return -1;
  }

  SetProp(P_SLEEP, 0);

  tell_object(TP, BS("Du trittst dem Tier kraeftig in den Hintern, um es "
                     "zu wecken."));

  tell_room(ENV(TP), CTPN+" weckt todesmutig das Tier. Oh, je...\n", ({TP}) );

  EMASTER->Msg(TPUID+" greift das Ungetuem an.");
  Kill(TP);

  return 1;
}


