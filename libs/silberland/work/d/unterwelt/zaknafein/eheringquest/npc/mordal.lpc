#include "../def.h"

inherit STDDARKELF;

inherit "std/npc/spells";

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Mordal");
  SetProp(P_LONG,
    "Vor dir steht Xatanas Sohn Mordal. Er ist eine Schande fuer alle "
    "Dunkelelfen, da er hunderte Dunkelelfen toetete, um an deren Geld und "
    "Ausruestung zu kommen. Bei den Druiden hat er schon Gildenstufe 16 "
    "erreicht und ist deshalb entsprechend maechtig."
  );

  SetProp(P_NAME, "Mordal");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);

  create_default_darkelf(30, 30);

  SetProp(P_ALIGN, -1000);
  SetProp(P_SIZE, 210);
  SetProp(P_HANDS, ({" mit elementaren Maechten", 250, DT_MAGIC}) );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:   0.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.2, DT_EXPLOSION: 0.2, DT_SOUND:   0.0, DT_LIGHT:  0.2,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: -0.2, DT_TERROR: 0.0,
      DT_HOLY:      0.2, DT_UNHOLY:    0.0, DT_MAGIC:  -0.2 ]) );

  SetProp(P_WIMPY, 0);
  SetProp(P_REJECT,
    ({REJECT_DROP, "Mordal sagt: Das kann ich nicht gebrauchen.\n"}) );

  set_living_name("mordal");

  AddId( ({ "\nzakmordal" , "mordal" , "druide" , "NOWIMPY", "\nEHERINGNPC"}) );

  seteuid(getuid(this_object()));

  CLONEME(ZARMOUR "chitinhose");
  CLONEME(ZARMOUR "chitinarmschienen");
  CLONEME(ZARMOUR "spinnenpanzer");
  CLONEME(ZARMOUR "chitinguertel");

  command("ziehe alles an");

  SetProp(P_SPELLRATE,80);
  SetProp(P_NOMAGIC, 10);
/*
  AddDefaultSpell(1, 300, DS_PARALYZE,
    "Mordal tritt dir kraeftig ins Gesicht! Du verlierst die Besinnung...\n",
    "Mordal tritt @WEM kraeftig ins Gesicht! @WER faellt besinnungslos zu Boden... \n");

  AddDefaultSpell(1,100,DS_FEAR,
    "Mordal rammt dich, sodass du aus dem Raum fliegst!\n",
    "Mordal rammt @WEN, sodass @WER aus dem Raum fliegt!\n");

  AddSpell(4,350,
    "Mordal wirft einen Froststrahl auf dich.\n",
    "Mordal wirft einen Froststrahl auf @WEN.\n",
    DT_COLD,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,350,
    "Mordal wirft einen Feuerball auf dich.\n",
    "Mordal wirft einen Feuerball auf @WEN.\n",
    DT_FIRE,([SP_SHOW_DAMAGE:1]));
*/
  SetProp( P_DIE_MSG, " faellt tot zu Boden.\n" );
  SetProp(P_DEFAULT_INFO,"fragt dich: Was meinst du genau?\n");

  AddInfo( ({ "zaknafein" , "zak" }) ,
    "Zaknafein ist mein Vater!"
    ,"Mordal sagt: "
  );

  AddInfo( ({"xatana"}) ,
    "Xatana ist meine Mutter!"
    ,"Mordal sagt: "
  );

  AddInfo( ({ "druide" , "druiden" }) ,
    "Ich habe bei den Druiden schon Gildenstufe 16 erreicht!"
    ,"Mordal sagt stolz: "
  );

  AddDetail("schande",
    "Lies mal die Tafel im Palast der Koenigin. Er ist auf ewig zum "
    "Inhumieren freigegeben!\n"
  );

  AddDetail( ({ "gildenstufe" , "stufe" }) ,
    "Eine hoehere Gildenstufe als 16 kann man bei den Druiden nicht "
    "erreichen. (jedenfalls nicht legal :-)"
  );

  AddDetail( ({ "geld" , "ausruestung" }) ,
    "Mordal toetete insgesamt 587 Dunkelelfen, was ihm wohl insgesamt "
    "etwa 1,5 Millionen Muenzen einbrachte!\n"
  );

}

void reset()
{
  ::reset();

  if (!is_clone())
    return (void) remove(1);   // woody 2004-05-24

  if(find_living("xatana"))
  {
    if(find_living("xatana")->InFight()==0) TO->remove_me();
  }
  else
  {
    TO->remove_me();
  }
}

void init()
{
  ::init();

  if(TP && TP->id("\nzakxatana")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

int remove_me()
{
  object *ob;
  int i;

  if (!is_clone())
    return remove(1);   // woody 2004-05-24

  if(ENV(TO))
    tell_room(ENV(TO), "Mordal geht in den Schrank. Was will er dort?\n");

  TO->move( "/room/npcasylraum", M_GO | M_SILENT | M_NO_SHOW | M_NOCHECK );

  // deep destruct inventory
  filter_objects( deep_inventory(TO), "remove" );       // woody 2004-05-24
  // ob = deep_inventory(TO);
  // i = sizeof(ob);
  // while(i--) ob[i]->remove();

  return remove(1);
}

varargs void die(int poisondeath)
{
  object enemy;

  if(enemy = QueryProp(P_KILLER))
  {
    EMASTER->Msg(Name(WER,1)+" wurde von "+UID(enemy)+" umgebracht");
  }

  ::die(poisondeath);
}

void NotifyPlayerDeath(object pl, object killer, int lostexp)
{
  string s;

  if(killer == TO)
  {
    EMASTER->Msg(Name(WER,0)+" hat gerade "+UID(pl)+" umgebracht");
  }

  return;
}

