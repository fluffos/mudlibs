#include "../def.h"

inherit NPC "std_ringnpc";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein blutruenstiger Vampir");
  SetProp(P_LONG,
    "Vor Dir steht ein blutruenstiger Vampir. Er hat ein bleiches Gesicht "
    "mit blutverschmierten Lippen. Seine scharfen Zaehne blitzen in seinem "
    "geoeffneten Mund. Er ist voellig in schwarz gekleidet."
  );

  SetProp(P_NAME, "Vampir");
  SetProp(P_GENDER, MALE);
  SetProp(P_MMSGIN, "kommt angeflogen und stuerzt sich sofort auf Dich");
  SetProp(P_MMSGOUT, "wird zu seinem Herrn berufen");

  AddId( ({"vampir"}) );
  AddClass(CL_UNDEAD); // siehe /sys/class.h

  SetProp(P_NAME_ADJ, ({"blutruenstig"}) );
  AddAdjective( ({"blutruenstigen"
                 ,"blutruenstiger"
                 ,"blutruenstigem"
                 ,"blutruenstiges"
                 ,"blutruenstige"
                 })
  );

  create_default_npc(15);

  SetProp(P_HANDS, ({" mit seinen langen Zaehnen", 150, DT_PIERCE}));
  SetProp(P_ALIGN, -700);
  SetProp(P_SIZE, 210);
  SetProp(P_RACE, "untoter");

  SetProp(P_WIMPY, 0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.2, DT_COLD:      0.0, DT_WATER:   0.2, DT_AIR:    0.0,
      DT_LIGHTNING: 0.2, DT_EXPLOSION: 0.2, DT_SOUND:   0.1, DT_LIGHT:  0.1,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON:  0.2, DT_TERROR: -0.2,
      DT_HOLY:      0.2, DT_UNHOLY:    -0.2, DT_MAGIC:  -0.2 ]) );

  SetProp(P_SPELLRATE,20);

  AddSpell(1,300,
     "Der Vampir bohrt Dir seine Zaehne in den Hals.\n",
     "Der Vampir bohrt @WEM seine Zaehne in den Hals.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1])
  );

  SetProp(P_AGGRESSIVE, 1);

  SetProp(P_NOCORPSE, 1);
  SetProp( P_DIE_MSG, " zerfaellt zu Staub.\n" );

  AddInfo("zaknafein",
    "sagt: Zaknafein befahl mir, die Gruft zu bewachen.\n");
}

