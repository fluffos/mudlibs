#include "../def.h"

inherit NPC "std_ringnpc";

#define ART ({ "klein","stinkend","riesig","aggressiv" })

string toeten_func();

void create()
{
  int i;

  if (!is_clone(this_object())) return;

  ::create();

  i = random(sizeof(ART));

  SetProp(P_SHORT, "Eine "+ART[i]+"e Ratte");
  SetProp(P_LONG,
    "Die "+ART[i]+"e Ratte ist ekelhaft schmutzig und stinkt "
    "erbaermlich. Mit ihren kleinen, scharfen Zaehnen und ihren Krallen "
    "kann sie Dich sicher ziemlich stark verletzen."
  );

  AddId( ({"ratte"})  );
  AddClass(CL_ANIMAL); // siehe /sys/class.h

  SetProp(P_NAME_ADJ, ({ART[i]}) );
  AddAdjective( ({ART[i]+"en",ART[i]+"er",ART[i]+"em",ART[i]+"es",ART[i]+"e"}) );

  SetProp(P_NAME, "Ratte");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "Ratte");

  create_default_npc(5+2*i);
  SetProp(P_ALIGN, 0);
  SetProp(P_SIZE, 20+i*random(10));
  SetProp(P_AGGRESSIVE, 0.1*(i+1));
  SetProp(P_HANDS, ({" mit ihren Krallen und Zaehnchen", 50+50*i, DT_PIERCE}) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.2, DT_COLD:      0.2, DT_WATER:   0.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.2, DT_EXPLOSION: 0.5, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.2, DT_TERROR:  0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.2 , DT_MIND: 0.2]) );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Einer Ratte kannst du nichts geben.\n" }) );

  SetProp(P_MNPC_DEFAULTROOM, ROOM "gang72");
  SetProp(P_MNPC_AREA, ROOM "gang");
  SetProp(P_MNPC_WAIT, ({ 10, 10, 20 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS + MOV_BACKWARDS);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");

  SetProp(P_MMSGIN, "huscht herein");
  SetProp(P_MMSGOUT, "huscht davon");

  seteuid(getuid(this_object()));

  SetProp(P_SPELLRATE, 10*i);

  AddSpell(1,100+50*i,
    Name(WER, 1)+" schlaegt dich mit ihrem langen Schwanz.\n",
    Name(WER, 1)+" schlaegt @WEN mit ihrem langen Schwanz.\n",
    DT_WHIP,([SP_SHOW_DAMAGE:1])
  );

  AddSpell(1,150+50*i,
    Name(WER, 1)+" beisst dich.\n",
    Name(WER, 1)+" beisst @WEN.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1])
  );

  SetChats(1,
    ({Name(WER, 1)+" schnuppert an Dir herum.\n"
     ,Name(WER, 1)+" nagt an Deiner Kleidung.\n"
     ,Name(WER, 1)+" pinkelt Dir auf die Fuesse.\n"
     })
  );

  SetProp(P_DIE_MSG, " verendet.\n" );
  SetProp(P_HEAL , i*5);

  SetProp(P_DEFAULT_INFO, #'toeten_func );

  AddDetail( ({ "zaehne" , "krallen" , "kralle" , "zahn"  }) ,
    "Die Zaehne und die Krallen der Ratte sind ziemlich scharf. Sicherlich "
    "holt man sich auch fiese Infektionen, wenn man von ihnen verwundet "
    "wird."
  );

  AddDetail( ({ "infektion" , "infektionen" }) ,
    "Bisher hattest du nur Geschlechtskrankheiten..."
  );

  AddDetail( ({ "krankheiten" , "geschlechtskrankheiten" }) ,
    "IHHHHHHHHH!!!"
  );

}

string toeten_func()
{
  Kill(TP);
  return "greift dich an.";
}


