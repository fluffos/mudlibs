#include "../def.h"

inherit NPC "std_ringnpc";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Eine wunderschoene Prinzessin");
  SetProp(P_LONG,
    "Vor Dir steht eine maerchenhafte Prinzessin. Sie hat dunkle, gelockte "
    "Haare und knallrote Lippen. Sie traegt ein wunderschoenes, "
    "schneeweisses Kleid und kleine, weisse Schuhe."
  );

  SetProp(P_NAME, "Prinzessin");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"prinzessin"}) );

  SetProp(P_NAME_ADJ, ({"wunderschoen"}) );
  AddAdjective( ({"wunderschoenen"
                 ,"wunderschoener"
                 ,"wunderschoenem"
                 ,"wunderschoenes"
                 ,"wunderschoene"
                 })
  );

  create_default_npc(30);
  SetProp(P_ALIGN, 1000);
  SetProp(P_SIZE, 170);
  SetProp(P_BODY, 300);
  SetProp(P_WIMPY, 0);
  SetProp(P_HANDS, ({" mit ihren langen Fingernaegeln", 300, DT_RIP}) );
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      0.1, DT_COLD:      0.1, DT_WATER:   0.0, DT_AIR:    0.0,
      DT_LIGHTNING: 0.1, DT_EXPLOSION: 0.1, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.1, DT_ACID:      0.1, DT_POISON: 0.1, DT_TERROR: 0.0,
      DT_HOLY:      -0.4, DT_UNHOLY:   -0.4, DT_MAGIC:  -0.2 ]) );

  SetProp(P_HEAL, 20);
  seteuid(getuid(this_object()));

  SetProp(P_SPELLRATE,40);

  AddSpell(1,450,
    Name(WER, 1)+" stopft Dir einen vergifteten Apfel in den Mund.\n",
    Name(WER, 1)+" stopft @WEM einen vergifteten Apfel in den Mund.\n",
    DT_POISON,([SP_SHOW_DAMAGE:1])
  );

  SetChats(3,
    ({Name(WER, 1)+" pudert ihr Gesicht und traegt Lippenstift auf.\n"
     ,Name(WER, 1)+" fragt sich: Wann kommt nur endlich mein Maerchenprinz ?\n"
     ,Name(WER, 1)+" raeumt den Kerker auf. Ordnung muss sein! \n"
     ,Name(WER, 1)+" springt aus Angst vor einer Maus auf den Hocker.\n"
     ,Name(WER, 1)+" flucht: Na warte Zaknafein! Das wirst Du bereuen!\n"
     })
  );

  SetAttackChats(5,
    ({Name(WER, 1)+" ruft verzweifelt nach ihrem Prinzen.\n"
     ,Name(WER, 1)+" sagt: Du bist ja noch fieser als Zaknafein!\n"
     ,"Du bekommst langsam ein schlechtes Gewissen.\n"
     })
  );

  SetProp( P_DIE_MSG, " faellt tot zu Boden.\n" );

  SetProp(P_DEFAULT_INFO,
    ({"murmelt etwas ueber Bakterien.\n"
     ,"hat Dich wohl gar nicht gehoert.\n"
     ,"sucht in der Kloake nach dem Sinn Deiner Worte.\n"
     })
  );

  AddInfo( ({"bakterien"}) ,
    "Das sind winzig kleine Wesen, die Dich krank machen koennen!"
    ,"erklaert Dir: "
  );

  AddInfo( ({"wesen"}) ,
    "Sie sind so klein, dass man sie nicht sehen kann!"
    ,"erklaert Dir: "
  );

  AddInfo( ({"zaknafein"}),
    "Grrrr, dieser Schuft hat mich hier eingesperrt!!!"
    , "antwortet grimmig: "
  );

  AddInfo( ({"andyl"}),
    "Hm, Andyl ist der Vater von Zaknafein und als solcher wohl "
    "hauptverantwortlich dafuer, dass ich hier sitze!!!"
    , "antwortet grimmig: "
  );

  AddInfo( ({"hilfe"}),
    "Ich ruehre mich nicht, bis ein richtiger Prinz kommt, um mich zu "
    "befreien!","sagt: "
  );

  AddInfo( ({"kuss"}) ,
    "Bist Du wirklich ein Prinz? Gekommen, um mich zu befreien? "
    "Schnell, tippe einfach 'kuss' und ich tue mein bestes!"
    , "jubelt: "
  );

  AddInfo( ({"schuft"}) ,
  "Zaknafein dieser fiese Schuft!!!"
    , "schreit: "
  );

  AddInfo( ({"frosch"}) ,
    "grummelt: Richtige Prinzen sind mir lieber!"
  );

  AddInfo( ({ "prinz" , "maerchenprinz" }) ,
    "Ich warte schon seit Monaten auf einen Prinzen!"
    , "sagt verzweifelt: "
  );

  AddInfo("sex",
    "Ne, lass mal, ich hab Migraene... (unverschaemter Bursche!) "
    , "kichert: "
  );

  AddDetail( ({ "fuss" , "fuesse" }) ,
    "Wie es sich fuer eine Prinzessin gehoert, hat sie recht kleine und "
    "schoene Fuesse."
  );

  AddDetail( ({"lippen"}) ,
    "Diese Lippen sind zum Kuessen da!"
  );

  AddDetail( ({"haare"}) ,
    "Die Prinzessin hat tiefschwarzes Haar, was das Rot ihrer Lippen "
    "angenehm betont."
  );

  AddDetail( ({"schuhe"})  ,
    "Die edlen Schuhe sind recht klein, da die Prinzessin kleine Fuesse hat."
  );

  AddDetail( ({"kleid"}) ,
    "Das Kleid ist schneeweiss. Wie hat die Prinzessin es nur sauber "
    "gehalten?"
  );

  AddCmd( "kuss" , "kuss" );

  AddCmd(
    "kuesse|kuess&prinzessin",
    "cmd_kuessen",
    "Wen willst Du kuessen?\n"
  );

}

int kuss(string str)
{
  if(TP->QueryProp(P_FROG) == 1)
  {
    EMASTER->Msg(TPUID+" kuesst die Prinzessin");
    TP->SetProp(P_FROG,0);
    tell_object(TP, BS("Voll freudiger Erwartung gleich einen praechtigen "
                       "Prinzen vor sich zu haben, beugt sich die "
                       "Prinzessin zu Dir herab und gibt Dir einen feuchten "
                       "Knutscher. Dir wird ganz schwindelig und "
                       "ploetzlich beginnst Du zu wachsen..."));

    if(TP->QueryProp(P_GENDER) == MALE)
    {
      tell_object(TP, BS("Die Prinzessin faehrt entsetzt hoch und starrt "
                         "Dich wuetend an. Du bist ja ein Witz von einem "
                         "Mann und bestimmt KEIN Prinz!!"));
    }
    else
    {
      tell_object(TP, BS("Die Prinzessin faehrt entsetzt hoch und starrt "
                         "Dich unglaeubig an. Du bist ja eine Frau!! "
                         "Wuahhh, ich will sofort meinen Prinzen!!"));
    }
  }
  else
  {
    tell_object(TP, "Die Prinzessin schreit: Wuahhhh! Dich kuesse ich "
                    "niiiiiiie wieder!\n");
  }

  return 1;
}

int cmd_kuessen(string str)
{
  if(TP->QueryProp(P_FROG))
  {
    tell_object(TP, "Hm, sie muss DICH kuessen, damit es funktioniert.\n");
  }
  else
  {
    tell_object(TP, "Die Prinzessin wendet sich von Dir ab. Sie hat genug "
                    "davon...\n");
  }

  return 1;
}
