#include "../def.h"

inherit NPC "std_ringnpc";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Der fiese Smeagol");
  SetProp(P_LONG,
    "Smeagol ist ein kleines, haessliches Wesen mit aeusserst scharfen "
    "Klauen. Er kauert in einer kleinen, dunklen Ecke und schaut Dich mit "
    "seinen roten, boese funkelnden Augen an."
  );

  AddId( ({"smeagol"}) );

  AddClass(CL_HOBBIT); // siehe /sys/class.h

  SetProp(P_NAME, "Smeagol");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);

  create_default_npc(10);
  SetProp(P_ALIGN, -1000);
  SetProp(P_RACE, "hobbit");
  SetProp(P_SIZE, 110);
  SetProp(P_BODY, 80);
  SetProp(P_HANDS, ({" mit seinen Klauen", 100, DT_RIP}) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE, ({ DT_HOLY }));
  set_living_name("smeagol");

  seteuid(getuid(this_object()));

  SetChats(10,
    ({Name(WER)+" versucht, den Ehering vor Dir zu verbergen.\n"
     ,Name(WER)+" kauert sich in einer Ecke zusammen.\n"
     ,Name(WER)+" schaut Dich voller Hass an.\n"
     })
  );

  SetAttackChats(5,
    ({Name(WER)+" taeuscht Dich mit einem hinterhaeltigen Ablenkungsmanoever.\n"
     ,Name(WER)+" ruft: Du wirst den Ring nie bekommen!\n"
     })
  );

  SetProp( P_DIE_MSG, " stuerzt schreiend zu Boden.\n" );
  SetProp(P_DEFAULT_INFO, "schaut Dich fragend an.\n");

  AddInfo( ({ "ring" , "ehering" }) ,
    "ruft in Panik: Das ist meiner, es war ein Geschenk!"
  );

  AddInfo("geschenk",
    "Zum Geburtstag hab ich ihn bekommen!"
    , "versucht, Dich zu ueberzeugen: "
  );

  AddInfo("geburtstag",
    "bruellt: Es ist wahr! Ich schwoere es!"
  );

  AddInfo("xatana",
    "bruellt verzweifelt: Sie luegt!!"
  );

  CLONEME(ARMOUR "ehering");
}

varargs void die(int poisondeath)
{
  object enemy, ring;

  if(enemy = QueryProp(P_KILLER))
  {
    ring = present("\nzakeqehering", TO);
    if(ring)
    {
      ring->SetOwner(getuuid(enemy));
    }
    else
    {
      EMASTER->Msg(
        sprintf("Smeagol (%s) hat keinen Ring dabei.", file_name(TO))
      );
    }
  }

  ::die(poisondeath);
}


