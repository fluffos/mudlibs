#include "../def.h"

inherit NPC "std_ringnpc";

#define ART ({ "klein","fett","riesig","blutrot" })

string toeten_func();

void create()
{
  int i;

  if(!is_clone(this_object())) return;

  ::create();

  i = random(sizeof(ART));

  SetProp(P_SHORT, "Eine "+ART[i]+"e Fledermaus");
  SetProp(P_LONG,
    "Die "+ART[i]+"e Fledermaus schaut Dich boese an. Sicher nimmt sie es "
    "Dir sehr uebel, das Du sie aufgescheucht hast."
  );

  SetProp(P_NAME, "Fledermaus");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "Fledermaus");

  create_default_npc(5+2*i);
  SetProp(P_ALIGN, 0);
  SetProp(P_SIZE, 20+i*random(10));
  SetProp(P_AGGRESSIVE, 0.1*(i+1));
  SetProp(P_HANDS, ({" mit ihren Krallen und Zaehnchen", 100+20*i, DT_RIP}) );
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_NOMAGIC, 0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:      0.2, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.2, DT_EXPLOSION:   0.2
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.2, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.2
     , DT_MIND:      0.2, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  AddId(  ({ "maus" , "fledermaus" }) );
  AddClass(CL_ANIMAL); // siehe /sys/class.h

  SetProp(P_NAME_ADJ, ({ART[i]}) );
  AddAdjective( ({ART[i]+"en",ART[i]+"er",ART[i]+"em",ART[i]+"es",ART[i]+"e"}) );

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Einer Fledermaus kannst du nichts geben.\n" }) );

  SetProp(P_MNPC_DEFAULTROOM, ROOM "gang73");
  SetProp(P_MNPC_AREA, ROOM "gang");
  SetProp(P_MNPC_WAIT, ({ 10, 10, 20 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS + MOV_BACKWARDS);

  SetProp(P_MSGIN,  "fliegt herein");
  SetProp(P_MSGOUT, "fliegt#");

  SetProp(P_MMSGIN, "fliegt herein");
  SetProp(P_MMSGOUT, "fliegt davon");


  seteuid(getuid(this_object()));

  SetProp(P_SPELLRATE, 10*i);

  AddSpell(1,100+50*i,
    Name(WER, 1)+" kratzt dich mit ihren scharfen Krallen.\n",
    Name(WER, 1)+" kratzt @WEN mit ihren scharfen Krallen.\n",
    DT_RIP,([SP_SHOW_DAMAGE:1])
  );

  AddSpell(1,150+50*i,
    Name(WER, 1)+" beisst Dir in den Hals.\n",
    Name(WER, 1)+" beisst @WEM in den Hals.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1])
  );

  SetChats(1,
    ({Name(WER, 1)+" fliegt um dich herum.\n"
     ,Name(WER, 1)+" setzt sich kurz auf Deinen Kopf.\n"
     ,Name(WER, 1)+" schaut Dich mit leuchtenden Augen an.\n"
     })
  );

  SetProp(P_DIE_MSG, " faellt zu Boden.\n" );
  SetProp(P_HEAL , i*5);

  SetProp(P_DEFAULT_INFO, #'toeten_func );
}

string toeten_func()
{
  Kill(TP);
  return "greift Dich an.";
}

