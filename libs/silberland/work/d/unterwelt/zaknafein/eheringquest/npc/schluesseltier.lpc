#include "../def.h"

inherit NPC "std_ringnpc";

void create()
{

  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein knuddeliges Schluesseltier");
  SetProp(P_LONG,
    "Das Schluesseltier hat tatsaechlich die Form eines Schluessels. Ts, "
    "was es nicht alles gibt... Es scheint aus Horn zu bestehen. "
  );

  SetProp(P_NAME, "Schluesseltier");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schluesseltier", "tier"}) );

  create_default_npc(10);
  SetProp(P_RACE, "tier");
  SetProp(P_ALIGN, 800);
  SetProp(P_SIZE, 20);
  SetProp(P_WEIGHT, 100);

  SetProp(P_BODY, 25);
  SetProp(P_HANDS, ({" mit seinem runden Ende", 80, DT_BLUDGEON}) );
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_SPELLRATE,40);

  seteuid(getuid(this_object()));

  AddSpell(1,120,
    "Das Schluesseltier schliesst einen Teil Deiner LPs weg.\n",
    "Das Schluesseltier schliesst einen Teil von @WESSEN LPs weg.\n",
    DT_TERROR,([SP_SHOW_DAMAGE:1])
  );

  SetChats(3,
    ({"Das Schluesseltier schaut Dich froehlich an.\n"
     ,"Das Schluesseltier knuddelt Dich.\n"
     ,"Das Schluesseltier philosophiert ueber den Sinn des Lebens als Schluesseltier.\n"
     ,"Das Schluesseltier bietet Dir seine Freundschaft an.\n"
     })
  );

  SetAttackChats(10,
    ({"Das Schluesseltier weint bitterlich.\n"
     ,"Das Schluesseltier jammert.\n"
     ,"Das Schluesseltier fleht Dich an:  Bitte hoer auf!\n"
     })
  );

  SetProp(P_CORPSE, OBJ "hornschluessel");
  SetProp( P_DIE_MSG, " schliesst mit seinem Leben ab.\n");

  SetProp(P_DEFAULT_INFO,"seufzt: Ach, das Leben ist so schoen!\n");

  AddInfo( ({ "schluessel", "Schluessel"  }) ,
    "Das ist ja das Problem... Er ist sozusagen ein Teil von mir...\n"
    , "sagt: "
  );

  AddInfo( ({ "freundschaft", "Freundschaft" }),
    "sagt froehlich: Lass uns Freunde sein!\n"
  );

  AddInfo( ({ "Wesen", "wesen" }),
    "Ja, hier war vor einigen Stunden ein Wesen. Es ging nach Osten.\n"
    , "sagt nachdenklich: "
  );

  AddInfo( ({ "prinzessin", "Prinzessin" }),
    "Die Arme wird schon seit Jahren hier gefangengehalten! Du musst sie "
    "befreien! Vielleicht kann sie Dir auch helfen...\n"
    , "sagt voller Mitleid: "
  );

  AddInfo( ({ "stunden", "Stunden" }),
    "Einige Stunden ist es wohl her... Ah ja, es hatte etwas glitzerndes "
    "dabei...\n" , "erinnert sich: "
  );

  AddInfo( ({ "Horntuer", "horntuer" }),
    "Hm, vor einigen Stunden ist ein Wesen durch die Horntuer gegangen.\n"
    , "erinnert sich: "
  );

  AddInfo( "problem" ,
    "sagt nachdenklich: Oh, je, ich ahne, was kommen wird... \n"
  );

  AddInfo( ({ "nische" , "Nische" }),
    "Es ist ein sehr merkwuerdiger Ort. Manchmal verschwinden dort "
    "Gestalten einfach oder tauchen scheinbar aus dem Nichts auf."
    , "sagt nachdenklich: "
  );

  AddInfo( ({ "ort" , "Ort" }),
    "bemerkt: Die Nische meine ich."
  );

  AddInfo( ({ "gestalten" , "Gestalten" }),
      "sagt: Abenteurer wie Du...\n"
  );

  AddInfo( ({ "yilrah" , "Yilrah" }),
     "Dieses Wort dringt manchmal aus der Nische zu mir."
     , "erinnert sich: "
  );

  AddDetail( ({"horn"}) ,
    "Hm, ja, es ist definitiv Horn."
  );

  AddCmd(
    "biet|biete&schluesseltier|tier&freundschaft&an",
    "cmd_bieten",
    "Wem moechtest Du was anbieten?\n"
  );
}

int cmd_bieten(string str)
{
  tell_object(TP, "Du bist nun Freund des Schluesseltiers.\n");
  EMASTER->Msg(TPUID+" bietet dem Schluesseltier Freundschaft an");

  call_out("seq", 2, TP, 0);
  return 1;
}

void seq(object pl, int step)
{
  switch(step)
  {
    case 0:
      tell_object(pl, BS("Das Schlusseltier freut sich riesig und huepft "
                         "wild um Dich herum. Als es es Dich zum Tanz "
                         "auffordert, kannst Du nicht widerstehen und "
                         "tanzt mit ihm eine Runde 'Dirty Dancing'."));
      call_out("seq", 2, pl, 1);
      break;

    case 1:
      tell_object(pl, "\n"+BS("Ploetzlich schaut Dich das Schluesseltier "
                      "an, wird kreidebleich und fasst sich mit seinen "
                      "Haenden an die Brust. Kurz darauf faellt es lautlos "
                      "zu Boden. Hui, es hatte wohl einen Herzinfarkt!"));
      call_out("seq", 4, pl, 2);
      break;

    case 2:
      TO->die();
      tell_object(TP, "Du warst nun Freund des Schluesseltiers.\n");
  }
}

