#include "../def.h"

inherit STDDARKELF;

#define ON 1
#define OFF 0

int maxhelfer=1;            // maximale Anzahl der Helfer, die das Xatana herbeiruft
mapping donefrog;

void Chats(int i)
{
  if(i == ON)
  {
    SetChats(5,
      ({"Xatana schaut Dich misstrauisch an.\n"
       ,"Xatana knallt mit ihrer Peitsche.\n"
       ,"Xatana trauert um ihren Ehering.\n"
       })
    );
  }
  else
  {
    SetProp(P_CHATS, 0);
  }
}

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  donefrog=([ ]);

  SetProp(P_SHORT, "Xatana");
  SetProp(P_LONG,
    "Vor Dir steht eine grosse Dunkelelfin. Sie schaut Dich mit ihren rot "
    "leuchtenden Augen skeptisch an. An ihrer Kleidung und ihrer gezueckten "
    "Waffe erkennst Du, dass sie wohl eine Kaempferin ist. Sie macht einen "
    "besorgten Eindruck. Vielleicht hat sie ja ein Problem, bei dem Du ihr "
    "helfen kannst. "
  );

  SetProp(P_NAME, "Xatana");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);

  create_default_darkelf(35, 35);

  SetProp(P_ALIGN, -1000);
  SetProp(P_SIZE, 210);
  SetProp(P_BODY, 350);
  SetProp(P_HANDS, ({" mit ihren langen Fingern", 350, DT_RIP}) );
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.2, DT_EXPLOSION:   0.2
     , DT_SOUND:     0.0, DT_LIGHT:     0.2, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:   -0.2, DT_TERROR:      0.0
     , DT_HOLY:     -0.2, DT_UNHOLY:   -0.2, DT_MAGIC:      -0.2
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_WIMPY, 0);
  SetProp(P_REJECT,
    ({REJECT_DROP, "Xatana bruellt: Gib das doch einem Muellschlucker "
                   "und nicht mir!\n"}) );

  set_living_name("xatana");

  AddId( ({ "\nzakxatana" , "xatana" , "NOWIMPY" }) );

  AddCmd( ({"verfroschen"})               , "cmd_verfroschen");
  AddCmd( ({ "helf" , "helfe" , "hilf" }) , "cmd_helfen");
  AddCmd( ({ "zerstoer" , "zerstoere" })  , "cmd_zerstoeren");

  AddCmd(
    "biet|biete&xatana&hilfe",
    "cmd_bieten",
    "Wem moechtest Du was anbieten?"
  );

  SUID;

  CLONEME(WEAPON "peitsche");
  command("zuecke peitsche");

  CLONEME(ZARMOUR "chitinhose");
  CLONEME(ZARMOUR "chitinarmschienen");
  CLONEME(ZARMOUR "spinnenpanzer");
  CLONEME(ZARMOUR "chitinguertel");
  command("ziehe alles an");

  SetProp(P_SPELLRATE,50);
  SetProp(P_NOMAGIC, 35);

  AddSpell(2,500,
    "Xatana wirft eine Dunkellanze nach Dir.\n",
    "Xatana wirft eine Dunkellanze nach @WEM.\n",
           DT_UNHOLY,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,600,
    "Xatana spuckt Dich mit Spinnengift an.\n",
    "Xatana spuckt @WER mit Spinnengift an.\n",
           DT_POISON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,1,"","",DT_BLUDGEON,"fesselnspell");
  AddSpell(1,1,"","",DT_BLUDGEON,"heilenspell");
  AddSpell(2,1,"","",DT_PIERCE,"hole_helfer");


  Chats(ON);

  SetAttackChats(5,
    ({"Xatana ruft: Ich werde Dir Dein Herz herausreissen!!\n"
     ,"Xatana lacht haemisch.\n"
     ,"Xatana sagt: Das war ein grosser Fehler!\n"
     })
  );

  SetProp( P_DIE_MSG, " faellt tot zu Boden.\n" );

  SetProp(P_DEFAULT_INFO,"sagt: Waaaaaaaaaas ?!\n");

  AddInfo( ({"zerstoeren"}) ,
    "Ich kann Dein Drachenbildchen und die Leiche des Schluesseltiers "
    "zerstoeren. Syntax: zerstoere xyz."
    ,"sagt: "
  );

  AddInfo( ({"zaknafein"}) ,
    "sagt: Ach, Zaki...\n");

  AddInfo( ({"form"}) ,
    "Form ist ein Nachbar von mir. Er kommt staendig vorbei und borgt "
    "sich was von mir. Ich glaube, er will was von mir. Wenn das "
    "Zaknafein wuesste...\n", "erklaert grinsend: ");

  AddInfo( ({"arton"}) ,
    "sagt: Arton ist mein Bruder.\n"
  );

  AddInfo( ({"mordal"}) ,
    "sagt: Mordal ist mein Sohn.\n"
  );

  AddInfo( ({ "ehemann" , "mann" , "zaki" }) ,
    "sagt: Zaknafein ist mein Mann.\n"
  );

  AddInfo( ({"hilfe"}) ,
    "seufzt: Hm, ich hab da tatsaechlich ein Problem...\n"
  );

  AddInfo( ({ "problem" , "schlampe" , "sowas" }) ,
    "Ich hatte einen Streit mit Zaki. Aus lauter Veraergerung habe ich "
    "unseren Ehering die Toilette runtergespuelt... Wuahhhhh! Wie konnte "
    "ich nur! Ich brauch ihn dringend wieder, bevor er heimkommt! Hilfst "
    "Du mir?"
    , "erklaert: "
  );

  AddInfo( ({"streit"}) ,
    "Die doofe Nuss treibt sich staendig herum und pruegelt sich mit "
    "Paladinen. Mich laesst er hier versauern...\n", "grummelt: "
  );

  AddInfo( ({ "klo" , "toilette" }) ,
    "Hm, wie koennen wir nur den Ring wiederbekommen? Wenn Du nur kleiner "
    "waerst...\n" , "gruebelt: "
  );

  AddInfo( ({ "frosch", "froeschen" }) ,
    "Ja, das ist die Idee!!! Ich kann Dich zu einem Frosch machen! Wenn Du "
    "bereit bist, tippe einfach 'verfroschen' .\n" , "ruft: "
  );

  AddInfo( ({ "ring" , "ehering" }) ,
    "jammert: Wuahhhh! Ich Schlampe! Wie konnte ich sowas nur tun?!\n"
  );

  AddInfo( ({ "groesse", "kleiner" }) ,
    "Hm, ich denke, fuer dieses Vorhaben braucht man die richtige "
    "Groesse.\n", "bemerkt: "
  );

  AddInfo( ({ "waffe" , "peitsche" }) ,
    "Es ist eine sehr gute Waffe. Lege Dich bloss nicht mit mir an!"
    , "warnt Dich: "
  );

  AddInfo( ({ "schrumpfen" , "vorhaben" }) ,
    "Ich koennte Dich verwandeln. In was, musst Du selber herausfinden."
    ,"bemerkt: "
  );

  AddInfo( ({ "drachenbildchen" , "bildchen" }) ,
    "Ich finde es recht huebsch, aber wenn Du es nicht mehr haben "
    "moechtest, kann ich Dich, wenn Du 'zerstoere Bildchen' eingibst, "
    "von ihm befreien.","bemerkt: "
  );

  AddDetail( ({ "auge" , "augen" }) ,
    "Xatanas Augen machen einen wachen und intelligenten Eindruck.\n"
  );

  AddDetail( ({"kaempferin"}) ,
    "Sie ist bestimmt eine sehr gute Kaempferin."
  );

  AddDetail( ({"problem"}) ,
    "Frage Xatana doch mal.\n"
  );

  AddDetail( ({"kleidung"}) ,
    "Sie traegt eine Ruestung aus Chitin."
  );

  AddDetail( ({"eindruck"}) ,
    "Der Eindruck taeuscht wohl eher nicht."
  );
}

void reset()
{
  ::reset();

  maxhelfer=1;
  donefrog=([ ]);
  Chats(ON);
}

void init()
{
  ::init();

  if(TP && TP->id("\nzakmordal")) AddDefender(TP);

  if(TP && interactive(TP)) call_out("greeting", 0, TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}


void greeting(object pl)
{
  object ob;
  int umbau;
  string s;

  umbau = 0;

  if(!ENV(TO))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;

  if(umbau && !IS_WIZARD(pl))
  {
    s = BSI("Raus hier!!! Ich renoviere gerade!!!", "Xatana bruellt: ")+
            "Xatana schmeisst dich raus...";
    tell_object(pl, s);
    pl->move("/d/unterwelt/zordan/dhrkion/room/weg-g7", M_GO);
    return;
  }

  if(EMASTER->IsQuester(getuuid(pl)))
  {
    tell_object(pl, BSI(CTPN+", hast du den Ring schon gefunden?",
                        "Xatana sagt: "));
    return;
  }

  switch(getuid(pl))
  {
    case "zaknafein":
      s  = BSI("Zaknafein, da bist du ja endlich!", "Xatana ruft erfreut: ");
      s += "Xatana umarmt Zakanfein.\n";
      tell_room(ENV(TO), s, ({ pl }) );

      s = "Xatana umarmt dich.\n"+BS("Xatana grummelt: Zaknafein! Warum bin "
          "ich nur lausige "+(TO->QueryProp(P_XP))/100+" XPs Wert?!");
      tell_object(pl, s);
      return;

      break;

    case "maru":
      s = "Xatana grummelt: Maru, hau ab!\n";
      tell_object(pl, s);
      return;
      break;

    case "berak":
      s = BSI("Break, stelle dich mal auf den Stuhl, damit ich Dir in die "
              "Augen schauen kann!", "Xatana lacht: ");
      tell_room(ENV(TO), s);
      return;
      break;

    case "arton":
      s  = BSI("Arton, mein Bruder!", "Xatana ruft erfreut: ");
      s += "Xatana umarmt Arton.\n";
      tell_room(ENV(TO), s, ({ pl }) );

      s  = "Xatana umarmt dich.\n";
      tell_object(pl, s);

      return;
      break;

    case "justavius":
      s  = "Xatana grummelt: Na, Justavius, gibst Du mir eine Revanche?!\n";
      s += "Xatana verneigt sich vor Justavius";
      tell_room(ENV(TO), s, ({ pl }) );

      s = "Xatana verneigt sich vor Dir.\n";
      tell_object(pl, s);

      return;
      break;

    case "macalla":
      s = "Xatana sagt: Macalla, bring mir doch mal ein paar knusprige "
          "Elfenohren vorbei.\nXatana verneigt sich vor Macalla.\n";
      tell_room(ENV(TO), s, ({ pl }) );

      s = "Xatana verneigt sich vor Dir.\n";
      tell_object(pl, s);

      return;
      break;

    case "larahl":
      s = "Xatana sagt: Ah, die tapfere Larahl! Sei gegruesst!\nXatana "
          "verneigt sich respektvoll vor Larahl.\n";
      tell_room(ENV(TO), s, ({ pl }) );

      s = "Xatana verneigt sich respektvoll vor Dir.\n";
      tell_object(pl, s);

      return;
      break;

    case "feyaria":
      s = "Xatana grummelt: Feyaria! Warum bin ich nur lausige "+
          (TO->QueryProp(P_XP))/100+" XPs Wert?!\n";

      tell_object(pl, s);

      return;
      break;

    case "juny":
      s = "Xatana sagt froehlich: Juny, schoenen Gruss von Zak!\nXatana "
          "poliert brav Junys Heiligenschein.\n";
      tell_room(ENV(TO), s, ({ pl }) );

      s = "Xatana poliert brav deinen Heiligenschein.\n";
      tell_object(pl, s);

      return;
      break;

  }

  if(TP->QueryQuest(EHERINGQUEST))
  {
    tell_object(pl, BSI(TP->Name(WER)+", schoen, dass Du mich mal wieder "
                        "besuchst!", "Xatana sagt: "));
    return;
  }

  tell_object(pl, BSI(TP->Name(WER)+", was willst du denn hier?", "Xatana "
                      "fragt: "));
  return;
}

void hole_helfer(object enemy, int damage, mixed dam_type)
{
  if((maxhelfer==1) && (!find_living("mordal")))
   {
    tell_room(environment(enemy), "Xatana ruft ihren Sohn Mordal herbei.\n");
    clone_object(NPC "mordal")->move(environment(enemy), M_NOCHECK);
    maxhelfer=0;
    EMASTER->Msg(TPUID+" ruft Mordal zu Hilfe");
   }
   else
   {
    tell_room(environment(enemy), "Xatana ruft laut um Hilfe.\n");
   }
}

void heilenspell(object enemy, int damage, mixed dam_type)
{
  tell_room(ENV(TO), "Xatana trinkt einen kleinen Zaubertrank!\n");
  heal_self(random(150));
}

void fesselnspell(object enemy, int damage, mixed dam_type)
{
  enemy->SetProp(P_DISABLE_ATTACK, 1 + random(4));
  enemy->do_damage(20+random(20));

  tell_room(ENV(TO), BS("Xatana fesselt "+enemy->name(WEN,2)+" mit ihrer "
                        "Peitsche und wirft "+enemy->QueryPronoun(WEN)+
                        " zu Boden."), ({ enemy }) );

  tell_object(enemy,
    "Xatana fesselt dich mit ihrer Peitsche und wirft Dich zu Boden.\n");
}

int cmd_verfroschen(string str)
{
  if(!EMASTER->IsQuester(TPUUID))
  {
    tell_object(TP, "Xatana sagt: Hilfst Du mir, helf ich Dir. So und nicht "
                    "anders.\n");
    return -1;
  }

  if(TP->QueryProp(P_FROG))
  {
    tell_object(TP, BSI("Also wenn Du mich fragst, siehst Du schon wie "
                        "ein Frosch aus!", "Xatana meint: "));
    return -1;
  }

  if(donefrog[TPUUID] > 3)
  {
    tell_object(TP, "Xatana sagt: Aber ich habe Dich doch gerade erst "
                    "verfroscht!?!");
    return -1;
  }

  tell_room(ENV(TO), CTPN+" wird von Xatana in einen kleinen Frosch "
                     "verwandelt.\n", ({ TP }) );

  tell_object(TP, BS("Xatana murmelt eine Zauberformel und fuchtelt wild "
                     "mit ihren Armen. Und dann: Wuahhh! Nun bist Du ein "
                     "Frosch! Das hast Du nun davon!"));

  TP->SetProp(P_FROG, 1);
  TP->AddSp(-random(20));

  donefrog[TPUUID] = donefrog[TPUUID] + 1;

  return 1;
}

int cmd_bieten(string str)
{
  if(EMASTER->IsQuester(TPUUID))
  {
    tell_object(TP, "Xatana fragt Dich: Hast Du den Ring schon?\n");
  }
  else
  {
    EMASTER->StartQuest(TPUUID);
    EMASTER->Msg(TPUID+" startet die Eheringquest");

    tell_object(TP, BSI("Sehr gut! Wenn Du den Ring hast, bring ihn mir. "
                        "Ich warte hier.", "Xatana sagt: "));
  }

  return 1;
}

int cmd_helfen(string str)
{
  notify_fail("Wem moechtest Du helfen?\n");

  if(!str || str == "")        return 0;
  if(!(str == "xatana"      ||
       str == "dunkelelfin" )) return 0;

  cmd_bieten("");
  return 1;
}

void give_notify(object obj)
{
  object ob;

  if(InFight())
  {
    tell_room(ENV(TO), BS("Xatana ist in einen Kampf verwickelt und hat "
                          "keine Zeit sich mit Deinen Sachen zu "
                          "beschaeftigen."));
    ob->move(ENV(TO), M_NOCHECK|M_PUT);
    return;
  }

  if(!(obj->id("\nzakeqehering"))) return ::give_notify(obj);

  if(!EMASTER->IsQuester(TPUUID))
  {
    tell_object(TP, BSI("Ups, den hatte ich doch grad in die Toilette "
                        "geworfen.", "Xatana sagt: ")+"Sie zuckt mit den "
                        "Schultern, wirft den Ring ins Klo und zieht an "
                        "der Kette.");
    obj->remove();
    return;
  }

  if(obj->QueryOwner() != TPUUID)
  {
    tell_object(TP, BSI("Oh, schicke mir doch denjenigen, der Dir den "
                        "Ring besorgt hat, damit ich ihn reichlich "
                        "belohnen kann!", "Xatana sagt: ")+"Xatana grinst "
                        "Dich wissend an.\n");
    obj->remove();
    return;
  }

  tell_object(TP, BS("Xatana freut sich wie verrueckt, knuddelt Dich wild "
                     "und jubelt: Danke! Du bist echt gut! Dann meint sie: "
                     "Ich hab auch eine Belohnung fuer Dich!"));

  obj->remove();

  if(ob=present("\neqquestitem" , TP)) ob->remove();
  if(ob=present("\nzakhelm"     , TP)) ob->remove(1);   // silent
  if(ob=present("\nzaksymbol"   , TP)) ob->remove();
  if(ob=present("\nzakleiche"   , TP)) ob->remove();

  call_out("seq", 4, TP, 1);

  return;
}

void QuestLog(string s)
{
  write_file(EHERINGQUESTLOG,dtime(time())+" : "+s+"\n");
}

void QuestEnd(object pl)
{
  int result;
  string tpuid;
  object room, ob;

  tell_object(pl, "\n"+BS("Xatana sagt: Danke nochmal fuer Deine Hilfe."));

  result = pl->GiveQuest(EHERINGQUEST);
  tpuid  = CAP(getuid(pl));
  room   = ENV(TO);

  switch(result)
  {
    case  1:
      EMASTER->DeleteQuester(getuuid(pl));
      EMASTER->Msg(tpuid+" loest die Quest zum ersten Mal.");

      QuestLog(tpuid+" loest die Quest zum ersten Mal." );

      ob = clone_object(OBJ "cai");
      if(ob->move(pl, M_GET) == 1)
      {
        tell_object(pl, "Xatana steckt Dir noch etwas zu.\n");
      }
      else
      {
        tell_object(pl, BS("Xatana moechte Dir Deine Belohnung geben, aber "
                          "Du kannst nichts mehr tragen. "));
        ob->remove();
      }
      break;

    case -1:
      EMASTER->DeleteQuester(getuuid(pl));
      EMASTER->Msg(tpuid+" loest die Quest zum wiederholten Mal.");
      QuestLog(tpuid+" loest die Quest zum wiederholten Mal.");
      break;

    case -2:
      EMASTER->DeleteQuester(getuuid(pl));
      EMASTER->Msg(tpuid+" loest die Quest, aber die Quest ist nicht "
                   "eingetragen.");
      QuestLog(tpuid+" loest die Quest, aber die Quest ist nicht eingetragen.");
      tell_room(room,"Die Quest ist noch nicht eingetragen.\n");
      break;

    case -3:
      EMASTER->DeleteQuester(getuuid(pl));
      EMASTER->Msg(tpuid+" loest die Quest, Fehler unbefugter Zugriff.");
      QuestLog(tpuid+" loest die Quest, Fehler unbefugter Zugriff.");
      tell_room(room, "Unbefugter Zugriff auf die Quest. Melde es einem "
                      "Magier.\n");
      break;

    case -4:
      EMASTER->DeleteQuester(getuuid(pl));
      EMASTER->Msg(tpuid+" loest die Quest, aber die Quest ist nicht aktiv.");
      QuestLog(tpuid+" loest die Quest, aber die Quest ist nicht aktiv.");
      tell_room(room,"Die Quest ist derzeit deaktiviert.\n");
      break;

     default:
      EMASTER->Msg(
        sprintf("%s loest die Quest, aber unbekannter Fehler %d", tpuid
                                                                , result)
        );


      QuestLog(
        sprintf("%s loest die Quest, aber unbekannter Fehler %d", tpuid
                                                                , result)
        );

      tell_room(room,
        sprintf("Unbekannter Fehler bei der Questvergabe: %d\n", result)
      );

      break;
  }

  return;
}

void seq(object pl, int step)
{
  object ob;

  switch(step)
  {
    case 1:
      Chats(OFF);
      tell_object(pl,
          "\nXatana wuehlt im Schrank und holt etwas hervor.\n"
          "Es sind DRACHENSCHUPPEN!!! Du freust Dich maechtig.\n");
      break;

    case 2:
      tell_object(pl, "\n"+BS("Gerade als Xatana Dir die Drachenschuppen "
                      "geben moechte, entsteht ploetzlich direkt vor Dir "
                      "eine grosse Blase, aus der blaeuliche Blitze "
                      "zucken."));
      break;

    case 3:
      tell_object(pl, "\n"+BS("Eine grosse, mit einem schwarzen Umhang "
                      "gekleidete Gestalt tritt aus der Blase heraus."));
      break;

    case 4:
      tell_object(pl, "\n"+BS("Die Gestalt begruesst Dich freundlich und "
                      "sagt zu Xatana: Hallo, mein Schatz. Aeh, was "
                      "machst Du denn da mit meinen Drachenschuppen?"));
      break;

    case 5:
      tell_object(pl,
          "\nXatana erklaert: Sie sind eine Belohnung fuer "+
          (pl->name(WEN,2))+".\n"+
          BS("Die Gestalt reisst Xatana die Drachenschuppen aus der Hand "
             "und schreit: Wuahhh! Meine schoenen Drachenschuppen!"));
      break;

    case 6:
      tell_object(pl,
          "\nXatana sagt veraergert: Aber ich hab sie doch "+
          (pl->name(WEM,2))+" versprochen!\n"
          "Die Gestalt gruebelt.\n");
      break;

    case 7:
      tell_object(pl, "\n"+BS("Ploetzlich faellt der Gestalt ein: Ah, "
                      "ich habs! Sie holt einen Zettel hervor, auf den "
                      "sie was kritzelt und gibt ihn Dir. Xatanas Kopf "
                      "wird langsam rot vor Wut."));

      ob = clone_object(OBJ "belohnung");
      ob->move(pl, M_GET|M_NOCHECK); //kein gewicht, daher M_NOCHECK
      ob->SetProp(P_NODROP, "Wenn Dir das Bildchen nicht gefaellt, dann "
                            "zerreisse es doch einfach.\n");
      ob->SetProp(P_NEVERDROP, 1);
      ob->SetProp(P_NOSELL, 1);

      break;

    case 8:
      tell_object(pl, "\n"+BS("Dann sagt die Gestalt: So, ich muss nun "
                      "los, ich hab mich mit Ayla verabredet. Machts "
                      "gut! *wink* Kurz darauf verschwindet sie unter "
                      "grellen Blitzen in der Blase, die sich dann sofort "
                      "aufloest.")+BS("Xatana kocht ueber vor Wut. Sie "
                      "reisst sich den Ehering vom Finger und wirft ihn "
                      "in die Toilette und zieht an der Kette."));
      break;

    case 9:
      QuestEnd(pl);
      Chats(ON);
      return;
      break;
  }

  call_out("seq", 6, pl, ++step);
}

int cmd_zerstoeren(string str)
{
  object ob;
  notify_fail("Du musst schon 'zerstoere Leiche' bzw. 'zerstoere "
              "Bildchen' tippen.\n");

  if(!str || str == "") return 0;

   if( str == "drachenbildchen" || str=="bildchen" )
 {
    if (ob=present(("\nzakbildchen"), this_player()))
    {
       ob->remove();
       write("Xatana sagt: Okay, wie Du willst!\n");
       say("Xatana zerstoert ein Drachenbildchen.\n");
       return 1;
    }
    else
    {
       write("Xatana gruebelt: Hm, Du hast gar kein Drachenbildchen.\n");
       return 1;
    }
 }
 if( str == "Leiche" || str=="leiche" )
 {
    if (ob=present(("\nzakleiche"), this_player()))
    {
       ob->remove();
       write("Xatana sagt: Okay, wie Du willst!\n");
       say("Xatana zerstoert die Leiche des Schluesseltierchens.\n");
       return 1;
    }
    else
    {
       write("Xatana gruebelt: Hm, Du hast gar keine Leiche.\n");
       return 1;
    }
 }
 return 0;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return;
  switch(gruppe)
  {
    case "fies":
       call_out("react", 0, "sagt grinsend: Du gefaellst mir, "+this_player()->name(WER, 2),
         "sagt grinsend: Du gefaellst mir, "+this_player()->name(WER, 2));
       break;
     case "aergerlich":
       call_out("react", 0, "sagt: Pffff", "sagt: Pffff");
       break;
     case "traurig":
       call_out("react", 0, "sagt: Heule Dich doch bei Deiner Mutter aus",
            "sagt: Heule Dich doch bei Deiner Mutter aus, "+this_player()->name(WER, 2));
       break;
     case "albern":
       call_out("react", 0, "kichert",
            "kichert");
       break;
     case "neutral":
       call_out("react", 0, "schaut Dich misstrauisch an", "schaut "+this_player()->name(WEN)+" misstrauisch an");
       break;
     case "intim":
       call_out("react", 0, "gibt Dir eine harte Ohrfeige",
                    "gibt "+this_player()->name(WEM)+" eine harte Ohrfeige");
       break;
     case "froh":
       call_out("react", 0, "grinst Dich an",
              "grinst "+this_player()->name(WEN)+" an");
       break;
     case "aengstlich":
       call_out("react", 0, "macht sich ueber Dich lustig",
              "macht sich ueber "+this_player()->name(WEN)+" lustig");
       break;
     case "frech":
       call_out("react", 0, "schaut Dich boese an und zueckt ihre Peitsche", "schaut "+this_player()->name(WEN)+" boese an und zueckt ihre Peitsche");
       break;
     case "nett":
       call_out("react", 0, "sagt: Schleime mal nicht so rum, "+this_player()->name(WER), "sagt: Schleime nicht so rum, "+this_player()->name(WER));
       break;
   }
 }

 void react(string victim, string others)
 {
   if (present(this_player(), environment(this_object())))
   {
     tell_object(this_player(), break_string(Name(WER, 1) + " "+victim+".", 74));
     tell_room(environment(this_object()), break_string(Name(WER, 1)+" "+others+".", 74), ({this_player(),this_object()}));
   }
 }

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


varargs void die(int poisondeath)
{
  object enemy;

  if(enemy = QueryProp(P_KILLER))
  {
    EMASTER->Msg(Name(WER,1)+" wurde von "+UID(enemy)+" umgebracht");
  }

  ::die(poisondeath);
}

void NotifyPlayerDeath(object pl, object killer, int lostexp)
{
  string s;

  if(killer == TO)
  {
    EMASTER->Msg(Name(WER,0)+" hat gerade "+UID(pl)+" umgebracht");
  }

  return;
}

