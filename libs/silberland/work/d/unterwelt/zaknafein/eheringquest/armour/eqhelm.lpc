#include "../def.h"

inherit "std/armour";

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein Helm");
  SetProp(P_LONG,
    "Es handelt sich um einen recht zierlichen Helm aus einem weissen "
    "Material. Er wird Dir wohl keinen grossen Schutz bieten, aber "
    "vielleicht kann er Dir auf andere Weise nuetzlich sein."
  );

  SetProp(P_NAME, "Helm");
  SetProp(P_GENDER, MALE);
  AddId( ({ MAINID, "helm" , "\nzakhelm" }) );

  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 2000);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);

  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_OBSIDIAN);

  SetProp(P_NODROP, "Irgendwie magst Du Dich nicht von dem Helm trennen. "
                    "Seltsam...\n");

  SetProp(P_NEVERDROP, 1);
}

