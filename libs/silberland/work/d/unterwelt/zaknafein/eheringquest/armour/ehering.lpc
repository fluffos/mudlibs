#include "../def.h"

inherit "std/armour";

string owner;

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein goldener Ehering");
  SetProp(P_LONG,
    "Es ist ein sehr wertvoller Ehering. Er besteht anscheinend aus purem "
    "Gold. Auf der Innenseite erkennst Du eine Gravur."
  );

  SetProp(P_NAME, "Ehering");
  SetProp(P_GENDER, MALE);
  AddId( ({ "ehering" , "ring" , "\nzakeqehering" }) );

  SetProp(P_NAME_ADJ, ({"golden"}) );
  AddAdjective( ({"goldenen","goldener","goldenem","goldenes","goldene"}) );

  AddDetail( ({ "innenseite" , "gravur" }) ,
    "Xatana & Zaknafein in ewiger Liebe"
  );

  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 8000);
  SetProp(P_MATERIAL, MAT_GOLD);
  SetProp(P_ARMOUR_TYPE, AT_RING);

  SetProp(P_AC, 5);

  owner = 0;
}

void SetOwner(string uuid)
{
  string fname, fsmeagol;
  int ok;

  if(!owner) owner = uuid;

  ok = 1;
  if(!PO) ok = 0;

  if(ok)
  {
    fname    = explode(file_name(PO), "#")[0];
    fsmeagol = "/d/" REGION "/" MAGIERNAME "/" GEBIET "/npc/smeagol";

    if(fname != fsmeagol) ok = 0;
  }

  if(!ok)
  {
    EMASTER->Msg(sprintf("Besitzer des Eherings wurde gesetzt von %O", PO));
  }
}

string QueryOwner()
{
  return owner;
}
