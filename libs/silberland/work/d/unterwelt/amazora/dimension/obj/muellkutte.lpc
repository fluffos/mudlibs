#include <properties.h>
#include <combat.h>
inherit "std/armour";

void create()
{
  if(!is_clone(this_object()))return;
  ::create();
  SetProp(P_SHORT, "Eine schwarze Kutte");
  SetProp(P_LONG, break_string(
        "Eine tiefschwarze Kutte, die Satansanbeter zum Feiern schwarzer "
        "Messen tragen.", 78));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Kutte");
  SetProp(P_NAME_ADJ, "schwarz");
  AddId("kutte");
  AddAdjective( ({"schwarz", "schwarze", "schwarzen"}) );

  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 500);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([ MAT_CLOTH:90, MAT_MISC_UNHOLY:10]));
}

