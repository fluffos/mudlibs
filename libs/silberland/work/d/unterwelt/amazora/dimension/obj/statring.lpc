#include <properties.h>
#include <combat.h>
#include <language.h>
#include <attributes.h>
#include <new_skills.h>
inherit "std/armour";
 
void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  
  AddId(({"ring", "daemonenring", "ring von yogsothoth"}));
  SetProp(P_SHORT, "Ein Daemonenring");
  SetProp(P_LONG, 
    "Der Ring von Cthulhu. Ein magisches, gruenes Leuchten geht von "
    "ihm aus.");
  SetProp(P_NAME, "Daemonenring");
  SetProp(P_GENDER, MALE);
  SetProp(P_INFO, break_string(
    "Der Ring schuetzt Dich vor magischen und feurigen Schaeden und "
    "macht Dich ein wenig ausdauernder.", 78));

  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 3000+random(500));
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 4);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_FIRE:1, DT_MAGIC:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1]) );
  SetProp(P_MATERIAL, ([MAT_MISC_UNHOLY:5, MAT_COBALT:65, MAT_MISC_MAGIC:5, 
                        MAT_EMERALD:10, MAT_CRYSTAL:15]) );
  SetProp (P_M_ATTR_MOD, ([ A_CON:1+random(3) ]) );
}
