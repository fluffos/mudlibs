#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
inherit "std/armour";

void create()
{
  if(!is_clone(this_object()))return;
  ::create();
  SetProp(P_SHORT, "Ein Paar Lederhandschuhe");
  SetProp(P_LONG, 
      "Die Handschuhe bestehen aus festem Leder und sitzen "
      "bequem auf Deinen Haenden.");
  SetProp(P_NAME, "Handschuhe");
  SetProp(P_PLURAL, 1);
  AddId("handschuhe");
  AddId("lederhandschuhe");
  SetProp(P_INFO,
      break_string("Die Handschuhe sind aus einem speziellen Leder gegerbt "
        "und bieten einen guten Schutz gegen magische und "
        "gegen feurige Attacken.", 78));

  SetProp(P_VALUE, 300);
  SetProp(P_WEIGHT, 100);
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 8);
  SetProp(P_DAM_PROTECTION, 
      QueryProp(P_DAM_PROTECTION)+([DT_FIRE:1, DT_MAGIC:1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1]) );
  SetProp(P_MATERIAL, ([MAT_LEATHER: 90, MAT_FIRE:5, MAT_MISC_MAGIC:5 ]));
}
