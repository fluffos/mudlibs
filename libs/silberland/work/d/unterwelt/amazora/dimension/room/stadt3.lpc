inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create() 
{
  ::create();
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Ein Marktplatz");
  SetProp(P_INT_LONG, 
    "Du erreichst den Marktplatz. Die Luft ist warm und es geht kein Hauch. "
    "Und im schwarzen Gewoelbe, blinzelt graesslich wie ein irr-wachendes "
    "Auge, der Polarstern."); 
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15,ENV_TERRAIN:TT_TOWN]) );

  AddDetail( ({"boden", "strasse"}), 
    "Du stehst drauf.\n");
  AddDetail( ({"platz", "markt", "marktplatz"}), 
    "Der grosse Platz auf dem Du stehst, scheint einst ein belebter "
    "Marktplatz gewesen zu sein. Doch jetzt wirkt der Platz leer und "
    "verlassen.");
  AddDetail( ({"gewoelbe", "himmel"}), 
    "Im schwarzen Gewoelbe blinzelt graesslich, wie ein irr-wachendes Auge, "
    "der Polarstern."); 
  AddDetail( ({"stern", "auge", "polarstern", "licht"}), 
    "Hoch oben im schwarzen Gewoelbe, glueht mit unheimlichen Licht der "
    "Polarstern.");
  AddDetail( ({"hauch", "luft", "wind", "windhauch"}), 
    "Die Luft ist warm und Du spuerst nicht einen Windhauch. Trotzdem "
    "froestelt Dich.");

  AddExit("norden", ROOM "laden");
  AddExit("westen", ROOM "stadt");
  AddExit("osten", ROOM "stadt4");
}

