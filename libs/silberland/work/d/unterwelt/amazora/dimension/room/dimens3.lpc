inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create() 
{

  ::create();
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "In der Welt der Grossen Alten");
  SetProp(P_INT_LONG, 
    "Du wanderst noch immer durch eine verlassene, fremde Welt. Die Baeume in "
    "den dichten Waldguerteln erscheinen uebernatuerlich hoch, und die "
    "verhext wirkenden Straeucher, Buesche und Graeser haben ein "
    "uebernatuerliches, blasses Gruen. Schluchten und Felsspalten von "
    "gefaehrlicher Tiefe durchschneiden den Weg. ");

  AddDetail( ({"boden", "strasse", "weg"}), 
    "Schluchten und Felsspalten von gefaehrlicher Tiefe durchschneiden "
    "den Weg.");
  AddDetail( ({"mond", "himmel", "firmament"}), 
    "Der Mond haengt bleich und boese am Firmament.\n");
  AddDetail( ({"welt", "ort", "gegend"}), QueryProp(P_INT_LONG));
  AddDetail( ({"tod", "furcht", "grauen"}), 
    "Es scheint diese Welt zu beherrschen.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_PLAIN]) );
  AddDetail( ({"baeume", "baum", "straeucher", "strauch", "buesche", "busch", 
               "graeser", "gras", "waldguerteln", "waldguertel"}), 
    "Sie wuchern in einer Ueppigkeit, wie man sie nur hoechst selten in von "
    "Menschen besiedelten Gegenden findet.");
  AddDetail( ({"mensch", "menschen", "leute"}), 
    "Du hast das Gefuehl als wuerde es hier gar keine Menschen geben.");
  AddDetail ("gefuehl"), "Du hast ein ueberaus seltsames Gefuehl.";
  AddDetail( ({"schlucht", "schluchten", "felsspalte", "felsspalten"}), 
    "Sei bloss vorsichtig, dass Du in keine faellst!");

  AddExit("osten", ROOM "dimens4");

}

