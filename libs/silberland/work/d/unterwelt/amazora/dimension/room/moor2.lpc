inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create() {
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Ein Moor");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_SWAMP]) );
  SetProp(P_INT_LONG, 
    "Bebend vor Entsetzen durchquerst Du das Moor. In den fauligen Wassern, "
    "die in letzter Zeit keinerlei tierisches Leben geborgen hatten, brodelt "
    "jetzt eine schleimige Masse."); 

  AddDetail( ({"himmel", "mond"}), "Der Mond strahlt hell ueber das Moor.\n");
  AddDetail( ({"moor", "raum", "ort"}), QueryProp(P_INT_LONG));
  AddDetail( ({"wasser", "wassern","blaeschen"}),
    "Kleine Blaeschen steigen aus den fauligen Wassern auf und es riecht "
    "modrig.\n");
  AddDetail( ({"masse"}),
    "Eine undefinierbare eklige braune Masse.\n");
  AddDetail("leben", "Keinerlei Leben existiert in diesem grauslichen Moor.");
  AddDetail( ({"boden", "morast"}),
    "Der Boden besteht aus roetlichem Morast.\n");
 
  AddSmell (DEFAULT_SMELL, "Es riecht modrig und nach Verwesung.\n");

  AddExit("westen", ROOM "moor1");
  AddExit("osten", ROOM "moor3");
}
