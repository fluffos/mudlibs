inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create() {
  ::create();
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "In der Welt der Grossen Alten");
  SetProp(P_INT_LONG, 
    "Der Wald beginnt auf sich auf fuerchterliche Weise zu veraendern. "
    "Die Baeume zittern und verschwimmen, als betrachte man sie durch einen "
    "Vorhang, beginnen sich zu verbiegen und zu verzerren, aendern ihre "
    "Farbe und ihre Form.");

  AddDetail( ({"baum", "baeume", "vorhang"}), 
    "Es sind eigentlich keine Baeume mehr. Ihre Staemme sind struppig und "
    "viel dicker als sie sein duerften.");
  AddDetail( ({"stamm", "staemme", "farn", "farnwedel", "wedel"}), 
    "Die Staemme haben keine Aeste sondern etwas, das dich vage an einen "
    "gigantischen Farnwedel erinnert.");
  AddDetail( ({"welt", "ort", "gegend", "gelaende", "wald", "waelder"}), 
    QueryProp(P_INT_LONG));
  AddDetail( ({"tod", "furcht", "grauen"}), 
    "Es scheint diese Welt zu beherrschen.");

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_FOREST]) );

  AddDetail ("form", "Der Wald veraendert staendig seine Farbe und Form.");
  AddDetail( ({"farbe", "nacht"}), 
    "Es ist die Farbe der Nacht und des Todes!");
  AddDetail( ({"himmel", "sonne"}), 
    "Dieser Himmel hat wohl noch nie eine Sonne gesehen.");
  AddDetail( ({"strasse", "strassen", "boden", "watte"}), 
    "Es ist als wuerdest Du auf Watte gehn. ");
  AddDetail( ({"zeit", "zeitalter"}), "Hier scheint es keine Zeit zu geben.");

 AddExit("norden", ROOM "dimens7");
 AddExit("sueden", ROOM "dimens9");

}

