inherit "std/room";

#include <properties.h>
#include <moving.h>
#include "../files.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Inneren einer Grotte die fast wie ein Tempel "
    "aussieht. Primitive Altaere, Saeulen und Nischen erblickst Du hier.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);

  AddDetail( ({"hoehle", "grotte", "tempel"}), QueryProp(P_INT_LONG));
  AddDetail( ({"altar", "altaere", "saeulen", "saeule"}), 
    "Dich ueberkommt auf einmal ein befremdlicher Schauder, denn die Altaere "
    "und Saeulen suggerieren vergessene Riten schrecklicher und abstossender "
    "Art!");
  AddDetail( ({"riten", "kult", "art"}), 
    "Du fragst Dich, was fuer ein Menschenschlag einen derartigen Tempel "
    "wohl errichtet haben mag.");
  AddDetail( ({"decke", "fels", "felsgestein", "gestein"}), 
    "Die Decke ist gut zwanzig Fuss ueber Dir und besteht aus massivem "
    "Felsgestein.");
  AddDetail( ({"wand", "waende"}), "In den Waenden sind Nischen eingebaut.");
  AddDetail( ({"boden", "fussboden"}), 
    "Auf dem Boden sind nasse Spuren die zu einem kleinen See fuehren.");
  AddDetail( ({"spuren", "fussspuren"}), "Sind wohl Deine.");
  AddDetail( ({"see", "oberflaeche"}), 
    "Der See gefaellt Dir nicht, trotzdem ueberlegst Du ob man ihn nicht "
    "vielleicht betreten kann.");
  AddSpecialDetail(({"nische", "nischen"}), "nische");
  AddDetail( ({"kerze", "kerzen"}), 
    "Kerzen flackern in den Nischen. Wer die wohl aufgestellt haben mag?");

  AddExit("oben", ROOM "yog");

  AddCmd(({ "betrete", "betritt"}), "see" );
}

string nische()
{
   if (this_player()->FindPotion(
     "Oh, in einer Nische findest Du hinter der Kerze einen Zaubertrank.\n"))
        return "";
   else
      return "Kerzen stehen in den Nischen.\n";
}

int see(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if( str=="see" || str=="see") 
  {
    write(
      "Du springst in den See und kommst voellig nass wieder an die"
      " Oberflaeche.\n");
    this_player()->move(ROOM "hoehle", M_GO, 
      "in den See", "springt", "taucht auf und schwimmt ans Ufer");
    say("Die Wellen glaetten sich wieder.\n");
    return 1;
  }
  return 0;
}

