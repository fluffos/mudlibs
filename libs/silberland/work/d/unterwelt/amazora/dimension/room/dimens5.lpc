inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"


create() 
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "In der Welt der Grossen Alten");
  SetProp(P_INT_LONG, 
    "Hier teilt sich die Strasse. Im Sueden siehst Du einen dunklen Wald, "
    "der befrachtet ist mit den Geruechen jenseits der Welten. Die Furcht "
    "sitzt Dir im Nacken und haelt Dich in ihren grausamen Klauen.");

  AddDetail( ({"welt", "ort", "gegend", "gelaende", "welten"}), 
    QueryProp(P_INT_LONG));
  AddDetail( ({"huegel", "gebirge"}), 
    "Die Gipfel sind zu rund und symmetrisch, als das sie beruhigend wirken "
    "koennten. ");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD ]) );

  AddDetail( ({"himmel", "sonne", "mond", "sterne", "stern"}), 
    "Der Himmel ist so dunkel, dass Du weder Mond noch Sonne noch Sterne "
    "sehen kannst.");
  AddDetail( ({"boden", "strasse", "verderben"}), 
    "Du befindest Dich auf der Strasse ins Verderben.\n");
  AddSmell (DEFAULT_SMELL, 
    "Dieser Geruch macht Dir Angst, es riecht nach Tod.\n");
  AddDetail( ({"wald", "waelder"}), 
    "Diese Waelder sind so finster und drohend, dass man wuenschte sie "
    "blieben in der Entfernung! ");
  AddDetail( ({"strasse", "strassen"}), 
    "Wo sie wohl hinfuehren mag? ");

  AddExit("osten", ROOM "dimens6");
  AddExit("sueden", ROOM "dimens7");

}

