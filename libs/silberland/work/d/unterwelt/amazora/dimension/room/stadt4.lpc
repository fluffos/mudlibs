inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create() 
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Eine Stadt");
  SetProp(P_INT_LONG, 
    "Die Stadt reicht bis zum Horizont und sogar darueber hinaus. Nach Sueden "
    "hin siehst Du eine kleine Kapelle mit einem kleinen Friedhof. Aus dem "
    "Norden kommen merkwuerdige Geraeusche.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15,ENV_TERRAIN:TT_TOWN]) );

  AddDetail( ({"stadt", "polaris"}), 
    "Von totenbleichem Marmor sind ihre Mauern, ihre Tuerme, ihre Saeulen, "
    "Kuppeln und Pflaster. In den Marmorstrassen standen Marmorpfeiler, deren "
    "Kronen zu Bildnissen wuerdevoller und baertiger Maenner behauen waren.");
  AddDetail( ({"mauern", "kuppel", "turm", "saeule", "tuerme", "saeulen", 
               "kuppeln", "pflaster", "marmor"}), 
    "Von totenbleichem Marmor sind ihre Mauern, ihre Tuerme, ihre Saeulen, "
    "Kuppeln und Pflaster.");
  AddDetail( ({"strassen", "strasse", "marmorstrasse", "pfeiler", 
               "marmorpfeiler"}), 
    "In den Marmorstrassen standen Marmorpfeiler, deren Kronen zu Bildnissen "
    "wuerdevoller und baertiger Maenner behauen waren.");
  AddDetail( ({"maenner", "mann", "bildnis", "bildnisse", "krone", "kronen"}), 
    "In den Marmorstrassen standen Marmorpfeiler, deren Kronen zu Bildnissen "
    "wuerdevoller und baertiger Maenner behauen waren.");
  AddDetail( ({"friedhof", "kapelle"}), 
    "Du bist noch zu weit weg um irgendwas zu erkennen." );

  AddSound (DEFAULT_SOUND, "Wem oder was willst Du lauschen?\n");
  AddSound (({"geraeusche","geraeuschen"}),
   "Du lauscht, hoerst aber nichts. Merkwuerdig, Dir war als haettest Du ein "
   "Glaeserklirren vernommen.\n");
 
  AddExit("westen", ROOM "stadt3");
  AddExit("norden", ROOM "kneipe");
  AddExit("sueden", ROOM "friedhof");

}

