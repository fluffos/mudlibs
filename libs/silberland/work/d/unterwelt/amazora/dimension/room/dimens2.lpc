inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create() {
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "In der Welt der Grossen Alten");
  SetProp(P_INT_LONG, 
    "Du wanderst weiter durch die Welt, die so fremd ist, dass sie sich "
    "jeglicher Vorstellungskraft entzieht. Eine Welt, die wie finsterer "
    "Pestgestank atmet, in der das Leben keinen Sinn mehr zu haben scheint, "
    "in der Tod und Furcht die Ordnung der Dinge aufrechterhaelt und deren "
    "Pulsschlag vom Grauen bestimmt wird.");

  AddSmell (DEFAULT_SMELL, "Metaphern riecht man nicht.\n");
  AddDetail( ({"auge", "himmel", "pech"}), 
    "Soweit Dein Auge reicht, ist der Himmel schwarz wie Pech.\n");
  AddDetail( ({"boden", "weg", "strasse", "verderben"}), 
    "Die Strasse fuehrt Dich geradewegs ins Verderben.\n");
  AddDetail( ({"welt", "ort"}), QueryProp(P_INT_LONG));

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_PLAIN]) );
  AddDetail("vorstellungskraft", 
    "Du hast keine Vorstellung, was das hier bedeuten mag.");
  AddDetail( ({"tod", "furcht", "grauen"}), 
    "Es scheint diese Welt zu beherrschen.");
  AddDetail( ({"pestgestank", "pulsschlag"}), 
    "Das geht ja wohl zu weit wenn ich meine Metaphern jetzt auch noch "
    "beschreiben soll oder? *seufz*");

  AddExit("osten", ROOM "dimens3");
}

