inherit "/std/pub";
#include <properties.h>
#include <language.h>
#include "../files.h"

create() 
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "In einer Kneipe");
  SetProp(P_INT_LONG, 
    "Wie ueberall ist es auch hier voellig still und verlassen. Nur der "
    "Barkeeper steht hinter der Bar und schaut Dich aus toten Augen an. Ueber "
    "der Bar haengt ein Schild.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"keeper", "barkeeper"}), 
   "Es ueberrascht Dich nicht, dass dieser Barkeeper tot ist.");
  AddDetail( ({"schild", "schild"}), "Du kannst es lesen.");
  AddDetail( ({"wand", "waende"}), 
    "Die Waende sind ziemlich kahl, keinerlei Bilder oder Tapeten kannst Du "
    "erkennen.");
  AddDetail( ({"boden", "staub", "schmutz"}), 
    "Der Boden ist staubig und schmutzig.");    
  AddDetail( ({"bar", "theke"}), "Ueber der Theke haengt ein Schild.");
  AddReadDetail( ({"schild", "schild"}), 
   "Wenn Du wissen willst was es hier gibt, tipp 'menue'.");
  AddDetail("decke", "Du kommst nicht ran, schade.\n");

  AddExit("sueden", ROOM "stadt4");

  AddDrink("Geisterbraeu", ({"braeu", "geisterbraeu"}),
      10, 1, 1, 1, 
      ({"Der Barkeeper bringt Dir dein Geisterbraeu.\n"
          "Es schmeckt ziemlich fad.\n",
      "Der Barkeeper bringt && ein Geisterbraeu.\n"}));

  AddDrink("Zombieblut", ({"blut", "zombieblut"}),
      50, 12, 5, 0,
     ({"Der Barkeeper zapft sich selber etwas Blut ab und wirft Dir "
          "dann das\n"+
          "Glas zu. Du faengst es und trinkst es in einem Zug aus.\n",
       "Der Barkeeper zapft sich selbst etwas Blut ab und wirft &&\n"+
          "das Glas zu.\n"}));

  AddDrink("Weihwasser", ({"weihwasser", "wasser"}),
      500, 25, 0, 3,
     ({"Der Barkeeper schubst Dir voller Unbehagen ein Glas zu.\n",
       "Der Barkeeper schubst && voller Unbehagen ein Glas zu.\n"}));

  AddFood("Knochensalat", ({"salat", "knochensalat"}),
      170, 50, 22,
      ({"Du isst knirschend Deinen Knochensalat. *grusel*\n",
        "&& isst knirschend einen Knochensalat. *grusel*\n"}) );
       
}           

