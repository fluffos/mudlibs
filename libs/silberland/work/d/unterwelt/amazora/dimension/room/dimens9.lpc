inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create() 
{
  ::create();
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "In der Welt der Grossen Alten");
  SetProp(P_INT_LONG, 
    "Der Wald ist ploetzlich vollends verschwunden und hat einer gewaltigen, "
    "roetlich schimmernden Ebene Platz gemacht. In der Ferne, so weit, dass "
    "sie nur als Schatten zu erkennen ist, stehen jetzt gigantisch gezackte "
    "Berge, und der Himmel ist jetzt fast weiss. Im Sueden kannst Du eine "
    "Huette betreten.");

  AddDetail( ({"welt", "ort", "gegend", "gelaende", "wald", "waelder"}), 
    QueryProp(P_INT_LONG));
  AddDetail( ({"tod", "furcht", "grauen", "watte"}), 
    "Es scheint diese Welt zu beherrschen.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_PLAIN]) );

  AddDetail( ({"ebene", "platz", "berge", "ferne"}), 
    "In der Ferne stehen gigantisch gezackte Berge.");
  AddDetail( ({"himmel", "firmament"}), "Der Himmel ist fast weiss.");
  AddDetail( ({"strasse", "strassen", "boden"}), 
    "Es ist als wuerdest Du auf Watte gehn. ");
  AddDetail( ({"sueden", "huette"}), 
    "Im Sueden kannst Du eine Huette betreten.");
  AddDetail( ({"zeit", "zeitalter"}), "Hier scheint es keine Zeit zu geben.");

  AddExit("norden", ROOM "dimens8");
  AddExit("sueden", ROOM "huette");
}

