inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create() 
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Eine verlassene Stadt");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_INT_LONG, 
    "Als Du Dich langsam der Stadt Polaris naeherst, ahnst Du sofort, dass "
    "sie verflucht ist. Still und schlaftrunken liegt sie dort, auf einem "
    "Plateau in einer Senke zwischen sonderbaren Gipfeln."); 

  AddDetail( ({"boden", "strasse"}), 
    "Du stehst drauf.\n");
  AddDetail( ({"himmel", "auge", "polarstern", "polar", "gewoelbe"}),
    "Im schwarzen Gewoelbe, blinzelt graesslich, wie ein irr-wachendes Auge, "
    "der Polarstern.");
  AddDetail( ({"raum", "ort", "stadt", "polaris"}), QueryProp(P_INT_LONG));
  AddDetail( ({"senke", "plateau", "gipfel", "gipfeln"}),
    "Du bist noch zu weit weg, um genaueres zu erkennen!\n");

  AddExit("norden", ROOM "tempel");
  AddExit("sueden", ROOM "stadt1");
  AddExit("westen", ROOM "moor3");
  AddExit("osten", ROOM "stadt3");
}

