
inherit "std/room";

#include <properties.h>
#include <moving.h>
#include "../files.h"
#include <class.h>

int h;

void create()
{
  ::create();
  h = 1;

  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Inneren einer Grotte die fast wie ein Tempel "
    "aussieht. Primitive Altaere, Saeulen und Nischen erblickst Du hier.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);

  AddDetail( ({"hoehle", "grotte", "tempel"}), QueryProp(P_INT_LONG));
  AddDetail( ({"altar", "altaere", "saeulen", "saeule"}), 
    "Dich ueberkommt auf einmal ein befemdlicher Schauder, denn die Altaere "
    "und Saeulen suggerieren vergessene Riten schrecklicher und abstossender "
    "Art!");
  AddDetail( ({"riten", "kult", "art"}), 
    "Du fragst Dich, was fuer ein Menschenschlag einen derartigen Tempel "
    "wohl errichtet haben mag.");
  AddDetail( ({"decke", "fels", "felsgestein", "gestein"}), 
    "Die Decke ist gut zwanzig Fuss ueber Dir und besteht aus massivem "
    "Felsgestein.");
  AddDetail( ({"wand", "waende"}), "In den Waenden sind Nischen eingebaut.");
  AddDetail( ({"kerze", "kerzen"}), 
    "Noch immer fragst Du Dich, wer die hier aufgestellt haben mag aber wenn "
    "Du Dir es genau ueberlegst, willst Du es eigentlich gar nicht so genau "
    "wissen.");
  AddDetail( ({"nische", "nischen"}), "Kerzen stehen in den Nischen." );
  AddDetail ("boden",
    "Als Du genauer hinsiehst, bemerkst Du seltsame Runen.\n");
  AddSpecialDetail(({"runen", "heilrunen"}), "runen");

  AddCmd("lies", "lies");

  AddExit("oben", ROOM "az");
  AddExit("unten", ROOM "yib");

  AddItem( NPC "shubb", REFRESH_DESTRUCT);
}

string runen()
{
   if (h)
        return "Die Runen leuchten in hellem Rot.\n";
    else
        return "Die Runen sind blass und unscheinbar.\n";
}

int lies(string str)
{
  notify_fail("Was moechtest Du lesen?\n");
  if (!str || str!="runen")
    return 0;
    if (set_light(0)<1 && !TP->is_class_member(CL_NIGHTVISION))
  {
    write("Es ist zu dunkel.\n");
    return 1;
  }
  if (this_player()->QueryProp(P_BLIND))
  {
    write("Du bist blind!\n");
    return 1;
  }
  if (!h)
    write("Die Heilrunen sind blass und haben momentan keine magische "
          "Wirkung.\n");
    else
    {
      h = 0;
      write(BS(
        "Du liest die Heilrunen und fuehlst, wie Dich eine herrliche Waerme "
        "durchstroemt. Die Runen flackern kurz auf und verblassen dann."));
      this_player()->heal_self(200);
    }
    return 1;
}

reset()
{
  ::reset();
  h = 1;
}


