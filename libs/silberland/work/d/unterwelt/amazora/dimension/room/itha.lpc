inherit "std/room";

#include <properties.h>
#include <moving.h>
#include "../files.h"

int h;

void create()
{
  ::create();

  h = 1;
  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Inneren einer Grotte die fast wie ein Tempel "
    "aussieht. Primitive Altaere, Saeulen und Nischen erblickst Du hier.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_INDOORS, 1);

  AddDetail( ({"hoehle", "grotte", "tempel"}), QueryProp(P_INT_LONG));
  AddDetail( ({"altar", "altaere", "saeule", "saeulen", "nische", "nischen"}), 
    "Dich ueberkommt auf einmal ein befremdlicher Schauer, denn die Altaere "
    "suggerieren vergessene Riten schrecklicher und abstossender Art!");
  AddDetail( ({"riten", "kult", "art"}), 
    "Du fragst Dich, was fuer ein Menschenschlag einen derartigen Tempel wohl "
    "errichtet haben mag.");
  AddDetail( ({"decke", "felsen", "fels", "felsgestein"}), 
    "Die Decke ist gut zwanzig Fuss ueber Dir und besteht aus massivem "
    "Felsgestein.");
  AddDetail( ({"wand", "waende"}), "In den Waenden sind Nischen eingebaut.");
  AddDetail( ({"boden", "fussboden"}), "Spuren sind auf dem Boden zu sehn.");
  AddDetail( ({"spuren", "fussspuren"}), 
    "Huch, sind die Spuren gross. Scheinen von einem Tier oder so zu stammen. "
    "Stell doch mal Deinen Fuss rein.");

  AddCmd("stelle", "stelle");

  AddExit("oben", ROOM "shod");
  AddExit("unten", ROOM "hastur");

  AddItem( NPC "tsa", REFRESH_DESTRUCT);

}

int stelle(string str)
{
  notify_fail("Wo moechtest Du Deinen Fuss reinstellen?\n");
  if (!str || str!="fuss in spuren")
    return 0;
  if (!h)
    write(BS(
     "Du stellst Deinen Fuss in die Spur und fragst Dich wer wohl so grosse "
     "Fuesse haben kann."));
  else
  {
    h = 0;
    write("Du stellst Deinen Fuss in die Spur und fuehlst Dich ganz stark.\n");
    this_player()->heal_self(180);
   }
   return 1;
}

void reset()
{
  ::reset();
  h = 1;
}
