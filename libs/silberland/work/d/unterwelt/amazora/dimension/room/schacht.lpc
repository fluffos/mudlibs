inherit "std/room";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include "../files.h"


void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "In einem Schacht");
  SetProp(P_INT_LONG, 
    "Der Stollen, in dem Du Dich befindest, ist vollkommen leer. Lediglich "
    "die Waende bestehen aus schwarzer Lava, die in Deinem Kerzenlicht oelig "
    "schimmern.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10, ENV_TERRAIN:TT_CAVE]) );
  SetProp(P_INDOORS, 1);

  AddDetail( ({"stollen", "schacht"}), 
   "Die Insel ist vielleicht durch eine Laune der Natur entstanden, dieser "
   "Schacht hier allerdings nicht. Hier waren vernunftbegabte Wesen am Werk.");
  AddDetail( ({"wesen", "kreaturen"}), 
    "Hier waren vor Dir schon einmal Wesen. Vor sehr langer Zeit. Es muss "
    "Jahrhunderte her sein. Vielleicht sogar Jahrtausende.");
  AddDetail( ({"natur", "laune"}), 
    "Dieser Schacht hier ist keine Laune der Natur.");
  AddDetail( ({"wand", "waende", "lava"}), 
    "Die Waende bestehen aus schwarzer Lava, die in Deinem Kerzenlicht oelig "
    "schimmern.");
  AddDetail( ({"boden", "boden"}), "Der Boden ist schlammig.");
  AddDetail( ({"decke", "decke"}), "Huch, da ist ja eine Luke!");
  AddDetail( ({"luke", "oeffnung"}), "Na, was machst Du jetzt mit der Luke?");

  AddCmd(({"kletter", "klettere"}), "luke");

  AddExit("oben", ROOM "insel2");
  AddExit("unten", ROOM "schacht1");
}

luke(str)
{
  notify_fail("Wodurch willst du klettern?\n");
  if( str=="durch luke" || str=="luke")
  {
    write("Du kletterst durch eine Luke.\n");
    this_player()->move(ROOM "huette", M_TPORT, 
       "durch ein Loch", "faellt", "faellt herein");
    say("Die Luke schliesst sich.\n");
    return 1;
  }
  return 0;
}

