inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create() 
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "In der Welt der Grossen Alten");
  SetProp(P_INT_LONG, 
    "Eigentlich gibt es Waelder wie diesen hier nicht. Das heisst: Nicht "
    "mehr! Aber es hat eine Zeit gegeben, da gab es sie. Du weisst nicht "
    "genau wie lange das her ist, aber Du hast das Gefuehl, dass es auch "
    "gar keine Rolle spielt. Es hatte einmal Waelder wie diesen hier gegeben "
    "- Vor hundert oder zweihundert Millionen Jahren!");

  AddDetail( ({"farbe", "himmel"}), 
    "Der Himmel hat eine seltsam violette Farbe.");
  AddDetail( ({"welt", "ort", "gegend", "gelaende", "wald", "waelder"}), 
    QueryProp(P_INT_LONG));
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_FOREST]) );

  AddDetail( ({"tod", "furcht", "grauen", "watte"}), 
    "Es scheint diese Welt zu beherrschen.");
  AddDetail( ({"strasse", "strassen", "boden"}), 
    "Es ist als wuerdest Du auf Watte gehn. ");
  AddDetail( ({"baeume", "baum"}), 
    "Es scheint so, als waeren die Baeume, aus einer laengst vergessenen "
    "Zeit.");
  AddDetail( ({"zeit", "zeitalter"}), "Hier scheint es keine Zeit zu geben.");

  AddExit("norden", ROOM "dimens5");
  AddExit("sueden", ROOM "dimens8");

}

