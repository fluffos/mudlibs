inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

int h;

void create()
{
  ::create();
  h = 1;
  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Inneren einer Grotte die fast wie ein Tempel "
    "aussieht. Primitive Altaere, Saeulen und Nischen erblickst Du hier.");
  SetProp(P_INDOORS, 1);

  AddDetail( ({"hoehle", "grotte", "tempel"}), QueryProp(P_INT_LONG));
  AddDetail( ({"altar", "altaere", "saeulen", "saeule"}), 
    "Dich ueberkommt auf einmal ein befremdlicher Schauder, denn die Altaere "
    "und Saeulen suggerieren vergessene Riten schrecklicher und "
    "abstossender Art!");
  AddDetail( ({"riten", "kult", "art"}), 
   "Du fragst Dich, was fuer ein Menschenschlag einen derartigen Tempel "
   "wohl errichtet haben mag.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
  AddDetail( ({"decke", "fels", "felsgestein", "gestein"}), 
    "Die Decke ist gut zwanzig Fuss hoch und besteht aus massiven "
    "Felsgestein.");
  AddDetail( ({"yogsothoth", "yog"}), 
    "Yog-Sothoth ist das Tor. Yog-Sothoth ist Schluessel und Waechter des "
    "Tores. Vergangenheit, Gegenwart, Zukunft, alles ist Yog-Sothoth.");
  AddDetail( ({"wand", "waende"}), "In den Waenden sind Nischen eingebaut.\n");
  AddDetail( ({"kerze", "kerzen"}), 
    "Noch immer fragst Du Dich, wer die hier aufgestellt haben mag aber wenn "
    "Du Dir es genau ueberlegst, willst Du es eigentlich gar nicht so genau "
    "wissen.");
  AddDetail( ({"nische", "nischen"}), "Kerzen stehen in den Nischen." );
  AddDetail ("boden",
    "Der Boden ist staubig.\n");
  AddDetail("staub", 
    "Staub liegt auf dem Boden. Doch halt! Ist da nicht etwas im Staub zu "
    "erkennen?");
  AddSpecialDetail(({"formel", "zauberformel"}), "zauberformel");

  AddCmd("sprich", "sprich");
  AddCmd("wische", "wische_fkt");
  AddExit("oben", ROOM "hastur");
  AddExit("unten", ROOM "shud");
  AddItem(NPC "cthuga", REFRESH_DESTRUCT);
}

wische_fkt(str)
{
   notify_fail("Was willst Du denn wischen?\n");
   if(str=="staub") 
   {
     write(BS(
        "Auf dem Boden ist eine alte Zauberformel eingraviert und wartet "
        "darauf, dass sie endlich gesprochen wird\n"));
        return 1;
    }
    return 0;
}

void reset()
{   
  h = 1;
  ::reset();
}

zauberformel()
{ 
  if (h)
    return BS("Eine alte Zauberformel ist im Boden eingraviert und wartet "
           "darauf, dass man endlich auspricht was so lang ersehnt.");
    else
        return "Eine uralte Zauberformel.\n";
}

sprich(str)
{
    notify_fail("Was willst du sprechen?\n");
    if (!str || str!="zauberformel")
        return 0;
    if (!h)
        write("Du murmelst: N' gai, n'ha'ghaa, bugg-shoggog, y'hah. "
              "Yog-Sothoth...\n");
    else
    {
        h = 0;
        write( BS(
          "Du sagst eine alte Zauberformel auf und fuehlst wie Dich eine "
          "Kraft durchstroemt."));
        this_player()->heal_self(200); 
    }
    return 1;
}



