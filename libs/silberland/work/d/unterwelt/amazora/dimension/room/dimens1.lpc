inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create() {
  ::create();
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "In der Welt der Grossen Alten");
  SetProp(P_INT_LONG, 
    "Du befindest Dich in einer Ebene, schwarz wie Teer und so unendlich wie "
    "die Ewigkeit, sanft gewellt wie ein Ozean, der mitten in der Bewegung "
    "erstarrt war, und beschienen von dem Licht eines kalten, knochenbleichen "
    "Mondes, der viel zu nah und viel zu gross war.");
  SetProp(P_INDOORS, 0);

  AddDetail( ({"raum", "ebene"}), QueryProp(P_INT_LONG)); 
  AddDetail("boden", 
   "Der Boden zuckt und bebt, wie die schrundige Haut eines gewaltigen und "
   "haesslichen Tieres.");
  AddDetail("licht", 
    "Das Licht kommt von einem kalten, knochenbleichen Mond.");
  AddDetail("mond", 
    "Hoch am Himmel haengt ein bleicher, knochenweisser Mond.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_PLAIN]) );

  AddDetail("himmel", 
    "Ein Himmel, den niemals eine Sonne beschienen hatte, bar jeden "
    "Sternes, beherrscht vom grinsenden Knochengesicht eines bleichen "
    "Totenmondes.");

  AddExit("osten", ROOM "dimens2");

  AddItem( NPC "shogotte", REFRESH_DESTRUCT);
  AddItem( NPC "shogotte", REFRESH_DESTRUCT);
  AddItem( NPC "shogotte", REFRESH_DESTRUCT);
  AddItem( NPC "shogotte", REFRESH_DESTRUCT);

}
