inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create() 
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Polaris");
  SetProp(P_INT_LONG, 
    "Das Gelaende steigt an und nach einem muehsamen Aufstieg erreichst Du "
    "die Stadt Polaris."); 
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15,ENV_TERRAIN:TT_TOWN]) );

  AddDetail( ({"gelaende", "aufstieg"}), QueryProp(P_INT_LONG));
  AddDetail( ({"stadt", "polaris"}), 
    "Von totenbleichem Marmor sind ihre Mauern, ihre Tuerme, ihre Saeulen, "
    "Kuppeln und Pflaster. In den Marmorstrassen standen Marmorpfeiler, "
    "deren Kronen zu Bildnissen wuerdevoller und baertiger Maenner behauen "
    "waren.");
  AddDetail( ({"mauern", "kuppel", "turm", "saeule", "tuerme", "saeulen", 
               "kuppeln", "pflaster", "marmor"}), 
    "Von totenbleichem Marmor sind ihre Mauern, ihre Tuerme, ihre Saeulen, "
    "Kuppeln und Pflaster.");
  AddDetail( ({"strassen", "strasse", "marmorstrasse", "pfeiler", 
               "marmorpfeiler"}), 
    "In den Marmorstrassen standen Marmorpfeiler, deren Kronen zu Bildnissen "
    "wuerdevoller und baertiger Maenner behauen waren.");
  AddDetail( ({"maenner", "mann", "bildnis", "bildnisse", "krone", "kronen"}), 
    "In den Marmorstrassen standen Marmorpfeiler, deren Kronen zu Bildnissen "
    "wuerdevoller und baertiger Maenner behauen waren.");

  AddExit("norden", ROOM "stadt");
  AddExit("sueden", ROOM "post");
  AddExit("westen", ROOM "stadt2");

}
