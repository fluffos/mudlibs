inherit "/std/room";
#include <language.h>
#include <properties.h>
#include "../files.h"

void create()
{
  ::create();

  SetProp( P_LIGHT, 1 );
  SetProp(P_INDOORS,1);
  SetProp(P_INT_SHORT, "In einer Kapelle");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einer duesteren und verlassenen Kapelle. Ein "
    "stiller, ruhiger Ort. Ein Hauch von Verwesung liegt in der Luft. "
    "Spinnweben haengen von den Waenden und in den Nischen flackert sanft der "
    "Schein unzaehliger Kerzen.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({"kapelle", "raum", "ort"}), QueryProp(P_INT_LONG));
  AddDetail( ({"hauch", "verwesung"}),
    "Du kannst ihn schon fast riechen, den Duft der Verwesung.\n");
  AddDetail( ({"netz", "spinnweben", "netze"}),
    "Spinnweben wurden von unzaehligen Spinnen kunstvoll gewebt.\n");
  AddDetail( ({"schein", "schein"}),
    "In den Nischen, flackert der Schein unzaehliger Kerzen.\n");
  AddDetail( ({"decke", "stein"}),
    "Du schaust an die Decke und hoffst, dass sie nicht einstuerzt, so stark "
    "zerbroeckelt ist der Stein schon.");
  AddDetail( ({"spinne", "spinnen", "opfer"}),
    "Spinnen sitzen in ihren Netzen und warten geduldig auf Opfer.\n");
  AddDetail( ({"nische", "nischen", "formen"}),
    "Ueberall stehen Kerzen, deren Schatten bizarre Formen an die Waende "
    "malen.");
  AddDetail ( ({"kerze", "kerzen"}),
    "Wer die wohl alle aufgestellt hat? Und wozu?\n");
  AddDetail( ("schatten"),
    "Die Kerzen malen bizarre Schatten an die Waende.\n");
  AddDetail( ({"wand", "waende"}),
    "Obskure Zeichen und Formeln wurden an die Waende gemalt.\n");
  AddDetail ( ({"zeichen"}),
    "Es handelt sich hier um Pentagramme und andere okkulte Zeichen.\n");
  AddDetail( ({"pentagramm", "pentagramme"}),
    "Sag mal, weisst Du nicht, was ein Pentagramm ist?\n");
  AddDetail( ({"okkulte zeichen"}),
    "Sie berichten von geheimnisvollen Dingen.\n");
  AddDetail( ({"formel", "formeln"}),
    "Du kannst nix genaues erkennen, weil sie schon sehr vergilbt sind.\n");
  AddDetail( ({"boden","lehm"}),"Der Boden ist feucht und lehmig.\n");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Faeulnis und Verwesung.\n");
  AddSmell (({"verwesung","faeulnis"}),
    "Es stinkt hier. Am liebesten wuerdest Du weglaufen.\n");

  AddExit("unten", ROOM "keller");
  AddExit("raus", "/d/unterwelt/clementine/polaris/room/gruft");
}

