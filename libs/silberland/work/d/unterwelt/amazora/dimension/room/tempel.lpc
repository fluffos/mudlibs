inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

create() {
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Ein Tempel");
  SetProp(P_INT_LONG, 
    "Ploetzlich stoesst Du auf einen Ort, wo das felsige Fundament sich bloss "
    "ueber den Sand erhebt und eine niedere Klippe formt.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

  AddDetail( ({"himmel", "auge", "polarstern", "polar", "gewoelbe"}),
    "Im schwarzen Gewoelbe, blinzelt graesslich, wie ein irr-wachendes Auge, "
    "der Polarstern.");
  AddDetail( ({"klippe", "klippen", "fassade", "fassaden", "vorderseite"}), 
    "Aus der Vorderseite der Klippe waren unmissverstaendlich Fassaden "
    "verschiedener kleiner und niederer Felsenhaeuser oder Tempel "
    "herausgehauen worden.");
  AddDetail( ({"tempel", "geheimnisse", "zeitalter", "felsenhaeuser", 
               "haeuser"}), 
    "Geheimnisse von Zeitaltern, zu weit zurueckliegend, um sie zu berechnen, "
    "mag das Innere dieses Tempels bewahren.");
  AddDetail( ("boden"),
    "Der Boden ist sandig.\n");
  AddDetail( ("sand"),
    "Unter dem Sand entdeckst Du eine Steinplatte.\n");
  AddDetail( ({"platte", "steinplatte", "eingang"}), 
    "Vielleicht befindet sich unter der Platte der Eingang zu dem "
    "geheimnisvollen Tempel?");
  AddDetail( ({"ort", "fundament"}), QueryProp(P_INT_LONG));
  AddDetail( ({"welt", "ort", "gegend", "gelaende"}), QueryProp(P_INT_LONG));
  AddDetail( ({"huegel", "gebirge"}), 
    "Die Gipfel sind zu rund und symmetrisch, als das sie beruhigend wirken"
    " koennten.");

  AddCmd(({ "hebe", "heb"}), "platte" );
  AddExit("sueden", ROOM "stadt");
}

platte(str)
{
  notify_fail("Was willst Du anheben?\n");
  if( str=="platte an" || str=="steinplatte an")  
  {
    write(BS(
      "Mit aller Kraft versuchst Du die schwere Steinplatte anzuheben. Du "
      "muehst Dich ab, und schliesslich gelingt Dir das Unmoegliche. Du hebst "
      "die Platte vollstaendig heraus. ")+"\n"+BS(
      "Ploetzlich verlierst Du das Gleichgewicht und stuerzt durch das Loch, "
      "das unter der Platte verborgen war."
      "Erst stuerzt Du, dann rutschst Du nur noch und landest schliesslich "
      "im Inneren des Tempels."));

    this_player()->move(ROOM "bib", M_TPORT, 
       "durch ein Loch", "faellt", "faellt herein");
    say("Die Steinplatte faellt wieder zurueck und versperrt das Loch.\n");
    return 1;
  }
  return 0;
}


