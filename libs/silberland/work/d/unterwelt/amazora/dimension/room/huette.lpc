inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "In der Welt der Grossen Alten");
  SetProp(P_INT_LONG,
    "Von aussen hatte die Huette nur finster ausgesehen; vielleicht ein "
    "kleines bisschen duester mit einer Spur von Bedrohung und dem leichten "
    "Hauch des Unheimlichen. Aber trotzdem nicht mehr, als eine Huette eben, "
    "die seit einem Jahrhundert vergessen und seit vielen Jahrhunderten "
    "verlassen hier im Wald stand. Das war das Aeussere gewesen. Innen war es "
    "unheimlich. Unheimlich und - gefaehrlich!");

  AddDetail( ({"wald", "waelder"}),
   "Der Wald ist draussen vor der Tuer und Du fuerchtest Dich vor ihm.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"wand", "waende", "tuer", "tuere", "bohlen"}),
    "Die Waende sind fensterlos und die Tuer besteht aus schweren,"
    " eisenbeschlagenen Bohlen, die nicht den geringsten Lichtschimmer "
    "und Laut durchlassen. In einer Ecke bemerkst Du eine Wanduhr.");
  AddDetail( ({"luke", "luke"}),
    "Man kann sie oeffnen aber man sollte vorsichtig sein und gut ueberlegen, "
    "ob man das auch wirklich will! Wer weiss was sich darunter verbirgt!");
  AddDetail( ({"wanduhr", "uhr"}),
    "Es scheint die gleiche Wanduhr zu sein, durch die Du in diese Dimension "
    "gelangt bist. Vielleicht kommst Du durch sie auch wieder raus.");
  AddDetail( ({"licht", "schimmer", "lichtschimmer"}),
    "Es kommt kein Lichtschimmer durch die Tuer und Fenster scheint es hier "
    "nicht zu geben. Trotzdem ist alles in ein seltsames gruenes Licht "
    "getaucht.");
  AddDetail( ({"welt", "ort", "raeum", "huette"}), QueryProp(P_INT_LONG));
  AddDetail( ({"tod", "furcht", "grauen",}),
    "Es scheint diese Welt zu beherrschen.");
  AddDetail( ({"strasse", "strassen", "boden"}),
    "Auf dem Boden entdeckst Du eine Luke. ");
  AddDetail( ({"decke", "decke"}),
    "Die Decke droht beinahe einzustuerzen, so alt ist die Huette schon.\n");

  AddCmd(({ "betrete", "betritt"}), "uhr" );
  AddCmd(({"oeffne", "oeffne"}), "luke");

  AddDetail( ({"zeit", "zeitalter"}), "Hier scheint es keine Zeit zu geben.");
  AddExit("raus", ROOM "dimens9");

}

int uhr(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if( str=="uhr" || str=="wanduhr")
  {
    write("Feuer zuckt durch Deine Adern. Ein weisser, unertraeglicher und\n"
    +"schmerzhafter Blitz frisst sich durch Deinen Leib, explodiert tief in Dir\n"
+"drinnen und laesst Dich aufschreien. Der Schmerz steigert sich und es\n"
+"ist nicht nur der koerperliche Schmerz, sondern etwas Unbeschreibliches\n"
+"unsagbar Fremdes, dass Deinen Geist gnadenlos zu versengen scheint.\n"
+"Voellig schweissgebadet kommst Du am anderen Ende des Tores an.\n");

    this_player()->move("/d/unterwelt/clementine/polaris/room/bib", M_TPORT | M_NOCHECK,
      "in die Wanduhr", "klettert", "faellt herein");
    say("Die Tuer der Wanduhr geht wieder zu.\n");
    return 1;
  }
  return 0;
}

int luke(string str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if( str=="luke" || str=="luke")
  {
    write("Ploetzlich verlierst Du das Gleichgewicht und stuerzt durch das Loch, das\n"
+"unter der Luke verborgen war.\n"
+"Erst stuerzt Du, dann rutschst Du nur noch und landest schliesslich \n"
+"auf einer Insel.\n"
);
    this_player()->move(ROOM "insel1", M_TPORT | M_NOCHECK,
      "durch ein Loch", "faellt", "faellt herein");
    say("Die Luke schliesst sich wieder.\n");
    return 1;
  }
  return 0;
}

