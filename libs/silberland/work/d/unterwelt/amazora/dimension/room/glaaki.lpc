inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

int h;

void create()
{
  ::create();
  h = 1;

  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Inneren einer Grotte die fast wie ein Tempel "
    "aussieht. Primitive Altaere, Saeulen und Nischen erblickst Du hier.");

  AddDetail( ({"hoehle", "grotte", "tempel"}), QueryProp(P_INT_LONG));
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"altar", "altaere", "saeulen", "saeule"}), 
    "Dich ueberkommt auf einmal ein befemdlicher Schauder, denn die Altaere "
    "und Saeulen suggerieren vergessene Riten schrecklicher und abstossender "
    "Art!");
  AddDetail( ({"riten", "kult", "art"}), 
    "Du fragst Dich, was fuer ein Menschenschlag einen derartigen Tempel "
    "wohl errichtet haben mag.");
  AddDetail( ({"decke", "fels", "felsgestein", "gestein"}), 
    "Die Decke ist gut zwanzig Fuss ueber Dir und besteht aus massivem "
    "Felsgestein.");
  AddDetail( ({"wand", "waende"}), "In den Waenden sind Nischen eingebaut.");
  AddDetail( ({"kerze", "kerzen"}), 
    "Noch immer fragst Du Dich, wer die hier aufgestellt haben mag, aber "
    "wenn Du Dir es genau ueberlegst, willst Du es eigentlich gar nicht "
    "so genau wissen.");
  AddDetail( ({"nische", "nischen"}), "Kerzen stehen in den Nischen." );
  AddDetail ("boden",
    "Auf dem Boden entdeckst Du ein Pentagramm.\n");
  AddDetail ("pentagramm",
    "Ob man das betreten kann?\n");

  AddCmd("betrete", "betrete");

  AddExit("oben", ROOM "wendigo");
  AddExit("unten", ROOM "shod");
  AddItem( NPC "glaaki", REFRESH_DESTRUCT);

}

string pentagramm()
{
  if (h)
    return "Das Pentagramm leuchtet in einem magischen blau.\n";
  else
    return "Das Pentagramm leuchtet in einem magischen blau.\n";
}

betrete(str)
{
  notify_fail("Was willst Du betreten?\n");
  if (!str || str!="pentagramm")
     return 0;
  if (!h)
    write("Du steigst in das Pentagramm aber nichts passiert.\n");
  else
  {
    h = 0;
    write(BS(
      "Du zoegerst noch ein wenig aber dann steigst Du doch in das "
      "Pentagramm. Ploetzlich durchzuckt Dich ein Schmerz.  Der Schmerz wird "
      "immer schlimmer, aber Du bleibst eisern stehen. Als der Schmerz schier "
      "unertraeglich wird schreist Du wie von Sinnen: 'Iae Yogsothoth! Iae!' "
      "Voellig von Sinnen kommst Du wieder zu Dir und fragst Dich, was "
      "passiert ist."));
    this_player()->heal_self(200);
  }
  return 1;
}

reset()
{
  ::reset();
  h = 1;
}

