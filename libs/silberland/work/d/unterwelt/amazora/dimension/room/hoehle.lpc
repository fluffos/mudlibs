inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp(P_INT_LONG, 
    "Ploetzlich stehst Du in einer duesteren Hoehle, wo ein steriles "
    "Zwielicht regiert. In der Mitte der Hoehle befindet sich ein "
    "schleimiger, schwarzer See und ueber dem Boden ziehen staendig "
    "wallende Nebel hinweg.");

  AddDetail ("zwielicht", 
    "Ein steriles Zwielicht regiert in dieser duesteren Hoehle.\n");
  AddDetail( ({"wasser", "geruch", "metall"}), 
    "Das Wasser schaeumt traege wie geschmolzenes Metall. "
    "Ein fauliger Geruch geht davon aus.");
  AddDetail( ({"nebel", "boden"}), 
    "Ueber den Boden ziehen staendig wallende Nebel hinweg.");
  AddDetail( ({"see", "oberflaeche"}), 
    "Der See gefaellt Dir nicht, trotzdem ueberlegst Du ob man ihn nicht "
    "vielleicht betreten kann.");
  AddDetail( ({"hoehle", "raum"}), QueryProp(P_INT_LONG));
  AddDetail( ({"mitte", "rachen"}), 
    "In der Mitte der Hoehle befindet sich ein See, dessen Oberflaeche "
    "aussieht wie ein riesiger, aufgesperrter, schwarzer Rachen.");
  AddDetail( ({"decke", "wand", "waende", "fels", "felsgestein", "felsen"}), 
    "Die Waende und die Decke sind aus tiefschwarzen Felsgestein.\n");

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_CAVE]) );

  AddExit("oben", ROOM "schacht3");
  AddCmd(({ "betrete", "betritt"}), "see" );

}

see(str)
{
  notify_fail("Was willst Du betreten?\n");
  if( str=="see" || str=="wasser")
  {
    write(
     "Du springst in den See und kommst voellig nass wieder an die "
     "Oberflaeche.\n");
    this_player()->move("/d/unterwelt/clementine/dimension/room/eingang", M_TPORT | M_NOCHECK, 
     "in den See", "springt", "taucht auf und schwimmt ans Ufer");
    say("Die Wellen glaetten sich wieder.\n");
    return 1;
  }
  return 0;
}

