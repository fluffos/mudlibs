inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

int h;

void create()
{
  ::create();

  h = 1;
  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Inneren einer Grotte die fast wie ein Tempel "
    "aussieht. Primitive Altaere, Saeulen und Nischen erblickst Du hier.");
  SetProp(P_INDOORS, 1);

  AddDetail( ({"hoehle", "grotte", "tempel"}), QueryProp(P_INT_LONG));
  AddDetail( ({"altar", "altaere", "saeulen", "saeule"}), 
    "Dich ueberkommt auf einmal ein befemdlicher Schauder, denn die Altaere "
    "und Saeulen suggerieren vergessene Riten schrecklicher und abstossender "
    "Art!");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
  AddDetail( ({"riten", "kult", "art"}), 
   "Du fragst Dich, was fuer ein Menschenschlag einen derartigen Tempel wohl "
   "errichtet haben mag.");
  AddDetail( ({"decke", "fels", "felsgestein", "gestein"}), 
   "Die Decke ist gut zwanzig Fuss hoch und besteht aus massiven Felsgestein.");
  AddDetail( ({"wand", "waende"}), "In den Waenden sind Nischen eingebaut.");
  AddDetail( ({"kerze", "kerzen"}), 
    "Noch immer fragst Du Dich, wer die hier aufgestellt haben mag aber "
    "wenn Du Dir es genau ueberlegst, willst Du es eigentlich gar nicht so "
    "genau wissen.");
  AddDetail( ({"nische", "nischen"}), "Kerzen stehen in den Nischen." );
  AddDetail ("boden",
    "Auf dem Boden liegt ein Stein.\n");
  AddSpecialDetail(({"stein", "steine"}), "stein");

  AddCmd("beruehre", "beruehre");
  AddExit("oben", ROOM "shud");
  AddExit("unten", ROOM "az");
  AddItem( NPC "nya", REFRESH_DESTRUCT);
}

stein()
{
   if (h)
        return "Hmm, einer der Steine sieht irgendwie magisch aus.\n";
    else
        return "Ganz normale Steine.\n";
}

beruehre(str)
{
    notify_fail("Was moechtest Du beruehren?\n");
    if (!str || str!="stein")
        return 0;
    if (!h)
        write("Du beruehrst einen Stein, aber nichts passiert.\n");
    else
    {
       h = 0;
       write("Du beruehrst einen Stein und fuehlst Dich ploetzlich besser.\n");
       this_player()->heal_self(150);
       call_out("my_reset", 600);
    }
    say(TP->Name()+" beruehrt einen Stein.\n");
    return 1;
}

my_reset() { h = 1; }

