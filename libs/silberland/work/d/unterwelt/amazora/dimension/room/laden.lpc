#include <properties.h>
#include "../files.h"
inherit "std/laden";

create() 
{
  replace_program("std/laden");
  ::create();

  SetStorageRoom( ROOM "store");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "Laden");
  SetProp(P_INT_LONG, 
  "Du befindest Dich in einem kleinen verlassenen Laden. Hier kannst Du\n"+
  "Dich ein wenig ausruesten. Folgende Befehle sind moeglich:\n"+
  "        zeige                    kaufe <gegenstand> (oder nummer)\n"+
  "        zeige rue(stungen)       verkaufe <gegenstand>\n"+
  "        zeige waf(fen)           verkaufe alles\n"+
  "        zeige ver(schiedenes)    schaetze <gegenstand>\n"+
  "Du kannst den Laden nach Sueden verlassen.\n");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail ("boden", "Du stehst drauf.\n");
  AddDetail ("decke", "Die ist ueber Dir.\n");
  AddDetail("laden", 
    "Der Laden ist voellig verlassen aber seltsamer Weise kannst Du hier "
    "trotzdem was kaufen.");
  AddExit("sueden", ROOM "stadt3");
}
