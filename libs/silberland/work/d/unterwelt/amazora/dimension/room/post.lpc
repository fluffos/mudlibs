inherit "/std/post";
#include <properties.h>
#include "../files.h"

create() 
{
  ::create();

  SetProp(P_INT_SHORT,"Ein Postamt");
  SetProp(P_INT_LONG, 
    "Seltsamerweise gibt es hier in dieser Stadt sogar ein Postamt. Wie in "
    "jedem anderen Postamt kannst Du hier Briefe lesen und schreiben. Wenn Du "
    "Post lesen oder schreiben willst, tippe 'post' oder 'mail', bzw. 'mail "
    "<spieler>'.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

  AddDetail("postamt", "Du stehst mittendrin.");
  AddDetail( ({"briefe", "post"}), 
    "Du kannst hier Briefe an Deine Mitspieler verschicken und auch lesen.");
  AddDetail("mitspieler", "Mach 'wer' oder 'kwer'!");
  AddDetail("boden", "Ziemlich staubig hier.");
  AddDetail( ({"wand", "waende"}), "Auch die Waende sind aeusserst staubig.");
  AddDetail("staub", 
    "Sieht so aus, als ob hier schon laenger keiner mehr war.");
  AddDetail("decke", "Von der Decke haengt ein schoener Kronleuchter.");
  AddDetail("kronleuchter", "Er ist zu weit oben.");
  AddDetail("stadt", 
    "Du kannst das Postamt nach Norden verlassen, dann bist Du mitten in der "
    "Stadt.");

  AddExit("norden", ROOM "stadt1");

}

