inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

create()
{
  ::create();

  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "Ein geheimer Raum");
  SetProp(P_INT_LONG, 
    "Ein unglaublicher Gestank erfuellt diesen Raum. Die Waende sind auch "
    "hier mit Regalen vollgestellt. Dies scheint eine Geheimbibliothek zu "
    "sein. Ueberdies liegen grosse, ungeordnete Buecherstapel auf dem "
    "Fussboden und in primitiven Kisten.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({"buecher", "schriften", "buecherstapel"}), 
    "Offensichlich scheinen die Buecher und Schriften uralt zu sein.");
  AddDetail( ({"raum", "ort", "bibliothek", "geheimbibliothek"}),
    QueryProp(P_INT_LONG));
  AddDetail( ({"wand", "waende"}), "Die Waende sind mit Regalen vollestellt.");
  AddDetail( ({"kiste", "kisten"}), 
    "In den Kisten liegen uralte Buecher und Schriften.");
  AddDetail( ({"regal", "regale"}), 
    "In den Regalen sind viele Buecher. Ein besonders altes Buch faellt "
    "Dir auf.");
  AddDetail( ({"altes buch"}), 
    "Ein ganz in Leder eingbundenes schwarzes Buch. Es scheint uralt zu "
    "sein. Du kannst es lesen, wenn Du mutig genug bist. Vielleicht stehen "
    "ja ein paar nuetzliche Informationen drin.");
  AddDetail("buch", 
    "Welches Buch meinst Du denn? Hier sind eine Menge Buecher.");
  AddSmell( ({"luft","geruch", "moder", "gestank"}), 
    "Ziemlich vermodert riecht es hier.");
  AddSmell( DEFAULT_SMELL, "Ziemlich vermodert riecht es hier.\n" );
  AddDetail( ({"boden", "fussboden", "staub"}), "Der Boden ist staubig.");
  AddDetail( ({"decke", "spinnweben"}), "Spinnweben haengen von der Decke.");
  AddReadDetail( ({"buch", "altes buch"}), 
   "Die ALTEN waren, die ALTEN sind und die ALTEN werden sein. Nicht in den "
   "Raeumen, die uns bekannt sind, sondern zwischen ihnen gehen sie gelassen "
   "und unbeirrt umher, ohne Dimension und fuer unsere Augen unsichtbar. "
   "YOG-SOTHOTH kennt das Tor. YOG-SOTHOTH ist das Tor. YOG-SOTHOTH ist "
   "Schluessel und Waechter des Tores. Vergangenheit, Gegenwart, Zukunft, "
   "alles ist YOG-SOTHOT. Er weiss wo einst die GROSSEN ALTEN herausbrachen "
   "und wo sie wieder herausbrechen werden. Iae! Shub_Niggurath! An ihrem "
   "Geruch sollt ihr sie erkennen!");

  AddExit("oben", ROOM "bib");

}

