inherit "std/room";

#include <properties.h>
#include <moving.h>
#include "../files.h"

void create()

{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Auf einer duesteren Insel");
  SetProp(P_INT_LONG, 
    "Du wanderst weiter ueber diese finstere Insel, die so dunkel ist, wie "
    "eine sternenklare Polarnacht, die von einer Kaelte erzaehlt, die man "
    "tatsaechlich zu spueren glaubt, je weiter man ins Innere dieser Insel "
    "dringt." );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 10, ENV_TERRAIN:TT_PLAIN]) );
  AddDetail( ({"kaelte", "nacht", "polarnacht"}),
    "Die sternenklare Polarnacht, erzaehlt von einer Kaelte, die man fast zu "
    "spueren vermag.");
  AddDetail( ({"himmel", "sterne", "stern"}),
    "Keinen Stern vermag man am Himmel zu erblicken, so dunkel ist er.\n");
  AddDetail( ({"insel", "inseln", "eiland"}), 
    "Das Eiland besteht aus zerklueftetem Fels, der eine Farbe aufweist, "
    "die so unsagbar fremd ist, so unsagbar dunkel." );
  AddDetail( ({"farbe", "fels"}), 
    "Die Farbe des Felsens ist so intensiv, als waere diese Insel nicht "
    "materiell, nichts was war, sondern ein gewaltiger Riss, der in der "
    "Wirklichkeit klafft." );
  AddDetail( ({"riss", "wirklichkeit"}), 
    "Etwas lauert hinter diesem Riss. Es beobachtet und es wartet." );
  AddDetail( ({"boden", "schacht"}), 
    "Als Du den Boden genauer betrachtest, faellt Dir ein Loch auf.");
  AddDetail( ({"loch", "loch"}), 
    "Ein Loch ist im Boden, gerade so gross, dass Du durchpasst.");

  AddCmd(({ "kletter", "klettere"}), "loch" );

  AddExit("norden", ROOM "insel1");
}

int loch(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if( str=="in loch" || str=="in schacht")
  {
    write("Du zwaengst Dich durch das Loch und kletterst in den Schacht.\n");
    this_player()->move(ROOM "schacht", M_TPORT, 
      "durch ein Loch", "klettert", "klettert herein");
    return 1;
  }
  return 0;
}

