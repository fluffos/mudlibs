inherit "/std/room";
#include <properties.h>
#include <language.h>
#include "../files.h"

create() 
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "In der Welt der Grossen Alten");
  SetProp(P_INT_LONG, 
    "Das Gelaende steigt ploetzlich an, und die mit wilden Rosen bewachsenen "
    "Steinwaelle am Rand der staubigen, gewundenen Strasse ruecken immer "
    "naeher zusammen. ");

  AddDetail( ({"welt", "ort", "gegend", "gelaende"}), QueryProp(P_INT_LONG));
  AddDetail( ({"strasse", "staub", "weg", "boden"}), 
    "Die Strasse ist staubig und gewunden.\n");
  AddDetail( ({"mond", "himmel", "firmament"}), 
    "Der Mond haengt boese und tief am Firmament.\n");
  AddDetail( ({"tod", "furcht", "grauen"}), 
    "Es scheint diese Welt zu beherrschen.");

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HILL]) );
  AddDetail( ({"rose", "rosen", "steinwall", "steinwaelle"}), 
    "Die Steinwaelle sind mit den wilden Rosen voellig ueberwuchert.");
  AddDetail( ({"strasse", "strassen"}), "Wo sie wohl hinfuehren mag? ");

  AddExit("osten", ROOM "dimens5");

}
