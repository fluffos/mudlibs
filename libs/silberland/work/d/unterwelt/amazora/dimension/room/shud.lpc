inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

int h;

void create()
{
  ::create();
  h = 1;

  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Inneren einer Grotte die fast wie ein Tempel "
    "aussieht. Primitive Altaere, Saeulen und Nischen erblickst Du hier.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_CAVE]) );
  SetProp(P_INDOORS, 1);

  AddDetail( ({"hoehle", "grotte", "tempel"}), QueryProp(P_INT_LONG));
  AddDetail( ({"altar", "altaere", "saeulen", "saeule"}), 
    "Dich ueberkommt auf einmal ein befemdlicher Schauder, denn die Altaere "
    "und Saeulen suggerieren vergessene Riten schrecklicher und abstossender "
    "Art!");
  AddDetail( ({"riten", "kult", "art"}), 
    "Du fragst Dich, was fuer ein Menschenschlag einen derartigen Tempel wohl "
    "errichtet haben mag.");
  AddDetail( ({"decke", "fels", "felsgestein", "gestein"}), 
    "Die Decke ist gut zwanzig Fuss ueber Dir und besteht aus massivem "
    "Felsgestein.");
  AddDetail( ({"yogsothoth", "yog"}), 
    "Yog-Sothoth ist das Tor. Yog-Sothoth ist Schluessel und Waechter des "
    "Tores. Vergangenheit, Gegenwart, Zukunft, alles ist Yog-Sothoth.");
  AddDetail( ({"wand", "waende"}), 
    "In den Waenden sind Nischen eingebaut. Doch an einer bemerkst Du eine "
    "Zeichnung");
  AddDetail( ({"kerze", "kerzen"}), 
    "Noch immer fragst Du Dich, wer die hier aufgestellt haben mag aber wenn "
    "Du Dir es genau ueberlegst, willst Du es eigentlich gar nicht so genau "
    "wissen.");
  AddDetail( ({"nische", "nischen"}), "Kerzen stehen in den Nischen." );
  AddDetail ("boden",
    "Der Boden ist staubig.\n");
  AddSpecialDetail(({"zeichnung", "zeichnung"}), "zeichnung");

  AddCmd("bete", "bete");

  AddExit("oben", ROOM "cthuga");
  AddExit("unten", ROOM "bya");
  AddItem( NPC "shudde", REFRESH_DESTRUCT);
}

string zeichnung()
{
   if (h)
      return "Die Zeichnung zeigt Yogsothoth. Er wird von vielen angebetet.\n";
    else
      return "Ein Bild von Yogsothoth.\n";
}

int bete(string str)
{
    notify_fail("Wen moechtest du anbeten?\n");
    if (!str || str!="yogsothoth an")
        return 0;
    if (!h)
        write("Du betest ein bisschen zu Yogsothoth.\n"); 
    else
    {
        h = 0;
        write("Du betest Yoghsothoth an und fuehlst Dich prima.\n");
        this_player()->heal_self(200);
    }
    return 1;
}

reset()
{
  ::reset();
  h = 1;
}


