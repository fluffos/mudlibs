inherit "/std/room";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "../files.h"

void create()
{
  :: create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Auf einer unheimlichen Insel");
  SetProp(P_INT_LONG, 
    "Du erreichst eine Insel. Irgend etwas stimmt mit dieser Insel nicht. "
    "Du hast immer staerker das Gefuehl, eine Grenze ueberschritten zu "
    "haben. Du weisst nicht was dahinter liegt aber was es auch ist - es "
    "macht Dir Angst." );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_PLAIN]) );

  AddDetail("himmel", 
    "Ein Himmel, den niemals eine Sonne beschienen hatte, bar jeden "
    "Sternes, beherrscht vom grinsenden Knochengesicht eines bleichen "
    "Totenmondes.");
  AddDetail("mond", 
    "Hoch am Himmel haengt ein bleicher, knochenweisser Mond.");
  AddDetail( ({"boden", "haut", "tier"}), 
    "Der Boden zuckt und bebt, wie die schrundige Haut eines gewaltigen "
    "und haesslichen Tieres.");
  AddDetail ("angst", 
    "Diese Insel hier macht Dir maechtig Angst. \n"
    "Eigentlich willst Du nur noch weg hier.\n");
  AddDetail(( {"insel", "inseln", "fels", "eiland", "farbe", "nacht"}), 
    "Das Eiland besteht aus zerklueftetem Fels, der eine seltsame Farbe "
    "aufweisst, die Du nie zuvor gesehen hast. Es ist die Farbe der Nacht.");
  AddDetail( ({"gefuehl", "ahnung", "warnung", "gedanke", "stimme"}), 
    "Du hast das Gefuehl als wuerden Dich innere Stimmen warnen, diese "
    "Insel zu betreten. Als wuerden sie Dir zufluestern: Geh weg! Geh weg, "
    "solange es noch geht!");
  AddDetail(( {"grenze", "grenzen"}), 
    "Eine nicht erkennbare Grenze aber dennoch hoechst real." );
  AddSound (DEFAULT_SOUND, "Wem oder was willst Du lauschen?\n");
  AddSound (({"stimme","stimmen"}),
    "Du hast das Gefuehl als wuerden sie Dir eine Warnung zufluestern: "
    "Geh weg! Geh weg solang es noch geht!");

  AddExit("sueden", ROOM "insel2");

}
