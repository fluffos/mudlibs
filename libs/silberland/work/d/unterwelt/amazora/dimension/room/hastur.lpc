inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

int h;
int ist_da;

void create()
{
  ::create();
  h = 1;

  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Inneren einer Grotte die fast wie ein Tempel "
    "aussieht. Primitive Altaere, Saeulen und Nischen erblickst Du hier.");

  AddDetail( ({"hoehle", "grotte", "tempel"}), QueryProp(P_INT_LONG));
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"altar", "altaere", "saeulen", "saeule"}), 
    "Dich ueberkommt auf einmal ein befemdlicher Schauder, denn die Altaere "
    "und Saeulen suggerieren vergessene Riten schrecklicher und abstossender "
    "Art!");
  AddDetail( ({"riten", "kult", "art"}), 
    "Du fragst Dich, was fuer ein Menschenschlag einen derartigen Tempel "
    "wohl errichtet haben mag.");
  AddDetail( ({"decke", "fels", "felsgestein", "gestein"}), 
    "Die Decke ist gut zwanzig Fuss ueber Dir und besteht aus massiven "
    "Felsgestein.");
  AddDetail( ({"yogsothoth", "yog"}), 
    "Yog-Sothoth ist das Tor. Yog-Sothoth ist Schluessel und Waechter des "
    "Tores. Vergangenheit, Gegenwart, Zukunft, alles ist Yog-Sothoth.");
  AddDetail( ({"wand", "waende"}), "In den Waenden sind Nischen eingebaut.");
  AddDetail( ({"kerze", "kerzen"}), 
    "Noch immer fragst Du Dich, wer die hier aufgestellt haben mag aber "
    "wenn Du Dir es genau ueberlegst, willst Du es eigentlich gar nicht so "
    "genau wissen.");
  AddDetail( ({"nische", "nischen"}), "Dir faellt eine Kiste auf." );
  AddDetail ("boden",
    "Der Boden ist staubig.\n");
  AddDetail( ({"flakon"}), 
    "Wenn Du mutig genug bist, kannst Du ja aus ihm trinken.");
  AddSpecialDetail(({"kiste", "kiste"}), "kiste");

  AddCmd("oeffne", "oeffne");
  AddCmd( ({ "trink", "trinke" }), "trink");

  AddGuardedExit("oben", ROOM "itha",
    "hastur", "Hastur laesst Dich nicht vorbei.\n");
  AddExit("unten", ROOM "cthuga");

  AddItem( NPC "hastur", REFRESH_DESTRUCT);

}

int oeffne(string str)
{
  notify_fail("Was willst Du denn oeffnen?\n");
  if(str=="kiste") 
  {
    write("Du oeffnest eine Kiste und findest einen Flakon.\n");
    return 1;
  }
  return 0;
}

void reset()
{   
  ::reset();
  ist_da = 0;
  h = 1;

}

string kiste()
{
  if (h)
        return "Du koenntest sie oeffnen.\n";
    else
        return "Die Kiste ist leer.\n";
}

trink(str)
{
    notify_fail("Woraus willst Du trinken?\n");
    if (!str || str!="aus flakon")
        return 0;
    if (!h)
        write("Nix da woraus Du trinken koenntest.\n");
  else
  {
    h = 0;
    write(BS(
      "Du trinkst aus einem seltsamen Flakon und faellst in Ohnmacht. "
      "Als Du wieder zu Dir kommst, fuehlest Du Dich komischerweise "
      "geheilt."));
    this_player()->heal_self(200);
   }
  return 1;
}


