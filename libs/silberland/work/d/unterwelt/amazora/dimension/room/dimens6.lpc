inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

create()
{

  ::create();
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "In der Welt der Grossen Alten");
  SetProp(P_INT_LONG,
    "Schluchten und Felsspalten von gefaehrlicher Tiefe durchschneiden den "
    "Weg, und die rohgezimmerten Holzstege scheinen nur von fragwuerdiger "
    "Sicherheit. Senkt sich die Strasse wieder, so gelangt man in eine weite "
    "Sumpflandschaft, gegen die man instinktiv Widerwillen empfindet. ");

  AddDetail( ({"weg", "schluchten", "tiefe"}),
    "Schluchten von gefaehrlicher Tiefe durchschneiden den Weg.");
  AddDetail( ({"sumpf", "sumpflandschaft", "landschaft"}),
    "Eine Sumpflandschaft, gegen die man instinktiv Widerwillen empfindet.\n");
  AddDetail( ({"welt", "ort", "gegend", "gelaende"}), QueryProp(P_INT_LONG));
  AddDetail( ({"boden", "staub"}), "Der Boden ist staubig.\n");
  AddDetail( ({"himmel", "dunkelheit", "reservoir"}),
    "Ein Reservoir der Dunkelheit, so schwarz.\n");
  AddDetail( ({"schlucht", "schluchten"}),
    "Sei bloss vorsichtig, dass Du in keine faellst!");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
  AddDetail( ({"spalte", "felsspalte", "felsspalten", "spalten"}),
    "In den Felsspalten befinden sich Risse.");
  AddDetail( ({"riss", "risse"}),
    "Die Risse sind gross genug, um durch zu klettern.");
  AddDetail( ({"strasse", "strassen"}), "Wo sie wohl hinfuehren mag? ");
  AddDetail( ({"holzsteg", "steg", "holzstege"}),
    "Sie scheinen nicht sehr sicher zu sein. ");
  AddDetail( ({"sicherheit", "sicher"}),
    "Sicherheit? Sicher fuehlst Du Dich hier nicht! ");

 AddExit("westen", ROOM "dimens5");
 AddCmd( ({"kletter", "klettere"}), "spalte");

}

int spalte(string str)
{
  notify_fail("Durch was willst du klettern?\n");
  if( str=="durch spalte" || str=="durch felsspalte")
  {
    write("Du gelangst wieder in die normale Welt.\n");
    this_player()->move("/d/unterwelt/clementine/polaris/room/kneipe",
      M_TPORT | M_NOCHECK,
      "durch die Felsspalte", "klettert", "klettert herein");
    return 1;
  }
  return 0;
}

