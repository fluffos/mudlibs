inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Inneren einer Grotte, die fast wie ein Tempel "
    "aussieht. Primitive Altaere, Saeulen und Nischen erblickst Du hier.");
  SetProp(P_INDOORS, 1);

  AddDetail( ({"hoehle", "grotte", "tempel"}), QueryProp(P_INT_LONG));
  AddDetail( ({"altar", "altaere", "saeule", "saeulen", "nische", "nischen"}), 
    "Dich ueberkommt auf einmal ein befremdlicher Schauer, denn die Altaere "
    "suggerieren vergessene Riten schrecklicher und abstossender Art!");

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20]) );
  AddDetail( ({"riten", "kult", "art"}), 
    "Du fragst Dich, was fuer ein Menschenschlag einen derartigen Tempel wohl "
    "errichtet haben mag.");
  AddDetail( ({"decke", "felsen", "fels", "felsgestein"}), 
    "Die Decke ist gut zwanzig Fuss hoch und besteht aus massivem "
    "Felsgestein.");
  AddDetail( ({"wand", "waende"}), "In den Waenden sind Nischen eingebaut."); 
  AddDetail( ({"fussboden", "boden"}), 
   "Der Boden besteht aus massivem Felsgestein.");
  AddExit("unten", ROOM "wendigo");
  AddItem( NPC "cthulhu", REFRESH_DESTRUCT);
}

