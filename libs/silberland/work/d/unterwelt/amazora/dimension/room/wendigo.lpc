inherit "std/room";
#include <properties.h>
#include <moving.h>
#include "../files.h"

int h;

void create()
{
  ::create();
  h = 1;

  SetProp(P_INT_SHORT, "In einer Hoehle");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Inneren einer Grotte die fast wie ein Tempel "
    "aussieht. Primitive Altaere, Saeulen und Nischen erblickst Du hier.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_CAVE]) );

  AddDetail( ({"hoehle", "grotte", "tempel"}), QueryProp(P_INT_LONG));
  AddDetail( ({"altar", "altaere", "saeule", "saeulen", "nische", "nischen"}), 
    "Dich ueberkommt auf einmal ein befremdlicher Schauer, denn die Altaere "
    "suggerieren vergessene Riten schrecklicher und abstossender Art!");
  AddDetail( ({"riten", "kult", "art"}), 
    "Du fragst Dich, was fuer ein Menschenschlag einen derartigen Tempel "
    "wohl errichtet haben mag.");
  AddDetail( ({"decke", "felsen", "fels", "felsgestein"}), 
    "Die Decke ist gut zwanzig Fuss ueber Dir und besteht aus massivem "
    "Felsgestein.");
  AddDetail( ({"wand", "waende"}), "In den Waenden sind Nischen eingebaut.");
  AddDetail( ({"fussboden", "boden"}), 
    "Vom Boden her steigt ein ekelhafter Geruch auf.");
  AddDetail( ({"gerueche", "geruch"}), 
    "Gerueche sieht man nicht, man riecht sie.");

  AddCmd("rieche", "rieche");

  AddExit("oben", ROOM "cthulhu");
  AddExit("unten", ROOM "glaaki");

  AddItem(NPC "wendigo", REFRESH_DESTRUCT);
}

int rieche(string str)
{
  if (!str || str!="geruch")
    return 0;
  if (!h)
    write(BS("An ihrem Geruch sollt ihr Sie erkennen. Ihre Hand ist an eurer "
             "Kehle, und doch seht ihr Sie nicht."));
  else 
  {
    h = 0;
    write(BS("Du schnupperst ein wenig herum. Dir wird uebel und Du musst "
             "Dich uebergeben."));
    this_player()->heal_self(200);
  }
  return 1;
}


reset()
{
  ::reset();
  h = 1;
}
