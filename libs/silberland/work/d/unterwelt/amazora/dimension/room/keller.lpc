inherit "/std/room";

#include <language.h>
#include <properties.h>
#include <moving.h>
#include "../files.h"

void create()
{
  ::create();

  SetProp(P_INDOORS,1);
  SetProp( P_LIGHT, 0 );
  SetProp( P_INT_SHORT, "Am Fusse einer Treppe");
  SetProp( P_INT_LONG,
    "Du stehst in den Gewoelben des Kellers, die hier vor langer Zeit in den "
    "dunklen Fels getrieben wurden. Von dem Gestein geht eine merkliche "
    "Kuehle aus. Eine steinerne Wendeltreppe fuehrt aus dem Keller hinaus.");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 5, ENV_TERRAIN:TT_CAVE]) );

  AddDetail( ({ "gewoelbe", "keller" }),
   "Es muss unmenschliche Anstrengungen gekostet haben, dem Gestein diese "
   "Hohlraeume abzutrotzen.");
  AddDetail( ({ "hohlraeume", "raeume" }),
    "Du befindest Dich in ihnen.");
  AddDetail( ({ "gestein", "stein","fels"}),
    "Das Gestein ist seiner Haerte entsprechend sehr rauh und nur grob "
    "bearbeitet.");
  AddDetail( ({ "kuehle", "kaelte" }),
    "Die unangenehme Kuehle jagt Dir ein Kribbeln ueber den gesamten Koerper. "
    "Unwillkuerlich spannen sich Deine Muskeln an.");
  AddDetail( ({ "boden", "fussboden" }),
   "Der Boden ist hier sehr uneben. Du musst bei jedem Schritt aufpassen, "
   "dass Du nicht stolperst. Gerade eben waerst Du beinahe wieder wegen "
   "einer dieser Unebenheiten hingefallen. Der Baumeister dieses Kellers "
   "gehoert verklagt!");
  AddDetail( ({ "wand", "waende" }),
    "Die Waende wirken ein wenig schief auf Dich, anscheinend wurde bei "
    "ihrem Bau wenig auf solche Feinheiten geachtet.");
  AddDetail( ({ "decke" }),
    "Die Decke ist erstaunlich hoch, beziehungsweise der Boden ist "
    "erstaunlich niedrig. Du fragst Dich, fuer Kreaturen welcher Groesse "
    "diese Kellergewoelbe erbaut wurden.");
  AddDetail( ({ "schritt" }),
    "Deine Schritte hallen leise im Gang wieder.");
  AddDetail( ({ "kribbeln" }),
    "Pass auf, dass Du Dir keine Erkaeltung holst.");
  AddDetail( ({ "kreaturen", "kreaturen" }),
    "Bislang siehst Du hier noch keine.");
  AddDetail( ({ "feinheiten" }),
    "Die suchst Du hier vergebens.");
  AddDetail( ({ "groesse" }),
    "Fuer Dich ist es allemal geraeumig genug.");
  AddDetail( ({ "muskeln" }),
    "Deine Muskeln sind natuerlich stark und wohlgeformt (wir sind hier ja "
    "schliesslich in einem Fantasy-Spiel).");
  AddDetail( ({ "anstrengungen", "anstrengung" }),
    "Wenn Du die Augen schliesst kannst Du geradezu den Schweiss der Arbeiter "
    "riechen.");
  AddDetail( ({ "schweiss" }),
    "Oder ist es Dein eigener?");
  AddDetail( ({ "arbeiter" }),
    "Die siehst Du weder mit geschlossenen, noch mit offenen Augen.");
  AddDetail( ({ "spiel" }),
    "Dies ist alles nur ein Spiel.");
  AddDetail( ({ "koerper" }),
    "Dein Koerper ist seltsamerweise genauso beschaffen, wie Du ihn Dir "
    "immer vorgestellt hast.");
  AddDetail( ({ "treppe", "wendeltreppe" }),
    "Die steinerne Wendeltreppe fuehrt wieder hinauf ins Erdgeschoss und "
    "ins Obergeschoss. Vielleicht solltest Du sie besser benutzen.");
  AddDetail( ({ "erdgeschoss", "obergeschoss" }),
    "Zu ihnen gelangst Du ueber die Treppe.");
  AddDetail( ({ "haerte" }),
    "Hart wie Stein.");
/*  AddDetail( ({ "gang" }),
    "Du kannst ihm nach Westen folgen, aber vielleicht willst Du das gar "
    "nicht.");
*/
  AddDetail( ({ "baumeister" }),
    "Der ist leider nicht hier, sonst haettest Du ihm schon Deine Meinung "
    "gesagt." );
  AddDetail( ({ "unebenheiten" }),
    "Die Unebenheiten des Bodens sind tueckisch, besonders da man hier unten "
    "sowieso nicht gut sieht. Ploetzlich faellt Dir an einer der Unebenheiten "
    "etwas auf. Sie sieht etwas anders aus..." );
  AddDetail( ({ "unebenheit" }),
    "Als Du eine der Unebenheiten genauer betrachtest, erkennst Du, dass es "
    "sich um einen im Boden eingelassenen Metallring handelt." );
  AddDetail( ({ "ring", "metallring" }),
    "Der Metallring im Boden ist wohl zum Oeffnen einer Falltuer gedacht.");
  AddDetail( ({ "falltuer" }),
    "Du siehst keine Falltuer. Das einzige Anzeichen dafuer, dass sich hier "
    "eine befindet, ist der Metallring im Boden." );

  AddExit("oben", ROOM "kapelle");
  AddCmd(({"ziehe"}), "ziehen");
  AddCmd(({"oeffne"}), "falltuer");
}

int falltuer(string str)
{
  if( str != "falltuer")
  {
    notify_fail("Was willst Du oeffnen?\n");
    return 0;
  }

  write("Du ziehst fest am Metallring und oeffnest so die Falltuer im Boden.\n"
        "Schnell kletterst Du hinunter und machst sie ueber Dir wieder zu.\n");
  TP->move("/d/unterwelt/basics/central/room/treppe1.lpc", M_GO, "",
    "oeffnet eine Falltuer im Boden und klettert schnell durch",
    "kommt durch eine Falltuer in der Decke hereingeklettert");
  return 1;
}


int ziehen(string str)
{
  notify_fail("Woran willst Du ziehen?\n");
  if(str!="ring" && str!="metallring" && str!="an ring" && str!="an metallring")
    return 0;
  else
    return falltuer("falltuer");
}

