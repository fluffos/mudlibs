inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT, "Auf einem Friedhof");
  SetProp(P_INT_LONG, 
    "Du befindest Dich an einer duesteren Staette, ueber die staendig "
    "wallende Nebel hinwegziehen. Manchmal kannst Du einen "
    "markerschuetternden Schrei hoeren. Ansonsten ist es voellig still. "
    "TOTENSTILL!");
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 8, ENV_TERRAIN:TT_PLAIN]) );

  AddDetail( ({"raum", "staette", "friedhof"}), 
    "Du stehst hier auf einem kleinen Friedhof. Auf einem kleinen Huegel "
    "suedlich von hier siehst Du eine kleine Kapelle die Du betreten kannst.");
  AddDetail("boden", "Wallende Nebel ziehen ueber den Boden hinweg.\n");
  AddDetail("nebel", "Buaaah, gruselig!\n");
  AddDetail( ({"huegel", "kapelle"}), 
    "Auf dem Huegel im Sueden steht still und verlassen eine Kapelle. Du kannst"
    " sie betreten."); 
  AddSound (DEFAULT_SOUND, "Du hoerst nichts, es ist still. Totenstill!\n");

  AddCmd( ({"betrete", "betritt"}), "kapelle" );

  AddExit("norden", ROOM "stadt4");

  AddItem( NPC "gruftie", REFRESH_DESTRUCT);

}

int kapelle(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if( str=="kapelle" || str=="kapelle")
  {
    write("Du oeffnest eine verrostete Tuer und betrittst eine Kapelle.\n");
    this_player()->move(ROOM "kapelle", M_TPORT | M_NOCHECK, 
       "in die Kapelle", "geht", "kommt herein");
    say("Die Tuer der Kapelle faellt wieder zu.\n");
    return 1;
  }
  return 0;
}

