//  28.06.98 Angrox: Class CL_DEMON added
//

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h>
#include <class.h>
#include <moving.h>
#include <new_skills.h>
#define LOG(x) "/players/amazora/log/" + x
inherit "std/npc";

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_SHORT, "Yibb-Tsstl");
  SetProp(P_LONG, 
    "Das ist Yibb-Tsstl. Ein Wesen von geringerer Macht, trotzdem noch "
    "schrecklicher als Goetter in ihrem Zorn.");
  SetProp(P_NAME, "Yibb-Tsstl");
  SetProp(P_GENDER, 1);
  AddId("alter");
  AddId("yibb");
  AddId("tsstl");
  AddId("yibb-tsstl");
  AddClass(CL_DEMON);
  create_default_npc(22);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, -900);
  
  SetProp(P_RACE, "Daemon");
  SetProp(P_HANDS, ({" mit der fuerchterlichen Magie der Grossen Alten",
          QueryProp(P_HANDS)[1],DT_MAGIC}));
  SetProp(P_NOMAGIC,40);
  set_living_name("yibb-tsstl");
  SetProp(P_KILL_MSG, "Die Zeit ist gekommen! Wir sind wieder da!");
  SetProp(P_MSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGOUT, "poltert davon");
  SetProp(P_MSGOUT, "poltert davon");
  SetProp(P_BODY, 170);
  SetProp(P_SPELLRATE, 60);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.6, DT_COLD:      -0.6, DT_WATER:  -0.6, DT_AIR:    -0.6, 
      DT_LIGHTNING: -0.6, DT_EXPLOSION: -0.6, DT_SOUND:  -0.6, DT_LIGHT:  -1.0,
      DT_ELECTRIC:  -0.6, DT_ACID:      -0.6, DT_POISON: -0.6, DT_TERROR: -1.0,
      DT_HOLY:       0.2, DT_UNHOLY:    -1.0, DT_MAGIC:  -0.9 ]) );
  
  AddSpell(1,400,
    "Yibb-Tsstl schreit fuerchterlich.\n",
    "Yibb-Tsstl schreit fuerchterlich.\n",
    ({DT_SOUND, DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
  AddSpell(2,800,
    "Yibb-Tsstl reisst Dir die Seele aus dem Leib.\n",
    "Yibb-Tsstl reisst @WEM die Seele aus dem Leib.\n",
    ({DT_RIP, DT_PIERCE}),([SP_SHOW_DAMAGE:1]));
  SetAttackChats(25, ({
    "Yibb-Tsstl faengt wie wahnsinnig an zu lachen.\n"}) );
}

void die(int poisondeath)
{
  object item;
  if((item=present("\npaladintaskitem", this_player())) && item->GetTask(14, this_player()))
    item->SetFlag(11);
  write_file(LOG("yibb.kills"),
    ctime()+": "+CAP(getuid(PL))+" killt Yibb-Tsstl .\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG("yibb.deads"),
    ctime()+": Yibb-Tsstl hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}
