//  28.06.98 Angrox: Class CL_DEMON added
//


#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>
#include <class.h>
#include "../files.h"
inherit "std/mnpc";

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Shogotte");
  SetProp(P_LONG,
    "Ein Diener der Grossen Alten. Geschaffen aus unheiligen Protoplasma. "
    "Eine furchtbare Kreatur, die ihre Gestalt nach belieben veraendern "
    "kann.");
  SetProp(P_NAME, "Shogotte");
  SetProp(P_GENDER, 1);
  AddId("shogotte");
  AddClass(CL_DEMON);
  create_default_npc(15);
  SetProp(P_LEVEL, 18);
  set_living_name("shogotte");
  SetProp(P_BODY, 90);
  SetProp(P_HANDS, ({" mit den Maechten der Finsternis", 90}));
  SetProp(P_ALIGN, -900);
  SetProp(P_RACE, "Daemon");

  seteuid(getuid(this_object()));
  clone_object(OBJ "muellkutte")->move(this_object());
  command("ziehe kutte an");
  clone_object(OBJ "muellschwert")->move(this_object());
  command("zuecke schwert");
  SetProp(P_AGGRESSIVE, 1);
  SetProp (P_MNPC_AREA, ROOM "dimens");
  SetProp (P_MNPC_DEFAULTROOM, ROOM "dimens1" );
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);
}

