#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h>
#include <moving.h>
#include "../files.h"
#define LOG(x) "/players/amazora/log/" + x
inherit "std/npc";

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Bibliothekar");
  SetProp(P_LONG, 
    "Das ist Howard, ein Bilbliothekar. Er huetet schon seit Jahren die "
    "Geheimnisse der Bibliothek. Vielleicht kann er Dir ja ein paar "
    "Fragen beantworten?");
  SetProp(P_SIZE, 180);
  SetProp(P_BODY, 100);
  AddId("bibliothekar");
  AddId("howard");
  create_default_npc(20);
  set_living_name("Bibliothekar");
  SetProp(P_HANDS, ({"mit seinen Haenden", 100}));
  SetProp(P_ALIGN, 1000);
  SetProp(P_RACE, "Mensch");
  
  SetProp(P_NAME, "Howard");
  SetProp(P_LOG_INFO, 1);
  SetProp(P_RESISTANCE, ({ DT_FIRE}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_DEFAULT_INFO, 
    "seufzt: Ach, ihr stellt immer so viele Fragen...\n");
  AddInfo("necronomicon", 
    "Es wurde mir von den Satansanbetern gestohlen. Es ist ein ungeheuer "
    "wichtiges Buch und in den falschen Haenden hoechst gefaehrlich!",
    "sagt: ");
  AddInfo("buch", 
   "sagt:Meinst Du das Necronomicon?\n");
  AddInfo( ({"yogsothoth", "yog"}), 
    "Yog-Sothoth ist das Tor. Yog-Sothoth ist Schluessel und Waechter "
    "des Tores. Vergangenheit, Gegenwart, Zukunft, alles ist Yog-Sothoth.",
    "fluestert: ");
  AddInfo( ({"azathoth", "az"}),
    "Azathoth, der Blasenschlagende im Zentrum der Unendlichkeit.",
    "fluestert: ");
  AddInfo( ({"shubb-niggurath", "shubb", "niggurath"}),
    "Die schwarze Ziege mit den tausend Jungen.",
    "fluestert: ");
  AddInfo( ({"nyaralathothep", "nya"}),
    "Die Bestie mit den tausend Armen.",
    "fluestert: ");
  AddInfo( ({"wesen", "geschoepfe"}),
    "Bizarre Geschoepfe von einem fremden Planeten. 13 an der Zahl. Cthulhu, "
    "Yogsothoth, Shudde-M'ell, Azathoth, Shubb-Niggurath, Nyaralathothep, "
    "Wendigo, Glaaki, Hastur, Yibb-Tsstl, Tsathoggua, Shodagoi, die Cho-Cho.",
    "fluestert: ");
  AddInfo( ({"wendigo", "wen"}),
    "Wendigo, der auf den Winden geht.",
    "fluestert: ");
  AddInfo( ({"glaaki", "kometengeborene"}),
    "Glaaki, der Kometengeborene.",
    "fluestert: ");
  AddInfo( ({"cthuga", "flammende"}),
    "Der flammende.",
    "fluestert: ");
  AddInfo( ({"hastur", "cho-cho", "cho", "shodagoi", "yibb", "yibb-tsstl", "tsathoggua"}),
    "Wesen von geringerer Macht, trotzdem noch schrecklicher als Goetter "
    "in ihrem Zorn!",
    "fluestert: ");
  AddInfo( ({"cthulhu", "anfuehrer"}),
    "Allen voran steht Cthulhu, der oktopide Herr des Schreckens und der "
    "Schatten, ein Wesen, dessen Element das Meer ist, der sich aber "
    "genauso muehelos an Land oder auch in der Luft fortzubewegen vermag.",
    "fluestert: ");
  AddInfo( ({"shudde", "mell", "shudde-m'ell"}),
    "Shudde-M'ell, der ewig Eingegrabene und Herrscher ueber die Erde "
    "und die finsteren Reiche der Hoehlen.",
    "fluestert: ");
  AddInfo("dinge", break_string(
    "wird auf einmal ganz still und murmelt kaum verstaendlich: Jaja, "
    "seltsame Dinge gehen hier vor. Die Zeit draengt!", 78));
  AddInfo("satansanbeter", break_string(
    "sagt: Hier wimmelt es nur von Satansanbetern. Kaum vernichtest Du "
    "einen kommt auch schon der naechste.", 78)); 
  AddInfo( ({"grosse alten", "grossen alten", "gorsse", "alten", "daemonen"}),
    "Es sind bizarre Geschoepfe, so unsagbar fremd. Ihre Namen waren so "
    "fremdartig wie ihre Gestalt: "
    "Yog-Sothoth, Shudde-M'ell, und Cthulhu, der ihr Anfuehrer war. "
    "Sie nannten sich selbst die GROSSEN ALTEN, und obwohl ihre Zahl klein "
    "war, herrschten sie doch ueber Tausende von Planeten.",
    "sagt: ");
  AddInfo( ({"planeten", "planet"}),
    "Zumeist waren es kalte und tote Welten, denn sie vernichteten alles "
    "Leben, dessen sie habhaft wurden.",
    "sagt: ");
  AddInfo( ({"diener", "kreaturen", "shoggoten"}),
    "Sie schufen selbst Diener aus unheiligen Protoplasma, furchtbare "
    "Kreaturen, die ihre Gestalt nach belieben veraendern konnten und die "
    "sie Shoggoten nannten.", 
    "sagt: ");
  AddInfo( ({"hexe", "hexen"}),
    "Es gibt 'gute' und 'boese' Hexen. Die 'boesen Hexen' haben sich meist "
    "dem Teufel verschworen. Die guten sind meistens Hebammen oder "
    "Heilkundlerinnen. Frueher wurden sie zu tausenden gefoltert oder "
    "verbrannt!",
    "sagt: ");
} 

void die(int poisondeath)
{
  write_file(LOG("bib.kills"),
   ctime()+": "+CAP(getuid(PL))+" killt den Bibliothekar.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
   {
  write_file(LOG("bib.deads"),
    ctime()+": Der Bibliothekar hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

 

