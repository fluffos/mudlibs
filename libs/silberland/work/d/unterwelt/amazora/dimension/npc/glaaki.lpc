//  28.06.98 Angrox: Class CL_DEMON added
//


#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h>
#include <class.h>
#include <moving.h>
#include <new_skills.h>
#include "../files.h"
#define LOG(x) "/players/amazora/log/" + x
inherit "std/npc";

create() {
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_SHORT, "Glaaki der Kometengeborene");
  SetProp(P_LONG, 
    "Das ist Glaaki der Kometengeborene. Toete ihn, bevor "
    "er Dich toetet!");
  SetProp(P_NAME, "Glaaki");
  SetProp(P_GENDER, 1);
  AddId("glaaki");
  AddId("alter");
  AddClass(CL_DEMON);
  create_default_npc(36);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, -700);
  
  SetProp(P_RACE, "Daemon");
  SetProp(P_HANDS, ({" mit der fuerchterlichen Magie der Grossen Alten",
          QueryProp(P_HANDS)[1],DT_MAGIC}));
  SetProp(P_NOMAGIC,70);
  set_living_name("glaaki");
  SetProp(P_KILL_MSG, "Die Zeit ist gekommen! Wir sind wieder da!");
  SetProp(P_MSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGOUT, "poltert davon");
  SetProp(P_MSGOUT, "poltert davon");
  SetProp(P_BODY, 250);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_SPELLRATE, 75);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.4, DT_COLD:      -0.4, DT_WATER:  -0.1, DT_AIR:    -0.1, 
      DT_LIGHTNING: -0.4, DT_EXPLOSION: -0.4, DT_SOUND:  -0.3, DT_LIGHT:  -0.7,
      DT_ELECTRIC:  -0.0, DT_ACID:      -0.1, DT_POISON: -0.1, DT_TERROR: -1.0,
      DT_HOLY:       0.2, DT_UNHOLY:    -1.0, DT_MAGIC:  -0.3 ]) );

  AddSpell(1,400,
    "Glaaki schreit fuerchterlich.\n",
    "Glaaki schreit fuerchterlich.\n",
    ({DT_SOUND, DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
  AddSpell(2,800,
    "Glaaki reisst Dir die Seele aus dem Leib.\n",
    "Glaaki reisst @WEM die Seele aus dem Leib.\n",
    ({DT_RIP, DT_PIERCE}),([SP_SHOW_DAMAGE:1]));

  SetAttackChats(25, ({
     "Glaaki faengt wie wahnsinnig an zu lachen.\n"}) );
  clone_object(OBJ "saeureschuhe")->move(this_object());
  command_me("trage schuhe");
}

void die(int poisondeath)
{
  object item;
  write_file(LOG("glaaki.kills"),
    ctime()+": "+CAP(getuid(PL))+" killt Glaaki.\n");
  if((item=present("\npaladintaskitem", this_player())) && item->GetTask(14, this_player()))
    item->SetFlag(3);
  ::die(poisondeath);
}
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG("glaaki.deads"),
    ctime()+": Glaaki hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}
