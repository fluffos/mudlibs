
//  28.06.98 Angrox: Class CL_DEMON added 
//


#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h>
#include <moving.h>
#include <class.h>
#include <new_skills.h>
#include "../files.h"
#define LOG(x) "/players/amazora/log/" + x
inherit "std/npc";

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_SHORT, "Shodagoi");
  SetProp(P_LONG, 
     "Das ist Shodagoi. Ein Wesen von geringerer Macht, trotzdem noch "
     "schrecklicher als Goetter in ihrem Zorn.");
  SetProp(P_NAME, "Shodagoi");
  SetProp(P_GENDER, 1);
  AddClass(CL_DEMON);
  AddId("alter");
  AddId("sho");
  AddId("shodagoi");

  create_default_npc(34);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, -780);
  
  SetProp(P_RACE, "Daemon");
  SetProp(P_HANDS, ({" mit der fuerchterlichen Magie der Grossen Alten",
          QueryProp(P_HANDS)[1],DT_MAGIC}));
  SetProp(P_NOMAGIC,40);
  set_living_name("shodagoi");
  SetProp(P_KILL_MSG, "Die Zeit ist gekommen! Wir sind wieder da!");
  SetProp(P_MSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGOUT, "poltert davon");
  SetProp(P_MSGOUT, "poltert davon");
  SetProp(P_BODY, 200);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_SPELLRATE, 70);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.7, DT_COLD:      -0.3, DT_WATER:  -0.0, DT_AIR:    -0.0, 
      DT_LIGHTNING: -0.3, DT_EXPLOSION: -0.3, DT_SOUND:  -0.3, DT_LIGHT:  -0.6,
      DT_ELECTRIC:  -0.2, DT_ACID:      -0.0, DT_POISON: -0.0, DT_TERROR: -1.0,
      DT_HOLY:       0.1, DT_UNHOLY:    -1.0, DT_MAGIC:  -0.5 ]) );
  
  AddSpell(1,400,
    "Shodagoi schreit fuerchterlich.\n",
    "Shodagoi schreit fuerchterlich.\n",
    ({DT_SOUND, DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
  
  AddSpell(2,800,
    "Shodagoi reisst Dir die Seele aus dem Leib.\n",
    "Shodagoi reisst @WEM die Seele aus dem Leib.\n",
    ({DT_RIP, DT_PIERCE}),([SP_SHOW_DAMAGE:1]));
  SetAttackChats(25, ({
    "Shodagoi faengt wie wahnsinnig an zu lachen.\n"}) );

  clone_object(OBJ "feuerhandschuhe")->move(this_object());
  command_me("trage handschuhe");
}

void die(int poisondeath)
{
  object item;
  if((item=present("\npaladintaskitem", this_player())) && item->GetTask(14, this_player()))
    item->SetFlag(6);
  write_file(LOG("sho.kills"),
    ctime()+": "+CAP(getuid(PL))+" killt Shodagoi .\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG("sho.deads"),
    ctime()+": Shodagoi hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}
