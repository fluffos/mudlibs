//  28.06.98 Angrox: Class CL_DEMON added
//

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <class.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#define LOG(x) "/players/amazora/log/" + x
inherit "std/npc";

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_SHORT, "Shudde-M'ell");
  SetProp(P_LONG, 
    "Shudde-M'ell, der ewig Eingegrabene und Herrscher ueber die Erde und "
    "die finsteren Reiche der Hoehlen.");
  SetProp(P_NAME, "Shudde-M'ell");
  SetProp(P_GENDER, 1);
  AddId("alter");
  AddId("shudde");
  AddId("shudde-m'ell");
  AddClass(CL_DEMON);
  create_default_npc(26);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 190);
  SetProp(P_ALIGN, -1000);
  
  SetProp(P_RACE, "Daemon");
  SetProp(P_HANDS, ({" mit der fuerchterlichen Magie der Grossen Alten",
          QueryProp(P_HANDS)[1],DT_MAGIC}));
  SetProp(P_NOMAGIC,50);
  set_living_name("shudde-m'ell");
  SetProp(P_KILL_MSG, "Die Zeit ist gekommen! Wir sind wieder da!");
  SetProp(P_MSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGOUT, "poltert davon");
  SetProp(P_MSGOUT, "poltert davon");
  SetProp(P_BODY, 180);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_SPELLRATE, 50);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.7, DT_COLD:      -0.3, DT_WATER:  -0.3, DT_AIR:    -0.3, 
      DT_LIGHTNING: -0.3, DT_EXPLOSION: -0.4, DT_SOUND:  -0.3, DT_LIGHT:  -0.4,
      DT_ELECTRIC:  -0.0, DT_ACID:      -0.1, DT_POISON: -0.3, DT_TERROR: -1.0,
      DT_HOLY:       0.4, DT_UNHOLY:    -1.0, DT_MAGIC:  -0.6 ]) );

  AddSpell(1,600,
    "Shudde-M'ell schreit fuerchterlich.\n",
    "Shudde-M'ell schreit fuerchterlich.\n",
    ({DT_SOUND, DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
  AddSpell(2,1000,
    "Shudde-M'ell reisst Dir die Seele aus dem Leib.\n",
    "Shudde-M'ell reisst @WEM die Seele aus dem Leib.\n",
    ({DT_RIP, DT_PIERCE}),([SP_SHOW_DAMAGE:1]));
  SetAttackChats(25, ({
    "Shudde-M'ell faengt wie wahnsinnig an zu lachen.\n"}) );
}

void die(int poisondeath)
{
  object item;
  if((item=present("\npaladintaskitem", this_player())) && item->GetTask(14, this_player()))
    item->SetFlag(8);
  write_file(LOG("shudde.kills"),
    ctime()+": "+CAP(getuid(PL))+" killt Shudde M'ell.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG("shudde.deads"),
    ctime()+": Shudde M'ell hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}
