inherit "std/npc";

//#include "../def.h"

#include <defines.h>
#include <moredef.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <class.h>
#include <new_skills.h>

create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein kleiner trauriger Gruftie");
  SetProp(P_LONG,
    "Ein kleiner Gruftie mit blassem Gesicht und schwarzen Haaren steht "
    "vor Dir und schaut Dich traurig an."
  );

  SetProp(P_NAME, ({"Gruftie", "Grufties", "Gruftie","Gruftie"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  SetProp(P_RACE, "Mensch");
  AddClass(CL_HUMAN);
  set_living_name("gruftie");
  AddId("gruftie");

  create_default_npc(15);

  SetProp(P_SIZE, 170);
  SetProp(P_LEVEL, 15);
  SetProp(P_MAX_HP, 200);
  SetProp(P_ALIGN, 800);
  SetProp(P_ATTRIBUTES, ([A_STR:5]) );

  SetProp(P_HANDS, ({" mit seinen Haenden", 105,DT_BLUDGEON}));
  SetProp(P_BODY, 65);

  SetChats(3, ({
    "Der kleine Gruftie schnieft traurig vor sich hin.\n",
    "Der kleine Gruftie seufzt abgrundtief.\n",
    "Der kleine Gruftie philosophiert ueber den Tod und den Sinn des Lebens.\n",
    "Der kleine Gruftie ritzt sich etwas mit einer Rasierklinge in den Unterarm.\n"}) );

  SetProp(P_DEFAULT_INFO,
    BS("schuettelt den Kopf und sagt: Fragen koennen die Leute stellen! Pff."));

  AddInfo("amazora",
    "sagt: Die ist doof und stinkt!\n");

  AddInfo( ({"cure", "the cure"}),
    "Boys don't cry....",
    "singt: ");

  AddInfo( ({"sisters of mercy", "sisters"}),
    "Ich hoer Dich rufen Mariaaaaaaaaaaaaaaaaaaaan, kannst Du mich "
    "schreien hoeren....",
    "singt: ");

  AddInfo("nick cave",
    "sagt: Nick Cave ist Amazora's Lieblingssaenger.\n");

  AddInfo( ({"deine Lakaien", "lakaien"}),
    "There is no peace on heaven there is no peace on earth...",
    "singt: ");

  AddInfo( ({"lacrimosa", "lacrimosa"}),
    "Und wo ist der Doktor? Wo sind die Schwestern? Ich bin so allein...",
    "bruellt: ");

  AddInfo( ({"erben", "goethes erben"}),
    "Das schwarze Wesen wartet still auf NICHTS...",
    "singt: ");

  AddInfo( ({"nostro", "nostromo"}),
    "Hihi, das ist auch so ein Gruftie. :-)",
    "kichert: ");

  AddInfo("tom waits",
    "sagt: Naja, so ein Saenger halt.\n");

  AddInfo("joy division",
    "schwaermt vor sich hin: Oh, die sind supercool. Richtig schoen depressiv.\n");

  SetProp(P_SPELLRATE, 40);

  AddSpell(1,400,
    "Der kleine Gruftie verflucht Dich.\n",
    "Der kleine Gruftie verflucht @WEN.\n",
     DT_UNHOLY, ([SP_SHOW_DAMAGE:1]) );

  AddCmd(({"troeste", "troest"}), "cmd_troeste");
}

cmd_troeste(str)
{
  notify_fail("Wen moechtest Du troesten?\n");
  if (!str || str!="gruftie") return 0;
  write("Der kleine Gruftie weint sich so richtig bei Dir aus.\n");
  return 1;
}
