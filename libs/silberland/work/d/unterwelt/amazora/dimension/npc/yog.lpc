//  28.06.98 Angrox: Class CL_DEMON added
//

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <combat.h>
#include <moving.h>
#include <class.h>
#include <new_skills.h>
#include "../files.h"
#define LOG(x) "/players/amazora/log/" + x
inherit "std/npc";

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_SHORT, "Yogsothoth, der Waechter des Tores");
  SetProp(P_LONG, 
    "Yog-Sothoth kennt das Tor. Yog-Sothoth ist das Tor. Er ist "
    "Schluessel und Waechter des Tores. Vergangenheit, Gegenwart, "
    "Zukunft, alles ist Yog-Sothoth. Er weiss, wo einst die Grossen Alten "
    "herausbrachen." );
  SetProp(P_NAME, "Yogsothoth");
  SetProp(P_GENDER, 1);
  AddId("yogsothoth");
  AddId("yog");
  AddId("alter");
  AddId("yog-sothoth");
  AddClass(CL_DEMON);
  create_default_npc(30);
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 270);
  SetProp(P_ALIGN, -1000);
  
  SetProp(P_RACE, "Daemon");
  SetProp(P_BODY, 300);
  SetProp(P_HANDS, ({" mit der fuerchterlichen Magie der Grossen Alten",
          QueryProp(P_HANDS)[1],DT_MAGIC}));
  SetProp(P_NOMAGIC,60);
  set_living_name("azathoth");
  SetProp(P_KILL_MSG, "Die Zeit ist gekommen! Wir sind wieder da!");
  SetProp(P_MSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGIN, "kommt aus dem Riss der Dimensionen");
  SetProp(P_MMSGOUT, "poltert davon");
  SetProp(P_MSGOUT, "poltert davon");
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_SPELLRATE, 60);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -0.4, DT_WATER:  -0.1, DT_AIR:    -0.2, 
      DT_LIGHTNING: -0.5, DT_EXPLOSION: -0.4, DT_SOUND:  -0.3, DT_LIGHT:  -0.9,
      DT_ELECTRIC:  -0.5, DT_ACID:      -0.3, DT_POISON: -0.1, DT_TERROR: -1.0,
      DT_HOLY:       0.1, DT_UNHOLY:    -1.0, DT_MAGIC:  -0.9 ]) );

  AddSpell(1,400,
    "Yogsothoth wirft einen riesigen Feuerball nach Dir.\n",
    "Yogsothoth wirft einen riesigen Feuerball nach @WEM.\n",
    ({DT_FIRE,DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
  AddSpell(2,800,
    "Yogsothoth veraetzt Dich.\n",
    "Yogsothoth veraetzt @WEN.\n",
    ({DT_ACID, DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
  AddSpell(3,1200,
     "Yogsothoth friert Dich ein.\n",
     "Yogsothoth friert @WEN ein.\n",
     ({DT_COLD, DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
  clone_object(OBJ "peitsche")->move(this_object());
}

void die(int poisondeath)
{
  object item;
  if((item=present("\npaladintaskitem", this_player())) && item->GetTask(14, this_player()))
    item->SetFlag(12);
  write_file(LOG("yog.kills"),
   ctime()+": "+CAP(getuid(PL))+" killt Yogsothoth.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG("yog.deads"),
    ctime()+": Yogsothoth hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

