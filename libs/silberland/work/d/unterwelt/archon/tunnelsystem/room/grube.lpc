#include "../def.h"
#include <moving.h>

inherit "std/room";

object npc;

int norden();
string wurm();

void create()
{
  ::create();
    
  SetProp(P_INT_SHORT, "Im einem Gang");
  SetProp(P_INT_LONG,"Der Gang ist vollstaendig rund und fuehrt nach Norden. "
    "Nur wenige Meter in dieser Richtung erkennst Du das Maul eines riesigen "
    "Grubenwurmes, welches den ganzen Gang ausfuellt. Anscheinend ist der "
    "Gang das Resultat dieses Ungetuemes. Ueberall um Dich herum erkennst Du "
    "Schleifspuren, welche Deine Vermutung bestaetigen.");
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_CAVE]));

  AddDetail(({"gang","raum"}), QueryProp(P_INT_LONG));
  AddDetail(({"maul","grubenwurm","wurm","ungetuem","ungetuemes"}), #'wurm);
  AddDetail(({"spur","spuren","schleifspur","schleifspuren"}),
    "Wenn Du die Spuren in dem Gang rund um Dich herum betrachtest, hast Du "
    "den Eindruck, als ob hier eine ueberdimensional grosse Kugel "
    "durchgerollt waere. Der Gang ist vollstaendig rund und die Waende sind "
    "bis auf Schleifspuren vollstaendig glatt. Nicht einmal Geroell liegt auf "
    "dem Boden herum.");
  AddDetail(({"boden","wand","waende","decke"}),
    "Glattgeschliffene Waende, sofern man bei einem runden Gang ueberhaupt "
    "von Waenden reden kann, umgeben Dich. Nur ein paar Schleifspuren "
    "unterbrechen den ansonsten glatten Felsen.");
  AddDetail(({"fels","felsen"}),
    "Rund um Dich herum ist Fels.");

  AddItem(NPC "grubenwurm",REFRESH_DESTRUCT);
  
  AddExit("norden", #'norden);

  AddCmd("spring|springe|springen&maul|rachen|mund","spring","Wohin willst "
    "Du springen?");
}

int monster()
{
  if (objectp(npc)) return 1;

  if (npc=S_STANDARD->present_clone(NPC "grubenwurm_gross",ME)) return 1;

  return 0;
}

string wurm()
{
  if (monster())
    return "Oh Gott, der gewaltige Grubenwurm lebt ja - nichts wie raus.";

  return "Zum Glueck ist der Grubenwurm tot! Gott sei Dank.";
}

int norden()
{
  if (monster()) 
    write(break_string("Direkt im Norden fuellt den ganzen Ausgang des "
      "Ganges das Maul eines gewaltigen Grubenwurmes aus."));
  else
    write(break_string("Der tote Koerper eines gewaltigen Grubenwurmes "
      "blockiert den Ausgang nach Norden."));
  return 1;
}

int spring(string str)
{
  object obj;
  if (monster()) return 0;

  call_other(ROOM "wurm_inneres", "???", 0);
  obj = find_object(ROOM "wurm_inneres"); 

  PL->move(obj, M_GO, "in den Rachen des Grubenwurmes",
    ({"Kurzentschlossen nimmst Du Anlauf und springst durch die scharfen "
      "Zaehne hindurch.",
      "&Name nimmt Anlauf und springt mitten in den Rachen des Grubenwurmes.",
      "&Name kullert sich ein Bein haltend herein."}) );

  tell_object(PL, "Als Du durch die Zaehne hindurch springst, reisst einer "
    "Dir Dein Bein auf.\n");

  return 1;
}
