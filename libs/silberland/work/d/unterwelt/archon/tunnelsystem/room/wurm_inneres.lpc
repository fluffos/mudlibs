// erstellt Archon@WL 03.07.2002
// wurm ist von aussen nicht wirklich toedbar
// man kann in das innere springen (kommando) landet dort
// in einem raum ROOM(wurm_inneres) - dort ist ein 
// unsichtbares monster (inneres) welches den schaden
// an diesen aeusseren npc uebertraegt - beim reinspringen
// fangen die "innereinen" und der spieler automatisch an zu kaempfen
/*
 Rev 1.1 15.10.2003 Archon: fuer sl ueberarbeitet
*/

#include "../def.h"
#include <moving.h>

inherit "std/room";

object npc;
object npc_aussen;

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Verschluckt");
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:20, ENV_USER:"Verschluckt"]));

  AddDetail(({"suppe","inneres","wurm","koerper","boden","innere"}),
    "Ist das eine eklige Suppe hier im Inneren des Wurms. Nichts wie raus "
    "hier.");

  AddItem(NPC "inneres",REFRESH_DESTRUCT);
  
  SetProp(P_SMELL,"Buhhh, fuerchterlich.");
  AddSmell(({"gestank"}), "Buhhh, fuerchterlich.");
  
  AddExit("raus",ROOM "grube");
}

int monster()
{
  if (!objectp(npc_aussen)) return 0;
  if (!objectp(npc))
    npc=S_STANDARD->present_clone(NPC "inneres",ME);
  if (!objectp(npc))
  {
    npc=clone_object(NPC "inneres");
    npc->move(ME,M_NOCHECK|M_SILENT);
  }
  return 1;
}

string _query_int_long()
{
  if (monster())
    return 
      "Du bist im Inneren des Grubenwurmes. Eine schleimig gruene Suppe ist "
      "rund um Dich herum. Aetzender Gestank steigt in Deine Nase. Zuckende "
      "Bewegungen gehen durch die Innereien und Du hast das Gefuehl von "
      "allen Seiten angegriffen zu werden.";
  
  return 
    "Du bist im Inneren des Grubenwurmes. Eine schleimig gruene Suppe ist "
    "rund um Dich herum. Aetzender Gestank steigt in Deine Nase. Doch "
    "nachdem der Wurm tot ist, bewegt sich hier nichts mehr.";
}

void wurm(object ob,object pl)
{
  npc_aussen=ob;
  if (monster())
  {
    npc->wurm(ob);
    npc->Kill(pl);
    pl->Kill(npc);
  }
}
