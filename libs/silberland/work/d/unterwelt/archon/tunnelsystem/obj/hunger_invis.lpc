inherit "std/thing";

#include <moving.h>
#include "../def.h"

object owner;

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_NAME,0);
  SetProp(P_SHORT,0);
  SetProp(P_NOGET,1);
  SetProp(P_NODROP,1);
  SetProp(P_WEIGHT,0);
  SetProp(P_NEVERDROP,1);
  SetProp(P_X_ATTR_MOD,([]));
  SetProp(P_X_ATTR_LOCK,1);
  SetProp(P_IDS, ({"\nhunger"}));
}

void set_owner(object pl)
{
  owner=pl;
  owner->UpdateAttribute();
  while (remove_call_out("weniger") != -1) ;
  call_out("weniger",180+random(61));
}

void weniger()
{
  mixed ret;
  int i,s,org;
  if (!objectp(owner)) { remove(1); return; }
  ret=QueryProp(P_X_ATTR_MOD);
  if (!mappingp(ret)) { remove(1); return; }
  i=ret[A_INT];
  s=ret[A_STR];
  if (i>=0 && s>=0) { remove(1); return; }
  call_out("weniger",120+random(121));
  if (random(100)>49 && i<0) 
    i++;
  else if (s<0)
    s++;
  else
    i++;
  tell_object(owner,"Dir geht es wieder besser.\n");
  SetProp(P_X_ATTR_MOD,([A_INT:i,A_STR:s]));
  owner->UpdateAttribute();
}

void reset()
{
  ::reset();
  if (is_clone()) remove(1);
}
