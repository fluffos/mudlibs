inherit "std/npc";
#include <combat.h>
#include <weapon.h>
#include <moving.h>
#include "../def.h"

object wurm;

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  create_default_npc(50);

  SetProp(P_NAME, "Grubenwurm");
  SetProp(P_GENDER, MALE);
  SetProp(P_PLURAL, 0);
  SetProp(P_ALIGN, -900);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WEIGHT, 60000);
}

string _query_short() { return 0; }
string _query_long() { return 0; }

void wurm(object ob)
{
  wurm = ob;
}

int monster()
{
  if (!objectp(wurm))
  {
    remove(1);
    return 0;
  }
  return 1;
}

void Attack(object e)
{
  object *feinde;
  int i,p;

  if (!monster()) return;

  feinde = QueryEnemies()[0];

  for (i = sizeof(feinde); i--;)
  {
    if (environment(ME) == environment(feinde[i]))
    {
      p = feinde[i]-> QueryProp(P_POISON);

      if (p < 6) feinde[i]-> SetProp(P_POISON, ++p);

      feinde[i]-> do_damage(5 + random(6), ME);

      tell_object(feinde[i], "Dein Koerper zieht sich schmerzhaft "
        "zusammen.\n");
    }
  }
}

int Defend(int dam, mixed dam_type, int spell, object enemy)
{
  if (!monster()) return 0;

  tell_object(enemy,"  Du vernichtest den gewaltigen Grubenwurm.\n");

  tell_room(environment(enemy), break_string("  " +
    enemy->Name(WER,NAME_AUTO) + " vernichtet den gewaltigen "
    "Grubenwurm."), ({enemy}));

  //damit der spieler hier nicht haufen ep's bekommt
  wurm->reduce_hit_point(130,0);
  return wurm->do_damage(20,enemy);
}
