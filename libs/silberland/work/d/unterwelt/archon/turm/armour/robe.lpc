// 19.01.2003 Archon: - erstellt 
// Diese Robe kann von Spieler nicht erhalten werden, da der magier die 
// beim zerstoeren/toeten removed
/*
 Rev 1.0 19.01.2003 Archon: - erste version
*/

#pragma strong_types

inherit "std/armour";
#include "../def.h"

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT,"Eine schwarze Robe");
  SetProp(P_LONG,
    "Die Robe ist aus weichem Leder gefertigt. Ein einfacher Zauber wurde "
    "darauf gesprochen, so dass die Robe jedem der sie anzieht wie angegossen "
    "passt.");

  SetProp(P_NAME, "Robe");
  SetProp(P_NAME_ADJ, "schwarz");
  AddAdjective(({"schwarzen","schwarzer","schwarzem","schwarzes","schwarze"}));
  SetProp(P_GENDER, FEMALE);

  SetProp(P_MATERIAL,([MAT_LEATHER:100]));
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 300);

  SetProp(P_NOBUY, 1);

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 2);

  AddId(({"robe","magierrobe",}));
}
