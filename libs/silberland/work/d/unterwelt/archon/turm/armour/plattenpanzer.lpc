inherit "std/armour";
#include "../def.h"

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT,"Ein leichter Plattenpanzer");
  SetProp(P_LONG,"Der Plattenpanzer des Waldlaeufers ist gruen und "
                 "erstaunlich leicht. Du untersuchst das Material genauer, "
                 "kannst aber nicht feststellen, woraus er gefertigt wurde. "
                 "Aber eins ist sicher, er scheint viel auszuhalten.");
  SetProp(P_NAME,"Plattenpanzer");
  SetProp(P_NAME_ADJ,"leicht");
  AddAdjective(({"leicht","leichter","leichten","leichtem","leichtes",
                 "leichte"}));

  SetProp(P_GENDER,MALE);
  SetProp(P_VALUE,1700+random(200));
  SetProp(P_WEIGHT,4000);
  SetProp(P_AC,20);
  SetProp(P_ARMOUR_TYPE,AT_ARMOUR);
  SetProp(P_MATERIAL,([MAT_MISC:100]));

  AddId(({"panzer","plattenpanzer"}));

  AddDetail("material",
    "Du weisst nicht woraus der Plattenpanzer gefertigt wurde.");
}
