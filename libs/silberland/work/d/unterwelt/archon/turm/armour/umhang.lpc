inherit "std/armour";
#include "../def.h"

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT,"Ein gruener Umhang");
  SetProp(P_LONG,"Der gruener Umhang ist sehr robust und sieht warm aus, "
                 "aber als Du ihn anfaesst, fuehlt er sich kalt an.");
  SetProp(P_NAME,"Umhang");
  SetProp(P_NAME_ADJ,"gruen");
  AddAdjective(({"gruen","gruener","gruenen","gruenes","gruenem"}));

  SetProp(P_MATERIAL,([MAT_CLOTH:100]));
  SetProp(P_GENDER,MALE);
  SetProp(P_VALUE,1070);
  SetProp(P_WEIGHT,1150);
  SetProp(P_AC,5);
  SetProp(P_ARMOUR_TYPE,AT_CLOAK);
  SetProp(P_TEMPERATURE_PROTECTION,([T_COLD_PROT:-4,T_HEAT_PROT:4]));

  AddId(({"umhang"}));
}

