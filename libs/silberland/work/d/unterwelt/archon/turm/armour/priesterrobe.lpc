#pragma strong_types
#include "../def.h"
inherit "std/armour";


void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT,"Eine schwarze Priesterrobe");
  SetProp(P_LONG,
    "Dies ist die Robe eines Priesters. Anscheinend liebte der Priester "
    "edlen Stoff, denn die Robe ist aus schwarzem Samt gefertigt "
    "und fuehlt sich auf der Haut wunderbar weich an.");

  AddDetail(({"samt","stoff"}),
    "Die Robe ist aus weichem Samt gefertigt.");
  AddDetail(({"priester"}),
    QueryProp(P_LONG));
  AddDetail(({"haut"}),
    "Die Robe fuehlt sich auf der Haut schoen weich an.");

  SetProp(P_NAME,"Priesterrobe");
  SetProp(P_NAME_ADJ,"schwarz");
  AddAdjective(({"schwarzen","schwarzer","schwarzem","schwarzes","schwarze"}));
  SetProp(P_GENDER, FEMALE);

  SetProp(P_MATERIAL, ([MAT_VELVET:100]) );
  SetProp(P_WEIGHT, 1500);
  SetProp(P_VALUE, 100);

  SetProp(P_NOBUY, 1);

  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 2);

  AddId(({"samtrobe","robe","priesterrobe"}));
}

