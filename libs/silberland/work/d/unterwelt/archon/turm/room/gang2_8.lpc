#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();
int exit_oben();
string detail_magen();

void create() 
{
  ::create();
  create_mitte();
  create_aufgang(1);

  SetProp(P_INT_SHORT, "Ein hoher Raum");
  SetProp(P_INT_LONG,
    "Du traust Deinen Augen nicht. Ein schmale Wendeltreppe "
    "windet ihre Stufen genau in der Mitte "
    "des Raumes in die Hoehe. Du folgst der Treppe mit Deinem "
    "Blick und siehst, wie sie immer kleiner wird, um dann, zu "
    "einem undeutlichen Strich werdend, ganz zu verschwinden. "
    "Du glaubst nicht, dass Du Dich dort hinauf traust, insbesondere "
    "weil die Treppe kein Gelaender hat. Du koenntest leicht "
    "abstuerzen.");

  AddDetail(({"hoehe"}),
    "Der Raum ist sehr hoch.");
  AddDetail(({"auge","augen"}),
    "Du hast hoffentlich noch beide.");
  AddDetail(({"gelaender","tiefe"}),
    "Du kannst es einfach nicht glauben. Wie kann die Treppe nur "
    "ohne Gelaender sein - Ein unachtsamer Schritt und ein Sturz in "
    "die Tiefe ist unausweichlich. Du bist Dir nicht sicher, ob "
    "Du die Gefahr auf Dich nehmen solltest und Dich ueberwinden "
    "kannst, die Treppe hinaufzugehen.");
  AddDetail(({"gefahr","gefahren","leben"}),
    "Das Leben ist voller Gefahren.");
  AddDetail(({"sturz","ende"}),
    "Solltest Du von weiter oben hinabstuerzen, waere das Deine Ende.");
  AddDetail(({"schritt","schritte","weg"}),
    "Jeder Weg beginnt mit dem ersten Schritt.");
  AddDetail(({"strich","windung","windungen","hinsehen"}),
    "Die Wendeltreppe fuehrt so weit hinauf und windet sich dabei so oft "
    "um sich selbst, dass Dir alleine vom Hinsehen schon schlecht wird. "
    "Zum Glueck verschwimmen die Windungen weiter oben zu einem Strich "
    "und Dein Magen beruhigt sich wieder.");
  AddDetail(({"mitte"}),
    "In der Mitte des Raumes beginnt die nach oben fuehrende Wendeltreppe.");
  AddDetail(({"decke"}),
    "Die Decke kannst Du von hier unten nicht erspaehen.");
  AddDetail(({"boden","fussboden"}),
    "Der Boden bestehen aus einfachen Stein- und Marmorplatten. "
    "In der Mitte des Raumes beginnt eine Treppe.");
  AddDetail(({"blick"}),
    "Ja schau Dich um.");
  AddDetail(({"magen"}),
    #'detail_magen);
  AddDetail(({"westen","oben"}),
    "In diese Richtung kannst Du gehen.");
  
  RemoveExit("oben");
  AddExit("westen",ROOM "gang2_7");
  AddExit("oben",#'exit_oben);

  AddItem(NPC "luthe",REFRESH_DESTRUCT);
}

int exit_oben()
{
  write("Du traust Dich nicht hinauf und bleibst lieber wo Du bist.\n"
        "Oder gibt es einen anderen Weg? Du ueberlegst.\n");
  return 1;
}

string detail_magen()
{
  tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
               " muss sich ploetzlich uebergeben."),({PL}));
  return "Du musst Dich uebergeben.\n";
}

int cmd_sagen(string str)
{
  if (::cmd_sagen(str)!=2) 
    return 0;
  write(break_string(
    "Du befiehlst 'OBEN' und schon erscheint ein geisterhafter Diener, "
    "hebt Dich hoch und rast mit Dir die Treppen hinauf. Du hast nicht "
    "einmal Zeit Atem zu holen, bevor Dich der Diener schon unten absetzt."));
  PL->move(ROOM "gang3_1.lpc",M_GO,"","verschwindet","erscheint");
  return 1;
}

