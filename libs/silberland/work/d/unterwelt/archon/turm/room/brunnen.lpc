#include "../def.h"
inherit "std/room";
#include <fishing.h>

void create();
void reset();
string detail_regal();
string detail_platte();
mixed detail_papier();
int cmd_bade(string str);
int cmd_trinke(string str);
int cmd_bricht(string str);
int ruhen();
int cmd_ruhen(string str);
int cmd_baumeln(string str);
int durcheinander();
int cmd_durcheinander2(string str);
int cmd_durcheinander(string str);
int cmd_fang(string str);
int cmd_nehmen(string str);
int cmd_sitz(string str);
int cmd_greif(string str);
int cmd_steck(string str);
int cmd_heben(string str);
int cmd_brenne(string str);
int cmd_umwerfen(string str);
int cmd_aufstellen(string str);

void zurueck_platte();
void zurueck_loch();
void zurueck_regal();

int get_platte();
int get_loch();

object magier;
int platte;
int loch;
int regal;

void create()
{
  ::create();

  AddId("wasser"); //damit man wasser finden kann - patch

  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  SetProp(P_WATER,W_POOL);
  SetProp(P_INT_SHORT,"Bei einem Brunnen");
  SetProp(P_INT_LONG,
    "Du bist in einem wunderschoen angelegten Brunnenhof, inmitten des Turmes. "
    "Hohe Mauern umgeben den Innenhof und eine kuenstliche Sonne scheint "
    "durch ein glaesernes Dach und laesst die Wasseroberflaeche des Brunnens schimmern. "
    "Direkt in der Mitte des Brunnens waechst eine riesige Ulme. "
    "Im Stamm der Ulme erkennst Du ein Loch, durch welches "
    "Wasser in den Brunnen plaetschert. Der marmorne Brunnenrand ist ueberwachsen "
    "von weichem Moos. Ein schmaler Rasenstreifen umgibt den "
    "Brunnen, gefolgt von Marmorplatten. An den Hofwaenden sind viele "
    "verstaubte Buecherregale aufgereiht und ein unterhoehlter "
    "Baumstumpf steht neben einem Tisch.");
  AddDetail(({"umgebung","hof","brunnenhof","innenhof"}),
    QueryProp(P_INT_LONG));
  AddDetail(({"schimmer"}),
    "Die Wasseroberflaeche schimmert.");
  AddDetail(({"boden"}),
    "Gras, Moos, Marmorplatten ... wenn Du Dich noch ne Weile umschaust, findest "
    "Du bestimmt noch mehr.");
  AddDetail(({"weile"}),
    "Die Zeit vergeht ...");
  AddDetail(({"zeit","hetzen"}),
    "Immer dieses Hetzen!");
  AddDetail(({"brunnenrand","moos","platz"}),
    "Gruenes, weiches Moos bedeckt den Brunnenrand. Ein idealer Platz, um "
    "sich auszuruhen und die Beine im Wasser baumeln zu lassen.");
  AddDetail(({"oberflaeche","wasseroberflaeche"}),
    "Das Wasser im Brunnen steigt und faellt im Spiel des Lichtes und Schatten.");
  AddDetail(({"spiel"}),
    "Du willst mitspielen.");
  AddDetail(({"archon"}),
    "Archon ist der Erschaffer dieses Turmes.");
  AddDetail(({"baumstumpf","stumpf","seite"}),
    "Der Baumstumpf ist komisch geformt. Du erkennst eine Sitzflaeche vor einer "
    "grossen Tischplatte, auf der sich Schreibutensilien stapeln. An der Seite erkennst "
    "Du zwei Zweige, die wie Arme aussehen. Wozu sie wohl dienen?");
  AddDetail(({"arm","arme"}),
    "Ob sie selbstaendig aufraeumen koennen, wenn die Schreibutensilien durcheinander "
    "gebracht werden?");
  AddDetail(({"sitzflaeche"}),
    "Die ist nur fuer den alten Magier bestimmt.");
  AddDetail(({"tisch","tischplatte"}),
    "Auf der Tischplatte stapeln sich Schreibutensilien.");
  AddDetail(({"schreibzeug","schreibutensilien","utensilien","schreiben"}),
    "Na was man halt so fuer das Schreiben braucht. Tinte, Feder, Blaetter ... "
    "Anscheinend entwirft der alte Magier gerade ein Konzept, um gegen die Dunkelelfen "
    "vorzugehen.");
  AddDetail(({"konzept"}),
    "Ein guter Plan ist sicherlich notwendig, um gegen die Dunkelelfen zu bestehen.");
  AddDetail(({"plan","patrouille","patrouillen"}),
    "Vielleicht ist der Plan gut genug, um wenigstens eine ihrer Patrouille zu vernichten.");
  AddDetail(({"tinte","feder","blatt","blaetter","besonderes"}),
    "Du kannst daran nichts Besonderes erkennen.");
  AddDetail(({"turm","inneren","inneres"}),
    "Du kannst es kaum glauben, dass Du im Inneren des Turmes sein sollst. "
    "Wie hat hier nur so ein grosser Hof Platz?");
  AddDetail(({"ulme","stamm","baum"}),
    "Eine Ulme erhebt sich mit ihrem maechtigen Stamm in der Mitte des Brunnens. "
    "Die Aeste und Zweige breiten sich ueber den ganzen Brunnen aus und spenden einen "
    "angenehmen Schatten. Der Stamm ist erstaunlich dick. Im Durchmesser einige Meter. "
    "Aus einem Loch im Stamm stroemt frisches Wasser in den Brunnen. Komisch! "
    "Du hast noch nie einen Baum gesehen, aus dem Wasser kommt.");
  AddDetail(({"meter"}),
    "Etwa 2 Schritt.");
  AddDetail(({"schritt"}),
    "Wie gross machst Du die denn?");
  AddDetail(({"durchmesser"}),
    "Weisst Du denn gar nichts?");
  AddDetail(({"loch"}),
    "Das Loch ist nicht sehr gross, ungefaehr so wie Dein Finger.");
  AddDetail(({"finger"}),
    "Dein Finger ist an Deiner Hand angewachsen.");
  AddDetail(({"hand","bein","beine"}),
    "Untersuch Dich doch einfach vor einem Spiegel einmal selber.");
  AddDetail(({"spiegel"}),
    "Hier ist keiner, oder meinst Du die Wasseroberflaeche?");
  AddDetail(({"ast","aeste"}),
    "Natuerlich hat die Ulme Aeste und Zweige, was denkst Du denn?");
  AddDetail(({"schatten"}),
    "Die Ulme spenden angenehmen Schatten.");
  AddDetail(({"wasser"}),
    "Das Wasser ist kristallklar.");
  AddDetail(({"brunnen","mitte"}),
    "Genau in der Mitte des Hofes ist ein schoener Brunnen. Das weiche Moos "
    "um ihn herum laedt dazu ein, sich hinzusetzen und waehrend man sich ausruht, "
    "die Beine im Wasser baumeln zu lassen.");
  AddDetail(({"mauer","mauern"}),
    "Die Mauern umgeben den Innenhof. Doch anstatt beengend und erdrueckend zu "
    "wirken, sind sie weit genug weg, um eine angenehmes Ambiente zu ermoeglichen. Einige "
    "Regale, gefuellt mit Buechern und Schriftrollen stehen an den Waenden.");
  AddDetail(({"ambiente"}),
    "Ist es hier nicht einfach herrlich?");
  AddDetail(({"dach","glas","decke","farbe","farben"}),
    "Kunstvolles bemaltes Glas erstrahlt im kuenstlichen Sonnenlicht in bunten Farben.");
  AddDetail(({"magie"}),
    "Sie ist in diese Turm allgegenwertig.");
  AddDetail(({"sonne","licht","sonnenlicht"}),
    "Durch irgendeine Dir unbekannte Magie strahlt eine kuenstliche Sonne durch "
    "das glaesernde Dach herein.");
  AddDetail(({"regale","buchregal","buecherregal","buecherregale","ebereschenholz"}),
    "In den Regalen erkennst Du viele Buecher und Schriftrollen. Die Regale sind aus "
    "Ebereschenholz gefertigt und kunstvoll verziert. Doch jetzt, nach langer Zeit, "
    "sind die Buecher und Regale vollstaendig verstaubt. Nur ein wackliges Regal "
    "ist staubfrei.");
  AddDetail(({"staub"}),
    "Kein Wunder das sind hier Staub angesammelt hat. Immerhin war der Turm vor kurzem "
    "noch unbewohnt. Dich wundert nur, weshalb der Boden von Gras und nicht von Staub "
    "bedeckt ist.");
  AddDetail(({"wunder"}),
    "Ein Wunder koenntest Du jetzt gebrauchen.");
  AddDetail(({"regal","last"}),#'detail_regal);
  AddDetail(({"zauberbuch","zauberbuecher","buch","buecher"}),
    "Dir sagen sie nichts. Der Magier koennte es Dir ja vielleicht "
    "verraten.");
  AddDetail(({"holz"}),
    "Holz gibt es hier genug. Die Ulme ist natuerlich aus Holz und "
    "die Regale auch.");
  AddDetail(({"verzierung"}),
    "Halt, das sind gar keine Verzierungen, sondern Runen.");
  AddDetail(({"runen"}),
    "Die Runen erstrahlen leicht silbern.");
  AddDetail(({"schriftrolle","rolle","schriftrollen","rollen"}),
    "Viele Schriftrollen stapeln sich in den Regalen. Alle mit einem "
    "Siegel versehen. Was wohl da alles drinnen stehen mag?");
  AddDetail(({"siegel","siegeln"}),
    "Sie sollen die Informationen schuetzen. Ein Siegel zu brechen kann "
    "furchtbare Konsequenzen haben.");
  AddDetail(({"konsequenz","konsequenzen"}),
    "So lange es nicht der Tod ist ...");
  AddDetail(({"information","informationen"}),
    "Da musst Du wohl den Magier fragen.");
  AddDetail(({"magier","erschaffer"}),
    "Oh ist er nicht da?");
  AddDetail(({"tot","tod"}),
    "Suchst Du ihn? Da gibt es so ein paar Moeglichkeiten.");
  AddDetail(({"moeglichkeit","moeglichkeiten"}),
    "Derer gibt es viele.");
  AddDetail(({"marmorplatten","platten","marmor","naehe"}),
    "Der Innenhof ist mit schweren Marmorplatten ausgelegt. Am Rand, in der "
    "Naehe der Regale, ist eine etwas kleinere Platte zu erkennen.");
  AddDetail(({"platte","marmorplatte"}),#'detail_platte);
  AddDetail(({"rand","rande","wand","waende","hofwand","hofwaende"}),
    "Am Rand des Innenhofes sind an den Waenden Buecherregale aufgestellt.");
  AddDetail(({"zweige","zweig"}),
    "Die Zweige und Blaetter der Ulme spruehen nur so vor Lebenskraft. Du "
    "ueberlegst, ob Du sie nicht anbrennen kannst.");
  AddDetail(({"lebenskraft","kraft"}),
    "Du wuenschtest Du haettest auch so viel davon.");
  AddDetail(({"wasseroberflaeche","oberflaeche"}),
    "Du verlierst Dich im Spiel des Lichtes.");
  AddDetail(({"rasen","rasenstreifen","streifen","gras"}),
    "Das Gras ist kurz geschnitten und herrlich gruen.");
  AddDetail(({"fisch","goldfisch","fische","goldfische"}),
    "Kleine Goldfische schwimmen im Wasser. Die sehen aus wie "
    "Koi-Goldfische. Ob man sie fangen kann?");
  AddDetail(({"koi","koi-goldfisch","koi-goldfische"}),
    "Das sind sehr seltene Goldfische und sehr teure.");
  AddDetail(({"wesen","dunkelelfen","dunkelefe",
              "dunkelelfenkrieger","dunkelelfenmagier",
              "dunkelelfenpriesterinnen","dunkelelfenpriesterin","bruder",
              "brueder","brudermord","schwester","schwerstern","schwestermord",
              "schwestermorde","schwesternmord","mutter","muetter",
              "muttermord","muttermorde"}),
    "Die Dunkelelfen leben hier in der Unterwelt. "
    "Sie sind wilde boesartige Wesen, die ihre Freude am Morden haben. "
    "Sie dulden keine andere Macht ausser ihre eigene und selbst da sind "
    "sie nicht zimperlich und Bruder, Schwester oder Muttermorde sind an "
    "der Tagesordnung.");
  AddDetail(({"freude"}),
    "Woran hast Du denn Freude?");
  AddDetail(({"macht","art","arten","nachdenken","energie","energien"}),
    "Es gibt viele Arten von Macht. Mit etwas Zeit und vielem Nachdenken "
    "fallen Dir bestimmt viele ein.");
  AddDetail(({"reich","unterwelt"}),
    "Du bist gerade in einem Turm in der Unterwelt.");
  AddDetail(({"mord","morden","morde","handwerk"}),
    "Die Dunkelelfen sind gut im Morden, aber gewiss nicht die einzigen die dieses " 
    "'Handwerk' beherrschen.");
  AddDetail(({"tagesordnung"}),
    "Ach, was steht heute auf der Tagesordnung: 1. Aufstehen; "
    "2. Bad benutzen; 3. ...");

  AddSound(DEFAULT_SOUND,
    "Das Wasser, welches in den Brunnen fliesst, murmelt sanft vor sich hin. "
    "Leise rascheln die Blaetter der Ulme.");
  AddSound(({"wasser","brunnen","murmeln","geraeusch","plaetschern"}),
    "Das Wasser murmelt leise. Du hoerst eine Weile zu und merkst, "
    "wie das sanfte Geraeusch Dich langsam einschlaefert.");
  AddSound(({"rascheln"}),
    "Die Blaetter der Ulme rascheln leise, als ein Windhauch durch "
    "sie hindurchfaehrt.");
  AddSmell(DEFAULT_SMELL,
    "Es liegt ein sanfter Moosduft in der Luft.");
  AddSmell(({"moos","duft","moosduft","luft"}),
    "Das Moos riecht schwach.");
  AddDetail(({"westen","unten"}),
    "In diese Richtung kannst Du gehen.");
  AddDetail(({"papier","papierstoepsel","stoepsel"}),#'detail_papier);

//erdenurwesen - marmorplatte drauflegen auf moos legen -> kommts nicht mehr
//wasserurwesen - loch verstopfen -> dh erst finger reinstecken -> papier
  AddCmd(({"bade","baden","schwimm","schwimme"}),"cmd_bade");
  AddCmd(({"trinke","trink","trinken"}),"cmd_trinke");
  AddCmd(({"brich","brech","breche","brechen"}),"cmd_bricht");
  AddCmd(({"ruhe","ausruhen","ruhen"}),"cmd_ruhen");
  AddCmd(({"baumel","baumle","baumeln"}),"cmd_baumeln");
  AddCmd(({"nimm","nehme","nehmen"}),"cmd_nehmen");
  AddCmd(({"bring","bringe","bringen"}),"cmd_durcheinander");
  AddCmd(({"durchwuehl","durchwuehle","durcheinander"}),"cmd_durcheinander2");
  AddCmd(({"fang","fange","fangen"}),"cmd_fang");
  AddCmd(({"sitz","sitze","sitzen","setz","setze","setzen"}),"cmd_sitz");
  AddCmd(({"greif","greife","greifen"}),"cmd_greif");
  AddCmd(({"steck","stecke","stecken"}),"cmd_steck");
  AddCmd(({"beweg","bewege","bewegen","hebe","heben","heb"}),"cmd_heben");
  AddCmd(({"anbrennen","brenn","brenne","brenne"}),"cmd_brenne");
  AddCmd(({"wirf","werfe","werfen"}),"cmd_umwerfen");
  AddCmd(({"stell","stelle","stellen"}),"cmd_aufstellen");

  AddExit("unten",ROOM "zimmer");
  AddExit("westen",ROOM "gang1_1");
  reset();
}

void reset()
{
  ::reset();
  if (!objectp(magier))
  {
    magier=clone_object(NPC "magier");
    magier->move(ME,M_GO);
  }
  magier->reset();
  zurueck_platte();
  zurueck_loch();
  zurueck_regal();
}

string detail_platte()
{
  if (platte)
    return
      "Eine Marmorplatte liegt auf dem Moos.\n";
  return
    "Eine Marmorplatte am Rande sieht kleiner aus und vor allem leichter.\n";
}

string detail_regal()
{
  if (regal)
    return break_string(
      "Das Regal liegt auf dem Boden. Es wurde wohl von jemanden umgeworfen. "
      "Vielleicht solltest Du es wieder aufstellen?");
  return break_string(
    "Ein Regal wackelt schon unter der Last der Buecher. Es sieht aus, "
    "als ob es gleich umstuerzen koennte. Umwerfen solltest Du es "
    "jedenfalls koennen.");
}

mixed detail_papier()
{
  if (loch) return 0;
  return "Der Papierstoepsel haengt im Loch fest.\n";
}

int cmd_bade(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "brunnen|wasser",
       "Wo willst Du baden?"))
    return 0;

  write(break_string("Du steckst erst langsam einen Fuss ins Wasser. Als Du "
        "merkst, dass es wunderbar angenehm und erfrischend ist, entledigst "
        "Du Dich Deiner Kleider und springst ins Wasser. Du schwimmst eine "
        "Weile umher. Die Goldfische kommen neugierig "
        "naeher, als Du so durch das Wasser plaetscherst. Als Du sie "
        "bemerkst, faengst Du an mit ihnen zu spielen. Die Fische sind "
        "hocherfreut, dass sich jemand um sie bemueht. Schade nur, dass "
        "es keine Delfine sind, denn die leben nur im Salzwasser, "
        "ansonsten haettest Du Dich von ihnen "
        "durch das Wasser ziehen lassen koennen. Leider wird Dir langsam "
        "kalt und Du kletterst zitternd aus dem Wasser und nimmst Deine "
        "Kleider wieder an Dich."));
  tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+" nimmt ein Bad."),({PL}));
  return 1;
}

int cmd_trinke(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "wasser",
       "Was willst Du trinken?"))
    return 0;

  write("Du nimmst einen Schluck erfrischenden Brunnenwassers.\n");
  return 1;
}

int cmd_bricht(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "siegel",
       "Was willst Du brechen?"))
    return 0;

  write("Du solltest erst einmal eine Schriftrolle in Deinem Besitz "
        "haben.\n");
  return 1;
}

int ruhen()
{
  write(break_string("Du setzt Dich an den Brunnenrand ins weiche Moos "
        "und laesst Deine Beine im angenehm kuehlen Wasser baumeln. Das "
        "tut gut. Du traeumst ne Weile vor Dich hin, bis Dich etwas in "
        "Dein Bein zwickt. Erschrocken springst Du auf. Was war das? Du "
        "beugst Dich hinab zur Wasseroberflaeche und erkennst "
        "ploetzlich, dass darin kleine Goldfische schwimmen."));
  tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
        " setzt sich am Brunnenrand ins Moos. Ploetzlich springt "+
        PL->name(WER,NAME_AUTO)+" auf ... komisch!"),
        ({PL}));
  return 1;
}

int cmd_ruhen(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "aus|ausruhen",
       "Willst Du Dich AUSruhen?"))
    return 0;

  return ruhen();
}

int cmd_baumeln(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "fuss|fuesse|bein|beine",
       "Was willst Du baumeln lassen?"))
    return 0;

  return ruhen();
}

int durcheinander()
{
  write(break_string("Du bringst die Schreibutensilien durcheinander. Kaum "
        "getan, bewegen sich die Zweige am Rand der Tischplatte und raeumen "
        "wieder alles auf."));
  tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
      " bringt die Schreibutensilien durcheinander. Kaum getan, bewegen "
      "sich die Zweige am Rand der Tischplatte und raeumen wieder alles "
      "auf."),({PL}));
  return 1;
}

int cmd_durcheinander2(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "schreibutensilen|utensilien|tisch",
       "Was willst Du durcheinander bringen?"))
    return 0;

  return durcheinander();
}

int cmd_durcheinander(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "schreibutensilien|utensilien|tisch&durcheinander",
       "Was willst Du durcheinander bringen?|Durcheinander wolltest Du wohl noch tippen?"))
    return 0;

  return durcheinander();
}

int cmd_nehmen(string str)
{
  if (S_STANDARD->check_cmd(str,
      "buch",
      "Was willst Du nehmen?"))
  {
    write(break_string("Du streckst Deine Hand nach einem der Buecher aus. "
       "Doch bevor Du es beruehren kannst, leuchten dessen Runen hell auf "
       "und Deine Hand wird weggedrueckt."));
    return 1;
  }
  if (S_STANDARD->check_cmd(str,
       "rolle|schriftrolle|schrift",
       "Was willst Du nehmen?"))
  {
    write(break_string("Leider schuetzt eine unsichtbare Kraft die "
        "Schriftrollen und Du kannst keine nehmen."));
    return 1;
  }
  return 0;
}

int cmd_fang(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "fisch|goldfisch|koi|koi-goldfisch",
       "Was willst Du fangen?"))
    return 0;

  write("Du versuchst, einen Goldfisch zu fangen, doch die sind einfach "
        "schneller.\n");
  return 1;
}

int cmd_sitz(string str)
{
  if (S_STANDARD->check_cmd(str,
       "moos|gras|brunnen|rand|marmor",
       "Wohin willst Du Dich setzen?"))
    return ruhen();

  if (!S_STANDARD->check_cmd(str,
       "tisch|stuhl|baumstumpf|schreibtisch|sitzflaeche",
       "Wohin willst Du Dich setzen?"))
    return 0;

  write(break_string("Du willst Dich gerade hinsetzen, als der Baumstumpf "
    "wegrennt. Dich will er offenbar nicht Platznehmen lassen."));
  tell_room(ME,break_string("Der Baumstumpf rennt ploetzlich weg, als sich "+
    PL->name(WER,NAME_AUTO)+" hinsetzen will."),({PL}));
  return 1;
}

int cmd_greif(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "loch",
       "Wo willst Du hinein greifen?"))
    return 0;

  write("Das Loch ist viel zu klein, doch Du koenntest Dein Finger "
        "hineinstecken.\n");
  return 1;
}

int cmd_steck(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "finger&loch",
       "Was willst Du ins Loch stecken?|Willst Du den Finger ins Loch stecken?"))
    return 0;

  if (loch)
  {
    write("Aber das Loch ist doch verstopft.\n");
    return 1;
  }
  loch=1;
  write(break_string("Du steckst Deinen Finger ins Loch. Doch ganz "
    "ausfuellen kannst Du es nicht und das das Wasser spritzt jetzt unter "
    "grossem Druck heraus, direkt in Dein Gesicht. Du ziehst den Finger "
    "schnell wieder heraus. Doch dann hast Du eine Idee. Schnell gehst Du "
    "rueber zum Tisch, schnappst Dir etwas Papier und formst daraus "
    "einen Papierstoepsel, den Du in das Loch steckst. Sofort fliesst kein "
    "Wasser mehr."));
  tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
      " bekommt eine Dusche, als "+PL->name(WER,NAME_AUTO)+" einen "
      "Finger in das Loch im Stamm steckt."),({PL}));
  if (find_call_out("zurueck_loch")==-1) call_out("zurueck_loch",60);
  if (!objectp(magier))
    return 1;
  magier->setze(2,0);
  if (!magier->InFight())
    tell_room(ME,break_string("Was denkst Du, was Du da machst?",
      78,"Der Magier blickt empoert: ",1));
  else
    tell_room(ME,"Der Magier flucht.\n");
  return 1;
}

int cmd_heben(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "platte|marmorplatte|marmor|stein",
       "Was willst Du (an)heben oder bewegen?"))
    return 0;

  if (platte)
  {
    write("Aber die Platte wurde schon bewegt.\n");
    return 1;
  }
  platte=1;
  write(break_string("Du hebst, unter dem Gewicht der Marmorplatte "
    "stoehnend, diese von ihrem Platz auf und laesst sie, als Du nicht "
    "weiter kannst, ins Moos fallen."));
  tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+" hebt, unter dem Gewicht "
    "der Marmorplatte stoehnend, diese von ihrem Platz auf und laesst sie "
    "ins Moos fallen."),({PL}));
  if (find_call_out("zurueck_platte")==-1) call_out("zurueck_platte",60);
  if (!objectp(magier))
    return 1;
  magier->setze(1,0);
  if (!magier->InFight())
    tell_room(ME,break_string("Was denkst Du, was Du da machst? Lege die "
      "Platte sofort wieder auf ihren Platz!",78,
      "Der Magier blickt empoert: ",1));
  else
    tell_room(ME,"Der Magier flucht.\n");
  return 1;
}

int cmd_brenne(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "ulme|zweige|blaetter|zweig",
       "Was willst Du anbrennen?"))
    return 0;

  if (!present("fackel",PL))
  {
    write("Aber Du hast keine Fackel.\n");
    return 1;
  }
  write(break_string("Du hebst Deine Fackel und haeltst sie an die Zweige "
           "der Ulme, doch diese reisst ihre Zweige aus Deiner Reichweite."));
  tell_room(ME,break_string(
   PL->Name(WER,NAME_AUTO)+" will etwas an der Ulme machen."),({PL}));
  return 1;
}

int cmd_umwerfen(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "regal|buecheregal|regale|buecherregale&um",
       "Was willst Du umwerfen?|Du willst das bestimmt UMwerfen."))
    return 0;

  if (regal)
  {
    write("Aber das Regal wurde doch schon umgeworfen.\n");
    return 1;
  }
  regal=1;
  write(break_string("Du gibst einem der Regale einen Schubs und mit "
        "einem lauten Krachen faellt es hinab und begraebt die Buecher "
        "unter sich."));
  tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
     " gibt einem der Regale einen Schubs und mit einem lauten Krachen "
     "faellt dieses um und begraebt die darin aufbewahrten Buecher unter "
     "sich."),({PL}));
  if (find_call_out("zurueck_regal")==-1) call_out("zurueck_regal",60);
  if (!objectp(magier))
    return 1;
  if (!magier->InFight())
    tell_room(ME,break_string("Was denkst Du, was Du da machst? Stell das "
      "Regal sofort wieder auf!",78,"Der Magier blickt empoert: ",1));
  else
    tell_room(ME,"Der Magier flucht.\n");
  return 1;
}

int cmd_aufstellen(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "regal|buecheregal|regale|buecherregale&auf",
       "Was willst Du wieder aufstellen?|Das willst Du bestimmt AUFstellen."))
    return 0;

  if (!regal)
  {
    write("Aber das Regal steht doch noch.\n");
    return -1;
  }
  regal=0;
  while (remove_call_out("zurueck_regal")!=-1) ;
  write(break_string("Du stellst das Regal wieder auf. Nach und nach fuellst "
        "Du es mit der Unmenge von Buechern, die sich vor Dir auftuermen, "
        "bis auch das letzte im Regal seinen Platz gefunden hat."));
  tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
        " stellt ein Regal wieder auf. Nach und nach fuellt es sich "
        "mit der Unmenge von Buechern, die sich davor stapeln. Willst "
        "Du hier nur nutzlos rumstehen? Helfen solltest Du! "
        "Unentschlossen stehst Du da, bis auch das letzte Buch wieder "
        "seinen Platz im Regal gefunden hat."),({PL}));
  return 1;
}

void zurueck_platte()
{
  while (remove_call_out("zurueck_platte")!=-1) ;
  if (!platte) return;
  if (objectp(magier) && !magier->InFight())
  {
    magier->setze(1,1);
    platte=0;
    tell_room(ME,break_string("Der Magier hebt seinen Stab. Eine "
      "Marmorplatte schwebt in die Hoehe und ist bald wieder an "
      "ihrem alten Platz."));
    return;
  }
  if (!objectp(magier))
  {
    regal=0;
    tell_room(ME,break_string("Ploetzlich schwebt die Marmorplatte "
       "in die Hoehe und ist bald wieder auf ihrem angestammten Platz."));
    return;
  }
  if (find_call_out("zurueck_platte")==-1)
    call_out("zurueck_platte",60);
}

void zurueck_loch()
{
  while (remove_call_out("zurueck_loch")!=-1) ;
  if (!loch) return;
  if (objectp(magier) && !magier->InFight())
  {
    magier->setze(2,1);
    loch=0;
    tell_room(ME,break_string("Der Magier hebt seinen Stab und "
      "der Papierstopsel wird von den Wassermassen herausgedrueckt."));
    return;
  }
  if (!objectp(magier))
  {
    loch=0;
    tell_room(ME,break_string("Ploetzlich wird der Papierstopsel "
      "von den Wassermassen herausgedrueckt."));
    return;
  }
  if (find_call_out("zurueck_loch")==-1)
    call_out("zurueck_loch",60);
}

void zurueck_regal()
{
  while (remove_call_out("zurueck_regal")!=-1) ;
  if (!regal) return;
  if (objectp(magier) && !magier->InFight())
  {
    regal=0;
    tell_room(ME,break_string("Der Magier hebt seinen Stab. Das umgekippte "
       "Regal ist von einem Gluehen umgeben und steht ploetzlich wieder an "
       "seinem Platz."));
    return;
  }
  if (!objectp(magier))
  {
    regal=0;
    tell_room(ME,break_string("Ploetzlich ist das umgekippte Regal "
       "von einem Gluehen umgeben und steht wieder an seinem Platz."));
    return;
  }
  if (find_call_out("zurueck_regal")==-1)
    call_out("zurueck_regal",60);
}

int get_platte()
{
  return platte;
}

int get_loch()
{
  return loch;
}

