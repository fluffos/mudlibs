#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();

void create() 
{
  ::create();
  create_mitte();

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Du stehst vor einem Durchgang, der im Sueden in eine verwuestete "
    "Bibliothek fuehrt. So wie diese aussieht, brauchst Du in ihr "
    "nicht mehr nach Informationen suchen. Wesentlich ansprechender "
    "sind jedenfalls die Bilder, welche hier draussen rechts und links "
    "neben dem Durchgang haengen.");
  AddDetail(({"durchgang"}),
    "Der Durchgang fuehrt in die Bibliothek. Doch bist Du Dir nicht "
    "sicher, ob Du dort hinein willst. Der Anblick der sich Dir bietet, "
    "laedt nicht dazu ein in der Bibliothek zu stoebern.");
  AddDetail(({"bibliothek","anblick"}),
    "Oh Gott, sieht es in der Bibliothek fuerchterlich aus. "
    "Von hier siehst du zwar nur Teile des Raumes, doch liegen "
    "auf dem Boden die Buecher wild durcheinander und sind "
    "von einer dicken Staubschicht bedeckt.");
  AddDetail(({"buecher","buch"}),
    "Die Buecher findest Du in der Bibliothek.");
  AddDetail(({"teil","teile"}),
    "Wenn Du die ganze Bibliothek sehen willst, wirst Du sie "
    "betreten muessen.");
  AddDetail(({"bild","bilder"}),
    "Du siehst neben dem Durchgang einige Bilder. Darauf sind wohl die "
    "Gesichter beruehmter Magier abgebildet.");
  AddDetail(({"gesicht","gesichter","magier"}),
    "Du glaubst, dass auf den Bildern Magier abgebildet sind, doch sicher "
    "bist Du Dir nicht und wenn Du es genau bedenkst, ist Dir das auch "
    "sch.... egal.");
  AddDetail(({"gott"}),
    "Gibt es einen?");
  AddDetail(({"information","informationen"}),
    "Ob Du in der verwuesteten Bibliothek noch nuetzliche Informationen "
    "finden kannst?");
  AddDetail(({"osten","sueden","westen"}),
    "In diese Richtung kannst Du gehen.");

  AddExit("sueden",ROOM "biblo");
  AddExit("osten",ROOM "gang2_4");
  AddExit("westen",ROOM "gang2_6");
}

