#pragma strict_types
#include "../def.h"
inherit STD "runenwand";

void create();
int exit_osten();

void create() 
{
  ::create();
  create_aussen_mitte();

  SetProp(P_INT_SHORT, "In luftiger Hoehe");
  SetProp(P_INT_LONG,
    "Du stehst auf einem Balkon des Turmes in luftiger Hoehe. "
    "Man koennte meinen, ein Balkon wird dazu errichtet, um die Aussicht "
    "oder die frische Luft zu geniessen, doch war das hier eindeutig "
    "nicht der Zweck dieses Bauwerkes.");

  SetProp(P_ARCHON_RUNE_IN_QUEST,8);
  
  AddDetail(({"zweck"}),
    "Der Zweck dieses Balkons ist die Rune zu erreichen, die hier in "
    "der Wand eingelassen ist.");
  AddDetail(({"bauwerk","bauwerkes"}),
    "Meinst Du den Balkon?");
  AddDetail(({"aussicht"}),
    "Von welcher Aussicht sprichst Du denn?");
  AddDetail(({"hoehe"}),
    "An der Spitze bist Du zwar noch nicht angelangt, aber Du bist "
    "weit oberhalb des Hoehlengrundes.");
  AddDetail(({"spitze"}),
    "Die Spitze des Turmes muss irgendwo ueber Dir sein.");
  
  AddExit("osten",#'exit_osten);
}

int exit_osten()
{
  write(break_string(
    "Du kletterst zurueck durch das Loch und befindest Dich "
    "schon bald in einem Gang, welcher auf einem Pfad zwischen "
    "Baeumen endet. Nach ein paar weiteren Schritten stehst "
    "Du inmitten einer Lichtung."));
  PL->move(ROOM "wlaeufer_raum",M_GO,"","verschwindet",
    "erscheint ploetzlich auf der Lichtung");
  return 1;
}

