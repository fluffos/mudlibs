#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();
void reset();
int cmd_befuehle(string str);
int cmd_robbe(string str);
void make_schacht();
void make_kante();

int einbuchtung;

void create() 
{
  ::create();
  create_unten();

  SetProp(P_INT_SHORT, "Ein Gang");
    
  AddDetail(({"finger","fingern"}),
    "Die Finger sind an Deiner Hand festgewachsen.");
  AddDetail(({"hand","arm"}),
    "Weisst Du denn gar nichts?");
  AddDetail(({"angst"}),
    "Angst hat jeder einmal.");

  AddCmd(({"robbe","robben","hineinrobben"}),"cmd_robbe");
  AddCmd(({"fuehl","fuehle","fuehlen","befuehl","befuehle",
           "befuehlen"}),"cmd_befuehlen");
  AddDetail(({"osten","westen"}),
    "In diese Richtung kannst Du gehen.");

  AddExit("westen",ROOM "gang1_2");
  AddExit("osten",ROOM "gang1_4");
  
  reset();

  AddItem(NPC "waechter",REFRESH_DESTRUCT);
  AddItem(NPC "waechter",REFRESH_DESTRUCT);
}

void reset()
{
  ::reset();
  einbuchtung=1;
  make_kante();
}

int cmd_robbe(string str)
{
  int pos;
  if (!S_STANDARD->check_cmd(str,
       "schacht",
       "Wo willst Du hineinrobben?"))
    return 0;

  if (einbuchtung)
  {
    write("Wie bitte? Hier ist weit und breit kein Schacht.\n");
    return 1;
  }
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  if (pos==6)
  { //quest - es ist nun notwendig raus zu den runen zu kommen
    write(break_string("Du robbst in den Schacht hinein. Schon nach "
      "einer kurzen Zeit ist weit und breit kein Licht mehr zu sehen. "
      "Die Enge macht Dir langsam zu schaffen, als der Schacht "
      "unvermittelt aufhoert und Du Dich gerade noch an der "
      "Aussenwand des Turmes festhalten kannst."));
    PL->move(ROOM "aussen_1",M_GO|M_SILENT);
    tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
              " verschwindet in einem Schacht."),({PL}));
    return 1;
  }
  write(break_string("Du willst schon in den Schacht hineinrobben, doch "
        "im letzten Augenblick ueberlegst Du es Dir noch einmal anders. "
        "Was solltest Du auch in dem Schacht wollen? Solange Du keinen "
        "Grund hast dort hinein zu muessen, laesst Du es lieber sein."));
  return 1;
}

int cmd_befuehlen(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "einbuchtung|einbuchtungen",
       "Was willst Du befuehlen?"))
    return 0;

  if (einbuchtung)
  {
    einbuchtung=0;
    make_schacht();
    write(break_string("Du befuehlst Die Einbuchtung mit Deinen Fingern, "
        "als Du ploetzlich ein Klicken hoerst und sich die Suedwand zu "
        "verformen beginnt und sich dann aufloest. Anstelle der Kante "
        "erkennst Du nun einen engen Schacht, welcher nach Sueden "
        "fuehrt."));
    tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
        " macht etwas an der Suedwand, als sie sich ploetzlich veraendert "
        "und dort ein Schacht entsteht."),({PL}));
    return 1;
  }
  write(break_string("Du befuehlst die Kanten und Einbuchtungen an den "
        "Waenden, doch kannst nichts ungewoehnliches entdecken."));
  return 1;
}

void make_schacht()
{
  RemoveDetail(({"unterseite"}));
  SetProp(P_INT_LONG,
    "Der Gang wird hier ploetzlich sehr schmal und Du hast schon Angst, "
    "das Du nicht hindurchpasst. Doch zum Glueck wird der Gang gleich wieder "
    "breiter und du schaust Dich etwas irritiert um. Dabei entdeckst Du in "
    "der Suedwand, nahe dem Boden, einen engen Schacht.");
  AddDetail(({"suedwand"}),
    "Das einzig auffaellig an der Suedwand ist ein Schacht, welcher in ihr "
    "verschwindet.");
  AddDetail(({"schacht"}),
    "Du koenntest in den Schacht hineinrobben.");
  AddDetail(({"kanten","kante","einbuchtung","einbuchtungen"}),
    "Es gibt an den Waenden viele Kanten und Einbuchtungen.");
}

void make_kante()
{
  tell_room(ME,break_string("Ploetzlich verschwindet der Schacht in der "
    "Suedwand und an seiner Stelle entsteht eine grosse Kante."));
  SetProp(P_INT_LONG,
    "Der Gang wird hier ploetzlich schmaler und Du schuerfst Dir Deinen Arm "
    "auf, als Du Dich an einer weit herausragende Kante vorbeischiebst. "
    "Zum Glueck ist nur diese eine Stelle so schmal. Kaum bis Du an dieser "
    "vorbei, hast Du rechts und links wieder viel Platz.");
  einbuchtung=1;
  
  RemoveDetail(({"schacht"}));
  AddDetail(({"platz"}),
    "Du hast sooooo viel Platz.");
  AddDetail(({"kanten"}),
    "Es gibt hier viele Kanten, doch nur eine an der Suedwand ragt stark "
    "heraus.");
  AddDetail(({"suedwand"}),
    "Das einzig auffaellig an der Suedwand ist eine weit herausragende "
    "Kante.");
  AddDetail(({"kante"}),
    "Als Du die Kante genauer betrachtest, faellt Dir eine Einbuchtung an "
    "der Unterseite auf.");
  AddDetail(({"stelle","stellen"}),
    "Es gibt viele Stellen. Welche meinst Du denn?");
  AddDetail(({"unterseite"}),
    "Auf der Unterseite der grossen Kante ist eine Einbuchtung.");
  AddDetail(({"einbuchtung","einbuchtungen"}),
    "Die Einbuchtung ist merkwuerdig, vielleicht solltest Du sie mal genauer "
    "mit Deinen Fingern befuehlen.");
}
