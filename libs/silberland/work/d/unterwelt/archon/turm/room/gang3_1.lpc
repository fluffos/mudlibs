#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();
void make_leiter(object leiter,object pl); //wird aus der leiter aufgerufen
int exit_oben();
void reset();
string detail_loch();

int leiter;

void create() 
{
  ::create();
  create_spitze();
  create_aufgang(2);
  leiter=0;

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Du stehst in einem einfachen, wenn auch verrussten Raum. "
    "Vier Ausgaenge fuehren in jede Himmelsrichtung aus diesem "
    "heraus und in der Mitte des Raumes ist im Fussboden eine "
    "Treppe eingelassen. Ueber Dir kannst Du ein Loch in der Wand erkennen.");
  
  AddDetail(({"ausgang","ausgaenge"}),
    "In jeder Himmelsrichtung ist ein Ausgang. Was Dich dort wohl "
    "erwarten wird?");
  AddDetail(({"richtung","himmelsrichtung"}),
    "Willst Du nach Norden, Osten, Sueden oder Westen?");
  AddDetail(({"norden","osten","sueden","westen"}),
    "In diese Richtung kannst Du gehen.");
  AddDetail(({"mitte","boden","fussboden"}),
    "Der Boden ist schwarz gebrannt. In der Mitte des Raumes "
    "fuehrt eine Treppe hinab.");
  AddDetail(({"loch"}),#'detail_loch);

  AddExit("norden",ROOM "gang3_5");
  AddExit("osten",ROOM "gang3_2");
  AddExit("sueden",ROOM "gang3_3");
  AddExit("westen",ROOM "gang3_4");
}

int cmd_sagen(string str)
{
  if (::cmd_sagen(str)!=3) 
    return 0;

  write(break_string(
    "Du befiehlst 'UNTEN' und schon erscheint ein geisterhafter Diener, "
    "hebt Dich hoch und rast mit Dir die Treppen hinab. Du hast nicht "
    "einmal Zeit Atem zu holen, bevor Dich der Diener schon unten absetzt."));
  PL->move(ROOM "gang2_8.lpc",M_GO,"","verschwindet","erscheint");
  return 1;
}

void make_leiter(object leiter_in,object pl)
{
  if (leiter)
  {
    tell_object(pl,break_string("Da hier schon eine Leiter aufgestellt ist, "
      "koenntest Du auch diese benutzen.")); 
    return;
  }
  tell_object(pl,"Du stellst eine Leiter auf und kannst nun nach oben gehen.\n");
  tell_room(ME,break_string(pl->Name(WER,NAME_AUTO)+
    " stellt eine Leiter auf."),({pl}));
  AddExit("oben",#'exit_oben);
  AddDetail(({"leiter"}),
    "Eine Leiter steht an der Wand und fuehrt direkt hinauf zu dem Loch.");
  leiter_in->remove(1);
  leiter=1;
}

void reset()
{
  ::reset();
  if (leiter)
  {
    tell_room(ME,"Ploetzlich faellt die Leiter um und loest sich in Staub auf.\n");
    RemoveExit("oben");
    RemoveDetail("leiter");
    leiter=0;
  }
}

int exit_oben()
{
  int pos;
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  if (pos==6)
  { //in der quest
    write(break_string(
      "Du kletterst die Leiter hinauf und hast nun die Spitze des "
      "Turmes erreicht."));
    PL->move(ROOM "aussen_spitze",M_GO,"","klettert die Leiter hinauf",
             "erscheint");
    return 1;
  }
  write(break_string("Du willst gerade nach oben klettern, als Dir ploetzlich "
    "ein Waechter des Turmes den Weg versperrt und Dich daran hindert. Na ja "
    "eigentlich hast Du dort oben auch zur Zeit nichts zu erledigen."));
  return 1;
}

string detail_loch()
{
  if (!leiter)
   return break_string("In der Wand ueber Dir ist ein Loch, doch ist es leider zu "
     "hoch, als das Du dorthin gelangen koenntest.");
  return break_string("Zum den Loch fuehrt eine Leiter hinauf, ueber die Du "
     "es bequem erreichen kannst.");
}
