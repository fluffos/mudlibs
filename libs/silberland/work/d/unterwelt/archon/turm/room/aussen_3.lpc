#pragma strict_types
#include "../def.h"
inherit STD "runenwand";

void create();
string _query_int_long();
int cmd_taste(string str);
int cmd_halten(string str);

void create() 
{
  ::create();
  create_aussen_unten(3);

  SetProp(P_INT_SHORT, "In luftiger Hoehe");
  SetProp(P_ARCHON_RUNE_IN_QUEST,3);
  
  AddDetail(({"nordwand"}),GetDetail("wand"));
  AddDetail(({"tasten"}),
    "Willst Du etwas ertasten? Und wenn ja was?");
  AddDetail(({"wichtigerem","wichtigem"}),
    "Meinst Du eine Rune?");
 
  AddCmd(({"ertaste","ertasten","taste","tasten"}),"cmd_taste");
  AddCmd(({"halt","halte","halten"}),#'cmd_halten);
}

string _query_int_long()
{
  aufraeumen();
  return break_string(
    "Hier an der Nordwand des Turmes ist es viel dunkler, als dort "
    "woher Du bis hierher geklettert bist. Nur durch Tasten kannst "
    "Du ueberhaupt noch Risse und Spalten finden, welche Dir dazu "
    "dienen koennen, dass Du Dich festhalten kannst.");
}

int cmd_taste(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "riss|risse|rissen|spalt|spalte|spalten",
       "Wonach willst Du tasten?"))
  {
    if (!S_STANDARD->check_cmd(str,
       "wichtigem|wichtigerem|wichtig|wichtiges",
       "Wonach willst Du tasten?"))
    {
      if (!S_STANDARD->check_cmd(str,
         "rune|runen",
         "Wonach willst Du tasten?"))
        return 0;
      
      tell_room(ME,break_string(
        PL->Name(WER,1)+" tastet nach irgendetwas herum."),({PL}));  
      write(break_string("Du tastest gewissenhaft die gesamte Wand ab "
        "und findest tatsaechlich eine Rune."));
      if (get_rune_found(PL)<1)
        set_rune_found(PL,1);
      return 1;
    }
    write("Was koennte wohl wichtig sein?\n");
    return 1;
  }
  write(break_string(
    "Du tastest nach weiteren Rissen oder Spalten, in welchen Du "
    "Dich besser festhalten kannst. Doch leider findest Du nichts, "
    "aber vielleicht solltest Du nach etwas Wichtigem tasten, "
    "was Du auch suchst?"));
  tell_room(ME,break_string(
    PL->Name(WER,1)+" tastet nach irgendetwas herum."),({PL}));  
  return 1;
}

int cmd_halten(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "riss|risse|rissen|spalt|spalte|spalten",
       "Woran willst Du Dich festhalten?"))
    return 0;
  write("Du haelst Dich schon dort fest, oder wolltest Du tasten?\n");
  return 1;
}