#include "../def.h"
inherit STD "turm";

void create();

#define ausnahmen ({"unt","untersuche","schau","typo","bug","idee"})

object owner;
object goto_raum;

void create() 
{
  ::create();
  create_aufgang(0);
  SetProp(P_INDOORS, 1); 
  SetProp(P_LIGHT, 1); 
  SetProp(P_INT_SHORT,"Auf einer Treppe");
}

string _query_int_long()
{
  return "";
}

string GetExits(object viewer,int short)
{
  return "";
}

int abc()
{
  if (member_array(query_verb(), ausnahmen) != -1) return 0;
  tell_object(owner, "Laufe lieber weiter, dafuer hast Du jetzt keinen Atem.\n");
  return 1;
}

void set_owner(object pl,object woher)
{
  add_action("abc","",1);
  owner=pl;
  goto_raum=woher;
  call_out("gehe",1,1);
}

void gehe(int pos)
{
  if (!objectp(owner) || environment(owner)!=ME)
    return;
  switch(pos)
  {
    case 0: //wird schon gleich ausgegeben
      tell_object(owner,"Du betrittst die Treppe und beginnst zu laufen.\n");
    break;
    case 1: 
      tell_object(owner,"Und Du laeufst.\n");
    break;
    case 2:
      tell_object(owner,"Und laeufst.\n");
    break;
    case 3:
      tell_object(owner,"Mal gehts aufwaerts, mal abwaerts.\n");
    break;
    case 4: 
      tell_object(owner,"Dann scheint sich die gesamte Treppe zu drehen.\n");
    break;
    case 5: 
      tell_object(owner,"Bist Du sicher, noch in die richtige Richtung zu "
                        "gehen?\n");
    break;
    case 6: 
      tell_object(owner,"Irgend etwas laeuft hier schief.\n");
    break;
    case 7: 
      tell_object(owner,"Doch halt dort vorne hoert die Treppe auf.\n");
    break;
    case 8: 
      tell_object(owner,"Erfreut rennst Du die letzten Stufen.\n");
    break;
    case 9: 
      tell_object(owner,"Doch nein!!\n");
    break;
    case 10: 
      tell_object(owner,break_string("Was ist das? Du bist ja wieder dort, wo "
        "Du aufgebrochen bist. Die Treppe muss einfach verzaubert sein. So "
        "kannst Du sie jedenfalls nicht benutzen. Wenn Du doch nur eine "
        "Eingebung haettest."));
    break;
    case 11:
      owner->move(goto_raum,M_GO,"","verschwindet","erscheint");
    break;
  }
  call_out("gehe",1,pos+1);
}
