#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();

void create() 
{
  ::create();
  create_unten();
  create_aufgang(1);

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Ploetzlich endet der Gang. Wenn Du weiter willst, musst Du "
    "die hier beginnende breite Treppe benutzen. Komisch ist nur, "
    "dass Du keinerlei Fussspuren auf ihren Stufen finden kannst, "
    "obwohl Du Dir sicher bist, dass andere die Treppe benutzt und "
    "weiter hinauf gegangen sein muessen, denn bis zum Treppenabsatz "
    "kannst deutlich dutzende Fussspuren sehen.");
  AddDetail(({"osten","oben"}),
    "In diese Richtung kannst Du gehen.");

  AddExit("osten",ROOM "gang1_6");
}


int cmd_sagen(string str)
{
  if (::cmd_sagen(str)!=2)
    return 0;
  write(break_string(
    "Du befiehlst 'OBEN' und schon erscheint ein geisterhafter Diener, "
    "hebt Dich hoch und rast mit Dir die Treppen hinauf. Du hast nicht "
    "einmal Zeit Atem zu holen, bevor Dich der Diener schon oben absetzt."));
  PL->move(ROOM "gang2_1.lpc",M_GO,"","verschwindet","erscheint");
  return 1;
}

