#pragma strict_types
#include "../def.h"
inherit STD "runenwand";

void create();
string _query_int_long();
int exit_norden();

void create() 
{
  ::create();
  create_aussen_unten(1);

  SetProp(P_INT_SHORT, "In luftiger Hoehe");
  SetProp(P_ARCHON_RUNE_IN_QUEST,1);
  
  AddDetail(({"suedwand"}),GetDetail("wand"));
  AddDetail(({"kopf"}),
    "Weil Du Dich so sehr festhalten musst und dabei Deinen Koerper "
    "sehr nahe an die Wand ziehst, kannst Du leider Deinen Kopf kaum "
    "wenden und umhersehen.");
  AddDetail(({"anstrengung"}),
    "Buuuhhh.");
  AddDetail(({"koerper"}),
    "Zum Glueck ist Dein Koerper kraeftig und durchtraniert, sonst "
    "wuerdest Du wohl in die Tiefe stuerzen.");
  AddDetail(({"blickwinkel"}),
    "Die Rune ist direkt neben Deiner Hand - mehr brauchst Du nicht "
    "zu sehen.");

  AddExit("norden",#'exit_norden);  
}

string _query_int_long()
{
  aufraeumen();
  return break_string(
    "Du haeltst Dich an der zackigen, unebenen und rissigen Aussenwand des "
    "Turmes fest, waehrend Du die Fuesse in tiefe Spalten zwaengst. Zum "
    "Glueck hast Du so etwas Halt. Vor lauter Anstrengung kannst Du "
    "Deinen Kopf nicht besonders gut wenden, so dass Dein Blickwinkel stark "
    "eingeschraenkt ist. Viel mehr, als dass Du Dich ausserhalb des Turmes "
    "in einiger Hoehe befindest, kannst Du nicht ausmachen. Doch halt! "
    "Neben Deiner rechten Hand siehst Du eine Rune, welche in der Turmwand "
    "eingelassen ist.");
}

int exit_norden()
{
  write(break_string("Du kletterst etwas tiefer, um Dich in den Schacht "
    "hinein zu schieben. Kaum hast Du wieder festen Halt unter Dir, "
    "beginnst Du schnell durch den Schacht zu robben und stehst schon "
    "nach kurzer Zeit wieder im Gang innerhalb des Turmes."));
  PL->move(ROOM "gang1_3",M_GO,"","verschwindet im Schacht",
           "erscheint ploetzlich");
  return 1;
}