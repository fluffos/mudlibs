#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();

void create() 
{
  ::create();
  create_mitte();

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem breiten Gang, welcher die "
    "Treppe im Westen mit den weiter suedlich "
    "befindlichen Raeumen dieser Ebene verbindet. Eine "
    "dicke Staubschicht bedeckt den Boden und wird bei "
    "jedem Deiner Schritte aufgewuehlt.");
  
  AddDetail(({"treppe"}),
    "Gehe weiter nach Westen.");
  AddDetail(({"raeume","raeumen"}),
    "Folge dem Gang nach Sueden.");
  AddDetail(({"sueden","westen"}),
    "Du kannst dem Gang in dieser Richtung folgen.");
  AddDetail(({"richtung"}),
    "Meinst Du Westen oder Sueden?");
  AddDetail(({"schritt","schritte"}),
    "Mit jedem Deiner Schritte erzeugt Du eine Staubwolke.");
  AddDetail(({"wolke","staubwolke"}),
    "Durch Deine Schritte aufgewirbelt, umgibt Dich eine "
    "Staubwolke. Na hoffentlich musst Du nicht niesen.");
  AddDetail(({"sueden","westen"}),
    "In diese Richtung kannst Du gehen.");

  AddExit("westen",ROOM "gang2_1");
  AddExit("sueden",ROOM "gang2_3");

  AddItem(NPC "culromex",REFRESH_DESTRUCT);
  AddItem(NPC "vorina",REFRESH_DESTRUCT);
}

