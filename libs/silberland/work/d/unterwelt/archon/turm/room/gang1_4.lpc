#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();

void create() 
{
  ::create();
  create_unten();

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Du stehst vor einer Wendeltreppe, welche in der oestlichen Wand nach "
    "unten fuehrt. Du ruempfst die Nase, als Dir der Verwesungsgeruch, "
    "welcher von unten heraufweht, bewusst wird. Vermutlich ist es keine "
    "gute Idee die Wendeltreppe runter zu gehen, aber zum Glueck geht es "
    "auch nach Norden und Westen weiter.");

  AddDetail(({"nase"}),
    "Du faesst Dir an die Nase und haeltst sie zu.");
  AddDetail(({"treppe", "wendeltreppe"}),
    "Eine steinerne Wendeltreppe fuehrt weiter hinab in den Turm. "
    "Was mag dort unten sein?");
  AddDetail(({"steinstufe","steinstufen","stufen","stein","steine"}),
    "Die Treppe besteht aus einfachen Steinstufen.");
  AddDetail(({"idee"}),
    "Meinst Du, dass die Idee, 'Idee' zu untersuchen, zu etwas fuehrt?");
  AddDetail(({"ostwand"}),
    "Dort fuehrt eine Treppe hinab.");
    
  AddDetail(({"verwesungsgeruch","geruch"}),
    "Rieche lieber.");
  AddSmell(DEFAULT_SMELL,
    "Ein leichter Verwesungsgeruch liegt in der Luft. Anscheinend zieht "
    "dieser Gestank von unten herauf.");
  AddSmell(({"gestank"}),
    "Igitt.");
  AddSmell(({"verwesung","verwesungsgeruch","geruch","gerueche"}),
    "Gott sei Dank, ist der Verwesungsgeruch nur ganz leicht.");
  AddDetail(({"norden","ostunten","westen"}),
    "In diese Richtung kannst Du gehen.");

  AddExit("norden",ROOM "gang1_5");
  AddExit("westen",ROOM "gang1_3");
  AddExit(({"ostunten","osten"}),ROOM "labor");
  SetProp(P_HIDE_EXITS,({"osten","aufgabe"}));

  AddItem(NPC "prasamaccus",REFRESH_DESTRUCT);
}

