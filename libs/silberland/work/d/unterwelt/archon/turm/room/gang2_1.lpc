#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();

void create() 
{
  ::create();
  create_mitte();
  create_aufgang(2);

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Du stehst vor einer breiten Treppe die hinab fuehrt. "
    "Wie Du nun weisst, brauchst Du nur einem Diener befehlen "
    "Dich hinab zu bringen und schon wirst Du eine "
    "Ebene tiefer abgesetzt. Dies erklaert auch die fehlenden "
    "Fussspuren auf den Treppenstufen. Im Norden siehst "
    "Du einen Altarraum.");

  AddDetail(({"altarraum"}),
    "Du solltest ihn betreten.");
  AddDetail(({"norden","osten","unten"}),
    "In diese Richtung kannst Du gehen.");

  AddExit("norden",ROOM "pali_raum");
  AddExit("osten",ROOM "gang2_2");

  call_other(ROOM "gang2_2", "???", 0); //die anderen mnpc laden
}

int cmd_sagen(string str)
{
  if (::cmd_sagen(str)!=3) 
    return 0;
  write(break_string(
    "Du befiehlst 'UNTEN' und schon erscheint ein geisterhafter Diener, "
    "hebt Dich hoch und rast mit Dir die Treppen hinab. Du hast nicht "
    "einmal Zeit Atem zu holen, bevor Dich der Diener schon unten absetzt."));
  PL->move(ROOM "gang1_7.lpc",M_GO,"","verschwindet","erscheint");
  return 1;
}

