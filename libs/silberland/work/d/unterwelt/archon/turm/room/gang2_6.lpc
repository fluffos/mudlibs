#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();
void reset();
int cmd_ausschuetten(string str);
int cmd_heben(string str);
int cmd_oeffne(string str);
int cmd_ziehe(string str);

int giesskanne;

void create() 
{
  ::create();
  create_mitte();

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Du stehst in einem breiten Gang, welcher hier einen Knick von "
    "Osten nach Norden macht. In der Ecke steht eine alte Kommode "
    "mit einer voellig verstaubten Tischdecke und einer Vase darauf.");

  AddDetail(({"knick","ecke"}),
    "In der Ecke steht eine alte Kommode.");
  AddDetail(({"vase"}),
    "Du schaust Dir die Vase an und schaust in sie hinein. Doch anstatt "
    "mit Wasser, ist die Vase bis oben hin mit Staub gefuellt. "
    "Auf der Seite sind einige Motive aufgedruckt.");
  AddDetail(({"motiv","motive","seite"}),
    "Du erkennst ein paar schoene Blumen, welche auf die Seite der "
    "Vase gezeichnet sind. Na ja wenigstens dort sind Blumen, wenn "
    "schon keine in der Vase sind.");
  AddDetail(({"blume","blumen"}),
    "In der Vase sind keine Blumen.");
  AddDetail(({"tischdecke"}),
    "Die Tischdecke ist voellig verstaubt und haengt vorne ueber die "
    "Kommode herab. Man koennte sie bestimmt hochheben, doch wuerdest "
    "Du Dir dann deine Finger dreckig machen, also laesst Du es lieber "
    "sein.");
  AddDetail(({"finger"}),
    "Oh die sind ja schon dreckig.");
  AddDetail(({"kommode","holzkommode"}),
    "Du siehst eine einfache Holzkommode, doch leider kannst Du kein "
    "Schubfach oder aehnliches erkennen.");
  AddDetail(({"fach","schubfach","schubfaecher"}),
    "Die Kommode hat kein Fach, oder?");
  AddDetail(({"griff","holzgriff"}),
    "Es ist kein Griff zu sehen.");
  AddDetail(({"wasser"}),
    "Hier ist kein Wasser.");
  AddDetail(({"norden","osten"}),
    "In diese Richtung kannst Du gehen.");

  AddCmd(({"schuette","schuetten","ausschuetten"}),"cmd_ausschuetten");
  AddCmd(({"hebe","heben","hochheben","anheben"}),"cmd_heben");
  AddCmd(({"oeffne","oeffnen"}),"cmd_oeffne");
  AddCmd(({"zieh","ziehe","ziehen"}),"cmd_ziehe");

  AddExit("norden",ROOM "gang2_7");
  AddExit("osten",ROOM "gang2_5");
  
  reset();
}

void reset()
{
  ::reset();
  giesskanne=1;
}

int cmd_ausschuetten(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "vase",
       "Was willst Du ausschuetten?"))
    return 0;

  write(break_string("Du nimmst die Vase und drehst sie um. Doch nichts "
    "faellt heraus, so sehr Du auch die Vase schuettelst - kein Staub, "
    "kein Zaubertrank - einfach nichts. Enttaeuscht stellst Du sie wieder "
    "hin"));
  tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
    " macht irgendetwas."),({PL}));
  return 1;
}

int cmd_heben(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "decke|tischdecke",
       "Was willst Du anheben?"))
    return 0;

  write(break_string("Vorsichtig hebst Du die Tischdecke an und entdeckst "
    "darunter einen kleinen Griff. Vielleicht kann man ja daran ziehen? "
    "Du laesst die Tischdecke wieder los."));
  return 1;
}

int cmd_oeffne(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "kommode",
       "Was willst Du oeffnen?"))
    return 0;

  write("Du findest nichts, was Du an der Kommode oeffnen koenntest.\n");
  return 1;
}

int cmd_ziehe(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "griff|holzgriff",
       "Woran willst Du ziehen?"))
    return 0;

  tell_room(ME,break_string(PL->name(WER,NAME_AUTO)+
    " macht irgendetwas."),({PL}));
  if (!giesskanne)
  {
    write(break_string("Du ziehst kraeftig an dem Griff und ploetzlich "
      "oeffnet sich die eine Seite der Kommode. Du schaust hinein und "
      "findest nichts. Doch im Inneren der Kommode ist ein Abdruck zu sehen. "
      "Vor kurzem muss dort noch etwas gestanden haben. Offenbar war jemand "
      "schneller als Du. Enttaeuscht schliesst Du die Kommode wieder."));
    return 1;
  }
  giesskanne--;
  write(break_string("Du ziehst kraeftig an dem Griff und ploetzlich "
    "oeffnet sich die eine Seite der Kommode. Du schaust hinein und "
    "findest eine Giesskanne. Du nimmst sie heraus und stellst sie neben "
    "der Kommode ab, bevor Du diese wieder schliesst."));
  clone_object(OBJ "giesskanne")->move(ME,M_PUT);
  return 1;
}
