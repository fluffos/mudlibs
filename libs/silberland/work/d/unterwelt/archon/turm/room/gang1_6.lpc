#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();
int cmd_tuer(string str);
int exit_westen();

void create() 
{
  ::create();
  create_unten();

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Du stehst auf einem breiten Gang. Im Osten ist eine verschlossene "
    "Kerkertuer. Nahe dem Boden sind in der Tuer einigen Gitterstaeben "
    "eingelassen, durch welche ein wenig Stroh heraus haengt. Ansonsten "
    "ist der Gang leer.");

  AddDetail(({"tuer","kerkertuer","seite"}),
    "Du ruettelst an der Kerkertuer. Doch nach kurzer Zeit gibst Du "
    "auf, denn Du siehst ein, dass Du die Tuer so nie aufbekommst. Warum "
    "solltest Du auch in den Kerker wollen? Solange Du auf dieser Seite der "
    "Tuer bist, solltest Du keinen Gedanken daran verschwenden, "
    "wie Du die Tuer aufbekommen kannst.");
  AddDetail(({"gedanke","gedanken"}),
    "Hast Du welche?");
  AddDetail(({"gitter"}),
    "Die Gitter sind nahe dem Boden. Zwischen den einzelnen Stangen "
    "ragen ein paar Strohhalme heraus.");
  AddDetail(({"stab","staebe","gitterstaebe","gitterstab","stange","stangen"}),
    "Du kannst 4 Staebe erkennen.");
  AddDetail(({"stroh","stohhalm","halm","strohhalme","halme","boden"}),
    "Du siehst am Boden ein paar Strohhalme, welche aus dem "
    "Kerker stammen. Durch das Gitter kannst Du im Inneren des "
    "Kerkers noch viel mehr Stroh erkennen.");
  AddDetail(({"kerker","innere","inneres"}),
    "Warum interessierst Du Dich denn fuer das Innere des Kerkers? "
    "Sei froh das Du draussen bist.");
  AddDetail(({"sueden","westen"}),
    "In diese Richtung kannst Du gehen.");

  AddCmd(({"ruettel","ruetteln","ruettle","oeffne","oeffnen","brech",
           "breche","brechen"}),"cmd_tuer");
  
  AddExit("westen",#'exit_westen);
  AddExit("sueden",ROOM "gang1_5");
//  AddExit("osten",ROOM "kerker"); // man landet als boeser im kerker und muss da raus, anders kommt man nicht rein
}

int cmd_tuer(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "tuer|kerkertuer|kerker",
       "Was willst Du oeffnen oder aufbrechen?"))
    return 0;

  write("Die Tuer bekommst Du nie im Leben auf.\n");
  return 1;
}

int exit_westen()
{
  int quest_pos;
  quest_pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  if (quest_pos==8)
  {
    write(break_string(
      "Du solltest lieber so schnell wie moeglich Deinem Auftragsgeber "
      "vom erfolgreichen manipulieren der Runen berichten."));
    return 1;
  }
  PL->move(ROOM "gang1_7",M_GO);
  return 1;
}