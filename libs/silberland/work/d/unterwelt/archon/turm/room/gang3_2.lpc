#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();
void reset();
string detail_plane();
int cmd_ziehe(string str);

int plane;

void create() 
{
  ::create();
  create_spitze();

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Du bist auf einem Rundgang in der Spitze des Turmes. "
    "In der Ostwand ist eine Nische eingelassen in welcher "
    "Du eine Ascheschicht erkennst. Unterhalb der Nische liegt eine "
    "verkohlte Plane und verdeckt den unteren Teil der Wand.");

  AddDetail(({"rundgang","raum"}),QueryProp(P_INT_LONG));
  AddDetail(({"nische","ostwand"}),
    "In der Ostwand ist eine Nische eingearbeitet worden, "
    "doch was auch immer dort einmal stand, jetzt ist nichts, "
    "ausser ein Aschehaufen, davon uebrig.");
  AddDetail(({"asche","ascheschicht","schicht","haufen","haeufchen",
              "aschehaufen","aschehaeufchen"}),
    "In der Nische liegt ein Aschehaeufchen. Was auch immer dort "
    "einmal gestanden hat, ist nun verbrannt und unbrauchbar.");
  AddDetail(({"plane"}),#'detail_plane);
  AddDetail(({"teil"}),
    "Die Plane verdeckt den unteren Teil der Wand.");
  AddDetail(({"nordwesten","suedwesten","westen"}),
    "In diese Richtung kannst Du gehen.");

  AddCmd(({"zieh","ziehe","ziehen"}),"cmd_ziehe");

  AddExit("westen",ROOM "gang3_1");
  AddExit("nordwesten",ROOM "gang3_5");
  AddExit("suedwesten",ROOM "gang3_3");
  
  reset();

  AddItem(NPC "maedlyn",REFRESH_DESTRUCT);
  AddItem(NPC "gwalmai",REFRESH_DESTRUCT);
}

void reset()
{
  ::reset();
  plane=1;
}

string detail_plane()
{
  if (plane)
  {
    return break_string("Die Plane verdeckt bestimmt etwas, vielleicht "
      "solltest Du sie zur Seite ziehen.");
  }
  return break_string("Die Plane liegt achtlos auf dem Boden. Frueher hat sie "
    "sicher etwas Wertvolles verdeckt. Ob man die Plane zur Seite ziehe "
    "kann?");
}

int cmd_ziehe(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "plane&seite|weg",
       "Was willst Du zur Seite ziehen?|Ziehe die Plane doch zur SEITE."))
    return 0;

  tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
       " zieht an etwas herum."),({PL}));
  if (plane)
  {
    plane=0;
    write(break_string("Du ziehst an der Plane und legst ploetzlich eine "
          "Leiter frei."));
    clone_object(OBJ "leiter")->move(ME,M_PUT);    
    return 1;
  }
  write(break_string("Du ziehst an der Plane, doch findest Du nichts "
    "darunter. Vielleicht war jemand schneller als Du?"));
  return -1;
}
