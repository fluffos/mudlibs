#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();
int cmd_greife(string str);
int cmd_schliessen(string str);

int naegel;

void create() 
{
  ::create();
  create_mitte();

  SetProp(P_KILL_NAME,"Brennende Flammen");
  SetProp(P_INT_SHORT,"Ein Gang");
  SetProp(P_INT_LONG,
    "Du stehst vor einer grossen geoeffneten Tuer auf einem Gang. "
    "Ueber der Tuer siehst Du ein Schild und daneben stehen zwei "
    "Kohlebecken, in denen jeweils eine ewige Flamme brennt.");
  
  AddDetail(({"becken","kohlebecken"}),
    "Zwei Kohlebecken stehen neben der Tuer und erleuchten den "
    "Gang mit ihrem flackernden Licht. Die Flammen umschliessen die "
    "Kohlestueckchen und doch scheinen sie sie nicht zu verbrennen.");
  AddDetail(({"flamme","flammen","feuer","weile"}),
    "Du schaust eine Weile dem Feuer zu und fragst Dich, wie es "
    "ueberhaupt brennen kann, da es allem Anschein nach, die Kohle "
    "nicht verbrennt.");
  AddDetail(({"anschein"}),
    "Die Kohle verbrennt nicht, oder?");
  AddDetail(({"tuer"}),
    "Die Tuer ist offen.");
  AddDetail(({"licht"}),
    "Anders als in den restlichen Raeumen des Turmes, wird der Gang "
    "durch zwei Flammen erhellt.");
  AddDetail(({"schild"}),
    "Auf dem Schild steht etwas geschrieben.");
  AddDetail(({"kohle","stueckchen","kohlestueck","kohlestuecke",
              "kohlestuecken","kohlestueckchen"}),
    "Als Du Dir die Kohle naeher betrachtest, siehst Du etwas Metallisches "
    "zwischen den Kohlestueckchen blitzen.");
  AddDetail(({"etwas","metallisch","metallisches"}),
    "Das sieht aus wie Naegel. Vielleicht solltest Du nach ihnen "
    "greifen - wer weiss, wofuer man sie gebrauchen kann.");
  AddDetail(({"nagel","naegel"}),
    "Da sind wirklich Naegel im Kohlebecken. Wie die dort hineingekommen "
    "sein moegen?");
  AddDetail(({"glaube","glauben","erloesung"}),
    "Tretet ein.");
  AddDetail(({"norden","osten","sueden"}),
    "In diese Richtung kannst Du gehen.");

  AddReadDetail(({"schild"}),
    "Im Glauben liegt die Erloesung.");  

  AddCmd(({"greif","greifen","greife"}),"cmd_greife");
  AddCmd(({"schliess","schliesse","schliessen"}),"cmd_schliessen");
  
  AddExit("norden",ROOM "gang2_2");
  AddExit("osten",ROOM "priester_raum");
  AddExit("sueden",ROOM "gang2_4");
  
  reset();
}

void reset()
{
  ::reset();
  naegel=1;
}

int cmd_greife(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "nagel|naegel|naegeln",
       "Wonach willst Du greifen?"))
    return 0;

  tell_room(ME,break_string(
    PL->Name(WER,NAME_AUTO)+" greift nach irgendwas."),({PL}));
  if (!naegel)
  {
    write(break_string("Du greifst furchtlos in das Becken, um einige Naegel "
       "zu ergattern, doch ist die Flamme so heiss, dass Du Dir die Hand "
       "verbrennst und sie sofort wieder herausziehst. Du siehst ein, dass, "
       "solange die Naegel in der Mitte liegen, Du sie nicht erreichen "
       "kannst. Komm doch spaeter wieder, dann liegen bestimmt einige Naegel "
       "weiter draussen."));
    PL->do_damage(10,ME);
    return -1;
  }
  naegel=0;
  write(break_string("Du greifst furchtlos in das Becken. Ein paar Naegel "
       "liegen so weit von den Flammen entfernt, dass Du sie, ohne Dich "
       "zu verbrennen, an Dich reissen kannst. Kaum in der Hand, spuerst "
       "Du, wie heiss die Naegel sind und laesst sie fallen."));
  PL->do_damage(2,ME);
  clone_object(OBJ "naegel")->move(ME,M_PUT);
  return 1;
}

int cmd_schliessen(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "tuer",
       "Was willst Du schliessen?"))
    return 0;

  write("So sehr Du Dich auch bemuehst, die Tuer bekommst Du nicht zu.\n");
  return 1;
}

