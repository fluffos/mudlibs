#pragma strict_types
#include "../def.h"
inherit "std/room";

void create();
int exit_norden();

//nicht neuankommlinge angreifen, wenn in zerimonie wegen anderem spieler
int beschaeftigt;

void create()
{
  ::create();

  beschaeftigt=0;

  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_CAVE]));
  SetProp(P_INT_SHORT, "In einem Tunnel");
  SetProp(P_NO_TPORT,NO_TPORT);//damit schutz in tunnel_01 nicht umgangen wird

  SetProp(P_INT_LONG,
    "Du bist in einer kleinen Hoehlenkammer. In der Mitte steht "
    "eine Art Altar, welcher blutverschmiert ist. Waehrend Du den "
    "Altar betrachtest, macht sich ein beklemmendes Gefuehl in Dir "
    "breit und Du hoffst nur, dass Du nicht das naechste Opfer bist. "
    "Dieses Gefuehl wird noch von den dunklen, unheimlichen Schatten, "
    "welche die Waende werfen, und dem schrecklichen Gestank nach "
    "Tod und Verwesung erhoeht.");
    
  AddDetail(({"umgebung","hoehle","kammer","hoehlenkammer"}),
    QueryProp(P_INT_LONG));
  AddDetail(({"wesen","dunkelelfen","dunkelefe",
              "dunkelelfenkrieger","dunkelelfenmagier",
              "dunkelelfenpriesterinnen","dunkelelfenpriesterin",
              "priesterin","priesterinnen"}),
    "Oh, hier ist ja gar keiner! Aber dies kann sich jeden Augenblick "
    "aendern.");
  AddDetail(({"augenblick"}),
    "Jeden Augenblick kann etwas passieren.");
  AddDetail(({"altar"}),
    "Auf diesem Altar opfern die Dunkelelfenpriesterin Leben, um Lloth "
    "zu erfreuen. Gerade jetzt liegt eine noch warme Leiche "
    "darauf. Die Priesterin hat Lloth bestimmt gerade "
    "erst durch dieses Opfer erfreut. Du schauderst und hoffst niemals "
    "darauf zu liegen, waehrend sie Dir bei lebendem Leib das Herz "
    "herausschneiden. Neben dem Altar brennt eine schwarze Flamme "
    "in einem Kohlebecken.");
  AddDetail(({"herz"}),
    "Ein riesiges Loch klaft in dem Opfer dort, wo das Herz sein sollte.");
  AddDetail(({"becken","kohlebecken","kohle"}),
    "Anscheint ist das Kohlebecken fuer dunkle Rituale oder Anrufungen "
    "notwendig.");
  AddDetail(({"ritual","rituale","anrufung","anrufungen"}),
    "Dafuer werden die Opfer benoetigt.");
  AddDetail(({"loch"}),
    "Du schauderst, als Du die Leiche des Opfers betrachtest.");
  AddDetail(({"leiche"}),
    "Der Leiche wurde waehrend der Opferung kunstvoll das Herz "
    "herausgerissen, so dass nun dort ein grosses rotes Loch "
    "klafft.");
  AddDetail(({"opferung"}),
    "Willst Du einer Opferung beiwohnen? Ja? Na hoffentlich geht Dein "
    "Wunsch nicht anders in Erfuellung, als Du es Dir vorstellst.");
  AddDetail(({"wunsch"}),
    "Manchmal sollte man vorsichtig sein, mit dem was man sich wuenscht.");
  AddDetail(({"erfuellung","opfer"}),
    "Wessen Traeume endeten hier wohl so herzlos.");
  AddDetail(({"traum","traeume"}),
    "Traeum nicht soviel, sonst bist Du der naechste, der hier sein "
    "Herz verliert.");
  AddDetail(({"flamme"}),
    "Die Flamme scheint alles, insbesondere das Licht verbrennen "
    "zu wollen. Du solltest auf gar keinen Fall in sie hinein "
    "fassen.");
  AddDetail(({"fall"}),
    "Fall? Ob man hier irgendwo abstuerzen kann?");
  AddDetail(({"licht"}),
    "Hell ist es hier nicht. Es herrscht gerade soviel Licht, dass Du "
    "die Umgebung erkennen kannst.");
  AddDetail(({"lloth"}),
    "Lloth wird von den Dunkelelfen angebetet.");
  AddDetail(({"leib","leben"}),
    "Du hoffst Dein Leib und Leben schuetzen zu koennen."); 
  AddDetail(({"wand","waende","decke"}),
    "Die Waende und die Decke bestehen aus ganz normalen Felsgestein, "
    "ohne irgendwelche Besonderheiten. Nur im Sueden ist eine Wand "
    "voller Spinnenfaeden.");
  AddDetail(({"besonderheit","besonderheiten"}),
    "Hier sind keine, aber vielleicht weiter im Sueden?");
  AddDetail(({"sueden"}),
    "Glaubst Du wirkliche, dass es hier nach Sueden weiter geht? "
    "Durch die Spinnenfaedenwand? Wohl kaum! Da brauchst Du Dich "
    "gar nicht erst bemuehen.");
  AddDetail(({"spinnenfaeden","faeden","faden","spinnenfaden",
              "spinnfaden","spinnfaeden","spinnenfaedenwand"}),
    "Die gesammte suedliche Wand ist voller undurchdringlicher dicker "
    "Spinnfaeden.");
  AddDetail(({"boden","hoehlenboden"}),
    "Der Boden besteht hier aus festgeklopfter Erde, auf dem "
    "in der Mitte ein Altar steht.");
  AddDetail(({"erde"}),
    "Dies ist ganz normale festgeklopfte Erde.");
  AddDetail(({"felsgestein","gestein","fels","stein","art"}),
    "Die Waende und die Decke scheinen aus stabiles Felsgestein "
    "zu bestehen.");
  AddDetail(({"gefuehl"}),
    "Dir laeuft es kalt den Ruecken herunter.");
  AddDetail(({"ruecken"}),
    "Ja, Deinem Ruecken laeuft es kalt herunter.");
  AddDetail(({"blut"}),
    "Davon gibt es hier unmengen.");
  AddDetail(({"gestank","verwesung","tod"}),
    "Rieche besser.");
  AddDetail(({"mitte"}),
    "Der Altar steht genau in der Mitte.");
  AddDetail(({"schatten","schein"}),
    "Die Schatten, welche die Waende werfen, geben der Szene einen "
    "beklemmenden, unheimlichen Schein.");
  AddDetail(({"szene"}),
    "brrr...");
    
  AddSmell(({DEFAULT_SMELL,"gestank","luft","verwesung","tod"}),
    "Ein fuerchterlicher Gestank nach Verwesung liegt in der Luft. "
    "Anscheinend moegen die Dunkelelfenpriesterinnen dies.");
 
  AddExit("norden",#'exit_norden);

  AddItem(NPC "priesterin",REFRESH_DESTRUCT);
  
  set_next_reset(MASTERDELAY);
}

void reset()
{
  ::reset();
  set_next_reset(MASTERDELAY);
}

int exit_norden()
{
  int pos,art;
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(PL);
  if (art==2 && pos<3)
  {
    write(break_string(
      "Du solltest der Priesterin erst Deine Hilfe anbieten, bevor Du von "
      "hier verschwindest."));
    return 1;
  }
  PL->move(ROOM "tunnel_02",M_GO);
  return 1;
}
