#pragma strict_types
#include "../def.h"
inherit STD "runenwand";

void create();
int exit_norden();

void create() 
{
  ::create();
  create_aussen_mitte();

  SetProp(P_INT_SHORT, "In luftiger Hoehe");
  SetProp(P_INT_LONG,
    "Du stehst auf einem schmalen Balkon, welcher hier aus der Turmwand "
    "heraus ragt. Ein kraeftiger Wind zerrt an Dir und versucht Dich in "
    "die Tiefe zu zerren. Weit unter Dir kannst Du den Hoehlengrund noch "
    "erahnen.");
  SetProp(P_ARCHON_RUNE_IN_QUEST,5);

  AddExit("norden",#'exit_norden);
}

int exit_norden()
{
  write(break_string(
    "Du betrittst das Loch und folgst einen Gang nach unten, bis "
    "dieser vor der Rueckwand eines Regales endet. An diesem ist ein "
    "Knopf angebracht, welchen Du sofort drueckst. Daraufhin bewegt sich "
    "das Regal zur Seite, so dass Du die Bibliothek betreten kannst. "
    "Kaum dort angekommen schiebt sich das Regal wieder an seine alte "
    "Position."));
  PL->move(ROOM "biblo",M_GO,"","verschwindet",
    "erscheint ploetzlich als sich ein Regal bewegt");
  return 1;
}

