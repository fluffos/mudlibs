#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();

void create() 
{
  ::create();
  create_unten();

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem breitem Gang, welcher von "
    "Sueden nach Norden fuehrt. Du schaust Dich ein wenig um "
    "und siehst unebene Granitwaende. Weiterhin siehst Du einen "
    "eingeebneten Boden, auf welchem Du stehst. Im Norden "
    "erkennst Du eine Tuer mit einigen Gitterstaeben.");

  AddDetail(({"tuer","gitterstab","stab","staebe","gitterstaebe"}),
    "Geh naeher heran, dann kannst Du dies auch besser sehen.");
  AddDetail(({"norden","sueden"}),
    "In diese Richtung kannst Du gehen.");

  AddExit("norden",ROOM "gang1_6");
  AddExit("sueden",ROOM "gang1_4");
}

