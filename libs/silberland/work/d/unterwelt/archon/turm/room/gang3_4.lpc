#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();
void reset();
int cmd_nimm(string str);

int hammer;

void create() 
{
  ::create();
  create_spitze();

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Du bist auf einem Rundgang in der Spitze des Turmes. "
    "In der Westwand ist eine Nische eingelassen, welche aber "
    "leider leer ist. Auf dem Boden liegen Teile eines "
    "Skelettes, welche buchstaeblich in diesen hinein gebrannt sind.");

  AddDetail(({"rundgang","raum"}),QueryProp(P_INT_LONG));
  AddDetail(({"nische"}),
    "In der Westwand ist eine Nische eingearbeitet worden, "
    "doch ist diese vollstaendig leer. Du kannst nur Brandspuren "
    "an und in ihr erkennen.");
  AddDetail(({"westwand"}),
    "Leider ist die Nische in der Westwand leer.");
  AddDetail(({"skelett","skelette"}),
    "Auf dem Boden liegen sehr alte Skelettteile. Zwischen "
    "ihnen glaubst Du ein metallisches Schimmern zu erkennen.");
  AddDetail(({"ueberreste","skelettteile","teile","skelettteil","teil",
              "skeletteil","skeletteile","einzelteile"}),
    "Auf dem Boden liegen die einzelnen Teile mehrere Skelette "
    "verteilt. Du siehst zwei Schaedel, eine Hand, mehrere "
    "Wirbelsaeulen und noch allerhand andere kleine, oder auch "
    "groessere Knochen.");
  AddDetail(({"schaedel"}),
    "Neugierig hebst Du einen der Schaedel hoch und erschreckst "
    "Dich fuerchterlich, als Dich daraus zwei listige Augen anblicken. "
    "Mit einem Schrei laesst Du den Schaedel fallen und siehst noch, "
    "wie eine Ratte aus dem Schaedel springt und wegrennt.");
  AddDetail(({"ratte"}),
    "Es ist keine Ratte zu sehen.");
  AddDetail(({"hand","skeletthand"}),
    "Die Skeletthand scheint noch etwas zu umfassen.");
  AddDetail(({"auge","augen"}),
    "Wie willst Du Deine Augen untersuchen? Hast Du einen Spiegel bei Dir?");
  AddDetail(({"spiegel"}),
    "Schau doch mal hinein.");
  AddDetail(({"etwas"}),
    "Nimm doch dieses ominoese Etwas, dann wirst Du ja sehen, was es ist.");
  AddDetail(({"schrei"}),
    "Lausche lieber.");
  AddDetail(({"schimmer","schimmern"}),
    "Das Schimmern ist direkt neben der Skeletthand.");
  AddDetail(({"knochen"}),
    "Die Knochen sind die einzigen Ueberreste der Lebewesen, die hier, vor "
    "langer Zeit, in einer gewaltigen Explosion, ihr Leben verloren haben "
    "muessen.");
  AddDetail(({"zeit"}),
    "Es ist wohl schon lange her.");
  AddDetail(({"lebewesen","wesen"}),
    "Du meinst wohl Dich?");
  AddDetail(({"wirbelsaeule","wirbelsaeulen"}),
    "Die Wirbelsaeulen zerfallen langsam in ihre Einzelteile. Schon jetzt "
    "liegen einzelne Wirbel weit zerstreut.");
  AddDetail(({"wirbel"}),
    "Auf dem Boden liegen einige Wirbel einzeln herum.");
  AddDetail(({"nordosten","osten","suedosten"}),
    "In diese Richtung kannst Du gehen.");
    
  AddSound(({"schrei"}),
    "Du schreist noch einmal - hm hoert sich zaghaft an. Das naechste mal "
    "bitte mit mehr Kraft dahinter, Du sollst ja nicht fluestern, sondern "
    "schreien.");

  AddCmd(({"nimm","nehme","nehmen"}),"cmd_nimm");

  AddExit("osten",ROOM "gang3_1");
  AddExit("nordosten",ROOM "gang3_5");
  AddExit("suedosten",ROOM "gang3_3");
  
  reset();
}

void reset()
{
  ::reset();
  hammer=1;
}

int cmd_nimm(string str)
{
  object ob;
  if (!S_STANDARD->check_cmd(str,
       "etwas",
       "Was willst Du nehmen?"))
    return 0;

  tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
       " hebt etwas auf."),({PL}));
  if (!hammer)
  {
    write(break_string("Du nimmst das Etwas vorsichtig aus der Skeletthand. "
      "Es scheint sich um die Huelle fuer einen Hammer zu handeln. Doch "
      "der Hammer ist nicht mehr da. Schade - da war wohl jemand schneller "
      "als Du. Enttaeuscht laesst Du die Huelle wieder fallen, welche sofort "
      "wieder von der Skeletthand geschnappt wird."));
    return -1;
  }
  hammer=0;
  write(break_string("Du nimmst das Etwas vorsichtig aus der Skeletthand. "
      "Es scheint sich um die Huelle fuer einen Hammer zu handeln, in der "
      "noch der Hammer steckt. Du nimmst den Hammer heraus und laesst die "
      "Huelle wieder fallen. Sofort schnappt sich die Skeletthand diese "
      "wieder."));
  ob=clone_object(P_DIR_WEAPON "club/hammer");
  if (1!=(int)ob->move(PL,M_GET))
  {
    write("Da Du den Hammer nicht halten kannst, laesst Du ihn wieder fallen.\n");
    ob->move(ME,M_PUT);
  }
  return 1;
}
