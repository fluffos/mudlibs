#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();
string detail_seele();
int cmd_reinigen(string str);
int cmd_opfern(string str);
int cmd_bete(string str);
int cmd_ruecke(string str);
int FindLiquid(mixed in); //Abfrage von Fluessigkeiten im Raum
//zZ nur fuer Giesskanne, wird sonst nicht von der lib unterstuetzt

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Aufenthalt der Priester");
  SetProp(P_INT_LONG,
    "Du stehst vor einem grossen Altar, auf welchem mehrere "
    "brennende Kerzen stehen und einige Raeucherstaebchen aromatischen "
    "Rauch verstroemt. Ueber dem Altar haengt ein Kruzifix, welches "
    "wohl ein Symbol der Verehrung darstellt. An den Waenden haengen "
    "einige Bilder, unter denen jeweils eine, mit Stroh " 
    "ausgefuellte, Lagerstaette errichtet wurde.");

  AddDetail(({"raum","altarraum"}),
    QueryProp(P_INT_LONG));
  AddDetail(({"wolke","nebel","rauch"}),
    "Der Rauch der Raeucherstaebchen bildet fast schon Nebel, oder eine "
    "im Raum haengende Wolke.");
  AddDetail(({"kerze","kerzen"}),
    "Die Kerzen brennen mit hell leuchtenden Flammen, ohne dabei "
    "jemals kuerzer zu werden, oder Wachs zu vertropfen.");
  AddDetail(({"wachs"}),
    "Aus was koennte die Kerzen sonst bestehen?");
  AddDetail(({"flamme","flammen","licht"}),
    "Die hellen Flammen der Kerzen erleuchten den ganzen Raum mit "
    "einem flackernden Licht.");
  AddDetail(({"betender","verehrung"}),
    "Du koenntest vor dem Altar beten.");
  AddDetail(({"altar"}),
    "Vor der Ostwand steht ein grosser, hoelzerner, mit Symbolen verzierter "
    "Altar. Auf ihm wurde ein tiefrotes Band ausgebreitet und Du erkennst "
    "eine Opferschale und eine Schuessel voll Wasser. Daneben brennen "
    "Kerzen und ein Raeucherstaebchen. Ueber dem Altar haengt, etwas schief, "
    "ein Kruzifix.");
  AddDetail(({"schuessel","wasser"}),
    "In einer Schuessel auf dem Altar befindet sich Wasser. Du mutmasst, "
    "dass man darin seine Finger reinigen kann, bevor man betet.");
  AddDetail(({"finger","fingerkuppe","fingerkuppen","kuppe","kuppen"}),
    "Die sind bestimmt wieder dreckig.");
  AddDetail(({"stab","staebchen","raeucherstab","raeucherstaebchen",
              "rauchstab","rauchstaebchen"}),
    "Auf dem Altar brennt ein duennes Raeucherstaebchen und erfuellt "
    "den Raum mit einem starken aromatischen Rauch. Dieses dient wohl "
    "dazu, die Priester mental auf ihre Gebete einzustimmen.");
  AddDetail(({"priester"}),
    "Huch - keiner da?");
  AddDetail(({"gebet","gebete"}),
    "Ein Gebet kann Dir und Deiner Seele nicht schaden.");
  AddDetail(({"seele"}),#'detail_seele);
  AddDetail(({"ding","dinge"}),
    "Es gibt viele Dinge, drueck Dich genauer aus.");
  AddDetail(({"boden","fussboden"}),
    "Der Boden besteht aus vielen kleinen, farbigen Steinen, welche so "
    "geordnet sind, dass sie in der Mitte einen Stern bilden.");
  AddDetail(({"stroh"}),
    "Die Lager an der Nord- und Suedwand wurden aus Stroh errichtet.");
  AddDetail(({"lager","lagerstaette","lagerstatt","staette","strohlager",
              "nachtruhe"}),
    "Die Priester haben fuer ihre Nachtruhe nur einfach Strohlager "
    "errichtet.");
  AddDetail(({"wand","waende","nordwand","suedwand","ostwand","westwand"}),
    "Die Waende wurden weiss angemalt. Im Osten haengt ein Kruzifix an "
    "selbiger und im Sueden und Norden einige Bilder.");
  AddDetail(({"norden","osten","sueden","westen"}),
    "Dies ist eine Himmelsrichtung.");
  AddDetail(({"himmel"}),
    "Himmel, hier in einem geschlossenen Raum?");
  AddDetail(({"himmelsrichtung","himmelsrichtungen","richtung","richtungen"}),
    "Es gibt viele Richtungen.");
  AddDetail(({"stern","mitte"}),
    "Genau in der Mitte des Fussbodens kannst Du einen Stern erkennen.");
  AddDetail(({"stein","steine"}),
    "Die farbigen Steine sind so angeordnet, dass sie einen Stern bilden.");
  AddDetail(({"decke","ungewoehnliches"}),
    "Du kannst nichts Ungewoehnliches an der Decke erkennen.");
  AddDetail(({"band"}),
    "Auf dem Altar liegt ein tiefrotes Band. Welche zeremonielle Bedeutung "
    "diesem zuzuordnen ist, erschliesst sich Dir leider nicht.");
  AddDetail(({"lehre","bedeutung"}),
    "Du bist leider kein Priester, deshalb weisst Du es nicht.");
  AddDetail(({"bild","bilder"}),
    "An den sich gegenueberliegenden Nord- und Suedwand haengen Bilder, "
    "auf denen die Portraits von Priestern abgebildet sind. Anscheinend haben "
    "sie besonderes fuer die Lehre und das Leben der Priester vollbracht.");
  AddDetail(({"leben"}),
    "Du willst nicht wie ein Priester leben muessen.");
  AddDetail(({"portrait","portraits","gesicht","gesichter"}),
    "Du kennst keines dieser Gesichter auf den Bildern.");
  AddDetail(({"symbol","symbole"}),
    "Das Kruzifix ist ein Symbol der Verehrung.");
  AddDetail(({"opferschale","schale"}),
    "Auf dem Altar liegt eine Opferschale. Aber da Du nicht beten und schon "
    "gleich gar nichts opfern willst, interessiert sie Dich ueberhaupt "
    "nicht.");
  AddDetail(({"kruzifix"}),
    "Ueber dem Altar haengt ein Kruzifix schief an der Wand. Du schaust "
    "es Dir genauer an, doch kannst Du noch immer nicht sagen, was es "
    "ueberhaupt darstellen soll. Wenn Du ehrlich bist, ist Dir das auch "
    "voellig egal. Jedenfalls koennte mal jemand das Kruzifix wieder gerade "
    "ruecken.");
  AddDetail(({"westen"}),
    "In diese Richtung kannst Du gehen.");

  AddSound(({DEFAULT_SOUND}),
    "Es ist hier ruhig.");
  AddSmell(({DEFAULT_SMELL,"geruch","aroma","rauch","wolke"}),
    "Ein stark aromatischer Geruch liegt wie eine dicke Wolke ueber dem "
    "Altarraum.");

  AddCmd(({"reinige","reinig","reinigen","saeuber","saeubere","saeubern"}),
         "cmd_reinigen");
  AddCmd(({"opfer","opfere","opfern"}),"cmd_opfern");
  AddCmd(({"bete","beten"}),"cmd_bete");
  AddCmd(({"rueck","ruecke","ruecken"}),"cmd_ruecke");

  AddExit("westen",ROOM "gang2_3");

  AddItem(NPC "areu",REFRESH_DESTRUCT);
}

string detail_seele()
{
  int a;
  string ret;
  a=(int)PL->QueryProp(P_ALIGN);
  if (a<0)
    ret="Aehm, meinst Du das schwarze Ding, was in Dir schlummert?";
  else if (a<500)
    ret="Ein paar gute Taten hast Du wohl schon verbracht.";
  else
    ret="Sehr gut, mach weiter so.";
  return break_string(ret);
}

int cmd_reinigen(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "finger|hand|haende",
       "Was willst Du reinigen?"))
    return 0;

  write(break_string("Du tauchst Deine Finger in das flache Schuesselchen "
    "und benetzt so Deine Fingerkuppen. Zwar sind diese nun nass, doch zum "
    "saeubern reicht das Wasser bei Weitem nicht."));
  return 1;
}

int cmd_opfern(string str)
{
  write(break_string("Gerade willst Du Dich ueber die Opferschale beugen "
    "und etwas von Wert opfern, als Du das bestimmte Gefuehl empfindest, "
    "dass kein Opfer von Dir angenommen werden wird. Also "
    "laesst Du es einfach bleiben."));
  return 1;
}

int cmd_bete(string str)
{
  write("Du faltest Deine Haende und fluesterst ein kurzes Gebet.\n");
  tell_room(ME,break_string(
    PL->Name(WER,NAME_AUTO)+" fluestert etwas."),({PL}));
  return 1;
}

int cmd_ruecke(string str)
{
  int pos;
  if (!S_STANDARD->check_cmd(str,
       "kruzifix&gerade",
       "Was willst Du (ver)ruecken?|Wolltest Du das Kruzifix nicht GERADE "
       "ruecken?"))
    return 0;

  tell_room(ME,break_string(
    PL->Name(WER,NAME_AUTO)+" macht irgendetwas und ploetzlich verschwimmt "
    "der Altar und eine Treppe erscheint. Du staunst die Treppe mit offenem "
    "Mund an, als sie auch schon wieder verschwunden ist."),({PL}));
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  if (pos==6)
  { //in der quest
    write(break_string("Du streckst Deine Hand aus und rueckst das Kruzifix "
      "gerade. Im selben Moment verschwimmt der Altar und eine Treppe, welche "
      "nach oben fuehrt, erscheint an dessen Stelle. Du schaust vorsichtig die "
      "Treppe hinauf und setzt dann kurzentschlossen Deinen Fuss auf die "
      "unterste Stufe und folgst dem Weg hinauf. Nach kurzer Zeit hast Du "
      "auch schon Dein Ziel erreicht und stehst auf einem Balkon ausserhalb "
      "des Turmes."));
    PL->move(ROOM "aussen_6",M_GO,"","verschwindet","erscheint");
    return 1;
  }
  write(break_string("Du streckst Deine Hand aus und rueckst das Kruzifix "
    "gerade. Im selben Moment verschwimmt der Altar und eine Treppe, welche "
    "nach oben fuehrt, erscheint an dessen Stelle. Du schaust vorsichtig die "
    "Treppe hinauf und willst gerade einen Fuss auf die unterste Stufe "
    "setzen, als diese anfaengt zu schimmern. Kurz danach erscheint wieder "
    "der Altar und die Treppe ist verschwunden. Komisch findest Du die "
    "ganze Sache schon, doch da Du kein Interesse daran hast, die Treppe "
    "hinauf zu steigen, verzichtest Du vorerst auf weitere Untersuchungen."));
  return 1;
}

//Abfrage von Fluessigkeiten im Raum - wird zZ nur von der Giesskanne unterstuetzt
//Lib unterstuetzt GiveLiquid,FindLiquid,AddLiquid etc nicht
int FindLiquid(mixed in)
{
  if (stringp(in) && lower_case(in)=="wasser")
  {
    write("Das Wasser aus der Schuessel kann man nur zum Finger reinigen "
          "nutzen.\n");
  }
  else if (pointerp(in) && (member_array("wasser",in)!=-1 ||
           member_array("Wasser",in)!=-1))
  {
    write("Das Wasser aus der Schuessel kann man nur zum Finger reinigen "
          "nutzen.\n");
  }
  return 0;
}
