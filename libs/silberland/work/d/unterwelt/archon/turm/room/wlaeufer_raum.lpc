#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();
int cmd_folge(string str);
int cmd_ausruhen(string str);

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Aufenthalt der Waldlaeufer");
  SetProp(P_INT_LONG,
    "Wenn Du nicht wuesstest, dass Du in einem Turm bist, "
    "wuerdest Du schwoeren, dass Du im Wald auf einer "
    "Lichtung stehst. Der Boden ist vollkommen von Gras "
    "und Moos bedeckt und ein tiefer Frieden ueberkommt Dich, "
    "als Du die reine Waldluft einatmest. Um Dich herum zwitschern "
    "Voegel in den Baeumen und nur der Blick auf den Gang "
    "im Osten stoert etwas die Idylle. Trotzdem wird sich hier "
    "jeder Waldlaeufer besonders wohl fuehlen.");

  AddDetail(({"raum"}),QueryProp(P_INT_LONG));
  AddDetail(({"blick"}),
    "Du kannst von hier aus den Gang sehen.");
  AddDetail(({"gang"}),
    "Wenn Du den Gang genauer unter die Lupe nehmen willst, "
    "dann solltest Du in den Gang gehen.");
  AddDetail(({"lupe"}),
    "Nirgends stand etwas davon, dass es hier eine Lupe gibt, folglich "
    "kannst Du auch keine untersuchen.");
  AddDetail(({"ort","betrachten"}),
    "Schau Dich ruhig um.");
  AddDetail(({"gras","sorte"}),
    "Ja Gras, Gras und noch mehr Gras - aber Rauchen ist hier verboten.");
  AddDetail(({"rauch","rauchen"}),
    "Es ist nicht diese Sorte von Gras.");
  AddDetail(({"idylle"}),
    "Ist es hier nicht wunderschoen? So der richtige Platz, um zu "
    "entspannen.");
  AddDetail(({"moos"}),
    "Du staunst. Schoenes weiches Moos, genau richtig, um sich ein wenig "
    "auszuruhen.");
  AddDetail(({"baeume"}),
    "Ja ein Baum und hier ist noch einer und dort auch. Du staunst. "
    "Du haettest nie geglaubt so etwas in einem Turm anzutreffen.");
  AddDetail(({"stamm","staemme"}),
    "Die sind von Eichen, Birken und Tannen. ");
  AddDetail(({"baum","eiche","eichen","birke","birken","tanne","tannen",
              "naehe","wand","waende"}),
    "In der Naehe stehen Eichen, Birken und sogar einige Tannen. "
    "Sie alle bilden die lebenden Waende dieses Raumes.");
  AddDetail(({"gefuehl"}),
    "Das ist nur so ein Gefuehl. ");
  AddDetail(({"platz","lichtung"}),
    "Jetzt, wo Du das mal genauer untersuchst, stellst Du fest, "
    "dass SEHR viel Platz um Dich herum ist. Erstaunlich, denn immerhin "
    "bist Du in einem Turm und dies ist nur ein Raum in diesem.");
  AddDetail(({"wald"}),
    "Du bist in keinem Wald, sondern in einem Turm.");
  AddDetail(({"rand","rande"}),
    "Am Rande der Lichtung stehen Baeume, sie bilden die Waende dieses "
    "Raumes.");
  AddDetail(({"himmel"}),
    "Himmel? In einem Turm?");
  AddDetail(({"decke"}),
    "Du kannst die Decke nicht erkennen. Aber ueber Dir ist ein blaues "
    "Leuchten, welches fast wie ein sonniger Himmel anmutet.");
  AddDetail(({"sonne","leuchten","freien"}),
    "Das Leuchten ist jedenfalls nicht die Sonne, aber es erhellt den "
    "Raum, als wenn Du draussen im Freien waerst.");
  AddDetail(({"wand","waende"}),
    "Die Waende dieses sonderbaren Raumes werden von den Baeumen gebildet.");
  AddDetail(({"boden"}),
    "Beim genaueren Betrachten des Bodens, fallen Dir ploetzlich ein paar "
    "Abdruecke auf.");
  AddDetail(({"spur","spuren","abdrueck","abdruecke","abdruck"}),
    "Als Du die Abdruecke genauer untersuchst, siehst Du, dass es die "
    "Abdruecke eines Menschen sind, welche im Westen zwischen den Baeumen "
    "verschwinden. Vielleicht solltest Du ihnen folgen.");
  AddDetail(({"frieden","segen"}),
    "Manchmal ist etwas Frieden ein Segen.");
  AddDetail(({"mensch"}),
    "Schau Dich nur um.");
  AddDetail(({"ruhe","zwitschern"}),
    "Du solltest wohl besser lauschen.");
  AddDetail(({"vogel","voegel"}),
    "Hoeren tust Du sie, aber Du kannst keinen entdecken.");
  AddDetail(({"geruch","luft","waldluft"}),
    "Riech mal.");
  AddDetail(({"waldlaeufer"}),
    "Huch keiner da?");
  AddDetail(({"osten"}),
    "In diese Richtung kannst Du gehen.");

  AddSoundDetail(({"zwitschern","vogel","voegel"}),
    "Ja, Du hoerst Voegel zwitschern.");
  AddSoundDetail(({"ruhe",DEFAULT_SOUND}),
    "Es ist ruhig und friedlich, nur ein paar Voegel zwitschern.");
  AddSmellDetail(({"geruch","luft","waldluft",DEFAULT_SMELL}),
    "Du riechst Waldluft.");

  AddExit("osten",ROOM "gang2_7");

  AddCmd(({"folgen","folge"}),"cmd_folge");
  AddCmd(({"entspanne","entspannen","entspann"}),"cmd_ausruhen");
  AddCmd(({"ruhe","ruhe","ruhen"}),"cmd_ausruhen");

  AddItem(NPC "falkenhand",REFRESH_DESTRUCT);
}

int cmd_folge(string str)
{
  int pos;
  if (!S_STANDARD->check_cmd(str,
       "spur|spuren|abdruecken|abdruck|fussabdruck|fussabdruecken",
       "Was willst Du folgen?"))
    return 0;

  tell_room(ME,break_string(
    PL->Name(WER,NAME_AUTO)+" geht auf den Boden schauende zwischen "
    "den Baeumen umher."),({PL}));
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  if (pos==6)
  { //in der quest
    write(break_string(
      "Du folgst der Spur zwischen die Baeume und landest in einem kleinen "
      "Gang, welcher steil nach oben fuehrt. Kurzentschlossen laeufst Du "
      "weiter und bist ploetzlich auf einem kleinen Balkon ausserhalb "
      "des Turmes."));
    PL->move(ROOM "aussen_8",M_GO,"","verschwindet","erscheint");
    return 1;
  }
  write(break_string(
    "Du folgst der Spur zwischen die Baeume und landest in einem kleinen "
    "Gang, welcher steil nach oben fuehrt. Vermutlich kommt man hier auf "
    "einen Balkon oder aehnliches. Du ueberlegst kurz, ob Du ihm folgen "
    "solltest, doch da Dir keine Grund einfaellt, weshalb Du dorthin "
    "solltest, kehrst Du wieder um."));
  return 1;
}

int cmd_ausruhen(string str)
{
  return notify_fail("Du entspannst ein wenig.\n"),0;
}
