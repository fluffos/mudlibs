#pragma strict_types
#include "../def.h"
inherit STD "runenwand";

void create();
int exit_westen();

void create() 
{
  ::create();
  create_aussen_mitte();

  SetProp(P_INT_SHORT, "In luftiger Hoehe");
  SetProp(P_INT_LONG,
    "Du bist auf einem sehr schmalen Balkon, welcher auf der "
    "oestliche Seite des Turmes angebracht ist, gelandet. "
    "Viele Leute haben hier bestimmt keinen "
    "Platz und wenn Du Dich so umschaust, fragst Du Dich, weshalb "
    "hier ueberhaupt ein Balkon erschaffen wurde. An der Aussicht "
    "liegt es jedenfalls nicht.");
  SetProp(P_ARCHON_RUNE_IN_QUEST,6);
  
  AddDetail(({"leute"}),
    "Hoffentlich kommen hier nicht noch mehr her.");
  AddDetail(({"seite","osten","ende"}),
    "Du bist hier am oestlichen Ende des Turmes.");
  AddDetail(({"platz"}),
    "Viel Platz ist hier nicht.");
  AddDetail(({"aussicht"}),
    "Welche Aussicht?");
    
  AddExit("westen",#'exit_westen);
}

int exit_westen()
{
  write(break_string(
    "Du betrittst das dunkle Loch vorsichtig und waerst beinahe die "
    "dort beginnende Treppe hinabgestolpert. Beide Haende weit ausgestreckt "
    "tastest Du Dich langsam vorwaerts. Urploetzlich ist die Schwaerze "
    "um Dich herum verschwunden und hinter Dir erschein ein Altar."));
  PL->move(ROOM "priester_raum",M_GO,"","verschwindet",
    "erscheint ploetzlich vor dem Altar");
  return 1;
}

