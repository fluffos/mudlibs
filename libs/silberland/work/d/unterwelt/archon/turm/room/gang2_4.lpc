#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();
void reset();

int giessen;

void create() 
{
  ::create();
  create_mitte();

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Der Gang fuehrt von Norden kommend nach Westen und ist, soweit "
    "Du das beurteilen kannst, voellig leer und oede. Nur eine verwelkte "
    "Blume in einem grossen Topf zeugt davon, dass der voellig verstaubte "
    "Gang, frueher einmal eine angenehme, lebendige Atmosphaere "
    "ausstrahlte.");

  AddDetail(({"norden","westen"}),
    "In diese Richtung kannst Du gehen.");
  AddDetail(({"blume","blumen","etwas","rest","reste","ding","dinge"}),
    "So kann man die voellig verdorrten Stoppeln im Blumentopf schon lange "
    "nicht mehr nennen. Vor langer Zeit hat wohl Jemand vergessen, die "
    "Blume zu giessen. Jetzt lohnt es sich bestimmt nicht mehr das "
    "nachzuholen.");
  AddDetail(({"topf","blumentopf"}),
    "Ein grosser Blumentopf steht in der Ecke. Er ist voller schwarzer "
    "Erde, in welcher noch die verkuemmerten Stoppeln mehrere Blumen "
    "stecken.");
  AddDetail(({"stoppel","stoppeln"}),
    "Eine bessere Beschreibung fuer die Reste der Blumen faellt Dir "
    "nicht ein.");
  AddDetail(({"beschreibung"}),
    "Denke Dir doch einen eigene aus, wenn Dir die hier nicht passt.");
  AddDetail(({"ecke","knick"}),
    "Natuerlich gibt es hier eine Ecke, denn der Gang ist ja nicht rund.");
  AddDetail(({"erde"}),
    "In der schwarzen Erde wachsen Pflanzen bestimmt hervorragend.");
  AddDetail(({"pflanze","pflanzen"}),
    "Meinst Du die verdorrten Dinge im Blumentopf?");

  AddExit("norden",ROOM "gang2_3");
  AddExit("westen",ROOM "gang2_5");
  
  reset();
}

void reset()
{
  ::reset();
  giessen=1;
}

//Aufruf aus der Giesskanne!
mixed GetGiessen(string str)
{
  object ob,w;
  if (!S_STANDARD->check_cmd(str,
       "topf|blumentopf|erde|blume|blumen",
       "Was willst Du giessen?"))
    return 0;

  if (!giessen)
  {
    write(break_string("Du giesst die verwelkten Pflanzen und merkst "
      "dabei, dass die Erde schon nass war. Offenbar war jemand schneller "
      "als Du und nichts passiert."));
    return 1;
  }
  tell_room(ME,break_string(
    "Ploetzlich erbluehen die Blumen, bilden Samen, werfen "
    "diesen ab und verwelken gleich wieder. Kaum beruehrt der "
    "Samen die Erde, faengt dieser an zu spriessen und es wachsen "
    "zwei gerade Triebe, welche in dem einen Augenblick noch "
    "gruen sind und dann, dass letzte Wasser aufsaugend, "
    "braun werden, abknicken und zu Boden fallen."),({PL}));
  write(break_string("Du giesst die Blumen und sofort ziehen sie die Naesse "
    "in sich auf. In kurzer Zeit erbluehen sie, bilden Samen, werfen "
    "diesen ab und verwelken wieder. Kaum beruehrt der Samen die Erde, "
    "faengt dieser an zu spriessen und es wachsen zwei gerade "
    "Triebe etwa einen halben Meter hoch. In einem Augenblick sind sie "
    "noch gruen und dann, dass letzte bisschen Wasser aufsaugend, werden "
    "sie braun, knicken ab und fallen zu Boden."));
  clone_object(OBJ "holzstab")->move(ME,M_PUT);
  clone_object(OBJ "holzstab")->move(ME,M_PUT);
  return 1;
}

