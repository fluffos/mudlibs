#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();

void create() 
{
  ::create();
  create_spitze();

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Du bist auf einem Rundgang in der Spitze des Turmes. "
    "In der Nordwand sind noch die Reste einer zerstoerten "
    "Nische zu erkennen. Sie scheint regelrecht weggeschmolzen "
    "zu sein und laesst die Wand bizarr aussehen.");

  AddDetail(({"rundgang","raum"}),QueryProp(P_INT_LONG));
  AddDetail(({"nische"}),
    "Die sichtbaren Reste einer Nische kannst Du noch in der Nordwand "
    "erkennen, doch ist diese von etwas sehr heissem regelrecht "
    "weggeschmolzen worden. Zum Glueck warst Du nicht hier, als "
    "dies geschehen ist.");
  AddDetail(({"nordwand"}),
    "Teile der Nordwand sind regelrecht weggeschmolzen und bilden "
    "nun komische Formen.");
  AddDetail(({"wand","waende","teil","teile"}),
    "Ueberall sind Brand- und Russspuren. Und nicht nur dass, die Hitze der "
    "Feuerbaelle muss hier so gross gewesen sein, dass Teile der Nordwand "
    "weggeschmolzen sind. Selbst die Nische ist nur noch mit einiger "
    "Fantasie als solche zu erkennen.");
  AddDetail(({"fantasy","fantasie"}),
    "Hast Du welche?");
  AddDetail(({"form","formen"}),
    "Schon erstaunlich, wie sich Gestein unter Hitze verformen kann.");
  AddDetail(({"gestein","stein"}),
    "Was denkst Du, woraus die Waende wohl sind?");
  AddDetail(({"suedosten","sueden","suedwesten"}),
    "In diese Richtung kannst Du gehen.");

  AddExit("sueden",ROOM "gang3_1");
  AddExit("suedwesten",ROOM "gang3_4");
  AddExit("suedosten",ROOM "gang3_2");
}

