#include "../def.h"
inherit STD "turm";

void create();
void reset();
int cmd_nimm(string str);
int cmd_puste(string str);
int cmd_tritt(string str);

int stein;

void create() 
{
  ::create();
  SetProp(P_INDOORS, 1); 
  SetProp(P_LIGHT, 1); 
  SetProp(P_INT_SHORT,"Eine Bibliothek");
  SetProp(P_INT_LONG,
    "Hier sieht es wuest aus. Buecher, Schriftrollen und Manuskripte sind "
    "wild durcheinander geworfen und liegen mehr auf dem Boden verteilt, "
    "als das noch welche in den Regalen stehen. Die verwaisten Plaetze der "
    "Buecher im Regal sind von einer dicken Staubschicht bedeckt und der "
    "Tisch auf der anderen Seite des Raumes, ist fast nicht mehr zu "
    "erkennen.");

  AddDetail(({"raum","zimmer","umgebung"}),QueryProp(P_INT_LONG));
  AddDetail(({"wand","waende"}),
    "Da stehen Regale davor.");
  AddDetail(({"boden"}),
    "Den kannst Du vor lauter Buecher, Schriftrollen und Manuskripte nicht sehen. "
    "Du fuehlst Dich unwohl hier, da Du mit jedem Schritt auf irgendwelchen Schriften "
    "trittst. Wer weiss, ob nicht einige einen Schutzzauber haben und Du in der Ecke "
    "liegst, wenn Du auf sie trittst.");
  AddDetail(({"regal","regale","westregal","ostregal","nordregal","platz","plaetze"}),
    "Die Regale sind alt. Nicht mehr viele Buecher stehen in den Regalen und "
    "eine dicke Staubschicht bedeckt die fast leeren Regalbretter. "
    "Wo die restlichen Buecher sind, siehst Du ueberdeutlich, als Du den Boden betrachtest.");
  AddDetail(({"staub","staubschicht","schicht"}),
    "Sie ist sehr dick. Es muss Jahrhunderte her sein, das hier jemand aufgeraeumt hat. "
    "Nur auf einem Regalbrett im suedlichen Regal ist ein Streifen staubfrei, als ob "
    "dort jemand mit seinem Aermel langgewischt haette. Du betrachstest die Stelle genauer "
    "und erkennst einen dunklen Schatten im Regal.");
  AddDetail(({"streifen","aermel","schatten","stelle"}),
    "Du ueberlegst, weshalb der auf dem einen Regalbrett eine Streifen staubfrei ist und "
    "gehst naeher heran. Der Schatten stellst sich dabei als ein Hebel heraus. "
    "Vielleicht solltest Du ihn einmal ziehen?");
  AddDetail(({"hebel"}),
    "Du koenntest an dem Hebel ziehen.");
  AddDetail(({"jahr","jahre","jahrhundert","zeit"}),
    "Es ist lange her.");
  AddDetail(({"decke"}),
    "An der Decke kannst Du nichts ungewoehnliches entdecken.");
  AddDetail(({"schriften","schriftrolle","schriftrollen","rolle","rollen",
              "manuskript","manuskripte"}),
    "Unmengen davon tuermen sich auf dem Boden und dem Tisch auf.");
  AddDetail(({"unmenge","unmengen"}),
    "Meinst Du die Buecher?");
  AddDetail(({"buecher"}),
    "Unmengen davon tuermen sich auf dem Boden und dem Tisch auf. Einige "
    "wenige stehen sogar noch in den Regalen. Als Du diese betrachtest, "
    "faellt Dir ein staubfreies Buch auf.");
  AddDetail(({"buch"}),
    "Erstaunlich, ein Buch im westlichen Regal ist staubfrei, als ob erst "
    "kuerzlich einer darin gelesen haette. Vielleicht sollst Du es Dir "
    "nehmen und schauen worueber es handelt.");
  AddDetail(({"brett","bretter","regalbrett","regalbretter",
              "regalbrettern"}),
    "Eine dicke Staubschicht liegt hier, wo frueher einmal die Buecher "
    "standen, auf den Regalbrettern.");
  AddDetail(({"schritt"}),
    "Was willst Du da untersuchen, wenn Du gerade still stehst?");
  AddDetail(({"zauber","schutzzauber"}),
    "Hier sollte Dich das nicht ueberraschen. Du bist ja schliesslich im "
    "Turm der Magier.");
  AddDetail(({"ecke","ecken"}),
    "Ja die gibt es hier.");
  AddDetail(({"tisch","platte","tischplatte","seite"}),
    "Die Tischplatte kann man nicht einmal sehen, da sie voller Schriften "
    "und Staub ist.");
  AddDetail(({"norden"}),
    "In diese Richtung kannst Du gehen.");
  AddReadDetail(({"buch","buecher"}),
    "Vielleicht solltest Du Dir ein Buch nehmen.");
  
  AddCmd(({"nimm","nehme","nehmen"}),"cmd_nimm");
  AddCmd(({"puste","pusten"}),"cmd_puste");
  AddCmd(({"tritt","trete","treten"}),"cmd_tritt");
  AddCmd(({"zieh","ziehe","ziehen"}),"cmd_ziehe");

  AddExit("norden",ROOM "gang2_5");
  stein=1;
}

void reset()
{
  ::reset();
  stein=1;
}

int cmd_nimm(string str)
{
  int pos,rw,art;
  string text;
  if (!S_STANDARD->check_cmd(str,
       "buch|buecher",
       "Was willst Du nehmen?"))
    return 0;

  tell_room(ME,break_string(
    PL->Name(WER,NAME_AUTO)+" greift sich ein Buch und liest darin."),({PL}));
  write(break_string("Du greifst Dir das Buch und erkennst, dass es sich um eine "
        "Abhandlung von Runenmagie handelt, insbesondere auf dem Gebiet der "
        "Kombination einzelner Runen."));
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(PL);
  rw=(int)P_ARCHON_QUESTMASTER->get_runen_knowhow(PL);
  if (rw)
  {
    write("Kaum hast Du es, denkst Du Dir 'Einmal lesen reicht doch'\n");
    return 1;
  }
  if (pos==6)
  { 
    P_ARCHON_QUESTMASTER->set_runen_knowhow(PL);
    text="\n"+break_string(
     "Schnell schlaegst Du die erste Seite auf, um endlich mehr ueber das "
     "Gebiet der Runenwissenschaft zu erfahren und Deine Aufgabe erfuellen "
     "zu koennen. Deine Augen haengen an jeder Zeile und Du erfaehrst, dass "
     "man einzelne Runen miteinander kombinieren kann. Doch warnt der Autor, "
     "das dies nicht gerade ungefaehrlich ist, denn die dadurch entstandene "
     "kombinierte Rune, wirkt nicht immer wie erwartet. Einige haben sogar "
     "voellig andere Auswirkungen, die mit den urspruenglichen Runen nichts "
     "mehr gemein haben. Du liest weiter und findest dann, was Du erhofft "
     "hast. Eine Beispielkombination, genau so, wie Du sie hier benoetigst. "
     "Erweiterung einer Schutzrune:")+"\n";
    if (art==1)
    {
      text+=break_string(
        "Willst Du eine Schutzrune weiter verstaerken und sie sogar aktiv "
        "sich verteidigen lassen bietet sich eine Kombination mit den Runen\n\n"
        "Algiz   (Schutz)\n"
        "Eihwarz (Abwehr)\n"
        "Isa     (Frost, Eisrunen)\n\n"
        "an, denn so veraendert wird die Orginalrune nicht nur verstaerkt, "
        "sondern wird gegen sie gerichtete Magie abwehren und sogar mit "
        "einem Frostangriff zurueck schlagen.",78,"",BS_LEAVE_MY_LFS);
      PL->More(text);
      return 1;
    }
    text+=break_string(
      "Willst Du eine Schutzrune schwaechen oder sogar zerstoeren bietet sich "
      "eine Kombination mit den Runen\n\n"
      "Hagalaz (Aufloesung)\n"
      "Teiwaz  (Krieg)\n"
      "Sowilo  (Sonne - Feuer)\n\n"
      "an, denn so veraendert wird die Orginalrune sich aufloesen und "
      "langsam an kraft verlieren und nicht nur das, das geschuetzte Objekte "
      "wird langsam durch die Runen Teiwaz und Sowilo konterminiert und "
      "von innen heraus zerstoert.",78,"",BS_LEAVE_MY_LFS);
    text+=break_string(
      "Du bist ja so froh, dass Du nun alles notwendige weisst. Mit Hilfe "
      "des Runenstabes bist Du jetzt in der Lage, die Schutzrunen richtig "
      "zu manipulieren. Schnell schlaegst Du das Buch zu, um Dein neu "
      "gewonnenes Wissen sofort umzusetzen.");
    PL->More(text);
    return 1;
  }
  write(break_string(
    "Ist ja alles sehr interessant, aber gerade jetzt benoetigst Du dieses "
    "Wissen ueberhaupt nicht. So stellst Du das Buch wieder weg und "
    "denkst bei Dir, dass Du ja jederzeit wieder kommen kannst, wenn Du "
    "dieses Wissen einmal benoetigst."));
  return 1;
}

int cmd_puste(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "staub|staubschicht",
       "Was willst Du wegpusten?"))
    return 0;

  write(break_string(
    "Toll nun stehst Du in einer Staubwolke. Nur bei der Staubschicht "
    "im Regal kannst Du kein Unterschied erkennen."));
  return 1;
}

int cmd_tritt(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "buch|buecher|rolle|schriften|schriftrolle|rollen|schriftrollen|"
       "manuskript|manuskirpte",
       "Worauf willst Du treten?"))
    return 0;

  write(break_string("Du trittst wild auf die Schriften am Boden ein. Und was "
        "dachtest Du was das bringen soll? Immerhin liegen die schon seit "
        "Ewigkeiten hier unten herum."));
  return 1;
}

int cmd_ziehe(string str)
{
  int pos;
  if (!S_STANDARD->check_cmd(str,
       "hebel",
       "An was willst Du ziehen?"))
    return 0;

  tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
    " macht irgendetwas."),({PL}));
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  if (pos==6)
  { //in der quest
    write(break_string("Zoegerlich ziehst Du an den Hebel und ploetzlich "
      "schweankt das suedliche Regal nach hinten und gibt einen Gang frei. "
      "Gerade als das sich das Regal langsam wieder in seine alte Position "
      "bewegt, rennst Du vorwaerts und folgst dem Gang. Er fuehrt steil nach "
      "oben und endet auf einem Balkon."));
    PL->move(ROOM "aussen_5",M_GO,"","verschwindet","erscheint");
    return 1;
  }
  write(break_string("Zoegerlich ziehst Du an den Hebel und ploetzlich "
      "schweankt das suedliche Regal nach hinten und gibt einen Gang frei. "
      "Du schaust unentschlossen in den nicht gerade einladend wirkenden Gang "
      "und ueberlegst noch, ob Du diesem folgen sollst, als sich das Regal "
      "wieder in seine Ausgangsposition bewegt und den Gang verschliesst. "
      "Du zuckst mit den Schultern und denkst Dir 'Was solltest Du auch in "
      "dem Gang wollen, es gibt ja keinen Grund ihm zu folgen' "
      "und laesst es dabei bewenden."));
  return 1;
}
