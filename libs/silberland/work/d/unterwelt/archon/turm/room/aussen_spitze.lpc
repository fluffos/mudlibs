#pragma strict_types
#include "../def.h"
inherit STD "runenwand";

void create();
void test_weiter(object player);
int exit_unten();

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einer Spitze");
  SetProp(P_INT_LONG,
    "Waere hier nicht die Plattform auf welcher Du stehst, wuerdest Du "
    "meinen, Du befindest Dich im absoluten Nichts. So weit Du es erkennen "
    "kannst, ist um Dich nur Schwaerze. Du siehst weder die Waende der "
    "Hoehle, noch dessen Decke. Nur unter Dir ziehst sich die Aussenwand "
    "des Turmes in die Tiefe, auch wenn Du den Hoehlengrund nicht "
    "ausmachen kannst.");

  SetProp(P_ARCHON_RUNE_IN_QUEST,9);

  AddDetail(({"wand","waende","hoehlenwand","hoehlenwaende"}),
    "Du kannst keine sehen - schade eigentlich.");
  AddDetail(({"plattform"}),
    "Du stehst auf einer Plattform auf der Spitze des Turmes. Neben Dir "
    "ist ein grosses Loch im Boden und seitlich davon eine Rune befestigt.");
  AddDetail(({"rune"}),
    "Diese Rune ist besonders gross. Auch wenn Du von Runen nicht viel Ahnung "
    "hast, glaubst Du, dass dies eine Zentrumsrune sein muss.");
  AddDetail(({"ahnung"}),
    "Du solltest lieber ueber Wissen, als ueber Ahnungen verfuegen.");
  AddDetail(({"wissen"}),
    "Du seufzt.");
  AddDetail(({"zentrumsrune","fall"}),
    "Diese Rune kann ihre Macht auch auf andere Runen ausstrahlen und sie "
    "somit beeinflussen. Doch ist sie auch wirksamer gegen Manipulationen "
    "geschuetzt, als es bei anderen Runen der Fall ist. Erst wenn Du acht "
    "andere Runen manipuliert hast, wird es Dir auch bei dieser gelingen.");
  AddDetail(({"wand","waende","turmwand","turmwaende",
              "aussenwand","aussenwaende"}),
    "Die Aussenwaende des Turmes kannst Du hier nur von oben betrachten. "
    "Sie bestehen aus Dir unbekanntem Gestein und ist ansonsten voellig "
    "uninteressant, so dass Du Dich sofort wieder von der Betrachtung "
    "der Waende abwendest.");
  AddDetail(({"betrachtung"}),
    "Was willst Du ansehen?");
  AddDetail(({"gestein"}),
    "Ist doch egal woraus die Waende sind!");
  AddDetail(({"nichts"}),
    "Im dem Nichts scheinst Du wirklich unbedeutend.");
  AddDetail(({"loch"}),
    "Im Boden erkennst Du ein Loch, welches nach unten fuehrt. Nur gut, dass "
    "Du von unten eine Leiter dagegen gestellt hast, sonst muesstes Du noch "
    "hinab springen. Wer weiss was Du Dir dabei alles brechen koenntest.");
  AddDetail(({"leiter"}),
    "Die solltest Du von unten ansehen.");
  AddDetail(({"spitze"}),
    "Du hast sie erreicht.");
  AddDetail(({"schwaerze"}),
    "Zum Glueck ist nicht alles schwarz.");

  AddExit("unten",#'exit_unten);
}

void test_weiter(object pl)
{
  int art,pos;
  string kerker;
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(pl);
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(pl);
  if (art==2 && pos==7)
  { //Ab in den Kerker
    tell_object(pl,break_string(
      "Kaum hast Du wieder festen Boden unter Deinen Fuessen, "
      "materialisiert sich einer der unsichtbaren Diener neben Dir. "
      "Seine Augen scheinen Dich bis in das Innere zu durchleuchten "
      "und Deine wahren Absichten zu ergruenden. Ploetzlich verzieht "
      "sich sein Gesicht und er ruft mit einem Wink einen der "
      "stofflosen Arme einen Turmwaechter. Dieser ergreift Dich mit seinen "
      "nur zu realen Klauen und schleift Dich mit, um Dich in einen "
      "alten Kerker zu werfen."));
    tell_room(environment(pl),break_string(
      "Kaum hat "+pl->name(WER,1)+" festen Boden unter Deinen Fuessen, "
      "materialisiert sich einer der unsichtbaren Diener neben "+
      pl->QueryPronoun(WEM)+". Seine Augen scheinen "+pl->name(WEN,1)+
      " zu durchleuchten. Ploetzlich verzieht sich das Gesicht "
      "des Dieners und er ruft mit einem Wink seiner stofflosen "
      "Arme einen Turmwaechter. Dieser ergreift "+pl->name(WEN,1)+
      ", woraufhin alle drei verschwinden."),({pl}));
    kerker=ROOM "kerker:"+getuid(pl);
    pl->move(kerker,M_GO|M_SILENT);
  }
}

int exit_unten()
{
  write(break_string(
    "Da das Loch gar nicht so weit ueber dem Raum unter Dir ist, "
    "beschliesst Du auf andere Hilfsmittel zu verzichten und "
    "springst direkt nach unten."));
  PL->move(ROOM "gang3_1",M_GO,"","verschwindet","springt herein");
  test_weiter(PL);
  return 1;
}

