#pragma strict_types
#include "../def.h"
inherit STD "turm";


void create();
int cmd_betritt(string str);

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Ein grosser Saal");
  SetProp(P_INT_LONG,
    "Der grosse, aus Obsidian gehauene Saal ist so weitlaeufig, dass Du die "
    "fernen Waende nur als Schatten erahnen kannst. Doch Du erkennst im "
    "Sueden einen Gang, welchem Du weiter folgen kannst. Bis auf ein "
    "Pentagramm genau in der Mitte des Saales ist dieser leer. Ein schwaches "
    "Licht erhellt alles um Dich herum.");

  AddDetail(({"saal","raum","interessant","interessante"}),
    "Du stehst in einem weitlaeufigen Saal. Weit und breit siehst Du keine "
    "Einrichtung. Warum sollte jemand einen leeren Saal haben wollen? Das einzig "
    "Interessante im Saal ist ein Pentagramm auf dem Boden.");
  AddDetail(({"oeffnung","gang"}),
    "Da musst Du wohl nach Sueden gehen.");
  AddDetail(({"einrichtung"}),
    "Die fehlt hier wohl.");
  AddDetail(({"decke"}),
    "Die Decke ist so hoch, dass Du sie nicht mehr sehen kannst.");
  AddDetail(({"boden","platten","platte","obsidianplatte","obsidianplatten"}),
    "Der Boden ist mit riesigen Obsidianplatten ausgelegt.");
  AddDetail(({"obsidian","gestein","fluesse","fluss","schmelzfluss",
              "schmelzfluesse","schmelzfluessen","fluessen"}),
    "Der Obsidian ist ein schwarzes Gestein, welches aus schnell erstarrten "
    "Schmelzfluessen entstanden ist.");
  AddDetail(({"wand", "waende", "schatten"}),
    "Du kannst die Waende nur als schwachen Schatten weit, weit von der Mitte des "
    "Saales entfernt erahnen.");
  AddDetail(({"mitte"}),
    "In der Mitte des Saals siehst Du ein golden leuchtendes Pentagramm.");
  AddDetail(({"leuchten", "goldenes leuchten"}),
    "Vom Pentagramm geht ein goldenes Leuchten aus.");
  AddDetail(({"pentagramm","besorgniserregendes"}),
    "Ein goldenes Leuchten geht vom dem im Boden eingelassenen Pentagramm aus. "
    "Da Du nichts Besorgniserregendes sehen kannst, solltest Du einfach einmal "
    "ins Pentagramm hinein treten.");
  AddDetail(({"sueden", "nach sueden", "richtung sueden"}),
    "Du kannst in dieser Richtung den Saal verlassen.");
  AddDetail(({"richtung"}),
    "Im Sueden kannst Du den Saal verlassen.");

  AddExit("sueden",ROOM "gang1_1");
    
  AddCmd(({"trete","treten","tritt","betret","betrete","betritt"}),"cmd_betritt");
  
  AddItem(NPC "joxa",REFRESH_DESTRUCT);
}

int cmd_betritt(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "pentagramm",
       "Was willst Du betreten?"))
    return 0;

  write(break_string("Du trittst kurz entschlossen ins Pentagramm, welches "
        "sofort intensiv zu leuchten anfaengt. Ploetzlich wird Dir schwindlig, "
        "und Du findest Dich ausserhalb des Turmes wieder."));
  tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
         " betritt das Pentagramm und ist im naechsten "
         "Moment verschwunden."),({PL}));
  PL->move(ROOM "vorturm",M_GO|M_SILENT);
  tell_room(environment(PL),PL->Name(WER,NAME_AUTO)+" erscheint.\n",({PL}));
  return 1;
}

