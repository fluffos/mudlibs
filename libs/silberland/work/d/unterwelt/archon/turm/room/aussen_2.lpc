#pragma strict_types
#include "../def.h"
inherit STD "runenwand";

void create();
string _query_int_long();
int cmd_fasse(string str);

void create() 
{
  ::create();
  create_aussen_unten(2);

  SetProp(P_INT_SHORT, "In luftiger Hoehe");
  SetProp(P_ARCHON_RUNE_IN_QUEST,2);

  AddDetail(({"ostwand"}),GetDetail("wand"));
  AddDetail(({"ueberhang","ueberhanges"}),
    "Der Ueberhang ragt aus der Aussenwand des Turmes weit "
    "hinaus. Anscheinend ist direkt ueber Dir ein Zimmer im "
    "Inneren des Turmes untergebracht. Auf der Unterseite des "
    "Ueberhanges ist eine Rune eingelassen.");
  AddDetail(({"zimmer","innere","inneres","inneren"}),
    "Das siehst Du von hier aussen jedenfalls nicht.");
  AddDetail(({"unterseite"}),
    "Dort ist eine Rune.");

  AddCmd(({"fass","fasse","fassen","anfassen"}),"cmd_fasse");
}

string _query_int_long()
{
  aufraeumen();
  return break_string(
    "Du bist bis zur oestlichen Turmwand geklettert. Du haengst direkt "
    "unter einem weit hinausragenden Ueberhang, in welchem eine Rune "
    "eingelassen ist. Notfalls koenntest Du eine Hand von der Wand loesen "
    "und die Rune, indem Du Dich nach ihr ausstreckst anfassen.");
}

int cmd_fasse(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "rune",
       "Was willst Du anfassen?"))
    return 0;
  write("Du faesst Die Rune an, doch nichts passiert.\n");
  tell_room(ME,break_string(PL->Name(WER,1)+" faesst die Rune an."),({PL}));
  return 1;
}
