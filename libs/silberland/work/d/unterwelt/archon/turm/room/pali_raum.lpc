#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();
string detail_schrein();
string detail_einbuchtung();
int cmd_legen(string str);
int cmd_beten(string str);

void create()
{
  ::create();
  SetProp(P_INT_SHORT,"Aufenthalt der Paladine");
  SetProp(P_INT_LONG,
    "Du stehst in einem einfachen, weissen Raum. An der Nordwand "
    "haengt ein Banner und davor wurde ein Schrein errichtet. "
    "Vor der West- und Ostwand stehen einfache Pritschen mit "
    "daruebergelegten weissen Fellen und neben dem Eingang "
    "ist ein Gestell fuer Waffen und Ruestungen aufgestellt worden.");

  AddDetail(({"raum"}),
    QueryProp(P_INT_LONG));
  AddDetail(({"schrein"}),
    #'detail_schrein);
  AddDetail(({"betender"}),
    "Du koenntest vor dem Schrein beten.");
  AddDetail(({"einbuchtung","einbuchtungen"}),
    #'detail_einbuchtung);
  AddDetail(({"boden"}),
    "Der Boden ist weiss gefliest und gibt dem Raum eine kuehle, strenge "
    "Atmosphaere. Vor dem Schrein scheinen ein paar Einbuchtungen zu sein.");
  AddDetail(({"wand","waende","ostwand","suedwand","westwand","nordwand"}),
    "Die Waende sind vollstaendig weiss, ohne irgendeinen Makel.");
  AddDetail(({"weiss","makel"}),
    "Der Raum ist makellos weiss.");
  AddDetail(({"gestell","waffen","waffe","ruestung","ruestungen"}),
    "Im Gestell koennen die Bewohner dieses Raumes ihre Waffen und "
    "Ruestungen unterbringen, wenn sie sich zur Ruhe begeben.");
  AddDetail(({"paladin","paladine","bewohner"}),
    "So wie es hier aussieht, sind die Bewohner Paladine.");
  AddDetail(({"ruhe"}),
    "Es ist hier ruhig.");
  AddDetail(({"banner","paladinbanner"}),
    "Du siehst ein Paladinbanner, welches zu ehren Dusty's aufgehaengt "
    "wurde.");
  AddDetail(({"dusty","ayla","herrin","ayla's"}),
    "Du weisst nicht, wer Dusty oder Ayla ist? Dann frag mal einen "
    "Spieler, der in der Paladingilde ist.");
  AddDetail(({"spieler","mitspieler"}),
    "Du weisst schon einen Mitspieler.");
  AddDetail(({"statue","betrachtung","abbild"}),
    "Eine Statue steht auf dem Schrein. Als Du sie genauer betrachtest, "
    "erkennst Du, dass sie ein Abbild von Ayla ist. Ayla ist getreulich "
    "nachgebildet und die Augen der Statue scheinen Dich sogar bei "
    "Deiner Betrachtung zu beobachten und Du hast das unbestimmte Gefuehl, "
    "dass Ayla's Statue der Meinung ist, dass Du zu Dusty beten solltest, "
    "um Deine Seele zu retten.");
  AddDetail(({"meinung"}),
    "Vielleicht beeinflusst beten diese Meinung.");
  AddDetail(({"auge","augen"}),
    "Du fragst Dich, ob die Augen Dich anschauen.");
  AddDetail(({"seele"}),
    "Dunkel, nicht war?");
  AddDetail(({"gefuehl","gefuehle"}),
    "Gefuehle sind truegerisch.");
  AddDetail(({"pritsche","pritschen"}),
    "Bequem sehen die Pritschen nicht gerade aus, aber so ein echter Paladin "
    "wird darauf blendend schlafen koennen. Ein weisses Fell je Pritsche "
    "macht sie ein wenig einladender.");
  AddDetail(({"fell","felle"}),
    "Auf jeder Pritsche liegt ein weisses Fell.");
  AddDetail(({"decke"}),
    "Die Decke ist vollstaendig weiss.");
  AddDetail(({"eingang","sueden","gang"}),
    "Im Sueden kannst Du auf den Gang hinaus gehen.");
  AddDetail(({"gebet"}),
    "Willst Du beten?");
  AddDetail(({"sueden"}),
    "In diese Richtung kannst Du gehen.");

  AddSound(({DEFAULT_SOUND}),
    "Es ist hier ruhig.");
  AddSmell(({DEFAULT_SMELL}),
    "Du riechst nichts Ungewoehnliches.");

  AddCmd(({"liege","leg","lege","legen"}),"cmd_legen");
  AddCmd(({"bete","beten"}),"cmd_beten");

  AddExit("sueden",ROOM "gang2_1");

  AddItem(NPC "zinja",REFRESH_DESTRUCT);
}

string detail_schrein()
{
  object ob;
  ob=present("paladin");
  if (ob && !ob->InFight())
   return break_string(
    "Du siehst einen kunstvollen weissen Schrein unter einem Banner "
    "stehen. Auf dem Schrein steht eine Statue und davor "
    "verneigen sich einige Paladine in ein Gebet vertieft.");
  return break_string(
    "Du siehst einen kunstvollen weissen Schrein unter einem Banner "
    "stehen. Auf dem Schrein steht eine Statue und davor "
    "siehst Du am Boden ein paar Einbuchtungen, welche von den Knien "
    "Betender stammen muessen.");
}

string detail_einbuchtung()
{
  object ob;
  ob=present("paladin");
  if (ob && !ob->InFight())
   return break_string(
    "Du glaubst, genau dort, wo die Paladine beten, einige Einbuchtungen auf "
    "dem Boden zu sehen.");
  return break_string(
    "Vor dem Schrein siehst Du am Boden ein paar Einbuchtungen, welche "
    "von den Knien Betender stammen muessen.");
}

int cmd_legen(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "bett|pritsche",
       "Wohin oder worauf willst Du Dich legen?"))
    return 0;

  write(break_string("Die Pritschen sieht sehr unbequem aus, so dass Du "
        "lieber darauf verzichtest, Dich auf sie zu legen."));
  return 1;
}

int cmd_beten(string str)
{
  int pos;
  string text;
  if (!S_STANDARD->check_cmd(str,
       "zu&dusty",
       "Du willst wohl ZU jemanden beten?|Hier wird nur zu DUSTY gebetet."))
    return 0;

  tell_room(ME,break_string(
    PL->Name(WER,NAME_AUTO)+" macht irgendetwas und ploetzlich erscheint "
    "nebem dem Schrein ein Geheimgang. Du staunst ihn mit offenem "
    "Mund an, als er auch schon wieder verschwunden ist."),({PL}));
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  if ("paladine"==(string)PL->QueryProp(P_GUILD))
    text="Du kniest nieder und betest zu Dusty.";
  else
    text="Du kniest nieder und tust so, als ob Du zu Dusty betest.";
  if (pos==6)
  { //quest
   write(break_string(text+" Ploetzlich "
    "ist die Statue von einem hellen Leuchten umgehen und ein Geheimgang "
    "oeffnet sich neben dem Schrein nach Norden. "
    "Kurzentschlossen springst Du auf und hechtest Dich in den Geheimgang, "
    "bevor dieser wieder verschlossen ist. Du tastest Dich im Dunkeln "
    "weiter vorwaerts, bis Du ploetzlich ausserhalb des Turmes auf einem "
    "Balkon stehst."));
    PL->move(ROOM "aussen_7",M_GO,"","verschwindet","erscheint");
    return 1;
  }
  write(break_string(text+" Ploetzlich "
    "ist die Statue von einem hellen Leuchten umgehen und ein Geheimgang "
    "oeffnet sich neben dem Schrein nach Norden. "
    "Du ueberlegst schon, ob Du diesem folgen sollst, doch dabei vergisst Du "
    "zu beten und der Geheimgang schliesst sich wieder. Du denkst bei Dir "
    "'Na ja, eigentlich hast Du zur Zeit eh keinen Grund einen Dir "
    "unbekannten Geheimgang folgen zu wollen' und laesst es dabei bewenden."));
  return 1;
}
