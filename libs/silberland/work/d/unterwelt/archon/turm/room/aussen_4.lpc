#pragma strict_types
#include "../def.h"
inherit STD "runenwand";

void create();
string _query_int_long();
string detail_symbol();
int cmd_halten(string str);

void create() 
{
  ::create();
  create_aussen_unten(4);

  SetProp(P_INT_SHORT, "In luftiger Hoehe");
  SetProp(P_ARCHON_RUNE_IN_QUEST,4);

  AddDetail(({"westwand"}),GetDetail("wand"));
  AddDetail(({"spitze"}),
    "Eigentlich wundert Dich bei diesem Turm nichts mehr. "
    "Wer weiss weshalb hier eine Spitze aus dem Turm ragt, "
    "zum festhalten ist sie jedenfalls genau das Richtige.");
  AddDetail(({"richtige"}),
    "Gut geeignet ...");
  AddDetail(({"symbol","betrachtung"}),#'detail_symbol);
  
  AddCmd(({"halt","halte","halten"}),#'cmd_halten);
}

string _query_int_long()
{
  aufraeumen();
  return break_string(
    "Direkt vor Dir ragt eine komische Spitze aus der Turmwand "
    "heraus. Wozu sie auch immer da sein mag, Du nutzt sie, "
    "um Dich an ihr festzuhalten. Darueber ist ein komisches "
    "Symbol in der Aussenwand eingraviert.");
}

string detail_symbol()
{
  if (get_rune_found(PL)<1)
    set_rune_found(PL,1);
  return break_string(
    "Bei genauerer Betrachtung erkennst Du das es sich bei "
    "dem Symbol um eine Rune handelt.");
}

int cmd_halten(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "spitze",
       "Woran willst Du Dich festhalten?"))
    return 0;
  write("Du haelst Dich schon an der Spitze fest!\n");
  return 1;
}