#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();

void create() 
{
  ::create();
  create_unten();

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Du folgst einem schmalen Gang im Inneren des Turmes. Ausser Staub und "
    "Fussspuren auf dem Boden ist der Gang voellig leer. Da es hier nichts "
    "Interessantes gibt, solltest Du gleich weiter gehen.");

  AddDetail(({"innere","inneres"}),
    "Du bist im Turm.");
  AddDetail(({"norden","osten","sueden"}),
    "In diese Richtung kannst Du gehen.");

  AddExit("norden",ROOM "eingang");
  AddExit("osten",ROOM "brunnen");
  AddExit("sueden",ROOM "gang1_2");

  AddItem(NPC "diener",REFRESH_DESTRUCT);
  AddItem(NPC "diener",REFRESH_DESTRUCT);
}

