#include "../def.h"
inherit STD "turm";

void create();
void reset();
string detail_zehe();
int cmd_lege(string str);
int cmd_sitz(string str);
int cmd_nehmens(string str);

int anzahl;

void create()
{
  ::create();
  anzahl=1;
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_INT_SHORT,"Ein kleines Zimmer");
  SetProp(P_INT_LONG,
    "Du bist in einem schlicht eingerichteten und stark verstaubten "
    "Zimmer. Eine Couch steht rechts von Dir und darueber haengt etwas, "
    "was einmal ein kleines Bild gewesen sein muss. Daneben steht ein Tisch, "
    "auf dem eine Leuchtkugel liegt, aber beides ist unter einer dicken "
    "Staubschicht geradezu begraben.");

  AddDetail(({"staub"}),
    "Staub, nichts als Staub.");
  AddDetail(({"bild","etwas"}),
    "Leider kann man nichts mehr auf dem Bild erkennen.");
  AddDetail(({"magier"}),
    "Dieser Raum gehoerte wohl einmal einem der Erbauer dieses Turmes. Doch "
    "jetzt mag keiner mehr hier wohnen.");
  AddDetail(({"zimmer","raum"}),
    "Das Zimmer ist sehr klein. Bis auf eine Couch und ein Tisch passt hier "
    "nichts mehr rein.");
  AddDetail(({"tisch"}),
    "Du wischst etwas ueber den Staub und stellst fest, dass der Tisch "
    "aus dunklem Eichenholz gefertigt wurde.");
  AddDetail(({"holz","eichenholz"}),
    "Der Tisch und die Beine der Couch bestehen aus altem, dunklem "
    "Eichenholz.");
  AddDetail(({"bein","beine","beinen"}),
    "Sowohl der Tisch, als auch die Couch stehen auf ihren Beinen. Genau "
    "wie Du auf Deinen.");
  AddDetail(({"tischbein","tischbeine"}),
    "Die Tischbeine sind leicht geschwungen. Von dem Boden aus biegen sie "
    "sich erst zur Mitte der Tischplatte, um sich dann wieder nach aussen "
    "zu biegen. Sie enden in einer Art Klaue, die die Tischplatte haelt.");
  AddDetail(({"couchbein","couchbeine"}),
    "Auf irgendetwas muss ja die Couch stehen.");
  AddDetail(({"platte","tischplatte"}),
    "Die Tischplatte wird von den Tischbeinen, die wie Klauen geformt sind, "
    "gehalten. Die Platte ist vollstaendig verstaubt.");
  AddDetail(({"schein","kugel","leuchtkugel"}),
    "Die Kugel erhellt selbst die letzte Ecke des Raumes.");
  AddDetail(({"ecke"}),
    "Ecken gibt es hier genug. Doch dort gibt es nichts Interessantes.");
  AddDetail(({"art","klaue","klauen","drachenklaue","drachenklauen"}),
    "Die Tischbeine sind oben sehr kunstvoll geschnitzt. Sie sehen aus wie "
    "die Klauen eines Drachens, wie echte Drachenklauen. "
    "Vielleicht ist das doch kein Holz?");
  AddDetail(({"drache","drachen"}),
    "Muss wohl ein sehr kleiner Drachen gewesen sein - ist wohl doch Holz.");
  AddDetail(({"wand","waende"}),
    "Die Waende waren wohl einmal tapeziert. Doch viel ist von der Tapete "
    "nicht mehr uebrig.");
  AddDetail(({"tapete","tapeten"}),
    "Ob die Tapete einmal kaminrot gewesen ist?");
  AddDetail(({"decke"}),
    "Komisch, Du kannst keine Decke erkennen.");
  AddDetail(({"boden"}),
    "Der Boden ist mit einem weichem, aber voellig verstaubten, Teppich "
    "bedeckt.");
  AddDetail(({"teppich","schritt"}),
    "Der Teppich ist voller Staub, so dass jeder Schritt Dich niesen "
    "laesst.");
  AddDetail(({"couch"}),
    "Die Couch ist, wie Du unter dem Staub noch erkennen kannst, rot "
    "gemustert. Aber vielleicht ist sie weich und es lohnt trotz des Staubes "
    "sich darauf zu setzen.");
  AddDetail(({"stab","zehe","drachenzehe"}),#'detail_zehe);
  AddDetail(({"ende","ewigkeit"}),
    "Alles hat ein Ende.");
  AddDetail(({"oben"}),
    "In diese Richtung kannst Du gehen.");

  AddCmd(({"leg","lege","hinlegen","legen"}),"cmd_lege");
  AddCmd(({"sitz","setze","setzen","hinsetzen"}),"cmd_sitz");
  AddCmd(({"nimm","nehme","nehmen"}),"cmd_nehmens");

  AddExit("oben",ROOM "brunnen");
  anzahl=1;
}

void reset()
{
  ::reset();
  anzahl=1;
}

string detail_zehe()
{
  if (anzahl)
    return break_string(
           "Du untersuchst die Klaue genauer. Die eine scheint wirklich kein "
           "Tischbein, sondern das Ende eines Stabes zu sein. Du koenntest "
           "den Stab nehmen.");
  return break_string(
         "Du hast Dich wohl geirrt. Doch halt, es sieht so aus, als ob ein "
         "Tischbein fehlen wuerde. Da war wohl jemand schneller als Du.");
}

int cmd_lege(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "couch",
       "Wo willst Du Dich hinlegen?"))
    return 0;

  tell_room(ME,break_string(
    PL->Name(WER,NAME_AUTO)+" macht irgend etwas. Doch leider war es "
    "zu schnell und Du hast nichts mitbekommen."),({PL}));
  write(break_string("Du legst Dich kurz auf die verstaubte Couch. Kaum "
        "liegst Du, da fuehlst Du Dich erholt und relaxt. "
        "Hier koenntest Du die Ewigkeit verbringen. Alle Anspannungen "
        "scheinen von Dir zu fallen, doch leider musst Du irgendwann ja "
        "wieder aufstehen. Du seufzt laut und stehst langsam auf. Dabei "
        "faellt Dein Blick auf den Tisch. Was war das? Hat sich nicht die "
        "eine Zehe der Klaue bewegt?"));
  return 1;
}

int cmd_sitz(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "couch",
       "Wo willst Du Dich hinsetzen?"))
    return 0;

  tell_room(ME,break_string(
    PL->Name(WER,NAME_AUTO)+" macht irgendetwas. Doch leider war es "
    "zu schnell und Du hast nichts mitbekommen."),({PL}));
  write(break_string("Du setzt Dich auf die verstaubte Couch. "
    "Ah ja hier ist wirklich gemuetlich. Hier koenntest Du die "
    "Ewigkeit verbringen. Alle Anspannungen scheinen von "
    "Dir zu fallen, doch leider musst Du irgendwann ja wieder aufstehen. "
    "Du seufzt laut und stehst langsam auf. Dabei faellt Dein Blick auf den "
    "Tisch. Was war das? Hat sich nicht die eine Zehe der Klaue bewegt?"));
  return 1;
}

int cmd_nehmens(string str)
{
  int pos;
  object ob;
  
  if (!S_STANDARD->check_cmd(str,
       "stab|tischbein|bein",
       "Was willst Du nehmen?"))
    return 0;

  tell_room(ME,break_string(
    PL->Name(WER,NAME_AUTO)+" macht irgend etwas. Doch leider war es "
    "zu schnell und Du hast nichts mitbekommen."),({PL}));
  if (!anzahl)
  {
    write(break_string("Du greifst ins Leere. Ist wohl doch kein Stab da, "
      "oder hat da jemand ... also so was ... wirklich ... Schweinerei "
      "... irgendjemand war wohl vor Dir hier."));
    return -1;
  }
  write("Du fasst nach dem Tischbein und haeltst einen Stab in der Hand.\n");
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  if (pos!=6) //ist man an der richtigen stelle?
  {
    write(break_string("Ploetzlich reisst Dir der Tisch den Stab aus der Hand. "
          "Du zuckst die Schultern. Zur Zeit kannst Du den Runenstab sowieso zu "
          "nichts gebrauchen."));
    return 1;
  }
  if (S_STANDARD->present_clone(WEAPON "runenstab",PL))
  {
    write("Aber Du hast doch schon einen Stab!\n");
    return 1;
  }
  anzahl--;
  ob=clone_object(WEAPON "runenstab");
  ob->move(PL,M_NOCHECK); //nocheck, da quest item ohne gewicht
  return 1;
}
