#pragma strict_types
#include "../def.h"
inherit STD "runenwand";

void create();
int exit_sueden();

void create() 
{
  ::create();
  create_aussen_mitte();

  SetProp(P_INT_SHORT, "In luftiger Hoehe");
  SetProp(P_INT_LONG,
    "Du stehst auf einem grauschwarzen eintoenigen Balkon und denkst "
    "bei Dir, dass man wenigstens ein paar Bequemlichkeiten hier haette "
    "unterbringen oder irgendetwas, was es hier gemuetlicher machen "
    "wuerde. So wie jetzt ist der Balkon doch ueberfluessig, oder "
    "etwa nicht?");
  SetProp(P_ARCHON_RUNE_IN_QUEST,7);

  AddDetail(({"bequemlichkeit","bequemlichkeiten"}),
    "Ein Liegestuhl, ein Bar oder ... Du schwellst in Traeumen.");
  AddDetail(({"traum","traeume"}),
    "Du traeumst zur Zeit leider nur von Runen ...");
  AddDetail(({"stuhl","liegestuhl","bar"}),
    "Ohhh waere das schoen ...");

  AddExit("sueden",#'exit_sueden);
}

int exit_sueden()
{
  write(break_string(
    "Du betrittst das dunkle Loch und schreitest den Geheimgang nach unten "
    "und stehst ploetzlich wieder neben dem Schrein."));
  PL->move(ROOM "pali_raum",M_GO,"","verschwindet",
    "erscheint ploetzlich neben dem Schrein");
  return 1;
}

