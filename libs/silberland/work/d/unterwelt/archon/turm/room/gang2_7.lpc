#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();

void create() 
{
  ::create();
  create_mitte();

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Du glaubst ein leises Vogelgezwitscher zu hoeren und wendest "
    "Deinen Kopf nach Westen. Du staunst, als Dein Blick in den "
    "angrenzenden Raum streift, welcher wie eine Lichtung in einem Wald "
    "aussiehst. Deine Fuesse beginnen fast von alleine zu laufen, um Dich "
    "nach Westen zu tragen. Doch vielleicht willst Du doch lieber nach "
    "Sueden oder Osten gehen.");
  
  AddDetail(({"kopf"}),
    "Dein Kopf ist hoffentlich festgewachsen.");
  AddDetail(({"westen","sueden","osten"}),
    "In diese Richtung kannst Du gehen.");
  AddDetail(({"richtung","richtungen"}),
    "Hier geht es nach Westen, Osten und Sueden.");
  AddDetail(({"wald","lichtung","blick"}),
    "Geh doch einfach nach Westen, dann kannst Du alles ganz genau "
    "untersuchen.");
  AddDetail(({"fuss","fuesse","fuessen"}),
    "Mit ihnen laeufst Du.");
  AddDetail(({"vogelgezwitscher","gezwitscher"}),
    "Lausche lieber.");
  
  AddSound(({DEFAULT_SOUND,"gezwitscher","vogelgezwitscher"}),
    "Du musst Dich verhoert haben. Weit und breit kein Ton zu hoeren.");

  AddExit("westen",ROOM "wlaeufer_raum");
  AddExit("osten",ROOM "gang2_8");
  AddExit("sueden",ROOM "gang2_6");
}

