#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();
string detail_flaeche();
int cmd_ziehe(string str);

void create()
{
  ::create();
  create_spitze();

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Du bist auf einem Rundgang in der Spitze des Turmes. "
    "In der Suedwand ist eine Nische eingelassen, in welcher "
    "es schwach leuchtet. Direkt vor der Nische steht "
    "ein Hocker und daneben ist ein Hebel angebracht.");

  AddDetail(({"rundgang","raum"}),QueryProp(P_INT_LONG));
  AddDetail(({"nische"}),
    "In der Suedwand ist eine Nische eingearbeitet worden. "
    "In dieser hier erkennst Du eine flache Flaeche, welche "
    "schwach leuchtet.");
  AddDetail(({"hebel"}),
    "Sieht aus wie ein normaler Hebel, Du koenntest ihn ziehen.");
  AddDetail(({"suedwand"}),
    "In der Suedwand befindet sich eine Nische.");
  AddDetail(({"hocker"}),
    "Der Hocker ist wohl dazu gedacht, dass es sich hier jemand "
    "bequem machen kann, waehrend dieser jemand die Flaeche beobachtet.");
  AddDetail(({"flaeche","leuchten"}),#'detail_flaeche);
  AddDetail(({"norden","nordosten","nordwesten"}),
    "In diese Richtung kannst Du gehen.");


  AddCmd(({"zieh","ziehe","ziehen"}),"cmd_ziehe");
  AddCmd(({"sitz","setze","setzen"}),"cmd_sitz");
  AddCmd(({"steig","steige","steigen"}),"cmd_steigen");
  AddCmd(({"mach","mache","machen"}),"cmd_machen");

  AddExit("norden",ROOM "gang3_1");
  AddExit("nordwesten",ROOM "gang3_4");
  AddExit("nordosten",ROOM "gang3_2");
}

string detail_flaeche()
{
  string beschreibung;
  object ort;

  // Changed by Angel 02.02.2003
  call_other(ROOM "vorturm", "???", 0);
  ort = find_object ( ROOM "vorturm" );
  //ort=load_object(ROOM "vorturm");
  if (!objectp(ort))
  {
    return "Fehler! Bitte einem Magier bescheid sagen.\n";
  }
  beschreibung = (string)ort->int_long(ort,0);
/*
Du befindest Dich in einer Hoehle. Genau in der Mitte ragt ein riesiger
schwarzer Turm auf, dessen Fuss von Sokrapflanzen umwuchert ist. Du blickst
Dich weiter um und versuchst, die Spitze des Turmes zu erspaehen. Doch so sehr
Du Dich auch anstrengst, verliert sich die Spitze in der Dunkelheit, genau wie
die Felswaende um Dich herum.
*/
  return break_string("Du schaust auf die Flaeche und siehst eine Hoehle. "+
   beschreibung[35..]+" Wenn Du aber das genauer ansehen willst, wirst Du "
   "wohl den Turm verlassen muessen. Von hier wirst Du aber jede "
   "Person erkennen, die sich vor dem Turm befindet.");
}

int cmd_ziehe(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "hebel",
       "Was willst Du ziehen?"))
    return 0;

  write(break_string("Du willst den Hebel ergreifen, doch kaum umfasst "
    "Du ihn, springt er aus Deiner Hand und ist nun auf der anderen "
    "Seite der Nische. Von Dir will er wohl nicht gezogen werden."));
  return 1;
}

int cmd_sitz(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "hocker",
       "Worauf willst Du sitzen?"))
    return 0;
  write("Schau einfach auf die Flaeche. Das passiert dann alles von alleine.\n");
  return 1;
}

int cmd_steigen(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "hocker",
       "Worauf willst Du steigen?"))
    return 0;
  write("Schau einfach auf die Flaeche. Das passiert dann alles von alleine.\n");
  return 1;
}

int cmd_machen(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "hocker&bequeem",
       "Worauf willst Du es Dir bequeem machen?|"
       "Willst Du es Dir auf dem Hocker BEQUEM machen?"))
    return 0;
  write("Schau einfach auf die Flaeche. Das passiert dann alles von alleine.\n");
  return 1;
}
