#pragma strict_types
#include "../def.h"
inherit "/std/room";

void create();

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Im Nichts");
  SetProp(P_INT_LONG,
    "Hierher werden nur am Ende der Quest die NPC's gemoved, "
    "bevor sie destructed werden!");
  
  AddExit("turm",ROOM "eingang");
}

void init()
{
  ::init();
  set_next_reset(120);
}

void reset()
{
  ::reset();
  remove(1);
}