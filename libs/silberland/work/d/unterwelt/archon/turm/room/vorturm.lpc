#pragma strict_types
#include "../def.h"
inherit "std/room";

void create();
void reset();
int westen();
int cmd_rufe(string str);
int cmd_pfluecke(string str);
int cmd_greife(string str);

int anzahl;
int gepflueckt;
int zerstoert;

#define ANSCHLUSS "/d/unterwelt/basics/central/room/00-04-13"

void create()
{
  ::create();

  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_KILL_NAME,"Ein schwerer Sturz"); //wird beim fallen benoetigt
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_CAVE]));
  SetProp(P_INT_SHORT, "Vor dem schwarzen Turm");

/* 
  ACHTUNG bei veraenderung der LONG, muss auch gang3_3.c angepasst werden!!! 
  Dies betrifft nur Aenderungen im ersten Satz, da dieser in gang3_3 
  abgeschnitten wird.
*/

  AddDetail(({"hoehle"}),
    "Da befindest Du Dich gerade.");
  AddDetail(({"boden","untergrund","unachtsamkeit"}),
    "Der Untergrund ist tueckisch und voller verborgener Spalten und "
    "Loecher. Leicht kann man sich bei einer Unachtsamkeit einen Fuss "
    "brechen, oder sogar Schlimmeres.");
  AddDetail(({"schlimmeres","koerperteil","koerperteile"}),
    "Welches Koerperteil ist schlimmer als ein Fuss?");
  AddDetail(({"spalten","spalte","spalt"}),
    "Es gibt am Boden viele Spalten und Loecher.");
  AddDetail(({"zeit"}),
    "Du scheinst viel Zeit zu haben.");
  AddDetail(({"moment", "andere"}),
    "Das weisst Du im Moment auch nicht.");
  AddDetail(({"umgebung"}),
    "Schau Dich nur genau um.");
  AddDetail(({"decke"}),
    "Die Decke kannst Du nicht erkennen.");
  AddDetail(({"schlacht","entfernung"}),
    "Die Schlacht haettest Du gerne - aus sicherer Entfernung - miterlebt.");
  AddDetail(({"feind","feinde","attacker","attackern","angreifer"}),
    "Wer wuerde schon einen Turm voller Hexer, Magier und maechtiger Waechter "
    "angreifen? Doch halt - was ist mit den Dunkelelfen? Die Dunkelelfen "
    "wuerden in ihrem Machtbereich wohl kaum jemanden dulden. "
    "Vielleicht haben die Dunkelelfen vor langer Zeit den Turm angegriffen "
    "und Du kannst deswegen ueberall Brandspuren sehen.");
  AddDetail(({"machtbereich"}),
    "In wessen Machtbereich bist Du wohl hier?");
  AddDetail(({"naehe"}),
    "Wo?");
  AddDetail(({"licht","schein"}),
    "Ein magisches Leuchten, welches vom Turm auszugehen scheint, erhellt die "
    "Umgebung.");
  AddDetail(({"leuchten", "magisches leuchten", "art"}),
    "Eine Art magisches Leuchten erhellt den Turm.");
  AddDetail(({"rot", "schwarz", "farbe"}),
    "Was mag dies fuer ein Turm sein? Und wieso vermag er die Farbe zu "
    "wechseln?");
  AddDetail(({"rune", "runen", "farben"}),
    "Die Runen der unterschiedlichsten Formen und Farben, dienen "
    "zum Schutz des Turmes. Nur maechtige Hexer koennen diese Runen "
    "hier angebracht habe. Noch nie hast Du solche Runenarten gesehen, "
    "doch erkennst Du intuitiv, dass kein Angreifer sie ueberwinden kann.");
  AddDetail(({"runenarten","arten"}),
    "Solche Runen hast Du noch nie gesehen.");
  AddDetail(({"hexer","magier","bewohner"}),
    "Ob es noch Magier und Hexer im Turm gibt? Die Brandspuren am Turm "
    "sprechen nicht wirklich dafuer.");
  AddDetail(({"brandspur","brandspuren","spur","spuren"}),
    "Die Brandspuren sind sehr alt und bedecken fast den gesamten Turm. "
    "Vor langer Zeit muss hier eine grosse Schlacht stattgefunden haben.");
  AddDetail(({"schutz","schutzrunen"}),
    "Dieser Turm wurde besonders geschuetzt.");
  AddDetail(({"anhaltspunkt","idee"}),
    "Du hast keine Idee wie Du in den Turm gelangen kannst.");
  AddDetail(({"form","formen","bizarr","bizarre form","bizarre formen",
              "tuerme","tuermen","wert"}),
    "Der Turm trotzt den Dir bekannten physikalischen Gesetzen. Die Bewohner "
    "des Turmes legten wohl grossen Wert darauf, sich von anderen Tuermen zu "
    "unterscheiden. So erheben sich die verschiedenen Spitzen, Boegen und "
    "Waende des Turmes in den unmoeglichsten Anordnungen.");
  AddDetail(({"gesetz","gesetze","physikalische gesetze",
              "pysikalischen gesetzen"}),
    "Der Turm hebt die normalen physikalischen Gesetze einfach auf.");
  AddDetail(({"anordnung", "anordnungen", "spitze", "spitzen", "bogen",
              "boegen"}),
    "Die Anordnung mutet bizarr an.");
  AddDetail(({"fuss","fuesse","fusse"}),
    "Am Fusse des Turmes wachsen Sokrapflanzen.");
  AddDetail(({"heldenkrone","buch","die"}),
    "Dies ist ein Buch von Robin McKinley.");
  AddDetail(({"robin","mckinley", "robin mckinley" }),
    "Robin McKinley ist eine Autorin.");
  AddDetail(({"autor","autorin"}),
    "Es gibt viele.");
  AddDetail(({"kraft", "kraefte", "magische kraefte"}),
    "Du weisst leider nichts ueber die angeblichen Kraefte.");
  AddDetail(({"blatt", "blaetter"}),
    "Die Blaetter sind ziemlich klein und haben fuenf Zacken.");
  AddDetail(({"zacke","zacken"}),
    "Jedes der Blaetter der Sokrapflanzen hat fuenf Zacken.");
  AddDetail(({"wissen", "macht"}),
    "Du solltest Dich umschauen und die Weiten des Silberlandes erforschen. "
    "Du koenntest natuerlich auch einen der Waechter des Turmes rufen und "
    "Dich mal drinnen umschauen, vielleicht beantwortet dies einige deiner "
    "Fragen.");
  AddDetail(({"frage","fragen","anfang"}),
    "Fragen sind der Anfang des Wissens.");
  AddDetail(({"silberland","weite","weiten","weiten des silberlandes"}),
    "Du bist inmitten der Weiten des Silberlandes.");
  AddDetail(({"dunkelelf","dunkelelfen"}),
    "Die Dunkelelfen leben hier in der Unterwelt. Such sie in der Naehe und "
    "Du wirst sie finden.");
  AddDetail(({"unterwelt"}),
    "Du bist mitten drinnen.");
  AddDetail(({"waechter"}),
    "Unsichtbare Waechter schuetzen den Turm. Ob man mit ihnen in Kontakt "
    "treten kann?");
  AddDetail(({"kontakt"}),
    "Wenn Du nur mehr Wissen haettest, dann wuerde Dir bestimmt etwas "
    "einfallen, um mit den Waechtern drinnen in Kontakt zu treten. Doch so "
    "wie es ist, bist Du hier draussen und sie im Turm.");
  AddDetail(({"weg", "westen", "nach westen", "richtung westen"}),
    "Ein kleiner Weg im Westen geht um den ganzen Turm herum.");
  AddDetail(({"ausgang", "ausgaenge"}),
    "Es gibt hier zwei Ausgaenge, einen nach Norden, zurueck woher Du "
    "gekommen bist und einen nach Westen.");
  AddDetail(({"norden","sueden","westen"}),
    "In diese Richtung kannst Du gehen.");

  AddReadDetail(({"rune","runen"}),
    "Die Runen sind zu weit weg, als dass Du sie genau erkennen koenntest.");
    
  AddSound(({"stille","hoehle",DEFAULT_SOUND}),
    "Eine unnatuerliche Stille herrscht in der Hoehle.");
  AddSmell(({"geruch","luft","verbrannt","verbranntem","verbranntes",DEFAULT_SMELL}),
    "In der Luft liegt der Geruch von Verbranntem.");

  AddCmd(({"ruf","rufe","rufen"}),"cmd_rufe");
  AddCmd(({"pflueck","pfluecke","reiss","reisse","reissen"}),"cmd_pfluecke");
  AddCmd(({"greif","greife","greifen"}),"cmd_greife");

  NewDoor("sueden", ANSCHLUSS, ({"tuer","holztuer"}),
    ({D_NAME,"Holztuer"
     ,D_GENDER, FEMALE
     ,D_FLAGS, DOOR_RESET_CL|DOOR_CLOSED
     ,D_MSGS, ({"nach Sueden"
               ,"durchschreitet die Tuer"
               ,"kommt durch die Tuer herein"
               })
     ,D_SHORT,"Die Holztuer ist %s. "
     ,D_LONG, "Eine alte verfallene Holztuer. Wirklich alt und verfallen? "
              "Der erste Eindruck scheint vielleicht doch zu taeuschen. "
              "Vielleicht ist das aber gerade beabsichtigt? "
     ,D_OPENMSG,({"Du oeffnest mit einem nervzermuerbendem Quietschen die "
                  "Holztuer."
                 ,"%s oeffnet mit einem nervzermuerbendem Quietschen die "
                  "Holztuer."
                 ," wird von der anderen Seite quietschend geoeffnet."
                 })
     ,D_CLOSEMSG,({BS("Du schliesst die Holztuer, welche nochmal gegen einen "
                   "Stein knallt und zufaellt.")
                  ,"%s schliesst die Holztuer, welche nochmal gegen einen "
                   "Stein knallt und zufaellt." //BS bricht eh nicht richtig - wieder raus
                  ," wird von der anderen Seite geschlossen und faellt zu."
                  })
     ,D_RESET_CLOSEMSG, " faellt krachend ins Schloss."
     })
  );

  AddExit("norden", #'westen);
  AddExit("westen", #'westen);

  reset();
}

int westen()
{
  write(break_string(
       "Langsam umkreist Du den Turm. Aber ausser jeder Menge Sokrapflanzen "
       "findest Du nichts. Nirgends ist auch nur etwas aehnliches wie einen "
       "Eingang zu finden. Es war ja auch toericht anzunehmen, dass die Hexer "
       "ihren Turm so einfach zugaenglich machen wuerden, damit ihre Feinde "
       "hereinspazieren koennen. "
       "Wenn Du also hinein willst, musst Du Dir etwas anderes ueberlegen."));
  return 1;
}

int cmd_rufe(string str)
{
  int art,pos;
  if (!S_STANDARD->check_cmd(str,
       "waechter|wache",
       "Was willst Du rufen?"))
    return 0;
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(PL);
  if (zerstoert || pos>8 || (art==2 && pos>7)) //bei art=2 ist pos=8 fuer gehe zu priesterin
  {
    tell_object(PL,"Du rufst nach einem Waechter, doch nichts passiert.\n");
    return 1;
  }
  tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
    " ruft etwas und ploetzlich materialisiert sich ein formloses "
    "Wesen und beruehrt "+PL->name(WER,NAME_AUTO)+". "
    "Es leuchtet kurz auf und dann sind die Beiden auch schon verschwunden."),
    ({PL}));
  tell_object(PL,break_string("Du rufst einen Waechter, welcher sich "
    "ploetzlich neben Dir materialisiert. "
    "Seine fleischlosen Haende greifen nach Dir und Du verlierst das "
    "Bewusstsein. Nach einer Weile wachst Du im Turm auf. Von dem formlosen "
    "Waechter ist weit und breit keine Spur."));
  PL->move(ROOM "eingang.lpc",M_GO|M_SILENT);
  tell_room(environment(PL),PL->Name(WER,NAME_AUTO)+" erscheint.\n",({PL}));
  return 1;
}

int cmd_pfluecke(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "sokra|sokrablaetter|blatt|blaetter|sokrablatt",
       "Was willst Du pfluecken?"))
    return 0;

  if (anzahl && !gepflueckt)
  {
    anzahl--;
    gepflueckt=1;
    call_out("gepflueckt_back",120+random(240)); //2-6 min
    PL->AddHp(-1);
    write(break_string(
          "Du greifst nach dem Blatt, reisst es von der Pflanze und laesst es "
          "fallen, als Du Dich an einem der Zacken des Blattes stichst."));
    tell_room(ME,break_string(PL->Name(WER,NAME_AUTO)+
          " reisst ein Blatt ab."),({PL}));
    clone_object(OBJ "sokra")->move(ME,M_NOCHECK|M_SILENT);
    return 1;
  }
  write(break_string(
        "Du greifst nach einem Blatt und reisst es von der Pflanze. Kaum hast "
        "Du dies getan, welkt das Blatt dahin und zerfaellt wenige Augenblicke "
        "spaeter unter Deinen erstaunten Blicken. Diese Blatt war wohl nicht "
        "geeignet versuch es spaeter noch mal."));
  return -1;
}

void gepflueckt_back()
{
  while (remove_call_out("gepflueckt_back")!=-1) ;
  gepflueckt=0;
}

int cmd_greife(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "loch|loecher|spalte|spalten",
       "Wo willst Du hinein greifen?"))
    return 0;

  write(break_string("Was denkst Du darin zu finden? Lass es sein, dort ist "
        "nichts."));
  return 1;
}

int dturm()
{  //turm zerstoeren
  set_next_reset(180);
  zerstoert=1;
  SetProp(P_INT_LONG,
    "Du befindest Dich in einer Hoehle. Genau in der Mitte ragen die Truemmer eines "
    "schwarzen Turmes in die Hoehe. Der Turm muss einmal riesig gewesen sein, "
    "um zerstoert noch so weit hinauf zu ragen. Zwischen den Trummern wachsen "
    "Sokrapflanzen.");
  AddDetail(({"nahem","mitte","turm","gebaeude","berg","felsspitze","truemmer",
              "wand","waende"}),
    "Von dem Turm sind nur noch Truemmer uebrig.");
  AddDetail(({"sokra","pflanzen","pflanze","sokrapflanze","sokrapflanzen",
              "kletterpflanze","kletterpflanzen"}),
    "Die Sokrapflanze ist eine Kletterpflanze, die sich rund um die "
    "Truemmer des Turmes herumschlaengelt. Ob sie magische Kraefte besitzen? Du "
    "erinnerst Dich dunkel daran, dass die Pflanze in 'Die Heldenkrone' "
    "erwaehnt wird, ob dies hier die selbe Pflanze ist?");
   AddDetail(({"loch","loecher"}),
    "Ueberall am Boden erkennst Du kleine und groessere Loecher, hier und da "
    "sogar ein paar Spalten.");
   RemoveDetail(({"spitze","turmspitze","eingang"}));
   AddDetail(({"dunkelheit"}),
    "Ueber Dir erstreckt sich eine undurchdringliche Dunkelheit.");
}

void reset()
{
  ::reset();
  gepflueckt=0;
  anzahl=5; //5 mal maximal je reset, aber dazwischen 2-6 min wartezeit
  while (remove_call_out("gepflueckt_back")!=-1) ;
  if (zerstoert)
  {
   tell_room(ME,
    "Ploetzlich schimmern die Truemmer des Turmes und der Turm ist "
    "wieder heil.\n");
  }
  SetProp(P_INT_LONG,
    "Du befindest Dich in einer Hoehle. Genau in der Mitte ragt ein riesiger "
    "schwarzer Turm auf, dessen Fuss von Sokrapflanzen umwuchert ist. Du "
    "blickst Dich weiter um und versuchst, die Spitze des Turmes zu "
    "erspaehen. Doch so sehr Du Dich auch anstrengst, verliert sich die "
    "Spitze in der Dunkelheit, genau wie die Felswaende um Dich herum.");
  AddDetail(({"loch","loecher"}),
    "Ueberall am Boden erkennst Du kleine und groessere Loecher, hier und da "
    "Spalten, aber am Turm, wo du einen Eingang, Spalte oder auch nur ein "
    "Loch erhoffst, ist nichts.");
  AddDetail(({"turmspitze","spitze","dunkelheit"}),
    "Die Turmspitze verliert sich in der Dunkelheit.");
  AddDetail(({"eingang"}),
    "Du fragst Dich, wie Du wohl in den Turm hinein kommen kannst.");
  AddDetail(({"nahem","mitte","turm","gebaeude","berg","felsspitze"}),
    "Der Turm ist schon eher ein schwarzer Berg oder eine schwarze "
    "Felsspitze. Doch was ist das? Von Nahem betrachtet funkelt der Turm "
    "ploetzlich rot auf. Seine felsigen Waende erheben sich in den "
    "unmoeglichsten Formen weit in die Hoehe und Du erkennst "
    "Brandspuren an seinen Aussenwaenden. Was mag hier geschehen sein und "
    "wer mag hier residieren?\nDu gruebelst. Egal - was Dich zur Zeit mehr "
    "interessiert waere ein Eingang, doch nirgends kannst Du einen "
    "Anhaltspunkt entdecken, wie Du in den Turm hineinkommen kannst.");
  AddDetail(({"hoehe","turmwand","turmwaende","felsige wand","felsige waende",
              "aussenwaende","aussenwand","felswand","felswaende"}),
    "Bizarr geformte Turmwaende erheben sich in die Hoehe.");
  AddDetail(({"wand","waende"}),
    "Ueberall sind in den Waenden Runen des Schutzes und der Macht "
    "eingelassen.");
  AddDetail(({"sokra","pflanzen","pflanze","sokrapflanze","sokrapflanzen",
              "kletterpflanze","kletterpflanzen"}),
    "Die Sokrapflanze ist eine Kletterpflanze, die sich rund um den Fuss "
    "des Turmes herumschlaengelt. Ein leichtes Leuchten geht von "
    "den Blaettern der Pflanze aus. Ob sie magische Kraefte besitzen? Du "
    "erinnerst Dich dunkel daran, dass die Pflanze in 'Die Heldenkrone' "
    "erwaehnt wird, ob dies hier die selbe Pflanze ist?");
  RemoveDetail(({"truemmer"}));
  zerstoert=0;
}
