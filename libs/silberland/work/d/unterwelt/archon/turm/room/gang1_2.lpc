#pragma strict_types
#include "../def.h"
inherit STD "turm";

void create();

void create() 
{
  ::create();
  create_unten();

  SetProp(P_INT_SHORT, "Ein Gang");
  SetProp(P_INT_LONG,
    "Der Gang macht hier einen Knick und Du erkennst im Osten, dass sich "
    "der Gang verengt. Vielleicht solltest Du einfach wieder nach Norden "
    "gehen, anstatt Dich weiter nach Osten zu begeben, denn so wie es dort "
    "aussieht, ist im Osten nichts Interessantes zu erwarten.");
  
  AddDetail(({"knick"}),
    "Der Gang fuehrt halt nicht geradeaus, sondern macht einen Knick.");
  AddDetail(({"laufen"}),
    "Du weisst doch wie das geht, oder?");
  AddDetail(({"interessantes"}),
    "Glaubst Du wirklich, dass im Osten etwas Interessantes sein koennte?");
  AddDetail(({"norden","osten"}),
    "In diese Richtung kannst Du gehen.");

  AddExit("norden",ROOM "gang1_1");
  AddExit("osten",ROOM "gang1_3");
}
