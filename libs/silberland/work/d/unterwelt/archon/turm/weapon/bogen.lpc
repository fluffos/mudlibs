inherit "std/weapon";
#include "../def.h"

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT,"Ein elfischer Bogen");
  SetProp(P_LONG,"Dies ist ein elfischer Bogen. Man sagt diesen Boegen nach, "
          "das sie nie daneben schiessen wuerden. Ein wunderbare Waffe, "
          "hoffentlich kannst Du sie fuehren. Doch nur wenige, denen das "
          "Geheimnis des Bogens bekannt ist, koennen diesen Bogen spannen.");

  SetProp(P_NAME,"Bogen");
  SetProp(P_NAME_ADJ,"elfisch");
  AddAdjective(({"elfischen","elfischer","elfischem","elfisches","elfische"}));

  SetProp(P_GENDER,MALE);
  SetProp(P_VALUE,650);
  SetProp(P_WEIGHT,2500);
  SetProp(P_WEAPON_TYPE,WT_BOW);
  SetProp(P_DAM_TYPE,DT_PIERCE);
  SetProp(P_MATERIAL,([MAT_MISC_WOOD:100]));
  SetProp(P_WC,140);
  SetProp(P_WC_BONUS,(["Bogenmeister":250]));
  SetProp(P_NR_HANDS,2);
  SetProp(P_WIELD_RESTRICTIONS,
          ([SR_INCLUDE_RACE:({"Elf","Magier","elf","magier"})]));

  AddId(({"bogen"}));
}

