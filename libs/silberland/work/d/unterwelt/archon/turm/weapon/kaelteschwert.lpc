inherit "/std/weapon";
#include "../def.h"

void create()
{
  if (!is_clone(ME))  return;
  ::create();

  SetProp(P_SHORT, "Ein eiskaltes Schwert");
  SetProp(P_LONG,
    "Die Klinge dieses Schwertes ist von einer sehr scharfen und kalten "
    "Eisschicht bedeckt, so dass schon eine einfache Beruehrung fuer den "
    "Gegner schmerzhaft ist. Zum Glueck ist der Griff nicht so kalt und "
    "Du kannst das Schwert fuehren, ohne selber Schaden zu nehmen.");

  AddDetail(({"klinge"}),
    "Die Klinge ist nicht nur eiskalt, sondern auch hoellisch scharf.");
  AddDetail(({"griff"}),
    "Auf dem handwarmen Griff sind fremdartige Symbole eingraviert.");
  AddDetail(({"symbol","symbole"}),
    "Merkwuerdig! Was moegen sie nur bedeuten.");
  AddDetail(({"kaelte","schicht","eis","eisschicht"}),
    "Brrrr.");

  SetProp(P_NAME,"Schwert");
  SetProp(P_GENDER,NEUTER);
  AddId(({"schwert"}) );

  SetProp(P_WEAPON_TYPE,WT_SWORD);
  SetProp(P_WC,185);
  SetProp(P_WC_FIX,40); //wie bastartschwert
  SetProp(P_WC_BONUS,
    (["Schwertmeister":350]));
  SetProp(P_DAM_TYPE, ({DT_SLASH,DT_COLD}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:50,MAT_ICE:50]));
  SetProp(P_WEIGHT, 1400);
  SetProp(P_VALUE, 1500);
  SetProp(P_SIZE, 125);
  SetProp(P_NOBUY,1);
  SetProp(P_QUALITY_DECAY,50);
  SetProp(P_WIELD_RESTRICTIONS,([A_STR:20])); 
}

int _query_nr_hands()
{ //bastardschwert hat >20
  if(environment() && environment()->QueryAttribute(A_STR)>25)
    return 1;
  else
    return 2;
}

