// Questitem, kann man nicht weglegen ect -> Gewicht=0
// Runenstab um die Runen an der Aussenwand zu manipulieren
// Stab muss erst 'repariert' werden und dann aufgeladen
// 08.05.2003 Archon erstellt
/*
 Rev 1.1 06.08.2003 Archon: bugfix, erstmal ablegbar gemacht
 Rev 1.0 08.05.2003 Archon: erstellt
*/

#pragma strong_types
inherit "std/weapon";
#include "../def.h"

string detail_zehe();
string detail_kugel();
int cmd_druecke(string str);
void reset();
varargs int remove(int silent);
int query_intact();
int query_loaded();

int my_status;

void create() 
{
  if (!is_clone(ME)) return;
  ::create();
  my_status=0;
  SetProp(P_SHORT,"Ein Runenstab");
  SetProp(P_MATERIAL,([MAT_SILVER:90,MAT_MISC_DEAD:10]));
  SetProp(P_NAME, "Runenstab");
  SetProp(P_GENDER,MALE);
  SetProp(P_VALUE,1);
  SetProp(P_NOBUY,1);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_WC, 90);
  SetProp(P_WEIGHT,0);

  AddDetail(({"rune","runen"}),
    "In den Stab sind viele kleinen Runen eingeritzt. Du glaubst eine "
    "Rune des Erschaffens und eine des Zerstoerens zu entziffern.");
  AddDetail(({"erschaffen","zerstoeren","zerstoerens","erschaffens"}),
    "Ob man mit diesem Stab etwas Erschaffen oder Zerstoeren kann?");
  AddDetail(({"kopf"}),
    "Am Kopf des Stabes ist eine Drachenklaue befestigt.");
  AddDetail(({"drachenzehe","zehe","drachenzehen","zehen",
              "klaue","drachenklaue"}),
    #'detail_zehe);
  AddDetail(({"kugel","energie"}),#'detail_kugel);

  AddId(({"stab","runenstab","artefakt"}));

  SetProp(P_INFO,"Wozu mag der Runenstab wohl dienen?");

  AddCmd(({"andruecken","andruecke","andrueck","drueck","druecke",
           "druecken"}),"cmd_druecke");
}

string _query_long()
{
  string ret;
  switch(my_status)
  {
    case 0:
      ret="Dies ist ein silberner Runenstab, an dessen Kopf eine Drachenklaue "
          "befestigt ist. Die Klaue muss einmal eine Kugel oder etwas "
          "aehnliches gehalten haben, doch leider ist einer der Drachenzehen "
          "abgebrochen und die Kugel muss dabei entzwei gegangen sein.";
          "Solltest Du irgendwo die Zehe finden, koenntest Du sie an die "
          "Klaue andruecken und schauen was dann passiert.";
    break;
    case 1:
      ret="Dies ist ein silberner Runenstab, an dessen Kopf eine Drachenklaue "
          "befestigt ist. Die Klaue selber ist intakt, doch scheint sie "
          "einmal eine Kugel oder etwas aehnliches gehalten zu haben. "
          "Solltest Du es je schaffen, den Stab in seinen urspruenlichen "
          "Zustand zu versetzen, ist dieser bestimmt ein maechtiges Artefakt.";
    break;
    default:
      ret="Dies ist ein silberner Runenstab, an dessen Kopf eine Drachenklaue "
          "befestigt ist. Die Klaue selber haelt eine blau schimmernde "
          "und sich bewegende Kugel fest, welcher voller Energie zu sein "
          "scheint. Der Stab scheint nun einsatzbereit zu sein, doch "
          "wozu kann man ihn nutzen?";
    break;
  }
  return break_string(ret);
}

string detail_zehe()
{
  if (!my_status)
    return break_string("Die Drachenklaue hat nur drei Zehen, da die vierte "
      "irgendwann einmal abgebrochen sein muss. Hierdurch ist der Runenstab "
      "seiner Macht verloren gegangen. Solltest Du irgendwo die Zehe "
      "finden, koenntest Du sie an die Klaue andruecken und schauen was dann "
      "passiert.");
  if (my_status==1)
    return "Die Drachenklaue hat vier Zehen, die etwas halten koennten.\n";
  return break_string("Die Drachenklaue hat vier Zehen und haelt eine Kugel "
    "vor lauter Energie schimmernde Kugel.");
}

string detail_kugel()
{
  if (my_status>1)
    return break_string("Eine vor Energie schimmernde Kugel wird von den "
      "Zehen der Drachenklaue an ihrem Platz gehalten.");
  return break_string("Vielleicht kann der Runenstab sowas besitzen, aber "
    "zur Zeit hat er es nicht.");
}

int cmd_druecke(string str)
{
  object zehe;
  if (!S_STANDARD->check_cmd(str,
       "zehe|drachenzehe&klaue|stab|runenstab",
       "Was willst Du woran druecken?|"
       "Woran willst Du die Drachenzehe druecken?"))
    return 0;
  
  if (query_intact())
    return notify_fail("Aber der Stab ist doch schon ganz!\n"),0;
  
  if (!(zehe=(object)S_STANDARD->present_clone(OBJ "drachenzehe",PL)))
  {
    if (present("drachenzehe",PL))
      return notify_fail("Das ist nicht die richtige Drachenzehe!\n"),0;
    return notify_fail("Aber Du hast doch gar keine Drachenzehe!\n"),0;
  }

  my_status=1;
  zehe->remove(1);
  write(break_string("Du drueckst die abgebrochene Drachenzehe fest an "
    "an seinen urspruenglichen Platz und ploetzlich leuchten die "
    "Raender vom Stab und Zehe hell auf und verbinden sich wieder "
    "miteinander."));
  tell_room(environment(PL),break_string(
    PL->Name(WER,1)+" drueckt eine abgebrochene Drachenzehe fest an "
    "an seinen Runenstab und ploetzlich leuchtet etwas auf und die "
    "Zehe hat sich mit der Klaue am Stab verbunden."),({PL}));

  return 1;
}

void reset()
{
  ::reset();
  if (!is_clone(ME)) return;
  if (!environment(ME)) remove(1);
  if (!living(environment(ME)) && !query_once_interactive(environment(ME))) 
    remove(0);
}

varargs int remove(int silent)
{
  if (silent || !environment(ME)) return ::remove(0);
  if (living(environment(ME)))
    tell_object(environment(ME),"Der Runenstab zerfaellt zu Staub.\n");
  else
    tell_room(environment(ME),"Der Runenstab zerfaellt zu Staub.\n");
  return ::remove(1);
}

int query_intact()
{
  return (my_status>0);
}

int query_loaded()
{
  return (my_status>1);
}

int set_loaded()
{
  if (my_status>0) my_status=2;
}