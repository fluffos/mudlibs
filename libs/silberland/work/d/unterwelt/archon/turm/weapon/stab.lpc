// Dieser Stab kann von Spieler nicht erhalten werden, da der magier die 
// beim zerstoeren/toeten removed
/*
 Rev 1.0 19.01.2003 Archon: - erste version
*/

#include "../def.h"
inherit "std/weapon";

void create() 
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT,"Ein Stab");
  SetProp(P_LONG,
    "Ein kunstvoll geschwungener Stab mit scharfer Kante.");
     
  AddDetail(({"kante"}),
    "Pass bloss auf.");

  SetProp(P_NAME, "Stab");
  SetProp(P_GENDER, MALE);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_NOBUY, 1);
  SetProp(P_WC, 110);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE,  300);
  SetProp(P_MATERIAL,([MAT_MISC:100]));

  AddId(({"stab"}));
}

