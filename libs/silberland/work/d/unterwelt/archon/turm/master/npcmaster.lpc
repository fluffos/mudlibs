#include "../def.h"
inherit "/std/shells/filesys/asynchron";

// Globvars
nosave object *npcs_gut,*npcs_boese,magier,priesterin;
//es muessen fuer den endkampf min. 5 npc da sein
//wenn nicht werden noch welche nachgeclont ...
nosave string *npcs_name_gut,*npcs_name_boese;

void create() 
{
  if(is_clone(ME)) return 0;
  npcs_gut=({});
  npcs_boese=({});
  npcs_name_gut=({ NPC "zinja",
                   NPC "areu",
                   NPC "falkenhand",
                   NPC "maedlyn",
                   NPC "waechter", //einziger der mehrmals da sein kann!
                   NPC "vorina",
                   NPC "culromex",
                   NPC "gwalmai",
                   NPC "joxa",
                   NPC "maedlyn",
                   NPC "prasamaccus" });
  npcs_name_boese=({ DNPC "dzauberer", 
                     DNPC "dunkelelf"
                  });
}

void add_npc(object npc,int art) 
{
  switch(art)
  {
    case 1: 
      npcs_gut+=({npc});
    break;
    case 2:
      npcs_boese+=({npc});
    break;
    case 3:
      magier=npc;
    break;
    case 4:
      priesterin=npc;
    break;
  }
}

void clone_npc_gut(string was)
{
  object npc;
  npc=clone_object(was);
  npc->move(ROOM "wait_room",M_NOCHECK);
}

void clone_npc_boese(string was)
{
  object npc;
  npc=clone_object(was);
  npc->move(ROOM "destruct_room",M_NOCHECK);
}

//fuer den endkampf!! npc's holen, wir brauchen aber von 
//jeder seite 10 stueck - gibt es mal mehr, werden die im questmaster gekuerzt
void MakeNpcs(int art) 
{ 
  int i,j;
  string *help;

  npcs_gut-=({0});
  npcs_boese-=({0});
  if (art==1) 
  { 
    i=sizeof(npcs_gut);
    help=npcs_name_gut;
    for (;i--;) //keine npc's einmaligen npc's doppelt
      help-=({ explode(file_name(npcs_gut[i]),"#")[0] });
    asynchron(help,#'clone_npc_gut);
    return;
  }
  i=sizeof(npcs_boese);
  j=0;
  help=({});
  i=sizeof(npcs_boese);
  j=sizeof(npcs_name_boese);
  for (;i<10;i++) //alle noch nicht vorhandenen clonen
    help+=({npcs_name_boese[random(j)] });
  asynchron(help,#'clone_npc_boese);
}

//fuer den endkampf!! npc's holen, wir brauchen aber von 
//jeder seite 13 stueck stueck ...
mixed GetNpcs(int art) 
{ 
  npcs_gut-=({0});
  npcs_boese-=({0});
  switch(art)
  {
    case 1: return npcs_gut;
    case 2: return npcs_boese;
    case 3: return magier;
    case 4: return priesterin;
  }
  return -1;
}

