#include "../def.h"
inherit STD+"priester";

void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  create_default_npc(21);

  SetProp(P_LOG_INFO,"archon/turm_luthe.rep");
  SetProp(P_SHORT,"Vater Luthe");

  SetProp(P_NAME,"Luthe");
  SetProp(P_ARTICLE,0);
  SetProp(P_GENDER, MALE); 
  SetProp(P_SIZE,171);
  SetProp(P_WEIGHT,68500);
  SetProp(P_HANDS, ({" mit goettlicher Unterstuetzung", 280, 
                     ({DT_HOLY, DT_BLUDGEON}) }));
    
  AddId(({"vater","luthe"})); 

  SetProp(P_SPELLRATE,33);
  
  AddSpell(2,360,"Luthe schleudert geballte Energie nach Dir.\n",
                  "Luthe schleudert geballte Energie nach @WEN.\n",
                  ({DT_MAGIC,DT_LIGHTNING}),([SP_SHOW_DAMAGE:1]));
  AddSpell(1,390,"Luthe schleudert einen grellen Strahl nach Dir.\n",
                 "Luthe schleudert einen grellen Strahl nach @WEN.\n",
                 ({DT_MAGIC,DT_LIGHT}),([SP_SHOW_DAMAGE:1]));
  
  AddLibrary(LIB "info.lib",1);

  AddInfo(DEFAULT_INFO,
    "murmelt in Gedanken versunken: "
    "'Wie kommt es nur, dass die Treppe nicht zusammenbricht?'");
  AddInfo("treppe",
    "Ist das nicht ein fantastisches Bauwerk?",
    "fragt: ");
  AddInfo(({"bauwerk","konstruktion"}),
    "schaut vertraeumt auf die Treppe.");
  AddInfo(({"gelaender"}),
    "Das fehlt wohl ...",
    "sagt: ");
}

string _query_long()
{
  if (InFight())
   return break_string(
    "Luthe blickt mit neugierigen Augen umher und scheint sich "
    "fuer alles zu begeistern. Als Priester ist er ein sehr gelehrter "
    "Mann, doch erlaubt er sich nur selten das Vergnuegen sich mit jemandem "
    "zu unterhalten. Meist ist er tief in eigenen Gedanken versunken, "
    "doch zur Zeit ist er in einem Kampf verwickelt.");
  return break_string(
    "Luthe blickt mit neugierigen Augen umher und scheint sich "
    "fuer alles zu begeistern. Als Priester ist er ein sehr gelehrter "
    "Mann, doch erlaubt er sich nur selten das Vergnuegen sich mit jemandem "
    "zu unterhalten. Meist ist er tief in eigenen Gedanken versunken, "
    "doch zur Zeit versucht er die Konstruktion der Treppe zu ergruenden.");
}