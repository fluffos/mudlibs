#include "../def.h"
#include <npcmaster.h>
inherit "std/npc";

void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  SetProp(P_SHORT,
    "Ein Monster");
  SetProp(P_LONG,
    "Vor Dir steht ein tiefschwarzes Monster, welches mit dem "
    "Hintergrund zu verschwimmen scheint, so dass Du es nicht genau "
    "erkennen kannst.");
  
  create_default_npc(20);

  SetProp(P_HANDS, ({" mit scharfen Klauen", 220, ({DT_BLUDGEON})}));

  SetProp(P_NAME,"Monster"); 
  SetProp(P_AGGRESSIVE,5);
  SetProp(P_ALIGN,-600);
  SetProp(P_GENDER, NEUTER); 
  SetProp(P_RACE,"Magisch");
  SetProp(P_SIZE,230);
  SetProp(P_WEIGHT,155000);
  SetProp(P_NO_SCORE,1);

  AddId(({"monster"})); 
}