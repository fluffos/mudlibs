#include "../def.h"
inherit STD+"priester";


void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  SetProp(P_LOG_INFO,"archon/turm_areu.rep");
  SetProp(P_SHORT,"Areu, der Priester");
  SetProp(P_LONG,
    "Areu ist ein aelterer aber noch kraftvoller Mann mit einer Halbglatze. "
    "Seine Augen schauen Dich klug an, waehrend sich seine Haende vor seinem "
    "Koerper bewegen und irgend ein Symbol in die Luft zeichnen. "
    "Anscheinend segnet oder verflucht er Dich.");

  AddDetail(({"glatze","halbglatze"}),
    "Noch hat Areu keine Glatze.");
  AddDetail(({"haar","haare","kopf","kreis","anfang"}),
    "Ein Kreis ohne Haare auf dem Kopf von Areu weisst darauf den "
    "Anfang einer Glatze hin.");

  AddInfo(({"segen","gebet"}),
    "Nichts da.",
    "knurrt: ");
  AddInfo(({"fluch","symbol"}),
    "Das willst Du gar nicht wissen.",
    "sagt: ");
    
  AddLibrary(LIB "info.lib",1);

  SetProp(P_NAME,"Areu");
  SetProp(P_ARTICLE,0);
  SetProp(P_GENDER, MALE); 
  SetProp(P_SIZE,156);
  SetProp(P_WEIGHT,66500);
    
  AddId(({"areu"})); 
}
