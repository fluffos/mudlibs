#include "../def.h"
#include <npcmaster.h>
inherit "std/npc";

void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  SetProp(P_SHORT,"Erdenurwesen");
  SetProp(P_LONG,
    "Das Erdenurwesen erhebt sich riesig vor Dir. Es ist fast durchscheinend "
    "und doch wird es von maechtiger Magie zusammen gehalten. Du wirst es "
    "nie in einem normalen Kampf besiegen.");
  
  create_default_npc(17);

  SetProp(P_HANDS, ({" mit geworfenen Erdfetzen", 175, ({DT_BLUDGEON})}));

  SetProp(P_NAME,"Erdenurwesen"); 
  SetProp(P_GENDER, NEUTER); 
  SetProp(P_RACE,"Magisch");
  SetProp(P_SIZE,330);
  SetProp(P_WEIGHT,300000);
  SetProp(P_NO_SCORE,1);

  SetProp(P_MAX_HP,2000);
  SetProp(P_HP,2000);
  
  AddId(({"erdenurwesen","erdwesen","urwesen","erdurwesen","urwesen","wesen",
          "monster"})); 
}

int Defend(int dam, string *dam_type_liste, int spell, object enemy) 
{
  if (enemy->id("\nmagier")) return 0;
  return ::Defend(dam,dam_type_liste,spell,enemy);
}

void die(int p,mixed e)
{
  if (present("\nmagier",environment(ME)))
  {
    SetProp(P_HP,QueryProp(P_MAX_HP));
    tell_room(environment(ME),"Der Magier heilt das Erdenurwesen vollstaendig.\n");
    return;
  }
  ::die(p,e);
}
