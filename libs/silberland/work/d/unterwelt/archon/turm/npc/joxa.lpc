#pragma strict_types
#include "../def.h"
inherit STD+"waldlaeufer";

void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  SetProp(P_LOG_INFO,"archon/turm_joxa.rep"); //schade - solche log-files waeren guenstiger im eigenen verzeichnis?
  SetProp(P_SHORT,"Joxa, der Waldlaeufer");
  SetProp(P_LONG,                                 
    "Der Waldlaeufer schaut Dich durchdringend und abwaegend an. Du glaubst nicht, "
    "dass seinem Blick etwas entgeht und kannst Dir vorstellen, dass er hier steht, "
    "um Bedrohungen fuer sich und seine sich im Turm aufhaltenden Gefaehrten "
    "zu erkennen. Er ist bestimmt ein Meister mit seinen Waffen.");

  AddDetail(({"blick"}),
    "Der fantastische Blick des Waldlaeufers scheint Dich zu durchdringen. Hoffentlich erkennt "
    "er nicht Deine tiefsten Geheimnisse.");

  SetProp(P_NAME,"Joxa");   
  SetProp(P_GENDER,MALE);   
  SetProp(P_ARTICLE,0);
  SetProp(P_SIZE,205);

  AddId(({"joxa"}));

  create_default_npc(25);

  SetProp(P_ALIGN,120);

  AddLibrary(LIB "info.lib",1);

  AddInfo(DEFAULT_INFO,
    "betrachtet Dich eingehend, aber ignoriert Dich ansonsten.");
  AddInfo(({"dunkelelfen","dunkelelf"}),
    "Diese verruchten, Lloth anbetenden Wesen haben schon wieder einen "
    "Ueberfall an der Oberflaeche unternommen. Nun sind wir hier, um "
    "ihnen ihre Grenzen aufzuzeigen.",
    "sagt: ");
  AddInfo(({"wesen","priesterinnen","dunkelelfenmagier","priesterin",
            "dunkelelfenpriesterin","dunkelelfenpriesterinnen",}),
    "Diese verfluchten Dunkelelfen und ihre Priesterinnen sollen nur "
    "herkommen. Ich fege sie von dem Angesicht dieser Welt.",
    "brummt bestimmt: ");
  AddInfo(({"angesicht","welt","vernichten"}),
    "Ich werde alle Dunkelelfen vernichten.",
    "schreit: ");
  AddInfo(({"lloth","spinnenwesen","spinne"}),
    "Ein ekliges Spinnenwesen.",
    "spuckt aus und grummelt: ");
  AddInfo(({"oberflaeche"}),
    "Wir sind gerade erst hier angekommen.",
    "erzaehlt: ");
  AddInfo(({"turm","gebaeude","ort"}),
    "Unser Anfuehrer, ein alter Magier, kannte diesen Ort. Ich weiss nicht "
    "woher, doch koennen wir hier unsere naechsten Schritte planen.",
    "sagt: ");
  AddInfo(({"schritte","plan"}),
    "Ich weiss nicht, was der alte Magier plant. Doch ich hoffe, dass es "
    "bald los geht.",
    "brummt: ");
  AddInfo(({"weg"}),
    "Ich finde ein Weg alle Dunkelelfen zu toeten.",
    "zischt fanatisch: ");
  AddInfo(({"anfuehrer","osta","ostan","magier","fuehrung","anfuehrer"}),
    "Unser Anfuehrer, ein alter weisser Magier, kennt sich anscheinend mit "
    "den Dunkelelfen sehr gut aus. Durch seine Fuehrung werden wir sie "
    "zurueck schlagen.",
    "fantasiert: ");
  AddInfo(({"ueberfall","vorstellung","schaendlicher","schaendlicheres","tot"}),
    "Kann man sich etwas Schaendlicheres vorstellen, als dahingemordete, "
    "unschuldige Frauen und Kinder? Alle Tot ... meine arme Jantia.",
    "fragt zornerfuellt: ");
  AddInfo(({"frauen","frau","jantia","kind","kinder","janti"}),
    "Die schaebigen Dunkelelfen haben meine Frau getoetet. Verflucht sollen "
    "Sie sein! Ich werde jeden Dunkelelfen toeten, der mir draussen ueber den "
    "Weg laeuft. Nur hier darf ich sie nicht toeten, ohne dass sie mich "
    "angreifen.",
    "zischt: ");
  AddInfo(({"grenze","grenzen"}),
    "Ich werde die Dunkelelfen vernichten, doch das darf noch keiner erfahren.",
    "fluestert: ");
  AddInfo(({"unterwelt"}),
    "Endlich sind wir in der Unterwelt. Hoffentlich gehts bald weiter. "
    "Ich will "
    "jeden Dunkelelfen jagen und toeten.",
    "sagt: ");
  AddInfo(({"sex"}),
    "Wie kannst Du in einem solchen Moment nur an Sex denken? Die "
    "Dunkelelfen muessen vernichtet werden.",
    "schnauzt: ");
  AddInfo(({"archon"}),
    "Den habe ich hier schon einmal gesehen.",
    "brummt: ");
  AddInfo(({"ronja"}),
    "Ronja habe ich hier schon einmal gesehen.",
    "brummt: ");
  AddInfo(({"eingang","einlass"}),
    "Ich bewache den eingang, damit sich hier kein feindlich gesinnter "
    "einschleichen kann.",
    "knurrt: ");
  AddInfo(({"hilfe","helfen","auftrag"}),
    "Frag Ostan.",
    "erwidert: ");
  AddInfo(({"ausgang"}),
    "Halt die Klappe, such ihn Dir selbst.",
    "knurrt: ");
  AddInfo(({"waldlaeufer"}),
    "Ich bin ein Waldlaeufer, doch ich bin nicht der einzige hier im Turm.",
    "sagt: ");
  AddInfo(({"paladin","paladine"}),
    "Ein paar Paladine sind weiter oben im Turm. Ich hoffe sie sind im "
    "toeten der Dunkelelfen so gut wie sie behaupten.",
    "erzaehlt: ");
  AddInfo(({"gefaehrte","gefaehrten","priester"}),
    "Der Rest von uns ist weiter oben im Turm.",
    "sagt: ");
  AddInfo(({"pentagramm"}),
    "Schau es Dir selber an.",
    "brummt: ");
  AddInfo(({"waffen","waffe","bogen","meister"}),
    "Ich bin ein Meister mit meinen Bogen und treffe alles, worauf ich "
    "ziele.",
    "platzt vor Stolz: ");
  AddInfo(({"sokra","pflanze","sokrapflanze"}),
    "Das musst Du schon selber austesten.",
    "brummt wissend: ");
  AddInfo(({"geheimnis","geheimnisse"}),
    "Hast Du etwas zu verbergen?",
    "knurrt: ");
  AddInfo(({"fuersprache"}),
    "Da bist Du bei mir an der falschen Adresse.",
    "knurrt: ");
  AddInfo(({"adresse"}),
    "ignoriert Dich.");
  AddInfo(({"urwesen","erdenurwesen","wasserurwesen"}),
    "Ostan kann Urwesen zu seiner Hilfe rufen.",
    "erzaehlt stolz: ");
  AddInfo(({"hilfe","plan","aufgabe","fuersprache","fuehrsprache",
            "empfehlung"}),
    "Wende Dich an unseren Anfuehrer.",
    "erzaehlt: ");
  AddInfo(({"patrouille"}),
    "Ist sie schon auf dem Weg hierher?",
    "fragt mit blitzenden Augen: ");
  AddInfo(({"waechter","diener"}),
    "Die Waechter und Diener sind hier irgendwo. Da man sie nicht sehen "
    "kann, weiss man leider nur nie wo.",
    "brummt: ");
  AddInfo(({"treppe","treppen"}),
    "Die Treppen sind schon irgendwie komisch - Aber man kommt hinauf, "
    "nur nicht so, wie man es erwarten wuerde.",
    "sagt: ");
  
}

void init()
{
  object ob;
  ::init();
  if (!objectp(PL)) return;
  if (QueryProp(P_ARCHON_ENDFIGHT)) return;
  if (!interactive(PL)) return;
  ob=(object)PL->QueryProp(P_LAST_COMMAND_ENV);
  if (!objectp(ob)) return;
  if (file_name((object)PL->QueryProp(P_LAST_COMMAND_ENV))==(ROOM "vorturm"))
  {
    call_out("begruessung",1,PL);
  }
}

void begruessung(object pl)
{
  int art,pos;
  string r;
  if (!objectp(pl)) return;
  if (environment(pl)!=environment(ME)) return;
  if (!interactive(pl)) return;
  r=lower_case((string)pl->QueryProp(P_RACE));
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(PL);
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  if (art==1)
  {
    if (pos<2)
     tell_room(environment(ME),break_string(
      "Suchst Du den Magier, "+PL->name(WER,1)+"?",78,
      "Joxa fragt: "));
    else
     tell_room(environment(ME),break_string(
      "Kommst Du voran, "+PL->name(WER,1)+"?",78,
      "Joxa fragt: "));
    return;
  }
  if ((r=="dunkelelf" && !PL->QueryProp(P_ELF_DISGUISE)) ||
      PL->QueryProp(P_DARKELF_DISGUISE))
  {
    tell_room(environment(ME),break_string(
      "Vorsicht Dunkelelf, ich habe Dich erspaeht.\n"
      "Du bist hier nicht willkommen! Tue nur eine falsche Bewegung, "
      "und ich, oder die anderen werden Dich angreifen. Wehe Dir, "
      "wenn Du hier bist um zu spionieren!",
      78,"Joxa ruft aus: ",BS_LEAVE_MY_LFS));
    return;
  }
  tell_room(environment(ME),break_string("Willkommen Fremder.\n"
    "Bist Du gekommen, um uns bei unserem Kampf gegen die Dunkelelfen zu "
    "helfen?",78,"Joxa gruesst: ",BS_LEAVE_MY_LFS));
}
