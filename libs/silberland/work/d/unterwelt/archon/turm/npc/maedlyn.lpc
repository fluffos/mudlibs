#include "../def.h"
inherit STD+"pali";

void create();
int Defend_Vorina(int dam,string *dam_type_liste,int spell,object enemy);

void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  SetProp(P_SHORT,"Paladin Maedlyn");
  SetProp(P_LONG,
    "Als Maedlyn merkt, dass Du sie betrachtest, strahlt sie Dich mit "
    "einem herzlichen Laecheln an. Eine Schoenheit wie sie, haettest "
    "Du eher auf einem Tanzfest, als in diesem Turm erwartet. "
    "Du kannst kaum glauben, dass dieses froehliche junge Maedchen eine "
    "durchtrainierte Paladinkaempferin ist.");

  AddDetail(({"laecheln"}),
    "Als Du sie und ihr Laecheln anschaust, kannst Du ein eigenes Laecheln "
    "nicht unterdruecken.");
  AddDetail(({"auge","augen"}),
    "Die Augen von Maedlyn strahlen Dich an.");
  AddDetail(({"schoenheit","maedchen"}),
    "Egal was Du sonst von ihr halten magst, schoen ist sie auf jeden Fall.");
        
  create_default_npc(32);

  SetProp(P_NAME,"Maedlyn");
  SetProp(P_ARTICLE,0);
  SetProp(P_GENDER, FEMALE); 
  SetProp(P_SIZE,154);
  SetProp(P_WEIGHT,46000);
  SetProp(P_MNPC_AREA,({ROOM "gang3_2",ROOM "gang3_3",ROOM "gang3_4",
                        ROOM "gang3_5"}));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS | MOV_MOVES | MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO,
    "laechelt Dich weiter an und zeigt auf ihren sich bewegenden aber "
    "lautlosen Mund. Anscheint ist Maedlyn stumm, aber dashalb ist sie "
    "nicht weniger huebsch.");
      
  AddId(({"maedlyn"}));
}

//da nicht auf maedlyn gezielt, weniger schaden ...
int Defend_Vorina(int dam,string *dam_type_liste,int spell,object enemy)
{
  return Defend(dam*3/4,dam_type_liste,spell,enemy);
}
