int wesen1,wesen2;
object w1,w2;
int im_gespraech;

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  P_ARCHON_NPCMASTER->add_npc(ME,3); 

  wesen1=1;
  wesen2=1;
  im_gespraech=0;

  SetProp(P_LOG_INFO,"archon/turm_magier.rep");

  SetProp(P_SHORT,"Ein alter Magier");
  SetProp(P_LONG,
    "Vor Dir steht ein alter Mann, doch seine Augen erstrahlen von einer "
    "inneren Energie. Die Macht, die der Magier besitzt, ist fuer Dich "
    "einfach unvorstellbar. Sein Wissen reicht weit zurueck. Du glaubst "
    "das er diesen Turm vor langer Zeit als junger Magier erschaffen hat. "
    "Damals wurde er noch Ostan gerufen, "
    "doch ist dies lange her und heute nennt ihn jeder nur noch Magier.");

  AddDetail(({"spruch","zauberspruch","sprueche","zaubersprueche"}),
    "Einige koennen bestimmt auf der Stelle toeten.");
  AddDetail(({"macht"}),
    "Du kannst sie Dir nicht einmal ansatzweise vorstellen.");
  AddDetail(({"auge","augen"}),
    "Wie sie strahlen ...");

  SetProp(P_NAME,"Magier");
  SetProp(P_GENDER,MALE);

  create_default_npc(40);
  SetProp(P_MAX_HP,1000);
  SetProp(P_HP,1000);
  SetProp(P_MAX_SP,3000);
  SetProp(P_SP,3000);
  SetProp(P_BODY,0);
  SetProp(P_SIZE,170);
  SetProp(P_WEIGHT,62000);

  SetProp(P_RACE,"Magier");
  SetProp(P_NOMAGIC,33);
  SetProp(P_NOCORPSE,1);
  SetProp(P_DIE_MSG," schnipst mit den Fingern und ist verschwunden.\n");
  SetProp(P_SPELLRATE,33);
  SetProp(P_NOCORPSE,1);


  AddSpell(40,380,"Der Magier wirft einen feurigen Pfeil nach Dir.\n",
          "Der Magier trifft @WEN mit einem feurigen Pfeil.\n",
          ({DT_MAGIC,DT_FIRE}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(35,440,"Der Magier wirft einen Feuerball nach Dir.\n",
          "Der Magier trifft @WEN mit einem Feuerball.\n",
          ({DT_MAGIC,DT_FIRE}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(25,560,"Der Magier wirft eine riesige Feuerkugel nach Dir.\n",
          "Der Magier trifft @WEN mit einer riesigen Feuerkugel.\n",
          ({DT_MAGIC,DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  SetProp(P_REJECT,({REJECT_GIVE,
    "Der Magier sagt: Das kannst Du bestimmt besser gebrauchen als ich!\n"}) );

  AddId(({"ostan","magier","monster","\nmagier"}));

  AddInfo(DEFAULT_INFO,
    "notiert sich Deine Frage und gibt sie an Archon weiter.");
  AddInfo(({"ostan"}),
    "Ein Name aus vergangenen Zeiten.",
    "erwidert: ");
  AddInfo(({"name","geburtsname"}),
    "Mein Geburtsname ist Ostan.",
    "erwidert: ");
  AddInfo(({"turm","magierturm"}),
    "Du bist mitten drinnen. Vor langer Zeit habe ich den Turm mit Hilfe "
    "meiner Magie errichtet.",
    "erwidert: ");
  AddInfo(({"waechter","diener","geister","dienerin"}),
    "Die magischen Waechter und Diener sind ueberall im Turm.",
    "erwidert: ");
  AddInfo(({"magie"}),
    "Magie, ich frage mich schon seit Jahrhunderten was das ist. Man kann sie lernen, "
    "doch weshalb sie ueberhaupt funktioniert kann selbst ich, ein Meister, nicht "
    "sagen. Sie gibt mir Macht. Sie verlaengert mein Leben unvorstellbar lange. "
    "Ich bediene mich ihrer laufend und sie zeigt mir staendig neue Wunder, ich "
    "erblicke durch sie Wunder, erlebe erstaunliches. Sie kann sogar Leben erschaffen. "
    "Doch was ist Magie nun? Ein Raetsel.",
    "erwidert: ");
  AddInfo(({"meister","erinnerungsvermoegen","weisheit","alter"}),
    "Ich bin ein Meister der Magie, doch mit dem Alter kommt nicht nur Weisheit, "
    "sondern auch oftmals ein schlechtes Erinnerungsvermoegen.",
    "seufzt: ");
  AddInfo(({"raetsel","wesen"}),
    "Solltest Du das Wesen der Magie je erfassen und mir erklaeren, werde "
    "ich Dich unermesslich belohnen.",
    "erwidert: ");
  AddInfo(({"belohnung"}),
    "Eine Belohnung wird sich bestimmt finden, solltest Du mir helfen oder sogar "
    "das Wesen der Magie erklaeren koennen.",
    "erwidert: ");
  AddInfo(({"jahrhunderten","jahrhunderte","jahre"}),
    "Sie ziehen vorbei und doch bemerke ich sie kaum.",
    "erwidert: ");
  AddInfo(({"wunder"}),
    "Es gibt so viele Wunder hier. Viele warten darauf von Dir bemerkt "
    "zu werden.",
    "erwidert: ");
  AddInfo(({"macht","spruch","sprueche","zauberspruch","zaubersprueche",
            "verfuegung"}),
    "Meine Macht ist immens. Mir stehen Sprueche zur Verfuegung, die sofort toeten, oder "
    "Leben einhauchen. Doch ich weiss nicht, in wie weit sie mir gegen die Dunkelelfen "
    "helfen wird. Frueher einmal konnte ich mich gegen sie behaupten, doch nun "
    "bin ich alt und nicht mehr ganz so maechtig in meiner Magie.",
    "erwidert: ");
  AddInfo(({"leben"}),
    "Erfreu Dich Deines Lebens.",
    "erwidert: ");
  AddInfo(({"brunnen","ort","hof","innenhof","brunnenhof"}),
    "Diesen Ort hier habe ich mir geschaffen. Doch nachdem ich vor den "
