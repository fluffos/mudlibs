void setchat()
{
  SetChats(2,({
       "Der Magier murmelt: Das ist ein guter Plan.\n",
       "Der Magier seufzt: Jemand muss uns helfen.\n",
       "Der Magier murmelt: Wir brauchen einen Freiwilligen.\n"}));
}

void init()
{
  ::init();
  if (!objectp(PL) || !interactive(PL)) return;
  if (QueryProp(P_ARCHON_ENDFIGHT)) return;
  call_out("begruessung",1,PL);
}

void begruessung(object pl)
{
  int pos,art;
  if (!pl || environment(ME)!=environment(pl)) return;
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(pl);
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(pl);
  if (art==1) 
  {
    if (pos==1)
     tell_room(environment(ME),break_string(
      pl->Name(WER,1)+" bist Du gekommen, um mir zu helfen?",78,
      "Der Magier fragt: "));
    else if (pos==5)
     tell_room(environment(ME),break_string(
      "Wolltest Du mir nicht sofort berichten, was Du herausgefunden hast, "
      +pl->Name(WER,1)+"?",78,"Der Magier fragt: "));
    else if (pos==8)
    { //Questkampf beginnt
      if (im_gespraech)
      {
      	tell_object(pl,break_string(
      	               "Der Magier ist gerade in ein Gespraech vertieft "
      	               "und hat Dich nicht mitbekommen, vielleicht solltest "
      	               "Du ihm von Deinem Fortschritt berichten?"));
        return;
      }
      quest_ende(pl);
      return;
    }
  }
  else if (art==2)
  {
    if (pos==3)
    {
      tell_room(environment(ME),break_string(
       "Der Magier schaut "+pl->name(WER,1)+" an und brummt vor "
       "sich hin: Vielleicht ... nicht sehr vertrauenswuerdig ... ."),({pl}));
      tell_object(pl,break_string(
       "Der Magier schaut Dich an, und brummt vor "
       "sich hin: Vielleicht ... nicht sehr vertrauenswuerdig ... ."));
     }
     else if (pos==4)
     {
      tell_room(environment(ME),break_string(
       pl->Name(WER,1)+" bist Du gekommen, um mir zu helfen?",78,
       "Der Magier fragt: "));
     }
     else if (pos==8)
     {
     	tell_room(environment(ME),break_string(
     	  "Der Magier flucht, als er "+pl->name(WEN,1)+" erspaeht."));
     	Kill(pl);
     }
  }
}

void reset()
{
  ::reset();
  if (!is_clone(ME)) return;
  wesen1=1;
  wesen2=1;
  finde_helfer();
  if (w1 && !w1->InFight()) 
  { 
    tell_room(environment(),"Das Erdenurwesen verschwindet.\n"); 
    w1->remove(1); 
  }
  if (w2 && !w2->InFight()) 
  { 
    tell_room(environment(),"Das Wasserurwesen verschwindet.\n"); 
    w2->remove(1); 
  }
}

string info_rune()
{
  int pos;
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  if (pos==6)
   return 
      "Du musst die Runen des Turmes so veraendern, dass sie mehr Widerstand "
      "gegenueber fremder Magie, besseren Schutz fuer den Turm bieten und "
      "vielleicht sogar aktiv gegen Angreifer vorgehen koennen. Eigne "
      "Dir hierzu Wissen ueber die Runenmagie an und setze dann Deine "
      "gewonnenen Erkenntnisse ein. Fuer diese Aufgabe benoetigst Du einen "
      "Runenstab. Ich habe einen in meinen Zimmer unter uns versteckt. "
      "Achja, es gibt genau neun Runen - jeweils vier sind in den unteren "
      "zwei Etagen in die Turmwand eingelassen und die letzte "
      "Rune findest Du in der Turmspitze.";
  return
    "Es gibt verschiedene Runen, doch hier im Turm sind Schutzrunen "
    "eingelassen. Als ich den Turm errichten lies wurden sie direkt "
    "in die Turmwaende integriert und schuetzen so den gesamten Turm. "
    "Kein Dunkelelf konnte jemals hier einbrechen, obwohl ihr Magie damals "
    "zum Schluss ihren Weg zur Turmspitze fand. Viele starben "
    "in dem Inferno und ich gab den Turm auf. Seit dem wir den Turm wieder "
    "bezogen haben, hatte ich keine Zeit diese Runen zu erneueren und "
    "zu verstaerken. Jetzt bin ich mir nicht sicher, ob sie der Magie "
    "der Dunkelelfenmagier und Dunkelelfenpriester noch standhalten "
    "koennen. Wenn Dich dieses Thema interessiert, kannst Du auch mal "
    "in der Bibliothek nachsehen.";
}

mixed info_runenstab()
{
  int pos;
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  if (pos>4) //in der quest
    return "sagt: Der Runenstab ist in meinen Zimmer versteckt.\n";
  return "brummt: Du brauchst zur Zeit nichts ueber den "
         "Runenstab zu wissen.\n";
}

void gespraech_gut(int pos,object pl)
{
  if (!objectp(pl) || environment(pl)!=environment(ME))
  {
    if (pl) pl->SetProp(P_PARALYZED,0);
    SetProp(P_NOATTACK,0);
    im_gespraech=0;
    setchat();
    return;
  }
  tell_room(environment(ME),"\n");
  switch(pos)
  {
    case 1:
     tell_room(environment(ME),break_string(
      "Doch noch wissen wir nicht, ob Lloth und ihre Dunkelelfen ueberhaupt "
      "schon von unserer Anwesenheit erfahren habe. "+pl->Name(WER,1)+", "
      "suche deshalb nach einer Dunkelelfenpatrouille und begib Dich zu "
      "den Dunkelelfenpriesterinnen und versuche ihre Absichten zu "
      "ergruenden. Komme danach zurueck und berichte mir was Du, "+
      pl->name(WER,1)+", herausgefunden hast.",
      78,"Der Magier erzaehlt weiter: "));
    break;
    case 2:
     tell_room(environment(ME),break_string(
      "Ach eins noch, "+pl->name(WER,1)+". Um ueberhaupt zu den "
      "Dunkelelfenpriesterinnen vordringen zu koennen, benoetigst "
      "Du einen speziellen Vertrauenszauber.",78,
      "Der Magier fuehrt noch aus: "));
     pl->SetProp(P_PARALYZED,0);
     SetProp(P_NOATTACK,0);
     im_gespraech=0;
     setchat();
     return;
    break;
  }
  call_out("gespraech_gut",15,++pos,pl);
}

void gespraech_boese(int pos,object pl)
{
  tell_room(environment(ME),break_string(
    "Kaum hat der Magier ausgeredet, redet "+pl->name(WER,1)+
    " wild mit den Armen gestikulierend auf ihn ein."),({pl}));
  tell_object(pl,break_string(
    "Kaum hat der Magier ausgeredet, berichtest Du wild mit "
    "Deinen Armen gestikulierend, von der Dunkelelfenpatrouille. "
    "Du erzaehlst dem Magier, dass diese den Auftrag bekommen "
    "hat den Turm zu zerstoeren."));
  call_out("berichten",15,1,pl); //das selbe wie die guten!
}

int helfen()
{
  int pos,art;
  string race;
  if (im_gespraech)
  {
    write("Lass den Magier doch ersteinmal aussprechen.\n");
    return 1;
  }

  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(PL);
  race=(string)PL->QueryProp(P_RACE);
  if (race=="Dunkelelf" || PL->QueryProp(P_DARKELF_DISGUISE)>time())
  {
    if (!PL->QueryProp(P_ELF_DISGUISE))
    {
      write(break_string("Der Magier schaut Dich von oben bis unten an. "
                         "Runzelt mit der Stirn."));
      tell_room(environment(ME),break_string(
        "Der Magier schaut "+PL->Name(WER,NAME_AUTO)+
        " von oben bis unten an und runzelt mit der Stirn."),({PL}));
      tell_room(environment(ME),break_string(
        "Ich glaube nicht, dass ich einem Dunkelelfen vertrauen kann.",
        78,"Der Magier brummt: "));
      return 1;
    }
  }
  if ((art==1 && pos>1) || pos>4)
  {
    write("Der Magier sagt: Aber Du hilfst mir doch schon.\n");
    return 1;
  }
  tell_room(environment(ME),break_string(
    PL->Name(WER,1)+" will dem Magier helfen."),({PL}));
  if (art==1 && pos==1)
  { //man ist an der richtigen stelle in der quest
    P_ARCHON_QUESTMASTER->advance_quest(PL); //1->2
    tell_room(environment(ME),"\n");
    tell_room(environment(ME),break_string(
      "Ich habe schon auf Dich gezaehlt "+PL->name(WER,1)+" und freue "
      "mich, dass Du zu einer guten Sache beitragen willst. Den Dunkelelfen "
      "und ihrer Goettin Lloth muss Einhalt geboten werden! Dann wird Lloth "
      "einsehen, dass sie diesen Turm nicht mit ihren Gefolgsleute "
      "einnehmen kann und das wir Ueberfaelle auf die Oberflaeche nicht "
      "dulden werden.",78,"Der Magier sagt: "));
    SetProp(P_NOATTACK,"unterhaelt sich gerade, wie unhoeflich von Dir.");
    PL->SetProp(P_PARALYZED,([
      PARALYZE_TIME:-1,
      PARALYZE_MSG:
       "Du konzentrierst Dich zu sehr auf das, was um Dich herum passiert.\n",
      PARALYZE_MSG_OTHER:break_string(
       PL->Name(WER,1)+" konzentriert sich zu sehr auf seine Umgebung."),
      PARALYZE_END:break_string("Du solltest Dich jetzt auf dem Weg "
        "machen und die Patrouille der Dunkelelfen finden."),
      PARALYZE_END_OTHER:"%s wird vom Magier aufgefordert, sich auf den Weg "
        "zu machen.\n" ]));
    im_gespraech=1;
    SetProp(P_CHATS,0);
    call_out("gespraech_gut",15,1,PL);
    return 1;
  }
  if (art==2 && pos==4)
  {
    P_ARCHON_QUESTMASTER->advance_quest(PL); //4->5
//fuer boese geht es gleich weiter, da nicht ausspionieren und im spinnenkerker landend
    P_ARCHON_QUESTMASTER->advance_quest(PL); //5->6
    tell_room(environment(ME),"\n");
    tell_room(environment(ME),break_string(
      "Ich habe schon vermutet, dass ich auf Dich zaehlen kann, "+
      PL->name(WER,1)+". Den Dunkelelfen und ihrer Goettin Lloth muss "
      "Einhalt geboten werden! Ich habe aber das unbestimmte Gefuehl, dass "
      "wir nur noch wenig Zeit fuer unserere Vorbereitungen haben. Ich hoffe, "
      "dass die Dunkelelfen uns noch nicht endeckt haben und sich somit noch "
      "nicht auf den Weg hierher gemacht haben.",78,"Der Magier sagt: "));
    SetProp(P_NOATTACK,"unterhaelt sich gerade, wie unhoeflich von Dir.");
    PL->SetProp(P_PARALYZED,([
      PARALYZE_TIME:-1,
      PARALYZE_MSG:
       "Du konzentrierst Dich zu sehr auf das, was um Dich herum passiert.\n",
      PARALYZE_MSG_OTHER:break_string(
       PL->Name(WER,1)+" konzentriert sich zu sehr auf seine Umgebung."),
      PARALYZE_END:break_string("Du musst Dich beeilen um so den Turm und "
        "uns zu retten."),
      PARALYZE_END_OTHER:"%s wird vom Magier aufgefordert, sich zu beeilen.\n" ]));
    im_gespraech=1;
    SetProp(P_CHATS,0);
    call_out("gespraech_boese",15,1,PL);
    return 1;
  }
  write(break_string("Der Magier schaut Dich von oben bis unten an. "
                     "Runzelt mit der Stirn."));
  tell_room(environment(ME),break_string("Der Magier schaut "
    +PL->Name(WER,NAME_AUTO)+" von oben bis unten an und runzelt mit "
    "der Stirn."),({PL}));
  if (art==2 && pos==3)
  {
    tell_room(environment(ME),break_string(
      "Ich glaube nicht, dass Du fuer die Mission geeignet bist. Irgendetwas "
      "sagt mir, dass ich Dir nicht vertrauen sollte.",
      78,"Der Magier brummt: "));
    write(break_string("Du denkst bei Dir, vielleicht sollte ich "
      "zurueck zu Caroll gehen, und mit ihm ueber 'Vertrauen' reden ..."));
  }
  else
   tell_room(environment(ME),break_string(
    "Ich glaube nicht, dass Du der Mission gewachsen bist. Du koenntest "
    "leicht getoetet werden, was ich unmoeglich verantworten kann. Ohne "
    "geeignete Fuersprache kann ich Deine Hilfe nicht annehmen.",
    78,"Der Magier brummt: "));
  return 1;
}

int cmd_helfen2(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "hilfe",
       "Was willst Du anbieten?"))
    return 0;
  return helfen();
}

int cmd_helfen(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "magier",
       "Wem willst Du helfen?"))
    return 0;
  return helfen();
}

void berichten(int pos,object pl)
{
  tell_room(environment(ME),"\n");
  switch(pos)
  {
    case 1:
     tell_room(environment(ME),break_string(
      "Das ganze ist ja viel schlimmer als ich erwartet habe, "+
      pl->name(WER,1)+". Nun muessen "
      "wir schnell handeln. Die Dunkelelfenpriesterinnen und Lloth werden "
      "diesmal bestimmt etwas ersonnen haben, um gegen den Schutz, ueber den "
      "der Turm verfuegt, vorzugehen. Er muss also verbessert werden! Leider "
      "kann ich mich nicht persoenlich darum kuemmern, da ich unverzueglich "
      "einen neuen Zauber erschaffen muss, mit dem wir die Dunkelelfen "
      "vernichten koennen. Nur so kann Lloth in ihre Schranken gewiesen "
      "werden.",78,"Der Magier brummt: "));
    break;
    case 2:
     tell_room(environment(ME),break_string(
      "Hoer gut zu "+pl->name(WER,1)+" Du musst nun folgendes machen.",
      78,"Der Magier sagt: "));
     tell_room(environment(ME),break_string(
      "Danach fluestert der Magier leise mit "+pl->name(WEN,1)+"."),({pl}));
     tell_object(pl,break_string(
      "Du musst die Runen des Turmes so veraendern, dass sie mehr Widerstand "
      "gegenueber fremder Magie, besseren Schutz fuer den Turm bieten und "
      "vielleicht sogar aktiv gegen Angreifer vorgehen koennen. Eigne "
      "Dir hierzu Wissen ueber die Runenmagie an und setze dann Deine "
      "gewonnenen Erkenntnisse ein. Fuer diese Aufgabe benoetigst Du einen "
      "Runenstab. Ich habe einen in meinen Zimmer unter uns versteckt. "
      "Achja, es gibt genau neun Runen - jeweils vier sind in den unteren "
      "zwei Etagen in die Turmwand eingelassen und die letzte "
      "Rune findest Du in der Turmspitze.",78,
      "Der Magier fluestert: "));
    break;
    default:
     tell_room(environment(ME),break_string(
      "Diese Heimlichkeiten gehen Dir langsam auf den Keks! Was haben die "
      "beiden denn nur zu fluestern?"),({pl}));
     tell_object(pl,break_string(
      "Doch leider ist mir bei meinem letzten Experiment eine Zehe der "
      "Drachenklaue im Labor abgebrochen. Du musst sie erst finden und dann "
      "den Stab reparieren und wieder aufladen, bevor Du ihn zu Deinen "
      "Zwecken nutzen kannst.",78,"Der Magier fluestert: "));
     pl->SetProp(P_PARALYZED,0);
     im_gespraech=0;
     setchat();
     return;
    break;
  }
  call_out("berichten",15,++pos,pl);
}

int cmd_berichte(string str)
{
  int pos,art;
  if (!S_STANDARD->check_cmd(str,
    "magier|ostan",
    "Wem willst Du Bericht erstatten?"))
  return 0;
  
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(PL);
  
  if (im_gespraech)
  {
    write("Lass den Magier doch ersteinmal aussprechen.\n");
    return 1;
  }

  if (art==1 && pos==8)
  {
    quest_ende(PL);
    return 1;
  }

  if (art==2 || pos!=5)
    return notify_fail(
      "Der Magier sagt: Aber Du hast mir doch gar nichts zu berichten.\n"),0;

  P_ARCHON_QUESTMASTER->advance_quest(PL); //5->6
  tell_room(environment(ME),"\n");
  tell_room(environment(ME),break_string(
    PL->Name(WER,1)+" berichtet dem Magier, was "+PL->QueryPronoun(WER)+
    " herausgefunden hat."),({PL}));
  write(break_string(
    "Schnell berichtest Du dem Magier, was Du erfahren hast, wie Du "
    "gefangen wurdest und gluecklich entkommen bist. Du glaubst, dass "
    "die Dunkelelfen jederzeit hier eintreffen koennen und den Turm "
    "angreifen werden."));
  SetProp(P_NOATTACK,"unterhaelt sich gerade, wie unhoeflich von Dir.");
  PL->SetProp(P_PARALYZED,([
      PARALYZE_TIME:-1,
      PARALYZE_MSG:
       "Du konzentrierst Dich zu sehr auf das, was um Dich herum passiert.\n",
      PARALYZE_MSG_OTHER:break_string(
       PL->Name(WER,1)+" konzentriert sich zu sehr auf seine Umgebung."),
      PARALYZE_END:break_string("Der Magier brummt: Und nun spute Dich, "
        "bevor die Dunkelelfen hier eintreffen."),
      PARALYZE_END_OTHER:"%s wird vom Magier aufgefordert, sich zu "
        "beeilen.\n" ]));
  im_gespraech=1;
  SetProp(P_CHATS,0);
  call_out("berichten",15,1,PL);
  return 1;
}

void finde_helfer()
{
  if (!w1) w1=S_STANDARD->present_clone(NPC "erdenurwesen",environment(ME));
  if (!w2) w2=S_STANDARD->present_clone(NPC "wasserurwesen",environment(ME));
}

public void setze(int was,int zu)
{
  if (!zu)
  {
    finde_helfer();
    switch(was)
    {
      case 1: if (w1) 
              { 
              	tell_room(environment(ME),"Das Erdenurwesen schreit auf als "
                          "sein Zugang versperrt wird und vergeht.\n"); 
                w1->remove(1); 
              } 
      break;
      case 2: if (w2) 
              { 
              	tell_room(environment(ME),"Das Wasserurwesen schreit auf als "
              	          "sein Zugang versperrt wird und vergeht.\n"); 
              	w2->remove(1); 
              } 
      break;
    }
  }
  switch(was)
  {
    case 1: wesen1=zu; break;
    case 2: wesen2=zu; break;
  }
}

int Defend(int dam, string *dam_type_liste, int spell, object enemy)
{
  object raum;
  if (spell) dam/=2;
  if (QueryProp(P_ARCHON_ENDFIGHT))
    return ::Defend(2*dam/3+random(dam/3), dam_type_liste, spell, enemy);
  if (!w1 && wesen1)
  {
    wesen1=0;
    raum=environment(ME);
    if (objectp(raum) && !raum->get_platte())
    {
      w1=clone_object(NPC "erdenurwesen");
      w1->move(environment(ME),M_NOCHECK|M_SILENT);
      tell_room(environment(ME),
        "Der Magier teilt das Moos und daraus steigt ein Erdenurwesen "
        "hervor.\n");
    }
    else
      tell_room(environment(ME),"Der Magier flucht.\n");
  }
  if (objectp(w1))
  {
    tell_object(enemy,"Das Erdenurwesen faengt Deinen Angriff ab.\n");
    return w1->Defend(dam,dam_type_liste,spell,enemy);
  }
  if (!w2 && wesen2)
  {
    wesen2=0;
    raum=environment(ME);
    if (objectp(raum) && !raum->get_loch())
    {
      w2=clone_object(NPC "wasserurwesen");
      w2->move(environment(ME),M_NOCHECK|M_SILENT);
      tell_room(environment(ME),
        "Der Magier laesst ein Wasserurwesen aus der Ulme fliessen.\n");
    }
    else
      tell_room(environment(ME),"Der Magier flucht fuerchterlich.\n");
  }
  if (objectp(w2))
  {
    tell_object(enemy,"Das Wasserurwesen faengt Deinen Angriff ab.\n");
    return w2->Defend(dam,dam_type_liste,spell,enemy);
  }
  return ::Defend(2*dam/3+random(dam/3), dam_type_liste, spell, enemy);
}

void entfernen()
{
  object ob;
  ob=present("stab",ME);
  if (objectp(ob)) ob->remove();
  ob=present("robe",ME);
  if (objectp(ob)) ob->remove();
}

void die(int poisondeath,object enemy)
{
//  entfernen(); -> remove
  write_file(LOG "magier_tode.log",CAP(getuid(PL))+
    " hat den Magier besiegt.  "+ctime(time())+"\n");
  catch(entfernen()); //keinen stab hinterlassen - etc.
  return ::die(poisondeath,enemy); 
}

int remove(int s)
{
  catch(entfernen()); //keinen stab hinterlassen - etc.
  ::remove(s);
}

int goto_endfight(int wie)
{
  mixed enemy;
  int i;

  SetProp(P_MNPC_FLAGS,0); //kein wegrennen mehr
//  SetProp(P_INFOS,0); //wir reden auch nicht mehr
  SetProp(P_ARCHON_ENDFIGHT,1); //damit wir wissen, wir sind im endkampf
  enemy=QueryEnemies()[0]; //nicht mehr weiter kaempfen
  if (pointerp(enemy))
  {
    for (i=sizeof(enemy);i--;)
    {
      if (objectp(enemy[i]))
      {
        enemy[i]->StopHuntFor(ME,1);
        ME->StopHuntFor(enemy[i],1);
      }
    }
  }
  if (wie==1)
  { //guter endkampf
   if (environment(ME))
    tell_room(environment(ME),break_string(
      "Ploetzlich kommt "+name(WEN,1)+" zu Bewusstsein, dass der Turm "
      "angegriffen wird. "+capitalize(QueryPronoun(WER))+" begibt sich "
      "sofort zum Eingang, um diesen zu verteidigen."));
   SetProp(P_HP,QueryProp(P_MAX_HP));
   SetProp(P_SP,QueryProp(P_MAX_SP));
  }
  else
  {
   if (environment(ME))
    tell_room(environment(ME),break_string(
      "Ploetzlich wird "+name(WEN,1)+" von fremdartiger Magie angegriffen "
      "und schreit vor Schmerz auf. Anscheint wird der Turm attaktiert "
      "und die Angreifer versuchen die Verteidiger zu vernichten. "
      "Kaum laesst der Angriff nach, rennt "+name(WER,1)+" auch schon "
      "los, um dem Angriff entgegen zu treten."));
   SetProp(P_HP,QueryProp(P_MAX_HP)/10);
   SetProp(P_SP,QueryProp(P_MAX_SP)/10);
  }
  move(ROOM "vorturm",M_GO);
  enemy=present("DUNKELELFNPC",environment(ME));
  if (objectp(enemy)) ME->Kill(enemy);
  return 1;
}

void quest_ende(object pl)
{
 P_ARCHON_QUESTMASTER->advance_quest(pl); //8->9
 SetProp(P_NOATTACK,"unterhaelt sich gerade, wie unhoeflich von Dir.");
 im_gespraech=1;
 pl->SetProp(P_PARALYZED,([
   PARALYZE_TIME:-1,
   PARALYZE_MSG:
     "Du konzentrierst Dich zu sehr auf das, was um Dich herum passiert.\n",
   PARALYZE_MSG_OTHER:break_string(
     PL->Name(WER,1)+" konzentriert sich zu sehr auf seine Umgebung."),
   PARALYZE_END:break_string(
     "Da Du Dir nichts entgehen lassen willst, rennst "
     "Du schnell zur Hoehle, in der der Turm steht."),
   PARALYZE_END_OTHER:"%s hat es ploetzlich eilig.\n" ]));
 tell_object(pl,break_string(
   "Kaum hast Du den Raum betreten, berichtest Du dem Magier, "
   "von Deinen Fortschritten. Der Magier nickt zufrieden und "
   "brummt: Nun koennen sie kommen."));
 tell_room(environment(ME),break_string(
   "Kaum hat "+pl->Name(WER,1)+" den Raum betreten, fluestert "
   +pl->QueryPronoun(WER)+" mit dem Magier, woraufhin dieser "
   "zufrieden nickt und brummt: Nun koennen sie kommen."),({pl}));
 tell_object(pl,break_string(
   "Kaum hat er dies gesagt, liegt ploetzlich Spannung in der "
   "Luft."));
 P_ARCHON_QUESTMASTER->endkampf(pl,1,1,0,0);
 finish_endfight();
}

void finish_endfight()
{
  move(ROOM "destruct_room",M_GO,"","verschwindet","erscheint");
  remove(1);
}

