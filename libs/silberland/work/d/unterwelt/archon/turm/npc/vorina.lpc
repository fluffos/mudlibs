// INFO weitere properties werden in der STD waldlaeufer gesetzt
// 26.04.2003 erstellt (Archon)
/*
 Rev 1.0 26.04.2003 Archon: erstellt
*/

#pragma strict_types
#include "../def.h"
inherit STD+"waldlaeufer";

string detail_augen();
void weiter();
int Defend(int dam,string *dam_type_liste,int spell,object enemy);
void Attack(object e);

int weg;

void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  SetProp(P_LOG_INFO,"archon/turm_vorina.rep");
  SetProp(P_SHORT,"Vorina, die Waldlaeuferin");
  SetProp(P_LONG,
    "Vorina schaut Dich mit einem fanatischen Blick aus ihren Augen "
    "an. Dieser Blick sagt Dir alles, was Du ueber sie wissen musst. "
    "Ohne Ruecksicht wird sie ihr Ziel, den Schutz der guten "
    "Rassen verfolgen und dabei alle Lebewesen toeten, welchen "
    "den Pfad der Tugend, wie sie es nennt, verlassen haben.");
  
  AddDetail(({"auge","augen","blick"}),#'detail_augen);

  SetProp(P_NAME,"Vorina");
  SetProp(P_GENDER,FEMALE);   
  SetProp(P_ARTICLE,0);
  SetProp(P_SIZE,218);
  SetProp(P_WEIGHT,92000);
  SetProp(P_MNPC_AREA,({ROOM "gang2_"}));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS | MOV_MOVES | MOV_BACKWARDS | 
                        MOV_INFIGHT | MOV_MAYLOAD);

  AddId(({"vorina","waldlaeuferin", "Messerexperte"}));

  create_default_npc(34);

  SetProp(P_ALIGN,950);

  clone_object(P_DIR_WEAPON "knife/jagdmesser")->move(ME,M_NOCHECK);
  call_out("command_me",1,"zuecke messer");

  AddLibrary(LIB "info.lib",1);

  AddInfo(DEFAULT_INFO,
    "predigt: 'Nur das Gute darf ueberleben.'");
}

string detail_augen()
{
  int a;
  a=(int)PL->QueryProp(P_ALIGN);
  if (a>500) 
    return "Vorina schaut Dich wohlwollend an.\n";
  if (a>0)
    return "Vorina schaut Dich kritisch an.\n";
  return "Vorina schaut Dich boese an.\n";
}

void weiter()
{
  weg=1;
}

int Defend(int dam,string *dam_type_liste,int spell,object enemy)
{
  mixed maedlyn;
  if (find_call_out("weiter")==-1) call_out("weiter",1);
  maedlyn=(mixed)S_STANDARD->present_clone(NPC "maedlyn",ME);
  if (objectp(maedlyn))
  {
    tell_room(environment(ME),
      "Maedlyn stellt sich schuetzend vor Vorina.\n");
    return (int)maedlyn->Defend_Vorina(dam,dam_type_liste,spell,enemy);
  }
  return ::Defend(dam,dam_type_liste,spell,enemy);
}

void Attack(object e)
{
  object *feinde;
  mixed *enemy;
  int i;
  
  if (weg)
  {
    command_me("zuecke bogen");
    weg=0;
    feinde=({});
    enemy=(mixed)ME->QueryEnemies();
    if (pointerp(enemy[0]))
    {
      for (i=0;i<sizeof(enemy[0]);i++) 
      {
        if (objectp(enemy[0][i]) && present(enemy[0][i],environment(ME))) 
          feinde+=({enemy[0][i]});
      }
    }
//im endkampf nicht wegrennen, sollte eigentlich nicht notwendig sein,
//da schon P_MNPC_FLAGS==0 ist, aber sicher ist sicher
     if (!QueryProp(P_ARCHON_ENDFIGHT))
      wandern();
    for (i=sizeof(feinde);i--;)
    {
      tell_object(feinde[i],"Ein Pfeil rast auf Dich zu.\n");
      tell_room(environment(feinde[i]),break_string(
        "Ein Pfeil rast auf "+feinde[i]->name(WER,NAME_AUTO)+" zu."),
        ({feinde[i]}));
      feinde[i]->Defend(350,({DT_PIERCE}),0,ME);
    }    
    command_me("zuecke messer");
    return;
  }
  ::Attack(e);
}

