#include "../def.h"
inherit STD+"pali";

int ein_angriff;

void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  SetProp(P_LOG_INFO,"archon/turm_culromex.rep");
  SetProp(P_SHORT,"Paladin Culromex");
  SetProp(P_LONG,
    "Culromex bruetet, in duesteren Gedanken versunken, vor sich hin. "
    "Irgendetwas scheint ihm nicht zu passen. Soweit wie Du die Lage "
    "einschaetzen kannst, will er lieber die Dunkelelfen angreifen, "
    "als hier auf sie zu warten.");
        
  create_default_npc(33);

  SetProp(P_NAME,"Culromex");
  SetProp(P_ARTICLE,0);
  SetProp(P_GENDER, MALE); 
  SetProp(P_SIZE,184);
  SetProp(P_WEIGHT,86000);
  SetProp(P_MNPC_AREA,({ROOM "gang2_"}));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS | MOV_MOVES | MOV_BACKWARDS);

  AddLibrary(LIB "info.lib",1);

  AddInfo(DEFAULT_INFO,"ignoriert Dich.");
      
  AddId(({"culromex"}));
}

//Culromex soll je kampfrunde nur einmal angegriffen werden
//schutz gegen angriff von mehreren spielern/npc's
int Defend(int dam,string *dam_type_liste,int spell,object enemy)
{
  int ret;
  if (ein_angriff) 
  {
    ein_angriff=0;
    return ::Defend(dam,dam_type_liste,spell,enemy);
  }
  tell_room(environment(ME),"Culromex weicht dem Angriff geschickt aus.\n");
  return ::Defend(0,dam_type_liste,spell,enemy);
}

void Attack(object e)
{
  ein_angriff=1;
  ::Attack(e);
}
