#include "../def.h"
inherit STD+"pali";

void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  SetProp(P_LOG_INFO,"archon/turm_prasamaccus.rep");
  SetProp(P_SHORT,"Paladin Prasamaccus");

  AddDetail(({"bart"}),
    "Der graue Bart ist spitz zugeschnitten.");
  AddDetail(({"haar","aussehen"}),
    "Prasamaccus traegt sein graues Haar mit Wuerde. Trotz seinem "
    "Alter solltest Du ihn aber nicht unterschaetzen.");
  AddDetail(({"alter"}),
    "Prasamaccus ist schon etwas aelter, aber noch immer ein teuflisch "
    "guter Kaempfer.");
  AddDetail(({"kaempfer","meister"}),
    "Du solltest Prasamaccus nicht unterschaetzen.");
    
  create_default_npc(37);

  SetProp(P_NAME,"Prasamaccus");
  SetProp(P_ARTICLE,0);
  SetProp(P_GENDER, MALE); 
  SetProp(P_SIZE,185);
  SetProp(P_WEIGHT,101000);

  AddInfo(({"gestank","verwesungsgestank","geruch"}),
    "Wer weiss, was dort unten im Labor hausst.",
    "brummt: ");

  AddLibrary(LIB "info.lib",1);

  AddInfo(DEFAULT_INFO,"schaut gebannt auf die Treppe und registriert Deine "
                       "Frage nicht.");
      
  AddId(({"prasamaccus"}));
}

string _query_long()
{
  if (InFight())
   return break_string(
    "Prasamaccus ist ein schon etwas betagter Paladin. Sein graues Haar "
    "und spitzer Bart verleiht ihm ein ehrwuerdiges Aussehen. Doch Du "
    "solltest ihn nicht unterschaetzen, denn im Kampf ist er noch immer "
    "ein Meister. Zur Zeit ist Prasamaccus in einen Kampf verwickelt.");
  return break_string(
    "Prasamaccus ist ein schon etwas betagter Paladin. Sein graues Haar "
    "und spitzer Bart verleiht ihm ein ehrwuerdiges Aussehen. Doch Du "
    "solltest ihn nicht unterschaetzen, denn im Kampf ist er noch immer "
    "ein Meister. Zur Zeit beobachtet Prasamaccus ganz aufmerksam die "
    "Treppe.");
}

void Attack(object enemy)
{
//im endkampf nicht, da der ja wo anders stattfindet
  if (!QueryProp(P_ARCHON_ENDFIGHT) && !random(5))
  {
    tell_room(environment(enemy),break_string(
      Name(WER,NAME_AUTO)+" tritt "+enemy->name(WER,NAME_AUTO)+
      " schwer, wodurch "+enemy->name(WER,NAME_AUTO)+" die Treppe hinab "
      "stuerzt."),({enemy}));
    tell_object(enemy,break_string(Name(WER,NAME_AUTO)+" tritt Dich schwer, "
      "wodurch Du die Treppe hinab stuerzt."));
    enemy->AddHP(-(random(10)+5)); //der tritt
    enemy->move(ROOM "labor",M_GO|M_SILENT);
    tell_room(environment(enemy),enemy->Name(WER,NAME_AUTO)+
                                 " purzelt die Treppe herab.\n",({enemy}));
    enemy->AddHP(-10); //der sturz
    return;
  }
  ::Attack(enemy);
}
