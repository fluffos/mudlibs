#pragma strict_types
#include "../def.h"
inherit STD+"waldlaeufer";

void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  SetProp(P_LOG_INFO,"archon/turm_falkenhand.rep");
  SetProp(P_SHORT,"Taube, die Waldlaeuferin");
  SetProp(P_LONG,
    "Die Waldlaeuferin Taube Falkenhand hat dickes braunes Haar. Sie schaut "
    "Dich mit belustigten aber alles erfassenden Augen an und laechelt dabei. "
    "Doch schon ist ihr Blick weiter gewandert und haelt nach moeglichen "
    "Gefahren ausschau, immer bereit, ihren Bogen blitzschnell zu spannen.");

  AddDetail(({"haar"}),
    "Taube hat langes braunes Haar, durch welches sie ab und an mit der "
    "einen Hand faehrt. Durch diese Bewegung hat sie es schon in Unordnung gebracht.");
  AddDetail(({"hand"}),
    "Ihre Hand haelt einen Bogen.");
  AddDetail(({"blick"}),
    "Er sucht immer und ueberall nach Gefahren.");

  SetProp(P_NAME,"Taube");   
  SetProp(P_GENDER,FEMALE);   
  SetProp(P_ARTICLE,0);
  SetProp(P_SIZE,178);
  SetProp(P_WEIGHT,71000);

  AddId(({"taube","falkenhand","waldlaeuferin"}));

  create_default_npc(35);

  SetProp(P_ALIGN,500);

  AddLibrary(LIB "info.lib",1);

  AddInfo(DEFAULT_INFO,
    "sagt freundlich: 'Sprich lieber mit unserem Anfuehrer.', um "
    "dann gleich wieder nach Gefahren ausschau zu halten.");
  AddInfo(({"lichtung","voegl","wald"}),
    "Ist es nicht schoen hier?",
    "laechelt und fragt: ");
  AddInfo(({"bogen","ziel"}),
    "Mit meinen Bogen treffe ich jedes Ziel.",
    "sagt stolz: ");

}
