#include "../def.h"
inherit STD+"pali";

void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  SetProp(P_LOG_INFO,"archon/turm_zinja.rep");
  SetProp(P_SHORT,"Paladin Zinja");
  SetProp(P_LONG,
    "Zinja ist eine junge, sehr mutige Kaempferin. Schon immer setzte sie "
    "sich fuer das Gute ein. Als Osti, wie sie den alten Magier liebevoll "
    "nennt, sie fragte, ob sie mit in die Unterwelt kommen will, stimmte sie "
    "sofort zu. Trotz ihrer Jugend ist sie eine maechtige Gegnerin. Du "
    "solltest sie Dir nicht zum Feind machen.");

  SetProp(P_NAME,"Zinja");
  SetProp(P_ARTICLE,0);
  SetProp(P_GENDER, FEMALE); 
  SetProp(P_SIZE,165);
  SetProp(P_WEIGHT,64000);

  AddId(({"zinja"})); 

  AddLibrary(LIB "info.lib",1);

}
