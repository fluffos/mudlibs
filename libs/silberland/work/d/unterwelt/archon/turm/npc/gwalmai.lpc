// INFO weitere properties werden in der STD waldlaeufer gesetzt
// 26.04.2003 erstellt (Archon)
/*
 Rev 1.0 26.04.2003 Archon: erstellt
*/

#pragma strict_types
#include "../def.h"
inherit STD+"waldlaeufer";

void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  SetProp(P_LOG_INFO,"archon/turm_gwalmai.rep");
  SetProp(P_SHORT,"Gwalmai, der erfahrene Waldlaeufer");
  SetProp(P_LONG,
    "Gwalmai hat in seinem Leben schon viele Kaempfe und das rauhe "
    "Leben im Dschungel des Silberlandes ueberstanden. Jetzt hat er "
    "sich dem Kampf gegen die Dunkelelfen verschworen und haelt hier "
    "oben nach ihnen Ausschau. Sollte eine Patrouille der Dunkelelfen "
    "in die Hoehle eindringen, wird er sie sofort erspaehen. "
    "Gwalmai bewegt sich unglaublich schnell.");

  SetProp(P_NAME,"Gwalmai");
  SetProp(P_GENDER,MALE);   
  SetProp(P_ARTICLE,0);
  SetProp(P_SIZE,208);
  SetProp(P_WEIGHT,97000);
  SetProp(P_MNPC_AREA,({ROOM "gang3_2",ROOM "gang3_3",ROOM "gang3_4",
                        ROOM "gang3_5"}));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS | MOV_MOVES | MOV_BACKWARDS);

  AddId(({"gwalmai"}));

  create_default_npc(32);

  SetProp(P_ALIGN,600);

  AddLibrary(LIB "info.lib",1);

  AddInfo(DEFAULT_INFO,
    "schaut Dich kurz an und sagt freundlich: "
    "'Leider habe ich keine Zeit zum Plauschen, da ich den Eingang der "
    "Hoehle von hier oben im Auge behalten muss.");
}

//er bewegt sich unglaublich schnell -> siehe long
void heart_beat()
{
  ::heart_beat();
  ::heart_beat();
}
