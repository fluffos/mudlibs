#include "../def.h"
inherit STD "my_good_npc";

void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  SetProp(P_SHORT,"Ein unsichtbarer Waechter");
  SetProp(P_LONG,"Ein unsichtbarer Waechter");
  
  create_default_npc(43);

  SetProp(P_RACE,"Demon");
  AddClass(CL_FLYING);
  AddClass(CL_DEMON);
  SetProp(P_ALIGN,0);
  SetProp(P_TURMDEFENDER,1);
  SetProp(P_NAME,"Turmwaechter");
  SetProp(P_GENDER,MALE);
  
  SetProp(P_HANDS, ({" mit kalten Haenden", 550, ({DT_COLD}) }));

  SetProp(P_MSGIN,"schwebt herein");
  SetProp(P_MSGOUT,"schwebt weiter");
  SetProp(P_MMSGIN,QueryProp(P_MSGIN));
  SetProp(P_MMSGOUT,QueryProp(P_MSGOUT));

  SetProp(P_MNPC_AREA, ({ROOM "gang1_"}));
  SetProp(P_MNPC_WAIT, ({ 1, 20, 30 }));  
  SetProp(P_MNPC_DEFAULTROOM, ENV(TO));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS | MOV_MOVES | MOV_BACKWARDS);
  
  seteuid(getuid(ME));

  if (random(2))
  {
    clone_object(WEAPON "kaelteschwert")->move(ME,M_NOCHECK);
    command_me("zuecke alles");
  }
  
  AddId(({"waechter","Schwertmeister"}));
}

string _query_short() { return 0; }
string _query_long() { return 0; }

//bewegung immer lautlos (da ja unsichtbar)
varargs int move(mixed dest, int methods, string direction, string textout,string textin)
{
  int ret;
  ret= ::move(dest,methods|M_SILENT,direction,textout,textin);
  if (environment(ME))
    tell_room(environment(ME),"Du bemerkst einen kalten Hauch.\n");
  return ret;
}
