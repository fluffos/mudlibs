#include "../def.h"
#include <npcmaster.h>
inherit "std/npc";

void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  SetProp(P_SHORT,"Ein boeser Erdenwaechter");
  SetProp(P_LONG,
    "Ein grosser sehr breiter Waechter der Erde erhebt sich vor Dir "
    "und schaut Dich neugierig mit seinen smaragdtartigen Augen an.");
  
  create_default_npc(99);
  
  SetProp(P_NOATTACK,"Der Erdenwaechter ist fuer Dich unangreifbar.\n");

  SetProp(P_NAME,"Erdenwaechter"); 
  SetProp(P_GENDER, NEUTER); 
  SetProp(P_RACE,"Magisch");
  SetProp(P_SIZE,330);
  SetProp(P_WEIGHT,300000);
  SetProp(P_NO_SCORE,1);
  SetProp(P_ADJECTIVES,({"boese","boeser","boesen","boesem"}));
  SetProp(P_NAME_ADJ, "boes");

  SetProp(P_MAX_HP,2000);
  SetProp(P_HP,2000);
  
  AddId(({"erdenwaechter","erdwaechter","waechter"})); 
}
