inherit "std/weapon";
#include "../def.h"

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT,"Ein Krummschwert");
  SetProp(P_LONG, 
    "Das Krummschwert ist eine fein ausbalancierte edle Waffe. "
    "Hergestellt fuer Dunkelelfen ist er besonders leicht, aber "
    "Die geschwungene Klinge glitzert schwarz und ist unheimlich "
    "scharf. Ein Klingenmeister ist mit dieser Waffe annaehernd "
    "unbesiegbar.");
  
  AddDetail(({"klingenmeister","meister"}),
    "Du bist leider keiner.");
  AddDetail(({"dunkelelfen"}),
    "Diese Waffe wurde fuer Dunkelelfen erschaffen.");
  AddDetail(({"klinge"}),
    "Die Klinge ist leicht geschwungen und besonders scharf.");

  SetProp(P_NAME,"Krummschwert");
  SetProp(P_GENDER,NEUTER);
  AddId(({"krummschwert","schwert","waffe"}));

  SetProp(P_WEAPON_TYPE,WT_SWORD);
  SetProp(P_WC,145);
  SetProp(P_WC_BONUS,
    (["Schwertkaempfer":50, "Schwertexperte":150, "Schwertmeister":250]));
  SetProp(P_DAM_TYPE,DT_SLASH);
  SetProp(P_NR_HANDS,1);
  SetProp(P_MATERIAL,([MAT_STEEL:90, MAT_BRASS:10]));
  SetProp(P_WEIGHT,1700);
  SetProp(P_VALUE,1800);
  SetProp(P_SIZE,90);
  SetProp(P_WIELD_RESTRICTIONS,([A_DEX:10,A_STR:10]));

  SetProp(P_HIT_FUNC,ME);
}

int HitFunc(object enemy)
{
  object w;
  w=QueryProp(P_WIELDED);
  if (w && w->is_class_member(CL_DARKELF)) 
    return random(16);
  return 0;
}
