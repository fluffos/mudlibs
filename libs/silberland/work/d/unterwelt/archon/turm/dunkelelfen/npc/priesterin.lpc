#pragma strict_types
#include "../def.h"
inherit STD "dunkelelf";

int laeuft;
void create();
int helfen();
int cmd_helfen(string str);
int cmd_helfen2(string str);
void show_anrufung(int pos,int art,object pl);
void bericht_abliefern(object pl);
void quest_ende();
void init();

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  laeuft=0;
  SetProp(P_LOG_INFO,"archon/delfen_priesterin.rep");
  P_ARCHON_NPCMASTER->add_npc(ME,4); //priesterin

  SetProp(P_SHORT,"Eine Dunkelelfenpriesterin");
  SetProp(P_LONG,
    "Die rot leuchtenden Augen der Dunkelelfenpriesterin sind streitlustig "
    "auf Dich gerichtet. Solltest Du ihr Missfallen erregen, wird sie ohne "
    "zoegern Dich angreifen und mit vergnuegen Lloth opfern. In ihrer "
    "Weltanschauung genau das, was Du verdienst, wenn Du eine Priesterin "
    "von Lloth veraergerst und Dir damit den Zorn der Spinnenkoenigin "
    "selbst zuziehst.");

  AddDetail(({"lloth","koenigin","spinnenkoenigin","goettin"}),
    "Lloth, die Spinnenkoenigin und Goettin der Dunkelelfen, wird "
    "insbesondere den Dunkelelfenpriesterinnen verehrt.");
  AddDetail(({"weltanschauung","missfallen"}),
    "Bis auf Lloth und ihre Priesterinnen ist jeder entbehrlich und "
    "austauschbar.");
  AddDetail(({"auge","augen"}),
    "Die Augen der Dunkelelfenpriesterin blicken Dich streitlustig und "
    "herausfordernd an.");

  SetProp(P_NAME, "Dunkelelfenpriesterin");
  SetProp(P_GENDER, FEMALE);
  AddId(({"dunkelelfenpriesterin","priesterin","Dunkelelfenpriesterin"}));

  create_default_darkelf(42,42);
  SetProp(P_ALIGN, -1000);

  SetProp(P_SPELLRATE,66);

  AddSpell(3,360,
    "Die Priesterin spricht einen boesen Fluch ueber Dich aus.\n",
    "Die Priesterin spricht einen boesen Fluch ueber @WEN aus.\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1])
  );
  AddSpell(2,460,
    "Die Priesterin beschwoert eine Schreckensvision auf Dich herab.\n",
    "Die Priesterin beschwoert eine Schreckensvision auf @WEN herab.\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1])
  );
  AddSpell(1,560,
    "Die Priesterin reisst mit magischen Mittel an Deinem Herz.\n",
    "Die Priesterin reisst mit magischen Mittel an @WESSEN Herz.\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1])
  );

  AddInfo(({"hilfe","helfen"}),
    "Vielleicht ...",
    "knurrt vor sich hin: ");
  AddInfo(({"lloth","koenigin","spinnenkoenigin"}),
    "Frevler! Diene Lloth, oder ich werde Dein Herz heraus reissen.",
    "zischt: ");
  AddInfo(({"paladin","paladine"}),
    "Tot allen Paladinen.",
    "schreit: ");
  AddInfo(({"rune","runen","verteidigung"}),
    "Diese verfluchten Runen! Du musst Dich um sie kuemmern.",
    "zischt: ");
  AddInfo(({"quest"}),
    "Mach weiter und nerv mich nicht.",
    "grummelt: ");
  AddInfo(({"opfer"}),
    "Oh! Willst Du etwas?",
    "fragt erfreut: ");
  AddInfo(({"caroll"}),
    "Dieser verfluchte Halbelf ...",
    "zischt: ");
  AddInfo(({"turm"}),
    "Der Turm muss erobert werden!",
    "betont: ");

  seteuid(getuid(ME));
  clone_object(WEAPON "speitsche")->move(ME,M_NOCHECK);
  command_me("zuecke peitsche");
  
  AddCmd(({"hilf","helfe","helfen"}),"cmd_helfen");
  AddCmd(({"biete","bieten","anbieten"}),"cmd_helfen2");
}

void helfen_boese(int pos,object pl)
{
  tell_room(environment(ME),"\n");
  switch(pos)
  {
    case 1:
      tell_room(environment(ME),break_string(
        "Die Augen der Priesterin verengen sich und sie schaut "
        +pl->name(WEN,1)+" in die Seele. Sie erkennt die "
        "wahren Beweggruende von "+pl->name(WEN,1)+" und scheint sie gut "
        "zu heissen. Danach nickt sie kurz und lauscht in sich hinein."),
        ({pl}));
      tell_object(pl,break_string(
        "Die Augen der Priesterin verengen sich und sie schaut Dir in die "
        "Seele. Sie erkennt Deine wahren Beweggruende und scheint sie gut "
        "zu heissen. Danach nickt sie kurz und lauscht in sich hinein."));
    break;
    case 2:
      tell_room(environment(ME),break_string(
        "Die Priesterin fluestert "+pl->name(WEN,1)+" etwas zu."),({pl}));
      tell_object(pl,break_string(
        pl->Name(WER,1)+" gehe zu dem Turm, erschleiche Dir das Vertrauen "
        "des dortigen Magiers und finde dann einen Weg, die Verteidigung "
        "des Turmes zu zerstoeren.",78,"Die Priesterin instruiert Dich: "));
    break;
    default:
      tell_room(environment(ME),break_string(
        pl->Name(WER,1)+" mach Dich sofort auf den Weg.",78,
        "Die Priesterin befiehlt: "));
      pl->SetProp(P_PARALYZED,0);
      SetProp(P_NOATTACK,0);
      laeuft=0;
      return;
    break;
  }
  call_out("helfen_boese",10,++pos,pl);
}

int helfen()
{
  int pos,art;

  if (IsEnemy(PL)) return 0;
  if (laeuft)
  {
    write("Die Priesterin ist gerade mit etwas Anderem beschaeftigt.\n");
    return 1;
  }

  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(PL);
  if (art!=2)
  {
    Kill(PL);
    return 1;
  }
  if (art==2 && pos==2)
  { //man ist an der richtigen stelle in der quest
    P_ARCHON_QUESTMASTER->advance_quest(PL); //2->3
    tell_room(environment(ME),break_string(
      PL->Name(WER,1)+" tritt an die Priesterin heran und scheint ihr "
      "einen Vorschlag zu unterbreiten."),({PL}));
    tell_object(PL,break_string(
      "Du trittst vorsichtig und kriecherisch an die Priesterin heran. "
      "Behutsam schlaegst Du ihr vor, dass Du ihr bei ihrer Aufgabe "
      "behilflich sein koenntest."));
    SetProp(P_NOATTACK,"unterhaelt sich gerade.");
    PL->SetProp(P_PARALYZED,([
      PARALYZE_TIME:-1,
      PARALYZE_MSG:
       "Du konzentrierst Dich zu sehr auf das, was um Dich herum passiert.\n",
      PARALYZE_MSG_OTHER:break_string(
       PL->Name(WER,1)+" konzentriert sich zu sehr auf seine Umgebung."),
      PARALYZE_END:"Der Zwang zuzuhoeren verschwindet.\n",
      PARALYZE_END_OTHER:"%s verspuert keinen Zwang mehr.\n" ]));
    laeuft=1;
    call_out("helfen_boese",10,1,PL);
    return 1;
  }
  write("Die Priesterin droht: Hast Du mir nichts neues zu berichten?\n");
  return 1;
}

int cmd_helfen2(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "hilfe",
       "Was willst Du anbieten?"))
    return 0;
  return helfen();
}

int cmd_helfen(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "priesterin|dunkelelfenpriesterin|dunkelelfpriesterin",
       "Wem willst Du helfen?"))
    return 0;
  return helfen();
}

void show_anrufung(int pos,int art,object pl)
{
  string kerker;
  int wait;
  wait=10;
  tell_room(environment(ME),"\n");
  switch(pos)
  {
    case 1:
      tell_room(environment(ME),break_string(
        "In diesem Augenblick hebt die Priesterin ihre Arme und beginnt "
        "mit einer Beschwoerung. Einen bestimmten Gesang intonierend schuert "
        "sie eine dunkle Flamme in dem Kohlebecken."));
    break;
    case 2:
      tell_room(environment(ME),break_string(
        "Die schwarze Flamme lodert hoch empor und verdichtet sich zu einem "
        "schwarzen Feuerball hoch ueber dem Kopf der Priesterin. Mit einer "
        "ohrenbetaeubenden Explosion schiessen Flammenzungen durch den "
        "Raum und bilden eine undurchsichtige Saeule."));
    break;
    case 3:
      tell_room(environment(ME),break_string(
        "Die Priesterin setzt ihren Gesang fort, bis in der Mitte der Saeule "
        "eine mit Tentakeln versehene Kreatur erscheint. Die "
        "alles durchdringenden Augen des Geschoepfes richten sich auf die "
        "Priesterin, die den Gesang beendet und sich vor der Gestalt "
        "verneigt."));
    break;
    case 4:
      tell_room(environment(ME),break_string(
        "Beim Angesicht der Kreatur mit den langgezogenen Gesichtszuegen, "
        "welche an eine halb geschmolzene Kerze erinnern, ist Dir sofort "
        "klar, dass Du in der Praesenz einer Yochlol bist, einer "
        "persoenlichen Dienerin der Goettin Lloth."));
    break;
    case 5:
      tell_room(environment(ME),break_string(
        "'Seid gegruesst, Dienerin', spricht die Priesterin laut. "
        "'Gesegnet sei Lloth N'a'shezbaernon fuer Eure Anwesenheit.'"));
    break;
    case 6:
      tell_room(environment(ME),break_string(
        "Ein gewaltige telepatische Frage ertoent 'Warum wagt ihr "
        "es mich anzurufen?' 'Um gegen die verruchten Paladine "
        "vorzugehen, die es wagten, den Turm, welcher vor vielen "
        "Dekaden schon mal gereinigt wurde, erneut zu besetzen.' "
        "erwidert die Priesterin. 'Was koennen wir tun, um die Gunst "
        "der Herrin zu erlangen und die Verruchten zu vernichten?'"));
    break;
    case 7:
      tell_room(environment(ME),break_string(
        "Darauf hin siehst Du, wie die Augen der Yochlol leer werden, "
        "als die Kreatur in sich versinkt und Rat auf seiner "
        "Existenzebene sucht. Einige Zeit vergeht, bevor die "
        "telepatische Stimme der Yochlol wieder zu hoeren ist."));
    break;
    case 8:
      tell_room(environment(ME),break_string(
        "Die Yochlol verkuendet "
        "'Priesterin vernichtet die Diener des Lichtes im Turm! "
        "Versagt und ihr werdet den Zorn Lloth's spueren. "
        "Zerstoert die Schutzrunen des Turmes, damit unsere "
        "Magie dort wirken kann und uebergebt das Leben der "
        "Paladine Lloth.'"));
    break;
    case 9:
      if (art==1)
      { 
       tell_room(environment(ME),break_string(
        "Ploetzlich wird die Yochlol "+pl->name(WEN,1)+" gewahr "
        "und erfuellt den Raum mit einer unwiderstehlichen telepatischen "
        "Stimme 'Verraeter, Du sollst geopfert werden.' Danach weitet sich "
        "ihr Maul unglaublich weit und sie speit eine Reihe kleinerer "
        "Gegenstaende auf "+pl->nam(WEN,1)+", um dann zu verschwinden."),
        ({pl}));
       tell_object(pl,break_string(
        "Ploetzlich wird die Yochlol Deiner gewahr "
        "und erfuellt den Raum mit einer unwiderstehlichen telepatischen "
        "Stimme 'Verraeter, Du sollst geopfert werden.' Danach weitet sich "
        "ihr Maul unglaublich weit und sie speit eine Reihe kleinerer "
        "Gegenstaende auf Dich, um dann zu verschwinden."));
      }
      else
      {
       tell_room(environment(ME),break_string(
        "Danach verschwindet die Yochlol mit einem lauten Knall. "
        "Mit dieser Aufgabe betraeut, spricht die Priesterin einen Zauber, "
        "welcher ihr verraten soll, wie sie die Runen zerstoeren "
        "kann. Was sie dabei erfaehrt, kannst Du leider nicht "
        "sehen, doch dauert es nicht lange, bis die Priesterin "
        "ihre Umgebung wieder wahr nimmt."));
      }
    break;
    default:
      laeuft=0;
      SetProp(P_NOATTACK,0);
      pl->SetProp(P_PARALYZED,0);
      P_ARCHON_QUESTMASTER->advance_quest(pl); //gut: 3->4, boese: 1->2
      if (art==1)
      { 
        tell_room(environment(ME),break_string(
          "Kaum haben die Gegenstaende "+pl->name(WEN,1)+" erreicht, "
          "beginnen sie auch schon zu den ungeschuetzten Hals von "
          +pl->name(WEN,1)+" zu krabbeln. Oh Gott, Spinnen - ein Biss und "
          +pl->name(WER,1)+" ist bewegungslos, waehrend die Priesterin "
          "mit zornerfuellten Augen ein paar Dunkelelfenkrieger "
          "herbeiruft und ihnen einen Wink gibt."),({pl}));
        tell_object(pl,break_string(
          "Kaum haben die Gegenstaende Dich erreicht, "
          "beginnen sie auch schon zu Deinem ungeschuetzten Hals "
          "zu krabbeln. Voller Panik denkst Du nur noch 'Oh Gott, Spinnen'. "
          "Ein Biss und schon bist Du vollkommen bewegungslos, "
          "waehrend die Priesterin mit zornerfuellten Augen "
          "ein paar Dunkelelfenkrieger herbeiruft und ihnen einen "
          "Wink gibt."));
        kerker=ROOM "spinnenkerker:"+getuid(pl);
        pl->move(kerker,M_NOCHECK|M_SILENT);
/*
      	kerker=clone_object(ROOM "spinnenkerker");
      	pl->move(kerker,M_NOCHECK|M_SILENT);
*/
        tell_room(environment(ME),break_string(
          pl->Name(WER,1)+" wird von einigen Dunkelelfen grob weggezogen "
          "und ist dann verschwunden."));
      }
      else
      {
        tell_object(pl,break_string(
          "Bist Du gekommen, um Lloth und ihren Dienerinnen "
          "zu helfen?"));
      }
      return; //fertig
    break;
  }
  call_out("show_anrufung",wait,++pos,art,pl);
}

void bericht_abliefern(object pl)
{
  if (environment(ME)!=environment(pl)) return;
  P_ARCHON_QUESTMASTER->advance_quest(pl); //8->9
  SetProp(P_NOATTACK,"erhaelt gerade einen Bericht.");
  laeuft=1;
  pl->SetProp(P_PARALYZED,([
    PARALYZE_TIME:-1,
    PARALYZE_MSG:
     "Du konzentrierst Dich zu sehr auf das, was um Dich herum passiert.\n",
    PARALYZE_MSG_OTHER:break_string(
     PL->Name(WER,1)+" konzentriert sich zu sehr auf seine Umgebung."),
    PARALYZE_END:break_string(
     "Da Du Dir nichts entgehen lassen willst, rennst "
     "Du schnell zur Hoehle, in der der Turm steht."),
    PARALYZE_END_OTHER:"%s hat es ploetzlich eilig.\n" ]));
  tell_object(pl,break_string(
    "Kaum hast Du den Raum betreten, berichtest Du der Priesterin "
    "von Deinen Fortschritten. Dich keinen weiteren Blick wuerdigend "
    "schreit sie Befehle und macht sich fertig, um den Turm zu "
    "stuermen."));
  tell_room(environment(ME),break_string(
    "Kaum hat "+pl->Name(WER,1)+" den Raum betreten, berichtet "
    +pl->QueryPronoun(WER)+" der Priesterin etwas, woraufhin diese "
    "Befehle schreit und sich fertig mach, den Turm zu erstuermen."),({pl}));
  P_ARCHON_QUESTMASTER->endkampf(pl,2,1,0,0);
  quest_ende();
}

void quest_ende()
{
  if (environment(ME))
    tell_room(environment(ME),"Die Priesterin hat es ploetzlich eilig.\n");
  move(TURM "room/wait_room",M_NOCHECK|M_SILENT);
  remove(1);

}

void init()
{
  int pos,art;
  string race,kerker;
  ::init();
  if (!PL ||!living(PL)) return;
  if (QueryProp(P_ARCHON_ENDFIGHT)) return;
  if (laeuft)
  {
    tell_object(PL,break_string(
      "Die Priesterin ist gerade mit etwas Anderem "
      "beschaeftigt und wirft Dich mit einem Fingerschnipsen "
      "aus den Raum. Komm spaeter wieder."));
    PL->move(ROOM "tunnel_02",M_GO,"","fliegt raus","erscheint");
    return;
  }
  if (IsEnemy(PL)) return;
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(PL);
  if (art==1 || art==2)
  {
   if (InFight())
   {
    tell_object(PL,break_string(
      "Die Priesterin ist gerade in einem Kampf verwickelt und "
      "wirft Dich mit einem Fingerschnipsen aus den Raum. Komm spaeter wieder."));
    PL->move(ROOM "tunnel_02",M_GO,"","fliegt raus","erscheint");
    return;
   }
   if (laeuft)
   {
    tell_object(PL,break_string(
      "Die Priesterin ist gerade in einer Anrufung und "
      "wirft Dich mit einem Fingerschnipsen aus den Raum. Komm spaeter wieder."));
    PL->move(ROOM "tunnel_02",M_GO,"","fliegt raus","erscheint");
    return;
   }
  }
  if ((art==2 && pos==1) || (art==1 && pos==3))
  {
    PL->SetProp(P_PARALYZED,([
      PARALYZE_TIME:-1,
      PARALYZE_MSG:
       "Du konzentrierst Dich zu sehr auf das, was um Dich herum passiert.\n",
      PARALYZE_MSG_OTHER:break_string(
       PL->Name(WER,1)+" konzentriert sich zu sehr auf seine Umgebung."),
      PARALYZE_END:"Der Zwang zuzuhoeren verschwindet.\n",
      PARALYZE_END_OTHER:"%s verspuert keinen Zwang mehr.\n" ]));
    SetProp(P_NOATTACK,break_string(
      "Die Priesterin ist in einer Anrufung vertieft, stoere sie jetzt und Du wirst "
      "sofort sterben."));
    if (art==1)
      call_out("show_anrufung",1,1,art,PL);
    else
      call_out("show_anrufung",1,1,art,PL);
    laeuft=1;
  }
  else if (art==1 && pos==4)
  {
     tell_room(environment(ME),break_string(
       "Die Priesterin ruft mit zornerfuellten Augen ein "
       "paar Dunkelelfenkrieger herbei und gibt ihnen einen Wink."));
     kerker=ROOM "spinnenkerker:"+getuid(PL);
     PL->move(kerker,M_NOCHECK|M_SILENT);
     tell_room(environment(ME),break_string(
        PL->Name(WER,1)+" wird von einigen Dunkelelfen grob weggezogen "
        "und ist dann verschwunden."));
  }
  else if (art==2 && pos==8) //ende
    call_out("bericht_abliefern",1,PL);
  else if (art==2)
    ; //nix machen
  else if (!IS_WIZARD(PL) || !PL->QueryProp(P_WANTS_TO_LEARN))
    Kill(PL);
}
