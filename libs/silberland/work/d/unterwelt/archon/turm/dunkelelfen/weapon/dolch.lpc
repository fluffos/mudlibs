inherit "std/weapon";
#include "../def.h"

void create()
{
  if (!is_clone(ME)) return;

  ::create();   
  SetProp(P_SHORT,"Ein verzierter Dolch");
  SetProp(P_LONG,            
     "Dies ist ein kleiner zierlicher Dolch, welcher schon fast "
     "einem Stilett gleicht. Die Verzierungen an der Seite deuten "
     "darauf hin, dass der Dolch zu irgendwelchen rituellen Anlaessen "
     "verwendet wurde.");
  AddDetail(({"stilett"}),
    "Etwas breiter ist der Dolch doch noch.");
  AddDetail(({"verzierung","verzierungen"}),
    "Solche Verzierungen hast Du noch nie gesehen.");
  AddDetail(({"ritual","anlass","anlaesse"}),
    "Du weisst nicht, zu welchen rituellen Anlaessen der "
    "Dolch verwendet wird.");
  
  SetProp(P_NAME, "Dolch");  
  SetProp(P_NAME_ADJ, "verziert");
  SetProp(P_GENDER, MALE);
  SetProp(P_ADJECTIVES,({"verzierter","verzierten","verziert"}));

  AddId(({"dolch","opferdolch","\nOPFERDOLCH"}));                

  SetProp(P_VALUE, 290);            
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 15);
  SetProp(P_WEAPON_TYPE, WT_KNIFE); 
  SetProp(P_DAM_TYPE,({DT_SLASH}));
  SetProp(P_MATERIAL,([MAT_BRONCE:100]));

  SetProp(P_WC,1);
  SetProp(P_NR_HANDS,1);            
}

