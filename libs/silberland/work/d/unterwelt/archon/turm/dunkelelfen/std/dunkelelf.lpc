#pragma strict_types
#include "../def.h"
inherit STDDARKELF;

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  seteuid(getuid(ME));
  clone_object("/d/unterwelt/zordan/dhrkion/armour/spinnenpanzer")->move(ME,M_NOCHECK);
  clone_object(P_DIR_ARMOUR "boots/lederstiefel")->move(ME,M_NOCHECK);
  clone_object(P_DIR_ARMOUR "gloves/lederhandschuhe")->move(ME,M_NOCHECK);
  command_me("trage alles");
}

int goto_endfight(int wie)
{
  mixed enemy;
  int i;

  SetProp(P_MNPC_FLAGS,0); //kein wegrennen mehr
//  SetProp(P_INFOS,0); //wir reden auch nicht mehr
  SetProp(P_ARCHON_ENDFIGHT,1); //damit wir wissen, wir sind im endkampf
  SetProp(P_NOATTACK,0); //sichergehen bei magier/priesterin
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_ACHATS,0); //da ist schon soviel los ...
  SetProp(P_ACHAT_CHANCE,0); //da ist schon soviel los ...
  enemy=QueryEnemies()[0]; //nicht mehr weiter kaempfen
  if (pointerp(enemy))
  {
    for (i=sizeof(enemy);i--;)
    {
      if (objectp(enemy[i]))
      {
        enemy[i]->StopHuntFor(ME,1);
        ME->StopHuntFor(enemy[i],1);
      }
    }
  }
  if (random(2) && environment(ME))
   tell_room(environment(ME),break_string(
    "Ploetzlich kommt Bewegung in "+name(WEN,1)+". Es gab wohl "
    "den Abmarschbefehl."));
  if (wie==2)
  { //guter endkampf
   SetProp(P_HP,QueryProp(P_MAX_HP));
   SetProp(P_SP,QueryProp(P_MAX_SP));
  }
  else
  {
   SetProp(P_HP,QueryProp(P_MAX_HP)/15);
   SetProp(P_SP,QueryProp(P_MAX_SP)/15);
  }
  move(TURM "room/vorturm",M_GO);
  enemy=present("TURMDEFENDER",environment(ME));
  if (objectp(enemy)) ME->Kill(enemy);
  return 1;
}

void finish_endfight()
{
  move(TURM "room/destruct_room",M_GO,"","patrouilliert zurueck nach Dhrkion","erscheint");
  remove(1);
}

void remove_item(object was)
{
  if (was) was->remove(1);
}

varargs void die(int p)
{
  if (QueryProp(P_ARCHON_ENDFIGHT)) //im endkampf kein objektlager abgeben
    map_array(all_inventory(ME),"remove_item");
  ::die(p);
}

void init()
{
  SetProp("auto_attack",0); //damit keine palist angegriffen werden
  ::init();
}

void spell_drider(object enemy, int damage, mixed dam_type)
{
  if (QueryProp(P_ARCHON_ENDFIGHT)) //im endkampf kein objektlager abgeben
  {
    TELL("archon","dider->dunkelheit\n");
    return spell_dunkelheit(enemy,damage,dam_type); //im endkampf keine drider!!!
  }
  return ::spell_drider(enemy,damage,dam_type);
}