#pragma strict_types
#include "../def.h"
inherit STD "dunkelelf";

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_LOG_INFO,"archon/delfen.rep");
  AddLibrary(LIB "info.lib",1); 
  P_ARCHON_NPCMASTER->add_npc(ME,2); //boeser npc

  SetProp(P_SHORT,"Der Dunkelelfenzauberer gehoert zu einer Patrouille");
  SetProp(P_LONG,
    "Die Dunkelelfenzauberer sind arrogant in ihrem Auftreten und "
    "fuehlen sich jedem Kaempfer weit ueberlegen. Sie beugen ihr "
    "Haupt nur vor Lloth und ihren Priesterinnen.");

  AddDetail(({"haupt","haar"}),
    "Das Haupt des Zauberers ist, wie nicht anders zu erwarten, "
    "von weissem Haar bedeckt.");
  AddDetail(({"auftreten","besseres"}),
    "Sie glauben etwas Besseres, als die gewoehnlichen Kaempfer zu "
    "sein.");
  AddDetail(({"kaempfer","krieger","dunkelelfenkrieger","naehe"}),
    "Der Dunkelelfenzauberer reicht Dir, Du brauchst nicht noch "
    "einen Dunkelelfenkrieger in der Naehe.");

  SetProp(P_NAME, "Dunkelelfenzauberer");
  SetProp(P_GENDER, MALE);
  AddId(({"dunkelelf","dunkelelfenzauberer","zauberer"}));

  create_default_darkelf(30+random(6));
  SetProp(P_SPELLRATE,100); //Zauberer
  SetProp(P_HANDS,({" mit magischen Mitteln",340,DT_MAGIC}));

  AddSpell(1,460,
    "Der Zauberer schleudert einen Blitzstrahl auf Dich.\n",
    "Der Zauberer schleudert einen Blitzstrahl auf @WEN.\n",
     DT_LIGHTNING,([SP_SHOW_DAMAGE:1])
  );

  SetProp(P_ALIGN, -990);

}

void init()
{
  string race;
  int t;
  ::init();
  if (QueryProp(P_ARCHON_ENDFIGHT)) return;
  if (!PL || !interactive(PL)) return;
  race=(string)PL->QueryProp(P_RACE);
  if (race!="Dunkelelf")
  {
    t=(int)PL->QueryProp(P_DARKELF_DISGUISE); //ist eine zeitliche begrenzung
    if (time()>t)
    {
      if (!IS_WIZARD(PL) || !PL->QueryProp(P_WANTS_TO_LEARN))
        Kill(PL); //alle nicht dunkelelfen angreifen, ausser sie sind getarnt
    }
  }
}
