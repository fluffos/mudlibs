inherit "std/weapon";
#include "../def.h"

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT,"Eine Schlangenpeitsche");
  SetProp(P_LONG,
    "Anders als gewoehnliche Peitschen braucht dieses teuflische "
    "Instrument wenig Raum, um zuzuschlagen. Die sechs lebenden "
    "Schlangenkoepfe schlagen nach dem Willen des Peitschentraegers "
    "aus naechster Naehe zu, doch koennen sie eigentlich nur von "
    "Dunkelelfenpriesterinnen beherrscht werden.");

  SetProp(P_NAME,"Schlangenpeitsche");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_VALUE,10990);
  SetProp(P_WEIGHT,1900);
  SetProp(P_SIZE,60);
  SetProp(P_WEAPON_TYPE,WT_MAGIC);
  SetProp(P_DAM_TYPE,({DT_WHIP,DT_MAGIC})); 
  SetProp(P_WC,140);
  SetProp(P_WC_BONUS,
    (["Dunkelelfenpriesterin":250]));
  SetProp(P_NR_HANDS,1);
  SetProp(P_NOBUY,1);
  SetProp(P_HIT_FUNC,ME);

  AddDetail(({"instrument"}),
    "Dies ist eine fuerchterliche Waffe.");
  AddDetail(({"kopf","koepfe","schlangenkopf","schlangenkoepfe"}),
    "Sechs magische Schlangenkoepfe befinden sich am Ende der Peitsche "
    "und scheinen ihren eigenen Willen zu besitzen. Auf jedem der Koepfe "
    "ist ein eigenartiges Symbol eingelassen.");
  AddDetail(({"willen","wille"}),
    "Wenn man einen starken Willen hat, schlagen die Koepfe besonders "
    "schmerzhaft fuer den Gegner zu.");
  AddDetail(({"symbol"}),
    "Es scheint sich um Runen zu handeln.");
  AddDetail(({"rune","runen"}),
    "Du weisst es zwar nicht sicher, aber das scheinen Hassrunen zu sein.");
  AddDetail(({"dunkelelfenpriesterinnen","dunkelelfenpriesterin",
              "dunkelelfpriesterin","dunkelelfpriesterinnen",
              "priesterin"}),
    "Diese Peitsche ist ein Geschenk von Lloth an ihre ergebensten "
    "Dienerinnen.");
  AddDetail(({"lloth"}),
    "Lloth ist die Goettin der Unterwelt.");
  AddDetail(({"diener","dienerinnen"}),
    "Die Priesterinnen der Dunkelelfen dienen der Goettin Lloth ergeben.");
  AddDetail(({"geschenk"}),
    "Die Peitsche wird Dir nicht wirklich gehorchen, da sie Dir nicht "
    "geschenkt wurde.");

  AddId(({"peitsche","schlangenpeitsche"}));
  
  SetProp(P_WIELD_RESTRICTIONS,([A_DEX:18,
                                 SR_INCLUDE_RACE:({"Dunkelelf","Magier",
                                                   "dunkelelf","magier"})]));
}

int HitFunc(object enemy)
{
  object pl;
  pl=QueryProp(P_WIELDED);
  if (pl->id("Dunkelelfenpriesterin"))
  {
    tell_room(environment(pl),break_string(
      "  Die Schlangenkoepfe reissen Fleischstuecke aus "+enemy->Name(WEN,1)+
      " heraus."),({enemy}));
    tell_object(enemy,
      "  Die Schlangenkoepfe reissen Fleischstuecke aus Dir heraus.\n");
    enemy->AddHp(-5);
    return 0;
  }
}
