#pragma strict_types
#include "../def.h"
inherit "std/room";

void create();
int cmd_schleichen(string str);
int exit_sueden();

void create()
{
  ::create();

  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_CAVE]));
  SetProp(P_INT_SHORT, "In einem Tunnel");
  SetProp(P_NO_TPORT,NO_TPORT);//damit schutz in tunnel_01 nicht umgangen wird

  SetProp(P_INT_LONG,
    "Der Tunnel weitet sich und Du stehst in einer groesseren "
    "Hoehle. Rund um Dich herum wurde kurzfristig ein "
    "Lager errichtet und auf dem Boden liegen einige Utensilien. "
    "Die Luft um Dich herum scheint vor Spannung geradezu "
    "zu vibrieren. Irgendetwas Grosses, Boeses, Schreckliches "
    "wird hier vorbereitet und wird wohl bald in die Tat "
    "umgesetzt. Das Lager zieht sich weiter nach Osten und "
    "im Sueden glaubst Du, in einer kleinen "
    "Hoehle, eine Dunkelelfenpriesterin zu erkennen.");
    
  AddDetail(({"umgebung","hoehle","tunnel"}),QueryProp(P_INT_LONG));
  AddDetail(({"tat"}),
    "Was mag hier nur geplant werden?");
  AddDetail(({"wesen","dunkelelfen","dunkelefe","patroullie",
              "dunkelelfenkrieger","dunkelelfenmagier"}),
    "Oh, hier ist ja gar keiner! Aber das Lager wird bestimmt "
    "nicht lange verlassen sein. Ruehre bloss nichts an!");
  AddDetail(({"dunkelelfenpriesterinnen","dunkelelfenpriesterin",
              "priesterin","priesterinnen","gruppe"}),
    "Die Priesterin ist wohl im Sueden. Wenn Du sie genauer "
    "betrachten willst, wirst Du wohl oder uebel zu ihr "
    "gehen muessen.");
  AddDetail(({"list"}),
    "Du koenntest versuchen nach Sueden zu schleichen. Doch "
    "solltest Du SEHR vorsichtig sein, sollte Dich jemand "
    "bemerken, wirst Du schnell bei Deinem Schoepfer sein.");
  AddDetail(({"selbstmord","selbstmordversuch","versuch"}),
    "Das beschleichen und belauschen der Dunkelelfenpriesterin "
    "waehrend eines ihrer Rituale kommt einem Selbstmord gleich - "
    "jedenfalls dann, wenn man erwischt wird. Du kannst Dir dann "
    "zumindest sicher sein, wer als naechstes geopfert wird.");
  AddDetail(({"ritual","rituale"}),
    "Die Priesterin im Sueden halten irgend ein geheimnisvolles "
    "Ritual ab.");
  AddDetail(({"felsgestein","gestein","fels","stein","art"}),
    ([ 0: 
          "Es scheint stabiles Felsgestein zu sein. Leider bist Du "
          "kein Geologe, so dass Du sonst nichts weiteres, ueber die "
          "Art des Gesteines sagen kannst.",
       "zwerg":
          "Dies ist stabiler Felsgestein. Sehr gut geeignet, um "
          "einen Tunnel hinein zu dreiben." ]));
  AddDetail(({"geologe","leute"}),
    "Geologe? Na ja, das sind doch die Leute die staendig in "
    "Hoehlen herumklettern, _ohne_ dabei Monster zu killen.");
  AddDetail(({"wand","waende","decke"}),
    "Die Waende und die Decke bestehen aus ganz normalen Felsgestein, "
    "ohne irgendwelche Besonderheiten.");
  AddDetail(({"besonderheit","besonderheiten"}),
    "Hier sind keine, aber vielleicht weiter im Sueden?");
  AddDetail(({"sueden"}),
    "Du bist Dir nicht sicher, ob Du dorthin gehen solltest.");
  AddDetail(({"osten"}),
    "Dort geht das Lager weiter.");
  AddDetail(({"boden","hoehlenboden"}),
    "Der Boden besteht hier aus festgeklopfter Erde. "
    "Weiterhin kannst Du ein hastig aufgebautes Lager erkennen, "
    "in dem so einige nuetzliche wie auch unnuetze Utensilien "
    "herum liegen.");
  AddDetail(({"erde"}),
    "Die festgeklopfte Erde des Bodens ist durchzogen von Pflanzen, "
    "die allerdings nicht gerade gesund aussehen. Um genau zu sein: "
    "Sie sind anscheinend alle abgestorben. Da haben die Dunkelelfen "
    "wohl etwas gewuetet.");
  AddDetail(({"pflanze","pflanzen","dinger","werk","wurzelwerk","wurzel",
              "wurzeln"}),
    "Ueberall im Boden siehst Du abgestorbenes Wurzelwerk und andere "
    "Bestandteile von toten Pflanzen. Ist ja auch kein Wunder, dass "
    "die Dinger alle tot sind, wenn die Dunkelelfen an ihnen ihre "
    "Zerstoerungswut ausgelassen haben.");
  AddDetail(({"zerstoerungswut","glueck"}),
    "Zum Glueck warst Du gerade nicht da. Wer weiss wo sie sie sonst "
    "ausgelassen haetten.");
  AddDetail(({"pflanzenbestandteile","bestandteile","bestandteil",
              "pflanzenbestandteil"}),
    "Die faulenden Bestandteile der abgestorbenen Pflanzen die ueberall "
    "im Boden zu sehen sind, riechen etwas unangenehm.");
  AddDetail(({"monster"}),
    "Sind Dunkelelfen welche?");
  AddDetail(({"luft","spannung"}),
    "Hier liegt eine regelrecht greifbare Spannung in der Luft.");
  AddDetail(({"wunder"}),
    "Wunder haetten wir alle gern.");
  AddDetail(({"lager","dunkelelfenlager"}),
    "Das Lager der Dunkelelfen bedeckt den gesamten Hoehlenboden. "
    "Hier kommst Du ungesehen nie nach Sueden durch.");
  AddDetail(({"utensilien","plunder"}),
    "Fuer die hier lagernde Patroullie der Dunkelelfen moegen sie "
    "wichtig sein, aber fuer Dich sieht es eher wie wertloser "
    "Plunder aus.");
  

  AddSmell(({DEFAULT_SMELL,"bestandteil","bestandteile",
             "pflanzenbestandteile","pflanzenbestandteil",
             "pflanze","pflanzen","wurzeln","wurzel","wurzelwerk",
             "hoehle","umgebung","boden","dinger"}),
    "Die abgestorbenen und schon teilweise faulenden Bestandteile der "
    "abgestorbenen Pflanzen riechen etwas unangenehm.");
  AddSound(({DEFAULT_SOUND,"laerm"}),
    "Die Dunkelelfen machen erstaunlich wenig Laerm. Wenn Du sie nicht "
    "sehen wuerdest, wuerdest Du meinen, keiner ist hier.");
             
  AddCmd(({"schleich","schleiche","schleichen"}),"cmd_schleichen");
  
  AddItem(NPC "dunkelelf",REFRESH_DESTRUCT);
  AddItem(NPC "dunkelelf",REFRESH_DESTRUCT);
  AddItem(NPC "dzauberer",REFRESH_DESTRUCT);

  AddExit("norden",ROOM "tunnel_01");
  AddExit("osten",ROOM "tunnel_04");
  AddExit("sueden",#'exit_sueden);
}

int quest_relevantes_weiter(object pl,int wie)
{
  int pos,art;
  string race;

  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(PL);
  race=(string)PL->QueryProp(P_RACE);
  if (art==2)
  {
    if (pos>8)
    {
      tell_object(PL,"Was willst Du denn noch hier? Gehe zu Caroll.\n");
    }
    else if (pos==8)
    {
      if (wie) return 2; //sofort weiter
      tell_object(PL,break_string(
        "Wieso willst Du denn schleichen? Du sollst doch zu der Priesterin "
        "gehen - sie erwarten Dich schon ungeduldig."));
    }
    else if (pos==1)
    {
      if (race=="Dunkelelf" || PL->QueryProp(P_DARKELF_DISGUISE)>time())
      {
        if (wie) return 2; //sofort weiter 
        tell_object(PL,break_string(
          "Wieso willst Du denn schleichen? Du sollst doch zu der Priesterin "
          "gehen - sie erwarten Dich schon."));
      }
      else
      {
      	tell_object(PL,break_string(
         "Auch wenn Du den Dunkelelfen Deine Hilfe anbieten willst, solltest "
         "Du ohne als Dunkelelf getarnt zu sein, nicht zu ihnen Vordringen. "
         "Ein solcher versuch, koennte toedlich sein, bevor sie Deine "
         "Absichten erkennen."));
      }
    }
    else if (pos>1)
      tell_object(PL,
        "Schleich hier nicht so rum, sondern spioniere den Turm aus.\n");
    else if (race=="Dunkelelf")
     tell_object(PL,break_string(
       "Zur Zeit musst Du nicht zu der Dunkelelfenpriesterin, so dass "
       "Du besser darauf verzichten solltest, bevor Sie noch Dich als ihr "
       "naechstes Opfer auswaehlen."));
    else
     tell_object(PL,break_string(
      "Die Gefahr erwischt zu werden ist Dir einfach zu gross. Solange "
      "Du nicht unbedingt zu der Dunkelelfenpriesterin musst, verzichtest "
      "Du lieber auf diesen Selbstmordversuch."));
    return 1;
  }
  else if (art==1)
  {
    if (pos<3)
    {
     tell_object(PL,break_string(
      "Nachdem Du nun fuer den Magier arbeitest, solltest Du vorher etwas "
      "unternehmen, um Dir das Vertrauen der Priesterin zuzusichern."));
    }
    else if (pos==3 || pos==4)
    {
     if (wie) return 2;
      tell_object(PL,break_string(
       "Wieso willst Du denn schleichen? Du sollst doch zu der Priesterin "
       "gehen - sie erwarten Dich schon."));
    }
    else
     tell_object(PL,break_string(
      "Hat Dir Dein einer Besuch im Spinnenkerker nicht gereicht?"));
    return 1;
  }
  return 0;
}

int cmd_schleichen(string str)
{
  if (!S_STANDARD->check_cmd(str,
    "sueden",
    "Wohin willst Du schleichen?"))
    return 0;

  if (!present("DUNKELELFNPC"))
  {
    write("Gehe doch einfach nach Sueden!\n");
    return 1;
  }

  if (quest_relevantes_weiter(PL,0)) return 1;

  tell_object(PL,break_string(
    "Die Gefahr erwischt zu werden ist Dir einfach zu gross. Solange "
    "Du nicht unbedingt zu der Dunkelelfenpriesterin musst, verzichtest "
    "Du lieber auf diesen Selbstmordversuch."));
  return 1;
}

int exit_sueden()
{
  int ret;
  if (present("DUNKELELFNPC"))
  {
   ret=quest_relevantes_weiter(PL,1);
 //ret==2 man geht weiter
   if (ret==1) return 1;
   if (!ret)
   {
    tell_object(PL,break_string(
      "Gerade als Du nach Sueden gehen willst, versperrt Dir ein "
      "Dunkelelf den Weg."));
    tell_room(ME,break_string(
      "Gerade als "+PL->name(WER,1)+" nach Sueden gehen will, "
      "versperrt "+PL->QueryPronoun(WEM)+" ein Dunkelelf den Weg."),({PL}));
    if (!PL->InFight())
    {
      tell_object(PL,break_string(
        "So wirst Du nie zu der Priesterin kommen. Nur ein Kampf "
        "oder eine List kann Dir hier weiter helfen."));
    }
    return 1;
   }
  }
  PL->move(ROOM "tunnel_03",M_GO,"","geht","kommt an");
  return 1;
}



