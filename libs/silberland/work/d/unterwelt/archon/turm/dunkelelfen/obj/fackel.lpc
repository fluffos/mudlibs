// Info eigentlich nur eine Standardkopie der /obj/fackel
// Doch beim anzuenden in der Quest wird der Questablauf fortgesetzt,
// nicht das Spieler das abbrennen der Fackel abwarten und dann festsitzen!!
// 08.04.2003 Archon: erstellt
/*
 Rev 1.0: Archon
*/

inherit "/obj/fackel";
#include "../def.h"

void create()
{
  if(!is_clone(ME)) return;
  ::create();
}

int light(string str)
{
  int ret;
  ret=::light(str);
  if (ret)
    environment(PL)->fackel_angezuendet(ME,PL);
  return ret;
}