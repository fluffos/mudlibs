int exit_norden()
{
  write(break_string("Vorsichtig schleichst Du nach Norden. Doch so "
    "sehr Du Dich auch anstrengst, kaum hast Du die Wand erreicht, "
    "als Dich ein unsichtbarer Waechter erfasst und zurueck in den "
    "Kerker schleudert."));
  PL->AddHp(-100);
  return 1; 
}

int exit_loch()
{
  write(break_string("Widerstrebend kriechst Du in das klebrige Loch "
    "hinein. Du robbst und robbst eine halbe Ewigkeit lang, bis Du "
    "ploetzlich spuerst, wie vor Dir kein Boden mehr ist und Du in "
    "die Tiefe purzelst."));
  PL->move(ROOM "tunnel_01",M_GO,"","verschwindet","faellt von der Decke");
  PL->AddHp(-(random(41)+10));
  P_ARCHON_QUESTMASTER->advance_quest(PL); //4->5
  call_out("remove",1,1); //raum zerstoeren
  return 1;
}

void init()
{
  ::init();
  if (!PL) return;
  set_start(PL);
}

//alles was licht macht - naja wichtig sind eigentlich nur fackeln 
int istlichtquelle(object was)
{
  if (!objectp(was)) return 0; 
  if (was->id("Lichtquelle")) return 1;
  return 0;
}

//remove? oder doch was anderes? gibt es wichtige lichtquellen? unique?
void wegdamit(object was)
{
  if (objectp(was)) was->remove(1);
}

//mit gezueckter Waffe gehts nicht weiter ... waffe kann icht verflucht sein
//schutz ist in tunnel_01 ...
int istgezuecktewaffe(object ob)
{
  if (!objectp(ob) || !ob->QueryProp(P_WIELDED)) return 0;
  return 1;
}

void ablegen(object was)
{
  if (objectp(was)) was->DoUnwield(1);
}

void set_start(object pl)
{
  object *inv;
  string zusatz;
  
  add_action("abc","",1);
  if (pos>=0) return;
  pos=0;
//alle fakeln zerstoeren - die soll man aus dem raum holen
  inv=all_inventory(pl);
  map_array(filter_array(inv,#'istlichtquelle),#'wegdamit);
//alle gezueckte Waffen finden ...
  inv=filter_array(inv,#'istgezuecktewaffe);
  if (sizeof(inv))
  {
    map_array(inv,#'ablegen);
    zusatz="entwinden sie Dir Deine Waffe und stecken sie "
           "Dir hoehnisch grinsend in Dein Inventar, welches sie "
           "noch durchsuchen, ";
  }
  else
    zusatz="durchsuchen sie noch Deine Sachen, ";
  tell_object(pl,break_string(
    "Du wirst von einigen Dunkelelfen grob weggezogen und in eine "
    "andere Hoehle verfrachtet. Dort werfen diese Dich ruecklings "
    "in einen riesiges Spinnennetz, in welchem Du haengen bleibst "
    "und Dich nicht mehr ruehren kannst. Danach "+zusatz+
    "waehrend sie etwas von verhasstem Licht "
    "faseln. Dies erledigt ueberlassen sie Dich Deinem Schicksal "
    "und verschwinden aus dem Raum, ohne das Du sehen koenntest, "
    "wie sie dies angestellt haben. Nachdem sie Dich verlassen "
    "haben erscheint ein unnatuerliches Licht im Raum."));
}

int abc(string str)
{
  string verb;
  string *commands;
  int i;
  
  if (pos>=POS_FREI) return 0; //wir koennen uns wieder bewegen ...

  if (IS_LEARNING(PL))
  {
    tell_object(PL,"Info: mschau ist eingeschaltet - "
                   "erlaubte Eingaben werden nicht geprueft.\n");
    return 0;
  }

  verb=query_verb();
  if (!strlen(verb)) return 1; // kann eigentlich nie sein ..
  if (member_array(query_verb(),ausnahmen)!=-1) return 0;
  if (verb[0]=='-') return 0; //die ebenen erlauben

//test auf alle erlaubten commandos im raum
  commands=({});
  for (i=0;i<=pos;i++) commands+=commandos[i];
  if (member_array(query_verb(),commands)!=-1) return 0;
  tell_object(PL,
    "Du haengst im Netz fest, und kannst dies zur Zeit nicht.\n");
  return 1;
}

//wenn keiner da ist, den clone zertoeren ...
void reset()
{
  ::reset();
  if (sizeof(filter_array(all_inventory(ME),#'interactive))) return;
  remove(1);
}

void BecomesNetDead(object spieler)
{
  spieler->move(AUSGANG,M_SILENT|M_NOCHECK);
  remove(1);
}

varargs mixed make_invlist(object viewer, mixed inv, int flags)
{
  if (pos>=POS_FREI) return ::make_invlist(viewer,inv,flags);
  return ""; //man sieht am anfang nix (man kann ja den kopf nicht bewegen)
}

varargs string GetExits( object viewer )
{
  if (pos>=POS_FREI) return ::GetExits(viewer);
  return 0;
}

mixed get_check_cmd(string in,string erlaubt,string fehler)
{
  string *words, *groups, *synon, *errmsg;
  int i,l,max,missing;

  if (!stringp(erlaubt) || !strlen(erlaubt)) return 1; //das commando ist erlaubt
  if (!stringp(fehler)) 
  { 
    raise_error("Fehlermeldung fehlt.\n"); 
    return 0; 
  }
  if (!stringp(in) || !strlen(in)) 
  {
    return efun::explode(fehler,"|")[0]+"\n";
  }
  words  = efun::explode(lower_case(in)," ");
  groups = efun::explode(erlaubt,"&");
  missing = -1;
  l=sizeof(groups);
  for (i=0;i<l;i++)
  {
    synon = efun::explode(groups[i], "|");
    if (!sizeof(synon & words)) 
    { // Kein Synonym gefunden?
       missing = i;
       break;
    }
  }
  if (missing>=0) 
  { // Schluesselwort fehlt
     if ((max=sizeof(errmsg=efun::explode(fehler, "|")))>missing)
     {
        return errmsg[missing]+"\n";
     }
     return errmsg[max-1]+"\n";
  }
  return 1;
}

public void fackel_angezuendet(object fackel, object pl)
{ //einige schutz ...
  if (pos!=POS_FREI-1) return;
  if (!objectp(fackel)) return;
  if (environment(fackel)!=pl) return;
  if (!fackel->_query_lighted()) return;
  tell_object(pl,break_string(
    "Kaum brennt Deine Fackel haeltst Du sie an das Spinnennetz, "
    "welches sofort Feuer faengt und in kuerzester Zeit lichterloh "
    "brennt. Mit einem Ruck kannst Du Dich befreien und bist "
    "heilfroh, auch wenn Du Dir bei dieser Aktion einige Brandwunden "
    "zugezogen hast."));
  pos=POS_FREI;
  return;
}

public string query_pos()
{
  return sprintf("POS (%d/%d) bei\n%d = Fuss befreit\n%d = Arme befreit\n"
                 "%d = vom Netz befreit\n",
                 pos,POS_MAX,POS_FUSSFREI,POS_ARMFREI,POS_FREI);
}

//alle kommandos unterdruecken
//pos:info
//0: Ganz fest   - hinweiss, das man einen fuss frei bekommen koennte
//2: 1 Fuss frei - man kann ein langen opferdolch und einen stein ertasten
//                 Hinweis, das man den Stein naeher heran rollen koennte
//3: Stein rollen
//4: Stein liegt - man muss mit dem fuss den dolch auf den stein heben
//5: Dolch liegt - man muss auf den Dolch kraeftig treten
//6: dolch bewegen - (schneiden) hand befreien ...
//7: hand frei   - fakel schieben
//8: fakel liegt - drauf treten ...
//9: Fakel haben - anzuenden
//10: befreit     - auswegsuchen
