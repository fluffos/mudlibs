mixed detail_fackel();
mixed detail_seite();
mixed detail_wippe();
mixed detail_norden();
mixed detail_loch();
mixed detail_hebel();
string smell_geruch();

string _query_int_long();

int cmd_verkante(string str);
int cmd_strecke(string str);
