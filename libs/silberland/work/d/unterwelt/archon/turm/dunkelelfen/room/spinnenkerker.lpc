int cmd_trete(string str)
{
  mixed ret;
  object ob;
  //umgehen der default-meldungen von augen rollen
  if (pos<4 || pos>8)
    return 0;
  
  if (pos<7)
   ret=get_check_cmd(str,
       "spitze|dolch&auf",
       "Worauf willst Du kraeftig treten?|"
       "Willst Du vielleicht AUF etwas kraeftig treten?");
  else
   ret=get_check_cmd(str,
       "fackel|stil&auf",
       "Worauf willst Du kraeftig treten?|"
       "Willst Du vielleicht AUF etwas kraeftig treten?");

  if (intp(ret) && ret!=1) return 0;
  if (stringp(ret))
  {
    write(ret);
    return 1;
  }
  switch(pos)
  {
    case 5:
      write(break_string("Du konzentrierst Dich und sprichst schnell eine "
        "Gebet. Dann trittst Du kraeftig auf die Spitze des Dolches, wodurch "
        "diese hinauf, und zu Deiner Freude, direkt in Deine Hand fliegt. "
        "Ein kurzer Schmerz durchzuckt diese, bevor Deine Finger sich um "
        "den Griff des Dolches schliessen. Trotz der Schmerzen kannst "
        "Du nur jubeln. Geschafft. Vielleicht kannst Du Dich nun doch "
        "befreien."));
       PL->AddHp(-10);
       ob=clone_object(WEAPON "dolch");
       ob->move(PL,M_SILENT|M_NOCHECK);
       ob->wield_me(1);
       pos=6;
    break;
    case 8:
      if (sizeof(filter_array(all_inventory(PL),#'istgezuecktewaffe)))
        return notify_fail("Du solltest erst Deine gezueckte Waffe wegstecken.\n"),0;
      write(break_string("Jetzt nachdem Du Deine Haende frei hast, "
        "hoffst Du die Fackel leicht zu fangen. Doch ist diese viel "
        "schwerer und unfoermiger als der Dolch, so dass es noch immer "
        "leicht daneben gehen kann. Trotz dieser Bedenken trittst Du "
        "einfach kraeftig auf die Fackel drauf, diese fliegt nach oben "
        "und Du kannst sie gerade so noch mit Deiner linken Hand erfassen "
        "und fest halten. Schnell nimmst Du die Fackel an Dich heran, "
        "bevor sie Dir noch aus der Hand faellt. Nun kannst Du endlich "
        "das Spinnennetz zerstoeren und Dich befreien."));
       ob=clone_object(OBJ "fackel");
       ob->move(PL,M_SILENT|M_NOCHECK);
       pos=9;
    break;
    default:
      write("Das macht jetzt wohl wenig Sinn.\n");
    break;
  }
  return 1;
}

