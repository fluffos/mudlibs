          "sprichst danach schnell ein Gebet und hoffst, dass Dein Plan "
          "auf geht."));
    return 1;
  }
  return 
    notify_fail("Aber der Dolch liegt doch schon auf dem Stein.\n"),0;
}

int cmd_schiebe_fackel(string str)
