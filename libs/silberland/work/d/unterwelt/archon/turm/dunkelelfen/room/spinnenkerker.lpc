*/

#pragma strict_types
#include "../def.h"
inherit "std/room";

//commandos die immer erlaubt sind - schlaf (ein) und ende ist nie erlaubt
//ein schutz vor BecomesNetDead ist aber vorhanden ...
#define ausnahmen ({"typo","bug","idee","teile","hilfe","schau","mschau", \
                    "info","wer","kwer","unt","untersuche","zeit","inv", \
                    "i","inventur","sag","'","denke","gruebel","verb", \
                    "schaue","denk","sage" })
//commandos die nach und nach erlaubt werden
#define commandos ({({"verkante","verkanten","streck","strecke","strecken"}), \
                    ({}), \
                    ({"taste","tasten","ertaste","ertasten"}), \
                    ({"roll","rolle","rollen"}), \
                    ({"schieb","schieben","schiebe"}), \
                    ({"tritt","trete","treten","tret"}), \
                    ({"schneide","schneiden","durchschneiden","losschneiden"}), \
                    ({}), \
                    ({"steck","stecke","stecken"}), \
                    ({"zuende","zuenden","anzuenden","zuend"}) })

#define AUSGANG  ROOM "tunnel_01" //schutz bei disconnect des spielers
#define POS_FUSSFREI 2
#define POS_ARMFREI 7
#define POS_FREI 10
#define POS_MAX  11

void create();
string detail_position();
string detail_koerper();
string detail_rest();
string detail_boden();
