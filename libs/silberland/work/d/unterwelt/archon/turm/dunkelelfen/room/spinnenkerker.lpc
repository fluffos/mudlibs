int exit_norden();
int exit_loch();

void init();
int istlichtquelle(object was);
void wegdamit(object was);
int istgezuecktewaffe(object ob);
void ablegen(object was);
void set_start(object pl);
int abc(string str);
void reset();
void BecomesNetDead(object spieler);
varargs mixed make_invlist(object viewer, mixed inv, int flags);
varargs string GetExits( object viewer );
mixed get_check_cmd(string in,string erlaubt,string fehler);

//aufruf beim anzuenden der gefundenen fackel
public void fackel_angezuendet(object fackel, object pl);
public string query_pos();

int    pos;   //fuer Position im Befreiungsversuch

void create()
{
  ::create();
  pos=-1; //nicht gestartet

  SetProp(P_INDOORS,1);
  SetProp(P_LIGHT,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_CAVE]));
  SetProp(P_INT_SHORT,"In einem Tunnel");
//damit schutz in tunnel_01 nicht umgangen wird und man nicht anders raus kommt
  SetProp(P_NO_TPORT,NO_TPORT);
  SetProp(P_NOQUIT,1); //eigentlich unnoetig da ende eh nicht zugelassen

  AddDetail(({"hoehle"}),#'_query_int_long);
  AddDetail(({"wesen","dunkelelfen","dunkelefe","gastgeber",
              "dunkelelfenkrieger","dunkelelfenmagier",
              "dunkelelfenpriesterinnen","dunkelelfenpriesterin"}),
    "Zum Glueck ist zur Zeit keiner da. Vielleicht kannst Du Dich von hier "
    "befreien, bevor Dich einer dieses dreckigen Dunkelelfenpriesterinnen "
    "abholt und zu einer Opferung schleift.");
  AddDetail(({"opfer"}),
    "Das bist wohl Du.");
  AddDetail(({"opferung","lage"}),
    "Du willst Dir lieber die Opferung gar nicht erst vorstellen, "
    "denn Du waerst dabei in keiner vorteilhaften Position.");
  AddDetail(({"position"}),#'detail_position);
  AddDetail(({"weile","warten"}),
    "Die Zeit vergeht.");
  AddDetail(({"zeit"}),
    "Viel hast Du davon nicht.");
  AddDetail(({"glueck"}),
    "Das koenntest Du hier gebrauchen, um mit heiler Haut zu entkommen.");
  AddDetail(({"haut","gaensehaut"}),
    "Hoffentlich wird sie Dir nicht bei lebendigem Leib abgezogen.");
  AddDetail(({"leib","koerper"}),#'detail_koerper);
  AddDetail(({"teil","koerperteil","koerperteile","teile"}),
    "Du koenntest Deinen Kopf, Deine Arme, Deine Haende, "
    "Deine Beine, Deine Fuesse und den gesamten Rest, wie "
    "Deinen Oberkoerper untersuchen.");
  AddDetail(({"rest","oberkoerper","ruecken"}),#'detail_rest);
  AddDetail(({"decke"}),
    "Die Decke ist nicht nur abstossend tiefschwarz, sondern auch noch "
    "von ekligen duennen Spinnenfaeden ueberzogen.");
  AddDetail(({"boden"}),#'detail_boden);
  AddDetail(({"kopf"}),#'detail_kopf);
  AddDetail(({"fuss","fuesse","bein","beine"}),#'detail_fuss);
  AddDetail(({"netz","spinnnetz","spinnennetze","spinnennetz","netzes"}),
    #'detail_netz);
  AddDetail(({"mitte"}),
    "Du weisst doch bestimmt wie ein Spinnennetz aussieht, oder? "
    "Dann weisst Du bestimmt auch, dass es eine Mitte hat.");
  AddDetail(({"spinne","spinnen","erschafferin"}),#'detail_spinne);
  AddDetail(({"wand","waende","stelle","stellen"}),
    "Die Waende sehen unheimlich aus. Dunkle klebrige Stellen und "
    "Spinnweben wechseln sich gegenseitig ab. Igitt Du willst "
    "die Waende nicht anfassen muessen.");
  AddDetail(({"zentimeter","millimeter"}),
    "Ohje Deine Allgemeinbildung laesst zu wuenschen uebrig.");
  AddDetail(({"bildung","allgemeinbildung"}),
    "Du hast doch eine, oder?");
  AddDetail(({"weben","spinnweben","spinnenweben"}),
    "Du siehst an den Waenden viele kleine Spinnennetze, Spinnenfaeden "
    "und Spinnenweben. Igitt - Du willst hier raus.");
  AddDetail(({"art","arten","faden","faeden","spinnenfaeden",
              "spinnenfaden","spinnfaden","spinnfaeden"}),#'detail_faeden);
  AddDetail(({"moeglichkeit","flucht","fluchtmoeglichkeit","weg"}),
    "Du willst hier nur mit heiler Haut heraus.");
  AddDetail(({"ausgang"}),
    "Du wuenschst Dir einen Ausgang herbei.");
  AddDetail(({"reste"}),
    "Viel ist davon nicht mehr uebrig.");
  AddDetail(({"spielraum"}),
    "Glaubst Du den hier zu finden?");
  AddDetail(({"hand","haende","arm","arme"}),#'detail_arm);
  AddDetail(({"finger"}),
    "Du bewegst Deine Finger. Schoen jeder einzelne gehorcht "
    "dem Befehl Deines Hirns.");
  AddDetail(({"hirn","gehirn","gehirns","hirns"}),
    "Oh hast Du es gefunden? Nun nix wie rein damit in Deinen Kopf.");
  AddDetail(({"befehl","befehle"}),
    "Wen willst Du hier befehligen?");
  AddDetail(({"scharf","scharfes","spitz","spitzes"}),
    "Was meinst Du damit?");
  AddDetail(({"messer"}),
    "Du siehst hier keins.");
  AddDetail(({"anfang"}),
    "Alles faengt irgendwo an.");
  AddDetail(({"gegenstand","gegenstaende"}),
    "Welchen Gegenstand meinst Du denn?");
  AddDetail(({"chance"}),
    "Du musst selbst die kleinste Chance nutzen, um hier heraus "
    "zu kommen.");
  AddDetail(({"plan"}),#'detail_plan);
  AddDetail(({"stein"}),#'detail_stein);
  AddDetail(({"ueberblick","gegebenheit","gegebenheiten","umgebung"}),
    "Schau Dich ruhig um, soweit wie es Dir moeglich ist.");
  AddDetail(({"zahn","zaehne"}),
    "Das haettest Du beinahe vergessen, natuerlich hast Du "
    "auch Zaehne.");
  AddDetail(({"schmerz","schmerzen"}),
    "Ohh mud Du pusten.");
  AddDetail(({"muskel","muskeln","beinmuskel","beinmuskeln"}),
    "Hast Du nichts besseres zu tun, als gerade jetzt Deine "
    "Muskeln zu untersuchen?");
  AddDetail(({"ruck"}),
    "Aehm ja - was wolltest Du damit erfahren?");
  AddDetail(({"mulde"}),#'detail_mulde); 
  AddDetail(({"form","formen"}),
    "Und nimmt Dein Plan langsam Formen an?");
  AddDetail(({"dolch"}),#'detail_dolch);
  AddDetail(({"fackel"}),#'detail_fackel);
  AddDetail(({"hilfe"}),
    "Die haettest Du jetzt bitter noetig.");
  AddDetail(({"seite"}),#'detail_seite);
  AddDetail(({"licht"}),
    "Dies ist wohl ein besonderes 'Geschenk' Deiner Gastgeber, "
    "um Dir Deine missliche Lage vor Augen zu fuehren.");
  AddDetail(({"geschenk"}),
    "Haha, Du findest dies ganz lustig.");
  AddDetail(({"auge","augen","spiegel"}),
    "Natuerlich hast Du Augen, womit koenntest Du sonst Deine "
    "Umgebung sehen, doch Deine eigenen Augen zu untersuchen "
    "geht ohne Spiegel ueber Deine Moeglichkeiten.");
  AddDetail(({"sinn"}),
    "Ist Dir langweilig? Oder weshalb gruebelst Du jetzt "
    "darueber nach?");
  AddDetail(({"wunder"}),
    "Ein Wunder koenntest Du jetzt gebrauchen.");
  AddDetail(({"geruch","verbranntem","luft"}),
    "Rieche lieber!");
  AddDetail(({"hilfsmittel","mittel","aktion"}),
    "Was koennte Dir helfen hier heraus zu kommen?");
  AddDetail(({"wunde","wunden","brandwunde","brandwunden"}),
    "Hast Du welche? Das heilt schon wieder.");
  AddDetail(({"vertrauen","selbstvertrauen"}),
    "Hast Du welches?");
  AddDetail(({"wippe"}),#'detail_wippe);
  AddDetail(({"norden"}),#'detail_norden);
  AddDetail(({"loch"}),#'detail_loch);
  AddDetail(({"hebel"}),#'detail_hebel);
  
  AddSound(({DEFAULT_SOUND}),
    "Nicht nur hier drinnen ist es leise, auch von draussen "
    "hoerst Du nichts.");
  AddSmell(({DEFAULT_SMELL,"geruch","verbranntem","luft"}),
    #'smell_geruch);
  
  AddCmd("verkante|verkanten&fuss|bein&rechten|recht|rechte|rechtes","cmd_verkante",
       "Was willst Du verkanten?|"
       "Welchen Fuss beziehungsweise welches Bein willst Du verkanten?");
  AddCmd("streck|strecke|strecken&fuss|bein&rechten|recht|rechte|rechtes","cmd_strecke",
       "Was willst Du strecken?|"
       "Welchen Fuss beziehungsweise welches Bein willst Du strecken?");
  AddCmd("taste|tasten|ertaste|ertasten&boden&fuss|bein","cmd_taste",
       "Was willst Du abtasten?|Womit willst Du den Boden abtasten?");
  AddCmd("roll|rolle|rollen","cmd_rolle");
  AddCmd("schieb|schiebe|schieben&dolch&auf&stein|wippe","cmd_schiebe_dolch",
       "Was willst Du worauf schieben?|"
       "Du willst wohl den Dolch AUF etwas schieben?|"
       "Worauf willst Du den Dolch schieben?");
  AddCmd("schieb|schiebe|schieben&fackel&auf&stein|wippe","cmd_schiebe_fackel",
       "Was willst Du worauf schieben?|"
       "Du willst wohl die Fackel AUF etwas schieben?|"
       "Worauf willst Du die Fackel schieben?");
  AddCmd("tritt|trete|treten|tret","cmd_trete");
  AddCmd("schneide|schneiden|durchschneiden|losschneiden&"
         "faden|faeden|spinnfaden|spinnfaeden|spinnenfade|spinnenfaeden&"
         "durch|ab|los","cmd_schneide",
         "Was willst Du schneiden?|Willst Du die Faeden DURCHschneiden?");
  AddCmd("befreie|befreien","cmd_befreie");
  AddCmd("fass|fasse|fassen&wand|waende","cmd_fasse",
         "Was willst Du anfassen?");
  AddCmd("zieh|ziehe|ziehen&hebel&rechts|rechten","cmd_ziehe_rechts",
         "Woran willst Du ziehen?|An welchem Hebel willst Du ziehen?");
  AddCmd("zieh|ziehe|ziehen&hebel&links|linken","cmd_ziehe_links",
         "Woran willst Du ziehen?|An welchem Hebel willst Du ziehen?");
  AddCmd("kriech|krieche|kriechen&loch","cmd_krieche",
         "Wo hinein willst Du kriechen?");
}

string detail_position()
{
  if (pos>=POS_FREI) 
    return break_string("Deine Position ist noch immer nicht rosig. "
      "Jederzeit koennten die Dunkelelfen kommen und Dich zu Deiner "
      "Opferung abholen, aber wenigstens haengst Du nicht mehr im "
      "Spinnennetz.");
  return break_string("Deine Position ist hoffnungslos. "
    "Jederzeit koennten die Dunkelelfen kommen und Dich zu Deiner "
    "Opferung abholen und Du kannst, solange Du hier im Spinnennetz "
    "haengst, ueberhaupt nichts dagegen unternehmen.");
}

string detail_koerper()
{
  if (pos>=POS_FREI)
    return break_string("Dein Koerper gehorcht Dir wieder, nachdem er nicht "
      "mehr im Spinnennetz fest haengt.");
  return break_string("Du - also Dein Koerper - haengt im Spinnennetz fest. "
    "Doch zum Glueck gibt es einzelne Koerperteile, die nicht oder nur "
    "teilweise fest haengen.");        
}

string detail_rest()
{
  if (pos>=POS_FREI)
    return "Du bist frei.\n";
  return "Leider haengst Du damit im Spinnennetz fest.\n";
}

string detail_boden()
{
  if (pos>=POS_FREI)
    return break_string("Der Boden ist eklig glitschig und voller "
      "duenner Spinnfaeden. Sieh nur zu, dass Du hier raus kommst.");
  if (pos>=POS_FUSSFREI)
    return break_string("Wenn Du mit Deinem Fuss tastest, kannst "
     "Du Dir einen Ueberblick ueber die Gegebenheiten am Boden "
     "verschaffen.");
  return break_string(
    "Leider kannst Du Deinen Kopf nicht genuegend bewegen, "
    "um den Boden zu sehen. Aber vielleicht kannst Du etwas mit "
    "Deinem Fuss ertasten?");
}

string detail_kopf()
{
  if (pos>=POS_FREI)
    return "Zum Glueck sitzt Dein Kopf noch dort wo er soll.\n";
  return break_string(
    "Zum Glueck kannst Du wenigstens Deinen Kopf ein wenig "
    "bewegen, auch wenn dies aufgrund einiger Spinnfaeden nur "
    "begrenzt moeglich ist.");
}

string detail_fuss()
{
  if (pos>=POS_FREI)
    return "Fuesse, Beine alles noch dran - Du atmest erleichtert auf.\n";
  if (pos>=POS_FUSSFREI)
    return break_string(
      "Zum Glueck konntest Du eines Deiner Beine befreien. Mit etwas "
      "Geduld, kannst Du mit Deinem Fuss den Boden abtasten und Gegenstaende "
      "bewegen. Vielleicht kannst Du Dich so befreien ...");
  return break_string(
    "Deine Fuesse und Beine haengen im Spinnnetz von einzelnen Spinnfaeden "
    "gehalten fest. Doch es fuehlt sich so an, als ob Du Dein rechtes Bein "
    "mit etwas verkanten und strecken befreien koenntest, da dieser nur von "
    "einigen wenigen duennen Faeden festgehalten wird.");
}

string detail_netz()
{
  if (pos>=POS_FREI)
    return break_string(
      "Zwar hast Du das das grosse Spinnennetz zerstoert, doch kannst "
      "Du noch immer einige Reste sehen. Du bekommst eine Gaensehaut "
      "und bist nur froh, dass Du Dich wieder frei bewegen kannst. "
      "Nun musst Du nur noch einen Weg hier heraus finden.");
  return break_string(
    "Du haengst in einem riesigen Spinnennetz fest. So sehr Du auch ziehst "
    "und zerrst, Du kommst einfach nicht los. Panik ueberkommt Dich, doch "
    "auch diese hilft Dir nicht. Schweissueberstroemt haengst Du weiterhin "
    "im Netz fest. Wieder klarer im Kopf erkennst Du, dass es zwei Arten "
    "von Spinnenfaeden gibt.");
}

string detail_spinne()
{
  if (pos>=POS_FREI)
    return break_string(
      "Das Netz ist weg, doch hoffentlich kommt nicht noch die Erschafferin "
      "hier her, denn noch immer waerst, ohne Fluchtmoeglichkeit Du ein "
      "leichtes Opfer fuer eine solch grosse Spinne.");
  return break_string(
    "Hoffentlich kommt nicht noch die Erschafferin dieses Netzes hier her. "
    "So wehrlos wie Du jetzt bist, koenntest Du nichts gegen eine solche "
    "grosse Spinne ausrichten.");
}

string detail_faeden()
{
  if (pos>=POS_FREI)
    return break_string(
      "Zum Glueck sind die Spinnenfaeden nun verbrannt. Nur ein paar "
      "verkohlte Reste kannst Du noch sehen.");
  return break_string(
    "Auch wenn Du im Spinnennetz gefangen bist, kannst Du doch erkennen, "
    "dass Dich zwei verschiedenen Arten von Faeden fest halten. Die einen "
    "sind duenner und lassen Dir einen kleinen Spielraum - haettest "
    "Du einen Messer oder etwas aehnliches, koenntest Du sie bestimmt "
    "durchschneiden. Die anderen hingegen sind dick und ein Messer wuerde "
    "Dir bei diesen nicht helfen. Aber brennbar sehen die Faeden alle "
    "aus - nur womit solltest Du sie anzuenden?");
}

string detail_arm()
{
  if (pos>=POS_FREI)
    return break_string(
      "Tut es gut die Arme und Haende wieder frei zu bewegen.");
  if (pos>=POS_ARMFREI)
    return break_string(
      "Deine Haende und Arme hast Du nun befreit, doch hilft "
      "Dir das nicht wirklich weiter, denn der Rest Deines Koerpers "
      "haengt an dicken Spinnenfaeden fest. Bei diesen wird "
      "Dir auch der Dolch nicht helfen. Aber vielleicht findest Du "
      "hier etwas anderes, um diese zu zerstoeren ...");
  return break_string(
    "Deine Arme und Haende haengen in den duennen Faeden des "
    "Spinnennetzes fest. Nur Deine rechte Hand kannst Du ein "
    "wenig bewegen. Haettest Du einen etwas Scharfes oder Spitzes "
    "in dieser, koenntest Du vielleicht den Spinnenfaden, "
    "welcher diese Hand und Arm fest haelt durchschneiden.");
}

mixed detail_plan()
{
  if (pos<=POS_FUSSFREI || pos>=POS_FREI) return 0;
  switch(pos)
  {
    case 3:
     return break_string("Du solltest vielleicht erst einmal den "
      "ertasteten Stein in die Mulde rollen. Danach kann man den "
      "vielleicht als Wippe nutzen, um Gegenstaende hinauf "
      "zu schleudern. Auch wenn Du nicht glaubst, dass dies "
      "eine gute Idee ist, scheint es doch Deine einzige Chance "
      "zu sein.");
    break;
    case 4:
     return break_string("So der leichte Teil waere geschafft. "
      "Der Stein liegt direkt vor Deinem Fuss, nun solltest Du "
      "versuchen den Dolch so auf die abgeflachte obere Seite des "
      "Steines zu schieben, dass Du so auf die Spitze treten kannst, "
      "dass der Dolch hinauf zu Deiner Hand geschleudert wird. "
      "Dafuer brauchst Du unheimlich viel Glueck.");
    break;
    case 5:
     return break_string("Nun beginnt die Stunde der Wahrheit. "
      "Der Dolch liegt fuer Deinen aberwitzigen Plan genau richtig. "
      "Mit viel Glueck wird dieses, wenn Du kraeftig auf die Spitze des "
      "Dolches trittst direkt in Deine Hand fliegen. Das Schlimmste, "
      "was Dir passieren kann, ist das der Dolch danach ausserhalb "
      "Deiner reichweite liegt, oder Du Dein eigenes Herz triffst. "
      "Aber egal wie, tot bist Du dann auf jeden Fall. Entweder "
      "gleich oder etwas spaeter bei Deiner Opferung.");
    break;
    case 6:
     return break_string("Nachdem Du nun in Deiner rechten Hand "
      "den Dolch haelts, wie waere es, wenn Du endlich Deine Arme "
      "befreist, indem Du die duennen Spinnenfaeden durchschneidest, "
      "welche diese halten?");
    break;
    case 7:
     return break_string("So jetzt brauchst Du Die Fackel. "
      "Zunaechst solltest Du sie genauso wie den Dolch auf "
      "den Stein schieben.");
    break;
    case 8:
     return break_string("Du wischst Dir den Schweiss aus dem "
      "Gesicht. Du hast es fast geschafft. Jetzt musst Du nur "
      "noch die Fackel fangen, wenn Du sie genau wie Du es bei "
      "dem Dolch gemacht hast, kraeftig auf diese trittst. "
      "Hoffentlich fliegt sie Dir dann direkt in Deine "
      "Haende.");
    break;
    case 9:
     return break_string("Worauf wartest Du - los zuende die "
      "Fackel an.");
    break;
    default:
     return "Null Plan.\n"; //kann nicht vorkommen
    break;
  }
}

mixed detail_stein()
{
  if (pos<=POS_FUSSFREI) return 0;
  if (pos>=POS_FREI)
    return break_string(
      "Du siehst einen runden Stein, der in einer Mulde "
      "liegt und oben eine abgeflachte Seite besitzt. Man koennte "
      "auf ihn Gegenstaende platzieren, ohne dass diese von ihm "
      "herunter fallen wuerden.");
  if (pos==3)
    return break_string("Du hast neben Deinem Fuss einen Stein ertastet.");
  if (pos==5)
    return break_string("Auf dem Stein liegt ein Dolch - jedenfalls "
      "hoffst Du dies, da Du diesen gerade auf den Stein geschoben "
      "hast.");
  return break_string("Du hast den vorher ertasteten Stein in eine "
    "Mulde gerollt. Nun liegt der Stein so, dass oben eine abgeflachte "
    "Seite ist, auf welcher Gegenstaende liegen koennten, ohne von "
    "dem runden Stein herunter zu rutschen.");
}

mixed detail_mulde()
{
  if (pos<=POS_FUSSFREI) return 0;
  if (pos==3)
    return break_string("Direkt vor Deinem rechten Fuss ist eine Mulde, "
      "dort wuerde der ertastete Stein genau hinein passen.");
  return 
    "In der Mulde liegt ein Stein, den Du selber dorthin gerollt hast.\n";
}

mixed detail_dolch()
{
  if (pos<=POS_FUSSFREI) return 0;
  if (pos>5) return 0;
  if (pos==5) return "Der Dolch liegt jetzt auf dem Stein.\n";
  return "Auf dem Boden kannst Du einen Dolch ertasten.\n";
}  

mixed detail_fackel()
{
  if (pos<=POS_FUSSFREI) return 0;
  if (pos>8) return 0;
  return "Auf dem Boden kannst Du eine Fackel ertasten.\n";
}  

mixed detail_seite()
{
  if (pos<=3) return 0;
  return break_string(
    "Der runde Stein, welcher auf dem Boden liegt hat oben eine "
    "abgeflachte Seite, auf der etwas liegen kann, ohne das es herunter "
    "rutscht.");
}

mixed detail_wippe()
{
  if (pos<=POS_FUSSFREI) return 0;
  return break_string("Der runde Stein kann vielleicht als Wippe "
    "benutzt werden, um Gegenstaende hoch zu schleudern.");
}

mixed detail_norden()
{ 
  if (!mappingp(QueryProp(P_NEW_EXITS))) return 0;
  if (!mappingp(QueryProp(P_NEW_EXITS)["norden"])) return 0;
  return break_string("Im Norden kannst Du den Kerker durch die "
    "durchscheinende Wand verlassen. Doch solltest Du dies nicht "
    "versuchen, da Du ansonsten nur wieder hier im Kerker landen "
    "wuerdest.");
}

mixed detail_loch()
{
  if (!mappingp(QueryProp(P_NEW_EXITS))) return 0;
  if (!mappingp(QueryProp(P_NEW_EXITS)["loch"])) return 0;
  return break_string("Unter dem Hebel ist ein schmales Loch. "
    "Wenn Du hier ungesehen heraus willst, wird Dir wohl nichts "
    "anderes uebrig bleiben, als Dein Glueck dort zu suchen.");
}

mixed detail_hebel()
{
  if (pos<POS_MAX) return 0;
  return "Es gibt einen rechten und einen linken Hebel.\n";
}

string smell_geruch()
{
  if (pos<POS_FREI) 
    return "Es riecht hier verwest.\n";
  return break_string(
    "Es riecht hier verbrannt, dies ist auch kein Wunder nachdem Du das "
    "Netz verbrannt hast.");
}

string _query_int_long()
{
  string ret;
  switch(pos)
  {
    case 9:
      ret="Nun schau Dich nicht so neugierig um, hier hat sich nichts "
          "veraendert. Zuende lieber endlich Deine Fackel an und "
          "brenne damit das verdammte Netz ab. Danach hast Du noch "
          "genug Zeit nach einem Ausgang zu suchen.";
    break;
    case 8:
      ret="Zur Zeit interessiert Dich Deine Umgebung ueberhaupt nicht. "
          "Du hoffst nur, dass Du die Fackel faengst, wenn Du gleich "
          "versuchen wirst sie mit Deinen Fuessen hinaufzuschleudern. "
          "Wenn dies nicht klappt, war alles umsonst und Du bleibst "
          "bis zur Opferung hier gefangen.";
    break;
    case 7:
      ret="Du fuehlst Dich schon viel besser. Immerhin hast Du jetzt "
          "Deine Arme befreit. Doch Du solltest Dich nicht zu frueh "
          "freuen. Noch musst Du auch den Rest aus dem Netz befreien "
          "und dann noch einen Weg hier heraus finden.";
    break;
    case 6:
      ret="Innerlich jubelst Du, denn Dein aberwitziger Plan hat geklappt. "
          "Du haeltst den Dolch in Deiner Hand. Wie waere es, wenn Du ihn "
          "nun dazu benutzt, um wenigstens Deine Haende und Arme zu "
          "befreien. Auch wenn Du Deinen Oberkoerper leider so nicht "
          "befreien kannst, da dieser von dicken Spinnweben gehalten "
          "wird.";
    break;
    case 5:
      ret="Zur Zeit interessiert Dich Deine Umgebung ueberhaupt nicht. "
          "Du hoffst nur, dass Du den Dolch, welcher vor Dir auf einem "
          "Stein liegt, irgendwie hinauf in Deine Hand bekommst. "
          "Langes Warten hat wohl kaum einen Sinn.";
    break;
    case 4:
      ret="Trotzdem Du im Spinnennetz gefangen bist, ist es Dir gelungen "
          "einen Stein direkt vor Deinen Fuessen in einer Mulde zu "
          "platzieren. Wie Du nun ertasten konntest, ist die obere Seite "
          "des Steines ist abgeflacht. Ausserdem hattest Du schon einen Dolch "
          "und eine Fackel am Boden ertastest. Nur wie bekommst Du diese "
          "Hilfsmittel hinauf in Deine Haende, wo sie Dir etwas bringen "
          "koennten?";
    break;
    case 3:
      ret="Noch immer bist Du im Spinnennetz gefangen, doch nun kannst "
          "Du nicht nur Deinen Kopf leicht, sondern auch Dein rechtes "
          "Bein komplett bewegen. Mit der Hilfe Deines Fusses konntest "
          "Du Dir sogar einen kleinen Ueberblick ueber die Gegebenheiten "
          "am Boden verschaffen. Du weisst, dass dort eine Mulde ist, "
          "sowie ein Stein, eine Fackel und ein Dolch liegen. Und einen "
          "Plan hast Du jetzt auch, oder?";
    break;
    case 2:
      ret="Noch immer bist Du im Spinnennetz gefangen, doch nun kannst "
          "Du nicht nur Deinen Kopf leicht, sondern auch Dein rechtes "
          "Bein komplett bewegen. Vielleicht kann Dir dies helfen Dich "
          "hier zu befreien. Leider kannst Du noch immer nicht Deine "
          "Arme und Haende befreien, so sehr Du Dich auch bemuehst. "
          "Aber irgend einen Weg muss es einfach geben.";
    break;
    case 1:
      ret="Trotz verkantetem rechtem Bein bist Du weiterhin im Spinnennetz "
          "gefangen. Aber wenn Du diesen streckst, kannst Du wenigstens "
          "den rechten Fuss befreien. Du weisst zwar noch nicht, was "
          "Dir dies bringen sollen. Aber dadurch waere ein Anfang gemacht. "
          "Jedenfalls solltest Du etwas unternehmen, bevor die "
          "Dunkelelfenpriesterinnen kommen und Dich abholen.";
    break;
    case 0:
      ret="Du bist in einem grossen Spinnennetz gefangen. Du kannst "
          "weder Deine Beine noch Deine Haende ruehren, denn "
          "diese haengen, wie der Rest Deines Koerpers, an den "
          "zentimeterdicken Spinnenfaeden des Netzes fest. Nur Deinen Kopf "
          "kannst Du leicht bewegen und erkennst so das grosse Spinnennetz, "
          "in welchem Du haengst. Es sieht ganz so aus, als ob Du hier "
          "nicht wegkommst, bevor die Dunkelelfenpriesterinnen "
          "Dich fuer die Opferung abholen.";
    break;
    default:
      ret="Du bist in einer Hoehle, welche voller Spinnweben ist. "
          "Aus dem grossen Netz konntest Du Dich zum Glueck befreien. "
          "Nun zeugt nur noch der Geruch von Verbranntem davon, "
          "dass es je existiert hat. Doch noch bist Du nicht wirklich "
          "frei. Noch immer umgeben Dich an den Waenden Unmengen von "
          "Spinnenweben und Du siehst keinen Weg hier heraus.";
    break;
  }
  return break_string(ret);
}

int cmd_verkante(string str)
{
  if (pos==0)
  {
    pos=1;
    write(break_string(
      "Du verkantest Deinen rechten Fuss. Wenn Du ihn jetzt streckst, muesstest "
      "Du ihn eigentlich befreien koennen."));
    return 1;
  }
  if (pos==1)
    return notify_fail("Aber Dein Fuss ist doch schon verkantet.\n"),0;
  return notify_fail("Was soll Dir das jetzt bringen?\n"),0;
}

int cmd_strecke(string str)
{
  if (pos==1)
  {
    pos=2;
    write(break_string(
      "Du streckst Deinen rechten Fuss und spannst alle Deine Beinmuskeln "
      "an. Langsam ist der Schmerz im Fuss nicht mehr auszuhalten, und es "
      "sieht so aus, als ob dies alles nichts bringt, doch dann gibst Du "
      "Dir noch einen Ruck und beisst die Zaehne zusammen. Ploetzlich "
      "loest sich Dein Bein von dem Spinnenfaden und Deine Ferse kracht "
      "auf den Boden. Hurra, Dein rechtes Bein ist frei."));
    return 1;
  }
  if (pos==0)
    return notify_fail("Dies bringt jetzt noch nichts.\n"),0;
  return notify_fail("Was soll Dir das jetzt bringen?\n"),0;
}

int cmd_taste(string str)
{
  if (pos<POS_FUSSFREI) return 0;
  if (pos==2 || pos==3)
  {
    pos=3;
    write(break_string("Vorsichtig tastest Du mit Deinem Fuss den "
      "Boden ab. Direkt vor Deinem Fuss kannst Du eine Mulde ertasten. "
      "Rechts daneben liegt ein etwa handgrosser runder Stein und "
      "daneben ertastest Du eine Fackel. Auf der anderen Seite der "
      "Mulde kannst Du einen langen spitzen Gegenstand, vielleicht "
      "einen Dolch, erfuehlen. Du gruebelst eine Weile vor Dich hin "
      "und ein Plan beginnt in Deinem Kopf Formen anzunehmen."));
    return 1;
  }
  if (pos>=POS_FREI)
    return notify_fail("Was soll dies jetzt noch bringen?\n"),0;
  if (pos==POS_ARMFREI)
    return notify_fail(break_string(
      "Du weisst Doch das auf dem Boden noch eine Fackel liegt. "
      "Nun weiter im Plan und hole Dir diese Fackel.")),0;
  if (pos==4)
  {
    write(break_string("Vorsichtig tastest Du mit Deinem Fuss den "
      "Boden ab. Direkt vor Deinem Fuss liegt in einer Mulde ein "
      "etwa handgrosser runder Stein und weiter rechts eine Fackel. "
      "Auf der anderen Seite des Steines kannst Du einen langen "
      "spitzen Gegenstand, vielleicht einen Dolch, erfuehlen. "
      "Wie soll es jetzt weiter gehen? Was sieht Dein Plan jetzt vor?"));
    return 1;
  }
  if (pos==5)
  {
    write(break_string("Nun taste hier nicht soviel rum, sonst "
      "faellt Dir nur der Dolch wieder runter. Tritt endlich auf "
      "diesen kraeftig drauf und hoffe, dass er so hochschnellt, "
      "das Du ihn mit einer Hand fassen kannst. Sehr wahrscheinlich "
      "ist dies zwar nicht, aber es ist Deine einzige Chance."));
    return 1;
  }
  write("Nun taste hier nicht soviel rum, Du hast wichtigeres zu tun.\n");
  return 1;
}

int cmd_rolle(string str)
{
  mixed ret;
  //umgehen der default-meldungen von augen rollen
  if (pos<3)
    return 0;

  ret=get_check_cmd(str,
       "stein&in&loch|mulde",
       "Was willst Du rollen?|"
       "Willst Du den Stein vielleicht IN etwas rollen?|"
       "Wohin willst Du den Stein rollen?");

  if (intp(ret) && ret!=1) return 0;
  if (stringp(ret))
  {
    write(ret);
    return 1;
  }

  if (pos==3)
  {
    pos=4;
    write(break_string("Du stellst Deinen Fuss neben den Stein und "
      "rollst diesen in die Mulde. Nun liegt dieser fest direkt vor "
      "Deinen Fuessen und Du koenntest ihn als Wippe dazu benutzen "
      "etwas zu Dir hinauf zu schleudern."));
    return 1;
  }
  write("Du hast den Stein doch schon in die Mulde gerollt.\n");
  return 1;
}

