#pragma strict_types
#include "../def.h"
inherit STD "dunkelelf";

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_LOG_INFO,"archon/delfen.rep");
  AddLibrary(LIB "info.lib",1); 
  P_ARCHON_NPCMASTER->add_npc(ME,2); //boeser npc

  SetProp(P_SHORT,"Der Dunkelelfenkrieger gehoert zu einer Patrouille");
  SetProp(P_LONG,
    "Die Dunkelelfenkrieger sind Meister im Umgang mit ihrem "
    "Krummschwert und haben neben flinken Haenden auch einen unbeugsamen "
    "Willen. Dieser laesst sie auch unter grossen Schmerzen weiter "
    "kaempfen, als waeren sie topfit.");
  AddDetail(({"meister","umgang"}),
    "Die Krieger sind Meister im Umgang mit ihren Schwertern.");
  AddDetail(({"haende"}),
    "Die Krieger haben zwei.");
  AddDetail(({"wille","schmerzen"}),
    "Naja, die Krieger sind eher selbstmoerderisch.");
  AddDetail(({"krummschwert","krummschwerter","schwert","schwerter"}),
    "Die Krummschwerter der Krieger sind edle Schwerter.");

  SetProp(P_NAME, "Dunkelelfenkrieger");
  SetProp(P_GENDER, MALE);
  AddId(({"dunkelelf","Schwertmeister","krieger","dunkelelfenkrieger"}));

  create_default_darkelf(25+random(6));
  SetProp(P_SPELLRATE,0); //Kaempfer!!

  SetProp(P_ALIGN, -950);

  clone_object(WEAPON "krummschwert")->move(ME,M_NOCHECK);
  command_me("zuecke schwert");
}

void init()
{
  string race;
  int t;
  ::init();
  if (QueryProp(P_ARCHON_ENDFIGHT)) return;
  if (!PL || !interactive(PL)) return;
  race=(string)PL->QueryProp(P_RACE);
  if (race!="Dunkelelf")
  {
    t=(int)PL->QueryProp(P_DARKELF_DISGUISE); //ist eine zeitliche begrenzung
    if (time()>t)
    {
      if (!IS_WIZARD(PL) || !PL->QueryProp(P_WANTS_TO_LEARN))
        Kill(PL); //alle nicht dunkelelfen angreifen, ausser sie sind getarnt
    }
  }
}
