#include "../def.h"

inherit "/std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT,"");
  SetProp(P_INT_LONG,"");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );
  SetProp(P_HIDE_EXITS, 1);

  SetProp(P_HIDE_EXITS, ({"aufgabe"}) );
  AddSpecialExit( "aufgabe", "aufgabe" );

  previous_object()->CustomizeObject();
}

int aufgabe(string str)
{
  notify_fail("Dazu ist es nun zu spaet.\n");
  return 0;
}

void init()
{
  ::init();

  if(query_once_interactive(TP)) call_out("blubber", 4, 1,TP);
}

void blubber(int step, object pl)
{
  string s;

  if(!pl)              return;
  if(!interactive(pl)) return;
  if(ENV(pl) != TO)    return;

  switch(step)
  {
    case 1:
      s = "Du faellst immer schneller...";
      break;

    case 2:
      s = "...der Brunnen des Schlosshofes rast auf Dich zu...";
      break;

    case 3:
      s = "...krachend durchschlaegst Du das Gitter welches auf dem "
          "Brunnen lag...";
      break;

    case 4:
      s = "...Du wusstest gar nicht, wieviel Knochen einem so weh tun "
          "koennen...";
      break;

    case 5:
      s = "...mit einem dumpfen Schmatzer landest Du im Morast des "
          "Brunnens...";
      break;

    case 6:
      pl->move(ROOM "brunnen.lpc", M_GO, "", "",
               pl->Name()+" faellt von oben herunter.\n");

      pl->SetProp(P_KILLER, TO);
      SetProp(P_KILL_NAME, "Ein verdammt harter Aufprall");

      pl->do_damage(50);
      if(pl->QueryProp(P_GHOST))
      {
        FMASTER->Msg(TPUID+" stirbt im Brunnen");
        return;
      }

      tell_object(pl,"...und Du wirst ohnmaechtig!\n\n\n");
      pl->SetProp(P_PARALYZED,
        ([PARALYZE_TIME: random(8)+5,
          PARALYZE_MSG: "Aber Du bist doch ohnmaechig!\n",
          PARALYZE_MSG_OTHER: "stoehnt auf.\n",
          PARALYZE_END: "Du erwachst wieder aus Deiner Ohnmacht.\n",
          PARALYZE_END_OTHER: pl->Name()+" wird wieder munter.\n"]));
      return;
      break;
  }

  tell_object(pl,"\n"+s+"\n\n");
  call_out("blubber", 4, ++step, pl);
  return;
}

