#include "../def.h"
inherit "std/room";

void create();

#define ausnahmen ({"typo","bug","idee"})

object owner;
string goto_raum;

void create() 
{
  ::create();
  SetProp(P_INDOORS, 1); 
  SetProp(P_LIGHT, 0); 
  SetProp(P_INT_SHORT,"In einem engen Tunnel");

  previous_object()->CustomizeObject();
}

string _query_int_long()
{
  return "";
}

string GetExits(object viewer,int short)
{
  return "";
}

int abc()
{
  if (member_array(query_verb(), ausnahmen) != -1) return 0;
  tell_object(owner, "Krieche lieber weiter, dafuer hast Du jetzt keinen Atem.\n");
  return 1;
}

void set_owner(object pl,string wohin)
{
  add_action("abc","",1);
  owner=pl;
  goto_raum=wohin;
  call_out("krieche",3,0);
}

void krieche(int pos)
{
  if (!objectp(owner) || environment(owner)!=ME)
    return; //nix mehr machen
/*
  {
    remove(1);
    return;
  }
*/
  switch(pos)
  {
    case 0: //wird schon gleich ausgegeben
      tell_object(owner,"Du kriechst eine Weile in dem schwachen Licht.\n");
    break;
    case 1: 
      tell_object(owner,"Ploetzlich fluchst Du, als Du Dich an einer "
        "scharfen Kante schneidest.\n");
      owner->AddHp(-2);
    break;
    case 2:
      tell_object(owner,"Du denkst bei Dir .o( Langsam koennte der Tunnel "
        "aber einmal aufhoeren. )\n");
    break;
    case 3: 
      tell_object(owner,break_string(
       "Du hast das Ende des engen Tunnels erreicht und wechselst aus dem "
       "Kriechtunnel in eine Hoehle ueber."));
    break;
    case 4: 
      owner->move(goto_raum,M_GO,"","verschwindet","erscheint");
    break;
  }
  call_out("krieche",3,pos+1);
}
