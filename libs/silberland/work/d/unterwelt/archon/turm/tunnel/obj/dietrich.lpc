inherit "std/thing"; 
#include "../def.h"

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT,"Ein Dietrich");
  SetProp(P_LONG,
    "Dies ist ein ganz einfacher Dietrich, mit dem Du bestimmt "
    "nicht viele Schloesser aufbekommen wirst. Er sieht nicht besonders "
    "stabil aus, so dass Du beim Knacken von Schloessern vorsichtig "
    "damit umgehen solltest.");
  
  SetProp(P_VALUE,1);
  SetProp(P_NOBUY,1);
  SetProp(P_WEIGHT,100);
  SetProp(P_MATERIAL,([MAT_IRON:100]));
  SetProp(P_NAME,"Dietrich");
  SetProp(P_GENDER,MALE);
  
  AddId(({"dietrich","\ndietrich"}));
}
