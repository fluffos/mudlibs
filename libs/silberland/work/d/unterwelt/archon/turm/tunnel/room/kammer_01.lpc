#pragma strict_types
#include "../def.h"
inherit STD "kammer";

void create();
void init();
void begruessung(object pl,string von_wo);

int cmd_schwimmen(string str);
int cmd_kriechen(string str);
int cmd_schlagen(string str);
int exit_westen();

object c;

void create()
{
  ::create();

  AddId("wasser"); //damit man wasser finden kann - patch

  SetProp(P_INT_LONG,
    "Du befindest Dich in einer geraeumigen Kammer oder einer kleinen "
    "Hoehle. Der Boden ist mit dichtem, leuchtenden Moos bewachsen und ein "
    "kleiner Fluss entspringt der Nordwand und verschwindet nach ein paar "
    "Metern in einem Loch der Ostwand. Die Kammer ist laenger als breit "
    "und zieht sich mehrere Meter hin, bevor sie im Suedosten eine sanfte "
    "Biegung beschreibt. Im Westen erkennst Du den Eingang zu einem Tunnel.");
    
  AddDetail(({"umgebung","kammer","raum","hoehle","teil"}),
    QueryProp(P_INT_LONG));
  AddDetail(({"loch","loecher"}),
    "Es gibt hier zwei Loecher. Das eine fuehrt zu dem Kriechtunnel im "
    "Westen, durch welchem Du hierher gekommen bist und in dem anderen "
    "verschwindet der Fluss und reisst alles in seinem Sog mit.");
  AddDetail(({"westen"}),
    "Im Westen kannst Du die Kammer durch den Tunnel kriechend wieder "
    "verlassen.");
  AddDetail(({"tunnel","kriechtunnel"}),
    "Durch diesen Tunnel bist Du hier herein gekommen. Wenn Du nicht "
    "mehr genau weisst, wie es dort war, kannst Du ja einfach zurueck "
    "kriechen.");
  AddDetail(({"sog"}),
    "Obwohl nur ein kleiner Fluss beziehungsweise ein groesserer Bach "
    "durch die Kammer fliesst, ist der Sog, dort wo dieser in der "
    "Wand verschwindet, sehr gross und allem Anschein nach "
    "sehr lebendig. Baden oder schwimmen solltest Du hier auf gar keinen "
    "Fall!");
  AddDetail(({"anschein"}),
    "Sicher bist Du Dir nicht.");
  AddDetail(({"lebewesen","wesen"}),
    "Ob der Sog wirklich lebt?");
  AddDetail(({"fluss","bach","strom"}),
    "Ein kleiner Fluss entspringt der Nordwand und fliesst alles mit "
    "sich reissend nach Osten, um dort in einem Loch zu verschwinden. "
    "Der gesamte nordoestliche Teil der Kammer ist vom Wasser ueberflutet. "
    "Der Strom fliesst sehr schnell und wird eine Unachtsamkeit gnadenlos "
    "ausnutzen. Als Du den Fluss betrachtest, hast Du fast den Eindruck, "
    "dass der Sog ein Lebewesen sei.");
  AddDetail(({"weg"}),
    "Der Fluss suchst sich seinen eigenen Weg.");
  AddDetail(({"unachtsamkeit","fall"}),
    "Du willst Dir gar nicht vorstellen, was passiert, wenn Du in den "
    "Sog des Flusses geraetst.");
  AddDetail(({"wasser"}),
    "Der Fluss fuehrt recht viel Wasser mit sich, welches schnell "
    "fliessend in der oestlichen Wand verschwindet.");
  AddDetail(({"eindruck"}),
    "Du musst Dich getaeuscht haben.");
  AddDetail(({"boden"}),
    "Der Boden ist mit dichtem Moos bewachsen und federt bei jedem "
    "Deiner Schritte nach. Die Weichheit des Mooses laedt dazu ein "
    "hier zu rasten, oder sogar ein Lager aufzuschlagen.");
  AddDetail(({"biegung"}),
    "Die Kammer beschreibt nach Suedosten eine Biegung und geht dort "
    "weiter. Du koenntest ja auch einmal nach Suedosten gehen und schauen, "
    "was es dort noch gibt.");
  AddDetail(({"lager"}),
    "Ob Du hier ein Lager aufschlagen solltest.");
  AddDetail(({"nordwand","norden"}),
    "In der Nordwand entspringt der Fluss.");
  AddDetail(({"ostwand","osten"}),
    "In der oestlichen Wand verschwindet der Fluss alles mit sich reissend "
    "in einem Loch.");
  AddDetail(({"suedwand","sueden"}),
    "Eine ganz normale Felswand, welche der Kammer weiter nach Suedosten "
    "folgt.");
  AddDetail(({"westwand"}),
    "In der Westwand siehst Du den Ausgang beziehungsweise Eingang des "
    "Kriechtunnels, durch welchen Du hierher gekommen bist.");
  AddDetail(({"ausgang"}),
    "Der Ausgang liegt im Westen und ist gleichzeitig der Eingang zum "
    "Kriechtunnel.");
  AddDetail(({"eingang"}),
    "Im Westen kannst Du wieder durch den Tunnel zurueckkriechen.");
  AddDetail(({"suedosten"}),
    "Dort geht die Kammer weiter.");
  AddDetail(({"meter","metern"}),
    "Dies ist eine Masseinheit und wird dazu verwendet, damit Du eine "
    "Vorstellung von der Entfernung erhaeltst.");
  AddDetail(({"vorstellung"}),
    "Hast Du viel Phantasie?");
  AddDetail(({ "phantasie", "fantasie" }),
    "Wenn Du welche hast, dann kannst Du Dir ja den Raum vorstellen.");
  AddDetail(({"masseinheit","einheit"}),
    "Frag Deinen Physiklehrer, wenn Du das nicht mehr weisst.");
  AddDetail(({"lehrer","physik","physiklehrer"}),
    "Du weisst doch noch wer oder was das war, oder?");
  AddDetail(({"entfernung","detail"}),
    "Was bezweckst Du damit, wenn Du dieses Detail untersuchst?");
  
  AddSmell(({DEFAULT_SMELL,"moos","luft","geruch"}),
    "Der Geruch von frischen Moos liegt in der Luft.");  
  AddSound(({"ruhe","stille","still",DEFAULT_SOUND}),
    "Es ist hier angenehm still. Nur das Rauschen des Flusses ist zu hoeren.");
  AddSound(({"rauschen","fluss","bach","wasser"}),
    "Das Wasser des Flusses rauscht, waehrend es sich seinen Weg zu der "
    "oestlichen Wand bahnt.");

  AddItem(NPC "caroll",REFRESH_DESTRUCT);
  
  AddCmd(({"bade","baden","schwimm","schwimme","schwimmen"}),#'cmd_schwimmen);
  AddCmd(({"kriech","krieche","kriechen"}),#'cmd_kriechen);
  AddCmd(({"raste","schlag","schlage","schlagen","mach","mache",
           "errichte","errichten"}),#'cmd_schlagen);
  
  AddExit("suedosten",ROOM "kammer_02");
  AddExit("westen", #'exit_westen);
}

void init()
{
  object ob;
  ::init();
  if (!PL || !objectp(PL)) return;
  if (!interactive(PL)) return; 
  ob=(object)PL->QueryProp(P_LAST_COMMAND_ENV);
  if (!objectp(ob)) return; //fuer die magier, die ihr env zerstoert haben
  if (!objectp(c)) c=present("caroll",ME);
  if (c) call_out("begruessung",1,PL,file_name(ob));
}

void begruessung(object pl,string von_wo)
{
  int pos;
  if (!c || !pl || environment(pl)!=ME) return;
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(pl);
  if (c->InFight())
  {
    if (!c->IsEnemy(pl))
     tell_object(pl,break_string(
      "Caroll bekommt Dich nicht mit, da er in einem "
      "Kampf verwickelt ist."));
    return;
  }
  if (pos>8)
  { //quest fertig
    c->end_quest(pl);
    return;
  }
  if (von_wo == (ROOM "vorkammer"))
  {
    if (pos)
    {
      if (pos==2)
      {
        tell_room(ME,break_string(
          "Na,"+pl->name(WER,NAME_AUTO)+" kommst Du nicht voran? "
          "Fehlt Dir etwa ein bestimmter Zauber?",78,"Caroll brummt:"));
      }
      else
       tell_room(ME,break_string(
        "Caroll fragt: Wie kommst Du voran, "+pl->name(WER,NAME_AUTO)+"?"));
      return;
    }
    tell_room(ME,break_string(
      "Caroll stellt sich angriffslustig vor "+pl->Name(WER,NAME_AUTO)+
      " hin und brummt:\nWas hast Du hier verloren? Scher Dich hinaus. Das hier "
      "ist mein Zufluchtsort!",78,0,BS_LEAVE_MY_LFS),({pl}));
    tell_room(ME,break_string("Gerade will er "+pl->Name(WER,NAME_AUTO)+" angreifen, "
      "als er es sich anders ueberlegt und ein fieses Laecheln "
      "aufsetzt."),({pl}));
    tell_object(pl,break_string(
      "Caroll stellt sich angriffslustig vor Dich hin und brummt:\n"
      "Was hast Du hier verloren? Scher Dich hinaus. Das hier "
      "ist mein Zufluchtsort!",78,0,BS_LEAVE_MY_LFS));
    tell_object(pl,break_string("Gerade will er Dich angreifen, "
      "als er es sich anders ueberlegt und ein fieses Laecheln "
      "aufsetzt."));
    tell_room(ME,break_string(
      "Caroll schmeichelt: Oder bist Du gekommen, um "
      "mir zu helfen?"));
  }
}

int cmd_schwimmen(string str)
{
  string raum;

  if (!S_STANDARD->check_cmd(str,
       "fluss|wasser|bach",
       "Wo willst Du schwimmen?"))
    return 0;
  write(break_string(
    "Langsam gehst Du zum Ufer des Flusses und bahnst Dir einen Weg "
    "in das Wasser hinein. Gerade als Du die kaelte des Wasser spuerst "
    "und Du umkehren willst, verlierst Du den Halt und wirst in die "
    "Flute des Flusses gerissen."));
  tell_room(ME,break_string(
    "Langsam geht "+PL->Name(WER,1)+" zum Ufer des Flusses und bahnst "
    "sich einen Weg in das Wasser hinein. Es sieht so aus, als ob "+
    PL->name(WER,1)+" gerade umkehren will, als "+PL->QueryPronoun(WER)+
    " den Halt verliert und in die Fluten des Flusses gerissen wird."),({PL}));

  raum=ROOM "wasser:"+getuid(PL);
  PL->move(raum,M_GO|M_SILENT);
  return 1;
}

int cmd_kriechen(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "tunnel|loch|kriechtunnel|westen",
       "Wohinein/Wohin willst Du kriechen?"))
    return 0;
  write(break_string("Du solltest zunaechst nach Westen gehen, um zum "
        "Eingang des Kriechtunnels zu gelangen."));
  return 1;
}

int cmd_schlagen(string str)
{
  if (member(({"schlag","schlage","schlagen"}),query_verb())!=-1)
  {
   if (!S_STANDARD->check_cmd(str,
       "lager&auf",
       "Was willst Du schlagen oder aufschlagen?|"
       "Willst Du das Lager vielleicht AUFschlagen?"))
    return 0;
  }
  else if (member(({"errichte","errichten","baue","mache","bauen","machen"}),
           query_verb())!=-1)
  {
   if (!S_STANDARD->check_cmd(str,
       "lager",
       "Was willst Du errichten?"))
    return 0;
  }
  
  write(break_string("Gerade willst Du Dein Lager errichten, als "
    "Dein Blick nach Suedosten faellt, und Du dort ein aufgebautes "
    "Lager erspaehst. Geh doch einfach dorthin."));
  return 1;
}

int exit_westen()
{
  string raum;
  
  write(break_string("Du begibst Dich zu dem Tunnel, zwaengst "
       "Dich in diesen hinein und beginnst vorwaerts zu kriechen."));

  raum=ROOM "tunnel:"+getuid(PL);
  PL->move(raum,M_GO,"","verschwindet","erscheint");
  find_object(raum)->set_owner(PL,ROOM "vorkammer");

/*
  ob=clone_object(ROOM "tunnel");
  PL->move(ob,M_GO,"","verschwindet","erscheint");
  ob->set_owner(PL,ROOM "vorkammer");
*/
  return 1;
}

