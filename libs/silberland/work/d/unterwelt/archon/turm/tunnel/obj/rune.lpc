// Caroll will diese Rune, damit man den Vertrauenszauber von ihm bekommt
// 23.03.2003 Archon: - erstellt
/*
 Rev 1.0 23.03.2003 Archon: erstellt
*/
inherit "std/thing"; 
#include "../def.h"

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT,"Ein Runenstein");
  SetProp(P_LONG,
    "Du betrachtest den Runenstein und schaust Dir die eingebrannte "
    "Rune genau an. Die Rune ist Dir nicht bekannt, doch scheint sie "
    "eine Mischung aus den Runen Xyrophla, Perth und Manaz zu sein. "
    "Vielleicht bezieht sich die Macht dieses Runenstein auf eine, "
    "oder alle dieser drei Runen. Die Rune ist zur Zeit matt.");
  
  AddDetail(({"mischung","aussehen","ausstrahlung"}),
    "Leider hast Du eine solche Rune noch nie gesehen, doch erinnert sie "
    "Dich in ihrem Aussehen und ihre Ausstrahlung sowohl an die Rune "
    "Xyrophla, als auch an die Rune Perth und Manaz.");
  AddDetail(({"begriff","begriffe"}),
    "Du weisst es nicht genau, doch verbindest Du diese "
    "Begriffe mit diesen Runen.");
  AddDetail(({"xyrophla","vertrauen"}),
    "Mit der Rune Xyrophla verbindest Du den Begriff 'Vertrauen'.");
  AddDetail(({"perth","geheimnis"}),
    "Mit der Rune Perth verbindest Du den Begriff 'Geheimnis'.");
  AddDetail(({"manaz","rasse","rassen"}),
    "Mit der Rune Manaz verbindest Du den Begriff 'Rassen'.");
  AddDetail(({"struktur","stein","granit"}),
    "Der Runenstein sieht so aus, als ob er jederzeit auseinander Fallen "
    "koennte.");
  AddDetail(({"zugehoerigkeistgefuehl","zugehoerigkeit"}),
    "Die Rune scheint Vertrauen bei anderen zu erwecken.");
    
  SetProp(P_VALUE,300);
  SetProp(P_WEIGHT,500);
  SetProp(P_MATERIAL,([MAT_GRANITE:100]));
  SetProp(P_NAME,"Runenstein");
  SetProp(P_GENDER,MALE);
  SetProp(P_NOBUY,1);

  SetProp(P_INFO,
    "Irgendjemand sucht bestimmt genau diesen Runenstein mit seiner Rune.");
  
  AddId(({"rune","stein","runenstein"}));
}
