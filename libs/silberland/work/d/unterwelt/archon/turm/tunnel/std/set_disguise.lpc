// ein einfaches set-objekte, erstellt nur fuer die 3 quest-objekte
// angelehnt an set_master Archon@WL
// 08.05.2003 erstellt
/*
 Rev 1.0 08.05.2003 Archon: erstellt
*/

#pragma strong_types
#define NEED_PROTOTYPES
#include "../def.h"
#include <thing/properties.h>

void activate_set_special(object pl,object ausloesend);
mixed query_set_objects(object pl);
int is_disguise(object ob,string *set_files);
int worn_wielded(object ob);
mixed query_worn_set_objects(mixed liste);
mixed query_set_name(mixed liste);

void activate_set_special(object pl,object ausloesend)
{
  mixed obj_1, obj_2;
  int anz,anz2,i;
  string set_name;
  object umhang;

  if (!objectp(pl)) return;
  anz = sizeof(QueryProp(P_DISGUISE_SET_OBJECTS));

  obj_1 = query_set_objects(pl);
  obj_2 = query_worn_set_objects(obj_1);
//liefert set_name zurueck, wenn alle objekte gleichen setnamen haben
  set_name = query_set_name(obj_2); 

  anz2 = sizeof(obj_2);
//umhang finden, wenn vorhanden
  for (i=anz2;i--;)
  {
    if (explode(file_name(obj_2[i]),"#")[0]==(ARMOUR "umhang"))
      umhang=obj_2[i];
  }
  if (!objectp(umhang) && objectp(ausloesend))
  {
    if (explode(file_name(ausloesend),"#")[0]==(ARMOUR "umhang"))
      umhang=ausloesend;
  }

  if (anz2==anz && stringp(set_name)) // alle set-objekte werden getragen
  {
    if (set_name=="Elfen")
      umhang->activate_special(1,pl);
    else
      umhang->activate_special(2,pl);
    return;
  }
//wenn nicht aktiviert, dann immer deaktiviert ...
  if (objectp(umhang)) 
    umhang->activate_special(0,pl);
//sichergehen
  pl->SetProp(P_ELF_DISGUISE,0);
  pl->SetProp(P_DARKELF_DISGUISE,0);
}

int is_disguise(object ob,string *set_files)
{
  string fname;
  int i;
  fname=explode(file_name(ob),"#")[0];
  for (i=sizeof(set_files);i--;)
    if (fname==set_files[i]) return 1;
  return 0;
}

// liefert alle set-objekte eines spielers
mixed query_set_objects(object pl)
{
  string *set_files;
  object help;
  int i, anz;
  mixed obj;

  obj = ({});

  if (!living(pl)) return -2;
  if (!pointerp(set_files = QueryProp(P_DISGUISE_SET_OBJECTS)) ||
      !(anz = sizeof(set_files))) return -1;

  obj=filter_array(all_inventory(pl),#'is_disguise,set_files);

  if (!sizeof(obj)) return 0;
  return obj;
}

int worn_wielded(object ob)
{
  if (ob->QueryProp(P_WIELDED) || ob->QueryProp(P_WORN)) return 1;
  return 0;
}

// liefert alle getragenen/gezueckte set-objekte eines spielers - uebergabe set-objekte
mixed query_worn_set_objects(mixed liste)
{
  object *obj;
  if (!pointerp(liste)) return 0;
  obj = filter_array(liste,#'worn_wielded);
  if (!sizeof(obj)) return 0;
  return obj;
}

mixed query_set_name(mixed liste)
{
  mixed ret;
  mixed name;
  int anz;

  name=0;
  if (!pointerp(liste)) return 0;
  anz=sizeof(liste);
  for (;anz--;)
  {
    ret=(mixed)liste[anz]->QueryProp(P_DISGUISE_SET_NAME);
    if (stringp(ret))
    {
      if (!stringp(name)) 
        name=ret;
      else if (name!=ret) return 0;
    }
  }
  return name;
}
