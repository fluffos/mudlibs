#pragma strict_types
#include "../def.h"
inherit STD "kammer";

void create();

void create()
{
  ::create();

  SetProp(P_INT_LONG,
    "Du befindest Dich am oestlichen Ende der kleinen Hoehle. "
    "Dieser Bereich nimmt das Lager Carolls ein, in dem er seine "
    "Habseligkeiten aufbewahrt und welches er zum Schlafen aufsucht. "
    "Dichtes Moos bewaechst den Boden und umrahmt die eigentliche "
    "Lagerstaette und die daneben stehende Truhe.");

  AddDetail(({"umgebung","kammer","raum","hoehle","bereich"}),
    QueryProp(P_INT_LONG));
  AddDetail(({"ende"}),
    "Die Kammer hoert hier auf.");
  AddDetail(({"nordwesten","teil"}),
    "Im Nordwesten kommst Du in den vorderen Teil der Kammer.");
  AddDetail(({"boden"}),
    "Der Boden ist mit dichtem Moos bewachsen und federt bei jedem "
    "Deiner Schritte nach. Die Weichheit des Mooses hat hier schon "
    "jemanden dazu gebracht, sein Lager aufzuschlagen.");
  AddDetail(({"biegung","rest"}),
    "Die Kammer beschreibt nach Nordwesten eine Biegung und geht dort "
    "weiter. Wie es dort aussieht, weisst Du ja bestimmt noch, denn "
    "immerhin bist Du von dort gekommen.");
  AddDetail(({"lager","lagerstaette"}),
    "Eine fertige Lagerstaette wurde schon am Hoehlenrand errichtet. "
    "Ob Du sie einfach benutzen solltest?");
  AddDetail(({"nordwand","norden"}),
    "Du kannst an der Nordwand nichts ungewoehnliches sehen.");
  AddDetail(({"ostwand","osten"}),
    "Du kannst an der Ostwand nichts ungewoehnliches sehen.");
  AddDetail(({"suedwand","sueden"}),
    "Du kannst an der Suedwand nichts ungewoehnliches sehen.");
  AddDetail(({"westwand","westen","nordwesten"}),
    "In der Westwand siehst Du im Nordwesten den Rest der Kammer.");
  AddDetail(({"caroll","carolls","ort","zufluchtsort",
              "heim","zwielichtig","zwielichtige"}),
    "Dies hier ist Carolls Zufluchtsort - sein Heim. Du solltest "
    "hier besser nichts anfassen, wenn Du Dir Caroll nicht zum "
    "Feind machen willst.");
  AddDetail(({"feind"}),
    "Caroll heisst nicht umsonst der Zwielichtige - als Feind kann "
    "er bestimmt fuerchterlich gemein und hinterhaeltig sein.");
  AddDetail(({"schlafen"}),
    "Du koenntest die Lagerstaette benutzen, oder?");
  AddDetail(({"habseligkeit","habseligkeiten"}),
    "Seine Habseligkeiten hat Caroll bestimmt in seiner Truhe, "
    "ausser er hat hier noch ein Versteck.");
  AddDetail(({"versteck"}),
    "Leider kannst Du keins finden.");
  AddDetail(({"hoehlenrand","rand"}),
    "Der Hoehlenrand sieht nicht anders aus, als Du es erwartet "
    "hast. Nicht einmal ein Versteck wurde dort geschaffen.");
  AddDetail(({"fluss","wasser","bach"}),
    "Hoeren kannst Du den Fluss auch hier, aber um ihn zu "
    "untersuchen, solltest Du nach Nordwesten gehen.");

  AddSmell(({DEFAULT_SMELL,"moos","luft","geruch"}),
    "Der Geruch von frischen Moos liegt in der Luft.");  
  AddSound(({"ruhe","stille","still",DEFAULT_SOUND}),
    "Es ist hier angenehm still. Nur das Rauschen des Flusses ist zu hoeren.");
  AddSound(({"rauschen","fluss","bach","wasser"}),
    "Du hoerst das Wasser des Flusses selbst hier noch rauschen.");

  AddCmd(({"raste","rasten","leg","lege","legen","benutz","benutze","benutzen"}),
    "cmd_schlaf");

  AddItem(OBJ "truhe", REFRESH_REMOVE);

  AddExit("nordwesten",ROOM "kammer_01");
}

int IsMoney(object ob)
{
  string file;
  if (!ob->QueryProp(P_AMOUNT)) return 0; //kann nicht sein
  file=efun::explode(file_name(ob),"#")[0];
  if (file=="/obj/money") return 1;
  return 0;
}

int cmd_schlaf(string str)
{
  object *ob;
  int wieviel;
  if (query_verb()!="raste")
   if (!S_STANDARD->check_cmd(str,
       "lager|lagerstaette|schlafen", //benutze lager, lege schlafen etc.
       "Was willst Du (zum Schlafen) benutzen bzw worauf willst "
       "Du Dich legen?"))
    return 0;

  tell_room(ME,break_string(
    PL->Name(WER,1)+" legt sich auf das Lager."),({PL}));
  //klaue geld -> kosten fuer rasten ... sozusagen
  if ((wieviel=(int)PL->QueryMoney())>500)
  {
    write(break_string(
      "Du legst Dich auf das Lager und versucht Ruhe und Erholung "
      "zu finden. Doch Du bekommst nur Alptraeume."));
    PL->AddMoney(-500);
    "p/daemon/zentralbank"->PayIn(500,100);
    PL->AddHp(-1); //man war unruhig ...
    PL->AddSp(2);  //aber man war geistig aktiv ... und hat min 50 muenzen bezahlt
    PL->SetProp(P_PARALYZED,
      ([PARALYZE_TIME:5,
        PARALYZE_MSG:"Du kannst noch nicht aus Deinem Alptraum erwachen.\n",
        PARALYZE_END:break_string(
                     "Du erhebst Dich schweissgebadet und nicht wirklich "
                     "erholt. Ausserdem scheinst Du irgendwie erleichtert "
                     "worden zu sein."),
        PARALYZE_MSG_OTHER:break_string(
                     PL->Name(WER,1)+" hat gerade einen Alptraum."),
        PARALYZE_END_OTHER:break_string(
                     PL->Name(WER,1)+" erhebt sich schweissgebadet und sieht "
                     "nicht wirklich erholt aus.") ]));
    return 1;
  }
  write(break_string(
    "Du legst Dich auf das Lager und versucht Ruhe und Erholung "
    "zu finden. Doch diese stellt sich nicht ein, und Du stehst "
    "frustriert wieder auf."));
  tell_room(ME,break_string(
    PL->Name(WER,1)+" erhebt sich sichtlich frustriert von dem Lager."),
    ({PL}));
  return 1;
}
