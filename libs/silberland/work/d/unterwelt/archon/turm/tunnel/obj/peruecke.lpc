// Hinweis, zZ ist es nicht moeglich die Farbe wirklich beim spieler zu aendern
// vielleicht kommt ja doch mal ein ModifyProp ... oder temp-prop
// 21.03.2003 Archon: - erstellt
/*
 Rev 1.0 21.03.2003 Archon: erstellt
*/
inherit "std/thing"; 
#include "../def.h"
inherit STD "set_disguise";

string farbe;
string ret;
object owner;
int aufgesetzt;

void create();
string _query_long();
string _query_short();
int cmd_setze(string str);

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  farbe="rot";
  aufgesetzt=0;
  SetProp(P_VALUE,300);
  SetProp(P_WEIGHT,500);
  SetProp(P_MATERIAL,([MAT_HAIR:100]));
  SetProp(P_NAME,"Peruecke");
  SetProp(P_GENDER,FEMALE);
  
  AddId(({"peruecke","haar"}));
 
  AddCmd(({"setz","setze","setzen"}),"cmd_setze"); 

  SetProp(P_DISGUISE_SET_OBJECTS,({ OBJ "peruecke",
                                    OBJ "kontaktlinse",
                                    ARMOUR "umhang" }));
  SetProp(P_DISGUISE_SET_NAME, "Dunkelelfen"); 

  SetProp(P_INFO,"Du kannst die Peruecke auf- bzw absetzen.\n");
}

//ACHTUNG: es muessen zusaetzlich auch noch die adjektive gesetzt werden!
void SetFarbe(string in)
{
  farbe=in;
}

void SetDisguise(string in)
{
  SetProp(P_DISGUISE_SET_NAME,in);
}

string _query_long()
{
  return break_string(
    "Dies ist eine "+farbe+"e langhaarige Peruecke. "
    "Du kannst sie aufsetzen, um Dein eigenes Haar "
    "zu verdecken.");
}

string _query_short()
{
  if (aufgesetzt)
  {
    return "Eine "+farbe+"e Peruecke (aufgesetzt)";
  }
  return "Eine "+farbe+"e Peruecke";
}

int QueryAufgesetzt()
{
  return aufgesetzt;
}

int other_peruecke(object pl)
{
  object *ob;
  int i;
  ob=filter_objects(all_inventory(pl),"id","peruecke")-({ME});
  for (i=sizeof(ob);i--;)
    if (ob[i]->QueryAufgesetzt()) return 1;
  return 0;
}

int cmd_setze(string str)
{
  int was;
  string ids;
  object ob;
  
  if (!S_STANDARD->check_cmd(str,
       "peruecke|haar&auf",
       "Was willst Du auf-,ab- oder einsetzen?|"
       "Willst Du die Peruecke AUF oder ABsetzen?"))
  {
    if (!S_STANDARD->check_cmd(str,
       "peruecke|haar&ab",
       "Was willst Du auf-,ab- oder einsetzen?|"
       "Willst Du die Peruecke AUF oder ABsetzen?"))
      return 0;
    else 
      was=0;
  }
  else
    was=1;
  
  if (was && aufgesetzt)
    return notify_fail("Aber Du traegst die Peruecke doch schon!\n"),0;
  if (!was && !aufgesetzt)
    return notify_fail("Aber Du traegst die Peruecke doch gar nicht!\n"),0;

  if (!aufgesetzt && environment()!=PL)
    return notify_fail("Dazu musst Du die Peruecke erst einmal nehmen!\n"),0;
  
  if (was)
  {
    if (other_peruecke(PL))
      return notify_fail("Aber Du traegst schon eine andere Peruecke!\n"),0;

    if (sscanf(str,"%s auf",ids)==1)
    { //wir haben eine id ... nun testen ob wir gemeint sind
      if (!id(ids) && 
        objectp(ob=present(ids,PL)) && 
        ob->QueryProp(P_DISGUISE_SET_NAME))
      return 0;  //id trifft auf ein objekt zu - aber das sind nicht wir
    }

    aufgesetzt=1;
    owner=PL;
    ret=PL->QueryProp(P_HAIR_COLOR);
    tell_object(PL,"Du setzt eine "+farbe+"e Peruecke auf.\n");
    tell_room(environment(PL),break_string(
      PL->Name(WER,1)+" setzt eine Peruecke auf."),({PL}));
    PL->SetProp(P_HAIR_COLOR,farbe);
    SetProp(P_EXTRA_LOOK,capitalize(PL->QueryPronoun(WER))+" hat eine "+farbe+
                         "e Peruecke aufgesetzt.\n");
    SetProp(P_WORN,PL);
    activate_set_special(PL,ME);
    return 1;
  }
  else
  {
    if (aufgesetzt && objectp(owner) && stringp(ret))
      owner->SetProp(P_HAIR_COLOR,ret); //sicher ist sicher
    tell_object(PL,"Du setzt die "+farbe+"e Peruecke ab.\n");
    tell_room(environment(PL),break_string(
      PL->Name(WER,1)+" setzt eine Peruecke ab."),({PL}));
    aufgesetzt=0;
    SetProp(P_EXTRA_LOOK,0);
    SetProp(P_WORN,0);
    activate_set_special(PL,ME);
  }
  return 1;
}

int move(mixed dest,int method)
{
  if (aufgesetzt)
  {
    tell_object(environment(),"Die Peruecke musst Du erst absetzen.\n");
    return ME_CANT_LEAVE_ENV;
  }
  return ::move(dest,method);
}

int remove(int s)
{
  if (aufgesetzt && objectp(owner) && stringp(ret))
    owner->SetProp(P_EYE_COLOR,ret);
  SetProp(P_WORN,0);
  activate_set_special(owner,ME);
  return ::remove(s);
}