#pragma strict_types
#include "../def.h"
inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_CAVE]));
  SetProp(P_INT_SHORT, "In einer Kammer");

  AddDetail(({"schritt","schritte"}),
    "Jeder Deiner Schritte wird durch das Moos abgefedert.");
  AddDetail(({"moos"}),
    "Das Moos unter Deinen Fuessen ist herrlich weich. Ausserdem leuchtet "
    "es gruenlich und erhellt die Kammer mit seinem diffusen Licht.");
  AddDetail(({"licht"}),
    "Die Kammer wird von dem sanft gruen leuchtenden Moos erhellt.");
  AddDetail(({"fuss","fuesse"}),
    "Deine Fuesse sind an Dir festgewachsen.");
  AddDetail(({"weichheit","oberflaeche","moosoberflaeche"}),
    "Du testest die Weichheit des Mooses, indem Du mit Deiner Hand ueber "
    "dieses streichst. Sanft gleitet die Moosoberflaeche ueber Deine Haut "
    "und Du schliesst Deine Augen, um dieses Gefuehl voll zu geniessen.");
  AddDetail(({"hand","haende"}),
    "Ohja, alle Haende noch dran.");
  AddDetail(({"haut"}),
    "Ohje, Deine Haut koennte wirklich mal etwas Creme vertragen.");
  AddDetail(({"creme"}),
    "Wenn Du keine hast, wirst Du wohl mal welche im Laden kaufen muessen.");
  AddDetail(({"laden"}),
    "Hier ist keiner.");
  AddDetail(({"auge","augen"}),
    "Davon hast Du zwei, oder?");
  AddDetail(({"gefuehl"}),
    "Ein Gefuehl der Ruhe und Geborgenheit ueberkommt Dich in dieser "
    "Umgebung.");
  AddDetail(({"geborgenheit"}),
    "Du fuehlst Dich hier wohl.");
  AddDetail(({"ruhe"}),
    "Lausche lieber.");
  AddDetail(({"decke"}),
    "Du kannst nichts Besonderes an der Decke erkennen.");
  AddDetail( ({ "besonderes" }),
    "Nichts zu sehen.");
  AddDetail(({"wand","waende","felswand"}),
    "Die Waende der Kammer bestehen aus ganz normalen Felsgestein.");
  AddDetail(({"fels","felsgestein","gestein"}),
    "Die Waende und Decke bestehen aus Felsgestein.");
}

