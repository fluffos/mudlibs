inherit "std/container";
#include "../def.h"
#include <container.h>

object p1,p2,l1,l2;

int cmd_brechen(string str);

void create()
{
  if(!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT,"Eine Eichentruhe");
  SetProp(P_LONG,
    "Die Truhe besteht aus solidem Eichenholz mit Metallbeschlaegen. "
    "Ein Schloss sichert den Inhalt der etwa kniehohen Truhe vor "
    "den Fingern neugieriger Fremder.");

  AddDetail(({"schloss"}),
    "Ein sehr stabil aussehendes Schloss sichert die Truhe. "
    "Du wirst wohl den passenden Schluessel benoetigen, "
    "um die Truhe zu oeffnen. Du ueberlegst kurz und denkst, dass "
    "vielleicht auch ein Dietrich helfen koennte.");
  AddDetail(({"holz","eiche", "eichenholz"}),
    "Die Truhe besteht aus einfachem, soliden Eichenholz.");
  AddDetail(({"beschlag","beschlaege","metall","metallbeschlag",
              "metallbeschlaege"}),
    "Zusaetzlich ist die Truhe mit Metallbeschlaegen verstaerkt. "
    "Mit roher Gewalt wirst Du die Truhe nicht aufbekommen.");
  AddDetail(({"gewalt"}),
    "Gewalt bringt Dich nicht weiter.");
  AddDetail(({"schluessel"}),
    "Ohne Schluessel wirst Du die Truhe wohl nicht aufbekommen, oder?");
  AddDetail(({"fremder","fremden"}),
    "Das Schloss schuetzt den Inhalt der Truhe vor Fremden wie Dir.");
  AddDetail(({"fremde"}),
    "Du bist dir nicht fremd - der Truhe aber schon.");
  AddDetail(({"finger","fingern"}),
    "Na Du willst doch nicht etwas klauen, oder?");
  AddDetail(({"inhalt"}),
    "Der ist in der Truhe.");

  SetProp(P_NAME, "Truhe");
  SetProp(P_PLURAL, "Truhen");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOGET, "Die Truhe ist viel zu schwer fuer Dich.\n");

  AddId(({"truhe","holztruhe","eichentruhe","eichenholztruhe"}));

  add_openclose_commands();
  SetProp(P_CNT_KEY,"truhe_soll_geknackt_werden");
  SetProp(P_CNT_FLAGS,CNT_RESET_LOCK);
  SetProp(P_CNT_STATUS,CNT_STATUS_LOCKED);
  SetProp(P_CNT_CRACK_CHANCE,1000); //100% chance schloss zu knacken!
  
  AddCmd(({"brich","brechen","breche"}),"cmd_brechen");
  reset();
}

//troz erfolgreichem oeffnen mit dietrich, diesen zerstoeren
void AfterOpen()
{
  object key;
  key=present("dietrich",PL);
  if (objectp(key))
  { //sollte immer wahr sein - da die truhe ja nur mit dietrich zu oeffnen ist
    write("Leider ist Dir trotzdem Dein Dietrich kaputt gegangen.\n"+
          break_string(
          "Doch Du bist schnell ueber den Verlust weg, als Du siehst, "
          "was in der Truhe zu finden ist. Dies muessen die Verkleidungen sein, "
          "die Caroll benutzt."));
    key->remove(1);
  }
  set_next_reset(MASTERDELAY);
}

void reset()
{
  ::reset();
  set_next_reset(MASTERDELAY);
  if (!objectp(p1) || environment(p1)!=ME)
  {
    p1=clone_object(OBJ "peruecke");
    p1->move(ME,M_NOCHECK);
    p1->SetFarbe("blauschwarz");
    p1->SetDisguise("Elfen");
    p1->SetProp(P_NAME_ADJ,"blauschwarz");
    p1->SetProp(P_ADJECTIVES,({"schwarz","schwarze","schwarzen","schwarzem",
                               "blauschwarz","blauschwarze","blauschwaren",
                               "blauschwarzem"}));
  }
  if (!objectp(p2) || environment(p2)!=ME)
  {
    p2=clone_object(OBJ "peruecke");
    p2->move(ME,M_NOCHECK);
    p2->SetFarbe("weiss");
    p2->SetDisguise("Dunkelelfen");
    p2->SetProp(P_NAME_ADJ,"weiss");
    p2->SetProp(P_ADJECTIVES,({"weiss","weisse","weissen","weissem",}));
  }
  if (!objectp(l1) || environment(l1)!=ME)
  {
    l1=clone_object(OBJ "kontaktlinse");
    l1->move(ME,M_NOCHECK);
    l1->SetFarbe("obsidianschwarz");
    l1->SetDisguise("Elfen");
    l1->SetProp(P_NAME_ADJ,"obsidanschwarz");
    l1->SetProp(P_ADJECTIVES,({"schwarz","schwarze","schwarzen","schwarzem",
                               "obsidanschwarz","obsidanschwarze",
                               "obsidanschwaren","obsidanschwarzem"}));
  }
  if (!objectp(l2) || environment(l2)!=ME)
  {
    l2=clone_object(OBJ "kontaktlinse");
    l2->move(ME,M_NOCHECK);
    l2->SetFarbe("dunkelrot");
    l2->SetDisguise("Dunkelelfen");
    l2->SetProp(P_NAME_ADJ,"dunkelrot");
    l2->SetProp(P_ADJECTIVES,({"rot","rote","roten","rotem",
                               "dunkelrot","dunkelrote",
                               "dunkelroten","dunkelrotem"}));
  }
  if (!present("umhang"))
   clone_object(ARMOUR "umhang")->move(ME,M_NOCHECK);
}

int cmd_brechen(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "truhe",
       "Was willst Du aufbrechen?"))
    return 0;
  write("Die Truhe ist dazu viel zu stabil!\n");
  return 1;
}