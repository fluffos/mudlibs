#include "../def.h"
inherit "std/npc";

void create();
string info_auftrag();
string info_vertrauenszauber();
string info_hilfe();
int helfen();
int cmd_helfen(string str);
int cmd_helfen2(string str);
int cmd_waehlen(string str);

object spricht_zu;
object *geholfen;

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  seteuid(getuid(ME)); 
  geholfen=({});

  SetProp(P_LOG_INFO,"archon/unterwelt_caroll.rep");

  SetProp(P_SHORT,"Caroll, der Zwielichtige");
  SetProp(P_LONG,
    "Halb Elf und halb Dunkelelf gehoert Caroll zu keiner der beiden Rassen, "
    "was man zu seinem Leidwesen auch sehen kann. Als Missgeburt empfunden "
    "lebte er in seiner Jugend geduldet, aber nicht geachtet, bei den Elfen. "
    "Doch bald sagte er sich von ihnen los und suchte seinen "
    "Seelenfrieden bei den Dunkelelfen. Anscheinend nahmen sie ihn nicht "
    "auf, denn heute hasst er sie genauso wie die Elfen.");

  SetProp(P_NAME,"Caroll");
  SetProp(P_GENDER,MALE);
  SetProp(P_ARTICLE,0);

  create_default_npc(40);
  SetProp(P_BODY,0);
  SetProp(P_SIZE,170);

  SetProp(P_RACE,"Halbelf");
  SetProp(P_NOMAGIC,20);
  SetProp(P_SPELLRATE,20);
  SetProp(P_HANDS,({" mit viel Uebung im Waffenlosenkampf",400,DT_BLUDGEON}));

  AddSpell(60,380,"Caroll schleudert einen magischen Pfeil nach Dir.\n",
          "Caroll trifft @WEN mit einem magischen Pfeil.\n",
          ({DT_MAGIC,DT_LIGHTNING}),([SP_SHOW_DAMAGE:1]));
  AddSpell(40,440,"Caroll murmelt und ein schwarzer Nebel erscheint um "
          "Dich herum.\n",
          "Caroll murmelt und einen schwarzen Nebel erscheint um @WEN.\n",
          ({DT_MAGIC,DT_UNHOLY}),([SP_SHOW_DAMAGE:1]));

  AddId(({"caroll","monster"}));

  AddInfo(DEFAULT_INFO,
    "brummt etwas unverstaendliches, was sich wie "
    "'... hasse alles ... mit diesem Plan ...' anhoert.");
  AddInfo(({"hass","hassen","kampf","fallen"}),
    "Oh ich hasse alle, besonders die Elfen und Dunkelelfen. Damals dachte "
    "ich, dass die Dunkelelfen besser als die Elfen sein muessten und ging "
    "zu ihnen. Doch ohne es zu wissen, benutzten diese nur mich und meinen "
    "Hass fuer ihre Zwecke. Als ich dies erkannte, schloss ich mich "
    "voller Wut einigen Magiern in ihrem Kampf gegen die Dunkelelfen an. "
    "Doch auch sie behandelten mich als Aussenstehenden und nun ziehe "
    "ich alleine durch die Unterwelt und wuensche mir den Tod aller, die "
    "mich herablassend behandelt haben und stelle ihnen Fallen. "
    "Gerade habe ich einen Plan, um es einigen von ihnen heimzuzahlen.",
    "flucht: ");
  AddInfo(({"elf","elfen","oberflaechenelfen"}),
    "Oh diese verlogenen, scheinheiligen Elfen mit ihrer Moral und dem Hang "
    "gute Taten zu vollbringen. Aufgezogen haben sie mich und mit Herablassung "
    "behandelt, als wenn sie etwas besseres waeren, dieses selbstgefaellige "
    "Pack.",
    "knurrt alles um sich herum vergessend: ");
  AddInfo(({"pack"}),
    "Von mir aus koennen die alle sterben.",
    "sagt: ");
  AddInfo(({"moral"}),
    "Wie nutzlos.",
    "kichert: ");
  AddInfo(({"dunkelelf","dunkelelfen","dunkelelfenpriester","dreck",
          "dunkelelfenpriesterinnen","priester","priesterinnen","delfen"}),
    "Oh diese verschlagenen selbstsuechtigen Dunkelelfen. Ausgenutzt haben "
    "Sie mich, behandelt wie den letzten Dreck. Doch was fuer ein Spass "
    "es gemacht hat, Elfen fuer sie in die Falle zu locken. Doch nun wuerde "
    "ich mich gerne, wegen dieser Schmach, an einer Patrouille raechen.",
    "zischt: ");
  AddInfo(({"schmach"}),
    "kocht vor Wut.");
  AddInfo(({"falle"}),
    "'Ich erdenke mir gerne Fallen fuer ...' und verstummt.",
    "sagt: ");
  AddInfo(({"rasse","rassen"}),
    "Keine ist besser als die andere und ich will sie beide bluten "
    "sehen. Um mich ungehindert unter ihnen zu bewegen, habe ich "
    "eine Verkleidung und einen besonderen Zauber.",
    "grummelt: ");
  AddInfo(({"magier"}),
    "Magier sind ein immer nur auf sich bedachtes Pack, doch war es suess "
    "Dunkelelfenblut in ihrem Auftrag zu vergiessen.",
    "laechelt kalt: ");
  AddInfo(({"plan","auftrag","aufgabe","problem"}),#'info_auftrag,
    "knurrt: ");
  AddInfo(({"hilfe","helfen"}),#'info_hilfe);
  AddInfo(({"ostan"}),
    "Der Magier haelt sich zur Zeit im Turm auf.",
    "sagt: ");
  AddInfo(({"turm"}),
    "Der Turm ist in der Naehe eines Ausganges der Unterwelt. Vor langer Zeit "
    "war ich einmal mit Ostan dort und habe gegen die Dunkelelfen gekaempft. "
    "Da diese den Turm vernichten wollen, koennen sie den Turm auch nicht "
    "betreten. Doch ich kenne einen Weg, um die Waechter des Turmes zu "
    "ueberlisten.",
    "erzaehlt sachlich: ");
  AddInfo(({"waechter","list","turmwaechter"}),
    "Die Waechter des Turmes sind zwar sehr gefaehrlich, aber zum Glueck "
    "auch nicht sehr helle, so dass jeder den Turm betreten kann.",
    "sagt: ");
  AddInfo(({"zeit"}),
    "Die Zeit ist reif.",
    "erwidert: ");
  AddInfo(({"umhang"}),
    "Mein Umhang geb ich nicht her!",
    "erwidert: ");
  AddInfo(({"linse","kontaktlinse","linsen","kontaktlinsen"}),
    "Kontaktlinsen koennen sehr nuetzlich sein.",
    "brummt vor sich hin: ");
  AddInfo(({"peruecke","peruecken"}),
    "Peruecken koennen sehr nuetzlich sein.",
    "brummt vor sich hin: ");
  AddInfo(({"schlacht","massaker"}),
    "Oh wann gehts endlich los?",
    "fragt sich: ");
  AddInfo(({"zauber","verkleidungen","verkleidung","verkleiden"}),
    "Damit ich mich frei unter den Elfen oder Dunkelelfen bewegen kann, "
    "ohne dass sie mich mit ihren Blicken verfolgen, besitze ich ein "
    "paar Verkleidungen und sogar einen magischen Umhang, welcher mich "
    "als reinrassiger Elf oder Dunkelelf erscheinen laesst. "
    "Natuerlich wirkt dieser Zauber bei keinem anderen so gut wie "
    "bei mir, doch wird es, wenn Du mir hilfst reichen. "
    "Ich bewahre diese Sachen in meiner Truhe auf. "
    "Neben dem Aussehen, braucht man aber auch oft noch das Vertrauen "
    "der Mitglieder dieser Rasse.",
    "sagt: ");
  AddInfo(({"vertrauen","vertrauenszauber"}),#'info_vertrauenszauber,
    "faucht: ");
  AddInfo(({"truhe"}),
    "Meine Truhe steht hier ganz in der Naehe, doch halte ich sie "
    "immer verschlossen.",
    "sagt: ");
  AddInfo(({"schluessel"}),
    "Meinen Schluessel gebe ich nicht her und einen Dietrich wirst "
    "Du hier nicht finden, der die Truhe oeffnen kann. Such Dir "
    "Deine eigene Verkleidung!",
    "sagt: ");
  AddInfo(({"dietrich"}),
    "Achje wo ist denn meiner hin?",
    "fragt erstaunt: ");
  AddInfo(({"patrouille","patroullie"}),
    "Du wirst sie schon in den Tunneln der Unterwelt finden. Such in der "
    "Naehe von Dhrkion.",
    "sagt zuversichtlich: ");
  AddInfo(({"lagerstaette","lager"}),
    "Meine Lagerstaette ist gleich dort drueben, doch nur ich kann sie "
    "benutzen.",
    "brummt: ");
  AddInfo(({"unterwelt","tunnel","tunneln"}),
    "Da musst Du Dich alleine zurecht finden.",
    "brummt: ");
  AddInfo(({"stein","runenstein"}),
    "Ich habe meinen Runenstein irgendwo in den Tunneln auf dem Weg nach "
    "Dhrkion verloren.",
    "knurrt: ");
  AddInfo(({"dhrkion"}),
    "Wenn Du etwas ueber Dhrkion wissen willst, geh gefaelligst hin!",
    "brummt: ");
  AddInfo(({"belohnung","lohn"}),
    "Du willst eine Belohnung? Wenn es sein muss ... . "
    "Ich habe einen sehr seltenen, magischen Kristall, welchen Du nach "
    "erledigter Arbeit haben sollst. Den willst Du auf jedenfall besitzen!",
    "erzaehlt: ");
  AddInfo(({"kristall"}),
    "Ich trenne mich nur ungern von ihm. Aber was sein muss, muss sein.",
    "seufzt: ");
  AddInfo(({"paladin","paladine","waldlaeufer","oberflaechler"}),
    "Hochnaesige Toelpel!",
    "knurrt: ");
  AddInfo(({"priesterin","dunkelelfenpriesterin"}),
    "Diese dummen opfergierige Huren bekommen mich nicht!",
    "zischt: ");
  AddInfo(({"naehe"}),
    "Nicht weit von hier ..."
    "kichert: ");
  AddInfo(({"fuersprache"}),
    "Willst Du mir helfen?",
    "fragt: ");
  AddInfo(({"ausgang"}),
    "Willst Du hier weg? Nur zu! Je eher desto besser!",
    "knurrt wuetend: ");
  AddInfo(({"weg"}),
    "Troll Dich!",
    "knurrt: ");
  AddInfo(({"driderfutter"}),
    "kichert.");
  AddInfo(({"archon"}),
    "Der war mal hier.",
    "zischt: ");

  AddCmd(({"hilf","hilfe","helfe","helfen"}),"cmd_helfen");
  AddCmd(({"biete","bieten","anbieten"}),"cmd_helfen2");
  AddCmd(({"waehle","waehlen","waehl"}),"cmd_waehlen");
}

void reset()
{
  ::reset();
  geholfen=({});
}

string info_auftrag()
{
  int art;
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(PL);
  if (art>0)
    return "Beeil Dich gefaelligst!";
  tell_room(environment(ME),break_string(
    "Ich habe einen totsicheren Plan, doch kann ich ihn nicht selber "
    "durchfuehren.",78,"Caroll knurrt: "));
  tell_room(environment(ME),break_string(
    "Dann flucht Caroll vor sich hin. Seinen Kopf "
    "schuettelnd, kommt er wieder zu sich und schaut Dich mit fanatisch "
    "geweiteten Augen an."));
  tell_room(environment(ME),break_string(
    "Ich brauche Hilfe, Deine Hilfe! Du wirst mir helfen.",
    78,"Caroll faucht: "));
  return "Los Hilf mir!";
}

string info_vertrauenszauber()
{
  int pos,art;
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(PL);
  if ((pos==2 && art==1) || (art==2 && pos==3))
  { //zauber geben
    tell_room(environment(ME),break_string(
      "Auch wenn man sich zwischen den Angehoerigen einer Rasse frei "
      "bewegen kann, verraet man sich nur all zu schnell, wenn man mit "
      "ihnen spricht. Deshalb habe ich einen Vertrauenszauber entwickelt, "
      "wodurch andere einen als vertrauenswuerdig empfinden. Doch leider "
      "wirkt dieser Zauber nicht immer. Aber ich sehe schon, dass Du "
      "diesen Zauber gerade gut gebrauchen koenntest, doch will ich "
      "etwas von Dir, bevor ich ihn mit Dir teile. Bring mir meinen "
      "Runenstein, den ich irgendwo in den Tunneln der Unterwelt verloren "
      "habe.",
      78,"Caroll erzaehlt: "));
    return "Und nun lass mich in Ruhe!";
  }
  if ((art==1 && pos==3) || (art==2 && pos==4))
  {
    tell_room(environment(ME),
      "Caroll faucht: Aber der Zauber wirkt bei Dir doch noch.\n");
    return "Und nun lass mich in Ruhe!";
  }
  if (pos>4 || (art==1 && pos>3))
  {
    tell_room(environment(ME),break_string(
      "Aber Du hast den Zauber doch schon benutzt, nun "
      "braucht Du ihn nicht mehr.",78,"Caroll faucht: "));
    return "Und nun lass mich in Ruhe!";
  }
  tell_room(environment(ME),break_string(
    "Auch wenn man sich zwischen den Angehoerigen einer Rasse frei "
    "bewegen kann, verraet man sich nur all zu schnell, wenn man mit "
    "ihnen spricht. Deshalb habe ich einen Vertrauenszauber entwickelt, "
    "wodurch andere einen als vertrauenswuerdig empfinden. Doch leider "
    "wirkt dieser Zauber nicht immer. Solltest Du einmal einen solchen "
    "Zauber, waehrend Du mir hilfst, benoetigen, werde ich ihn ueber "
    "Dich sprechen. Frage einfach nach dem Vertrauenszauber.",
    78,"Caroll erzaehlt: "));
  return "Und nun lass mich in Ruhe!";
}

string info_hilfe()
{
  int art,pos;
  if (P_ARCHON_QUESTMASTER->is_inquest(PL))
  { 
    pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
    art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(PL);
    write(
      "Caroll reibt sich die Haende und sagt: Du *hilfst* mir doch schon.\n");
    if (art==2)
     write("Caroll meint: Du bist dabei den Paladinen eine "
          "Lektion zu erteilen.\n");
    else
     write("Caroll meint: Du bist dabei den Dunkelelfen eine "
          "Lektion zu erteilen.\n");
    write(break_string(
      "Hast wohl vergessen was Du als naechstes tun musst?",78,
      "Caroll schaut Dich an und brummt: "));
    switch(pos)
    {
      case 1: case 8:
       if(art==1)
         write(break_string(
           "Was stehst Du hier noch rum, auf zum Magier.",
           78,"Caroll knurrt: "));
       else
         write(break_string(
           "Was stehst Du hier noch rum, auf zur Priesterin der "
           "Dunkelelfen.",
           78,"Caroll knurrt: "));
      break;
      case 2:
       if(art==1)
         write(break_string(
           "Na auf der Suche nach einem Vertrauenszauber? Gib "
           "mir meine Rune und Du sollst ihn erhalten.",
           78,"Caroll knurrt: "));
       else
         write(break_string(
           "Du solltest der Priesterin Deine Hilfe anbieten.",
           78,"Caroll knurrt: "));
      break;
      case 3:
       if(art==1)
         write(break_string(
           "Auf zur Dunkelelfenpriesterin.",
           78,"Caroll knurrt: "));
       else
         write(break_string(
           "Na auf der Suche nach einem Vertrauenszauber? Gib "
           "mir meine Rune und Du sollst ihn erhalten.",
           78,"Caroll knurrt: "));
      break;
      case 4:
       if(art==1)
         write(break_string(
           "Auf zur Dunkelelfenpriesterin.",
           78,"Caroll knurrt: "));
       else
         write(break_string(
           "Was stehst Du hier noch rum, auf zum Magier.",
           78,"Caroll knurrt: "));
      break;
      case 5:
       write(break_string(
         "Was stehst Du hier noch rum, auf zum Magier.",
         78,"Caroll knurrt: "));
      break;
      case 6:
         write(break_string(
           "Los manipuliere die Runen, damit das Massaker endlich beginnen "
           "kann.",
           78,"Caroll knurrt: "));
      break;
      default:
         write(break_string(
           "Oh gerade weiss ich auch nicht weiter.",
           78,"Caroll knurrt: "));
      break;
    }
    return "grinst fies.";
  }
  return "laechelt zynisch: Willst Du mir Deine Hilfe anbieten?";
}

int test()
{
  if (!spricht_zu || environment(spricht_zu)!=environment(ME))
  {
    spricht_zu=0;
    return 0; //nix mehr zu sagen
  }
  return 1;
}

void gespraech(int pos)
{
  object raum;
  int a,wait;
  string r,g,s1,s2,s3,s4,s5;

  if (!test()) return;
  raum=environment(ME);
  wait=15;

  tell_room(environment(ME),"\n");
  switch(pos)
  {
//GESPRAECH 1
    case 0:
     tell_room(raum,break_string(
      "Bevor ich Dir mehr erzaehle, solltest Du Dich entscheiden, "
      "*wem* Du helfen willst, "+spricht_zu->Name(WER,NAME_AUTO)+
      ". Da haetten wir eine Patrouille Dunkelelfen, oder die Paladine, "
      "Priester und Waldlaeufer in einem Turm hier ganz in der Naehe. "
      "Ueber kurz oder lang, werden sich diese beiden Parteien bekaempfen.",
      78,"Caroll sagt: "));
      wait=10;
    break;
    case 1:
     tell_room(raum,"Caroll kichert.\n");
     tell_room(raum,break_string(
       "Oh das wird ein schoenes Massaker, doch wann geht es endlich los?",
       78,"Caroll brummt zu sich: "));
     wait=8;
    break;
    case 2:
     tell_room(raum,break_string(
       "Caroll wendet sich wieder zu "+spricht_zu->Name(WER,NAME_AUTO)),
       ({spricht_zu}));
     tell_object(spricht_zu,
       "Caroll wendet sich wieder an Dich.\n");
     tell_room(raum,break_string(
       "Du koenntest das Federchen in der Waageschale sein, um die Schlacht "
       "zu Gunsten des Einen oder des Anderen zu beeinflussen.",
       78,"Caroll sagt laut: "));
     wait=8;
    break;
    case 3:
     tell_room(raum,
       "Caroll kichert ploetzlich: Oh das gefaellt mir - so viele Tote.\n");
     tell_room(raum,break_string(
       "Ploetzlich werden Carolls Augen zu Schlitzen und er mustert "+
       spricht_zu->Name(WER,NAME_AUTO)+" intensiv."),
       ({spricht_zu}));
     tell_object(spricht_zu,break_string(
       "Ploetzlich werden Carolls Augen zu Schlitzen und er mustert "
       "Dich intensiv."));
     wait=8;
    break;
    case 4:
     r=lower_case(spricht_zu->QueryProp(P_RACE));
     a=spricht_zu->QueryProp(P_ALIGN);
     g=lower_case(spricht_zu->QueryProp(P_GUILD));
     if (r=="elf" || g=="paladine" || ( a>=0 && r!="dunkelelf"))
     { //gut
      s1="Oberflaechlern";
      s2="waehle paladine";
      s3="waehle dunkelelfen";
      s4="Paladinen und Konsorten";
      s5="Dunkelelfen";
     }
     else
     { //boese
      s1="Dunkelelfen";
      s2="waehle dunkelelfen";
      s3="waehle paladine";
      s4="Dunkelelfen";
      s5="Paladinen und Konsorten";
     }
     tell_room(raum,break_string(
       "Siehst so aus, als ob Du den verfluchten "+s1+" helfen willst, "+
       spricht_zu->Name(WER,NAME_AUTO)+". Na ja was soll's, mach ruhig, "
       "mir soll es recht sein. Doch Du musst Dich fuer eine Seite "
       "entscheiden. Wenn Du soweit bist, erklaere ich Dir, wie Du die "
       +s5+" ins Verderben stuerzen kannst. Tippe hierzu '"+s2+"', "
       "doch solltest Du doch lieber den "+s4+" eine Lehre erteilen "
       "wollen, tippe '"+s3+"'.",
       78,"Caroll brummt: "));
     spricht_zu->SetProp(P_PARALYZED,0);
     spricht_zu=0;
     return;
    break;
//ENDE GESPRAECH 1

//GESPRAECH 2
    case 10:
     tell_room(raum,break_string(
      "OK, hoer zu, "+spricht_zu->Name(WER,NAME_AUTO)+
      ". Du musst in den Turm zu Ostan gehen. Er wird Dir "
      "schon weiter helfen. Doch denke daran, dass Du die Dunkelelfen "
      "austricksen musst, ansonsten bist Du Driderfutter.",
      78,"Caroll raunt: "));
     tell_room(raum,break_string(
       "Caroll grinst fies und es sieht so aus, als ob ihn das "
       "nicht stoeren wuerde."));
     pos=29;
    break;
//ENDE GESPRAECH 2

//GESPRAECH 3
    case 20:
     tell_room(raum,break_string(
      "OK, hoer zu, "+spricht_zu->Name(WER,NAME_AUTO)+
      ". Du musst zu der Dunkelelfenpatrouille gehen. Die Priesterinnen werden "
      "Dich schon zu ihrem Vorteil benutzen. Doch denke daran, "
      "dass Du die Paladine und vor allem Ostan austricksen musst, "
      "ansonsten bist Du schnell bei Deinem Schoepfer.",
      78,"Caroll raunt: "));
     tell_room(raum,break_string(
       "Caroll grinst fies und es sieht so aus, als ob ihn das "
       "nicht stoeren wuerde."));
     pos=29;
    break;
//ENDE GESPRAECH 3

//GESPRAECH 4
    case 30:
     r=lower_case(spricht_zu->QueryProp(P_RACE));
     if (r!="dunkelelf" && spricht_zu->QueryProp(P_DARKELF_DISGUISE)<time())
      tell_room(raum,break_string(
       "So kannst Du Dich den Dunkelelfen jedenfalls nicht naehern, ein "
       "wenig verkleiden musst Du Dich schon.",
       78,"Caroll fuehrt aus: "));
     else if (r=="dunkelelf" && spricht_zu->QueryProp(P_ELF_DISGUISE)<time())
      tell_room(raum,break_string(
       "So kannst Du den Turm aber nicht betreten. Einen Dunkelelfen "
       "lassen Sie dort nie herein. Ein wenig verkleiden musst Du Dich "
       "schon.",
       78,"Caroll fuehrt aus: "));
     tell_room(raum,break_string(
       "Falls Du mal vergessen solltest, was Du als naechstes machen "
       "musst, frag mich einfach nach <hilfe> und ich versuche Dir "
       "auf die Spruenge zu helfen.",
       78,"Caroll brummt: "));
     tell_room(raum,break_string(
       "Der Kampf soll ja mal beginnen.",
       78,"Caroll zu sich: "));
     spricht_zu->SetProp(P_PARALYZED,0);
     spricht_zu=0;
     return;
    break;
//ENDE GESPRAECH 4

    default:
//sicherheitshalber ... sollte aber nie passieren ...
      if (objectp(spricht_zu) && spricht_zu->QueryProp(P_PARALYZED))
        spricht_zu->SetProp(P_PARALYZED,0);
      spricht_zu=0; 
      return; 
    break; //nix mehr zu machen
  }
  call_out("gespraech",wait,pos+1);
}

int helfen()
{
  if (member_array(PL,geholfen)!=-1)
  {
    write("Aber Du hast mir doch gerade erst geholfen!\n");
    return 1;
  }
  if (P_ARCHON_QUESTMASTER->is_inquest(PL))
  { //man hilft schon ...
    write(
      "Caroll reibt sich die Haende und sagt: Du *hilfst* mir doch schon.\n"
      "Dann grinst Caroll fies: Das wird ein schoenes Massaker.\n");
    return 1;
  }
  if (spricht_zu)
  {
    if (spricht_zu==PL)
    {
      write("Lass doch Caroll erst einmal aussprechen.\n");
      return 1;
    }
    write(break_string(
      "Caroll erlaeutert gerade "+spricht_zu->name(WER,NAME_AUTO)+
      " etwas."));
    return 1;
  }
  spricht_zu=PL;
  PL->SetProp(P_PARALYZED,([
    PARALYZE_TIME:-1,
    PARALYZE_MSG:
      "Du konzentrierst Dich zu sehr auf das, was um Dich herum passiert.\n",
    PARALYZE_MSG_OTHER:break_string(
      PL->Name(WER,1)+" konzentriert sich zu sehr auf seine Umgebung."),
    PARALYZE_END:"Wofuer willst Du Dich entscheiden?\n",
    PARALYZE_END_OTHER:"%s versucht sich zu entscheiden.\n" ]));
  write(break_string(
    "Caroll grinst gehaessig und faengt dann verschwoererisch an zu "
    "erzaehlen."));
  tell_room(environment(ME),break_string(
    "Caroll erzaehlt "+PL->Name(WEN,1)+" etwas."),({PL}));
  call_out("gespraech",10,0);
  return 1;
}

int cmd_helfen2(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "hilfe",
       "Was willst Du anbieten?"))
    return 0;
  return helfen();
}

int cmd_helfen(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "caroll",
       "Wem willst Du helfen?"))
    return 0;
  return helfen();
}

int cmd_waehlen(string str)
{
  string s1,s2,r;
  int was;
  if (!S_STANDARD->check_cmd(str,
       "paladine|dunkelelfen",
       "Welche Seite willst Du waehlen? (dunkelelfen oder paladine)"))
    return 0;
  str=lower_case(str);
  if (member_array(PL,geholfen)!=-1)
  {
    write("Aber Du hast mir doch gerade erst geholfen!\n");
    return 1;
  }
  if (P_ARCHON_QUESTMASTER->is_inquest(PL))
  { //man hilft schon ...
    write(break_string(
      "Du hast Dich doch schon entschieden.",
      78,"Caroll reibt sich die Haende und sagt: "));
    write(
      "Caroll grinst: Beeil Dich, es soll endlich losgehen.\n");
    return 1;
  }
  if (spricht_zu)
  {
    if (spricht_zu==PL) 
    {
      write("Lass doch Caroll erst einmal aussprechen.\n");
      return 1;
    }
    write(break_string(
      "Caroll erlaeutert gerade "+spricht_zu->name(WER,NAME_AUTO)+
      " etwas."));
    return 1;
  }
  spricht_zu=PL;
  r=lower_case(PL->QueryProp(P_RACE));
  if (str=="paladine")
  {
    was=1;
    s1="Paladine";
    s2="Dunkelelfen";
  }
  else
  {
    was=2;;
    s1="Dunkelelfen";
    s2="Paladine";
  }
  PL->SetProp(P_PARALYZED,([
    PARALYZE_TIME:-1,
    PARALYZE_MSG:
      "Du konzentrierst Dich zu sehr auf das, was um Dich herum passiert.\n",
    PARALYZE_MSG_OTHER:break_string(
      PL->Name(WER,1)+" konzentriert sich zu sehr auf seine Umgebung."),
    PARALYZE_END:
      "Caroll brummt ungeduldig: Nun mach Dich schon auf den Weg.\n",
    PARALYZE_END_OTHER:"%s ist nun voller Tatendrang.\n" ]));
  P_ARCHON_QUESTMASTER->set_start(PL,was);
  write(break_string(
      "Haette ich mir ja denken koennen, dass Du den "+s1+
      " helfen willst. Ach auch egal - sterben eben die doofen "+s2+".",
      78,"Caroll brummt: "));
  write(break_string(
      "Mir soll es recht sein.",
      78,"Caroll zuckt mit den Schultern und grinst unschuldig: "));
  if (was==1)
    call_out("gespraech",10,10);
  else
    call_out("gespraech",10,20);
  return 1;
}

void give_notify(object ob)
{
  int pos,art;
  if (!objectp(ob)) return;
  pos=(int)P_ARCHON_QUESTMASTER->get_quest_pos(PL);
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(PL);
  if (explode(file_name(ob),"#")[0]==(OBJ "rune"))
  {
   tell_room(environment(ME),
     "Caroll wirkt beglueckt und sagt: Da ist ja mein Runenstein.\n");
   if ((pos==2 && art==1) || (art==2 && pos==3))
   {
    tell_room(environment(ME),break_string(
      "Ok "+PL->name(WER,1)+", Du hast mir den Runenstein gebracht "
      "und ich werde den Vertrauenszauber ueber Dich aussprechen, "
      "damit die Dunkelelfen und die Paladine endlich aneinander "
      "geraten.",78,"Etwas widerwillig sagt Caroll: "));
    tell_room(environment(ME),
      "Caroll hebt seine Haende und murmelt vor sich hin.\n");
    tell_object(PL,
      "Du hoffst, dass der Zauber auch wirkt..\n");
    P_ARCHON_QUESTMASTER->advance_quest(PL); //gut 2->3, boese 3->4
    switch(art)
    {
      case 1:
        tell_room(environment(ME),break_string(
         "Caroll zischt aufgebracht: Und nun nichts wie hin zu den "
         "Dunkelelfenpriesterinnen und lock sie zum Turm."));
      break;
      default:
        tell_room(environment(ME),break_string(
         "Caroll zischt aufgebracht: Und nun nichts wie hin zum Turm, "
         "und schleimt euch dort bei Ostan ein, damit die Dunkelelfen "
         "alle im Turm vernichten koennen."));
      break;
    }
   }
   else
    tell_room(environment(ME),
     "Caroll brummt: Und nun verschwinde.\n");  
   ob->remove(1);
  }
}

void mein_log(int time,string name,string was)
{
  write_file(LOG "quest_ende.log",ctime(time)+" - "+CAP(name)+
    " hat fuer die "+was+" gekaempft.\n");
  write_file("/log/quests/unterweltkampf",dtime()+"  "+CAP(name)+
    " hat fuer die "+was+" gekaempft.\n");
}

public void end_quest(object pl)
{
  int ret,art;
  string was;
  tell_object(pl,
    "Caroll kichert vergnuegt als er Dich sieht.\n");
  tell_room(environment(ME),
    "Caroll kichert vergnuegt als er "+pl->name(WEN,1)+" sieht.\n",({pl}));
  tell_room(environment(ME),break_string(
    "Oh war das eine schoene Metzelei, und wie sie gestorben sind - "
    "wie die Fliegen. Ah war das ein Anblick.",78,"Caroll jubelt: "));
  tell_room(environment(ME),break_string(
    "Ploetzlich wird Caroll "+pl->name(WEN,1)+" wieder gewahr."),({pl}));
  tell_object(pl,
    "Ploetzlich wird Caroll Deiner wieder gewahr.\n");
  tell_room(environment(ME),break_string(
    "Und nun troll Dich, "+pl->name(WER,1)+". Verschwinde von meinem "
    "Zufluchtsort, sonst lernst Du mich richtig kennen.",78,
    "Caroll schreit: "));
  ret=(int)pl->GiveQuest(QUEST_NAME);
  switch(ret)
  {
    case -2: case -3: 
      tell_object(pl,"Fehler: Quest konnte nicht gesetzt werden!\n"); return;
    break;
  }
  art=(int)P_ARCHON_QUESTMASTER->get_quest_kind(pl);
  switch(art)
  {
    case 1: was="Paladine"; break;
    default: was="Dunkelelfen"; break;
  }
  if (ret==-1) was+=" (redone)";
  mein_log(time(),getuid(PL),was);
  pl->SetProp(P_ARCHON_TURMQUEST,0);
  geholfen+=({pl});
  geholfen-=({0});
}
