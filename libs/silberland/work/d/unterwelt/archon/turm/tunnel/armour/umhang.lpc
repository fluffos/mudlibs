//Mit diesem Umhang + Kontaktlinse + Peruecke kann man wie ein 
//Elf bzw ein Dunkelelf aussehen - es wird nicht wirklich etwas
//am spieler geaendert (shell bzw shadow), sonder nur ein 
//Prop im Spieler gesezt P_ELF_DISGUISE bzw P_DARKELF_DISGUISE, sowie
//ein EXTRA_LOOK ... fuer stellen wo man dies verwenden will,
//ist also die abfrage auf diese Props notwendig ...
//Genutzt wird es zZ fuer meine Quest um in Turm bzw zu den
//Dunkelelfenpriesterinnen zu kommen
// 10.05.2003 Archon: - erstellt
/*
 Rev 1.1 22.06.2003 Archon: mantel zerfaellt bei ablauf der zeit
 Rev 1.0 10.05.2003 Archon: erstellt
*/
inherit "/std/armour";
#include "../def.h"
inherit STD "set_disguise";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_LONG, 
    "Dies ist nach dem aeusseren Erscheinungsbild ein ganz normaler "
    "Umhang. An einigen Stellen ist er sogar schon zerrissen und "
    "er sieht damit so aus, als ob man ihn gleich wegwerfen kann.");
  
  AddDetail(({"stelle","stellen"}),
    "An einigen Stellen ist der Umhang schon zerrissen.");
  AddDetail(({"erscheinungsbild"}),
    "Viel gibt der Umhang nicht her.");
    
  SetProp(P_NAME,"Umhang");
  SetProp(P_NAME_ADJ,"unscheinbarer");
  SetProp(P_GENDER, MALE);
  AddId("umhang");
  AddAdjective(({"unscheinbarer","unscheinbaren","unscheinbarem","unscheinbar",
                 "aktiviert","aktivierter","aktivierten","aktiviertem"}));
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK); 
  SetProp(P_AC,4);
  SetProp(P_MATERIAL, ([MAT_COTTON:100]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY,1);

  SetProp(P_DISGUISE_SET_OBJECTS,({ OBJ "peruecke",
                                    OBJ "kontaktlinse",
                                    ARMOUR "umhang" }));
  SetProp(P_DISGUISE_SET_MAXTIME, 86400); //4h - wird aber nur im reset aktiviert/deaktiviert
  SetProp(P_DISGUISE_SET_ENDTIME, 0);
  
  set_next_reset(600);  //aller 10 min ueberpruefen
}

string _query_info()
{
  int t;
  t=(int)QueryProp(P_DISGUISE_SET_ENDTIME);
  if (t<1 || t>time())
   return break_string(
    "Dieser Umhang ist etwas ganz besonderes. Zusammen mit "
    "zwei anderen Objekten kann er angelegt jeden, fuer "
    "eine gewisse Zeit, wie einen Elfen oder einen Dunkelelfen "
    "erscheinen lassen. Doch Vorsicht, nicht jeder wird "
    "darauf hereinfallen, denn eigentlich siehst Du ja noch "
    "so aus, wie zuvor. Der Zauber ist noch wirksam.");
  return break_string(
   "Dieser Umhang ist etwas ganz besonderes. Zusammen mit "
   "zwei anderen Objekten kann er angelegt jeden, fuer "
   "eine gewisse Zeit, wie einen Elfen oder einen Dunkelelfen "
   "erscheinen lassen. Der Zauber ist aber schon verflogen.");
}

varargs int DoWear(int silent, int all)
{
  int ret;
  ret=::DoWear(silent,all);
  activate_set_special(PL,ME);
  return ret;
}

varargs int DoUnwear(int silent)
{
  int ret;
  ret=::DoUnwear(silent);
  activate_set_special(PL,ME);
  return ret;
}

void activate_special(int art,object pl)
{
  int t;
  int silent;
  string race;
  silent=0;
  if (QueryProp(P_EXTRA_LOOK)) silent=1;
//erstmal loeschen ... vielleicht muessten wir das ja eh
  SetProp(P_EXTRA_LOOK,0);

  if ((t=QueryProp(P_DISGUISE_SET_ENDTIME))<1)
  {
    t=time()+QueryProp(P_DISGUISE_SET_MAXTIME);
    SetProp(P_DISGUISE_SET_ENDTIME,t);
  }
  if (t<time()) 
  {
    if (!find_call_out("remove_me")) call_out("remove_me",0,silent);
    return;
  }
  race=(string)pl->QueryProp(P_RACE);
  switch(art)
  {
    case 1: //Elf
      pl->SetProp(P_ELF_DISGUISE,t+910); //resetzeit die maximal das zuruecksetzen dauert
      if (race=="Elf")
      {
       SetProp(P_EXTRA_LOOK,break_string(
        "Es umgibt "+pl->QueryPronoun(WEN)+" ein Zauber, welcher "+
        pl->QueryPronoun(WEN)+" noch mehr elfenhaft erscheinen laesst."));
      }
      else
      {
       SetProp(P_EXTRA_LOOK,break_string(
        "Es umgibt "+pl->QueryPronoun(WEN)+" ein Zauber, welcher "+
        pl->QueryPronoun(WEN)+" wie einen Elfen aussehen laesst."));
       if (!silent)
        tell_room(environment(pl),break_string(
          pl->Name(WER,1)+" sieht ploetzlich wie ein Elf aus."),({pl}));
      }
      if (!silent)
        tell_object(pl,"Der Zauber des Umhanges beginnt zu wirken.\n");
    break;
    case 2:
      pl->SetProp(P_DARKELF_DISGUISE,t+910);
      if (race=="Dunkelelf")
      {
       SetProp(P_EXTRA_LOOK,break_string(
        "Es umgibt "+pl->QueryPronoun(WEN)+" ein Zauber, welcher "+
        pl->QueryPronoun(WEN)+" noch mehr dunkelelfenhaft erscheinen laesst."));
      }
      else
      {
       SetProp(P_EXTRA_LOOK,break_string(
        "Es umgibt "+pl->QueryPronoun(WEN)+" ein Zauber, welcher "+
        pl->QueryPronoun(WEN)+" wie einen Dunkelelfen aussehen laesst."));
       if (!silent)
        tell_room(environment(pl),break_string(
          pl->Name(WER,1)+" sieht ploetzlich wie ein Dunkelelf aus."),({pl}));
       }
      if (!silent)
        tell_object(pl,"Der Zauber des Umhanges beginnt zu wirken.\n");
    break;
    case 0:
      pl->SetProp(P_DARKELF_DISGUISE,0);
      pl->SetProp(P_ELF_DISGUISE,0);
      if (silent) //silent beim anziehen == nicht silent beim ausziehen
      {
        tell_room(environment(pl),break_string(
          pl->Name(WER,1)+" sieht ploetzlich wieder normal aus."),({pl}));
        tell_object(pl,"Der Zauber des Umhanges verliert seine Wirkung.\n");  
      }
    break;
  }
}

void reset()
{
  ::reset();
  set_next_reset(600);  //aller 10 min ueberpruefen - unabhaengig vom ansehen
  if (objectp(QueryProp(P_WORN)))
    activate_set_special(QueryProp(P_WORN),ME);
}

string _query_short()
{
  if (QueryProp(P_WORN))
    activate_set_special(QueryProp(P_WORN),ME); //ggf zuruecksetzen
  if (objectp(QueryProp(P_WORN)) && QueryProp(P_EXTRA_LOOK))
  {
    return "Ein aktivierter unscheinbarer Umhang";
  }
  return "Ein unscheinbarer Umhang";
}

void remove_me(int laut)
{
  object pl;
  pl=QueryProp(P_WORN);
  if (objectp(pl) && laut)
    tell_object(pl,"Der Zauber des Umhanges verliert seine Wirkung, als "
                   "der Umhang zerfaellt.\n");
  remove(1);
}
