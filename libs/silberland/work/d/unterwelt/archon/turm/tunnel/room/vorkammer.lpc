#pragma strict_types
#include "../def.h"
inherit "std/room";

#define ANSCHLUSS "/d/unterwelt/basics/central/room/00-01-06"

void create();
void reset();
string detail_brocken();
string detail_loch();
int cmd_krieche(string str);
int cmd_nimm(string str);

int d;
int loch;

void create()
{
  ::create();

  d=1;
  loch=0;

  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:20, ENV_TERRAIN:TT_CAVE]));
  SetProp(P_INT_SHORT, "In einer Hoehle");

  SetProp(P_INT_LONG,
    "Du stehst in einer kleinen, unauffaelligen Hoehle, in welcher bestimmt "
    "schon lange niemand mehr war. Im Norden schirmt "
    "eine Felsbarrikade die Hoehle von dem Tunnellabyrinth des Unterreiches "
    "ab und laesst diesen Ort ein wenig geschuetzt erscheinen. Am Boden "
    "liegen Schieferplatten und Felsbrocken, welche von der Ostwand "
    "abgebrochen sein muessen. Die Luft ist hier sehr stickig und Du spuerst "
    "keinen Luftzug, so dass Du fast keinen Atem bekommst.");

  AddDetail(({"hoehle","ort"}),QueryProp(P_INT_LONG));
  AddDetail(({"luft"}),
    "Die Luft ist sehr stickig. Du solltest die Hoehle wieder verlassen, "
    "bevor Du hier noch erstickst.");
  AddDetail(({"atem","atmen"}),
    "Du erstickst hier fast. Willst Du nicht langsam weiter?");
  AddDetail(({"fels", "felsen" }),
    "Die Waende, die Decke und der Boden bestehen aus massivem Fels und "
    "Schieferplatten.");
  AddDetail(({"boden"}),
    "Auf dem Boden liegen Felsbrocken und Schieferplatten, welche von der "
    "Ostwand abgebrochen sein muessen.");
  AddDetail(({"decke","felsdecke"}),
    "Sieht wie eine normale Felsdecke einer Hoehle aus.");
  AddDetail(({"waende","wand","suedwand","nordwand","westwand"}),
    "Die Waende bestehen aus normalen Felsen. Du kannst an ihnen "
    "nichts besonderes erkennen, ausser das ein grosser Gesteinsbrocken "
    "aus der Ostwand heraus gebrochen ist, welcher nun als Schutt auf "
    "dem Boden verstreut herumliegt.");
  AddDetail(({"ostwand"}),
    "Die Wand sieht aus, als ob die jemand vor langer Zeit bearbeitet "
    "haette und dabei ein Brocken aus dieser herausgebrochen wurde.");
  AddDetail(({"platte","platten","schieferplatten","schieferplatte",
              "schutt","menge","schiefer"}),
    "Auf dem Boden und insbesondere an der Ostwand verteilen sich "
    "grosse und kleine Gesteinsbrocken, Schieferplatten, sowie eine Menge "
    "kleiner Gesteinsteile (auch Schutt genannt).");
  AddDetail(({"labyrinth","tunnel","tunnellabyrinth"}),
    "Dem Tunnellabyrinth und seinen Gefahren bist Du erst einmal "
    "entronnen. Doch leider kannst Du auch hier nicht aufatmen, was "
    "mehr an der Luft, als an einer moeglichen Gefahren liegt.");
  AddDetail(({"felsbarrikade","barrikade"}),
    "Eine Felsbarrikade schirmt diese Hoehle von den Tunneln ausserhalb "
    "ab und laesst nur einen schmalen Spalt frei, durch welchen Du "
    "Dich hindurchgezwaengt hast.");
  AddDetail(({"spalt","spalte","norden"}),
    "Die Felsbarrikade laesst einen schmalen Spalt frei, durch "
    "welchen Du die Hoehle im Norden verlassen kannst.");
  AddDetail(({"gefahr","gefahren"}),
    "Viele Gefahren lauern in den Tunneln der Unterwelt.");
  AddDetail(({"unterwelt","unterreich"}),
    "Das ist hier, oder?");
  AddDetail(({"zeit"}),
    "Die Zeit vergeht, doch aendern tut sich hier unten nichts.");
  AddDetail(({"brocken","gesteinsbrocken","teil","teile","gesteinsteil",
              "gesteinsteile","felsbrocken","gestein"}),
    #'detail_brocken);
  AddDetail(({"loch","fusse","kriechtunnel"}),
    #'detail_loch);
  AddDetail(({"fuss","fuesse"}),
    "Natuerlich hast Du Fuesse, womit laeufst Du denn sonst?");
  AddDetail(({"seite"}),
    "Hm ... aehm ... nichts.");  
  AddDetail(({"kante","wurzel"}),
    "Direkt vor dir auf dem Boden erkennst Du eine Wurzel, welche leicht "
    "aus dem Boden herausragt. Etwas scheint an ihr haengen geblieben "
    "zu sein.");
  AddDetail(({"etwas"}),
    "Du koenntest versuchen dieses Etwas zu nehmen.");
  AddDetail(({"weile","zeit"}),
    "Die Zeit vergeht ...");
  AddDetail(({"luftzug","luftzuege","zug"}),
    "Du spuerst keinen Luftzug, weshalb die Luft in dieser Hoehle "
    "wohl auch so stickig ist.");
  AddDetail(({"stofffetzen","stoff","fetzen"}),
    "Damit kannst Du nichts anfangen, der Fetzen ist viel zu klein.");
  AddDetail(({"stelle","stellen"}),
    "Vielleicht bleibt hier einmal etwas haengen ...");

  AddSmell(({DEFAULT_SMELL,"luft"}),
    "Die Luft riecht etwas abgestanden.");  
  AddSound(({DEFAULT_SOUND}),
    "Nix zu hoeren.");

  AddCmd("kriech|krieche&tunnel|loch","cmd_krieche", "Wohinein willst Du kriechen?");
  AddCmd(({"nimm","nehme","nehmen"}),#'cmd_nimm);

  AddExit("norden", ANSCHLUSS);
  set_next_reset(MASTERDELAY);
}

void reset()
{
  ::reset();
  set_next_reset(MASTERDELAY);
  d=1;
  if (loch) 
    tell_room(ME,"Ein Gesteinsbrocken rollt wieder auf seinen "
                 "urspruenglichen Platz.\n");
  loch=0;
}

string detail_brocken()
{
  tell_room(ME,break_string(
    PL->Name(WER,NAME_AUTO)+" macht irgendetwas."),({PL}));
  if (!loch)
  {
    loch=1;
    return break_string(
      "Du untersuchst die Gesteinsbrocken und rollst ein paar zur Seite, "
      "als Du ploetzlich, einen Brocken bewegend, ein Loch am Fusse der "
      "Ostwand freilegst.");
  }
  return break_string(
    "Du untersuchst die Gesteinsbrocken und rollst ein paar zur Seite, "
    "doch findest Du unter den Brocken nichts interessantes. Nur ein "
    "Loch in der Ostwand faellt Dir auf, welches einmal von einem "
    "Gesteinsbrocken versperrt gewesen sein muss.");
}

string detail_loch()
{
  if (loch)
    return break_string(
      "Das Loch in der Ostwand scheint ein Tunnel zu sein. Vielleicht "
      "kannst Du dort hineinkriechen. Du stehst eine Weile unschluessig "
      "davor, als Dir davor eine spitze Kante oder Wurzel, welche aus "
      "dem Boden ragt, auffaellt.");
  return break_string(
    "Du findest so etwas nicht, doch faellt Dir eine spitze Kante oder "
    "Wurzel auf, welche aus dem Boden ragt.");  
}

int cmd_krieche(string str)
{
  object ob;
  string raum;
  if (!loch)
    return write("Dies siehst Du hier nicht.\n"),1;

  write(break_string("Du begibst Dich zu dem Tunnel, zwaengst "
       "Dich in diesen hinein und beginnst vorwaerts zu kriechen."));
/*
  ob=clone_object(ROOM "tunnel");
  PL->move(ob,M_GO,"","verschwindet","erscheint");
  ob->set_owner(PL,ROOM "kammer_01");
*/
  raum=ROOM "tunnel:"+getuid(PL);
  PL->move(raum,M_GO,"","verschwindet","erscheint");
  find_object(raum)->set_owner(PL,ROOM "kammer_01");
  
  return 1;
}

int cmd_nimm(string str)
{
  object ob;
  if (!S_STANDARD->check_cmd(str,
       "etwas",
       "Was willst Du nehmen?"))
    return 0;

  tell_room(ME,break_string(
    PL->Name(WER,1)+" beugt sich ueber irgendetwas."),({PL}));
  if (!d)
  {
    write(break_string("Du greifst nach dem Etwas und stellst fest, dass es "
      "nur ein Stofffetzen ist, welchen Du gleich an der Wurzel haengen "
      "laesst. Auch wenn Du nichts Interessantes gefunden hast, solltest "
      "Du Dir die Stelle merken, vielleicht bleibt ja mal etwas wichtiges "
      "an der Wurzel haengen."));
    return 1;
  }
  d=0;
  ob=clone_object(OBJ "dietrich");
  if (ob->move(PL,M_GIVE|M_SILENT)<1)
  {
    ob->move(ME,M_NOCHECK|M_SILENT);
    write(break_string("Leider kannst Du den Dietrich nicht mehr tragen und "
      "laesst ihn wieder fallen."));
    tell_room(ME,break_string(
      PL->Name(WER,1)+" laesst etwas fallen."));
  }
  else
  {
    write(break_string("Du greifst nach dem Etwas und findest einen "
      "Dietrich, den Du sofort einsteckst."));
  }
  return 1;
}
