#pragma strong_types
inherit "std/thing";
#include "../def.h"

void create() 
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_SHORT,"Ein Winkeleisen");
  SetProp(P_LONG,
    "Dieses Winkeleisen hast Du von den morschen Beinen des "
    "Bettgestelles herausgezogen. Du glaubst, dass man damit "
    "gut schaben koennte.");

  SetProp(P_MATERIAL,([MAT_IRON:100]));
  SetProp(P_NAME, "Winkeleisen");
  SetProp(P_GENDER,MALE);
  SetProp(P_WEIGHT,20);
  SetProp(P_VALUE,1);
  SetProp(P_SIZE,10);
  AddId(({"eisen","winkel","winkeleisen"}));
}
