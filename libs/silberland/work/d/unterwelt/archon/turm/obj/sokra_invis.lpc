#include "../def.h"
inherit "std/thing";

object owner;

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_LONG,0);
  SetProp(P_NAME,0);
  SetProp(P_SHORT,0);

  SetProp(P_GENDER,NEUTER);

  AddId(({"sokra_invis"}),({}));

  SetProp(P_WEIGHT,0);
  SetProp(P_VALUE,0);
  SetProp(P_NODROP,1);
}

void set_owner(object pl)
{
  owner=pl;
  call_out("zurueck",30,0);
}

void reset()
{
  ::reset();
  if (!is_clone(ME)) return;
  remove(1);
}

void zurueck(int pos)
{
  int p;
  if (!objectp(owner) || environment(ME)!=owner)
  {
    remove(1);
    return;
  }
  switch(pos)
  {
    case 0: case 1: case 2: case 3: case 4:
      tell_object(owner,break_string(
        "Du kannst nur noch verschwommen sehen. Ob das die "
        "Nachwirkungen der Sokrapflanze sind?"));
      tell_room(environment(owner),break_string(owner->Name(WER,NAME_AUTO)+
                " verzieht "+owner->QueryPossPronoun(MALE,WER,SINGULAR)+
                " Gesicht."),({owner}));
      owner->reduce_spell_points(10);
      owner->AddHp(2);
      owner->AddSp(-12);
    break;
    default:
      remove(1);
      return;
    break;
  }
  call_out("zurueck",15+random(31),pos+1);
}
