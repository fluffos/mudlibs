#pragma strong_types
inherit "std/thing";
#include "../def.h"

void create() 
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_SHORT,"Ein paar Naegel");
  SetProp(P_LONG,
    "Dies sind ganz lange Naegel, welche Dir bestimmt noch nuetzlich sind.");
  SetProp(P_MATERIAL,([MAT_IRON:100]));
  SetProp(P_NAME, "Naegel");
  SetProp(P_PLURAL,1);
  SetProp(P_GENDER,FEMALE);
  SetProp(P_WEIGHT,40);
  SetProp(P_VALUE,1);
  AddId(({"nagel","naegel","paar naegel"}));
}
