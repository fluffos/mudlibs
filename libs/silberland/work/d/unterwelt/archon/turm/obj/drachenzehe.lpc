#pragma strong_types
inherit "std/thing";
#include "../def.h"

void create() 
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_SHORT,"Eine abgebrochene Drachenzehe");
  SetProp(P_LONG,
    "Dies ist eine abgebrochene Drachenzehe. Fuer sich alleine ist sie "
    "zu nichts zu gebrauchen. Du kannst sie ruhig wegwerfen.");

  SetProp(P_MATERIAL,([MAT_MISC_DEAD:100]));
  SetProp(P_NAME, "Drachenzehe");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_WEIGHT,120);
  SetProp(P_VALUE,1);
  SetProp(P_NOBUY,1);
  AddId(({"zehe","drachenzehe"}));
  
  SetProp(P_INFO,"Die Drachenzehe muss irgendwo abgebrochen sein. "
    "Wenn Du die richtige Stelle findest, ist sie Dir bestimmt von "
    "Nutzen.");
}

void reset()
{
  ::reset();
  if (!is_clone(ME)) return;
  if (!environment(ME)) remove(1);
  if (!living(environment(ME))) remove(0);
}

varargs int remove(int silent)
{
  if (silent || !environment(ME)) return ::remove(0);
  if (living(environment(ME)))
    tell_object(environment(ME),"Die Drachenzaehe zerfaellt zu Staub.\n");
  else
    tell_room(environment(ME),"Die Drachenzaehe zerfaellt zu Staub.\n");
  return ::remove(1);
}