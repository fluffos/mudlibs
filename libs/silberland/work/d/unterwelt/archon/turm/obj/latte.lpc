#pragma strong_types
inherit "std/thing";
#include "../def.h"

void create() 
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_SHORT,"Eine Latte");
  SetProp(P_LONG,
    "Diese stabile Latte hast Du aus dem Bettgestell herausgebrochen. "
    "Sie ist etwa zwei Meter lang und hat eine Spitze. Du koenntest die "
    "Latte bestimmt als Hebel einsetzen, falls Du etwas schweres heben "
    "muesstest.");
  AddDetail(({"meter"}),
    "Du weisst schon wieviel dies ist.");
  AddDetail(({"hebel"}),
    "Du kannst die Latte bestimmt hier irgendwo gebrauchen. "
    "Mit irgendetwas musst Du es ja schaffen, hier herauszukommen.");
  AddDetail(({"spitze"}),
    "Die Spitze sieht so aus, als ob sie nicht gleich abbrechen wuerde, "
    "wenn sie belastet wuerde.");

  SetProp(P_MATERIAL,([MAT_MISC_WOOD:100]));
  SetProp(P_NAME, "Latte");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_WEIGHT,220);
  SetProp(P_VALUE,1);
  SetProp(P_SIZE,200);
  AddId(({"latte"}));
}
