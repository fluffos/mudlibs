#pragma strong_types
inherit "std/thing";
#include "../def.h"

void create() 
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_SHORT,"Ein Holzstab");
  SetProp(P_LONG,
    "Der Holzstab ist ungefaehr einen halben Meter breit und er sieht aus, "
    "als ob man damit etwas basteln koenne. Als Waffe eignet er sich "
    "auf jeden Fall nicht.");
  SetProp(P_MATERIAL,([MAT_MISC_WOOD:100]));
  SetProp(P_NAME, "Holzstab");
  SetProp(P_GENDER,MALE);
  SetProp(P_WEIGHT,60);
  SetProp(P_VALUE,1);
  AddId(({"stab","holzstab"}));
}

void reset()
{
  ::reset();
  if (!is_clone(ME)) return;
  if (!environment(ME)) remove(1);
  if (!living(environment(ME))) remove(0);
}

varargs int remove(int silent)
{
  if (silent || !environment(ME)) return ::remove(0);
  if (living(environment(ME)))
    tell_object(environment(ME),"Der Holzstab zerfaellt zu Staub.\n");
  else
    tell_room(environment(ME),"Der Holzstab zerfaellt zu Staub.\n");
  return ::remove(1);
}
