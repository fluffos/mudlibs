inherit "std/thing"; 
#include "../def.h"

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT,"Ein Rune der Beschwoerung");
  SetProp(P_LONG,
    "Dies ist eine Dir nichts sagende Rune. "
    "Doch selbst wenn Du nichts ueber sie weisst, sagt Dir eine "
    "innere Stimme, dass dies eine Beschwoerungsrune ist. "
    "Richtig angewendet, sollte sie Jemanden herbei rufen.");
  
  AddDetail(({"jemand","jemanden"}),
    "Wer koennte das nur sein?");
  AddDetail(({"stimme"}),
    "Ob Du ihr vertrauen kannst?");

  SetProp(P_VALUE,300);
  SetProp(P_WEIGHT,500);
  SetProp(P_MATERIAL,([MAT_GRANITE:100]));
  SetProp(P_NAME,"Rune");
  SetProp(P_GENDER,MALE);
  SetProp(P_NOBUY,1);

  SetProp(P_INFO,
    "Diese Rune wird einen Waechter der Erde rufen.");
  
  AddId(({"rune","beschwoerungsrune"}));
}
