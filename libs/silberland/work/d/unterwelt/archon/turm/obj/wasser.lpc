// Das wasser sollte eigentlich nicht als Objekt fuer Spieler sichtbar sein
/*
 Rev 1.0 26.01.2003 Archon: erstellt
*/

#pragma strong_types
inherit "std/thing";
#include "../def.h"

void create() 
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_SHORT,"Wasser");
  SetProp(P_LONG,
    "Schoenes klares Wasser.");
  SetProp(P_MATERIAL,([MAT_WATER:100]));
  SetProp(P_NAME, "Wasser");
  SetProp(P_GENDER,NEUTER);
  SetProp(P_WEIGHT,1000);
  SetProp(P_VALUE,0);
  AddId(({"wasser"}));
}
