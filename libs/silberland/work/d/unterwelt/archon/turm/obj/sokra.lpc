#include "../def.h"
#include <food.h>
inherit "std/food";

void create()
{
    if(!is_clone(ME)) return;
    ::create();

    SetProp(P_SHORT,"Blatt einer Sokrapflanze");
    SetProp(P_LONG,
       "Dies ist das schmale Blatt einer Sokrapflanze. Das Blatt hat "
       "fuenf Zacken und siehst auch sonst wie ein normales Blatt aus, "
       "doch du hast schon irgendwann einmal etwas von der Pflanze "
       "gehoert. Leider kannst Du Dich nicht mehr an den Zusammenhang "
       "erinnern, doch Du weisst noch, dass es mit der "
       "Wirkung und Nebenwirkung des Blattes beim Essen zu tun hatte.");
      
    AddDetail(({"zacken"}),
      "Das Blatt hat fuenf Zacken.");
    AddDetail(({"pflanze","sokra","sokrapflanze"}),
      "Dies ist nur noch ein Blatt.");
    AddDetail(({"nebenwirkung","nebenwirkungen","wirkung","wirkungen",
                "zusammenhang"}),
      "Die Nebenwirkung verraet Dir das Blatt nicht. Auch wenn Du "
      "es noch so genau untersuchst.");
    AddDetail(({"leben","essen","kost"}),
      "Nutz das Blatt besser nur, wenn es absolut noetig ist.");
      
    SetProp(P_NAME,"Blatt");
    SetProp(P_GENDER, NEUTER);

    SetProp(P_SMELL,"Das Sokrablatt riecht sehr suesslich. "
                    "Eine gefaehrliche Verfuehrung?");

    SetProp(P_VALUE,300);
    SetProp(P_WEIGHT,10);

    SetProp(P_FOOD_INFO,([F_HEAL:({-10,60}),
                          F_SOAK:2,
                          F_DRINK:1,
                          F_ALCOHOL:0,
                          F_POISON:0,
                          F_MSG:"Du steckst das Blatt in den Mund. Beinahe "
                                "haettest Du es wieder ausgespuckt, als Du "
                                "den widerlich bittere Geschmack bemerkst, "
                                "doch fuehlst Du auch, wie neue Energie durch "
                                "Dich hindurch fliesst.",
                          F_MSG_ROOM:" isst etwas restlos auf.",
                          F_VERB:"essen"]));

    AddId(({"blatt","sokrablatt","sokra"}));
}

void Eating(object pl) 
{
  object ob;
  ob=clone_object(OBJ "sokra_invis");
  ob->move(this_player(),M_NOCHECK|M_SILENT);
  ob->set_owner(pl);
}
