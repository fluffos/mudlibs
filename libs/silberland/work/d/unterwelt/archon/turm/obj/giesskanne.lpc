#pragma strong_types
#include "../def.h"
#include <fishing.h>
inherit "/std/container";

void create();
string _query_short();
string _query_long();
varargs int PreventInsert(object ob);
varargs int PreventLeave(object ob,mixed desc);
int cmd_fuelle(string str);
int cmd_giessen(string str);

void create()
{
  ::create();
  SetProp(P_NAME,"Giesskanne");
  SetProp(P_MATERIAL,([MAT_PLASTIC:100]));
  SetProp(P_GENDER,FEMALE);
  SetProp(P_VALUE,1);
  SetProp(P_WEIGHT,100);
  SetProp(P_MAX_WEIGHT, 5000);
  SetProp(P_WEIGHT_PERCENT, 50);
  AddId(({"kanne","giesskanne"}));
  
  AddCmd(({"fuelle","fuellen","fuell"}),"cmd_fuelle");
  AddCmd(({"giess","giesse","giessen"}),"cmd_giessen");
}

string _query_short()
{
  object *ob;
  ob=all_inventory(ME);
  switch(sizeof(ob))
  {
    case 0:  return "Eine leere Giesskanne";
    default:  return "Eine Giesskanne mit Wasser";
  }
}

string _query_long()
{
  object *ob;
  ob=all_inventory(ME);
  switch(sizeof(ob))
  {
    case 0:  
      return break_string("Du siehst eine einfach gearbeitete leere "
             "Giesskanne. Du solltest Wasser suchen, und sie damit fuellen.");
    default:  
      return break_string("Du siehst eine einfach gearbeitete mit "
             "Wasser gefuellte Giesskanne. Du solltest Dir etwas suchen, was "
             "Du giessen kannst.");
  }
}

varargs int PreventInsert(object ob)
{
  if (ob && ob->id("wasser"))
    return (int)::PreventInsert(ob);
  write("Du kannst nur Wasser in die Giesskanne fuellen.\n");
  return 1;
}

varargs int PreventLeave(object ob,mixed desc)
{
  write(break_string("Du Giesskanne weigert sich das Wasser herzugeben, wenn "
        "Du nicht etwas Bestimmtes giesst."));
  return 1;
}

int cmd_fuelle(string str)
{
  object ob;
  object raum;
  int wasser_typ;
  if (!S_STANDARD->check_cmd(str,
       "giesskanne|kanne&wasser",
       "Was willst Du womit fuellen?|Womit willst Du die Giesskanne fuellen?"))
    return 0;

  raum=environment(PL);
  if (!raum) return 0; //sollte nie passieren ...
  wasser_typ=raum->QueryProp(P_WATER);
  if (present("wasser",ME))
  {
    write("Aber die Giesskanne ist doch schon voller Wasser.\n");
    return 1;
  }
  if (stringp(function_exists("FindLiquid",raum)))
  {
    if (!raum->FindLiquid("wasser")) return 1;
  }
  else
    if (!present("wasser",raum) &&
      !raum->id("wasser") && !raum->id("Wasser"))
  {
    if (!wasser_typ)
    {
      write("Du kannst hier kein Wasser finden.\n");
      return 1;
    }
    if (wasser_typ && wasser_typ<8) //Salzwasser
    {
      write("Salzwasser ist zum Giessen ungeeignet.\n");
      return 1;
    }
    //es gibt doch suesswasser ... 
  }
  ob = clone_object(OBJ "wasser");
  if(ob->move(ME, M_PUT, M_GET) != 1)
  {
   tell_object(this_player(), "Die Giesskanne wuerde Dir dann zu schwer "
               "werden.\n");
   }
   else
   {
   write("Du fuellst die Giesskanne randvoll mit Wasser.\n"); 
   }
  return 1;
}

//erwartet eine rueckgabe der Funktion GetGiessen(str)
//rueckgabe ist ein string -> ausgabe
//rueckgabe ist zahle>0 -> return 0;
int cmd_giessen(string str)
{
  mixed ret;
  object raum,w;

  if (!w=present("wasser",ME))
  {
    return 
      notify_fail("Aber es ist doch gar kein Wasser in der Giesskanne.\n"),0;
  }
  if (S_STANDARD->check_cmd(str,
      "aus",
      "Was willst Du womit giessen? Oder willst Du die Giesskanne AUSgiessen?"))
  {
    write("Du giesst das Wasser aus der Geisskanne aus.\n");
    w->remove(1);
    return 1;
  }

  raum=environment(PL);
  if (!raum) return 0; //sollte nie passieren ...
  notify_fail("Hier ist nichts, was die Giesskanne giessen will.\n");
  ret=(mixed)raum->GetGiessen(str);
  if (!ret)
    return 0; //eignes notify_fail oder eins aus GetGiessen ...
  w->remove(1);
  if (stringp(ret))
    write(break_string(ret));
  return 1;
}

int remove(int s)
{
  object w;
  w=present("wasser",ME);
  if (w) w->remove(1);
  return ::remove(s);  
}
