#include "../def.h"
inherit "std/room";

#pragma strict_types, pedantic

void create();
int exit_aufgabe();
string detail_raum();
string detail_materie();
int cmd_luefte(string str);

void create_aufgang(int richtung);
int exit_gehen();
int cmd_sagen(string str);
void create_spitze();
int cmd_greif(string str);
void create_mitte();
void create_unten();

int jemand_kam;

void create()
{
  ::create();

  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE:22, ENV_TERRAIN:TT_HOUSE]));
  SetProp(P_INT_SHORT, "Ein Standardraum");
  SetProp(P_INT_LONG, "Ein Standardraum. Du solltest nicht hier sein!");

  AddDetail(({"raum"}),#'detail_raum);
  AddDetail(({"turm","inneren","ort"}),
    "Du bist im Inneren eines Turmes. Du glaubst, dass er vor langer Zeit magisch "
    "errichtet wurde.");
  AddDetail(({"magier"}),
    "Magier, welche sich ins Reich der Dunkelelfen wagen sind bestimmt "
    "sehr maechtig. Du solltest versuchen, ihnen nicht bloed zu kommen, "
    "falls Du einen triffst. Wer weiss, was sie dann mit Dir machen.");
  AddDetail(({"wesen","dunkelelfen","dunkelefe",
              "dunkelelfenkrieger","dunkelelfenmagier",
              "dunkelelfenpriesterinnen","dunkelelfenpriesterin",
              "bruder","brueder","schwestermord",
              "brudermord","schwester","schwerstern","schwestermorde",
              "schwesternmord","mutter","muetter","muttermord",
              "muttermorde"}),
    "Die Dunkelelfen leben hier in der Unterwelt. "
    "Sie sind wilde, boesartige Wesen, die ihre Freude am Morden haben. "
    "Sie dulden keine andere Macht, ausser ihre eigene und selbst da sind "
    "sie nicht zimperlich und Bruder-, Schwester- oder Muttermorde sind an "
    "der Tagesordnung.");
  AddDetail(({"freude"}),
    "Woran hast Du denn Freude?");
  AddDetail(({"macht","art","arten","nachdenken","energie","energien","gewalt"}),
    "Es gibt viele Arten von Macht. Mit etwas Zeit und vielem Nachdenken fallen "
    "Dir bestimmt viele ein.");
  AddDetail(({"reich","unterwelt"}),
    "Du bist gerade in einem Turm in der Unterwelt.");
  AddDetail(({"mord","morden","morde","handwerk"}),
    "Die Dunkelelfen sind gut im Morden, aber gewiss nicht die einzigen die dieses "
    "'Handwerk' beherrschen.");
  AddDetail(({"tagesordnung"}),
    "Ach was steht heute auf der Tagesordnung: 1. Aufstehen; 2. Bad benutzen; 3. ...");
  AddDetail(({"bau","zeit","hinblick","zeiten","erschaffer","erbauer"}),
    "Der Turm wurde scheinbar vor Ewigkeiten von einem Magier mittels Magie "
    "erschaffen. Es ist erstaunlich, dass der Turm die Zeiten seitdem ueberstanden "
    "hat, insbesondere im Hinblick auf die Kampfesspuren, welche Dir ausserhalb "
    "aufgefallen waren.");
  AddDetail(({"kampfspuren","kampfesspuren","kampf"}),
    "Aussen an den Turmwaenden konntest Du Kampfesspuren sehen, hier drinnen nicht.");
  AddDetail(({"turmwand","turmwaende","turmwaenden"}),
    "Verlasse den Turm - draussen kannst Du sie betrachten.");
  AddDetail(({"ewigkeit", "ewigkeiten"}),
    "Das muss schon lange her sein.");
  AddDetail(({"umgebung","ort"}),
    "Schau Dich einfach um.");
  AddDetail(({"licht", "leuchten", "lichtquelle", "quelle"}),
    "Ein magisches Leuchten umgibt Dich und erhellt alles in einem diffusen "
    "Licht.");
  AddDetail(({"ruhe", "abgeschiedenheit", "stille"}),
    "Manchmal wuenschst Du Dir, auch einen Ort zu haben, wo Du Deine Ruhe hast.");
  AddDetail(({"atmosphaere"}),
    "Ruhe und Stille umgibt Dich.");
  AddDetail(({"bewohner"}),
    "Der Turm muss lange leer gestanden haben. Geruch von Verfallenem haengt in der Luft "
    "und am Boden kann man frische Fussspuren im Staub erkennen.");
  AddDetail(({"staub","staubschicht","schicht"}),
    "Staub bedeckt hier alles. Es kann noch nicht lange her sein, dass sich wieder "
    "jemand im Turm aufhaelt.");
  AddDetail(({"jemand"}),
    "Such doch einfach, dann findest Du auch jemanden.");
  AddDetail(({"fussspuren","fusspuren","spuren","spur","fusspur","fussspur"}),
    "In der Staubschicht auf dem Boden sind viele frische Fussspuren zu erkennen.");
  AddDetail(({"wache","waechter","turmwaechter","unsichtbare","diener","turmdiener"}),
    "Die Waechter und Diener des Turmes muessten hier irgendwo sein. Doch sind sie "
    "wohl, wie der Waechter der Dich hier hineingebracht hat formlos und somit "
    "unsichtbar. Doch aus irgend einer Materie muessen auch sie bestehen, denn Du "
    "kannst noch immer die kalte Beruehrung des Turmwaechters spueren.");
  AddDetail(({"beruehrung"}),
    "Du kannst sie noch immer spueren.");
  AddDetail(({"materie","kraft"}),#'detail_materie);
  AddDetail(({"luft","atmen"}),
    "Luft ist wohl da, sonst koenntest Du ja nicht Atmen.");
  AddDetail(({"magie"}),
    "Vor langer Zeit wurde dieser Turm mittels Magie erschaffen.");
  AddDetail(({"glueck"}),
    "Hast Du welches, brauchst Du keins - hast Du es nicht, kann es Dir auch "
    "keiner geben.");
  AddDetail(({"rune","runen","schutzrune","schutzrunen","schutz"}),
    "Ueberall im Turm sind Runen des Schutzes zu finden. Nur so ist zu "
    "erklaeren, wie dieser Turm in feindlichen Gebiet so lange existieren "
    "konnte.");
  AddDetail(({"gebiet","silberland"}),
    "Du bist in der Unterwelt, einem Gebiet des Silberlandes.");
  AddDetail(({"geruch","verfallenem"}),
    "Rieche lieber.");
  AddDetail(({"rueckschluss","aktion","rueckschluesse"}),
    "Was erwartest Du bei dieser Aktion?");
  AddDetail(({"richtung","richtungen","himmelsrichtung","himmelsrichtungen"}),
    "Wohin willst Du denn?");
  AddDetail(({"norden","osten","sueden","westen","oben","unten"}),
    "In diese Richtung kannst Du leider nicht gehen.");
  AddDetail(({"hauch"}),
    "Du musst Dich getaeuscht haben.");

  AddSmell(DEFAULT_SMELL,
    "Ihh die Luft hier riecht abgestanden. Man sollte hier einmal lueften.");
  AddSmell(({"luft","geruch","verfallenem"}),
    "Ein Wunder, dass man die Luft noch atmen kann, denn wenn der Geruch "
    "der Luft irgendwelche Rueckschluesse zulaesst, ist sie alt und verbraucht.");
  AddSmell(({"rueckschluesse","rueckschluss","wunder"}),
    "Und wie denkst Du, dass Du dies erriechen kannst?");
  AddSound(DEFAULT_SOUND,
    "Du hoerst ein schwaches Summen.");
  AddSound(({"summen"}),
    "Woher mag dieses Summen nur kommen?");

  AddCmd(({"luefte","lueften"}),"cmd_luefte");
  
  SetProp(P_HIDE_EXITS,({"aufgabe"}));
  AddExit("aufgabe",#'exit_aufgabe);
  
  set_next_reset(MASTERDELAY);
}

int exit_aufgabe()
{
  write("Deine Aufgabe ist es, hier heraus zu finden.\n");
  return 1;
}

string detail_raum()
{
  return break_string(QueryProp(P_INT_LONG));
}

string detail_materie()
{
  if (S_STANDARD->present_clone(NPC "waechter",ME))
  {
    return break_string(
      "Du erkennst die gebuendelte Kraft eines Turmwaechters, der mitten im "
      "Raum schwebt. Nur jetzt, als Du ihn direkt ansiehst, kannst Du ihn "
      "ueberhaupt wahrnehmen.");
  }
  return "Du siehst um Dich herum nur Luft.\n";
}

int cmd_luefte(string str)
{
  write("Und wie stellst Du Dir das vor?\n");
  return 1;
}

void create_aufgang(int richtung)
{
  AddDetail(({"absatz","treppenabsatz"}),
    "Natuerlich hat dies diese Treppe auch.");
  AddDetail(({"treppe","aufgang","abgang","wendeltreppe"}),
    "Du erkennst eine Wendeltreppe. Die Stufen fuehren bestimmt irgendwo hin. "
    "Ob Du ihnen folgen solltest?");
  AddDetail(({"stufe","stufen","treppenstufe","treppenstufen"}),
    "Natuerlich hat die Treppe Stufen.");
  AddDetail(({"eingebung","richtung"}),
    "Vielleicht solltest Du einfach befehlen in welche Richtung Du willst und die "
    "unsichtbaren Diener uebernehmen den Rest fuer Dich?");
  AddDetail(({"rest"}),
    "Klopf, Klopf ... Jemand zu Hause? Welchen Rest koennten die Diener "
    "denn uebernehmen?");
//seufz leider kann ich hier sag nicht als einzige option nehmen, da ' nicht in ein 
//kommando sag umgewandelt wird und ich will nicht per add_action arbeiten
  AddCmd(({"befehl","befehle","befehlen","sag","sagen","sage"}),"cmd_sagen");
  if (richtung&1) 
  {
    AddExit("oben",#'exit_gehen); 
  }
  if (richtung&2)
  {
    AddExit("unten",#'exit_gehen);
  }
}

int exit_gehen()
{
  string treppe;
  object ob;
  treppe=ROOM "treppe:"+getuid(PL);
  tell_object(PL,"Du betrittst die Treppe und beginnst zu laufen.\n");
  PL->move(treppe,M_GO,"","benutzt die Treppe","kommt von der Treppe");
  ob=find_object(treppe);
  ob->set_owner(PL,ME); //nicht ueber init sondern explizit!
  return 1;
}

int cmd_sagen(string str) 
{ 
  if (!stringp(str)) return 0;
  str=lower_case(str);
  if (str=="oben" || str=="ob" || str=="hinauf")
  {
    return 2;
  }
  if (str=="unten" || str=="u" || str=="hinab")
  {
    return 3;
  }
  return 0;
} //wird im richtigen raum mit move-bewegungen ueberschrieben

void create_spitze()
{
  AddDetail(({"spitze"}),
    "Dies ist hier wohl die Spitze des Turmes.");
  AddDetail(({"gang","gaenge","ebene"}),
    "Die Gaenge auf dieser Ebene des Turmes moegen einmal mit schoenen Marmorplatten "
    "verkleidet gewesen sein, doch jetzt sind sie schwarz verrusst und zeigen deutliche "
    "Brandspuren.");
  AddDetail(({"brandspur","spur","spuren","brandspuren","russspuren","russ","eins"}),
    "Auch wenn die Dunkelelfen noch nie hier eingedrungen sind, hat es ihre Magie "
    "anscheinend doch hier herein geschafft. So wie es hier aussieht, muessen gewaltige "
    "Explosionen alles Leben zerstoert haben.");
  AddDetail(({"leben","explosion","explosionen","gewalt","inferno","brand","hitze","verfuegung"}),
    "Du kannst Dir nicht vorstellen, dass einer dieses noch immer sichtbare Inferno "
    "ueberstanden hat. Aber andererseits weisst Du nicht, welche Macht dem Erbauer dieses "
    "Turmes noch zur Verfuegung stand. Denn Eins ist sicher, erobert haben die Dunkelelfen "
    "dieses Turm noch nie. Vielleicht konnte der Magier selbst diese rohe Gewalt ueberleben.");
  AddDetail(({"aehnliches","feuerball","feuerbaelle"}),
    "Nach dem Ausmass des jetzt noch sichtbaren Schadens, muessen das riesige Feuerbaelle "
    "oder etwas Aehnliches gewesen sein, was die Dunkelelfenpriesterinnen und Magier hier "
    "entstehen lassen haben, um die Verteidiger des Turmes zu zerstoeren. Du fragst Dich, "
    "wie dies bei den ganzen Schutzrunen ueberhaupt moeglich war.");
  AddDetail(({"ausmass","schaden"}),
    "Zum Glueck warst Du nicht hier, als der Feuerball explodierte.");
  AddDetail(({"boden","fussboden"}),
    "Der Boden ist schwarz gebrannt. An einigen Stellen erkennst Du eine Dir unbekannt "
    "schwarz schimmernde geleeartige Masse.");
  AddDetail(({"masse","rest","reste"}),
    "Es sieht aus wie die Reste verbrannter Materie. Vielleicht hat es dort vor "
    "langer Zeit einen der unsichtbaren Waechter oder Diener erwischt?");
  AddDetail(({"wand","waende"}),
    "Ueberall sind Brand- und Russspuren. Die Hitze der Feuerbaelle muss immens gewesen sein, "
    "denn teilweise wurden die Marmorplatten regelrecht weggeschmolzen und es haben sich "
    "Risse und Spalten gebildet. An einigen Stellen kannst Du dunkle Flecken erkennen.");
  AddDetail(({"stelle","stellen"}),
    "Was wolltest Du genauer untersuchen die Flecken oder die geleeartige Masse?");
  AddDetail(({"platte","platten","marmorplatten","marmorplatte"}),
    "Die Marmorplatten sind teilweise regelrecht weggeschmolzen.");
  AddDetail(({"riss","risse","spalt","spalten"}),
    "Lauter Risse und sogar Spalten durchziehen die Waende.");
  AddDetail(({"fleck","flecken"}),
    "Ob dies verbranntes Blut ist?");
  AddDetail(({"blut"}),
    "Die dunklen Flecken koennten einmal Blut gewesen sein.");
  AddDetail(({"decke"}),
    "Die Decke sieht auch nicht besser als die Waende oder der Boden aus.");
  AddDetail(({"verteidiger","genossen","sinnesgenossen","genosse","sinnesgenosse"}),
    "Die Verteidiger waren wohl der Erbauer, etwaige andere Abenteurer und Sinnesgenossen, "
    "sowie die magischen Diener und Waechter.");
  AddDetail(({"abenteurer"}),
    "Ja - das ist jemand wie Du.");

  AddCmd(({"greif","greife","fass","fasse"}),"cmd_greif");
}

int cmd_greif(string str)
{
  if (!S_STANDARD->check_cmd(str,
       "riss|risse|spalt|spalten",
       "Wo willst Du hinein greifen?"))
    return 0;

  write("Die Risse und Spalten sind viel zu klein, um dort hineinzugreifen.\n");
  return 1;  
}

void create_mitte()
{
  AddDetail(({"gang","gaenge"}),
    "Die Gaenge auf dieser Ebene des Turmes sind mit Marmorplatten verkleidet.");
  AddDetail(({"turm","ebene"}),
    "Du befindest Dich auf der mittleren Ebene des Turmes. Die Gaenge wurden "
    "mit Marmorplatten verkleidet.");
  AddDetail(({"wand","waende"}),
    "An die Waende wurden kleine weisse Marmorplatten fein saeuberlich aneinander gereiht. "
    "Zwischen den Platten kannst Du keine Fugen und nur ganz feine Ritzen erkennen.");
  AddDetail(({"fugen","keine"}),
    "Du siehst KEINE Fugen.");
  AddDetail(({"ritze","ritzen","ritz"}),
    "Wenn man die Waende nicht genau betrachtet, koennte man meinen, die Waende bestehen "
    "aus einer riesigen weissen Marmorflaeche. Doch selbst der Erschaffer dieses Turmes "
    "hat nur einzelne Platten aneinander gereiht.");
  AddDetail(({"boden","decke","fussboden"}),
    "Der Boden und die Decke bestehen aus einfachen Stein- und Marmorplatten, "
    "die ohne irgendwelche Verzierungen erschaffen wurden.");
  AddDetail(({"marmor","stein","marmorplatten","platten","steinplatte","steinplatten",
              "flaeche","flaechen","marmorflaechen","marmorflaeche"}),
    "Rund um Dich herum wurden Marmorplatten und Steinplatten zum Bau des Turmes "
    "verwendet.");
  AddDetail(({"verzierung","verzierungen"}),
    "Nirgends kannst Du irgendwelche Verzierungen erkennen. Ob das nur daran "
    "liegt, das Du kein Magier bist?");
}

void create_unten()
{
  AddDetail(({"gang","gaenge"}),
    "Die Gaenge auf dieser Ebene des Turmes sind mit roher Gewalt in den Felsen "
    "gegraben wurden. Magische Wesen und ungezuegelte magische Energien haben "
    "riesige Gesteinsbrocken herausgerissen und zackige, rissige, unebene Waende "
    "und eine aehnlich aussehende Decke hinterlassen. Nur der Boden wurde, um "
    "besser laufen zu koennen, eingeebnet.");
  AddDetail(({"turm","ebene"}),
    "Du befindest Dich auf der untersten Ebene des Turmes. Die Gaenge wurden "
    "direkt in das Felsgestein getrieben.");
  AddDetail(({"fels","felsen","gestein","felsgestein","brocken","gesteinsbrocken",
              "felsbrocken"}),
    "Du erkennst grauen Granit.");
  AddDetail(({"granit"}),
    "Der Boden, die Decke, die Waende, sprich der Gang besteht aus Granit.");
  AddDetail(({"boden","fussboden"}),
    "Der felsige Boden wurde eingeebnet, damit man ohne zu stolpern laufen kann.");
  AddDetail(({"granitwand","granitwaende","wand","waende"}),
    "Rauhes, kantiges, unverziertes Felsgestein bildet die Waende.");
  AddDetail(({"decke","rundbogen","bogen","spitze","spitzen"}),
    "Nicht weit ueber Deinem Kopfe bildet das felsige Gestein einen Rundbogen. "
    "Immer wieder haengen einzelne Felsbrocken als Spitzen heraus. Zum Glueck "
    "ist die Decke hoch genug, damit Du nicht Deinen Kopf stoesst.");
  AddDetail(({"kopf"}),
    "Das ist das komische Ding auf Deinem Hals.");
  AddDetail(({"hals"}),
    "Muss man Dir alles erklaeren?");
  AddDetail(({"ding"}),
    "Welches Ding meinst Du denn?");
}

void entferne(object ob)
{
  if (living(ob)) return; //npc verschonen
  ob->remove(1);
}

void init()
{
  ::init();
  jemand_kam=1;
}

void reset()
{
  ::reset(); //ggf objekte die hierher gehoeren, wieder clonen
  if (present("Spieler")) 
    return;
  if (jemand_kam)
    jemand_kam=0;
  else
  {
    map_array(all_inventory(ME),"entferne");
    set_next_reset(MASTERDELAY);
  }
}
