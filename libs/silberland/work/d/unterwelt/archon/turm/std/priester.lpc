#include "../def.h"
inherit STD "my_good_npc";
inherit "/std/npc/spells";

#define MINHP 150
#define MINSP 10

void create();
void Attack(object enemy);
void init();
void InformDefend(object enemy);

void create() 
{
  if (!is_clone(ME)) return;
  ::create();

  create_default_npc(20);

  SetProp(P_NAME, "Priester");   
  SetProp(P_GENDER, MALE);   
  AddId(({"priester","monster"}));

  SetProp(P_HANDS, ({" mit goettlicher Unterstuetzung", 350, ({DT_HOLY, DT_BLUDGEON}) }));
  SetProp(P_ALIGN, 900);
  SetProp(P_RACE, "Mensch");
  SetProp(P_TURMDEFENDER,1);

  seteuid(getuid(ME));

  AddDefaultSpell(5,1,DS_CURSE_WEAPON,
    "Der Priester murmelt ein Gebet und die Goetter verfluchen Deine Waffe!\n",
    "Der Priester murmelt ein Gebet und die Goetter verfluchen @WESSEN Waffe!\n" );

  clone_object(ARMOUR "priesterrobe")->move(ME,M_NOCHECK);
  command_me("ziehe alles an");
  
  AddInfo(DEFAULT_INFO,"ist in ein Gebet vertieft und ignoriert Dich.");
}

void Attack(object enemy)
{
  if (QueryProp(P_HP)<MINHP && QueryProp(P_SP)>MINSP && !random(3))
  {
    tell_room(environment(ME),break_string("  Der Priester spricht einen Gebet und sieht ploetzlich "
                              "wieder besser aus."));
    AddHp(30);
    AddSp(-MINSP);
    return;
  }
  return ::Attack(enemy);
}
