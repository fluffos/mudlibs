// alle Npc melden sich beim Master an
// dadurcht kann das Ende der Quest gesteuert werden!
// 07.05.2003 Archon: - erstellt 
/*
 Rev 1.0 22.01.2003 Archon: erste version
*/

#include "../def.h"
inherit "std/mnpc";

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  P_ARCHON_NPCMASTER->add_npc(ME,1); //guter npc
//nur als infostuetze, das dieses prop verwendet wird
  SetProp(P_ARCHON_ENDFIGHT,0); 
  AddId(({"TURMDEFENDER"}));
}

void init()
{
  ::init();
  if (!PL) return;
  if (!PL->QueryProp(P_NPC)) return;
  if (PL->QueryProp(P_TURMDEFENDER))
  {
    PL->AddDefender(ME);
    AddDefender(PL);
  }
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

int goto_endfight(int wie)
{
  mixed enemy;
  int i;

  SetProp(P_MNPC_FLAGS,0); //kein wegrennen mehr
//  SetProp(P_INFOS,0); //wir reden auch nicht mehr
  SetProp(P_ARCHON_ENDFIGHT,1); //damit wir wissen, wir sind im endkampf
  SetProp(P_NOATTACK,0); //sichergehen bei magier/priesterin
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_ACHATS,0); //da ist schon soviel los ...
  SetProp(P_ACHAT_CHANCE,0); //da ist schon soviel los ...
  enemy=QueryEnemies()[0]; //nicht mehr weiter kaempfen
  if (pointerp(enemy))
  {
    for (i=sizeof(enemy);i--;)
    {
      if (objectp(enemy[i]))
      {
        enemy[i]->StopHuntFor(ME,1);
        ME->StopHuntFor(enemy[i],1);
      }
    }
  }
  if (wie==1)
  { //guter endkampf
   if (environment(ME))
    tell_room(environment(ME),break_string(
      "Ploetzlich kommt "+name(WEN,1)+" zu Bewusstsein, dass der Turm "
      "angegriffen wird. "+capitalize(QueryPronoun(WER))+" rennt sofort "
      "los, um diesen zu verteidigen."));
   SetProp(P_HP,QueryProp(P_MAX_HP));
   SetProp(P_SP,QueryProp(P_MAX_SP));
  }
  else
  {
   if (environment(ME))
    tell_room(environment(ME),break_string(
      "Ploetzlich wird "+name(WEN,1)+" von fremdartiger Magie angegriffen "
      "und schreit vor Schmerz auf. Anscheint wird der Turm attaktiert "
      "und die Angreifer versuchen die Verteidiger zu vernichten. "
      "Kaum laesst der Angriff nach, rennt "+name(WER,1)+" auch schon "
      "los, um dem Angriff entgegen zu treten."));
   SetProp(P_HP,QueryProp(P_MAX_HP)/15);
   SetProp(P_SP,QueryProp(P_MAX_SP)/15);
  }
  move(ROOM "vorturm",M_GO);
  enemy=present("DUNKELELFNPC",environment(ME));
  if (objectp(enemy)) ME->Kill(enemy);
  return 1;
}

void finish_endfight()
{
  move(ROOM "destruct_room",M_GO,"","geht nach Hause","erscheint");
  remove(1);
}

void remove_item(object was)
{
  if (was) was->remove(1);
}

varargs void die(int p)
{
  if (QueryProp(P_ARCHON_ENDFIGHT))
  {
    map_array(all_inventory(ME),"remove_item");
  }
  ::die(p);
}
