#include "../def.h"
inherit STD "my_good_npc";

string attackspell();

void create()
{
  if (!is_clone(ME)) return;
  ::create();    

  create_default_npc(35);

  SetProp(P_RACE,"Mensch");
  SetProp(P_GUILD,"paladine");
  AddClass(CL_HUMAN);
  SetProp(P_ALIGN,900);
  SetProp(P_TURMDEFENDER,1);
  SetProp(P_GUILD,"paladine");
  SetProp(P_GUILD_LEVEL, 15);

  SetProp(P_MSGIN,"schreitet stolz herein");
  SetProp(P_MSGOUT,"schreitet stolz weiter");
  SetProp(P_MMSGIN,QueryProp(P_MSGIN));
  SetProp(P_MMSGOUT,QueryProp(P_MSGOUT));

  SetProp(P_MNPC_AREA, 0);
  SetProp(P_MNPC_WAIT, ({ 1, 20, 30 }));  
  SetProp(P_MNPC_DEFAULTROOM, ENV(TO));
  SetProp(P_MNPC_FLAGS, 0);

  call_other("/gilden/paladine","learn_paladin_skills", 10000);

  ModifySkill("behandle",      10000);
  ModifySkill("behandle",      ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0]) ]) );
  ModifySkill("waffensegen",   10000);
  ModifySkill("waffensegen",   ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("zielattacke",   10000);
  ModifySkill("zielattacke",   ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("behandle",      10000);
  ModifySkill("behandle",      ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("heiligengebet", 10000);
  ModifySkill("heiligengebet", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("spiegelschild", 10000);
  ModifySkill("spiegelschild", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  ModifySkill("goetterschutz", 10000);
  ModifySkill("goetterschutz", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0]) ]) );
  ModifySkill("schildparade",  10000);
  ModifySkill("schildparade",  ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0]) ]) );

  SetAttackChats(50, ({ "@@attackspell@@", }) );

  AddInfo(DEFAULT_INFO,"bereitet sich mental auf einen Kampf mit den "
                       "Dunkelelfen vor und will nicht gestoert werden.");
  AddInfo(({"gilde","paladingilde"}),
    "Ich bin Mitglied der Paladingilde",
    "sagt stolz: ");
  AddInfo(({"dusty","gebet","ayla"}),
    "spricht ein Gebet zu Dusty.");

  seteuid(getuid(ME));

  clone_object(P_DIR_ARMOUR "helm/kettenhaube")->move(ME,M_NOCHECK);
  clone_object(P_DIR_ARMOUR "gloves/lederhandschuhe")->move(ME,M_NOCHECK);
  clone_object(P_DIR_ARMOUR "trousers/hose")->move(ME,M_NOCHECK);
  clone_object(P_DIR_ARMOUR "boots/lederstiefel")->move(ME,M_NOCHECK);
  clone_object(P_DIR_ARMOUR "shield/eisenschild")->move(ME,M_NOCHECK);
  clone_object(P_DIR_ARMOUR "armour/eisenpanzer")->move(ME,M_NOCHECK);
  clone_object(P_DIR_GILDE "wappenrock")->move(ME,M_NOCHECK);
  clone_object(P_DIR_WEAPON "sword/langschwert")->move(ME,M_NOCHECK);

  AddId(({"monster","paladin","Schwertmeister"})); 

  command_me("ziehe alles an");
  command_me("zuecke schwert");    
}

// SPELLS
string attackspell() 
{
  object en;
  if(!QueryProp(P_TMP_DEFEND_HOOK)) 
  {
    if(!random(2))
      command_me("schildparade");
    else 
      command_me("goetterschutz");
    return "";
  }
  if(en=QueryEnemy()) 
  {
    if(!random(2))
      command_me("zielattacke");
    else 
      command_me("heiligengebet");
  }
  return "";
}

//kaempfen und nix machen
int PlayerTousles(object pl) { return -1; }
int PlayerTickles(object pl) { return -1; }
int PlayerShakes(object pl) { return -1; }
