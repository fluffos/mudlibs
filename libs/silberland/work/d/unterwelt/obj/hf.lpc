#include "/d/unterwelt/obj/light.h"

inherit "/d/unterwelt/obj/lightsource";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT,"Eine Hoellenfackel");
  SetProp(P_LONG,
    "Diese Fackel scheint direkt aus der tiefsten Hoelle zu kommen, "
    "denn sie verbreitet kein Licht, sondern pechschwarze "
    "Dunkelheit."
  );

  SetProp(P_NAME,"Hoellenfackel");
  AddId(({"feuer","hoellenfeuer","fackel","hoellenfackel"}));

  SetProp(P_VALUE,50);
  SetProp(P_WEIGHT,500);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:50,MAT_MAGIC:25,MAT_MISC_UNHOLY:25]));
  SetProp(P_ARTICLE,1);

  SetProp(P_LIGHT_INFO,
    ([
      L_FUEL:1000+random(500),
      L_DESC:({"glimmend","flackernd","leicht flackernd","brennend",
           "dunkel lodernd","frisch entflammt"}),
      L_OFFSET:-1]));
}
