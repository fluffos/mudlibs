#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if(!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Chitinhose");
  SetProp(P_LONG,
    "Diese robuste Hose aus Chitin wurde wohl aus sehr sehr vielen "
    "Spinnenkoerpern hergestellt. Viele kleine Platten sind zu einer "
    "grossen Hose zusammengesetzt worden. Sie bietet sicher einen guten "
    "Schutz, leider nur fuer sehr grosse Rassen. Die Hose ist allerdings "
    "stark abgenutzt, so dass ihr Schutz etwas eingeschraenkt ist. "
  );

  SetProp(P_NAME, "Chitinhose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"chitinhose", "hose"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, MAT_CHITIN );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 500+random(20));
  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Dunkelelf"})]));
}
