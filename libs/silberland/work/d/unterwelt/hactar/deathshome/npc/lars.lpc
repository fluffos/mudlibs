#include "../def.h"
#define CONVERTFILE "/d/unterwelt/hactar/deathshome/convert"
#define DATAFOLDER "/d/unterwelt/hactar/deathshome/data/"
#define NPCDATAFOLDER "/d/unterwelt/hactar/deathshome/npcdata/"

inherit "std/npc";
int busy;

inherit "/gilden/bardengilde/obj/quest/bard_small_combatspell_teacher";
#include "/gilden/bardengilde/barden_extern.h"

string hilfeclosure (string str)
{
	if (query_wiz_level(TP) >= INACTIVEWIZ_LVL)
	{
		call_out("magierhint",1,TP);
	}
	
    return "Ich bin Lars, der Praktikant vom Tod. Ich fuehre fuer ihn die Todeslisten. "
		"Der Tod fuehrt ein genaues Protokoll ueber jeden verstorbenen. Falls Du eine dieser Listen "
		"sehen willst frag mich doch nach Todeslisten. Achja, Toplisten fuehre ich auch...";
}

