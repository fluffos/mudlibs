  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"lars", "praktikant", "NOWIMPY"}));
  //AddClass( ({ }) );
  SetProp(P_ARTICLE, 0);

  set_living_name("lars");

//--Eigenschaften----------------------------------------------------------

