	"reibungslos ins naechste Leben uebergeht. Er ist leicht an seiner schwarzen Kutte "
	"und Sense zu erkennen. Die meisten schaffen es aber ihn bewusst nicht zu sehen.","sagt: ");
  AddInfo(({"tot","zyklus","leben"}), "Alle Wesen muessen sterben. Es ist Teil des Zyklus des Lebens.","sagt: ");
  AddInfo(({"mort","pratchett"}), "Falsche Welt...","sagt: ");
  AddInfo(({"sense","kutte"}), "Die hat der Tod.","sagt: ");
  AddInfo("kia", "Die suesseste Fee, aber wieso fragst Du? :)","sagt: ");
  AddInfo("lars", "Das bin ich...","sagt: ");
  AddInfo(({"toplisten","topliste"}), "Weiss auch nicht wo ich die hingetan habe, aber sie sind hier irgendwo... Ich bin mir sicher du findest sie hier wenn du danach suchst...","sagt: ");
  AddInfo(({"kuerzel","abkuerzungen"}), "Der Tod verwendet manchmal Abkuerzungen in seinen Notizen. Manchmal bessere ich sie aus, manchmal nicht.","sagt: ");
  AddInfo("lim", "Den sehen wir viel zu oft hier ;)","sagt: ");
  AddInfo(({"brille","augen"}), "Die Buchfuehrung strengt die Augen an. Ich wuenschte es waeren welche mit schwarzen eckigen Rahmen...","sagt: ");
  AddInfo(({"rahmen","mudder"}), "Die traegt so ein Mudder...","sagt: ");
  
  AddInfo("phi", "Phi, auch der Goldene Schnitt (lat. sectio aurea) genannt ist ein bestimmtes Verhaeltnis zweier "
   "Zahlen, meist Laengen von Strecken, das in der Kunst und Architektur oft als ideale Proportion "
    "und als Inbegriff von Aesthetik und Harmonie angesehen wird. Darueber hinaus tritt es auch in "
	 "der Natur in Erscheinung und zeichnet sich durch eine Reihe interessanter mathematischer "
	  "Eigenschaften aus. ","sagt: ");
AddInfo("wham", "Wake me up, before you gogo ;)","sagt: ");
  AddInfo( ({"",""}),
    ".",
    "sagt: ");
  AddInfo( ({"christmas"}),
    "Das ist Englisch und heisst Weihnachten.",
    "sagt: ");
  AddInfo( ({"weihnachten"}),
    "Das ist Deutsch und heisst Weihnachten.",
    "sagt: ");
  AddInfo( ({"buecher","buch","schriftrollen","zettel","papier"}),
    "Damit fuehr ich Buch.",
    "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE,0);


//--Chats------------------------------------------------------------------

  SetChats(1,
  ({Name(WER, 1)+" seufzt.\n"
   ,Name(WER, 1)+" schreibt etwas in ein Buch.\n"
,Name(WER, 1)+" macht zwei Striche an die Tuer.\n"
   ,Name(WER, 1)+" summt etwas das wie Last Christmas klingt.\n"
   ,Name(WER, 1)+" sortiert ein paar Schriftrollen.\n"
   ,"Du hast das komische Gefuehl die Zeit verlaeuft im Sand.\n"
   ,"Tick, tick, tick, tick...\n"
   ,Name(WER, 1)+" gaehnt.\n"
   ,Name(WER, 1)+" ueberlegt.\n"
   })
  );

  SetAttackChats(10,
  ({Name(WER, 1)+" sagt: Gleich hau ich Dich!\n"
   ,Name(WER, 1)+" sagt: Das hat gar nicht weh getan.\n"
   })
  );

//--Ausruestung------------------------------------------------------------

  SUID;
  busy = 0;
  AddCmd( ({"beantrag","beantrage"}), "showlist" );
  AddCmd( ({"npcbeantrag","npcbeantrage"}), "npcshowlist" );
  AddCmd( ({"eintragen"}), "insertconvert" );

  initialize_bard_spell_teacher(BARD_GROUP_KORRIAX);
}

void magierhint(object magier)
{
	tell_object(magier,break_string("Als Magier kannst Du auch Worte eintragen "
		"die in den Listen durch andere ersetzt werden sollen. Frag mich nach eintragen"
		" um mehr zu erfahren.\n",78,"Lars fluestert Dir zu: "));
	tell_room(ENV(TO),BS("Lars fluestert " + TP->Name() + " etwas zu.\n"),({magier}));
}

int insertconvert(string str)
{
	string *tempstr;
	str = TP->_unparsed_args();
	if (query_wiz_level(TP) < INACTIVEWIZ_LVL)
	{
		tell_room(ENV(TO),BS("Lars sagt: Nix da " + TP->Name() + ", das duerfen nur Magier.\n"));
		return 1;
	}
	tempstr = explode(str,",");
	if ((strlen(str) < 3) || (strstr(str,",",0) == -1) || (sizeof(tempstr) > 2))
	{
		tell_object(TP,BS("Lars fluestert Dir zu: Was? Ich hab nicht verstanden wen Du meinst...\n"));
		tell_object(TP,BS("Lars fluestert Dir zu: Syntax: <eintragen listenname,echtername>\n"));
		tell_object(TP,BS("Lars fluestert Dir zu: zB: 'eintragen zo2,Zombie'\n"));
		tell_room(ENV(TO),BS("Lars fluestert " + TP->Name() + " etwas zu.\n"),({TP}));
		return 1;
	}
	str = regreplace(str,"  "," ",1);
	str = regreplace(str," ,",",",1);
	str = regreplace(str,", ",",",1);
	write_file(CONVERTFILE,str + "," + TP->Name() +  "," + ctime() + "\n");
	tell_object(TP,BS("Lars nickt Dir zu und notiert etwas.\n"));
	tell_room(ENV(TO),BS("Lars nickt " + TP->Name() + " zu und notiert etwas.\n"),({TP}));
	return 1;
}
int npcshowlist( string str )
{
	if (busy == 1)
	{
		tell_room(ENV(TO),BS("Lars sagt: Moment, Moment, einer nach dem anderen...\n"));
		return 1;
	}
	if (strlen(str) < 1)
	{
		tell_room(ENV(TO),BS("Lars sagt: Was? Ich hab nicht verstanden wen Du meinst...\n"));
		return 1;
	}
	busy = 1;
	log_file("loginfo/hactar/lars",ctime() + " " + TP->Name() + " npc beantragt " + str + "\n");
	tell_room(ENV(TO),BS(TP->Name() + " beantragt etwas.\n"),({TP}));
	tell_room(ENV(TO),BS("Lars sagt: " + capitalize(str) + "? " + capitalize(str) + "... Ich schau mal nach.\n"));
	call_out("seq1",2,capitalize(str),1);
	
	return 1;
}

int showlist( string str )
{
	if (busy == 1)
	{
		tell_room(ENV(TO),BS("Lars sagt: Moment, Moment, einer nach dem anderen...\n"));
		return 1;
	}
	if (strlen(str) < 1)
	{
		tell_room(ENV(TO),BS("Lars sagt: Was? Ich hab nicht verstanden wen Du meinst...\n"));
		return 1;
	}
	busy = 1;
	log_file("loginfo/hactar/lars",ctime() + " " + TP->Name() + " beantragt " + str + "\n");
	tell_room(ENV(TO),BS(TP->Name() + " beantragt etwas.\n"),({TP}));
	tell_room(ENV(TO),BS("Lars sagt: " + capitalize(str) + "? " + capitalize(str) + "... Ich schau mal nach.\n"));
	call_out("seq1",2,capitalize(str),0);
	
	return 1;
}

void seq1(string str,int mode)
{
	tell_room(ENV(TO),BS("Lars geht zu einem riesigen Buecherregal und faengt an zu suchen.\n"));
	call_out("seq2",5,str,mode);
}

void seq2(string str, int mode)
{
	string mysize;
	string myfolder;
	if (mode)
	{
		myfolder = NPCDATAFOLDER;
	} else
	{
		myfolder = DATAFOLDER;
	}
	switch (file_size(myfolder+ str[0..0] + "/" + str + ".txt"))
	{
		case -2 .. 0:
			mysize = "gar nichts";
		break;
		case 1 .. 168:
			mysize = "einem kleinen Zettel";
		break;
		case 169 .. 2200:
			mysize = "einer Schriftrolle";
		break;
		case 2201 .. 7000:
			mysize = "mehreren Schriftrollen";
		break;
		case 7001 .. 20000:
			mysize = "einem Buch";
		break;
		case 20001 .. 30000:
			mysize = "mehreren Buechern";
		break;
		default:
			mysize = "einer Scheibtruhe voller Buecher";
		break;
		
	}
	if (mysize == "gar nichts")
	{
		tell_room(ENV(TO),BS("Lars kommt mit gar nichts an "
			"und setzt sich.\n"));
		tell_room(ENV(TO),BS("Lars sagt: Tut mir leid, konnte nichts ueber " + str + " finden."
			"\n"));		
		busy = 0;
	}
	else
	{
		tell_object(TP,BS("Lars kommt mit " + mysize + " an, setzt sich "
			"und zeigt Dir die Liste. "
			"\n"));
		tell_room(ENV(TO),BS("Lars kommt mit " + mysize + " an, setzt sich "
			"und zeigt " + TP->Name(WEM) + " die Liste. "
			"\n"),({TP}));
		call_out("seq3",2,str, mode);
	}
}

void seq3(string str, int mode)
{
	string thefile;
	string myfolder;
	if (mode)
	{
		myfolder = NPCDATAFOLDER;
	} else
	{
		myfolder = DATAFOLDER;
	}
	thefile = read_file( myfolder + str[0..0] +"/" + str +".txt");
	if (thefile != 0)
	{
		TP->More(thefile+"\n");
		//call_out("seq4",1,str);
	}
	busy = 0;
}

void seq4(string str)
{
	tell_room(ENV(TO),BS("Kaum hast Du die Liste gesehen loest sie sich in Luft auf. Auch Deine Geldboerse ist leichter "
		"geworden.\n"));	
	tell_room(ENV(TO),BS("Lars denkt . o O ( Trinkgeld ;) )\n"));
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "blickt sich erschreckt um, beruhigt sich aber wieder.\n",
        "blickt sich erschreckt um, beruhigt sich aber wieder.\n");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "reagiert nicht.\n",
        "reagiert nicht.\n");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "kichert.\n",
        "kichert.\n");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "blickt durch Dich hindurch.\n",
        "blickt durch " + TP->Name(WEN) + " hindurch.\n");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "grinst.\n",
        "grinst.\n");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "lacht.\n",
        "lacht.\n");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "blickt Dich entsetzt an.\n",
        "blickt " + TP->Name(WEN) + " entsetzt an.\n");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "grinst.\n",
        "grinst.\n");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "zuckt mit den Schultern.\n",
        "zuckt mit den Schultern.\n");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "seufzt.\n",
        "seufzt.\n");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
