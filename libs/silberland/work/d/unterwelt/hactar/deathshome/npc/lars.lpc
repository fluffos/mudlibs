//SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

//--Tod--------------------------------------------------------------------
SetProp(P_NOATTACK, "arbeitet fuer den Tod, toeten waer da wohl sinnlos.");
  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich bin doch unsterblich...");
  SetProp(P_KILL_NAME, "Lars");
  SetProp(P_KILL_MSG, "Eigentlich will ich ja niemanden toeten.");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "sagt: Benoetigst Du Hilfe?\n");
  AddInfo("hactar", "Hactar hat mich in dieser Form erschaffen.","sagt: ");
  AddInfo(({"todeslisten","todesliste"}), "Ich fuehre fuer den Tod die Listen wann wer wo woran gestorben ist. "
   "Falls Du eine Todesliste sehen willst kannst Du sie bei mir beantragen. "
   "Uebrigens verwendet der Tod manchmal Kuerzel in den Notizen die Du unter Umstaenden nicht "
   "verstehen wirst. Die Syntax um eine Liste zu beantragen ist: beantrage <spielername> bzw npcbeantrage <npcname> (Bei Letzerem siehst Du wen npcname schon getoetet hat).","sagt: ");
  AddInfo("hilfe", #'hilfeclosure ,"sagt: ");
  AddInfo("eintragen", "Du kannst das Todeslistensystem verbessern in dem Du Worte eintraegst die "
  "beim naechsten Durchlauf durch andere ersetzt werden. ZB wird derzeit zo2 und zo3 durch "
