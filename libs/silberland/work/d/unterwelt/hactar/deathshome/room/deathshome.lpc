#include "../def.h"
#define TOPLISTFOLDER "/d/unterwelt/hactar/deathshome/toplist/"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Das Buero vom Tod");
  SetProp(P_INT_LONG,
