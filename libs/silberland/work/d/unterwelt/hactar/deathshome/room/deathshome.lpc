	"dem Holzboden liegt ein schoener Perserteppich mit vielen Verzierungen. "
	"Vor Dir steht ein grosser Holzschreibtisch wo sich die Papiere und Buecher nur so stapeln. "
	"Etwas verloren zwischen den Papierbergen sitzt Lars."
  );

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 19, ENV_TERRAIN: TT_HOUSE]) );

