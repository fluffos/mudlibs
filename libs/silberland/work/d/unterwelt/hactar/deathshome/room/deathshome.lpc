//--Funktionen fuer Details------------------------------------------------

int check_if_erzseher(object myplayer)
{
	//object esm;
    //esm = find_object("/obj/erzsehermaster");
	//if ((esm->check("Erzseher", myplayer, query_verb(),"")) && (query_wiz_level(myplayer) < INACTIVEWIZ_LVL))
	//	return 1;
	return 1;
}
string heldfun(string str)
{
  string s;
  object *erzseher;
  string *sprueche;
  mixed *theenemies;
  mixed *theother;
  int i;
  s = "";
  sprueche = ({" kaempft wagemutig gegen ",
	" schlaegt sich tapfer gegen ",
	" metzelt "
	});
  erzseher = filter_array(users(), "check_if_erzseher");
  for (i = 0; i < sizeof(erzseher); i++)
  {
  	theenemies = erzseher[i]->QueryEnemies();
	if (sizeof(theenemies) > 0)
	{
		theother = (mixed *) theenemies[0];
  		if (sizeof(theother) > 0)
  			s = s + erzseher[i]->Name() + sprueche[random(sizeof(sprueche))] + theother[0]->name(WEN) + ". ";
  	}
  }
  if (strlen(s) == 0)
  	return BS("Hmm, keine heldenhaften Taten im Gange, vielleicht gleich?");
  return BS("Die Helden sind schwer beschaeftigt: " + s);
}

int topkiller()
{
	string thefile;
	log_file("loginfo/hactar/lars",ctime() + " " + TP->Name() + " betrachtet die Topmoerder.\n");
	thefile = read_file(TOPLISTFOLDER + "topkiller.txt");
	if (thefile != 0)
	{
		TP->More(thefile);
	}
	return 1;
}

int topsterber()
{
	string thefile;
	log_file("loginfo/hactar/lars",ctime() + " " + TP->Name() + " betrachtet die Topsterber.\n");
	thefile = read_file(TOPLISTFOLDER + "topdeath.txt");
	if (thefile != 0)
	{
		TP->More(thefile);
	}
	return 1;
}
