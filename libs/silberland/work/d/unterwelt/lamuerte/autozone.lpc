inherit "/std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

string DESCPATH="/d/unterwelt/lamuerte/";
string ROOMPATH="/d/unterwelt/lamuerte/gracklstug/rooms/";

void create()
{
  ::create();
   SetProp(P_INT_SHORT, "Der Autozonengenerator" );
   SetProp(P_INT_LONG, "Nicht viel hier.");

   AddCmd( "zmake","do_read_map" );
}


int do_read_map(string path) {
  string err;
  string result;
  string *lines;
  string outp;
  int x,y;
  x=0;y=0;
  outp="";
  

  err = catch(result = read_file(path));
  if (err) {
    write(path + ": " + err + ".\n");
    return -1;
  }

    lines=explode(result,"\n");

  for (x=0;x<sizeof(lines);x++) {
      for (y=0;y<=strlen(lines[x]);y++) {
            outp="";
            outp+="/* MP-HEADER - DO NOT MODIFY ANYTHING BEFORE THE #include STATEMENTS!!\n";
            outp+="** "+(x/2)+"x"+(y/2)+"y.lpc";
            outp+="  [created using autozne map converter 0.1 (c) Lamuerte\n";
            outp+="** compatible to mpen v0.93 (16 Feb 97)]\n";
            outp+=read_file(DESCPATH+"room.desc");
          if((lines[x][y..y])=="#") {
            if(x>1)if(lines[x-1][y..y]=="|")
              outp+="AddExit(\"norden\",\"./"+((x-2)/2)+"x"+(y/2)+"y\");\n";
            if(x<(strlen(lines[x])-1))if(lines[x+1][y..y]=="|")
              outp+="AddExit(\"sueden\",\"./"+((x+2)/2)+"x"+(y/2)+"y\");\n";
            if(y>1)if(lines[x][y-1..y-1]=="-")
              outp+="AddExit(\"westen\",\"./"+(x/2)+"x"+((y-2)/2)+"y\");\n";
            if(y<(sizeof(lines)-1))if(lines[x][y+1..y+1]=="-")
              outp+="AddExit(\"osten\",\"./"+(x/2)+"x"+((y+2)/2)+"y\");\n";
            outp += "  // EXITS END\n\n";
            outp += "  // ITEMS START\n";
            outp += "  // ITEMS END\n\n";
            outp += "}\n";
            write_file(ROOMPATH+(x/2)+"x"+(y/2)+"y.lpc", outp);
            //write(outp+"\n");
          }
      }
  }
  return 1;
}
