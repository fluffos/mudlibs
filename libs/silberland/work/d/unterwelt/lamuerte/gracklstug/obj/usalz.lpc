inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Etwas Unkrautsalz ");
  SetProp(P_LONG, 
   "Eitwas Unkrautsalz aus Gracklstug.");

  SetProp(P_NODROP,1);
  SetProp(P_VALUE,1500);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Unkrautsalz");
  
  AddId( ({"\nUNKRAUTSALZ","salz","unkrautsalz"}));
 
  seteuid(getuid());
  

}


