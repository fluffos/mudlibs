inherit "std/weapon";

#include <properties.h>     
#include <combat.h>     
#include <language.h> 

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"zange", "beisszange", "\nBEISSZANGE"}));
  SetProp (P_SHORT, "Eine Beisszange.");
  SetProp (P_LONG, "Eine kleine Beisszange, so eine wolltest Du schon immer "+
                   "haben. Sie ist etwas rostig und sieht nicht recht "+
                   "wertvoll aus, aber hauptsache Du hast sie.");
  SetProp (P_NAME, "Beisszange");
  SetProp (P_GENDER, FEMALE);

  SetProp (P_VALUE, 200);
  SetProp (P_WEIGHT, 500);
  SetProp (P_WEAPON_TYPE, WT_KNIFE);
  SetProp (P_DAM_TYPE, DT_SQUEEZE);
  SetProp (P_WC, 20);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_MATERIAL, MAT_IRON);
}
