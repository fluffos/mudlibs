inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein grauer Schluessel");
  SetProp(P_LONG, 
   "Ein kleiner grauer Schluessel aus Kyranda.");

  SetProp(P_NOGET,0);
  SetProp(P_NODROP,1);
  SetProp(P_VALUE,500);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Schluessel");
  
  AddId( ({"seppo","schluessel","grauer"}));
 
  seteuid(getuid());
  

}


