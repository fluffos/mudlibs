inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Etwas Staubzucker");
  SetProp(P_LONG, 
   "Etwas verdreckter Staubzucker aus Gracklstug.");

  SetProp(P_NODROP,1);
  SetProp(P_VALUE,50);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Staubzucker");
  
  AddId( ({"\nSTAUBZUCKER","zucker","staubzucker"}));
 
  seteuid(getuid());
  

}


