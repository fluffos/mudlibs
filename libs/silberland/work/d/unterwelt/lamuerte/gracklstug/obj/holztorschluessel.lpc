inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <combat.h>

void create()
{
  if(!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Ein kleiner Schluessel");
  SetProp(P_LONG,
    "Das ist ein kleiner Holzorschluessel. Er sperrt die Tuer der Alchemisten "
    "in Gracklstug. Um genau zu sein sperrt er die Holztuer. Er sieht ganz "
    "normal aus."
  );

  SetProp(P_NAME, "Holztorschluessel");
  SetProp(P_GENDER, MALE);
  AddId( ({ "\n_holztorschluessel","holztorschluessel","torschluessel","schluessel" }) );

  SetProp(P_NAME_ADJ, "klein");
  AddAdjective( ({"kleinen","kleiner","kleinem","kleines","kleine"}) );

  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_MAGIC, 1);
}

string QueryDoorKey()
{
  return "/d/unterwelt/lamuerte/gracklstug/rooms/6x2y:/d/unterwelt/lamuerte/gracklstug/rooms/6x3y";
}

reset(){
  ::reset();
  write("Der Holztorschluessel verpufft.\n");
  this_object()->remove( 1 );
}
