inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Zuendfaden");
  SetProp(P_LONG, 
   "Ein Zendfaden aus Gracklstug.");

  SetProp(P_NODROP,1);
  SetProp(P_VALUE,300);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Zuendfaden");
  
  AddId( ({"\nZUENDFADEN","faden","zuendfaden"}));
 
  seteuid(getuid());
  

}


