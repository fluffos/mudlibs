#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/lamuerte/gracklstug/rooms/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Im Hoehlensystem von Gracklstug");
  SetProp (P_INT_LONG,
    "Du befindest Dich im Hoehlensystem von Gracklstug. Alles rund um "+
    "Dich ist aus hartem Stein geschaffen, welcher mit einem glitschigen "+
    "Film aus Wasser und Schmutz ueberzogen ist. Im Sueden liegt das "+
    "Eingangstor durch welches Du gekommen bist, im Norden geht es tiefer "+
    "nach Gracklstug rein.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"boden"}),
    "Der Boden besteht aus Stein.");
  AddDetail ( ({"gracklstug"}),
    "Du befindest Dich mitten drin.");
  AddDetail ( ({"hoehlensystem", "system"}),
    "Das Hoehlensystem fuehrt von hier aus richtung Norden tiefer nach "+
    "Gracklstug. In suedliche Richtung fuehrt es aus Gracklstug hinaus.");
  AddDetail ( ({"gestein", "stein", "steine"}),
    "Die Steine sind kalt und feucht.");
  AddDetail ( ({"film"}),
    "Fuehlt sich irgendwie glitschig an.");
  AddDetail ( ({"wasser"}),
    "Durch das Gemisch aus Wasser und Schmutz fuehlt es sich irgendiwe "+
    "glitschig an.");
  AddDetail ( ({"gemisch"}),
    "Das Gemisch besteht aus Wasser und Schmutz.");
  AddDetail ( ({"schmutz"}),
    "Der Schmutz ist dreckig.");
  AddDetail ( ({"eingangstor", "tor"}),
    "Im Sueden liegt das Tor duch welches Du hier hergekommen bist. Du "+
    "kannst auch wieder durch selbiges Gracklstug verlassen.");
  AddDetail ( ({"decke"}),
    "Die Decke befindet sich ueber Dir und besteht aus Stein welcher mit "+
    "einem glitschigen Film aus Schmutz und Wasser ueberzogen ist.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende sind kalt und feucht. Sie bestehen aus Stein.");
  // DETAILS END

  // EXITS START
AddExit("norden","./6x4y");
 NewDoor( "sueden","./8x4y","tor",
      ({ D_FLAGS, DOOR_CLOSED,
         D_NAME,"Tor",
         D_OPENTESTFUNC, "close_call_other",
         D_GENDER, NEUTER,
         D_SHORT,"Im Sueden siehst Du ein %ses Tor. ",
         D_LONG, "Das Tor wird bewacht.\n",
       }) );
  // EXITS END

  // ITEMS START
  // ITEMS END

}

close_call_other(){
  "/d/unterwelt/lamuerte/gracklstug/rooms/8x4y"->close_call();
  return 0;
}
