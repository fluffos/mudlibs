#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/lamuerte/gracklstug/rooms/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Im Hoehlensystem von Gracklstug");
  SetProp (P_INT_LONG,
    "Du findest Dich im Ausbildungslager der Alchemisten wieder. Hier "+
    "werden die jungen Alchemisten von Gracklstug auf das echte Leben "+
    "vorbereitet. Eine lange Werkbank mit vielen Utensilien fuehrt "+
    "durch das ganze Lager, sie fuehrt von hier aus in den Sueden und "+
    "den Osten weiter.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"ausbildungslager", "lager"}),
    "Du stehst im Ausbildungslager der Alchemisten.");
  AddDetail ( ({"alchemisten"}),
    "Die Alchemisten von Gracklstug sind dafuer bekannt das sie nicht ganz "+
    "echt im Kopf sind. So manche sind schon bei der mischung neuer Rezepte "+
    "explodiert oder mit einem ihrer Fluggeraete abgestuertzt.");
  AddDetail ( ({"gracklstug"}),
    "Das ist die Stadt der Duergar, die Dunkelzwerge des Silberlandes.");
  AddDetail ( ({"dunkelzwerge"}),
    "Die wohnen hier.");
  AddDetail ( ({"duergar"}),
    "Das sind die Dunkelzwerge. Eigentlich muessten einege hier zu sehen "+
    "sein.");
  AddDetail ( ({"stadt"}),
    "Diese Stadt hier heisst Gracklstug, und sie wurde von den Duergar "+
    "erbaut.");
  AddDetail ( ({"silberland", "silberlands"}),
    "Das ist unsere Welt.");
  AddDetail ( ({"welt"}),
    "Unsere heisst Silberland.");
  AddDetail ( ({"fluggeraet", "fluggeraete"}),
    "Hier sind keine zu sehen, aber angeblich baun die Duergar Alchemisten "+
    "ziemlich irre Fluggeraete.");
  AddDetail ( ({"kopf"}),
    "Du klopfst Dir auf den Kopf. Nix drin.");
  AddDetail ( ({"rezept", "rezepte"}),
    "Die Alchemisten versuchen immer neue Rezepte herauszufinden. Doch "+
    "manchmel geht das auch schief.");
  AddDetail ( ({"boden"}),
    "Der Boden ist total versaut, nicht nur Staub sondern auch diverse "+
    "Chemikalien liegen am Boden herum.");
  AddDetail ( ({"staub"}),
    "Du malst ein Herz in den Staub.");
  AddDetail ( ({"herz"}),
    "Das Herz sieht suess aus.");
  AddDetail ( ({"chemikalien"}),
    "Du greifst sie besser erst gar nicht an bevor Du Dich vergiftest.");
  AddDetail ( ({"decke"}),
    "An der Decke sind Spuren von den letzten Explosionen zu sehen.");
  AddDetail ( ({"spuren"}),
    "Sie sind schwarz. An einer Spur erkennst Du etwas.");
  AddDetail ( ({"explosion", "explosionen"}),
    "Naja, die auszubildenden Alchemisten werden wohl wieder Unsinn "+
    "gemacht haebn und dabei ist was explodiert.");
  AddDetail ( ({"unsinn"}),
    "Wahrscheinlich haben sie wieder Unkrautsalz mit Staubzucker "+
    "vermischt.");
  AddDetail ( ({"salz", "unkrautsalz"}),
    "Man nimmt es um Unkraut zu bekaempfen oder in verbindung mit "+
    "Staubzucker Explosionen zu erzeugen.");
  AddDetail ( ({"staubzucker", "zucker"}),
    "Staubzucker wirkt bombastisch in Verbindung mit Unkrautsalz.");
  AddDetail ( ({"verbindung"}),
    "Staubzucker und Unkrautsalz ist zusammen sehr explosiv.");
  AddDetail ( ({"unkraut"}),
    "Unkraut gibts hier keines.");
  AddDetail ( ({"leben"}),
    "Das Leben eines Alchemisten besteht zu einhundert Prozent aus "+
    "forschen.");
  AddDetail ( ({"prozent"}),
    "Ja, wirklich.");
  AddDetail ( ({"werkbank"}),
    "Die Werkbank erstreckt sich rund um das ganze Lager. Viele Utensilien "+
    "sind auf ihr zu sehen.");
  AddDetail ( ({"waende", "wand"}),
    "Die waende sind schwarz vor Schmutz und Staub.");
  AddDetail ( ({"schmutz"}),
    "Wirklich ekelhaft dieser Dreck.");
  AddDetail ( ({"dreck"}),
    "Ganz schoen schmutzig dieser Dreck.");
  AddDetail ( ({"utensilien"}),
    "Bei den Utensilien handelt es sich um verschiedenste Sachen.");
  AddDetail ( ({"sachen"}),
    "In diesem Abschnitt der Werkbank siehst Du eigentlich nur Ampullen "+
    "und Werkzeuge.");
  AddDetail ( ({"abschnitt"}),
    "Der Abschnitt hier ist nur ein Teil der komlpetten Werkbank.");
  AddDetail ( ({"teil"}),
    "Die Werkbank erstreckt sich ueber sechs Teile.");
  AddDetail ( ({"teile"}),
    "Ja, es gibt mehrere.");
  AddDetail ( ({"ampulle", "ampullen"}),
    "Viele Ampullen, grosse, kleine, mittlere, gruene, blaue, rote, beinahe "+
    "unueberschaubar viele. Du laesst sie lieber dort wo sie sind, die sehen "+
    "einfach zu gefaehrlich aus.");
  AddDetail ( ({"werkzeug", "werkzeuge"}),
    "Halterungen, Stichel, Zangen und so weiter.");
  AddDetail ( ({"halterungen"}),
    "Die sehen nicht aufregend aus.");
  AddDetail ( ({"stichel"}),
    "Sie sind spitz, aber eigentlich sehen sie recht primitiv aus.");
  AddDetail ( ({"zangen"}),
    "Einige verschiedene Zangen liegen herum, aber keine wirkt intressant "+
    "auf Dich.");
  AddDetail ( ({"eck", "ecke"}),
    "In einem Eck liegt etwas Zuendpulver.");
  AddDetail ( ({"zuendpulver"}),
    "Es sieht intressant aus.");
  AddDetail ( ({"spur"}),
    "An dieser einen Spur haengt noch ein alter Zuendfaden von der Decke.");
  AddDetail ( ({"faden", "zuendfaden"}),
    "Der Zeundfaden sieht vergammelt aus, aber er koennte noch "+
    "funktionieren. Nimm ihn doch einfach mit.");
  // DETAILS END

  // EXITS START
  AddExit("sueden","./6x0y");
  AddExit("osten","./5x1y");
  // EXITS END


  // ITEMS START
  AddItem("/d/unterwelt/lamuerte/gracklstug/npc/alchemist_lehrer.lpc",REFRESH_DESTRUCT);
  // ITEMS END

  AddCmd("nimm","do_get");
}

do_get(string str){
  if(!str) return 0;

  if (str!="faden" && str !="zuendfaden") return 0;
   
  if(!deep_present("\nZUENDFADEN",this_player())){
    write("Du nimmst ein Stueck von dem Zuenfaden von der Decke.\n");
    say(this_player()->QueryProp(P_NAME)+" nimmt sich etwas von der Decke.\n");
    clone_object("/d/unterwelt/lamuerte/gracklstug/obj/zfaden.lpc")->move(this_player(),M_NOCHECK);
    return 1;
  } 
  else{
    write("Du hast doch schon einen Zuendfaden.\n"); 
    return 1;
  }

  return 0;
}
  
    
    
