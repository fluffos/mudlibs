#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/lamuerte/gracklstug/rooms/"+x)
#endif


inherit "std/room";

int moos=3;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Im Hoehlensystem von Gracklstug");
  SetProp (P_INT_LONG,
    "Du befindest Dich an einer Kreuzung im Hoehlensystem von Gracklstug. "+
    "Alles rund um Dich ist aus hartem Granit geschaffen, welcher mit "+
    "einem glitschigen Film aus Wasser und Schmutz ueberzogen ist. Ein "+
    "Schild erweckt deine Aufmerksamkeit.\n");
 
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"hoehlensystem", "system"}),
    "Das Hoehlensystem fuehrt von hier aus in drei Richtungen weiter.");
  AddDetail ( ({"richtung", "richtungen"}),
    "Von hier haus gehts nach Osten, Westen und Sueden.");
  AddDetail ( ({"granit"}),
    "Du dachtest es handelt sich um Granit doch es ist nur der mit Schmutz "+
    "und Wasser ueberzogene Stein der auch sonst ueberall hier unten zu "+
    "finden ist.");
  AddDetail ( ({"gestein", "steine"}),
    "Das Gestein ist mit Wasser und Schmutz ueberzogen.");
  AddDetail ( ({"wasser"}),
    "Das Wasser ist verdreckt mit Schmutz.");
  AddDetail ( ({"schmutz"}),
    "Der Schmutz schwimmt in dem Film aus Wasser an den Waenden.");
  AddDetail ( ({"kreuzung"}),
    "Die Kreuzung fuehrt von hier aus in drei Richtungen weiter.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende bestehen aus Stein und sind feucht.");
  AddDetail ( ({"decke"}),
    "An der Decke siehst Du ein Loch.");
  AddDetail ( ({"loch"}),
    "Das Loch ist nicht besonders gross doch man sieht ein gruenes Objekt "+
    "herausstehen.");
  AddDetail ( ({"objekt"}),
    "Es handelt sich dabei anscheinend um Moos.");
  AddDetail ( ({"moos"}),
    "Ja, bei naeherem hinsehen stellst Du fest das es wirklich Moos ist. "+
    "Eventuell kann man es von der Decke kratzen?");
  AddDetail ( ({"stein"}),
    "Vieles besteht hir aus Stein, beinahe alles.");
  AddDetail ( ({"film"}),
    "Der Film besteht aus Wasser und Schmutz.");
  AddDetail ( ({"gracklstug"}),
    "So heisst dieser Ort an dem Du Dich hier befindest.");
  AddDetail ( ({"ort"}),
    "Der Ort hier heisst Gracklstug.");
  AddDetail ( ({"boden"}),
    "Der Boden ist hier sauber, anscheinend hat ihn hier wer wirklich "+
    "gruendlich geputzt und nicht so schlampig wie Du.");
  AddDetail ( ({"aufmerksamkeit"}),
    "Du denkst . o 0 ( Hmmmmmmm... Warum fasziniert mich dieses Schild nur "+
    "so. ) 0 o .");
  AddDetail ( ({"schild"}),
    "Das Schild besteht aus Holz. Es ist auf einem kurzen Pflock in den "+
    "steinigen Boden gerammt worden. Auf dem Schild selbst befinden sich "+
    "Schriftzeichen die man wohl lesen kann.");
  AddDetail ( ({"hold"}),
    "Es handelt sich um Buchenholz.");
  AddDetail ( ({"holz"}),
    "Es handelt sich um Buchenholz.");
  AddDetail ( ({"buchenholz"}),
    "Das Buchenholz sieht relativ neu aus.");
  AddDetail ( ({"pflock"}),
    "Der Pflock besteht aus Buchenholz und ist im Boden verankert.");
  AddDetail ( ({"schriftzeichen"}),
    "Man kann sie lesen.");
  AddReadDetail ( ({"schild", "schriftzeichen"}),
    "----------------------------\n"+
    "-                          -\n"+
    "-                          -\n"+
    "-Amruhcaaks<----->Rechtiug -\n"+
    "-             |            -\n"+
    "-         Aufmugods        -\n"+
    "-                          -\n"+
    "----------------------------\n" 
    );
  AddDetail ( ({"hmmmmmmm"}),
    "Du hmmmmst.");
  // DETAILS END

  // EXITS START
AddExit("sueden","./7x4y");
AddExit("westen","./6x3y");
AddExit("osten","./6x5y");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd(({"kratz","kratze"}),"do_kratz");
}

int do_kratz(string str) {
  string was,wo;
  notify_fail("Was willst du kratzen?\n");
  if(!str) return 0;
  if(sscanf(str,"%s von %s", was, wo)!=2) {
    return 0;
  }
  else if(wo!="decke" && wo!="loch") {
    write("Du kratzt in der Gegend herum.\n");
    return 1;
  }
  else if(was!="moos") {
    write("Du kratzt an der Decke herum.\n");
    return 1;
  }
  else {
    if(moos<1){
    write("Du erwischst das Moos nicht, es ist zu klein.\n");
    return 1;
    }
    moos--;
    write("Du kratzt etwas Moos von der Decke.\n");
    say(this_player()->QueryProp(P_NAME)+" kratzt Moos von der Decke.\n");
    clone_object("/d/unterwelt/lamuerte/gracklstug/obj/moos.lpc")->move(this_player(),M_NOCHECK); 
    return 1;
  }
}


reset() {
  ::reset();
  moos=random(4)+1;
  if(moos<3)
  tell_room(this_object(),"Etwas Moos waechst aus einem Loch an der Decke.\n");  
}
    
