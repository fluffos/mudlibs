#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/lamuerte/gracklstug/rooms/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Im Hoehlensystem von Gracklstug");
  SetProp (P_INT_LONG,
    "Du befindest Dich im Hoehlensystem von Gracklstug. Alles rund um "+
    "Dich ist aus hartem Granit geschaffen, welcher mit einem glitschigen "+
    "Film aus Wasser und Schweiss ueberzogen ist.");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
AddExit("sueden","./6x5y");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
