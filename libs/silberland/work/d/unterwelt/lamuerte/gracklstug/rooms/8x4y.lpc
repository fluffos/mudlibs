#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/lamuerte/gracklstug/rooms/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Im Hoehlensystem von Gracklstug");
  SetProp (P_INT_LONG,
    "Du findest Dich in einer in den Stein gehauenen niedrigen Halle wieder. "+
    "Das sich in noerdliche Richtung ausdehnende Hoehlensystem wird hier "+
    "durch massive, angespitzte Holzpfaehle, welche einen Schutzwall bilden, "+
    "abgetrennt. In der mitte des Holzwalls befindet sich ein gut bewachtes "+
    "Eingangstor, ueber welchem ein geschmiedetes Wappen thront.");
  // ROOM DESCRIPTION END
  
  // DETAILS START
  AddDetail ( ({"gestein", "stein", "steine"}),
    "Das Gestein ist sehr hart und seine Oberflaeche ist leicht feucht. Es "+
    "muessen unglaubliche Kraefte aufgewendet worden sein um es abzutragen "+
    "damit diese Halle entstehen konnte.");
  AddDetail ( ({"flaeche", "oberflaeche"}),
    "Die Oberflaeche ist feucht. Sie greift sich glitschig, ja eigentlich "+
    "sogar ekelhaft an.");
  AddDetail ( ({"halle"}),
    "Diese Halle wurde in mit viel Aufwand in den Stein gehauen, durch "+
    "diesen Wall aus Holzpfloecken stellt sie wohl eine art Abgrenzung in "+
    "das tiefere Hoehlensystem welches im Norden weitergeht dar.");
  AddDetail ( ({"aufwand"}),
    "Ja, bei nochmaligem hinsehen stellst du west das es wirklich sehr "+
    "sehr viel Aufwand gewesen sein muss diese Halle aus dem Stein zu "+
    "graben.");
  AddDetail ( ({"wall","holzwall","schutzwall"}),
    "Der Wall besteht aus zugespitzten Holzpfloecken, welche die Halle zu "+
    "einer art Grenze machen.");
  AddDetail ( ({"grenze"}),
    "Die Grenze wird durch den Wall gebildet.");
  AddDetail ( ({"abgrenzung"}),
    "Eine Abgrenzung von hier aus tiefer in das Hoehlensystem stellt der "+
    "Wall dar.");
  AddDetail ( ({"holzpfloecke", "holzpfloecken", "pfloecke", "pfaehle", "holzpfaehle"}),
    "Die Holzpfloecke sind in den Steinboden gerammt worden. Am oberen "+
    "Ende sind die Pfloecke zugespitzt worden um zu verhindern das wer "+
    "ueber sie klettern kann. Blutspuren an manchen der Pfloecke deuten auf "+
    "misslungene Versuche hin.");
  AddDetail ( ({"ende"}),
    "Das Ende der Holzpfloecke ist zugespitzt.");
  AddDetail ( ({"versuche"}),
    "Alle sind gescheitert, probier es erst gar nicht.");
  AddDetail ( ({"boden", "steinboden"}),
    "Der Boden besteht, wie auch alles andere, aus Stein und er ist etwas "+
    "schmutzig. Es weurde nicht schaden ihn wiedermal zu putzen.");
  AddDetail ( ({"decke"}),
    "Die decke der Halle besteht aus Stein und ist etwas feucht.");
  AddDetail ( ({"eingangstor", "tor"}),
    "Das Eingangstor befindet sich in der Mitte von deisem massiven "+
    "Holzwall und fuehrt Dich in Richtung Norden weiter.");
  AddDetail ( ({"mitte"}),
    "Die Mitte liegt ziemlich mittig. Unglaublich.");
  AddDetail ( ({"waende", "wand"}),
    "Auch die Waende bestehen aus Stein. Sie befinden sich rund um Dich "+
    "und bilden diese niedrige Halle.");
  AddDetail ( ({"hoehlensystem", "system"}),
    "Das Hoehlensystem kommt vom Sueden und fuehrt hinter dem Holzwall in "+
    "den Norden weiter.");
  AddDetail ( ({"wappen"}),
    "Das Wappen zeigt einen Zwerg welcher kreidebleich im Gesicht ist und "+
    "eine maechtige Axt in den haenden haelt. Unter dem Wappen ist ein "+
    "Schriftzug zu erkennen.");
  AddDetail( ({"schriftzug"}),
     "Probiers mal mit lesen.");
  AddReadDetail( ({"schriftzug"}),
     "Gracklstug - Statt der Duerger - Alle Macht den Dunkelwzergen");
  AddDetail ( ({"zwerg"}),
    "Der Zwerg auf dem Wappen sieht kraeftig aus. Ja sogar kraeftiegr als "+
    "alle Zwerge die du bisher im Silberland gesehen hast. Bloss sein "+
    "bleiches Gesicht aehnelt keinem Zwerg den Du bisher gesehen hast.");
  AddDetail ( ({"gesicht"}),
    "Das Gesicht von dem Zwerg auf dem Wappen sieht bleich aus.");
  AddDetail ( ({"axt"}),
    "Die Axte auf dem Wappen sieht etwas unfoermig aus.");
  AddDetail ( ({"silberland"}),
    "Du befindest Dich mitten drin. (Nicht nur dabei!)");
  // DETAILS END

  // EXITS START
//  AddExit("norden",
//      ([ EX_DEST: "./7x4y",
//         EX_FUNC: "do_attack",
//         EXG_PLMSG: "Eine Torwache haelt Dich zurueck",
//         EXG_RMMSG: "Eine Torwache haelt @wen@ zurueck.\n" ]) );
  NewDoor( "norden","./7x4y",({"tor"}),
      ({ D_FLAGS, DOOR_CLOSED,
         D_NAME,"Tor",
         D_GENDER, NEUTER,
         D_SHORT,"Im Norden siehst Du ein %ses Tor. ",
         D_LONG, "Das Tor wird bewacht.\n",
         D_OPENTESTFUNC, "do_anger",
         D_TESTFUNC, "do_attack",
         D_OPENMSG,({"Mit einem Quietschen oeffnest Du das Tor.",
                    "Mit einem Quietschen oeffnet %s das Tor.",
                    " wird mit einem Quietschen von der anderen Seite geoffnet."})

         }) );



  
  AddExit("sueden","/d/unterwelt/basics/central/room/00+11+12");
  // EXITS END

  // ITEMS START
  AddItem ( "/d/unterwelt/lamuerte/gracklstug/npc/dorwek", REFRESH_DESTRUCT);
  AddItem ( "/d/unterwelt/lamuerte/gracklstug/npc/darwik", REFRESH_DESTRUCT);
  // ITEMS END

  AddCmd(({"putz","putze"}),"do_wischmop");
  call_out("close_tor",4);
}

void close_tor() {
  object ob;
  if (ob=present("torwache")){
    if("/obj/doormaster"->QueryDoorStatus("/d/unterwelt/lamuerte/gracklstug/rooms/7x4y","/d/unterwelt/lamuerte/gracklstug/rooms/8x4y")==1){
    ob->command_me("sag Das Tor ist offen! Ich mach es besser zu! ");
      tell_room(this_object(),ob->QueryProp(P_NAME)+" macht das Tor zu.\n");
      "/obj/doormaster"->SetDoorStatus("/d/unterwelt/lamuerte/gracklstug/rooms/7x4y", D_STATUS_CLOSED, "/d/unterwelt/lamuerte/gracklstug/rooms/8x4y");
      call_other("/d/unterwelt/lamuerte/gracklstug/rooms/7x4y", "???", 0);
      tell_room(find_object("/d/unterwelt/lamuerte/gracklstug/rooms/7x4y"),
         ob->QueryProp(P_NAME)+" hat das Tor gerade von aussen geschlossen.\n");
      return ;
    }
  }
  return;
}

close_call() {
  call_out("close_tor",4);
  return 0;
}

do_anger()
{
  object ob;
    if (ob=present("torwache")){
        if(this_player()->QueryProp(P_RACE)!="Duergar" &&
           this_player()->QueryProp(P_RACE)!="Dunkelelf"){
        ob->command_me("sag Stop, was machst Du elender "+
          this_player()->QueryProp(P_RACE)+" da?? Lass das Tor zu!");
          call_out("close_tor",8);
          return 0;          
        }
        else
        {
          call_out("close_tor",4);
          return 0;
        }
    }
      return 0;
}

do_attack()
{
  object ob;
  if (ob=present("torwache")){
      if(this_player()->QueryProp(P_RACE)!="Duergar" &&
         this_player()->QueryProp(P_RACE)!="Dunkelelf"){
      ob->command_me("sag Stop, hier kommt kein "+
          this_player()->QueryProp(P_RACE)+" herein.");
      say(ob->QueryProp(P_NAME)+" hindert "+
          this_player()->QueryProp(P_NAME)+
          " daran das Eingangstor zu benutzen.\n");
        return 1;
    } else {
               
      ob->command_me("sag Willkommen "+
          this_player()->QueryProp(P_RACE)+
          "! Habt eine gute Zeit in Gracklstug.");
      write(ob->QueryProp(P_NAME)+" geleitet Dich duch das Eingangstor.\n");
      say(ob->QueryProp(P_NAME)+" geleitet "+
          this_player()->QueryProp(P_NAME)+
          " durch das Eingangstor.\n");
      return 0;
    }
   }
      return 0;
}

  int do_wischmop(string str) {
    string was,womit;
    notify_fail("Was willst du putzen?\n");
    if(!str) return 0;
    if(sscanf(str,"%s mit %s", was, womit)!=2) { 
      write("Putze wen mit was?\n");
      return 0;
    }
    else if(womit!="besen") {
      write("Mit sowas Putzen? Scherzkeks.\n");
      return 1;
    }
    else if(womit=="besen") {
      if(!present("besen",this_player())) {
        write("Du hast keinen Besen bei dir.\n");
        return 1;
      }
    else if(was!="boden") {
      write("Du putzt wie ein Wilder. Doch sauber wird nichts.\n");
      return 1;
    }
    else {
      write("Du putzt den Boden mit deinem Besen. Ob das einen FP wert war?\n");
      say(this_player()->QueryProp(P_NAME)+" putzt den Boden.\n");
      return 1;
    }
  }
     
  }
