#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/lamuerte/gracklstug/rooms/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Im Hoehlensystem von Gracklstug");
  SetProp (P_INT_LONG,
    "Du stehst im Wohnbereich der Alchemisten von Gracklstug. Hier ist "+
    "die Elite der Alchemisten zu Hause. Dieses Gewoelbe ist aus Stein "+
    "gemauert worden, und bietet alles was man so zum Wohnen braucht. "+
    "Das Gewoelbe ist ausserdem weitlaeufig und fuehrt von hier aus "+
    "in mehrere Richtungen weiter.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"bereich", "wohnbereich"}),
    "Der Wohnbereich ist aus Stein gemauert worden und dient als "+
    "Unterkunft fuer die Alchemisten von Gracklstug.");
  AddDetail ( ({"unterkunft"}),
    "Eigentlich sieht alles sehr kahl und kalt aus, aber das moegen die "+
    "Duergar wohl.");
  AddDetail ( ({"duergar"}),
    "Duergar heissen die Bewohner von Gracklstug.");
  AddDetail ( ({"bewohner"}),
    "Hier wohnen Dunkelzwerge.");
  AddDetail ( ({"dunkelzwerge"}),
    "Sie werden auch Duergar genannt.");
  AddDetail ( ({"wohnen"}),
    "Betten, Tische, Kuechenteile, Arbeitsbereiche, Ruheraum - alles ist "+
    "hier in diesem Gewoelbe zusammengefasst.");
  AddDetail ( ({"betten"}),
    "Betten stehen hier ueberall herum, fuer die Duergar welche sich "+
    "ausruhen wollen.");
  AddDetail ( ({"tische"}),
    "Auch einige Tische stehen in diesem Gewoelbe.");
  AddDetail ( ({"ruheraum"}),
    "In den Ruhebereichen ist es noch dunkler als dunkel und es stehen "+
    "einige Betten vermehrt in diesen Bereichen.");
  AddDetail ( ({"ruhebereichen"}),
    "Dort ist es ruhig.");
  AddDetail ( ({"arbeitsbereich", "arbeitsbereiche"}),
    "Die Arbeitsbereiche dienen zur weiterentwicklung der Duergar.");
  AddDetail ( ({"kuechenteile"}),
    "In den Kuechenteilen des Gewoelbes wird wohl Nahrung zubereitet.");
  AddDetail ( ({"nahrung"}),
    "Am liebsten essen sie Zwergenfleisch.");
  AddDetail ( ({"zwergenfleisch"}),
    "Hm, naja, wers mag.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende sind gemauert.");
  AddDetail ( ({"stein"}),
    "Der Stein ist kalt.");
  AddDetail ( ({"gewoelbe"}),
    "Das Gewoelbe setzt sich von hier aus weiter fort.");
  AddDetail ( ({"gracklstug"}),
    "Du bist mitten drin.");
  AddDetail ( ({"elite"}),
    "Die Alchemisten geniessen ein hohes Ansehen in Gracklstug.");
  AddDetail ( ({"ansehen"}),
    "Sieh Dich bloss an, wie siehst Du aus!");
  AddDetail ( ({"alchemisten"}),
    "Die wohnen hier.");
  AddDetail ( ({"boden"}),
    "Der Boden besteht aus Stein.");
  AddDetail ( ({"decke"}),
    "Die Decke besteht aus Stein.");
  // DETAILS END

  // EXITS START
  AddExit("norden","./4x4y");
  AddExit("westen","./5x3y");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
