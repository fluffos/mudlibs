#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/lamuerte/gracklstug/rooms/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Im Hoehlensystem von Gracklstug");
  SetProp (P_INT_LONG,
    "Du befindest Dich an der Quatrigakreuzung im Hoehlensystem von Gracklstug. "+
    "Alles rund um Dich ist aus hartem Stein geschaffen. Von hier aus geht es "+
    "in vier Richtungen weiter. Im Sueden erkennst Du einen Eingang zu einer "+
    "art Halle, im Norden befindet sich ein Tor durch welches man in ein "+
    "duesteres Gewoelbe kommt, im Westen erkennst du eine art Lager in "+
    "welchem es noch dunkler aussieht als im Rest von Gracklstug und im Osten "+
    "erkennst du eine Kreuzung die anscheinend weiter in das Hoehlensystem "+
    "fuehrt.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"kreuzung", "quatrigakreuzung"}),
    "Diese Kreuzung fuehrt dich in vier Richtungen weiter.");
  AddDetail ( ({"richtung", "richtungen"}),
    "Es geht in vier verschiedene Richtungen weiter.");
  AddDetail ( ({"hoehle", "hoehlensystem", "system"}),
    "Das Hoehle der Duergar sieht ganz schoen gross aus, auch wenn Du hier "+
    "erst ziemlich am Anfang stehst.");
  AddDetail ( ({"anfang"}),
    "Ja, es ist wirklich der Anfang.");
  AddDetail ( ({"gracklstug"}),
    "Das ist die Stadt der Duergar, du stehst in ihr.");
  AddDetail ( ({"stadt"}),
    "Diese hier heisst Gracklstug.");
  AddDetail ( ({"boden"}),
    "Der Boden besteht aus Stein.");
  AddDetail ( ({"stein"}),
    "Der Stein ist feucht.");
  AddDetail ( ({"decke"}),
    "Die Decke besteht aus Stein und weist hier keine Besonderheiten auf.");
  AddDetail ( ({"besonderheiten"}),
    "Gibt es hier keine.");
  AddDetail ( ({"waende", "wand"}),
    "Die Waende bestehen aus feuchtem Stein. Hier fuehren verschiedene "+
    "Auslaesse weiter in vier verschiedene Richtungen.");
  AddDetail ( ({"auslaesse"}),
    "Naja, zum Beispiel das Tor im Norden.");
  AddDetail ( ({"beispiel"}),
    "Das Tor im Norden ist ein Beispiel fuer die Auslaesse in den Waenden "+
    "in diesem Raum.");
  AddDetail ( ({"raum"}),
    "Du stehst in ihm.");
  AddDetail ( ({"duergar"}),
    "Duergar heissen die Dunkelzwerge.");
  AddDetail ( ({"dunkelzwerge"}),
    "Dunkelzwerge werden auch Duergar genannt. Sie wohnen hier.");
  AddDetail ( ({"rest"}),
    "Jaja, der Rest von Gracklstug ist auch noch da zum Erkunden.");
  AddDetail ( ({"erkunden"}),
    "Laufen, ansehen, forschen... erkunden halt.");
  AddDetail ( ({"eingang"}),
    "Der Eingang liegt weiter im Sueden, genaueres kann man wohl erst "+
    "sehen wenn man sich dort hin bewegt.");
  AddDetail ( ({"halle"}),
    "Die Halle ist nur in umrissen von hier aus zu sehen, Du musst schon "+
    "naeher hin gehen um genaueres zu sehen.");
  AddDetail ( ({"schild"}),
    "Man kann es lesen.");
  AddDetail ( ({"gewoelbe"}),
    "Das Gewoelbe liegt im Norden, durch das Tor kann man es betreten.");
  AddReadDetail ( ({"schild"}),
    "[ALCHEMISTEN VON GRACKLSTUG] \n[                          ] \n[* "+
    "Explosionsgefahr        ] \n[* Vergiftungsgefahr       ] \n[* "+
    "Veraetzungsgefahr       ] \n[                          ] \n[Betreten auf "+
    "eigene Gefahr] \n[                          ] \n[             Bomdrok      "+
    "]");
  AddDetail ( ({"lager"}),
    "Eine Hulzruer Bildet den Eingeng zum Lager und befinded sich im Westen. Ueber ihm haengt eine "+
    "Tafel.");
  AddDetail ( ({"tafel"}),
    "Man kann sie lesen.");
  AddReadDetail ( ({"tafel"}),
    ".------------------------.\n"
    ".Ausbilckrkl da Alchemist.\n"
    ".                        .\n"
    ".                        .\n"
    ".                Krdak   .\n"
    ".------------------------.\n");
  // DETAILS END

  // EXITS START
//AddExit("norden","./5x3y");
AddExit("sueden","./7x3y");
//AddExit("westen","./6x2y");
AddExit("osten","./6x4y");
 
 NewDoor( "norden","./5x3y",({"tor"}),
      ({ D_FLAGS, (DOOR_CLOSED|DOOR_RESET_CL),
         D_NAME,"Tor",
         D_GENDER, MALE,
         D_SHORT,"Im Norden siehst Du ein %ses Tor.",
         D_LONG, "Das Tor ist mit Stein gemauert worden. Es fuehrt "+
                 "in richtung Norden in ein duesteres Gewoelbe. Ein "+
                 "hoelzernes Schild welches man lesen kann haengt "+
                 "neben dem Tor.",
         D_OPENMSG,({"Mit einem Knarren oeffnest Du das Tor.",
                    "Mit einem Knarren oeffnet %s das Tor.",
                    " wird mit einem Knarren von der anderen Seite geoffnet."})
       })
  );

 NewDoor( "westen","./6x2y",({"holztuer"}),
      ({ D_FLAGS, (DOOR_OPEN|DOOR_NEEDKEY|DOOR_RESET_OP),
         D_NAME,"Holztuer",
         D_GENDER, FEMALE,
         D_SHORT,"Im Westen siehst Du eine %se Holztuer.",
         D_LONG, "Die Holztuer sieht stabil aus.\n",
         D_OPENMSG,({"Mit einem Quietschen oeffnest Du die Tuer.",
                    "Mit einem Quietschen oeffnet %s die Tuer.",
                    " wird mit einem Krachen von der anderen Seite geoffnet."})
       })
  );
  // EXITS END

  // ITEMS START
  // ITEMS END

}
