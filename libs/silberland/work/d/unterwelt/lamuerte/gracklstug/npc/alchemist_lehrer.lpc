inherit "std/mnpc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>


void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 


  SetProp(P_SHORT, "Krdak der Alchemistenlehrer");
  SetProp(P_LONG, 
    "Vor Dir steht ein dicker Duergar, welcher einen sehr gebildeten Eindruck "
    "auf Dich macht. Er ist in eine rote Robe gehuellt und traegt einen langen "
    "Bart. Er scheint der Ausbildner der Alchemisten in Gracklstug zu sein.");
  SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_AREA, ({"/d/unterwelt/lamuerte/gracklstug/rooms/6x2y",
                          "/d/unterwelt/lamuerte/gracklstug/rooms/6x1y",
                          "/d/unterwelt/lamuerte/gracklstug/rooms/6x0y",
                          "/d/unterwelt/lamuerte/gracklstug/rooms/5x2y",
                          "/d/unterwelt/lamuerte/gracklstug/rooms/5x1y",
                          "/d/unterwelt/lamuerte/gracklstug/rooms/5x0y"}));
  SetProp (P_MNPC_WAIT, ({20, 20, 20}));
  SetProp (P_MNPC_DEFAULTROOM,
                    file_name(interactive(previous_object()) ? environment(previous_object()) : previous_object() ));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_BACKWARDS  + MOV_MOVES  + MOV_MAYLOAD);

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Krdak");
  SetProp(P_RACE, "Duergar");
  SetProp(P_SIZE, 80);
  SetProp(P_GENDER, MALE);
  AddId(({"\ngracklnpc","lehrer", "duergar", "dunkelzweg", "alchemist",
          "alchemistenlehrer","krdak"}));
  create_default_npc(29);
  SetProp(P_XP, QueryProp(P_XP)*3/2);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit flammenden Haenden",220,DT_FIRE})); 
  SetProp(P_SPELLRATE, 50);
  SetProp(P_HEAL, 4 );
  SetProp(P_HP_DELAY, 3 );
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:30]) );

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :-0.1,    DT_WHIP        :-0.1,    DT_RIP        :-0.1,
    DT_FIRE       :0.2,     DT_COLD        :-0.2,    DT_WATER      :-1,    
    DT_AIR        :-0.2,    DT_LIGHTNING   :-0.2,    DT_EXPLOSION  :0,
    DT_SOUND      :-0.3,    DT_LIGHT       :0,       DT_ELECTRIC   :-0.2,    
    DT_ACID       :-0.3,    DT_POISON      :-0.2,    DT_TERROR     :-0.3,     
    DT_HOLY       :-0.2,    DT_UNHOLY      :-0.2,    DT_MAGIC      :0]) );
 
  SetProp(P_NOMAGIC,35);

  SetProp(P_MSGIN, "geht herein");
  SetProp(P_MSGOUT, "geht");

  SetProp(P_DIE_MSG, " hat ausgelebt.\n");
  SetProp(P_NOCORPSE, 0 );
  //SetProp(P_KILL_MSG, "");

  SetProp( P_REJECT, REJECT_KEEP);

  enable_commands();
 
  clone_object("/d/unterwelt/lamuerte/gracklstug/obj/holztorschluessel.lpc")->move(this_object(),M_NOCHECK);
  
  AddInfo( DEFAULT_INFO,"sagt: Ich hab keine Zeit, geh weg.");
  SetChats(4, ({
    "Krdak sagt: Faule Alchemistenlehrlinge, lernt was!\n",
    "Krdak setzt einen strengen Blick auf.\n",
    "Krdak macht die Werkbank sauber.\n",
    "Krdak mischt einige Chemikalien zusammen.\n",
    "Krdak sagt: So ein faules Pack!\n"}));

  
  AddSpell(5,320,
      "Krdak zuendet eine Rakete die Dich voll erwischt.\n",
      "Krdak zuendet eine Rakete und erwischt @WEN.\n",
      DT_FIRE, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(1, 300, DS_MASS_DAMAGE,
      "Krdak zuendet eine Splitterbombe.\n",
      "Krdak zuendet eine Splitterombe.\n",
      DT_FIRE, ([SP_SHOW_DAMAGE:1]) );
//  AddDefaultSpell(1, 300, DS_ANTIMAGIC,
//      ".\n",
//      ".\n",
//      3);

}

void init()
{
  ::init();
  if( this_player() && this_player()->id("duergar"))
    AddDefender(this_player());
  if( this_player() && present("\nalchemistenkiller", this_player())){
    if("/obj/doormaster"->QueryDoorStatus("/d/unterwelt/lamuerte/gracklstug/rooms/6x2y","/d/unterwelt/lamuerte/gracklstug/rooms/6x3y")==1)
    {
    tell_room(environment(this_player()),"Krdak kreischt: "+this_player()->QueryProp(P_NAME)+ " Du Alchemistenmoerder!\nKrdak kreischt: Jetzt sperr ich Dich ein!\nKrdak zuendet eine Teleportationsbombe.\n");
    this_object()->move("/d/unterwelt/lamuerte/gracklstug/rooms/6x2y",M_TPORT);
    "/obj/doormaster"->SetDoorStatus("/d/unterwelt/lamuerte/gracklstug/rooms/6x2y", D_STATUS_CLOSED, "/d/unterwelt/lamuerte/gracklstug/rooms/6x3y");
    }
    else
    {
    tell_room(environment(this_player()),"Krdak kreischt: "+this_player()->QueryProp(P_NAME)+ " Du Alchemistenmoerder!\nKrdak kreischt: Alle auf ihn!\n");
    Kill(this_player());
    }
  }
}

void InformDefend(object enemy) 
{
  Kill(enemy);
}

