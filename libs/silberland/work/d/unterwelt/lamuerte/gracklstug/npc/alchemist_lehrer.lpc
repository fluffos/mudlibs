varargs void die( int poisondeath )
{
  if(!present("\nalchemistenkiller", this_player()))
    clone_object("/d/unterwelt/lamuerte/gracklstug/obj/alchemistenkiller")->move(this_player(),M_NOCHECK);
  ::die(poisondeath);
}

