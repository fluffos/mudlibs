inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <moredef.h>
#include <defines.h>


create()
{
  object ob;

  if (!is_clone(this_object())) return;  
  ::create();
  AddId (({"wache", "torwache", "darwik", "zwerg", "dunkelzwerg", "duergar"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_NAME, "Darwik");
  SetProp (P_SHORT, "Darwik, Obertorwache der Dunkelzwerge");
  SetProp (P_LONG, "Das ist Darwik, einer der der Torwachen der Dunkelwzerge. "+
	"Darwik ist ca. 120cm gross und traegt einen weissen Oberlippenbart. "+
	"Seine Bleiche Hautfarbe, und die dunkelblau hervorschimmernden Adern "+
	"unter seiner Haut deuten darauf hin das er ein Duergar ist.");
  
  SetProp (P_ALIGN, -600);
  create_default_npc(35);
  SUID;
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit seinen Haenden", 200, DT_BLUDGEON}) );
  SetProp (P_SIZE, 120);
  SetProp (P_RACE, "Zwerg");
  SetProp (P_ARTICLE, 0);
  SetProp(P_RESISTANCE_STRENGTHS, ([
    DT_SLASH      :0,       DT_BLUDGEON    :0,       DT_PIERCE     :0,
    DT_SQUEEZE    :0,       DT_WHIP        :-0.1,    DT_RIP        :0,
    DT_FIRE       :-0.3,    DT_COLD        :-0.3,    DT_WATER      :0.3,
    DT_AIR        :-0.3,    DT_LIGHTNING   :0,       DT_EXPLOSION  :0,
    DT_SOUND      :0,       DT_LIGHT       :0,       DT_ELECTRIC   :0,
    DT_ACID       :0,       DT_POISON      :0,       DT_TERROR     :0,
    DT_HOLY       :0,       DT_UNHOLY      :0,       DT_MAGIC      :0]) );


  
  CLONEME ("/p/weapon/axe/streitaxt.lpc");
  command ("zuecke axt");
  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, random(400)+200);
  ob->move(ME);
  CLONEME ("/p/armour/trousers/kettenhose.lpc");
  CLONEME ("/p/armour/bracers/kettenzeug");
  switch(random(4))
  {
    case 1: CLONEME( "/p/armour/armour/kettenhemd"); break;
    case 2: CLONEME( "/p/armour/belt/guertel"); break;
    case 3: CLONEME( "/p/armour/gloves/kettenhandschuhe.lpc"); break;
    case 4: CLONEME ("/p/armour/bracers/kettenzeug"); break;
  }
  command ("ziehe alles an");
  SetProp(P_SPELLRATE,25);

  AddSpell(1,600, 
    "Darwik landet einen kritischen Treffer.\n",
    "Darwik trifft @WEN mit einem kritischen Treffer.\n",
   DT_SLASH, ([SP_SHOW_DAMAGE:1]));
   
  SetAttackChats(4, ({
    "Du stirbst gleich!\n",
    "Elender, fahr zur Hoelle!\n",
    "Ich werde dich toeten!\n"}));

  SetProp (P_DIE_MSG, " faellt um und ist tod.\n");
  SetProp (P_DEFAULT_INFO, "sagt: Lenk mich nicht ab, ich muss dieses "+
	 "Tor bewachen!\n");
  AddInfo (({"tor"}), "sagt: Na das Eingangstor von Gracklstug.\n");
  AddInfo (({"gracklstug"}), "sagt: Geh weg, das ist meine Stadt.\n");

  AddInfo(({"stadt"}), "bruellt: 'Hoch hoch hoch lebe Gracklstug! "+
	"Stadt der Duergar! Ja wir sind die Dunkelzwerge! Wir werden keine "+
	"Guten dulden!'\n");

  AddInfo(({"dunkelzwerg", "duergar", "dunkelzwerg"}), "nickt: 'Wir sind die Duergar, dir Dunkelzwerge!'\n");

  AddInfo("dorwek", "grinst: Dorwek ist mein Untergebener!\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Danke! Aber bestechen lasse ich mich trotzdem nicht.\n" }) );

  SetProp(P_MSGIN, "kommt herein");   
  SetProp(P_MSGOUT, "geht");

}

init()
{ object ob;
  ::init();
  if (ob=present("dorwek")) AddDefender(ob);
}


void InformDefend(object enemy)
{
    if(!IsEnemy(enemy))
    command_me("sag Los Dorwek, toeten wir "+enemy->QueryProp(P_NAME)+"!");
    Kill(enemy);
}
