inherit "std/mnpc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>


void create()
{
  if (!is_clone(this_object())) return;
  
  ::create(); 


  SetProp(P_SHORT, "Ein Alchemistenlehrling");
  SetProp(P_LONG, 
    "Vor Dir steht ein kleiner Duergar, welcher noch kleiner ist als die sonst "
    "doch auch so schon sehr kleinen Duergar. Er ist in eine blaue Robe "  
    "gehuellt, welche Dich an einen menschlichen Arbeitsanzug erinnert und "
    "er scheint hier in Gracklstug seine Lehre zu absolvieren.");
  //SetProp(P_ARTICLE,0);
  SetProp (P_MNPC_AREA, ({"/d/unterwelt/lamuerte/gracklstug/rooms/6x2y",
                          "/d/unterwelt/lamuerte/gracklstug/rooms/6x1y",
                          "/d/unterwelt/lamuerte/gracklstug/rooms/6x0y",
                          "/d/unterwelt/lamuerte/gracklstug/rooms/5x2y",
                          "/d/unterwelt/lamuerte/gracklstug/rooms/5x1y",
                          "/d/unterwelt/lamuerte/gracklstug/rooms/5x0y"}));
  SetProp (P_MNPC_WAIT, ({10, 10, 10}));
  SetProp (P_MNPC_DEFAULTROOM,
                    file_name(interactive(previous_object()) ? environment(previous_object()) : previous_object() ));
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_BACKWARDS  + MOV_MOVES  + MOV_MAYLOAD);

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NAME, "Alchemistenlehrling");
  SetProp(P_RACE, "Duergar");
  SetProp(P_SIZE, 80);
  SetProp(P_GENDER, MALE);
  AddId(({"\ngracklnpc","lehrling", "duergar", "dunkelzweg", "alchemist",
          "alchemistenlehrling"}));
  create_default_npc(20+random(3));
  SetProp(P_XP, QueryProp(P_XP)*3/2);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_HANDS, ({" mit brennenden Haenden",120,DT_FIRE})); 
  SetProp(P_SPELLRATE, 50);
  SetProp(P_HEAL, 4 );
  SetProp(P_HP_DELAY, 3 );
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:30]) );

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :-0.1,    DT_BLUDGEON    :-0.1,    DT_PIERCE     :-0.1,
    DT_SQUEEZE    :-0.1,    DT_WHIP        :-0.1,    DT_RIP        :-0.1,
    DT_FIRE       :0.2,     DT_COLD        :-0.2,    DT_WATER      :-1,    
    DT_AIR        :-0.2,    DT_LIGHTNING   :-0.2,    DT_EXPLOSION  :0,
    DT_SOUND      :-0.3,    DT_LIGHT       :0,       DT_ELECTRIC   :-0.2,    
    DT_ACID       :-0.3,    DT_POISON      :-0.2,    DT_TERROR     :-0.3,     
    DT_HOLY       :-0.2,    DT_UNHOLY      :-0.2,    DT_MAGIC      :0]) );
 
  SetProp(P_NOMAGIC,25);

  SetProp(P_MSGIN, "geht herein");
  SetProp(P_MSGOUT, "geht");

  SetProp(P_DIE_MSG, " hat ausgelebt.\n");
  SetProp(P_NOCORPSE, 0 );
  //SetProp(P_KILL_MSG, "");

  SetProp( P_REJECT, REJECT_KEEP);

  enable_commands();


  
  AddInfo( DEFAULT_INFO,"sagt: Ich hab zu lernen. Geh weg.");

   SetChats(4, ({
    "Der Alchemistenlehrling scheint sich zu konzentrieren.\n",
    "Der Alchemistenlehrling schraubt an einer Bombe herum.\n",
    "Der Alchemistenlehrling bastelt an einer Rakete.\n",
    "Der Alchemistenlehrling gruebelt.\n",
    "Der Alchemistenlehrling blaettert in einem Buch.\n"}));
  
  AddSpell(5,120,
      "Der Alchemist zuendet eine Rakete die Dich voll erwischt.\n",
      "Der Alchemist zuendet eine Rakete und erwischt @WEN.\n",
      DT_FIRE, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(1, 100, DS_MASS_DAMAGE,
      "Der Alchemist zuendet eine Bombe.\n",
      "Der Alchemist zuendet eine Bombe.\n",
      DT_FIRE, ([SP_SHOW_DAMAGE:1]) );
//  AddDefaultSpell(1, 300, DS_ANTIMAGIC,
//      ".\n",
//      ".\n",
//      3);

}

void init()
{
  ::init();
  if( this_player() && this_player()->id("duergar"))
    AddDefender(this_player());
  if( this_player() && present("\nalchemistenkiller", this_player())){
    tell_room(environment(this_player()),"Ein Alchemistenlehrling schreit: "+this_player()->QueryProp(P_NAME)+ " Du Alchemistenmoerder!\nEin Alchemistenlehrling schreit: Stirb!\n");
    Kill(this_player());
  }
}

void InformDefend(object enemy) 
{
  Kill(enemy);
}

