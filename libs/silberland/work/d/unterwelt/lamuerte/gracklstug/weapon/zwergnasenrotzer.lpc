inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if( !is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Streitaxt namens 'Zwergnasenrotzer'");
  SetProp(P_LONG,
    "Du haeltst eine prachtvolle Waffe in deinen Haenden. Sie wurde von "
    "einem meisterlichen Duergar Schmied hergestellt um seine Erzfeinde die "
    "Zwerge zu vernichten. Dunkle Kraefe verleihen dieser Axt die Macht "
    "gegen Zwerge einen uebermaechtigen Schaden zu machen.");
  SetProp(P_NAME, "Zwergnasenrotzer");
  SetProp(P_INFO, 
    "Dies ist der Zwergnasenrotzer, eine grauseme Waffe welche von "
    "boesen Maechten hergestellt wurde. Sie ist nicht einfach zu fuehren, "
    "und ihre unbarmherzige Zwergenschlaechtereigenschaft ist bei allen "
    "Zwergen im Silberland gefuerchtet.");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_UNHOLY}) );
  SetProp(P_WC, 300);
  SetProp(P_WC_FIX, 30);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_MATERIAL, ([MAT_MITHRIL:90, MAT_MAGIC:10]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 50000);
  SetProp(P_HIT_FUNC, this_object()); 
  SetProp(P_WIELD_RESTRICTIONS, ([P_XP:40000000, 
                                  SR_SEER: 1,
                                  A_INT: 13,
                                  A_CON: 20,
                                  A_DEX: 20,
                                  A_STR: 25]) );

  AddId( ({"axt", "streitaxt", "zwergnasenrotzer"}) );

}


int HitFunc(object enemy)
{
  int schaden;


  if( enemy->QueryProp(P_RACE)=="Zwerg" || enemy->QueryProp(P_RACE)=="zerg" )
  {

   if( random(200)==100 )
   {
     write("  Dein Zwergnasenrotzer **U L T R A S P A L T E T** Deinen Gegner.\n");
    return 500+random(500);
   }

    if( random(30) >= 15 )
    {
      if(random(5000)<1 && enemy->QueryProp(P_BODY)>=100 ){
        call_out("RemoveIt",0);
        return 1;
      }

      write("  Dein Zwergnasenrotzer zerfetzt Deinen Gegner.\n");
      schaden=80+random(190);
      return enemy->QueryProp(P_LEVEL)+schaden;
    }
    return enemy->QueryProp(P_LEVEL);
  }

  return -100;
}


void RemoveIt()
{
  write("Dein Zwergnasenrotzer zerbroeselt.\n");
  this_object()->remove(1);
}
                
