#include "../def.h"

inherit ROOM "std_gang";

private int brett;

public void create() {
    ::create();

    SetProp(P_INT_LONG, QueryProp(P_INT_LONG)+"@@brett_da@@");

    AddExit("suedwesten", ROOM "b6_b6");
    AddExit("nordwesten", ROOM "b6_b4");
    
    AddSpecialDetail(({"brett", "holzbrett"}), "detail_brett");

    brett = 1;

    AddCmd("nimm|nehme&brett|holzbrett|langes brett|langes holzbrett", "cmd_nimmbrett");
}

public int cmd_nimmbrett() {
    object ob;
    if(!brett) return 0;

    ob = clone_object(OBJ "brett");
    if(ob->move(TP, M_GET) != 1) {
        write(BS("Du kannst das Brett gerade nicht tragen."));
        destruct(ob);
        return -1;
    }

    brett = 0;
    write(BS("Du nimmst das Holzbrett."));
    say(BS(TPN+" nimmt das Holzbrett"));
    return 1;
}

public string brett_da() {
    if(brett) return "Ein langes Holzbrett lehnt an der Wand.";
    return "";
}

public string detail_brett() {
    if(brett) return BS("Komisch. Wer hat es wohl da gelassen und wozu ist es da?");
    return 0;
}

public void reset() {
    ::reset();
    brett = 1;
}