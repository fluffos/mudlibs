#include "../def.h"

inherit "/std/room";

private string *madnessMessages =({
    "Das Fluestern boeser Worte dringt in deinen Geist...",
    "Jemand fluestert: Jaaaa! Nur weiter so! Lass es zu!",
    "Du hoerst ein unheimliches Fluestern ganz in deiner Naehe.",
    "Etwas Boesartiges greift nach deinem Verstand...",
    "Irgendwo in der Stille hoerst du einen verzweifelten Schrei.",
    "Du denkst . o O ( Warum sollte ich immer nur das Richtige tun? )",
    "Eine besudelnde Praesenz greift nach deiner Seele.",
    "Du laechelst ein wenig, als du ueber deine erschlagenen Feinde nachdenkst.",
    "Ein boesartiges Kichern erschallt um dich herum.",
    "Du denkst . o ( Was ist schon dabei, wenn man es nur einmal macht... )",
    "Dein Herz fuehlt sich klamm in deiner Brust.",
    "Eine Woge des Zorns wallt in dir auf.",
    "Warum dagegen ankaempfen? Das Boese siegt immer!",
    "Du sagst: Die Starken regieren ueber die Schwachen! Das war schon immer so!",
    "Du fuehlst dich praechtig, hier in der boesartigen Dunkelheit.",
    "Der saftige Geschmack von Blut liegt auf deiner Zunge.",
    "Mit einem knirschen trittst du auf das Skelett irgendeines kleinen Tieres.",
    "Du schmeckst den metallischen Geschmack von Blut auf deiner Zunge.",
});

public void create() {
    ::create();

    SetProp(P_SHORT, "In einer boesartigen Hoehle");
    SetProp(P_INT_SHORT, "Ein Gang in einer boesartigen Hoehle.");

    SetProp(P_LIGHT, 0);
    SetProp(P_INDOORS, 1);
    SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:20, ENV_TERRAIN:TT_CAVE ]) );
}

public void init() {
    ::init();

    if(living(this_player())) {
        if(!random(10)) call_out("makeEvil", 0, this_player());
        if(this_player()->QueryProp(P_ALIGN) > 40 && !random(10)) {
            call_out("punishTheGood", 0, this_player());
        } else if(this_player()->QueryProp(P_ALIGN) < -40 && !random(5)) {
            call_out("rewardTheEvil", 0, this_player());
        }
    }
}

public void makeEvil(object who) {
    if(!objectp(who)) return;
    if(!living(who)) return;
    tell_object(who, BS(madnessMessages[random(sizeof(madnessMessages))]));
    who->SetProp(P_ALIGN, who->QueryProp(P_ALIGN) - 1 - random(10));
}

private void giveRandomBonus(object who) {
    object obj;

    if(!objectp(obj=present("\ngwenshara_evil_cave_modifier", who))) {
        obj = clone_object(OBJ "bonus");
        if(obj->move(who, M_NOCHECK) != 1) {
            obj->remove(1);
            return;
        }
    }

    obj->SetBonus(who->QueryProp(P_ALIGN));
    who->UpdateAttributes();
    return;
}

public void punishTheGood(object who) {
    if(!random(2)) tell_object(who, BS("Dein Kopf pocht vor Schmerzen..."));
    switch(random(4)) {
        case 0: who->AddHp(random(-10)-1); break;
        case 1: who->AddSp(random(-10)-1); break;
        case 2: who->ModifySkillAttribute(SA_SPEED, 75, 10); break;
        case 3: giveRandomBonus(who); break;
        default: break;
    }
}

public void rewardTheEvil(object who) {
    if(!objectp(who)) return;
    if(!random(3)) tell_object(who, BS("Die Boesartigkeit der Umgebung sicker langsam in dich..."));

    switch(random(4)) {
        case 0: who->AddHp(random(10)+1); break;
        case 1: who->AddSp(random(10)+1); break;
        case 2: who->ModifySkillAttribute(SA_SPEED, 200, 10); break;
        case 3: giveRandomBonus(who); break;
        default: break;
    }
}