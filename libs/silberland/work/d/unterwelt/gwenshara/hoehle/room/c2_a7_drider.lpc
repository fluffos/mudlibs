#include "../def.h"

inherit ROOM "std_drider";

public void create() {
    ::create();

    SetProp(P_INT_LONG, 
            "Du stehst hier mitten in einem gewaltigen Spinnennetz, das die gesamte "
            "Hoehle durchspannt. Hier laufen alle Faeden zusammen und bilden in der "
            "Mitte eine Plattform aus Spinnenseide. ");

    AddDetail( ({"decke"}),
        "An der Decke ueber dir haengt ein maechtiger Stalaktit.");

    AddDetail( ({"stalaktit"}),
       "Der Stalaktit haenge genau ueber dir. Er ist an seine Basis von ein paar dicken "
       "Rissen durchzogen.");

    AddDetail( ({"risse", "rissen"}),
        "Die Risse sehen schon sehr gefaehrlich aus. Wenn man sie mit geeignetem Werkzeug "
        "erweitert, dann wuerde der Stalaktit direkt nach unten stuerzen.");

    AddDetail( ({"werkzeug"}),
        "Ein Hammer und ein Meissel waeren gut geeignet.");

    AddDetail( ({"hammer", "meissel"}),
        "Wo soll man das nur hier her bekommen?");

    AddDetail(({"basis", "sockel"}), "An der Basis des Stalaktits siehst du einige tiefe Risse, die bis in den Stein reichen.");
    AddDetail(({"boden"}), "Der Boden der Hoehle ist mit einem dicken Teppich aus Spinnweben bedeckt.");
    AddDetail(({"faden", "faeden"}), "Die Faeden des Spinnennetzes sind unglaublich stark und widerstandsfaehig.");
    AddDetail(({"hoehle"}), "Die Hoehle ist riesig und hoch. Die Decke ist kaum zu sehen.");
    AddDetail(({"mitte"}), "In der Mitte der Hoehle befindet sich eine Plattform aus Spinnenseide.");
    AddDetail(({"plattform"}), "Die Plattform ist aus dicken Spinnfaeden gewebt und scheint stabil zu sein.");
    AddDetail(({"spinnennetz"}), "Das Spinnennetz spannt sich ueber die gesamte Hoehle und faengt das Licht der Fackeln ein.");
    AddDetail(({"spinnenseide"}), "Die Spinnenseide ist weich und glaenzend.");
    AddDetail(({"waende", "wand"}), "Die Waende der Hoehle sind glatt und feucht.");
    AddDetail(({"wand"}), "Die Waende der Hoehle sind hoch und schroff.");
    AddDetail(({"gehoer"}), "Du hoerst das leise Knattern von Spinnweben in der Luft.");
    AddDetail(({"luftzug"}), "Ein kalter Luftzug streicht durch die Hoehle.");
    AddDetail(({"geruch"}), "Du riechst den moschusartigen Duft von Spinnen.");
    AddDetail(({"fackel", "fackeln"}), "Die Fackeln an den Waenden werfen ein flackerndes Licht auf die Szene.");
    AddDetail(({"licht"}), "Das Licht der Fackeln laesst die Spinnweben in der Luft glitzern.");
    AddDetail(({"spinnfaden", "spinnfaeden"}), "Die Spinnfaeden sind unglaublich stark und widerstandsfaehig.");
    AddDetail(({"spinnweben"}), "Die Spinnweben sind so dicht, dass man sie fast als Wand betrachten kann.");
    AddDetail(({"stein"}), "Der Stein der Hoehle ist kalt und feucht.");
    AddDetail(({"teppich"}), "Der Teppich aus Spinnweben ist weich und daempft deine Schritte.");
        

    AddExit("norden", ROOM "c2_a6_drider");
    AddExit("sueden", ROOM "c2_a8_drider");
    AddExit("osten", ROOM "c3_a7_drider");
    AddExit("westen", ROOM "c1_a7_drider");

    AddItem(NPC "driderqueen", REFRESH_DESTRUCT);

    AddCmd("erweitere|erweiter&riss|risse", "cmd_erweitern", "Was willst du erweitern?");
}

public int cmd_erweitern() {
    object ob;

    if(!objectp(ob=present("\ngwenshara_evil_cave_hammer", TP))) {
        write(BS("Ohne geeignetes Werkzeug funktioniert das nicht."));
        return -1;
    }

    if(ob->QueryProp(P_WIELDED) != TP) {
        write(BS("Du musst Hammer und Meissel schon zuecken dafuer."));
        return -1;
    }

    write(BS("Mit ein paar kraeftigen Hieben erweiterst du den Riss. Hammer und Meissel zerbrechen dabei leider."));
    say(BS(TPN+" haemmert wild an der Decke herum."));

    ob->remove(1);

    call_out("kill_driderqueen", 4);
    return 1;
}

public void kill_driderqueen() {
    object queen, *inv;
    int i;

    if(!objectp(queen=present("\ngwenshara_evil_cave_driderqueen"))) return;

    tell_room(TO, BS("Der Stalaktit loest sich von der Decke und kracht genau auf "+queen->Name(WEN)+"."));

    inv = all_inventory(queen);
    for(i=0; i<sizeof(inv); ++i) {
        if(inv[i]->id("\ngwenshara_evil_cave_ring_3")) continue;
        inv[i]->remove(1);
    }

    queen->die();
    return;
}
