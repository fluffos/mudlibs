#include "../def.h"

inherit ROOM "std_drider";

public void create() {
    ::create();
    replace_program(ROOM "std_drider");

    SetProp(P_INT_LONG, 
            "Vorsichtig trittst du auf das gigantische Spinnennetz. Es erstreckt sich "
            "in der gesamten Hoehle von Wand zu Wand. Bei deinen ersten Schritten "
            "scheint es stabil genug dich zu tragen. Dicke Faeden fuehren von hier "
            "aus weiter. Nach Sueden hin kannst du das Netz wieder verlassen.");

    AddExit("nordosten", ROOM "c3_a7_drider");
    AddExit("nordwesten", ROOM "c1_a7_drider");
    AddExit("sueden", ROOM "c2_a9");
    AddExit("norden", ROOM "c2_a7_drider");

    AddItem( NPC "drider", REFRESH_DESTRUCT);

    AddDetail(({ "boden" }), "Der Boden des Raums besteht aus einem dichten Spinnennetz, das sich fest und stabil unter deinen Fuessen spannt.");

    AddDetail(({ "decke" }), "Die Decke der Hoehle ist von einem Netz aus duennen Spinnfaeden bedeckt, die sich im Dunkeln verlieren.");

    AddDetail(({ "faeden" }), "Die Faeden des Spinnennetzes sind dick und robust, und sie erstrecken sich in alle Richtungen, um das Netz zu unterstuetzen.");

    AddDetail(({ "hoehle" }), "Die Hoehle ist von den Waenden bis zur Decke mit einem gigantischen Spinnennetz bedeckt, das den Raum durchzieht.");

    AddDetail(({ "netz" }), "Das Spinnennetz erstreckt sich von Wand zu Wand und bildet den Raum, in dem du dich befindest. Es ist stabil genug, um dich zu tragen.");

    AddDetail(({ "schritten" }), "Du spuerst die Festigkeit des Spinnennetzes unter deinen Schritten, waehrend du dich vorsichtig durch den Raum bewegst.");

    AddDetail(({ "spinnennetz" }), "Das Spinnennetz, auf dem du stehst, ist riesig und bildet ein komplexes Muster aus dicken Faeden.");

    AddDetail(({ "waende" }), "Die Waende der Hoehle sind von dem Spinnennetz umgeben, das sich von Wand zu Wand spannt.");

    AddDetail(({ "wand" }), "Die Waende der Hoehle sind mit dem Spinnennetz bedeckt und bieten einen festen Untergrund fuer die darin lebenden Kreaturen.");

    AddDetail(({ "dunkeln", "dunkel" }), "Das Dunkel der Hoehle wird von den duennen Spinnfaeden reflektiert, die das gesamte Netz bedecken.");

    AddDetail(({ "festigkeit" }), "Die Festigkeit des Spinnennetzes gibt dir das Vertrauen, dass es dich sicher tragen kann, waehrend du dich durch den Raum bewegst.");

    AddDetail(({ "fuessen" }), "Die Faeden des Spinnennetzes fuehlen sich unter deinen Fuessen fest und gleichzeitig elastisch an.");

    AddDetail(({ "kreaturen" }), "Das Spinnennetz beherbergt verschiedene Kreaturen, die sich geschickt darin bewegen und ihr Zuhause darin gefunden haben.");

    AddDetail(({ "muster" }), "Das Muster des Spinnennetzes ist komplex und faszinierend, mit zahlreichen Verzweigungen und Knotenpunkten.");

    AddDetail(({ "raum" }), "Der Raum, in dem du dich befindest, ist von einem riesigen Spinnennetz durchzogen, das von den Waenden bis zur Decke reicht.");

    AddDetail(({ "raums" }), "Der Raum, in dem du dich befindest, ist von einem riesigen Spinnennetz durchzogen, das von den Waenden bis zur Decke reicht.");

    AddDetail(({ "spinnfaeden" }), "Die duennen Spinnfaeden bilden das Netz, das den Raum ausfuellt, und glaenzen im schwachen Licht der Hoehle.");

    AddDetail(({ "untergrund" }), "Das Spinnennetz bildet einen festen Untergrund, der den Raum auskleidet und einzigartige Lebensraeume fuer die Bewohner schafft.");

    AddDetail( ({"bewohner"}), "So genau willst du es eigentlich gar nicht wissen.");

    AddDetail(({"knotenpunkte", "verzweigungen", "knotenpunkten"}), "Mit seinen Kontenpunkten und Verzweigungen bildet das Netz ein faszinierendes Muster.");

    AddDetail(({"lebensraeume"}), "So wie das Netz, auf dem du hier stehst. Einzigartig!");

    AddDetail(({"licht"}), "Hier herunten gibt es kaum Licht.");

    AddDetail(({"vertrauen"}), "Dem Netz kannst du vertrauen. Was auch immer es geschaffen hat, kann feste Faeden spinnen.");
}
