#include "../def.h"

inherit ROOM "std_gang";

private int brett, angesaegt;

public void create() {
    ::create();

    SetProp(P_INT_LONG, QueryProp(P_INT_LONG)+"@@brett_long@@");

    AddSpecialDetail(({"grube", "loch"}), "detail_grube");
    AddSpecialDetail(({"brett", "holzbrett"}), "detail_brett");

    AddExit("nordwesten", ROOM "c0_b1");
    AddExit("osten", ([
        EX_DEST: ROOM "c2_b2_see",
        EX_TESTFUNC: "istBrettDa"]));

    brett = angesaegt = 0;

    AddCmd("lege|leg&brett|holzbrett&ueber|auf&grube|loch", "cmd_legen", "Was willst du worueber legen?");
    AddCmd("saege|saeg&brett|holzbrett&an", "cmd_saegen", "Was willst du ansaegen?");
}

public string detail_grube() {
    string str;
    str = "Oestlich von dir ist eine Grube, die ein bodenloses Loch zu sein scheint. Was auch immer dort "
          "runter faellt, kommt sicher nicht mehr zurueck.";
    if(brett) {
        str += " Jemand ein ein Brett darueber gelegt, sodass du weiter nach Osten gehen kannst.";
    } else {
        str += " Um sie zu ueberqueren muesstest du irgendwas darueber legen koennen.";
    }

    return BS(str);
}

public int cmd_saegen() {
    if(!objectp(present("\ngwenshara_cave_saw", TP))) {
        write(BS("Du hast doch nichts zum Saegen dabei!"));
        return -1;
    }

    if(angesaegt) {
        write(BS("Ritsche, ratsche! Du saegst das Brett an. Offenbar war es bereits angesaegt und faellt in zwei Teile zerteilt in die Grube..."));
        say(BS("Ritsche, ratsche - "+TPN+" saegt das Brett an. Ploetzlich zerfaellt es in zwei Teile und faellt in die Grube."));
        brett = 0; angesaegt = 0;
        return 1;
    } else {
        write(BS("Ritsche, ratsche - Du saegst das Brett an. Wenn jetzt jemand zu schwer oder unvorsichtig ist, dann wird es zerbrechen."));
        say(BS("Ritsche, ratsche - "+TPN+" saegt das Brett an."));
        angesaegt = 1;
        return 1;
    }

    return 0;
}

public int istBrettDa() {
    if(!brett) {
        write(BS("Ohne ein Hilfmittel kannst du die Grube nicht einfach ueberqueren."));
        return 0;
    }
    return 1;
}

public int cmd_legen() {
    object ob;
    if(brett) {
        write(BS("Es liegt bereits ein Brett ueber der Grube."));
        return -1;
    }

    if(!objectp(ob=present("\ngwenshara_cave_brett", TP))) {
        write(BS("Du hast kein passende Brett bei dir."));
        return -1;
    }

    ob->remove(1);
    brett = 1;

    write(BS("Schwungvoll legst du ein Brett ueber die Grube. Der Weg nach Osten ist jetzt frei."));
    say(BS(TPN+" leget schwungvoll ein Brett ueber die Grube. Der Weg nach Osten ist jetzt frei."));
    return 1;
}

public string detail_brett() {
    string str;

    if(brett) {
        str = "Jemand hat ein Brett ueber die Grube gelegt, ueber das du bequem gehen kannst.";
        if(angesaegt) {
           str += "Es wurde angesaegt, sodass du vorsichtig sein musst.";
        }
    }

    return BS(str);
}

public string brett_long() {
    string long;

    long = "";
    if(!brett) {
        long += "Eine grosse Grube ist oestlich von dir und verhindert, dass du voran kommst.";
    } else {
        long += "Ein Holzbrett wurde ueber eine grosse Grube oestlich von dir gelegt, sodass du dort weiter gehen kannst.";
    }

    return long;
}

public void reset() {
    ::reset();

    if(brett) {
        tell_room(TO, BS("Ein Felsbrocken faellt auf das Brett und zertruemmert es in alle Teile. Es faellt in die Grube."));
        brett = 0;
    }

    angesaegt = 0;
}

public int QueryBrettAngesaegt() {
    return brett && angesaegt;
}
