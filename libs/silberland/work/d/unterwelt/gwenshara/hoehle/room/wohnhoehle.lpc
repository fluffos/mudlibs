#include "../def.h"
#include <npcmaster.h>

inherit ROOM "std_hoehle";

int poison, mirror;

public void create() {
    ::create();

    SetProp(P_INT_SHORT, "Eine Wohnhoehle");
    SetProp(P_INT_LONG, "Durch den Vorhang aus Blumen hindurch bist du in einer gut "
                        "eingerichteten Wohnhoehle gelandet. Auch hier sind die Waende "
                        "mit Pflanzenranken voller dicker roter Dornen ueberzogen. An der "
                        "hinteren Wand befindet sich eine Schlafstaette aus flauschigen "
                        "schwarzen Polstern. Daneben befindet sich ein Schminktisch. Eine "
                        "Staffelei mit einem halb gemalten Bild steht mitten im Raum.");

    AddDetail( ({"tisch", "schminktisch"}),
        "Der Schminktisch ist aus einem dunklen Holz gemacht. Auf ihm stehen ein paar Pinsel, "
        "Flaeschchen, ein grosser Spiegel und ein Kelch.");

    AddSpecialDetail( ({"spiegel"}), "detail_spiegel");

    AddDetail( ({"kelch"}),
        "Der Kelch auf dem Schminktisch ist mit einer blutroten Fluessigkeit gefuellt. "
