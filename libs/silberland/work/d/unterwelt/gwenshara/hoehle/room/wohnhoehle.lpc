    AddDetail( ({"schluck", "fluessigkeit", "wein"}),
        "Du hoffst, dass es einfach nur ein sehr dunkler Wein ist...");

    AddDetail(({"bild"}), "Auf der Staffelei steht ein halb gemaltes Bild, das die Kuenstlerin wohl noch fertigstellen moechte.");

    AddDetail(({"blumen"}), "Die Blumen des Vorhangs fuegen einen Hauch von Farbe und Schoenheit zu diesem Raum hinzu.");
    
    AddDetail(({"boden"}), "Der Boden der Wohnhoehle ist aus dunklem Holz gefertigt und strahlt eine gewisse Waerme aus.");
    
    AddDetail(({"decke"}), "Die Decke ist von Pflanzenranken bedeckt, die mit dicken roten Dornen uebersaet sind.");
    
    AddDetail(({"dornen"}), "Die Dornen an den Pflanzenranken sind dick und rot, und koennten eine gewisse Gefahr darstellen.");
    
    AddDetail(({"evandrina"}), "Evandrina ist eine blutrote Elfe, die hier in der Hoehle lebt und anscheinend einen Kelch mit einer blutroten Fluessigkeit trinkt.");
    
    AddDetail(({"flaeschchen"}), "Auf dem Schminktisch stehen einige Flaeschchen, deren Inhalt du nicht naeher erkennen kannst.");
    
    AddDetail(({"holz"}), "Der Schminktisch und die Staffelei sind aus dunklem Holz gefertigt und strahlen eine gewisse Eleganz aus.");
    
    AddDetail(({"pflanzenranken"}), "Die Waende sind mit Pflanzenranken bedeckt, die sich mit dicken roten Dornen um sie wickeln.");
    
    AddDetail(({"pinsel"}), "Ein paar Pinsel liegen auf dem Schminktisch, bereit zum Gebrauch.");
    
    AddDetail(({"polstern", "schlafstaette"}), "Die Schlafstaette besteht aus flauschigen schwarzen Polstern, die zum Ausruhen einladen.");
    
    AddDetail(({"raum"}), "Die Wohnhoehle ist gut eingerichtet und strahlt eine gewisse Gemuetlichkeit aus.");
    
    AddDetail(({"staffelei"}), "Eine Staffelei steht mitten im Raum und traegt ein halb gemaltes Bild, das wohl von der Bewohnerin stammt.");
    
    AddDetail(({"vorhang"}), "Der Vorhang aus bunten Blumen fuehrt in die Hoehle hinein und verleiht dem Raum einen Hauch von Romantik.");
    
    AddDetail(({"waende", "wand"}), "Die Waende sind mit Pflanzenranken bedeckt.");
    
    AddDetail(({"wohnhoehle", "hoehle", "ort", "rueckzugsort"}), "Diese gut eingerichtete Wohnhoehle ist der Lebensraum der Bewohnerin, Evandrina.");

    AddDetail(({"ausruhen"}), "Die Schlafstaette laedt zum Ausruhen und Entspannen ein, mit ihren flauschigen Polstern und gemuetlichen Ausblick.");

    AddDetail(({"bewohnerin"}), "Die Bewohnerin dieser Hoehle ist Evandrina, eine blutrote Elfe, die hier zu leben scheint.");

    AddDetail(({"eleganz"}), "Der Schminktisch und die Staffelei strahlen eine gewisse Eleganz aus, die dem Raum eine edle Note verleiht.");

    AddDetail(({"elfe"}), "Evandrina ist eine blutrote Elfe, die hier in der Hoehle lebt und anscheinend einen Kelch mit einer blutroten Fluessigkeit trinkt.");

    AddDetail(({"farbe"}), "Die Blumen des Vorhangs verleihen dem Raum einen Hauch von Farbe und Schoenheit.");

    AddDetail(({"gebrauch"}), "Die Pinsel auf dem Schminktisch stehen bereit zum Gebrauch und warten darauf, von geschickten Haenden verwendet zu werden.");

    AddDetail(({"gefahr"}), "Die dicken roten Dornen an den Pflanzenranken koennten eine gewisse Gefahr darstellen, wenn man unvorsichtig ist.");

    AddDetail(({"gemuetlichkeit"}), "Die Wohnhoehle strahlt eine gewisse Gemuetlichkeit aus, die zum Verweilen einlaedt und ein Gefuehl von Zuhause vermittelt.");

    AddDetail(({"hauch"}), "Der Vorhang aus bunten Blumen verleiht dem Raum einen Hauch von Romantik und verzaubert die Sinne.");

    AddDetail(({"hoehle"}), "Diese Hoehle dient als Lebensraum fuer Evandrina und ist mit liebevoller Sorgfalt eingerichtet.");

    AddDetail(({"inhalt"}), "Der Inhalt der Flaeschchen auf dem Schminktisch ist nicht naeher zu erkennen, aber sie koennten verschiedene Kosmetika oder Zutaten enthalten.");

    AddDetail(({"kuenstlerin"}), "Die Kuenstlerin des halb gemalten Bildes bleibt unbekannt, aber vielleicht handelt es sich um Evandrina selbst.");

    AddDetail(({"lebensraum"}), "Diese Hoehle ist der Lebensraum der Bewohnerin, Evandrina, und bietet ihr Schutz und Geborgenheit.");

    AddDetail(({"romantik"}), "Der Vorhang aus bunten Blumen laedt zum Traeumen ein.");

    AddDetail(({"schoenheit"}), "Die Blumen des Vorhangs fuegen eine gewisse Schoenheit und Eleganz zu diesem Raum hinzu.");

    AddDetail(({"waerme"}), "Der Boden aus dunklem Holz strahlt eine angenehme Waerme aus und traegt zum gemuetlichen Ambiente bei.");

    AddDetail(({"ambiente"}), "Die Wohnhoehle strahlt ein gemuetliches und einladendes Ambiente aus, das zum Verweilen einlaedt.");

    AddDetail(({"ausblick"}), "Von der Schlafstaette aus hat man einen angenehmen Ausblick auf den restlichen Raum und kann sich in Ruhe entspannen.");

    AddDetail(({"entspannen"}), "Die Wohnhoehle laedt dazu ein, sich zurueckzulehnen und zu entspannen.");

    AddDetail(({"geborgenheit"}), "Die Wohnhoehle strahlt eine gewisse Geborgenheit aus und vermittelt ein Gefuehl von Sicherheit und Schutz.");

    AddDetail(({"gefuehl"}), "Beim Betreten der Wohnhoehle ueberkommt einen ein warmes und behagliches Gefuehl.");

    AddDetail(({"haenden"}), "Die Pinsel auf dem Schminktisch warten darauf, von geschickten Haenden benutzt zu werden, um Kunstwerke zu erschaffen.");

    AddDetail(({"kosmetika"}), "Die Flaeschchen auf dem Schminktisch koennten verschiedene Kosmetika oder Zutaten enthalten, um die Schoenheit zu betonen.");

    AddDetail(({"note"}), "Die elegante Einrichtung der Wohnhoehle verleiht ihr eine gewisse Note von Stil und Klasse.");

    AddDetail(({"schutz"}), "Die Hoehle bietet Evandrina Schutz vor der Aussenwelt und dient ihr als sicherer Rueckzugsort.");

    AddDetail(({"sinne"}), "Die bunten Blumen des Vorhangs betoeren die Sinne.");

    AddDetail(({"sorgfalt"}), "Die Einrichtung der Wohnhoehle wurde mit liebevoller Sorgfalt ausgewaehlt und arrangiert.");

    AddDetail(({"traeumen"}), "Die Romantik der Wohnhoehle laedt dazu ein, zu traeumen und den Alltag hinter sich zu lassen.");

    AddDetail(({"verweilen"}), "Die gemuetliche Schlafstaette laedt zum Verweilen ein und bietet einen angenehmen Ort zum Ausruhen.");

    AddDetail(({"zuhause"}), "Die Wohnhoehle fuehlt sich wie ein Zuhause an, in dem man sich geborgen und wohl fuehlt.");

    AddDetail(({"zutaten"}), "Die Flaeschchen auf dem Schminktisch koennten verschiedene Zutaten enthalten, um Kosmetika herzustellen oder spezielle Traenke zu mischen.");

    AddDetail(({"alltag"}), "Die Wohnhoehle bietet einen Rueckzugsort vom Alltag und ermoeglicht es.");

    AddDetail(({"aussenwelt"}), "Die Hoehle bietet Evandrina Schutz vor der Gefahren der Aussenwelt und dient als sicherer Ort.");

    AddDetail(({"betreten"}), "Beim Betreten der Wohnhoehle wird man von ihrem einladenden Ambiente empfangen.");

    AddDetail(({"einrichtung"}), "Die Einrichtung der Wohnhoehle ist stilvoll und geschmackvoll.");

    AddDetail(({"klasse"}), "Die elegante Einrichtung der Wohnhoehle verleiht ihr eine gewisse Klasse und Eleganz.");

    AddDetail(({"kunstwerke"}), "Die Staffelei in der Wohnhoehle steht bereit, um Kunstwerke zu erschaffen und den Raum mit Schoenheit zu fuellen.");

    AddDetail(({"ruhe"}), "Die Wohnhoehle strahlt eine angenehme Ruhe aus, die es ermoeglicht, sich zu entspannen und zur Ruhe zu kommen.");

    AddDetail(({"sicherheit"}), "Die Wohnhoehle bietet einen sicheren Rueckzugsort und schuetzt vor den Gefahren der Aussenwelt.");

    AddDetail(({"stil"}), "Die Einrichtung der Wohnhoehle ist von einem zeitlosen Stil gepraegt und verleiht ihr eine gewisse Eleganz.");

    AddDetail(({"traenke", "tinkturen"}), "Die Flaeschchen auf dem Schminktisch koennten verschiedene Zutaten enthalten, um spezielle Traenke oder Tinkturen herzustellen.");


    AddExit("westen", ROOM "c1_b4_garten");

    AddItem(NPC "blutelfe", REFRESH_DESTRUCT);

    poison = 0;
    mirror = 1;
    AddCmd(({"fuelle", "fuell", "leere", "leer"}), "cmd_leeren");
    AddCmd("zerschlage|zerschlag|hau|haue|schlage|schlag&spiegel", "cmd_zerschlagen", "Was willst du zerschlagen?");
}

public string detail_spiegel() {
    if(mirror) { 
        return BS("Der Spiegel ist gross genug, dass du dich gut darin sehen kannst. Hoffentlich "
        "zerschlaegt ihn niemand unabsichtlich. Er sieht sehr teuer aus.");
    }

    return BS("Eigentlich waere der Spiegel gross genug, dass du dich komplett darin sehen koenntest. Allerdings "
           "hat ihn erst kuerzlich jemand zerschlagen.");
}

public int cmd_zerschlagen() {
    object splitter;
    if(!mirror) {
        write(BS("Den Spiegel hat bereits jemand zerschlagen."));
        return -1;
    }

    if(objectp(present("\ngwenshara_evil_cave_bloodelf", TO))) {
        write(BS("So lange Evandrina hier ist, willst du das lieber nicht riskieren..."));
        return -1;
    }

    write(BS("Mit einem kraeftigen Hieb zertruemmerst du den Spiegel. Dabei schneidest du dich und "
             "vier Splitter bleiben in deiner Hand stecken. Aua!"));
    say(BS(TPN+" zerschlaegt den Spiegel mit einem gezielten Hieb!"));
    TP->AddHp(-50);

    splitter = clone_object(OBJ "spiegelsplitter");
    if(splitter->move(TP, M_NOCHECK) != 1) {
        splitter->move(TO, M_NOCHECK);
    }
    mirror = 0;
    return 1;
}

public int cmd_leeren(string str) {
    object phiole;

    notify_fail("Was willst du wohin fuellen?\n");
    if(str == "" || !str) return 0;
    if(str != "phiole in kelch" && str != "gift in kelch" && str != "dridergift in kelch" &&
       str != "giftphiole in kelch" && str != "phiole mit gift in kelch" && 
       str != "phiole mit dridergift in kelch") return 0;

    if(!objectp(phiole=present("\ngwenshara_evil_cave_vial", TP))) {
        write(BS("Gute Idee, aber dir fehlt das Gift dazu!"));
        return -1;
    }

    if(!phiole->IsFilled()) {
        write(BS("Du solltest auch Gift in die Phiole fuellen!"));
        return -1;
    }

    write(BS("In einem unbeobachteten Moment fuellst du das Gift in den Kelch."));
    say(BS("in einem unbeobachteten Moment fuellt "+TPN+" etwas in den Kelch."));

    phiole->remove(1);
    if(!poison) {
        call_out("evandra_drink", 4);
        poison = 1;
    }
    return 1;
}

public void evandra_drink() {
    object elf;

    if(!objectp(elf=present("\ngwenshara_evil_cave_bloodelf", TO))) return;

    elf->command_me("emote nimmt einen grossen Schluck aus dem Kelch.");
    elf->SetProp(P_NO_SCORE, 1);
    elf->die(1);
    poison = 0;
    return;
}

public void reset() {
    poison = 0;
    mirror = 1;
    ::reset();
}