#include "../def.h"

inherit ROOM "std_hoehle";

private int soup, vial;

public void create() {
    ::create();
    soup = 1 + random(3);
    vial = 1;

    SetProp(P_INT_SHORT, "In einer Hexenkueche");
    SetProp(P_INT_LONG, 
            "Dieser Teil der Hoehle dient eindeutig als Kueche, wenn auch "
            "gleich hier sicherlich nichts gekocht wird, das du gerne "
            "essen moechtest. An der Suedwand haengt ein grosser, blubbernder "
            "Kessel ueber dem Feuer. Ein kleiner Tisch mit einem Sessel "
            "steht ihm gegenueber. Die Waende sind mit Regalen, die verschiedene "
            "Doeschen und Flaeschchen beherbergen gespickt.");

    SetProp(P_LIGHT, 1);

    AddDetail(({"regale", "regalen"}), "Auf den Regalen versammeln sich einige Doeschen und "
      "Flaeschchen.");

    AddDetail( ({"doeschen"}), "Die unterschiedlichen Doeschen und Tiegel scheinen allesamt "
      "verschiedene Gewuerze zu beinhalten.");

    AddSpecialDetail(({"flaschen", "flaeschchen"}), "detail_flaschen");
    AddSpecialDetail("luecke", "detail_luecke");
    AddSpecialDetail("phiole", "detail_phiole");

    AddDetail( ({"kessel"}), "In einem grossen Kessel blubbert eine duftende Suppe vor sich hin.");

    AddDetail( ({"suppe"}), "Es handelt sich um eine dicke und wuerzige Suppe. Wie sie wohl schmeckt?");

    AddDetail(({"boden"}), "Der Boden der Hoehle ist aus festem Stein, von dem einige Flecken von vergossener Suppe zeugen.");

    AddDetail(({"decke"}), "Die Decke der Hoehle ist von dunklen Schatten ueberzogen, die vom schwachen Licht der Fackeln kaum durchdrungen werden.");

    AddDetail(({"feuer"}), "Ein Feuer brennt unter dem Kessel an der Suedwand, und seine Flammen werfen wirbelnde Schatten an die Waende.");

    AddDetail(({"gewuerze"}), "Die Gewuerze in den Tiegeln scheinen eine Vielzahl von Aromen zu bieten, von suess bis scharf.");

    AddDetail(({"hoehle"}), "Die Hoehle ist dunkel und unheimlich, und das schwache Licht der Fackeln erhellt nur einen kleinen Teil davon.");

    AddDetail(({"kueche"}), "Dieser Teil der Hoehle dient offensichtlich als Hexenkueche, in der duestere Zutaten zu noch duestereren Gerichten verarbeitet werden.");

    AddDetail(({"sessel"}), "Ein alter Holzsessel steht einsam an einem kleinen Tisch, als ob er auf jemanden warten wuerde, der ihn benutzt.");

    AddDetail(({"suedwand"}), "An der Suedwand haengt ein grosser, blubbernder Kessel ueber dem Feuer, der den Raum mit einem verfuehrerischen Duft erfuellt.");

    AddDetail(({"teil"}), "Dieser Teil der Hoehle ist eindeutig als Kueche eingerichtet, mit einem Kessel ueber dem Feuer und Regalen voller Zutaten.");

    AddDetail(({"tiegel"}), "Die Toepfe und Tiegel auf den Regalen enthalten eine Vielzahl von Zutaten, die fuer die Zubereitung dunkler Speisen verwendet werden.");

    AddDetail(({"tisch"}), "Ein kleiner Tisch steht einsam in der Mitte des Raumes, als ob er auf die naechste Mahlzeit wartet.");

    AddDetail(({"waende", "wand"}), "Die Waende der Hoehle sind mit Regalen bedeckt, die mit Tiegeln und Fläschchen gefüllt sind.");

    AddDetail(({"wand"}), "Die Waende der Hoehle sind mit Regalen bedeckt, auf denen verschiedene Zutaten und Gewuerze aufbewahrt werden.");

    AddDetail(({"aromen"}), "Die Aromen der verschiedenen Zutaten vermischen sich in der Luft und erfuellen den Raum mit einem verlockenden Duft.");

    AddDetail(({"duft"}), "Ein verfuehrerischer Duft von Gewuerzen und Kochendem steigt aus dem Kessel empor und erfuellt den Raum.");

    AddDetail(({"fackeln"}), "Die Fackeln an den Waenden werfen ein schwaches Licht in den Raum und tauchen ihn in ein gespenstisches Flackern.");

    AddDetail(({"fla"}), "Das schwache Licht der Fackeln erhellt den Raum und wirft wirbelnde Schatten an die Waende.");

    AddDetail(({"flammen"}), "Die Flammen des Feuers lodern unter dem Kessel an der Suedwand und werfen wirbelnde Schatten an die Waende.");

    AddDetail(({"flecken"}), "Einige Flecken von vergossener Suppe zieren den Steinboden, Zeugnis frueherer Mahlzeiten in dieser Hexenkueche.");

    AddDetail(({"gerichten"}), "Die Gerichte, die in dieser Hexenkueche zubereitet werden, sind sicherlich nichts fuer schwache Maegen.");

    AddDetail(({"hexenkueche"}), "Dieser Raum ist eindeutig als Hexenkueche eingerichtet, in der duestere Zutaten zu noch duestereren Gerichten verarbeitet werden.");

    AddDetail(({"holzsessel"}), "Ein alter Holzsessel steht einsam an einem kleinen Tisch, als ob er auf jemanden warten wuerde, der ihn benutzt.");

    AddDetail(({"licht"}), "Das schwache Licht der Fackeln erhellt den Raum und taucht ihn in ein gespenstisches Gluehen.");

    AddDetail(({"mahlzeit"}), "Der Raum duftet nach koestlichen Speisen, die hier in dieser Hexenkueche zubereitet werden.");

    AddDetail(({"mitte"}), "Ein kleiner Tisch steht einsam in der Mitte des Raumes, als ob er auf die naechste Mahlzeit wartet.");

    AddDetail(({"raum"}), "Der Raum ist duester und unheimlich, doch das schwache Licht der Fackeln erhellt zumindest einen kleinen Teil davon.");

    AddDetail(({"schatten"}), "Die Flammen der Fackeln werfen wirbelnde Schatten an die Waende und verleihen dem Raum eine gespenstische Atmosphaere.");

    AddDetail(({"speisen"}), "Die Speisen, die in dieser Hexenkueche zubereitet werden, sind sicherlich nichts fuer schwache Maegen.");

    AddDetail(({"stein"}), "Der Steinboden der Hoehle ist hart und kalt, mit einigen Flecken von vergossener Suppe.");

    AddDetail(({"toepfe"}), "Die Toepfe und Tiegel auf den Regalen enthalten eine Vielzahl von Zutaten, die fuer die Zubereitung dunkler Speisen verwendet werden.");

    AddDetail(({"vielzahl"}), "Es gibt eine Vielzahl von Zutaten in dieser Hexenkueche, von seltenen Kraeutern bis zu exotischen Gewuerzen.");

    AddDetail(({"zubereitung"}), "Die Zubereitung der Speisen in dieser Hexenkueche erfordert viel Geschick und dunkle Magie.");

    AddDetail(({"zutaten"}), "Die Regale sind gefuellt mit einer Vielzahl von Zutaten, von seltenen Kraeutern bis zu exotischen Gewuerzen.");

    AddDetail(({"atmosphaere"}), "Die Atmosphaere in dieser Hexenkueche ist duester und gespenstisch, gefuellt mit dem Duft von geheimnisvollen Zutaten.");

    AddDetail(({"flackern"}), "Das Flackern der Fackeln wirft unheimliche Schatten an die Waende und traegt zur gespenstischen Atmosphaere des Raumes bei.");

    AddDetail(({"gerichte"}), "Die Gerichte, die in dieser Hexenkueche zubereitet werden, sind sicherlich nichts fuer schwache Maegen.");

    AddDetail(({"geschick"}), "Die Zubereitung der Speisen in dieser Hexenkueche erfordert viel Geschick und dunkle Magie.");

    AddDetail(({"gluehen"}), "Das schwache Licht der Fackeln taucht den Raum in ein gespenstisches Gluehen, das die duesteren Zutaten der Hexenkueche hervorhebt.");

    AddDetail(({"kochendem"}), "Ein verfuehrerischer Duft von Gewuerzen und Kochendem steigt aus dem Kessel empor und erfuellt den Raum.");

    AddDetail(({"kraeutern"}), "Die Regale sind gefuellt mit einer Vielzahl von Kraeutern, die fuer die Zubereitung dunkler Speisen verwendet werden.");

    AddDetail(({"luft"}), "Die Luft in der Hexenkueche ist schwer und dick, gefuellt mit dem Duft von geheimnisvollen Zutaten und dunkler Magie.");

    AddDetail(({"maegen"}), "Die Gerichte, die in dieser Hexenkueche zubereitet werden, sind sicherlich nichts fuer schwache Maegen.");

    AddDetail(({"magie"}), "Die Zubereitung der Speisen in dieser Hexenkueche erfordert nicht nur Geschick, sondern auch dunkle Magie.");

    AddDetail(({"steinboden"}), "Der Steinboden der Hoehle ist hart und kalt, mit einigen Flecken von vergossener Suppe.");

    AddDetail(({"zeugnis"}), "Einige Flecken von vergossener Suppe zieren den Steinboden, Zeugnis frueherer Mahlzeiten in dieser Hexenkueche.");



    AddExit("norden", ROOM "b2_b2_hexer");
    AddExit("nordwesten", ROOM "b1_b2_hexer");

    AddCmd( ({"koste", "kost"}), "cmd_kosten");
    AddCmd( CMD_NEHMEN, "cmd_nimm");
}

public string detail_phiole() {
    if(!vial) {
        return BS("Jemand hat sich die Phiole wohl schon genommen.");
    }

    return BS("Die Phiole ist leer. Vielleicht kannst du sie brauchen?");
}

public string detail_flaschen() {
    string str;

    str = "Auf den Regalen draenigen sich verschiende Flaeschchen eng aneinander.";
    if(vial) {
        str += " Unter ihnen auch eine leere Phiole.";
    } else {
        str += " Nur eine Luecke ist frei.";
    }

    return BS(str);
}

public string detail_luecke() {
    if(!vial) return 0;

    return BS("Eine Luecke in der groesse einer kleinen Phiole ist zu erkennen. Die hat sich wohl jemand geschnappt.");
}

public int cmd_nimm(string str) {
    object ob;
    if(!str || str == "") return 0;
    if(str != "phiole" && str != "phiole aus regal") return 0;

    if(!vial) {
        write(BS("Gerade ist keine Phiole mehr da. Komm spaeter wieder."));
        return -1;
    }

    if(present("\ngwenshara_evil_cave_vial", TP)) {
        write(BS("Du hast schon so eine Phiole. Zwei brauchst du davon nicht."));
        return -1;
    }

    ob = clone_object(OBJ "vial");
    if(ob->move(TP, M_GET) != 1) {
        write(BS("Du kannst die Phiole gerade nicht tragen."));
        return -1;
    }

    write(BS("Du nimmst die leere Phiole aus dem Regal."));
    say(BS(TPN + " nimmt eine leere Phiole"));

    vial = 0;
    return 1;
}

public int cmd_kosten(string str) {
    notify_fail("Was willst du kosten?\n");
    if(!str || str == "") return 0;
    if(str != "suppe" && str != "von suppe" && str != "kessel" && str != "aus kessel") return 0;

    if(soup <= 0) {
        write(BS("Leider ist zu wenig uebrig, um davon zu kosten."));
        return -1;
    }

    TP->AddHp(25 + random(25));
    TP->AddSp(25 + random(25));
    TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN) - 2);
    soup--;

    write(BS("Du nimmst den Schoepfloeffel und kostest einen grossen Schluck von der Bruehe. "
             "Sie schmeckt nicht schlecht, mit einem leicht eisernen Nachgeschmack. Ein wenig "
             "Elfenohr im Abang..."));

    say(BS(TPN + " nimmt dem Schoepfloeffel und kostet einen grossen Schluck aus dem Kessel."));
    return 1;
}

public void reset() {
    ::reset();

    soup = 1 + random(3);
    vial = 1;
}
