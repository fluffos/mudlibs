#include "../def.h"

inherit ROOM "std_hoehle";

private int torOffen;

public void create() {
    ::create();

    SetProp(P_INT_SHORT, "Vor einem Tor in einer Hoehle");
    SetProp(P_INT_LONG, "Der Gang endet hier an einer breiten Hoehle. An der Nordwand ist ein schweres Metalltor, "
                        "uebermannsgross, in den Fels eingelassen. Es ist ueber und ueber mit arkanen Runen "
                        "des Schutzes ueberzogen, die Licht eines einzelnen Lichstrahls hell gluehen. @@tor_status@@");

    SetProp(P_LIGHT, 1);

    AddDetail( ({"licht", "lichtstrahls", "lichtstal", "sonnenlicht"}),
        "Durch die Decke dringt ein einzelner Strahl aus Sonnenlicht, der auf die Runen faellt und sie mit der "
        "Kraft der Sonne erhellt.");

    AddDetail( ({"sonne", "kraft"}),
        "Die Kraft der Sonne ist bekannt dafuer, dass sie Uebel und Unheil abhaelt.");

    AddDetail( ({"uebel", "unheil"}),
        "Seit jeher wird die Kraft der Sonne genutzt, um Uebel fernzuhalten. Vampire und Untote sind besonders "
        "anfaellig gegen sie.");

    AddDetail( ({"vampire", "untote"}),
        "Boesartige Kreaturen der Nacht werden oft durch Sonnenlicht gebannt oder geschwaecht.");

        AddDetail("boden", "Der Boden der Hoehle besteht aus grobem Stein.");

        AddDetail("decke", "Die Decke der Hoehle ist von dunklen Schatten durchzogen, die vom sanften Lichtstrahl der Sonne kaum beruehrt werden.");
        
        AddDetail(({"fels", "gestein"}), "Der Fels, der diese Hoehle umgibt, ist von grober Struktur und traegt Spuren vergangener Erosion.");
        
        AddDetail("gang", "Der Gang, durch den du gekommen bist, wirkt duester und unheimlich, als wuerde er Geschichten aus laengst vergessenen Zeiten erzaehlen.");
        
        AddDetail("hoehle", "Die Hoehle erstreckt sich weit und tief in den Felsen hinein, umgeben von geheimnisvoller Dunkelheit.");
        
        AddDetail("kreaturen", "Die Kreaturen, die diese Hoehle bewohnen, sind duestere Schatten vergangener Maechte, die im Zwielicht lauern.");
        
        AddDetail("lichstrahls", "Der Lichstrahl der Sonne erfuellt den Raum mit einem warmen Gluehen und enthuellt die geheimnisvollen Runen auf dem Metalltor.");
        
        AddDetail("metalltor", "Das Metalltor an der Nordwand ist massiv und scheint mit uralten Runen verziert zu sein.");
        
        AddDetail("nacht", "Die Nacht umgibt diese Hoehle mit ihrem dunklen Schleier, waehrend das Licht der Sonne versucht, sie zu durchbrechen.");
        
        AddDetail("nordwand", "Die Nordwand der Hoehle ist glatt und von einem grossen Metalltor dominiert, das mit magischen Runen bedeckt ist.");
        
        AddDetail("runen", "Die Runen, die das Metalltor bedecken, strahlen eine antike Macht aus, die darauf hindeutet, dass es sich um einen starken Schutz handelt.");
        
        AddDetail("schutzes", "Die Runen des Schutzes auf dem Tor wirken maechtig und undurchdringlich, als wuerden sie die Dunkelheit selbst zurueckweisen.");
        
        AddDetail("strahl", "Der Strahl des Sonnenlichts dringt durch eine Öffnung in der Decke und beleuchtet die Hoehle mit einem goettlichen Glanz.");
        
        AddDetail(({"waende", "wand"}), "Die Waende der Hoehle sind aus massivem Fels gehauen und tragen die Spuren von Jahrhunderten ungestoerter Natur.");

        AddDetail("dunkelheit", "Die Dunkelheit in der Hoehle wirkt beinahe undurchdringlich.");

        AddDetail("erosion", "Die Erosion hat im Laufe der Zeit markante Spuren im Fels hinterlassen.");

        AddDetail("geschichten", "Die Hoehle scheint voller Geschichten vergangener Zeiten zu sein, die in den Schatten der Felsen verborgen sind.");

        AddDetail("glanz", "Ein sanfter Glanz umhuellt den Raum, der von den reflektierenden Oberflaechen des Metalltors und den Runen verstaerkt wird.");

        AddDetail("gluehen", "Ein warmes Gluehen umgibt die arkanen Runen auf dem Metalltor, und es scheint, als wuerden sie mit eigener Kraft leuchten.");

        AddDetail("jahreszeiten", "Die Hoehle hat die Jahrhunderte unveraendert ueberdauert und traegt die Spuren vergangener Jahreszeiten und Wettereinfluesse.");

        AddDetail("lichstrahl", "Der Lichstrahl der Sonne dringt durch eine Öffnung in der Decke und erhellt die Hoehle mit seinem goettlichen Licht.");

        AddDetail("lichtstrahl", "Ein einzelner Lichtstrahl dringt durch eine Öffnung in der Decke und wirft ein helles Licht auf die Runen des Metalltors.");

        AddDetail("macht", "Die Macht der arkanen Runen auf dem Tor ist spuerbar.");

        AddDetail("maechte", "Duestere Maechte scheinen in den Schatten der Hoehle zu lauern, bereit, sich zu manifestieren.");

        AddDetail("natur", "Die Hoehle duester und kaum erhellt.");

        AddDetail("raum", "Der Raum in der Hoehle ist weitlaeufig und bietet genug Platz.");

        AddDetail("schatten", "Die Schatten in der Hoehle scheinen lebendig zu sein, sich bewegend und verschmelzend mit der Dunkelheit.");

        AddDetail("schleier", "Ein undurchsichtiger Schleier aus Dunkelheit umhuellt die Hoehle und laesst nur wenig Licht hindurch.");

        AddDetail("schutz", "Die Runen des Schutzes auf dem Tor wirken maechtig und undurchdringlich, als wuerden sie die Dunkelheit selbst zurueckweisen.");

        AddDetail("spuren", "Die Spuren von Erosion sind klar erkennbar.");

        AddDetail("stein", "Der Stein, aus dem die Hoehle besteht, ist grob und unregelmaessig.");

        AddDetail("struktur", "Die Struktur der Waende zeigt natuerliches Gestein.");

        AddDetail("tor", "Das Tor an der Nordwand ist mit geheimnisvollen Runen verziert ist.");

        AddDetail("zeiten", "Die Hoehle scheint unveraendert ueber die Zeiten hinweg zu bestehen.");

        AddDetail("zwielicht", "Das Zwielicht laesst alles etwas schummrig wirken.");

        AddDetail( ({"jahrhunderten", "jahrhunderte"}), "Ganz schoen viel Zeit.");


    AddExit("suedosten", ROOM "b6_a0");

    AddItem(NPC "todesritter", REFRESH_DESTRUCT);

    AddCmd( "lenke|reflektier|lenk|reflektiere&licht|sonnelicht|strahl|sonnenstrahl|lichtstrahl&auf|zu&ritter|todesritter|alsatar|paladin|untoten|untotem",
            "cmd_lenken", "Was willst du auf wen lenken?");
}

public int cmd_lenken() {
    object scherbe, npc;
    if(!objectp(scherbe=present("\ngwenshara_evil_cave_mirror_shards", TP))) {
        write(BS("Wenn du nur etwas passendes haettest, mit dem du das Licht lenken koenntest..."));
        return -1;
    }

    if(!objectp(npc=present("\ngwenshara_evil_cave_deathknight", TO))) {
        write(BS("Der ist ja gar nicht hier!"));
        return -1;
    }

    write(BS("Geschickt platzierst du die Scherben so im Raum, dass sie das Sonnenlicht auf Alastar lenken."));
    say(BS(TPN+" platziert ein paar Glassplitter so, dass sie das Sonnenlicht auf Alastar lenken"));
    scherbe->remove(1);

    npc->weakenByLight();
    return 1;
}

public string tor_status() {
    if(torOffen) return "Das Tor an der Nordwand ist geoeffnet.";
    return "Das Tor an der Nordwand ist fest versiegelt.";
}

public void openDoor() {
    if(torOffen) return;
    torOffen = 1;
    tell_room(TO, BS("Die Runen am Tor leuchten golden auf. Langsam versinkt es im Boden."));
    AddExit("norden", ([
        EX_DEST: ROOM "seelenkaverne",
        EXG_ID: "\ngwenshara_evil_cave_deathknight",
        EXG_PLMSG: "Alsatar stellt sich dir in den Weg und reckt das Schwert in deine Richtung.\n",
        EXG_RMMSG: "Alsatar stellt sich @wem@ in den Weg.\n"
    ]));
    return;
}

public void closeDoor() {
    if(!torOffen) return;
    torOffen = 0;
    tell_room(TO, BS("Mit lautem krachen und knirschen Schiebt sich ein Metalltor vor den Durchgang um Norden."));
    RemoveExit("norden");
}

public void reset() {
    ::reset();
    closeDoor();
}