#include "../def.h"

inherit ROOM "std_gang";

private int haken;

public void create() {
    ::create();

    haken = 0;

    SetProp(P_INT_LONG, QueryProp(P_INT_LONG) + 
            "@@long_loch@@");

    SetProp(P_KILL_NAME, "Ein unvorsichtiger Sprung in ein Loch");

    AddDetail( ({"boden"}),
        "Im felsigen Boden gaehnt ein grosses Loch, sodass nur ein kleiner Sims "
        "rundherum frei bleibt.");

    AddDetail( ({"decke"}),
        "Die Decke ist mit zahlreichen spitzen Stalagtiten ueberwuchert.");

    AddDetail( ({"loch"}),
        "Unten im Loch herrscht gaehnende Dunkelheit. Ein widerlicher Gestank "
        "quillt daraus hervor und ab und zu hoerst du ein Grunzen daraus. Du bist "
        "dir sicher, dass sich dort unten etwas Grosses bewegt. Um mehr zu erkennen "
        "muesstest du da schon runter. Aber reinspringen ist wohl die duemmste "
        "Idee - es geht tief runter, und hoch kommst du dann auch nicht mehr.");

    AddDetail( ({"dunkelheit"}),
        "Finster, wie die Nacht.");

    AddDetail( ({"nacht"}),
        "Du schauderst bei dem Gedanken daran. Als waere die Nacht hier ganze nahe...");

    AddDetail( ({"gedanken"}),
        "Di kannst du nicht sehen, nur denken.");

    AddDetail( ({"grosses"}),
        "Irgendetwas grosses haust dort unten. Aber was es ist, kannst du nicht erkennen.");

    AddDetail( ({"stalagtiten", "gebilde", "felsgebilde"}),
        "Unzaehlige spitze Felsgebilde haengen von der Decke. Ein Stalaktit bildet sogar "
        "einen kruden Ring.");

    AddDetail( ({"sims"}),
        "Du stehst hier auf einem schmalen Sims, der um das Loch herum fuehrt.");

    AddSpecialDetail( ({"ring", "stalaktit"}), "detail_ring");

    AddDetail( ({"geschick"}),
        "Wenn du geschickt genug bist, sollte das kein Problem sein.");

    AddSound( ({"grunzen", "tier"}),
        "Klingt wie ein widerliches Tier.");

    AddSmell( ({"gestank"}),
        "Echt ekelhaft.");

    AddSpecialDetail( ({"haken"}), "detail_haken");
    AddSpecialDetail( ({"seil"}), "detail_seil");

    AddExit("osten", ROOM "b4_b5");

    AddCmd( "befestige|befestig|haenge|haeng|binde|bind&haken|seil|kletterseil&an|in|durch&stalaktit|stalaktiten|ring",
            "cmd_befestigen", "Was willst du woran befestigen?");
    AddCmd( "nimm|nehme&seil|haken|kletterseil", "cmd_seil_nehmen", "Was willst du nehmen?");
    AddCmd( "spring|spring&in|ins&loch", "cmd_springen", "Wohin willst du springen?");
    AddCmd( "kletter|klettere&in|ins|durch|nach&loch|unten", "cmd_klettern", "Wodurch willst du klettern?");
}

public int HasHaken() {
    return haken;
}

public int cmd_klettern() {
    if(!haken) {
        write(BS("Ohne eine Kletterhilfe wird das eher nix."));
        return -1;
    }

    this_player()->move(ROOM "ogerloch", M_GO, "durch das Loch", "klettert",
                        "klettert von oben herab");
    return 1;
}

public int cmd_springen() {
    call_other(ROOM "ogerloch", "???");

    write(BS("Mit einem Satz springst du durch das Loch nach unten."));
    say(BS(this_player()->Name(WER) + " springt mit einem grossen Satz durch das Loch nach unten."));
    if(this_player()->move(ROOM "ogerloch", M_NOCHECK|M_SILENT) != 1) {
        write(BS("Hm... hat nicht funktioniert. Du bist immer noch hier!"));
        return -1;
    }

    tell_room(find_object(ROOM "ogerloch"), BS(this_player()->Name(WER) + " faellt von oben herein."), 
             ({this_player()}));

    this_player()->do_damage(10+random(20));
    return 1;
}

public int cmd_seil_nehmen() {
    object seil; 

    if(!haken) {
        write(BS("Aber hier ist doch gar kein Seil!"));
        return -1;
    }

    seil = clone_object(OBJ "kletterseil");
    if(seil->move(this_player(), M_GET) != 1) {
        write(BS("Du kannst das Seil nicht tragen, also laesst du es haengen."));
        seil->remove(1);
        return -1;
    }

    write(BS("Du nimmst das Seil an dich."));
    say(BS(this_player()->Name(WER) + " nimmt das Seil von der Decke."));
    haken = 0;
    return 1;
}

public int cmd_befestigen() {
    object seil;

    if(haken) {
        write(BS("Da haengt schon ein Seil!"));
        return -1;
    }

    if(!objectp(seil=present("\ngwenshara_cave_rope", this_player()))) {
        write(BS("Hm. Du hast leider kein passendes Seil mit einem Haken dabei."));
        return -1;
    }

    write(BS("Geschickt haengst du den Haken des Kletterseils in dem Ring ein."));
    say(BS(this_player()->Name(WER) + " haengt mit einer geschickten Bewegung ein Kletterseil an die Decke."));

    seil->remove(1);
    haken = 1;
    return 1;
}



public string long_loch() {
    if(haken) {
        return "Ein Seil baumelt von der Decke in ein grosses, kreisrundes Loch, as im Boden gaehnt.";
    }

    return "Ein grosses, kreisrundes Loch gaehnt hier im Boden.";
}

public string detail_ring() {
    if(haken) {
        return BS("Jemand hat ein Seil mit einem Haken an dem Ring im Stalaktit befestigt.");
    }

    return  BS("Ein Stalaktit ist so gewachsen, dass sich ein etwa fingerdicker Ring gebildet hat. "
            "Mit etwas Geschick koennte man einen Haken daran befestigen.");
}

public string detail_haken() {
    if(haken) {
        return BS("Jemand hat ein Seil mit einem Haken an dem Ring im Stalaktit befestigt.");
    }

    if(present("\ngwenshara_cave_rope", this_player())) {
        return BS("Genau so ein Seil mit Haken, wie du dabei hast! Was fuer ein Zufall.");
    }

    return BS("Leider hast du keinen bei dir. Aber ein Haken und ein Seil wuerden reichen, um "
              "in das Loch zu klettern.");
}

public string detail_seil() {
    if(haken) {
        return BS("Das Seil baumelt in das Loch im Boden hinab. Du koenntest daran herunterklettern.");
    } 

    return BS("Leider hast du kein passendes dabei.");
}

public void OgerSuelze() {
    tell_room(TO, BS("Du hierst ein lautes Rumpeln und ein ekelhaftes Quatschen aus dem Loch. Dann herrscht Stille."));
    return;
}