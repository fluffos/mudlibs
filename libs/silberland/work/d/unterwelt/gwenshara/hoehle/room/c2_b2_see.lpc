#include "../def.h"
#include <npcmaster.h>

inherit ROOM "std_hoehle";

int angel, hammer, troll;
object *angler;

public void create() {
    ::create();

    SetProp(P_INT_SHORT, "Das Ufer eines unterirdischen Sees");
    SetProp(P_INT_LONG, "Du stehst hier in einer weiten Hoehle, die sich zu einem grossen unterirdischen "
                        "See ausbreitet. Hoch an der Decke haengen grosse Stalaktiten, von den ab und an "
                        "ein Tropfen in die glatte Oberflaeche des Sees faellt. Weiter draussen, mitten in "
                        "dem See kannst du die Umrisse eines Felsens erkennen. Das Wasser schwappt gelegentlich "
                        "an den Fels, der hier den Boden ausmacht.");

    AddDetail( ({"tisch", "schminktisch"}),
        "Der Schminktisch ist aus einem dunklen Holz gemacht. Auf ihm stehen ein paar Pinsel, "
        "Flaeschchen, ein grosser Spiegel und ein Kelch.");

    AddSpecialDetail( ({"angel"}), "detail_angel");
    AddSpecialDetail( ({"skelett"}), "detail_skelett");
    AddSpecialDetail( ({"tasche"}), "detail_tasche");
    AddSpecialDetail( ({"hammer", "meissel"}), "detail_hammer");

    AddDetail( ({"oberflaeche", "wasseroberflaeche"}),
        "Die Wasseroberflaeche ist meistens komplett klar. Wenn ein Tropfen das Wasser beruehrt, dann schickt "
        "er sanfte Wellen hindurch. Das Wasser ist so glasklar, dass du direkt vor dir, knapp unter der Wasseroberflaeche "
        "ein Skelett sehen kannst.");

    AddDetail( ({"felsen", "felsens", "umrisse"}),
        "Draussen am See kannst du die Umrisse eines grossen Felsens erkennen. Es sieht aus wie eine kleine Insel.");

    AddDetail( ({"insel"}),
        "Der einzelne Felsen dort draussen blidet eine kahle Insel. Du meinst dort draussen Bewegungen zu erkennen.");

    AddDetail( ({"bewegungen"}),
        "Tatsaechlich scheint sich dort etwas Grosses zu bewegen.");

    AddDetail( ({"grosses"}),
        "Es sieht aus, wie ein gigantischer Troll mit langen Hoernern.");

    AddDetail( ({"troll"}),
        "Der Troll sieht sehr gefaehrlich und brutal aus. Du koenntest wohl seine Aufmerksamkeit erregen.");

    AddDetail( ("aufmerksamkeit"),
        "Du koenntest versuchen zur Insel hinueber zu rufen, wenn du es wirklich willst...");

    AddDetail(({ "boden" }),
        "Der Boden der Hoehle ist aus grobem, unebenem Fels, glatt poliert von den Jahren, die das Wasser hier entlang geflossen ist.");
    
    AddDetail(({ "decke" }),
        "Die Decke der Hoehle ist hoch und gewoelbt, uebersaet mit grossen Stalaktiten, die wie messerscharfe Zaehne herabhaengen.");
    
    AddDetail(({ "fels", "felsen" }),
        "Die Felsen bilden die Struktur der Hoehle, manche glatt und nass von Wasser, andere rau und uneben.");
    
    AddDetail(({ "hoehle" }),
        "Die Hoehle ist weit und offen, mit einem unterirdischen See in ihrer Mitte. Sie ist von dunklem Fels umgeben und von Stalaktiten geschmueckt.");
    
    AddDetail(({ "hoernern" }),
        "Die Hoerner des Trolls sind lang und gekruemmt, scharf wie Dolche und gefaehrlich nah.");
    
    AddDetail(({ "see" }),
        "Der unterirdische See erstreckt sich weit und tief, sein Wasser ruhig und klar.");
    
    AddDetail(({ "stalaktiten" }),
        "Die Stalaktiten haengen hoch an der Decke.");
    
    AddDetail(({ "tropfen" }),
        "Gelegentlich fallen Tropfen von den Stalaktiten hoch oben an der Decke, platschen leise in den See und erzeugen sanfte Wellen.");
    
    AddDetail(({ "waende", "wand" }),
        "Die Waende der Hoehle sind aus glattem Fels, feucht von Wasser, das hier entlangfliesst.");
    
    AddDetail(({ "wasser" }),
        "Das Wasser des Sees ist klar und ruhig, spiegelt die Umgebung wider und laesst den Grund darunter erkennen.");
    
    AddDetail(({ "wellen" }),
        "Wellen durchziehen gelegentlich die glatte Oberflaeche des Sees, wenn ein Tropfen das Wasser beruehrt.");
    
    AddDetail(({ "dolche" }),
        "Die Hoerner des Trolls sind so scharf und gekruemmt, dass sie wie Dolche aussehen, bereit, jeden Gegner zu durchbohren.");
    
    AddDetail(({ "grund", "seegrund", "seegrundes" }),
        "Der Grund des Sees ist von Dunkelheit verschluckt, und doch kannst du die Umrisse von Felsen und Pflanzen erkennen, die dort unten liegen.");
    
    AddDetail(({ "hoerner" }),
        "Die langen, gebogenen Hoerner des Trolls sind eine beeindruckende, wenn auch gefaehrliche Erscheinung.");
    
    AddDetail(({ "jahren" }),
        "Die Hoehle ist von vielen Jahren geformt worden.");
    
    AddDetail(({ "mitte" }),
        "Die Mitte des Sees ist von einem einzelnen Felsen gekroent, der wie eine Insel aus der glatten Oberflaeche ragt.");
    
    AddDetail(({ "struktur" }),
        "Die Struktur der Hoehle ist natuerlich, mit glatten Waenden und natuerlichen Formationen.");
    
    AddDetail(({ "umgebung" }),
        "Die Umgebung der Hoehle ist still und unberuehrt, nur das leise Plaetschern des Wassers und das Echo deiner eigenen Schritte stoeren die Stille.");
    
    AddDetail(({ "zaehne" }),
        "Die Stalaktiten an der Decke sehen aus wie scharfe Zaehne, die jeden Eindringling bedrohlich empfangen.");
    
    AddDetail(({ "dunkelheit" }),
        "Die Dunkelheit des Seegrundes ist undurchdringlich.");
    
    AddDetail(({ "echo" }),
        "Deine Schritte erzeugen ein Echo, das durch die Hoehle hallt.");
    
    AddDetail(({ "eindringling" }),
        "Die Stalaktiten sehen aus wie gefaehrliche Waffen, bereit, jeden Eindringling abzuwehren.");
    
    AddDetail(({ "erscheinung", "gestalt" }),
        "Die Erscheinung des Trolls ist beeindruckend, seine Gestalt wirkt bedrohlich und dominant.");
    
    AddDetail(({ "formationen" }),
        "Die Formationen an den Waenden der Hoehle sind ein wundersames Spiel aus Schatten, geformt ueber viele Jahre hinweg.");

    AddDetail( ({"jahre", "zeit"}), "Eine lange Zeit.");
    
    AddDetail(({ "gegner" }),
        "Der Troll ist ein gefaehrlicher Gegner, und du solltest dich hueten, seinen Zorn zu erregen.");
    
    AddDetail(({ "pflanzen" }),
        "Einige Pflanzen haben sich am Grund des Sees angesiedelt und wiegen sich sanft.");
    
    AddDetail(({ "plaetschern" }),
        "Das Plaetschern des Wassers des Sees ist beruhigend.");
    
    AddDetail(({ "schritte" }),
        "Deine Schritte hallen durch die Hoehle.");
    
    AddDetail(({ "stille" }),
        "Die Stille der Hoehle ist fast greifbar.");

    AddDetail(({ "schatten" }),
        "Die Schatten tanzen entlang der Waende.");
    
    AddDetail(({ "waffen" }),
        "Die Stalaktiten an der Decke sehen aus wie gefaehrliche Waffen, bereit, jeden Eindringling abzuwehren.");
    
    AddDetail(({ "zorn", "wut", "augen" }),
        "Der Zorn des Trolls ist furchterregend, seine Augen glimmen vor Wut, als er sich auf dich zu bewegt.");
    
    
    AddExit("westen", ROOM "c1_b2");

    angel = hammer = troll = 1;
    angler = ({ });

    AddCmd("nimm|nehme&angel", "cmd_angel");
    AddCmd("nimm|nehme&hammer|meissel|hammer und meissel", "cmd_hammer");
    AddCmd("rufe|ruf&zu|zur|zum&insel|felsen|troll", "cmd_rufen", "Wohin willst du rufen?");
    AddCmd("angel|angle&in|im&see|wasser", "cmd_angeln_im_see", "Wo willst du angeln?");
}

public int cmd_angeln_im_see() {
    object weapon;
    int t;

    weapon = TP->QueryProp(P_WEAPON);
    if(!objectp(weapon)) {
        write(BS("Ohne Angel kannst du nicht angeln."));
        return -1;
    }

    if(!weapon->id("angel")) {
        write(BS("Ohne Angel kannst du nicht angeln."));
        return -1;
    }

    write(BS("Du wirfst die Angel aus und wartest..."));
    say(BS(TPN+" wirft die Angel aus und wartet..."));

    angler += ({TP});
    
    t = 5+random(10);
    call_out("angel_result", t, TP);
    TP->SetProp(P_PARALYZED, ([
        PARALYZE_TIME: t,
        PARALYZE_MSG: "Du angelst doch gerade!\n",
        PARALYZE_MSG_OTHER: "%s angelt gemuetlich.\n"
    ]));

    return 1;
}

public void angel_result(object pl) {
    string msg;
    object ob;

    if(member(angler, pl) < 0) return;
    if(!objectp(pl)) return;

    angler -= ({pl});
    pl->SetProp(P_PARALYZED, 0);

    switch(random(10)) {
        case 0 .. 5: 
            msg = "Nichts haengt daran.";
            break;
        case 7 .. 9:
            msg = "Eine Muenze haengt dran.";
            pl->AddMoney(1);
            break;
        default:
            msg = "Ein gewalter Wels haengt daran und reisst sich los!";
            ob = clone_object(NPC "wels");
            ob->move(TO, M_GO);
            break;
    }

    tell_object(pl, BS("Mit einem Ruck ziehst du die Angel heraus. "+msg));
    tell_room(TO, BS(pl->Name(WER)+" zieht die Angel mit einem Ruck aus dem Wasser. "+msg), ({pl}));
    return;
}

public int cmd_rufen() {
    if(!troll || find_living("angradur")) {
        write(BS("Nichts passiert. Du hast dich wohl geirrt."));
        return -1;
    }

    write(BS("Du rufst laut zur Insel hinueber."));
    say(BS(TPN+" ruft laut irgendeinen Bloedsinn."));
    troll = 0;
    call_out("troll_sequence", 0, 0);
    return 1;
}

public void troll_sequence(int step) {
    object ob;

    if(step > 3) {
        ob = clone_object(NPC "angradur");
        ob->move(TO, M_GO);
        return;
    }

    switch(step) {
        case 0: tell_room(TO, BS("Du hoerst ein lautes Bruellen von dem Felsen im See. Ohoh! Ob das eine gute Idee war?")); break;
        case 1: tell_room(TO, BS("In der Mitte des Sees siehst du einen rieseigen, wuetenden Troll ins Wasser springen.")); break;
        case 2: tell_room(TO, BS("Mit schnellen Schwimmzuegen pfluegt der Troll durch das Wasser. Du solltest besser verschwinden!")); break;
        case 3: tell_room(TO, BS("Jeden Moment hat er das Ufer erreicht. Du kannst due Wut in den Augen des Monsters sehen!")); break;
    }

    call_out("troll_sequence", 4+random(4), ++step);
    return;
}

public int cmd_angel() {
    object ob;

    if(!angel) {
        write(BS("Leider ist keine Angel da. Wie kommst du denn auf sowas?"));
        return -1;
    }

    ob = clone_object("/p/weapon/spear/angel");
    if(ob->move(TP, M_GET) != 1) {
        write(BS("Du kannst die Angel gerade nicht tragen und laesst sie liegen."));
        ob->remove(1);
        return -1;
    }

    angel = 0;
    write(BS("Du nimmst die Angel aus dem Wasser."));
    say(BS(TPN+" holt eine Angel aus dem Wasser."));
    return 1;
}

public int cmd_hammer() {
    object ob;

    if(!hammer) {
        write(BS("Leider sind gerade weder Hammer noch Meissel da. Wie kommst du denn auf sowas?"));
        return -1;
    }

    ob = clone_object(WEAPON "hammer_meissel");
    if(ob->move(TP, M_GET) != 1) {
        write(BS("Du kannst Hammer und Meissel gerade nicht tragen und laesst sie liegen."));
        ob->remove(1);
        return -1;
    }

    hammer = 0;

    write(BS("Du nimmst Hammer und Meissel aus der Tasche."));
    say(BS(TPN+" fischt Hammer und Meissel aus dem See."));

    return 1;
}

public string detail_tasche() {
    if(hammer) {
        return BS("In der Tasche erkennst du einen Hammer samt Meissel.");
    }

    return BS("Leider ist die Tasche komplett leer.");
}

public string detail_hammer() {
    if(hammer) {
        return BS("Den Hammer und Miessel koennte man sicher noch gebrauchen.");
    }

    return 0;
}

public string detail_angel() {
    if(angel) {
        return BS("Direkt neben der Hand des Skeletts liegt eine Angel im Wasser. Du koenntest sie nehmen, wenn du sie brauchst.");
    }
    return 0;
}

public string detail_skelett() {
    string str;

    str = "Knapp unter der Wasseroberflaeche erkennst du ein Skelett. An seiner Huefte haengt noch eine Tasche.";

    if(angel) {
        str += " Neben der Hand des Skeletts liegt eine alte Angel.";
    }

    return BS(str);
}

public void reset() {
    ::reset();
    angel = hammer = troll = 1;
}