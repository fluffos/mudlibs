#include "../def.h"

inherit ROOM "std_drider";

private int spider;

public void create() {
    ::create();
    spider = 1;

    SetProp(P_INT_LONG, 
            "Du befindest dich am noerdlichen Ende des Spinnennetzes. Fuenf dicke "
            "Faeden kleben das grosse Konstrukt des Netzes hier an die Hoehlenwand. "
            "Ab und zu geht eine zuckende Vibration durch das Netz, auf dem du stehst, "
            "wennn sich irgendwo in der Ferne etwas bewegt.");

    AddDetail( ({"boden"}),
        "Der Boden wird hier von einem riesigen Spinnennetz gebildet.");

    AddDetail( ({"decke"}),
        "Die Decke der Hoehle ist irgendwo weit ueber dir.");

    AddDetail( ({"ende"}),
        "Hier befindest du dich am noerdlichen Ende des Netzes.");

    AddDetail( ({"netz", "netzes", "spinnennetz", "spinnenetzes"}),
        "Die gesamte Hoehle ist von einem riesigen Spinnennetz bedeckt. Es ist so dick "
        "und fest verwoben, dass du problemlos darauf gehen kannst. Du solltest nur "
        "aufpassen, dass du nicht irgendwo kleben bleibst.");

    AddDetail( ({"faeden"}),
        "Fuenf dicke Faeden halten hier das Konstrukt des Spinnenetzes an der Wand. "
        "Die fuenf Punkte kleben fast schon gleichmaessig an der Wand.");

    AddDetail( ({"konstrukt"}),
        "Das Netz in dieser Hoehle ist ein gewaltiges Konstrukt.");

    AddDetail( ({"wand", "hoehlenwand"}),
        "Die Hoehlenwand hier ist rau und ungleichmaessig. Nur dort, wo die fuenf Faeden "
        "angeklebt sind scheint sie einigermassen glatt.");

    AddDetail( ({"vibrationen", "vibration"}),
        "Wenn sich irgendwo, an einer anderen Stelle des Netzes, etwas bewegt, spuerst "
        "du das bis hier her.");

    AddDetail( ({"ferne"}),
        "Das Netz ist so gross, dass man durchaus von einer gewissen Ferne sprechen kann.");

    AddDetail( ({"punkte", "klebepunkte", "ecken"}),
        "Mit etwas Fantasie bilden die Klebepunkte die Ecken einer Art Pentagramm.");

    AddDetail( ({"hoehle"}),
        "Die Hoehle, in der du dich hier befindest, scheint natuerlich entstanden zu sein. ");

    AddDetail( ({"stellle"}),
        "Du hast in diesem Netz schon ein paar Stellen gesehen, wo etwas festgeklebt ist.");

    AddDetail( ({"art"}),
        "Soetwas aehnliches wie ein Pentagramm, aber eben nicht genauso.");

    AddDetail( ({"pentagramm"}),
        "Die fuenf Punkte bilden die Ecken und einige herumhaengende Faeden koennten die seiten sein. "
        "In der Mitte waere dann eine glatte Stelle.");

    AddDetail( ({"mitte", "stelle"}),
        "Wenn du es genau betrachtest ist die Mitte des 'Pentagramms' komplett glatt. Was wohl "
        "passiert, wenn man sie beruehrt?");

    AddDetail( ({"loch"}),
        "Das Loch hast du zuerst gar nicht als solches identifiziert, sondern fuer eine besonders "
        "glatte Stelle an der Wand gehalten! Es ist etwa einen Meter im Durchmesser. Vielleicht "
        "kannst du hineinschauen?");

    AddDetail( ({"in loch", "durch loch"}),
        "Im Inneren des Lochs erkennst du die Ueberreste eines wohl gerade ebenen verstorbenen "
        "Driders. Seine Beine zucken noch ein wenig und ekelhaftes Gift tropft von seinen Mandibeln.");

    AddDetail( ({"ueberreste", "driders"}),
        "Es sieht so aus, als waere diese Kreatur gerade erst gestorben.");

    AddDetail( ({"beine", "spinnenbeine"}),
        "Die acht langen Spinnenbeine zucken noch ein wenig. Gefaehrlich duerfte der nicht mehr werden.");

    AddDetail( ({"gift", "mandibel", "mandibeln", "dridergift"}),
        "Gruenliches Gift tropft langsam von den Mandibeln des Driders. Wenn du ein passendes Gefaess "
        "dabei haettest, waere es der ideale Zeitpunkt, um Dridergift zu melken!");

    AddDetail( ({"gefaess", "phiole"}),
        "Soetwas wie eine Phiole vielleicht?");

    AddDetail( ({"zeitpunkt"}),
        "Genau jetzt.");

    AddExit("suedosten", ROOM "c3_a7_drider");
    AddExit("suedwesten", ROOM "c1_a7_drider");
    AddExit("sueden", ROOM "c2_a7_drider");

    AddCmd( ({"beruehre", "beruehr"}), "cmd_beruehren");
    AddCmd( ({"melke", "melk"}), "cmd_melken");
    AddCmd( ({"schau", "schaue"}), "cmd_schauen");
}

public int cmd_schauen(string str) {
    if(str != "in loch") return 0;
    write(BS(GetDetail("in loch")));
    return 1;
}

public int cmd_melken(string str) {
    object vial;
    notify_fail("Was willst du melken?\n");
    if(!str || str == "") return 0;
    if(member(({"gift", "drider", "dridergift"}), str) < 0) return 0;

    if(!objectp(vial=present("\ngwenshara_evil_cave_vial", TP))) {
        write(BS("Leider hast du kein passendes Gefaess dabei!"));
        return -1;
    }

    if(vial->IsFilled()) {
        write(BS("Du hast bereits eine gefuellte Phiole!"));
        return -1;
    }

    write(BS("Du faengst einige der Tropfen Dridergift in der Phiole auf."));
    vial->SetFilled();
    return 1;
}

public int cmd_beruehren(string str) {
    notify_fail("Was willst du beruehren?\n");
    if(!str || str == "") return 0;
    if(str != "mitte" && str != "stelle" && str != "pentagramm") return 0;

    write(BS("Vorsichtig beruehrst du die glatte Stelle an der Wand... und stellst fest, dass "
             "es sich gar nicht um eine Wand, sondern ein Loch handelt, das du in der Dunkelheit "
             "nicht gesehen hast!"));
    say(BS(TPN + " beruehrt die Wand."));
    return 1;
}
