#include "../def.h"

inherit ROOM "std_hoehle";

public varargs object createCocoon(string load) {
    object ob;
    ob = clone_object(OBJ "kokon");
    ob->move(TO, M_NOCHECK|M_SILENT);
    if(stringp(load)) {
        ob->SetLoad(load);
    }

    return ob;
}

public string isKokon(object ob) {
    return ob->id("\ngwenshara_evil_cave_cocoon");
}

public void checkCocoons() {
    int nr, i;
    object *ob;
    nr = random(3);
    
    ob = filter_array(all_inventory(), "isKokon");
    if(sizeof(ob) >= nr) return;

    for(i=0; i<(nr-sizeof(ob)); ++i) {
        createCocoon();
    }

    return;
}

public void create() {
    ::create();

    SetProp(P_SHORT, "In einem grossen Spinnenetz");
    SetProp(P_LIGHT, 0);
    SetProp(P_INDOORS, 1);
    SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:20, ENV_TERRAIN:TT_CAVE ]) );

    checkCocoons();
}



public void reset() {
    ::reset();
    checkCocoons();
}
