#include "../def.h"

inherit ROOM "std_hoehle";

int trauben;

public void create() {
    ::create();

    SetProp(P_INT_SHORT, "Ein unterirdischer Garten");
    SetProp(P_INT_LONG, "In diesem Teil des unterirdischen Gartens winden sich hohe Weinranken "
                        "an dunklen Staemmen nach oben. Die Erde wurde hier offenbar frisch "
                        "aufgewuehlt und neuer Duenger verteilt. Schwarze Trauben glaenzen saftig "
                        "auf den Reben. Oestlich von hier befindet sich ein dicker Vorhang aus "
                        "Blumen, der in eine kleine Hoehle fuehrt.");

    AddExit("westen", ROOM "c0_b4_garten");
    AddExit("osten", ROOM "wohnhoehle");

    AddCmd("pfluecke|pflueck&traube|trauben|reben", "cmd_pfluecken", "Was willst du pfluecken?");

    AddDetail(({"blumen", "pflanzen"}), "Ein dicker Vorhang aus bunten Blumen schmueckt den Eingang zu einer kleinen Hoehle.");

    AddDetail(({"boden"}), "Der Boden hier wurde frisch aufgewuehlt und scheint mit neuem Duenger versorgt worden zu sein.");

    AddDetail(({"decke"}), "Ueber dir erstreckt sich eine dunkle Decke, die den Raum abschliesst.");

    AddDetail(({"duenger"}), "Ein frischer Duft von Duenger liegt in der Luft, der darauf hindeutet, dass der Boden mit Naehrstoffen versorgt wurde.");

    AddDetail(({"erde"}), "Die Erde hier scheint frisch aufgelockert und bereit fuer neues Pflanzenwachstum zu sein.");

    AddDetail(({"gartens", "garten", "ort"}), "Dieser Teil des unterirdischen Gartens ist reich an lebendigem Gruen und voller saftiger Fruechte.");

    AddDetail(({"hoehle"}), "Die kleine Hoehle oestlich von hier laedt zu Erkundungen ein und ist von einem Vorhang aus Blumen verdeckt.");

    AddDetail(({"reben"}), "Hohe Weinreben winden sich an dunklen Staemmen empor und tragen saftige, schwarze Trauben.");

    AddDetail(({"staemmen"}), "Die dunklen Staemme der Weinreben geben diesem Teil des Gartens eine gewisse Schwere und Substanz.");

    AddDetail(({"teil"}), "Dieser Teil des unterirdischen Gartens ist besonders ueppig und lebendig.");

    AddDetail(({"trauben"}), "Saftige, schwarze Trauben glaenzen verlockend an den Weinreben, bereit zur Ernte.");

    AddDetail(({"vorhang"}), "Ein dicker Vorhang aus Blumen verdeckt den Eingang zu einer kleinen Hoehle oestlich von hier.");

    AddDetail(({"waende", "wand"}), "Die Waende des Gartens sind mit Weinranken bedeckt.");

    AddDetail(({"weinranken"}), "Hohe Weinranken schlaengeln sich an den Waenden empor und tragen saftige Trauben.");

    AddDetail(({"duft", "dueften"}), "Ein betoerender Duft von frischem Gruen und Blumen liegt in der Luft und erfuellt den Raum.");

    AddDetail(({"eingang"}), "Der Eingang zur kleinen Hoehle oestlich von hier ist von einem Vorhang aus bunten Blumen verdeckt.");

    AddDetail(({"erkundungen"}), "Die Hoehle oestlich von hier laedt zu spannenden Erkundungen ein, hinter dem Vorhang aus Blumen.");

    AddDetail(({"ernte"}), "Die saftigen Trauben an den Weinreben sind bereit zur Ernte und versprechen einen koestlichen Genuss.");

    AddDetail(({"fruechte"}), "Der Garten ist reich an saftigen Fruechten, besonders die schwarzen Trauben an den Weinreben fallen ins Auge.");

    AddDetail(({"gruen"}), "Der Garten ist voller lebendigem Gruen.");

    AddDetail(({"luft"}), "Die Luft hier ist frisch und rein, erfuellt mit einem Hauch von Duft und Lebensenergie.");

    AddDetail(({"naehrstoffen"}), "Die Erde scheint reich an Naehrstoffen zu sein, was auf ein gesundes Pflanzenwachstum hindeutet.");

    AddDetail(({"pflanzenwachstum"}), "Die frisch aufgelockerte Erde und der Duft von Duenger lassen auf ein ueppiges Pflanzenwachstum schliessen.");

    AddDetail(({"raum"}), "Dieser Raum ist ein kleiner Ausschnitt eines ueppigen unterirdischen Gartens, reich an Leben und Farben.");

    AddDetail(({"schwere"}), "Die dunklen Staemme der Weinreben verleihen diesem Teil des Gartens eine gewisse Schwere und Standhaftigkeit.");

    AddDetail(({"staemme"}), "Die dunklen Staemme der Weinreben erheben sich hoch und geben dem Garten eine solide Struktur.");

    AddDetail(({"substanz"}), "Die Weinreben verleihen diesem Garten eine Substanz und Fuelle, die ihn von anderen unterscheidet.");

    AddDetail(({"weinreben"}), "Hohe Weinreben winden sich an den Staemmen empor und tragen saftige Trauben, die den Garten beleben.");

    AddDetail(({"auge"}), "Der Garten ist eine voller Farben und Leben.");

    AddDetail(({"ausschnitt", "pracht"}), "Dieser Teil des Gartens ist nur ein kleiner Ausschnitt von der gesamten Pracht, die ihn umgibt.");

    AddDetail(({"farben"}), "Der Garten ist voll mit bunten Blumen und saftigen Fruechten.");

    AddDetail(({"fuelle", "paradies"}), "Der Garten strahlt vor Fuelle und Leben, ein Paradies unter der Erde.");

    AddDetail(({"garten"}), "Dieser unterirdische Garten ist ein Ort reich an Pflanzen und Leben.");

    AddDetail(({"genuss"}), "Die saftigen Trauben versprechen einen koestlichen Genuss fuer diejenigen, die sie ernten.");

    AddDetail(({"hauch", "frische"}), "Ein sanfter Hauch von Frische und Duft erfuellt den Raum und belebt die Sinne.");

    AddDetail(({"sinne"}), "Deine Sinne sind von all den Dueften ueberwaeltigt.");

    AddDetail(({"leben"}), "Der Garten ist erfuellt von pulsierendem Leben.");

    AddDetail(({"lebensenergie"}), "Eine spuerbare Lebensenergie durchdringt den Garten.");

    AddDetail(({"standhaftigkeit"}), "Die Weinreben zeigen eine bemerkenswerte Standhaftigkeit, waehrend sie sich emporwinden und ihre Fruechte tragen.");

    AddDetail(({"struktur"}), "Die Struktur des Gartens wird von den dunklen Staemmen der Weinreben gebildet, die ihm Stabilitaet verleihen.");

    AddDetail(({"stabilitaet"}), "Die Weinreben scheinen extrem dick, saftig und lebendig.");


    trauben = 1;
}

public int cmd_pfluecken() {
    object ob;

    if(objectp(present("\nrebenmonster"))) {
        write(BS("Es sieht nicht so aus, als wuerden die Reben die Trauben freiwillig hergeben!!!"));
        return -1;
    }

    if(!trauben) {
        write(BS("Es wurden schon alle Reben abgeerntet."));
        return -1;
    }

    ob = clone_object(NPC "schwarzer_wein");
    ob->move(TO, M_GO|M_SILENT);

    write(BS("Du greifst nach den Trauben und ploetzlich schlaegt dir eine der Weinreben ueber die Hand. Offenbar "
             "sind diese Pflanzen lebendig!"));
   say(BS("Gerade als "+TPN+" nach den glaenzenden schwarzen Trauben greifen will beginnt sich die Weinrebe zu bewegen!"));
   trauben = 0;
   return 1;
}

public void reset() {
    ::reset();
    trauben = 1;
}
