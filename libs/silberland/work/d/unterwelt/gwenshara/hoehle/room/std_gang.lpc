#include "../def.h"

inherit ROOM "std_hoehle";

int haspilz;

public void create() {
    ::create();

    DETAILMASTER->Customize(this_object());

    if(!random(3)) {
        AddItem(({
            NPC "drider", 
            NPC "chrioptean_marauder",
            NPC "fledermaus",
            NPC "gloomstalker",
            NPC "hungry_dead",
            NPC "nachtzauberer",
            NPC "ogre_sevant",
            NPC "ratte",
            NPC "seele",
            NPC "gibbering_mouther",
            NPC "schleicher"
        }), REFRESH_DESTRUCT);
    }

    if(stringp(GetDetail("pilze"))) {
        haspilz = 1;
        AddCmd("pfluecke|pflueck|sammel|sammle&pilz|pilze|gluehende pilze|gluehenden pilz", "cmd_pilz", "Was willst du pfluecken?");
    }
}

public int cmd_pilz() {
    object pilz;
    if(!haspilz) {
        write(BS("Hier ist leider kein guter Pilz mehr."));
        return -1;
    }

    pilz = clone_object(OBJ "glutkappe");
    if(pilz->move(TP, M_GET) != 1) {
        write(BS("Du wuerdest gernen einen der Pilze pfluecken, kannst ihn aber gerade nicht tragen."));
        pilz->remove(1);
        return -1;
    }

    write(BS("Du pflueckst einen der gluehenden Pilze."));
    say(BS(TPN+" pflueckt einen der gluehenden Pilze."));
    haspilz = 0;
    return 1;
}

public void reset() {
    ::reset();
 
    if(stringp(GetDetail("pilze"))) {
        haspilz = 1;
    }
}