#include "../def.h"

inherit ROOM "std_hoehle";

private int erloest;

public void create() {
    ::create();
    erloest=0;

    SetProp(P_INT_SHORT, "In einer Studierhoehle");
    SetProp(P_INT_LONG, 
            "Diese Hoehle ist von gruenlichem Leuchten erfuellt, das von "
            "skelettierten Schaedeln, die wie Laternen von der Decke haengen "
            "ausgeht. An den Waenden wurden Regale errichtet, die mit unzaehligen "
            "Buechern und Schriftrollen vollgestellt sind. Einige Buecher "
            "wurden auf einem schweren Tisch in der MItte gestapelt, der sich "
            "vor einem silbernen Heptagramm im Boden erhebt.");
    SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:5, ENV_TERRAIN:TT_CAVE ]) );

    SetProp(P_LIGHT, 1);

    AddExit("sueden", ROOM "b2_b2_hexer");
    AddExit("suedwesten", ROOM "b1_b2_hexer");

    AddItem(NPC "hexe", REFRESH_DESTRUCT);

    AddDetail(({"boden"}), "Der Boden der Hoehle ist mit einem silbernen Heptagramm verziert, das im schwachen Licht glitzert.");

    AddDetail(({"buecher"}), "Die Buecher auf den Regalen und dem Tisch scheinen eine Vielzahl von Themen abzudecken, von dunkler Magie bis hin zu verbotenen Ritualen.");

    AddDetail(({"buechern"}), "Die Regale sind vollgestellt mit unzaehligen Buechern, die verstaubt und vergilbt sind.");

    AddDetail(({"decke"}), "Von der Decke haengen skelettierte Schaedel, die ein gruenliches Licht ausstrahlen und die Hoehle mit einem gespenstischen Gluehen erfuellen.");

    AddDetail(({"heptagramm"}), "Das silberne Heptagramm auf dem Boden scheint eine rituelle Bedeutung zu haben, umgeben von mysterioesen Symbolen und Runen.");

    AddDetail(({"hoehle"}), "Die Hoehle ist von einem unheimlichen gruenlichen Leuchten erfuellt, das von den skelettierten Schaedeln an der Decke ausgeht.");

    AddDetail(({"laternen"}), "Die skelettierten Schaedel dienen als Laternen und werfen ein gespenstisches Licht in die Hoehle.");

    AddDetail(({"leuchten"}), "Ein gruenliches Leuchten erfuellt die Hoehle, das von den skelettierten Schaedeln ausgeht und alles mit einem gespenstischen Glanz ueberzieht.");

    AddDetail(({"mitte"}), "Ein schwerer Tisch steht in der Mitte der Hoehle, auf dem stapeln sich Buecher, als ob sie fuer eine zeremonielle Handlung bereitliegen.");

    AddDetail(({"regale"}), "Die Regale an den Waenden sind mit einer Vielzahl von Buechern und Schriftrollen vollgestellt, die bis zum Rand mit altem Wissen gefuellt sind.");

    AddDetail(({"schaedeln"}), "Die skelettierten Schaedel an der Decke scheinen stumme Waechter zu sein, die ueber die Geheimnisse der Hoehle wachen.");

    AddDetail(({"schriftrollen"}), "Zwischen den Buechern auf den Regalen sind auch Schriftrollen zu finden, die mit alten Symbolen und Runen bedeckt sind.");

    AddDetail(({"tisch"}), "Ein schwerer Tisch steht in der Mitte der Hoehle, auf dem Buecher und Schriftrollen liegen, als ob sie fuer eine zeremonielle Handlung bereitliegen.");

    AddDetail(({"waende"}), "Die Waende der Hoehle sind mit Regalen bedeckt, die bis unter die Decke reichen und eine Fuelle von Wissen tragen.");

    AddDetail(({"wand"}), "Die Waende der Hoehle sind mit Regalen bedeckt, auf denen Buecher und Schriftrollen in geheimnisvoller Ordnung angeordnet sind.");

    AddDetail(({"bedeutung"}), "Das silberne Heptagramm auf dem Boden scheint eine tiefe rituelle Bedeutung zu haben, vielleicht im Zusammenhang mit dunkler Magie oder alten Ritualen.");

    AddDetail(({"fuellle"}), "Die Regale sind randvoll mit Buechern und Schriftrollen, die eine Fuelle von Wissen und Geheimnissen bergen.");

    AddDetail(({"geheimnisse"}), "Die Hoehle scheint voller Geheimnisse zu sein, die in den Buechern und Schriftrollen verborgen sind, bereit darauf, von einem wissbegierigen Geist entdeckt zu werden.");

    AddDetail(({"glanz"}), "Das gruenliche Licht, das von den skelettierten Schaedeln ausgeht, ueberzieht die Hoehle mit einem gespenstischen Glanz, der die Umgebung in ein unheimliches Licht taucht.");

    AddDetail(({"gluehen"}), "Die Hoehle wird von einem gruenlichen Leuchten erfuellt, das die Umgebung mit einem gespenstischen Gluehen ueberzieht.");

    AddDetail(({"handlung"}), "Auf dem Tisch in der Mitte der Hoehle scheinen die Buecher und Schriftrollen fuer eine bestimmte Handlung bereit zu liegen, vielleicht fuer ein Ritual oder eine Zeremonie.");

    AddDetail(({"licht"}), "Das Licht in der Hoehle stammt von den skelettierten Schaedeln, die als Laternen dienen und die Umgebung mit einem gruenlichen Schein erhellen.");

    AddDetail(({"magie"}), "Die Buecher und Schriftrollen enthalten eine Fuelle von Wissen ueber verschiedene Arten von Magie, von der elementaren bis zur dunklen und verbotenen.");

    AddDetail(({"ordnung"}), "Die Buecher und Schriftrollen auf den Regalen sind in einer geheimnisvollen Ordnung angeordnet, die nur fuer die Eingeweihten Sinn zu machen scheint.");

    AddDetail(({"rand"}), "Die Regale sind bis zum Rand mit Buechern und Schriftrollen gefuellt, die eine Vielzahl von Themen abdecken.");

    AddDetail(({"ritualen"}), "Einige der Buecher und Schriftrollen koennten Anleitungen fuer magische Rituale oder zeremonielle Handlungen enthalten, die in der Hoehle durchgefuehrt werden.");

    AddDetail(({"runen"}), "Einige der Schriftrollen sind mit antiken Runen bedeckt, die eine tiefe mystische Bedeutung haben koennten.");

    AddDetail(({"schaedel"}), "Die skelettierten Schaedel an der Decke dienen als Laternen und werfen ein gespenstisches Licht in die Hoehle.");

    AddDetail(({"symbolen"}), "Die Symbole auf dem silbernen Heptagramm und den Schriftrollen koennten eine verborgene Botschaft oder eine rituelle Bedeutung haben.");

    AddDetail(({"themen"}), "Die Buecher und Schriftrollen decken eine Vielzahl von Themen ab, von Geschichte und Mythologie bis hin zu praktischer Magie.");

    AddDetail(({"vielzahl"}), "Es gibt eine Vielzahl von Buechern und Schriftrollen in der Hoehle, die ein breites Spektrum an Wissen und Information enthalten.");

    AddDetail(({"waechter"}), "Die skelettierten Schaedel an der Decke scheinen wie stumme Waechter, die ueber die Geheimnisse der Hoehle wachen.");

    AddDetail(({"wissen"}), "Die Buecher und Schriftrollen in der Hoehle bergen ein reichhaltiges Wissen, das von Jahrhunderten der Erforschung und Lehre zeugt.");

    AddDetail(({"anleitungen"}), "Einige der Buecher und Schriftrollen koennten Anleitungen fuer magische Rituale oder Zaubersprueche enthalten.");

    AddDetail(({"arten"}), "Die Buecher und Schriftrollen decken verschiedene Arten von Magie und Wissen ab, von der Alchemie bis zur Nekromantie.");

    AddDetail(({"botschaft"}), "Die Symbole und Runen koennten eine verborgene Botschaft oder eine geheime Bedeutung haben, die nur den Eingeweihten bekannt ist.");

    AddDetail(({"eingeweihten"}), "Die Ordnung der Buecher und Schriftrollen koennte nur fuer die Eingeweihten Sinn ergeben, die mit den Geheimnissen der Hoehle vertraut sind.");

    AddDetail(({"erforschung"}), "Die Buecher und Schriftrollen zeugen von Jahrhunderten der Erforschung und Lehre, die in der Hoehle stattgefunden haben koennten.");

    AddDetail(({"fuelle"}), "Die Hoehle ist voller Wissen und Information, das in den Buechern und Schriftrollen enthalten ist.");

    AddDetail(({"geist"}), "Die Hoehle scheint von einem geheimnisvollen Geist erfuellt zu sein, der in den alten Schriften und Buechern weiterlebt.");

    AddDetail(({"geschichte"}), "Die Buecher und Schriftrollen koennten die Geschichte der Hoehle und ihrer Bewohner ueber viele Jahrhunderte hinweg erzaehlen.");

    AddDetail(({"information"}), "Die Buecher und Schriftrollen enthalten eine Fuelle von Information und Wissen ueber verschiedene Themen.");

    AddDetail(({"jahrhunderten"}), "Das Wissen in den Buechern und Schriftrollen koennte ueber Jahrhunderte hinweg gesammelt und bewahrt worden sein.");

    AddDetail(({"lehre"}), "Die Buecher und Schriftrollen koennten Lehren und Weisheiten enthalten, die von Generation zu Generation weitergegeben wurden.");

    AddDetail(({"mythologie"}), "Einige der Buecher koennten Geschichten und Mythen aus vergangenen Zeiten enthalten, die die Geschichte und Kultur der Hoehle widerspiegeln.");

    AddDetail(({"ritual"}), "Das Heptagramm auf dem Boden koennte fuer ein bestimmtes Ritual oder eine zeremonielle Handlung stehen.");

    AddDetail(({"rituale"}), "Einige der Buecher koennten Anleitungen fuer magische Rituale oder Zeremonien enthalten, die in der Hoehle durchgefuehrt wurden.");

    AddDetail(({"schein"}), "Das gruenliche Licht in der Hoehle erzeugt einen gespenstischen Schein, der die Umgebung in ein unheimliches Licht taucht.");

    AddDetail(({"sinn"}), "Die Anordnung der Buecher und Schriftrollen koennte nur fuer die Eingeweihten Sinn ergeben, die mit den Geheimnissen der Hoehle vertraut sind.");

    AddDetail(({"spektrum"}), "Die Buecher und Schriftrollen decken ein breites Spektrum an Themen und Wissen ab.");

    AddDetail(({"symbole"}), "Die Symbole auf dem Heptagramm und den Schriftrollen koennten eine tiefere Bedeutung haben, die nur den Eingeweihten bekannt ist.");

    AddDetail(({"umgebung"}), "Die Hoehle und ihre Umgebung sind erfuellt von einem geheimnisvollen Gluehen, das von den skelettierten Schaedeln ausgeht.");

    AddDetail(({"zeremonie"}), "Die Buecher und Schriftrollen koennten fuer eine bestimmte zeremonielle Handlung oder ein magisches Ritual verwendet worden sein.");

    AddDetail(({"zusammenhang"}), "Die Buecher und Schriftrollen koennten einen Zusammenhang zwischen den Geheimnissen der Hoehle und ihrer Umgebung herstellen.");

    AddDetail(({"alchemie"}), "Einige der Buecher koennten sich mit den Geheimnissen der Alchemie befassen.");

    AddDetail(({"anordnung"}), "Die Anordnung der Buecher und Schriftrollen scheint absichtlich gewaehlt zu sein, vielleicht um bestimmte Themen oder Wissen leicht zugaenglich zu machen.");

    AddDetail(({"bewohner"}), "Du hast keine Ahnung wer hier gelebt hat.");

    AddDetail(({"generation"}), "Das Wissen in den Buechern und Schriftrollen koennte von Generation zu Generation weitergegeben worden sein.");

    AddDetail(({"jahrhunderte"}), "Das Wissen in den Buechern und Schriftrollen koennte ueber viele Jahrhunderte hinweg gesammelt und bewahrt worden sein.");

    AddDetail(({"kultur"}), "Wer auch immer hier lebt duerfte kultiviert sein.");

    AddDetail(({"mythen"}), "Die Buecher koennten Geschichten und Mythen aus vergangenen Zeiten enthalten, die die Geschichte und Kultur der Hoehle widerspiegeln.");

    AddDetail(({"nekromantie", "totenbeschwoerung"}), "Einige der Buecher koennten sich mit der dunklen Nekromantie befassen, der Magie der Totenbeschwoerung.");

    AddDetail(({"schriften"}), "Die Schriften in den Buechern und Schriftrollen koennten eine Vielzahl von Themen und Wissen umfassen, von Geschichte bis zur Magie.");

    AddDetail(({"weisheiten"}), "Die Buecher koennten Lehren und Weisheiten enthalten, die von den Weisen der Vergangenheit niedergeschrieben wurden.");

    AddDetail(({"zaubersprueche"}), "Einige der Buecher koennten Anleitungen fuer maechtige Zaubersprueche und Rituale enthalten, die in der Hoehle durchgefuehrt wurden.");

    AddDetail(({"zeiten"}), "Die Buecher koennten Geschichten und Wissen aus vergangenen Zeiten enthalten, die die Geschichte der Hoehle und ihrer Bewohner widerspiegeln.");

}
