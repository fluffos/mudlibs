#0:0
text_short ({"Ein Gang in einer boesartigen Hoehle",})
text_long ([2:({"Fahle Moose und Flechten bedecken die grob gehauenen Waende.","Modrige Pilze wachsen entlang der Waende auf huefthoehe.","Eine schleimige, blutrote Substanz scheint hier aus den Waenden zu bluten.","In der Dunkelheit des Ganges glimmen einige phosphoriszierende Einschluesse.","Die stete Feuchtigkeit der Hoehle kondensiert an einigen Stellen der Wand zu nassen Flecken.","An den Waenden winden sich feine Rinnsale aus schleimigem Brackwasser herab.",}),3:({"Ellenlange, geisterhafte Flechten haengen von oben herab.","Einige dunkle Schatten hocken reglos ober dir.","Gelegentlich broeseln schimmlige Broeckchen von oben auf dich herab.","Zaehfluessiger, roetlicher Schleim tropft auf deine Schultern herab.","Von oben bis unten spannen sich ekelhaft feuchte Spinnweben.",}),4:({"Unzaehlige Knochenreste knacken bei jedem Schritt unter deinen Fuessen.","Der unebene und glitschige Boden macht es dir schwer voranzukommen.","Jeder deiner Schritte hallt unangenehm laut auf dem harten Felsboden.","Einige rotgluehende Pilze wachsen hier in der Dunkelheit aus dem Fels.","Hunderte von Wuermern und Kaefern winden sich unter deinen Schritten davon.",}),5:({"Hier und da erkennst du blutige Handabdruecke.","Irgendjemand hat hier blasphemische Worte des Wahnsinns in den Stein geritzt.","Ein fauliger Lufthauch weht rhythmisch, wie Atem, durch den Gang.","Irgendetwas hat hier tiefe Krallenspuren im Fels hinterlassen.","Eine frische Blutspur zieht sich den Gang entlang.","In einer Ecke liegt ein aufgebrochene Schaedel.","Du hast das unbestimmte Gefuehl beobachtet zu werden.","War da nicht gerade eben ein Schatten, der sich bewegt?","In der Dunkelheit siehst du roetliche Augen aufgluehen.",}),1:({"Du folgst einem glatt behauenen Gang tiefer in die Hoehle.","Stetig fuehrt dich dieser Gang einem ungewissen Schicksal entgegen.","Vor und hinter dir ist dieser Gang von nichts als Dunkelheit erfuellt.","Mit einem mulmigen Gefuehl im Bauch tastest du dich den Gang entlang.","Tiefer und tiefer fuehrt es dich in die Eingeweide der Hoehle.",}),])
text_details (["blutspur":({"Eine dicke, frische Blutspur zieht sich am Boden entlang.","Einige Spritzer Blut sind hie und da verteilt.","Sieht aus, als haette hier jemand viel Blut verloren.",}),"schlimmeres":({"So genau willst du es gar nicht wissen.",}),"moos":({"Fahles, graeuliches Moos bedeckt die Waende.","Einige Flecken der Wand sind mit Moos bedeckt, das kaum noch lebendig wirkt.","Schleimiges Moos haelt sich verbissen an der Wand fest.",}),"boshaftigkeit":({"Ueberall um dich und sogar in dir regt sich regelrechte Boshaftigkeit...",}),"bauch":({"Ein mulmiges Gefuehl lauert in deinem Bauch.",}),"knochenreste":({"Die Knochenspiltter zahlreicher Lebewesen liegen ueber den ganzen Boden verstreut.",}),"decke":({"Die Decke besteht, wie die Waende und der Boden, aus rauem, grauem Stein.",}),"schicksal":({"Dein Schicksal ist ungewisst. Was wird dich wohl erwarten?","Du fuehlst, dass es mit dir kein gutes Ende nehmen wird.","Schwer zu sagen, was dir die Zukunft bringen mag.",}),"substanz":({"Wie zaehes Blut rinnt sie an den Waenden entlang.","Auf den ersten Blick sieht sie aus wie Blut.","Es duerfte sich um einen besonders ekelhaften Schleimpilz handeln.",}),"unterwelt":({"Du bist hier tief unter dem Silberland.",}),"wand":({"Die Waende sind grob aus dem graeulichen Stein gehauen.",}),"wahnsinns":({"Wenn du zu lange hier bleibst, dann wirst auch die dem Wahnsinn anheim fallen!","Du spuehrst schon wie sich der Wahnsinn in deinen Kopf bohrt.",}),"wahnsinn":({"Aaaargh! Da ist er!",}),"flechten":({"Wie duennes Haar haengen Flechten von den Waenden und der Decke.","Spinnwebenartige Flechten wehen in einem sanften Luftzug.","Wie die Fuehler irgendwelcher abscheulicher Insekten tasten einige der Flechten nach dir.",}),"felsboden":({"Der Boden hier ist aus besonders hartem Stein.",}),"gaengen":({"Du befindest dich in einem Gang, der sich immer tiefer hinab windet.","Ein seltsam gewundener Gang, der sich weiter in die Unterwelt dreht.","Der Gang ist sehr gerade und eben.","Es ist ein stetes auf und ab, mit dem sich dieser Gang weiter windet.",}),"handabdruecke":({"Irgendjemand hat hier blutige Handabdruecke hinterlassen...",}),"krallenspuren":({"Fuenf furchige Krallenspuren haben hier den Fels zerschnitten. Dem willst du lieber nicht begegnen.",}),"knochenspiltter":({"Bei jedem Schritt knacken und knirschen sie.",}),"augen":({"Kurz war da ein rotes Glimmen, wie von Augen zu erkennen. Etwas beobachtet dich.",}),"broeckchen":({"Du kannst gar nicht genau sagen, ob das Erde oder geronnenes Blut oder Schlimmeres ist",}),"rinnsale":({"Rinnsale aus brackigem Wasser rinnen an der Wand herab.","Kleine Rinnsale aus schmutzigbraunem Wasser ziehen sich an der Wand entlang.",}),"gutes":({"Hier findest du nichts Gutes.",}),"wuermern":({"Abertausende kleiner Wuermer und Maden werden von deinen Schritten zerdrueckt.",}),"flecken":({"Einige wenige Flecken sind mit Moos bedeckt. Merkwuerdig, dass es hier ueberhaupt waechst.",}),"ecke":({"In einer Ecke erkennst du einen aufgebrochenen Schaedel.",}),"feuchtigkeit":({"In diesem Gang ist es besonders feucht, was deine ganze Kleidung durchnaesst.","Einzelne Wassertropfen kondensieren hier an den Waenden.","Die Feuchtigkeit bildet nasse Flecken an den Waenden und der Decke.",}),"hoehle":({"Du bist dir sicher, dass in dieser Hoehle nichts Gutes haust.","Je weiter du voranschreitest, desto mulmiger wird dir bei dieser Hoehle zu Mute.","Diese Hoehle ist von Boshaftigkeit durchdrungen.","Es scheint dir so, als waere diese Hoehle natuerlich entstanden.",}),"schultern":({"Kraeftig und gut gebaut.","Vielleicht ein wenig schmaechtig.",}),"ort":({"Diese unterirdischen Gaenge.",}),"lufthauch":({"Wie der Atem aus einem fauligen Maul weht ein feuchter Lufthauch um dich.",}),"wuermer":({"Abertausende kleiner Wuermer und Maden werden von deinen Schritten zerdrueckt.",}),"erze":({"Die Schwaerze der Dunkelheit ist hier undurchdringlich.",}),"schleimpilz":({"Ein ekelhafter Schleimpilz hat sich hier abgesetzt.",}),"eingeweide":({"Dieser Gang fuehrt dich tiefer in die Eingeweide des Silberlands.",}),"glitzern":({"Die Einschluesse im Fels funkeln und glitzern merkwuerdig, sobald du dich bewegst.",}),"glimmen":({"Schon ist es wieder verschwunden.",}),"maden":({"Unter den Wuermern sind einige besonders dicke und bleiche Maden.",}),"schritten":({"Vorsichtig setzt du einen nach dem anderen.",}),"kopf":({"Du tastest kurz danach. Ja, ist noch dran!",}),"schatten":({"Du bist dir nicht sicher, ob da wirklich etwas ist, oder ob es nur eine Sinnestaeuschung war.",}),"licht":({"Abseits der Einschluesse ist es hier stockfinster.",}),"herz":({"Dein Herz schlaegt wild und laut. Dir ist mulmig.",}),"haar":({"Sie sehen fast aus, als waeren sie echtes Haar.",}),"schritte":({"Vorsichtig setzt du einen nach dem anderen.",}),"waende":({"Die Waende sind grob aus dem graeulichen Stein gehauen.",}),"dunkelheit":({"Eine undurchdringliche Dunkelheit breitet sich vor und hinter dir aus.","Endlose Schwaerze rings um dich.","Diese Dunkelheit legt sich seltsam lebendig um dich.",}),"schaedel":({"Sieht aus, wie von einem Troll.","Eindeutig ein kleiner Feenschaedel.","Igitt! Irgendjemand hat den Schaedel aufgebrochen und ausgeloeffelt.","Hm. Vermutlich ein Menschenschadel.","Du kannst nicht genau sagen wovon er stammt.",}),"fuessen":({"Zwei kraeftige Fuesse tragen deinen Koerper.",}),"atem":({"Es ist, als wuerde tief in den Gaengen etwas lebendiges auf dich warten.",}),"spinnen":({"Es muss sich um grosse Spinnen handeln.",}),"spinnweben":({"Der gesamte Gang ist an der Decke mit dicken Spinnweben ueberzogen. Du schauderst.","Diese Spinnweben sind dicker und fester als die von gewoehnlichen Spinnen.",}),"lebewesen":({"Jetzt sind sie wohl nicht mehr am Leben.",}),"silberlands":({"Du bist hier sicher irgendwo im Silberland. Hoffst du.",}),"kaefern":({"Tausendfuessler versuchen panisch vor dir zu fliehn.","Einige Spinnen fliehen vor dir.",}),"koerper":({"Ja, du bist noch ganz koerperlich... noch...",}),"funkeln":({"Die Einschluesse im Fels funkeln und glitzern merkwuerdig, sobald du dich bewegst.",}),"silberland":({"Du bist hier sicher irgendwo im Silberland. Hoffst du.",}),"gang":({"Du befindest dich in einem Gang, der sich immer tiefer hinab windet.","Ein seltsam gewundener Gang, der sich weiter in die Unterwelt dreht.","Der Gang ist sehr gerade und eben.","Es ist ein stetes auf und ab, mit dem sich dieser Gang weiter windet.",}),"moose":({"Fahles, graeuliches Moos bedeckt die Waende.","Einige Flecken der Wand sind mit Moos bedeckt, das kaum noch lebendig wirkt.","Schleimiges Moos haelt sich verbissen an der Wand fest.",}),"rot":({"Die Farbe von Blut.",}),"druck":({"Es fuehlt sich an, als waere dein Herz umklammert.",}),"zukunft":({"Hast du ueberhaupt noch eine?",}),"leben":({"Noch hast du deines... noch...",}),"einschluesse":({"Sie gluehen wie weisse Funken in der Wand.","Von ihnen geht ein fahles, kaum wahrnehmbares Licht uas.","Sie erzeugen ein unheimliches Funkeln und Glitzern, wenn du den Kopf drehst.",}),"brackwasser":({"Braunes, brackiges Wasser rinnt die Steine herab.","Rinnsale aus schmutzigem Wasser rinnen an den Waenden entlang.",}),"gefuehl":({"Dir ist ganz mulimg zu mute.","Ein unangenehmes Gefuehl, als wuerde dich jemand beobachten.","Dieses Gefuehl schnuert dir die Kehle zu.","Es ist wie ein Druck, der auf deinem Herzen lastet.","Irgendwie fuehlst du dich seltsam.","Ein fester Knoten in deinem Bauch.",}),"insekten":({"Dich ekelt richtig davor.",}),"fels":({"Der Fels, in den diese Gaenge geschlagen sind, ist massiv und hart. Du fragst dich, wie dieser Ort enstanden ist.",}),"stein":({"Der Stein ist grau und sehr rau.","Der Stein ist grau ind mit vielen kleinen Rissen durchzogen.",}),"worte":({"'Die Schatten verschlingen die Gedanken...'","'...und das Lachen der Sterne hallt in den Waenden der Ewigkeit wider.'","'Die Flammen des Irrsinns fressen sich durch die Grundfesten der Realitaet'","'Die Traeume der Vernunft zerfallen zu Staub.'","'Die Schreie der Verlorenen sind das Lied, das die Wände der Welt erzittern lässt'","'Augen des Wahnsinns blicken aus der Abgruenden der Leere!'","'Schatten in im Chaos in den Hallen des Geistes.'","'Pfade des Irrsinns fuehren zu den Toren der Verdammten.'","'Sterne, die zu Asche verbrennen und die Dunkelheit wird die einzige Wahrheit!'",}),"erde":({"Du hoffst, dass es einfach nur Erde ist.",}),"fuehler":({"Die Flechten sind wie die unheimlich tastenden Fuehler von Insekten.",}),"pilze":({"Ein paar rotgluehende Pilze spriessen hier aus dem Boden, als waere nichts besonders daran. Sie wirken unheimlich.",}),"farbe":({"Ein dunkles, arterielles Rot.",}),"boden":({"Der Boden besteht aus massivem, grauem Stein.",}),"fuesse":({"Zwei kraeftige Fuesse tragen deinen Koerper.",}),"rissen":({"Du hoffst, dass dieser Gang auch wirklich stabil ist.",}),"wasser":({"Es sieht wirklich nicht gut bekoemmlich aus.",}),"gaenge":({"Du befindest dich in einem Gang, der sich immer tiefer hinab windet.","Ein seltsam gewundener Gang, der sich weiter in die Unterwelt dreht.","Der Gang ist sehr gerade und eben.","Es ist ein stetes auf und ab, mit dem sich dieser Gang weiter windet.",}),"schleim":({"Dicker, ekelhafter Schleim in der Farbe von Blut tropft langsam auf dich herab.",}),"risse":({"Du hoffst, dass dieser Gang auch wirklich stabil ist.",}),"blut":({"Igitt!",}),])
