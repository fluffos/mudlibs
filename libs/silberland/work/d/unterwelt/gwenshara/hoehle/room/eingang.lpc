#include "../def.h"

inherit ROOM "std_hoehle";

public void create() {
    replace_program(ROOM "std_hoehle");
    ::create();

    SetProp(P_INT_SHORT, "An Anfang eines ueblen Ganges");
    SetProp(P_INT_LONG, "Du stehst hier in einem Gang in der Unterwelt, der nach Norden hin "
                        "leicht abschuessig ist. Wenn du ihm dort hin weiter folgst, "
                        "durchschreitest du etwas, das nach dem eingang in ein tieferliegendes "
                        "Hoehlensystem aussieht. Das Loch, dass dich noerdlich von hier, dort hin "
                        "fuerht, sieht ein wenig aus wie der Schlund eines Monsters.");

    AddDetail(({ "boden" }),
        "Der Boden des Ganges ist uneben und mit kleinen Steinen uebersaet, die unter deinen Fuessen knirschen, wenn du darueber gehst.");
    
    AddDetail(({ "decke" }),
        "Die Decke des Ganges ist von dunklen Schatten durchzogen.");
    
    AddDetail(({ "gang" }),
        "Der Gang erstreckt sich nach Norden und ist leicht abschuessig. Seine Waende sind mit Moos bewachsen, "
        "und hier und da tropft Wasser von der Decke herab.");
    
    AddDetail(({ "hoehlensystem" }),
        "Das Hoehlensystem scheint ein komplexes Netzwerk von Gaengen und Hoehlen zu sein, das tief unter der Oberflaeche liegt.");
    
    AddDetail(({ "loch" }),
        "Das Loch im Boden sieht aus wie der Eingang zu einem tieferen Teil des Hoehlensystems. "
        "Es ist dunkel und unheimlich, und ein kalter Luftstrom stroemt aus ihm heraus.");
    
    AddDetail(({ "monster", "monsters" }),
        "Du kannst keine Monster sehen, aber das Loch sieht definitiv aus, als koennte es der Schlund eines Monsters sein.");
    
    AddDetail(({ "schlund" }),
        "Der Schlund des Lochs ist dunkel und tief, und ein unangenehmer Geruch von Verwesung steigt daraus empor.");
    
    AddDetail(({ "unterwelt" }),
        "Die Unterwelt ist ein duesterer und gefaehrlicher Ort voller Geheimnisse und Gefahren.");
    
    AddDetail(({ "waende", "wand" }),
        "Die Waende des Ganges sind aus grobem Fels, der von der Feuchtigkeit glaenzt. "
        "Hier und da sind einige Spuren von Kratzern und Schrammen zu erkennen.");
    
    AddDetail(({ "wand" }),
        "Die Wand des Ganges ist aus grobem Fels, der von der Feuchtigkeit glaenzt. "
        "Hier und da sind einige Spuren von Kratzern und Schrammen zu erkennen.");

    AddDetail(({ "eingang" }),
        "Der Eingang des Ganges ist fuert tiefer in die Unterwelt.");
    
    AddDetail(({ "fels" }),
        "Der Fels, aus dem die Waende des Ganges bestehen, ist rau und uneben. "
        "Er scheint viele Jahrhunderte lang von den Naturgewalten geformt worden zu sein.");
    
    AddDetail(({ "feuchtigkeit" }),
        "Die Feuchtigkeit haengt schwer in der Luft des Ganges und bildet kleine Tropfen, die an den Waenden entlang laufen.");
    
    AddDetail(({ "fuessen" }),
        "Unter deinen Fuessen spuerst du den unebenen Boden des Ganges, der von Steinen und kleinen Kieselsteinen bedeckt ist.");
    
    AddDetail(({ "gaenge" }),
        "Die Gaenge des Hoehlensystems erstrecken sich in alle Richtungen und bilden ein komplexes Netzwerk unter der Oberflaeche.");
    
    AddDetail(({ "gefahren" }),
        "Die Gefahren der Unterwelt sind zahlreich und vielfaeltig, von tiefen Abgruenden bis hin zu hinterhaeltigen Kreaturen.");
    
    AddDetail(({ "geheimnisse" }),
        "Die Geheimnisse der Unterwelt sind tief verborgen und warten darauf, von mutigen Abenteurern entdeckt zu werden.");
    
    AddDetail(({ "geruch" }),
        "Ein unangenehmer Geruch von Verwesung haengt in der Luft, der von dem dunklen Schlund des Lochs zu kommen scheint.");
    
    AddDetail(({ "hoehlen" }),
        "Die Hoehlen des Hoehlensystems sind dunkel und geheimnisvoll, und manche von ihnen bergen grosse Schaetze oder toedliche Gefahren.");
    
    AddDetail(({ "kratzern" }),
        "Auf den Waenden des Ganges sind einige Kratzer und Schrammen zu erkennen, die von vergangenen Kaempfen zeugen.");
    
    AddDetail(({ "luftstrom" }),
        "Ein kalter Luftstrom stroemt aus dem dunklen Schlund des Lochs heraus und laesst dich froesteln.");
    
    AddDetail(({ "moos" }),
        "Das Moos waechst in kleinen Buescheln an den feuchten Stellen der Waende.");
    
    AddDetail(({ "netzwerk" }),
        "Das Netzwerk der Gaenge und Hoehlen erstreckt sich weit unter der Oberflaeche und ist ein Labyrinth aus Dunkelheit und Geheimnissen.");
    
    AddDetail(({ "oberflaeche" }),
        "Die Oberflaeche ist weit entfernt und nur ein schwacher Lichtstrahl dringt bis hier unten in die Dunkelheit vor.");
    
    AddDetail(({ "ort" }),
        "Dieser Ort in der Unterwelt ist duester und unheimlich, aber auch voller verborgener Schaetze und Gefahren.");
    
    AddDetail(({ "schatten" }),
        "Die Schatten des Ganges spielen ueber die raue Oberflaeche der Waende.");
    
    AddDetail(({ "schrammen" }),
        "Einige Schrammen und Kratzer sind in den Felswaenden des Ganges eingraviert, als stumme Zeugen vergangener Ereignisse.");
    
    AddDetail(({ "spuren" }),
        "Die Spuren vergangener Reisender sind hier und da in Form von abgenutzten Stellen auf dem Boden und den Waenden zu erkennen.");
    
    AddDetail(({ "steinen" }),
        "Die Steine, die den Boden des Ganges bedecken, sind glatt und abgenutzt von den vielen Wanderern, die diesen Weg gegangen sind.");
    
    AddDetail(({ "teil" }),
        "Dieser Teil des Hoehlensystems scheint weniger erkundet zu sein als andere, was darauf hindeutet, dass hier groessere Gefahren lauern koennten.");
    
    AddDetail(({ "verwesung" }),
        "Der Geruch von Verwesung ist stark in der Luft, und erinnert dich daran, dass der Tod hier allgegenwaertig ist.");
    
    AddDetail(({ "wasser" }),
        "Das Wasser tropft von der Decke des Ganges und bildet kleine Pfuetzen auf dem Boden, die den Weg schluepfrig machen.");
    
        AddDetail(({ "abenteurern" }),
        "Viele tapfere Abenteurer haben diesen Weg bereits beschritten, auf der Suche nach Ruhm, Reichtum oder einfach nur Abenteuer.");
    
    AddDetail(({ "abgruenden" }),
        "Die Abgruende der Unterwelt sind tief und unergruendlich, und es gibt keine Gewissheit darueber, was in ihrer Dunkelheit lauert.");

    AddDetail(({ "buescheln" }),
        "Kleine Bueschel von Moos wachsen an den feuchten Stellen der Waende und verleihen dem Gang einen mysterioesen Charme.");
    
    AddDetail(({ "dunkelheit" }),
        "Die Dunkelheit des Ganges ist fast greifbar.");
    
    AddDetail(({ "ereignisse" }),
        "Viele bedeutsame Ereignisse haben sich in diesen Hoehlen zugetragen, und ihre Spuren sind noch immer sichtbar.");
    
    AddDetail(({ "felswaenden" }),
        "Die Felswaende des Ganges sind hoch und unerbittlich, und sie scheinen seit Jahrhunderten unveraendert zu sein.");
    
    AddDetail(({ "form" }),
        "Die Form des Ganges ist lang und schmal, und sie windet sich wie ein Schlange durch die Dunkelheit.");
    
    AddDetail(({ "jahrhunderte" }),
        "Eine lange, lange Zeit. Vielleicht so gar noch laenger als das.");
    
    AddDetail(({ "kaempfen" }),
        "Viele mutige Krieger haben in diesem Gang gekaempft, und ihre Energie ist noch immer in der Luft spuerbar.");
    
    AddDetail(({ "kieselsteinen" }),
        "Die Kieselsteine auf dem Boden des Ganges sind glatt und rund, abgeschliffen durch die staendige Bewegung der Wanderer.");
    
    AddDetail(({ "kratzer" }),
        "Die Kratzer in den Felswaenden des Ganges zeugen von vergangenen Kaempfen und Konflikten.");
    
    AddDetail(({ "kreaturen" }),
        "Die Kreaturen der Unterwelt lauern in den dunklen Ecken des Hoehlensystems und warten darauf, arglose Wanderer zu verschlingen.");
    
    AddDetail(({ "labyrinth" }),
        "Das Labyrinth der Gaenge und Hoehlen ist ein undurchdringliches Geflecht aus Dunkelheit und Geheimnissen.");
    
    AddDetail(({ "lichtstrahl" }),
        "Ein schwacher Lichtstrahl dringt von draussen herein und erleuchtet den Eingang des Ganges, bevor er in der Dunkelheit verschwindet.");
    
    AddDetail(({ "luft" }),
        "Die Luft im Gang ist stickig und schwer, und es faellt schwer, tief einzuatmen.");
    
    AddDetail(({ "naturgewalten" }),
        "Die Naturgewalten haben diesen Gang geformt und gepraegt, und ihre Spuren sind ueberall sichtbar.");
    
    AddDetail(({ "pfuetzen" }),
        "Die Pfuetzen auf dem Boden des Ganges sind truebe und undurchsichtig, und es ist unmoeglich zu sagen, wie tief sie sind.");
    
    AddDetail(({ "reisender" }),
        "Die Spuren vergangener Reisender sind ueberall im Gang zu sehen, von abgenutzten Stellen auf dem Boden bis zu Kerben in den Waenden.");
    
    AddDetail(({ "schaetze" }),
        "Die Schaetze der Unterwelt sind hier verborgen, und sie warten nur darauf, von mutigen Abenteurern entdeckt zu werden.");
    
    AddDetail(({ "steine" }),
        "Die Steine an den Waenden des Ganges sind von Moos bedeckt und geben dem Gang ein altes und verwittertes Aussehen.");
    
    AddDetail(({ "tod" }),
        "Der Tod lauert in jedem dunklen Winkel der Unterwelt, bereit, diejenigen zu verschlingen, die sich zu weit vorwagen.");
    
    AddDetail(({ "tropfen" }),
        "Die Tropfen, die von der Decke des Ganges fallen, erzeugen ein sanftes Plaetschern, das die Stille der Dunkelheit durchbricht.");
    
    AddDetail(({ "wanderern" }),
        "Die Wanderer, die diesen Weg gegangen sind, haben ihre Spuren hinterlassen, und ihre Geschichten sind in den Mauern des Ganges eingraviert.");
    
    AddDetail(({ "weg" }),
        "Der Weg des Ganges erstreckt sich nach Norden und fuehrt tiefer in die Dunkelheit der Unterwelt.");
    
    AddDetail(({ "zeugen" }),
        "Die Waende des Ganges sind stumme Zeugen vergangener Ereignisse, und sie haben viel zu erzaehlen, wenn man nur genau hinhoert.");
    
        AddDetail(({ "abenteuer" }),
    "Die Unterwelt birgt unzaehlige Abenteuer und Herausforderungen, die darauf warten, von mutigen Seelen gemeistert zu werden.");

    AddDetail(({ "abenteurer" }),
        "Die Abenteurer, die diesen Weg gewagt haben, waren mutig und unerschrocken, und ihre Namen werden in den Legenden der Unterwelt weiterleben.");

    AddDetail(({ "abgruende" }),
        "Die Abgruende der Unterwelt sind dunkel und tief, und es gibt kein Entrinnen, wenn man einmal hinein gefallen ist.");

    AddDetail(({ "aussehen" }),
        "Der Gang hat ein duesteres und unheimliches Aussehen, das selbst den tapfersten Reisenden das Herz schneller schlagen laesst.");

    AddDetail(({ "bewegung" }),
        "Die staendige Bewegung der Wanderer hat ihre Spuren in den Waenden des Ganges hinterlassen, und sie erzaehlen von vergangenen Reisen und Abenteuern.");

    AddDetail(({ "bueschel" }),
        "Die Bueschel von Moos, die an den Waenden des Ganges wachsen, geben dem Ort einen Hauch von Leben inmitten der Dunkelheit.");

    AddDetail(({ "charme" }),
        "Der Charme des Ganges liegt eigentlich nur im Moos.");

    AddDetail(({ "ecken" }),
        "Die dunklen Ecken des Ganges verbergen unzaehlige Geheimnisse und Gefahren, die darauf warten, entdeckt zu werden.");

    AddDetail(({ "energie" }),
        "Die Energie vergangener Kaempfe haengt noch immer in der Luft des Ganges, und sie erinnert daran, dass dieser Ort nicht ohne Gefahren ist.");

    AddDetail(({ "felswaende" }),
        "Die Felswaende des Ganges ragen hoch ueber dir empor.");

    AddDetail(({ "geflecht" }),
        "Das Geflecht der Gaenge und Hoehlen erstreckt sich weit unter der Oberflaeche und bildet ein undurchdringliches Labyrinth aus Dunkelheit und Geheimnissen.");

    AddDetail(({ "geschichten" }),
        "Die Mauern des Ganges haben viele Geschichten zu erzaehlen, von vergangenen Helden und gefallenen Kreaturen.");

    AddDetail(({ "gewissheit" }),
        "Es gibt keine Gewissheit in der Unterwelt, nur Dunkelheit und Gefahr, die auf den unvorbereiteten Reisenden warten.");

    AddDetail(({ "kerben" }),
        "Die Kerben in den Felswaenden des Ganges erzaehlen von vergangenen Kaempfen und Konflikten, die hier stattgefunden haben.");

    AddDetail(({ "kieselsteine" }),
        "Die Kieselsteine auf dem Boden des Ganges sind glatt und rund, abgeschliffen durch die staendige Bewegung der Wanderer.");

    AddDetail(({ "konflikten" }),
        "Viele Konflikte haben sich in diesem Gang abgespielt.");

    AddDetail(({ "krieger" }),
        "Die Krieger, die diesen Weg gegangen sind, waren tapfer und entschlossen.");

    AddDetail(({ "plaetschern" }),
        "Das sanfte Plaetschern der Tropfen, die von der Decke des Ganges fallen, durchbricht die Stille der Dunkelheit.");

    AddDetail(({ "ruhm" }),
        "Ruhm und Ehre warten auf diejenigen, die die Gefahren der Unterwelt ueberwinden und als Helden daraus hervorgehen.");

    AddDetail(({ "schlange" }),
        "Der Gang windet sich wie eine Schlange durch die Dunkelheit und fuehrt tiefer und tiefer in die Unterwelt.");

    AddDetail(({ "stille" }),
        "Die Stille des Ganges ist fast erdrueckend, und sie verstaerkt das Gefuehl der Einsamkeit.");

    AddDetail(({ "suche" }),
        "Die Suche nach Abenteuer und Schaetzen hat viele Reisende in die dunklen Ecken der Unterwelt gefuehrt, wo Gefahren und Geheimnisse auf sie warten.");

    AddDetail(({ "wanderer" }),
        "Du bist so ein Wanderer.");

    AddDetail(({ "winkel" }),
        "Die dunklen Winkel des Ganges verbergen unzaehlige Geheimnisse und Gefahren, die darauf warten, entdeckt zu werden.");

    AddDetail(({ "zeit" }),
        "Die Zeit hat ihre Spuren in den Mauern des Ganges hinterlassen.");

        AddDetail(({ "ehre" }),
        "Die Ehre der tapferen Abenteurer, die diesen Gang durchquert haben, lebt in den Legenden der Unterwelt weiter.");
    
    AddDetail(({ "einsamkeit" }),
        "Die Einsamkeit des Ganges ist fast greifbar, und sie verstaerkt das Gefuehl der Isolation in der duesteren Unterwelt.");
    
    AddDetail(({ "entrinnen" }),
        "Es gibt kein Entrinnen aus den Abgruenden der Unterwelt, und nur die Mutigsten wagen es, sich ihnen zu stellen.");
    
    AddDetail(({ "gefahr" }),
        "Die Gefahr lauert an jeder Ecke des Ganges, und nur die Tapfersten wagen es, sich ihr zu stellen.");
    
    AddDetail(({ "gefuehl" }),
        "Das Gefuehl der Angst und Aufregung erfuellt die Luft des Ganges, und es laesst dein Herz schneller schlagen.");
    
    AddDetail(({ "hauch" }),
        "Ein Hauch von Verderben und Verwesung haengt in der Luft des Ganges und erinnert daran, dass der Tod hier allgegenwaertig ist.");
    
    AddDetail(({ "helden" }),
        "Die Helden der Unterwelt sind mutig und unerschrocken, und ihre Namen werden in den Legenden der Unterwelt weiterleben.");
    
    AddDetail(({ "herausforderungen" }),
        "Die Herausforderungen der Unterwelt sind zahlreich und vielfaeltig, und nur die Tapfersten koennen sie meistern.");
    
    AddDetail(({ "herz" }),
        "Dein Herz schlaegt schneller, als du den dunklen Gang entlang schreitest, und du spuerst die Aufregung und Gefahr in der Luft.");
    
    AddDetail(({ "kaempfe" }),
        "Viele Kaempfe haben sich in diesem Gang abgespielt, und ihre Auswirkungen sind noch immer spuerbar.");
    
    AddDetail(({ "konflikte" }),
        "Die Konflikte der Vergangenheit haben ihre Spuren in den Mauern des Ganges hinterlassen, und sie erzaehlen von vergangenen Kriegen und Schlachten.");
    
    AddDetail(({ "leben" }),
        "Das Leben in der Unterwelt ist hart und gefaehrlich, aber auch voller Abenteuer und Moeglichkeiten.");
    
    AddDetail(({ "legenden" }),
        "Die Legenden der Unterwelt erzaehlen von mutigen Helden und gefaehrlichen Kreaturen, die die Dunkelheit beherrschen.");
    
    AddDetail(({ "mauern" }),
        "Die Mauern des Ganges sind aus massivem Fels errichtet und scheinen undurchdringlich zu sein.");
    
    AddDetail(({ "namen" }),
        "Die Namen der tapferen Abenteurer, die diesen Weg gewagt haben, werden in den Legenden der Unterwelt weiterleben.");
    
    AddDetail(({ "reichtum" }),
        "Der Gang birgt vielleicht verborgene Reichtuemer und Schaetze, die nur darauf warten, von denjenigen gefunden zu werden, die mutig genug sind, danach zu suchen.");
    
    AddDetail(({ "reisen" }),
        "Die Reisen durch die Unterwelt sind gefaehrlich und voller Hindernisse, aber auch voller Abenteuer und Entdeckungen.");
    
    AddDetail(({ "reisende" }),
        "Die Reisenden, die diesen Weg gegangen sind, waren mutig und unerschrocken, und ihre Namen werden in den Legenden der Unterwelt weiterleben.");
    
    AddDetail(({ "reisenden" }),
        "Die Reisenden, die diesen Weg gegangen sind, waren mutig und unerschrocken, und ihre Namen werden in den Legenden der Unterwelt weiterleben.");
    
    AddDetail(({ "seelen" }),
        "Die Seelen der Tapferen, die diesen Gang durchquert haben, ruhen in Frieden, aber ihre Geschichten leben in den Legenden der Unterwelt weiter.");
    
    AddDetail(({ "stellen" }),
        "An verschiedenen Stellen im Gang sind Spuren vergangener Ereignisse zu sehen, die von vergangenen Kaempfen und Abenteuern zeugen.");
    
                    

    AddExit("sueden", "/d/unterwelt/basics/central/room/00+10+08");
    AddExit("nordunten", ROOM "b6_b6");
    AddExit("norden", ROOM "b6_b6");

    SetProp(P_HIDE_EXITS, ({"norden"}));

    AddItem(NPC "myrakulix", REFRESH_DESTRUCT);
}
