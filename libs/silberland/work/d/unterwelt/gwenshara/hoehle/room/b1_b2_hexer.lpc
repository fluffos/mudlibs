#include "../def.h"

inherit ROOM "std_hoehle";

private int sabotaged, dingDongTheWitchIsDead;

public void create() {
    ::create();
    sabotaged = 0;
    dingDongTheWitchIsDead = 0;

    SetProp(P_INT_SHORT, "In einer Hoehle der Verwurstung");
    SetProp(P_INT_LONG, 
            "In diesem Abschnitt der Hoehle hat jemand verschiedene Kaefige "
            "aufgehaengt. Im hinteren Teil wurde ein Gitter in den Boden "
            "eingelassen. Linkerhand steht ein grosser Steintisch, der wohl "
            "als Hackblock dient. Daunter quellen Eingeweide und Blut aus "
            "einem grossen Holzbottich.");

    AddSpecialDetail( ({"gitter", "falltuer"}), "detail_gitter");
    AddSpecialDetail( ({"bolzen", "haltebolzen"}), "detail_bolzen");

    AddDetail(({"abschnitt"}), "Dieser Abschnitt der Hoehle ist mit verschiedenen Kaefigen ausgestattet und wirkt duester und bedrohlich.");

    AddDetail(({"blut", "spuren", "blutspuren"}), "Einige Blutspuren bedecken den Boden und lassen darauf schliessen, dass hier nicht gerade zimperlich mit den Opfern umgegangen wird.");

    AddDetail(({"boden"}), "Der Boden ist mit Blut besudelt und verleiht dem Raum einen unheimlichen Anblick.");

    AddDetail(({"decke"}), "Die Decke der Hoehle ist dunkel und schwer, und scheint bedrohlich auf den Raum herabzuschweben.");

    AddDetail(({"eingeweide"}), "Eingeweide quellen aus einem grossen Holzbottich heraus, und der Raum ist erfuellt von einem unangenehmen Geruch.");

    AddDetail(({"hackblock"}), "Ein grosser Steintisch dient als Hackblock, und Spuren von Blut zeugen davon, dass er oft benutzt wird.");

    AddDetail(({"hoehle"}), "Die Hoehle wirkt duester und bedrohlich, und verschiedene Kaefige und ein Gitter im Boden lassen dich schaudern.");

    AddDetail(({"holzbottich"}), "Ein grosser Holzbottich quillt ueber von Eingeweiden und Blut, und verstroemt einen widerlichen Geruch.");

    AddDetail(({"kaefige"}), "Verschiedene Kaefige haengen im Raum verteilt.");

    AddDetail(({"steintisch"}), "Ein grosser Steintisch steht im Raum, bedeckt mit Blutspuren und Ueberresten von Gewebe.");

    AddDetail(({"teil"}), "Dieser Teil der Hoehle ist duester und unheimlich, und von dunklen Machenschaften gepraegt.");

    AddDetail(({"waende", "wand"}), "Die Waende der Hoehle sind duester und unheimlich, und scheinen die Dunkelheit zu absorbieren.");

    AddDetail(({"anblick"}), "Der Anblick des Raumes ist duester und unheimlich, und laesst erahnen, dass hier schaurige Dinge geschehen.");

    AddDetail(({"dinge"}), "Dinge eben.");

    AddDetail(({"blutspuren"}), "Einige Blutspuren bedecken den Boden und die Waende des Raumes.");

    AddDetail(({"dunkelheit"}), "Die Dunkelheit in der Hoehle ist fast greifbar.");

    AddDetail(({"geruch"}), "Der Geruch von Blut und vermodernden Eingeweiden haengt schwer in der Luft und ist kaum zu ertragen.");

    AddDetail(({"gewebe", "fleisch"}), "Ueberreste von Gewebe und Fleisch bedecken den Steintisch und den Boden und zeugen von brutalen Handlungen.");

    AddDetail(({"machenschaften"}), "Die dunklen Machenschaften, die in dieser Hoehle stattgefunden haben, sind kaum vorstellbar.");

    AddDetail(({"opfern"}), "Die Ueberreste von Opfern liegen verstreut im Raum und erinnern daran, dass hier grausame Taten begangen wurden.");

    AddDetail(({"raum"}), "Der Raum ist duester und unheimlich, und scheint von dunklen Maechten beherrscht zu werden.");

    AddSpecialDetail(({"ghoul"}), "detail_ghoul");

    AddExit("nordosten", ROOM "b2_b1_hexer");
    AddExit("suedosten", ROOM "b2_b3_hexer");
    AddExit("osten", ROOM "b2_b2_hexer");

    AddCmd( ({ "lockere", "locker", "loese", "loes" }), "cmd_lockern");
    AddCmd( ({"angel", "angle"}), "cmd_angel");
}

public string detail_ghoul() {
    if(dingDongTheWitchIsDead) {
        return BS("Ein satt schmatzender Ghoul sitzt unter dem Gitter.");
    }

    return BS("Hungrig fauchent versucht der Ghoul nach dir zu schnappen. Er scheint sehr hungrig!");
}

public string detail_gitter() {
    string str;

    str = "Das Gitter ist eigentlich eine Falltuer, die hier in den Boden eingalssen wurde. "
          "Es wird von einem einfachen Haltebolzen geschlossen gehalten. Darunter erkennst "
          "du ein dunkles Loch, aus dem dir ein hungriger Ghoul entgegenstarrt.";
    if(dingDongTheWitchIsDead) {
        str += " Die Ueberreste von Sheraxdina liegen neben dem Ghoul. Er hat alles bis "
               "auf ein blutiges Ringteil verspeist. Mit geeigneter Ausruestung koenntest "
               "du es sicher nach oben angeln.";
    }

    return BS(str);
}

public string detail_bolzen() {
    string str;
    str = "Der Haltebolzen ist einfach gehalten. Wenn er gelockert wird, dann "
          "schnappt das Gitter auf, sobald es belastet wird. ";

    if(sabotaged) {
        str += "Im Moment ist er gelockert.";
    } else {
        str += "Aktuell sitzt er bombenfest.";
    }

    return BS(str);
}

public int cmd_angel(string str) {
    object ring, angel;

    notify_fail("Wonach willst du angeln?\n");
    if(!str || str == "") return 0;
    if(str != "nach ring" && str != "nach ringteil" && str != "in loch") return 0;

    if(!objectp(angel=present("angel", TP))) {
        write(BS("Dazu solltest du eine Angel dabei haben!"));
        return -1;
    }

    if(!dingDongTheWitchIsDead) {
        write(BS("Du angelst im Loch herum. Der Ghoul unten spielt ein wenig mit dem Angelhaken."));
        say(BS(TPN + " angelt im Loch unter dem Gitter."));
        return 1;
    }

    ring = clone_object(OBJ "ringteil_2");
    if(ring->move(TP, M_GET) != 1) {
        write(BS("Der Ringteil rutscht dir von der Angel."));
        return -1;
    }

    write(BS("Geschickt angelst du das Ringteil hoch. Der Gouhl erwicht dabei jedoch die Angel und sie zerbricht."));
    say(BS(TPN + " angelt im Loch unter dem Gitter."));
    angel->remove();

    dingDongTheWitchIsDead = 0;
    return 1;
}

public int cmd_lockern(string str) {
    notify_fail("Was moechtest du lockern?\n");
    if(!str || str == "") return 0;
    if(str != "bolzen" && str != "haltebolzen") return 0;

    if(sabotaged) {
        write(BS("Grade als du anfangen willst, merkt du, dass das schon jemand gemacht hat."));
        return -1;
    }

    if(objectp(present("\ngwenshara_evil_cave_witch"))) {
        write(BS("Du laesst das lieber, so lange Sheraxdina dich beobachten kann."));
        return -1;
    }

    write(BS("Mit einer schnellen Bewegung loest du den Haltebolzen der Gitterstaebe. "
             "Wenn jetzt jemand darauf steigt wird sich das Gitter loesen und die "
             "arme Seele direkt zum hungrigen Gouhl nach unten fallen."));
    say(BS(TPN + " werkt an den Giterstaeben herum."));

    sabotaged = 1;
    return 1;
}

public void init() {
    ::init();

    if(TP->id("\ngwenshara_evil_cave_witch") && sabotaged) {
        call_out("dropTheWitch", 2);
    }

    return;
}

public void reset() {
    ::reset();

    sabotaged = 0;
    dingDongTheWitchIsDead = 0;
}

public void dropTheWitch() {
    object witch, *inv;
    int i;

    if(!objectp(witch = present("\ngwenshara_evil_cave_witch"))) return;

    tell_room(TO, BS(witch->Name(WER) + " tritt auf das Gitter und mit einem Quietschen schnappt es auf. "
                     "Die Hexe faellt mit einem lauten Kreischen hindurch und das Gitter schnappt wieder zu."));
    sabotaged = 0;

    inv = all_inventory(witch);
    for(i=0; i<sizeof(inv); ++i) {
        inv[i]->remove(1);
    }
    witch->remove(1);

    call_out("eatTheWitch", 2);
    return;
}

public void eatTheWitch() {
    tell_room(TO, BS("Du hoerst ein wiederliches Heulen, Kauen und Kreischen aus dem Loch."));
    call_out("theWitchIsDead", 2);
    return;
}

public void theWitchIsDead() {
    dingDongTheWitchIsDead = 1;
    tell_room(TO, BS("Ploetzlich erstirbt das Kreischen und ein lautes Ruelpsen ertoent aus dem Loch."));
    return;
}