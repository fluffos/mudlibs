#include "../def.h"
#include <npcmaster.h>
#include "/gilden/waldlaeufer/ranger_tasks.h"

inherit ROOM "std_hoehle";

int sangurit;

public void create() {
    ::create();

    SetProp(P_INT_SHORT, "Die Seelenkaverne");
    SetProp(P_INT_LONG, "Diese Hoehle scheint natuerlich gewachsen zu sein. Sie ist rund, wie "
                        "eine Kugel und ueber und ueber mit Kristallen bedeckt. Ein einzelner "
                        "Lichtstrahl faellt von oben herein und erleuchtet ein grosses Podest "
                        "aus Kristall. Uerbeall um dich reflektieren die Kristalle das Licht "
                        "in einem Glitzermeer. Ein leises Seufzen, wie von tausenden Seelen erfuellt "
                        "die Luft um dich. Deine Nackenhaare stehen dir zu berge.");

    AddSpecialDetail( ({"podest", "kristallpodest"}), "detail_podest");
    AddSpecialDetail( ({"stein", "sangurit"}), "detail_sangurit");

    AddExit("sueden", ROOM "b5_a9");

    AddCmd("nimm|nehme&stein|sangurit", "cmd_sangurit");

    AddDetail(({ "boden", "steinboden" }), "Der Boden der Hoehle ist aus glattem, dunklem Gestein, das von den Spuren vergangener Eruptionen gezeichnet ist.");
    AddDetail(({ "decke", "steindecke" }), "Die Decke ist mit duennen Kristallformationen bedeckt, die wie funkelnde Sterne aussehen.");
    AddDetail("glitzermeer", "Das Glitzermeer wird von den unzaehligen reflektierenden Kristallen erzeugt, die das Licht in alle Richtungen brechen und funkeln lassen.");
    AddDetail(({ "hoehle", "raum" }), "Die Hoehle erstreckt sich weit in alle Richtungen und scheint eine Aura uralter Macht auszustrahlen.");
    AddDetail(({ "kristall", "kristalle" }), "Die Kristalle um dich herum kommen in allen Groessen und Formen vor, einige leuchten sanft, waehrend andere ein intensiveres Licht ausstrahlen.");
    AddDetail("kugel", "Die Hoehle hat die Form einer riesigen Kugel, die den Eindruck vermittelt, als waere sie organisch gewachsen.");
    AddDetail("licht", "Das Licht in der Hoehle scheint eine mystische Qualitaet zu haben, die die Umgebung in ein geheimnisvolles Leuchten taucht.");
    AddDetail(({ "lichtstrahl", "strahl" }), "Der Lichtstrahl, der von oben in die Hoehle faellt, wirkt wie ein goettlicher Finger, der das Geheimnis dieser magischen Kammer beleuchtet.");
    AddDetail("luft", "Die Luft in der Hoehle ist erfuellt von einem kaum wahrnehmbaren Fluestern, das die Sinne derjenigen, die hier eintreten, umschmeichelt.");
    AddDetail(({ "nackenhaare", "haare" }), "Die Nackenhaare stellen sich auf, als ob sie die Anwesenheit einer unsichtbaren Kraft spueren wuerden.");
    AddDetail(({ "seelen", "tausend seelen" }), "Es scheint, als wuerden die Seelen vergangener Ereignisse in den Waenden der Hoehle gefangen sein, ein stummes Zeugnis fuer die Geschichte dieses Ortes.");
    AddDetail("seufzen", "Das leise Seufzen, das durch die Luft der Hoehle zieht, erweckt den Eindruck, als wuerden die Geister der Vergangenheit hier verweilen.");
    AddDetail(({ "waende", "wand", "hoehlenwaende" }), "Die Waende der Hoehle sind von unzaehligen Kristallen bedeckt, die ein kaleidoskopisches Muster aus Licht und Schatten erzeugen.");
    AddDetail("anwesenheit", "Die Anwesenheit in dieser Hoehle fuehlt sich uebernatuerlich an, als ob die Luft selbst von uralter Magie erfuellt waere.");
    AddDetail("aura", "Eine maechtige Aura durchdringt diese Kammer, eine unbestimmte Praesenz, die das Gefuehl von Ehrfurcht und Respekt hervorruft.");
    AddDetail("eindruck", "Der Eindruck, den diese Hoehle hinterlaesst, ist tiefgreifend, als ob sie Zeuge unzaehliger Ereignisse gewesen waere.");
    AddDetail("ereignisse", "Die Ereignisse, die sich in dieser Hoehle abgespielt haben koennten, scheinen in den Schatten der Vergangenheit gehuellt zu sein, aber ihre Auswirkungen sind deutlich spuerbar.");
    AddDetail("eruptionen", "Die Eruptionen vergangener Zeiten haben ihre Spuren auf dem Gestein hinterlassen, Zeugnisse der gewaltigen Kraefte, die diese Hoehle geformt haben.");
    AddDetail("finger", "Der Lichtstrahl, der von oben in die Hoehle faellt, wirkt wie ein goettlicher Finger, der das Geheimnis dieser magischen Kammer beleuchtet.");
    AddDetail("fluestern", "Das Fluestern, das durch die Luft der Hoehle zieht, scheint eine eigene Stimme zu haben, die von den Geistern der Vergangenheit getragen wird.");
    AddDetail("form", "Die Form dieser Hoehle ist organisch und doch majestaetisch, eine Mischung aus natuerlicher Schoenheit und magischer Pracht.");
    AddDetail("formen", "Die Kristalle nehmen verschiedene Formen an, von winzigen Prismen bis hin zu riesigen Saeulen, die die Waende der Kammer schmuecken.");
    AddDetail("geheimnis", "Das Geheimnis dieser Hoehle ist tiefgruendig und undurchdringlich, als ob es von den Mauern selbst bewahrt wuerde.");
    AddDetail("geister", "Die Geister vergangener Ereignisse scheinen in den Schatten der Hoehle zu lauern, ihre Praesenz nur durch das Fluestern der Luft spuerbar.");
    AddDetail("geschichte", "Die Geschichte dieses Ortes ist heute nicht mehr zu ergruenden.");
    AddDetail("gestein", "Das Gestein der Hoehle ist hart und von unzaehligen Kristallen durchzogen, die wie Adern durch einen lebenden Organismus wirken.");
    AddDetail("groessen", "Die Groessen der Kristalle variieren von winzig bis gewaltig, und doch scheinen alle in perfekter Harmonie miteinander zu sein.");
    AddDetail("kammer", "Diese Kammer strahlt eine Aura von Geheimnis und Macht aus, die jeden Besucher in ihren Bann zieht.");
    AddDetail("kraft", "Die Kraft, die in dieser Hoehle liegt, ist unvorstellbar, eine Macht, die diejenigen, die ihr nahe kommen, in ihren Bann zieht.");
    AddDetail(({"kristallformationen","formation","formationen"}), "Die Kristallformationen an der Decke bilden ein faszinierendes Muster aus Licht und Schatten, das die gesamte Kammer durchzieht.");
    AddDetail("leuchten", "Das sanfte Leuchten der Kristalle verleiht der Umgebung eine ueberirdische Schoenheit, die jeden Betrachter in ihren Bann zieht.");
    AddDetail("macht", "Die Macht dieser Hoehle ist greifbar, eine pulsierende Energie, die die Luft zu laden scheint.");
    AddDetail("muster", "Die Muster, die von den Kristallen auf den Waenden gebildet werden, sind von atemberaubender Schoenheit, ein wahres Kunstwerk der Natur.");
    AddDetail(({"ort", "ortes"}), "Die Magie dieses Ortes ist unbestreitbar, eine Praesenz, die jeden Besucher in ihren Bann zieht.");
    AddDetail("qualitaet", "Die Qualitaet der Kristalle ist unuebertroffen, ihr Glanz und ihre Reinheit sind ein Zeichen fuer ihre aussergewoehnliche Herkunft.");
    AddDetail("schatten", "Die Schatten in dieser Hoehle wirken lebendig, als ob sie ein Eigenleben fuehren wuerden, waehrend sie sich um die Kristalle schlaengeln.");
    AddDetail("sinne", "Die Sinne scheinen in dieser Hoehle geschaerft zu sein, als ob die Magie der Umgebung sie verstaerken wuerde.");
    AddDetail("spuren", "Die Spuren vergangener Ereignisse sind ueberall in dieser Hoehle zu finden, ein stummer Zeuge fuer die Geschichte, die sich hier entfaltet hat.");
    AddDetail("sterne", "Die Kristallformationen an der Decke glaenzen wie Sterne am naechtlichen Himmel, und ihr Licht erhellt die gesamte Kammer.");
    AddDetail("umgebung", "Die Umgebung dieser Hoehle ist voller Geheimnisse und Gefahren, eine Welt, die darauf wartet, erkundet zu werden.");
    AddDetail("vergangenheit", "Die Vergangenheit ist vergangen.");
    AddDetail("zeugnis", "Die Kristalle dieser Hoehle sind ein stummer Zeuge fuer die Ereignisse, die sich hier abgespielt haben, ein Vermaechtnis vergangener Zeiten.");
    AddDetail("adern", "Die Adern aus Kristall, die das Gestein durchziehen, erwecken den Eindruck, als wuerde die Hoehle selbst atmen.");
    AddDetail("auswirkungen", "Die Auswirkungen vergangener Ereignisse sind ueberall spuerbar, von den Formationen der Kristalle bis hin zu den Geistern, die durch die Luft fluestern.");
    AddDetail("bann", "Ein unsichtbarer Bann scheint ueber dieser Hoehle zu liegen, der jeden Besucher in seinen mysterioesen Sog zieht.");
    AddDetail("besucher", "Die Besucher dieser Hoehle werden von einer unbestimmten Faszination ergriffen.");
    AddDetail(({"betrachter","fenster"}), "Fuer den Betrachter wirkt diese Hoehle wie ein Fenster in eine andere Welt, voller Mysterien und unerforschter Schoenheit.");
    AddDetail("ehrfurcht", "Eine tiefe Ehrfurcht erfuellt diejenigen, die diese Hoehle betreten, angesichts ihrer majestaetischen Schoenheit und maechtigen Praesenz.");
    AddDetail("eigenleben", "Die Schatten in dieser Hoehle scheinen ein Eigenleben zu fuehren, als ob sie lebendige Wesen waeren, die die Geheimnisse der Hoehle bewachen.");
    AddDetail("energie", "Die Energie, die in dieser Hoehle liegt, ist spuerbar, eine pulsierende Kraft, die die Luft elektrisiert.");
    AddDetail("gefahren", "Die Gefahren, die diese Hoehle birgt, sind zahlreich und unberechenbar.");
    AddDetail("gefuehl", "Ein unbestimmtes Gefuehl von Macht und Magie durchdringt die Luft dieser Hoehle, ein Gefuehl, das die Sinne der Besucher betoert.");
    AddDetail(({"geheimnisse", "mysterien"}), "Die Geheimnisse dieser Hoehle sind tiefgreifend und undurchdringlich, verborgen in den Schatten der Vergangenheit.");
    AddDetail("glanz", "Der Glanz der Kristalle verleiht dieser Hoehle eine beinahe ueberirdische Schoenheit.");
    AddDetail("harmonie", "Die Kristalle dieser Hoehle scheinen in perfekter Harmonie miteinander zu sein, ein wahrhaft magisches Kunstwerk der Natur.");
    AddDetail(({"herkunft", "raetsel"}), "Die Herkunft dieser Kristalle ist ein Raetsel, ein Zeugnis fuer die Mysterien des Universums.");
    AddDetail("himmel", "Die Kristallformationen an der Decke erwecken den Eindruck eines sternenklaren Himmels, der die gesamte Kammer ueberdacht.");
    AddDetail("kraefte", "Die Kraefte, die in dieser Hoehle wirken, sind sowohl faszinierend als auch beaengstigend, eine maechtige Kraft.");
    AddDetail("kunstwerk", "Die Kristalle in dieser Hoehle bilden ein wahrhaft magisches Kunstwerk, das die Schoenheit und die Macht der Natur offenbart.");
    AddDetail("magie", "Die Magie dieser Hoehle ist ueberall spuerbar, eine maechtige Kraft.");
    AddDetail("mauern", "Die Mauern dieser Hoehle scheinen ein Eigenleben zu fuehren, als ob sie die Geheimnisse der Vergangenheit bewachen wuerden.");
    AddDetail("mischung", "Die Mischung aus natuerlicher Schoenheit und magischer Pracht macht diese Hoehle zu einem einzigartigen Ort, der jeden Besucher in seinen Bann zieht.");
    AddDetail(({"natur", "produkt"}), "Die Kristalle dieser Hoehle sind ein faszinierendes Produkt der Natur.");
    AddDetail(({"organismus"}), "Die Hoehle wirkt wie ein lebender Organismus der leicht pulsiert.");
    AddDetail("pracht", "Die Pracht dieser Hoehle ist unuebertroffen, eine majestaetische Schoenheit, die die Sinne betoert.");
    AddDetail("praesenz", "Die Praesenz dieser Hoehle ist ueberwaeltigend, eine Aura von Macht und Magie, die jeden Besucher in ihren Bann zieht.");
    AddDetail("prismen", "Die Kristalle dieser Hoehle brechen das Licht in wunderschoene Prismen, die die Waende und Decken in ein kaleidoskopisches Muster tauchen.");
    AddDetail(({"reinheit","oberflaechen"}), "Die Reinheit der Kristalle ist erstaunlich, ihre Oberflaechen glatt und makellos, ein Zeichen fuer ihre unverfaelschte Schoenheit.");
    AddDetail("respekt", "Ein tiefes Gefuehl des Respekts erfuellt diejenigen, die diese Hoehle betreten, angesichts ihrer majestaetischen Pracht und ihrer unbestreitbaren Macht.");
    AddDetail(({"saeulen", "kristallsaeulen"}), "Die Kristallsaeulen, die die Hoehlenwaende stuetzen, wirken wie die Saeulen eines uralten Tempels, der die Geheimnisse der Vergangenheit bewahrt.");
    AddDetail("schoenheit", "Die Schoenheit dieser Hoehle ist atemberaubend, eine unvergleichliche Pracht, die jeden Betrachter in ihren Bann zieht.");
    AddDetail("stimme", "Die Hoehle scheint eine eigene Stimme zu haben, die durch das Fluestern der Luft und das sanfte Glitzern der Kristalle zu dir spricht.");
    AddDetail("vermaechtnis", "Das Vermaechtnis dieser Hoehle ist unsterblich, eingefroren in den Kristallen und Adern, die die Geschichte dieses Ortes erzaehlen.");
    AddDetail("welt", "Diese Hoehle ist wie eine eigene Welt, voller Geheimnisse und Mysterien, die darauf warten, entdeckt zu werden.");
    AddDetail("zeichen", "Die Kristalle dieser Hoehle sind ein Zeichen fuer die unendliche Schoenheit und Macht der Natur, ein Symbol fuer die Geheimnisse des Universums.");
    AddDetail(({"zeiten", "zeiten"}), "Die Zeiten moegen kommen und gehen.");
    AddDetail("zeuge", "Die Kristalle sind stumme Zeugen fuer die Ereignisse.");
    AddDetail("zeugnisse", "Die Kristalle dieser Hoehle sind Zeugnisse vergangener Ereignisse, eingefangen in den Mauern und Adern des Gesteins.");
    AddDetail(({"faszination","sog"}), "Faszinierend...");
    AddDetail("glitzern", "Funkelnd glitzern dir die Kristalle entgegen.");

    sangurit = 1;
}

public void init() {
    ::init();

    if(!interactive(TP)) return;

    if(!RANGER_CHECK_TASK(TP, 11)) {
        call_out("StartSequence", 0, TP);
    }

    return;
}

public void StartSequence(object pl) {
    pl->SetProp(P_PARALYZED, ([
        PARALYZE_TIME: -1,
        PARALYZE_MSG: "Du bist gerade beschaeftigt.\n"
    ]));

    tell_room(TO, BS("Endlich hast du die Kaverne mit den Sanguriten erreicht! Keine Spur von den Kultisten."));
    call_out("sequence", 4, pl, 0);
    return;
}

public void clone_drider_and_combat(object pl) {
    object ob;

    ob = clone_object(NPC "drider");
    ob->move(TO, M_SILENT|M_NOCHECK);

    pl->Kill(ob);
    ob->Kill(pl);
    return;
}

public void sequence(object pl, int step) {
    string msg;
    int pause;

    if(!objectp(pl)) return; // ups, spieler weg?

    switch(step) {
        case 0: msg = "Ploetzlich hoerst du Schritte hinter dir."; pause = 4; break;
        case 1: msg = "Du wendest dich um und erkennst Myr Ak Ulix, der auf dich zuschreitet."; pause = 4; break;
        case 2: msg = "Bevor du noch etwas sagen kannst hebt er die Hand und tausende Spinnfaeden huellen dich ein."; pause = 4; break;
        case 3: msg = "Myr Ak Ulix sagt: Haha! Es war so leicht dich reinzulegen."; pause = 4; break;
        case 4: msg = "Myr Ak Ulix sagt: Natuerlich arbeite ICH fuer die Kultisten. Und du hast mir den Weg zum Sangurit geebnet."; pause = 4; break;
        case 5: msg = "Myr Ak Ulix lacht dich aus."; pause = 4; break;
        case 6: msg = "Der Dunkelelf tritt an das Podest heran und identifiziert den Sangurit."; pause = 6; break;
        case 7: msg = "Myr Ak Ulix nimmt den Sangurit. Mit einem Mal erstirbt alles Licht."; sangurit = 0; pause = 4; break;
        case 8: msg = "Myr Ak Ulix fluestert: Und damit du uns nicht weiter in die Quere kommst, wird das hier dein Ende sein!"; pause = 4; break;
        case 9: msg = "Der Dunkekelf hebt dir Arme und ruft magische Worte."; pause = 6; break;
        case 10: msg = "Auf einmal entsteht neben Dir ein Drider aus einer dunklen Wolke und stuerzt sich auf dich!"; pause = 2; break;
        case 11: msg = "Myr Ak Ulix verschwindet mit Knall und Schwefelduft."; pause = 2; break;
        default:
            clone_drider_and_combat(pl);
            pl->SetProp(P_PARALYZED, 0);
            RANGER_SET_TASK(pl, 11);
            return;
            break;
    }

    tell_object(pl, break_string(msg, 78, 0, BS_LEAVE_MY_LFS));
    call_out("sequence", pause, pl, ++step);
    return;
}

public void reset() {
    ::reset();

    if(!sangurit) {
        tell_room(TO, BS("Ein Sangurit erscheint ueber dem Podest. Ploetzlich durchlutet Licht die Hoehle."));
        sangurit = 1;
    }
    return;
}

public int cmd_sangurit() {
    object ob;

    if(!sangurit) {
        write(BS("Hier ist kein Sangurit. Jemand war wohl schneller als du."));
        return -1;
    }

    ob = clone_object(OBJ "sangurit");
    if(ob->move(TP, M_GET) != 1) {
        write(BS("Du kannst den Sangurit gerade nicht tragen."));
        destruct(ob);
        return -1;
    }

    sangurit = 0;
    write(BS("Du nimmst den Sangurit an dich. Sofort erstirbt zitternd alles Licht in der Hoehle..."));
    say(BS(TPN+" nimmt den Sangurit vom Podest. Sofort erstirbt zitternd alles Licht in der Hoehle..."));
    return 1;
}

public string detail_podest() {
    string str;

    str = "Das Kristallpodest ist aus dem selben Material, wie aller anderer Kristall um dich herum. "
          "Seine Oberflaeche ist glatt und glimmende Runen sind darin eingeschnitzt.";

    if(sangurit) {
        str += " Etwa eine handbreit ueber dem Podest schwebt ein faustgrosser, roetlicher Stein. Es ist ein "
               "Sangurit.";
    }

    return BS(str);
}

public string detail_sangurit() {
    if(!sangurit) return 0;

    return BS("Der Sangurit ist ein magischer Stein von blutroter Farbe. Wenn man ihn magisch auflaedt, "
              "heisst es, kann er sich mit einem Lebewesen verbinden und dessen Lebenskraft verstaerken.");
}

public int _query_light() {
    return sangurit;
}
