#include "../def.h"

inherit ROOM "std_drider";

private int spider;
private object seilCocoon;

public void create() {
    ::create();
    spider = 1;

    SetProp(P_INT_LONG, 
            "Du stehst hier auf einem sehr dicken Strang aus Spinnenseide. Eine duennere, "
            "nicht begehbware Spinnweben kleben an der Wand neben dir. Von der Decke tropft "
            "immer wieder ekelhafter Schleim herab.");

    AddSpecialDetail( ({"decke"}), "detail_decke");

    AddDetail(({"boden"}), "Der Boden ist mit einem dicken Teppich aus Spinnweben bedeckt.");
    AddDetail(({"schleim"}), "Der Schleim ist ekelhaft und klebrig.");
    AddDetail(({"spinnenseide"}), "Die Spinnenseide ist unglaublich stark und widerstandsfaehig.");
    AddDetail(({"spinnweben"}), "Die Spinnweben sind so dicht, dass man sie fast als Wand betrachten kann.");
    AddDetail(({"strang"}), "Der Strang aus Spinnenseide ist so dick, dass man darauf stehen kann.");
    AddDetail(({"waende", "wand"}), "Die Waende der Hoehle sind glatt und feucht.");
    AddDetail(({"wand"}), "An den Waenden der Hoehle kleben duennere Spinnweben.");
    AddDetail(({"hoehle"}), "Die Hoehle ist riesig und hoch. Die Decke ist kaum zu sehen.");
    AddDetail(({"teppich"}), "Der Teppich aus Spinnweben ist weich und daempft deine Schritte.");

    AddExit("nordwesten", ROOM "c2_a6_drider");
    AddExit("suedwesten", ROOM "c2_a8_drider");
    AddExit("westen", ROOM "c2_a7_drider");

    seilCocoon = createCocoon(OBJ "kletterseil");
}

public string detail_decke() {
    if(spider) {
        spider = 0;
        call_out("moveSpider", 0);
        return "Igitt! An der Decke haengt eine fette Hoehlenspinne, die auf dich herunterschleimt!\n";
    } else {
        return "Igitt! Von der Decke tropft ekelhafter Schleim auf dich herunter.\n";
    }
}

public void moveSpider() {
    object ob;
    ob = clone_object(NPC "hoehlenspinne");
    if(ob->move(TO, M_GO) != 1) {
        spider = 1;
        destruct(ob);
    }
}

public void reset() {
    ::reset();
    
    if(!objectp(present("\ngwenshara_evil_cave_spider"))) {
        spider = 1;
    } else {
        spider = 0;
    }

    if(!objectp(seilCocoon)) {
        seilCocoon = createCocoon(OBJ "kletterseil");
    }
}
