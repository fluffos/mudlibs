#include "../def.h"
#include <npcmaster.h>

#define OGER "\ngwenshara_evil_cave_oger"

inherit ROOM "std_hoehle";

private int leiter, schnur, ring;

public void create() {
    ::create();

    leiter = 0;
    schnur = 1;
    ring = 1;

    SetProp(P_INT_SHORT, "In einem dreckigen Loch");
    SetProp(P_INT_LONG, 
            "Der Boden dieses Lochs voller Dreck. Stinkende Haufen aus Abfall "
            "und Dreck tuermen sich hier ueberall. Links von dir, auf "
            "einem Knochenhaufen, liegen die halb aufgefressenen Ueberreste "
            "einer Leiche. Ein verdreckter, schimmliger Haufen Stroh scheint "
            "als eine Art Schlafstatt zu dienen. @@long_seil@@ @@long_leiter@@");

    AddItem( NPC "oger", REFRESH_DESTRUCT);

    AddCmd( CMD_KLETTERN, "cmd_kletter");
    AddCmd( ({"wuehle", "wuehl"}), "cmd_wuehlen");
    AddCmd( ({"durchsuche", "durchsuch"}), "cmd_durchsuchen");
    AddCmd( ({"bastel", "bastle"}), "cmd_basteln");

    AddDetail( ({"abfall"}),
        "Unzaehliges Geruempel und anderes Zeug, das wohl niemand mehr braucht liegt ueberall verstreut. "
        "Du regelrecht in diesem Muell wuehlen, um noch etwas Brauchbares zu finden.");

    AddDetail( ({"geruempel", "zeug"}),
        "Alte Flaschen, Kisten, Metallstangen, Steine und Holzstoecke.");

    AddDetail( ({"stoecke", "holzstoecke"}),
        "Das sieht aus wie die letzten Reste einer Leiter. Wenn du etwas haettest um sie zusammen zu binden "
        "koenntest du wohl eine echte Leiter basteln.");

    AddDetail( ({"brauchbares"}),
        "Was fuer den einen Muell ist, ist fuer den anderen ein wertvoller Rohstoff.");

    AddDetail( ({"stroh", "strihhaufen", "schlafstatt", "art"}),
        "Die Schlaffstatt besteht aus einem ekelhaft dreckigem Strohhaufen. Es wurde vom Gewicht des "
        "Ogers ganz festgepresst und ist mit allerleid unappetitliche, Dreck verkrustet. Darin koennte "
        "sich so mancher Schatz verstecken, den man nur bei genauem Durchsuchen finden wuerde.");

    AddDetail( ({"schatz"}), "Schwer zu sagen, wenn du nicht Hand anlegst.");
    
    AddDetail( ({"hand", "haende"}), "Deine Haende wuerden dabei dreckig werden.");

    AddDetail( ({"durchsuchen"}), "Das kann man nicht sehen, nur machen.");

    AddDetail(({ "boden" }), "Der Boden ist mit Dreck bedeckt und sieht aus, als ob er schon lange nicht mehr gereinigt wurde.");

AddDetail(({ "decke" }), "Die Decke ist mit Schmutz und Spinnweben bedeckt und wirkt instabil.");

AddDetail(({ "dreck" }), "Ueberall liegt Dreck herum, von alten Essensresten bis hin zu vermoderten Ueberresten.");

AddDetail(({ "flaschen" }), "Alte, zerschlagene Flaschen liegen verstreut herum, manche sind noch halb gefuellt mit undefinierbarem Inhalt.");

AddDetail(({ "gewicht" }), "Das Gewicht des Ogers hat den Boden stark eingedrueckt, was man an den tiefen Fussabdruecken erkennen kann.");

AddDetail(({ "haufen" }), "Verschiedene Haufen aus Muell und Unrat tuermen sich hier auf.");

AddDetail(({ "kisten" }), "Die Kisten sind vermodert und zerfallen langsam, ihr Inhalt ist groesstenteils verrottet oder von Nagern zerfressen.");

AddDetail(({ "knochenhaufen" }), "Ein grosser Haufen aus Knochen, einige noch mit Fleischresten behaftet, liegt hier links von dir.");

AddDetail(({ "leiche" }), "Die halb aufgefressenen Ueberreste einer Leiche liegen auf einem Knochenhaufen, von Fliegen umschwirrt.");

AddDetail(({ "lochs" }), "Die Loecher, die hier und da in den Waenden sind, fuehren in dunkle, unerforschte Gaenge.");

AddDetail(({ "metallstangen" }), "Verrostete Metallstangen liegen verstreut herum, einige davon haben scharfe Kanten.");

AddDetail(({ "muell" }), "Unzaehlige Gegenstaende, die einst von Wert waren, liegen hier herum und verrotten langsam im Dreck.");

AddDetail(({ "ogers" }), "Der fette Oger, der dieses Loch bewohnt, scheint seit langem nicht mehr herausgekommen zu sein.");

AddDetail(({ "rohstoff" }), "Der Muell koennte fuer einige als wertvoller Rohstoff dienen, fuer andere ist es einfach nur Abfall.");

AddDetail(({ "schlaffstatt" }), "Die Schlafstatt des Ogers besteht aus einem dreckigen Strohhaufen, der vor Dreck nur so strotzt.");

AddDetail(({ "steine" }), "Steine und Felsbrocken sind ueberall verstreut, einige sind locker und koennten als Wurfgeschosse dienen.");

AddDetail(({ "strohhaufen" }), "Ein grosser Haufen aus verdrecktem Stroh, auf dem der Oger vermutlich schlaeft, liegt hier.");

AddDetail(({ "ueberreste" }), "Die Ueberreste einer Leiche liegen halb verwest auf einem Knochenhaufen, von Ungeziefer zerfressen.");

AddDetail(({ "waende", "felswaende" }), "Die Waende des Lochs sind mit Moos bedeckt und feucht.");

AddDetail(({ "wand" }), "Die Wand ist feucht und mit Moos bedeckt, einige Stellen sind bereits eingestuerzt oder broeckeln.");

AddDetail(({ "essensresten" }), "Ueberreste von vergangenem Essen sind zwischen dem Muell verstreut, verrottend und von Ungeziefer befallen.");

AddDetail(({ "felsbrocken" }), "Grosse Felsbrocken liegen hier und da herum, einige sind locker und koennten sich als Wurfgeschosse eignen.");

AddDetail(({ "fleischresten" }), "Einige Knochen haben noch Fleischreste daran, von Maden umgeben und stark verwest.");

AddDetail(({ "fliegen" }), "Fliegen schwirren um die Ueberreste herum, angezogen von dem Verwesungsgeruch.");

AddDetail(({ "fussabdruecken" }), "Tiefe Fussabdruecke im Dreck zeugen von den schweren Schritten des Ogers.");

AddDetail(({ "gaenge" }), "Die dunklen Gaenge, die in den Fels fuehren, sind unheimlich und unerforscht.");

AddDetail(({ "gegenstaende" }), "Verschiedene Gegenstaende liegen im Muell verstreut, manche koennten noch von Wert sein.");

AddDetail(({ "inhalt" }), "Der Inhalt der Kisten ist groesstenteils verrottet oder von Nagern zerfressen.");

AddDetail(({ "kanten" }), "Einige der Metallstangen haben scharfe Kanten, die bei Beruehrung Verletzungen verursachen koennten.");

AddDetail(({ "knochen" }), "Knochen liegen ueberall herum, einige sind noch intakt, andere zerbrochen.");

AddDetail(({ "loch" }), "Das Loch ist dunkel und fuehrt in unerforschte Tiefen.");

AddDetail(({ "loecher" }), "Die Loecher in den Waenden sind dunkel und unheimlich, als ob sie in eine andere Welt fuehren wuerden.");

AddDetail(({ "moos" }), "Moos bedeckt die feuchten Waende der Hoehle, es fuehlt sich feucht und glitschig an.");

AddDetail(({ "nagern", "tiere", "tieren" }), "Nager haben sich an vielen der Gegenstaende zu schaffen gemacht, ihre Nagespuren sind ueberall sichtbar.");

AddDetail(({ "oger" }), "Der fette Oger, der diese Hoehle bewohnt, scheint seit langem nicht mehr herausgekommen zu sein.");

AddDetail(({ "reste" }), "Verschiedene Ueberreste liegen herum, von verrotteten Nahrungsmitteln bis hin zu verwesten Knochen.");

AddDetail(({ "schmutz" }), "Der Schmutz bedeckt alles in der Hoehle, es riecht modrig und unangenehm.");

AddDetail(({ "spinnweben" }), "Spinnweben haengen von der Decke und den Waenden, sie sind dick und klebrig.");

AddDetail(({ "stellen" }), "An einigen Stellen in den Waenden sind kleine Hoehlen und Nischen zu erkennen.");

AddDetail(({ "ungeziefer" }), "Ungeziefer krabbelt ueber den Muellhaufen und die Ueberreste, auf der Suche nach Nahrung.");

AddDetail(({ "unrat" }), "Unrat liegt ueberall herum, von verrotteten Lebensmitteln bis hin zu zerbrochenem Geschirr.");

AddDetail(({ "wert" }), "Einige der Gegenstaende koennten fuer jemanden noch von Wert sein, fuer andere sind sie einfach nur Muell.");

AddDetail(({ "wurfgeschosse" }), "Locker liegende Felsbrocken koennten als Wurfgeschosse verwendet werden, um Feinde abzuwehren.");

AddDetail(({ "beruehrung" }), "Einige der Gegenstaende koennten bei Beruehrung auseinanderfallen oder verrotten weiter.");

AddDetail(({ "essen" }), "Verrottete Essensreste liegen zwischen dem Muell, von Maden zerfressen und ungeniessbar.");

AddDetail(({ "feinde" }), "Feinde koennten sich in den dunklen Gaengen der Hoehle verbergen, man sollte vorsichtig sein.");

AddDetail(({ "fels" }), "Das Gestein der Hoehle ist grob und uneben, mit scharfen Kanten und rauen Oberflaechen.");

AddDetail(({ "fleischreste" }), "Verweste Fleischreste haengen noch an einigen der Knochen, von Maden umgeben und stinkend.");

AddDetail(({ "fussabdruecke" }), "Die tiefen Fussabdruecke im Dreck verraten die Anwesenheit des Ogers.");

AddDetail(({ "geschirr" }), "Zerbrochenes Geschirr liegt zwischen dem Muell, Reste einer vergangenen Zeit.");

AddDetail(({ "hoehle" }), "Die Hoehle ist dunkel und unheimlich, mit dunklen Gaengen, die in die Tiefen fuehren.");

AddDetail(({ "lebensmitteln" }), "Verrottete Lebensmittel liegen zwischen dem Muell, ungeniessbar und von Ungeziefer befallen.");

AddDetail(({ "maden" }), "Maden kriechen zwischen den verrotteten Ueberresten herum, sie sind eine Plage in der Hoehle.");

AddDetail(({ "muellhaufen" }), "Der Muellhaufen ist hoch und stinkend, eine Ansammlung von Abfall und Unrat.");

AddDetail(({ "nagespuren" }), "Nagespuren sind ueberall sichtbar, Zeichen der Aktivitaet von Nagern in der Hoehle.");

AddDetail(({ "nahrung" }), "Die Ueberreste koennten fuer das Ungeziefer eine Nahrung sein, aber fuer dich sind sie ungeniessbar.");

AddDetail(({ "nahrungsmitteln" }), "Verrottete Nahrungsmittel liegen zwischen dem Muell, von Ungeziefer zerfressen und unbrauchbar.");

AddDetail(({ "nischen" }), "Kleine Nischen und Hoehlen sind in den Waenden der Hoehle zu erkennen, vielleicht Verstecke fuer Ungeziefer.");

AddDetail(({ "schritten" }), "Die schweren Schritte des Ogers haben tiefe Abdruecke im Dreck hinterlassen.");

AddDetail(({ "suche" }), "Die Suche nach Wertvollem zwischen dem Muellhaufen ist muehsam und unangenehm.");

AddDetail(({ "tiefen" }), "Die dunklen Gaenge fuehren in die Tiefen der Hoehle, wo nur Dunkelheit herrscht.");

AddDetail(({ "verletzungen" }), "Bei unvorsichtiger Beruehrung besteht die Gefahr von Verletzungen durch scharfe Kanten oder herabfallende Gegenstaende.");

AddDetail(({ "verwesungsgeruch", "luft", "verwesung" }), "Der Gestank der Verwesung haengt schwer in der Luft.");

AddDetail(({ "welt" }), "Die Hoehle scheint eine eigene duestere Welt zu sein.");

AddDetail(({ "abdruecke" }), "Die Abdruecke im Dreck zeigen dass ein Oger hier sein Zuhause hat.");

AddDetail(({ "aktivitaet" }), "Die Aktivitaet von Nagern und anderen kleinen Tieren ist ueberall in der Hoehle spuerbar.");

AddDetail(({ "ansammlung" }), "Eine grosse Ansammlung von Muell und Abfall tuermt sich hier auf, ein Zeichen der Vernachlaessigung.");

AddDetail(({ "anwesenheit" }), "Die Anwesenheit des Ogers ist in jedem Winkel der Hoehle zu spueren.");

AddDetail(({ "dunkelheit" }), "Die Dunkelheit in der Hoehle ist erdrueckend.");

AddDetail(({ "essensreste", "mahlzeiten" }), "Essensreste liegen ueberall herum, ein Ueberreste vergangener Mahlzeiten.");

AddDetail(({ "gefahr" }), "Die Hoehle birgt viele Gefahren.");

AddDetail(({ "gestank" }), "Der Gestank der Verwesung haengt schwer in der Luft.");

AddDetail(({ "gestein" }), "Das Gestein der Hoehle ist grob und uneben, mit scharfen Kanten und rauen Oberflaechen.");

AddDetail(({ "lebensmittel" }), "Verrottete Lebensmittel liegen zwischen dem Muell, von Ungeziefer zerfressen und unbrauchbar.");

AddDetail(({ "menschen" }), "Die Hoehle ist nicht fuer Menschen, nur der Oger scheint sich hier heimisch zu fuehlen.");

AddDetail(({ "nahrungsmittel" }), "Verrottete Nahrungsmittel liegen zwischen dem Muell, von Ungeziefer zerfressen und unbrauchbar.");

AddDetail(({ "nahrungsquelle" }), "Die Ueberreste koennten fuer das Ungeziefer eine Nahrungsquelle sein, aber fuer Menschen sind sie ungeniessbar.");

AddDetail(({ "oberflaechen" }), "Die Oberflaechen der Felswaende sind rau und uneben, mit Moos bewachsen und feucht.");

AddDetail(({ "plage" }), "Die Maden sind eine Plage in der Hoehle, ihre Aktivitaet ist ueberall zu spueren.");

AddDetail(({ "schritte" }), "Die schweren Schritte des Ogers haben tiefe Abdruecke im Dreck hinterlassen.");

AddDetail(({ "verstecke" }), "Kleine Verstecke und Nischen in denen sich Ungeziefer versteckt.");

AddDetail(({ "wertvollem" }), "Wertvolle Gegenstaende koennten zwischen dem Muell verborgen sein, fuer den Oger jedoch nur Abfall.");

AddDetail(({ "zeichen" }), "Die Zeichen der Vernachlaessigung sind ueberall sichtbar.");

AddDetail(({ "zeit" }), "Die Zeit scheint in der Hoehle stillzustehen, eine duestere Welt fernab von der Zeit der Menschen.");



    AddSpecialDetail(({"leiter"}), "detail_leiter");
}

public string detail_leiter() {
    if(leiter) {
        return BS("Die Leiter wurde genau unter dem Loch errichtet. Du kannst an ihr nach oben raus klettern.");
    }

    return BS("Du koenntest eine basteln.");
}

public int cmd_basteln(string str) {
    object ob;

    notify_fail("Was willst du basteln?\n");
    if(!str || str == "") return 0;
    if(str != "leiter" && str != "eine leiter") return 0;

    if(!objectp(ob=present("\ngwenshara_evil_cave_string", this_player()))) {
        write(BS("Leider hast du nichts um die ganzen Stoecke zusammen zu binden."));
        return -1;
    }

    if(leiter) {
        write(BS("Jemand hat hier bereits eine Leiter aufgestellt."));
        return -1;
    }

    ob->remove(1);
    write(BS("Du bindest die Stoecke mit der Schnur zusammen und stellst die fertige Leiter auf."));
    say(BS(TPN + " bastelt eine Leiter und stellt sie auf."));
    leiter = 1;
    return 1;
}

public void reset() {
    ::reset();

    if(leiter && present(OGER)) {
        tell_room(this_object(), BS("Glugsch reisst mit seiner fetten Hand die Leiter um."));
        leiter = 0;
    }

    schnur = 1;
    ring = 1;
}

public int cmd_durchsuchen(string args) {
    object ob;

    notify_fail("Worin willst du wuehlen?\n");
    if(args != "stroh" && args != "haufen" && 
       args != "strohhaufen" && args != "schlafstatt") return 0;

    if(objectp(ob=present(OGER))) {
       write(BS("Da kommst du nicht ran, so lange der fette Oger darauf liegt!"));
        return -1;
    }

    say(BS(sprintf("%s durchsucht den Strohhaufen, der normal als Schlaffstatt dient.", this_player()->Name(WER))));
    if(!ring) {
        write(BS("Rasch durchsuchst du den schmimmligen Strohhaufen, findest aber nichts."));
        return -1;
    }


    ob = clone_object(OBJ "ringteil_1");
    write(BS("Rasch durchsuchst du den schimmligen Strohhaufen und findest einen Teil eines Metallrings."));
    if(ob->move(this_player(), M_GET) != 1) {
        write(BS("Leider kannst du ihn nicht mehr tragen und laesst ihn zurueck."));
        destruct(ob);
    } else {
        write(BS("Du steckst ihn sofort ein."));
        ring = 0;
    }
    
    return 1;
}

public int cmd_wuehlen(string args) {
    object ob;

    notify_fail("Worin willst du wuehlen?\n");
    if(args != "in muell" && args != "in muellhaufen" && args != "in haufen") return 0;

    say(BS(sprintf("%s durchwuehlt den Muellhaufen. Echt ekelhaft...", this_player()->Name(WER))));
    if(!schnur) {
        write(BS("Du durchwuehlst den ekelhaften Muell, kannst aber nichts Nuetzliches finden."));
        return -1;
    }


    ob = clone_object(OBJ "schnur");
    write(BS("Du durchwuehlst den ekelhaften Muell und findest tatsaechlich noch eine "
                "Schnur, die ganz brauchbar scheint."));
    if(ob->move(this_player(), M_GET) != 1) {
        write(BS("Leider kannst du sie nicht mehr tragen und laesst sie liegen."));
        destruct(ob);
    } else {
        write(BS("Du steckst sie sofort ein."));
        schnur = 0;
    }
    
    return 1;
}

public string long_seil() {
    if(call_other(ROOM "b3_b5_loch", "QueryHaken")) {
        return "Ein Seil haengt von oben herein.";
    }
    return "";
}

public string long_leiter() {
    if(leiter) {
        return "Jemand hat hier eine Leiter aufgestellt, mit der du hochklettern kannst.";
    }
    return "";
}

public int cmd_kletter(string args) {
    notify_fail("Wohin willst du klettern?\n");
    if(args != "rauf" &&
       args != "nach oben" &&
       args != "durch loch") return 0;

    if(!call_other(ROOM "b3_b5_loch", "QueryHaken") && !leiter) {
        write(BS("Das Loch ist zu weit oben. Ohne Hilfsmittel sitzt du hier fest."));
        return -1;
    }

    this_player()->move(ROOM "b3_b5_loch", M_GO, "nach oben", "klettert",
    "klettert durch das Loch heraus");
    return 1;
}

public void KillOger() {
    tell_room(TO, BS("Eine schwere Felskugel faellt von oben durch das Loch."));
    call_out("suelze", 0);
}

public void suelze() {
    object *inv;
    int i;

    if(!objectp(present(OGER))) return;

    tell_room(TO, BS("Sie faellt genau auf Glugsch und zerquetscht ihn zu Suelze."));
    call_other(ROOM "b3_b5_loch", "OgerSuelze");
    
    inv = all_inventory(present(OGER));
    for(i=0;i<sizeof(inv);++i) {
        if(objectp(inv[i])) inv[i]->remove(1);
    }

    present(OGER)->SetProp(P_NO_SCORE, 1);
    present(OGER)->die();
    return;
}