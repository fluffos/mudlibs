#include "../def.h"

inherit ROOM "std_drider";

public void create() {
    replace_program(ROOM "std_drider");
    ::create();

    SetProp(P_INT_LONG, 
            "Hier befindest du dich am westlichen Ende des grossen Netzes. Die Faeden "
            "sind hier nicht so dicht gewebt, so dass du unter dir die Schwaerze der "
            "scheinbar bodenlosen Hoehle erkennen kannst.");

    AddExit("nordosten", ROOM "c2_a6_drider");
    AddExit("suedosten", ROOM "c2_a8_drider");
    AddExit("osten", ROOM "c2_a7_drider");

    AddItem(NPC "drider", REFRESH_DESTRUCT);

    AddDetail(({ "boden" }), "Der Boden unter dir ist hier weniger dicht mit Spinnfaeden bedeckt, und du kannst die Schwaerze der Hoehle unter dir erkennen.");

    AddDetail(({ "decke" }), "Die Decke der Hoehle ist mit duennen Spinnfaeden bedeckt, die sich im schwachen Licht der Hoehle verlieren.");

    AddDetail(({ "ende" }), "Du befindest dich am westlichen Ende des grossen Spinnennetzes, wo die Faeden weniger dicht gewebt sind.");

    AddDetail(({ "faeden" }), "Die Spinnfaeden hier sind weniger dicht gewebt als in anderen Teilen des Netzes, und du kannst die Leere unter dir erkennen.");

    AddDetail(({ "hoehle" }), "Die Hoehle erstreckt sich unter dir in eine scheinbare Bodenlosigkeit, die nur von duennen Spinnfaeden unterbrochen wird.");

    AddDetail(({ "netzes" }), "Das Spinnennetz, das den Raum ausfuellt, erstreckt sich bis zum westlichen Ende, wo es weniger dicht gewebt ist.");

    AddDetail(({ "schwaerze" }), "Unter dir erstreckt sich die Schwaerze der Hoehle, die von den duennen Spinnfaeden durchbrochen wird.");

    AddDetail(({ "waende" }), "Die Waende der Hoehle sind von duennen Spinnfaeden umgeben, die sich bis zum westlichen Ende des Raums erstrecken.");

    AddDetail(({ "wand" }), "Die Wand des Raums ist mit duennen Spinnfaeden bedeckt, die sich bis zum westlichen Ende des Raums erstrecken.");

    AddDetail(({ "bodenlosigkeit" }), "Die Bodenlosigkeit der Hoehle erstreckt sich unter dir, waehrend du am westlichen Ende des Raums stehst und ueber das duennere Netz unter dir blickst.");

    AddDetail(({ "leere" }), "Die Leere unter dir scheint endlos zu sein, unterbrochen nur von den duennen Spinnfaeden, die das Spinnennetz bilden.");

    AddDetail(({ "licht" }), "Das Licht in der Hoehle ist schwach, und es wird von den duennen Spinnfaeden reflektiert, die den Raum ausfuellen.");

    AddDetail(({ "raum" }), "Der Raum, in dem du dich befindest, ist am westlichen Ende des grossen Spinnennetzes, das die Hoehle durchzieht.");

    AddDetail(({ "spinnennetz" }), "Das Spinnennetz erstreckt sich bis zum westlichen Ende des Raums, wo es weniger dicht gewebt ist.");

    AddDetail(({ "spinnennetzes" }), "Das Spinnennetz erstreckt sich bis zum westlichen Ende des Raums, wo es weniger dicht gewebt ist.");

    AddDetail(({ "spinnfaeden" }), "Die duennen Spinnfaeden bilden das Netz, das den Raum ausfuellt, und glaenzen im schwachen Licht der Hoehle.");

    AddDetail(({ "teilen" }), "Der Raum ist in diesem Bereich des Netzes weniger dicht gewebt, wodurch du einen Blick auf die Leere unter dir erhaschen kannst.");


}
