#include "../def.h"

inherit ROOM "std_hoehle";

int element1, element2, element3, element4, element5;

public void create() {
    ::create();

    SetProp(P_INT_SHORT, "Am Tor Marzarlexsch");
    SetProp(P_INT_LONG, 
            "Du stehst hier in einer weit geoeffnete, gigantisch grossen Hoehle. "
            "Von der Decke quaelen sich einige wenige Lichtstrahlen durch die "
            "diffuse Dunkelheit zwischen unzaehligen Stalaktiten herab. Am Boden "
            "findest du die zersprengten Reste gigantische Stalakmiten, die "
            "von unermesslichen Kraeften zerschmettert wurden. Sechs weitere "
            "Gaenge gehen von dieser Hoehle ab."
            "In Mitten dieser riesigen Hoehle wurde eine Metallplatte eingelassen. "
            "Um diese herum ist eine Einbuchtung, wie von einem grossen Ring.");

    SetProp(P_LIGHT, 1);

    AddDetail( ({"platte", "metallplatte"}),
        "Die Metallplatte wurde mitten in der Hoehle eingelassen. Sie ist von einer "
        "ringfoermigen Einbuchtung umgeben und mit mystischen Runen ueberzogen.");

    AddDetail( ({"runen"}),
        "Es handelt sich um schwach golden glimmende Runen des Schutzes. Es scheint dir, dass "
        "diese Platte zu einem groesseren Schutzzauber gehoert.");

    AddDetail( ({"schutzzauber", "zauer"}),
        "Offenbar ist dies eine Art zweiteiliger Schutzzauber.");

    AddSpecialDetail( ({"einbuchtung", "ring"}), "detail_ring");

    AddExit("sueden", ROOM "b6_b3");
    AddExit("norden", ROOM "b6_b1");
    AddExit("osten", ROOM "b7_b2");
    AddExit("suedosten", ROOM "b7_b3");
    AddExit("westen", ROOM "b5_b2");
    AddExit("suedwesten", ROOM "b5_b3");

    AddCmd( ({"setze", "setz"}), "cmd_einsetzen");
}

public int cmd_einsetzen(string str) {
    object ob;
    string fn;
    int rnr;

    notify_fail("Was willst du einsetzen?\n");
    if(!str || str == "") return 0;
    if(str != "teil ein" && str != "ringteil ein" && str != "teil eines metallrings ein" &&
       str != "teil in einbuchtung" && str != "ringteil in einbuchtung" && str != "metallring ein" &&
       str != "etallring in einbuchtung") return 0;

    if(!objectp(present("\ngwenshara_evil_cave_ringart", TP))) {
        write(BS("Du hast kein passendes Teil bei dir."));
        return -1;
    }

    while(objectp(ob=present("\ngwenshara_evil_cave_ringart", TP))) {
        fn = explode(file_name(ob), "#")[0];
        write(fn);
        rnr = to_int(fn[strlen(fn)-1..strlen(fn)-1]);
        if(rnr == 1 && element1 || rnr == 2 && element2 || rnr == 3 && element3 || rnr == 4 && element4 || rnr == 5 && element5) {
            write(BS("Dieses Ringteil wurde bereits eingesetzt und zerfaellt."));
            ob->remove(1);
            continue;
        }

        write(rnr);
        write(BS("Du setzt "+ob->name(WEN)+" in die Einbuchtung."));
        say(BS(TPN+" setzt "+ob->name(WEN)+" in die Einbuchtung."));
        if(rnr==1) element1 = 1;
        if(rnr==2) element2 = 1;
        if(rnr==3) element3 = 1;
        if(rnr==4) element4 = 1;
        if(rnr==5) element5 = 1;
        ob->remove(1);
    }

    if(element1 && element2 && element3 && element4 && element5) {
        call_out("openTheGate", 4);
        tell_room(TO, BS("Dur Runen auf der Metallplatte leuchten golden auf."));
    }

    return 1;
}

public void openTheGate() {
    call_other(ROOM "b5_a9", "openDoor");
    element1 = element2 = element3 = element4 = element5 = 0;
    tell_room(TO, BS("Du hoerst ein lautes Rumpeln aus dem noerdlichen Teil des Hoehlenkomplexes."));
    return;
}

public string detail_ring() {
    string str;

    str = "Eine ringfoermige Einbuchtung verlaeuft um die Platte herum.";

    if(!element1 && !element2 && !element3 && !element4 && !element5) {
        str += " Es scheint, als wuerde man hier etwas einsetzen koennen.";
    } else {
        if(element1) str += " Ein bleierner Ringteil wurde eingesetzt.";
        if(element2) str += " Ein diamantenes Ringteil wurde eingesetzt.";
        if(element3) str += " Ein gluehendes Ringteil wurde eingesetzt.";
        if(element4) str += " Ein blutrotes Ringteil wurde eingesetzt.";
        if(element5) str += " Ein schwarzes Ringteil wurde eingesetzt.";
    }

    return BS(str);
}
