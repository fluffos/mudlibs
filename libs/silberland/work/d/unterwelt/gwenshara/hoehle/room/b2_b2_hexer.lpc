#include "../def.h"

inherit ROOM "std_hoehle";

private int erloest;

public void create() {
    ::create();
    erloest=0;

    SetProp(P_INT_SHORT, "In einer kuehlen Hoehle voller Toter");
    SetProp(P_INT_LONG, 
            "Ein kalter Schauer laeuft dir den Ruecken hinab, als du "
            "diese Hoehle betrittst. Sie scheint natuerlich im Fels "
            "gewachsen zu sein. Was auf gar keinen Fall natuerlich ist, "
            "sind das gute Dutzend Leichen, die hier an Haken von "
            "der Decke herab haengen.");
    SetProp( P_ENVIRONMENT, ([ ENV_TEMPERATURE:5, ENV_TERRAIN:TT_CAVE ]) );

    AddDetail( ({"leichen", "dutzend"}), "Gut ein Dutzend Leichen haengen hier auf Haken von der Decke herab. Sie alle sind von unterschiedlichen Rassen.");

    AddDetail(({"rassen"}), "Du erblickst die uebel zugerichteten Leichen von Elfen, Zwergen und Menschen. Eine Zwergenleiche "
                            "baumelt leicht.");

    AddDetail(({"zwergenleiche", "sterbende"}), "Es scheint als wuerde sie gerade noch so leben. Murmelt der Sterbende noch ein paar letzte Worte?");

    AddDetail(({"worte"}), "Du kannst sie nicht sehen. Nur hoeren.");

    AddSound(({"worten", "worte", "leiche", "zwergenleiche", "zwerg", "sterbender", "sterbende", "sterbenden"}), 
       "Der sterbende Zwerg murmelt kaum hoerbar: 'Erloese mich... bitte...'");

    AddDetail(({"boden"}), "Der Boden der Hoehle ist mit einer duennen Schicht aus feuchtem Schmutz bedeckt.");

    AddDetail(({"decke"}), "Die Decke der Hoehle ist von duesteren Schatten ueberzogen, die sich unheimlich bewegen, als ob sie ein Eigenleben haetten.");
    
    AddDetail(({"elfen"}), "Die Elfenleichen sehen besonders makaber aus, ihre zarten Koerper wirken jetzt entstellt und verdreht.");
    
    AddDetail(({"fall"}), "Ein kalter Schauer laeuft dir ueber den Ruecken, als du ueber einen losen Felsen stolperst und beinahe faellst.");
    
    AddDetail(({"fels", "felsen", "felsens"}), "Der Fels, aus dem diese Hoehle zu bestehen scheint, ist von Rissen durchzogen.");
    
    AddDetail(({"haken"}), "Die Haken an der Decke sind rostig und scheinen sich vor Jahren in die Felsen gebohrt zu haben.");
    
    AddDetail(({"hoehle"}), "Die Hoehle ist mit einer bedrueckenden Atmosphaere erfuellt, die jeden Atemzug schwer macht und das Gefuehl vermittelt, als ob die Waende langsam enger werden.");
    
    AddDetail(({"menschen"}), "Die Leichen der Menschen wirken wie stumme Zeugen eines schrecklichen Massakers, ihre leeren Augen starren ins Nichts.");
    
    AddDetail(({"ruecken"}), "Dein Ruecken kribbelt, als ob jemand dir eiskalte Finger darueber laufen laesst.");
    
    AddDetail(({"schauer"}), "Ein eisiger Schauer laeuft dir den Ruecken hinunter, als wuerden unsichtbare Augen dich beobachten.");
    
    AddDetail(({"waende", "wand"}), "Die Waende der Hoehle sind mit dunklen Flecken bedeckt, die wie Blut aussehen und einen unangenehmen Geruch verbreiten.");
    
    AddDetail(({"atemzug"}), "Jeder Atemzug fuehlt sich an, als wuerdest du den muffigen Geruch des Todes direkt in deine Lungen saugen.");

    AddDetail(({"lungen"}), "Die sind in dir drin.");

    AddDetail(({"atmosphaere", "angst", "verzweiflung", "schrecken"}), "Die Atmosphaere der Hoehle ist mit Angst und Verzweiflung durchtraenkt, als ob die Waende selbst deine duestersten Gedanken aufsaugen wuerden.");

    AddDetail(({"gedanken"}), "Es ist, als wuerde eine fremde Praesenz in deinen Gedanken wispern.");
    
    AddDetail(({"praesenz"}), "Unheimlich...");

    AddDetail(({"augen"}), "Die leeren Augen der Leichen starren dich ausdruckslos an.");

    AddDetail(({"blut"}), "Hier und dort sind dunkle Flecken auf dem Boden zu sehen, die aussehen wie getrocknetes Blut, das sich mit dem Schmutz vermischt hat.");

    AddDetail(({"eigenleben"}), "Die Schatten an der Decke scheinen ein Eigenleben zu fuehren.");

    AddDetail(({"elfenleichen"}), "Die Leichen der Elfen sind besonders grausam anzusehen, ihre einst edlen Koerper sind jetzt entstellt und von Verwesung gezeichnet.");

    AddDetail(({"finger"}), "Es fuehlt sich an, als ob unsichtbare Finger ueber deinen Ruecken gleiten.");

    AddDetail(({"flecken"}), "Die dunklen Flecken an den Waenden koennten Blut sein.");

    AddDetail(({"gefuehl", "beklemmung"}), "Ein unangenehmes Gefuehl der Beklemmung umgibt dich.");

    AddDetail(({"geruch"}), "Ein widerlicher Geruch von Verwesung steht hier, verstaerkt durch den modrigen Geruch des feuchten Felsens.");

    AddSmell(({"verwesung", "fleisch"}), "Es richt nach verrottendem Fleisch.");

    AddDetail(({"jahren"}), "Die Haken scheinen seit Jahren in der Decke verankert zu sein, als ob sie dort fuer immer festgeklebt waeren.");

    AddDetail(({"koerper", "alptraum", "szene"}), "Die verkrueppelten Koerper der Leichen erinnern an eine verstoerende Szene aus einem Alptraum.");

    AddDetail(({"massakers"}), "Die Leichen sind stumme Zeugen eines blutigen Massakers, das sich in dieser Hoehle zugetragen haben muss.");

    AddDetail(({"mustern"}), "Die unheimlichen Muster im Fels scheinen sich langsam zu bewegen.");

    AddDetail(({"nichts"}), "Das Nichts der Hoehle scheint dich zu verschlucken, als ob es ausser den Schatten nichts weiter gaebe.");

    AddDetail(({"rissen", "risse"}), "Die Risse im Fels sehen aus, als wuerden sie sich langsam ausdehnen.");

    AddDetail(({"schatten"}), "Die Schatten an der Decke scheinen sich zu bewegen und zu formen, als ob sie lebendig waeren.");

    AddDetail(({"schicht"}), "Eine duestere Schicht aus Schmutz bedeckt den Boden der Hoehle.");

    AddDetail(({"schmutz"}), "Der Schmutz auf dem Boden der Hoehle steht knoechelhoch am Boden.");

    AddDetail(({"sprache"}), "Die seltsamen Symbole an der Wand scheinen eine Sprache zu sein, die du nicht verstehst.");

    AddDetail(({"zeugen"}), "Die Leichen sind stumme Zeugen der Schrecken, die sich in dieser Hoehle abgespielt haben.");


    AddExit("osten", ROOM "b3_b2");
    AddExit("norden", ROOM "b2_b1_hexer");
    AddExit("westen", ROOM "b1_b2_hexer");
    AddExit("sueden", ROOM "b2_b3_hexer");

    AddCmd( ({"erloese", "erloes"}), "cmd_erloesen");
    AddCmd( ({"befreie", "befrei"}), "cmd_befreien");
}

public int cmd_erloesen(string str) {
    notify_fail("Wen willst du erloesen?\n");
    if(str == "" || !str) return 0;
    if(str != "zwerg" && str != "sterbenden" && str != "leiche") return 0;

    if(erloest) {
        write(BS("Hier lebt niemand mehr."));
        return -1;
    }

    write(BS("Kunstfertig haeltst du dem Sterbenden Mund und Nase zu bis er aufhoert sich zu bewegen..."));
    say(BS(TPN + " werkt an einer der Leichen herum."));
    erloest = 1;

    TP->QueryProp(P_ALIGN, TP->QueryProp(P_ALIGN) - 50);
    return 1;
}

public int cmd_befreien(string str) {
    object ob;
    notify_fail("Wen willst du befreien?\n");
    if(!str || str == "") return 0;
    if(str != "sterbenden" && str != "leiche" && str != "zwerg") return 0;

    if(erloest) {
        write(BS("Hier sind alle tot. Niemand mehr zu befreien."));
        return -1;
    }

    write(BS("Rasch befreist du den Sterbenden von dem Haken."));
    say(BS("Hebt eine der Leichen von ihrem Haken. Offenbar war die arme Seele noch gar nicht tot!"));
    ob = clone_object("sterbender");
    ob->command_me("sag Danke, " + TPN + "!");
    ob->command_me("sag Ich verdanke dir mein Leben und werde dir helfen.");
    TP->AddDefender(ob);
    TP->AddPursuer(ob);

    TP->QueryProp(P_ALIGN, TP->QueryProp(P_ALIGN) + 100);
    return 1;
}