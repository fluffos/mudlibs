#include "../def.h"

inherit ROOM "std_hoehle";

private int entfernt, saege;

public void create() {
    ::create();

    SetProp(P_INT_SHORT, "Ein unterirdischer Garten");
    SetProp(P_INT_LONG, "Die unterirdische Hoehle oeffent sich hier, vollkommen ueberraschend, "
                        "zu einem duftenden Garten. Obwohl du ueber dir eindeutig eine Hoehlendecke "
                        "erkennen kannst, ist alles von einem sanft gluehenden Licht durchflutet, "
                        "das allem eine leicht roetliche Faerbung verleiht. Der Boden ist von einem "
                        "seltsam gruenen Moos bedeckt und an den Waenden um dich herum winden sich "
                        "Ranken mit dicken Dornen, auf denen schwarze Fruechte wachsen.");

    AddExit("osten", ROOM "c1_b4_garten");
    AddExit("westen", ROOM "b9_b4");

    AddDetail( ({"ranken"}),
    "An den Waenden findest du dichte Ranken, die sich in Wellen darueber schlaengeln. Sie scheinen "
    "sich leicht zu bewegen, als wuerden sie leben...");

    AddDetail( ({"wellen"}),
    "Die Ranken wallen in Wellen die Felswaende hinab. Dabei bewegen sie sich leicht. Eine Welle sieht "
    "irgendwie seltsam aus.");

    AddSpecialDetail( ({"welle"}), "detail_welle");

    AddSpecialDetail( ({"saege", "holzseaege"}), "detail_saege");

    AddDetail( ({"hinsehen"}),
    "Dazu muesstest du die Ranken wohl entfernen.");

    AddSpecialDetail( ({"gartengeraete"}), "detail_gartengeraete");

    AddDetail(({"boden"}), "Der Boden ist mit einem seltsam gruenen Moos bedeckt.");

    AddDetail(({"decke", "hoehlendecke"}), "Über dir erstreckt sich eine deutlich erkennbare Hoehlendecke.");

    AddDetail(({"dornen"}), "An den Ranken entlang wachsen dicke Dornen, die eine gewisse Gefahr darstellen.");

    AddDetail(({"faerbung"}), "Alles in dieser Hoehle hat eine leichte roetliche Faerbung, verursacht durch das sanft gluehende Licht.");

    AddDetail(({"felswaende", "waende", "wand"}), "Die Felswaende um dich herum sind mit Ranken bedeckt und geben der Hoehle eine organische Atmosphaere.");

    AddDetail(({"fruechte"}), "An einigen der Dornenranken wachsen schwarze Fruechte, die seltsam aussehen.");

    AddDetail(({"garten"}), "Diese unterirdische Hoehle wirkt wie ein ueberraschender Garten, voller Leben und Duft.");

    AddDetail(({"hoehle", "ort"}), "Die Hoehle ist ueberraschend schoen gestaltet und erinnert eher an einen Garten als an eine dunkle Hoehle.");

    AddDetail(({"licht"}), "Ein sanft gluehendes Licht durchflutet die Hoehle  und verleiht allem eine leicht roetliche Faerbung.");

    AddDetail(({"moos"}), "Ein seltsam gruenes Moos bedeckt den Boden der Hoehle.");

    AddDetail(({"atmosphaere"}), "Die Atmosphaere hier ist lebendig und voller geheimnisvoller Energie.");

    AddDetail(({"dornenranken"}), "Die Ranken sind mit dicken Dornen bewehrt und stellen eine potenzielle Gefahr dar.");

    AddDetail(({"duft"}), "Ein betoerender Duft liegt in der Luft, der die Hoehle mit einer angenehmen Aura erfuellt.");

    AddDetail(({"gefahr"}), "Die dicken Dornen entlang der Ranken stellen eine deutliche Gefahr dar.");

    AddDetail(({"leben"}), "Die Hoehle ist erfuellt von einem Gefuehl des Lebens, obwohl er unterirdisch ist.");

    AddDetail(({"raum"}), "Diese Hoehle  strahlt eine gewisse angenehme Aura aus, die ihn von anderen Hoehlen unterscheidet.");
    
    AddDetail(({"aura"}), "Eine mysterioese Aura umgibt diesen Ort, die eine gewisse Anziehungskraft ausstrahlt.");

    AddDetail(({"anziehungskraft"}), "Irgendetwas wirkt hier fast schon hypnotisierend.");

    AddDetail(({"energie"}), "Eine unbestreitbare Energie durchdringt diesen Raum, verleiht ihm Leben.");

    AddDetail(({"gefuehl"}), "Ein seltsames Gefuehl der Benommenheit erfuellt diesen Raum.");

    AddDetail(({"benommenheit"}), "Je laenger du hier stehst, desto benommener fuehlst du dich. Das muss etwas in der Luft sein.");

    AddDetail(({"luft", "hauch"}), "Die Luft hier ist frisch und rein, vermischt mit einem Hauch von geheimnisvollem Duft.");



        AddCmd("entferne|entfern&ranke|ranken", "cmd_entfernen", "Was willst du entfernen?");
        AddCmd("nimm|nehme&saege|holzsaege", "cmd_nimmsaege");

        entfernt = 0;
        saege = 1;
    }

    public int cmd_entfernen() {
        object ranke;

        if(objectp(present("\ngwenshara_hoehle_living_wine"))) {
            write(BS("Du versucht die Ranke zu entfernen und sie sticht dich in die Hand!"));
            TP->AddHP(-10);
            say(BS(TPN+" greift nach der lebendigen Ranke und wird von ihr gestochen."));
            return -1;
        }

        if(entfernt) {
            write(BS("Die Ranken wurden bereits entfernt."));
            return -1;
        }

        write(BS("Du zupfst an den Ranken um sie zu entfernen. Ploetzlich merkst du, dass eine von ihnen tatsaechlich lebendig ist! "
                "Wie eine Schlange zuckt und peitscht sie nach dir."));
        say(BS(TPN+" zupft an den Ranken herum. Ploetzlch zuckt und peitscht eine, die offenbar lebendig ist, hervor!"));

        ranke = clone_object(NPC "living_vine");
        ranke->move(TO, M_SILENT|M_GO);
        entfernt = 1;
        return 1;
    }

    public int cmd_nimmsaege() {
        object ob;

        if(!entfernt){
            write(BS("So einfach geht das nicht."));
            return -1;
        }

        if(objectp(present("\ngwenshara_hoehle_living_wine"))) {
            write(BS("Als du zur Saege greifts sticht dich die lebendige Ranke in die Hand!"));
            TP->AddHP(-10);
            say(BS(TPN+" greift nach der lebendigen Ranke und wird von ihr gestochen."));
            return -1;
        }

        if(!saege) {
            write(BS("Hier ist gerade keine Saege."));
            return -1;
        }

        ob = clone_object(OBJ "saege");
        if(ob->move(TP, M_GET) != 1) {
            write(BS("Da du die Saege gerade nicht tragen kannst laesst du sie hier."));
            ob->remove(1);
            return -1;
        }

        write(BS("Du nimmst die Saege."));
        say(BS(TPN+" nimmt eine Saege."));
        saege = 0;
        return 1;
    }

    public string detail_welle() {
        if(!entfernt) return BS("Bei genauerem Hinsehen stellst du fest, dass sich etwas unter den Ranken verbergen muss.");
        if(objectp(present("\ngwenshara_hoehle_living_wine"))) 
            return BS("Die Welle wird offenbar von einer lebenden Ranke gebildet, die sich ueber ein paar Gartengeraete windet.");
        return BS("Die Welle entsteht dadurch, dass sich einige Gartengeraete unter den Ranken verbergen.");
    }

    public string detail_gartengeraete() {
        if(!entfernt) return 0;
        if(objectp(present("\ngwenshara_hoehle_living_wine"))) 
            return BS("Die lebendige Ranke windet sich so davor, dass du nichts erkennen kannst.");

        if(saege) return BS("Hier stehen ein paar typische Gartengeraete herum. Darunter auch eine Holzsaege.");

        return BS("Hier stehen paar typische Gartengerate herum. Eigentlich voll uninteressant.");
    }

    public string detail_saege() {
        if(!entfernt || !saege) return 0;
        if(objectp(present("\ngwenshara_hoehle_living_wine"))) 
            return BS("Die lebendige Ranke windet sich so davor, dass du nichts erkennen kannst.");

        return BS("Die Holzsaege sieht noch einigermassen verwendbar aus. Wenn du sie benoetigst kannst du sie sicher mitnehmen.");
    }

    public void reset() {
        ::reset();
        entfernt = 0;
        saege = 1;
    }
