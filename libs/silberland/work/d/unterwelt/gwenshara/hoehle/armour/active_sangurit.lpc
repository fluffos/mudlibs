#include "../def.h"

inherit "std/armour";

private int soakedXp, lastXp;

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine rot gluehender Sanguritsplitter");
  SetProp(P_LONG,
    "Dieser Sangurit ist in deine Brust eingebettet. Er ist von magischer Kraft "
    "durchzogen und mit deiner Lebensessenz verbunden..");

  SetProp(P_INFO, "Der Sanguritsplitter zehrt von freigesetzter Seelenkraft und "
                  "kann deine Lebenskraft verstaerken.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Sanguritsplitter");
  SetProp(P_GENDER, MALE);
  AddId( ({"splitter", "sanguritsplitter", "\ngwenshara_cave_sangurite_active"}) );

  SetProp(P_NAME_ADJ, "gluehend" );
  AddAdjective( ({"gluehender","gluehenden","gluehendem","gluehende"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MISC_MAGIC: 100]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 100000);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WORN_TEXT, "in die Brust eingebettet");
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);
  SetProp(P_REMOVE_FUNC, TO);
  SetProp(P_DEFEND_FUNC, TO);
  SetProp(P_WEAR_FUNC, TO);
}

public string extra_look() {
  if(objectp(QueryProp(P_WORN))) 
    return sprintf("Ein gluehender Sanguritsplitter ist in %s Brust eingebettet.\n", CAP(QueryProp(P_WORN)->QueryPossPronoun(FEMALE, WEN)));
  return 0;
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  object pl;
  int xpGain;

  pl = QueryProp(P_WORN);
  
  if(!objectp(pl)) return 0;

  if(!random(10000)) {
    tell_object(pl, BS("Der Sanguritsplitter wird genau getroffen und zerbricht!"));
    remove(1);
  }

  if(!random(3)) {
    xpGain = pl->QueryProp(P_XP) - lastXp;
    if(xpGain > 0) {
      pl->AddExp(-(xpGain/10)); // 10% XP werden verschluckt...
      soakedXp += (xpGain/10);
      if(!random(20)) {
        tell_object(pl, BS("Der Sanguritsplitter absorbiert mit einem Gluehen einen Teil der freigsetzten Seelenkraft."));
      }
    }
  }

  lastXp = pl->QueryProp(P_XP);

  return 0;
}

public int WearFunc(object me) {
  if(me != TO) return 1;

  lastXp = TP->QueryProp(P_XP);
  return 1;
}

public int RemoveFunc(object me) {
  if(me != TO) return 0;

  tell_object(TP, BS("Du kannst den Sanguritsplitter nicht mehr loswerden!"));
  return 0;
}

public void reset() {
  object pl;
  int bonus;

  ::reset();

  if(!is_clone(TO)) return;
  if(!objectp(pl=QueryProp(P_WORN))) {
    remove();
    return;
  }

  bonus = soakedXp/250000;
  if(bonus>5) bonus = 5;
  if(bonus<0) bonus = 0;

  SetProp(P_X_HEALTH_MOD,([P_HP:bonus]));
  SetProp(P_X_MAX_HEALTH_MOD,([P_HP:bonus]));
  pl->UpdateAttributes();

  tell_object(pl, BS("Der Sanguritsplitter in deiner Brust leuchtet rot auf und Kraft durchstroemt dich."));
  pl->AddHp(5 + bonus*5 + random(bonus*5));
}

public int QuerySoakedXp() {
  return soakedXp;
}