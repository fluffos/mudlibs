#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Nachtrobe");
  SetProp(P_LONG,
    "Diese lange Robe ist Schwarz, wie die nacht selbst. Einige eingwebte "
    "Einschluesse glitzern und Funkeln, wie Sterne am Nachthimmel. Eine "
    "merkwuerdige aber unheimliche Faszination geht vom Glitern dieser "
    "Robe aus.");
  SetProp(P_INFO, BS("Diese Robe wird oft von finsteren Zauberern getragen, "
                     "die sich der Finsternis und Nacht verschreiben."));

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Nachtrobe");
  SetProp(P_GENDER, MALE);
  AddId( ({"robe", "nachtrobe"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_CLOTH: 80, MAT_DIAMOND: 10, MAT_MISC_UNHOLY: 10]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 6000);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5);

  SetProp(P_NEKRO_BONUS, (["strahlen der dunkelheit":10,
                           "schrecken der finsternis":10]));
  SetProp(P_NEKRO_SPELLCOST, 5);
}

int WearFunc(object me)
{
  return 1;
}

int RemoveFunc(object me)
{
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  return 0;
}
