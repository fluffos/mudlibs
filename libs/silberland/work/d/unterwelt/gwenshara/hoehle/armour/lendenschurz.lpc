#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein dreckiger Lendenschurz");
  SetProp(P_LONG,
    "Ein paar dreckige Lumpen wurden zu einem primitven Lendenschurz "
    "zusammen gebunden.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Lendenschurz");
  SetProp(P_GENDER, MALE);
  AddId( ({"schurz", "lendenschurz"}) );

  SetProp(P_NAME_ADJ, "dreckig" );
  AddAdjective( ({"deckigen","dreckiger","dreckigem","dreckiges","dreckige"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_CLOTH: 95, MAT_SHIT: 5]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 10);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 2);
}

int WearFunc(object me)
{
  return 1;
}

int RemoveFunc(object me)
{
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  return 0;
}
