#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Helm des gefallenen Paladins");
  SetProp(P_LONG,
    "Dieser Vollvisierhelm ist alt und verbeult. Die einst goldenen Einlegearbeiten "
    "sind stumpf und abgeschlagen. Einst war sein Traeger wohl ein gluehender "
    "Verehrer Dustys, doch jetzt ist dies nicht mehr als ein Ueberbleibsel einer "
    "verlorenen Seele.");
  SetProp(P_INFO, BS("Es wurde Dusty wohl gefallen, wenn du ihr diesen Helm "
                     "zurueck bringst und die Seele des gefallenen Paladin "
                     "Ruhe findet."));

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Helm des gefallenen Paladins");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "paladinhelm"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_STEEL: 90, MAT_GOLD: 10]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 200);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 10);

  SetProp(P_NEKRO_BONUS, (["all": 10]));
  SetProp(P_NEKRO_SPELLCOST, 10);

  AddCmd(({"opfer", "opfere"}), "cmd_opfern");
}

public int cmd_opfern(string str) {
  object nhelm;
  if(file_name(ENV(TP)) != "/gilden/paladine") return 0;
  if(!id(str)) return 0;

  write(BS("Du kniest nieder und bietest Dusty den Helm als Opfer dar. Im selben Moment "
           "erscheint neben dir der Geist des gefallenen Paladins Alsatar, der in einer Saeule "
           "aus Licht in den Himmel hochfaehrt. Ein erleichtertes Seufzen erschallt. Der Helm "
           "Strahlt in goettlichem Glanz auf!"));
  say(BS(TPN+" kniet nieder und bietest Dusty einen Helm als Opfer dar. Im selben Moment "
  "erscheint neben "+TPN+" der Geist eines gefallenen Paladins, der in einer Saeule "
  "aus Licht in den Himmel hochfaehrt. Ein erleichtertes Seufzen erschallt. Der Helm "
  "Strahlt in goettlichem Glanz auf!"));

  nhelm = clone_object(ARMOUR "palahelm_cleansed");
  nhelm->move(TP, M_NOCHECK);
  call_out("remove", 0 , 1);
  return 1;
}
