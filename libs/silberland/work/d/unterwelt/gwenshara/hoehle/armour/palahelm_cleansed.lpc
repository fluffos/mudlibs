#include "../def.h"
#include "/gilden/paladine/paladin_extern.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Helm der gelaeuterten Seele");
  SetProp(P_LONG,
    "Dieser Vollvisierhelm ist strahlend blank poliert und bestens in Schuss. "
    "Die goldenen Einlegearbeiten in Form von Rosen und Schwertern strahlen "
    "eine ungeheure Wuerde und Erhahebenheit aus. Der einstige Traeger dieses "
    "Helms war ein Paladin, der vom Glauben abfiel, doch nun on Dusty erloest ist.");
  SetProp(P_INFO, BS("Dieser Helm wird von einem heiligen Diener der Dusty bewacht."));

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Helm der gelaeuterten Seele");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "paladinhelm"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_STEEL: 90, MAT_GOLD: 10]) );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 200);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 10);

  SetProp(P_PALADIN_SPELLCOST, 15);

  SetProp(P_DEFEND_FUNC, TO);
}

public int DefendFunc(string *dtyp, mixed spell, object enemy) {
  if(!random(100)) {
    tell_object(QueryProp(P_WORN), BS("Der Helm des gelaeuterten Paladin wird von einer goldenen Aura erhellt."));
    return 10+random(20);
  }

  if(enemy->QueryProp(P_ALIGN) < 0 && !random(1005+enemy->QueryProp(P_ALIGN))) {
    tell_room(ENV(enemy), BS(enemy->Name(WER)+" wird von einer heiligen Aura verbrannt."));
    enemy->AddHp(-10);
  }

  return 0;
}
