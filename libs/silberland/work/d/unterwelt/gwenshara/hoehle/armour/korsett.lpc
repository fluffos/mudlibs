#include "../def.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine hautenges Lederkorsage");
  SetProp(P_LONG,
    "Diese Korsage ist aus einem dir unbekannten Leder gefertigt. Es ist "
    "schwarz und hauteng. Wohl nicht sehr praktisch, dafuer um so besser "
    "im Aussehen.");

  SetProp(P_INFO, "Die Korsage schuetzt besonders gut vor Angriffen von Maennern.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Lederkorsage");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"korsage", "lederkorsage"}) );

  SetProp(P_NAME_ADJ, "hauteng" );
  AddAdjective( ({"hautengen","hautenges","hautengem","hautenge"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_LEATHER: 100]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 1000);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_MISC );
  SetProp(P_AC, 0);

  SetProp(P_DEFEND_FUNC, TO);
}

public string extra_look() {
  if(objectp(QueryProp(P_WORN))) 
    return sprintf("%s traegt eine besonders gut aussehende Lederkorsage.\n", CAP(QueryProp(P_WORN)->QueryPronoun()));
  return 0;
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  if(!objectp(enemy)) return 0;
  if(enemy->QueryProp(P_GENDER) == MALE) return random(10);
  return 0;
}
