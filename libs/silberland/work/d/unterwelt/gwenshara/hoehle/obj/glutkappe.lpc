inherit "std/food";     

#include <properties.h>
#include <food.h>       
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();

  AddId( ({ "kappe", "pilz","glutkappe","\nglutkappe" }) );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Glutkappe");


  SetProp(P_SHORT, "Eine Glutkappe");
  SetProp(P_LONG,
    "Die Glutkappe ist ein kleiner Pilz, der stets von einem roetlichen Glimmen "
    "umgeben ist. Daher auch sein Name. Er waechst nur an Orten in der Unterwelt, "
    "die von starker Magie durchdrungen sind.");

  SetProp(P_WEIGHT, 4);       
  SetProp(P_VALUE, 100);         
  SetProp(P_MATERIAL,
      ([ MAT_MISC_PLANT : 100 ]) );      

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 10,10 }), 
         F_SOAK    : 5,         
         F_DRINK   : 0,         
         F_ALCOHOL : 0,         
         F_POISON  : 0,
         F_VERB    : "essen"    
      ]) );                     
}
