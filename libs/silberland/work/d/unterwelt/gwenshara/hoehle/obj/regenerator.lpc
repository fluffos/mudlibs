#include "../def.h"

inherit "/std/thing";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, 0);
    SetProp(P_INVIS, 1);
    SetProp(P_MAGIC, 1);
    SetProp(P_WEIGHT, 0);
    SetProp(P_X_ATTR_MOD, ([]));

    AddId("\nregenerator");
}

public void start() {
    call_out("regeneration", 0);
}

public void end() {
    object env;
    
    if(!objectp(env=ENV(TO))) {
       remove(1);
        return;
    }

    if(!living(env)) {
        remove(1);
        return;
    }
    
    tell_object(env, BS("Die Wirkung des schwarzen Weins verschwindet."));
    remove(1);
    return;
}

public void regeneration() {
    object env;
    
    if(!objectp(env=ENV(TO))) {
        end();
        return;
    }

    if(!living(env)) {
        end();
        return;
    }

    env->AddHp(random(3));
    call_out("regeneration", 10+random(20));
}

public void BecomesNetDead(object spieler) {
    object env;
    
    if(!objectp(env=ENV(TO))) {
       remove(1);
        return;
    }

    if(!living(env)) {
        remove(1);
        return;
    }

    if(spieler == env) end();

    return;
}

public void NotifyPlayerDeath(object victim, object killer, int lost_xp) {
    object env;
    
    if(!objectp(env=ENV(TO))) {
       remove(1);
        return;
    }

    if(!living(env)) {
        remove(1);
        return;
    }

    if(victim == env) end();

    return;
}

public void reset() {
    ::reset();
    if(!is_clone(TO)) return;
    end();
    return;
}
