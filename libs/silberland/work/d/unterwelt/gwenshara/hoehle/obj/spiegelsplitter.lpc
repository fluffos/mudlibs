#include "../def.h"

inherit "/std/thing";

public void create() {
    if(!is_clone(TO)) return;

    ::create();

    SetProp(P_NAME, "Spiegelsplitter");
    SetProp(P_SHORT,"Ein Splitter eines Spiegels");
    AddId(({"\ngwenshara_evil_cave_mirror_shards", "splitter", "spiegelsplitter"}));
    SetProp(P_GENDER, MALE);
    SetProp(P_NOSELL, 1);
    SetProp(P_MATERIAL, MAT_GLASS);
    SetProp(P_VALUE, 5);
    SetProp(P_WEIGHT, 10);

    SetProp(P_LONG, "Dieser Splitter sind von einem Spiegel. In ihnen reflektiert sich "
                    "das Licht und wenn du sie richtig drehst kannst du damit das Licht in "
                    "eine beliebige Richtung lenken.");
}