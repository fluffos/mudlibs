#include "../def.h"

inherit "std/thing";

public void create() {
    if (!is_clone(TO)) return;

    ::create();
    SetProp(P_SHORT, "Ein langes Holzbrett");
    SetProp(P_LONG,
        "Das hier ist ein langes Holzbrett. Es ist sicher dick genug dich "
        "im Fall der Faelle zu tragen.");

    SetProp(P_NAME, "Holzbrett");
    SetProp(P_GENDER, NEUTER);
    AddId(({"brett", "holzbrett", "\ngwenshara_cave_brett"}));

    SetProp(P_MATERIAL, ([MAT_WOOD:100]) );
    SetProp(P_WEIGHT, 3000);
    SetProp(P_SIZE, 5000);
    SetProp(P_VALUE, 200);
    SetProp(P_NOBUY, 1);
}