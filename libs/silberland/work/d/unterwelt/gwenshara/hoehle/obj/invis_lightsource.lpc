#include "../def.h"

inherit "/std/thing";

private int onoff;

public void create() {
    if(!is_clone(TO)) return;

    ::create();

    SetProp(P_NAME, "Unsichtbares Licht");
    SetProp(P_SHORT,"Unsichtbare Lichtquelle");
    AddId(({"\ngwenshara_evil_cave_mirror_ils"}));
    SetProp(P_GENDER, MALE);
    SetProp(P_INVIS, 1);
    SetProp(P_NOSELL, 1);
    SetProp(P_NOBUY, 1);
    SetProp(P_NOGET, 1);
    SetProp(P_MATERIAL, MAT_GLASS);
    SetProp(P_VALUE, 5);
    SetProp(P_WEIGHT, 10);

    onoff = 0;
}

public void light_off() {
    if(onoff) {
        tell_room(ENV(TO), BS("Es wird dunkler."));
    }
    onoff = 0;
    return;
}

public void light_on() {
    if(!onoff) {
        tell_room(ENV(TO), BS("Es wird heller."));
    }
    onoff = 1;
    return;
}

public int _query_light() {
    return onoff;
}