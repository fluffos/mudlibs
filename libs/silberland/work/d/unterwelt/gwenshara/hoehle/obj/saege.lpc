#include "../def.h"

inherit "std/thing";

public void create() {
    if (!is_clone(TO)) return;

    ::create();
    SetProp(P_SHORT, "Ein Saege");
    SetProp(P_LONG,
        "Es handelt sich um eine einfache Saege, die man benutzen kann um allerlei "
        "Dinge an- oder durchzusaegen. Sie besteht aus einem Metallbogen und einem "
        "scharfzaehnigen Saegeblatt. Perfekt geeignet um Holz zu zersaegen.");

    SetProp(P_NAME, "Saege");
    SetProp(P_GENDER, NEUTER);
    AddId(({"saege", "holzsaege", "\ngwenshara_cave_saw"}));

    SetProp(P_MATERIAL, ([ MAT_STEEL:100]) );
    SetProp(P_WEIGHT, 500);
    SetProp(P_SIZE, 50);
    SetProp(P_VALUE, 100);
    SetProp(P_NOBUY, 1);
}