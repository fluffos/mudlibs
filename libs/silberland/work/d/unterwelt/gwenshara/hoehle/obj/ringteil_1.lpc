#include "../def.h"

inherit "std/thing";

public void create() {
    if (!is_clone(TO)) return;

    ::create();
    SetProp(P_SHORT, "Ein bleiernes Teil eines Metallrings");
    SetProp(P_LONG,
        "Dieses Ringfragment besteht aus schwerem, silbern glaenzenden Metall. "
        "Es ist ein wenig fettig und liegt extrem schwer in deiner Tasche. "
        "Mystische Runen sind darauf eingraviert und ein leichtes Summen geht "
        "davon aus. Als du es anblickst, fuehlst du dich irgendwie traege...");
    SetProp(P_NAME_ADJ, "bleiern");
    SetProp(P_NAME, "Teil");
    SetProp(P_GENDER, NEUTER);
    AddId(({"teil", "ringteil", "metallringteil", "\ngwenshara_evil_cave_ringart", "\ngwenshara_evil_cave_ring_1"}));
    AddAdjective(({"bleierne", "bleiernes", "bleiernen", "bleiernem"}));

    SetProp(P_MATERIAL, ([MAT_LEAD: 90, MAT_MAGIC: 10]) );
    SetProp(P_WEIGHT, 200);
    SetProp(P_VALUE, 100);
    SetProp(P_NOBUY, 1);
}