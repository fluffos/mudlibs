#include "../def.h"

inherit "std/thing";

public void create() {
    if (!is_clone(TO)) return;

    ::create();
    SetProp(P_SHORT, "Eine Phiole Nachtschattenelixier");
    SetProp(P_LONG,
        "Du haeltst eine Phiole in den Haenden, in deren Inneren eine "
        "seltsame Fluessigkeit schwappt. Es sieht aus wie eine Mischung "
        "aus Blut und schwarzen Partikeln, die sich immer entgegen "
        "der Schwerkraft bewegen.");
    SetProp(P_INFO, BS("Dieses seltene Elixier wird von Nekromanten "
                       "in finsteren Ritualen erschaffen. Untote, die "
                       "damit gesalbt werden sollen ungleich maechtiger "
                       "werden!"));
    SetProp(P_NAME, "Nachtschattenelixier");
    SetProp(P_GENDER, NEUTER);
    AddId(({"phiole", "elixier", "nachtschattenelixier"}));

    SetProp(P_MATERIAL, ([MAT_GLASS: 20, MAT_BLOOD: 60, MAT_MISC_UNHOLY: 20]) );
    SetProp(P_WEIGHT, 100);
    SetProp(P_SIZE, 20);
    SetProp(P_VALUE, 666);
    SetProp(P_NOBUY, 1);

    AddCmd( ({"salbe", "salb"}), "cmd_salben");
}

public int cmd_salben(string str) {
    object target, bonus;
    string who, what;

    notify_fail("Wen sillst du womit salben?\n");
    if(sscanf(str, "%s mit %s", who, what) != 2) return 0;
    notify_fail("WEN sillst du womit salben?\n");
    if(!objectp(target=present(who, environment(TP)))) return 0;
    notify_fail("Wen sillst du WOMIT salben?\n");
    if(!id(what)) return 0;

    if(target->QueryProp(P_RACE) != "Untoter" && !target->is_class_member(CL_UNDEAD)) {
        write(BS(sprintf("%s lebt noch! Das Elixier wirkt nur auf Untote!", target->Name(WER))));
        return -1;
    }

    write(BS(sprintf("Unter den rituellen Gesaengen von Vur-Xul-Zhtepth salbst du "
                     "%s mit dem Elixier die Stirn. Mit einem Kreischen brennt sich die "
                     "mystische Sigille in %s Fleisch und %s sieht sofort maechtiger aus.", 
                     target->name(WEM), target->name(WESSEN), target->QueryPronoun())));
    say(BS(sprintf("Unter den rituellen Gesaengen von Vur-Xul-Zhtepth salbt %s "
                   "%s die Stirn. Mit einem Kreischen brennt sich eine "
                   "mystische Sigille in %s Fleisch und %s sieht sofort maechtiger aus.", 
                   TP->name(WER), target->name(WEM), target->name(WESSEN), target->QueryPronoun())));

    if(!interactive(target)) {
        target->SetProp(P_BODY,  (int) (target->QueryProp(P_BODY) * 1.2));
        target->SetProp(P_HANDS, ({target->QueryProp(P_HANDS)[0], 
                                   (int) (target->QueryProp(P_HANDS)[1]*1.2), 
                                   target->QueryProp(P_HANDS)[2]}) );
        target->SetProp(P_MAX_HP, (int) (target->QueryProp(P_MAX_HP) * 1.2));
        target->SetProp(P_HP, target->QueryProp(P_MAX_HP));
    } else {
        bonus = clone_object(OBJ "elixier_bonus");
        if(bonus->move(target, M_NOCHECK | M_SILENT) != 1) {
            write(BS("Die Macht von Vur-Xul-Zhtepth kann sich nicht manifestieren!"));
            destruct(bonus);
            return -1;
        }
    }

    call_out("remove", 0);
    return 1;
}