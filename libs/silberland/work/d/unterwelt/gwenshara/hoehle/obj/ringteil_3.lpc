#include "../def.h"

inherit "std/thing";

public void create() {
    if (!is_clone(TO)) return;

    ::create();
    SetProp(P_SHORT, "Ein gluehendes Teil eines Metallrings");
    SetProp(P_LONG,
        "Dieses Ringfragment besteht aus einem blaeulich gluehenden Metall. "
        "Mystische Runen sind darauf eingraviert und ein leichtes Summen geht "
        "davon aus.");
    SetProp(P_NAME_ADJ, "gluehend");
    SetProp(P_NAME, "Teil");
    SetProp(P_GENDER, NEUTER);
    AddId(({"teil", "ringteil", "metallringteil","\ngwenshara_evil_cave_ringart", "\ngwenshara_evil_cave_ring_3"}));
    AddAdjective(({"gulehende", "gluehendes", "gluehenden", "gluehendem"}));

    SetProp(P_MATERIAL, ([MAT_PLUTONIUM: 90, MAT_MAGIC: 10]) );
    SetProp(P_WEIGHT, 200);
    SetProp(P_VALUE, 200);
    SetProp(P_NOBUY, 1);
    }