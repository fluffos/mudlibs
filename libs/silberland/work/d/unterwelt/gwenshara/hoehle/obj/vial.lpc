#include "../def.h"

inherit "std/thing";

private int filled;

public void create() {
    if (!is_clone(TO)) return;
    ::create();
    filled = 0;

    SetProp(P_SHORT, "Eine leere Phiole");
    SetProp(P_LONG,
        "Diese Phiole eignet sich besonders gut um damit Gift zu melken. Sie hat "
        "dafuer einen speziellen Aufsatz aus Gummi.");

    SetProp(P_NAME, "Phiole");
    SetProp(P_GENDER, FEMALE);
    AddId(({"phiole", "giftphiole", "\ngwenshara_evil_cave_vial"}));

    SetProp(P_MATERIAL, MAT_GLASS );
    SetProp(P_WEIGHT, 20);
    SetProp(P_SIZE, 5);
    SetProp(P_VALUE, 500);
    SetProp(P_NOBUY, 1);
}

public void SetFilled() {
    filled = 1;
    SetProp(P_SHORT, "Eine mit Dridergift gefuellte Phiole");
    SetProp(P_LONG,
        "Diese Phiole eignet sich besonders gut um damit Gift zu melken. Sie hat "
        "dafuer einen speziellen Aufsatz aus Gummi. Sie wurde mit dem Gift eines "
        "Drider gefuellt.");
    return;
}

public int IsFilled() {
    return filled;
}