#include "../def.h"

inherit "/std/thing";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, 0);
    SetProp(P_INVIS, 1);
    SetProp(P_MAGIC, 1);
    SetProp(P_WEIGHT, 0);
    SetProp(P_X_ATTR_MOD, ([]));

    AddId("\ngwenshara_evil_cave_modifier");
}

public void SetBonus(int align) {
    int bonus;
    string *attr;
    bonus = align/200;
    attr = ({A_INT, A_DEX, A_CON, A_STR});
    SetProp(P_X_ATTR_MOD, QueryProp(P_X_ATTR_MOD) + ([ attr[random(sizeof(attr))]: bonus]));
    call_out("remove", 30 + random(60), 1);
}

