#include "../def.h"

inherit "std/thing";

public void create() {
    if (!is_clone(TO)) return;

    ::create();
    SetProp(P_SHORT, "Eine Schnur");
    SetProp(P_LONG,
        "Du haeltst ein ausgfranstes Stueck Schnur in der Hand. "
        "Mit etwas Kreativitaet kann man es sicher noch zum basteln "
        "verwenden.");

    SetProp(P_NAME, "Schnur");
    SetProp(P_GENDER, FEMALE);
    AddId(({"schnur", "\ngwenshara_evil_cave_string"}));

    SetProp(P_MATERIAL, MAT_CLOTH );
    SetProp(P_WEIGHT, 20);
    SetProp(P_SIZE, 200);
    SetProp(P_VALUE, 10);
    SetProp(P_NOBUY, 1);
}