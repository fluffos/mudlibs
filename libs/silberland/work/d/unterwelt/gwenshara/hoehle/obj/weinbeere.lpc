inherit "std/food";     

#include <properties.h>
#include <food.h>       
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create();

  AddId( ({ "beere", "weinbeere","schwarzer wein","\nschwarzer_wein" }) );

  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Weinbeere");


  SetProp(P_SHORT, "Eine schwarze Weinbeere");
  SetProp(P_LONG,
    "Diese schwarze Weinbeere ist glaenzend und saftig. Von einem dunklen rot, "
    "fast schon richtig schwarz.");

  SetProp(P_WEIGHT, 4);       
  SetProp(P_VALUE, 100);         
  SetProp(P_MATERIAL,
      ([ MAT_MISC_PLANT : 100 ]) );      

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 10,10 }), 
         F_SOAK    : 10,         
         F_DRINK   : 0,         
         F_ALCOHOL : 0,         
         F_POISON  : 0,
         F_VERB    : "essen"    
      ]) );                     
}

public void BeimEssen() {
  object ob;

  if(objectp(present("\nregenerator", TP))) {
    tell_object(TP, BS("Nichts weiter passiert."));
    return;
  }

  ob = clone_object(OBJ "regenerator");
  if(!ob->move(TP, M_NOCHECK)) {
    tell_object(TP, BS("Nichts weiter passiert."));
    destruct(ob);
    return;
  }

  ob->start();
  tell_object(TP, BS("Eine dunkle, saftige Lebenskraft durchflutet dich."));
  return;
}