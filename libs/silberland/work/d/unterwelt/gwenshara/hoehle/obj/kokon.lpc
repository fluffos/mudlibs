#include "../def.h"

inherit "std/thing";


private string *loadOptions = ({
    NPC "ratte",
    NPC "ratte",
    NPC "ratte",
    NPC "ogre_sevant",
    NPC "fledermaus",
    NPC "fledermaus",
    NPC "fledermaus",
    NPC "hungry_dead",
    "MONEY",
    "GEM",
});
private string load;

public void create() {
    if (!is_clone(TO)) return;

    ::create();
    SetProp(P_SHORT, "Eine klebriger Kokon aus Spinnenseide hangt hier im Netz");
    SetProp(P_LONG,
        "Ein grosser Ballen Spinnweben wurde hier von setwas spinnenartigem ins Netz "
        "gewoben. Ab und zu scheint er sich zu bewegen. Aber vielleicht taeuschen dich "
        "auch nur deine Sinne. Wenn du eine passende Klinge dabei hast, kannst du ihn "
        "vielleicht aufschneiden, um zu sehen was drin ist?");

    SetProp(P_NAME, "Kokon");
    SetProp(P_GENDER, FEMALE);
    AddId(({"kokon", "\ngwenshara_evil_cave_cocoon"}));

    SetProp(P_MATERIAL, MAT_SILK );
    SetProp(P_WEIGHT, 5000);
    SetProp(P_SIZE, 2000);
    SetProp(P_VALUE, 0);
    SetProp(P_NOBUY, 1);
    SetProp(P_NOGET, "Der Kokon klebt fest am Netz!\n");

    AddCmd( ({"schneide", "schneid"}), "cmd_schneiden" );
    load = loadOptions[random(sizeof(loadOptions))];
}

public void SetLoad(string str) {
    load = str;
    return;
}

private object createGem() {
    object *gems;

    gems = "/obj/gemmaster"->DistributeGem(1,0);

    return gems[0];
}

private object createMoney() {
    object ob;
    ob = clone_object("/obj/money");
    ob->SetProp(P_AMOUNT, 10 + random (100));
    return ob;
}

public int cmd_schneiden(string str) {
    object ob;
    notify_fail("Was moechtest du aufschneiden?\n");
    if(!str || str == "") return 0;
    if(str != "kokon auf" && str != "spinennkokon auf") return 0;

    ob = TP->QueryProp(P_WEAPON);
    if(!objectp(ob)) {
        write(BS("Du hast ja gar nichts zum Schneiden!"));
        return -1;
    }
    if(member(ob->QueryProp(P_DAM_TYPE), DT_SLASH) < 0 && ob->QueryProp(P_WEAPON_TYPE) != WT_SWORD &&
    ob->QueryProp(P_WEAPON_TYPE) != WT_KNIFE) {
        write(BS("Du brauchst etwas mit einer Klinge um zu schneiden."));
        return -1;
    }
    
    //write(load+"\n");
    switch(load) {
        case "GEM": ob = createGem(); break;
        case "MONEY": ob = createMoney(); break;
        default: ob = clone_object(load);
    }
    write(BS(sprintf("Mit einem raschen Schnitt oeffnest du den Kokon und befreist %s.",
                     ob->name(WEN))));
    say(BS(sprintf("%s oeffent den Kokon einem raschen Schnitt und befreit %s.",
                    TPN, ob->name(WEN))));

    if(ob->move(environment(TO), M_NOCHECK|M_SILENT) != 1) {
        tell_room(environment(TO), BS(sprintf("%s faellt durch das Netz nach unten.", ob->Name(WER))));
        destruct(ob);
        return 1;
    }

    if(living(ob) && !random(3)) {
        write(BS(sprintf("%s stuerzt sich sofort auf dich!", ob->Name(WER))));
        say(BS(sprintf("%s stuerzt sich sofort auf %s!", ob->Name(WER), TPN)));
        ob->Kill(TP);
    }

    remove();
    return 1;
}