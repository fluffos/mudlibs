#include "../def.h"

inherit "/std/thing";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, 0);
    SetProp(P_INVIS, 1);
    SetProp(P_MAGIC, 1);
    SetProp(P_WEIGHT, 0);
    SetProp(P_NOGET, 1);
    SetProp(P_NODROP, 1);
    SetProp(P_NEVERDROP, 1);
    SetProp(P_X_HEALTH_MOD, ([P_HP: 2 + random(5),P_SP: 2 + random(5)]));

    AddId("\ngwenshara_evil_cave_nekro_elixier");
}

public void reset() {
    ::reset();

    if(!is_clone(TO)) return;
    if(objectp(environment(TO))) {
        tell_object(environment(TO), "Die mystische Sigille von Vur-Xul-Zhtepth auf deiner Stirn verblasst.");
    }

    remove(1);
}

public string extra_look() {
    return "Auf der Stirn prangt die blutige Sigille von Vur-Xul-Zhtepth.\n";
}

