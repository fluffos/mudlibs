#include "../def.h"

inherit "std/thing";

public void create() {
    if (!is_clone(TO)) return;

    ::create();
    SetProp(P_SHORT, "Ein Kletterseil mit Haken");
    SetProp(P_LONG,
        "Dieses Seil ist ein professionelles Kletterseil. Es "
        "besteht aus einem elastischen Superhanf und hat einen "
        "soliden Haken festgebunden, mit dem man es sicher "
        "irgendwo anhaengen kann.");

    SetProp(P_NAME, "Kletterseil");
    SetProp(P_GENDER, NEUTER);
    AddId(({"seil", "kletterseil", "haken", "\ngwenshara_cave_rope"}));

    SetProp(P_MATERIAL, ([MAT_CANNABIS:90, MAT_STEEL:10]) );
    SetProp(P_WEIGHT, 500);
    SetProp(P_SIZE, 20000);
    SetProp(P_VALUE, 500);
    SetProp(P_NOBUY, 1);
}