#include "../def.h"

inherit "std/thing";

public void create() {
    if (!is_clone(TO)) return;

    ::create();
    SetProp(P_SHORT, "Eine riesige Felskugel");
    SetProp(P_LONG,
        "Diese FElskugel ist etwa zwei Meter im Durchmesser und aus "
        "massivem Granit. Irgendwer hat sie wohl hier her gerollt. Warum "
        "ist dir nicht ganz klar.");

    SetProp(P_NAME, "Felskugel");
    SetProp(P_GENDER, FEMALE);
    AddId(({"kugel", "felskugel", "\ngwenshara_evil_cave_boulder"}));

    SetProp(P_MATERIAL, MAT_GRANITE );
    SetProp(P_WEIGHT, 20000);
    SetProp(P_SIZE, 2000);
    SetProp(P_VALUE, 0);
    SetProp(P_NOBUY, 1);
    SetProp(P_NOGET, "Die Felskugel ist viel zu schwer!\n");

    AddCmd( ({"roll", "rolle"}), "cmd_rollen");
}

private int inLochRoom() {
    return file_name(environment(this_object())) == ROOM "b3_b5_loch";
}

private int isInsLoch(string direction) {
    return direction == "kugel in loch" || direction == "kugel ins loch" || 
           direction == "felskugel in loch" || direction == "felskugel ins loch";
}

public int cmd_rollen(string str) {
    string targetRoom, what, direction;
    mapping exits;

    exits = environment(this_object())->QueryProp(P_EXITS);

    if(strlen(str) < 1) return 0;

    if(isInsLoch(str)) {
        if(!inLochRoom()) {
            write("Hier ist kein Loch.\n");
            return -1;
        } 
        call_other(ROOM "ogerloch", "???");
        write("Du gibst der Felskugel einen ordentlichen Schubs...\n");
        say(TPN +" gibt der Felskugel einen ordentlichen Schubs...\n");
        tell_room(environment(this_object()), BS("Die Felskugel rollt durch das Loch."));
        call_other(ROOM "ogerloch", "KillOger");
        remove(1);
        return 1;
    }

    if(sscanf(str, "%s nach %s", what, direction) != 2) {
        write("Was willst du wohin rollen?\n");
        return -1;
    }
    if(what != "felsen" && what != "felskugel" && what != "kugel") {
        write(BS("Das kannst du nicht rollen."));
        return -1;
    }

   if(!member(exits, direction)) {
        write(BS("Dorthin kannst du die Felskugel nicht rollen."));
        return -1;
    }

    if(this_player()->QueryAttribute(A_STR) < 25 && 
       !present("\ngwenshara_evil_cave_lever", this_player())) {
        write(BS("Du bist zu schwach, um den Felsen ohne Hilfsmittel zu rollen."));
        return -1;
    }

    write(BS("Mit all deiner Kraft setzt du die Felskugel in Bewegung..."));
    say(BS(this_player()->Name(WER) + " stemmt sich gegen die Felskugel..."));

    
    targetRoom = exits[direction];
    if(strstr(targetRoom, ROOM, 0) != 0) {
        tell_room(environment(this_object()), BS("Nichts passiert."));
        return -1;
    } else {
        tell_room(environment(TO), sprintf("Die Kugel rollt nach %s.\n", CAP(direction)));
        if(objectp(find_object(targetRoom))) tell_room(find_object(targetRoom), sprintf("Eine Felskugel rollt herein.\n"));
    }

    if(this_object()->move(targetRoom, M_PUT) != 1) {
        tell_room(environment(this_object()), BS("Die Felskugel rollt wieder zurueck."));
    }


    return 1;
}