#include "../def.h"

inherit "std/thing";

public void create() {
    if (!is_clone(TO)) return;

    ::create();
    SetProp(P_SHORT, "Ein verunreinigter Sangurit");
    SetProp(P_LONG,
        "Dieser Sangurit ist etwa so gross wie deine Faust. Solche Steine sollen sich mit der "
        "Lebenskraft ihres Besitzers verbinden koennen, wenn sie magisch aufgeladen sind. Leider "
        "ist dieser mit Verunreinigeungen durchzugen. Du solltest ihn zu jemandem bringen, der "
        "sich damit auskennt.");

    SetProp(P_NAME, "Sangurit");
    SetProp(P_GENDER, NEUTER);
    AddId(({"sangurit", "\ngwenshara_cave_useless_sangurite"}));

    SetProp(P_MATERIAL, ([MAT_MISC_STONE:80, MAT_MISC_MAGIC: 20]) );
    SetProp(P_WEIGHT, 500);
    SetProp(P_SIZE, 20);
    SetProp(P_VALUE, 10000);
    SetProp(P_NOBUY, 1);
}