#include "../def.h"
#include <npcmaster.h>

inherit NPC "std_npc";
private int weakened;

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    create_dungeon_npc(45);
    

    SetProp(P_SHORT, "Alsatar der gefallene Paladin");
    SetProp(P_LONG, "Alsatar ist mit etwas ueber zwei Metern gross gewachsen. Sein ganzer Koerper "
                    "ist eine dunkle und verbeulte Ruestung gehuellt. Unter seinem alten Helm "
                    "wehen weisse Haare wie Spinnweben hervor. Aus den Augenschlitzen seines Helms "
                    "leuchten anstatt zweier Augen nur blassblaue Funken. Er ist ein gefallener "
                    "Paladin - ein Todesritter.");
    SetProp(P_NAME, "Alsatar");
    SetProp(P_ARTICLE, 0);
    SetProp(P_GENDER, MALE);
    SetProp(P_RACE, "Untoter");
    SetProp(P_SIZE, 220);
    SetProp(P_MSGIN, "schreitet mit grossen Schritten herein");
    SetProp(P_MMSGIN, "schreitet");
    AddId(({"paladin", "todesritter", "alsatar", "\ngwenshara_evil_cave_deathknight", "NOCONTROL", "NOWIMPY"}));
    AddClass(CL_UNDEAD);

    SetProp(P_CAVE_FACTION, F_PALADIN);
    SetProp(P_HANDS, ({" mit seinen untoten Klauen", QueryProp(P_HANDS)[1], DT_BLUDGEON }));
    SetProp(P_RESISTANCE_STRENGTHS, ([
        DT_TERROR :  -0.5, DT_LIGHT: 0.2, DT_UNHOLY: -0.8, DT_HOLY: 0.3
    ]));

    SetProp(P_DIE_MSG, " zerfaellt mit einem leisen Seufzen zu einem Haufen Asche.\n");

    SetProp(P_SPELLRATE, 45);
    AddSpell(3, 300,
       Name(WER) + " verpasst dir einen Knaufschlag.\n",
       Name(WER) + " verpasst @WEM einen Knaufschlag.\n",
       DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));

    AddSpell(2, 600,
        Name(WER) + " spricht einen Todesfluch auf dich.\n",
        Name(WER) + " spricht einen Todesfluch auf @WEN.\n",
        DT_UNHOLY, ([SP_SHOW_DAMAGE: 1]));

    AddDefaultSpell(1, 500, DS_MASS_DAMAGE,
            Name(WER) + " beschwoerte eine unheilvolle Macht herauf.\n",
            Name(WER) + " beschwoert eine unheilvolle Macht herauf.\n",
            DT_UNHOLY);

    AddSpell(2, 500,
        Name(WER)+" schlaegt dich mit seinem Schwert fast entzwei.\n",
        Name(WER)+" schlaegt @WEN mit seinem Schwert fast entzwei.\n",
        DT_SLASH);
    
    AddSpell(1, 800,
        "Die Waffe von "+Name(WEM, 1)+" dringt mit unheiliger Wucht in dich ein!\n",
        "Die Waffe von "+Name(WEM, 1)+" dringt mit unheiliger Wucht in @WEN ein!\n",
        ({DT_SLASH, DT_UNHOLY}), ([SP_SHOW_DAMAGE: 1]));


    CLONEME(WEAPON "knochenzweihaender");
    command_me("zuecke knochenzweihaender");

    CLONEME(ARMOUR "palahelm");
    command_me("trage alles");

    SetProp(P_MNPC_FLAGS, 0);
}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {
    if(!random(10) && !spell) {
        tell_room(ENV(TO), BS(Name(WER)+" pariert den Angriff mit seinem Schwert."));
        dam/=2;
    }

    if(!weakened && !random(8) && QuerySkillAttribute(SA_SPEED) < 200) {
        tell_room(ENV(TO), BS("Eine unheilige Macht verleicht der Attacke on "+Name(WEM)+" Fluegel."));
        ModifySkillAttribute(TO, SA_SPEED, 200, 2+random(4));
    }

    return ::Defend(dam, dam_type_list, spell, enemy);
}

public void weakenByLight() {
    object *inv;
    int i;

    if(weakened) return;

    SetProp(P_NO_SCORE, 1);
    create_dungeon_npc(26);
    SetProp(P_SPELLRATE, 10);

    inv = all_inventory(TO);
    for(i=0; i<sizeof(inv); ++i) {
        inv[i]->remove(1);
    }

    weakened = 1;

    tell_room(ENV(TO), BS(Name(WER)+" gibt ein kreischendes Stoehen von sich, als er von dem Lichtstrahl beruehrt wird. Er wirkt nun stark geschwaecht."));
    SetProp(P_LONG, QueryProp(P_LONG)+"Er wurde durch die Einwirkung von Sonnenlicht massiv geschwaecht!");   

    return;
}