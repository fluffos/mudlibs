#include "../def.h"

inherit NPC "std_npc";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, "Evandrina die Blutelfe");
    SetProp(P_LONG, "Frueher war Evandrina eine Elfe aus Elessar. Sie ist blass, blond und aeusserst "
                    "huebsch. Sie traegt enge Lederkleidung ind hat dunklen Kajal um die Augen aufgetragen. "
                    "Trotz ihrer umwerfenden Ausstrahlung geht etwas beunruhigendes von ihr aus.");
    SetProp(P_NAME, "Evandrina");
    SetProp(P_ARTICLE, 0);
    SetProp(P_GENDER, FEMALE);
    SetProp(P_RACE, "Elf");
    SetProp(P_SIZE, 190);
    SetProp(P_MSGIN, "kommt an");
    SetProp(P_MMSGIN, "geht");
    AddId(({"evandrina", "elfe", "blutelfe", "\ngwenshara_evil_cave_bloodelf"}));

    SetProp(P_CAVE_FACTION, F_BLOOD);
    create_dungeon_npc(35);
    
    SetProp(P_HANDS, ({" mit ihren elegenaten Haenden", QueryProp(P_HANDS)[1], DT_BLUDGEON }));
    SetProp(P_RESISTANCE_STRENGTHS, ([
        DT_MAGIC  : -0.2, DT_TERROR :  0.1, DT_LIGHT:-0.1, DT_UNHOLY: 0.1,
        DT_HOLY: -0.1, DT_MIND: -0.2
    ]));

    SetProp(P_DIE_MSG, " geht mit einem leisen Seufzer zu Boden.\n");

    SetProp(P_SPELLRATE, 30);
    AddSpell(3, 300,
       Name(WER) + " peitscht dich mit ihrer Dornenpeitsche.\n",
       Name(WER) + " peitscht @WEN mit ihrer Dornenpeitsche.\n",
      ({DT_PIERCE, DT_RIP, DT_WHIP}), ([SP_SHOW_DAMAGE: 1]));

    AddSpell(3, 300,
        Name(WER) + " kratzt dich mit ihren langen Fingernaegeln.\n",
        Name(WER) + "  kratzt @WEN mit ihren langen Fingernaegeln.\n",
       ({DT_RIP}), ([SP_SHOW_DAMAGE: 1]));

    AddSpell(1, 666,
        Name(WER) + " reisst dich mit ihrer Peitsche auf und trinkt von deinem Blut.\n",
        Name(WER) + "reisst @WEN mit ihrer Peitsche auf und trinkt vom sprizenden Blut.\n",
        DT_SLASH, "selfHeal", ([SP_SHOW_DAMAGE: 1]));

    AddSpell(1, 666,
            Name(WER) + " reisst dich mit ihrer Peitsche auf und trinkt von deinem Blut.\n",
            Name(WER) + "reisst @WEN mit ihrer Peitsche auf und trinkt vom sprizenden Blut.\n",
            DT_SLASH, "selfHeal", ([SP_SHOW_DAMAGE: 1]));

    AddDefaultSpell(1, 1, DS_SLOW,
            Name(WER) + " blickt dich verfuehrerisch an. Du fuehlst dich irgendwie in ihren Bann gezogen.\n",
            Name(WER) + " blickt @WEN verfuehrerisch an.\n");

    SetChats(7, ({
        Name(WER) + " trinkt geistesabwesend einen Schluck aus ihrem Kelch.\n",
        Name(WER) + " frisiert sich die Haare.\n",
        Name(WER) + " laechelt dir keck zu.\n",
        Name(WER) + " streckt sich lasziv.\n",
        Name(WER) + " schenkt sich etwas roten Wein in ihren Kelch nach.\n",
        Name(WER) + " streichelt dir sanft ueber die Wange.\n",
        Name(WER) + " malt mit roter Farbe weiter an ihrem Bild.\n",
        Name(WER) + " laesst die Hueften verfuehrerisch kreisen.\n"
    }));

    CLONEME(WEAPON "dornenpeitsche");
    command_me("zuecke peitsche");

    CLONEME(ARMOUR "korsett");
    command_me("trage alles");

    CLONEME(OBJ "ringteil_4");

    SetProp(P_MNPC_FLAGS, 0);
}

public void selfHeal(object enemy, int damage, mixed dtypes) {
    AddHp(100 + random(150));
}