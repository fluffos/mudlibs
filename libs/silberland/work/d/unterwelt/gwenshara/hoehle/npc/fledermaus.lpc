#include "../def.h"

inherit NPC "std_npc";

public void create() {
    string adj, art, description;
    int lvl;

    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, "Eine kleine Hoellenfledermaus haengt an der Decke");
    SetProp(P_LONG, "Eine kleine grau-schwarze Fledermaus mit scharfen Zaehnen "
                    "und rot gluehenden Augen haengt ueber dir an der Decke.");
    SetProp(P_NAME, "Hoellenfledermaus");
    SetProp(P_GENDER, FEMALE);
    SetProp(P_RACE, "Tier");
    SetProp(P_SIZE, 40);
    SetProp(P_MSGIN, "flattert herein");
    SetProp(P_MMSGIN, "flattert");
    AddId(({"fledermaus", "hoellenfledermaus"}));
    AddClass(CL_FLYING);

    SetProp(P_CAVE_FACTION, F_NONE);
    create_dungeon_npc(8);
    
    SetProp(P_HANDS, ({" mit ihren spitzen Zaehnen", QueryProp(P_HANDS)[1], DT_PIERCE }));

    SetProp(P_DIE_MSG, " klatscht tot zu Boden.\n");

    SetProp(P_SPELLRATE, 10);
    AddSpell(1, 150,
       Name(WER) + " beisst dich.\n",
       Name(WER) + " beisst @WEN.\n",
       DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));
}