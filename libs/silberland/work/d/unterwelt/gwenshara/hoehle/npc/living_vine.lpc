#include "../def.h"

inherit NPC "std_npc";

public void create() {
    string adj, art, description;
    int lvl;

    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, "Eine lebendige Dornenranke mit dicken Stacheln");
    SetProp(P_LONG, "Diese Dornenranke ist offenbar lebendig. Sie ist gruen, dick und mit fetten roten Stacheln besetzt. Offenbar eine Blutranke.");
    SetProp(P_NAME, "Dornenranke");
    SetProp(P_GENDER, FEMALE);
    SetProp(P_RACE, "Pflanze");
    SetProp(P_SIZE, 200);
    SetProp(P_MSGIN, "kriecht herein");
    SetProp(P_MMSGIN, "kriecht");
    AddId(({"ranke", "dornenranke", "blutranke", "\ngwenshara_hoehle_living_wine"}));

    SetProp(P_CAVE_FACTION, F_BLOOD);
    create_dungeon_npc(18);
    
    SetProp(P_HANDS, ({" mit ihren dicken Stacheln", QueryProp(P_HANDS)[1], DT_PIERCE }));
    SetProp(P_MNPC_FLAGS,0);

    SetProp(P_DIE_MSG, " zuckt noch einmal auf und bewegt sich dann nicht mehr.\n");
}