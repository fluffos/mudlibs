
inherit "/d/unterwelt/basics/central/npc/std_darkelf";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <exploration.h>
#include "../def.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Myr ak Ulix, der Lehrling von Mysfixfis");
  SetProp(P_LONG,
    "Dieser Dunkelelf ist eher klein und schmaechtig. Doch seine Robe, die "
    "mit silbernen Penta- und Heptagrammen verziert ist zeigt, dass er sicherlich "
    "einiges an geheimer Magie kennt.");
  SetProp(P_NAME, "Myr ak Ulix");
  SetProp(P_GENDER, MALE);
  AddId(({"myr", "myr ak ulix", "lehrling", "zauberer", "NOWIMPY", "NOCONTROL"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("myrakulix");

  create_default_darkelf(35, 25);

  SetProp(P_HANDS, ({" mit dunkelelfischer Zauberei",QueryProp(P_HANDS)[1],({DT_MAGIC, DT_UNHOLY})}));
  SetProp(P_RACE, "Dunkelelf");
  SetProp(P_SIZE, 175);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.1, DT_COLD:     -0.2, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING:-0.1, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.2,
      DT_ELECTRIC:  0.0, DT_ACID:     -0.1, DT_POISON:-0.1, DT_TERROR:-0.5,
      DT_HOLY:      0.3, DT_UNHOLY:   -0.3, DT_MAGIC: -0.1, DT_MIND:  -0.3]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder!");

  AddInfo(DEFAULT_INFO, " murmelt unverstaendlich vor sich hin.\n");
  AddInfo("gwenshara", "Gwenshara hat mich erschaffen.","sagt: ");

  AddInfo( ({"sangurit","kristall"}),
    "Der Sangurit ist ein maechtiger, magischer Kristall, den der maechtige Fistandatilus in diesen "
    "Hoehlen gefunden hat. Er soll in einer Kaverne im hintersten Winkel wachsen. Mein Meister, Mystixfis "
    "hat mich beauftragt einen Sangurit zu holen. Doch der Fluch des Fistandtilus in diesen Hoehlen hindert "
    "mich daran! Ein Sangurit hat maechtige Wirkung auf den Koerper. Bring mir einen und ich werde dir ein "
    "Teil von ihm fuer dich selbst ueberlassen.",
    "sagt: ");

  AddInfo( ({"fistandantilus"}),
    "Fistandantilus war ein maechtiger Zauberer. Der maechtigste ueberhaupt - und einer der Finstersten! "
    "Er hat hier herunten ein Sanguritvorkommen entdeckt. Um es zu schuetzen hat er es hinter einem maechtigen "
    "Schutzzauber verborgen und einen Fluch auf diese Hoehlen gelegt. Doch bevor er zurueck kehren konnte, "
    "um den Kristall fuer sich zu nehmen, wurde er von Abenteurern zur Strecke gebracht.", "sagt: ");

  AddInfo( ({"hoehlen", "hoehle"}),
    "Die Hoehlen noerdlich von hier sind aeusserst gefaehrlich. Auf ihnen liegt ein Fluch, der den "
    "maechtigen Sangurit schuetzen soll.");

  AddInfo( ({"wirkung"}),
    "Der Sangurit, wenn er fachgerecht an einen Koerper gebunden wird, staerkt die Koerpersaefte. Ausserdem "
    "kann er in Verwandlungszaubern genutzt werden, oder maechtige Mutationen verursachen.", "sagt: ");

  AddInfo( ({"kaverne"}),
   "Die Kaverne mit den Sanguritkristallen befindet sich im hinteresten Teil dieser Hoehlen. Sie ist durch "
   "einen Schutzzauber versiegelt. Wer bis dort hin vordringt, der kann den Sangurit fuer sich nehmen.", "sagt: ");

  AddInfo( ({"fluch"}),
   "Fistandantilus hat die Hoehlen verflucht. Sie ziehen Boeses regelrecht an. Deshalb haben sich viele Monster "
   "darin eingenistet. Ausserdem schlaegt der Fluch all jene, welche die Hoehlen betreten in ihren Bann und bringt "
   "sie zu boesartigen Taten. Je laenger du in den Hoehlen weilst, desto verderbter wird dein Geist. Der Fluch "
   "hat bereits einige, die nach dem Sangurit gesucht haben so sehr in ihren Bann gezogen, dass sie nun in diesen "
   "Hoehlen hausen. Sie sind die heutigen Bewohner.", "erklaert: ");
 
  AddInfo( ({"schutz", "schutzzauber"}),
   "Die Kaverne mit den Kristallen ist durch eine magsiche Tuer versiegelt. In der Mitte der Hoehlen befindet sich "
   "ein altes, ringfoermiges Siegel, das als Schluessel dient. Wenn du fuenf Ringteile findest und dort einsetze, "
   "dann wird die versiegelte Tuer geoeffnet und gibt den Weg frei.", "sagt: ");

  AddInfo( ({"teile", "teil", "ringteile", "ringteile"}),
    "Unter dem Bewohnern dieser verderbten Hoehlen gibt es fuenf verdorbene Helden. Jeder von ihnen hat ein "
    "Ringteil in seinem Besitz. Ich denke, dass man sie nicht nur im direkten Kampf besiegen kann, sondern "
    "auch mit List und Schlaeue.", "meint: ");

  AddInfo( ({"mystixfis", "dunkelelfenzauberer"}),
    "Mystixfis ist der Hofzauberer der Koenigin von Dhrkion. Er ist mein Lehrmeister und hat mich hier her "
    "geschickt, um ein Stueck Sangurit zu besorgen. Wenn ich ohne zurueckkehre, wird er mich schrecklich bestrafen.",
    "sagt: ");

  AddInfo( ({"monster", "bewohner"}),
    "In diesen Gaengen lauern ueble Monster, die aus allen Ecken der Unterwelt von dem boesartigen Fluch "
    "angezogen wurden. Sie alle sind boesartig und uebel. Sieh dich vor!", "sagt: ");

  AddInfo( ({"helden", "verdorbene helden"}),
    "Fuenf verdorbene Helden haben sich der fuenf Ringteile in diesen Hoehlen bemaechtigt. Unter ihnen sind "
    "Glugsch der Fettwanst, Sheraxdina die Nachthexe, Angradur der Hoehlentroll, Evandrina die Blutelfe und "
    "Angzyne Teken'val die Koenigin der Drider. Jeder von ihnen ist schon so lange und so verdorben hier, dass "
    "sie oft selbst nicht mehr wissen warum. Und dann ist da noch Alsatar der verdorbene Paladin, der von "
    "Fistandantilus als Waechter hier gebunden wurde. Im Kampf wirst du kaum eine Chance haben. Doch mit etwas "
    "Koepfchen lassen sich sicher Wege finden alle aus dem Weg zu raeumen.", "sagt: ");

  AddInfo( ({"glugsch", "fettwanst"}),
    "Glugsch ist ein fetter Oger, der in einem Loch im Suedwesten der Gaenge haust. Er kann gar nicht mehr "
    "raus aus seinem Loch und schickt deshalb seine widerlichen Wichte herum, die ihm Fressen bringen sollen.",
    "sagt: ");

  AddInfo( ({"sheraxdina", "nachthexe"}),
    "Sheraxdina ist eine Hexe und Nekromanten von der Schattenseite des Silberlands. Sie kam in diese Hoehlen "
    "und wollte den Sangurit fuer sich haben... doch dann hat der Fluch sie hier gebunden.", "sagt: ");

  AddInfo( ({"angardur", "hoehlentroll"}),
    "Angardur ist eine seltsame Kreatur. Er muss eine Art von Hoehlentroll sein. Er haelt sich zumeist "
    "auf einer Felsinsel im Osten beim unterirdischen See auf. Wenn du seine Aufmerksamkeit auf dich ziehst, "
    "dann lauf so schnell du kannst. Er ist ganz und gar von Zorn zerfressen und toetet jeden, der ihm in die "
    "Quere kommt.", "sagt: ");

  AddInfo( ({"evandrina", "blutelfe"}),
    "Die Blutelfe Evandrina wurde aus Elessar verbannt. Sie kam hier her, um den Sangurit zu finden und damit "
    "noch mehr schreckliche Morde zu begehen. Es heisst sie malt mit dem Blut ihrer Opfer bilder. Sie hat sich "
    "im Suedosten der Gaenge eingenistet, wo sie einen unterirdischen Garten angelegt hat.", "sagt: ");

  AddInfo( ({"angzyne", "angzyne teken'val", "koenigin der drider"}),
    "Angzyne Teken'Val ist ein seltener Fall eines weiblichen Driders. Es heisst, sie wurde von Lloth einst "
    "direkt auserwaehlt - zumindest glaubt sie das. Sie kam in diese Hoehlen, um die Macht des Sangurit fuer "
    "sich selbst zu haben. Nun nistet sie in einem grossen Spinnenetz im Nordosten.", "sagt: ");

 AddInfo( ({"alsatar", "paladin"}),
    "Alsatar war ein Paladin, der versuchte Fistandantilus aufzuhalten. Dich er wurde, wie nicht anders zu "
    "erwarten, vom Zauberer getoetet. Danach hat er ihn als Untoten erhoben, der jetzt als letzter Waechter "
    "vor der versiegelten Tuer auf ewig steht. Es heisst, er soll im Sonnenlicht seine Kraft verlieren.", "sagt: ");


  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER)+" will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE, 40);

  SetProp(P_MNPC_FLAGS, 0);
}

public void init() {
    ::init();

    if(!interactive(TP)) return;

    call_out("greet", 0, TP);
}

public void greet(object pl) {
    if(!RANGER_CHECK_TASK(TP, 11)) {
        command_me("sag Psst, "+pl->Name(WER)+"! Ich habe die Kultisten des Omegatherions gesehen. Sie versuchen "
                   "an einen Sanguritkristall zu kommen. Wenn du schnell bist, kannst du vor ihnen hingelangen und "
                   "ihn schnappen, bevor sie dort sind.");
        return;
    }

    if(objectp(present("\ngwenshara_cave_sangurite_active", TP))) return;

    if(!objectp(present("\ngwenshara_cave_useless_sangurite", TP))) {
        command_me("sag Sei gegruesst, "+pl->Name(WER)+"! Vielleicht kannst du mir helfen einen Sangurit aus den "
                   "Hoehlen im Norden zu holen? Es soll dein Schaden nicht sein, auch wenn es aeusserst gefaehrlich "
                   "ist.");
        return;
    } else {
        command_me("sag Ah! Wunderbar, "+pl->Name(WER)+". Du hast einen Sangurit gefunden. Gib ihn mir, ich werde "
                   "ihn reinigen und dir einen Teil fuer dich selbst ueberlassen.");
        return;
    }
    return;
}

public void give_notify(object ob) {
    object activeSangurite;

    if(ob->id("\ngwenshara_cave_useless_sangurite")) {
        if(objectp(present("\ngwenshara_cave_sangurite_active", TP))) {
            command_me("sag Danke, "+TPN+". Du hast bereits einen Sangurit an dir. Dennoch, vielen Dank!");
            ob->remove(1);
            return;
        }

        command_me("sag Wunderbar! Vielen Dank. Damit hast du mir wirklich geholfen. Hier deine Belohnung.");
        tell_room(ENV(TO), BS(Name(WER)+" bricht ein Stueck vom Sangurit ab und spricht magische Worte, die den Kristall ergluehen lassen. Dann "
                  "rammt er den Stein in die Brust von "+TP->Name(WEM)+"."), ({TP}));
        tell_object(TP, BS(Name(WER)+" bricht ein Stueck vom Sangurit ab und spricht magische Worte, die den Kristall ergluehen lassen. Dann "
                  "rammt er dir den Stein in die Brust."));

        ob->remove(1);
        activeSangurite = clone_object(ARMOUR "active_sangurit");
        activeSangurite->move(TP, M_NOCHECK);
        activeSangurite->DoWear(1);
        EPMASTER->GiveExplorationPoint("sangurit", EP_MISC);
        return;
    }

    ::give_notify(ob);
    return;
}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+
    " killt den "+name(WEN,1)+".\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}
