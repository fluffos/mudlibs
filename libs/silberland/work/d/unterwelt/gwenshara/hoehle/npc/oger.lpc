#include "../def.h"

inherit NPC "std_npc";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, "Glugsch der Fettwanst, ein moenstroeser Klumpen von einem Oger");
    SetProp(P_LONG, "Glugsch ist ein abscheulich fetter Oger. Deshalb nennt man ihn auch "
                    "'Fettwanst'. Ueber all die Jahre, die er von seinen schleichenden "
                    "Wichten hier gefuettert wurde, hat er solche Ausmasse angenommen, "
                    "dass er diese Hoehle gar nicht mehr verlassen kann. Seine Beine "
                    "koennen den massigen Koerper gar nicht mehr tragen. Mit seinen "
                    "kleinen, gelben Augen glubscht er dich gierig an und waegt ab, "
                    "ob du eine leckere Mahlzeit bist.");
    SetProp(P_NAME, "Glugsch");
    SetProp(P_ARTICLE, 0);
    SetProp(P_GENDER, MALE);
    SetProp(P_RACE, "Oger");
    SetProp(P_SIZE, 250);
    SetProp(P_MSGIN, "schleppt sich schwerfaelig herein");
    SetProp(P_MMSGIN, "schleppt sich");
    AddId(({"glugsch", "oger", "\ngwenshara_evil_cave_oger"}));

    SetProp(P_CAVE_FACTION, F_OGER);
    create_dungeon_npc(40);
    
    SetProp(P_HANDS, ({" mit seinen riesigen Pratzen", QueryProp(P_HANDS)[1], DT_BLUDGEON }));
    SetProp(P_RESISTANCE_STRENGTHS, ([
        DT_WATER  : -0.2, DT_TERROR :  0.25, DT_LIGHT: 0.1, DT_UNHOLY: -0.1,
        DT_BLUDGEON: -0.3
    ]));

    SetProp(P_DIE_MSG, " faellt mit einem Krachen ruecklings um.\n");

    SetProp(P_SPELLRATE, 30);
    AddSpell(3, 300,
       Name(WER) + " setzt sich auf dich, um dich zu Suelze zu zerquetschen.\n",
       Name(WER) + " setzt sich auf @WEN, um @WEN zu Suelze zu zerquetschen.\n",
       DT_SQUEEZE, ([SP_SHOW_DAMAGE: 1]));

    AddSpell(2, 250,
        Name(WER) + " reisst ein Stueck Fleisch aus dir und veschlingt es.\n",
        Name(WER) + " reisst ein Stueck Fleisch aus @WEM und verschlingt es.\n",
        DT_POISON, "selfHeal", ([SP_SHOW_DAMAGE: 1]));

    AddDefaultSpell(1, 250, DS_MASS_DAMAGE,
            Name(WER) + " stoesst ein gutturales Bruellen und Heulen aus.\n",
            Name(WER) + " stoesst ein gutturales Bruellen und Heulen aus.\n",
            DT_SOUND);

    SetChats(7, ({
        Name(WER) + " schaut dich hungrig an.\n",
        Name(WESSEN) + " Magen knurrt.\n",
        Name(WER) + " fragt: Kann man dich zu Suelze quetschen?\n",
        Name(WER) + " gaehnt laut.\n",
        Name(WER) + " kratzt sich den fetten Hintern.\n",
        Name(WER) + " rollt sich schwerfaellig auf den Bauch.\n",
        Name(WER) + " ruft: BRINGT MIR ESSEN!!!\n",
        Name(WER) + " versucht aufzustehen, schafft es aber nicht.\n"
    }));

    CLONEME(WEAPON "ogerkeule");
    command_me("zuecke keule");

    CLONEME(ARMOUR "lendenschurz");
    command_me("trage alles");

    SetProp(P_MNPC_FLAGS, 0);
}

public void selfHeal(object enemy, int damage, mixed dtypes) {
    AddHp(100 + random(300));
}