#include "../def.h"

inherit NPC "std_npc";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();
    replace_program(NPC "std_npc");

    SetProp(P_SHORT, "Eine fette Hoehlenspinne haengt hier an der Decke und sabbert auf dich");
    SetProp(P_LONG, "Diese Hoehlenspinne ist richtig fett und haarig. Staendig sabbert sie "
                    "ein ekelhaften Sekret aus ihrem Maul.");
    SetProp(P_NAME, "Hoehlenspinne");
    SetProp(P_GENDER, FEMALE);
    SetProp(P_RACE, "Tier");
    SetProp(P_SIZE, 350);
    SetProp(P_MSGIN, "seilt sich von oben herab");
    SetProp(P_MMSGIN, "krabbelt");
    AddId(({"spinne", "hoehlenspinne", "\ngwenshara_evil_cave_spider"}));

    SetProp(P_CAVE_FACTION, F_DROW);
    create_dungeon_npc(23);
    
    SetProp(P_HANDS, ({" mit ihren Mandibeln", QueryProp(P_HANDS)[1], DT_PIERCE }));

    SetProp(P_DIE_MSG, " rollt sich auf den Ruecken.\n");

    SetProp(P_SPELLRATE, 10);

    SetProp(P_MNPC_FLAGS, 0);

    AddDefaultSpell(1, 200, DS_POISON,
      Name(WER) + " sticht dich mit ihrem Giftstachel!\n",
      Name(WER) + " sticht @WEN mit ihrem Giftstachel!\n");

}