#include "../def.h"

inherit NPC "std_npc";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();
    replace_program(NPC "std_npc");

    SetProp(P_SHORT, "Ein dunkelelfischer Spaeher");
    SetProp(P_LONG, "Dieser Dunkelelf wurde offenbar als Spaeher hier her geschickt. Er traget "
                    "dunkles Gewand, das sein Gesicht verbirgt und schleicht vorsichtig durch die "
                    "Schatten.");
    SetProp(P_NAME, "Spaeher");
    SetProp(P_GENDER, MALE);
    SetProp(P_RACE, "Dunkelelf");
    SetProp(P_SIZE, 180);
    SetProp(P_MSGIN, "schleicht herein");
    SetProp(P_MMSGIN, "schleicht");
    AddId(({"dunkelelf", "Bogenexperte", "spaeher"}));

    SetProp(P_CAVE_FACTION, F_NONE);
    create_dungeon_npc(28);
    
    SetProp(P_HANDS, ({" mit seinen Haenden", QueryProp(P_HANDS)[1], DT_BLUDGEON }));

    if(!random(3)) {
      CLONEME(WEAPON "vergiftete_armbrust");
    } else {
      CLONEME(WEAPON "armbrust");
    }
    command_me("zuecke armbrust");
}