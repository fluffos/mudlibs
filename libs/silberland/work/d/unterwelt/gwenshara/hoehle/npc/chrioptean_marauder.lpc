#include "../def.h"

inherit NPC "std_npc";

public void create() {

    if(!is_clone(this_object())) return;
    ::create();
    SetProp(P_SHORT, "Eine feledermausartige Monstrositaet stakst an dir vorbei");
    SetProp(P_LONG, "Vor dir erhebt sich eine riesige, fledermausartige Kreatur. Entfernt "
                    "erinnert sie an etwas Humanoides. Die Nase platt gedrueckt und spitze "
                    "Ohren aus fahler Haut erinnert dich das skeletartige Gesicht an "
                    "eine Fledermaus. Die Arme enden in zwei langen, spitzen Klauen unter "
                    "denen ledrige Schwingen haengen. Boesartige, gelbgluehende Augen "
                    "mit geschlitzten Pupullen mustern dich. Eine lange, blutrote Zunge "
                    "glitscht immer wieder aus dem zahnbewaehrten Maul.");
    SetProp(P_NAME, "Monstrositaet");
    SetProp(P_NAME_ADJ, "fledermausartig");
    SetProp(P_GENDER, FEMALE);
    SetProp(P_RACE, "Monster");
    SetProp(P_SIZE, 250);
    SetProp(P_MSGIN, "stakst herein");
    SetProp(P_MMSGIN, "stakst");
    AddId(({"monstrositaet"}));
    AddAdjective(({"fledermausartige", "fledermausartiger", "fledermausartigen"}));

    SetProp(P_CAVE_FACTION, F_PALADIN);
    create_dungeon_npc(16 + random(10));
    
    SetProp(P_HANDS, ({" mit Klauen und Zaehnen", QueryProp(P_HANDS)[1], ({DT_PIERCE, DT_SLASH}) }));
    SetProp(P_RESISTANCE_STRENGTHS, ([
        DT_HOLY: 0.3, DT_LIGHT: 0.6, DT_MAGIC: -0.1,
        DT_UNHOLY: -0.3, DT_TERROR: -0.3, DT_POISON: -0.1,
        DT_PIERCE: 0.1
    ]));

    SetProp(P_DIE_MSG, " stirbt bruellend.\n");

    SetProp(P_SPELLRATE, 33);

    AddSpell(2, 250,
       Name(WER) + " versucht dir die Kehle rauszureissen.\n",
       Name(WER) + " versucht @WEM die Kehle rauszureissen.\n",
       DT_RIP, ([SP_SHOW_DAMAGE: 1]));

    AddSpell(3, 150,
        Name(WER) + " schlitzt dir mit ihren Krallen den Bauch auf.\n",
        Name(WER) + " schlitzt @WEM mit ihren Krallen den Bauch auf.\n",
        DT_SLASH, ([SP_SHOW_DAMAGE: 1]));

    AddSpell(2, 200,
        Name(WER) + " wirft einen finsteren Schattenzauber nach dir.\n",
        Name(WER) + " wirft einen finsteren Schattenzauber nach @WEM.\n",
        DT_UNHOLY, ([SP_SHOW_DAMAGE: 1]));

    AddSpell(1, 300,
        Name(WER) + " beisst dir in den Hals, um dein Blut zu trinken!\n",
        Name(WER) + " beist @WEN in den Hals, um Blut zu trinken!\n",
        ({DT_PIERCE, DT_UNHOLY}), "drinkBlood", ([SP_SHOW_DAMAGE: 1]));
}

public void drinkBlood(object enemy, int damage, mixed dam_type) {
    AddHp(100);
}
