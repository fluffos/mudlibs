#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit NPC "std_npc";

public void create() {

    if(!is_clone(this_object())) return;
    ::create();
    SetProp(P_SHORT, "Ein verlorene Seele weht an dir vorbei");
    SetProp(P_LONG, "Purpur und halb durchscheinend und kaum gut erkennbar wabert eine "
                    "verlorene Seele vor dir. Sie ist schemenhaft als humanoid "
                    "zu erkennen, aber auch nicht viel mehr. ");
    SetProp(P_NAME, "Seele");
    SetProp(P_NAME_ADJ, "verloren");
    SetProp(P_GENDER, FEMALE);
    SetProp(P_RACE, "Untoter");
    SetProp(P_SIZE, 160);
    SetProp(P_MSGIN, "schwebt herein");
    SetProp(P_MMSGIN, "schwebt");
    AddId(({"seele"}));
    AddAdjective(({"verlorene", "verlorener", "verlorenen"}));

    SetProp(P_CAVE_FACTION, F_PALADIN);
    create_dungeon_npc(10 + random(5));

    SetProp(P_CONTROLLABLE_BY_NEKRO, 1);
    
    SetProp(P_HANDS, ({" mit geisterhaften Haenden", QueryProp(P_HANDS)[1], DT_MAGIC }));
    SetProp(P_RESISTANCE_STRENGTHS, ([
        DT_HOLY: 1.0, DT_LIGHT: 0.3, DT_MAGIC: 0.1,
        DT_UNHOLY: -0.5, DT_TERROR: -1.0, DT_POISON: -1.0,
        DT_SLASH: -1.0, DT_PIERCE: -1.0, DT_BLUDGEON: -1.0, DT_SQUEEZE: -1.0, 
        DT_WHIP: -1.0, DT_RIP: -1.0
    ]));

    SetProp(P_DIE_MSG, " loest sich auf.\n");
    SetProp(P_NOCORPSE, 1);

    SetProp(P_SPELLRATE, 20);
    AddSpell(1, 150,
       Name(WER) + " greift mit eiskalten Haenden in deine Brust.\n",
       Name(WER) + " greift in @WESSEN Brust.\n",
       DT_COLD, ([SP_SHOW_DAMAGE: 1]));

    AddSpell(1, 150,
        Name(WER) + " laesst ein schreckliches Jaulen ertoenen.\n",
        Name(WER) + " laesst ein schreckliches Jaulen ertoenen.\n",
        DT_SOUND, ([SP_SHOW_DAMAGE: 1]));
}
