#include "../def.h"

inherit NPC "std_npc";

public void create() {
    string adj, art, description;
    int lvl;

    if(!is_clone(this_object())) return;
    ::create();

    lvl = 10 + random(10);
    switch(lvl) {
        case 10 .. 12: adj = "kleiner"; break;
        case 13 .. 15: adj = "mittelgrosser"; break;
        case 16 .. 17: adj = "grosser"; break;
        case 18 .. 19: adj = "sehr grosser";
        default: adj = "maechtiger"; break;
    }

    switch(random(100)) {
        case 0 .. 10: art = "Menschen"; break;
        case 11 .. 30: art = "Zwergen"; break;
        case 31 .. 45: art = "Elfen"; break;
        case 46 .. 70: art = "Dunkelelfen"; break;
        case 71 .. 80: art = "Hobbit"; break;
        case 81 .. 85: art = "Trolls"; break;
        case 86 .. 92: art = "Ogers"; break;
        default: art = "Orks"; break;
    }

    switch(random(7)) {
        case 0: description = " haengt hier von der Decke"; break;
        case 1: description = " klettert an der Wand entlang"; break;
        case 2: description = ""; break;
        case 3: description = " bedeckt die Umgebung mit Spinnweben"; break;
        case 4: description = " klackert aufgeregt mit den Mandibeln"; break;
        case 5: description = " steht reglos herum"; break;
        default: description = " faucht dich an"; break;
    }

    SetProp(P_SHORT, "Ein " + adj + " Drider" + description);
    SetProp(P_LONG, "Diese widerliche Kreatur muss aus der Unterwelt hier "
                    "herauf gekrochen sein. Sie hat den Unterkoerper einer "
                    "riesigen Spinne, mit dem durch finstere Magie der "
                    "Oberkoerper eines " + art + " verschmolzen wurde. Rot "
                    "gluehende Augen starren dir entgegen.");
    SetProp(P_NAME, "Drider");
    SetProp(P_GENDER, MALE);
    SetProp(P_RACE, "Drider");
    SetProp(P_SIZE, 150 + lvl*2);
    SetProp(P_MSGIN, "krabbelt herein");
    SetProp(P_MMSGIN, "krabbelt");
    SetProp(P_MMSGOUT, "krabbelt"); 
    AddId(({"drider"}));

    SetProp(P_CAVE_FACTION, F_DROW);
    create_dungeon_npc(lvl);
    
    SetProp(P_HANDS, ({" mit seinen Mandibeln und finsterer Magie", QueryProp(P_HANDS)[1], DT_PIERCE }));
    SetProp(P_RESISTANCE_STRENGTHS, ([
        DT_HOLY: 0.2, DT_LIGHT: 0.3,
        DT_UNHOLY: -0.5, DT_TERROR: -0.3, DT_POISON: -0.1
    ]));

    SetProp(P_DIE_MSG, " winkelt die Beine an und rollt auf den Ruecken.\n");

    SetProp(P_SPELLRATE, lvl);
    AddSpell(3, 100+lvl,
       Name(WER) + " schleudert einen Terrorblitz nach dir.\n",
       Name(WER) + " schleudert einen Terrorblitz nach @WEM.\n",
       DT_TERROR, ([SP_SHOW_DAMAGE: 1]));

    AddSpell(2, 150+lvl,
        Name(WER) + " beisst dich mit seinen Zaehnen.\n",
        Name(WER) + " beisst @WEN mit seinen Zaehnen.\n",
        DT_POISON, ([SP_SHOW_DAMAGE: 1]));
 

    if(lvl > 13) {
        AddSpell(1, 190+lvl,
            Name(WER) + " schmettert eine Dunkellanze auf dich.\n",
            Name(WER) + " schmettert eine Dunkellanze auf @WEN.\n",
            DT_UNHOLY, ([SP_SHOW_DAMAGE: 1]));
    }

    if(lvl > 16) {
        AddDefaultSpell(1, 150+lvl, DS_POISON,
            Name(WER) + " beisst dich und spritzt Gift in die Wunde.\n",
            Name(WER) + " beist @WEN und spritzt Gift in die Wunde.\n");
    }

    if(lvl > 18) {
        AddDefaultSpell(1, 0, DS_SLOW,
            Name(WER) + " sprueht dich mit Spinweben ein.\n",
            Name(WER) + " sprueht @WEN mit Spinnweben ein.\n");
    }

    if(!random(5)) {
        CLONEME(WEAPON "driderlanze");
        command_me("zuecke lanze");
    }
}