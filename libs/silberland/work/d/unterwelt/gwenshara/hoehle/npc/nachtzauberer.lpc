#include "../def.h"

inherit NPC "std_npc";

private int protection;

public void create() {

    if(!is_clone(this_object())) return;
    ::create();
    SetProp(P_SHORT, "Ein in Kutten gehuellter Nachtzauberer vollfuehrt dunkle Riten");
    SetProp(P_LONG, "Die Gestalt, die sich vor dir erhebt ist etwa menschengross. Was sich "
                    "unter den nachtblauen Roben verbirgt, kannst du nicht ausmachen. "
                    "Bestaendig murmelt die Gestalt mystische Worte vor sich hin und "
                    "verbreitet Dunkelheit und Nacht.");
    SetProp(P_NAME, "Nachtzauberer");
    SetProp(P_GENDER, MALE);
    SetProp(P_RACE, "Mensch");
    SetProp(P_SIZE, 175);
    SetProp(P_MSGIN, "kommt an");
    SetProp(P_MMSGIN, "geht");
    AddId(({"zauberer", "nachtzauberer"}));

    SetProp(P_CAVE_FACTION, F_NONE);
    create_dungeon_npc(20 + random(15));
    
    SetProp(P_HANDS, ({" mit finsteren Zaubern der Nacht", QueryProp(P_HANDS)[1], ({DT_MAGIC, DT_UNHOLY}) }));
    SetProp(P_RESISTANCE_STRENGTHS, ([
        DT_HOLY: 0.1, DT_LIGHT: 0.2, DT_MAGIC: -0.3,
        DT_UNHOLY: -0.1, DT_TERROR: -0.1, DT_COLD: -0.1,
        DT_FIRE: 0.1
    ]));

    SetProp(P_DIE_MSG, " stolpert fluchend und bleibt reglos liegen.\n");

    SetProp(P_SPELLRATE, 50);

    AddSpell(2, 250,
       Name(WER) + " deutet auf dich und ruft: Bur hex zolem abstrazzaus!\n",
       Name(WER) + " deutet auf @WEN und ruft: Bur hex zolem abstrazzaus!\n",
       DT_MAGIC, ([SP_SHOW_DAMAGE: 1]));

    AddSpell(2, 250,
        Name(WER) + " beruehrt dich mit den Worten: Ulem-benzar! Hog neget!\n",
        Name(WER) + " beruehrt @WEN mit den Worten: Ulem-benzar! Hog neget!\n",
        DT_UNHOLY, ([SP_SHOW_DAMAGE: 1]));

    AddDefaultSpell(1, 100, DS_CURSE_WEAPON,
        Name(WER) + " laesst einen Nachtschatten in deine Waffe einfahren.\n",
        Name(WER) + " laesst einen Nachtschatten in @WESSEN Waffe einfahren.\n"
    );

    AddDefaultSpell(1, 150, DS_BLIND,
        Name(WER) + " haelt sich die Hand vor die Augen, ruft 'Algizz zvar unulug!' und deutet auf dich.\n",
        Name(WER) + " haelt sich die Hand vor die Augen, ruft 'Algizz zvar unulug!' und deutet auf @WEN.\n"
    );

    AddSpell(2, 0,
        Name(WER) + " huellt sich in Dunkelheit.\n",
        Name(WER) + " huellt sich in Dunkelheit.\n",
        DT_MAGIC, "shadowShield"
    );

    protection = 0;
}

public void shadowShield(object enemy, int damage, mixed dam_type) {
    protection = 1;
}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {
    if(!pointerp(dam_type_list)) dam_type_list = ({dam_type_list});

    if(protection && member(dam_type_list, DT_LIGHT) < 0) {
        if(!random(2)) {
            tell_room(environment(this_object()), BS("Der Angriff geht ins Leere!"));
            dam /= 3;
        }
        if(!random(3)) {
            tell_room(environment(this_object()), BS("Die Dunkelheit um " + Name(WEN) + " loest sich auf."));
            protection = 0;
        }
    } else if( member(dam_type_list, DT_LIGHT) >= 0) {
        tell_room(environment(this_object()), BS("Das grelle Licht durchschlaegt " + Name(WEN) + " Schild aus Dunkelheit!"));
        protection = 0;
    }

    return ::Defend(dam, dam_type_list, spell, enemy);
}