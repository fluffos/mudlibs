#include "../def.h"

inherit "/p/std/npc/berserker_npc";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, "Angradur, ein degenerierter Hoehlentroll");
    SetProp(P_LONG, "Angradur ist ein riesiger, muskelbepakter Troll. Sein schwarzes Fell ist "
                    "zottelig und blutverkrustet. Seine Augen gluehen in einem unheimlichen Orange "
                    "und aus seinem Kopf ragen vier wild verdrehte Hoerner, wie Stacheln. Sein "
                    "Gesicht ist eine verzerrte Fratze aus Wut und Zorn. In seinen Augen flammt nur "
                    "der Wunsch danach dich zu zerfetzen auf.");
    SetProp(P_NAME, "Angradur");
    SetProp(P_ARTICLE, 0);
    SetProp(P_GENDER, MALE);
    SetProp(P_RACE, "Troll");
    SetProp(P_SIZE, 500);
    SetProp(P_MSGIN, "stampft wuetend bruellend herein");
    SetProp(P_MMSGIN, "stampft wuetend");
    AddId(({"angradur", "troll", "hoehlentroll", "\ngwenshara_evil_cave_troll"}));

    create_default_berserker(40, 10); 
    
    SetProp(P_HANDS, ({" mit seinen riesigen Pranken", QueryProp(P_HANDS)[1], DT_BLUDGEON }));
    SetProp(P_RESISTANCE_STRENGTHS, ([
        DT_FIRE  : 0.3, DT_TERROR :  -0.8, DT_LIGHT: 0.1, DT_UNHOLY: -0.1,
        DT_BLUDGEON: -0.5, DT_RIP: -0.5, DT_SQUEEZE: -0.5, DT_SLASH: -0.5
    ]));

    SetProp(P_DIE_MSG, " stirbt mit einem lauten Wutschrei.\n");

    SetProp(P_SPELLRATE, 30);
  
    CLONEME(WEAPON "doppelaexte");
    command_me("zuecke aexte");

    
    SetProp(P_MNPC_AREA, ({ROOM}) );
    SetProp(P_MNPC_WAIT, ({10, 15, 30}));
    SetProp(P_MNPC_DEFAULTROOM, ROOM  "c2_b2_see");
    SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES);

    CLONEME(OBJ "ringteil_5");

    call_out("runaway", 300);
}

public void runaway() {
    if(!InFight()) {
        tell_room(ENV(TO), BS("Angradur bruellt laut auf und laeuft davon."));
        if(present("aexte")) present("aexte")->remove(1);
        if(present("teil")) present("teil")->remove(1);
        remove(1);
    } else {
        call_out("runaway", 120);
    }
    return;
}

public void reset() {
    if(!is_clone(TO)) return;
    ::reset();
    
    runaway();
}

public void init() {
    ::init();

    if(living(TP) && !IsEnemy(TP)) {
        call_out("threaten_kill", 0, TP);
    }

    if(objectp(ENV(TO)) && ENV(TO)->QueryBrettAngesaegt()) {
        call_out("runterfallen");
    }

    return;
}

public void runterfallen() {
    tell_room(ENV(TO), BS(Name(WER)+" tritt mit seinem ganzen Gewicht auf das angesaegte Brett und stuerzt in den Tod."));
    if(objectp(present("aexte"))) present("aexte")->remove(1);
    die();
    return;
}

public void threaten_kill(object pl) {
    if(!objectp(pl)) return;
    if(IsEnemy(pl)) return;
    if(!present(pl, ENV(TO))) return;

    tell_room(ENV(TO), BS(Name(WER)+" fixiert "+pl->name(WEN)+" wutschnaubend."), ({pl}));
    tell_object(pl, BS(Name(WER)+" fixiert dich wutschnaubend. Das ist deine letzte Chance zu fliehen!"));

    call_out("attack_victim", 4, pl);
    return;
}

public void attack_victim(object pl) {
    if(!objectp(pl)) return;
    if(IsEnemy(pl)) return;
    if(!present(pl, ENV(TO))) return;

    tell_room(ENV(TO), BS(Name(WER)+" stuerzt sich bruellend auf "+pl->name(WEN)+"."), ({pl}));
    tell_object(pl, BS(Name(WER)+" stuerzt sich bruellend auf dich!"));

    Kill(pl);
    return;
}
