#include "../def.h"

inherit NPC "std_npc";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();
    replace_program(NPC "std_npc");

    SetProp(P_SHORT, "Eine Kreatur mit rauchenden Fluegeln aus rauchender Finsternis kreist um dich.");
    SetProp(P_LONG, "Diese, etwa trollgrosse Kreatur, scheint fast nur aus Schatten und Finsternis "
                    "zu bestehen. Ab und zu siehst du ihre violetten Augen duester funkeln. Auf dem "
                    "langen, schlangenartigen Koerper sitzt ein kleiner Kopf und Fluegel aus rauchender "
                    "Finsternis wuchern daraus hervor.");
    SetProp(P_NAME, "Duesternispirscher");
    SetProp(P_GENDER, MALE);
    SetProp(P_RACE, "Tier");
    SetProp(P_SIZE, 350);
    SetProp(P_MSGIN, "gleiet herein");
    SetProp(P_MMSGIN, "gleitet");
    AddId(({"kreatur", "duesternispirscher"}));
    AddClass(CL_FLYING);

    SetProp(P_CAVE_FACTION, F_NONE);
    create_dungeon_npc(20+random(10));
    
    SetProp(P_HANDS, ({" mit Klauen aus Dunkelheit", QueryProp(P_HANDS)[1], DT_RIP }));

    SetProp(P_DIE_MSG, " kracht mit einem Kreischen zu Boden.\n");

    SetProp(P_SPELLRATE, 25);

    AddSpell(1, 200,
       Name(WER) + " stuerzt auf dich herab.\n",
       Name(WER) + " stuerzt auf @WEN herab.\n",
       DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));

    AddSpell(1, 300,
      Name(WER) + " kreischt laut auf.\n",
      Name(WER) + " kreischt laut auf.\n",
      DT_SOUND, ([SP_SHOW_DAMAGE: 1]));
}