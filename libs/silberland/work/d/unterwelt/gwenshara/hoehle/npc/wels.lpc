#include "../def.h"

inherit NPC "std_npc";

public void create() {
    string adj, art, description;
    int lvl;

    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, "Eine riesiger Hoehlenwels schwimmt hier");
    SetProp(P_LONG, "Dieser Wels ist einfach gigantisch. Er ist sicher zehn Meter lang und schwimmt hier gemuetlich vor sich hin.");
    SetProp(P_NAME, "Hoehlenwels");
    SetProp(P_GENDER, MALE);
    SetProp(P_RACE, "Fisch");
    SetProp(P_SIZE, 20);
    SetProp(P_MSGIN, "taucht auf");
    SetProp(P_MMSGIN, "schwimmt");
    AddId(({"wels", "hoehlenwels"}));

    SetProp(P_CAVE_FACTION, F_NONE);
    create_dungeon_npc(20);
    
    SetProp(P_HANDS, ({" mit seinem riesigen Maul", QueryProp(P_HANDS)[1], DT_SQUEEZE }));

    SetProp(P_DIE_MSG, " dreht sich auf den Ruecken und ist tot.\n");

    SetProp(P_MNPC_FLAGS, 0);
}