#include "../def.h"

inherit NPC "std_npc";

public void create() {
    string adj, art, description;
    int lvl;

    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, "Eine lebendige Rebe mit schwarzem Wein");
    SetProp(P_LONG, "Diese Weinrebe mit ihren glaenzenden schwarzen Trauben ist lebendig. Sie hebt die "
                    "Wurzeln wie Fuesse aus der Erde und ihre Ranken peitschen wild um sich.");
    SetProp(P_NAME, "Rebe");
    SetProp(P_GENDER, FEMALE);
    SetProp(P_RACE, "Pflanze");
    SetProp(P_SIZE, 200);
    SetProp(P_MSGIN, "kriecht herein");
    SetProp(P_MMSGIN, "kriecht");
    AddId(({"rebe", "weinrebe", "wein", "\nrebenmonster"}));

    SetProp(P_CAVE_FACTION, F_BLOOD);
    create_dungeon_npc(25);
    
    SetProp(P_HANDS, ({" mit ihren Trauben", QueryProp(P_HANDS)[1], DT_BLUDGEON }));
    SetProp(P_MNPC_FLAGS, 0);

    SetProp(P_DIE_MSG, " zerfaellt zu einem Haufen.\n");

    SetProp(P_SPELLRATE, 30);
    AddSpell(2, 200,
       Name(WER) + " peitscht mit einer Wurzel nach dir.\n",
       Name(WER) + " peitscht mit einer Wurzel nach @WEM.\n",
       DT_WHIP, ([SP_SHOW_DAMAGE: 1]));

    AddSpell(1, 300,
       Name(WER) + " umwickelt dich mit ihren Ranken und saugt dir Blut ab!\n",
       Name(WER) + " umweickelt @WEN mit ihren Ranken und saugt Blut ab!\n",
       DT_POISON, "drink_blood", ([SP_SHOW_DAMAGE: 0]));

    CLONEME(OBJ "weinbeere");
}

public void drink_blood(object enemy) {
    int t;

    t = 2+random(5);
    SetProp(P_DISABLE_ATTACK, t);
    enemy->SetProp(P_PARALYZED, ([
        PARALYZE_TIME: t,
        PARALYZE_MSG: "Du bist von Ranken umwickelt!\n",
        PARALYZE_MSG_OTHER: "%s kaempft gegen die Ranken der Weinrebe!\n",
        PARALYZE_END: "Die Weinrebe laesst dich wieder los!\n",
        PARALYZE_END_OTHER: "Die Weinrebe laesst %s wieder los!\n" 
    ]));
    call_out("deblood_enemy", 0, t, enemy);
}

public void deblood_enemy(int t, object enemy) {
    enemy->AddHp(-random(10));
    if(--t>0)  call_out("deblood_enemy", 0, t, enemy);
    return;
}