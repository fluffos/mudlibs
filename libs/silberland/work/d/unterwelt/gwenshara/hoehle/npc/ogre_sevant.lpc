#include "../def.h"

inherit NPC "std_npc";

public void create() {
    string adj, art, description;
    int lvl;

    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, "Eine bleicher zwergenartiger Wicht durchsucht diesen Gang");
    SetProp(P_LONG, "Die Kreatur, die sich vor die am Boden windet, ist erbaermlich. "
                    "Dieser Wicht sieht aus, wie ein degenerierter, bleicher und "
                    "nackter Zwerg. Aus seinem uebergrossen Kopf quellen grosse, "
                    "gelbe Augen hervor. Mit seinen langen, spinnenartigen Fingern "
                    "sucht er den Dreck am Boden ab.");
    SetProp(P_NAME, "Wicht");
    SetProp(P_GENDER, MALE);
    SetProp(P_RACE, "Zwerg");
    SetProp(P_SIZE, 120);
    SetProp(P_MSGIN, "kriecht herein");
    SetProp(P_MMSGIN, "kriecht");
    AddId(({"wicht", "zwerg", "\nzwergenwicht"}));

    SetProp(P_CAVE_FACTION, F_OGER);
    create_dungeon_npc(10 + random(5));

    SetProp(P_DIE_MSG, " kruemmt sich sterbend zusammen.\n");

    if(!random(2))
        CLONEME(ARMOUR "lendenschurz");

    command_me("trage alles");
}

public void init() {
    ::init();

    if(present("\nzwergenwicht 2", environment(this_object()))) {
        if(find_call_out("becomeAggressive") == -1)
          call_out("becomeAggressive", 2);
    }

    call_out("collectItems", 2+random(3));
}

public void collectItems() {
    if(InFight()) return;

    command_me("emote schnueffelt herum und sammelt dann alles ein.");
    command_me("nimm alles");
    return;
}

public int isTarget(object ob) {
    return living(ob) && !IS_LEARNER(ob) && !ob->id("\nzwergenwicht");
}

public void becomeAggressive() {
    object *who;
    int i;

    command_me("emote blickt zu seinem Kollegen und dann knurrend in deine Richtung.");
    SetProp(P_AGGRESSIVE, 1);

    who = filter_array(all_inventory(environment(this_object())), "isTarget");
    for(i=0; i<sizeof(who); ++i) {
        if(objectp(who))  Kill(who);
    }
    return;
}