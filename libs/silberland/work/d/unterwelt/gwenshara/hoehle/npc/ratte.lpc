#include "../def.h"

inherit NPC "std_npc";

public void create() {
    string adj, art, description;
    int lvl;

    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, "Eine ekelhafte Ratte quiekt dich an");
    SetProp(P_LONG, "Eine zerzauste, verdreckte und ekelhaft verschmierte Ratte laueft hier herum.");
    SetProp(P_NAME, "Hoellenfledermaus");
    SetProp(P_GENDER, FEMALE);
    SetProp(P_RACE, "Tier");
    SetProp(P_SIZE, 20);
    SetProp(P_MSGIN, "flitzt herein");
    SetProp(P_MMSGIN, "flitzt");
    AddId(({"ratte", "ratte"}));

    SetProp(P_CAVE_FACTION, F_NONE);
    create_dungeon_npc(8);
    
    SetProp(P_HANDS, ({" mit ihren spitzen Zaehnen", QueryProp(P_HANDS)[1], DT_PIERCE }));

    SetProp(P_DIE_MSG, " quiekt ein letztes Mal auf.\n");
}