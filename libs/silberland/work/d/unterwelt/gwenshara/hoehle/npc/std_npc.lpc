#include "../def.h"

#include "/gilden/nekromanten/nekro_properties.h"

inherit "/p/std/npc/nekro_npc";
inherit "/std/npc/spells";

public void create() {
    if (!is_clone(TO)) return;
    ::create();
    AddId(({"\ngwenshara_evil_cave_npc"}));

    SetProp(P_MNPC_AREA, ({ROOM}) );
    SetProp(P_MNPC_WAIT, ({10, 15, 30}));
    SetProp(P_MNPC_DEFAULTROOM, ROOM "b6_b2_tor");
    SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES);
    SetProp(P_CONTROLLABLE_BY_NEKRO, 0);
}

public void create_dungeon_npc(int lvl) {
    create_default_npc(lvl);

    SetProp(P_ALIGN, -300 - random(700));
    SetProp(P_HEAL, lvl / 3);

   
}

public void specialDeath(int poisondeath) {
    object killer;

    // Jemanden in dem Dungeon zu toeten ist fuer boese Leute keine gute Tat...
    // wir verstaerken immer das alignment
    if(!poisondeath) {
        killer = QueryProp(P_KILLER);
        if(objectp(killer) && (killer->QueryProp(P_GUILD) == "nekromanten" || killer->QueryProp(P_ALIGN) < -40)) {
            SetProp(P_ALIGN, QueryProp(P_ALIGN) * -1);
        }
    }
}

public void die(int poisondeath) {
    specialDeath(poisondeath);
    return ::die(poisondeath);
}

// feindliche NPC greifen sich gegenseitig an
public void checkForKill(object who) {
    int faction;

    if(!objectp(who)) return;

    faction = who->QueryProp(P_CAVE_FACTION);
    if(faction == F_NONE || QueryProp(P_CAVE_FACTION) == F_NONE) return; // neutraler npc

    if(faction != QueryProp(P_CAVE_FACTION)) {
        command_me(sprintf("emote stuerzt sich bruellend auf %s.", who->name(WEN)));
        Kill(who);
    } else {
        AddDefender(who);
    }
    return;
}

public void init() {
    ::init();
    if(!is_clone(this_object())) return;

    if(living(this_player()) && !interactive(this_player()) && !InFight()) {
        call_out("checkForKill", 2+random(5), this_player());
    }
}
