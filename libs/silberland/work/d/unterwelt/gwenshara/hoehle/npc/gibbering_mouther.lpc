#include "../def.h"

inherit NPC "std_npc";

public void create() {

    if(!is_clone(this_object())) return;
    ::create();
    SetProp(P_SHORT, "Eine Masse aus Fleisch mit hunderten Maeulern");
    SetProp(P_LONG, "Alleine der Anblick dieser Kreatur(?) laesst Uebelkeit in dir "
                    "aufsteigen. Ectoplasmisches Fleisch wallt in einer formlosen "
                    "Masse vor sich hin, ueberzogen von einer widerlichen, purpur"
                    "farbenen Schleimschicht. Doch das erschreckendste sind die "
                    "unzaehligen, zahnbewaehrten Maeuler und glubschenden Augen, "
                    "die sich aus dieser Masse erheben. Die Kreatur gibt ein "
                    "staendiges Jammern und Plappern von sich, dass dir "
                    "Kopfschmerzen bereitet.");
    SetProp(P_NAME, "Hundertmaul");
    SetProp(P_NAME_ADJ, "plappernd");
    SetProp(P_GENDER, NEUTER);
    SetProp(P_RACE, "Daemon");
    SetProp(P_SIZE, 100);
    SetProp(P_MSGIN, "wallt herein");
    SetProp(P_MMSGIN, "wallt");
    AddId(({"hundertmaul", "masse", "maeuler", "kreatur"}));
    AddAdjective(({"plappernd", "plappernde", "plapperndes"}));

    SetProp(P_CAVE_FACTION, F_NONE);
    create_dungeon_npc(16 + random(10));
    
    SetProp(P_HANDS, ({" mit einen hunderten Maeulern", QueryProp(P_HANDS)[1], DT_RIP }));
    SetProp(P_RESISTANCE_STRENGTHS, ([
        DT_HOLY: 0.3, DT_LIGHT: 0.6, DT_MAGIC: 0.1,
        DT_TERROR: -0.3, DT_MIND: -0.1
    ]));

    SetProp(P_DIE_MSG, " gurgelt ekelhaft und zerlaeuft.\n");

    SetProp(P_SPELLRATE, 45);

    AddSpell(2, 250,
       Name(WER) + " bildet einen fleischigen Tentakel aus und schlaegt nach dir.\n",
       Name(WER) + " bildet einen fleischigen Tentakel aus und schlaegt nach @WEM.\n",
       DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));

   AddDefaultSpell(1, 250, DS_FEAR,
       Name(WESSEN) + " huderte Maeuler beginnin laut zu Jammern und schrecklich zu Kreischen!\n",
       Name(WESSEN) + " huderte Maeuler beginnin laut zu Jammern und schrecklich zu Kreischen!\n@WER wird ganz blass.\n");

    AddSpell(2, 300,
        Name(WER) + " begraebt sich unter seinen Fleischmassen.\n",
        Name(WER) + " begraebt @WEN unter seinen Fleischmassen.\n",
        DT_SQUEEZE, ([SP_SHOW_DAMAGE: 1]));

    AddSpell(2, 300,
        Name(WER) + " beisst dich.\n",
        Name(WER) + "beisst @WEN.\n",
        DT_RIP, ([SP_SHOW_DAMAGE: 1]));
    

    AddDefaultSpell(1, 300, DS_MASS_DAMAGE,
        Name(WESSEN) + " beginnt aus allen Maeulern heraus laut zu plappern! Es dringt in deinen Geist ein!!!\n",
        Name(WESSEN) + " beginnt aus allen Maeulern heraus laut zu plappern! Es dringt in deinen Geist ein!!!\n",
       DT_MIND);
}
