#include "../def.h"

inherit NPC "std_npc";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, "Angzyne Teken'val die Koenigin der Drider, Erwaehlte der Lloth");
    SetProp(P_LONG, "Angzyne ist die Koenigin aller Drider. Einst war sie eine wunderschoene "
                    "Dunkelelfe - und im Grunde ist sie das immer noch, nur ist ihr Unterkoerper "
                    "der einer riesigen, schwarz-roten Spinne. Normalerweise sind alle Drider "
                    "aus unwuerdigen Maennern geschaffen. Doch Angzyne Teken'val hat ihrer "
                    "Goettin das letzte Opfer erbracht und gebietet ueber all die Maenner.");
    SetProp(P_NAME, "Angzyne Teken'val");
    SetProp(P_ARTICLE, 0);
    SetProp(P_ALIGN, -1000);
    SetProp(P_GENDER, MALE);
    SetProp(P_RACE, "Dunkelelf");
    SetProp(P_SIZE, 400);
    SetProp(P_MSGIN, "krabbelt herein");
    SetProp(P_MMSGIN, "krabbelt");
    AddId(({"angzyne", "teken'val", "koenigin", "erwaehlte", "\ngwenshara_evil_cave_driderqueen"}));

    SetProp(P_CAVE_FACTION, F_DROW);
    create_dungeon_npc(45);
    
    SetProp(P_HANDS, ({" mit finsterer Zauberei", QueryProp(P_HANDS)[1], DT_UNHOLY }));
    SetProp(P_RESISTANCE_STRENGTHS, ([
        DT_TERROR :  -0.4, DT_LIGHT: 0.3, DT_UNHOLY: -0.4,
        DT_MAGIC: -0.1, DT_HOLY: 0.2
    ]));

    SetProp(P_DIE_MSG, " faehrt kreischend zu Lloth.\n");

    SetProp(P_SPELLRATE, 50);

    AddSpell(3, 200,
        Name(WER) + " schleudert einen Terrorblitz nach dir.\n",
        Name(WER) + " schleudert einen Terrorblitz nach @WEM.\n",
        DT_TERROR, ([SP_SHOW_DAMAGE: 1]));

    AddSpell(2, 250,
        Name(WER) + " schmettert eine Dunkellanze auf dich.\n",
        Name(WER) + " schmettert eine Dunkellanze auf @WEN.\n",
        DT_UNHOLY, ([SP_SHOW_DAMAGE: 1]));

    AddDefaultSpell(1, 200, DS_POISON,
        Name(WER) + " sticht dich mit ihrem Giftstachel und spritzt Gift in die Wunde.\n",
        Name(WER) + " sticht @WEN mit ihrem Giftstachel und spritzt Gift in die Wunde.\n");

    AddDefaultSpell(1, 0, DS_SLOW,
        Name(WER) + " sprueht dich mit Spinweben ein.\n",
        Name(WER) + " sprueht @WEN mit Spinnweben ein.\n");

    AddSpell(1, 500,
        Name(WER) + " hebt die Arme und tausende Spinnen fallen ueber dich her!\n",
        Name(WER) + " hebt die Arme und tausende Spinnen fallen ueber @WEN her!\n",
        ({DT_PIERCE, DT_POISON}), ([SP_SHOW_DAMAGE: 1]));

    AddSpell(1, 0,
        Name(WER) + " ruft die Macht LLoths an und ein Drider erscheint.\n",
        Name(WER) + " ruft die Macht LLoths an und ein Drider erscheint.\n",
        DT_UNHOLY, "callDrider");

    SetChats(3, ({
        Name(WER) + " webt ein feines Netz.\n",
        Name(WESSEN) + " Augen funkeln rot in der Dunkelheit.\n",
        Name(WER) + " betet zu Lloth und es wird finster.\n",
        Name(WER) + " webt am Netz weiter.\n",
        Name(WER) + " wickelt etwas in einen Kokon.\n"
    }));

    SetProp(P_MNPC_FLAGS, 0);

    CLONEME(OBJ "ringteil_3");
    CLONEME("/p/std/skills/sewing_tanning/obj/spinnenseide");
    CLONEME("/p/std/skills/sewing_tanning/obj/spinnenseide");
    if(!random(2))
        CLONEME("/p/std/skills/sewing_tanning/obj/spinnenseide");
    if(!random(2))
        CLONEME("/p/std/skills/sewing_tanning/obj/spinnenseide");

    CLONEME(WEAPON "driderlanze");
    present("driderlanze")->MakeMagic();
    command_me("zuecke lanze");
}

public void callDrider(object enemy, int damage, mixed dtypes) {
    object ob;

    ob = clone_object(NPC "drider");
    if(ob->move(environment(TO), M_NOCHECK|M_SILENT) != 1) {
        destruct(ob);
    }
    AddDefender(TO);
    AddPursuer(TO);
    ob->SetProp(P_MNPC_FLAGS, 0);
    return;
}