#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Ein langer, dicker Holzstock");
  SetProp(P_LONG,
    "Im Grunde ist das hier nichts anderes als ein ueblicher Holzstock, wie "
    "du ihn ueberall findest. Er ist nur laenger und dicker. In seiner "
    "Beschaffenheit eignet er sich hervorragend als Hebel fuer schwere Dinge.");

  SetProp(P_NAME, "Holzstock");
  SetProp(P_GENDER, MALE);
  AddId( ({"stock", "holzstock", "\ngwenshara_evil_cave_lever"}) );

  SetProp(P_MATERIAL, ([MAT_WOOD: 100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 250);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 50);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON}) );
  SetProp(P_NR_HANDS, 2);
}