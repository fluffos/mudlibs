#include "../def.h"

inherit "std/weapon";

int hitcounter;

public void create() {
  if(!is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Eine Blutdornpeitsche");
  SetProp(P_LONG,
    "Diese Peitsche ist aus einer Ranke von Blutdorn gemacht. Die gruene Ranke wird "
    "von langen, roten Dornen ueberzogen. Als Griff wurde ein Stueck lederumwickeltes "
    "Holz verwendet. Die Ranke zuckt und bewegt sich merkwuerdig unter deinem Griff.");

  SetProp(P_NAME, "Blutdornpeitsche");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"peitsche", "blutdornpeitsche", }) );

  SetProp(P_MATERIAL, ([MAT_MISC_PLANT: 100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 200);
  SetProp(P_VALUE, 2500);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_RIP, DT_WHIP}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["\ngwenshara_evil_bloodelf": 300]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX: 21]) );

  SetProp(P_HIT_FUNC, TO);

  hitcounter = 0;
  SetProp(P_INFO, "Der Blutdorn ernaehrt sich vom Blut seiner Opfer und waechst.");
}

public int HitFunc(object enemy) {
  object wielder;
  int damMod;

  if(!objectp(wielder=QueryProp(P_WIELDED))) return 0;
  if(enemy->is_class_member(CL_UNDEAD)) return 0;

  if(hitcounter >= 1000 && QueryProp(P_WC) < 222) {
    hitcounter = 0;
    SetProp(P_WC, QueryProp(P_WC)+random(10));
    SetProp(P_SIZE, QueryProp(P_SIZE)+random(10));
    tell_object(wielder, BS("Die Blutdornpeitsche waechst an und wird gefaehrlicher!"));
  } else {
    hitcounter++;
  }

  if(!random(300)) {
    tell_object(wielder, BS("Der Blutdorn laesst etwas Blut in dich zurueck fliessen."));
    wielder->AddHp(QueryProp(P_WC)/5);
  }

  return 0;
}