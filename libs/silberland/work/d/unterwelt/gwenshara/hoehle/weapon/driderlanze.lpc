#include "../def.h"

inherit "std/weapon";


public void MakeMagic() {
  SetProp(P_SHORT, "Eine magische Driderlanze");
  SetProp(P_LONG, QueryProp(P_LONG) + " Mystische Runen glimmen auf ihrem Schaft.");
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_INFO, "Lloths Macht erfuellt diese Lanze und vernichtet ihre Feinde! "
                  "Sie verletzt Gutes besonders und Elfen sogar noch mehr. "
                  "Nur im Dunkel kann sie jedoch ihre wahre Macht entfalten.");
  SetProp(P_NAME_ADJ, "magisch");
  AddAdjective( ({"magische", "magischen", "magschen", "magischer"}));
  SetProp(P_WC, 185);
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR: 15, A_DEX: 17, SR_SEER: 1]) );
}

public void create() {
  if(!is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Eine Driderlanze");
  SetProp(P_LONG,
    "Diese Lanze ist etwa drei Meter lang und aus einem dunklen Metall geschmiedet. "
    "Der Schaft endet in einer grausamen Spitze mit kleinen Widerhaken, die grosse "
    "Stuecke Fleisch aus deinem Feind reissen koennen.");

  SetProp(P_NAME, "Driderlanze");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"driderlanze", "lanze", }) );

  SetProp(P_MATERIAL, ([MAT_ADAMANT: 100]) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_SIZE, 300);
  SetProp(P_VALUE, 2500);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 110);
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 170);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_RIP}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["\ngwenshara_evil_cave_drider": 150, "\ngwenshara_evil_cave_driderqueen": 200]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR: 15]) );

  if(!random(200)) {
    MakeMagic();
  }
}

public int HitFunc(object enemy) {
  object wielder;
  int damMod;

  if(!objectp(wielder=QueryProp(P_WIELDED))) return 0;

  damMod = 0;
  if(enemy->QueryProp(P_RACE) == "Dunkelef") damMod -= 100;
  if(wielder->QueryProp(P_RACE) == "Dunkelelf") damMod += random(10);
  if(enemy->QueryProp(P_RACE) == "Elf") damMod += random(20);
  if(enemy->QueryProp(P_ALIGN) > 40) damMod += random(10);

  if(environment(wielder)->QueryProp(P_LIGHT) <= 0 && !random(30) && wielder->QueryProp(P_SP) > 20) {
    tell_object(wielder, BS("Die Driderlanze verwandelt sich in deiner Hand in eine Dunkellanze und trifft " + enemy->name(WEN)+"."));
    tell_object(enemy, BS("Die Driderlanze verwandelt sich in " + wielder->name(WESSEN) + " Hand in eine Dunkellanze und trifft dich."));
    tell_room(environment(enemy), 
      BS("Die Driderlanze verwandelt sich in " + wielder->name(WESSEN) + " Hand in eine Dunkellanze und trifft " + enemy->name(WEN)+"."),
      ({enemy, wielder}));
    enemy->Defend(100 + random(200), DT_UNHOLY, wielder);
    wielder->AddSp(-20);
  }

  return damMod;
}