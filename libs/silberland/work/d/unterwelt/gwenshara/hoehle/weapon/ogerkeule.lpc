#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Eine Oberschenkelknochenkeule");
  SetProp(P_LONG,
    "Diese Keule wurde, wie es aussieht, aus dem Oberschenkelknochen eines "
    "Trolls gemacht. Am oberen Endewurde einige Metallnaegel als Stacheln "
    "durch den Gelenkkopf getrieben. An der Unterseite ist sie mit sich "
    "langsam zersetzenden Fetzen aus Fell und Leder als Griff umwickelt. "
    "Sie glaenzt im Licht widerlach, da sie ueber und ueber mit fettigen "
    "Flecken ueberzogen ist.");

  SetProp(P_NAME, "Oberschenkelknochenkeule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"keule", "oberschenkelkeule", "knochenkeule", "oberschenkelknochenkeule"}) );

  SetProp(P_MATERIAL, ([MAT_BONE: 75, MAT_LEATHER: 5, MAT_SKIN: 5, MAT_FAT: 5, MAT_IRON: 10]) );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_SIZE, 130);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 260);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WC_BONUS, (["\ngwenshara_evil_cave_oger": 200]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR: 25]) );
}