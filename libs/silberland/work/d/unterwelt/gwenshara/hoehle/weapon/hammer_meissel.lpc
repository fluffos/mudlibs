#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Hammer und Meissel");
  SetProp(P_LONG,
    "Das hier ist ein Hammer und ein Meissel. Mit diesen Dingen kann man Steine bearbeiten, "
    "lockern, auseinaner schlagen oder in Form bringen.");

  SetProp(P_NAME, "Hammer und Meissel");
  SetProp(P_GENDER, MALE);
  AddId( ({"hammer", "meissel", "\ngwenshara_evil_cave_hammer"}) );

  SetProp(P_MATERIAL, ([MAT_MISC_METAL: 100]) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_SIZE, 250);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_MISC );
  SetProp(P_WC, 50);
  SetProp(P_WC_FIX, 5);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 2);
}