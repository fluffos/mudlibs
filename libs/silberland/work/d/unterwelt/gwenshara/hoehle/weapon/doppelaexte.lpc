#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit "std/weapon";

int doublehit;

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Ein Paar brutale Doppelaexte");
  SetProp(P_LONG,
    "Dies ist ein paar Doppelaexte. Sie sehen extrem brutal aus und sind mit Blut verschmiert. "
    "Man fuehrt sie immer zusammen als paar. Sie sind besonders beweglich und man kann damit besonders "
    "gut Doppeltreffer landen.");

  SetProp(P_NAME, "Paar brutale Doppelaexte");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"paar", "aexte", "doppelaexte"}) );

  SetProp(P_MATERIAL, ([MAT_IRON: 90, MAT_BLOOD: 10]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_SIZE, 500);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 275);
  SetProp(P_WC_FIX, 50);
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WC_BONUS, (["Axtkaempfer": 100, "Axtexperte": 200, "Axtmeister": 300]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR: 25, A_DEX: 21]) );

  SetProp(P_HIT_FUNC, TO);
}

public int HitFunc(object enemy) {
  object wielder;
  wielder = QueryProp(P_WIELDED);

  if(!objectp(wielder)) return 0;

  if(!doublehit && !random(120 - wielder->QuerySkillAbility(FIGHT(WT_AXE))/100)) {
    tell_object(wielder, BS("Du landest einen Treffer mit beiden Aexten gleichzeitig!"));
    doublehit = 1;
    wielder->do_my_heart_beat();
    wielder->Attack(enemy);
    doublehit = 0;
  }

  return 0;
}