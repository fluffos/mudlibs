#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit "std/weapon";

int loads;

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Ein vergiftete Armbrust");
  SetProp(P_LONG,
    "Dies ist eine leichte Armbrust, wie sie gelegentlich Spaeher der Dunkelelfen benutzen. "
    "Sie ist schenll zu spannen und man braucht nicht viel Kraft um sie zu bedienen. Am hinteren "
    "Ende ist ein kleiner Giftbehaelter angebracht, der bei jedem Schuss eine kleine Menge an Gift "
    "auf den Bolzen auftraegt.");

  SetProp(P_NAME, "Armbrust");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"armbrust"}) );
  SetProp(P_NAME_ADJ, "vergiftete");

  SetProp(P_MATERIAL, ([MAT_IRON: 10, MAT_WOOD: 90]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_SIZE, 300);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_WEAPON_TYPE, WT_BOW );
  SetProp(P_WC, 175);
  SetProp(P_WC_FIX, 50);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_POISON}) );
  SetProp(P_NR_HANDS, 1);

  SetProp(P_WC_BONUS, (["Dunkelelf": 10, "Bogenexperte": 100, "Bogenmeister": 200]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR: 10, A_DEX: 20]) );

  loads = 100 + random(100);

  SetProp(P_HIT_FUNC, TO);
}

public void makeNormal() {
  SetProp(P_SHORT, "Ein leichte Armbrust");
  SetProp(P_LONG,
    "Dies ist eine leichte Armbrust, wie sie gelegentlich Spaeher der Dunkelelfen benutzen. "
    "Sie ist schenll zu spannen und man braucht nicht viel Kraft um sie zu bedienen.");

  SetProp(P_NAME, "Armbrust");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "leicht");
  SetProp(P_HIT_FUNC, 0);
  return;
}

public int HitFunc(object enemy) {
  object wielder;
  wielder = QueryProp(P_WIELDED);

  if(!objectp(wielder)) return 0;

  if(enemy->QueryProp(P_POISON) < 2 && !random(20)) {
    tell_object(wielder, BS("Der Bolzen vergiftet "+enemy->name(WEN)+"!"));
    tell_object(enemy, BS("Der Bolzen vergiftet dich!"));
    enemy->AddPoison(1);
    loads--;
    if(loads <= 0) {
      tell_object(wielder, BS("Das Gift der Armbrust ist aufgebraucht."));
      makeNormal();
    }
  }

  return 0;
}
