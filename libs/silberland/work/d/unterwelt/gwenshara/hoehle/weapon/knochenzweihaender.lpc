#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Ein Knochenzweihaender");
  SetProp(P_LONG,
    "Du haeltst einen grossen Zweihaender, der aus blanken Knochen gemacht wurde "
    "in den Haenden. Sein Griff ist mit blutigem Menschenleder umwickelt. Die Klinge "
    "wurde aus einem einzigen, riesengrossen Knochen geschnitten und scharf geschliffen. "
    "Zwei angespitzte Schluesselbeine ueber der Parierstange bieten noch einmal extra "
    "Zacken im unteren Drittel der Schneide. Wahrhaft die Waffe eines Todesritters.");

  SetProp(P_NAME, "Knochenzweihaender");
  SetProp(P_GENDER, MALE);
  AddId( ({"zweihaender", "knochenzweihaender", "knochenschwert"}) );

  SetProp(P_MATERIAL, ([MAT_BONE: 75, MAT_LEATHER: 5, MAT_SKIN: 10, MAT_IRON: 10]) );
  SetProp(P_WEIGHT, 2500);
  SetProp(P_SIZE, 200);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 275);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, ({DT_SLASH}) );
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WC_BONUS, (["\ntodesritter": 400]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR: 25, A_DEX: 21]) );

  SetProp(P_NEKRO_SPELLCOST, (["all": 20]));
}