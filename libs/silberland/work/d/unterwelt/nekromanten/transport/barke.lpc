inherit "std/transport";

#pragma strong_types

#include "../nekro.h"
#include "verben.h"

void create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einer dunklen Barke" );
  SetProp( P_INT_LONG,
    "Du stehst auf einer Barke aus einem seltsamen, schwarzglaenzenden Holz. "
    "Die Barke ist ein flaches, dunkles Schiff ohne Reling. Am Heck ist eine "
    "Erhoehung, auf der der Faehrmann stehen kann. Am Bug ist eine kleine "
    "Lampe angebracht, die ein duesteres, rotgluehendes Licht verbreitet.");
  SetProp( P_SHORT, "Eine schwarze Barke" );
  SetProp( P_LONG,
    "Direkt am Steg liegt eine kleine Barke aus einem seltsamen, "
    "schwarzglaenzenden Holz. Die Barke hat keine Reling. Am Heck der Barke "
    "ist eine kleine Erhebung, auf der der Faehrmann stehen kann. Am Bug ist "
    "eine kleine Lampe angebracht, die ein duesteres, rotgluehendes Licht "
    "verbreitet.");
  SetProp( P_NAME, "Barke" );
  SetProp( P_NAME_ADJ, "schwarz" );
  AddId( ({ "schiff","barke", NEKRO_TRANSPORT}) );
  SetProp( P_GENDER, FEMALE );
  SetProp(P_LIGHT, 1 );
  SetProp(P_TRANSPARENT,1);

  AddDetail(({"holz"}),
    "Die ganze Barke ist aus einem seltsamen, schwarzglaenzenden Holz "
    "gefertigt, das fast kristallin wirkt. Du kannst Dir nur schwer "
    "vorstellen, dass es natuerlichen Ursprungs ist.");
  AddDetail(({"ursprung"}),
    "Der Ursprung dieses seltsamen schwarzen Holzes ist Dir voellig unklar.");
  AddDetail(({"heck"}),
    "Am Heck der Barke ist eine kleine Erhebung, ein Podest, auf der "
    "normalerweise der Faehrmann steht.");
  AddDetail(({"podest","erhebung"}),
    "Das Podest ist auch aus dem schwarzen Holz, eine einfache Erhebung.");
  AddDetail(({"reling"}),
    "Eine Reling hat die Barke nicht.");
  AddDetail(({"faehrmann"}),
    "Ist im Moment etwa kein Faehrmann da? Dann kannst Du auch keinen "
    "untersuchen.");
  AddDetail(({"bug"}),
    "Der Bug der Barke ist nach oben geschwungen, an ihm ist eine kleine "
    "Lampe angebracht, in der ein duesteres, rotgluehendes Licht brennt.");
  AddDetail(({"lampe"}),
    "Es scheint eine kleine, mit Petroleum brennende Lampe zu sein, in der "
    "ein duesteres, rotgluehendes Licht brennt. Seltsamerweise flackert das "
    "Licht so gut wie gar nicht.");
  AddDetail(({"petroleum"}),
    "Damit wird wohl die Lampe brennen.");
  AddDetail(({"licht"}),
    "Das Licht in der Lampe glueht duester und bedrohlich rot. Seltsamerweise "
    "scheint es so gut wie gar nicht zu flackern.");

  SetProp( P_DEPARTMSG, ({
    "Der Faehrmann stakt die Barke auf den dunklen See hinaus.\n",
    "Der Faehrmann stakt die Barke auf den dunklen See hinaus.\n"}) );
  SetProp( P_ARRIVEMSG, ({
    "Die Barke legt an einem kleinen Steg an.\n",
    "Eine schwarze Barke legt am Steg an.\n"}) );

  SetProp( P_ENTERMSG, ({
    "betritt die Barke",
    "steigt zu Dir auf die Barke"}) );
  SetProp( P_ENTERFAIL,
    "Mehr als 5 Leute passen nicht auf die Barke");
  SetProp( P_MAX_PASSENGERS, 5 );

  SetProp( P_LEAVEMSG, ({
    "verlaesst die Barke",
    "kommt von der Barke herunter"}) );
  SetProp( P_LEAVEFAIL,
    "Die Barke faehrt gerade ueber den See - willst Du etwa da hinein "
    "springen?");

  AddItem(NEKRO_ISLAND_DIR+"npc/faehrmann", REFRESH_DESTRUCT);

  /* Verben */
  AddCmd( ({ "betrete", "betritt" }), "rein" );
  AddCmd( ({ "verlasse", "verlass" }), "raus" );

  AddCmd(CMD_KLETTERN + CMD_KRAXELN, "cmd_climb");
  AddCmd(CMD_ERKLIMMEN, "cmd_climb2");

  AddCmd(CMD_SPRINGEN, "cmd_jump");

  /* Kurs */
  AddRoute( NEKRO_ISLAND_DIR+"room/yaq_monoq/isteg", 30, 2, "Insel",
            ({"insel","nekromanteninsel"}),"zur Nekromanteninsel");
  AddFun("MoveToSea",8,({0, 7,"norden"}));
  AddFun("MoveToSea",8,({0, 8,"norden"}));
  AddFun("MoveToSea",8,({0, 9,"norden"}));
  AddMsg( "Die Barke gleitet ruhig ueber die Saeure.\n", 2 );
  AddFun("MoveToSea",8,({0,10,"norden"}));
  AddFun("MoveToSea",8,({0,11,"norden"}));
  AddFun("MoveToSea",8,({0,12,"norden"}));
  AddFun("MoveToSea",8,({0,13,"norden"}));
  AddMsg( "Die Barke gleitet ruhig dahin.\n", 2 );
  AddFun("MoveToSea",8,({0,14,"norden"}));
  AddFun("MoveToSea",8,({0,15,"norden"}));
  AddFun("MoveToSea",8,({0,16,"norden"}));
  AddFun("MoveToSea",8,({0,17,"norden"}));
  AddMsg( "Die Barke naehert sich einer hohen Felswand am Rande des Sees.\n", 2);
  AddFun("MoveToSea",8,({0,18,"norden"}));
  AddFun("MoveToSea",8,({0,19,"norden"}));
  AddFun("MoveToUnderworld",2);
  AddRoute( NEKRO_ISLAND_DIR+"room/outside/ablegestelle", 30, 2, "Unterwelt",
           ({"anlegestelle","unterwelt"}),"zur Unterwelt" );
  AddFun("MoveToSea",8,({0,19,"sueden"}));
  AddFun("MoveToSea",8,({0,18,"sueden"}));
  AddFun("MoveToSea",8,({0,17,"sueden"}));
  AddMsg( "Die Barke gleitet ruhig ueber die Saeure.\n", 2 );
  AddFun("MoveToSea",8,({0,16,"sueden"}));
  AddFun("MoveToSea",8,({0,15,"sueden"}));
  AddFun("MoveToSea",8,({0,14,"sueden"}));
  AddFun("MoveToSea",8,({0,13,"sueden"}));
  AddMsg( "Die Barke gleitet ruhig dahin.\n", 2 );
  AddFun("MoveToSea",8,({0,12,"sueden"}));
  AddFun("MoveToSea",8,({0,11,"sueden"}));
  AddFun("MoveToSea",8,({0,10,"sueden"}));
  AddFun("MoveToSea",8,({0,09,"sueden"}));
  AddMsg( "Die Barke naehert sich einer dunklen Insel inmitten des Sees.\n", 2 );
  AddFun("MoveToSea",8,({0, 8,"sueden"}));
  AddFun("MoveToSea",8,({0, 7,"sueden"}));
  AddFun("MoveToIsland",2);
  Start();
}

string _query_transparent()
{
  return Query(P_TRANSPARENT);
}

string _query_short()
{
  return Query(P_SHORT);
}

int _query_max_passengers()
{
  return (Query(P_MAX_PASSENGERS)
        + sizeof(filter_array(all_inventory(),
                   lambda(({'i}),
                      ({#'call_other,'i,"id","\nskelettkraehe"})))));
}

void MoveToSea(mixed coords)
{
  this_object()->move(NEKRO_ISLAND_DIR+"room/acid_lake/std_acid:"+coords[0]+":"+coords[1],M_NOCHECK,coords[2]);
  if(!random(40)) {
    call_out("attack_passengers", 0);
  }
}

void MoveToUnderworld()
{
  this_object()->move(NEKRO_ISLAND_DIR+"room/outside/ablegestelle",M_NOCHECK,"norden");
}

void MoveToIsland()
{
  this_object()->move(NEKRO_ISLAND_DIR+"room/yaq_monoq/isteg",M_NOCHECK,"sueden");
}

string GetDetail(mixed key, mixed race)
{
  if (key=="umgebung") return(MENV->int_long(TP,ME,TP->QueryProp(P_SHORTINV)? 0 : 2));
  if (key=="barke") return(QueryProp(P_LONG));
  return (::GetDetail(key,race)||MENV->GetDetail(key,race));
}

void tell_stop()
{
  call_out("tell_stop2",5);
}

void tell_stop2()
{
  tell_room(TO,BS(
    "Die Barke wird langsamer und bleibt schliesslich ganz stehen."));
}

int rein(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if( str && id(str) )
    return Enter();
  return 0;
}

int raus(string str)
{
  notify_fail("Was willst Du verlassen?\n");
  if( str && id(str) )
    return Leave();
  return 0;
}

int climb()
{
  int maxpassengers;
  mixed msgs;

  maxpassengers = QueryProp( P_MAX_PASSENGERS );
  if ( maxpassengers && sizeof(QueryPassengers()) >= maxpassengers )
  {
    if ( pointerp( msgs = QueryProp(P_ENTERFAIL) ) )
    {
      tell_room( this_object(), this_player()->Name(WER,2) + " " + msgs[1] + ".\n",
              ({this_player()}) );
      msgs = msgs[0];
    } else if (closurep(msgs)) {
      funcall(msgs);
      return 1;
    }
    tell_object( this_player(), msgs + ".\n" );
    return 1;
  }
  tell_object(this_player(), "Du kletterst auf die Barke.\n");
  return this_player()->move( ME, M_GO, 0,
    "klettert auf die Barke", "kommt auf die Barke geklettert");
}

int cmd_climb(string str)
{
  string what;

  if (environment(this_player()) == this_object())
    return 0;

  notify_fail("Worauf willst Du klettern?\n");
  if ( str == "an bord" )
    return climb();
  else if ( (1 == sscanf(str, "auf %s", what))
         && id(what))
    return climb();
  return 0;
}

int cmd_climb2(string str)
{
  if (environment(this_player()) == this_object())
    return 0;

  notify_fail("Was willst Du erklimmen?\n");
  if (str && id(str))
    return climb();
  return 0;
}

int cmd_jump(string str)
{
  if (environment(this_player()) != this_object())
    return 0;

  notify_fail("Wohin moechtest Du springen?\n");
  if (-1 != member(({"ueber bord",
                     "in see",
                     "in den see",
                     "in saeure",
                     "in die saeure",
                     "in saeuresee",
                     "in den saeuresee"}),
                   str))
  {
    if (QueryArrived())
    {
      tell_object(this_player(), break_string(
        "Aber die Barke hat doch gerade angelegt."));
      return 1;
    }
    tell_object(this_player(), break_string(
      "Mit dem Mut der Verzweiflung machst Du einen Satz und springst von "
      "Bord der Barke in den Saeuresee."));
    this_player()->move(environment(), M_GO|M_NOCHECK, 0,
                        "springt ploetzlich mit starrem Blick ueber Bord",
                        "springt mit starrem Blick von Bord der Barke "
                        "herunter in den See");
    return 1;
  }
  return 0;
}

void init()
{
  ::init();
  // Sichergehen, dass alle Haefen auch geladen sind.
  if (interactive(this_player()))
  {
    catch(call_other( NEKRO_ISLAND_DIR+"room/yaq_monoq/ablegestelle", "???"));
    catch(call_other( NEKRO_ISLAND_DIR+"room/yaq_monoq/isteg", "???"));
  }
  if (TP->id("\nusuzoreel")&&ENV(TP)==TO)
    Start();
}

int remove()
{

 object ob;

 while (ob=present("\nusuzoreel",ME)) ob->remove(1);

 return ::remove();

}

varargs int move(mixed dest, int method, string dir)
{
  mapping dirs;
  int ret;

  dirs = (["norden":"sueden","sueden":"norden"]);
  if (!(method&M_SILENT) && stringp(dirs[dir]))
    tell_room(environment(), break_string(
      Name()+" faehrt nach "+capitalize(dirs[dir])+"."));

  ret = ::move(dest, method);

  if (!(method&M_SILENT) && stringp(dirs[dir]))
    tell_room(environment(), break_string(
      Name()+" kommt von "+capitalize(dirs[dir])+" hereingefahren."));

  return ret;
}

int filter_passengers(object ob) {
  if(!interactive(ob)) return 0;
  if(ob->QueryProp(P_GUILD)=="nekromanten") return 0;
  return 1;
}

void attack_passengers() {
  int i;
  object ob;
  if(present("skelettkraehe", ME)) return ;
  if(!sizeof(filter_array(all_inventory(ME), "filter_passengers")))
    return ;
  tell_room(ME, BS("Ploetzlich stuerzt ein Schwarm Skelettkraehen herab und "
      "attackiert!"));
  for (i=random(4)+3;i>=0;i--) {
    ob=clone_object(NEKRO_ISLAND_NPC "skelettkraehe");
    ob->move(ME, M_NOCHECK|M_SILENT);
  }
  return ;
}
