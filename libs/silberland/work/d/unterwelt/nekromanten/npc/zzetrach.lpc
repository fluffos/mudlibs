inherit "/gilden/obj/necromancer_npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <class.h>
#include "../dungeon.h"
#include "../nekro.h"
#include "../log_funs.h"


create()
{
  object ob;
  object cash;
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Zzetrach, die Geissel der Paladine");
  SetProp(P_LONG, "Vor Dir steht ein Nekromant in einer dunklen Kutte. "
      "Seine bleichen Finger ragen unter Kutte hervor, in der Hand haelt "
      "er eine schwarze Peitsche. Mit kleinen boesartigen Augen blickt er "
      "Dich an und mustert Dich von oben bis unten.");
  SetProp(P_NAME,"Zzetrach");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Mensch");
  SetProp(P_ARTICLE, 0);
  SetProp(P_NEKRO_LOG_PLAYERDEATH, NEKRO_ISLAND_DIR+"log/kills/killed_players");
  SetProp(P_NEKRO_LOG_DEATH, NEKRO_ISLAND_DIR+"log/kills/zzetrach");

  AddId( ({"nekromant", "zzetrach",NEKRO_GUARD_ID, "Nekromant", "zzetrach"}));
  AddClass(CL_SKELETON);

  // DEFAULT NECROMANCER NPC START
  create_necromancer_npc(36+random(7),6,7);
  set_guild_spellrate(50);
  // DEFAULT NECROMANCER NPC END
  SetProp(P_KILL_NAME, "Zzetrach");
  SetProp(P_AGGRESSIVE,
      ([ 0:0.1, P_GUILD: (["nekromanten":0.0, "abenteurer":0.03,
                          "dunkelelfen":0.01, "paladine":0.5]) ]));
  SetProp(P_BODY, 200);
  SetProp(P_HANDS, ({" mit bleichen Fingern", 100, DT_BLUDGEON}));
  SetProp(P_ALIGN, -800);

  SetProp(P_SIZE, 170+random(50));
  SetProp( P_REJECT, ({ REJECT_DROP, "" }) );
  SetProp( P_DIE_MSG, " bricht mit einem Fluch auf den Lippen zusammen.\n");
  SetProp( P_MURDER_MSG, "Mein wiederbelebter Koerper wird Dich vernichten!");
  SetProp( P_KILL_MSG, "Ahhh, ein neuer Koerper zum experimentieren!");
  //SetProp(P_MNPC_AREA, NEKRO_ISLAND_MOVING );
  //SetProp(P_MNPC_WAIT, ({ 15, 40, 40 }));
  //SetProp(P_MNPC_DEFAULTROOM, NEKRO_ROOMS+"e1");
  //SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + 
  //    MOV_BACKWARDS);

  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(100));
  cash->move(ME);
  CLONEME("/p/armour/ring/ring");
  CLONEME("/p/armour/boots/sandalen");
  CLONEME(NEKRO_ISLAND_ARMOUR+"kutte");
  CLONEME(NEKRO_ISLAND_WEAPON+"blutdolch");
  command_me("zuecke dolch");
  command_me("trage alles");

  
}

int _query_wimpy() { return 0; }    
