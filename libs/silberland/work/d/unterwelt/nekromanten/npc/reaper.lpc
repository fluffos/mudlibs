inherit "std/npc";
inherit "std/npc/spells";

#include "../dungeon.h"
#include "../log_funs.h"
#include "../nekro.h"
#include <moving.h>
#include <class.h>


void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NEKRO_LOG_PLAYERDEATH, NEKRO_ISLAND_DIR+"log/kills/killed_players");
  SetProp(P_NEKRO_LOG_DEATH, NEKRO_ISLAND_DIR+"log/kills/reaper");
  SetProp(P_SHORT, "Ein Baumreisserdaemon");
  SetProp(P_LONG,
      "Der Baumreisserdaemon ist ein daemonisch verwandelter Baum, dessen "
      "Aeste so biegsam wie frische Weidenruten und so hart wie Stahl sind. "
      "Zwei rote Augen leuchten im oberen Teil des Daemons das wohl den "
      "Kopf darstellen soll.");
  SetProp(P_NAME, "Baumreisserdaemon");
  SetProp(P_GENDER, MALE);
  //SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:50]));
  AddClass(CL_DEMON);
  AddId(({"daemon", NEKRO_NPC, NEKRO_GUARD_ID}));
  create_default_npc(35+random(5));
  SetProp(P_HANDS, ({" mit peitschenden Aesten",
                     QueryProp(P_HANDS)[1]+40,
                     ({DT_UNHOLY,DT_RIP})}));
  SetProp(P_XP, QueryProp(P_XP)*2); // Bonus fuer Hands
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 560);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE_STRENGTHS, 
    ([DT_FIRE:      1.0, DT_COLD:      -1.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 1.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: -1.0,
      DT_HOLY:      1.0, DT_UNHOLY:   -1.0, DT_MAGIC:  -0.5 ]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_KILL_NAME, "Ein Baumreisserdaemon");
  SetProp(P_SPELLRATE, 5);
  AddDefaultSpell(1,1, DS_DISARM, 
      "Die Aeste des Baumreisserdaemons schlagen Dir die Waffe aus der Hand.\n",
      "Die Aeste des Baumreisserdaemons schlagen @WESSEN Waffe aus der Hand.\n"
      );

  AddInfo(DEFAULT_INFO, "ignoriert Dich.\n");
}

void Attack(object enemy) {
  ModifySkillAttribute(ME, SA_SPEED, 400, 2);
  ::Attack(enemy);
}

int _query_wimpy() {
  return 0;
}
