inherit "std/mnpc";
inherit "std/npc/spells";

#include "../dungeon.h"
#include "../nekro.h"
#include "../log_funs.h"
#include <moving.h>
#include <class.h>

void create() {
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_NEKRO_LOG_PLAYERDEATH, NEKRO_ISLAND_DIR+"log/kills/killed_players");
  SetProp(P_NEKRO_LOG_DEATH, NEKRO_ISLAND_DIR+"log/kills/aciddemon");

  SetProp(P_SHORT, "Eine lebendige Saeureschwade");
  SetProp(P_LONG,
      "Eine riesige Saeureschwade. Irgendwie scheint sie lebendig "
      "zu sein. Du kannst es nicht erkennen, aber Du fuehlst es. ");
  SetProp(P_NAME, "Saeureschwade");
  SetProp(P_NAME_ADJ, "lebendig");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:50]));
  AddClass(CL_DEMON);
  AddId(({"schwade", "saeureschwade", NEKRO_NPC, NEKRO_GUARD_ID}));
  create_default_npc(20+random(5));
  SetProp(P_HANDS, ({" huellt Dich ein", QueryProp(P_HANDS)[1]*3/2,
                     ({DT_ACID})}));
  SetProp(P_XP, QueryProp(P_XP)*2); // Bonus fuer Hands
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.3);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE_STRENGTHS,  ([
    DT_SLASH:    -0.8, DT_BLUDGEON: -0.8, DT_PIERCE:-0.8,
    DT_SQUEEZE:  -0.8, DT_WHIP:     -0.8, DT_RIP:   -0.8,
    DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0,
    DT_LIGHTNING: 0.0, DT_EXPLOSION: 1.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
    DT_ELECTRIC:  0.0, DT_ACID:     -1.0, DT_POISON: 0.0, DT_TERROR: 0.0,
    DT_HOLY:      1.0, DT_UNHOLY:   -1.0, DT_MAGIC:  0.5 ]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt nach");
  SetProp(P_MMSGIN, "manifestiert sich");
  SetProp(P_MMSGOUT, "loest sich auf");
  SetProp(P_DIE_MSG, " loest sich auf.\n");
  SetProp(P_KILL_NAME, "Eine Saeureschwade");
  AddInfo(DEFAULT_INFO, "ignoriert Dich.\n");
  SetProp(P_SPELLRATE, 5);

  AddDefaultSpell(1, 1, DS_PARALYZE,
      "Du beginnst zu husten und kannst nichts mehr machen!\n",
      "@WER beginnt zu husten!\n", 2);

  AddDefaultSpell(1, 200, DS_DISARM,
      "Die Saeureschwade veraetzt Deine Hand!",
      "");
}

int _query_wimpy()
{
  return 0;
}

int Defend(int dam, mixed dam_type_list, mixed spell, object enemy) {
  if(mappingp(spell) && spell[SP_PHYSICAL_ATTACK]) {
    tell_object(TP, BS("Deine Attacke kann der Saeureschwade "
        "nichts anhaben!"));
    return 0;
  }
  return ::Defend(dam,dam_type_list,spell,enemy);
}
