inherit "std/npc";

#include "../dungeon.h"
#include "../nekro.h"
#include "../log_funs.h"
#include <class.h>


void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NEKRO_LOG_PLAYERDEATH, NEKRO_ISLAND_DIR+"log/kills/killed_players");
  SetProp(P_NEKRO_LOG_DEATH, NEKRO_ISLAND_DIR+"log/kills/schatten");
  SetProp(P_SHORT, "Ein Schatten");
  SetProp(P_LONG,
      "Vor Dir ist ein wabberndes Etwas, das nur aus den Schatten seiner "
      "selbst zu bestehen scheint. Du kannst durch dieses Etwas hindurch"
      "sehen und bist Dir ziemlich sicher, dass normale Waffen diesem "
      "Schatten nichts anhaben koennen.");
  SetProp(P_NAME, "Schatten");
  SetProp(P_GENDER, MALE);
  //SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:50]));
  AddId(({"schatten","etwas"}));
  AddClass(CL_DEMON);
  create_default_npc(20+random(10));
  SetProp(P_HANDS, ({" mit einem eisigen Hauch",
                     (QueryProp(P_HANDS)[1]*2),
                     ({DT_COLD,DT_UNHOLY})}));
  SetProp(P_XP, QueryProp(P_XP)+10*100); // Bonus fuer Hands und fuers geb.
  SetProp(P_RACE, "schatten");
  SetProp(P_SIZE, 140+random(100));
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE_STRENGTHS, ([
    DT_SLASH      :-0.8,     DT_BLUDGEON   :-0.8,     DT_PIERCE     :-0.8,
    DT_SQUEEZE    :-0.8,     DT_WHIP       :-0.8,     DT_RIP        :-0.8,
    DT_FIRE       :0,        DT_COLD       :-1.0,     DT_WATER      :0,    
    DT_AIR        :0.1,      DT_LIGHTNING  :0,        DT_EXPLOSION  :0,
    DT_SOUND      :0,        DT_LIGHT      :1.0,      DT_ELECTRIC   :0,    
    DT_ACID       :-1.0,     DT_POISON     :0,        DT_TERROR     :0,     
    DT_HOLY       :0.5,      DT_UNHOLY     :-0.5,     DT_MAGIC      :0]) );

  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "wabbert herein");
  SetProp(P_MSGOUT, "wabbert nach");
  SetProp(P_MMSGIN, "entsteht");
  SetProp(P_MMSGOUT, "loest sich auf");
  SetProp(P_DIE_MSG, " loest sich einfach auf");
  SetProp(P_KILL_NAME, "Ein Schatten");
  AddInfo(DEFAULT_INFO, "ignoriert Dich.\n");
  AddSpell(2,500,
    "Der Schatten dringt in Dich ein!\n",
    "Der Schatten dringt in @WEN ein!\n",
     DT_MIND,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,400,
    "Der Schatten erschreckt Dich!\n",
    "Der Schatten erschreckt @WEN!\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,1,
    "Der Schatten entzieht Dir ein Teil Deiner Faehigkeiten!\n",
    "Der Schatten entzieht @WEN einen Teil der Faehigkeiten!\n",
     DT_TERROR,"sp_loss");
  AddSpell(1,1,
    "Der Schatten beraubt Dich Deiner Magie!\n",
    "Der Schatten wabbert durch @WEN hindurch!\n",
     DT_TERROR,"magic_loss");
}

void Attack(object enemy) {
  ModifySkillAttribute(ME, SA_SPEED, 200, 2);
  ::Attack(enemy);
}

 
void sp_loss(object enemy, int damage, mixed dam_type) {
  enemy->AddSp(-random(30)+20);
  return;
}

void magic_loss(object enemy, int damage, mixed dam_type) {
  enemy->SetProp(P_DISABLE_SPELLS, random(10)+5);
}

int _query_wimpy() { return 0; }
