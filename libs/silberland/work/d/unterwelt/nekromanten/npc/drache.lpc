inherit "p/std/dragons/dragon";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <defines.h>
#include <moredef.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../nekro.h"
#include "../log_funs.h"




void create()
{ 
  int zufall;
  object ob;

  if (!is_clone(this_object())) return;
  ::create();    
  create_default_dragon(5,8,1,random(15)+15);
  SetProp(P_SHORT, "Pyrdanolikardwat, der ehemalige Bewahrer von Sturmfels.");
  SetProp(P_NAME, "Pyrdanolikardwat");
  AddId( ({ "pyrdanolikardwat", "drache", "HIRIPYR" }) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME_ADJ, 0);
  SetProp(P_LONG, "Pyrdanolikardwat, der ehemalige Bewahrer von Sturmfels, "
      "und der aeltere Bruder von dem jungen goldenen Drache Pyrdonalikardwat "
      "der die Burg Sturmfels heute bewacht. Pyrdanolikardwat ist schon sehr "
      "alt und sieht ziemlich gebrechlich aus. Vor vielen Jahren "
      "bewachte er die Burg Sturmfels. Er wurde von den Nekromanten gefangen "
      "genommen und seit dem ist der alte goldene Drache hier unten in der Gruft "
      "eingepfercht und fristet ein wohl nie enden wollenendes Dasein. Er bekommt "
      "Leichen von Menschen, Elfen und Feen als Fressen vorgesetzt, aus lauter "
      "Verzweiflung frisst er sie auch, auch wenn es ihm vollkommen widerstrebt.");
  SetProp(P_MSGIN, "steht ploetzlich hinter Dir");
  SetProp(P_MSGOUT, "geht genauso ploetzlich.");
  SetProp(P_MMSGIN, "kommt ploetzlich herein.");
  SetProp(P_MMSGOUT, "geht einfach wieder.");
  SetProp(P_NEKRO_LOG_PLAYERDEATH, NEKRO_ISLAND_DIR+"log/kills/killed_players");
  SetProp(P_NEKRO_LOG_DEATH, NEKRO_ISLAND_DIR+"log/kills/drache");

  SetProp(P_GUILD, "paladine");
  SetProp(P_GUILD_LEVEL, 15);
  SetProp(P_KILL_MSG, "Es war mir eine Freude, Euch zu vernichten!");
  SetProp(P_DIE_MSG, " faellt mit einen lauten Donnern zu Boden.\n");
  SetProp(P_MURDER_MSG, "Ihr hattet nur Glueck, %s. Verlasst Euch nicht "
      "staendig darauf, es koennte einmal fatal enden.");
  SetProp(P_ALIGN, 1000);
  SetProp(P_SPELLRATE,60);
  SetProp(P_KILL_NAME, "Etwas Altes");
  SUID;

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Pyrdanolikardwat will Deine Sachen nicht tragen.\n" }) );

  AddSpell(1,700,
     "Pyrdanolikardwat ruft sich Dustys Macht in sein Gedaechtnis und zerschmettert Dich.\n",
     "Pyrdanolikardwat ruft sich Dustys Macht in sein Gedaechtnis und zerschmettert @WEM.\n",
     DT_HOLY, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2,800,
     "Pyrdanolikardwat denkt an seine alten Pflichten und schlaegt Dich mit seinem Schwanz.\n",
     "Pyrdanolikardwat denkt an seine alten Pflichten und schlaegt @WEM mit seinem Schwanz.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Pyrdanolikardwat liegt auf dem Boden und atmet schwer.\n",
    "Pyrdanolikardwat steht auf und kommt nur sehr schwer hoch.\n",
    "Pyrdanolikardwat legt sich gebrechlich wieder hin.\n"}) );
  SetAttackChats(10, ({
    "Pyrdanolikardwat faellt es auf einmal nicht mehr schwer sich zu wehren.\n",
    "Pyrdanolikardwat dreht sich ploetzlich um und schlaegt mit seinem Schwanz.\n"}) );

}

