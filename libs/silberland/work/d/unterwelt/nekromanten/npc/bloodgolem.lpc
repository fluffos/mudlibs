/*
** Der Blutgolem
** Angrox@SL
** 02.11.2000
**
**
** 12.12.2003 Anpassung an /p/std/npc/nekro_npc
*/



inherit "p/std/npc/nekro_npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <class.h>
#include <npcmaster.h>
#include "../dungeon.h"
#include "../nekro.h"
#include "../log_funs.h"

int creation_time;
int dur=-1;
int aggr=0;

create()
{
  string *adj, adj_choosen;
  if (!is_clone(this_object())) return;
  ::create();
  creation_time=time();
  dur=2000;
  adj=({"gross", "riesig", "furchteinfloessend"});
  adj_choosen=adj[random(sizeof(adj))];
  SetProp(P_SHORT, "Ein "+adj_choosen+"er Blutgolem");
  SetProp(P_LONG, "Zusammengewuerfelt aus einem Haufen Blut, Fleisch und "
      "zerborstender Knochen steht diese Ausgebuert der Niederhoellen vor "
      "Dir und ueberragt Dich bei weitem. Dieser Golem ist eine Verhoehnung "
      "des Lebens an sich! Sein 'Koerper' befindet sich in stetiger "
      "Bewegung, die Knochen und die Fleischfetzen scheinen herumzuwandern.");
  SetProp(P_NAME_ADJ, adj_choosen);    
  SetProp(P_NAME,"Blutgolem");
  AddClass(CL_UNDEAD);
  SetProp(P_CONTROLLABLE_BY_NEKRO,1);
  AddId(({ "golem", "blutgolem", NEKRO_NPC}));
  create_default_npc(25+random(5));
  SetProp(P_NEKRO_LOG_PLAYERDEATH, NEKRO_ISLAND_DIR+"log/kills/killed_players");
  SetProp(P_NEKRO_LOG_DEATH, NEKRO_ISLAND_DIR+"log/kills/bloodgolem");

  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Golem");
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_BODY, 150);
  SetProp(P_HANDS, ({" mit Blutkrallen", 300, ({DT_RIP})}));
  SetProp(P_ALIGN, -900);
  SetProp(P_SIZE, 280+random(130));
  SetProp(P_MAX_FOOD, 0);
  SetProp(P_MAX_DRINK, 0);
  SetProp(P_MAX_ALCOHOL, 0);
  SetProp(P_MAX_POISON, 0);
  SetProp(P_NO_SCORE, 1);
  SetProp(P_XP, 0);

  SetProp(P_RESISTANCE_STRENGTHS , 
    ([
      DT_SLASH:     -0.2, DT_BLUDGEON:   0.1, DT_PIERCE: -0.4, DT_SQUEEZE:-0.4, 
      DT_WHIP:      -0.3, DT_RIP:       -0.3,
      DT_FIRE:      -0.2, DT_COLD:      -0.1, DT_WATER:  -0.2, DT_AIR:    -0.1, 
      DT_LIGHTNING: -0.3, DT_EXPLOSION:  0.1, DT_SOUND:  -0.5, DT_LIGHT:   0.3,
      DT_ELECTRIC:  -0.3, DT_ACID:       0.2, DT_POISON: -0.3, DT_TERROR: -1.0,
      DT_HOLY:       1.5, DT_UNHOLY:    -0.4, DT_MAGIC:   0.2, DT_MIND:    0.5 ]) );

  SetProp(P_NOCORPSE, 1);

  SUID;

  SetProp( P_REJECT, ({ REJECT_DESTRUCT, "Der Blutgolem vernichtet @WEN.\n" }) );
  SetProp( P_DIE_MSG, " zerfaellt zu einem Haufen Blut, Knochen und Fleisch"
      "brocken.\n");
  SetProp( P_KILL_MSG, ({"reagiert nicht auf Dich.",MSG_EMOTE}));
  
  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MMSGIN, "materialisiert sich");
  SetProp(P_MMSGOUT, "verschwindet urploetzlich");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_SPELLRATE, 20);
  AddSpell(1, 300,
	" Der Blutgolem rammt einen abgebrochenen eitrigen Knochen in Dich "
        "hinein.\n",
	" Der Blutgolem rammt @WEN einen eitrigen Knochen in den Bauch!\n",
        ({DT_PIERCE}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 500,
        " Der Blutgolem ertraenkt Dich in seinem Blut!\n",
        " Der Blutgolem ertraenkt @WEN in seinem Blut!\n",
        ({DT_MAGIC,DT_UNHOLY}), ([SP_SHOW_DAMAGE:1]));
}


void init()
{
  object ob;

  if((time()-creation_time) > dur && QueryProp(P_FRIEND))
  {
    if(objectp(ob=QueryProp(P_NEKRO_MASTERED_BY))) ob->RemovePursuer(TO);
    call_out("die", 0);
  }

  if(!aggr && objectp(ob=QueryProp(P_NEKRO_CASTED_BY)) && (TP == ob) )
     ob->AddDefender(TO);

  ::init();
  return;
}

int QueryDuration()
{
  return creation_time+dur-time();
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  if(!QueryProp(P_FRIEND))
    call_out("remove", 1);
}

