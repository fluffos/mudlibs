inherit "std/mnpc";
inherit "std/npc/spells";

#include "../dungeon.h"
#include "../nekro.h"
#include "../log_funs.h"
#include <moving.h>
#include <mnpc.h>
#include <class.h>


void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NEKRO_LOG_PLAYERDEATH, NEKRO_ISLAND_DIR+"log/kills/killed_players");
  SetProp(P_NEKRO_LOG_DEATH, NEKRO_ISLAND_DIR+"log/kills/skelettkraehe");
  SetProp(P_SHORT, "Eine Skelettkraehe");
  SetProp(P_LONG,
      "Die Skelettkraehe ist der skelettierte Ueberrest einer im Kampf "
      "gefallenen Kraehe. Kleine rot gluehende Funken tanzen in den leeren "
      "Augenhoehlen des blanken Vogelschaedels. Ihre Schwingen sind eben"
      "falls komplett skelettiert. Welche unheilige Macht mag diese Kreaturen "
      "nur in der Luft halten.");
  SetProp(P_NAME, "Skelettkraehe");
  SetProp(P_GENDER, FEMALE);
  //SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:50]));
  AddClass(CL_UNDEAD);
  AddId(({"skelettkraehe", "kraehe", "\nskelettkraehe", NEKRO_NPC}));
  create_default_npc(5+random(4));
  SetProp(P_HANDS, ({" mit einem scharfen Schnabel" ,
                     (QueryProp(P_HANDS)[1]*2),
                     ({DT_RIP,DT_UNHOLY})}));
  SetProp(P_XP, QueryProp(P_XP)+2*100); // Bonus fuer Hands
  SetProp(P_BODY, 200);
  SetProp(P_RACE, "daemon");
  SetProp(P_SIZE, 30);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE_STRENGTHS,
    ([DT_BLUDGEON:  0.4, DT_PIERCE:   -0.5, 
      DT_HOLY:      1.0, DT_UNHOLY:   -1.0, DT_MAGIC:  0.1 ]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet einfach");
  SetProp(P_DIE_MSG, " faellt zu Boden.\n");
  SetProp(P_KILL_NAME, "Eine Skelettkraehe" );
  AddInfo(DEFAULT_INFO, "ignoriert Dich.\n");
  SetProp(P_AGGRESSIVE,
            ([ 0:0.5, P_GUILD: (["nekromanten":0.0, "abenteurer":0.2,
                                "dunkelelfen":0.1, "paladine":1.0]) ]));
  SetProp(P_SPELLRATE, 5);
  SetProp(P_MNPC_AREA, NEKRO_ISLAND_MOVING );
  SetProp(P_MNPC_WAIT, ({ 15, 40, 40 }));
  SetProp(P_MNPC_DEFAULTROOM, NEKRO_ROOMS+"e1");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES +
      MOV_BACKWARDS);
  AddDefaultSpell(1,200, DS_BLIND,
      "Die Skelettkraehe pickt Dir Dein Auge aus!\n",
      "Die Skelettkraehe pickt @WEM das Auge aus!\n",
      20);
}

void Attack(object enemy) {
  ModifySkillAttribute(ME, SA_SPEED, 200, 2);
  ::Attack(enemy);
}

int _query_wimpy() {
  return 0;
}
