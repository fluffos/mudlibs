//erstellt im Oktober 03 von Hiri
inherit "std/npc";


#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include "../nekro.h"
#include "../log_funs.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NEKRO_LOG_PLAYERDEATH, NEKRO_ISLAND_DIR+"log/kills/killed_players");
  SetProp(P_NEKRO_LOG_DEATH, NEKRO_ISLAND_DIR+"log/kills/saeuralia");
  SetProp(P_SHORT, "Saeuralia, die Schwadendaemonin");
  SetProp(P_LONG,
    "Du kannst Saeuralia kaum von den anderen Saeureschwaden unterscheiden, "
    "deshalb ist sie Dir auch nicht aufgefallen als Du den Raum betreten hast. "
    "Sie hat nichteinmal wirkliche Augen, sondern nur einen Fleck mittig, des "
    "nur erahnbaren Gesichtes. Man sieht nur eine wabbernde Masse, aber nimm "
    "Dich in acht, Das kann boese fuer Dich enden.");
  SetProp(P_NAME, "Saeuralia");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "schwadendaemonin", "daemonin", "saeuralia", "alia", "HIRIALIA" }) );
  AddClass(CL_DEMON);

  create_default_npc(40);
  SetProp(P_HANDS, ({" mit ihren Schwadenkrallen" ,325, ({DT_ACID, DT_RIP}) }) );
  SetProp(P_SIZE, 312 );
  SetProp(P_RACE, "Daemon");
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,60);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,3);
  SetProp(P_RESISTANCE_STRENGTHS, 
    ([ DT_HOLY:      1.0, DT_UNHOLY:   -1.0, DT_ACID:  -1.0 ]) ); 

  SetProp(P_MSGIN, "wabbert gefaehrlich um Dich herum");
  SetProp(P_MSGOUT, "wabbert aus Deinem Sichtfeld");
  SetProp(P_MMSGIN, "kommt wabbernt herein");
  SetProp(P_MMSGOUT, "wabbert in den Saeurenebel und Schreit laut");
  SetProp(P_AGGRESSIVE, ([ 0:1, P_GUILD: (["nekromanten":0.0]) ]));
  SetProp(P_DIE_MSG,  " verschwindet wabbernt im Saeurenebel.\n");
  SetProp(P_NOCORPSE, 0 );


  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("hiri", "Hiri hat mich erschaffen.","sagt: ");

 
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Saeuralia wirft Deine Sachen verachtvoll weg.\n" }) );
    
 
   AddSpell(2,500,
       "Saeuralia wabbert durch Dich hindurch!\n",
       "Saeuralia wabbert durch @WEN hindurch!\n",
       DT_MIND,([SP_SHOW_DAMAGE:1]));
   AddSpell(2,400,
       "Saeuralia wabbert durch den Nebel und erscheint ploetzlich wieder vor Dir!\n",
       "Saeuralia erscheint ploetzlich vor @WEN!\n",
       DT_TERROR,([SP_SHOW_DAMAGE:1]));
   AddSpell(3,800,
       "Saeuralia feuert einen gewaltigen Feuerball auf Dich.\n",
       "Saeuralia feuert einen gewaltigen Feuerball auf @WEN.\n",
       ({DT_FIRE,DT_MAGIC}), ([SP_SHOW_DAMAGE:1]) );
   AddSpell(2,1,
       "Saeuralia mag Dich absolut nicht und entzieht Dir ein Teil Deiner Magie!\n",
       "Saeuralia mag @WEN nicht!\n",
       DT_TERROR,"magic_loss");

   SetChats(3, ({
         "Saeuralia schwabbbelt gierig um Dich herum.\n",
         "Saeuralia holt tief Luft und Du glaubst, Du wirst eingesogen.\n",
         "Saeuralia spuckt wuetend auf Dich.\n"}) );
   SetAttackChats(10, ({
         "Saeuralia umschliesst Dich vollkommen und Du japst nach Luft.\n",
         "Saeuralia schreit Dich boese an.\n"}) );

}


int _query_wimpy() { return 0; }

void magic_loss(object enemy, int damage, mixed dam_type) {
  enemy->SetProp(P_DISABLE_SPELLS, random(10)+5);
}

