inherit "std/mnpc";

#include "../dungeon.h"
#include "../nekro.h"
#include "../log_funs.h"
#include <moving.h>
#include <class.h>


void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Daemon");
  SetProp(P_LONG,
      "Der Daemon ist etwa so gross wie ein Zwerg. Sein ganzer Koerper "
      "ist mit schwarzen Auswuechsen uebersaeht. Die Haende sind wie riesige "
      "Krallen geformt und sehen so aus, als koennten sie schreckliche Wunden "
      "verursachen. Er bewegt sich unnatuerlich schnell.");
  SetProp(P_NAME, "Daemon");
  SetProp(P_GENDER, MALE);
  SetProp(P_NEKRO_LOG_PLAYERDEATH, NEKRO_ISLAND_DIR+"log/kills/killed_players");
  SetProp(P_NEKRO_LOG_DEATH, NEKRO_ISLAND_DIR+"log/kills/demon");
  //SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:50]));
  AddClass(CL_DEMON);
  AddId(({"daemon", NEKRO_NPC, NEKRO_GUARD_ID}));
  create_default_npc(5+random(4));
  SetProp(P_HANDS, ({" mit furchtbaren Klauen",
                     (QueryProp(P_HANDS)[1]*(2+random(3))),
                     ({DT_UNHOLY,DT_RIP})}));
  SetProp(P_XP, QueryProp(P_XP)*2); // Bonus fuer Hands
  SetProp(P_RACE, "daemon");
  SetProp(P_SIZE, 130);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE_STRENGTHS, 
    ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.5,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR:-1.0,
      DT_HOLY:      1.0, DT_UNHOLY:   -1.0, DT_MAGIC:  0.0 ]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "rast mit unnatuerlicher Geschwindigkeit herein");
  SetProp(P_MSGOUT, "rast mit unnatuerlicher Geschwindigkeit nach");
  SetProp(P_MMSGIN, "erscheint aus einem Riss im Gefuege der Welt");
  SetProp(P_MMSGOUT, "verschwindet in einem Riss im Gefuege der Welt");
  SetProp(P_DIE_MSG, " kreischt und wird in seine Dimension verbannt.\n");
  SetProp(P_KILL_NAME, "Ein Daemon");
  AddInfo(DEFAULT_INFO, "ignoriert Dich.\n");
}

void Attack(object enemy) {
  ModifySkillAttribute(ME, SA_SPEED, 300, 2);
  ::Attack(enemy);
}

int _query_wimpy() {
  return 0;
}

void reset() {
  ::reset();
  if(ENV(ME))
    tell_room(ENV(ME), BS("Der Daemon verschwindet in einem Riss im "
          "Gefuege der Welt."));
  remove();
}
