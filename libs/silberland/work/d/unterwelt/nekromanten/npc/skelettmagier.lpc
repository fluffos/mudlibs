*/


inherit "/gilden/obj/necromancer_npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <class.h>
#include "../dungeon.h"
#include "../nekro.h"
#include "../log_funs.h"


create()
{
  object ob;
  object cash;
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NEKRO_LOG_PLAYERDEATH, NEKRO_ISLAND_DIR+"log/kills/killed_players");
  SetProp(P_NEKRO_LOG_DEATH, NEKRO_ISLAND_DIR+"log/kills/skelettmagier");
  SetProp(P_SHORT, "Ein furchtbarer Skelettmagier");
  SetProp(P_LONG, "Vor Dir steht ein in einer zerfetzten schwarzen "
      "Robe verhuelltest Skelett. Seine Haende leuchten in einem "
      "dunklen Rot, ebenso wie seine Augen...");
  SetProp(P_NAME,"Skelettmagier");
  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Skelett");
  SetProp(P_NEKRO_LOG_DEATH, NEKRO_ISLAND_DIR+"log/npc.kills");
  SetProp(P_NEKRO_LOG_PLAYERDEATH, NEKRO_ISLAND_DIR+"log/player.kills");

  AddId( ({"skelett", "skelettmagier", "magier", NEKRO_GUARD_ID}));
  AddClass(CL_SKELETON);

  // DEFAULT NECROMANCER NPC START
  create_necromancer_npc(25+random(5),random(4)+3,random(7)+1, 1);// GLVL: 2..5
  set_guild_spellrate(40);
  // DEFAULT NECROMANCER NPC END
  SetProp(P_AGGRESSIVE,
      ([ 0:0.5, P_GUILD: (["nekromanten":0.0, "abenteurer":0.1,
                          "dunkelelfen":0.05, "paladine":1.0]) ]));
  SetProp(P_KILL_NAME, "Ein furchtbarer Skelettmagier");
  SetProp(P_BODY, 150);
  SetProp(P_HANDS, ({" mit rotgluehenden Knochenkrallen", 150, 
        ({DT_UNHOLY, DT_RIP})}));
  SetProp(P_ALIGN, -800);
  SetProp(P_SIZE, 170+random(50));
  //SetProp(P_CORPSE, )
  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(100));
  cash->move(ME);

  SetProp( P_REJECT, ({ REJECT_DROP, "Das Skelett laesst es fallen.\n" }) );
  SetProp( P_DIE_MSG, " zerfaellt in einen Knochenhaufen.\n");
  SetProp( P_KILL_MSG, "Bald gehoerst Du zu uns!");
  SetProp( P_CORPSE, OBJ+"knochen");
  SetProp( P_CORPSE_FLAGS, COR_NOSETWEIGHT|COR_NOINVTRANSFER); 
  SetProp(P_MNPC_AREA, NEKRO_ISLAND_MOVING );
  SetProp(P_MNPC_WAIT, ({ 15, 40, 40 }));
  SetProp(P_MNPC_DEFAULTROOM, NEKRO_ROOMS+"e1");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + 
      MOV_BACKWARDS);
  if(random(6) < QueryProp(P_GUILD_LEVEL))
    CLONEME(NEKRO_ISLAND_OBJ+"heiltrank");

}

void Attack(object enemy) {
  ModifySkillAttribute(ME, SA_DAMAGE, 100+random(enemy->QueryProp(P_LEVEL)), 2);
  ::Attack(enemy); 
}

int _query_wimpy() { return 0; }    
