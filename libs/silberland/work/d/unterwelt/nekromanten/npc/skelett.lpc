inherit "/p/std/npc/nekro_npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <class.h>
#include "../dungeon.h"
#include "../nekro.h"
#include "../log_funs.h"


create()
{
  object cash;
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_NEKRO_LOG_PLAYERDEATH, NEKRO_ISLAND_DIR+"log/kills/killed_players");
  SetProp(P_NEKRO_LOG_DEATH, NEKRO_ISLAND_DIR+"log/kills/skelett");
  SetProp(P_SHORT, "Ein Skelett");
  SetProp(P_LONG, "Vor Dir steht ein vollkommen fleischloses Skelett. Seine "
      "Knochen sehen schon recht muerbe aus, einige sind schon gesplittert. "
      "Nichtsdesdotrotz wirken seine Knochenkrallen sehr gefaehrlich. Der "
      "Schaedel scheint irgendwie zu grinsen.");
      
  SetProp(P_NAME,"Skelett");
  AddId(({ "skelett", NEKRO_NPC }));
  AddClass(CL_SKELETON);
  create_default_npc(13+random(4));

  SetProp(P_GENDER, NEUTER);
  SetProp(P_RACE, "Skelett");
  SetProp(P_AGGRESSIVE, 
      ([ 0:1, P_GUILD: (["nekromanten":0.0, "abenteurer":0.2,
                          "dunkelelfen":0.1 ]) ]));
  SetProp(P_BODY, 150);
  SetProp(P_HANDS, ({" mit Knochenkrallen", 200, ({DT_RIP})}));
  SetProp(P_ALIGN, -800);
  SetProp(P_SIZE, 180+random(30));

  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_COLD: -0.5, DT_POISON: -0.3, DT_RIP: -0.2, DT_FIRE: -0.3, 
        DT_PIERCE: -0.7, DT_UNHOLY: -0.8, DT_LIGHT: 0.2, DT_HOLY: 0.7,
        DT_BLUDGEON: 0.3, DT_MAGIC: 0.1, DT_TERROR: -0.7]));
  SetProp(P_NOCORPSE, 1);

  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(100));
  cash->move(ME);
  

  SetProp( P_REJECT, ({ REJECT_DROP, "Das Skelett laesst es fallen.\n" }) );
  SetProp( P_DIE_MSG, " zerfaellt zu Staub.\n");
  SetProp( P_KILL_MSG, ({"scheint irgendwie zu grinsen",MSG_EMOTE}));
  
  SetProp(P_MSGIN, "klappert herein");
  SetProp(P_MMSGIN, "klappert herein");
  SetProp(P_MMSGOUT, "klappert hinaus");
  SetProp(P_MSGOUT, "klappert");

  SetProp(P_SPELLRATE, 20);
  AddSpell(1, 500,
	" Das Skelett rammt seine Knochenfinger in Dich hinein.\n",
	" Das Skelett rammt seine Knochenfinger in @WEN hinein.\n",
        DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  SetProp(P_MNPC_AREA, NEKRO_ISLAND_MOVING );
  SetProp(P_MNPC_WAIT, ({ 15, 40, 40 }));
  SetProp(P_MNPC_DEFAULTROOM, NEKRO_ROOMS+"e1");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + 
      MOV_BACKWARDS);
}

int _query_wimpy() { return 0; }  
