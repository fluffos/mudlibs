//erstellt im August 03 von Hiri
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include "../nekro.h"
#include "../log_funs.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NEKRO_LOG_PLAYERDEATH, NEKRO_ISLAND_DIR+"log/kills/killed_players");
  SetProp(P_NEKRO_LOG_DEATH, NEKRO_ISLAND_DIR+"log/kills/xarfaros");
  SetProp(P_SHORT, "Xarfaros, ein schauriger Flugdaemon");
  SetProp(P_LONG,
    "Dieser Flugdaemon fliegt an der Hoehlendecke staendig hin und her und  "
    "beobachtet alles ganz genau. Er hat ledrige Fluegel und der Koerper sieht aus "
    "wie der einer Schlange. Der Schwanz ist zu einem Dreieck gewachsen, welches aussieht "
    "wie eine Speerspitze und auch bestimmt Messerscharf ist. Du solltest Dich in acht "
    "nehmen und ihm nicht zu nah kommen, Er hat leuchtend neongruene Augen, die Deine Seele "
    "tief durchblicken.");
  SetProp(P_NAME, "Xarfaros");
  SetProp(P_GENDER, MALE);
  AddId( ({ "flugdaemon", "daemon", "xarfaros" }) );
  AddClass(CL_DEMON);


  create_default_npc(35);
  SetProp(P_HANDS, ({" mit seinen Klauen" ,350, DT_RIP }) );
  SetProp(P_SIZE, 212 );
  SetProp(P_RACE, "Daemon");
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,60);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,3);
  SetProp(P_MSGIN, "fliegt mit gewagtem Manoever herein");
  SetProp(P_MSGOUT, "fliegt woanders hin, um ein Opfer zu suchen.");
  SetProp(P_MMSGIN, "kommt fliegend herein gebraust.");
  SetProp(P_MMSGOUT, "fliegt noch einmal um Dich herum und verschwindet.");
  /*
  SetProp(P_AGGRESSIVE,([P_RACE:(["Elf":0.3]),P_GUILD:(["Paladine":0.7])]));
  SetProp(P_AGGRESSIVE,([P_RACE:(["Fee":0.3]),P_GUILD:(["Paladine":0.7])]));
  SetProp(P_AGGRESSIVE,([P_RACE:(["Elf":0.3]),P_GUILD:(["Druide":0.7])]));
  SetProp(P_AGGRESSIVE,([P_RACE:(["Fee":0.3]),P_GUILD:(["Druide":0.9])]));
  SetProp(P_AGGRESSIVE,([P_RACE:(["Zwerg":0.3]),P_GUILD:(["Druide":0.7])]));
  SetProp(P_AGGRESSIVE,([P_RACE:(["Zwerg":0.3]),P_GUILD:(["Paladine":0.7])]));
  SetProp(P_AGGRESSIVE,([P_RACE:(["Mensch":0.3]),P_GUILD:(["Paladine":0.7])]));
  SetProp(P_AGGRESSIVE,([P_RACE:(["Mensch":0.3]),P_GUILD:(["Druide":0.7])]));
  SetProp(P_AGGRESSIVE,([P_RACE:(["Oger":0.3]),P_GUILD:(["Druide":0.7])]));
  SetProp(P_AGGRESSIVE,([P_RACE:(["Troll":0.3]),P_GUILD:(["Druide":0.7])]));
  SetProp(P_AGGRESSIVE,([P_RACE:(["Oger":0.3]),P_GUILD:(["Paladine":0.7])]));
  SetProp(P_AGGRESSIVE,([P_RACE:(["Troll":0.3]),P_GUILD:(["Paladine":0.7])]));
  */
  SetProp(P_AGGRESSIVE,
      ([ 0:0.5, P_GUILD: (["nekromanten":0.0, "abenteurer":0.2,
                          "dunkelelfen":0.1, "paladine":0.7]) ]));
  SetProp(P_DIE_MSG,  " flattert angestrengt sein letztes mal.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, und fresse Deine Leiche mit Hochgenuss!");
  SetProp(P_KILL_NAME, "Xarfaros");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("hiri", "Hiri hat mich erschaffen.","sagt: ");

 
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Xarfaros will Deine Sachen nicht tragen.\n" }) );
    

  AddSpell(1,700,
      "Xarfaros kommt heruntergestuerzt und kratzt durch Dein Gesicht.\n",
      "Xarfaros kommt heruntergestuerzt und kratzt @WEM durch das Gesicht.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(2,800,
      "Xarfaros kommt heruntergestuerzt und sticht Dich mit seinem Stachel.\n",
      "Xarfaros kommt heruntergestuerzt und sticht @WEM mit seinem Stachel.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1]));


  SetChats(3, ({
        "Xarfaros fliegt ueber Deinen Kopf, um Dich jeden Moment anzugreifen.\n",
        "Xarfaros streift Dich mit seinen ledrigen Fluegeln, um Dich zu provozieren.\n",
        "Xarfaros stoesst einen wilden hohen Schrei aus.\n"}) );
  SetAttackChats(10, ({
        "Xarfaros rast ungebaendigt auf Dich los.\n",
        "Xarfaros verspuert grosse Lust Deine Leiche zu fressen.\n"}) );

}

 int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "faellt es garnicht ein, Dir Seicherl trost zu spenden.",
        "troestet Dich Seicherl sicher nicht.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "flucht ueber Dich.",
        "verflucht Dich.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "lacht ueber Deine laecherliche Gestalt.",
        "lacht Deine laecherliche Gestalt aus.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "schnippt Dir einen Strahl Saeure ins Gesicht.",
        "schnippt einen Saeurestrahl in Dein Gesicht.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich fluesternd an.",
        "faucht fluesternd.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich mitleidig an.",
        "laechelt mitleidig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "kuschelt Dich stinkend zurueck.",
        "kuschelt Dich stinkend.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "fluestert das er Dich lieber auffrisst.",
        "fluestert ich fress Dich, ich fress Dich.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von Xarfaros ausglacht.");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

