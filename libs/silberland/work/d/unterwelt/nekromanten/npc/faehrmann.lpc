inherit "std/npc";

#include "../dungeon.h"
#include "../nekro.h"

string rdet_runen();

void create() {
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_NEKRO_LOG_PLAYERDEATH, NEKRO_ISLAND_DIR+"log/kills/killed_players");
  SetProp(P_NEKRO_LOG_DEATH, NEKRO_ISLAND_DIR+"log/kills/faehrmann");

  SetProp(P_SHORT, "Usuzoreel der Faehrmann");
  SetProp(P_LONG,
    "Du siehst vor Dir die hochgewachsene, duerre Gestalt von Usuzoreel, dem "
    "Faehrmann.Er traegt eine schwarze Kutte und hat einen langen Stab in der "
    "Hand, den er zum Staken der Barke verwendet. Eine fast spuerbare Aura des "
    "Boesen geht von ihm aus, doch das scheusslichste an ihm ist sein Gesicht "
    ", dass im Schatten seiner Kapuze erkennbar ist.");
  AddDetail(({"kutte"}),
    "Usuzoreel traegt eine schwarze, bodenlange Kutte mir einer grossen Kapuze, "
    "die er ueber den Kopf gestreift hat. Die Kutte ist nur mit einigen wenigen "
    "blutroten Runen verziert.");
  AddDetail(({"rune","runen"}),
    "Einige wenige, blutrote Runen verzieren den Saum der Kutte an der Kapuze "
    "und den Aermeln.");
  AddReadDetail(({"rune","runen"}),
    #'rdet_runen);  
  AddDetail(({"stab","staken"}),
    "Ein langer, duenner Stab, mit dem Usuzoreel die Barke zu steuern scheint. "
    "Allerdings kann er damit auch sicher ganz schoen fest zuschlagen.");
  AddDetail(({"aura"}),
    "Die Aura, die Usuzoreel umgibt, ist wirklich angsteinfloessend. Zum Glueck "
    "scheint er nicht agressiv zu sein, solange man ihn in Ruhe laesst.");
  AddDetail(({"gesicht","schatten"}),
    "Von Usuzoreels Gesicht ist nicht mehr viel zu erkennen, so narbenbedeckt "
    "ist es. Es ist so scheusslich, wie Du erst selten eines gesehen hast, und "
    "zwei blinde Augen scheinen Dich daraus anzustarren.");
  AddDetail(({"kapuze"}),
    "Usuzoreel hat die Kapuze tief ins Gesicht gezogen, welches so fast voellig "
    "in ihrem Schatten verschwindet.");
  AddDetail(({"auge","augen"}),
    "Beide Augen Usuzoreels sind blind, und doch scheinen sie Dich von einem "
    "Hass erfuellt anzusehen, dass es Dir kalt den Ruecken herunterlaeuft.");
  AddDetail(({"hass","lebendiges"}),
    "Der Hass Usuzoreels scheint alle Lebendigen zu gelten.");
  SetProp(P_NAME, "Usuzoreel");
  SetProp(P_GUILD, "nekromanten");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"\nusuzoreel","usuzoreel", "faehrmann","gestalt"}));
  set_living_name("usuzoreel");

  create_default_npc(25, 700);
  SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_XP, QueryProp(P_XP)+500*100); // Bonus fuer Spells
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 212);
  SetProp(P_ALIGN, -973);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "humpelt herein");
  SetProp(P_MSGOUT, "humpelt");
  SetProp(P_MMSGIN, "erscheint aus einem dunklen Blitz");
  SetProp(P_MMSGOUT, "verschwindet in einem dunklen Blitz");

  SetProp(P_DIE_MSG,  
    " roechelt noch einmal und faellt dann ueber Bord.\n"
    "Es zischt laut, eine grosse Rauchwolke steigt auf.\n");
    
  SetProp(P_KILL_NAME, "Usuzoreel der Faehrmann");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo(({"cirion","schoepfer"}), "Cirion ist mein Schoepfer.","Sagt heiser: ");
/*
  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp(P_LOG_INFO, "cir");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "<name> will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,0);
  AddSpell(1,0,
    ".\n",
    ".\n",
     DT_,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    ".\n"}) );
  SetAttackChats(10, ({
    ".\n"}) );
*/

  SUID;
  CLONEME(NEKRO_ISLAND_WEAPON+"faehrstange" );
  command("zuecke stange");
  CLONEME(NEKRO_ISLAND_ARMOUR+"kutte" );
  command("trage alles");

}

string rdet_runen()
{
  if (TP->QueryProp(P_GUILD)=="nekromanten")
    return BS("Du kannst einige der Runen entziffern, offenbar binden die "
      "einen Schutzzauber in die Kutte");
  return BS("Du kannst die seltsamen Runen nicht entziffern.");
}

void die(int poisondeath) 
{
  object barke;
  if(stringp(QueryProp(P_NEKRO_LOG_DEATH))) {
    write_file(QueryProp(P_NEKRO_LOG_DEATH), sprintf(
        "%s: %O[%d/%d-%s] killt %s[%d/%d/%d]\n",
        ctime(),TP, TP->QueryProp(P_LEVEL), 
        TP->QueryProp(P_GUILD_LEVEL), TP->QueryProp(P_GUILD),
        explode(file_name(ME), "#")[0], QueryProp(P_LEVEL), 
        QueryProp(P_GUILD_LEVEL),
        QueryProp(P_GUILD_CIRCLE)));
  }
  
  barke=find_object("/d/unterwelt/nekromanten/transport/barke");
  barke->Halt();
  if (!barke->QueryArrived())
  {
    call_other(barke,"tell_stop");
  }
  move(ENV(MENV),M_NOCHECK|M_SILENT);
  return ::die(poisondeath);
}

void Attack(object enemy)
{
  if (!random(9))
  {
    if (random(enemy->QueryAttribute(A_DEX)) < random(QueryAttribute(A_DEX)) &&
        random(enemy->QueryAttribute(A_STR)) < random(QueryAttribute(A_STR)))
    {
      tell_object(enemy,BS(
        "Usuroreel holt mit seiner Stange weit aus, versetzt Dir einen "
        "kraeftigen Stoss und Du segelst in hohem Bogen ueber Bord."));
      enemy->move(ENV(MENV),M_NOCHECK|M_SILENT);
      tell_room(MENV,BS(
        "Usuzoreel holt mit seiner Stange weit aus und versetzt "
        +enemy->Name(WEM,1)+" einen kraeftigen Stoss, so dass "
        +enemy->QueryPronoun(WER)+" in hohem Bogen ueber "
        "Bord segelt."),({TO}));
      return;
    }
    else
      tell_object(enemy,BS(
        "Usuzoreel versucht, Dich mit seiner Stange von der Barke zu stossen."));
      tell_room(MENV,BS(
        "Usuzoreel versucht, "+enemy->Name(WEN,1)+" ueber Bord zu stossen.")
        ,({TO,enemy}));
  }    
  return ::Attack(enemy);
}

int _query_wimpy() { return 0; }

