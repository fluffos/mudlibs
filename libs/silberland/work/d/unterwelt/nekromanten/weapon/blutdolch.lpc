inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <defines.h>
#include "../nekro.h"

int blood=0;

void create()
{
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Blutdolch");
  SetProp(P_LONG,
      "Dieser Dolch besteht aus einem schwarzen Ledergriff, auf dem "
      "seltsame Symbole eingeritzt sind. Die Klinge scheint aus Blut "
      "in einer festen, und doch beweglichen Form zu bestehen. ");
  SetProp(P_INFO, "Durch die unheilige Magie kann dieser Dolch ihr "
      "Ziel leichter treffen!");
  SetProp(P_NAME, "Blutdolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch","blutdolch"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 120+random(10));
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS, (["Messerkaempfer":50, "Messerexperte":150, 
      "Messermeister":250, "Nekromant":300, GUILDNPC_ID:400 ]) );
  SetProp(P_DAM_TYPE, ({DT_PIERCE,DT_UNHOLY}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 600);
  SetProp(P_SIZE, 35);
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_WIELD_RESTRICTIONS, ([P_GUILD: "nekromanten"]) );
}

int HitFunc(object enemy) {
  object pl;
  int x;
  x=1;
  if(!pl=QueryProp(P_WIELDED)) 
    return 0;
  if(blood < 200+random(100)) {
    if(!random(5)) {
      x=1+random(3);
      pl->do_damage(x);
    }
    blood+=x*2;
    if(blood>150)
      write("Dein Blutdolch pulsiert vor unheiliger Energie!\n");
    return x*10;
  }
  pl->AddHp(blood/12);
  write(BS("Die unheilige Macht des Blutdolchs vernichtet " + 
        enemy->name(WEN,1) + "!!"));
  tell_object(enemy,"Du fuehlst Dich von daemonischer Macht durchdrungen!\n");
  x=blood*3;
  if(pl->id(GUILDNPC_ID))
    blood-=20;
  else 
    blood-=(random(100)+60);
  return x/2 + random(x/2);
}

void SetBlood(int x) {
  blood=x;
}

