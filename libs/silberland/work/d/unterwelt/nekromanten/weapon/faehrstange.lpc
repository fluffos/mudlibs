#include "../nekro.h"

inherit "std/weapon";

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine lange schwarze Stange");
  SetProp(P_LONG,
    "Das ist eine lange, schwarze Stange aus einem seltsam glaenzenden "
    "Holz. Der Faehrmann auf dem unterirdischen See verwendet sie, um "
    "seine Barke zu steuern, und um seine Gegner zu verpruegeln." );
  SetProp(P_INFO, "Irgendetwas ist seltsam an dieser Stange.");
  SetProp(P_NAME, "Stange");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"stange", "faehrstange"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 190);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_CRYSTAL:100]) );
  SetProp(P_WEIGHT, 1800);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 250);
  SetProp(P_WC_FIXFACTOR, 0.3 );
  
  SetProp(P_WC_BONUS, (["\nusuzoreel":250 ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:15,A_DEX:18,P_LEVEL:22]) );

}
