inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  string *leder;
  leder=({"Menschenleder", "Zwergenleder", "Elfenleder", "Trollleder", 
      "Ogerleder", "Dunkelelfenleder"});
  if (!is_clone(this_object()) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Peitsche");
  SetProp(P_LONG, sprintf( 
    "Diese Peitsche besteht aus gehaerteten %s, das zu einer "
    "lange Peitsche geflochten wurde. Ein Treffer mit dieser Peitsche kann "
    "schreckliche Verletzungen hervorrufen. Die Peitsche ist komplett "
    "geschwaerzt.", leder[random(sizeof(leder))]));
  SetProp(P_NAME, "Peitsche");
  SetProp(P_NAME_ADJ, "schwarz");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"peitsche"}) );

  SetProp(P_WEAPON_TYPE, WT_WHIP );
  SetProp(P_WC, 150+random(50));
  SetProp(P_WC_FIX, 0);
  SetProp(P_WC_BONUS, (["Peitschenkaempfer":50, "Peitschenexperte":150, 
      "Peitschenmeister":250, "Nekromant":350]) );
  if(!random(2)) {
    SetProp(P_DAM_TYPE, ({DT_WHIP}) );
  }
  else {
    SetProp(P_DAM_TYPE, ({DT_WHIP,DT_UNHOLY}) );
  }
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_LEATHER:100]) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_VALUE, 700);
  SetProp(P_SIZE, 350);
  SetProp(P_QUALITY_DECAY, 80);
}

