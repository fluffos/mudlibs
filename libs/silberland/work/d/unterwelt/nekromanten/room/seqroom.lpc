#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
#include "nekro.h"

inherit "/std/room.lpc";
inherit "/gilden/obj/sequencer_new";

void Ende();

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "");
  SetProp(P_INT_LONG, 
    "");
  SetNames("","");
}

void init()
{
  ::init();
}

string GetExits() {
  return "";
}

int CheckInteractive() {
  if(sizeof(filter_array(all_inventory(ME), #'interactive))) return 1;
  return 0;
}

varargs void Start(object pl) {
  if(!pl)
    pl=TP;
  LoadSequenz(NEKRO_ISLAND_DIR "seq/hole.seq", pl, #'Ende);
  return ;
}

void Ende() {
  TP->move(NEKRO_OUTSIDE_ROOMS+"gang", M_NOCHECK|M_SILENT);
  tell_room(ENV(TP), sprintf("%s erscheint ploetzlich vor Dir.\n", 
        TP->Name(WER)), ({TP}));
  return ;
}

void BecomesNetAlive(object pl) {
  Start(pl);
  return ;
}

