

#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>
#include <moving.h>
#include <defines.h>
#include "../../nekro.h"

#define P_VALID_NAME "valid_name"

inherit "std/virtual/v_compiler";

nosave int check_room(string name);
nosave string *loaded_rooms;
nosave string *lake_map;

create()
{
  ::create();
  SetProp(P_COMPILER_PATH, NEKRO_ISLAND_DIR+"room/acid_lake" );
  SetProp(P_STD_OBJECT, NEKRO_ISLAND_DIR+"room/acid_lake/std_acid");
  SetProp(P_VALID_NAME, ({"std_acid"}));
  SetProp(P_SHORT, "In einem Saeuresee");
  lake_map = explode(read_file(NEKRO_ISLAND_DIR+"room/acid_lake/map"),"\n");
  loaded_rooms=({});
}

string LakeMap(int x, int y)
{
  if (y < -21 || y > 21 || x < -21 || x > 21)
    return "#";
  y = -1 * y;
  return lake_map[y+21][x+21..x+21];
}

string Validate(string file)
{
  string name;
  int x,y;
  file = ::Validate(file);
  if ((sscanf(file, "%s:%d:%d", name, x,y) == 3) &&
      (member(QueryProp(P_VALID_NAME), name) != -1) &&
      LakeMap(x,y) == "~")
  {
    SetProp(P_STD_OBJECT, NEKRO_ISLAND_DIR+"room/acid_lake/"+name);
    return file;
  }
}


int CustomizeObject()
{
  string name,foo;
  int x,y;
  if (!(name = ::CustomizeObject())) return 0;
  if(sscanf(name,"%s:%d:%d",foo,x,y)!=3) return 0;
  previous_object()->SetCoords(x,y);
  //check_room(foo+":"+x+":"+y);
  //TELL("angrox", sprintf("%O\n", loaded_rooms));
  return 1;
}

nosave int check_room(string name) {
  object *liv,ob;
  string room_name;
  int i;
  //TELL("angrox", sprintf("std_acid: name= %s\n", name));
  if(sizeof(loaded_rooms) > 20) {
    for(i=sizeof(loaded_rooms)-1; i>=0; i--) {
      room_name=NEKRO_ISLAND_DIR "room/acid_lake/"+loaded_rooms[i];
      TELL("angrox", sprintf("std_acid: room_name = %s\n", room_name));
      ob=find_object(room_name);
      if(!objectp(ob))
        loaded_rooms-=({loaded_rooms[i]});
      else if( !sizeof(all_inventory(ob))) {
        //TELL("angrox", sprintf("std_acid: room = %O -> remove\n", ob));
        ob->remove();
        loaded_rooms-=({loaded_rooms[i]});
      }
    }
  }
  if(member(loaded_rooms,name)==-1) {
     loaded_rooms+=({name});
  }
  return 1;
}
