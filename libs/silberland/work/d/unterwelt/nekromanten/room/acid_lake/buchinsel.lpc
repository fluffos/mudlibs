#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../directions.h"
#include "../nekro.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit NEKRO_ISLAND_DIR "room/std_beach_room";
string acid_dam() ;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_INT_LONG, 
      "Du befindest Dich hier auf einer winzigen Insel inmitten des "
      "Saeuresees. Hier befindet sich nichts ausser blanker, schwarzer "
      "Fels ... und ein Buch, das wie selbstverstaendlich auf einer "
      "kleinen Erhebung der Insel liegt.");
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  // ROOM DESCRIPTION END
  AddDetail( ({ "boden", "fels" }),
      "Der Boden besteht aus totem schwarzem Fels. Nichts besonderes ist "
      "an ihm. Ein wenig weiter beginnt der Saeuresee, der dampfend "
      "veraetzende Saeureschwaden produziert, die Deine Lunge veraetzen.");
  AddDetail( ({"strand"}),
      "Du befindest Dich am Strand von Yaq'Monoq.");
  AddDetail( ({ "saeuresee", "see" }),
      "Der Saeuresee liegt vor Dir, zischend hat er jegliches Leben "
      "hier vernichtet. Du solltest besser nicht in ihm baden.");
  AddDetail( ({ "schwaden", "saeureschwaden", "sicht"}), 
      "Die Saeureschwaden behindern Deine Sicht. Du kannst nicht viel auf "
      "dem Saeuresee erkennen.");
  AddDetail( ({"rest", "umgebung"}),
      "Die Umgebung ist kahl und leer. Du kannst kein Leben, keine Pflanze, "
      "nichts erkennen. Alles hier ist tot.");
  AddDetail( ({"leben", "pflanze", "lebendiges"}),
      "Kannst Du nicht entdecken.");
  AddDetail( ({"anzeichen" }),
      "So sehr Du Dich auch umsiehst, Du kannst keine Anzeichen von Leben "
      "entdecken.");
  AddDetail( ({ "ufer" }),
      "Du kannst nur ein Ufer erkennen: Das auf dem Du stehst. Wer weis "
      "welche Geheimnisse der Saeuresee noch birgt?");
  AddDetail( ({ "geheimnisse" }),
      "Es gibt wohl nur eine Moeglichkeit diese Geheimnisse zu lueften: "
      "Auf den See schwimmen und danach suchen.");
  AddDetail( ({"moeglichkeit"}),
      "Es gibt nur eine Moeglichkeit die Geheimnisse zu erfahren. Schwimm "
      "und suche im See.");
  AddDetail( ({ "ferne" }),
      "Du blickst angestrengt in die Ferne, bis Dir die Augen traenen. "
      "Erkennen kannst Du leider nichts. Vielleicht solltest Du fester "
      "in die Ferne starren?");
  AddDetail( ({ "leere" }), 
      "Hier ist nichts aussergewoehnliches. Eigentlich ist hier ueber"
      "haupt nichts Lebendiges. Nichts ausser Leere.");
  AddDetail( ({"augen"}),	
      "Die brauchst Du.");
  AddDetail( ({"lunge"}),
      "Deine Lunge wird fast durch die Saeure veraetzt.");
  AddDetail( ({"bedeutung"}),
      "Die Bedeutung der Worte weist Du leider nicht.");
  AddDetail( ({"worte"}),
      "Du kannst sie nicht lesen.");
  AddSound(DEFAULT_SOUND, 
      "Du hoerst seltsame Geraeusche.");
  AddSound("geraeusche", 
      "Du kannst sie irgendwie nicht zuordnen. Sie klingen mal nahe, "
      "mal fern. Du hast keine Ahnung was so klingen koennte. Dich "
      "schaudert.");
  AddDetail( ({"ahnung"}),
      "Du hast keine Ahnung was so klingen koennte.");
  AddSmell(DEFAULT_SMELL, 
      "Es stinkt nach Saeure. Der Gestank veraetzt Dir fast die "
      "Lunge.");
  AddSmell("geruechen",
      "Es stinkt nach Saeure. Der Gestank veraetzt Dir fast die "
      "Lunge.");
  AddDetail( ({"erhebung"}),
      "Hier ist nichts, ausser dier kleiner Erhebung. Seltsam.");
  AddSmell( ({"saeure", "gestank"}), #'acid_dam);
  // DETAILS START
  // DETAILS END

  // EXITS START
  // EXITS END

  // ITEMS START
  AddItem("/p/std/book/nekromanten/buch_nekromanten", REFRESH_DESTRUCT);
  // ITEMS END

}


int lookahead(string str) {
  if(!str) return 0;
  if(str !="fester in die ferne")
    return 0;
  write("WAHHHHHHH DIE SAEURE! DIE SAEURE! DEINE AUGEN! WAAARG!\n");
  say(BS(sprintf("%s schlaegt die Haende vor den Augen zusammen und "
          "schreit wie von Sinnen.",TP->Name(WER))));
  TP->SetProp(P_BLIND, 100+random(300));
  do_room_damage(TP, random(20), "Saeure", "Da wo Du hingehst brauchst Du "
      "keine Augen");
  return 1;
}


string acid_dam() {
  do_room_damage(TP, random(30)+1, "Zwei aufgeloeste Lungenfluegel");
  return "Die Saeure aetzt Dir die halbe Lunge weg!\n";
}

string _query_int_long() {
  string txt;
  if(present("\nnekrobuch", ME)) {
    txt=
      "Du befindest Dich hier auf einer winzigen Insel inmitten des "
      "Saeuresees. Hier befindet sich nichts ausser blanker, schwarzer "
      "Fels ... und ein Buch, das wie selbstverstaendlich auf einer "
      "kleinen Erhebung der Insel liegt.";
  }
  else 
  {
    txt=
      "Du befindest Dich hier auf einer winzigen Insel inmitten des "
      "Saeuresees. Hier befindet sich nichts ausser blanker, schwarzer "
      "Fels. Sonst nichts. Absolut nichts.";
  }
  return BS(txt);
}
