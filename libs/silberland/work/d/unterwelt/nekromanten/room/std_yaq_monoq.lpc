#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/yaq_monoq/"+x)
#endif

inherit NEKRO_ISLAND_DIR+"room/std_dungeon";

void create()
{
  ::create();
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14,ENV_TERRAIN:TT_CAVE]));
//  SetProp (P_NOREST, "Narr. Hier zu rasten waere Dein Tod!\n");
  SetProp (P_KILL_NAME, "Der Pesthauch der Verdammnis"); 
  // Details fuer "insel"
  AddDetail( ({"insel"}),
    "Yaq'Monoq. Die Insel der Verdammten. Die Insel der verlorenen "
    "Seelen. Sie ist von einem Saeuresee umgeben und macht eine "
    "schnelle Flucht unmoeglich.");
  AddDetail( ({"yaq", "monoq", "yaq'monoq", "yaq monoq"}),
    "So wird diese Insel hier genannt. Die Bedeutung dieser Worte "
    "bleibt Dir leider verschlossen ...");
  AddDetail( ({"verdammten", "verdammte"}),
    "Nurdie Verdammten fuehlen sich hier wohl. Wenn Du nicht untot, "
    "daemonischen Ursprungs oder Nekromant bist, solltest Du "
    "schleunigst von hier verschwinden.");
  AddDetail( ({"ursprung", "daemonen"}),
    "Daemonen sollen hier keine Seltenheit sein! Huete Dich!");  
  AddDetail( ({"seltenheit"}),
    "Du koenntest hier jederzeit einem begegnen! Huete Dich!");
  AddSpecialDetail( ({"nekromant", "seelen"}),
    "special_detail_check_std_yaq_monoq");  
  AddDetail( ({"flucht"}),
    "Moechtest Du denn nicht lieber fliehen?");  
  AddDetail( ({"decke"}),
      "Die Decke der Kuppel ist weit ueber Dir.");
  AddDetail ( ({"kuppel"}), 
    "Weit ueber Dir erstreckt sie sich. Ein beklemmendes Gefuehl "
    "beschleicht Dich, denn sie ueberspannt Dich wie eine gewaltige Hand!");
  AddDetail ( ({"hand"}),
    "Du fuehlst Dich nicht wohl.");
  AddDetail ( ({"waende", "wand"}),
    "Aber hier sind keine Waende!");  
  AddDetail ( ({"gefuehl"}),
    "Die Hoehle ist zwar riesig, aber Du bist Dir sicher, dass sie durch eine "
    "unheilige Macht entstanden ist.");  
  AddDetail ( ({"macht"}),
    "Du erschauderst vor Ehrfurcht wenn Du daran denkst.");  
  AddDetail ( ({"ehrfurcht"}),
    "Ja, die solltest Du auch haben!");  
  AddDetail ( ({"hoehle"}),
    "Du befindest Dich in ihr.");  


  AddRoomMessage( ({ "" }), 35, "BeNasty");
  if(!random(2)) {
    AddItem(({ NEKRO_ISLAND_NPC "skelettmagier",
               NEKRO_ISLAND_NPC "nekromant",
               NEKRO_ISLAND_NPC "skelettkraehe",
               NEKRO_ISLAND_NPC "skelettkraehe",
               NEKRO_ISLAND_NPC "skelettkraehe",
               NEKRO_ISLAND_NPC "skelett",
               NEKRO_ISLAND_NPC "skelett",
             }),
             REFRESH_DESTRUCT,
             ([P_MNPC_DEFAULTROOM: file_name(TO)]));
    if(!random(5)) {
      AddItem(({ NEKRO_ISLAND_NPC "skelettmagier",
               NEKRO_ISLAND_NPC "nekromant",
               NEKRO_ISLAND_NPC "skelettkraehe",
               NEKRO_ISLAND_NPC "skelettkraehe",
               NEKRO_ISLAND_NPC "skelettkraehe",
               NEKRO_ISLAND_NPC "skelett",
               NEKRO_ISLAND_NPC "skelett",
             }),
             REFRESH_DESTRUCT,
             ([P_MNPC_DEFAULTROOM: file_name(TO)]));
    }
  }


}

nosave string special_detail_check_std_yaq_monoq(string key) {  
  string guild;
  guild=TP->QueryProp(P_GUILD);
  if(key=="nekromant") {
    if(guild=="nekromanten") 
      return BS("HarHar! Du bist einer, Verdammter! Schaetze Dich gluecklich!");
    if(guild=="paladine") 
      return BS("Bei Dusty! Die Nekromanten gehoeren ausgerottet!");
    if(guild=="dunkelelfen") 
      return BS("Wenn Du nur dazugehoerehn wuerdest ...");
    return BS("Du erschauderst. Hoffentlich ist keiner hier.");  
  }
  if(key=="seelen") {
    if(guild=="nekromanten")
      return BS("Seelen! HARHAR! Du solltest gleiche eine opfern!");
    return BS("Du betest das Du hier Deine nicht verlierst.");
  }
}

nosave int BeNasty(string msg) {
  object *liv,ob;
  string *funs;
  int i;
  object *inv;
  if(ob=present("knochen", ME)) {
    ob->remove();
    tell_room(ME, BS("Ploetzlich beginnen sich die Knochen zu "
          "bewegen und ein Skelett entsteht daraus!"));
    ob=clone_object(NEKRO_ISLAND_DIR+"npc/skelett");
    ob->move(ME, M_NOCHECK|M_SILENT);
  }
  inv=all_inventory(ME);
  call_out("reanimate", 0,inv);
  funs=({"loose_mp", "loose_hp", "get_poisoned", "get_paralyzed", "loose_mv",
      "clone_demon", "flee_now", "create_barrier"});
  liv=filter_array(all_inventory(ME), "living_check");
  if(!sizeof(liv)) return 1;
  for(i=sizeof(liv)-1;i>=0;i--) 
    if(!random(3)) {
      if((liv[i]->id("\nd_elementar") || liv[i]->id("\nfeuerwusel")) &&
          !random(20)) 
      {
        call_out("transform_element", 0, liv[i]);
      }
      if(liv[i]->id("\nknarkdaemon") && !random(5)) {
        call_out("transform_knarkhdemon", 0, liv[i]);
      }
      else 
      {
        call_out(funs[random(sizeof(funs))], 0, liv[i]);
      }
    }
  return 1;
}

nosave void loose_hp(object pl) {
  tell_object(pl, BS("Ein kurzer Schmerz durchzuckt Dich!"));
  do_room_damage(TP, random(10)+1);
  return;
}

nosave void loose_mp(object pl) {
  tell_object(pl, BS("Ein kalter Schauer laeuft Dir ueber den Ruecken und "
      "ein Teil deiner magischen Kraft schwindet!"));
  pl->AddSp(-(random(10)+10));
  return;
}

nosave void get_poisoned(object pl) {
  tell_object(pl, BS("Du fuehlst Dich als ob Dich der Pesthauch der "
        "Verdammnis gestreift haette!"));
  pl->AddPoison(random(3)+1);
  return;
}

nosave void get_paralyzed(object pl) {
  pl->SetProp(P_PARALYZED, ([
        PARALYZE_TIME: random(4)+4,
        PARALYZE_MSG: BS("Eine eiskalte Hand greift nach Deinem Herz und "
                         "laesst Dich vor Angst erstarren!"),
        PARALYZE_MSG_OTHER: BS("%s erstarrt ploetzlich!"),
        PARALYZE_END: BS("Du ueberwindest Deine Furcht!"),
        PARALYZE_END_OTHER: BS("%s bewegt sich wieder!")]));
  return;
}

nosave void loose_mv(object pl) {
  tell_object(pl, BS("Du fuehlst Dich total ausgelaugt."));
  pl->DoExhaust(random(200)+50);
  return;
}

nosave void flee_now(object pl) {
  tell_object(pl, BS("Du hast ANGST, denn solltest Du hier sterben, erwarten "
        "Deine Seelen Qualen jenseits des Vorstellbaren!"));
  pl->SetProp(P_WIMPY, pl->QueryProp(P_MAX_HP)-1);
}

void clone_demon(object pl) {
  object ob;
  if (!objectp(pl))
    return;
  tell_room(ME, BS(sprintf("Ploetzlich oeffnet sich ein kleiner Riss im "
          "Gefuege der Welt. Aus dem wabbernden Nichts erscheint ein Daemon "
          "und stuerzt sich auf %s!", pl->name(WEN,1))),({pl}));
  tell_object(pl, BS("Neben Dir oeffnet sich ploetzlich ein Riss im Gefuege "
      "der Welt. Ehe Du Dich versiehst wirst Du von einem Daemon attackiert, "
      "der durch diesen Riss in unsere Welt gelangt sein muss!"));
  ob=clone_object(NEKRO_ISLAND_NPC "demon");
  ob->move(ME,M_NOCHECK|M_SILENT);
  pl->AddPursuer(ob);
  ob->ModifySkillAttribute(ob, SA_SPEED, 200, 2);
  ob->Kill(pl);
  return;
}

varargs void create_barrier(object pl) {
  mapping room_exits;
  string dir;
  if(!sizeof(filter_array(all_inventory(ME), #'interactive)))
    return ;
  room_exits=QueryProp(P_NEW_EXITS);
  if(sizeof(room_exits)<2) {
     call_out("BeNasty", 2, "");
     return ;
  }
  dir=m_indices(room_exits)[random(sizeof(room_exits))];
  if(QueryBarrier(dir)) {
     call_out("BeNasty", 2, "");
     return ;
  }
  tell_room(ME, BS(sprintf("Ploetzlich formt sich aus dem Boden eine unheilige "
        "Knochenbarriere, die das Weiterkommen Richtung %s unmoeglich "
        "macht!", CAP(dir))));
  AddBarrier(dir);
  return ;
}

void transform_element(object lv) {
  object owner;
  string what;
  if(lv->id("\nd_elementar"))
    what="Elementar";
  else
    what="Feuerwusel";
  owner=lv->QueryProp("e_owner");
  lv->SetProp("e_owner", find_living("xarfai"));
  lv->SetProp(P_AGGRESSIVE, 0.3);
  lv->SetProp(P_FRIEND, 0);
  if(objectp(owner)) {
    tell_object(owner, BS(sprintf("Irgendetwas stimmt mit Deinem "
          "%s nicht.",what)));
    tell_room(ME, BS(sprintf("Irgendetwas stimmt mit dem %s von %s "
            "nicht!", what, owner->name(WER))));
    lv->SetAggressive(owner);
  } 
  else {
    tell_room(ME, BS(sprintf("Irgendetwas stimmt mit dem %s "
            "nicht ...", what)));
  }
  return ;
}

void transform_knarkhdemon(object lv) {
  string owner_name;
  object owner;
  string what;
  if(stringp(owner_name=lv->QueryMaster()))
    owner_name=lower_case(owner_name);
  owner=find_player(owner_name);
  lv->RemoveMaster();
  lv->SetProp(P_AGGRESSIVE, 0.4);
  lv->SetProp(P_FRIEND, 0);
  if(!owner) return ;
  tell_room(ME, BS(sprintf("Der Daemon von %s beginnt zu knurren ...",
          CAP(owner_name))), ({owner}));
  tell_object(owner, BS("Du hast die Herrschaft ueber Deinen Daemon "
        "verloren!"));
  return ;
}

int living_check(object ob) {
  mixed h;
  int equip_val;
  if(IS_LEARNING(ob)) return 0;
  if(ob->QueryProp(P_PARALYZED)) return 0;
  if(ob->is_class_member(CL_UNDEAD) || ob->is_class_member(CL_DEMON)) 
    return 0;
  if(ob->is_necromancer_npc()) return 0;
  if(ob->QueryProp(P_GUILD)==GUILDNAME) return 0;
  if(ob->QueryProp(P_GUILD)=="paladine" && ob->QueryProp(P_ALIGN) > 200) {
    if(h=ob->QueryProp(P_TMP_DEFEND_HOOK)) {
      if(h[1]==TO && h[2]=="schutz2") {
        if(h[0]>=time()) {
          if((random(ob->QueryProp(P_ALIGN)/5)+ob->QueryProp(P_GUILD_LEVEL)*2) > 
              random(call_other( NEKROMASTER, "QueryBloodPool")[0]/400))
          {
            return 0;
          }
        }
      }
    }
  } else if(h=find_object("/spellbooks/pal_spells")) {
    if(!catch(equip_val=(int)(100*h->CheckItems(ob)))) {
      if(equip_val > random(200)) {
        return 0;
      }
    }
  }
  if(!living(ob)) return 0;
  return 1;
} 


void reset() {
  ::reset();
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp) {
  // Geht ueber reanimate_me der Leiche.
  //call_out("make_zombie",2,victim,killer,lost_xp);
  return;
}

nosave void make_zombie(object victim, object killer, int lost_xp) {
  object *corpses;
  object zombie;
  int i;
  corpses=filter_array(all_inventory(ME), "corpse_check");
  if(!sizeof(corpses)) return;
  for(i=sizeof(corpses)-1;i>=0;i--) {
    zombie=clone_object(NPC "zombie");
    zombie->SetZombie(corpses[i], 1, 6000+random(4000));
    zombie->SetProp(P_AGGRESSIVE, ([0:1,P_GUILD:(["nekromanten":0])]));
    tell_room(ME, BS(sprintf("Die Leiche von %s zuckt kurz und erhebt sich "
        "wieder!", victim->name(WEM))));
    zombie->move(ME, M_NOCHECK);
    if(objectp(corpses[i])) corpses[i]->remove();
  }
  return;
}
varargs int corpse_check(object ob) {
  if(!ob->id("Leiche")) return 0;
  return 1;
}

void init() {
  ::init();
  if (!interactive(TP)) return;
  if (IS_LEARNING(TP)) return;
  /*
  if(!TP->QueryProp(P_TESTPLAYER)) {
    TP->move("/gilden/abenteurer", M_TPORT);
    raise_error(sprintf("Illegales Transportieren von Spieler %s in das Gebiet"
        " der Nekromanten!",TP->name(WER)));
    return ;
  }
  */
  if (QueryProp(P_BONES) && !sizeof(TP->QueryArmours(AT_BOOT))) 
    call_out("bone_damage", 0);
} 

void bone_damage() {
  write("Knochensplitter bohren sich in Deine ungeschuetzten Fuesse!\n");
  do_room_damage(TP, random(50)+10, "Ein Knochensplitter");
  return ;
}

void reanimate(object *obs) {
  int i;
  object ob;
  i=0;
  while(i<20 && sizeof(obs)) {
    i++;
    if(objectp(obs[0])) {
      if(!query_once_interactive(obs[0]) && obs[0]->QueryProp(P_NOMAGIC) != 
          "dusty" ) 
      {
        call_other(obs[0], "reanimate_me");
      }
      else if(obs[0]->QueryProp(P_GHOST)) {
        if(!random(3)) {
          tell_object(obs[0], "Die dunklen Maechte zwingen Deinen "
              "Geist wieder in eine fleischliche Huelle!\n");
          obs[0]->SetProp(P_GHOST, 0);
          obs[0]->SetProp(P_SP, 0);
          obs[0]->SetProp(P_HP, 20+random(50));
        }
      }
    }
    obs-=({obs[0]});
  }
  if(!sizeof(obs)) return;
  call_out("reanimate", 0,obs);
  return;
}

// 2012-08-01 Gwenshara: Untote duerfen hier bitte rasten
mixed _query_norest()
{
  if(!objectp(TP))
    return 0;
 
  if(TP->QueryProp(P_GUILD) != "nekromanten")
    return "Narr. Hier zu rasten waere Dein Tod!\n";

  return 0;
}
