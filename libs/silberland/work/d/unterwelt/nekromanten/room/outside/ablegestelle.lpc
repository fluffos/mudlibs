#include <properties.h>
#include <moving.h>
#include "/gilden/nekromanten/nekro.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit "std/room";
inherit "/players/cirion/service/fun";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
  SetProp (P_INT_SHORT, "Eine duestere Anlegestelle");
  SetProp (P_INT_LONG,
    "Du stehst auf einem schmalen steinernen Steg, der einige Meter in "+
    "den riesigen, unterirdischen See hineinragt, der sich vor Dir bis weit "+
    "nach Sueden erstreckt. In der Mitte des Sees kannst Du eine dunkle, "+
    "bedrohlich wirkende Insel ausmachen. Hinter Dir ragt eine steile "+
    "Felswand fast zehn Meter empor, nur eine steile, enge Treppe "+
    "ermoeglicht den Aufstieg. Weit ueber Dir spannt sich die Felsdecke "+
    "ueber die riesige Hoehle, von der ein kaltes, duesteres Licht "+
    "herabfaellt.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"aufstieg", "treppe"}),
    "Eine enge, steile Treppe noerdlich von Dir ermoeglicht den Aufstieg "+
    "auf die Felswand, die sich dort erhebt. Die Stufen sind direkt aus dem "+
    "massiven Stein gehauen, der so schwarz ist, dass man meint, er wuerde "+
    "das Licht verschlucken. Ein Gelaender gibt es nicht.");
  AddDetail ( ({"stufen"}),
    "Die Stufen sind direkt aus dem schwarzen, lichtschluckenden Gestein "+
    "gehauen, aus dem hier alles besteht. Sie sind nur grob bearbeitet und "+
    "daher sehr unregelmaessig. Eine Stufe faellt Dir auf.");
  AddDetail ( ({"fels", "felsen", "felsgestein",
                "gestein", "stein"}),
    "Das Felsgestein, aus dem die Wand, die Treppe und auch der Steg, auf "+
    "dem Du stehst, ist schwarz und scheint alles Licht zu "+
    "verschlucken.");
  AddDetail ( ({"felswand", "wand"}),
    "Gleich hinter Dir erhebt sich eine steile, schwarze Felswand fast "+
    "zehn Meter in die Hoehe. Eine schmale Treppe ermoeglicht den Aufstieg.");
  AddDetail ( ({"steg"}),
    "Ein schmaler, steinerner Steg fuehrt von der Treppe im Norden einige "+
    "Meter auf den See hinaus. Er ist aus direkt aus dem massiven Fels "+
    "geschlagen und nur grob bearbeitet. Ein Gelaender hat er nicht.");
  AddDetail ( ({"see"}),
    "Ein gewaltiger, dunkler See breitet sich vor Dir weit nach Sueden "+
    "aus. In der Mitte des Sees ist eine dunkle Insel zu erkennen. Die "+
    "Wasseroberflaeche ist voellig ruhig. Als Du Dich hinunterbeugst, um "+
    "das Wasser etwas genauer zu betrachten, faellt Dir auf, dass es "+
    "voellig klar ist. Dennoch kannst Du keinen Grund erkennen.");
  AddDetail ( ({"oberflaeche", "wasseroberflaeche"}),
    "Die Wasseroberflaeche ist dunkel, aber voellig ruhig und klar.");
  AddSpecialDetail("wasser","det_wasser");
  AddDetail ( ({"mitte"}),
    "In der Mitte des dunklen Sees erkennst Du eine bedrohlich wirkende "+
    "Insel.");
  AddDetail ( ({"meter","zwergenlaenge"}),
    "Ein Meter, das ist fast eine Zwergenlaenge.");
  AddDetail ( ({"licht"}),
    "Ein kaltes, duesteres Licht faellt von der Decke herab und taucht "+
    "alles in eine unheimliche Atmosphaere.");
  AddDetail ( ({"insel"}),
    "Auf der Insel in der Mitte des Sees scheint die pure Dunkelheit zu "+
    "herrschen. Du bekommst ein sehr ungutes Gefuehl, wenn Du sie laenger "+
    "betrachtest und es laeuft Dir kalt den Ruecken hinunter.");
  AddDetail ( ({"ruecken"}),
    "Der ist hinter Dir.");
  AddDetail ( ({"hoehle", "kuppel"}),
    "Wie eine Kuppel spannt sich die riesige Hoehle ueber den See. Von der "+
    "Decke faellt ein fahles, kaltes Licht herab und taucht alles in eine "+
    "unheimliche Atmosphaere.");
  AddDetail ( ({"himmel"}),
    "Der ist hier sicher nicht zu sehn.");
  AddDetail ( ({"grund"}),
    "Du kannst den Grund des Sees nicht erkennen, obwohl das Wasser klar "+
    "zu sein scheint.");
  AddDetail ( ({"gelaender"}),
    "Du siehst keine Gelaender, weder am Steg noch an der schmalen Treppe, "+
    "die an der Felswand emporfuehrt.");
  AddDetail ( ({"decke", "felsdecke"}),
    "Die Felsdecke spannt sich weit ueber Dir ueber den gesamten See und "+
    "auch darueber hinaus. Ein fahles Licht faellt von dort oben herab und "+
    "taucht alles in eine unheimliche Atmosphaere.");
  AddDetail ( ({"dunkelheit"}),
    "Die Dunkelheit, die auf der Insel herrscht, ist sogar bis hier fast "+
    "koerperlich spuerbar. Sicher haust dort etwas absolut boeses.");
  AddDetail ( ({"boden"}),
    "Du stehst auf einem schmalen, steinernen Steg, der einige Meter in "+
    "den See hinausragt.");
  AddDetail ( ({"atmosphaere", "gefuehl"}),
    "Die dunkle Atmosphaere beschleicht Dich, Du fuehlst Dich immer "+
    "unwohler, je laenger Du hier stehst.");
  AddDetail ( ({"hoehe"}),
    "Die Felswand ragt fast zehn Meter empor, aber die Decke der Hoehle "+
    "ist sicher fuenfmal so weit entfernt.");
  AddDetail ( ({"stufe"}),
    "Eine der Stufen der Treppe ist nicht massiv, "+
    "es scheint fast, als waere ein Mechanismus dahinter versteckt.");
  AddDetail ( ({"mechanismus"}),
    "Als Du den Mechanismus genauer untersuchst, stellst Du fest, dass es "+
    "sich scheinbar um eine Falle handelt.");
  AddDetail ( ({"falle"}),
    "Die Falle laesst die Stufe offensichtlich nach unten klappen, wenn "+
    "man darauf tritt, so dass man ganz gefaehrlich stuerzen kann. "+
    "Vielleicht ist es besser, die Treppe vorsichtig hinaufzugehen.");
  AddDetail ( ({"saeure"}),
    "Noch einmal steckst Du Deinen Finger nicht da rein.");
  // DETAILS END

  // EXITS START
  AddSpecialExit ("oben", "treppe");
  AddCmd(({"geh","gehe"}),
    "gehe_fun");
  // EXITS END

  // ITEMS START
  AddItem(NEKRO_ISLAND_DIR+"transport/barke", REFRESH_INIT, 1);
  // ITEMS END

}

int treppe()
{
  string *acid_rooms;
  string dest_room;
  acid_rooms=({"-1:20","1:20","-1:19","0:19","1:19"});
  if(TP->QueryProp(P_GUILD) == "nekromanten") {
    tell_object(TP,BS(
      "Du gehst die Treppe hinauf und machst dabei einen Schritt ueber "
      "die suspekte Stufe."));
    tell_room(ENV(TP),BS(
      TP->Name()+" geht die Treppe hoch."),({TP}));
    TP->move(NEKRO_ISLAND_DIR+"room/outside/absatz",M_GO|M_NOCHECK|M_SILENT);
    tell_room(ENV(TP),BS(
      TP->Name()+" kommt die Treppe herauf."),({TP}));
    return 1;
  }
  tell_object(TP,BS(
    "Du machst einige Schritte die Treppe hinauf, als eine der Stufen unter "
    "Deinem Tritt nachgibt, Du das Gleichgewicht verlierst und die Treppe "
    "hinunter in den See stuertzst."));
  tell_room(ENV(TP),BS(sprintf(
    "%s macht einige Schritte die Treppe hinauf, als %s das "
    "Gleichgewicht verliert und die Treppe hinunter in den See stuertzt.",
    TP->Name(WER), TP->QueryPronoun(WER))), ({TP}));
  dest_room=NEKRO_ISLAND_DIR+"room/acid_lake/std_acid:"+
    acid_rooms[random(sizeof(acid_rooms))];
  call_other(dest_room, "???");
  tell_object(TP,BS(
    "Du stoesst einen lauten Schrei aus!"));
  TellDomain("/d/unterwelt/nekromanten",BS(
    "Du hoerst einen unmenschlich lauten Schrei durch die Hoehlen hallen."),
    ({TP}));
  TP->move(dest_room,M_GO|M_NOCHECK|M_SILENT);
  tell_room(ENV(TP),BS(
    TP->Name()+" kommt hinuntergestuetzt und landet neben Dir im See.")
    ,({TP}));
  return 1;
}

int gehe_fun(string str)
{
  notify_fail("Wohin moechtest Du gehen?\n");
  if (-1!=member(({"nach oben",
                   "hoch",
                   "rauf",
                   "hinauf",
                   "treppe hoch",
                   "treppe rauf",
                   "treppe hinauf",
                   "die treppe hoch",
                   "die treppe rauf",
                   "die treppe hinauf"
                   }),str))
  {
    treppe();
    tell_object(TP,"Tja, es war eben von Vorsicht die Rede.\n");
    return 1;
  }
  if (-1!=member(({"vorsichtig nach oben",
                   "vorsichtig hoch",
                   "vorsichtig rauf",
                   "vorsichtig hinauf",
                   "vorsichtig treppe hoch",
                   "treppe vorsichtig hoch",
                   "vorsichtig treppe rauf",
                   "treppe vorsichtig rauf",
                   "vorsichtig treppe hinauf",
                   "treppe vorsichtig hinauf",
                   "vorsichtig die treppe hoch",
                   "die treppe vorsichtig hoch",
                   "vorsichtig die treppe rauf",
                   "die treppe vorsichtig rauf",
                   "vorsichtig die treppe hinauf",
                   "die treppe vorsichtig hinauf"
                   }),str))
  {
    tell_object(TP,BS(
      "Du gehst die Treppe hinauf und machst dabei einen Schritt ueber "
      "die suspekte Stufe."));
    tell_room(ENV(TP),BS(
      TP->Name()+" geht die Treppe hoch."),({TP}));
    TP->move(NEKRO_ISLAND_DIR+"room/outside/absatz",M_GO|M_NOCHECK|M_SILENT);
    tell_room(ENV(TP),BS(
      TP->Name()+" kommt die Treppe herauf."),({TP}));
    return 1;
  }
  return 0;
}

string det_wasser()
{
  write(BS(
    "Du beugst Dich zum Wasser herunter, um es genauer zu betrachten. Es "
    "ist voellig klar, doch hier im kalten Licht scheint es eine dunkle "
    "Faerbung anzunehmen. Du tauchst vorsichtig Deinen Finger ein, als "
    "Dich ein brennender Schmerz durchzuckt. Das ist kein Wasser, das ist "
    "ein riesiger See von aetzender Saeure!"));
  TP->AddHp(-5);
  return "";
}
