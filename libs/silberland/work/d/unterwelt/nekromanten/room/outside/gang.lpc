#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/outside/"+x)
#endif

inherit "std/room";

string *allowed_to_pass=({});
int max_demons=10;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14,
                            ENV_TERRAIN: TT_CAVE,
                            ]));
  SetProp (P_INT_SHORT, "In einem dunklen Gang");
  SetProp (P_INT_LONG, 
      "Der Gang wird nun wieder etwas breiter. Die Waende strahlen eine "
      "unangenehme Kaelte, was ein Gegensatz zur erhitzen Luft darstellt. "
      "Als Du die Waende etwas naeher in Augenschein nimmst, faellt Dir "
      "auf, das sie mit seltsamen roten Symbolen beschmiert sind. Etwas "
      "weiter Richtung Sueden kannst Du eine Treppe ausmachen. Richtung "
      "Norden siehst Du ... seltsam, hier ist keine Felswand. Der Gang "
      "fuehrt normal Richtung Norden weiter.");
  SetProp(P_KILL_NAME, "Blutverlust");
  // ROOM DESCRIPTION END
  AddDetail( ({"norden", "durchgang", "felswand", "wand"}),
      "Hmmm, hier ist keine Wand, sondern nur ein Durchgang nach Norden.");
  AddDetail( ({"boden"}), 
      "Der Boden besteht aus kaltem, glatten Fels. Du kannst nichts "
      "Besonderes entdecken.");
  AddDetail( ({"fels"}),
      "Der Fels ist rabenschwarz und eiskalt. Seltsam, da die Luft ziemlich "
      "heiss ist.");
  AddDetail( ({"besonderes"}),
      "Du sehr Du auch suchst, Du kannst keine besonderen Eigenheiten "
      "entdecken.");
  AddDetail( ({"luft"}),
      "Du siehst sie zwar nicht, aber sie fuehlt sich SEHR warm an.");
  AddDetail( ({"waende", "wand"}),
      "An den Waenden sind mit roter Farbe seltsame Symbole geschmiert "
      "worden. Was sie wohl bedeuten moegen.");
  AddSpecialDetail( ({"symbole"}), "symbol_fun");
  AddDetail( ({"farbe"}),
      "Die Farbe sieht aus wie getrocknetes Blut.");
  AddDetail( ({"blut"}),
      "Keine Frage, das IST Blut!");
  AddDetail( ({"kaelte"}),
      "Eiskalt sind sie, die Waende.");
  AddDetail( ({"sueden", "richtung"}),
      "Etwas weiter Richtung Sueden scheint eine Treppe zu sein.");
  AddDetail( ({"treppe"}),
      "Von hier aus kannst Du nicht viel erkennen. Geh doch nach Sueden!");
  AddDetail( ({"decke"}),
      "Die Decke besteht, genau so wie der Boden, aus schwarzem Fels.");
  AddSpecialDetail( ({"gang"}), "_query_int_long");
  AddDetail( ({"eigenheiten"}),
      "Als Du nochmal genauer hinsiehst faellt Dir eine kleine Vertiefung "
      "im Boden auf.");
  AddDetail( ({"vertiefung"}),
      "Es befindet sich getrocknetes Blut in dieser kleinen Vertiefung. "
      "Sieht so aus als haette jemand Blut hineingetraeufelt.");

  AddSmell(DEFAULT_SMELL, 
      "Die Luft ist warm hier und riecht modrig.");
  AddSmell("luft"
      "Die Luft ist warm hier und riecht modrig.");
  AddSound(DEFAULT_SOUND,
      "Du hoerst nur Deinen eigenen Atem.");
  AddSound("atem", 
      "Du atmest schwer.");
  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit (SUEDEN, ([ 
        EX_DEST: "./absatz",
        EX_TESTFUNC: "check_allowed_to_pass"]));
  AddExit (NORDEN, NEKRO_CONNECTROOM_UWELT);
  // EXITS END

  // ITEMS START
  // ITEMS END
  AddCmd( ({"traeufel", "traeufle"}), "sac_blood");

}

void reset() {
  ::reset();
  max_demons=10;
}

string symbol_fun() {
  if(TP->QueryProp(P_GUILD) =="nekromanten")
    return BS("Das sind Symbole der Verdammnis und des Verderbens.");
  return BS("Du hast leider keine Ahnung was diese Symbole bedeuten sollen.");
}

int sac_blood(string str) {
  if(!str) {
    write("Was moechtest Du wohin traeufeln?\n");
    return 1;
  }
  if(str != "blut in vertiefung") {
    write("Was moechtest Du wohin traeufeln?\n");
    return 1;
  }
  write(BS("Du fuegst Dir eine kleine Wunde zu und traeufelst drei "
        "Tropfen Blut in die Vertiefung. Das Blut wird sofort von der "
        "Vertiefung absorbiert."));
  say(BS(sprintf("%s bueckt sich und scheint etwas am Boden zu machen. "
          "Du kannst es leider nicht genau erkennen.",
          TP->Name(WER))));
  TP->do_damage(random(10));
  allowed_to_pass+=({getuid(TP)});
  return 1;
}

int check_allowed_to_pass() {
  object ob;
  if(TP->QueryProp(P_GUILD)=="nekromanten") {
    return 1;
  }
  if(member(allowed_to_pass, getuid(TP)) != -1) {
    allowed_to_pass-=({getuid(TP)});
    return 1;
  }
  write(BS("Du versuchst weiter Richtung zu gehen, als sich ploetzlich "
      "ein Spalt im Gefuege der Welt oeffnet. Du taumelst zurueck ..."));
  say(BS(sprintf("%s versucht nach Sueden zu gehen, als sich ploetzlich ein "
          "Spalt im Gefuege der Welt oeffnet.", TP->Name(WER))));
  if(max_demons > 1) { 
    ob=clone_object(NEKRO_ISLAND_NPC "demon");
    ob->move(ME, M_TPORT);
    ob->Kill(TP);
    max_demons--;
  }
  if(max_demons > 1) { 
    ob=clone_object(NEKRO_ISLAND_NPC "demon");
    ob->move(ME, M_TPORT);
    ob->Kill(TP);
    max_demons--;
  }
  return 0;
}
