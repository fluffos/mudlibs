#include "../nekro.h"
#include "../directions.h"
#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit "std/room";
inherit "/players/cirion/service/fun";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
  SetProp (P_INT_SHORT, "Auf einem schmalen Treppenabsatz");
  SetProp (P_INT_LONG,
    "Du stehst auf einem schmalen Treppenabsatz inmitten der steilen "+
    "Felswand. Nach Sueden hin erkennst Du einen riesigen, dunklen See, "+
    "in dessen Mitte sich eine dunkle Insel erhebt. Die Treppe fuehrt "+
    "nach unten auf einen kleinen Steinsteg zu, nach oben hin fuehrt sie "+
    "an der Felswand empor.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"stufe"}),
    "Eine der Stufen auf dem unteren Stueck der Treppe ist nicht massiv, "+
    "es scheint fast, als waere ein Mechanismus dahinter versteckt.");
  AddDetail ( ({"stufen"}),
      "Stufen ueber Stufen geht die Treppe nach unten. Jede einzelne "
      "von ihnen scheint massiv zu sein.");
  AddDetail ( ({"mechanismus"}),
    "Als Du den Mechanismus genauer untersuchst, stellst Du fest, dass es "+
    "sich scheinbar um eine Falle handelt.");
  AddDetail ( ({"falle"}),
    "Die Falle laesst die Stufe offensichtlich nach unten klappen, wenn "+
    "man darauf tritt, so dass man ganz gefaehrlich stuerzen kann. "+
    "Vielleicht ist es besser, die Treppe vorsichtig hinunterzugehen.");
  AddDetail ( ({"absatz", "flaeche", "treppenabsatz"}),
    "Der Treppenabsatz ist nicht mehr als eine kleine, ebene Flaeche, auf "+
    "der man sich umdrehen kann, weil die Treppe einen Knick in die andere "+
    "Richtung macht. Ansonsten hat diese Treppe genau das was andere Treppen "
    "auch haben.");
  AddDetail ( ({"treppe"}),
    "Die Treppe ist direkt aus dem blossen Fels gehauen und nur grob "+
    "bearbeitet. Nach unten fuehrt die Treppe zu einem kleinen Steg, der "+
    "ein paar Meter in den See hinausfuehrt, nach oben fuehrt sie zum Rand "+
    "der Felswand.");
  AddDetail ( ({"steg", "steinsteg"}),
    "Ein kleines Steg aus schwarzem Fels fuehrt unter Dir einige Meter in "+
    "den See hinaus.");
  AddDetail ( ({"see"}),
    "Dunkel glaenzend liegt der See im fahlen, kalten Licht da. Er "+
    "erstreckt sich nach Sueden bis weit in die Dunkelheit hinein, und in "+
    "seiner Mitte erkennst Du eine dunkle Insel.");
  AddDetail ( ({"rand"}),
    "Der Rand der Felswand liegt noch einige Meter ueber Dir.");
  AddDetail ( ({"insel", "mitte"}),
    "In der Mitte des Sees liegt eine bedrohlich wirkende, dunkle Insel.");
  AddDetail ( ({"meter", "zwergenlaenge"}),
    "Ein Meter ist fast eine Zwergenlaenge.");
  AddDetail ( ({"licht"}),
    "Von der Decke der Hoehle faellt ein fahles, kaltes Licht herab und "+
    "taucht alles in eine unheimliche Atmosphaere.");
  AddDetail ( ({"knick"}),
    "Die Treppe macht hier einen Knick in die andere Richtung.");
  AddDetail ( ({"hoehle"}),
    "Der See befindet sich in einer gewaltigen Hoehle, deren Decke sich "+
    "weit ueber Dir von Ufer zu Ufer spannt.");
  AddDetail ( ({"ufer"}),
    "Du stehst am noerdlichen Ufer des Sees, das westliche und oestliche "+
    "kannst Du auch noch erkennen, doch das suedliche liegt zu weit "+
    "entfernt in der Dunkelheit.");
  AddDetail ( ({"himmel"}),
    "Den wirst Du hier unten sicher nicht finden.");
  AddDetail ( ({"felswand", "wand"}),
    "Der Absatz hier befindet sich inmitten einer Wand aus tiefschwarzem "+
    "Fels.");
  AddDetail ( ({"fels", "felsgestein", "gestein",
                "stein"}),
    "Das Felsgestein ist tiefschwarz und scheint jedes Licht zu "+
    "verschlucken.");
  AddDetail ( ({"dunkelheit"}),
    "Der suedliche Teil des Sees und die Insel liegen in tiefster "+
    "Dunkelheit.");
  AddDetail ( ({"haelfte", "teil"}),
    "Damit ist die untere Haelfte der Treppe gemeint.");
  AddDetail ( ({"decke", "hoehlendecke"}),
    "Die Hoehlendecke befindet sich sicher 50 Meter ueber Dir. Ein fahles, "+
    "kaltes Licht faellt von dort oben herab.");
  AddDetail ( ({"boden"}),
    "Der Boden besteht aus grob behauenem, schwarzen Felsgestein.");
  AddDetail ( ({"atmosphaere"}),
    "Die Atmosphaere hier unten ist wirklich unheimlich.");
  AddSpecialDetail( ({ "portal" }),
      "portal_search_fun");
  // DETAILS END

  // EXITS START
  AddSpecialExit ("unten", "treppe");
  AddCmd(({"geh","gehe"}),
    "gehe_fun");
  AddCmd(({"betrete","betritt"}),
      "portal_fun");
  AddExit (NORDEN, "./gang");
  // EXITS END

  // ITEMS START
  // ITEMS END

}

int treppe()
{
  string *acid_rooms;
  string dest_room;
  if(TP->QueryProp(P_GUILD)=="nekromanten") {
    tell_room(ENV(TP),BS(
      TP->Name()+" geht die Treppe runter."),({TP}));
    TP->move(NEKRO_ISLAND_DIR+"room/outside/ablegestelle",M_GO|M_NOCHECK|M_SILENT);
    tell_room(ENV(TP),BS(
      TP->Name()+" kommt die Treppe herunter."),({TP}));
    return 1;
  }
  acid_rooms=({"-1:20","0:20","1:20","-1:19","0:19","1:19"});
  tell_object(TP,BS(
    "Du machst einige Schritte die Treppe hinunter, als eine der Stufen unter "
    "Deinem Tritt nachgibt, Du das Gleichgewicht verlierst und die Treppe "
    "hinunter in den See stuertzst."));
  tell_room(ENV(TP),BS(sprintf(
    "%s macht einige Schritte die Treppe hinunter, als %s das "
    "Gleichgewicht verliert und die Treppe hinunter in den See stuertzt.",
    TP->Name(WER), TP->QueryPronoun(WER))), ({TP}));
  dest_room=NEKRO_ISLAND_DIR+"room/acid_lake/std_acid:"+
    acid_rooms[random(sizeof(acid_rooms))];
  catch(call_other(dest_room, "???"));
  tell_object(TP,BS(
    "Du stoesst einen lauten Schrei aus!"));
  TellDomain("/d/unterwelt/nekromanten",BS(
    "Du hoerst einen unmenschlich lauten Schrei durch die Hoehlen hallen."),
    ({TP}));
  TP->move(dest_room,M_GO|M_NOCHECK|M_SILENT);
  tell_room(ENV(TP),BS(
    TP->Name()+" kommt hinuntergestuetzt und landet neben Dir im See.")
    ,({TP}));
  return 1;
}

int gehe_fun(string str)
{
  notify_fail("Wohin moechtest Du gehen?\n");
  if (-1!=member(({"treppe runter",
                   "die treppe runter",
                   "runter",
                   "die treppe hinunter",
                   "treppe hinunter"}),str))
  {
    treppe();
    tell_object(TP,"Tja, es war eben von Vorsicht die Rede.\n");
    return 1;
  }
  if (-1!=member(({"vorsichtig treppe runter",
                   "vorsichtig die treppe runter",
                   "vorsichtig runter",
                   "die treppe vorsichtig runter",
                   "treppe vorsichtig runter",
                   "die treppe vorsichtig hinunter",
                   "treppe vorsichtig hinunter",
                   "vorsichtig die treppe hinunter",
                   "vorsichtig treppe hinunter"}),str))
  {
    tell_object(TP,BS(
      "Du gehst die Treppe hinunter und machst dabei einen Schritt ueber "
      "die suspekte Stufe."));
    tell_room(ENV(TP),BS(
      TP->Name()+" geht die Treppe runter."),({TP}));
    TP->move(NEKRO_ISLAND_DIR+"room/outside/ablegestelle",M_GO|M_NOCHECK|M_SILENT);
    tell_room(ENV(TP),BS(
      TP->Name()+" kommt die Treppe herunter."),({TP}));
    return 1;
  }
  return 0;
}

string _query_int_long() {
  string txt;
  txt=
    "Du stehst auf einem schmalen Treppenabsatz inmitten der steilen "+
    "Felswand. Nach Sueden hin erkennst Du einen riesigen, dunklen See, "+
    "in dessen Mitte sich eine dunkle Insel erhebt. Die Treppe fuehrt "+
    "nach unten auf einen kleinen Steinsteg zu, nach oben hin fuehrt sie "+
    "an der Felswand empor.";
  if(TP->QueryProp(P_GUILD) == "nekromanten" && TP->QueryProp(P_GUILD_LEVEL)
      > 3) 
  {
    txt+=" Ein dunkel schimmerndes Portal fuehrt nach Yaq'Monoq. Du koenntest "
      "es betreten.";
  }
  return BS(txt);
}

string portal_search_fun() {
  if(TP->QueryProp(P_GUILD) != "nekromanten" || TP->QueryProp(P_GUILD_LEVEL) 
      < 4) 
  {
    return BS("Sowas siehst Du hier nicht.");
  }
  return BS("Das dunkel schimmernde Portal kannst Du betreten. Du bist "
      "Dir ziemlich sicher das es Dich nach Yaq'Monoq bringen wird.");
}

int portal_fun(string str) 
{
  if(TP->QueryProp(P_GUILD) != "nekromanten" || TP->QueryProp(P_GUILD_LEVEL) 
      < 4) 
  {
    return 0;
  }
  if(str != "portal") {
    write("Was moechtest Du betreten? Das Portal?\n");
    return 1;
  }
  write(BS("Du betrittst das dunkel schimmernde Portal ... "));
  Message(BS(sprintf("%s macht einen Schritt zur Seite und ist "
          "ploetzlich verschwunden!", TP->Name(WER))), MSGFLAG_VISUAL |
          MSGFLAG_NO_TP);
  if(!call_other(NEKROMASTER, "UseBloodPool", 10)) 
    TP->move("/d/dschungel/feyaria/tijara/room/dimension", M_TPORT|M_SILENT);
  else TP->move(NEKRO_ROOMS+"g4", M_TPORT|M_SILENT);
  return 1;
}

