#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"
#include "../../dungeon.h"

#ifndef P_SEERDOOR_DISCOVER
#define P_SEERDOOR_DISCOVER "rw_sehertor_disc"
#endif

inherit "/std/room";

void create()
{
  ::create();
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_OTHER, ENV_TEMPERATURE: 14]) );
  SetProp (P_INT_SHORT, "Begreben unter Totenschaedeln");
  SetProp (P_INT_LONG, 
      "Du bist begraben unter vielen Totenschaedeln. Ob Du hier jemals wieder "
      "rauskommst? Deine einzige Hoffnung scheint dieses schimmernde Etwas zu "
      "sein, das schemenhaft zwischen den Schaedeln zu erkennen ist.");

  AddItem("/obj/sehertor", REFRESH_REMOVE, ([P_SEERDOOR_DISCOVER: 0]) );
  SetProp(P_TPORT_COST_IN, 333);
  SetProp(P_TPORT_COST_OUT, 33);
}
