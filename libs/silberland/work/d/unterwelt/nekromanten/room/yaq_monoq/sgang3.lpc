#include <properties.h>
#include <moving.h>
#include <class.h>
#include "../../nekro.h"

#define BLOOD_MAX         15
#define BLOOD_FIX          5
#define BLOOD_RAN          5
#define BLOOD_HP_FIX      10
#define BLOOD_HP_RAN      15
#define BLOOD_ALIGN_FIX   50
#define BLOOD_ALIGN_RAN  100

inherit "std/room";

string detail_blood();

int blood;

void create()
{
  ::create();

  blood = BLOOD_FIX + random(BLOOD_RAN);

  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:16]));
  SetProp (P_INT_SHORT, "In einem dunklen Saeulengang");
  SetProp (P_INT_LONG,
    "Du stehst in einem dunklen, bedrohlich wirkenden Gang, der sich nach "+
    "Sueden hin geradewegs ins Innere der Felseninsel zu erstrecken "+
    "scheint. Rechts und links des Ganges an den Felswaenden stehen "+
    "schwarze, von blutroten Adern durchzogene Marmorsaeulen. Decke und "+
    "Boden sind aus grob behauenem, schwarzen Felsgestein.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"waende", "wand"}),
    "Die Waende sind aus dem gleichen, grob behauenen schwarzen "+
    "Felsgestein wie Decke und Boden. Entlang beider Waende stehen jedoch "+
    "schwarzeglaenzende, von roten Adern durchzogene Marmorsaeulen.");
  AddDetail ( ({"marmorsaeule", "marmorsaeulen", "saeule",
                "saeulen"}),
    "Rechts uns links des Ganges stehen schwarzglaenzende Marmorsaeulen, "+
    "die die Decke des Ganges stuetzen. Sie sind von duennen, blutroten "+
    "Adern durchzogen. Zwischen zwei Saeulen auf der linken Seite entdeckst "+
    "Du ein Becken, welches etwa in Huefthoehe aus der Wand herausgehauen "+
    "zu sein scheint.");
  AddDetail ( ({"becken"}),
    "Du trittst einige Schritte naeher an das Becken heran. In seinem "+
    "Inneren entdeckst Du eine Fluessigkeit - das... das ist doch frisches "+
    "Blut! Jetzt verstehst Du auch den leicht metallischen Geruch, der hier "+
    "in der Luft liegt...");
  AddSmell ( ({DEFAULT_SMELL}),
    "Seltsam, es riecht hier ein klein wenig metallisch...");
  AddDetail ( ({"geruch"}),
    "Dazu verwendest Du am besten Deine Nase.");
  AddDetail ( ({"nase"}),
    "Hier im Gang findest Du keine - vielleicht hast Du ja selbst eine "+
    "dabei?");
  AddDetail ( ({"felseninsel", "insel"}),
    "Das Du Dich auf einer Insel befindest, ist hier drinnen nicht zu "+
    "erkennen.");
  AddDetail ( ({"boden"}),
    "Der Boden ist aus grob behauenem, schwarzen Felsgestein, genau wie "+
    "Decke und Waende.");
  AddDetail ( ({"decke"}),
    "Die Decke befindet sich knapp zweineinhalb Mannslaengen ueber Dir und "+
    "besteht aus dem gleichen grob behauenen, schwarzen Felsgestein wie "+
    "Waende und Boden.");
  AddDetail ( ({"mannslaenge", "mannslaengen"}),
    "Du weisst doch, wie lang das ist.");
  AddDetail ( ({"innere", "inneres"}),
    "Du fragst Dich, was sich wohl im Inneren dieser Insel befinden mag...");
  AddDetail ( ({"gang", "saeulengang"}),
    "Du befindest Dich in einem dunklen Saeulengang, der von Norden nach "+
    "Sueden verlaeuft.");
  AddDetail ( ({"fels", "felsen", "felsgestein",
                "gestein"}),
    "Der Gang ist offensichtlich direkt in den schwarzen, "+
    "lichtschluckenden Felsen hineingehauen worden.");
  AddDetail ( ({"schritte"}),
    "Du siehst keine Schritte.");
  AddDetail ( ({"blut", "fluessigkeit"}),
    #'detail_blood);
  AddDetail ( ({"huefte", "huefthoehe", "hueften", "hoehe"}),
    "Das Becken ist auf der Hoehe der Hueften eines durchschnittlichen "+
    "Sterblichen.");
  AddDetail ( ({"sterbliche", "sterblicher"}),
    "Da gibts verschiedene...");
  AddSound ( ({DEFAULT_SOUND}),
    "Du hoerst nur Deinen eigenen Atem.");
  AddDetail ( ({"luft"}),
    "Selbst hier unten gibt es Luft.");
  AddDetail ( ({"ader", "adern"}),
    "Duenne, blutrote Adern durchziehen die schwarzglaenzenden "+
    "Marmorsaeulen zu beiden Seiten des Ganges. Sie scheinen leicht zu "+
    "pulsieren.");
  AddDetail ( ({"rand"}),
    "Das Becken ist fast bis zum Rand gefuellt.");
  AddDetail ( ({"seite", "seiten"}),
    "Zu beiden Seiten des Ganges stehen schwarze Marmorsaeulen.");
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./sgang2");
  AddExit ("sueden", "./e1");
  // EXITS END

  // ITEMS START
  // ITEMS END

  AddCmd("trink|trinke&aus&becken",
         "cmd_drink",
         "Woraus moechtest Du trinken?\n");
  AddCmd("trink|trinke&blut|fluessigkeit",
         "cmd_drink",
         "Was moechtest Du trinken?\n");
  AddCmd("wasch|wasche&hand|haende&in&blut|becken|fluessigkeit",
         "cmd_wash",
         "Was moechtest Du waschen?\n"
           "&Worin moechtest Du Deine Haende waschen?\n");
}

string detail_blood()
{
  switch(blood)
  {
    case 0:
      return break_string(
        "In dem Becken sind noch Spuren von frischem, dunkelrotem Blut zu "
        "sehen, welche einen leicht metallischen Geruch verbreiten. Es "
        "scheint auch noch warm zu sein, und Du fragst Dich, warum es "
        "nicht gerinnt...\nHin und wieder blubbert es und ein wenig Blut "
        "scheint durch ein Loch von unten in da Becken zu stroemen.");
      break;
    case 1..5:
      return break_string(
        "Das Becken ist ein wenig mit frischem, dunkelrotem Blut gefuellt, "
        "welches einen leicht metallischen Geruch verbreitet. Es scheint "
        "auch noch warm zu sein. Du fragst Dich, warum es nicht gerinnt...");
    case 6..10:
      return break_string(
        "Das Becken ist gut zur Haelfte mit frischem, dunkelrotem Blut "
        "gefuellt, welches einen leicht metallischen Geruch verbreitet. "
        "Es scheint auch noch warm zu sein. Du fragst Dich, warum es nicht "
        "gerinnt...");
      break;
    default:
      return break_string(
        "Das Becken ist fast bis zum Rand mit frischem, dunkelrotem Blut "
        "gefuellt, welches einen leicht metallischen Geruch verbreitet. Es "
        "scheint auch noch warm zu sein. Du fragst Dich, warum es nicht "
        "gerinnt...");
      break;
  }
}

void reset()
{
  ::reset();
  if (blood < BLOOD_MAX)
  {
    blood = blood + random(BLOOD_RAN);
    if (blood > BLOOD_MAX)
      blood = BLOOD_MAX;
  }
}

int cmd_drink (string str)
{
  if (blood)
  {
    if (this_player()->drink_soft(3))
    {
      switch(this_player()->QueryProp(P_ALIGN))
      {
        case -2666..-300:
          tell_object(this_player(),break_string(
            "Du beugst Dich zum Becken herab und trinkst gierig einen tiefen "
            "Zug Blut aus dem Becken. Aaaah, das ist erfrischend und "
            "belebend!\n"));
          tell_room(environment(this_player()),break_string(
            this_player()->Name()+" beugt sich ueber ein kleines Becken an "
            "der Wand zwischen den Saeulen und trinkt gierig einen tiefen "
            "Zug daraus."),({this_player()}));
          this_player()->AddHp(BLOOD_HP_FIX+random(BLOOD_HP_RAN));
          if (this_player()->is_class_member(CL_UNDEAD))
            this_player()->AddSp((BLOOD_HP_FIX+random(BLOOD_HP_RAN))/2);
          break;
        case -299..299:
          tell_object(this_player(),break_string(
            "Du beugst Dich zum Becken herab und trinkst einen tiefen "
            "Zug Blut aus dem Becken. Ein wenig eklig, aber seltsam "
            "erfrischend.!\n"));
          tell_room(environment(this_player()),break_string(
            this_player()->Name()+" beugt sich ueber ein kleines Becken an "
            "der Wand zwischen den Saeulen und trinkt einen Zug daraus."),
            ({this_player()}));
          this_player()->AddHp(BLOOD_HP_FIX+random(BLOOD_HP_RAN));
          break;
        case 300..699:
          tell_object(this_player(),break_string(
            "Du beugst Dich zum Becken herab und trinkst einen Zug Blut "
            "aus dem Becken. Huah, das ist eklig!\n"));
          tell_room(environment(this_player()),break_string(
            this_player()->Name()+" beugt sich ueber ein kleines Becken an "
            "der Wand zwischen den Saeulen und trinkt einen Zug daraus."),
            ({this_player()}));
          break;
        case 700..2666:
          tell_object(this_player(),break_string(
            "Du beugst Dich zum Becken herab und trinkst einen Zug Blut "
            "aus dem Becken. Huah, das ist eklig - Du spuckst es gleich "
            "wieder aus!\n"));
          tell_room(environment(this_player()),break_string(
            this_player()->Name()+" beugt sich ueber ein kleines Becken an "
            "der Wand zwischen den Saeulen und trinkt einen Zug daraus - "
            "sofort verzieht "+this_player()->QueryPronoun(WER)+" das "
            "Gesicht und spuckt die dunkle Fluessigkeit auf den Boden."),
            ({this_player()}));
          this_player()->SetProp(P_ALIGN,
            this_player()->QueryProp(P_ALIGN)-
              (BLOOD_ALIGN_FIX+random(BLOOD_ALIGN_RAN)));
          break;
        default:
          // Spieler hat ungueltiges Align
          tell_object(this_player(),break_string(
            "BUG! Bitte einen Erzmagier verstaendigen.\n"));
          break;
      }
      blood--;
    }
  }
  else
  {
    tell_object(this_player(),break_string(
      "Aber das Becken ist doch nahezu leer."));
  }
  return 1;
}

int cmd_wash (string str)
{
  if (blood)
  {
    tell_object(this_player(),break_string(
      "Du tauchst Deine Haende in das Becken. Das Blut ist wirklich noch "
      "koerperwarm, aber ausser das Deine Haende jetzt ueber und ueber damit "
      "besudelt sind, scheint nichts zu passieren.\n"));
    tell_room(environment(this_player()),break_string(
      this_player()->Name()+" taucht "+
      this_player()->QueryPossPronoun(FEMALE, WEN, PLURAL)+" Haende in ein "
      "Becken an der Wand zwischen den Saeulen und zieht sie kurz darauf "
      "wieder heraus."),
      ({this_player()}));
    if (!present("\nbloody_hands", this_player()))
      clone_object(NEKRO_ISLAND_OBJ"/bloody_hands")->move(this_player(),
                                                   M_NOCHECK|M_SILENT);
  }
  else
  {
    tell_object(this_player(),break_string(
      "Aber das Becken ist doch nahezu leer."));
  }

  return 1;
}
