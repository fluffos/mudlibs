#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:12]));
  SetProp (P_INT_SHORT, "In einem duesterene Saeulengang");
  SetProp (P_INT_LONG,
    "Ein breiter, dunkler Gang scheint nach Sueden ins Innere der Insel "+
    "zu fuehren. Rechts und links des Ganges stehen schwarze, mit duennen "+
    "roetlichen Adern durchzogene Marmorsaeulen, anfangs kaum huefthoch, "+
    "die jedoch nach Sueden immer groesser werden und schnell eine Hoehe "+
    "von fast 5 Metern erreichen. Hinter den Saeulen liegen nur dunkle, "+
    "schwarze Felsen, die in gleichem Masse wie die Saeulen ansteigen und "+
    "sich weiter im Sueden ueber dem Gang zu treffen scheinen. Der Boden "+
    "besteht aus reinem, schwarzem Felsgestein, und weit ueber Dir kannst "+
    "Du die steinerne Hoehlendecke erkennen. Im Norden scheint ein "+
    "kleiner Steg ein Stueck auf einen weiten, unterirdischen See "+
    "hinauszufuehren.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"stueck"}),
    "Der Steg scheint einige Meter weit auf den See hinauszufuehren.");
  AddDetail ( ({"meter", "zwergenlaenge"}),
    "Ein Meter ist fast eine ganze Zwergenlaenge.");
  AddDetail ( ({"himmel"}),
    "Den wirst Du hier unten sicher vergeblich suchen.");
  AddDetail ( ({"masse"}),
    "Damit ist gemeint, dass die Felsen gleich schnell ansteigen wie die "+
    "Saeulen.");
  AddDetail ( ({"see"}),
    "Im Norden kannst Du den weiten, unterirdischen See ausmachen, der die "+
    "ganze Insel umgibt. Still und glatt liegt er da.");
  AddDetail ( ({"steg"}),
    "Ein schmaler Steg scheint im Norden ein Stueck auf den See "+
    "hinauszufuehren, der die Insel umgibt.");
  AddDetail ( ({"marmorsaeulen", "saeulen", "marmosaeule", "saeule"}),
    "Schwarze, mit duennen roetlichen Adern durchzogene Marmorsaeulen "+
    "stehen zu beiden Seiten des Ganges. Nach Sueden hin werden sie immer "+
    "groesser und erreichen bald eine Hoehe von fast 5 Metern. Hinter den "+
    "Saeulen liegen dunkle Felsen, die nur grob behauen wurden. Es scheint "+
    "so, als waeren auch die Saeulen direkt aus diesem Fels herausgehauen.");
  AddDetail ( ({"boden"}),
    "Der Boden des Ganges besteht aus grob behauenem, schwarzen "+
    "Felsgestein.");
  AddDetail ( ({"gang"}),
    "Die Saeulen links und rechts von Dir bilden einen Gang, der im Sueden "+
    "direkt in den dunklen Felsen zu verschwinden scheint.");
  AddDetail ( ({"hoehe"}),
    "Waehrend die Saeulen anfangs kaum huefthoch sind, erreichen sie doch "+
    "nach Sueden hin schnell eine Hoehe von fast 5 Metern, bis sie weit im "+
    "Sueden mit den Felsen verschmelzen.");
  AddDetail ( ({"innere", "inneres"}),
    "Der dunkle Gang scheint geradewegs in das Innere der Insel zu "+
    "fuehren.");
  AddDetail ( ({"insel"}),
    "Eine dunkle, bedrohlich wirkende Insel, die vollstaendig aus "+
    "schwarzem Felsgestein zu bestehen scheint.");
  AddDetail ( ({"seite", "seiten"}),
    "Zu beiden Seiten des Weges stehen schwarze, mit duennen roetlichen "+
    "Adern durchzogene Marmorsaeulen.");
  AddDetail ( ({"weg"}),
    "Ein dunkler Gang, der von dem schmalen Steg im Norden nach Sueden hin "+
    "ins Innere der Insel zu fuehren scheint.");
  AddDetail ( ({"ader", "adern", "marmor"}),
    "Duenne, roetliche Adern durchziehen den Marmor. Als Du naeher "+
    "hinsiehst, scheint es Dir fast, als wuerden die Adern pulsieren, als "+
    "waeren sie tatsaechlich mit Blut gefuellt!");
  AddDetail ( ({"blut"}),
    "Du ueberwindest Dich, die Saeulen zu beruehren - und zuckst zurueck! "+
    "Zwar ist die Saeule massiv, doch sie fuehlt sich warm an und die Adern "+
    "scheinen fast zu pulsieren.");
  AddDetail ( ({"fels", "felsen", "felsengestein", 
                "felsgestein", "gestein"}),
    "Die gesamte Insel scheint aus dunklem, fast schwarzen Felsgestein zu "+
    "bestehen.");
  AddDetail ( ({"decke", "hoehlendecke"}),
    "Weit ueber Dir woelbt sich die felsige Hoehlendecke.");
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./isteg");
  AddExit ("sueden", "./sgang2");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
