#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"
#include "../../dungeon.h"


#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)

#endif
inherit NEKRO_ISLAND_DIR "room/std_yaq_monoq";

int pyrda;

object resetpyr;

string* raufgeher = ({});

void create()
{
  ::create();
  pyrda=1;
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, -1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE: 14]) );
  SetProp (P_INT_SHORT, "In einer Gruft");
  SetProp (P_NOBARRIER, 1);
  SetProp (P_INT_LONG, 
      "Als Du in die Gruft faellst schliesst sich ueber Dir der Boden "
      "wieder, der hier ja nun die Decke bildet. Es sieht so aus als "
      "ob Du nicht so einfach hier heraus kommst. In der Gruft ist es "
      "duester. Nur eine kleine Fackel haengt an einer Wand. Es stinkt "
      "widerlich nach faulen verwesenden Resten von Elfen oder Menschen. "
      "Ueberall liegen Stummel von Menschen, Elfen und Feen und anderen "
      "Lebewesen. Ueberreste die angefressen wurden und dann liegen "
      "gelassen wurden. Zerstoerte Ruestungen und Waffen liegen herum, "
      "fuer die dieses graessliche Wesen, was hier haust, wohl keine "
      "Verwendung hat. An der Ostwand neben der Treppe haengen mehrere "
      "Ketten herunter.");

  // ROOM DESCRIPTION END

  // DETAILS START

  AddDetail( ({ "gruft"}),
      "Die Gruft ist nur durch eine einzige Fackel erleuchtet und daher "
      "erkennst Du nicht besonders viel.");
  AddDetail( ({ "fackel"}),
      "An einer Wand haengt eine kleine Fackel in einer Halterung. "
      "Die Fackel kann die Gruft nur spaerlich erhellen.");
  AddDetail( ({ "boden"}),
      "Der Boden, durch den Du heruntergefallen bist, ist ploetzlich "
      "wieder geschlossen, eine maechtige Magie muss hier walten. "
      "In einer Ecke liegen ein paar aufgehaeufte Knochen.");
  AddDetail( ({ "magie"}),
      "Nur durch Magie kann sich der Boden wieder geschlossen haben.");
  AddDetail( ({ "decke"}),
      "Durch die Decke bist Du in die Gruft gefallen, sie ist ziemlich "
      "hoch und Du kannst sie nicht besonders gut erkennen. Aber wenn "
      "Du koenntest mal versuchen sie abzutasten.");
  AddDetail( ({ "wand"}),
      "An einer Wand haengt eine kleine Fackel, die die Gruft nur wenig "
      "erhellt.");
   AddDetail( ({ "resten"}),
      "Es stinkt hier ueberall nach den Resten der Elfen und Menschen oder "
      "was diese auch immer waren. Es stinkt nach Moder und Faeulnis.");
   AddDetail( ({ "Elfen"}),
      "Ob die Reste wirklich von Elfen abstammen kann man eigendlich nicht "
      "mehr erkennen.");
   AddDetail( ({ "feen"}),
      "Da hier einige Feenfluegel herum liegen, ist es moeglich, dass sich "
      "dieses graessliche Wesen an ihnen bedient hat.");
   AddDetail( ({ "feenfluegel", "fluegel"}),
      "Durch die Feenfluegel kannst Du darauf schliessen das sich etwas "
      "an ihnen bedient hat.");
   AddDetail( ({ "menschen"}),
      "Nur durch die Ruestungen und Waffen kann man erkennen das die "
      "Reste hier auch von Menschen stammen.");
   AddDetail( ({ "reste"}),
      "Die Reste der Menschen, Feen und Elfen stinken erbaermlich. "
      "Du vernimmst ein leises schmatzendes Geraeusch.");
   AddDetail( ({ "halterung"}),
      "In der Halterung steckt eine kleine, wenig erhellende Fackel.");
   AddDetail( ({ "lebewesen"}),
      "Kaum ein Lebewesen, was hier herunter gefallen ist, hat eine "
      "Moeglichkeit gefunden wieder heraus zukommen.");
   AddDetail( ({ "moeglichkeit"}),
      "Vielleicht findest Du ja doch eine Moeglichkeit Dich aus Deinem "
      "Grab zu befreien.");
   AddDetail( ({ "grab"}),
      "Solltest Du keine Moeglichkeit finden wird diese Gruft Dein Grab.");
   AddDetail( ({ "treppe"}),
      "Die Treppe fuehrt an die Stelle wo Du in die Gruft gefallen bist, "
      "aber Du kannst nichts endecken, was Dir ein hinaus kommen ermoeglicht. "
      "Oder Du versuchst mal hoch zurennen?");
   AddDetail( ({ "stelle"}),
      "Die Stelle an der Decke, durch die Du hindurch gefallen bist, ist wieder "
      "geschlossen.");
   AddDetail( ({ "ecke"}),
      "In der einer Ecke liegen ein paar Knochen herum, was Dir seltsam erscheint. "
      "Sie sind zu einem Haufen geschichtet.");
   AddDetail( ({ "haufen"}),
      "Der Haufen in der Ecke besteht aus Knochen.");
   AddDetail( ({ "knochen"}),
      "Die aufgehaeuften Knochen sehen aus, als ob sie dort bewusst gestapelt werden.");
   AddDetail( ({ "ostwand"}),
      "An der Ostwand haengen mehrere Ketten in einer seltsamen Anordnung herunter.");
   AddDetail( ({ "anordnung"}),
      "Die Anordnung der Ketten ist versetzt. Wozu das wohl dient?");
   AddDetail( ({ "ketten"}),
      "Es sind sechs Ketten die an der Ostwand herunter haengen, eine siebte ist ziemlich "
      "weit oben und in ihr steckt ein grosser Knochen mit einer Skeletthand die in einer "
      "Schlinge aus Eisen steckt. An jeder der Ketten haengt eine solche Schlinge.");
   AddDetail( ({ "schlinge"}),
      "Eine Schlinge aus Eisen in denen man Menschen oder Elfen oder aber auch andere "
      "Lebewesen angekettet hat.");
   AddDetail( ({ "eisen"}),
      "Kaltes Eisen aus dem die Schlinge hergestellt wurde.");
   AddDetail( ({ "skeletthand", "hand"}),
      "Die Skeletthand ist einer der Reste von einem angeketteten Lebewesen, welches keine "
      "Moeglichkeit gefunden hatte um aus der Gruft zu entkommen. Du koenntest sie ja mal "
      "greifen?");
   AddDetail( ({ "stummel"}),
      "Die Stummel der hier ermordeten Lebewesen liegen ueberall in der Gruft verteilt, "
      "auf dem Boden herum.");
   AddDetail( ({ "ruestungen"}),
      "Nur durch die Ruestungen kann man erkennen das die Reste auf dem Boden von Menschen "
      "oder Elfen und auch Feen stammen.");
   AddDetail( ({ "waffe"}),
      "Fuer Dich waere es besser wenn Du eine Dich schuetzende Waffe bei Dir traegst.");
   AddDetail( ({ "wesen"}),
      "Begegne diesem Wesen und Dein Leben ist ausgehaucht.");
   AddDetail( ({ "leben"}),
      "Dein Leben ist nur noch von kurzer dauer, wenn Du nicht eine Moeglichkeit findest "
      "die Gruft zu verlassen.");
   AddDetail( ({ "nase"}),
      "Vielleicht benutzt Du ja Deine Nase mal zum riechen?");
   AddDetail( ({ "ohr"}),
      "Untersuch nicht herum, lausch mit Deinem Ohr.");
   AddDetail( ({ "atem"}),
      "Dein Atem ist hier nicht zu sehen.");
   AddDetail( ({ "verwendung"}),
      "Fuer die Ruestungen und Waffen, hat das Wesen keine Verwendung.");

  
   AddSpecialDetail( ({ "treppe"}),"detailTreppe" );

   
  AddSmell(DEFAULT_SMELL,
      "Der Geruch von Moder und Faeulnis ist hier unausstehlich.");
  AddSmell( ({"gestank", "geruch", "gerueche"}),
      "Der Geruch von Moder und Faeulnis lassen Dich fast erbrechen.");
  AddSmell( ({"moder"}),
      "Der Moder beisst Dir richtig in der Nase. Atme ja nicht tief ein.");
  AddSmell( ({ "faeulnis"}),
      "Die Faeulnis die hier sehr stark zu riechen ist, raubt Dir den Atem.");
  AddSound(DEFAULT_SOUND,
      "Ein schmatzendes Geraeusch dringt an Dein Ohr.");
  AddSound( ({ "geraeusch", "geraeusche", "ferne"}),
      "Hoert sich an als ob irgend ein Wesen etwas frisst.");
 

  // DETAILS END

  // EXITS START
  //  SetExit (WESTEN);
  //  SetExit( "raus", ROOM "/d/unterwelt/nekromanten/room/yaq_monoq/b3"); 
  // EXITS END
     
  AddCmd( "taste", "tasten", "taste" );
  AddCmd ( ({"renne", "renn" }), "rennen" );
  AddCmd( ({"atme"}), "acid_dam");  
  // ITEMS START
  // ITEMS END
  
}
int acid_dam(string str) {
  if(!str) return 0;
  if(str!="tief ein") return 0;
  write("Tief atmest Du ein. Die Saeure aetzt Dir die halbe Lunge weg!\n");
  say(BS(sprintf("%s bekommt einen irren Blick und atmet tief ein.", 
          TP->Name(WER))));
  do_room_damage(TP, random(30)+1, "Zwei aufgeloeste Lungenfluegel");
  return 1;
}
string detailTreppe()
{
  if (!present("HIRIPYR",TO))
    return("Du versuchst die Treppe rauf zu rennen um hier endlich "
           "raus zu kommen. Was ist das? Da war doch was? Renn doch "
	   "nochmal die Treppe rauf.\n");
  return("Du musst Dich wohl getaeuscht haben, hier ist nichts.\n");
}
void reset()
{
  int i;

  ::reset();
  pyrda=1;
  resetpyr=present("HIRIPYR",TO); 

  if(i = sizeof(raufgeher))
  for(i; i >= 0; i--)
  {
    if(!present(raufgeher[i]))
      raufgeher -= ({raufgeher[i]});
  }
}

int rennen (string str)
{
  object pyr;
  notify_fail ("Was moechtest Du machen?\n");

  if(!str || str == "") return 0;
  if(!(str == "treppe"         ||
       str == "treppe rauf"  )) return 0;
  if (present("HIRIPYR",TO) || !pyrda)

  {
    write(BS("Du kannst gerade nichts erkennen."));
    return -1;
  }
  write(BS("Du rennst die Treppe hinauf aber irgendwas kommt ploetzlich hervor. "
           "Vor Schreck faellst Du die Treppe wieder herunter Du drehst Dich um "
	   "und schaust einem Drachen in die Fratze. Wieso hast Du ihn nicht "
	   "bemerkt?\n"));
  pyrda=0;
  pyr = clone_object ( NEKRO_ISLAND_NPC "drache");
  pyr->move(TO,M_GO|M_NOCHECK,"stampft");
  pyr->AddHp(-500);
  return 1;


}


int tasten(string str)
{
   notify_fail("Was moechtest Du abtasten?\n");
   if ( member( ({ "decke", "decke ab" }),str) != -1) 
  {
    write(BS( "Du gehst die Treppe ein Stueck hinauf und tastest die Decke "
           "ab und bemerkst wie langsam Sand und Erdegemisch anfaengt "
	   "herunter zu rieseln. Ob das eine gute Idee war?\n" ));
    say( TPN+" tastet die Decke ab und Sand und ein Erdegemisch rieselt "
	     "herunter.\n");
    
    if ( member(raufgeher, getuid(TP)) == -1)
    {
      raufgeher += ({getuid(TP)});
      call_out("fall1",4, getuid(TP));
    }
    return 1;
  }
}


void fall1(string tpuid)
{
  if (!objectp(TP) || ENV(TP)!=TO ) 
  {
    raufgeher -= ({tpuid});
    return;
  }
  write(BS( "Als Du merkst das die Decke droht nachzugeben, gruebelst Du "
	    "fuer einen Moment was nun besser ist. Stehen bleiben oder "
	    "die Treppe wieder runter rennen?" ));
  call_out("fall2",4, tpuid);
  return;
}


void fall2(string tpuid)
{
  raufgeher -= ({tpuid});
  if (!objectp(TP) || ENV(TP)!=TO ) 
    return;
  TP->AddHp(-20);
  write (BS( "Der Moment war zu lang, Dir faellt die Decke auf den Kopf. "
	     "Du siehst eine Oeffnung und nutzt die Chance um "
	     "durch die Oeffnung zu kriechen.") );
  TP->move("/d/unterwelt/nekromanten/room/yaq_monoq/c3", M_GO|M_NOCHECK|M_SILENT);
  tell_object(TP,BS(
    "Du kriechst erleichtert aus der Gruft und scheinst wieder Frei zu sein."));
  tell_room(ENV(TP),BS(
    TP->Name()+" kriecht aus einer Oeffnung im Boden herein."),({TP}));
}

