#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/yaq_monoq/"+x)
#endif

inherit NEKRO_ISLAND_DIR "room/std_cliff_room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_INT_LONG, "Du stehst auf einer Klippe aus schwarzem Gestein. Der "
      "Boden unter Dir ist hart und karg, nur einige verdreht verkrueppelte "
      "Baeume wachsen hier. Unter den Klippen befindet sich der Saeuresee, "
      "nagt zischend an dem Gestein, als wolle er die Insel verschlingen. "
      "Am Boden liegen etliche Brocken des schwarzen Gesteins. Aus Deinen "
      "Augenwinkeln heraus kannst Du ganz leichte Bewegungen ausmachen, die "
      "von diesen Brocken zu kommen scheint. Als Du etwas genauer hinsiehst, "
      "kannst Du allerdings keine Bewegungen erkennen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"augenwinkeln"}),
    "Du haettest schwoeren koennen, dass die Brocken sich bewegt haben.");  
  AddDetail ( ({"baeume"}),
    "Seltsam verkrueppelt und verdrehte Baeume wachsen hier. Die Rinde "
    "dieser Baeume ist komplett schwarz und von seltsamen Pusteln ueber"
    "zogen.");
  AddSpecialDetail( ({"rinde"}), 
    "examine_tree");
  AddSpecialDetail( ({"pusteln"}),
    "examine_tree");  
  AddDetail ( ({"boden"}),
    "Der Boden besteht aus harter schwarzer Erde. Etlich Brocken eines "
    "schwarzen Gesteins liegen herum.");
  AddDetail ( ({"erde"}),
    "Tot. Verbrannt. Schwarz.");
  AddDetail ( ({"decke"}),
    "Die Decke ist weit ueber Dir. Die grosse Hoehle ist wie eine Kuppel "
    "geformt und besteht aus pechschwarzem Gestein.");
  AddDetail ( ({"kuppel"}), 
    "Weit ueber Dir erstreckt sie sich ueber Dir. Ein beklemmendes Gefuehl "
    "beschleicht Dich, denn sie ueberspannt Dich wie eine gewaltige Hand!");
  AddDetail ( ({"hoehle"}),
    "Obwohl die Hoehle riesengross ist, ergreift Dich ein beklemmendes "
    "Gefuehl.");   
  AddDetail ( ({"gefuehl"}),
    "Die Hoehle ist zwar riesig, aber Du bist Dir sicher, dass sie durch eine "
    "unheilige Macht entstanden ist.");  
  AddDetail ( ({"macht"}),
    "Du erschauderst vor Ehrfurcht wenn Du daran denkst.");  
  AddDetail ( ({"ehrfurcht"}),
    "Ja, die solltest Du auch haben.");  
  AddDetail ( ({"hand"}),
    "Du hast Angst.");
  AddDetail ( ({"angst"}),
    "Du spuerst das Dich Dein Schicksal hier unten erwarten wird.");
  AddDetail ( ({"schicksal"}),
    "Wer weiss ... ?");
  AddSpecialDetail ( ({"bewegung"}),
    "examine_tree");  
  AddDetail ( ({"brocken"}),
    "Diese pechschwarze Brocken liegen direkt neben den Baeumen. Du bist Dir "
    "nicht sicher, aber Du glaubst vorher eine Bewegung gesehen zu haben.");
  AddDetail ( ({"waende", "wand"}),
    "Hier siehst Du keine Waende.");  
      


  // DETAILS END

  // EXITS START
  SetExit (SUEDWESTEN);
  SetExit (SUEDOSTEN);
  // EXITS END

  // ITEMS START
  AddItem(({ NEKRO_ISLAND_NPC "skelettmagier",
            NEKRO_ISLAND_NPC "nekromant"}),
            REFRESH_DESTRUCT);
  // ITEMS END

}

nosave string examine_tree(string key) {
   string txt;
   txt="";
   if(key=="rinde") {
     txt="Die Rinde des verkrueppelten Baumes ist komplett schwarz und "
       "von merkwuerdigen Pusteln ueberzogen. Sie scheinen sich leicht "
       "zu bewegen.";
     if(!random(3)) {
       txt+=" Als Du die Rinde untesuchst, peitscht ein Ast heran und "
         "trifft Dich hart!"; 
       tell_room(ME, BS(sprintf("Als %s einen der verkrueppelten Baum "
         "untersucht peitscht ploetzlich ein Ast heran und "
         "trifft %s hart!", TP->name(WER), TP->QueryPronoun(WEN,1))),({TP}));
       call_out("do_room_damage", 0, TP, random(10)+5, 
           "Ein verkrueppelter Baum");
     }
     return BS(txt);
   }
   if(key=="pusteln") {
     txt="Die Pusteln bedecken die komplette Rinde der Baeume. Sie fuehlen "
       "sich sehr weich an. Dich schaudert.";
     if(!random(10)) {
       txt+=" AUA! Du spuerst ein Stechen in deiner Hand, mit der Du ueber "
         "die Pusteln gestrichen bist!";
       tell_room(ME, BS(sprintf("%s zuckt etwas zurueck, als er die Pusteln "
         "an den Rinden der Baeume untersucht.", TP->Name(WER,1))),
         ({TP}));
       TP->AddPoison(5);
       call_out("do_room_damage", 0, TP, random(5)+5, "Ein kleiner Stich");
     } 
     return BS(txt);
   }   
   if(key=="bewegung") {
     txt="Diese pechschwarze Brocken liegen direkt neben den Baeumen. Du "
       "bist Dir nicht sicher, aber Du glaubst vorher eine Bewegung "
       "gesehen zu haben.";
     if(!random(4)) {
       txt+="Als Du die Brocken untersuchst, peitscht ploetzlich ein Ast heran "
         "und trifft Dich schwer!";
       tell_room(ME, BS(sprintf("Als %s die Brocken genauer untersucht wird "
              "%s vom Ast eines der Baeume getroffen!", TP->name(WER,1),
              TP->QueryPronoun(WER,1))), ({TP}));
       call_out("do_room_damage", 0, TP, random(10)+5, 
           "Ein verkrueppelter Baum");
     }
     return BS(txt);
   }
}

