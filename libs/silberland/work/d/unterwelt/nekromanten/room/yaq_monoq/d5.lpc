#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit NEKRO_ISLAND_DIR "room/std_cliff_room";

nosave private int reaper=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_INT_LONG, "Dein Blick faellt auf einen leblosen Baum, besser "
      "gesagt den verkrueppelten Rest eines Baumes. Der Boden hier ist "
      "karg und besteht zu grossen Teilen aus Fels, vermischt mit ein "
      "paar Flecken geschwaerzter Erde, aus dem der Baum herausgewachsen "
      "ist. Weit ueber Dir spannt sich die Kuppel der Hoehle und vermittelt "
      "Dir ein beaengstigendes Gefuehl der Eingeschlossenheit.");
  // ROOM DESCRIPTION END
  AddDetail( ({ "baum" }), 
      "Irgendwann muss dieser Baum einmal gelebt haben, nun existiert nur "
      "noch ein verkrueppelter Stumpf. ");
  AddDetail( ({"rest"}),
      "Viel mehr als ein Rest existiert nicht mehr von dem Baum.");
  AddSpecialDetail( ({"stumpf", "baumstumpf"}), "examine_reaper");
  AddDetail( ({"eingeschlossenheit"}),
      "Ein beklemmendes Gefuehl, nicht?");
  AddDetail ( ({"gefuehl"}),
      "HARHAR!");
  AddDetail( ({"blick"}),
      "Der Baum ist immer noch da wo Du ihn vorher erblickt hast. "
      "Vielleicht solltest Du ihn genauer untersuchen?");
  AddDetail( ({"boden"}),
      "Der Boden besteht zu grossen Teilen aus hartem, schwarzem Fels. "
      "Ein paar Flecken bestehen aus schwarzer verbrannter Erde. Der "
      "Baumstumpf steht auf einem dieser Flecken.");
  AddDetail( ({"flecken"}),
      "Die Flecken bestehen aus schwarzer, verbrannter Erde.");
  AddDetail( ({"erde", "krumen"}),
      "Die Erde scheint komplett verbrannt zu sein. Sie ist rabenschwarz "
      "und ausgedoerrt, liegt in schwarzen Krumen am Boden.");
  AddDetail( ({"fels"}),
      "Der Fels ist kalt und schwarz. Der groesste Teil der Insel besteht "
      "aus diesem Fels.");
  AddDetail( ({"insel"}),
      "Du befindest Dich darauf. Schau Dich doch um!");
  AddDetail( ({"teilen", "teile"}),
      "Nicht alles hier ist kahler Fels. Manche Teile des Bodens sind hier schwarze "
      "und verbrannte Erde.");
  AddDetail( ({ "teil"}),
      "Der groesste Teil der Insel besteht aus kaltem, schwarzem Fels.");
  AddDetail( ({ "bodens"}),
      "Bodens, damit ist der Boden gemeint.");

  // DETAILS START
  // DETAILS END

  // EXITS START
  SetExit (OSTEN);
  SetExit (SUEDWESTEN);
  SetExit (WESTEN);
  // EXITS END

  // ITEMS START
  // ITEMS END

}

void reset() {
  ::reset();
  reaper=1;
}

string examine_reaper() {
  if(!reaper)
    return BS("Der Stumpf des Baumes ist fast hart wie Stein. Seltsam, "
        "was mag dem Baum passiert sein?");
  call_out("clone_reaper",0);
  reaper=0;
  return BS("Als Du Dich dem Stumpf naeherst, schnellen etliche Tentakel "
      "hervor und versuchen Dich zu packen! Der Stumpf erhebt sich und "
      "Du erblickst eine daemonische Baumkreatur mit gluehenden Augen.");
}

void clone_reaper() {
  object _reaper;
  _reaper=clone_object(NEKRO_ISLAND_NPC "reaper");
  _reaper->SetProp(P_AGGRESSIVE, ([P_GUILD:(["nekromanten":0.0, 0:1])]));
  _reaper->move(ME, M_NOCHECK|M_SILENT);
  return;
}
