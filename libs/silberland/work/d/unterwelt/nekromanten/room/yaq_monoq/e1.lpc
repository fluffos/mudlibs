#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/yaq_monoq/"+x)
#endif

inherit NEKRO_ISLAND_DIR "room/std_yaq_monoq";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "In einer dunklen Kuppel");
  SetProp (P_INT_LONG,
    "Der dunkle Saeulengang oeffnet sich hier in eine gigantische Kuppel, "+
    "die sich weit ueber Deinen Kopf spannt. In der Mitte der Kuppeldecke "+
    "ist ein grosses Loch, aus dem ein riesiger Saeurefall herabgestuerzt "+
    "kommt. In der Mitte des Saeurefalls kannst Du eine weisse "+
    "Wendeltreppe aus bleichen Knochen erkennen, die zwischen den "+
    "Saeuremassen in die Hoehe fuehrt. Ein schmaler Steinsteg fuehrt quer "+
    "von Nord nach Sued durch die Kuppel, jeweils an seinem Ende sind "+
    "Ausgaenge in dunkle Saeulengaenge zu erkennen. Seltsamerweise teilt "+
    "sich der Saeurefall kurz ueber dem Steg, so dass man ihn unbeschadet "+
    "durchschreiten kann. Neben dem Steg stuerzt die Saeure weiter in "+
    "unbekannte Tiefen, die in der Dunkelheit verschwinden. Ein dichter "+
    "Saeurenebel steigt von unten herauf und macht das Atmen schwer, und "+
    "das Rauschen ist hier ohrenbetaeubend.");
  // ROOM DESCRIPTION END

  RemoveDetail(0);
  // DETAILS START
  AddDetail ( ({"ausgaegne", "ausgang", "ende",
                "enden", "nordende", "suedende", "blick",
                "gang", "gaenge", "saeulengang", "saeulengaenge"}),
    "Die beiden Ausgaenge am Nord- und Suedende der Kuppel sind dunkle "+
    "Gaenge, die direkt in den Fels gehauen zu sein scheinen. Schon nach "+
    "wenigen Metern verliert sich Dein Blick in der Dunkelheit.");
  AddDetail( ({ "metern"}),
    "Schon nach wenigen Metern verliert sich Dein Blick in der Dunkelheit.");
  AddDetail ( ({"rauschen"}),
    "Vielleicht solltest Du mal hinhoeren?");
  AddSound ( ({DEFAULT_SOUND, "rauschen"}),
    "Der Saeurefall verursacht bei seinem Sturz ein ohrenbetaeubendes "+
    "Rauschen.");
  AddDetail ( ({"sturz", "tiefe", "tiefen"}),
    "Die Saeuremassen stuerzen zu beiden Seiten des schmalen Steinsteges "+
    "in unbekannte Tiefen, die sich in der Dunkelheit verlieren.");
  AddDetail ( ({"ausgaenge", "ausgang"}),
    "Am Ende des Steinsteges sind im Norden und Sueden jeweils Ausgaenge "+
    "zu erkennen, welche in dunkle Saeulengaenge fuehren.");
  AddDetail ( ({"fels", "felsen", "felsgestein",
                "gestein"}),
    "Die gesamte Hoehle besteht aus dunklem, fast schwarzem, "+
    "lichtschluckenden Felsgestein.");
  AddDetail ( ({"decke", "hoehle", "kuppel",
                "kuppeldecke", "ursprung"}),
    "Wie eine gewaltige Kuppel wird diese Hoehle von einer steinernen "+
    "Decke ueberspannt. Im Gegensatz zu den beiden Saeulengaengen, die aus "+
    "der Kuppel herausfuehren, scheint die Kuppel selbst natuerlichen "+
    "Ursprungs zu sein.");
  AddDetail( ({"gegensatz"}),
    "Im Gegensatz zu den beiden Saeulengaengen scheint die Kuppel selbst "+
    "natuerlichen Ursprungs zu sein.");
  AddDetail ( ({"hoehe", "knochentreppe", "treppe",
                "wendeltreppe"}),
    "In der Mitte des Saeurefalls fuehrt eine weisse Wendeltreppe aus "+
    "bleichen Knochen in die Hoehe, in den Felsen hinauf. Vielleicht kann "+
    "man ueber diese Treppe an die Oberflaeche des Silberlandes gelangen.");
  AddDetail ( ({"oberflaeche", "vorstellung"}),
    "Du kannst Dir keine richtige Vorstellung davon machen, wie weit unter "+
    "der Oberflaeche des Silberlandes Du Dich hier befinden musst. "+
    "Vielleicht kannst Du ueber die knoecherne Wendeltreppe in der Mitte "+
    "der Kuppel ja nach oben gelangen.");
  AddDetail ( ({"boden", "abgrund"}),
    "Die Hoehle scheint keinen Boden zu besitzen; jedenfalls kannst Du "+
    "rechts und links des Steges nur einen scheinbar unendlichen Abgrund "+
    "erkennen, in dem die Saeuremassen in der Dunkelheit verschwinden.");
  AddDetail ( ({"steg", "steinsteg"}),
    "Ein schmaler, gelaenderloser, leicht nach oben gebogener Steinsteg "+
    "fuehrt quer von Nord nach Sued durch die gewaltige Kuppel und "+
    "verbindet so ihre beiden Ausgaenge. Er scheint aus dem gleichen, "+
    "schwarzen Gestein zu sein, wie der Rest der Hoehle, allerdings ist er "+
    "sicherlich nicht natuerlichen Ursprungs, dazu ist er zu exakt geformt. "+
    "Du kannst allerdings auch keinerlei Spuren erkennen, die auf eine "+
    "Bearbeitung des Steges hindeuten wuerden. In der Mitte des Steges, wo "+
    "der Saeurefall zu beiden Seiten vorbeirauscht, ist eine kleine, runde "+
    "Plattform, welche nur vom Steg getragen zu werden scheint, und von der "+
    "die bleiche Wendeltreppe nach oben fuehrt.");
  AddDetail( ({"rest"}),
    "Auch der Rest der Hoehle ist aus schwarzem Gestein.");
  AddDetail( ({"seiten"}),
    "Zu beiden Seiten des Steges rauscht der Saeurefall vorbei.");
  AddDetail ( ({"bearbeitung", "spur", "spuren"}),
    "Du erkennst keine Spur einer Bearbeitung an dem schmalen Steinsteg. "+
    "Dir ist ebenso unklar, wie er entstanden sein koennte, wie Dir unklar "+
    "ist, wie dieser schmale Steg halten und auch noch die knoecherne "+
    "Treppe tragen kann.");
  AddDetail ( ({"dunkelheit"}),
    "Weder in der Tiefe noch in der Dunkelheit in den beiden "+
    "Saeulengaengen kannst Du etwas erkennen.");
  AddDetail ( ({"atem", "atmen"}),
    "Der dichte Saeurenebel, der von unten heraufzieht, macht Dir das "+
    "Atmen schwer.");
  AddDetail ( ({"knochen", "lebewesen"}),
    "Die weisse Wendeltreppe besteht aus grossen, bleichen Knochen - Du "+
    "kannst leider nicht erkennen, von welchem Lebewesen diese Knochen "+
    "stammen koennten, aber jedenfalls scheint die Saeure ihnen nichts "+
    "anzuhaben.");
  AddDetail ( ({"hals", "kopf", "schultern"}),
    "Zwischen Deinen Schultern, direkt auf Deinem Hals findest Du Deinen "+
    "Kopf.");
  AddDetail ( ({"loch"}),
    "In der Mitte der Kuppeldecke ist ein grosses Loch, aus dem der "+
    "riesige Saeurefall herabgestuerzt kommt.");
  AddDetail( ({"mitte"}),
    "Durch ein Loch in der Mitte der Kuppel, kommt ein Saeurefall "+
    "herabgestuerzt.");
  AddDetail ( ({"plattform"}),
    "In der Mitte des Steges befindet sich eine kleine Plattform, von der "+
    "aus die Treppe in die Hoehe fuehrt.");
  AddDetail ( ({"massen", "saeure", "saeurefall",
                "saeuremassen", "saeure"}),
    "Riesige Massen Saeure stuerzen in einem grossen Saeurefall aus einem "+
    "Loch in der Mitte der Kuppeldecke und verschwinden nach unten in der "+
    "Dunkelheit.");
  AddDetail ( ({"silberland", "welt"}),
    "Hier unten in der Dunkelheit ist Dir nicht ganz klar, warum sich "+
    "diese Welt Silberland nennt.");
  AddDetail ( ({"felswaende", "felswand", "waende", 
                "wand"}),
    "Die Waende der riesigen kuppelfoermigen Hoehle bestehen aus massivem, "+
    "dunklen Felsgestein.");
  AddDetail ( ({"nebel", "saeurenebel"}),
    "Ein dichter Saeurenebel steigt aus der Tiefe empor und macht Dir das "+
    "Atmen schwer.");
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./sgang3");
  SetExit (SUEDEN);
  AddExit ("oben", ([ EX_DEST: NEKRO_CONNECTROOM_ZINSEL,
                      EX_MSG: "die Treppe nach oben",
                      EX_MSG_OUT: "geht vorsichtig",
                      EX_FUNC: "go_up",
           ]));
  // EXITS END

  // ITEMS START
  AddItem( ({NEKRO_ISLAND_NPC "skelett",
            NEKRO_ISLAND_NPC "skelettmagier",
            NEKRO_ISLAND_NPC "nekromant"}),
            REFRESH_DESTRUCT);
  // ITEMS END

}

int go_up(string dir) {
  tell_object(TP, BS("Du gehst vorsichtig die Treppe nach oben. Doch schon "
        "nach wenigen Schritten wird Dir schwarz vor Augen ..."));
  tell_room(ME, BS(sprintf("%s geht nach oben. Kaum ist er Deinen Augen "
          "entschwunden faellt %s wieder herein.",
          TP->Name(WER), TP->QueryPronoun(WER), TP->QueryPronoun(WER))),
      ({TP}));
  TP->AddHp(-random(30));
  return 1;
}
          
