#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "In einem duesteren Saeulengang");
  SetProp (P_INT_LONG,
    "Du stehst in einem dunklen, unheimlichen Gang, der nach Sueden "+
    "geradewegs ins Innere der Felseninsel zu fuehren scheint. Rechts und "+
    "links des Ganges, vor den dunklen Felswaenden steht eine Reihe von "+
    "hohen, schwarzen, mit duennen roten Adern durchzogenen "+
    "Marmorsaeulen. Die Felswaende treffen sich ueber Dir und bilden eine "+
    "massive Decke, die von den Saeulen gestuetzt zu werden scheint. Der "+
    "Gang nach Sueden ist also mehr eine grosse Hoehle. Der Boden scheint "+
    "direkt aus dem schwarzen Felsgestein gehauen zu sein. Nach Norden "+
    "scheint der Gang zum Ufer des unterirdischen Sees zu fuehren.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"felswaende", "felswand", "waende",
                "wand"}),
    "An den Felswaenden links und rechts des Ganges stehen hohe, schwarze, "+
    "von duennen roten Adern durchzogene Marmorsaeulen. Die Waende selbst "+
    "dahinter sind nur grob behauen und treffen sich ueber Dir zu einer "+
    "massiven Decke, die von den Saeulen gestuetzt zu werden scheint, so "+
    "dass der Gang nach Sueden hin eine Hoehle bildet, waehrend er nach "+
    "Norden hin eher einem offenen Saeulengang gleicht.");
  AddDetail ( ({"gang", "hoehle", "saeulengang", "felshoehle", "weg"}),
    "Nach Norden hin gleicht der Gang einem offenen Saeulengang ohne "+
    "Decke, waehrend er nach Sueden eher einer von Saeulen gestuetzten "+
    "Felshoehle gleicht. Tief in der Hoehle meinst Du ein roetliches "+
    "Gluehen erkennen zu koennen.");
  AddDetail ( ({"marmorsaeule", "marmorsaeulen", "saeule",
                "saeulen"}),
    "Links und rechts des Ganges stehen hohe, schwarze Marmorsaeulen, die "+
    "von einem Geflecht aus duennen, roten Adern durchzogen werden. Nach "+
    "Norden hin sind die Saeulen nur Zierde, nach Sueden hin scheinen sie "+
    "die gewaltige schwarze Felsdecke zu stuetzen.");
  AddDetail ( ({"fels", "felsen", "felsgestein",
                "gestein"}),
    "Der Boden, die Waende und die Decke sind aus schwarzem, "+
    "lichtschluckenden Felsgestein herausgehauen.");
  AddDetail ( ({"boden", "felsboden"}),
    "Der Boden besteht aus dem gleichen schwarzen Gestein wie die Decke "+
    "und die Waende hinter den Saeulen.");
  AddDetail ( ({"zierde"}),
    "Die Saeulen stehen zwar links und rechts des Gangs, doch sie stuetzen "+
    "nichts.");
  AddDetail ( ({"decke", "felsdecke", "felsendecke"}),
    "Die Waende des Ganges treffen sich ueber Dir und bilden eine massive "+
    "Felsendecke.");
  AddDetail ( ({"see"}),
    "Der Weg nach Norden scheint zum Ufer eines riesigen, unterirdischen "+
    "Sees zu fuehren.");
  AddDetail ( ({"ader", "adern", "geflecht"}),
    "Duenne, blutrote Adern durchziehen die schwarzen Marmorsaeulen an den "+
    "Seiten des Ganges. Es scheint Dir fast, als wuerden die Adern "+
    "pulsieren.");
  AddDetail ( ({"gluehen"}),
    "Vielleicht hast Du Dich auch getaeuscht...");
  AddDetail ( ({"ufer"}),
    "Du erkennst im Norden das Ufer eines unterirdischen Sees.");
  AddDetail ( ({"seite", "seiten", "reihe", "reihen"}),
    "Zu beiden Seiten des Ganges steht eine Reihe von hohen, schwarzen, "+
    "mit einem duennen Geflecht roter Adern durchzogene Saeulen.");
  AddDetail ( ({"felseninsel", "insel"}),
    "Du scheinst Dich auf einer felsigen Insel zu befinden, die inmitten "+
    "eines unterirdischen Sees liegt.");
  AddDetail( ({"innere"}),
    "Hier fuehrt der dunkle Gang geradewegs ins Innere der Felseninsel.");
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./sgang1");
  AddExit ("sueden", "./sgang3");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
