#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit NEKRO_ISLAND_DIR "room/std_beach_room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_BONES, 1);
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_INT_LONG, "Du befindest auf einem Stueck 'Strand' am Saeuresee. "
      "Der aetzende Dampf des Sees raubt Dir fast den Atem, Saeureschwaden "
      "behindern Deine Sicht. Der Strand ist ueber und ueber mit Knochen "
      "bedeckt, sowohl kleinen wie auch grossen, mit teilweise "
      "zersplitterten, die scharftkantig aus dem Boden herausragen. Die "
      "Wellen des Saeuresees haben einen Teil der Knochen, die von ihnen "
      "erfasst wurden, bereits aufgeloest.");
  // ROOM DESCRIPTION END
  AddDetail( ({"stueck" }),
      "Hier ist es noch duesterer als auf dem Rest der Insel. Ueberall sind "
      "Knochen und Knochensplitter verstreut, bilden einen regelrechten "
      "Teppich aus Knochen. ");
  AddDetail( ({"teppich"}),
      "Ein Teppich aus Knochen breitet sich vor Dir aus. Einen Teil davon "
      "hat der Saeuresee bereits aufgeloest. Die Knochen knirschen als "
      "Du Dich auf ihnen bewegst.");
  AddDetail( ({"atem"}),
      "Der Dampf des Saeuresees manifestiert sich in Schwaden, die lautlos "
      "ueber den See gleiten. Da auch sie aus Saeure bestehen - bete das "
      "Du in keine von ihnen geraetst.");
  AddDetail( ({"saeuresee", "see"}),
      "Der See umgibt die komplette Insel, macht jegliche Flucht unmoeglich. "
      "Aufgrund der Saeureschwaden kannst Du nicht mal das andere Ufer "
      "erblicken.");
  AddDetail( ({"insel"}),
      "Du befindest Dich auf ihr!");
  AddDetail( ({"flucht"}),
      "Flucht ist hier unmoeglich. Ueberall lauert der Tod.");
  AddDetail( ({"tod"}),
      "Der Tod ist hier das geringere Uebel was Dir passieren kann. Deiner "
      "Seele droht Schlimmeres.");
  AddSpecialDetail("seele", "checksoul");
  AddDetail( ({"schlimmeres", "uebel"}),
      "Du beschliesst besser nicht darueber nachzudenken.");
  AddDetail( ({"knochensplitter", "splitter", "knochen", "boden", "knochensplittern"}),
      "Ueberall liegen Knochen und Knochensplitter verstreut. Es sind so "
      "viele, dass sie einen regelrechten Teppich bilden, auf dem Du "
      "gerade stehst.");
  AddDetail( ({"saeureschwaden", "schwaden", "sicht", "dampf"}),
      "Die Saeureschwaden behindern Deine Sicht. Auf dem See kannst Du "
      "nicht viel erkennen! Und doch, als sich eine Saeureschwade "
      "vorbeigeschoben hat, vermeinst Du im Suedsuedwesten, draussen "
      "auf dem See, eine kleine Felseninsel zu erkennen.");
  AddDetail( ({"felseninsel"}),
      "Du muesstest schon ein schoenes Stueck Richtung Suedsuedwesten "
      "schwimmen, um sie zu erreichen.");
  AddDetail( ({ "saeure" }),
      "Die Saeure umschliesst die ganze Insel in Form eines Sees. Zischend "
      "und dampfend schwappt sie ans Ufer, zerfrisst hin und da ein paar "
      "Knochen, die dieses Gebiet hier bedecken.");
  AddDetail( ({"form" }),
      "Die Form des Sees kannst Du ueberhaupt nicht erkennen. Saeureschwaden, "
      "die ueber den See ziehen, behindern Deine Sicht.");
  AddDetail( ({"ufer"}),
      "Das Ufer des Saeuresees ist ueber und ueber mit Knochen und "
      "Knochensplittern uebersaeht. Nur wo die Saeure ans Ufer brandet "
      "sind die Knochen von ihr aufgeloest worden.");
  AddSpecialDetail("gebiet", "_query_int_long");
  AddDetail( ({"rest"}),
      "Geh weiter, dann siehst Du den Rest, Du Narr!");
  AddSpecialDetail( "narr", "examine_self");
  AddDetail ( ({"strand"}),
      "Dieser Strand hier ist ueber und ueber mit Knochensplitter und "
      "Knochen uebersaeht. So stellst Du Dir definitiv keinen 'Strand' "
      "vor.");
  AddDetail ( ({"wellen" }),
      "Wellen ist etwas uebertrieben, aber Du bemerkst das der Saeuresee "
      "in Bewegung ist.");
  AddDetail ( ({"bewegung"}),
      "Wer weis was diese Bewegungen ausloest.");
  AddDetail ( ({"teil"}),
      "Die Knochen loesen sich in der Saeure auf, ja. Baden gehen koennte "
      "demnach auch fuer Dich ungesund sein.");

      
  


  

  // DETAILS START
  // DETAILS END

  // EXITS START
  SetExit (NORDOSTEN);
  SetExit (NORDWESTEN);
  // EXITS END

  // ITEMS START
  // ITEMS END

}



string checksoul() {
  if(TP->QueryProp(P_GUILD)=="nekromanten") {
    if(TP->QueryProp(P_GUILD_LEVEL)==7)
      return "Welche Seele? HARHAR!\n";
    return "Seelen! Opfere mehr Seelen!\n";
  }
  if(TP->QueryProp(P_GUILD)=="paladine")
    return "Bei Dusty! Deine werden sie NIEMALS bekommen!\n";
  return "Du hast Deine noch! Danke Woody!\n";
}

string examine_self() {
  return TP->long()+"\n";
}
