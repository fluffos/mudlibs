#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/yaq_monoq/"+x)
#endif

inherit NEKRO_ISLAND_DIR "room/std_cliff_room";

void create()
{

::create();
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));

   SetProp(P_INT_LONG,
     "Du stehst nun am mittleren Hang der Insel. Ueberall liegen Felsen "
     "herum, auch kleine Steinchen sind zu sehen. Alles besteht hier aus "
     "einem schwarzen Gestein, wobei hier nicht einmal die "
     "verkrueppelten Buesche und Baeume wachsen, wie andernorts. "
     "Die Hoehlendecke scheint auch hier besonders turbulent zu sein. "
     "Im Osten, hoch ueber Dir, siehst Du den oberen Rand einer sehr hohen "
     "Klippe. Ausserdem kannst Du von hier auf eine Anhoehe im Sueden gehen.");


   AddDetail( ({"hoehlendecke"}),
     "An der Decke zucken die Blitze durch die Nebelschwaden.");

   AddDetail( ({"blitze","blitz"}),
     "Pass bloss auf das Dich keiner trifft.");
   /*
kleine fiese idee, leute mit zuviel metallzeugs ziehen hin und wieder einen blitz an
*/

   AddDetail( ({"nebelschwaden","nebel","schwaden"}),
     "Die sind so dicht, dass Du nicht siehst was sich darueber verbirgt.");

   AddDetail( ({"boden"}),
     "Da liegen ueberall Felsen und Steine herum.");

   AddDetail( ({"felswand","wand"}),
     "Ziemlich hoch.");

   AddDetail( ({"hang","abhang"}),
     "Naja, Abhang kann man das hier eigentlich nicht nennen, eigentlich "
     "waere hier Felskueste passender.");

   AddDetail( ({"felskueste","kueste"}),
     "So nennt sich eine Kueste aus Felsen. Sie ragt wie eine Wand im Osten "
     "vor Dir auf.");

   AddDetail( ({"insel"}),
     "Es ist immer noch die selbe Insel wie vorhin.");

   AddDetail( ({"felsen","fels","steine","gestein"}),
     "Es ist ein nachtschwarzes Material, das entfernt an Basalt oder Obsidian"
     " erinnert.");

   AddDetail( ({"material","materialien","basalt","obsidian"}),
     "Das sieht eben wie Vulkangestein aus.");

   AddDetail( ({"vulkangestein"}),
     "Wird von einem Vulkan ausgespuckt.");

   AddDetail( ({"vulkan"}),
     "Der spuckt Vulkangestein aus.");

   AddDetail( ({"steinchen"}),
     "Hier solltest Du besonders aufpassen, dass Du nicht auf ihnen ausrutschst. "
     "Es sind hier einige besonders spitze Stellen vorhanden. Du glaubst einen "
     "besonderen Stein zu sehen.");

   AddDetail( ({"stein"}),
     "Dieser Stein sieht aus wie ein kleiner, in Glas gegossener, rechter "
     "Arm. Leider kann man ihn nicht mitnehmen.");

   AddDetail( ({"glas"}),
     "Sehr durchsichtig und oft schnell kaputt.");

   AddDetail( ({"arm"}),
     "Man sieht den Oberarmknochen, Elle, Speiche und die Fingerknochen.");

   AddDetail( ({"oberarmknochen","elle","speiche","fingerknochen","knochen"}),
     "Hast Du sicher auch in Deinem Arm, aber versuch bloss nicht jeden bei Dir "
     "fuehlen zu wollen.");

   AddDetail( ({"stellen"}),
     "Greif lieber nicht hin, Du koenntest Dich verletzen.");
   /*
 eventuelle ne greif- oder sonstige funktion die einen sich selbst verletzen laesst?

 */
   AddDetail( ({"baeume","baum","baeumen","busch","buesche"}),
     "Die wachsen hier nicht. Lieg wohl an der Saeure.");

   AddDetail( ({"lavatuempel","tuempel"}),
     "Der wird von einem kleinen Lavafluss, welcher von der suedlichen Anhoehe kommt,"
     "gespeist, riecht schwefelig, wirft kleine Blasen und gibt maechtig Hitze ab."
     "Nebenbei bemerkst Du, dass es hier etwas ebener als sonst ist, sonst wuerde Dir"
     "die Lava vermutlich nicht sehr gut tun in ihrem Fliessverhalten.");

   AddDetail( ({"lava"}),
     "Geschmolzenes Gestein.");

   AddDetail( ({"lavafluss","fluss","lavafluesse","fliessverhalten"}),
     "Fliesst wie jeder andere Fluss auch bergab.");

   AddDetail( ({"anhoehe"}),
     "Die ist im Sueden. Geh hin.");

   AddDetail( ({"blasen","blase"}),
     "BLUUUUUUUBBBBB.");

   AddDetail( ({"hitze"}),
     "Boah, ist das heiss hier.");

   AddDetail( ({"osten","sueden"}),
     "Das kann man nicht untersuchen, sondern nur dort hin gehen.");

   AddDetail( ({"rand","klippe"}),
     "Du siehst von hier aus kaum ueber den Rand der Klippe hinaus, aber es duerfte "
     "sich etwas Wichtiges da oben befinden.");

   AddDetail( ({"wichtiges"}),
     "Geh woanders rauf und schaue es Dir an. Von hier aus geht das nicht.");

   AddDetail( ({"decke"}),
     "Verhangen und duester ist sie ueber Dir.");

   AddDetail( ({"pulsieren","leuchten"}),
     "Erst jetzt faellt Dir auf das das von den kleinen Lavafluessen rund um die"
     "Insel stammen koennte.");

//Geraeusche:
   AddSound(DEFAULT_SOUND,
     "Neben dem leisen Klatschen der Wellen und dem Knistern der Blitze kannst Du "
     "auch ein dumpfes Klopfen und ein leises Gluckern wahrnehmen.");

   AddSound( ({"gluckern"}),
     "Das kommt wohl vom Lavafluss.");

   AddSound( ({"klatschen","wellen"}),
     "Man hoert sie sanft an den Hang klatschen.");

   AddSound( ({"knistern","blitze"}),
     "Es hoert sich an wie wenn hunderte kleiner Fluegel aneinander reiben wuerden.");

   AddSound( ({"fluegel"}),
     "Das war nur Vergleich. Du siehst hier keine.");

   AddSound( ({"vergleich","hang","pulsieren","leuchten","lavafluss"}),
     "Sowas kann man nicht erlauschen. Probiers anders.");

   AddSound( ({"klopfen"}),
     "Seltsamerweise ist es synchron mit dem Pulsieren und Leuchten im Berg zu"
     "hoeren.");

   AddSound( ({"berg"}),
     "Auch wenn Du es nicht wahrhaben willst, der Berg scheint Dich noch immer in"
     "irgendeiner Weise anzuziehen.");

   AddSound( ({"weise"}),
     "Eine unheimliche Weise.");

//Gerueche:
   AddSmell(DEFAULT_SMELL,
     "Neben dem Saeuregeruch riechst Du auch noch etwas Schwefel.");

   AddSmell( ({"schwefel"}),
     "Riecht wie halbverfaulte Eier."); 

   AddSmell( ({ "eier"}),
     "Halb verfaulte Eier stinken widerlich.");
   
   AddSmell( ({"redewendung"}),
     "Du willst SOWAS riechen?");

   AddSmell( ({"saeuregeruch"}),
     "Der ist hier sicher nicht mehr schaedlich fuer Deine Gesundheit.");
   
   AddDetail( ({ "gesundheit"}),
     "Deine Gesundheit ist hier scheinbar nicht gefaehrdet.");


//Die Exits:

   SetExit(NORDOSTEN);
   SetExit(SUEDWESTEN);
   SetExit(SUEDEN);
}
