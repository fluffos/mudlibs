#include <properties.h>
#include <moving.h>
#include "../directions.h"
#include "../nekro.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/yaq_monoq/"+x)
#endif

inherit NEKRO_ISLAND_DIR+"room/std_yaq_monoq";

string sinnlos_unt();
string go_insane();
int zombies=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp( P_INT_LONG, 
      "Du befindest Dich inmitten von Yaq'Monoq. Ringsum siehst Du "
      "nur Tod und Verwesung. Etliche verschrumpelte Koerper liegen "
      "hier am Boden. Viele behauene Steine, die wie Grabsteine aussehen, "
      "stehen im verwitterten Boden. Ein Geruch der Faeulnis haengt in der "
      "Luft, gemischt mit dem allgegenwaertigen Gestank der Saeure.");
  // ROOM DESCRIPTION END
  AddDetail( ({"boden"}),
      "Der Boden besteht aus verwittertem Gestein und schwarz verbrannter "
      "Erde. Etliche Steine, die wie Grabsteine aussehen, ragen aus der "
      "Erde hervor. Einige verschrumpelte Koerper liegen neben diesen "
      "Grabsteinen.");
  AddDetail ( ({"erde"}),
      "Die Erde ist verwittert und wirkt verschimmelt. Hier kann unmoeglich "
      "etwas wachsen.");
  AddSpecialDetail ( ({"koerper"}), "examine_zombies");
  AddDetail ( ({"steine", "grabsteine"}),
      "Die Grabsteine sind komplett verwittert. Der Zahn der Zeit und die "
      "allgegenwaertige Saeure haben die Schrift auf ihnen bis zur "
      "Unkenntlichkeit zerfressen.");
  AddSpecialDetail( ({"zahn","zeit", "bedeutung","worte", "leben", "platz"}), 
      "sinnlos_unt");
  AddDetail( ({"schrift"}),
      "Die Schrift ist leider nicht mehr zu entziffern.");
  AddReadDetail( ({"schrift"}),
      "Die Schrift ist zu verwittert um sie lesen zu koennen.");
  AddDetail( ({"saeure" }),
      "Du siehst sie nicht, aber Du kannst sie riechen.");
  AddDetail( ({"unkenntlichkeit"}),
      "Die Schrift ist so unkenntlich, dass Du sie leider nicht mehr "
      "lesen kannst.");
  AddDetail( ({"saeuresee", "see"}),
      "Den siehst Du von hier aus nicht!");
  AddDetail( ({"tod"}),
      "Du siehst ihn nicht, aber er lauert hier ueberall.");
  AddDetail( ({"verwesung"}),
      "Verwesung ist hier ueberall. Ueberall. Sieh Dich um. Hier ist "
      "kein Platz fuer das Leben.");
  AddDetail( ({"haut"}),
      "Die Haut der Koerper hat sich schon schwaerzlich verfaerbt.");
  AddDetail( ({"flecken"}),
      "Schwarze Flecken uebersaehen die verschrumpelten Koerper. Wer weiss "
      "wie lange sie hier schon liegen.");
  AddDetail( ({"gestein"}),
      "Das Gestein hier ist verwittert und alt. Sehr alt!");
  AddDetail( ({ "atem"}),
      "Dein Atem, ist auch schon mit Saeure durchsetzt.");
  AddDetail( ({ "lunge"}),
      "Deine Lungen sind durch die Saeure schon angeaetzt.");  

  
  AddSmell(DEFAULT_SMELL,
      "Ein Geruch von Saeure und Faeulnis liegt in der Luft.");
  AddSmell( ({"geruch", "luft"}),
      "Ein Geruch von Saeure und Faeulnis liegt in der Luft.");
  AddSmell( ({"faeulnis"}),
      "Faeulnis liegt in der Luft, geht von den verschrumpelten "
      "Koerpern aus. Dir wird beinahe uebel von dem Geruch.");
  AddSmell( ({"saeure"}),
      "Die Saeure riecht scharf. Du atmest gerade nicht so stark "
      "ein, dass Dir die Lunge nicht vollstaendig veraetzt wird.");
  AddSmell( ({"gestank"}),
      "Er raubt Dir fast den Atem.");
  AddSound(DEFAULT_SOUND, 
      "Leise wispernde Stimmen sind von ueberall her zu hoeren ...");
  AddSound( ({"stimmen"}), #'go_insane);


  // DETAILS START
  // DETAILS END

  // EXITS START
  SetExit (OSTEN);
  SetExit (NORDOSTEN);
  SetExit (SUEDEN);
  SetExit (WESTEN);
  // EXITS END

  // ITEMS START
  // ITEMS END

}

void reset() {
  ::reset();
  zombies=1;
}

string sinnlos_unt() {
  do_room_damage(TP, random(2)+1, "Leichtsinnigkeit");
  return BS("So etwas findest Du hier nicht! Achte lieber auf Deine "
      "Umgebung ...");
}

string examine_zombies() {

  if(!zombies || present("\nroomzombie", ME))
    return BS("Die verschrumpelten Koerper liegen neben den Grabsteinen. "
      "Sie scheinen schon lange hier an diesem Ort zu liegen, denn "
      "ihre Haut ist vertrocknet und eingefallen und weist schon "
      "schwarze Flecken auf.");
  call_out("clone_zombies");
  zombies=0;
  return BS("Die Koerper bewegen sich auf einmal!");
}

void clone_zombies() {
   object zomb;
   int i;
   i=random(3)+1;
   for (i;i>=0;i--) {
     zomb=clone_object(NPC "zombie");
     zomb->SetZombie(10+random(10),1,5000+random(5000));
     tell_room(ME, BS("Ein Zombie erhebt sich!"));
     zomb->SetProp(P_AGGRESSIVE, ([P_GUILD:(["nekromanten":0.0, 0:1])]));
     zomb->AddId("\nroomzombie");
     zomb->move(ME, M_NOCHECK|M_SILENT);
   }
   return ;
}

string go_insane() {
  object ob;
  if(random(40) > TP->QueryAttribute(A_INT) && !present("\ninsanity",TP)) {
    ob=clone_object(NEKRO_ISLAND_OBJ "insanity");
    ob->move(TP, M_NOCHECK);
    ob->Start();
    return BS("Hahaha. Alles so bunt. Weglaufen. Du musst weglaufen. "
        "Schnell! Sie sind ueberall. Haha. ");
  }
  return BS("Die Stimmen treiben Dich beinahe in den Irrsinn.");
}
