#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit NEKRO_ISLAND_DIR+"room/std_beach_room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_INT_LONG, "Du siehst hier einen nicht sehr breiten Weg, ueberall "
		       "ist nur schwarzer Sand. Links und rechts von Dir siehst "
		       "Du am Ufer, die Oberflaeche des Saeuresees. Aber Dir "
		       "wird ein genauer Anblick verwehrt, da hier dicke "
		       "Saeureschwaden ueber dem See wie Nebel herziehen. Es "
		       "ist noch unangenehmer in diesem Teil der Hoehle und "
		       "Du spuerst ein unangenehmes Gefuehl auf Deiner Haut.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({ "weg"}),
		"Der Weg durch den Saeuresee, ist nicht sehr breit und Du solltest "
		"aufpassen wo Du hinlaeufst.");
  AddDetail( ({ "sand"}),
		"Der schwarze Sand ist nur am Ufer des Saeuresees etwas gelblich, "
		"doch kannst Du das nicht genau erkennen da am Ufer Saeureschwaden, "
		"die Sicht etwas verhindern.");
  AddDetail( ({ "sicht"}),
		"Die Sicht ist hier, durch die Saeureschwaden sehr getruebt.");
  AddDetail( ({ "saeuresee", "see"}),
		"Du stehst auf einem schmalen Weg der durch den Saeuresee fuehrt.");
  AddDetail( ({ "ufer"}),
		"Das Ufer, das auf beiden Seiten des schmalen Weges ist, ist kaum "
		"zu erkennen, da Saeureschwaden die Sicht etwas verhindern, aber "
		"Du koenntest ja mal vorsichtig an das Ufer herantreten um es zu "
		"betrachten.");
  AddDetail( ({ "seiten"}),
		"Beide Seiten des Weges, sind Ufer des Saeuresees.");
  AddDetail( ({ "oberflaeche", "flaeche"}),
		"Die Oberflaeche des Saeuresees ist ungewoehnlich ruhig und "
		"fast idyllisch, aber Du kannst Dir sicher sein, dass das "
		"eine truegerische Taeuschung ist.");
  AddDetail( ({ "saeuresees", "sees"}),
		"Der aetzende Gestank des Saeuresees sticht Dir in Deine Nase und "
		"Du merkst das Deine Lungen das nicht mehr lange aushalten.");
  AddDetail( ({ "gestank"}),
		"Na wenn Du den Gestank so sehr magst, riech doch mal.");
  AddDetail( ({ "nase"}),
		"Mit Deiner Nase, was kannst Du damit machen? Riechen, oder nicht?");
  AddDetail( ({ "lungen"}),
		"Deine Lungen leiden hier ziemlich und wenn Du den Gestank magst, "
		"kannst Du sie ja weiter quaelen und riechen.");
  AddDetail( ({ "teil"}),
		"In diesem Teil der Hoehle ist es noch unangenehmer und wenn Du "
		"keine gute Ruestung traegst, wirst Du hier nicht lange ueberleben.");
  AddDetail( ({ "ruestung"}),
		"Du solltest vielleicht mal Deine Ruestung kontrollieren, sonst koennte "
		"Deine Haut aussehen wie ein aetzender Streuselkuchen.");
  AddDetail( ({ "streuselkuchen", "kuchen"}),
		"Wie ein aetzender Streuselkuchen koennte Deine Haut aussehen, wenn "
		"Du keine gute Ruestung besitzt.");
  AddDetail( ({ "haut"}),
		"Schaetz Dich gluecklich, Deiner Haut ist nichts passiert.");
  AddDetail( ({ "anblick"}),
		"Du machst einen jaemmerlichen Anblick, mach Dir nicht gleich in "
		"die Hose.");
  AddDetail( ({ "hose"}),
		"Du solltest eine anhaben, hoffendlich ist sie nicht schon voll.");
  AddDetail( ({ "boden"}),
		"Der Boden ist genauso uninteressant wie Du.");
  AddDetail( ({ "luft"}),
		"Die Luft haengt schwer in diesem Teil der Hoehle und Du hast "
		"es schwer mit dem Atmen.");
  AddDetail( ({ "atmen"}),
		"Ja, hier laesst es sich schwer Atmen, bei dem Gestank.");
  AddDetail( ({ "nebel"}),
		"Die gelben Saeureschwaden, bilden einen eklig stinkenden Nebel.");
  AddDetail( ({ "taeuschung"}),
		"Ja, die Taeuschung liegt in dieser scheinbaren idyllischen "
		"Oberflaeche des Saeuresees. Wer weis, was einen hier "
		"erwarten mag.");
  AddDetail( ({ "saeureschwaden", "schwaden"}),
		"Die Saeureschwaden ueberziehen den See wie ein Nebel.");


  AddSmell(DEFAULT_SMELL,
      "Der Geruch von Saeure liegt in der Luft. Du fuehlst Dich nicht wohl.");
  AddSmell( ({"gestank", "geruch", "gerueche"}),
      "Der Geruch von Saeure liegt in der Luft.");
  AddSmell( ({"saeure"}),
      "Die Saeure brennt in Deiner Nase. Atme ja nicht tief ein.");
  AddSound(DEFAULT_SOUND,
      "Seltsame Geraeusche sind aus der Ferne zu hoeren.");
  AddSound( ({"geraeusche", "ferne"}),
      "Hoert sich an wie Schreie.");
  AddSound( ({"schreie"}),
      "Seltsam verzerrte Schreie - Du hoerst sie aus weiter Ferne.");
  
  
  // DETAILS END

  // EXITS START
  AddExit ("suedosten", "./b6");
  AddExit ("nordosten", "./b4");
  // EXITS END
  
  // ITEMS START
  // ITEMS END
  AddCmd( ({"betrachten", "betrachte" }), "betrachte" );
  AddCmd( ({"atme"}), "acid_dam");
}

int betrachte(string str)
{
   notify_fail("Was moechtest Du betrachten?\n");
   if ( member( ({ "ufer" }),str) != -1) 
  {
    write(BS( "Du betrachtest das Ufer und erschrickst, "
           "ploetzlich schiesst ein Tentakel aus dem See "
           "und packt Dein Bein.\n"));
    say( TPN+" betrachtet das Ufer und faengt ploetzlich "
	     "laut an zu schreien.\n");
    TP->command_me("ruf So helft mir doch, Monster rauben mir mein Leben.");
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",4);
    return 1;
  }
}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS( "Du spuerst wie der Tentakel Dein Bein umschliesst. "
         "Dein Bein wird zerdrueckt und Du schreist laut.\n" ));
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",10);
}
void fall2()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  TP->AddHp(-70);
  write (BS( "Ploetzlich laesst der Tentakel Dein Bein los. "
         "Du bemerkst das irgendwas mit Dir vorgeht. Hast Du "
	 "vielleicht ein paar Lebenspunkte weniger ?\n") );
}
int acid_dam(string str) {
  if(!str) return 0;
  if(str!="tief ein") return 0;
  write("Tief atmest Du ein. Die Saeure aetzt Dir die halbe Lunge weg!\n");
  say(BS(sprintf("%s bekommt einen irren Blick und atmet tief ein.", 
          TP->Name(WER))));
  do_room_damage(TP, random(30)+1, "Zwei aufgeloeste Lungenfluegel");
  return 1;
}






