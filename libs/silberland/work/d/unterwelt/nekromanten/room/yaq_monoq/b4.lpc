#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit NEKRO_ISLAND_DIR+"room/std_yaq_monoq";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_INT_LONG, "Du bist weiter gegangen und laeufst immer noch ueber "
		       "diesen seltsamen Sand. Hier wachsen auch ein paar "
		       "dunkle Pflanzen die fuerchterlich stinken, "
		       "wahrscheinlich haben sie ueber die Jahre hinweg, "
		       "den Gestank des Saeuresees angenommen, da sie ja von "
		       "ihm mit der noetigen Fluessigkeit versorgt werden. "
		       "Der Saeuresee ist hier, wie sollte es anders sein, "
		       "dunkel am Schimmern und voellig ruhig.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({ "sand"}),
		"Der schwarze Sand haeuft sich hier ein wenig zu einem kleinen, "
	        "wirklich kaum spuerbaren, Huegelchen. Auf dem ein paar Pflanzen "
		"wachsen.");
  AddDetail( ({ "pflanzen"}),
		"Die Pflanzen stinken erbaermlich und wachsen nur spaerlich in "
		"dem schwarzen Sand.");
  AddDetail( ({ "fingerhut"}),
		"Wenn Du in der Schule aufgepasst hast, weist Du das Fingerhut "
	        "als giftig gilt. Du solltest von diesem schwarzen, erstrecht "
		"die Finger lassen.");
  AddDetail( ({ "finger"}),
		"Ja, genau, Deine Finger solltest Du besser von dem Fingerhut "
		"lassen.");
  AddDetail( ({ "schule"}),
		"Du warst doch bestimmt in der Schule, oder nicht?");
  AddDetail( ({ "huegelchen"}),
		"Was dieses Huegelchen wohl auf sich hat? Wie ist es wohl "
		"entstanden? Vielleicht, sollte man mal darin buddeln?");
  AddDetail( ({ "boden"}),
	        "Auf dem Boden ist der seltsame schwarze Sand verteilt. "
		"Am Ufer des Sees wird der Sand wieder gelblich.");
  AddDetail( ({ "see"}),
		"Wenn Du wirklich etwas ueber den See erfahren moechtest, "
		"dann untersuche das Detail Saeuresee. Wie kann man nur so "
		"forschfaul sein wie Du?");
  AddDetail( ({ "detail"}),
		"Nur ein Detail moechtest Du untersuchen? Beweg gefaelligst "
	        "Deine faulen Finger und fang an zu forschen.");
  AddDetail( ({ "ufer"}),
		"Das Ufer ist recht flach und Du kannst durch das Wasser des "
	        "Saeuresees, den Grund vage erkennen.");
  AddDetail( ({ "grund"}),
		"Der Grund des Saeuresees ist gelblich und seltsame Gebilde "
		"kannst Du erkennen.");
  AddDetail( ({ "gebilde"}),
		"Die Gebilde am Grund sind nicht eindeutig zu erkennen, haben "
	        "aber etwas unheimliches an sich.");
  AddDetail( ({ "wasser"}),
		"Das Wasser des Saeuresees, ist ruhig und Du kannst Dich fast "
	        "schon freuen, dass keine Wellen ueber Deine Fuesse gespuelt "
		"werden.");
  AddDetail( ({ "fuesse"}),
		"Hey, sei doch froh das Deine Fuesse noch trocken sind, es "
		"koennte Dir ja auch passieren....zschhhhh.");
  AddDetail( ({ "wellen", "welle"}),
		"Der See ist so ruhig, das keine einzige Welle, das Ufer "
		"beruehrt.");
  AddDetail( ({ "decke"}),
		"Die Decke, kannst Du von hier nicht wirklich sehen, sie "
		"ist viel zu hoch um etwas zu erkennen.");
  AddDetail( ({ "fluessigkeit"}),
		"Durch die Fluessigkeit werden die stinkenden Pflanzen mit "
		"ekligem Gestank gespeisst. Riech doch mal.");
  AddDetail( ({ "jahre"}),
		"Ueber die Jahre hinweg, haben die Pflanzen, den Gestank "
		"des Saeuresees angenommen.");
  AddDetail( ({ "saeuresee"}),
		"Der Saeuresee ist ruhig und schimmert unheimlich.");
  AddDetail( ({ "saeuresees"}),
		"Also, anders beschreiben als das Detail Saeuresee, ne, "
		"is nicht, vergiss es.");
  AddDetail( ({ "wand"}),
		"Eine Wand kannst Du hier wirklich nicht erkennen.");
  AddDetail( ({ "waende"}),
		"Nein, Waende siehst Du hier auch keine.");
  AddDetail( ({ "schimmern"}),
		"Der See ist durch ein unheimliches Schimmern nicht "
		"gerade freundlich, aber hast Du hier etwas anderes "
		"erwartet?");
    
  AddSmell( DEFAULT_SMELL,
		"Du bist wirklich widerlich, scheinst Dich an dem Gestank "
		"auch noch zu ergoetzen. Aber wenn es Dir Freude macht. "
		"Bitte, also weiter riechen. Pfui. ");
		
  AddSmell( ({ "gestank"}),
	       "Der Gestank ist so widerlich, aber Du geniesst es ja "
	       "regelrecht, Deine Nase damit zu quaelen.");
  AddSmell( ({ "nase"}),
	       "Du haelst Dir kurz Deine Nase zu um dem Gestank "
	       "zu entgehen. Wohl doch nicht so abgebrueht...."),
  // DETAILS END

  // EXITS START
  SetExit(SUEDWESTEN);
  SetExit(SUEDOSTEN);
  SetExit(NORDEN);
  // EXITS END

  // ITEMS START
  AddItem(NEKRO_ISLAND_NPC "nekromant", REFRESH_DESTRUCT);
  // ITEMS END
  //
AddCmd( ({"buddel", "buddle" }), "buddel" );

}
int buddel(string str)
{
   notify_fail("Worin moechtest Du buddeln?\n");
   if ( member( ({ "sand", "in sand" }),str) != -1) 
  {
    write(BS( "Du buddelst in dem schwarzen Sand und spuerst ploetzlich "
              "einen recht schmerzhaften Biss.\n"));
    say( TPN+ " buddelt in dem schwarzen Sand und verzieht das Gesicht "
              "vor schmerzen.\n");
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",4);
    return 1;
  }
}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS( "Als Du den Biss bemerkst, ziehst Du schnell die Hand aus dem Sand "
            "und Du siehst an Deiner Hand einen fiesen Saeuregrottenmolch haengen. "
	    "Er hat Dir etwas Magie geraubt.\n" ));
  TP->AddSp(-50);
 
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",10);
}
void fall2()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  
  write (BS( "Du schuettelst wie Wild Deine Hand und der Saeuregrottenmolch fliegt "
             "in hohem Bogen in den See. Es zischt ploetzlich als der Molch in die "
	     "Saeure eintaucht." ) );

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Scriptfalle in room/yaq_monoq/b4) "
               " -%d EP\n", lostexp) );
}
 

