#include "../nekro.h"
inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
  SetProp (P_INT_SHORT, "Auf einem schmalen Steinsteg");
  SetProp (P_INT_LONG,
    "Du stehst auf einem kleinen Steinsteg am Nordende der dunklen Insel, "
    "die hier mitten in dem unterirdischen See liegt. Der Steg ist direkt "
    "aus dem massiven Felsen gehauen, aus dem die ganze Insel zu bestehen "
    "scheint. Nach Norden hin breitet sich vor Dir der weite "
    "unterirdische See aus. Ein duesteres, kaltes Licht liegt ueber dem "
    "See, waehrend im Sueden auf der Insel dunkle Gebilde zu erkennen "
    "sind. Ein roetliches Gluehen scheint von ihnen auszugehen. Weit ueber "
    "Dir kannst Du die dunkle Hoehlendecke erkennen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"himmel"}),
    "Den wirst Du hier unten vergeblich suchen.");
  AddDetail ( ({"steg", "steinsteg"}),
    "Ein schmaler, direkt aus dem Felsen der Insel gehauener schwarzer "+
    "Steinsteg fuehrt hier ein Stueck weit auf den dunklen See hinaus. Er "+
    "ist nur grob behauen und macht einen sehr soliden Eindruck.");
  AddDetail ( ({"stueck"}),
    "Der Steg fuehrt einige Meter auf den See hinaus.");
  AddDetail ( ({"meter", "zwergenlaenge"}),
    "Ein Meter ist fast eine Zwergenlaenge.");
  AddDetail ( ({"see"}),
    "Ein weiter, unterirdischer See breitet sich von hier aus weit nach "+
    "Norden, Westen und Osten aus. Das dunkle Wasser liegt still und "+
    "spiegelglatt da und reflektiert das wenige, kalte, blaeuliche Licht, "+
    "welches von oben herabfaellt. Eine unheimliche Stimmung macht sich in "+
    "Dir breit.");
  AddDetail ( ({"wasser"}),
    "Glatt und klar liegt das Wasser da und reflektiert das wenige Licht, "+
    "das es hier unten gibt.");
  AddDetail ( ({"atmosphaere", "stimmung"}),
    "Dir wird unheimlich bei der duesteren Atmosphaere hier unten.");
  AddDetail ( ({"licht"}),
    "Ein dunkles, blaeuliches Licht faellt von oben herab und taucht alles "+
    "in eine bedrohliche Atmosphaere. Im Sueden auf der Insel ist ein "+
    "roetliches Gluehen zu erkennen.");
  AddDetail ( ({"ende", "insel", "nordende","felseninsel"}),
    "Du stehst am Nordende einer dunklen, bedrohlich wirkenden "+
    "Felseninsel, die inmitten des unterirdischen Sees zu liegen scheint. "+
    "Im Sueden, in der Mitte der Insel sind dunkle Gebilde auszumachen, "+
    "von denen ein roetliches Gluehen auszugehen scheint. Ein Weg scheint "+
    "nach Sueden geradewegs dort hin zu fuehren.");
  AddDetail ( ({"weg"}),
    "Ein schmaler Weg fuehrt nach Sueden.");
  AddDetail ( ({"gebilde", "mitte"}),
    "In der Mitte der dunklen Insel liegen einige gedrungene, bedrohlich "+
    "wirkende Gebilde von denen ein schwaches roetliches Gluehen "+
    "auszugehen scheint.");
  AddDetail ( ({"fels", "felsen", "felsgestein",
                "gestein"}),
    "Der Steg und auch die Insel besteht aus schwarzem, grob behauenem "+
    "Felsgestein.");
  AddDetail ( ({"boden"}),
    "Den Boden hier bildet ein Steg aus schwarzem Felsgestein.");
  AddDetail ( ({"eindruck"}),
    "Der Fels scheint wirklich hart und massiv zu sein.");
  AddDetail ( ({"gluehen"}),
    "Ein unheimliches, roetliches Gluehen geht von den dunklen Gebilden "+
    "in der Mitte der Insel aus. Wo genau es herkommt, ist nicht zu "+
    "erkennen.");
  AddDetail ( ({"decke", "hoehlendecke"}),
    "Fast wie ein steinerner Himmel woelbt sich die felsige Decke ueber "+
    "die ganze Hoehle.");
  AddDetail ( ({"hoehle"}),
    "Offensichtlich befindet sich dieser See in einer riesigen, "+
    "unterirdischen Hoehle.");
  // DETAILS END

  // EXITS START
  AddExit ("sueden", "./sgang1");
  // EXITS END

  // ITEMS START
  AddItem(NEKRO_ISLAND_DIR+"transport/barke", REFRESH_INIT, 1);
  // ITEMS END

}
