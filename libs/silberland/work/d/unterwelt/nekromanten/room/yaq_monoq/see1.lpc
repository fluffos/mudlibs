#include <properties.h>
#include <moving.h>
#include "/gilden/nekromanten/nekro.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:6]));
  SetProp (P_INT_SHORT, "Am Rande des Saeuresees");
  SetProp (P_INT_LONG,
    "Schmerz! Schmerz ist das einzige, was Du empfindest, waehrend Du "+
    "hier am Rande das Saeuresees schwimmst. Der Schmerz durchdringt "+
    "Deine Glieder und umschliesst jede Zelle Deines Koerpers. Es ist die "+
    "reinste Agonie! Gleich neben Dir ist ein schmaler Steinsteg, wenn Du "+
    "den bloss erreichen koenntest! Wenn doch bloss nicht dieser Schmerz "+
    "waere!");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"zelle"}),
    "Jede einzelne Zelle Deines Koerpers scheint vor Schmerz zu schreien!");
  AddDetail ( ({"steg", "steinsteg"}),
    "Der Steg, der hier einige Meter in den See ragt, koennte Deine "+
    "Rettung sein.");
  AddDetail ( ({"see","saeuresee"}),
    "Der See scheint nur aus Saeure zu bestehen, und er erstreckt sich "+
    "soweit Du schauen kannst nach Sueden.");
  AddDetail ( ({"schmerz"}),
    "Du windest Dich in unertraeglichem Schmerz.");
  AddDetail ( ({"saeure"}),
    "Die Saeure wird Dich in wenigen Sekunden zerfressen haben!");
  AddDetail ( ({"chance", "rettung"}),
    "Deine einzige Chance auf Rettung ist der kleine Steg, der hier in den "+
    "See ragt.");
  AddDetail ( ({"rand", "rande"}),
    "Zum Glueck bist du am Rand des Sees, denn so hast Du eine kleine "+
    "Chance auf Rettung.");
  AddDetail ( ({"meter"}),
    "Das interessiert Dich jetzt ueberhaupt nicht!");
  AddDetail ( ({"koerper", "koerpers"}),
    "Dein ganzer Koerper schmerzt unertraeglich, waehrend er von der "+
    "Saeure zerfressen wird.");
  AddDetail ( ({"sekunde", "sekunden"}),
    "Sehr lange wirst Du hier nicht ueberleben.");
  AddDetail ( ({"himmel"}),
    "Den siehst Du hier unten ganz sicher nicht.");
  AddDetail ( ({"glueck"}),
    "Nur mit sher viel Glueck kommst Du hier wieder lebend raus.");
  AddDetail ( ({"glied", "glieder"}),
    "Jedes Deiner Glieder ist von diesem unglaublichen Schmerz "+
    "durchdrungen, der Dich daran hindert, klar zu denken.");
  AddDetail ( ({"boden"}),
    "Der Boden des Sees ist nicht zu erkennen.");
  AddDetail ( ({"agonie"}),
    "Du windest Dich in Agonie!");
  // DETAILS END

  // EXITS START
  AddCmd(({"kletter","klettere"}),
    "kletter_fun");
  // EXITS END

  // ITEMS START
  // ITEMS END

}

int kletter_fun(string str)
{
  notify_fail("Wohin moechtest Du klettern?\n");
  if (member(({"auf steg","auf den steg","aus see","aus see heraus",
               "aus dem see"}),str) == -1)
    return 0;
  tell_object(TP,BS(
     "Du streckst Dich nach dem Steg, haeltst Dich fest und ziehst Dich mit "
     "einem Kraftakt nach oben. Voellig erschoepft liegst Du erst einmal "
     "auf dem Boden."));
  TP->move("/d/unterwelt/nekromanten/room/ablegestelle",M_GO|M_NOCHECK|M_SILENT);
  tell_room(TO,BS(
    TP->Name()+" streckt sich nach dem Steg, unt zieht sich mit letzter Kraft "
    "hinauf. Das solltest Du auch ganz schnell tun, bevor es zu spaet ist!"));
  tell_room(ENV(TP),BS(
    TP->Name()+" zieht sich mit scheinbar letzter Kraft aus dem See heraus "
    "nach hier oben und bleibt erst einmal voellig regungslos liegen."),
    ({TP}));
  TP->SetProp(P_MV,0);
  return 1;
}

