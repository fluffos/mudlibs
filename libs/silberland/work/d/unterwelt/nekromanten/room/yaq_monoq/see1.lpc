int will_be_killed(object ob)
{
  if (living(ob)&&!IS_LEARNER(ob))
    return 1;
  return 0;
}

heart_beat()
{
  object *inv;
  int i;
  
  inv=filter_array(all_inventory(),#'will_be_killed);
  if (!(i=sizeof(inv)))
  {
    set_heart_beat(0);
    return;
  }
  
  SetProp(P_KILL_NAME,"Ein Bad in einem Saeuresee");
  for (i;i-->0;)
  {
    inv[i]->do_damage(10);
  }
  if ((i=random(30))<5)
  {
  tell_room(TO,BS(({
    "Der Schmerz laesst Deine Sinne schwinden.",
    "Du windest Dich vor Schmerz.",
    "Du kennst nur einen Gedanken: Raus hier!",
    "Der Schmerz ist absolut unertraeglich.",
    "Lange haeltst Du das hier nicht mehr durch.",
    })[i]));
  }
}
