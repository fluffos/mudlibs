#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../../dungeon.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit NEKRO_ISLAND_DIR "room/std_cliff_room";

string exit_osten="";
string exit_westen="";

int acid_hp=0;


void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_NOBARRIER, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_INT_LONG, "Saeureschwaden verhindern hier Deine Sicht. Du kannst "
      "nicht viel erkennen ausser Saeureschwaden, die Deine Augen, Deine Nase, "
      "Deine Haut, einfach alles angreifen und veraetzen! Nicht wie weg von hier!");
  
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit("osten", ([
        EX_DEST: "./f5",
        EX_TESTFUNC: "checknekromant",
        ]));
  AddExit("westen", ([
        EX_DEST: "./d5",
        EX_TESTFUNC: "checknekromant",
        ]));
  AddSpecialExit( ({"links","rechts", "vorne","hinten"}), "search_for_exit");
  // EXITS END

  // ITEMS START
  // ITEMS END
  AddCmd( ({"untersuche", "unt"}), "no_explore");
  AddCmd( ({"breche", "brech"}), "panic");

}

void init() {
  string *directions;
  ::init();
  if(!interactive(TP)) return;
  directions=({"vorne","hinten","links","rechts"});
  exit_osten=directions[random(sizeof(directions))];
  directions-=({exit_osten});
  exit_westen=directions[random(sizeof(directions))];
  return ; 
}

nosave int no_explore(string str) {
  int hp;
  write(BS("Du hast keine Zeit hier etwas "
        "zu untersuchen! RETTE DICH LIEBER!"));
  hp=random(10)+5;
  acid_hp+=hp;
  if(acid_hp > 100) call_out("acid_demon",0);
  do_room_damage(TP, hp, "Saeureschwaden");
  return 1;
}

varargs string GetExits(object viewer) {
  if(viewer->QueryProp(P_GUILD)=="nekromanten") {
    return BS("Es gibt zwei erahnbare Ausgaenge: osten und westen.");
  }
  return BS("Du bist komplett verwirrt. Du siehst die Ausgaenge nicht. "
    "Du kannst nur nach vorne, nach links oder rechts oder vielleicht "
    "auch nach hinten. Alternativ kannst Du in Panik ausbrechen.");
}

nosave int checknekromant() {
  int hp;
  if(TP->QueryProp(P_GUILD)=="nekromanten")
    return 1;
  write("Was, wohin? Wohin? WOHIN?\n");
  hp=random(10);
  acid_hp+=hp;
  if(acid_hp > 100 && !present("saeureschwade",ME)) 
    call_out("acid_demon");
  return 0;
}

nosave int search_for_exit() {
  string choosen_dir;
  int hp;
  if(TP->QueryProp(P_GUILD)=="nekromanten") return 0;
  choosen_dir=query_verb();
  if(choosen_dir == exit_osten) {
     TP->move(NEKRO_ROOMS+"f5", M_GO, 0, 
         "stolpert aus Deiner Sicht", "stolpert herein");
     return 1;
  }
  if(choosen_dir == exit_westen) {
     TP->move(NEKRO_ROOMS+"d5", M_GO, 0, 
         "stolpert aus Deiner Sicht", "stolpert herein");
     return 1;
  }
  write("Wah! Panik! Wohin musst Du nur gehen?\n");
  hp=random(20);
  acid_hp+=hp;
  if(acid_hp > 100 && !present("saeureschwade")) {
    acid_hp=0;
    call_out("acid_demon");
  }
  do_room_damage(TP, hp, "Panik");
  return 1;
}

int panic(string str) {
  object ob;
  if(!str) return 0;
  if(TP->QueryProp(P_GUILD)=="nekromanten") return 0;
  if(str!="in panik aus") 
    return 0;
  if(!present("\ninsanity", TP)) {
    ob=clone_object(NEKRO_ISLAND_OBJ "insanity");
    ob->move(TP, M_NOCHECK);
    ob->Start();
  }
  write(BS("Haha. Alles wird gut. Nur schnell weg. Panik. Panik! PANIK!"));
  say(BS(sprintf("%s bricht in Panik aus!", TP->Name(WER))));
  return 1;
}

void acid_demon() {
  object ob;
  if (present("saeureschwade"))
    return;
  ob=clone_object(NEKRO_ISLAND_NPC "aciddemon");
  tell_room(ME, BS("Ploetzlich wird eine Saeureschwade lebendig!"));
  ob->move(ME, M_NOCHECK);
  return ;
}

string test123() {
  return sprintf("exit_osten -> %s, exit_westen -> %s\n",
      exit_osten,exit_westen);
}

void reset() {
  ::reset();
  if(acid_hp > 100) acid_hp=100;
  return;
}
