#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/yaq_monoq/"+x)
#endif

inherit NEKRO_ISLAND_DIR+"room/std_beach_room";

nosave int clone_skeletons();
int skelett=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_INT_LONG, "Du stehst nun am eigentlichen Strand beim Saeuresee. "
		  "Die Daempfe des Sees bringen Deine Augen zum traenen wo durch "
		  "Du nur noch verschwommen siehst. Durch Deine Traenen erblickst "
		  "Du grade noch den Boden der wohl von der Saeureflut sauber "
		  "gefressen wurde. Im Norden fuehrt der Weg steil nach oben. Ein "
		  "Haufen Knochen liegt in unmittelbarer Naehe des Saeuresees.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"strand"}),
    "Einen Strand haettest Du Dir eigentlich anders vorgestellt. Hier gibt "+
    "es weder Wasser noch Sand.");
  AddDetail ( ({"saeuresee", "see"}),
    "Der See besteht voellig aus Saeure und verschlingt alles was man ihm "+
    "bietet. Nur ein Geisteskranker wuerde auf die Idee kommen in diesem "+
    "See zu baden.");
  AddDetail ( ({"geisteskranker"}),
    "Wenn Du in diesem See baden moechtest dann musst Du wohl einer sein.");
  AddDetail ( ({"idee"}),
    "Du solltest Deine Idee nicht ausfuehren...");
  AddDetail ( ({"wasser"}),
    "Das gibts hier nicht.");
  AddDetail ( ({"daempfe"}),
    "Die Daempfe die aus dem See steigen bringen Traenen in Deine Augen.");
  AddDetail ( ({"augen"}),
    "Deine Augen brennen! Du willst nur noch weg hier!");
  AddDetail ( ({"boden"}),
    "Der Boden ist pechschwarz, hart, und perfekt glatt. Wer hier ausrutscht, "
    "rutscht in den See und wird von der Saeure zerfressen.");
  AddDetail ( ({"weg"}),
    "Der Weg fuert nach oben im Norden, und weiter entlang des Strands "+
    "nach Suedwesten.");
  AddDetail ( ({"traenen"}),
    "Deine Augen halten die Daempfe nicht mehr lange aus.");
  AddDetail ( ({"sand"}),
    "Du schaust nochmal hin. Nein, kein Sand weit und breit zu sehen.");
  AddDetail ( ({"saeure","flut","saeureflut"}),
      "Die Saeure im See zischt und dampft! Du kannst darin sicherlich baden "
      "wenn du lebensmuede bist.");
  AddDetail( ({"knochen"}),
      "Die Knochen bilden einen Haufen.");
  AddDetail( ({"naehe"}),
      "In unmittelbarer Naehe des Saeuresees liegt ein Haufen Knochen.");
  AddSpecialDetail( ({"knochenhaufen", "haufen"}),
      "skelett_detail");
  // DETAILS END

  // EXITS START
  SetExit(NORDWESTEN);
  SetExit (SUEDWESTEN);
  // EXITS END

  // ITEMS START
  // ITEMS END

}

void reset() {
  skelett=1;
  return ::reset();
}

nosave string skelett_detail() {
  string txt;
  txt="Auf dem pechschwarzen Boden liegt ein Haufen Knochen. Verschiedene "
    "Arten von Knochen sind hier gestapelt worden.";
  if(skelett) {
    txt+=" Als Du das Ganze so untersuchst geraet ploetzlich Bewegung in "
      "den Haufen und etliche Skelette formen sich daraus! Sie attackieren "
      "Dich ohne Gnade!!";
    tell_room(ME,BS(sprintf("%s untersucht den Haufen Knochen, als ploetzlich "
          "drei Skelette aus dem Haufen entstehen und attackieren %s!",
          TP->Name(WER), TP->QueryPronoun(WEN))),({TP}));
    clone_skeletons();
  }
  return BS(txt);
}

nosave int clone_skeletons() {
  object skeleton;
  int i;
  for(i=0;i<=2;i++) {
    skeleton=clone_object(NEKRO_ISLAND_NPC "skelett");
    skeleton->move(ME, M_NOCHECK|M_SILENT);
    skeleton->Kill(TP);
  }
  skelett=1;
}
