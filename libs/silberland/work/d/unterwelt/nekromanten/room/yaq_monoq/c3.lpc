#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif
inherit NEKRO_ISLAND_DIR "room/std_yaq_monoq";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE: 14]) );
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_INT_LONG, "Hier stehst Du auf einem kahlen Stueck Boden. Ausser "
		       "ein paar alten Knochen ist hier nichts. Keine Waende, "
		       "die Decke ist nur weit oben zu erahnen. Du hoerst aber "
		       "von irgendwoher Geraeusche als brechen Knochen auseinander "
		       "und auf jedes der Geraeusche hoerst Du Schreie die Mark "
		       "und Bein erzittern lassen.");
  
  // ROOM DESCRIPTION END

  // DETAILS START
  
  AddDetail( ({ "stueck"}),
		"Dieses Stueck Boden ist nicht besonders interessant. Ausser "
		"ein paar Knochen siehst Du hier nichts auf den ersten Blick.");
  AddDetail( ({ "knochen"}),
		"Ein paar Knochen liegen auf dem kahlen Boden. Sie sehen aus wie "
		"Knochen von Menschen oder Elfen. Ein Knochen liegt seltsam verdreht "
		"auf dem Boden. Vielleicht kann man ihn ja umdrehen!");
  AddSpecialDetail( ({"knochen"}), "detailKnochen");
  AddDetail( ({ "boden"}),
		"Der Boden ist kahl und hier und da mit Knochen bedeckt.");
  AddDetail( ({ "waende"}),
		"Hier gibt es keine Waende. Nichts, woran man sich festhalten "
		"koennte.");
  AddDetail( ({ "geraeusche"}),
		"Wenn Du genauer lauschst, hoerst Du die Geraeusche vielleicht "
		"besser?");
  AddDetail( ({ "schreie"}),
		"Lausch, dann hoerst Du die Schreie besser.");
  AddDetail( ({ "mark"}),
		"Mark, befindet sich in Deinen Knochen. Pass besser auf sie auf, "
		"sonst sieht jemand anders Deine Knochen hier liegen.");
  AddDetail( ({ "bein"}),
		"Dein Bein steht halb auf einem Knochen und es knackst verdaechtig.");
  AddDetail( ({ "elben"}),
		"Die Knochen scheinen von Elfen zu stammen und liegen auf dem kahlen "
		"Boden herum.");
  AddDetail( ({ "menschen"}),
		"Auch Knochen von Menschen scheinen hier auf dem kahlen Boden herum "
		"zu liegen.");
  AddDetail( ({ "blick"}),
		"Beim ersten Blick, faellt Dir hier nichts besonderes auf, der zweite "
		"Blick bringt Dir aber auch nicht viel mehr. Also lass es sein.");
  AddDetail( ({ "luft"}),
		"Die Luft hier ist mit dem Geruch der Saeure druchdraengt.");
  AddDetail( ({ "naehe"}),
		"Aus unmittelbaerer Naehe Geraeusche, wenn Du fenau hinhoerst "
		"kannst Du vielleicht mehr hoeren.");
  AddDetail( ({ "nase"}),
		"Was kann man mit der Nase tun? Riechen? Na dann los.");
  AddDetail( ({ "kindern"}),
		"Um zu wissen was es mit den Kindern auf sich hat, solltest "
		"Du lauschen.");
  AddDetail( ({ "personen"}),
		"Auch bei den Personen solltest Du lauschen um genaueres zu "
		"erfahren.");
  //Gerueche:
  AddSmell(DEFAULT_SMELL,
      "Der Geruch von Saeure liegt in der Luft. Du fuehlst Dich nicht wohl.");
  AddSmell( ({"gestank", "geruch", "gerueche"}),
      "Der Geruch von Saeure liegt in der Luft.");
  AddSmell( ({"saeure"}),
      "Die Saeure brennt in Deiner Nase. Atme ja nicht tief ein.");
  AddSound(DEFAULT_SOUND,
      "Seltsame Geraeusche sind in unmittelbarer Naehe zu hoeren.");
  AddSound( ({"geraeusche"}),
      "Die Geraeusche hoeren sich an wie schrille, schmerzvolle Schreie.");
  AddSound( ({"schreie"}),
      "Als Du genauer hinhoerst, faellt Dir auf, das die Schreie "
      "unter Dir sind und sich anhoeren, als ob sie von Kindern "
      "oder sehr jungen Personen sind."); 

  
  // EXITS START
  SetExit (WESTEN);
 
  AddCmd( ({"atme"}), "acid_dam"); 

  AddCmd(  ({ "dreh", "drehe" }), "drehen"  ); 
//  AddCmd( "drehe", "drehen", "drehen" );
//  SetExit( "raus", ROOM "/d/unterwelt/nekromanten/room/yaq_monoq/b3"); 
  // EXITS END

  // ITEMS START
  // ITEMS END

}
int acid_dam(string str) {
  if(!str) return 0;
  if(str!="tief ein") return 0;
  write("Tief atmest Du ein. Die Saeure aetzt Dir die halbe Lunge weg!\n");
  say(BS(sprintf("%s bekommt einen irren Blick und atmet tief ein.", 
          TP->Name(WER))));
  do_room_damage(TP, random(30)+1, "Zwei aufgeloeste Lungenfluegel");
  return 1;
}



