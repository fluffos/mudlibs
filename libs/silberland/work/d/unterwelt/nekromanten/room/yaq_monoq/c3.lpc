int drehen(string str)
{
   
   notify_fail("Was moechtest Du drehen?\n");
   if ( member( ({ "knochen", "knochen um", "knochen herum" }),str) != -1) 
  {
    write(BS( "Scheinbar hast Du mit dem Knochen eine Vorrichtung "
            "betaetigt und einen Zugang gefunden." ));
            
    say( TPN+" fummelt an einem Knochen.\n");
    TP->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 10,
                PARALYZE_MSG: "Ploetlich kracht es unter Dir, der Boden bricht"
		              "bricht unter Deinen Fuessen zusammen und Du faellst "
			      "ohne noch etwas tun zu koennen.\n",
                PARALYZE_END: "Du faellst und faellst immer weiter, stoesst auf etwas "
                              "hartes und merkst, es ist eine alte Treppe und rollst  "
			      "immer weiter, bis das Du liegen bleibst.\n"
                              ]) );
                TP->AddPoison(4);
                TP->AddHp(-15);
                TP->move("/d/unterwelt/nekromanten/room/yaq_monoq/gruft.lpc", M_GO|M_NOCHECK|M_SILENT);

                return 1;

  }
  return 0;

}
		
 

