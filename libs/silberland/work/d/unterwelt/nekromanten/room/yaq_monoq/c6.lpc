#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/yaq_monoq/"+x)
#endif

inherit NEKRO_ISLAND_DIR+"room/std_beach_room";

void create() {

  ::create();
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");

   SetProp(P_INT_LONG,
     "Hier bist Du am Ende des schmalen Weges angekommen "
     "und Du stehst in dichten Saeureschwaden. Ein Schritt zuweit, "
     "bedeutet Deinen sicheren Tod. Behalte Deinen Kopf und kehr um. "
     "Von der hoehen Decke der Hoehle haengen seltsame Gegenstaende "
     "herunter und erinnern Dich an Skelette aber auch an Marionetten. ");

   AddDetail( ({"ende"}),
                "Du bist am Ende des schmalen Weges und solltest "
		"aufpassen was Du tust.");
   AddDetail( ({"weges"}),
                "Hier kannst Du des Weges Ende nichtmal mehr sehen. "
		"Aber Du bist am Ende.");
   AddDetail( ({"Saeureschaden", "schwaden"}),
                "Die Saeureschwaden lassen Dich nichts mehr erkennen, "
		"alles wabert nur noch in einem gelblichen "
		"Saeureschwadennebel um Dich herum.");
   AddDetail( ({"schritt"}),
                "Ja, noch ein Schritt weiter und Du bist des Todes.");
   AddDetail( ({"beine"}),
                "Hoffendlich tragen Deine Beine Dich schnell hier raus.");
   AddDetail( ({ "boden"}),
		 "Den Boden kannst Du nicht erkennen, aber Du koenntest ihn ja "
		 "mal mit Deinem Fuss abtasten?");
   AddSpecialDetail( ({"boden"}), "detailBoden");
   AddDetail( ({ "luft"}),
		 "Du kannst kaum noch wirklich Atmen durch diese stickige Luft.");
   AddDetail( ({ "atmen"}),
		 "Dir faellt das Atmen wirklich schwer.");
   AddDetail( ({ "fuss"}),
		 "Mit Deinem Fuss koenntest Du den Boden einmal abtasten.");
   AddDetail( ({ "saeureschwaden", "schwaden"}),
		 "Durch die Saeureschwaden kannst Du den Boden nicht erkennen.");
   AddDetail( ({ "kopf", "koepfe"}),
		 "Dein Kopf sitzt auf Deinen Schultern, sei froh darueber.");
   AddDetail( ({ "schultern"}),
		 "Auf Deinen Schultern hast Du einen Kopf.");
   AddDetail( ({ "nase"}),
		 "Deine Nase ist zum riechen da, versuch es mal.");
   AddDetail( ({ "haende"}),
                 "Deine Haende solltest Du mal wieder waschen.....");
   AddDetail( ({ "skelette"}),
		 "Hier haengen Skelette von der Decke herunter und "
		 "erinnern Dich an Marionetten. Wie eklig und stinkend sie sind.");
   AddDetail( ({ "marionetten"}),
		 "Wie Marionetten haengen die Skelette von der Decke herunter, "
		 "was das wohl zu bedeuten hat?");
   AddDetail( ({ "gegenstaende"}),
                 "Du betrachtest die Gegenstaende genauer und siehst wage das es "
                 "Skelette sind die wie Marionetten herunter haengen.");		 
                       

  

   
   
  

//Gerueche:
  AddSmell(DEFAULT_SMELL,
      "Der Geruch von Saeure liegt in der Luft. Du fuehlst Dich nicht wohl.");
  AddSmell( ({"gestank", "geruch", "gerueche"}),
      "Der Geruch von Saeure liegt in der Luft.");
  AddSmell( ({"saeure"}),
      "Die Saeure brennt in Deiner Nase. Atme ja nicht tief ein.");
  AddSound(DEFAULT_SOUND,
      "Seltsame Geraeusche sind aus der Ferne zu hoeren.");
  AddSound( ({"geraeusche", "ferne"}),
      "Hoert sich an wie Schreie.");
  AddSound( ({"schreie"}),
      "Seltsam verzerrte Schreie - Du hoerst sie aus weiter Ferne."); 
  

  AddCmd( "taste", "tasten", "taste" );
  AddCmd( ({"atme"}), "acid_dam");

//Die Exits:

   SetExit(WESTEN);
   SetExit(NORDOSTEN);

}

int acid_dam(string str) {
  if(!str) return 0;
  if(str!="tief ein") return 0;
  write("Tief atmest Du ein. Die Saeure aetzt Dir die halbe Lunge weg!\n");
  say(BS(sprintf("%s bekommt einen irren Blick und atmet tief ein.", 
          TP->Name(WER))));
  do_room_damage(TP, random(30)+1, "Zwei aufgeloeste Lungenfluegel");
  return 1;
}

int tasten(string str)
{
   notify_fail("Was moechtest Du abtasten?\n");
   if ( member( ({ "boden", "boden ab" }),str) != -1) 
  {
    write( "Du tastest den Boden ab und trittst dabei auf irgendetwas. "
           "Es gibt ein haessliches quietchen und Du scheinst einen "
           "Mechanismus ausgeloest zu haben.\n" );
    say( TPN+" wuehlt mit seinem Fuss auf dem Boden herum.\n");
    TP->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 30,
                PARALYZE_MSG: "Du wirst gerade durch die Luft geschleudert "
		              "und kannst nichts tun ausser abwarten was passiert.\n",
                PARALYZE_END: "Du kannst Dich zum Glueck wieder bewegen "
                              "und hast eine Chance Dich zu retten.\n"
                              ]) );	
    if ( find_call_out("fall1") == -1 )
      call_out("fall1",7);
    return 1;
  }
 

}
void fall1()
{
  if (!objectp(TP)) return;
  if (ENV(TP)!=TO ) return;
  write(BS( "Als Du merkst das Du einen Hebel runter gedrueckt hast, "
            "ist es schon zu spaet. Du wirst durch die Luft geschleudert "
	    "und klatschst mit voller Wucht in den Saeuresee. Hoffendlich, "
	    "ueberlebst Du das.\n" ));
  if ( find_call_out("fall2") == -1 )   
    call_out("fall2",15);

  
}
void fall2()
{
  TP->AddPoison(4);
  write (BS( "Du strampelst im See als Du in und unter die Saeure platschst "
	     "und versuchst wieder hoch an die Oberflaeche zukommen. Mit "
	     "letzter Kraft gelingt es Dir an das Ufer zu schwimmen. "
             "Geschaft, aber Du solltest schnell Heilung finden, denn "
	     "sonst wirst Du Deinen Frieden finden.\n") );
  TP->move("/d/unterwelt/nekromanten/room/acid_lake/std_acid:-4:-3", M_GO|M_NOCHECK|M_SILENT);
  tell_object(TP,BS(
    "Du klatschst unsanft in den Saeuresee."));
  tell_room(ENV(TP),BS(
    TP->Name()+" faellt von oben in den Saeuresee."),({TP}));
}


