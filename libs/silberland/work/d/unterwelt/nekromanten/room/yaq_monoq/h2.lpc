#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/yaq_monoq/"+x)
#endif

inherit NEKRO_ISLAND_DIR+"room/std_cliff_room";

int golem=0;
int blood=0;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_INT_LONG, "Du stehst hier in der Naehe einer Klippe, die steil "
      "nach unten abfaellt. Das Zischen, welches von unten an Dein Ohr "
      "dringt, klingt gefaehrlich und bedrohlich. Direkt neben der Klippe "
      "steht ein Altar, dessen pechschwarzes Gestein von feinen Adern "
      "durchzogen ist. Daneben liegen ein paar verschrumpelte und verfaulte "
      "Fleischbrocken.");
  
  // ROOM DESCRIPTION END
  
  // DETAILS START
  AddDetail( ({"waende", "wand"}),
      "Du Narr! Hier sind keine Waende!");
  AddDetail( ({"narr"}), 
      "Das bist DU! HARHAR!");
  AddDetail( ({"altar"}),
      "Der Altar steht direkt neben der Klippe. Er besteht aus einem "
      "schwarzem, oelig glaenzenden Gestein, das mit feinen roten Adern "
      "durchzogen ist. "
      "Auf der Oberseite des Altars befindet sich eine kleine Blutrinne, "
      "die von ihm ausgehend ueber die Klippe hinaus ragt. Neben dem Altar "
      "liegen verfaulte und vertrocknete Fleischbrocken und Innereien.");
  AddSpecialDetail( ({"fleischbrocken", "brocken"}),
      "special_detail_h2");
  AddDetail( ({"innereien"}),
      "Die Innereien, die neben dem Altar liegen sind vertrocknet.");
  AddDetail( ({"gestein"}),
      "Das Gestein ist vollkommen schwarz und glaenzt oelig. Als Du genauer "
      "hinsiehst faellt Dir auf, dass es von kleine roten Adern durchzogen "
      "ist.");
  AddDetail( ({"adern"}),
      "Die Adern scheinen sich ganz knapp unter der Oberflaeche zu verbergen. "
      "Irgendwie verleihen sie dem Altar ein plastisches Aussehen. Du schaust "
      "noch einmal genauer hin und stellst fest, dass die Adern leicht "
      "pulsieren");
  AddDetail( ({"aussehen"}),
      "Irgendwie plastisch.");
  AddDetail( ({"oberflaeche"}),
      "Die Adern verlaufen nicht auf der Oberflaeche, sondern darunter. Du "
      "schaust nochmal genauer hin und siehst dass sie pulsieren!!!");
  AddDetail( ({"naehe"}),
      "Geh lieber nicht zu nah an die Klippe, nicht dass Dich wer runter"
      "schubst!");
  AddDetail( ({"oberseite"}),
      "Die Oberseite des Altar ist ein wenig schraeg geneigt. Auf der zur "
      "Klippe gewandten Seite ragt eine Blutrinne ein wenig ueber die Klippe "
      "hinaus.");
  AddDetail( ({"seite"}),
      "Die eine Seite ist etwas abgeschraegt.");
  AddDetail( ({"blutrinne"}),
      "Die Blutrinne ragt ein wenig ueber die Klippe hinaus. Sie dient "
      "wohl dazu, dass das Blut ueber die Klippe abrinnt - aber nur warum?");
  AddDetail( ({"blut"}),
      "Das Blut rinnt ueber die Klippe ab. Wieso? Du weisst es nicht.");
  AddDetail( ({"ohr"}),
      "Das hast Du an Deinem Kopf.");
  AddDetail( ({"kopf"}),
      "Der sitzt noch auf Deinen Schultern.");
  AddDetail( ({"schultern"}),
      "Auf denen sitzt Dein Kopf - noch!");
  AddDetail( ({"boden"}),
      "Der Boden ist aus dem selben Gestein wie der Altar. "
      "Nur diese pulsierenden Adern ist auf dem Boden nicht. ");
  

  // DETAILS END

  // EXITS START
  SetExit (WESTEN);
  SetExit (SUEDOSTEN);
  SetExit (SUEDEN);
  SetExit (SUEDWESTEN);
  // EXITS END

  // ITEMS START
  // ITEMS END
  AddCmd( ({"opfere", "opfer"}), "blood");
}

nosave string special_detail_h2(string key) {
  if(key=="fleischbrocken" || key=="brocken") {
    if(!random(3) && TP->QueryProp(P_GUILD)!=GUILDNAME) {
      call_out("do_room_damage",0, TP, random(3)+1, "Heftiges Erbrechen");
      tell_room(ME, BS(sprintf("%s muss sich ploetzlich uebergeben und "
              "spuckt dabei Blut!", TP->Name(WER,1))));
      return BS("Du verspuerst diesen Brechreiz und uebergibst Dich! Du "
          "uebergibst Dich so heftig, dass Du dabei Blut spuckst!");
    }
  }
}

nosave int blood(string str) {
  int lost_hp;
  notify_fail("Was moechtest Du opfern?\n");
  if(str!="blut") return 0;
  tell_object(TP, BS("Du ritzt Dir Deine Haut auf und laesst ein paar Tropfen "
      "Blut auf den Altar fallen."));
  tell_room(ME, BS(sprintf("%s ritzt sich die Haut auf und laesst ein paar "
      "Tropfen Blut auf den Altar fallen.", TP->Name(WER,1))),({TP}));
  lost_hp=random(5)+5;
  blood+=lost_hp;
  do_room_damage(TP, lost_hp, "Zuviel geopfertes Blut", "");
  if(blood>100 && golem>2) {
    blood=0;
    call_out("clone_blood_golem", 6, TP);
  }  
  return 1;  
}

void reset() {
  ::reset();
  golem++;
}

nosave void clone_blood_golem(object pl) {
  object *pls;
  object ob;
  int x;
  pls=filter_array(all_inventory(ME), "living_check");
  x=random(sizeof(pls));
  ob=clone_object(NEKRO_ISLAND_DIR+"npc/bloodgolem");
  ob->move(ME, M_NOCHECK|M_SILENT);
  ob->SetCaster(pl);
  if(pl->QueryProp(P_GUILD)==GUILDNAME) {
    tell_room(ME, BS("Ploetzlich erscheint wie aus dem Nichts "
           "eine riesige Gestalt aus Blut, Knochen und Fleisch! "));
  }
  else { 
    tell_room(ME, BS(sprintf("Ploetzlich erscheint wie aus dem Nichts "
           "eine riesige Gestalt aus Blut, Knochen und Fleisch! "
           "Sie attackiert %s!", pls[x]->name(WEN, 1))), ({TP}));
    tell_object(pls[x], BS("Ploetzlich erscheint wie aus dem Nichts "
          "eine riesige Gestalt aus Blut, Knochen und Fleisch! Sie "
          "attackiert Dich!"));
    ob->Kill(pls[x]);
  }
  return ;
}
