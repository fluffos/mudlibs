#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include <mnpc.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit NEKRO_ISLAND_DIR "room/std_dungeon";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "An einer dunklen Nische");
  SetProp (P_INT_LONG,
    "Der dunkle, bedrohlich wirkende Gang, der mitten durch den Felsen "
    "fuehrt, endet hier im Sueden an einer massiven Felswand. In diese ist "
    "eine gut 2 Mannslaengen hohe Nische eingelassen, in der eine bedrohlich "
    "wirkende Statue steht. Zu beiden Seiten des Ganges stehen hohe, "
    "schwarze, mit blutroten Adern durchzogene Marmorsaeulen, "
    "die die grob behauene Decke stuetzen. Auch der Boden besteht aus roh "
    "behauenem schwarzen Felsgestein. Nach Norden hin fuehrt ein Gang in "
    "die ungewisse Dunkelheit, nach Nordwesten und Nordosten "
    "beginnen Treppen, die langsam nach oben fuehren.");
  // ROOM DESCRIPTION END

  RemoveDetail(0);
  // DETAILS START
  AddDetail ( ({"boden"}),
    "Der Boden besteht aus aus dem gleichen, grob behauenen, schwarzen "+
    "Felsgestein wie auch Waende und Decke.");
  AddDetail ( ({"decke"}),
    "Die Decke besteht aus grob behauenem, schwarzen Felsgestein und "+
    "woelbt sich ungefaehr zweieinhalb Mannslaengen ueber Dir.");
  AddDetail ( ({"mannslaenge", "mannslaengen", "zwergenlaenge",
                "zwergenlaengen"}),
    "Eine Mannslaenge ist fast das Doppelte einer Zwergenlaenge.");
  AddDetail( ({"doppelte"}),
    "Das Doppelte einer Zwergenlaenge ist in etwa eine Mannslaenge.");
  AddDetail ( ({"dunkelheit", "gang"}),
    "Der Gang nach Norden verschwindet in der ungewissen Dunkelheit. Du "+
    "meinst aber, ein leises Rauschen aus dieser Richtung hoeren zu "+
    "koennen.");
  AddDetail ( ({"rauschen"}),
    "Lausch doch mal!");
  AddSound ( ({DEFAULT_SOUND}),
    "Du meinst ein leises Rauschen aus dem Norden hoeren zu koennen. "+
    "Ansonsten ist es unwirklich still hier.");
  AddSound ( ({"rauschen", "wasser"}),
    "Du lauschst einen Moment genauer - ja, das hoert sich fast wie das "+
    "Rauschen grosser Mengen von Wasser an.");
  AddDetail ( ({"fels", "felsen", "felsgestein",
                "gestein"}),
    "Boden, Waende und Decke sind alle aus dem gleichen, schwarzen, "+
    "lichtschluckenden Gestein - der Gang ist offensichtlich direkt in den "+
    "Felsen hineingeschlagen worden.");
  AddDetail ( ({"felswaende", "felswand", "waende",
                "wand"}),
    "Die Waende zu beiden Seiten des Ganges bestehen aus schwarzem "+
    "Felsgestein. Entlang der Waende steht jeweils eine Reihe von "+
    "schwarzen, mit blutroten Adern durchzogenen Marmorsaeulen, die die "+
    "grob behauene Decke stuetzen. Die Suedwand hingegen ist eine massive "+
    "Wand, in die eine Nische eingelassen ist, in der eine bedrohlich "+
    "wirkende Statue steht.");
  AddDetail ( ({"marmorsaeule", "marmorsaeulen", "saeule",
                "saeulen", "reihe", "seite", "seiten"}),
    "Schwarze, glaenzende Marmorsaeulen stehen zu beiden Seiten des "+
    "Ganges. Die Saeulen sind von einem feinen Geflecht von duennen, "+
    "blutroten Adern durchzogen, die beinah zu pulsieren scheinen.");
  AddDetail ( ({"ader", "adern", "geflecht"}),
    "Ein duennes Geflecht von blutroten Adern durchzieht die Marmorsaeulen "+
    "zu beiden Seiten des Ganges. Die Adern scheinen beinah zu pulsieren.");
  AddDetail ( ({"nische", "suedwand"}),
    "In die Suedwand ist eine deckenhohe Nische geschlagen, in der eine "+
    "grosse, dunkle, bedrohlich wirkende Statue steht.");
  AddDetail ( ({"treppe", "treppen"}),
    "Nach Nordwesten und Nordosten hin beginnen dunkle Treppen, die "+
    "geradewegs nach oben fuehren.");
  AddDetail ( ({"statue", "figur"}),
    "Die deckenhohe Statue stellt eine dunkle, bedrohlich wirkende Figur "
    "maennlichen Geschlechts "+
    "mit 2 grossen Fluegeln auf dem Ruecken dar, die die Arme vor der Brust "+
    "verschraenkt hat und geradewegs durch Dich hindurch den Gang nach "+
    "Norden hinunter zu blicken scheint. Sie traegt eine weite, dunkle "+
    "Robe, hat ein grosses Schwert geguertet und unter der Robe kann man "+
    "ein steinernes Kettenhemd erkennen. Das seltsamste und erschreckendste "
    "an der Statue ist jedoch ihr Gesicht.");
  AddDetail ( ({"arme", "brust"}),
    "Die Statue hat ihre Arme vor der Brust verschraenkt.");
  AddDetail ( ({"fluegel", "ruecken"}),
    "Zwei grosse schwarze Fluegel sind auf dem Ruecken der Statue zu "+
    "erkennen. Ihre fedrige Struktur ist genauestens aus dem Stein "+
    "herausgehauen worden.");
  AddDetail ( ({"feder", "federn", "struktur"}),
    "Wenn die Statue nicht offensichtlich aus Stein waere, wuerdest Du "+
    "denken, dass ihre Fluegel aus Federn bestehen.");
  AddDetail ( ({"geschlecht"}),
    "Dass die Statue maennlichen Geschlechts ist, erkennt man an der "+
    "flachen, muskuloesen Brust und den Gesichtszuegen.");
  AddDetail ( ({"gestein", "stein"}),
    "Der Stein, aus dem die Statue besteht, ist zwar dunkel, fast schwarz, "+
    "aber es scheint eine anderes Gestein zu sein, als der Fels, aus dem "+
    "der ganze Gang herausgehauen ist.");
  AddDetail ( ({"glieder", "kettenhemd"}),
    "Ein steinernes Kettenhemd aus vielen feinen Gliedern ist unter der "+
    "steinernen Robe der Statue zu erkennen.");
  AddDetail ( ({"robe"}),
    "Die Statue ist in eine dunkle, steinerne Robe gekleidet.");
  AddDetail ( ({"gurt", "scheide", "schwert", 
                "waffengurt", "zweihandschwert"}),
    "Ein gewaltiges ,steinernes, wohl zweihaendiges Schwert steckt in der "+
    "Scheide, die am ebenfalls steinernen Waffengurt der Statue haengt.");
  AddDetail ( ({"gesicht", "gesichtszuege", "zuege"}),
    "Als Du das Gesicht der Statue naeher betrachtest, wird Dir ganz kalt. "+
    "Die Augen der Statue wirken lebendig, und doch starren sie genau "+
    "geradeaus den Gang hinunter. Die Gesichtszuege des im ruhigen Zustand "+
    "wohl edlen und schoenen Gesichts scheinen vor Schmerz und Erniedrigung "+
    "verzerrt und unmenschlich. Es scheint ganz so, als handle es sich bei "+
    "der Statue um ein lebendiges Wesen, was bei vollem Bewusstsein in den "+
    "Stein gebannt wurde.");
  AddDetail ( ({"erniedrigung", "schmerz"}),
    "Erniedrigung und Schmerz sind auf dem verzerrten Gesicht der Statue "+
    "deutlich zu erkennen. Dir wird ganz anders.");
  AddDetail ( ({"bewusstsein", "qual", "wesen"}),
    "Was fuer eine Qual muss es fuer ein Wesen sein, bei vollem "+
    "Bewusstsein in einer steinernen Statue gefangen zu sein?");
  // DETAILS END

  // EXITS START
  SetExit(NORDEN);
  SetExit(NORDOSTEN);
  SetExit(NORDWESTEN);
//AddExit("suedenoben", "nach Sueden die Treppe hinauf#/gilden/nekromanten");
//  AddExit("sueden", "nach Sueden die Treppe hinauf#/gilden/nekromanten");
  // EXITS END
  SetProp(P_HIDE_EXITS,({"sueden"}));

  // ITEMS START
  // ITEMS END

  AddItem( ({NEKRO_ISLAND_NPC "skelett",
            NEKRO_ISLAND_NPC "skelettmagier",
            NEKRO_ISLAND_NPC "nekromant"}),
            REFRESH_DESTRUCT, ([P_MNPC_FLAGS:0]));
  AddItem( ({NEKRO_ISLAND_NPC "zzetrach"}), REFRESH_DESTRUCT);
}
