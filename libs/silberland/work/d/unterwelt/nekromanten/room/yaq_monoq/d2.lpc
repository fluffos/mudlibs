#include <properties.h>
#include <moving.h>
#include <mnpc.h>
#include "../nekro.h"
#include "../directions.h"
#include "../../dungeon.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/yaq_monoq/"+x)
#endif

inherit NEKRO_ISLAND_DIR+"room/std_yaq_monoq";


string voices();
int touch_monolith(string str);
string acid_dam();
string sinnlos_unt();

int demon=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_NOBARRIER, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Bei einem dunklen Monolithen");
  SetProp (P_INT_LONG, "Vor Dir ragt ein verdrehter Monolith in die Hoehe, "
      "aehnlich einem duerren Finger einer verkrampften Hand. Er biegt sich "
      "Richtung Suedosten, wo er ueber mit anderen Monolithen eine Art Kuppel "
      "um das Unheiligtum von Yaq'Monoq bildet. Du fuehlst ein Pulsieren in "
      "Dir, so als wuerde Dich unendliche Macht durchstroemen. Du spuerst "
      "foermlich wie Dein Koerper unter dem Ansturm dieser Kraft erbebt. "
      "Aus Richtung des Monolithen vernimmst Du staendig leise Stimmen, die mal "
      "drohender mal flehender werden.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({"monolith"}),
      "Der Monolith ragt wie der Finger einer verkrueppelten Hand in die "
      "Hoehe, nach Suedosten hin gebogen. Eine unnatuerlich pulsierende Kaelte "
      "geht von ihm aus, die Dir das Blut in den Adern gefrieren laesst.");
  AddDetail( ({"hand"}),
      "Die Monolithen sehen wie die groteske Karikatur einer Hand aus, in "
      "deren Flaeche sich das Unheiligtum von Yaq'Monoq befindet.");
  AddDetail( ({"finger", "teil"}), 
      "Die Finger, die Monolithen, Teil einer Hand (?) ragen gespenstisch "
      "in die Hoehe. Es scheint so als wuerden sie etwas fassen wollen.");
  AddDetail( ({"suedosten"}),
     "Sieh doch nach!");
  AddDetail( ({"see", "saeuresee"}),
      "Den siehst Du von hier nicht.");
  AddDetail( ({"karikatur"}),
      "Die Monolithen scheinen eine Art von Hand zu formen (oder bildest "
      "Du Dir das nur ein?), deren Mittelpunkt im Suedosten liegt. ");
  AddDetail( ({"mittelpunkt", "flaeche", "zentrum", "zentrums", "mitte"}),
      "Im Mittelpunkt des Unheiligtum ... was mag dort liegen. Kalte "
      "Schauer jagen ueber Deinen Ruecken bei dem Gedanken ...");
  AddDetail( ({"unheiligtum"}),
      "Das Unheiligtum von Yaq'Monoq befindet sich im Suedosten. Ein "
      "unangenehmes Gefuehl beschleicht Dich bei dem Gedanken "
      "dort wieder hinzugehen.");
  AddDetail( ({"art"}), 
      "Die Monolithen ragen nicht gerade nach oben, sondern sind in Richtung "
      "des Zentrums im Suedosten gebogen. Von ihnen geht eine unnatuerliche "
      "Kaelte aus. Sie scheinen gar nicht richtig fassbar zu sein, als Du "
      "den Monolithen musterst faellt Dir auf das seine Raender unscharf "
      "sind. Sehr seltsam.");
  AddDetail( ({"raender", "rand", "konturen"}),
      "Irgendwie scheint der Monolith da zu sein - oder auch nicht. Seine "
      "Raender, seine Konturen sind nicht scharf und scheinen zu wabern. "
      "Du fragst Dich ob Du ihn ueberhaupt beruehren kannst.");
  AddDetail( ({"kaelte"}),
      "Die Monolithen strahlen eine eisige Kaelte aus.");
  AddSpecialDetail( ({"worte","bedeutung", "gedanken", "schauer", "weitem", 
        "ansturm"}), 
      "sinnlos_unt");
  AddDetail( ({"ruecken"}),
      "Kalt laeuft es Dir ueber Deinen Ruecken.");
  AddDetail( ({"hoehe"}),
      "Hoch nach oben ragt der Monolith, ueberragt Dich bei weitem.");
  AddDetail( ({"adern", "pulsieren"}),
      "Blutrote Adern durchziehen den Monolithen, verleihen ihm ein seltsames "
      "Aussehen. Die Adern scheinen etwas zu pulsieren, so als wuerde Etwas in "
      "ihnen fliessen ...");
  AddDetail( ({"etwas"}),
      "Blut vielleicht? Du kannst nur spekulieren.");
  AddDetail( ({"blut"}),
      "Du weisst es nicht. Es waere moeglich.");
  AddDetail( ({"aussehen"}),
      "Die Adern, die den Monolithen durchziehen, pulsieren in einem sattem "
      "Rot. Die Raender des Monolithen sind irgendwie nicht scharf, Du kannst "
      "sie nicht genau erfassen. Sehr seltsam.");
  AddSpecialDetail("rot", "look_at_red");
  AddDetail( ({"monolithen", "anderen"}),
      "Hier steht nur ein Monolith. Dieser bildet mit den Anderen, die Du "
      "von hier aus erkennen kannst, eine Art Hand, in deren Mitte sich "
      "wohl das Unheiligtum von Yaq'Monoq befindet.");
  AddDetail( ({"kraft"}),
      "Diese Kraft geht eindeutig von dem Monolithen aus! Vielleicht "
      "solltest Du ihn naeher betrachten.");
  AddDetail( ({"boden"}),
      "Der Boden besteht aus schwarzem Fels.");
  AddDetail( ({"fels"}),
      "Der Fels ist kahl und schwarz.");
  AddDetail( ({"koerper"}),
      "DEIN Koerper!");



  

  AddSound(DEFAULT_SOUND, 
      "Du hoerst leise wimmernde Stimmen.");
  AddSound("stimmen", #'voices);
  AddSmell(DEFAULT_SMELL, 
      "Es stinkt nach Saeure. Der Gestank veraetzt Dir fast die "
      "Lunge.");
  AddSmell( ({"saeure", "gestank"}), #'acid_dam);
  AddSmell( ({"lunge"}), #'sinnlos_unt);
  AddCmd( ({"beruehr", "beruehre"}), "touch_monolith");
  
  // EXITS START
  AddExit ("suedosten", "/gilden/nekromanten");
  // EXITS END

  // ITEMS START
  // ITEMS END

}

string sinnlos_unt() {
  do_room_damage(TP, random(2)+1, "Leichtsinnigkeit");
  return BS("So etwas findest Du hier nicht! Achte lieber auf Deine "
      "Umgebung ...");
}

string voices() {
  if(random(100) > TP->QueryProp(P_LEVEL)) {
    write("Diese Stimmen ... Wenn Du den Monolithen nur beruehrst, finden "
        "Sie Erloesung ... wessen Erloesung? ... Warum ? Egal, Du beruehrst "
        "den Monolithen ...");
    say(BS(sprintf("%s Augen werden leicht glasig und %s beruehrt den "
          "Monolithen.", TP->Name(WER), TP->QueryPronoun(WER))));
    touch_monolith("monolith");
    return "";
  }
  return BS("Diese Stimmen ... sie saeuseln von Erloesung wenn Du nur "
    "den Monolithen beruehrst. Mit knapper Not kannst Du Dich davon "
    "abhalten ihren Wunsch zu erfuellen.");
    
}


int touch_monolith(string str) {
  int i;
  object ob;
  if(!str) return 0;
  if(str!="monolith") return 0;
  write("Du beruehrst den Monlolith. Dir schwinden die Sinne.\n");
  TP->SetProp(P_PARALYZED,
        ([PARALYZE_TIME: 30,
          PARALYZE_MSG: "Bewusstlos brichst Du nieder.\n",
          PARALYZE_END: "Du wirst wieder wach!\n",
         ]));
  TP->move("/d/dschungel/feyaria/tijara/room/dimension", M_GO|M_SILENT);
  tell_room(ME, BS(sprintf("%s beruehrt den Monolithen und ist ploetzlich "
          "verschwunden.", TP->Name(WER))));
  call_out("move_demon", 30, random(2)+2);
  if(!demon) return 1;
  tell_room(ME, "Doch dafuer ...\n");
  for(i=random(TP->QueryProp(P_LEVEL)/10);i>=0;i--) {
    ob=clone_object(NEKRO_ISLAND_NPC "demon");
    ob->SetProp(P_AGGRESSIVE, ([P_GUILD:(["nekromanten":0.0,0:1]), ]));
    ob->SetProp(P_MNPC_AREA, NEKRO_ISLAND_DIR );
    ob->SetProp(P_MNPC_WAIT, ({ 20, 6, 16 }));
    ob->SetProp(P_MNPC_DEFAULTROOM, file_name(ME));
    ob->SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_OUTDOORS + MOV_MOVES + 
       MOV_BACKWARDS);
    ob->move(ME, M_TPORT);
  }
  return 1;
}

string look_at_red() {
  if(random(100) > TP->QueryProp(P_LEVEL)) {
    write(BS("Das Rot ist wirklich sehr intensiv ... Du starrst auf die "
        "Farbe, verlierst Dich in dem Pulsieren. Ploetzlich ruht "
        "Deine Hand auf dem Monolithen."));
    say(BS(sprintf("%s Augen werden leicht glasig und %s beruehrt den "
          "Monolithen.", TP->Name(WER), TP->QueryPronoun(WER))));
    touch_monolith("monolith");
    return "";
  }
  return BS("Das Rot ist wirklich sehr intensiv. Fast haettest Du "
      "Dich in das Pulsieren verloren, doch Du schuettelst schnell "
      "Deinen Kopf und fuehlst Dich gleich besser.");
}

string acid_dam() {
  do_room_damage(TP, random(30)+1, "Zwei aufgeloeste Lungenfluegel");
  return "Die Saeure aetzt Dir die halbe Lunge weg!\n";
}

void reset() {
  ::reset();
  demon=1;
}

void move_demon(int number) {
  object ob;
  ob=clone_object(NEKRO_ISLAND_NPC "demon");
  ob->SetProp(P_AGGRESSIVE, ([P_GUILD:([0:1, "nekromanten":0.0]), ]));
  ob->move("/d/dschungel/feyaria/tijara/room/dimension", M_TPORT);
  number--;
  if(number > 0 ) 
    call_out("move_demon", random(10)+10, number);
  return ;
}

