#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit NEKRO_ISLAND_DIR+"room/std_beach_room";

int aliada;

object resetalia;

void create()
{
  ::create();
  aliada=1;
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_INT_LONG, "Hier sind die Saeureschwaden noch intensiver und Du "
		       "kannst kaum die Hand vor Augen sehen. Du kannst nur "
		       "mehr erahnen, in welche Richtung Du gehen kannst. "
		       "Du solltest hier wirklich genau aufpassen wo Du hingehst. "
		       "Wer weis schon, was sich hier verbergen kann.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({ "hand"}),
		"Deine Hand siehst Du so gut wie ueberhaupt nicht mehr, da hier "
		"zuviel der Saeureschwaden Deine Sicht drueben.");
  AddDetail( ({ "sicht"}),
		"Hier hast Du wirklich keine gute Sicht und solltest aufpassen "
		"wo du hingehst.");
  AddDetail( ({ "richtung"}),
		"Die Richtung kannst Du so nicht erkennen, in die Du gehen kannst, "
		"da solltest Du besser mal im Nebel erahnen, in welche Richtung Du "
		"gehen kannst.");	
  AddDetail( ({ "saeureschwaden", "schwaden"}),
		"Die Saeureschwaden haben einen gelblichen Farbton und aehneln "
		"einem dichten undurchschaubaren Nebel.");
  AddDetail( ({ "farbton"}),
		"Der gelbliche Farbton laesst Dich erschauern, das kann nichts "
		"gutes heissen.");
  AddDetail( ({ "augen"}),
		"Deine Augen brennen leicht und Du wuerdest am liebsten schreiend "
		"davon laufen.");
  AddDetail( ({ "boden"}),
		 "Den Boden kannst Du ebenso wenig erkennen, haette Dir auch logisch "
		 "sein muessen. Tsts.");
  AddDetail( ({ "luft"}),
                "Die Luft hier brennt durch die Saeure und Deine Augen jucken.");
  AddDetail( ({ "nase"}),
		"Mit Deiner Nase saugst Du, die durch Saeure getraenkte Luft ein.");

  AddSpecialDetail( ({ "nebel"}),"detailNebel" );

  AddSmell(DEFAULT_SMELL,
      "Der Geruch von Saeure liegt in der Luft. Du fuehlst Dich nicht wohl.");
  AddSmell( ({"gestank", "geruch", "gerueche"}),
      "Der Geruch von Saeure liegt in der Luft.");
  AddSmell( ({"saeure"}),
      "Die Saeure brennt in Deiner Nase. Atme ja nicht tief ein.");
  AddSound(DEFAULT_SOUND,
      "Seltsame Geraeusche sind aus der Ferne zu hoeren.");
  AddSound( ({"geraeusche", "ferne"}),
      "Hoert sich an wie Schreie.");
  AddSound( ({"schreie"}),
      "Seltsam verzerrte Schreie - Du hoerst sie aus weiter Ferne.");

  // DETAILS END
AddCmd( "erahne", "erahnen" );
  // EXITS START
  SetExit (OSTEN);
  SetExit (NORDWESTEN);
  // EXITS END

  // ITEMS START
  // ITEMS END

}
string detailNebel()
{
  if (!present("HIRIALIA",TO))
    return("Dieser Nebel scheint ein Geheimnis zu verbergen das Du nur "
           "erahnen kannst.\n");
  return("Du musst Dich wohl getaeuscht haben, hier ist kein Geheimnis "
	 "zu erahnen.\n");
}
void reset()
{
  ::reset();
  aliada=1;
  resetalia=present("HIRIALIA",TO); 

  
}

int erahnen (string str)
{
  object alia;
  notify_fail ("Was moechtest Du machen?\n");

  if(!str || str == "") return 0;
  if(!(str == "nebel"         ||
       str == "nebelschwaden"  )) return 0;
  if (present("HIRIALIA",TO) || !aliada)

  {
    write(BS("Du kannst gerade nichts erkennen."));
    return -1;
  }
  write(BS("Du erahnst irgendwie das es hier nach Osten und Nordwesten geht. "
           "Aber da scheint etwas im Nebel auf Dich zu lauern und wird sich "
	   "Dir Offenbaren.\n"));
  aliada=0;
  alia = clone_object ( NEKRO_ISLAND_NPC "saeuralia");
  alia->move(TO,M_GO|M_NOCHECK,"schwebt");
  return 1;
}

int acid_dam(string str) {
  if(!str) return 0;
  if(str!="tief ein") return 0;
  write("Tief atmest Du ein. Die Saeure aetzt Dir die halbe Lunge weg!\n");
  say(BS(sprintf("%s bekommt einen irren Blick und atmet tief ein.", 
          TP->Name(WER))));
  do_room_damage(TP, random(30)+1, "Zwei aufgeloeste Lungenfluegel");
  return 1;
}

