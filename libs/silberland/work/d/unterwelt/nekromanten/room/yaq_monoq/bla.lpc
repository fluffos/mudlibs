
void move_demon(int number) {
  object ob;
  ob=clone_object(NEKRO_ISLAND_NPC "demon");
  ob->SetProp(P_AGGRESSIVE, ([0:1, P_GUILD:(["nekromanten":0]), ]));
  ob->move("/d/dschungel/feyaria/tijara/room/dimension", M_TPORT);
  number--;
  if(number > 0 ) 
    call_out("move_demon", random(10)+10, number);
  return ;
}
