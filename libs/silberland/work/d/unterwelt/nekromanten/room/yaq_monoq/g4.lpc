#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"
#define P_SEERDOOR_DISCOVER "rw_sehertor_disc"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit NEKRO_ISLAND_DIR+"room/std_yaq_monoq";


void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp( P_INT_LONG,
      "Absolute Stille, kein Geraeusch ist zu hoeren, von Deinem eigenen "
      "Atem abgesehen. Dein Blick faellt auf eine grosse Steinplatte, die "
      "im Boden eingelassen ist, die sich vom umgebenden schwarzem Fels "
      "abhebt. Seltsame Symbole sind auf der Platte eingraviert, pulsieren "
      "in einem dunklem Rot und geben der ganzen Szenerie ein unheilvolles "
      "Aussehen.");
  // ROOM DESCRIPTION END
  AddDetail( ({"atem"}), 
      "Du siehst Deinen Atem nicht. Sei froh das Du noch atmen kannst!");
  AddDetail( ({"fels"}),
      "Der Fels ist kalt und schwarz.");
  AddSpecialDetail( ({"szenerie", "umgebung"}), "_query_int_long");
  AddDetail( ({"aussehen"}),
      "Dich schaudert. Du solltest schnell weitergehen bevor noch etwas "
      "passiert.");
  AddDetail( ({"platte", "steinplatte", "rest"}),
      "Im Boden ist eine Steinplatte eingelassen. Schwarz, so wie der Fels "
      "selber, hebt sie sich nur durch ihre polierte Oberflaeche und den "
      "rotgluehenden Zeichen, die auf ihr eingraviert sind, vom Rest der "
      "Umgebung ab.");
  AddSpecialDetail( ({"zeichen", "symbole", "bedeutung", "teleportation"}), 
      "special_details");
  AddSpecialDetail( ({"bedeutung"}), "special_details");
  AddDetail( ({"boden"}),
      "Eine merkwuerdige Steinplatte ist im felsigen Boden eingelassen. "
      "Symbole, die in einem satten Rot pulsieren, sind in die Platte "
      "eingelassen.");
  AddDetail( ({"rot"}),
      "Das Rot der Symbole pulsiert.");
  AddDetail( ({"oberflaeche"}),
      "Die Oberflaeche der Steinplatte ist blank poliert und reflektiert das "
      "pulsierende Rot der Symbole.");
  AddDetail( ({ "lunge"}),
      "Atme tief ein, dann spuerst Du Deine Lunge mal ganz deutlich.");
  AddDetail( ({ "blick"}),
      "Dein Blick faellt auf eine grosse Steinplatte, die im Boden eingelassen "
      "worden ist."); 


  AddSound(DEFAULT_SOUND, 
      "Nichts ist zu hoeren. Nur Stille ...");
  AddSound( ({"stille", "geraeusch"}),
      "Nichts ist zu hoeren. Nur Stille ...");

  AddSmell(DEFAULT_SMELL,
      "Der allgegenwaertige Geruch von Saeure ist zu riechen.");
  AddSmell( ({"geruch", "saeure"}),
      "Atme nicht zu tief, sonst veraetzt Dir die Saeure die Lunge.");

  // DETAILS START
  // DETAILS END

  // EXITS START
  SetExit (SUEDWESTEN);
  SetExit (NORDOSTEN);
  SetExit (NORDEN);
  // EXITS END

  // ITEMS START
  // ITEMS END
  AddCmd( ({"betrete"}), "enter_field");
  AddCmd( ({"atme"}), "breath");

  AddItem("/obj/sehertor", REFRESH_REMOVE, ([P_SEERDOOR_DISCOVER: 0]) );

}

string special_details(string key) {
  string ret;
  switch(key) {
    case "zeichen":
    case "symbole":
         if(TP->QueryProp(P_GUILD) != "nekromanten")
            ret="Die Symbole pulsieren blutrot. Leider kennst Du ihre "
                "Bedeutung nicht.";
         else 
            ret="Die rotgluehenden Symbole sind eindeutig Zeichen der "
                   "Teleportation. Du musst Dich nur auf die Platte stellen "
                   "und Du wirst wegteleportiert, soweit Du das erkennen "
                   "kannst.";
         break;
    case "bedeutung":
         if(TP->QueryProp(P_GUILD) != "nekromanten")
           ret="Du hast leider keine Ahnung was die Symbole bedeuten "
             "koennten.";
         else
           ret="Die Symbole sind eindeutig Zeichen der Teleportation.";
         break;
    case "teleportation":
         if(TP->QueryProp(P_GUILD) != "nekromanten")
           ret="Wie bitte?";
         else 
           ret="Du muesstest Dich schon auf die Platte stellen ('betrete "
             "steinplatte') um es herauszufinden.";
    break;
    default: ret="Wie bitte?";
  }
  return BS(ret);
}

int enter_field(string str) {
  if(!str) return 0;
  if(str != "steinplatte") return 0;

  write(BS("Mit einem lauten Kreischen oeffnet sich vor dir ein blutiger Riss zwischen den Welten!"));

  if(TP->QueryProp(P_GUILD) == "nekromanten" && call_other("/obj/sehertormaster", "DoorIsKnown")) {
    write(BS("Xarfai teilt Dir mit: Du kannst den Riss bereits nutzen, DU VERSAGER!"));
    return 1;
  }

  if(!call_other("/obj/sehertormaster", "DiscoverDoor")) {
    write(BS("DU NARR! Du bist wohl zu schwach, um die Macht des Portals zu nutzen!"));
    write(BS("Mit einem grausamen Schmatzen saugt dich das Portal ein."));
    TP->move("/d/dschungel/feyaria/tijara/room/dimension", M_TPORT,
      "ploetzlich", "verschwindet", "taucht ploetzlich aus dem Nichts auf");
    call_out("move_daemon", 30);
  }

  return 1;
}

void move_daemon() {
  object ob;
  if(present("daemon", 
        find_object("/d/dschungel/feyaria/tijara/room/dimension"))) 
  {
    return;
  }
  ob=clone_object(NEKRO_ISLAND_NPC "demon");
  ob->SetProp(P_AGGRESSIVE, ([P_GUILD:(["nekromanten":0.0, 0:1]) ]));
  ob->move("/d/dschungel/feyaria/tijara/room/dimension", M_TPORT);
  return;
}

int breath(string str) {
  if(!str) return 0;
  if(str != "tief" && str != "tief ein") return 0;
  write("Du atmest tief ein. Herrlich diese Saeure.\n");
  say(sprintf("%s atmet tief ein.", TP->Name(WER)));
  do_room_damage(TP, random(40)+20, "Zwei aufgeloeste Lungenfluegel");
  return 1;
}

public int _query_tport_cost_in() { 
  int cost;
  cost=0;

  if ( TP->QueryProp(P_GUILD) == "paladine") {
    return 333;
  } else if( TP->QueryProp(P_GUILD) != "nekromanten" ) {
    return 100;
  } 

  if( TP && intp(TP->QueryProp(P_ALIGN)) )
    cost=TP->QueryProp(P_ALIGN)/400;
  return cost;
}

public int _query_tport_cost_out() { 
  int cost;
  cost=0;

  if ( TP->QueryProp(P_GUILD) == "paladine") {
    return 333;
  } else if( TP->QueryProp(P_GUILD) != "nekromanten" ) {
    return 100;
  }

  if( TP && intp(TP->QueryProp(P_ALIGN)) )
    cost=TP->QueryProp(P_ALIGN)/400;
  return cost;
}
