#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit NEKRO_ISLAND_DIR "room/std_beach_room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_INT_LONG, 
      "Dieses Stueck der Insel ist ueber und ueber mit Knochensplittern "
      "uebersaeht. Die Groesse der Splitter laesst darauf schliessen, das "
      "was immer hier verendet ist sehr gross war ... und die Tatsache das "
      "hier nur Splitter liegen laesst auch darauf schliessen wie gross "
      "die Macht dessen war, der es vernichtet hat. Die Splitter, die zu "
      "nah am Saeuresee lagen, wurden bereits aufgeloest.");
  // ROOM DESCRIPTION END
  AddDetail( ({"boden"}),
      "Der Boden ist ueber und ueber mit Knochensplittern uebersaeht!");
  AddDetail( ({"splitter", "knochensplitter"}),
      "Die Knochensplitter sind sehr gross. Was immer hier vernichtet "
      "wurde, ist wohl von innen heraus zerfetzt worden.");
  AddDetail( ({"groesse", "sehr", "gross"}),
      "Was immer das war, es war SEHR GROSS.");
  AddDetail( ({"saeuresee", "see"}),
      "Der Saeuresee erstreckt sich weit in die Hoehle hinein. Du kannst "
      "das andere Ufer nicht erkennen.");
  AddDetail( ({"ufer"}),
      "Das andere Ufer kannst Du nicht erkennen. Saeureschwaden behindern "
      "am See Deine Sicht.");
  AddDetail( ({"sicht"}),
      "Die Saeureschwaden behindern Deine Sicht. Vielleicht solltest Du "
      "fester auf den See hinaus starren.");
  AddDetail( ({"schwaden", "saeureschwaden"}),
      "Die Saeureschwaden ziehen auf dem See umher. Sie behindern Deine "
      "Sicht ziemlich, so dass Du das andere Ufer nicht erkennen kannst.");
  AddDetail( ({"bedeutung"}),
      "Bedeutung?");
  AddDetail( ({ "tatsache"}),
      "Tatsache ist, das hier ueberall Splitter herum liegen.");
  AddDetail( ({ "stueck"}),
      "Du bist an einem Stueck der Insel angelangt, welches ueber und ueber "
      "mit Knochensplittern uebersaeht ist.");


  
  AddSound(DEFAULT_SOUND,
      "Seltsame Geraeusche sind aus der Ferne zu hoeren.");
  AddSound( ({"geraeusche", "ferne"}),
      "Hoert sich an wie Schreie.");
  AddSound( ({"schreie"}),
      "Seltsam verzerrte Schreie - Du hoerst sie aus weiter Ferne.");
  AddDetail( ({"nase"}),
      "Deine Nase nimm seltsame Gerueche war.");
  AddSmell(DEFAULT_SMELL,
      "Der Geruch von Saeure liegt in der Luft.");
  AddSmell( ({"gestank", "geruch", "gerueche"}),
      "Der Geruch von Saeure liegt in der Luft.");
  AddSmell( ({"luft"}),
      "Die Luft hat den Geruch von Saeure.");
  AddSmell( ({"saeure"}),
      "Die Saeure brennt in Deiner Nase. Atme ja nicht tief ein.");


  // DETAILS START
  // DETAILS END

  // EXITS START
  SetExit (NORDEN);
  SetExit (SUEDWESTEN);
  // EXITS END

  // ITEMS START
  // ITEMS END
  AddCmd( ({"atme"}), "acid_dam");
  AddCmd( ({"starre", "starr"}), "lookahead");

}
int acid_dam(string str) {
  if(!str) return 0;
  if(str!="tief ein") return 0;
  write("Tief atmest Du ein. Die Saeure aetzt Dir die halbe Lunge weg!\n");
  say(BS(sprintf("%s bekommt einen irren Blick und atmet tief ein.", 
          TP->Name(WER))));
  do_room_damage(TP, random(30)+1, "Zwei aufgeloeste Lungenfluegel");
  return 1;
}
int lookahead(string str) {
  if(!str) return 0;
  if(str !="fester auf den See hinaus")
    return 0;
  write("WAHHHHHHH DIE SAEURE! DIE SAEURE! DEINE AUGEN! WAAARG!\n");
  say(BS(sprintf("%s schlaegt die Haende vor den Augen zusammen und "
          "schreit wie von Sinnen.",TP->Name(WER))));
  TP->SetProp(P_BLIND, 100+random(300));
  do_room_damage(TP, random(20), "Saeure", "Da wo Du hingehst brauchst Du "
      "keine Augen");
  return 1;
}
