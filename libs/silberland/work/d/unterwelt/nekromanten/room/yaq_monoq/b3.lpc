#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

//inherit NEKRO_ISLAND_DIR+"room/std_yaq_monoq";

inherit NEKRO_ISLAND_DIR "room/std_beach_room";

int daemonenkraut_zahl=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_INT_LONG, "Du befindest Dich hier am Rand des Saeuresees, aus "
		       "dem sich die Insel Yaq'Monoq erhebt. Der Sand auf "
		       "dem Du hier stehst, sieht auf irgendeine Art sehr "
		       "dunkel und bedrohlich aus. Er wird nur, direkt am "
		       "Ufer des Sees durch gebleichte senfgelbe Sandkoerner "
		       "etwas heller. Der Saeuresee schimmert dunkel und seine "
		       "Oberflaeche ist vollkommen ruhig. Du kannst die Decke "
		       "der Hoehle nicht mehr erkennen, da sie viel zu weit "
		       "ueber Dir ist. Seltsame Pflanzen wachsen hier und Du "
		       "fuehlst Dich durch eine unbekannte Macht bedroht. Im "
		       "Nordosten kannst Du einen Hang erkennen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail( ({ "art"}),
		"Auf eine seltsame Art, die Dich sehr beunruhigt, besteht der "
	        "Sand hier, aus feinen kleinen schwarzen Sandkoernern.");
  AddDetail( ({ "boden"}),
		"Wie Du bemerkt haben solltest, besteht der Boden aus "
		"schwarzem Sand.");
  AddDetail( ({ "decke"}),
		"Die Decke dieser Hoehle kannst Du hier kaum erkennen, "
		"da sie viel zu weit ueber Dir ist. Aber Dir fallen ab "
		"und zu ein paar kleine Schatten auf, die an der Decke "
		"hin und her huschen.");
  AddDetail( ({ "schatten", "vogel"}),
		"Die Schatten sehen aus wie kleine Voegel, aber wie "
		"sollten hier Voegel ueberleben koennen, es muss schon "
		"etwas anderes sein, was dort oben herum fliegt. "
		"Geheuer ist Dir das nicht und Dich packt eine Furcht "
		"die Du noch nicht verstehen kannst.");
  AddDetail( ({ "furcht"}),
		"Deine Furcht ist Dir unangenehm, auch weil Du sie nicht "
		"verstehst.");
  AddDetail( ({ "voegel"}),
		"Es koennen keine Voegel sein, die wuerden hier nicht "
		"ueberleben koennen.");
  AddDetail( ({ "hang","nordosten"}),
		"Du koenntest ja mal nach Nordosten gehen um den Hang "
		"wirklich genau erforschen zu koennen.");
  AddDetail( ({ "hoehle"}),
		"In dieser grossen Hoehle hat sich der Saeuresee vor "
		"langer Zeit gebildet und die Insel, auf der Du gerade "
		"stehst, ist ebenso vor langer Zeit hier aufgetaucht. "
		"Ob diese Macht die Du spuerst, die Insel entstehen "
		"hat lassen?");
  AddDetail( ({ "zeit"}),
		"Vor langer Zeit hat sich dieser Saeuresee hier gebildet "
	        "und die Insel ebenso.");
  AddDetail( ({ "insel"}),
		"Du befindest Dich auf der Insel Yaq'Monoq, die von "
		"einem Saeuresee umgeben ist.");
  AddDetail( ({ "macht"}),
		"Diese Macht die Du hier spuerst, laesst Dir eiskalten "
		"Angstschweiss den Ruecken herunter laufen und Deine "
		"Nackenhaare kleben an Dir fest.");
  AddDetail( ({ "angstschweiss", "schweiss"}),
		"Naja, sehen wirst Du Deinen Angstschweiss wohl kaum "
		"koennen, versuchs mal mit riechen, wenn Du drauf stehst.");
  AddDetail( ({ "nackenhaare"}),
		"Es ist verwunderlich das Deine Nackenhaare sich ueberhaupt "
		"noch aufstellen koennen. Du bist so klitschnass von Deinem "
		"Angstschweiss, dass sie normal an Dir kleben muessten.");
  AddDetail( ({ "ruecken"}),
		"Dir laeuft der pure Angstschweiss den Ruecken herunter, "
		"vielleicht solltest Du besser von hier verschwinden.....");
  AddDetail( ({ "pflanzen"}),
		"Du staunst nicht schlecht, als Du hier Pflanzen findest. "
		"Da Du Dir nicht vorstellen kannst, dass sie hier  "
		"ueberhaupt genug Feuchtigkeit erhalten. Du schaust es Dir "
		"genauer an und eine innere Stimme sagt Dir das es "
		"Daemonenkraut ist.");
  AddDetail( ({ "stimme"}),
		"Die innere Stimme sagt Dir, dass es sich hier um "
		"Daemonenkraut handelt.");
  AddDetail( ({ "daemonenkraut", "kraut", "daemonenkraeuter", "kraeuter"}),
		"Das Daemonenkraut, waechst an den Daemonenkrautstraeuchern "
		"und ist schwarzviolett, Du kannst es vielleicht aus dem "
		"Bluetenkelch heraus ziehen.");
  AddSpecialDetail( ({ "daemonenkraut", "kraut", "daemonenkraeuter", 
		       "kraeuter"}),"detailDaemonenkraut" );
  AddDetail( ({ "bluete"}),
		"Violettschwarzen Faeden bilden die Blueten, die sehr "
		"unangenehm riechen.");
  AddDetail( ({ "frucht"}),
		"Die Frucht dieser Daemonenkrautstraeucher, ist auch "
		"ebenso Bluete und stinkt widerlich:");
  AddDetail( ({ "faeden","einem"}),
		"Die Faeden des Daemonenkrautes sind Frucht und Bluete "
		"in Einem. Sie bilden sich aus einem engen Bluetenkelch. "
	        "Dieser umgibt sie mittig um sie zu schuetzen. Die "
		"violettschwarze Farbe sieht irgendwie unheilvoll aus.");
  AddDetail( ({ "bluetenkelch", "kelch", "daemonenkraut"}),
		"Der Bluetenkelch umschliesst violettschwarze Faeden. "
		"Sie sehen so aus als wuerden sich die "
		"Bluetenkelche etwas oeffnen wenn Du sie beruehrst. "
                "Vielleicht kann man das Daemonenkraut ja aus dem "
		"Bluetenkelch heraus ziehen?");
  AddDetail( ({ "farbe"}),
		"Die Farbe des Daemonenkrautstrauches ist violettschwarz.");
  AddDetail( ({ "daemonenkrautstraeucher", "straeucher","strauch",
                "daemonenkrautstrauch"}),
		"Die Daemonenkrautstraeucher wachsen hier zwar, aber auch "
	        "nur spaerlich.");
  AddDetail( ({ "daemonenkrautstrauches"}),
		"Das solltest Du aber nun schon wissen, was das ist.");
  AddDetail( ({ "straeuchlein"}),
		"Zwei kleine Straeuchlein siehst Du hier wachsen.");
  AddDetail( ({ "feuchtigkeit"}),
		"Die Feuchtigkeit, die das Daemonenkraeuter benoetigt, "
		"zieht es sich ganz bestimmt aus dem sandigen Boden. "
                "Vielleicht brauchen sie aber auch Saeure, wer weiss ...");
  AddDetail( ({ "rand"}),
		"Du stehst direkt am Rand des Saeuresees und fuehlst Dich "
		"ueberhaupt nicht wohl.");
  AddDetail( ({ "saeuresee", "see","sees"}),
		"Der Saeuresee umgibt die Insel und es riecht hier einfach " 
		"nur nach veraetzender Saeure.");
  AddDetail( ({ "sand"}),
		"Der Sand ist schwarz und nur am Rand des Sees wird er senfgelb.");
  AddDetail( ({ "sandkoerner", "koerner"}),
		"Die Sandkoerner sind fein und teilweise schwarz oder "
	        "senfgelb.");
  AddDetail( ({ "oberflaeche"}),
		"Die Oberflaeche des Saeuresees ist ruhig, Du kannst aber nicht "
		"ausmachen wie tief der Saeuresee wirklich ist.");
  AddDetail( ({ "ufer"}),
		"Du stehst am Ufer des Saeuresees und kannst Dich gluecklich schaetzen, "
		"das Du nicht durch heranrollende Wellen voll Saeure gespritzt wirst.");
  AddDetail( ({ "wellen"}),
		"Du kannst froh sein, das keine Wellen da sind.");
  AddDetail( ({ "saeure"}),
		"Der See besteht aus aetzender Saeure. Stolper nicht, Dein Verderben wartet "
		"schon auf Dich.");
  AddDetail( ({ "waende"}),
		"Waende kannst Du hier nicht sehen, und die der Hoehle sind zu "
		"weit entfernt um sie "
	        "zu erkennen");
  AddDetail( ({ "wand"}),
		"Auch eine Wand kannst Du nicht sehen, die ist auch zu weit weg.");  
  AddDetail( ({ "sache"}),
		"Die Sache ist einfach nur eklig und treibt Dir den Angstschweiss "
		"heraus.");
  AddDetail( ({ "zaehne"}),
		"Hast Du keine Zaehne? Oder wieso fragst Du so dumm danach?");
  AddDetail( ({ "yaq'monoq"}),
		"Du befindest Dich auf der Insel Yaq'Monoq, diese ist von einem "
		"Saeuresee umgeben.");
  
  AddSpecialDetail( ({ "verderben"}),"detailLars" );
  AddSmell( DEFAULT_SMELL,
		"Der Gestank des Saeuresees steigt Dir in die Nase.");
  AddSmell( ({ "gestank", "see", "saeuresee"}),
	       "Der Gestank ist so widerlich, das Du fast brechen musst.");
  AddSmell( ({ "angstschweiss" }),
      "Der Gestank des Saeuresees uebertuencht hier alles!");
  AddSmell( ({ "nase" }),
      "Deine Nase riecht alles!");
  AddSmell( ({ "bluete" }),
      "Dun riechst an der Bluete und faengst unweigerlich an zu wuergen.");
  // DETAILS END

  // EXITS START
  SetExit(SUEDEN);
  SetExit(OSTEN);
  SetExit(NORDOSTEN);

  AddCmd ( ({"zieh", "ziehe" }), "ziehen" );  
  AddItem( ({NEKRO_ISLAND_NPC "xarfaros"}), REFRESH_DESTRUCT);

}


  // EXITS END

  // ITEMS START
  
 
  // ITEMS END

void meinefunktion() { return; }
  
  string detailLars()
  {   
      	  call_out("player_die", 2);	
    
         return(BS("Dein Verderben ... HARHARRR!"));
        
}

  
void player_die()
{
  if(!TP)
    return;
  write(BS("Dein Wunsch sei mir Befehl."));
  TP->SetProp(P_KILLER, TO);
  SetProp(P_KILL_NAME, "Wuensche des Verderbens");
  TP->SetProp(P_GHOST, 1);
  TP->move("/room/death/death_room", M_NOCHECK|M_NO_SHOW|M_SILENT);
  TP->SetProp(P_KILLER, 0);
  return; 
}

void reset()
{
  ::reset();
  daemonenkraut_zahl=1;
}

string detaildaemonenkraut()
{
 if(daemonenkraut_zahl==1)
 {return(BS("Das Daemonekraut ist violettschwarz und Frucht und Bluete "
           "in einem. Ob man das Daemonenkraut essen kann?"));}
  return(BS("Da das Daemonenkraut nur spaerlich waechst, musst Du  "
           "wohl noch ein wenig warten, bis Du welches bekommen kannst."));
}



int ziehen(string str)
{
  object daemonenkraut;
  notify_fail( "An was moechtest Du ziehen?\n" );
  if ( member( ({ "an daemonenkraut", "daemonenkraut von",
          "daemonenkraut von dem busch" }), str ) != -1 )
  {
    if( daemonenkraut_zahl < 1 )
    {
      write(BS("Du ziehst an dem Daemonenkraut, aber der Bluetenkelch "
            "schliesst sich, als Du daran ziehst."));
      say(sprintf("%s zieht an dem Daemonenkraut.\n", TP->Name(WER)));
      return -1;
    }
    if ( present("HIRIKRAUT",TP) )
    {
      write(BS("Da Du bereits ein Daemonenkraut hast, solltest Du nicht "
          +"weiter an dem Daemonenkraut ziehen." ));
      say(sprintf("%s glaubt die Masse macht es und zieht wie Irr "
            +"an dem Daemonenkraut.\n", TP->Name(WER)));
      return -1;
    }
    else
    {
      {
        daemonenkraut = clone_object(NEKRO_ISLAND_OBJ+"daemonenkraut");
        if ( ME_TOO_HEAVY == daemonenkraut->move(TP,M_GET|M_SILENT) )
        {
          write(
              "Das Daemonenkraut wuerde Dir zu schwer werden.\n" );
          say(BS(sprintf("%s zieht an dem Daemonenkrautbusch herum, "
                  "scheinbar ist er nicht kraeftig genug fuer so ein leichtes Kraut.\n", TP->Name(WER))));
          daemonenkraut -> remove();
          return 1;
        }
        else
        {
          write("Du ziehst an dem Daemonenkraut und steckst es "
              "sofort gierig ein.\n");
          say(sprintf("%s zieht an dem Busch und steckt etwas gierig ein.\n",
                TP->Name(WER)));
          daemonenkraut_zahl--;
          return 1;
        }
      }
    }
    return 0;
  }
  return 0;
}
