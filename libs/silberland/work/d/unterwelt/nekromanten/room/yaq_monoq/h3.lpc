#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/"+x)
#endif

inherit NEKRO_ISLAND_DIR+"room/std_yaq_monoq";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:14]));
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_INT_LONG, "Der Boden ist hier mit einem leichten Bodennebel "
      "bedeckt, der die gesamte Landschaft in eine wabernde Karikatur "
      "eines Wahnsinnigen verwandelt. Einige verkrueppelte Baeume stehen "
      "in der Naehe, deren Aeste sich knarrend im nichtvorhandenen Wind "
      "bewegen. Am Boden befinden sich etliche verwitterte Grabsteine, die "
      "auf der schwarzen und verbrannten Erde wie eine Warnung an "
      "die Lebenden wirken.");
  // ROOM DESCRIPTION END

  // DETAILS START

  AddDetail( ({ "boden" }),
      "Den Boden kannst Du nur erahnen, da er mit einem leichten Bodennebel "
      "bedeckt ist. Du spuerst nur Deine Schritte, die auf mehr oder weniger "
      "festen Untergrund treffen." );
  AddDetail( ({ "bodennebel","nebel","nebelschleier" }),
      "Der Bodennebel bedeckt wie sein Name schon sagt den ganzen Boden. Durch "
      "ihn scheint Dir alles darunter liegende in einem verzerrten Bild und "
      "ganz wohl fuehlst Du Dich bei dem Nebel auch nicht, der von Minute zu "
      "Minute anzusteigen scheint." );
  AddDetail( ({"name"}),
      "Der Bodennebel bedeckt den ganzen Boden. Dich froestelt leicht.");  
  AddDetail( ({"bild"}),
      "Du kannst nur ganz wenig erkennen. Der Nebel ist viel zu dicht.");
  AddDetail( ({ "minute" }),
      "Taeuscht Du Dich da nicht etwas? Du siehst nochmal genauer hin, aber Du "
      "vermagst einfach nicht genau zu sagen, ob der Nebel nun steigt oder "
      "nicht.");
  AddDetail( ({ "schritte" }),
      "Du gehst ganz vorsichtig, jedoch siehst Du einfach nicht genau wo Du "
      "hintreten kannst und wo nicht.");
  AddDetail( ({ "untergrund" }),
      "Den Untergrund kannst Du leider durch den Nebel nicht richtig erkennen! "
      "Pass bloss auf das Du nirgends haengenbleibst und stuerzt.");
  AddDetail( ({ "landschaft" }),
      "Das meiste der Landschaft bleibt Dir aufgrund des merkwuerdigen Nebels "
      "leider verborgen. Aber vielleicht ist das auch gut so. Einige Baeume und "
      "ein paar Grabsteine kannst Du gerade noch ausmachen." );
  AddDetail( ({ "karikatur","wahnsinniger","wahnsinnigen" }),
      "Das ganze kommt Dir wie eine wabernde Karikatur eines Wahnsinnigen vor. "
      "Hoffentlich drehst Du nicht auch noch durch, denn irgendwie ueberkommt "
      "Dich ploetzlich der Verfolgungswahn." );
  AddDetail( ({ "baeume" }),
      "Die Baeume sind sehr verkrueppelt und keinerlei Blaetter sind an ihnen "
      "zu ihnen zu sehen. Die Aeste knarre im Wind und ein paar sehen Fingern "
      "einer unheilbringenden Gestalt aehnlich, die jederzeit nach Dir greifen "
      "koennten." );
  AddDetail( ({ "gestalt" }),
      "Tatsaechlich. Als Du die Baeume laenger betrachtest kommt es Dir so vor, "
      "als haetten sie tatsaechlich eine humane Gestalt!!! Vielleicht waren es "
      "frueher sogar einmal humane Wesen!");
  AddDetail( ({ "gestalt" }),
      "Irgendetwas muss diese armen Gestalten in Baeume verwandelt haben!");  
  AddDetail( ({ "blaetter" }),
      "Du kannst keine Blaetter entdecken!");  
  AddDetail( ({ "finger", "fingern"}),
      "Die Aeste der Baeume sehen wie duerre, lange Finger aus, jederzeit bereit "
      "zuzupacken!");
  AddDetail( ({ "naehe" }),
      "Die Baeume sind Dir sehr nah. Dir waere es lieber, wenn sie weiter weg "
      "waeren, denn irgendwie haben sie ein Eigenleben entwickelt." );
  AddDetail( ({ "aeste" }),
      "Die Aeste knarren im Wind und die meisten von ihnen sind morsch. Einer "
      "streifte Dich gerade im Nacken, wodurch Du unwillkuerlich zusammenzucken "
      "musst." );
  AddDetail( ({"nacken"}),
      "Unwillkuerlich musst Du zusammenzucken!");  
  AddDetail( ({ "wind" }),
      "Durch Wind werden sowohl der Nebel als auch die Aeste bewegt. Aber ganz "
      "sicher bist Du Dir nicht, ob das wirklich nur der Wind war." );
  AddDetail( ({ "grabsteine","graeber" }),
      "Hier muessen schon etliche Personen zu Tode gekommen sein. Auf ein paar "
      "kannst Du die Reste einer Grabinschrift erkennen, doch die meisten sind "
      "ziemlich verwittert. Um diese Graeber scheint sich wohl niemand zu "
      "kuemmern. Hoffentlich endest Du nicht eines Tages auf die gleiche Weise." );
  AddDetail( ({"weise"}),
      "Wer weiss wie diese Personen gestorben sind. Du magst es Dir nicht "
      "weiter vorstellen.");
  AddDetail( ({"grabinschrift", "reste"}),
      "Zu verwittert. Du kannst nichts mehr entziffern");
  AddReadDetail( ({"grabinschrift", "inschrift"}),
      "Zu verwittert. Du kannst nichts mehr entziffern");
  AddDetail( ({ "erde" }),
      "Viel kannst Du von Erde unter dem Nebelschleier nicht erkennen, ausser "
      "dass sie schwarz und verbrannt ist. Was ist hier nur passiert?" );
  AddDetail( ({ "warnung" }),
      "Die Grabsteine am Boden sollen Dir eine Warnung sein, Dich aeusserst "
      "vorsichtig zu bewegen. Der Tod kann schneller kommen, als Du denken "
      "kannst." );
  AddDetail( ({"tod"}),
      "Der Tod kommt schneller als Du denken kannst.");
  AddDetail( ({ "lebenden","lebende" }),
      "Noch zaehlst Du zu diesen und nicht zu jenen unter den Grabsteinen. Sei "
      "Dir nur nicht zu sicher, dass das so bleibt." );
  AddSpecialDetail( ({"tages","personen", "wahn", "verfolgungswahn", "tode",
        "eigenleben"}), 
      "sinnlos_unt");
  // DETAILS END
  
  // EXITS START
  SetExit (SUEDWESTEN);
  SetExit (NORDEN);
  SetExit (WESTEN);
  // EXITS END

  // ITEMS START
  AddItem( ({NEKRO_ISLAND_NPC "grauen"}), REFRESH_DESTRUCT); 
  // ITEMS END

}

string sinnlos_unt() {
  do_room_damage(TP, random(2)+1, "Leichtsinnigkeit");
  return BS("So etwas findest Du hier nicht! Achte lieber auf Deine "
      "Umgebung ...");
}
