#include <properties.h>
#include <moving.h>
#include "../nekro.h"
#include "../directions.h"

#ifndef ROOM
#define ROOM(x) ("/d/unterwelt/nekromanten/room/yaq_monoq/"+x)
#endif

inherit NEKRO_ISLAND_DIR "room/std_beach_room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_INT_SHORT, "Auf Yaq'Monoq");
  SetProp (P_INT_LONG, 
      "Du stehst nun auf einem flachen Strandstueck. Die Gegend ist "
      "dunkel und trostlos und die Atmung faellt Dir schwer. Deine Augen "
      "brennen, durch die Daempfe, die aus dem See steigen. Im "
      "Westen ist eine steile Klippe die das Weiterkommen unmoeglich macht. "
      "Im kahlen Boden ist eine Vertiefung eingelassen, die eine humanoide "
      "Form aufweist.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"see"}),
    "Der See aus Saeure blubbert vor sich hin waerend er den Strand "+
    "langsam wegaetzt.");
  AddDetail ( ({"seite"}),
    "Du kannst die andere Seite des Sees durch Deine verwaesserten Augen "+
    "nicht mehr erblicken.");
  AddDetail ( ({"atmung"}),
    "Wegen den giftigen Daempfen die aus dem See steigen bekommst Du kaum "+
    "noch Luft.");
  AddDetail ( ({"luft"}),
    "Hier gibt es kaum welche...");
  AddDetail ( ({"augen"}),
    "Deine Augen brennen und sind sicher so rot wie der Drache der grade auf "+
    "Dich zugerast kommt!");
  AddDetail ( ({"drache"}),
    "Du wischst Dir das Wasser aus Deinen Augen und schaust nochmal hin, "+
    "aber es ist kein Drache da. Die Daempfe aus dem See loesen wohl "+
    "Halluzinationen aus.");
  AddDetail ( ({"halluzinationen"}),
    "Der Drache war wohl nur Einbildung, oder?");
  AddDetail ( ({"einbildung"}),
    "Hoffentlich war das eine.");
  AddDetail ( ({"strand"}),
    "Hier trifft die Saeure auf den pechschwarzen Felsen und kreiert einen "+
    "giftigen Dampf.");
  AddDetail ( ({"daempfe", "dampf"}),
    "Die giftigen Daempfe brennen in Deinen Augen und Deiner Lunge.");
  AddDetail ( ({"lunge"}),
    "Wie die jetzt aussieht willst Du nicht wissen...");
  AddDetail ( ({"decke"}),
    "Die ist nicht erkennbar...");
  AddDetail ( ({"felsen"}),
    "Der Felsen ist hart und so schwarz das man denkt das er das Licht "+
    "schluckt. Der Saeure kann er aber nicht viel Widerstand leisten.");
  AddDetail( ({ "widerstand"}),
    "Der Felsen kann der Saeure auch nicht viel Widerstand leisten.");
  AddDetail ( ({"licht"}),
    "Es kommt Dir so vor als wuerde der Felsen das Licht schlucken.");
  AddDetail ( ({"klippe"}),
    "Im Westen ist eine Klippe die das Weiterkommen verhindert.");
  AddDetail ( ({"saeure"}),
    "Die Saeure im See zischt und dampft! Das Atmen faellt Dir schwer "
    "und die Nebelschwaden rauben Dir die Sicht!");
  AddDetail( ({ "sicht"}),
    "Durch die Saeureschwaden ist Deine Sicht gedruebt.");
  AddDetail ( ({"boden"}),
    "Er ist pechschwarz und glatt. Er besteht aus einem unnatuerlichen, "
    "schwarzen Gestein. Unweit des Sees ist im Boden eine Vertiefung "
    "eingelassen, die eine humanoide Form aufweist.");
  AddDetail( ({"form", "vertiefung"}), 
    "Im Boden ist eine Vertiefung, die eine humanoide Form aufweist. "
    "Sie ist etwa so gross wie Du und ist in etwa dreissig Zentimeter "
    "tief.");
  AddDetail ( ({"gegend"}),
    "Es ist hier dunkel, trostlos und wahrscheinlich auch gefaehrlich.");
  AddDetail ( ({"weiterkommen"}),
    "Von hier aus kommst Du nicht nach Westen.");
  AddDetail ( ({"atmen"}),
      "Das Atmen faellt Dir schwer. Der Gestank der Saeure ist nur schwer "
      "zu ertragen. Atme bloss nicht tief ein.");
  AddDetail ( ({"gestein"}),
      "Das Gestein ist unnatuerlich schwarz. Es wirkt schon etwas poroes, "
      "die Saeure scheint ganze Arbeit zu leisten.");
  AddDetail( ({"arbeit"}),
      "Das Gestein wirkt poroes hier. Muss wohl von der Saeure des Sees "
      "kommen.");
  AddDetail( ({"nebelschwaden", "schwaden"}),
      "Die Nebelschwaden - oder besser gesagt: die Saeureschwaden - behindern "
      "Deine Sicht.");
  AddDetail( ({"saeureschwaden"}),
      "Die Saeureschwaden behindern Deine Sicht. Das andere Ufer des "
      "Saeuresees kannst Du nicht erkennen. Vielleicht siehst Du mehr "
      "wenn Du fester starren wuerdest.");
  AddDetail( ({ "saeuresees"}),
      "Die Saeureschwaden, des Saeuresees, rauben Dir die Sicht");
  AddDetail( ({"ufer"}),
      "Das andere Ufer kannst Du nicht erkennen. Vielleicht kannst Du "
      "mehr erkennen wenn Du fester starrst.");
  AddDetail( ({"wasser"}),
      "Schnell wischst Du es weg.");
  AddDetail( ({ "mensch"}),
      "Die humanoide Vertiefung wuerde fuer einen Mensch platz bieten.");
  AddSpecialDetail( ({"strandstueck", "stueck"}), "_query_int_long");
 
  AddSmell(DEFAULT_SMELL,
      "Der Geruch von Saeure liegt in der Luft.");
  AddSmell( ({"gestank", "geruch", "gerueche"}),
      "Der Geruch von Saeure liegt in der Luft.");
  AddSmell( ({"saeure"}),
      "Die Saeure brennt in Deiner Nase. Atme ja nicht tief ein.");
  AddSound(DEFAULT_SOUND,
      "Seltsame Geraeusche sind aus der Ferne zu hoeren.");
  AddSound( ({"geraeusche", "ferne"}),
      "Hoert sich an wie Schreie.");
  AddSound( ({"schreie"}),
      "Seltsam verzerrte Schreie - Du hoerst sie aus weiter Ferne.");
  AddDetail( ({"nase"}),
      "Deine Nase nimmt seltsame Gerueche war.");
  AddDetail( ({"zentimeter"}),
      "Dreissig Zentimeter ist die humanoide Vertiefung. Sie hat in etwa "
      "die Form eines Menschen.");
  AddDetail( ({"form", "menschen"}),
      "Ein Mensch koennte sich wohl hineinlegen.");
  
  
  // DETAILS END

  // EXITS START
  SetExit (NORDOSTEN);
  SetExit (SUEDEN);
  // EXITS END

  // ITEMS START
  // ITEMS END
  AddCmd( ({"atme"}), "acid_dam");
  AddCmd( ({"starre", "starr"}), "lookahead");
  AddCmd( ({"leg", "lege"}), "laydown");
}

int laydown(string str) {
  string wer,wo;
  if(!str) return 0;
  if(sscanf(str, "%s %s",wer,wo)!=2) return 0;
  if(member( ({"in vertiefung", "vertiefung"}), wo)==-1) return 0;
  if(wer!="mich") {
    write("Du meinst 'mich', oder?\n");
    return 1;
  }
  write(BS("Du legst Dich in die Vertiefung. Fuer einen Moment passiert "
        "ueberhaupt nichts. Dann spuerst Du ein leichtes Kribbeln, das "
        "auch gleich wieder vorueber geht. Enttaeuscht erhebst Du Dich "
        "wieder."));
  say(BS(sprintf("%s legt sich in die Vertiefung. Doch irgendwie passiert "
          "nichts und %s steht wieder auf.", TP->Name(WER), 
          TP->QueryPronoun(WER))));
  return 1;
}

int acid_dam(string str) {
  if(!str) return 0;
  if(str!="tief ein") return 0;
  write("Tief atmest Du ein. Die Saeure aetzt Dir die halbe Lunge weg!\n");
  say(BS(sprintf("%s bekommt einen irren Blick und atmet tief ein.", 
          TP->Name(WER))));
  do_room_damage(TP, random(30)+1, "Zwei aufgeloeste Lungenfluegel");
  return 1;
}

int lookahead(string str) {
  if(!str) return 0;
  if(str !="fester")
    return 0;
  write("WAHHHHHHH DIE SAEURE! DIE SAEURE! DEINE AUGEN! WAAARG!\n");
  say(BS(sprintf("%s schlaegt die Haende vor den Augen zusammen und "
          "schreit wie von Sinnen.",TP->Name(WER))));
  TP->SetProp(P_BLIND, 100+random(300));
  do_room_damage(TP, random(20), "Saeure", "Da wo Du hingehst brauchst Du "
      "keine Augen");
  return 1;
}
