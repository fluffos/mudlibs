/************************************
**                                 **
**  Blutige Haende                 **
**                                 **
************************************/

#include <properties.h>

inherit "std/thing";

void create()
{
  if (!is_clone(this_object()))
    return;
  ::create();
  SetProp(P_LONG, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_WEIGHT, 0);
  SetProp(P_INVIS, 1);
  SetProp(P_NEVERDROP, 1);
  AddId("\nbloody_hands");
}

string extra_look()
{
  return capitalize(environment()->QueryPronoun(WER))+" hat "
         "blutbesudelte Haende.\n";
}

void reset()
{
  ::reset();
  remove();
}