inherit "std/unit";
inherit "std/food"; 

#include <language.h>
#include <properties.h>
#include <combat.h>
#include <food.h>
#include <defines.h>
#include <moredef.h>

void create()
{
  if(!is_clone(this_object())) return;
  unit::create();
  SetProp(P_SHORT,"Ein dunkler Trank");
  SetProp(P_LONG, 
   "Eine kleines Glasflaeschchen in dem sich eine dunkle Fluessigkeit "
   "befindet. Man kann es trinken.");
  SetCoinsPerUnits(100, 1);
  SetGramsPerUnits(40, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Trank");
  SetProp(P_NAME_ADJ, "dunkl");
  SetProp(P_NOSELL,1);
  SetProp(P_MATERIAL, ([ MAT_GLASS:15, MAT_MISC_DRUG:85]) );

  AddSingularId( ({"trank","glasflaeschchen","flaeschchen","heiltrank"}) );
  AddPluralId(  ({"traenke", "heiltraenke"}) );

  AddCmd( ({"trink", "trinke"}), "eat");
}


varargs int eat(string what, object pl)
{
  int val;
  if (file_name(environment(this_player()))[0..24]=="/d/unterwelt/nekromanten/")
  {
    if(TP->QueryProp("last_time_dark_potion")+90 > time()) 
      val=50;
    else
      val=150;
    SetProp(P_FOOD_INFO, ([
       F_HEAL: val+random(41), F_DRINK:14, F_ALCOHOL:0,
       F_VERB: "trinken" ,
       F_MSG:"Du trinkst den dunklen Trank. \n"
            +"Irgendwie fuehlst Du Dich viel besser.\n",
       F_MSG_ROOM:"trinkt ein Flaeschchen aus.\n" ]) );
    TP->SetProp("last_time_dark_potion", time());
    if (TP->QueryProp(P_ALIGN) > -500)
      TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-100);
  }
  else
  {
    // verpufft nicht mehr heilt nur weniger ausserhalb vom turm...
    if(TP->QueryProp("last_time_dark_potion")+90 > time()) 
      val=5;
    else
      val=15;
    SetProp(P_FOOD_INFO, ([F_HEAL: val+random(15), F_DRINK:4, F_ALCOHOL:0,
           F_VERB: "trinken" ,
           F_MSG:"Du trinkst den dunklen Trank. \n"
                +"Irgendwie fuehlst Du Dich kaum besser.\n",
           F_MSG_ROOM:"trinkt ein Flaeschchen aus.\n" ]) );
    TP->SetProp("last_time_dark_potion", time());
    if (TP->QueryProp(P_ALIGN) > -500)
      TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-100);
  }
  return ::eat(what, pl);
}

int second_life(object pl)
{
  AddAmount(-1);
  return QueryProp(P_AMOUNT);
}

