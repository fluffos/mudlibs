// 
// Eine schwarze daemonische Weinrebe
// 

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <food.h>
#include <new_skills.h>
#include "../nekro.h"

#define P_PLURAL      "plural"

create()
{
  if( !is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein paar schwarze Weintrauben");
  SetProp(P_LONG, 
      "Diese Weintraube ist ueber und ueber mit verfuehrerisch "
      "leckeren Beeren behangen. Sie glaenzen leicht oelig und "
      "sind tiefschwarz. Dich verlangt diese Traube zu essen. ");
  SetProp(P_NAME, "Weintrauben");
  SetProp(P_NAME_ADJ, "schwarz");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL, ([MAT_MISC_UNHOLY:100]));
  SetProp(P_FOOD_INFO, ([F_HEAL:50,F_POISON:0,F_SOAK:5]));
  SetProp(P_PLURAL, 1);
  AddId(({"trauben", "traube", "weintraube", "weintrauben"}));
}



void BeimEssen() {
  if(TP->QueryProp(P_ALIGN) < 0) {
    tell_object(TP,BS("Du isst alle Beeren auf. Schnell fuehlst Du Dich "
        "einfach goettlich! Du bist unbesiegbar!"));
    say(sprintf("%s isst ein paar schwarze Weintrauben.\n", TP->Name(WER)));
    TP->ModifySkillAttribute(TP, SA_SPEED, 100+random(30), 60);
    TP->ModifySkillAttribute(TP, SA_DAMAGE, 100+random(40), 60);
  }
  else {
    tell_object(TP,BS("Du isst alle Beeren auf. Du fuehlst Dich komplett "
        "gelaehmt und unbeweglich. Dir ist kalt"));
    say(sprintf("%s isst ein paar schwarze Weintrauben.\n", TP->Name(WER)));
    TP->ModifySkillAttribute(TP, SA_SPEED, 100-random(60), 600);
    TP->ModifySkillAttribute(TP, SA_DAMAGE, 100-random(60), 600);
    TP->AddPoison(3);
    TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-random(100));
  }
  return ; 
}
