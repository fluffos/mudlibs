// erstellt von Hiri am 10 August 2003
// Ein violettschwarzes Daemonenkraut
// 
inherit "std/food";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <food.h>
#include <new_skills.h>
#include "../nekro.h"

//#define P_PLURAL      "plural"

create()
{
  if( !is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein violettschwarzes Daemonenkraut");
  SetProp(P_LONG, 
      "Dieses Daemonenkraut scheint sich zu bewegen und obwohl es so "
      "ekelerregend aussieht und Stinkt, verspuerst Du den Drang "
      "es sofort zu essen. Es ist violettschwarz und scheint "
      "ein Geheimnis zu verbergen.");
  SetProp(P_NAME, "Daemonenkraut");
  SetProp(P_NAME_ADJ, "violettschwarz");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL, ([MAT_MISC_UNHOLY:100]));
  SetProp(P_FOOD_INFO, ([F_HEAL:20,F_POISON:0,F_SOAK:5]));
  SetProp(P_PLURAL, 1);
  AddId(({"daemonenkraut", "kraut", "HIRIKRAUT"}));
}



void BeimEssen() {
  if(TP->QueryProp(P_ALIGN) < 0) {
    tell_object(TP,BS("Du isst das Daemoenkraut gierig auf und Du fuehlst Dich komplett "
        "gelaehmt und unbeweglich. Dir ist kalt"));
    say(sprintf("%s isst ein Daemonenkraut.\n", TP->Name(WER)));
    TP->ModifySkillAttribute(TP, SA_SPEED, 100-random(60), 600);
    TP->ModifySkillAttribute(TP, SA_DAMAGE, 100-random(60), 600);
    TP->AddPoison(3);
    TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-random(100));
  }
  return ; 
}


  
