inherit "std/thing";

#include <defines.h>
#include <moredef.h>
#include <properties.h>

int dauer;
object victim;

void run();


create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"\ninsanity"}));
}

void init() {
  return ::init();
}

void reset() {
  ::reset();
  if(objectp(victim) )
    tell_object(victim, "Du wirst wieder normal.\n");
  remove();
  return ;
}

void Start() {
  if(!interactive(ENV(ME))) {
    remove();
    return;
  }
  victim=ENV(ME);
  dauer=60+random(60);
  call_out("do_something", 0);
    
}

void BecomesNetDead() {
  while(find_call_out("do_something")!=-1)
    remove_call_out("do_something");
  return;
}

void BecomesNetAlive() {
  call_out("Start", 0);
  return ;
}

void do_something() {
  if(!victim) return;
  if(victim->HasAlias("lass"))
    victim->command_me("unalias lass");
  switch(random(10)) {
    case 0: victim->command_me("grinse /irr");
            break;
    case 1..3: run(); break;
    case 4: victim->command_me("lass waffe fallen");
            break;
    case 5: victim->command_me("lass alles fallen");
            break;
    case 6: victim->command_me("toete alle");
            break;
    case 7: victim->command_me("tanze");
            break;
    case 8: victim->command_me("nimm alles aus beutel");
            break;
    case 9: victim->command_me("vorsicht 0");
            break;
  }
  dauer--;
  if(dauer<1) {
    tell_object(victim, "Du wirst wieder normal.\n");
    remove();
    return;
  }
  call_out("do_something", random(30)+20);
  return ;
}

void run() {
  mapping ex;
  object env;
  string *exits, exit;
  int i;
  i=random(3)+2;
  for (i;i>=0;i--) {
    if(!env=ENV(victim)) return ;
    if(!mappingp(ex=env->QueryProp(P_NEW_EXITS))) return;
    if(!sizeof(ex)) return;
    exits=m_indices(ex);
    exit=exits[random(sizeof(exits))];
    victim->command_me(exit);
  }
  return ;

}
