//
// Eine Barriere fuer den StdDungeon
// Angrox@SL
//
//

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../dungeon.h"

string wegfunc();

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_BARRIER_DIRECTION, "nirgendwo");

  SetProp(P_SHORT, "Eine blutige Knochenbarriere");
  SetProp(P_NAME, "Knochenbarriere");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10000);
  SetProp(P_VALUE, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOGET, 1);
  SetProp(P_HP, 500+random(1000));
  AddId( ({"barriere", "knochenbarriere", VBARRIER}));
  AddDetail( ({"weg"}), #'wegfunc);

  AddDetail( ({"knochen"}),
      "Die Knochen sind unnatuerlich angeordnet. Eine seltsame Kaelte "
      "geht von der Barriere aus.");
  AddDetail( ({"kaelte"}),
      "Eiskalt.");
}

string long() {
  return BS("Die Barriere besteht aus blutigen Knochen, die ueber und ueber "
      "mit Stacheln uebersaeht ist! Sie "
      "blockiert den Weg nach "+CAP(QueryProp(P_BARRIER_DIRECTION))+
      ". Du musst sie schon zerstoeren um dorthin zu kommen.");
}

string wegfunc() {
   return BS("Der Weg nach "+CAP(QueryProp(P_BARRIER_DIRECTION))+" wird "
       "von der Barriere blockiert.");
}

int destroy_barrier() {
  tell_room(ENV(ME), BS("Die Knochenbarriere zerbroeselt zu feinem "
        "Knochenmehl!"));
  ENV(ME)->RemoveBarrier(QueryProp(P_BARRIER_DIRECTION));
  return 1;
}


int AddHp(int val) {
  int hp;
  hp=QueryProp(P_HP);
  hp+=val;
  SetProp(P_HP, hp);
  if(hp < 0) {
    destroy_barrier();
  }
  return 1;
}
