#include "../nekro.h"

inherit "std/armour";

string rdet_runen();

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Eine schwarze Kutte");
  SetProp(P_LONG,
    "Du siehst eine schwarze, bodenlange Kutte mit weiten, ausladenden Aermeln "
    "und einer grossen Kapuze. Sie ist an den Saeumen mit einigen schmalen, "
    "blutroten Runenbaendern verziert." );
  AddDetail(({"rune","runen","runenband","runenbaender"}),
    "Einige wenige, blutrote Runenbaender verzieren den Saum der Kutte an "
    "der Kapuze und den Aermeln.");
  AddReadDetail(({"rune","runen"}),
    #'rdet_runen);      
  AddDetail(({"aermel","haende","hand"})
    ,"Die Aermel der Kutte sind weit und ermoeglichen es so, auch die Haende "
    "darin zu verbergen.");
  AddDetail(({"kapuze","kopf"})
    ,"Die Kapuze ist so gross, dass man seinen Kopf leicht darin vollstaendig "
    "verstecken kann.");
  SetProp(P_INFO, "Die Kutte schuetzt auf eine besondere Art und Weise vor "
      "heiligen Schaden." );
  SetProp(P_NAME, "Kutte");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kutte"}) );
  AddAdjective("schwarze");
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([ MAT_SILK:15, MAT_VELVET:78,MAT_GOLD:5,MAT_MAGIC:2 ]) );
  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 220);

  SetProp(P_DEFEND_FUNC, TO );

  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:15,P_GUILD:"nekromanten"]) );
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  if (member(dam_type,DT_HOLY) !=-1)
    return (QueryProp(P_WORN)->QueryProp(P_LEVEL)/4+random(4)*random(4));
  return 0;
}

string rdet_runen()
{
  if (TP->QueryProp(P_GUILD)=="nekromanten")
    return BS("Du kannst einige der Runen entziffern, offenbar binden die "
      "einen Schutzzauber in die Kutte");
  return BS("Du kannst die seltsamen Runen nicht entziffern.");
}
