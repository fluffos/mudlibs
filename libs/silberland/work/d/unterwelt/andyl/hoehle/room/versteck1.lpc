#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_CAVE]));
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_SHORT, "In einem unterirdischen Versteck");
  SetProp (P_INT_LONG, "Du stehst jetzt in einem unterirdischen Raum "
                       +"der vermutlich als Versteck von irgendjemanden "
                       +"dient. Die Waende die Decke und der Boden sind "
                       +"schoen aus dem Fels herausgehauen worden. An den "
	               +"Waenden stecken zudem mehrere Fackeln in "
                       +"Halterungen und hellen den Raum somit auf. "
                       +"Ansonsten ist der Raum sehr kahl. Zwei "
                       +"Gaenge fuehren von hier weg. Einer nach Nordwesten "
                       +"der andere nach Nordosten. Durch das Eisentor "
                       +"kommst Du zurueck nach Sueden.\n");
  // ROOM DESCRIPTION END;
    
  // DETAILS START
  AddDetail(({"raum", "teil"}),
	    "Dieser Raum ist vermutlich Teil eines unterirdischen "
            +"Verstecks.\n");
  AddDetail(("versteck"),
            "Dies ist hoechstwahrscheinlich das Versteck von "
            +"irgendjemanden. Wer das wohl ist?\n");
  AddDetail(("decke"),
            "Die Decke ist glatt und aus grauem Fels.\n");
  AddDetail(("fels"),
            "Ganz gewoehnlicher dunkelgrauer Fels.\n");
  AddDetail(("boden"),
            "Der felsige Boden ist glatt und sauber.\n");
  AddDetail(({"waende", "felswaende", "wand", "felswand"}),
            "Die Felswaende sind glatt und mehrere Fackeln "
            +"stecken in Halterungen welche an den Waenden befestigt "
            +"sind. Zudem faellt Dir an der Nordwand ein kleiner "
            +"Knopf auf.\n");
  AddDetail(("nordwand"),
             "An der Nordwand ist ein kleiner Knopf.\n");
  AddDetail(("knopf"),
            "Du kannst ihn druecken.\n");
  AddDetail(({"halterung", "halterungen"}),
            "Es sind metallene Halterungen in denen die Fackeln "
            +"stecken.\n");
  AddDetail(({"fackeln", "gaenze"}),
            "Die Fackeln leuchten den Raum zur Gaenze aus.\n");   
  AddDetail(({"gang", "gaenge"}), 
            "Es fuehren zwei Gaenge von hier weg, einer nach "
            +"Suedosten der andere nach Suedwesten.\n"); 
  AddSpecialDetail(({"tor", "eisentor"}), "tor_schau");

  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein leises Gebrabbel aus Nordosten und "
            +"ein leises heiseres Lachen aus Nordwesten.\n");
  AddSound(("gebrabbel"),
           "Das Gebrabbel kommt aus Nordosten. Da duerfte also "
           +"jemand sein.\n");
  AddSound(("lachen"),
           "Das Lachen kommt aus Nordwesten. Irgendjemand duerfte "
           +"also dort sein.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "auffaelliges"}),
	    "Nichts Auffaelliges zu erriechen.\n");
  // DETAILS ENDE
  
  // EXITS START

  AddExit(("nordosten"), ROOM+"versteck2");
  AddExit(("nordwesten"), ROOM+"versteck3");
  AddExit(("sueden"), ROOM+"hoehle3");

  // EXITS ENDE
  
  // COMMANDS START
   
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

tor_schau()
{
    // DA NOCH WAS EINBAUN
    return("Da gibts no nix.\n");
}

reset()
{
  ::reset();
}  


