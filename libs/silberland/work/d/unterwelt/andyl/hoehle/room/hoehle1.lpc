#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int platteverklemmt=0;

void create()
{
  ::create();

  // ROOM DESCRIPTION;

  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_CAVE]));
  SetProp (P_ARTICLE, 0);
  SetProp (P_NAME, "Eine Pfeilfalle");
  SetProp (P_INT_SHORT, "Eine dunkle unheimliche Hoehle");
  SetProp (P_INT_LONG, "Du stehst hier in einer dunklen unheimlichen Hoehle. "
	   +"Die Suedwand schimmert in einem bedrohlichem Rot und du hoerst "
	   +"Wasser von der Decke tropfen. Die Waende sind mit einer Art Moos "
	   +"ueberzogen und haben ein giftig gruenen Farbton. Du hast ein mulmiges "
	   +"Gefuehl und dein sechster Sinn sagt Dir, dass Du Dich umschauen solltest bevor Du "
	   +"weitergehst. Ein Gang fuehrt weiter nach Nordwesten.\n");
  
  // ROOM DESCRIPTION END;
  
  // DETAILS START

  AddDetail(("boden"),
	    "Der Boden ist aus Fels und genauso wie die Waende mit einer Art Moos ueberzogen. "
	    +"Du solltest aufpassen, dass Du auf den glitschigen Gewaechsen nicht ausrutschst.\n");
  AddDetail(("hoehle"),
	    "Du stehst jetzt in einer unheimlichen dunklen Hoehle in welcher Du "
	    +"ein ziemlich ungutes Gefuehl hast.\n");
  AddDetail(("farbton"),
	    "Die Gewaechse haben eine giftig gruenen Farbton.\n"); 
  AddDetail(({"moos"}),
	    "Es sieht zwar aehnlich aus Moos ist aber keines. Es sieht nicht so schoen weich "
	    +"und gemuetlich aus sondern macht einen schleimigen giftigen Eindruck.\n");
  AddDetail(("eindruck"),
	    "Das Gewaechs macht einen schleimigen giftigen Eindruck.\n");
  AddDetail(({"gewaechs", "gewaechse", "art"}),
	    "Es duerfte sich dabei um eine Art Moos handeln.\n");
  AddDetail(("gefuehl"),
	    "Du hast ein ungutes Gefuehl in dieser Hoehle.\n");
  AddDetail(({"suedwand"}),
	    "Die Suedwand schimmert in einem bedrohlichen Rot. Wie Du bereits weisst "
	    +"ist sie nur eine Illusion.\n");
  AddDetail(("illusion"),
	    "Die Suedwand ist eine Illusion.\n");
  AddDetail(("rot"),
	    "Das Rot wirkt bedrohlich.\n");
  AddDetail(("decke"),
	    "Von der Decke haengen einige Stalaktiten. Wasser tropft von ihnen herunter.\n");
  AddDetail(({"wasser", "braun"}),
	    "Das Wasser ist ecklig Braun.\n");
  AddDetail(({"pfeile", "pfeil"}),
            "Die Pfeile koennen ziemlich schmerzhaft sein.\n");
  AddDetail(({"stalaktiten"}),
	    "Die haengen da von der Decke herab. Hoffentlich faellt da keiner von denen auf "
	    +"auf Dich herab.\n");
  AddDetail(({"waende", "wand", "felswaende", "felswand"}),
	    "Die Felswaende sind stark zerklueftet und mit einer Art Moos ueberzogen. "
	    +"Die Westwand und die Suedwand fallen Dir besonders auf.\n"); 
  AddDetail(("westwand"),
	    "In der Westwand sind seltsame Loecher, woher die wohl stammen?\n");
  AddDetail(({"loecher", "loch"}),
	    "Diese Loecher sind sicher kuenstlich in die Westwand gebohrt worden.\n");
  AddDetail(("fels"),
	    "Als Du den Fels am Boden untersuchst, faellt Dir eine seltsame Platte auf.\n");
  AddDetail(("gang"),
	    "Der Gang fuehrt nach Nordwesten.\n");
  AddDetail(("sinn"),
	    "Dein sechster Sinn \(ja, sowas hast Du tatsaechlich\) sagt Dir, dass "
	    +"hier irgendetwas nicht stimmt.\n");
  
  AddSpecialDetail(({"platte", "druckplatte"}), "platte_schau");
 
  AddSound( DEFAULT_SOUND,
	    "Es ist still hier. Zu still.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht ungut hier. Liegt wahrscheinlich an den Gewaechsen.\n");
  AddSmell(({"gewaechs", "gewaechse", "moos"}),
	   "Iehhh, die riechen uebel.\n");
  // DETAILS ENDE
  
  // EXITS START

  AddSpecialExit("nordwesten", "nordwesten_geh");
  AddExit(("ANSCHLUSS"), ROOM"hoehle1");
  
  // EXITS ENDE
  
  // COMMANDS START

  AddCmd(({"drueck", "druecke"}), "druecke_was");
  AddCmd(({"klemme", "verklemme", "klemm", "verklemm"}), "verklemme_was");
  
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

verklemme_was(str)
{
  notify_fail(BS("Was willst Du verklemmen?\n"));
  if (!str) return 0;
  if ((str=="platte" || str == "druckplatte"))
    {
      if (platteverklemmt==1)
	{
	  write(BS("Die Druckplatte ist bereits verklemmt.\n"));
	  return 1;
	}
      else
	{
	  write(BS("Mit ein paar Steinbrocken die Du findest verklemmst "
		   +"Du die Druckplatte und hast somit hoffentlich "
		   +"die Falle entschaerft.\n"));
	  say(BS(capitalize(TP->query_real_name(WER, 2))+ "macht sich an einer "
		 +"Platte im Boden zu schaffen.\n"));
	  platteverklemmt=1;
	  return 1;
	}
    }
  else return 0;
}

int nordwesten_geh(string dir)
{
  if (platteverklemmt==1)
    {
      return TP->move(ROOM+"hoehle2", M_GO, 0,
		      "geht nach Nordwesten", "kommt herein");
    }
  else
    {
      write(BS("Als Du nach Nordwesten gehen willst hageln Pfeile "
	       +"aus Loechern in der Westwand auf Dich ein und schleudern "
	       +"Dich zurueck.\n"));
      say(BS(capitalize(TP->query_real_name(WER, 2))+" will nach Nordwesten "
	     +"gehen wird jedoch von einem Pfeilhagel aus der Westwand "
	     +"zurueckgeschleudert.\n"));
      TP->do_damage(100);
      return 1;
    }
}

druecke_was(str)
{
  notify_fail(BS("Auf was willst Du druecken?\n"));
  if (!str) return 0;
  if ((str == "platte" || str == "auf platte" ||
       str == "druckplatte" || str == "auf druckplatte"))
    {
      if (platteverklemmt==0)
	{
	  write(BS("Du kniest Dich hin und drueckst auf die "
		   +"Platte. Ploetzlich hoerst Du ein Klicken und "
		   +"ein paar Pfeile sausen genau in der Hoehe ueber Dir "
		   +"vorbei, in der vorher noch dein Kopf war. Puhhh, Glueck "
		   +"gehabt. Du solltest die Platte vielleicht irgendwie "
		   +"verklemmen bevor Du weitergehen willst.\n"));
	  return 1;
	}
      else 
	{
	  write(BS("Die Platte wurde verklemmt und laesst sich nicht bewegen. "
		   +"Es sollte also nichts mehr passieren koennen wenn Du weiter "
		   +"gehst.\n"));
	  return 1;
	}
    }
  else return 0;
}

platte_schau()
{
  write(BS("Die Platte scheint beweglich zu sein.\n"));
  if ((platteverklemmt==0))
    {
      return("Vielleicht kann man da ja mal draufdruecken.\n");
    }
  else 
    {
      return("Irgendwer hat jedoch die Platte verklemmt.\n");
    }
}


reset()
{
  ::reset();
  platteverklemmt=0;
}  

















