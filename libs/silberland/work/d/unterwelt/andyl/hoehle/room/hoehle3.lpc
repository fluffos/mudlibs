#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int tor_zu=1;

void create()
{
  ::create();

  // ROOM DESCRIPTION;

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_CAVE]));
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_SHORT, "Bei einem dicken Eisentor");
  SetProp (P_INT_LONG, "Die Hoehle endet hier abrupt vor einem grossen "
	   +"Eisentor im Norden. An der Ostwand ist eine seltsame Tafel "
	   +"zu sehen, welche mit allerlei kryptischen Zeichen uebersaet "
	   +"ist. An der Westwand haengt eine Fackel und spendet etwas Licht. "
	   +"Ausserdem sind da und dort ein paar kleinere Stalagmiten zu "
	   +"sehen. Ein Gang fuehrt von hier zurueck nach Sueden.\n"); 
  // ROOM DESCRIPTION END;	
  
  // DETAILS START

  AddDetail(("boden"),
	    "Der Boden ist felsig und etwas uneben. Ein paar kleine "
	    +"Stalagmiten ragen von ihm auf.\n");
  AddDetail(({"hoehle"}),
	    "Du befindest Dich in einer Hoehle die hier abrupt vor einem "
	    +"riesigen Eisentor endet.\n");
  AddDetail(({"tor", "eisentor"}),
	    "Ein robustes Eisentor ohne jegliche Verzierungen. Nicht mal "
	    +"ein Schloss ist dran.\n");
  AddDetail(("eisen"),
            "Das Eisentor ist aus Eisen.\n");
  AddDetail(("verzierungen"),
	    "Du kannst keine Verzierungen an dem Eisentor entdecken.\n");
  AddDetail(({"schloss", "torschloss"}),
	    "Interessanterweise kannst Du kein Schloss an dem Tor entdecken.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende sind aus einem dunkelgrauen Fels. An der Ostwand "
	    +"siehst Du ein seltsame Tafel die mit kryptischen Zeichen "
	    +"uebersaet ist und an der Westwand haengt eine Fackel die "
	    +"etwas Licht spendet.\n");
  AddDetail(("westwand"),
	    "An der Westwand haengt eine seltsame Tafel die mit "
            +"allerlei kryptischen Zeichen uebersaet ist.\n");
  AddDetail(("decke"),
            "Nichts zu entdecken ausser kahler dunkelgrauer Fels.\n");
  AddDetail(({"tafel", "menge"}),
	    "Auf der Tafel sind jede Menge krytische Zeichen "  
            +"zu sehen.\n");
  AddSpecialDetail("zeichen", "zeichen_schau");
  AddDetail(("ostwand"),
            "An der Ostwand steckt eine Fackel in einer metallenen "
           +"Halterung.\n");
  AddDetail(("fackel"),
            "Die Fackel haengt da an der Westwand in einer "
	    +"metallenen Halterung und spendet etwas Licht.\n");
  AddDetail(("halterung"),
	    "Eine metallene Halterung fuer eine Fackel. Unter "
	    +"der Halterung entdeckst Du eine kleine Nische.\n");
  AddDetail(("nische"),
	    "In der Nische findest Du einen Knopf. Den koennte "
            +"vielleicht druecken.\n");
  AddDetail(("knopf"),
            "Vielleicht kann man diesen Knopf ja druecken.\n");
  AddDetail(("licht"),
	    "Die Fackel an der Westwand spendet etwas Licht.\n");
  AddDetail(({"stalagmiten"}),
	    "Ein paar kleine Stalagmiten ragen da und dort auf. "
	    +"Ein Stalakmit faellt Dir besonders auf.\n");
  AddDetail(({"stalagmit"}),
            "Auf dem Stalagmit ist ein Bild eingraviert. Das "
	    +"solltest Du Dir naeher ansehen.\n");
  AddDetail(("fels"),
            "Ganz gewoehnlicher dunkelgrauer Fels.\n");
  AddDetail(({"gang", "gaenge"}),
	    "Ein Gang fuehrt von hier nach Sueden.\n");   
  AddDetail(("hinweis"),
            "Du findest keinen Hinweis wie man das Tor "
            +"oeffnen koennte.\n");


  // HIER BITTE WAS FUERS RAETSEL EINBAUN....

  AddDetail(("bild"),
            "gibts no ned.\n");
   

  AddSound( DEFAULT_SOUND,
	    "Es ist still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch", "hoehle"}),
	    "Riecht typisch nach Hoehle.\n");
  // DETAILS ENDE
  
  // EXITS START

  AddExit(("norden"), ROOM+"versteck1");
  AddExit(("sueden"), ROOM+"hoehle2");

  // EXITS ENDE
  
  // COMMANDS START   
  AddCmd(({"drueck", "druecke"}), "druecke_was");
  AddCmd(({"oeffne"}), "oeffne_was");
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

oeffne_was(str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (!str) return 0;
  if ((str == "tor" || str == "eisentor"))
    {
      if (tor_zu==1)
        {       
          write(BS("Du untersuchst das Eisentor "
                  +"findest aber keine Hinweis wie "
                  +"man das Tor oeffnen koennte.\n"));
          return 1;
        }
      else 
        {
          write(BS("Das Eisentor ist ja schon offen.\n"));
           return 1;
        }
     }
   else return 0;
}

zeichen_schau()
{
   // HIER WAS FUERS RAETSEL EINBAUN
   return(BS("raetsel"));
}


druecke_was(str)
{
  notify_fail("Was willst Du druecken?\n");
  if (!str) return 0;
  if ((str == "knopf" || str == "auf knopf"))
    {
      // HIER JETZT DISABLEN/ENABLEN DER FALLE IN HOEHLE2 
      // einbauen.    
      write("nix tuat si!\n");
      return 1;
    }
  else return 0;
}
  
reset()
{
  ::reset();
  tor_zu=1;
}  

















