#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int morgenstern=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_CAVE]));
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_SHORT, "In einem Wachzimmer");
  SetProp (P_INT_LONG, "Du steht hier in dem Wachzimmer des "
	   +"unterirdischen Verstecks. Ein Regal mit "
	   +"Waffen steht an der Suedwand und ein Holztisch "
	   +"mit zwei Baenken steht in der Mitte des Raumes. "
	   +"Ein paar Fackeln an den Waenden spenden dem Raum "
	   +"genuegend Licht. Die Luft hier drinnen riecht nach "
	   +"abgestanden und vermischt sich mit dem Geruch von "
	   +"Alkohol und alten Speiseresten. "
	   +"Zwei Gaenge fuehren von hier fort, einer nach "
	   +"Suedosten der andere nach Suedwesten. Im Norden "
	   +"ist ausserdem noch eine Tuer.\n");
  
  // ROOM DESCRIPTION END;
  
  // DETAILS START
  AddDetail(("mitte"),
	    "In der Mitte des Raumes steht ein Holztisch und zwei Baenke.\n");  
  AddDetail(({"gang", "gaenge"}),
            "Zwei Gaenge fuehren von hier weg. Einer nach Suedosten, der "
            +"andere nach Suedwesten.\n"); 
  AddDetail(({"zimmer", "wachzimmer"}),
            "Du befindest Dich jetzt in dem Wachzimmer des unterirdischen "
            +"Verstecks.\n");
  AddDetail(("versteck"),
            "Gut versteckt dieses Versteck.\n");
  AddDetail(("raum"),
	    "Dieser Raum duerfte das Wachzimmer des Verstecks sein.\n");
  AddDetail(({"regal", "holregal"}),
	    "Ein altes wurmzerfressenes Holregal. Alte Schwerter, einige "
	    +"Keulen und Morgensterne sowie ein paar Dolche liegen in dem "
	    +"Regal.\n");
  AddDetail(("schwerter"),
	    "Die Schwerter sind allesamt schlecht gearbeitet und rosten "
	    +"bereits kraeftig vor sich hin.\n");
  AddDetail(("keulen"),
	    "Es sind Keulen wie sie auch Orks und Oger verwenden. Ziemlich "
	    +"schwer und unhandlich.\n");
  AddDetail(({"orks", "oger"}),
	    "Orks und Oger verwenden gerne Keulen.\n");
  AddDetail(({"dolche", "arbeit"}),
	    "Die Dolche bestehen fast nur noch aus Rost. Da hat "
	    +"wohl jemand ziemlich schlechte Arbeit geleistet.tester\n");
  AddDetail(({"rost", "arbeit"}),
	    "Der Rost hat hier ganze Arbeit geleistet.\n");
  AddSpecialDetail(("morgensterne"), "morgensterne_schau");  
  AddDetail(({"wand", "waende", "felswand", "felswaende"}),
	    "Es sind schlichte Felswaende an denen Halterungen mit "
	    +"Fackeln angebracht sind.\n");
  AddDetail(("suedwand"),
            "An der Suedwand steht ein Regal mit Waffen.\n");
  AddDetail(("waffen"),
            "Du siehst alte Schwerter, einige Keulen und Morgensterne "
            +"sowie einige Dolche.\n");
  AddDetail(("halterungen"),
	    "In den Halterungen stecken einige Fackeln.\n");
  AddDetail(("fackeln"),
	    "Die Fackeln bringen Licht in den ansonsten dunklen "
	    +"Raum.\n");
  AddDetail(({"licht", "segen"}),
	    "Fuer viele ist das Licht wohl ein Segen, fuer manch "
	    +"andere eher weniger.\n");
  AddDetail(({"tisch", "holztisch"}),
	    "Ein alter robuster Holztisch. Einige Speisereste kleben "
	    +"an seiner Tischplatte.\n");
  AddDetail(("tischplatte"),
	    "Auf der Tischplatte kleben so einige Speisereste. Wie "
	    +"unappetitlich!\n");
  AddDetail(({"baenke", "holzbaenke"}),
	    "Zwei sehr robust wirkende Holzbaenke stehen um den Tisch "
	    +"herum. Auf denen kann man sicher gut sitzen.\n");
  AddDetail(({"boden", "felsboden"}),
	    "Ein schlichter Felsboden.\n");
  AddDetail(("luft"),
	    "Riech mal.\n");
  AddDetail(({"decke"}),
	    "Die Decke ist aus dem allgegenwaertigem Fels.\n");
  AddDetail(("fels"),
           "Gewoehnlicher dunkelgrauer Fels.\n");
  AddDetail(({"reste", "speisereste"}),
	    "Iehhh, am Tisch kleben viele vor sich hin schimmelnde "
	    +"Speisereste die ziemlich uebel stinken.\n");
  AddDetail(("runen"),
	    "Du kannst sie lesen.\n");
  AddReadDetail(({"runen"}),
		"  ,------------------------.\n"
		+"  |<>                    <>|\n"
	        +"  |    SARANTULS LABOR     |\n"
		+"  |                        |\n"
		+"  |   BETRETEN VERBOTEN!   |\n"
		+"  |                        |\n"
		+"  |   SPIELER HAFTEN FUER  |\n"
		+"  |   IHRE ZWEITIS !!!     |\n"
		+"  |<>                    <>|\n"		
		+"  '------------------------'\n");
  AddDetail(("tuerschloss"),
	    "Keines zu sehen.\n");
  
  // ABFRAGE OB WACHE DA ODER NICHT
  
  AddSound( DEFAULT_SOUND,
	    "Es ist gluecklicherweise wieder still hier.\n");
  
  AddSmell(("luft"),
           "Puuh, die Luft riecht ganz schoen abgestanden. Zeit das "
           +"hier jemand mal lueftet.\n");  
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Die Luft hier drinnen riecht abgestanden und dazu kommt "
            +"noch der Geruch von Alkohol und alten Speiseresten.\n");
  AddDetail(("alkohol"),
	    "Riecht ziemlich hochprozentig.\n");
  AddSmell(({"speisereste", "reste", "zeug"}),
	    "Iehhh, die stinken ja ekelerregend. Das Zeug schimmelt ja "
	    +"schon die laengste Zeit!\n");
  AddDetail(({"zeit"}),
            "Die Zeit vergeht schneller als Du denkst...\n");

  // DETAILS ENDE
  
  // EXITS START
  
  NewDoor( "norden", ROOM+"labor", ({"tuer", "tuere", "holztuer", "holztuere"}),
	   ({ D_NAME, "Tuer",
		D_GENDER, FEMALE,
		D_FLAGS, DOOR_CLOSED,
		D_SHORT, "Eine Holztuer ohne Tuerschloss.\n",
		D_LONG, "Eine Holztuer ohne Tuerschloss. "
		+"Ein paar Runen sind in sie eingraviert.\n",
		D_MSGS, ({"durch die Tuer", "schreitet", 
			    "kommt durch die Tuer" })
		}) );
  // EXITS END
  AddExit(("suedosten"), ROOM+"versteck2");
  AddExit(("suedwesten"), ROOM+"versteck3");
  
  // COMMANDS START
  AddCmd(("nimm"), "nimm_was");
  AddCmd(({"sitze", "sitz", "setze", "setz"}), "sitz_auf");  
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

sitz_auf(str)
{
   notify_fail("Auf was willst Du Dich setzen?\n");
   if (!str) return 0;
   if ((str == "auf bank" || str == "auf holzbank" ||
        str == "auf baenke" || str == "auf holzbanke" ||
        str == "bank" || str == "holzbank" || str == "baenke" ||
        str == "holzbaenke"))
     {
       write(BS("Du setzt Dich auf die Holzbank und willst Dich "
		+"zuruecklehnen, doch da dort keine Lehne ist "
		+"krachst Du unsanft auf den Ruecken.\n"));
       TP->AddHp(-5);
       say(BS(capitalize(TP->query_real_name())+" setzt sich auf "
	      +"die Holzbank lehnt sich zurueck und kippt ploetzlich "
	      +"nach hinten und landet unsanft auf dem Ruecken.\n"));
     }
   else return 0;
}


nimm_was(str)
{
  notify_fail("Was willst Du nehmen?\n");
  if (!str) return 0;
  if (str == "morgenstern")
    {
      // HIER NOCH MORGENSTERN CLONEN EINBAUN.
      write("Ah, ein Morgenstern sollte jetzt gecloned werden.\n");
      morgenstern=0;
      return 1;
    }
  else return 0;
}


morgensterne_schau()
{
  write(BS("Wie auch Die Schwerter und Dolche sind auch "
	   +"die Morgensterne grossteils verrostet und "
	   +"schlecht gearbeitet. "));
  if (morgenstern==1) 
    {
      return("Ein Morgenstern sieht jedoch recht brauchbar aus.\n");
    }
  else 
    {
      return("");
    }   
}

morgenstern_schau()
{
  if (morgenstern==1)
    {
      return("Der Morgenstern sieht sehr brauchbar aus. Du kannst "
             +"ihn nehmen wenn Du willst.\n");
    }
  else return("Sowas siehst Du da nicht!");
}

reset()
{
  ::reset();
  morgenstern=1;
}  
















