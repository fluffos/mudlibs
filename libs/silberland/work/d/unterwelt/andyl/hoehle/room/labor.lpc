#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_CAVE]));
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_SHORT, "Das Labor von Sarantul");
  SetProp (P_INT_LONG, "Du stehst hier im Labor des Zauberers Sarantul. "
                       +"In der Mitte des Raumes steht ein staehlernes "
                       +"Dreibein auf dem ein Kessel haengt. Unter dem "
                       +"Kessel ist eine Aushebung im Boden in welchen "
                       +"gluehende Kohlen sind, die das Gebraeu im "
                       +"Kessel zum Kochen bringen. An der Ostwand, "
                       +"Westwand und Nordwand sind Regale aufgebaut "
                       +"die mit den verschiedensten Sachen gefuellt sind.\n");
        
  // ROOM DESCRIPTION END;

  // DETAILS START

  AddDetail(({"labor", "sarantul"}),
            "Das ist das Labor des boesen Zauberers Sarantul. Was fuer "
            +"unheilige Experimente hier wohl vollbracht werden?\n");
  AddDetail(("experimente"),
            "Hier werden sicher nur unheilige Experimente vollfuehrt. "
            +"Aber wahrscheinlich willst Du das gar nicht so genau wissen.\n");
  AddDetail(("raum"),
            "Dieser Raum ist das Labor von Sarantul.\n");
  AddDetail(("sachen"),
            "Die Regale sind mit den verschiedensten Sachen gefuellt.\n");
  AddDetail(("mitte"),
            "In der Mitte des Raumes steht ein Dreibein ueber einer "
            +"Aushebung im Boden in welcher Kohlen vor sich hingluehen. "
            +"Ein Kupferkessel haengt zudem an dem Dreibein.\n");
  AddDetail(("zauberer"),
            "Sarantul ist ein boeser, maechtiger Zauberer.\n");       
  AddDetail(("decke"),
            "Die Decke is aus grauem Fels welcher hier und dort "
            +"etwas russig wirkt.\n");
  AddDetail(("fels"),
            "Gewoehnlicher grauer Fels, der hier und da etwas "
            +"russig ist.\n");
  AddDetail(("boden"),
            "Der Boden ist aus grauem Fels, und in der Mitte des "
           +"Raumes ist eine Aushebung im Boden, welche wiederum von "
           +"Steinen umgebeben ist, in welcher Kohlen vor sich hin "
           +"gluehen.\n");
  AddDetail(({"steine", "ziegelsteine"}),
           "Es sind rote Ziegelsteine, welche rund um die Aushebung "
           +"positioniert wurden.\n");
  AddDetail(({"waende", "wand"}),
           "An der Ostwand, der Westwand, sowie an der Nordwand stehen "
           +"Regale, welche mit allen moeglichen Sachen gefuellt sind.\n"); 
  AddDetail(("ostwand"),
           "Da steht ein dunkelbraunes Regal.\n");
  AddDetail(({"dunkelbraunes regal", "unzahl"}),
           "In diesem Regal stehen eine Unzahl an Reagenzglaesern, welche "
           +"mit allen moeglichen Fluessigkeiten und Pulvern gefuellt sind.\n");
  AddDetail(({"reagenzglaeser", "glaeser", "zweck", "verwendungszweck"}),
           "Die Reagenzglaeser sind mit diversen Fluessigkeiten und Pulvern "
           +"gefuellt. Ihr Verwendungszweck ist jedoch nicht festzustellen.\n");
  AddDetail(({"fluessigkeiten", "pulver", "fall"}),
           "Du weisst zwar nicht wofuer die gut sein sollen, aber in jedem "
           +"Fall sind sie schoen bunt.\n");
  AddDetail(("westwand"),
           "Hier steht ein schwarzes Regal.\n");
  AddDetail(({"schwarzes regal", "sammlung"}),
           "In diesem Regal ist eine Sammlung von Pergamenten "
           +"welche allesamt mit seltsamen Glyphen bedeckt sind.\n");
  AddDetail(({"pergamente", "gutes"}),
           "Die Pergamente sind mit allen moeglichen Glyphen bedeckt. "
           +"Du kannst sie zwar nicht entziffern, aber sie verheissen "
           +"sicher nichts Gutes.\n");
  AddDetail(({"glyphe", "glyphen"}),
           "Du kannst sie leider nicht entziffern.\n");
  AddDetail(("nordwand"),
           "Da steht ein dunkelrotes Regal.\n");
  AddDetail(("dunkelrotes regal"),
           "In diesem Regal lagern die Koerperteile der verschiedensten "
           +"Lebewesen. Teilweise zuecken sie gar noch. Angewidert wendest "
           +"Du Deinen Blick ab.\n");
  AddDetail(({"koerperteile", "lebewesen", "teile"}),
           "Es sind die Koerperteile der verschiedensten Lebewesen. Manche "
           +"Teile zucken sogar noch. Angewidert wendest Du deinen Blick "
           +"ab.\n");
  AddDetail(("blick"),
           "Den hast Du abgewendet.\n");
  AddDetail(("regale"),
           "Du siehst ein dunkelrotes, ein schwarzes und "
           +"dunkelbraunes Regal.\n");
  AddDetail(("regal"),
           "Welches Regal meinst Du? Das dunkelrote an der "
           +"Nordwand, das schwarze an der Westwand oder "
           +"das dunkelbraune Regal an der Ostwand?\n");
  AddDetail(("kohlen"),
           "Die Kohlen gluehen da in der Aushebung so vor sich hin "
           +"und spenden dem Raum etwas Licht und Waerme.\n");
  AddDetail(("waerme"),
           "Naja, es ist eigentlich eher Hitze.\n");
  AddDetail(("hitze"),
           "Wenn Du es nicht glaubst, greif doch in die Kohlen!\n");
  AddDetail(({"licht", "lichtquelle"}),
           "Die gluehenden Kohlen scheinen die einzige Lichtquelle "
           +"hier zu sein. Sie spenden ein eher schwaches, gedaempftes "
           +"Licht.\n");
  AddDetail(("aushebung"),
           "Die Aushebung ist von roten Steinen umgeben und in ihr "
           +"gluehen einige Kohlen vor sich hin. Ueber die Aushebung "
           +"wurde ein Dreibein gestellt, an welchem ein Kessel haengt.\n");
  AddDetail(("dreibein"),
           "Ein schwarzes metallenes Dreibein welches ueber die "
           +"Aushebung gestellt wurde. An ihm haengt ein Kupferkessel.\n");
  AddDetail(({"kessel", "kupferkessel", "kochen"}),
           "Ein rostiger alter Kupferkessel. In ihm brodelt ein gruenes, "
           +"zaehfluessiges Gebraeu vor sich hin und wird zum Kochen "
           +"gebracht.\n");
  AddDetail(("gebraeu"),
           "Ein gruenes, zaehfluessiges Gebraeu welches nicht gerade "
           +"angenehm riecht. Ob man das wohl trinken kann?\n");
  AddSmell(("gebraeu"),
           "Iehhh, riecht nicht gerade angenehm.\n");
  AddDetail(("runen"),
	    "Du kannst sie lesen.\n");
  AddReadDetail(({"runen"}),
		",------------.\n"
		+"| NOTAUSGANG |\n"
		+"'------------'\n");
  AddDetail(("ausgang"),
	    "Durch die Tuer durch...\n");
  AddDetail(("tuerschloss"),
	    "Keines zu sehen.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein seltsames Brodeln aus dem Kessel.\n");
  AddSound(({"brodeln", "kessel"}),
            "Das Brodeln kommt aus dem Kessel. Hoffentlich "
            +"geht da nicht gerade etwas ueber.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Ein uebler Geruch dringt aus dem Kessel zu Dir.\n");
  AddSmell(("kessel"),
            "Das Gebraeu in dem Kessel riecht fuerchterlich.\n");
  // DETAILS ENDE
  
  // EXITS START

  NewDoor( "sueden", ROOM+"versteck4.lpc", ({"tuer", "tuere", "holztuer", "holtuere"}),
	   ({ D_NAME, "Tuer",
		D_GENDER, FEMALE,
		D_FLAGS, DOOR_CLOSED,
		D_SHORT, "Eine Holztuer ohne Tuerschloss.\n",
		D_LONG, "Eine Holztuer ohne Tuerschloss. "
		+"Ein paar Runen sind in sie eingraviert.\n",
		D_MSGS, ({"durch die Tuer", "schreitet", 
			    "kommt durch die Tuer" })
		}) );
		// EXITS END
  
  // COMMANDS START
   
  AddCmd(({"geife", "greif"}), "greif_in");
  AddCmd(({"trink", "trinke"}), "trink_was");

  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

greif_in(str)
{
  notify_fail(BS("In was willst Du greifen?\n"));
  if (!str) return 0;
  if ((str == "kohlen" || str == "gluehende kohlen" ||
       str == "in kohen" || str == "in gluehende kohlen" ||
       str == "aushebung" || str == "in aushebung"))
      {
         // HIER NOCH ZUFALLGENERATOR EINBAUN 
         // bei A kriegt man was bei B Schaden  
   
         write(BS("Gibts no nix....."));
         return 1;
      }
  return 0;
}

trink_was(str)
{
   notify_fail(BS("Was willst Du trinken?\n"));
   if (!str) return 0;
   if ((str == "gebraeu"))
     {
       // ZUFALLSGENERATOR: SCHADEN/HEILUNG
       write(BS("GIBTS NO NIX!!!"));
       return 1;
     }
  return 0;
}

reset()
{
  ::reset();
}  

















