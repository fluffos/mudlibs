#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_CAVE]));
  SetProp (P_ARTICLE, 0);
  SetProp (P_INT_SHORT, "In einem unterirdischen Versteck");
  SetProp (P_INT_LONG, "Du stehst hier in einem Teil des unterirdischen "
                       +"Verstecks, welcher wohl als Mannschaftsraum dienen "
                       +"duerfte. Acht Betten stehen hier herum und zwei "
                       +"grosse Tische um welche jeweils vier Sessel stehen. "
                       +"Eine grosse Oellampe, welche von der Decke haengt "
                       +"leuchtet den Raum aus. Zwei Gaenge fuehren von hier "
                       +"weiter, einer nach Nordwesten der andere nach "
                       +"Suedwesten.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START
  AddDetail(({"teil", "versteck"}),
             "Dieser Teil des Verstecks duerfte wohl als Mannschaftsraum "
             +"dienen.\n");
  AddDetail(({"raum", "mannschaftsraum"}), 
            "Dieser Raum duerfte hoechstwahrscheinlich als Mannschaftsraum "
            +"dienen.\n");
  AddDetail(({"decke"}),
            "Von der felsigen Decke haengt eine Oellampe herunter "
            +"welche Licht in den ansonsten dunklen Raum bringt.\n");
  AddDetail(("licht"),
            "Das Licht wird von der Lampe ausgestrahlt.\n");
  AddDetail(({"lampe", "oellampe"}),
            "Die Oellampe haengt da an der Decke.\n");
  AddDetail(({"boden", "felsboden"}),
            "Der Felsboden ist glatt, weisst aber keine "
            +"Besonderheiten auf.\n");
  AddDetail(("besonderheiten"),
            "Keine Besonderheiten zu entdecken.\n");   
  AddDetail(({"wand", "waende", "hoehle"}),
            "Die Waende sind aus dem grauen Fels der in der "
            +"ganzen Hoehle zu finden ist. An der Westwand haengt "
            +"ein Bild.\n");
  AddDetail(("fels"),
            "Ganz gewoehnlicher dunkelgrauer Fels.\n");
  AddDetail(("westwand"),
            "An der Westwand haengt ein Bild.\n");
  AddDetail(({"bild", "hand"}),
            "Das Bild zeigt ein huebsches unbekleidetes Maedchen "
            +"mit einem maechtigen Schwert in der Hand.\n");
  AddDetail(({"maedchen", "schwert"}),
            "Das Maedchen auf dem Bild ist sehr huebsch, zudem unbekleidet "
            +"und haelt ein fuer sie viel zu grosses Schwert. "
            +"Was wird wohl der Zweck von so einem Bild an einem "
            +"solchen Ort sein?\n");
  AddDetail(("zweck"),
            "Ja was wird wohl der Zweck sein?\n");
  AddDetail(("ort"),
            "Du befindest Dich hier in einem Mannschaftsraum.\n");
  AddDetail(({"betten", "bett", "holzbetten", "holzbett", "bauweise"}),
            "Es sind insgesamt acht Holzbetten von schlichter Bauweise.\n");
  AddDetail(({"tische", "holztische"}),
            "Zwei einfache Holztische stehen da. An einem Holztisch faellt "
            +"Dir etwas auf.\n");
  AddDetail(({"holztisch", "tisch"}),
            "Da hat jemand einen Spruch in die Tischplatte eingraviert.\n");
  AddDetail(("tischplatte"),
            "Jemand hat einen Spruch in die Tischplatte eingraviert.\n");
  AddDetail(("spruch"),
            "Du kannst ihn lesen.\n");
  AddReadDetail(("spruch"),
            "TOD ALLEN BARDEN!!!\n");         
  AddDetail(("mannschaft"),
            "Die duertfte wohl hier untergebracht sein.\n");   
  AddDetail(({"gang", "gaenge"}),
            "Zwei Gaenge fuehren von hier weiter. Der eine nach Nordwesten "
            +"der andere nach Suedosten.\n");
  AddDetail(({"sessel"}),
           "Es sind acht Sessel insgesamt. Vier an jedem Tisch. "
           +"Sie sehen nicht gerade sehr sorgfaeltig gearbeitet aus.\n");  
  
  // Beim Sound eventuell checken ob waechter da.

  AddSound( DEFAULT_SOUND,
	    "Jetzt herrscht endlich Ruhe hier.\n");
  AddSound(("ruhe"), 
            "Endlich ist hier Ruhe.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Hier sollte dringend gelueftet werden. Es stinkt "
            +"naemlich erbaermlich.\n");
  // DETAILS ENDE
  
  // EXITS START

  AddExit(("nordwesten"), ROOM+"versteck4");
  AddExit(("suedwesten"), ROOM+"versteck1");

  // EXITS ENDE
  
  // COMMANDS START
   
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

reset()
{
  ::reset();
}  

















