#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_CAVE]));
  SetProp (P_ARTICLE, 0);
  SetProp (P_NAME, "Zu hartes Schlagen eines Sandsacks");
  SetProp (P_INT_SHORT, "In einem Trainingsraum");
  SetProp (P_INT_LONG, "Du befindest Dich hier in einem Trainingsraum  "
                       +"des unterirdischen Verstecks. Du siehst da "
                       +"und dort ein paar Sandsaecke haengen und ein "
                       +"Geruest mit Holzstaeben haengt an der Westwand. "
                       +"Eine Holzpuppe, welche bereits einen sehr schaebigen "
                       +"Eindruck macht steht in einer Ecke des Raumes. "
                       +"Ein paar Fackeln, welche in Halterungen an den "
                       +"Waenden stecken, spenden dem Raum genuegend Licht. "
                       +"Zwei Gaenge fuehren von hier fort. Ein Gang nach "
                       +"Nordosten, der andere nach Suedosten.\n");
  
  // ROOM DESCRIPTION END;
  
  // DETAILS START
  AddDetail(("eindruck"),
           "Die Holzpuppe macht einen sehr schaebigen Eindruck.\n");   
  AddDetail(("fels"),
           "Ganz gewoehnlicher grauer Fels wie auch woanders im Versteck.\n"); 
  AddDetail(({"raum", "trainingsraum"}),
           "Dieser Raum duerfte als Trainingsraum dienen. Zumindest "
           +"lassen die Sandsaecke darauf schliessen.\n");
  AddDetail(("versteck"),
           "Du befindest Dich hier in einem Trainingsraum des "
           +"unterirdischen Verstecks.\n");
  AddDetail(("decke"),
           "Die Decke ist kahl und aus grauem Fels. Ein paar "
           +"Sandsaecke haengen von ihr herab.\n");
  AddDetail(({"boden", "felsboden"}),
           "Der Felsboden ist mit Stroh ausgelegt, sodass er etwas "
           +"weicher ist und die Trainierenden nicht ganz so hart "
           +"auf dem Boden landen.\n");
  AddDetail(({"trainierende"}),
           "Die Trainierenden werden sich wohl auch trotz des Strohs am "
           +"Boden ziemlich weh tun wenn sie hier hinfallen.\n"); 	 
  AddDetail(({"waende", "wand"}),
           "Die Waende sind glatt und aus grauem Fels. Ein paar "
           +"Halterungen mit fackeln sind an den Waenden angebracht. "
           +"An der Westwand faellt Dir zudem ein Geruest mit Holzstaeben "
           +"auf.\n");
  AddDetail(("westwand"),
           "An der Westwand haengt ein Geruest mit Holzstaeben.\n");
  AddDetail(("stroh"),
           "Das Stroh ist bereits alt und riecht schon etwas "
           +"seltsam.\n");
  AddDetail(({"halterung", "halterungen"}),
           "Es sind metallische Halterungen an denen die Fackeln "
           +"befestigt sind.\n");
  AddDetail(("fackeln"),
           "Die Fackeln spenden dem Raum genug Licht.\n");
  AddDetail(("licht"),
           "Das Licht im Raum wird von den Fackeln ausgestrahlt.\n");
  AddDetail(({"gang", "gaenge"}),
           "Zwei Gaenge fuehren von hier weg, einer nach Nordosten, der "
           +"andere nach Suedosten.\n");
  AddDetail(("ecken"),
           "In einer der Ecken steht eine schaebige Holzpuppe.\n");
  AddDetail(({"ecke", "eck"}),
	    "In der Ecke steht eine schaebige Holzpuppe. Die wird vermutlich "
	    +"fuer Trainingszwecke benoetigt.\n");
  AddDetail(({"puppe", "holzpuppe"}),
	    "Die Holzpuppe stellt einen Elfen dar und sieht "
	    +"schon ziemlich schaebig aus. Vermutlich wird sie "
	    +"fuer Trainingszwecke mit den Holzstaeben an der "
	    +"Wand verwendet.\n");
  AddDetail(("trainingszwecke"),
            "Solche Trainingszwecke wie einfach fest draufhauen.\n");
  AddDetail(({"elf", "elfen"}),
	    "Der Elf, den die Puppe darstellen soll, erinnert "
	    +"Dich stark an Artyrian.\n");
  AddDetail(({"artyrian", "oberhaupt", "gildenoberhaupt"}),
	    "Artyrian ist das derzeitige Gildenoberhaupt der "
	    +"Bardengilde.\n"); 
  AddDetail(({"bardengilde", "gilde"}),
            "Eine sehr gute Gilde wie Du findest.\n");  
  AddDetail(("geruest"),
            "An dem Geruest sind einige Holzstaebe befestigt. "
            +"Vermutlich Uebungswaffen.\n");
  AddDetail(({"staebe", "holzstaebe", "uebungswaffen"}),
            "Die Holzstaebe, welche an dem Geruest befestigt sind, "
            +"duerften wohl als Uebungswaffen dienen, mit denen "
            +"die Holzpuppe im Eck wohl oft bearbeitet wird.\n");
  AddDetail(({"sandsaecke", "saecke"}),
            "Die Sandsaecke haengen hier in da von der Decke herunter. "
            +"Ein besonders grosser Sandsack sticht Dir besonders ins "
            +"Auge.\n");
  AddDetail(("auge"),
            "Ein besonders grosser Sandsack ist Dir eben ins Auge "
            +"gestochen.\n");
  AddDetail(("sandsack"),
            "Du spuerst ein starkes Verlangen diesen Sandsack zu "
            +"schlagen und zu treten.\n");
  AddDetail(("verlangen"),
            "Dein Verlangen den Sandsack zu treten ist echt stark.\n");
  
  // HIER WAS EINBAUN WENN WAECHTER DA SIND
  
  AddSound( DEFAULT_SOUND,
	    "Endlich ist es hier wieder still.\n");
  AddSmell(("stroh"),
           "Das Stroh riecht nicht mehr allzu gut.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "\n");
  // DETAILS ENDE
  
  // EXITS START

  AddExit(("nordosten"), ROOM+"versteck4");
  AddExit(("suedosten"), ROOM+"versteck1");

  // EXITS ENDE
  
  // COMMANDS START
   
  AddCmd(({"tritt", "schlag", "schlage", "hau", "haue"}), "schlag_was");

  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

schlag_was(str)
{
  notify_fail(BS("Was willst Du schlagen?\n"));
  if (!str) return 0;
  if ((str == "sandsack" || str == "auf sandsack" || str == "in sandsack" ||
       str == "sack" || str == "auf sack" || str == "in sack"))
    {
      switch(random(4))
	{
	case 1: write(BS("Du machst einen maechtigen Schlag gegen den Sandsack "
			 +"und fuehlst Dich danach richtig stark.\n"));
	        say(BS(capitalize(TP->query_real_name())+" schlaegt maechtig gegen einen Sandsack "
	       +"und scheint sich jetzt sichtlich stark zu fuehlen.\n"));    
	       TP->AddHp(5);
	       break; 
	case 3: write(BS("Du willst auf den Sandsack schlagen, rutscht dabei aber aus und knallst "
			 +"unsanft auf dem Boden auf. Du denkst . o 0 \(Aua !!!\)\n"));
	        say(BS(capitalize(TP->query_real_name())+" will gegen den Sandsack schlagen, rutscht dabei aber "
		       +"aus und knallt unsanft auf den Boden. Das hat sicher weh getan.\n"));
	        TP->do_damage(5);
	        break;
	default:  write(BS("Du schlaegst gegen einen Sandsack, worauf dieser eine zeitlang "
			   +"hin und her pendelt und dann wieder zum Stillstand kommt.\n"));
	          say(BS(capitalize(TP->query_real_name())+" schlaegt gegen einen Sandsack, worauf dieser "
	          +"hin und her pendelt und dann wieder zum Sillstand kommt.\n"));
	          break;
	}
      return 1;
    }
  return 0;          
}


reset()
{
  ::reset();
}  

















