#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include "../def.h"

inherit "std/room";

int falle_an=1;

void create()
{
  ::create();

  // ROOM DESCRIPTION;

  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_CAVE]));
  SetProp (P_ARTICLE, 0);
  SetProp (P_NAME, "Ein toedlicher Feuerball");
  SetProp (P_INT_SHORT, "Eine dunkle unheimliche Hoehle");
  SetProp (P_INT_LONG, "Du stehts jetzt in einem weiteren unheimlichen "
	   +"Teil der Hoehle. Die Waende sind ungewoehnlich dunkel und "
	   +"von der Decke haengen riesige Stalaktiten. Unzaehlig viele "
	   +"Gesteinsbrocken liegen hier herum und im Boden sind "
	   +"viele unnatuerlich wirkende Loecher. Ausserdem riecht es "
	   +"hier seltsam. Du hast ein sehr ungutes Gefuehl hier. Zwei "
	   +"Gaenge fuehren von hier weiter. Einer fuehrt nach Norden der "
	   +"andere nach Suedosten.\n");
  
  // ROOM DESCRIPTION END;
  
  // DETAILS START

  AddDetail(("boden"),
	    "Im felsigen Boden sind unzaehlige Loecher und Gruben, welche "
	    +"jedoch alle nicht natuerlich aussehen. Woher die wohl kommen? "
	    +"Abgesehen davon liegen jede Menge Gesteinsbrocken am Boden herum.\n");
  AddDetail(("menge"),
            "Jede Menge Gesteinsbrocken liegen da am Boden herum.\n");
  AddDetail(({"teil"}),
	    "Dieser Teil der Hoehle ist unheimlich. Du hast ein ungutes Gefuehl.\n");
  AddDetail(({"loecher", "loch", "grube", "gruben"}),
	    "Die Loecher und Gruben sehen fast so aus als waeren sie in den "
	    +"Fels gesprengt worden.\n");
  AddDetail(("fels"),
	    "Gewoehnlicher dunkelgrauer Fels.\n");
  AddDetail(("hoehle"),
	    "Du fuehlst Dich ziemlich unwohl in dieser Hoehle. Irgendetwas "
	    +"stimmt hier nicht.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende haben eine unnatuerliche dunkelgraue Farbe. Sieht aus "
	    +"als waeren sie unnatuerlich grosser Hitze ausgesetzt gewesen.\n");
  AddDetail(({"farbe"}),
            "Eine dunkelgraue Farbe.\n");
  AddDetail(("hitze"),
	    "Was kann wohl so grosse Hitze erzeugen?\n");
  AddDetail(("gefuehl"),
	    "Dein Gefuehl sagt Dir, dass irgendwo in dieser Hoehle eine Gefahr lauert.\n");
  AddDetail(("gefahr"),
	    "Irgendwo in dieser Hoehle lauert die Gefahr.\n");
  AddDetail(("stalaktiten"),
	    "Es sind riesige Stalaktiten die da von der Decke haengen. Ein besonders "
	    +"dunkler Stalaktit faellt Dir auf.\n");
  AddDetail(("stalaktit"),
	    "Der Stalaktit ist auffallend dunkler wie die anderen Stalaktiten. Ausserdem "
	    +"wirkt er seltsam kuenstlich. Eine innere Stimme sagt Dir vorsichtig zu sein.\n");
  AddDetail(("stimme"),
	    "Du kannst ihr lauschen.\n");
  AddSound(("stimme"),
	   "Die Stimme warnt: 'Sei vorsichtig "+capitalize(TP->query_real_name(WER, 2))+"!'\n");
  AddDetail(("decke"),
	    "Von der Decke haengen riesige Stalaktiten.\n");
  AddDetail(({"gaenge", " gang"}),
	    "Es gibt hier zwei Gaenge, einer fuehrt nach Suedosten zurueck, der andere "
	    +"fuehrt nach Norden.\n");
  AddDetail(("gutes"),
	    "Diese Stille kann nichts Gutes bedeuten.\n");
  AddDetail(({"brocken", "gesteinsbrocken"}),
	    "Unzaehlige Gesteinsbrocken liegen am Boden herum. Zwischen den Brocken faellt Dir "
	    +"ein Skelett auf.\n");
  AddDetail(({"skelett", "dunkelelfen"}),
	    "Das Skelett eines Dunkelelfen, woran der wohl gestorben ist? Hinter dem Skelett "
	    +"siehst Du ein kaum sichtbares gruenes Licht.\n");
  AddSpecialDetail(({"licht", "lichtwand"}), "licht_schau");
  AddSound( DEFAULT_SOUND,
	    "Die unheimliche Stille laesst auf nichts Gutes schliessen.\n");
  AddSound(("stille"),
            "Wie nicht anders zu erwarten hoerst Du nichts.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht seltsam hier. Irgendwie russig.\n");
  // DETAILS ENDE
  
  // EXITS START

  AddExit(("norden"), ROOM+"hoehle3");
  AddExit(("suedosten"), ROOM+"hoehle1");

  // EXITS ENDE
  
  // COMMANDS START
   
  AddCmd(({"greif", "greife"}), "greif_wohin");
  AddCmd(({"kriech", "krieche"}), "kriech_durch");
  // COMMANDS END
  
  // ITEMS START
  // ITEMS END
}

licht_schau()
{
  if (falle_an==1)
   {
     return(BS("Ein seltsames kaum sichtbares gruenes Licht. "
               +"Man durchschreitet es wenn man nach Norden "
               +"gehen will. Vielleicht solltest du ja mal "
               +"vorsichtig in das Licht greifen.\n"));
    }
  else 
    {
      return(BS("Das Licht scheint jetzt irgendwie extremst "
                +"schwach geworden zu sein.\n"));
    }
}


kriech_durch(str)
{
  notify_fail(BS("Durch was willst Du kriechen.\n"));
  if (!str) return 0;
  if ((str == "durch oeffnung"))
    {
      write("nix gibts vorerst.\n");
      return 1;
    }
  else return 0;
}


greif_wohin(str)
{
  notify_fail(BS("In was willst Du greifen?\n"));
  if (!str) return 0;
  if ((str == "in licht" || str == "vorsichtig in licht" ||
       str == "in gruenes licht" || str == "vorsichtig in gruenes licht"))
    {

      return 1;
    }
  if ((str == "in oeffnung"))
    {

      
      return 1;
    }
  return 0;
}

int falle_aus()
{
  write(("ausgabe"));
  falle_an=0;
  return 1; 
}

int falle_an()
{
  write(("ausgabe"));
  falle_an=1;
  return 1;
}

reset()
{
  ::reset();
  falle_an=1;
}  

















