
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG,  0 );
  SetProp(P_NAME, "Baum");
  SetProp(P_GENDER, MALE);
  AddId( ({ "ast","baum","\n_baum" }) );

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 1000000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, 1);
  
  AddCmd( ({ "schau","schaue","unt","untersuch","untersuche",
             "betracht","betrachte","betr" }) , "untfkt" );
}

tie(string str) {
  if(str== "ast") {
    SetProp(P_NAME, "Ast");
    return 1;
  }
  if(str== "baum") {
    write(BS(
      "An was von dem Baum moechtest Du denn das Seil festbinden?"));
    return 0;
  }
  return 0;
}

untie() {
  SetProp(P_NAME, "Baum");
  return 1;
}

int untfkt(string str) {
  if(str == "baum") {
    write(BS(
      "Der Baum steht ein wenig abseits der Landstrasse. Das ist schon recht "
      "ungewoehnlich, da hier sonst nirgends Baeume stehen. Du kannst auf "
      "seinen Aesten auch ein paar Voegel erkennen."));
    return 1;
  }
  if(str == "ast") {
    write(BS(
      "Die Aeste des Baumes sehen sehr stabil aus. Es sitzen ein paar Voegel "
      "darauf und traellern ein paar Lieder."));
    return 1;
  }
  return 0;
}
