
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Mithrilguertel");
  SetProp(P_LONG,
    "Dieser hervorragend gefertigte Mithrilguertel ist sicher einer der besten "
    "seiner Sorte. Er wuerde Dich im Kampf sicher gut beschuetzen." );
  SetProp(P_NAME, "Mithrilguertel");
  SetProp(P_GENDER, MALE);
  AddId( ({"mithrilguertel", "guertel"}) );

  SetProp(P_ARMOUR_TYPE, AT_BELT );
  SetProp(P_AC, 4 );
  SetProp(P_MATERIAL, ([ MAT_MITHRIL: 100]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 1500);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 250);
}
