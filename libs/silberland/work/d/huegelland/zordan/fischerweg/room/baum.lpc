
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int nestvoll;

create() {
  ::create();

  nestvoll=1;

  SetProp( P_INT_SHORT, "Auf einem kleinen Baum" );
  SetProp( P_INT_LONG,
    "Du sitzt mitten auf dem Baum auf einem dicken Ast. Leider versperren "
    "Dir die vielen Blaetter eine schoene Aussicht. Ein paar Voegel sitzen "
    "quasi direkt neben Dir und traellern ein paar schoene Lieder. Unter Dir "
    "kannst Du die Landstrasse erkennen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_FOREST]) );

  AddDetail( ({"seil"}),
      "Mit diesem Seil bist Du hier heraufgeklettert.");
  
  AddDetail( ({ "himmel","sonne" }),
    "Obwohl Du schon recht weit oben bist, ist die Sonne doch noch sehr "
    "weit entfernt.");

  AddDetail( ({ "ast" }),
    "Saege nie an dem Ast, auf dem Du sitzt!");

  AddDetail( ({ "blaetter","blatt" }),
    "Die Blaetter verdecken Dir leider eine weitere Aussicht von hier aus.");

  AddDetail( ({ "aussicht" }),
    "Du kannst vor lauter Blaettern leider nichts erkennen.");

  AddDetail( ({ "landstrasse","strasse" }),
    "Die Strasse ist direkt unter Dir.");

  AddDetail( ({ "boden" }),
    "Du sitzt direkt auf einem dicken Ast.");

  AddDetail( ({ "nester" }),
    "Viele Voegel haben ihre Nester hier eingerichtet. Eines faellt Dir "
    "besonders auf.");

  AddDetail( ({ "baum","teil" }),
    "Der Baum passt irgendwie gar nicht hierher. Er ist alt und schon "
    "ziemlich morsch. Das Wetter setzt ihm wohl ziemlich zu und die Voegel "
    "tun auch ihren Teil dazu bei, dass der Baum es wohl nicht mehr lange "
    "machen wird. Seine Aeste sind aber noch stabil genug, um Dich tragen "
    "zu koennen.");

  AddDetail( ({ "wetter" }),
    "Das Wetter ist dem Baum einfach zu mild. Es regnet hier wohl nicht "
    "sehr haeufig.");

  AddDetail( ({ "voegel","vogel" }),
    "Viele Voegel haben sich auf diesem Baum niedergesetzt und traellern "
    "froehliche Lieder.");

  AddDetail( ({ "lieder","lied" }),
    "Die kannst Du nur hoeren.");

  AddDetail( ({ "aeste" }),
    "Die Aeste des Baumes sind alt und morsch. Zum Glueck halten sie Dein "
    "Gewicht aber noch aus. Zwischen den vielen Aesten befinden sich ein "
    "paar Nester.");

  AddDetail( ({ "glueck","unglueck" }),
    "Waer ja ein Unglueck, wenn gerade jetzt der Ast auf dem Du sitzt "
    "abbrechen wuerde, oder?");

  AddDetail( ({ "loch","loecher" }),
    "Ein Specht hat wohl schon einige Loecher in den Baum gehackt.");

  AddDetail( ({ "gewicht" }),
    "Na Du koenntest ruhig mal wieder ein wenig abnehmen;)");

  AddSound( DEFAULT_SOUND,
    "Die Voegel zwitschern froehlich vor sich hin.");

  AddSound( ({ "vogel","voegel" }),
    "Die Voegel traellern ein paar froehliche Lieder.");

  AddSound( ({ "lied","lieder","vogelsprache","sprache" }),
    "Du kannst die Vogelsprache leider nicht verstehen. Aber die Lieder "
    "klingen schoen.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier ein wenig streng.");

  AddSpecialDetail( ({ "nest" }),       "nestfkt");
  AddSpecialDetail( ({ "edelsteine", "edelstein" }), "edelfkt");

  AddItem( "/d/huegelland/feyaria/weg/npc/specht" , REFRESH_DESTRUCT);
  AddItem( NPC "elster" , REFRESH_DESTRUCT);

  AddExit( "runter", "./a8a9" );

  AddCmd( ({ "saeg","saege" }) ,        "saegfkt" );
  AddCmd( ({ "nimm","nehm","nehme" }) , "nimmfkt" );

  SUID;
}

reset() {
  ::reset();
  nestvoll=1;
}

int saegfkt(string str) {
  notify_fail("Was moechtest Du absaegen?\n");
  if(str != "ast" && str != "ast ab") return 0;
  write(BS(
    "Du saegst den Ast unter Dir ab und... stuerzt natuerlich ab!"));
  TP->move( ROOM "a8a9", M_GO, 0,
    "saegt den Ast unter sich ab und stuerzt ab",
    "faellt von oben herein");
  if(TP->QueryProp(P_LEVEL)>10)
    TP->do_damage(50+random(50),ME);
  else
    TP->AddHp(-(50+random(50)));
  return 1;
}

string nestfkt(string str) {
  if(nestvoll==0) {
    return BS("Das Nest ist leider komplett leer.");
  }
  return BS("Hoppla. In dem Nest liegt ein Edelstein!");
}

string edelfkt(string str) {
  if(nestvoll==0) return 0;
  return BS("In dem Nest liegt ein Edelstein. Du kannst ihn wohl nehmen.");
}

int nimmfkt(string str) {
  if(nestvoll==0) return 0;
  if(str != "edelstein aus nest") return 0;
  if(present("\n_elster",ME)) {
    write(BS("Die Elster hindert Dich daran!"));
    return 1;
  }
  write(BS(
    "Du greifst in das Nest und nimmst einen Edelstein an Dich."));
  say(BS(
    CAP_TPN+" greift in ein Nest und findet etwas."));
  nestvoll=0;
  "/obj/gemmaster"->DistributeGem(1,0,1,TP);
  return 1;
}
