
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int bezahlt;

create() {
  ::create();

  bezahlt=0;

  SetProp( P_INT_SHORT, "Auf einem kleinen Huegel" );
  SetProp( P_INT_LONG,
    "Du bist jetzt ganz oben auf dem Huegel angekommen. Der Wind pfeift Dir "
    "hier schon ziemlich stark um die Ohren. Dafuer hast Du eine wirklich "
    "gigantische Aussicht ueber die ganze Gegend. Hier befindet sich auch eine "
    "kleine Plattform am Rande der Landstrasse fuer Besucher, auf die Du "
    "Dich auch sogleich stellst." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "fernrohr","rohr" }),
    "Das Fernrohr wurde mitten auf der Plattform angebracht. Ein kleines "
    "Schild haengt neben einem Schlitz. Du kannst sicher durch das Fernrohr "
    "schauen.");

  AddDetail( ({ "schild" }),
    "Du kannst es sicher lesen.");

  AddDetail( ({ "horizont" }),
    "Der Horizont verschwindet in der Ferne im Himmel.");

  AddDetail( ({ "wasser" }),
    "Das Wasser ist sehr weit im Sueden von Dir.");

  AddDetail( ({ "schlitz","einwurfschlitz" }),
    "Der Schlitz stellt sich als Einwurfschlitz fuer Muenzen heraus.");

  AddSpecialDetail( ({ "muenze","muenzen" }), "muenzfkt");

  AddDetail( ({ "plattform","form" }),
    "Die Plattform steht am Rande der Landstrasse. Sie ist komplett aus "
    "Holz gefertigt. Ein kleines Fernrohr ist in ihrer Mitte angebracht "
    "worden.");

  AddDetail( ({ "holz" }),
    "Das ist normales Holz aus dem Silberwald.");

  AddDetail( ({ "silberwald","wald" }),
    "Du kannst den Silberwald schemenhaft im Nordosten erkennen.");

  AddDetail( ({ "mitte" }),
    "Genau in der Mitte der Plattform ist ein Fernrohr angebracht worden.");

  AddDetail( ({ "boden" }),
    "Die Landstrasse besteht wie ueberall nur aus Sand und aus kleinen "
    "Begrenzungssteinen.");

  AddDetail( ({ "sand" }),
    "Der Sand ist ziemlich festgetreten.");

  AddDetail( ({ "begrenzungssteine","steine","stein","begrenzungsstein" }),
    "Die Steine begrenzen die Landstrasse zur Graslandschaft hin.");

  AddDetail( ({ "graslandschaft","landschaft" }),
    "Die Graslandschaft umgibt Dich hier ueberall.");

  AddDetail( ({ "himmel" }),
    "Die Sonne scheint hell vom Himmel herunter.");

  AddDetail( ({ "sonne" }),
    "Die Sonne blendet Dich.");

  AddDetail( ({ "besucher" }),
    "Du bist doch ein Besucher, oder nicht?");

  AddDetail( ({ "gras" }),
    "Das feuchtgruene Gras bewegt sich in dem starken Wind ziemlich stark "
    "hin und her.");

  AddDetail( ({ "aussicht","sicht" }),
    "Die Aussicht von hier oben ist wirklich gigantisch. Du staunst, wie gross "
    "das SilberLand doch eigentlich schon ist und geniesst die prachtvolle "
    "Aussicht mit vollen Zuegen.");

  AddDetail( ({ "silberland","land" }),
    "Du bist in einem Land namens 'SilberLand'. Das solltest Du aber schon "
    "erkannt haben inzwischen.");

  AddDetail( ({ "namens","namen","name" }),
    "Der Name 'SilberLand' ist in Deinen Kopf gebrannt.");

  AddDetail( ({ "zuege","zug" }),
    "Du entspannst Dich und geniesst diesen wundervollen Ort.");

  AddDetail( ({ "ort" }),
    "Dieser Huegel ist mit seiner Aussicht wirklich wunderschoen.");

  AddDetail( ({ "gegend" }),
    "Du bist in einer sehr laendlichen Gegend auf einem Huegel gelandet. "
    "Im Westen und Osten kannst Du in der Ferne ein paar Daecher erkennen. "
    "Im Norden breiten sich schon ein paar Berge aus und im Sueden kannst "
    "Du das blaue Wasser erkennen.");

  AddDetail( ({ "ferne","fern","daecher","dach" }),
    "Die Daecher sind ein gutes Stueck weit entfernt. Genaueres kannst Du "
    "erst dann erkennen, wenn Du hingehst.");

  AddDetail( ({ "stueck" }),
    "Ein wirklich GROSSES Stueck weit entfernt.");

  AddDetail( ({ "berge","berg" }),
    "Die Berge im Norden breiten sich ueber den ganzen Horizont aus. Von hier "
    "aus kannst Du aber keinen direkten Weg dorthin erkennen.");

  AddDetail( ({ "weg" }),
    "Die Landstrasse fuehrt Dich von Westen nach Osten. Du kannst keinen "
    "Weg nach Norden oder Sueden erkennen.");

  AddDetail( ({ "landstrasse","strasse" }),
    "Du stehst auf einer kleinen Plattform am Rande der immer vorhandenen "
    "Landstrasse und geniesst die Aussicht.");

  AddDetail( ({ "rand","strassenrand","wegesrand","wegrand" }),
    "Die Plattform steht am Wegesrand.");

  AddDetail( ({ "huegel" }),
    "Du bist jetzt ganz oben auf dem Huegel angekommen. Sehr hoch ist er "
    "eigentlich nicht. Aber es reicht aus, damit Du die gigantische "
    "Aussicht ueber die ganze Gegend geniessen kannst.");

  AddDetail( ({ "ohr","ohren" }),
    "Die sind noch da, wo sie hingehoeren: an Deinem Kopf :)");

  AddDetail( ({ "kopf" }),
    "Auch der ist noch dort wo er hin soll: auf Deinem Hals :)");

  AddDetail( ({ "hals" }),
    "Ui, Dein Hals ist auch wo er hingehoert: zwischen Koerper und Kopf :)");

  AddDetail( ({ "koerper" }),
    "Juchuuu, Dein Koerper ist auch noch da, genauso wie Du :)");

  AddDetail( ({ "wind" }),
    "Du kannst den Wind direkt nicht sehen. Aber Du spuerst ihn ganz schoen "
    "pusten hier oben und kannst auch sehen, wie das Gras sich in dem Wind "
    "ganz schoen bewegt.");

  AddReadDetail( ({ "schild" }),
    "Einwurf: 10 Muenzen fuer einmal durchsehen.");

  AddSound( DEFAULT_SOUND,
    "Der Wind pfeift Dir ganz schoen um die Ohren.");

  AddSound( ({ "wind" }),
    "Der Wind ist ist wirklich sehr laut hier oben auf dem Huegel.");

  AddSound( ({ "ohr","ohren" }),
    "Genau, mit Deinen Ohren hoerst Du den Wind.");

  AddSmell( ({ DEFAULT_SMELL ,"geruch" }),
    "Du kannst wegen dem Wind kaum etwas riechen. Jeder Geruch wird sofort "
    "weggetragen.");

  AddExit( "westen",    "./a0b3" );
  AddExit( "suedosten", "./b1b5" );
  
  AddCmd( ({ "wirf","werf","werfe" }), "wirffkt" );
  AddCmd( ({ "schaue","schau" }),      "schaufkt" );
}

string muenzfkt(string str) {
  str="Du hast genau "+TP->QueryMoney()+" Muenzen bei Dir.";
  return BS(str);
}

int wirffkt(string str) {
  int nr;
  string wohin;
  notify_fail("Was moechtest Du wo einwerfen?\n");
  if(!str) return 0;
  if (str=="muenze in schlitz" || str=="muenze ein" ||
      str=="muenze in einwurfschlitz" || str=="muenze in schlitz ein"|| 
      str=="muenze in einwurfschlitz ein") {
    nr=1;
  } else {
    if (sscanf(str, "%d muenzen %s", nr, wohin) != 2) return 0;
    if (wohin != "ein" && wohin != "in schlitz" && wohin != "in schlitz ein" &&
        wohin != "in einwurfschlitz" && wohin != "in einwurfschlitz ein")
      return 0;
  }
  if (TP->QueryMoney() < nr) {
    write(BS(
      "Aber soviel Geld hast Du ja gar nicht bei Dir!"));
    return 1;
  }
  if (nr<10) {
    write(BS(
      "Findest Du nicht, dass das ein bisschen wenig ist? Lies doch mal das "
      "Schild neben dem Schlitz!"));
    return 1;
  }
  TP->AddMoney(-nr);
  bezahlt=1;
  write(BS(
    "Du wirfst "+nr+" Muenzen in den Schlitz ein und hoerst ein "
    "leises Klicken.\n"));
  return 1;
}

#define richtungen ([ \
  "norden":     "/d/huegelland/feyaria/weg/room/0409", \
  "osten":      "/d/wasser/woody/fischerdorf/room/hauptstr_w", \
  "sueden":     "/d/dschungel/feyaria/tijara/room/platz_d5", \
  "westen":     "/d/huegelland/andyl/soundquest/room/garten1", \
  "nordosten":  "/d/ebene/Midas/room/kirchturm", \
  "nordwesten": "/d/huegelland/raballion/hobbits/room/hauptplatz", \
  "suedosten":  "/d/wasser/stahldorn/knarkh/room/dorf_e6", \
  "suedwesten": "/d/dschungel/feyaria/dorf/room/dorf-010" ])

int schaufkt(string str) {
  string wohin;
  object ob;
  notify_fail("Wo moechtest Du hindurch schauen?\n");
  if(!str) return 0;
  if(str == "durch fernrohr" || str == "durch fernrohr nach") {
    write(BS(
      "In welche Richtung moechtest Du durch das Fernrohr schauen?"));
    return 1;
  }
  if(sscanf(str,"durch fernrohr nach %s",wohin) != 1) return 0;
  if(!richtungen[wohin]) {
    write(BS(
      "Diese Richtung macht keinen Sinn!"));
    return 1;
  }
  if(bezahlt==0) {
    write(BS(
      "Du schaust durch das Fernrohr. Doch es bleibt alles schwarz. "
      "Wahrscheinlich hast Du irgendetwas wichtiges vergessen!"));
    return 1;
  }
  call_other(richtungen[wohin],"???");
  write(BS(
    "Du schaust durch das Fernrohr nach "+CAP(wohin)+" und siehst:"));
  write(BS(
    "-------------------------------------------------------------------"
    "-----------"));
  ob=find_object(richtungen[wohin]);
  write(ob->int_long(TP,TP,0));
  write(BS(
    "-------------------------------------------------------------------"
    "-----------"));
  bezahlt=0;
  return 1;
}
