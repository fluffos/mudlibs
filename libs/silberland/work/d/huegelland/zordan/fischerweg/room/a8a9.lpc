
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Landstrasse" );
  SetProp( P_INT_LONG,
    "Die Landstrasse macht hier einen kleinen Knick direkt zwischen dem See "
    "im Norden und einem kleinen Haeuschen im Suedosten. Weiterhin steht "
    "hier ungewoehnlicherweise ein grosser Baum abseits des Weges. Die Natur "
    "bietet Dir hier wie fast ueberall ein unglaubliches Schauspiel.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  SetProp (P_KILL_NAME, "Ein tiefer Sturz");
  SetProp (P_KILL_MSG,  "Du solltest nicht so achtlos herumklettern!");

  AddDetail( ({ "boden" }),
    "Auf dem Boden liegt ein wenig Vogeldreck herum.");

  AddDetail( ({ "dreck","vogeldreck" }),
    "Es sieht gelbweiss aus und verbreitet einen nicht so angenehmen Geruch.");

  AddDetail( ({ "geruch" }),
    "Sowas sieht man doch nicht.");

  AddDetail( ({ "himmel" }),
    "Die Sonne wird etwas von den Aesten des Baumes verdeckt.");

  AddDetail( ({ "sonne" }),
    "Sie steht weit oben am Himmel und scheint auf Dich herab.");

  AddDetail( ({ "haeuschen","haus" }),
    "Das kleine Haeuschen steht im Suedosten. Ob sich dort ein Blick hinein "
    "etwa lohnen wuerde? Irgendwie zweifelt etwas in Dir darueber.");

  AddDetail( ({ "blick" }),
    "Du muesstest schon nach Suedosten gehen, um das genauer festzustellen.");

  AddDetail( ({ "baum" }),
    "Der Baum steht ein wenig abseits der Landstrasse. Das ist schon recht "
    "ungewoehnlich, da hier sonst nirgends Baeume stehen. Du kannst auf "
    "seinen Aesten auch ein paar Voegel erkennen.");

  AddDetail( ({ "baeume" }),
    "Hier steht in der ganzen Landschaft nur ein Baum. Und der ist direkt "
    "vor Dir.");

  AddDetail( ({ "aeste","ast" }),
    "Die Aeste des Baumes sehen sehr stabil aus. Es sitzen ein paar Voegel "
    "darauf und traellern ein paar Lieder.");

  AddDetail( ({ "lied","lieder" }),
    "Die kannst Du nicht sehen, nur hoeren.");

  AddDetail( ({ "voegel","vogel" }),
    "Ein paar Voegel sitzen auf dem Baum und traellern froehlich ein paar "
    "Lieder vor sich hin. Ihre Art kannst Du von hier aus nicht bestimmen.");

  AddDetail( ({ "art" }),
    "Du muesstest schon irgendwie auf den Baum kommen, um die Art der Voegel "
    "genauer zu bestimmen.");

  AddDetail( ({ "natur" }),
    "Die Natur gibt hier wirklich alles, um Dir ein unvergessliches Schauspiel "
    "zu liefern.");

  AddDetail( ({ "schauspiel","spiel","naturschauspiel" }),
    "Beeindruckt bleibst Du noch ein wenig stehen und schaust dem "
    "Naturschauspiel weiter zu.");

  AddDetail( ({ "landstrasse","strasse" }),
    "Die Landstrasse macht hier einen kleinen Knick von Norden nach Osten. "
    "Sie ist wie ueberall mit ein paar kleinen Steinen von der Landschaft "
    "getrennt worden.");

  AddDetail( ({ "knick" }),
    "Die Strasse fuehrt von Norden nach Osten weiter und hat somit einen "
    "kleinen Knick.");

  AddDetail( ({ "steine","stein" }),
    "Die kleinen Steine begrenzen die Landstrasse von der Graslandschaft.");

  AddDetail( ({ "gras" }),
    "Das gruene Gras waechst munter aus dem Boden heraus.");

  AddDetail( ({ "graslandschaft","landschaft" }),
    "Die herrliche Landschaft ist hier sehr ruhig und friedlich. Fast waer "
    "Dir schon langweilig geworden. Waere da nicht dieser seltsame Baum direkt "
    "am Weg.");

  AddDetail( ({ "weg","fall" }),
    "Der Weg ist in diesem Fall die Landstrasse.");

  AddDetail( ({ "see" }),
    "Der kleine See liegt weiter im Norden. Du glaubst auch einen kleinen "
    "Bach im Westen zu erkennen.");

  AddDetail( ({ "bach" }),
    "Tatsaechlich. Direkt neben der Landstrasse fliesst ein kleiner Bach im "
    "Westen an Dir vorbei. Er fliesst nicht sehr schnell und plaetschert "
    "nur leise vor sich hin.");

  AddSound( DEFAULT_SOUND,
    "Du kannst nur ein paar Voegel zwitschern hoeren.");
    
  AddSound( ({ "voegel","vogel" }),
    "Die Voegel sitzen wohl auf dem Baum und traellern froehlich ein paar "
    "Lieder.");

  AddSound( ({"lied","lieder"}) ,
    "Leider verstehst Du die Lieder der Voegel nicht. Aber es klingt recht "
    "schoen in Deinen gestressten Ohren.");

  AddSound( ({"ohr","ohren"}) ,
    "Du hoerst mit Deinen Ohren, richtig.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier ein wenig streng nach Vogeldreck.");

  AddSmell( ({ "vogeldreck","dreck" }),
    "Bist Du verrueckt und riechst noch direkt daran herum? Igitt!");

  AddItem( NPC "grashuepfer", REFRESH_DESTRUCT, 
    ([P_MNPC_DEFAULTROOM: file_name(TO),
      P_MNPC_AREA: ROOM "",
      P_MNPC_FLAGS: MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS ]));

  AddItem( OBJ "baum", REFRESH_REMOVE);

  AddExit( "norden",    "./a7a9" );
  AddExit( "suedosten", ([ EX_DEST: "/d/huegelland/zordan/fischerweg/room/a9a0",
                           EX_TESTFUNC: "addzoll" ]) );
  
  AddCmd( ({ "kletter","klettere" }) , "kletterfkt" );

}

int kletterfkt(string str) {
  object ob1,ob2;
  notify_fail("Wohin moechtest Du klettern?\n");
  if(!str) return 0;
  ob1=present("seil",ME);
  ob2=present("\n_baum",ME);
  if(!ob2) {
    write(BS(
      "Irgendetwas stimmt hier nicht. Benachrichtige bitte Zordan ueber diese "
      "Tatsache!"));
    return 1;
  }
  if(str == "auf baum" || str == "baum") {
    if(TP->QueryProp(P_RACE)=="Elf")
    {
      write(BS("Gewandt kletterst Du auf den Baum. Was fuer ein Glueck, dass "
            "Du schon seit Deiner Jugend immer in Baeumen herumkletterst, "
            "sonst waerst Du hier sicher abgestuerzt."));
      TP->move( ROOM "baum" , M_GO,0, 
          "klettert mit elfischer Gewandheit auf den Baum",
          "kommt mit elfischer Gewandheit hereingeklettert");
      return 1;
    }
    if(ob1 && ob1->query_tied_to_ob() == ob2) {
      write(BS(
        "Warum kletterst Du nicht mit dem Seil auf den Baum?"));
      return 1;
    }
    /*  Elfen sollten das sofort merken, dass man so leicht nicht auf den
        Baum klettern kann oder es auch ohne seil schaffen ( Die leben
        ja auf Baeumen).
        Feen sollten beim Sturz keinen Schaden bekommen, da sie ja fliegen
        koennen. */
    if(TP->QueryProp(P_RACE)=="Fee")
    {
      write(BS(
        "Du versuchst ohne weiteres Hilfsmittel auf den Baum zu klettern. Zuerst "
        "gelingt Dir das auch ganz gut, dann aber stuerzt Du ab... und stuerzt "
        "... und stuerzt und flatterst wie wild mit Deinen kleinen Fluegelchen "
        "... und kannst gerade noch einen schlimmen Sturz verhindern. Wenn Du "
        "keine Fee waerest, haettest Du Dir jetzt Dein Genick gebrochen!!!"));
      return 1;
    }
    write(BS(
      "Du versuchst ohne weiteres Hilfsmittel auf den Baum zu klettern. Zuerst "
      "gelingt Dir das auch ganz gut, dann aber stuerzt Du ab... und stuerzt "
      "... und stuerzt ... und schlaegst sehr hart auf den Boden auf. Fast "
      "haettest Du Dir Dein Genick gebrochen!!!"));
    say(BS(
      CAP_TPN+" versucht auf den Baum zu klettern und stuerzt ab."));
    if(TP->QueryProp(P_LEVEL)>10)
      TP->do_damage(20+random(50),ME);
    else
      TP->AddHp(-(20+random(50)));
    return 1;
  }
  if(str != "mit seil auf baum" && "an seil auf baum") return 0;
  if(!ob1) {
    if(present("seil",TP)) {
      write(BS(
        "Vielleicht solltest Du das Seil erst irgendwo festbinden?"));
      return 1;
    }
    write(BS("Hier ist nirgendwo ein Seil!"));
    return 1;
  }
  if(ob1->query_tied_to_ob() != ob2) {
    write(BS(
      "Vielleicht solltest Du das Seil erst irgendwo festbinden und nicht "
      "einfach nur ablegen?"));
    return 1;
  }
  write(BS(
    "Mit Hilfe des Seils kletterst Du mit Leichtigkeit auf den Baum."));
  TP->move( ROOM "baum" , M_GO,0, 
    "klettert auf den Baum",
    "kommt hereingeklettert");
  return 1;
}

init() {
  ::init();
  if(interactive(TP)) call_other( ROOM "a9a0", "AddPlayer", 2);
}

addzoll() {
  if(interactive(TP)) call_other( ROOM "a9a0", "AddPlayer", 2);
  return 1;
}
