
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Landstrasse" );
   SetProp( P_INT_LONG,
    "Der Weg fuehrt immer weiter aus dem Fischerdorf hinaus und wirkt hier "
    "schon sehr ausgetreten. Weiter im Osten kannst Du eine grosse, gruene "
    "Flaeche nur noch schwach erkennen. Ein paar Steine liegen am Wegesrand "
    "und markieren so die Strasse." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist aus festgetretenem Sand und bildet so eine hervorragende "
    "Strasse.");

  AddDetail( ({ "himmel" }),
    "Die Sonne scheint friedlich vom Himmel herunter und erwaermt Dich.");

  AddDetail( ({ "sonne" }),
    "Die Sonne scheint im schoensten Gelb vom Himmel herunter.");

  AddDetail( ({ "gelb" }),
    "Herrlichstes Gelb.");

  AddDetail( ({ "wiese" }),
    "Du kannst von der Wiese von hier aus nicht viel erkennen.");

  AddDetail( ({ "sand" }),
    "Der Sand ist ziemlich festgetreten. Auf dieser Strasse scheint ziemlich "
    "viel Verkehr zu herrschen.");

  AddDetail( ({ "verkehr" }),
    "Das sind wohl die Handelsbeziehungen zwischen Derlim und dem "
    "Fischerdorf.");

  AddDetail( ({ "derlim" }),
    "Derlim liegt wohl weiter im Westen von hier aus. Aber das ist noch ein "
    "weiter Weg bis dorthin.");

  AddDetail( ({ "handelsbeziehungen","beziehungen" }),
    "Die Hobbits brauchen diese Beziehungen um ihren Hunger zu stillen.");

  AddDetail( ({ "hobbits","hobbit" }),
    "Auch einige Hobbitspuren sind auf dem Weg zu erkennen.");

  AddDetail( ({ "hunger" }),
    "Hobbits haben immer Hunger.");

  AddDetail( ({ "hobbitspuren","spuren","spur" }),
    "Neben den normalen Spuren finden sich hier auch viele von kleinen "
    "Hobbits.");

  AddDetail( ({ "weg","strasse" }),
    "Die Strasse fuehrt Dich derzeit von Westen nach Osten. Weiter im Westen "
    "scheint sie aber eine Biegung nach Norden zu machen.");

  AddDetail( ({ "biegung" }),
    "Die Biegung ist noch zu weit weg.");

  AddDetail( ({ "fischerdorf","dorf" }),
    "Du kannst nur noch die Umrisse des Fischerdorfes erkennen. Es liegt "
    "weiter im Osten.");

  AddDetail( ({ "umrisse" }),
    "Um mehr zu erforschen, musst Du schon naeher hingehen. Ein paar Daecher "
    "kannst Du nur noch schemenhaft wahrnehmen.");

  AddDetail( ({ "dach","daecher" }),
    "Das sind wohl die Daecher des Fischerdorfes.");

  AddDetail( ({ "flaeche" }),
    "Bei der gruenen Flaeche handelt es sich wohl um eine grosse Wiese. Von "
    "hier aus siehst Du aber keine Moeglichkeit sie zu betreten.");

  AddDetail( ({ "moeglichkeit" }),
    "Nein, Du erkennst hier wirklich keine.");

  AddDetail( ({ "steine" }),
    "Links und rechts am Wegesrand liegen ein paar kleine Steine. Sie sollen "
    "wohl die Strasse markieren. Ein kleiner Stein liegt aber mitten auf der "
    "Strasse.");

  AddDetail( ({ "stein" }),
    "Der Stein passt irgendwie nicht in diese Umgebung. Er ist viel kleiner "
    "und runder als alle anderen.");

  AddDetail( ({ "umgebung" }),
    "Die Umgebung hier ist sehr friedlich und ruhig. Waer hier eine "
    "Gelegenheit sich zu setzen, wuerdest Du sie wohl wahrnehmen.");

  AddDetail( ({ "gelegenheit" }),
    "Du suchst eine, aber leider wirst Du nicht fuendig :(");

  AddDetail( ({ "wegesrand","rand","strassenrand" }),
    "Am Wegesrand liegen ein paar kleine Steine herum.");

  AddDetail( ({ "mottenkugel","kugel" }),
    "Der kleine Stein ist tatsaechlich eine Mottenkugel. Wie die nur "
    "hierher gekommen ist?");

  AddSound( DEFAULT_SOUND,
    "In weiter Ferne kannst Du das Meer rauschen hoeren.");
    
  AddSound( ({ "meer","ferne" }),
    "Das Meer rauscht in weiter Ferne.");
    
  AddSmell( DEFAULT_SMELL,
    "Aus dem Osten stroemt ein sehr frischer Geruch herein.");

  AddSmell( "geruch",
    "Es riecht wirklich sehr frisch und angenehm hier.");

  AddExit( "westen", "./b3b7" );
  AddExit( "osten",  "/d/wasser/woody/fischerdorf/room/wiesenweg" );

  AddItem( NPC "haendler", REFRESH_DESTRUCT);

  AddCmd( ({ "nimm","nehme","nehm","heb","hebe" }) , "nimmfkt" );
}

int nimmfkt(string str) {
  notify_fail("Was moechtest Du gerne nehmen?\n");
  if(str != "stein" && str != "stein auf") return 0;
  write(BS(
    "Du nimmst den kleinen Stein auf und betrachtest ihn ganz genau. Erst "
    "jetzt stellst Du fest, dass es gar kein Stein, sondern eine kleine "
    "Mottenkugel ist. Erstaunt schnupperst Du daran herum. Igitt, sowas kannst "
    "Du echt nicht gebrauchen und wirfst die Mottenkugel wieder weg."));
  say(BS(
    CAP_TPN+" nimmt einen kleinen Stein auf und wirft ihn dann wieder weg."));
  return 1;
}
