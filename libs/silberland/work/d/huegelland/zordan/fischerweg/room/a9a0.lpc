
#include "../def.h"

inherit "std/room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

#include <properties.h>
#include <language.h>
#include <bank.h>

nosave mapping zoll;

create() {
  ::create();

  zoll=([ ]);

  SetProp( P_INT_SHORT, "In einem Zollhaeuschen" );
  SetProp( P_INT_LONG,
    "Du stehst inmitten eines kleinen Haeuschens. Das Haeuschen ist nach "
    "Nordwesten und Osten offen und hat bis auf eine kleine Schranke gar "
    "kein Inventar. Das Haeuschen wurde komplett aus Holz gefertigt und Du "
    "wirst keinen Weg an der Schranke vorbei finden. Eine kleine Tafel "
    "haengt an einer der Waende. Das Dach ueber Dir bietet jedenfalls "
    "genug Schutz vor einem drohendem Regen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_NOQUIT, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "weg" }),
    "Du wirst schon durch die Schranke gehen muessen.");

  AddDetail( ({ "inventar" }),
    "Na ein kleiner Stuhl fuer die Zollwaechterin steht noch neben der Schranke. "
    "Ausserdem koennte man die kleine Tafel auch zum Inventar zaehlen.");

  AddDetail( ({ "holz" }),
    "Das ist normales Holz aus dem Silberwald.");

  AddDetail( ({ "silberwald","wald" }),
    "Der ist ganz schoen weit weg von hier. Hast Du ihn schon einmal besucht?");

  AddDetail( ({ "tafel" }),
    "Du kannst sie lesen.");

  AddDetail( ({ "waende","wand" }),
    "Die Waende bestehen aus Holz. Allerdings nicht im Nordwesten und Osten. "
    "Dort ist das Haeuschen naemlich komplett offen.");

  AddDetail( ({ "decke","dach" }),
    "Das Dach ist ganz dicht wie es ausschaut und wird Dich vor einem "
    "Regenguss schuetzen.");

  AddDetail( ({ "schutz" }),
    "Der Schutz des Daches wird leicht ausreichen.");

  AddDetail( ({ "regenguss","guss","regen" }),
    "Es regnet allerdings sehr selten in dieser Gegend.");

  AddDetail( ({ "gegend" }),
    "Du bist immer noch auf der Landstrasse in der Graslandschaft unterwegs.");

  AddDetail( ({ "landstrasse","strasse" }),
    "Die Strasse fuehrt hier genau durch das kleine Haeuschen hindurch.");

  AddDetail( ({ "gras","grashalm","halm" }),
    "Du kannst hier kaum einen Grashalm erkennen.");

  AddDetail( ({ "graslandschaft","landschaft" }),
    "Die Landschaft ist mehr ausserhalb des Haeuschens zu bewundern.");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus kleinen Holzplanken.");

  AddDetail( ({ "holzplanken","planken","name" }),
    "Die Holzplanken sind, wie der Name schon sagt, komplett aus Holz. Sie "
    "sehen recht abgenutzt aus.");

  AddDetail( ({ "stuhl" }),
    "Der Stuhl steht direkt neben der Schranke.");

  AddDetail( ({ "haus","haeuschen" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "schranke" }),
    "Die Schranke hindert Dich daran, einfach so weiter zu gehen. Sie ist "
    "mit roten und weissen Streifen bemalt worden.");

  AddDetail( ({ "streifen" }),
    "Die Streifen deuten ganz klar darauf hin, dass das hier eine Zollstation "
    "ist und die Schranke verbotenes Durchschreiten verhindern soll.");

  AddDetail( ({ "zollstation" }),
    "Ja genau. Du bist in einer Zollstation gelandet.");

  AddDetail( ({ "durchschreiten","schreiten" }),
    "Das wirst Du erst koennen, wenn Du Deinen Zoll abgeliefert hast oder aber "
    "die Zollwaechterin vernichtet hast.");

  AddDetail( ({ "zollwaechterin","waechterin","verlauf" }),
    "Hier wacht eine Zollwaechterin ueber den ordnungsgemaessen Verlauf der "
    "Dinge.");

  AddDetail( ({ "ding","dinge" }),
    "Na, dass hier auch brav Wegezoll abgeliefert wird.");

  AddDetail( ({ "wegezoll","zoll" }),
    "Da solltest Du Dich an die Zollwaechterin wenden.");

  AddReadDetail( ({ "tafel" }),
    "----------------------------------------------------\n"
    "                   Preisliste:                     \n"
    "----------------------------------------------------\n"
    " Fuer die Durchquerung der Zollschranke muessen Sie \n"
    " ganz genau @@amount@@ Muenzen an die Zollwache zahlen.\n"
    "\n"
    " Hochachtungsvoll, der Stadtrat von Derlim\n"
    "----------------------------------------------------\n");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Holz ein wenig knarren.");
    
  AddSound( ({ "holz","knarren" }),
    "Das alte Holz knarrt ein wenig.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach Holz.");

  AddSmell( ({ "holz" }),
    "Das Holz, aus dem das Haeuschen gebaut worden ist, riecht ein wenig "
    "vermodert.");

  AddExit( "osten", ([
            EX_DEST: "./a9b1",
            EX_TESTFUNC: "zollfkt1",
           ]) );

  AddExit( "nordwesten", ([
            EX_DEST: "./a8a9",
            EX_TESTFUNC: "zollfkt2",
           ]) );
           
  AddItem( NPC "zollwache", REFRESH_DESTRUCT );
  
  AddCmd( ({ "schlaf","schlafe" }) , "schlaffkt" );
}

reset() {
  int geld,i,notdel;
  mixed ind;
  object ob;
    
  ::reset();
  geld=0;
  ind=m_indices(zoll);
  for(i=0;i<sizeof(ind);i++) {
    notdel = 0;
    if(ob=present(ind[i]))
    {
      if(interactive(ob) && ob->InFight())
      {
        notdel = 1;
      }
    }
    if(notdel == 0)
    {
      if(intp(zoll[ind[i],1])) geld+=zoll[ind[i],1];
      zoll = m_delete( zoll, ind[i]);
    }
  }
  if(geld>0) ZENTRALBANK->PayIn(geld);
  // zoll=([ ]);
}

int AddPlayer(int nr) {
  string pl;
  pl=getuid(TP);
  if(member(zoll, pl)) {
    zoll[pl,0]=nr;
    return 0;
  }
  zoll+=([pl:nr;0]);
  return 1;
}

int zollfkt(int nr) {
  string pl;
  object ob;
  pl=getuid(TP);
  if(!ob=present("\n_zollwache",ME)) return 1;
  if(!member(zoll, pl)) AddPlayer(0);
  if(IS_LEARNING(TP)) {
    tell_room(ME,break_string(
      "Oh "+TPN+", Du bist Magier und darfst natuerlich so passieren!",
      78,"Die Zollwaechterin sagt: "));
    write(BS("Die Zollwaechterin laechelt Dich an."));
    say(BS("Die Zollwaechterin laechelt "+TPN+" an."));
    return 1;
  }
  if(TP->QueryProp(P_LEVEL)<6) {
    tell_room(ME,break_string(
      "Och "+TPN+", Du bist ja ein kleiner Wurm. Du darfst einfach "
      "so passieren!",78,"Die Zollwaechterin sagt: "));
    write(BS("Die Zollwaechterin laechelt Dich an."));
    say(BS("Die Zollwaechterin laechelt "+TPN+" an."));
    return 1;
  }
  /* 
  
    !!! wegen Woody entfernt !!!
    
  if(ob->InFight()) {
    write(BS(
      "Die Zollwaechterin ist in einen Kampf verwickelt und laesst "
      "Niemanden mehr weg!!!"));
    return 0;
  }
  */
  if(nr==zoll[pl,0]) return 1;
  if(zoll[pl,1] >= TP->QueryProp(P_LEVEL)*10) {
    tell_room(ME,break_string(
      "Du hast bezahlt "+TPN+" und darfst passieren!",
      78,"Die Zollwaechterin sagt: "));
    write(BS("Die Zollwaechterin laechelt Dich an."));
    say(BS("Die Zollwaechterin laechelt "+TPN+" an."));
    return 1;
  }
  tell_room(ME,break_string(
    CAP_TPN+", Du hast noch keinen Wegezoll abgeliefert und darfst nicht "
    "passieren!",78,"Die Zollwaechterin sagt ernst: "));
  write(BS("Die Zollwaechterin schaut Dich erwartungsvoll an."));
  say(BS("Die Zollwaechterin schaut "+TPN+" erwartungsvoll an."));
  return 0;
}

int zollfkt1() {
  if(!interactive(TP)) return 1;
  return zollfkt(1);
}

int zollfkt2() {
  if(!interactive(TP)) return 1;
  return zollfkt(2);
}

int AddMoney(int amount) {
  string pl;
  pl=getuid(TP);
  if(!member(zoll, pl)) AddPlayer(0);
  zoll[pl,1]+=amount;
  return 1;
}

int GetMoney() {
  string pl;
  pl=getuid(TP);
  if(!member(zoll, pl)) return 0;
  return zoll[pl,1];
}

mixed GetZoll() {
  return zoll;
}

string amount() {
  return sprintf("%d",TP->QueryProp(P_LEVEL)*10);
}

int schlaffkt(string str) {
  if(TP->InFight()) {
    write(BS(
      "Im Kampf einschlafen wuerde Dich sofort toeten!!!"));
    return 1;
  }
  return 0;
}

void BecomesNetAlive(object ob) {
  string pl; 
  pl=getuid(ob);
  if(member(zoll, pl) == 0) {
    zoll+=([pl:random(2)+1;0]);
  }
}

public void init() {
  ::init();

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}

