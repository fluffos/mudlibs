
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <mnpc.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Landstrasse" );
  SetProp( P_INT_LONG,
    "Die Landstrasse fuehrt Dich weiter durch eine wundervolle Graslandschaft. "
    "Sehr weit im Osten kannst Du die Umrisse einer kleinen Siedlung und "
    "direkt davor eine intensiv gruene Flaeche erkennen. Die Strasse fuehrt "
    "hier geradewegs weiter und macht im Westen eine kleine Biegung." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "himmel" }),
    "Es sind fast keine Wolken zu erkennen.");

  AddDetail( ({ "wolken" }),
    "Die vereinzelten Wolken ziehen sehr langsam ueber den Horizont hinweg. "
    "Eine schaut sehr witzig aus.");

  AddDetail( ({ "horizont" }),
    "Du kannst den Horizont von hier aus nicht sehr gut erkennen. Aber die "
    "Wolken verschwinden in ihm.");

  AddDetail( ({ "wolke","tag" }),
    "Eine Wolke scheint Dich anzugrinsen und Dir einen schoenen Tag "
    "zuzurufen.");

  AddDetail( ({ "boden" }),
    "Die Strasse ist hier ausgebaut und der Sand wird an beiden Seiten von "
    "ein paar Steinen begrenzt.");

  AddDetail( ({ "seiten","seite" }),
    "An den Seiten ist die Strasse durch ein paar Steine begrenzt worden.");

  AddDetail( ({ "steine","strassenrand","rand","wegesrand" }),
    "Kleine und grosse Steine saeumen den Strassenrand. Ein etwas groesserer "
    "Stein faellt Dir besonders auf.");

  AddDetail( ({ "stein" }),
    "Der Stein steht aufrecht am Strassenrand und traegt eine Zahl. Was "
    "das wohl zu bedeuten hat?");

  AddDetail( ({ "zahl","zwei" }),
    "Auf dem Stein steht eine grosse Zwei. Sie koennte die Entfernung zu "
    "der Siedlung darstellen.");

  AddDetail( ({ "entfernung" }),
    "Weit weg ist die Siedlung sicher nicht mehr.");

  AddDetail( ({ "sand" }),
    "Du stehst direkt auf der Strasse auf dem Sand.");

  AddDetail( ({ "umrisse" }),
    "Du kannst von hier aus die Umrisse einer Siedlung wirklich nur "
    "erahnen. Du musst schon weiter nach Osten gehen, um mehr zu erkennen.");

  AddDetail( ({ "siedlung" }),
    "Es sind nur die Umrisse einer Siedlung zu erkennen.");

  AddDetail( ({ "flaeche" }),
    "Die grosse, gruene Flaeche ist direkt vor der Siedlung. Von hier aus "
    "kannst Du aber nicht sehr viel erkennen. Nur, dass es auch dort "
    "wundervoll sein muss.");

  AddDetail( ({ "biegung" }),
    "Die Landstrasse macht im Westen eine Biegung nach Norden.");

  AddDetail( ({ "landstrasse","strasse" }),
    "Die Landstrasse fuehrt hier geradewegs von Westen nach Osten weiter.");

  AddDetail( ({ "graslandschaft","landschaft" }),
    "Du stehst inmitten einer wundervollen Graslandschaft. Du geniesst die "
    "Stille die hier herrscht und moechtest diesen Ort am liebsten nie "
    "wieder verlassen.");

  AddDetail( ({ "gras" }),
    "Das Gras waechst ueberall um Dich herum in einem satten Gruen.");

  AddDetail( ({ "gruen" }),
    "Das Gruen sticht Dir fast in die Augen, so herrlich ist es.");

  AddDetail( ({ "augen","auge" }),
    "Na, die sind noch da :)");

  AddDetail( ({ "ort" }),
    "Dieser Ort ist einfach wundervoll.");

  AddDetail( ({ "pflanze" }),
    "Diese Pflanze ist gruen und hat komische Stachel an ihren Blaettern. Du "
    "solltest sie besser nicht pfluecken oder anfassen.");

  AddDetail( ({ "blaetter","blatt" }),
    "Die Blaetter sind gruen und haben seltsame Stachel.");

  AddDetail( ({ "stachel" }),
    "Die Stachel koennten Dich stechen!!");

  AddDetail( ({ "pflanzen" }),
    "Mehrere Pflanzen wachsen hier am Wegesrand. Eine Pflanze sieht schon "
    "irgendwie komisch aus.");

  AddSound( DEFAULT_SOUND,
    "Du geniesst einfach nur die Stille hier.");
    
  AddSound( "stille",
    "Es ist einfach wirklich ruhig hier.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischen Pflanzen.");

  AddSmell( ({"pflanzen","pflanze"}),
    "Die Pflanzen riechen nicht sehr stark, aber gefaehrlich.");

  AddExit( "westen", "./b3b6" );
  AddExit( "osten",  "./b3b8" );

  AddCmd( ({ "pflueck","pfluecke" }), "pflueckfkt" );
  AddCmd( ({ "fass","fasse" }),      "fassfkt" );

  AddItem( NPC "grashuepfer", REFRESH_DESTRUCT, 
    ([P_MNPC_DEFAULTROOM: file_name(TO),
      P_MNPC_AREA: ROOM "",
      P_MNPC_FLAGS: MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS ]));

}

int pflueckfkt(string str) {
  notify_fail("Was moechtest Du denn pfluecken?\n");
  if(str != "pflanze") return 0;
  write(BS(
    "Du nimmst all Deinen Mut zusammen und versuchst die Pflanze zu pfluecken. "
    "Doch Du stellst Dich zu ungeschickt an und stichst Dich an der Pflanze. "
    "Aua, das tut weh!"));
  say(BS(
    CAP_TPN+" versucht etwas zu pfluecken und schreit laut auf."));
  TP->AddHp(-(5+random(10)));
  return 1;
}

int fassfkt(string str) {
  notify_fail("Was moechtest Du anfassen?\n");
  if(str != "pflanze" && str != "pflanze an") return 0;
  write(BS(
    "Du fasst die Pflanze an und es passiert was passieren musste. Du bekommst "
    "einen stechenden Schmerz zu spueren!"));
  say(BS(
    CAP_TPN+" faesst eine Pflanze an und schreit laut auf."));
  TP->AddHp(-(5+random(10)));
  return 1;
}

