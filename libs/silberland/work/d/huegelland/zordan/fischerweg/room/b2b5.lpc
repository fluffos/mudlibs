
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <mnpc.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Landstrasse" );
  SetProp( P_INT_LONG,
    "Im Norden fuehrt die Landstrasse langsam einen kleinen Huegel hinauf. Sie "
    "macht hier auch eine Biegung nach Osten. Du geniesst die Natur hier in "
    "vollen Zuegen. Du beschliesst aber recht schnell, Deine Reise "
    "fortzusetzen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "problem","probleme" }),
    "Davon gibt es hier sicher keine:)");

  AddDetail( ({ "fortbewegen" }),
    "Das Fortbewegen stellt hier wegen der ausgebauten Strasse keine Probleme "
    "dar.");

  AddDetail( ({ "himmel" }),
    "Die Sonne steht hoch am Himmel und erwaermt Dich.");

  AddDetail( ({ "sonne" }),
    "Gleissend hell strahlt die Sonne vom Himmel herunter.");

  AddDetail( ({ "boden" }),
    "Der Boden ist ausgetrampelt. Das liegt wohl an dem vielen Verkehr hier.");

  AddDetail( ({ "verkehr" }),
    "Obwohl, derzeit ist es eher ruhig hier.");

  AddDetail( ({ "landstrasse","strasse" }),
    "Die Strasse fuehrt im Norden auf einen kleinen Huegel und macht im "
    "Osten eine Biegung. Sie ist sehr gut ausgebaut und das Fortbewegen "
    "stellt keine groesseren Probleme dar.");

  AddDetail( ({ "huegel" }),
    "Der Huegel befindet sich weiter im Norden.");

  AddDetail( ({ "biegung" }),
    "Die Strasse fuehrt nicht weiter nach Sueden, sondern mehr in Richtung "
    "Osten.");

  AddDetail( ({ "richtung" }),
    "Im Osten kannst Du in weiter Ferne ein paar Daecher ausmachen.");

  AddDetail( ({ "daecher","dach" }),
    "Genaueres kannst Du von hier aus leider nicht ausmachen.");

  AddDetail( ({ "natur" }),
    "Die Natur ist einfach nur herrlich hier.");

  AddDetail( ({ "zuege","zug" }),
    "So gern Du auch hier bist, es wird eher langweilig und Du beschliesst "
    "Deine Reise fortzusetzen.");

  AddDetail( ({ "reise" }),
    "Auf einer Strasse ist man normalerweise auf einer Reise unterwegs und "
    "verweilt nicht lange an einem Ort.");

  AddDetail( ({ "ort" }),
    "Mit Ort ist doch die Strasse gemeint.");

  AddSound( DEFAULT_SOUND,
    "Du kannst hier kaum etwas hoeren.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach frischem Wind.");

  AddSmell( ({"wind","nase"}),
    "Der Wind weht Dir frisch um die Nase.");

  AddItem( "/d/kristallwald/sargola/lichtung/npc/biene", REFRESH_DESTRUCT, 
    ([P_MNPC_DEFAULTROOM: file_name(TO),
      P_MNPC_AREA: ROOM "",
      P_MNPC_FLAGS: MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS ]));

  AddExit( "norden",    "./b1b5" );
  AddExit( "suedosten", "./b3b6" );
}
