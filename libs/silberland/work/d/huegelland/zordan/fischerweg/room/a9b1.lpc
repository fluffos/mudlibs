
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <mnpc.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Landstrasse" );
  SetProp( P_INT_LONG,
    "Deine Wanderung fuehrt Dich auf der Landstrasse weiter. Zu Deinem "
    "Erstaunen ist direkt im Westen ein kleines Haeuschen zu sehen. Im Osten "
    "fuehrt die Landstrasse einen kleinen Huegel rauf." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "acht" }),
    "Der Pfeil der 'Acht' zeigt nach Westen.");

  AddDetail( ({ "neun" }),
    "Der Pfeil der 'Neun' zeigt nach Osten.");

  AddDetail( ({ "ruhe" }),
    "Es ist wirklich sehr friedlich und ruhig hier.");

  AddDetail( ({ "himmel" }),
    "Die Sonne steht hoch am Himmel und scheint auf Dich herab.");

  AddDetail( ({ "sonne" }),
    "Die Sonne erwaermt Dein Gemuet.");

  AddDetail( ({ "gemuet" }),
    "Du hast eine wirklich gute Stimmung derzeit.");

  AddDetail( ({ "stimmung" }),
    "Hoffentlich aendert die sich nicht mehr so schnell.");

  AddDetail( ({ "erstaunen" }),
    "Na ungewoehnlich ist so ein Haeuschen hier allemal.");

  AddDetail( ({ "haeuschen","haus" }),
    "Das Haeuschen ist nicht sehr gross. Aber es faellt Dir schon ziemlich "
    "in dieser Landschaft auf.");

  AddDetail( ({ "huegel" }),
    "Ein kleiner Huegel erstreckt sich im Osten. Wenn Du weiter nach Osten "
    "gehst, wirst Du um ein Erklimmen des Huegels nicht vorbeikommen.");

  AddDetail( ({ "erklimmen" }),
    "Na so schlimm ist das auch nicht.");

  AddDetail( ({ "boden" }),
    "Der sandige Boden ist sehr ausgetreten.");

  AddDetail( ({ "sand" }),
    "Der gelbe Sand ist ziemlich fest zusammengetreten.");

  AddDetail( ({ "wanderung" }),
    "Deine Wanderung zieht sich jetzt schon eine Weile auf der Landstrasse "
    "durch die Landschaft. Du geniesst die Ruhe auf Deiner Wanderung sehr.");

  AddDetail( ({ "weile" }),
    "Du bist schon eine Weile unterwegs. Aber stehenbleiben moechtest Du "
    "hier sicher auch nicht, oder?");

  AddDetail( ({ "landstrasse","strasse" }),
    "Wie zuvor fuehrt Dich die Landstrasse durch die wundervolle Landschaft "
    "weiter. Ein grosser Stein steht hier mitten an der Strasse.");

  AddDetail( ({ "landschaft","graslandschaft" }),
    "Die Graslandschaft ist einfach herrlich. Du kannst gar nicht genug "
    "davon in Dich einsaugen.");

  AddDetail( ({ "gras","gruen" }),
    "Das Gras waechst hier ueberall um Dich herum in einem satten Gruen.");

  AddDetail( ({ "stein" }),
    "Auf dem Stein sind zwei grosse Zahlen gemalt worden.");

  AddDetail( ({ "zahlen","zahl" }),
    "Es handelt sich dabei um eine 'Neun' mit einem Pfeil nach Osten und "
    "eine 'Acht' mit einem Pfeil nach Westen.");

  AddDetail( ({ "pfeil","pfeile","richtung" }),
    "Die Pfeile deuten in eine Richtung.");

  AddSound( DEFAULT_SOUND,
    "Du kannst hier nichts Besonderes hoeren.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier sehr frisch.");

  AddExit( "westen", ([ EX_DEST: "/d/huegelland/zordan/fischerweg/room/a9a0",
                        EX_TESTFUNC: "addzoll" ]) );
  AddExit( "osten",  "./a9b2" );

  AddItem( NPC "wanderer", REFRESH_DESTRUCT, 
    ([P_MNPC_DEFAULTROOM: file_name(TO),
      P_MNPC_AREA: ROOM "",
      P_MNPC_FLAGS: MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS ]));
}

init() {
  ::init();
  if(interactive(TP)) call_other( ROOM "a9a0", "AddPlayer", 1);
}

addzoll() {
  if(interactive(TP)) call_other( ROOM "a9a0", "AddPlayer", 1);
  return 1;
}
