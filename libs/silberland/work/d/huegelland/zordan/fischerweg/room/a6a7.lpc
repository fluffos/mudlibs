
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int fische;
object *angelt;

create() {
  ::create();

  fische=8+random(4);
  angelt=({ });

  SetProp( P_INT_SHORT, "An einer kleinen Angelstelle" );
  SetProp( P_INT_LONG,
    "Direkt hier am See ist ein perfekter Angelplatz. Die Landstrasse fuehrt "
    "ganz dicht an dem See entlang und auf ein paar Steinen koennte man sich "
    "bestimmt toll zum Angeln niederlassen. Ein paar Fische kann man ab und "
    "zu an der Wasseroberflaeche ausmachen. Im Suedosten kannst Du eine "
    "kleine Bruecke ausmachen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "see" }),
    "Du bist jetzt sehr nah an dem See angelangt. Die Landstrasse fuehrt "
    "direkt am See vorbei. Du koenntest ja einmal versuchen, hier zu angeln.");

  AddDetail( ({ "angelplatz","platz","angeln" }),
    "Der Platz hier sieht einfach perfekt fuer ein erfolgreiches Angeln aus.");

  AddDetail( ({ "landstrasse","strasse" }),
    "Die Landstrasse fuehrt hier sehr nah am Ufer des Sees entlang.");

  AddDetail( ({ "ufer" }),
    "Das Ufer des Sees ist direkt vor Deinen Fuessen.");

  AddDetail( ({ "fuesse","fuss" }),
    "Deine Fuesse werden schon fast ganz nass.");

  AddDetail( ({ "steine","stein" }),
    "Ein paar Steine begrenzen die Landstrasse. Am Ufer liegen noch ein paar "
    "groessere, auf die man sich vielleicht zum Angeln niederlassen kann.");

  AddDetail( ({ "fische","fisch" }),
    "Du kannst unzaehlbar viele Fische in dem kleinen See erkennen. Manchmal "
    "tauchen sie an die Wasseroberflaeche.");

  AddDetail( ({ "wasseroberflaeche","oberflaeche" }),
    "Die Wasseroberflaeche ist sehr flach und ruhig. Nur manchmal kannst "
    "Du einen Fisch an die Wasseroberflaeche tauchen sehen.");

  AddDetail( ({ "bruecke" }),
    "Die kleine Bruecke fuehrt ueber einen kleinen Bach. Du musst schon naeher "
    "hingehen, um mehr erkennen zu koennen.");

  AddDetail( ({ "bach" }),
    "Der Bach fuehrt entweder in oder aus dem See hinaus. Das kannst Du von "
    "hier aus nicht genau erkennen.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist hier sehr blau. Die Sonne scheint von ihm herunter.");

  AddDetail( ({ "sonne" }),
    "Die Sonne scheint hell vom Himmel herunter.");

  AddDetail( ({ "boden" }),
    "Der Boden ist hier recht feucht. Deine Fuesse stehen quasi im Schlamm.");

  AddDetail( ({ "schlamm" }),
    "Manchmal tritt das Wasser ueber das Ufer und macht die Landstrasse hier "
    "ganz feucht.");

  AddDetail( ({ "wasser" }),
    "Das Wasser ist sehr ruhig hier. Hier schwimmen sehr viele Fische "
    "im Wasser.");


  AddSound( ({ DEFAULT_SOUND,"see" }),
    "Der See plaetschert leise vor sich hin.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht hier nach frischem Wasser.");

  AddSmell( "wasser",
    "Das Wasser riecht frisch und angenehm.");

  AddExit( "suedosten", "./a7a8" );
  AddExit( "norden",    "./a5a7" );

  AddItem( NPC "angler", REFRESH_DESTRUCT);

  AddCmd( ({ "angle","angel" }) ,             "angelfkt" );
  AddCmd( ({ "bade","schwimm","schwimme" }) , "schwimmfkt" );
  AddCmd( ({ "fang","fange" }) ,              "fangefkt" );
}

reset() {
  ::reset();
  fische=8+random(4);
}  

int angelfkt(string str) {
  notify_fail("Worin genau moechtest Du angeln?\n");
  if(str != "see" && str != "in see" && str != "mit angel in see" &&
     str != "im see" && str != "mit angel im see") return 0;
  if(!present("angel",TP)) {
    notify_fail(BS(
      "Aber Du hast ja gar keine Angel bei Dir. Moechtest Du die Fische etwa "
      "mit den Haenden fangen??"));
    return 0;
  }
  if( member(angelt, TP) > -1 ) {
    notify_fail("Aber Du angelst doch schon!\n");
    return 0;
  }
  write(BS("Du wirfst die Angel in hohem Bogen in den See aus."));
  say(BS(CAP_TPN+" wirft eine Angel in hohem Bogen in den See aus."));
  angelt += ({ TP });
  call_out("angelfkt2", 5 + random (5));
  return 1;  
}

void angelfkt2() {
  object ob;
  angelt -= ({ TP });
  if(!objectp(TP)) return;
  if(!present(TP)) {
    return;
  }
  if(!random(2) || fische <1) {
    tell_object(TP, BS(
      "Du hast leider keinen Fisch gefangen und holst die Angel wieder ein."));
    tell_room(TO, CAP_TPN+" holt eine leere Angel wieder ein.\n", ({TP}) );
    return;
  }
  fische--;
  tell_object(TP, BS(
    "Ploetzlich spuerst Du, wie es an der Angel zuckt. Es hat doch "
    "tatsaechlich ein Fisch angebissen, den Du sofort einsteckst."));
  tell_room(TO, CAP_TPN+" faengt einen Fisch.\n", ({TP}) );
  switch(random(5)) {
    default:
    case 0..3:
      ob=clone_object("/d/dschungel/feyaria/tijara/obj/fisch"+
                      (string)(random(4)+1));
      break;
    case 4:
      ob=clone_object("/d/wasser/angrox/insel/obj/hering");
      break;
    // case 5:
    //  ob=clone_object("/d/wasser/angrox/insel/obj/silberhai");
    //  break;
  }
  if(ob) {
    ob->move(TP,M_NOCHECK);
  }
  return;
}

int schwimmfkt(string str) {
  notify_fail("Wo moechtest Du schwimmen?\n");
  if(str !="see" && str != "in see") return 0;
  write(BS(
    "Vorsichtig ziehst Du Deine Sachen aus und tastest Dich in den See vor. "
    "Brrrrrrrrrrrr ist das Wasser kalt. Fast erfroren entschliesst Du Dich "
    "doch lieber nicht schwimmen zu gehen."));
  say(BS(
    CAP_TPN+" zieht sich aus und steckt einen Fuss in den See. Super "
    "froestelnd entscheidet sich "+TPN+" doch lieber nicht schwimmen zu "
    "gehen."));
  return 1;
}

int fangefkt(string str) {
  notify_fail("Was willst Du fangen?\n");
  if (str != "fisch" && str != "fische") return 0;
  write(BS(
    "Du versuchst die Fische mit der blossen Hand zu fangen. Wie erwartet "
    "ist das aber recht erfolglos."));
  return 1;
}
