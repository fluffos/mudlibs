
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int wasser;

create() {
  ::create();

  wasser=2+random(2);

  SetProp( P_INT_SHORT, "An einem kleinen See" );
  SetProp( P_INT_LONG,
    "Du stehst jetzt direkt an einem kleinen See. Im Osten scheint eine "
    "kleine Bruecke ueber den Zulauf des Sees zu fuehren. Im Sueden dringt "
    "eine kleine Angelstelle in Deine Augen. Es fuehren eine Menge Spuren "
    "an den See. Sie deuten darauf hin, dass die Hobbits hier ihr frisches "
    "Trinkwasser holen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({ "bruecke" }),
    "Eine kleine Bruecke befindet sich im Osten. Mit ihr kannst Du wohl ueber "
    "den kleinen Bach gelangen.");

  AddDetail( ({ "augen","auge" }),
    "Deine Augen sind noch da wo sie hingehoeren.");

  AddDetail( ({ "menge" }),
    "Es sind schon wirklich viele Spuren.");

  AddDetail( ({ "spuren","spur" }),
    "Die Spuren stammen von Hobbits und fuehren direkt an den See.");

  AddDetail( ({ "hobbits","hobbit" }),
    "Derzeit holt wohl kein Hobbit hier etwas Trinkwasser.");

  AddDetail( ({ "himmel" }),
    "Die Sonne steht hoch am Himmel.");

  AddDetail( ({ "plaetschern" }),
    "Das kannst Du nur hoeren.");

  AddDetail( ({ "sonne","pelz" }),
    "Die Sonne brennt Dir auf den Pelz.");

  AddDetail( ({ "boden" }),
    "Der Boden ist hier sehr steinig.");

  AddDetail( ({ "see" }),
    "Der kleine See hat sehr durchsichtiges und klares Wasser. Er plaetschert "
    "ruhig vor sich hin. Du kannst sogar manchmal ein paar Fische an die "
    "Oberflaeche schwimmen sehen.");

  AddDetail( ({ "wasser" }),
    "Das Wasser ist schon blau. Aber es ist so frisch und rein, so dass es "
    "fast durchsichtig erscheint.");

  AddDetail( ({ "fische","fisch" }),
    "Die Fische scheinen sich sehr wohl in dem kleinen See zu fuehlen. "
    "Manchmal tauchen sie sogar kurzzeitig auf und sind an der "
    "Wasseroberflaeche zu erkennen.");

  AddDetail( ({ "wasseroberflaeche","oberflaeche","spiegel" }),
    "Die Wasseroberflaeche ist fast so glatt wie ein Spiegel.");

  AddDetail( ({ "bach" }),
    "Ein kleiner Bach fliesst gleich neben Dir. Er speist den See und heisst "
    "deshalb auch Zulauf.");

  AddDetail( ({ "zulauf" }),
    "Der See wird von dem kleinen Bach gespeist.");

  AddDetail( ({ "angelstelle","stelle" }),
    "Die Stelle ist weiter im Sueden. Hier ist das Ufer ein wenig zu steinig "
    "um zu angeln.");

  AddDetail( ({ "ufer" }),
    "Das Ufer ist um zu angeln ein wenig zu steinig hier. Allerdings scheinen "
    "die Hobbits genau hier ihr Trinkwasser zu holen.");

  AddDetail( ({ "steine","stein" }),
    "Die Steine begrenzen die Landstrasse. Es liegen aber auch viele am Ufer "
    "des Sees.");

  AddDetail( ({ "landstrasse","strasse" }),
    "Die Landstrasse fuehrt direkt an diesem kleinen See vorbei.");

  AddDetail( ({ "trinkwasser" }),
    "Das Wasser ist so rein, dass die Hobbits es als Trinkwasser verwenden.");

  AddSound( DEFAULT_SOUND,
    "Das Wasser des Sees plaetschert vor sich hin.");

  AddSound( ({ "wasser","see","ohr","ohren" }),
    "Das Wasser im See dringt mit einem lauten Plaetschern an Deine Ohren.");

  AddSound( ({ "plaetschern","see" }),
    "Der See plaetschert leise vor sich hin.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Feuchtigkeit.");

  AddSmell( "feuchtigkeit",
    "Du kannst die Feuchtigkeit richtig riechen.");

  AddItem ( "/d/huegelland/raballion/hobbits/npc/hobbit", REFRESH_DESTRUCT);

  AddExit( "westen", "./a4a6" );
  AddExit( "osten",      "./a5a8" );
  AddExit( "sueden",     "./a6a7" );

  AddCmd( ({ "trink","trinke" }) , "trinkfkt" );
  AddCmd( ({ "angel","angle" }),   "angelfkt" );
}

reset() {
  ::reset();
  wasser=2+random(2);
}

int trinkfkt(string str) {
  notify_fail("Was moechtest Du trinken?\n");
  if(str != "wasser" && str != "trinkwasser") return 0;
  if(TP->QueryProp(P_DRINK) > (TP->QueryProp(P_MAX_DRINK) - 3)) {
    write(BS("Du bekommst derzeit nicht einen Schluck Fluessigkeit "
             "mehr runter!"));
    return 1;
  }
  TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK) + 3);
  if(wasser<1) {
    write(BS(
      "Du trinkst ein wenig von dem Wasser. Doch irgendwie erfrischt es Dich "
      "nicht mehr so wie vorher."));
    say(BS(
      CAP_TPN+" nimmt einen kleinen Schluck aus dem See."));
    return 1;
  }
  wasser--;
  write(BS(
    "Du trinkst ein wenig von dem Wasser. Du fuehlst Dich erfrischt und ein "
    "wenig aufgetankt."));
  say(BS(
    CAP_TPN+" nimmt einen kleinen Schluck aus dem See."));
  TP->heal_self(20+random(20));
  return 1;
}

int angelfkt(string str) {
  notify_fail("Worin moechtest Du angeln?\n");
  if( str != "see" && str != "in see" & str != "im see") return 0;
  write(BS(
    "Hier ist es zum Angeln viel zu steinig. Such Dir lieber eine andere "
    "Stelle."));
  return 1;
}
