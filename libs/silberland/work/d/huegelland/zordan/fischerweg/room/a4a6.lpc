
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <mnpc.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Im Suedosten von Derlim" );
  SetProp( P_INT_LONG,
    "Du stehst jetzt direkt vor dem Suedtor von Derlim. Eine sonst dichte "
    "Hecke umgibt Derlim und Du kannst es wirklich nur durch das eigentlich "
    "immer offene Tor betreten. Viele Spuren fuehren in die Stadt und aus "
    "ihr heraus. Im Osten kannst Du schon die Auslaeufer eines kleinen "
    "Sees erkennen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist ziemlich ausgetreten.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist hier ziemlich blau.");

  AddDetail( ({ "suedtor","tor" }),
    "Das Suedtor wurde in die dichte Hecke eingepasst. Es besteht aus mehreren "
    "dicken Pfosten.");

  AddDetail( ({ "hecke" }),
    "Eine wirklich sehr dichte Hecke umgibt ganz Derlim. Du kannst bis auf "
    "das Tor keine Moeglichkeit erkennen, jemals diese Hecke zu ueberwinden.");

  AddDetail( ({ "moeglichkeit" }),
    "Nein, da ist wirklich keine.");

  AddDetail( ({ "pfosten","weise" }),
    "Die Pfosten sind auf wunderbare Weise miteinander verbunden. Kein Spalt "
    "ist zwischen den einzelnen Pfosten.");

  AddDetail( ({ "spalt","spalte","spalten" }),
    "Du kannst wirklich keinen Spalt erkennen.");

  AddDetail( ({ "spuren","spur" }),
    "Viele Spuren fuehren in die Stadt hinein, aber auch hinaus. Hier herrscht "
    "wohl viel Verkehr, seitdem die Landstrasse gebaut wurde.");

  AddDetail( ({ "stadt" }),
    "Die Stadt heisst Derlim und liegt hinter dem Tor im Nordwesten.");

  AddDetail( ({ "verkehr" }),
    "Hier ist wirklich viel los.");

  AddDetail( ({ "landstrasse","strasse" }),
    "Die Strasse fuehrt aus Derlim Richtung Suedosten hinaus. Sie ist relativ "
    "neu. Dafuer sieht sie aber schon ziemlich stark benutzt aus.");

  AddDetail( ({ "richtung" }),
    "Naja, Suedosten ist nur ungefaehr die Richtung. Eigentlich geht es auch "
    "ziemlich in Richtung Osten weiter.");

  AddDetail( ({ "auslaeufer","laeufer" }),
    "Du kannst im Osten schon die ersten Auslaeufer eines kleinen Sees "
    "erkennen. Von dort holen die Hobbits sicher auch immer ihr Trinkwasser.");

  AddDetail( ({ "trinkwasser","wasser" }),
    "Das Wasser sieht so klar und rein aus. Ganz sicher sogar holen die "
    "Hobbits ihr Wasser von dort.");

  AddDetail( ({ "see" }),
    "Wenn Du Dir den See genauer ansehen magst, musst Du schon naeher "
    "hingehen.");

  AddDetail( ({ "stimmen" }),
    "Du kannst die Stimmen nicht sehen.");

  AddDetail( ({ "hobbits","hobbit" }),
    "Hier sind keine Hobbits mehr unterwegs. Sie befinden sich wohl mitten "
    "in Derlim.");

  AddDetail( ({ "derlim" }),
    "Derlim liegt hinter dem Tor. Du kannst es leicht durchschreiten.");

  AddDetail( ({ "straeucher","strauch" }),
    "Wenn Du die genauer untersuchen willst, musst Du schon durch das Tor "
    "gehen. Hier kannst Du die Straeucher nur riechen, aber keine sehen.");

  AddSound( DEFAULT_SOUND,
    "Du kannst ein paar Stimmen aus dem Nordwesten hoeren.");

  AddSound( ({ "stimmen","stimme","hobbits","hobbit" }),
    "Die Stimmen stammen wohl von ein paar Hobbits aus Derlim.");

  AddSmell( DEFAULT_SMELL,
    "Der Duft von vielen verschiedenen Straeuchern dringt Dir in die Nase.");

  AddSmell( ({ "duft","straeucher","strauch","nase" }),
    "Der kommt aus dem Nordwesten. Hier stehen kaum Straeucher.");

  AddExit( "nordwesten",    "/d/huegelland/raballion/hobbits/room/suedtor" );
  AddExit( "osten", "./a5a7.lpc" );

  AddCmd( ({ "oeffne" }) ,               "oeffnefkt" );
  AddCmd( ({ "schliess","schliesse" }) , "schliessefkt" );

  AddItem( "/d/huegelland/raballion/hobbits/npc/taube", REFRESH_DESTRUCT, 
    ([P_MNPC_DEFAULTROOM: file_name(TO),
      P_MNPC_AREA: ROOM "",
      P_MNPC_FLAGS: MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS ]));
}

int oeffnefkt(string str) {
  notify_fail("Was moechtest Du oeffnen?\n");
  if(str != "tor" && str != "suedtor") return 0;
  write(BS(
    "Das Suedtor ist immer offen. Darum laesst es sich auch nicht schliessen."));
  return 1;
}

int schliessefkt(string str) {
  notify_fail("Was moechtest Du schliessen?\n");
  if(str != "tor" && str != "suedtor") return 0;
  write(BS(
    "Das Suedtor laesst sich nicht schliessen!"));
  return 1;
}
