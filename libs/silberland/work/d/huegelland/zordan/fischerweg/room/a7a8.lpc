
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einer kleinen Bruecke" );
  SetProp( P_INT_LONG,
    "Du stehst hier auf einer kleinen Bruecke vor dem See. In einem kleinen "
    "Bach fliesst das Wasser unter Dir nach Sueden aus dem See hinaus. "
    "Die Bruecke selber ist aus einfachem Holz gefertigt worden. Aber sie "
    "sieht sehr stabil und bruchsicher aus." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "wasser","lust","runde" }),
    "Von hier oben sieht das Wasser noch frischer und reiner aus. Du bekommst "
    "direkt Lust, hineinzuspringen und eine Runde zu schwimmen.");

  AddDetail( ({ "himmel","sonne" }),
    "Die Sonne steht hoch am Himmel.");

  AddDetail( ({ "bach","horizont" }),
    "Der kleine Bach fliesst aus dem See in den Sueden und verschwindet im "
    "Horizont.");

  AddDetail( ({ "boden" }),
    "Der Boden der Bruecke besteht aus dicken Holzplanken.");

  AddDetail( ({ "holzplanken","planken" }),
    "Die Holzplanken sind leicht braun und seher sehr stabil aus. Sie werden "
    "Dich sicher leicht tragen und sicher ueber den Bach bringen.");

  AddDetail( ({ "bruecke" }),
    "Die Bruecke wurde komplett aus Holz gebaut. Sie sieht zwar etwas aelter, "
    "aber dennoch sehr stabil und bruchsicher aus. Unter ihr fuehrt ein "
    "kleiner Bach aus dem See hinaus.");

  AddDetail( ({ "holz" }),
    "Das ist stabiles Holz aus dem Huegelland.");

  AddDetail( ({ "huegelland","land" }),
    "Es gibt im Huegelland ein grosses Holzfaellerlager.");

  AddDetail( ({ "Holzfaellerlager","lager" }),
    "Das liegt irgendwo im Norden von Derlim. Geh es doch mal suchen. Von dort "
    "stammt jedenfalls das Holz, aus dem die Bruecke gefertigt worden ist.");

  AddDetail( ({ "derlim","stadt" }),
    "Derlim ist die Stadt der Hobbits. Sie liegt irgendwo im Nordwesten von "
    "hier aus.");

  AddDetail( ({ "hobbits","hobbit" }),
    "Hobbits kommen sehr oft ueber diese Bruecke. Ihre Stadt ist nicht weit "
    "weg von hier.");

  AddDetail( ({ "see" }),
    "Der See liegt direkt vor Dir. Er plaetschert leise vor sich hin. Von "
    "hier aus kann man aber sehr schlecht angeln oder schwimmen.");

  AddSound( DEFAULT_SOUND,
    "Der Bach rauscht laut unter Dir aus dem See hinaus.");

  AddSound( "bach",
    "Der Bach donnert wirklich laut unter Dir entlang.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischem Wasser.");

  AddSmell( "wasser",
    "Das Wasser riecht herrlich frisch.");

  AddExit( "nordwesten", "./a6a7" );
  AddExit( "osten",      "./a7a9" );

  AddCmd( ({ "angel","angle" }),    "angelfkt" );
  AddCmd( ({ "spring","springe" }), "springfkt" );
}

int angelfkt(string str) {
  notify_fail("Worin moechtest Du angeln?\n");
  if( str != "see" && str != "in see" & str != "im see") return 0;
  write(BS(
    "Von der Bruecke aus wirst Du sicher nicht viel fangen."));
  return 1;
}

int springfkt(string str) {
  notify_fail("Wohin moechtest Du springen?\n");
  if (str != "in see" && str != "see" && str != "von bruecke" && 
      str != "runter" && str != "von bruecke in see") return 0;
  write(BS(
    "Du nimmst einen kleinen Anlauf und moechtest von der Bruecke in den See "
    "springen. Doch im letzten Moment erinnerst Du Dich an die Worte Deiner "
    "Mutter: Springe nie kopfueber in unbekanntes Gewaesser. Also haeltst Du "
    "inne und springst lieber nicht in den See hinein."));
  return 1;
}
