
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Wiesel");
  SetProp(P_LONG,
    "Ein kleines Wiesel starrt Dich mit seinen Augen an und wirkt nicht "
    "gerade erfreut gestoert worden zu sein. Die kleinen Zaehnchen sind "
    "sicher eine nicht zu unterschaetzende Waffe!");
  SetProp(P_NAME, "Wiesel");
  SetProp(P_GENDER, NEUTER);
  AddId(({"\n_wiesel", "wiesel"}));

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit seinen Zaehnchen",QueryProp(P_HANDS)[1]+50,DT_RIP}));
  SetProp(P_RACE, "Wiesel");
  SetProp(P_SIZE, 25+random(10));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);

  SetProp(P_MSGIN, "kommt wuetend an");
  SetProp(P_MSGOUT, "geht");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("zordan", "Zordan hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Wiesel will @WEN nicht.\n" }) );

  SetProp(P_SPELLRATE,30);

  AddSpell(2,200,
    "Das Wiesel beisst Dir in Deinen Zeh.\n",
    "Das Wiesel beisst @WEM in den Zeh.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,300,
    "Das Wiesel kratzt Dir die Augen aus.\n",
    "Das Wiesel kratzt @WEM die Augen aus.\n",
     DT_LIGHT,([SP_SHOW_DAMAGE:1]));
}
