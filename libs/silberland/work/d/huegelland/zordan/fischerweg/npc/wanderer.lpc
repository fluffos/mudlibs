
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein alter Wanderer");
  SetProp(P_LONG,
    "Dieser alte Mann geht in der schoenen Graslandschaft wohl wandern. Er "
    "ist schon sehr alt und scheint Dich nicht mehr hoeren zu koennen. Sein "
    "langer, weisser Bart haengt ihm fast den ganzen Koerper hinunter.");
  SetProp(P_NAME, "Wanderer");
  SetProp(P_GENDER, MALE);
  AddId(({"wanderer", "mann", "Keulenkaempfer"}));

  create_default_npc(14);
  SetProp(P_HANDS, ({" mit seinen Haenden",
    QueryProp(P_HANDS)[1]+50,DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180+random(10));
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC,100);

  SetProp(P_MSGIN, "wandert herein");
  SetProp(P_MSGOUT, "wandert weiter");
  SetProp(P_MNPC_AREA, (ROOM "") );
  SetProp(P_MNPC_WAIT, ({ 5, 40, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "a9b1");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  AddInfo(DEFAULT_INFO, "ist leider taub!\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der alte Wanderer nickt Dir freundlich zu.\n" }) );

  SetProp(P_DEAF, -1);

  SetChats(1, ({
    "Der alte Wanderer mustert Dich freundlich.\n",
    "Der alte Wanderer schaut sich die Natur an.\n",
    "Der alte Wanderer nickt Dir freundlich zu.\n",
    "Der alte Wanderer summt eine Melodie.\n",
    "Der alte Wanderer sammelt ein paar Steine.\n",
    "Der alte Wanderer setzt sich kurz hin und steht wieder auf.\n",
    "Der alte Wanderer schaut sich ein paar Blumen naeher an.\n"}) );

  SUID;
  CLONEME( "/p/weapon/club/wanderstab" );
  command("zuecke stab");
  CLONEME( "/p/armour/helm/hut" );
  CLONEME( "/d/wasser/stahldorn/outlaw/obj/mantel" );
  CLONEME( "/p/armour/boots/sandalen" );
  command("trage alles");
}

reset() {
  ::reset();
  if (!is_clone(TO)) return;
  SetProp(P_DEAF, -1);
  AddInfo(DEFAULT_INFO, "ist leider taub!\n");
}


int _set_deaf(mixed deaf)
{
  Set(P_DEAF, deaf);
  if( !QueryProp(P_DEAF) )
  {
    tell_room(ENV(TO), "Der Wanderer freut sich, dass er wieder hoeren kann.\n");
    AddInfo(DEFAULT_INFO, "sagt: Darueber weiss ich leider nichts.\n");
  }
}

