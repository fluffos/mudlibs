
inherit "std/npc";

#include "../def.h"

#define SCRIPTER ({"vendetta", "morpheusis"})

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine diebische Elster");
  SetProp(P_LONG,
    "Die diebische Elster hat ein dunkelschwarzes Gefieder und starrt Dich "
    "erwartungsvoll an. Ihr Schnabel ist ziemlich scharf und sie laesst sich "
    "sicher nicht so einfach vertreiben.");
  SetProp(P_NAME, "Elster");
  SetProp(P_GENDER, FEMALE);
  AddId(({"\n_elster", "elster", "vogel"}));

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit ihrem spitzen Schnabel",
    QueryProp(P_HANDS)[1]+100,DT_PIERCE}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 30+random(20));
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.5, DT_COLD:      -0.5, DT_WATER:  -0.5, DT_AIR:    -0.5, 
      DT_LIGHTNING: -0.5, DT_EXPLOSION: -0.5, DT_SOUND:  -0.5, DT_LIGHT:  -0.5,
      DT_ELECTRIC:  -0.5, DT_ACID:      -0.5, DT_POISON: -0.5, DT_TERROR: -0.5,
      DT_HOLY:      -0.5, DT_UNHOLY:    -0.5, DT_MAGIC:  -0.5 ]) );

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");

  SetProp(P_DIE_MSG,  " faellt tot auf die Landstrasse.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Die diebische Elster traellert Dich froehlich an.\n" }) );

  SetProp(P_SPELLRATE,50);

  AddSpell(1,100,
    "Die diebische Elster pickt Dir in die Nase.\n",
    "Die diebische Elster pickt @WEM in die Nase.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,200,
    "Die diebische Elster zwickt Dich in den Fuss.\n",
    "Die diebische Elster zwickt @WEM in den Fuss.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
     
  SetChats(1, ({
    "Die diebische Elster hackt auf Dich ein.\n",
    "Die diebische Elster plustert ihr Gefieder auf.\n",
    "Die diebische Elster schaut in ihrem Nest nach.\n",
    "Die diebische Elster flattert kurz davon.\n",
    "Die diebische Elster traellert froehlich ein Lied.\n"}) );

  SUID;
}


int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if (member(SCRIPTER, getuid(TP)) != -1 || 
      (TP->QueryProp(P_SECOND) && 
       member(SCRIPTER, lower_case(TP->QueryProp(P_SECOND))) != -1))
  {
    TP->StopHuntFor(TO);
    StopHuntFor(TP);
    return 0;
  }
  return ::Defend(dam, dam_type_list, spell, enemy);
}

