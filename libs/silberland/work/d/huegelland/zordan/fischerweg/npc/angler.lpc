
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Angler");
  SetProp(P_LONG,
    "Der Angler ist, das erkennst Du auf den ersten Blick, ein ehemaliger "
    "Schiffskapitaen. In den vielen Falten in seinem Gesicht duerfte sich "
    "der Staub saemtlicher Kuesten dieser Welt gesammelt haben. ");  
	SetProp(P_NAME, "Angler");
  SetProp(P_GENDER, MALE);
  AddId(({"angler"}));

  create_default_npc(15);
  enable_commands();
  SetProp(P_HANDS, ({" mit seinen starken Haenden",
    QueryProp(P_HANDS)[1]+75,DT_BLUDGEON}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 90+random(20));
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_WATER:  -1.0]) );

  SetProp(P_MSGIN, "kommt an und faengt an zu angeln");
  SetProp(P_MSGOUT, "angelt weiter");

  SetProp(P_DIE_MSG,  " wird erstmal keine Fische mehr fangen.\n");

  AddInfo(DEFAULT_INFO, "raunzt Dich an: RUHE!\n");
  AddInfo("zordan", "Zordan hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Angler nickt Dir freundlich zu.\n" }) );

  SetProp(P_SPELLRATE,20);

  AddSpell(2,200,
    "Der Angler haut Dir seine Angel um die Ohren.\n",
    "Der Angler haut @WEM seine Angel um die Ohren.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,400,
    "Der Angler sticht Dir seine Angel in den Magen.\n",
    "Der Angler sticht Dir seine Angel in den Magen.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Angler prueft seine Angel.\n",
    "Der Angler fluestert: Pssst.\n",
    "@@anglefkt@@",
    "@@anglefkt@@"
    }) );

  SUID;
  CLONEME( "/p/weapon/spear/angel" );
  command("zuecke angel");
  CLONEME( "/d/huegelland/zordan/holzfaeller/armour/ledergewand" );
  if(random(100)>50) CLONEME( "/p/armour/boots/lederstiefel" );
  else               CLONEME( "/p/armour/gloves/lederhandschuhe" );
  CLONEME( "/d/wasser/lupus/pier/obj/muetze" );
  command("trage alles");
}

string anglefkt() {
  command("angel in see");
  return "";
}

