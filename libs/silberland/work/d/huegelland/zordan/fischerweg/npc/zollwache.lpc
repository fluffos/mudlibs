
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine starke Zollwaechterin");
  SetProp(P_LONG,
    "Diese kraeftig gebaute Trollfrau stellt die Zollwache dar. Ihre starken Muskeln "
    "machen sie zu einer perfekten Waechterin ueber den korrekten Verlauf der "
    "Zollgeschaefte. Ihr riesiges Beil macht Dir Angst und Bange und Du "
    "solltest Dir einen Kampf mit ihr sicher gut ueberlegen!");
  SetProp(P_NAME, "Zollwache");
  SetProp(P_NAME_ADJ, "stark");
  SetProp(P_GENDER, FEMALE);
  AddId(({"\n_zollwache", "zollwache", "wache", "troll", "zollwaechterin",
          "waechterin","NOWIMPY", "trollfrau", "trollin"}));

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit ihren starken Haenden",
    QueryProp(P_HANDS)[1]+300,DT_BLUDGEON}));
  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 340+random(40));
  SetProp(P_ALIGN, -400);
  SetProp(P_WEIGHT, 300000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.1, DT_COLD:      -0.7, DT_WATER:  -0.7, DT_AIR:    -0.7, 
      DT_LIGHTNING: -0.5, DT_EXPLOSION:  0.1, DT_SOUND:  -0.8, DT_LIGHT:   0.1,
      DT_ELECTRIC:  -0.7, DT_ACID:      -0.8, DT_POISON: -0.7, DT_TERROR: -0.7,
      DT_HOLY:      -0.3, DT_UNHOLY:    -0.3, DT_MAGIC:  -0.9, DT_MIND:    0.2 ]) );
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "kommt an und beginnt ihren Dienst");
  SetProp(P_MSGOUT, "geht");

  SetProp(P_DIE_MSG,  " faellt laut krachend zu Boden.\n");

  AddInfo(DEFAULT_INFO, ({
    "sagt: Mach hier keinen Aerger!\n",
    "fragt: Hast Du auch schon brav bezahlt?\n",
    "sagt: Das verstehe ich nicht richtig.\n",
    "sagt: Kannst Du das nicht anders ausdruecken?\n",
    "sagt: Bezahl Deinen Wegezoll und sei ruhig.\n" }) );

  AddInfo("zordan", "Zordan hat mich erschaffen.","sagt: ");

  AddInfo( ({"wegezoll","zoll"}),
    "Auch Du musst Wegezoll bezahlen. Wieviel erfaehrst Du auf der Tafel.",
    "sagt: ");

  AddInfo( ({"schranke"}),
    "Die Schranke darfst Du nur passieren, wenn Du bezahlt hast.",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Die Zollwache will @WEN nicht.\n" }) );

  SetProp(P_SPELLRATE,90);
  
  AddSpell(3,200,
    "Die Zollwache drischt hart auf Dich ein.\n",
    "Die Zollwache drischt hart auf @WEN ein.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,400,
    "Die Zollwache schlaegt Dir fast den Kopf ab.\n",
    "Die Zollwache schlaegt @WEM fast den Kopf ab.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1000,
    "Die Zollwache dringt mit ihrem Beil tief in Dich ein.\n",
    "Die Zollwache dringt mit ihrem Beil tief in @WEN ein.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Die starke Zollwache sagt: Nur wenn Du bezahlst kommst Du hier durch.\n",
    "Die starke Zollwache schaerft ihr Beil.\n",
    "Die starke Zollwache geht an der Schranke auf und ab.\n",
    "Die starke Zollwache setzt sich kurz auf den Stuhl.\n",
    "Die starke Zollwache zaehlt ihr Geld.\n",
    "Die starke Zollwache deutet auf die Tafel.\n",
    "Die starke Zollwache mustert Dich eingehend.\n"}) );

  SUID;
  // CLONEME( "/p/weapon/streitaxt" );
  ob=clone_object( "/p/weapon/axe/kriegsbeil.lpc" );
  if(ob) {
    ob->SetProp(P_WC_BONUS, ([ "\n_zollwache": 100 ]) );
    ob->move(ME,M_NOCHECK);
  }
  command("zuecke beil");
  if(random(100) < 30)
    CLONEME(ARMOUR "mithrilguertel" );
  else
    CLONEME( "/p/armour/belt/guertel" );
  CLONEME( "/d/gebirge/speedy/trollager/armour/schwtrollruestung" );
  CLONEME( "/p/armour/helm/lederhelm" );
  if(random(100)>50) CLONEME( "/p/armour/ring/ring" );
  if(random(100)>50) CLONEME( "/p/armour/gloves/panzerhandschuhe" );
  command("trage alles");
  
  AddCmd( ({ "zahl","zahle" }) , "zahlfkt" );
}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt die Zollwache!\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Die Zollwache hat gerade "+CAP(getuid(player))+
              " umgebracht ("+lostexp+").\n");
}

int _query_wimpy() { return 0; }

void give_notify(object was) {
  object ob,env;
  int am;
  if (!(was->id("geld"))) return ::give_notify(was);
  env=MENV;
  if(file_name(MENV) != "/d/huegelland/zordan/fischerweg/room/a9a0") 
    return ::give_notify(was);
  am=was->QueryProp(P_AMOUNT);
  env->AddMoney(am);
  if(env->GetMoney() >= TP->QueryProp(P_LEVEL)*10) {
    tell_room(env,break_string(
      "Danke "+CAP_TPN+", das reicht aus damit Du jetzt fuer eine Weile "
      "die Schranke passieren darfst.",78,"Die starke Zollwache sagt: "));
  } else {
    am=TP->QueryProp(P_LEVEL)*10-env->GetMoney();
    tell_room(env,break_string(
      "Danke "+CAP_TPN+", aber das reicht noch nicht ganz aus. Es fehlen noch "
      +am+" Muenzen.",78,"Die starke Zollwache sagt: "));
  }
  was->remove();
  return;
}

int zahlfkt(string str) {
  string wen;
  int was;
  
  if(!str) return 0;
  if ((sscanf(str,"%d muenzen an %s",was,wen) != 2) &&
      (sscanf(str,"%d muenze an %s",was,wen) !=2)) return 0;
  if (!ME->id(wen)) return 0;
  TP->command_me("gib "+was+" muenze"+(was!=1?"n":"")+" an zollwache");
  return 1;
}
