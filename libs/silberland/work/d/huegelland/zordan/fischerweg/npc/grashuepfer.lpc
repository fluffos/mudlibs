
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Grashuepfer");
  SetProp(P_LONG,
    "Dieser kleine Grashuepfer huepft froehlich zwischen all dem Gras hin "
    "und her. Er sucht wohl nach etwas Nahrhaftem zwischen all den Graesern.");
  SetProp(P_NAME, "Grashuepfer");
  SetProp(P_GENDER, MALE);
  AddId(({"grashuepfer", "huepfer"}));

  create_default_npc(5);
  SetProp(P_HANDS, ({" mit seinen winzigen Beinchen",
    QueryProp(P_HANDS)[1]+20,DT_BLUDGEON}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 3+random(2));
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 10);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "huepft herein");
  SetProp(P_MSGOUT, "huepft");
  SetProp(P_MNPC_AREA, (ROOM "") );
  SetProp(P_MNPC_WAIT, ({ 10, 20, 40 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b3b7");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " liegt zerquetscht auf dem Boden.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("zordan", "Zordan hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Grashuepfer kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,100);
  AddSpell(1,100,
    "Der Grashuepfer zwickt Dir ins Bein.\n",
    "Der Grashuepfer zwickt @WEM ins Bein.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SUID;
}
