/*
   Eine Holzfaelleraxt von Zordan@SL
*/

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Holzfaelleraxt");
  SetProp(P_LONG,
    "Diese Axt ist eigentlich nur fuer das Faellen von Baeumen gedacht. "
    "Aber erfahrene Leute koennen mit ihr sicher auch gut im Kampf bestehen. "
    "An einem relativ langem Stiel ist ein schweres Axtblatt befestigt. " );
  SetProp(P_INFO, "Du kannst nichts besonderes an der Axt erkennen.\n");
  SetProp(P_NAME, "Holzfaelleraxt");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"holzfaelleraxt", "axt"}) );

  SetProp(P_WEAPON_TYPE, WT_AXE );
  SetProp(P_WC, 140+random(10));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL:20, MAT_MISC_WOOD:70]) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_VALUE, 1200);
  SetProp (P_WIELD_RESTRICTIONS, ([P_XP: 300000, A_STR: 10]));

  AddDetail( ({ "stiel" }),
    "Der Stiel ist einfach nur aus Holz gefertigt. Klebriges Harz ist "
    "vertreut ueber die ganze Axt." );

  AddDetail( ({ "harz" }),
    "Das Harz stammt noch von den gefaellten Baeumen im Holzfaellerlager.");

  AddDetail( ({ "axtblatt" }),
    "Das Axtblatt eignet sich hervorragend, um damit Baeume zu faellen. "
    "Ein paar Koepfe koennte man damit allerdings auch erwischen." );

  AddDetail( ({ "koepfe" }),
    "Das sind hoffentlich die Koepfe Deiner Feinde und nicht Dein eigener." );
}
