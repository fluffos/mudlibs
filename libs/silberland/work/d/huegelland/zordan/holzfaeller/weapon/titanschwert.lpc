/*
   Ein Titanschwert fuer Oswin von Zordan@SL
*/

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Titanschwert");
  SetProp(P_LONG,
    "Vollkommen aus Titan bietet dieses Schwert hervorragende Eigenschaften "
    "im Kampf. Allerdings sollte man schon sehr erfahren sein, um mit dieser "
    "Waffe umzugehen. " );
  SetProp(P_NAME, "Titanschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"titanschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 160+random(10));
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_TITANIUM:100]));
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 1400);
  SetProp (P_WIELD_RESTRICTIONS, ([P_XP: 5000000, A_STR: 20]));
  SetProp(P_WC_BONUS, (["Oswin": 50]) );
}
