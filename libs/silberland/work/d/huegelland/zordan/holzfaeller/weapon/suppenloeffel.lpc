
/*
   Ein Suppenloeffel Zordan@SL
*/

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Suppenloeffel");
  SetProp(P_LONG,  "Ein ganz normaler Suppenloeffel aus Holz." );
  SetProp(P_NAME, "Suppenloeffel");
  SetProp(P_GENDER, MALE);
  AddId( ({"suppenloeffel", "loeffel"}) );

  SetProp(P_WC_BONUS, (["\nkoechin": 110]) );
  SetProp(P_WEAPON_TYPE, WT_MISC );
  SetProp(P_WC, 40+random(5));
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_MISC_WOOD );
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 100);
}
