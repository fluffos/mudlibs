
/*
   Codezettel 1 fuer den Tresor Zordan@SL
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../def.h"

create() {
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein kleiner Zettel");
  SetProp(P_LONG,
    "Ein kleiner, zerknickelter Zettel." );
  SetProp(P_NAME, "Zettel");
  SetProp(P_GENDER, MALE);
  AddId("zettel");

  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);

  AddCmd( ({ "lies" , "lese" }), "lesen" );
}

int lesen(string str) {
  string temp;
  notify_fail("Willst Du lesen ?\n");
  if(str=="zettel") {
    temp=call_other(TRESORMASTER,"Get_Code",2);
    write( BS ("Auf dem Zettel ist \"2 - "+temp+"\" gekritzelt. Durch das "
               "Fummeln mit dem Zettel geht er leider kaputt." ));
    TO->remove();
    return 1;
  }
  return 0;
}
