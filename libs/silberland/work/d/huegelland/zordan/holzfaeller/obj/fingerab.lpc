
/*
   Tja, ein abgeschnittener Finger von der Saege, son Pech , Zordan@SL
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../def.h"

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Finger");
  SetProp(P_LONG,  "Ihhhh. Das ist ja ein Finger Deiner rechten Hand. "
                   "Irgendetwas muss ihn wohl abgetrennt haben. Blut laeuft "
                   "aus der Wunde heraus." );
  SetProp(P_INFO, "Ob Du den beim Kampf mit Sawer verloren hast ?\n");
  SetProp(P_NAME, "Finger");
  SetProp(P_GENDER, MALE);

  AddId( ({ "finger" , "\n_sawer_finger" }) );


  SetProp(P_MATERIAL, MAT_FLESH );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, "Bist Du sicher, dass Du Deinen Finger fuer immer "
                     "verlieren willst ?\n");
  SetProp(P_AUTOLOAD,1);

  AddDetail( "hand" , "An Deiner rechten Hand fehlt ein Finger. Besser "
                      "Du laesst Dich schnell heilen, sonst stirbst Du noch "
                      "daran.");

  AddDetail( "blut" , "Das Blut laeuft aus der Wunde an Deiner rechten Hand. " );

  AddDetail( "wunde" , "Die Wunde ist recht gross und faengt auch schon "
                       "langsam an zu eitern." );
}

string extra_look() {
    return BS(
      CAP(MENV->QueryPronoun(WEM))+" fehlt ein Finger an der rechten Hand.\n");
}
