
/*
   Ein kleines Tool, wenn sich der Spieler auf den Stuhl bei Alwinja setzt
   Zordan@SL
*/

inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "../def.h"

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, 0 );
  SetProp(P_LONG, 0 );
  SetProp(P_INVIS,1);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_WEIGHT, 0);
  AddId( "\nstuhl" );

  AddCmd( ({"stehe","steh"}), "steh_auf");
  AddCmd( ({"norden", "sueden" , "n" , "s" , "gehe" , "goto" , "home" }), 
            "erst_aufstehen");
  // hihi, gegen transende magier -> goto gesperrt *kicher*
}

int erst_aufstehen() {
  write("Vielleicht solltest Du erst vom Stuhl aufstehen?\n");
  return 1;
}

int steh_auf(string str) {
  notify_fail("Willst Du vielleicht AUFstehen?\n");
  if(str=="auf") {
    write("Du stehst wieder vom Stuhl auf.\n");
    say(CAP_TPN+" steht von einem Stuhl auf.\n");
    TO->remove();
    return 1;
  }
  return 0;
}

string extra_look() {
  if (environment()->QueryProp(P_GENDER)==MALE)
    return BS ("Er sitzt gerade auf einem Stuhl.\n");
  else
    return BS ("Sie sitzt gerade auf einem Stuhl.\n");
}
