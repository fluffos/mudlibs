
/*
    Ein abgeholtzer Baum von Zordan@SL
*/

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein abgeholzter Baum");
  SetProp(P_LONG,  "Vor Dir liegt ein frisch abgeholzter Baum. Du bist mit "
    "ziemlicher Sicherheit nicht in der Lage ihn aufzuheben." );
  SetProp(P_INFO, "Hm, ein Baum ist ein Baum, mehr nicht.\n");
  SetProp(P_NAME, "Baum");
  SetProp(P_GENDER, MALE);
  AddId( ({"baum" ,"\nbaum"}) );

  SetProp(P_MATERIAL, MAT_MISC_WOOD );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOGET, 
    BS( "Du versucht mit aller Kraft den Baum anzuheben. Doch gerade als Du den "
    "Baum ein kleines Stueckchen angehoben hast, erwischt Dich ein stechender "
    "Schmerz im Ruecken. Du laesst den Baum sofort wieder fallen.") );
}
