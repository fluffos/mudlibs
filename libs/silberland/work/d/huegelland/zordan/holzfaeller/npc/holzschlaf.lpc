/*
   Ein starker Holzfaeller von Zordan@SL
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein schlafender Holzfaeller");
  SetProp(P_LONG, 
    "Ein starker Holzfaeller faellt hier die Baeume mit seiner grossen Axt. "
    "Seine Muskeln wirken sehr beeindruckend auf Dich. Er macht gerade Pause. "
    "Sei bloss ruhig, denn wenn Du ihn weckst, dann wird er ganz sicher boese "
    "werden !" );

 AddDetail( "muskeln", "Die Muskeln strotzen unter seiner Kleidung hervor. "
             "Solch dicke Muskeln sieht man sehr selten." );
 AddDetail( "pause", "Er schlaeft hier wohl. Weck ihn bloss nicht auf !");

  SetProp(P_NAME, "Holzfaeller");
  SetProp(P_GENDER, MALE);
  AddId( ({ "holzfaeller", "mensch" , "faeller" , "\nholzschlaf" }) );

  create_default_npc(19+random(5));
  SetProp(P_HANDS, ({" mit seinen blossen Haenden" , 120 , DT_BLUDGEON}) );
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, 30+random(30));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_BODY, 90+random(20)); // besonders dicke Muskeln :-)
  SetProp(P_NOATTACK,
    "dreht sich zufaellig um und Du triffst daneben." );

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " schlaeft jetzt noch fester.\n");

  AddInfo(DEFAULT_INFO, "schnarcht weiter.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Holzfaeller ist zu vertraeumt im Moment.\n" }) );

  SetProp(P_SPELLRATE,25);

  AddSpell(1, 225,
    "Der Holzfaeller drischt hart auf Dich ein.\n",
    "Der Holzfaeller drischt hart auf @WEN ein.\n",
    DT_SLASH, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 350,
    "Der Holzfaeller versucht Dir den Schaedel zu spalten.\n",
    "Der Holzfaeller versucht @WEN den Schaedel zu spalten.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(2, 75,
    "Der Holzfaeller fuehrt einen gekonnten Hieb aus.\n",
    "Der Holzfaeller erwischt @WEN mit einem gekonnten Hieb.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetAttackChats(10, ({
    "Der Holzfaeller spannt seine Muskeln weiter an.\n",
    "Der Holzfaeller lacht ueber Dich.\n",
    "Der Holzfaeller sagt: \"Du bekommst nie wieder Holz von uns.\"\n"}) );

  SUID;
  CLONEME( "/p/armour/boots/lederstiefel" );
  CLONEME( "/p/armour/gloves/lederhandschuhe" );
  CLONEME( ARMOUR "wolljacke" );
  CLONEME( "/p/armour/helm/wollmuetze" );
  command("trage alles");

  AddCmd( ({"ruf","rufe"}), "ruffkt" );
}

catch_tell( text ) {
  string wer,was;
  object ob;
  if (sscanf(text,"%s sagt: %s", wer, was) == 2) {
    if (ob=present(LOWER(wer), MENV)) {
      if ((living(ob)) && (interactive(ob))) {
        // ich mag nicht geweckt werden und greife deshalb an :-)
        write("Der Holzfaeller wird von Deinen Worten wach und greift Dich an!\n");
        ME->Kill(TP);
        ME->SetProp(P_NOATTACK,0);
        ME->SetChats(1, "Der Holzfaeller grummelt, weil er geweckt wurde.\n" );
        ME->SetProp(P_SHORT, "Ein aufgewachter Holzfaeller");
        ME->SetProp(P_LONG, 
    "Ein starker Holzfaeller faellt hier die Baeume mit seiner grossen Axt. "
    "Seine Muskeln wirken sehr beeindruckend auf Dich. Er macht gerade Pause. " );
      }
    }
  }
}

ruffkt(string text) {
  write("Der Holzfaeller wird von Deinen Worten wach und greift Dich an!\n");
  ME->Kill(TP);
  ME->SetProp(P_NOATTACK,0);
  ME->SetChats(1, "Der Holzfaeller grummelt, weil er geweckt wurde.\n" );
  ME->SetProp(P_SHORT, "Ein aufgewachter Holzfaeller");
  ME->SetProp(P_LONG, 
  "Ein starker Holzfaeller faellt hier die Baeume mit seiner grossen Axt. "
  "Seine Muskeln wirken sehr beeindruckend auf Dich. Er macht gerade Pause. " );
  return 0;
}
