
/*
   Oswin, der Holzfaellerlager-beschuetzer Zordan@SL
   SEHR stark, vergleichbar mit den Eckstehern in Kyrandia !!
*/

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Oswin, der Aufpasser");
  SetProp(P_LONG,
    "Das ist Oswin, der zwergische Beschuetzer des Holzfaellerlagers. Seine "
    "grimmige Miene schaut hinter einem dichten Vollbart hervor. Die "
    "Waffe und Ruestung die er traegt, laden Dich nicht gerade zu einer "
    "Auseinandersetzung mit ihm ein. " );

  AddDetail( "miene", "Seine Miene sieht furchterregend aus. Du traust Dich "
            "kaum, ihm ins Gesicht zu schauen.");
  AddDetail( "gesicht","Viele Narben zieren das Gesicht eines sehr erfahrenen "
            "Kaempfers." );
  AddDetail( "narben", "Soviele Narben auf einem so kleinen Platz. Das hast "
            "Du noch nie gesehen." );
  AddDetail( "vollbart", "Der Bart haengt ihm locker das Gesicht herunter. "
             "Eigentlich sieht er nicht gerade gepflegt aus." );
  AddDetail( "auseinandersetzung", "Leg Dich besser nicht mit ihm an!");

  SetProp(P_NAME, "Oswin");
  SetProp(P_GENDER, MALE);
  AddId( ({"oswin"}) );
  set_living_name("oswin");

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit blutverschmierten Haenden" , 200 , DT_BLUDGEON}) );
  SetProp(P_MAX_HP, 900+random(200));
  SetProp(P_BODY, 120+random(10));
  SetProp(P_RACE, "Zwerg");  
  SetProp(P_SIZE, 150+random(10));
  SetProp(P_ALIGN, -100-random(50));
  SetProp(P_MAX_HANDS, 2);
  SetProp (P_ARTICLE, 0);
//  SetProp(P_RESISTANCE, ({ DT_FIRE })); 
//  SetProp(P_VULNERABILITY, ({ DT_WATER }));
  SetProp(P_RESISTANCE_STRENGTHS  , ([ DT_WATER:0.2,DT_FIRE:-0.5 ]) );
//  SetProp(P_XP,6000000);
  SetProp(P_XP, QueryProp(P_XP)+4000*100);

  SetProp(P_MSGIN, "schaut nach, ob hier alles in Ordnung ist");
  SetProp(P_MSGOUT, "geht weiter nach Unruhen schauend");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MNPC_AREA, (ROOM "" ) );
  SetProp(P_MNPC_WAIT, ({ 20, 30, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "d2" );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_LOG_INFO, "holzfaeller.log");

  SetProp(P_DIE_MSG,  " stirbt unter Deiner letzten Attacke.\n");
  SetProp(P_MURDER_MSG, "Das naechte Mal erwische ich Dich, %s!");

  AddInfo(DEFAULT_INFO, "sagt: Red doch mal in der Zwergensprache!\n");

  SetProp( P_REJECT, ({ REJECT_DROP, "fragt: Was soll ich damit?\n" }) );

  SetProp(P_SPELLRATE,50);

  AddSpell(4,200,
    "Oswin gibt Dir eine Kopfnuss.\n",
    "Oswin gibt @WEN eine starke Kopfnuss.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,300,
    "Oswin zuendet Teile Deiner Ruestung an.\n",
    "Oswin zuendet Teile von @WESSEN Ruestung an.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,450,
    "Oswin blendet Dich mit seinem Schwert.\n",
    "Oswin blendet @WEN mit seinem Schwert.\n",
     DT_LIGHT,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,900,
    "Oswin ueberschuettet Dich mit aetzender Saeure.\n",
    "Oswin ueberschuettet @WEN mit aetzender Saeure.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Oswin sagt: Lass ja die Arbeiter in Ruhe!\n",
    "Oswin stutzt seinen Bart.\n",
    "Oswin zerquetscht einen Wurm.\n",
    "Oswin grinst ueber Deine laecherliche Waffe.\n",
    "Oswin mustert Dich.\n" }) );

  SetAttackChats(10, ({
    "Oswin bruellt Dich an: WAGE ES JA NICHT!\n",
    "Oswin's Muskeln bersten fast.\n",
    "Oswin reisst Dir fast den Arm ab.\n" }) );

  SUID;
  CLONEME( WEAPON "titanschwert" );
  command("zuecke titanschwert");
  CLONEME( "/p/armour/armour/titanpanzer" );
  if (random(100) < 10) { CLONEME( "/p/armour/helm/titanhelm" ); }
  if (random(100) < 20) { CLONEME( "/p/armour/gloves/titanhandschuhe" ); }
  if (random(100) < 30) { CLONEME( "/p/armour/boots/kampfstiefel" ); }
  if (random(100) < 40) { CLONEME( "/p/armour/bracers/titanarmschienen" ); }
  if (random(100) < 50) { CLONEME( "/p/armour/trousers/titanbeinschienen" ); }
  command("trage alles");

  AddLibrary( NPC "standard.lib",1,1);

  AddInfo( ({ "oswin" }), "Man bist Du toll, Du kennst meinen Namen.",  "pffft: ");

  AddInfo( ({ "holzfaeller" }),
              "Ich passe streng auf sie auf. Wehe Du tust ihnen was!",
              "sagt: ");

  AddInfo( ({ "bart" }),
              "Mein Bart ist mein ganzer Stolz.",
              "sagt stolz: ");

  AddInfo( ({ "sicherheit" }),
              "Ich bin der Beschuetzer des Lagers und sorge fuer die "
              "Sicherheit hier. Mach bloss keinen Aerger, sonst lege ich Dich "
              "um!",
              "sagt: ");

  AddInfo( ({ "zwergensprache","sprache" }),
              "Wenn Du nicht weisst was das ist, dann kann ich Dir auch nicht "
              "weiterhelfen!",
              "sagt barsch: ");

  AddInfo( ({ "titan" }), "Titan ist eines der haertesten Materialien.", "sagt: ");

  AddInfo( ({ "titanschwert","waffe" }),
              "Ich bin der einzige im ganzen Silberland, der mit dieser "
              "Waffe perfekt umgehen kann.",
              "sagt stolz: ");


}

void die(int poisondeath)
{
  write_file( LOG "oswin.kills" ,
    ctime()+": "+CAP(getuid(PL))+" killt Oswin.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == ME)
    write_file( LOG "oswin.deads" ,
      ctime()+": Oswin hat "+CAP(getuid(player))+" umgebracht.\n");
  // Oswin ist schlau, jaja :)
  command_me("nimm alles aus leiche");
  command_me("trage_beste_ruestungen");
  command_me("zuecke_beste_waffe");
  command_me("trage alles");
}

Defend(int dam,string *dam_type,mixed spell,object enemy)
{
  // Der Kampf gegen so einen Koloss darf schon mal schwerer sein :-)
  // d.h. im genauen, wenn SEHR starke Schlaege kommen, werden sie arg begrenzt
  if (dam > 200) {
    say(" Oswin spannt kurz seine Muskeln ganz besonders an.\n");
    dam=dam*3/4;
  }
  return ::Defend(dam,dam_type,spell,enemy);
}
