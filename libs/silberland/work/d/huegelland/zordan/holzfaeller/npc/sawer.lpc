/*
   Sawer, der Saegewerkarbeiter Zordan@SL
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

#define STABKOSTEN 1000
#define BRETTKOSTEN 500
#define SCHEMELKOSTEN 250
#define SPROSSENKOSTEN 250
#define MAX_ANZ_SCHEMEL 3
#define MAX_ANZ_BRETTER 10
#define MAX_ANZ_SPROSSEN 3 

int schemel;
int bretter;
int sprosse;

void create() {

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Sawer, der Tischler");
  SetProp(P_LONG,
    "Sawer ist ein Mann mittleren Alters. Er laechelt Dich freundlich an "
    "und bedient kinderleicht die grosse Saege, um aus den abgeholzten "
    "Baeumen brauchbare Hoelzer zu machen. Leider musst Du feststellen, "
    "dass ihm an der rechten Hand zwei Finger fehlen. Seine etwas dickliche "
    "Gestalt laesst nicht darueber hinwegtaeuschen, dass er eine Menge "
    "Schlaege einstecken kann." );

  AddDetail( "hand", "Ihm fehlen zwei Finger an der rechten Hand. Das kann "
             "nur von der Saege gekommen sein." );
  AddDetail( "gestalt", "Er scheint ziemlich viele Schlaege einstecken zu "
             "koennen. Das ist auch kein Wunder bei seinem dicken Leib." );
  AddDetail( "schlaege", "Jede Menge davon wird er einstecken koennen." );
  AddDetail( "menge", "Naja, fuer einen guten Zauberer sollte der Kampf "
             "nicht lange dauern.");

  SetProp(P_NAME, "Sawer");
  SetProp(P_GENDER, MALE);
  AddId( ({"sawer" , "tischler" , "\nsawer" }) );
  set_living_name("sawer");

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit dreckigen Haenden",150,DT_BLUDGEON}) );
  SetProp(P_MAX_HP, 600+random(200));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, 200+random(50));
  SetProp(P_MAX_HANDS, 2);
  SetProp (P_ARTICLE, 0);

  SetProp(P_LOG_INFO, "holzfaeller.log");

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet auf einmal");

  AddInfo(DEFAULT_INFO, ({
    "sagt: Darueber weiss ich leider nichts.\n",
    "sagt: Hm, ist mir nicht gelaeufig.\n",
    "sagt: Frag doch besser Oswin.\n" }) );

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Sawer sagt: Dank Dir vielmals.\n" }) );

  SetProp(P_SPELLRATE,70); // dafuer das er keine Waffe traegt, zaubert er oefter

  AddSpell(1, 650,
    "Sawer wirft Dich in die grosse Saege. Dir wird ganz anders.\n",
    "Sawer wirft @WEN in die grosse Saege.\n",
    DT_RIP, "finger_ab" , ([SP_SHOW_DAMAGE:1]) );

  AddSpell(2, 450,
    "Sawer schleudert Dich zur grossen Saege.\n",
    "Sawer schleudert @WEN zur grossen Saege.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(2, 350,
    "Sawer bringt Dich in die Naehe der Saege.\n",
    "Sawer bringt @WEN in die Naehe der Saege.\n",
    DT_SOUND, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(2, 250,
    "Sawer haut Dir mitten ins Gesicht.\n",
    "Sawer haut @WEN mitten ins Gesicht.\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]) );

  SetAttackChats(10, ({
    "Sawer versucht sich hinter der Saege zu verstecken.\n",
    "Sawer bruellt Dich an: LASS DAS !\n",
    "Sawer sagt: Ich werde Dich gleich in die Saege werfen !\n" }) );

  CLONEME( "/p/armour/boots/lederstiefel" );
  CLONEME( "/p/armour/gloves/lederhandschuhe" );
  CLONEME( ARMOUR "ledergewand" );
  command("trage alles");

  AddLibrary( NPC "standard.lib",1,1);

  AddInfo( ({ "saegewerk" }),
              "Hier im Saegewerk mache ich aus den primitiven Baeumen wertvolle "
              "Bretter und Hoelzer. Die bringe ich dann in die Lagerverwaltung. ",
              "sagt: ");

  AddInfo( ({ "saege" }),
              "Komm Ihr bloss nicht zu nahe. Ich hab schon zwei Finger wegen "
              "ihr verloren.",
              "sagt streng: ");

  AddInfo( ({ "finger" }),
              "Dir seine rechte Hand. Es fehlen zwei Finger.",
              "zeigt ");

  AddInfo( ({ "dach" }),
              "Auf dem Dach ist das Windrad angebracht.",
              "sagt: ");

  AddInfo( ({ "hand" }),
              "An meiner Hand fehlen zwei Finger. Die habe ich in dieser "
              "Saege verloren.",
              "seufzt: ");

  AddInfo( ({ "pfosten" }),
              "Die Pfosten halten das Dach des Saegewerkes.",
              "sagt: ");

  AddInfo( ({ "reste" }),
              "Die Reste werden wir sicher noch irgendwo los."
              "bitte lass sie einfach liegen wo sie sind.",
              "sagt: ");

  AddInfo( ({ "handschuhe" }),
              "Die Handschuhe schuetzen mich nur vor der Spaene, nicht vor "
              "der riesigen Saege.",
              "sagt: ");

  AddInfo( ({ "leiter" }),
              "Die Leiter fuehrt auf das Dach. Ich kann dort dann nachsehen, "
              "ob alles in Ordnung ist.",
              "sagt: ");

  AddInfo( ({ "werkzeug" }),
              "Die Saege ist mein einziges Werkzeug.",
              "sagt: ");

  AddInfo( ({ "spaene" }),
              "Die Spaene fliegt hier andauernd herum. Du kannst sie ja "
              "wegmachen wenn Du willst. Das wird aber nicht viel bringen.",
              "sagt: ");

  AddInfo( ({ "besen" }),
              "Warum fragst Du mich nach einem Besen? Willst Du hier kehren?",
              "fragt: ");

  AddInfo( ({ "saegeblatt","blatt" }),
              "Das Saegeblatt ist sehr scharf!",
              "erklaert: ");

  AddInfo( ({ "windrad" }),
              "Das Windrad treibt die Saege an.",
              "sagt: ");

  AddInfo( ({ "mueller","freund" }),
              "Ich mache immer wieder Ersatzteile fuer ihn.",
              "sagt: ");

  AddInfo( ({ "ersatzteile","teile","teil", "ersatzteil" }),
              "Oft mache ich Ersatzteile fuer den Mueller. Am haeufigsten "
              "geht ihm ein Holzstab kaputt.",
              "sagt: ");

  AddInfo( ({ "muehle" }),
              "Die Muehle befindet sich gleich hier in der Naehe im "
              "Huegelland.",
              "sagt: ");

  AddInfo( ({ "stab","holzstab","problem","probleme" }),
              "Der Mueller hat in seiner Muehle oft Probleme mit dem Stab. "
              "Wenn Du magst, verkaufe ich Dir einen.",
              "sagt: ");

  AddInfo( ({ "kaufen","verkaufen","kauf" }),
              "Wenn Du einen Stab, Brett, Melkschemel oder Leitersprosse "
              "kaufen moechtest, dann gib einfach "
              "'kauf stab/brett/schemel/sprosse' ein.",
              "sagt: ");

  AddInfo( ({ "sprosse", "leitersprosse" }),
              "Ich kann dir Sprossen fuer eine Leiter verkaufen. "
              "Damit kannst Du dann eine kaputte Leiter reparieren.",
              "sagt: ");

  AddInfo( ({ "brett","bretter" }),
              "Ich kann Dir ein nagelneues Brett verkaufen. Es ist "
              "qualitativ so hochwertig, dass es sogar Dein Gewicht "
              "tragen wuerde!",
              "sagt: ");

  AddInfo( ({ "schemel","melkschemel" }),
              "Die stelle ich so nebenbei her. Ab und zu verkaufe "
              "ich auch mal einen an einen Bauern .",
              "sagt: ");

  AddInfo( ({ "bauer","xaver" }),
              "Der Xaver vom Bauernhof war lange nicht mehr bei mir. ",
              "sinniert: ");

  AddInfo( ({ "bauernhof" }),
              "Dem Xaver sein Bauernhof ist ganz in der Naehe von Midas. ",
              "sagt: ");

  AddInfo( ({ "fee","feen","leute","zeit" }),
              "In letzter Zeit kommen immer mehr Leute zu mir und erzaehlen "
              "von Problemen im Feenschloss.",
              "sagt: ");

  AddInfo( ({ "probleme","problem" }),
              "Es gibt schon ein paar Probleme im SilberLand. Du musst Dich "
              "aber schon selber genauer umschauen. Ich hab dafuer keine "
              "Zeit.",
              "sagt: ");

  AddInfo( ({ "feenschloss","schloss" }),
              "Das Feenschloss befindet sich in der Ebene und ist ein wenig "
              "noerdlich von Midas gelegen.",
              "sagt: ");

  AddInfo( ({ "sawer" }), "Richtig geraten, das ist mein Name.", "sagt: ");

  AddCmd( ({ "kauf","kaufe" }), "kauffkt");

  schemel = MAX_ANZ_SCHEMEL;
  bretter = MAX_ANZ_BRETTER;
  sprosse = MAX_ANZ_SPROSSEN;
}

void reset()
{
  ::reset();
  schemel = MAX_ANZ_SCHEMEL;
  bretter = MAX_ANZ_BRETTER;
  sprosse = MAX_ANZ_SPROSSEN;
}

saege() {
  object ob;
  if (ob=present("\nbaum",MENV)) {
    tell_room(environment(TO),
      "Sawer nimmt einen Baum und faengt an ihn zurechtzusaegen.\n");
    ob->remove();
    call_out("saege1",5);
  }
}

saege1() {
  tell_room(environment(TO),
    "Die Saege kreischt laut auf, als Sawer anfaengt den Baum zu zersaegen.\n");
  call_out("saege2",10);
}

saege2() {
  tell_room(environment(TO),
    "Der Baum nimmt langsam die Form von Hoelzern an.\n");
  call_out("saege3",10);
}

saege3() {
  tell_room(environment(TO), "Sawer hat den Baum fast fertig gesaegt.\n");
  call_out("saege4",10);
}

saege4() {
  tell_room(environment(TO), BS(
    "Aus dem Baum hat Sawer jetzt wunderschoene Hoelzer gemacht. Er geht "
    "damit in die Lagerverwaltung, damit sie dort verkauft werden koennen. ") );
  tell_room(environment(TO), "Sawer geht nach Osten.\n" );
  call_other(TRESORMASTER, "Add_Money",10+random(10)); // geld in tresor tun
  ME->SetProp(P_INVIS,1);
  call_out("saege5",1);
}

saege5() {
  tell_room(environment(TO), "Sawer kommt an.\n" );
  ME->SetProp(P_INVIS,0);
}

void finger_ab( object enemy, int damage, mixed dam_type) {
  if( random(3)==1) {
    if (interactive(enemy)) {
      if (!present("\n_sawer_finger", enemy)) {
        CLONE(OBJ "fingerab",enemy);
        tell_object(enemy,"Ahhhhh, da ist wohl etwas ganz schreckliches passiert.\n");
      }
    }
  }
}

int _query_wimpy() { return 0; }

int kauffkt(string str) {
  object ob;

  notify_fail("Sawer sagt: Ich kann Dir nur eines davon verkaufen!\n");
  if(str == "bretter" || str == "staebe" || str == "holzstaebe" ||
      str == "sprossen" || str== "leitersprossen" ) 
    return 0;
  notify_fail("Sawer sagt: Was moechtest Du denn von mir kaufen?\n");
  if(str == "stab" || str == "holzstab") {
    if(!call_other("/d/huegelland/iwo/muehle/npc/master", "isquester", TP)) {
      write(BS(
        "Sawer sagt: Geh doch erst einmal den Mueller fragen."));
      return 1;
    }
    if(present("stabfuermuehle",TP)) {
      write(BS(
        "Sawer sagt: Aber Du hast ja schon einen nagelneuen Stab!"));
      return 1;
    }
    if(TP->QueryMoney() < STABKOSTEN) {
      write(BS(
        "Sawer sagt: Du hast leider keine "+STABKOSTEN+" Muenzen fuer "
        "den Stab!"));
      return 1;
    }
    TP->AddMoney(-STABKOSTEN);
    write(BS(
      "Sawer verkauft Dir fuer "+STABKOSTEN+" Muenzen einen nagelneuen Stab."));
    say(BS(CAP_TPN+" kauft von Sawer einen Stab."), ({ TP }) );
    ob=clone_object("/d/huegelland/iwo/muehle/obj/stab.lpc");
    ob->move(TP,M_NOCHECK);

    return 1;
  }
  if( str == "brett") {

    if(!bretter) {
      write(BS(
        "Sawer sagt: Alle Bretter sind bereits bestellt und reserviert."));
      write(BS(
        "Sawer sagt: Eventuell habe ich spaeter eines fuer Dich."));
      return 1;
    }

    if(!present("HUTSCHLEIER", TP) && !present("\nFEENQUESTOBJ",TP)) {
      write(BS(
        "Sawer sagt: Alle Bretter sind bereits bestellt und reserviert."));
      write(BS(
        "Sawer sagt: Eventuell habe ich spaeter eines fuer Dich."));
      return 1;
    }
    if(present("\nFEENBRETT",TP)) {
      write(BS(
        "Sawer sagt: Ich habe Dir doch vorhin erst ein Brett verkauft."));

      write(BS(
        "Sawer sagt: Diese Bretter sind alle bestellt und reserviert."));
      return 1;
    }
    if(TP->QueryMoney() < BRETTKOSTEN) {
      write(BS(
        "Sawer sagt: Du hast leider keine "+BRETTKOSTEN+" Muenzen fuer "
        "ein Brett!"));
      return 1;
    }
    TP->AddMoney(-BRETTKOSTEN);
    write(BS(
      "Sawer verkauft Dir fuer "+BRETTKOSTEN+" Muenzen ein nagelneues Brett."));
    say(BS(CAP_TPN+" kauft von Sawer ein Brett."), ({ TP }) );

    ob=clone_object("/d/ebene/ronja/feenquest/obj/brett.lpc");
    bretter--;

    if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
    {
      write(BS(
        "Das Brett ist jedoch zu schwer fuer Dich und Du legst es "
        "erstmal ab"));
      ob->move(ENV(TO),M_SILENT|M_NOCHECK);
    }

    return 1;
  }

  if( str == "schemel" || str == "melkschemel") {

    if(!schemel || deep_present("melkschemel",TP))
    {
      write(BS("Sawer sagt: Tut mir leid, aber alle Schemel sind ausverkauft."));
      return 1;
    }

    if(TP->QueryMoney() < SCHEMELKOSTEN) {
      write(BS(
        "Sawer sagt: Du hast leider keine "+SCHEMELKOSTEN+" Muenzen fuer "
        "einen Schemel!"));
      return 1;
    }

    ob=clone_object("/d/ebene/obj/div/schemel");
    TP->AddMoney(-SCHEMELKOSTEN);
    write(BS(
      "Sawer verkauft Dir fuer "+SCHEMELKOSTEN+" Muenzen einen Melkschemel."));
    say(BS(CAP_TPN+" kauft von Sawer einen Melkschemel."), ({ TP }) );
    schemel--;

    if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
    {
      write(BS(
        "Der Schemel ist jedoch zu schwer fuer Dich und Du stellst ihn "
        "erstmal ab"));
      ob->move(ENV(TO),M_SILENT|M_NOCHECK);
    }


    return 1;
  }

  if( str == "sprosse" || str == "leitersprosse") {

    if(!sprosse || deep_present("leitersprosse",TP))
    {
      write(BS("Sawer sagt: Tut mir leid, aber alle Sprossen sind ausverkauft."));
      return 1;
    }

    if(TP->QueryMoney() < SPROSSENKOSTEN) {
      write(BS(
        "Sawer sagt: Du hast leider keine "+SPROSSENKOSTEN+" Muenzen fuer "
        "eine Leitersprosse!"));
      return 1;
    }

    ob=clone_object("/d/polar/rage/ostplatz/obj/sprosse");
    TP->AddMoney(-SPROSSENKOSTEN);
    write(BS(
      "Sawer verkauft Dir fuer "+SPROSSENKOSTEN+" Muenzen eine Leitersprosse."));
    say(BS(CAP_TPN+" kauft von Sawer eine Leitersprosse."), ({ TP }) );
    sprosse--;

    if(ME_TOO_HEAVY==ob->move(TP,M_GET|M_SILENT))
    {
      write(BS(
        "Die Leitersprosse ist jedoch zu schwer fuer Dich und Du legst sie "
        "erstmal ab"));
      ob->move(ENV(TO),M_SILENT|M_NOCHECK);
    }


    return 1;
  }
  return 0;
}
