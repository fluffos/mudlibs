/*
   Ein starker Holzfaeller von Zordan@SL
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Holzfaeller");
  SetProp(P_LONG, 
    "Ein starker Holzfaeller faellt hier die Baeume mit seiner grossen Axt. "
    "Seine Muskeln wirken sehr beeindruckend auf Dich. Schweiss rinnt seinen "
    "Koerper herunter. Er ist so vertieft in seine Arbeit, dass er Dich "
    "nicht beachtet. " );

  AddDetail( "muskeln", "Die Muskeln strotzen unter seiner Kleidung hervor. "
             "Solch dicke Muskeln sieht man sehr selten." );
  AddDetail( "schweiss", "Die Arbeit eines Holzfaellers ist sehr anstrengend. "
             "Deshalb laeuft ihm der Schweiss auch staendig in Stroemen "
             "den Koerper hinunter." );
  AddDetail( "arbeit", "Na er faellt Baeume, was dachtest Du denn ?");


  SetProp(P_NAME, "Holzfaeller");
  SetProp(P_GENDER, MALE);
  AddId( ({ "holzfaeller", "mensch" , "faeller" , "\nholzfaeller" }) );

  create_default_npc(19+random(5));
  SetProp(P_HANDS, ({" mit blossen Haenden" , 120 , DT_BLUDGEON}) );
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, 30+random(30));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_BODY, 90+random(20)); // besonders dicke Muskeln :-)

  SetProp(P_MSGIN, "kommt herein und beginnt zu arbeiten");
  SetProp(P_MSGOUT, "macht ein Pause und geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " laesst Dich jetzt seine Arbeit machen.\n");

  AddInfo(DEFAULT_INFO, "achtet nicht auf Dich.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Holzfaeller ist zu vertieft in seine Arbeit.\n" }) );

  SetChats(1, ({
    "Der Holzfaeller wischt sich den Schweiss von der Stirn.\n",
    "Der Holzfaeller schaerft kurz seine Axt neu.\n",
    "Der Holzfaeller sucht den naechsten Baum.\n",
    "Der Holzfaeller mustert den Baum.\n",
    "Der Holzfaeller denkt . o O (Einen mach ich noch nieder).\n",
    "Der Holzfaeller schlaegt mit voller Wucht auf einen Baum ein.\n",
    "Der Holzfaeller drischt auf einen Baum ein.\n",
    "Der Holzfaeller haut ein grosses Stueck Holz aus einem Baum.\n",
    "Der Baum wankt schon von den vielen Schlaegen.\n",
    "Der Holzfaeller stoehnt.\n"}) );

  SetProp(P_SPELLRATE,25);

  AddSpell(1, 225,
    "Der Holzfaeller drischt hart auf Dich ein.\n",
    "Der Holzfaeller drischt hart auf @WEN ein.\n",
    DT_SLASH, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 350,
    "Der Holzfaeller versucht Dir den Schaedel zu spalten.\n",
    "Der Holzfaeller versucht @WEN den Schaedel zu spalten.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(2, 75,
    "Der Holzfaeller fuehrt einen gekonnten Hieb aus.\n",
    "Der Holzfaeller erwischt @WEN mit einem gekonnten Hieb.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetAttackChats(10, ({
    "Der Holzfaeller wirbelt mit seiner Axt herum.\n",
    "Der Holzfaeller spannt seine Muskeln weiter an.\n",
    "Der Holzfaeller lacht ueber Dich.\n",
    "Der Holzfaeller sagt: \"Du bekommst nie wieder Holz von uns !\"\n"}) );

  SetProp(P_LOG_INFO, "holzfaeller.log");

  SUID;
  CLONEME( "/p/weapon/axe/holzfaelleraxt" );
  command("zuecke holzfaelleraxt");
  CLONEME( "/p/armour/boots/lederstiefel" );
  CLONEME( "/p/armour/gloves/lederhandschuhe" );
  CLONEME( ARMOUR "wolljacke" );
  CLONEME( "/p/armour/helm/wollmuetze" );
  command("trage alles");
}
