/*
   Ein starker Holzfaeller von Zordan@SL
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein rastender Holzfaeller");
  SetProp(P_LONG, 
    "Ein starker Holzfaeller faellt hier die Baeume mit seiner grossen Axt. "
    "Seine Muskeln wirken sehr beeindruckend auf Dich. Im Moment ruht er sich hier "
    "gerade am Feuer aus und erzaehlt ein paar Geschichten aus seiner Jugend. " );

  AddDetail( "geschichten", "Leider spricht er in einer Dir unbekannten Sprache. "
             "Du verstehst also kein Wort." );
  AddDetail( "jugend","Schon in seiner Jugend duerfte er starke Muskeln "
             "gehabt haben." );
  AddDetail( "muskeln", "Die Muskeln strotzen unter seiner Kleidung hervor. "
             "Solch dicke Muskeln sieht man sehr selten." );


  SetProp(P_NAME, "Holzfaeller");
  SetProp(P_GENDER, MALE);
  AddId( ({ "holzfaeller", "mensch" , "faeller" }) );

  create_default_npc(19+random(5));
  SetProp(P_HANDS, ({" mit einer Schweinekeule" , 120 , DT_BLUDGEON}) );
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, 30+random(30));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_BODY, 90+random(20)); // besonders dicke Muskeln :-)

  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " laesst Dich jetzt seine Arbeit machen.\n");

  AddInfo(DEFAULT_INFO, "achtet nicht auf Dich.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Holzfaeller achtet nicht auf Dich.\n" }) );

  SetProp(P_SPELLRATE,25);

  AddSpell(1, 225,
    "Der Holzfaeller drischt hart auf Dich ein.\n",
    "Der Holzfaeller drischt hart auf @WEN ein.\n",
    DT_SLASH, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 350,
    "Der Holzfaeller versucht Dir den Schaedel zu spalten.\n",
    "Der Holzfaeller versucht @WEN den Schaedel zu spalten.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(2, 75,
    "Der Holzfaeller fuehrt einen gekonnten Hieb aus.\n",
    "Der Holzfaeller erwischt @WEN mit einem gekonnten Hieb.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetAttackChats(10, ({
    "Der Holzfaeller spannt seine Muskeln weiter an.\n",
    "Der Holzfaeller lacht ueber Dich.\n",
    "Der Holzfaeller sagt: \"Du bekommst nie wieder Holz von uns !\"\n"}) );

  SUID;
  CLONEME( "/p/armour/boots/lederstiefel" );
  CLONEME( "/p/armour/gloves/lederhandschuhe" );
  CLONEME( ARMOUR "wolljacke" );
  command("trage alles");
}
