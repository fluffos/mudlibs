
/*
   Alwinja, die Koechin im Holzfaellerlager Zoradn@SL
*/

int anzahl_suppe;

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

reset() {
  ::reset();
  anzahl_suppe=5;
}

void create() {
  if (!is_clone(TO)) return;
  ::create();

  anzahl_suppe=5;

  SetProp(P_SHORT, "Alwinja, die Koechin");
  SetProp(P_LONG,
    "Vor Dir steht eine huebsche Frau um die Dreissig. Sie ist eine hervorragende "
    "Koechin und steht deshalb auch am Herd und kocht eine Suppe. Wenn Du sie "
    "nett fragst, dann gibt sie Dir ja vielleicht ein wenig davon ab. " );
  SetProp(P_NAME, "Alwinja");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "alwinja" , "koechin" , "\nkoechin" }));
  set_living_name("alwinja");

  create_default_npc(10);

  SetProp(P_HANDS, ({" mit verschmierten Haenden an",40,DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 130+random(10));
  SetProp(P_ALIGN, 144);
  SetProp(P_MAX_HANDS, 2);
  SetProp (P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  AddInfo(DEFAULT_INFO, "sieht Dich fragend an.\n");

  SetProp(P_LOG_INFO, "holzfaeller.log");

  SetProp( P_REJECT, ({ REJECT_KEEP, "Alwinja laechelt Dich freundlich an.\n" }) );

  SetChats(1, ({
    "Alwinja ruehrt weiter in der Suppe.\n",
    "Alwinja fuegt der Suppe noch ein paar Zutaten bei.\n",
    "Alwinja kostet von der Suppe und scheint zufrieden zu laecheln.\n",
    "Die Suppe koechelt leise vor sich hin.\n",
    "Herrlicher Geruch steigt Dir in die Nase.\n",
    "Alwinja fragt Dich: Moechtest Du ein wenig Suppe haben ?\n"}) );

  SUID;
  CLONEME(WEAPON "suppenloeffel" );
  command("zuecke suppenloeffel");
  CLONEME("/d/ebene/rohkopfrex/bauernhof/armour/schuerze");
  command("trage alles");

  AddLibrary( NPC "standard.lib",1,1);

  AddInfo( ({ "kueche" , "hoheitsgebiet" }),
            "Die Kueche hier ist mein Hoheitsgebiet. Ich lasse niemanden "
            "ungeschoren hier herumfummeln.",
            "sagt: ");

  AddInfo( ({ "reisende" }),
            "Reisende kommen oft hier vorbei und kosten von meiner Suppe.",
            "sagt: ");

  AddInfo( ({ "suppenloeffel","loeffel" }),
            "Das ist mein ganz spezieller Suppenloeffel. Den kann ich Dir "
            "nicht geben.",
            "sagt: ");

  AddInfo( ({ "herd" }),
            "Das ist mein Herd. Lass Deine Finger davon!",
            "sagt ernergisch: ");

  AddInfo( ({ "glueck" }),
            "Ich wuensche Dir viel Glueck hier im Lager. Ist ein wundervoller Ort.",
            "sagt: ");

  AddInfo( ({ "wunsch" }),
            "Leider kann ich Dir keinen Wunsch erfuellen.",
            "seufzt: ");

  AddInfo( ({ "essen" }),
            "Zu Essen bekommst Du bei mir nur die Suppe. Aber von der solltest "
            "Du auf jeden Fall mal kosten.",
            "sagt: ");

  AddInfo( ({ "pilz" , "pilze" }),
            "Die Pilze in meiner Suppe kommen aus einem Versteck. Sie wachsen "
            "nicht einfach so auf der Strasse.",
            "fluestert: ");

  AddInfo( ({ "versteck" }),
            "Glaubst Du ernsthaft, ich verrate Dir wo das ist ?",
            "grummelt: ");

  AddInfo( ({ "alwinja" }), "Klaro, das bin ich.", "laechelt: ");

  AddInfo ( ({"suppe"}), "@@suppe@@", "sagt: ");
}

string suppe() {
  object ob;
  if(present("\nstuhl",TP)) {
    say("Alwinja gibt "+TPN+" einen Teller voll Suppe.\n",TP);
    if (anzahl_suppe-->0) {
      write(BS ("Alwinja stellt Dir einen Teller voll Suppe auf den Tisch, den Du "
              "auch sofort ausloeffelst. Du fuehlst Dich erfrischt und gestaerkt."));
      TP->SetProp(P_HP,TP->QueryProp(P_HP)+30+random(10));
      TP->SetProp(P_SP,TP->QueryProp(P_SP)+40+random(10));
    } else {
      write(BS ("Alwinja stellt Dir einen Teller voll Suppe auf den Tisch, den Du "
              "auch sofort ausloeffelst. Wuaaa die war ja schon kalt. Du wuergst "
              "Dich." ));
      TP->reduce_hit_point(5+random(5));
    }
    return "Hoffentlich hat sie Dir geschmeckt."; 
  }

  return
    "Meine Suppe ist sehr bekannt im Silberland. Sie staerkt nicht nur die "
   +"Holzfaeller nach einem anstrengendem Arbeitstag, sondern auch "
   +"vorbeikommende Reisende wie Dich. Wenn Du sie auch mal kosten magst, "
   +"dann nimm doch einfach Platz und frag mich wieder danach.";
}
