
/*
   Der Master fuer den Tresor Zordan@SL
   ( ich habe das einfach nicht mit arrays hinbekommen. Wenn da einer 
     ne Loesung parat hat, immer her damit :-) )
*/

#include "../def.h"

mixed geld_save;
mixed kombination;
nosave int geldmenge;
nosave int *code_tab;

query_prevent_shadow() { return 1; }

create() {
  if (is_clone(TO)) {
    destruct(TO);
    return 1;
  }
  code_tab=allocate(5);
  code_tab=({ 0,0,0,0,0 });
  seteuid(getuid(TO));
  if (restore_object(TRESORMASTERLOG)) {
     geldmenge=geld_save;
     code_tab=kombination;
  }
}

int Add_Money(int anzahl) {
  geldmenge+=anzahl;
  if (geldmenge > 5000) { geldmenge=5000; }                     // max 5000 muenzen 
  if (geldmenge < 2000) { geldmenge=2000+anzahl+random(100); }  // min 2000 muenzen 
  geld_save=geldmenge;
  save_object(TRESORMASTERLOG);
  return 1;
}

int Remove_Money() { 
  int temp;
  temp=geldmenge;
  geldmenge=2000+random(100);           // mind. 2000 muenzen sollten drin sein
  geld_save=geldmenge;
  save_object(TRESORMASTERLOG);
  return temp;
}

int New_Code() {
  code_tab[1] = random(100);
  code_tab[2] = random(100);
  code_tab[3] = random(100);
  code_tab[4] = random(100);
  kombination = code_tab ;
  save_object(TRESORMASTERLOG);
  return 1;
}

int Get_Code(int nummer) {
  if ((nummer<1) || (nummer>4)) return -1;
  return code_tab[nummer];
}
