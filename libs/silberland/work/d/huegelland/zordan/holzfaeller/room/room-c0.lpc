
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

init() {
  ::init();
  call_out("fall_runter",30+random(30),TP);
}

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Dach" );
  SetProp( P_INT_LONG,
    "Du kletterst die Leiter hoch auf das Dach des Saegewerks. Das Windrad "
    "dreht sich monoton im Wind. Viel Platz ist hier dadurch nicht. Von hier "
    "aus hast Du einen sehr guten Ueberblick ueber das Holzfaellerlager." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_FOREST]) );

  AddDetail( ({ "sonne" }),
    "Die Sonne strahlt freudig vom Himmel herunter und waermt Dich." );

  AddDetail( ({ "boden" }),
    "Der Boden ist hier das Dach des Saegewerkes. Durch ein kleines Loch "
    "fuehrt die Leiter wieder runter." );

  AddDetail( ({ "loch" }),
    "Das Loch ist gerade gross genug, dass Du wieder runtergehen kannst." );

  AddDetail( ({ "himmel" }),
    "Da Du jetzt knapp oberhalb der Baumgrenze bist, kannst Du auch den "
    "wolkenfreien Himmel mit der gelb strahlenden Sonne erkennen. Dir wird "
    "auch ein wenig warm." );

  AddDetail( ({ "baumgrenze" }),
    "Das Windrad muss ja oberhalb der Baumgrenze sein. Denn sonst wuerde der Wind "
    "das Windrad nicht eintreiben koennen, weil die Baeume den Wind "
    "aufhalten wuerden." );

  AddDetail( ({ "baeume" , " baum" , "wald" }),
    "Die Baeume sind unten herum quer um das ganze Lager verteilt. Man nennt "
    "es auch meistens einen Wald." );

  AddDetail( ({ "platz" }),
    "Der Platz hier ist wirklich arg begrenzt. Fast haette Dich schon das "
    "Windrad getroffen und runtergeworfen." );

  AddDetail( ({ "leiter" }),
    "Die kleine Leiter fuehrt wieder hinunter in das Saegewerk." );

  AddDetail( ({ "dach" }),
    "Das Windrad "
    "dreht sich monton im Wind. Viel Platz ist hier dadurch nicht. Von hier "
    "aus hast Du einen sehr guten Ueberblick ueber das Holzfaellerlager." );

  AddDetail( ({ "holzfaellerlager" , "lager" }),
    "Augenblicklich befindest Du Dich auf dem Dach des Saegewerkes. Es "
    "herrscht reger Betrieb im Lager. Genuesslich ziehst Du einen kleinen "
    "Snack aus der Tasche und schaust den Holzfaellern bei der Arbeit zu. "
    "Allerdings solltest Du Dich nicht zulange damit aufhalten, denn das Windrad "
    "huscht immer nur sehr knapp an Dir vorbei !" );

  AddDetail( ({ "saegewerk" }),
    "Du sitzt auf dem Dach desselben, schon vergessen ?" );

  AddDetail( ({ "betrieb" , "arbeit" }),
    "Die Holzfaeller schufften und schufften. Gut, das Du hier nicht "
    "angestellt bist und mithelfen musst." );

  AddDetail( ({ "snack" , "tasche" }),
    "Na ein kleiner Snack, den man immer dabei hat ;)" );

  AddDetail( ({ "holzfaeller" , "faeller" }),
    "Sie scheinen sich nicht dafuer zu interessieren, dass Du hier oben auf "
    "dem Dach sitzt. Manchmal schaut einer rauf und faengt an zu grinsen. "
    "Aber warum nur ?" );
    
  AddDetail( ({ "windrad" }),
    "Das Windrad hat vier grosse Fluegel, welche Dir immer sehr nahe kommen. "
    "Du wirst das Gefuehl nicht los, dass Du Dich hier beeilen solltest." );

  AddDetail( ({ "gefuehl" }),
    "Ein komisches Gefuehl ueberkommt Dich und Du meinst Du solltest Dich "
    "unbedingt beeilen !" );

  AddDetail( ({ "fluegel" }),
    "Die Fluegel ueben durch den Wind hervorgerufen eine Kraft auf die "
    "Welle aus, so dass sich das Windrad gemaechlich drehen kann." );

  AddDetail( ({ "kraft" }),
    "Soviel Kraft, wie das Windrad erzeugt, kannst Du niemals ausueben." );

  AddDetail( ({ "welle" , "rotieren" }),
    "Die hoelzerne Welle wird durch die Fluegel zum Rotieren gebracht, um damit "
    "dann unten die Saege zu bewegen." );

  AddDetail( ({ "saege" , "bekanntschaft" }),
    "Die Saege sieht von hier oben noch gewaltiger aus, als sie es unten tat. "
    "Lieber machst Du niemals Bekanntschaft mit ihr." );

  AddDetail( ({ "wind" }),
    "Durch die Kraft des Windes werden die Fluegel bewegt. Du spuerst, dass "
    "der Wind hier oben wohl nie nachlassen wirst. Ob da irgendein Magier "
    "seine Finger im Spiel hatte ?" );

  AddDetail( ({ "magier" , "finger" , "spiel" , "moment" }),
    "Da der Magier im Moment unsichtbar ist, kannst Du ihn nicht sehen." );

  AddDetail( ({ "ueberblick" }),
    "Von hier aus kannst Du das ganze Lager sehen. Du schaust in Richtung "
    "Sueden. Auf einmal faellt Dir eine kleine Unregelmaessigkeit "
    "nordoestlich Deiner Blickrichtung auf." );

  AddDetail( ({ "richtung" }),
    "Es gbt viele davon, schlag bloss die richtige ein. Und das schnell." );

  AddDetail( ({ "blickrichtung" }),
    "Die Blickrichtung ist nach Sueden." );

  AddDetail( ({ "unregelmaessigkeit" }),
    "Hm, seltsam. Jetzt ist sie auf einmal verschwunden. Sehr seltsam." );

  AddDetail( ({ "nordoestlich" , "nordosten" }),
    "Ah, genauer hingesehen faellt Dir auf, dass das Lager aus Deiner "
    "Blickrichtung gesehen sich weiter nach Nordosten ausdehnt, als man unten "
    "annehmen kann. Dem sollte man vielleicht echt mal nachgehen." );

  AddSound( DEFAULT_SOUND,
    "Du hoerst leise das Rauschen des Windes, wenn er am Windrad vorbeizieht. " );

  AddSound( ({ "wind" }),
    "Der Wind erzeugt ein leises Rauschen an den Fluegeln des Windrades. " );

  AddSmell( DEFAULT_SMELL,
    "Du nimmst den sanften Duft des Waldes wahr." );

  AddSmell( ({ "duft" , "wald" }),
    "Der Wald duftet nach frisch geschlagenen Baeumen. ");

  AddExit( "runter", "./room-c1" );
}

fall_runter( object player ) {
  if(objectp(player) && present(player)) {
    write("Auf einmal erwischt Dich das Windrad und schleudert Dich runter.\n");
    player->move( ROOM "room-c1" , M_GO, 0,
        "wird vom Windrad getroffen und faellt runter", "faellt vom Himmel");
    player->do_damage(10+random(10));
  }
}
