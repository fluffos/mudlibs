
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int pilze;

reset() {
  ::reset();
  pilze=5; 
}


create()
{
  ::create();

  pilze=5;

  SetProp( P_INT_SHORT, "Ein Durchschlupf" );
  SetProp( P_INT_LONG,
    "Durch die dichten Zweige hast Du Dich geschlagen und findest Dich "
    "inmitten eines kleinen Durchschlupfes im Wald. Von draussen hoerst "
    "Du noch leise die Schlaege der Holzfaeller, aber ansonsten ist es "
    "hier relativ ruhig. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 13, ENV_TERRAIN:TT_FOREST]) );

  SetProp (P_KILL_NAME, "Ein giftiger Pilz");
  SetProp (P_KILL_MSG,  "Man sollte mich nicht essen!");

  AddDetail( ({ "durchschlupf" }),
    "Nur durch den Ueberblick vom Dach des Saegewerkes aus, konntest Du "
    "diesen Durchschlupf finden. Er ist inmitten des Waldes und Du bist "
    "ringsherum von Baeumen umgeben." );

  AddDetail( ({ "dach" , "saegewerk" }),
    "Das kannst Du von hier leider nicht mehr sehen." );

  AddDetail( ({ "ueberblick" }),
    "Den kann man leicht in einem Lager verlieren. Gerade weil man auch "
    "soetwas wie den Durchschlupf nicht erwartet." );

  AddDetail( ({ "zweige" }),
    "Die Zweige sind hier so dicht, dass Du nur noch nach Nordosten "
    "zurueckgehen kannst." );

  AddDetail( ({ "boden" }),
    "Der Boden ist mit leicht feuchtem Gras bedeckt." );

  AddDetail( ({ "gras" }),
    "Das saftige Gras laedt geradezu zum Ausruhen ein. Hier und da findest "
    "Du auch ein paar Pilze. " );

  AddDetail( ({ "ausruhen" , "stelle" }),
    "Zum Ausruhen ist dieses sicher ein gute Stelle. Aber leider ist Dir "
    "nicht danach." );

  AddDetail( ({ "lager" , "holzfaellerlager" }),
    "Das Lager liegt weiter im Nordosten. " );

  AddDetail( ({ "himmel" }),
    "Du kannst den Himmel nicht sehen." );

  AddDetail( ({ "wald" }),
    "Der Wald besteht hier zum groessten Teil aus Nadelbaeumen. Sie sind von "
    "hervorragender Qualitaet. " );

  AddDetail( ({ "holzfaeller" }),
    "Die Holzfaeller befinden sich im Lager. Um zum Lager zu kommen, musst "
    "Du schon wieder zurueckgehen." );

  AddDetail( ({ "qualitaet" }),
    "Die Qualitaet ist kaum beschreibbar. Du bist echt beeindruckt." );

  AddDetail( ({ "teil" ," ganzen" , "ganz" }), "Ein wenig vom Ganzen. " );

  AddDetail( ({ "nadelbaeume" , "baeume" , "baum" }),
    "Sehr schoene und starke Nadelbaeume saeumen den Wald." );

  AddDetail( ({ "schlaege" }),
    "Die kommen wohl mehr aus Norden, als von hier." );

  AddSound( DEFAULT_SOUND,
    "Leises Splittern von Holz dringt an Dein Ohr. " );

  AddSound( ({ "schlaege" }),
    "Die Schlaege sind kaum noch zu hoeren." );

  AddSound( ({ "splittern" }),
    "Das Splittern von Holz kann nur von sehr grossen Aexten "
    "hervorgerufen werden. Mit Deiner kleinen Waffe geht das sicher nicht. " );

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach feuchtem Gras, Harz und leckeren Pilzen." );

  AddSmell( ({ "gras" }),
    "Das Gras duftet richtig in Deiner Nase. Aber essen magst Du es nicht. ");

  AddSmell( ({ "harz" , "geruch" }),
    "Der Geruch von Harz dringt deutlich in Deine Nase. Es kann nur von den "
    "Resten von abgeholzten Baeumen stammen, die hier ueberall herumliegen. " );

  AddSmell( ({ "pilz" , "pilze" }),
    "Die Pilze riechen einfach lecker. ");

  AddSpecialDetail( ({"pilze","pilz" }),"pilzfkt");
  AddExit( "nordosten", "./room-b3" );

  AddCmd( ({"iss","ess","esse" }),"essen");
}

int essen(string str) {
  int poison, maxpoison;
  notify_fail( "Wo moechtest Du essen ?\n" );
  if ( str == "pilz" ) {
    if (pilze-- > 0) {
      write("Du isst einen der leckeren Pilze und fuehlst Dich sofort besser.\n" );
      say(CAP_TPN+" isst einen Pilz und schaut besser als vorher aus.\n");
      TP->heal_self(20);
      return 1;
    } else {
      if (random(2)) {
        write("Du isst einen der Pilze. Dir wird ganz unwohl dabei.\n" );
        say(CAP_TPN+" isst einen Pilz und fuehlt sich nicht gut.\n");
        TP->do_damage(20);
        return 1;
      } else {
        write("Du isst einen der Pilze. Er war wohl vergiftet. Oerkz.\n" );
        say(CAP_TPN+" isst einen Pilz und sieht auf einmal krank aus.\n");
        TP->do_damage(30);
        TP->AddPoison(1);
        return 1;
      }
    }
  }
  return 0;
}

string pilzfkt(string str) {
  if (pilze>0) return BS(
    "Leicht verstreut wachsen ueberall kleine Pilze aus dem Boden. "
    "Vielleicht kann man die ja auch essen ? Sie sehen jedenfalls gut aus." );
  return BS(
    "Du weisst nicht so recht. Aber die restlichen Pilze sehen nicht "
    "besonders gesund aus!" );
}
