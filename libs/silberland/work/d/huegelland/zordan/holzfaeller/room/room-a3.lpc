
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "baumfaellt.h"

create()
{
  ::create();

  anzbaeume=3;

  SetProp( P_INT_SHORT, "Ein Abholzgebiet" );
  SetProp( P_INT_LONG,
    "In diesem Teil des Lagers werden die neuen Baeume gefaellt. Viele "
    "Splitter und Geaest liegen auf dem Boden verteilt. Grosse Vorsicht "
    "ist hier geboten, denn wenn hier Baeume umfallen, werden leicht "
    "Leute darunter vergraben und kommen dabei um. Du kannst hier auch "
    "ueberhaupt keine Tiere sehen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_FOREST]) );

#include "standard.h"
#include "abholz.h"

  AddItem( NPC "holzfaeller" , REFRESH_DESTRUCT);

  AddExit( "osten", "./room-b3" );
}
