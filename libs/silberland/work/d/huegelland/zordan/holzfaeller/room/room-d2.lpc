
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine kleine Lichtung" );
  SetProp( P_INT_LONG,
    "Du stehst auf einer kleinen Lichtung. Im Norden kannst du ein kleines "
    "Gebaeude sehen. Westlich von Dir scheint ein kleines Feuer zu brennen. "
    "Ueberall kannst Du kleine Baumstumpen sehen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_FOREST]) );

#include "standard.h"

  AddDetail( ({ "lichtung" }),
    "Im Norden kannst du ein kleines "
    "Gebaeude sehen. Westlich von Dir scheint ein kleines Feuer zu brennen. "
    "Ueberall kannst Du kleine Baumstumpen sehen." );

  AddDetail( ({ "gebaeude" }),
    "An der Vorderseite des Gebaeudes kannst Du eine kleine Verkaufstheke "
    "sehen. Ueber der Theke haengt ein grosses Schild." );

  AddDetail( ({ "schild" }),
    "Schon mit lesen versucht ?" );

  AddReadDetail( ({ "schild" }),
    "Sehr geehrte Damen und Herren, damit wir Ihre Wuensche zu Ihrer "
    "Zufriedenheit erfuellen koennen, stellen sie Ihre Anfragen bitte "
    "an der Theke.               Die Lagerverwaltung" );

  AddDetail( ({ "vorderseite" , "theke" , "verkaufstheke" }),
    "An der Theke werden alle Anfragen bezueglich Holz entgegengenommen. "
    "Eine Frau steht an der Theke und bestellt gerade neue Bretter fuer "
    "ihr neues Heim." );

  AddDetail( ({ "anfrage" , "anfragen" }),
    "Falls Du eine Anfrage hast, dann stell sie einfach an der Theke." );

  AddDetail( ({ "frau" , "heim" , "bretter" }),
    "Die Frau ist mit einem kleinen Handwagen da, sie scheint wohl nicht "
    "gerade viele Bretter kaufen zu wollen." );

  AddDetail( ({ "handwagen" }),
    "Der Handwagen ist noch leer." );

  AddDetail( ({ "heim" }),
    "Das ist sicher nicht weit weg, da die Frau nur mit einem kleinen "
    "Handwagen hergekommen ist." );

  AddDetail( ({ "feuer" }),
    "Das Feuer ist weiter im Westen. Du musst schon hingehen, wenn du mehr "
    "sehen willst." );

  AddDetail( ({ "baumstumpen" , "stumpen" , "baumstuempfe" , "stuempfe" }),
    "In diesem Teil des Lagers haben die Holzfaeller schon fast alles abgeholzt. "
    "Sie arbeiten jetzt viel weiter im Westen hinter dem Feuer." );

  AddDetail( ({ "holzfaeller" }),
    "Einige von denen kannst Du weiter im Westen ausmachen." );

  AddItem( NPC "oswin", REFRESH_DESTRUCT);

  AddExit( "nordwesten", "./room-c1" );
  AddExit( "westen",     "./room-c2" );
  AddExit( "suedosten",  "./room-e3" );

  AddCmd("stelle","anfrage");
}

int anfrage( string str ) {
  notify_fail( "Was moechtest Du stellen ?\n" );
  if ( str == "anfrage" || str == "eine anfrage" ) {
    write("Du stellst eine kleine Anfrage nach Brettern.\n");
    write("Der Mann hinter der Theke sagt: Leider sind wir ausverkauft.\n" );
    return 1;
  }
  return 0;
}
