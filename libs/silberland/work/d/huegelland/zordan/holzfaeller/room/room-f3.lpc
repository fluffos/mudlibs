
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Forstweg" );
  SetProp( P_INT_LONG,
    "Kleine Bewohner des Waldes tollen sich im Schatten der Baeume. "
    "Auf dem leicht ausgebildeten Forstweg geniesst Du im Moment einfach " 
    "nur die wundervolle Natur." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_FOREST]) );

#include "waldweg.h"

  AddExit( "westen",   "./room-e3" );
  AddExit( "osten",  HOLZFAELLER_WESTWEG ); // Anschluss an Huegelweg :-)
}

