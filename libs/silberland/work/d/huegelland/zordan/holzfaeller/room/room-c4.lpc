
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int attacke;
int found;

reset() {
  ::reset();
  attacke=0;
  found=0;
}

create() {
  ::create();

  attacke=0;
  found=0;

  SetProp( P_INT_SHORT, "Ein Ruheraum" );
  SetProp( P_INT_LONG,
    "Du betrittst leise den Ruheraum der Holzfaeller. Hier schlafen die "
    "Holzfaeller nach ihrer harten Arbeit auf recht gemuetlich aussehenden "
    "Betten. Neben dem zugezogenen Fenster steht ein grosser Kleiderbuegel, "
    "an dem die Holzfaeller ihre schmutzige Kleidung aufhaengen koennen. " );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({ "boden" }),
    "Der Boden ist aus einfachen Holzplanken hergestellt. Sie liegen so "
    "dicht nebeneinander, dass nicht ein einziger Spalt zu erkennen ist.");

  AddDetail( ({ "holzplanken" , "planken" }),
    "Die Holzplanken stammen sicherlich auch direkt aus dem Holzfaellerlager.");

  AddDetail( ({ "holzfaellerlager" , "lager" }),
    "Du bist im Ruheraum des Lagers, besser Du bist nicht laut !" );

  AddDetail( ({ "spalt" }),
    "Ne ernsthaft, Du kannst keinen einzigen Spalt entdecken." );

  AddDetail( ({ "decke" }),
    "An der Decke sind neben der kleinen Lampe eigentlich nur ein paar "
    "Spinnweben zu sehen." );

  AddDetail( ({ "lampe" }),
    "Eine kleine Lampe, die allerdings geloescht ist. Sicherlich ist es besser, "
    "wenn Du sie nicht anzuendest." );

  AddDetail( ({ "spinnweben" , "weben" }),
    "In den Spinnweben sitzen, wie ist es auch anders zu erwarten, ein paar "
    "fette Spinnen. " );

  AddDetail( ({ "spinnen" }),
    "Die Spinnen versuchen nur, Getier einzufangen." );

  AddDetail( ({ "erwarten" }),
    "Du denkst . o O ( Was sollte man daran untersuchen ? )" );

  AddDetail( ({ "waende" , "wand" }),
    "Der Ruheraum hat sogar vier davon. Wovon die im Norden eine kleine Tuer "
    "beinhaltet. " );

  AddDetail( ({ "norden" , "tuer" , "holztuer" }),
    "Im Norden ist eine kleine Holztuer in die Wand eingelassen, damit man den "
    "Ruheraum betreten und verlassen kann." );

  AddDetail( ({ "kleiderbuegel" , "buegel" }),
    "Am Kleiderbuegel bewahren die Holzfaeller ihre dreckige Kleidung auf, "
    "damit die Betten nicht schmutzig werden. Er besteht komplett aus Holz." );

  AddDetail( ({ "kleidung" }),
    "Die Kleidung wird bei einer solch harten und schmutzigen Arbeit "
    "natuerlich nicht sauberer. Gewaschen wird sie aber anscheinend nicht." );

  AddDetail( ({ "fenster" , "holzfenster" }),
    "An dem Holzfenster sind kleine Vorhaenge aus einfacher Wolle. " );

  AddDetail( ({ "wolle" }),
    "Bis auf ein paar kleine Insekten kannst Du nichts an der Wolle erkennen.");

  AddDetail( ({ "insekten","muecken","getier","muecke" }),
    "Fliegen, Muecken und anderes Getier sitzt auf dem Vorhang." );

  AddDetail( ({ "fliegen","fliege" }),
    "Dutzende von Fliegen summen auf dem Vorhang herum." );

  AddDetail( ({ "vorhaenge","vorhang","lust" }),
    "Die Vorhaenge sind aus ganz einfacher Wolle hergestellt. Die Vorhaenge "
    "sind ein wenig schmutzig, aber Du hast irgendwie keine Lust darauf, sie "
    "sauber zu machen." );

  AddDetail( ({ "betten","bett" }),
    "Die Betten bestehen natuerlich aus dem schoenen Holz, das die "
    "Holzfaeller hier jeden Tag abbauen. Sorgsam verarbeitet knarrt es "
    "nicht einmal, wenn sich einer der Schlafenden umdreht. " );

  AddDetail( ({ "holz" }),
    "Das ist genau das Holz, was hier jeden Tag abgebaut wird. Es hat kaum "
    "Maserung und scheint sehr stabil zu sein." );

  AddDetail( ({ "maserung" , "hinsehen" }),
    "Die Maserung ist nur bei genauerem Hinsehen zu erkennen, so fein ist "
    "das Holz. " );

  AddDetail( ({ "bettpfosten" , "pfosten" }),
    "Die Bettpfosten sind aus dem sehr stabilen Holz gemacht. Sie werden "
    "wohl niemals knarren." );

  AddDetail( ({ "schlafenden" , "schlafende" }),
    "Du betrachtest die Schlafenden naeher und bemerkst eine kleine "
    "Unregelmaessigkeit an einem Bett. " );

  AddDetail( ({ "unregelmaessigkeit" }),
    "Ein kleines Loch scheint im einen der Bettpfosten zu sein. Vielleicht "
    "solltest Du dem genauer nachgehen." );

  AddDetail( ({ "loch" }),
    "Das Loch ist winzig und sehr unscheinbar. " );

  AddDetail( ({ "ruheraum" , "raum" }),
    "Hier schlafen die "
    "Holzfaeller nach ihrer harten Arbeit auf recht gemuetlich aussehenden "
    "Betten. Neben dem zugezogenen Fenster steht ein grosser Kleiderbuegel, "
    "an dem die Holzfaeller ihre schmutzige Kleidung aufhaengen koennen. " );

  AddDetail( ({ "holzfaeller" }),
    "Im Moment scheint keiner auszuruhen. Komisch eigentlich." );

  AddDetail( ({ "moment" }),
    "Du denkst . o O ( Was mag ein Moment sein ? )" );

  AddDetail( ({ "arbeit" }),
    "Die Arbeit der Holzfaeller ist wirklich anstregend. Wenn sie nicht genug "
    "Schlaf bekommen, wuerden sie wahrscheinlich nach ein paar "
    "Tagen erschoepft zusammenbrechen. " );

  AddDetail( ({ "schlaf" }),
    "Wenn Du auch schlafen moechtest, dann gib doch einfach 'schlafe ein' ein." );

  AddDetail( ({ "tag" , "tage" }),
    "Ganz im Gegensatz zu Dir, gehen die Holzfaeller einer geregelten "
    "Arbeit jeden Tag nach. " );

  AddDetail( ({ "gegensatz" }),
    "Oder willst Du etwa sagen, dass Deine Arbeit hier geregelt ist ?" );

  AddItem( NPC "holzschlaf" , REFRESH_DESTRUCT);
  AddItem( NPC "holzschlaf" , REFRESH_DESTRUCT);

  AddExit( "norden", "./room-c3" );

  AddSound( DEFAULT_SOUND,
    "Leises Schnarchen dringt an Dein Ohr. " );

  AddSound( ({ "schnarchen" }),
    "Die Holzfaeller schlafen hier wohl wirklich tief und fest. "
    "Sie schnarchen leise vor sich hin. *Gaehn* Du wirst muede davon." );

  AddSmell( DEFAULT_SMELL,
    "Leicht modriger Gestank von alten Kleidungen erfuellt den Raum." );

  AddSmell( ({ "gestank" , "kleidungen" }),
    "Da das Fenster wohl immer geschlossen ist, verbreiten die Kleidungen "
    "auf dem Kleiderbuegel einen nicht zu ueberriechenden Gestank im Raum.");

  AddCmd( ({ "greife" , "greif" }), "greifen" );
  AddCmd( ({ "a","b","c","d","e","f","h","i","j","k","m","o","p","q",
             "t","v","w","x","y","z" }) , "angriff" , 1);
             
}

int angriff(string str) {
  object ob;
  if ((ob=present("\nholzschlaf")) && (attacke==0 )) {
    attacke=1;
    write("Mit Deiner Aktion weckst Du einen Holzfaeller auf.\n");
    write("Entruestet greift er Dich an.\n");
    ob->Kill(TP);
    ob->SetProp(P_NOATTACK,0);
    ob->SetChats(1, "Der Holzfaeller grummelt, weil er geweckt wurde.\n" );
    ob->SetProp(P_SHORT, "Ein aufgewachter Holzfaeller");
    ob->SetProp(P_LONG, 
  "Ein starker Holzfaeller faellt hier die Baeume mit seiner grossen Axt. "
  "Seine Muskeln wirken sehr beeindruckend auf Dich. Er macht gerade Pause. " );
  }
}

int greifen( string str ) {
  notify_fail( "Worein moechtest Du greifen ?\n" );
  if ( str == "in loch" ) {
    if (found==0) {
      write(BS(
        "Du greifst in das Loch und findest einen kleinen Zettel, "
        "den Du sofort an Dich nimmst." ));
      say(CAP_TPN+" greift in ein Loch und findet etwas.\n" );
      found=1;
      CLONE( OBJ "zettel1" ,TP);
      return 1;
    } else {
      write( "Du greifst in das Loch doch findest leider nichts.\n" );
      say(CAP_TPN+" greift in ein Loch.\n" );
      return 1;
    }
  }
  return 0;
}
