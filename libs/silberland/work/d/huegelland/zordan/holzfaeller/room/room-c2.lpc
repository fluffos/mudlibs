
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int nachlegen;

reset() {
  ::reset();
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19, ENV_TERRAIN:TT_FOREST]) );
  nachlegen=3;
}

create()
{
  ::create();

  nachlegen=3;

  SetProp( P_INT_SHORT, "Eine Feuerstelle" );
  SetProp( P_INT_LONG,
    "Inmitten des Lagers befindet sich eine kleine Feuerstelle. Hier treffen "
    "sich die Holzfaeller und ruhen sich aus oder erzaehlen aus ihrem Leben. "
    "Kleine Baumstuempfe sind um die Feuerstelle aufgebaut. Im Norden kannst "
    "Du das groesste Gebaeude und im Sueden ein kleines Haus sehen. " );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19, ENV_TERRAIN:TT_FOREST]) );

#include "standard.h"

  AddDetail( ({ "gebaeude" , "saegewerk" }),
    "Das Gebaeude stellt sich als Saegewerk heraus. Dort werden sicher die "
    "gefaellten Baeume weiterverarbeitet. Von hier aus kommst Du dort "
    "aber nicht hin." );

  AddDetail( ({ "haus" }),
    "Ein unscheinbares Haus steht im Sueden. Was sich wohl darin verbirgt? "
    "Ein herrlicher Duft kommt aus dem Haus heraus." );

  AddDetail( ({ "baumstuempfe" , "stuempfe" , "sitzgelegenheit" }),
    "Die Stuempfe dienen den Holzfaellern als Sitzgelegenheit. Sie sehen nicht "
    "gerade gemuetlich aus, erfuellen aber sicher ihren Zweck." );

  AddDetail( ({ "zweck" }),
    "Der Zweck ist doch wohl klar: Man kann darauf sitzen ..." );

  AddDetail( ({ "feuerstelle" }),
    "Ein kleines Feuer brennt langsam in der Feuerstelle ab. Ein kleiner "
    "Haufen Schnittholz ist daneben aufgestapelt. Um die Feuerstelle herum "
    "ist ein kleiner Steinkreis aufgebaut." );

  AddDetail( ({ "feuer" }),
    "Das Feuer lodert in der Feuerstelle und waermt die Holzfaeller nach "
    "einem langen Arbeitstag." );

  AddDetail( ({ "arbeitstag" }),
    "Der Arbeitstag eines Holzfaellers ist anstrengend. Du moechtest ihn "
    "sicher nicht haben." );

  AddDetail( ({ "haufen" , "schnittholz" }),
    "Der Haufen dient lediglich dazu, dass das Feuer staendig weiter "
    "betrieben werden kann. Du koenntest ja mal einen Scheit nachlegen." );

  AddDetail( ({ "scheit" , "scheite" , "holzscheite" }),
    "Viele kleine Holzscheite sind hier aufgestapelt." );

  AddDetail( ({ "steinkreis" , "steine" , "stein" }),
    "Faustgrosse Steine schuetzen den Wald davor, dass sich das Feuer zu "
    "einem Waldbrand ausweitet." );

  AddDetail( ({ "waldbrand" }),
    "Ein Waldbrand in dieser Gegend waere ziemlich toedlich fuer alle "
    "Lebewesen, die hier so leben und arbeiten." );

  AddDetail( ({ "gegend" }),
    "Die Gegend hier ist ein Wald, schwer zu erraten, oder ?" );

  AddDetail( ({ "lebewesen" , "rassen", "tiere" }),
    "Alle Rassen und Tiere nennt man Lebewesen." );

  AddDetail( ({ "holzfaeller" }),
    "Hier ruhen sich die Holzfaeller aus und erzaehlen sich Geschichten. "
    "Arbeiten tun sie allerdings weiter im Westen." );

  AddDetail( ({ "geschichten" , "leben" }),
    "Ja, auch die Holzfaeller haben nach ihrem Arbeitstag vieles zu erzaehlen. " );

  AddItem( NPC "holzfeuer" , REFRESH_DESTRUCT);

  AddExit( "westen", "./room-b2" );
  AddExit( "osten",  "./room-d2" );
  AddExit( "sueden", "./room-c3" );

  AddSound( DEFAULT_SOUND,
    "Das Feuer verbreitet ein leises Knistern. " );

  AddSound( ({ "feuer" , "knistern" }),
    "Die Flammen nagen immer weiter an den Holzscheiten und knistern dabei leise. " );

  AddSmell( DEFAULT_SMELL,
    "Du nimmst den sanften Duft einer Suppe aus dem Sueden wahr." );

  AddSmell( ({ "duft" , "suppe" }),
    "Der Geruch kommt aus dem Sueden. Er kitzelt verzueckt in Deiner Nase.");

  AddCmd( ({ "lege" , "leg" }) ,"legen");
  AddCmd( ({ "setz","sitz","setze" }),"setzen");
}

int legen(string str) {
  int temp;
  notify_fail( "Lege WAS wohin ?\n" );
  if ( str == "scheit nach" || str == "holzscheit nach"
   || str == "scheit in feuer" || str == "holzscheit in feuer" ) {
    if (nachlegen-- > 0) {
      write( "Du legst einen Holzscheit nach. Es wird deutlich waermer hier.\n" );
      say(CAP_TPN+" legt einen Holzschneit in das Feuer. "
                + "Es wird deutlich waermer.\n" );
      temp=QueryProp(P_ENVIRONMENT)[ENV_TEMPERATURE]+3+random(3);
      SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: temp]) );
      return 1;
    } else {
      write("Leider ist im Moment kein Holzscheit mehr greifbar.\n");
      return 1;
    }
  }
  return 0;
}

int setzen(string str) {
  notify_fail( "Auf was moechtest Du Dich setzen ?\n" );
  if ( str == "auf baumstumpf" || str == "baumstumpf" ) {
    write( BS("Du machst es Dir kurz auf einem der Baumstuempfe gemuetlich, "
           "aber Dein Tatendrang zwingt Dich wieder aufzustehen." ));
    say(CAP_TPN+" macht es sich kurz auf einem der Baumstuempfe gemuetlich.\n" );
    return 1;
  }
  return 0;
}
