
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int found;

reset() {
  ::reset();
  found=0;
}

create()
{
  ::create();

  found=0;

  SetProp( P_INT_SHORT, "Ein Saegewerk" );
  SetProp( P_INT_LONG,
    "Du betrittst das riesige Saegewerk des Holzfaellerlagers. Ganz genau "
    "getrennt liegen hier ein grosser Baumstapel und ein kleinerer Holzstapel. "
    "In der Mitte des Saegewerkes befindet sich eine grosse Saege, die durch "
    "ein kleines Windrad auf dem Dach des Hauses angetrieben wird. Sowohl auf "
    "dem Boden liegend, als auch in der Luft wirbelnd, befindet sich viel "
    "Spaene." );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({ "saegewerk" , "raum" , "werk" , "haus" }),
    "Ganz genau "
    "getrennt liegen hier ein grosser Baumstapel und ein kleinerer Holzstapel. "
    "In der Mitte des Saegewerkes befindet sich eine grosse Saege, die durch "
    "ein kleines Windrad auf dem Dach des Hauses angetrieben wird. Sowohl auf "
    "dem Boden liegend, als auch in der Luft wirbelnd, befinden sich viel "
    "Spaene. " );

  AddDetail( ({ "wand" , "waende" , "seiten" }),
    "Es gibt hier nur eine Wand im Norden. Die restlichen Seiten sind offen "
    "gehalten und das Dach wird dort von dicken Pfosten gehalten." );

  AddDetail( ({ "wand" , "werkzeuge" , "werzeug" , "nordwand" }),
    "An der Nordwand haengen diverse Werkzeuge, die ein Tischlermeister fuer seine "
    "Arbeit so braucht." );

  AddDetail( ({ "tischlermeister" , "meister" }),
    "Sawer ist ein Tischlermeister." );

  AddDetail( ({ "arbeit" }),
    "Die Arbeit eines Tischlermeisters beinhaltet viel mehr, als viele denken." );

  AddDetail( ({ "boden" , "fussboden" }),
    "Einen richtigen Fussboden gibt es hier nicht. Nur blanke Erde. Viele "
    "Spaene liegen ueberall auf dem Boden verteilt." );

  AddDetail( ({ "erde" , "mutterboden" }),
    "Ganz normaler Mutterboden." );

  AddDetail( ({ "decke" }),
    "Durch ein riesiges Loch in der Decke kommt eine dicke Welle herunter. " );

  AddDetail( ({ "loch" }),
    "Das Loch ist gerade gross genug, dass die Welle hindurchpasst. Du kommst "
    "da sicher nicht durch." );

  AddDetail( ({ "welle" }),
    "Die Welle dreht sich langsam im Kreis und wird von dem Windrad auf dem "
    "Dach angetrieben. Sie fuehrt die Drehbewegung vom Windrad zur Saege." );

  AddDetail( ({ "drehbewegung" , "bewegung" , "kreis" }),
    "Monoton dreht sich die Welle im Kreis. Dir wird fast schwindlig davon." );

  AddDetail( ({ "luft" }),
    "Durch die Luft wirbelt jede Menge von Spaenen. Du hast ein paar "
    "Schwierigkeiten, hier zu atmen. Dem Tischlermeister scheint das aber wenig "
    "auszumachen. Er ist es wohl gewohnt." );

  AddDetail( ({ "schwierigkeiten" }),
    "Derzeit befindest Du Dich in keinen. Wenn Du welche willst, dann geh "
    "zu Oswin und hau ihm eine runter." );

  AddDetail( ({ "oswin" , "aufpasser" }),
    "Oswin ist der Aufpasser im Lager. Er ist \"sehr\" stark, also sei vorsichtig." );

  AddDetail( ({ "spaene" }),
    "Die Spaene stammen von der Saege und wirbeln ueberall in der Luft herum. "
    "Eine grosse Menge liegt auch auf dem Boden. Niemand scheint es fuer "
    "noetig zu halten, sie zu entfernen." );

  AddDetail( ({ "menge" }),
    "Du versuchst gar nicht erst, die alle zu zaehlen. Dann waerst Du wohl "
    "steinalt, wenn Du fertig damit bist." );

  AddDetail( ({ "bauwerk" , "bedeutung", "wort" , "schluss" }),
    "Du gruebelst ein wenig ueber die Bedeutung des Wortes \"Bauwerk\" nach "
    "und kommst zu dem Schluss, dass das Saegewerk eines ist." );

  AddDetail( ({ "mitte" }),
    "In der Mitte des Saegewerkes steht eine sehr grosse Saege." );

  AddDetail( ({ "saege" }),
    "Solch eine unglaublich grosse Saege hast Du noch nie in Deinem Leben "
    "vorher gesehen. Sie hat ein gewaltig grosses Saegeblatt, dem sicher kein "
    "Stamm dieser Welt standhalten kann. Angetrieben wird die Saege durch "
    "ein kleines Windrad." );

  AddDetail( ({ "stamm" , "staemme" }),
    "Auch die Staemme der dicksten Baeume koennte man hier spalten." );

  AddDetail( ({ "leben" }),
    "Noch lebst Du. Pass auf, dass Du nicht in die Saege geraetst." );

  AddDetail( ({ "blatt" , "saegeblatt" }),
    "Das Saegeblatt wird mit einer kleinen Vorrichtung immer wieder hin und "
    "her bewegt, um aus den Baeumen gebrauchsfertige Bretter zu machen. " );

  AddDetail( ({ "vorrichtung" , "fuehrung" }),
    "Die Vorrichtung dient einzig und alleine der genauen Fuehrung des "
    "Saegeblattes." );

  AddDetail( ({ "welt" , "silberland" , "land" }),
    "Unsere Welt nennt sich SilberLand. Hoffentlich gefaellt es Dir hier so "
    "gut wie allen anderen auch. :-)" );

  AddDetail( ({ "windrad" , "rad" }),
    "Das Windrad auf dem Dach wird durch den immer vorhandenen Wind angetrieben. "
    "Kein Mensch waere in der Lage, eine solche Kraft wie der Wind aufzubringen. ");

  AddDetail( ({ "mensch" , "zwerg" }),
    "Sehr starke Zwerge vielleicht, aber sicher kein Mensch." );

  AddDetail( ({ "lage" }),
    "Ob Du jemals in diese Lage kommst ein Windrad zu ersetzen ? Du denkst "
    "nicht weiter darueber nach." );

  AddDetail( ({ "kraft" }),
    "Du fuehlst Dich zwar kraeftig, bist es aber nicht." );

  AddDetail( ({ "wind" }),
    "Der Wind treibt das Windrad an und saeuselt Dir leise um die Ohren." );

  AddDetail( ({ "ohren" , "ohr" }),
    "Du schreist laut auf, als Du Dir selber ins Ohr pickst." );

  AddDetail( ({ "dach" }),
    "Auf dem Dach des Saegewerkes ist ein kleines Windrad befestigt. Einen "
    "Zugang zum Dach kannst Du von hier aus nicht sehen." );

  AddDetail( ({ "zugang" }),
    "Du suchst und suchst. Auf einmal faellt Dir eine kleine Leiter auf." );

  AddDetail( ({ "leiter" }),
    "Sie fuehrt wohl auf das Dach des Saegewerkes." );

  AddDetail( ({ "Holzstapel" }),
    "Dutzende von Brettern liegen hier fein saeuberlich aufgestapelt herum. "
    "Allerdings faellt Dir eine kleine Besonderheit an den Brettern auf. " );

  AddDetail( ({ "bretter" }),
    "Die Bretter werden mit Hilfe der grossen Saege aus den Baeumen hergestellt." );

  AddDetail( ({ "besonderheit" }),
    "Die Bretter sind wohl minderer Qualitaet. Denn die guten bringt Sawer "
    "immer gleich in die Lagerverwaltung, damit sie dort gleich verkauft "
    "werden koennen." );

  AddDetail( ({ "qualitaet" }),
    "Die Qualitaet der Hoelzer hier laesst echt zu wuenschen uebrig. "
    "Sie scheinen einfach nur nutzlose Reste zu sein." );

  AddDetail( ({ "reste" , "verwendung" }),
    "Irgendeine Verwendung wird man schon finden. Du aber sicher nicht." );

  AddDetail( ({ "holzfaellerlager" , "lager" }),
    "Das Saegewerk ist das groesste Bauwerk im Lager. Es verbindet das "
    "Abholzgebiet mit der Lagerverwaltung. " );

  AddDetail( ({ "abholzgebiet" , "gebiet" }),
    "Da musst Du mal mehr im Suedwesten nachsehen." );

  AddDetail( ({ "lagerverwaltung" , "verwaltung" }),
    "Die liegt weiter im Osten. Schau doch mal rein, wenn Du magst. "
    "Ueber dem Eingang im Osten ist ein kleines Schild angebracht. " );

  AddDetail( ({ "eingang" , "tuer" , "personaleingang" }),
    "Der Eingang im Osten besteht aus einer kleinen Tuer, die offen ist." );

  AddDetail( ({ "schild" , "vorteil" }),
    "Wer lesen kann, ist klar im Vorteil." );

  AddReadDetail( ({ "schild" }),
    "- Personaleingang -" );

  AddDetail( ({ "stapel" }),
    "Welchen Stapel meinst Du ?" );

  AddDetail( ({ "baumstapel" }),
    "Vom Baumstapel nimmt der Tischler immer die Baeume und bereitet sie "
    "dann mit Hilfe der grossen Saege zum Verkauf vor. Alle moeglichen "
    "Groessen liegen hier." );

  AddDetail( ({ "baeume" }),
    "Die stammen sicherlich aus dem Abholzgebiet." );

  AddDetail( ({ "hilfe" }),
    "Du rufst: Hilfe, ich untersuche \"Hilfe\"." );

  AddDetail( ({ "verkauf" }),
    "Verkauft werden die fertigen Hoelzer in der Lagerverwaltung. Die liegt "
    "uebrigens im Osten." );

  AddDetail( ({ "groessen" , "groesse" }),
    "Kleine, grosse, mittlere, riesige, mini - Baeume liegen hier rum." );

  AddDetail( ({ "hoelzer" }),
    "Die fertigen Hoelzer sind wirklich einzigartig. Jedermann im Silberland "
    "bestellt sie hier." );

  AddDetail( ({ "tischler" , "pause" }),
    "Der macht wohl gerade Pause. Sowas aber auch ..." );

  AddDetail( ({ "pfosten" }),
    "Die Pfosten bestehen aus sehr dicken Hoelzern und halten das Dach. "
    "Am suedoestlichen Pfosten faellt Dir etwas auf." );

  AddItem( NPC "gehilfe" , REFRESH_DESTRUCT);
  AddItem( NPC "sawer" , REFRESH_DESTRUCT);

  AddExit( "osten",      "./room-d1" );
  AddExit( "suedosten",  "./room-d2" );
  AddExit( "suedwesten", "./room-b2" );

  AddSound( DEFAULT_SOUND,
    "Die Saege macht einen unglaublichen Laerm. " );

  AddSound( ({ "saege" , "laerm" }),
    "Der Laerm der Saege ist kaum auszuhalten. Nur mit einem Ohrenschutz sollte "
    "man sich hier laenger aufhalten." );

  AddSmell( DEFAULT_SMELL,
    "Du riechst verbrannte Spaene." );

  AddSmell( ({ "spaene" }),
    "Durch das schnelle Saegen verbrennen die Spaene fast. Sie riecht wirklich "
    "stark verbrannt." );

  AddCmd( ({"kletter","klettere"}),"klettern");
  
  AddSpecialDetail( ({ "suedoestlicher pfosten","suedoestlichen pfosten" }),
                       "schaue_pfosten");

}

int klettern( string str ) {
  notify_fail( "Wo moechtest Du klettern ?\n" );
  if ( str == "auf dach" || str == "auf leiter" ) {
    write( "Du kletterst die Leiter rauf.\n" );
    TP->move(ROOM "room-c0" , M_GO, 0,
      "klettert eine Leiter rauf", "kommt heraufgeklettert");
    return 1;
  }
  return 0;
}

string schaue_pfosten( string str ) {
  if (found==0) {
    say(CAP_TPN+" schaut sich einen Pfosten genauer an.\n" );
    found=1;
    CLONE(OBJ "zettel4",TP);
    return "Du schaust Dir den Pfosten genauer an und findest einen kleinen Zettel, "
           "den Du sofort einsteckst.\n" ;
  } else {
    say(CAP_TPN+" schaut sich einen Pfosten genauer an.\n" );
    return "Du schaust Dir den Pfosten genauer an, doch findest leider nichts.\n" ;
  }
}

