
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>

int found;

reset() {
  ::reset();
  found=0;
}

create()
{
  ::create();

  found=0;

  SetProp( P_INT_SHORT, "Eine gemuetliche Kueche" );
  SetProp( P_INT_LONG,
    "Du befindest Dich jetzt in einer kleinen, aber sehr gemuetlichen Kueche. "
    "Eine kleine Sitzecke mit Stuehlen steht direkt neben dem kleinen Herd, "
    "der einzig und allein von Alwinja benutzt wird. In einem kleinen "
    "Schraenkchen an der Wand sind alle notwendigen Dinge, die man in einer "
    "solchen Kueche benoetigt. Durch zwei kleine Fenster draengen "
    "Sonnenstrahlen auf den Fussboden." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({ "licht" }),
    "Das Licht scheint von draussen herein und erhellt die Kueche. Es reicht "
    "locker aus, damit man hier vernuenftig arbeiten kann." );

  AddDetail( ({ "schraenkchen" }),
    "In dem kleinen, weissen Schraenkchen sind alle notwendigen Dinge "
    "untergebracht, die man so in einer Kueche braucht. " );

  AddDetail( ({ "dinge" , "loeffel" , "messer" , "gabeln" , "geschirr" }),
    "Loeffel, Messer, Gabeln, Geschirr und vieles, vieles mehr ist in dem "
    "Schraenkchen drin, damit man auch wirklich jeden Wunsch der "
    "Holzfaeller erfuellen kann." );

  AddDetail( ({ "vieles" , "detail" }),
    "Nanu, wie kommt denn dieses Detail hier rein ?" );

  AddDetail( ({ "wunsch" , "glueck" }),
    "Vielleicht solltest Du jemandem mal etwas Glueck wuenschen." );

  AddDetail( ({ "decke" }),
    "An der Decke ist erstaunlicherweise keine Lampe. Das Licht in der Kueche "
    "kommt wohl ganz allein von ausserhalb." );

  AddDetail( ({ "lampe" }),
    "Was nicht da ist, sollte man auch nicht untersuchen .." );

  AddDetail( ({ "waende" , "wand" }),
    "Ein kleines Schraenkchen haengt an einer Wand. Alwinja hat die Waende "
    "mit einer gelben Tapete verziert, damit der Raum nicht ganz so "
    "trist wirkt." );

  AddDetail( ({ "tapete" }),
    "Auf der Tapete sieht man ein paar Holzfaeller, wie sie ihre taegliche "
    "Mahlzeit zu sich nehmen." );

  AddDetail( ({ "kueche" , "raum" }),
    "Eine kleine Sitzecke mit Stuehlen steht direkt neben dem kleinen Herd, "
    "der einzig und allein von Alwinja benutzt wird. In einem kleinen "
    "Schraenkchen an der Wand sind alle notwendigen Dinge, die man in einer "
    "solchen Kueche benoetigt. Durch zwei kleine Fenster draengen "
    "Sonnenstrahlen auf den Fussboden." );

  AddDetail( ({ "sitzecke" , "ecken" , "ecke" }),
    "In einer der Ecken des Raumes steht eine kleine Holzbank mit drei Stuehlen "
    "daneben. Alles schart sich um einem kleinen Holztisch." );

  AddDetail( ({ "holzbank" , "bank" }),
    "Eine schlichte Holzbank, auf der sich es die Holzfaeller bequem "
    "machen, wenn sie ihre taegliche Mahlzeit zu sich nehmen." );

  AddDetail( ({ "holzfaeller" , "faeller" }),
    "Niemand geniesst im Moment die koestliche Suppe von Alwinja." );

  AddDetail( ({ "stuehle" , "stuhl" }),
    "Es sind genug Stuehle frei, Du kannst Dich ruhig setzen." );

  AddDetail( ({ "holztisch" , "tisch" }),
    "Der Tisch ist mit einer kleinen Tischdecke bedeckt. Ansonsten besteht der "
    "Tisch zu hundert Prozent aus dem Holz, das hier im Holzfaellerlager "
    "abgebaut wird." );

  AddDetail( ({ "tischdecke" }),
    "Die Tischdecke hat ein suesses Karomuster und besteht aus Stoff." );

  AddDetail( ({ "karomuster" , "muster" }),
    "Ein ganz normales Muster. Echt nichts Besonderes." );

  AddDetail( ({ "stoff" }),
    "Wahrlich nicht der Stoff, aus dem die Traeume sind." );

  AddDetail( ({ "traeume" , "traum" }),
    "Wenn Du traeumen moechtest, dann geh doch einfach mal nach Sueden." );

  AddDetail( ({ "suppe","liebsten" }),
    "Die Suppe riecht einfach hervorragend. Du moechtest sie am Liebsten "
    "sofort probieren. Dazu musst Du aber Alwinja fragen." );

  AddDetail( ({ "mahlzeit" }),
    "Als staerkende Mahlzeit gibt es hier die Suppe von Alwinja. Sie staerkt "
    "die Holzfaeller tagein, tagaus. Man sagt nicht umsonst, dass die Suppe "
    "die kraeftigste Suppe im ganzen SilberLand ist." );

  AddDetail( ({ "holzfaellerlager" , "lager" }),
    "Zur Zeit bist Du wohl im gemuetlichsten Teil des Lagers, naemlich in "
    "der Kueche von Alwinja." );

  AddDetail( ({ "zeit" }),
    "Du denkst . o O ( Ups, schon wieder so spaet ? )" );

  AddDetail( ({ "teil" }),
    "Ein Teil ist nicht viel, aber immerhin etwas." );

  AddDetail( ({ "holz" }),
    "Alle Dinge hier sind aus dem Holz, das hier abgebaut wird. Das Holz "
    "ist fast einzigartig gut fuer solche Dinge zu gebrauchen. Es ist "
    "stabil und verrottet kaum." );

  AddDetail( ({ "moment" }),
    "Moment mal, da ist doch was unter dem Tisch." );

  AddDetail( ({ "prozent" }),
    "Ja wirklich, einhundert prozentig !!");

  AddDetail( ({ "silberland" , "land" }),
    "Das ist das Land, in dem Du Dich befindest. Das solltest Du schon wissen. "
    "Schaem Dich !!!" );

  AddDetail( ({ "fenster" }),
    "Die Fenster sind aus ganz normalen Holz gefertigt. Sie haben sehr saubere "
    "Scheiben." );

  AddDetail( ({ "scheiben" , "sauberkeit" }),
    "Alwinja sorgt wohl fuer sehr viel Sauberkeit in ihrer Kueche." );

  AddDetail( ({ "herd" }),
    "Auf dem Herd brodelt in einem riesigem Kochtopf die legendaere Suppe "
    "von Alwinja. Ein kleines Feuer im Herd erhitzt den Kochtopf." );

  AddDetail( ({ "feuer" }),
    "Das Feuer lodert leise vor sich hin und erhitzt die Suppe auf genau "
    "die richtige Temperatur." );

  AddDetail( ({ "temperatur" }),
    "Es ist hier angenehm warm, aber auch nicht zu warm. Die Suppe dagegen "
    "ist schon recht heiss. Man sollte sie nicht einfach so trinken, sondern "
    "ganz langsam schluerfen." );

  AddDetail( ({ "kochtopf" , "topf" }),
    "Im staehlernen Kochtopf bereitet Alwinja die Suppe zu." );

  AddDetail( ({ "sonnenstrahlen" , "strahlen" }),
    "Die wenigen Sonnenstrahlen gelangen durch die Fenster auf den Boden und "
    "verursachen dort ein witziges Farbenmeer." );

  AddDetail( ({ "farbenmeer" , "farbenspiel" }),
    "Es ist recht lustig, den Sonnenstrahlen bei ihrem Farbenspiel zuzusehen. " );

  AddDetail( ({ "alwinja" }),
    "Nanu, sie ist wohl gerade nicht da." );

  AddDetail( ({ "fussboden" , "boden" , "marmor" , "untergrund" }),
    "Fester Marmor bietet in der Kueche einen guten Untergrund. Ein paar "
    "Sonnenstrahlen tanzen auf dem Marmor und faszinieren Dich." );

  AddItem( NPC "alwinja" , REFRESH_DESTRUCT);

  AddExit( "norden", "./room-c2" );
  AddExit( "sueden", "./room-c4" );

  AddSound( DEFAULT_SOUND,
    "Die Suppe brodelt leise im Kochtopf vor sich hin. " );

  AddSmell( DEFAULT_SMELL,
    "Diese Suppe riecht einfach nur hervorragend und der Geruch verteilt "
    "sich in der ganzen Kueche." );

  AddSmell( ({ "suppe" }),
    "Hmmmm, riecht diese Suppe gut. Am Liebsten moechtest Du sie sofort "
    "probieren. Dir laeuft das Wasser im Munde zusammen.");

  AddCmd( ({ "wuensch" , "wuensche" }) , "wuenschen" );
  AddCmd( ({ "setz" , "setze" }) , "setzen" );

  AddSpecialDetail("unter tisch","schaue_tisch");
}

int wuenschen(string str) {
  mixed ob;
  string wem;
  notify_fail( "WEM moechtest Du WAS wuenschen ?\n" );
  if (!str) { return 0; }
  if (sscanf(str,"%s glueck", wem) == 1) {
    ob=find_player(wem) || match_living(wem);
    if (stringp(ob)) ob=find_player(ob);
    if (objectp(ob) && !IS_WIZARD(TP) && ob->QueryProp(P_INVIS)) ob=0;
    if (!objectp(ob)) {
      if (ob==-1) {
        write("Hm, seltsame Angabe!\n");
        return 1;
      } else {
        write("Kein solcher Spieler!\n");
        return 1;
      }
    }
    if (ob==TP) {
      write("Ohoh, sich selber Glueck wuenschen ???\n");
      return 1;
    }
    write("Du wuenscht "+capitalize(wem)+" viel Glueck aus der Ferne.\n");
    tell_object(ob, CAP_TPN + " wuenscht Dir viel Glueck aus der Ferne !\n");
    return 1;
  }
  return 0;
}

int setzen(string str) {
  notify_fail("Wohin moechtest Du Dich setzen ?\n");
  if( str == "auf stuhl" || str == "stuhl" || str == "auf den stuhl") {  
    if(present("\nstuhl", TP)) {
      write("Du sitzt doch schon auf einem Stuhl.\n");
      return 1;
    }
    write("Du setzt Dich auf einen der freien Stuehle.\n" );
    say(CAP_TPN +" macht es sich auf einem der Stuehle gemuetlich.\n" );
    CLONE( OBJ "stuhl" ,TP);
    return 1;
  }
  return 0;
}

string schaue_tisch( string str ) {
  if (found==0) {
    say(CAP_TPN+" schaut unter den Tisch und findet etwas.\n" );
    found=1;
    CLONE( OBJ "zettel2",TP);
    return BS(
      "Du schaust unter den Tisch und findest einen kleinen Zettel, den "
      "Du sofort einsteckst.");
  } else if (found==1) {
    found=2;
    "/obj/gemmaster"->DistributeGem(1, 1, 0, TP);
    return BS(
      "Du schaust unter den Tisch und findest einen Edelstein, den Du "
      "Dir sofort einverleibst.");
  } else {
    say(CAP_TPN+" schaut unter den Tisch.\n" );
    return "Du schaust unter den Tisch doch findest leider nichts.\n" ;
  }
}

