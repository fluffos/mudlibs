  AddDetail( ({ "ausbeulung" , "unebenheit" }), "KEINE." );

  AddDetail( ({ "verkaufsoeffnung" , "oeffnung" }),
    "Die Oeffnung im Sueden dient dem Verkauf der fertigen Hoelzer. Hier im "
