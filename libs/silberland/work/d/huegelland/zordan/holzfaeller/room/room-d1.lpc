    "die Lagerverwaltung sie sofort verkaufen kann." );

  AddDetail( ({ "sawer" , "tischlermeister" }),
    "Sawer ist der Tischlermeister im Holzfaellerlager. Er bringt die fertigen "
    "Hoelzer hier herein." );

  AddDetail( ({ "holzfaellerlager" , "lager" }),
    "Hinsichtlich der stattlichen Ausstattung dieses Raumes nimmst Du an, "
    "dass Du Dich im Heiligtum des Lagers befindest." );

  AddDetail( ({ "ausstattung" }),
    "Die Ausstattung besteht aus diversen Kerzenstaendern, einem grossen "
    "Schreibtisch, wertvollen Bildern und Ausstellungsstuecken. Der Rest "
    "ist fuer Dich eher uninteressant." );

  AddDetail( ({ "heiligtum" , "streit" }),
    "Hier wuerdest Du niemals Streit anfangen. So gut erzogen bist Du "
    "naemlich auch wieder." );

  AddDetail( ({ "rest" , "gold" }),
    "Dem Lager muss es wirklich gut gehen, denn auch der Rest hier ist "
    "aus Gold oder anderen wertvollen Materialien gemacht." );

  AddDetail( ({ "material" , "materialien" }),
    "Na Edelsteine, Seide, wertvolles Holz uswusf." );

  AddDetail( ({ "edelsteine" , "edelstein" }),
    "Wertvolle Diamanten, Rubine und Saphire schmuecken die "
    "Ausstattung. Aber sie sind so fest angebracht, dass Du schon die Kraft "
    "von 10 Zwergen braeuchtest, um sie herauszubekommen." );

  AddDetail( ({ "diamanten" , "rubine" , "saphire" }),
    "Das alles sind sehr wertvolle Edelsteine. Sie glitzern hell und erzeugen "
    "einen Hauch von Vertraeumtheit in dem Raum." );

  AddDetail( ({ "hauch" , "vertraeumtheit" }),
    "Die bist ganz hin und weg." );

  AddDetail( ({ "zergen" , "zwerg" , "kraft" , "wesen" , "abstand" , "zwerg" }),
    "Zwerge sind starke Wesen." );

  AddDetail( ({ "seide" }),
    "Die Vorhaenge, der Teppich und die Tapete bestehen aus reinster Seide." );

  AddDetail( ({ "vorhaenge" , "vorhang" }),
    "An den Fensterrahmen sind wertvolle Vorhaenge aus Seide. Sie sind leicht "
    "zurueckgeschlagen, so dass der Raum hell genug ist." );

  AddDetail( ({ "fensterrahmen" , "rahmen" }),
    "Zierliche Fensterrahmen sind in der Nord- und Ostwand eingelassen." );

  AddDetail( ({ "nordwand" , "ostwand" , "licht" , "fenster" }),
    "Zwei Fenster sorgen fuer mehr Licht in diesem Raum." );

  AddDetail( ({ "teppich" , "art" }),
    "Der Teppich, auf dem Du stehst, ist tatsaechlich auch aus Seide. Sowas "
    "in der Art hast Du noch nie gesehen. Welch einen Luxus man sich hier "
    "bloss leisten kann." );

  AddDetail( ({ "luxus" , "schluss" }),
    "Der viele Luxus hier laesst nur einen Schluss zu: Das Lager ist reich." );

  AddDetail( ({ "kerzenstaender", "staender" }),
    "Die Kerzenstaender stehen guenstig verteilt ueberall im Raum herum. "
    "Sie sind wertvoll mit Edelsteinen verziert und enthalten Kerzen in "
    "jeglicher Farbe." );

  AddDetail( ({ "kerzen" }),
    "Die Kerzen sind irgendwie komisch. Als Du sie genauer untersuchst stellst "
    "Du fest, dass kein Wachs zu verschwinden scheint." );

  AddDetail( ({ "wachs" }),
    "Da die Kerzen kein Wachs verbrauchen bist Du Dir sicher, die Kerzen "
    "sind mit Sicherheit magisch und brennen niemals ab." );

  AddDetail( ({ "sicherheit" }),
    "Mit Sicherheit kann man nur sagen, dass Oswin ueber die Sicherheit im "
    "Lager wacht." );

  AddDetail( ({ "oswin" , "aufpasser" }),
    "Oswin ist der Aufpasser im Lager. Leg Dich bloss nicht mit ihm an !" );

  AddDetail( ({ "farbe" , "farben" , "spektrum" }),
    "Die Farben der Kerzen ueberstrecken sich ueber das gesamte Spektrum." );

  AddDetail( ({ "arten" }),
    "Die Arten unterscheiden sich doch ziemlich voneinander." );

  AddDetail( ({ "holz" }),
    "Zwei Arten von Holz kannst Du erkennen. Einmal das wirklich wertvolle und "
    "unglaublich gut verarbeitete der Ausstattung und einmal die normalen "
    "Hoelzer bei der Verkaufsoeffnung." );

  AddDetail( ({ "hoelzer" }),
    "Die Hoelzer dienen dem Verkauf. Wenn Du welche erwerben moechtest, fuer "
    "Dein Seherhaus zum Beispiel, dann wende Dich an den Lagerverwalter." );

  AddDetail( ({ "seherhaus" }),
    "Wenn Du eines bauen moechtest, brauchst Du sicher auch Holz. Und das "
    "beziehst Du sehr wahrscheinlich von hier." );

  AddDetail( ({ "beispiel" , "fallen" , "falle" }),
    "Zum Beispiel koennte ich Dich jetzt umbringen. Da ich solche Fallen aber "
    "nicht mag, lassen wir das einfach mal ..." );

  AddDetail( ({ "kleines bild" }),
    "Auf dem kleinen Bild ist der Mann hinter dem Schreibtisch gezeichnet "
    "worden. Komisch, jetzt auf einmal faellt Dir ein kleines Scharnier "
    "neben dem kleinen Bild auf." );

  AddDetail( ({ "scharnier" }),
    "Evtl. ist hinter dem Bild etwas versteckt? Bestimmt bekommt man das "
    "kleine Bild irgendwie davor weg." );

  AddDetail( ({ "zwergenstahl" }),
    "Der Tresor besteht aus feinstem und haertestem Zwergenstahl." );

  AddExit( "westen", "./room-c1" );

  AddSound( DEFAULT_SOUND,
    "Leise rascheln die Muenzen in der Hand des Verwalters. " );

  AddSound( ({ "muenzen" }),
    "Die Muenzen klimpern gegeneinander, waehrend der Verwalter sie zaehlt. " );

  AddSmell( DEFAULT_SMELL,
    "Eigentlich riecht es hier nach nichts. Nur eine winzige Spur von "
    "Lavendel kannst du wahrnehmen." );

  AddSmell( ({ "spur" , "lavendel" , "lavendelduft" }),
    "Der feine Lavendelduft erfuellt den Raum und verschafft ihm damit "
    "ein noch luxurioeseres Ambiente." );

  AddCmd( ({ "klappe","klapp" }) , "klappe_bild" );
  AddCmd( ({ "stelle","stell" }) , "stelle_ein" );
  AddCmd( ({ "drehe","dreh" }) , "dreh_hebel" );

}

int klappe_bild(string str) {
  notify_fail( "Was moechtest Du beiseite klappen?\n" );
  if ( str == "kleines bild beiseite" ) {
    if (geklappt==0) {
      write( "Du klappst das kleine Bild beiseite. Ein Tresor kommt zum Vorschein.\n" );
      say(TP->Name(WER,2) + " klappt das kleine Bild beiseite.\n" );
      AddDetail( ({"tresor", "vorderseite"}),
        "Ein winziger Tresor aus Zwergenstahl hat sich also hinter dem kleinen "
        "Bild versteckt. Ein kleiner Hebel und ein Zahlenschloss befinden sich "
        "auf der Vorderseite." );
      AddDetail( "hebel",
        "Den kann man sicher drehen. Und wenn das Zahlenschloss richtig "
        "eingestellt ist, dann oeffnet sich der Tresor auch bestimmt. " );
      AddDetail( "zahlenschloss",
        "Mit dem Zahlenschloss kann man vier Zahlen einstellen. Sie muessen "
        "natuerlich die richtigen sein, damit sich der Tresor oeffnen laesst." );
      AddSpecialDetail( "zahlen","zahlenfkt" );
      geklappt=1;
      return 1;
    } else {
      write( "Aber das kleine Bild ist doch schon beiseite geklappt worden.\n" );
      return 1;
    }
  }
  return 0;
}

int stelle_ein(string str) {
  int pos;
  int was;
  int temp;
  if (geklappt==0) { return 0; }
  notify_fail( "Welche Position moechtest Du auf was einstellen?\n" );
  if (!str) { return 0; }
  if (sscanf(str,"%d auf %d", pos, was) == 2) {
    if ((pos<1) || (pos>4)) {
      notify_fail( "Solch eine Position gibt es nicht (1-4) !\n" );
      return 0;
    }
    if ((was<0) || (was>99)) {
      notify_fail( "Diese Einstellung macht keinen Sinn !\n" );
      return 0;
    }
    temp=call_other(TRESORMASTER,"Get_Code",pos);
    write ("Du stellst die Position "+pos+" auf "+was+" .\n");
    aktuell[pos]=was;
    if (temp==was) { code[pos]=1; }
    return 1;
  }
  return 0;
}

int dreh_hebel(string str) {
  int i;
  if (geklappt==0) { return 0; }
  if ((str == "hebel") || (str == "den hebel")) {
    for( i=1 ; i<5 ; i++ ) {  
      if (code[i] != 1) { 
        write("Hm, diese Kombination scheint wohl nicht zu stimmen.\n");
        return 0;
      }
    }
    call_other(TRESORMASTER,"New_Code");
    i=call_other(TRESORMASTER,"Remove_Money");
    geklappt=0;
    code=({ 0,0,0,0,0 });
    aktuell=({ 0,0,0,0,0 });
    write_file(LOG "tresor.log",
      ctime()+": "+CAP(getuid(PL))+" hat "+i+" Muenzen aus dem Tresor bekommen.\n");

    if (i>0) { TP->AddMoney(i); }
    write(BS ("Du drehst den Hebel langsam gegen den Zeigersinn und siehe da, "
              "der Tresor laesst sich oeffnen. Du schaust hinein und siehst "
              "dort drinnen "+i+" Muenzen, die Du sofort einsteckst. Ausserdem "
              "findest Du ein paar Edelsteine, die Du auch mitnimmst. Du "
              "schliesst den Tresor wieder und hoerst ein komisches Klicken." ));
    "/obj/gemmaster"->DistributeGem(1, 3, 1, TP);
    "/obj/gemmaster"->DistributeGem(1, 3, 1, TP);
    return 1;
  }
  return 0;
}

string zahlenfkt(string str) {
  string temp;
  if (geklappt==0) { return 0; }
  temp=sprintf("Die Zahlen stehen im Moment auf: %2d - %2d - %2d - %2d.\n",
       aktuell[1],aktuell[2],aktuell[3],aktuell[4]);
  return temp;
}
