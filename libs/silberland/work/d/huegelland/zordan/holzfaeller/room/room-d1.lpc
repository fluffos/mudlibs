
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int geklappt;
int *code;
int *aktuell;

reset() {
  ::reset();
  geklappt=0;
  RemoveDetail("tresor");
  RemoveDetail("vorderseite");
  RemoveDetail("hebel");
  RemoveDetail("zahlenschloss");
  RemoveSpecialDetail("zahlen");
  code=({ 0,0,0,0,0 });
  aktuell=({ 0,0,0,0,0 });
  call_other(TRESORMASTER,"New_Code");
  Message("Der Tresor stellt sich auf eine neue Zahlenkombination ein.\n",
      MSGFLAG_VISUAL);
}

create()
{
  ::create();

  code=allocate(5);

  geklappt=0;
  code=({ 0,0,0,0,0 });
  aktuell=({ 0,0,0,0,0 });

  call_other(TRESORMASTER,"New_Code");

  SetProp( P_INT_SHORT, "Eine Lagerverwaltung" );
  SetProp( P_INT_LONG,
    "Durch den Personaleingang kommst Du in die kleine Lagerverwaltung. Ein "
    "paar Kerzenstaender und die grosse Verkaufsoeffnung im Sueden erhellen den "
    "Raum ausreichend. Hinter dem kleinen Schreibtisch in der Mitte sitzt ein "
    "kleiner Mann. An den Waenden sind diverse Bilder und ein paar "
    "Ausstellungsstuecke angebracht. " );

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN:TT_HOUSE]) );

  AddDetail( ({ "lagerverwaltung" , "verwaltung" , "raum" }),
    "Ein paar Kerzenstaender und die grosse Verkaufsoeffnung im Sueden erhellen den "
    "Raum ausreichend. Hinter dem kleinen Schreibtisch in der Mitte sitzt ein "
    "kleiner Mann. An den Waenden sind diverse Bilder und ein paar "
    "Ausstellungsstuecke angebracht." );

  AddDetail( ({ "decke" }),
    "Die ganze Decke besteht aus einem riesigen Holzstueck." );

  AddDetail( ({ "holzstueck" , "kunstwerk" }),
    "Das Holzstueck ist ein wahres Kunstwerk. Es besteht aus dem wertvollstem "
    "Holz und ist in jahrelanger Kleinarbeit geschnitzt worden." );

  AddDetail( ({ "kleinarbeit" , "jahre" }),
    "Du schaetzt, dass man fuer ein solches Kunstwerk mehrere Jahre braucht." );

  AddDetail( ({ "mann" , "besitzer" , "lagerverwalter" , "verwalter" }),
    "Der kleine Mann hinter dem Schreibtisch zaehlt sein Geld und regelt den "
    "ordnungsgemaessen Verkauf der fertigen Hoelzer. Er hat einen kleinen "
    "Bart und ist ziemlich aufwendig gekleidet. Mit seinem Auftreten stellt "
