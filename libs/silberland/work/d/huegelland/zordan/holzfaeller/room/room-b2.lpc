
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int found;

reset() {
  ::reset();
  found=0;
}

create()
{
  ::create();

  found=0;

  SetProp( P_INT_SHORT, "Eine Lagerstaette" );
  SetProp( P_INT_LONG,
    "Hier werden die gefaellten Baeume, die nicht direkt ins Saegewerk und "
    "somit in den Verkauf gehen, auf einem grossen Haufen gelagert. Im Westen, "
    "Norden und Sueden befindet sich das Abholzgebiet und im Osten eine "
    "kleine Feuerstelle. " );
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17, ENV_TERRAIN:TT_FOREST]) );

#include "standard.h"

  AddDetail( ({ "verkauf" }),
    "Wo genau der Verkauf stattfindet, kannst Du von hier aus nicht "
    "erkennen." );

  AddDetail( ({ "haufen" }),
    "Der Haufen ist nicht besonders gross. Aber er faellt Dir halt auf. Es "
    "sind alles Baeume, die man wohl nicht sofort verkaufen moechte. Aber "
    "wegwerfen moechte man sie wohl auch nicht, denn dazu ist Holz einfach "
    "zu kostbar. Ein Stamm schaut unter den anderen hervor." );

  AddDetail( ({ "saegewerk" }),
    "Das Saegewerk siehst Du riesig im Nordosten stehen. Wenn Du moechtest, "
    "kannst Du den Tischler dort ja mal besuchen." );

  AddDetail( ({ "tischler" }),
    "Der Tischler ist im Saegewerk. Du musst schon hingehen, um mehr zu "
    "erfahren." );

  AddDetail( ({ "abholzgebiet" , "gebiet" }),
    "Im Abholzgebiet schlagen die Holzfaeller die Baeume. Ein kleiner "
    "Gehilfe bringt sie dann mit einem kleinen Lastesel ins Saegewerk." );

  AddDetail( ({ "holzfaeller" }),
    "Die Holzfaeller sind alle im Abholzgebiet oder ruhen sich aus." );

  AddDetail( ({ "gehilfe" , "lastesel" }),
    "Der schwirrt hier irgendwo rum. Du kannst ihn ja mal suchen." );

  AddDetail( ({ "feuerstelle" }),
    "Die Feuerstelle ist weiter im Osten." );

  AddDetail( ({ "stamm" }),
    "Der Stamm schaut unter den anderen hervor. Vielleicht kann man ihn ja "
    "unter den anderen hervorziehen ?" );

  AddExit( "norden",    "./room-b1" );
  AddExit( "westen",    "./room-a2" );
  AddExit( "sueden",    "./room-b3" );
  AddExit( "osten",     "./room-c2" );
  AddExit( "nordosten", "./room-c1" );

  AddCmd( ({ "ziehe" , "zieh" }) , "ziehe_stamm" );

}

int ziehe_stamm( string str ) {
  notify_fail( "Was moechtest hervorziehen ?\n" );
  if ( str == "stamm hervor" ) {
    if (found==0) {
      write( "Du ziehst den Stamm hervor und findest einen kleinen Zettel, "+ 
             "den Du sofort einsteckst.\n" );
      say(CAP_TPN+" zieht einen Stamm hervor.\n" );
      found=1;
      CLONE(OBJ "zettel3" ,TP);
      return 1;
    } else {
      write( "Du ziehst den Stamm hervor doch findest leider nichts.\n" );
      say(CAP_TPN+" zieht einen Stamm hervor.\n" );
      return 1;
    }
  }
  return 0;
}
