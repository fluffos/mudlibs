/*
   Eine Wolljacke by Zordan@SL
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"jacke","wolljacke"}));
  SetProp (P_SHORT, "Eine leichte Wolljacke");
  SetProp (P_LONG,
    "Die Wolljacke behindert einen kaum bei der Arbeit." 
    "Sie ist wie geschaffen, um in einem Waldstueck haerterer Arbeit "
    "nachzugehen. Als Ruestung koennte man sie aber auch benutzen. " );
  SetProp (P_INFO,
    "Auch wenn die Jacke nur aus Wolle besteht, wird sie Dich kaum vor "
    "Kaelte schuetzen, da sie sehr offen ist. " );
  SetProp (P_NAME, "Wolljacke");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 800);
  SetProp (P_VALUE, 400);
  SetProp (P_MATERIAL, ([MAT_WOOL:100]) );
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 13);
}
