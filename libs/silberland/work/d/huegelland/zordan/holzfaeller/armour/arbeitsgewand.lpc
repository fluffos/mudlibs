/*
   Ein sehr leichtes Arbeitsgeand by Zordan@SL
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"gewand","arbeitsgewand"}));
  SetProp (P_SHORT, "Eine leichtes Arbeitsgewand");
  SetProp (P_LONG,
    "Dieses leichte Arbeitsgewand schuetzt eigentlich nur gegen die "
    "alltaeglichen Verunreinungungen, die an einem harten Arbeitstag "
    "entstehen. " );
  SetProp (P_NAME, "Arbeitsgewand");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 450);
  SetProp (P_VALUE, 200);
  SetProp (P_MATERIAL, ([MAT_WOOL:100]) );
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp (P_AC, 5);
}
