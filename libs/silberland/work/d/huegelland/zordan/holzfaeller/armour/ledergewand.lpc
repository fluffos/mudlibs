
/*
   Ein Ledergewand fuer Sawer Zordan@SL
*/

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <moredef.h>

create() {
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Ledergewand");
  SetProp(P_LONG,
    "Dieses Ledergwand schuetzt den Koerper vor kleineren Verletzungen, wie  "
    "etwa Holzsplittern. Darum wird es gerne von Handwerkern getragen. ");
  SetProp(P_INFO,
    "Dieses Gewand kann nur von einem Mann getragen werden. Es scheint auch "
    "so, als ob es ein wenig vor Feuer schuetzen kann. " );

  SetProp(P_NAME, "Ledergewand");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"gewand", "ledergewand"}) );

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 16 );
  SetProp(P_MATERIAL, MAT_LEATHER );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 600);
  SetProp(P_NOBUY, 0);
  SetProp( P_WEAR_RESTRICTIONS, ([P_GENDER:MALE]) );
 
  AddProp( P_DAM_PROTECTION, ([DT_FIRE:1]) );
}
