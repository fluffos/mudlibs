#include "../def.h"

inherit "std/room";

void create()
{
  if(!is_clone(ME)) return;  
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:35]));
    
  SetProp(P_INT_SHORT, "In einem Badehaus");
  SetProp(P_INT_LONG, 
	  "Du bist in der Umkleidekabine.\n");
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  AddDetail(({"jodelhue"}),
	    "Oh ja, jodelhue, auf jeden Fall.");

  //PO->CustomizeObject();
}

varargs string GetExits(object viewer)
{
  RemoveExit(0);
  AddExit("zurueck", ROOM "umkleide");
  
  return ::GetExits(viewer);
}

