#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]) );
  
  SetProp(P_INT_SHORT, "In einem Badehaus" );
  SetProp(P_INT_LONG, 
	  "Du bist irgendwo im Badehaus\n" );
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  AddDetail(({"jodelhue"}),
	    "Oh ja, jodelhue, auf jeden Fall.");
}

varargs string GetExits(object viewer)
{
  if(strlen(::GetExits(viewer)))
    return "Du kannst jederzeit in die 'Vorkammer' zurueck.\n";
  
  return "";
}
