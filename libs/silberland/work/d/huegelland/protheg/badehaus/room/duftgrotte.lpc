#include "../def.h"

//Standard-Raum fuers Badehaus
inherit ROOM "std_bath";

#define DUFTOEL ({"salbei","eukalyptus","wiesenblumen","kamille","vanille","rosmarin","walderdbeeren","kokosnuss","walnuss","rose","zimt","orange","pfefferminz","tanne","zitrone"})
#define AROMA ({"kadaver","menschenbraten","fleisch","blut","schlamm","moor","schweiss"})

nosave int last_aufguss;

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Eine Duftgrotte");

  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich hier in einer Duftgrotte. Die Waende bestehen "
	     "aus Felsgestein, im Boden ist ein Wasserbecken aus poliertem "
	     "Granit eingelassen. Aus einem kleinen Seitenbecken stroemt ein "
	     "angenehmer Duft in die Grotte."));
 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  
  AddDetail(({"grotte","duftgrotte"}),
	    QueryProp(P_INT_LONG));
  
  AddDetail(({"waende"}),
	    "Die Waende bestehen aus Felsgestein. An der Nordwand faellt Dir "
	    "etwas auf.");
  
  AddDetail(({"wand"}),
	    "Welche Wand meinst Du?");
  
  AddDetail(({"nordwand"}),
	    "Ein Wasserfall plaetschert die Nordwand herunter.");
  
  AddDetail(({"wasser", "wasserfall"}),
	    "Das Wasser plaetschert die Nordwand herunter und fliesst in das "
	    "Becken. Es ist wohlig warm.");
  
  AddDetail(({"waerme", "temperatur"}),
	    "Es ist wohlig warm hier drin.");
  
  AddDetail(({"felsgestein", "granit"}),
	    "Die Waende scheinen aus grobem Granit zu bestehen.");
  
  AddDetail(({"decke"}),
	    "Die Decke besteht, wie die Waende, aus grobem Granit.");
  
  AddDetail(({"boden", "fussboden"}),
	    "Der Fussboden ist, genau wie das Becken, anscheinend aus poliertem "
	    "Granit. Er strahlt eine Waerme aus, so dass Barfusslaufen hier sehr "
	    "angenehm ist");
  
  AddDetail(({"laufen","barfusslaufen"}),
	    "Tu es doch einfach...");
  
  AddDetail(({"becken", "wasserbecken"}),
	    "In dem Wasserbecken befindet sich angenehm temperiertes Wasser.");
  
  //Sounds beschreiben:
     
  AddSound(DEFAULT_SOUND, 
	   "Du hoerst das Plaetschern des Wasserfalles.\n");

  AddSound(({"plaetschern"}),
	   "Du lauschst verzueckt dem Plaetschern. Es macht Dich richtig "
	   "schlaefrig.");
  
  //Smells beschreiben:
  
  AddSmell(({"duft","grottenduft","duftgrotte",DEFAULT_SMELL}),
	   "Es riecht hier angenehm nach Salbei.\n");
  //evtl. als command mit unterschiedlichen Duftoelen?
  
  AddSmell(({"salbei"}),
	   "Hmmm, riecht lecker!");
  	
  //Commands:
  AddCmd(({"lauf","laufe"}), "cmd_lauf");
  AddCmd(({"aufguss"}), "cmd_aufguss");
}

nosave int cmd_aufguss(string str)
{
  notify_fail(BS("Womit willst Du denn den Aufguss machen?"));
  if(!str) return 0;
  
  
}

nosave int cmd_lauf(string str)
{
  object *shoes;
  
  notify_fail(BS("Worueber willst Du denn laufen?"));
  
  if(!str||str=="") return 0;
  
  if(!(str == "ueber boden" || str == "ueber fussboden" || 
       str == "ueber steinboden" || 
       str == "ueber granit")) return 0;
  
  if(sizeof(shoes=TP->QueryArmours(AT_BOOT)))
    {
      write(BS("Du ziehst "+shoes[0]->name(WEN)+" aus und laeufst verzueckt "
	       "ueber den Fussboden. Hach, wie schoen!")+
	    BS("Danach ziehst Du "+shoes[0]->name(WEN)+" wieder an.\n"));
      
      say(BS(CAP(TPN)+" zieht sich das Schuhwerk aus und wandert barfuss "
	     "durch den Raum."));
      
      return 1; 	
    }    

  write(BS("Du laeufst verzueckt ueber den Fussboden. Hach, wie schoen!"));
  
  say(BS(CAP(TPN)+" wandert barfuss durch den Raum."));
  
  return 1;
}
