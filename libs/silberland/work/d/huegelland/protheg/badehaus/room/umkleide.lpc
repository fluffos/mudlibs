
#include "../def.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "In Derlims Badehaus");
  SetProp(P_INT_LONG,
	  BS("Hier im Inneren des Badehauses riecht es nach Kraeuterbaedern, "
	     "Sauna und allerlei verschiedenen Aromen. Du stehst hier im "
	     "Vorraum zu den Umkleidekabinen, es herrscht reges Treiben. "
	     "Kleine Kinder schreien, Zwerge, die sich ueber besetzte "
	     "Duschen beschweren, Trolle, denen die Toiletten zu klein sind, "
	     "Feen, die sich beim Frisieren angeregt unterhalten..."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_HOUSE]));
  
  AddDetail(({"eingang","raum","inneres","inneren","badehaus"}),
    QueryProp(P_INT_LONG));
  
  AddDetail(({"nase"}),
    "Jepp, ist vorhanden.");

  AddReadDetail(({ "" }),
		"");
  
  AddSound(DEFAULT_SOUND,
   "Du hoerst ein leises konstantes Zischen.");
  
  AddSound(({"zischen","dampfbad","dampfbaeder"}),
   "Das Zischen kommt vermutlich aus einem der Dampfbaeder.");
  
  AddSmell(({DEFAULT_SMELL,"geruch"}),
   "Es riecht nach Kraeuterbaedern, Sauna und allerlei verschiedenen Aromen.");
  
  AddSmell(({"kraeuterbad","kraeuterbaeder"}),
   "Du vernimmst den unverkennbaren Geruch eines Kraeuterbades.");
  
  AddSmell(({"sauna"}),
   "Der Geruch einer Sauna steigt Dir in die Nase.");
  
  AddSmell(({"nase"}),
   "Du riechst mit der Nase.");
    
  AddExit("vorne", "nach vorne in die Rezeption#" ROOM "rezeption");
  AddSpecialExit("kabine", "gehe_zur_kabine");
}

int gehe_zur_kabine(string dir)
{
  notify_fail("Regina Sattelschlepper teilt Dir mit: Erst Schluessel holen!\n");
//  if(!present("\nbadehauskabinenschluessel", TP)) return 0;

  write(BS("Du blickst auf den Kabinenschluessel und gehst dann zur "
	   "richtigen Kabine."));
  
  TP->move(ROOM "kabine:_:"+getuid(TP), M_GO, "zu "+
	   TP->QueryPossPronoun(FEMALE, WEM)+" Umkleidekabine");
  return 1;
}
