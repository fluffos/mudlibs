
#include "../def.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "In Derlims Badehaus");
  SetProp(P_INT_LONG,
	  BS("Hier im Inneren des Badehauses riecht es nach Kraeuterbaedern, "
	     "Sauna und allerlei verschiedenen Aromen. Der Eingang ist mit "
	     "weissem Marmor ausgelegt, der allerlei kleine Verzierungen "
	     "traegt. Sonst wirkt der grosse Raum bis auf eine kleine "
	     "Rezeption ziemlich leer."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_HOUSE]));
  
  AddDetail(({"eingang","raum","inneres","inneren","badehaus"}),
    QueryProp(P_INT_LONG));
  
  AddDetail(({"rezeption"}),
    "Die Rezeption besteht aus einem grossen Tisch aus weissem Marmor, "
    "einem dazugehoerigen Sessel und einem Regal dahinter, welches "
    "mit allerlei Dingen vollgestopft ist.");
  
  AddDetail(({"tisch","marmortisch"}),
    "Der grosse Marmortisch ist bis auf ein grosses Buch und ein "
    "Tintenfaesschen mit einer Feder leer.");
  
  AddDetail(({"feder","schreibfeder","federkiel","schreibfederkiel"}),
    "Mit der Feder traegt Regina Sattelschlepper in das grosse Buch ein.");
  
  AddDetail(({"fass","tintenfass"}),
    "Es ist doch nur ein kleines Tintenfaesschen");
  
  AddDetail(({"faesschen","tintenfaesschen","tinte"}),
    "Das Tintenfaesschen enthaelt die Tinte, mit der Regina Sattelschlepper "
    "ins Buch eintraegt.");
  
  AddDetail(({"buch"}),
    "Das Buch scheint offenbar wichtiges zu enthalten, denn es ist mit einem "
    "Vorhaengeschloss verschlossen und mit einer Kette am Tisch befestigt.");
  
  AddDetail(({"schloss","vorhaengeschloss","kette"}),
    "Das Vorhaengeschloss und die Kette scheinen Dir etwas uebertrieben, "
    "aber sie erfuellen ihren Zweck.");
  
  AddDetail(({"privatsphaere","zweck"}),
    "Der offensichtliche Zweck des Vorhaengeschlosses ist, neugierige "
    "Abenteurer wie Dich vom Schnueffeln abzuhalten.");
  
  AddDetail(({"abenteurer","jemand"}),
    "Jemand wie Du!");
  
  AddDetail(({"schnueffeln","forschen"}),
    "Gemeint ist natuerlich \"Forschen\"");
  
  AddDetail(({"regal"}),
    "Das Regal ist mit allerlei Dingen vollgestopft, hauptsaechlich "
    "Badeutensilien.");
  
  AddDetail(({"dinge","ding"}),
    "Du kannst nicht genau erkennen, was da alles in dem Regal ist, "
    "Du siehst vor allem Handtuecher, Badehosen, Bikinis, Seifen, etc.");
  
  AddDetail(({"badeutensil","badeutensilien","handtuch","handtuecher",
	"badehose","badehosen","bikini","bikinis","seife","seifen"}),
    "Regina wird Dir alle Fragen ueber die Badeutensilien beantworten.");
  
  AddDetail(({"frage","fragen"}),
    "Regina wird Dir alle Fragen beantworten.");

  AddDetail(({"sessel","holzsessel"}),
    "Auf dem Sessel sitzt normalerweise Regina Sattelschlepper.");
  
  AddDetail(({"regina","regina sattelschlepper","sattelschlepper"}),
    "Sie scheint wohl im Moment nicht hier zu sein...");
  
  AddDetail(({"moment"}),
    "Der Moment ist auch schon wieder vorbei.");
  
  AddDetail(({"boden","marmorboden","badehausboden","badehausmarmorboden"}),
    "Der Boden ist wie der gesamte Raum mit weissem Marmor ausgelegt.");

  AddDetail(({"decke","badehausdecke","marmordecke","badehausmarmordecke"}),
    "Die Decke ist wie der gesamte Raum mit weissem Marmor ausgelegt.");

  AddDetail(({"wand","waende","marmorwand","marmorwaende"}),
    "Die Waende sind wie der gesamte Raum mit weissem Marmor ausgelegt. "
    "Zusaetzlich sind die Waende mit zahlreichen Verzierungen uebersaeht, "
    "die einige hell leuchtende Steine enthalten.");
  
  AddDetail(({"marmor"}),
    "Feiner weisser Marmor ziert diesen Raum.");

  AddDetail(({"aroma","aromen","sauna","kraeuterbad","kraeuterbaeder"}),
    "Hier riecht es wunderbar...");
  
  AddDetail(({"dampfbad","dampfbaeder"}),
    "Du kannst es kaum erwarten, eines auszuprobieren!");
  
  AddDetail(({"verzierung","verzierungen"}),
    "Die Waende sind mit huebschen Verzierungen aus Marmor behangen. "
    "In die Verzierungen sind hell leuchtende Steine eingelassen.");
  
  AddDetail(({"stein","steine"}),
    "Die Steine in den Waenden scheinen von Innen heraus hell zu leuchten. "
    "Mehr kannst Du nicht erkennen.");
  
  AddDetail(({"innen","inneres"}),
    "Die Steine scheinen von Innen heraus hell zu leuchten.");
  
  AddDetail(({"nase"}),
    "Jepp, ist vorhanden.");

  AddReadDetail(({ "" }),
		"");
  
  AddSound(DEFAULT_SOUND,
   "Du hoerst ein leises konstantes Zischen.");
  
  AddSound(({"zischen","dampfbad","dampfbaeder"}),
   "Das Zischen kommt vermutlich aus einem der Dampfbaeder.");
  
  AddSmell(({DEFAULT_SMELL,"geruch"}),
   "Es riecht nach Kraeuterbaedern, Sauna und allerlei verschiedenen Aromen.");
  
  AddSmell(({"kraeuterbad","kraeuterbaeder"}),
   "Du vernimmst den unverkennbaren Geruch eines Kraeuterbades.");
  
  AddSmell(({"sauna"}),
   "Der Geruch einer Sauna steigt Dir in die Nase.");
  
  AddSmell(({"nase"}),
   "Du riechst mit der Nase.");
  
  AddCmd(({"oeffne"}), "oeffnebuch");
  
  AddExit("hinten", "nach hinten ins Badehaus#" ROOM "umkleide");
  
  AddItem(NPC "regina" , REFRESH_DESTRUCT);
}

nosave int oeffnebuch(string str)
{
  notify_fail("Was willst Du oeffnen?\n");

  if(str=="buch")
    return write(BS("Aber das Buch ist doch mit einem Vorhaengeschloss "
		    "versehen.")), 1;
  
  return 0;
}
