#include "../def.h"
#include <v_compiler.h>

inherit "std/virtual/v_compiler";

#define P_VALID_NAME "valid_name"

void create()
{
  ::create();
  
  SetProp(P_COMPILER_PATH, ROOM);
  //SetProp(P_STD_OBJECT, ROOM "duftgrotte");
  SetProp(P_VALID_NAME, ({"kabine","duftgrotte","felsgrotte","finnensauna"}));
}

string Validate(string file)
{
  string path, name;
  int nr;
  
  file = ::Validate(file);
  
  if((sscanf(file, "%s:_:%s", name, nr) == 2) &&
     (name=="kabine"))
    {
      SetProp(P_STD_OBJECT, ROOM+name);
      
      return file;
    }

  if((sscanf(file, "%s:%d", name, nr) == 2) &&
     (member(QueryProp(P_VALID_NAME), name) != -1))
    {
      SetProp(P_STD_OBJECT, ROOM+name); 
      
      return file;
    }
}

int CustomizeObject()
{
  string name,foo,bars;
  int bar;

  if(!(name = ::CustomizeObject()) || 
     (sscanf(name,"%s:%d",foo,bar)!=2) &&
     (sscanf(name,"%s:_:%s",foo,bars)!=2))
    return 0;
  
  return 1;
}
