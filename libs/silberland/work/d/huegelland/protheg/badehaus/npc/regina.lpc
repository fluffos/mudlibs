/*
** Regina Sattelschlepper, die Rezeptionistin vom Badehaus
**
**
*/

inherit "std/npc";

#include "../def.h"

nosave object *greeted;

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Regina Sattelschlepper, die Rezeptionistin vom Badehaus");
  SetProp(P_LONG,
	  BS("Eine sehr froehlich wirkende Hobbitdame. Regina Sattelschlepper "
	     "ist die hiesige Rezeptionistin. Sie traegt die uebliche "
	     "Berufskleidung fuer das Badehaus: Holzpantoffeln und weisse "
	     "Leinen, die ihre Kurven nicht sehr gut verstecken koennen."));
  SetProp(P_NAME, "Regina Sattelschlepper");
  SetProp(P_GENDER, FEMALE);
  AddId(({"regina", "hobbit", "sattelschlepper"}));
  SetProp(P_ARTICLE, 0);
  set_living_name("regina");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit ihren Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 100);
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 20);
  SetProp(P_NOMAGIC, 10);
  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([DT_COLD: -0.15, DT_LIGHTNING: 0.1, DT_SOUND: 0.2, DT_POISON: 0.1, 
	    DT_TERROR: -0.15, DT_MAGIC: -0.1]));
  
  SetProp(P_MSGIN, "trippelt herein");
  SetProp(P_MSGOUT, "trippelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG, " faellt tot zu Boden.\n");
  
  AddDetail(({"leinen","holzpantoffeln","pantoffeln","kleidung",
		"berufskleidung"}),
	    "Sie traegt die hiesige Berufskleidung: Holzpantoffeln und "
	    "weisse Leinen.");
  
  AddDetail(({"kurven"}),
	    "Fuer einen Hobbit ist Regina doch sehr wohlgenaehrt.");
  
  AddInfo(DEFAULT_INFO, "laechelt einfach nur.\n");

  AddInfo(({"",""}),
	   ".",
	   "sagt: ");
  
  SetProp(P_LOG_INFO, "badehaus");
  
  SetProp(P_REJECT, 
	  ({REJECT_DROP, "Regina sagt: Dafuer gibt es Umkleidekabinen.\n"}));
  
  SetChats(3, ({
    "Regina schreibt etwas in das Buch auf dem Tisch.\n",
      "Regina laechelt Dich an.\n",
      "Ein Badegast kommt herein.\nRegina redet kurz mit dem Badegast.\n"
      "Der Badegast geht wieder nach hinten.",
      "Regina grinst.\n",
      "Eine Putzfrau kommt herein.\nDie Putzfrau wischt den Tisch ab.\n"
      "Regina nickt der Putzfrau zu.\nDie Putzfrau geht wieder nach hinten."
      }) );
  
  greeted=({});
  SUID;
}

void reset()
{
  ::reset();

  greeted=({});
}

void init()
{
  ::init();
  
  if(TP && interactive(TP) && (member(greeted, TP)==-1))
    call_out("greeting", 0, TP);
}

void greeting(object pl)
{
  if(!objectp(pl)) return;
  if(!MENV) return;
  if(!present(pl, MENV)) return;
  
  TP->Message("Regina Sattelschlepper sagt: Hallo "+TP->name()+
	      ", Du koenntest auch mal wieder\n"+
	      "Regina Sattelschlepper sagt: baden! Du riechst schon etwas!\n",
	      MSGFLAG_SOUND);
  greeted+=({TP});
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  
  switch (gruppe) 
    {
    case "fies":
      call_out("reaction", 0, TP,
	       "grummelt Dich an.",
	       "grummelt herum.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
	       "meint: Aber Hallo!",
	       "meint: Aber Hallo!");
      break;
    case "nett":
      call_out("reaction", 0, TP,
	       "laechelt Dich an.",
	       "laechelt.");
      break;
    }

  if(touch)
    {
      call_out("reaction", 0, TP,
	       "meint: Nicht waehrend der Arbeitszeit!",
	       "meint: Nicht waehrend der Arbeitszeit!");

      return;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
