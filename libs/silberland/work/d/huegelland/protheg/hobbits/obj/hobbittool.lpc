int hower(string str)
{
  string ret, n, li, reg;
  object *hobbits, *listeners;
  object en, we;
  int i;

  hobbits=filter_array(users(), "is_hobbit");
  hobbits=sort_array(hobbits, "is_higher");

  ret="Folgende Hobbits sind anwesend:\n \n";

  ret+=sprintf("%25-s %6s %20-s%10s\n%64'-'s\n","Name","","Waffe","Gesinnung",""); 

  for(i=sizeof(hobbits)-1;i>=0;i--)
    {
      if(!IS_WIZARD(TP)) if(hobbits[i]->QueryProp(P_INVIS)) continue;

      en=hobbits[i]->InFight();
      we=hobbits[i]->QueryProp(P_WEAPON);
      
      n=gettitle(hobbits[i]);
      
      if((IS_SEER(TP)) && (ENV(hobbits[i])))
        {
	  string *fn;
	  
	  fn=explode(file_name(ENV(hobbits[i])), "/");
	  
	  if(ENV(hobbits[i])->QueryFood() || ENV(hobbits[i])->QueryDrink())
	    reg=" (Kneipe)";
	  else
	    switch(fn[0])
	      {
	      case "d":
		reg=sprintf(" (%s)", CAP(fn[1]));
		
		if(fn[1]=="seher")
		  reg=" (Seherhaus)";
		
		if(fn[1]=="huegelland")
		  if(((fn[1]=="raballion") && (fn[2]=="hobbits")))
		    reg=" (Derlim)";
		break;
	      case "gilden":
		reg=" (Gilden)";
		break;
	      case "players":
		reg=" (Magiergebiet)";                              
		break;
	      case "room":
		if(fn[1]=="death")
		  reg=" (Bei Lars)";
		break;
	      default:
		reg="";
	      }
	}
      else
	reg="";
      
      ret+=sprintf("%25-s %6s %20.20-s %10s\n - Standort: %-50.50s\n%s", 
		   n+CAP(getuid(hobbits[i])),
		   (query_idle(hobbits[i])>120 ? 
		    (query_idle(hobbits[i])>1800 ? "(IDLE)":"(idle)"):""),
		   (we ? extract_colors(we->Name(RAW)) : ""),
		   getalign(hobbits[i]->QueryProp(P_ALIGN)),
		   (ENV(hobbits[i]) ? ENV(hobbits[i])->QueryProp(P_INT_SHORT)+reg: 
		    "Im Nirvana"),
		   (en ? " - Im Kampf mit: "+en->Name(WER)+"\n" : "")+
		   (str=="kurz" ? "":"\n"));
    }

  listeners=users()-hobbits;
  li="";

  for(i=sizeof(listeners)-1;i>=0;i--)
    if((listeners[i]->QueryProp(HOBBITLISTENER)) && 
       (!listeners[i]->QueryProp(P_INVIS)) &&
       (getuid(listeners[i])!="andyl"))
      li+=CAP(getuid(listeners[i]))+"-";

  if(strlen(li))
    ret+="Stille Lauscher:\n"+implode(explode(li, "-"), ", ")+"\n";
  
  TP->More(make_dokument(ret));
  return 1;
}

nosave int hohist(string str)
{
  object pl;
  string ret;

  if(pl=ENV(ME))
    if(interactive(pl))
      if(pl==TP)
	if(strlen(ret=HPFEIFENMASTER->QueryHistory()))
	  pl->More(ret);
	else
	  write(BS("In letzter Zeit war es recht ruhig..."));

  return 1;
}

nosave int horufen(string str)
{
  object *plr;
  string pre;
  int i;

  notify_fail(BS("Was willst Du den anderen Hobbits zurufen?"));
  if(!str) return 0;
  
  if(!TP) return 0;
  if(!MENV) return 0;
  if(TP!=MENV) return 0;
  
  if(TP->QueryProp(P_INVIS)) 
    return write(BS("Das geht nur, wenn Du sichtbar bist!!")),1;
  
  plr=users()-({TP});
  
  str=TP->_unparsed_args();
  
  pre=gettitle(TP);
  pre+=CAP(getuid(TP))+" ruft Dir zu: ";

  pre=break_string(str, 78, pre);
  
  for(i=sizeof(plr)-1;i>=0;i--)
    {
      if(plr[i]->QueryProp(HOBBITLISTENER))
	if(is_not_ignoring(plr[i], getuid(TP)))
	  tell_object(plr[i], pre);
    }
  
  if(!IS_SEER(TP)) TP->AddSp(-1);
  
  write(break_string(str, 78, "Du rufst den anderen Hobbits zu: "));
  
  HPFEIFENMASTER->AddHistory(pre);
  
  return 1;
}


void NotifyHpChange()
{
  int    hp, mhp, sp, msp, prz;
  string col;
  
  // Sicherheits-Check
  if (!previous_object() || !owner || (owner != previous_object()))
    return;

  // Ausschalten wenn aktiv == 0 (z.B. nach Tod)
  if (!aktiv)
  {
    SetProp(P_NODROP, 0);
    if (owner!=find_netdead(getuid(owner)))
      owner->RemoveHpHook(ME);   // geht nur bei nicht-netztoten Spielern
    return;
  }

  // Test auf Geist
  if (owner->QueryProp(P_GHOST))
    return;

  // aktuelle Werte ermitteln
  hp = owner->QueryProp(P_HP);
  mhp = owner->QueryProp(P_MAX_HP);
  sp = owner->QueryProp(P_SP);
  msp = owner->QueryProp(P_MAX_SP);

  // Vergleich und Ausgabe
  if((hp < lastHP) || (hp != lastHP && sp == msp) || (sp != lastSP))
    {
      switch(show)
	{
	case KURZ:
	  tell_object(owner,
		      "* LP: "+hp+" ("+mhp+") MP: "+sp+" ("+msp+")\n");
	  if((hp==mhp) && (sp==msp))
	    tell_object(owner, "Du bist jetzt wieder absolut fit.\n");
	  break;
	case SPEZIAL:
	  switch (hp*100/mhp)
	    {
	    case  0 ..  20: col=ANSI_RED+ANSI_BOLD;    break;
	    case 21 ..  40: col=ANSI_BLUE+ANSI_BOLD;   break;
	    case 41 ..  60: col=ANSI_CYAN+ANSI_BOLD;   break;
	    case 61 ..  80: col=ANSI_YELLOW+ANSI_BOLD; break;
	    case 81 .. 100: col=ANSI_GREEN+ANSI_BOLD;  break;
	    default: col=ANSI_NORMAL;
	    }
	  tell_object(owner,
		      col+"* Du hast jetzt "+hp+" von "+mhp+" Lebenspunkten "
		      "und "+sp+" von "+msp+" Magiepunkten."+ANSI_NORMAL+"\n");
	  if((hp==mhp) && (sp==msp))
	    tell_object(owner, 
			col+"* Du bist jetzt wieder absolut fit."+ANSI_NORMAL+
			"\n");
	  break;
	case SPEZIALKURZ:
	  switch (hp*100/mhp)
	    {
	    case  0 ..  20: col=ANSI_RED+ANSI_BOLD;    break;
	    case 21 ..  40: col=ANSI_BLUE+ANSI_BOLD;   break;
	    case 41 ..  60: col=ANSI_CYAN+ANSI_BOLD;   break;
	    case 61 ..  80: col=ANSI_YELLOW+ANSI_BOLD; break;
	    case 81 .. 100: col=ANSI_GREEN+ANSI_BOLD;  break;
	    default: col=ANSI_NORMAL;
	    }
	  tell_object(owner,
		      col+"* LP: "+hp+" ("+mhp+") MP: "+sp+" ("+msp+")"+ANSI_NORMAL+"\n");
	  if((hp==mhp) && (sp==msp))
	    tell_object(owner, 
			col+"* Du bist jetzt wieder absolut fit."+ANSI_NORMAL+
			"\n");
	  break;
	default:
	  tell_object(owner,
		      "* Du hast jetzt "+hp+" von "+mhp+" Lebenspunkten und "+
		      sp+" von "+msp+" Magiepunkten.\n");
	  if((hp==mhp) && (sp==msp))
	    tell_object(owner, "* Du bist jetzt wieder absolut fit.\n");
	}
    }
  // neue Werte merken
  lastHP = hp; lastSP = sp;
}

nosave int Report(string str)
{
  if(MENV != TP)
    return call_out("remove", 0), 0;

  notify_fail("Syntax: horeport ein|aus|kurz|spezial|spezialk.\n");

  switch (str)
    {
    case "ein":
    case "n":
    case "normal":
      if (aktiv && objectp(owner))
	if(show==NORMAL)
	  write("Der Report-Modus normal ist schon eingeschaltet!\n");
	else
	  {
	    show=NORMAL;
	    write("Der Report-Modus wird auf normal umgestellt!\n");
	  }
      else 
	{
	  write("Report-Modus ist jetzt eingeschaltet.\n");
	  activate(TP);
	  show=NORMAL;
	}
      break;
    case "a":
    case "aus":
      if (!aktiv)
        write("Der Report-Modus ist doch schon ausgeschaltet!\n");
      else 
	{ 
	  write("Report-Modus ist nun ausgeschaltet.\n");
	  activate(0);
	}
      break;
    case "k":
    case "kurz":
      if(aktiv && objectp(owner))
	if(show==KURZ)
	  write("Der Report-Modus kurz ist schon eingeschaltet!\n");
	else
	  {
	    show=KURZ;
	    write("Der Report-Modus wird auf kurz umgestellt!\n");
	  }
      else
	{
	  write("Report-Modus kurz ist jetzt eingeschaltet.\n");
	  activate(TP);
	}
      show=1;
      break;
    case "s":
    case "spezial":
      if(aktiv && objectp(owner))
	if(show==SPEZIAL)
	  write("Der Report-Modus spezial ist schon eingeschaltet!\n");
	else
	  {
	    show=SPEZIAL;
	    write("Der Report-Modus wird auf spezial umgestellt!\n");
	  }
      else 
	{
	  write("Report-Modus spezial ist jetzt eingeschaltet.\n");
	  activate(TP);
	}
      show=2;
      break;
    case "sk":
    case "spezialk":
    case "skurz":
    case "spezialkurz":
      if(aktiv && objectp(owner))
	if(show==SPEZIALKURZ)
	  write("Der Report-Modus spezialkurz ist schon eingeschaltet!\n");
	else
	  {
	    show=SPEZIALKURZ;
	    write("Der Report-Modus wird auf spezialkurz umgestellt!\n");
	  }
      else 
	{
	  write("Report-Modus spezialkurz ist jetzt eingeschaltet.\n");
	  activate(TP);
	}
      show=3;
      break;
    default:
      return 0;
    }
  return 1;
}

void aufloesen(object who)
{
  tell_object(who, BS("Als Du die Hobbitpfeife beruehrst, loest "
		      "sie sich ploetzlich auf..."));

  RemoveCmd(0);

  call_out("remove", 0);
}

varargs int move(mixed dest, int method)
{
  int res;
  object env;
  
  res=::move(dest,method);
  
  env=MENV;
  
  if((IS_LEARNER(env)) || env->QueryProp(P_TESTPLAYER))
    SetProp(P_AUTOLOADOBJ, 1);        // fuer Magier autoload
  else
    SetProp(P_AUTOLOADOBJ, 0);

  if((interactive(env)) && (env->QueryProp(P_RACE)!="Hobbit") &&
     (!IS_WIZARD(env)))
    call_out("aufloesen",0,env);
  else
    {
      if((interactive(env)) && ((env->QueryProp(P_RACE)=="Hobbit") ||
				(getuid(env)=="andyl")))
	{
	  env->SetProp(HOBBITLISTENER, 1);
	  DB("*** Activating Property HOBBITLISTENER in "+CAP(getuid(env))+
	     ". Version 1."+VER+"\n");
	}

      if(!xpdiff) xpdiff=env->QueryProp(P_XP);
      
      call_out("checkowner", 1);
    }
    
  return res;
}

void checkowner()
{
  if (aktiv && !objectp(owner) && stringp(owner_name)) 
    {
      owner = find_player(owner_name);
      if(!objectp(owner)) 
	activate(0);
      else 
	activate(owner);
    }
}

int remove(int x)
{
  if((TP) && (MENV) && (TP==MENV))
    {
      if(aktiv) MENV->RemoveHpHook(ME);
      if(!(present(HOBBITTOOL, TP)))
	MENV->SetProp(HOBBITLISTENER, 0);
    }
  
  return ::remove(x);
}

// ---------------------------------------------------------------------------

varargs void init_soul_cmds(int force)
{
  string *cmds;
  string *tmp;
  int i;
  
  if((!force) && (file_date(SOULFILE)==souldate)) return;
  
  souldate=file_date(SOULFILE);
  
  DB(BS("*** Pfeifensoul in "+sprintf("%O", (MENV||TP||"-"))+ 
	" Rehashing from file ("+ctime(souldate)+")"));
  
  soulcmds=([]);
  
  cmds=explode(read_file(SOULFILE), "\n");
  
  for(i=sizeof(cmds)-1;i>=0;i--)
    {
      tmp=explode(cmds[i], "##");
      
      if(sizeof(tmp)!=9)
	{
	  DB("*** Pfeifensoul: Fehler beim Einlesen ("+i+")\n");
	  continue;
	}
      
      soulcmds+=([i:explode(tmp[0],","); ({ tmp[1], tmp[2], tmp[3], tmp[4],
		  tmp[5], tmp[6]}); tmp[7]; tmp[8]]);
      
      AddCmd(soulcmds[i], "pfeifensoulcmd");
    }
}

nosave int pfeifensoulcmd(string str)
{
  int i;
  
  for(i=sizeof(soulcmds)-1;i>=0;i--)
    if(member(soulcmds[i], query_verb())!=-1)
      return rbefehl (str, soulcmds[i,1], to_int(soulcmds[i,2]), 
		      to_int(soulcmds[i,3]));
  
  return 0;
}

string _in(string a, mapping m)
{
  if (member(m,lower_case(a)))
    return m[a];
  else
    return "";
}

string ParseAdverben(string str, object ob)
{
  string *advpart;
  mixed quotedpart;
  mapping adverben;

  if (!str) return 0;
  str=" "+str;
  adverben=ob->QueryStdAdverbs()+ob->QueryAdverbs();
  advpart=explode(str,"/");
  if (sizeof(advpart)>1)
      quotedpart=" "+implode(advpart[1..],"/");
  else
    quotedpart="";
  advpart=regexplode(advpart[0],"\\<[^, ]*\\>");
  advpart=map_array(advpart,CLOSURE(_in),adverben) - ({""});
  return sizeof(advpart) ? ob->CountUp(advpart)+quotedpart : quotedpart[1..];
}

/*
explode_str() - ersetzt @@...@@ Makros
-------------
str ......... der String
ob .......... das Objekt, dessen Name eingesetzt werden soll
adv ......... Adverben
fern ........ 0: Naehe, 1: aus der Ferne
*/

varargs string explode_str(string str, object ob, string adv, int fern)
{
  string s,s1,s2,x;
  s2=str;
  s="";

  while (sscanf(s2, "%s@@%s@@%s", s1, x, s2) == 3)
    {
      switch (x)
	{
	case "WER":    
	  if (fern>0 && INV_TEST(TP,ob,ob)) s+=s1+WIZ_NAME(ob,0);
	  else s+=s1+ob->name(WER);
	  break;

	case "WESSEN": 
	  if (fern>0 && INV_TEST(TP,ob,ob)) s+=s1+WIZ_NAME(ob,1);
	  else s+=s1+ob->name(WESSEN);
	  break;

	case "WEM":
	  if (fern>0 && INV_TEST(TP,ob,ob)) s+=s1+WIZ_NAME(ob,0);
	  else s+=s1+ob->name(WEM);
	  break;

	case "WEN":
	  if (fern>0 && INV_TEST(TP,ob,ob)) s+=s1+WIZ_NAME(ob,0);
	  else s+=s1+ob->name(WEN);
	  break;

	case "WIE":
	  s+=s1+adv; 
	  break;

	case "FERN":   
	  if (fern>0) s+=s1+" aus der Ferne"; 
	  else s+=s1; 
	  break;
	  
	case "HAARFARBE":
	  s+=s1+ob->QueryProp(P_HAIR_COLOR)+"e ";
	  break;
	  
	case "HAARFARBEN":
	  s+=s1+ob->QueryProp(P_HAIR_COLOR)+"en ";
	  break;	}
    }
  
  s+=s2;
  
  return s;
}

/*
  
rbefehl()
---------
str ......... der String, wie er beim Befehl angehaengt wurde
form ........ ein Array mit den diversen Meldungen:
  form[0].... Fehlermeldung, wenn str leer ist
  form[1].... Fehlermeldung, wenn Spieler == Zielperson
  form[2].... sprintf Fehlermeldung bei nicht parse-baren Adverben
              "...%s...", Zielperson->Name(casus)
  form[3].... sprintf Maske fuer Zielperson
              "%s...%s...%s.\n", Spieler, Adverben, ["Ferne"]
  form[4].... sprintf Maske fuer Spieler
              "...%s...%s...%s.\n", Zielperson->Name(casus), Adverben, ["Ferne"]
  form[5].... sprintf Maske fuer Raum
              "%s...%s...%s...", Spieler, Zielperson->Name(casus), Adverben
sp........... Kosten (spellpoints)
---
Anmerkungen:

["Ferne"]  ist " aus der Ferne", wenn die Spieler in verschiedenen Raeumen
           stehen, sonst ein Leerstring ("").
Adverben   werden wie soul-Adverben geparsed, ihnen wird ausserdem ein
           Space vorangestellt (um sie fuer die sprintf Maske optional
           zu machen).
*/
  
varargs int rbefehl(string str, string *form, int sp, int nearonly)
{
  string *s, adv;
  mixed ob;
  object room;
  int i, ferne;

  PROCHECK(TP);

  if(MENV != TP)
    return notify_fail(BS("Dazu musst Du "+name(WEN,1)+" erst einmal "
			  "an Dich nehmen!")), 0;
  if(!IS_SEER(TP) && (TP->QueryProp(P_SP) < sp))
    return notify_fail("Dazu hast Du zuwenig Magiepunkte!\n"), 0;

  notify_fail(BS(form[0]));
  
  str=TP->_unparsed_args();
  
  if (!stringp(str) || str=="") return 0;
  
  s=explode (str, " ");
  if(!i=sizeof(s)) return 0;

  s[0]=LOWER(s[0]);

  ob=find_player(s[0]) || match_living(s[0], 1);
  // ergibt:  - Spielerobjekt oder
  //          - String (passender Spielername) oder
  //          - Integer (-1: multiple matches, -2: no matches)
  if (stringp(ob)) ob=find_player(ob);
  // Jetzt: - Spielerobjekt oder
  //        - Integer (0 oder -2: nicht da, -1: mehrere da)
  
#ifdef INVIS_SPERRE
  if (objectp(ob) && !IS_WIZARD(TP) && ob->QueryProp(P_INVIS)) ob=0;
#endif
  
  if (!objectp(ob)) 
  {
    if (ob==-1)
      return notify_fail("Das war nicht eindeutig!\n"), 0;
    else
      return notify_fail("Kein solcher Spieler!\n"), 0;
  }

  if (ob==TP) return notify_fail(BS(form[1])), 0;

  if (i<2) adv="";
  else
  {
    if (!adv=ParseAdverben(implode(s[1..], " "), TP))
      return notify_fail (BS(sprintf(explode_str(form[2], ob)))), 0;
    else
      if (strlen(adv)) adv=" "+adv;
  }
  
  // aus der Ferne?
  // (Bei der Gelegenheit ausserdem gleich room und ferne setzen)
 
  ferne=(room=ENV(TP)) != ENV(ob);

  if(nearonly && ferne)
    return write(BS(ob->Name(WER)+" ist zuweit weg von Dir...")), 1;

  if(s=ob->QueryProp(P_IGNORE))
    if(member(s, lower_case(getuid(TP))+".pfeife") != -1)
  return write(BS(ob->Name(WER)+" ignoriert Grados Hobbitpfeife. (Wie "
		  "gemein...)\n")), 1;
  
  // Nun die eigentliche Ausgabe:
  // tell_object (ob, BS(sprintf(explode_str(form[3], ob, adv, ferne), TPN)));
  
  if(ob->Message(BS(CAP(sprintf(explode_str(form[3], ob, adv, ferne),
          gettitle(TP)+(INV_TEST(ob,TP,TP) ? WIZ_NAME(TP,0) : TPN)))))==-1)
    write(ob->Name(WER)+" ignoriert Dich oder diesen Befehl.\n");
  else 
  {
    write (BS(CAP(sprintf(explode_str(form[4], ob, adv, ferne)))));
    if (!ferne)
      tell_room(room, BS(CAP(
	  sprintf(explode_str(form[5], ob, adv, -1), gettitle(TP)+TPN))), 
	  ({TP,ob}));
  }

  if (!IS_SEER(TP) && sp)
    TP->AddSp(-sp);

  return 1;
}

// Pfeifenfunktionen
// Uebernommen aus Orws Pfeifenwerkstatt
nosave int fktstopfen(string str)
{ 
  string was;
  string wohinein;            
  object kr;

  notify_fail("Was willst Du wo reinstopfen?!\n"); 
  if(!str) return 0;
  
  if(sscanf(str, "%s in %s", was, wohinein)!=2 &&
     sscanf(str, "%s mit %s", wohinein, was)!=2)
    return 0;
  
  wohinein=explode(wohinein," ")[0];
  
  if(member(({"pfeife","hobbitpfeife"}), wohinein)==-1)
    return 0;

  if(pfeifegestopft_blatt || pfeifegestopft_kraut ||
     pfeifegestopft_stern || pfeifegestopft_pflanze)
    return write(BS("Die Pfeife ist doch schon gestopft!")), 1;

  // Pfeife mit Langgrundblatt stopfen
  if(was=="langgrundblatt" || was=="grundblatt" || was=="blatt")
    {
      if(kr=present("PFEIFENKRAUTBLATT",TP))
	{
	  write(BS("Du stopfst das Langgrundblatt in Grados Hobbitpfeife."));
	  say(BS(TPN+" stopft eine kleine Pfeife."));
	  
	  pfeifegestopft_blatt=1;
	  kr->remove();
	  return 1;
	}
      else
	return write(BS("Mit welchem Langgrundblatt?")), 1;
    }

  // Pfeife mit Grottenkraut stopfen
  if(was=="grottenkraut" || was=="kraut")
    {
      if(kr=present("PFEIFENKRAUTKRAUT",TP))
        {
          write(BS("Du stopfst das Grottenkraut in Grados Hobbitpfeife."));
          say(BS(TPN+" stopft eine kleine Pfeife."));

          pfeifegestopft_kraut=1;
          kr->remove();
          return 1;
        }
        else
	  return write(BS("Mit welchem Grottenkraut?")), 1;
      }
  
  // Pfeife mit Suedstern stopfen
  if(was=="suedstern" || was=="stern")
    {
      if(kr=present("PFEIFENKRAUTSTERN",TP))
        {
          write(BS("Du stopfst den Suedstern in Grados Hobbitpfeife."));
          say(BS(TPN+" stopft eine kleine Pfeife."));

          pfeifegestopft_stern=1;
          kr->remove();
          return 1;
        }
        else
	  return write(BS("Mit welchem Suedstern?")), 1;
    }
  
  // Pfeife mit Nakrafulpflanze stopfen
  if(was=="nakrafulpflanze" || was=="pflanze")
    {
      if(present("PFEIFENKRAUTPFLANZE_1",TP))
        {
          write(BS("Du stopfst die zerriebene Nakrafulpflanze in Grados Hobbitpfeife."));
          say(BS(TPN+" stopft eine kleine Pfeife."));

          pfeifegestopft_pflanze=1;
          kr->remove();
          return 1;
        }
      
      if(present("PFEIFENKRAUTPFLANZE_0",TP))
	return write(BS("Du solltest die Nakrafulpflanze vorher zerreiben.")), 1;
      else
	return write(BS("Mit welcher Nakrafulpflanze?")), 1;
    }
  
  write(BS("Sowas kannst Du nicht in Grados Hobbitpfeife stopfen!"));
  return 1;
}

// Uebernommen aus Orws Pfeifenwerkstatt
nosave int fktrauchen(string str)
{
  notify_fail(BS("Was willst Du rauchen?!")); 
  if(!str) return 0;
  
  if(!id(str)) return 0;
  
  if(pfeifeangezuendet)
    return write(BS("Du rauchst doch schon Deine Pfeife!")), 1;
  
  // Pfeife gestopft mit Langgrundblatt
  if(pfeifegestopft_blatt)
    {
      write(BS("Gemuetlich zuendest Du Dir Deine Pfeife an."));
      say(BS(TPN+" zuendet sich gemuetlich eine Pfeife an."));
      
      SetProp(P_NODROP, "Aber Grados Hobbitpfeife brennt doch gerade!\n");
      
      pfeifeangezuendet=1;
      
      call_out("blattrauchen1", 15+random(5), TP);
      return 1;
    }
  
  // Pfeife gestopft mit Grottenkraut
  if(pfeifegestopft_kraut)
    {
      write(BS("Gemuetlich zuendest Du Dir Deine Pfeife an."));
      say(BS(TPN+" zuendet sich gemuetlich eine Pfeife an."));
      
      SetProp(P_NODROP, "Aber Grados Hobbitpfeife brennt doch gerade!\n");
      
      pfeifeangezuendet=1;
      
      call_out("krautrauchen1", 15+random(5),TP);
      return 1;
    }
  
  // Pfeife gestopft mit Suedstern
  if(pfeifegestopft_stern)
    {
      write(BS("Gemuetlich zuendest Du Dir Deine Pfeife an."));
      say(BS(TPN+" zuendet sich gemuetlich eine Pfeife an."));
      
      SetProp(P_NODROP, "Aber Grados Hobbitpfeife brennt doch gerade!\n");
      
      pfeifeangezuendet=1;
      
      call_out("sternrauchen1", 15+random(5),TP);
      return 1;
    }
  
  // Pfeife gestopft mit einer Nakrafulpflanze
  if(pfeifegestopft_pflanze)
    {
      write(BS("Gemuetlich zuendest Du Dir Deine Pfeife an."));
      say(BS(TPN+" zuendet sich gemuetlich eine Pfeife an."));
      
      SetProp(P_NODROP, "Aber Grados Hobbitpfeife brennt doch gerade!\n");
      
      pfeifeangezuendet=1;
      
      call_out("pflanzerauchen1", 15+random(5),TP);
      return 1;
    }
  
  write(BS("Du musst Grados Hobbitpfeife vorher stopfen um sie rauchen zu koennen!"));
  return 1;
}


// Blattrauchen
int blattrauchen1(object raucher)
{
  if(objectp(raucher))
    {
      write(BS("Kleine Rauchwoelkchen kommen aus Deiner Pfeife und Du "
	       "fuehlst Dich so richtig wohl."));
      say(BS(raucher->name()+" fuehlt sich richtig wohl."));
      
      if(raucher->QueryProp(P_RACE)=="Hobbit")
	raucher->heal_self(pfeifenwert);

      call_out("blattrauchen2", 25+random(5),raucher);
    }
  else
    {
      pfeifeangezuendet=0;
      return 1;
    }
}

