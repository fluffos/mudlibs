int pflanzerauchen1(object raucher)
{
  if(raucher)
    {
      write(BS("Du wunderst Dich ueber den komischen Geschmack der "
	       "Nakrafulpflanze. Irgendwie nicht schlecht, aber irgendwie "
	       "auch ganz anders als alles das Du bisher geraucht hast."));
      say(BS(raucher->name()+" schliesst "+
	     raucher->QueryPossPronoun(FEMALE,WEN)+
	     " Augen und entspannt sich total."));

      call_out("pflanzerauchen2", 25+random(5),raucher);
    }
  else
    {
      pfeifeangezuendet=0;
      return 1;
    }
}

