	     "und steckt sie dann weg."));
      
      SetProp(P_NODROP, 0);
      
      pfeifegestopft_kraut=0;
      pfeifeangezuendet=0;
      return 1;
    }
  else
    {
      pfeifeangezuendet=0;
      return 1;
    }
