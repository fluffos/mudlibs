#pragma strong_types;

#include "../def.h"
#include <ansi.h>
#include <exploration.h>

inherit "std/thing";
inherit MOST "std_things";

#define VER 7

#define HOBBITTOOL "\nhobbittool"
#define QM "/secure/questmaster"

#define HPFEIFENMASTER OBJ "gradopfeife"

#define SOULFILE OBJ "soul"
#define HOBBITLISTENER "tmp_hobbit_listener"

#define BARRY "/d/huegelland/orw/pfeifenladen/"

#define PROCHECK(x) if(getuid(x)=="protheg") return 0

// Reporteinstellungen
#define NORMAL      0
#define KURZ        1
#define SPEZIAL     2
#define SPEZIALKURZ 3

#define C +GetColor()+
#define G +GetColor(999)+
#define W +GetColor(666)+
#define O +NormalColor()+

/*
** Wird folgende Zeile aktiviert, so koennen unsichtbare Magier
** mit dem Teddy nicht mehr aufgespuert werden, andernfalls
** heissts halt wieder "Jemand" etc.
*/

#define INVIS_SPERRE

#define INV_TEST(x,y,z) (IS_LEARNER(x) && IS_LEARNER(y) && \
                         z->QueryProp(P_INVIS))
#define WIZ_NAME(pl,genitiv) ("("+capitalize(getuid(pl))+ \
    (genitiv ? (strstr("xsz",getuid(pl)[<1..])!=-1?"'":"s"):"")+")")

nosave int lastHP, lastSP, aktiv=0, show, dunkel, setting, xpdiff, souldate;
nosave object owner;
nosave string owner_name,currentcolor;
nosave mapping soulcmds;

varargs nosave string huefe(int flag);
nosave varargs int rbefehl(string str, string *form, int sp, int nearonly);
varargs void init_soul_cmds(int force);

// Vars fuer Pfeife
#define RINGERL ({"ein Ringerl","ein unfoermiges Ringerl", \
                  "ein huebsches Ringerl","ein rundes Ringerl", \
                  "ein lustiges Ringerl","ein ovales Ringerl", \
                  "ein nicht sehr huebsches Ringerl" })

nosave int pfeifeangezuendet;
nosave string pfeifenname = "Grados Hobbitpfeife";
nosave int pfeifenwert = random(3)+random(3)+random(3);
nosave int formringerl;
nosave int pfeifegestopft_blatt;
nosave int pfeifegestopft_kraut;
nosave int pfeifegestopft_stern;
nosave int pfeifegestopft_pflanze;

string NormalColor()
{
  if(setting)
    return ANSI_NORMAL;
  else
    return "";
}

varargs string GetColor(int i)
{
  if(!i)
    return currentcolor;
  
  if(!setting) 
    return currentcolor="";
  
  if(i==999)
    return ANSI_GREEN;
  
  if(i==666)
    return ANSI_WHITE;
  
  return currentcolor=({ANSI_BLUE,ANSI_CYAN,ANSI_PURPLE,
			  ANSI_RED,ANSI_YELLOW})[random(5)];
}

string det_farbe()
{
  return "Jetzt ist sie "+({"blau","cyanfarben","purpur","rot",
			      "gelb"})[random(5)]+".\n";
}

nomask void create()
{
  string aussehen;
  
  if(!is_clone(ME)) return;
  ::create();
  
  aussehen="Die Hobbitpfeife ist "+
    ({"lang","kurz","laenglich","eher kurz","eher lang"})[random(5)]+
    ", "+
    ({"schmal","breit","duenn","dick"})[random(4)]+
    " und "+
    ({"gebogen","gerade","geknickt"})[random(3)]+
    ".";
    
  SetProp(P_SHORT, "Grados Hobbitpfeife");
  SetProp(P_LONG,
	  BS("Dies ist eine der Hobbitpfeifen von Grado Schnellfuss, einem "
	     "beruehmten Hobbitabenteurer. Die Pfeifen wurden ihm einst von "
	     "einem maechtigen Zauberer zum Geschenk gemacht. Diese Pfeife "
	     "ist von ausgezeichneter Qualitaet und ihr Holz weist einige "
	     "elfische Schnitzereien auf. Sie scheint ihre Farbe zu aendern.")+
	  BS(aussehen));

  SetProp(P_NAME, ({"Grados Hobbitpfeife", "Grados Hobbitpfeife",
		      "Grados Hobbitpfeife", "Grados Hobbitpfeife"}));
  SetProp(P_GENDER, FEMALE);
  
  AddId(({"pfeife", "hobbitpfeife","grados pfeife","grados hobbitpfeife", 
	    HOBBITTOOL}));
  
  SetProp(P_WEIGHT, 150);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL, ([MAT_WOOD:100]));
  SetProp(P_MAGIC, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_NODROP, 
	  BS("Du wuerdest Dich nie von dieser kostbaren Hobbipfeife trennen!"));
  lastHP = lastSP = -1;
  setting=0;
  
  SetProp(P_ARTICLE, 0);
  
  SetProp(P_NOSELL,
	  "Du wuerdest Dich nie von dieser kostbaren Hobbipfeife trennen!\n");
  
  SetProp(P_INFO,
	  BS("Das ist sicher keine gewoehnliche Pfeife.")+
	  BS("Sie passt doch wesentlich besser zu einem Hobbit als so "
	     "ein Teddy. Dieser wuerde die Hobbitpfeife zudem nur negativ "
	     "beeinflussen."));
  
  AddDetail(({"form","aussehen"}),
	    aussehen);
  
  AddSpecialDetail(({"farbe"}), "det_farbe");
  
  AddDetail(({"grado","schnellfuss", "grado schnellfuss"}),
	    "Grado Schnellfuss ist anscheinend ein hobbitscher Abenteurer.");
  
  AddDetail(({"holz", "qualitaet"}),
	    "Das Holz der Hobbitpfeife ist von ausgezeichneter Qualitaet.");
  
  AddDetail(({"verzierungen", "verzierung","schnitzerei","schnitzereien"}), 
	    CLOSURE(huefe));
  
  AddCmd("horeport", "Report");
  
  //Kommandos fuer die Hobbitkommunikation
  
  AddCmd(({"horuf","horufe"}), "horufen");
  AddCmd(({"hohist","hohistory"}), "hohist");
  AddCmd(({"howink","howinke"}), "howink");
  AddCmd(({"hoknuddel","hoknuddle","hoknuddele"}), "hoknuddel");
  AddCmd(({"howuschel","howuschle","howuschele"}), "howuschel");
  AddCmd(({"hoprost","hoproste"}), "hoproste");
  AddCmd(({"homahlzeit"}), "homahlzeit");
  
  AddCmd(({"hoinfo"}), "hoinfo");
  AddCmd(({"hower"}), "hower");
  AddCmd(({"hofarbe","hofarben"}), "hofarbe");
  
  AddCmd(({"hopresay"}), "hopresay");
  
  AddCmd(({"hohilfe"}), "hohilfe");


  // Pfeife funs

  AddCmd(({"stopfe","stopf"}), "fktstopfen");
  AddCmd(({"rauche","rauch"}), "fktrauchen");

  pfeifegestopft_blatt=0;
  pfeifegestopft_kraut=0;
  pfeifegestopft_stern=0;
  pfeifegestopft_pflanze=0;
  pfeifeangezuendet=0;
  
  GetColor(1);
  
  SUID;
  
  // r* commands:
  init_soul_cmds(1);
}

void reset()
{
  if(!is_clone(ME)) return;
  ::reset();
  
  call_out("init_soul_cmds", 5+random(10));
}

string info()
{
  if((MENV) && (query_once_interactive(MENV)))
    if(present("universal-teddy", MENV))
      return BS("Das ist sicher keine gewoehnliche Pfeife.")+
	BS("Sie passt doch wesentlich besser zu einem Hobbit als so "
	   "ein Teddy. Dieser wuerde die Hobbitpfeife zudem nur negativ "
	   "beeinflussen.");
  
  return BS("Das ist sicher keine gewoehnliche Pfeife.")+
    BS("Das Holz der Hobbitpfeife glaenzt geheimnisvoll.");
}

void Setting(int i)
{
  setting=i;
  GetColor(1);
}

varargs nosave string huefe(int flag)
{
  string ret, rcmds;
  int i;
  
  rcmds="";
  
  if(IS_SEER(TP))
    {
      for(i=sizeof(soulcmds)-1;i>=0;i--)
	if(i==0)
	  rcmds+="und "+soulcmds[i][0]+".";
	else
	  rcmds+=soulcmds[i][0]+", ";
      
      rcmds=break_string(rcmds, 60, " ", BS_NO_PARINDENT);
    }
  else
    {
      for(i=sizeof(soulcmds)-1;i>=0;i--)
	if(i==0)
	  rcmds+="und "+soulcmds[i][0]+"("+soulcmds[i,2]+").";
	else
	  rcmds+=soulcmds[i][0]+"("+soulcmds[i,2]+"), ";
      
      rcmds=break_string(rcmds, 60, " ", BS_NO_PARINDENT);
      
      
      rcmds+="Die Zahlen in den Klammern sind die Magiekosten.\n \n";
      
    }
  
  ret="\n \n"
    "Grados Hobbitpfeife kann Dir anzeigen, wie es um Deine\n"
    "Lebensenergie und Zauberkraft bestellt ist.\n \n"
    "Der Befehl dazu lautet:\n"
    " 'horeport [ein|kurz|spezial|spezialkurz|aus]'\n \n"
    "Grados Hobbitpfeife bietet Dir weiters folgende RVerben an:\n\n"+
    rcmds+
    "\nEinige Befehle nur fuer Hobbits:\n"
    " 'hower, hoinfo, hofarbe, hopresay'\n \n"
    "RVerben nur fuer Hobbits:\n"
    " 'howinke, hoknuddel, hoprost, homahlzeit'\n\n"
    "Hilfe zu den Befehlen erhaelst Du mit:\n"
    " 'hohilfe'\n \n"
    "Ignorieren kannst Du jemanden mit:\n"
    " 'ignoriere name, ignoriere name.pfeife'\n\n"
    "Oder jegliche Aktionen der Hobbitpfeife ignorieren:\n"
    " 'ignoriere pfeife'\n"
    "                                                         Ver 1."+VER+"\n";
  if(flag) return ret;
  
  TP->More(make_dokument(ret));
  return "";
}

nosave int hohilfe(string str)
{
  string ret;
  
  if(str) str=explode(str, " ")[0];
  
  switch(str)
    {
    case "horeport": 
      ret="Der 'horeport' informiert Dich, wie es um Deine "
	"Lebensenergie und Zauberkraft bestellt ist.\n"
	"Moegliche Einstellungen sind:\n"
	"* horeport normal      - Schaltet den Report normal ein.\n"
	"* horeport kurz        - Schaltet den Report kurz ein.\n"
	"* horeport spezial     - Schaltet den Report in Farbe ein.\n"
	"* horeport spezialkurz - Schaltet den Report faerbig und\n"
	"                         kurz ein.\n"
	"* horeport aus         - Schaltet den Report wieder aus.\n";
      break;
    case "hoinfo": 
      ret="In 'hoinfo' hast Du eine eher zu Hobbits passende Version\n"
	"der normalen Infoanzeige bei 'info'.\n"
	"Mit 'hofarbe' kannst Du die Anzeige sogar in wunderschoenen\n"
	"Farben darstellen lassen.\n"
	"Einige unwichtige Angaben werden im Normalfall unterdrueckt.\n";
      break;
    case "hower": 
      ret="Mit 'hower' siehst Du, wer aus dem Hobbitsvolk anwesend ist.\n"
	"*  Wer ist anwesend?\n"
	"*  Ist er/sie anwesend, oder idle?\n"
	"*  Was fuer eine Waffe hat er/sie gezueckt?\n"
	"*  Welche Gesinnung hat er/sie?\n"
	"*  Wo befindet er/sie sich?\n\n"
	"Mit 'hower kurz' siehst Du das ganze etwas kompakter.\n";
      break;
    case "hofarben":
    case "hofarbe": 
      ret="Mit '"+str+" ein|aus' kannst Du die Farbanzeige einstellen.\n";
      break;
    case "horuf": 
    case "horufe": 
      ret="Mit '"+str+"' hast Du die Moeglichkeit, den anderen Hobbits\n"
	"etwas mitzuteilen, ohne dass andere Rassen mithoeren koennen.\n"
	"Mit 'hohist' kannst Du die Rufe nocheinmal lesen.\n";
      break;
    case "hohist": 
      ret="Mit 'hohist' kannst Du versuchen, die Echos der zuletzt\n"
	"gerufenen Meldungen zu erhaschen...\n"
	"Jedoch ist die Liste in ihrer Groesse beschraenkt.\n";
      break;
    case "howinke":
    case "howink": 
      ret="Mit '"+str+"' kannst Du den anderen Hobbits zuwinken.\n"; 
      break;
    case "hoknuddel":
    case "hoknuddle":
    case "hoknuddele": 
      ret="Mit '"+str+"' kannst Du die anderen Hobbits alle knuddeln.\n"; 
      break;
    case "hoprost":
    case "hoproste": 
      ret="Mit '"+str+"' kannst Du allen anderen Hobbits zuprosten.\n"; 
      break; 
    case "homahlzeit": 
      ret="Mit '"+str+"' kannst Du allen anderen Hobbits einen guten Appetit wuenschen.\n"; 
      break;  
    case "hopresay":
      ret="Mit 'hopresay' kannst Du Dir Dein Hobbits-Presay, welches\n"
	"z.B. bei 'hower' gezeigt wird, permanent als Presay setzen.\n\n"
	"Mit 'hopresay loeschen' kannst Du Dein Presay entfernen.\n";      
      break;
    case "allgemein":
      ret=huefe(1);
      break;
    default: 
      ret="Mit 'hohilfe' kannst Du Dich ueber Folgendes informieren:\n \n"
	"hohilfe <horeport>   Wie sieht es mit Leben u. Magie aus?\n"
	"        <hoinfo>     Ein etwas anderes 'info'.\n"
	"        <hower>      Eine Liste aller anwesenden Hobbits.\n"
	"        <hofarbe>    Farbeinstellungen?\n"
	"        <hopresay>   Das Hobbitspresay fix setzen.\n"
	"        <horufe>     Den anderen Hobbits etwas zurufen?\n"
	"        <hohist>     Wer hat den Hobbits etwas zugerufen?\n"
	"        <howink>     Winkt den anwesenden Hobbits zu.\n"
	"        <hoprost>    Prostet den anwesenden Hobbits zu.\n"
	"        <homahlzeit> 'Guten Appetit' an alle anwesenden Hobbits.\n"
	"        <hoknuddel>  Knuddelt alle anwesenden Hobbits.\n"
	"        <allgemein>  Allgemeine Uebersicht.\n";
    }
  return TP->More(make_dokument(ret)),1;
}

void activate(object ob)
{
  if(objectp(ob)) 
    {
      aktiv = 1;
      owner = ob;
      owner_name = getuid(owner);
      ob->AddHpHook(ME);
      lastHP = ob->QueryProp(P_HP);
      lastSP = ob->QueryProp(P_SP);
    } 
  else 
    {
      if(ob=(owner||TP)) ob->RemoveHpHook(ME);
      owner = owner_name = aktiv = 0;
    }
}

public varargs void erneuern(int force)
{
  object neue_pfeife;
  
  if(!is_clone(ME)) return;
  
  if((!force) && (HPFEIFENMASTER->GetCurrentVersion()==VER))  return;
  
  DB(BS("*** Hobbittool Renew VER-"+VER+" vs. "+
	(HPFEIFENMASTER->GetCurrentVersion())));
  
  RemoveCmd(0);
  
  SetProp(P_INVIS, 1);
  
  //Neue Pfeife
  //neue_pfeife=clone_object(explode(file_name(ME), "#")[0]);
  neue_pfeife=clone_object("/p/service/protheg/rt/obj/gradopfeife");
  neue_pfeife->move(MENV, M_NOCHECK);
  
  if(aktiv) neue_pfeife->activate(MENV);
  
  neue_pfeife->Setting(setting);
  neue_pfeife->SetProp(P_KEEP_ON_SELL, QueryProp(P_KEEP_ON_SELL));

  activate(0);
  
  call_out("remove", 0);
}

void BecomesNetAlive(object who)
{
  if(ENV(ME)==who)
    {
      if(HPFEIFENMASTER->GetCurrentVersion()!=VER) 
	return erneuern(1);
      
      xpdiff=who->QueryProp(P_XP);
    }
}

nosave varargs string gettitle(object who, int flag)
{
  string ret;
  
  if((!flag) && ((who->QueryProp(P_INVIS)) || (who->QueryProp(P_FROG))))
    return "";
  
  // Jaja muss sein ;)
  if(getuid(who)=="andyl")
    return "Hobbitsoundmagier ";

  if(getuid(who)=="protheg")
    return "Drowmagier ";
  
  if(!present(HOBBITTOOL, who))
    return "";
  
  if(IS_WIZARD(who))
    return "Hobbitmagier"+(who->QueryProp(P_GENDER)==FEMALE ? "in ":" ");

  ret="Hobbit";

  if(who->QueryProp(P_GUILD)=="druidenzirkel")
    return ret+"druid"+(who->QueryProp(P_GENDER)==FEMALE?"in ":"e ");
  
  if(who->QueryProp(P_GUILD)=="zechpreller")
    return ret+"zechpreller"+(who->QueryProp(P_GENDER)==FEMALE?"in ":" ");
  
  if(who->QueryProp(P_GUILD)=="berserker")
    return ret+"berserker"+(who->QueryProp(P_GENDER)==FEMALE?"in ":" ");
  
  if(who->QueryProp(P_GUILD)=="paladine")
    return ret+"paladin ";
  
  if(who->QueryProp(P_GUILD)=="bardengilde")
    return ret+"bard"+(who->QueryProp(P_GENDER)==FEMALE?"in ":"e ");
    
  return ret+(who->QueryProp(P_GENDER)==FEMALE?"dame ":" ");
}

nosave int is_hobbit(object who)
{
  if(who->QueryProp(P_RACE)=="Hobbit") return 1;
  else return 0;
}

nosave int is_higher(object a, object b)
{
  if((a->QueryProp(P_LP))>(b->QueryProp(P_LP))) return 1;
  else return 0;
}

nosave int is_not_ignoring(object pl, string str)
{
  string *ign;
  
  if(!interactive(pl)) return 0;
  if(!pointerp(ign=pl->QueryProp(P_IGNORE))) return 0;
  
  if((member(ign, str+".pfeife")==-1) &&
     (member(ign, "pfeife")==-1) && 
     (member(ign, str)==-1))
    return 1;
  else
    return 0;
}

string getalign(int i)
{
  string ret;
  
  if(i<= -1200) ret="diabolisch";
  else
    switch(i)
      {
      case -1199 .. -1000: ret="satanisch";  break;
      case  -999 ..  -800: ret="sehr boese"; break;
      case  -799 ..  -500: ret="boese";      break;
      case  -499 ..  -200: ret="gemein";     break;
      case  -199 ..   -40: ret="frech";      break;
      case   -39 ..    39: ret="neutral";    break;
      case    40 ..   199: ret="nett";       break;
      case   200 ..   499: ret="lieb";       break;
      case   500 ..   799: ret="gut";        break;
      case   800 ..   999: ret="sehr gut";   break;
      default:             ret="heilig";
      }

  return ret;
}

nosave string erschoepfung(object tp)
{
  int p, c;

  p = 100 * tp->QueryProp(P_MV) / tp->QueryProp(P_MAX_MV);
  c=setting;
  
  switch(p)
    {
    case 0..5:   
      return (c ? ANSI_RED : "")+
	sprintf("%28-s", "STOPP!! LUFT!!")+
	(c ? ANSI_NORMAL : "");
    case 6..15:  
      return (c ? ANSI_YELLOW : "")+
	sprintf("%28-s", "Du bist total ausser Atem.")+
	(c ? ANSI_NORMAL : "");
    case 16..30: 
      return (c ? ANSI_GREEN : "")+
	sprintf("%28-s", "Du bist etwas erschoepft.")+
	(c ? ANSI_NORMAL : "");
    default:     
      return duplicate(" ", 28);
    }
}

nosave string gewicht(object tp)
{
  int p, c;

  p = 100 * (tp->QueryProp(P_TOTAL_WEIGHT) - tp->QueryProp(P_WEIGHT))
    / tp->QueryProp(P_MAX_WEIGHT);
  c=setting;

  switch (p)
    {
    case  0 ..  50: 
      return "";
    case 51 ..  60: 
      return (c ? ANSI_GREEN : "")+
	sprintf("%22-s", "Du bist etwas beladen")+(c ? ANSI_NORMAL : "");
    case 61 ..  70: 
      return (c ? ANSI_GREEN : "")+
	sprintf("%22-s", "Du bist ziemlich beladen")+(c ? ANSI_NORMAL : "");
    case 71 ..  80: 
      return (c ? ANSI_YELLOW : "")+
	sprintf("%22-s", "Du bist schwer beladen")+(c ? ANSI_NORMAL : "");
    case 81 ..  90: 
      return (c ? ANSI_YELLOW : "")+
	sprintf("%22-s", "Du bist sehr beladen")+(c ? ANSI_NORMAL : "");
    case 91 ..  95: 
      return (c ? ANSI_RED : "")+
	sprintf("%22-s", "Du bist extrem beladen!")+(c ? ANSI_NORMAL : "");
    default:
      return (c ? ANSI_RED : "")+
	sprintf("%22-s", "Du bist UFFF!! beladen!")+(c ? ANSI_NORMAL : "");
    }
}

nosave string balken(int aktuell, int max, int colorflag, int wimpy)
{
  string ret;
  int i,w,s;
  
  if(aktuell > max) aktuell=max;

  i=(aktuell*200/max)/5;
  if(wimpy) w=(wimpy*200/max)/5;

  ret=duplicate(" ",40);
  
  if(!colorflag)
    {
      if(wimpy)
	if(aktuell<=wimpy)
	  ret=duplicate("+",w)+duplicate("-",40-w);
	else
	  ret=duplicate("+", w)+duplicate("#",i-w)+duplicate("-",40-i);
      else
	ret=duplicate("#",i)+duplicate("-",40-i);

      ret=sprintf("%3d",aktuell)+" ["+sprintf("%3d",max)+"] "+ret;
    }
  else
    {
      if(wimpy)
	if(aktuell<=wimpy)
	  ret=ANSI_BG_BLUE+ret[0..w-1]+ANSI_BG_RED+ret[w..<0]+ANSI_NORMAL;
	else
	  ret=ANSI_BG_BLUE+ret[0..w-1]+ANSI_BG_GREEN+ret[w..i-1]+ANSI_BG_RED+ret[i..<0]+ANSI_NORMAL;
      else
	ret=ANSI_BG_GREEN+ret[0..i-1]+ANSI_BG_RED+ret[i..<0]+ANSI_NORMAL;
      ret=sprintf("%3d",aktuell)+" ["+sprintf("%3d",max)+"] "+ret;
    }
  return ret;
}

nosave string stupse(object pl)
{
  string ret;
  int i, lvl, rlvl;
  
  if((pl->LpLevel()==(pl->QueryProp(P_LEVEL)+1))
     && (pl->LevelPerc(pl->LpLevel()+1) < 20))
    lvl=pl->QueryProp(P_LEVEL);
  else
    lvl=pl->LpLevel();

  if(((lvl+1) < pl->QueryProp(P_LEVEL)) ||
     (lvl > pl->QueryProp(P_LEVEL)))
    rlvl=pl->QueryProp(P_LEVEL);
  
  i=pl->LevelPerc(lvl+1)/10;

  if(!setting)
    ret=sprintf("%10'-'-s", duplicate("#",i));
  else
    {
      ret=duplicate(" ", 10);
      ret=ANSI_BG_GREEN+ret[0..i-1]+ANSI_BG_RED+ret[i..<0]+ANSI_NORMAL;
    }
  
  return sprintf("%3d+ [%s] %3d", lvl, ret, (rlvl ? rlvl : lvl+1));
}

nosave string zustand(object tp)
{
  string ret;
  int tmp;

  if(!tp) return "";

  ret="";

  if(tp->QueryProp(P_FROG))       
    ret+=" Frosch";

  if(tmp=tp->QueryProp(P_POISON)) 
    {
      if(strlen(ret)) ret+=" ";

      ret+=(tmp > 5 ? "GIFT!":"Gift");
    }

  if(tp->QueryProp(P_BLIND))      
    {
      if(strlen(ret)) ret+=" ";
      
      ret+=(tp->QueryProp(P_BLIND)[BLIND_TIME] > 15 ? " BLIND!" : " Blind");
    }
  
  if(tp->QueryProp(P_DEAF))
    {
      if(strlen(ret)) ret+=" ";
      
      ret+=(tp->QueryProp(P_DEAF)[DEAF_TIME] > 15 ? " TAUB!" : " Taub");
    }

  return ret;
}

nosave string hunger(int food, int max_food, int drink, int max_drink)
{
  string ret;
  int f, d;
  
  f=food*100/max_food;
  d=drink*100/max_drink;

  // HUNGER: 00-10: extrem hungrig, 11-20: ausgesprochen hungrig, 21-30: ziemlich hungrig, 31-40: sehr hungrig, 41-50: hungrig, 
  // HUNGER: 51-60: noch hungrig, 61-70: kaum hungrig, 71-80: beinahe gesaettigt, 81-90: gesaettigt, 91-99: satt, 100: absolut voll. 
  
  // DURST: 00-10: extrem durstig, 11-20: ausgesprochen durstig, 21-30: ziemlich durstig, 31-40: sehr durstig, 41-50: durstig, 
  // DURST: 51-60: noch durstig, 61-70: kaum durstig, 71-80: fast nicht durstig, 81-90: ueberhaupt nicht durstig, 91-99: voll, 100: absolut voll 
  
  ret="Du bist ";
  
  switch(f)
    {
    case 11 ..  20 : ret+="ausgesprochen hungrig"; break;
    case 21 ..  30 : ret+="ziemlich hungrig"; break;
    case 31 ..  40 : ret+="sehr hungrig"; break;
    case 41 ..  50 : ret+="hungrig"; break;
    case 51 ..  60 : ret+="noch hungrig"; break;
    case 61 ..  70 : ret+="kaum hungrig"; break;
    case 71 ..  80 : ret+="beinahe gesaettigt"; break;
    case 81 ..  90 : ret+="gesaettigt"; break;
    case 91 .. 100 : ret+="voll angegessen"; break;
    default : ret+="extrem hungrig"; break;
    }
  
  if((f < 50 && d > 50) ||
     (f > 50 && d < 50))
    ret+=" aber ";
  else 
    ret+=" und ";
  
  switch(d)
    {
    case 11 ..  20 : ret+="ausgesprochen durstig"; break;
    case 21 ..  30 : ret+="ziemlich durstig"; break;
    case 31 ..  40 : ret+="sehr durstig"; break;
    case 41 ..  50 : ret+="durstig"; break;
    case 51 ..  60 : ret+="noch durstig"; break;
    case 61 ..  70 : ret+="kaum durstig"; break;
    case 71 ..  80 : ret+="fast nicht durstig"; break;
    case 81 ..  90 : ret+="ueberhaupt nicht durstig"; break;
    case 91 .. 100 : ret+="voll angetrunken"; break;
    default : ret+="extrem durstig"; break;
    }
  
  return ret+".";
}

nosave int hopresay(string str)
{
  string np, op;

  notify_fail(BS("Du kannst mit 'hopresay' nur das Hobbit-Presay setzen!")+
	      BS("Du kannst aber auch mit 'hopresay loeschen' das Presay "
		 "loeschen."));

  if(strlen(str)) 
    if(str=="loeschen")
      {
	if(!strlen(TP->QueryProp(P_PRESAY)))
	  return write(BS("Du hattest doch gar kein Presay gesetzt!?")), 1;
	
	TP->SetProp(P_PRESAY, "");
	
	return write(BS("Dein Presay wurde geloescht.")), 1;
      }
    else
      return 0;

  
  np=gettitle(TP, 1);
  
  if(strlen(op=TP->QueryProp(P_PRESAY)))
    if(np==op)
      write(BS("Dein voriges Presay '"+op+"' wird ersetzt."));
  
  np=np[0..<2];
  
  TP->SetProp(P_PRESAY, np);
  
  write(BS("Du bist nun:")+
	BS(np+" "+CAP(getuid(TP))+" "+(TP->QueryProp(P_TITLE) || "")));
  
  return 1;
}

nosave int hofarbe(string str)
{
  notify_fail(BS("Syntax: hofarbe ein|aus"));
  if(!str) return 0;
  
  if(str=="aus")
    {
      Setting(0); 
      return write(BS("Die Hobbitpfeife zeigt Dir jetzt 'hoinfo' in Schwarz/Weiss.")), 
	1;
    }

  if(str=="ein")
    {
      Setting(1); 
      return write(BS("Die Hobbitpfeife zeigt Dir jetzt 'hoinfo' in Farbe.")), 1;
    }
  
  return 0;
}

nosave int hoinfo(string str)
{
  object tp;
  mapping at;
  int xp;
  
  tp=TP;

  if(str && IS_WIZARD(TP))
    if(!tp=find_player(str))
      return write(BS("Spieler nicht gefunden!")), 1;

  if(tp->QueryProp(P_GHOST))
    return write(BS("Geister haben keine Punkte!")), 1;
  
  at=tp->QueryProp(P_ATTRIBUTES);
  
  if(!xpdiff) xpdiff=tp->QueryProp(P_XP);
  
  xp=tp->QueryProp(P_XP);
  
  write(sprintf(
    " "G"+-----"O"\n"
    " "G"|"O" %45.45-s  %23s\n"
    " "G"|"O"\n"
    "   Leben: %s         "W" ~~ ~"O"\n"
    "   Magie: %s       "W"~ ~"O"\n"
    "                                      "C"____"O"                      "W"~~~"O"\n"
    "   Erfahrung:        %10d      "C"(___ `-._"O"                "W"_____"O"\n"
    "   %28.28s          "C"`-._ `-._          ."W"'-----`"C"."O"\n"
    "   Abenteuer:       %4d [%4d]              "C"`-._ `-._     ."G"=-=-=-=-="C"."O"\n"
    "   Stufe: %21s  %11s     "C"`._ /`-..-"G"=-=-=-=-=-"C"|"O"\n"
    "   ____________________________                     "C"`-._             |"O"\n"
    "                                                         "C"`-.._______.'"O"\n"
    "   Intelligenz:         %8-s  %-s\n"
    "   Ausdauer:            %8-s  %-s\n"
    "   Kraft:               %8-s  %-s\n"
    "   Geschicklichkeit:    %8-s  %-s\n"
    "\n"
    " "G"|"O" %70-s "G"|"O"\n"
    " "G"|"O" %70-s "G"|"O"\n"
    " "G"+-----                                                              -----+"O"\n",
                                                            
    gettitle(tp)+CAP(getuid(tp)),
    CAP(tp->QueryProp(P_GUILD))+" ["+tp->QueryProp(P_GUILD_LEVEL)+"]",
    balken(tp->QueryProp(P_HP), tp->QueryProp(P_MAX_HP), setting, 
	   tp->QueryProp(P_WIMPY)),
    balken(tp->QueryProp(P_SP), tp->QueryProp(P_MAX_SP), setting,0),
    xp, (xp-xpdiff ? "Unterschied:      "+sprintf("%10d",xp-xpdiff) : ""), 
    tp->QueryProp(P_QP), QM->QueryAllQP(), 
    stupse(tp), getalign(tp->QueryProp(P_ALIGN)),
    sprintf("%2d [%2+d]", at[A_INT], tp->QueryAttributeOffset(A_INT)), 
    zustand(tp),
    sprintf("%2d [%2+d]", at[A_CON], tp->QueryAttributeOffset(A_CON)), 
    erschoepfung(tp),
    sprintf("%2d [%2+d]", at[A_STR], tp->QueryAttributeOffset(A_STR)), 
    gewicht(tp),
    sprintf("%2d [%2+d]", at[A_DEX], tp->QueryAttributeOffset(A_DEX)),
    (tp->QueryMoney() ? tp->QueryMoney()+" Muenzen" : ""),
    hunger(tp->QueryProp(P_FOOD), tp->QueryProp(P_MAX_FOOD), 
	   tp->QueryProp(P_DRINK), tp->QueryProp(P_MAX_DRINK)),
    (tp->QueryProp(P_WIMPY) ? (sprintf("Vorsicht: %3d", 
				       tp->QueryProp(P_WIMPY))+
			       (tp->QueryProp(P_WIMPY_DIRECTION) ? 
				" Ri: "+tp->QueryProp(P_WIMPY_DIRECTION):"")):
     "")));
  
  GetColor(1);
  return 1;
}

nosave int howink(string str)
{
  object *hobbits;
  string me;
  int i;
  
  if(TP->QueryProp(P_INVIS)) 
    return write(BS("Das geht nur, wenn Du sichtbar bist!!")),1;
  
  hobbits=filter_array(users(), "is_hobbit");
  hobbits=filter_array(hobbits, CLOSURE(is_not_ignoring), getuid(TP));
  hobbits-=({TP});
  
  me=gettitle(TP)+CAP(getuid(TP));
  
  if(!str) str="";  
  if(str[0]=='/') 
    str=str[1..<1]+" ";
  else
    str="";
  
  for(i=sizeof(hobbits)-1;i>=0;i--)
    tell_object(hobbits[i], BS(me+" winkt allen Hobbits "+str+"aus der Ferne zu."));
  
  write(BS("Du winkst allen Hobbits "+str+"aus der Ferne zu."));

  return 1;
}

