string short()
{
  if(pfeifeangezuendet)
    SetProp(P_SHORT, "Grados Hobbitpfeife (glimmend)");
  else
    if(pfeifegestopft_blatt || pfeifegestopft_kraut ||
       pfeifegestopft_stern || pfeifegestopft_pflanze)
      SetProp(P_SHORT, "Grados Hobbitpfeife (gestopft)");
    else
      SetProp(P_SHORT, "Grados Hobbitpfeife");
  
  return ::short();
}

// Extralook
string extra_look()
{
  if(!MENV) return "";
  if(!query_once_interactive(MENV)) return "";
  
  if(pfeifeangezuendet)
    return BS(CAP(MENV->QueryPronoun())+" raucht gerade eine von Grados "
	      "Hobbitpfeifen.");
  else
    return BS(CAP(MENV->QueryPronoun())+" traegt eine von Grados "
	      "Hobbitpfeifen.");
}
