//  Projekt   : Barry's Pfeifenladen
//  Raumname  : Die Pfeifenwerkstatt
//  Erstellt  : 30.03.2001 (Orw)
//  Geaendert : -


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

mapping bzeit   = ([]); // Besteller und Bestellzeit
mapping produkt = ([]); // Besteller und Gegenstand
int pudelcounter;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Die Pfeifenwerkstatt" );
  SetProp(P_INT_LONG,
	 "Du stehst inmitten einer kleinen Werkstatt in welcher eine "
	 "grosse Werkbank mit einem Schraubstock, ein Schleifgeraet und "
	 "allerlei andere Sachen herumstehen. Auf dem Boden liegt ein Haufen "
	 "Holzspaene. In einer Ecke steht ein kleiner Ofen in dem einige "
	 "Tonpfeifen liegen um hart und robust zu werden. Das Feuer im Ofen "
	 "erwaermt den Raum, hoffentlich fangen die Holzspaene nicht an zu "
	 "brennen. Unter der Werkbank siehst Du einen Eimer mit Lack, der "
	 "wohl fuer den Glanz der Pfeifen benoetigt wird. Eine Lampe haengt "
	 "an der Decke und bietet die einzige Lichtquelle. Ein grosser "
	 "Korb steht auf dem Boden.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 24, ENV_TERRAIN: TT_HOUSE]) );

/* Detailbeschreibungen */

  AddDetail( ({"raum","raums"}),
	 QueryProp(P_INT_LONG) );
  AddDetail( ({"werkstatt", "werkstaette"}),
	 "Dies hier ist eine Werkstatt in der Pfeifen hergestellt werden.");
  AddDetail( ({"werkbank"}),
	 "Eine hoelzerne Werkbank deren Kanten mit Eisen beschlagen "
	 "sind. Die Werkbank sieht schon sehr alt aus, hat tiefe Kratzer "
	 "und einige Farbflecken. In der Mitte ist ein grosser Schraubstock "
	 "angebracht, in den Tobi Holzstuecke einspannt, um sie mit Feilen "
	 "und Schleifpapieren zu bearbeiten.");
  AddDetail( ({"kanten","kante"}),
	 "Die Kanten der Werkbank sind mit Eisen beschlagen, um sie vor "
	 "Beschaedigungen zu schuetzen.");
  AddDetail( ({"eisen"}),
	 "Die Beschlaege der Werkbank sind genau wie die Feilen und "
	 "verschiedene andere Werkzeuge aus Eisen.");
  AddDetail( ({"kratzer", "rillen", "rille"}),
	 "Die Arbeitsflaeche der Werkbank hat tiefe Kratzer und Rillen.");
  AddDetail( ({"arbeitsflaeche","flaeche"}),
	 "Tiefe Kratzer und Rillen sind Zeugen eines jahrelangen Gebrauchs "
	 "dieser Werkbank. Einige Feilen, Schleifpapier und Pinsel liegen "
	 "geordnet neben dem Schraubstock.");
  AddDetail( ({"farbflecken", "flecken", "farbflecke"}),
	 "Einige Flecken von Lack, Kleber und verschiedenen Farben "
	 "zieren die Werkbank.");
  AddDetail( ({"mitte"}),
	 "In der Mitte der Werkbank ist ein grosser Schraubstock. Der "
	 "Boden in der Mitte des Raums ist mit Holzspaenen bedeckt.");
  AddDetail( ({"schraubstock","schraubstocks","stock"}),
	 "An der Werkbank ist ein grosser massiver Schraubstock angebracht. "
	 "Er hat weiche Spannbacken, um die Holz und Tonstuecke, die darin "
	 "eingespannt werden, nicht zu beschaedigen.");
  AddDetail( ({"spannbacken", "backen"}),
	 "Die Spannbacken des Schraubstocks sind weich, um die Holz und "
	 "Tonstuecke die darin eingespannt werden, nicht zu beschaedigen. "
	 "Sie koennen aber auch gegen haertere ausgetauscht werden, um "
	 "metallische Gegenstaende zu bearbeiten.");
  AddDetail( ({"gegenstaende"}),
	 "Schau Dich um, hier gibt es sehr viele Gegenstaende.");
  AddDetail( ({"kleber"}),
	 "In einem Regal stehen einige Tiegel mit Kleber und verschiedenen "
	 "Farben.");
  AddDetail( ({"tiegel"}),
	 "Viele verschiedene Tiegel stehen in einem Regal. Du kannst "
	 "Tiegel mit einigen Farben und einen mit Kleber erkennen.");
  AddDetail( ({"farben","farbe"}),
	 "Schwarz und einige Brauntoene.");
  AddDetail( ({"schwarz"}),
	 "Ziemlich dunkel so ein Schwarz.");
  AddDetail( ({"brauntoene","toene", "braun"}),
	 "Braun schaut ungefaehr so aus wie... Braun.");
  AddDetail( ({"holzstuecke","holzstuecken","tonstuecke","stuecke","ton"}),
	 "Verschiedene Materialien werden zur Herstellung von Pfeifen "
	 "verwendet.");
  AddDetail( ({"materialien"}),
	 "Welche Materialien zur Herstellung von Pfeifen verwendet werden, "
	 "fragst Du am besten Tobi.");
  AddDetail( ({"schleifgeraet","schleifgeraets","geraet","geraets"}),
	 "Neben der Werkbank steht ein Schleifgeraet, dessen Schleifscheibe "
	 "durch Wippen mit dem Fuss in eine Drehbewegung versetzt wird.");
  AddDetail( ({"wippen"}),
	 "Durch das Wippen mit dem Fuss beginnt sich die Schleifscheibe "
	 "des Schleifgeraets zu drehen.");
  AddDetail( ({"fuss"}),
	 "Das Schleifgeraet wird mit dem Fuss angetrieben.");
  AddDetail( ({"schleifscheibe","scheibe"}),
	 "Durch das Schleifen an der Schleifscheibe bekommen die Pfeifen "
	 "eine besonders schoene Oberflaeche.");
  AddDetail( ({"oberflaeche"}),
	 "Eine besonders schoene Oberflaeche der Pfeifen bekommt man durch "
	 "das Schleifen mit dem Schleifpapier und der Schleifscheibe.");
  AddDetail( ({"schleifen"}),
	 "Pfeifen werden mit Schleifpapier und an der Schleifscheibe "
	 "bearbeitet.");
  AddDetail( ({"schleifpapier","schleifpapieren","papier","streifen"}),
	 "Auf der Werkbank liegen einige Streifen Schleifpapier.");
  AddDetail( ({"beschaedigungen","beschaedigung","eisenbeschlaege",
               "beschlaege"}),
	 "Die Eisenbeschlaege an den Kanten schuetzen die Werkbank "
	 "vor Beschaedigungen.");
  AddDetail( ({"tobi","ledersohle"}),
	 "Tobi ist gerade nicht hier.");
  AddDetail( ({"drehbewegung","bewegung"}),
	 "Die Schleifscheibe dreht sich in einer Drehbewegung.");
  AddDetail( ({"sachen"}),
	 "Viele andere Sachen liegen noch hier herum.");
  AddDetail( ({"boden","steinboden"}),
	 "Der Boden ist aus Stein, auf ihm liegen viele Holzspaene.");
  AddDetail( ({"stein"}),
	 "Der Boden, die Waende und die Decke sind aus Stein.");
  AddDetail( ({"waende","wand"}),
	 "Die Waende sind ebenso wie der Boden und die Decke aus Stein.");
  AddDetail( ({"decke"}),
	 "Die Decke ist aus Stein. Eine Lampe haengt ueber der Werkbank "
	 "von der Decke und bietet die einzige Lichtquelle.");
  AddDetail( ({"licht", "lichtquelle"}),
	 "Eine Lampe haengt von der Decke und erhellt den Raum.");
  AddDetail( ({"haufen","holzspaene","holzspaenen","spaene"}),
	 "Auf dem Boden liegt ein Haufen Holzspaene.");
  AddDetail( ({"gebrauch","gebrauchs"}),
	 "Jahrelanger Gebrauch hat viele Kratzer und Rillen in der Werkbank "
	 "hinterlassen.");
  AddDetail( ({"zeugen","zeuge"}),
	 "Kratzer und Rillen.");
  AddDetail( ({"werkzeug", "werkzeuge"}),
	 "Viele verschiedene Werkzeuge liegen auf der Werkbank. Darunter "
	 "sind einige Feilen, Saegen und Bohrer.");
  AddDetail( ({"bohrer","bohrern"}),
	 "Mit den Bohrern bohrt Tobi die Loecher in die Pfeifen.");
  AddDetail( ({"feilen", "feile"}),
	 "Damit feilt Tobi aus den zurechtgesaegten Rohteilen die schoenen "
	 "Konturen der Pfeifen heraus.");
  AddDetail( ({"saegen","saege"}),
	 "Damit schneidet Tobi aus den Holzstuecken die Rohteile fuer die "
	 "Pfeifen heraus.");
  AddDetail( ({"rohteile","rohteilen","teile"}),
	 "Rohteile haben die ungefaehre Form der fertigen Pfeife, beduerfen "
	 "aber noch vieler Arbeitsschritte zur Vollendung.");
  AddDetail( ({"arbeitsschritte","schritte"}),
	 "Viele Arbeitsschritte sind noetig um eine fertige Pfeife zu "
	 "bekommen.");
  AddDetail( ({"vollendung", "endung"}),
	 "Die Vollendung einer Pfeife ist immer ein sehr gluecklicher Moment "
	 "fuer Tobi.");
  AddDetail( ({"moment"}),
	 "Moment mal...");
  AddDetail( ({"form"}),
	 "Welche Form eine Pfeife hat weisst Du doch, oder?");
  AddDetail( ({"loecher","loch"}),
	 "Ja,... in die Pfeifen kommen Loecher.");
  AddDetail( ({"ecke","ecken"}),
	 "In einer Ecke steht ein kleiner Ofen in dem Tonpfeifen liegen um "
	 "auszuhaerten.");
  AddDetail( ({"ofen"}),
	 "Den Ofen benutzt Tobi, um Tonpfeifen zu haerten.");
  AddDetail( ({"feuer"}),
	 "Im Ofen brennt ein lustiges Feuer. Hoffentlich greift es nicht "
	 "auf die Holzspaene ueber.");
  AddDetail( ({"eimer"}),
	 "Unter der Werkbank steht ein Eimer mit Lack.");
  AddDetail( ({"lack"}),
	 "Den Lack benutzt Tobi um den Pfeifen einen schoenen Glanz zu "
	 "verleihen.");
  AddDetail( ({"glanz"}),
	 "Der Glanz der Pfeifen wird durch lackieren erreicht.");
  AddDetail( ({"lampe"}),
	 "Eine Lampe haengt ueber der Werkbank von der Decke und erhellt "
	 "den Raum.");
  AddDetail( ({"holz"}),
	 "Die Werkbank ist aus Holz, einige der Pfeifen sind aus Holz "
	 "und ueberall auf dem Steinboden liegen Holzspaene.");
  AddDetail( ({"konturen","kontur"}),
	 "Die Konturen der Pfeifen werden zuerst grob gefeilt und dann "
	 "geschliffen, um eine schoene Oberflaeche zu erreichen.");
  AddDetail( ({"pfeifen","pfeife","holzpfeifen","holzpfeife"}),
	 "In der Werkstatt liegen viele fast fertige und auch einige ganz "
	 "fertige Pfeifen.");
  AddDetail( ({"tonpfeifen","tonpfeife"}),
	 "Einige Tonpfeifen liegen in dem kleinen Ofen in der Ecke des "
	 "Raums.");
  AddDetail( ({"regal"}),
	 "Auf einem Regal stehen einige Tiegel.");
  AddDetail( ({"pinsel","pinseln"}),
	 "Ein paar Pinsel liegen auf der Werkbank. Tobi benutzt sie, um die "
	 "fertigen Pfeifen zu bemalen und zu lackieren.");
  AddDetail( ({"herstellung"}),
	 "Die Herstellung einer Pfeife besteht aus vielen Arbeitsschritten.");
  AddDetail( ({"korb"}),
	 "In dem Korb scheint sich etwas zu bewegen.");

/*
  AddDetail( ({""}),
	 ".");
*/

/* Spezielle Details */

  AddSpecialDetail( ({"etwas"}), "detail_pudel" );
  pudelcounter=1;

/* Geraeusche */

  AddSound( ({ DEFAULT_SOUND }),
	 "Das Feuer knistert im Ofen.");
  AddSound( ({"feuer", "ofen"}),
	 "Lustig knistert das Feuer im Ofen.");
  AddSound( ({"ton"}),
     "Argl, das ist kein Ton im musikalischen Sinn sondern ein Material "
     "aus dem man Pfeifen herstellen kann!" );

/* Gerueche */

  AddSmell( ({ DEFAULT_SMELL }),
	 "Hier riechts nach Holzspaenen und gebranntem Ton.");
  AddSmell( ({"holzspaene", "spaene"}),
	 "Riecht nach frischen Holzspaenen.");
  AddSmell( ({"ton"}),
	 "Gebrannter Ton, hm...");



//  AddCmd( ({"", "", ""}), "fktxxx");
//  AddCmd( ({"", ""}),     "fktyyy");

/* Ausgaenge */

  AddExit( "osten", ROOM "pfeifenladen" );


/* NPCs und Objekte */

  AddItem( NPC "tobi", REFRESH_DESTRUCT);

}

/* Funktionen */

string detail_pudel()
{
  object ob;
  if(pudelcounter==1)
  {
    pudelcounter=0;
    write(BS(
    "Als Du den Korb genauer untersuchen willst, findest Du einen kleinen "
    "Pudel darin.\n"));
    say(
    CAP_TPN+" untersucht den Korb.\n");
    ob=clone_object( NPC "fluffi" );
    if(ob) 
    {
      ob->move(ME,M_GO);
    }
    return(" ");
  }
  else return("Du musst Dich getaeuscht haben, der Korb ist leer.\n");

}

void tobi_verteidigung()
{
  object ob;
  if(pudelcounter==1)
  {
    pudelcounter=0;
    tell_room(TO, "Tobi ruft laut nach seinem Pudel.\n");
    ob=clone_object( NPC "fluffi" );
    if(ob) 
    {
      ob->move(ME,M_GO);
      ob->Kill(TP);
    }
    return;
  }
  if(ob=present("TOBIHAUSTIER", this_object()))
  {
    tell_room(TO, "Tobi ruft: FLUFFI FASS!!!\n");
    ob->Kill(TP);
    return;
  }
  else
  {
    tell_room(TO, "Tobi ruft: FLUFFI FASS!!!\n");
    tell_room(TO, "Tobi sagt: Hmpf, wo steckt der schon wieder...\n");
    return;
  }
}

mapping set_bzeit(mapping newbzeit) 
{ 
  bzeit = newbzeit; 
}

mapping set_produkt(mapping newprodukt) 
{ 
  produkt = newprodukt;
}

mapping get_bzeit() { return bzeit; }

mapping get_produkt() { return produkt; }


// Reset des Raums
reset() 
{ object ob;
  ::reset();
  if(ob=present("TOBIHAUSTIER", this_object()))
  {
    tell_room(TO, "Fluffi springt wieder in seinen Korb.\n");
    ob->remove();
  }
  pudelcounter=1;
}
