//  Raumname  : Ein schmaler Kiesweg
//  Erstellt  : 13.03.2001 (Orw)
//  Geaendert : -


inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

int haselnuss, hagebutte, tierchencounter;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein schmaler Kiesweg" );
  SetProp(P_INT_LONG,
	 "Du befindest Dich auf einem schmalen Kiesweg der von Suedwesten nach "
	 "Nordwesten verlaeuft. Oestlich von Dir befindet sich eine hohe "
	 "Hecke. Rauch steigt aus dem Schornstein eines kleinen Huegels "
	 "im Westen auf. Ein etwas groesserer Stein liegt am Wegrand. Der Kies "
	 "knirscht unter Deinen Schritten und Du kannst viele Voegel "
	 "zwitschern hoeren.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// Standartdetails fuer die Stadt
#include DETAILS"details_stadt.h"

// Standartdetails fuer Aussen
#include DETAILS"details_aussen.h"

// Standartdetails fuer Gruppen von Raeumen (Suedweg)
#include DETAILS"details_sweg.h"


/* Detailbeschreibungen */
  AddDetail( ({"huegel", "kleiner huegel", "huegelchen"}),
	 "Im Westen ist ein kleiner Huegel auf dem Du einen rauchenden "
	 "Schornstein sehen kannst. Wer wohl in diesem Huegel wohnen wird? "
	 "Du beschliesst demnaechst mal dort vorbei zu schauen.");
  AddDetail( ({"schornstein"}),
	 "Ein niedlicher rauchender Schornstein.");
  AddDetail( ({"rand","grenze"}),
	 "Der Wegrand grenzt den Weg gegen die Huegel ab (oder umgekehrt). "
	 "Bunte Steine bilden eine scharfe Grenze zwischen Weg und Wegrand.");
  AddDetail( ({"kiesweg", "weg"}),
	 "Der Weg ist mit wunderhuebschen Kieselsteinchen bedeckt und "
	 "verlaeuft von Suedwesten nach Nordwesten, rund um "
	 "den kleinen Huegel.");
  AddDetail( ({"kies", "kiesel","kieselsteinchen","kieselsteine"}),
	 "Strahlend weisse Kieselsteinchen bedecken den ganzen Weg.");
  AddDetail( ({"kreuzung", "suedweg"}),
	 "Die Kreuzung mit dem Derlimer Suedweg kannst Du von hieraus nicht "
	 "sehen.");
  AddDetail( ({"schritte", "schritten", "schritt"}),
	 "Unter jedem Deiner Schritte knirscht der Kies.");
  AddDetail( ({"rauch"}),
	 "Aus dem Schornstein kommt Rauch.");
  AddDetail( ({"steine"}),
	 "Du siehst verschiedenste Steinarten, die den Wegrand begrenzen. "
	 "Da es bei Derlim keine Steine gibt, sind sie wohl aus dem ganzen "
	 "Silberland zusammengetragen. Ein etwas groesserer Stein faellt "
	 "Dir auf.");
  AddDetail( ({"stein"}),
	 "Unter dem Stein scheint sich etwas zu bewegen. Vielleicht kannst "
	 "Du ihn umdrehen, um darunter zuschauen.");



/* Definition der Funktionen */
  AddCmd( ({"pfluecke", "pflueck"}), "pfluecken");
  haselnuss = random(10)/9;
  hagebutte = random(10)/8;  
  AddCmd( ({"greif", "greife"}), "greifen");
  AddCmd( ({"drehe", "dreh"}),   "drehen");
  tierchencounter=1+random(2);
/*
  AddCmd (({"", ""}),     "fktyyy");
*/
/* Ausgaenge */

  AddExit( "suedwesten", ROOM "kiesweg2.lpc" );
  AddExit( "nordwesten", ROOM "kiesweg4.lpc");
  
/* NPCs und Objekte */
/*
  AddItem( NPC "", REFRESH_DESTRUCT);
  AddItem( NPC "", REFRESH_DESTRUCT);
  AddItem( NPC "", REFRESH_DESTRUCT);
  AddItem( "");
*/
}

/* Funktionen */

int drehen(string str)
{
  object tierchen;
  notify_fail("Was willst Du umdrehen?");
  if(!str) return 0;
  if(member( ({"stein", "stein um", "den stein"}), str) != -1 )
  {
    if(tierchencounter)
    {
      write(BS("Vorsichtig drehst Du den Stein um und erschrickst "
               "fuerchterlich als darunter ein komisches Tierchen "
               "hervorgrabbelt.\n"));
      say(TPN+" dreht einen Stein um und erschrickt fuerchterlich.\n");
      tierchen=clone_object( NPC "zufallstier.lpc" );
      if(tierchen) 
      { 
      	tierchen->move(ME,M_GO);
      }
      tierchencounter--;
      return 1;
    }
    else
    {
      write(BS("Vorsichtig drehst Du den Stein um. Leider befindet "
               "sich nichts darunter, Du musst Dich getaeuscht haben.\n"));
      say(TPN+" dreht einen Stein um findet aber nichts darunter.\n");
      return 1;
    }
  }
}

int greifen(string str)
{
  notify_fail("Wohin willst Du greifen?\n");
  if( !str ) return 0;
  if( member( ({"dorn", "dornen", "in dorn", "in dornen"}), str) != -1 )
  {
    write("Du fasst in die Dornen und verletzt Dir Deine Finger.\n");
    say( CAP_TPN+ " greift in die Dornen.\n");
    TP->reduce_hit_point(2+random(4));
    return 1;
  }
  return 0;
}

int pfluecken(string str)
{
  notify_fail("Was willst Du pfluecken?\n");
  if( !str ) return 0;
  notify_fail("Sowas kannst Du nicht pfluecken.\n");
  if( str=="hagebutte" || str=="hagebutten")
  {
    if(hagebutte)
    {
      write("Zufaellig findest Du eine Hagebutte und pflueckst sie.\n");
      say(CAP_TPN+" pflueckt eine Hagebutte.\n");
      CLONE( HAGEBUTTE, TP);
      hagebutte--;
    }
    else
      write("Leider kannst Du hier keine Hagebutte erreichen. Alle weg?\n");
    return 1;
  }
  if( str=="haselnuss" || str=="haselnuesse" )
  {
    if(haselnuss)
    {
      write("Zufaellig findest Du eine Haselnuss und pflueckst sie.\n");
      say(CAP_TPN+" pflueckt eine Haselnuss.\n");
      CLONE( HASELNUSS, TP);
      haselnuss--;
    }
    else
      write("Leider kannst Du hier keine Haselnuss erreichen. Alle weg?\n");
    return 1;
  }
  return 0;
}


