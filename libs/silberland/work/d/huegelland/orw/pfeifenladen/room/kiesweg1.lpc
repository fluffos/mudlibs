//  Projekt   : Barry's Pfeifenladen
//  Raumname  : Ein schmaler Kiesweg
//  Erstellt  : 13.03.2001 (Orw)
//  Geaendert : -


inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../def.h"

int haselnuss, hagebutte;

create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein schmaler Kiesweg" );
  SetProp(P_INT_LONG,
	 "Du befindest Dich auf einem schmalen Kiesweg der im Nordwesten "
	 "von Derlims Suedweg abzweigt. Im Nordosten ist ein kleiner Huegel "
	 "und der Kiesweg scheint um ihn herum zu fuehren. Am Rand des "
	 "Weges wachsen viele Blumen und eine Hecke die Dir Schatten "
	 "spendet. Ein wirklich ruhiges Plaetzchen, ideal um sich ein "
	 "bisschen auszuruhen.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// Standartdetails fuer die Stadt
#include DETAILS"details_stadt.h"

// Standartdetails fuer Aussen
#include DETAILS"details_aussen.h"

// Standartdetails fuer Gruppen von Raeumen (Suedweg)
#include DETAILS"details_sweg.h"


/* Detailbeschreibungen */
  AddDetail( ({"huegel", "kleiner huegel", "huegelchen"}),
	 "Im Nordosten ist ein kleiner Huegel auf dem Du einen rauchenden "
	 "Schornstein sehen kannst. Wer wohl in diesem Huegel wohnen wird? "
	 "Du beschliesst demnaechst mal dort vorbei zu schauen.");
  AddDetail( ({"schornstein"}),
	 "Ein niedlicher rauchender Schornstein.");
  AddDetail( ({"rand"}),
	 "Der Wegrand grenzt den Weg gegen die Huegel ab (oder umgekehrt). "
	 "Bunte Steine bilden eine scharfe Grenze zwischen Weg und Wegrand.");
  AddDetail( ({"kiesweg", "weg"}),
	 "Der Weg ist mit wunderhuebschen Kieselsteinchen bedeckt und "
	 "verlaeuft von der Kreuzung im Nordwesten nach Osten, rund um "
	 "den kleinen Huegel.");
  AddDetail( ({"kies", "kiesel","kieselsteinchen","kieselsteine"}),
	 "Strahlend weisse Kieselsteinchen bedecken den ganzen Weg.");
  AddDetail( ({"kreuzung", "suedweg"}),
	 "Im Nordosten kreuzt sich dieser schmale Kiesweg mit dem Derlimer "
	 "Suedweg.");
  AddDetail( ({"blumen","blume"}),
	 "Die schoensten Blumen bluehen am Rand des Kieswegs.");
  AddDetail( ({"picknick","ogerherz","herz"}),
	 "Ein Picknick waer hier toll.");
  AddDetail( ({"hoehlen","hoehle","erzbergwerk","erzbergwerks","bergwerk"}),
	 "Da wirst Du hier nichts finden, sowas gibts nur im Gebirge.");
  AddDetail( ({"trolle","troll","oger","zwerg","zwerge"}),
	 "Bist Du etwa einer?");
  AddDetail( ({"menschenfleisch","fleisch","stueckchen","stueck"}),
	 "Fuer einen Oger waer jetzt so ein Stueckchen Menschenfleisch ideal.");
  AddDetail( ({"gnade"}),
	 "Hier wirst Du keine Gnade finden.");
  AddDetail( ({"umhang"}),
	 "Hast Du etwa keinen an?");
  AddDetail( ({"ruhe"}),
	 "Hier ists ideal um auszuruhen.");
  AddDetail( ({"schatten"}),
	 "Die Hecke spendet ein wenig Schatten.");
  AddDetail( ({"grenze"}),
	 "Bunte Steine bilden eine Grenze zwischen Weg und Wegrand.");
  AddDetail( ({"gedanke"}),
	 "Ein Picknick waer hier mal nicht schlecht.");
  AddDetail( ({"gebirge"}),
	 "Das ist weit entfernt von Derlim.");
  AddDetail( ({"tiefen","tiefe"}),
	 "Zwerge fuehlen sich in den Tiefen eines Erzbergwerks wohler.");
  AddDetail( ({"strassen"}),
	 "Die Hauptstrasse liegt weiter im Norden.");




  AddDetail( ({"plaetzchen","platz"}),
	 ([ 0:
	  "Wirklich ruhig und angenehm ist es hier.\n",
	  "hobbit":
	  "Obwohl Du hier aufgewachsen bist, fasziniert Dich dieses "
	  "Plaetzchen jedesmal aufs neue.\n",
	  "zwerg":
	  "Obwohl Dir kuehle Hoehlen und die Tiefen eines Erzbergwerks "
	  "mehr zusprechen, gefaellt Dir auch dieses ruhige Plaetzchen "
	  "sehr gut.\n",
	  "troll":
	  "Auch Trolle brauchen mal Ruhe, entspann Dich und geniesse die "
	  "Sonne.\n",
	  "dunkelelf":
	  "Versteck Dich unter Deinem dunklen Umhang, denn die Sonne "
	  "zeigt heute keine Gnade.\n",
	  "oger":
	  "Mhm... jetzt waer ein Stueckchen gegrilltes Menschenfleisch "
	  "ideal. Der Gedanke an ein Picknick laesst Dein grosses Ogerherz "
	  "hoeher schlagen.\n"

	 ]) );

/* Spezielle Details */

//  AddSpecialDetail( ({""}), "zzz" );

/* Lesbare Details */
/*
  AddReadDetail( ({""}),
	 ".");
*/



/* Definition der Funktionen */
  AddCmd( ({"pfluecke", "pflueck"}), "pfluecken");
  haselnuss = random(10)/9;
  hagebutte = random(10)/8;  
  AddCmd( ({"greif", "greife"}), "greifen");
  

/* Ausgaenge */
  AddExit( "nordwesten", ANSCHLUSS2 );
  AddExit( "osten",      ROOM "kiesweg2.lpc");
  
}

/* Funktionen */
int greifen(string str)
{
  notify_fail("Wohin willst Du greifen?\n");
  if( !str ) return 0;
  if( member( ({"dorn", "dornen", "in dorn", "in dornen"}), str) != -1 )
  {
    write("Du fasst in die Dornen und verletzt Dir Deine Finger.\n");
    say( CAP_TPN+ " greift in die Dornen.\n");
    TP->reduce_hit_point(2+random(4));
    return 1;
  }
  return 0;
}

int pfluecken(string str)
{
  notify_fail("Was willst Du pfluecken?\n");
  if( !str ) return 0;
  notify_fail("Sowas kannst Du nicht pfluecken.\n");
  if( str=="hagebutte" || str=="hagebutten")
  {
    if(hagebutte)
    {
      write("Zufaellig findest Du eine Hagebutte und pflueckst sie.\n");
      say(CAP_TPN+" pflueckt eine Hagebutte.\n");
      CLONE( HAGEBUTTE, TP);
      hagebutte--;
    }
    else
      write("Leider kannst Du hier keine Hagebutte erreichen. Alle weg?\n");
    return 1;
  }
  if( str=="haselnuss" || str=="haselnuesse" )
  {
    if(haselnuss)
    {
      write("Zufaellig findest Du eine Haselnuss und pflueckst sie.\n");
      say(CAP_TPN+" pflueckt eine Haselnuss.\n");
      CLONE( HASELNUSS, TP);
      haselnuss--;
    }
    else
      write("Leider kannst Du hier keine Haselnuss erreichen. Alle weg?\n");
    return 1;
  }
  return 0;
}


