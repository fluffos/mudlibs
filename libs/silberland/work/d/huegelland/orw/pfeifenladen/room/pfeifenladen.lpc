/* Funktionen */

// Funktion um es sich auf der Couch (max.4 Spieler/Alter egal) oder
// dem Schaukelstuhl (max.1 Spieler/min. 100 Tage alt) bequem zu machen
int fktsetzen(string str)
{
  notify_fail("Worauf moechtest Du Dich setzen?\n");
  if (!str) return 0;
  if (str=="auf stuhl" || str=="auf schaukelstuhl")
    {
      if (STUHL(TP))
	{
	  write (BS("Aber Du sitzt doch schon auf dem Schaukelstuhl!\n"));
	  return 1;
	}
      if (COUCH(TP))
	{
	  write (BS("Aber Du sitzt doch auf der Couch!\n"));
	  return 1;
	}
      if(TP->QueryProp(P_AGE)<alter*43200)
        {
	  write (BS("Der Schaukelstuhl ist nur fuer wirklich alte Leute!\n"));
          say(BS(CAP(TPN)+" wollte den alten Leuten den Platz wegschnappen!\n"));
	  return 1;        
        }
      if( sizeof(stuhl)>=1 )
	{
	  write (BS("Auf dem Schaukelstuhl sitzt schon "+CAP(stuhl[0])+".\n"));
	  return 1;
	}
      write (BS("Du machst es Dir auf dem Schaukelstuhl bequem.\n"));
      say (BS(CAP(TPN)+" macht es sich auf dem Schaukelstuhl bequem.\n"));
      stuhl += ({ getuid(TP) });
      return 1; 
    }
  if (str=="auf couch" || str=="auf die couch")
    {
      if (COUCH(TP))
	{
	  write (BS("Aber Du sitzt doch schon auf der Couch!\n"));
	  return 1;
	}
      if (STUHL(TP))
	{
	  write (BS("Aber Du sitzt doch auf dem Schaukelstuhl!\n"));
	  return 1;
	}
      if( sizeof(couch)>=4 )
	{
	  write (BS("Auf der Couch sitzen schon zuviele.\n"));
	  return 1;
	}
      write (BS("Du machst es Dir auf der Couch bequem.\n"));
      say (BS(CAP(TPN)+" macht es sich auf der Couch bequem.\n"));
      couch += ({ getuid(TP) });
      return 1; 
    }
}

// Funktion wenn der Spieler noch sitzt und den Raum verlassen will
int fkt_du_sitzt_noch() 
{
  if (STUHL(TP))
  {
    write("Aber Du sitzt doch noch auf dem Schaukelstuhl!\n");
    return 1;
  }
  if (COUCH(TP))
  {
    write("Aber Du sitzt doch noch auf der Couch!\n");
    return 1;
  }
}

// Die Funktion um aufzustehen
int fktaufstehen(string str)
{
  notify_fail("Willst Du etwa aufstehen?\n");
  if (str=="auf")
    {
      if( COUCH(TP) )
	{
	  write (BS("Du stehst von der Couch auf.\n"));
	  say (BS(CAP(TPN)+" steht von der Couch auf.\n"));
	  couch -= ({ getuid(TP) });
	  return 1;
	}
      if( STUHL(TP) )
	{
	  write (BS("Du stehst von dem Schaukelstuhl auf.\n"));
	  say (BS(CAP(TPN)+" steht von dem Schaukelstuhl auf.\n"));
	  stuhl -= ({ getuid(TP) });
	  return 1;
	}
    }      
  else 0;
}


// Funktion wenn der Spieler ausloggt und noch sitzt
void BecomesNetDead(object spieler)
{
  if (STUHL(spieler))
    stuhl -= ({ getuid(spieler) });
  if (COUCH(spieler))
    couch -= ({ getuid(spieler) });   
}

// Der Spieler kann Getraenke bestellen wenn er auf der Couch oder dem
// Schaukelstuhl sitzt
int fktbestellen(string str)
{
  // Wieviel kann der Spieler trinken und wieviel hat er schon getrunken
  getrunken    = TP->QueryProp(P_DRINK);
  kann_trinken = TP->QueryProp(P_MAX_DRINK);
  besoffen     = TP->QueryProp(P_ALCOHOL);
  max_besoffen = TP->QueryProp(P_MAX_ALCOHOL);
  if (!str) 
  {
    write("Was moechtest Du bestellen?\n");
    return 1;	
  }
  if (!present("PFEIFENBARRY",TO)) // Ist Barry ueberhaupt hier?
  {
    write("Aber Barry ist doch gar nicht hier!\n");
    return 1;
  }
  if(!COUCH(TP) && 
     !STUHL(TP) ) // Sitzt der Spieler eigentlich?
  {
    write("Barry sagt: Aber mach es Dir doch vorher auf der Couch oder dem "
                       "Schaukelstuhl\n"
          "Barry sagt: bequem. An so hektische Leute verkauf ich nichts.\n");
    return 1;
  }
  if(getrunken >= kann_trinken)
  {
    write("Barry meint: Du kannst doch gar nichts mehr trinken!\n");
    return 1;
  } 
  // Tee bestellen
  if (str=="tee" || str=="einen tee")
  {
    if(TP->QueryMoney()>=teepreis) // Hat der Spieler genug Geld
    {
      TP->AddMoney(-teepreis);
      write (BS("Barry bringt Dir einen heissen Tee, der so gut duftet, "
                "dass Du sofort noch einen trinken moechtest.\n"));
      TP->AddHp(10);
      TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK)+5);
      say (BS(CAP(TPN)+" trinkt ein Taesschen Tee.\n"));
      return 1;
    }
    else
    {
      write("Der Tee kostet "+teepreis+" Muenzen und soviel hast Du nicht!\n");
      return 1;
    }  
  }
  // Marillenschnaps bestellen
  if (str=="schnaps" || str=="marillenschnaps")
  {
    if(TP->QueryMoney()>=schnapspreis) // Hat der Spieler genug Geld?
    {
      if(besoffen < max_besoffen)
      {
        TP->AddMoney(-schnapspreis);
        write (BS("Barry bringt Dir einen fruchtigen, wohlschmeckenden "
                  "Marillenschnaps. Pfoah... der ist stark!\n"));
        TP->AddHp(35);
        TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK)+15);
        TP->SetProp(P_ALCOHOL, TP->QueryProp(P_ALCOHOL)+4);
        say (BS(CAP(TPN)+" trinkt einen Marillenschnaps.\n"));
        return 1;
      }
      else
      {
        write("Barry kichert: Trink lieber ein Getraenk ohne Alkohol!\n"
              "Barry kichert: Du bist ja schon stockbesoffen!\n");
        return 1;
      }
    }
    else
    {
      write("Der Schnaps kostet "+schnapspreis+" Muenzen und soviel hast "
            "Du nicht!\n");
      return 1;
    }
  }
  // Kaffee bestellen
  if (str=="kaffee" || str=="einen kaffee")
  {
    if(TP->QueryMoney()>=kaffeepreis) // Hat der Spieler genug Geld?
    {
      TP->AddMoney(-kaffeepreis);
      write (BS("Barry bringt Dir ein Taesschen Kaffee mit leichtem "
                "Zimtgeschmack. Mhm... lecker!\n"));
      TP->AddHp(15);
      TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK)+8);
      say (BS(CAP(TPN)+" geniesst ein Taesschen Kaffee.\n"));
      return 1;
    }
    else
    {
      write("Der Kaffee kostet "+kaffeepreis+" Muenzen und soviel hast "
            "Du nicht!\n");
      return 1;
    }
  }
  // Kakao bestellen
  if (str=="kakao" || str=="einen kakao")
  {
    if(TP->QueryMoney()>=kakaopreis) // Hat der Spieler genug Geld?
    {
      TP->AddMoney(-kakaopreis);
      write (BS("Barry bringt Dir ein grosse Tasse Kakao, die Du gemuetlich "
                "austrinkst. Ah.. Das tat gut!\n"));
      TP->AddHp(15);
      TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK)+8);
      say (BS(CAP(TPN)+" geniesst eine Tasse Kakao.\n"));
      return 1;
    }
    else
    {
      write("Der Kakao kostet "+kakaopreis+" Muenzen und soviel hast "
            "Du nicht!\n");
      return 1;
    }
  }
  // Apfelssaft bestellen
  if (str=="saft" || str=="apfelsaft")
  {
    if(TP->QueryMoney()>=saftpreis) // Hat der Spieler genug Geld?
    {
      TP->AddMoney(-saftpreis);
      write (BS("Barry bringt Dir ein Glas goldgelben Apfelsaft. "));
      TP->AddHp(12);
      TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK)+6);
      say (BS(CAP(TPN)+" geniesst ein Glas Apfelsaft.\n"));
      return 1;
    }
    else
    {
      write("Der Apfelsaft kostet "+saftpreis+" Muenzen und soviel hast "
            "Du nicht!\n");
      return 1;
    }
  }
  write("Barry sagt: Lies Dir mal das Menue durch!\n");
  write("Barry sagt: "+CAP(str)+" kann ich Dir leider nicht anbieten.\n");
  return 1;
}

// Welche Getraenke der Spieler bestellen kann
int fktmenue(string str)
{
  write
  ("Getraenke    <bestelle>      Preis Alk   Speisen      <zeige>             Preis\n"
   "---------------------------------------+---------------------------------------\n"
   "Tee                             20  N  | Speisen kannst Du hier nicht          \n"
   "Apfelsaft                       45  N  | bestellen aber mit dem Befehl <zeige> \n"
   "Kaffee                          65  N  | siehst Du eine Liste der Waren        \n"
   "Kakao                           65  N  | die Barry hier anbietet. Vielleicht   \n"
   "Marillenschnaps                125  J  | ist auch etwas zu essen dabei.        \n");
  return 1;
}


int fktschaukeln(string str)
{
  notify_fail("Was oder womit moechtest Du schaukeln?\n");
  if (!str) return 0;
  if (str=="schaukelstuhl"     || 
      str=="stuhl"             ||
      str=="mit schaukelstuhl" ||
      str=="mit stuhl")
  {
    if(STUHL(TP))
    {
      write("Du lehnst Dich zurueck und schaukelst gemuetlich hin und her.\n");
      say(TPN+" lehnt sich im Schaukelstuhl zurueck und beginnt gemuetlich "
          "zu schaukeln.\n");
      return 1;
    }
    else
    {
      write("Du tippst den Schaukelstuhl an und der schaukelt ein paar "
            "mal hin und her.\n");
      say(TPN+" tippt den Schaukelstuhl an und bringt ihn zum Schaukeln.\n");
      return 1;
    }
  }
  return 0;
}

/* Funktionen der AddSpecialDetails */

string DetailCouch()
{
  if( COUCH(TP))
  {
    return 
      "Du sitzt auf einer weichen bequemen Couch, am liebsten wuerdest Du "
      "nie wieder aufstehen.\n";
  }
  else
  {
  if( sizeof(couch)==0 )
    return 
      "Eine weiche bequeme Couch, ideal um sich daraufzusetzen und "
      "auszuspannen.\n";
  if( sizeof(couch)==1 )
    return 
      "Eine weiche bequeme Couch, ideal um sich daraufzusetzen und "
      "auszuspannen. Im Moment sitzt "+CAP(couch[0])+" auf der Couch.\n";
  if( sizeof(couch)==2 )
    return 
      "Eine weiche bequeme Couch, ideal um sich daraufzusetzen und "
      "auszuspannen. Im Moment sitzen "
      +CAP(couch[0])+" und "+CAP(couch[1])+" auf der Couch.\n";
  if( sizeof(couch)==3 )
    return 
      "Eine weiche bequeme Couch, ideal um sich daraufzusetzen und "
      "auszuspannen. Im Moment sitzen "
      +CAP(couch[0])+", "+CAP(couch[1])+" und "+CAP(couch[2])+
      " auf der Couch.\n";
  else
    return 
      "Eine weiche bequeme Couch, ideal um sich daraufzusetzen und "
      "auszuspannen. Im Moment sitzen "
      +CAP(couch[0])+", "+CAP(couch[1])+", "+CAP(couch[2])+" und "
      +CAP(couch[3])+
      " auf der Couch.\n";
  }
}

string DetailStuhl()
{
  if( STUHL(TP))
  {
    return BS( 
      "Du sitzt gemuetlich auf dem alten Schaukelstuhl und entspannst "
      "Deinen alten schlaffen Koerper.\n");
  }
  else
  {
  if( sizeof(stuhl)==0 )
    return BS(
      "Ein uralter Schaukelstuhl steht neben dem Tisch. Er ist fuer "
      "alte gebrechliche Leute gedacht, die hier vorbeikommen um "
      "Barry Ledersohle zu besuchen oder hier alte Geschichten zu "
      "erzaehlen.\n");
  else
    return BS(
      "Ein uralter Schaukelstuhl steht neben dem Tisch. Er ist fuer "
      "alte gebrechliche Leute gedacht, die hier vorbeikommen um "
      "Barry Ledersohle zu besuchen oder hier alte Geschichten zu "
      "erzaehlen. Im Moment sitzt "+CAP(stuhl[0])+" auf dem Schaukelstuhl.\n");
  }
}

string DetailLloth()
{
  if(TP->QueryProp(P_RACE)=="dunkelelf")
  {
    TO->SetProp(P_KILL_NAME, "Die Macht Lloths");
    TP->do_damage(10)+random(5);
    TO->SetProp(P_KILL_NAME, 0);
    return "Du weisst nicht wer Deine Goettin ist! Das musst Du mit "
           "Deinem Leben bezahlen!\n";
  }
  else
    return "Worueber sprichst Du eigentlich?\n";
}
