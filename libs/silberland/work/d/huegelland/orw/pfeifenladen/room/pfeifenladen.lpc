	 "nicht wie all die anderen die Du kennst. Die Fenster in den "
	 "Waenden und in der Eingangstuer sind aus Buntglas und brechen "
	 "das Licht in alle Regenbogenfarben. Eine wunderschoene "
	 "Holzverkleidung ziert die Decke. In einer Ecke befindet sich "
	 "ein Tisch und eine grosse Couch. Auch ein uralter Schaukelstuhl "
	 "steht an einem sonnigen Platz am Fenster. Eine lange Ladentheke, "
	 "auf der eine kleine kupferne Waage steht, erstreckt sich entlang "
	 "der Nordseite des Raums.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_NO_TPORT,NO_TPORT_OUT);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
