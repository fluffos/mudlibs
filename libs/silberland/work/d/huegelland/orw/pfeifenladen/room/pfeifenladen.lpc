// Alter in Tagen - wird benoetigt um sich auf den Schaukelstuhl zu setzen
int alter        =100;

// Preise fuer Getraenke die man bestellen kann wenn man es sich auf
// der Couch oder dem Schaukelstuhl bequem gemacht hat
int teepreis     = 20;
int saftpreis    = 45;
int kaffeepreis  = 65;
int kakaopreis   = 65;
int schnapspreis =125;

// Wieviel hat der Spieler schon getrunken, und wieviel kann er trinken
int getrunken;
int kann_trinken;
int besoffen;
int max_besoffen;


// Wer sitzt auf der Couch oder dem Schaukelstuhl
#define STUHL(wer) (member(stuhl, getuid(wer))!=-1)
string *stuhl=({});
#define COUCH(wer) (member(couch, getuid(wer))!=-1)
string *couch=({});

// Saves von Barry
string geruecht;
string *geruechteverbreiter;
SetGeruecht(string newgeruecht)
{
  geruecht = newgeruecht;
}
SetGeruechteverbreiter(string *newgeruechteverbreiter)
{
  geruechteverbreiter = newgeruechteverbreiter;
}
QueryGeruecht()
{
  return geruecht;
}
QueryGeruechteverbreiter()
{
  return geruechteverbreiter;
}

