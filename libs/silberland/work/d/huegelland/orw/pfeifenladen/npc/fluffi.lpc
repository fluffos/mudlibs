//  Projekt   : Barry's Pfeifenladen
//  NPC Name  : Fluffi, der kleine Pudel
//  Erstellt  : 09.06.2001 (Orw)
//  Geaendert : -

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <npc.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Fluffi, der kleine Pudel");
  SetProp(P_LONG,
    "Tobi's kleiner Pudel Fluffi laeuft vergnuegt in der Werkstatt "
    "herum. Er hat ein schoenes silbergraues Fell und lustige Haengeohren. "
    "In seinem Fell haben sich einige Holzspaene verfangen.");
  SetProp(P_NAME, "Fluffi");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"fluffi", "pudel", "hund", "TOBIHAUSTIER"}));
  set_living_name("fluffi");

  create_default_npc(10);
  SetProp(P_HANDS, ({
    " mit seinen Pfoten",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Hund");
  SetProp(P_SIZE, 40);
  SetProp(P_ALIGN, random(200));
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "springt aus dem Korb");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "springt aus dem Korb");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_MURDER_MSG, "GRRR!");
  SetProp(P_KILL_NAME, "Fluffi");
  SetProp(P_KILL_MSG, "Wuff Wuff!");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Fluffi will Deine Sachen nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,10);
  AddSpell(1,150,
    "Fluffi beisst Dir ins Schienbein.\n",
    "Fluffi beisst @WEM ins Schienbein.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,100,
    "Fluffi kratzt Dich mit seinen Pfoten.\n",
    "Fluffi kratzt @WEN mit seinen Pfoten.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Fluffi wedelt mit seinem Schwanz.\n",
    "Fluffi flitzt durch die Werkstatt.\n",
    "Fluffi laeuft um Dich herum.\n",
    "Fluffi hechelt laut.\n",
    "Fluffi legt sich unter die Werkbank.\n"}) );
  SetAttackChats(10, ({
    "Fluffi knurrt boese.\n",
    "Fluffi verteidigt sein Herrchen.\n",
    "Fluffi versteckt sich unter der Werkbank.\n",
    "Fluffi bellt wuetend.\n"}) );

  SUID;
}

// init
init()
{
  ::init();
  if(TP && TP->id("PFEIFENTOBI")) AddDefender(TP);  
}

// Damit Fluffi sein Herrchen verteidigt
void InformDefend(object enemy)
{
  Kill(enemy);
}


// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt Fluffi.\n");
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Fluffi hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}



// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "schaut Dich mit grossen Augen an.",
        "schaut "+TPN+" mit grossen Augen an.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "versteckt sich unter der Werkbank.",
        "versteckt sich unter der Werkbank.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "laeuft vergnuegt herum.",
        "laeuft vergnuegt herum.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "gnurrt Dich boese an.",
        "gnurrt "+TPN+" boese an.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "fletscht seine Zaehne.",
        "fletscht seine Zaehne.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "wedelt mit seinem Schwaenzchen.", 
        "wedelt mit seinem Schwaenzchen.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "hechelt Dich an.",
        "hechelt "+TPN+" an.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "reibt sich an Deinen Beinen.",
        "reibt sich an den Beinen von "+TPN+".");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "flitzt um Dich herum.",
        "flitzt um "+TPN+" herum.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "schmiegt sich an Dich.",
        "schmiegt sich an "+TPN+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
