/* Funktionen */

// Tobi ueberprueft ob der Spieler was bestellt hat und obs schon fertig ist
// Die fertige Pfeife wird dann noch mit dem Material des Gegenstandes aus
// dem sie gemacht wurde versehen und ein paar andere Sachen werden uebergeben
int pfeife_abholen(string str)
{
  notify_fail("Was moechtest Du abholen?\n");
  if(!str) return 0;
  if(str=="pfeife ab" || str=="bestellung ab")
  {
    object pfeife;
    object obj;
    string spieler;
    spieler=getuid(TP);
    if(member(bzeit, spieler))
    {
      if (!objectp((obj = produkt[spieler])))
      {
        write(break_string("Der Gegenstand, aus dem ich die Pfeife machen "
              "sollte, ist leider verschwunden, es tut mir echt leid.",
              78, "Tobi sagt: "));
        return 1;
      }
      if((6-(time()-bzeit[spieler]))<0) // 10 min Fertigungsdauer
      {
        write("Tobi sagt: Ich hoffe Du freust Dich ueber die Pfeife die ich "
              "Dir aus \n"
              "Tobi sagt: "+obj->name(WEM,1)+" gemacht habe.\n"
              "Tobi gibt Dir die Holzpfeife.\n");
        say("Tobi gibt "+TPN+" eine Holzpfeife.\n",TP);
        // Ab hier wird die neue Pfeife an den Gegenstand aus dem sie gemacht
        // wurde angepasst
        pfeife=clone_object(OBJ"holzpfeife.lpc"); 
        pfeife->set_pfeifenwert(obj->QueryMaterialGroup(MATGROUP_WOOD)/10-5);
        pfeife->SetProp(P_MATERIAL,
          obj->QueryProp(P_MATERIAL));
        pfeife->SetProp(P_GEGENSTAND,
          obj->name(WEM,0));
        write_file(LOG "pfeifen.log",
          ctime()+": "+TPN+" holt eine Pfeife ab.\n"
          "Sie wurde aus "
          +obj->name(WEM,0)+" gemacht.\n");
	obj->remove();
        pfeife->move( this_player(), M_NOCHECK );
        bzeit   -= ([spieler]);
        produkt -= ([spieler]);
        WERKSTATT->set_bzeit(bzeit);
        WERKSTATT->set_produkt(produkt);
        return 1;
      }
      if((600-(time()-bzeit[spieler]))<60) // unter einer Minute wird die
      {                                    // Restzeit in Sekunden angezeigt
        write("Tobi sagt: Du musst noch "+(600-(time()-bzeit[spieler]))+
              " Sekunden warten. Es dauert halt ein \n"
              "Tobi sagt: wenig um eine Pfeife aus "+obj->name(WEM,1)+
              " zu machen.\n");
        say("Tobi sagt: Du musst noch "+(600-(time()-bzeit[spieler]))+" "
            "Sekunden warten, damit Du Dir Deine\n"
            "Tobi sagt: Pfeife abholen kannst, "+TPN+".\n",TP);
        return 1;
      }
      else
      {
        write("Tobi sagt: Du musst noch "+(10-((time()-bzeit[spieler])/60))+
              " Minuten warten. Es dauert halt ein \n"
              "Tobi sagt: wenig um eine Pfeife aus "+obj->name(WEM,1)+
              " zu machen.\n");
        say("Tobi sagt: Du musst noch "+(10-((time()-bzeit[spieler])/60))+" "
            "Minuten warten, damit Du Dir Deine\n"
            "Tobi sagt: Pfeife abholen kannst, "+TPN+".\n",TP);
        return 1;
      }
    }
    else
    {
      write("Tobi sagt: Aber Du hast doch gar nichts bestellt...\n");
      return 1;
    }
  }
  return 0;
}

// Tobi ueberprueft das Inventar des Spielers und gibt alle
// Gegenstaende die einen hoeheren Holzanteil als 50% haben
// nach einer kurzen Sequenz in einer Liste aus
int inventory_check(string str)
{
  notify_fail("Wen moechtest Du Was durchsuchen lassen?\n");
  if(!str) return 0;
  if (str=="tobi inventar durchsuchen" || 
      str=="tobi durchsuchen" ||
      str=="inventar durchsuchen")
  {
    if(beschaeftigt==0)
    {
      write("Tobi sagt: Mal gucken was Du so bei Dir hast...\n");
      say("Tobi sagt: Mal gucken was Du so bei Dir hast, "+TPN+"...\n",TP);
      TP->SetProp(P_PARALYZED,
      ([PARALYZE_TIME:7,
        PARALYZE_MSG:"Warte mal bis Tobi Dein Inventar durchsucht hat.\n",
        PARALYZE_MSG_OTHER:"",
        PARALYZE_END:"",
        PARALYZE_END_OTHER:""]));
      beschaeftigt=1;
      call_out("inventar",3);
      return 1;
    }
    if(beschaeftigt==1)
    {
      write(BS("Tobi ist gerade mit etwas anderem beschaeftigt, schau spaeter "
            "nochmal vorbei.\n"));
      return 1;
    }
  }
  return 0;
}

int inventar()
{
    write("Tobi schaut sich all Deine Reichtuemer an.\n");
    say("Tobi schaut sich "+TPN+"s Reichtuemer an...\n",TP);
    call_out("inventar1",3);
    return 1;
}

int inventar1()
{
    write("Tobi kramt in Deinem Inventar herum...\n");
    say("Tobi kramt in "+TPN+"s Inventar herum...\n",TP);
    call_out("inventar2",3);
    return 1;
}

int inventar2()
{
    write("Tobi gruebelt: Hm... was haben wir da so alles...\n");
    say("Tobi gruebelt: Hm... was haben wir da so alles...\n",TP);
    call_out("inventar3",3);
    return 1;
}

int inventar3()
{
  object *ob;
  string liste;
  int i;
  liste = "";
  ob=deep_inventory(TP);
  for (i=0;i<sizeof(ob);i++) // Hier werden alle Objects die mehr als 50%
  {                          // Holzanteil haben in die Liste geschrieben
    if((ob[i]->QueryMaterialGroup(MATGROUP_WOOD))>=50)
    {
      liste+=sprintf("%25-s %s \n",CAP(ob[i]->name(WER,0)),
                   HOLZ[(ob[i]->QueryMaterialGroup(MATGROUP_WOOD))/10-5]);
    }
  }
  if(strlen(liste))
  {
    write("Tobi sagt: Folgende Sachen hab ich gefunden...\n"
          "Tobi sagt: Wenn Du sie mir gibst, mache ich Dir eine huebsche "
          "Pfeife daraus.\n");
    say("Tobi zaehlt "+TPN+" die Gegenstaende auf welche er gefunden hat.\n",TP);
    beschaeftigt=0;
    TP->More(liste); // Liste wird ausgegeben - mit Name 
                     // und ungefaehrem Holzanteil der gefunden Objekte
  }
  else
  {
    write("Tobi sagt: Leider hab ich nichts passendes gefunden...\n");    
    say("Tobi sagt: Leider hab ich nichts gefunden, "+TPN+".\n",TP);
    beschaeftigt=0;
  }
  return 1;
}

// Reaktionen wenn Tobi etwas vom Spieler bekommt
void give_notify(object ob)
{
  if(beschaeftigt==0)
  {
    if((ob->QueryMaterialGroup(MATGROUP_WOOD))>=50)
    {
      gegenstand=ob;
      preis=holzpfeifenpreis-(gegenstand->QueryMaterialGroup(MATGROUP_WOOD));
      beschaeftigt=1;
      write("Tobi sagt: OK, Ich mach Dir eine Pfeife draus!\n"
            "Tobi sagt: Das kostet Dich aber "+preis+" Muenzen...\n"
            "Tobi sagt: Willst Du eine herstellen lassen? (ja/nein)\n");
      say("Tobi tuschelt irgendetwas mit "+TPN+".\n",TP);
      input_to("get_auftrag");
      return;
    }
    if(ob->QueryMaterialGroup(MATGROUP_WOOD))
    {
      write(BS("Tobi sagt: Der Holzanteil ist zu gering um eine "
            "Pfeife daraus zu bauen...\n"));
      say("Tobi tuschelt irgendetwas mit "+TPN+".\n",TP);
      ob->move(this_player(),M_NOCHECK);
      write("Tobi gibt Dir "+ob->name(WEN, 1)+" wieder zurueck.\n");
      say("Tobi gibt "+TPN+" "+ob->name(WEN, 1)+" wieder zurueck.\n",TP);
    }
    else
    {
      write(BS("Tobi sagt: Da ist ja gar kein Holz drin! Daraus kann ich "
               "keine Pfeife bauen...\n"));
      say("Tobi tuschelt irgendetwas mit "+TPN+".\n",TP);
      ob->move(this_player(),M_NOCHECK);
      write("Tobi gibt Dir "+ob->name(WEN, 1)+" wieder zurueck.\n");
      say("Tobi gibt "+TPN+" "+ob->name(WEN, 1)+" wieder zurueck.\n",TP);
    }
  }
  else
  {
    ::give_notify(ob);
  }
}

// Antwortet der Spieler mit "j" wird die Pfeifenbausequenz ausgefuehrt
get_auftrag(string str)
{
  string antwort;
  int bestellzeit;
  string spieler;
  spieler=getuid(TP);
  antwort=lower_case(str);
  if(antwort=="j" ||
     antwort=="ja")
  {
    if(TP->QueryMoney()>=preis)
    {
      if (!member(bzeit, spieler))
      {
        write("Tobi sagt: Nun gut dann werde ich jetzt mit der Herstellung "
              "beginnen.\n"
              "Tobi sagt: Frag mich nach der Bestellung wenn Du wissen willst "
              "wie lang ich\n"
              "Tobi sagt: noch brauche.\n");
        say(TPN+" gibt bei Tobi eine Bestellung auf.\n",TP);
        TP->AddMoney(-preis);
        bestellzeit=time();
        bzeit   += ([spieler:bestellzeit]);
        produkt += ([spieler:gegenstand]);
        WERKSTATT->set_bzeit(bzeit);
        WERKSTATT->set_produkt(produkt);
        beschaeftigt=0; 
      }
      else
      {
        write("Tobi sagt: Du hast gerade eine Bestellung bei mir laufen.\n");
        beschaeftigt=0;
        gegenstand->move(this_player(),M_NOCHECK);
        write("Tobi gibt Dir "+gegenstand->name(WEN, 1)+" wieder zurueck.\n");
        say("Tobi gibt "+TPN+" "+gegenstand->name(WEN, 1)+" wieder zurueck.\n",TP);
      }
    }
    else
    {
      write("Tobi sagt: Leider hast Du die "+preis+" Muenzen nicht...\n"
            "Tobi sagt: Komm mit dem Geld wieder und ich werd Dir aus "
            +gegenstand->name(WEM,1)+" \n"
            "Tobi sagt: eine Pfeife bauen.");
      beschaeftigt=0;
      gegenstand->move(this_player(),M_NOCHECK);
      write("Tobi gibt Dir "+gegenstand->name(WEN, 1)+" wieder zurueck.\n");
      say("Tobi gibt "+TPN+" "+gegenstand->name(WEN, 1)+" wieder zurueck.\n",TP);
    } 
  }
  else
  {
    write("Tobi sagt: Na gut dann eben nicht...\n");
    beschaeftigt=0;
    gegenstand->move(this_player(),M_NOCHECK);
    write("Tobi gibt Dir "+gegenstand->name(WEN, 1)+" wieder zurueck.\n");
    say("Tobi gibt "+TPN+" "+gegenstand->name(WEN, 1)+" wieder zurueck.\n",TP);
  }
}


// Spezielle AddInfos
string uhrzeitinfo(string key)
{
  return "Hmm... mal gucken... es ist jetzt genau... \n"+dtime()+".\n";
}

string bestellungsinfo(string key)
{
  string spieler;
  object obj;

  spieler=getuid(TP);  
  if(member(bzeit, spieler))
  {
    if (!objectp((obj = produkt[spieler])))
    {
      return "Der Gegenstand, aus dem ich die Pfeife machen "
            "sollte, ist leider verschwunden, es tut mir echt leid.";
            
    }
    if((600-(time()-bzeit[spieler]))<0) // Ist die Pfeife fertig?
    {
      say(TPN+" fragt Tobi nach der Bestellung.\n",TP);
      return "Die Pfeife die ich fuer Dich aus "+obj->name(WEM,1)+
             " machen sollte ist jetzt fertig. Du bekommst sie mit "
             "\"hole pfeife ab\".";
    }
    if((600-(time()-bzeit[spieler]))<60) // Weniger als eine Minute Restzeit
    {                                       // werden Sekunden angezeigt
      say(TPN+" fragt Tobi nach der Bestellung.\n",TP);
      return "Du hast mir "+obj->name(WEN,0)+" gegeben und ich "
             "mach Dir daraus eine Pfeife. Ich brauche aber noch "
             +(600-(time()-bzeit[spieler]))+" Sekunden um sie "
             "fertigzustellen.";
    }
    else                                    // Es dauert noch...
    {
      say(TPN+" fragt Tobi nach der Bestellung.\n",TP);
      return "Du hast mir "+obj->name(WEN,0)+" gegeben und ich "
             "mach Dir daraus eine Pfeife. Ich brauche aber noch "
             +(10-((time()-bzeit[spieler])/60))+" Minuten um sie "
             "fertigzustellen.";
    }
  }
  else
  {
    say(TPN+" fragt Tobi nach der Bestellung.\n",TP);
    return "Du hast nichts bei mir bestellt.";
  }
}

// Damit Tobi seinen Pudel verteidigt
void InformDefend(object enemy)
{
  Kill(enemy);
}


// init
init()
{
  ::init();
  if(ENEMY(TP))
  {
    say("Tobi schreit: Stirb, "+TPN+"!!!\n");
    TO->Kill(TP);
    return;
  }
  if(TP && TP->id("TOBIHAUSTIER")) AddDefender(TP);
  if(interactive(TP)&& member(begruesst,getuid(TP))==-1) 
    call_out("hallo",0);
  if(TP->id("TOBIHAUSTIER"))
  {
    call_out("fluffistreicheln",2);
    return;
  }
  if(TP->id("feuerwusel")) // Feuerwusel mag der liebe Tobi gar nicht...
  {
    call_out("wuseltoeten",3);
    return;  
  }
  if(TP->id("feuerelementar")) // Feuerelementare ebenfalls nicht...
  {
    call_out("elementartoeten",3);
    return;  
  }
}

// Begruessung des Spielers wenn er/sie den Laden betritt
void hallo() 
{ 
  if( MENV!=ENV(TP) ) return;
  begruesst += ({ getuid(TP) });  
  if (TP->QueryProp(P_RACE)=="Hobbit") // Hobbits werden mit ihrem Namen
  {                                    // angesprochen
    switch(random(3))         
    {
    case 0:
      tell_room(environment(TO), "Tobi sagt: Hallo, wie gehts "+TPN+"?\n"
      "Tobi sagt: Freut mich, dass Du mich mal wieder besuchst!\n");
      break;
    case 1:
      tell_room(environment(TO), "Tobi freut sich: Hallo, "+TPN+"!\n");
      break;
    case 2:
      tell_room(environment(TO), "Tobi grinst: Hi, schoen, dass Du mich "
                                 "besuchst, "+TPN+"!\n");
      break;
    default:
      tell_room(environment(TO), "Tobi sagt: Hi!\n");
    }
  }
  else                                  // Andere Rassen werden nicht
  {                                     // mit dem Namen angesprochen
    switch(random(3))         
    {
    case 0:
      tell_room(environment(TO), "Tobi sagt: Hallo, wie gehts "
      +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"Frau":"Herr")+" "
      +capitalize((string)this_player()->QueryProp(P_RACE))+"?\n");
      break;
    case 1:
      tell_room(environment(TO), "Tobi staunt: Oh! Ein"
      +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"e":"")+" "
      +capitalize((string)this_player()->QueryProp(P_RACE))+""
      +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"in":"")+" "
      "in meiner kleinen Werkstatt?\n"
      "Tobi staunt: Hat sich meine Handwerkskunst schon so weit "
      "herumgesprochen?\n");
      break;
    case 2:
      tell_room(environment(TO), "Tobi sagt: Was fuehrt Dich zu mir, "
      +capitalize((string)this_player()->QueryProp(P_RACE))+""
      +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"in":"")+"?\n");
      break;
    default:
      tell_room(environment(TO), "Tobi sagt: Hi!\n");
    }
  }
}

