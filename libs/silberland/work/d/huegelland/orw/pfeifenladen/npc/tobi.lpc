void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  veraergert = ({});

  SetProp(P_SHORT, "Tobi Ledersohle");
  SetProp(P_LONG,
    "Vor Dir steht ein kleiner staemmiger Hobbit. Er ist ein Meister "
    "im Pfeifenbauen. Seine braunen wuscheligen Haare sind sorgfaeltig "
    "ueber die teils ziemlich kahlen Stellen gekaemmt. Hobbits werden ja "
    "allgemein als sehr geschickt bezeichnet, doch Tobi scheint in dieser "
    "Faehigkeit alle zu uebertreffen. Du koenntest stundenlang seine "
    "Schnitzkunst und die Gewandheit mit der er die verschiedensten "
    "Materialien bearbeitet bewundern. Die Haare an seinen Armen und "
    "Fuessen sind mit vielen Saegespaenen uebersaet.");
  SetProp(P_NAME, "Tobi");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId(({"tobi", "ledersohle", "pfeifenhersteller","hersteller","hobbit",
          "PFEIFENTOBI"}));
  enable_commands();
  set_living_name("tobi");

  create_default_npc(18);
  SetProp(P_HANDS, ({
    " mit seinen behaarten Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_MAX_HP, QueryProp(P_MAX_HP)+random(20));
  SetProp(P_BODY, QueryProp(P_BODY)+random(10));
  SetProp(P_XP, QueryProp(P_XP)+100*100); // Bonus fuer Spells
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 95+random(6));
  SetProp(P_ALIGN, 300+random(100));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_TERROR    : -0.1,
         DT_MAGIC     : -0.1,
         DT_SOUND     :  0.2,
         DT_LIGHTNING :  0.1,
         DT_POISON    :  0.1,
         DT_FIRE      : -1.0 ]) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_REJECT,
    ({ REJECT_GIVE, "Tobi ist im Moment zu beschaeftigt und gibt @WEN wieder "
                    "zurueck.\n" }) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt toetlich getroffen zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Was war das jetzt fuer ein Mist?");
  SetProp(P_KILL_NAME, "Tobi Ledersohle");
  SetProp(P_KILL_MSG, "Pah! Hast Dich wohl ein wenig ueberschaetzt!");

/* Details */

  AddDetail( ({"meister"}),
    "Tobi ist ein wahrer Meister der Pfeifenherstellung.");
  AddDetail( ({"haare"}),
    "Tobi hat braunes wuscheliges Haar das am Kopf schon einige kahle "
    "Stellen aufweist.");
  AddDetail( ({"stellen","stelle","glatze"}),
    "Sorgfaelltig hat Tobi seine Haare ueber seine Glatze gekaemmt.");
  AddDetail( ({"arme","fuesse"}),
    "Tobis Arme und Fuesse sind mit Saegespaenen uebersaet.");

/* Infos */

// Defaultinfos
  AddInfo(DEFAULT_INFO, ({
    "zuckt mit den Schultern.\n",
    "denkt . o O ( So eine bloede Frage! )\n",
    "fragt: Redest Du immer soviel Mist?\n",
    "fragt: Bist Du das erste Mal hier?\n",
    "sagt: Hmm.. fuer solchen Bloedsinn hab ich keine Zeit!\n",
    "fragt: Wie bitte?\n",
    "fragt: Wie meinst Du das?\n",
    "fragt: Kannst Du das nochmal wiederholen?\n",
    "sagt: Ich glaub, ich hoer schlecht!\n",
    "gruebelt: Hmmm....., tja...., soso....\n",
    "sagt: Ach wirklich? Was Du nicht sagst!\n",
    "kratzt sich hinter dem Ohr.\n",
    "schaut Dich mit grossen Augen an.\n",
    "schaut Dich erstaunt an.\n",
    "sagt: Das meinst Du doch nicht ernst!\n",
    "staunt: Ach wirklich! Das ist mir aber ganz neu!\n",
    "sagt: Das hab ich mich auch schon immer gefragt.\n",
    "sagt: Du kannst aber komische Fragen stellen!\n",
    "sagt: Ich hab noch nie von sowas gehoert!\n",
    "beachtet Dich gar nicht.\n",
    "seufzt.\n",
    "verwuschelt Deine Haare.\n",
    "ignoriert Deine dummen Fragen.\n",
    "dreht sich uninteressiert weg.\n",
    "kichert.\n",
    "grinst Dich an.\n",
    "gruebelt.\n",
    "knuddelt Dich.\n",
    "bleibt stumm.\n",
    "fragt: Wie heisst Du ueberhaupt?\n",
    "sagt: Lass uns das Thema wechseln.\n",
    "lacht Dich aus.\n",
    "sagt: Nein, Nein und nochmals NEIN!\n",
    "sagt: Das ist doch alles Bloedsinn!\n",
    "fragt sich: Warum red ich eigentlich mit Dir?\n",
    "laechelt Dich an.\n",
    "meint: Frag doch jemand anders!\n" }) );

