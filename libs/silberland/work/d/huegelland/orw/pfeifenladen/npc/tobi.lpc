string *begruesst=({});

#define HOLZ ({"...zur Haelfte aus Holz", \
               "...zu mehr als der Haelfte aus Holz", \
               "...zu fast dreiviertel aus Holz", \
               "...zu mehr als dreiviertel aus Holz", \
               "...fast ausschliesslich aus Holz", \
               "...aus reinem Holz"})

mapping bzeit   = ([]); // Besteller und Bestellzeit
mapping produkt = ([]); // Besteller und Gegenstand
#define WERKSTATT ROOM "pfeifenwerkstatt.lpc"

#define EMASTER "/d/huegelland/orw/pfeifenladen/enemymaster.lpc"
#define ENEMY(wer) (member(EMASTER->QueryFeinde(), getuid(wer))!=-1)
               
int holzpfeifenpreis = 800;
int preis;         // Holzpfeifenpreis minus Holzanteil des Gegenstandes
                   // je reiner das Holz um so leichter fuer Tobi eine 
                   // Pfeife zu machen
int beschaeftigt;  // 1 wenn Tobi gerade mit einem Kunden verhandelt
                   // 0 wenn Tobi gerade Zeit hat
object gegenstand; // wird benoetigt damit Tobi in get_auftrag den 
