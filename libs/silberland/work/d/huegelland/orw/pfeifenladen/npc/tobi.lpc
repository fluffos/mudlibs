// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt Tobi.\n");
  EMASTER->AddFeinde(getuid(TP));
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Tobi hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "kitzelt Dich beruhigend am Kinn.",
        "kitzelt "+TPN+" beruhigend am Kinn.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TPN+".");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "waelzt sich vor Lachen auf dem Boden.",
        "waelzt sich vor Lachen auf dem Boden.");
      break;
    case "fies":
      if ( member(veraergert,getuid(TP)) != -1 )
      	call_out( "reaction_pudelruf", 0, TP,
      	  "hat genug von Deinen Frechheiten.",
      	  "hat genug von "+TP->name(WESSEN)+" Frechheiten." );
      else 
        call_out( "reaction", 0, TP,
          "schreit: Verdammt, mach das nicht nochmal, "+TPN+"!",
          "schreit: Verdammt, mach das nicht nochmal, "+TPN+"!" );
        veraergert += ({ getuid(TP) });  
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "schreit: RAUS! Ich will Dich hier nicht mehr sehen!",
        "schreit: RAUS! Ich will Dich hier nicht mehr sehen, "+TPN+"!");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt froehlich.", 
        "laechelt froehlich.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "erroetet: Oh, komm doch oefter vorbei bei mir.",
        "erroetet: Oh, komm doch oefter vorbei bei mir, "+TPN+".");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "knuddelt Dich mit seinen kraeftigen haarigen Armen.",
        "knuddelt "+TPN+" mit seinen kraeftigen haarigen Armen.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TPN+" an.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "drueckt Dich an seine behaarte Brust und troestet Dich.",
        "drueckt "+TPN+" an seine behaarte Brust und troestet "
        +TP->QueryPronoun(WEN)+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

void reaction_pudelruf(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  veraergert -= ({ getuid(TP) }); 
  call_other(WERKSTATT, "tobi_verteidigung", 1);
}

reset()
{
  ::reset();
  begruesst = ({});
}
