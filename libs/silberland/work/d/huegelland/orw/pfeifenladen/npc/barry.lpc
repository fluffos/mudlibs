  case 0:
    say(BS("Barry laesst "+ob->name(WEN,2)+" pruefend durch seine Finger gleiten."));
    call_out("in_kiste2", 8+random(6), ob);
    break;
  case 1:
    say(BS("Barry untersucht "+ob->name(WEN,2)+" genau."));
    call_out("in_kiste2", 8+random(6), ob);
    break;
  case 2:
    say(BS("Barry schaut sich "+ob->name(WEN,2)+" genau an."));
    call_out("in_kiste2", 8+random(6), ob);
    break;
  }
}

void in_kiste2(object ob) 
{
  switch(random(3))
  {
  case 0:
    say(BS("Barry kichert gluecklich."));
    call_out("in_kiste3", 8+random(6), ob);
    break;
  case 1:
    say(BS("Barry ist ganz stolz auf "+ob->name(WEN,2)+"."));
    call_out("in_kiste3", 8+random(6), ob);
    break;
  case 2:
    say(BS("Barry freut sich sehr ueber "+ob->name(WEN,2)+"."));
