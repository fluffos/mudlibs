  geruecht = SAVERAUM->QueryGeruecht();
  geruechteverbreiter = SAVERAUM->QueryGeruechteverbreiter();
}

// Funktion um Geruechte zu verbreiten :-))
int geruecht(string str)
{
  str = TP->_unparsed_args();
  notify_fail("Welches Geruecht moechtest Du verbreiten?\n ");
  if(!str) return 0;
  if(geruechtecounter==1)
  {
    if (GERUECHTEVERBREITER(TP))
    {
      write("Barry sagt: Ich muss mal dein erstes Geruecht verdauen!\n");
      return 1;
    }
    write("Barry sagt: Im Moment muss ich mal das Geruecht von "
          +CAP(geruechteverbreiter[0])+" verdauen!\n");
    return 1;
  }
  geruechteverbreiter=({});
  geruecht="";
  write("Leise fluesterst Du Barry etwas ins Ohr.\n");
  tell_room(environment(this_player()),
        TPN+" fluestert Barry etwas ins Ohr!\n",({ TP }));
  geruechtecounter=1;
  geruecht=str;
  geruechteverbreiter += ({ getuid(TP) });
  write_file(LOG "geruechte.log",
    ctime()+": "+CAP(geruechteverbreiter[0])+":\n"+geruecht+"\n");
  SAVERAUM->SetGeruecht(geruecht);
  SAVERAUM->SetGeruechteverbreiter(geruechteverbreiter);
  return 1;
}

// Barry die alte Tratschtante erzaehlt die Geruechte natuerlich
// jedem....
string geruechteinfo(string key)
{
  if( sizeof(geruechteverbreiter)==0 )
  {
    return "Ich kenne leider keine neuen Geruechte! Mit \"geruecht <text>\" "
           "kannst Du mir eins zufluestern.";
  }
  if (GERUECHTEVERBREITER(TP))
  {
    write("Barry sagt: Du hast es mir doch vorhin gerade erzaehlt...\n");
    tell_room(environment(this_player()),
          "Barry fluestert "+CAP(TPN)+" das neueste Geruecht ins Ohr!\n",
          ({ TP }));
    return geruecht+"\nMit \"geruecht <text>\" kannst Du mir ein "
                    "Geruecht zufluestern.";
  }
  write("Barry erzaehlt: "+CAP(geruechteverbreiter[0])+
        " hat mir folgendes zugefluestert...\n");
  tell_room(environment(this_player()),
        "Barry fluestert "+CAP(TPN)+" das neueste Geruecht ins Ohr!\n",
        ({ TP }));
  return geruecht+"\nMit \"geruecht <text>\" kannst Du mir ein "
                  "Geruecht zufluestern.";
}


