  AddCmd( ({"nimm"}), "fkt_kisten_diebstahl");
  AddCmd( ({"stecke","steck","lege","leg"}), "fkt_in_kiste");
  AddCmd( ({"geruecht"}), "geruecht");
  geruechtecounter=0;

