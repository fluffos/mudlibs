// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath) {
  write_file(LOG "npc.kills",
    ctime()+": "+CAP(getuid(PL))+" killt Barry.\n");
  EMASTER->AddFeinde(getuid(TP));
  ::die(poisondeath);
}
// Mitloggen wenn ein Spieler vom NPC gekillt wird:
void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "npc.deads",
      ctime()+": Barry hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

// Funktion falls jemand versucht etwas aus Barry's Kiste zu nehmen
int fkt_kisten_diebstahl(string str)
{
  string was;
  string woraus;
  if(!str) return 0;
  if (sscanf(str, "%s aus %s", was, woraus))
  {
    if(woraus=="kiste")
    {
      write("Barry schreit: Haende weg von meiner Kiste!\n");
      tell_room(environment(this_player()),
        TPN+" wollte etwas aus Barry's Kiste stehlen!\n",({ TP }));
      write_file(LOG "kiste.log",
        ctime()+": "+CAP(getuid(PL))+" wollte "+CAP(was)+" aus der "
        "Kiste stehlen.\n");
    }
  }
  return 0;
}

// Man soll keine Sachen in die Kiste stecken koennen wenn Barry da ist
int fkt_in_kiste(string str)
{
  string was;
  string worein;
  if(!str) return 0;
  if (sscanf(str, "%s in %s", was, worein))
  {
    if(worein=="kiste")
    {
      write("Barry sagt: Wenn Du mir etwas schenken willst, dann gib mirs "
            "persoenlich!\n");
      return 1;
    }
  }
  return 0;
}

// Reactionen wenn Barry etwas vom Spieler bekommt
void give_notify(object ob)
{
  //Langgrundblatt
  if(ob->id("PFEIFENKRAUTBLATT"))  
  {
    say(BS("Barry sagt: Wow, danke! Ich liebe Langgrundblaetter!"));
  }
  //Suedstern
  if(ob->id("PFEIFENKRAUTSTERN"))  
  {
    say(BS("Barry sagt: Wow, danke! Den Suedstern findet man sehr selten!"));
  }
  //Nakrafulpflanze
  if(ob->id("PFEIFENKRAUTPFLANZE_0" || "PFEIFENKRAUTPFLANZE_1"))  
  {
    say(BS("Barry sagt: Wow, danke! Eine Nakrafulpflanze!!!"));
  }
  //Grottenkraut
  if(ob->id("PFEIFENKRAUTKRAUT"))  
  {
    say(BS("Barry sagt: Wow, danke! Ein Grottenkraut bekommt man nicht oft!"));
    call_out("krautrauchen", 10+random(5));
  }
  //Keinen Pudding
  if(ob->id("haselnusspudding"))
  {
    say(BS("Barry seufzt: Schon wieder Pudding, davon habe ich ja selber "
	   "genug.")+
	BS("Barry sagt: Trotzdem, danke."));
    ob->remove(1);
    return;
  }
  //Keine Plaetzchen
  if(ob->id("rumplaetzchen"))
  {
    say(BS("Barry seufzt: Schon wieder ein Rumplaetzchen, davon habe ich ja "
	   "selber genug.")+
	BS("Barry sagt: Trotzdem, danke."));
    ob->remove(1);
    return;
  }
  else  //Anderes
  {
    // Wenn er was zu essen bekommt...
    if(ob->id("Nahrung"))
      {
	say(BS("Barry sagt erfreut: Oh, etwas zu Essen! *mjam*"));
	call_out("auffuttern", 2+random(4), ob);
	return;
      }
    
    say(BS("Barry huepft erfreut durch den Laden."));
    write_file(LOG "kiste.log",
      ctime()+": "+CAP(getuid(PL))+" schenkt Barry "+ob->name(WEN,0)+".\n");
    call_out("in_kiste1", 4+random(4), ob);
  }
}

// Check fuer Hobbits und Gradopfeife
void auffuttern(object ob)
{
  object pf;
  
  if(!objectp(ob)) return;
  if(!TP) return;
  if(ENV(TP)!=MENV) return;
  
  if(lower_case(TP->QueryProp(P_RACE))=="hobbit")
    if(!present("\nPROtheG_Racetool", TP))
      {
	write(BS("Barry bedankt sich herzlich bei Dir.")+
	      BS("Barry meint: Nimm diese Pfeife als Geschenk an."));
	say(BS("Barry ueberreicht "+TP->name(WEM)+" etwas."), TP);
	
	pf=clone_object(HOBBITTOOL);
	pf->move(TP, M_NOCHECK);
	
	call_out("auffuttern2", 4+random(4), ob);
	
	return;
      }
  
  write(BS("Barry bedankt sich herzlich bei Dir."));
  say(BS("Barry bedankt sich bei "+TP->name(WEM)+"."), TP);
  
  call_out("auffuttern2", 4+random(4), ob);
}

void auffuttern2(object ob)
{
  say(BS("Barry isst "+ob->name(WEN)+" auf."));

  ob->remove(1);
}

// Sequenz wenn der Spieler Barry etwas schenkt
void in_kiste1(object ob) 
{
  switch(random(3))
