/* Chats */

  SetChats(3, ({
  "Barry freut sich ueber die neuesten Geruechte.\n",
  "Barry feilscht mit ein paar Kunden.\n",
  "Barry warnt: Leg Dich nicht mit den Echsen an!\n",
