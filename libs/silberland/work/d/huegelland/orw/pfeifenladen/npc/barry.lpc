// init
init()
{
  ::init();
  if(ENEMY(TP))
  {
    say("Barry schreit: Stirb, "+TPN+"!!!\n");
    TO->Kill(TP);
    return;
  }
  if(interactive(TP)&& member(begruesst,getuid(TP))==-1) 
    call_out("hallo",0);
}

// Begruessung des Spielers wenn er/sie den Laden betritt
void hallo() 
{ 
  string pf;
  
  if( MENV!=ENV(TP) ) return;
  begruesst += ({ getuid(TP) });  
  if (TP->QueryProp(P_RACE)=="Hobbit") // Hobbits werden mit ihrem Namen
  {                                    // angesprochen
    switch(random(3))         
    {
    case 0:
      tell_room(environment(TO), "Barry sagt: Hallo, wie gehts "+TPN+"?\n"
      "Barry sagt: Freut mich, dass Du mich mal wieder besuchst!\n");
      if(!present("\nhobbittool", TP))
	write(BS("Barry fragt Dich: Willst Du mir nicht etwas zu Essen "
		 "bringen?"));
      break;
    case 1:
      tell_room(environment(TO), "Barry freut sich: Hallo, "+TPN+"!\n");
      if(!present("\nhobbittool", TP))
	write(BS("Barry fragt Dich: Willst Du mir nicht etwas zu Essen "
		 "bringen?"));
      break;
    case 2:
      tell_room(environment(TO), "Barry grinst: Was fuehrt Dich zu mir, "
      +TPN+"?\n");
      if(!present("\nhobbittool", TP))
	write(BS("Barry fragt Dich: Willst Du mir nicht etwas zu Essen "
		 "bringen?"));
      break;
    default:
      tell_room(environment(TO), "Barry sagt: Hi!\n");
    }
  }
  else                                  // Andere Rassen werden nicht
  {                                     // mit dem Namen angesprochen
    switch(random(3))         
    {
    case 0:
      tell_room(environment(TO), "Barry sagt: Hallo, wie gehts "
      +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"Frau":"Herr")+" "
      +capitalize((string)this_player()->QueryProp(P_RACE))+"?\n");
      break;
    case 1:
      tell_room(environment(TO), "Barry staunt: Oh! Ein"
      +(((int)this_player()->QueryProp(P_GENDER)==FEMALE)?"e":"")+" "
      +this_player()->QueryProp(P_RACESTRING)[WER]+
      " in meinem kleinen bescheidenen Laden?\n"
      "Barry staunt: Wow, solchen Besuch hab ich nicht oft!\n");
      break;
    case 2:
      tell_room(environment(TO), "Barry sagt: Was fuehrt Dich zu mir, "
      +this_player()->QueryProp(P_RACESTRING)[WER]+ "?\n");
      break;
    default:
      tell_room(environment(TO), "Barry sagt: Hi!\n");
    }
  }
}


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP, 
        "beruhigt Dich indem er Dir den Kopf taetschelt.",
        "beruhigt "+TPN+" indem er "+TP->QueryPronoun(WEM)+" den Kopf taetschelt.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        "troestet "+TPN+".");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "kichert: Na, Du bist ja ein Spassvogel!",
        "kichert: Na, Du bist ja ein Spassvogel, "+TPN+"!");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "arglt: HE! Aergern gilt nicht, "+TPN+".",
        "arglt: HE! Aergern gilt nicht, "+TPN+".");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "schreit: Nun werd mal nicht gleich frech!",
        "schreit: Nun werd mal nicht gleich frech, "+TPN+"!");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt froehlich.", 
        "laechelt froehlich.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "erroetet: Das war aber lieb von Dir.",
        "erroetet: Das war aber lieb von Dir, "+TPN+".");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "knuddelt Dich mit seinen kraeftigen haarigen Armen.",
        "knuddelt "+TPN+" mit seinen kraeftigen haarigen Armen.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "grinst Dich an.",
        "grinst "+TPN+" an.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "drueckt Dich an seine behaarte Brust und troestet Dich.",
        "drueckt "+TPN+" an seine behaarte Brust und troestet "+TP->QueryPronoun(WEN)+".");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

reset()
{
  ::reset();
  geruechtecounter=0;
  begruesst = ({});
}
