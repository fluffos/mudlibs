//  Projekt   : Barry's Pfeifenladen
//  Food Name : Haselnusspudding
//  Erstellt  : 20.08.2001 (Orw)
//  Geaendert : -

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Schale mit Pudding");
  SetProp(P_LONG,
	  "Eine kleine Schale mit Pudding. Auf dem Pudding wurden "
	  "kleingehackte Haselnussstueckchen gestreut.");
  SetProp(P_NAME, "Schale mit Pudding");
  SetProp(P_GENDER, FEMALE);
  AddId(({"pudding", "nusspudding", "haselnusspudding","schale"}));
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 20);
  SetProp(P_PFEIFENLADENVERKAUF,1);
  SetProp(P_FOOD_INFO, ([
    F_HEAL     : ({5, 8}), 
    F_SOAK     : 8,
    F_ALCOHOL  : 0,
    F_MSG      : "Genuesslich knusperst Du die Haselnussstueckchen vom Pudding!",
    F_MSG_ROOM : "isst voll Freude einen Pudding."]) );
}
