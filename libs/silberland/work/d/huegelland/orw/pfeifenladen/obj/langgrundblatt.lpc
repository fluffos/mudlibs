//  Projekt   : Barry's Pfeifenladen
//  Objekt    : Ein Langgrundblatt
//  Erstellt  : 17.03.2001 (Orw)
//  Geaendert : -


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Langgrundblatt");
  SetProp(P_LONG,
	  "Das Langgrundblatt ist eine Tabakpflanze. Sie waechst hauptsaechlich "
	  "in huegeligen schattigen Gebieten." );

  SetProp(P_NAME, "Langgrundblatt");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_PFEIFENLADENVERKAUF,1);
  AddId(({"blatt","grundblatt","langgrundblatt","PFEIFENKRAUTBLATT"}));

  SetProp(P_MATERIAL, MAT_MISC_PLANT );
  SetProp(P_WEIGHT, 12);
  SetProp(P_VALUE, 19);

}
