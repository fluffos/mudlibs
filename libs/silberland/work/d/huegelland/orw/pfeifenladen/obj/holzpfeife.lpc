inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"


// Ist die Pfeife angezuendet oder nicht...
int pfeifeangezuendet;

// Wert der Pfeife fuer Heilung usw. der in den Sequenzen benutzt wird
// Bessere Pfeifen haben dann hoehere Werte...
// Pfeifenwert liegt bei der Holzpfeife zwischen 1 und 7
int pfeifenwert;
string pfeifenname="Eine Holzpfeife";


// Verschiedene Formen die der Spieler blasen kann
#define RINGERL ({"ein cooles Ringerl","ein schoenes Ringerl", \
                  "ein huebsches Ringerl","ein rundes Ringerl", \
                  "ein wunderschoenes Ringerl","ein tolles Ringerl", \
		  "ein laessiges Ringerl" })
int formringerl;

// Womit ist die Pfeife gestopft...
int pfeifegestopft_blatt;
int pfeifegestopft_kraut;
int pfeifegestopft_stern;
int pfeifegestopft_pflanze;

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Holzpfeife");
  SetProp(P_LONG,
	  "Eine kleine Pfeife aus Holz, in welche man Pfeifenkraut stopfen, "
	  "und es dann rauchen kann. Sie ist braun schoen lackiert und hat "
	  "ein schwarzes Mundstueck. Sie wurde aus @@gegenstand_name@@ geschnitzt.");
  SetProp(P_INFO, "Der SL-Gesundheitsminister:\n"
                  "Rauchen gefaehrdet Ihre Gesundheit.");
  SetProp(P_NAME, "Holzpfeife");
  SetProp(P_GENDER, FEMALE);
  
  SetProp(P_PFEIFENLADENVERKAUF,1);
  AddId(({"pfeife","holzpfeife"}));

  SetProp(P_MATERIAL, MAT_MISC_WOOD );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 156);

  AddCmd(({"stopfe","stopf"}), "fktstopfen");
    pfeifegestopft_blatt=0;
    pfeifegestopft_kraut=0;
    pfeifegestopft_stern=0;
    pfeifegestopft_pflanze=0;
  AddCmd(({"rauche","rauch"}), "fktrauchen");
    pfeifeangezuendet=0;

}

string gegenstand_name() { return QueryProp(P_GEGENSTAND); }
set_pfeifenwert(int w){ pfeifenwert=random(3)+w;}

// Funktion um eines der verschiedenen Pfeifenkraeuter in die
// Pfeife zu stopfen
int fktstopfen(string str)
{ 
  string was;
  string wohinein;
  object blatt;
  object kraut;
  object stern;
  object pflanze;
  notify_fail("Was willst Du wo reinstopfen?!\n"); 
  if (!str) return 0;
  if (sscanf(str, "%s in %s", was, wohinein) ||
      sscanf(str, "%s mit %s", wohinein, was))
  { 
    if(wohinein=="pfeife" ||
       wohinein=="holzpfeife")
    {
      if(pfeifegestopft_blatt==1 || 
         pfeifegestopft_kraut==1 ||
         pfeifegestopft_stern==1 ||
         pfeifegestopft_pflanze==1)
      {
        write("Die Pfeife ist doch schon gestopft!\n");
        return 1;
      }
      // Pfeife mit Langgrundblatt stopfen
      if(was=="langgrundblatt" ||
         was=="grundblatt"    ||
         was=="blatt")
      {
        if(present("PFEIFENKRAUTBLATT",TP))
        {
          write("Du stopfst das Langgrundblatt in die Pfeife.\n");
          say  (TPN+" stopft eine kleine Pfeife.\n");
          SetProp(P_SHORT, "Eine kleine Pfeife (gestopft)");
          pfeifegestopft_blatt=1;
          if(blatt=present("PFEIFENKRAUTBLATT",TP)) blatt->remove();
          return 1;
        }
        else
        {
          write("Du hast doch gar kein Langgrundblatt!\n");
          return 1;
        }
      }
      // Pfeife mit Grottenkraut stopfen
      if(was=="grottenkraut" ||
         was=="kraut" )
      {
        if(present("PFEIFENKRAUTKRAUT",TP))
        {
          write("Du stopfst das Grottenkraut in die Pfeife.\n");
          say  (TPN+" stopft eine kleine Pfeife.\n");
          SetProp(P_SHORT, "Eine kleine Pfeife (gestopft)");
          pfeifegestopft_kraut=1;
          if(kraut=present("PFEIFENKRAUTKRAUT",TP)) kraut->remove();
          return 1;
        }
        else
        {
          write("Du hast doch gar kein Grottenkraut!\n");
          return 1;
        }
      }
      // Pfeife mit Suedstern stopfen
      if(was=="suedstern" ||
         was=="stern" )
      {
        if(present("PFEIFENKRAUTSTERN",TP))
        {
          write("Du stopfst den Suedstern in die Pfeife.\n");
          say  (TPN+" stopft eine kleine Pfeife.\n");
          SetProp(P_SHORT, "Eine kleine Pfeife (gestopft)");
          pfeifegestopft_stern=1;
          if(stern=present("PFEIFENKRAUTSTERN",TP)) stern->remove();
          return 1;
        }
      }
      // Pfeife mit Nakrafulpflanze stopfen
      if(was=="nakrafulpflanze" ||
         was=="pflanze" )
      {
        if(present("PFEIFENKRAUTPFLANZE_1",TP))
        {
          write("Du stopfst die zerriebene Nakrafulpflanze in die Pfeife.\n");
          say  (TPN+" stopft eine kleine Pfeife.\n");
          SetProp(P_SHORT, "Eine kleine Pfeife (gestopft)");
          pfeifegestopft_pflanze=1;
          if(pflanze=present("PFEIFENKRAUTPFLANZE_1",TP)) pflanze->remove();
          return 1;
        }
        if(present("PFEIFENKRAUTPFLANZE_0",TP))
        {
          write("Du solltest die Nakrafulpflanze vorher zerreiben.\n");
          return 1;
        }
        else
        {
          write("Du hast doch gar keine Nakrafulpflanze!\n");
          return 1;
        }
      }
      else
      {
        write("Sowas kannst Du nicht in die Pfeife stopfen!\n");
        return 1;
      }
    }
    return 0;
  }
  return 0;
}



int fktrauchen(string str)
{
  object raucher;
  raucher = TP;
  notify_fail("Was willst Du rauchen?!\n"); 
  if (!str) return 0;
  if (str=="pfeife" ||
      str=="holzpfeife")
  {
    if(pfeifeangezuendet)
    {
      write("Du rauchst doch schon Deine Pfeife!\n");
      return 1;
    }
    // Pfeife gestopft mit Langgrundblatt
    if(pfeifegestopft_blatt==1)
    {
      write("Gemuetlich zuendest Du Dir Deine Pfeife an.\n");
      say  (TPN+" zuendet sich gemuetlich eine Pfeife an.\n");
      SetProp(P_NODROP, "Aber die Pfeife brennt doch gerade!\n");
      SetProp(P_NEVERDROP, 1);
      pfeifeangezuendet=1;
      call_out("blattrauchen1", 15+random(5),raucher);
      return 1;
    }
    // Pfeife gestopft mit Grottenkraut
    if(pfeifegestopft_kraut==1)
    {
      write("Gemuetlich zuendest Du Dir Deine Pfeife an.\n");
      say  (TPN+" zuendet sich gemuetlich eine Pfeife an.\n");
      SetProp(P_NODROP, "Aber die Pfeife brennt doch gerade!\n");
      SetProp(P_NEVERDROP, 1);
      pfeifeangezuendet=1;
      call_out("krautrauchen1", 15+random(5),raucher);
      return 1;
    }
    // Pfeife gestopft mit Suedstern
    if(pfeifegestopft_stern==1)
    {
      write("Gemuetlich zuendest Du Dir Deine Pfeife an.\n");
      say  (TPN+" zuendet sich gemuetlich eine Pfeife an.\n");
      SetProp(P_NODROP, "Aber die Pfeife brennt doch gerade!\n");
      SetProp(P_NEVERDROP, 1);
      pfeifeangezuendet=1;
      call_out("sternrauchen1", 15+random(5),raucher);
      return 1;
    }
    // Pfeife gestopft mit einer Nakrafulpflanze
    if(pfeifegestopft_pflanze==1)
    {
      write("Gemuetlich zuendest Du Dir Deine Pfeife an.\n");
      say  (TPN+" zuendet sich gemuetlich eine Pfeife an.\n");
      SetProp(P_NODROP, "Aber die Pfeife brennt doch gerade!\n");
      SetProp(P_NEVERDROP, 1);
      pfeifeangezuendet=1;
      call_out("pflanzerauchen1", 15+random(5),raucher);
      return 1;
    }
    else
    {
      write("Du musst die Pfeife vorher stopfen um sie rauchen zu koennen!\n");
      return 1;
    }
  }
  return 0;
}

// Includierte Sequenzen fuers Rauchen
#include SEQUENZ"blattsequenz.h"
#include SEQUENZ"krautsequenz.h"
#include SEQUENZ"sternsequenz.h"
#include SEQUENZ"pflanzesequenz.h"

