//  Objekt    : Ein Suedstern
//  Erstellt  : 19.03.2001 (Orw)
//  Geaendert : -


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Suedstern");
  SetProp(P_LONG,
	  "Der Suedstern ist eine Pflanze die nur in besonders sonnigen suedlichen "
	  "Gebieten vorkommt. Er riecht stark nach Tabak und kann vielleicht auch "
	  "als solcher verwendet werden." );
  SetProp(P_NAME, "Suedstern");
  SetProp(P_GENDER, MALE);
  SetProp(P_PFEIFENLADENVERKAUF,1);
  AddId(({"stern","suedstern","PFEIFENKRAUTSTERN"}));

  SetProp(P_MATERIAL, MAT_MISC_PLANT );
  SetProp(P_WEIGHT, 12);
  SetProp(P_VALUE, 34);

}

