//  Projekt   : Barry's Pfeifenladen
//  Food Name : Ein Herzkeks
//  Erstellt  : 14.03.2001 (Orw)
//  Geaendert : -

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <ansi.h>
#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Herzkeks");
  SetProp(P_LONG,
	  "Dieser Keks hat die Form eines Herzens. Er sieht echt lecker "
	  "aus und hat eine Zuckerglasur, mhm...");
  SetProp(P_NAME, "Herzkeks");
  SetProp(P_GENDER, MALE);
  SetProp(P_PFEIFENLADENVERKAUF,1);
  AddId(({"herzkeks", "keks", "Nahrung"}));
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 13);
  SetProp(P_NOBUY, 1);
  
  AddCmd(({"iss","esse","essen","koste","kost"}), "fktessen");
}

int fktessen(string str)
{
  notify_fail("Was willst Du essen?!\n"); 
  if(str=="keks" ||
     str=="herzkeks")
  { 
    TO->SetProp(P_INVIS, 1);
    write("Mit Genuss verspeist Du den Herzkeks.\n");
    say(this_player()->name()+" isst einen Herzkeks.\n");
    RemoveCmd(({"iss","esse","essen","koste","kost"}));
    call_out("herzstory1",5);
    return 1;
  }
  return 0;
}

int herzstory1(string str)
{
   write("\n"
         "Ploetzlich beginnt die Luft vor Dir zu flimmern und eine kleine Rauchwolke\n"
         "entsteht daraus.\n"
         "\n");
   say(this_player()->name()+" schliesst die Augen.\n");
   call_out("herzstory2",5);
}

int herzstory2(string str)
{
   write("\n"
         "Gespannt siehst Du zu, wie sich aus der Wolke etwas formt...\n"
         "\n");
   say(this_player()->name()+" scheint im Gedanken versunken.\n");
   call_out("herzstory3",5);
}


int herzstory3(string str)
{
   write(ANSI_RED+ANSI_BOLD+"\n"
         "                              .-. .-.\n"
         "                             (   `   )\n"
         "                              `.   .'\n"
         "                                `.'\n"
         "\n"+ANSI_NORMAL);
   say(this_player()->name()+" wacht wieder auf und freut sich.\n");
   TO->remove();
   return 1;
}
