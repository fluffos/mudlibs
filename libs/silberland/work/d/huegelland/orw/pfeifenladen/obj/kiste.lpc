//  Projekt     : Barry's Pfeifenladen
//  Objekt Name : Ein Kiste im Pfeifenladen
//  Erstellt    : 14.03.2001 (Orw)
//  Geaendert   : -

inherit "/std/container";
#include <moredef.h>
#include <defines.h>
#include <properties.h>
#include "../def.h"

string short() { return ""; }


create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Eine grosse Kiste");
  SetProp(P_LONG, 
    "Eine grosse hoelzerne Kiste steht unter der Ladentheke. Darin bewahrt "
    "Barry anscheinend seine Sachen auf.");
  AddId(({"kiste", "BARRYSKISTE"}));
  SetProp(P_NAME, "Kiste");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 100000);
  SetProp(P_MAX_WEIGHT, 100000);

  SetProp(P_NOGET, "Die Kiste ist fest im Boden verankert.\n");

  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:90, MAT_MISC_METAL:10]));

}
