//  Projekt   : Barry's Pfeifenladen
//  Food Name : Rumplaetzchen
//  Erstellt  : 17.03.2001 (Orw)
//  Geaendert : -

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Rumplaetzchen");
  SetProp(P_LONG,
	  "In Deinen Haenden haeltst Du ein verlockend riechendes "
	  "Plaetzchen, mit einer Rum-Nougat Fuellung. ");
  SetProp(P_NAME, "Rumplaetzchen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"plaetzchen", "rumplaetzchen"}));
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 11);
  SetProp(P_PFEIFENLADENVERKAUF,1);
  SetProp(P_FOOD_INFO, ([
    F_HEAL     : ({10, 2}), 
    F_SOAK     : 10,
    F_ALCOHOL  : 3,
    F_MSG      : "Mampf... wirklich gut dieses Plaetzchen!",
    F_MSG_ROOM : "isst das Rumplaetzchen und freut sich."]) );
}
