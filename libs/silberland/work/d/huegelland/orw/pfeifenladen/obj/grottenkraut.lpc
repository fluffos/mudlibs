//  Projekt   : Barry's Pfeifenladen
//  Objekt    : Ein Grottenkraut
//  Erstellt  : 19.03.2001 (Orw)
//  Geaendert : -


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Grottenkraut");
  SetProp(P_LONG,
	  "Das Grottenkraut waechst hauptsaechlich in Felsritzen oder Spalten von "
	  "Hoehlen und Grotten. Es hat eine braeunliche Farbe und scheint eine Art "
	  "Tabakpflanze zu sein." );
  SetProp(P_NAME, "Grottenkraut");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_PFEIFENLADENVERKAUF,1);
  AddId(({"kraut","grottenkraut","PFEIFENKRAUTKRAUT"}));

  SetProp(P_MATERIAL, MAT_MISC_PLANT );
  SetProp(P_WEIGHT, 12);
  SetProp(P_VALUE, 32);

}

