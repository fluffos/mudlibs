//  Projekt   : Barry's Pfeifenladen
//  Objekt    : Eine Nakrafulpflanze
//  Erstellt  : 19.03.2001 (Orw)
//  Geaendert : -


inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../def.h"

int dornen_weg;
int zerrieben;

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Nakrafulpflanze");
  SetProp(P_LONG,
    "Die Nakrafulpflanze findet man in Wuestengebieten. Sie hat viele Dornen, "
    "Du solltest aufpassen, dass Du Dich nicht an ihr stichst. Ohne genaue "
    "Untersuchung ist nicht ersichtlich wofuer man sie verwenden kann." );
  SetProp(P_NAME, "Nakrafulpflanze");
  SetProp(P_INFO, "Zerrieben koennte man sie vielleicht als Tabak verwenden.\n"
                  "Vorher solltest Du aber die Dornen entfernen...\n");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_PFEIFENLADENVERKAUF,1);
  AddId(({"pflanze","nakrafulpflanze","PFEIFENKRAUTPFLANZE_0"}));

  SetProp(P_MATERIAL, MAT_MISC_PLANT );
  SetProp(P_WEIGHT, 12);
  SetProp(P_VALUE, 32);

  AddDetail(({"dornen","dorne"}),
    "Die Dornen sehen sehr gefaehrlich aus!");

  AddCmd(({"entferne","entfern"}),"fktentfernen");
    dornen_weg=0;
  AddCmd(({"zerreibe","zerreib"}),"fktzerreiben");
    zerrieben=0;
}

int fktentfernen(string str)
{
  notify_fail("Was moechtest Du entfernen?\n");
  if (!str) return 0; 
  if (str=="dornen" || str=="dornen von pflanze")
  {
    if(dornen_weg)
    {
      write("Aber Du hast die Dornen doch schon entfernt!\n");
      return 1;
    }
    if(zerrieben)
    {
      write("Was willst Du noch entfernen? Die Pflanze ist doch schon zerrieben.\n");
      return 1;
    }
    write("Du entfernst vorsichtig die Dornen ohne Dich zu verletzten.\n");
    say  (TPN+" entfernt die Dornen von einer Nakrafulpflanze.\n");
    TO->SetProp(P_SHORT, "Eine Nakrafulpflanze ohne Dornen");
    TO->SetProp(P_LONG, "Die Nakrafulpflanze findet man in heissen "
      "Wuestengebieten. Normalerweise hat sie viele Dornen, aber "
      "die wurden bei dieser schon entfernt.");
    TO->SetProp(P_INFO, "Zerrieben koennte man sie vielleicht als Tabak verwenden.");
    TO->RemoveDetail(({"dornen","dorne"}));
    dornen_weg=1;
    return 1; 
  }
  return 0;
}

int fktzerreiben(string str)
{
  notify_fail("Was moechtest Du zerreiben?\n");
  if (!str) return 0; 
  if (str=="pflanze" || str=="nakrafulpflanze")
  {
    if(dornen_weg)
    {
      write("Du zerreibst die Nakrafulpflanze zu kleinen Broeseln, die man "
            "nun als Tabak verwenden kann.\n");
      say  (TPN+" zerreibt eine Nakrafulplanze in seinen Haenden.\n");
      TO->SetProp(P_SHORT, "Eine Nakrafulplanze (zerrieben)");
      TO->SetProp(P_LONG, "Eine zerriebene Nakrafulpflanze wie man sie in heissen "
        "Wuestengebieten findet. Man koennte sie als Tabak verwenden.");
      TO->SetProp(P_INFO, "Man kann sie als Tabak verwenden.");
      TO->AddId("PFEIFENKRAUTPFLANZE_1");
      zerrieben=1;
      dornen_weg=0;
      return 1;
    }
    else
    {
      write("Du zerreibst die Nakrafulpflanze zu kleinen Broeseln, die man "
            "nun als Tabak verwenden kann. Leider hast Du die Dornen vorher "
            "nicht entfernt und stichst Dich daran einige Male.\n");
      say  (TPN+" zerreibt eine Nakrafulplanze in seinen Haenden und schreit "
            "dann laut auf.\n");
      TO->SetProp(P_KILL_NAME, "Dummer Umgang mit Pflanzen");
      TP->do_damage(10)+random(5);
      TO->SetProp(P_SHORT, "Eine Nakrafulplanze (zerrieben)");
      TO->SetProp(P_LONG, "Eine zerriebene Nakrafulpflanze wie man sie in heissen "
        "Wuestengebieten findet. Man koennte sie als Tabak verwenden.");
      TO->SetProp(P_INFO, "Man kann sie als Tabak verwenden.");
      TO->AddId("PFEIFENKRAUTPFLANZE_1");
      TO->SetProp(P_KILL_NAME, 0);
      zerrieben=1;
      dornen_weg=0;
      return 1;
    }    
  }
  return 0;
}