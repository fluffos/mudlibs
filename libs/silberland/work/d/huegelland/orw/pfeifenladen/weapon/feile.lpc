//  Projekt     : Barry's Pfeifenladen
//  Weapon Name : Eine Feile
//  Erstellt    : 10.06.2001 (Orw)
//  Geaendert   : -


inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

#define FORMEN ({"dreikant","vierkant","rund","halbrund","schrupp","schlicht"})
int form = random(6);


create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine "+CAP(FORMEN[form])+"feile");
  SetProp(P_LONG,
    "Eine "+CAP(FORMEN[form])+"feile die zum Bearbeiten von Holz verwendet "
    "wird. In der Hand eines geschickten Spielers kann sie aber auch zu einer "
    "toetlichen Waffe werden." );
  SetProp(P_NAME, CAP(FORMEN[form])+"feile");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"feile", FORMEN[form]+"feile"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC_BONUS, (["PFEIFENTOBI":120]) );
  SetProp(P_WC, 60);
  SetProp(P_DAM_TYPE, ({DT_PIERCE}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_IRON:80,MAT_MISC_WOOD:20]));
  SetProp(P_WEIGHT, 100+random(200));
  SetProp(P_VALUE, 100);
}
