
inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>


create()
{
	if (!is_clone(this_object())) return;
	
	::create();
	
	AddId( ({"kalkpanzer", "panzer"}) );
	
	SetProp(P_SHORT, "Ein schwerer Kalkpanzer");
	SetProp(P_LONG, "Er ist sehr schwer, scheint aber ein "
	                "ausgezeichneter Schutz zu sein.\n");
	
	SetProp(P_NAME, "Kalkpanzer");
        SetProp(P_NAME_ADJ, "schwer");
	SetProp(P_GENDER, MALE);
	SetProp(P_WEIGHT, 8000);
	SetProp(P_VALUE, 9000);
	SetProp(P_NOBUY, 1);
	
	SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
	SetProp(P_AC, 40);
	
	SetProp(P_MATERIAL, ([MAT_LIME:100]));
	
	//restrictions
	// SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL: 35]));
								 
	SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1,T_HEAT_PROT:4]) );
	//SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)
	//  +([DT_FIRE:4, DT_AIR:0, DT_ACID:2,
	//     DT_SLASH:4, DT_BLUDGEON:4, DT_PIERCE:4,
	//     DT_SQUEEZE:4, DT_RIP:4, DT_WHIP:4 ]) );
	
	SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)
	  +([DT_FIRE:2, DT_AIR:0, DT_ACID:1,
	     DT_BLUDGEON:2, DT_PIERCE:2,
	     DT_SQUEEZE:2 ]) );
	
}

