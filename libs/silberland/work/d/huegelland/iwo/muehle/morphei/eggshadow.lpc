#pragma strong_types

inherit "std/thing";

#include <moredef.h>
#include <defines.h>
#include <properties.h>
#include <moving.h>
#include <npc.h>
#include <wizlevels.h>
#include <combat.h>

#define TMI(x) if (find_player("iwo")) tell_object(find_player("iwo"), break_string(x, 78))

#define EGGMASTER "/d/huegelland/iwo/muehle/morphei/eggmaster"

#define LOSER_DELAY 120

object curr_pl;

int last_move = time();

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create();
  
  SetProp(P_NAME, "Eggshadow");
  SetProp(P_INVIS, 1);
  SetProp(P_NOATTACK, 1);
  SetProp(P_NO_GLOBAL_ATTACK, 1);
  SetProp(P_FRIEND, 1);
  
  AddId( ({ "eggshadow", "\neggshadow" }) );
  
  SetProp(P_INVIS, 1);
  call_out("reset", 0);
}


int f_filter(object pl)
{
  object *pursuers;
  string fn;
  int i;

  if (IS_SEER(pl) && !IS_LEARNER(pl) && query_idle(pl) < 60 && environment(pl)
      && !is_clone(pl))
    {
      if (!pursuers = pl->QueryProp(P_PURSUERS)) return 1;
      for (i=0;i<sizeof(pursuers);i++)
        if (objectp(pursuers[i]) && pursuers[i]->id("\neggshadow")) return 0;
	
      return 1;
    }
    
  return 0;
}



void FollowSeer()
{
  object *possible;
  int max_loop;
  object chosen;
  //max_loop=10;
  possible = filter_array(users(), "f_filter");

  if (sizeof(possible)<1)
    {
      TMI("No seers. Exiting.");
      call_out("remove", 0);
      return;
    }

  //TMI(sprintf("%O", possible));
  possible-=({0});
  while (/* max_loop > 0 && */ !objectp(chosen)) {
    chosen = possible[random(sizeof(possible))];
    //max_loop--;
  }
  if(!objectp(chosen)) {
    call_out("remove", 0);
    return;
  }
  TMI(sprintf("Chosen: %O", chosen));
  chosen->AddPursuer(this_object());
  
  curr_pl = chosen;
  
  call_out("LoserCheck", 20, chosen);
  
}


void LoserCheck(object pl)
{
  EGGMASTER->AddShadow(this_object());

  while(remove_call_out("LoserCheck") != -1);

  if (last_move < time()-120)
    {
      TMI(sprintf("%O is a loser - jumping to next!", pl));
      if (pl) pl->RemovePursuer(this_object());
      FollowSeer();
      return;
    }

  call_out("LoserCheck", LOSER_DELAY, pl);

}

void reset()
{
  FollowSeer();
}

void init()
{
  if (TP)
    {
      //TMI(sprintf("PO: %O", PO));
      if (living(TP) && !query_once_interactive(TP) && !TP->QueryProp(P_NOATTACK))
        EGGMASTER->AddNpc(TP, curr_pl);
    }
  ::init();
}

varargs int move(mixed dest, int method)
{
  last_move = time();
  ::move(dest, method);
}
