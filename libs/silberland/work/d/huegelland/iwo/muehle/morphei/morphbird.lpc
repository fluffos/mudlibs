
inherit "std/npc";
inherit "std/npc/spells";

#pragma strong_types

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>
#include <ansi.h>

#define MORPHEI "/d/huegelland/iwo/muehle/morphei/morphei"
#define ARING "/d/gebirge/angrox/obj/astralring"
#define EGGMASTER "/d/huegelland/iwo/muehle/morphei/eggmaster"
#define EGGEVENTMASTER "/d/event/iwo/egg/master"

#define WALKDELAY 2
#define WALKDELAY_RND 5

string prefix = "";
string fullname = "";
int eggturn = 0;
object ob_defender;
int defend = 0;

// Fuers event
int walkdelay = 10;
object home;
int event = 0;

void create() {
  object ob;

  if (!is_clone(TO)) return;
  ::create();

  fullname = capitalize(sprintf("%skuckuck", prefix));

  SetProp(P_SHORT, "Ein " + lower_case(fullname));
  SetProp(P_LONG,
    "Ein fast ganz normaler Kuckuck. Seine Klauen sehen nicht besonders "
    "einladend aus.");
  SetProp(P_NAME, fullname);
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);

//  TO->Set(P_NOATTACK, symbol_function("f_noattack",TO),F_QUERY_METHOD);

  AddId( ({ "kuckuck" , fullname, "vogel" }));
  
  create_default_npc(5);

  SetProp(P_HANDS, ({" mit seinen Klauen",200,DT_BLUDGEON}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 20);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MMSGIN, "klettert aus dem Ei");
  // "obj/gemmaster"->DistributeGem(1, 0, 0, 1);
  if (PO && PO->QueryEvent())
    {
      home = ENV(ME);
      enable_commands();
    }
  else
    {
      ob = clone_object(MORPHEI);
      ob->move(ME, M_NOCHECK);
    }
}


int SetEventObject(string *data)
{
  mixed *hands;

  hands = QueryProp(P_HANDS);

  prefix = data[0];
  fullname = capitalize(sprintf("%skuckuck", prefix));
  create_default_npc(to_int(data[1]));

  SetProp(P_SHORT, "Ein " + fullname);
  SetProp(P_LONG,
    "Ein fast ganz normaler " + fullname + ". Seine Klauen sehen nicht besonders "
    "einladend aus.");
  SetProp(P_NAME, fullname);
  AddId( ({ "kuckuck" , lower_case(fullname), "vogel" }));

  //present("ei")->SetTurn(eggturn, turns_needed);
  //if (!EGGMASTER->NoMoreBirds())
  //  present("ei")->SetEvent(1);

  EGGEVENTMASTER->BirdBorn(ME);
 
  enable_commands();
  SetProp(P_XP, QueryProp(P_MAX_HP) * (int) hands[1] * 5);
  return 1;

}


int SetObject(object obj, int turn, int turns_needed, int level)
{
  mixed *hands;

  if (!obj) obj = find_player("iwo");
  if (!obj) obj = find_player("angrox");
  if (!obj) obj = find_living("kronang");


  prefix = obj->query_real_name();
  fullname = capitalize(sprintf("%skuckuck", prefix));
  create_default_npc((int)(level/3)+1);
  hands = QueryProp(P_HANDS); 
  // Hands NACH dem default_npc, sonst stimmt die XP berechnung unten nicht

  ob_defender = obj;  
  
  eggturn = turn;

  SetProp(P_SHORT, "Ein " + fullname);
  SetProp(P_LONG,
    "Ein fast ganz normaler " + fullname + ". Seine Klauen sehen nicht besonders "
    "einladend aus. Ausserden sagt Dir Dein Instinkt, dass es " + ob_defender->name(WEM)
    + " gar nicht gefallen wird, wenn Du ihm etwas antust.");
  SetProp(P_NAME, fullname);
  AddId( ({ "kuckuck" , lower_case(fullname), "vogel" }));

  if(find_player("iwo")) tell_object(find_player("iwo"), sprintf("MORPHEI: TURN: %d/%d\n", turn, turns_needed));
  
  present("ei")->SetTurn(eggturn, turns_needed);
 
  enable_commands();
  SetProp(P_XP, QueryProp(P_MAX_HP) * (int) hands[1] * 5);
  return 1;
}

int SetLast()
{
  object aring;

  prefix = "astral";

  create_default_npc(25);
  
  fullname = capitalize(sprintf("%skuckuck", prefix));


  SetProp(P_SHORT, "Ein " + fullname);
  SetProp(P_LONG,
    "Ein fast ganz normaler " + fullname + ". Seine Klauen sehen nicht besonders "
    "einladend aus.");
  SetProp(P_NAME, fullname);
  AddId( ({ "kuckuck" , fullname, "vogel" }));

  //"obj/gemmaster"->DistributeGem(10, 0, 0, 1);
  aring = clone_object(ARING);
  aring->move(ME);
  aring->SetMystical(); 

  if (find_player("iwo"))
    tell_object(find_player("iwo"), 
      sprintf("%s%sMAGISCHER ASTRALRING: %O%s\n", ANSI_BOLD, ANSI_RED, TP, ANSI_NORMAL));
  if (find_player("angrox"))
    tell_object(find_player("angrox"), 
      sprintf("%s%sMAGISCHER ASTRALRING: %O%s\n", ANSI_BOLD, ANSI_RED, TP, ANSI_NORMAL));


 
  catch(present("ei")->remove());
  
  return 1;

}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if (ob_defender)
    if (!ob_defender->IsEnemy(enemy))
      {
        if (ENV(ob_defender) == ENV(ME))
        {
          tell_room(ENV(ME), BS(ob_defender->Name(WER) + " verteidigt "+
                ob_defender->QueryPossPronoun(MALE,WEN,SINGULAR)+" Schuetzling."));
          ob_defender->Kill(enemy);
        }
      }
  return ::Defend(dam, dam_type_list, spell, enemy);

}

int SetEvent(int e)
{
  event = e;

  if (event)
    set_heart_beat(1);
}

void do_walk()
{
  mapping exits;
  string *e_cmd;
  int chosen;

  exits = ENV(ME)->QueryProp(P_EXITS);

  if (!mappingp(exits)) return;

  e_cmd = m_indices(exits);

  if (sizeof(e_cmd) <= 0)
    ME->move(home, M_GO);
  
  chosen = random(sizeof(e_cmd));

  while (catch(call_other(exits[e_cmd[chosen],0], "???", 0)))
    {
      e_cmd -= ({ e_cmd[chosen] });
      if (sizeof(e_cmd) <= 0)
        ME->move(home, M_GO);
      chosen = random(sizeof(e_cmd));
    }
  
  command_me(e_cmd[chosen]);

  if (!EGGEVENTMASTER->LimitReached() && EGGEVENTMASTER->QueryEvent())
    call_out("drop_egg", 0);

  walkdelay = WALKDELAY + random(WALKDELAY_RND); 
}


void drop_egg()
{
  object egg;

  if (EGGEVENTMASTER->Limit())
    return;

  egg = clone_object(MORPHEI);

  egg->SetEvent(1);

  tell_room(ENV(ME), BS(ME->Name(WER) + " kraechzt: Kuckuck!"));
  tell_room(ENV(ME), BS(ME->Name(WER) + " legt ein Ei."));

  egg->move(ENV(ME), M_NOCHECK);

  egg->makebird_event();
}


void heart_beat()
{
  if (!is_clone(ME)) return;
  if (event) EGGEVENTMASTER->BirdBorn(ME);
  if (event && walkdelay-- <= 0)
    do_walk();
}

varargs void die( int poisondeath )
{
  object egg;

  if (event && !EGGEVENTMASTER->Limit())
    {
      egg = clone_object(MORPHEI);
      egg->move(ENV(ME), M_NOCHECK);
      egg->makebird_event();
    }

  if (event)
    EGGEVENTMASTER->BirdKilled(ME, QueryProp(P_KILLER));

  ::die(poisondeath);
}
