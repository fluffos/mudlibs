inherit "std/unit";

#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>


create()
    {
    if (!is_clone(this_object())) return;
        ::create();

    AddSingularId (({ "kalk","haeufchen", "gramm", "\nkalk" }));
    AddPluralId( ({ "kalk", "gramm", "\nkalk" }));
    SetProp (P_SHORT, "Ein Haeufchen Kalk");
    SetProp (P_LONG, "Das duerften wohl die Ueberreste einer Eierschale sein.");
    SetProp (P_NAME, ({ "Gramm Kalk", "Gramm Kalk" }));
    SetProp (P_GENDER, NEUTER);
    SetProp (P_VALUE, 1);
    SetProp (P_WEIGHT, 1);
    SetProp (P_NOBUY, 1);
    SetProp (P_VALUE, 0);
//    SetProp (P_NOSELL, 1);
    SetProp (P_MATERIAL, MAT_LIME);
    SetProp (P_ARTICLE, 0);
    SetProp (P_AUTOLOADOBJ, 1);


    }
