inherit "std/thing";

#pragma strong_types

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <wizlevels.h>
#include <class.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

#define LIME "/d/huegelland/iwo/muehle/morphei/kalk.lpc"
#define MORPHBIRD "/d/huegelland/iwo/muehle/morphei/morphbird.lpc"
#define ti(x) if(find_player("iwo")) tell_object(find_player("iwo"),x)
#define LIST "/d/huegelland/iwo/muehle/morphei/.a/b"
#define DEFAULTNPC "/d/ebene/Midas/npc/fraggle"
#define EGGMASTER "/d/huegelland/iwo/muehle/morphei/eggmaster.lpc"
#define EGGEVENTMASTER "/d/event/iwo/egg/master"

#define MIN_LIME 10
#define MAX_LIME 70

#define EGGDELAY 15

//////////////////
// Set defaults //
//////////////////

// Globals
nosave string prefix = "";
nosave string fullname = "";
nosave string mum="";
nosave int progress=0;
nosave int turn=0;
nosave mixed choosed_npc="";
nosave int alvl=5;
nosave string *data;

// Function predefs
void makebird(object obj);
void SetObject();

// Wie oft?
nosave int turns_needed = 70 + random(150);

// Fuers event
int eventegg = 0;



void create()
{
   ::create();
   fullname = capitalize(sprintf("%sei", prefix));
   SetProp(P_SHORT, sprintf("Ein %s", fullname));
   SetProp(P_LONG, sprintf("Tja, ein %s. Was man damit wohl machen kann?", fullname)); 
   SetProp(P_NAME, fullname);
   SetProp(P_GENDER, NEUTER);
   AddId(({"ei", "morphei", fullname}));
   SetProp(P_WEIGHT, 10);
   SetProp(P_VALUE, 5);
   SetProp(P_NODROP, 0);
   SetProp(P_NOSELL, 1);
   SetProp(P_MATERIAL, ([MAT_LIME:10, MAT_MISC_LIVING:90]));

   SetObject();

   AddCmd( ({ "iss", "esse", "ess" }), "eatit");
   AddCmd( ({ "bruete", "bruet", "setze", "setz" }), "makeit");
}


int SetTurn(int x, int y) {
  turn=x;  
  turns_needed=y; 

  SetProp(P_LONG, sprintf("Tja, ein %s. Was man damit wohl machen kann? In seiner Schale sind %d Kerben.", fullname, x)); 

  return 1;
}

int SetObject()
{
   data = EGGMASTER->GiveEgg();

   prefix = data[0];

   switch (prefix[<1..])
     {
       case "e":
         prefix += "n";
         break;
     }

   fullname = capitalize(sprintf("%sei", prefix));
   alvl = to_int(data[1]);
   mum = data[2];

   SetProp(P_SHORT, sprintf("Ein %s", fullname));
   SetProp(P_LONG, sprintf("Tja, ein %s. Es ist oval, so wie ein Ei sein sollte. Was man damit wohl machen kann?", fullname)); 
   SetProp(P_NAME, fullname);
   AddId(({"ei", "morphei", lower_case(fullname)}));
   //ti(sprintf("P_LEVEL: %O\n", obj->QueryProp(P_LEVEL)));

   return 1;
}


// Man kanns essen. Bringt aber nix.
int eatit(string str)
{
  notify_fail("Was willst Du essen?\n");
  if (!str || (str != "ei" && str != fullname)) return 0;

  notify_fail("Igitt, dieses Ei ist nichtmehr frisch!\n");
  if (eventegg || QueryProp(P_NOGET)) return 0;

  tell_room(ENV(TP), BS(sprintf("%s isst genuesslich ein %s.", TP->Name(WER),
                                                               fullname)),
	             ({ TP }));
  tell_object(TP, BS(sprintf("Genuesslich verzehrst Du das %s.", fullname)));

  ti(sprintf("MORPHEI: Ei gegessen - TP: %O\n", TP));  

  remove();
  return 1;
}


// Ausbrueten
int makeit(string str)
{
  notify_fail("Was willst Du denn ausbrueten?\n");
  if (!str ||
      (strstr(str, "ei") == -1 && strstr(str, fullname) == -1))
      return 0;

  ti(sprintf("MORPHEI: COMMAND: %s\n", str));

  notify_fail("Du solltest das Ei vorher besser ablegen.\n");
  if (ENV(ME) == TP) return 0;

  notify_fail("Aber das ist doch garnicht Dein Ei!\n");
  if (prefix != "" && !IS_ARCH(TP) && getuid(TP) != "iwo") return 0;

  progress = 1;

  makebird(TP);

  return 1;
  
}

// Vogerl machen
void makebird(object obj)
{
  int ptime;
  
  ptime = 5;
  
  //ti(sprintf("FUN: makebird, obj: %O\n", obj));
  if (!obj) return 0;
  
  //Spieler werden laenger paralysiert
  if (interactive(obj)) ptime += 5;
  
  tell_room(ENV(obj), BS(obj->Name(WER) + " setzt sich gemuetlich auf das "
                         + fullname + "."), ({ obj }));
  tell_object(obj, BS("Du setzt Dich gemuetlich auf das " + fullname + "."));	

  TO->SetProp(P_NOGET, "Das waere zu gefaehrlich!\n");
  
  obj->SetProp(P_PARALYZED, ([PARALYZE_TIME: ptime,
                              PARALYZE_MSG: BS("Du bruetest "
			                       + fullname +
					       " aus."),
                              PARALYZE_MSG_OTHER: BS(obj->Name(WER) +
			                       " bruetet "
					       + fullname +
					       " aus."),
		              PARALYZE_END: BS("Du erhebst Dich wieder."),
			      PARALYZE_END_OTHER: BS(obj->Name(WER) +
			      	               " erhebt sich wieder.")]));
  turn++;
  //ti(sprintf("TURN: %d, TURNS_NEEDED: %d\n", turn, turns_needed));
  if (turn < turns_needed)
    call_out("makebird_step2", eventegg?100+random(140):15, obj);
  else 
    call_out("makebird_lastturn", 15);
  
  return;
}


void makebird_event()
{
  call_out("makebird_step2", 100+random(140), ME);
}


void makebird_step2(object obj)
{
  int i;
  object ob;

  if (eventegg && EGGEVENTMASTER->Limit())
    {
      call_out("remove", 0);
      return;
    }
  
  if (!obj) return;

  tell_room(ENV(TO), BS("Ploetzlich bricht die Schale des " + fullname + "s auf."));

  // Kalk clonen
  ob = clone_object(LIME);
  ob->move(ENV(ME), M_NOCHECK + M_SILENT);
  
  ob = clone_object(MORPHBIRD);
  //ti(sprintf("LVL: %d\n", alvl));
  if (eventegg)
    ob->SetEventObject(data);
  else
    ob->SetObject(obj, turn, turns_needed, alvl);

  if (eventegg) ob->SetEvent(1);
  ob->move(ENV(ME), M_TPORT + M_NOCHECK);
  remove();
  return;
}


void makebird_lastturn()
{
  object ob;
  
  tell_room(ENV(TO), BS("Ploetzlich bricht die Schale des " + fullname + "s auf."));
  
  ob = clone_object(MORPHBIRD);
  ob->SetLast();
  ob->move(ENV(ME), M_TPORT);
  remove();
  return;
  
}


void init()
{
  object *inv;
  int i;
  object envenv;
  ::init();
  //ti(sprintf("ENV(ME): %O\n", ENV(ME)));
  if(!ENV(ME) || progress ) return;

  if(living(ENV(ME) && ENV(ENV(ME)))) envenv=ENV(ENV(ME));
  else envenv=ENV(ME);
  //ti(sprintf("FUN: init, envenv: %O\n", envenv));
  inv=filter_array(all_inventory(envenv), #'living);
  if(!sizeof(inv)) return;
  for(i=sizeof(inv)-1;i>=0;i--) {
    //ti(sprintf("CUR TEST. OBJ: %O\n", inv[i]));
    if(explode(file_name(inv[i]), "#")[0] == mum) {
      //ti(sprintf("PASST! %O is ok!\n", inv[i]));
      progress=1;
      ti(sprintf("MORPHEI: GEBURT. Turn: %d, TP: %O\n", turn, ENV(ME)));
      call_out("makebird",0,inv[i]);
      break;
    }
  }
}

void reset()
{
  // Wir resetten nicht.
  return;
}

string GetRegion()
{
  return explode(mum, "/")[1];
}

int SetEvent(int e)
{
  return eventegg = e;
}

int QueryEvent()
{
  return eventegg;
}

