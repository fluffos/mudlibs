
inherit "std/npc";
inherit "std/npc/spells";


#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>

#define PANZER_S "/d/huegelland/iwo/muehle/morphei/kalkpanzer_s.lpc"
#define PANZER_M "/d/huegelland/iwo/muehle/morphei/kalkpanzer_m.lpc"
#define PANZER_L "/d/huegelland/iwo/muehle/morphei/kalkpanzer_l.lpc"

void create() {
  object ob;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Tordon der Steinmetz");
  SetProp(P_LONG,
    "Ein staemmiger Troll. Seine ausgepraegten Muskeln sagen Dir, dass es "
    "nicht sehr Klug waere sich mit ihm anzulegen.");
  SetProp(P_NAME, "Tordon");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);

  AddId( ({ "tordon" , "troll", "steinmetz" }));
  
  create_default_npc(40);

  SetProp(P_HANDS, ({" mit seinen steineren Faeusten",300,DT_BLUDGEON}));
  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MMSGIN, "trampelt herein");

  SetProp(P_XP, 100);
  SetProp(P_NOATTACK, "wuerde Dich mit einem Schlag zerquetschen.");

  ob = clone_object(PANZER_S);
  ob->move(ME);
  enable_commands();
  command_me("trage alles");

  AddInfo("kalk", "Wenn Du mir Kalk bringst, mach ich Dir 'nen Panzer daraus.", "sagt: ");
  AddInfo( ({ "panzer", "kalkpanzer" }), "Ja, ich kann Dir einen machen. Bring mir nur etwas Kalk.", "sagt: ");

  AddCmd( ({ "zeige", "zeig" }), "show_it");

}


give_notify ( object ob )
{
  if (ob->id("\nkalk"))
    {
      switch(ob->QueryProp(P_AMOUNT))
        {
          case 4000 .. 5999:
	    command_me("sag Hm, das reicht fuer einen leichten Panzer.");
	    tell_room(ENV(ME), BS(TO->Name(WER) + " haemmert mit seinen "
	      "steinernen Faeusten auf einem Haufchen Kalk herum."));
	    ::give_notify(ob);
	    ob->remove();
	    clone_object(PANZER_L)->move(ME);
	    command_me(sprintf("gib panzer an %s", getuid(TP)));
	    return 1;
	    break;
          case 6000 .. 7999:
	    command_me("sag Hm, das reicht fuer einen mittleren Panzer.");
	    tell_room(ENV(ME), BS(TO->Name(WER) + " haemmert mit seinen "
	      "steinernen Faeusten auf einem Haufchen Kalk herum."));
	    ::give_notify(ob);
	    ob->remove();
	    clone_object(PANZER_M)->move(ME);
	    command_me(sprintf("gib panzer an %s", getuid(TP)));
	    return 1;
	    break;
          case 8000 .. 800000:
	    command_me("sag Hm, das reicht fuer einen schweren Panzer.");
	    tell_room(ENV(ME), BS(TO->Name(WER) + " haemmert mit seinen "
	      "steinernen Faeusten auf einem Haufchen Kalk herum."));
	    ::give_notify(ob);
	    ob->remove();
	    clone_object(PANZER_S)->move(ME);
	    command_me(sprintf("gib panzer an %s", getuid(TP)));
	    return 1;
	    break;
          default:
	    command_me("sag Das ist viel zu wenig. Damit kann ich nichts anfangen.");
            give_obj(ob, TP);
	    return 0;
	    break;
	}
    }

  command_me("sag Was soll ich damit?");
  give_obj(ob, TP);
  return 0;
}

int show_it(string str)
{
  object kalk;
  int amount;
  
  string whom, what;
  if (!str) return 0;
  
  if (sscanf(str, "%s %s", whom, what) != 2) return 0;
  
  if (member( ({"tordon", "steinmetz", "troll" }), whom) == -1) return 0;
  if (what != "kalk") return 0;
  
  kalk = present("\nkalk", TP);
  
  if (!kalk) return 0;
  
  amount = kalk->QueryProp(P_AMOUNT);
  
  call_out("test_lime", 2, amount);
  
  return 0;
}

void test_lime(int amount)
{
  switch (amount)
    {
      case 4000 .. 5999:
	    command_me("sag Davon geht sich vielleicht ein leichter Panzer aus.");
	    break;
          case 6000 .. 7999:
	    command_me("sag Das reicht wohl fuer einen mittleren Panzer.");
	    break;
          case 8000 .. 800000:
	    command_me("sag Aah, dafuer bekommst Du einen schweren Panzer.");
	    break;
          default:
	    command_me("sag Was fuer ein laecherliches Haeufchen!");
	    break;
	}

  return;
}
