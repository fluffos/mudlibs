
inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <combat.h>


create()
{
	if (!is_clone(this_object())) return;
	
	::create();
	
	AddId( ({"kalkpanzer", "panzer"}) );
	
	SetProp(P_SHORT, "Ein durchschnittlicher Kalkpanzer");
	SetProp(P_LONG, "Er ist ziemlich schwer, scheint aber ein "
	                "ausgezeichneter Schutz zu sein.\n");
	
	SetProp(P_NAME, "Kalkpanzer");
        SetProp(P_NAME_ADJ, "durchschnittlich");
	SetProp(P_GENDER, MALE);
	SetProp(P_WEIGHT, 6000);
	SetProp(P_VALUE, 8500);
	SetProp(P_NOBUY, 1);
	
	SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
	SetProp(P_AC, 30);
	
	SetProp(P_MATERIAL, ([MAT_LIME:100]));
	
	//restrictions
	// SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL: 35]));
								 
	SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:1,T_HEAT_PROT:3]) );
	//SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)
	//  +([DT_FIRE:3, DT_AIR:0, DT_ACID:2,
	//     DT_SLASH:3, DT_BLUDGEON:3, DT_PIERCE:3,
	//     DT_SQUEEZE:3, DT_RIP:3, DT_WHIP:3 ]) );

        SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)
          +([DT_FIRE:2, DT_AIR:0, DT_ACID:1,
             DT_BLUDGEON:2, DT_PIERCE:2,
             DT_SQUEEZE:2 ]) );
	
        SetProp(P_QUALITY_DECAY, ([ 0: 80,
                                    DT_FIRE:  0,
                                    DT_AIR:  30,
                                 ]));
	
}

