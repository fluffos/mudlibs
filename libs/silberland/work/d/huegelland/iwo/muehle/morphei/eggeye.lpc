#pragma strong_types

inherit "std/thing";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

#define EGGMASTER "/d/huegelland/iwo/muehle/morphei/eggmaster"

#define MAX_IDLE 120
#define MAX_STOP 120

#define TMI(x) if (find_player("iwo")) tell_object(find_player("iwo"), break_string(x, 78, "EGGEYE: "));

object lastenv;
int lastenvchange = 0;

void create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_NAME,    "Auge");
  SetProp(P_SHORT,   "Ein Auge");
  SetProp(P_LONG,    "Eigentlich ist es vielmehr nur ein Augapfel.");
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 0);
  SetProp(P_INFO, "Irgendetwas merkwuerdiges geht von dem Auge aus.");

  AddId( ({ "auge", "\neggeye" }) );

  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER,  NEUTER);

  SetProp(P_WEIGHT, 0);
  SetProp(P_SIZE, 5);

  AddDetail( ({ "pupille" }),
    "Hinter der tiefschwarzen Pupille scheint die Unendlichkeit zu "
    "liegen.");
  AddDetail( ({ "unendlichkeit" }),
    "Vergeblich versucht Du sie zu erfassen.");
  AddDetail( ({ "iris" }),
    "Die Farbe der Iris laesst sich nicht so genau sagen - mal gruen, "
    "dann blau, mal braun, dann grau...");
  AddDetail( ({ "farbe" }),
    "Du kannst nicht genau sagen welche.");
  catch("/players/iwo/tools/cl/clm"->cl());
}

void init()
{
  call_out("pseudo_init", 0);
  ::init();
}


void pseudo_init()
{
  if (TP && !TP->QueryProp(P_INVIS))
    {
      TMI(sprintf("INIT TP: %O", TP));

      // Env update stuff
      if (interactive(ENV(ME)))
        {
          if (ENV(ENV(ME)) != lastenv)
            {
              lastenv = ENV(ENV(ME));
              lastenvchange = time();
            }
          else
            {
              if (lastenvchange < time()-MAX_STOP && interactive(TP))
                {
                  tell_room(ENV(ENV(ME)), BS(TO->Name(WER)
                    + " faellt " + ENV(ME)->name(WEM)
                    + " aus der Hand."), ({ ENV(ME) }));
                  tell_object(ENV(ME), BS(TO->Name(WER)
                    + " faellt Dir aus der Hand."));
                  TO->move(ENV(ENV(ME)), M_SILENT);
                  tell_room(ENV(ME), BS(TO->Name(WER)
                    + " glotzt " + TP->Name(WEN) + " an."),
                    ({ TP }));
                  tell_object(TP, BS(TO->Name(WER) + " glotzt "
                    + "Dich an."));
                  return;
                }
            } // if (ENV(ENV(ME)) != lastenv)
        } // if (interactive(ENV(ME)))
  

      // Non interactive, check for eggmaster stuff
      if (!query_once_interactive(TP))
        {
          if (living(TP) && !TP->QueryProp(P_NOATTACK))
            {
              EGGMASTER->AddNpc(TP, ENV(ME));

              if (random(10) > 7)
                {
                  if (interactive(ENV(ME)))
                    tell_object(ENV(ME), BS(TO->Name(WER)
                      + " glotzt " + TP->name(WEN) + " an."));
                  else
                    tell_room(ENV(ME), BS(TO->Name(WER)
                      + " glotzt " + TP->name(WEN) + " an."));
                }
              return;
            }
            

        }
      // Interactive, make me interesting
      else
        {
          // We're outside a player
          if (!interactive(ENV(ME)))
            {
              tell_room(ENV(ME), BS(TO->Name(WER) 
                + " glotzt " + TP->name(WEN) + " an."), ({ TP }));
              tell_object(TP, BS(TO->Name(WER)
                + " glotzt Dich an."));
              return;
            }
          else
            {
              if (TP->QueryProp(P_LEVEL) > ENV(ME)->QueryProp(P_LEVEL))
                {
                  if (random(10)>6)
                    {
                      tell_room(ENV(ENV(ME)), BS(TO->Name(WER)
                        + " faellt " + ENV(ME)->name(WEM)
                        + " aus der Hand."), ({ ENV(ME) }));
                      tell_object(ENV(ME), BS(TO->Name(WER)
                        + " faellt Dir aus der Hand."));
                      TO->move(ENV(ENV(ME)), M_SILENT);
                      tell_room(ENV(ME), BS(TO->Name(WER)
                        + " glotzt " + TP->Name(WEN) + " an."),
                        ({ TP }));
                      tell_object(TP, BS(TO->Name(WER) + " glotzt "
                        + "Dich an."));
                      return;
                    }
                } // if (TP->QueryProp(P_LEVEL) > ENV(ME)->Q...
            } // if (!interactive(ENV(ME)))
        }  // f (!query_once_interactive(TP))
    } // if (TP)

}

varargs int move(mixed d, int m)
{
  TMI(sprintf("Move %O -> %O", ENV(ME), d));
  return ::move(d, m);
}
