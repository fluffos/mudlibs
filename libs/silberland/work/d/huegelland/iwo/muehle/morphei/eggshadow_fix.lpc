#pragma strong_types

inherit "std/thing";

#include <moredef.h>
#include <defines.h>
#include <properties.h>
#include <moving.h>
#include <npc.h>
#include <wizlevels.h>
#include <combat.h>

#define TMI(x) if (find_player("iwo")) tell_object(find_player("iwo"), break_string(x, 78))

#define EGGMASTER "/d/huegelland/iwo/muehle/morphei/eggmaster"

object curr_pl;

void create()
{
  if (!is_clone(this_object())) return;
  
  ::create();
  
  SetProp(P_NAME, "Eggshadow");
  SetProp(P_INVIS, 1);
  SetProp(P_NOATTACK, 1);
  SetProp(P_NO_GLOBAL_ATTACK, 1);
  SetProp(P_FRIEND, 1);
  
  AddId( ({ "eggshadow", "\neggshadow" }) );
  
  SetProp(P_INVIS, 1);
}


int Attach(string pl)
{
  object chosen;
 
  TMI(sprintf("Chosen: %O", (chosen = find_player(pl))));
  
  chosen->AddPursuer(this_object());
  
  curr_pl = chosen;
  
}

void init()
{
  if (TP)
    {
      //TMI(sprintf("PO: %O", PO));
      if (living(TP) && !query_once_interactive(TP) && !TP->QueryProp(P_NOATTACK))
        EGGMASTER->AddNpc(TP, curr_pl);
    }
  ::init();
}

