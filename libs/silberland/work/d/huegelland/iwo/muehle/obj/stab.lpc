inherit "std/thing";

#include <properties.h>

create()
{
   ::create();
   SetProp(P_SHORT, "Ein Holzstab");
   SetProp(P_LONG, "Ein Holzstab. Sieht aus, als waere er ein Ersatzteil oder so.\n");
   SetProp(P_NAME, "Holzstab");
   SetProp(P_GENDER, MALE);
   AddId(({"stab", "holzstab", "stabfuermuehle"}));
   SetProp(P_WEIGHT, 125);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP, 1);
   SetProp(P_NEVERDROP, 1);
   SetProp(P_AUTOLOADOBJ, 1);
}
