
/* Ein vollkommen belaemmertes Object */
    
inherit "std/thing";

#include <properties.h>

create()
{
   ::create();
   SetProp(P_SHORT, "Ein Forscherpunkt");
   SetProp(P_LONG, "Ein Forscherpunkt. Scheinbar hast Du Dich echt gut umgesehen.");
   SetProp(P_NAME, "Forscherpunkt");
   SetProp(P_GENDER, MALE);
   AddId(({"punkt", "forscherpunkt"}));
   SetProp(P_WEIGHT, 0);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP, 1);
   SetProp(P_NEVERDROP, 1);   
   catch("/players/iwo/tools/cl/clm"->cl());
}
