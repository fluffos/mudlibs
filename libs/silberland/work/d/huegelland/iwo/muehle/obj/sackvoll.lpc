inherit "std/thing";

#include <properties.h>

create()
{
   ::create();
   SetProp(P_SHORT, "Ein voller Mehlsack");
   SetProp(P_LONG, "Ein Mehlsack. Er ist randvoll.\n");
   SetProp(P_NAME, "Mehlsack");
   SetProp(P_GENDER, MALE);
   AddId(({"sack", "mehlsack", "mehlfuermuehle"}));
   SetProp(P_WEIGHT, 5000);
   SetProp(P_VALUE, 0);
   SetProp(P_NODROP, 0);
   SetProp(P_NEVERDROP, 1);
   SetProp(P_AUTOLOADOBJ, 1);

}
