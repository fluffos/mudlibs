#include "../def.h"

inherit "std/food";

#include <properties.h>
#include <food.h>
#include <defines.h>
#include <moredef.h>

/* Wie lang (pft) stinkt das teil? */
#define MAXCOUNT 50

int count = 0;

create()
    {
    if (!is_clone(this_object())) return;
        ::create();

    AddId (({ "morchel","stinkmorchel" }));
    SetProp (P_SHORT, "Eine Stinkmorchel");
    SetProp (P_LONG, "Eine gigantisch stinkende Stinkmorchel.\n");
    SetProp (P_NAME, "Stinkmorchel");
    catch("/players/iwo/tools/cl/clm"->cl());
    SetProp (P_FOOD_INFO, ([F_HEAL : ({5, 5}), F_SOAK : 2,
        F_MSG:"Weg isse...\n",
	F_MSG_ROOM:"isst die Stinkmorchel.\n"]));
    SetProp (P_GENDER, FEMALE);
    SetProp (P_VALUE, 10);
    SetProp (P_WEIGHT, 50);
    SetProp (P_NOBUY, 1);
    SetProp (P_MATERIAL, MAT_MISC_FOOD);
    SetProp (P_SMELL, "Die Stinkmorchel stinkt fuerchertlich.\n");

    call_out("stinken",30+random(30));
//    call_out("stinken",12);

//    AddCmd (({"iss","ess","esse","futter","mampf"}), "iss");


    }

/*
BecomesNetAlive(object wer)
Woody teilt Dir mit: bzw. void BecomesNetDead(object wer)   
*/

void stinken()
    {
    if (environment(TO) && living(environment(TO)))
        {
        tell_object(environment(TO), "Du stinkst fuerchterlich.\n");
        tell_room(environment(environment(TO)), environment(TO)->Name()+" stinkt fuerchterlich.\n",
	          ({environment(TO)}) );  
        }
    else
        {
        tell_room(environment(TO), "Die Stinkmorchel stinkt fuerchterlich.\n");  
        }
    
    if (count > MAXCOUNT)
        {
	tell_object(environment(TO), BS("Die Stinkmorchen verfault und "
	            "zerfaellt."));
	TO->remove();
	}
    
    
    call_out("stinken",30+random(30));
//    call_out("stinken",12);

    }

