
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

mapping training;

void create() {
  ::create();

  training=([]);
  SetProp( P_INT_SHORT, "In einer Muehle" );
  SetProp( P_INT_LONG,
      "Du befindest Dich in einer kleinen Muehle. Alles hier ist in "
      "echter Handarbeit gefertigt und aus unbehandeltem Holz. "
      "Die Dielen auf dem Boden knarren leise und beruhigend unter "
      "der Last Deiner Schritte. Im Gebaelk ueber Dir kannst Du "
      "kleine Spinnennetze erkennen. Nach Sueden kannst Du die Muehle "
      "wieder verlassen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "muehle" }),
      "Ein grosses Haus, in dem Mehl gemacht wird.");

  AddDetail( ({ "mehl" }),
      "Das hervorragende Mehl aus dieser Muehle verwendet man im "
      "gesamten SilberLand, um koestliche Backwaren herzustellen.");

  AddDetail( ({ "silberland" }),
      "Die Welt in der Du Dich befindest nennt man so.");
      
  AddDetail( ({ "backwaren" }),
      "Koestlichkeiten, gebacken aus Mehl und anderem Zeugs.");
      
  AddDetail( ({ "koestlichkeiten" }),
      "Ja, es gibt viele verschiedene davon.");
      
  AddDetail( ({ "zeugs" }),
      "Leider weisst Du nicht, was verwendet wird um sie herzustellen.");
      
  AddDetail( ({ "handarbeit", "kunst" }),
      "Handarbeit ist eine Kunst, die wohl erlernt sein muss.");
      
  AddDetail( ({ "waende", "wand" }),
      "Ebenso wie der Boden und die Decke sind die Waende aus "
      "Holz.");

  AddDetail( ({ "holz" }),
      "Das Holz duftet frisch.");
      
  AddDetail( ({ "dielen", "holzdielen", "diele", "holzdiele" }),
      "Nahtlos bedecken die Holzdielen den Boden.");
      
  AddDetail( ({ "last", "schritte", "knarren" }),
      "Die Holzdielen geben ein leises Knarren von sich bei jedem "
      "Deiner Schritte.");
      
  AddDetail( ({ "gebaelk" }),
      "Das tragende Gebaelk verhindert, dass Dir die Decke auf den "
      "Kopf faellt. In den Ecken haben sich kleine Spinnen ihre "
      "Netze gebaut.");
      
  AddDetail( ({ "ecken", "spinnen", "netze", "spinnennetze",
                "ecke", "spinne", "netz", "spinnennetz" }),
      "Wunderschoene Netze kleiner Spinnen verzieren das Gebaelk.");
      
  AddDetail( ({ "decke" }),
      "Die Decke ueber Dir wird von massivem Gebaelk getragen.");
      
  AddDetail( ({ "boden" }),
      "Der Boden ist mit kunstvollen Holzdielen ausgelegt.");
      

  AddDetail( ({ "kopf" }),
      "Das seltsame Ding zwischen Deinen Schultern.");
      
  AddDetail( ({ "ding" }),
      "Pfui!");
      
  AddDetail( ({ "schultern" }),
      "Deine Schultern sind nicht besonders breit. Du solltest "
      "vielleicht etwas trainieren?");

  AddDetail( ({ "bewegeung", "bewegungen" }),
      "Das interessiert Dich nun aber wirklich nicht.");

  AddDetail( ({ "haus" }),
      "Dieses spezielle Haus ist eine Muehle.");
      
  AddDetail( ({ "welt" }),
      "Nun... jeder lebt in seiner eigenen kleinen Welt. "
      "Aber das sollte hier nicht erlaeutert werden.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur das leise Knarren der Dielen bei Deinen Bewegungen.");

  AddSound( ({"knarren"}),
    "Gebannt lauscht Du dem Knarren.");

  AddSmell( DEFAULT_SMELL,
    "Das Holz duftet frisch und verbreitet einen angenehmen Geruch.");

  AddSmell( ({"holz"}),
    "Hmmmmm, riecht echt gut :)");

  AddCmd( ({"trainiere", "trainier"}), "trainieren");

  AddExit( "norden", "./muehle003" );
  AddExit( "westen", "./muehle002" );
  AddExit( "osten", "./muehle004" );
//  AddExit( "raus", "./room001" );
  AddExit( "sueden", "./room001" );
  SetProp(P_HIDE_EXITS, ({"sueden"}) );
  
}


int trainieren ()
{
  tell_object(TP, BS("Du machst ein paar Liegestuetze und Kniebeugen "
        "und fuehlst Dich gleich viel besser."));
  tell_room(environment(TP), BS(TP->Name() + " macht ein paar Liegestuetze "
        "und scheint sich gleich viel besser zu fuehlen."), ({TP}));
  if( !training[getuid(TP)] )
  {
    training[getuid(TP)]=1;
    TP->AddHp(5+random(5));
  }
  return 1;
}

void reset()
{
  ::reset();
  training=([]);
}
		       
