
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einer Muehle" );
  SetProp( P_INT_LONG,
      "Du befindest Dich in einer kleinen Muehle. Alles hier ist in "
      "echter Handarbeit gefertigt und aus unbehandeltem Holz. "
      "Die Dielen auf dem Boden knarren leise und beruhigend unter "
      "der Last Deiner Schritte. Im Gebaelk ueber Dir kannst Du "
      "kleine Spinnennetze erkennen. An der Wand stehen eine "
      "merkwuerdige Maschine und ein Trog." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"gebaelk", "balken"}),
      "Das Gebaelk besteht aus vielen Balken, zwischen denen Spinnen "
      "ihre Netze gespannt haben.");

  AddDetail( ({ "muehle", "haus" }),
      "Ein grosses Haus, in dem Mehl gemacht wird.");

  AddDetail( ({ "mehl" }),
      "Das hervorragende Mehl aus dieser Muehle verwendet man im "
      "gesamten SilberLand, um koestliche Backwaren herzustellen.");

  AddDetail( ({ "silberland", "welt" }),
      "Die Welt in der Du Dich befindest nennt man so.");
      
  AddDetail( ({ "backwaren" }),
      "Koestlichkeiten, gebacken aus Mehl und anderem Zeugs.");
      
  AddDetail( ({ "koestlichkeiten" }),
      "Ja, es gibt viele verschiedene davon.");
      
  AddDetail( ({ "zeugs" }),
      "Leider weisst Du nicht, was verwendet wird um sie herzustellen.");
      
  AddDetail( ({ "handarbeit", "kunst" }),
      "Handarbeit ist eine Kunst, die wohl erlernt sein muss.");
      
  AddDetail( ({ "holz" }),
      "Das Holz duftet frisch.");
      
  AddDetail( ({ "dielen", "holzdielen", "diele", "holzdiele" }),
      "Nahtlos bedecken die Holzdielen den Boden.");
      
  AddDetail( ({ "last", "schritte", "knarren" }),
      "Die Holzdielen geben ein leises Knarren von sich bei jedem "
      "Deiner Schritte.");
      
  AddDetail( ({ "decke" }),
      "Du kannst den Dachstuhl weit ueber Dir erkennen.");
      
  AddDetail( ({ "dach", "dachstuhl" }),
      "Das Dach kannst Du nicht erkennen, aber der Dachstuhl ist "
      "echt bewundernswert. Wer den wohl angefertigt hat?"); 
      
  AddDetail( ({ "boden" }),
      "Uberall am Boden liegt Mehl herum. Wie das da wohl hingekommen sein mag?");

  AddDetail( ({ "maschine", "teil", "getreidemuehle" }),
      "Das duerfte die eigentliche Getreidemuehle sein. Ein suspektes "
      "Teil. Sie ist vollkommen aus Holz. An der linken Seite befindet "
      "sich ein kleiner Hebel und an der rechten ist ein Abfuellstutzen.");

  AddDetail( ({ "seite" }),
      "Du erkennst einen kleinen Hebel an der Seite.");

  AddDetail( ({"hebel"}),
      "Ein ganz normaler Hebel. Was man wohl damit machen kann?");


  AddDetail( ({"stapel", "mehlsaecke", "saecke"}),
      "Du koenntest vielleicht einen der Saecke an dem Stutzen "
      "befestigen?");
      
  AddDetail( ({"trog"}),
      "Der Trog ist voll mit Korn.");
      
  AddDetail( ({"korn"}),
      "Du koenntest etwas davon in den Trichter oben an der Muehle "
      "geben.");
      

  AddDetail( ({"inneres"}),
      "Das kannst Du nicht sehen, solang die Muehle geschlossen ist.");

  AddDetail( ({"mechanik"}),
      "Vielleicht solltest Du sie reparieren?\n");

  AddDetail( ({ "wand", "waende" }),
      "An einer der Waende steht die Getreidemuehle.");
      
  AddDetail( ({ "spinnennetze", "netze", "netz", "spinnennetz", 
        "spinne", "spinnen" }),
      "Trotz der vielen Spinnennetze siehst Du keine einzige Spinne.");
      
  AddSpecialDetail( ({"abfuellstutzen", "stutzen"}), "stutzen");

  AddSpecialDetail( ({"trichter"}), "trichter");

  AddSpecialDetail( ({"sack", "mehlsack"}), "sack");

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur das leise Knarren der Dielen bei Deinen Bewegungen.");


  AddSmell( DEFAULT_SMELL,
    "Das Holz duftet frisch und verbreitet einen angenehmen Geruch.");

  AddExit( "sueden", ROOMS "muehle006" );

  AddCmd( ({"zieh", "ziehe"}), "ziehen");
  AddCmd( ({"schaufel", "schaufle"}), "schaufeln");
  AddCmd( ({"befestig", "befestige"}), "befestigen");
  AddCmd( ({"oeffne"}), "oeffnen");
  AddCmd( ({"repariere"}), "reparieren");

  
}


int ziehen (string str)
    {
    object ob;
    
    notify_fail("Woran willst Du ziehen?\n");
    if (!str || !(str == "hebel" || str == "an hebel")) return 0;
    
    notify_fail("Du traust Dich nicht.\n");
    if (!call_other(QMASTER, "isquester", TP)) return 0;
    
    tell_object(TP, "Du ziehst an dem Hebel.\n");
    
    notify_fail("Aber nichts passiert ...\n");
    if (!call_other(QMASTER, "wheelturns", TP)) return 0;
    

    notify_fail("Die Muehle rattert aber nix kommt raus.\n");
    if (!call_other(QMASTER, "isflourin", TP)) return 0;

    tell_object(TP, "Die Muehle rattert.\n");
    
    notify_fail(BS("Die Muehle poltert kurz und bleibt wieder stehen.\n"
                "Scheinbar ist im Inneren etwas kaputt gegangen."));
    if (!call_other(QMASTER, "fixedmuehle", TP)) return 0;
    
    notify_fail(BS("PLATSCH!\nDas Mehl faellt auf den Boden."));
    if (!call_other(QMASTER, "issackon", TP))
        {
	call_other(QMASTER, "flourout", TP);
	return 0;
        }

    tell_object(TP, "Der Sack fuellt sich mit Mehl.\n");
    call_other(QMASTER, "flourout", TP);
    
    ob = clone_object(OBJECTS "sackvoll");
    
    if (ob->move(TP)== ME_TOO_HEAVY)
        {
	notify_fail("Der Sack ist Dir leider zu schwer.\n");
        ob->move(ME);
	return 0;
	}
    
    tell_object(TP, "Du schulterst den Mehlsack.\n");
    
    
    return 1;
    }
    
    
int schaufeln (string str)
    {
    notify_fail("Was moechtest Du wo hineinschaufeln?\n");
    
    if(!str || !(strstr(str, "mehl") && strstr(str, "trichter")))
        return 0;

    notify_fail("Ohne Schaufel wird das wohl nix?\n");
    if (!present("schaufel", TP)) return 0;

    notify_fail("Du traust Dich nicht.\n");
    if(!call_other(QMASTER, "isquester", TP)) return 0;

    notify_fail("Das hast Du doch schon gemacht!\n");
    if(call_other(QMASTER, "isflourin", TP)) return 0;
    
    tell_object(TP, "Du schaufelst etwas Korn in den Trichter.\n");
    notify_fail("Es bugt. Bitte Iwo informieren.\n");
    if (!call_other(QMASTER, "changeflourin", TP)) return 0;

    return 1;
    
    }
    
int befestigen (string str)
    {
    notify_fail("Was willst Du woran befestigen?\n");
    if (!str || !(str == "sack an stutzen"
                  || str == "mehlsack an stutzen"
	          || str == "sack an abfuellstutzen"
	          || str == "mehlsack an abfuellstutzen"))
        return 0;

    notify_fail("Du traust Dich nicht.\n");
    if(!call_other(QMASTER, "isquester", TP)) return 0;

    notify_fail("Das hast Du doch schon gemacht!\n");
    if (call_other(QMASTER, "issackon", TP)) return 0;

    notify_fail("Es bugt. Bitte Iwo verstaendigen.\n");
    if (!call_other(QMASTER, "changesackon", TP)) return 0;

    tell_object(TP, "Du befestigst einen Sack an dem Stutzen.\n");
    
    return 1;
    }
   
int oeffnen (string str)
    {
    notify_fail("Was willst Du oeffnen?\n");
    if (!str ) return 0;
    if( member(({"muehle", "getreidemuehle", "maschine"}),str )==-1) return 0;
    
    notify_fail("Das hast Du doch schon gemacht!\n");
    if (call_other(QMASTER, "fixedmuehle", TP)) return 0;

    tell_object(TP,
        BS("Du oeffnest die Muehle und erkennst, dass die "
	   "Mechanik verklemmt ist.\nVielleicht kannst Du sie "
	   "reparieren?"));
	   
    return 1;
    }
    
int reparieren (string str)
    {
    notify_fail("Was moechtest Du reparieren?\n");
    if (!str || str != "mechanik") return 0;

    notify_fail("Du traust Dich nicht.\n");
    if (!call_other(QMASTER, "isquester", TP)) return 0;

    notify_fail("Das hast Du doch schon gemacht!\n");
    if (call_other(QMASTER, "fixedmuehle", TP)) return 0;
    
    notify_fail("Es bugt. Bitte Iwo informieren\n");
    if (!call_other(QMASTER, "changefixedmuehle", TP)) return 0;
    
    tell_object(TP, BS("Geschickt rueckst Du wieder alle Teile an "
                       "die dafuer vorgesehene Position und schliesst "
		       "die Muehle wieder."));
		    
    call_out("ratten", 5, TP);
		       
    return 1;
    }


void ratten(object player)
    {
    object ob;
    int num_rats;
    int i;
    
    tell_object(player, BS("Du hast beim Rumwerken ein der Muehle ein "
                "paar Ratten aufgescheucht.\n"));

    if ((num_rats = (int) player->QueryProp(P_LEVEL) / 10) == 0)
        num_rats = 1;


    for (i = 0; i < num_rats; i++)
        {
        ob = clone_object("/d/wasser/stahldorn/knarkh/npc/ratte");
        ob->move(TO, M_GO);
        ob->Kill(player);
	}
    
    }
    
    
string trichter()
{
  if(call_other(QMASTER, "isflourin", TP)) 
    return "Jemand hat eine grosse Menge Korn in den Trichter geschaufelt.\n";
  else
    return "Da kann man Korn reinschaufeln.\n";
}

string stutzen()
{
  if (call_other(QMASTER, "issackon", TP)) 
    return "Ein Sack ist am Abfuellstutzen befestigt.\n";
  else
    return "Da kommt dann das Mehl raus. Daneben liegt ein Stapel Mehlsaecke.\n";
}

string sack()
{
  if (call_other(QMASTER, "issackon", TP))
    return "Ein Sack ist am Abfuellstutzen befestigt.\n";
  else
    return "Alle Saecke liegen auf einem Stapel.\n";
}

