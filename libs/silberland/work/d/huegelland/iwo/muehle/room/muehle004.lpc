
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einer Muehle" );
  SetProp( P_INT_LONG,
      "Du befindest Dich in einer kleinen Muehle. Alles hier ist in "
      "echter Handarbeit gefertigt und aus unbehandeltem Holz. "
      "Durch ein kleines Fenster an der Wand faellt genug Licht "
      "in den Raum, um ihn ausreichend zu erhellen. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "muehle" }),
      "Ein grosses Haus, in dem Mehl gemacht wird.");

  AddDetail( ({ "mehl" }),
      "Das hervorragende Mehl aus dieser Muehle verwendet man im "
      "gesamten SilberLand, um koestliche Backwaren herzustellen.");

  AddDetail( ({ "silberland" }),
      "Die Welt in der Du Dich befindest nennt man so.");
      
  AddDetail( ({ "backwaren" }),
      "Koestlichkeiten, gebacken aus Mehl und anderem Zeugs.");
      
  AddDetail( ({ "koestlichkeiten" }),
      "Ja, es gibt viele verschiedene davon.");
      
  AddDetail( ({ "zeugs" }),
      "Leider weisst Du nicht, was verwendet wird um sie herzustellen.");
      
  AddDetail( ({ "handarbeit", "kunst" }),
      "Handarbeit ist eine Kunst, die wohl erlernt sein muss.");
      
  AddDetail( ({ "holz" }),
      "Das Holz duftet frisch.");
      
  AddDetail( ({ "dielen", "holzdielen", "diele", "holzdiele" }),
      "Nahtlos bedecken die Holzdielen den Boden.");
      
  AddDetail( ({ "last", "schritte", "knarren" }),
      "Die Holzdielen geben ein leises Knarren von sich bei jedem "
      "Deiner Schritte.");
      
  AddDetail( ({ "gebaelk" }),
      "Das tragende Gebaelk verhindert, dass Dir die Decke auf den "
      "Kopf faellt. In den Ecken haben sich kleine Spinnen ihre "
      "Netze gebaut.");
      
  AddDetail( ({ "ecken", "spinnen", "netze", "spinnennetze" }),
      "Wunderschoene Netze kleiner Spinnen verzieren das Gebaelk.");
      
  AddDetail( ({ "decke" }),
      "Die Decke ueber Dir wird von massivem Gebaelk getragen.");
      
  AddDetail( ({ "haus" }),
      "Ja, das ist ein Haus. Ein schoenes noch dazu.");

  AddDetail( ({ "boden" }),
      "Der Boden ist mit kunstvollen Holzdielen ausgelegt.");

  AddDetail( ({ "fenster" }),
      "Das Fenster ist nicht besonders gross, aber es scheint zu reichen.");

      
  AddDetail( ({ "wand", "waende" }),
      "Holz. Kunstvoll verarbeitetes bestes Holz. An einer Wand stehen "
      "ein Tisch und ein Stuhl.");

  AddDetail( ({ "tisch" }),
      "Der Tisch ist aus ... Holz. Was auch sonst?");
     
  AddDetail( ({ "stuhl" }),
      "Ein wunderschoener Stuhl aus ... Eisen! :)");
      
  AddDetail( ({ "eisen" }),
      "Endlich mal etwas, das nicht aus Holz ist.");
      
  AddDetail( ({ "raum" }),
      "Vier Waende, ein Boden und eine Decke. Ein schoener Raum :)");

  AddDetail( ({ "decke" }),
      "Sie trennt Oben und Unten.");
      
      
  AddDetail( ({ "licht", "sonne" }),
      "Du blinzelst kurz in die Sonne. Huch! Gottseidank bist Du nicht "
      "geblendet jetzt.");

  AddDetail( ({ "aufgabe" }),
      "Tja, das haettest Du wohl gern, dass hier was steht ;-)");

  AddDetail( ({ "welt" }),
      "Und Du rufst in die Welt, dass sie Dir nichtmehr gefaellt,\n"
      "Du willst 'ne schoen're Welt erleben...\n"
      "Doch es wird keine and're geben!");

  AddSound( ({DEFAULT_SOUND, "knarren"}),
    "Du hoerst nur das leise Knarren der Dielen bei Deinen Bewegungen.");

  AddSound( ({ "bewegung", "bewegungen" }),
    "Deine Bewegungen sind nicht besonders behaende ;-)");


  AddSmell( DEFAULT_SMELL,
    "Das Holz duftet frisch und verbreitet einen angenehmen Geruch.");

  AddSmell( ({ "geruch" }),
    "'rieche geruch'... kommst Du Dir nicht bloed vor?:)");
    

  AddExit( "westen", ROOMS "muehle001" );

  AddItem(NPCS "mueller", REFRESH_DESTRUCT);
  
}
