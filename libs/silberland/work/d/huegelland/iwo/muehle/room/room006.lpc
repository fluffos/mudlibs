
#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

mapping trinken=([]);
mapping ausruhen=([]);

create()
    {
    ::create();

    Set(P_NEW_EXITS, ([]) ); // Hoffentlich verhinder das den bug.. Feyaria
    SetProp( P_INT_SHORT, "Auf einem schmalen Weg" );
    SetProp( P_INT_LONG,
             "Du befindest Dich an der Rueckseite der Muehle. Eine "
             "Holzbruecke fuehrt ueber einen kleinen Bach. "
             "Ein paar Buesche und Straeucher entlang des Baches geben der "
             "Umgebung einen Hauch von Ruhe und Frieden.");
             
    SetProp( P_LIGHT, 1 );
    SetProp( P_INDOORS, 0 );
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HILL]) );


    
    AddDetail( ({ "hobbits" }),
        "Hobbits zeichnen sich besonders durch ihren Fleiss und ihre Ausdauer aus.");

    AddDetail( ({ "fleiss", "ausdauer", "tugend", "tugenden" }),
        "Fleiss und Ausdauer sind zwei wahre Tugenden.");


    AddDetail( ({ "muehle", "gebaeude", "gebaeudes" }),
        "Erstaunt betrachtest Du das Gebaeude und bewunderst wie kunstvoll es "
        "gefertigt ist. "
        "Weiter im Nordwesten kannst Du ein Muehlrad sehen. "
        "Es scheint, als wuerde die Muehle durch die Kraft des Baches angetrieben. ");

    AddDetail( ({ "kraft" }),
        "Man sollte die Kraft des Wassers nicht unterschaetzen!");

    AddDetail( ({ "buesche", "straeucher", "busch", "strauch", "pflanzen" }),
        "Die Pflanzen sehen sehr gesund aus. Das Wasser des Baches duerfte sehr sauber sein.");

    AddDetail( ({ "umgebung" }),
        "Sie umgibt dich von allen Seiten.");

    AddDetail( ({ "seiten", "allen" }),
        "Ja, wirklich von allen!");

    AddDetail( ({ "bach", "wasser" }),
        "Froehlich plaetschert der Bach vor sich hin. Sein Wasser ist vollkommen klar.");

    AddDetail( ({ "hauch", "ruhe", "frieden" }),
        "Du solltest diese Ruhe geniessen und Dich etwas ausruhen.");

    AddDetail( ({ "muehlrad", "rad" }),
        "Du bist noch zu weit weg, um es genau zu betrachten.");

    AddDetail( ({ "bruecke", "holzbruecke", "handwerkskunst", "holz" }),
        "Eine wunderschoene Bruecke. Die Handwerkskunst von Hobbits wahrscheinlich.");

    AddDetail( ({ "weg", "boden" }),
        "Du stehst mitten darauf.");

    AddDetail( ({ "himmel" }),
        "Er ist wunderschoen blau.");


    AddDetail( ({ "ohr" }),
        "Du kratzt Dich am Ohr.");

    AddDetail( ({ "rueckseite" }),
        "Dieser Weg fuehrt dich dort wahrscheinlich hin.");


    AddSound( DEFAULT_SOUND,
        "Das Plaetschern das Baches ist beruhigend.");

    AddSound( ({ "plaetschern" }),
        "Begeistert lauscht Du dem Plaetschern des Baches.");


    AddCmd( ({"trink", "trinke"}), "trinken");
    AddCmd( ({"ruhe", "ruh"}), "ruhen");

    AddExit( "nordwesten", ROOMS "room005" );
    AddExit( "suedosten", ROOMS "room007" );

}

int trinken(string str)
{
  notify_fail("Was willst Du trinken?\n");
  if(str!="wasser") return 0;
  write("Du trinkst von dem klaren Wasser und fuehlst Dich erfrischt.\n");
  say(TP->Name(WER)+" trinkt Wasser aus dem Bach.\n");
  if( !trinken[getuid(TP)] )
  {
    trinken[getuid(TP)]=1;
    TP->heal_self(5+random(5));
  }
  return 1;
}

int ruhen(string str)
{
  notify_fail("Willst Du Dich ausruhen?\n");
  if(str!="aus" && str!="dich aus" && str!="mich aus") return 0;
  write("Du ruhst Dich etwas aus.\n");
  say(TP->Name(WER)+" ruht sich hier aus.\n");
  if( !ausruhen[getuid(TP)] )
  {
    ausruhen[getuid(TP)]=1;
    TP->do_exhaust(-200-random(500),1);
    TP->AddHp(2+random(3));
    TP->AddSp(1);
  }
  return 1;
}

void reset()
{
  ::reset();
  trinken=([]);
  ausruhen=([]);
}
