
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>


create() {
  ::create();

  SetProp( P_INT_SHORT, "In einer Muehle" );
  SetProp( P_INT_LONG,
      "Es scheint, als waere das hier eine Art Maschinenraum. "
      "Unzaehlige Stangen und Zahnraeder scheinen irgendetwas "
      "im oberen Stockwerk anzutreiben.\n"
      "@@zahnradtest@@" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "art", "raum", "maschinenraum", "maschine", "maschienen" }),
      "Hier steht eine grosse Maschine, wie Du an den vielen Stangen und "
      "Zahnraedern erkennen kannst. Darum heisst dieser Raum wohl auch "
      "Maschinenraum.");

  AddDetail( ({ "stangen", "stange" }),
      "Die Stangen verbinden die Zahnraeder miteinander. Eine der Stangen "
      "verschwindet in der Decke.");

  AddDetail( ({ "waende", "wand" }),
      "Das Holz an den Waenden verstroemt einen angenehmen Geruch.");

  AddDetail( ({ "muehle" }),
      "Ein grosses Haus, in dem Mehl gemacht wird.");

  AddDetail( ({ "mehl" }),
      "Das hervorragende Mehl aus dieser Muehle verwendet man im "
      "gesamten SilberLand, um koestliche Backwaren herzustellen.");

  AddDetail( ({ "silberland" }),
      "Die Welt in der Du Dich befindest nennt man so.");
      
  AddDetail( ({ "backwaren" }),
      "Koestlichkeiten, gebacken aus Mehl und anderem Zeugs.");
      
  AddDetail( ({ "koestlichkeiten" }),
      "Ja, es gibt viele verschiedene davon.");
      
  AddDetail( ({ "zeugs" }),
      "Leider weisst Du nicht, was verwendet wird um sie herzustellen.");
      
  AddDetail( ({ "handarbeit", "kunst" }),
      "Handarbeit ist eine Kunst, die wohl erlernt sein muss.");
      
  AddDetail( ({ "holz" }),
      "Das Holz duftet frisch.");
      
  AddDetail( ({ "dielen", "holzdielen", "diele", "holzdiele" }),
      "Nahtlos bedecken die Holzdielen den Boden.");
      
  AddDetail( ({ "last", "schritte", "knarren" }),
      "Die Holzdielen geben ein leises Knarren von sich bei jedem "
      "Deiner Schritte.");
      
  AddDetail( ({ "gebaelk" }),
      "Das tragende Gebaelk verhindert, dass Dir die Decke auf den "
      "Kopf faellt. In den Ecken haben sich kleine Spinnen ihre "
      "Netze gebaut.");
      
  AddDetail( ({ "ecken", "spinnen", "netze", "spinnennetze",
                "ecke", "spinne", "netz", "spinnenetz" }),
      "Wunderschoene Netze kleiner Spinnen verzieren das Gebaelk.");
      
  AddDetail( ({ "decke" }),
      "Die Decke ueber Dir wird von massivem Gebaelk getragen. An einer "
      "Stelle geht eine Stange in das obere Stockwerk.");

  AddDetail( ({ "stelle" }),
      "Da geht die Stange rauf.");
      
  AddDetail( ({ "kopf" }),
      "Pass auf, dass Du Dir Deinen Kopf nicht an den vielen Stangen anhaust.");      

  AddDetail( ({ "boden" }),
      "Der Boden ist mit kunstvollen Holzdielen ausgelegt.");

  AddDetail( ({ "zeugs", "technik", "technikzeugs" }),
      "Du kennst Dich nicht wirklich aus damit.");
      
  AddDetail( ({ "stockwerk" }),
      "Das ueber Dir halt."); 

  AddDetail( ({ "fenster" }),
      "Hier ist kein Fenster, aber sonst wuerden lauter Staebe rumliegen :)");

  AddDetail( ({"finger"}),
      "Pass auf, dass Du Dir Deine Finger nicht zwischen den Zahnraedern "
      "einzwickst.");

  AddSpecialDetail( ({ "zahnraeder", "raeder", "zahnrad", "rad" }), 
      "zahnraddetail");

  AddSpecialDetail( ({ "stab" }), "stabdetail");
  AddSpecialDetail( ({ "mechanik" }), "zahnradtest");
  

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur das leise Knarren der Dielen bei Deinen Bewegungen.");

  AddSound( ({ "bewegung", "bewegungen" }),
    "Du wippst etwas im Takt und lauscht dem Knarren.");

  AddSound( ({ "takt" }),
    "Bumm, Tsch, Bumm Bumm Tsch...");
    
  AddSound( ({ "bumm" }),
    "Tsch.");

  AddSound( ({ "tsch" }),
    "Bumm Bumm. Groooooovie");

  AddSound( ({ "knarren" }),
    "*Knaaaaaarrrrrrr*");

  AddSmell( DEFAULT_SMELL,
    "Das Holz duftet frisch und verbreitet einen angenehmen Geruch.");

  AddSmell( ({ "holz" }),
    "Mjam... frisches Holz riecht einfach genial.");

  AddExit( "sueden", ROOMS "muehle001" );

  AddCmd("drehe", "drehen");

  AddCmd( ({"tausche", "tausch", "wechsel", "wechsle"}), "tauschen");
  
}

string zahnradtest()
    {
    string returnstring;
    if (call_other(QMASTER, "zahnradstats", TP) == 3)
        {
        returnstring = "Die Mechanik arbeitet und scheint etwas im " +
	    "darueberliegenden Stockwerk \nanzutreiben.\n";
        return returnstring;
      }

     return "Nichts dreht sich.\n";
     }
     
string zahnraddetail ()
    {
    int zahnradstats;
    string returnstring;
    /* 0 = nicht probiert, 1 = probiert und kaputt, */
    /* 2 = repariert, 3 = laeuft                    */
    
    zahnradstats = call_other(QMASTER, "zahnradstats", TP);

    switch (zahnradstats)
        {
	case 0:
	    returnstring = "Die Zahnraeder stehen voellig still. " +
	        "Vielleicht kannst Du ja etwas machen damit?";
	    break;
        case 1:
	    returnstring = "Hmm... an einem Rad kannst Du einen "
	        "zerbrochenen Stab erkennen.";
	    break;
	case 2:
	    returnstring = "Der neue Stab, den Du eingesetzt "
	        "hast scheint perfekt zu passen. Es scheint "
		"als waere nun alles funktionstuechtig.";
	    break;
        case 3:
	    returnstring = "Die Zahnraeder drehen sich mit der "
	        "Praezision eines Uhrwerkes.";
	    break;
        default:
	    returnstring = "Zahnraeder halt.";
	}
	
	return BS(returnstring);
     }

string stabdetail()
    {
    if (!call_other(QMASTER, "isquester", TP) || 
        !call_other(QMASTER, "hastried", TP))
        return BS("Er wirkt nichtmehr allzu belastbar.");
    if (!call_other(QMASTER, "fixedstick", TP))
        return BS("Der Stab ist zerborsten. Vielleicht " +
	          "kannst Du ihn ja austauschen?");
    return BS("Der neue Stab passt perfekt.");
    }

int drehen (string str)
    {
    notify_fail("Was willst Du drehen?\n");
    if (!str || str != "zahnraeder") return 0;
    
    TP->command_me("rufe AUTSCH!");
    tell_object(TP, "Du hast Dir einen Finger eingezwickt.\n");
    TP->AddHp(-5-random(5));

    return 1;
    }

int tauschen (string str)
    {
    notify_fail("Was willst Du austauschen?\n");
    
    if (!str || (str != "stab aus" && str!="stab") ) return 0;
    
    notify_fail("Du hast doch gar keinen passenden Stab!\n");
    
    if (!present("stabfuermuehle", TP)) return 0;

    tell_object(TP, BS("Du wechselst den defekten Stab aus und wirfst " +
                       "ihn zum Fenster raus.\n"));

    notify_fail("Das hast Du doch schon gemacht!\n");
    if(call_other(QMASTER, "fixedstick", TP)) return 0;

    notify_fail("Es bugt. Bitte Iwo informieren!\n");

    if (!present("stabfuermuehle", TP)->remove() ||
        !call_other(QMASTER, "changefixedstick", TP))
	  return 0;
    
    return 1;
    }
		       
    
