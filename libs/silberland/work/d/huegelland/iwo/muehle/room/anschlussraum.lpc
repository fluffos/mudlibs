
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void create() {
  ::create();

  Set(P_NEW_EXITS, ([]) ); // Hoffentlich verhinder das den bug.. Feyaria
  SetProp( P_INT_SHORT, "Auf einem schmalen Weg" );
  SetProp( P_INT_LONG,
    "Du betrittst einen kleinen schmalen Weg. Nach Norden fuehrt er weiter "
    "und nach Sueden kommst Du wieder zurueck auf die Landstrasse. Du kannst "
    "nicht erkennen was sich weiter noerdlich befindet, aber Du findest, "
    "es koennte lohnenswert sein, nachzusehen.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "weg" }),
    "Ein kleiner ausgetrampelter Weg. Er scheint haeufig begangen zu werden.");

  AddDetail( ({ "huegel" }),
    "Du bist fast oben auf dem Huegel angekommen. Er ist im Nordwesten.");

  AddDetail( ({ "verweilen","weilen","weile" }),
    "Hier ist es eher langweilig. Eigentlich geht es nur den Huegel hinauf.");

  AddDetail( ({ "himmel" }),
    "Die Sonne scheint vom Himmel herunter. Du kannst nur wenige Wolken "
    "erkennen.");

  AddDetail( ({ "sonne" }),
    "Sie scheint hell vom Himmel herunter.");

  AddDetail( ({ "wolken","wolke" }),
    "Du kannst kaum Wolken erkennen. Nur selten verdecken sie die Sonne.");

  AddDetail( ({ "mitte" }),
    "Du kannst entweder den Huegel hinauf oder hinab gehen. Jedenfalls bist "
    "Du genau in der Mitte des Huegels angekommen. Entscheiden musst Du Dich "
    "aber schon selber.");

  AddDetail( ({ "boden" }),
    "Auf dem Boden liegen wie ueberall ein paar Steine herum und begrenzen "
    "die Landstrasse.");

  AddDetail( ({ "steine","stein" }),
    "Die Steine sind wirklich nichts besonderes und sind nur dazu da, die "
    "Landstrasse von der Graslandschaft zu begrenzen.");

  AddDetail( ({ "gras" }),
    "Das Gras waechst hier ueball aus dem Boden heraus.");

  AddDetail( ({ "landstrasse","strasse" }),
    "Die Landstrasse zieht sich weiter durch die Landschaft einen kleinen "
    "Huegel hinauf.");

  AddDetail( ({ "landschaft","graslandschaft" }),
    "Die Landschaft aendert sich hier kaum. Der Anstieg auf den Huegel ist "
    "allerdings nicht ganz einfach.");

  AddDetail( ({ "anstieg" }),
    "Entweder Du gehst gerade rauf oder runter. Runter ist es natuerlich "
    "viel einfacher.");

  AddDetail("wind", 
    "Der Wind wird schon ein wenig lauter.");


  AddSound( DEFAULT_SOUND,
    "Der Wind wird schon ein wenig lauter.");

  AddSound( ({ "wind" }),
    "Der Wind ist hier schon recht laut.");

  AddSmell( DEFAULT_SMELL,
    "Du kannst wegen dem Wind kaum etwas riechen.");

  AddSmell( ({ "wind" }),
    "Der Wind ist geruchlos.");

  AddExit( "norden", "./room001");
  AddExit( "sueden", "/d/huegelland/zordan/fischerweg/room/b1b5" );
}
