
#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

create()
    {
    ::create();

    SetProp( P_INT_SHORT, "Auf einem schmalen Weg" );
    SetProp( P_INT_LONG,
             "Du befindest Dich auf einem Weg, der sich entlang der Muehle zu ihrer "
             "Rueckseite schlaengelt. " 
             "Ein paar runde Steine liegen am Weg. Vielleicht kommen sie aus einem "
             "Bach in der Naehe.");
    SetProp( P_LIGHT, 1 );
    SetProp( P_INDOORS, 0 );
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HILL]) );

    AddDetail( ({ "steine", "stein" }),
        "Nachdem sie sehr rund sind, duerften sie aus einem Bach stammen. ");

    AddDetail( ({ "bach", "naehe" }),
        "Du kannst hier nirgends einen Bach sehen, aber irgendwie muss die Muehle ja "
        "angetrieben werden.");

    AddDetail( ({ "kraft", "antreiben", "maschinen" }),
        "Besonders Wasserraeder sind eine beliebte Form der Nutzung");

    AddDetail( ({ "wasserraeder", "wasserrad", "rad", "form", "nutzung", "schaufelrad", "gewicht", "drehen" }),
        "Das Wasser trifft auf ein Schaufelrad und bringt es durch sein Gewicht "
        "zum Drehen.");

    AddDetail( ({ "norden" }),
        "Ja, Norden. Es liegt zwischen Osten und Westen - gegenueber von Sueden.");

    AddDetail( ({ "osten", "westen", "sueden" }), 
        "Findest Du das wirklich sinnvoll?");

    AddDetail( ({ "muehle" }),
        "Dominant erhebt sie sich vor Dir. Weiter im Osten kannst Du den Eingang sehen.");

    AddDetail( ({ "eingang", "reingang" }),
        "Durch einen Eingang kann man reingehen. Sollte es nicht besser Reingang heissen?:)");

    AddDetail( ({ "weg", "boden" }),
        "Du stehst mitten darauf.");

    AddDetail( ({ "umgebung" }),
        "Sie ist wunderschoen. Vielleicht solltest Du hier ein wenig rasten?");

    AddDetail( ({ "himmel" }),
        "Es ist strahlend blau. Kein Woelkchen ziert ihn.");

    AddDetail( ({ "woelkchen" }),
        "Keines da.");

    AddDetail( ({ "ohr" }),
        "Du kratzt Dich am Ohr.");

    AddDetail( ({ "rueckseite" }),
        "Dieser Weg fuehrt dich dort wahrscheinlich hin.");



    AddSound( DEFAULT_SOUND,
        "Du fuehlst Dich wohl in der ruhigen Umgebung.");
    AddSmell( ({DEFAULT_SMELL, "morchel", "stinkmorchel"}),
        "Es stinkt hier nach Morchel.");


    AddExit( "nordwesten", ROOMS "room003" );
    AddExit( "osten", ROOMS "room001" );

    AddItem(OBJECTS "stinkmorchel", REFRESH_REMOVE);
    }
