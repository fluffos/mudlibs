
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>

string forscherpunkt()
    {
    object ob;
    
    if (present("forscherpunkt", TP))
        return BS("Hmm... leider keiner mehr da.");
    
    ob = clone_object(OBJECTS "forscherpunkt");
    ob->move(TP, M_NOCHECK);

    tell_room(environment(TP), TP->Name() + " "
              "steckt etwas ein.\n", ({ TP }));
    
    return BS("Huch! Du findest doch einen.\n"
              "Voller Freude steckst Du ihn ein.");
    }
    
create()
    {
    ::create();

    SetProp( P_INT_SHORT, "Auf einem schmalen Weg" );
    SetProp( P_INT_LONG,
             "Der schmale Weg bringt Dich nach Norden zu einer kleinen " 
             "Muehle. Eine kleine Holzbruecke fuehrt ueber einen Graben. "
             "Sonnenstrahlen fallen auf den spaerlichen Bewuchs, der Deinen "
             "Weg saeumt, und tauchen die Umgebung in ein wohlig warmes Licht.\n");
    SetProp( P_LIGHT, 1 );
    SetProp( P_INDOORS, 0 );
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HILL]) );

    AddDetail( ({ "graben" }),
        "Es scheint, als haette er frueher Wasser gefuehrt. Vielleicht hat man "
        "es umgeleitet?");

    AddDetail( ({ "wasser" }),
        "Wasser ist eine Verbindung aus Wasserstoff und Sauerstoff. Oftmals wird seine "
        "Kraft zum Antreiben von Maschinen verwendet.");

    AddDetail( ({ "verbindung", "wasserstoff", "sauerstoff" }),
        "Dein Erinnerungsvermoegen versagt, wenn Du versuchst, Dich an Deinen "
        "Chemieunterricht zu erinnern.");

    AddDetail( ({ "kraft", "antreiben", "maschinen" }),
        "Besonders Wasserraeder sind eine beliebte Form der Nutzung.");

    AddDetail( ({ "wasserraeder", "wasserrad", "rad", "form", "nutzung", "schaufelrad", 
		  "gewicht", "drehen" }),
        "Das Wasser trifft auf ein Schaufelrad und bringt es durch sein Gewicht "
        "zum Drehen.");

    AddDetail( ({ "erinnerungsvermoegen", "chemieunterricht", "chemie", "unterricht" }),
        "Du scheinst wirklich nicht besonders aufgepasst zu haben.");

    AddDetail( ({ "bruecke", "holzbruecke", "holz" }),
        "Eine wunderschoene Bruecke. Die Handwerkskunst von Hobbits wahrscheinlich.");

    AddDetail( ({ "hobbit", "hobbits", "handwerkskunst", "handwerk", "kunst", 
		  "niederlassung", "welt", "naehe", "handwerker", "sie" }),
        "Hobbits sind klein und pelzig. Sie sind die besten Handwerker dieser Welt.\n"
        "Wahrscheinlich haben sie in der Naehe ihre Niederlassung.");

    AddDetail( ({ "norden" }),
        "Ja, Norden. Es liegt zwischen Osten und Westen - gegenueber von Sueden.");

    AddDetail( ({ "osten", "westen", "sueden" }), 
        "Findest Du das wirklich sinnvoll?");

    AddDetail( ({ "muehle" }),
        "Malerisch - wie aus dem Bilderbuch - ueberragt sie die Umgebung.");

    AddDetail( ({ "bilderbuch", "umgebung", "buecher", "buechern", "buch" }),
        "Ja, wie in den Buechern, die Dir Deine Mutter frueher gezeigt hat.");

    AddDetail( ({ "mutter" }),
        "Vielleicht solltest Du sie ja wiedermal besuchen?");

    AddDetail( ({ "sonnenstrahl", "strahl", "sonnenstrahlen", "strahlen", "sonne", 
		  "licht" }),
        "Du solltest ohne Schutzbrille nicht direkt in die Sonne schauen.");

    AddDetail( ({ "schutzbrille", "brille" }),
        "Du hast leider keine dabei.");
    
    AddDetail( ({ "bewuchs" }),
        "Er ist spaerlich, aber doch existent.");

    AddDetail( ({ "weg" }),
        "Der Weg fuehrt nach Norden in eine Muehle. Nach Osten und Westen "
	"folgt er dem Gebaeude.");

    AddDetail( ({ "umgebung" }),
        "Sie ist wunderschoen. Vielleicht solltest Du hier ein wenig rasten?");

    AddDetail( ({ "himmel" }),
        "Die Sonne scheint froehlich auf Dein Haupt und taucht "
	"die Umgebung in wohlig warmes Licht.");

    AddDetail( ({ "ohr", "ohren", "waschen" }),
        "Die meisten verwenden Ohren zum hoeren. Manche auch zum nicht Waschen.");

    AddDetail( ({ "gebaeude" }),
        "Das Gebaeude kannst Du im Norden betreten.");

    AddDetail( ({ "boden" }),
        "Der Boden ist, obwohl natuerlich, fest und bietet Dir guten Halt.");

    AddDetail( ({ "halt" }),
        "Es waere auch unangenehm, wenn Du einsinken oder abrutschen "
        "wuerdest.");

    AddDetail( ({ "haupt" }),
        "Tja... das sollte Dein Gehirn beherbergen.");
	
    AddDetail( ({ "gehirn" }),
        "Sowas siehst Du hier nicht.\n"
	"Jemand kichert hinter Deinem Ruecken.");

    AddDetail( ({"vogel", "voegel" }),
        "Du kannst die Voegel nur hoeren, aber nicht sehen.");


    AddSound( DEFAULT_SOUND,
        "Es ist angenehm ruhig. Nur ein paar Voegel zwitschern.");

    AddSound( ({ "zwitschern", "voegel" }),
        "Es scheint, als waere irgend ein komischer Unterton im Zwitschern.");
    
    AddSound( ({ "unterton" }),
        "Klingt wie ein Rauschen.");
    
    AddSound( ({ "rauschen" }),
        "Nein, eher wie Gefluester.");
    
    AddSound( ({ "gefluester" }),
        "Du glaubst, eine Stimme zu erkennen.");
    
    AddSound( ({ "stimme" }),
        "Dir scheint, als wuerde sie etwas sagen.");
    
    AddSound( ({ "etwas" }),
        "Dir ist, als haettest Du Worte gehoert.");
    
    AddSound( ({ "worte" }),
        "Du glaubst, ein Wort zu verstehen.");
    
    AddSound( ({ "wort" }),
        "Du hast Dich anscheinend getaeuscht. Wahrscheinlich haben Dich "
        "Deine Sinne getaeuscht.");
    
    AddSound( ({ "sinne" }),
        "In welchem Detaillevel bist Du nun schon?");

    
    AddSound( ({ "level", "detaillevel" }),
        "Jetzt reichts aber, es ist sowieso sinnlos. Hier gibts keinen "
        "Forscherpunkt.");
    
    AddSound( ({ "forscherpunkt", "punkt" }),
        #'forscherpunkt);
    


    AddExit( "norden", ROOMS "muehle001" );
    AddExit( "westen", ROOMS "room002" );
    AddExit( "osten",  ROOMS "room008" );
    AddExit( "sueden", ANSCHLUSSRAUM);

    AddCmd( ({"besuche", "besuch"}), "besuchen" );


      }


int besuchen (string str)
    {
    notify_fail("Wen willst Du besuchen?\n");
    if (!str || str != "mutter") return 0;
    
    tell_object(TP, "Nee, jetzt willst Du das nicht tun.\n");
    return 1;
    }

    

    
