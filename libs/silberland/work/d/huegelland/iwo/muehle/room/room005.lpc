
#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

// #include "files.h"

mapping trinken=([]);
mapping ausruhen=([]);

create()
    {
    ::create();

    SetProp( P_INT_SHORT, "Auf einem schmalen Weg" );
    SetProp( P_INT_LONG,
             BS("Du befindest Dich an der Rueckseite der Muehle. "
             "Zwischen Dir und dem Gebaeude befindet sich der Bach. "
             "Du siehst hier den Antrieb der Muehle. Ein gigantisches "
             "Wasserrad gefertigt aus den edelsten Hoelzern des Silberlandes. ")
             +"@@radtest@@");
             
    SetProp( P_LIGHT, 1 );
    SetProp( P_INDOORS, 0 );
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HILL]) );

    AddDetail( ({ "antrieb", "drehung", "mechanik", "kraft" }),
        "Eine gefinkelte Mechanik wandelt die Kraft des Wassers in Drehung um.");

    AddDetail( ({ "gebaeude", "muehle", "gebilde" }),
        "Ein wahrlich imponierendes Gebilde. Fast vollstaendig aus Holz "
        "gefertigt stellt sie eine Meisterleistung dar. Jedes Stueck scheint "
        "mit Sorgfalt und Liebe behandelt worden zu sein. Die Erbauer "
        "muessen echte Meisterhandwerker gewesen sein.");

    AddDetail( ({ "stueck" }),
        "Jedes Stueck ist handgefertigt.");

    AddDetail( ({ "erbauer", "meisterhandwerker" }),
        "Du weisst nicht, wer diese Muehle gebaut hat.");

    AddDetail( ({ "sorgfalt", "liebe" }),
        "Etwas, das Dir fremd ist.");

    AddDetail( ({ "meisterleistung", "leistung" }),
        "Man sollte einen Orden dafuer vergeben.");

    AddDetail( ({ "orden" }),
        "Du kennst keinen passenden.");

    AddDetail( ({ "holz", "rohstoff", "rohstoffe", "stoffe", "hoelzer", "hoelzern" }),
        "Holz ist einer der wichtigsten Rohstoffe des Silberlandes. "
        "Jaehrlich waechst mehr nach, als verarbeitet wird.\n"
        "ES LEBE DER WALD!");

    AddDetail( ({ "wald", "baeume" }),
        "Viele Baeume ergeben einen Wald.");

    AddDetail( ({ "rueckseite", "seite", "eingang" }),
        "Du befindest Dich auf der Rueckseite. Vorne ist der Eingang.");
    
    AddDetail( ({ "umgebung" }),
        "Sie umgibt dich von allen Seiten.");

    AddDetail( ({ "seiten", "allen" }),
        "Ja, wirklich von allen!");

    AddDetail( ({ "bach", "wasser", "wassers" }),
        "Froehlich plaetschert der Bach vor sich hin. Sein Wasser ist vollkommen klar.");

    AddDetail( ({ "hauch", "ruhe", "frieden" }),
        "Du solltest diese Ruhe geniessen und Dich etwas ausruhen.");

    AddSpecialDetail( ({ "muehlrad", "rad", "wasserrad" }), "raddetail");

    AddDetail( ({ "bolzen", "fuehrung" }),
        "Ein Bolzen steckt in einer kleinen Fuehrung und verriegelt das Rad. "
        "Den kannst Du sicher locker entfernen.");

    AddDetail( ({ "weg", "boden" }),
        "Du stehst mitten darauf.");

    AddDetail( ({ "himmel", "skymachine" }),
        "Die Skymachine ist noch nicht fertig :)");

    AddDetail( ({ "ohr" }),
        "Du kratzt Dich am Ohr.");

    AddDetail( ({ "silberland" }),
        "So heisst das alles hier. Haettest fast nicht gemerkt, oder?");


    AddSound( DEFAULT_SOUND,
        "Der Bach plaetschert froehlich vor sich hin.");


    AddExit( "suedwesten", ROOMS "room004" );
    AddExit( "suedosten", ROOMS "room006" );


    AddCmd( ({"locker", "lockere"}), "lockere");
    AddCmd( ({"entferne", "entfern"}), "entferne");
    AddCmd( ({"trink", "trinke"}), "trinken");

    }


string radtest ()
    {
    string returnstring;
    
    if(call_other(QMASTER, "wheelturns", TP))
      returnstring = "Froehlich plaetschert das Wasser " +
	    "ueber das Muehlrad und haelt es am laufen.\n";
    else
      returnstring = BS("Irgendetwas scheint hier nicht zu stimmen. " +
                   "Obwohl das Wasser ordnungsgemaess ueber das " +
                   "Muehlrad fliesst, dreht es sich nicht.");
    return returnstring[0..<2];
    }


string raddetail ()
    {
    string returnstring;
    if(call_other(QMASTER, "wheelturns", TP))
        {
	return "Es dreht sich froehlich vor sich hin.\n";
	}
    
    returnstring = "Als Du es genau betrachtest, siehst Du, dass ein Bolzen verhindert, dass "
        "\nes sich frei dreht.\n";
    return returnstring;
    }



int lockere(string str)
{
  string a;
  object ob;
  notify_fail("WAS willst DU lockern?\n");
  if (!str)
    return 0;
  if (!member((["bolzen"]),str))
    return 0;

  notify_fail("Du darfst den Bolzen nicht ohne Erlaubnis entfernen!\n");
    
  if (!call_other(QMASTER, "isquester", TP))
    return 0;

  notify_fail("Das hast Du doch schon gemacht!\n");

  if (call_other(QMASTER, "wheelturns", TP))
    return 0;


  
      tell_object(TP, "Du lockerst den Bolzen.\n" +
          "\nLangsam beginnt sich das Muehlrad zu drehen.\n");


      if (!call_other(QMASTER, "fixedstick", TP))
          {
          a = call_other(QMASTER, "changehastried", TP);
	  call_out("rotmsg1", 3);
          TP->SetProp(P_PARALYZED, 
	                 ([PARALYZE_TIME:-1,
                           PARALYZE_END:"",
                           PARALYZE_END_OTHER:"",
	                   PARALYZE_MSG: BS("Gebannt schaust Du auf "
			                   "das Muehlrad.")]));	  
          }
      else
          {
	  a = call_other(QMASTER, "changewheelturns", TP);
          tell_object(TP,
	  "\nDie Kraft des Wassers bringt das Muehlrad zuegig zum Drehen.\n");
	  }
  
 
  return 1;
}
                     

void rotmsg1 ()
    {
    tell_object(TP,
        "\nEin echt uebles Geraeusch dringt aus der Muehle.\n");
    call_out("rotmsg2", 3);
    }
void rotmsg2 ()
    {
    tell_object(TP,
          "\nEs klingt, als wuerde irgendetwas zerbersten.\n");
    call_out("rotmsg3", 3);
    }
void rotmsg3 ()
    {
    tell_object(TP,
          "\nSchnell steckst Du den Bolzen wieder an seinen Platz " +
          "zurueck.\n");
    call_out("rotmsg4", 3);
    }
void rotmsg4 ()
    {
    tell_object(TP,
          "\nSchlagartig bleibt das Rad wieder stehen.\n");
    TP->SetProp(P_PARALYZED, 0);
    }    
    
    
    

int entferne(string str)
{
  string a;
  object ob;
  notify_fail("WAS willst DU lockern?\n");
  if (!str)
    return 0;
  if (!member((["bolzen"]),str))
    return 0;

  notify_fail("Der Bolzen sitzt viel zu fest. Wenn er nur etwas locker waere...\n");
  return 0;
}

int trinken(string str)
{
  notify_fail("Was willst Du trinken?\n");
  if(str!="wasser") return 0;
  write("Du trinkst von dem klaren Wasser und fuehlst Dich erfrischt.\n");
  say(TP->Name(WER)+" trinkt Wasser aus dem Bach.\n");
  if( !trinken[getuid(TP)] )
  {
    trinken[getuid(TP)]=1;
    TP->heal_self(5+random(5));
  }
  return 1;
}

int ruhen(string str)
{
  notify_fail("Willst Du Dich ausruhen?\n");
  if(str!="aus" && str!="dich aus" && str!="mich aus") return 0;
  write("Du ruhst Dich etwas aus.\n");
  say(TP->Name(WER)+" ruht sich hier aus.\n");
  if( !ausruhen[getuid(TP)] )
  {
    ausruhen[getuid(TP)]=1;
    TP->do_exhaust(-200-random(500),1);
    TP->AddHp(2+random(3));
    TP->AddSp(1);
  }
  return 1;
}

void reset()
{
  ::reset();
  trinken=([]);
  ausruhen=([]);
}
		       
