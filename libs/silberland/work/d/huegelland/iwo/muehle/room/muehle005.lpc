
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einer Muehle" );
  SetProp( P_INT_LONG,
      "Du befindest Dich in einer kleinen Muehle. Alles hier ist in "
      "echter Handarbeit gefertigt und aus unbehandeltem Holz. "
      "Durch ein kleines Fenster an der Wand faellt genug Licht "
      "in den Raum, um ihn ausreichend zu erhellen. "
      "Eine Holztreppe fuehrt in das untere Stockwerk." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "muehle" }),
      "Ein grosses Haus, in dem Mehl gemacht wird.");

  AddDetail( ({ "mehl" }),
      "Das hervorragende Mehl aus dieser Muehle verwendet man im "
      "gesamten SilberLand, um koestliche Backwaren herzustellen.");

  AddDetail( ({ "silberland" }),
      "Die Welt in der Du Dich befindest nennt man so.");
      
  AddDetail( ({ "backwaren" }),
      "Koestlichkeiten, gebacken aus Mehl und anderem Zeugs.");
      
  AddDetail( ({ "koestlichkeiten" }),
      "Ja, es gibt viele verschiedene davon.");
      
  AddDetail( ({ "zeugs" }),
      "Leider weisst Du nicht, was verwendet wird um sie herzustellen.");
      
  AddDetail( ({ "handarbeit", "kunst" }),
      "Handarbeit ist eine Kunst, die wohl erlernt sein muss.");
      
  AddDetail( ({ "holz" }),
      "Das Holz duftet frisch.");
      
  AddDetail( ({ "dielen", "holzdielen", "diele", "holzdiele" }),
      "Nahtlos bedecken die Holzdielen den Boden.");
      
  AddDetail( ({ "last", "schritte", "knarren" }),
      "Die Holzdielen geben ein leises Knarren von sich bei jedem "
      "Deiner Schritte.");
      
  AddDetail( ({ "decke" }),
      "Eine Decke siehst Du hier nicht. Du hast freien Blick auf den Dachstuhl.");

  AddDetail( ({ "blick" }),
      "Wie soll ein Blick aussehn?");
      
  AddDetail( ({ "dachstuhl" }),
      "Der Dachstuhl ist eine Konstruktion, die das Dach traegt.");

  AddDetail( ({ "konstruktion" }),
      "Verschiedene Traeger und Streben stuetzen das Dach.");
      
  AddDetail( ({ "traeger" }),
      "Schwere Balken aus massivem Holz.");
    
  AddDetail( ({ "balken" }),
      "Das interessiert Dich eigentlich nicht wirklich.");
      
  AddDetail( ({ "streben" }),
      "Die Streben sind etwas weniger massiv als die Traeger, aber dennoch gewaltig.");
      
  AddDetail( ({ "dach" }),
      "Sehen kannst Du das Dach von innen natuerlich nicht, nur den Dachstuhl, "
      "aber es wuerde Dich nicht sonderlich wundern, wenn es auch aus Holz waere.");      
     
  AddDetail( ({ "boden" }),
      "Der Boden ist mit kunstvollen Holzdielen ausgelegt. Durch ein "
      "grosses Loch im Boden fuehrt die Treppe nach unten.");

  AddDetail( ({ "loch" }),
      "Tjo.. ohne Loch keine Treppe :)");

  AddDetail( ({ "fenster" }),
      "Das Fenster ist nicht besonders gross, aber es scheint zu reichen.");

  AddDetail( ({ "treppe", "holztreppe"  }),
      "Die Treppe ist wie fast alles hier aus Holz. Bio halt.");
      
  AddDetail( ({ "wand", "waende" }),
      "Holz. Ueberall an der Wand stehen Saecke voller Getreide.");
      
  AddDetail( ({ "sack", "saecke" }),
      "Sie sind prall gefuellt mit zu mahlendem Getreide.");
      
  AddDetail( ({ "getreide" }),
      "'Troad' genannt im Volksmund.");
      
  AddDetail( ({ "troad" }),
      "Aus dem Getreide kann man Mehl machen.");
      
  AddDetail( ({ "volksmund" }),
      "So nennen es die Hobbits.");
  
  AddDetail( ({ "hobbits", "naehe" }),
      "Die Hobbits leben hier in der Naehe.");
  
  AddDetail( ({ "raum" }),
      "Vier Waende, ein Boden und eine Decke. Ein schoener Raum :)");
      
  AddDetail( ({ "stockwerk" }),
      "Das hat nichts mit dem Werk eines Stockes zu tun.");
      
  AddDetail( ({ "stock", "werk" }),
      "Du findest, dass Du Dich besser auf Deine Aufgabe kuemmern solltest.");
      
  AddDetail( ({ "licht", "sonne" }),
      "Du blinzelst kurz in die Sonne. Huch! Gottseidank bist Du nicht "
      "geblendet jetzt.");

  AddDetail( ({ "aufgabe" }),
      "Tja, das haettest Du wohl gern, dass hier was steht ;-)");

  AddDetail( ({ "welt" }),
      "Das interessiert Dich ueberhaupt nicht.");
      
  AddDetail( ({ "haus" }),
      "Das Haus in dem Du Dich befindest nennt man Muehle.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst nur das leise Knarren der Dielen bei Deinen Bewegungen.");


  AddSmell( DEFAULT_SMELL,
    "Das Holz duftet frisch und verbreitet einen angenehmen Geruch.");

  AddExit( "unten", ROOMS "muehle002" );
  AddExit( "osten", ROOMS "muehle006" );
  
}
