
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <moving.h>

int cloned_schaufel;

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einer Muehle" );
  SetProp( P_INT_LONG,
      "Du befindest Dich in einer kleinen Muehle. Alles hier ist in "
      "echter Handarbeit gefertigt und aus unbehandeltem Holz. "
      "Durch ein kleines Fenster an der Wand faellt genug Licht "
      "in den Raum, um ihn ausreichend zu erhellen. Ueberall "
      "steht Geruempel rum.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "muehle", "haus" }),
      "Ein grosses Haus, in dem Mehl gemacht wird.");

  AddDetail( ({ "mehl" }),
      "Das hervorragende Mehl aus dieser Muehle verwendet man im "
      "gesamten SilberLand, um koestliche Backwaren herzustellen.");

  AddDetail( ({ "silberland", "welt" }),
      "Die Welt in der Du Dich befindest nennt man so.");
      
  AddDetail( ({ "backwaren" }),
      "Koestlichkeiten, gebacken aus Mehl und anderem Zeugs.");
      
  AddDetail( ({ "koestlichkeiten" }),
      "Ja, es gibt viele verschiedene davon.");
      
  AddDetail( ({ "zeugs" }),
      "Leider weisst Du nicht, was verwendet wird um sie herzustellen.");
      
  AddDetail( ({ "handarbeit", "kunst" }),
      "Handarbeit ist eine Kunst, die wohl erlernt sein muss.");
      
  AddDetail( ({ "holz" }),
      "Das Holz duftet frisch.");
      
  AddDetail( ({ "dielen", "holzdielen", "diele", "holzdiele" }),
      "Nahtlos bedecken die Holzdielen den Boden.");
      
  AddDetail( ({ "last", "schritte", "knarren" }),
      "Die Holzdielen geben ein leises Knarren von sich bei jedem "
      "Deiner Schritte.");
      
  AddDetail( ({ "gebaelk" }),
      "Das tragende Gebaelk verhindert, dass Dir die Decke auf den "
      "Kopf faellt. In den Ecken haben sich kleine Spinnen ihre "
      "Netze gebaut.");
      
  AddDetail( ({ "ecken", "spinnen", "netze", "spinnennetze" }),
      "Wunderschoene Netze kleiner Spinnen verzieren das Gebaelk.");
      
  AddDetail( ({ "decke" }),
      "Die Decke ueber Dir wird von massivem Gebaelk getragen.");
      
  AddDetail( ({ "boden" }),
      "Am Boden steht und liegt alles moegliche Geruempel herum.");

  AddDetail( ({ "fenster" }),
      "Das Fenster ist nicht besonders gross, aber es scheint zu reichen.");

      
  AddDetail( ({ "wand", "waende" }),
      "Holz. Kunstvoll verarbeitetes bestes Holz.");
      
  AddDetail( ({ "raum" }),
      "Vier Waende, ein Boden und eine Decke. Ein schoener Raum :)");

  AddDetail( ({ "decke" }),
      "Hier ist keine Decke. Nur ein Dachstuhl.");
      
  AddDetail( ({ "dachstuhl" }),
      "Der Dachstuhl ist hier nicht besonders interessant.");
      
  AddDetail( ({ "dach" }),
      "Von innen kannst Du natuerlich das Dach nicht sehen.");
      
  AddDetail( ({ "stuhl" }),
      "Es liegt zwar unmengen Zeugs rum, aber Stuhl ist keiner dabei.");
      
      
  AddDetail( ({ "licht", "sonne" }),
      "Du blinzelst kurz in die Sonne. Huch! Gottseidank bist Du jetzt nicht "
      "geblendet.");

  AddDetail( ({ "aufgabe" }),
      "Tja, das haettest Du wohl gern, dass hier was steht ;-)");

  AddDetail( ({ "geruempel" }),
      "Unmengen unnoetiges und noetiges Zeugs.");
    
  AddDetail( ({ "zeugs" }),
      "Kisten mit Kleinzeugs, Schachteln, und wirre Haufen aus "
      "unidentifizierbaren Sachen.");
      
  AddDetail( ({"schachteln"}),
      "Nur unnuetzes Zeugs.");

  AddDetail( ({"kiste", "kisten"}),
      "In den Kisten ist lauter Kleinzeugs drinnen.");

  AddDetail( ({"kleinzeugs"}),
      "Schrauben, Naegel, Klammern,...");

  AddDetail( ({"schrauben", "naegel", "klammern"}),
      "Nix dabei, was du brauchen koenntest.");
      
  AddDetail( ({"haeufen", "haufen", "sachen"}),
      "Hocherfreut betrachtest Du die Haufen. Du gierst "
      "regelrecht danach, in ihnen rumzustoebern.");


  AddSound( DEFAULT_SOUND,
    "Du hoerst nur das leise Knarren der Dielen bei Deinen Bewegungen.");


  AddSmell( DEFAULT_SMELL,
    "Das Holz duftet frisch und verbreitet einen angenehmen Geruch.");

  AddExit( "westen", ROOMS "muehle006" );

  AddCmd( ({"stoebere", "stoeber"}), "stoebern");
  AddCmd( ({ "transiwo" }), "transiwo");
  
}


int transiwo()
{
  object iwo;

  if (iwo=find_player("iwo")) iwo->move(ME, M_NOCHECK);

  return 1;
}



int stoebern (string str)
    {
    object ob;
    notify_fail("Worin willst Du rumstoebern?\n");
    
    if (!str || !(str == "in haufen herum" || str == "in haeufen herum"
             || str == "im haufen herum" || str == "in haufen"
             || str == "in haufen"))
        return 0;

    notify_fail("Du traust Dich nicht.\n");
    
    if (!call_other(QMASTER, "isquester", TP)) return 0;

    notify_fail("Du findest aber nichts.\n");

    if (present("schaufel", TP) || cloned_schaufel == 1) return 0;


    cloned_schaufel = 1;

    tell_object(TP,
        "Du wuehlst etwas im Geruempel herum und entdeckst voller Freude "
	"eine Schaufel.\n");

    ob = clone_object("/obj/schaufel");
    
    if (ob->move(TP, M_GET) == ME_TOO_HEAVY)
        {
	notify_fail("Die Schaufel ist Dir leider zu schwer.\n");
	ob->move(ENV(TP), M_NOCHECK);
	return 0;
	}
	
    tell_object(TP, BS("Jubelnd nimmst Du die Schaufel an Dich."));

    return 1;
    }
    
    
mixed reset()
    {
    cloned_schaufel = 0;
    ::reset();
    }
    
