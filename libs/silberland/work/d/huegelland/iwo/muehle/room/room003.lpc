
#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include <language.h>
// #include "files.h"

create()
    {
    ::create();

    SetProp( P_INT_SHORT, "Auf einem schmalen Weg" );
    SetProp( P_INT_LONG,
             "Der Weg fuehrt Dich weiter hinter die Muehle. "
             "In der Ferne kannst Du schier endlose Getreidefelder sehen. "
             "Auf einem der Felder ernten gerade ein paar fleissige Hobbits "
             "den Weizen. Weiter im Nordosten kannst Du einen kleinen "
             "Bach entdecken. ");
             
    SetProp( P_LIGHT, 1 );
    SetProp( P_INDOORS, 0 );
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HILL]) );


    AddDetail( ({ "felder", "getreidefelder", "getreide", "weizen" }),
        "Der reife Weizen laesst die riesigen Felder in einem angenehmen "
        "zarten Gelb erstrahlen. Ein wahrlich traumhafter Anblick.");
    
    AddDetail( ({ "ferne" }),
        "Ja, wirklich sehr fern. Die Arbeiter sehen fuzzifuzziklein aus. Fast wie Ameisen.");

    AddDetail( ({ "ameisen", "ameise" }),
        "Ameisen gibt es hier keine.");

    AddDetail( ({ "arbeiter" }),
        "Es duerften Hobbits sein, aber Du kannst es nicht genau erkennen.");

    AddDetail( ({ "gelb", "anblick" }),
        "Wirklich unglaublich schoen.");

    AddDetail( ({ "hobbits" }),
        "Hobbits zeichnen sich besonders durch ihren Fleiss und ihre Ausdauer aus.");

    AddDetail( ({ "fleiss", "ausdauer", "tugend", "tugenden" }),
        "Fleiss und Ausdauer sind zwei wahre Tugenden.");

    AddDetail( ({ "bach", "naehe" }),
        "Der Bach ist weiter im Nordosten. Vielleicht solltest Du naeher rangehen?");

    AddDetail( ({ "muehle", "gebaeude", "gebaeudes" }),
        "Du befindest Dich am westlichsten Punkt des Gebaeudes. Kleine Fenster "
        "sorgen dafuer, dass die Raeume innen ausreichend beleuchtet sind. "
        "Weiter im Suedosten kannst Du sie betreten.");

    AddDetail( ({ "fenster" }),
        "Sie sind nicht sehr gross und ziemlich verschmiert. Aber anscheinend ausreichend.");

    AddDetail( ({ "raeume","raum" }),
        "Du musst schon hinein gehen, um die Raeume zu sehen.");

    AddDetail( ({ "punkt" }),
        "Beistrich.");

    AddDetail( ({ "beistrich" }),
        "Punkt. Und aus.");


    AddDetail( ({ "weg", "boden" }),
        "Du stehst mitten darauf.");

    AddDetail( ({ "himmel" }),
        "Schnell huscht ein Woelkchen ueber den Himmel und verschwindet in der Ferne.");

    AddDetail( ({ "woelkchen" }),
        "Weg isses.");


    AddDetail( ({ "ohr" }),
        "Du kratzt Dich am Ohr.");

    AddDetail( ({ "rueckseite" }),
        "Dieser Weg fuehrt dich dort wahrscheinlich hin.");



    AddSound( DEFAULT_SOUND,
        "Angenehm ruhig hier ...");



    AddExit( "suedosten", ROOMS "room002" );
    AddExit( "nordosten", ROOMS "room004" );

    }
