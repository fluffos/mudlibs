
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "In einer Muehle" );
  SetProp( P_INT_LONG,
      "Du befindest Dich in einer kleinen Muehle. Alles hier ist in "
      "echter Handarbeit gefertigt und aus unbehandeltem Holz. "
      "Die Dielen auf dem Boden knarren leise und beruhigend unter "
      "der Last Deiner Schritte. Im Gebaelk ueber Dir kannst Du "
      "kleine Spinnennetze erkennen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "muehle", "haus" }),
      "Ein grosses Haus, in dem Mehl gemacht wird.");

  AddDetail( ({ "mehl" }),
      "Das hervorragende Mehl aus dieser Muehle verwendet man im "
      "gesamten SilberLand, um koestliche Backwaren herzustellen.");

  AddDetail( ({ "silberland", "welt" }),
      "Die Welt in der Du Dich befindest nennt man so.");
      
  AddDetail( ({ "backwaren" }),
      "Koestlichkeiten, gebacken aus Mehl und anderem Zeugs.");
      
  AddDetail( ({ "koestlichkeiten" }),
      "Ja, es gibt viele verschiedene davon.");
      
  AddDetail( ({ "zeugs" }),
      "Leider weisst Du nicht, was verwendet wird um sie herzustellen.");
      
  AddDetail( ({ "handarbeit", "kunst" }),
      "Handarbeit ist eine Kunst, die wohl erlernt sein muss.");
      
  AddDetail( ({ "holz" }),
      "Das Holz duftet frisch.");
      
  AddDetail( ({ "dielen", "holzdielen", "diele", "holzdiele" }),
      "Nahtlos bedecken die Holzdielen den Boden.");
      
  AddDetail( ({ "last", "schritte", "knarren" }),
      "Die Holzdielen geben ein leises Knarren von sich bei jedem "
      "Deiner Schritte.");
      
  AddDetail( ({ "decke" }),
      "Weit ueber Dir siehst Du den Dachstuhl.");
      
  AddDetail( ({ "dachstuhl" }),
      "Nachdem Du kein Zimmermann bist, interessiert er Dich nicht wirklich.");
      
  AddDetail( ({ "zimmermann" }),
      "Du bist keiner. Viel zu ungeschickt dafuer.");

  AddDetail( ({ "mann" }),
      "Du siehst weit und breit keinen Mann.");
      
  AddDetail( ({ "boden" }),
      "Der Boden ist mit kunstvollen Holzdielen ausgelegt. Etwas Staub liegt auf dem Boden herum.");

  AddDetail( ({ "staub", "staubschicht", "schicht" }),
      "Du kratzt mit den Haenden etwas Staub zusammmen und beginnst eine Art Sandburg zu bauen.\n"
      "Huch!\nEin kleiner Luftzug verteilt Deine Burg wieder am Boden.");
      
  AddDetail( ({ "burg" }),
      "Tja... nun ist sie wieder nurmehr eine Staubschicht.");

  AddDetail( ({ "wand", "waende" }),
      "An den Waenden kannst Du nichts besonderes erkennen.");

  AddDetail( ({ "gebaelk", "balken" }),
      "Schwere Balken, die den Dachstuhl tragen.");

  AddDetail( ({ "spinnennetze", "netze", "netz", "spinnennetz" }),
      "Eine Spinne hat fein saeuberlich einen Strick aus ihrem "
      "Seidenfaden gesponnen und sich dran erhaengt.");
      
  AddDetail( ({ "spinne" }),
      "Leicht verwesend baumelt sie froehlich an ihrem selbst gebauten "
      "Galgen.");
      
  AddDetail( ({ "strick" }),
      "Der Strick ist so winzig, dass Du ihn kaum erkennen kannst.");
      
  AddDetail( ({ "galgen" }),
      "Was diese Spinne wohl zum Selbstmord gebracht hat?");
      
  AddDetail( ({ "selbstmord" }),
      "Das ist keine Loesung.");
      
  AddDetail( ({ "loesung" }),
      "Ok, vielleicht doch :-)");                              

  AddDetail( ({ "seidenfaden", "faden" }),
      "Er ist hauchduenn.");
      
  AddSound( DEFAULT_SOUND,
    "Du hoerst nur das leise Knarren der Dielen bei Deinen Bewegungen.");


  AddSmell( DEFAULT_SMELL,
    "Das Holz duftet frisch und verbreitet einen angenehmen Geruch.");

  AddExit( "norden", "./muehle007" );
  AddExit( "westen", "./muehle005" );
  AddExit( "osten", "./muehle008" );
  
}
