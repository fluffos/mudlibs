#include "../def.h"
#include "../muehlenquest.h"

inherit "std/npc";

#define MY_NAME "Mueller"
#define MY_SHORTINT "Der alte Mueller"
#define MY_GENDER MALE
#define MY_ID "mueller"

#define MEHL_MENGE 10
#define MEHL_PREIS 300

mapping gave_egg = ([]);
int mehl = MEHL_MENGE;

string info_mehl();
string info_mehl1();

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, MY_SHORTINT);
  SetProp(P_LONG,
    "Vor Dir steht ein alter Mueller. Er ist seit eh und je dafuer "
    "zustaendig, das SilberLand mit ausreichend Mehl zu versorgen. "
    "An seinem rechten Bein kannst Du einen dicken Verband erkennen. "
    "Es sieht aus, als haette er sich verletzt.");
  SetProp(P_NAME, MY_NAME);
  SetProp(P_GENDER, MY_GENDER);

  AddId( ({ MY_ID, "hobbit" }));

  create_default_npc(20);

  SetProp(P_HANDS, ({" mit seinen rauhen Haenden",200,DT_BLUDGEON}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, "ist doch verletzt und kann nicht kaempfen!");

  SetProp(P_LOG_INFO, "iwo/mueller.log");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    MY_NAME + " sagt: Vielen Dank. Aber ich brauche @WEN nicht.\n" }) );


  AddDetail( ({ "verband" }),
     "Ein dicker Verband ziert das Bein des Muellers.");
     
  AddDetail( ({ "bein" }),
     "Das Bein des Muellers duerfte gebrochen oder verstaucht sein.");

  AddInfo(DEFAULT_INFO, ({
    "fragt: Was genau meinst Du denn jetzt?\n",
    "sagt: Iwo kennt auf alles eine Antwort, frag ihn doch mal.\n",
    "schaut Dich nur verwundert an.\n",
    "fragt schroff: Woher soll ich das wissen?\n"}) );

  AddInfo( ({"hilfe", "problem"}),
    "Der Baecker in Felonia braucht dringend einen Sack Mehl. Ich bin "
    "aber wie Du sehen kannst verletzt und kann meiner Arbeit nicht "
    "nachgehen. Willst Du mir helfen?", "sagt: ");

  AddInfo( ({"bein", "verband"}),
    "Ich habe mir, wie Du siehst, am Bein eine Verletzung zugezogen, "
    "darum brauche ich Deine Hilfe.", "sagt: ");
 
  AddInfo( ({"mueller"}),
    "Ja, ich bin der Mueller dieser Muehle.", "bestaetigt: ");  
  AddInfo( ({"mehl"}), #'info_mehl, #'info_mehl1);
    
  AddInfo( ({"stab"}),
    "Der Tischler Sawer stellt fuer mich immer die Ersatzteile her.", "sagt: ");

  AddInfo( ({"ersatzteile"}),
    "Ersatzteile kaufe ich immer bei Sawer, dem Tischler.", "sagt: ");  
  
  AddInfo( ({"tischler", "sawer"}),
    "Ich hab gehoert, dass er zur Zeit irgendwo im Huegelland arbeitet.",
    "sagt: ");
    
  AddInfo( ({"schaufel"}),
    "Hmmmm...\n"
    "Die muesste irgendwo im Gebaeude rumstehen.", "sagt: ");

  AddInfo( ({"arbeit"}),
    "Normalerweise ist es meine Arbeit Mehl zu mahlen. Aber ich bin "
    "zur Zeit nicht in der Verfassung das zu tun.", "sagt: ");

  AddInfo( ({"baecker"}),
    "Mein Freund der Baecker in Felonia wird Dir dankbar sein "
    "fuer die Hilfe.", "sagt: ");
    
  AddInfo( ({"felonia"}),
    "Felonia ist die Zwergenstadt - unweit des Silberwaldes - "
    "im Gebirge.", "sagt: ");
    
  AddInfo( ({"sack"}),
    "Der volle Sack wird vom Baecker benoetigt.", "sagt: ");
    
  AddInfo( ({ "verletzung" }),
    "Ich bin leider mit einem Sack Mehl auf der Schulter ueber "
    "die Treppe gestuerzt.", "sagt: ");
    
  AddInfo( ({ "treppe" }),
    "Ja, die Treppe, die nach oben fuehrt.", "sagt: ");
    
  AddInfo( ({ "schulter" }),
    "Schultern sind perfekt um schwere Lasten zu tragen.", "sagt: ");
    
  AddInfo( ({"muehle"}),
    "Hier im Gebaeude findest Du die eigentliche Muehle. "
    "Bitte sei so nett und hilf mir. Solltest Du noch "
    "etwas brauchen, dann frag mich am Besten nochmal. "
    "Vielleicht kann ich Dir ja helfen.", "sagt: ");
    

  AddInfo( ({ "ei" }),
    "Leider weiss ich nicht wirklich was darueber, aber Du kannst das "
    "Raetsel dieses Eis sicher entschluesseln.", "sagt: ");

  AddInfo( ({ "lohn", "belohnung", "questbelohnung" }), "@@give_egg@@",
            "sagt: ");


  AddCmd( "biete", "biete");
  AddCmd( ({"hilf", "helfe"}), "helfen");
  AddCmd( ({"kauf", "kaufe"}), "cmd_kaufen");

  restore_object(QMASTER);
  
}


    
int biete ( string str )
    {
    notify_fail("Wem willst Du Deine Hilfe anbieten?\n");  
    if (!str || str != "mueller hilfe an") return 0;
        
    if (call_other(QMASTER, "isquester", TP)==1)
        {
        command_me("sag Aber Du hilfst mir doch schon!");
        return 1;
	}

    if( TP->QueryQuest(MUEHLENQUEST) )
    {
       write("Danke, aber Du hast mir schon einmal geholfen!\n");
       return 1;
    }
    if (call_other(QMASTER, "addquester", TP)==1)
        {
//          printf("%O\n", queststats);
        write_file (MUEHLENQUESTLOG,
          sprintf ("%s  %s beginnt die Muehlenquest.\n",
          dtime(time()), CAP(TP->query_real_name())));
	command_me("sag Danke, dass Du mir helfen willst, "+TP->Name()+"!");
	command_me("sag Wenn Du die Aufgabe erledigt hast, kehre zurueck und "+
	    "frag mich nochmal nach Deiner Belohnung.");
	command_me("sag Viel Glueck!");
	}


    return 1;
    }
    

int helfen(string str)
{
  notify_fail("Wem willst Du helfen?\n");
  if( !str || !id(str) ) return 0;
  return biete("mueller hilfe an");
}


string give_egg()
{
  string queststr;
  object ob;


  if (!TP->QueryQuest("Hilf dem Mueller"))
      return "Belohnung? Wofuern denn?!?";

  if (present("morphei", TP)) return "Aber Du hast doch schon etwas bekommen!\n";

  if (member(gave_egg, TP))
     return "Leider habe ich gerade keine Belohnung mehr fuer Dich. Komm bitte etwas spaeter wieder.";

  ob = clone_object(BELOHNUNG);
  if (ob->move(TP) == ME_TOO_HEAVY)
    {
      ob->remove();
      return "Du kannst Die Belohnung nicht mehr tragen.";
    }
  else
    {
      tell_room(ENV(ME), BS("Der Mueller gibt " + TP->Name(WEM) + " etwas."), ({ TP }));
      tell_object(TP, BS("Der Mueller gibt Dir etwas."));
      gave_egg += ([ TP ]);
    }

  if(find_player("iwo")) tell_object(find_player("iwo"), sprintf("MORPHEI: Abholung Ei von %O\n", TP));

  return "Hier, als Belohnung erhaeltst Du dieses Ei. Viel Spass damit.";

}

void reset()
{
  ::reset();
  gave_egg = ([]);
  mehl = MEHL_MENGE;
}

void heart_beat()
{
  ::heart_beat();
  SetProp(P_HP, QueryProp(P_MAX_HP)/4);
}

string info_mehl()
{
  if (TP->QueryQuest("Hilf dem Mueller"))
    return "Da Du mir geholfen hast, die Muehle zu reparieren, kannst Du "
      "bei mir jetzt Mehl kaufen.";
  else
    return "Ich kann leider keines mahlen zur Zeit.";
}

string info_mehl1()
{
  if (TP->QueryQuest("Hilf dem Mueller"))
    return "sagt froehlich: ";
  else
    return "sagt traurig: ";
}

int cmd_kaufen(string str)
{
  object ob;

  if (!TP->QueryQuest("Hilf dem Mueller"))
    return 0;
  notify_fail("Du kannst hier nur Mehl kaufen.\n");
  if (str != "mehl")
    return 0;
  if (mehl <= 0)
    return command("sag Tut mir leid, ich bin ausverkauft."), 1;
  if (TP->QueryMoney() < MEHL_PREIS)
    return command("sag Du hast zu wenig Geld."), 1;
  ob = clone_object("/p/std/skills/baking/obj/flour");
  TP->AddMoney(-MEHL_PREIS);
  mehl--;
  if (ob->move(TP, M_GET) < 0)
  {
    write("Da Du das Mehl nicht mehr tragen kannst, laesst Du es auf den "
        "Boden fallen.\n");
    ob->move(ENV(TP));
  }
  else
    write("Der Mueller gibt Dir ein kleines Saeckchen mit Mehl.\n");
  return 1;
}

