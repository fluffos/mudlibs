int listquesters ()
{

    if(IS_ARCH(TP) || getuid(TP)=="iwo" )
    {
      tell_object(TP, "MuehlenQuest: Anzahl der aktiven Spieler: " 
          + sizeof(m_indices(queststats)) + "\n");
	  
         
      tell_object(TP, sprintf("%O\n", queststats));
      return 1;
    }    
    return -1;
}
    

int zahnradstats (object player)
    {
    if (!isquester(player)) return 0;
    if (wheelturns(player)) return 3;
    if (fixedstick(player)) return 2;
    if (hastried(player))   return 1;
    return 0;
    }

    
void fertig(object player)
{  
  
  // Hier noch die Abfrage, ob der spieler eh alles aus der Quest geloest hast.
  if (!wheelturns(player) || !fixedmuehle(player))
      {
      tell_object(player, BS("Tja, leider hast Du anscheinend nicht alles "
                             "selber gemacht."));
      removequester(player);
      return 0;
      }

  
  if( player->GiveQuest(MUEHLENQUEST) == 1)
  {
     write_file (MUEHLENQUESTLOG,
       sprintf ("%s  %s hat dem Mueller geholfen.\n",
       dtime(time()), CAP(player->query_real_name())));
  }
  removequester(player);
  save_object(QMASTER);
}

    
