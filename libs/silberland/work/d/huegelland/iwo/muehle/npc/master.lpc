#include "../def.h"
#include "../muehlenquest.h"


mapping queststats = ([]);
/* name: wasserrad; stab; mehl; riemen; */ 


mixed create()
    {
    if (is_clone(this_object()))
        {
	destruct(this_object());
	return 1;
	}
    seteuid(getuid(this_object()));
    restore_object(QMASTER);
    }

void mylog (object player, string logtext)
    {
    string text;
    
    text = sprintf("%s: %s %s\n", ctime(), player->Name(WER), logtext);
    
    write_file(QLOG+"questlog", text);
    }


int isquester (object player)
    {
    string playerstring;
    playerstring = file_name(player);
    if (member(queststats, playerstring)) return 1;
    return 0;
    }

    
int addquester (object player)
    {
    string playerstring;
    playerstring = file_name(player);
    
    if (isquester(player)) return 0;
    if (queststats += ([playerstring: 0; 0; 0; 0; 0; 0]))
        {
        mylog(player, "Hat soeben Die Quest begonnen.");      
        save_object(QMASTER);
        return 1;
        }
    return 0;
    }

int removequester (object player)
    {
    string playerstring;
    playerstring = file_name(player);
    
    if(!isquester(player)) return 0;
    if (queststats -= ([ playerstring ])) 
        {
	mylog(player, "Wurde als Quester entfernt.");
        save_object(QMASTER);
        return 1;
        }
    return 0;
    }

    
int hastried (object player)
    {
    string playerstring;
    playerstring = file_name(player);
    
    if (queststats[playerstring, 1] == 1) return 1;
    return 0;
    }

int changehastried (object player)
    {
    string playerstring;
    playerstring = file_name(player);

    if (!isquester(player)) return 0;
    if (queststats[playerstring, 1] == 1) 
        {
	mylog(player, "Hat den Bolzen gelockert und den Stab zerbrochen.");
        save_object(QMASTER);
        return 1;
        }
    return 0;
    }

int fixedstick (object player)
    {
    string playerstring;
    playerstring = file_name(player);
    
    if (!isquester(player) || !hastried(player)) return 0;
    if (queststats[playerstring, 2] == 1) return 1;
    return 0;
    } 

