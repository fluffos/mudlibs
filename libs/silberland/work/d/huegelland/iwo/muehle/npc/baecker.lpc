
/*
//
//  <noname>, der Baecker in Felonia
//  Iwo@SL
//
*/

#include "../def.h"

inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include <defines.h>
#include <moredef.h>

#define MY_NAME "Baecker"
#define MY_SHORTINT "Der alte Baecker"
#define MY_GENDER MALE
#define MY_ID "baecker"

/* Die Quest defines */
#define QPATH "/d/huegelland/iwo/muehle/"
//#define QMASTER QPATH "npc/master"


void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, MY_SHORTINT);
  SetProp(P_LONG,
    "Vor Dir steht der beste Baecker der Zwergenstadt. Die leckersten "
    "Backwaren wie Kipferln, Salzstangen,... werden von seinen "
    "geschickten Haenden gemacht.");
  SetProp(P_NAME, MY_NAME);
  SetProp(P_GENDER, MY_GENDER);
  SetProp(P_NAME_ADJ, "alt");

  AddId( ({ MY_ID ,"zwerg" }));
  AddAdjective( ({"alt", "alten", "alter"}) );
  
  create_default_npc(20);

  SetProp(P_HANDS, ({" mit seinen rauhen Haenden",200,DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);

//  SetProp( P_REJECT, ({ REJECT_GIVE,
//    MY_NAME + " sagt: Vielen Dank. Aber ich brauche @WEN nicht.\n" }) );

  SetChats(1, ({
    "Der alte Baecker sagt: Das Mehl, das Mehl...\n",
    "Der alte Baecker fragt: Was ist bloss mit dem Mueller los?\n"}) );


  AddInfo(DEFAULT_INFO, ({
    "fragt: Was genau meinst Du denn jetzt?\n",
    "sagt: Iwo kennt auf alles eine Antwort, frag ihn doch mal.\n",
    "schaut Dich nur verwundert an.\n",
    "fragt schroff: Woher soll ich das wissen?\n"}) );

  AddInfo( ({"hilfe", "problem"}),
    "Mein Mehl ist alle. Warum bringt mir der Mueller bloss "
    "kein Mehl mehr?", "sagt: ");

  AddInfo( ({"mehl"}),
    "Kein Mehl mehr, kein Mehl mehr.", "murmelt traurig: ");
    
  AddInfo( ({"mueller"}),
    "Der alte Mueller nahe Hobbingen liefert mir ueblicher "
    "Weise rechtzeitig Mehl. Was ist bloss los mit ihm? "
    "Koenntest Du mal nachsehen, warum er keines bringt?\n",
    "sagt: ");

  AddInfo( ({"hobbingen"}),
    "Das Dorf der pelzigen Hobbits.\n", "sagt: ");

  AddInfo( ({"hobbits"}),
    "Du hast sicher schon von ihnen gehoert.\n", "sagt: ");   

  
}




give_notify ( object ob )
    {
    
    
    if (ob->id("mehlfuermuehle"))
        {

        ob->SetProp(P_NEVERDROP, 0);
        tell_room(environment(TO), BS(TO->Name(WER) + " fuettert einen Muellschlucker mit einem Mehlsack."));
        command_me("fuettere muellschlucker mit mehlsack");
        if (call_other(QMASTER, "isquester", TP) == 1)
            {
	    tell_room(MENV, BS("Der Baecker sagt: Aaah, danke! Das heiss ersehnte Mehl!"));
            call_other(QMASTER, "fertig", TP);
	    return 1;
            }
	}		    	                    
    
    return ::give_notify(ob);
    }
    

