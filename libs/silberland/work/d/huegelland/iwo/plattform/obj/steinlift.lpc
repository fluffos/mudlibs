
inherit "std/transport";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
#include "../def.h"

create()
{
  ::create();

    SetProp(P_NAME, "Plattform");
    SetProp(P_ARTICLE, 1);
    SetProp(P_NAME_ADJ, "steinern");
    SetProp(P_GENDER, FEMALE);
    SetProp(P_INT_SHORT, "Auf einer Plattform aus Stein");
    SetProp(P_INT_LONG, BS(
      "Du stehst auf einer geraeumigen steineren Plattform. Dort, wo "
      "Du die Vorderseite vermutest sitzt ein junger Druide und "
      "und fuchtelt mit Mistelzweigen in der Gegend herum."));
    AddId(  ({"plattform", "steinplattform"})  );
    SetProp(P_SHORT, "Eine steinerne Plattform");
    SetProp(P_LONG, BS(
      "Diese Plattform besteht vollkommen aus Stein. Ein junger "
      "Druide sitzt an einem Ende und fuchtelt mit Mistelzweigen "
      "in der Gegend herum." ));
    // SetProp(P_LIGHT, 1);

    AddDetail( ({"plattform"}), BS(
        "Eigentlich moechtest Du garnicht so genau wissen warum "
        "dieser Stein fliegen kann, aber Du glaubst, dass es was "
        "mit dem Druiden und seinen merkwuerdigen Verrenkungen "
        "zu tun hat."
        ));
    AddDetail( ({"stein"}), BS(
        "Ja, die Plattform ist voellig aus Stein. Granit um genau "
        "zu sein."
        ));
    AddDetail( ({"granit"}), BS(
        "Eigentlich interessiert Dich das garnicht."
        ));
    AddDetail( ({"verrenkungen"}), BS(
        "Irgendwelche magischen Gesten. Scheinbar hat dieser Druide "
        "eine spezielle Ausbildung."
        ));
    AddDetail( ({"ausbildung"}), BS(
        "Das waere Dir viel zu gefaehrlich."
        ));
    AddDetail( ({"vorderseite"}), BS(
        "Eigentlich hat die Plattform garkeine richtige Vorderseite. "
        "Aber Du vermutest mal, dass die Richtung in die der Druide "
        "schaut vorne ist. Zumindest hoffst Du das...."
        ));
    AddDetail( ({"zweig", "zweige", "mistelzweig", "mistelzweige"}), BS(
        "Viele Druiden verwenden spezielle Pflanzen oder Gegenstaende "
        "um ihre Zauber zu verstearken. Mistelzweige sind welche der "
        "beliebtesten."
        ));
    AddDetail( ({"pflanzen"}), BS(
        "Hier wachsen keine Pflanzen. Nur etwas Moos."
        ));
    AddDetail( ({"moos"}), BS(
        "Es hat sich im Laufe der Jahre hier angesammelt."
        ));
    AddDetail( ({"gegenstaende"}), BS(
        "Du siehst nichts Besonderes hier."
        ));
    AddDetail( ({"besonderes"}), "Nichts.");
    AddDetail( ({"boden"}), BS(
        "Du beugst Dich ueber den Rand der Plattform und blickst nach unten. "
        "Dir wird uebel und Du schaust sofort wieder auf den Druiden."
        ));
    AddDetail( ({"himmel"}), BS(
        "Dem Himmel warst Du noch nie so nahe wie jetzt."
        ));
    AddDetail( ({"gegend"}), BS(
        "So weit oben hast Du viel zu viel Angst um Dir die Gegend anzusehen."
        ));
    AddDetail( ({"angst"}), BS(
        "Du zitterst vor Angst."
        ));
    AddDetail( ({"gesten"}), BS(
        "Du bist Dir nicht sicher, ob der Druide alle Tassen im Schrank hat."
        ));
    AddDetail( ({"tassen", "schrank"}), BS(
        "Aber das ist doch nur eine Redewendung...."
        ));
    AddDetail( ({"rand"}), BS(
        "Von dem haeltst Du Dich besser fern..."
        ));

    SetProp(P_TRANSPARENT, 0);
    SetProp(P_DEPARTMSG, ({
      "Die steinerne Plattform erhebt sich in die Luefte.\n",
      "Die steinerne Plattform steigt langsam auf.\n"}));

    SetProp(P_ARRIVEMSG, ({
      "Die Plattform naehert sich @@QueryArrived@@ und legt an.\n",
      "Eine steinerne Plattform landet.\n" }));

    SetProp(P_ENTERMSG, ({
      "betritt die steinerne Plattform",
      "betritt die steinerne Plattform"}));

    SetProp(P_LEAVEMSG, ({
      "verlaesst die Plattform",
      "betritt wieder festen Boden"}));

    SetProp (P_MAX_PASSENGERS, 5);
    SetProp (P_LEAVEFAIL, "Die Plattform ist viel zu hoch.");
    SetProp (P_ENTERFAIL, "Leider koennen immer nur 5 Leute die Plattform "
                          "betreten.");


    AddCmd(  ({"steig", "steige", "spring", "springe" }), "steige");
    AddCmd(  ({ "betrete", "betritt", "besteig", "besteige" }), "myEnter");
    AddCmd(  ({ "verlass", "verlasse" }), "myLeave");

    AddRoute ("/gilden/druidenzirkel", 30, 30, "Erde",
        ({"anvar","druidenzirkel","erde","boden"}), "zum Boden");
    AddMsg(BS("Der Druide fuehr seltsame Bewegungen mit den "
              "Mistelzweigen aus."), 28);
    AddMsg(BS("Die Plattform beginnt immer schneller aufzusteigen."), 24);
    AddMsg(BS("Die Plattform schwebt weit ueber dem Boden durch die "
              "Luefte.\n"), 20);
    AddMsg(BS("In der Ferne kannst Du eine riesige schwebende "
              "Plattform erkennen."), 15);
    AddMsg(BS("Der Druide winkt mit den Mistelzweigen."), 10);
    AddMsg(BS("Die Plattform naehert sich."), 5);


    AddRoute("/d/huegelland/luft/plattform/room/room_a05", 30, 30, 
             "schwebende Plattform",
        ({"plattform","luft","himmel"}),
         "zur schwebenden Plattform");

    AddMsg(BS("Der Druide fuehrt seltsame Bewegungen aus und beruehrt "
              "die Plattform an verschiedenen Stellen mit den "
              "Mistelzweigen."), 28);
    AddMsg("Die Plattform schwebt langsam weg von der Anlegestelle\n", 24);
    AddMsg("Dir wird etwas uebel bei dem Gedanken an fliegende Steine.\n", 
            20);
    AddMsg("Die Plattform schwebt behende durch die Luefte.\n", 15);
    AddMsg(BS("Die Plattform beginnt langsam mit dem Sinkflug."), 10);
    AddMsg("Die Plattform naehert sich dem Boden.\n", 5);

    AddItem("/gilden/druidenzirkel/npc/liftdruide", REFRESH_DESTRUCT);

    Start();
  }


// P_LIGHT uebernehmen wir am besten von der Umgebung :-) - Denn wieso
// sollte es auf dem Floss hell sein, wenn es in ner dunklen Grotte ist?
//
int _query_light()
{
  return environment()->Query(P_LIGHT);
}


steige(str)
{
  string arg, arg2;
  notify_fail("Anvar laesst Dich nicht.\n");
  if (!IS_WIZARD(TP) || TP != find_player("eyda")) return 0;

  if (environment() != environment(this_player()) &&
      environment(this_player()) != this_object()) return 0;
  notify_fail("Wo willst Du rauf oder runter?\n");
  if (!str) return 0;
  if ((sscanf(str, "%s %s", arg, arg2) != 2) && !id(str)) return 0;
  if (!id(str) && !id(explode(arg2, " ")[0])) return 0;
  if (id(str) || arg=="auf")
    return notify_fail("Aber die Plattform ist doch gar nicht hier!\n"),
                         Enter();
  if ( id(str) || arg=="von" || arg=="aus")
    return notify_fail("Aber die Plattform ist doch gar nicht hier!\n"), 
                         Leave();
  return 0;
}

int myEnter(string str)
{
  notify_fail("Was willst Du betreten?\n");
  notify_fail("Anvar laesst Dich nicht.\n");
   if (!IS_WIZARD(TP)) return 0;
  if (id(str)) return notify_fail("Das geht gerade nicht.\n"), Enter();
}

int myLeave(string str)
{
  notify_fail("Was willst Du verlassen?\n");
  if (id(str)) return notify_fail("Das geht gerade nicht.\n"), Leave();
}

