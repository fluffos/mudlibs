#include <properties.h>
#include <moving.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf eine schwebenden Plattform");
  SetProp (P_INT_LONG, "Raum c06");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit("norden", ROOM "room_d06");
  AddExit("sueden", ROOM "room_b06");
  AddExit("osten", ROOM "room_c07");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
