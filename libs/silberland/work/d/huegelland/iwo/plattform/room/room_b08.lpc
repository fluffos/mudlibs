#include <properties.h>
#include <moving.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf eine schwebenden Plattform");
  SetProp (P_INT_LONG, "Raum b08, suedlicher Rand, Plattformdruide Wasser");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit("nordosten", ROOM "room_c09");
  AddExit("norden", ROOM "room_c08");
  AddExit("westen", ROOM "room_b07");
  // EXITS END

  // ITEMS START
  AddItem(NPC "pdruide_wasser", REFRESH_DESTRUCT);
  // ITEMS END

}
