#include <properties.h>
#include <moving.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf eine schwebenden Plattform");
  SetProp (P_INT_LONG, "Raum e01, westlicher Rand, Plattformdruide humus");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit("nordosten", ROOM "room_f02");
  AddExit("suedosten", ROOM "room_d02");
  // EXITS END

  // ITEMS START
  AddItem(NPC "pdruide_humus", REFRESH_DESTRUCT);
  // ITEMS END

}
