#include <properties.h>
#include <moving.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf eine schwebenden Plattform");
  SetProp (P_INT_LONG, "Raum h08, noerdlicher Rand, Plattformdruide Feuer");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit("suedosten", ROOM "room_g09");
  AddExit("westen", ROOM "room_h07");
  AddExit("sueden", ROOM "room_h06");
  // EXITS END

  // ITEMS START
  AddItem(NPC "pdruide_feuer", REFRESH_DESTRUCT);
  // ITEMS END

}
