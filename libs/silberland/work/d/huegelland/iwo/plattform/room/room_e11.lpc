#include <properties.h>
#include <moving.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf eine schwebenden Plattform");
  SetProp (P_INT_LONG, "Raum e11, oestlicher Rand, Plattformdruide Humus");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit("nordwesten", ROOM "room_f10");
  AddExit("suedwesten", ROOM "room_d10");
  // EXITS END

  // ITEMS START
  AddItem(NPC "pdruide_erz", REFRESH_DESTRUCT);
  // ITEMS END

}
