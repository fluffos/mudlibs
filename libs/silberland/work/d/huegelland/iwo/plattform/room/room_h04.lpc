#include <properties.h>
#include <moving.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf eine schwebenden Plattform");
  SetProp (P_INT_LONG, "Raum h04, noerdlicher, Plattformdruide Eis");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit("osten", ROOM "room_h05");
  AddExit("sueden", ROOM "room_g04");
  AddExit("suedwesten", ROOM "room_g03");
  // EXITS END

  // ITEMS START
  AddItem(NPC "pdruide_eis", REFRESH_DESTRUCT);
  // ITEMS END

}
