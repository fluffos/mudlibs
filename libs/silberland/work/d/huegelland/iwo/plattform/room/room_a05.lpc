#include <properties.h>
#include <moving.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf eine schwebenden Plattform");
  SetProp (P_INT_LONG, 
      "Du befindest Dich auf einer riesigen schwebenden Plattform "
      "aus massivem Stein knapp ueber der Wolkendecke. An manchen "
      "Stellen reichen die Wolken so weit herauf, dass Wolkenfetzen "
      "wie ein Schleier ueber dem Boden liegen und Dir die Sicht "
      "auf den Untergrund verwehren."
      );
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit("norden", ROOM "room_b05");
  // EXITS END

  // ITEMS START
  AddItem("/gilden/druidenzirkel/obj/steinlift", REFRESH_DESTRUCT, 1);
  // ITEMS END

}
