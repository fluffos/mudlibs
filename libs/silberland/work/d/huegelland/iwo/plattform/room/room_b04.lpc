#include <properties.h>
#include <moving.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Auf eine schwebenden Plattform");
  SetProp (P_INT_LONG, "Raum b04, suedlicher Rand, Plattformdruide Luft");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit("osten", ROOM "room_b05");
  AddExit("nordwesten", ROOM "room_c03");
  AddExit("norden", ROOM "room_c04");
  // EXITS END

  // ITEMS START
  AddItem(NPC "pdruide_luft", REFRESH_DESTRUCT);
  // ITEMS END

}
