/* 
 *  Funktion, um einem NPC ein Element zuzuweisen
 *
 */

int set_element(string str) {
  mapping res;
  string element;

  res=QueryProp(P_RESISTANCE_STRENGTHS);
  element=lower_case(str);
  switch (lower_case(str)) {
    case "feuer": 
      SetProp(P_RESISTANCE_STRENGTHS, res+([DT_FIRE:-0.9, DT_WATER:2]));
      SetProp(P_HANDS, ({" mit elementarer Macht",HANDS_WC,DT_FIRE}));
      break;
      
    case "wasser": 
      SetProp(P_RESISTANCE_STRENGTHS, res+([DT_WATER:-0.9, DT_FIRE:2]));
      SetProp(P_HANDS, ({" mit elementarer Macht",HANDS_WC,DT_WATER}));
      break;
      
    case "eis": 
      SetProp(P_RESISTANCE_STRENGTHS, res+([DT_COLD:-0.9, DT_FIRE:1]));
      SetProp(P_HANDS, ({" mit elementarer Macht",HANDS_WC,DT_COLD}));
      break;
    
    case "erz": 
      SetProp(P_RESISTANCE_STRENGTHS, res+([DT_SLASH:-0.9, DT_BLUDGEON:-0.9,
            DT_PIERCE:-0.9, DT_SQUEEZE:-0.9,DT_WHIP:-0.9,
            DT_RIP:-0.9, DT_AIR:2]));
      SetProp(P_HANDS, ({" mit elementarer Macht",HANDS_WC,DT_BLUDGEON}));
      break;
    
    case "luft": 
      SetProp(P_RESISTANCE_STRENGTHS, res+([DT_SLASH:2, DT_BLUDGEON:2
          ,DT_PIERCE:2, DT_SQUEEZE:2,DT_WHIP:2,DT_RIP:2, DT_AIR:-0.9]));
      SetProp(P_HANDS, ({" mit elementarer Macht",HANDS_WC,DT_AIR}));
      break;

    case "humus": 
      SetProp(P_RESISTANCE_STRENGTHS, res+([DT_COLD:1, DT_FIRE:-0.5]));
      SetProp(P_HANDS, ({" mit elementarer Macht",HANDS_WC,DT_AIR}));
      break;

  }
  return 1;
}
