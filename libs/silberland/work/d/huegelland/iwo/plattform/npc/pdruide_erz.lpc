inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <wizlevels.h>
#include <armour.h>
#include <moving.h>
#include <class.h>
#include <defines.h>
#include <moredef.h>
#include <new_skills.h>
#include "../def.h"


#define ELEMENT "erz"

/* fuer create_default_npc */
#define STUFE 50
#define HANDS_WC 120

#include "set_element.lpc"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein "+capitalize(ELEMENT)+"druide");
  SetProp(P_NAME, capitalize(ELEMENT)+"druide");
  SetProp(P_GENDER, MALE);

  AddId(({ELEMENT+"druide", "druide"}));

  create_default_npc(STUFE);

  SetProp(P_HANDS, ({" mit elementarer Macht",100,DT_MAGIC}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_XP, 0);
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 4);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:50]));
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

   // Verwundbarkeiten und Resistenzen
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0,        DT_BLUDGEON   :0,        DT_PIERCE     :0,
    DT_SQUEEZE    :0,        DT_WHIP       :0,        DT_RIP        :0,
    DT_FIRE       :0,        DT_COLD       :0,        DT_WATER      :0,    
    DT_AIR        :0,        DT_LIGHTNING  :0,        DT_EXPLOSION  :0, 
    DT_SOUND      :-0.5,     DT_LIGHT      :-1,       DT_ELECTRIC   :0,    
    DT_ACID       :-1,       DT_POISON     :-1,       DT_TERROR     :-1,     
    DT_HOLY       :-1,       DT_UNHOLY     :-1,       DT_MAGIC      :0]) 
    );

  SetProp(P_NOMAGIC, 10);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MMSGIN, "kommt an");
  SetProp(P_MMSGOUT, "geht");
  SetProp(P_DIE_MSG, " sackt leblos zusammen.\n");
  //SetProp(P_KILLNAME, "Ein Luftdruide");
  
  AddInfo(DEFAULT_INFO, "is zu beschaeftigt.\n");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Druide ignoriert Dich.\n" }) );

  set_element(ELEMENT);

}



