#include "def.h"

inherit "std/room";

void create()
{
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem kleinen Hobbithaus");
  SetProp(P_INT_LONG,
    "Du stehst hier in einem kleinen Haus am Rand von Derlim. An einer Wand "
    "steht ein kleines Bett mit weichen Bezuegen. Daneben befindet sich ein "
    "kleines Tischchen, auf dem ein Bild steht. An einer anderen Wand siehst "
    "Du eine Karte des Silberlands. Neben der Tuere befindet sich ein Regal "
    "mit vielen Weinflaschen. Ueberhaupt schwebt ein zarter Duft von altem "
    "Wein im Raum. Ein kleiner Schaukelstuhl steht am einzigen Fenster "
    "des Hauses.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "haus", "hobbithaus", "raum" }),
    "Du befindest Dich hier in einem Haus mit allem, was dazu gehoert.");

  AddDetail( ({ "rand", "derlim" }),
    "Dieses bescheidene Hobbithaus steht am Rand von Derlim.");

  AddDetail( ({ "wand", "waende" }),
    "Die Waende bestehen aus roten Ziegelsteinen. In einer Wand befindet "
    "sich ein kleines Fenster. An einer anderen steht das kleine Bett und an "
    "der Wand neben dem Eingang befindet sich ein Regal mit Weinflaschen.");

  AddDetail( ({ "bett" }),
    "Das Bett steht an einer Wand gegeueber des Eingangs. Es ist genau so "
    "gross, dass ein Halbling hinein passt. Die Decken und der Polster sind "
    "mit weichen Bezuegen bezogen.");

  AddDetail( ({ "tisch", "tischchen", "holztisch", "holztischchen" }),
    "Neben dem Bett steht ein kleines Holztischchen mit einem Bild darauf.");

  AddDetail( ({ "bild" }),
    "Auf dem Bild erkennst Du einen grimmigen Zwerg, eine huebsche Elfe, einen "
    "dicklichen Menschen und einen Halbling.");

  AddDetail( ({ "karte" }),
    "Die Karte zeigt das gesamte Silberland mit allen Regionen.");

  AddDetail( ({ "silberland", "silberlands" }),
    "Du bist hier im Silberland.");

  AddDetail( ({ "tuer", "tuere", "eingang", "eingangs" }),
    "Durch diese tuer bist Du wohl hereingekommen. Neben ihr steht ein "
    "Regal, das mit Weinflaschen gefuellt ist.");

  AddDetail( ({ "flaschen", "weinflaschen", "sorten", "regal", "weinsorten" }),
    "Du erkennst einige sehr seltene Weinsorten: Derlimer Riesling, Feenwein, "
    "magischer Elfenwein, Kaktuswein, Kokoswein, Midas Suedhang, Bordeaux "
    "Verianis. Alles, nur kein Zwergenwein.");

  AddDetail( ({ "duft" }),
    "Den sieht man nicht.");

  AddDetail( ({ "schaukelstuhl", "stuhl" }),
    "Ein Schaukelstuhl steht so am Fenster, dass man gut raussehen kann.");

  AddDetail( ({ "fenster" }),
    "Durch das Fenster kannst Du in den Garten sehen.");

  AddDetail( ({ "ziegelsteine", "ziegelsteinen" }),
    "Das Haus wurde aus roten Ziegelsteinen erbaut.");

  AddDetail( ({ "halbling", "hobbit" }),
    "Die Halblinge wohnen in Derlim." );

  AddDetail( ({ "decken", "decke", "polster", "bezuege", "bezug" }),
    "Ein weicher Bezug wurde ueber die Decke und den Polster im Bett "
    "gezogen." );

  AddDetail( ({ "zwerg", "elfe", "elf", "mensch", "menschen", "zwergen" }),
    "Das sind vermutlich die Gruender der Zechpreller." );

  AddDetail( ({ "regionen", "teile" }),
    "Das Silberland hat viele Regionen: Die Astralebene, den Dschungel, "
    "die Ebene, das Gebirge, das Huegelland, den Kristallwald, den Himmel, "
    "den Polarkreis, die Unterwelt, die Meere und die Wueste." );

  AddDetail( ({ "derlimer", "riesling" }),
    "Der Derlimer Riesling ist ein gefragter Wein aus Derlim." );

  AddDetail( ({ "feenwein" }),
    "Dieser spezielle Wein wird von Feen im Feenschloss gezuechtet." );

  AddDetail( ({ "elfenwein" }),
    "Man sagt dem Elfenwein, der aus Elessar kommt, nach, dass er heilende "
    "Kraefte hat." );

  AddDetail( ({ "kaktuswein" }),
    "Kaktuswein wird von Voelkern der Wueste erzeugt." );

  AddDetail( ({ "kokoswein" }),
    "Aus den Plantagen von Tijara kommt der seltene Kokoswein." );

  AddDetail( ({ "bordeaux", "verianis", "bordeaux verianis" }),
    "Der Bordeaux Verianis ist ein aeusserst teurer Wein, der von Verian "
    "im Fischerdorf gemacht wird." );

  AddDetail( ({ "garten" }),
    "Draussen erkennst Du den Garten." );

  AddDetail( ({ "gruender", "zechpreller", "gildengruender" }),
    "Woher der Bewohner dieses Hauses die Gildengruender der Zechpreller wohl "
    "kennt?" );

  AddDetail( ({ "bewohner" }),
    "Wer mag das nur sein?" );

  AddDetail( ({ "astralebene" }),
    "Die Astralebene befindet sich irgendwo neben dem Silberland. Auf der "
    "Karte kannst Du sie nicht erkennen." );

  AddDetail( ({ "dschungel" }),
    "Der Dschungel befindet sich weit im Sueden. Auf der Karte erkennst "
    "Du die Hauptstadt Tijara." );

  AddDetail( ({ "ebene" }),
    "Die Ebene befindet sich recht zentral im Silberland. Dort befindet "
    "sich die Stadt Midas und die Festung Kyranda. Beides ist auf der Karte "
    "eingezeichnet." );

  AddDetail( ({ "gebirge" }),
    "Das Gebirge erstreckt sich ueber weite Teile des Silberlands. Auf der "
    "Karte erkennst Du Sturmfels und Felonia deutlich eingezeichnet." );

  AddDetail( ({ "huegelland" }),
    "Du befindest Dich hier in Derlim im Huegelland." );

  AddDetail( ({ "kristallwald" }),
    "Der Kristallwald befindet sich laut Karte noerdlich des Huegellands. "
    "Du erkennst deutlich die Stadt Elessar eingezeichnet." );

  AddDetail( ({ "himmel" }),
    "Der ist wohl ueber dem Silberland." );

  AddDetail( ({ "polar", "polarkreis" }),
    "Weit im Norden der Karte ist der Polarkreis eingezeichnet. Eine Stadt "
    "namens Yiqanuc ist deutlich markiert." );

  AddDetail( ({ "unterwelt" }),
    "Die ist unter dem Silberland." );

  AddDetail( ({ "meer", "meere" }),
    "Die Meere des Silberlands verbinden alle Regionen." );

  AddDetail( ({ "wueste" }),
    "Die Wueste befindet sich im Suedosten der Karte. Die Staedte Erg, "
    "Arrakeen und Quaul sind markiert." );

  AddDetail( ({ "boden" }),
    "Am Boden ist nichts besonders." );

  AddDetail( ({ "hauptstadt", "stadt", "staedte" }),
    "Welche denn?" );

  AddDetail( ({ "festung", "kyranda" }),
    "Die Festung Kyranda befindet sich in der Ebene." );

  AddDetail( ({ "felonia", "zwergenstadt" }),
    "Felonia ist eine Zwergenstadt im Gebirge." );

  AddDetail( ({ "sturmfels", "burg", "paladine" }),
    "Auf Burg Sturmfels im Gebirge wohnen die Paladine." );

  AddDetail( ({ "yiqanuc" }),
    "Das duerfte eine Stadt weit im Norden sein." );

  AddDetail( ({ "arrakeen", "erg", "quaul" }),
    "Das sind Staedte der Wueste." );

  AddDetail( ({ "fischerdorf" }),
    "Du schaust auf der Karte nach und erkennst, dass das Fischerdorf "
    "suedwestlich von Midas liegen muss." );

  AddDetail( ({ "verian" }),
    "Verian lebt im Fischerdorf." );

  AddDetail( ({ "elessar", "elfen" }),
    "Die Elfen leben in Elessar. Das befindet sich im Kristallwald." );

  AddDetail( ({ "kraefte" }),
    "Es heisst Elfenwein habe heilende Kraefte." );

  AddDetail( ({ "feen", "feenschloss" }),
    "Im Feenschloss, das sich irgendwo bei Midas befindet leben die Feen." );

  AddDetail( ({ "voelkern", "voelker" }),
    "In der Wueste finden sich verschiedene, sehr seltsame, Voelker." );

  AddDetail( ({ "plantagen", "tijara", "obstplantagen" }),
    "Tijara ist eine Stadt im Dschungel. Dort gibt es beruehmte Obstplant"
    "agen" );

  AddDetail( ({ "midas", "mitte" }),
    "Midas liegt genau in der Mitte des Silberlands in der Ebene." );

  AddDetail( ({ "suedhang", "hang" }),
    "Seltsam... Midas liegt in der Ebene, dort gibt es gar keinen Hang." );

  AddDetail( ({ "zwergenwein" }),
    "Vermutlich gibt es einfach keinen Zwergenwein." );

  AddSound( DEFAULT_SOUND,
    "Du hoerst leises Vogelgezwitscher.");

  AddSound( ({ "voegel", "vogel", "gezwitscher", "vogelgezwitscher" }),
    "Draussen zwitschern die Voegel.");

  AddSmell( DEFAULT_SMELL,
    "Ein leichter Duft von Wein schwebt im Raum.");

  AddSmell( ({ "duft", "wein" }),
    "Ein suesslicher, aber gar nicht so schlechter Duft.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "westen", ZONE "garten");

//--Items & NPCs-----------------------------------------------------------

  AddItem( ZONE "artanok" , REFRESH_DESTRUCT);
}

