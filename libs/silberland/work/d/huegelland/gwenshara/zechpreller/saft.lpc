inherit "std/food";     

#include <properties.h>
#include <food.h>       
#include "../def.h"


void create()
{
  if (!is_clone(this_object()))         
    return;                             

  ::create(({"trink", "trinke"}));

  AddId( ({ "saft", "fruchtsaft", "krug", "krug mit saft",
	    "krug mit fruchtsaft" }) );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Fruchtsaft");


  SetProp(P_SHORT, "Ein Krug mit Fruchtsaft");
  SetProp(P_LONG,
    "In diesem Krug wartet leckerer Fruchtsaft darauf getrunken "
    "zu werden.");

  SetProp(P_WEIGHT, 500);       
  SetProp(P_VALUE, 50);         
  SetProp(P_MATERIAL,
      ([ MAT_MISC_STONE : 75, MAT_MISC_FLUID: 25 ]) );      

  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 15,15 }), 
         F_SOAK    : 0,         
         F_DRINK   : 6,         
         F_ALCOHOL : 0,         
         F_POISON  : 0,        
         F_MSG     : BS("Genuesslich trinkst Du den selbstgepressten Saft."),
         F_MSG_ROOM: BS("trinkt genuesslich einen selbstgepressten Saft."),
         F_VERB    : "trinken"    
      ]) );                     
}
