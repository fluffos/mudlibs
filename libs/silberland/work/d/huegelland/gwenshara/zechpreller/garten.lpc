#include "def.h"

inherit "std/room";

int wasser, frucht;

string presskoerper()
{
  if(wasser && !frucht)
    return BS("Der Presskoerper ist mit Wasser gefuellt.");
  else if(frucht && !wasser)
    return BS("Ein paar Fruechte liegen im Presskoerper.");
  else if(frucht && wasser)
    return BS("Im Presskoerper befinden sich Fruechte und Wasser.");
  return BS("Der Presskoerper ist leer.");
}

void create()
{
  ::create();
  wasser = 0;
  frucht = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einem Weingarten");
  SetProp(P_INT_LONG,
    "Du stehst hier in einem kleinen Garten in den Weinbergen von Derlim. "
    "Noerdlich von Dir fuehrt ein Gartentor zurueck in die Weinberge, "
    "waehrend sich oestlich von Dir ein kleines Haeuschen befindet. Rings "
    "um Dich befinden sich Blumen und Weinreben.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_TOWN]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "garten", "gaertchen" }),
    "Du stehst hier in einem kleinen Gaertchen in den Weinbergen Derlims.");

  AddDetail( ({ "weinberge", "weinberg", "weinbergen" }),
    "Du befindest Dich hier in beruehmten Derlimer Weinbergen.");

  AddDetail( ({ "derlim", "stadt", "derlims", "derlimer" }),
    "Die Stadt ist etwas weiter noerdlich von hier.");

  AddDetail( ({ "tor", "gartentor" }),
    "Ein kleines hoelzernes Gartentor fuehrt nach Norden.");

  AddDetail( ({ "haeuschen", "haus" }),
    "Oestlich von hier befindet sich ein kleines Haeuschen, dass Du von "
    "hier aus durch die Einganstuer betreten kannst. Vor dem Haeuschen "
    "befindet sich ein kleiner Brunnen und eine Fruchtpresse.");

  AddDetail( ({ "blumen" }),
    "Viele schoene, bunte Blumen umgeben Dich.");

  AddDetail( ({ "weinreben", "reben" }),
    "Etliche Weinreben wurden in diesem Garten angebaut. Leider tragen sie "
    "noch keine Fruechte.");

  AddDetail( ({ "brunnen" }),
    "Ein kleiner gemauerter Brunnen befindet sich vor dem Haus. An einem "
    "Seil haengt ein Eimer in das Wasser.");

  AddDetail( ({ "tuer", "einganstuer" }),
    "Durch eine kleine Einganstuer kannst das Haeuschen betreten.");

  AddDetail( ({ "presse", "fruchtpresse" }),
    "Eine Fruchtpresse aus Holz steht vor dem Haus. Sie besteht aus einem "
    "Presskoerper, in den Du die Fruechte und etwas Wasser legst, einem "
    "langen Hebel, der sie dann zermatscht und einem Bottich, in dem der "
    "Saft aufgefangen wird.");

  AddDetail( ({ "fruechte" }),
    "Die Reben tragen leider noch keine Fruechte. Wenn Du welche haettest, "
    "koenntest Du sie in der Fruchtpresse mit etwas Wasser auspressen.");

  AddDetail( ({ "seil", "eimer" }),
    "An einem Seil haengt ein Eimer in den Brunnen.");

  AddDetail( ({ "holz" }),
    "Welches Holz genau es ist, weisst Du nicht.");

  AddDetail( ({ "hebel" }),
    "Der Hebel ist aus Holz.");

  AddDetail( ({ "saft", "fruchtsaft", "glaeschen" }),
    "Ein Glaeschen Fruchtsaft waere jetzt lecker." );

  AddDetail( ({ "boden", "kies", "weg", "kiesweg" }),
    "Der Boden besteht hauptsaechlich aus Gras. Ein kleiner Kiesweg fuehrt "
    "zu dem Haeuschen.");

  AddDetail( ({ "gras" }),
    "Saftig gruen.");

  AddDetail( ({"wasser"}),
    "Das Wasser im Brunnen ist glasklar.");

  AddDetail( ({ "himmel", "sonne" }),
    "Die Sonne strahlt Dir vom Himmel entgegen.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst leises Vogelgezwitscher.");

  AddSound( ({ "voegel", "vogel", "gezwitscher", "vogelgezwitscher" }),
    "Draussen zwitschern die Voegel.");

  AddSmell( ({DEFAULT_SMELL, "gras"}),
    "Es riecht nach frischem Gras.");

  AddDetail( ({ "koerper", "presskoerper" }), #'presskoerper);

  AddDetail( ({"bottich"}),
    "Der Bottich ist aus Holz. Neben ihm bemerkst Du ein paar kleinere "
    "Kruege." );
  
  AddDetail( ({"krug", "kruege"}),
    "Wenn man Fruchtsaft gepresst hat, kann man ihn gleich in einen "
    "Krug abfuellen.");

//--Ausgaenge--------------------------------------------------------------

  AddExit( "osten", ZONE "haus_artanok");
  AddExit( "norden", "/d/huegelland/raballion/weinberg/room/apark6" );

//--Items & NPCs-----------------------------------------------------------
  AddItem( "/d/ebene/Park/npc/igel", REFRESH_DESTRUCT );
  AddItem("/gilden/bardengilde/obj/ehrenstatue", REFRESH_DESTRUCT, (["hero": "fraggin"]));

//--Kommandos-------------------------------------------------------------

  AddCmd( ({"fuell", "fuelle"}), "cmd_fuellen" );
  AddCmd( ({"press", "presse",
	    "drueck", "druecke"}), "cmd_pressen" );
}

int cmd_pressen(string str)
{
  object saft;
  notify_fail("Was willst Du pressen?\n");
  if(!str || str == "") return 0;
  if(!(str == "hebel" ||
       str == "saft" ||
       str == "fruchtsaft" ||
       str == "fruechte" ||
       str == "frucht")) return 0;

  notify_fail("Du musst erst Wasser aus dem Brunnen einfuellen!\n");
  if(!wasser) return 0;

  notify_fail("Du musst erst eine Frucht in die Presse fuellen!\n");
  if(!frucht) return 0;

  write(BS("Du drueckst den Hebel kraeftig nach unten und presst "
	   "leckeren Fruchtsaft mit der Presse, den Du gleich in "
	   "einen Krug abfuellst."));
  say(BS(TPN+" druckt den Hebel der Fruchtpresse nach unten und "
      "fuellt Fruchtsaft in einen Krug."));

  saft = clone_object(ZONE "saft");
  if(saft->move(TP, M_GET) != 1)
  {
    write(BS("Du stellst den Krug ab."));
    say(BS(TPN+" stellt den Krug ab."));
    saft->move(TO, M_PUT|M_NOCHECK);
  }

  wasser = 0;
  frucht = 0;

  return 1;
}

int cmd_fuellen(string str)
{
  string what, where;
  object ob;
  notify_fail("Was willst Du wohin fuellen?\n");
  if(!str || str == "") return 0;
  if(sscanf(str, "%s in %s", what, where) != 2) return 0;

  if((what == "wasser" || what == "wasser aus brunnen") &&
     (where == "presse" || where == "koerper" ||
      where == "presskoerper" ))
  {
    if(wasser)
    {
      write(BS("Es ist schon genug Wasser in der Presse!"));
      return -1;
    }
    write(BS("Du fuellst mit dem Eimer etwas Wasser aus dem Brunnen in den "
	     "Presskoerper."));
    say(BS(TPN+" fuellt mit dem Eimer etwas Wasser aus dem Brunnen in die "
	   "Presse."));
    wasser = 1;
    return 1;
  }
  else if(where == "presse" || where == "koerper" ||
          where == "presskoerper")
  {
    if(!objectp(ob=present(what, TP)))
    {
      write(BS("Du hast kein "+CAP(what)+"!"));
      return -1;
    }

    if(!ob->id("\nobst"))
    {
      write(BS(CAP(what)+" ist kein Obst!"));
      return -1;
    }

    if(frucht)
    {
      write(BS("Es ist schon genug Obst in der Presse!"));
      return -1;
    }

    frucht = 1;
    ob->remove(1);

    write(BS("Du legst das Obst in den Presskoerper."));
    say(BS(TPN+" legt Obst in den Presskoerper."));
    return 1;
  }
  else return 0;

  return 1;
}

void reset()
{
  ::reset();
  frucht = 0;
  wasser = 0;
}
