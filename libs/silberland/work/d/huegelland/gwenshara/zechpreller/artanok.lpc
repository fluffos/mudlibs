#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <inpc.h>
#include <new_skills.h>

#include "/gilden/zechpreller/zech.h"

#define MAGIERNAME "gwenshara"
#define CL_HOBBIT  "hobbit"
#define ZONE       "/d/huegelland/gwenshara/zechpreller/"

inherit "std/npc";
inherit "/std/npc/spells";

string fertigkeiten()
{
  call_other("/gilden/zechpreller", "faehigkeiten");
  return "sagt: Net war?\n";
}

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Artanok der Weltreisende");
  SetProp(P_LONG,
    "Artanok sieht aus wie ein Hobbit in den Endvierzigern. In seinen Augen "
    "funkelt der Schalk und er laechelt Dich freundlich an. Sein volles, "
    "schwarzes Haar ist hobbitartig gelockt. Etwas merkwuerdig ist, dass "
    "von ihm staendig eine gewisse Alkoholfahne ausgeht.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Artanok");
  SetProp(P_GENDER, MALE);
  AddId(({"artanok", "hobbit", "halbling", "weltreisende", "weltreisender",
	  "NOWIMPY", "NOCONTROL"}));
  AddClass( ({CL_HOBBIT}) );
  SetProp(P_ARTICLE, 0);

  set_living_name("artanok");

//--Eigenschaften----------------------------------------------------------

  create_default_npc(50);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 120);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 10);
  SetProp(P_GUILD, "zechpreller");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" destilliert @WEN zu purem Alkohol!\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:     -0.3, DT_WATER:      -0.3,
       DT_AIR:      -0.2, DT_LIGHTNING: 0.1, DT_EXPLOSION:   0.15,
       DT_SOUND:     0.1, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0,
       DT_ACID:     -0.3, DT_POISON:   -0.1, DT_TERROR:      0.1,
       DT_HOLY:      0.0, DT_UNHOLY:    0.1, DT_MAGIC:       0.0,
       DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Tod--------------------------------------------------------------------

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Du hast einen <HICKS!> Gildenerben besiegt?!");
  SetProp(P_KILL_MSG, 
          "Wenn Du mal mein Alter hascht, <HICKS!>, komm wieheider!");

//--Infos------------------------------------------------------------------

  SetProp(P_LOG_INFO, "gwenshara/artanok.loh");
  AddInfo(DEFAULT_INFO, "sagt: Das weiss ich leider nicht.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

  AddLibrary("/gilden/zechpreller/npc/zechus.lib", 5);
  AddLibrary("/d/huegelland/raballion/hobbits/npc/infos.lib", 1);

  AddInfo( ({"beitritt","beitreten","funktionen","lernen","siebzehner",
	     "schluessel","siebzehnerschluessel"}),
    "Das machst Du besser bei Zechus Prellus in Kyranda.",
    "sagt: ");

  AddInfo( ({"welt", "reisen"}),
    "Ich war schon auf der gantschen Welt! <HICKS!> In allen Regionen", 
    "sagt: ");

  AddInfo( ({"region", "regionen"}),
   "Ueber welche Region <HICKS!> magscht was wisschen?", "fragt: ");

  AddInfo( ({"astral", "astralebene"}),
   "Die ischt sehr scheltscham. Elsurion in Titschara weiss wie man da "
   "hinkommt!", "sagt: ");

  AddInfo( ({ "dschungel" }),
    "Der Dschungel *seufz* Dort ischts wirkl <HICKS!> ich huebsch! Dort "
    "hab ich viele Abenteuer bestanden!", "sagt: " );

  AddInfo( ({ "ebene" }),
    "In der Ebene liegt Midas! Dort war ich auch schon mal! <HICKS!> "
    "Sehr flach dort.", "sagt: " );

  AddInfo( ({ "gebirge" }),
    "Mein alter Freund Tarxes kommt von dort. Er schagt dort gibtsch viele "
    "Tschwerge und Trolle.", "sagt: " );

  AddInfo( ({ "huegelland", "derlim" }),
    "Hier sind wir. Das hier ischt meine Heimat Der<HICKS!>lim.", "sagt: " );

  AddInfo( ({ "kristallwald" }),
    "Der liegt noerdlich von hier. Einfach der Schtrasche aus Derlim rausch "
    "nach!", "sagt: " );

  AddInfo( ({ "luft" }),
    "Die atmet man! <HICKS!>", "sagt: " );

  AddInfo( ({ "polar", "polarkreis" }),
    "Dasch isch noch weiter im <HICKS!> Norden. Meine gute Freundin Lanestra "
    "war mal dort. Ich hab dort die Kschandimsch besucht!", "sagt: " );

  AddInfo( ({ "unterwelt" }),
    "Die <HICKS!> isch unter unsch. Dort leben die Dunkelelfen. Ich kann Dir "
    "sagen, dassch es dort scher dunkel ischt.", "sagt: " );

  AddInfo( ({ "wasser", "meer" }),
    "Viele Schiffe fahren dort herum.", "sagt: " );

  AddInfo( ({ "wueste" }),
    "Mein alter Freund Tarxes ischt dort hin gezogen.", "sagt: " );

  AddInfo( ({ "gruender", "gildengruender" }),
    "Zusammen mit meinen Freunden Lanestra, Tarxes und Zechus haben wir die "
    "<HICKS!> Zechpreller gegruendet.", "sagt: " );

  AddInfo( ({ "lanestra" }),
    "Dasch is eine alte Freundin von mir. Wir schreiben ab und tschu noch "
    "Briefe. Sie lebt irgendwo im Kristallwald.", "sagt: " );

  AddInfo( ({ "tarxes" }),
    "Aaaah! Der gute alte <HICKS!> Tarxes. Ein echter Prachtzwerg. Er ist mit "
    "ein paar anderen Zwergen in die Wueste gezogen.", "sagt: " );

  AddInfo( ({ "zechus", "prellus" }),
    "Zechus Prellus der alte Hund! Er leitet unsere Gilde seit einigen Jahren. "
    "Du findescht ihn in Kyranda! <HICKS!>", "sagt: " );

  AddInfo( ({ "erbe", "gildenerbe" }),
    "Wenn ein Zechpreller die Zechmeisterschaft erreicht hat, dann kann er ... "
    "oder schie ... ein Gildenerbe antreten. Bei meinem Erber erlernt man, "
    "<HICKS!> scho wie ich tschu improvisieren! Ausscherdem ergruendet "
    "man die tiefen Geheimnisse der Destillation und lernt eine kaempfende "
    "Allholwolke zu rufen.", "sagt: " );

  AddInfo( ({ "abenteuer", "geschichte" }),
    "Vor langer Zeit, als ich noch jung war, ging ich auf Abenteuerfahrt.", 
    "sagt: " );

  AddInfo( ({ "fahrt", "abenteuerfahrt" }),
    "Ich lernte gute Freunde kennen <HICKS!> und stellte mich vielen "
    "Herausforderungen!", "sagt: " );

  AddInfo( ({ "herausforderungen" }),
    "Ich stellte mich Bingo, dem Anfuehrer unserer Stadtwache, Molkine, "
    "die Klauenbetie, die Reisserbestie, den grossen Azidozok, den "
    "Waffenhaendler Shagraz und zu guter Letzt den Elfenzauberer Elsurion!", 
    "sagt: " );

  AddInfo( ({ "bigno", "molkine" }),
    "Bingo und Molkine findescht Du in Derlim!", "sagt: " );

  AddInfo( ({ "klauenbestie", "reisserbestie" }),
    "Diesche vieschen Fiecher befinden sich <HICKS!> in Knarkh, wo auch die "
    "Knarkhwurscht herkommt!", "sagt: " );

  AddInfo( ({ "azidozok" }),
    "Azidotschok ist ein alter Sauerdrache. Irgendwo am Meer gibtsch scho eine "
    "Inschel mit lauter Tschumbies drauf, da isch er!", "sagt: " );

  AddInfo( ({ "shragraz" }),
    "Der alte Schagratsch. Der Ork lebt in Titschara und betreit <HICKS!> dort "
    "einen Waffenladen.", "sagt: " );

  AddInfo( ({ "elsurion" }),
    "Elsurion ischt ein maechtiger Elfenzauberer. Irgendwie sind die <HICKS!> "
    "Druiden sauer auf ihn. Er weisscht viel ueber die Astralebene und "
    "dasch Trinkeramulett.", "sagt: " );

  AddInfo( ({ "amulett", "trinkeramulett" }),
    "Dasch hab ich versteckt, damit meine Gildenerben esch wieder finden koenn"
    "en und scho <HICKS!> beweischen, dass sie mein Erbe wuerdig sind.", 
    "sagt: " );

  AddInfo( ({"frucht", "fruechte", "obst"}),
    "Verian hat sehr gutes Obst um daras Saft zu machen!", "sagt:" );

  AddInfo( ({"xandim", "kschandim"}),
    "Dort hab isch <HICKS!> mein Buch geschrieben!", "sagt: ");

  AddInfo( ({"buch"}),
    "Esch heisscht: Ich bei den Xandim oder 1000 Worte fuer Schnee!", 
    "sagt: ");

  AddInfo( ({"faehigkeiten", "fertigkeiten"}),
    #'fertigkeiten );

  AddInfo( ({"kyranda"}),
   "Kyranda ischt eine <HICKS!> Feschtung nordoestlich von Midas! Aber "
   "pasch auf die Ooooger auf!", "sagt: ");

  AddInfo( ({"met", "rezept", "metrezept"}),
    "Dasch kriegst bei Zechus in Kyranda!", "sagt: ");

  AddInfo( ({"wein", "alkohol"}),
    "Wein ist der beste <HICKS!> Alkohol!", "sagt: " );

  AddInfo( ({"meisterschaft", "zechprellermeisterschaft"}),
    "Die hast Du erreicht, wennscht Gildenstufe 10 hascht!", "sagt: ");

  AddInfo( ({"zechpreller"}),
    "Ich bin ein gruender der Zechpreller! Unscher <HICKS!> Gildenhaus "
    "findest Du in Kyranda bei Zechus Prellus!", "sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 75);

  AddSpell(1,1400,
    "Artanok haucht Dich an.\n",
    "Artanok haucht @WEN an.\n",
    DT_POISON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,600,
     "Artanok ruelpst Dir ins Gesicht.\n",
     "Artanok ruelpst @WEM ins Gesicht.\n",
     DT_SOUND,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,900,
     "Artanok wirft eine leere Flasche nach Dir.\n",
     "Artanok wirft eine leere Flasche nach @WEM.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 1,
     "Artanok destilliert einen Teil Deiner Ausruestung.\n",
     "Artanok destilliert einen Teil von @WESSEN Ausruestung.\n", 
     DT_MAGIC, "destillieren");
  AddSpell(1, 700,
    "Artanok uebertraegt einen Teil seines Alkohols auf Dich!\n",
    "Artanok uebertraegt einen Teil seines Alkohols auf @WEN!\n",
    ({DT_MAGIC, DT_POISON}), "alkoholisieren", ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 300, DS_MASS_DAMAGE,
    "Artanok kugelt sich am Boden herum.\n",
    "Artanok kugelt sich am Boden herum.\n",
    ({DT_SQUEEZE}));
  AddSpell(1, 200,
    "Artanok groehlt Dir schreckliche Trinklieder entgegen!\n",
    "Artanok grohelt @WEM schreckliche Trinklieder entgegen!\n",
    ({DT_SOUND}), "groehlen", ([SP_SHOW_DAMAGE:1]));

//--Ausruestung------------------------------------------------------------

  SUID;
  CLONEME( ZONE "artanok_weapon" );
  command("zuecke artanokwaffe");

  CLONEME( "/gilden/zechpreller/obj/z_17erschluessel" );
  CLONEME("/d/wueste/gwenshara/echsendorf/armour/zech_ring");
  CLONEME( "/p/armour/belt/guertel" );
  CLONEME(  "/p/armour/boots/lederstiefel" );
  command("trage alles");
}

mixed _query_noattack()
{
  if(!objectp(TP)) return 0;
  if(TP->QueryProp(P_LEVEL) < 15)
  {
    return "sagt: Mit Dir kaempf ich <HICKS!> nischt!";
  }
  return 0;
}

int _query_alcohol()
{
  return 1000;
}

void die( int poisondeath )
{
  if(present("\nzechpreller_torkeln")) 
    present("\nzechpreller_torkeln")->remove(1);
  if(present("\nzechpreller_panzer"))
    present("\nzechpreller_panzer")->remove(1);
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file( "artanok.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

//--Spellfuns--------------------------------------------------------------

void groehlen(object enemy, int damage, mixed dam_type)
{
  if(!objectp(enemy)) return;
  if(enemy->QueryProp(P_DISABLE_SPELLS) > 0) return;
  enemy->SetProp(P_DISABLE_SPELLS, 4+random(7));          
}

void alkoholisieren(object enemy, int damage, mixed dam_type)
{
  object o;
  if(!objectp(enemy)) return;
  if(!(enemy->QueryProp(P_GUILD) == "zechpreller"))
    enemy->SetProp(P_ALCOHOL, enemy->QueryProp(P_ALCOHOL)+20);
  if(!present("zechpreller_alkoholiker", enemy))
  {
    o = clone_object(OBJ("alkoholiker"));
    if(!objectp(o))
    {
      tell_object(enemy, "FEHLER!!!\n");
      return;
    }
    o->SetVar(6, 300, enemy);
    o->move(enemy);
  }
}

void destillieren(object enemy, int damage, mixed dam_type)
{
  object *i;
  i = enemy->QueryProp(P_ARMOURS);
  i += ({enemy->QueryProp(P_WEAPON)});

  // Drei Items destillieren
  if(sizeof(i)) i[random(sizeof(i))]->TakeFlaw(10);
  if(sizeof(i)) i[random(sizeof(i))]->TakeFlaw(10);
  if(sizeof(i)) i[random(sizeof(i))]->TakeFlaw(10);
  AddHp(random(100));
}

int Defend(int dam, mixed dam_type_list, mixed spell, object enemy)
{
  object o;
  if(!random(6) && !present("\nzechpreller_torkeln"))
  {
    o = clone_object(OBJ("torkeln"));
    o->SetVars(TO, 300, 80);
    o->move(TO);
    tell_room(ENV(TO), "Artanok beginnt zu schwanken!\n");
  }
  if(!random(6) && !present("\nzechpreller_panzer"))
  {
    o = clone_object(OBJ("dunstmantel"));
    o->SetVars(300, 40);
    o->move(TO);
    tell_room(ENV(TO), "Um Artanok bildet sich ein Dunstpanzer!\n");
    command_me("ziehe dunstpanzer an");
  }
  if(!random(3) && !present("\nzechpreller_weingeist_artanok", ENV(TO)))
  {
    o = clone_object(NPC("weingeist"));
    o->SetMaster(TO, 10000, 10000);
    o->AddId("\nzechpreller_weingeist_artanok");
    tell_room(ENV(TO), "Artanok ruelpst laut!\n");
    o->move(ENV(TO), M_TPORT);
    o->FindAndKill();
  }
  if(!random(3) && !present("\nzechpreller_wolke_artanok", ENV(TO)))
  {
    o = clone_object(OBJ("wolke"));
    o->AddId("\nzechpreller_wolke_artanok");
    tell_room(ENV(TO), "Artanok atmet eine Alkoholwolke aus!\n");
    o->move(ENV(TO), M_TPORT);
    o->SetVars(TO, 300, 300);
    o->fight();
  }

  return ::Defend(dam, dam_type_list, spell, enemy);
}

void change_weapon()
{
  object ob;

  if(objectp(ob=present("artanokwaffe", TO)))
  {
    tell_room(ENV(TO), BS(Name(WER)+" destilliert "+ob->Name(WEN)+"."));
    ob->remove(1);
  }

  CLONEME(ZONE "artanok_weapon");
  command("zuecke artanokwaffe");
  return;
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();
  change_weapon();
}
