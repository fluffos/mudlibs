#include "def.h"
#include "/gilden/zechpreller/zechpreller_extern.h"

inherit "std/weapon";

string weapon_type;
int weight, wc_fix, wc;
string dlong, dshort;

mixed *set_weapon_attributes();

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

//--Namen------------------------------------------------------------------

  AddId( ({"artanokwaffe", ""}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_VALUE, 6666);
  SetProp(P_NOBUY, 1);
  SetProp(P_ARTICLE, 0);

//--Waffentypische Eigenschaften-------------------------------------------

  SetProp(P_QUALITY_DECAY, 100);
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WC_BONUS, (["artanok":150 ]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:21, A_STR:21]) );

//--Details----------------------------------------------------------------

  SetProp(P_INFO, BS("Ein Zechpreller fuehrt diese Waffe als Keule!"));

  set_weapon_attributes();

  SetProp(P_ZECHPRELLER_SPELLCOST, 10);
  SetProp(P_ZECHPRELLER_BONUS, 10);
  SetProp(P_ZECHPRELLER_REDUCE_ALC, 10);
  SetProp("itemd_nomagic", 1);
}

int IsWieldedByZechi()
{
  object ob;
  if(!objectp(ob=QueryProp(P_WIELDED)))
    ob = TP;
  if(ob->QueryProp(P_GUILD) == "zechpreller")
      return 1;
  return 0;
}

int _query_weight()
{
  return weight;
}

int _query_wc()
{
  return (int) (IsWieldedByZechi()?wc*1.1:wc);
}

int _query_wc_fix()
{
  return (int) (IsWieldedByZechi()?wc_fix*1.2:wc_fix);
}

string _query_short()
{
  return dshort;
}

string _query_long()
{
  return dlong;
}

string _query_name()
{
  return dshort;
}

string _query_weapon_type()
{
  return (IsWieldedByZechi()?WT_CLUB:weapon_type);
}

mixed *set_weapon_attributes()
{
  switch(random(6))
  {
    case 0: weight = 5500;
	    wc     = 257;
	    wc_fix = 15;
	    dshort = "Artanoks Streitaxt";
            dlong  = BS("Die Streitaxt besitzt zwei Axtblaetter und wird daher "
			"auch Doppelaxt genannt. Beide Blaetter sind stark "
			"gekruemmt, um eine bessere Schneidwirkung zu "
			"erreichen. Dazwischen befindet sich ein langer Dorn. "
                        "Um besseren Halt zu gewaehren, ist der Metallstiel "
			"mit Fellstuecken umwickelt, was der ganzen Axt ein "
			"barbarisches Aussehen verleiht. Auch die kleinen "
			"Blutspritzer auf dem Axtblatt zeigen, dass diese "
			"Waffe nur fuer den Kampf gefertigt wurde.");
	     AddId( ({"streitaxt", "axt", "artanoks streitaxt"}) );
             weapon_type = WT_AXE;
	     break;
    case 1: weight = 7500;
	    wc     = 266;
	    wc_fix = 10;
	    dshort = "Artanoks Trippelstern";
            dlong  = BS("Der Trippelstern besitzt, wie man dem Namen nach "
			"schon vermuten kann, drei stachelbesetzte Eisenkugeln "
			"an langen Ketten. Man muss schon viel Kraft und "
			"Geschick besitzen, um diese Waffe schwingen zu "
			"koennen, aber es braucht noch viel mehr "
			"Kampferfahrung, um alle drei Kugeln effektiv "
			"einzusetzen. Der Legende nach gab es frueher einmal "
			"Krieger, die nicht nur alle drei Kugeln gegen einen "
			"Gegner einsetzen konnten, sondern auch drei Feinde "
			"mit je einer Kugel treffen konnten.");
	    AddId( ({"stern", "trippelstern", "artanoks trippelstern"}) );
        weapon_type = WT_CHAIN;
	    break; 
    case 2: weight = 450;
	    wc     = 130;
	    wc_fix = 55;
	    dshort = "Artanoks Meucheldolch";	    
            dlong  = BS("Der Meucheldolch ist eine toedliche Waffe. Die lange "
			"und sehr spitze Klinge kann den Gegner mit einem "
			"Stich toeten, denn sie ist so schmal, dass sie ohne "
			"viel Widerstand tief in den Koeper eindringen kann. "
                        "Im Griff sind einige Kerben eingeritzt.");
             weapon_type = WT_KNIFE;
	     SetProp(P_NR_HANDS, 1);
	     AddId( ({"dolch", "meucheldolch", "artanoks meucheldolch"}) );
	     break;
    case 3: weight = 3000;
	    wc     = 210;
	    wc_fix = 15;
	    dshort = "Artanoks Pike";	    
            dlong  = BS("Die Pike ist ein ueberlanger Speer mit einer langen, "
			"metallenen Spitze. Am Besten setzt man sie im Kampf "
			"gegen Reiter oder sehr grosse, wilde Tiere ein.");
             weapon_type = WT_SPEAR;
	     AddId( ({"pike", "artanoks pike"}) );
	     break;
    case 4: weight = 2500;
	    wc     = 202;
	    wc_fix = 35;
	    dshort = "Artanoks Zweihaender";
            dlong  = BS("Der Bihaender, auch Zweihaender genannt, ist ein "
			"maechtiges, zweihaendiges Schwert, mit einer fast "
			"mannslangen Klinge. Man braucht schon eine gewisse "
			"Groesse und ziemlich viel Kraft, um mit dieser Waffe "
			"vernuenftig umgehen zu koennen. Die Parierstange ist "
			"sehr breit und der Griff fuer besseren Halt mit einem "
			"blauen Tuch umwickelt. Der Knauf stellt einen "
			"Drachenkopf dar.");
             weapon_type = WT_SWORD;
	     AddId( ({"schwert", "zweihaender", "artanoks zweihaender"}) );
	     break;
    default: weight = 1000;
	     wc     = 200;
	     wc_fix = 10;
	     dshort = "Artanoks Peitsche";	    
             dlong  = BS("Die Peitsche besteht eigentlich nur aus einer "
			 "langen Lederschnut, die an einem Griff befestigt "
			 "ist.");
             weapon_type = WT_WHIP;
	     SetProp(P_NR_HANDS, 1);
	     AddId( ({ "peitsche", "artanoks peitsche" }) );
	     break;	     
  }

  return ({weight, wc, wc_fix, dshort, dlong, weapon_type});
}
