#include "../def.h"

inherit "/std/room";

public void create()  {
  ::create();

  SetProp( P_INT_SHORT, "Am Vorplatz eines Anwesens" );
  SetProp( P_INT_LONG,
    "Vor dir erstreckt sich ein kleiner Platz. In der Mitte steht ein Brunnen "
    "aus Stein und hinter dir erhebt sich eine Gartenmauer samt Tor. Gegenueber "
    "steht das Anwesen, welches das gesamte Grundstueck dominiert. Vom Platz "
    "weg fuehrt ein Weg um das Haus herum." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "platz", "platzes", "boden" }),
    "Der Platz, auf dem du stehst, wurde mit feinem Kies ausgestreut. Er ist "
    "so gross, dass sogar ein Pferd um den Brunnen in der Mitte wenden "
    "koennte.");

  AddDetail( ({ "mitte" }),
    "In der Mitte des Platzes wurde ein Brunnen errichtet.");

  AddDetail( ({ "brunnen", "springbrunnen" }),
    "Es handelt sich um einen einfachen Springbrunnen. Umgeben von Wasser "
    "spuckt ein Frosch einen Wasserstrahl in die Luft, der dann wieder "
    "platschend im Wasser landet.");

  AddDetail( ({ "stein" }),
    "Der Brunnen wurde aus Granit geschlagen.");

  AddDetail( ({ "mauer", "gartenmauer" }),
    "Die Gartenmauer umgibt das Grundstueck. Durch das Tor kannst du sie "
    "durchschreiten.");

  AddDetail( ({ "anwesen", "haus", "fachwerkhaus" }),
    "Das Anwesen, das sich vor dir erhebt wurde als einstoeckiges Fachwerkhaus "
    "erbaut. Durch ein hoelzernes Eingangstor kannst du es betreten.");

  AddDetail( ({ "grundstueck" }),
    "Du befindest dich hier auf dem Grundstueck. Es wird von einer Mauer "
    "abgegrenzt und beheimatet ein ansehnliches Anwesen.");

  AddDetail( ({ "weg", "kiesweg" }),
    "Ein einfacher, gestreuter Kiesweg fuehrt rund um das Haus nach Nordosten "
    "und Suedosten weiter in den Garten.");

  AddDetail( ({ "kies" }),
    "Ein feiner, weisser Kies wurde hier ausgestreut.");

  AddDetail( ({ "pferd" }),
    "Es ist gerade keines da. Aber es waere genug Platz, dass man mit meinem "
    "Pferd um den Brunnen reiten koennte.");

  AddDetail( ({ "wasser" }),
    "Im Brunnen plaetschert sanft das Wasser vor sich hin, wenn es in einem "
    "hohen Strahl aus dem Maul des Frosches nach unten faellt.");

  AddDetail( ({ "frosch" }),
    "Der Frosch wurde sehr naturgetreu nachgebildet. Er blickt nach oben, "
    "in den Himmel, und spuckt einen Wasserstrahl. Eine kleine Krone wurde auf "
    "sein Haupt gemeisselt.");

  AddDetail( ({ "strahl", "wasserstrahl" }),
    "In einem hohen Bogen reicht er in den Himmel, um dann platschend im "
    "Wasser zu landen.");

  AddDetail( ({ "bogen" }),
    "Der Wasserstrahl fliegt in einem hohen Bogen gen Himmel.");

  AddDetail( ({ "luft" }),
    "Die Luft umgibt dich allgegenwaertig. Sonst koenntest du auch nicht atmen.");

  AddDetail( ({ "granit" }),
    "Grauer, harter Stein.");

  AddDetail( ({ "garten" }),
    "Abseits des Platzes findest du dich im Garten wieder. Wenn du dem Weg "
    "folgst, wirst du dort landen.");

  AddDetail( ({ "maul", "froschmaul" }),
    "Der Wasserstrahl wird aus dem Froschmaul geschossen. So kannst du ihn "
    "leider nicht kuessen.");

  AddDetail( ({ "krone" }),
    "Auch diese ist sehr detailgetreu. Sie sieht ganz so aus, als koennte es "
    "eine echte sein. Nur, dass sie eben aus Stein ist.");

  AddDetail( ({ "haupt", "kopf" }),
    "Am Kopf des Frosches befindet sich eine Krone.");

  AddDetail( ({ "himmel" }),
    "Ueber dir erstreckt sich der blaue, leichtbewoelkte Himmel.");

  AddDetail( ({ "eingangstor", "holztor" }),
    "Das Eingangstor zum Anwesen ist ein riesiges Holztor im Osten. Es steht "
    "offen, und somit kannst du einfach eintreten.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Plaetschern des Brunnens.");

  AddSound( ({ "plaetschern", "brunnen" }),
    "Das Plaetschern entsteht, wenn der Wasserstrahl des Frosches wieder im "
    "Brunnen landet. Du glaubst neben dem Plaetschern ein leises Quaken zu "
    "hoeren.");

  AddSound( ({ "quaken" }),
    "Koennte es sein, dass das gar ein echter, versteinerter Frosch ist?");

  AddSound( ({ "frosch" }),
    "Nichts zu hoeren... komisch.");

  NewDoor("westen", ROOM "garten_c2", ({"tor", "gartentor"}),
          ({
            D_LONG,
              "Dieses Tor ist etwa drei Schritt hoch und besteht aus geschmiedeten "
              "Gitterstaeben.",
            D_SHORT, "Im Westen befindet sich ein %s Gartentor.",
            D_GENDER, NEUTER,
            D_NAME, "Tor"
          }));
  AddExit( "nordosten", ROOM "garten_e1" );
  AddExit( "suedosten", ROOM "garten_e3" );
  AddExit( "osten", ROOM "erdgeschoss_a2" );

  AddCmd( "kuesse|kuess|knutsche|knutsch&frosch|prinz", "cmd_kuessen", "Wen willst du kuessen?");
}

public int cmd_kuessen(string args) {
  object tp;
  tp = this_player();

  tp->Message(BS("Du kuesst den Frosch. Nichts passiert. Wohl doch kein Prinz :("));
  Message(BS(tp->Name(WER)+" kuesst den Frosch."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

  return 1;
}
