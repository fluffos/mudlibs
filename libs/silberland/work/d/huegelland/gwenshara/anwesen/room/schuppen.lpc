#include "../def.h"

inherit "/std/room";

private nosave int ei;

private void configureEnvironment() {
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );
}

private void addDescriptions() {
  SetProp( P_INT_SHORT, "In einem Huehnerstall" );
  SetProp( P_INT_LONG,
    "Hier stehst du in einem kleinen Huehnerstall. Die Waende "
    "wurden aus einfachen Holzbrettern zusammengezimmert. Einige Stangen "
    "wurden an ihnen montiert, damit die Huehner einen Ort haben, um sich "
    "zu setzen. Am Boden haben sich die Huehner aus Heu und Stroh ein paar "
    "kleine Nester gebaut." );
  

  AddDetail( ({ "" }),
    "");


  AddSound( DEFAULT_SOUND,
    "Ab und an hoerst du das Gackern eines Huhns und das Ruetteln des Winds an den Brettern.");

  AddSound( ({ "gackern", "huhn", "huehner" }),
    "Pock, pock! Gluck! Gluck!");

  AddSound( ({ "wind", "ruetteln", "bretter", "brettern" }),
    "Du bist dir ganz sicher. Es handelt sich nur um den Wind der an den Brettern ruettelt.");

  AddSound( ({ "summen", "sammeln", "luft"}),
    "*summ* *summ* *summ*");

  AddSmell( DEFAULT_SMELL,
    "Es stinkt nach Huehnerdreck.");

  AddSmell( ({"dreck", "huehnerdreck"}),
    "Riecht so, als waere as mal wieder Zeit den Stall auszumisten.");
}

private void addCommands() {
  AddCmd( "durchsuche|durchsuch|suche|such&nest|nester|huehnernest|huehnernester", "cmd_durchsuchen", "Was willst du durchsuchen?\n");
}

private void resetRoomState() {
  ei = 1 + random(3);
}

public void create()  {
  ::create();
  resetRoomState();  

  configureEnvironment();
  addDescriptions();
  addCommands();

  AddExit( "raus", ROOM "garten_f3" );
}

public void reset() {
  ::reset();
  resetRoomState();
}

public int cmd_durchsuchen() {
  string found;
  object eggs;

  if(ei > 0) {
    found = " und findest ein paar Huehnereier, die du sofort einsteckst.";
  } else {
    found =". Leider findest du keine Eier. Vielleicht brauchen die Huehner noch etwas mehr Zeit?";
  }
  
  TP->Message(BS(sprintf("Du durchsuchst die Nester am Boden%s", found)));
  Message(BS(sprintf("%s wuehlt in den Huehnernestern.", TP->Name(WER, 1))), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  
  for(;ei>0;--ei) {
    eggs = clone_object(OBJ "ei");
    if(eggs->move(TP, M_GET) != 1) {
      TP->Message(BS("Du kannst gerade nicht alle Eier tragen und laesst ein paar zurueck."));
      break;
    }
  }

  return 1;
}
