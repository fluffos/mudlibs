
#include "../def.h"

inherit "std/room";

#include <properties.h>

int last_time_lantern_lit = 0;

void create() 
{
  ::create();

  SetProp( P_INT_SHORT, "Ein weisser Kiesweg" );
  SetProp( P_INT_LONG,
    "Du befindest dich hier auf einem einfach weissen Kiesweg, der durch die "
    "Wiesen fuehrt. Abseits des Weges bluehen einige Wiesenblumen. Auf dem "
    "Weg selbst wurde alle paar Schritte eine Laterne aufgestellt. Weiter "
    "im Nordosten kannst du eine Mauer, sowie ein Tor darin erkennen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "weg", "kiesweg", "boden" }),
    "Hier wurde ein Weg aus feinen, weissen Kieselsteinen angelegt. Abseits "
    "des Kieswegs befindet sich die Wiese und alle paar Schritt wurde eine "
    "Laterne gesetzt.");

  AddDetail( ({ "wiesen", "wiese", "landschaft" }),
    "Auf den ersten Blick scheint dir die Wiese vollkommen naturbelassen. "
    "Allerdings erkennst du nach ein paar Momenten, dass die Blumen keinesfalls "
    "zufaellig arrangiert sind. Ausserdem wurde die Wiese sauber gemaeht. "
    "Es scheint so, als waere hier ein faehiger Landschaftsgestalter am Werk "
    "gewesen.");

  AddDetail( ({ "blumen", "wiesenblumen" }),
    "Verschiedene Blumen, wie sie in der freien Natur auf Wiesen vor kommen.");

  AddDetail( ({ "schritt", "schritte" }),
    "Die Laternen wurden etwa im Abstand von einem Schritt eingegraben.");

  AddSpecialDetail( ({ "laterne", "laternen" }),
    "detail_laterne");

  AddDetail( ({ "mauer", "backsteinmauer" }),
    "Im Nordosten befindet sich eine Backsteinmauer. Wenn du mehr wissen "
    "moechtest, muss du naeher gehen.");

  AddDetail( ({ "tor" }),
    "Das Tor im Nordosten ist von hier nicht gut zu erkennen.");

  AddDetail( ({ "steine", "kieselsteine", "kies", "steinen" }),
    "Der Kies auf dem Weg besteht aus kleinen, weisen Steinen. Sie wurden "
    "feinsaeuberlich geraecht, damit auch keiner von ihnen aus der Reihe "
    "tanzt.");

  AddDetail( ({ "moment", "momenten", "moment" }),
    "Hier und jetzt.");

  AddDetail( ({ "gestalter", "landschaftsgestalter" }),
    "Das ist sowas, wie ein Gaertner, nur eben auf Landschaften spezialisiert.");

  AddDetail( ({ "werk" }),
    "Diese Landschaft ist das Werk eines echt berfuenen Gaertners. Sieh sieht "
    "vollkommen natuerlich aus, ist jedoch kuenstlich angelegt.");

  AddDetail( ({ "natur", "form" }),
    "Du befindest dich hier in einer Form der Natur, wenn auch sehr "
    "gepflegt.");

  AddDetail( ({ "abstand" }),
    "Etwa ein Schritt.");

  AddDetail( ({ "himmel"}),
    "Der Himmel strahlt dich blau an.");

  AddDetail( ({ "reihe" }),
    "Alle Steine hier liegen genau da, wo sie sein sollten.");

  AddDetail( ({ "gaertner" }),
    "Jemand, der sich eben um Blumen und Wiesen kuemmert.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise Rauschen des Windes in der Wiese.");

  AddSound( ({ "wind", "wiese", "rauschen" }),
    "Das sanfte Rauschen wirkt irgendwie beruhigend.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Wiese.");

  AddSmell( ({ "wiese" }),
    "Leicht blumig mit einer Note nach Heu.");

  AddSmell( ({ "heu", "note" }),
    "Angenehm.");

  AddCmd( "zuende|zuend&laterne|laternen&an", "cmd_anzuenden", "Was willst du anzuenden?" );

  AddExit( "westen", ANSCHLUSS );
  AddExit( "nordosten", ROOM "garten_c2");
}

int isLanternBurning()
{
    return time() < last_time_lantern_lit + 120;
}

int cmd_anzuenden(string arg)
{
    if(isLanternBurning()) {
        tell_object(TP, BS("Aber die Laternen brennen doch noch.\n"));
        return -1;
    }

    last_time_lantern_lit = time();
    TP->AddSp(-5);

    TP->Message("Du zuendest die Laternen an.\n", MSGFLAG_SENSE);
    Message(BS(TP->Name(WER) + " zuendet die Laternen an.\n"), MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    return 1;
}

string detail_laterne(string key)
{
    if(isLanternBurning()) {
        return "Die Laternen wurden vor kurzem angezuendet.\n";
    } 
    
    return "Die Laternen sind derzeit nicht angezuendet.\n";
}