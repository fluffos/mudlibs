
#include "../def.h"

inherit "/std/room";

public void create()  {
  replace_program("/std/room");
  ::create();

  SetProp( P_INT_SHORT, "An einem Grundstueckstor" );
  SetProp( P_INT_LONG,
    "Hier erhebt sich eine etwa drei Schritt hohe Grundstuecksmauer. Hinter "
    "der Mauer scheint ein Anwesen samt umliegendem Garten zu sein, welches "
    "einen gepfelgten Eindruck macht. In der Mauer befindet sich ein groesses "
    "Gartentor, durch das man das Grundstueck betreten kann." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( ({ "schritt" }),
    "So weit, wie deine Fuesse beim Gehen eben auseinander sind.");

  AddDetail( ({ "mauer", "grundstuecksmauer", "mauerwerk" }),
    "Die Mauer wurde aus rotem Backstein errichtet und hat etwa zwei Schritt "
    "Hoehe. Die Fugen sind mit weiss-grauem Moertel ausgefuellt und stellenweise "
    "haben Ranken das Mauerwerk eingehuellt.");

  AddDetail( ({ "anwesen", "haus", "fachwerkhaus" }),
    "Durch das Tor erkennst du ein ansehnliches Anwesen. Es ist ein "
    "zweistoeckiges Fachwerkhaus, das, abgesehen vom Holz, weiss getuencht "
    "wurde. Den Ausmassen nach scheint es von wohlhabenderen Leuten bewohnt "
    "zu werden.");

  AddDetail( ({ "garten", "grundstueck" }),
    "Der Garten hinter der Mauer (oder durch das Tor) ist einigermassen "
    "gepflegt. Ein Kiesweg fuehrt, um einen Brunnen herum, zu dem Anwesen, "
    "waehrend sich rings um das Haus eine Wiese erstreckt.");

  AddDetail( ({ "eindruck" }),
    "Das gesamte Grundstueck macht durchaus einen gepflegten Eindruck. Nicht "
    "ganz ordentlich, aber mit einer Prise absichtlicher Verwilderung.");

  AddDetail( ({ "fuesse", "beine", "beinen" }),
    "Sieht so aus, als waren alle deine Fuesse da, wo sie sein sollen.");

  AddDetail( ({ "gehen" }),
    "Eine Taetigkeit, die du in der Regel mit deinen Beinen verrichtest.");

  AddDetail( ({ "regel "}),
    "Ist meistens so.");

  AddDetail( ({ "backstein", "stein" }),
    "Rote, gebackene Steine eben. Auch Ziegel genannt.");

  AddDetail( ({ "hoehe" }),
    "Du schaetzt die Mauer auf eine Hoehe von etwa zwei Schritt. Gerade so hoch, "
    "dass du nicht einfach drueber springen kannst.");

  AddDetail( ({ "fugen" }),
    "Die Fugen zwischen den Backsteinen werden vom Moertel gebildet.");

  AddDetail( ({ "moertel", "masse" }),
    "Diese weiss-graue, trockene Masse haelt die ganze Mauer zusammen-");

  AddDetail( ({ "ranken", "schlingpflanzen" }),
    "Die Ranken von Schlingpflanzen winden sich entlang der Mauer nach oben.");

  AddDetail( ({ "holz", "eiche", "silbereiche" }),
    "Lokaluebliche Silbereiche.");

  AddDetail( ({ "ausmassen" }),
    "Gross genug fuer wohlhabendere Leute.");

  AddDetail( ({ "leute" }),
    "Vermutlich sind die im Haus.");

  AddDetail( ({ "kiesweg", "boden" }),
    "Am boden schlaengelt sich ein Kiesweg entlang, der wahlweise durch das "
    "Tor oder nach Suedweten fuehrt.");

  AddDetail( ({ "brunnen" }),
    "Dazu musst du naeher ran gehen.");

  AddDetail( ({ "wiese" }),
    "Die ist hinter der Mauer. Von hier aus erkennst du nur das saftige Gruen.");

  AddDetail( ({ "prise", "menge" }),
    "Eine kleine Menge, die sich gewoehnlich zwischen zwei Fingern zerreiben "
    "laesst.");

  AddDetail( ({ "verwilderung", "pflanzen", "beete", "beeten" }),
    "Hin und wieder wachsen absichtlich nicht gestutzte Pflanzen zwischen den "
    "fein saeuberlich angelegten Beeten.");

  AddDetail( ({ "taetigkeit" }),
    "Gehen.");

  AddDetail( ({ "ziegel" }),
    "Ein moderner Backstein.");

  AddDetail( ({ "gruen" }),
    "So gruen, wie eine Wiese nur sein kann.");

  AddDetail( ({ "finger", "fingern" }),
    "Du schaust deine Finger an. Auch alle da!");

  AddDetail( ({ "himmel" }),
    "Ein paar kleine Wolken tummeln sich am blauen Himmel.");

  AddDetail( ({ "wolken" }),
    "Nur zwei oder drei.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst das leise knirschen deiner Schritte im Kies.");

  AddSound( ({ "schritte", "kies" }),
    "*knirsch* *knarsch* *knirsch*");

  AddExit( "suedwesten", ROOM "garten_b3" );
  NewDoor("osten", ROOM "garten_d2", ({"tor", "gartentor"}),
          ({
            D_LONG,
              "Dieses Tor ist etwa drei Schritt hoch und besteht aus geschmiedeten "
              "Gitterstaeben.",
            D_SHORT, "Im Osten befindet sich ein %s Gartentor.",
            D_GENDER, NEUTER,
            D_NAME, "Tor"
          }));
}
