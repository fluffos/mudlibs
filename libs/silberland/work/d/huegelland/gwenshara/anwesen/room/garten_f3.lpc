#include "../def.h"

inherit "/std/room";

private void configureEnvironment() {
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HILL]) );
}

private void addDescriptions() {
  SetProp( P_INT_SHORT, "In einem Garten" );
  SetProp( P_INT_LONG,
    "Du stehst hier im hinteren Teil des Gartens. Der Weg macht eine Biegung "
    "nach Nordosten, um dort hinter dem Haus zu verschwinden. Weiter oestlich "
    "von dir erkennst du die Gartenmauer. Direkt an die Mauer wurde ein "
    "einfacher Schuppen gebaut aus dem ab und an ein lautes Gackern ertoent." );

  AddDetail( ({"teil"}),
    "Dieser Teil des Gartens ist etwas verwilderter, als der andere Teil vor "
    "dem Haus.");

  AddDetail( ({"garten", "gartens"}),
    "Du befindest dich hier im Garten eines groesseren Anwesens. In diesem Teil "
    "kannst du die Aussenmauer bereits erkennen. Ein Weg fuehrt hier um das "
    "Haus herum.");

  AddDetail( ({"weg", "boden"}),
    "Ein Kiesweg fuehrt um das Haus selbst herum. Von dem Weg geht ein kleiner "
    "Trampelpfad ab, etwas weiter in den Garten hinein, und endet bei einem "
    "kleinen Schuppen.");

  AddDetail( ({"biegung"}),
    "Im Nordosten macht der Weg eine Biegung und wendet sich um das Haus herum.");

  AddDetail( ({"mauer"}),
    "Welche Mauer meinst du? Die Hausmauer, oder die Gartenmauer?");

  AddDetail( ({"gartenmauer", "aussenmauer"}),
    "Hinter den ganzen Bueschen und Straeuchern kannst du das obere Ende der "
    "Gartenmauer aufragen sehen. Sie ist hier etwas mehr als zwei Schritt hoch "
    "und besteht aus rotem Backstein.");

  AddDetail( ({"schuppen"}),
    "Direkt an der Mauer erhebt sich ein einfacher Schuppen. Er wurde aus Holz "
    "zusammengenagelt und ist eher klein. Wind und Wetter haben ihm schon etwas "
    "zugesetzt, und so kann man erste Verwitterung am Holz erkennen. Eine "
    "Huehnerleiter fuehrt in ein kleines Loch und danaben befindet sich eine "
    "kleine Holztuer.");

  AddDetail( ({"gackern"}),
    "Nein. Gackern siehst du hier keines.");

  AddDetail( ({"haus", "anwesen", "anwesens"}),
    "Neben dir erhebt sich das Haus. Die Hausmauer besteht auch hier aus einem "
    "weissen Stein und Holzfachwerk. Anstelle eines Fensters wurde hier das Bild "
    "eines Baumes aufgemalt.");

  AddDetail( ({"kiesweg"}),
    "Der Weg, der hier um das Haus herum fuehrt, wurde mit kleinen, weissen "
    "Steinchen bestreut.");

  AddDetail( ({"pfad", "trampfelpfad", "weg"}),
    "Zwischen den Straeuchern fuehrt ein ausgetretener Pfad zum Schuppen. Es "
    "scheint, dass dieser Weg durchaus haeufiger genutzt wird.");

  AddDetail( ({"hausmauer"}),
    "Die Hausmauer besteht aus einem weissen Stein. An dieser Seite des Hauses "
    "wurde das Bild eines Baumes aufgemalt.");

  AddDetail( ({"buesche", "bueschen", "hecke"}),
    "Die Buesche in diesem Teil des Gartens bilden eine natuerliche Hecke vor "
    "der Mauer. Du  erkennst einige der duftenderen Sorten, wie zum Beispiel "
    "einen Flieder.");

  AddDetail( ({"straeucher", "straeuchern"}),
    "Auf den Straeuchern wachsen bunte Blueten, die einen angenehmen Duft "
    "verstroemen.");

  AddDetail( ({"schritt", "menschenschritt", "abstand", "schrittes"}),
    "Eine Masseinheit, die in etwa dem Abstand eines Schrittes von Menschen "
    "entspricht.");

  AddDetail( ({"backstein"}),
    "Die Mauer, welche um das Anwesen verlaeuft, wurde aus rotem Backstein "
    "gebaut. In diesem Teil des Gartens scheint er noch ganz gut in Schuss zu "
    "sein.");

  AddDetail( ({"holz", "silbereiche"}),
    "Du vermutest, dass es sich um das Holz der Silbereiche handelt.");

  AddDetail( ({"wind", "wetter"}),
    "Obwohl es im Huegelland meist sonnig ist haben Wind und Wetter schon ihre "
    "Spuren am Schuppen hinterlassen.");

  AddDetail( ({"verwitterung", "spuren"}),
    "Du stellst feast, dass das Holz des Schuppens teilweise rissig, sproede "
    "oder sogar morsch ist. Du befindest aber, dass von ihm keine Einsturzgefahr "
    "ausgeht.");

  AddDetail( ({"leiter", "huehnerleiter"}),
    "Eine einfach Huehnerleiter fuehrt durch ein Loch in den Schuppen hinein. ");

  AddDetail( ({"loch"}),
    "Das Loch ist offenbar fuer Huehner ausgelegt. Damit der Fuchs sich keines "
    "schnappt kann es mit einem Riegel verschlossen werden.");

  AddDetail( ({"tuer", "holztuer", "eingang"}),
    "Neben dem Loch fuer die Huehner fuehrt eine Tuer in den Schuppen. Du "
    "wuerdest sagen, dass das der bessere Eingang fuer dich ist.");

  AddDetail( ({"fachwerk", "holzfachwerk", "geruest", "grundgeruest"}),
    "Das Fachwerk bildet das Grundgeruest fuer das Haus. Es wurde ebenso aus "
    "dem Holz der Silbereiche gefertigt.");

  AddDetail( ({"stein"}),
    "Die Hausmauer besteht aus einem weissen Stein und die Gartenmauer aus "
    "rotem Backstein.");

  AddDetail( ({"fenster"}),
    "Anstatt einem Fenster findest du hier nur das Bild eines Baumes.");

  AddDetail( ({"bild", "baum", "baumes", "apfelbaum"}),
    "Es handlet sich, wie du schnell erkennst um einen Apfelbaum, der rote "
    "Aepfel traegt.");

  AddDetail( ({"steinchen"}),
    "Der Kiesweg wurde mit kleinen, weissen Steinchen bestreut, damit man nicht "
    "so schnell ausrutscht.");

  AddDetail( ({"sorten", "sorte"}),
    "Die einzige Sorte, die du hier erkennst ist der Flieder. Alle anderen sind "
    "dir leider unbekannt.");

  AddDetail( ({"beispiel", "flieder"}),
    "Der Flieder hier ist ein Beispiel fuer einen duftenden Busch.");

  AddDetail( ({"blueten"}),
    "Die kleinen roten gefallen dir am besten.");

  AddSmell( ({"duft", "blueten"}),
    "Die kleinen roten Blueten verstroemen einen angenegmen Duft.");

  AddDetail( ({"menschen", "masseinheit", "mensch"}),
    "Der Menschenschritt ist zwar keine genormte Masseinheit, reicht im "
    "hiesigen Bauwesen allerdings vollkommen aus.");

  AddDetail( ({"schuss"}),
    "*peng*");

  AddDetail( ({"huegelland"}),
    "Da bist du gerade.");

  AddDetail( ({"einsturzgefahr"}),
    "Wie es aussieht, ist der Schuppen ausreichend sicher um betreten zu werden.");

  AddDetail( ({"huehner", "tiere"}),
    "Vermutlich haelt hier jemand Huehner. Diese Tiere legen ja auch sehr "
    "schmackhafte Eier.");

  AddDetail( ({"riegel", "metallriegel"}),
    "Ein einfacher Metallriegel, der abends geschlossen werden kann.");

  AddDetail( ({"aepfel"}),
    "Auf dem Bild sehen sie sehr saftig aus.");

  AddDetail( ({"eier"}),
    "Ob die Huehner im Schuppen wohl ein Ei uebrig haben?");
}

public void create()  {
  replace_program("/std/room");
  ::create();

  configureEnvironment();
  addDescriptions();

  AddExit( "westen", ROOM "garten_e3" );
  AddExit( "nordosten", ROOM "garten_g2" );
  AddExit( "schuppen", ROOM "schuppen#in den Schuppen");
}
