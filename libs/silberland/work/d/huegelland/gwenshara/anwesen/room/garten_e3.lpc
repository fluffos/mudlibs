  AddDetail( ({ "honig" }),
    "Leider ist keiner hier. Die Bienen muessen ihn erst machen.");

  AddDetail( ({ "blumenerde", "erde", "humus" }),
    "Saftiger, noch feuchter Humus.");

  AddDetail( ({ "boden" }),
    "Der Boden ist hier von einem Kiesweg bedeckt. Unterhalb des Dachs der "
    "Werkstatt besteht er grossteils aus Rindenmulch.");

  AddDetail( ({ "pfosten", "holzpfosten" }),
    "Dicke Pfosten aus einem lokalen Holz.");

  AddDetail( ({ "werkzeuge", "hammer", "saege", "naegel", "hobel" }),
    "Hammer, Saege, Hobel und ein paar Naegel. Vermutlich kommen sie alle aus "
    "der Werkzeugkiste, die danebensteht.");

  AddSpecialDetail( ({ "werkzeugkiste", "kiste" }), "detail_werkzeugkiste");

  AddDetail( ({ "bearbeitung", "holzbearbeitung", "tischlerei", "schreinerei" }),
    "Die Bearbeitung von Holz eben. Tischlerei und Schreinerei.");

  AddDetail( ({ "brennholz" }),
    "Du findest gerade keines.");

  AddDetail( ({ "beil", "stapel" }),
    "Mit dem Beil kann man vermutlich Holz vom Stapel hacken.");

  AddSpecialDetail( ({ "schraubenzieher" }), "detail_schraubenzieher");

  AddSound( DEFAULT_SOUND,
    "Das Summen von Bienen erfuellt die Luft.");

  AddSound( ({ "bienen" }),
    "Die fleissigen Bienen summen beim Sammeln von Bluetenstaub.");

  AddSound( ({ "summen", "sammeln", "luft"}),
    "*summ* *summ* *summ*");

  AddSmell( DEFAULT_SMELL,
    "Ein angenehmer Blumenduft erfuellt die Luft.");

  AddSmell( ({"duft", "blumenduft", "blumen"}),
    "Er kommt vermutlich von den Blumen.");
}

public string detail_werkzeugkiste(string key) {
  string screwDriverText;
  if(!hasFoundToolbox(TP)) {
    foundBox += ({ TP });
  }

  if(!isToolboxOpen()) {
    return BS("Die Werkzeugkiste steht auf der Werkbank und ist geschlossen.");
  }

  if(screwdriverNr > 1) {
    screwDriverText = "ein paar";
  } else if(screwdriverNr == 1) {
    screwDriverText = "einen";
  } else {
    screwDriverText = "leider gerade keinen";
  }

  return BS(sprintf("Die geoeffnete Werkzeugkiste steht auf der Werkbank. In ihr findest "
  "du %s Schraubenzieher.", screwDriverText));
}

public string detail_schraubenzieher(string key) {
  if(isToolboxOpen()) {
    return BS("Damit kann man Schrauben loesen.");
  }

  return BS("Sowas siehst du hier nicht!");
}

private void addCommands() {
  AddCmd( "nimm|nehme&schraubenzieher|schraubenzieher aus werkzeugkasten|schraubenzieher aus kasten",
          "cmd_schraubenzieher", "WAS willst du WORAUS nehmen?");
  AddCmd( "hacke|hack|zerhacke|zerhack&holz|stapel|brennholz", "cmd_hacken", "Was willst du hacken?");
  AddCmd( "kletter|klettere|kraxel|kraxle&auf&pflanze|kletterpflanze|ranken", "cmd_klettern", "Wo sillst du klettern?");
  AddCmd( "ess|esse|iss&blatt|blaetter|ranken|kletterpflanze|rankpflanze", "cmd_essen", "Was willst du essen?");
  AddCmd( "oeffne|oeffen&kiste|werkzeugkiste", "cmd_oeffnen", "Was willst du oeffnen?");
}

public void create()  {
  ::create();
  resetRoomState();  

  configureEnvironment();
  addDescriptions();
  addCommands();

  AddExit( "nordwesten", ROOM "garten_d2" );
  AddExit( "osten", ROOM "garten_f3" );
}

public int cmd_oeffnen() {
  if(!hasFoundToolbox(TP)) {
    write("Sowas siehst du hier nicht.\n");
    return -1;
  }

  TP->Message(BS("Du oeffnest die Werkzeugkiste.\n"));
  Message(BS(sprintf("%s oeffnet eine Werkzeugkiste.\n", TP->Name(WER, 1))), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  toolboxOpened = 1;
  return 1;
}

public int cmd_essen(string args) {
  object tp;

  tp = this_player();

  tp->Message(BS("Du rupfst ein paar Blaetter aus und steckst sie gierig in "
  "den Mund. Baeh! Schmeckt das bitter... und du fuehlst dich gar nicht gut..."));
  Message(BS(tp->Name(WER) + " isst etwas von den Kletterpflanzen. Ob das eine "
  "gute Idee war?"));

  tp->AddPoision(1);
  return 1;
}

public int cmd_klettern(string args) {
  object tp;

  tp = this_player();

  tp->Message(BS("Du versuchst die Ranken hochzukletter, faellst jedoch nach etwa "
  "einem Meter wieder zu Boden! AUA!"));
  tp->AddHp(-10);

  Message(BS(tp->Name(WER) + " versucht an der Wand hochzuklettern, faellt jedoch "
  "nach etwa einem Meter wieder zu Boden. *Autsch* Das sieht schmerzhaft aus!"));
  return 1;
}

public int cmd_hacken(string args) {
  object tp;

  tp = this_player();

  if(tp->QueryProp(P_BLIND) != 0) {
    tp->Message(BS("Wenn du blind bist waere das eine dumme Idee!"));
    return -1;
  }

  tp->Message(BS("Du nimmst das Beil und hackst ein paar Scheite Brennholz."));
  Message(BS(tp->Name(WER) + " nimmt das Beil und zerhackt ein paar Holzscheite."),
    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  return 1;
}

public void reset() {
  ::reset();
  resetRoomState();
}

private void addScrewdriverToPlayer(object player) {
  object screwdriver;
  int moveResult;

  if(!objectp(player)) {
    return;
  }

  if(objectp(present("schraubenzieher", player))) {
    player->Message("Sowas hast du doch schon!\n");
    return;
  }

  screwdriver = clone_object(WEAPON "schraubenzieher");
  moveResult = screwdriver->move(player, M_GET);

  if(moveResult > 0) {
    player->Message(BS("Du nimmst einen Schraubenzieher."));
    Message(BS(player->Name(WER)+" nimmt einen Schraubenzieher."), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
  } else if(moveResult == ME_TOO_HEAVY) {
    player->Message(BS("Du laesst den Schraubenzieher liegen, da er dir zu schwer ist."));
    screwdriver->remove(1);
  } else {
    player->Message(BS("Den kannst du gerade nicht nehmen."));
    screwdriver->remove(1);
  }

  screwdriverNr--;
}

public int cmd_schraubenzieher(string args) {
  object tp;
  tp = this_player();

  if(!hasFoundToolbox(tp)) {
    tp->Message(BS("Wo hast du denn einen Schraubenzieher gefunden?"));
    return -1;
  }

  if(!isToolboxOpen()) {
    tp->Message(BS("Die Werkzeugkiste ist doch geschlossen."));
    return -1;
  }

  if(screwdriverNr < 1) {
    tp->Message(BS("Hm. Gerade keiner da. Vielleicht hat ihn jemand ausgebort? Schau doch spaeter nochmal vorbei!"));
    return -1;
  }

  addScrewdriverToPlayer(tp);

  return 1;
}
