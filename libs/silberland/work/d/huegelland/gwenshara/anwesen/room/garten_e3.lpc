#include "../def.h"

inherit "/std/room";

private nosave int toolboxOpened;
private nosave object *foundBox;
private nosave int screwdriverNr;

private void resetRoomState() {
  foundBox = ({ });
  toolboxOpened = 0;
  screwdriverNr = 2;
}

private int hasFoundToolbox(object who) {
  return member(foundBox, who) >= 0;
}

private int isToolboxOpen() {
  return toolboxOpened == 1;
}


private void configureEnvironment() {
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HILL]) );
}

private void addDescriptions() {
  SetProp( P_INT_SHORT, "In einem Garten" );
  SetProp( P_INT_LONG,
    "Du befindest dich hier auf einem Weg, der um das Haus herum fuehrt. An der "
    "Hausmauer wachsen vereinzelte Rankpflanzen empor, wahrend direkt davor "
    "ein paar Blumen in einem akkurat angelegten Beet bluehen. Gegenueber "
    "wurde unter einem einfachen Dach eine kleine Werkstatt eingerichtet." );
  

  AddDetail( ({ "weg", "kiesweg" }),
    "Ein gestreuter Kiesweg fuehrt hier um das Haus herum. Ab und zu stecken "
    "erste Grasbueschel ihren Kopf durch den Untergrund. Alles in Allem wuerdest "
    "du jedoch sagen, dass dieser Weg ausreichend Pflege erhaelt.");

  AddDetail( ({ "haus", "anwesen" }),
    "Rechter Hand erhebt sich die Hausmauer. Das gesamte Haus neben dir ist "
    "zwei Stockwerke hoch und ist von offenbar wohlhabenden Einwohnern "
    "bewohnt.");

  AddDetail( ({ "mauer", "hausmauer" }),
    "Die Mauer besteht aus einer Mischung aus weissen Stein und Holzfachwerk. "
    "Einige Rankpflanzen winden sich an ihr empor und ergaenzen das Weiss mit "
    "einem fleckigen Gruen. Genau auf Kopfhoehe befindet sich ein Fenster.");

  AddDetail( ({ "pflanzen", "rankpflanzen", "ranken" }),
    "Die Ranken einer Kletterpflanze wachsen hier entlang den Steinen der "
    "Hausmauer und dem Fachwerk empor. Sie bedeken weite Teile der Mauer "
    "mit ihren Blaettern, sodass nur an wenigen Stellen die eigentliche "
    "Hausmauer sichtbar ist.");

  AddDetail( ({ "blumen" }),
    "In dem Beet vor dem Fenster wachsen verschiedene, farbenpraechtige "
    "Blumen. Einige Bienen schwirren in ihnen herum, sodass du vermutest, dass "
    "sie auch gut duften sollten.");

  AddDetail( ({ "beet" }),
    "Das Beet wurde sauber angelegt und mit Blumen bestueckt. Es wird von einer "
