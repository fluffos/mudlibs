    "haben.");

  AddDetail( ({ "werkstatt", "unterstand" }),
    "Die kleine Werkstatt wird von einem Unterstand gebildet, der mit einem "
    "einfachen Dach abgedeckt wurde. Unter dem Dach befindet sich eine Werkbank, "
    "sowie ein Hackblock.");

  AddDetail( ({ "bueschel", "grasbueschel" }),
    "Obwohl der Weg gut gepflegt ist stecken erste Grasbueschel ihren Kopf "
    "aus dem Untergrund hervor. Egal wieviel Pflege man einem Garten angedeihen "
    "laesst, es ist wohl nie genug!");

  AddDetail( ({ "pflege", "schuss" }),
    "Hier scheint durchaus jemand dafuer zu sorgen, dass alles einigermassen "
    "gut in Schuss bleibt.");

  AddDetail( ({ "hand" }),
    "Die rechte Hand ist gegenueber der linken Hand.");

  AddDetail( ({ "stockwerke", "obergeschoss", "erdgeschoss", "geschoss" }),
    "Das Haus besteht aus einem Erdgeschoss und einem Obergeschoss.");

  AddDetail( ({ "einwohnern", "einwohner", "bewohner" }),
    "Die Bewohner dieses Anwesens duerften durchaus wohlhabend sein, wenn man "
    "sich hier so umsieht. Vermutlich findest du sie im Haus.");

  AddDetail( ({ "mischung" }),
    "Weisser Stein und Holz.");

  AddDetail( ({ "weiss" }),
    "Nicht gerade ein strahlenddes Weiss, sondern eher Kalkweiss");

  AddDetail( ({ "gruen", }),
    "Verschiedene Gruentoene, wie sie eben die Blaetter von Pflanzen ergeben.");

  AddDetail( ({ "hoehe", "kopfhoehe" }),
    "Das entspricht in etwa der Hoehe, auf der sich dein Kopf befindet.");

  AddDetail( ({ "fenster" }),
    "Durch das Fenster kannst du in den Salon im Haus blicken.");

  AddDetail( ({ "kletterpflanze" }),
    "Eine gemeine Kletterpflanze rankt sich hier empor. Vermutlich nennt man sie "
    "Kletterpflanze, weil man darauf hochklettern kann.");

  AddDetail( ({ "fachwerk", "holzfachwerk" }),
    "Das Fachwerk des Hauses wurde aus lokalem Holz gefertigt und sticht braun hervor.");

  AddDetail( ({ "teile", "stellen" }),
    "Nur wenige Teile der Mauer sind ohne Blattwerk.");

  AddDetail( ({ "blaetter", "blattwerk", "blaettern" }),
    "Die Blaetter der Kletterpflanze strahlen dich in einem satten Gruen an. Sieht "
