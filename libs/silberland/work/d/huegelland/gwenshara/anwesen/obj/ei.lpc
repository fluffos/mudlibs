#include "../def.h"
#include <food.h>

inherit "/std/food";

public void create() {
    if(!is_clone(TO)) return;

    replace_program("/std/food");
    ::create();

    SetProp(P_SHORT, "Ein Huehnerei");
    SetProp(P_LONG, "Ein kleines Huehnerei mit brauner Schale.");
    SetProp(P_NAME, "Huehnerei");
    SetProp(P_GENDER, NEUTER);
    SetProp(P_WEIGHT, 25);
    SetProp(P_VALUE, 1);
    SetProp(P_MATERIAL, ([MAT_LIME: 20, MAT_MISC_LIVING: 5, MAT_MISC_FOOD: 75]));
    SetProp(P_FOOD_STATE, F_RAW);
    SetProp(P_FOOD_INFO, ([
        F_HEAL: 3,
        F_SOAK: 3,
        F_DRINK: 3,
        F_MSG: "Du brichst das Ei auf und schluerfst es roh aus.",
        F_MSG_ROOM: "bricht ein Ei auf und schluerft es roh aus.",
        F_MSG_DECAY: "Ein Huehnerei verstroemt einen schwefeligen Geruch.",
        F_MSG_REMOVE: "Das Ei zerbricht und der gute Dotter rinnt heraus.\n",
        F_SHOW_RAW: 1
    ]));

    AddId( ({"ei", "huehnerei"}) );

    start_decay(86400, -1);
}