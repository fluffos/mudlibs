#include "../def.h"
#include <properties.h>
#include <combat.h>

inherit "/std/weapon";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_NAME, "Schraubenzieher");
    SetProp(P_GENDER, MALE);
    SetProp(P_SHORT, "Ein Schraubenzieher");
    SetProp(P_LONG, 
      "Ein klassischer Schlitz-Schraubenzieher mit einem roten Griff.");
    
    AddId( ({"schraubenzieher", "schrauber"}) );

    SetProp(P_WEAPON_TYPE, WT_MISC);
    SetProp(P_WC, 50);
    SetProp(P_WC_FIX, 50);
    SetProp(P_DAM_TYPE, ({ DT_PIERCE }));
    SetProp(P_NR_HANDS, 1);
    SetProp(P_MATERIAL, ([MAT_WOOD: 30, MAT_METAL: 60, MAT_INK: 10]));
    SetProp(P_WEIGHT, 30);
    SetProp(P_SIZE, 15);
    SetProp(P_VALUE, 20);
}