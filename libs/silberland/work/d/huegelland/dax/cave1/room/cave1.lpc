inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
create() {
  ::create();

  SetProp( P_INT_SHORT, "In einer kleinen Kristallhoehle" );
  SetProp( P_INT_LONG,
   "Du hast eine kleine Hoehle komplett aus Kristall betreten. Alles "
   "hier ist aus Kristall, der Boden, die Waende, die Decke, einfach alles.\n");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_CAVE]) );
  AddExit("ostoben","/d/huegelland/dax/wege/room/derlim_huegel/weg1");
  AddExit("westen","/d/huegelland/dax/cave1/room/cave2");
}