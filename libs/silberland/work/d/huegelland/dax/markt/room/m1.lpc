inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einer Wiese" );
  SetProp( P_INT_LONG,
   "Eine Wiese ohne Details.\n");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_HILL]) );

  AddExit( "osten", "/d/huegelland/dax/wege/room/derlim_huegel/weg3");
  AddExit( "westen", "/d/huegelland/dax/markt/room/m2");
  AddExit( "norden", "/d/huegelland/dax/markt/room/m3");
  AddExit( "nordwesten", "/d/huegelland/dax/markt/room/m4");
}