inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>

int schuesseln;
string topfinhalt2;
string schuesseltext;
string topfinhalt;
int generator;
int schrank;
int topfvoll;

create()
{
  ::create();
 
  generator=random(5);
  schuesseltext="die erbsensuppe suppe 25 10 lecker";
  topfinhalt="erbsensuppe";
  topfinhalt2="suppe";
  if (generator==1)
  {
  	schuesseltext="die bohnensuppe suppe 15 5 lecker";
  	topfinhalt="bohnensuppe";
  	topfinhalt2="suppe";
  }
  if (generator==2)
  {
  	schuesseltext="das rindergulasch gulasch 35 18 heiss";
  	topfinhalt="rindergulasch";
  	topfinhalt2="gulasch";
  }
  if (generator==3)
  {
  	schuesseltext="die linsensuppe suppe 20 10 lecker";
  	topfinhalt="linsensuppe";
  	topfinhalt2="suppe";
  }
  if (generator==4)
  {
  	schuesseltext="das pilzragout ragout 30 15 heiss";
  	topfinhalt="pilzragout";
  	topfinhalt2="ragout";
  }
  if (generator==5)
  {
  	schuesseltext="die kartoffelsuppe suppe 23 12 heiss";
  	topfinhalt="kartoffelsuppe";
  	topfinhalt2="suppe";
  }
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "In einer Foersterhuette" );
  SetProp( P_INT_LONG,
   "Hier in der Foersterhuette ist es gemuetlich und warm. Das liegt warscheinlich "
   "an dem Kamin, der sich in der linken Hauswand befindet. Die gesamt Huette ist "
   "aus Holz gebaut und Du fragst Dich, ob es nicht gefaehrlich ist, hier einen offenen "
   "Kamin zu betreiben. Die Fenster sind geschlossen, aber so sauber geputzt, dass Du "
   "jedes Detail ausserhalb der Huette erkennen kannst. In einer Ecke sind ein paar gemuetliche "
   "Stuehle und ein kleiner Tisch aufgebaut, die Waende haengen voll mit Bildern und Regalen. "
   "Gegenueber dem Ausgang befindet sich eine Tuer.\n");

  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 22, ENV_TERRAIN: TT_HOUSE]) );
  
  schuesseln=3;
  schrank=0;
  topfvoll=2+random(5);

	AddCmd("iss","essenfunc");
  AddCmd("nimm","nimmfunc");
  AddCmd("oeffne","oeffnenfunc");
	AddCmd(({"klingel","klingele"}),"klingelfunc");
  
	AddDetail(({"huette","foersterhuette"}),"Hier in der Foersterhuette ist es "
	"gemuetlich und warm. Das liegt warscheinlich "
  "an dem Kamin, der sich in der linken Hauswand befindet. Die gesamt Huette ist "
  "aus Holz gebaut und Du fragst Dich, ob es nicht gefaehrlich ist, hier einen offenen "
  "Kamin zu betreiben. Die Fenster sind geschlossen, aber so sauber geputzt, dass Du "
  "jedes Detail ausserhalb der Huette erkennen kannst. In einer Ecke sind ein paar gemuetliche "
  "Stuehle und ein kleiner Tisch aufgebaut, die Waende haengen voll mit Bildern und Schraenken. "
  "Gegenueber dem Ausgang befindet sich eine Tuer.\n");
  
  AddDetail(({"kamin","feuer","topf"}),"In dem offenen Kamin brennt ein warmes, gemuetliches Feuer, "
  "ueber dem ein Topf mit "+capitalize(topfinhalt)+" haengt.\n");
  
  AddDetail(({topfinhalt,topfinhalt2}),"Sieht gut aus, Du bekommst glatt Hunger auf "
  +capitalize(topfinhalt)+".\n");
  
  AddDetail(({"hunger","essen"}),"Du koenntest etwas zu Essen vertragen.\n");
  
  AddDetail(({"regale","regal"}),"Die meisten Regale sind mit nutzlosem Kram gefuellt, aber "
  "ein Schrank erregt dein Aufmerksamkeit. Vielleicht solltest Du mal reinschauen.\n");
  
  AddSpecialDetail("schrank","schrankfunc");
  
  AddSpecialDetail(({"schuessel","schuesseln","suppenschuessel","suppenschuesseln"}),"schuesseldetail");
}

int nachhinten()
{
	return write("Du hast nicht die geringste Ahnung, wie die Tuer aufgeht.\n"),1;
}

int essenfunc(string was)
{
	if (!was) return 0;
	if (was==topfinhalt||was==topfinhalt2) return write(BS("Du kostest etwas "
		+capitalize(topfinhalt)+". Schmeckt lecker. Wenn Du doch etwas haettest, "
		"wo Du das heisse Essen hinein tun koenntest.\n")),1;
	return 0;
}

int oeffnenfunc(string was)
{
	notify_fail("Was willst Du denn oeffnen?\n");
	if (!was) return 0;
	if (was=="tuer") return write(BS("Welche Tuer willst Du oeffnen? Die Eingangstuer oder die "
	"Hintertuer?\n")),1;
	if (was=="eingangstuer")
	{
		TO->AddExit("raus","nach draussen#/d/huegelland/dax/markt/room/m7");
		write(BS("Du oeffnest die Eingangstuer.\n"));
		say(BS(TP->name()+" oeffnet die Eingangstuer.\n"));
		tell_room("/d/huegelland/dax/markt/room/m7",BS("Die Tuer wird von innen geoeffnet.\n"));
		return 1;
	}
	if (was=="hintertuer")
	{
		if(IS_LEARNER(TP))
		{
			write(BS("Du oeffnest die Hintertuer und gehst nach hinten. Hinter "
			"Dir schliesst sich die Tuer wieder automatisch.\n"));
			say(BS(TP->name()+" oeffnet die Hintertuer und geht nach hinten. "
			"Hinter "+TP->QueryPronoun(WEM)+" schliesst sich die Tuer wieder automatisch.\n"));
			TP->move("/players/dax/workroom", M_GO, "nach hinten", "geht", "kommt vom "
			"Huegelland herein");
			return 1;
		}
		return write(BS("Du hast nicht die geringste Ahnung, wie die Hintertuer aufgeht.\n")),1;
	}
	if (was=="schrank"||was=="schranktuer")
	{
		if (schrank) return write(BS("Der Schrank ist doch schon offen.\n")),1;
		schrank=1;
		say(BS(TP->name()+" oeffnet den Schrank.\n"));
		if (!schuesseln) return write(BS("Du oeffnest den Schrank und stellst fest, das er absolut leer "
		 "ist.\n")),1;
		if (schuesseln>1) return write(BS("Du oeffnest den Schrank und findest "+schuesseln
	   +" Suppenschuesseln.\n")),1;
		return write(BS("Du oeffnest den Schrank und findest eine Suppenschuessel.\n")),1;
	}
	return 0;
}

string schrankfunc()
{
	if (!schrank)	return "Der Schrank ist geschlossen.\n";
	if (!schuesseln) return "Der Schrank ist absolut leer.\n";
	if (schuesseln>1) return "Im Schrank stehen "+schuesseln+" Suppenschuesseln.\n";
	else return "Im Schrank steht eine Suppenschuessel";
}

string schuesseldetail()
{
	if (!schuesseln) return 0;
	else if(!schrank) return 0;
	else return "Du kannst sie besser untersuchen, wenn Du sie nimmst.\n";
}

int nimmfunc(string was)
{
	object target;
	target=clone_object("/d/huegelland/dax/obj/schuessel_leer");	
	if (!was) return 0;
	if (was=="schuessel"||was=="suppenschuessel"||was=="schuesseln"||was=="suppenschuesseln")
	{
		if (present(was,TO)) return 0;
		if (!schuesseln) return 0;
		if (!schrank) return 0;
		if (deep_present("\ndaxidschuesselleer",TP)||present("\ndaxidschuesselvoll",TP))
		return write(BS("Du hast doch schon eine Suppenschuessel, "
		"Du willst es nicht uebertreiben.\n")),1;
		write(BS("Du nimmst eine Suppenschuessel aus dem Schrank.\n"));
		say(BS(TP->name()+" nimmt eine Suppenschuessel aus dem Schrank.\n"));
		schuesseln=schuesseln-1;
		target->move(TP,M_GET);
		return 1;
	}
	if (was==topfinhalt||was==topfinhalt2)
	{
		object schuesselvoll;
		schuesselvoll=clone_object("/d/huegelland/dax/obj/schuessel_voll");
		if (!present("\ndaxidschuesselleer",TP)) return write(BS("Du kostest etwas "
		+capitalize(topfinhalt)+". Schmeckt lecker. Wenn Du doch etwas haettest, "
		"wo Du das heisse Essen hinein tun koenntest.\n")),1;
		if (!topfvoll) return write(BS("Bei dem kleinen Rest, der noch im Topf ist, "
		"wuerde es sofort auffallen, wenn Du noch mehr Suppe stiehlst. Du laesst es "
		"daher lieber sein.\n")),1;
		schuesselvoll->move(TP,M_GET);
		schuesselvoll->fuellfunc(schuesseltext);
		write(BS("Du nimmst Deine Suppenschuessel und fuellst etwas "
		+capitalize(topfinhalt)+" hinein.\n"));
		say(BS(TP->name()+" fuellt etwas "+capitalize(topfinhalt)+" in eine Suppenschuessel.\n"));
		present("\ndaxidschuesselleer",TP)->remove();
		topfvoll=topfvoll-1;
		return 1;
	}
	return 0;
}

int klingelfunc()
{
	write("Du tippst auf die Klingel.\n");
	if (find_player("dax"))
	 return tell_object(find_player("dax"),
	 BS("!!! "+TP->Name()+" hat im Huegelland geklingelt !!!\n")),1;
	return 1;
}

reset()
{
	::reset();
	TO->RemoveExit("raus");
	generator=random(5);
  schuesseltext="die erbsensuppe suppe 25 10 lecker";
  topfinhalt="erbsensuppe";
  topfinhalt2="suppe";
  if (generator==1)
  {
  	schuesseltext="die bohnensuppe suppe 15 5 lecker";
  	topfinhalt="bohnensuppe";
  	topfinhalt2="suppe";
  }
  if (generator==2)
  {
  	schuesseltext="das rindergulasch gulasch 35 18 heiss";
  	topfinhalt="rindergulasch";
  	topfinhalt2="ragout";
  }
  if (generator==3)
  {
  	schuesseltext="die linsensuppe suppe 20 10 lecker";
  	topfinhalt="linsensuppe";
  	topfinhalt2="suppe";
  }
  if (generator==4)
  {
  	schuesseltext="das pilzragout ragout 30 15 heiss";
  	topfinhalt="pilzragout";
  	topfinhalt2="ragout";
  }
    if (generator==5)
  {
  	schuesseltext="die kartoffelsuppe suppe 23 12 heiss";
  	topfinhalt="kartoffelsuppe";
  	topfinhalt2="suppe";
  }
  TO->AddDetail(({"kamin","feuer","topf"}),"In dem offenen Kamin brennt ein warmes, gemuetliches Feuer, "
  "ueber dem ein Topf mit "+capitalize(topfinhalt)+" haengt.\n");
  
  TO->AddDetail(({topfinhalt,topfinhalt2}),"Sieht gut aus, Du bekommst glatt Hunger auf "
  +capitalize(topfinhalt)+".\n");

	TO->AddSpecialDetail("schrank","schrankfunc");
  
  TO->AddSpecialDetail(({"schuessel","schuesseln","suppenschuessel","suppenschuesseln"}),"schuesseldetail");
  
  schrank=0;
  schuesseln=3;
  topfvoll=2+random(5);
}