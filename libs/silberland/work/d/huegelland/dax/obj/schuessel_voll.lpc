
inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

string inhaltname;
string inhaltartikel;
int inhaltpunkte;
int zustandabzug;
string inhaltzustand;
string inhaltname2;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  inhaltname="irgendetwas";
  inhaltname2="etwas";
  inhaltartikel="das";
  inhaltpunkte=50;
  inhaltzustand="lecker";
  zustandabzug=0;

  SetProp(P_SHORT, "Eine volle Suppenschuessel");
  SetProp(P_LONG, 
   "Diese Schuessel hast Du aus der Foersterhuette gestohlen.\n"
   "Sie ist mit "+capitalize(inhaltname)+" gefuellt.\n");
  SetProp(P_NAME, "Suppenschuessel");
  SetProp(P_NAME_ADJ,"voll");
  SetProp(P_GENDER, FEMALE);
  AddId(({"schuessel","suppenschuessel","\ndaxidschuesselvoll"}));
  SetProp(P_WEIGHT, 400+random(100));
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL,1);
  SetProp(P_NOBUY,1);
  SetProp(P_ARTICLE, 1);
  SetProp(P_KILL_NAME,inhaltzustand+"e "+capitalize(inhaltname));
  SetProp(P_INFO,"Du kannst Sie mit <entleere schuessel> wieder entleeren.\n");
  AddSpecialDetail(({inhaltname,inhaltname2}),"inhaltfunc");
  AddCmd("iss","essenfunc");
  AddCmd(({"entleere"}),"leerfunc");
}

int leerfunc(string was)
{
	object schuesselleer;
	schuesselleer=clone_object("/d/huegelland/dax/obj/schuessel_leer");
	if (!was) return 0;
	if (was=="schuessel")
	{
		write(BS("Du entleerst die Schuessel.\n"));
		say(BS(TP->name()+" entleert eine Suppenschuessel.\n"));
		schuesselleer->move(TP,M_NOCHECK);
		TO->remove();
		return 1;
	}
	return 0;
}

string inhaltfunc()
{
	return capitalize(inhaltartikel)+" "+capitalize(inhaltname)+" sieht "+inhaltzustand+" aus.\n";
}

int fuellfunc(string inhalttext)
{
	sscanf(inhalttext,"%s %s %s %d %d %s",inhaltartikel,inhaltname,inhaltname2,inhaltpunkte,zustandabzug,inhaltzustand);
	TO->SetProp(P_LONG, 
   "Diese Schuessel hast Du aus der Foersterhuette gestohlen.\n"
   "Sie ist mit "+capitalize(inhaltname)+" gefuellt.\n");
  TO->AddSpecialDetail(({inhaltname,inhaltname2}),"inhaltfunc");
	return 1;
}

int essenfunc(string was)
{
	object schuesselleer;
	schuesselleer=clone_object("/d/huegelland/dax/obj/schuessel_leer");
	if (!was) return 0;
	if (was==inhaltname||was==inhaltname2)
	{
		write(BS("Du nimmst die Schuessel und isst "+inhaltartikel+" "+inhaltzustand+"e "+capitalize(inhaltname)+".\n"));
		say(BS(TP->name()+" nimmt eine Suppenschuessel und ist "+capitalize(inhaltname)+".\n"));
		schuesselleer->move(TP,M_NOCHECK);
		if (inhaltpunkte<0)
		{
			write(BS("Dir wird schlecht.\n"));
			TP->do_damage((inhaltpunkte*(-2))+inhaltpunkte);
		}
		if (inhaltpunkte>0)
		{
			write(BS("Du fuehlst dich gestaerkt.\n"));
			TP->SetProp(P_HP,TP->QueryProp(P_HP)+inhaltpunkte);

		}
		if (inhaltpunkte=0)
		{
			write(BS("Nicht gerade lecker, aber essbar.\n"));
		}
		TO->remove();
		return 1;
	}
	return 0;
}

reset()
{
	::reset();
	if (is_clone(TO))
	{
		if (ENV(TO))
		{
			inhaltpunkte=inhaltpunkte-zustandabzug;
			if (inhaltzustand=="schimmlig")
			{
				inhaltzustand="verschimmelt";
				write(BS(capitalize(inhaltartikel)+" "+capitalize(inhaltname)+" verschimmelt.\n"));
			}
			if (inhaltzustand=="schlecht")
			{
				inhaltzustand="schimmlig";
				write(BS(capitalize(inhaltartikel)+" "+capitalize(inhaltname)+" wird "+inhaltzustand+".\n"));
			}
			if (inhaltzustand=="ranzig")
			{
				inhaltzustand="schlecht";
				write(BS(capitalize(inhaltartikel)+" "+capitalize(inhaltname)+" wird "+inhaltzustand+".\n"));
			}
			if (inhaltzustand=="kalt")
			{
				inhaltzustand="ranzig";
				write(BS(capitalize(inhaltartikel)+" "+capitalize(inhaltname)+" wird "+inhaltzustand+".\n"));
			}	
			if (inhaltzustand=="lecker")
			{
				inhaltzustand="kalt";
				write(BS(capitalize(inhaltartikel)+" "+capitalize(inhaltname)+" wird "+inhaltzustand+".\n"));
			}
			TO->SetProp(P_KILL_NAME,inhaltzustand+"e "+capitalize(inhaltname));
			TO->AddSpecialDetail(({inhaltname,inhaltname2}),"inhaltfunc");
  	}
  }
}