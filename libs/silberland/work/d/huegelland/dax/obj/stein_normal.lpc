
inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>


create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp(P_SHORT, "Ein Pflasterstein");
  SetProp(P_LONG, 
   "Du haeltst einen alten, verwitterten Pflasterstein in der Hand, der "
   "mit etwas Moos bewachsen ist. An seiner Unterseite klebt noch etwas Erde.\n");
  SetProp(P_NAME, "Pflasterstein");
  SetProp(P_GENDER, MALE);
  AddId(({"stein","pflasterstein","DAXpflasterstein"}));
  SetProp(P_WEIGHT, 800+random(400));
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_ARTICLE, 1);
  
  AddDetail("moos","Etwas Moos waechst auf dem Stein.\n");
  AddDetail(({"erde","unterseite","seite"}),"An der Unterseite des Steins "
   "klebt noch etwas Erde.\n");
}