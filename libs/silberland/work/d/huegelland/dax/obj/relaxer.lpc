
inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

int timer;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp(P_SHORT,0);
  SetProp(P_LONG,0);
  SetProp(P_NAME, "Relaxer");
  SetProp(P_GENDER, MALE);
  AddId(({"\ndaxidrelaxer"}));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  timer=10;
	AddCmd(({"at","goto","home","nou","nordostunten","wob","westoben","verfolge"}),"stdfunc");
	AddCmd("+","stdfunc",1);
	AddCmd(({"steh","stehe"}),"endrelaxingfunc");
	call_out("relaxen",20);
}

int stdfunc()
{
	return write(BS("Vielleicht solltest Du zuerst aufstehen.\n")),1;
}

int endrelaxingfunc(string was)
{
	object stopper;
	stopper=clone_object("/d/huegelland/dax/wege/obj/relaxstop");
	notify_fail("Willst Du vielleicht aufstehen?\n");
	if (!was) return 0;
	if (was=="auf")
	{
		tell_object(ENV(TO),BS("Schweren Herzens entschliesst Du Dich, wieder aufzustehen. "
		 "Immerhin hast Du auch noch andere Dinge zu tun.\n"));
		stopper->move(ENV(TO),M_NOCHECK);
		TO->remove();
		return 1;
	}
	return 0;
}

int autoendrelax()
{
	object stopper;
	stopper=clone_object("/d/huegelland/dax/wege/obj/relaxstop");
	tell_object(ENV(TO),BS("Schweren Herzens entschliesst Du Dich, wieder aufzustehen. "
	 "Immerhin hast Du auch noch andere Dinge zu tun.\n"));
	stopper->move(ENV(TO),M_NOCHECK);
	TO->remove();
	return 1;
}

int relaxen()
{
	int relaxindex;
	relaxindex=random(10);
	if (!living(ENV(TO)))
	{
		TO->remove();
		return 1;
	}
	if (!timer)
	{
		TO->autoendrelax();
		return 1;
	}
	timer=timer-1;
	call_out("relaxen",20);
	ENV(TO)->SetProp(P_HP,1+random(4)+ENV(TO)->QueryProp(P_HP));
	ENV(TO)->SetProp(P_SP,1+random(4)+ENV(TO)->QueryProp(P_SP));
	if (relaxindex==1) return tell_object(ENV(TO),BS("Du geniesst die herrliche Ruhe.\n")),1;
	if (relaxindex==2) return tell_object(ENV(TO),BS("Du entspannst Dich.\n")),1;
	if (relaxindex==3) return tell_object(ENV(TO),BS("Du schlaefst fast ein.\n")),1;
	if (relaxindex==4) return tell_object(ENV(TO),BS("Warum kann es nicht ueberall so idyllisch sein?\n")),1;
	if (relaxindex==5) return tell_object(ENV(TO),BS("Du geniesst die Idylle.\n")),1;
	if (relaxindex==6) return tell_object(ENV(TO),BS("Du lauschst dem Rauschen des Meeres.\n")),1;
	if (relaxindex==7) return tell_object(ENV(TO),BS("Du beobachtest die Wolken.\n")),1;
	return 1;
}