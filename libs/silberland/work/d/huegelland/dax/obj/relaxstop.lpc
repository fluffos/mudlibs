
inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp(P_SHORT,0);
  SetProp(P_LONG,0);
  SetProp(P_NAME, "\ndaxidrelaxstop");
  SetProp(P_GENDER, MALE);
  AddId(({"\ndaxidrelaxstop"}));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
}

reset()
{
	::reset();
	TO->remove();
}