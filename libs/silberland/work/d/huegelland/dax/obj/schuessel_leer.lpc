
inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>


create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp(P_SHORT, "Eine leere Suppenschuessel");
  SetProp(P_LONG, 
   "Diese Schuessel hast Du aus der Foersterhuette gestohlen.\n"
   "Sie ist leer.\n");
  SetProp(P_NAME, "Suppenschuessel");
  SetProp(P_NAME_ADJ,"leer");
  SetProp(P_GENDER, FEMALE);
  AddId(({"schuessel","suppenschuessel","\ndaxidschuesselleer"}));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY,1);
  SetProp(P_ARTICLE, 1);
}