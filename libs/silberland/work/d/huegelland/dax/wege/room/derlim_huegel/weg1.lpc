inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

int buesche;
int stones;

create() {
  ::create();

  SetProp(P_INT_SHORT, "Auf einer gepflasterten Strasse" );
  SetProp(P_INT_LONG,
   "Du stehst hier auf einer recht breiten Pflasterstrasse. Zwischen den "
   "meisten Steinen waechst Gras und die Buesche am Strassenrand sehen "
   "ungepflegt aus. Wahrscheinlich wurde die Strasse lange nicht mehr "
   "benutzt. Am Strassenrand steht ein altes, morsches Holzschild. "
   "Im Osten fuehrt die Strasse durch ein Tor nach Derlim.\n");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_ROAD]) );
 
 	buesche=1;
 	stones=random(6);
 	
	AddCmd("nimm","steinfunc");
	AddCmd(({"kletter","klettere"}),"kletterfunc");
	AddCmd(({"entfern","entferne"}),"buschfunc");

	AddDetail(({"osten","derlim","stadt","heimatstadt"}),
	 ([0:"Im Osten liegt Derlim, die Heimatstadt der Hobbits. Man kan sie durch "
	 "das schwere Tor in der Hecke, die Derlim umgibt, erreichen.\n",
	 "hobbit":"Im Osten liegt Deine Heimatstadt Derlim, Du kannst sie durch das "
	 "schwere Tor betreten.\n"]));
	 
	AddDetail(({"hobbits","hobbit"}),([0:"Hobbits sind kleine, liebenswuerdige und pelzige Wesen "
	"die in Derlim leben.\n","hobbit":"Untersuch Dich am besten selbst.\n","troll":
	"Hobbits sind kleine, haessliche und pelzige Wesen, die in Derlim leben.\n",
	"oger":"Hobbits sind kleine, leckere und pelzige Wesen, die in Derlim leben.\n"]));

	AddDetail("seite","Welche Seite?\n");
	
	AddDetail(({"wesen","moeglichkeit"}),"Untersuch lieber wichtige Dinge.\n");
	
	AddDetail("dinge","Besser.\n");
	
	AddDetail("pfosten","Das Tor besteht aus schweren Pfosten, die lueckenlos "
	 "zusammengefuegtsind.\n");
	
	AddDetail(({"strauch","straeucher"}),"Du kannst von hier aus nicht genau erkennen, "
	 "welche Straeucher in der Hecke wachsen. Vielleicht solltest Du einmal von der "
	 "anderen Seite schauen.\n");
	
	AddDetail("tor","Das Tor besteht aus schweren Pfosten, steht aber weit offen. "
	 "Es ist direkt mit der dichten Hecke um Derlim verbunden und bildet die einzige "
	 "Moeglichkeit von dieser Seite aus nach Derlim zu kommen.\n");
	 
	AddDetail("hecke","Die Hecke, die ganz Derlim umgibt, besteht aus dichtestem "
	 "Gestruepp. Es sieht undurchdringlich aus. Du kannst verschiedenste Straeucher "
	 "erkennen.\n");
	 
	AddDetail("gestruepp","Undurchdringliches Gestruepp umgibt ganz Derlim. Nur dort, "
	 "wo die Strassen die Stadt verlassen, gibt es Luecken in der Hecke.\n");
	 
	AddDetail(({"luecke","luecken"}),"Direkt oestlich von Dir befindet sich ein davon!\n");
	
	AddDetail(({"strasse","pflasterstrasse","strassen","boden","weg"}),([0:
	 "Die Strasse besteht aus vielen Steinen, die nebeneinander ausgelegt sind. "
	 "Die meisten von ihnen sind locker und in den Fugen waechst das Gras "
	 "knoechelhoch.\n","fee":"Die Strasse besteht aus vielen Steinen, die "
	 "nebeneinander ausgelegt sind. Die meisten von ihnen sind locker und in den "
	 "Fugen waechst Gras.\n"]));
	 
	AddDetail(({"stein","steine","pflasterstein","pflastersteine"}),
	 "Die Steine der Strasse waren sicherlich einmal fest im Boden verankert, "
	 "aber jetzt sind die meisten von ihnen schon locker und mit Moos ueberzogen "
	 "Wahrscheinlich wird die Strasse schon lange nicht mehr gepflegt.\n");
	
	AddDetail("moos","Das Moos waechst auf den Pflastersteinen.\n");
	
	AddDetail("gras",([0:"Es waechst Dir schon fast bis zum Knoechel.\n","fee":
	 "Es waechst hier schon ziemlich hoch.\n"]));
	
	AddDetail(({"sonne","himmel","wolken","wolke","oben","tag"}),([0:"Hoch ueber "
	 "Dir steht die Sonne am Himmel. Es ist ein herrlicher Tag und es sind "
	 "nur wenige kleine Wolken zu sehen.\n","dunkelelf":"Unerbarmlich scheint "
	 "die Sonne vom Himmel herab. Du fuehlst Dich unwohl.\n"]));
	
	AddDetail(({"schild","holzschild","schrift"}),"Die Schrift ist zwar schon halb "
	 "verwittert, aber Du kannst trotzdem versuchen sie zu lesen.\n");
	
	AddReadDetail(({"schild","holzschild","schrift"}),"Alles was Du erkennen kannst, ist:\n" 
	 "\n"
	 "    --------------------\n"
	 "    |  .um Mar..pl..z  |\n"
	 "    |  <-------------  |\n"
	 "    |                  |\n"
	 "    |   Na.. D...im    |\n"
	 "    |   ----------->   |\n"
	 "    --------------------\n"
	 "             ||\n"
	 "             ||\n"
	 "\n");
	 
	AddDetail(({"busch","buesche","strassenrand","rand"}),"Am Strassenrand stehen "
	 "einige wilde Buesche. Sie sehen so aus, als haette sie irgendwann mal Jemand "
	 "gepflegt, allerdings muss das schon etwas laenger her sein. Ausserdem "
	 "steht hier ein altes Holzschild.\n");
	 
	AddDetail("jemand","Du weisst nicht Wer.\n");
	
	AddDetail("wer","Jemand.\n");
	 
	AddDetail(({"fuge","fugen"}),"Zwischen den lockeren Pflastersteinen waechst "
	 "Gras.\n");

	AddDetail("knoechel","Du solltest schon wissen, wo Deine Knoechel sind.\n");

	AddSound(DEFAULT_SOUND,"Du hoerst den Wind in den Bueschen rauschen.\n");
	
	AddDetail("wind","Du kannst ihn hoeren.\n");
	
	AddSound("wind","Als Du dem Wind zuhoerst, faellt Dir noch ein anderes, "
	 "sehr leises Geraeusch auf.\n");
	 
	AddDetail("geraeusch","Das ist ein Geraeusch, das kann man nicht sehen.\n");
	
	AddSound("geraeusch","Es klingt wie ein leises Plaetschern und scheint von "
	 "einigen Bueschen im Westen auszugehen.\n");
	 
	AddSound("plaetschern","Ein leises Plaetschern scheint aus dem Westen zu kommen.\n");
	
	AddDetail("westen","Du schaust Dir die Buesche im Westen genauer an, und entdeckst "
	 "zwischen zwei Bueschen im leicht ansteigenden Boden des Huegels ein kleines Loch, "
	 "gerade gross genug um vielleicht hindurch zu klettern.\n");
	 
	AddDetail(({"fuss","huegel"}),"Du stehst am Fuss eines grossen Huegels, der nach Westen hin "
	 "ansteigt.\n");
	 
	AddDetail("loch","Zwischen zwei Bueschen hast du ein Loch im Boden entdeckt, Du koenntest "
	 "vielleicht hindurchpassen.\n");

	AddExit("suedwestoben","/d/huegelland/dax/wege/room/derlim_huegel/weg2");
	AddExit("osten","/d/huegelland/raballion/hobbits/room/westtor");
	
	AddRoomMessage(({
	 "Der Wind rauscht durch die Buesche.\n",
	 "Du hoerst ein paar Voegel zwitschern.\n",
	 "War da etwas in den Bueschen?\n",
	 "Eine leichte Brise weht Dir entgegen.\n",
	 "Du fuehlst Dich wohl.\n"}),60);
	
	AddSound(({"vogel","voegel","zwitschern"}),"Ab und zu kannst Du ein paar Voegel hoeren.\n");
	
	AddDetail(({"vogel","voegel"}),"Ab und zu kannst Du ein paar Voegel zwitschern hoeren.\n");
}

int steinfunc (string was)
{
	object stein;
	stein=clone_object("/d/huegelland/dax/obj/stein_normal");
	if (!was) return 0;
	if (was=="stein"||was=="pflasterstein")
	{
		if (present("DAXpflasterstein",TO)) return 0;
		if (deep_present("DAXpflasterstein",TP)) return write(BS("Du hast doch schon einen Stein.\n")),1;
		if (!stones) return write(BS("Du findest keinen Stein der locker genug ist.\n")),1;
		if (stein->move(TP,M_GET)==ME_TOO_HEAVY) return write(BS("Du wuerdest gerne einen Stein "
		 "nehmen, aber er ist Dir zu schwer.\n")),1;
		stein->move(TP,M_GET);
		write(BS("Du suchst Dir einen besonders lockeren Stein und steckst ihn ein.\n"));
		say(BS(TP->name()+" fummelt einen Pflasterstein aus der Strasse.\n"),TP);
		stones=stones-1;
		return 1;
	}
	return 0;
}

int kletterfunc(string wohin)
{
	if (!wohin) return write(BS("Wohin willst Du klettern?\n")),1;
	if (wohin=="in loch"||wohin=="durch loch") 
	{
		if (buesche) return	write(BS("Die Buesche stoeren Dich, Du solltest Sie vorher entfernen. "
		 "Sei vorsichtig, Du koenntest Dich dabei verletzen!\n")),1;
		return write(BS("Der Weg nach westunten ist frei.\n")),1;
	}
	return write(BS("Wohin willst Du klettern?\n")),1;
}

int buschfunc(string input)
{
	if (!input) return write(BS("Was willst Du entfernen?\n")),1;
	if (input=="buesche")
	{
		if (buesche)
		{
			buesche=0;
			if (random(20)>10)
			{
				write(BS("Mit aller Gewalt reisst Du die Buesche aus dem Boden, allerdings "
				 "verletzt Du dich dabei leicht.\n"));
				say(BS(TP->name()+" reisst mit aller Gewalt zwei Buesche aus dem Boden, "
				 "allerdings scheint "+TP->QueryPronoun(WER)+" sich dabei verletzt zu haben.\n"));
				TO->SetProp(P_KILL_NAME, "Eine kleine Verletzung");
				TP->do_damage(random(35));
				TO->SetProp(P_KILL_NAME,0);
				TO->freischaltfunc();
				return 1;
			}
			write(BS("Vorsicht entfernst Du die Buesche aus dem Boden.\n"));
			say(BS(TP->name()+" entfernt vorsichtig ein paar Buesche aus dem Boden.\n"),TP);
			TO->freischaltfunc();
			return 1;			
		}
		return write(BS("Was willst Du entfernen?\n")),1;
	}
	return write(BS("Was willst Du entfernen?\n")),1;
}

void freischaltfunc()
{
	TO->AddExit("westunten","/d/huegelland/dax/cave1/room/cave1");
	TO->RemoveDetail("loch");
	TO->RemoveDetail("westen");
	TO->AddDetail("loch","Im Westen hast du ein Loch im Boden entdeckt, Du koenntest "
   "vielleicht hindurchpassen.\n");
  TO->AddDetail("westen","Im Westen befindet sich im leicht ansteigenden Boden des "
   "Huegels ein kleines Loch, gerade gross genug um vielleicht hindurch zu klettern.\n");
}

reset()
{
	::reset();
	TO->RemoveExit("westunten");
	TO->RemoveDetail("loch");
	TO->RemoveDetail("westen");
	TO->AddDetail("westen","Du schaust Dir die Buesche im Westen genauer an, und entdeckst "
	 "zwischen zwei Bueschen im leicht ansteigenden Boden des Huegels ein kleines Loch, "
	 "gerade gross genug um vielleicht hindurch zu klettern.\n");
	TO->AddDetail("loch","Zwischen zwei Bueschen hast du ein Loch im Boden entdeckt, Du koenntest "
	 "vielleicht hindurchpassen.\n");
 	stones=random(6);
}