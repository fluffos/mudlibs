inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

int stones;

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einer gepflasterten Strasse" );
  SetProp( P_INT_LONG,
   "Du laeufst eine gepflasterte Strasse entlang, die den Huegel im "
   "Nordosten hinauffuehrt. Im Osten kannst Du Derlim erkennen, im Norden "
   "siehst Du kleine Stuecke vom Meer. Die Strasse ist von Bueschen und "
   "vereinzelten Baeumen gesaeumt.\n");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_ROAD]) );
  
  stones=random(6);

	AddCmd("nimm","steinfunc");
	AddCmd(({"entspanne","entspann","relax","relaxe"}),"relaxfunc1");
	AddCmd(({"sitz","sitze","setz","setz"}),"relaxfunc2");
	
	AddDetail(({"strasse","pflasterstrasse","strassen","boden","weg"}),([0:
	 "Die Strasse besteht aus vielen Steinen, die nebeneinander ausgelegt sind. "
	 "Die meisten von ihnen sind locker und in den Fugen waechst das Gras "
	 "knoechelhoch.\n","fee":"Die Strasse besteht aus vielen Steinen, die "
	 "nebeneinander ausgelegt sind. Die meisten von ihnen sind locker und in den "
	 "Fugen waechst Gras.\n"]));
	
	AddDetail(({"stein","steine","pflasterstein","pflastersteine"}),
	 "Die Steine der Strasse waren sicherlich einmal fest im Boden verankert, "
	 "aber jetzt sind die meisten von ihnen schon locker und mit Moos ueberzogen "
	 "Wahrscheinlich wird die Strasse schon lange nicht mehr gepflegt.\n");

	AddDetail(({"osten","derlim","stadt","heimatstadt"}),
	 ([0:"Im Osten liegt Derlim, die Heimatstadt der Hobbits.\n",
	 "hobbit":"Im Osten liegt Deine Heimatstadt Derlim.\n"]));
	 	
	AddDetail("jemand","Du weisst nicht Wer.\n");
		
	AddDetail("wer","Jemand.\n");
	
	AddDetail("gras",([0:"Es waechst Dir schon fast bis zum Knoechel.\n","fee":
   "Es waechst hier schon ziemlich hoch.\n"]));

	AddDetail(({"sonne","himmel","wolken","wolke","oben","tag"}),([0:"Hoch ueber "
	 "Dir steht die Sonne am Himmel. Es ist ein herrlicher Tag und es sind "
	 "nur wenige kleine Wolken zu sehen.\n","dunkelelf":"Unerbarmlich scheint "
	 "die Sonne vom Himmel herab. Du fuehlst Dich unwohl.\n"]));
	 
	AddDetail("huegel","Direkt vor Dir steigt die Landschaft in Richtung Nordwesten "
	 "an. Du kannst noch nicht erkennen was sich auf dem Huegel befindet, da er von "
	 "einer Menge Bueschen umgeben ist.\n");

	AddDetail("knoechel","Du solltest schon wissen, wo Deine Knoechel sind.\n");	 

	AddDetail("menge","Um den Huegel herum wachsen viel verschiedenen Buesche.\n");

	AddDetail(({"hobbits","hobbit"}),([0:"Hobbits sind kleine, liebenswuerdige und pelzige Wesen "
 	 "die in Derlim leben.\n","hobbit":"Untersuch Dich am besten selbst.\n","troll":
	 "Hobbits sind kleine, haessliche und pelzige Wesen, die in Derlim leben.\n",
	 "oger":"Hobbits sind kleine, leckere und pelzige Wesen, die in Derlim leben.\n"]));
	 
	AddDetail(({"busch","buesche","strassenrand","rand"}),"Am Strassenrand stehen "
	 "einige wilde Buesche. Sie sehen so aus, als haette sie irgendwann mal Jemand "
	 "gepflegt, allerdings muss das schon etwas laenger her sein.\n");
	 
	AddDetail(({"baum","baeume","zuhause"}),([0:"Vereinzelt stehen hier einige Baeume. Zusammen mit dem "
	 "Blick aufs Meer ist das hier eine herrliche Idylle.\n",
	 "dunkelelf":"Vereinzelt stehen hier einige Baeume. "
	 "Zusammen mit dem Blick aufs Meer ist das hier fuer andere sicherlich ein Idylle, aber Dir ist "
	 "es viel zu hell und soetwas interessiert Dich nicht. Zuhause ist es viel gemuetlicher und "
	 "dunkel.\n"]));
	 
	AddDetail(({"meer","stueck","stuecke","norden"}),([0:"Zwischen den Baeumen und Bueschen die hier wachsen "
	 "kannst Du ein paar Stuecke des Meeres im Norden erkennen. Eine herrliche Idylle.\n",
	 "dunkelelf":"Zwischen den Baeumen und Bueschen die hier wachsen "
	 "kannst Du ein paar Stuecke des Meeres im Norden erkennen.\n"]));
	
	AddDetail(({"idylle","landschaft"}),([0:"Es ist einfach herrlich hier. Du koenntest dich glatt ein wenig an "
	 "den Strassenrand setzen und etwas entspannen.\n","dunkelelf":"Es koennte hier richtig herrlich sein, und "
	 "Du wuerdest dich glatt ein wenig ausruhen, wenn da nicht die nervige Sonne waere.\n"]));
	 
	AddDetail(({"fuge","fugen"}),"Zwischen den lockeren Pflastersteinen waechst "
	 "Gras.\n");
	 
	AddDetail("wesen","Untersuch lieber wichtige Dinge.\n");
	
	AddDetail("dinge","Besser.\n");
	
  AddExit("nordostunten","/d/huegelland/dax/wege/room/derlim_huegel/weg1");
  AddExit("westoben","/d/huegelland/dax/wege/room/derlim_huegel/weg3");
  
  AddSound(DEFAULT_SOUND,"Ausser dem Wind, der durch die Baeume "
   "und Buesche weht, kannst Du ab und zu etwas Meeresrauschen hoeren.\n");
   
  AddSound("wind","Der Wind weht hier zwar staendig aber dafuer nur leicht durch die Buesche "
   "und Baeume und verstaerkt die Idylle hier damit nur noch mehr.\n");
  
  AddSound(({"rauschen","meer","meeresrauschen"}),"Ab und zu hoerst Du, wie das Meer im Norden "
   "leise rauscht.\n");

	AddSound(({"zwitschern","voegel","gezwitscher"}),"Du kannst hin und wieder irgendwo ein paar "
	 "Voegel zwitschern hoeren.\n");
	 
	AddDetail("brise","Eine spuerst ein leichte angenehme Brise vom Meer herueberwehen.\n");
	
	AddDetail("blick","Dein Blick wandert vom Huegel im Nordwesten ueber das Meer im Norden langsam "
	 "nach Osten in Richtung Derlim. Eine herrliche Landschaft.\n");
	 
	AddDetail(({"vogel","voegel"}),"Ab und zu kannst Du ein paar Voegel zwitschern hoeren.\n");
	
	AddRoomMessage(({
	"Eine leichte Brise weht durch die Baeume.\n",
	"Eine leichte Brise weht durch die Buesche.\n",
	"Du kannst das Meer rauschen hoeren.\n",
	"Es ist herrlich hier.\n",
	"Ein paar Voegel zwitschern irgendwo.\n"}),60);
}

int steinfunc (string was)
{
	object stein;
	stein=clone_object("/d/huegelland/dax/obj/stein_normal");
	if (!was) return 0;
	if (was=="stein"||was=="pflasterstein")
	{
		if (present("DAXpflasterstein",TO)) return 0;
		if (deep_present("DAXpflasterstein",TP)) return write(BS("Du hast doch schon einen Stein.\n")),1;
		if (!stones) return write(BS("Du findest keinen Stein der locker genug ist.\n")),1;
		if (stein->move(TP,M_GET)==ME_TOO_HEAVY) return write(BS("Du wuerdest gerne einen Stein "
		 "nehmen, aber er ist Dir zu schwer.\n")),1;
		stein->move(TP,M_GET);
		write(BS("Du suchst Dir einen besonders lockeren Stein und steckst ihn ein.\n"));
		say(BS(TP->name()+" fummelt einen Pflasterstein aus der Strasse.\n"),TP);
		stones=stones-1;
		return 1;
	}
	return 0;
}

int relaxfunc1(string was)
{
	if (was) return 0;
	if (deep_present("\ndaxidrelaxer",TP)) return write(BS("Du entspannst Dich doch schon.\n")),1;
	if (deep_present("\ndaxidrelaxstop",TP)) return write(BS("Du willst nicht schon wieder "
	 "Zeit vergeuden und Dich hier entspannen. Auch wenn die Idylle herrlich ist.\n")),1;
	if (TP->QueryProp(P_RACE)=="dunkelelf") return write(BS("Es ist Dir hier viel zu hell und zu "
	 "ungemuetlich um Dich richtig entspannen zu koennen.\n")),1;
	TO->relaxfunc();
	return 1;
}

int relaxfunc2(string was)
{
	notify_fail("Wohin willst Du Dich setzen? Vielleicht an den Strassenrand?\n");
	if (!was) return 0;
	if (was=="an strassenrand"||was=="dich an strassenrand"||was=="an den strassenrand"||
			was=="dich an den strassenrand")
	{
		if (deep_present("\ndaxidrelaxer",TP)) return write(BS("Du entspannst Dich doch schon.\n")),1;
		if (deep_present("\ndaxidrelaxstop",TP)) return write(BS("Du willst nicht schon wieder "
	 	 "Zeit vergeuden und Dich hier entspannen. Auch wenn die Idylle herrlich ist.\n")),1;
		if (TP->QueryProp(P_RACE)=="dunkelelf") return write(BS("Es ist Dir hier viel zu hell und zu "
		 "ungemuetlich um Dich richtig entspannen zu koennen.\n")),1;
		TO->relaxfunc();
		return 1;
	}
	return 0;
}

void relaxfunc()
{
	object relaxer;
	relaxer=clone_object("/d/huegelland/dax/obj/relaxer");
	relaxer->move(TP,M_NOCHECK);
	write(BS("Du setzt Dich an den Strassenrand und entspannst ein wenig. Du geniesst den "
	 "herrlichen Blick auf das Meer, die klare Luft und das Zwitschern der Voegel irgendwo "
	 "auf dem Huegel.\n"));
	say(BS(TP->name()+" setzt sich an den Strassenrand und scheint sich zu entspannen.\n"));
}

reset()
{
	::reset();
	stones=random(6);
}