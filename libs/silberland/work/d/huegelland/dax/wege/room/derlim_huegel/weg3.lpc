inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>

int stones;

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einer gepflasterten Strasse" );
  SetProp( P_INT_LONG,
   "Die Pflasterstrasse, endet hier in Richtung Westen auf einem grossen Platz "
   "mitten auf dem Huegel. Im Osten schlaengelt sie sich den Hang hinunter in Richtung "
   "Derlim, der Stadt der Hobbits. Um Dich herum stehen die verschiedensten Buesche und "
   "Baeume und Du hast von hier aus einen fantastischen Ausblick auf die Stadt und das "
   "Meer. Hinter dem Huegel kannst du jetzt auch einen Berg erkennen.\n");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_ROAD]) );
  
  AddCmd("nimm","steinfunc");
  AddCmd(({"entspanne","entspann","relax","relaxe"}),"relaxfunc1");
	AddCmd(({"sitz","sitze","setz","setz"}),"relaxfunc2");
  
  AddDetail(({"strasse","pflasterstrasse","weg","boden"}),"Die Strasse besteht aus vielen "
  "Pflastersteinen, die nebeneinander ausgelegt wurden. Wahrscheinlich war diese Strasse "
  "einmal gut gepflegt und stabil, aber jetzt sind die meisten Steine schon locker und "
  "mit Moos ueberzogen. Zwischen den Pflastersteinen waechst Gras.\n");
  
  AddDetail(({"steine","stein","pflasterstein","pflastersteine"}),"Die Steine der Strasse "
  "sind schon sehr verwittert und mit Moos ueberzogen. Als Du sie genauer untersuchst, "
  "stellst Du fest, das die meisten Steine schon recht locker sind. Auf der ganzen "
  "Strasse waechst Gras zwischen den Steinen.\n");
  
  AddDetail("gras","Das Gras waechst hier gruen und saftig wie auf einer Wiese zwischen "
  "den Pflastersteinen. Hier scheint sich schon lange Niemand mehr um die Strasse gekuemmert "
  "zu haben.\n");
  
  AddDetail(({"himmel","wolke","sonne","oben","wolken","wetter"}),([0:"Die Sonne steht hoch am Himmel "
  "und scheint auf Dich herab. Du kannst fast keine Wolken erkennen und die wenigen, die Du "
  "siehst sind weit entfernt. Bestes Wetter um sich ein wenig auszuruhen.\n",
  "dunkelelf":"Die Sonne scheint unerbarmlich auf Dich herab Du kannst weit und breit keine "
  "Wolke erkennen, die sich in naechster Zeit vor die Sonne schieben koennte. Du wuenschst "
  "Dich in eine dunkle Hoehle.\n"]));
  
  AddDetail("hoehle",([0:"Sowas siehst Du da nicht!\n","dunkelelf":"Eine kleine, dunkle "
  "Hoehle waere bei diesem Wetter nicht schlecht.\n"]));
  
  AddDetail("niemand","Du kannst im Moment keinen sehen.\n");
  
  AddDetail("moment","Jetzt.\n");
  
  AddDetail(({"ausblick","blick"}),"Du kannst von hier aus das Meer im Norden und die Stadt "
  "im Osten gut erkennen. Im Nordwesten, hinter dem Huegel, kanst Du sogar etwas von dem Berg "
  "erkennen, wenn auch fast der gesamte Berg von Nebel umgeben ist.\n");
  
  AddDetail(({"meer","norden"}),([0:"Du hast einen herrlichen Ausblick auf das Meer im Norden. "
  "Es ist herrlich hier, Du koenntest Dich glatt ein wenig an den Strassenrand setzen und "
  "entspannen.\n","dunkelelf":"Du hast einen herrlichen Ausblick auf das Meer im Norden. "
  "Wenn es nicht so entsetzlich hell waere, koenntest Du dich glatt ein wenig an den "
  "Strassenrand setzen und entspannen.\n"]));
  
  AddDetail(({"rand","strassenrand"}),([0:"Am Strassenrand stehen viele verschiedene Buesche, Du kannst "
  "leider nicht herausfinden, was fuer Buesche das sind. Vereinzelt stehen hier auch einige Baeume "
  "herum. Du koenntest Dich glatt ein wenig an den Strassenrand setzen und etwas entspannen.\n",
  "dunkelelf":"Am Strassenrand stehen viele verschiedene Buesche, Du kannst leider nicht herausfinden, "
  "was fuer Buesche das sind. Vereinzelt stehen hier auch einige Baeume herum.\n"]));
  
  AddDetail("zeit","Irgendwann.\n");
  
  AddDetail(({"busch","buesche","baum","baeume"}),"Zwischen den unzaehligen Bueschen am Strassenrand "
  "wachsen vereinzelt Baeume, aber Du kannst weder die Baeume noch die Buesche irgendeiner Art, die "
  "kennst zuordnen. Allerdings faellt Dir an einem vereinzelten Busch etwas Merkwuerdiges auf.\n");
  
  AddDetail("art","Du weisst nicht, welcher Art die Baeume und Buesche hier angehoeren.\n");
  
  AddDetail("merkwuerdiges","Als Du Dir den vereinzelten Busch genauer anschaust erkennst Du, das er "
  "mit einer hauchduennen Kristallschicht ueberzogen ist, die allerdings extrem stabil zu sein "
  "scheint. Du fragst Dich nur, woher hier Kristalle kommen sollen.\n");
  
  AddDetail(({"kristall","kristalle","schicht","kristallschicht"}),"Alle Baeume und Buesche hier scheinen mit "
  "einer hauchduennen aber stabilen Kristallschicht ueberzogen zu sein. Sogar das Gras hat diese "
  "Schicht. Aber woher soll hier Kristall kommen?\n");

	AddDetail(({"osten","derlim","stadt","heimatstadt"}),
	([0:"Im Osten liegt Derlim, die Heimatstadt der Hobbits.\n",
	"hobbit":"Im Osten liegt Deine Heimatstadt Derlim.\n"]));
	
	AddDetail(({"hobbits","hobbit"}),([0:"Hobbits sind kleine, liebenswuerdige und pelzige Wesen "
 	 "die in Derlim leben.\n","hobbit":"Untersuch Dich am besten selbst.\n","troll":
	 "Hobbits sind kleine, haessliche und pelzige Wesen, die in Derlim leben.\n",
	 "oger":"Hobbits sind kleine, leckere und pelzige Wesen, die in Derlim leben.\n"]));

	AddDetail("wesen","Untersuch lieber wichtige Dinge.\n");
	
	AddDetail("dinge","Besser.\n");
	
	AddDetail(({"berg","nebel","nebelschwaden","schwaden","gefuehl"}),"Der Berg hinter dem Huegel ist fast "
	"komplett von Nebelschwaden umgeben. Du kannst von hier aus nicht erkennen, was sich dort befindet, "
	"aber du hast das Gefuehl das dort irgendetwas Wichtiges ist.\n");
	
	AddDetail("wichtiges","Du weisst nicht was, aber irgendetwas Wichtiges scheint sich auf dem "
	"Berg zu befinden.\n");
	
	AddDetail("moos","Die meisten Steine hier sind mit Moos ueberzogen.\n");
	
	AddDetail("hang","Im Osten windet sich die Strasse den Hang nach Derlim hinab. Von hier oben sieht der Huegel "
	"hoeher aus, als man von unten aus dachte.\n");
	
	AddDetail("huegel","Der Huegel, auf dem Du hier stehst, ist scheinbar gaenzlich von Bueschen bewachsen, "
	"die Strasse wird sicherlich auch bald unter ihnen verschwinden, wenn sie nicht bald gepflegt wird. "
	"Im Nordwesten erstreckt sich eine grosse Wiese, die in der Mitte durch Baeume getrennt "
	"zu sein scheint, ueber ein grosses Plateau.\n");
	
	AddDetail(({"mitte","wiese","plateau","nordwesten"}),"Die Wiese, die sich im Nordwesten ueber "
	"das Plateau erstreckt ist in der Mitte durch eine Reihe Baeume getrennt. Als Du Dir die Wiese "
	"genauer ansiehst, bemerkst Du, dass die Wiese eigentlich ein grosser Platz aus Pflastersteinen "
	"ist, aber schon voellig vom Gras ueberzogen wurde.\n");
	
	AddDetail("platz","Die Wiese im Nordwesten ist in eigentlich ein grosser Platz aus Pflastersteinen "
	"der nur ueber und ueber mit Gras bewachsen ist.\n");
	
	AddDetail(({"reihe","baumreihe"}),"Dazu musst Du schon naeher herangehen.\n");
	
	AddSound(DEFAULT_SOUND,"Du kannst das leise Rauschen des Meeres im Norden und den Wind, "
	"der durch die Baeume und Buesche weht, hoeren.\n");
	
	AddSound(({"rauschen","meer"}),"Du hoerst das Meer im Norden rauschen. Herrlich.\n");
	
	AddSound(({"baeume","baum","buesche","busch","wind"}),"Der Wind weht leise durch die "
	"Baeume und Buesche rund im die Wiese.\n");
	
	AddRoomMessage(({
	"Der Wind weht leise durch die Buesche.\n",
	"Es ist herrlich hier.\n",
	"War da etwas im Meer?\n",
	"Du atmest tief durch.\n",
	"Eine leichte Brise weht Dir entgegen.\n"}),60);

  AddExit( "ostunten", "/d/huegelland/dax/wege/room/derlim_huegel/weg2");
  AddExit( "westen", "/d/huegelland/dax/markt/room/m1");
  AddExit( "nordwesten","/d/huegelland/dax/markt/room/m3");
}

int steinfunc (string was)
{
	object stein;
	stein=clone_object("/d/huegelland/dax/obj/stein_normal");
	if (!was) return 0;
	if (was=="stein"||was=="pflasterstein")
	{
		if (present("DAXpflasterstein",TO)) return 0;
		if (deep_present("DAXpflasterstein",TP)) return write(BS("Du hast doch schon einen Stein.\n")),1;
		if (!stones) return write(BS("Du findest keinen Stein der locker genug ist.\n")),1;
		if (stein->move(TP,M_GET)==ME_TOO_HEAVY) return write(BS("Du wuerdest gerne einen Stein "
		 "nehmen, aber er ist Dir zu schwer.\n")),1;
		stein->move(TP,M_GET);
		write(BS("Du suchst Dir einen besonders lockeren Stein und steckst ihn ein.\n"));
		say(BS(TP->name()+" fummelt einen Pflasterstein aus der Strasse.\n"),TP);
		stones=stones-1;
		return 1;
	}
	return 0;
}

int relaxfunc1(string was)
{
	if (was) return 0;
	if (deep_present("\ndaxidrelaxer",TP)) return write(BS("Du entspannst Dich doch schon.\n")),1;
	if (deep_present("\ndaxidrelaxstop",TP)) return write(BS("Du willst nicht schon wieder "
	 "Zeit vergeuden und Dich hier entspannen. Auch wenn die Idylle herrlich ist.\n")),1;
	if (TP->QueryProp(P_RACE)=="dunkelelf") return write(BS("Es ist Dir hier viel zu hell und zu "
	 "ungemuetlich um Dich richtig entspannen zu koennen.\n")),1;
	TO->relaxfunc();
	return 1;
}

int relaxfunc2(string was)
{
	notify_fail("Wohin willst Du Dich setzen? Vielleicht an den Strassenrand?\n");
	if (!was) return 0;
	if (was=="an strassenrand"||was=="dich an strassenrand"||was=="an den strassenrand"||
			was=="dich an den strassenrand")
	{
		if (deep_present("\ndaxidrelaxer",TP)) return write(BS("Du entspannst Dich doch schon.\n")),1;
		if (deep_present("\ndaxidrelaxstop",TP)) return write(BS("Du willst nicht schon wieder "
	 	 "Zeit vergeuden und Dich hier entspannen. Auch wenn die Idylle herrlich ist.\n")),1;
		if (TP->QueryProp(P_RACE)=="dunkelelf") return write(BS("Es ist Dir hier viel zu hell und zu "
		 "ungemuetlich um Dich richtig entspannen zu koennen.\n")),1;
		TO->relaxfunc();
		return 1;
	}
	return 0;
}

void relaxfunc()
{
	object relaxer;
	relaxer=clone_object("/d/huegelland/dax/obj/relaxer");
	relaxer->move(TP,M_NOCHECK);
	write(BS("Du setzt Dich an den Strassenrand und entspannst ein wenig. Du geniesst den "
	 "herrlichen Blick auf das Meer, die klare Luft und das Zwitschern der Voegel irgendwo "
	 "auf dem Huegel.\n"));
	say(BS(TP->name()+" setzt sich an den Strassenrand und scheint sich zu entspannen.\n"));
}

reset()
{
	::reset();
	stones=random(6);
}