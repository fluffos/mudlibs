
inherit "std/room";

#include "../weinberg.h"

string *barfuss;

void create()
{

::create();

  SetProp(P_INT_SHORT, "In einem Weinkeller");
  SetProp(P_INT_LONG, 
    "Du stehst am Eingang des sagenumwobenen Weinkellers von Derlim. "
    "Die Waende sind aus rotem Backstein und fuehlen sich kalt und auch etwas "
    "nass an, was zumindest den modrigen Geruch hier erklaeren wuerde. "
    "Die Decke ist nicht sehr hoch, dafuer aber in der Mitte "
    "leicht nach oben gewoelbt. Ueber dem Durchgang nach Norden haengt " 
    "eine kleine Tafel, auf die etwas gekritzelt wurde. "); 
  
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1 );

  AddExit( "norden", ROOM "wk2");

// metallkueberl wasser drin (specialdetail) zum putzen fuer presse! 
 
// DETAILBEGINN


  AddDetail( ({ "eingang" }),
    "Du stehst direkt am Eingang des Weinkellers. ");

  AddDetail( ({ "weinkeller", "keller" }),
    "Der beginnt hier, und erstreckt sich weiter nach Norden. Geh ihn doch "
    "einfach mal naeher erkunden. ");

  AddDetail( ({ "tafel" }),
    "Eine kleine Tafel aus Holz haengt ueber dem Durchgang im Norden. Du "
    "kannst sie sicherlich lesen. ");

  AddReadDetail( ({ "tafel" }),
    "\n"
    "+----------------------------------------+\n"
    "| Im Wasser kannst Du Dein Antlitz sehn, |\n"
    "|   im Wein des andern Herz erspaehn.    |\n"
    "+----------------------------------------+\n"
    "\n");

  AddDetail( ({ "decke" }),
    "Die Decke hier ist nicht sehr hoch, aber dafuer in der Mitte "
    "leicht gewoelbt. Sie besteht genauso wie die Waende aus rotem "
    "Backstein. ");

  AddDetail( ({ "backstein", "backsteine" }),
    "Das Gemaeuer hier besteht aus rotem Backstein, der allerdings sicherlich "
    "erst spaeter seinen Weg in den Weinkeller fand. Anfangs bestand dieser "
    "naemlich nur aus Erde und Lehm. ");

  AddDetail( ({ "erde", "lehm" }),
    "Frueher bestand der Keller nur aus Erde und Lehm, erst spaeter wurde "
    "er mit Backsteinen 'verkleidet'. ");

  AddDetail( ({ "weg" }),
    "Die Backsteine fanden ihren Weg erst spaet hier her. Hoffentlich "
    "findest Du Deinen frueher. ");

  AddDetail( ({ "boden" }),
    "Der Boden unter Deinen Fuessen ist steinhart und kalt. Barfuss hier "
    "rumzulaufen waere sicherlich nicht ratsam. ");

  AddDetail( ({ "gemaeuer" }),
    "Waende und Decke bilden hier zusammen das 'Gemaeuer', dass aus rotem "
    "Backstein besteht. "); 

  AddDetail( ({ "holz" }),
    "Du pruefst das Holz eingehend, und stellst fest, dass es sich hierbei "
    "um Eichenholz handelt. ");

  AddDetail( ({ "eichenholz" }),
    "Das Holz der Eichen ist sehr beliebt bei den Winzern. Es wird "
    "hauptsaechlich fuer die Verarbeitung von Faessern verwendet, da der Wein "
    "in jenen aus Eichenholz noch besser heranreift. ");

  AddDetail( ({ "faesser", "eichenholzfaesser", "fass" }),
    "Hier kannst Du keine Faesser sehen, aber vielleicht woanders in diesem "
    "Keller. ");

  AddDetail( ({ "winzer" }),
    "Die meisten Winzer verwenden Eichenholz fuer ihre Faesser. ");

  AddDetail( ({ "wein" }),
    "Wein ist wahrlich ein Lebenselixier. Hoffentlich hast Du hier auch "
    "die Moeglichkeit welchen zu kosten. ");

  AddDetail( ({ "moeglichkeit" }),
    "Hoffentlich bietet sich Dir hier eine Moeglichkeit um guten Wein "
    "zu verkosten. ");

  AddDetail( ({ "lebenselixier", "elixier" }),
    "Wein (in maessigen Mengen genossen,) kann der Gesundheit des Menschen "
    "durchaus zutraeglich sein :) ");

  AddDetail( ({ "mengen", "menge" }),
    "Solange man nicht zuviel trinkt, ist der Wein fuer die Gesundheit "
    "foerderlich. ");

  AddDetail( ({ "gesundheit" }),
    "Wein hat unter anderem eine antibakterielle und gefaesschuetzende "
    "Wirkung. Ein Achterl pro Tag senkt das Herzinfarkt Risiko um 38 Prozent. "
    "Es gibt bestimmt hunderte von Rezepte mit Wein, die im Alltag alle "
    "ziemlich nuetzlich sein koennten. ");

  AddDetail( ({ "rezepte" }),
    "z.B.: Der Wein der Kleopatra: Dabei wird der Wein mit "
    "Nachtschattengewaechsen versetzt und dient als Liebenstrank und Droge. "
    "Die Chinesen wiederum mischen den Wein mit Hanfoel und verwenden ihn "
    "als Beruhigungsmittel. ");

  AddDetail( ({ "achterl" }),
    "1/8l Wein!");

  AddDetail( ({ "kleopatra", "cleopatra" }),
    "Diese Dame wusste schon wie sie es sich am besten richtete.");

  AddDetail( ({ "dame" }),
    "Kleopatra!");

  AddDetail( ({ "nachtschattengewaechse", "nachtschattengewaechs" }),
    "Zu den Nachtschattengewaechsen gehoeren unter anderem der Stechapfel und "
    "die Tollkirsche - aber auch die Paradeispflanze.");

  AddDetail( ({ "tollkirsche", "stechapfel" }),
    "Vielleicht findest Du in der Bibliothek der Hexen mehr darueber.");

  AddDetail( ({ "hexen", "bibliothek" }),
    "Weder die Hexen noch die Bibliothek ist hier. Erforsche doch erst einmal "
    "den Weinkeller.");

  AddDetail( ({ "paradeispflanze", "tomatenpflanze" }),
    "Paradeispflanze = Tomatenpflanze.");

  AddDetail( ({ "pflanze" }),
    "Welche meinst Du?");

  AddDetail( ({ "chinesen", "hanfoel", "beruhigungsmittel" }),
    "Hier kannst Du so etwas nicht entdecken.");

  AddDetail( ({ "mein weg" }),
    "Hoffentlich findest Du, was Du suchst.");

  AddDetail( ({ "dein weg" }),
    "Meiner?!");

  AddDetail( ({ "fuesse", "fuss" }),
    "Der Boden unter Deinen Fuessen ist steinhart und kalt. Du hast "
    "hoffentlich gutes Schuhwerk dabei.");

  AddDetail( ({ "schuhwerk", "schuhe" }),
    "Ohne gutes Schuhwerk in einem Keller rumzulaufen ist nicht sehr ratsam.");

   
   

  
      
  AddCmd( ({ "lauf", "laufe" }), "c_laufen");
    
  barfuss = ({});
}

void reset()
{
  ::reset();

  barfuss = ({});
}


int c_laufen (string str)

{
	object *schuhe;
	int spieler_ist_barfuss;

   	spieler_ist_barfuss = 1;

	if(str != "barfuss"  )
	{
		notify_fail("Wie willst Du laufen? Barfuss?\n");
		return 0;
	}
	if(TP->QueryProp(P_ARMOURS) )
 	{
         schuhe=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_BOOT);
   	 if (sizeof(schuhe) && objectp(schuhe[0]))
    	 {
    	   spieler_ist_barfuss = 0;
   	 }
  	 else
     	 {
       	   spieler_ist_barfuss = 1;
     	 }
  	}
	if(spieler_ist_barfuss)
	{
	 write(BS("Du laeufst barfuss ueber den kalten und harten Boden. "
		  "Verdammt, jetzt hast Du Dich an einem spitzen Stein "
		  "geschnitten!"));
	 TP->do_damage(10);
	 return 1;
	}
	else
	{
		write(BS("Aber Du bist doch gar nicht barfuss!"));
		return 1;
	}
}

				


 
