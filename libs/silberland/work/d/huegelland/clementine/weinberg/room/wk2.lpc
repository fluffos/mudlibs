
inherit "std/room";

#include "../weinberg.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In einem Weinkeller");
  SetProp(P_INT_LONG, 
    " " );
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1 );

  AddExit( "osten", ROOM "wk5");
  AddExit( "norden", ROOM "wk4");
  AddExit( "sueden", ROOM "wk1");

  NewDoor( "westen", ROOM "wk3", ({ "gittertuer", "gitter", "tuer", 
                                       "eisengitter" }),
    ({ D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL | DOOR_NEEDKEY |
       DOOR_CLOSEKEY,
       D_NAME, "Eisengitter",
       D_GENDER, NEUTER,
       D_SHORT, "Im Westen befindet sich ein %se Eisengitter.",
       D_LONG, "Das Gitter besteht aus stabilem Eisen. Ein grosses Schloss "
               "haengt daran. ",
       D_MSGS, ({ "nach Westen", "geht", "kommt herein" }),
       D_OPENMSG, ({ "Du sperrst das grosse Schloss auf und oeffnest das "
                     "Gitter. ",
                     "%s oeffnet das Eisengitter.",
                     " wird von aussen geoeffnet. " }),
       D_CLOSEMSG, ({ "Mit einem lauten Rumms schliesst Du das Gitter.",
                      "Mit einem lauten Rumms schliesst %s das Gitter.",
                      " wird mit einem lauten Rumms von aussen geschlossen." }),
       D_RESET_CLOSEMSG, " wird durch einen Windstoss geschlossen. " }) );


        


}

