inherit "std/room";

#include <properties.h>
#include <language.h>
#include "../weinberg.h"

create()
{

::create();

  SetProp(P_INT_SHORT, "In einem Keller");
  SetProp(P_INT_LONG,
    "Vor Dir breitet sich ein grosses Kellergewoelbe aus. Seine "
    "Waende bestehen aus roten Backsteinen, die mit Kalkmoertel verputzt "
    "und spaeter bemalt wurden. Riesige Eichenfaesser liegen auf dem erdigen "
    "Boden, in denen sicherlich verschiedene Weine und Schnaps gelagert "
    "werden. Einige vollbeladene Regale stehen an der Wand. In ihnen befinden "
    "sich viele Flaschen und Schachteln, aber auch Obststeigen kannst Du "
    "erkennen. Mehrere grosse weisse Saecke stapeln sich uebereinander in "
    "einer Ecke. In der Mitte des Raumes steht ein grosser Tisch, auf dem "
    "sich eine Kerze befindet, die die einzige Lichtquelle im Raum bildet. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1 );

  AddExit( "oben", "/d/ebene/Midas/room/kneipe_saal"); 

 
// DETAILBEGINN

  AddDetail( ({ "waende", "wand" }),
    "Die Waende bestehen alle aus roten Backsteinen, einige von ihnen wurden "
    "bunt bemalt, und verleihen dem Raum eine besondere Ausstrahlung. ");

  AddDetail( ({ "backsteine" }),
    "Der ganze Keller wurde aus Backsteinen verkleidet, die spaeter mit "
    "Moertel verputzt wurden. ");

  AddDetail( ({ "moertel", "kalkmoertel" }),
    "Mit ihm wurden die Waende des Kellers verputzt. Du kannst einige "
    "Malereien auf ihm erkennen. ");

  AddDetail( ({ "boden" }),
    "Der Boden besteht aus festgetrampelter Erde, etwas Staub hat sich schon "
    "auf ihm gebildet. ");

  AddDetail( ({ "staub" }),
    "Staub findest Du hier reichlich, anscheinend hat Max keine Putzfrau "
    "angestellt, und moechte selbst auch nicht gern putzen. ");

  AddDetail( ({ "putzfrau" }),
    "Das Leben einer Putzfrau ist hart, aber vielleicht solltest Du besser "
    "Erna danach fragen. ");

  AddDetail( ({ "erna" }),
    "Erna lebt momentan auf der Zombieinsel. ");

  AddDetail( ({ "zombieinsel", "insel" }),
    "Die solltest Du besser selbst suchen. ");

  AddDetail( ({ "max" }),
    "Max wird wohl gerade oben seine Gaeste bedienen. ");

  AddDetail( ({ "gaeste" }),
    "Max kennt sicherlich sehr viele Gaeste, manch mueder Wanderer hat "
    "bei ihm schon Halt gemacht, und ihm Geschichten aus der Welt erzaehlt. ");

  AddDetail( ({ "welt", "silberland" }),
    "Diese Welt nennt sich Silberland, aber das weisst Du ja sicherlich. ");

  AddDetail( ({ "halt" }),
    "Viele sind bereits bei Max eingekehrt um sich etwas von den Strapazen "
    "des Abenteuerlebens zu erholen. ");

  AddDetail( ({ "abenteuerleben" }),
    "Das Abenteuerleben ist manchmal nicht ungefaehrlich, man begegnet oft "
    "wilden und aggressiven Tieren. ");

  AddDetail( ({ "tiere" }),
    "Hier gibt es keine wilden Tiere, hoechstens irgendwelche Maeuse, die "
    "nach Nahrung suchen. ");

  AddDetail( ({ "nahrung" }),
    "Ein wahres Paradies fuer Maeuse. ");

  AddDetail( ({ "paradies" }),
    "Ueber das Paradies gibt es geteilte Meinungen, vielleicht solltest Du "
    "Dir Deine eigene bilden. ");

  AddDetail( ({ "meinungen", "meinung" }),
    "Ich bin der Meinung, dass Du zuviel forscht. ");

  AddDetail( ({ "maeuse" }),
    "Du kannst momentan keine erkennen. ");

  AddDetail( ({ "strapazen" }),
    "Das Leben birgt oft irgendwelche Strapazen, die es gilt zu bewaeltigen. ");

  AddDetail( ({ "geschichten" }),
    "Sicherlich viele unterschiedliche Geschichten, Max koennte darueber "
    "schon laengst Romane schreiben. ");

  AddDetail( ({ "romane" }),
    "Haette Max die Berufung zum Schriftsteller wuerde er sicherlich welche "
    "schreiben. ");

  AddDetail( ({ "berufung" }),
    "Er hat sie nicht, oder? ");

  AddDetail( ({ "schriftsteller" }),
    "Gibt es viele. ");

  AddDetail( ({ "wanderer" }),
    "Viele kehren bei Max auf ein Glaeschen ein, oder auch um eine "
    "warme Mahlzeit zu konsumieren. ");

  AddDetail( ({ "glaeschen" }),
    "Vielleicht auch zwei. ");

  AddDetail( ({ "mahlzeit" }),
    "Schau Dir doch einfach einmal die Speisekarte bei Max an, vielleicht "
    "entdeckst Du da ja etwas, dass Dich interessieren koennte. ");

  AddDetail( ({ "speisekarte", "karte" }),
    "Hier wirst Du keine finden. ");

  AddDetail( ({ "leben" }),
    "Hart und anstrengend. ");

  AddDetail( ({ "erde" }),
    "Der Boden besteht komplett aus festgetrampelter Erde, hier scheint "
    "wohl reger Verkehr zu herrschen. ");

  AddDetail( ({ "verkehr" }),
    "Max, der Wirt kommt wohl oft hier herunter um Lebensmittel oder Weine "
    "zu holen. ");

  AddDetail( ({ "wirt" }),
    "Max findest Du sicherlich oben in der Kneipe. ");

  AddDetail( ({ "kneipe" }),
    "Die Kneipe befindet sich genau ueber Dir. ");

  AddDetail( ({ "decke" }),
    "Die Decke ist befindet sich hoch ueber Dir, ein richtiges Gewoelbe, "
    "wie es sich fuer einen Keller gehoert. ");

  AddDetail( ({ "gewoelbe", "kellergewoelbe" }),
    "Da befindest Du Dich gerade. ");

  AddDetail( ({ "kerze" }),
    "Die Kerze steht auf dem Tisch, und bildet die einzige Lichtquelle "
    "im Raum. Ohne ihre Flamme waere hier wohl alles stockdunkel. ");

  AddDetail( ({ "flamme" }),
    "Das flackernde Licht der Kerze produziert ein lustiges Schattenspiel "
    "an der Wand. ");

  AddDetail( ({ "licht" }), 
    "Es geht von der Kerze aus, die auf dem Tisch steht. ");

  AddDetail( ({ "schattenspiel" }),
    "Es geht von der leicht flackernden Flamme der Kerze aus. ");

  AddDetail( ({ "lichtquelle" }),
    "Die Kerze ist die einzige hier. ");
 
  AddDetail( ({ "ecken", "ecke" }),
    "Der Raum hier hat vier Ecken, eine unterscheidet sich allerdings von "
    "den anderen. In ihr stapeln sich einige weisse Saecke, die eine "
    "Aufschrift tragen. ");

  AddDetail( ({ "keller" }),
    "Du befindest Dich doch gerade in ihm! ");

  AddDetail( ({ "mitte" }),
    "In der Mitte des Kellers steht ein grosser Tisch. ");

  AddDetail( ({ "tisch" }),
    "Ein alter Tisch steht in der Mitte des Raumes. Er besteht aus "
    "Birkenholz, wie Du sofort mit Deinem Kennerblick erkannt hast. Auf ihm "
    "befindet sich eine Kerze. ");

  AddDetail( ({ "kennerblick" }),
    "Den hast Du in muehevollster Arbeit gut geschult. ");

  AddDetail( ({ "birkenholz" }),
    "Eindeutig Birkenholz, vielleicht hat es sich Max aus Polaris liefern "
    "lassen. ");

  AddDetail( ({ "arbeit" }),
    "Es gibt immer viel zu tun. ");
 
  AddDetail( ({ "polaris" }),
    "Polaris liegt weit entfernt von Midas. ");

  AddDetail( ({ "midas" }),
    "Midas ist die Hauptstadt des Silberlandes, Du befindest Dich "
    "momentan gerade in ihr. ");

  AddDetail( ({ "hauptstadt" }),
    "Midas. ");

  AddDetail( ({ "ausstrahlung" }),
    "Wirklich etwas Besonderes, diese Malerei. ");

  AddDetail( ({ "besonderes" }),
    "Selten zuvor hast Du irgendwo aehnliches gesehen. ");

  AddDetail( ({ "aufschrift" }),
    "Wie waers mit lesen? ");

  AddDetail( ({ "pulver" }),
    "Weisses Pulver befindet sich um die Saecke auf dem Boden, Du bist "
    "Dir nun ziemlich sicher, dass es sich dabei um Mehl handelt. ");

  AddDetail( ({ "mehl" }),
    "Es muesste Mehl sein, da bist Du Dir ziemlich sicher. Vielleicht "
    "solltest Du dieses Pulver einmal kosten. ");

  AddDetail( ({ "raum", "raumes" }),
    "Du befindest Dich in einem Keller unter Max' Kneipe. Hier lagert "
    "er seine Vorraete. ");

  AddDetail( ({ "vorraete" }),
    "Ueberall findest Du verschiedenste Vorraete, schau Dich doch einfach "
    "naeher um. ");

  AddDetail( ({ "malereien", "malerei" }),
    "An den Waenden befinden sich einige Malereien - Weinreben, Karaffen und "
    "vieles mehr. Anscheinend haette dieser Keller einmal als reiner "
    "Weinkeller dienen sollen. ");

  AddDetail( ({ "weinreben", "karaffen" }),
    "Wirklich gut gelungen! ");

  AddDetail( ({ "weinkeller" }),
    "Der Keller wurde wohl urspruenglich als Weinkeller eingeplant, fand "
    "dann aber andere Verwendung. ");

  AddDetail( ({ "verwendung" }),
    "Er dient nun als Vorratskammer. ");

  AddDetail( ({ "vorratskammer" }),
    "Eindeutig. ");

  AddDetail( ({ "obststeigen", "steigen", "holzsteigen" }),
    "Kleine Holzsteigen befinden sich in den Regalen, sie sind voll gefuellt "
    "mit verschiedenem Obst. ");

  AddDetail( ({ "obst" }),
    "Hauptsaechlich Aepfel, Birnen und Orangen. ");

  AddDetail( ({ "aepfel", "birnen", "orangen" }),
    "Max benoetigt diese Dinge wohl zum Kochen. Es waere besser fuer Dich "
    "wenn Du Dich nicht an ihnen vergehst. ");

  AddDetail( ({ "dinge" }),
    "Viele. ");
  
  AddDetail( ({ "kochen" }),
    "Damit verdient Max seinen Lebensunterhalt. ");

  AddDetail( ({ "lebensunterhalt", "unterhalt" }),
    "Jedem das seine, aber mir das meiste, nicht wahr? ");

  AddDetail( ({ "regale", "regal" }),
    "Hohe vollbeladene Regale stehen an der Wand, sie sind vollgefuellt mit "
    "Lebensmittel und Getraenken. ");

  AddDetail( ({ "lebensmittel" }),
    "Alles was man in einer Kneipe so benoetigt. ");

  AddDetail( ({ "getraenke" }),
    "Sie befinden sich alle in den verschiedensten Flaschen. ");

  AddDetail( ({ "schachteln", "schachtel" }),
    "Auch in den Schachteln befinden sich Vorraete. Du solltest lieber "
    "nicht Deine Nase in alles reinstecken, sonst wird Max noch boese. ");

  AddDetail( ({ "nase" }),
    "Du bist eine neugierige. ");

  AddDetail( ({ "saecke", "sack" }),
    "In einer Ecke stapeln sich weisse Saecke uebereinander. Sie tragen alle "
    "eine Aufschrift. ");

  AddDetail( ({ "faesser", "eichenfaesser" }),
    "Riesige Eichenfaesser liegen auf dem erdigen Boden. In ihnen befinden "
    "sich sicherlich gute Weine oder Schnaepse. Ein besonderes grosses Fass "
    "erregt Deine Aufmerksamkeit. ");

  AddDetail( ({ "aufmerksamkeit" }),
    "Das grosse Fass erregt Deine Aufmerksamkeit, Du solltest es Dir naeher "
    "anschauen. ");
 
  AddDetail( ({ "fass" }),
    "Du trittst naeher an das grosse Fass heran. Es besteht wie die anderen "
    "auch aus Eichenholz, allerdings kannst Du an diesem hier einen komischen "
    "Hahn erkennen. Auf seiner Oberseite hat es ausserdem noch eine "
    "seltsame Oeffnung. ");

  AddDetail( ({ "hahn" }),
    "Den Hahn kann man auf- und zudrehen, damit der Wein rausfliesst. ");

  AddDetail( ({ "oberseite" }),
    "Auf der Oberseite des einen Fasses befindet sich eine seltsame "
    "Oeffnung, an die ein Trichter angebracht wurde. ");

  AddDetail( ({ "oeffnung" }),
    "An die Oeffnung wurde ein Trichter angebracht. ");

  AddDetail( ({ "trichter" }),
    "Der Trichter scheint wohl das Auffuellen des Fasses zu erleichtern. "
    "Mit seiner Hilfe schuettet man sicherlich nicht daneben. ");

  AddDetail( ({ "hilfe" }),
    "Brauchst Du welche? ");

  AddDetail( ({ "auffuellen" }),
    "Wenn Du einmal genug Wein hast, haette Max nichts dagegen wenn Du sein "
    "Fass auffuellst. Er wird sich bestimmt erkenntlich zeigen. ");

  AddDetail( ({ "schnaps", "schnaepse" }),
    "So manch edler Tropfen wird hier in den Faessern gelagert. ");

  AddDetail( ({ "tropfen" }),
    "Ob er Dir bekommen wuerde? ");

  AddDetail( ({ "eichenholz" }),
    "Die Faesser bestehen aus Eichenholz. ");

  AddDetail( ({ "wein", "weine" }),
    "Der Wein wird in den Faessern gelagert, so kann er auch richtig "
    "heranreifen. ");

  AddDetail( ({ "flaschen" }),
    "Viele Flaschen stehen in den Regalen, an einer ganz Du ein Etikett "
    "erkennen. ");

  AddDetail( ({ "etikett" }),
    "Da steht etwas drauf! ");
 
  AddDetail( ({ "altoel", "oel" }),
    "Wohl das Oel, dass beim Braten ueberbleibt. ");

  AddDetail( ({ "braten" }),
    "Ein Braten wuerde Dir jetzt gut bekommen. ");

  AddReadDetail( ({ "etikett" }),
    "--Altoel--");

  AddReadDetail( ({ "aufschrift" }),
    "*MEHL*\n"
    "Deshalb wohl das weisse Pulver auf dem Boden um die Saecke. ");

  AddDetail( ({ "duft" }),
    "Probiers mit riechen! ");

// DETAILENDE


// SOUNDS

  AddSound(DEFAULT_SOUND, 
    "Manchmal hoerst Du ein Glaeserklirren, dass von der Kneipe ueber Dir "
    "zu kommen scheint. Sonst ist es absolut ruhig. ");

  AddSound( ({ "glaeserklirren", "klirren" }),
    "Ueber Dir scheinen gerade einige Gaeste etwas bestellt zu haben. ");

  AddSound( ({ "kneipe" }),
    "Besser waere, wenn Du Dich nach oben begeben wuerdest. ");


// SMELLS

  AddSmell(DEFAULT_SMELL,  
    "Viele Gerueche vermischen sich hier, ein besonders intensiver suesslicher "
    "scheint aus dem Regal zu kommen. ");

  AddSmell( ({ "gerueche" }),
    "Der Duft von Holz vermischt sich mit dem von Schnaps, Wein und vielem "
    "mehr. ");

  AddSmell( ({ "regal", "regale" }),
    "Der intensive Duft scheint aus einer der Obststeigen zu kommen. ");

  AddSmell( ({ "obststeige", "obststeigen" }),
    "Igitt, da verfault ja eine Birne. ");

  AddSmell( ({ "birne" }),
    "Dein Magen schreit nach einer Entleerung. ");

  AddSmell( ({ "magen", "entleerung" }),
    "Das kannst Du nicht riechen! Das fuehlst Du! ");

  AddSmell( ({ "holz" }),
    "Der Geruch geht von den Faessern aus. ");

  AddSmell( ({ "faesser" }),
    "Holzig. ");

  AddSmell( ({ "schnaps", "wein" }),
    "Ein Glaeschen wuerde Dir jetzt gut bekommen. ");

  AddSmell( ({ "glaeschen" }),
    "Dazu muessest Du Dich schon nach oben begeben. ");
 


  AddCmd( ({ "fuehle", "fuehl" }), "c_fuehlen" );
  AddCmd( ({ "koste", "kost" }), "c_kosten" );
  AddCmd( ({ "puste", "pust" }), "c_pusten" );
 
 }


int c_pusten( string str )
{
 if( str != "kerze aus" )
 {
  notify_fail("Was moechtest Du auspusten?\n");
  return 0;
 }
 else
 {
  write(BS("Du versuchst mit aller Luft der Welt diese Kerze auszupusten, "
           "aber jedesmal entflammt sie sich von neuem. Scheint eine "
           "magische Kerze zu sein... "));
  return 1;
 }
}

int c_fuehlen( string str )
{
 if( str != "magen"      &&
     str != "entleerung" )
 {
  notify_fail("Was moechtest Du fuehlen?\n");
  return 0;
 }
 else
 {
  write(BS("Das fuehlt sich wirklich boesartig an, lieber schleunigst "
           "weg von hier! "));
  return 1;
 }
}

int c_kosten( string str )
{
 if( str != "pulver" )
 {
  notify_fail("Was moechtest Du kosten?\n");
  return 0;
 }
 else
 {
  write(BS("Vorsichtig schleckst Du Deine Fingerspitze ab und tauchst sie "
           "in das Pulver. Du steckst den Finger in den Mund, und stellst "
           "nun tatsaechlich fest, dass es sich hierbei um Mehl handelt. "));
  return 1;
 }
}
 
  
