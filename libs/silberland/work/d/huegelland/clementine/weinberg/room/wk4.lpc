
inherit "std/room";

#include "../weinberg.h"

create()
{

::create();

  SetProp(P_INT_SHORT, "In einem Weinkeller");
  SetProp(P_INT_LONG, 
    "Vor Dir breitet sich ein grosses Gewoelbe aus, in dem unzaehlige "
    "Faesser aus Eichenholz lagern. Sie haben alle ein kleines Taferl "
    "auf der Vorderseite, damit man auch weiss, was drinnen ist. "
    "An der Ostwand haengen diverse Geraetschaften, die man wohl alle "
    "fuer die Probe und Abfuellung der verschiedensten Weine benoetigt. "
    "Darunter steht eine kleine Truhe aus Holz. "); 
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 5, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1 );

  AddExit( "sueden", ROOM "wk2");

}

