#include "../def.h"

inherit "std/room";

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Im westlichen Huegelland" );
   SetProp( P_INT_LONG,
      "08: Ein gewaltiger Monolith liegt im " + RG8 + " ein kleiner Trampelpfad herum. "
      "Hinweise dass der Stein von einem Vulkan kommt! Mit Werkzeug koennte man einen "
      "Edelstein bekommen. Hier soll man nach oben klettern koennen."
      "."
      );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );


   AddExit( RK1, "nach "+ RG1 + "#" + ROOM + "weg07" );
   AddExit( RK7, "nach "+ RG7 + "#" + ROOM + "weg09" );
   
