#include "../def.h"

inherit "std/room";

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Im westlichen Huegelland" );
   SetProp( P_INT_LONG,
      "05: Hier geht es wieder runter ins Tal. In der Ferne " + RL6 + " ist ein grosser schwarzer "
      "Felsblock zu sehen."
      ""
      );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );


   AddCmd( ({ "wandere","wander" }), "zurBaumGruppe" );
//   AddCmd( ({ "biege","bieg" }), "biege" );
   
   SetProp( P_HIDE_EXITS, ({ RK6 }) );
   AddExit( RK3, "nach "+ RG3 + "#" + ROOM + "weg04" );
   AddExit( RK6, "nach "+ RG6U + "#" + ROOM + "weg06" );
   AddExit( RK6U, "nach "+ RG6U + "#" + ROOM + "weg06" );
   
