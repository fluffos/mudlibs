#include "../def.h"

inherit "std/room";

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Im westlichen Huegelland" );
   SetProp( P_INT_LONG,
      "13 : Der Weg laeuft an den Ufern eines kleiner See, der in Osten liegt, entlang. "
      "Hier kann man kleine runde Steine finden. Die Munition fuer die Steinschleuder."
      );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );


   AddExit( RK2, "nach "+ RG2 + "#" + ROOM + "weg12" );
   AddExit( RK5, "nach "+ RG5 + "#" + ROOM + "weg14" );
   
