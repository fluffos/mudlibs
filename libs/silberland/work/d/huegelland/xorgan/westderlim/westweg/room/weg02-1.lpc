// Xorgan@SilberLand
// Der Weg durch das westliche Huegelland
// 2003-09-20
// 

#include "../def.h"

inherit "std/room";

#include "../CheckPlayer.h"

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Das Ende der gepfasterten Strasse" );
   SetProp( P_INT_LONG,
      "Du befindest Dich im schoenen Huegelland. In der Naehe der Stadt der Hobbits. "
      "Im " + RG3 + " kannst Du schon die lebende Stadtmauer von Derlim erkennen. "
      "In entgegengesetzer Richtung findest Du die weiten des Huegellandes. "
      "Du wanderst auf einer schlecht gewarteten gepflasterten Strasse."
      );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );
   
   
   AddDetail( ({ "huegelland", "land" }),
      "Ein Land flacher als das Gebirge und steiler als die Ebene. Darin befindest "
      "Du Dich." );
   
   AddDetail( ({ "ebene", "gebirge", "gebiet" }),
      "Das ist ein anderes Gebiet und es ist weit weg." );
   
   AddDetail( ({ "naehe" }),
      "Du bist Dich nicht weit von der Hauptstadt der Hobbits entfernt. Das kannst "
      "Du schon daran erkennen, dass Du Dich auf einer gepflasterten Strasse "
      "befindest, wie es sei auch in Derlim gibt." );
   
   AddDetail( ({ "hauptstadt", "stadt", "derlim" }),
      "Derlim ist die Hauptstadt der Hobbits. Du befindest Dich nicht weit davon "
      "entfernt" );
   
   AddDetail( ({ "hobbits", "hobbit" }),
      "Ist die Rasse die Derlim hauptsaechlich bewohnt." );
   
   AddDetail( ({ "rasse", "rassen" }),
      "Es gbit viele Rassen im Silberland und eine davon sind die Hobbits." );
   
   AddDetail( ({ "strasse" }),
      "Diese Strasse ist mit Steinen gepflastert und war sicher einst ein gelungenes "
      "Zeugnis der Handwerkskunst der Hobbits, aber nun, da der Zahn der Zeit an ihr "
      "genagt hat, ist sie in schlechtem Zustand." );
   
   AddDetail( ({ "stein", "steine" }),
      "Fuer den Bau der Strasse wurden wuerfelfoermige Stein aus unterschiedlichem "
      "Material verwendet." );
   
   AddDetail( ({ "bau" }),
      "Beim Bau der Strasse wurden Pflastersteine verwendet." );
   
   AddDetail( ({ "material" }),
      "Das Material der Pflastersteine ist recht unterschiedlich und wurde in der "
      "naeheren Umgebung abgebaut." );
   
   AddDetail( ({ "pflastersteine", "pflasterstein" }),
      "Ein Pflasterstein ist ein wuerfelfoermiger geschlagener Stein." );
   
   AddDetail( ({ "umgebung" }),
      "Macht ja keinen Sinn die Stein fuer eine Strasse aus der Ferne zu hohlen." );
   
   AddDetail( ({ "sinn" }),
      "Nein, das waere wirklich sinnlos." );
   
   AddDetail( ({ "zeugnis", "handwerkskunst", "kunst", "strassenbaukunst", "baukunst" }),
      "Die Strassenbaukunst der Halblinge ist offensichtlich weit entwickelt "
      "und in ganzen Silberland bekannt!" );
   
   AddDetail( ({ "halbling", "halblinge", "bezeichnung" }),
      "Damit sind die Hobbits gemeint. Es ist nur eine andere Bezeichnung." );
   
   AddDetail( ({ "bezeichnung", "wort" }),
      "Das ist nur ein anderes Wort!" );
   
   AddDetail( ({ "silberland" }),
      "Du bist im Silberland. Was gibt es da noch zu sagen?" );
   
   AddSpecialDetail( ({ "zahn", "zaehne" }), "erosion" );
   AddSpecialDetail( ({ "zeit", "uhr" }), "erosion" );
   
   AddDetail( ({ "erosion" }),
      "Der Zahn der Zeit ist die Erosion, die mit der Zeit Gebirge durch Wind und "
      "Wasser abtraegt. Nichts kann dieser ununterbrochen wirkenden Kraft entgehen." );
   
   AddDetail( ({ "wind", "wasser", "kraefte", "kraft" }),
      "Wind und Wasser sind die Kraefte der Erosion." );
   
   AddDetail( ({ "stadtmauer", "mauer", "hecke" }),
      "In der Ferne kannst Du die lebende Stadtmauer von Derlim erkennen. Eine "
      "riesige undurchdringliche dornenbewehrte Hecke." );
   
   AddDetail( ({ "ferne" }),
      "Das ist noch weit weg." );
   
   AddDetail( ({ "zustand" }),
      "Der Zustand der Strasse ist erschreckend schlecht. Sie wurde wenn ueberhaupt "
      "schon sehr lange nicht mehr ausgebessert. Es wuchern Grasbueschel zwischen den "
      "Pflastersteinen. Die schoenen Farben der Randsteine, die teilweise von "
      "Gestruepp ueberwuchert sind, sind beinahe voellig verblasst." );
   
   AddDetail( ({ "grasbueschel", "bueschel" }),
      "Etliche Grasbueschel und anderes Unkraut wuchert zwischen den Pflastersteinen. "
      "Es ist schon sehr bedauerlich, dass diese schoene Strasse so verwahrlost ist." );
   
   AddDetail( ({ "unkraut" }),
      "Gras, Disteln, Loewenzahn und andere Feldblumen wuchert inzwischen zwischen "
      "den Pflastersteinen und werden die Strasse mit der Zeit unbrauchbar machen. " );
   
   AddDetail( ({ "gras", "disteln", "loewenzahn" }),
      "Das Gewaechs gibt es doch ueberall. Den wirst doch noch kennen?" );
   
   AddDetail( ({ "feldblumen", "blumen", "blume" }),
      "Blumen, die auf einem Feld oder einer Wiese - also im Huegelland wachsen." );
   
   AddDetail( ({ "feld", "felder" }),
      "Felder kannst du hier keine sehen, aber jede Menge Wiese." );
   
   AddDetail( ({ "wiese", "wiesen" }),
      "Abgesehen von der Strasse siehst du Wiesen ohne Ende." );
   
   AddDetail( ({ "menge", "ende" }),
      "Das ist eine riesige Wiese!" 
      );
   
   AddDetail( ({ "farben" }),
      "Die Farben der Randsteine sind recht interessant und habe mit Sicherheit was zu "
      "bedeuten. Vor langer Zeit als die Strasse noch neu war, war sie sicher sehr "
      "schoen anzusehen."   
      );
   
   AddDetail( ({ "sicherheit" }),
      "Davon bist du ueberzeugt. Es muss ja einen Sinn haben, dass die Steine offenbar "
      "in regelmaessigen Abstaenden aufgestellt sind und stets auf 4 gelben ein roter "
      "und auf weitere 4 gelben ein blauer Randstein kommt."
      );
   
   AddDetail( ({ "sinn" }),
      "Darauf muss Du schon selber kommen."
      );
   
   AddDetail( ({ "abstand", "abstaende" }),
      ([ "halbling": 
         "Na das ist aber voellig klar. Alle hundert Schritte steht ein Randstein.",
         0: "Abgesehen davon dass die Stein offensichtlich regelmaessig aufgestellt "
         "wurden sagt dir der Distanz nichts."]) 
      );
   
   AddDetail( ({ "schritte", "distanz" }),
      "Es handelt sich wohl um ein altes Laengenmass der Halblinge."
      );
   
   AddDetail( ({ "laengenmass", "mass" }),
      "Ein Mass um Laengen messen zu koennen."
      );
   
   AddDetail( ({ "laenge" }),
      "Alles hat eine Laenge."
      );
   
   AddDetail( ({ "farbe" }),
      "Die Farbe der bunten Randsteine sind ganz ausgebleicht und teilweise "
      "abgeblaetter. Vor langer Zeit als die Strasse noch neu war, war sie sicher "
      "sehr schoen." );
   
   AddDetail( ({ "randsteine", "randstein", "rand" }),
      "Die Strasse wird durch die, regelmaessig und beiderseits der Strasse "
      "aufgestellten, Randsteine zu den Wiesen hin abgegrenzt. Einst waren diese "
      "Randsteine mal mit bunten Farben bemalt, damit man sie besser sieht." 
      );
   
   AddDetail( ({ "gestruepp" }),
      "Gestruepp ueberwuchert den Rand der Strasse." );
   
   AddDetail( ({ "boden" }),
      "Du stehst auf einer verwahrlosten Strasse, die von teilweise ueberwucherten "
      "Randsteinen zu einer Wiese begrenzt wird." );
   
   AddDetail( ({ "himmel" }),
      "Am Himmel gibt es nichts aufregendes zu sehen." );
   
   AddDetail( ({ "gewaechs", "gruenzeug", "zeug", "pflanzen", "pflanze" }),
      "Das Gruenzeug! Die Pflanzen!" );
   
   AddSound( DEFAULT_SOUND,
      "Du hoerst das leise Rauschen des Wind, das Zwitschern von Voegeln und das "
      "Summen von Insekten.");
   
   AddSound( ({ "rauschen", "wind" }),
      "Der Wind blaest durch die Wiese und verursacht dabei ein leises und "
      "beruhigendes Rauschen");
   
   AddSound( ({ "zwitschern" }),
      "Du hoerst das vergnuegte Zwitschern von ein paar Singvoegeln.");
   
   AddSound( ({ "summen" }),
      "Du hoerst das geschaeftige Summen von Bienen und anderen Insekten.");
   
   AddDetail( ({ "voegel", "singvoegel" }),
      "Auf den Bueschen der nahe Wiese sitzen einige Singvoegel die froehlich ein "
      "Lied zwitschern.");
    
   AddDetail( ({ "buesche" }),
      "Auf dieser Wiese wachsen nicht nur Blumen, sondern stehen auch einige kleinere Buesche");
   
   AddDetail( ({ "bienen", "insekten" }),
      "Die Bienen und Insekten fliegen summend von einer zur naechsten Blume und "
      "bestaeuben sie.");
    
   AddDetail( ({ "lied", "melodie" }),
      "Die Singvoegel zwitschern eine nette Melodie.");
    
   AddSmell( DEFAULT_SMELL,
      "Man kann den Duft der Blumen der nahen Wiese riechen.");
   
   AddSmell( ({ "duft" }),
      "Die Blumen der Wiese verstroemen einen berauschenden Duft.");
   
/*   
   AddDetail( ({ "" }),
      "" );
   
   AddSound( ({ "" }),
      "");

   AddSmell( ({ "" }),
      "");
*/
   
   AddExit( RK3, "nach "+ RG3 + "#" + ROOM + "weg01" );
   AddExit( RK7, "nach "+ RG7 + "#" + ROOM + "weg02-2" );
   
}

string erosion(string key)
{
   if( !CheckPlayer( TP->query_real_name() + key ))
   {
      SetPlayer( TP->query_real_name() + key, 1 );
      SetPlayer( TP->query_real_name(), CheckPlayer( TP->query_real_name()) + 1 );
   }
   if( CheckPlayer( TP->query_real_name()) >= 4 )
   {
      return BS("Das wird Dich wohl nicht interessieren, oder doch? Vielleicht suchst "
         "Du auch Erosion." );
   }
   
   switch( key )
   {
      case "zahn":
      case "zaehne":
         return "Du hast doch sicher Zaehne.\n";
         break;
      case "zeit":
      case "uhr":
      default:
         return "Du wirst doch eine Uhr haben, um die Zeit messen zu koennen.\n";
         break;
   }
   
}
