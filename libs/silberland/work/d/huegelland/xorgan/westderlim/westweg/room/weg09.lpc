#include "../def.h"

inherit "std/room";

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Im westlichen Huegelland" );
   SetProp( P_INT_LONG,
      "09 Der breite Weg der nach " + RG2 + " weitergehen würde, endet abrupt "
      "an einem hausgrossen Felsen. Um ihn herum führt ein kleiner Weg im " + RG3 + "."
      );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );


   AddExit( RK3, "nach "+ RG3 + "#" + ROOM + "weg08" );
   AddExit( RK6, "nach "+ RG6 + "#" + ROOM + "weg10" );
   
