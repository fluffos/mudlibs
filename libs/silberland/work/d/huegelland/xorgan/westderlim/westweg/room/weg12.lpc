#include "../def.h"

inherit "std/room";

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Im westlichen Huegelland" );
   SetProp( P_INT_LONG,
      "12: Der Weg laeuft an den Ufern eines kleiner See, der in Osten liegt, entlang. "
      "Hier waechst eine HaselnussstaudeEine Astgabel kann man mit Werkzeug  zu einem "
      "Y schnitzen und eine Steinschleuder damit basteln."
      );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );


   AddExit( RK1, "nach "+ RG1 + "#" + ROOM + "weg11" );
   AddExit( RK6, "nach "+ RG6 + "#" + ROOM + "weg13" );
   
