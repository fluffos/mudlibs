// Xorgan@SilberLand
// Der Weg durch das westliche Huegelland
// 2003-09-20
// 

#include "../def.h"

inherit "std/room";

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Im westlichen Huegelland" );
   SetProp( P_INT_LONG,
      "Du befindest Dich im schoenen Huegelland " + RL3 + " von Derlim. Von der Stadt "
      "her verlaeuft eine gepflasterte Strasse, die hier abrupt endet und in einen "
      "breiten Weg uebergeht."
      );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
   
   
   SetProp( P_HIDE_EXITS, ({ RK6 }) );
   AddExit( RK3, "nach "+ RG3 + "#" + ROOM + "weg02-2" );
   AddExit( RK6O, "nach "+ RG6O + "#" + ROOM + "weg04" );
   AddExit( RK6, "nach "+ RG6O + "#" + ROOM + "weg04" );

   
   AddDetail( ({ "strasse" }),
       "Diese Strasse ist mit Steinen gepflastert und endet einfach hier. Oder sie "
       "beginnt hier. Je nach dem von welcher Seite Du gekommen bist. Diese Baustelle "
       "erweckt den Eindruck als waere die Arbeit von einem Tag auf den anderen "
       "eingestellt worden."
       );
   
   AddDetail( ({ "baustelle" }),
      "Die Baustelle wurde wirklich auf die Stunde verlassen. Es wurde ja nicht mal "
      "ein angemessener Abschluss gelegt, sondern die Arbeit wurde mitten in den "
      "Steinreihen eingestellt. Einen Grund fuer das ploetzliche Arbeitsende kannst "
      "Du nicht erkennen."
       );
   
   AddDetail( ({ "huegelland", "land" }),
      "Ein Land flacher als das Gebirge und steiler als die Ebene. Darin befindest "
      "Du Dich." );
   
   AddDetail( ({ "ebene", "gebirge", "gebiet" }),
      "Das ist ein anderes Gebiet und es ist weit weg." );
   
   AddDetail( ({ "hauptstadt", "stadt", "derlim" }),
      "Derlim ist die Hauptstadt der Hobbits. Du befindest Dich nicht weit davon "
      "entfernt" );
   
   AddDetail( ({ "halbling", "hobbit" }),
      ([ "hobbit": "Du bist selbst ein Hobbit.",
         0: "Du wirst doch ein Hobbit kennen." ]) );

   AddDetail( ({ "himmel" }),
      "Am Himmel gibt es nichts aufregendes zu sehen." );
   
   AddDetail( ({ "boden" }),
      "Du stehst am Ende oder am Anfang einer verwahrlosten Strasse, die am Rand von "
      "teilweise ueberwucherten Randsteinen zu einer Wiese begrenzt wird." );
   
   AddDetail( ({ "stein", "steine" }),
      "Fuer den Bau der Strasse wurden wuerfelfoermige Steine aus unterschiedlichem "
      "Material verwendet." );
   
   AddDetail( ({ "bau" }),
      "Beim Bau der Strasse wurden Pflastersteine verwendet." );
   
   AddDetail( ({ "material" }),
      "Das Material der Pflastersteine ist recht unterschiedlich und wurde in der "
      "naeheren Umgebung abgebaut." );
   
   AddDetail( ({ "pflastersteine" }),
      "Ein Pflasterstein ist ein wuerfelfoermig geschlagener Stein, der zum Bau dieser "
      "Strasse zu tausenden verwendet wurde." 
      );
    
   AddDetail( ({ "pflasterstein" }),
      "Pflastersteine siehst Du hier jede Menge. Manche sind verbaut und andere nicht." 
      );
   
   AddDetail( ({ "randsteine", "randstein" }),
      "Die Strasse wird durch die, regelmaessig und beiderseits der Strasse "
      "aufgestellten, Randsteine zu den Wiesen hin abgegrenzt. Einst waren diese "
      "Randsteine mal mit bunten Farben bemalt, damit man sie besser sieht." 
      );
   
   AddDetail( ({ "wiese", "wiesen" }),
      "Abgesehen von der Strasse siehst du unglaublich grosse Wiesen." 
      );
   
   AddDetail( ({ "farben" }),
      "Die Farben der Randsteine sind recht interessant und habe mit Sicherheit was zu "
      "bedeuten. Vor langer Zeit als die Strasse noch neu war, war sie sicher sehr "
      "schoen anzusehen."   
      );
   
   AddDetail( ({ "sicherheit" }),
      "Davon bist du ueberzeugt. Es muss ja einen Sinn haben, dass die Steine offenbar "
      "in regelmaessigen Abstaenden aufgestellt sind und stets auf 4 gelben ein roter "
      "und auf weitere 4 gelben ein blauer Randstein kommt."
      );
   
   AddDetail( ({ "sinn" }),
      "Darauf muss Du schon selber kommen."
      );
   
   AddDetail( ({ "abstand", "abstaende" }),
      ([ "halbling": 
         "Na das ist aber voellig klar. Alle hundert Schritte steht ein Randstein.",
         0: "Abgesehen davon dass die Steine offensichtlich regelmaessig aufgestellt "
         "wurden sagt dir der Distanz nichts."]) 
      );
   
   AddDetail( ({ "schritte", "distanz" }),
      "Es handelt sich wohl um ein altes Laengenmass der Halblinge."
      );
   
   AddDetail( ({ "mass" }),
      "Es gibt verschiedene Masse."
      );
   
   AddDetail( ({ "laengenmass" }),
      "Ein Mass um Laengen messen zu koennen."
      );
   
   AddDetail( ({ "laenge" }),
      "Alles hat eine Laenge."
      );
   
   AddDetail( ({ "farbe" }),
      "Die Farbe der bunten Randsteine sind ganz ausgebleicht und teilweise "
      "abgeblaetter. Vor langer Zeit als die Strasse noch neu war, war sie sicher "
      "sehr schoen." );
   
   AddDetail( ({ "umgebung" }),
      "Macht ja keinen Sinn die Steine fuer eine Strasse aus der Ferne zu hohlen." );
   
   AddDetail( ({ "ferne" }),
      "Das Ferne ist noch recht fern." );
   
   AddDetail( ({ "seite" }),
      "Es kommt ganz darauf an von welcher Richtung aus Du hier her gekommen bist. "
      "Bist Du von " + RL3 + " Richtung gekommen, dann endet die Strasse hier. Wenn du "
      "jedoch nach " + RG3 + " gehst, dann beginnt die Strasse fuer Dich."
      );
   
   AddDetail( ({ "richtung" }),
      "Man kann eine Strasse immer in 2 Richtungen bereisen und wenn eine Strasse aus "
      "einer Richtung gesehen endet, dass beginnt sie fuer die andere Richtung."
      );
   
   AddDetail( ({ "anfang" }),
      "Diese Strasse beginnt auch hier. Das kommt rein auf die Richtung an, aus der "
      "Du gekommen bist."
      );
   
   AddDetail( ({ "ende" }),
      "Diese Strasse endet auch hier. Das kommt rein auf die Richtung an, aus der "
      "Du gekommen bist."
      );
   
   AddDetail( ({ "zeit" }),
      "Das ist sicher schon sehr lange her."
      );
   
   AddDetail( ({ "rand" }),
      "Der Rand der Strasse ist nur mehr recht undeutlich zu erkennen, da er mit der "
      "Zeit von den angrenzenden Wiesen ueberwuchert wurde. Grasbueschel wachsen schon "
      "recht praechtig zwischen den einzelnen Pflastersteinen und Ranken wuchern wild "
      "durch die Gegend."
      );
   
   AddDetail( ({ "bueschel" }),
      "Ganze Grasbueschel wachsen zwischen den Pflastersteinen und zerstoeren so die "
      "Strasse."
      );
   
   AddDetail( ({ "ranken" }),
      "Die Ranken von wilden Straeuchern ueberwuchern nicht nur die Strasse und deren "
      "Rand, sondern auch die Randsteine. Es ist erstaunlich wie schnell sie, das Land "
      "wieder zurueckerobern."
      );
   
   AddDetail( ({ "straeucher" }),
      "Die Straeucher wuchern am Rand der Strasse derart, dass sie schon einen kleinen "
      "Berg bilden."
      );
   
   AddDetail( ({ "berg" }),
      "Bei naeherer Betrachtung erkennst Du, dass der Haufen nicht nur aus Ranken "
      "besteht."
      );
   
   AddDetail( ({ "betrachtung" }),
      "Alles liegt wie man so schoen sagt im Auge des Betrachters."
      );
   
   AddDetail( ({ "auge", "augen" }),
      "Solltest Du nomal sein, dann besitzt Du exakt zwei Augen."
      );
   
   AddDetail( ({ "betrachter" }),
      "Ui! Das bist ja Du! Na das ist ja sehr unerwartet."
      );
   
   AddDetail( ({ "haufen" }),
      "Der Haufen besteht eigentlich zum Grossteil aus aufgeschuetteten "
      "Pflastersteinen, die von Ranken vollstaendig zugewachsen sind."
      );
   
   AddDetail( ({ "gegend" }),
      "Die Ranken wachsen kreuz und quer in der Gegend herum."
      );
   
   AddDetail( ({ "grossteil", "menge" }),
      "Es ist wohl ein ganzer Haufen unverbauter Pflastersteine vorhanden. Mangel an "
      "Steinen war sicher nicht der Grund, warum der Bau der Strasse eingestellt wurde."
      );
   
   AddDetail( ({ "menge" }),
      "Es muessen unglaublich viele sein."
      );
   
   AddDetail( ({ "abschluss" }),
      "Abschluss gibt es keinen. Das ist ja der Grund warum die Strasse sehr schnell "
      "verfaellt."
      );
   
   AddDetail( ({ "grund", "ursache" }),
      "Der Grund. Die Ursache."
      );
   
   AddDetail( ({ "arbeit" }),
      "Die Arbeit wurde voellig ueberstuerzt beendet. Wenn Du die letzten und "
      "unvollstaendigen Steinreihen betrachtest, erwecken sie den Eindruck, als ob die "
      "Arbeiter alles stehen und liegen gelassen und die Flucht ergriffen haben."
      );
   
   AddDetail( ({ "arbeiter" }),
      "Es haben mit grosser Wahrscheinlichkeit mehrere Arbeiter eine lange Zeit an der "
      "Strasse gearbeitet."
      );
   
   AddDetail( ({ "wahrscheinlichkeit" }),
      "Was heisst hier Wahrscheinlichkeit? Du bist Dir darin sehr sicher."
      );
   
   AddDetail( ({ "eindruck", "angelegenheit" }),
      "Du glaubst Dir in dieser Angelegenheit ziemlich sicher zu sein."
      );
   
   AddDetail( ({ "flucht" }),
      "Das ist ja wohl nicht woertlich gemeint, oder doch? Vielleicht sind aber auch "
      "die Arbeiter vor einem gewaltigen Untier geflohen und das mag auch der Grund "
      "dafuer gewesen sein, dass das Westtor von Derlim so lange Zeit verschlossen war."
      );
   
   AddDetail( ({ "westtor", "tor" }),
      "Das westliche Tor in Derlim durch das Du erst hier her gelangt bist."
      );
   
   AddDetail( ({ "arbeitsende" }),
      "Die Arbeit muss sehr ploetzlich eingestellt worden sein. Waere es anderes "
      "gewesen, waere ein vernuenftiger Abschluss gemacht worden."
      );
   
   AddDetail( ({ "steinreihen", "reihen" }),
      "Die Baustelle wurde offensichtlich nicht zu Ende gefuehrt, da die letzten "
      "Reihen von Pflastersteinen unregelmaessig und unvollstaendig sind."
      );
   
   AddDetail( ({ "stunde", "tag" }),
      "Beides sind Zeitmasse, aber das ist Dir ja wohl bekannt und darum geht es wohl "
      "nicht. Dir ist voellig klar dass der Bau in grosser Eile eingestellt wurde."
      );
   
   AddDetail( ({ "eile" }),
      "Die Arbeiter haben sehr schnell das Weite gesucht. Du kannst Dir denken, dass "
      "sie Angst vor irgendetwas hatten und deshalb der Bau vor der eigentlichen "
      "Fertigstellung aufgegeben wurde. "
      );
   
   AddDetail( ({ "weite" }),
      "Die Arbeiter haben wie es scheint fluchtartig den Ort verlassen."
      );
   
   AddDetail( ({ "ort" }),
      "Die Arbeiter haben diesen Platz fluchtartig verlassen"
      );
   
   AddDetail( ({ "platz" }),
      "Die Arbeiter habe diese Baustelle vor der Fertigstellung aufgegeben."
      );
   
   AddDetail( ({ "fertigstellung" }),
      "Die Strasse wurde keines falls fertig gestellt. Das kannst Du schon "
      "an den letzten Reihen von Pflastersteinen erkennen."
      );
   
   AddDetail( ({ "untier" }),
      "Du kannst hier ja nicht mal ein Tier finden. "
      );
   
   AddDetail( ({ "tier" }),
      "Es ist keines da!"
      );
   
   AddDetail( ({ "zeitmasse" }),
      "Damit misst man Zeit und ist wohl nicht weiter interssant."
      );
   
   AddDetail( ({ "angst", "aengsten" }),
      "Angst ist, wenn man sie unter Kontrolle hat, ein maechtiger "
      "Begleiter. Die Arbeiter hatten ihre Angst wohl nicht unter Kontrolle."
      );
   
   AddDetail( ({ "kontrolle" }),
      "Kontrolle ist notwendig, da man sonst von seinen AEngsten ueberwaeltigt wird."
      );
   
   AddDetail( ({ "begleiter" }),
      "Ein Begleiter ist in manchen Situationen von grossem Nutzen. Ob das hier der "
      "Fall ist, laesst sich noch nicht genau sagen."
      );
   
   AddDetail( ({ "fall", "situation" }),
      "Ja, das kann schon der Fall sein."
      );
   
   AddDetail( ({ "nutzen" }),
      "Der Nutzen kann sehr sehr gross sein. Ein Begleiter kann einem in bestimmten "
      "Situationen sehr nuetzlich sein."
      );
   
   AddDetail( ({ "weg" }),
      "Nachdem die Strasse nicht fertig gestellt wurde, fuehrt ein ungepflasterter, "
      "aber breiter Weg nach " + RG6 + " hinauf auf einen besonders grossen Huegel. "
      );
   
   AddDetail( ({ "huegel" }),
      "Du siehst einen grossen Huegel im " + RG6 + " und dieser Weg verlaeuft "
      "geradewegs auf ihn zu, klettert den Hang halb hinauf und verlaeuft auf halber "
      "Hoehe zum Gipfel " + RL7 + " um den Huegel herum."
      );
   
   AddDetail( ({ "hang" }),
      "Auf dem Weg zum Gipfel muss man zwangslaeufig den Hang hinauf gehen."
      );
   
   AddDetail( ({ "gipfel" }),
      "Sicher! Das als Gipfel zu bezeichnen ist eine kleine UEbertreibung, "
      "aber fuer das Huegelland ist das schon ein kleiner Berg."
      );
   
   AddDetail( ({ "berg" }),
      "Berge gibt es im Gebirge. Hier siehst Du nur Huegel, auch wenn ein "
      "recht grosser im " + RG6 + " liegt."
      );
   
   AddDetail( ({ "hoehe" }),
      "Das ist ein besonders grosser Huegel. Wohl einer der Groessten im ganzen "
      "Huegelland."
      );
   
   AddDetail( ({ "groessten" }),
      "Vielleicht ist er auch der groesste Huegel ueberhaupt, aber es hat noch nie "
      "jemand die Huegel vermessen."
      );
   
   AddDetail( ({ "uebertreibung" }),
      "Es ist doch eine UEbertreibung bei der Spitze eines groesseren Huegels von "
      "einem Gipfel zu sprechen. Oder nicht?"
      );
   
   AddDetail( ({ "spitze" }),
      "Wohl auch keine wirklich treffende Bezeichnung fuer den Gipfel des Huegels."
      );
   
   AddDetail( ({ "bezeichnung" }),
      "Es faellt mir einfach nichts passenderes als Gipfel ein."
      );
   
   /*
   AddDetail( ({ "" }),
      ""
      );
   
   AddDetail( ({ "" }),

      );
   
   AddDetail( ({ "halbling", "hobbit" }),
      ([ "hobbit": "Du bist selbst ein Hobbit.",
         0: "Du wirst doch ein Hobbit kennen." ]) );
   
   AddDetail( ({ "" }),

      );
   
   AddSound( DEFAULT_SOUND,
      "");

   AddSound( ({ "" }),
      "");

   AddSmell( DEFAULT_SMELL,
      "");

   AddSmell( ({ "" }),
      "");
*/
   
}


