#include "../def.h"

inherit "std/room";

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Im westlichen Huegelland" );
   SetProp( P_INT_LONG,
      "07: Ein maechtiger einige Meter breiter Felsblock liegt " + RL7 + ". Ihm entlang "
      "geht ein schmaler Weg.. Hinweise dass der Stein von einem Vulkan kommt! Mit "
      "Werkzeug koennte man einen Edelstein bekommen."
      );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );


   AddExit( RK1, "nach "+ RG1 + "#" + ROOM + "weg06" );
   AddExit( RK5, "nach "+ RG5 + "#" + ROOM + "weg08" );
   
