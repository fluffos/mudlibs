// Xorgan@SilberLand
// Der Schluesselbund von Gamba Schuesselbund 
// 2003-12-09

#include "../def.h"

inherit "std/thing";

create() 
{
   if(!is_clone(TO))
      return;
   
   ::create();

   SetProp(P_SHORT, "Eine grosser eisener Schluesselbund");
   SetProp(P_LONG,
      "Eine grosser einsener Ring, an dem viele verschieden grosse Schluessel "
      "baumeln.");
   
   SetProp(P_NAME, "Schluesselbund");
   SetProp(P_GENDER, MALE);
   AddId( ({"bund", "schluesselbund" }));

   SetProp(P_MATERIAL, ([MAT_IRON:100]));
   SetProp(P_WEIGHT, 1000);
   SetProp(P_VALUE, 100);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,0);
}
