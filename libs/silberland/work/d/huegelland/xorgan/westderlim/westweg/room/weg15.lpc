#include "../def.h"

inherit "std/room";

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Im westlichen Huegelland" );
   SetProp( P_INT_LONG,
      "15: Man befindet sich auf einem hohen Huegel von dem man im einen Nachbarhuegel "
      "mit 3 Baeume sehen kann. Dort ist Rastplatz."
      );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );


   AddExit( RK2, "nach "+ RG2 + "#" + ROOM + "weg14" );
   AddExit( RK7, "nach "+ RG7 + "#" + ROOM + "weg16" );
   
