// Xorgan@SilberLand
// Gamba Schleusselbund
// 1999-06-26

#include "../def.h"

inherit "std/mnpc";

#include <mnpc.h>

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();

   SetProp( P_SHORT, "Gamba Schluesselbund, der Schluesselmeister" );
   SetProp( P_LONG,
      "Das ist Gamba Schluesselbund, ein alter Hobbit. Er ist unverkennbar der "
      "Schluesselmeister von Derlim, den abgesehen von seiner Kleidung traegt er "
      "einen grossen Schluesselbund mit viele unterschiedlich grossen "
      "Schluessel bei sich." );
   SetProp( P_NAME, "Gamba Schluesselbund" );
   
   SetProp( P_GENDER, MALE);
   SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
   AddId(({"gamba", "schluesselmeister"}));
   set_living_name( "gamba" );

   create_default_npc( 30 );
   SetProp( P_HANDS, ({" mit seinem schweren Schluesselbund",QueryProp( P_HANDS)[1],DT_BLUDGEON}));
//   SetProp( P_MAX_HP, );
//   SetProp( P_BODY, );
//   SetProp( P_XP, QueryProp( P_XP)+y*100); // Bonus fuer Spells
   SetProp( P_RACE, "Hobbit" );
   SetProp( P_SIZE, 90 + random( 20 ));
   SetProp( P_ALIGN, 400 );
   SetProp( P_MAX_HANDS, 2 );
   SetProp( P_HEAL,0);
   SetProp( P_AGGRESSIVE,0 );
   SetProp( P_WIMPY, 0 );
   SetProp( P_RESISTANCE_STRENGTHS , 
      ([DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
        DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
        DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
        DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
   SetProp( P_ARTICLE, 0);
   SetProp( P_NOMAGIC, 0 );
   SetProp( P_NOATTACK, "sagt: Lass das sonst melde ich Dich der "
      "Stadtverwaltung!" );
   
   SetProp( P_MSGIN, "kommt an und sieht sich um" );
   SetProp( P_MSGOUT, "sagt zufrieden: Hier ist nichts zu tun und geht" );
   SetProp( P_MMSGIN, "kommt an und sieht sich um" );
   SetProp( P_MMSGOUT, "sagt zufrieden: Hier ist nichts zu tun und geht" );
   
   SetProp(P_MNPC_AREA, 
      ({ 
      "/d/huegelland/raballion/hobbits/room",
      "/d/huegelland/orw/pfeifenladen/room" 
      }) );
   SetProp(P_MNPC_WAIT, ({ 10, 30, 20 }));
   SetProp(P_MNPC_DEFAULTROOM, "/d/huegelland/raballion/hobbits/room/westtor" );
   SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
   
   SetProp( P_DIE_MSG,  " bricht toedlich getroffen zusammen.\n" );
   SetProp( P_NOCORPSE, 0 );
//   SetProp( P_MURDER_MSG, "Ich komme wieder!" );
   SetProp( P_KILL_NAME, "Gamba Schluesselbund" );
   SetProp( P_KILL_MSG, "Du hattest keine Chance!" );
   
   SetProp(P_LOG_INFO, "xorgan/gamba.info");
   
   AddInfo(DEFAULT_INFO, "versteht Dich nicht.\n" );
   
   AddLibrary( "/d/huegelland/raballion/hobbits/npc/infos.lib", 1 );
   
   AddInfo( ({ "schluesselmeister", "meister" }),
      "Ich bin der Schluesselmeister der Stadt Derlim. Meine Aufgabe ist die "
      "Ueberpruefung aller Schloesser in der Stadt."
      "sagt: " );
   
   AddInfo( ({ "aufgaben", "aufgabe" }),
      "Ja. Ich hab viele Aufgaben als Schluesselmeister zu erfuellen."
      "Vor allem marschiere ich durch die Stadt und ueberpruefe die Schloesser.",
      "sagt: " );
   
   AddInfo( ({ "ueberpruefung" }),
      "Manches Schloss ist versperrt und manches nicht. Ich kontrolliere, ob "
      "es so ist, wie es sein soll.",
      "erklaert: " );
   
   AddInfo( ({ "schluesselbund", "name" }),
      "Schluesselbund, Gamba Schluesselbund. Das ist mein Name. Deinen kenne ich "
      "nicht. Oder meinst Du meinen Bund mit den Schluesseln der Stadt.",
      "sagt: " );
   
   AddInfo( ({ "schluessel" }),
      "Ich habe alle Schluessel von Derlim.",
      "erwiedert: " );
   
   AddInfo( ({ "schloss", "schloesser" }),
      "Ich ueberpruefe, ob die Schloesser von Derlim.",
      "erwiedert: " );
   
   AddInfo( ({ "bund", "finger" }),
      "Lass ja die Finger von meinem Schluesselbund. Den bekommst du nicht.",
      "sagt: " );
   
   AddInfo( ({ "suedtor" }),
      "Das Tor ist im suedlichen Teil von Derlim. Nur fuer was brauchst Du da "
      "mich?! Diese Tore sind doch Tag und Nacht offen.",
      "sagt: " );
   
   AddInfo( ({ "nordtor" }),
      "Das Tor ist im noerdlichen Teil von Derlim. Fuer was brauchst Du "
      "da mich?! Diese Tore sind doch Tag und Nacht offen.",
      "sagt: " );
   
   AddInfo( ({ "westtor" }),
      "Das Tor ist angesperrt und das ist gut so, denn ausserhalb liegt ein "
      "gefaehrliches Land in dem boese und hinterhaeltigen Bestien leben sollen."
      "",
      "sagt: " );
   
   AddInfo( ({ "tore","tor" }),
      "In Derlim gibt es mehrer Tore. Eines liegt im Norden. Ein weiteres Tor ist im "
      "Sueden und noch eines gibt es im Westen der Stadt.",
      "sagt: " );
   
   AddInfo( ({ "bestien","bestie", "ungeheuer" }),
      "Ausserhalb der Westtores liegt ein unerforschter und gefaehrlicher Teil "
      "des Huegellandes. Nur wenige Abenteurer haben es bisher gewagt durch das "
      "Westtor zu gehen und die wenigsten sind wieder zurueckgekehrt. Da "
      "draussen soll es gefaehrliche Bestien und Ungeheuer geben!",
      "sagt: " );
   
   AddInfo( ({ "land", "teil" }),
      "Ehrlich das Land ist gefaehrlich. Geh nicht durch das Westtor."
      "sagt: " );
   
   AddInfo( ({ "tag","nacht" }),
      "Das Tor ist einfach immer geoeffnet!",
      "sagt: " );
   
   AddInfo( ({ "abenteurer" }),
      "Ach! Du bist auch so ein mutiger Held. Und sicher moechtest Du dass ich "
      "Dich hinaus lasse.",
      "sagt: " );
   
   AddInfo( ({ "held" }),
      "Wie du willst! Wenn du mich um den Schluessel ersuchst werde ich Dir das "
      "Westtor aufsterren."
      "sagt: " );
   
/***************************
   AddInfo( ({ "","" }),
      ".",
      "sagt: " );
*/
   
   SetProp( P_LOG_INFO, "npc_logfile" );
   
   SetProp( P_REJECT, ({ REJECT_DROP,
      "Der Schluesselwaechter will Deine Sachen nicht tragen.\n" }) );
   
   
   SetChats( 5, ({
      "Gamba Schluesselbund preift ein froehliches Lied.\n",
      "Gamba Schluesselbund spielt mit seinem Schluesselbund.\n",
      "Gamba Schluesselbund's Schluessel scheppern.\n",
      "Gamba Schluesselbund zaehlt seine Schluessel.\n",
      "Gamba Schluesselbund schliesst ein Tuer ab.\n",
      "Gamba Schluesselbund sperrt ein Schloss auf.\n",
      "Gamba Schluesselbund prueft ein Schloss.\n",
      "Gamba Schluesselbund sucht einen Schluessel.\n",
      "Gamba Schluesselbund versucht ein Tuer zu oeffnen.\n",
      }) );
      
   SetProp( P_SPELLRATE,50 );

   /*
   AddSpell(1,0,
      ".\n",
      ".\n",
      DT_LIGHT,([SP_SHOW_DAMAGE:1]) );
   SetAttackChats(10, ({
      ".\n"}) );
   */
   
   SUID;
   
   CLONEME( OBJ + "schluesselbund" );
   /*
   command( "zuecke waffe" );
   CLONEME(ARMOUR "" );
   command( "trage alles" );
   */
   AddCmd( ({"ersuche"}), "bitte" );
   
}


int bitte( string str )
{
   
   notify_fail( "Wen willst du um was ersuchen?\n" );
   if( !str ) 
      return 0;
   
   if( str == "gamba um schluessel" || str == "schluesselbund um schluessel" ||
       str == "gamba schluesselbung um schluessel" )
   {
      if( ENV( TP )->QueryProp( P_INT_SHORT ) == "Am Westtor von Hobbingen" )
      {
         write( "Gamba Schluesselbund sagt: Du musst es ja wissen was Du machst.\n"
            + BS( "Gamba Schluesselbund sperrt das Tor auf und oeffnet es. Er "
            "wartet bis Du durchgegangen bist. Hinter Dir schliesst er das Tor "
            "und versperrt es wieder." ) + "\n");
         say( "Gamba Schluesselbund laesst " + TPN + " aus Derlim hinaus.\n", TP );
         TP->move( ROOM + "weg01", M_GO);
      }
      else
      {
         write( BS( "Gamba Schluesselbund sagt: Du willst also beim Westtor aus "
            "Derlim raus. Also Gut. Wie Du willst. Komm zum Westtor und ersuche "
            "mich noch mal darum.") + "\nGamba Schluesselbund dreht sich um und "
            "geht Richtung Westtor.\n");
         move( "/d/huegelland/raballion/hobbits/room/westtor", M_GO + M_SILENT);
      }
      return 1;
   }
   return 0;
}


void die( int poisondeath )
{
   write_file(LOG "npc.kills",
      ctime()+": "+CAP(getuid(PL))+" killt den NPC.\n" );
   ::die(poisondeath);
}


void NotifyPlayerDeath( object player, object killer, int lostexp ) 
{
   if(killer == ME)
      write_file(LOG "npc.deads",
         ctime()+": Der NPC hat gerade "+CAP(getuid(player))+" umgebracht.\n" );
}


// Reactions
void StartReaction( string verb, string gruppe, string adverb, int touch ) 
{
   if( find_call_out( "reaction" ) != -1 ) 
      return;
   
   switch( gruppe )
   {
      case "aengstlich":
         call_out( "reaction", 0, TP, 
            "sagt: Nur keine Angst die Wachen beschuetzen uns!",
            "troestet " + TP->name(WEN) + "." );
         break;
      case "aergerlich":
         call_out( "reaction", 0, TP,
            "erwiedert: Lass mich in Ruhe!",
            "erwiedert: Lass mich in Ruhe!" );
         break;
      case "albern":
         call_out( "reaction", 0, TP,
            "sieht Dich boese an.",
            "sieht " + TP->name( RAW ) + " boese an." );
         break;
      case "fies":
         call_out( "reaction", 0, TP,
            "sagt: Muss das sein!",
            "sagt: Muss das sein!" );
         break;
      case "frech":
         call_out( "reaction", 0, TP,
            verb + "t Dich auch.",
            verb + "t " + TP->name( WEN ) + " ebenfalls." );
         break;
      case "froh":
         call_out( "reaction", 0, TP,
            "grinst Dich erfreut an.", 
            "grinst " + TP->name( WEN ) + " erfreut an." );
         break;
      case "intim":
         if( TP->QueryProp( P_GENDER ) == FEMALE )
         {
            call_out( "reaction", 0, TP,
               "fluestert verliebt: Wollen wir uns spaeter treffen?",
               "fluestert mit leuchtenden Augen" + TP->name( WEN ) 
               + " etwas zu." );
         }
         else
         {
            call_out( "reaction", 0, TP,
               "wendet sich angewidert von Dir ab.",
               "wendet sich angewidert von " + TP->name( WEM ) + " ab." );
         }
         break;
      case "nett":
         call_out( "reaction", 0, TP,
            verb + "t Dich auch.",
            verb + "t " + TP->name( WEN ) + " ebenfalls." );
         break;
      case "neutral":
         call_out( "reaction", 0, TP,
            "schaut Dich ernst an.",
            "schaut " + TP->name( WEN ) + " ernst an." );
         break;
      case "traurig":
         call_out( "reaction", 0, TP,
            "spricht: Na, na! So schlimm wird es doch nicht sein.",
            "troestet " + TP->name( WEN ) + "." );
         break;
   }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
   return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) 
{
   if( present(ob, ENV(TO))) {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
   }
}
