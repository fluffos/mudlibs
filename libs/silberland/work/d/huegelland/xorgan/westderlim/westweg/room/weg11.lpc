#include "../def.h"

inherit "std/room";

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Im westlichen Huegelland" );
   SetProp( P_INT_LONG,
      "11: In den folgenden Raeumen kommt die Elster Klausache."
      "."
      );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );


   AddExit( RK3, "nach "+ RG3 + "#" + ROOM + "weg10" );
   AddExit( RK5, "nach "+ RG5 + "#" + ROOM + "weg12" );
   
