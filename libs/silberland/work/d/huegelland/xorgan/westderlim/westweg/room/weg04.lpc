// Xorgan@SilberLand
// Der Weg durch das westliche Huegelland
// 2003-09-20
// 

#include "../def.h"

inherit "std/room";

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Im westlichen Huegelland" );
   SetProp( P_INT_LONG,
      "04: Der breite Weg laeuft auf halber Hoehe an der Flanke eines grossen Huegels "
      "entlang. Am Gipfel kann mein eine Formation von Baeumen erkennen."
      );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );
   
   
   SetProp( P_HIDE_EXITS, ({ RK2 }) );
   AddExit( RK2, "nach "+ RG2U + "#" + ROOM + "weg03" );
   AddExit( RK2U, "nach "+ RG2U + "#" + ROOM + "weg03" );
   AddExit( RK7, "nach "+ RG7 + "#" + ROOM + "weg05" );
   
   
   
/*   
   AddDetail( ({ "halbling", "hobbit" }),
