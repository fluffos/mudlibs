#include "../def.h"

inherit "std/room";

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Im westlichen Huegelland" );
   SetProp( P_INT_LONG,
      "06: Ein maechtiger hausgrosser breiter Felsblock liegt auf dem breiten Weg um "
      "ihn herum geht in " + RL5 + " Richtung ein kleiner Trampelpfad"
      );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HILL]) );


   SetProp( P_HIDE_EXITS, ({ RK2 }) );
   AddExit( RK2, "nach "+ RG2O + "#" + ROOM + "weg05" );
   AddExit( RK2O, "nach "+ RG2O + "#" + ROOM + "weg05" );
   AddExit( RK5, "nach "+ RG5 + "#" + ROOM + "weg07" );
   
