// Xorgan@SilberLand
// Der Tor westlich von Derlim
// 2003-09-20
// 

#include "../def.h"

inherit "std/room";

void create()
{
   ::create();
   
   SetProp( P_INT_SHORT, "Das Westtor von Derlim" );
   SetProp( P_INT_LONG,
      "Du befindest Dich direkt ausserhalb der Dornenhecke von Derlim, der "
      "schoenen Stadt der Hobbits. In die Hecke eingebettet "
      "siehst Du das grosse und verschlossene Westtor. "
      "Im " + RG7 + " blickst Du in die Weiten des Huegellandes.");
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp( P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_ROAD]) );
   
   SetProp(P_KILL_NAME, "Die Stadtmauer von Derlim");
   
   AddDetail( ({"tor", "westtor"}),
      "In einem Loch der Hecke, die die Stadtmauer bildet, befindet sich das "
      "Westtor der Stadt Derlim. Der Torrahmen ist voellig eingewachsen und kaum "
      "mehr zu erkennen. Die zwei massiven mit Kupfer beschlagenen Fluegel sind "
      "fest geschlossen. Das Tor kann von aussen nicht geoeffnet werden." );
   
   AddDetail( ({"fluegel" }),
      "Die Fluegel es Tores besteht aus vielen schweren Pfosten, die kunstvoll "
      "ineinander gefuegt und mit Kupfer beschlagen sind und so ein massives "
      "Tor ergeben, das so manchen Angriff ueberstehen wird.");
   
   AddDetail( ({"pfosten" }),
      "Die Pfosten bestehen aus massiver Eiche und sind auf wunderbare Weise "
      "miteinander verbunden. Kein Spalt ist zwischen den einzelnen Pfosten.");
   
   AddDetail( ({"spalt"}),
      "Es ist kein Spalt zwischen den Pfosten zu finden. Obwohl man es ihnen "
      "immer wieder abspricht, scheinen Hobbits doch sehr geschickte "
      "Handwerker zu sein.");
   
   AddDetail( ({ "halbling", "hobbit", "hobbits" }),
      ([ "hobbit": "Du bist selbst ein Hobbit.",
         0: "Du wirst doch ein Hobbit kennen." ]) );
   
   AddDetail( ({ "handwerker", "handwerk" }),
      "Die Hobbits beherrschen offenbar das Handwerk. Man soll es kaum "
      "glauben!");
   
   AddDetail( ({ "eiche", "holz", "eichenholz" }),
      "Die Eiche ist ein maechtiger Baum, dessen Holz sehr hart ist und lange "
      "einem Feuer standhaelt. Es ist hervorragend zum Bau von Gebaeuden "
      "geeignet");
   
   AddDetail( ({ "baum" }),
      "hier gibt es keinen Baum. Du kannst nur Dornengestruepp sehen.");
   
   AddDetail( ({ "bau", "gebaeude", "bauwerk", "bauwerke" }),
      "In der Stadt sind sicher viele Bauwerke! Wenn Dich die interessieren, "
      "solltest Du die Stadt erst mal betreten.");
   
   AddDetail( ({ "weise" }),
      "Da musst Du schon den Schreiner fragen, der das Tor gefertigt hat.");
   
   AddDetail( ({ "schreiner" }),
      "Schreiner sind Handwerker, die mit Holz arbeiten. Das wusstest Du "
      "nicht?");
   
   AddDetail( ({ "angriff" }),
      "Sowohl das Tor als auch die Stadtmauer sind wahre Hindernisse fuer jeden "
      "Angreifer.");
   
   AddDetail( ({ "stadtmauer", "mauer" }),
      "Eine richtige Mauer ist das nicht. Eher ein Wall aus Gestruepp und "
      "langen Dornen. Sie umgibt die Stadt vollstaendig und hat die Wirkung, "
      "wie eine Stadtmauer aus Stein.");
   
   AddDetail( ({ "stein" }),
      "Stein ist wesentlich robuster als Holz und bietet daher auch besseren "
      "Schutz.");
   
   AddDetail( ({ "wirkung", "schutz" }),
      "Die Wirkung ist in diesem Fall wohl klar. Sie soll verhindern, dass wilde "
      "Tiere und Angreifer unbemerkt in die Stadt kommen kann.");
   
   AddDetail( ({ "gestruepp", "dornengestruepp" }),
      "Die Stadt ist abgesehen von den Loechern der Tore von einem Wall aus "
      "undurchdringlichem Gestruepp, dass mit langen Dornen gespickt ist, "
      "umgeben.");
   
   AddDetail( ({ "dornen", "dorn" }),
      "Die langen Dornen ragen wie Speerspitzen aus dem Gestruepp und machen es "
      "unpassierbar. Nur ein Narr wuerde versuchen ueber das Gestruepp in die "
      "Stadt klettern.");
   
   AddDetail( ({ "narr" }),
      "Nur ein Narr wuerde es versuchen.");
   
   AddDetail( ({ "lang" }),
      ([ "troll": "Selbst fuer Deine Groesse stellen die langen Dornen eine "
                    "erhebliche Gefahr dar.",
         "oger": "Selbst fuer Deine Groesse stellen die langen Dornen eine "
                 "erhebliche Gefahr dar.",
         "halbling": "Die Dornen sind deine Groesse absolut unueberwindbar.",
         "zwerg": "Oben drueber? Keine Chance! Eher unten drunter!",
         "fee": "Zum Glueck kann man fliegen! Du solltest aber grossen Abstand "
                "halten.",
         0: "Die Dornen sind sehr lang und sehr gefaehrlich."]) );
   
   AddDetail( ({ "groesse" }),
      "Die Groesse ist unveraenderlich.");
   
   AddDetail( ({ "abstand" }),
      "Der koennte wichtig sein.");
   
   AddDetail( ({ "chance", "versuch" }),
      "Wenn ich sage keine Chance, dann meine ich das auch so. Daher ist "
      "jeder Versuch voellig sinnlos.");
   
   AddDetail( ({ "wesen" }),
      "Das Wesen der Hobbits ist friedlich und gesellig!");
   
   AddDetail( ({ "speerspitzen", "speer", "spitzen" }),
      "Die Dornen sind so spitz, scharf und lang wie Speere. Es steht ausser "
      "Frage, dass sie auch so toedlich wie Speere sein koennen. Es ist nicht "
      "ratsam, ueber den Wall in die Stadt zu klettern.");
   
   AddDetail( ({ "frage" }),
      "Es steht definitiv ausser Frage, dass die Dornen so toedlich wie Speere "
      "sein koennen. Wenn Du es nicht glaubst, kannst es ja versuchen.");

   AddDetail( ({ "angreifer" }),
      "Die Hobbits sind friedliche und gesellige Wesen, mit denen man gut "
      "auskommt. Wer will bitte Derlim angreifen wollen?");
   
   AddDetail( ({ "derlim", "hobbingen",  "stadt" }),
      "Derlim oder Hobbingen, wie es mancher nennt, ist die groesste und einzige "
      "Stadt der Hobbits.");
   
   AddDetail( ({ "feuer" }),
      "Wo brennt es?");
   
   AddDetail( ({ "hindernisse", "hindernis" }),
      "Das Tor und das Dornengestruepp, das die Stadt umgibt, halten Angreifer "
      "und wilde Tiere erfolgreich vom eindringen in die Stadt ab.");
   
   AddDetail( ({ "tiere", "tier" }),
      "Wilde Tiere haben absolut keine Chance ueber den Wall in die Stadt zu "
      "kommen.");
   
   AddDetail( ({ "loecher", "loch" }),
      "In der Stadtmauer von Derlim findest du nur ein Loch und das ist das "
      "fest verschlossene Westtor.");
   
   AddDetail( ({ "wall" }),
      "Eine richtige Stadtmauer mit Wehrgang wie in Midas hat Derlim nicht, "
      "aber mit dem Wall aus Gestruepp und Dornen werden wilde Tiere und "
      "auch Angreifer erfolgreich von der Stadt fern gehalten.");
   
   AddDetail( ({ "midas", "hauptstadt" }),
      "Was Du kennst die Hauptstadt des Silberlandes nicht?");
   AddDetail( ({ "wehrgang", "gang" }),
      "Du solltest die Stadtmauer von Midas mal genauer unter die Lupe nehmen. "
      "koennte sehr interessant sein.");
   
   AddDetail( ({ "lupe" }),
      "Damit kann man alles moegliche genau ansehen.");
   
   AddDetail( ({ "silberland" }),
      "Was wird das wohl sein?");
   
   AddDetail( ({ "boden" }),
      "Du stehst auf einem Weg der in der Naehe der Stadt zu einer sauber "
      "gepflasterten Strasse ausgebaut wurde, die sich zwischen die Huegel des "
      "Huegellandes, die mit den Wiesen bedeckt sind, durchschlaengelt.");
   
   AddDetail( ({ "weg" }),
      "Der Weg, der hier sogar zu einer gepflasterten Strasse ausgebaut wurde, "
      "laeuft durch den Westen des Huegellandes.");
   
   AddDetail( ({ "strasse" }),
      "Die gepflasterte Strasse ist nicht lange und wird bald von einem "
      "breiten Weg ersetzt.");
   
   AddDetail( ({ "westen" }),
      "Damit ist das Land gemeint, dass sich westlich von Derlim befindet.");
   
   AddDetail( ({ "land" }),
      "Damit ist der Boden gemeint. ");
   
   AddDetail( ({ "huegel" }),
      "Im Huegelland gibt es eine Menge davon. Daher kommt ja auch der Name.");
   
   AddDetail( ({ "naehe", "nahe" }),
      "Der Weg ist nur in unmittelbarer Umgebung der Stadt gepflastert.");
   
   AddDetail( ({ "umgebung" }),
      "Das Gebiet in der Naehe der Stadt herum.");
   
   AddDetail( ({ "wiese", "weisen" }),
      "Eine mit Graesern und Kraeutern bewachsenes Land. Es wird auch zur "
      "Viehzucht verwendet. In dem Fall nennt man es auch Weide.");
   
   AddDetail( ({ "fall" }),
      "Hm... Das kann man schwer beschreiben.");
   
   AddDetail( ({ "weiden", "weide" }),
      "Ein eingegrenztes Gebiet, das mit auf Gras waechst und das zur Viehzucht "
      "verwendet wird.");
   
   AddDetail( ({ "gebiet" }),
      "Ein begrenzter Teil des Landes.");
   
   AddDetail( ({ "viehzucht", "zucht" }),
      "Von hier aus kannst Du, abgesehen von den Wiesen, kein Anzeichen auf "
      "Viehzucht erkennen.");
   
   AddDetail( ({ "anzeichen" }),
      "Es gibt keine. Es ist schon seltsam, dass Abenteurer immer das "
      "untersuchen, was es gar nicht gibt.");
   
   AddDetail( ({ "abenteurer" }),
      "Man koennte Dich als solchen bezeichnen.");
   
   AddDetail( ({ "gras", "pflanzen", "graeser", "menge", "blumen", "kraeuter" }),
      "Auf einer Wiese wachsen allerlei Pflanzen. Jede Menge Blumen und "
      "Kraeuter.");

   AddDetail( ({ "weiten" }),
      "Die Weiten des Huegellandes, vor allem der " + RL7 + " Teil sind noch gar"
      "nicht zugaenglich.");
   
   AddDetail( ({ "teil" }),
      "Ein Teil ist klarerweise nicht alles vom Ganzen.");
   
   AddDetail( ({ "ganz", "ganzen", "ganzes" }),
      "Das Ganze ist einfach alles.");
   
   AddDetail( ({ "huegelland", }),
      "Der Teil des Silberlandes in dem Du Dich im Moment befindest. Der Name "
      "kommt wohl von der Tatsache, dass es huegeliger als die Ebene und flacher "
      "als das Gebirge ist.");
   
   AddDetail( ({ "moment" }),
      "Jetzt haeltst Du Dich im Huegelland auf.");
   
   AddDetail( ({ "ebene" }),
      "Ein wesentlich flacheres Land als es das Huegelland ist. Es befindet sich "
      "in der Naehe von Midas.");
   
   AddDetail( ({ "gebirge" }),
      "Ein wesentlich bergigeres Land als es das Huegelland ist. Bist Du nicht "
      "durch das Gebirge gegangen, um hierher zu kommen?");
   
   AddDetail( ({"name", "bezeichnung"  }),
      "Ein Name ist ein Bezeichnung.");
   
   AddDetail( ({ "tatsache", "fakt" }),
      "Es ist genauer gesagt ein Fakt.");
   
   AddDetail( ({ "himmel" }),
      "Am Himmel gibt es nichts besonderes zu sehen.");
   
   AddDetail( ({ "dornenhecke", "hecke" }),
      "Die Hecke aus Dornengestruepp bildet die Stadtmauer von Derlim.");
   
   AddDetail( ({ "kupfer" }),
      "Ein roetliches maessig hartes Metall, dass sich relativ leicht verarbeiten "
      "laesst. Das Tor ist mit Kupfer beschlagen, was es widerstandsfaehiger "
      "macht.");

   
   AddDetail( ({ "torrahmen", "rahmen" }),
      "Den Rahmen des Tores, der ebenfalls aus Eichenholz besteht, kannst Du vor "
      "lauter Gestruepp schon gar nicht mehr richtig erkennen. ");
   
   AddDetail( ({ "metall" }),
      "Es gibt viele verschiedene Metalle im Silberland. Besonders Zwerge "
      "verstehen einiges von Metallen, besonders von den Edlen.");   
      
   AddDetail( ({ "edlen", "edelmetall", "gold" "silber" }),
      "Ja. Gold und Silber! Wer will die nicht haben.");
   

   AddDetail( ({ "zwerg", "zwerge" }),
      ([ "zwerg": "Hallo! Du bist selbst ein Zwerg und stammst aus Felonia!",
         0: "Du wirst doch Zwerge und Felonia kenne."]) );
   
   AddDetail( ({ "felonia" }),
      "In Felonia ist auch eine Stadt, naemlich die der Zwerge. Felonia ist "
      "weit weg und Derlim sehr nah. Daher sollte Derlim fuer Dich interessanter "
      "sein.");
         
/*   
   AddDetail( ({ "" }),
      "");
   
*/
   
   AddSound( DEFAULT_SOUND,
      "Es ist der Laerm der nahen Stadt Derlim zu hoeren.");
   
   AddSound( ({ "stadt" }),
      "Die Stadt an sich kann man nicht hoeren. Du kannst nur den Laerm hoeren, "
      "der in einer Stadt herrscht.");
   
   AddSound( ({ "laerm" }),
      "Es ist das Stimmenwirrwarr zu hoeren. Verstehen kannst Du kaum etwas.");
   
   AddSound( ({ "stimmenwirrwarr", "wirrwarr" }),
      "Ein Durcheinander von Stimmen ist zu hoeren. Verstehen kannst Du "
      "jedoch nichts. ");
   
   AddSound( ({ "durcheinander ", "stimmen", "stimme" }),
      "Du kannst aus dem Durcheinander von Stimmen nichts verstehen.");
   
   
   AddSmell( DEFAULT_SMELL,
      "Es liegen die unterschiedlichsten Gerueche in der Luft.");
   
   AddSmell( ({ "luft" }),
      "Die Luft riecht nach gar nichts.");
   
   AddSmell( ({ "gerueche" }),
      "Es sind viele verschieden Gerueche, die Du da riechen kannst. Ein wahres "
      "Durcheinander. Einzelnes heraus zu riechen ist sehr schwer zu schaffen.");
   
   AddSmell( ({ "durcheinander", "unmenge", "unmengen" }),
      "Das Durcheinander ist nicht wirklich erstaunlich, denn Du bist ja fast "
      "in der Stadt und da gibt es Unmengen von Gerueche.");
   
   AddSmell( ({ "einzelnes" }),
      "Du kannst keinen einzelnen Gerueche erkennen.");
   
   
/*   
   AddSound( ({ "" }),
      "");
   
   AddSmell( ({ "" }),
      "");
   
*/

   AddCmd( "klopfe|klopf&tor", "klopf", "An was willst Du klopfen?" );
   AddCmd( "klettere|kletter&ueber&mauer|stadtmauer|hecke|gestruepp", 
      "kletter", "Ueber was moechtest Du klettern?" );
   
/*
   AddCmd( "klettere|kletter&ueber&mauer|stadtmauer|hecke|gestruepp", 
      "kletterNein", "Ueber was moechtest Du klettern?" );
   AddCmd( ({ "klettere&todesmutig&ueber&mauer" }), "kletterJa",
      "Ueber was moechtest Du todesmutig klettern?" );
*/

   AddExit( RK7, "nach "+ RG7 + "#" + ROOM + "weg02-1" );
   AddExit( "workroom", "nach Irgendwo#/players/xorgan/workroom" );

}


int klopf( string str )
{
   write("Du klopfst energisch an das Tor und rufst: Ich bin " + TPN 
      + " und will in die Stadt hinein!\n");
   say( TPN +" klopft an das Tor und ruft: Ich bin " + TPN 
      + "und will in die Stadt hinein.\n");
   
   
   call_out( "ungeduld", 5, TP, 5 + random( 3 ) );
   return 1;
}


void ungeduld( object ob, int sec )
{
   if( !ob )
      return;
   
   if( present( ob ) )
   {
      switch( random( 50 ))
      {
         case 0..9:
            write( "Du denkst   . o O (Was bitte dauert denn da so lange)\n"); 
            say( ob->name( RAW ) + " wartet ungeduldig.\n", ob ); 
            break;
         case 10..19:
            write( "Unruhig Du tippst mit dem Fuss auf dem Boden.\n");
            say( ob->name( RAW ) + " tippt mit dem Fuss auf dem Boden.\n", ob ); 
            break;
         case 20..29:
            write( "Du rufst: HALLO!!! Oeffnet das Tor! Ich will rein!!!\n");
            say( ob->name( RAW ) + " ruft: HALLO!!! Oeffnet das Tor! Ich "
               "will rein!!!\n", ob ); 
            break;
         case 30..39:
            write( "Du schlaegst mit beiden Haenden gegen das Tor!\n");
            say( ob->name( RAW ) + " schlaegt mit beiden Haenden gegen das Tor.\n",
                ob ); 
            break;
         default:
            write( "Ungeduldig wartest Du, dass Dir endlich jemand das Tor "
               "oeffnet!\n"); 
            say( ob->name( RAW ) + " wartet ungeduldig.\n", ob ); 
            break;
      }
      
      if( sec != 1 )
         call_out( "ungeduld", 3, ob, sec - 1 );
      else
         call_out( "torauf", 3, ob );
   }
}


void torauf( object ob )
{
   if( !ob )
      return;
   
   if( present( ob ))
   {
      write( BS("Endlich hoerst Du wie das Tor aufgeschlossen wird und Dich jemand "
         "in die Stadt hereinlaesst.\n")); 
      say( ob->name( RAW ) + " wird in die Stadt hinein gelassen.\n", ob ); 
      ob->move( "/d/huegelland/raballion/hobbits/room/westtor", M_GO);
   }
}



int kletterNein( string str )
{
   write("Das ist Selbstmord! Die Dornen werden Dir furchtbare Verletzungen "
      "zufuegen!\nWenn Du wirklich sterben will verwende: klettere todesmutig "
      "ueber mauer!\n");
   say( TPN +" versucht ueber die Mauer zu kelttern, traut sich aber nicht.\n");
   
   return 1;
}


void kletterJa( object ob, int sec )
{
   int dam;
   
   switch( random( 100 ))
   {
      case 0..9:
         write( "\nDu rammst Dir einen langen Dorn in die Seite.\n");
         break;
      case 10..19:
         write( "\nDu bleibst im Geaest haengen und verletzt Dir Deinen Arm!\n");
         break;
      case 20..29:
         write( "\nEin Ast schnellt zurueck und schlaegt Dir ins Gesicht!\n");
         break;
      case 30..39:
         write( "\nDornen bohren sich deinen Hand.\n");
         break;
      case 40..49:
         write( "\nEine dolchlangen Dorn durchdringt deinen Stiefel.\n");
         break;
      case 50..59:
         write( "\nDie Dornen verletzten Dich schwer.\n");
         break;
      default:
         write( "\nDu hast unglaubliches Glueck dass Du Dich nicht verletzt hast.\n");
         dam = 1;
         break;
   }
   if( !dam )
      TP->do_damage( 25 + random( 25 ));
   
   if( sec != 1 )
      call_out( "kletterJa", 3, ob, sec - 1 );
   else
      call_out( "drueber", 3, ob );
   
}


void drueber( object ob )
{
   write( "\nEndlich! Du hast es auf die andere Seite geschafft.\n\n" );
   TP->SetProp( P_PARALYZED, 0 );
      
   ob->move( "/d/huegelland/raballion/hobbits/room/westtor", M_GO);
   
}


int kletter(string str )
{
   object ob;
   string d;
   
   if( str == "todesmutig ueber mauer" )
   {
      write( "Mutig beginnst Du die Hecke hoch zu klettern.\n" );
      say( TPN + "klettert mutig die Dornenhecke hoch.\n");
      
      TP->SetProp( P_PARALYZED, ([
         PARALYZE_TIME:25, 
         PARALYZE_MSG:BS("Du erkletters gerade die Dornenhecke von Derlim.\n"),
         PARALYZE_END_OTHER: "",
         PARALYZE_END:"" ]) );
      
      call_out( "kletterJa", 3, TP, 4 );
      return 1;
   }
   else
      return kletterNein( str );
   
   return 0;
   
}


