// Xorgan@SilberLand
// Am Fuss des mahnenend Fingers
// 2002-01-12
// 

#include "../def.h"
#include "../directions.h"

inherit "std/room";

#include "../CheckPlayer.h"

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Vor dem mahnenden Finger" );
   SetProp( P_INT_LONG,
      "Dein Weg endet vor dem mahnenden Finger, einer beeindruckenden "
      "Felsformation die wohl schon vor Urzeiten hier entstanden ist."
      );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 23, ENV_TERRAIN: TT_HILL]) );
   SetProp(P_KILL_NAME, "Eine Sturz aus einer gefaehrlichen Felswand");
   
   AddDetail( ({ "urzeiten" }),
      "Das ist schon sehr lange her.");
   
   AddDetail( ({ "weg" }),
      "Von einem Weg kann eigentlich nicht sprechen, denn Du bist querfeldein "
      "ueber die Huegel hier her gelangt. Du bist Dir sicher der erste "
      "Sterbliche seit langer Zeit zu sein, der hier her gekommen ist.");
   
   AddDetail( ({ "finger","daumen","zeigefinger","ringfinger" }),
      "Deine Finger sind nicht interessant, jedoch der gewaltige Finger, der "
      "Teil der Felsformation ist.");
   
   AddDetail( ({ "teil" }),
      "Eben nur ein Teil und nicht alles.");
   
   AddDetail( ({ "felsformation", "formation", "felsen" }),
      "An die 200 Meter hoch rage ein gewaltiger Felsen aus der Landschaft. "
      "Entfernt erinnert er an eine halb im Boden steckende Faust, die mit "
      "ausgestreckten Zeigefinger in den Himmel zeigt.");
   
   AddDetail( ({ "faust" }),
      "Es sieht tatsaechlich aus wie eine Hand aus Stein, die bis auf den "
      "ausgestreckten Zeigefinger zu einer Faust geballt ist.");
   
   AddDetail( ({ "hand" }),
      "Die Hand steht beinahe senkrecht aus dem Boden. Sie ist bis auf den "
      "Zeigefinger, der mahnend in den Himmel weist, zu einer Faust geballt. "
      "Die Felswand die die Finger bilden ist extrem steil. Man koennte auch "
      "sagen: Die Flanken des Felsens sind beinahe ueberhaengend.");
   
   AddDetail( ({ "flanken" }),
      "Beinahe senkrecht steigen die zerkluefteten Flanken der Felsformation "
      "an. Oben, wo der Daumen zu erahnen ist, scheint Rauch aufzusteigen. "
      "Auch glaubst Du beim Ringfinger in etwa 50 Meter Hoehe Rauch zu "
      "erkennen.");
   
   AddDetail( ({ "hoehe" }),
      "Das ist wirklich hoch oben.");
   
   AddDetail( ({ "rauch", "rauchschwaden" }),
      "An zwei Stellen steigt Rauch auf. Einerseits oben, wo der Daumen und "
      "der Zeigefinger einander beruehren und zirka auf halber Hoehe der "
      "Ringfingers.");
   
   AddDetail( ({ "stellen" }),
      "Beide Stellen lassen auf eine Oeffnung schliessen. Auch draengt sich "
      "der Verdacht auf, dass es sich eigentlich um einen Vulkan handelt.");
   
   AddDetail( ({ "verdacht" }),
      "Du bist Dir nicht wirklich sicher, aber Du hast einen Verdacht.");
   
   AddDetail( ({ "vulkan" }),
      "Sicher bist Du Dir nicht, aber fuer diese Rauchschwaden muesste schon "
      "ein gewaltiges Feuer im inneren brennen.");
   
   AddDetail( ({ "feuer" }),
      "Es muesste riesig sein. Vielleicht ist es ja wirklich ein Vulkan. "
      "Du kannst nur hoffen, dass er nicht vor einen Ausbruch steht.");
   
   AddDetail( ({ "oeffnung" }),
      "Da wird man wohl in der Felsen hinein kommen. Um herausfinden zu "
      "koennen, ob man das auch wirklich hinein kann, wird Dir nichts anderes "
      "uebrig bleiben, als den gefaehrlichen Aufstieg zu wagen.");
   
   AddDetail( ({ "ausbruch" }),
      "Das ist mit Sicherheit das Letzte was Du jetzt brauchen koenntest.");
   
   AddDetail( ({ "letzte" }),
      "Einen Ausbruch kannst Du jetzt wirklich nicht brauchen.");
   
   AddDetail( ({ "aufstieg" }),
      "Ja, der wird mit Sicherheit kein Honigschlecken. Der Fels ist zwar "
      "zerklueftet, was guten Halt bieten wuerde, andererseits koennen sich "
      "auch Felsen loesen und auf die stuerzen. Die Wand ist beinahe "
      "senkrecht bis ueberhaengend, wo mit man schon ausgezeichnet klettern "
      "koennen muss, um da heil rauf zu kommen.");
   
   AddDetail( ({ "halt" }),
      "Halt wirst Du sicher finden. Sofern Du die richtige Ausruestung mit "
      "hast.");
   
   AddDetail( ({ "sicherheit" }),
      "Darin bist Du Dir absolut sicher.");
   
   AddDetail( ({ "honigschlecken" }),
      "Das waere Dir mit Sicherheit lieber, als da rauf zu klettern.");
   
   AddDetail( ({ "stein" }),
      "Man koennte auch Fels dazu sagen.");

   AddDetail( ({ "fels" }),
      "Der Fels ist ja gluecklicherweise nicht glatt, sonst bestuende "
      "ja gar kein Chance hinauf zu kommen.");
   
   AddDetail( ({ "chance" }),
      "Sie lebt. Ob Du nach Deiner Chance noch lebst steht in den Sternen.");
   
   AddDetail( ({ "sterne" }),
      "Davon gaebe es reichlich, wenn Nacht waere.");
   
   AddDetail( ({ "nacht" }),
      "In der Nacht sieht man die Sterne. Jetzt ist aber Tag, darum siehst "
      "Du die Sonne.");
   
   AddDetail( ({ "tag" }),
      "Am Tag sieht man die Sonnen. Nicht die Sterne.");
   
   AddDetail( ({ "sonnen" }),
      "Die ist am Himmel. Aber ist das jetzt wirklich wichtig?");
   
   AddDetail( ({ "wand","felswand" }),
      "Schwierigkeitsstufe 9 wird ihr gerecht. Aber mit entsprechender "
      "Ausruestung wird man da schon raufklettern koennen.");
   
   AddDetail( ({ "ausruestung" }),
      "Du wird doch wissen, was man alles beim Klettern brauchen kann. "
      "Schwere und plumpe Ruestungen, lange und hinderliche Waffen und einen "
      "prall gefuellten Beutel. Oder?");
   
   AddDetail( ({ "schwierigkeitsstufe", "stufe" }),
      "Auf einer zehnteiligen Skala, wobei 1 extrem einfach und 10 unmöglich "
      "ist, wuerde ich eine glatte Zehn vergeben.");
   
   AddDetail( ({ "skala" }),
      "Die Skala hat 10 Teile: 1 bedeutet sehr einfach und 10 absolut extrem "
      "schwer.");
   
   AddDetail( ({ "zehn" }),
      "Auf der zehnteiligen Skala bedeutet eine Zehl eine absolute "
      "Herausforderung.");
   
   AddDetail( ({ "herausforderung" }),
      "Die Wand ist ein ultimative Herausforderung.");
   
   AddDetail( ({ "klettern" }),
      "Das solltest Du gut beherrschen, wenn Du da rauf willst!");
   
   AddDetail( ({ "ruestungen", "waffen","beutel" }),
      "Ruestungen, Waffen und anderes schweres Utensilien sind beim Klettern sehr "
      "hinderlich.");
   
   AddDetail( ({ "meter" }),
      "Eine sehr gaengige Masseinheit");
   
   AddDetail( ({ "masseinheit" }),
      "Irgendwie muss man sich ja festlegen.");
   
   AddDetail( ({ "utensilien" }),
      "Es gibt sicher noch vieles was beim Klettern hinderlich ist.");
   
   AddDetail( ({ "landschaft" }),
      "Du befindest Dich in der schoenen, huegeligen Landschaft des "
      "Silberlandes, die auch als das Huegelland bekannt ist.");
   
   AddDetail( ({ "silberland", "welt" }),
      "Das Silberland ist die Welt in der Du Dich befindest.");
   
   AddDetail( ({ "huegelland", "land" }),
      ([ "hobbit": "Das ist Deine wunderschoene Heimat.",
      0: "Das huegellige Land in dem Du Dich befindest wird als Huegelland "
      "bezeichnet. In ihm leben die Halbling." ]) );
   
   AddDetail( ({ "halbling", "hobbit" }),
      ([ "hobbit": "Du bist selbst ein Hobbit.",
         0: "Du wirst doch ein Hobbit kennen." ]) );
   
   AddDetail( ({ "heimat", "zuhause" }),
      "Das ist Dein Zuhause.");
   
   AddDetail( ({ "huegel" }),
      "Ein Huegel reiht sich im Huegelland an den anderen.");
   
   AddDetail( ({ "sterbliche" }),
      "Hier war wirklich schon lange niemand mehr.");
   
   AddDetail( ({ "niemand" }),
      "Wirklich keiner.");
   
   AddDetail( ({ "zeit" }),
      "Die Zeit verrinnt. Willst Dich nicht was wichtigerem beschaeftigen.");
   
   AddDetail( ({ "himmel" }),
      "Der blaue Himmel ist wie immer ueber Dir. Die Sonne scheint auf Dich "
      "herab. Ueber Dir kannst Du Rauchschwaden ausmachen.");
   
   AddDetail( ({ "sonne" }),
      "Hell strahlt sie auf Dich herab. Nur ein paar Rauchschwaden verdecken "
      "sie zeitweise.");
   
   AddDetail( ({ "rauchschwaden","schwaden","rauch" }),
      "Schaden aus Rauch stroemen aus der Oeffnung ueber Dir.");
   
   AddDetail( ({ "boden" }),
      "Der Boden ist mit Gras bedeckt. Bei der Felswand tuermen sich "
      "herabgestuerzte Felsbrocken.");
         
   AddDetail( ({ "felsbrocken" }),
      "Diese Felsbrocken, die mit der Zeit vom Finger abgebrochen sind, sind "
      "die Schutthalde des Felsen und bilden ein Rampe zur Felswand hinauf. "
      "Von kleinen Kieseln, ueber Steine bis hin zu wahren Findlingen ist "
      "hier alles zu finden. Teilweise weisen sie scharfe Kanten auf.");
   
   AddDetail( ({ "schutthalde","halde" }),
      "Vereinzelte Findlinge, Unmengen von Steinen und Millionen von Kiesel "
      "unterschiedlichster Groessen tuermen sich zu einer Rampe auf.");
   
   AddDetail( ({ "unmengen","millionen" }),
      "Wirklich extrem viele.");
   
   AddDetail( ({ "groessen" }),
      "Unzaehlige verschienden Groessen. Von winzig bis riesig.");
   
   AddDetail( ({ "rampe" }),
      "Von Gras zur Felswand hin hat sich ueber die Zeit eine Rampe aus "
      "Findlingen, Steinen und Kiesel aufgeschuettet.");
   
   AddDetail( ({ "kiesel" }),
       "Millionen von kleinem Kiesel liegen gemeinsam mit Findlingen und "
       "Steinen aufgeschuettet zu einer Halde hier.");
   
   AddDetail( ({ "steine" }),
       "Unmengen von Steinen unterschiedlichster Groessen liegen gemeinsam "
       "mit Findlingen und Kiesel aufgeschuettet zu einer Halde hier.");
   
   AddDetail( ({ "findlinge","findling" }),
       "Riesige Felsbrocken unterschiedlicher Groessen liegen gemeinsam mit "
       "Kiesel und Steinen aufgeschuettet zu einer Halde hier.");
   
   AddDetail( ({ "kanten" }),
       "Einige der Kanten sind scharf wie ein Messer und entstanden als der "
       "Fels beim Aufschlag auf den Boden geborsten ist. ");
   
   AddDetail( ({ "messer" }),
       "Wenn nicht noch schaerfer. Du solltest sehr vorsichtig sein, damit "
       "Du Dich nicht verletzt.");
   
   AddDetail( ({ "aufschlag" }),
       "Es muessen gewaltige Kraefte gewirkt haben, um massiven Felsen zum "
       "bersten zu bringen.");
   
   AddDetail( ({ "kraefte","kraft" }),
       "Sie muss wirklich gewaltig gewesen sein. Du bist Dir absolut sicher, "
       "dass kein Lebewesen einer solchen Kraft standhalten kann.");
   
   AddDetail( ({ "lebewesen" }),
       "Wirklich jedes Lebewesen!");
   
   AddDetail( ({ "gras" }),
       "Der Boden ist vollstaendig mit hohem Grasbueschel bedeckt.");
   
   
   AddDetail( ({ "bueschel","grasbueschel" }),
       "Das Gras gruppiert sich zu Bueschel. Der ganzen Boden ist von dem "
       "Gruenzeug bedeckt.");
   
   
   AddDetail( ({  "gruenzeug","zeug" }),
       "Die groesseren Grasbueschel sind einen halben Meter hoch. Die Halme "
       "stehen so dicht, dass man vom Boden kannst Du nichts mehr erkennen "
       "kann.");
   
   
   AddDetail( ({ "halme","grashalme" }),
      "Die Halme sind bis zu einen halben Meter hoch und stehen so dicht, "
      "dass man die Erde des Bodens nicht mehr sehen kann.");
   
   
   AddDetail( ({  "erde" }),
       "Die Erde kannst Du nicht erkennen, will Dir die Halme des Grases die "
       "Sicht nehmen.");
   
   
   AddDetail( ({ "sicht"  }),
       "Die Sicht auf den Boden ist Dir durch die Unmengen von Grashalme "
       "versperrt. Wenn Du den Boden sehen will, wirst Du sie zur Seite "
       "biegen muessen.");
   
   
   AddDetail( ({ "seite" }),
       "Auf die eine oder andere Seite.");
   
   AddDetail( ({ "platz" }),
      "Wahrscheinlich ist im Gras nichts mehr zu finden, aber wenn Du es Dir "
      "genau ueberlegst lag die Muenze nahe an den Steinen. Vielleicht solltest "
      "in den Steinen wuehlen."
      );
   
   AddDetail( ({ "ueberreste", "mensch","kerl","krieger" }),
      "Von den armen Kerl, der offenbar ein Krieger war, was Du leicht an den "
      "Plattenpanzer, den er traegt, und dem Resten eines zerbrochen Schwert "
      "erkennen kannst, ist außer seinen versplitterten Knochen nicht mehr "
      "viel übrig.");
   
   
   AddDetail( ({ "plattenpanzer","panzer" }),
       "Der einst praechtige Plattenpanzer ist voellig zerstoert.");
   
   AddDetail( ({ "schwert","resten","stuecke" }),
        "Das reich verzierte Schwert ist in mehrere Stuecke zerbrochen.");
   
   AddDetail( ({ "knochen" }),
        "Beinahe jeder groessere Knochen ist mehrfach gebrochen. Von den "
        "kleinen Steinen, unter denen er lag, koennen diese Verletzungen "
        "nicht kommen." );
   
   AddDetail( ({ "verletzungen","verletzung" }),
        "Die Verletzungen waren mit Sicherheit sofort toedlich und koennen "
        "nur von einem tiefen Sturz stammen.");
   
   AddDetail( ({ "sturz" }),
        "Den Krieger hat wohl sein Glueck verlassen als er die Wand erklimmen "
        "wollte. Er duerfte sehr hoch hinauf geklettert sein, bevor er "
        "abstuerzte.");
   
   AddDetail( ({ "glueck" }),
        "Na da bleibt nur zu hoffen, dass Du mehr Glueck und eine bessere "
        "Ausruestung hast.");
   
/*   
   AddDetail( ({ "" }),
       );
   
*/
   AddSound( DEFAULT_SOUND,
      "");

   AddSound( ({ "" }),
      "");

   AddSmell( DEFAULT_SMELL,
      "");

   AddSmell( ({ "" }),
      "");


   AddCmd( ({ "biege","bieg" }), "biege" );
   AddCmd( ({ "wuehle","wuehl" }), "wuehle" );
   AddCmd( ({ "klettere","kletter" }), "klettere" );
/*
   AddExit( RK1, "nach "+ RG1+ "#" + ROOM + "room2" );
*/
}


object checkKletter()
{
   object ob;
   
   ob = deep_present( "\nKletterPruef" );
   if( !ob )
   {
      ob = clone_object( OBJ + "kletter.lpc" );
      ob->move( TP, M_NOCHECK );
   }
   else
      ob->ZuerueckSetz();
   
   return ob;
}


int biege( string str )
{
   object ob;
   
   notify_fail( "Was willst Du wohin biegen?\n" );
   if( str == "halme zur seite" || "grashalme zur seite" )
   {
      if( random( 100 ) < 20 && !CheckPlayer( TP->query_real_name()))
      {
         if( (ob=clone_object( OBJ + "dublone.lpc" ))->move(TP) != 1 )
            ob->move( ENV( TP ));
         
         SetPlayer( TP->query_real_name(), 1 );
         
         write("Du biegst die Grashalme zur Seite und entdeckst ein glitzerndes"
            + " Etwas.\nEine goldene Muenze.\nDu denkst   . o O (Wo eine ist "
            + "werden wohl noch mehr sein!)\n");
         say( TPN +" biegt die Grashalme zur Seite und scheint etwas gefunden "
            + "zu haben.\n");
      }
      else
      {
         if( !CheckPlayer( TP->query_real_name()) )
         {
            write("Du biegst die Grashalme zur Seite und siehst den Boden.\n");
         }
         else
         {
            write(BS("Du biegst die Grashalme zur Seite und findest nichts, "
               + "aber  vielleicht suchst Du ja nicht an der richtigen "
               + "Platz.\n"));
         }
         say( TPN +" biegt die Grashalme zur Seite und wirkt etwas enteuscht.\n");
      }
      return 1;
   }
   return 0;
}


int wuehle(string str )
{
   notify_fail( "Worin willst Du wuehlen?\n" );
   if( str == "in steine" )
   {
      if( !CheckPlayer( TP->query_real_name()))
      {
         SetPlayer( TP->query_real_name(), 1 );
         
         write( BS( "Du wuehlst in den Steinen. Schon nach kurzer Zeit "
            + "endeckst Du Ueberreste eines Menschens. Erschrocken weichst "
            + "Du zurueck.\n" ));
         say( TPN +" wuehlt in den Steinen und schrickt zurueck.\n");
      }
      else
      {
         write( "Du traust Dich nicht nochmal in den Steinen zu wuehlen.\n");
      }
      return 1;
   }
   return 0;
}


int klettere(string str )
{
   object ob;
   
   notify_fail( "Wohin willst Du klettern?\n" );
   if( str == "rauf" || str == "hinauf" )
   {
      write(BS( "Du steigst die Schutthalde hinauf, haeltst kurz inne, "
         + "sammelst Deinen ganzen Mut und beginnst die Wand hinauf zu "
         + "klettern. \n"));
      say( BS( TPN +" steigt die Schutthalde hinauf, haelt kurz inne und "
         + "klettert in die Wand.\n"));
      
      ob = checkKletter();
      
      TP->move( ROOM + "aufstieg1", M_GO + M_SILENT );
      return 1;
   }
   return 0;
}


absturz( int schaden, int weg )
{
   say( BS( TPN+" stuerzt schreind auf Dich herab. " + TPN + "schlaegt "
      + "unweit von Dir mit voller Wucht auf den Felsen auf.\n "));
   write( "Der Boden kommt sehr schnell naeher!\n" 
      + BS( "Ein Sekunde spaeter spuerst Du die Wucht des Aufschlags bevor Du "
      + "das Bewusstsein verlierst.\n"));
   TP->do_damage( schaden );
}