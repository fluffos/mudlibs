// Xorgan@SilberLand
// Item zum Klettern
// 1999-06-26

#include "../def.h"

inherit "std/thing";

int angebunden;
int *seil;
int *haken;


create() 
{
   if(!is_clone(TO))
      return;
   
   ::create();

   seil  = (int*)allocate( 5 );
   haken = (int*)allocate( 5 );
   
   SetProp(P_SHORT, 0 );
   SetProp(P_LONG,  0 );
   SetProp(P_INFO,  0 );
   SetProp(P_NAME, "kletter");
   SetProp(P_GENDER, MALE);
   AddId("\nKletterPruef");

   SetProp(P_MATERIAL, 0);
   SetProp(P_WEIGHT, 0);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,1);
   SetProp(P_NEVERDROP,1);
   
}


void ZuerueckSetz()
{
   int i;
   
   for( i = 0; i < 5; i++)
   {
      seil[i]  = 0;
      haken[i] = 0;
   }
}


int SetSeil( int pos )
{
   int i;
   
   if( !seil[pos] )
   {
      seil[pos] = 1;
      return 1;
   }
   return 0;
}


int CheckSeil( int pos )
{
   return seil[pos];
}


int SetHaken( int pos )
{
   int i;
   
   if( !haken[pos] )
   {
      haken[pos] = 1;
      return 1;
   }
   return 0;
}


int CheckHaken( int pos )
{
   return haken[pos];
}


int SetAngebunden( int aktion )
{
   int i;
   
   if( angebunden != aktion)
   {
      angebunden = aktion;
      return 1;
   }
   return 0;
}


int CheckAngebunden()
{
   return angebunden;
}


