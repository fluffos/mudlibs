   AddExit( "runter", "nach unten#" + ROOM + "horst" );
}

int command(string str )
{
   notify_fail( "Was willst Du tun?\n" );
   if( str == "tuer" )
   {
      write("Du tust etwas.\n");
      say( TPN+" tut etwas.\n");
      return 1;
   }
   return 0;
}
