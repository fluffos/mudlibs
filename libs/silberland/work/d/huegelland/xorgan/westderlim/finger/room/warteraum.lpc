#include "../def.h"

inherit "std/room";

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Hoch ueber dem Riesenlindwurm" );
   SetProp( P_INT_LONG,
      "Du befindest Dich im Flug ueber dem Riesenlindwurm." );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );
   
/*
   AddDetail( ({ "" }),
      "");
   
   AddReadDetail( ({ "" }),
      "");
   
   AddSound( DEFAULT_SOUND,
      "");
   
   AddSound( ({ "" }),
      "");
   
   AddSmell( DEFAULT_SMELL,
      "");
   
   AddSmell( ({ "" }),
      "");
   
