// Xorgan@SilberLand
// Der Vulkan
// 2002-02-27

#include "../def.h"

inherit "std/room";

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Am Rand des Vulkan" );
   SetProp( P_INT_LONG,
      "Du befindest Dich an Rand eines grossen Kraters, der wie alles hier aus "
      "dem schwarzen Gestein besteht. Dichter Nebel liegt in der Luft, der es "
      "Dir unmoeglich macht die Dimensionen des Kraters wahr zu nehmen . Von "
      "oben her scheint diffuses Licht herein zu fallen. Zusaetzlich wird der "
      "Krater durch ein flackerndes rotes Leuchten erhellt. Es ist hier so "
      "Heiss, dass Dir das Atmen schwer faellt. " + CAP( RL5 ) + " von Dir "
      "geht es einige Meter ziemlich steil hinunter in den Krater. " 
      + CAP( RL1) + " geht ein Gang weiter, der wohl nach Draussen fuehrt." );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 1 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 33, ENV_TERRAIN: TT_CAVE]) );
   
   AddRoomMessage( ({
      "Du kannst vor lauter Schmerzen nur mehr flach atmen.\n",
      "Dir wird schwarz vor den Augen. Beinahe faellst Du in Ohnmacht.\n",
      "Deine Augen brennen fuerchterlich.\n",
      "Verzweifelt ringst Du nach Luft.\n",
      "Minutenlange Hustenanfaelle quaelen Dich.\n"
      "Lange haeltst Du das nicht mehr aus!\n"
      "Jeden Moment kannst Du bewusstlos werden!\n"
      "Das Brennen deiner Atemwege ist unertraeglich.\n"}), 60 );
   
   AddDetail( ({ "licht" }),
      "Das Licht ist diffus und kommt von oben.");
   
   AddDetail( ({ "gestein" }),
      "Das Gestein ist schwarz und poroes.");
   
   AddDetail( ({ "rand" }),
      "Du befindest Dich am Rand das Kraters, aber Du kannst auch hinein gehen.");
   
   AddDetail( ({ "krater" }),
      "Die Dimensionen des Kraters, der aus dem gleichen schwarzen Gestein "
      "besteht, wie der Gang auch, kannst Du auf Grund des dichten Nebels "
      "nicht erkennen. Von Oben her wird er erleuchtet. Du kannst ein unstet "
      "flackerndes rotes Leuchten erkennen.");
   
   AddDetail( ({ "dimensionen", "laenge", "breite" }),
      "Die Laenge und Breite des Kraters kannst Du, so sehr Du Dich auch "
      "bemuehst, nicht feststellen.");
   
   AddDetail( ({ "gang" }),
      "Ein schmaler niedriger Gang, der wohl nach Draussen fuehrt, beginnt "
      "in Richtung " + RG1 + ".");
   
   AddDetail( ({ "draussen" }),
      "Nicht drinnen.");
   
   AddDetail( ({ "richtung" }),
      "Moeglicherweise kannst Du in diese Richtung gehen.");
   
   AddDetail( ({ "ende" }),
      "Du kannst die andere Seite des Kraters nicht erkennen.");
   
   AddDetail( ({ "seite" }),
      "Es ist nicht moeglich das entfernte Ende des Kraters zu sehen.");
   
   AddDetail( ({ "nebel" }),
      "Der dichte Nebel reduziert Deine Sichtweite sehr stark. Du kannst das "
      "andere Ende des Kraters nicht erkennen. Er scheint nicht nur aus "
      "Wasserdampf zu bestehen.");
   
   AddDetail( ({ "dampf", "wasserdampf", "wasser" }),
      "Der Nebel besteht sicher nicht nur aus Wasser. Vielleicht solltest Du "
      "mal riechen.");
   
   AddDetail( ({ "sichtweite" }),
      "Sie ist die Distanz die man mit freiem Auge sehen kann. Hier ist sie "
      "beinahe null.");
   
   AddDetail( ({ "distanz" }),
      "Im allgemeinen eine Laenge.");
   
   AddDetail( ({ "auge", "augen" }),
      "Mit Deinen Augen kannst Du sehen -hoffentlich - hier zwar nicht sehr "
      "weit.");
   
   AddDetail( ({ "luft" }),
      "Die Luft ist stickig und das Atmen faellt Dir schwer. Du bist Dir "
      "sicher, dass seltsam und moeglicherweise giftige Gase enthalten sind.");
   
   AddDetail( ({ "gase", "gas" }),
      "Welche es sind kannst Du nicht untersuchen, dazu fehlt Dir die noetige "
      "Ausruestung. Dass etwas in der Luft ist, ist Dir klar, denn jeder "
      "Atemzug schmerzt und faellt Dir schwer. Du solltest Dich beeilen, bevor "
      "Du Dir eine schwere Vergiftung abbekommst.");
   
   AddDetail( ({ "vergiftung" }),
      "Es koennte leicht sein, dass die Gase hoch giftig sind. Verlasse diesen "
      "Ort lieber so schnell es moeglich ist.");
   
   AddDetail( ({ "ort" }),
      "Den Krater natuerlich.");
   
   AddDetail( ({ "ausruestung" }),
      "Die hast Du leider nicht dabei.");
   
   AddDetail( ({ "leuchten" }),
      "Ein unstetes rotes Leuchten ist in der Ferne zu erkennen.");
   
   AddDetail( ({ "ferne" }),
      "Wohl weitere weg.");
   
   AddDetail( ({ "heiss", "hitze" }),
      "Es ist selbst fuer einen Trolle zu heiss.");
   
   AddDetail( ({ "trolle" }),
      "Trolle verstrage Hitze am besten und selbst fuer die ist es zu heiss.");
   
   AddDetail( ({ "atmen", "atemzug" }),
      "Das Atmen schmerzt und faellt Dir schwer. Es koennte sein, dass nicht "
      "nur die unertraegliche Hitze, sondern auch der Nebel dafuer "
      "verantwortlich ist.");
   
   AddDetail( ({ "meter" }),
      "Meter kann man nicht untersuchen, nur messen.");
   
   AddDetail( ({ "grund" }),
      "Das wird wohl die Ursache sein.");
   
   AddDetail( ({ "ursache" }),
      "Das wird wohl der Grund sein.");
   
   AddDetail( ({ "Oben" }),
      "Na ueber Dir.");
   
   AddDetail( ({ "wirkung" }),
      "Noch spuerst Du keine Wirkung, aber Du bist ueberzeugt, dass sie nicht "
      "gut sein koennen.");
   
   AddDetail( ({ "decke" }),
      "Die kannst Du nicht sehen.");
   
   AddDetail( ({ "boden", "waende", "wand" }),
      "Der Boden besteht wie die Waende auch aus dem scharzen Gestein.");
   
   AddDetail( ({ "atemwege", "augen" }),
      "Sie brennen und schmerzen schon schrecklich.");
   
   AddDetail( ({ "brennen" }),
      "Das Brennen ist nicht mehr aus zu halten.");
   
   AddDetail( ({ "hustenanfaelle", "hustenanfall", "anfaelle", "anfall" }),
      "Die minutenlangen Hustenanfaelle treiben Dich zur Verzweiflung.");
   
   AddDetail( ({ "verzweiflung" }),
      "Es bringt Dich um.");
   
   AddDetail( ({ "schmerzen", "ohnmacht" }),
      "Die Schmerzen sind unertraeglich. Gleich wirst Du bewusstlos!");
   
   AddDetail( ({ "vulkan", "feuer" }),
      "Ein Feuer spuckender Berg.");
   
   AddDetail( ({ "donnern", "donner" }),
      "Gleichzeitig mit dem Donnern siehst Du ein Aufleuchten des roten "
      "Leuchtens. Das Vulkan bricht offenbar gerage aus.");
   
   AddDetail( ({ "champagnerflasche", "flasche", "oeffnen" }),
      "Du hast keine dabei, aber Du weisst wie das Oeffnen klingt.");
   
   AddDetail( ({ "erde" }),
      "Oder auch das Gestein.");
   
   AddDetail( ({ "moment" }),
      "Du hoffst, dass sich die Erde nicht diesen Moment auftut und Dich "
      "verschlingt.");
   
   AddDetail( ({ "abstand", "abstaenden" }),
      "Sie sind wie gesagt unregelmaessig.");
   
   AddSound( DEFAULT_SOUND,
      "Staendig hoerst Du ein Zischen, Donnern und Grollen");
   
   AddSound( ({ "donnern", "donner" }),
      "Lautes Donnern hallt in unregelmaessigen Abstaenden durch den Krater. "
      "Gleichzeitig kannst Du in der Ferne eines rotes Leuchten erkennen.");
   
   AddSound( ({ "grollen" }),
      "Es grollt aus wuerde jeden Moment die Erde aufbrechen.");
   
   AddSound( ({ "zischen" }),
      "Ein staendiges leiseres Zischen, das klingt als wuerde irgenwo - "
      "eigentlich ueberall - Gas entweichen, wird abgesehen von dem Grollen und "
      "Donnern, hin und wieder von einem Knall, dem ein lautest abschwellendes "
      "Zischen folgt, unterbrochen.");
   
   AddSound( ({ "knall" }),
      "Es kling als wuerde ein riesige Champagnerflasche geoeffnet.");
   
   AddSmell( DEFAULT_SMELL,
      "Ein scharfer beissender Geruch liegt in der Luft.");
   
   AddSmell( ({ "geruch", "luft" }),
      "Es riecht nach faulen Eiern. Wiederlich!");
   
   AddSmell( ({ "eier", "eiern" }),
      "Schwefel, das muss es sein.");
   
   AddSmell( ({ "schwefel", "schwefeldaempfe", "daempfe" }),
      "Schwefeldaempfe sind aetzend und hoch giftig. Lange kannst Du nicht hier "
      "bleiben, wenn Du nicht eine Vergiftung bekommen moechtest. Es sind "
      "sicher noch andere giftige Gase in der Luft.");
   
   AddSmell( ({ "gase" }),
      "Nicht alle Gase kann man riechen oder sehen, aber wenn Du Dich nicht "
      "beeist diesen Ort zu verlassen, wirst Du ihre Wirkung spueren.");
   
   
/*
   AddDetail( ({ "" }),
      "");
   
   AddReadDetail( ({ "" }),
      "");
   
   AddSound( DEFAULT_SOUND,
      "");
   
   AddSound( ({ "" }),
      "");
   
   AddSmell( DEFAULT_SMELL,
      "");
   
   AddSmell( ({ "" }),
      "");
   
   AddRoomMessage( 
      ({""}),30,"func");
   
   AddCmd( ({ "tue" }), "command" );

   AddItem( "item" , REFRESH_DESTRUCT);
*/

   AddExit( RK1, "nach " + RG1 + "#" + "./gang4" );
   AddExit( RK5U, "nach " + RG5U + "#" + "./krater1" );
}

command(string str )
{
   notify_fail( "Was willst Du tun?\n" );
   if( str == "tuer" )
   {
      write("Du tust etwas.\n");
      say( TPN+" tut etwas.\n");
      return 1;
   }
   return 0;
}
