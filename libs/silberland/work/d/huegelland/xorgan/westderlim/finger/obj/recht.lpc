// Xorgan@SilberLand
// Das Recht im Blut des Riesenlindwurms zu baden
// 2004-08-08

#include "../def.h"

#define MIN_DAMAGE     500

inherit "std/thing";

mapping gCanUse;

void create()
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT, "Lindwurmrecht" );
   SetProp(P_LONG, "Das ist ein Lindwurmrecht");
   SetProp(P_INFO, 0);
   SetProp(P_NAME, "lindwurmrecht");
   SetProp(P_GENDER, FEMALE);
   AddId( ({"lindwurmrecht", "QUESTOBJ"}) );
   
   SetProp(P_MATERIAL, 0);
   SetProp(P_WEIGHT, 0);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   SetProp(P_NEVERDROP, 1);
   SetProp(P_NODROP, 1);
   
   AddCmd( ({ "abtrete" }), "abtreten" );
}

void SetUser( mapping pMap )
{
   gCanUse = filter_mapping( pMap, "pruefung" );
}

int pruefung( object map )
{
   return interactive( map );
}

int CheckUser( object pName )
{
   if( gCanUse[pName] >= MIN_DAMAGE )
      return 1;
   else
      return 0;
      
}

mapping ShowUsers()
{
   return gCanUse;
}

void anleitung( object obj )
{
   tell_object( obj, BS( "Du hast Dir das Recht im Blut des Riesenlindwurms zu baden " 
                         "verdient. Wenn Du aus welchen Gruenden auch immer von diesem "
                         "Recht nicht gebauch machen, so kannst Du es auch mit dem "
                         "Kommando abtrete an einen anderen wuerdigen Spieler abtreten.\n" 
               ));
}

int abtreten( string str )
{
   string spieler;
   object obj;
   
   notify_fail( "Versuch's mal mit: abtrete recht an <spieler>!\n" );
   if( !str || sscanf( str, "recht an %s", spieler ) != 1 )
   {
      return 0;
   }
   
   obj = find_player( spieler );
   if( obj )
   {
      if( CheckUser( obj ))
      {
         write( "Du trittst das Recht an " + obj->name(RAW) + " ab.\n" );
         say( TPN + " tritt das Recht an " + obj->name(RAW) + " ab.\n" );
         TO->move( obj, M_NOCHECK );
         anleitung( obj );
      }
      else
      {
         write( "Dieser Spieler hat sich nicht als wuerdig erwiesen!\n" );
      }
   }
   else
   {
      write( "Das ist doch kein Spieler!\n" );
   }
   return 1;
}