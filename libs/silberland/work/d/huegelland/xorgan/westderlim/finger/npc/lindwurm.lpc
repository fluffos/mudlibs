   CLONEME( WEAPON ""  );
   command( "zuecke waffe" );
   CLONEME( ARMOUR ""  );
   command( "trage alles" );
   */
}


object SearchTarget( int pTyp )
{
   int i, anz, ziel, hp;
   object *enemy;
   
   if( pTyp == ATTACK_WEAKEST )
      hp = 999999;
   
   ziel = -1;   
   enemy = all_inventory( ENV( TO ));
   
   // Alles was lebt und nicht Magier ist, ist legitimes Ziel
   // egal ob enemy oder nicht! da gibt es kein zuschauen!
   for( i = 0; i < sizeof( enemy ); i++ )
   {
      if( interactive( enemy[i] ) && ( query_wiz_level( enemy[i] ) <= 2 || 
          IsEnemy( enemy[i] )) )
      {
         // Moegliche Ziele zaehlen
         anz++;
         
         if( pTyp == ATTACK_WEAKEST )
         {
            if( enemy[i]->QueryProp( P_HP ) < hp )
            {
               hp = enemy[i]->QueryProp( P_HP );
               ziel = i;
            }
         }
         else
         {
            if( enemy[i]->QueryProp( P_HP ) > hp )
            {
               hp = enemy[i]->QueryProp( P_HP );
               ziel = i;
            }
         }
      }
   }
   
   if( anz < 3 )
   {
      // sind es weniger als 3 dann einen Schlag auf alle und rauswerfen
      for( i = 0; i < sizeof( enemy ); i++ )
      {
         if( interactive( enemy[i] ) && ( query_wiz_level( enemy[i] ) <= 2 || 
             IsEnemy( enemy[i] )) )
         {
            enemy[i]->Defend( 1500, DT_WHIP, 
               ([ SP_NAME:"Ein gewaltiger Schwanzhieb",
                  SP_SHOW_DAMAGE:({ ({ 0, 
                  "Ein gewaltiger Schwanzhieb trifft Dich und schleudert dich hinaus.\n",
                  "",
                  "Ein gewaltiger Schwanzhieb trifft @WEN1 und schleudert @WEN1 hinaus.\n",
                  }) }),
                  SP_PHYSICAL_ATTACK:1
               ]), TO );
            
            enemy[i]->move( FLUCHT_RAUM, M_TPORT + M_SILENT, "", "", 
            " fliegt lauthals schreiend herein und schlaegt hart am Boden auf." );
            ziel = -1;
         }
      }
   }
   if( ziel == -1 )
      return 0;
   else
      return enemy[ziel];
}   


void Attack( object enemy )
{
   if( !attackCount )
      enemy = SearchTarget( ATTACK_WEAKEST );
   else
      enemy = SearchTarget( ATTACK_STRONGEST );
   
   attackCount++;
   if( enemy )
   {
      ::Attack( enemy );
      if( random( 100 ) >= 90 )
      {
         switch( random( 100 ))
         {
            case 1..20:
               // In die Luft werfen
               AngriffZusatz( enemy, "InDieLuft", 2 );
               break;
            case 21..40:
               // Kopfschuetteln
               AngriffZusatz( enemy, "KopfSchuettel", 1 );
               break;
            case 41..60:
               // hinaus in den Vorraum
               AngriffZusatz( enemy, "InSicherheit", 1 );
               break;
            default:
               // an die Wand
               AngriffZusatz( enemy, "AnDieWand", 1 );
               break;
         }
      }
   }
}


void AngriffZusatz( object enemy, string spruch, int zeit )
{
   string kname;
   
   switch( random(3) )
   {
      case 0:
         kname = DRAGON_NAME1;
         break;
      case 1:
         kname = DRAGON_NAME2;
         break;
      default:
         kname = DRAGON_NAME3;
         break;
   }
   
   write( kname + "  faehrt auf Dich hinab und packt Dich.\n" );
   say( kname + " faehrt auf " + TPN + " hinab und packt " + enemy->name( RAW ) );
   enemy->move( WARTE_RAUM, M_TPORT + M_SILENT, "", "", "" );
   enemy->SetProp(P_PARALYZED, ([
      PARALYZE_TIME:-1, 
      PARALYZE_MSG: "Du bist zu keiner sinnvollen Handlung faehig!\n",
      PARALYZE_END: "",
      PARALYZE_END_OTHER: ""]));
   
   call_out( spruch, zeit, enemy, kname, 0 );
}


void AngriffZusatzEnde( object enemy, int noattack, int nospell )
{
   enemy->SetProp(P_PARALYZED, ([
      PARALYZE_TIME:0, 
      PARALYZE_MSG: "Du bist zu keiner sinnvollen Handlung faehig!\n",
      PARALYZE_END: "",
      PARALYZE_END_OTHER: ""]));
   enemy->move( TO, M_TPORT + M_SILENT, "", "", "" );
   
   if( noattack > 0 )
      enemy->SetProp( P_DISABLE_ATTACK, noattack );
   if( nospell > 0 )
      enemy->SetProp( P_DISABLE_SPELLS, nospell );
   
}


void InDieLuft( object enemy, string kname, int lauf )
{
   string uo, lr;
   
   uo = "Oben";
   lr = "linke";
   
   if( !enemy )
      return;
   
   switch( lauf )
   {
      case 0:
         write( BS( kname + " schleudert Dich mit gewaltiger Karft nach oben.\n" ));
         break;
      case 4:
         write( BS( "Endlich hast Du den Scheitelpunkt erreicht. Ab nun geht es wieder "
            "runter.\n" ));
         break;
      case 8:
         enemy->Defend( 900, DT_RIP, 
            ([ SP_NAME:"Ein Flug",
               SP_SHOW_DAMAGE:({ ({ 0, 
               "Du schlaegt unglaublich hart auf dem Boden auf.\n",
               "",
               enemy->Name() + "schlaegt unglaublich hart auf dem Boden auf.\n",
               }) }),
               SP_PHYSICAL_ATTACK:1
            ]), TO );
         
         AngriffZusatzEnde( enemy, 5, 5 );
         return;
         break;
      case 5..7:
         uo = "Unten";
         //Kein break hier!
      case 1..3:
         if( random( 2 ))
            lr = "rechte";
         
         switch( random(10) )
         {
            case 0:
               write( BS( "Du fliegst Dich in allen Richtungen ueberschlagend "
                  "weiter nach " + uo + ".\n" ));
               break;
            case 1:
               write( BS( "Dein geschundener Koerper streift die Felswand der Hoehle. "
                  "Blut spritzt als der scharfkantige Fels dein Fleisch aufreisst.\n" ));
               break;
            case 2:
               write( BS( "Du schlaegst hart gegen die Hoehle. Das ist Dein Ende!\n" ));
               break;
            case 3:
               write( BS( "Du ueberschlaegst Dich waehrend Du weiter nach " + uo 
               + " fliegst voellig unkontrolliert in alle Richtungen.\n" ));
               break;
            case 4:
               write( BS( "Deine " + lr + " Hand verharkt einen Felsvorsprung. Die "
                  "beleibt die Luft weg als Knochen brechen.\n" ));
               break;
            case 5:
               write( BS( "Dein " + lr + "s Bein verhaengt sich in einer Ritze. Du "
                  "schleuderst herum und ein stechender Schmerz zuckt durch dein "
                  + lr + " Knie.\n" ));
               break;
            case 6:
               write( BS( "Dein " + lr + " Arm verhaengt sich in einer Ritze. Du "
                  "schleuderst herum und ein stechender Schmerz zuckt durch dein "
                  + lr + " Ellenbogen.\n" ));
               break;
            case 7:
               write( BS( "Du rast mit dem Kopf voran gegen die Felswand. Dir wird "
               "schwarz vor den Augen..." ));
               break;
            case 8:
               write( BS( "Du hast voellig die Orientierung verloren." ));
               break;
            case 9:
               write( BS( "Hilflos musst Du mitansehen wie du weiter nach " + uo 
                  + "fliegst."));
               break;
         }
         break;
   }
   lauf++;
   call_out( "InDieLuft", 2, enemy, kname, lauf );
   
}


void KopfSchuettel( object enemy, string kname, int lauf )
{
   if( !enemy )
      return;
   
   if( lauf <= 2 )
   {
      switch( lauf )
      {
         case 0:
            write( BS( kname + " beisst zu. Deine Ruestung aechzt und kracht.\n" ));
            break;
         case 1:
            write( BS( kname + " bohrt sein dolchlange Zaehne in Deinen Koerper.\n" ));
            break;
         case 2:
            write( BS( kname + " schuettelt sich mit Dir in seinem Maul. Du bruellst "
               "vor Schmerzen.\n" ));
            break;
      }
      
      lauf++;
      call_out( "KopfSchuettel", 1, enemy, kname, lauf );
   }
   else
   {
      enemy->Defend( 600, DT_RIP, 
         ([ SP_NAME:"Ein Kopfschuetteln",
            SP_SHOW_DAMAGE:({ ({ 0, 
            kname + " schuettelt sich und wirft Dich zu Boden.\n",
            "",
            kname + " schuettelt sich und wirft @WEN1 zu Boden.\n",
            }) }),
            SP_PHYSICAL_ATTACK:1
         ]), TO );
      
      AngriffZusatzEnde( enemy, 3, 3 );
   }
}


void AnDieWand( object enemy, string kname, int lauf )
{
   if( !enemy )
      return;
   
   write( BS( kname + " reisst herum und ein furchtbarer Schmerz durchzieht deinen "
      "Koerper.\n" ));
   call_out( "AnDieWand1", 1, enemy, kname );
}

void AnDieWand1( object enemy, string kname )
{
   if( !enemy )
      return;
   
   write( BS( kname + " schleudert herum und laesst Dich los.\n" ));
   call_out( "AnDieWand2", 1, enemy, kname );
}

void AnDieWand2( object enemy, string kname )
{
   string ri;
   
   if( !enemy )
      return;
   
   switch( random(4) )
   {
      case 0:  ri = RG1; break;
      case 1:  ri = RG3; break;
      case 2:  ri = RG5; break;
      default: ri = RG7; break;
   }
   enemy->Defend( 1000, DT_SQUEEZE, 
      ([ SP_NAME:"Die Hoehlenwand",
         SP_SHOW_DAMAGE:({ ({ 0, 
         "Du fliegst voellig unkontrolliert auf die " + ri + "wand zu und schlaegst "
         "hart auf.\n",
         "",
         "",
         }) }),
         SP_PHYSICAL_ATTACK:1
      ]), TO );
   
   call_out( "AngriffZusatzEnde", 1, enemy, 4, 4 );
}


void InSicherheit( object enemy, string name, int lauf )
{
   if( !enemy )
      return;
   
   enemy->Defend( 800, DT_WHIP, 
   ([ SP_NAME:"Ein Freiflug in Sicherheit",
      SP_SHOW_DAMAGE:({ ({ 0, 
      name + " holt weit aus und schleudert Dich aus der Hoehle hinaus.\n",
      "",
      "",
      }) }),
      SP_PHYSICAL_ATTACK:1
   ]), TO );
   enemy->move( FLUCHT_RAUM, M_TPORT + M_SILENT, "", "", 
      " fliegt lauthals schreiend herein und schlaegt hart am Boden auf." );
   
   enemy->SetProp(P_PARALYZED, ([
      PARALYZE_TIME:4, 
      PARALYZE_MSG: "Du bist zu keiner sinnvollen Handlung faehig!\n",
      PARALYZE_END: "",
      PARALYZE_END_OTHER: ""]));
}

