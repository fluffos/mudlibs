int attackCount;

void create( ) 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();

   SetProp( P_SHORT, DRAGON_NAME_FULL + ", der dreikoepfige Riesenlindwurm" );
   SetProp( P_LONG,
      "Auf seinen gewaltigen Hort liegt der uralte Riesenlindwurm - ein Drache von "
      "gewaltigen Ausmassen mit DREI Koepfen. Auf sechs mit scharfen und langen "
      "Krallen bewehrte Beine ruht der gewaltige mit Schuppen besetze Koerper des "
      "Ungetuems. Die zwei kraeftigen Fluegel haben wohl eine Spannweite von 15 Meter. "
      "Sein gut und gerne 10 Meter langer Schwanz endet in einer flachen dreieckigen "
      "und rasierklingenscharfen Hornplatte, einer Waffe vor der man sich in Acht "
      "nehmen muss. Ebenso lange sind die drei maechtigen Haelse, die zu jedem der drei"
      " beeindruckenden Koepfen fuehren. Jeder dieser Koepfe ist eines Diamantdrachen "
      "wuerdig. Schmal und lange ist das mit dolchlangen Zaehnen bewehrte Maul. Aus den "
      "an der Spitze liegenden Nasenloechern steigt beissender Rauch auf. Die zwei "
      "gelben Echsenaugen mit den schmalen schwarzen Schlitzen durchbohren dich "
      "foermlich. Meterlange Hoerner ragen rueckwaerts aus der Stirn." );

   SetProp( P_NAME, DRAGON_NAME_FULL );
   SetProp( P_GENDER, MALE );
   SetProp( P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-50,T_RANGE_MAX:50] ) );
   AddId( ({ DRAGON_NAME_FULL, "riesenlindwurm", "lindwurm", "NOWIMPY", "NO_MUMMY", 
             "NOCONTROL", "NOFALLDOWN" }) );
   RemoveId( "drache" );
   set_living_name( "riesenlindwurm" );

   create_default_dragon( 5, 12, 2, 60 );
   SetProp( P_HANDS, ({" mit drei gewaltigen Maeulern und seinem Schwanz",
      QueryProp(P_HANDS)[1],DT_RIP}) );
   SetProp( P_MAX_HP, QueryProp( P_MAX_HP ) * 2 );
//   SetProp( P_BODY, 500 );
   SetProp( P_XP, QueryProp( P_XP ) * 2 ); // Bonus fuer Spells
//   SetProp( P_RACE, "Drache" );
   SetProp( P_SIZE, 2550 );  // Vom der Schwanzspitze bis zur Schnauze
   SetProp( P_WEIGHT, 2000000 ); // 2 Tonnen sind wohl nicht zu viel
//   SetProp( P_ALIGN, 0 );
   SetProp( P_MAX_HANDS, 6 ); 
   SetProp( P_HEAL, 0 ); // Eigentlich sollte das sofort toetlich sein!
   SetProp( P_AGGRESSIVE, 0 );
   SetProp( P_WIMPY, 0 );
   
   SetProp( P_RESISTANCE_STRENGTHS, 
    ([DT_FIRE:      -1.0, DT_COLD:      -0.5, DT_WATER:  -0.5, DT_AIR:    -0.5, 
      DT_LIGHTNING: -0.5, DT_EXPLOSION: -0.5, DT_SOUND:  -0.5, DT_LIGHT:  -0.5,
      DT_ELECTRIC:  -0.5, DT_ACID:      -1.0, DT_POISON: -0.5, DT_TERROR: -0.5,
      DT_HOLY:      -0.5, DT_UNHOLY:    -0.5, DT_MAGIC:  -1.0, DT_MIND:   -1.0 ] )  );

//   SetProp(P_ARTICLE, 0 );
//   SetProp( P_NOMAGIC, 50 );

   SetProp( P_MSGIN, "landet auf seinem beeindruckenden Hort" );
   SetProp( P_MSGOUT, "breitet seine gewaltigen Schwingen aus und fiegt #." );
   SetProp( P_MMSGIN, "landet auf seinem beeindruckenden Hort" );
   SetProp( P_MMSGOUT, "breitet seine gewaltigen Scheingen aus und fiegt davon." );

   SetProp( P_DIE_MSG,  " bricht toetlich getroffen ueber seinem Hort zusammen.\n" );
   SetProp( P_NOCORPSE, 0  );
   SetProp( P_MURDER_MSG, "Das naechste mal bist Du dran!" );
   SetProp( P_KILL_NAME, DRAGON_NAME_FULL );
   SetProp( P_KILL_MSG, "HMMMM! Der kleine Imbiss schmeckte nicht schlecht!" );
   
   SetProp(P_LOG_INFO, "xorgan/lindwurm.info");
   
   AddInfo( DEFAULT_INFO, "versteht Dich doch gar nicht.\n" );

   SetProp( P_REJECT, ({ REJECT_DESTRUCT, DRAGON_NAME_FULL + " begutachtet Deine "
      "Sachen und fuegt es danach seinem Hort hinzu.\n" }) );
   
   SetProp( P_SPELLRATE, 66 ); 
   AddSpell(10,2000,
      DRAGON_NAME1 + " speit Dir aetzende Saeure entgegen.\n",
      DRAGON_NAME1 + " speit @WEN aetzende Saeure entgegen.\n",
      DT_ACID,([SP_SHOW_DAMAGE:1]));
   AddSpell(10,2000,
      DRAGON_NAME2 + " huellt Dich in eine Giftwolke ein.\n",
      DRAGON_NAME2 + " huellt @WEN in eine Giftwolke ein.\n",
      DT_POISON,([SP_SHOW_DAMAGE:1]));
   AddSpell(10,2000,
      DRAGON_NAME3 + " schleudert Dir einen gewaltigen Blitz entgegen.\n",
      DRAGON_NAME3 + " schleudert @WEN einen gewaltigen Blitz entgegen.\n",
      DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));


   /*
   AddDetail( ({ "" }), 
      "" );
   
   AddInfo( ({"",""}),
      ".",
      "sagt: " );
   
   SetProp( P_LOG_INFO, "npc_logfile" );
   
   AddSpell( 1,0,
      ".\n",
      ".\n",
      DT_,( [SP_SHOW_DAMAGE:1] ) );
   
   SetChats( 3, ({
      ".\n"})  );
   SetAttackChats( 10, ({
      ".\n"})  );
   */
