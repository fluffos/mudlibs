void die( int poisondeath ) 
{
   object ob;
   
   if( !poisondeath )
   {
      write_file( LOGPATH + "lindwurm.kills",
         ctime()+ ": " + CAP(getuid(TP)) + " killt den NPC.\n" );
      
      if( interactive( TP ))
      {
         ob = clone_object( OBJ + "recht.lpc" );
         ob->SetUser( QueryProp( P_ENEMY_DAMAGE ));
         ob->move( TP, M_NOCHECK );
         ob->anleitung( TP );
      }
// Xorgan: Hier kommt noch was hin
// "/obj/gemmaster"->DistributeGem( amount, rand, art, automove, typ );
// "/obj/pearlmaster"->DistributePearl(amount, rand, art, automove, typ);
      
   }
   
// Xorgan: Zwecks test
//   ::die( poisondeath );
}


void NotifyPlayerDeath(object player, object killer, int lostexp ) 
{
   if( killer == ME )
      write_file(LOG "lindwurm.deads",
         ctime() + ": Der NPC hat gerade " + CAP(getuid(player)) + " umgebracht.\n" );
}


// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch ) 
{
   if( find_call_out( "reaction" ) != -1 ) 
      return;
      
   if( touch )
   {
      TP->Defend( 100 + random(300), DT_ACID, 1, TO); 
   }
   else
   {
      switch( gruppe ) 
      {
         case "aengstlich":
            call_out("reaction", 0, TP, 
               "lacht: Ja Du Wurm! ZITTERE vor uns! ",
               "verspottet " + TP->name(WEN) + "." );
            break;
         case "intim":
         case "aergerlich":
         case "fies":
         case "frech":
         case "albern":
            if( CheckPlayer( TP->name( RAW )))
               call_out("angriff",0," erklaert gelassen: Also gut, Du willst wohl sterben.\n" );
            else
            {
               call_out("reaction", 0, TP,
                  "erwiedert veraergert: Verschindet, bevor ich Dich fresse!",
                  "erwiedert veraergert: Verschindet, bevor ich Dich fresse!" );
               SetPlayer( TP->name( RAW ), 1 );
            }
            break;
         case "froh":
         case "nett":
         case "neutral":
         case "traurig":
         default:
            call_out("reaction", 0, TP,
               "scheint das nicht zu interessieren.", 
               "interessiert sich nicht fuer " + TP->name( WEN ) + "." );
            break;
      }
   }
}

void StartReactionAll( string verb, string gruppe, string adverb, int touch ) 
{
   return StartReaction( verb, gruppe, adverb, touch );
}

void reaction( object ob, string macher, string andere ) 
{
   if( present( ob, ENV(TO) ))
   {
      tell_object( ob, BS( Name( WER, 1 ) + " " + macher ) );
      tell_room( ENV(TO ), BS( Name( WER, 1 ) + " " + andere ), ({ob}) );
   }
}


void angriff(string text)
{
   if( present( TP, ENV(TO)) ) 
   {
      tell_room( ENV(TO), Name(WER, 1) + text );
      Kill( TP );
   }
}

