#include "def.h"

/*
#include <moving.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>
#include <combat.h>
#include <new_skills.h>
*/
#define ATTACK_SPEED 100

inherit "std/thing";

create() 
{
   if (!is_clone(this_object()))
      return;
   
   ::create();

   SetProp(P_SHORT, "Ein sinnloser Test");
   SetProp(P_LONG,
      "Ein Test. "
      );
   
   SetProp(P_INFO,
      "Ein eine Testinfo."
      );
   SetProp(P_NAME, "Test");
   SetProp(P_GENDER, MALE);
   AddId(({"test"}));

   SetProp(P_MATERIAL, ([MAT_MISC_MAGIC:100]));
   SetProp(P_WEIGHT, 5);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,1);
   SetProp(P_NEVERDROP, 1);
   
   AddCmd( ({"schaden" }), "damage");
   AddCmd( ({"teste", "test" }), "test");
   AddCmd( ({"haut", "haut" }), "haut");
   AddCmd( ({"machfehler" }), "fehler");
}

int test( string str )
{
   str = "Das ist ein Test.";
   write( "Text: " + str + "\n" );
   CHMASTER->join( "Info", TO );
   CHMASTER->send( "Info", TO, str, MSG_SAY );
   return 1;

}

int feinde( string str )
{
   int i, anz;
   object *enemy;
   
   enemy = all_inventory( ENV( TP ));

   write( "Anz: " + sizeof( enemy ) + "\n" );
   for( i = 0; i < sizeof( enemy ); i++ )
   {
      if( interactive( enemy[i] ) )
      {
         enemy[anz] = enemy[i];
         anz++;
         
         write( "Interactive:" + enemy[i]->name() + "\n" );
      }
   }
   
   enemy[anz] = 0;
   write( "Anz: " + anz + "\n." );
    
   return 1;

}

string _query_info()
{
   return "This is a test!";
}


int damage( string str )
{
   
   switch( str )
   {
      case "fire":
         ENV(TO)->Defend(1000, DT_FIRE, 1, TO);
         write( "Da hast!\n");
         break;
      case "water":
         ENV(TO)->Defend(1000, DT_WATER, 1, TO);
         write( "Da hast!\n");
         break;
      default:
         write( "Nix da!\n");
         break;
   }
   return 1;
}

int fehler( string str )
{
   raise_error( "Das ist nur ein Test-fehler!\n" );
   return 1;
}


int haut( string str )
{
   object ob;
   
   if( !present( "\nschuppenhaut", TP ))
   {
      ob = clone_object( ARMOUR + "schuppenhaut.lpc");
      ob->SetOwner( TP->query_real_name() );
      ob->move( TP );
      ob->DoWear( 1, 0);
      write( "Nun hast Du eine Drachenschuppenhaut!\n");
   }
   else
   {
      write( "Du hast schon eine Drachenschuppenhaut!\n");
   }
   return 1;
}

