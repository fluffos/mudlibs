// Xorgan@SilberLand
// Der Hoehleneingang in den mahnenden Finger
// 2002-02-22

#include "../def.h"

inherit "std/room";

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Der Hoehleneingang in den mahnenden Finger" );
   SetProp( P_INT_LONG,
      "Du stehst in einer einen Hoehle. " + CAP( RL1 ) + " befindet sich "
      "die Felswand, die Du erklettern musstest, um hier her zu gelangen. "
      "Richtung " + RG5 + " blickst Du in einen Gang der nach wenigen "
      "Metern in Dunkelheit versinkt.");
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );
   
   AddDetail( ({ "felswand" }),
      "Du wirst Dich doch noch an die kleine Kletterpartie erinnern, oder?");
   
   AddDetail( ({ "kletterpartie" }),
      "Oder doch nicht?");
   
   AddDetail( ({ "hoehle" }),
      "Als richtige Hoehle kann man es eigentlich nicht bezeichnen. "
      "Vielmehr ist es eine Art Trichter der sich zu einem Gang verengt.");
   
   AddDetail( ({ "trichter" }),
      "Durch Wind und Wetter hat sich der Gang hier erweitert. Sowohl Decke "
      "als auch der Boden und die Waende verlaufen schraeg nach innen, womit "
      "die Hoehle immer enger wird und schliesslich in der Dunkelheit zu einem "
      "schmalen niedrigen Gang wird.");
   
   AddDetail( ({ "art" }),
      "Eine Art von Trichter!");
   
   AddDetail( ({ "wind", "wetter" }),
      "Die Kraefte der Natur haben ueber die Aeonen ganze Arbeit geleistet "
      "und aus einem ebenen Gang einen unregelmaessigen Trichter geschaffen.");
   
   AddDetail( ({ "kraefte", "natur" }),
      "Die Natur entwickelt beeindruckende Kraefte, die ganze Landschaften "
      "formen und veraendern koennen.");
   
   AddDetail( ({ "landschaft", "landschaften" }),
      "Allen Landschaften wurde von den Kraeften der Natur geschaffen.");
   
   AddDetail( ({ "aeonen" }),
      "Fuer einen Sterblichen eine unermesslich lange Zeit.");
   
   AddDetail( ({ "sterbliche" }),
      "Du bist ohne Zweifel ein Sterblicher.");
   
   AddDetail( ({ "sterblicher" }),
      "Oder kannst du nicht sterben? Denn dann waerst Du ein Unsterblicher.");
   
   AddDetail( ({ "unsterblicher" }),
      "Sei vorsichtig sonst wird gleich bewiesen, dass Du sterblich bist.");
   
   AddDetail( ({ "zweifel" }),
      "Hast Du keine.");
   
   AddDetail( ({ "zeit" }),
      "Davon hast Du zwar reichlich, aber sicher keine Aeonen.");
   
   AddDetail( ({ "arbeit" }),
      "Ist schon beindruckend was die Natur so alles vollbringen kann.");
   
   AddDetail( ({ "dunkelheit" }),
      "Schon nach wenigen Metern verschwimmt der Gang in Dunkelheit. Du kannst "
      "nur erahnen, dass er leicht nach unten abfaellt.");
   
   AddDetail( ({ "schritte", "meter" }),
      "Es ist ein nicht unuebliches Laengenmass.");
   
   AddDetail( ({ "mass", "laengenmass" }),
      "Damit bestimmt man die Laenge.");
   
   AddDetail( ({ "laenge" }),
      "Alles hat eine Laenge.");
   
   AddDetail( ({ "alles" }),
      "Ja, wirklich alles.");
   
   AddDetail( ({ "gang" }),
      "Ein schmaler niedriger Gang fuehrt tiefer in der Berg. Wie Du erahnen "
      "kannst faellt der Gang leicht nach unten ab.");
   
   AddDetail( ({ "boden" }),
      "Der Boden besteht wie erwartet aus voellig Fels und ist teilweise mit "
      "keinen Steinen bedeckt.");
   
   AddDetail( ({ "felsen", "fels", "stein", "steine", "material" }),
      "Es handelt sich um schwarzes, rauhes Material, wie es bei "
      "einem Vulkanausbruch entstehen kann.");
   
   AddDetail( ({ "ausbruch", "vulkanausbruch" }),
      "Vulkane bestehen oft aus diesem schwarzen Gestein.");
   
   AddDetail( ({ "vulkane", "vulkan" }),
      "Es deutet vieles darauf hin, dass es sich hierbei um einen Vulkan "
      "handel. Hoffentlich bricht er nicht aus.");
   
   AddDetail( ({ "gestein" }),
      "Das Gestein ist schwarz und poroes.");
   
   AddDetail( ({ "decke" }),
      "Die Decke kannst Du vor lauter Rauch kaum erkennen, aber auch sie "
      "besteht aus Fels.");
   
   AddDetail( ({ "waende", "wand" }),
      "Die Waende bestehen aus dem selben Material wie auch der Boden. Sie "
      "bieten keine besonderen Auffaelligkeiten.");
   
   AddDetail( ({ "auffaelligkeiten", "besonderes" }),
      "Es ist wirklich nichts Besonderes an den Waenden zu finden.");
   
   AddDetail( ({ "rauch" }),
      "Richtige Rauchschwaden nehmen Dir die Sicht. Du kannst die raue Decke "
      "nur erahnen.");
   
   AddDetail( ({ "sicht" }),
      "Du kannst die Decke kaum sehen.");
   
   AddDetail( ({ "rauchschwaden", "schwaden" }),
      "Schwaden von Rauch fliessen an der Decke entlang ins Freie. ");
   
   AddDetail( ({ "freie" }),
      "Raus aus der Hoehle, wo sie in den Himmel hinaufsteigen.");
   
   AddDetail( ({ "himmel" }),
      "Den kannst Du von der Position aus nicht wirklich erkennen, da Du zu "
      "weit in der Hoehle drinnen stehst und Dir die Rauchschwaden den Sicht "
      "nehmen.");
   
   AddDetail( ({ "position" }),
      "Von hier aus kannst Du den Himmel nicht sehen.");
   
/*   
   AddDetail( ({ "" }),
      "");
   
   AddDetail( ({ "" }),
      "");
   
   AddDetail( ({ "" }),
      "");
   
   AddDetail( ({ "" }),
      "");
   
   AddDetail( ({ "" }),
      "");
   
   AddDetail( ({ "" }),
      "");
   
   AddDetail( ({ "" }),
      "");
   
   AddDetail( ({ "" }),
      "");
   
   AddDetail( ({ "" }),
      "");
   
   AddDetail( ({ "" }),
      "");
   
   AddReadDetail( ({ "" }),
      "");
   
   AddRoomMessage( 
      ({""}),30,"func");
   
*/
   AddSound( DEFAULT_SOUND,
      "Du hoerst ein entferntes Donnern und grollen");
   
   AddSound( ({ "donnern", "donner", "grollen" }),
      "Es ist sehr leise und scheint vom Gang her zu kommen.");
   
   AddSound( ({ "gang" }),
      "Leise vernimmst Du ein Donnern und Grollen. Irgendwie scheint Dich das "
      "zu beunruhigen.");
   
   AddSmell( DEFAULT_SMELL,
      "Ein scharfer beissender Geruch liegt in der Luft.");
   
   AddSmell( ({ "geruch", "luft" }),
      "Es riecht leicht nach faulen Eiern. Wiederlich!");
   
   AddSmell( ({ "eier", "eiern" }),
      "Schwefel, das muss es sein. ");
   
   AddSmell( ({ "schwefel" }),
      "Auch der Schwefelgeruch scheint Dich nicht gerade zu beruhigen.");

   AddCmd( ({ "klettere","kletter" }), "klettere" );
   
   AddExit( RK6, "nach " + RG6 + "#" + ROOM + "gang1" );
}


object checkKletter()
{
   object ob;
   
   ob = deep_present( "\nKletterPruef" );
   if( !ob )
   {
      ob = clone_object( OBJ + "kletter.lpc" );
      ob->move( TP, M_NOCHECK );
   }
   else
      ob->ZuerueckSetz();
   
   return ob;
}


int klettere(string str )
{
   object ob;
   
   notify_fail( "Wohin willst Du klettern?\n" );
   if( str == "runter" || str == "hinunter" )
   {
      write(BS( "Vorsichtig rutsch Du ueber die Kante und kletterst etwas "
         + "hinunter.\n"));
      say( BS( TPN +" rutscht vorsichtig ueber die Kante und verschwindet in "
         + "der Wand.\n"));
      
      ob = checkKletter();
      
      TP->move( ROOM + "aufstieg5", M_GO + M_SILENT );
      return 1;
   }
   return 0;
}
