// Dublone 
// 2002-02-22

#include "../def.h"

inherit "std/thing";

create() 
{
   if(!is_clone(TO))
      return;
   
   ::create();

   SetProp(P_SHORT, "Eine Dublone");
   SetProp(P_LONG,
      "Eine sehr alte, grosse, goldene Muenze. Die ist sicher einiges Wert." );
   
   SetProp(P_NAME, "dublone");
   SetProp(P_GENDER, FEMALE);
   AddId( ({"dublone" }));

   SetProp(P_MATERIAL, ([MAT_GOLD:100]));
   SetProp(P_WEIGHT, 100);
   SetProp(P_VALUE, 1000);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,0);
}
