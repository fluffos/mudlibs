// Xorgan@SilberLand
// Beweglicher Adept
// 1999-12-31

#include "../def.h"

inherit "std/mnpc";

#include <mnpc.h>

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   int lev,ras,len;
   string *adj, *race;
   adj=({"unwissend","gelehrt","weis"});
   race=({"Mensch","Zwerg","Hobbit","Elf"});
   
   lev = random( 3 );
   ras = random( 4 );
   
   switch( ras )
   {
      case 1:
         len = 120;
      case 2:
         len = 100;
      case 3:
         len = 180;
      default:
         len = 170;
   }
   
   SetProp(P_NAME, "Adept");
   SetProp(P_NAME_ADJ, adj[lev]);
   AddAdjective( ({ adj[lev],adj[lev]+"er",adj[lev]+"en" }) );
   SetProp(P_SHORT, "Ein "+adj[lev]+"er Adept");
   
   SetProp(P_LONG,
      "Ein jungendlicher Schueler, der wohl noch einige Jahre Unterweisung vor "
      "sich hat, bevor er zum Priester gesalbt wird.");
   
   SetProp(P_GENDER, MALE);
   SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
   AddId(({"adept"}));
   
   create_default_npc(17 + lev);
   SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
   SetProp(P_RACE, race[ras]);
   SetProp(P_SIZE, len + random(25));
   SetProp(P_ALIGN, random( 201 ) + 800);
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_HEAL,0);
   SetProp(P_AGGRESSIVE,0);
   SetProp(P_WIMPY, QueryProp( P_HP ) / 3);
   SetProp(P_RESISTANCE_STRENGTHS , 
      ([DT_FIRE:    0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:     -0.2, DT_UNHOLY:   -0.1, DT_MAGIC:  0.0 ]) );
   
   SetProp(P_NOMAGIC,10);
   
   SetProp(P_MSGIN, "kommt an");
   SetProp(P_MSGOUT, "geht#");
   SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
   SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
   SetProp(P_MNPC_AREA, ({ ROOM + "room_c", ROOM + "room_d" }) );
   SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
   SetProp(P_MNPC_DEFAULTROOM, ROOM "room_d3");
   SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);


   SetProp(P_DIE_MSG,  " tritt vor seinen Gott.\n");
   SetProp(P_NOCORPSE, 0 );

   SetProp(P_LOG_INFO, "xorgan/adept.info");
   
   AddInfo(DEFAULT_INFO, "sagt: Entschuldigt. Ich habe keine Zeit fuer Eure Fragen!\n");

   SetProp( P_REJECT, ({ REJECT_DROP,
      "Der Adept entgegnet: Danke! Ich habe was ich brauche!.\n" }) );

   SetChats( 2, ({
      "Der Adept studiert ein Buch.\n",
      "Der Adept rezitiert ein Gebet.\n",
      "Der Adept ruft sich die Gebote in Erinnerung.\n",
      "Der Adept erlernt einen Lobgesang.\n"}) );
      
   SetAttackChats(10, ({
      "Der Adept ruft: HILFE!!! Ich werde von einem Unglaeubigen angegriffen!!!\n",
      "Der Adept ruft nach den Ordenskriegern!\n",
      "Der Adept sagt: Du wagst es mich anzugreifen. Nimm dass, Schurke!.\n",
      "Der Adept bittet um goettlichen Beistand!.\n",
      }) );

   SUID;
   CLONEME(ARMOUR + "kutte2.lpc" );
   command("trage alles");
}

