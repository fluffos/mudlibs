#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

int IsWield = 0;

void create() 
{
   if(!is_clone(TO))
      return;
   
   ::create();

   SetProp(P_SHORT, "Die Schwerter Antwort und Vergelter");
   SetProp(P_LONG,
      "Das sind die legenaeren Zwillingsschwerter Antwort und Vergelter. "
      "Die mit Symbolen und Runen verziehrten Klingen wurden von Meistern "
      "ihres Faches aus bestem Zwergenstahl und Mithril geschmiedet. "
      "Die aus bestem Leder gewickelten Griffe sorgen fuer einen guten "
      "Halt. Der goldene Knauf der Schwerter ist mit Edelsteine besetzt. "
      "Die beiden Klingen weisen leichte Unterschiede auf. "
      "Nur ein wahrer Schwertmeister kann diese gefuerchteten magischen "
      "Schwerter fuehren.\n" );
   
   SetProp(P_INFO, "Nur Schwertmeister koennen mit diesen Waffen zwei "
      "Angriffe fuehren.\n");
   
   AddDetail( ({"unterschied", "unterschiede" }), 
      "Die Klinge des einen Schwerter ist etwas kuerzer, dafuer jedoch "
      "breiter. Dieses Schwert verfuegt auch ueber eine laenger und "
      "stabieler Parierstangen. Nur ein genauer Vergleich kann das "
      "ergruenden.\n" );
   
   AddDetail( ({"zwillingsschwerter", "schwerter" }), "Es sind zwei "
      "einhaendige Schwerter unvergleichlicher Eleganz und Geschmeidigkeit." );
   
   AddDetail( ({"symbole", "runen" }), "Unzaehlige Runen und Symbole "
      "verziehren die Klingen der beiden Schwerter und verleihen ihnen "
      "eine mystische Ausstrahlung. Obwohl Du sie nicht uebersetzen "
      "kannst, bist Du sicher, dass sie magischen oder goettlichen "
      "Ursprungs." );
   
   AddDetail( ({"meister", "zwerge" }), "Nur wahre Meister der "
      "Schmidekunst sind in der Lage derart unvergleichliche Waffen zu "
      "schmieden. Eigentlich koennen sie nur Zwerge gefertigt haben." );
   
/*
   AddDetail( ({"", "" }), " "
      " ." );
*/   
   
   SetProp(P_NAME, ({"die Schwerter Antwort und Vergelter",
                     "der Schwerter Antwort und Vergelter",
                     "der Schwerter Antwort und Vergelter",
                     "die Schwerter Antwort und Vergelter"}) );
   SetProp(P_ARTICLE, 0);
   SetProp(P_GENDER, FEMALE);
   AddId( ({"zwillingsschwerter","schwerter","antwort","vergelter"}));

   SetProp(P_WEAPON_TYPE, WT_SWORD );
   SetProp(P_WC, 180);
   SetProp(P_DAM_TYPE, ({DT_SLASH}) );
   SetProp(P_NR_HANDS, 2 );
   SetProp(P_MATERIAL, ([ MAT_MISC_MAGIC: 100, MAT_STEEL: 50, MAT_MITHRIL: 20, 
      MAT_LEATHER: 10, MAT_SILVER: 10, MAT_MISC_JEWEL: 5, MAT_GOLD: 5]) );
   SetProp(P_WEIGHT, 2000);
   SetProp(P_VALUE, 2500);
   SetProp(P_NOBUY, 0);
   SetProp(P_QUALITY_DECAY, 130);
   SetProp(P_WC_FIXFACTOR, 0.7 );
   
   SetProp(P_WIELD_FUNC, TO );
   SetProp(P_UNWIELD_FUNC, TO );
//   SetProp(P_HIT_FUNC, TO );

   SetProp(P_WC_BONUS, (["oRitter":450 ]) );
   SetProp(P_WIELD_RESTRICTIONS, ([A_DEX:26,A_STR:20]) );
   
   AddCmd( ({ "vergleiche", "vergleich" }), "Vergleich");
   AddCmd( ({ "analysiere", "analysier" }), "Vergleich2");
}

int WieldFunc(object waffe) 
{
   if( TP->QueryProp( P_PRESAY ) == "Schwertmeister " || 
       TP->QueryProp( P_NAME ) == "Fradik")
   {
      IsWield = 1;
      if(TP->QuerySkillAttribute( SA_SPEED ) <= 200 )
      {
         TP->ModifySkillAttribute(TP, SA_SPEED, 200, 10);
      }
      call_out( "CheckWield", 10);
      return 1;
   }
   else
   {
      return 0;
   }
}

int UnwieldFunc(object waffe) 
{
   if(TP->QuerySkillAttribute( SA_SPEED ) <= 200 )
   {
      TP->ModifySkillAttribute(TP, SA_SPEED, 100, 1);
   }
   IsWield = 0;
   return 1;
}

int HitFunc( object enemy ) 
{
   return 0;
}

void CheckWield()
{
   if( IsWield == 1 )
   {
      if(TP->QuerySkillAttribute( SA_SPEED ) <= 200 )
      {
         TP->ModifySkillAttribute(TP, SA_SPEED, 200, 10);
      }
      call_out( "CheckWield", 10 );
   }
}

int Vergleich( string str )
{
   
   notify_fail( "Was moechtest Du vergleichen?\n" );
   if( str == "schwerter" )
   {
      write( "Ohne einen genauen Untersuchung kannst Du nichts feststellen!\n");
      return 1;
   }
   return 0;
}

int Vergleich2( string str )
{
   
   notify_fail( "Was moechtest Du analysieren?\n" );
   if( str == "schwerter" )
   {
      write( BS("Deine Analyse ergibt folgende Fakten: Antwort muss das "
             + "kuerzere Schwert sein, wird als Parierwaffe verwendet "
             + "und wird daher in der Schildhand gefuert. Daraus folgt, "
             + "dass Vergelter das laengere Schwert sein muss, die "
             + "Hauptangriffswaffe ist und logischwerweise in der "
             + "Schwerthand gefuert wird.\n"));
      return 1;
   }
   return 0;
}
