#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() 
{
   if(!is_clone(TO))
      return;
   
   ::create();

   SetProp(P_SHORT, "Eine Ochsenherde");
   SetProp(P_LONG,
      "Die Ochsenherde ist ein gefuerchtete Kettenwaffen. An einem ungefaehr "
      "50 Zentimeter langem mit Leder umwickelten Holzgriff sind an schweren "
      "Eisenketten drei faustgrosse Eisenkugeln befestigt. Die Kugeln sind "
      "mit furchterregenden Dornen gespickt, die jede Ruestung durchschlagen "
      "und furchtbare Wunden reissen."
       );
   SetProp(P_INFO, "");
   SetProp(P_NAME, "Ochsenherde");
   SetProp(P_GENDER, FEMALE);
   AddId( ({"ochsenherde", "herde"}) );

   SetProp(P_WEAPON_TYPE, WT_CHAIN );
   SetProp(P_WC, 250);
   SetProp(P_DAM_TYPE, ({DT_SQUEEZE}) );
   SetProp(P_NR_HANDS, 2);
   SetProp(P_MATERIAL, ([MAT_IRON:50,MAT_BEECH:40,MAT_LEATHER:10]) );
   SetProp(P_WEIGHT, 2500);
   SetProp(P_VALUE, 2000);
   SetProp(P_NOBUY, 1);
   SetProp(P_QUALITY_DECAY, 250);
   SetProp(P_WC_FIXFACTOR, 0.3 );
  
//   SetProp(P_WIELD_FUNC, TO );
//   SetProp(P_UNWIELD_FUNC, TO );
//   SetProp(P_HIT_FUNC, TO );

//   SetProp(P_WC_BONUS, (["": ]) );
   SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER:1,A_DEX:20,A_STR:23]) );
}

