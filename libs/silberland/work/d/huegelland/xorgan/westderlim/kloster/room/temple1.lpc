// Xorgan@SilberLand
// 
// 1999-06-26

#include "../def.h"

inherit "std/room";

//#include "../gottdetails.h"

create()
{
   ::create();
   
   SetProp( P_INT_SHORT, "Der Tempelplatz" );
   SetProp( P_INT_LONG,
      "Du befindest Dich auf einem kleinen Platz vor dem Tempel des " + GOTT + 
      ", der sich im " + RG1 + " erhebt. Der Platz ist mit einem niedrigen "
      "Zaun eingefasst. Links und rechts von Dir ist ein Garten angelegt worden."
      );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

   AddDetail( ({ "platz" }),
      "Ein kleiner Vorplatz der eigentlichen Tempelanlage. Er ist gepflastert "
      "und eigentlich kannst Du nichts besonderes an ihm feststellen."
      );

   AddDetail( ({ "pflaster" }),
      "Das Pflaster ist ein Muster, das durch das verwenden von unterschiedlich "
      "gefaebten Steinen erzeugt wird.");

   AddDetail( ({ "muster" }),
      "Mit den unterschiedlichen Farben der Steine ensteht ein schoenes Muster "
      "in Form von Quadraten am Boden. Im Inneren wurde ein roter Stein verwendet. "
      "Danach wechseln sich weisse und rote Reihen ab.");

   AddDetail( ({ "form" }),
      "Quadratisch!");

   AddDetail( ({ "farben", "rot", "weiss" }),
      "Klar: Rot und Weiss.");

   AddDetail( ({ "stein", "steine", "arten", "steinarten" }),
      "Du bist ja kein Geologe, aber es wurden fuer den Tempel und das Pflaster "
      "Marmor verwendet und den gibts in verschiedenen Farben.");

   AddDetail( ({ "geologe" }),
      "Der kennt sich sicher aus.");

   AddDetail( ({ "vorplatz" }),
      "Ein Platz vor einem Gebaeude.");

   AddDetail( ({ "gebaeude" }),
      "Da waeren zwei zu erwaehnen. Eines vor Dir und das andere hinter Dir.");

   AddDetail( ({ "anlage", "tempelanlage" }),
      "Du stehst vor ihr. Im " + RG1 + " erhebt sich der Tempel des " + GOTT + 
      "s. Schau ihn Dir ruhig genauer an.");

   AddDetail( ({ "tempel" }),
      "Ein herrlicher Bau aus weissem Marmor erhebt sich " + RL1 + " von Dir. "
      "Das Portal, das ueber drei breite Stufen erreicht werden kann, wird von "
      "den vier Saeulen, die das dreieckige Fries tragen, beherrscht. Es sind "
      "nicht nur einfache Saeulen, sondern Statuen, je zwei Maenner und Frauen, "
      "die mit festem Stand und unterstuetzt durch beide Arme den Eingang auf "
      "ihren Schultern tragen. Alle Vier machen trotz der offensichtlichen Last "
      "einen entspannten, ja wartenden Eindruck. Ihr Blicke schweifen ueber "
      "Deinen Kopf hinweg Richtung " + RG5 + ", als wuerden sie in der Ferne "
      "den Horizont absuchen. Hinter den Maennern und Frauen erkennst Du ein "
      "rechteckiges Kupfertor, dessen Fluegel vollig von Gruenspan ueberzogen, "
      "von Gravuren bedeckt sind und weit offen stehen. Hinter dem Fries, in "
      "einiger Entfernung, wird das Gebaeude von einer gewaltigen Kuppel, unter "
      "der sich wohl der Hauptraum befindet, ueberragt.");

   AddDetail( ({ "bau" }),
      "Anderes Wort fuer Gebaeude.");

   AddDetail( ({ "wort", "worte" }),
      "Es gibt viele unglaublich Worte");

   AddDetail( ({ "marmor" }),
      "Marmor, ein unglaublich schoenes Gestein. Poliert. Er glaenzt beinahe "
      "wie Edelsteine. Ein feine Maserung - Farbnuancen, als wuerde leben in "
      "ihm sein.");

   AddDetail( ({ "gestein" }),
      "Ja. Marmor ist das schoenste Gestein.");

   AddDetail( ({ "edelstein", "edelsteine" }),
      "Nur fast so wie Edelsteine.");

   AddDetail( ({ "maserung" }),
      "Der Stein ist nicht einfaerbig, nein, die Nuancen fliessen in einander.");

   AddDetail( ({ "nuancen", "farbnuancen", "varianten" }),
      "Unzaehlige Varianten von Weiss gehen in einander ueber.");

   AddDetail( ({ "portal", "protals" }),
      "Um zum Eingang zu gelangen, muss man ueber die drei Stufen steigen und "
      "zwischen den Saeulen hindurch schreiten. Die Saeulen sind gleichmaessig "
      "ueber die ganze Laenge des Frieses verteilt, wobei sich die Maenner und "
      "Frauen immer abwechseln, sodass links der Mann aussen steht und rechts "
      "die Frau. Das Innere des Tempels ist ueber das Fluegeltor zu erreichen.");

   AddDetail( ({ "stufen", "stufe" }),
      "Es sind drei grosse Stufen, die durch die Sockel der Statuen unterbrochen "
      "sind.");

   AddDetail( ({ "saeulen", "saeule", "statuen", "statue"}),
      "Die Statuen, die zwei Maenner und Frauen, sind gut drei vier Meter hoch "
      "und tragen das Fries auf ihren Schultern. Sie stehen breitbeinig auf "
      "einem Sockel, der mit der oberen Kante der dritten Stufe abschliesst, so "
      "dass es scheint als wuerden sie auf dieser stehen. Die Konturen sind sehr "
      "fein gearbeitet und strahlen Zuversicht und Hoffnung aus.");

   AddDetail( ({ "maenner", "mann" }),
      "Die Maenner stehen links aussen und recht innen. Sie unterschieden sich "
      "deutlich von einander und bilden mit der genau gegenueberliegenden Frau "
      "ein Paar.");

   AddDetail( ({ "frauen", "frau" }),
      "Die Frauen stehen links innen und recht aussen. Auch sie unterschieden "
      "sich deutlich von einander und bilden mit dem genau gegenueberliegenden "
      "Mann ein Paar.");

   AddDetail( ({ "paar" }),
      "Offensichtlich bilden die beiden inneren und die beiden aeusseren "
      "Statuen ein Paar. Irgendwie ist das mystisch.");

   AddDetail( ({ "inneren", "inneren statuen" }),
      "Beide stellen wohl die Buerger dar. Sie tragen normale Kleider. Ob das "
      "einen tieferen Sinn hat?");

   AddDetail( ({ "kleider" }),
      "Gut buergerliche Kleider.");

   AddDetail( ({ "aeusseren", "aeusseren statuen" }),
      "Sie stellen wohl Soldaten oder Krieger dar. Sie tragen Ruestungen und "
      "sind bewaffnet. Ob das einen tiefen Sinn hat?");

   AddDetail( ({ "soldaten", "krieger", "kaempfer", "fall" }),
      "Auf jeden Fall sind es Kaempfer.");

   AddDetail( ({ "sinn" }),
      "Dies ist schwer zu sagen, aber zufaellig scheint es nicht gerade zu "
      "sein. Es ist einfach mystisch.");

   AddDetail( ({ "mystisch" }),
      "Sind hier Buerger und Kaempfer willkommen, oder schuetzen die Krieger "
      "die Buerger, oder teilt sich der Glaube in einen Teil der durch die "
      "Buerger und einen anderen der durch die Kaempfer representiert wird, "
      "oder alles oder nichts davon, oder gibts noch mehr? Es mag zwar "
      "raetselhaft und Dir unverstaendlich erscheinen, aber es ist mit "
      "Sicherheit vom Erbauer so beabsichtigt worden.");

   AddDetail( ({ "fries", "frieses" }),
      "Das dreieckig Fries bildet den Abschluss des flachen Daches zur "
      "Vorderseite des Tempels hin. Das Fries, das mit Reliefes geschmueckt "
      "ist, scheint aus einem einzigen Stein gefertig zu sein."
      );

   AddDetail( ({ "dach" }),
      "Das Dach, das Du von dieser Position aus, schlecht sehen kannst, scheint "
      "aus Marmor zu bestehen und ist ziemlich flach zu sein.");

   AddDetail( ({ "relief" }),
      "Aus dem Stein des Frieses wurden zahlreiche Figuren, die ihrem Tagwerk "
      "nach gehen, geschnitten. Es scheinen alle Bevoelkerungsschichten "
      "vertreten zu sein.");

   AddDetail( ({ "position" }),
      "Optimal um den Tempel und seine Portal zu betrachten, aber denkbar "
      "schlecht, um das Dach zu inspizieren.");

   AddDetail( ({ "figuren" }),
      "Du siehst viele Figuren in dem Relief. Alle tragen unterschiedliche "
      "Kleidung und Werkzeuge, so dass man ihren Beruf erahnen kann. Nicht "
      "alle sind Menschen. Auch das scheint wohl einen tieferen Sinn zu haben.");

   AddDetail( ({ "beruf", "berufe" }),
      "Die Figuren representieren die verschiedensten Berufe. Das laesst sich "
      "anhand der Kleidung und dem Werkzeugen leicht erkennen.");

   AddDetail( ({ "kleidung" }),
      "Von dem Panzer eines Ritters bis zum schaebigen Umhang eines Bettlers "
      "kannst Du alles finden.");

   AddDetail( ({ "ritter" }),
      "Soll es hier auch einen geben.");

   AddDetail( ({ "werkzeuge", "werkzeug", "werkzeugen" }),
      "Vom maechtigen Zweihaender ueber einer Saege bis zum Stock kannst Du "
      "alles erkennen.");

   AddDetail( ({ "panzer", "saege", "stock", "zweihaender", "umhang", "sachen" }),
      "Du kannst Dich erinnern schon solche Sachen gesehen zu haben.");

   AddDetail( ({ "bettler" }),
      "Die hast auch schon getroffen.");

   AddDetail( ({ "vorderseite" }),
      "Die betrachtest Du und nach dem Du immer wieder neue interessante "
      "Details findest, stehst Du schon etliche Zeit vor dem Tempel und "
      "betrachtest begeistert seine Vorderseite.");

   AddDetail( ({ "mensch", "menschen" }),
      "Nicht alle?. Ganz im Gegenteil: Ein Grossteil der Figuren sind keine "
      "Menschen. Du kannst unter den Menschen etliche Figuren von anderen "
      "Rassen erkennen.");

   AddDetail( ({ "rassen", "rasse" }),
      "Es sind Zwerge, Hobbits, Elfen und Feen in grosser Zahl vertreten. Du "
      "kannst sogar einen Troll und einen Oger unter ihnen finden.");

   AddDetail( ({ "zwerge", "hobbits", "elfen", "feen", "oger", "troll", "dunkelelf" }),
      "Diese Rasse solls im Silberland geben!?");

   AddDetail( ({ "gegenteil" }),
      "Ist es wahr?");

   AddDetail( ({ "grossteil" }),
      "Eindeutig die meisten Figuren sind keine Menschen.");

   AddDetail( ({ "zahl", "anzahl" }),
      "Die Anzahl ist weniger von Interesse. Die Verteilung der einzelnen "
      "Rassen ist schon viel wichtiger!");

   AddDetail( ({ "detail", "details" }),
      "Oh. Davon gib es genug. Da kannst Du noch eine Weile untersuchen.");

   AddDetail( ({ "weile" }),
      "Vielleicht reicht eine Weile gar nicht aus, um alles zu erfahren.");

   AddDetail( ({ "verteilung" }),
      "Es scheint als ob Menschen, Elfen, Hobbits, Zwerge und Feen in gleicher "
      "Zahl vorkommen, waehrend nur einen Oger und einen Troll dargestellt "
      "wurde. Von den Dunkelelfen findest Du gar keinen. Seltsam.");

   AddDetail( ({ "silberland" }),
      "Du stehst doch mitten drin! Ja. Ja. Du weisst!");

   AddDetail( ({ "abschluss" }),
      "Hmmm... Eindeutig der vorderste Teil des Daches.");

   AddDetail( ({ "arme" }),
      "Die Arme der Statuen erwecken den Eindruck als stuetzten sie das Dach "
      "des Eingangs, das auf den Schultern der Statuen ruht. Sie sind seitlich "
      "neben dem Koerper halb ausgestreckt. ");

   AddDetail( ({ "schultern", "schulter" }),
      "Auf den Schultern liegt das Dach des Portals des Tempels. Ohne diese "
      "Statuen waere er mit Sicherheit eingestuerzt.");

   AddDetail( ({ "sicherheit" }),
      "Selbst ohne statische Berechnungen bist Du absolut sicher.");

   AddDetail( ({ "berechnungen" }),
      "Berechnungen sind voellig unnoetig. Du bis ja so schon sicher, dass das "
      "Portal ohne die Statuene einstuerzen wuerde.");

   AddDetail( ({ "tor", "fluegel", "fluegeltor", "kupfertor" }),
      "Der kupferne Fluegeltor, auf dem sich Gravuren befinden, ist voellig von "
      "Gruenspan ueberzogen und steht weit offen.");

   AddDetail( ({ "gravur", "gravuren" }),
      "Die Gravuren sind doch viel zu weit weg, um etwas Genaueres feststellen "
      "zu koennen. Du musst entweder naeher hin gehen oder ");

   AddDetail( ({ "genaueres" }),
      "Das kannst auf die Distanz nicht erkennen.");

   AddDetail( ({ "distanz" }),
      "Die ist wohl zu gross. Geh doch naeher ran.");

   AddDetail( ({ "bevoelkerungsschichten", "schichten", "schicht" }),
      "Bauern, Arbeiter, Handwerker, Beamte, Buerger, Adelige, Magier, Krieger, "
      "Soeldner, Haendler und viele mehr sind in dem Relief dargestellt. Du bist "
      "der Meinung, dass alle Staende vertreten sind.");

   AddDetail( ({ "blicke", "blick" }),
      "Die Statuen blicken ueber dich hinweg.");

   AddDetail( ({ "staende" }),
      "Es fehlt wirklich keiner. Du kannst es kaum glauben!");

   AddDetail( ({ "stand" }),
      "Ja, der ist sehr solide.");

   AddDetail( ({ "bauern", "arbeiter", "handwerker", "beamte", "buerger", 
                 "adelige", "soeldner", "haendler","krieger", "magier"}),
      "Das ist nur einer der vielen Staende die dargestellt sind.");

   AddDetail( ({ "eindruck"  }),
      "Diesen Eindruck kannst Du Dich aber ueberhaupt nicht erwehren.");

   AddDetail( ({ "eingang", "eingangs" }),
      "Der Eingang ist ein maechtiges Portal.");

   AddDetail( ({ "entfernung" }),
      "Es sind schon einige Meter.");

   AddDetail( ({ "ferne", "horizont" }),
      "Naja. Auf jeden Fall weit weg von hier.");

   AddDetail( ({ "gruenspan" }),
      "Gruenspan ist oxydiertes Kupfer oder anders ausgedrueckt rostiges "
      "Kupfer.");

   AddDetail( ({ "hauptraum", "raum" }),
      "Den kannst von hier aus nicht erkennen, nur erahnen.");

   AddDetail( ({ "hoffnung", "zuversicht" }),
      "Als wuesten Sie genau was auf sie zukommen wird.");

   AddDetail( ({ "kupfer", "metall" }),
      "Ein roetliches Metall. Aus ihm besteht das Fluegeltor.");

   AddDetail( ({ "kuppel" }),
      "Auf dem Dach, Du vermutest mal ziehmlich in der Mitte ragt ein grosse "
      "runde Kuppel in die Hoehe. Sie ist, wie das Tor aus mit Gruenspan "
      "bedecktem Kupfer. Auf ihrer Spitze ist ein kleines Tuermchen aufgesetzt.");

   AddDetail( ({ "mitte" }),
      "Wo wird die wohl sein. Dort wo die Kuppel sich befindet?");

   AddDetail( ({ "hoehe" }),
      "Sie ist ganz schoen hoch.");

/*
 Boden, Garten, Himmel, Interesse, Kante, Koerper, Konturen, Kopf, 
 Kuppel, Laenge, Last, Meinung, Meter, Quadraten, Reihen, Rohals, Sie, Sockel,
 Tagwerk, Teil, Vier, Zaun, Zeit.
*/

   AddDetail( ({ "spitze" }),
      "Oben auf der Kuppel ist ein kleines Tuermchen aufgestzt.");

   AddDetail( ({ "tuermchen", "turm" }),
      "Auf die Kuppel ist Turm aus Marmor gesetzt.");

   AddDetail( ({ "" }),
      "");

   AddDetail( ({ "" }),
      "");

   AddDetail( ({ "" }),
