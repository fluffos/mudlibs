// Xorgan@SilberLand
// Kutte fuer Adepten
// 2000-01-28

#include "../def.h"

inherit "std/armour";

create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT, "Eine braune Kutte");
   SetProp(P_LONG,
      "Dies ist ein Kutte wie sie von Moenchen getragen wird. "
      "Der Stoff ist grob gewebt, was ihn sicher Wiederstandfaehig macht."
      );
   SetProp(P_NAME, "braune Kutte");
   SetProp(P_GENDER, FEMALE);
   AddId( ({"kutte"}));
   
   SetProp(P_AC, 8);
   SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
   SetProp(P_MATERIAL, MAT_COTTON );
   SetProp(P_WEIGHT, 1000);
   SetProp(P_VALUE, 800);
   SetProp(P_NOBUY, 0);
   
}
