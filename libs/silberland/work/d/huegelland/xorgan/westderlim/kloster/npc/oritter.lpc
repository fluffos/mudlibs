#include "../def.h"

inherit "std/npc";
inherit "std/npc/spells";

#include "../CheckPlayer.h"

void sp_pray( object enemy, int damage, mixed dam_type);

int isProtected = 0, protectTime = 0, test = 1;
void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();

   SetProp(P_SHORT, "Fradrik, der Ordensritter");
   SetProp(P_LONG,
      "Das ist Ordensritter Fradrik. Kommandant der Krieger des Ordens " + GOTT 
      + "'s. Ein sehr kraeftig gebauter Mann von grossem Wuchs. Seine langen "
      "schwarzen Haare traegt er offen. Sein dunklen Augen strahlen Entschlossen"
      "heit aus. Sein Haltung zeugt von Stand und Macht. Er ist schwer "
      "Geruestet und Bewaffnet. Du bist Dir sicher, dass er seine Schwerter "
      "nicht zur Dekoration mit sich fuehrt. Du bist ueberzeugt, dass er jeden "
      "Frevler ohne federlesen zu Lars schicken wird."
      );
   SetProp(P_NAME, "Fradik");
   SetProp(P_GENDER, MALE);
   SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
   AddId(({"fradrik", "ritter", "ordernsritter", "oRitter", "NOWIMPY"}));
   set_living_name("fradrik");

   create_default_npc(48);
   SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
   SetProp(P_MAX_HP, 7500);
   SetProp(P_XP, QueryProp(P_XP)+100000*100); // Bonus fuer Spells
   SetProp(P_RACE, "Mensch");
   SetProp(P_SIZE, 197);
   SetProp(P_ALIGN, 2000);
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_HEAL,0);
   SetProp(P_AGGRESSIVE,0);
   SetProp(P_WIMPY, 0);
   SetProp(P_BODY, 110);
   SetProp(P_RESISTANCE_STRENGTHS , 
      ([DT_FIRE:   -0.3, DT_COLD:     -0.3, DT_WATER: -0.3, DT_AIR:    -0.3, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:   0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR:  0.0,
      DT_HOLY:     -0.3, DT_UNHOLY:   -0.3, DT_MIND:   0.0, DT_MAGIC:  -0.3 ]) );
   SetProp(P_ARTICLE, 0);

   SetProp(P_MSGIN, "schreitet pruefend herein");
   SetProp(P_MSGOUT, "schreitet #.");
   SetProp(P_MMSGIN, "erscheint");
   SetProp(P_MMSGOUT, "verschwindet");

   SetProp(P_DIE_MSG,  " stirbt heldenhaft fuer seinen Glauben.\n");
   SetProp(P_NOCORPSE, 0 );
   SetProp(P_MURDER_MSG, "Gott " + GOTT + " wird Dich fuer deinen Frevel "
      + "bestraft!");
   SetProp(P_KILL_NAME, "Ordensritter Fradrik");
   SetProp(P_KILL_MSG, "Seid gewarnt, Ihr Frevler! Gott " + GOTT + " macht mich "
      + "unbesiegbar!");
   
   SetProp(P_LOG_INFO, "xorgan/oritter.info");
   
   AddInfo(DEFAULT_INFO, ({"Bete zu " + GOTT + " und Ihr werdet erlaechtet.\n",
      "Verzeiht, aber ich bin zu beschaeftigt fuer Eure Fragen.",
      "Lasst mich in Frieden! Ich muss mich um meine Krieger kuemmern.", 
      "Trollt Euch bevor ich mich vergesse!"}),
      "erwiedert: ");
   
//   AddInfo( ({"",""}),
//      ".",
//      "sagt: ");

   SetProp(P_LOG_INFO, "npc_logfile");

   SetProp( P_REJECT, ({ REJECT_GIVE,
      "Fradrik sagt: Gebt es einen Bruder, wenn Ihr ein Opfer bringen wollt.\n"
      + "Fradrik gibt Dir @WEN zurueck.\n" }) );

   SetProp(P_NOMAGIC,20);
   SetProp(P_SPELLRATE,40);
/*
   AddSpell(1,0,
      ".\n",
      ".\n",
      DT_MAGIC,([SP_SHOW_DAMAGE:1]));
*/
   if( test == 0 )
   {
   AddSpell(25,320,
      "Fradrik schlaegt Dir den Schwertknauf von Antwort ins Gesicht.\n",
      "Fradrik schlaegt @WEN den Schwertknauf von Antwort ins Gesicht.\n",
      DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
   AddSpell(30,430,
      "Fradrik macht eine geschickte Finte und trifft Dich mit Vergelter.\n",
      "Fradrik macht eine geschickte Finte und trifft @WEN mit Vergelter.\n",
      DT_SLASH,([SP_SHOW_DAMAGE:1]));
   AddSpell(15,540, 
      "Fradrik schlaegt Dir mit einem gewaltigen Hieb beinahe die Waffe aus "
      "der Hand.\n",
      "Fradrik schlaegt @WEN mit einem gewaltigen Hieb beinahe die Waffe aus "
      "der Hand.\n",
      DT_SLASH,([SP_SHOW_DAMAGE:1]));
   AddSpell(10,650, 
      "Fradriks Schlag mit Vergelter dringt tief in Deine Ruestung ein.\n",
      "Fradriks Schlag mit Vergelter dringt tief in @WESSEN Ruestung ein.\n",
      DT_SLASH,([SP_SHOW_DAMAGE:1]));
   AddSpell(10,810,
      "Fradrik richtet ein Stossgebet an " + GOTT + ".\n",
      "Fradrik richtet ein Stossgebet an " + GOTT + ".\n",
      DT_HOLY,([SP_SHOW_DAMAGE:1]));
   }
   //Boeser Spell: Geht auf alle Angreifer und macht 800-1200 Schaden
/*
   AddSpell(5,400,
      "Fradrik bruellt: HERR! Strafe diese Frevler mit Deiner "
      + "Macht!\n\nEin eine unbegreifliche Macht dringt in Deinen Geist ein.\n",
      "Fradrik bruellt: HERR! Strafe diese Frevler mit Deiner "
      + "Macht!\n\nEin eine unbegreifliche Macht dringt in @WESSEN Geist ein.\n",
      DT_MIND,"sp_pray");
*/
   AddSpell(5,400,
      "Fradrik bruellt: HERR! Strafe diese Frevler mit Deiner Macht!\n",
      "Fradrik bruellt: HERR! Strafe diese Frevler mit Deiner Macht!\n",
      DT_MIND,"sp_pray");

   AddSpell(2,1,
      break_string( "Herr " + GOTT + "! Durchdringe mich mit Deimem Geist!\n"
         + "Erfuelle mich mit Deinem Mut und verleihe mir Deine Staerke!",
         78, "Fradrik ruft: "),
      break_string( "Herr " + GOTT + "! Durchdringe mich mit Deimem Geist!\n"
         + "Erfuelle mich mit Deinem Mut und verleihe mir Deine Staerke!",
         78, "Fradrik ruft: "),
         DT_MAGIC, "sp_protection");
      
   SetChats(5, ({
      "Fradrik spricht ein Gebet.\n",
      "Fradrik blickt ueber das Gelaende.\n",
      "Fradrik ueberprueft seine Ausruestung.\n"}) );
   SetAttackChats(10, ({
      "Fradrik brullt: Das wirst Du buesse!\n",
      "Fradrik faucht: Das ist dein Ende!\n",
      "Fradrik ruft: FUER " + UGOTT + "!\n"}) );

   SUID;
   CLONEME(WEAPON "antwverg.lpc" );
   command("zuecke schwerter");
   CLONEME(ARMOUR "kuerass.lpc" );
   CLONEME(ARMOUR "bumhang.lpc" );
   command("trage alles");
   
}


int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
   
   if( enemy->QueryProp(P_LEVEL)<30 && !CheckPlayer( TP->name( RAW )))
   {
      tell_room( ENV(enemy), BS( "Fradrik pariert " + enemy->name(WESSEN) 
         + " plumpen Angriff souveraen und schlaegt " + enemy->name(WEN) 
         + " mit dem Schertknauf ins Gesicht.\n") 
         + "Fradrik bruellt: VERSCHWINDE DU WURM, SONST STAMPFE ICH DICH IN DEN "
         + "BODEN!\n", ({ enemy }) );
      tell_object( enemy, BS( "Fradrik pariert Deinen plumpen Angriff "
         + "souveraen und schlaegt Dir mit dem Schertknauf ins Gesicht.\n")
         + "Fradrik bruellt: VERSCHWINDE DU WURM, SONST STAMPFE ICH DICH IN DEN "
         "BODEN!\n");
      
      SetProp( P_KILL_MSG, "Unverfrorenheit wird immer mit dem Tod bestraft!");
      enemy->do_damage( 35 );
      enemy->StopHuntFor( ME );
      StopHuntFor( enemy );
      SetProp(P_KILL_MSG, "Seid gewarnt, Ihr Frevler! Gott " + GOTT + " macht "
         + "mich unbesiegbar!");
      
      SetPlayer( TP->name( RAW ), 1 );
      
      dam = 0;
   }
   
   if( protectTime >= 0)
   {
      if( --protectTime == 0 ) 
      {
         tell_room(ENV(enemy), "Fradriks leuchtende Aura erlischt.\n");
         SetProp(P_BODY, 110);
         SetProp(P_RESISTANCE_STRENGTHS , 
            ([DT_FIRE:    -0.3, DT_COLD:      -0.3, DT_WATER:  -0.3, DT_AIR:    -0.3, 
            DT_LIGHTNING:  0.0, DT_EXPLOSION:  0.0, DT_SOUND:   0.0, DT_LIGHT:   0.0,
            DT_ELECTRIC:   0.0, DT_ACID:       0.0, DT_POISON:  0.0, DT_TERROR:  0.0,
            DT_HOLY:      -0.3, DT_UNHOLY:    -0.3, DT_MIND:    0.0, DT_MAGIC:  -0.3 ]) );
         SetProp(P_NOMAGIC,20);
      }
   }
   
   return ::Defend(dam, dam_type, spell, enemy);
}


void sp_pray( object enemy, int damage, mixed dam_type )
{
   object *all;
   int i;
   
   all = all_inventory( ENV(TO));
   
   SetProp(P_NAME, "Eine unbegreifliche Macht");
   for( i = 0; i < sizeof( all ); i++)
   {
      if( IsEnemy( all[i] ))
      {
         tell_object( all[i],"Ein eine unbegreifliche Macht dringt in "
            + "Deinen Geist ein.\n");
         all[i]->Defend( 800 + damage, dam_type, 0, TO);
      }
   }
   SetProp(P_NAME, "Fradik");
}

void sp_protection( object enemy, int damage, mixed dam_type )
{
   if( !isProtected )
   {
      SetProp(P_NOMAGIC,50);
      SetProp(P_BODY, 200);
      SetProp(P_RESISTANCE_STRENGTHS , 
         ([DT_FIRE:   -0.8, DT_COLD:     -0.8, DT_WATER: -0.8, DT_AIR:   -0.8, 
         DT_LIGHTNING:-0.5, DT_EXPLOSION:-0.5, DT_SOUND: -0.5, DT_LIGHT: -0.5,
         DT_ELECTRIC: -0.5, DT_ACID:     -0.5, DT_POISON:-0.5, DT_TERROR:-0.5,
         DT_HOLY:     -0.8, DT_UNHOLY:   -0.8, DT_MIND:  -0.5, DT_MAGIC: -0.8 ]) );
      protectTime = 20;
      tell_room( ENV( TO ), "Fradrik wird von einem mystischen Leuchten "
         + "eingehuellt.\n", ({ TO }));
      
   }
   else
   {
      protectTime += 15;
   }
}

void die(int poisondeath) 
{
   write_file( MYLOG + "oritter.kills",
      ctime()+": "+CAP(getuid(PL))+" killt Fradrik.\n");
   ::die(poisondeath);
}

void NotifyPlayerDeath( object player, object killer, int lostexp) 
{ 
   if(killer == ME) 
      write_file(LOG "npc.deads", ctime()+": Fradrik hat gerade "
         + CAP(getuid(player))+" umgebracht.\n");
}

//   int _query_wimpy() { return 0; }

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
   if( find_call_out("reaction") != -1) 
      return;
   
   switch( gruppe ) 
   {
      case "aengstlich":
         call_out("reaction", 0, TP, 
            "spricht: Keine Angst. Wenn Du die Regeln einhaeltst geschieht Dir "
            + "nichts.",
            "troestet " + TP->name(WEN) + ".");
         break;
      case "aergerlich":
         if( random( 5 ))
            call_out("angriff",0," schreit: ZIEHT BLANK UND VERTEIDIGT EUCH!!!\n");
         else
            call_out("reaction", 0, TP,
               "erwieder: Lasst das, " + TP->name( RAW ) + ", oder Ihr werden "
               + "meine Stahl spueren!",
               "erwieder: Lasst das, " + TP->name( RAW ) + ", oder Ihr werden "
               + "meine Stahl spueren!");
         break;
      case "albern":
         call_out("reaction", 0, TP,
            "sieht Dich boese an.",
            "sieht " + TP->name( RAW )) + " boese an.";
         break;
      case "fies":
         if( CheckPlayer( TP->name( RAW )))
            call_out("angriff",0," bruellt: GENUG!!! STIRB, FREVLER!!!\n");
         else
         {
            call_out("reaction", 0, TP,
               "erwiedert veraergert: Verschindet, bevor ich mich vergesse!",
               "erwiedert veraergert: Verschindet, bevor ich mich vergesse!");
            SetPlayer( TP->name( RAW ), 1 );
         }
         break;
      case "frech":
         if( touch )
         {
            if( CheckPlayer( TP->name( RAW )))
               call_out("angriff",0," bruellt: GENUG!!! STIRB, FREVLER!!!\n");
            else
            {
               call_out("reaction", 0, TP,
                  "faucht: Ihr wagt es mich zu beleidigen!! Noch einmal und Ihr "
                  + "seid des Todes!",
                  "faucht: Ihr wagt es mich zu beleidigen!! Noch einmal und Ihr "
                  + "seid des Todes!");
               SetPlayer( TP->name( RAW ), 1 );
            }
         }
         else
         {
            call_out("reaction", 0, TP,
               verb + "t Dich auch.",
               verb + "t " + TP->name( WEN ) + " ebenfalls.");
         }
         break;
      case "froh":
         call_out("reaction", 0, TP,
            "grinst Dich erfreut an.", 
            "grinst " + TP->name( WEN ) + " erfreut an.");
         break;
      case "intim":
         if( TP->QueryProp( P_GENDER ) == FEMALE )
         {
            if( CheckPlayer( TP->name( RAW )))
            {
               call_out("reaction", 0, TP,
                  "wendet sich von Dir ab.",
                  "wendet sich von " + TP->name( WEM ) + " ab.");
               ResetPlayer( TP->name( RAW ), 1 );
            }
            else
            {
               switch( random( 5 ))
               {
                  case 0:
                     call_out("reaction", 0, TP,
                        "scheint von Dir angetan zu sein.",
                        "scheint sich zu " + TP->name( WEN ) + " hingezogen zu "
                        + "fuehlen!");
                     break;
                  case 1:
                     call_out("reaction", 0, TP,
                        "schmiegt sich an Dich.",
                        "schmiegt sich an " + TP->name( WEN ) + ".");
                     break;
                  case 2:
                     call_out("reaction", 0, TP,
                        "fluestert verliebt: Wollen wir uns spaeter treffen?",
                        "fluestert mit leuchtenden Augen" + TP->name( WEN ) 
                        + " etwas zu.");
                     break;
                  case 3:
                     call_out("reaction", 0, TP,
                        "kuesst Dich innig.",
                        "kuesst " + TP->name( WEN ) + " innig.");
                     break;
                  case 4:
                     call_out("reaction", 0, TP,
                        "laesst sich von Dir nicht beeindrucken.",
                        "wendet sich ab.");
                     break;
               }
            }
         }
         else
         {
            if( CheckPlayer( TP->name( RAW )))
               call_out("angriff",0," bruellt: GENUG!!! STIRB, FREVLER!!!\n");
            else
            {
               call_out("reaction", 0, TP,
                  "faucht: Ihr wagt es! Versucht das nicht nochmal!",
                  "faucht: Ihr wagt es! Versucht das nicht nochmal!");
               SetPlayer( TP->name( RAW ), 1 );
            }
         }
         break;
      case "nett":
         call_out("reaction", 0, TP,
            verb + "t Dich auch.",
            verb + "t " + TP->name( WEN ) + " ebenfalls.");
         break;
      case "neutral":
         call_out("reaction", 0, TP,
            "schaut Dich ernst an.",
            "schaut " + TP->name( WEN ) + " ernst an.");
         break;
      case "traurig":
         call_out("reaction", 0, TP,
            "troestet Dich.",
            "troestet " + TP->name( WEN ) + "." );
         break;
   }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
   return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
   if( present(ob, ENV(TO))) 
   {
      tell_object( ob, "Fradrik " + macher + "\n");
      tell_room( ENV( TO ), "Fradrik " + andere + "\n", ({ ob }));
   }
}

void angriff(string text)
{
   if( present( TP, ENV(TO)) ) 
   {
      tell_room( ENV(TO), Name(WER, 1) + text );
      Kill( TP );
   }
}
