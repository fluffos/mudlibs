// 
// 1999-06-26

#include "../def.h"

inherit "std/room";

create()
{
   ::create();

   SetProp( P_INT_SHORT, "In der Mitte des Kreuzgangs" );
   SetProp( P_INT_LONG,
      "Du befindest Dich in der Mitte des Kreuzganges. Vor Dir erhebt sich "
      "in mitten von Blumenbeeten auf einem Sockel stehend ein grosse Statue, "
      "Sowohl die Statue als auch der Sockel bestehen aus kostbarem weissen "
      "Marmor. Rund um die Statue fuehrt ein mit weissem Kliesel bestreuter "
      "Weg herum. Sternfoermig laufen Weg, die ebenfalls mit diesem weissem "
      "Kiesel bestreut sind, in alle Richtungen zu den Boegen des Kreuzganges "
      "hin. Dazwischen sind dreieckige Gruenflaechen angelegt. Im " 
      + RG1 + " kannst Du einen offnen Torbogen, der aus dem Kreuzgang heraus "
      "fuehrt, sehen. Im " + RG3 + ", im " + RG5 + " und im " + RG7 + " kannst "
      " Du Tueren, die in das Gebaeude fuehren erkennen. "
      "Diese Anlage macht einen ausgesprochen gepflegten Eindruck." );
   
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_TOWN]) );

   AddDetail( ({ "mitte" }),
      "Nun! Ganz einfach! Da es sich um einen quadratischen Kreuzgang handelt "
      "und sich die gedachten Diagonalen der Ecken des Gebaeudes hier kreuzen, "
      "musst Du Dich in der Mitte des Kreuzganges befinden." );

   AddDetail( ({ "diagonalen", "diagonale" }),
      "Die GEDACHTEN Diagonalen!");

   AddDetail( ({ "kreuzgang" }),
      "Der sogenannte Kreuzgang ist der Innenhof des Hauptgebaeudes eines "
      "Klosters.");

   AddDetail( ({ "innenhof", "hof", "platz" }),
      "Um diesen quadratischen Innenhof gruppieren sich die wichtigsten Bereiche "
      "des Klosters. Der Platz wird von einer grossen auf einem Sockel stehenden "
      "Statue beherrscht. Von dieser Statue fuehren Wege sternfoermig in alle "
      "Himmelsrichtungen weg. Dazwischen sind dreieckige Gruenflaechen angelegt. "
      "Dieser Hof ist von einem ueberdachten Saeulengang "
      "eingefasst.");

   AddDetail( ({ "statue" }),
      "Diese Statue besteht, wie auch der Sockel auf dem sie steht, aus kostbarem "
      "weissen Marmor. Sie ist etwar 3 Meter hoch und stellt einen stehenden "
      "aelteren Mann, der in eine weite bestickte Robe gehuellt ist, darstellt. "
      "In seiner Linken haelt er einen aufgeschlagen Folianten, waehrend seine "
      "rechte Hand fuer eine rituelle Handlung mit leicht gespreizten Fingern "
      "halb ausgestreckt ist. Sein Blick ist konzentriert, dennoch irgendwie "
      "gelassen und scheint ueber das Buch hinweg nach vorne zu gehen. ");

   AddDetail( ({ "sockel" }),
      "Der ist nicht wirklich interessant. ");

   AddDetail( ({ "foliant" }),
      "Ein grosses dickes Buch.");

   AddDetail( ({ "Buch" }),
      "Das Buch muss wohl Wissen oder Weisheit repraesentieren.");

   AddDetail( ({ "Mann" }),
      "Es handelt sich ohne Zweifel um den Gott " + GOTT + ", der hier verehrt "
      "wird.");

   AddDetail( ({ "hand", "handlung", "finger" }),
      "Die rechte Hand ist wohl mit den leicht gespreizten Fingern fuer eine "
      "rituelle Handlung halb ausgestreckt. Moeglicherweise handelt es sich "
      "um ein Beschwoerung und soll sicher Macht und Staerke repraesentieren.");

   AddDetail( ({ "beschwoerung" }),
      "Sicher bist Du Dir nicht, aber so was aehnliches wirds schon sein.");

   AddDetail( ({ "" }),
      " ");

/*
   AddDetail( ({ "" }),
      " ");

*/
   AddReadDetail( ({ "text" }),
      "test");

   AddSound( DEFAULT_SOUND,
      "Du hoerst leises Murmeln das wohl von den Moenchen des Klosters stammt.");

   AddSound( ({ "murmeln", "geraeusch" }),
      "Es handelt sich sicher um Gebete an ihren Gott " + GOTT + ".");

   AddSound( ({ "gebete", "gebet" }),
      "Waehrend die Moenche den Kreuzgang entlanglaufen scheinen sie zu " + GOTT 
      + "zu beten.");

   AddSound( ({ "moenche", "moench" }),
      "Abgesehn von den Schritten kannst Du sie beten leise hoeren.");

   AddSound( ({ "schritte", "tapp" }),
      "TAPP.....TAPP.....TAPP");

   AddSound( ({ "kreuzgang" }),
      "Der macht sicher kein Geraeusch.");
/*
   AddSmell( DEFAULT_SMELL,
      "");

   AddSmell( ({ "" }),
      "");
*/
//   AddRoomMessage( 
//      ({""}),30,"func");

//   AddCmd( ({ "tue" }), "command" );

//   AddItem( "item" , REFRESH_DESTRUCT);

   AddExit( RK1, "./main_d3" );
   AddExit( RK2, "./main_d4" );
   AddExit( RK3, "./main_c4" );
   AddExit( RK4, "./main_b4" );
   AddExit( RK5, "./main_b3" );
   AddExit( RK6, "./main_b2" );
   AddExit( RK7, "./main_c2" );
   AddExit( RK8, "./main_d2" );
}

command(string str )
{
   notify_fail( "Was willst Du tun?\n" );
   if( str == "tuer" )
   {
      write("Du tust etwas.\n");
      say( TPN +" tut etwas.\n");
      return 1;
   }
   return 0;
}
