// Xorgan@SilberLand
// Kuerass
// 2000-04-24

#include "../def.h"

inherit "std/armour";

create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT, "Eine Gestechskuerass");
   SetProp(P_LONG,
      "Dieser aus bestem zwergischen Stahl gefertigte Panzer wird eigentlich "
      "bei der Tjoste, dem Lanzengang, der ritterlichsten Form des Kampfes, "
      "getragen. Seine unglaubliche Materialstaerke bietet dank seiner "
      "Schulterfortsaetze nicht nur fuer die Brust und den Ruecken, sondern "
      "auch fuer Schulter und Hals den absolut groessten Schutz und laesst "
      "selbst Bogen- und Armbrustschuetzen angesichts der Unwirksamkeit der "
      "Geschosse, die einfach abprallen, erbleichen. Unter diesem ansich schon "
      "gewaltigen Panzer wird ein leichtes Kettenhemd, das den oberen Teile "
      "der Arme und Schenkel schuetzt, getragen, womit abgesehen vom Kopf alle "
      "lebenswichtigen Koerperteile bestens geschuetzt sind."
      );
   SetProp(P_NAME, "Gestechskuerass");
   SetProp(P_GENDER, MALE);
   AddId( ({"kuerass", "gestehskuerass"}));
   
   AddDetail( ({"materialstaerke", "staerke" }), 
      "Diese Panzerung ist unglaublich dick und auch dementsprechend schwer."
      );
   AddDetail( ({"schulterfortsaetze", "schulterfortsatz", "fortsatz", 
      "fortsaetze" }), 
      "Diese Fortsaetze in Form eines Dreieckes, die von der Schulter Richtung "
      "Hals hoeher werden, lenken Schlaege die von der Seite gegen den Hals "
      "gefuert werden nach oben ab. Ebenso sind sie auch bei Schlaegen, die von "
      "oben gegen die die Schulter gefuehrt werden, wirksam, da diese nach "
      "Aussen abgelenkt werden. Sie sind so befestigt, dass moeglichst kein "
      "Platz zwischen dem Helm bleibt, ohne dabei die Bewegungsfreiheit "
      "einzuschraenken."
       );
   AddDetail( ({"kettenhemd", "hemd" }), 
      "Unter diesem Panzer wird ein leichtes, halblanges Kettenhemd getragen. "
      "Es verstaerkt die Brustpanzerung und schuetzt die Oberarme und "
      "Oberschenkel."
      );
   AddDetail( ({"bogenschuetzen", "amrbrustschuetzen", "schuetzen" }), 
      "Die sollten besser ihr Heil in der Flucht suchen."
      );
   
   SetProp(P_AC, 40);
   SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
   SetProp(P_MATERIAL, MAT_STEEL );
   SetProp(P_WEIGHT, 5000);
   SetProp(P_VALUE, 8000);
   SetProp(P_NOBUY, 0);
   
   SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL:40,A_STR:24]) );
   
}
