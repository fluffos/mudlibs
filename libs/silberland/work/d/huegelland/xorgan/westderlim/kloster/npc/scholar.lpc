// Xorgan@SilberLand
// Beweglicher Scholar
// 1999-12-31

#include "../def.h"

inherit "std/mnpc";

#include <mnpc.h>

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   int lev,ras,len;
   string *adj, *race;
   adj=({"unerfahren","durchschnittlich","erfahren"});
   race=({"Mensch","Zwerg","Hobbit","Elf"});
   
   lev = random( 3 );
   ras = random( 4 );
   
   switch( ras )
   {
      case 1:
         len = 100;
      case 2:
         len = 80;
      case 3:
         len = 160;
      default:
         len = 140;
   }
   
   SetProp(P_NAME, "Scholar");
   SetProp(P_NAME_ADJ, adj[lev]);
   AddAdjective( ({ adj[lev],adj[lev]+"er",adj[lev]+"en" }) );
   SetProp(P_SHORT, "Ein "+adj[lev]+"er Scholar");
   
   SetProp(P_LONG,
      "Ein jungendlicher Schueler, der wohl noch einge Jahre Unterweisung vor "
      "sich hat, bevor er zum Adept ernannt wird.");
   
   SetProp(P_GENDER, MALE);
   SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
   AddId(({"scholar"}));
   
   create_default_npc(13 + lev);
   SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
   SetProp(P_RACE, race[ras]);
   SetProp(P_SIZE, len + random(15));
   SetProp(P_ALIGN, random( 201 ) + 800);
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_HEAL,0);
   SetProp(P_AGGRESSIVE,0);
   SetProp(P_WIMPY, QueryProp( P_HP ) / 2);
   SetProp(P_RESISTANCE_STRENGTHS , 
      ([DT_FIRE:    0.0, DT_COLD:      0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:     -0.2, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
   
   SetProp(P_NOMAGIC,0);
   
   SetProp(P_MSGIN, "kommt an");
   SetProp(P_MSGOUT, "geht#");
   SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
   SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
   SetProp(P_MNPC_AREA, ({ ROOM + "room_c", ROOM + "room_d" }) );
   SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
   SetProp(P_MNPC_DEFAULTROOM, ROOM "room_d3");
   SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);


   SetProp(P_DIE_MSG,  " tritt vor seinen Gott.\n");
   SetProp(P_NOCORPSE, 0 );

   SetProp(P_LOG_INFO, "xorgan/scholar.info");
   
   AddInfo(DEFAULT_INFO, "sagt: Last mich in Ruhe arbeiten!\n");

   SetProp( P_REJECT, ({ REJECT_DROP,
      "Der Scholar entgegnet: Danke! Ich habe was ich brauche!.\n" }) );

   SetChats( 2, ({
      "Der Scholar jaetet Unkraut.\n",
      "Der Scholar glaettet den Weg.\n",
      "Der Scholar zitiert ein Gebet.\n",
      "Der Scholar stoehnt erschoepft.\n",
      "Der Scholar wischt sich den Schweiss von der Stirn.\n"}) );
      
   SetAttackChats(10, ({
      "Der Scholar ruft: HILFE!!! Ich werde von einem Unglaeubigen angegriffen!!!\n",
      "Der Scholar ruft nach den Ordenskriegern!\n",
      "Der Scholar sagt: Bald wird mir ein Ordenskrieger helfen und dann gehts Dir schlecht.\n",
      }) );

   SUID;
   CLONEME(ARMOUR + "kutte1.lpc" );
   command("trage alles");
}

