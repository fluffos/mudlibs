// 
// 1999-06-26

#include "../def.h"

inherit "std/room";

create()
{
   ::create();

   SetProp( P_INT_SHORT, "Die Bibliothek des Klosters" );
   SetProp( P_INT_LONG,
      "Du befindest Dich in der legendaeren Bibliothek des Klosters der " 
      + GLAUBE + ". Der grosse Raum in dem Du Dich befindest  ist voll mit "
      "Regalen in denen hunderte von verstaubten Buechern, Manuskripte, "
      "Schriftrollen und Pergamente gelagert werden. Zwischen den Regalen "
      "kannst Du einige Lesepulte sehen, auf denen Buecher, von denen einige "
      "aufgeschlagen sind, abgelegt wurden. Hier scheint es keine Ordnung und "
      "kein System zu geben, oder anders hier herrscht das absolute Chaos. "
      "Bruder Orlan der Bibliothekar ist wohl der einzige der hier ein Werk "
      "finden kann. "
      "Es soll sich um eine der groessten, wenn nicht um die groesste, "
      "Bibliotheken im ganzen Silberland handeln, doch irgendwie hast Du sie "
      "Dir viel Groesser vorgestellt." );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 1 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

   AddDetail( ({ "" }),
      "");

   AddReadDetail( ({ "" }),
      "");

   AddSound( DEFAULT_SOUND,
      "");

   AddSound( ({ "" }),
      "");

   AddSmell( DEFAULT_SMELL,
      "");

   AddSmell( ({ "" }),
      "");

   AddRoomMessage( 
      ({""}),30,"func");

   AddCmd( ({ "tue" }), "command" );

   AddItem( "item" , REFRESH_DESTRUCT);

   AddExit( "norden", "nach Norden#" + "./room2" );
}

command(string str )
{
   notify_fail( "Was willst Du tun?\n" );
   if( str == "tuer" )
   {
      write("Du tust etwas.\n");
      say( TPN+" tut etwas.\n");
      return 1;
   }
   return 0;
}
