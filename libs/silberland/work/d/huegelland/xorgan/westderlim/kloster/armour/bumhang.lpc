// Xorgan@SilberLand
// Brokatumhang
// 2000-04-24

#include "../def.h"

inherit "std/armour";

create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT, "Ein Borkatumhang");
   SetProp(P_LONG,
      "Dieser purpurfarbene Umhang, gefertigt aus edlem Brokat ist an "
      "Schoenheit und Prunk wohl kaum zu uebertreffen. In die Mitte ist ein "
      "Wappen gestickt. Der Saum ist mit Goldfaeden genaeht."
      );

   AddDetail( ({"brokat" }), 
      "Ein sehr dicke und wiederstandsfaehige, fein und mehrlagig gewebte "
      "edle Stoffart, die abgesehen der Schoenheit und dem  Nachteiles des "
      "grossen Gewichtes noch weitere positive Eigenschaften aufweist. Seine "
      "feine Struktur erfreut nicht nur das Auge, sondern macht ihn auch "
      "Wasserabweisend. Die Dicke und Struktur des Materials erweisen sich als "
      "weitgehend Schnittfest, womit dieser Stoff sich hervorragend zum Schutz "
      "eignet."
      );
   
   AddDetail( ({"brokat" }), 
      "Ein blauer Wassertropfen in einem goldenen Ring auf dem purpurem "
      "Grund. Mit Sicherheit das Wappen der " + GLAUBE + "." );
   
   SetProp(P_NAME, "Brokatumhang");
   SetProp(P_GENDER, MALE);
   AddId( ({"umhang", "brokatumhang"}));
   
   SetProp(P_AC, 10);
   SetProp(P_ARMOUR_TYPE, AT_CLOAK);
   SetProp(P_MATERIAL, ([MAT_CLOTH:98, MAT_GOLD:2]) );
   SetProp(P_WEIGHT, 1500);
   SetProp(P_VALUE, 2000);
   SetProp(P_NOBUY, 0);
   
   SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL:40,A_STR:10]) );
}
