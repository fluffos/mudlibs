// Xorgan@SilberLand
// Koehlermeister 
// 1999-07-14

#include "../def.h"

inherit "std/mnpc";

#include <mnpc.h>

void create() 
{
   if(!is_clone(TO)) 
      return;

   ::create();

   SetProp(P_SHORT, "Der Meister der Koehler");
   SetProp(P_LONG,
      "Der Koehlermeister ist ein Mann im besten Alter. Trotz seiner geringen "
      "Groesse verleiht ihm sein mit Muskeln bepackter Oberkoerper ein "
      "eindrucksvolles Aussehen. Die schwere Arbeit in der Koehlerie macht sich "
      "durch Muskeln bemerkbar. Er blickt etwas grimmig drein und bruellt "
      "staendig irgendwelche Anweisungen quer durch das Lager. "
      "Er scheint mit der Leitung der Koehlerei sehr beschaeftigt zu sein. "
      );
   SetProp(P_NAME, "Koehlermeister");
   SetProp(P_GENDER, MALE);
   SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
   AddId(({"koehlermeister", "meister"}));
   set_living_name("koehlermeister");

   create_default_npc(34);
   SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
   SetProp(P_RACE, "Mensch");
   SetProp(P_SIZE, 168);
   SetProp(P_ALIGN, -100);
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_HEAL,0);
   SetProp(P_AGGRESSIVE,0);
   SetProp(P_WIMPY, 0);
   SetProp(P_RESISTANCE_STRENGTHS , 
      ([DT_FIRE:   -0.3, DT_COLD:      0.2, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
   
   SetProp(P_NOMAGIC,0);

   SetProp(P_MSGIN, "kommt an und schaut sich um");
   SetProp(P_MSGOUT, "geht pruefend weiter");
   SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
   SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
   SetProp(P_MNPC_AREA, ({ ROOM + "room_c", ROOM + "room_d" }) );
   SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
   SetProp(P_MNPC_DEFAULTROOM, ROOM "room_c3");
   SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

   SetProp(P_DIE_MSG,  " wird nie wieder Kohle herstellen.\n");
   SetProp(P_NOCORPSE, 0 );
   SetProp(P_KILL_MSG, "Jetzt kann ich in Ruhe weiterarbeiten!");

   SetProp(P_LOG_INFO, "xorgan/meister.info");
   
   AddInfo(DEFAULT_INFO, "sagt: Halt mich nicht damit auf! Davon weiss ich "
      "nichts!\n");

   AddInfo( ({"koehlerei"}),
      "Ja. Das ist meine Koehlerei. Ich kann mit stolz sagen, dass meine "
      "Koehlerei die einzige im ganzen Silberland ist. Meine Arbeiter und ich "
      "stellen die ganze Holzkohle her.",
      "sagt stolz: ");

   AddInfo( ({"silberland", "land"}),
      "Du wirst doch sicher wissen wo Du Dich befindest!",
      "antwortet: ");

   AddInfo( ({"arbeiter"}),
      "Bei mir arbeiten einige Gesellen und einen Lehrling bilde ich auch aus. "
      "Ich hab so viele Auftraege. Ich koennte noch ein paar Gesellen brauchen.",
      "sagt: ");

   AddInfo( ({"auftaege","auftrag"}),
      "Aus dem ganzen Silberland bekomme ich Auftraege.",
      "sagt: ");

   AddInfo( ({"lehrling"}),
      "Welche Muehe hab ich mir geben, um aus ihm einen richtig guten "
      "Koehlergesellen zu machen. Aber er kann sich einfach nicht merken, wie "
      "man einen Meiler richtig baut.",
      "stoehnt: ");

   AddInfo( ({"geselle","gesellen", "koehlergesellen", "koehlergeselle"}),
      "Ohne meine Gesellen koennte ich die Unmengen von Kohle ja gar nicht "
      "herstellen. Ich koennte sofort nochmal so viele einstellen, nur ich "
      "bin der einzige der Gesellen "
      "ausbildet.",
      "sagt: ");

   AddInfo( ({"unmengen","unmenge"}),
      "Wir stellen wirklich viel Kohle her.",
      "sagt: ");

   AddInfo( ({"kohle","holzkohle"}),
      "Ja. Holzkohle stellen wir her. Dazu muss man einen Meiler bauen, ihn "
      "wenn er fertig ist anzuenden und natuerlich Brandwache halten.",
      "sagt: ");

   AddInfo( ({"brandwache","wache"}),
      "Naja. Man muss den brennenden Meiler schon bewachen und ueberpruefen, "
      "damit der Wald nicht Feuer faengt.",
      "sagt: ");

   AddInfo( ({"meiler"}),
      "Es ist einerseits Kunst andererseits schwere Arbeit einen Meiler zu "
      "errichten. Das Holz muss sauber aufgeschichtet und gut mit Erde "
      "zugeschuettet werden, damit er zwar brennt, aber keine Luft bekommt. "
      "Ja, glimmen muss ein Meiler, unter grosser Hitze, aber er darf keine "
      "Flammen schlagen!",
      "schwaermt: ");

   AddInfo( ({"kunst"}),
      "Sorgsam muss man die Scheiter schlichten, so dass wenig Platz dazwischen "
      "bleibt. Die Zwischenraeume werden mit Zunder gefuellt, damit er besser "
      "brennt. Du musst wissen, dass das Holz beim Verbrennen nachgeht und "
      "wenn man nicht gewissenhaft gearbeitet hat fallt der Meiler um oder "
      "bekommt einen Riss in seinen Mantel und damit ist die Kohle zerstoert!",
      "sagt: ");

   AddInfo( ({"platz","zwischenraum","zwischenraeume"}),
      "Es sollte moeglichst kein Platz zwischen den Scheitern frei bleiben. In "
      "den unteren Zwischenraeumen kommt der Zunder hinein, damit man ihn "
      "leichter anzuenden kann.",
      "sagt: ");

   AddInfo( ({"arbeit"}),
      "Bist Du nicht auch der Meinung, dass Holzfaellen und Scheitermachen "
      "als schwere Arbeit ist? Wir tragen das Holz zu den Meilern und spaeter "
      "die Kohle ins Lager. Das ist auch kein Honigschlecken!",
      "sagt: ");

   AddInfo( ({"zunder"}),
      "Naja. Kleine Zweige, trockenes Gras und Laub.",
      "sagt: ");

   AddInfo( ({"zweige","gras", "laub"}),
      "Das verwendet man als Zunder.",
      "sagt: ");

   AddInfo( ({"holz","scheiter"}),
      "Wir sind ja im Wald. Da gibts ja genug Baeume und mit dem richtigen "
      "Werkzeug ist das Faellen und Zerkleinern der Baeume auch kein Problem.",
      "sagt: ");

   AddInfo( ({"faellen","zerkleinern"}),
      "Einen Baum muss man schon faellen und im Stueck koennen wir ihn auch "
      "nicht gebrauchen.",
      "sagt: ");

   AddInfo( ({"stueck"}),
      "Der Baum muss schon in Scheiter zerkleinert werden.",
      "sagt: ");

   AddInfo( ({"werkzeug","koehleraxt", "axt","saege"}),
      "Mit einer Koehleraxt und einer Saege kannst Du diese Arbeit schon "
      "machen.",
      "sagt: ");

   AddInfo( ({"mantel","erde"}),
      "Wir schaufeln den Meiler mit Erde zu, damit das Feuer keine Luft mehr "
      "bekommt.",
      "sagt: ");

   AddInfo( ({"holzfaellen","scheitermachen"}),
      "Mach das mal den ganzen Tag, von Sonnenaufgang bis Sonnenuntergang!",
      "sagt: ");

   AddInfo( ({"luft"}),
      "Luft darf der Meiler keine bekommen, aber der Rauch muss schon raus "
      "koennen.",
      "sagt: ");

   AddInfo( ({"rauch"}),
      "Damit der Rauch raus kann und das Feuer nicht erstickt, stechen wir "
      "ein paar Loecher in den Meiler.",
      "sagt: ");

   AddInfo( ({"loecher","koehlerschaufel","schaufel"}),
      "Ja. Oben am Meiler stechen wir mit der Koehlerschaufel einige Loecher "
      "in den Meiler. Fuer was glaubst denn Du ist eine Metallhuelse am Stiel "
      "der Schaufel befestigt?",
      "sagt: ");

   AddInfo( ({"stiel","huelse","metallhuelse"}),
      "Am oberen Ende des Stieles der Koehlerschaufel ist ein Metallhuelse "
      "angebracht. Die verhindert, dass der Stiel verbrennt. Damit stechen "
      "wir Loecher in den Meiler, damit der Rauch entweichen kann.",
      "sagt: ");

   AddInfo( ({"hitze","feuer"}),
      "Ein gut gemachter brennender Meiler ist wirklich sehr heiss.",
      "sagt: ");

   AddInfo( ({"flammen"}),
      "Keine Flammen! Das sagte ich doch schon.",
      "sagt: ");

   AddInfo( ({"wald"}),
      "Wir sind mitten drinn. Warum wird das wohl so sein? Ganz einfach: "
      "Damit wir das Holz nicht so weit tragen muessen.",
      "sagt: ");

   AddInfo( ({"baum","baeume"}),
      "Man kann nicht aus jedem Baum Holzkohle machen! Nur Laubbaeume eignen "
      "sich dafuer. Besonders gut sind Eichen und Buchen.",
      "sagt: ");

   AddInfo( ({"laubbaeume","laubbaum"}),
      "Das sind die mit den Blaettern.",
      "sagt: ");

   AddInfo( ({"eiche","eichen","buche","buchen"}),
      "Die eignen sich besonders gut fuer die Koehlerei.",
      "sagt: ");

/*
   AddInfo( ({"",""}),
      ".",
      "sagt: ");

*/

   SetProp( P_REJECT, ({ REJECT_DROP,
      "Der Koehlermeister sagt: Was soll ich damit!\n" }) );

   SetProp(P_SPELLRATE,25);
   AddSpell(50,300,
      "Der Koehlermeister rammt Dir den Stiel der Axt in die Magengrube.\n",
      "Der Koehlermeister rammt @WEN den Stiel der Axt in die Magengrube.\n",
      DT_PIERCE,([SP_SHOW_DAMAGE:1]));
   AddSpell(40,400,
      "Der Koehlermeister schlaegt Dir mit der Axt ins Gesicht.\n",
      "Der Koehlermeister schlagt @WEN die Axt ins Gesicht.\n",
      DT_SLASH,([SP_SHOW_DAMAGE:1]));
   AddSpell(10,600,
      "Der Koehlermeister beschwoert die Macht der Goetter auf Dich herab.\n",
      "Der Koehlermeister beschwoert die Macht der Goetter auf @WEN herab.\n",
      DT_MAGIC,([SP_SHOW_DAMAGE:1]));

   SetChats( 2, ({
      "Der Koehlermeister bruellt: SCHNELLER!!!\n",
      "Der Koehlermeister schreit: Wir haben nicht den ganzen Tag Zeit!!!\n",
      "Der Koehlermeister laeuft unruhig auf und ab.\n",
      "Der Koehlermeister fuchtelt wuetend mit seiner Axt in der Luft herum.\n",
      break_string( "Wird der Meiler noch vor der naechsten Eiszeit fertig!!!!\n",
         78, "Der Koehlermeister bruellt: "),
      break_string( "Diese Liefertermine, wie soll ich die bloss einhalten.\n",
         78, "Der Koehlermeister murmelt: ")
      }) );
   SetAttackChats(10, ({
      "Der Koehlermeister bruellt: Dir Wurm werd ich das Fuerchten lernen!\n",
      "Der Koehlermeister schaeumt vor Wut!\n",
      "Der Koehlermeister schreit: Lauf solange Du noch kannst!!\n"}) );

   SUID;
   CLONEME( WEAPON + "kaxt" );
   command("zuecke axt");
   CLONEME(ARMOUR + "arbhose.lpc" );
   CLONEME(ARMOUR + "arbjacke.lpc" );
   CLONEME(ARMOUR + "halstuch.lpc" );
   CLONEME(ARMOUR + "filzhut.lpc" );
   command("trage alles");
   present( "koehleraxt", TO )->RemoveId( "!Koehler");
   present( "koehleraxt", TO )->RemoveId( "koehler_axt");
   
}

