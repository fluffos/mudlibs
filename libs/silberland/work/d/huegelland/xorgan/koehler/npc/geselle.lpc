// Xorgan@SilberLand
// Koehlergeselle
// 1999-06-26

#include "../def.h"

inherit "std/npc";

void create() 
{
   int x,i;
   string *adj;
   
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   adj=({"unerfahren","durchschnittlich","erfahren"});
   
   x = random( 7 ) + 20;
   
   if( x < 23 )
      i = 0;
   else
   {
      if( x < 25 )
         i = 1;
      else
         i = 2;
   }
   
   SetProp(P_NAME, "Geselle");
   SetProp(P_NAME_ADJ, adj[i]);
   AddAdjective( ({ adj[i],adj[i]+"er",adj[i]+"en" }) );
   SetProp(P_SHORT, "Ein "+adj[i]+"er Koehlergeselle");
   
   SetProp(P_LONG,
      "Der Koehlergeselle scheint ein arbeitsamer Mensch zu sein. Den ganzen "
      "Tag schlichtet er Scheiter zu einem riesigen Haufen und schaufelt den "
      "dann mit Erde zu. Ist er mit dem einen Meiler endlich fertig steckt er "
      "ihn in Brand, um auch schon mit dem Naechsten zu beginnen. Eine "
      "schweisstreibende Beschaeftigung.");
   
   SetProp(P_GENDER, MALE);
   SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
   AddId(({"geselle", "koehlergeselle"}));
   
   create_default_npc(x);
   SetProp(P_HANDS, ({" mit seinen Haenden",QueryProp(P_HANDS)[1],DT_BLUDGEON}));
   SetProp(P_RACE, "Mensch");
   SetProp(P_SIZE, 170 + random(25));
   SetProp(P_ALIGN, random( 201 ) - 100);
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_HEAL,0);
   SetProp(P_AGGRESSIVE,0);
   SetProp(P_WIMPY, 0);
   SetProp(P_RESISTANCE_STRENGTHS , 
      ([DT_FIRE:   -0.2, DT_COLD:      0.2, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
   SetProp(P_NOMAGIC,0);
   
   SetProp(P_MSGIN, "kommt an");
   SetProp(P_MSGOUT, "geht");
   SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
   SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

   SetProp(P_DIE_MSG,  " baut nie wieder einen Meiler.\n");
   SetProp(P_NOCORPSE, 0 );

   SetProp(P_LOG_INFO, "xorgan/geselle.info");
   
   AddInfo(DEFAULT_INFO, "sagt: Frag den Meister danach. Der weiss es "
      "vielleicht!\n");

   SetProp( P_REJECT, ({ REJECT_DROP,
      "Der Geselle sagt: Das brauch ich nicht!.\n" }) );

   SetChats( 2, ({
      "Der Geselle nimmt ein paar Holzscheiter vom Stapel.\n",
      "Der Geselle schaufelt Erde auf den Meiler.\n",
      "Der Geselle schlichtet ein Stueck Holz auf den Meiler.\n",
      "Der Geselle stoehnt erschoepft.\n",
      "Der Geselle wischt sich den Schweiss von der Stirn.\n"}) );
      
   SetAttackChats( 10, ({
      "Der Geselle kreischt: DIR WERD ICHS ZEIGEN!!!\n",
      "Der Geselle bruellt: Na warte! Das sollst Du buessen!\n"}) );

   SetProp(P_SPELLRATE,25);
   AddSpell(1,400,
      "Der Geselle wirft Dir einen Holzscheit auf den Kopf.\n",
      "Der Geselle wirft @WEN einen Holzscheit auf den Kopf.\n",
      DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
   
   SUID;
   CLONEME(ARMOUR + "arbhose.lpc" );
   CLONEME(ARMOUR + "arbjacke.lpc" );
   CLONEME(ARMOUR + "halstuch.lpc" );
   command("trage alles");
}

