// Xorgan@SilberLand
// Questobjekt fuer die Koehlerquest
// 1999-06-26

#include "../def.h"

inherit "std/thing";

int CheckThing( string thing );
int SetThing( string thing );

string things = "";
int qState = 0;

void create()
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT, 0);
   SetProp(P_LONG, 0);
   SetProp(P_INFO, 0);
   SetProp(P_NAME, "koehlerquest");
   SetProp(P_GENDER, NEUTER);
   AddId( ({"koehler_quest","QUESTOBJ"}) );
   
   SetProp(P_MATERIAL, 0);
   SetProp(P_WEIGHT, 0);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   SetProp(P_NEVERDROP, 1);
   SetProp(P_NODROP, 1);
   
}

SetState()
{
   qState++;
}

int GetState()
{
   return qState;
}

int SetThing( string thing )
{
   int i;
   
   i = CheckThing( thing );
   if( i <= 0 )
   {
      if( i < 0 )
      {
         things = things + ",";
      }
      things = things + thing;
   }
   return i;
}

int CheckThing( string thing )
{
   int i;
   string *str;
   
   if( things == "" )
   {
      return 0;
   }
   
   str = explode(things, ",");
   
   for( i = 0; i < sizeof( str ); i++ )
   {
      if( str[i] == thing )
      {
         return i + 1;
      }
   }
   return -sizeof( str );
}


