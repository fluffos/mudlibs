// Xorgan@SilberLand
// Holzkohle fuer die Liebessalbe 
// 1999-06-26

#include "../def.h"

inherit "std/thing";

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();

   SetProp(P_SHORT, "Ein Stueck Holzkohle");
   SetProp(P_LONG,
      "Das ist ein kleines Stueck Holzkohle. Ohne Zweifel handelt es sich um "
      "qualitativ hochwertige Holzkohle. Sie muss wohl von einem wahren Meister "
      "des Koehlerhandwerkes hergestellt worden sein. Einziges Problem: Mit "
      "einem einzigen Stueck Holzkohle kann man nicht grade viel anfangen." );

   SetProp(P_NAME, "Holzkohle");
   SetProp(P_GENDER, FEMALE);
   AddId(({"holzkohle", "kohle", "stueck"}));

   SetProp(P_MATERIAL, MAT_CARBON);
   SetProp(P_WEIGHT, 15);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,0);
   SetProp(P_NOGET,0);
   
}

