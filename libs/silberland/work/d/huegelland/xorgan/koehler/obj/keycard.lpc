// Xorgan@SilberLand
// KeyCard 
// 2004-06-26

#include <moving.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>


inherit "std/thing";

create() 
{
   if( !is_clone( TO) )
      return;
   
   ::create();

   SetProp(P_SHORT, "Xorgan's Keycard");
   SetProp(P_LONG,
      "Das ist Xorgan's Keycard. Mit ihr kannst Du in Xorgans Arbeitsaum "
      "gelangen. Dazu verwende einfach in der Abenteurergilde den Befehl: xorgan.");

   SetProp(P_NAME, "Keycard");
   SetProp(P_GENDER, FEMALE);
   AddId(({"keycard", "card"}));

   SetProp(P_MATERIAL, MAT_PLASTIC);
   SetProp(P_WEIGHT, 0);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,1);
   SetProp(P_NEVERDROP,1);
   SetProp(P_NOGET,1);
   
   AddCmd( "xorgan", "xorgan");
}

xorgan( string str )
{
   notify_fail( "Dazu musst du schon in der Abeteurergilde sein.\n" );
   if( ENV(TP)->QueryProp( P_INT_SHORT ) == "Die beruehmte Abenteurergilde" )
   {
      TP->move( "/players/xorgan/workroom", M_GO, "nach Westen" );
      return 1;
   }
   return 0;
}

