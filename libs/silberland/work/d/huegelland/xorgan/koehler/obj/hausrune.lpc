// Xorgan@SilberLand
// Hausrune von Macalla fuer Rollenspiel
// 2004-09-15

#include "../def.h"

inherit "std/thing";

int gAck=0;

create() 
{
   if(!is_clone(TO))
      return;
   
   ::create();

   SetProp(P_SHORT, "Eine Nhe'Sekalmor Hausrune");
   SetProp(P_LONG,
      "Dies ist eine Hausrune des Drowhauses Nhe'Sekalmor. Die Rune ist aus feinstem "
      "Silber und etwas mattiert. Sie stellt die Drowrune fuer 'S' in einer "
      "verschlungenen Form dar. Sie ist gerade so gross wie die halbe Handflaeche "
      "eines Dunkelelfen." );
   
   SetProp(P_NAME, "Hausrune");
   SetProp(P_GENDER, FEMALE);
   AddId( ({"hausrune" }));

   SetProp( P_MATERIAL, ([MAT_SILVER:100]) );
   SetProp( P_WEIGHT, 0 );
   SetProp( P_VALUE, 0 );
   SetProp( P_NOBUY, 1 );
   SetProp( P_NODROP, 1 );
   SetProp( P_NEVERDROP, 1 );

   AddCmd( ({ "lehne" }), "nein" );
   call_out( "timeout", 300 );
}

int nein( string str )
{
   notify_fail( "Versuch's mal mit: lehne hausrune ab.\n" );
   if( str == "hausrune" || str == "hausrune ab" )
   {
      write("Du lehnst die Rune des Hauses Nhe'Sekalmor ab!\n" );
      say( TPN + " lehnt die Rune des Hauses Nhe'Sekalmor ab.\n" );
      remove();
      
      return 1;
   }
   return 0;
}

int GetAck()
{
   return gAck;
}

void timeout( object obj )
{
   gAck = 1;
}
