// Xorgan@SilberLand
// RPG-Tool 
// 2004-08-02

#include <moving.h>
#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

inherit "std/thing";

int SetMaster( string str );
int CheckPlayer( string name );
void SetPlayer( string name, int val );
void ResetPlayer( string name );
void RemovePlayer( string name );

mapping player = ([ ]);
string master;

create() 
{
   int i;

   if( !is_clone( TO ))
      return;
   
   ::create();

   SetProp(P_SHORT, "Ein RPG Tool");
   SetProp(P_LONG,
      "Das ist Xorgan's RPG Tool. Damit kann man nuetzliche Sachen zum Rollenspielen "
      "machen. Es ist nicht gestattet diese Funktionen ausserhalb von einem "
      "Rollenspiel zu verwenden. Wenn du mehr wissen willst, was Du damit machen kannst "
      "verwende einfach: rpghilfe"
      );

   SetProp(P_NAME, "RPG-Tool");
   SetProp(P_GENDER, NEUTER);
   AddId(({ "tool", "rpgtool", "NODESTRUCT", "QUESTOBJ" }));

   SetProp(P_MATERIAL, MAT_PLASTIC);
   SetProp(P_WEIGHT, 0);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,0);
   SetProp(P_NEVERDROP,1);
   
   /*
   SetPlayer( "macalla", 1);
   SetPlayer( "took", 1);
   */
   AddCmd( "rpg", "rpg");
   AddCmd( "darf", "darf");
   AddCmd( "nixda", "nixda");
   AddCmd( ({"wuerfel","wuerfle"}), "wuerfel");
   AddCmd( "rpghilfe", "rpghilfe");
   AddCmd( "test", "test");
   
}

int test( string str )
{
   write( "Ergebnis: " + "nix sinnvolles" + ".\n" );
   return 1;
}

mixed _query_noget() 
{
   if( master == TP->query_real_name() || query_wiz_level( TP ) > 1 )
   {
      return 0;
   }
   else
      return 1;
   
}

int SetMaster( string str )
{
   master = str;
   player = ([ ]);
   SetPlayer( str, 1);
   write( CAP( str ) + " ist nun der Herr des RPG-Tool.\n" );
   SetProp(P_SHORT, CAP( str ) + "'s RPG Tool");
   SetProp(P_LONG,
      "Das ist Xorgan's RPG Tool. Es gehoert " + CAP( str ) + "!\n"
      "Damit kann man nuetzliche Sachen zum Rollenspielen "
      "machen. Es ist nicht gestattet diese Funktionen ausserhalb von einem "
      "Rollenspiel zu verwenden. Wenn du mehr wissen willst, was Du damit "
      "machen kannst verwende einfach: rpghilfe"
      );
   return 1;
}

int wuerfel( string str )
{
   int a;
   
   notify_fail( "wuerfel <Augenzahl>\n" );
   
   if( str )
   {
      if( master == TP->query_real_name() || query_wiz_level( TP ) > 1 )
      {
         a = to_int( str );
         write( "Du wirfst einen " + str + "-seitigen Wuerfel und das Ergebnis ist " 
            + (random(a) + 1)  + ".\n" );
         return 1;
      }
      else
      {
         notify_fail( "Dieses Kommando darfst Du nicht verwenden!\n" );
      }
   }
   return 0;
}

int rpghilfe( string str )
{
   if( !CheckPlayer( TP->query_real_name() ) && !query_wiz_level( TP ) > 1 )
   {
      str = "Du darfst das RPG-Tool nicht verwenden.\n";
   }
   else
   {
      str = "Folgende Kommandos stehen zur Verfuegung: \n"
          + "    rpg <text>: Gibt den Text an alle Anwenden aus.\n";

      if( master == TP->query_real_name() || query_wiz_level( TP ) > 1 )
      {
         str += "   darf <name>: Der Spieler namens <name> darf die anderen RPG-Kommandos "
             + "verwenden. \n" 
             + "  nixda <name>: Der Spieler namens <name> darf keine RPG-Kommandos "
             + "verwenden.\n"
             + "wuerfle <zahl>: Es wird ein Wuerfel mit <zahl> Auge geworfen "
             + "und das Ergebnis Dir mitgeteilt.\n";
      }
   }
   
   write( str );
   return 1;
}


int rpg( string str )
{
   notify_fail( "rpg <text>\n" );

   if( str )
   {
      if( CheckPlayer( TP->query_real_name() ) )
      {
         tell_room( ENV(TP), BS( "| " + TP->_unparsed_args() + "\n" ));
         return 1;
      }
      else
      {
         notify_fail( "Dieses Kommando darfst Du nicht verwenden!\n" );
      }
   }
   return 0;
}

int darf( string str )
{
   notify_fail( "darf <name>\n" );
   
   if( str )
   {
      if( master == TP->query_real_name() || query_wiz_level( TP ) > 1 )
      {
         SetPlayer( str, 1);
         write( CAP( str ) + " darf nun das RPG-Tool verwenden.\n" );
         return 1;
      }
   }
   return 0;
}


int nixda( string str )
{
   notify_fail( "nixda <name>\n" );
   
   if( str )
   {
      if( master == TP->query_real_name() || query_wiz_level( TP ) > 1 )
      {
         RemovePlayer( str );
         write( CAP( str ) + " darf nun das RPG-Tool nicht mehr verwenden.\n" );
         return 1;
      }
   }
   return 0;
}


int CheckPlayer( string name )
{
   return player[name];         // wenn nicht im mapping: 0, sonst: Wert
}

void SetPlayer( string name, int val )
{
   player[name] = val;            // Wert auf 1 setzen
}

void RemovePlayer( string name )
{
   if( member( player, name )) 
      player -= ([ name ]);
   
}

void ResetPlayer( string name )
{
   player[name] = 0;            // Wert auf 0 setzen
}


