// Scheiter fuer KoehlerQuest 
// 1999-06-26

#include "../def.h"

inherit "std/thing";

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();

   SetProp(P_SHORT, "Ein Haufen Scheiter");
   SetProp(P_LONG,
      "Ein gewaltiger Haufen Eichenholzscheiter." );

   SetProp(P_NAME, "Haufen Scheiter");
   SetProp(P_GENDER, MALE);
   AddId( ({"scheiter","scheite","haufen","QUESTOBJ"}));

   SetProp(P_MATERIAL, MAT_OAK);
   SetProp(P_WEIGHT, 150000);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,0);
   SetProp(P_NOGET,1);

   AddCmd( ({ "schlichte","staple","schichte","schlicht","stapel","schicht" }), "staple" );

}

staple( string str )
{
   object quest;
   
   notify_fail( "Was willst Du wohin stapeln?\n" );
   if( str == "scheiter in flaeche" || str == "scheiter auf flaeche" ||
       str == "scheiter in fleck"   || str == "scheiter auf fleck"   ||
       str == "scheite in flaeche"  || str == "scheite auf flaeche"  ||
       str == "scheite in fleck"    || str == "scheite auf fleck")
   {
      quest = present( "koehler_quest", TP );
      if( quest )
      {
         if( file_name( ENV( TP )) == ROOM + "room_c3" )
         {
            if( quest->GetState() == 1 )
            {
               write( BS( "Du stapelst die Scheiter fein saeuberlich in der "
                  "Flaeche zu einem Haufen. Der Lehrling kommt naeher um Dich "
                  "besser beobachten zu koennen.\n"));
               say( TPN + " stapelt die Scheiter in der schwarze Flaeche zu "
                  "einem Haufen.\n");
               
               quest->SetState();
               TO->remove();
            }
            else
            {
               if( quest->GetState() < 1 )
               {
                  write( "Du bist Dir sicher, dass Du noch etwas vergessen "
                     "hast.\n");
               }
               else
               {
                  write( "So viele Scheiter brauchst Du nicht.\n");
               }
            }
         }
         else
         {
            write( "Den angegebenen Ort findest Du hier nicht!\n");
         }
         return 1;
      }
   }
   return 0;
}

