// Xorgan@SilberLand
// Scheibe und Rad fuer KoehlerQuest 
// 1999-06-26

#include "../def.h"

inherit "std/thing";

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT, "Ein Holzscheibe");
   SetProp(P_LONG,
      "Eine etwa 5 cm dicke beinahe runde Scheibe Eichenholz. Mit dem "
      "entsprechenden Werkzeug kann man sicher ein solides Rad daraus machen." );
//   SetProp(P_INFO, "");
   SetProp(P_NAME, "Scheibe");
   SetProp(P_GENDER, FEMALE);
   AddId( ({"scheibe","holzscheibe","koehler_scheibe","QUESTOBJ"}));

   SetProp(P_MATERIAL, MAT_OAK);
   SetProp(P_WEIGHT, 2000);
   SetProp(P_VALUE, 10);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,0);

   AddCmd( ({"schnitze", "schnitz" }), "schnitze");

}


schnitze( string str )
{
   object ob;
   
   if( !present( "schnitzmesser", TP ))
   {
      write("Du hast nicht das richtige Werkzeug dabei!\n");
      return 1;
   }
      
   notify_fail( "Was willst Du woraus schnitzen?\n" );
   if( str == "rad aus scheibe" )
   {
      ob = TP->QueryProp(P_WEAPON);
      if( ob ) 
      {
         if( ob->id( "koehler_messer" ))
         {
            SetProp(P_SHORT, "Ein Rad");
            SetProp(P_LONG,
               "Eine 5 cm dickes Rad mit 30 cm Durchmesser aus Eichenholz.");
            SetProp(P_NAME, "Rad");
            SetProp(P_GENDER, NEUTER);
            RemoveId("scheibe");
            AddId( ({"rad", "koehler_rad","QUESTOBJ"}) );
            
            SetProp(P_WEIGHT, 1600);
            SetProp(P_VALUE, 120);
            RemoveCmd( "schnitze");
            
            write("Du beginnst aus der Eichenholzscheibe ein perfektes Rad zu "
               "schnitzen.\n");
            write("Es scheint Dir sogar hervorragend zu gelingen.\n");
            say( TPN + " schnitzt aus einer Holzscheibe ein Rad.\n");
            return 1;
         }
      }
      write("Ohne ein geeignes Messer in der Hand zu haben, wird das nichts!\n");
      return 1;
   }
   return 0;
}
