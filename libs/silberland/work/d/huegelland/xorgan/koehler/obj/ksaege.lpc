// Xorgan@SilberLand
// Saege fuer KoehlerQuest 
// 1999-06-26

#include "../def.h"

inherit "std/thing";

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();

   SetProp(P_SHORT, "Eine Saege");
   SetProp(P_LONG,
      "Eine schoene lange Holzsaege mit einem soliden Griff aus Eichenholz. Mit "
      "ihr kann man sicher Holz zersaegen." );
   
   SetProp(P_NAME, "Saege");
   SetProp(P_GENDER, FEMALE);
   AddId( ({"saege", "koehler_saege", "!Koehler","QUESTOBJ" }));

   SetProp(P_MATERIAL, ([MAT_IRON:80,MAT_OAK:20]));
   SetProp(P_WEIGHT, 500);
   SetProp(P_VALUE, 100);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,0);
}
