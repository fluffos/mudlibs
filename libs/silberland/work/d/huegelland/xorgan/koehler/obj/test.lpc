#include "../def.h"

inherit "std/thing";

int CheckThing( string thing );
int SetThing( string thing );

string things = "";

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT, "Ein test");
   SetProp(P_LONG,
      "Ein Test." );

   SetProp(P_NAME, "Test");
   SetProp(P_GENDER, MALE);
   AddId("test");

   SetProp(P_MATERIAL, MAT_OAK);
   SetProp(P_WEIGHT, 150000);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,0);
   SetProp(P_NOGET,1);
   
//   AddCmd( ({ "beschreibe" }), "schreibe");
//   AddCmd( ({ "will" }), "will");
   AddCmd( ({ "beschreibe" }), "SetThing" );
   AddCmd( ({ "will" }), "CheckThing");
}

int SetThing( string thing )
{
   int i;
   
   i = CheckThing( thing );
   if( i <= 0 )
   {
      if( i < 0 )
      {
         things = things + ",";
      }
      things = things + thing;
   }
   return 0;
}

int CheckThing( string thing )
{
   int i;
   string *str;
   
   if( things == "" )
   {
      return 0;
   }
   
   str = explode(things, ",");
   
   for( i = 0; i < sizeof( str ); i++ )
   {
      if( str[i] == thing )
      {
         return i + 1;
      }
   }
   return -sizeof( str );
}


