// Xorgan@SilberLand
// Blumenstrauss vom Koehlerlager
// 1999-06-26

#include "../def.h"

inherit "std/thing";

string text;
int karte = 0;

void create() 
{
   if(!is_clone(TO))
      return;
   
   ::create();

   SetProp(P_SHORT, "Ein wunderschoener Strauss Blumen");
   SetProp(P_LONG,
      "Ein wunderschoener, bunter Strauss herrlich duftender Blumen in allen "
      "Formen und Farben, dazwischen Beiwerk in Form von grazilen Farnen. Man "
      "kann sogar ein Kaertchen mit einer Widmung daran befestigen." );
   
   AddDetail( ({ "blumen" }),
      "Alle moeglichen Blumen, die in einem Wald wachsen sind zu einem schoenen "
      "Strauss vereint worden." );
   
   AddDetail( ({ "formen", "bluetenblaetter", "blaetter", "blueten" }),
      "Spitze oder runde Bluetenblaetter, klein oder grosse Blueten. Alle nur "
      "erdenklichen Formen von Blueten sind im Strauss vertreten ." );
   
   AddDetail( ({ "farben" }),
      "Alle Farben des Regenbogens kannst Du im Strauss finden." );
   
   AddDetail( ({ "regenbogen" }),
      "Nachdem Du keinen siehst, stellst Du Dir einen vor. Wie er in der Pracht "
      "seiner leuchtenden Farben, die von Violett und Blau, ueber Gruen und "
      "Gelb ins Rot fliessen, vom einen zum anderen Horizont reicht." );
   
   AddDetail( ({ "beiwerk" }),
      "Als Beiwerk wurden schlanke zerbrechliche Farne und Graeser verwendet." );
   
   AddDetail( ({ "farne", "graeser" }),
      "So wie fast alle verwendeten Blumen des Strausses scheinen auch diese "
      "aus einem Wald zu stammen." );
   
   AddDetail( ({ "wald" }),
      "Die meisten Blumen dieses Strausses duerften aus einem Wald stammen." );
   
   SetProp(P_NAME, "Blumenstrauss");
   SetProp(P_GENDER, MALE);
   AddId(({"blumen", "strauss", "blumenstrauss"}));
   SetProp(P_INFO, "Was jetzt noch fehlt ist eine Karte mit einer Widmung. "
      "Einen Blumenstrauss kann man an Jemanden den man gern hat verschenken.");
   
   SetProp(P_MATERIAL, MAT_PLANT );
   SetProp(P_WEIGHT, 500);
   SetProp(P_VALUE, 100);
   SetProp(P_NOBUY, 1);
   
   AddCmd( ({"schenke", "verschenke" }), "schenke" );
   AddCmd( ({"rieche", "riech" }), "rieche" );
   AddCmd( ({"befestige", "befestig" }), "befestige" );
   AddCmd( ({"entferne", "entfern" }), "entferne" );
}

schenke( string str )
{
   string wen;
   object pl;
   
   notify_fail("Was willst Du an wen verschenken?\n");
   if( str == "" || !str )
      return 0;
   
   if( sscanf( str, "blumen an %s", wen ) == 1 || sscanf( str, "blumen %s", wen ) == 1 ||
       sscanf( str, "strauss an %s", wen ) == 1 || sscanf( str, "strauss %s", wen ) == 1 ||
       sscanf( str, "blumenstrauss an %s", wen ) == 1 || sscanf( str, "blumenstrauss %s", wen ) == 1 )
   {
      pl = present( wen, environment( TP ));
      
      if( pl )
      {
         if( TO->move( pl, M_GIVE || M_SILENT ) == 1 )
         {
            tell_object( pl, BS( TPN + " zieht hinter seinem Ruecken einen "
               "wunderschoenen Blumenstrauss hervor und schenkt ihn Dir.\n") );
            write( BS( "Du ziehst hinter deinem Ruecken einen Blumenstrauss "
               "hervor und schenkst ihn " + pl->QueryProp( P_NAME ) + ".\n" ) );
            say( TPN + " schenkt " + pl->QueryProp( P_NAME ) + " einen "
               "wunderschoenen Blumenstrauss.\n", pl );
         }
         else
         {
            write( BS( pl->QueryProp( P_NAME ) + " kann Deinen wunderschoenen "
               "Blumenstrauss leider nicht mehr tragen.\n"));
         }
         return 1;
      }
      else
      {
         write( wen + " siehst Du hier nicht!\n");
      }
   }
   return 0;
}

rieche( string str)
{
   notify_fail("Du kannst nichts Besonderes riechen.\n");
   if( str == "blumen"    || str == "strauss"    || str == "blumenstrauss" ||
       str == "an blumen" || str == "an strauss" || str == "an blumenstrauss" )
   {
      write( BS("Intensiv riechst Du an den verfuererisch duftenden Blumen. Wie "
         "berauscht blickst Du auf und beginnst zu traeumen...\n"));
      say( TPN + " riecht an einem Strauss Blumen.\n");
      return 1;
   }
   return 0;
}

befestige( string str )
{
   object ob;
   
   notify_fail( "Was willst wo Du befestigen?\n" );
   if( str == "kaertchen" )
   {
      if( karte == 1 )
      {
         write( "An dem Strauss ist bereits ein Kaertchen befestigt!\n");
         return 1;
      }
      
      ob = present( "kaertchen", TP );
      if( !ob )
      {
         write( "Du hast ja gar kein Kaertchen.\n");
         return 1;
      }
      
      SetProp(P_LONG,
         "Ein wunderschoener, bunter Strauss herrlich duftender Blumen in allen "
         "Formen und Farben, dazwischen Beiwerk in Form von grazilen Farnen. Es "
         "ist sogar ein Kaertchen mit einer Widmung befestigt." );
      
      AddDetail( ({ "kaertchen", "widmung" }),
         "Du kannst die Widmung auf dem Kaertchen lesen." );
      
      SetProp(P_INFO, "Es ist eine Karte mit einer Widmung befestigt, die Du "
         "lesen und entfernen kannst. Einen Blumenstrauss kann man an Jemanden "
         "den man gern hat verschenken.");
      
      text = ob->GetText();
      ob->remove();
      karte = 1;
      
      write( "Du befestigst das Kaertchen am Blumenstrauss.\n");
      say( TPN + " befestigt ein Kaertchen am Blumenstrauss.\n");
      
      AddCmd( ({ "lies", "lese" }), "lese");
      return 1;
   }
   return 0;
}

entferne( string str )
{
   object ob;
   
   notify_fail( "Was willst Du entfernen?\n" );
   if( str == "kaertchen" )
   {
      if( karte == 0 )
      {
         write( "Es ist kein Kaertchen an dem Strauss befestig!\n");
         return 1;
      }
      
      write( "Du entfernst das Kaertchen mit der Widmung aus dem Strauss.\n");
      say( TPN + " entfernt ein Kaertchen aus einem Blumenstrauss.\n");
      
      SetProp(P_LONG,
         "Ein wunderschoener, bunter Strauss herrlich duftender Blumen in allen "
         "Formen und Farben, dazwischen Beiwerk in Form von grazilen Farnen. "
         "Man kann sogar ein Kaertchen mit einer Widmung daran befestigen." );
   
      SetProp(P_INFO, "Was jetzt noch fehlt ist eine Karte mit einer Widmung. "
         "Einen Blumenstrauss kann man an Jemanden den man gern hat "
         "verschenken.");
      
      RemoveDetail( ({ "kaertchen", "widmung" }));
      
      ob = clone_object( OBJ + "kaertchen.lpc");
      
      ob->move( TP, M_NOCHECK );
      ob->SetText( text );
      text = "";
      karte = 0;
      
      RemoveCmd( ({ "lies", "lese" }), "lese");
      return 1;
   }
   return 0;
}

lies( string str )
{
   notify_fail( "Was willst Du lesen?\n" );
   if( str != "widmung" )
      return 0;
   
   if( text == "" )
      write( "Es steht nichts auf dem Kaertchen.\n" );
   else
      write( BS( "Auf dem Kaertchen steht:\n" + text + "\n"));
   
   return 1;
}

