// Xorgan@SilberLand
// Zunder fuer KoehlerQuest 
// 1999-06-26

#include "../def.h"

inherit "std/thing";

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();

   SetProp(P_SHORT, "Etwas Zunder");
   SetProp(P_LONG,
      "Trockenes Gras, kleine Aeste und alte Blaetter. Hervorragender Zunder. "
      "Mit ihm wird man leicht Feuer machen koennen." );
   
   SetProp(P_NAME, "Zunder");
   SetProp(P_GENDER, MALE);
   AddId( ({"zunder", "koehler_zunder","QUESTOBJ"}));

   SetProp(P_MATERIAL, MAT_MISC_PLANT);
   SetProp(P_WEIGHT, 200);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,0);

   AddCmd( ({ "lege", "leg" }), "lege" );

}


lege( string str )
{
   object quest;
   
   notify_fail( "Was willst Du wo hinein legen?\n" );
   if( str == "zunder auf flaeche" || str == "zunder auf fleck"         || 
       str == "zunder in flaeche"  || str == "zunder in flaeche hinein" ||
       str == "zunder in fleck"    || str == "zunder in fleck hinein"    )
   {
      quest = present( "koehler_quest", TP );
      if( quest )
      {
         if( file_name( environment( TP )) == ROOM + "room_c3" )
         {
            write( BS( "Aufmerksam beobachtet Dich der Lehrling, wie Du den "
               "Zunder in die schwarze Flaeche legst.\n"));
            say( TPN + " legt Zunder in die schwarze Flaeche.\n");
            
            if( quest->GetState() == 0 )
            {
               quest->SetState();
            }
            TO->remove();
            
         }
         else
         {
            write( "Den angegebenen Ort findest Du hier nicht!\n");
         }
         return 1;
      }
   }
   return 0;
}

