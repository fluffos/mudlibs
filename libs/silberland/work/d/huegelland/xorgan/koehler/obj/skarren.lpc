// Xorgan@SilberLand
// Schubkarren fuer KoehlerQuest 
// 1999-06-26

#include "../def.h"

inherit "std/thing";

int defect = 1;
int beladen = 0;
int gehoben = 0;
string owner;

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT, "Ein Schubkarren");
   SetProp(P_LONG,
      "Ein hoelzerner Schubkarren hat eine Ladeflaeche, ein Rad und zwei "
      "Griffe. Er eignet sich hervorragend schwere Gegenstaende zu "
      "transportieren. Du kannst ihn anheben und abstellen.");
   
   AddSpecialDetail( ({ "ladeflaeche", "flaeche" }),
      "flaeche");

   AddDetail( ({ "griffe" }),
      "Der Karren hat zwei Griffe. Du musst schon beide Haende benutzen, um "
      "ihn bewegen zu koennen.");

   AddSpecialDetail( ({ "rad" }),
      "rad");

//   SetProp(P_INFO, "");
   SetProp(P_NAME, "Schubkarren");
   SetProp(P_GENDER, MALE);
   AddId(({"karren","schubkarren","QUESTOBJ" }));

   SetProp(P_MATERIAL, ([MAT_IRON:10,MAT_WOOD:90]));
   SetProp(P_WEIGHT, 2000);
   SetProp(P_VALUE, 1500);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,0);
   SetProp(P_NOGET,1);
   
   AddCmd( ({ "hebe", "heb" }), "hebe");
   AddCmd( ({ "stelle", "stell" }), "stelle");
   AddCmd( ({ "erneuere", "erneuer" }), "erneuere");
   AddCmd( ({ "lade" ,"lad" }), "lade");
}

int CheckOwner( string obj )
{
   if(owner == obj)
   {
      return 1;
   }
   else
   {
      return 0;
   }
}

int SetOwner( string obj )
{
   
   if( !CheckOwner( obj ))
   {
      owner = obj;
      SetProp( P_SHORT, "Der Schubkarren von " + CAP(obj) );
      return 1;
   }
   else
   {
      return 0;
   }
}


rad( string str )
{
   write( "Ein aus einer Scheibe Eichenholz geschnitztes Rad. ");
   if( defect == 1 )
      return "Das Rad ist gebrochen.\nBevor du den Karren benutzen kannst, "
         + "wirst du es erneuern muessen.\n";
   else
      return "Das Rad ist nagelneu.\nDamit wirst du keine Probleme haben.\n";
}


flaeche( string str )
{
   if( beladen == 0 )
      return "Die Ladeflaeche ist leer. Du kannst noch jede Menge aufladen.\n";
   else
      return "Der Karren ist mit Holz vollgeladen. Da passt kein Stueck mehr "
         + "rauf.\n";
}


erneuere( string str )
{
   object ob;
   
   if( !CheckOwner( getuid(TP)))
   {
      notify_fail( "Das ist nicht Dein Schubkarren.\n" );
      return 0;
   }
   
   if( defect == 0 )
   {
      write( "Der Schubkarren wurde bereits repariert.\n");
      return 1;
   }
   
   notify_fail( "Was moechtest Du erneuern?\n" );
   if( str == "rad" )
   {
      ob = present( "koehler_rad", TP );
      if( !ob )
      {
         write( "Du hast ja gar kein Rad!\n");
      }
      else
      {
         write( "Muehelos loest Du das kaputte Rad von der Achse und setzt das "
            "neue Rad ein.\n");
         write( "Jetzt ist der Schubkarren wieder wie neu!\n");
         say( TPN + " repariert einen Schubkarren.\n");
         
         destruct( ob );
         defect = 0;
      }
      
      return 1;
   }
   return 0;
}


hebe( string str )
{
   if( !CheckOwner( getuid(TP)))
   {
      notify_fail( "Das ist nicht Dein Schubkarren.\n" );
      return 0;
   }
   
   notify_fail( "Was moechtest Du anheben?\n" );
   if( str == "karren an" || str == "schubkarren an" ||str == "karren" || str == "schubkarren")
   {
      if( defect == 1 )
      {
         write("Das Rad ist gebrochen. Bevor du es nicht erneuert hast, kannst "
            "du den Karren nicht bewegen.\n");
         return 1;
      }
      if( gehoben == 1 )
      {
         write("Du hast den Schubkarren bereits angehoben!\n");
         return 1;
      }
   
      if( TP->QueryProp( P_MAX_HANDS ) - TP->QueryProp( P_USED_HANDS ) >= 2 )
      {
         write( "Du hebst den Schubkarren an und schiebst ihn nun vor Dir "
            "her.\n");
         say( TPN + " hebt einen Schubkarren an.\n");
         
         TP->AddPursuer(TO);
         TP->SetProp(P_USED_HANDS, TP->QueryProp(P_USED_HANDS) + 2);
         gehoben = 1;
      }
      else
      {
         write("Dazu brauchst du schon zwei freie Haende!\n");
      }
      return 1;
   }
   return 0;
}


stelle( string str )
{
   if( !CheckOwner( getuid(TP)))
   {
      notify_fail( "Das ist nicht Dein Schubkarren.\n" );
      return 0;
   }
   
   notify_fail( "Was moechtest Du abstellen?\n" );
   if( str == "karren ab" || str == "schubkarren ab" )
   {
      if( gehoben == 1 )
      {
         write( "Du stellst den Schubkarren ab.\n");
         say( TPN + " stellt einen Schubkarren ab.\n");
         TP->RemovePursuer(TO);
         if( TP->QueryProp(P_USED_HANDS) >= 2)
         {
            TP->SetProp(P_USED_HANDS, TP->QueryProp(P_USED_HANDS) - 2);
         }
         else
         {
            TP->SetProp(P_USED_HANDS, 0);
         }
         gehoben = 0;
      }
      else
      {
         write( "Du hast den Schubkarren nicht angehoben!\n" );
      }
      return 1;
   }
   
   return 0;
}


lade( string str )
{
   object ob;
   
   if( !CheckOwner( getuid(TP)))
   {
      notify_fail( "Das ist nicht Dein Schubkarren.\n" );
      return 0;
   }
   
   notify_fail( "Was moechtest Du auf- oder abladen?\n" );
   if( str == "scheiter auf" || str == "scheiter auf karren" ||
       str == "scheite auf"  || str == "scheite  auf karren")
   {
      if( gehoben == 1 )
      {
         write( "Du solltest vorher den Schubkarren abstellen!\n" );
         return 1;
      }
      
      if( beladen == 1 )
      {
         write( BS( "Der Schubkarren ist schon mit Scheitern vollgeladen. Du "
            "bringst kein Stueck mehr hinauf!\n"));
         return 1;
      }
      
      ob = present( "scheiter", ENV( TP ));
      if( !ob )
      {
         write("Welche Scheiter moechtest Du aufladen? Es sind ja keine da!\n");
         return 1;
      }
      
      write( BS( "Du schlichtest die Scheiter einen nach dem anderen auf den "
         "Karren. Zum Glueck passt gerade noch der letzte hinauf.\n"));
      say( TPN + " schlichtet die Scheiter auf den Schubkarren.\n");
      
      ob->remove(1);
      
      beladen = 1;
      
      return 1;
   }
   
   if( str == "scheiter ab" || str == "scheiter von karren ab" ||
       str == "scheite ab"  || str == "scheite von karren ab")
   {
      if( gehoben == 1 )
      {
         write( "Du solltest vorher den Schubkarren abstellen!\n" );
         return 1;
      }
      
      if( beladen == 0 )
      {
         write( BS( "Auf den Schubkarren ist doch noch garnichts aufgeladen!\n"));
         return 1;
      }
      
      write( BS( "Du raeumst die Scheiter einen nach dem anderen vom Karren "
         "herunter.\n"));
      say ( TPN + " raeumt die Scheiter von seinem Schubkarren herunter.\n" );
      
      clone_object( OBJ + "scheiter.lpc" )->move( ENV( TP ));
      beladen = 0;
      
      return 1;
   }
   
   return 0;
}

