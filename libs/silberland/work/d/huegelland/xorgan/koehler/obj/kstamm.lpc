// Xorgan@SilberLand
// Stamm fuer KoehlerQuest 
// 1999-06-26

#include "../def.h"

inherit "std/thing";

int anz = 1;

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();

   SetProp(P_SHORT, "Ein Stamm");
   SetProp(P_LONG,
      "Ein beinahe runder Stamm einer ehemals maechtigen Eiche. Was man wohl "
      "alles aus diesem schoenen Holz machen kann. Auf "
      "jeden Fall musst du ihn zerkleinern, um ihn von hier weg zu bekommen." );
//   SetProp(P_INFO, "");
   SetProp(P_NAME, "Stamm");
   SetProp(P_GENDER, MALE);
   AddId( ({"stamm","koehler_stamm","QUESTOBJ"}));

   SetProp(P_MATERIAL, MAT_OAK);
   SetProp(P_WEIGHT, 150000);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,0);
   SetProp(P_NOGET,1);
   
   AddCmd( ({ "zerkleinere", "zerkleiner" }), "zerkleinere" );
   AddCmd( ({ "saege", "saeg" }), "saege");
}

zerkleinere(string str )
{
   notify_fail( "Was willst Du zerkleinern?\n" );
   if( str == "stamm" )
   {
      if(TP->QueryProp( "hands_used_by" ) != ({}) )
      {
         write("Dazu solltest Du nichts in der Hand haben!\n");
         return 1;
      }
      
      if(present("koehleraxt",TP) && present("koehler_saege",TP))
      {
         write("Du nimmst Deine Saege und zersaegst den grossen Stamm.\n");
         say( TPN+" zersaegt einen Stamm.\n");
         write("Mit der Koehleraxt spaltest du die Stuecke in handliche "
            "Scheiter.\n");
         say( TPN+" spaltet mit der Koehleraxt die Stuecke.\n");
         
         clone_object(OBJ + "scheiter.lpc")->move( ENV( TP ));
         TO->remove(1);
         return 1;
      }
      else
      {
         write("Du hast nicht das richtige Werkzeug dabei!\n");
         return 1;
      }
   }
   return 0;
}

saege( string str )
{
   object ob;
   
   notify_fail( "Was willst Du absaegen?\n" );
   if( str == "scheibe ab" ||
       str == "scheibe von stamm ab" ||
       str == "scheibe von stamm" )
   {
      if( present( "koehler_scheibe", TP ))
      {
         write( "Du hast bereits eine Scheibe.\n");
         return 1;
      }
      
      if( present( "rad", TP ))
      {
         write( "Du brauchst keine Scheibe mehr.\n");
         return 1;
      }
      
      if( present( "koehler_saege", TP ))
      {
         write("Du nimmst Deine Saege und saegst eine Scheibe vom Stamm ab.\n");
         say( TPN+" saegt eine Scheibe von einem Stamm.\n");
         
         if( (ob=clone_object(OBJ + "scheibe.lpc"))->move(TP) != 1 )
         {
            ob->move(ENV(TP)); 
         }
         return 1;
      }
      else
      {
         write("Du hast nicht das richtige Werkzeug dabei!\n");
         return 1;
      }
   }
   return 0;   
}

