// Xorgan@SilberLand
// Schaufel fuer KoehlerQuest 
// 1999-06-26

#include "../def.h"

inherit "std/thing";

void create()
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT,"Eine Koehlerschaufel");
   SetProp(P_LONG,"Eigentlich eine ganz normale Schaufel. Sie hat ein relativ "
      "grosse rechteckige Schaufelflaeche aus Eisen mit einem zwei Zentimeter "
      "hohen Rand. Der Stiel ist sicher eineinhalb Meter lang und am oberen "
      "Ende ist einen Metallhuelse in den Stiel eingesetzt." );
   
   
   AddId( ({"schaufel","koehler_schaufel", "!Koehler","QUESTOBJ" }));
   
   SetProp(P_MATERIAL, ([MAT_IRON:50,MAT_OAK:50]));
   SetProp(P_NAME, "Koehlerschaufel");
   SetProp(P_GENDER, FEMALE);
   SetProp(P_VALUE, 50);
   SetProp(P_WEIGHT, 1200);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,0);

}

