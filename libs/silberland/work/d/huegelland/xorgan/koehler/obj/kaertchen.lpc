// Xorgan@SilberLand
// Kaertchen fuer den Blumenstrauss vom Koehlerlager
// 1999-06-26

#include "../def.h"

inherit "std/thing";
inherit "mail/nedit";

#define MASK "|   %|:52s   |"
#define LEER "|                                                          |"
#define RAND "o----------------------------------------------------------o"
            //123456789012345678901234567890123456789012345678901234567890
            //        10        20        30        40        50        60       


string text = "";



void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT, "Ein Kaertchen");
   SetProp(P_LONG,
      "Dies ist ein Kaertchen auf dem man einen Text mit beschreibe schreiben "
      "kann. Weiters kann man den Text auch wieder entfernen. Es eignet sich "
      "hervorragend fuer eine Widmung." );
      
   SetProp(P_NAME, "Kaertchen");
   SetProp(P_GENDER, NEUTER);
   AddId( ({ "kaertchen" }) );
   
   SetProp(P_MATERIAL, MAT_PAPER );
   SetProp(P_WEIGHT, 20);
   SetProp(P_VALUE, 10);
   SetProp(P_NOBUY, 1);
   
   AddCmd( ({ "lies", "lese" }), "lies");
   AddCmd( ({ "beschreibe", "beschreib" }), "schreibe");
   AddCmd( ({ "entferne", "entfern" }), "entferne");
   
}

lies( string str )
{
   notify_fail( "Was willst Du lesen?\n" );
   if( str = "kaertchen" )
   {
      if( text == "" )
         write( "Es steht nichts auf dem Kaertchen.\n" );
      else
      {
         write( BS( "Auf dem Kaertchen steht:\n\n"));
         write( RAND + "\n");
         write( LEER + "\n");
         write( text );
         write( LEER + "\n");
         write( RAND + "\n");
      }
      return 1;
   }
   return 0;
}


schreibe( string str )
{
   string *tmp;
   
   notify_fail( "Was willst Du beschreiben?\n");
   
   if(  str == "kaertchen") 
   {
      text = "";
      
      write( "Bitte Text eingeben. Der Text wird automatisch zentriert und "
         "umgebrochen.\n" );
      write( "~h Hilfeseite, ~q Abbruch, . wenn fertig!\n" );
      nedit( "WriteText" );
      
      return 1;
   }
   return 0; 
   
}

void WriteText( string str )
{
   string *str1;
   int i;
   
   if(!str) 
   {
      write(BS("Abbruch! Nichts auf das Kaertchen drauf geschrieben."));
   }
   else 
   {
      write(BS("Du schreibst deinen Text auf das Kaertchen.\n"));
      say( TPN + " schreibt etwas auf ein Kaertchen.\n");
   
      str = break_string(str,52,0,BS_LEAVE_MY_LFS);
      
      str1 = explode(str, "\n");
      
      if( sizeof( str1 ) < 6 )
      {
         for( i = 0; i < (6 - sizeof( str1 )) / 2; i++)
            text = text + LEER + "\n";
      }
      
      for( i = 0; i < sizeof( str1 ); i++)
         text = text + sprintf(MASK ,str1[i]) + "\n";
      
      if( sizeof( str1 ) < 6 )
      {
         for( i = 0; i < (6 - sizeof( str1 )) / 2; i++)
            text = text + LEER + "\n";
      }
      
      
   }
}

entferne( string str )
{
   notify_fail( "Was willst Du entfernen?\n" );
   if( str == "widmung" )
   {
      text = "";
      write( "OK.\n");
      return 1;
   }
   return 0;
}

SetText( string str )
{
   text = str;
}

string GetText()
{
   return text;
}