// Xorgan@SilberLand
// Mutterrune von Macalla fuer Rollenspiel
// 2004-09-15

#include "../def.h"

inherit "std/thing";

create() 
{
   if(!is_clone(TO))
      return;
   
   ::create();

   SetProp(P_SHORT, "Die Hausrune des Hauses Nhe'Sekalmor");
   SetProp(P_LONG,
      "Dies ist die Hausrune des Drowhauses Nhe'Sekalmor. Sie besteht aus Platin und "
      "ist mit winzigen, schwarzen Diamanten eingelegt. Sie zeigt die Drowrune fuer "
      "'S' in verschlungener Schrift. Die Rune haengt an Macallas Guertel und ist "
      "etwa so gross wie die Handflaeche eines Dunkelelfen." );
   
   SetProp(P_NAME, "Mutterrune");
   SetProp(P_GENDER, FEMALE);
   AddId( ({"mutterrune" }));

   SetProp( P_MATERIAL, ([MAT_PLATINUM:85, MAT_DIAMOND:15]) );
   SetProp( P_WEIGHT, 0 );
   SetProp( P_VALUE, 0 );
   SetProp( P_NOBUY, 1 );
   SetProp( P_NODROP,1 );
   SetProp( P_NEVERDROP, 1 );
   
   AddCmd( ({ "erschaffe" }), "erschaffe" );
   AddCmd( ({ "entreisse" }), "entreisse" );
}

int erschaffe( string str )
{
   string spieler;
   object obj;
   object ob;
   object *noShow;
   
   notify_fail( "Versuch's mal mit: erschaffe rune fuer <spieler>!\n" );
   if( !str || sscanf( str, "rune fuer %s", spieler ) != 1 )
   {
      return 0;
   }
   
   obj = find_player( spieler );
   if( obj )
   {
      if( (ob=clone_object( OBJ + "hausrune.lpc" ))->move( obj, M_NOCHECK ) != 1 )
         destruct( ob );
      
      noShow    = allocate(2);
      noShow[0] = obj;
      noShow[1] = TP;
      
      write("Du beruehrst die Rune an deinem Guertel und murmelst etwas.\n" );
      say( TPN + " beruehrt die Rune an " + TP->QueryPossPronoun( MALE, WEM ) 
         + " Guertel und murmelt etwas.\n" );
      tell_room( ENV( TP ), TPN + " uebergibt die Hausrune an " + CAP( spieler ) + ".\n", 
         noShow );
      tell_object( obj, TPN + " uebergibt die Hausrune an Dich.\n\n" 
          + BS( "Wenn Du die Hausrune "
         "ablehnen willst, so kannst Du das in der nächsten Minute mit  lehne "
         "hausrune ab  machen, allerdings verweigerst Du dann die Aufnahme in "
         "des Haus Nhe'Sekalmor.\n" ));
      return 1;
   }
   else
   {
      write( "Das ist doch kein Spieler!\n" );
   }
   return 1;
}

int entreisse( string str )
{
   string spieler;
   string rune;
   object obj;
   object ob;
   object *noShow;

   notify_fail( "Versuch's mal mit: entreisse <spieler> rune!\n" );
   if( !str || sscanf( str, "%s %s", spieler, rune ) != 2 )
   {
      return 0;
   }
   else
   {
      if( rune != "rune" )
         return 0;
   }
   
   obj = find_player( spieler );
   if( obj )
   {
      ob=deep_present( "hausrune", obj );
      if( ob )
      {
         if( ob->GetAck() )
         {
            destruct(ob);

            noShow    = allocate(2);
            noShow[0] = obj;

            write("Du beruehrst die Rune an Deinem Guertel und murmelst etwas.\n");
            say( TPN + " beruehrt die Rune an " + TP->QueryPossPronoun( MALE, WEM ) 
               + " Guertel und murmelt etwas.\n" );
            tell_room( ENV( TP ), CAP( spieler ) + " windet sich vor Schmerzen als sich die "
               + "Hausrune aufloest.\n", noShow);
            tell_object( obj, BS( "Die Hausrune bohrt sich schmerzhaft in Deinen Koerper "
               "und fuegt Dir einen tiefen Schnitt zu. Dann verschwindet sie spurlos.\n" ));
         }
         else
            write( BS( "Solange " + CAP( spieler ) + " die Hausrune nicht akzeptiert hat, kannst du "
                   "sie ihm nicht herausreissen.\n"));
      }
      else
      {
         write( "Der Spieler hat ja gar keine Hausrune!\n" );
      }
   }
   else
   {
      write( "Das ist doch kein Spieler!\n" );
   }
   
   return 1;
}

