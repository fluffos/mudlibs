//#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT, "Gubor's Gubor Zuckerldose");
   SetProp(P_LONG,
      "Diese runde Dose mit zirka 10 Zentimeter Durchmesser und einer Tiefe "
      "von 3 cm besteht aus Blech und ist mit einer schoenen Zeichnung "
      "bedruckt. Mit einer gebogenen Schrift ist Gubor Suessigkeiten auf den "
      "Deckel der Dose geschrieben. In dieser Dose werden im Normalfall Gubor "
      "Zuckerl aufbewahrt und in diesem Fall ist das wohl nicht anders. Diese "
      "Gubor Zuckerldose gehoert Gubor" );
   SetProp(P_INFO, "Da sind sicher Zuckerl drinnen. Probiere mal doch eines!");
   SetProp(P_NAME, "Zuckerldose");
   SetProp(P_GENDER, FEMALE);
   AddId( ({"dose", "zuckerldose"}) );
   
   SetProp(P_MATERIAL, ([MAT_IRON:20,MAT_MISC_FOOD:80 ]) );
   SetProp(P_WEIGHT, 250);
   SetProp(P_VALUE, 0);
   SetProp(P_NOBUY, 1);
   
   AddCmd( ({"probiere", "probier"}), "probiere" );
}

probiere( string str )
{
   notify_fail( "Was willst Du probieren?\n" );
   if( str == "zuckerl" )
   {
      write( BS( "Du oeffnest die Dose und nimmst eines der unzaehligen Zuckerl "
         "heraus, um es genuesslich in Deinen Mund zu schieben. Begeistert "
         "lutschst Du an dem Zuckerl herum. So suess und fruchtig! Wunderbar! "
         "Deine Geschmacksnerven tanzen Walzer. Und ehe Du Dich versiehst ist "
         "es auch schon aufgeloest. Schade, aber Du hast je noch mehr davon!"));
      say( BS( TPN + " oeffnet seine Gubor Zuckerldose, nimmt in Zuckerl heraus, "
         "steckt es in seinen Mund und lutscht es hoch erfreut.\n"));
      return 1;
   }
   return 0;
}