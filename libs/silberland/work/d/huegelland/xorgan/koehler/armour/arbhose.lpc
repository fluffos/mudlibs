// Xorgan@SilberLand
// Arbeitshose
// 1999-06-26

#include "../def.h"

inherit "std/armour";

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT, "Eine Arbeitshose");
   SetProp(P_LONG,
      "Diese blaue widerstandsfaehige Hose ist aus einem dicken Baumwollstoff "
      "gefertigt und hat sowohl zwei grosse aufgenaehte Taschen auf den Seiten, "
      "als auch zwei weitere hinten. Sie ist hervorragend fuer schwere Arbeiten "
      "geeignet und wird daher gerne von den Koehlern getragen wird." );
   SetProp(P_NAME, "Arbeitshose");
   SetProp(P_GENDER, FEMALE);
   AddId( ({"arbeitshose","hose"}));
   
   SetProp(P_AC, 4);
   SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
   SetProp(P_MATERIAL, MAT_COTTON );
   SetProp(P_WEIGHT, 1000);
   SetProp(P_VALUE, 800);
   SetProp(P_NOBUY, 0);
   
}
