// Xorgan@SilberLand
// Filzhut
// 1999-06-26

#include "../def.h"

inherit "std/armour";

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT, "Ein grauer Filzhut");
   SetProp(P_LONG,
      "Der Hut hat eine breite Krempe und laeuft spitz zusammen. Er aehnelt in "
      "der Form einem Tirolerhut. Zwei Schnuere bilden den inneren Anschluß der "
      "Krempe. Dieser graue Filzhut gehoerte einmal dem Meister der Koehler." );
   SetProp(P_NAME, "Filzhut");
   SetProp(P_GENDER, MALE);
   SetProp(P_NAME_ADJ, "grau" );
   AddAdjective( "grau" );
   AddId( ({"filzhut","hut"}) );
   
   SetProp(P_AC, 3);
   SetProp(P_ARMOUR_TYPE, AT_HELMET);
   SetProp(P_MATERIAL, MAT_FELT );
   SetProp(P_WEIGHT, 600);
   SetProp(P_VALUE, 500);
   SetProp(P_NOBUY, 0);
   
}
