// Xorgan@SilberLand
// Arbeitsjacke
// 1999-06-26

#include "../def.h"

inherit "std/armour";

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT, "Eine Arbeitsjacke");
   SetProp(P_LONG,
      "Diese blaue widerstandsfaehige Jacke ist aus einem dicken Baumwollstoff "
      "gefertigt. Sie ist hervorragend fuer schwere Arbeiten geeignet und wird "
      "daher gerne von den Koehlern getragen wird." );
   SetProp(P_NAME, "Arbeitsjacke");
   SetProp(P_GENDER, FEMALE);
   AddId( ({"arbeitsjacke","jacke"}));
   
   SetProp(P_AC, 6);
   SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
   SetProp(P_MATERIAL, MAT_COTTON );
   SetProp(P_WEIGHT, 1000);
   SetProp(P_VALUE, 800);
   SetProp(P_NOBUY, 0);
   
}
