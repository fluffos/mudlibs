// Xorgan@SilberLand
// Koehlerhalstuch
// 1999-06-26

#include "../def.h"

inherit "std/armour";

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();
   
   SetProp(P_SHORT, "Ein graues Halstuch");
   SetProp(P_LONG,
      "Diese Halstuch ist aus einfachen duennen Stoff hergestellt. Die "
      "verwendete Baumwolle ist dunkelgrau gefaerbt worden. Da alle Koehler ein "
      "solches Tuch tragen, ist dieses Tuch wohl das Zeichen der Koehlerzunft." );
   SetProp(P_NAME, "Halstuch");
   SetProp(P_GENDER, NEUTER);
   SetProp(P_NAME_ADJ, "grau" );
   AddAdjective( "grau" );
   AddId( ({"halstuch","tuch"}) );
   
   SetProp(P_AC, 1);
   SetProp(P_ARMOUR_TYPE, AT_AMULET);
   SetProp(P_MATERIAL, MAT_COTTON );
   SetProp(P_WEIGHT, 100);
   SetProp(P_VALUE, 150);
   SetProp(P_NOBUY, 0);
   
}
