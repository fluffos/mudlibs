// Xorgan@SilberLand
// Schnitzmesser fuer die Koehlerquest
// 1999-06-26

#include "../def.h"

inherit "std/weapon";

void create() 
{
   if(!is_clone(TO)) 
      return;
   
   ::create();

   SetProp(P_SHORT, "Ein Schnitzmesser");
   SetProp(P_LONG,
      "Dieses Schnitzmesser unterscheidet sich eigentlich kaum von einem "
      "normalen Messer. Auffaelliger Unterschied ist die relativ kurze, jedoch "
      "stabile und sehr scharfe Klinge. Es duerfte sich wesentlich besser zum "
      "Schnitzen als zum Kaempfen eignen." );
   
   AddId (({"messer","schnitzmesser", "koehler_messer"}));
   SetProp(P_NAME, "Schnitzmesser");
   SetProp(P_GENDER, NEUTER);

   SetProp(P_MATERIAL, ([MAT_IRON:50,MAT_WOOD:50]));
   SetProp(P_WEIGHT, 100);
   SetProp(P_VALUE, 60);
   SetProp(P_NOBUY, 1);
   SetProp(P_NODROP,0);
   SetProp (P_WEAPON_TYPE, WT_KNIFE);
   SetProp (P_DAM_TYPE, DT_PIERCE);
   SetProp (P_WC, 60);
   SetProp (P_NR_HANDS, 1);
}
