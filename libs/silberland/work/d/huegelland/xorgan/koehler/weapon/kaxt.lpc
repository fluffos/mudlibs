// Xorgan@SilberLand
// Koheleraxt fuer die Koehlerquest
// 1999-06-26

#include "../def.h"

inherit "std/weapon";

void create()
{
   if(!is_clone(TO))
      return;
   
   ::create();

   SetProp( P_SHORT, "Eine Koehleraxt");
   SetProp( P_LONG, "Eine Axt, die vorzugsweise von Koehler verwendet wird! "
      "Sie hat einen langen Stiel aus Eichenholz und ein seltsames Axtblatt.");
      
   SetProp(P_INFO, "Das Axtblatt ist aeusserst seltsam.");
   AddDetail( ({"axtblatt","blatt"}),
      "Diese Axt hat ein doppeltes Axtblatt. Die eine Seite des Axtblattes "
      "ist eine grosse scharfe Klinge. Die andere ist schmaeler, "
      "viel dicker und total stumpf.");
   AddDetail( ({ "klinge" }),
      "Diese Axt hat zwei unterschiedliche Seiten. ");
   AddDetail( ({ "seiten" }),
      "Die eine Seite ist scharf und spitz, so wie bei einer normalen Axt, die "
      "andere dagegen ist stumpf, breit und sieht eher wie ein Keil aus.");
   AddDetail( ({ "seite" }),
      "Jede Seite hat ihre eigen Verwendungsart. Mit der schmalen, scharfen "
      "Klinge kann man wunderbar Baeume faellen, mit der stumpfen keilfoermigen "
      "Klinge spaltet man Holzbloecke. ");
   AddDetail( ({ "verwendungsart", "art" }),
      "Diese Axt hat mindestens zwei. Kommt ganz darauf an welche Klinge man "
      "verwendet.");
   
   SetProp( P_NAME, "Koehleraxt" );
   SetProp( P_GENDER, FEMALE );
   AddId(( {"axt","koehleraxt"}));

   SetProp( P_VALUE, 1000 );
   SetProp( P_WEIGHT, 2300 );
   SetProp( P_WEAPON_TYPE, WT_AXE );
   SetProp( P_DAM_TYPE, DT_SLASH );
   SetProp( P_WC, 200 );
   SetProp( P_WC_FIX, 20 );
   SetProp( P_NR_HANDS, 2 );
   SetProp( P_MATERIAL, ([MAT_STEEL:40, MAT_OAK:60]) );
   SetProp( P_WC_BONUS, (["koehlermeister":250]) );
   SetProp( P_NOBUY, 1 );
   
   AddCmd( "verwende", "verwende" );
}

verwende( string str )
{
   int i;
   
   notify_fail( "Welche Klinge moechtest Du verwenden?\n" );
   
   switch( str )
   {
      case "stumpfe klinge":
         TO->SetProp( P_DAM_TYPE, DT_BLUDGEON );
         break;
      case "scharfe klinge":
         TO->SetProp( P_DAM_TYPE, DT_SLASH );
         break;
      
      case "andere klinge":
         if( TO->QueryProp( P_DAM_TYPE )[0] == DT_SLASH )
            TO->SetProp( P_DAM_TYPE, DT_BLUDGEON );
         else
            TO->SetProp( P_DAM_TYPE, DT_SLASH );
         break;
      default:
         return 0;
   }
   
   write( "Du drehst die Klinge der Koehleraxt um. " );
   if( TO->QueryProp( P_DAM_TYPE )[0] == DT_SLASH )
      write("Du verwendest nun die scharfe Klinge...\n" );
   else
      write("Du verwendest nun die stumpfe Klinge...\n" );
   
   say( TPN + " schlaegt nun mit der anderen Seite seiner Koehleraxt zu.\n" );
   return 1;
}

