// Xorgan@SilberLand
// KoehlerLager 
// 1999-06-26

#include "../def.h"

inherit "std/room";

void create()
{

   ::create();

   SetProp( P_INT_SHORT, "Noerdliche Lichtung" );
   SetProp( P_INT_LONG,
      "Du hast eine Lichtung betreten, die sich Richtung Sueden und Westen "
      "ausbreitet. Im Norden kannst Du ein hoelzernes Gebaeude erkennen. "
      "Von dem schoenen gruenen Waldboden ist hier nichts mehr zu finden. "
      "Im Westen und Suedwesten befinden sich seltsame Huegel. Dichte "
      "Rauchschwaden haengen in der Luft." );
   SetProp( P_LIGHT, 2 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

   AddDetail( ({ "lichtung", "platz" }),
      "Diese Lichtung scheint nicht natuerlich entstanden zu sein. "
      "Es scheint sich mehr um eine Rodung zu handeln. Auf dem gesamten Platz "
      "steht kein einziger Baum mehr.");

   AddDetail( ({ "richtung", "richtungen" }),
      "Nach Sueden und Westen dehnt sich die Lichtung aus.");

   AddDetail( ({ "sueden", "norden" }),
      "In diese Richtungen dehnt sich die Lichtung aus.");

   AddDetail( ({ "rodung" }),
      "Die wurde sehr gruendlich durchgefuert. Alle Baeume und Buesche scheinen "
      "ihr zum Opfer gefallen zu sein."
      );
   
   AddDetail( ({ "baeume", "baum", "buesche", "busch" }),
      "Auf der Lichtung gibt es keine. Aber hinter Dir kannst Du genug davon "
      "finden.");

   AddDetail( ({ "gebaeude" }),
      "Noerdlich von Dir befindet sich ein hoelzerner Schuppen.");

   AddDetail( ({ "schuppen","scheune" }),
      "Ein Gebaeude das wohl zum Lagern von diversen Gegenstaenden dient. "
      "Es ist ziemlich gross und hat ein grosses Tor. Der Schuppen ist aus Holz "
      "gebaut und befindet sich noerdlich von Dir.");

   AddDetail( ({ "holz" }),
      "Scheint sich um Holz aus dem Wald zu handeln.");

   AddDetail( ({ "wald" }),
      "Du bist auf einer Lichtung im Wald.");

   AddDetail( ({ "gegenstaende" }),
      "Die kannst Du von hier aus nicht sehen. Da wirst Du schon naeher kommen "
      "muessen.");

   AddDetail( ({ "scheunentor","tor" }),
      "Ein grosses Scheunentor mit zwei Fluegeln.");

   AddDetail( ({ "boden", "waldboden" }),
      "Von gruenem Waldboden keine Spur. Du stehst auf blanker staubiger Erde. "
      "Nicht einmal ein Grashalm ist zu entdecken.");

   AddDetail( ({ "erde" }),
      "Staubige braune Erde.");

   AddDetail( ({ "grashalm", "halm" }),
      "Du siehst keine Pflanzen.");

   AddDetail( ({ "huegel" }),
      "Sie sehen irgendwie merkwuerdig aus. Alle scheinen von Menschenhand "
      "aufgeschuettet worden zu sein. Der Huegel im Westen ist besonders "
      "seltsam.");

   AddDetail( ({ "westen" }),
      "Im Westen befindet sich ein seltsamer Huegel. Von ihm scheint der Rauch "
      "zu kommen.");

   AddDetail( ({ "menschenhand", "hand" }),
      "Auf jeden Fall ist er nicht auf natuerliche Weise entstanden.");

   AddDetail( ({ "fall" }),
      "Du bist absolut sicher!");
      
   AddDetail( ({ "himmel" }),
      "Abgesehen von den Rauchschwaden ist der Himmel blau.");
    
   AddDetail( ({ "rauchschwaden", "schwaden" }),
      "Dichte Rauchschwaden ziehen von Westen heran. Du bekommst kaum noch "
      "Luft.");

   AddDetail( ({ "luft" }),
      "Die Luft ist von Rauchschwaden erfuellt. Dein Augen brennen.");

   AddDetail( ({ "rauch" }),
      "Stickiger grau-schwarzer Rauch. Er brennt in Deinen Augen und kratzt im "
      "Hals.");

   AddDetail( ({ "augen" }),
      "Ueber kurz oder lange werden Deine Augen zu traenen beginnen. Brennen "
      "tun sie schon.");

   AddDetail( ({ "hals" }),
      "Du hast ein unangenehmes Kratzen im Hals. Das kommt bestimmt von den "
      "Rauch.");

   AddDetail( ({ "opfer" }),
      "Ja. Es sind alle weg.");

   AddDetail( ({ "fluegel" }),
      "Dieses Tor hat zwei Fluegel und laesst sich daher in der Mitte oeffnen.");

   AddDetail( ({ "spur" }),
      "Nein! Keine Spur von Pflanzen zu sehen.");

   AddSound( DEFAULT_SOUND,
      "Du vernimmst unterschiedlichste Geraeusche.");

   AddSound( ({ "geraeusche" }),
      "Du hoerst ein Knistern, das von Westen kommt. Im Sueden kannst Du auch "
      "Etwas vernehmen.");

   AddSound( ({ "knistern" }),
      "Im Westen ist ein leises Knistern zu vernehmen. Es scheint durch ein "
      "Feuer verursacht zu werden." );

   AddSound( ({ "etwas" }),
      "Du kannst es nicht genau verstehen, aber es scheint sich um Worte zu "
      "handeln.");

   AddSound( ({ "worte" }),
      "Du kannst sie nicht verstehen!");

   AddSmell( DEFAULT_SMELL,
      "WAHHH!!! Es stinkt fuerchterlich nach Rauch.");

   AddSmell( ({ "rauch" }),
      "Wirklich nicht angenehm.");

//   AddItem( "item" , REFRESH_DESTRUCT);

   AddExit( "westen", "./room_d4" );
   AddExit( "norden", "./room_c5" );
   AddExit( "sueden", "./room_c3" );
   AddExit( "suedosten", "./room_b3" );

}

