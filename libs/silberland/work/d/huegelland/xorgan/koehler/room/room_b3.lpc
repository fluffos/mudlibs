// Xorgan@SilberLand
// KoehlerLager 
// 1999-06-26

#include "../def.h"

inherit "std/room";

int anz = 3;

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Der Koehlerweg" );
   SetProp( P_INT_LONG,
      "Du bist noch tiefer in den Wald vorgedrungen. Noch immer umgeben "
      "Dich gewaltige Baeume, Buesche und Farne. Der Boden ist mit "
      "Moos und Kraeutern bedeckt. Du kannst auch ein paar Pilze finden. "
      "Ueber Dir verdeckt ein dichtes Blaetterdach den Himmel. "
      "Der Pfad fuehrt nach Richtung Nordwesten weiter, wo der Wald lichter zu "
      "werden scheint." );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 17, ENV_TERRAIN: TT_FOREST]) );

   AddDetail( ({ "pfad" }),
      "Ein schmaler Weg. Man kann ihn bequem entlanglaufen. Nach Sueden "
      "gehts aus dem Wald heraus.");

   AddDetail( ({ "weg" }),
      "Ein Pfad auf dem man gehen, aber nicht fahren kann.");
   
   AddDetail( ({ "gehen" }),
      "Auf diesem Pfad kann man herrlich dahin wandern. Nur Fuhrwerk koennen "
      "ihn nicht befahren." );
      
   AddDetail( ({ "fahren" }),
      "Befahren kann man diesen schmalen Weg nicht, Du wirst schon zu Fuss "
      "weiter laufen muessen.");
   
   AddDetail( ({ "fuss", "fuesse" }),
      "Ich hoffe Du hast noch zwei davon. :)" );
   
   AddDetail( ({ "wald", "waelder" }),
      "Der Wald ist von unvergleichbarer Schoenheit. "
      "Unterschiedlichste Baeume, Buesche und Farne wachsen in natuerlicher "
      "Unregelmaessigkeit.");
   
   AddDetail( ({ "unregelmaessig", "zustand" }),
      "Wild durcheinander wachsen die verschiedensten Arten von Planzen. "
      "Der natuerliche Wettstreit der Arten um die Resoucen scheint diesen "
      "Zustand zu foerden. Es scheint als wuerden die Pflanzen um jeden "
      "Sonnenstrahl streiten.");
   
   AddDetail( ({ "wettstreit" }),
      "Das erklaert sich von selbst. Meinst nicht auch.");
      
   AddDetail( ({ "sonnenstrahl", "strahl" }),
      "Die wenigsten dringen durch das Blaetterdach. Vom Rest erreicht kaum "
      "einer den Boden.");
   
   AddDetail( ({ "baum", "baeume" }),
      "Es wachsen Eichen, Buchen, Tannen, Fichten und viele andere Arten im "
      "Wald.");
      
   AddDetail( ({ "eichen", "buchen", "tannen", "fichten", "eiche", "buche", "tanne", "fichte" }),
      "Ja. Es wachsen Baeume in einem Wald.");
   
   AddDetail( ({ "pflanzen", "pflanze", "pflanzenart", "arten", "art", "farne", 
                 "farn", "buesche", "busch" }),
      "Es gibt viele Arten von Pflanzen in einem Wald.");
   
   AddDetail( ({ "schoenheit", "schoen" }),
      ([0:"Der Wald ist unglaublich schoen.",
      "elf":"Der Wald ist von unglaublicher Schoenheit, die Dein Herz schneller "
         "schlagen laesst. Ein Wald ist einfach das Schoenste fuer einen Elf.",
      "zwerg":"Noch schoener waere der Wald, wenn man ihn mit einer Axt abholzt "
         "und dann aus dem ganzen Holz wieder neue Stiele fuer Aexte macht, um "
         "noch mehr Wald zu faellen. Ein schoener Kreislauf.",
      "fee":"Der Wald ist genauso schoen wie Du!",
      "oger":"Den Wald kann man doch nicht essen, wie kann der nur schoen sein?",
      "troll":"Was interessiert einen Troll an der Schoenheit eines Waldes? Nichts. Absolut "
         "nichts!",
      "dunkelelf":"Schwachsinn! Das kann doch nicht schoen sein, dafuer ist "
         "doch viel zu hell!"
      ]) );
   
   AddDetail( ({ "himmel" }),
      "Vor lauter Blaetter und Nadeln kann man den Himmel kaum erkennen." );
   
   AddDetail( ({ "dach", "blaetterdach" }),
      "Vor lauter Blaetter und Nadeln kann man den Himmel kaum erkennen. "
      "Einen seltsamen Nebel kannst Du hoch oben erkennen." );
   
   AddDetail( ({ "Blaetter", "Nadeln" }),
      "Die sind etwas weit oben, um sie naeher untersuchen zu koennen");
   
   AddDetail( ({ "boden", "waldboden" }),
      "Du stehst auf einen typischen Waldboden. Also eigentlich nichts "
      "Besonderes.");
   
   AddDetail( ({ "besonderes" }),
      "Abgesehen von dem typischen Waldboden, durch den sich von Grasbueschel "
      "begrenzt, der Pfad schlaengelt, kannst Du wirklich nichts Besonderes "
      "sehen.");
   
   AddDetail( ({"grasbueschel", "bueschel"}),
      "Waehrend Du diese Grasbueschel naeher betrachtest und Dir selbst die "
      "Frage stellst, was daran interessant sein koennte, fallen Dir ein paar "
      "seltsame Grashalme auf.");
   
   AddDetail( ({ "halme", "grashalme", "halm", "grashalm" }),
      "Eine ausgiebige Untersuchung bringt doch eine interessante Erkenntnis: "
      "Die Halme sind geknickt. Du hast den Verdacht, dass Etwas sich darin "
      "verbirgt!");
      
   
   AddDetail( ({ "untersuchung" }),
      "Eine sehr ausgiebige und detaillierte Untersuchung!");
   
   AddDetail( ({ "erkenntnis" }),
      "Sehr interessant!");
   
   AddDetail( ({ "verdacht" }),
      "Den wirst Du so schnell nicht wieder los!");
   
   AddDetail( ({ "etwas" }),
      "Eindeutig: Es muss sich in dem Grasbueschel etwas verbergen.");
   
   AddDetail( ({ "nebel" }),
      "Eine dichte Nebelschwade haengt in den Wipfeln.");
   
   AddDetail( ({ "wipfel" }),
      "Die Kronen der Baeume.");
   
   AddDetail( ({ "krone", "kronen" }),
      "Hmm.. Der obere Teil eines Baumes.");
   
   AddDetail( ({ "schwade", "nebelschwade" }),
      "So dunklen Nebel hast Du noch nicht gesehen. Vielleicht ist es Rauch.");
   
   AddDetail( ({ "rauch" }),
      "Ja. Nun bist Du sicher. Es ist definitiv Rauch.");
   
   AddDetail( ({ "pilze" }),
      "Du kannst ein paar Pilze sehen. Ob man diese Pilze essen kann, weisst "
      "Du nicht.");
   
   AddDetail( ({ "moos" }),
      "Eine spezielle wasserspeichernde Pflanzenart, die auch in Waeldern "
      "vorkommt.");
   
   AddDetail( ({ "kraeuter" }),
      "Naja. Vielleicht ist das eine kleine Uebertreibung. Also gut: Es sind "
      "Graeser.");
   
   AddDetail( ({ "graeser", "gras" }),
      "Rasen ist keiner zu sehen. Jedoch wachsen hier unterschiedlichste Arten "
      "von Graesern, wilden Blumen und anderen Dir unbekannten Pflanzen.");
   
   AddDetail( ({ "blumen", "blume" }),
      "Es gedeiht eine unglaubliche Vielfalt an wunderschoenen Blumen im Wald.");
   
   AddDetail( ({ "vielfalt" }),
      "Es gibt wirklich sehr viele verschieden Pflanzen im Wald.");
   
   AddDetail( ({ "rasen" }),
      "Abgesehen von der Tatsache, dass es in einem Wald sicher keinen Rasen "
      "gibt, stellt sich die Frage, was an einem nicht vorhanden Rasen so "
      "interessant ist...");
   
   AddDetail( ({ "teil", "frage", "tatsache", "uebertreibung" }),
      "Das ist doch nicht wirklich wichtig!");
   
   AddDetail( ({ "ferne" }),
      "Etwas weiter weg.");

   AddSmell( DEFAULT_SMELL,
      "Abgesehen von einem typischen wuerzigen Waldgeruch kannst Du noch etwas "
      "riechen.");

   AddSmell( ({ "geruch", "waldgeruch" }),
      "Der Wald riecht nach Pilzen, Harz und Kraeutern usw.");

   AddSmell( ({ "pilze", "harz" }),
      "Es riecht einfach gesagt nach Wald.");
   
   AddSmell( ({ "kraeuter" }),
      "Der wuerzige Geruch der dir auch schon in der Apotheke in Midas "
      "aufgefallen ist.");
   
   AddSmell( ({ "etwas" }),
      "Du kannst nicht genau sagen was es ist, aber es scheint von Nordwesten "
      "zu kommen.");

   AddSound( DEFAULT_SOUND,
      "Du lauschst den Geraeuschen eines Waldes und kannst nichts "
      "Ungewoehnliches hoeren.");

   AddSound( ({ "wald" }),
      "Wennst es schon so genau wissen willst: Du hoerst das Rauschen von "
      "Blaettern, Vogelgezwitscher und so weiter.");

   AddSound( ({ "vogelgezwitscher", "gezwitscher", "zwitschern", "rauschen" }),
      ([0:"Du hoerst das Rauschen der Blaetter unterbrochen vom froehlichen "
         "Zwitschern der Voegel dieses Waldes.",
      "elf":"Dir kommt der Gedanke: Kann es etwas schoeners geben, als einen "
         "wunderschoenen Wald in dem die Voeglein zwitschern und die Blaetter "
         "im Wind raschen? Du murmelst entzueckt nein und verwirfst diesen "
         "Gedanken.",
      "zwerg":"Uninteressant! Gezwitscher der Voegel und rauschen der Blaetter "
         "sind zu nichts zu gebrauchen. Eine schoene Maid und ein kuehles Bier "
         "waere da schon viel besser.",
      "fee":"Welch liebliche Melodie untermalt von Rauschen der Blaetter die "
         "Voeglein zwitschern!"
      ]) );
   
   AddCmd( ({"wuehle", "wuehl", "durchwuehle" "druchwuehl" }), "wuehle" );
   
   AddExit( "sueden", "./room_b2" );
   AddExit( "nordwesten", "./room_c4" );
}


reset()
{
   ::reset();
   anz = 3;
}


wuehle(string str )
{
   object ob;
   
   notify_fail( "Was willst Du durchwuehlen?\n" );
   if( str == "bueschel" || str == "in bueschel" || str == "grasbueschel" ||
      str == "in grasbueschel" )
   {
      if( anz )
      {
         write(BS("Du wuehlst in dem verdaechtigen Grasbueschel herum und "
            "findest ein Stueck Holzkohle.\n"));
         anz--;
         if( (ob=clone_object( OBJ + "hkohle.lpc" ))->move( TP ) != 1 )
         {
            ob->move(ENV(TP));
         }
      }
      else
      {
         write(BS("Du wuehlst in dem verdaechtigen Grasbueschel herum und "
            "stellst fest, dass Du Dich wohl geirrt hast, oder doch nicht?\n"));
      }
      say( TPN+" durchwuehlt ein Grasbueschel.\n");
      return 1;
   }
   return 0;
}

