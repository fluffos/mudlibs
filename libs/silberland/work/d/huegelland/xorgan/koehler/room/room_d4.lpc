// Xorgan@SilberLand
// KoehlerLager 
// 1999-06-26

#include "../def.h"

inherit "std/room";

void create() 
{

   ::create();

   SetProp( P_INT_SHORT, "Der brennende Meiler" );
   SetProp( P_INT_LONG,
      "Nun ist Dir klar von wo der Rauch kommt, der Dir vorher aufgefallen ist. "
      "Eine riesige Rauchschwade huellt einen gewaltigen Huegel, der sich "
      "unmittelbar vor Dir erhebt, ein. Aus einigen Loechern steigt stetig "
      "weisser beissender Rauch auf. Rund um den halbkugelfoermigen Huegel "
      "liegt Asche auf dem Boden. Von dem Haufen geht eine unglaubliche Hitze "
      "aus, die das Gras in der Naehe verbrannt hat. Im Norden breitet sich der "
      "undurchdringliche Wald aus." );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 28, ENV_TERRAIN: TT_FOREST]) );
   
   AddDetail( ({ "rauch", "rauchschwade", "schwade" }),
      "Der Rauch ist unglaublich beissend und stickig. Er nimmt Dir die Luft. "
      "Du kannst kaum noch Atmen. Mit jedem Atemzug kannst Du foermlich "
      "fuehlen, wie Deine Sinne schwinden.");

   AddDetail( ({ "luft" }),
      "Die Luft ist erfuellt von Rauch. Deine Augen brennen und beginnen zu "
      "traenen. Wie lange kannst Du das noch aushalten!?");

   AddDetail( ({ "auge", "augen", "gesicht", "wangen" }),
      "Erste Traenen laufen Dir ueber das Gesicht. Dieser Rauch macht Dich "
      "fertig.");

   AddDetail( ({ "traene", "traenen" }),
      "Sie laufen Dir die Wangen hinunter.");

   AddDetail( ({ "atem", "atmen" }),
      "Das Atmen faellt Dir immer schwerer. Mit jeden Atemzug schwinden Dir die "
      "Sinne.");

   AddDetail( ({ "sinne", "sinn" }),
      "Du kannst kaum noch was sehen. Auch Dein Gleichgewichtssinn scheint "
      "nicht mehr richtig zu funktionieren. Es scheint Dir als wuerdest Du "
      "taumeln.");

   AddDetail( ({ "gleichgewichtssinn" }),
      "Ups! Dir ist wirklich schwindlig! Pass auf dass Du nicht hin faellst!");

   AddDetail( ({ "atemzug" }),
      "Jeder Atemzug loest ein heftiges Brennen in Deinen Atemwegen, fast immer "
      "gefolgt von einem Hustenanfall hervor.");

   AddDetail( ({ "brennen", "atemwege", "lungen" }),
      "Dein Lungen schmerzen schon fuerchterlich.");

   AddDetail( ({ "hustenanfall", "anfall" }),
      "Du hustest ja schon fast nur mehr. Vielleicht solltest Du den Ort "
      "verlassen.");

   AddDetail( ({ "huegel" }),
      "Der Huegel hat einen Durchmesser von mehreren Metern und besteht aus "
      "Erde.");

   AddDetail( ({ "erde" }),
      "Die Erde ist heiss. Der Haufen scheint nicht vollstaendig aus Erde zu "
      "bestehen.");

   AddDetail( ({ "haufen" }),
      "Aussen ist der Haufen mit Erde bedeckt. Aus einigen Loechern steigt "
      "beissender Rauch auf. Im Inneren muss sich wohl ein brennbares Material "
      "befinden.");

   AddDetail( ({ "innen", "inneren", "inneres" }),
      "Da kannst schlecht hineinschaun. Aber Du kannst Dir denken, dass da "
      "brennbares Material drinnen ist.");

   AddDetail( ({ "material" }),
      "Um das herausfinden zu koennen, musst Du schon in den Haufen "
      "hineingraben. Ob das nicht gefaehrlich ist?");

   AddDetail( ({ "loecher" }),
      "Aus ihnen tritt Rauch aus. Du kannst sie kaum erkennen.");

   AddDetail( ({ "hitze" }),
      "In der Naehe der Haufens ist es ganz schoen heiss. Du solltest nicht "
      "naeher hin gehen.");

   AddDetail( ({ "naehe" }),
      "Du solltest wirklich nicht naeher hin gehen!");

   AddDetail( ({ "asche" }),
      "Es ist eine seltsame schwarze Asche. Bei genauerem hinsehen, glaubst Du "
      "Kohle zu erkennen.");

   AddDetail( ({ "kohle", "stueck" }),
      "Du nimmst ein Stueck, zerreibst es zwischen den Fingern und stellt fest, "
      "dass es sich um Holzkohle handelt.");

   AddDetail( ({ "finger" }),
      "Von ein wenig Kohle werden Deine Finger schon nicht schmutzig.");

   AddDetail( ({ "holzkohle" }),
      "Es ist eindeutig Holzkohle! Nun wird Dir auch klar, was das fuer ein "
      "seltsamer Haufen ist. Es ist ein brennender Meiler!");

   AddDetail( ({ "meiler" }),
      "Ein Meiler wird von Koehlern aufgeschlichtet. Er besteht aus Holz, das "
      "von Erde bedeckt und dann entzuendet wird. Unter Luftabschluss entsteht "
      "nach etlicher Zeit Holzkohle." );

   AddDetail( ({ "koehler" }),
      "Koehler machen aus Holz Kohle.");

   AddDetail( ({ "holz" }),
      "Es wird sich um Holz aus dem Wald handeln.");

   AddDetail( ({ "lichtung" }),
      "Auf der befindest Du Dich.");

   AddDetail( ({ "luftabschluss", "sauerstoff", "element" }),
      "In Chemie nicht aufgepasst! Was?");

   AddDetail( ({ "chemie" }),
      "Durch die beinahe sauerstofflose Verbrennung (Oxydation), mit der eine "
      "Reduktion vom im Holz enthaltenen Wasser einhergeht, entsteht in einem "
      "langsamen Prozess aus Holz Holzkohle.");
   
   AddDetail( ({ "verbrennung", "oxydation" }),
      "In der Chemie wird Verbrennung als Oxydation bezeichnet, da sich ein "
      "chemisches Element mit Sauerstoff verbindet.");
   
   AddDetail( ({ "reduktion" }),
      "Das Wasser wird weniger. Es verdunstet!");
   
   AddDetail( ({ "zeit" }),
      "Du hast absolut keine Ahnung wie lange es dauern kann.");

   AddDetail( ({ "ahnung" }),
      "Von dem hast Du wirklich keine Ahnung.");

   AddDetail( ({ "boden", "platz" }),
      "Der Boden ist, abgesehen von dem Platz um den Huegel von Gras bedeckt.");

   AddDetail( ({ "gras" }),
      "Das Gras ist schoen gruen. Nur rund um den Huegel ist es verbrannt.");

   AddDetail( ({ "himmel" }),
      "Den kannst Du vor lauter Rauch nicht sehen!");

   AddSmell( DEFAULT_SMELL,
      "Es stinkt extrem nach Rauch. Deine Lungen brennen fuerchterlich.");

   AddSmell( ({ "rauch" }),
      "Fuerchterlich!! Lange wirst Du das nicht aushalten.");

   AddDetail( ({ "wald" }),
      "Im Westen kannst Du den Wald in all seiner Pracht sehen. Maechtige "
      "Eichen und Buchen wachsen zwischen Straeuchern und anderen Pflanzen.");

   AddDetail( ({ "eichen", "buchen" }),
      "Ja. Es wachsen Baeume in einem Wald.");
   
   AddDetail( ({ "pflanzen", "pflanzenart", "arten", "art", "farne", "straeucher" }),
      "Es gibt viele Arten von Pflanzen in einem Wald.");
   
   AddDetail( ({ "schoenheit", "schoen", "schoenste" }),
      ([0:"Der Wald ist unglaublich schoen.",
      "elf":"Der Wald ist von unglaublicher Schoenheit, die Dein Herz schneller "
         "schlagen laesst. Ein Wald ist einfach das Schoenste fuer einen Elf.",
      "zwerg":"Noch schoener waere der Wald, wenn man ihn mit einer Axt abholzt "
         "und dann aus dem ganzen Holz wieder neue Stiele fuer Aexte macht, um "
         "noch mehr Wald zu faellen. Ein schoener Kreislauf.",
      "fee":"Der Wald ist genauso schoen wie Du!",
      "oger":"Den Wald kann man doch nicht essen, wie kann der nur schoen sein?",
      "troll":"Was interessiert einen Troll an der Schoenheit eines Waldes? "
         "Nichts. Absolut nichts!",
      "dunkelelf":"Schwachsinn! Das kann doch nicht schoen sein, dafuer ist "
         "doch viel zu hell!"
      ]) );
   
   AddDetail( ({ "baeume" }),
      "Grosse maechtige Eichen und Buchen wachsen westlich von Dir.");

   AddCmd( ({ "grabe","grab" }), "grabe" );

   AddExit( "sueden", "./room_d3" );
   AddExit( "osten", "./room_c4" );
}

grabe(string str )
{
   
   notify_fail( "Mit was moechtest Du in was graben?\n" );
   if(str == "mit haenden in haufen" ||
      str == "mit haenden in huegel")
   {
      write("Du beginnst mit blossen Haenden ein Loch in den Haufen zu graben...\n");
      say(TPN + " beginnt mit blossen Haenden ein Loch in den Haufen zu graben.\n");
      schaden(50,30);
      return 1;
   }
   if(str == "mit schaufel in huegel" ||
      str == "mit schaufel in haufen" )
   {
      if(present("schaufel", TP ))
      {
         write("Du beginnst mit der Schaufel ein Loch in den Haufen zu graben...\n");
         say(TPN + " beginnt mit einer Schaufel ein Loch in den Haufen zu graben.\n");
         
         schaden(80,10);
         return 1;
      }
      else
      {
         write("Du hast ja keine Schaufel dabei!\n");
         return 1;
      }
   }
   return 0;
}

schaden( int chance, int sch )
{
   TP->SetProp(P_PARALYZED, ([
      PARALYZE_TIME:-1, 
      PARALYZE_MSG: "Du bist mit graben beschaeftigt!\n",
      PARALYZE_END: "",
      PARALYZE_END_OTHER: ""]));
   
   call_out("graben1",5, chance, sch);
   
}


graben1(int chance, int sch)
{
   write("Du graebst tiefer in der Schicht aus Erde...\n\n");
   say(TPN + " graebt in der Schicht aus Erde.\n");
   call_out("graben2",5, chance, sch);
}

graben2(int chance, int sch)
{
   write("...und tiefer...\n\n");
   say(TPN + " graebt noch tiefer in den Huegel.\n");
   call_out("flamme",5, chance, sch);
}

flamme( int chance, int sch )
{
   
   write("Ploetzlich ist ein lautes Zischen zu hoeren.\n\n");
   say("Ploetzlich ist ein lautes Zischen zu hoeren.\n");
   
   TP->SetProp(P_PARALYZED, ([
      PARALYZE_TIME:20, 
      PARALYZE_MSG: "Du bist bewusstlos!\n",
      PARALYZE_END: "Du kommst wieder zu Dir.\n",
      PARALYZE_END_OTHER: "%s kommt wieder zu sich.\n"]));
   
   write("Eine gewaltige Stichflamme schiesst auf Dich zu und schleudert Dich zu "
      "Boden.\n\n");
   say("Auf " + TPN + " scheisst eine gewaltige Stichflamme zu und schleudert " 
      + TPN + " zu Boden,\n");
   
   SetProp(P_KILL_NAME, "Eine Stichflamme");
   
   if(random(100) >= chance)
   {
      write( "WAAAHHHHH!!!! Dein Kleidung steht in Flammen! DU BRENNST!!!\n");
      TP->do_damage(30 + random(sch));
   }
   else
   {
      write( "WAAAHHHHH!!!! Deine Kleidung beginnt zu brennen!\n");
      TP->do_damage(10 + random(sch));
   }
   write("Dir schwinden die Sinne!\n");
   say(TPN + " bleibt bewusstlos am Boden liegen.\n");
}

