// KoehlerLager 
// 1999-06-26

#include "../def.h"

inherit MYREGION "quest_room";

void create()
{

   ::create();

   SetProp( P_INT_SHORT, "Zentrum der Lichtung" );
   SetProp( P_INT_LONG,
      "Du befindest Dich im Zentrum der Lichtung. Abgesehen von nackter Erde "
      "kannst Du vereinzelt Grasbueschel entdecken. In der Mitte des Platzes "
      "erkennst Du einen grossen schwarzen Fleck am Boden. Einige Schritte in "
      "Richtung Osten befindet sich ein etwa 1 Meter hoher laenglicher Huegel. "
      "Im Westen kannst Du einen Haufen erkennen.");
   
   SetProp( P_LIGHT, 2 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

   AddDetail( ({ "schritte", "schritt", "meter" }),
      "Ein paar Meter!");
   
   AddDetail( ({ "zentrum", "platz" }),
      "Rund um das Zentrum breitet sich die Lichtung aus.");

   AddDetail( ({ "lichtung" }),
      "Auf der befindest Du Dich.");

   AddDetail( ({ "wald" }),
      "Der ist ausserhalb der Lichtung.");

   AddDetail( ({ "erde" }),
      "Wie ueberall auf der Lichtung ist die Erde staubig und braun.");

   AddDetail( ({ "bueschel", "gras", "grasbueschel" }),
      "An einigen Stellen waechst ein wenig Gras.");

   AddDetail( ({ "stellen", "stelle" }),
      "An denen wird das Gras nicht gleich von den arbeitenden Koehlern "
      "zertrampelt.");

   AddDetail( ({ "koehler" }),
      "Koehler machen aus Holz Kohle.");

   AddDetail( ({ "holz" }),
      "Es wird sich um Holz aus dem Wald zu handeln.");

   AddDetail( ({ "holzkohle", "kohle" }),
      "Sie machen Holzkohle. Kannst es glauben.");

   AddDetail( ({ "boden" }),
      "Der Boden besteht aus Erde. Vereinzelt waechst etwas Gras. In der Mitte "
      "des Platzes faellt Dir ein grosser schwarzer Fleck auf.");

   AddDetail( ({ "mitte" }),
      "Der Fleck befindet sich tatsaechlich in der Mitte.");

   AddDetail( ({ "durchmesser" }),
      "So genau kannst den nicht abschaetzen aber 3 Meter werden es schon sein.");

   AddDetail( ({ "farbe", "schwarz" }),
      "Schwarz!");

   AddDetail( ({ "staub", "russ", "kohlenstaub" }),
      "Eindeutig Russ und Kohlenstaub.");

   AddDetail( ({ "himmel" }),
      "Am wolkenlosen und daher strahlend blauen Himmel brennt die Sonne auf "
      "Dich herunter. Einfach gesagt: ein toller Tag.");

   AddDetail( ({ "sonne" }),
      "Sie strahlt am wolkenlosen Himmel.");

   AddDetail( ({ "haufen" }),
      "Im Westen ist ein seltsamer Haufen.");

   AddDetail( ({ "huegel", "erdhuegel" }),
      "Der laengliche Erdhuegel ist mit Sicherheit kuenstlich aufgeschuettet "
      "worden und versperrt Dir die Sicht. Vielleicht solltest Du das aendern.");

   AddSpecialDetail( ({ "fleck", "flaeche" }), "Fleck" );
   AddSpecialDetail( ({ "meiler" }), "Meiler" );

   AddItem( NPC + "meister.lpc" , REFRESH_DESTRUCT);
   AddItem( NPC + "lehrling.lpc" , REFRESH_DESTRUCT);
   
   AddCmd( ({ "klettere", "kletter" }), "klettere" );

   AddExit( "westen", "./room_d3" );
   AddExit( "norden", "./room_c4" );
   AddExit( "sueden", "./room_c2" );
}


string Fleck( string key )
{
   object ob;
   string text;
   
   text = "Der Fleck ist beinahe kreisrund und hat mehrere Meter Durchmesser. "
      + "Seine schwarze Farbe hat er nicht nur von dem Staub, sondern in der "
      + "Flaeche scheint die Erde verbrannt zu sein. ";
   
   ob = present( "koehler_quest", TP );
   if( ob )
   {
      switch( ob->GetState() )
      {
         case 0:
            text = text + "Da sollst Du wohl den Meiler hin bauen.\n";
            break;
         case 1:
            text = text + "Du hast dein Zunder in die Flaeche gelegt.\n";
            break;
         case 2:
            text = text + "In der Flaeche hast Du einen schoenen Haufen "
               +  "Scheiter aufgeschlichtet.\n";
            break;
         case 3:
            text = text + "In der Flaeche hast Du einen Meiler errichtet.\n";
            break;
         case 4:
            text = text + "In der Flaeche hast Du einen Meiler errichtet, den "
               + "Du bereits angezuendet hast.\n";
            break;
         case 5:
            text = text + "In der Flaeche steht Dein brennender Meiler, in den "
               + "Du, damit er nicht ausgeht, Loecher gemacht hast.\n";
            break;
      }
   }
   return BS( text );
}


string Meiler( string key )
{
   object ob;
   string text;
   
   text = "In der Flaeche steht kein Meiler.\n";
   
   ob = present( "koehler_quest", TP );
   if( ob )
   {
      switch( ob->GetState() )
      {
         case 3:
            text = "In der Flaeche hast Du einen Meiler errichtet.\n";
            break;
         case 4:
            text = "In der Flaeche hast Du einen Meiler errichtet, den "
               + "Du bereits angezuendet hast.\n";
            break;
         case 5:
            text = "In der Flaeche steht Dein brennender Meiler, in den "
               + "Du, damit er nicht ausgeht, Loecher gemacht hast.\n";
            break;
         default:
            break;
      }
   }
   return BS( text );
}


klettere(string str )
{
   object ob;
   
   notify_fail( "Worauf willst Du klettern?\n" );
   if( str == "auf erdhuegel" || str == "erdhuegel" || str == "huegel" || str == "auf huegel")
   {
      if( present("koehler_quest", TP) && !present( "koehler_schaufel", TP )
         && !CheckPlayer( TP->query_real_name()) )
      {
         write( BS( "Du kletterst auf den Erdhuegel. Du hast nun eine tollen "
            "Blick auf den Wald und das Lager. Als Dir auf der Rueckseite des "
            "Huegels ein Stiel auffaellt. Du ziehst an ihm und entdeckst eine "
            "Schaufel.\n"));
         
         if( (ob=clone_object( OBJ + "kschaufel.lpc" ))->move(TP) == 1 )
         {
            write("Du nimmst sie sofort an Dich.\n");
            SetPlayer( TP->query_real_name(), 1 );
         }
         else
         {
            write( "Du kannst sie leider nicht mehr tragen!\n");
            ob->remove();
         }
      }
      else
      {
         write( BS("Du kletterst auf den Erdhuegel. Du hast nun eine tollen "
            "Blick auf den Wald und das Lager. Nachdem Du alles genau "
            "betrachtet hast, steigst Du wieder runter.\n" ));
      }
      say( TPN + " klettert auf den Erdhuegel, schaut sich um und steigt wieder "
         "runter.\n");
      return 1;
   }
   return 0;
}

