// Xorgan@SilberLand
// KoehlerLager 
// 1999-06-26

#include "../def.h"

inherit MYREGION "quest_room";

void create()
{

   ::create();

   SetProp( P_INT_SHORT, "Der Meiler" );
   SetProp( P_INT_LONG,
      "Du befindest Dich auf einer Wiese im suedlichen Teil der Lichtung. "
      "Vor Dir erhebt sich ein grosser Haufen von Holzscheiten, der teilweise "
      "mit Erde zugeschuettet ist. Rund um den Haufen ist die Erde umgegraben "
      "und mit Asche bedeckt. Weiter im Westen breitet sich der "
      "undurchdringliche Wald aus. Gewaltige Baeume wachsen am Rand der "
      "Lichtung. Hohes Buschwerk macht ein Durchkommen unmoeglich.");
   SetProp( P_LIGHT, 2 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );


   AddDetail( ({ "wiese" }),
      "Graeser und Blumen wachsen hier wild durcheinander. Nur um den Haufen "
      "sind alle Pflanzen entfernt worden.");

   AddDetail( ({ "graeser" }),
      "Viele verschieden Arten von Gras wachsen hier.");

   AddDetail( ({ "blumen" }),
      "Unmengen von Blumen mit wunderschoenen Blueten findest Du.");

   AddDetail( ({ "durchkommen" }),
      "Es ist unmoeglich.");

   AddDetail( ({ "blueten" }),
      "In allen moeglichen Farben bluehen die Blumen.");

   AddDetail( ({ "farben" }),
      "Rot, gelb, blau, weiss, und viele andere.");

   AddDetail( ({ "teil" }),
      "Der hier ist im Sueden der Lichtung.");

   AddDetail( ({ "haufen", "ende" }),
      "Es wurden hunderte von ungefaehr ein Meter langen Scheiter "
      "aufgeschlichtet und teilweise mit Erde bedeckt. An einem Ende der "
      "Haufens ragt etwas Zunder heraus. Die Arbeit an dem Haufen scheint noch "
      "nicht beendet zu sein.");

   AddDetail( ({ "zunder", "aeste", "heu" }),
      "Trockenes Heu und kleine Aeste. Zunder halt.");

   AddDetail( ({ "scheit", "scheiter", "holzscheiter" , "holzscheiten"}),
      "Es sind etwa ein Meter lange Holzstuecke. Es mussen hunderte zu diesem "
      "Haufen aufgeschlichtet worden sein.");

   AddDetail( ({ "stueck", "stuecke", "holzstuecke" }),
      "Es ist nur Holz von Eichen und Buchen verwendet worden.");

   AddDetail( ({ "holz" }),
      "Es wird sich um Holz aus dem Wald zu handeln.");

   AddDetail( ({ "wald" }),
      "Im Westen kannst Du den Wald in all seiner Pracht sehen. Maechtige "
      "Eichen und Buchen wachsen zwischen Straeuchern und anderen Pflanzen.");

   AddDetail( ({ "eichen", "buchen" }),
      "Ja. Diese Baeume wachsen im Wald.");
   
   AddDetail( ({ "pflanzen", "pflanzenart", "arten", "art", "farne", "straeucher" }),
      "Es gibt viele Arten von Pflanzen in einem Wald.");
   
   AddDetail( ({ "schoenheit", "schoen", "schoenste" }),
      ([0:"Der Wald ist unglaublich schoen.",
      "elf":"Der Wald ist von unglaublicher Schoenheit, die Dein Herz schneller "
         "schlagen laesst. Ein Wald ist einfach das Schoenste fuer einen Elf.",
      "zwerg":"Noch schoener waere der Wald, wenn man ihn mit einer Axt abholzt "
         "und dann aus dem ganzen Holz wieder neue Stiele fuer Aexte macht, um "
         "noch mehr Wald zu faellen. Ein schoener Kreislauf.",
      "fee":"Der Wald ist genauso schoen wie Du!",
      "oger":"Den Wald kann man doch nicht essen, wie kann der nur schoen sein?",
      "troll":"Was interessiert einen Troll an der Schoenheit eines Waldes? "
         "Nichts. Absolut nichts!",
      "dunkelelf":"Schwachsinn! Das kann doch nicht schoen sein, dafuer ist "
         "doch viel zu hell!"
      ]) );
   
   AddDetail( ({ "erde" }),
      "Wie ueberall auf der Lichtung ist die Erde staubig und braun.");

   AddDetail( ({ "boden", "platz" }),
      "Der Boden ist, abgesehen von dem Platz um den Haufen von Gras bedeckt.");

   AddDetail( ({ "gras" }),
      "Das Gras ist schoen gruen. Nur rund um den Haufen ist es entfernt "
      "worden.");

   AddDetail( ({ "asche" }),
      "Es ist eine seltsame schwarze Asche. Bei genauerem Hinsehen glaubst Du, "
      "Kohle zu erkennen.");

   AddDetail( ({ "kohle", "stueck" }),
      "Du nimmst ein Stueck, zerreibst es zwischen den Fingern und stellt fest, "
      "dass es sich um Holzkohle handelt.");

   AddDetail( ({ "finger" }),
      "Von ein wenig Kohle werden Deine Finger schon nicht schmutzig.");

   AddDetail( ({ "holzkohle" }),
      "Es ist eindeutig Holzkohle!");

   AddDetail( ({ "baeume" }),
      "Grosse maechtige Eichen und Buchen wachsen westlich von Dir.");

   AddDetail( ({ "rand" }),
      "Am westlichen Rand beginnt der Wald.");

   AddDetail( ({ "meiler" }),
      "Ein Meiler wird von Koehler aufgeschlichtet. Er besteht aus Holz, das "
      "von Erde bedeckt und dann entzuendet wird. Unter Luftabschluss entsteht "
      "nach etlicher Zeit Holzkohle." );

   AddDetail( ({ "koehler" }),
      "Koehler machen aus Holz Kohle.");

   AddDetail( ({ "lichtung" }),
      "Auf der befindest Du Dich.");

   AddDetail( ({ "luftabschluss", "sauerstoff", "element" }),
      "In Chemie nicht aufgepasst! Was?");

   AddDetail( ({ "chemie" }),
      "Durch die beinahe sauerstofflose Verbrennung (Oxydation), mit der eine "
      "Reduktion vom im Holz enthaltenen Wasser einhergeht, entsteht in einem "
      "langsamen Prozess aus Holz Holzkohle.");
   
   AddDetail( ({ "verbrennung", "oxydation" }),
      "In der Chemie wird Verbrennung als Oxydation bezeichnet, da sich ein "
      "chemisches Element mit Sauerstoff verbindet.");
   
   AddDetail( ({ "reduktion" }),
      "Das Wasser wird weniger. Es verdunstet!");
   
   AddDetail( ({ "zeit" }),
      "Du hast absolut keine Ahnung wie lange es dauern kann.");

   AddDetail( ({ "ahnung" }),
      "Von dem hast Du wirklich keine Ahnung.");

   AddDetail( ({ "himmel" }),
      "Am wolkenlosen und daher strahlend blauen Himmel brennt die Sonne auf "
      "Dich herunter. Einfach gesagt: ein toller Tag.");

   AddDetail( ({ "sonne" }),
      "Sie strahlt am wolkenlosen Himmel.");

   AddDetail( ({ "buschwerk" }),
      "Alle moeglichen Straeucher wachsen zwischen den Baeumen.");

   AddDetail( ({ "straeucher" }),
      "In verschiedenen Formen und Groessen draengen sich die Straeucher dicht "
      "an dicht zwischen den Baeumen. Einer der Straeucher ist vertrocknet.");

   AddDetail( ({ "strauch" }),
      "Dieser eine Strauch ist abgestorben. Jeder Ast ist total trocken.");

   AddDetail( ({ "ast" }),
      "Die Aeste des Busches sind trocken wie Zunder und wuerden sicher gut "
      "brennen.");

   AddDetail( ({ "busch" }),
      "Der Busch ist mit Sicherheit tolles Zunder. Damit kann man leicht ein "
      "Feuer entfachen. Moechtest Du etwas davon sammeln?");

   AddDetail( ({ "sicherheit" }),
      "Es ist sicher bestes Zunder.");

   AddDetail( ({ "formen", "form" }),
      "Die Straeucher wachsen in unterschiedliche unregelmaessige Formen.");

   AddDetail( ({ "groessen", "groesse" }),
      "Von sehr klein bis ganz gross.");


   AddCmd( ({ "sammle", "sammel" }), "sammle" );

   AddItem( NPC + "geselle.lpc" , REFRESH_DESTRUCT);
   AddItem( NPC + "mgeselle.lpc" , REFRESH_DESTRUCT);

   AddExit( "norden", "./room_d3" );
   AddExit( "osten", "./room_c2" );
}


sammle(string str )
{
   object ob;
   
   notify_fail( "Was willst sammeln?\n" );
   if(str == "zunder" )
   {
      if(present("koehler_quest", TP ) && !present("koehler_zunder", TP )
         && !CheckPlayer( TP->query_real_name()))
      {
         if( (ob=clone_object(OBJ + "kzunder.lpc"))->move(TP) == 1 )
         {
            write( BS( "Du brichst einige kleinere Aeste von dem vertrockneten "
               "Busch.\nDu reisst trockenes Gras aus und sammelst einige "
               "Blaetter.\nSchon nach kurzer Zeit hast Du super Zunder "
               "gesammelt.\n" ));
            say( TPN+" sammelt Zunder.\n");
            
            SetPlayer( TP->query_real_name(), 1 );
         }
         else
         {
            write( "Du kannst es leider nicht mehr tragen!\n");
            ob->move(ENV(TP));
         }
      }
      else
         write("Was willst Du mit noch mehr Zunder, kannst es ja doch nicht "
            "brauchen!\n");
      
      return 1;
   }
   return 0;
}
