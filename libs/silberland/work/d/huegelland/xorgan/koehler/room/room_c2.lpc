// Xorgan@SilberLand
// KoehlerLager 
// 1999-06-26

#include "../def.h"

inherit "std/room";

void create()
{

   ::create();

   SetProp( P_INT_SHORT, "Suedliche Lichtung" );
   SetProp( P_INT_LONG,
      "Du betrittst den suedlichen Teil der Lichtung. Hier sieht es schon mehr "
      "nach einer Lichtung im Wald aus. Zwischen den ausgetretenen Wegen "
      "wachsen sogar einige kleine Buesche. Im Sueden kannst Du ein Zelt sehen. "
      "Im Suedwesten steht eine kleine Huette. Westlich von Dir schlichtet ein "
      "Arbeiter einen weiteren Haufen auf."
      );
   SetProp( P_LIGHT, 2 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

   AddDetail( ({ "teil" }),
      "In diesem Teil, der suedlich von Zentrum der Lichtung liegt, befinden "
      "sich die Unterkuenfte der Arbeiter.");

   AddDetail( ({ "zentrum" }),
      "Das ist noerdlich von Dir.");

   AddDetail( ({ "lichtung" }),
      "Auf der befindest Du Dich.");

   AddDetail( ({ "unterkuenfte" }),
      "Die Unterkunft der Arbeiter ist ein Zelt, das sich suedlich von hier "
      "befindet. Der Koehlermeister bewohnt eine kleine Holzhuette." );

   AddDetail( ({ "unterkunft" }),
      "Den Arbeitern dient ein Zelt als Unterkunft.");

   AddDetail( ({ "arbeiter" }),
      "Die werden wohl alle arbeiten.");

   AddDetail( ({ "zelt" }),
      "Da musst Du schon naeher hin gehen.");

   AddDetail( ({ "wald" }),
      "Der ist ausserhalb der Lichtung.");

   AddDetail( ({ "wege" }),
      "Einige schmale Wege laufen in verschieden Richtungen.");

   AddDetail( ({ "koehlermeister", "meister" }),
      "Den siehst Du nicht. Er geht sicher seiner Arbeit nach.");

   AddDetail( ({ "arbeit" }),
      "Er beaufsichtigt sicher gerade die Arbeiter.");

   AddDetail( ({ "huette", "holzhuette" }),
      "Die Huette befindet sich suedwestlich von hier. Sie wurde aus Holz "
      "erbaut. Du kannst sie sicher betreten.");

   AddDetail( ({ "buesche" }),
      "Ein paar kleine Buesche wachsen neben Gras aus der trockenen Erde.");

   AddDetail( ({ "erde" }),
      "Wie ueberall auf der Lichtung ist die Erde staubig und braun.");

   AddDetail( ({ "zelt" }),
      "Ein grosses Zelt aus Segeltuch steht suedlich von Dir. Es ist zu weit "
      "weg um genaueres sehen zu koennen.");

   AddDetail( ({ "segeltuch", "tuch" }),
      "Ein besonders widerstandsfaehiger Stoff.");

   AddDetail( ({ "stoff" }),
      "Dazu wirst Du wohl einen Tuchmacher fragen mussen. Nur hier wirst Du "
      "keinen finden.");

   AddDetail( ({ "tuchmacher" }),
      "Es ist keiner da.");

   AddDetail( ({ "himmel" }),
      "Am wolkenlosen und daher strahlend blauen Himmel brennt die Sonne auf "
      "Dich herunter. Einfach gesagt: ein toller Tag.");

   AddDetail( ({ "sonne" }),
      "Sie strahlt am wolkenlosen Himmel.");

   AddDetail( ({ "bueschel", "gras", "grasbueschel" }),
      "An einigen Stellen waechst ein wenig Gras.");

   AddDetail( ({ "stellen" }),
      "An denen wird das Gras nicht gleich von den arbeitenden Koehlern "
      "zertrampelt.");

   AddDetail( ({ "koehler" }),
      "Koehler machen aus Holz Kohle.");

   AddDetail( ({ "holz" }),
      "Es wird sich um Holz aus dem Wald zu handeln.");

   AddDetail( ({ "holzkohle", "kohle" }),
      "Sie machen Holzkohle. Kannst es glauben.");

   AddDetail( ({ "boden" }),
      "Der Boden ist schon etwas mehr bewachsen als im Zentrum. Hier wachsen "
      "sogar einige kleine Buesche neben ausgetreten Wegen." );

   AddDetail( ({ "haufen" }),
      "Im Westen ist ein seltsamer Haufen.");

   AddExit( "westen", "./room_d2" );
   AddExit( "norden", "./room_c3" );
   AddExit( "sueden", "./room_c1" );
   AddExit( "huette", "in die Huette#./room_d1" );
}


