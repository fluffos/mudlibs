// Xorgan@SilberLand
// KoehlerLager 
// 1999-06-26

#include "../def.h"

inherit "std/room";

void create()
{

   ::create();

   SetProp( P_INT_SHORT, "Der Koehlerweg" );
   SetProp( P_INT_LONG,
      "Schon nach wenigen Schritten stehst Du mitten im Wald. "
      "Baeume, Buesche und Farne so weit das Auge reicht. Der Boden ist mit "
      "Moos und Kraeutern bedeckt. Du kannst auch ein paar Pilze finden. "
      "Der Weg laeuft zwischen ein paar Baeumen durch und knickt dann Richtung "
      "Nordwesten ab. "
      "Hoch oben auf einer Eiche befindet sich ein schoenes Baumhaus."   );
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_FOREST]) );

   AddDetail( ({"eiche", "haus", "baumhaus"}),
      "Hoch oben auf einer Eiche befindet sich ein schoenes Baumhaus. Sicher "
      "kannst Du hinaufklettern.");
   AddDetail( ({ "schritte", "schritt", "meter" }),
      "Ein paar Meter!");
   
   AddDetail( ({ "pfad" }),
       "Ein schmaler Weg. Man kann ihn bequem entlanglaufen. Nach Nordwesten "
      "geht es tiefer in den Wald hinein.");

   AddDetail( ({ "weg" }),
      "Ein Pfad auf dem man gehen, aber nicht fahren kann.");
   
   AddDetail( ({ "gehen" }),
      "Auf diesem Pfad kann man herrlich dahin wandern. Nur Fuhrwerke koennen "
      "ihn nicht befahren." );
      
   AddDetail( ({ "fahren" }),
      "Befahren kann man diesen schmalen Weg nicht, Du wirst schon zu Fuss "
      "weiter laufen muessen.");
   
   AddDetail( ({ "fuss", "fuesse" }),
      "Ich hoffe Du hast noch zwei davon. :)" );
   
   AddDetail( ({ "wald", "waelder" }),
      "Der Wald ist von unvergleichbarer Schoenheit. "
      "Unterschiedlichste Baeume, Buesche und Farne wachsen in natuerlicher "
      "Unregelmaessigkeit.");
   
   AddDetail( ({ "baum", "baeume" }),
      "Es wachsen Eichen, Buchen, Tannen, Fichten und viele andere Arten im "
      "Wald.");
      
   AddDetail( ({ "eichen", "buchen", "tannen", "fichten", "buche", "tanne", "fichte" }),
      "Ja. Es wachsen Baeume in einem Wald.");
   
   AddDetail( ({ "pflanze", "pflanzen", "pflanzenart", "arten", "art", "farne", "farn", "buesche", "busch" }),
      "Es gibt viele Arten von Pflanzen in einem Wald.");
   
   AddDetail( ({ "schoenheit", "schoen" }),
      "Der Wald ist unglaublich schoen.");

   AddDetail( ({ "himmel" }),
      "Vor lauter Blaetter und Nadeln kann man den Himmel kaum erkennen.");
   
   AddDetail( ({ "blaetter", "nadeln" }),
      "Die sind etwas weit oben, um sie naeher untersuchen zu koennen.");
   
   AddDetail( ({ "boden", "waldboden" }),
      "Du stehst auf einen typischen Waldboden. Er ist mit Moos und Kraeutern "
      "bedeckt. Selbst Pilze kannst Du entdecken. Aber eigentlich nichts "
      "Besonderes.");
   
   AddDetail( ({ "pilze", "pilz" }),
      "Du kannst ein paar Pilze sehen. Ob man diese Pilze essen kann, weisst "
      "Du nicht.");
   
   AddDetail( ({ "moos" }),
      "Eine spezielle, wasserspeichernde Pflanze, die auch in Waeldern "
      "vorkommt.");
   
   AddDetail( ({ "kraeuter", "kraut" }),
      "Naja. Vielleicht ist das eine kleine Uebertreibung. Also gut: Es sind "
      "Graeser.");
   
   AddDetail( ({ "graeser", "gras" }),
      "Rasen ist keiner zu sehen. Jedoch wachsen hier unterschiedlichste Arten "
      "von Graesern, wilden Blumen und anderen Dir unbekannten Pflanzen.");
   
   AddDetail( ({ "blumen", "blume" }),
      "Es gedeiht eine unglaubliche Vielfalt an wunderschoenen Blumen im Wald. ");
   
   AddDetail( ({ "vielfalt" }),
      "Es gibt wirklich sehr viele verschieden Pflanzen im Wald.");
   
   AddDetail( ({ "rasen" }),
      "Abgesehen von der Tatsache, dass es in einem Wald sicher keinen Rasen "
      "gibt, stellt sich die Frage, was an einem nicht vorhanden Rasen so "
      "interessant ist...");
   
   AddDetail( ({ "frage", "tatsache", "uebertreibung" }),
      "Das ist doch nicht wirklich wichtig!");
   
   AddSound( DEFAULT_SOUND,
      "Du lauschst den Geraeuschen eines Waldes und kannst nichts "
      "Ungewoehnliches hoeren.");

   AddSound( ({ "wald", "garaeusche" }),
      "Wennst es schon so genau wissen willst: Du hoerst das Rauschen von "
      "Blaettern, Vogelgezwitscher und so weiter." );

   
   AddExit( "nordwesten", "./room_b2" );
   AddExit( "sueden", "/d/huegelland/feyaria/weg/room/0314" );
   AddCmd( ({"kletter", "klettere"}), "klettern");
}

int klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if(str!="eiche" && str!="auf eiche" && str!="haus" && str!="baumhaus"
      && str!="zu haus" && str!="zu haus")
    return 0;
  write("Du kletterst auf die Eiche zum Baumhaus hinauf.\n");
  TP->command_me("oben");
  return 1;
}
  

