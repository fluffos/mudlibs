// Xorgan@SilberLand
// KoehlerLager 
// 1999-06-26

#include "../def.h"

inherit "std/room";

#include <moving.h>

int DoorOpen = 0;

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Vorm Schuppen der Koehler" );
   SetProp( P_INT_LONG,
      "Du stehst am noerdlichen Ende der Lichtung. Vor Dir steht der Schuppen, "
      "der direkt in den Wald hineingebaut scheint. Ein einfaches aber trotzdem "
      "beeindruckendes Gebaeude. Er scheint nur aus Holz gebaut zu sein. Die "
      "Vorderseite wird von einem grossen Tor beherrscht.");
   
   SetProp( P_LIGHT, 2 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

   AddDetail( ({ "ende" }),
      "Alles hat ein Ende. Sogar eine Lichtung und Du befindest Dich am "
      "noerdlichen Ende der Lichtung.");

   AddDetail( ({ "lichtung", "platz" }),
      "Diese Lichtung scheint nicht natuerlich entstanden zu sein. Es scheint "
      "sich mehr um eine Rodung zu handeln. Auf dem gesamten Platz steht kein "
      "einziger Baum mehr.");

   AddDetail( ({ "rodung" }),
      "Die wurde sehr gruendlich durchgefuehrt. Alle Baeume und Buesche scheinen "
      "ihr zum Opfer gefallen zu sein."
      );
   
   AddDetail( ({ "baeume", "baum", "buesche", "busch" }),
      "Auf der Lichtung gibt es keine. Aber hinter Dir kannst Du genug davon "
      "finden.");

   AddDetail( ({ "opfer" }),
      "Ja. Es sind alle weg.");

   AddSpecialDetail( ({ "scheunentor","tor" }), "tor" );

   AddDetail( ({ "fluegel", "mitte" }),
      "Dieses Tor hat zwei Fluegel und laesst sich daher in der Mitte oeffnen.");

   AddDetail( ({ "holz" }),
      "Scheint sich um Holz aus dem Wald zu handeln.");
   
   AddDetail( ({ "wald" }),
      "Der Wald ist rund um Dich.");
   
   AddDetail( ({ "schuppen" }),
      "Ein grosser Schuppen mit einem grossen Tor. Interessant daran ist "
      "eigentlich nur, dass fuer den Bau des Schuppens nur Holz verwendet "
      "wurde. Es wurde weder Stein noch Eisen verwendet. Du kannst nicht einmal "
      "Naegel finden.");

   AddDetail( ({ "nagel", "naegel" }),
      "Du kannst am ganzen Schuppen keinen einzigen finden.");

   AddDetail( ({ "eisen" }),
      "Es wurde kein Eisen verwendet.");

   AddDetail( ({ "stein" }),
      "Welchen Stein? ");

   AddDetail( ({ "gebaeude" }),
      "Bei diesem Gebaeude handelt es sich zweifellos um einen Schuppen.");
/*
   AddDetail( ({ "vorderseite", "wand", "holzwand" }),
      "Die Vorderseite des Schuppens ist wie auch der Rest aus Holz. Der "
      "Grossteil der Wand wird von einem geschlossenen Tor eingenommen.");
*/
   AddSpecialDetail( ({ "vorderseite", "wand", "holzwand"}), "vorderseite" );

   AddDetail( ({ "grossteil", "teil" }),
      "Nicht alles, aber ein grosser Teil.");

   AddDetail( ({ "rest" }),
      "Ein normales Gebaeude hat vier Seiten und ein Dach.");

   AddDetail( ({ "dach" }),
      "Das ist wirklich weit oben. Da kommst Du nicht rauf.");

   AddDetail( ({ "seite" }),
      "Welche meinst denn?");

   AddDetail( ({ "seiten" }),
      "Normalerweise sollte ein Schuppen eine Vorderseite, eine Rueckseite, "
      "eine rechte und eine linke Seite haben.");
   
   AddDetail( ({ "rechte seite" }),
      "Die rechte Seite ist wie die anderen 3 Seiten aus Holz. Allerdings "
      "kannst Du nicht recht viel davon sehen, da sie vollstaendig zugewachsen "
      "ist.");
      
   AddDetail( ({ "linke seite" }),
      "Die linke Seite ist wie die anderen 3 Seiten aus Holz. Allerdings kannst "
      "Du nicht recht viel davon sehen, da sie beinahe vollstaendig zugewachsen "
      "ist.");
   
   AddDetail( ({ "rueckseite" }),
      "Die gibts sicher auch, aber sehen kannst Du sie nicht, da sie hinten ist.");

   AddDetail( ({ "himmel" }),
      "Die Sonne steht hoch am blauen Himmel. Ein schoener Tag. Nicht eine "
      "einzige Wolke ist zu sehen.");

   AddDetail( ({ "sonne" }),
      "Sie steht hoch am Himmel und waermt Deine Haut.");

   AddDetail( ({ "haut" }),
      "Schoen warm ist sie schon geworden.");

   AddDetail( ({ "tag" }),
      "Schon mal in der Nacht die Sonne am Himmel gesehn??");

   AddDetail( ({ "nacht" }),
      "Es ist definitiv nicht Nacht!");

   AddDetail( ({ "wolke" }),
      "Du solltest JETZT damit aufhoeren Sachen zu untersuchen, die es hier "
      "nicht gibt!");

   AddDetail( ({ "boden" }),
      "Der Boden ist auch hier staubig und trocken. Entlang der Holzwand des "
      "Schuppens waechst doch tatsaechlich Gras. Wohl das einzige Gewaechs "
      "hier.");

   AddDetail( ({ "gras" }),
      "Es kann sicher nur deshalb wachsen, weil es so nahe an der Wand niemand "
      "niedertrampeln kann. ");

   AddDetail( ({ "gewaechs", "pflanze",  }),
      "Langes Gras waechst in Buescheln am Rand der Wand.");

   AddDetail( "bueschel",
      "Graeser bilden im allgemeinen Bueschel. Wenn man es wachsen laesst.");
   
   AddDetail( ({ "rand" }),
      "Du betrachtest den Rand zwischen Wand und Boden von der einen Ecke zur "
      "anderen. Kannst aber nichts finden.");

   AddDetail( ({ "ecke" }),
      "Dir faellt auf, dass links mehr Platz als rechts bis zum Wald ist. "
      "Vielleicht kann man da nach hinten gehen.");

   AddSpecialDetail( ({ "riegel" }), "Riegel" );
   
   AddSmell( DEFAULT_SMELL,
      "Es riecht ein wenig nach Rauch.");

   AddSmell( ({ "rauch" }),
      "Es riecht tatsaechlich leicht nach Rauch.");

   AddCmd( ({ "gehe", "geh" }), "gehe" );
   AddCmd( ({ "oeffne" }), "oeffne" );
   AddCmd( ({ "schliesse", "schliess" }), "schliesse" );
   AddCmd( ({ "betrete", "betritt" }), "betrete" );


   AddExit( "sueden", "./room_c4" );
}

reset()
{
   ::reset();
   
   DoorOpen = 0;
}

string Riegel( string key )
{
   string str;
   
   if(  DoorOpen == 0 )
   {
      return "Ein einfacher Riegel aus Holz. Der Riegel verschiesst das Tor.\n";
   }
   else
   {
      return "Ein einfacher Riegel aus Holz. Der Riegel ist geoeffnet.\n";
   }
}

gehe(string str )
{
   notify_fail( "Wo willst Du um was herum gehen?\n" );

   if( str == "rechts um schuppen herum" )
   {
      write("Du versuchst Dich zwischen Gestruepp und Wand um den Schuppen herum zu zwaengen.\n"
            "Es ist aber zu wenig Platz. Vielleicht geht es ja auf der anderen Seite.\n");
      say( TPN+" versucht sich erfolglos durchs Gestruepp zu zwaengen.\n");
      return 1;
   }
   if( str == "links um schuppen herum" )
   {
      write("Du zwaengst Dich zwischen Gestruepp und Wand um den Schuppen herum.\n");
      say( TPN+" zwaengt sich durchs Gestruepp.\n");
      TP->move(ROOM + "room_c7", M_GO);
      return 1;
   }
   return 0;
}

oeffne( string str )
{
   notify_fail( "Was moechtest Du oeffnen?\n" );
   if( str == "tor" )
   {
      if(  DoorOpen == 0 )
      {
         write("Du schiebst den Riegel beiseite und oeffnest das Tor.\n");
         say( TPN+" oeffnet das Tor zum Schuppen.\n");
         DoorOpen = 1;
         return 1;
      }
      write ("Das Tor ist doch schon offen!\n");
      return 1;
   }
   return 0;
}

schliesse( string str )
{
   notify_fail( "Was moechtest Du schliessen?\n" );
   if( str == "tor" )
   {
      if(  DoorOpen == 1 )
      {
         write("Du schliesst das Tor und schiebst den Riegel wieder vor.\n");
         say( TPN+" schliesst das Tor zum Schuppen.\n");
         DoorOpen = 0;
         return 1;
      }
      write ("Das Tor ist doch geschlossen!\n");
      return 1;
   }
   return 0;
}

betrete( string str )
{
   notify_fail( "Was moechtest Du betreten?\n" );
   if( str == "schuppen" || str == "gebaeude" )
   {
      if(  DoorOpen == 1 )
      {
         TP->move(ROOM + "room_c6", M_TPORT,
            "", "geht in den Schuppen", 
            "betritt den Schuppen"
            );
         
         return 1;
      }
      write("Das Tor ist geschlossen! Du solltest es vorher oeffnen.\n");
      
      return 1;
   }
   return 0;
}

string tor( string str )
{
   if( DoorOpen == 1 )
      return "Ein grosses geoeffnetes Scheunentor mit zwei Fluegeln. Es ist komplett aus Holz.\n";
   else
      return "Ein grosses geschlossenes Scheunentor mit zwei Fluegeln. Es ist komplett aus Holz.\n";
}

string vorderseite( string str )
{
   if( DoorOpen == 1 )
      return "Die Vorderseite des Schuppens ist wie auch der Rest aus Holz. Der " 
         + "Grossteil der Wand wird von einem geoeffneten Tor eingenommen.\n";
   else
      return "Die Vorderseite des Schuppens ist wie auch der Rest aus Holz. Der " 
         + "Grossteil der Wand wird von einem geschlossenen Tor eingenommen.\n";
}
