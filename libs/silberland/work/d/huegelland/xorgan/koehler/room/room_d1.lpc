   AddDetail( ({ "eisen", "metall" }),
      "Eisen ist ein sehr widerstandsfaehiges Metall.");

   AddDetail( ({ "schloss" }),
      "Ein schweres Eisenschloss sichert den Inhalt der Truhe vor Langfingern.");

   AddDetail( ({ "inhalt" }),
      "Du wirst doch nicht daran denken, den Lohn der Koehler zu stehlen. "
      "Schaem Dich!");

   AddDetail( ({ "langfinger" }),
      "Diebe!");

   AddDetail( ({ "diebe" }),
      "Langfinger! :)");

   AddDetail( ({ "lohn" }),
      "Das sind sicher sehr viele Muenzen.");

   AddDetail( ({ "muenzen" }),
      "Wie Muenzen aussehen wirst Du doch wohl wissen, oder?");

   AddDetail( ({ "eisenschloss" }),
      "Es ist wirklich ein schweres Schloss.");

   AddDetail( ({ "koehler" }),
      "Koehler machen aus Holz Kohle und das ist keine leichte Arbeit.");

   AddDetail( ({ "arbeit" }),
      "Das ist ein sehr schwere und anstrengende Arbeit!");

   AddDetail( ({ "schrank" }),
      "Der Schrank ist aus Kirschholz gefertigt und mit ausdrucksstarken "
      "Ornamenten und schoenen Schnitzereien verziert. Er scheint nicht neu, im "
      "Gegenteil sehr alt zu sein. Er ist wunderschoen. So einen Schrank "
