#include "../def.h"

inherit MYREGION "quest_room";

int anzahl = 1;

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Die Huette" );
   SetProp( P_INT_LONG,
      "Du hast die Huette des Koehlermeisters betreten. Die Wohnung besteht aus "
      "nur einem Zimmer. Die Westwand hat ein kleines Fenster. An Einrichtungs- "
      "gegenstaenden siehst Du ein gemachtes Bett, das links hinten steht, am "
      "Kopfende anschliessend eine Truhe an. Gleich rechts neben der Tuer befindet "
      "sich ein Schrank und links ein Ofen. Unter dem Fenster auf der linken "
      "Seite steht ein Tisch, auf dem eine Sturmlaterne steht, etliche Zetteln "
      "und einige Stifte durcheinander liegen. Um den Tisch herum gruppieren "
      "sich drei einfache Sessel. An der Wand ueber dem Bett haengt ein Bild."
      );
   
   SetProp( P_LIGHT, 2 );
   SetProp( P_INDOORS, 1 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
   
   
   AddDetail( ({ "huette", "wohnung", "haus" }),
      "Das ist die Haus des Koehlermeisters. Sicher nicht sehr luxurioes aber "
      "gemuetlich eingerichtet. Bett, Truhe, Schrank, Tisch, Sessel und Ofen "
      "sind die ganze Einrichtung.");

   AddDetail( ({ "meister", "koehlermeister" }),
      "Er ist der Boss des einzigen Betriebs der im ganzen Silberland Holzkohle "
      "herstellt. Alle Koehler sind ihm unterstellt. Er ist ein wichtiger Mann, "
      "denn ohne Kohle kann kein Schmied auch nur ein einziges Schwert "
      "herstellen, abgesehen davon ist es im Winter kalt und mit seiner Kohle "
      "werden die Oefen geheizt.");

   AddDetail( ({ "chef", "boss", "mann" }),
      "Er ist der Chef.");

   AddDetail( ({ "betrieb" }),
      "Der Koehlerei natuerlich.");

   AddDetail( ({ "holzkohle", "kohle" }),
      "Die Koehler machen Holzkohle.");

   AddDetail( ({ "schmied" }),
      "Die Schmiede erzeugen unter anderem auch Waffen.");

   AddDetail( ({ "schwerter", "schwert" }),
      "Das ist ein Waffe.");

   AddDetail( ({ "waffe" }),
      "Waffen werden von Schmieden hergestellt und repariert.");

   AddDetail( ({ "zimmer" }),
      "Das Haus hat nur ein Zimmer. Mehr braucht der Meister einfach nicht.");

   AddDetail( ({ "wand" }),
      "Welche der vier Waende meinst Du?");

   AddDetail( ({ "waende" }),
      "Die vier Waende der Huette sind aus Holz. " );

   AddDetail( ({ "rechte seite", "westwand" }),
      "Die Westwand ist die einzige mit einem, wenn auch kleinen Fenster. "
      "Hier befindet sich der Schrank, der Tisch mit den drei Sesseln.");
   
   AddDetail( ({ "linke seite", "ostwand" }),
      "Auf der linken Seite steht das sauber gemachte Bett, eine Truhe und ein "
      "Ofen.");

   AddDetail( ({ "suedwand" }),
      "An der Suedwand steht das Bett. Daneben steht eine Truhe.");
   
   AddDetail( ({ "nordwand" }),
      "Da befindet sich die Tuer durch die Du rein gekommen bist.");
   
   AddDetail( ({ "fenster" }),
      "Das kleine geschlossene Fenster gibt den Blick in den Wald frei.");

   AddDetail( ({ "blick", "ausblick" }),
      "Ein netter Ausblick auf den Wald.");

   AddDetail( ({ "einrichtung", "gegenstaende", "einrichtungsgegenstaende" }),
      "Die Einrichtung besteht aus einem Bett, einer Truhe, einem Schrank, "
      "einem Tisch mit drei Sessel und einem Ofen.");

   AddDetail( ({ "bett" }),
      "Ein rustikales Bett aus Eichenholz. "
      "Das Bett ist fein saeuberlich gemacht. Fein saeuberlich ist die Decke "
      "ueber die weissen Laken geschlagen. Am oberen Ende liegt der Polster, "
      "teilweise von der Decke bedeckt. Irgendwie der totale Unterschied zum "
      "Tisch.");

   AddDetail( ({ "rustikal" }),
      "Die reichlich verzierten Kopf- und Fussteile wurden mit zwei massiven "
      "Latten zu einem Bett zusammengebaut.");
   
   AddDetail( ({ "kopfteil", "fussteil", "teil", "teile" }),
      "Sowohl das Kopfteil als auch das Fussteil des Bettes sind mit "
      "Schnitzereien verziert.");
   
   AddDetail( ({ "latten", "latte" }),
      "Die massiven Latten aus Eichenholz verbinden die anderen Teile - halten "
