   AddDetail( ({ "kirschholz" }),
      "Ein von der Farbe besonders schoenes Holz.");

   AddDetail( ({ "farbe" }),
      "Gelb mit einem roetlichen Stich und einer roten Maserung.");

   AddDetail( ({ "stich" }),
      "Soll soviel heissen wie geht ins Rot ueber.");

   AddDetail( ({ "rot", "farbe" }),
      "Rot ist ein Farbe, kaum zu glauben!");

   AddDetail( ({ "maserung" }),
      "Die Maserung ist die Bezeichnung der Jahresringe eines Baumes auf einem "
      "Brett.");

   AddDetail( ({ "bezeichnung" }),
      "Hmmmm. Jetzt reichts dann aber.");

   AddDetail( ({ "jahresringe", "ringe","ring"  }),
      "Jedes Jahr bekommt ein Baum zwei davon. Einen dunklen Ring der in den "
      "Wintermonaten entsteht und einen deutlich helleren der in den "
      "Sommermonaten entsteht.");

   AddDetail( ({ "wintermonate", "sommermonate", "monate" }),
      "In den unterschiedlichen Jahreszeiten waechst ein Baum unterschiedlich "
      "schnell.");

   AddDetail( ({ "jahr", "Jahreszeiten", "fruehling", "sommer", "herbst", "winter"  }),
      "Fruehling, Sommer, Herbst und Winter.");

   AddDetail( ({ "brett" }),
      "Vor dem Kopf, was?");

   AddDetail( ({ "kopf" }),
      "Den hat ja wohl jeder!");

   AddDetail( ({ "ornamente", "verzierungen" }),
      "Wunderschoene Verzierungen bedecken den Schrank.");

   AddDetail( ({ "schnitzereien", "schnitzerei" }),
      "Herrliche Muster, ja man koennte sagen Bilder sind in den Schrank und in "
      "das Bett geschnitzt worden.");

   AddDetail( ({ "muster" }),
      "Herrliche Muster wurden in den Schrank und in das Bett geschnitzt.");

   AddDetail( ({ "bilder" }),
      "Einige davon koennte man sicher so bezeichnen.");

   AddDetail( ({ "loch", "schluesselloch" }),
      "Da im Schluesselloch kein Schluessel steckt, wird der Schrank versperrt "
      "sein.");

   AddDetail( ({ "schluessel" }),
      "Wer wird den wohl haben?");

   AddDetail( ({ "ofen", "oefen" }),
      "Jeder hat einen. Auch der Koehlermeister hat einen. Mit ihm kann er sein "
      "Haus heizen und sogar darauf kochen.");

   AddDetail( ({ "tisch" }),
      "Ein grosser schwerer Tisch aus massiven Eichenholz. Er ist ueber und "
      "ueber mit Zetteln bedeckt. Darunter liegen vereinzelt einige Stifte "
      "herum. Irgendwo dazwischen steht eine Sturmlaterne. Auf dem Tisch "
      "herrscht das absolute Chaos. In dieser Unordnung etwas zu finden, "
      "scheint Dir eine unmoegliche Aufgabe zu sein.");

   AddDetail( ({ "eichenholz" }),
      "Ein unglaublich hartes und widerstandsfaehiges Holz.");

   AddDetail( ({ "zettel" }),
      "Kurz ueberfliegst Du einen Zettel. Es scheint sich hauptsaechlich um "
      "Bestellungen zu handeln. Als Dir ein Zettel auffaellt, auf dem fuer "
      "Smoersky ein ganze Schiffsladung bestellt wird. Na da muss es kalt sein!");

   AddDetail( ({ "bestellungen" }),
      "Die Kohle scheint ins ganze Silberland geliefert zu werden.");

   AddDetail( ({ "smoersky", "dorf" }),
      "Smoersky ist ein Dorf im hohen Norden.");

   AddDetail( ({ "schiffsladung", "ladung" }),
      "Sehr viel Kohle!!! Da muss es wirklich kalt sein.");

   AddDetail( ({ "kohle" }),
      "Wird von den Koehlern hergestellt.");

   AddDetail( ({ "stifte", "kohlestift", "bleistift","kohlestifte", "bleistifte" }),
      "Kohle- und Bleistifte. Damit wird er wohl schreiben.");

   AddDetail( ({ "chaos" }),
      "Ein anderes Wort faellt Dir einfach nicht zu dieser Unordnung ein.");

   AddDetail( ({ "wort" }),
      "Dir faellt kein anderes ein!");

   AddDetail( ({ "unordnung" }),
      "Chaos ist wohl ein besserer Ausdruck.");

   AddDetail( ({ "aufgabe" }),
      "Es ist voellig unmoeglich einen bestimmten Zettel in einer halbwegs "
      "vernuenftigen Zeit zu finden. Zum Glueck musst Du das ja auch nicht!");

   AddDetail( ({ "zeit" }),
      "Da etwas bestimmtes zu finden kann lange wirklich lange dauern.");

   AddDetail( ({ "glueck" }),
      "Du hast wirklich Glueck nicht nach einem Zettel suchen zu muessen.");

   AddDetail( ({ "sessel" }),
      "Einfache Sessel aus Eichenholz.");

   AddDetail( ({ "laterne", "sturmlaterne",  }),
      "Eine aus Metall gefertigte Petroleumlampe mit einem Henkel, die als "
      "besonders wetterfest gilt.");

   AddDetail( ({ "lampe", "petroleumlampe" }),
      "Diese Lampe verbrennt ueber einen Docht Petroleum.");

   AddDetail( ({ "docht", "faden" }),
      "Ein Docht ist der Faden einer Lampe.");

   AddDetail( ({ "petroleum" }),
      "Eine brennbare Fluessigkeit.");

   AddDetail( ({ "fluessigkeit" }),
      "Nicht fest sondern fluessig. Sie rinnt. ;)");

   AddDetail( ({ "henkel", "griff" }),
      "Eine andere Bezeichnung fuer Griff ist Henkel.");

   AddDetail( ({ "bild" }),
      "Eigentlich kann man nicht von einem Bild sprechen. Es handelt sich "
      "vielmehr um ein eingerahmtes Zeugnis.");

   AddDetail( ({ "zeugnis" }),
      "Der Koehlermeister hat seinen Meisterbrief eingerahmt und ueber seinem "
      "Bett aufgehaengt.");

   AddDetail( ({ "brief", "meisterbrief" }),
      "Damit kann er dem Beamten belegen, dass er berechtigt ist, eine Koehlerei "
      "zu fuehren.");

   AddDetail( ({ "beamte", "beamter", "beamten" }),
      "Der sitzt in der Hauptstadt Midas.");

   AddDetail( ({ "hauptstadt", "midas" }),
      "Midas ist die Hauptstadt vom Silberland.");

   AddDetail( ({ "silberland" }),
      "Darin laeufst Du herum.");

   AddDetail( ({ "koehlerei" }),
      "Die stellt Kohle her und wird von einem Koehlermeister geleitet.");

   AddDetail( ({ "seite" }),
      "Welche meinst denn jetzt? Die linke oder die rechte Seite?");
   
   AddDetail( ({ "tuer" }),
      "Durch die bist ja grade hereingekommen!");
   
   AddDetail( ({ "boden" }),
      "Der Boden ist aus massiven Holz. Neben dem Bett liegt ein "
      "Fleckerlteppich.");

   AddDetail( ({ "teppich", "fleckerlteppich" }),
      "Ein aus vielen einzelnen Stuecken zusammengenaehter Teppich.");
   
   AddDetail( ({ "stuecke", "stoffstuecke" }),
      "Einzelne Stoffstuecke werden zu einem Fleckerlteppich zusammengenaeht.");

   AddDetail( ({ "holz" }),
      "Scheint sich um Holz aus dem Wald zu handeln.");

   AddDetail( ({ "Wald" }),
      "Den wirst Du in der Huette sicher nicht finden!");

   AddDetail( ({ "ausdruck", "gegenteil", "tag" }),
      "Was willst denn darueber wissen?");


   AddCmd( ({ "wuehle", "durchwuehle", "wuehl", "durchwuehl" }), "wuehle" );
   AddCmd( ({ "blicke", "schaue", "blick", "schau" }), "blicke" );

   AddExit( "raus", "raus#./room_c2" );

}


void reset()
{
   ::reset();
   
   anzahl = 1;
}


blicke( string str )
{
   object ob;
   
   notify_fail( "Unter was willst Du blicken?\n" );
   if( str == "unter bett" )
   {
      
      if( present( "koehler_quest", TP ) && !present( "koehler_axt", TP )
         && !CheckPlayer( TP->query_real_name()) ) 
      {
         write(BS("Du blickst unter das Bett des Koehlermeisters, und siehe da. "
            "Es liegt eine seltsame Axt darunter. Wie die da wohl drunter "
            "gekommen ist?\n" ));
         
         if( (ob=clone_object(WEAPON + "klkaxt.lpc"))->move(TP) == 1 )
         {
            write(BS("Auf jeden Fall scheint sie niemand abzugehen und Du "
               "steckst sie ein.\n" ));
            say( TPN + " scheint eine seltsame Axt gefunden zu haben.\n");
            
            SetPlayer( TP->query_real_name(), 1 );
         }
         else
         {
            write( "Du kannst sie leider nicht mehr tragen!\n");
            ob->move( ENV( TP ));
         }
      }
      else
         write("Du blickst unter das Bett und kannst nicht mal Staub entdecken.\n");
      
      return 1;
   }
   return 0;
}

wuehle( string str )
{
   object ob;
   
   notify_fail( "Was willst Du durchwuehlen?\n" );
   if( str == "in zettel" || str == "zettel" )
   {
      write("Du wuehlst in den Zetteln herum. Bestellungen, ueber Bestellungen.\n");
      
      if( anzahl == 1 ) 
      {
         write("Ploetzlich hast Du eine Kaertchen in den den Haenden.\n");
         if( (ob=clone_object(OBJ + "kaertchen.lpc"))->move(TP) == 1 )
         {
            write(BS("Vielleicht kann ich es ja mal wo brauchen, denkst Du und "
               "nimmst es an Dich.\n" ));
            say( TPN + " scheint etwas gefunden zu haben.\n");
            anzahl = 0;
         }
         else
         {
            write( "Du kannst sie leider nicht mehr tragen!\n");
            ob->move(ENV(TP));
         }
      }
      return 1;
   }
   return 0;
}


