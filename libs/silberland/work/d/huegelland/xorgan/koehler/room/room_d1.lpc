   AddDetail( ({ "daunen", "federn", "gaense" }),
      "Die Federn von Gaensen sind Daunen.");

   AddDetail( ({ "ueberzug" }),
      "Auf den weissen Ueberzug aus Leinen befindet sich ein sehr schoene "
      "Stickerei.");

   AddDetail( ({ "leinen" }),
      "Leinen ist eine Stoffart.");

   AddDetail( ({ "stoff", "stoffart", "art", "arten" }),
      "Es gibt viele Arten.");

   AddDetail( ({ "stickerei" }),
      "Die wunderschoen gearbeitete Stickerei zeigt eine Waldszene.");

   AddDetail( ({ "waldszene" }),
      "Es wurden ein paar Baeume und Straeucher gemeinsam mit verschieden "
      "Tieren abgebildet.");

   AddDetail( ({ "baum", "baeume", "straeucher" }),
      "Es wachsen viele verschiedene Arten im Wald.");
      
   AddDetail( ({ "tiere" }),
      "Die gibts auch in einem Wald.");
   
   AddDetail( ({ "kopfende" }),
      "Dort wo der Kopf des Schlaefers liegt, steht die Truhe.");

   AddDetail( ({ "schlaefer", "schlafender" }),
      "Jemand der schlaeft ;)");

   AddDetail( ({ "laken" }),
      "Sowohl unter der Decke als auch ueber der Matratze liegt ein Laken aus "
