   AddDetail( ({ "matratze" }),
      "Auf einer liegst Du jeden Tag.");

   AddDetail( ({ "truhe" }),
      "Die schwere mit Eisen beschlagene Truhe steht am Kopfende des Bettes "
      "und ist mit einem maechtigen Schloss gesichert. Darin wird wohl der Lohn "
