// Xorgan@SilberLand
// KoehlerLager 
// 1999-06-26

#include "../def.h"

inherit MYREGION "quest_room";

void create()
{

   ::create();

   SetProp( P_INT_SHORT, "Hinterm Schuppen" );
   SetProp( P_INT_LONG,
      "Du erreichst einen kleinen Platz zwischen Rueckwand des Schuppens und "
      "dem Wald, der von Norden her das ihm geraubte Land wieder in Besitz "
      "nimmt. Zwischen den Ranken, die die Rueckwand des Schuppens "
      "hinaufwachsen und dem noerdlich von Dir wachsenden Gewirr von Bueschen, "
      "Farnen und jungen Baeumen bleibt kaum ein Meter Platz auf dem Du "
      "gebueckt stehen kannst.");
   SetProp( P_LIGHT, 1 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_FOREST]) );

   AddDetail( ({ "platz" }),
      "Der kleine Platz ist von einem Meter hohem Gras ueberwuchert. "
      "Halbkreisfoermig, um die sich im Osten befindende Rueckwand des "
      "Schuppens, auf dem Rankengewaechse wie Efeu der Sonne entgegen streben, "
      "erobert der Wald nach und nach das ihm geraubte Land zurueck. Wild "
      "durcheinander draengen sich junge Baeume, Buesche, Farne und Graeser, "
      "als wuerden sie um jeden Lichtstrahl zanken.");

   AddDetail( ({ "gras", "graeser" }),
      "Es ist unglaublich hoch. Es duerfte wohl schon lange keiner mehr hier "
      "gewesen sein.");
   
   AddDetail( ({ "rueckwand" }),
      "Die ist mit Ranken total zugewachsen. Du kannst sie kaum noch erkennen.");
   
   AddDetail( ({ "schuppen" }),
      "Du befindest Dich auf der Rueckseite des Schuppens, die beinahe "
      "vollstaendig zugewachsen ist.");
   
   AddDetail( ({ "rueckseite", "seite" }),
      "Rueckseite - Wo wird die wohl sein? Hinten vielleicht.");
   
   AddDetail( ({ "gewaechse", "rankengewaechse", "ranken" }),
      "Die wachsen die Rueckwand hinauf und haben sie beinahe vollstaendig "
      "verdeckt.");
   
   AddDetail( ({ "efeu", "lianen" }),
      "Kletterpflanzen. Unglaublich viele wachsen die Rueckwand des Schuppens "
      "hinauf.");
   
   AddDetail( ({ "sonne" }),
      "Die kannst vor lauter Blaettern kaum mehr sehen.");
   
   AddDetail( ({ "blaetter" }),
      "Die bilden schon beinahe ein natuerliches Dach ueber Dir.");
   
   AddDetail( ({ "dach", "blaetterdach" }),
      "Ein Dach aus Blaettern.");
   
   AddDetail( ({ "kletterpflanzen" }),
      "Viele Arten von Kletterpflanzen wachsen den Schuppen hinauf. "
      "Hauptsaechlich Lianen und Efeu. An einer Stelle wachsen sie besonders "
      "dicht." );
   
   AddDetail( ({ "pflanzen", "pflanzenart", "arten", "art", "farne", "buesche" }),
      "Es gibt viele Arten von Pflanzen in einem Wald.");
   
   AddDetail( ({ "wald" }),
      "Der Wald nimmt sich das was einst ihm gehoerte. "
      "Unterschiedlichste Baeume, Buesche und Farne erobern diesen Teil der "
      "Lichtung, die von Menschenhand geschaffen wurde, wieder zurueck.");
   
   AddDetail( ({ "baum", "baeume" }),
      "Es wachsen Eichen, Buchen, Tannen, Fichten und viele andere Arten im "
      "Wald.");
      
   AddDetail( ({ "eichen", "buchen", "tannen", "fichten" }),
      "Ja. Es wachsen Baeume in einem Wald.");
   
   AddDetail( ({ "teil" }),
      "Der hier ist der noerdlichste Teil der Lichtung.");

   AddDetail( ({ "lichtung" }),
      "Auf der befindest Du Dich.");

   AddDetail( ({ "stelle" }),
      "Die Ranken wachsen hier unglaublich dicht und bilden faktisch eine "
      "Beule.");
   
   AddDetail( ({ "beule" }),
      "Es scheint als wuerde sich Etwas dahinter verbergen.");
   
   AddDetail( ({ "etwas" }),
      "Was es ist, kannst Du nicht feststellen. Jedoch kannst Du versuchen es "
      "freizulegen.");
   
   AddDetail( ({ "es" }),
      "Wenn Du nicht die Kletterpflanzen entfernst, wirst Du es nie sehen.");
   
   AddDetail( ({ "gewirr" }),
      "Ein natuerliche Unordnung herrscht hier.");
   
   AddDetail( ({ "unordnung" }),
      "Das Gegenteil von Ordnung.");
   
   AddDetail( ({ "ordnung" }),
      "Das Gegenteil von Unordnung. :)");
   
   AddDetail( ({ "gegenteil" }),
      "Welche unsinnigen Details willst denn noch alle wissen? Konzentriere "
      "Dich doch aufs Wesentliche. :)");
   
   AddDetail( ({ "land" }),
      "Dieses Land war einst, bevor die Koehler kamen, schoener natuerlicher "
      "Wald. Meinst Du nicht auch er hat das Recht, es wieder in Besitz zu "
      "nehmen?");
   
   AddDetail( ({ "besitz", "recht" }),
      "Ja. Der Wald breitet sich wieder aus.");
   
   AddDetail( ({ "lichtstrahl", "strahl" }),
      "Nur wenige erreichen durch das Blaetterdach den Boden.");
   
   AddDetail( ({ "boden" }),
      "Abgesehen dass Du darauf stehst, ist der Boden des Platzes mit "
      "meterhohem Gras zugewachsen. Schon bald wird auch der letzte Rest vom "
      "Platz unzugaenglich sein.");
   
   AddDetail( ({ "himmel" }),
      "Welchen Himmel? Du kannst ihn vor lauter Blaettern doch gar nicht sehen.");
   
   AddDetail( ({ "rest" }),
      "Der kleine Platz der zwischen Rueckwand und dem Wald noch verblieben "
      "ist.");
   
   AddDetail( ({ "pilze" }),
      "Du kannst ein paar Pilze sehen. Ob man diese Pilze essen kann, weisst "
      "Du nicht.");
   
   AddDetail( ({ "moos" }),
      "Eine spezielle wasserspeichernde Pflanzen, die auch in Waeldern "
      "vorkommt.");
   
   AddDetail( ({ "kraeuter" }),
      "Naja. Vielleicht ist das eine kleine Uebertreibung. Also gut: Es sind "
      "Graeser.");
   
   AddDetail( ({ "koehler" }),
      "Koehler machen aus Holz Kohle.");

   AddDetail( ({ "holz" }),
      "Es wird sich um Holz aus dem Wald handeln.");

   AddDetail( ({ "holzkohle", "kohle" }),
      "Sie machen Holzkohle. Kannst es glauben.");

   AddDetail( ({ "details", "wesentliche" }),
      "Das ist doch nicht wirklich wichtig!");
   
   AddSmell( DEFAULT_SMELL,
      "Du riechst den typischen wuerzigen Waldgeruch. Ah. Da kannst Du frei "
      "durchatmen.");

   AddSmell( ({ "geruch", "waldgeruch" }),
      "Der Wald riecht nach Kraeutern, Pilzen und Harz usw.");

   AddSmell( ({ "kraeuter", "pilze", "harz" }),
      "Es riecht einfach gesagt nach Wald.");

   AddSound( DEFAULT_SOUND,
      "Du lauschst den Geraeuschen eines Waldes und kannst nichts "
      "ungewoehnliches hoeren.");

   AddSound( ({ "wald" }),
      "Wennst es schon so genau wissen willst: Du hoerst das Rauschen von "
      "Blaettern, Vogelgezwitscher und so weiter." );

   AddCmd( ({ "entferne", "entfern" }), "entferne" );
   AddCmd( ({ "lege", "leg" }), "lay" );
   
   AddExit( "vorne", "zurueck nach Vorne#./room_c5" );
}


lay( string str )
{
   if( str == "etwas frei" || str == "beule frei")
   {
      write( BS( "Lege Etwas Frei? Was ist bitte ETWAS? Das kann doch nicht "
         "funktionieren. Nachdem Du nicht weisst, was Du freilegen moechtest, "
         "solltest Du Dir Gedanken darueber machen, was das ominoese Ding "
         "verdeckt und was Du damit machen kannst. Ein guter Tip koennten "
         "die Ranken sein!\n" ));
      
   }
   else
   {
      write( "Du willst wohl etwas freilegen, oder?\n" );
   }
   return 1;
}

entferne(string str )
{
   object obj;
   
   notify_fail( "Was willst Du entfernen?\n" );
   if( str == "kletterpflanzen" || str == "ranken" )
   {
      if(present("koehler_quest", TP ) && !CheckPlayer( TP->query_real_name()) )
      {
         write("Du entfernst die Kletterpflanzen und findest einen alten "
            "Schubkarren.\n");
         say( TPN+" hat hinter Kletterpflanzen eine alten Schubkarren "
            "gefunden.\n");
         
         obj = clone_object(OBJ + "skarren.lpc");
         obj->SetOwner(getuid(TP));
         obj->move(ENV(TP));
         SetPlayer( TP->query_real_name(), 1 );
      }
      else
      {
         write(BS("Du entfernst die Kletterpflanzen und es ist nichts "
            "dahinter. Du hast Dich wohl geirrt.\n"));
         say( TPN+" entfernt die Kletterpflanzen.\n");
      }
      return 1;
   }
   return 0;
}

