// Xorgan@SilberLand
// KoehlerLager 
// 1999-06-26

#include "../def.h"

inherit MYREGION "quest_room";

int woelb = 0;

void create()
{
   ::create();

   SetProp( P_INT_SHORT, "Vor einem Zelt auf der Koehlerlichtung" );
   SetProp( P_INT_LONG,
      "Du stehst direkt vor einem grossen Zelt aus grauem Segeltuch. Es ist von "
      "einem kleinen Graben umgeben. Das Zelt scheint schon lange hier zu "
      "stehen, da bereits hohes Gras rund um das Zelt gewachsen ist. Der "
      "Zelteingang ist offen. Der Boden des Zeltes ist mit zwei Planen "
      "ausgelegt. In der Mitte befindet sich ein kleiner Ofen. An den "
      "Zeltwaenden stehen auf jeder Seite drei Feldbetten, unter jedem liegt "
      "eine Kiste, in denen die Koehler ihre privaten Sachen aufbewahren.");
   SetProp( P_LIGHT, 2 );
   SetProp( P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

   AddDetail( ({ "zelt" }),
      "Vor Dir steht ein grosses graues Zelt aus Segeltuch. Es ist von einem "
      "kleinen Graben umgeben, der wohl das Regenwasser ableiten soll. Der "
      "Eingang des Zeltes ist offen, so kannst Du ins Innere blicken.");

   AddDetail( ({ "segeltuch", "tuch", "stoff" }),
      "Dieser schwere dicke Stoff ist unglaublich widerstandsfaehig und wurde, "
      "da er auch wasserdicht ist, fuer das Zelt verwendet. Eigentlich wird er "
      "fuer die Segel von Schiffen verwendet.");

   AddDetail( ({ "segel", "schiff" }),
      "Das musst Du Dir schon vorstellen, denn sehen kannst Du hier sicher "
      "keines.");

   AddDetail( ({ "graben" }),
      "Der etwa 20 cm breite und ebenso tiefe Graben laeuft rund um das Zelt. "
      "Nur der Eingang ist frei. Er dient dazu, das Regenwasser daran zu "
      "hindern, ins Zelt zu laufen.");

   AddDetail( ({ "regenwasser", "wasser" }),
      "Der Graben ist total trocken und nach Regen sieht es nicht grade aus.");

   AddDetail( ({ "eingang", "zelteingang" }),
      "Durch den Eingang kannst Du ins Innere des Zeltes sehen.");

   AddDetail( ({ "innere", "inneres" }),
      "In der Mitte des Zeltes steht ein kleiner Ofen. "
      "An den Zeltwaenden stehen auf jeder Seite drei Feldbetten. "
      "Unter jedem Bett liegt eine Kiste, in denen die Koehler ihre privaten "
      "Sachen aufbewahren. Der Boden des Zeltes ist mit zwei Planen ausgelegt."
      );

   AddDetail( ({ "ofen" }),
      "Ein kleiner Ofen, der es erlaubt, das Zelt mit Holz oder Kohle zu "
      "beheizen.");

   AddDetail( ({ "holz" }),
      "Davon gibts noch genug!");

   AddDetail( ({ "kohle" }),
      "Wird hier hergestellt.");

   AddDetail( ({ "zeltwaende", "waende" }),
      "Die Zeltwaende bestehen aus Segeltuch. An den Waenden stehen normale "
      "Feldbetten. Unter jedem dieser Nachtlager liegt eine Kiste mit den "
      "privaten Sachen der Koehler.");

   AddDetail( ({ "lager", "nachtlager" }),
      "Jedes besteht aus einem Feldbett, einem Polster und einer Decke.");

   AddDetail( ({ "seite" }),
      "Links und rechts vom Eingang.");

   AddDetail( ({ "feldbetten", "feldbett", "betten", "bett" }),
      "Die Feldbetten sind absolut nichts besonderes. Auf jedem Bett liegt "
      "ein Polster und eine Decke. Darunter steht eine Kiste.");

   AddDetail( ({ "polster" }),
      "Einfach ein Polster. Absolut nicht interessant.");

   AddDetail( ({ "decke" }),
      "Eine einfache, aber warme Decke liegt ordentlich ausgebreitet auf jedem "
      "der Feldbetten.");

   AddDetail( ({ "kiste", "kisten", "holzkisten", "holzkiste" }),
      "Einfache mit Eisen verstaerkte Holzkisten. Alle Kisten sind mit einem "
      "Schloss versperrt." );

   AddDetail( ({ "eisen" }),
      "Das verstaerkt die Kiste.");

   AddDetail( ({ "schloss" }),
      "Ein relativ einfaches Schloss. Wuerde sich sicher leicht knacken lassen. "
      "Jedoch glaubst Du nicht, dass sich in einer der Kisten etwas Nuetzliches "
      "befinden koennte.");

   AddDetail( ({ "sachen" }),
      "Nachdem unter jedem Bett eine Kiste steht, kannst Du annehmen, dass die "
      "Koehler darin ihre privaten Sachen aufbewahren.");

   AddDetail( ({ "koehler" }),
      "Du bist Dir sicher, dass die Koehler in diesem Zelt wohnen.");

   AddDetail( ({ "planen", "plane" }),
      "Sie bestehen ebenfalls aus Segeltuch. Zwei wurden fuer den Boden des "
      "Zeltes verwendet.");

   AddDetail( ({ "zeltboden", "boden im zelt" }),
      "Der Boden des Zeltes wurde mit zwei Planen ausgelegt. Die eine Plane "
      "bedeckt den hinteren Teil des Bodens und die Zweite den Vorderen, "
      "sodass sich quer durch das Zelt eine Falte zieht.");

   AddDetail( ({ "falte" }),
      "Quer durch das Zelt an der Stelle, wo die zwei Planen uebereinander "
      "liegen, hat sich ein Falte gebildet. Du solltest vorsichtig sein sonst "
      "STOLPERST Du noch drueber.");

   AddDetail( ({ "boden" }),
      "Der Boden rund um das Zelt ist von kniehohem Gras bedeckt. "
      "Abgesehen von einem Weg der vom Zelt Richtung Norden weg fuehrt, scheint "
      "nur der Boden des Zeltes von Interesse zu sein.");

   AddDetail( ({ "interesse" }),
      "Der Boden im Zelt ist viel interessanter!");

   AddDetail( ({ "gras" }),
      "Das Gras ist kniehoch, was darauf schliessen laesst, dass das Zelt schon "
      "einige Zeit hier steht. Im Gras kannst Du einige Halteleinen des Zeltes "
      "ausmachen.");

   AddDetail( ({ "leinen", "halteleinen", "schnuere" }),
      "Schnuere die vom Zelt ausgehen und irgendwo im Gras verschwinden, wo "
      "sie mit Sicherheit irgendwie am Boden befestigt sind.");

   AddDetail( ({ "sicherheit" }),
      "Du bist absolut sicher, dass es genau so ist!");

   AddDetail( ({ "weg" }),
      "Ein schmaler Weg der vom Zelt Richtung Zentrum der Lichtung fuehrt.");

   AddDetail( ({ "zentrum" }),
      "Das ist oestlich von Dir.");

   AddDetail( ({ "lichtung" }),
      "Darauf befindest Du Dich.");

   AddDetail( ({ "himmel" }),
      "Am wolkenlosen und daher strahlend blauen Himmel brennt die Sonne auf "
      "Dich herunter. Einfach gesagt: ein toller Tag.");

   AddDetail( ({ "sonne" }),
      "Sie strahlt am wolkenlosen Himmel.");

   AddSpecialDetail( ({ "woelbung" }), "woelbung" );

   AddCmd( ({ "stolpere","stolper" }), "stolpere" );
   AddCmd( ({ "greife", "greif" }), "greife" );

   AddExit( "norden", "./room_c2" );
}


void reset()
{
   ::reset();
   
   woelb = 0;
}


stolpere(string str )
{
   notify_fail( "Ueber was willst Du stolpern?\n" );
   if( str == "ueber falte")
   {
      write(BS("Absichtlich stolperst Du ueber die Falte. Kannst ohne Problem "
         "einen Sturz verhindern. Durch Dein Tun hat sich die Plane verschoben. "
         "Nun faellt Dir eine Woelbung auf.\n"));
      say( TPN + " stolpert gekonnt ueber eine Falte.\n");
      woelb = 1;
      return 1;
   }
   return 0;
}


woelbung( string key )
{
   if( woelb == 1 )
   {
      if(present("koehler_quest", TP ))
         return BS("Diese Woelbung laesst sich nicht glaetten. Vielleicht war "
            + "die vorher auch schon da. Du hast das Gefuehl, dass sich etwas "
            + "unter der Plane verborgen haelt.\n");
      else
      {
         woelb = 0;
         return "Da die Woelbung nicht schoen aussieht, richtest Du die Plane "
            + "wieder.\n";
      }
   }
   return "Welche Woelbung? So etwas siehst Du nicht!\n";
}


greife( string str)
{
   object ob;
   
   notify_fail( "Unter was moechtest Du greifen?\n" );
   if( str == "unter plane")
   {
      if( woelb == 1 && present("koehler_quest", TP) 
         && !present("koehler_messer",TP )
         && !CheckPlayer( TP->query_real_name()) )
      {
         write(BS( "Du greifst unter die Plane. Tastest herum und findest ein "
            "Schnitzmesser.\n" ));
         
         if( (ob=clone_object( WEAPON + "smesser.lpc" ))->move(TP) == 1 )
         {
            write("Du nimmst es sofort an Dich.\n");
            say( TPN + " scheint etwas unter der Plane gefunden zu haben.\n");
            SetPlayer( TP->query_real_name(), 1 );
         }
         else
         {
            write( "Du kannst es leider nicht mehr tragen!\n");
            ob->move(ENV(TP));
         }
      }
      else
      {
         write( "Du greifst irgendwo unter die Plane und findest aber nichts!\n");
         say( TPN + " greift unter die Plane und findet nichts!\n");
      }
      
      woelb = 0;
      return 1;
   }
   return 0;
}
