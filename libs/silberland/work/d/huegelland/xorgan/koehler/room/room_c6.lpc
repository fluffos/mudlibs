#include "../def.h"

inherit MYREGION "quest_room";

void create()
{

   ::create();
   
   SetProp( P_INT_SHORT, "Der Schuppen" );
   SetProp( P_INT_LONG,
      "Du befindest Dich im Schuppen, der offensichtlich als Lagerstaette "
      "verwendet wird. Auf der rechten Seite befindet sich ein gewaltiger Stapel "
      "von Saecken. Auch links vom Eingang wurde bereits ein Haufen von diesen "
      "Saecken gebildet. An der Rueckwand befinden sich etliche Haken. Darunter "
      "liegen etliche leere Saecke am Boden.");
   
   SetProp( P_LIGHT, 2 );
   SetProp( P_INDOORS, 1 );
   SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

   AddDetail( ({ "schuppen", "staette", "lagerstaette" }),
      "Der Schuppen wird offensichtlich zum Lagern von Gegenstaenden und "
      "Werkzeugen verwendet.");

   AddDetail( ({ "werkzeug", "werkzeuge" }),
      "Das kannst Du nur vermuten, denn gesehen hast keines. Wird wohl alles "
      "von den Arbeitern verwendet.");

   AddDetail( ({ "arbeiter" }),
      "Was werden die wohl hier tun. Richtig! Arbeiten!");

   AddDetail( ({ "gegenstaende" }),
      "Vor allem werden Saecke gelagert. Links und rechts stehen volle Saecke. "
      "Hinten liegen einige leere Saecke am Boden.");

   AddDetail( ({ "seite" }),
      "Welche meinst denn jetzt? Die linke oder die rechte Seite?");

   AddDetail( ({ "rechte seite" }),
      "Auf der rechten Seite befindet sich ein hoher Stapel von gefuellten "
      "Saecken. Er reicht vom Eingang bis zur Rueckwand. Es muessen wohl "
      "hunderte sein.");

   AddDetail( ({ "eingang", "tor" }),
      "Durch das Tor, das den Eingang bildet, bist ja grad reingekommen!");

   AddDetail( ({ "stapel" }),
      "Die Saecke stapeln sich zu hunderten neben- und uebereinander.");

   AddDetail( ({ "saecke", "volle saecke" }),
      "Der ganze Schuppen ist voll davon. Viele sind voll, andere sind leer.");

   AddDetail( ({ "leere saecke" }),
      "Am Boden bei der Rueckwand liegen etliche leere Saecke.");

   AddDetail( ({ "rueckwand" }),
      "An der Rueckwand befinden sich etliche Haken, an denen wohl Werkzeug "
      "aufgehaengt werden kann. Darunter befinden sich eine Menge leerer Saecke.");

   AddDetail( ({ "menge" }),
      "Es ist wirklich eine grosse Menge leerer Saecke.");

   AddDetail( ({ "haken" }),
      "Momentan haengt nichts an den Haken.");

   AddDetail( ({ "linke seite" }),
      "Entlang der linken Wand wurde ebenfalls bereits begonnen etliche Saecke "
      "zu stapeln. Ein Sack ist jedoch von dem Haufen heruntergefallen.");

   AddDetail( ({ "haufen" }),
      "Er ist wesentlich kleiner als der Stapel auf der rechten Seite. Aber Du "
      "kannst Dir vorstellen, dass das nicht lange so bleiben wird. Ein Sack "
      "ist von dem Haufen herunter gefallen.");

   AddDetail( ({ "sack" }),
      "Wie unordentlich! "
      "Dieser Sack liegt neben dem Haufen am Boden. Auf ihm befindet sich ein "
      "grosser Aufdruck. Er wird wohl herunter gefallen sein und liegt nun "
      "mitten am Gang. ");

   AddDetail( ({ "gang" }),
      "Es ist der freie Platz zwischen den Haufen auf der linken und dem Stapel "
      "auf der rechten Seite gemeint.");

   AddDetail( ({ "platz" }),
      "Der ist dazwischen frei, bis auf den einzelnen Sack der mitten im Gang "
      "am Boden liegt. Du solltest ihn aufheben und auf den Haufen legen bevor "
      "noch jemand darueber faellt.");

   AddDetail( ({ "aufdruck" }),
      "In grossen Lettern ist ein Text auf den Sack aufgedruckt.");

   AddDetail( ({ "letter", "lettern", "buchstaben" }),
      "Die Buchstaben sind relativ gross.");

   AddDetail( ({ "text" }),
      "Vielleicht solltest Du es mal mit lesen versuchen.");

   AddReadDetail( ({ "text" }),
      "=====================\n"
      "  H O L Z K O H L E  \n"
      "=====================");

   AddDetail( ({ "holzkohle", "kohle" }),
      "Wenns schon auf dem Saecken steht, wird auch wirklich Kohle drinnen sein.");
      
   AddDetail( ({ "boden" }),
      "Der Boden ist nicht einmal mit Brettern ausgelegt. Einfach fest "
      "gestampfte Erde. Neben dem Haufen auf der rechten Seite liegt ein Sack "
      "am Boden. Hinten liegen leere Saecke." );

   AddDetail( ({ "bretter" }),
      "Bretter sind keine vorhanden. Der Boden ist einfach fest gestampfte Erde.");
      
   AddDetail( ({ "erde" }),
      "Es handelt sich um die selbe Erde wie sie auch draussen vorkommt.");

   AddDetail( ({ "waende", "wand" }),
      "Die Waende sind aus Holz. Links siehst Du einen grossen Stapel mit "
      "Saecken. Rechts werden auch einige Saecke gelagert und an der Rueckwand "
      "kannst Du einige Haken erkennen." );

   AddDetail( ({ "decke" }),
      "Die Decke ist ebenfalls aus Holz und weit oben. Da kommst Du nie hinauf.");

   AddDetail( ({ "holz" }),
      "Scheint sich um Holz aus dem Wald zu handeln.");

   AddDetail( ({ "wald" }),
      "Den wirst Du in einem Schuppen sicher nicht finden!");

   AddCmd( ({ "hebe", "heb", "leg", "lege" }), "staple" );

   AddExit( "raus", "raus#./room_c5" );
}

int staple( string str )
{
   object ob;

   notify_fail( "Was willst Du wohin hinaufheben?\n" );
   if( str == "sack auf haufen hinauf" || str == "sack auf haufen" )
   {
      write("Du hebst den Sack auf und legst ihn auf den Haufen.\n");
       
      // getuid(TP) ist besser als TP->query_real_name()
      if( present("koehler_quest", TP ) && !present("koehler_saege", TP )
          && !CheckPlayer( getuid(TP) ))
      {
         write("Unter dem Sack hat sich eine Saege versteckt.\n");

         ob = clone_object(OBJ + "ksaege");
         if( ob->move(TP) == 1 )
         {
            write("Du nimmst sie sofort an Dich.\n");
            say( TPN + " scheint etwas gefunden zu haben.\n");
            
            SetPlayer( TP->query_real_name(), 1 );
         }
         else
         {
            // Spieler kanns nimmer tragen -> in den Raum
            ob->move(ME, M_NOCHECK);
            write( "Du kannst sie leider nicht mehr tragen!\n");
         }
      }
      
      if( find_call_out( "runter" ) == -1 )
          call_out("runter",2);
      
      return 1;
   }
   return 0;
}

void runter()
{
   if( ENV( TP ) == TO )
   {
      write("Der Sack faellt wieder vom Haufen runter.\n");
      say(TPN+" versucht den Sack auf den Haufen zu legen. Er faellt aber "
         "wieder runter.\n");
   }
}


