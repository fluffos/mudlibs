#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";
int heilwasser=1;

void create()

{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du stehst hier in einem Teil des Gartens, "
	   +"welcher zu dem Haus westlich von Dir gehoert. "
	   +"Vor Dir erhebt sich ein wunderschoener Brunnen "
	   +"aus schoenstem Marmor. Das Wasser plaetschert "
	   +"leise aus einem kleinen Loch in der Skulptur in "
	   +"der Mitte des Brunnens. Im Norden siehst Du ausserdem "
	   +"noch eine wunderschoene Linde. Alles hier sieht sehr "
	   +"gepflegt aus.\n");
  // ROOM DESCRIPTION END;
       
  // DETAILS START;
  AddDetail(("linde"),
	    "Die wahrlich wunderschoene Linde befindet sich im Norden.\n");
  AddDetail(("norden"),
	    "Da steht eine wunderschoene Linde.\n");
  AddDetail(("mitte"),
	    "In der Mitte des Brunnens steht eine Skulptur.\n");
  AddDetail(({"brunnen", "marmorbrunnen"}),
	    "Es ist ein wunderschoener Marmorbrunnen in dessen Mitte "
	    +"eine Skulptur steht.\n");
  AddDetail(("loch"),
	    "Aus einem Loch in der Skulptur fliesst Wasser in den Brunnen.\n");
  AddDetail(({"skulptur"}),
	    "Es duerfte sich bei der Skulptur um die Darstellung einer "
	    +"Seenymphe handeln. Aus einem Loch in der Skulptur fliesst Wasser "
	    +"in den Brunnen.\n");
  AddDetail(({"nymphe", "seenymphe", "darstellung"}),
	    "Die Darstellung der Seenymphe ist wirklich ueberaus genau "
	    +"in den Marmor gemeisselt worden. Ob der Kuenstler wohl ein "
	    +"reales Modell dazu hatte?\n");
  AddDetail(({"modell", "betrachtung", "kuenstler"}),
	    "Bei naeherer Betrachtung der Skulptur bist Du Dir ziemlich sicher, "
	    +"dass der Kuenstler ein reales Modell fuer die Skulptur hatte.\n");
  AddDetail(("marmor"),
	    "Es ist feinster weisser Marmor.\n");
  AddDetail(("wasser"),
	    "Das Wasser sieht angenehm kuehl und frisch aus. Vielleicht kann "
	    +"man ja etwas davon trinken.\n");
  AddDetail(("himmel"),
	    "Er ist strahlend blau. Du kannst kein Woelkchen an ihm sehen. "
	    +"Die Sonne scheint hell leuchtend von ihm herunter.\n");
  AddDetail(("sonne"),
	    "Sie scheint Dir angenehm auf Deine Haut.\n");
  AddDetail(("woelkchen"),
	    "Keines zu sehen.\n");
  AddDetail(("haut"),
	    "Das Deine Haut perfekt aussieht, hast Du eh schon immer gewusst.\n");
  AddDetail(("boden"),
	    "Du stehst auf einem perfekt gepflegtem Rasen.\n");
  AddDetail(("garten"),
	    "Er sieht auesserst gepflegt aus.\n");
  AddDetail(({"rasen", "gras"}),
	    "Der Rasen sieht saftig gruen und perfekt gepflegt aus.\n");
  AddDetail(({"haus", "soundmagierhaus"}),
	    "Es sieht sehr seltsam aus. Die Waende glitzern silbern und wirken irgendwie "
	    +"unnatuerlich. Wenn die Konstruktion den physikalischen "
	    +"Gesetzen gehorchen wuerde, wuerde es wahrscheinlich zusammenbrechen. "
	    +"Da scheint Magie benutzt worden zu sein.\n");
  AddDetail(("magie"),
	    "Du kannst sie direkt fuehlen.\n");
  AddDetail(({"gesetze", "Gesetzen"}),
	    "Das Haus wiedersetzt sich ihnen.\n");
  AddDetail(({"konstruktion"}),
	    "Die muesste normalerweise in sich zusammenstuerzen.\n");
  AddDetail(("teil"),
	    "Du befindest Dich in einem Teil des riesigen Gartens.\n");
  AddDetail(("waende"),
	    "Die Waende des Hauses glitzern unnatuerlich silbern.\n");
  AddDetail(({"hand", "haende"}),
	    "Deine Haende sind jetzt wieder schoen sauber.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst nichts aufregendes hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts besonderes.\n");
  // DETAILS END;

  // EXITS START;
  AddExit ("osten", ROOM("garten2"));
  AddExit ("suedosten", ROOM("garten1"));
  AddExit ("norden", ROOM("garten4"));
  // EXITS END;

  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  AddCmd(({"trink", "trinke"}), "trinke_was");
  AddCmd(({"wasche", "wasch"}), "wasch_was");
  // ITEMS START;
  // ITEMS END;

}

wasch_was(str)
{
  notify_fail("Was willst Du waschen? Vielleicht Deine Haende?\n");
  if ((str == "hand" || str == "haende"))
    {
      write (BS("Du waescht Deine Haende in dem Brunnen und fuehlst Dich wieder sauber.\n"));
      say (BS(TPN+" waescht seine Haende in dem Brunnen.\n"));
      return 1;
    }
  else return 0;
}

trinke_was(str)
{
  notify_fail("Was willst Du trinken?\n");
  if (str == "wasser")
    {
      if ((heilwasser == 1) || (heilwasser == 2) || (heilwasser == 3))
	{
	  write (BS("Du trinkst etwas von dem Wasser und fuehlst "
		    +"dich sogleich erfrischt.\n"));
	  say (BS(TPN+" trinkt etwas Wasser aus dem Brunnen.\n"));
	  TP->heal_self(10);
	  if (heilwasser==1)
	    {
	      heilwasser=2;
	      return 1;
	    }
	  if (heilwasser==2)
	    {
	      heilwasser=3;
	      return 1;
	    }
	  else
	    {
	      heilwasser=0;
	      return 1; 
	    }
	}
      else
	{
	  write (BS("Du trinkst etwas von dem erfrischendem Wasser.\n"));
	  say (BS(TPN+" trinkt etwas Wasser aus dem Brunnen.\n"));
	  return 1;
	}
    }    
  else return 0;
}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Sie fuehlt sich sehr angenehm an.\n"));
      return 1;
    }
  else return 0;
}

reset()
{
  heilwasser=1;
}











