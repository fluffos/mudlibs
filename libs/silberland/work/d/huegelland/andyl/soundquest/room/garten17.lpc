#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du stehst in einem Teil des grossen Gartens.\n"
	   +"Im Norden steht das seltsam aussehende Soundmagierhaus. "
	   +"Im Sueden verlaeuft ein weisser Gartenzaun neben den silberne Hecken "
	   +"angepflanzt wurden. Im Westen kannst Du ausserdem noch eine grosse "
	   +"Eiche entdecken. Alles hier wirkt so wunderbar friedlich.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("westen"),
	    "Da steht eine grosse Eiche.\n");
  AddDetail(("eiche"),
	    "Die Eiche steht von hier aus gesehen im Westen.\n");
  AddDetail(("norden"),
	    "Da steht ein Haus.\n");
  AddDetail(("sueden"),
	    "Da ist ein Zaun.\n");
  AddDetail(({"zaun", "holzzaun", "gartenzaun"}),
	    "Ein einfacher weisser Holzzaun.\n");
  AddDetail(("holz"),
	    "Das Holz des Zauns ist weiss gestrichen.\n");
  AddDetail(("himmel"),
	    "Absolut blau. Kein Woelkchen zu sehen. Einzig die Sonne scheint "
	    +"angenehm herunter.\n");
  AddDetail(({"sonne", "lust"}),
	    "Sie scheint schoen warm auf Dich herab. Du haettest jetzt "
	    +"wirklich Lust auf ein Sonnenbad.\n");
  AddDetail(("sonnenbad"),
	    "Naja, vielleicht spaeter.\n");
  AddDetail(("woelkchen"),
	    "Du suchst den Himmel genau ab. Du findest aber keines.\n");
  AddDetail(("boden"),
	    "Da ist ein perfekt gepflegter Rasen.\n");
  AddDetail(("garten"),
	    "Er sieht auesserst gepflegt aus.\n");
  AddDetail(("rasen"),
	    "Das nennt man einen wirklich gut gepflegten Rasen. Wer wohl der Gaertner ist?\n");
  AddDetail(("gaertner"),
	    "Den wuerdest Du wirklich gerne kennenlernen.\n");
  AddDetail(({"haus", "soundmagierhaus"}),
	    "Es sieht sehr seltsam aus. Die Waende glitzern silbern und wirken irgendwie "
	    +"unnatuerlich. Wenn die Konstruktion den physikalischen "
	    +"Gesetzen gehorchen wuerde, wuerde es wahrscheinlich zusammenbrechen. "
	    +"Da scheint Magie benutzt worden zu sein.\n");
  AddDetail(("magie"),
	    "Du kannst sie direkt fuehlen.\n");
  AddDetail(({"gesetze", "Gesetzen"}),
	    "Die scheinen auf das Haus nicht anwendbar zu sein.\n");
  AddDetail(({"konstruktion"}),
	    "Die muesste normalerweise in sich zusammenstuerzen.\n");
  AddDetail(("teil"),
	    "Du befindest Dich in einem Teil des riesigen Gartens.\n");
  AddDetail(("waende"),
	    "Von den Waenden des Hauses geht ein unnatuerlicher silberner Glanz aus.\n");
  AddDetail(("glanz"),
	    "Ein geheimnisvoller silberner, wahrscheinlich magischer, Glanz.\n");
  AddDetail(({"hecken", "hecke"}),
	    "Diese Hecken haben silberne Blaetter.\n");
  AddDetail(("blaetter"),
	    "Die sind silbern.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst nichts besonderes hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts aufregendes.\n");

  // DETAILS END;
  
  // EXITS START;
  AddExit ("osten", ROOM("garten18"));
  AddExit ("nordosten", ROOM("garten20"));
  AddExit ("nordwesten", ROOM("garten15"));
  AddExit ("westen", ROOM("garten16"));
  // EXITS END;

  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");

  // ITEMS START;
  // ITEMS END;

}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Fuehlt sich seltsam aber durchaus angenehm an.\n"));
      return 1;
    }
  else return 0;
}















