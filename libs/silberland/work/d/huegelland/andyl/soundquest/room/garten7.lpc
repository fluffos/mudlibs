#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

int mgrille_da=1;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du stehst in einem Teil des grossen Gartens.\n"
	   +"Hier wurde ein grosser Komposthaufen aufgestellt. Im Norden "
	   +"siehst Du den Zaun, der den Garten umschliesst und die parallel "
	   +"dazu angepflanzte Hecke. Im Westen siehst Du einen Holzschuppen "
	   +"und im Sueden befindet sich das geheimnisvolle Soundmagierhaus.\n");
  SetProp (P_NAME, "Unvorsicht");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("westen"),
	    "Da steht ein Holzschuppen.\n");
  AddDetail(({"schuppen", "holzschuppen"}),
	    "Im Westen kannst Du den Holzschuppen erkennen.\n");
  AddDetail(("teil"),
	    "Du befindest Dich in einem Teil des riesigen Gartens.\n");
  AddDetail(({"garten", "gartens"}),
	    "Der ist ziemlich gross und sieht zudem sehr schoen aus.\n");
  AddDetail(("boden"),
	    "Unter Dir ist ein sorgfaeltig gepflegter Rasen.\n");
  AddDetail(("rasen"),
	    "Wer immer den gepflegt hat, der hat gute Arbeit geleistet.\n");
  AddDetail(("arbeit"),
	    "Die Arbeit, den Rasen so hinzubringen, war wirklich erstklassig.\n");
  AddDetail(({"zaun", "holzzaun"}),
	    "Ein einfacher weisser Holzzaun.\n");
  AddDetail(("hecke"),
	    "Die Hecke hat vollig silberne Blaetter.\n");
  AddDetail(("blaetter"),
	    "Silberne Blaetter, sowas sieht man nicht oft.\n");
  AddDetail(("sueden"),
	    "Da steht das Soundmagierhaus.\n");
  AddDetail(("norden"),
	    "Da ist ein Zaun und eine Hecke.\n");
  AddDetail(("himmel"),
	    "Aus dem strahlend blauen Himmel scheint Dir die Sonne freudestrahlend "
	    +"entgegen.\n");
  AddDetail(("sonne"),
	    "Die Sonne scheint Dir angenehm auf die Haut.\n");
  AddDetail(("haut"),
	    "Die koennte vielleicht noch etwas mehr Sonne gebrauchen.\n");
  AddDetail(({"haus", "soundmagierhaus"}),
	    "Geheimnisvoll steht im Sueden das Soundmagierhaus. "
	    +"Wenn da nicht Magie wirksam waere, wuerde das ganze "
	    +"Gebilde wahrscheinlich in sich zusammenstuerzen.\n");
  AddDetail(("magie"),
	    "Die kann man hier direkt fuehlen.\n");
  AddDetail(("gebilde"),
	    "Das Haus ist ein wirklich sehr abenteuerliches Gebilde.\n");
  AddDetail(({"komposthaufen", "haufen"}),
	    "Der Komposthaufen ist hier ordentlich aufgebaut worden. In ihm "
	    +"liegen biologische Abfaelle aus denen wieder einmal fruchtbare Erde "
	    +"werden soll. Ein etwas eigener Geruch geht von ihm aus.\n");
  AddDetail(("kompost"),
	    "Davon liegt genug auf dem Komposthaufen.\n");
  AddDetail(("geruch"),
	    "Riech ihn doch einfach.\n");
  AddSmell(("geruch"),
	   "Nunja, der riecht irgendwie biologisch.\n");
  AddDetail(("erde"),
	    "Fruchtbare Erde wird hoffentlich einmal aus den biologischen Abfaellen "
	    +"werden.\n");
  AddDetail(({"abfaelle", "abfaellen", "abfall"}),
	    "Da liegt so einiges an biologischem Abfall wie z.B. Bananenschalen. "
	    +"In dem ganzen Abfall kannst Du ein Loch entdecken.\n");
  AddDetail(({"schalen", "bananenschalen"}),
	    "Die sehen schon etwas verrottet aus.\n");
  AddDetail(("loch"),
	    "In dem Loch scheint irgendetwas drinnen zu sein. Ob es ratsam ist "
	    +"dort hineinzugreifen?\n");
  AddDetail(("bananenschalen"),
	    "Die verrotten hier schoen langsam.\n");
  AddDetail(("hand"),
	    "Die ist aber schmutzig. Die solltest Du sofort wieder waschen.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst ein leises Schaben hoeren.\n");
  AddSound(("schaben"),
	   "Es kommt aus dem Abfall.\n");
  AddSmell (({"haufen", "abfaelle"}),
	    "Riecht umwerfend. Wurgs...\n");
  AddSmell( ({DEFAULT_SMELL,}),
	    "Es riecht hier aeusserst biologisch. Mhhh...\n");
  
  // DETAILS END;
  
  // EXITS START;
  AddExit ("osten", ROOM("garten6"));;
  AddExit ("sueden", ROOM("garten8"));
  // EXITS END;

  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  AddCmd(({"greife", "greif"}), "greife_in");

  // ITEMS START;
  // ITEMS END;

}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Die Magie fuehlt sich irgendwie weich aber dennoch sehr "
	    +"kraeftig an.\n"));
      return 1;
    }
  else return 0;
}

greife_in(str)
{
  object mg;
  notify_fail("In was willst Du greifen?\n");
  if (str == "in loch")
    {
      if (mgrille_da == 1)
	{
	  write(BS("Du greifst in das Loch und wirst von irgendetwas "
		+"ordentlich in den Arm gezwickt und ploetzlich kriecht "
		+"etwas aus dem Loch hervor.\n"));
	  say (BS(this_player()->name(WER,2)+" wuehlt im Abfall und zuckt ploetzlich "
	       +"zurueck.\n"));
	  TP->do_damage(10);
	  (mg = clone_object(NPC("mgrille")))->move(TO, M_NOCHECK);
	  mg->Kill(TP);
	  mgrille_da=0;
	  return 1;
	}
      else 
	{
	  write (BS("Du greifst in das Loch findest dort aber nichts.\n"
		 +"Dafuer ist Deine Hand jetzt schmutzig.\n")); 
	  return 1;
	}
    }
  else return 0;
}

reset()
{
  ::reset();
    mgrille_da=0;
}


















