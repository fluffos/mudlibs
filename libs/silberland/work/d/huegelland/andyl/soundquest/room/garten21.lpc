#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du befindest Dich in einem Teil des Gartens, "
	   +"der das Haus westlich von Dir umgibt. Der Garten ist in "
	   +"einem tadellosen Zustand. Alles hier wurde sorgfaeltig "
	   +"gepflegt. Besonders der Rasen sieht sehr gepflegt aus. "
	   +"Ausserdem steht hier ein Liegestuhl.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(("teil"),
	    "Hier ist ein Teil des grossen Garten.\n");
  AddDetail(({"liegestuhl", "stuhl"}),
	    "Ein hoelzerner Liegestuhl aus Buchenholz. Ein Polster "
	    +"liegt auf ihm. Auf den Liegestuhl kann man sich sicher "
	    +"legen und ein angenehmes Sonnenbad nehmen.\n");
  AddDetail(("sonnenbad"),
	    "Leg Dich doch einfach auf den Liegestuhl und nimm "
	    +"ein gemuetliches Sonnenbad.\n");
  AddDetail(({"holz", "buchenholz"}),
	    "Einfaches Buchenholz.\n");
  AddDetail(("polster"),
	    "In den kann man sich sicher gut reinkuscheln.\n");
  AddDetail(("himmel"),
	    "Noch blauer koennte er kaum noch sein. Allein die "
	    +"Sonne scheint gelblich aus dem Blau hervor.\n");
  AddDetail(("Sonne"),
	    "So schoen wie jetzt sollte sie oefter scheinen.\n");
  AddDetail(("blau"),
	    "Ein sehr schoenes Blau.\n");
  AddDetail(("garten"),
	    "Der wurde traumhaft gepflegt.\n");
  AddDetail(("zustand"),
	    "Viel besser kriegt man das nicht mehr hin.\n");
  AddDetail(("boden"),
	    "Unter Dir ist ein wirklich schoener Rasen.\n");
  AddDetail(("rasen"),
	    "Der sieht ja perfekt aus. Naja, fast perfekt. Ein kleiner "
	    +"Erdhuegel faellt Dir unter der Hauswand auf.\n");
  AddDetail(({"wand", "hauswand"}),
	    "Ganz unten siehst Du einen kleinen Erdhuegel.\n");
  AddDetail(({"erdhuegel", "huegel"}),
	    "Er besteht aus einer roten Erde.\n");
  AddDetail(("erde"),
	    "Die Erde hat eine rote Farbe. Vielleicht kannst Du "
	    +"ja darin graben.\n");
  AddDetail(("farbe"),
	    "Die ist rot.\n");
  AddDetail(("haus"),
	    "Es ist seltsam, dass dieses Haus steht. Bei der Bauweise "
	    +"muessten die Waende eigentlich in sich zusammenstuerzen.\n");
  AddDetail(("bauweise"),
	    "Die ist wahrlich ziemlich seltsam.\n");
  AddDetail(("waende"),
	    "Von ihnen geht ein seltsames silbernes Schimmern aus.\n");
  AddDetail(("schimmern"),
	    "Das Schimmern wird sicher durch Magie erzeugt.\n");
  AddDetail(("magie"),
	    "Man kann sie hier direkt fuehlen.\n");
  AddDetail(("kribbeln"),
	    "Das ist irgendwie angenehm.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst nichts aufregendes hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts besonderes.\n");

  // DETAILS END;

  // EXITS START;
  AddExit ("osten", ROOM("garten22"));
  AddExit ("nordosten", ROOM("garten1"));
  AddExit ("sueden", ROOM("garten20"));
  // EXITS END;

  AddCmd(({"grabe", "grab"}), "grabe_in");
  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  AddCmd(({"leg", "lege", "lieg", "liege"}), "lege_auf");
  
  // ITEMS START;
  // ITEMS END;
  
}

lege_auf(str)
{
  notify_fail("Auf was willst Du Dich legen?\n");
  if ((str == "auf liegestuhl" || str == "liegestuhl" || str == "in liegestuhl"
       || str == "auf stuhl" || str == "stuhl" || str == "in stuhl"))
    {
      write (BS("Du legst Dich auf den Liegestuhl kuschelst Dich in "
	    +"das Polster und nimmst ein angenehmes Sonnenbad und "
	    +"fuehlst Dich danach ausserordentlich wohl.\n"));
      say (BS(TP->query_real_name(WER, 2)+" nimmt auf dem Liegestuhl "
	  +"Platz kuschelt sich in das Polster und nimmt ein "
	  +"Sonnenbad und erhebt sich danach wieder erfrischt.\n"));
      return 1;
    }
  else return 0;
}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Du versuchst die Magie zu fuehlen und "
	    +"wirst mit einem angenehmen Kribbeln belohnt.\n"));
      return 1;
    }
  else return 0;
}

grabe_in(str)
{
  object ob;
  notify_fail("Worin willst Du graben?\n");
  if (str == "in erdhuegel" || str == "in erde" || str == "in huegel" || 
      str == "huegel" || str == "erde" || str == "erdhuegel")
    {
      if (!ob=present(("\nsqquestitem"),TP))
	{
	  write (BS("Du musst das jetzt noch nicht machen. Probier "
		+"es spaeter noch einmal.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("\nsqerde"), TP))
	    {
	      write (BS("Du graebst etwas in der roten Erde und steckst "
		     +"ein klein wenig davon ein.\n"));
	      say (BS(this_player()->name(WER,2)+" graebt ein wenig in der Erde.\n"));
	      CLONE(OBJ("erde"),(TP));
	      return 1;
	    }
	  else
	    {
	      write (BS("Das musst Du nicht nocheinmal machen.\n"));
	      return 1;
	    }
	}
    }
  else return 0;
}















