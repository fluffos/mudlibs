#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Eine Bibliothek");
  SetProp (P_INT_LONG, "Du befindest Dich in einer gar nicht so kleinen Bibliothek. "
	   +"Hier stehen unzaehlige Regale in denen Buecher ueber alle moeglichen "
	   +"Themen aufbewahrt werden. Vom Buchstaben A bis zum Buchstaben Z ist alles "
	   +"schoen sortiert hier eingeordnet. Hier findet man sicher einige interessante "
	   +"Informationen.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail (({"raum", "bibliothek"}),
	     "Dieser Raum dient als gewaltige Bibliothek.\n");
  AddDetail (({"regale", "regal"}),
	     "Hier stehen unzaehlige Regale aus solidem Eichenholz in denen massenhaft "
	     "Buecher stehen.\n");
  AddDetail (({"eichenholz", "holz"}),
	     "Ein traumhaft solides Holz.\n");
  AddDetail (("boden"),
	     "Der Boden ist aus Eichenholz.\n");
  AddDetail (("decke"),
	     "Sie ist aus Eichenholz. An ihr haengen mehrere Lampen.");
  AddDetail (("lampen"),
	     "Die Lampen leuchten den Raum gut aus.\n");
  AddDetail (("lampe"),
	     "Hier gibt es mehrere Lampen.\n");
  AddDetail (("waende"),
	     "Die sind aus Eichenholz.\n");
  AddDetail (("wand"),
	     "Sie ist aus Eichenholz.\n");
  AddDetail (("soundmagier"),
	     "Der scheint gerade nicht hier zu sein.\n");
  AddDetail (({"information", "informationen"}),
	     "In den Buechern findest Du sicher viele Informationen.\n");     
  AddDetail (({"buecher", "buch"}),
	     "Du siehst hier sehr viele Buecher die sehr ordentlich vom Buchstaben A bis "
	     "zum Buchstaben Z sortiert sind.\n"); 
  AddDetail (({"themen"}),
	     "Davon gibt es in den Buechern sicher sehr viele.\n");
  AddDetail (({"buchstaben"}),
	     "Die Buecher hier sind nach Buchstaben geordnet. Vom Buchstaben A bist Z "
	     +"ist hier alles vertreten. Du kannst ja mal die einzelnen Buchstaben untersuchen.\n"); 
  AddDetail(("goetter"),
	    "Die sind allgegenwaertig. Nur siehst Du sie nicht.\n");
  AddDetail (({"buchstabe a", "a", "astrologie", "humbug"}),
	     "Du siehst nur so uninteressante Buecher wie: 'Astrologie - Humbug oder mehr?' \n");
  AddDetail (({"buchstabe b", "b", "tod", "balrog"}),
	     "Nur so fade Themen wie: `Der Tod des Balrog' \n");  
  AddDetail (({"buchstabe c", "c", "carryon", "zweiti"}),
	     "Auch nicht weiter interessante Themen wie: `Carryon - mein Leben als Zweiti'\n");
  AddDetail (({"buchstabe d", "d", "phantom", "midas"}),
	     "Du siehst ein Buch: 'Das Phantom von Midas'. Uninteressant.\n");
  AddDetail (({"buchstabe e", "e", "erzmagier"}),
	     "Du entdeckst ein Buch: 'Erzmagier unter sich'. Scheint aber nicht "
	     +"weiter interessant zu sein.\n");
  AddDetail (({"buchstabe f", "f", "fraegfstui", "buchtitel"}),
	     "Du liest: 'Fraegfstui'. Ein hoechst seltsamer Buchtitel.\n");
  AddDetail (({"buchstabe g", "g", "goetterprobleme", "gott", "zwerge"}),
	     "Du siehst zwar nichts wichtiges aber ein Buch hat einen netten Titel: "
	     "'Goetterprobleme - Goetter sind ja auch nur Zwerge'\n");
  AddDetail (({"buchstabe h", "h", "hilfe", "geldzweiti"}),
	     "Uninteressante Buecher wie: 'Hilfe, mein Geldzweiti wurde geloescht'\n");  
  AddDetail (({"buchstabe i", "i", "ich", "rok"}),
	     "Unwichtige Buecher wie: `Ich und der Rok'\n");
  AddDetail (({"buchstabe j", "j", "unterwelt", "jodeln"}),
	     "Buecher wie: 'Jodeln in der Unterwelt' braucht doch wirklich keiner.\n");
  AddDetail (({"buchstabe k", "k", "kum", "bauanhof"}),
	     "Nur so uninteressante Themen wie: 'Kum zum Bauanhof'\n");
  AddDetail (({"buchstabe l", "l", "laster", "summe"}),
	     "Unwichtige Themen wie: 'Laster - Die Summe aller bleibt immer konstant.'\n");
  AddDetail (({"buchstabe m", "m", "merlin", "laermempfindliche"}),
	     "Du siehst ein Buch: 'Merlin der Laermempfindliche'. Ist aber unwichtig. In einer "
		 "der letzten Seiten findest du eine handgeschriebene Notiz mit dem Titel 'Schlaflied "
		 "fuer einen Drachen II'. Sieht interessant aus.\n");
  AddDetail (({"buchstabe n", "n", "nahtlose", "aufklaerung", "balzverhalten", "ziegelsteinen"}),
	     "Manche Buecher koennen schon sehr unnoetig sein wie: 'Nahtlose Aufklaerung ueber "
	     +"das Balzverhalten von Ziegelsteinen'\n");  
  AddDetail (({"buchstabe o", "o"}),
	     "Nur so fade Themen wie: `Oestlich von Polaris' \n");
  AddDetail (({"buchstabe p", "p", "planschen", "bucht", "tijara"}),
	     "Auch nicht weiter interessante Themen wie: 'Planschen in der Bucht von Tijara'\n");
  AddDetail (({"buchstabe q", "q", "quasimodo", "hunchback"}),
	     "Du entdeckst ein Buch 'Quasimodo oder Hunchback?'. Scheint aber nicht "
	     +"weiter interessant zu sein.\n");
  AddDetail (({"buchstabe r", "r" ,"sicherheitshinweise", "reboot" }),
	     "Du siehst zwar nichts wichtiges aber ein Buch hat einen netten Titel: "
	     +"'Reboot: Wenn die Goetter zuernen - wichtige Sicherheitshinweise'\n");
  AddDetail (({"buchstabe s", "s", "slartibart", "ankh"}),
	     "Du siehst ein Buch 'Slartibart - Wozu er das Ankh wirklich braucht.' Unwichtig.\n");
  AddSpecialDetail (({"buchstabe t", "t", }), "traenkebuch_her");  
  AddDetail (({"buchstabe u", "u", "silberland"}),
	     "Du siehst nur so uninteressante Buecher wie: 'Unter dem Silberland'\n");
  AddDetail (({"buchstabe v", "v"}),
	     "Du siehst ein Buch: 'Vielleicht klappts jetzt'. Uninteressant\n");
  AddDetail (({"buchstabe w", "w", "magiersprueche"}),
	     "Auch nicht weiter interessante Themen wie: 'WAS HAB ICH NUR ANGERICHTET! und andere "
	     +"beliebte Magiersprueche'\n");
  AddDetail (({"buchstabe x", "x", "xylophone"}),
	     "Nur so uninteressante Themen wie: 'Xylophone - Es gibt auch magische!'\n");
  AddDetail (({"buchstabe y", "y", "yodelpeaken", "geheimnis"}),
	     "Unwichtige Buecher wie: 'Yodelpeaken - Das grosse Geheimnis'\n");
  AddDetail (({"buchstabe z", "z", "buchstabe"}),
	     "Uninteressante Buecher wie: 'Z - Wie entstand der Buchstabe'.\n");
  AddSound( DEFAULT_SOUND,
	    "Es ist absolut still hier. Typisch Bibliothek.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts ausser dem Geruch von alten Buechern.\n");

  AddSpecialDetail(({"schlaflied", "notiz", "schlaflied fuer einen drachen"}), "det_schlaflied");
  // DETAILS END;
  
  // EXITS START;
  AddExit ("nordosten", ROOM("0_room6"));
  AddExit ("osten", ROOM("0_room8"));
  // EXITS END;
  
  // ITEMS START;
  // ITEMS END;

}


public string det_schlaflied() {
	string str, fulltext;
	int i;
  
	fulltext = call_other("/d/kristallwald/sargola/lichtung/npc/d", "GetSchlaflied", 5, 10);
  
	str = "Da steht:\n\nSchlaflied fuer einen Drachen II\n\n"+fulltext+"\nDas solltest du dir merken. Koennte mal nuetzlich sein!\n";
	if(TP->QueryProp(P_GUILD) == "bardengilde" && TP->QuerySkill("abendstille ueberall") == 0) {
	  str += BS("Wenn du das einen Drachen genau so, Zeile fuer Zeile, vorsingst, wird er wohl einschlafen. Es darf "
			 "dir jedoch kein Fehler passieren. Also merke es dir gut!\n");
	}
  
	return str;
  }
  

traenkebuch_her()
{
  object ob, ob1;
  
  if (!ob=present(("\nsqquestitem"),TP))
    {
      return (BS("Sieht alles nicht sehr interessant aus.\n"));
    }  
  else
    {
      if (!ob=present(("\nsqtrankbuch"),TP))
	{
	  ob1=clone_object(OBJ("trankbuch"));
	  if (ob1->move(TP,M_GET|M_SILENT) == ME_TOO_HEAVY)
	    {
	      return (BS("Ein Buch hier scheint ueberaus interessant zu sein. Der "
			 +"Titel lautet: 'Traenke: Die Welt der Zaubertraenke'. Leider "
			 +"kannst Du aber nichts mehr tragen, sonst wuerdest Du es "
			 +"mitnehmen. Vielleicht solltest Du etwas Unnoetiges "
			 +"ablegen.\n"));
	      ob1->remove();
	    }
	  else
	    {
	      say (BS(this_player()->name(WER,2)+" nimmt ein Buch aus dem Regal "
		      +"und steckt es ein.\n"));
	      return (BS("Ein Buch hier scheint ueberaus interessant zu sein. Der "
			 +"Titel lautet: 'Traenke: Die Welt der Zaubertraenke'. Du beschliesst "
			 +"es mitzunehmen.\n"));
	    }
	}
      else 
	{
	  return (BS("Aber das hast Du doch schon untersucht.\n"));
	}
    }
}
  









