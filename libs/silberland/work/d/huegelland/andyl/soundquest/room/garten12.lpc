#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Gemuesegarten");
  SetProp (P_INT_LONG, "Du befindest Dich in einem Gemuesegarten.\n"
	   +"Um Dich herum sind einige Gemuesebeete in denen allerlei "
	   +"Gemuese angepflanzt wurde und ein kleines Kraeuterbeet. "
	   +"Westlich von Dir verlaeuft der "
	   +"Zaun, welcher den Garten umschliesst und die parallel dazu "
	   +"angepflanzte Hecke. Und im Osten steht das beeindruckende "
	   +"Haus.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("garten"),
	    "Der ist ziemlich gross und ueberdies sorgfaeltigst gepflegt.\n");
  AddDetail(("himmel"),
	    "Aus dem wolkenfreien, strahlend blauen Himmel scheint Dir "
	    +"dir die Sonne wohlgesonnen entgegen.\n");
  AddDetail(("sonne"),
	    "Sie scheint Dir wohlgesonnen aus dem Himmel entgegen.\n");
  AddDetail(("gemuesegarten"),
	    "Du stehst hier in einem Gemuesegarten.\n");
  AddDetail(("boden"),
	    "Am Boden siehst Du einen kleinen Weg der zwischen den einzelnen "
	    +"Gemuesebeeten hindurchfuehrt.\n");
  AddDetail(({"erde", "humus"}),
	    "In den Beeten scheint eine sehr naehrstoffreiche Erde (auch als Humus "
	    +"bekannt) zu sein.\n"); 
  AddDetail(("weg"),
	    "Der Weg besteht aus flachen Steinen die einfach auf das Gras "
	    +"gelegt wurden.\n");
  AddDetail(("gras"),
	    "Zwischen den Steinen kannst Du das gruene Gras sehen.\n");
  AddDetail(({"steine", "stein"}),
	    "Es sind einfache, grosse, flache Steine.\n");
  AddDetail(({"zaun", "holzzaun"}),
	    "Ein einfacher weisser Holzzaun.\n");
  AddDetail(("hecke"),
	    "Sie verlaeuft parallel zum Zaun und hat silberne Blaetter.\n");
  AddDetail(("blaetter"),
	    "Die Blaetter sind vollkommen silbern. Sowas ist nicht "
	    +"unbedingt haeufig.\n");
  AddDetail(("osten"),
	    "Da steht das beeindruckende Soundmagierhaus.\n");
  AddDetail(({"haus", "soundmagierhaus"}),
	    "Das Haus ist etwas seltsam aber durchaus beeindruckend gebaut. "
	    +"Bei dieser Bauweise wuerde jedes andere Haus zusammenbrechen. "
	    +"Dies scheint hier jedoch durch Magie verhindert zu werden.\n");
  AddDetail(("bauweise"),
	    "Die ist seltsam aber durchaus beeindruckend.\n");
  AddDetail(("magie"),
	    "Die kann man hier direkt fuehlen.\n");
  AddDetail(({"gemuesebeete", "beete", "gemuesebeet", "beet"}),
	    "Du kannst hier einige Gemuesebeete sehen in denen "
	    +"allerlei Gemuese waechst. Ausserdem siehst Du ein "
	    +"kleines Kraeuterbeet.\n");
  AddDetail(("gemuese"),
	    "Du siehst hier etwas Meerrettich (auch Kren genannt) und ein paar Zwiebeln.\n");
  AddDetail(({"meerrettich", "kren", "rettich"}),
	    "Der scheint noch nicht reif zu sein sonst wuerdest Du "
	    +"den sofort reiben und Dir eine kleine Brettljausn machen.\n");
  AddDetail(("brettljausn"),
	    "Eine Brettljausn mit geriebenem Meerrettich waer jetzt so "
	    +"was richtig feines (der Kren brennt ja so schoen).\n");
  AddDetail(({"zwiebeln", "zwiebel"}),
	    "Irgendwie bekommst Du bei dem Anblick Appetit auf eine "
	    +"Zwiebelsuppe.\n");
  AddDetail(({"anblick", "appetit"}),
	    "Bei dem Anblick der Zwiebeln bekommst Du ploetzlich Appetit "
	    +"auf eine Zwiebelsuppe.\n");
  AddDetail(({"zwiebelsuppe", "suppe"}),
	    "So eine Zwiebelsuppe haettest Du jetzt gerne (nur moechtest "
	    +"du die Zwiebeln dazu nicht schneiden).\n");
  AddDetail(("kraeuterbeet"),
	    "Da siehst Du etwas Petersilie, ein wenig Kresse "
	    +"und einige Kraeuter die Du nicht kennst.\n");
  AddDetail(("petersilie"),
	    "Ganz normale Petersilie.\n");
  AddDetail(("kresse"),
	    "Im Kraeuterbeet ist ein wenig Kresse. Vielleicht kannst "
	    +"du davon ein bisschen was ausrupfen.\n");
  AddDetail(("kraeuter"),
	    "Ausser der Kresse und der Petersilie kennst Du keine "
	    +"von diesen Kraeutern. Die sehen jedoch ueberaus interessant "
	    +"aus.\n");
  AddSound( DEFAULT_SOUND,
	    "Hier hoerst Du nichts interessantes.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht hier nach Gemuese und nach Kraeutern.\n");
  AddSmell(({"zwiebeln", "zwiebel"}),
	   "Die riechen so als koennte man daraus eine gute Zwiebelsuppe machen.\n");
  AddSmell(({"meerrettich", "kren"}),
	   "Der riecht schoen scharf.\n");
  AddSmell(("kraeuter"),
	   "Die riechen sehr eigen, aber dennoch ausgesprochen gut.\n");
  AddSmell(({"petersilie", "kresse"}),
	   "Die riecht gut.\n");
  // DETAILS END;

  // EXITS START;
  AddExit ("norden", ROOM("garten10"));
  AddExit ("sueden", ROOM("garten13"));
  // EXITS END;

  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  AddCmd(({"rupfe", "rupf"}), "rupfe_aus");

  // ITEMS START
  // ITEMS END

}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Du laesst die Magie auf Dich wirken "
	    +"und empfindest sie als aufregend geheimnisvoll.\n"));
      return 1;
    }
  else return 0;
}

rupfe_aus(str)
{
  object ob;
  notify_fail("Was willst Du ausrupfen?\n");
  if (str == "kresse aus")
    {
      if (!ob=present(("\nsqquestitem"),TP))
	{
	  write (BS("Vorlaeufig brauchst Du keine Kresse. "
		+"Vielleicht versuchst Du es spaeter noch "
		+"einmal.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("\nsqkresse"),TP))
	    {
	      write (BS("Du rupfst etwas Kresse aus und "
		    +"steckst sie ein.\n"));
	      say (BS(this_player()->name(WER,2)+" rupft etwas Kresse aus.\n"));
	      CLONE(OBJ("kresse"),(TP));
	      return 1;
	    }
	  else 
	    {
	      write (BS("Aber Du hast doch schon etwas Kresse.\n"));
	      return 1;
	    }
	}
    }
  else return 0;
}


      











