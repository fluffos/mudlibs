#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Eine Speisekammer");
  SetProp (P_INT_LONG, "Du befindest Dich in der Speisekammer des Hauses.\n"
	   +"Ueberall stehen Regale die mit koestlichen Speisen gefuellt sind herum. "
	   +"Der Duft von all diesen Koestlichkeiten steigt Dir in die Nase. "
	   +"Hier kriegt man ja so richtig Appetit.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(({"kammer", "speisekammer", "raum"}),
	    "Dieser Raum ist die Speisekammer des Hauses.\n");
  AddDetail(("haus"),
	    "Du befindest Dich gerade im Haus des Soundmagiers.\n");
  AddDetail(("soundmagier"),
	    "Er scheint gerade nicht zuhause zu sein.\n");
  AddDetail(({"boden", "holzboden"}),
	    "Ein einfacher Holzboden aus solidem Eichenholz.\n");
  AddDetail(({"holz", "eichenholz"}),
	    "Das Eichenholz ist sehr robust.\n");
  AddDetail(("decke"),
	    "Die Decke ist komplett aus Stein. Ein Kristall haengt dort oben.\n");
  AddDetail(("kristall"),
	    "Der Kristall strahlt ein Licht aus, welches den ganzen Raum erfuellt.\n");
  AddDetail(("licht"),
	    "Es geht von dem Kristall an der Decke aus.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende sind voellig aus Stein.\n");
  AddDetail(({"regal", "regale"}),
	    "In den unzaehligen Regalen befinden sich verschiedenste Koestlichkeiten.\n");
  AddDetail(({"koestlichkeiten", "speisen"}),
	    "In den Regalen befinden sich massenhaft verschiedenster Koestlichkeiten und "
	    +"Speisen aus dem Silberland.\n");
  AddDetail(({"silberland", "detail"}),
	    "Das glaubst Du wohl selbst nicht, dass Du das ganze Silberland "
	    +"in einem Detail untersuchen kannst.\n");
  AddDetail(("nase"),
	    "Mit der kannst Du riechen.\n");
  AddDetail(("duft"),
	    "Du kannst ihn riechen.\n");
  AddDetail(("appetit"),
	    "Dein Appetit steigt hier kraeftig an.\n");
  AddSmell(("duft"),
	   "Du riechst den Duft von Speck, Brot, Mehlspeisen, Obst, und " 
	   +"vor allem von Knoblauch.");
  AddDetail(({"speck", "an speck"}),
	    "Der sieht lecker aus.\n");
  AddSmell(("speck"),
	   "Ah, der riecht gut.\n");
  AddDetail(("brot"),
	    "Scheint noch ganz frisch zu sein. Daran sollte man direkt riechen.\n");
  AddSmell(({"brot", "an brot"}),
	   "Als Du an dem Brot riechst (welches traumhaft riecht), dringt Dir ein "
	   +"weiterer unangenehmer Nebengeruch an die Nase.\n");
  AddDetail(("mehlspeisen"),
	    "Dein Magen heult laut auf als Du die Mehlspeisen betrachtest.\n");
  AddSmell(({"mehlspeisen", "mehlspeise"}),
	   "Die duften herrlich.\n");
  AddDetail(("magen"),
	    "Allmaehlich koennte der aber aufhoeren zu brummen.\n");
  AddDetail(("obst"),
	    "Sieht koestlich aus.\n");
  AddSmell(("obst"),
	   "Es riecht traumhaft.\n");
  AddDetail(("knoblauch"),
	    "Riech mal daran.\n");
  AddSmell(("knoblauch"),
	   "Puhh, der riecht aber intensiv.\n");
  AddDetail(("stein"),
	    "Gewoehnlicher Stein.\n");
  AddDetail(("geruch"),
	    "Du kannst ihn ja riechen.\n");
  AddDetail(("nebengeruch"),
	    "Du kannst ihn riechen.\n");
  AddSmell(("nebengeruch"),
	   "Der unangenehme Nebengeruch duerfte aus einer Nische kommen.\n");
  AddSmell(({"koestlichkeiten", "speisen"}),
	   "Die duften herrlich.\n");
  AddSpecialDetail(("nische"), "nische_schau");
  AddSound( DEFAULT_SOUND,
	    "Es ist absolut still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst den Duft der schmackhaften Koestlichkeiten hier.\n");
  
  // DETAILS END;

  // EXITS START;
  AddSpecialExit (("suedwesten"), "suedwesten_geh");
  AddExit ("sueden", ROOM("0_room2"));
  // EXITS END;

  // ITEMS START;
  // ITEMS END;

  previous_object()->CustomizeObject(); 
}

suedwesten_geh()
{  
  TP->move(ROOM("0_room4:"+getuid(this_player())), M_GO);
  return 1;
}

nische_schau()
{
  object ob;
  if (!ob=present(("\nsqquestitem"),TP))
    {
      return (BS("Du findest nichts besonderes in der Nische. Probier es spaeter nochmal.\n"));
    }  
  else
    {
      if (!ob=present(("\nsqkaese"),TP))
	{
	  CLONE(OBJ("kaese"),(TP));
	  say (BS(this_player()->name(WER,2)+" findet etwas in einer Nische und "
		  +"steckt es ein.\n"));
	  return (BS("Du untersuchst die Nische und findest ein kleines Stueck "
		  +"Kaese, welches Du sofort einsteckst.\n"));
	}
      else 
	{
	  return (BS("Du hast die Nische doch schon untersucht.\n"));
	}
    }
}







