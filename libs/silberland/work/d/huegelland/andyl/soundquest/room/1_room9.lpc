#include <properties.h>
#include <moving.h>
#include "../files.h"

#pragma strong types;

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Ein Stiegenhaus");
  SetProp (P_INT_LONG, "Du befindest Dich in einem einfachen Stiegenhaus.\n"
	   + "Eine Stiege fuehrt von hier in den zweiten Stock.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("stock"),
	    "Du befindest Dich hier im ersten Stock.\n");
  AddDetail(({"raum", "stiegenhaus"}),
	    "Du befindest Dich hier in einem Stiegenhaus.\n");
  AddDetail (("boden"),
	     "Der Boden besteht aus dunkelblauen Fliesen.\n");
  AddDetail (({"fliesen", "farbe"}),
	     "Die Fliesen haben eine dunkelblaue Farbe.\n");
  AddDetail (("stiege"),
	     "Die Stiege ist aus Stein und fuehrt in den zweiten Stock hinauf.\n");
  AddDetail (({"waende", "wand"}),
	     "Die Waende sind komplett aus Stein und haben einen schwarzen Anstrich.\n");
  AddDetail (("anstrich"),
	     "Der Anstrich ist schwarz.\n");
  AddDetail (("decke"),
	     "Die Decke ist aus Stein und hat einen schwarzen Anstrich.\n");
  AddDetail (("stein"),
	     "Stein, hart aber herzlich.\n");
  AddSound( DEFAULT_SOUND,
	    "Es ist absolut still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du kannst nichts besonderes riechen.\n");
  // DETAILS END;
  
  // EXITS START;
  AddExit ("nordosten", ROOM("1_room2"));
  AddExit ("suedosten", ROOM("1_room4"));
  AddSpecialExit (("rauf"), "rauf_geh");
  
  // EXITS END;
  
  // ITEMS START;
  // ITEMS END;

  previous_object()->CustomizeObject(); 
}

rauf_geh()
{  
  TP->move(ROOM("2_room1:"+getuid(this_player())), M_GO);
  return 1;
}



















