#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Ein Empfangsraum");
  SetProp (P_INT_LONG, "Du befindst Dich hier in einem Empfangsraum.\n"
	   +"Hier werden normalerweise Gaeste von dem Soundmagier empfangen. "
	   +"Nur scheint der Hausbesitzer gerade nicht im Haus zu sein. "
	   +"An der Ostwand haengt ein kleines Bild und an der Westwand "
	   +"ein grosses Schwert, unter dem eine Tafel haengt. Ausserdem "
	   +"steht da noch ein kleiner Tisch und zwei Sessel.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(({"raum", "empfangsraum"}),
	    "Dieser Raum dient als Empfangsraum wo normalerweise Gaeste empfangen "
	    +"werden.\n");
  AddDetail(({"tisch", "holztisch"}),
	    "Ein einfacher ungeschmueckter Holztisch.\n");  
  AddDetail(({"gaeste", "gast"}),
	    "Du siehst hier keine Gaeste.\n");
  AddDetail(({"sessel", "holzsessel"}),
	    "Es sind zwei einfache Holzsessel. Wenn Du willst kannst Du Dich "
	    +"darauf setzen.\n");
  AddDetail(({"soundmagier", "hausbesitzer"}),
	    "Der scheint gerade nicht hier zu sein.\n");
  AddDetail(({"haus"}),
	    "Es ist ein sehr ungewoehnliches grosses Haus.\n");
  AddDetail(("ostwand"),
	    "An der Ostwand haengt ein kleines Bild.\n");
  AddDetail(("westwand"),
	    "An der Westwand haengt ein grosses Schwert und direkt darunter "
	    +"eine kleine Tafel.\n");
  AddDetail(({"boden", "holzboden"}),
	    "Ein solider Holzboden aus Buchenholz.\n");
  AddDetail(({"buchenholz", "holz"}),
	    "Das Holz macht einen soliden und gut gepflegten Eindruck.\n");
  AddDetail(({"eindruck"}),
	    "Der ist nicht schlecht.\n");
  AddDetail(({"waende", "nordwand", "suedwand"}),
	    "Die Waende sind aus Stein und weiss gestrichen. An der Ostwand "
	    +"siehst Du eine kleines Bild und an der Westwand ein grosses "
	    +"Schwert haengen.\n");
  AddDetail(("wand"),
	    "Welche Wand meinst du?\n");
  AddDetail(("schwert"),
	    " \n"
	    +"                /()\n"
	    +"               / /\n"
	    +"              / /\n"
	    +"/============| |------------------------------------------,\n"
	    +"{=| / / / / / /|()}     }     }                            >\n"
	    +"\\============| |------------------------------------------'\n"
            +"              \\ \\\n"
            +"               \\ \\\n"
            +"                \\()\n"
	    +"\n"
	    +"Das Schwert ist ziemlich beeindruckend.\n");
  AddDetail(("tafel"),
	    "Du kannst sie lesen.\n");
  AddReadDetail(("tafel"),
		"Das ist das Schwert des grossen Teranon.\n");
  AddDetail(({"teranon", "name"}),
	    "Der Name `Teranon' sagt Dir eigentlich nichts. Vielleicht solltest Du "
	    +"Umpf einmal danach fragen.\n");
  AddDetail(("bild"),
	    "Es ist ein Bild von dem Soundmagierhaus.\n");
  AddDetail(("soundmagierhaus"),
	    "Das sieht hoechst eigenartig aus.\n");
  AddDetail(({"stein", "frage"}),
	    "Stein oder nicht Stein? Das ist hier keine Frage.\n");
  AddDetail(("decke"),
	    "Sie ist aus Stein und hat einen weissen Anstrich. Ausserdem "
	    +"haengt an ihr eine Lampe.\n");
  AddDetail(("lampe"),
	    "Die Lampe spendet dem Raum genuegend Licht. Ohne die "
	    +"waers hier naemlich ziemlich duster.\n");
  AddDetail(("licht"),
	    "Ohne dem waers hier ziemlich duster.\n");
  AddDetail(({"anstrich", "farbe"}),
	    "Der Anstrich hat eine weisse Farbe.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst hier nichts.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Hier riecht es nach nichts.\n");
  
  // DETAILS END;
  
  // EXITS START;
  AddExit ("norden", ROOM("0_room11"));
  AddExit ("nordosten", ROOM("0_room1"));
  AddExit ("sueden", ROOM("0_room9"));
  // EXITS END;
  
  AddCmd(({"setz", "setze", "sitz", "sitze"}), "setze_auf");

  // ITEMS START;
  // ITEMS END;
  
}
  
setze_auf(str)
{
  notify_fail("Worauf willst Du Dich setzen?\n");
  if ((str == "auf sessel" || str == "auf holzsessel" || str == "sessel" || str == "holzsessel" ||
       str == "in sessel" || str == "in holzsessel"))
    {
      write (BS("Du setzt Dich auf einen Sessel der urploetzlich unter "
	    +"dir zusammenbricht. Schnell baust Du den Sessel wieder "
	    +"zusammen und pfeifst ganz unschuldig in der Gegend herum.\n"));
      say (BS(capitalize(TP->query_real_name(WER, 2))+" setzt sich auf einen Sessel der "
	  +"darauf sofort zusammenbricht. "+(capitalize(TP->query_real_name(WER, 2)))
	  +" baut ihn wieder zusammen und pfeift dann ganz unschuldig "
	  +"in der Gegend herum.\n"));
      return 1;
    }
  else return 0;
}










