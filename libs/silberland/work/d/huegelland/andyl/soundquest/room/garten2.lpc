#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du befindest Dich in einem Teil des grossen "
	   +"Gartens. Westlich von hier steht das Soundmagierhaus und "
	   +"im Nordosten bzw. Osten verlaeuft der Zaun der den "
	   +"Garten umgibt. Parallel dazu wurde eine Hecke angepflanzt. "
	   +"Weiters entdeckst Du ein kleines Blumenbeet und im Nordwesten "
	   +"noch eine ziemlich schoene Linde.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(("linde"),
	    "Die steht da im Nordwesten.\n");
  AddDetail(("nordwesten"),
	    "Da steht eine Linde.\n");
  AddDetail(("teil"),
	    "Du bist hier in einem Teil des grossen Gartens.\n");
  AddDetail(("garten"),
	    "Der sieht ziemlich schoen aus und ist zudem ziemlich "
	    +"gross.\n");
  AddDetail(({"zaun", "holzzaun"}),
	    "Ein einfacher Holzzaun mit einem weissen Anstrich.\n");
  AddDetail(("anstrich"),
	    "Der ist weiss.\n");
  AddDetail(({"osten", "nordosten"}),
	    "Da ist ein Zaun und eine Hecke.\n");
  AddDetail(("boden"),
	    "Unter Dir ist ein wunderbar gepflegter Rasen.\n");
  AddDetail(("rasen"),
	    "Viel besser kann man einen Rasen wie diesen wahrscheinlich "
	    +"nicht mehr herrichten.\n");
  AddDetail(("himmel"),
	    "Aus dem strahlend blauen Himmel leuchtet Dir die "
	    +"Sonne freudestrahlend entgegen.\n");
  AddDetail(("sonne"),
	    "Dich wuerde es nicht stoeren, wenn sie oefter so "
	    +"strahlen wuerde.\n");
  AddDetail(({"haus", "soundmagierhaus"}),
	    "Jede Baubehoerde wuerde beim ersten Anblick von dem "
	    +"Haus einen Anfall kriegen. Es sieht aus, als "
	    +"wuerde es jeden Moment sofort einstuerzen. Aber da "
	    +"duerfte die Magie die hier wirksam ist etwas dagegen "
	    +"haben.\n");
  AddDetail(("baubehoerde"),
	    "Die sollte dieses Haus wirklich nicht besichtigen.\n");
  AddDetail(("anblick"),
	    "Der erste Anblick ist wahrlich bestuerzend.\n");
  AddDetail(("anfall"),
	    "Das waere dann sicher ein sehr grooosser Anfall.\n");
  AddDetail(("moment"),
	    "Du kannst nur hoffen, dass dieser Moment nicht gerade "
	    +"dann ist, wenn Du im Haus herumspazierst.\n");
  AddDetail(("magie"),
	    "Die kann man hier direkt fuehlen.\n");
  AddDetail(("hecke"),
	    "Diese Hecke hat silbern glaenzende Blaetter.\n");
  AddDetail(("blaetter"),
	    "Silberne Blaetter. Ist nicht unbedingt etwas "
	    +"alltaegliches.\n");
  AddDetail(({"blumenbeet", "beet"}),
	    "In dem Blumenbeet sind viele verschiedene Blumen.\n");
  AddDetail(("blumen"),
	    "Du siehst Maerzenbecher, Schneegloeckchen, Veilchen, "
	    "ein paar Rosen und noch ein paar andere.\n");
  AddDetail(("maerzenbecher"),
	    "Ihre gelben Blueten gefallen Dir irgendwie.\n");
  AddDetail(("blueten"),
	    "Die sind sehr huebsch.\n");
  AddDetail(({"veilchen", "schneegloeckchen"}),
	    "Die passen hier wirklich sehr gut her.\n");
  AddDetail(("rosen"),
	    "Du siehst ein paar weisse Rosen. Die gefallen "
	    +"dir so gut, dass Du am liebsten gleich eine pfluecken "
	    +"willst.\n");
  AddDetail(("hand"),
	    "In der kribbelt es jetzt ganz schoen.\n"); 
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein leises Summen.\n");
  AddSound(("summen"),
	   "Es kommt von den Blumen.\n");
  AddSmell(({DEFAULT_SMELL, "geruch"}),
	    "Es riechst den herrlichen Duft der Blumen.\n");
  AddDetail(("duft"),
	    "Du kannst ihn riechen.\n");
  AddSmell(("duft"),
	   "Mhh, riecht gut.\n");
  AddSmell(({"blumen", "blume"}),
	   "Die Blumen riechen aeusserst wohltuend.\n");
  // DETAILS END;
  
  // EXITS START;
  AddExit ("westen", ROOM("garten3"));
  AddExit ("nordwesten", ROOM("garten4"));
  AddExit ("sueden", ROOM("garten1.lpc"));
  // EXITS END;

  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  AddCmd(({"pfluecke", "pflueck"}), "pfluecke_was");

  // ITEMS START;
  // ITEMS END;

}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Du laesst Deine Hand durch die Magie gleiten. "
	    +"Das kribbelt ja ganz schoen.\n"));
      return 1;
    }
  else return 0;
}

pfluecke_was(str)
{
  object ob, ob1;
  notify_fail("Was willst Du denn pfluecken?\n");
  if ((str == "maerzenbecher" || str == "veilchen" || str == "schneegloeckchen"))
    {
      write(BS("Das kannst Du nicht pfluecken!\n"));
      return 1;
    }
    if (str == "rosen")
    {
      write(BS("Du willst doch nicht etwa alle pfluecken?\n"
	    +"Eine muesste doch ausreichen, oder?\n"));
      return 1;
    }
  if (str == "rose")
    {
      if (!ob=present(("\nsqquestitem"),TP))
	{
	  write(BS("Derzeit brauchst Du keine Rose. Also lass "
		+"sie stehen.\n"));
	  return 1;
	}
      else 
	{
	  if ((!ob=present(("\nsqrose"),TP)) && (!ob1=present(("\nsqrosenbluete"), TP)))
	    {
	      write(BS("Du pflueckst eine Rose und steckst sie ein.\n"));
	      CLONE(OBJ("rose"),(TP));
	      return 1;
	    }
	  else 
	    {
	      write(BS("Aber Du hast doch schon eine Rose gepflueckt.\n"));
	      return 1;
	    }
	}
    }
  else return 0;
}
















