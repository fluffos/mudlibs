#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

int feueran;

void create()
{
  feueran = 0;
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Das Wohnzimmer");
  SetProp (P_INT_LONG, "Das ist das Wohnzimmer des Soundmagiers.\n"
	   + "Es ist richtig gemuetlich eingerichtet. "
	   + "In einer Ecke siehst Du einen Kaminofen, an der Ostwand "
	   + "steht eine einladende Couch, an der Suedwand haengt ein Gemaelde "
	   + "und in der Mitte des Raumes ein kleiner Tisch und ein Sessel.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(("mitte"),
	    "In der Mitte des Raumes stehen ein Tisch und ein Sessel.\n");
  AddDetail(({"raum", "zimmer", "wohnzimmer"}),
	    "Dieser Raum scheint das Wohnzimmer zu sein.\n");
  AddDetail (("waende"),
	     "Auf die Waende ist das Bild eines klaren Sternenhimmels aufgemalt.\n");
  AddDetail (({"bild", "sternenhimmel", "stern", "sterne"}),
	     "Ein wunderschoener Sternenhimmel ist da auf die Waende aufgemalt.\n");
  AddDetail (("himmel"),
	     "Der einzige Himmel, den Du hier erkennen kannst, ist der Sternenhimmel, "
	     + "welcher auf die Waende aufgemalt ist.\n"); 
  AddDetail (("wand"),
	     "Welche Wand meinst Du ?\n");
  AddDetail (("suedwand"),
	     "Da ist ein Fenster und ausserdem haengt da ein Gemaelde.\n");
  AddDetail (("fenster"),
	     "Durch das Fenster sieht man in den Garten.\n");
  AddDetail (("garten"),
	     "Du findest, dass das ein sehr schoener Garten ist.\n");
  AddDetail (({"westwand","ostwand","nordwand"}),
	     "Du kannst da nichts besonderes erkennen.\n");
  AddDetail (("boden"),
	     "Der Boden besteht aus dunkelblauen Fliesen.\n");
  AddDetail (({"fliesen", "farbe"}),
	     "Die Fliesen haben eine dunkelblaue Farbe.\n");
  AddDetail (("ecke"),
	     "Da steht ein Kaminofen.\n");
  AddDetail (("couch"),
	     "Eine einfache gemuetliche Couch.\n");
  AddDetail(("holz"),
	    "Ganz gewoehnliches Holz. Riecht so, schmeckt so, hoert sich so an, schaut so aus, "
            +"und ist genauso hart. Das impliziert wohl, dass dies Holz sein muss. q.e.d.\n");
  AddDetail (({"tisch", "holztisch"}),
	     "Ein einfacher Holztisch.\n");
  AddDetail(("soundmagier"),
	    "Dem gehoert alles hier.\n");
  AddDetail (({"sessel", "holzsessel"}),
	     "Ein einfacher Holzsessel.\n");
  AddDetail (("gemaelde"),
	     "Das Gemaelde zeigt eine Gestalt in einer schwarzen Robe, welche ueber "
	     + "und ueber mit Runen und anderen geheimnisvollen Zeichen verziert ist.\n"
	     + "Im Hintergrund scheint ein tobendes Gewitter dargestellt zu sein.\n");
  AddDetail (("robe"),
	     "Sie ist tiefschwarz und mit silbernen Runen und Zeichen bedeckt.\n");
  AddDetail (("gestalt"),
	     "Die Gestalt auf dem Gemaelde traegt eine schwarze Robe, das Gesicht ist von "
	     + "der Kapuze bedeckt und wirkt sehr geheimnisvoll.\n");
  AddDetail(({"kapuze", "gesicht"}),
	    "Die Kapuze verdeckt das Gesicht.\n");
  AddDetail (({"zeichen", "runen"}),
	     "Sie wirken geheimnisvoll, nur verstehst Du ihren Sinn nicht.\n");
  AddDetail(("sinn"),
	    "Du verstehst den Sinn von den Zeichen nicht.\n");
  AddDetail (({"hintergrund","darstellung"}),
	     "Das duerfte die Darstellung eines tobenden Gewitters sein.\n");
  AddDetail (({"gewitter", "blitze"}),
	     "Ein Gewitter in dem die Blitze nur so heruntersausen.\n");
  AddDetail (("decke"),
	     "Die Decke ist komplett schwarz gestrichen und eine kleine Lampe haengt an ihr.\n");
  AddDetail (("lampe"),
	     "Eine einfache Lampe die Licht spendet.\n");
  AddDetail (("Licht"),
	     "Licht scheint durchs Fenster und kommt auch von der Lampe.\n");
  AddSpecialDetail(("feuer"),"feuerschau");
  AddSpecialDetail(({"kamin","ofen","kaminofen", "oberseite"}), "kaminschau");
  AddSpecialDetail(({"symbol", "mystisches symbol"}), "symbolschau");
  AddSpecialDetail(({"oberseite"}), "oberseiteschau");
  AddSound( DEFAULT_SOUND,
	    "Es ist absolut still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du kannst nichts besonderes riechen.\n");
  // DETAILS END;
  
  AddCmd(({"heize", "heiz"}), "heize_ein"); 
  AddCmd(({"breche", "brich", "brech"}), "breche_runter");
  AddCmd(({"setz", "sitz", "setze"}), "setz_auf");
  
  // EXITS START;
  AddExit ("nordwesten", ROOM("1_room4"));
  // EXITS END;
  
  // ITEMS START;
  // ITEMS END;

}

setz_auf(str)
{
  notify_fail("Auf was willst Du Dich setzen?\n");
  if (!str) return 0;
  if (( str == "auf couch" || str == "couch" ||
	str == "in couch" ))
    {
      write(BS("Die Couch ist sehr gemuetlich und Du wuerdest gerne "
	       "laenger hier verweilen, aber Du hast ja leider noch "
	       "so einiges anderes zu tun, also stehst Du wieder auf.\n"));
      return 1;
    }
  return 0;
}


feuerschau ()
{
  if (feueran == 0) return BS("Es brennt derzeit keines im Ofen.\n");
  else return (BS("Da brennt ein Feuer im Kaminofen.\n"));
}

kaminschau ()
{
  if (feueran == 0) 
    {
      return (BS("Das ist ein schwarzer metallener Kaminofen.\n"
	     +"Derzeit brennt darin gerade kein Feuer. "
	     +"Wenn Du willst kannst Du jederzeit einheizen.\n"));   
    }
  else
    {
      return (BS("Das ist ein metallener Kaminofen.\n"
	     +"Es brennt gerade ein Feuer darin. "
	     +"Ein mystisches Symbol, welches Du vorher uebersehen hast glueht "
	     +"jetzt hellrot auf der Oberseite des Kaminofens.\n"));
    }
} 

oberseiteschau ()
{
  if (feueran == 0)
    {
      return (BS("Sowas siehst Du da nicht!\n"));
    }
  else
    {
      return (BS("Ein mystisches Symbol glueht hellrot an der Oberseite des Kaminofens.\n"
		 +"Es ist sicher fuer irgendetwas von grosser Wichtigkeit. "
		 +"Vielleicht kannst Du es herunterbrechen.\n"));
    }
}   

symbolschau ()
{
  if (feueran == 0)
    {
      return (BS("Sowas siehst Du da nicht!\n"));
    }
  else
    {
      return (BS("Ein mystisches Symbol glueht hellrot an der Oberseite des Kaminofens.\n"
	     +"Es ist sicher fuer irgendetwas von grosser Wichtigkeit. "
	     +"Vielleicht kannst Du es herunterbrechen.\n"));
    }
}  

heize_ein (str)
{
  object ob;
  notify_fail("Was willst Du einheizen?\n");
  if ((str == "ofen" || str == "ofen ein" || str == "kaminofen ein" || str == "kaminofen" ||
       str == "kamin ein" || str == "kamin" || str == "ein" ))
    {
      if (feueran == 1) 
	{
	  write (BS("Es ist eh schon eingeheizt worden.\n")); 
	  return 1;
	}
      else 
	{
	  write (BS("Womit willst Du den Kaminofen einheizen?\n")); 
	  return 1;
	}
    }
  
  if ((str == "ofen mit holzscheit ein" || str == "ofen mit holzscheit" || 
       str == "kaminofen mit holzscheit" || str == "kaminofen mit holzscheit ein" ||
       str == "kamin mit holzscheit ein" || str == "kamin mit holzscheit"||
       str == "ofen mit scheit ein" || str == "ofen mit scheit" || 
       str == "kaminofen mit scheit" || str == "kaminofen mit scheit ein" ||
       str == "kamin mit scheit ein" || str == "kamin mit scheit" || str == "scheit ein"|| 
       str == "holzscheit ein" ))
    {
      if (feueran == 1)
	{
	  write (BS("Es ist eh schon eingeheizt worden.\n"));
	  return 1;
	}
      else
	{
	  if (!ob=present(("\nsqholzscheit"),TP))
	    {
	      write (BS("Aber Du hast ja gar keinen Holzscheit!\n")); 
	      return 1;
	    }	
	  else 
	    {
	      write (BS("Du heizt den Kaminofen mit dem Holzscheit ein.\n"
		    +"Dir kommt vor als haette sich am Kaminofen etwas veraendert.\n"));
	      say (BS(this_player()->name(WER,2)+" heizt etwas ein.\n"));
	      ob->remove();	      
	      feueran=1;
	      return 1;
	    }	 
	}
    }
  return 0;
}  

breche_runter (str)
{
  object ob1;
  object ob2;
  notify_fail("Was willst Du womit herunterbrechen?\n");  
  if (feueran == 0) return 0;
  else
    {
      if ((str == "symbol runter" || str == "mystisches symbol runter" || str == "symbol herunter" ||
	   str == "mystisches symbol herunter" || str == "mystisches symbol ab" || str == "symbol ab"))
	{
	  if (!ob1=present(("\nsqsymbol2"),TP))
	    { 
	      write (BS("Es ist zu heiss als Du es mit den Haenden runterbrechen koenntest. "
		     +"Vielleicht solltest Du dazu ein Werkzeug benutzen.\n"));
	      return 1;
	    }
	  else
	    {
	      write (BS("Aber Du hast das mystische Symbol doch schon.\n"));
	      return 1;
	    } 
	}	  
      else if ((str == "symbol mit brecheisen herunter" || str == "mystisches symbol mit brecheisen herunter" ||
		str == "symbol mit brecheisen runter" || str == "mystisches symbol mit brecheisen runter")) 
	{
	  if (!ob1=present(("\nsqsymbol2"), TP)) 
	    {
	      if (!ob2=present(("\nsqbrecheisen"), TP))
		{
		  write (BS("Du hast ja gar kein Brecheisen!\n"));
		  return 1;
		}
	      else
		{
		  write (BS("Du brichst das mystische Symbol mit dem Brecheisen aus dem Kaminofen, "
			+"laesst es einige Zeit auskuehlen und steckst es dann ein.\n"));
		  say (BS(this_player()->name(WER,2)+" bricht mit einem Brecheisen "
		       +"etwas aus dem Kaminofen.\n"));
		  feueran=0;
		  CLONE(OBJ("symbol2"),(TP));
		  return 1;
		} 
	    } 
	  else 
	    return write (BS("Du hast das mystische Symbol doch schon.\n")), 1;	    
	}
      else return 0;      
    }
}











