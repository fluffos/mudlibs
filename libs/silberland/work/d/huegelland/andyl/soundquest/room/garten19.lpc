#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du stehst in einem Teil des grossen Gartens. "
	   +"Nordwestlich von Dir siehst Du ein grosses Haus. "
	   +"Im Osten und Suedosten steht ein einfacher weisser "
	   +"Holzzaun. Neben dem Zaun ist eine Hecke eingepflanzt worden. "
	   +"Am Boden kannst Du ausserdem ein kleines Loch entdecken.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(("teil"),
	    "Du stehst hier in einem Teil des Gartens.\n");
  AddDetail(("boden"),
	    "Da ist ein perfekter Rasen.\n"
	    +"Naja, fast perfekt wenn man von dem kleinen "
	    +"Loch absieht.\n");
  AddDetail(("garten"),
	    "Der Garten sieht ziemlich schoen aus.\n");
  AddDetail(("rasen"),
	    "Der Rasen sieht wirklich erstaunlich gepflegt aus.\n");
  AddDetail(({"loch", "eingang"}),
	    "Das Loch scheint der Eingang in eine kleine Hoehle zu sein.\n");
  AddDetail(({"hoehle", "bau"}),
	    "Es scheint der Bau eines kleinen Tieres zu sein.\n");
  AddDetail(({"tier", "tieres"}),
	    "Wenn Du genau schaust, siehst Du ja vielleicht eines.\n");
  AddDetail(("himmel"),
	    "Die Sonne strahlt von dem strahlend blauen Himmel herunter "
	    +"und keine Wolken sind zu entdecken.\n");
  AddDetail(("wolken"),
	    "Woodyseidank kannst Du keine entdecken.\n");
  AddDetail(("sonne"),
	    "Die Sonne scheint Dir so richtig angenehm auf den Kopf.\n");
  AddDetail(({"kopf", "leute"}),
	    "Manche Leute sollen tatsaechlich sowas besitzen.\n");
  AddDetail(({"zaun", "holzzaun"}),
	    "Ein einfacher weisser Holzzaun.\n");
  AddDetail(({"hecke"}),
	    "Du glaubst nicht, so eine jemals vorher gesehen zu haben. Diese "
	    +"Hecke hier hat naemlich silberne Blaetter.\n");
  AddDetail(("blaetter"),
	    "Die sind vollkommen silbern.\n");
  AddDetail(({"suedosten", "osten"}),
	    "Da ist ein Holzzaun.\n");
  AddDetail(("haus"),
	    "Der Architekt von dem Haus war entweder ein Genie oder ein "
	    +"absolut Wahnsinniger. Eigentlich muesste es ja sofort "
	    +"einstuerzen, jedoch das silberne Schimmern an den "
	    +"Waenden verraet dir, dass hier auch noch Magie wirksam ist.\n");
  AddDetail(({"waende", "waenden"}),
	    "Von ihnen geht ein silbernes Schimmern aus.\n");
  AddDetail(({"architekt", "architekten"}),
	    "Du denkst . o O (so einen Architekten treffe ich hoffentlich "
	    +"nie.)\n");
  AddDetail(({"genie", "wahnsinniger", "wahnsinn"}),
	    "Genie und Wahnsinn sind ja oft so nahe beieinander.\n");
  AddDetail(("schimmern"),
	    "Das ist eindeutig Magie.\n");
  AddDetail(("magie"),
	    "Du kannst sie hier direkt fuehlen.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst ein leises Geknabber hoeren.\n");
  AddSound(("geknabber"),
	   "Das Geknabber scheint aus dem Loch zu kommen.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts besonderes.\n");

  // DETAILS END;

  // EXITS START;
  AddExit ("westen", ROOM("garten20"));
  AddExit ("norden", ROOM("garten22"));
  AddExit ("suedwesten", ROOM("garten18"));
  // EXITS END;
  
  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  AddCmd(({"schau", "schaue"}), "schau_was");

  // ITEMS START;
  AddItem(NPC("hamster"), REFRESH_DESTRUCT);
  // ITEMS END;

}

schau_was(str)
{
  notify_fail("In was willst Du schauen?\n");
  if ((str == "loch" || str == "in loch" || str == "genau" || str == "genau in hoehle" ||
       str == "in bau" || str == "genau in bau" || str == "genau in loch" || str == "in eingang" ||
       str == "genau in eingang"))
    {
      write (BS("Du kannst in dem Loch leider nichts Besonderes entdecken.\n"));
      return 1;
    }
  else return 0;
} 


fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
    write (BS("Du laesst die Magie durch Dich hindurchstroemen. "
	  +"Du fuehlst Dich jetzt gleich um einiges maechtiger.\n"));
    return 1;
    }
  else return 0;
}















