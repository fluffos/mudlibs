#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

int kamille=1;
int kamillegef=0;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du stehst in einem Teil des riesigen Gartens.\n"
	   +"Suedostlich und suedlich von Dir verlaeuft der Zaun "
	   +"der zusammen mit einer Hecke, die parallel dazu angepflanzt "
	   +"wurde, den Garten umschliesst. Nordwestlich von Dir befindet "
	   +"sich das eigenartig aussehende Haus zu dem der Garten gehoert.\n");
  
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("teil"),
	    "Hier ist nur ein Teil von dem riesigen Garten.\n");
  AddDetail(("boden"),
	    "Du stehst auf einem Rasen, dem anscheinend sehr viel Pflege "
	    +"zuteil wurde.\n");
  AddDetail(("garten"),
	    "Du stehst gerade in einem Teil des Gartens.\n");
  AddDetail(("rasen"),
	    "Dem Rasen wurde anscheinend sehr viel Pflege zuteil. Der sieht wirklich "
	    +"extrem gut aus.\n");
  AddDetail(("pflege"),
	    "Hier war ein Gaertner wieder sehr, sehr sorgfaeltig bei der Arbeit.\n");
  AddDetail(("gaertner"),
	    "Du kannst in dem ganzen Garten keinen sehen. Aber eines ist sicher: "
	    +"Die Arbeit die hier geleistet wurde ist hervorragend.\n");
  AddDetail(("arbeit"),
	    "Der Garten hier ist wirklich hervorragende Arbeit.\n");
  AddDetail(("himmel"),
	    "Aus dem strahlend blauen Himmel scheint Dir die Sonne entgegen.\n");
  AddDetail(("sonne"),
	    "Die Sonne scheint Dir mit ihren Strahlen angenehm auf das Gesicht.\n");
  AddDetail(("gesicht"),
	    "Schau dazu lieber mal in einen Spiegel.\n");
  AddDetail(("spiegel"),
	    "Mit einem Spiegel koenntest Du Dein Gesicht betrachten.\n");
  AddDetail(("strahlen"),
	    "Die sind hier so richtig angenehm.\n");
  AddDetail(({"zaun", "holzzaun"}),
	    "Ein einfacher weisser Holzzaun.\n");
  AddDetail(("hecke"),
	    "Die Hecke hat silberne Blaetter. Du fragst Dich, wo "
	    +"es sowas noch geben koennte.\n");
  AddDetail(("blaetter"),
	    "Fast alle sind silbern. Nur an einer Stelle kannst Du "
	    +"etwas Gelbes sehen.\n");
  AddSpecialDetail(({"gelbes", "Stelle", "kamillenblueten"}), "kamille_da");
  AddDetail(("haus"),
	    "Es ist ziemlich gross und etwas seltsam konstruiert. "
	    +"Wahrscheinlich ist bei diesem Haus Magie benutzt worden, "
	    +"sonst wurde es bestimmt sofort in sich zusammenbrechen.\n");
  AddDetail(("magie"),
	    "Man kann sie ja schon direkt fuehlen.\n");
  AddSound( DEFAULT_SOUND,
	    "Es herrscht hier friedliche Stille.");
  AddSound(("stille"),
	   "Eine sehr friedliche Stille.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du kannst nichts besonderes riechen.\n");

  // DETAILS END;
  
  // EXITS START;
  AddExit ("westen", ROOM("garten17"));
  AddExit ("norden", ROOM("garten20"));
  AddExit ("nordosten", ROOM("garten19"));
  AddExit ("westen", ROOM("garten17"));
// EXITS END;
  
AddCmd(({"pfluecke", "pflueck"}), "pfluecke_was");
AddCmd(("fuehle"), "fuehle_was");


  // ITEMS START;
  // ITEMS END;
  
}

reset()
{
  ::reset();
  kamille=1;
  kamillegef=0;
}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  {
    if (str == "magie")
      {
	write (BS("Hihi, das kitzelt aber.\n"));
	return 1;
      }
    else return 0;
  }
}

kamille_da()
{
  if (kamille==1)
    {
      kamillegef=1;
      return (BS("Da siehst Du ein paar Kamillenblueten. Vielleicht kannst Du "
	     +"sie pfluecken.\n"));
    }
  else return (BS("Da ist nichts. Musst Dich wohl getaeuscht haben.\n"));
}

pfluecke_was(str)
{
  notify_fail("Was willst Du pfluecken?\n");
  {
    if ((str == "kamillenbluete" || str == "kamillenblueten" || str == "kamille" ||
	 str == "bluete" || str == "blueten"))
      {
	if ((kamille==1) && (kamillegef==1))
	  {
	    write (BS("Du pflueckst eine Kamillenbluete und steckst sie ein.\n"));
	    CLONE(OBJ("kamille"),(TP));
	    kamille=0;
	    kamillegef=0;
	    return 1;
	  }
	else 
	  {
	    write (BS("Scheint gerade nichts da zu sein.\n"));
	    return 1;
	  }
      }
    else return 0;
  }  

}
















