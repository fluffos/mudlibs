#include <properties.h>
#include <moving.h>
#include "../files.h"
inherit "std/room";

#define TOD(wer) (member(tod, getuid(wer))!=-1)
string *tod=({});

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du befindest Dich in einem Teil "
	   +"des grossen Gartens, der zu dem Haus suedlich "
	   +"von hier gehoert. Im Norden siehst Du einen "
	   +"Gartenzaun und eine Hecke, die parallel zum Zaun "
	   +"angepflanzt wurde. Im Suedosten siehst Du noch eine Linde. "
	   +"Hier scheint der ideale Fleck zum Entspannen zu sein.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("suedosten"),
	    "Dort siehst Du eine sehr schoene Linde.\n");
  AddDetail(("linde"),
	    "Es ist eine sehr schoene Linde. Sie befindet sich im Suedosten.\n");
  AddDetail(("teil"),
	    "Du befindest Dich gerade in einem Teil des grossen Gartens.\n");
  AddDetail(("himmel"),
	    "Am Himmel sind nicht einmal kleinste Woelkchen. "
	    +"Allein die Sonne strahlt aus dem strahlend blauen "
	    +"Himmel hervor.\n");
  AddDetail(("garten"),
	    "Ein ausgesprochen schoener Garten.\n");
  AddDetail(("sonne"),
	    "Sie strahlt kraeftig, jedoch angenehm, auf Dich herunter.\n");
  AddDetail(("woelkchen"),
	    "Du kannst keine entdecken.\n");
  AddDetail(({"fleck", "entspannen"}),
	    "Hier scheint der ideale Fleck zum Entspannen zu sein.\n");
  AddDetail(({"gartenzaun", "zaun", "holzzaun"}),
	    "Ein einfacher weisser Holzzaun.\n");
  AddDetail(("norden"),
	    "Da ist ein Gartenzaun.\n");
  AddDetail(("sueden"),
	    "Da steht ein Haus.\n");
  AddDetail(("hecke"),
	    "Die Hecke hier hat silberne Blaetter.\n");
  AddDetail(("blaetter"),
	    "Die Blaetter hier sind voellig silbern. Sowas sieht "
	    +"man nicht oft.\n");
  AddDetail(("boden"),
	    "Unter Dir ist ein sorgfaeltig gepflegter Rasen.\n");
  AddDetail(("rasen"),
	    "Der Rasen hier wurde wirklich hervorragend gepflegt.\n");
  AddDetail(({"haus", "konstruktion"}),
	    "Bei der Konstruktion hat man ja Angst, dass die Waende "
	    +"bei dem kleinsten Windhauch einstuerzen.\n");
  AddDetail(("angst"),
	    "Angst? Was ist das? Du bist natuerlich furchtlos wie immer.\n");
  AddSpecialDetail(("windhauch"), "windhauch");
  AddDetail(({"tagtraeumen", "alptraeume"}),
	    "Davon hast Du vorlaeufig genug.\n");
  AddDetail(("waende"),
	    "Von ihnen geht ein silbernes Schimmern aus.\n");
  AddDetail(("schimmern"),
	    "Das silberne Schimmern wird sicher durch Magie erzeugt.\n");
  AddDetail(("magie"),
	    "Die kann man hier ja direkt fuehlen.\n");
  AddDetail(("geheimnis"),
	    "Mist, jetzt hast Du es wieder vergessen.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst nichts aufregendes hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts besonderes.\n");

  // DETAILS END;
  
  // EXITS START;
  AddSpecialExit (("osten"), "nachosten");
  AddSpecialExit (("westen"), "nachwesten");
  AddSpecialExit (("suedosten"), "nachsuedosten");
  AddSpecialExit (("suedwesten"), "nachsuedwesten");
  // EXITS END;

  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  AddCmd(({"entspann", "entspanne"}), "entspannen");

  // ITEMS START;
  AddItem(NPC("lemming.lpc"), REFRESH_DESTRUCT); 
  // ITEMS END;

}

int nachsuedwesten()
{
  if( TOD(TP))
    {
      return notify_fail ("Aber Du bist doch tot.\n"), 0;
    }
  TP->move(ROOM("garten8"), M_GO, "nach Suedwesten");
  return 1;
}

int nachsuedosten()
{
  if( TOD(TP))
    {
      return notify_fail ("Aber Du bist doch tot.\n"), 0;
    }
  TP->move(ROOM("garten4"), M_GO, "nach Suedosten");
  return 1;
}

int nachwesten()
{
  if( TOD(TP))
    {
      return notify_fail ("Aber Du bist doch tot.\n"), 0;
    }
  TP->move(ROOM("garten7"), M_GO, "nach Westen");
  return 1;
}

int nachosten()
{
  if( TOD(TP))
    {
      return notify_fail ("Aber Du bist doch tot.\n"), 0;
    }
  TP->move(ROOM("garten5"), M_GO, "nach Osten");
  return 1;
}

entspannen()
{
  write (BS("Du setzt Dich hin und entspannst Dich etwas. "
	    +"Ah, das tut gut.\n"));
  say   ((this_player()->name(WER,2))+" entspannt sich hier ein wenig.\n");
  return 1;
}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Du laesst die Magie durch Dich stroemen und "
	     +"kannst auf einmal das essentielle Geheimnis der Magie "
	     +"erkennen.\n"));
      return 1;
    }
  else return 0;
}

windhauch()
{
  
  call_out("faketod", 0);
  return "";
}

void faketod()
{
  write ("Du spuerst jetzt gerade einen und...\n"
	 +"...\n"
	 +"[Tod:Lars] Ein einstuerzendes Haus hat gerade "
	 +(this_player()->name(WER,2))+" umgebracht!\n");
  tod += ({ getuid(TP) });
  call_out("denk_was",15);
}

void denk_was()
{
  write(BS("Du denkst . o O (ich sollte nicht soviele Alptraeume "
	+"beim Tagtraeumen haben.)\n"));
  tod -= ({ getuid(TP)});
}

PlayerQuit(object ob)
{
  if (TOD(ob))
    tod -= ({ getuid(ob) });
}









