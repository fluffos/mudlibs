#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Ein Instrumentenraum");
  SetProp (P_INT_LONG, "Dies scheint ein Lagerraum fuer Musikinstrumente zu sein.\n"
	   +"In mehreren Regalen sind die verschiedensten Instrumente sorgfaeltig verstaut. "
	   +"Die Palette der Instrumente reicht von Streichinstrumenten, "
	   +"ueber Blechblasinstrumente, Holzblasinstrumente, Zupfinstrumente und Schlagzeuge bis zu "
	   +"seltsamen magischen Instrumenten.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail (({"wand","waende"}),
	     "Sie sind schwarz gestrichen und komplett aus Stein.\n");
  AddDetail (("stein"),
	     "Stein, schwer und hart.\n");
  AddDetail (("boden"),
	     "Der Boden besteht aus dunkelblauen Fliesen.\n");
  AddDetail (("regale"),
	     "In den Regalen sind viele Musikinstrumente.\n");
  AddDetail (({"fliesen", "farbe"}),
	     "Die Fliesen haben eine dunkelblaue Farbe.\n");
  AddDetail (({"raum", "lagerraum", "instrumentenraum"}),
	     "Dieser Raum ist ein Lagerraum fuer Instrumente.\n");
  AddDetail (("decke"),
	     "Die Decke ist komplett schwarz gestrichen. Ausserdem haengt da eine Lampe.\n");
  AddDetail (("lampe"),
	     "Die Lampe spendet dem Raum genuegend Licht.\n");
  AddDetail (("licht"),
	     "Das Licht ist hell.\n");
  AddDetail (("palette"),
	     "Die Palette an Instrumenten hier ist weit gestreut.\n");
  AddDetail (({"pinsel", "streichinstrument"}),
	     "Ein Pinsel ist zwar auch ein Streichinstrument, aber deswegen siehst Du hier trotzdem keinen.\n");
  AddDetail (({"instrumente", "instrument", "musikinstrument", "musikinstrumente"}),
	     "Du siehst Streichinstrumente, Blechblasinstrumente, Holzblasinstrumente, Zupfinstrumente, "
	     +"Schlagzeuge und magische Instrumente.\n");
  AddDetail (("streichinstrumente"),
	     "Du siehst Geigen, Bratschen und Kontrabaesse. Nur Pinsel siehst Du keine.\n");
  AddDetail (({"bratschen", "geigen", "kontrabaesse"}),
	     "Diese Instrumente gehoeren zur Gruppe der Streichinstrumente.\n");
  AddDetail (({"bratsche", "geige", "kontrabass"}),
	     "Dieses Instrument gehoert zur Gruppe der Streichinstrumente.\n");
  AddDetail (("gruppe"),
	     "Hier gibt es die Gruppe der Streichinstrumente, der Holzblasinstrumente, der Blechblasinstrumente "
	     +"der Zupfinstrumente, der Schlagzeuge und der magischen Instrumente.\n");
  AddDetail (("blechblasinstrumente"),
	     "Du siehst Trompeten, Fanfaren, Hoerner und Posaunen.\n");
  AddDetail (({"trompeten", "fanfaren", "hoerner", "posaunen"}),
	     "Diese Instrumente gehoeren zur Gruppe der Blechblasinstrumente.\n");
  AddDetail (({"trompete", "fanfare", "horn", "posaune"}),
	     "Dieses Instrument gehoert zur Gruppe der Blechblasinstrumente.\n");
  AddDetail (("holzblasinstrumente"),
	     "Du siehst Floeten, Oboen und Fagotte.\n");
  AddDetail (({"floeten", "oboen", "fagotte"}),
	     "Diese Instrumente gehoeren zur Gruppe der Holzblasinstrumente.\n");
  AddDetail (({"oboe", "fagott"}),
	     "Dieses Instrument gehoert zur Gruppe der Holzblasinstrumente.\n");
  AddDetail (("floete"),
	     "Welche Floete meinst du?\n");
  AddDetail (("floeten"),
	     "Da siehst Du eine Altfloete, eine Blockfloete und eine Piccolofloete.\n");
  AddDetail (("toene"),
	     "Es gibt sehr, sehr, sehr viele Toene.\n");
  AddDetail (("altfloete"),
	     "Mit einer Altfloete spielt man vor allem tiefe Toene.\n");
  AddDetail (("blockfloete"),
	     "Mit der Blockfloete spielt man hauptsaechlich Toene in mittlerer Tonlage.\n");
  AddDetail(("tonlage"),
	    "Die Tonlage kann bei den Instrumenten sehr verschieden sein.\n");
  AddDetail (("piccolofloete"),
	     "Mit der Piccolofloete kann man sehr hohe Toene spielen.\n");
  AddDetail (("zupfinstrumente"),
	     "Du kannst hier nur eine einzelne Zither entdecken.\n");
  AddDetail (("zither"),
	     "Sie sieht bereits ziemlich alt aus.\n"); 
  AddDetail (({"magische instrumente"}),
	     "Bei den meisten dieser Instrumente hast Du nicht den blassesten Schimmer "
	     +"wie die funktionieren sollen.\n");
  AddDetail (("schimmer"),
	     "Du hast keinen.\n");
  AddDetail (("schlagzeuge"),
	     "Du siehst ein paar Bongos, eine grosse Pauke und ein Becken.\n");
  AddDetail (("bongos"),
	     "Bongos gehoeren zur Gruppe der Schlagzeuge.\n");
  AddDetail (("pauke"),
	     "Es ist eine sehr grosse Pauke. Dich juckt es irgendwie in den Fingern "
	     +"einmal kraeftig darauf zu hauen.\n");
  AddDetail (("finger"),
	     "Irgendwas faengt da an zu jucken.\n");
  AddDetail (("becken"),
	     "Mit den Becken kann man ordentlich Krach machen. Als Du sie naeher beaeugst "
	     +"siehst du, dass ein Xylophon dahintersteht.\n");
  AddDetail (("xylophon"),
	     "Es ist ein kleines Xylophon. Wenn Du willst kannst Du darauf spielen.\n");
  AddDetail (("krach"),
	     "Wenn Du Krach machen willst benutz die Pauke.\n");
  AddDetail (("einfall"),
	     "Der kommt bestimmt noch.\n");
  AddSound( DEFAULT_SOUND,
	    "Es ist derzeit still hier. Aber mit all diesen Instrumenten kann man sicher "
	    +"etwas Krach machen.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du kannst nichts besonderes riechen.\n");
  // DETAILS END;
  
  AddCmd(({"haue", "hau"}), "boom");
  AddCmd(({"spiele", "spiel"}), "spielen");  
  
  // EXITS START;
  AddExit ("nordwesten", ROOM("1_room2"));
  AddExit ("suedwesten", ROOM("1_room4"));
  // EXITS END;
       
  // ITEMS START;
  // ITEMS END;
       
       }

boom (str)
{
  notify_fail("Auf was willst Du hauen?\n");
  if(( str == "pauke" || str == "auf pauke")) 
    {
      write (BS("Du haust einmal kraeftig auf die Pauke. BUUUMMM!\n"));
      say (BS(this_player()->name(WER,2)+" haut einmal kraeftig auf die Pauke. BUUUMMM!\n"));     
      return 1;
    }
  else return 0;
}

spielen (str)
{
  object ob;
  object ob1;
  notify_fail("Worauf willst Du spielen ?\n");
  if ((str == "geige" || str == "bratsche" || str == "kontrabass" || str == "trompete"
       || str == "fanfare" || str == "horn" || str == "posaune" || str == "floete" 
       || str == "oboe" || str == "fagott" || str == "altfloete" || str == "blockfloete" 
       || str == "piccolofloete" || str == "zither" || str == "bongo" || str == "bongos" 
       || str == "becken"))
    {
      write (BS("Du spielst so falsch auf diesem Instrument, dass Du es gleich wieder sein laesst.\n"));
      return 1;
    }

  if((str == "xylophon" || str == "auf xylophon" || str == "melodie"))
    {
      if (!ob=present(("\nsqmelodie"),TP))
	{
	  write (BS("Du faengst an auf dem Xylophon herumzuspielen aber "
		 +"irgendwie faellt Dir keine schoene Melodie ein.\n"
		 +"Vielleicht hast Du spaeter einen guten Einfall.\n"));
	  say (BS(this_player()->name(WER,2)+" spielt etwas auf dem Xylophon "
	       +"herum.\n"));   
	  return 1;
	}
      else
	{
	  if (!ob1=present(("\nsqkugel"),TP))
	    {
	      write (BS("Du spielst die Melodie, die Du Dir gemerkt hast, auf dem Xylophon. "
		    +"Ploetzlich oeffnet sich ein Spalt im Boden und eine geheimnisvolle "
		    +"Kugel erscheint. Ohne lange zu zoegern nimmst Du sie an Dich worauf "
		    +"sich der Spalt wieder schliesst.\n"));
	      say (BS(this_player()->name(WER,2)+" spielt ein wunderschoene Melodie auf "
		   +"dem Xylophon worauf sich der Boden oeffnet und ein runder "
		   +"Gegenstand erscheint den "+(this_player()->name(WER,2))+" sofort "
		   +"einsteckt.\n"));
	      ob->remove();	  
	      CLONE(OBJ("mkugel"),(TP));	  
	      return 1;
	    }
	  else
	    {
	      write (BS("Du spielst die Melodie die Du Dir gemerkt hast auf dem Xylophon "
		    +"und nichts passiert.\n"));
	      say (BS(this_player()->name(WER,2)+" spielt etwas auf dem Xylophon "
		   +"herum.\n"));   
	      return 1;
	    }
	}
    }  
  else
    { 
      write (BS("Worauf willst Du spielen?\n"));
      return 1;
    }
}



































