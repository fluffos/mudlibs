#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du befindest Dich in einem Teil des riesigen "
	   +"Gartens, welcher das Haus westlich von Dir umgibt. Das Haus "
	   +"selber ist hoechst eigenartig gebaut und bringt Dich etwas zum Gruebeln. "
	   +"Oestlich von Dir ist noch ein Gartenzaun und eine Hecke.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(("teil"),
	    "Du stehst hier in einem Teil des grossen Gartens.\n");
  AddDetail(("garten"),
	    "Ein sehr grosser Garten. Am besten Du schaust Dich darin ein "
	    +"wenig um.\n");
  AddDetail(("boden"),
	    "Da ist ein perfekt gepflegter Rasen.\n");
  AddDetail(("rasen"),
	    "Der sieht perfekt gepflegt aus.\n");
  AddDetail(({"gruebeln", "anblick"}),
	    "Beim Anblick dieses Hauses kommt man wirklich ins Gruebeln.\n");
  AddDetail(("haus"),
	    "Nur Magie scheint zu verhinden, dass dieses Haus nicht in sich "
	    +"zusammenbricht. Die Magie kann man ja sogar an den Waenden sehen.\n");
  AddDetail(("Waende"),
	    "Die Magie scheint die Waende mit einem silbernen Leuchten zu versehen.\n");
  AddDetail(("leuchten"),
	    "Das silberne Leuchten wird durch die Magie verursacht.\n");
  AddDetail(("magie"),
	    "Die Magie kann man hier sogar fuehlen.\n");
  AddDetail(("himmel"),
	    "Der Himmel ist absolut blau. Allein die Sonne sticht aus dem sonst reinen "
	    +"Blau hervor.\n");
  AddDetail(("blau"),
	    "Ein wirklich schoenes Blau. Nirgends ist das Weiss einer Wolke zu sehen.\n");
  AddDetail(("weiss"),
	    "Am blauen Himmel kannst Du nichts weisses entdecken.\n");
  AddDetail(("wolke"),
	    "Keine Wolke da.\n");
  AddDetail(({"sonne", "tag"}),
	    "So wie die Sonne strahlt, scheint sie gerade einen guten Tag zu haben.\n");
  AddDetail(({"holzzaun", "gartenzaun", "zaun"}),
	    "Ein einfacher weisser Holzzaun.\n");
  AddDetail(({"holz", "buchenholz"}),
	    "Ein weiss gestrichenes Buchenholz.\n"); 
  AddDetail(("hecke"),
	    "Die Hecke ist parallel zum Zaun angepflanzt worden. Sie hat silberne Blaetter "
	    +"und faellt dadurch natuerlich irgendwie auf.\n");
  AddDetail(("blaetter"),
	    "Die sind voellig silbern.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst nichts aufregendes hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts besonderes.\n");
  
  // DETAILS END;

  // EXITS START;
  AddExit ("westen", ROOM("garten21"));
  AddExit ("norden", ROOM("garten1"));
  AddExit ("sueden", ROOM("garten19"));
  // EXITS END;

  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");

  // ITEMS START;
  // ITEMS END;

}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Du laesst die Magie auf Dich wirken.\n"
	    +"Puh, ganz schoen intensiv.\n"));
      return 1;
    }
  else return 0;
}















