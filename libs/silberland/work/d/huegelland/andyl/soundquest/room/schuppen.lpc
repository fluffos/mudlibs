#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

int HORNET_HERE=2;
int platte_weg=0;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:19, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Ein Geraeteschuppen");
  SetProp (P_INT_LONG, "Du stehst in einem kleinen Geraeteschuppen.\n"
	   +"Der etwas duestere Geraeteschuppen ist voellig aus Holz gebaut. Ueberall "
	   +"liegen Gartenwerkzeuge und allerlei Geruempel herum, welches zur "
	   +"Gartenarbeit benoetigt wird. Es ist schon merkwuerdig, dass der Gaertner, "
	   +"der den Garten so sorgfaeltig gepflegt hat, seine Werkzeuge hier so "
	   +"verkommen laesst. Die Temperatur hier ist etwas kuehler als draussen "
	   +"und eine innere Stimme sagt dir, dass hier irgendetwas nicht ganz in "
	   +"Ordnung ist.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("stimme"),
	    "Du kannst ihr ja lauschen.\n");
  AddSound(("stimme"),
	   "Sie sagt: 'Hier stimmt etwas nicht. Sei vorsichtig.'\n");
  AddDetail(({"geraeteschuppen", "schuppen"}),
	    "Du stehst in ihm. Schau Dich halt ein wenig in ihm um.\n");
  AddDetail(("gaertner"),
	    "Der scheint seine Werkzeuge nicht gerade gut zu pflegen.\n");
  AddDetail(("garten"),
	    "Du musst dazu den Schuppen verlassen.\n");
  AddDetail(("temperatur"),
	    "Sie ist etwas kuehler als im Garten.\n");
  AddDetail(("boden"),
	    "Der Boden ist komplett aus Holz und von einer dicken Staubschicht bedeckt.\n");
  AddDetail(({"staubschicht", "staub", "schicht"}),
	    "So dick wie der Staub hier liegt hat hier schon sehr, sehr lange keiner "
	    +"mehr aufgeraeumt oder geputzt.\n");
  AddDetail(({"eichenholz", "holz"}),
	    "Es ist Eichenholz welches hier anscheinend wegen seiner Robustheit "
	    +"gerne verwendet wird.\n");
  AddDetail(("robustheit"),
	    "Die Robustheit von Eichenholz ist wirklich erstaunlich.\n");
  AddDetail(("ordnung"),
	    "Also hier kannst Du nichts von einer Ordnung entdecken.\n");
  AddDetail(({"waende", "wand", "holzwaende"}),
	    "Es sind einfache Holzwaende in denen nirgends ein Fenster eingebaut wurde.\n");
  AddDetail(("fenster"),
	    "Hier sind keine Fenster, obwohl man sie hier durchaus brauchen koennte.\n");
  AddDetail(({"gartenarbeit", "arbeit"}),
	    "Waer das nicht eine Arbeit fuer dich?\n");
  AddDetail(({"werkzeuge", "gartenwerkzeuge", "werkzeug", "gartenwerkzeug"}),
	    "Rechen, Schaufeln, Sensen und andere Gartenwerkzeuge siehst Du "
	    +"hier herumliegen. Die sehen allesamt ziemlich verkommen aus.\n");
  AddDetail(("rechen"),
	    "Die sind teilweise zerbrochen und allesamt ziemlich rostig.\n");
  AddDetail(({"schaufeln", "schaufel"}),
	    "Die Schaufeln sind fast alle komplett vom Rost zerfressen.\n");
  AddDetail(("sensen"),
	    "Die sind nicht mehr zu gebrauchen.\n");
  AddDetail(("geruempel"),
	    "Da liegen Kisten, Saecke und noch ein paar andere Behaelter. "
	    +"Du moechtest lieber nicht wissen was da drinnen alles verschimmelt "
	    +"und vermodert.\n");
  AddDetail(({"kisten", "kiste"}),
	    "Die Kisten sehen ziemlich schaebig aus.\n");
  AddDetail(("saecke"),
	    "An denen sieht man ja schon den Schimmel.\n");
  AddDetail(("schimmel"),
	    "Ihhhh, Schimmel. Der riecht nicht besonders gut.\n");
  AddSmell(("schimmel"),
	   "Waeh, der riecht uebel.\n");
  AddDetail(("behaelter"),
	    "Die fallen schon fast alle auseinander.\n");
  AddDetail(("rost"),
	    "Fast alle Werkzeuge sind durch ihn befallen. Nur bei einer "
	    +"Schaufel kannst Du noch ein Schimmern erkennen.\n");
  AddDetail(("schimmern"),
	    "Unter einer Schaufel schimmert etwas hervor. Vielleicht solltest "
	    +"du mal die Schaufel umdrehen.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst ein unangenehmes Summen hoeren.\n");
  AddSound(("summen"),
	   "Es scheint von oben zu kommen.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht hier ziemlich muffig.\n");
  AddSpecialDetail(({"platte", "holzplatte"}), "platte_schau");
  AddSpecialDetail(("loch"), "loch_schau");
  AddSpecialDetail(({"nest", "hornissennest"}), "badhornet");
  AddSpecialDetail(("decke"), "decke_schau");
  // DETAILS END;
  
  AddCmd(({"schiebe", "schieb"}), "schiebe_weg");
  AddCmd(({"drehe", "dreh"}), "drehe_um");

  // EXITS START;
  AddExit ("raus", ROOM("garten8"));
  // EXITS END;
}

drehe_um(str)
{
  object ob;
  notify_fail("Was willst Du umdrehen?\n");
  if (str == "schaufel um")
    {
      if (!ob=present(("\nsqquestitem"),TP))
	{
	  write (BS("Du drehst die Schaufel um findest aber nichts besonderes.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("\nsqpistill"),TP))
	    {
	      write (BS("Du drehst die Schaufel um und findest hinter ihr "
		    +"einen Pistill den Du sofort einsteckst.\n"));
	      say (BS(this_player()->name(WER,2)+" scheint etwas gefunden zu haben.\n"));
	      CLONE(OBJ("pistill"),(TP));
	      return 1;
	    }
	  else
	    {
	      write (BS("Das hast Du doch schon getan.\n"));
	      return 1;
	    }
	}
    }
  else return 0;
}

platte_schau()
{
  if (platte_weg==1)
    return (BS("Die hat jemand zur Seite geschoben und jetzt ist in der Decke ein Loch.\n"));
  else return (BS("Eine einfache Holzplatte. Die scheint man wegschieben zu koennen.\n"));
}

decke_schau()
{
  if (platte_weg==1)
    return (BS("Die Decke ist voellig aus Holz. Du kannst in ihr ein Loch entdecken.\n"));
  else 
    return (BS("Die Decke ist voellig aus Holz. Eine kleine Holzplatte faellt Dir auf.\n"));
}

loch_schau()
{
  if (platte_weg==1)
    return (BS("Durch das Loch kannst Du ein riesiges Hornissennest sehen.\n"));
  else return (BS("Sowas siehst Du hier nicht!\n"));
}

badhornet()
{
  object ho, ho1, ho2, ho3;
  if (platte_weg == 0)
    {
      return (BS("Sowas siehst Du hier nicht!\n"));
    }
  else
    {
      if ((HORNET_HERE == 1 || HORNET_HERE == 2) && ((!present("hornisse")) && 
						     (!present("hornissenkoenigin"))))
	{
	  write(BS("Als Du gerade das Hornissennest beaeugen willst, " 
		   +"fliegen ploetzlich ein paar Hornissen daraus hervor "
		   +"und greifen Dich an.\n"));
	  say (BS(TP->name(WER, 2)+" lockt ein paar Hornissen aus dem Hornissennest.\n"));
	  
	  (ho = clone_object(NPC("hornissenkoenigin")))->move(TO, M_NOCHECK);
	  (ho1 =clone_object(NPC("hornisse")))->move(TO, M_NOCHECK);
	  (ho2 =clone_object(NPC("hornisse")))->move(TO, M_NOCHECK);
	  (ho3 =clone_object(NPC("hornisse")))->move(TO, M_NOCHECK);
	  ho->Kill(TP);
	  ho1->Kill(TP);
	  ho2->Kill(TP);
	  ho3->Kill(TP);
	  if (HORNET_HERE == 2)
	    {
	      HORNET_HERE=1;
	      return "";
	    }
	  else 
	    {
	     HORNET_HERE=0;
	     return "";
	    }
	}
      else write(BS("Ein wirklich riesiges Nest. Gluecklicherweise scheint gerade keine "
		    + "Hornisse im Nest zu sein.\n"));
      return "";
    }
}

schiebe_weg(str)
{
  notify_fail("Was willst Du wegschieben?\n");
  if ((str == "platte weg" || str == "holzplatte weg"))
    {
      if (platte_weg == 1)
	{
	  write (BS("Aber die Holzplatte ist doch schon weggeschoben worden.\n")); 
	  return 1;
	}
      else 
	{
	  write (BS("Du schiebst die Holzplatte weg und ein Loch ist jetzt in der "
		+"Decke zu sehen.\n"));
	  say (BS(this_player()->name(WER,2)+" legt ein Loch in der Decke frei.\n"));
	  platte_weg=1;
	  return 1;
	}
    }
  else return 0;
}

reset()
{
  HORNET_HERE=2;
  platte_weg=0;
}























