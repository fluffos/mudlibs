#include "../files.h"
#include <properties.h>
#include <wizlevels.h>
#include <language.h>
#include <moving.h>

inherit "std/room";

void create()
{
  ::create();
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  
  AddCmd("", "abc", 1); 
}

int abc(string str)
{
  string verb;
  if (IS_WIZARD(this_player())) return 0;
  else return 1;
}








