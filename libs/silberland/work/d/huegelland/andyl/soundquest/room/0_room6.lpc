#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Ein Schlafzimmer");
  SetProp (P_INT_LONG, "Sieht aus als waere hier das Schlafzimmer des Soundmagiers.\n"
	   +"Du siehst hier ein sehr gemuetlich wirkendes Bett wo daneben ein Nachtkaestchen "
	   +"steht. Ausserdem liegt ein sehr schoener Teppich am Boden und an einer Wand kannst "
	   +"du einen Hebel sehen.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(({"raum", "schlafzimmer", "zimmer"}),
	    "Dieser Raum ist das Schlafzimmer des Soundmagiers.\n");
  AddDetail(("soundmagier"),
	    "Wie es aussieht, ist er gerade nicht hier.\n");
  AddDetail(("teppich"),
	    "Er ist sehr weiss und mit schoenen Mustern verziert.\n");
  AddDetail(("muster"),
	    "Auf dem Teppich sind viele Muster. Dir gefaellt vor allem das silberne Stickmuster "
	    +"in der Mitte des Teppichs.\n");
  AddDetail(("mitte"),
	    "In der Mitte des Teppichs ist ein Stickmuster.\n");
  AddDetail(("stickmuster"),
	    "Es ist aus silbernen Faeden gestickt und duerfte einen Berggipfel darstellen.\n");
  AddDetail (("faeden"),
	     "Sie sind silbern.\n");
  AddDetail(({"gipfel", "berggipfel"}),
	    "Du weisst nicht welchen es darstellt, aber Du findest ihn irgendwie sehr geheimnisvoll.\n");
  AddDetail(({"boden", "holzboden"}),
	    "Ein einfacher Holzboden aus Ebenholz. Auf ihm liegt ein Teppich.\n");
  AddDetail(({"holz", "ebenholz"}),
	    "Das Ebenholz ist wirklich schoen.\n");
  AddDetail(("waende"),
	    "Die Waende hier sind mit Ebenholz verkleidet. An einer Wand faellt Dir ein Hebel auf.\n");
  AddDetail(("hebel"),
	    "Was dieser Hebel wohl macht?\n"
	    +"Du koenntest ja mal versuchen ihn zu ziehen.\n");
  AddDetail(("wand"),
	    "Auf der Wand ist ein Hebel.\n");
  AddDetail(("decke"),
	    "Sie ist aus Stein und weiss gestrichen.\n");
  AddDetail(("stein"),
	    "Es wird da Stein sein...\n");
  AddDetail(("bett"),
	    "Es sieht sehr gemuetlich aus. Alles darin ist aus weicher Seide.\n");
  AddDetail(({"seide", "stoff"}),
	    "Seide, ein sehr schoener, weicher Stoff.\n");
  AddDetail(({"nachtkaestchen", "kaestchen"}),
	    "Ein kleines schlichtes Nachtkaestchen auf dem eine Kerze steht.\n");
  AddDetail(("kerze"),
	    "Die Kerze hier duerfte die einzige Lichtquelle des Raumes sein.\n");
  AddDetail(("lichtquelle"),
	    "Die einzige Lichtquelle hier ist die Kerze.\n");
  AddSound( DEFAULT_SOUND,
	    "Es ist hier nicht wahnsinnig viel zu hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Riechen tut man hier absolut nichts.\n");
  
  // DETAILS END;
  
  // EXITS START;
  AddExit ("suedwesten", ROOM("0_room7"));
  // EXITS END;
  
  // ITEMS START;
  // ITEMS END;

  AddCmd(({"ziehe", "zieh"}), "ziehe_an");
  
}

ziehe_an (str)
{
  object ob;
  notify_fail("Was willst Du ziehen?\n");
  if (str == "hebel")
    {
      if(!ob=present(("\nsqrubin"),TP))
	{
	  write (BS("Du ziehst den Hebel aber nichts passiert.\n" 
		 +"Vielleicht solltest Du es spaeter nochmal probieren.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("\nsqquestitem"),TP))
	    {
	      write(BS("Irgendetwas hast Du vergessen. Versuch das spaeter noch einmal.\n"));
	      return 1;
	    }
	  else
	    {
	      write (BS("Du ziehst den Hebel und auf einmal leuchtet Dein Rubin hell auf "
		     +"und Dir wird leicht schwindlig. Auf einmal befindest Du Dich im 1.Stock "
		     +"des Hauses.\n"));
	      say (BS(this_player()->name(WER,2)+" zieht einen Hebel und verschwindet "
		   +"ploetzlich.\n"));
	      TP->move(ROOM("1_room7"),M_TPORT);
	      return 1;
	    }
	}
    }
  else return 0;
}







