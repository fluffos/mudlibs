#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du stehst hier in einem Teil des riesigen Gartens. "
	   +"Suedwestlich von Dir steht das Haus zu dem er gehoert. "
	   +"Entlang des weissen Gartenzaunes im Norden und Osten sind "
	   +"silberne Hecken angepflanzt worden. Im Sueden siehst Du "
	   +"ausserdem eine sehr schoene Linde. Alles hier sieht auesserst "
	   +"gepflegt aus.\n");
  // ROOM DESCRIPTION END;
       
  // DETAILS START;
  AddDetail(("linde"),
	    "Die befindet sich im Sueden.\n");
  AddDetail(("sueden"),
	    "Da steht eine sehr schoene Linde.\n");
  AddDetail(("himmel"),
	    "Absolut blau. Kein Woelkchen zu sehen. Einzig die Sonne scheint "
	    +"angenehm herunter.\n");
  AddDetail(({"sonne", "lust"}),
	    "Sie scheint schoen warm auf Dich herab. Du haettest jetzt "
	    +"wirklich Lust auf ein Sonnenbad.\n");
  AddDetail(("sonnenbad"),
	    "Naja, vielleicht spaeter.\n");
  AddDetail(("woelkchen"),
	    "Du suchst den Himmel genau ab. Du findest aber keines.\n");
  AddDetail(("boden"),
	    "Da ist ein perfekt gepflegter Rasen.\n");
  AddDetail(("garten"),
	    "Er sieht aeusserst gepflegt aus.\n");
  AddDetail(({"zaun", "holzzaun", "gartenzaun"}),
	    "Ein einfacher weisser Holzzaun.\n");
  AddDetail(({"hecke", "hecken"}),
	    "Die Hecke hat silberne Blaetter.\n");
  AddDetail(({"blaetter", "farbe", "blatt"}),
	    "Die Blaetter haben eine silberne Farbe. Du denkst . o O (Was es nicht so "
	    +"alles im Silberland gibt).\n"); 
  AddDetail(({"rasen", "gras"}),
	    "Das nennt man einen wirklich gut gepflegten Rasen. Wer wohl der Gaertner ist?\n");
  AddDetail(("gaertner"),
	    "Den wuerdest Du wirklich gerne kennenlernen.\n");
  AddDetail(({"silberland", "detail"}),
	    "Ein Detail fuer das ganze Silberland? Das waere doch wohl etwas zu "
	    +"einfach.\n");
  AddDetail(("haus"),
	    "Es sieht sehr seltsam aus. Die Waende glitzern silbern und wirken irgendwie "
	    +"unnatuerlich. Wenn die Konstruktion den physikalischen "
	    +"Gesetzen gehorchen wuerde, wuerde es wahrscheinlich zusammenbrechen. "
	    +"Da scheint Magie benutzt worden zu sein.\n");
  AddDetail(("magie"),
	    "Du kannst sie direkt fuehlen.\n");
  AddDetail(({"gesetze", "Gesetzen"}),
	    "Das Haus wiedersetzt sich ihnen.\n");
  AddDetail(({"konstruktion"}),
	    "Die muesste normalerweise in sich zusammenstuerzen.\n");
  AddDetail(("teil"),
	    "Du befindest Dich in einem Teil des riesigen Gartens.\n");
  AddDetail(("waende"),
	    "Von den Waenden des Hauses geht ein unnatuerlicher silberner Glanz aus.\n");
  AddDetail(("glanz"),
	    "Ein geheimnisvoller silberner, wahrscheinlich magischer, Glanz.\n");
  AddDetail(("haende"),
	    "Waeh, die sind ja gar nicht gewaschen. Das holst Du aber gleich nach, oder?\n");
  AddDetail(("gefuehl"),
	    "Das Gefuehl wuerdest Du gerne oefter haben.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst nichts Auffallendes hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts besonderes.\n");

  
  // DETAILS END;


  // EXITS START;
  AddExit ("westen", ROOM("garten6"));;
  AddExit ("sueden", ROOM("garten4"));
  // EXITS END;

  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  AddCmd(({"bad", "bade", "nimm"}), "bade_in");
  // ITEMS START;
  // ITEMS END;

}


bade_in(str)
{
  notify_fail("Worin willst Du baden?\n");
  if ((str == "in sonne" || str == "sonnenbad"))
    {
      if (TP->QueryProp(P_RACE)=="Dunkelelf")
	{
	  write(BS("Du setzt Dich ins Gras und badest kurz in der Sonne.\n"
		   +"ARRGGHH, das tut ja echt weh!\n"));
	  TP->AddHp(-10);
	  return 1;  
	}
      else
	{
	  write(BS("Du setzt Dich ins Gras und nimmst ein kurzes Sonnenbad.\n"
		   +"Ahhhh, schoen. Aber jetzt wieder auf zu neuen Taten!\n"));
	  say(BS(TP->name(WER,0)+" nimmt ein kurzes Sonnenbad.\n"));
	  return 1;
	}
    }
  else return 0;
}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    { 
      write (BS("Du streckst Deine Haende aus und laesst die Magie darauf wirken. "
	    +"Ein wirklich aufbauendes Gefuehl.\n"));
      return 1;
    }
  else return 0;
}


  











