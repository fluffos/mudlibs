#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten"); 
  SetProp (P_INT_LONG, "Du stehst in einem Teil des grossen "
	   +"Gartens, welcher zu dem Haus noerdlich von Dir gehoert. "
	   +"Das Haus selber muesste eigentlich das Warnschild:\n"
	   +"Achtung! Einsturzgefaehrdet!\n"
	   +"tragen. Doch irgendeine Macht verhindert den Einsturz. " 
	   +"Im Sueden faellt Dir noch eine grosse Eiche auf.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(("sueden"),
	    "Da steht eine grosse Eiche.\n");
  AddDetail(("eiche"),
	    "Die praechtige Eiche befindet sich im Sueden.\n");
  AddDetail(("teil"),
	    "Du befindest Dich hier in einem Teil des grossen Gartens.\n");
  AddDetail(("garten"),
	    "Der Garten ist ziemlich gross.\n");
  AddDetail(("warnschild"),
	    "Ein Warnschild ist hier nirgends.\n");
  AddDetail(("himmel"),
	    "Die Sonne strahlt aus dem blauen Himmel herab. Wolken "
	    +"kannst Du an ihm keine erkennen.\n");
  AddDetail(("wolken"),
	    "Keine zu sehen.\n");
  AddDetail(("sonne"),
	    "Sie scheint Dir angenehm auf Deinen Koerper.\n");
  AddDetail(("koerper"),
	    "Ein absoluter Traumkoerper.\n");
  AddDetail(("traumkoerper"),
	    "Dein Koerper natuerlich.\n");
  AddDetail(("macht"),
	    "Das ist bestimmt Magie.\n");
  AddDetail(("einsturz"),
	    "Vorlaeufig gibts noch keinen.\n");
  AddDetail(("haus"),
	    "Die Waende des Hauses scheinen von Magie umgeben zu sein.\n");
  AddDetail(("waende"),
	    "Von ihnen geht ein silbernes Schimmern aus.\n");
  AddDetail(("schimmern"),
	    "Das Schimmern wird wahrscheinlich durch Magie erzeugt.\n");
  AddDetail(("magie"),
	    "Du kannst sie hier direkt fuehlen.\n");
  AddDetail(("boden"),
	    "Du stehst auf einem traumhaft gruenen Rasen.\n");
  AddDetail(("rasen"),
	    "Der wurde wirklich sehr gut gepflegt. Aber Dir faellt "
	    +"trotzdem eine kleine Unebenheit darin auf.\n");
  AddDetail(("unebenheit"),
	    "Ups, die duerfte ja von Dir stammen. Du solltest "
	    +"unkontrollierte Bewegungen Deiner Fuesse doch besser vermeiden.\n");
  AddDetail(({"bewegungen", "kontrolle"}),
	    "Du hast Deine Bewegungen jetzt wieder voll unter Kontrolle.\n");
  AddDetail(("fuesse"),
	    "Was man nicht alles damit anrichten kann.\n");
  AddDetail(("massage"),
	    "Einer Massage bist Du ja eigentlich auch nie wirklich abgeneigt.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst nichts besonderes.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nicht wirklich viel.\n");

  // DETAILS END;
  
  // EXITS START;
  AddExit ("sueden", ROOM("garten16"));
  AddExit ("westen", ROOM("garten14"));
  AddExit ("suedosten", ROOM("garten17"));
  // EXITS END;
  
  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  
  // ITEMS START;
  // ITEMS END;
  
}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Du fuehlst die Magie durch Deinen Koerper fliessen.\n"
	    +"Eindeutig besser als jede Massage.\n"));
      return 1;
    }
  else return 0;
}





























