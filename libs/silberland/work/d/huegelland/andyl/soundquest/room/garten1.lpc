#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
       SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du stehst hier in einem Teil des Gartens, "
	   +"welcher zu dem Haus westlich von Dir gehoert. "
	   +"Alles hier sieht sehr gepflegt aus, vom Rasen ueber die "
	   +"Hecke bis zum Gartenzaun. Richtung Osten kommst Du "
	   +"in den Vorgarten und westlich gehts ins Haus.\n");
  // ROOM DESCRIPTION END;
       
  // DETAILS START;
  AddDetail(("himmel"),
	    "Er ist strahlend blau. Du kannst kein Woelkchen an ihm sehen. "
	    +"Die Sonne scheint hell leuchtend von ihm herunter.\n");
  AddDetail(("osten"),
	    "Da ist der Vorgarten.\n");
  AddDetail(("sonne"),
	    "Sie scheint Dir angenehm auf Deine Haut.\n");
  AddDetail(("woelkchen"),
	    "Keines zu sehen.\n");
  AddDetail(("haut"),
	    "Deine Haut sieht, wie Du schon immer gewusst hast, geradezu perfekt aus.\n");
  AddDetail(("boden"),
	    "Du stehst auf einem perfekt gepflegtem Rasen.\n");
  AddDetail(("garten"),
	    "Er ist ziemlich gross und ausserdem extrem gut gepflegt.\n");
  AddDetail(({"rasen", "gras"}),
	    "Der Rasen sieht saftig gruen und perfekt gepflegt aus.\n");
  AddDetail(("haus"),
	    "Es sieht sehr seltsam aus. Die Waende glitzern silbern und wirken irgendwie "
	    +"unnatuerlich. Wenn die Konstruktion den physikalischen "
	    +"Gesetzen gehorchen wuerde, wuerde es wahrscheinlich zusammenbrechen. "
	    +"Da scheint Magie benutzt worden zu sein.\n");
  AddDetail(("magie"),
	    "Du kannst sie direkt fuehlen.\n");
  AddDetail(({"gesetze", "gesetzen", "gesetz"}),
	    "Das Haus widersetzt sich ihnen.\n");
  AddDetail(({"konstruktion"}),
	    "Die muesste normalerweise in sich zusammenstuerzen.\n");
  AddDetail(({"zaun", "gartenzaun", "gartenzauns"}),
	    "Ein einfacher, weiss gestrichener Gartenzaun.\n");
  AddDetail(("teil"),
	    "Du befindest Dich in einem Teil des riesigen Gartens.\n");
  AddDetail(({"wand", "waende", "glitzern"}),
	    "Die Waende des Hauses glitzern unnatuerlich silbern.\n");
  AddDetail(("hecke"),
	    "Die Hecke ist entlang des Gartenzauns angepflanzt worden. Du kannst "
	    +"nicht identifizieren aus welcher Pflanzenart sie besteht.\n");
  AddDetail(({"pflanzenart", "art"}),
	    "Ausser dass sie silberne Blaetter hat, kannst Du nichts Besonderes an ihr "
	    +"erkennen.\n");
  AddDetail(("blaetter"),
	    "Die Blaetter haben eine silberne Farbe.\n");
  AddDetail(("farbe"),
	    "Eine silberne Farbe.\n");
  AddDetail(("gefuehl"),
	    "Ein wirklich gutes Gefuehl.\n");
  AddDetail(({"koerper", "traumkoerper"}),
	    "Ein regelrechter Traumkoerper.\n");
  AddDetail(("vorgarten"),
	    "Den kannst Du durch das Gartentor betreten.\n");
  AddSound(({ DEFAULT_SOUND, "aufregendes"}),
	    "Du kannst nichts Aufregendes hoeren.\n");
  
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts besonderes.\n");

  // DETAILS END;
  
  
  // EXITS START;
  AddExit ("haus",([EX_DEST :  ROOM("0_room1"),
		    EX_MSG : "ins Haus"]));
  AddExit ("nordwesten", ROOM("garten3"));
  AddExit ("sueden", ROOM("garten22"));
  AddExit ("suedwesten", ROOM("garten21"));
  AddExit ("norden", ROOM("garten2"));
  NewDoor ("osten", ROOM("vorgarten"),
    ({"gartentor", "tor"}),
    ({
      D_LONG, "Ein kleines Gartentor fuehrt in den Vorgarten.\n",
      D_GENDER, NEUTER,
      D_SHORT, "Ein %ses Gartentor.",
      D_NAME, "Gartentor",
      D_MSGS, "in den Vorgarten",
    }) );
  // EXITS END;
  
  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  
  // ITEMS START;
  // ITEMS END;

}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Du fuehlst die Magie und laesst sie auf Deinen Koerper "
	    +"wirken. Ah, das ist ein angenehmes Gefuehl!\n"));
      return 1;
    }
  else return 0;
}














