#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Gemuesegarten");
  SetProp (P_INT_LONG, "Du befindest Dich hier in einem Gemuesegarten. "
	   +"Um Dich herum kannst Du einige Gemuesebeete sehen in denen "
	   +"allerlei Gemuese angepflanzt wurde. Im Osten siehst Du das "
	   +"ungewoehnliche Soundmagierhaus. Westlich und suedostlich "
	   +"kannst Du den Zaun sehen der den Garten einzaeunt und die "
	   +"Hecke die parallel dazu angepflanzt wurde.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(("boden"),
	    "Unter Dir fuehrt ein kleiner Weg zwischen den Gemuesebeeten "
	    +"hindurch.\n");
  AddDetail(("himmel"),
	    "Aus dem strahlend blauen Himmel scheint Dir die Sonne "
	    +"hell strahlend entgegen.\n");
  AddDetail(("sonne"),
	    "Die Sonne scheint Dir hell strahlend aus dem Himmel entgegen.\n");
  AddDetail(("weg"),
	    "Der Weg besteht aus flachen Steinen die einfach auf das Gras "
	    +"gelegt worden sind.\n");
  AddDetail(("gras"),
	    "Zwischen den Steinen kannst Du das gruene Gras sehen.\n");
  AddDetail(({"steine", "stein"}),
	    "Es sind einfache grosse flache Steine.\n");
  AddDetail(("garten"),
	    "Der ist ziemlich gross und zudem noch sehr gut gepflegt.\n");
  AddDetail(("osten"),
	    "Im Osten steht das ungewoehnliche Soundmagierhaus.\n");
  AddDetail(({"zaun", "holzzaun"}),
	    "Ein einfacher weisser Holzzaun.\n");
  AddDetail(("hecke"),
	    "Die Hecke verlaeuft parallel zum Zaun. Ihre Blaetter sind "
	    +"vollkommen silbern.\n");
  AddDetail(("blaetter"),
	    "Die sind vollkommen silbern. Das sieht man nicht sehr oft.\n");
  AddDetail(({"haus", "soundmagierhaus"}),
	    "Das Soundmagierhaus ist sehr ungewoehnlich konstruiert.\n"
	    +"Gewoehnlich muesste es bei dieser Bauweise sofort "
	    +"einstuerzen. Jedoch scheint Magie das zu verhindern.\n");
  AddDetail(("bauweise"),
	    "Bei dieser Bauweise muesste das Haus eigentlich einstuerzen.\n");
  AddDetail(("magie"),
	    "Die Magie ist sogar an den Waenden des Hauses zu sehen. Sie "
	    +"ist hier so intensiv, dass man sie sogar fuehlen kann.\n");
  AddDetail(({"waende", "wand"}),
	    "An den Waenden kannst Du ein silbernes Schimmern entdecken.\n");
  AddDetail(({"erde", "humus"}),
	    "In den Beeten scheint eine sehr naehrstoffreiche Erde (auch als Humus "
	    +"bekannt) zu sein.\n"); 
  AddDetail(("schimmern"),
	    "Das silberne Schimmern duerfte durch Magie hervorgerufen "
	    +"werden.\n");
  AddDetail(("gemuesegarten"),
	    "Du stehst hier in einem Gemuesegarten. Vielleicht kann "
	    +"man hier etwas nuetzliches finden.\n");
  AddDetail(({"gemuesebeete", "beete", "gemuesebeet", "beet", "beeten"}),
	    "In den Gemuesebeeten kannst Du allerlei Gemuese entdecken.\n");
  AddDetail(("gemuese"),
	    "Du siehst hier ein paar Karotten, weiters Erbsen und "
	    +"Fisolen.\n");
  AddDetail(("karotten"),
	    "Karotten die noch nicht ganz reif sind. Das waer doch sicher "
	    "etwas fuer den Osterhasen.\n");
  AddDetail(("osterhase"),
	    "Der wuerde sich sicher ueber die Karotten freuen.\n");
  AddDetail(("erbsen"),
	    "Wenn sie reif waeren, wuerden sie sicher eine gute "
	    +"Beilage abgeben.\n");
  AddDetail(("beilage"),
	    "Die Erbsen wuerden eine gute Beilage abgeben.\n");
  AddDetail(({"fisolen", "salat"}),
	    "Die Fisolen wuerden sicher einen guten Salat abgeben. "
	    +"Neben den Fisolen kannst Du jetzt auch ein kleines "
	    +"Straeusschen Schnittlauch entdecken.\n");
  AddDetail(("straeusschen"),
	    "Ein kleines Straeusschen Schnittlauch.\n");
  AddDetail(("schnittlauch"),
	    "Ein kleines Straeusschen Schnittlauch. Vielleicht "
	    +"kannst Du Dir davon ein wenig abschneiden.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst nichts aufregendes hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht hier nach Gemuese.\n");
  AddSmell(("schnittlauch"),
	   "Der riecht gut.\n");
  AddSmell(({"erbsen", "fisolen", "karotten"}),
	   "Die riechen ziemlich schmackhaft.\n");
  
  // DETAILS END;
  
  AddCmd(({"fuehle", "fuehl"}),"fuehle_was");
  AddCmd(({"schneide", "schneid"}), "schneide_was");

  // EXITS START
  AddExit ("norden", ROOM("garten12"));
  AddExit ("nordosten", ROOM("garten11"));
  AddExit ("suedosten", ROOM("garten14"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Sie fuehlt sich weich aber doch auch sehr "
	    +"maechtig an.\n"));
      return 1;
    }
  else return 0;
}

schneide_was(str)
{
  string stri, stri1;
  object waffe;
  object ob;
  notify_fail("Was willst Du womit abschneiden?\n");
  if (!str) return 0;
  if (str == "schnittlauch ab")
    {
      write (BS("Womit willst Du den Schnittlauch abschneiden?\n"));
      return 1;
    }
  if (!waffe=TP->QueryProp(P_WEAPON)) 
    {
      write (BS("Du hast ja gar nichts zum Abschneiden gezueckt.\n"));
      return 1;
    }
  else
    {
      sscanf(str, "%s mit %s ab", stri1, stri);
      if ((stri=="waffe" || waffe->id(stri)) && stri1=="schnittlauch")
	{
	  if ((TP->QueryProp(P_WEAPON)->QueryProp(P_WEAPON_TYPE) == "sword") ||
              (TP->QueryProp(P_WEAPON)->QueryProp(P_WEAPON_TYPE) == "knife"))
	    {
	      if (!ob=present(("\nsqquestitem"),TP))
		{
		  write (BS("Jetzt brauchst Du eh noch keinen Schnittlauch. "
			+"Vielleicht spaeter.\n"));
		  return 1;
		}
	      else
		{
		  if (!ob=present(("\nsqschnittlauch"),TP))
		    {
		      write (BS("Du schneidest Dir etwas von dem Schnittlauch ab.\n"));
		      say (BS(this_player()->name(WER,2)+" schneidet sich etwas "
			   +"von dem Schnittlauch ab.\n"));
		      CLONE(OBJ("schnittlauch"),(TP));
		      return 1;
		    }
		  else write (BS("Aber Du hast doch schon etwas Schnittlauch.\n"));
		  return 1;
		  
		  }
	      }	  
	    else 
	      {
		write (BS("Damit kannst Du den Schnittlauch nicht abschneiden.\n"));
		return 1;
	      }
	}
      else 
	{
	  return 0;
	}
    }
  return 0;
}









