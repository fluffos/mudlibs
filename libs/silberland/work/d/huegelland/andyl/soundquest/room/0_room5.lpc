#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

int langsam;
int trankdrin;

void init()
{
  object ob;
  if ((!ob=present("\nsqnkobold",TP)) && (!ob=present("\nsqrubin",TP)) && 
      (!ob=present("\nsqkobold")) && (ob=present("\nsqquestitem",TP)))
    {
      clone_object(NPC("kobold"))->move(TO, M_NOCHECK);  
    }
  ::init();
}

void create()
{
  langsam = 0;
  trankdrin = 0;
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Das Zimmer von Umpf");
  SetProp (P_INT_LONG, "Hier ist das Zimmer von Umpf.\n"
	   +"Eine einfache Matratze liegt in einer Ecke des Raumes, "
	   +"die dem Gnom wahrscheinlich als Bett dient. "
	   +"Dann ist da noch ein kleiner Kasten, neben dem ein kleiner "
	   +"aber dennoch sehr schwerer Kupferkessel steht. "
	   +"Ausserdem siehst Du noch einen Haufen Plunder.\n"); 
  SetProp (P_NAME, "Herabfallendes Geruempel");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(({"raum", "zimmer"}),
	    "Dieser Raum ist das Zimmer von Umpf.\n");
  AddDetail(({"geruempel"}),
	    "Viel unnuetzes Geruempel.\n");
  AddDetail(("gnom"),
	    "Umpf ist ein Gnom.\n");
  AddDetail(("umpf"),
	    "Der ist nicht hier. Er jammert wahrscheinlich noch immer "
	    +"vor dem Haus.\n");
  AddDetail(("ecke"),
	    "In der Ecke liegt eine Matratze.\n");
  AddDetail(("haus"),
	    "Du stehst im Haus des Soundmagiers.\n");
  AddDetail(("soundmagier"),
	    "Der scheint gerade nicht zuhause zu sein.\n");
  AddDetail(({"boden", "holzboden"}),
	    "Ein einfacher Holzboden aus Buchenholz.\n");
  AddDetail(({"buchenholz", "holz"}),
	    "Einfaches Buchenholz.\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende hier sind aus weissem Stein. An einer Wand flackert eine Fackel.\n");
  AddDetail(("stein"),
	    "Der Stein ist voellig weiss.\n");
  AddDetail(("fackel"),
	    "Die Fackel spendet dem Raum das noetige Licht.\n");
  AddDetail(("licht"),
	    "Es kommt von der Fackel.\n");
  AddDetail(("decke"),
	    "Die Decke ist aus weissem Stein.\n");
  AddDetail(("matratze"),
	    "Die Matratze wirkt etwas hart. Ob man darauf wirklich gut schlafen kann?\n");
  AddDetail(("bett"),
	    "Das Bett besteht nur aus einer einfachen Matratze.\n");
  AddDetail(("kasten"),
	    "Ein kleiner Kasten aus Buchenholz. Du koenntest ihn ja mal oeffnen. "
	    +"Was da wohl drinnen ist?\n");
  AddSpecialDetail(({"kupferkessel", "kessel"}), "kessel_schau");
  AddSpecialDetail(({"zaubertrank", "trank"}), "trank_schau");
  AddDetail(("haufen"),
	    "Ein grosser Haufen wertloser Plunder.\n");
  AddDetail(("plunder"),
	    "Alles unbrauchbar oder kaputt.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du kannst hier nichts besonderes riechen.\n");
  // DETAILS END;
  
  // EXITS START;
  AddSpecialExit (("osten"), "osten_geh");
  // EXITS END;
  
  AddCmd(("oeffne"), "oeffne_was");
  AddCmd(({"fange", "fang"}), "fange_was");
  AddCmd(({"schuette", "schuett"}), "schuette_was");
  AddCmd(({"schmeiss", "schmeisse", "werfe", "wirf"}), "schmeiss_was");
  AddCmd(({"lausch", "lausche"}), "lausch_mal");
  // ITEMS START;
  // ITEMS END;

  previous_object()->CustomizeObject(); 
}

lausch_mal()
{
  object npc;
  if (present(("kobold"),TPENV))
    {
      write (BS("Du hoerst andauernd bloede Bemerkungen von dem Kobold.\n"));  
      return 1;
    }
  else
    {
      write("Stille.\n");  
      return 1;
    }
}


osten_geh()
{  
  TP->move(ROOM("0_room4:"+getuid(this_player())), M_GO);
  return 1;
}


kessel_schau()
{
  if (trankdrin == 1) return("In dem Kessel ist ein Zaubertrank.\n");
  else return (BS("Ein kleiner Kupferkessel, in den man vielleicht etwas "
	      +"reinschuetten koennte.\n"));
}

trank_schau()
{
  if (trankdrin == 1) return (BS("Ein geheimnisvoller Zaubertrank.\n"));
  else return (BS("Sowas siehst Du da nicht!\n"));

}


oeffne_was (str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (str == "kasten") 
    {
      write (BS("Du oeffnest den Kasten worauf Du unter Bergen von Geruempel "
	     +"begraben wirst, die "
	     +"dir mit hoher Geschwindigkeit entgegenkommen.\n"));
      (TP->do_damage(5));
      write (BS("Nachdem Du Dich wieder aus dem Geruempel befreit hast, "
	    +"schiebst Du alles in den Kasten zurueck und "
	    +"unter grosser Anstrengung schliesst Du ihn wieder.\n"));
      return 1;
    }
  else return 0;
}


fange_was(str)
{
  object ob, ob1, ob2;
  notify_fail("Wen oder was willst Du fangen?\n");
  if (str == "kobold")
    {
      if (!ob=present(("\nsqkobold"),TPENV))
	{
	  write (BS("Du siehst hier keinen Kobold.\n"));
	  return 1;
	}
      else
	{
	  if (langsam == 0)
	    {
	      write (BS("So wirst Du den Kobold sicher nicht erwischen.\n"));
	      return 1;
	    }
	  else
	    {
	      write (BS("So einfach kannst Du den Kobold selbst jetzt nicht fangen.\n"
			+"Dazu wirst Du wohl ein Hilfsmittel brauchen.\n"));
	      return 1;
	    }
	}
    }
  if (str == "kobold mit netz")
    {
      if (!ob2=present(("\nsqkobold"),TPENV))
	{
	  write (BS("Du siehst hier keinen Kobold.\n"));
	  return 1;
	}
      else
	{
	  if (!ob1=present(("\nsqnetz"),TP))
	    {
	      write (BS("Aber Du hast doch gar kein Netz.\n"));
	      return 1;
	    }
	  else
	    {
	      if (!ob=present(("\nsqquestitem"),TP))
		{
		  write (BS("Du kannst das jetzt noch nicht machen.\n"));
		  return 1;
		}
	      else 
		{
		  if (!ob=present(("\nsqnkobold"),TP))
		    {
		      if (!ob=present(("\nsqrubin"),TP))
			{
			  if (langsam == 1)
			    {
			      write (BS("Du faengst den Kobold gekonnt mit dem "
				    +"Netz ein.\n"));
			      ob1->remove();
			      ob2->remove();
			      CLONE(OBJ("nkobold"),(TP));
			      langsam=0;
			      trankdrin=0;
			      AddSound( DEFAULT_SOUND,
					"Es ist absolut still hier.\n");
			      return 1;
			    }
			  else
			    {
			      write (BS("Selbst mit dem Netz erwischt Du den "
				    +"Kobold nicht. Er ist einfach zu schnell.\n"));
			      return 1;
			    }
			}
		      else 
			{
			  write (BS("Nochmal brauchst Du das nicht mehr machen.\n"));
			  return 1;
			}
		    }
		  else
		    {
		      write (BS("Du hast den Kobold doch schon.\n"));
		      return 1;
		    }
		}
	    }
	}
    }
  return 0;
}

schuette_was(str)
{
  object ob;
  notify_fail("Was willst Du wohin schuetten?\n");
  if ((str == "zaubertrank in kessel" || str == "zaubertrank in kupferkessel" ||
       str == "flaeschchen in kessel" || str == "flaeschchen in kupferkessel" ||
       str == "trank in kessel" || str == "trank in kupferkessel" ||
       str == "zaubertrankflaeschchen in kessel" ||
       str == "zaubertrankflaeschchen in kupferkessel" ||
       str == "trankflaeschchen in kessel" ||
       str == "trankflaeschchen in kupferkessel"))
    {
      if (!ob=present(("\nsqzaubertrank"),TP))
	{
	  write (BS("Aber Du hast doch gar keinen Zaubertrank.\n"));
	  return 1;
	}
      else 
	{
	  if (trankdrin == 1)
	    {
	      write (BS("Aber da ist bereits ein Zaubertrank drinnen.\n"));
	      ob->remove();
	      return 1;
	    }
	  else
	    {
	      write (BS("Du schuettest den Zaubertrank in den Kupferkessel.\n"));
	      trankdrin=1;
	      ob->remove();
	      return 1;
	    }
	}
    }
  return 0;
}

schmeiss_was(str)
{
  object ob, ob1;
  notify_fail("Was willst Du auf wen schmeissen?\n");
  if ((str == "tomate auf kobold" || str == "faule tomate auf kobold" || 
       str == "tomate nach kobold" || str == "faule tomate nach kobold"))
    {
      if (!ob=present(("\nsqtomate"),TP))
	{
	  write (BS("Aber Du hast ja gar keine faule Tomate.\n"));
	  return 1;
	}
      else
	{
	  if (!ob1=present(("\nsqkobold"),TPENV))
	    {
	      write (BS("Du siehst hier keinen Kobold.\n"));
	      return 1;
	    }
	  else
	    {
	      if (trankdrin == 0)
		{
		  write (BS("Der Kobold weicht der faulen Tomate geschickt aus "
			+"indem er einfach im Kupferkessel in Deckung geht "
			+"und Dir dann die Zunge zeigt und dazu noch vergnuegt kreischt:\n"
			+"Daneben, daneben !!!\n"));
		  ob->remove();
		  return 1;
		}
	      else
		{
		  write (BS("Du wirfst die faule Tomate auf den Kobold der "
			+"schnell versucht im Kupferkessel Deckung zu finden. "
			+"Nur anscheinend hat er den Zaubertrank uebersehen der "
			+"jetzt im Kessel ist und springt mit einem schoenen: "
			+"'PLATSCH' in den Zaubertrank. Empoert klettert er wieder "
			+"aus dem Kessel und schaut Dich boese an. Es scheint als habe "
			+"er jetzt einen Grossteil seiner Schnelligkeit verloren.\n"));
		  langsam=1;
		  ob->remove();
		  return 1;
		}
	    }
	}
    }      
  else return 0;
}
































