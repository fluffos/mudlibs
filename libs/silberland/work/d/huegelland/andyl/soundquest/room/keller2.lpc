#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

int amphore = 0;
int diamant;

void create()
{
  ::create();
  diamant = 1;

  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:17, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Eine verstaubte alte Rumpelkammer");
  SetProp (P_INT_LONG, "Du stehst hier in einer alten staubigen Rumpelkammer.\n"
	   +"Rund um Dich herum sind alle Arten von altem Plunder. Da sind "
	   +"mottenzerfressene Teppiche, alte Schuhe, eine Menge alter "
	   +"Notenblaetter, alte Moebel, alte Gefaesse, altes Gartenwerkzeug " 
	   +"und jede Menge Staub. Eine Tuer fuehrt zurueck nach Norden.\n");	 
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("boden"),
	    "Der Boden ist von einer dicken Staubschicht bedeckt, Du kannst "
	    +"also nicht erkennen woraus er besteht.\n"); 
  AddDetail(("decke"),
	    "Sogar die Decke ist mit einer dicken Staubschicht bedeckt. "
	    +"wie kann sich ueberhaupt auf der Decke soviel Staub ansammeln?\n");
  AddDetail(({"wand", "waende"}),
	    "Die Waende sind alle mit einer dicken Staubschicht bedeckt.\n");
  AddDetail(({"staubschicht", "schicht"}),
	    "Waende, Boden und Decke sind alle mit einer dicken Staubschicht "
	    +"bedeckt. Wie lang hat hier schon niemand mehr staubgewischt?\n");
  AddDetail(("soundmagier"),
	    "In diesem Haus gibt es bestimmt einen, nur ist der sicher nicht hier.\n");
  AddDetail(({"kammer", "rumpelkammer", "raum", "soundmagierhaus", "keller"}),
	    "Du befindest Dich hier in einer alten staubigen Rumpelkammer im "
	    +"Keller des Soundmagierhauses.\n");
  AddDetail(({"plunder", "arten", "art"}),
	    "Hier gibts jede Menge Plunder. Mottenzerfressene Teppiche, alte "
	    +"Schuhe, eine Menge alter Notenblaetter, alte Moebel, alte Gefaesse, " 
	    +"altes Gartenwerkzeug und jede Menge Staub.\n");
  AddDetail(({"menge", "mengenlehre"}),
	    "Wohl bei der Mengenlehre nicht ganz aufgepasst?\n"); 
  AddDetail(("staub"),
	    "Staub ist hier viel und reichlich. Ober Dir, unter Dir, rechts von Dir "
	    +"Links von Dir, hinter Dir, vor Dir...  WAHH, Du bist umzingelt!\n");
  AddDetail(({"teppich", "teppiche", "fetzen"}),
	    "Die Teppiche waren sicher einmal sehr schoen, aber jetzt sind sie nur "
	    +"noch mottenzerfressende Fetzen.\n");
  AddDetail(({"motten", "viecher"}),
	    "Kleine laestige, stofffressende Viecher.\n");
  AddDetail(({"schuh", "schuhe"}),
	    "Die Schuhe sind sicher uralt und voellig unbrauchbar. Ein seltsamer "
	    +"Geruch geht von ihnen aus.\n");
  AddDetail(("geruch"),
	    "Du koenntest an den Schuhen riechen, aber ob das empfehlenswert ist?\n");
  AddDetail(({"haufen", "blaetter", "notenblaetter"}),
	    "Ein Haufen alter Notenblaetter liegt hier herum. Scheinen wohl misslungene "
	    +"Stuecke des Soundmagiers zu sein.\n");
  AddDetail(("stuecke"),
	    "Die Stuecke scheinen ziemlich misslungen zu sein.\n");
  AddDetail(("moebel"),
	    "Alte Moebel die keiner mehr braucht, da sie entweder zerbrochen oder "
	    +"extrem haesslich sind.\n");
  AddDetail(({"gartenwerkzeug", "werkzeug", "schuppen", "pistill", "zeug"}),
	    "Ein Menge altes Gartenwerkzeug welches verrostet, zerbrochen oder "
	    +"sonstwie unbrauchbar ist. Eigentlich wuerde man ja sowas eher in "
	    +"einem Schuppen vermuten. Nur im Schuppen findet man ja nur so "
	    +"unnuetzes Zeug wie einen Pistill.\n");
  AddDetail(({"gefaesse", "gefaess"}),
	    "Hier gibts eine Menge Gefaesse, Vasen, Toepfe, Kisten, Amphoren und ein "
	    +"paar Saecke.\n");
  AddDetail(({"vasen", "vase"}),
	    "Alte haessliche Vasen wie man sie am besten niemanden schenkt, wenn man "
	    +"sie nicht hinterherfliegen haben will.\n");
  AddDetail(({"toepfe", "topf"}),
	    "Alte Toepfe, staubig, angerostet und lebensgefaehrlich fuer jeden der "
	    +"darin noch etwas kocht.\n");
  AddDetail(({"kisten", "kiste", "symbol"}),
	    "Alte zerbrochene Kisten die zu nichts zu gebrauchen sind. Man kann sie "
	    +"micht oeffnen, nicht schliessen und schon gar nicht verschieben um ein "
	    +"doofes Symbol dahinter zu finden.\n");
  AddDetail(({"sack", "saecke"}),
	    "Alte loechrige S�cke, die alles durchfallen lassen wuerde was man in " 
	    +"sie stecken wuerde.\n");
  AddDetail(("amphoren"),
	    "Hm, da war wohl einmal etwas drinnen. Moment, da faellt Dir eine "
	    +"Amphore besonders auf.\n");
  AddSpecialDetail(("amphore"), "amphore_schau");
  
  AddSound( DEFAULT_SOUND,
	    "Hmm, Staub scheint nicht sehr kommunikationsfreudig zu sein.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Ein seltsamer Geruch geht von den alten Schuhen aus.\n");
  
  // DETAILS END;
  

  // COMMANDS
  AddCmd(({"riech", "rieche"}), "rieche_was");
  AddCmd(({"ziehe", "zieh"}), "ziehe_was");
  // COMMANDS END
  
  // EXITS START;
  AddSpecialExit ("norden", "goto_keller1");
  // EXITS END;

  // ITEMS START;
  // ITEMS END;

  previous_object()->CustomizeObject(); 
  
}

goto_keller1()
{  
  TP->move(ROOM("keller1:"+getuid(this_player())), M_GO);
  return 1;
}


amphore_schau()
{
  amphore=1;
  return(BS("In der Amphore kannst du einen kleinen Hebel entdecken.\n"));
}

hebel_schau()
{
  if (amphore==1) return(BS("Man koennte daran ziehen.\n"));
  else return 0;
}

ziehe_was(str)
{
  object o;
  notify_fail("Was willst Du ziehen?\n");
  if (!str) return 0;
  if ((str =="hebel" || str=="an hebel"))
    {
      if (amphore==1) {
        if(diamant==1) {
          TP->AddHp(-30);
          write(BS("Du ziehst an dem Hebel und eine Falltuer in der Decke oeffnet sich und ein Diamant und eine "
                   "Unmenge an Staub knallt Dir auf den Knopf und Du faellst zu Boden. Von der Falltuer ist "
                   "allerdings nichts mehr zu sehen.\n"));
          o = clone_object("/obj/gems/diamant");
          o->move(this_object(), M_PUT);
          diamant=0;
          return 1;
        } else {
          write(BS("Der Hebel scheint jetzt zu klemmen. Toll hast du das gemacht!"));
          return -1;
        }
      }
    }
  return 0;
}

rieche_was(str)
{
  notify_fail("Woran willst Du riechen?\n");
  if (!str) return 0;
  if ((str=="an schuhen" || str=="an schuh" || str=="schuh" || str=="schuhe"))
    {
      write(BS("Du steckst Deine Nase in einen der Schuhe und saugst die Luft "
	       +"durch die Nase ein. Der Geruch haut Dich glatt aus den Socken "
	       +"und du krachst unsanft auf den Boden.\n"));
      TP->AddHp(-15);
      return 1;
    }
  else return 0;
}



