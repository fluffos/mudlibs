#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Gemuesegarten");
  SetProp (P_INT_LONG, "Du befindest Dich hier im Gemuesegarten.\n"
	   +"Um Dich herum siehst Du einige Gemuesebeete in denen "
	   +"allerlei Gemuese angepflanzt wurde. Das meiste davon "
	   +"scheint jedoch noch nicht reif zu sein. Im Osten "
	   +"steht das grosse Soundmagierhaus dessen Waende "
	   +"silbern schimmern.\n"); 
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(("garten"),
	    "Der Garten ist ziemlich gross und ueberdies ausserordentlich "
	    +"gut gepflegt.\n");
  AddDetail(("boden"),
	    "Zwischen den einzelnen Beeten fuehrt ein kleiner Weg "
	    +"hindurch.");
  AddDetail(("weg"),
	    "Der kleine Weg besteht aus ungeformten flachen Steinen "
	    +"die einfach ueber das Gras gelegt wurden.\n");
  AddDetail(({"steine", "stein"}),
	    "Es sind grosse flache Steine die hier als einfacher "
	    +"Weg durch den Gemuesegarten aufgelegt wurden.\n");
  AddDetail(("gras"),
	    "Zwischen den Steinen siehst Du etwas gruenes Gras.\n");
  AddDetail(("himmel"),
	    "Die Sonne strahlt Dir hell aus dem strahlend blauen "
	    +"Himmel entgegen.\n");
  AddDetail(("sonne"),
	    "Sie strahlt Dir hell aus dem Himmel entgegen.\n");
  AddDetail(("osten"),
	    "Da steht das Soundmagierhaus.\n");
  AddDetail(({"haus", "soundmagierhaus"}),
	    "Das Soundmagierhaus, welches aussieht als wuerde es "
	    +"jeden Moment einstuerzen, hat eigenartig silbern "
	    +"schimmernde Waende.\n");
  AddDetail(("moment"),
	    "Dieser Moment scheint durch Magie verhindert zu "
	    +"werden.\n");
  AddDetail(("waende"),
	    "An den Waenden kannst Du ein eigenartiges silbernes "
	    +"Schimmern sehen. Es wird wahrscheinlich durch die "
	    +"hier wirksame Magie erzeugt.\n");
  AddDetail(("schimmern"),
	    "Ein eigenartiges silbernes Schimmern.\n"); 
  AddDetail(("magie"),
	    "Die kann man hier direkt fuehlen.\n");
  AddDetail(({"beete", "gemuesebeete", "beet", "gemuesebeet"}),
	    "In den Beeten hier, die alle sehr sorgfaeltig "
	    +"gepflegt zu sein scheinen, ist allerhand Gemuese "
	    +"angepflanzt worden.\n");
  AddDetail(("gemuese"),
	    "Du kannst hier etwas Kohlrabi, ein paar Kuerbisse "
	    +"und einige Kartoffeln sehen.\n");
  AddDetail(({"erde", "humus"}),
	    "In den Beeten scheint eine sehr naehrstoffreiche Erde (auch als Humus "
	    +"bekannt) zu sein.\n"); 
  AddDetail(("kohlrabi"),
	    "Du wuerdest Dir am liebsten gleich einen stibitzen und "
	    +"ihn dann genuesslich verspeisen. Leider scheint er noch "
	    +"nicht reif zu sein.\n");
  AddDetail(({"kuerbisse", "kuerbis"}),
	    "Obwohl die noch nicht reif sind, haben sie schon eine "
	    +"beachtliche Groesse.\n");
  AddDetail(("groesse"),
	    "Die Groesse der Kuerbisse ist jetzt schon ziemlich "
	    +"beachtlich.\n");
  AddDetail(({"kartoffeln", "kartoffel"}),
	    "Die meisten davon sind in der Erde vergraben. Die, "
	    +"die sichtbar sind, sind aber noch voellig unreif.\n");
  AddDetail(("erde"),
	    "In der fruchtbaren Erde wachsen einige Kartoffeln "
	    +"vor sich hin.\n");  
  AddDetail(("gemuesegarten"),
	    "Wie auch der gesamte Garten, ist der Gemuesegarten "
	    +"ausserordentlich gut gepflegt worden.\n");
  AddDetail(("gefuehl"),
	    "Ein Gefuehl, das Du gerne oefter haben wuerdest.\n");
  AddDetail(("freude"),
	    "Die war jetzt auf einmal unerklaerlich gross.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst nichts weltbewegendes hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht hier nach Gemuese.\n");
  AddSmell(({"kartoffeln", "kartoffel"}),
	   "Du riechst an ihnen nichts besonderes.\n");
  AddSmell(("kohlrabi"),
	   "Der riecht ja so, als waere er aeusserst essbar. MHhhh...\n");
  AddSmell(({"kuerbisse", "kuerbis"}),
	   "Die Kuerbisse riechen Dir etwas zu gesund.\n");
  // DETAILS END;
  
  
  // EXITS START;
  AddExit ("nordwesten", ROOM("garten10"));
  AddExit ("suedwesten", ROOM("garten13"));
  // EXITS END;
  
  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  
  // ITEMS START;
  // ITEMS END;
  
}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Du laesst die Magie ein bisschen auf Dich wirken "
	    +"und ein Gefuehl hoechester Freude durchzuckt Dich "
	    +"ploetzlich.\n"));
      return 1;
    }
  return 0;
}












