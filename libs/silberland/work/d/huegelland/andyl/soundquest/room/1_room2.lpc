#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

int kratzergef=0;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Der Ahnenraum");
  SetProp (P_INT_LONG, "Dieser Raum scheint eine Art Galerie zu sein. "
	   +"Viele Bilder mit Portraits von verschiedenen Soundmagiern "
	   +"haengen an der Wand. Vielleicht sind das Vorfahren des Hausbesitzers. "
	   +"Zwischen den Bildern haengen immer wieder Schilde mit verschiedenen "
	   +"Wappen darauf.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("art"),
	    "Hier ist eine Art Galerie.\n");
  AddDetail (({"raum", "ahnenraum", "galerie"}),
	     "Dieser Raum ist entweder eine Galerie oder ein Ahnenraum.\n");
  AddDetail (({"boden", "parkettboden"}),
	     "Es ist ein gut gepflegter Parkettboden.\n");
  AddDetail (("parkett"),
	     "Sieht sehr gepflegt aus.\n");
  AddDetail (({"waende","wand"}),
	     "Die Waende hier haben ein seltsames Muster.\n");
  AddDetail (({"muster"}),
	     "Ein seltsames Muster aus extrem viel Farben.\n");
  AddDetail (({"farbe", "farben"}),
	     "Viele bunte Farben. Sogar Deine Lieblingsfarbe ist dabei.\n");
  AddDetail (({"lieblingsfarbe"}),
	     "Deine Lieblingsfarbe ist in dem Muster gut vertreten.\n");
  AddDetail (("decke"),
	     "Die Decke ist mit einem Fresko verziert. Ausserdem haengt dort eine Lampe.\n");
  AddDetail (("fresko"),
	     "Das Fresko zeigt einen strahlenden blauen Himmel bei dem die Sonne hinter ein "
	     +"ein paar kleinen Woelkchen hervorschaut.\n");
  AddDetail (("himmel"),
	     "Der Himmel den das Fresko zeigt ist strahlend blau.\n");
  AddDetail (("wolken"),
	     "Es sind eher Woelkchen als Wolken.\n");
  AddDetail (("woelkchen"),
	     "Die sehen flauschig aus.\n");
  AddDetail (("sonne"),
	     "Eine hell leuchtende Sonne ist auf dem Fresko dargestellt.\n");
  AddDetail (("lampe"),
	     "Sie leuchtet den Raum hellblau aus.\n");
  AddDetail  (("portraits"),
	      "Es sind Portraits von Soundmagiern. Moeglicherweise Ahnen des Soundmagiers.\n");
  AddDetail (({"bilder", "ahnen", "vorfahren"}),
	     "Die Bilder zeigen wahrscheinlich die Vorfahren des Soundmagiers. Es sind alles "
	     "Gestalten in weiten dunklen Roben und alle halten seltsame Instrumente in den Haenden.\n");
  AddDetail (("gestalten"),
	     "Die Gestalten tragen weite dunkle Roben und alle halten seltsame Instrumente "
	     +"in den Haenden.\n");
  AddDetail (("roben"),
	     "Die Roben sind alle schoen mit seltsamen Zeichen verziert.\n");
  AddDetail (("zeichen"),
	     "Die sehen seltsam aus.\n");
  AddDetail (("instrumente"),
	     "Du kannst nicht ergruenden, um was fuer Instrumente es sich handelt.\n");
  AddDetail (("haende"),
	     "Du kannst nichts besonderes an den Haenden erkennen.\n");
  AddDetail (({"galerie", "sammlung"}),
	     "Die Galerie besteht aus einer Sammlung von Portraits.\n");
  AddDetail (("hausbesitzer"),
	     "Der Soundmagier, wer sonst.\n");
  AddDetail (({"soundmagier"}),
	     "Du glaubst, dass die Gestalten auf den Bildern alles Soundmagier sind oder waren.\n");
  AddDetail (("wappen"),
	     "Auf den Schilden sind verschiedene Wappen aufgemalt.\n");
  AddDetail (({"schilde", "schilde"}),
	     "Du siehst ein Rundschild, ein Quarzschild, ein Sternenschild und "
	     +"ein Blitzschild.\n");
  AddDetail (("rundschild"),
	     "Auf dem Rundschild ist das Wappen eines Ahornblattes aufgemalt.\n");
  AddDetail (("ahornblatt"),
	     "Ein gewoehnliches Ahornblatt ist auf den Rundschild aufgemalt.\n");
  AddDetail (("sternenschild"),
	     "Der Sternenschild traegt als Wappen eine Sternenkonstellation.\n");
  AddDetail (({"konstellation", "sternenkonstellation"}),
	     "Du kannst nicht sagen welche Sternenkonstellation das Wappen darstellt.\n");
  AddDetail (("blitzschild"),
	     "Der Blitzschild wird von einem Wappen aus lauter Blitzen geziert.\n");
  AddDetail (("blitze"),
	     "Die Blitze wirken irgendwie sehr geheimnisvoll.\n");
  AddDetail (("quarzschild"),
	     "Der Quarzschild ist komplett aus Quarz und voellig schwarz.\n");
  AddDetail (("quarz"),
	     "Der Quarz des Schildes ist fast vollstaendig glatt. Nur an einer Stelle "
	     "ist ein grosser Kratzer.\n");
  AddDetail(("stelle"),
	    "Da ist ein Kratzer.\n");
  AddDetail (("schild"),
	     "Welches Schild meinst du?\n");
  AddSpecialDetail (("kratzer"), "kratzerschau");
  AddSound( DEFAULT_SOUND,
	    "Hier herrscht absolute Stille.\n");
  AddSound(("stille"),
	   "Da hoert man ja wahnsinnig viel.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst hier nichts besonderes.\n");
  
  // DETAILS END;
  
  // EXITS START;
  AddExit ("nordosten", ROOM("1_room1"));
  AddExit ("suedosten", ROOM("1_room3"));
  AddExit ("westen", ROOM("1_room8"));
  AddExit ("suedwesten", ROOM("1_room9"));  
  // EXITS END;

  AddCmd(({"drehe", "dreh"}), "umdrehen");
  
  // ITEMS START;
  // ITEMS END;
  
}


kratzerschau()
{
  kratzergef=1;
  return (BS("Als Du den Kratzer naeher untersuchst glaubst Du "
	 +"etwas hinter dem Quarzschild zu erkennen.\n"
	 +"Vielleicht kannst Du es umdrehen?"));
}

umdrehen (str)
{
  object ob;
  notify_fail ("Was willst Du umdrehen ?\n");
  if (kratzergef == 0) return 0;
  else
    {
      if ((str == "schild um" || str == "schild"))
	{
	  write (BS("Welches Schild moechtest Du umdrehen?\n"));
	  return 1;
	}
      if ((str == "quarzschild um" || str == "quarzschild"))
	{
	  if (!ob=present(("\nsqbrecheisen"),TP))
	    { 
	      write (BS("Du drehst den Quarzschild um und findest dahinter ein Brecheisen. "
		    +"Du verstehst zwar nicht warum es dort ist steckst es aber trotzdem ein.\n"));
	      say (BS((this_player()->name(WER,2)+" dreht ein Schild um und scheint etwas dahinter "
		   +"gefunden zu haben.\n")));   
	      CLONE(OBJ("brecheisen"), (TP));
	      kratzergef=0;
	      return 1;
	    }
	  else return write (BS("Du drehst den Quarzschild um, findest aber nichts dahinter.\n")), 1;
	}
      else return 0;
    }
}








