#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";
int astunten=0;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du befindest Dich in einem Teil des riesigen "
	   +"Gartens. Vor Dir steht ein praechtiger Nussbaum, der hier "
	   +"so vor sich hin waechst. Westlich von Dir siehst Du den Zaun "
	   +"der den Garten umgibt und die Hecke die parallel dazu "
	   +"angepflanzt wurde. Im Suedwesten siehst Du einen Gemuesegarten "
	   +"und im Nordosten einen Schuppen. Im Suedosten befindet sich "
	   +"das grosse Soundmagierhaus dessen Waende in einem silbernen "
	   +"Schimmern erstrahlen.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("suedwesten"),
	    "Da ist ein Gemuesegarten.\n");
  AddDetail(("gemuesegarten"),
	    "Im Suedwesten siehst Du einen Gemuesegarten.\n");
  AddDetail(("nordosten"),
	    "Da steht ein Schuppen.\n");
  AddDetail(("schuppen"),
	    "Im Nordosten steht der Schuppen.\n");
  AddDetail(("suedosten"),
	    "Da ist das Soundmagierhaus.\n");
  AddDetail(("teil"),
	    "Du stehst hier in einem Teil das riesigen Gartens.\n");
  AddDetail(("boden"),
	    "Da ist ein penibel gepflegter Rasen.\n");
  AddDetail(("rasen"),
	    "Der scheint sehr, sehr sorgfaeltig gepflegt worden zu sein. "
	    +"Nicht ein Blatt liegt auf dem Rasen.\n");
  AddDetail(("garten"),
	    "Du stehst darin. Schau Dich doch einfach ein wenig um.\n");
  AddDetail(("blatt"),
	    "Nicht ein Blatt von dem Nussbaum liegt auf dem Rasen.\n");
  AddDetail(("himmel"),
	    "Nicht eine Wolke ist auf dem strahlend blauen Himmel zu "
	    +"sehen. Allein die Sonne lacht Dir aus ihm entgegen.\n");
  AddDetail(({"zaun", "holzzaun"}),
	    "Ein einfacher weisser Holzzaun.\n");
  AddDetail(("wolke"),
	    "Am Himmel ist nicht eine einzige zu sehen.\n");
  AddDetail(("sonne"),
	    "Ihre Strahlen scheinen Dir angenehm auf die Haut.\n");
  AddDetail(("strahlen"),
	    "Die sind aeusserst angenehm.\n");
  AddDetail(("haut"),
	    "Die koennte noch etwas Sonne vertragen.\n");
  AddDetail(("hecke"),
	    "Die Hecke sticht durch ihre silbernen Blaetter hervor.\n");
  AddDetail(("blaetter"),
	    "Die Blaetter sind voellig silbern. Ob die wohl auf natuerliche "
	    +"Weise entstanden sind?\n");
  AddDetail(("weise"),
	    "Du fragst Dich ob diese Blaetter auf natuerliche Weise "
	    +"entstanden sind.\n");
  AddDetail(({"haus", "soundmagierhaus", "sicherheit"}),
	    "Das Haus wuerde wahrscheinlich ohne Einwirkung "
	    +"von Magie in sich zusammenstuerzen. Die Bauweise "
	    +"von dem Haus entspricht in keinster Weise der Norm. "
	    +"Ohne diese Magie waere von dem Haus mit ziemlicher "
	    +"Sicherheit nur noch ein Schutthaufen ueber.\n");
  AddDetail(("einwirkung"),
	    "Es wirkt eine starke Magie auf das Haus.\n");
  AddDetail(("norm"),
	    "Die Bauweise von jedem Haus weicht von der Norm etwas "
	    +"ab.\n");
  AddDetail(("bauweise"),
	    "Die ist etwas ungewoehnlich.\n");
  AddDetail(("schutthaufen"),
	    "Also derzeit sieht das Haus nicht so aus, als wuerde es "
	    +"in naechster Zeit einer werden.\n");
  AddDetail(("zeit"),
	    "Also fuer die naechste Zeit duerfte das Haus noch fest "
	    +"hier stehenbleiben.\n");
  AddDetail(("magie"),
	    "Man kann sie als Schimmern an den Waenden des Hauses "
	    +"erkennen. So intensiv wie die hier ist, kann man sie "
	    +"ja schon fuehlen.\n");
  AddDetail(({"waende", "waenden"}),
	    "An den Waenden ist ein silbernes Schimmern zu erkennen.\n");
  AddDetail(("schimmern"),
	    "Das silberne Schimmern wird wahrscheinlich durch die Magie "
	    +"hervorgerufen die hier wirksam ist.\n");
  AddDetail(({"nussbaum", "baum"}),
	    "Der Nussbaum scheint von den Wurzeln ueber den Stamm "
	    +"bis hin zur Baumkrone in hervorragender Verfassung zu "
	    +"sein.\n");
  AddDetail(("verfassung"),
	    "Die Verfassung des Nussbaumes scheint hervorragend zu sein.\n");
  AddDetail(("wurzeln"),
	    "Die sehen kraeftig und gesund aus.\n");
  AddDetail(("stamm"),
	    "Der praechtige Stamm des Nussbaumes ragt kerzengerade "
	    +"nach oben.\n"); 
  AddDetail(({"krone", "baumkrone"}),
	    "Die Baumkrone leuchtet Dir in einem saftigem Gruen entgegen. "
	    +"Ein kraeftiges Geaest kannst Du von hier unten erkennen.\n");
  AddDetail(("gruen"),
	    "Ein sehr saftiges Gruen.\n");
  AddDetail(({"geaest"}),
	    "Da oben siehst Du viele starke Aeste, von denen Dir einer "
	    +"besonders auffaellt.\n");
  AddDetail(("aeste"),
	    "Da oben sind viele starke Aeste.\n");
  AddSpecialDetail(("ast"), "ast_schau");
  AddDetail(({"nuss", "walnuss", "walnuesse"}),
	    "Eine Walnuss haengt an dem Ast. Die kannst Du "
	    +"sicher irgendwie pfluecken.\n");
  AddDetail(("energiefluss"),
	    "Der macht Dich ganz schoen kribbelig.\n");
  AddDetail(("moment"),
	    "Gut das dieser Moment nicht vorher gekommen ist.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein Rascheln aus der Baumkrone.\n");
  AddSound(("rascheln"),
	   "Du kannst nicht bestimmen, von wem oder was es erzeugt wird.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht hier nach frischen Walnuessen.\n");

  // DETAILS END;
  
  // EXITS START;
  AddExit ("osten", ROOM("garten8"));
  AddExit ("suedwesten", ROOM("garten10"));
  // EXITS END;
  
  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  AddCmd(({"pfluecke", "pflueck"}), "pfluecke_was");
  AddCmd(({"ziehe", "zieh"}), "zieh_runter");
  
  // ITEMS START;
  // ITEMS END;
  
}

ast_schau()
{
  if (astunten==0)
    {
      return (BS("An dem Ast haengt eine Walnuss. Vielleicht kannst Du "
	     +"die irgendwie pfluecken.\n"));
    }
  else 
    {
      return (BS("An den Ast wurde ein Seil gebunden, dann damit "
	     +"heruntergezogen und schlussendlich wurde das Seil an den "
	     +"Nussbaum befestigt. Auf dem Ast ist eine Walnuss die "
	     +"du jetzt sicher leicht pfluecken kannst.\n")); 
    }
}

zieh_runter(str)
{
  object ob;
  notify_fail("Was willst Du womit herunterziehen?\n");
  if ((str == "ast herunter" || str == "ast runter"))
    {
      write (BS("Dazu wirst Du schon ein Hilfsmittel brauchen!\n"));
      return 1;
    }
  if ((str == "ast mit seil herunter" || str == "ast mit seil runter"))
    {
      if (astunten==1)
	{
	  write (BS("Aber der Ast ist doch schon unten.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("seil"),TP))
	    {
	      write (BS("Aber Du hast doch gar kein Seil.\n"));
	      return 1;
	    }
	  else
	    {
	      write (BS("Du ziehst den Ast mit dem Seil herunter und befestigst "
		    +"das Seil an den Baum damit der Ast nicht mehr "
		    +"nach oben schnellen kann.\n"));
	      say (BS(this_player()->name(WER,2)+" zieht einen Ast des Baumes mit "
		   +"einem Seil herunter.\n"));
	      ob->remove();	
	      astunten=1;
	      return 1;
	    }
	}
    }
  else return 0;
}

pfluecke_was(str)
{     
  object ob;
  notify_fail("Was willst Du pfluecken?\n");
  if ((str == "walnuss" || str == "nuss")) 
    {
      if (astunten==0)
	{
	  write (BS("Du kommst da nicht ran. Vielleicht solltest Du "
		+"zuerst den Ast irgendwie herunterziehen.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("\nsqquestitem"),TP))
	    {
	      write(BS("Du benoetigst derzeit keine Walnuss. Probier "
		    +"es vielleicht spaeter noch einmal.\n"));
	      return 1;
	    }
	  else
	    {
	      if (!ob=present(("\nsqwalnuss"),TP))
		{
		  write (BS("Du pflueckst die Walnuss und steckst sie ein. "
			+"In demselben Moment reisst das Seil und der "
			+"Ast schnellt wieder nach oben.\n"));
		  say (BS(this_player()->name(WER,2)+" pflueckt eine "
		       +"Walnuss von einem Ast.\n"));
		  CLONE(OBJ("walnuss"),(TP));
		  astunten=0;
		  return 1;
		}
	      else 
		{
		  write (BS("Aber Du hast doch schon eine Walnuss!\n"));
		}		  
	    }
	}
    }
  else return 0;
}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Du fuehlst einen starken Energiefluss durch "
	    +"dich hindurchstroemen. Das kribbelt aber ordentlich.\n"));
      return 1;
    }
  else return 0;
}

reset()
{
  astunten=0;
}












