#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du stehst in einem Teil des riesigen Gartens.\n"
	   +"Vor Dir steht eine ueberaus grosse Linde, welche hier stolz "
	   +"weiter waechst und ihre Wurzeln noch tiefer in den Boden "
	   +"zu verankern sucht. "
	   +"Suedwestlich von Dir steht das Soundmagierhaus und suedoestlich "
	   +"bzw. oestlich verlaeuft der Zaun, der den Garten umschliesst. "
	   +"Parallel zu dem Zaun wurde ausserdem eine silberne Hecke "
	   +"angepflanzt.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("teil"),
	    "Hier ist ein Teil von dem grossen Garten.\n");
  AddDetail(("boden"),
	    "Du stehst auf einem traumhaft gepflegten Rasen.\n");
  AddDetail(("garten"),
	    "Der Garten ist sehr schoen und auch ziemlich gross. "
	    +"Am besten Du durchforstest ihn einmal gruendlich.\n");
  AddDetail(("himmel"),
	    "Wolken kannst Du an ihm nicht entdecken. Nur die Sonne "
	    +"strahlt aus dem strahlenden Blau hervor.\n");
  AddDetail(("blau"),
	    "Ein schoenes helles Blau.\n");
  AddDetail(("wolken"),
	    "Keine zu sehen.\n");
  AddDetail(("sonne"),
	    "Sie strahlt Dir mit einer sehr angenehmen Waerme auf "
	    +"die Haut.\n");
  AddDetail(("waerme"),
	    "Die ist gerade so richtig angenehm.\n");
  AddDetail(("haut"),
	    "Sie hat genau die richtige Farbe.\n");
  AddDetail(("farbe"),
	    "Die ist genauso, wie sie sein soll.\n");
  AddDetail(("rasen"),
	    "Der sieht wirklich traumhaft aus. Seltsamerweise liegt kein "
	    +"Laub auf ihm.\n");
  AddDetail(("laub"),
	    "Komischerweise liegt keines auf dem Rasen.\n");
  AddDetail(({"haus", "soundmagierhaus"}),
	    "Die Bauweise von dem Soundmagierhaus ist etwas gewagt. "
	    +"Die Naturgesetze wuerden bei so einer Konstruktion "
	    +"gewoehnlich sagen:\n"
	    +"'Brich in Dich zusammen!'\n"
	    +"Sowas duerften aber die Kraefte der Magie die sogar "
	    +"an den Waenden von dem Haus sichtbar sind verhindern.\n");
  AddDetail(("bauweise"),
	    "Du musst zugeben, dass dies eine hoechst interessante Bauweise "
	    +"ist.\n");
  AddDetail(("konstruktion"),
	    "Die ist nicht unbedingt alltaeglich.\n");
  AddDetail(("kraefte"),
	    "Magie kann gewaltige Kraefte entwickeln.\n");
  AddDetail(("magie"),
	    "Man kann sie hier direkt schon fuehlen.\n");
  AddDetail(({"naturgesetze", "gesetze"}),
	    "Die Naturgesetze scheinen hier nicht zu gelten.\n");
  AddDetail(({"waende", "wanden"}),
	    "An den Waenden ist Magie als silbernes Schimmern "
	    +"wahrzunehmen.\n");
  AddDetail(("schimmern"),
	    "Ein intensives silbernes Schimmern.\n");
  AddDetail(({"zaun", "holzzaun"}),
	    "Ein einfacher weisser Holzzaun.\n");
  AddDetail(("hecke"),
	    "Die Hecke hier hat voellig silberne Blaetter.\n");
  AddDetail(("blaetter"),
	    "Die Blaetter der Hecke sind voellig silbern.\n");
  AddDetail(("wurzeln"),
	    "Die haben sich tief in den Boden verankert.\n");
  AddDetail(({"linde", "baum"}),
	    "Alles an der Linde sieht perfekt geformt aus. Das reicht "
	    +"von den Wurzeln ueber den Stamm bis zur Baumkrone.\n");
  AddDetail(("stamm"),
	    "Das Holz von dem Stamm sieht ueberaus kraeftig "
	    +"und gesund aus.\n");
  AddDetail(({"holz", "lindenholz"}),
	    "Das Holz einer Linde ist?\n"
	    +"Richtig! Lindenholz.\n");
  AddDetail(({"baumkrone","krone"}),
	    "Die Baumkrone sieht praechtig aus. Die Lindenblaetter "
	    +"erstrahlen in einem saftigen Gruen und die Aeste sehen "
	    +"stark und kraftig aus.\n");
  AddDetail(("gruen"),
	    "Gruen ist eine Farbe (fuer alle die das noch nicht wissen).\n");
  AddDetail(("lindenblaetter"),
	    "Die sind schoen gruen.\n");
  AddDetail(("aeste"),
	    "Die sehen stark und kraeftig aus. An einem Ast kannst Du "
	    +"etwas besonderes erkennen.\n");
  AddDetail(("ast"),
	    "Auf dem Ast ist ein Vogelnest.\n");
  AddDetail(({"nest", "vogelnest"}),
	    "In dem Vogelnest piepsen ein paar kleine Kueken "
	    +"hungrig herum.\n");
  AddDetail(({"kueken", "kuecken"}),
	    "Es duerfte sich bei den Kueken um die eines "
	    +"Rotkehlchens handeln.\n");
  AddDetail(("rotkehlchen"),
	    "Wenn Du etwas wartest siehst Du hier sicher mal eines.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein gieriges Piepsen.\n");
  AddSound(("piepsen"),
	   "Das Piepsen kommt aus dem Baum.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du kannst nichts besonderes riechen.\n");
  // DETAILS END;
  
  // EXITS START;
  AddExit ("norden", ROOM("garten5"));
  AddExit ("suedosten", ROOM("garten2"));
  AddExit ("sueden", ROOM("garten3"));
  AddExit ("nordwesten",ROOM("garten6"));
  // EXITS END;
  
  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  
  // ITEMS START;
  AddItem(NPC("rotkehlchen.lpc"), REFRESH_DESTRUCT);
  // ITEMS END;

}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Die Magie fuehlt sich stark an. Sogar sehr stark. "
	    +"In ihr scheinen gewaltige Kraefte zu stecken.\n"));
      return 1;
    }
  else return 0;
}














