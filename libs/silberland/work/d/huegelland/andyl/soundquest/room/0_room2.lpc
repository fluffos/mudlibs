#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Eine Garderobe");
  SetProp (P_INT_LONG, "Dieser Raum scheint eine Garderobe zu sein.\n"
	   +"An der Wand sind mehrere Haken an die man irgendwelche Kleidungsstuecke "
	   +"aufhaengen koennte. Weiters siehst Du einen kleinen Kasten in dem mehrere "
	   +"Faecher sind und eine kleine Skulptur.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(({"raum", "garderobe"}),
	    "Dieser Raum scheint als Garderobe zu dienen.\n");
  AddDetail(("haken"),
	    "Das sind Haken an denen man Kleidungsstuecke aufhaengen kann.\n");  
  AddDetail(({"kleidung", "kleidungsstuecke"}),
	    "Derzeit siehst Du hier keine.\n");
  AddDetail(({"kasten", "holzkasten"}),
	    "Ein einfacher Holzkasten in dem einige Faecher sind.\n");
  AddDetail(({"faecher", "fach", "lagern"}),
	    "Die Faecher duerften dem Lagern von Schuhen dienen.\n");
  AddDetail(("schuhe"),
	    "Auf den Faechern sind keine. Du musst also mit Deinen "
	    +"eigenen vorlieb nehmen.\n");
  AddDetail(("vorlieb"),
	    "Ist doch selbsterklaerend, oder?\n");
  AddDetail(({"boden", "holzboden"}),
	    "Ein solider Holzboden aus Buchenholz.\n");
  AddDetail(({"buchenholz", "holz"}),
	    "Es gefaellt Dir ziemlich gut.\n");
  AddDetail(("waende"),
	    "Die Waende sind aus Stein und weiss gestrichen. An einer Wand "
	    +"haengt eine kleine Lampe und ein paar Haken.\n");
  AddDetail(("skulptur"),
	    "Die Skulptur ist aus Marmor und stellt ein Einhorn dar.\n");
  AddDetail(("marmor"),
	    "Ein vollig weisser, reiner und edler Marmor.\n");
  AddDetail(("einhorn"),
	    "Das Einhorn hat eine schoene weisse Maehne, ruhige kuehle "
	    +"Augen und ein glaenzend weisses Horn.\n");
  AddDetail(("maehne"),
	    "Die Maehne des Einhorns ist schoen weiss.\n");
  AddDetail(("augen"),
	    "Die Augen des Einhorns vermitteln eine ruhige, kuehle und "
	    "dennoch ueberaus angenehme Ausstrahlung.\n");
  AddDetail(({"ausstrahlung", "besonderes"}),
	    "Die Ausstrahlung die von der Skulptur des Einhorns ausgeht "
	    +"hat irgendetwas Besonderes an sich.\n");
  AddDetail(("horn"),
	    "Das Horn ragt koeniglich von der Stirn des Einhorns.\n");
  AddDetail(("stirn"),
	    "Als Du die Stirn des Einhorns untersuchst, merkst du, dass "
	    +"das Horn irgendwie locker zu sein scheint. Vielleicht kann "
	    +"man ja daran ziehen.\n");
  AddDetail(("wand"),
	    "Da haengt eine kleine Lampe.\n");
  AddDetail(("lampe"),
	    "Sie spendet etwas Licht.\n");
  AddDetail(("licht"),
	    "Es ist leicht gruenlich.\n");
  AddDetail(({"stein", "frage"}),
	    "Stein oder nicht Stein? Das ist hier keine Frage.\n");
  AddDetail(("decke"),
	    "Sie ist aus Stein und hat einen weissen Anstrich.\n");
  AddDetail(({"anstrich", "farbe"}),
	    "Der Anstrich hat eine weisse Farbe.\n");
  AddDetail(({"illusion"}),
	    "Die Haken sind tatsaechlich nur eine Illusion. Du fragst Dich "
	    +"wozu das wohl gut sein soll.\n");
  AddSound( DEFAULT_SOUND,
	    "Nichts zu hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts besonderes.\n");
  // DETAILS END;
  
  // EXITS START;
  AddExit ("norden", ROOM("0_room3"));
  AddExit ("suedosten", ROOM("0_room1"));
  AddExit ("sueden", ROOM("0_room11"));
  // EXITS END;

  AddCmd(({"zieh", "ziehe"}), "ziehe_was");
  AddCmd(({"haenge", "haeng"}), "haenge_was");
  // ITEMS START;
  // ITEMS END;

  previous_object()->CustomizeObject(); 
}

haenge_was(str)
{
  object ob;
  string str1, str2;
  notify_fail("Was willst Du wo aufhaengen?\n");
  if (!str) return 0;
  sscanf(str, "%s %s haken", str1, str2);
  if ((str2 == "auf" || str2 == "an" || str2 == "ueber"))
    {
      
      if (!ob=present((str1),TP))
	{
	  write(BS("Sowas hast Du ja gar nicht!\n"));
	  return 1;
	}
      else
	{
	  write (BS("Du versuchst "+ob->name(WER,1)+" auf einen Haken zu "
		    +"haengen, aber "+ob->name(WER,1)+" faellt dabei einfach "
		    +"zu Boden. Als Du dies genauer untersuchst, stellst Du fest, "
		    +"dass die Haken nur eine Illusion sind.\n"));
	  return 1;
	}
    }
  else return 0;
}

ziehe_was(str)
{
  notify_fail("An was willst Du ziehen?\n");
  if ((str == "horn" || str == "an horn"))
    {
      say (BS(this_player()->name(WER,2)+" fingert irgendwo an der "
	      +"Skulptur herum und verschwindet ploetzlich.\n"));
      write (BS("Auf einmal dreht sich der Kopf des Einhorns zu Dir. "
		+"Es schaut Dich an und auf einmal blitzen seine Augen "
		+"in einem hellen Gelb auf. Der Boden unter Dir oeffnet sich "
		+"ploetzlich und Du faellst in einen Tunnel unter Dir "
		+"der aus reinem Licht zu bestehen scheint.\n"));
      write("\n");
      TP->move(ROOM("dummy"), M_GO|M_SILENT|M_NO_SHOW);
      call_out(("seq1"), 10);
      return 1;
    }
  else return 0;
}

void seq1()
{
  write(BS("Einige Zeitlang schwebst Du in dem Tunnel herum und hast vollkommen "
	+"die Orientierung verloren. Du hast keine Ahnung wo Du Dich jetzt "
	+"befindest.\n"));
  write("\n");
  call_out(("seq2"), 10);
}


void seq2()
{
  write(BS("Ploetzlich siehst Du vor Dir eine Art Tor und Du bleibst abrupt "
	+"stehen.\n"));
  write("\n");
  call_out(("seq3"), 10);
}

void seq3()
{
  write (BS("Eine Geistergestalt erscheint vor Dir und mustert Dich von oben "
	+"bis unten.\n"));
  write("\n");
  call_out(("seq4"), 10);
}

void seq4()
{
  write (BS("Ploetzlich hoerst Du eine Stimme: 'Diesen Weg darfst Du nicht "
	+"weiter beschreiten! Nur wenige duerfen diesen Weg betreten. "
	+"Du bist jedoch keiner davon. Die Geheimnisse die Du hier "
	+"vorfinden wuerdest sind nicht fuer Deine Augen oder Ohren bestimmt.'\n"));
  write("\n");
  call_out(("seq5"), 13);
}

void seq5()
{
  write (BS("Mit einem Knall verschwindet alles rings um Dich und "
	+"Dir wird leicht schwindlig.\n"));
  write ("\n");
  call_out(("seq6"), 10);
}

void seq6()
{
  write (BS("Mit einem mal stehst Du wieder in dem Soundmagierhaus und "
	+"alles ist so als haette sich nie irgendetwas ereignet. "
	+"Das Einhorn ist eine Skulptur wie vorher und auch von "
	+"der Oeffnung im Boden ist nichts mehr zu sehen.\n\n"));
  write("\n");
  TP->move(ROOM("0_room2"), M_TPORT|M_SILENT);
  call_out(("seq7"), 13);
}

void seq7()
{
  write (BS("Du denkst . o O (War das alles nur eine Illusion oder ein Traum?)\n"));
}  





















