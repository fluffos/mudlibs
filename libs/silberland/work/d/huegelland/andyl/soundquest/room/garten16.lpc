#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";
#define NETZ(wer) (member(netz, getuid(wer))!=-1)
string *netz=({});

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du stehst in einem Teil des riesigen Garten.\n"
	   +"Vor Dir steht eine praechtige Eiche, die hier schon seit "
	   +"langer Zeit stehen muss. Suedlich und suedwestlich von hier "
	   +"verlaeuft noch der Zaun und die Hecke die den Garten umgeben. "
	   +"Und im Norden siehst Du noch das grosse Soundmagierhaus.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("teil"),
	    "Du befindest Dich in einem Teil des riesigen Garten.\n");
  AddDetail(("boden"),
	    "Da ist ein traumhaft gepflegter Rasen.\n");
  AddDetail(("rasen"),
	    "Der wurde traumhaft gepflegt. Es ist irgendwie merkwuerdig, dass "
	    +"ueberhaupt kein Laub auf ihm liegt.\n");
  AddDetail(("laub"),
	    "Komischerweise liegt keines auf dem Rasen.\n");
  AddDetail(("himmel"),
	    "Der Himmel ist strahlend blau und die Sonne scheint Dir froehlich "
	    +"aus ihm entgegen.\n");
  AddDetail(("sonne"),
	    "Sie scheint Dir angenehm auf den Koerper.\n");
  AddDetail(("koerper"),
	    "Hast Du nicht einen schoenen Koerper?\n");
  AddDetail(("hecke"),
	    "Die Hecke hat silberne Blaetter.\n");
  AddDetail(("Blaetter"),
	    "Die sind silbern.\n");
  AddDetail(({"zaun", "holzzaun"}),
	    "Ein einfacher weisser Holzzaun.\n");
  AddDetail(("zeit"),
	    "Die Zeit die vergangen ist nachdem die Eiche gepflanzt wurde "
	    +"muss ganz schon viel gewesen sein.\n");
  AddDetail(("norden"),
	    "Da steht ein Haus.\n");
  AddDetail(({"haus", "soundmagierhaus"}),
	    "So wie das aussieht muesste es sofort einstuerzen. Das scheint "
	    +"jedoch Magie zu verhindern.\n");
  AddDetail(("magie"),
	    "Du kannst sie hier direkt fuehlen.\n");
  AddDetail(("garten"),
	    "Der ist ziemlich gross.\n");
  AddDetail(({"eiche", "baum"}),
	    "Sie sieht sehr kraeftig aus und scheint sehr alt zu sein. "
	    +"Von der Baumkrone ueber den Stamm bis zu den Wurzeln ist "
	    +"sie fast schon bilderbuchmaessig schoen geformt.\n");
  AddDetail(("stamm"),
	    "Das Holz scheint ueberaus kraeftig und stabil zu sein.\n");
  AddDetail(({"holz", "eichenholz"}),
	    "Das Eichenholz ist wirklich ein besonders robustes Holz.\n"); 
  AddDetail(({"krone", "baumkrone"}),
	    "Die Baumkrone erstrahlt im Sonnenschein in einem satten Gruen.\n");
  AddDetail(({"sonnenschein", "geltung"}),
	    "Der Sonnenschein kommt hier irgendwie besonders gut zur Geltung.\n");
  AddDetail(("gruen"),
	    "Siehst Du etwa was anderes?\n");
  AddDetail(({"wurzeln", "wurzel"}),
	    "Die haben sich ordentlich im Boden verankert. So schnell bekommt die "
	    +"keiner heraus. An einer bestimmten Stelle kommt es Dir vor, als wuerde da "
	    +"etwas nicht stimmen.\n");
  AddDetail(({"stelle"}),
	    "Da ist ein kaum sichtbarer gruener Faden.\n");
  AddDetail(("faden"),
	    "Ein dunkelgruener Faden. Wozu der wohl hier herumliegt?\n"
	    +"Vielleicht kann man ja an ihm ziehen.\n");
  AddSpecialDetail(("netz"), "netzschau");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein leises Knacksen.\n");
  AddSound(("knacksen"),
	   "Jetzt hoerst Du es auf einmal nicht mehr.\n"); 
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts besonderes.\n");

  // DETAILS END;
  
  // EXITS START;
  AddSpecialExit(("osten"), "nachosten");
  AddSpecialExit(("norden"), "nachnorden");
  AddSpecialExit(("nordwesten"), "nachnordwesten");
  // EXITS END;
  
  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  AddCmd(({"ziehe", "zieh"}), "ziehe_was");
  
  // ITEMS START;
  // ITEMS END;

}
netzschau()
{
  if ( NETZ(TP))
    return (BS("Du haengst in dem bloeden Netz fest.\n"));
}

int nachosten()
{
  if( NETZ(TP))
    {
      say (BS(this_player()->name(WER,2)+" versucht vergeblich sich aus dem "
	   +"Netz zu befreien.\n"));
      return notify_fail ("Aber Du haengst doch noch im Netz fest!\n"), 0;
    }
  TP->move(ROOM("garten17"), M_GO, "nach Osten");
  return 1;
}

int nachnorden()
{
  if( NETZ(TP))
    {
      say (BS(this_player()->name(WER,2)+" versucht vergeblich sich aus dem "
	   +"Netz zu befreien.\n"));
      return notify_fail ("Aber Du haengst doch noch im Netz fest!\n"), 0;
    }
  TP->move(ROOM("garten15"), M_GO, "nach Norden");
  return 1;
}

int nachnordwesten()
{
  if( NETZ(TP))
    {
      say (BS(this_player()->name(WER,2)+" versucht vergeblich sich aus dem "
	   +"Netz zu befreien.\n"));  
      return notify_fail ("Aber Du haengst doch noch im Netz fest!\n"), 0;
    }
  TP->move(ROOM("garten14"), M_GO, "nach Nordwesten");
  return 1;
}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Die Magie fuellt sich angenehm weich an.\n"));
      return 1;
    }
  else return 0;
}


ziehe_was(str)
{
  object ob;
  notify_fail("Woran willst Du ziehen?\n");
  if ((str == "an faden"|| str == "faden"))
    {
      if (!ob=present(("\nsqquestitem"),TP))
	{
	  write (BS("Das solltest Du vielleicht erst spaeter machen.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("\nsqnetz"),TP))
	    {
	      call_out(("netz_fall"), 0);
	      return 1;
	    }
	  else 
	    {
	      write (BS("Du hast keine Lust das noch einmal zu machen.\n"));
	      return 1;
	    }
	}
    }
  else return 0;
}

void netz_fall()
{
  write (BS("Als Du ein wenig "
	+"an dem Faden ziehst hoerst Du ein leises *KLICK*.\n"
	+"Auf einmal faellt ein Netz von oben auf Dich herunter "
	+"und Du strampelst jetzt ungeschickt darin herum.\n"));
  say (BS(this_player()->name(WER,2)+" wird von einem herabfallenden "
       +"Netz eingefangen und zappelt jetzt ungeschickt darin herum.\n"));
  netz += ({ getuid(TP) });
  call_out(("imnetz1"), 6);
}

void imnetz1()
{
  write(BS("Du arbeitest kraeftig an Deiner Befreiung.\n"));
  say(BS(TPN+" versucht sich krampfhaft aus dem Netz zu befreien.\n"));
  call_out(("imnetz2"), 6);
}

void imnetz2()
{
  write(BS("Bald muesstest Du Dich aus dem Netz befreit haben.\n"));
  say(BS(TPN+" scheint sich allmaehlich aus dem Netz befreien zu koennen.\n"));
  call_out(("aus_netz"), 6);
}

void aus_netz()
{
  write (BS("Nach einiger Zeit schaffst Du es Dich aus dem Netz zu befreien und " 
	+"steckst das Netz (das man ja vielleicht brauchen kann) ein.\n")); 
  CLONE(OBJ("netz"),(TP));
  netz -= ({ getuid(TP) });
  say (BS((this_player()->name(WER,2))+" hat es jetzt endlich geschafft sich wieder aus dem "
      +"Netz zu befreien.\n"));
}

PlayerQuit(object ob)
{
  if (NETZ(ob))
    netz -= ({ getuid(ob) });
}
 






