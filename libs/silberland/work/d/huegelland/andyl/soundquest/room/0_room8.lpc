/*
** Badezimmer im Erdgeschoss im Haus des Soundmagiers (Raum 8) 
**
** Progged by AnDyL
**
** 1998-01-13
** 
** Last updated: 2004-10-25
*/

#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

int wasser=1;
int kaestchen=0;
int flasche_gefunden=0;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Ein Badezimmer");
  SetProp (P_INT_LONG, "Du befindest Dich hier im Badezimmer.\n"
	   +"In der Mitte des Raumes steht eine grosse Badewanne in "
	   +"der warmes Wasser brodelt. An der Wand haengt ein grosser "
	   +"Spiegel, in dem Du Dein Spiegelbild erkennen kannst. "
	   +"Ausserdem siehst Du ein Kaestchen in einem Eck stehen.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(({"raum", "zimmer", "badezimmer"}),
	    "Dieser Raum ist das Badezimmer im Haus.\n");
  AddDetail(("mitte"),
	    "In der Mitte des Raumes steht eine grosse Badewanne.\n");
  AddDetail(("haus"),
	    "Du befindest Dich im Haus des Soundmagiers.\n");
  AddDetail(("soundmagier"),
	    "Der scheint gerade nicht im Haus zu sein.\n");
  AddDetail(("boden"),
	    "Der Boden ist aus feinstem Marmor. Er strahlt und funkelt "
	    +"an allen Ecken und Enden.\n");
  AddDetail(({"ecken", "enden"}),
	    "Die strahlen und funkeln nur so.\n");
  AddDetail(("marmor"),
	    "Er ist vollkommen glatt. Es scheint sich dabei um eine sehr "
	    "besondere Art von Marmor zu handeln.\n"); 
  AddDetail(("art"),
	    "Die Art des Marmors duerfte etwas sehr besonderes sein.\n");
  AddDetail(("decke"),
	    "Sie ist komplett aus Marmor. Ausserdem haengt da ein Smaragd.\n");
  AddDetail(("smaragd"),
	    "Der Smaragd sendet ein gruenliches Licht aus welches den Raum "
	    +"vollstaendig ausleuchtet.\n");
  AddDetail(("licht"),
	    "Das Licht ist leicht gruenlich und wird von dem Smaragd "
	    +"ausgestrahlt.\n");
  AddDetail(("wand"),
	    "Da haengt ein Spiegel.\n");
  AddDetail(("waende"),
	    "Die sind komplett aus Marmor.\n");
  AddDetail(("spiegel"),
	    "Du kannst Dein Spiegelbild darin erkennen.\n");
  AddDetail(({"spiegelbild", "bild"}),
	    "Du wirfst einen Blick auf Dein Spiegelbild und stellst fest, "
	    +"dass Du ungeheuer gut aussiehst (als wenn Du das vorher nicht "
	    +"gewusst haettest).\n");
  AddDetail(({"blick", "blicke"}),
	    "Waah, wirf die Blicke doch nicht so fest.\n"); 
  AddDetail(({"wanne", "badewanne"}),
	    "Die Badewanne ist komplett aus Marmor. In ihr brodelt warmes "
	    "Wasser, welches ueberaus gut riecht.\n");
  AddDetail(("wasser"),
	    "Es sieht irgendwie wohltuend aus und riecht ausserdem ziemlich gut.\n");
  AddSmell(("wasser"),
	   "Das Wasser verbreitet einen ueberaus guten Duft. Es laedt so "
	   +"richtig zum darin baden ein.\n");
  AddDetail(("duft"),
	    "Du kannst ihn riechen.\n");
  AddSmell(("duft"),
	   "Er riecht extrem gut. Was das wohl ist?\n");
  AddDetail(("eck"),
	    "Da steht ein Kaestchen.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst nichts besonderes.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst den Duft den das Wasser verstroemt.\n");
  AddSpecialDetail(("kaestchen"), "kaestchen_schau");
  AddSpecialDetail(({"oele", "duftoele"}),"oel_schau");
  AddSpecialDetail(({"reinigungsmittel", "mittel"}), "mittel_schau");
  AddSpecialDetail(("flaeschchen"), "flaeschchen_schau");
  AddSpecialDetail(("flasche"), "flasche_schau");
  // DETAILS END;
  
  // EXITS START;
  AddExit ("westen", ROOM("0_room7"));
  AddExit ("suedosten", ROOM("0_room9"));
  // EXITS END;
  
  AddCmd(({"bade", "bad"}),"bade_in");
  AddCmd(("oeffne"), "oeffne_was");  
  
  // ITEMS START;
  // ITEMS END;

}

reset()
{
  wasser=1;
  kaestchen=0;
  flasche_gefunden=0;
}

bade_in (str)
{
  notify_fail("Worin willst Du baden?\n");
  if (str == "in wasser" || str == "in badewanne" || str == "in wanne")
    {
      if (wasser == 1)
	{
	  write (BS("Du nimmst ein erfrischendes Bad in der Badewanne.\n"
		+"Irgendwie fuehlst Du Dich jetzt gestaerkt.\n"));
	  say (BS(TP->name(WER,2)+" nimmt ein erfrischendes Bad in der Badewanne "
	      +"und sieht jetzt gestaerkt aus.\n"));
	  TP->heal_self(50);
	  wasser=0;
	  return 1;
	}
      else
	{
	  write (BS("Du nimmst ein kurzes entspannendes Bad in der Badewanne.\n"));
	  say (BS(TP->name(WER,2)+" nimmt ein kurzes entspannendes Bad in der "
	      +"Badewanne.\n"));
	  return 1;
	}    
    }  
  else return 0;
}

kaestchen_schau ()
{
  if (kaestchen == 0)
    {
      return (BS("Ein kleines Kaestchen aus Marmor. Was da wohl drin ist? "
	       +"Vielleicht kannst Du es oeffnen.\n"));
    }
  else 
    {
      return (BS("Das Kaestchen ist offen. Darin erblickst Du einige Oele, "
	      +"Flaeschchen und Reinigungsmittel.\n"));
    }
}	

oel_schau ()
{
  if (kaestchen == 0)
    {
      return (BS("Sowas siehst Du da nicht!\n"));
    }
  else 
    {
      return (BS("Es sind hauptsaechlich Duftoele die beim Baden benoetigt "
	      +"werden.\n"));
    }
}

mittel_schau ()
{
  if (kaestchen == 0)
    {
      return (BS("Sowas siehst Du da nicht!\n"));
    }
  else 
    {
      return (BS("Das sind Reinigungsmittel die man eben zum "
	      +"Saubermachen braucht.\n"));
    }
}

flaeschchen_schau ()
{
  if (kaestchen == 0)
    {
      return (BS("Sowas siehst Du da nicht!\n"));
    }
  else 
    {
      flasche_gefunden=1;
      return (BS("Bei der naehereren Untersuchung der Flaeschchen faellt Dir eine Flasche auf.\n"));
    }
}


flasche_schau ()
{
  object ob;
  if (kaestchen == 0)
    {
      return (BS("Sowas siehst Du da nicht!\n"));
    }
  else 
    {
      if (flasche_gefunden == 0)
	return (BS("Sowas siehst Du da nicht!\n"));
      else
	{
	  if (!ob=present(("\nsqquestitem"),TP)) 
	    return (BS("Scheint nichts besonderes zu sein!\n"));
	  else
	    {
	      if (!ob=present(("\nsqsaranostin"),TP))
		{
		  CLONE((OBJ("saranostin")),(TP));
		  flasche_gefunden=0;
		  kaestchen=0;
		  return (BS("Es handelt sich um eine Flasche Saranostin (was immer das "
			     +"auch sein mag), die Du sofort einsteckst und dann das "
			     +"Kaestchen wieder schliesst.\n"));
		}
	      else return (BS("Das hast Du doch schon untersucht!\n"));		    
	    }
	}
    }
}

oeffne_was (str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if (str == "kaestchen")
    {
      if (kaestchen == 0)
	{
	  write (BS("Du oeffnest das Kaestchen.\n"));
	  say (BS(TP->name(WER,2)+" oeffnet das Kaestchen.\n"));
	  kaestchen=1;
	  return 1;
	}
      else return write(BS("Aber es ist doch schon offen!\n")),1;
    }
  else return 0;
}

















