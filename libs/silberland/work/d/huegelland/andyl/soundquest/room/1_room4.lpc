#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

int schachtelweg;

void create()
{
  schachtelweg = 0;
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Ein Abstellraum");
  SetProp (P_INT_LONG, "Dieser Raum scheint so etwas wie ein Abstellraum zu sein.\n"
	   +"Ueberall liegt Geruempel herum. Kisten, Truhen, Schachteln und sonstige "
	   +"Behaeltnisse stapeln sich hier aufeinander. Was hier wohl fuer Schaetze "
	   +"lagern?\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(({"raum", "abstellraum"}),
	    "Dieser Raum scheint ein Abstellraum zu sein.\n");
  AddDetail (("boden"),
	     "Der Boden besteht aus dunkelblauen Fliesen.\n");
  AddDetail (({"fliesen", "farbe"}),
	     "Die Fliesen haben eine dunkelblaue Farbe.\n");
  AddDetail (({"waende", "wand"}),
	     "Die Waende sind schwarz und vollstaendig aus Stein.\n");
  AddDetail (("decke"),
	     "Die Decke ist schwarz und besteht aus Stein. An ihr haengt ein Lampe.\n");
  AddDetail (("lampe"),
	     "Ohne diese Lampe waere es hier wahrscheinlich ziemlich finster.\n");
  AddSpecialDetail (({"schachteln", "schachtel"}), "schachtelschau");
  AddDetail(("menge"),
	    "Da sind eine Menge Schachteln.\n");
  AddDetail(("blick"),
	    "Ui, hast Du aber einen boesen Blick.\n");
  AddDetail (({"geruempel", "haufen"}),
	     "Kaputte Instrumente, alte Notenhefte, und unnoetiges Zubehoer liegen hier auf einem "
	     +"Haufen.\n");
  AddDetail (("instrumente"),
	     "Die Instrumente hier sind nicht mehr zu gebrauchen.\n");
  AddDetail(("stein"),
	    "Der ist ziemlich hart.\n");
  AddDetail (("notenhefte"),
	     "Die Notenhefte sind alt und wertlos.\n");
  AddDetail (("zubehoer"),
	     "Vom Zubehoer ist nichts mehr zu gebrauchen.\n");
  AddDetail (({"truhen", "truhe"}),
	     "Truhen in allen Farben und Formen stehen hier herum.\n");
  AddDetail (({"kisten", "kiste"}),
	     "Es sind alte verstaubte Kisten die nichts Interessantes enthalten.\n");
  AddDetail (({"interessantes"}),
	     "Glaube es, in den Kisten ist nichts Interessantes.\n");
  AddDetail (("Farben"),
	     "Du kannst viele Farben zaehlen.\n");
  AddDetail (("Formen"),
	     "Von klein bis sehr gross ist hier alles vertreten.\n");
  AddDetail (("schaetze"),
	     "Wahrscheinlich werden die Schaetze eher alter Plunder als irgendwas wertvolles sein.\n");
  AddDetail (({"plunder", "sachen"}),
	     "So wichtige Sachen wie sinnlos vollgeschriebene Notenblaetter.");
  AddDetail (("notenblaetter"),
	     "Sie sind sinnlos vollgeschrieben.\n");
  AddDetail (({"behaeltnisse", "art", "behaelter"}),
	     "Behaelter verschiedenster Art.\n");
  AddSound( DEFAULT_SOUND,
	    "Es ist absolut still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du kannst nichts besonderes riechen.\n");
  AddSpecialDetail(("truhe"),"truheschau");
  AddSpecialDetail(("symbol"), "symbolschau");
  AddSpecialDetail(("winkel"), "winkelschau");
  // DETAILS END;
  
  AddCmd(({"schliesse", "schliess"}), "truhe_zu");
  AddCmd(("oeffne"), "truhe_auf");
  AddCmd(({"schieb", "schiebe"}), "schieben");
  AddCmd(({"breche", "brich"}), "breche_symbol");
  AddCmd(({"zaehl", "zaehle"}), "zaehle_was");

  // EXITS START
  AddExit ("nordwesten", ROOM("1_room9"));
  AddExit ("nordosten", ROOM("1_room3"));
  AddSpecialExit (("suedosten"), "suedosten_geh");
  AddExit ("westen", ROOM("1_room6"));
  // EXITS END
  
  // ITEMS START
  // ITEMS END
  
  previous_object()->CustomizeObject(); 
}

zaehle_was (str)
{
  notify_fail("Was willst Du zaehlen?\n");
  if (str == "farben")
    {
      write(BS("Nach zweihundertfuenfunddreissig gezaehlten Farben hoerst "
	       +"Du auf zu zaehlen, da dies doch eine langweilige Beschaeftigung ist."));
      return 1;
    }
  else return 0;
}

suedosten_geh()
{  
  TP->move(ROOM("1_room5:"+getuid(this_player())), M_GO);
  return 1;
}

schieben (str)
{
  notify_fail ("Was willst Du wegschieben?\n");
  if ((str == "schachteln weg" || str == "schachteln" || str == "schachtel" || str == "schachtel weg"))
    {
      if (schachtelweg == 1) 
	{
	  write (BS("Die sind schon weggeschoben.\n"));
	  return 1;
	}      
      else
	{
	  write (BS("Du schiebst die Schachteln weg und entdeckst dahinter eine Truhe.\n"));
	  say (BS(this_player()->name(WER,2)+" schiebt ein paar Schachteln weg.\n"));
	  schachtelweg=1;
	  return 1;
	}
    }  
  else return 0;
}

schachtelschau ()
{
  if ("schachtelweg == 0") 
    return (BS("Vor Dir liegen eine Menge Schachteln, die den Blick in einen speziellen Winkel des "
	       +"Raumes versperren. Vielleicht kannst Du sie wegschieben?\n"));
  else return BS(("Die Schachteln sind weggeschoben worden und geben jetzt den Blick auf eine kleine Truhe frei.\n"));
}  

winkelschau ()
{
  if (schachtelweg == 0) 
    return (BS("Der Blick auf den Winkel wird Dir durch die Schachteln verwehrt.\n"));
  else return BS(("Da steht eine kleine Truhe.\n"));
}  

truheschau ()
{
  if (schachtelweg == 0) return ("Sowas siehst Du da nicht!\n");
  else return BS(("Du siehst eine kleine Truhe mit einem magischem Symbol darauf.\n"));
}

symbolschau ()
{ 
  if (schachtelweg == 0) return BS(("Sowas siehst Du da nicht!\n"));
  else return BS(("Das magische Symbol auf der Truhe sieht interessant aus. Vielleicht kannst "
	       +"du es herausbrechen?\n"));
}

breche_symbol (str)
{
  object ob;
  if (schachtelweg == 0) 
    {
      write ("Was willst Du herausbrechen?\n");
      return 1;
    }
  else
    {
      if ((str == "symbol heraus" || str == "magisches symbol heraus"))
	{
	  if (!ob=present(("\nsqsymbol1"),TP))
	    {
	      write (BS("Das magische Symbol ist nicht sonderlich gut befestigt also "
			+"kannst Du es leicht herausbrechen und steckst es ein und schiebst "
			+"die Schachteln wieder an ihren Platz zurueck.\n")); 
	      say (BS(this_player()->name(WER,2)+" werkelt etwas an einer Truhe herum.\n"));
	      CLONE(OBJ("symbol1"),(TP));	
	      schachtelweg=0;
	      return 1;
	    }	
	  else
	    {
	      write (BS("Aber Du hast das magische Symbol doch schon.\n"));
	      return 1;
	    }
	}
      else write ("Was willst Du herausbrechen?\n");
      return 1;
    }
}

truhe_zu (str)
{
  notify_fail("Was willst Du schliessen?\n");
  if ((schachtelweg == 1) && (str == "truhe"))
    {
      write (BS("Die Truhe ist schon zu.\n"));
      return 1;
    }
  else return 0; 
}

truhe_auf (str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if ((schachtelweg == 0) && (str == "truhe"))
    {
      write (BS("Du kriegst die Truhe nicht auf.\n"));
      return 1;
    }
  else return 0; 
}







