#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

int moerser_gefunden;
int kaesedrin;
int rgiftdrin;
int walnussdrin;
int kressedrin;
int lauchdrin;
int erdedrin;
int bluetedrin;
int gemisch;
int kleingmacht;
int stacheldrin;

void create()
{
  moerser_gefunden=0;
  kaesedrin=0;
  rgiftdrin=0;
  walnussdrin=0;
  kressedrin=0;
  lauchdrin=0;
  erdedrin=0;
  bluetedrin=0;
  gemisch=0;
  kleingmacht=0;
  stacheldrin=0;
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Eine verwuestete Kueche");
  SetProp (P_INT_LONG, "Das hier duerfte die Kueche sein oder das was davon "
	   +"uebrig ist. Hier duerfte irgendjemand ziemlich gewuetet haben. "
	   +"Teller, Glaeser und Besteck liegen quer ueber den ganzen Raum "
	   +"verteilt, Kaesten sind umgeworfen worden und Toepfe liegen "
	   +"ramponiert am Boden (der wiederum mit einer klebrigen "
	   +"Fluessigkeit bedeckt ist). Das einzige, was hier noch heil ist, "
	   +"scheint der kleine Holztisch im Eck zu sein.\n");
  
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(({"raum","kueche"}),
	    "Dieser Raum ist die Kueche des Hauses, oder das was davon uebrig ist.\n");
  AddDetail(("haus"),
	    "Du befindest Dich im Haus des Soundmagiers.\n");
  AddDetail(("soundmagier"),
	    "Der scheint gerade nicht zuhause zu sein.\n");
  AddDetail(({"boden", "fliesenboden"}),
	    "Es ist ein weisser Fliesenboden. Er ist mit einer ekligen "
	    +"Fluessigkeit bedeckt.\n");
  AddDetail(({"waende", "wand"}),
	    "Die Waende sind schoen mit weissen Fliesen verfliest. Leider sind sie "
	    +"durch eine klebrige Fluessigkeit verunstaltet.\n");
  AddDetail(("fliesen"),
	    "Es sind weisse Fliesen.\n");
  AddDetail(("decke"),
	    "Selbst die Decke ist verunstaltet. Ueberall haengen dort die Tropfen einer "
	    +"klebrigen Fluessigkeit.\n");
  AddDetail(("tropfen"),
	    "Als Du die Tropfen betrachtest, fallen Dir gleich ein paar von diesen "
	    +"voll ins Auge. Ighitt, ist das ekelhaft.\n");
  AddDetail(("dreck"),
	    "Dreck findest Du hier ueberall.\n");
  AddDetail(("schmutz"),
	    "Der Schmutz ist ueberall im Raum verteilt.\n");
  AddDetail(("auge"),
	    "Waeh, da klebt jetzt etwas von der ekligen Fluessigkeit.\n");
  AddDetail(({"eck", "ecke"}),
	    "Da steht ein kleiner Holztisch.\n");
  AddSpecialDetail(({"holztisch", "tisch"}),"tisch_schau");
  AddDetail(({"fluessigkeit", "klebrige fluessigkeit"}),
	    "Die Fluessigkeit hat einen graesslichen Braunton und ist "
	    +"ausserdem extrem klebrig. Ihhh.\n");
  AddSmell(({"fluessigkeit", "klebrige fluessigkeit"}),
	   "Ihhh, die stinkt aber graesslich.\n");
  AddDetail(({"braunton", "farbe", "braun"}),
	    "Dieses Braun ist wirklich graesslich.\n");
  AddDetail(("teller"),
	    "Die meisten Teller sind zerbrochen und die, die es "
	    +"nicht sind, sind dafuer schmutzig.\n");
  AddDetail(({"besteck", "messer", "gabel", "loeffel"}),
	    "Das Besteck liegt vollkommen verdreckt ueber den ganzen Raum verteilt.\n");
  AddDetail(("glaeser"),
	    "Also von den Glaesern scheint keines ganz geblieben zu sein.\n");
  AddDetail(("scherben"),
	    "Von den Glaesern sind nur noch Scherben ueber.\n");
  AddDetail(("kaesten"),
	    "Da liegen einige Kaesten herum, die kaputt sind. Wobei Dir bei einem "
	    +"Kasten etwas auffaellt.\n");
  AddDetail(("toepfe"),
		   "Die sind alle komplett verbeult. Ein Stahltopf "
		   +"ist sogar auseinandergebrochen.\n");
  AddDetail(("stahltopf"),
	    "Wer immer den auch bearbeitet hat, der war nicht gerade sehr feinfuehlig.\n");
  AddSpecialDetail(("kasten"), "kasten_schau");
  AddSpecialDetail(("moerser"), "moerser_schau");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein leises Tropfen.\n");
  AddSound(("tropfen"),
	   "Das Tropfen kommt von der Decke.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Irgendetwas riecht hier ziemlich uebel.\n");
  // DETAILS END;
  
  // EXITS START;
  AddExit (("nordosten"), ROOM("0_room3"));
  AddSpecialExit (("westen"), "westen_geh");
  // EXITS END;

  // ITEMS START;
  
  AddCmd(({"leg", "lege"}), "lege_in");
  AddCmd(({"zerkleiner", "zerkleinere", "zerstampfe", "zerstampfe", "zerreibe", "zerreib"}), "zerkleiner_mit");
  AddCmd(({"schuette", "schuett"}), "schuette_in");
  // ITEMS END;

  previous_object()->CustomizeObject(); 
}

westen_geh()
{  
  TP->move(ROOM("0_room5:"+getuid(this_player())), M_GO);
  return 1;
}

tisch_schau()
{
  if (moerser_gefunden == 1)
    return (BS("Ein kleiner einfacher Holztisch.\n"
	    +"Auf ihm steht ein Moerser.\n"));
  else return (BS("Ein kleiner einfacher Holztisch.\n"));
}

kasten_schau ()
{
  if (moerser_gefunden == 0)
    {
      moerser_gefunden=1;
      return (BS("Als Du den Kasten naeher untersuchst findest Du einen Moerser, "
	      "welchen Du auf den Holztisch stellst.\n"));
    }   
  else return (BS("Du kannst an dem Kasten nichts besonderes erkennen.\n"));
} 

moerser_schau()
{
  if (moerser_gefunden == 0) return ("Sowas siehst Du hier nicht!\n");
  else
    {
      if ((gemisch == 1) && (kleingmacht == 1))
	{
	  return (BS("In dem Moerser ist ein zerkleinertes Gemisch.\n"
		  +"Irgendwas sollte man jetzt noch in den Moerser dazuschuetten.\n"));
	}
      if (gemisch == 1)
	  {
	    return (BS("In dem Moerser ist ein Gemisch, "
		    +"welches man noch zerkleinern sollte.\n"));
	  }
      write (BS("In dem Moerser ist:\n"));
      if ((kaesedrin==0) && (rgiftdrin==0) && (walnussdrin==0) &&
	  (kressedrin==0) && (lauchdrin==0) && (erdedrin==0) &&
	  (bluetedrin==0) && (stacheldrin==0))
	{
	  return("Nichts. Vielleicht kann man da ja was "
		 +"reinlegen.\n");
	}
      else
	{
	  if (kaesedrin==1) write("Etwas Kaese.\n");
	  if (rgiftdrin==1) write("Ein wenig Rattengift.\n");
	  if (walnussdrin==1) write("Eine Walnuss.\n");
	  if (kressedrin==1) write ("Ein wenig Kresse.\n");
	  if (lauchdrin==1) write ("Etwas Schnittlauch.\n");
	  if (erdedrin==1) write ("Ein wenig rote Erde.\n");
	  if (bluetedrin==1) write ("Eine Rosenbluete.\n");
	  if (stacheldrin==1) write ("Die Spitze eines Hornissenstachels.\n");
	  return("");
	}
    }
}

lege_in(str)
{
  object ob, ob1;
  notify_fail("Was willst Du wohin legen?\n");
  if ((moerser_gefunden == 0)) return 0;
  if ((str == "kaese in moerser"))
    {
      if (!ob1=present(("\nsqkaese"),TP))
	{
	  write (BS("Aber Du hast doch gar keinen Kaese.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("\nsqtrankbuch"),TP))
	    {
	      write (BS("Damit wartest Du lieber noch "
		    +"bis Du genau weisst wie man das macht.\n"));
	      return 1;
	    }
	  else
	    {
	      write (BS("Du legst den Kaese in den Moerser.\n"));
	      kaesedrin=1;
	      ob1->remove();
	      call_out(("alles_da"), 0);
	      return 1;
	    }
	}
    }

  if ((str == "gift in moerser" || str == "rattengift in moerser"))
    {
      if (!ob1=present(("\nsqrattengift"),TP))
	{
	  write(BS("Aber Du hast doch gar kein Rattengift.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("\nsqtrankbuch"),TP))
	    {
	      write (BS("Damit wartest Du lieber noch "
		    +"bis Du genau weisst wie man das macht.\n"));
	      return 1;
	    }
	  else
	    {
	      write (BS("Du legst das Rattengift in den Moerser.\n"));
	      rgiftdrin=1;
	      ob1->remove();
	      call_out(("alles_da"), 0);
	      return 1;
	    }
	}
    }
  
  if ((str == "walnuss in moerser" || str == "nuss in moerser"))
    {
      if (!ob1=present(("\nsqwalnuss"),TP))
	{
	  write (BS("Aber Du hast doch gar keine Walnuss.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("\nsqtrankbuch"),TP))
	    {
	      write(BS("Damit wartest Du lieber noch "
		    +"bis Du genau weisst wie man das macht.\n"));
	      return 1;
	    }
	  else
	    {
	      write (BS("Du legst die Walnuss in den Moerser.\n"));
	      walnussdrin=1;
	      ob1->remove();
	      call_out(("alles_da"),0);
	      return 1;
	    }
	}
    }
  
  if ((str == "kresse in moerser"))
    {
      if (!ob1=present(("\nsqkresse"),TP))
	{
	  write (BS("Aber Du hast doch gar keine Kresse.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("\nsqtrankbuch"),TP))
	    {
	      write (BS("Damit wartest Du lieber noch "
		    +"bis Du genau weisst wie man das macht.\n"));
	      return 1;
	    }
	  else
	    {
	      write (BS("Du legst die Kresse in den Moerser.\n"));
	      kressedrin=1;
	      ob1->remove();
	      call_out(("alles_da"),0);
	      return 1;
	    }
	}
    }
  
  if ((str == "spitze in moerser" || str == "stachelspitze in moerser" || 
       str == "hornissenstachelspitze in moerser"))
    {
      if (!ob1=present(("\nsqspitze"),TP))
	{
	  write (BS("Aber Du hast doch gar keine Hornissenstachelspitze.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("\nsqtrankbuch"),TP))
	    {
	      write (BS("Damit wartest Du lieber noch "
		    +"bis Du genau weisst wie man das macht.\n"));
	      return 1;
	    }
	  else
	    {
	      write (BS("Du legst die Hornissenstachelspitze in den Moerser.\n"));
	      stacheldrin=1;
	      ob1->remove();
	      call_out(("alles_da"),0);
	      return 1;
	    }
	}
    }

  
   if ((str == "schnittlauch in moerser" || str == "lauch in moerser"))
    {
      if (!ob1=present(("\nsqschnittlauch"),TP))
	{
	  write (BS("Aber Du hast doch gar keinen Schnittlauch.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("\nsqtrankbuch"),TP))
	    {
	      write (BS("Damit wartest Du lieber noch "
		    +"bis Du genau weisst wie man das macht.\n"));
	      return 1;
	    }
	  else
	    {
	      write(BS("Du legst den Schnittlauch in den Moerser.\n"));
	      lauchdrin=1;
	      ob1->remove();
	      call_out(("alles_da"),0);
	      return 1;
	    }
	}
    }
  
  if ((str == "erde in moerser") || (str == "rote erde in moerser"))
    {
      if (!ob1=present(("\nsqerde"),TP))
	{
	  write (BS("Aber Du hast doch gar keine rote Erde.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("\nsqtrankbuch"),TP))
	    {
	      write(BS("Damit wartest Du lieber noch "
		    +"bis Du genau weisst wie man das macht.\n"));
	      return 1;
	    }
	  else
	    {
	      write(BS("Du legst die rote Erde in den Moerser.\n"));
	      erdedrin=1;
	      ob1->remove();
	      call_out(("alles_da"),0);
	      return 1;
	    }
	}
    }
  
    if ((str == "bluete in moerser" || str == "rosenbluete in moerser"))
      {
	if (!ob1=present(("\nsqrosenbluete"),TP))
	  {
	    write (BS("Aber Du hast doch gar keine Rosenbluete.\n"));
	    return 1;
	  }
	else 
	  {
	    if (!ob=present(("\nsqtrankbuch"),TP))
	      {
		write (BS("Damit wartest Du lieber noch "
		      +"bis Du genau weisst wie man das macht.\n"));
		return 1;
	      }
	    else
	      {
		write (BS("Du legst die Rosenbluete in den Moerser.\n"));
		bluetedrin=1;
		ob1->remove();
		call_out(("alles_da"),0);
		return 1;
	      }
	  }
      }
  return 0;
}

void alles_da()
{
  if ((kaesedrin==1) && (rgiftdrin==1) && (walnussdrin==1) && 
      (kressedrin == 1) && (lauchdrin == 1) && (erdedrin == 1) &&
      (bluetedrin == 1) && (stacheldrin == 1))
    {
      write (BS("Jetzt scheinst Du alles beisammen zuhaben. Im "
	    +"Moerser ist jetzt ein nettes Gemisch, das Du "
	    +"jetzt nur noch zerkleinern musst.\n"));
      gemisch=1;
    }
  else
    {
      write (BS("Tja, da scheint jetzt noch was zu fehlen.\n"));
    }
}

zerkleiner_mit(str)
{
  object ob;
  notify_fail("Was willst Du womit zerkleinern?\n");  
  if (str == "gemisch")
    {
      if (!ob=present(("\nsqpistill"),TP))
	{
          write(BS("Zum Zerkleinern wirst Du wohl einen Pistill benoetigen.\n"));
	  if (gemisch==0)
	    {
	      write(BS("Ausserdem solltest Du mit dem Zerkleinern warten bis "
		       +"Du alle Zutaten beieinander hast.\n"));
            }
	  return 1;
	}
      else 
	{
	  if (gemisch==1)
	    {
	      write(BS("Theoretisch koenntest Du das Gemisch jetzt mit dem "
		       +"Pistill zerkleinern.\n"));
	      
	    }
	  else 
	    {
	      write(BS("Du solltest damit warten bis Du alle Zutaten beieinader hast.\n"));
	    }
	  return 1;
        }  
    }
  
  
  
  if (str == "gemisch mit pistill")
    {
      if (!ob=present(("\nsqpistill"),TP))
	{
	  write (BS("Aber Du hast doch gar keinen Pistill.\n"));
	  return 1;
	}
      else
	{
	  if (kleingmacht==1)
	    {
	      write (BS("Aber Du hast das Gemisch doch schon zerkleinert.\n"));
	      return 1;
	    }
	  else 
	    {
	      if (gemisch==1)
		{
		  write (BS("Du zerkleinerst fachgerecht das Gemisch. "
			+"Jetzt musst Du nur noch das Saranostin in "
			+"den Moerser schuetten.\n"));
		  kleingmacht=1;
		  return 1;
		}
	      else
		{
		  write (BS("Du musst dazu vorher noch alle Zutaten in den "
			+"Moerser legen.\n"));
		  return 1;
		}
	    }
	}
    }
  else return 0;
}



schuette_in(str)
{
  object ob;
  notify_fail("Was willst Du wohin schuetten?\n");
  if (str == "saranostin in moerser")
    {
      if ((kleingmacht==1))
	{
	  if (!ob=present(("\nsqsaranostin"), TP)) 
	    {
	      write (BS("Aber Du hast doch gar kein Saranostin.\n"));
	      return 1;
	    }
	  else
	    {
	      write (BS("Du schuettest das Saranostin in den Moerser "
		    +"und eine giftgruene Rauchwolke steigt ueber den "
		    +"Moerser auf.\n"
		    +"Im Moerser ist jetzt ein giftgruener Trank den Du "
		    +"in das Saranostinflaeschchen fuellst.\n"));
	      CLONE(OBJ("zaubertrank"),(TP));
	      ob->remove();
	      kaesedrin=0;
	      rgiftdrin=0;
	      walnussdrin=0;
	      kressedrin=0;
	      lauchdrin=0;
	      erdedrin=0;
	      bluetedrin=0;
	      gemisch=0;
	      kleingmacht=0;
	      stacheldrin=0;
	      return 1;
	    }
	}
      else
	{
	  write (BS("Bevor Du das machst, solltest Du noch alle "
		+"anderen Taetigkeiten fertigmachen.\n"));
	  return 1;
	}
    }
  else return 0;
}
















