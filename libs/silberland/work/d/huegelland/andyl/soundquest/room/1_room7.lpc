#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Ein Teleporterraum");
  SetProp (P_INT_LONG, "Du befindest Dich im Teleporterraum der vom ersten Stock ins "
	   +"Erdgeschoss fuehrt. An der Wand ist ein Hebel, der den Teleporter aktiviert.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("wand"),
	    "An der Wand im Westen ist ein Hebel befestigt und gleich daneben ist ein Fenster.\n");
  AddDetail(("fenster"),
	    "Durch das Fenster kannst Du in den Garten sehen.\n");
  AddDetail(("garten"),
	    "Der Garten ist gut gepflegt und viele liebe Tierchen tummeln sich dort.\n");
  AddDetail(({"tierchen", "knuddeln"}),
	    "Die Tierchen, welche Du im Garten siehst, sind wirklich richtig zum Knuddeln.\n"); 
  AddDetail(("boden"),
	    "Der Boden hier schimmert blaeulich und vibriert leicht.\n");
  AddDetail(({"raum", "teleporter", "teleporterraum"}),
	    "Der Raum scheint ein einziger grosser Teleporter nach unten zu sein.\n"
            "Die Magie die ihn funktionstuechtig macht kann man hier sogar sehen.\n");
  AddDetail(("magie"),
	    "Die Magie ist als blaeuliches Schimmern am Boden zu sehen.\n");
  AddDetail(("schimmern"),
	    "Das Schimmern wird von der Magie erzeugt.\n");
  AddDetail(({"waende", "steinwaende"}),
	    "Die Waende sind einfache schwarz gestrichene Steinwaende.\n");
  AddDetail(("erdgeschoss"),
	    "Das Erdgeschoss ist einen Stock unter dir.\n");
  AddDetail(("decke"),
	    "Die Decke ist aus Stein gemacht und schwarz gestrichen.\n");
  AddDetail(("stein"),
	    "Stein, hart und stabil.\n");
  AddDetail(("hebel"),
	    "Wenn Du ihn ziehst wirst Du ins Erdgeschoss teleportiert.\n");
  AddDetail(("stock"),
	    "Du befindest Dich im ersten Stock.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst ein leises Summen hoeren.\n");
  AddSound(("summen"),
	   "Es scheint vom Boden zu kommen.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du kannst nichts besonderes riechen.\n");
  // DETAILS END;
  
  // EXITS START;
  AddExit ("nordosten", ROOM("1_room8"));
  AddExit ("suedosten", ROOM("1_room6"));
  // EXITS END;
  
  AddCmd(({"ziehe", "zieh"}), "ziehe_hebel");
  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  AddCmd(({"taste", "betaste", "beruehre", "beruehr"}), "taste_was");

  // ITEMS START;
  // ITEMS END;
}

taste_was(str)
{
  notify_fail("Was willst Du betasten?\n");
  if ((str == "boden" || str == "boden ab"))
    {
      write(BS("Der Boden vibriert hier leicht. Vermutlich ist da Magie "
	       +"im Spiel, Du kannst es regelrecht fuehlen.\n"));
      return 1;
    }
  else return 0;
}


fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write(BS("Die Magie scheint hier aus irgendeinem Grund "
	       +"besonders stark zu sein.\n"));
      return 1;
    }
  else return 0;
}


ziehe_hebel (str)
{
  notify_fail ("Was willst Du ziehen?\n");
  if (str == "hebel")
    {
      write (BS("Du ziehst den Hebel und bist ploetzlich wieder im Raum unter Dir.\n"));
      say (BS(this_player()->name(WER,2)+" zieht einen Hebel und verschwindet ploetzlich.\n"));   
      TP->move(ROOM("0_room6"),M_TPORT);
      return 1;
    }
  else return 0;
}
























