#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du befindest Dich in einem Teil des grossen Gartens, "
	   +"der zu dem Haus nordwestlich von Dir gehoert. Der Rasen auf dem Du "
	   +"gerade stehst scheint einen wirklich guten Gaertner gehabt zu haben. "
	   +"Irgendwoher kannst Du ein leises Zirpen hoeren. "
	   +"Obwohl Du nicht weisst warum, fuehlst Du Dich hier sichtlich wohl.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("boden"),
	    "Du stehst auf einem traumhaften Rasen.\n");
  AddDetail(("teil"),
	    "Du stehst hier in einem Teil des grossen Gartens.\n");
  AddDetail(("garten"),
	    "Du stehst derzeit in einem Teil des grossen Gartens. "
	    +"Wenn Du mehr sehen moechtest, schau Dir alles in Ruhe an.\n");
  AddDetail(("ruhe"),
	    "Schau Dich hier in aller Ruhe um.\n");
  AddDetail(("rasen"),
	    "Der hat einen wirklich guten Gaertner gehabt.\n");
  AddDetail(("gaertner"),
	    "Der Gaertner muss seine Arbeit wirklich sehr gut verstehen.\n");
  AddDetail(({"arbeit", "haufen"}),
	    "Den Rasen so hinzukriegen, muss wirklich ein Haufen Arbeit sein.\n");
  AddDetail(("himmel"),
	    "Kein Woelkchen ist an dem strahlend blauen Himmel zu sehen. Nur "
	    +"die Sonne strahlt dazwischen froehlich herunter.\n");
  AddDetail(("sonne"),
	    "Die Sonne scheint heute besonders froehlich zu sein.\n");
  AddDetail(("woelkchen"),
	    "Keines zu entdecken.\n");
  AddDetail(("haus"),
	    "Wuerdest Du es nicht mit eigenen Augen sehen, wuerdest Du nie "
	    +"glauben, dass man so ein Haus bauen kann ohne das es in sich zusammenstuerzt. "
	    +"Von den Waenden geht ein silbernes Schimmern aus.\n");
  AddDetail(({"augen", "ueberpruefung", "schluss"}),
	    "Nach kurzer Ueberpruefung kommst Du zu dem Schluss, dass Du Augen haben "
	    +"duerftest.\n");
  AddDetail(("waende"),
	    "Von den Waenden geht ein silbernes Schimmern aus.\n");
  AddDetail(("schimmern"),
	    "Das Schimmern kann nur durch Magie erzeugt worden sein.\n");
  AddDetail(("magie"),
	    "Du kannst sie direkt fuehlen.\n");
  AddDetail(({"zirpen", "gezirpe"}),
	    "Du kannst ihm lauschen.\n");
  AddSound(DEFAULT_SOUND,
	   "Du hoerst ein leises Zirpen.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts besonderes.\n");
  AddDetail(({"zirpen", "gezirpe"}),
	    "Du kannst ihm lauschen.\n");
  AddSound(({"zirpen", "gezirpe"}),
	   "Du hoerst ein leises Gezirpe das von einer Grille "
	   +"stammen duerfte.\n");
  AddDetail(({"grille", "suchen"}),
	    "Du siehst nach einigem Suchen eine Grille in dem Rasen, die "
	    +"sich jedoch schnell wieder in einem kleinen Loch versteckt.\n");
  AddDetail(("loch"),
	    "Da versteckt sich die Grille jetzt.\n");
  AddDetail(({"atmosphaere", "meditieren"}),
	    "Hier waere die richtige Atmosphaere zum Meditieren.\n");
  // DETAILS END;
  
  // EXITS START;
  AddExit ("osten", ROOM("garten19"));
  AddExit ("sueden", ROOM("garten18"));
  AddExit ("norden", ROOM("garten21"));
  AddExit ("suedwesten", ROOM("garten17"));
  // EXITS END;

  AddCmd(({"fuehle", "fuehl"}),"fuehle_was");
  AddCmd(({"meditiere", "fuehl"}), "meditieren");
  
  // ITEMS START;
  // ITEMS END;
  
}


fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Du laesst die Magie etwas auf Dich wirken und "
	    +"spuerst eine extrem entspannende Atmosphaere "
	    +"welche die ideale fuers Meditieren waere.\n"));
      return 1;
    }
  else return 0;
}

meditieren()
{
  write (BS("Du meditierst etwas vor Dich hin und fuehlst Dich danach "
	+"stark und kraeftig.\n"));
  say (BS(this_player()->name(WER,2)+" meditiert etwas vor sich hin und "
       +"sieht danach genauso aus wie vorher (wie verwunderlich).\n"));
  return 1;
}


















