#include <properties.h>
#include <moving.h>
#include "../files.h"
inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Ein Vorraum");
  SetProp (P_INT_LONG, "Hier ist der Vorraum zum Haus.\n"
	   +"Richtung Nordwesten und Suedwesten geht es in das Haus, Richtung Osten "
	   +"kommt man in den Garten. Die Waende und die Decke hier sind aus Glas, so "
	   +"dass man in den Garten und auf den Himmel sehen kann. Ausserdem stehen "
	   +"hier noch ein paar Blumentoepfe mit kleinen palmenaehnlichen Pflanzen "
	   +"darin.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(({"vorraum", "raum"}),
	    "Dies ist der Vorraum zum Haus.\n");
  AddDetail(({"toepfe", "blumentoepfe"}),
	    "Es sind gewoehnliche Blumentoepfe aus Ton. In ihnen siehst Du ein "
	    +"paar kleine palmenaehnliche Pflanzen.\n");
  AddDetail(("ton"),
	    "Ganz gewoehnlicher gebrannter Ton.\n");
  AddDetail(({"pflanzen", "palmen", "palme"}),
	    "Die Pflanzen sehen aus wie kleine Palmen.\n");
  AddDetail(("haus"),
	    "Richtung Nordwesten oder Suedwesten kommt man in das Innere "
	    +"von dem eigenartigen Haus.\n");
  AddDetail(({"innere", "inneres"}),
	    "Wenn Du es untersuchen willst, dann geh einfach rein.\n");
  AddDetail(("garten"),
	    "Durch die Glaswaende siehst Du in den wahrlich grossen Garten. "
	    +"Der scheint ausserordentlich gepflegt worden zu sein, was man "
	    +"besonders an dem traumhaften Rasen erkennen kann.\n");
  AddDetail(({"rasen", "traum"}),
	    "Der Rasen ist einfach gesagt ein Traum.\n");
  AddDetail(("himmel"),
	    "Die Sonne strahlt angenehm von ihm herab und keine Wolken "
	    +"sind auf ihm zu sehen.\n");
  AddDetail(("wolken"),
	    "Es sind keine am Himmel zu erkennen.\n");
  AddDetail(("sonne"),
	    "Sie spendet angenehme Waerme.");
  AddDetail(("waerme"),
	    "Die kommt von der Sonne.\n");
  AddDetail(("glas"),
	    "Da sieht man hindurch.\n");
  AddDetail(({"waende", "wand", "glaswaende"}),
	    "Die Waende hier sind aus Glas.\n");
  AddDetail(("decke"),
	    "Die ist aus Glas.\n");
  AddDetail(({"boden", "steinboden"}),
	    "Ein einfacher Steinboden.\n");
  AddDetail(({"stein"}),
	    "Der Boden ist aus Stein.\n");
  AddDetail(("osten"),
	    "In der Richtung kommt man in den Garten.\n");
  AddDetail(({"nordwesten", "suedwesten"}),
	    "In der Richtung gehts ins Haus.\n");
  AddDetail(("richtung"),
	    "Von hier gehts in Richtung Nordwesten, Suedwesten und Osten.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst das verzweifelte Wimmern von Umpf.\n");
  AddSound(("wimmern"), "Hoert sich schrecklich verzweifelt an.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts besonderes.\n");
  // DETAILS END;

  // EXITS START;
  AddExit ("nordwesten", ROOM("0_room2"));
  AddExit ("suedwesten", ROOM("0_room10"));
  AddExit ("raus", ROOM("garten1"));
  // EXITS END

  // ITEMS START
  AddItem(NPC("umpf"), REFRESH_DESTRUCT);
  // ITEMS END
  
}














