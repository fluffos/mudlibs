#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

int knopfgef=0;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Ein Arbeitsraum");
  SetProp (P_INT_LONG, "Hier duerfte mit ziemlicher Sicherheit der Arbeitsraum "
	   +"des Soundmagiers sein.\n"
	   +"Ein kleiner Schreibtisch steht in der Ecke, auf dem sich Berge "
	   +"von Zetteln, Buechern und Manuskripten befinden. "
	   +"Neben dem Schreibtisch steht eine Stehlampe und an der Wand "
	   +"haengt ein kleines Schild. Ausserdem kannst Du eine kleine Harfe entdecken.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail (({"raum", "arbeitsraum"}),
	     "Du befindest Dich im Arbeitsraum des Soundmagiers.\n");
  AddDetail (("boden"),
	     "Der Boden besteht aus dunkelblauen Fliesen.\n");
  AddDetail(({"zettel", "zetteln"}),
	    "Da liegen unzaehlige davon auf dem Schreibtisch.\n");
  AddDetail(("stein"),
	    "Der ist ganz schoen hart.\n");
  AddDetail(("buecher"),
	    "Da liegen einige auf dem Schreibtisch.\n");
  AddDetail (({"fliesen", "farbe"}),
	     "Die Fliesen haben eine dunkelblaue Farbe.\n");
  AddDetail (("waende"),
	     "Die Waende hier sind aus Stein und dunkelblau gestrichen.\n");
  AddDetail (("decke"),
	     "Die Decke hier ist silbern gestrichen und glitzert leicht.\n");
  AddDetail (({"stehlampe", "lampe"}),
	     "Die Stehlampe spendet genug Licht, damit man hier arbeiten kann.\n");
  AddDetail (("licht"),
	     "Es leuchtet nicht sehr stark aber zumindest ausreichend.\n");
  AddDetail (("berge"),
	     "Hier liegen Berge von Zetteln, Manuskripten und Buechern.\n");
  AddDetail (("wand"),
	     "An einer Wand kannst Du ein kleines Schild haengen sehen.\n");
  AddDetail (("schild"),
	     "Du kannst es lesen.\n");
  AddReadDetail (("schild"),
		 "Auszeichnung der Soundmagiergilde fuer besondere Kreativitaet.\n");
  AddDetail(("soundmagiergilde"),
	    "Dieses Detail wollte ich ja eigentlich nicht machen aber Slayvens Skript wollte "
	    +"das ja unbedingt haben. Man kann es nicht anfassen, nicht essen, nicht inhalieren, "
	    +"ja nicht einmal rauchen. Lasst uns jetzt Slayven fuer dieses hervorragende Detail danken:\n"
	    +"DANKE SLAYVEN!!!!!\n"
	    +"(Anmerkung des Autors: "
	    +"Die grossgeschrieben Woerter in diesem Detail lassen sich nicht untersuchen und wer "
	    +"es trotzdem versucht ist selber schuld, doof und stinkt.\n");
  AddDetail(({"dieses", "detail", "slayvens", "slayven", "skript", "man",  
		"lasst", "anmerkung", "autors", "autor", "woerter", "wort"}),
	    "Ich wusste es doch: DU bist DOOF und STINKST!!!\n");
  AddDetail (("auszeichnung"),
	     "Der Soundmagier, der hier wohnt, scheint ziemlich gut in seinem Fach zu sein.\n");
  AddDetail (({"fach", "musik"}),
	     "Das Fach eines Soundmagiers ist die Musik.\n");
  AddDetail(("soundmagier"),
	    "Der Soundmagier duerfte hier gewoehnlich arbeiten.\n");
  
  AddDetail (("kreativitaet"),
	     "Kreativitaet ist in der Musik sehr wichtig.\n");
  AddDetail (("zettel", "buecher", "manuskripte"),
	     "Berge davon stapeln sich hier. Scheint jedoch nichts interessantes dabei zu sein.\n");
  AddDetail (("ecke"),
	     "Da steht ein Schreibtisch.\n");
  AddDetail (("sicherheit"),
	     "Du bist Dir fast sicher, dass hier der Arbeitsraum ist.\n");
  AddDetail (({"tisch", "schreibtisch"}),
	     "Auf ihm lastet das Gewicht von hunderten von Unterlagen, die der Soundmagier hier zum Arbeiten "
	     +"benoetigt.\n");
  AddDetail (("gewicht"),
	     "Ein Wunder, dass der Schreibtisch so ein Gewicht aushaelt.\n");
  AddDetail(("wunder"),
	    "Das ist ein regelrechtes Wunder.\n");
  AddDetail (("unterlagen"),
	     "Manuskripte, Buecher und massenhaft Zettel.\n");
  AddDetail (("arbeiten"),
	     "Das ist doch kein wichtiges Detail. Untersuche lieber gescheite Sachen.\n");
  AddDetail (({"detail", "sachen"}),
	     "Das ist so intelligent wie 'rblerafafds' zu untersuchen.\n");
  AddDetail (("rblerafafds"),
	     "Du scheinst sehr hartnaeckig zu sein. Du wuerdest ja sogar "
	     +"'wzurbza' untersuchen.\n"); 
  AddDetail (("wzurbza"),
	     "Du untersuchst ja noch immer sinnlose Details (sowie 'hgfdhfgdh'). Lass das endlich.\n");  
  AddDetail (("hgfdhfgdh"),
	     "Jetzt gibts keine sinnlosen Details mehr. Das hast Du nun davon (baeh :P).\n");
  AddDetail (({"harfe", "kleine harfe"}),
	     "Ein kleine Harfe. Sie ist mit allen moeglichen Verzierungen uebersaeht.\n");
  AddDetail (({"verzierungen", "darstellungen"}),
	     "Du siehst die Darstellungen einiger Goetter darauf.\n");
  AddDetail (("goetter"),
	     "Du kannst die Darstellung der griechischen Goetter Aphrodite, Ares, Hermes "
	     +"erkennen. Ausserdem noch eine Darstellung von Woody und von Dusty.\n");
  AddDetail (({"darstellung", "woody", "dusty"}),
	     "Die Darstellung ist wirklich sehr gelungen. Du grinst.\n");
  AddDetail (("aphrodite"),
	     "Aphrodite ist die Goettin der Liebe.\n");
  AddDetail (("goettin"),
	     "Da sind Aphrodite und Dusty.\n");
  AddDetail (("gott"),
	     "Da sind Ares, Hermes und schliesslich noch Woody.\n");
  AddDetail (("liebe"),
	     "Muss Liebe schoen sein.\n");
  AddDetail (("ares"),
	     "Ares ist der Gott des Krieges.\n");
  AddDetail (({"krieges","krieg"}),
	     "Sowas moechtest Du lieber nicht erleben.\n");
  AddSpecialDetail (({"hermes", "goetterbote"}), "hermesschau");	   
  AddSpecialDetail (("knopf"), "knopfschau");
  AddSound( DEFAULT_SOUND,
	    "Es ist absolut still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du kannst nichts besonderes riechen.\n");
  // DETAILS END;
  
  // EXITS START;
  AddExit ("nordwesten", ROOM("1_room7"));
  AddExit ("osten", ROOM("1_room4"));
  // EXITS END;
  
  AddCmd(({"druecke", "drueck"}), "druecke_knopf");
  
  // ITEMS START;
  // ITEMS END;

}

hermesschau ()
{
  knopfgef=1;
  return (BS("Hermes ist der Goetterbote. Dir faellt ein Knopf ueber ihm auf.\n")); 
}

knopfschau ()
{
  if (knopfgef == 1) return (BS("Du koenntest ihn ja mal druecken.\n"));
  else return (BS("Sowas siehst Du da nicht!\n"));
}

druecke_knopf (str)
{
  object ob;
  notify_fail("Was willst Du druecken?\n");
  if (knopfgef == 0) return 0;
  else
    {
      if ((str == "knopf"))
	{
	  if (!ob=present(("\nsqmelodie"),TP))
	    {
	      write (BS("Du drueckst den Knopf worauf ploetzlich die Harfe zu spielen beginnt. "
		    +"Die Melodie, die sie spielt ist wunderschoen. Die merkst Du Dir sicher.\n")); 
	      say (BS(this_player()->name(WER,2)+" fingert an der Harfe herum worauf eine wunderschoene "
		   +"Melodie ertoent.\n"));   
	      CLONE(OBJ("melodie"),(TP));	
	      knopfgef=0;
	      return 1;
	    }	
	  else
	    {
	      write (BS("Die Harfe beginnt eine schoene Melodie zu spielen. Aber Du kennst sie eh schon.\n"));
	      return 1;
	    }
	}
      else return 0;
    }
}














