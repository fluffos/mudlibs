#include <properties.h>
#include <moving.h>
#include "../files.h"
#include "../quest.h" // ich hab die defines mal ausgelagert. (Muaddib)

inherit "std/room";

int kugeldrin;
int symbol1drin;
int symbol2drin;
int hebeldrin;
int synthian;
int allesdrin;
int tonspiel;

void create()
{
  // So werden sie nicht bei einem Reset auf Null gesetzt (Muaddib) 
  kugeldrin=0;
  symbol1drin=0;
  symbol2drin=0;
  hebeldrin=0;
  synthian=0;
  allesdrin=0;
  tonspiel=0;
  
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Das Musikzimmer");
  SetProp (P_INT_LONG, "Das ist das Musikzimmer des Soundmagiers.\n"
	   + "Es erstrahlt in allen moeglichen Farben, was dem Raum "
	   + "eine eigene Atmosphaere gibt. "  
	   + "In der Mitte des Raumes siehst Du eine seltsame Apparatur. "
	   + "Wahrscheinlich handelt es sich dabei um eine Art Instrument.\n"
	   + "Besonders faszinierend ist die Glaskuppel ueber Dir.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(("mitte"),
	    "In der Mitte des Raumes steht eine seltsame Apparatur.\n");
  AddDetail(({"raum", "zimmer", "musikzimmer"}),
	    "Dieser Raum scheint das Musikzimmer des Soundmagiers zu sein.\n");
  AddDetail(("soundmagier"),
	    "Der scheint gerade nicht im Haus zu sein.\n");
  AddDetail(("haus"),
	    "Du stehst gerade darin.\n");
  AddDetail(("boden"),
	    "Der Boden ist aus einem glaenzenden silbernen Material das Du nicht kennst.\n"
	    + "Es sieht aus wie Kristall, ist aber bei weitem nicht so hart.\n");
  AddDetail(({"kristall", "material"}),
	    "Das kristallaehnliche Material glaenzt silbern und fuehlt sich ungefaehr so "
	    + "weich wie Moos an. Du kannst keine Kratzer oder Verschmutzungen auf "
            + "ihm erkennen. Es scheint auch spezielle Klangeigenschaften zu haben.\n");
  AddDetail(("moos"),
	    "Das kristallaehnliche Material fuehlt sich wie Moos an.\n");
  AddDetail(({"kratzer", "verschmutzungen"}),
	    "Du kannst keine entdecken.\n");
  AddDetail(({"waende", "wand"}),
	    "Die Waende rings um Dich sind aus einem Dir unbekannten silbernen Material.\n");
  AddDetail(("decke"),
	    "Da ist eine Glaskuppel.\n");
  AddDetail(({"kuppel","glaskuppel","glas"}),
	    "Das Glas der Glaskuppel strahlt in allen moeglichen Farben, die "
	    + "immer wieder in andere Farbtoene uebergehen. Das Licht welches "
	    + "durch das Glas scheint "
	    + "gibt dem Raum eine ganz eigene Atmosphaere.\n");
  AddDetail(({"farben", "farbtoene"}),
	    "Alle Farben, die es gibt, kannst Du auf der Glaskuppel erkennen.\n");
  AddDetail(({"licht","atmosphaere"}),
	    "Das Licht, welches durch die Glaskuppel scheint, erstrahlt in allen nur "
	    + " denkbaren Farben was dem Raum eine eigene Atmosphaere gibt.");
  AddDetail(({"klang", "klangeigenschaften", "klaenge", "form"}),
	    "Das seltsame Material scheint Klaenge aufzusaugen, sie dann zu filtern, "
	    + "um sie dann in ihrer schoensten Form wiederzugeben.\n");
  AddDetail(("klaviatur"),
	    "Die Klaviatur besteht aus schwarzen und weissen Tasten. "
	    +"Wenn das Instrument erst mal eingeschaltet ist kann man "
	    +"damit sicher etwas schoenes intonieren.\n");
  AddDetail(("tasten"),
	    "Du siehst schwarze und weisse Tasten auf der Klaviatur.\n"); 
  AddDetail(("art"),
	    "Die Apparatur duerfte eine Art Instrument sein.\n");
  AddSpecialDetail(({"apparatur", "instrument"}), "instrument_schau"); 
  AddSpecialDetail(("einbuchtung"), "einbuchtung_schau");
  AddSpecialDetail(("schlitz"), "schlitz_schau");
  AddSpecialDetail(("aushoehlung"), "aushoehlung_schau");
  AddSpecialDetail(("loch"), "loch_schau");
  AddSpecialDetail(({"kristallhebel", "hebel"}), "hebel_schau");
  AddSpecialDetail(({"magiedurchflutete kugel", "kugel"}), "kugel_schau");
  AddSpecialDetail(({"magisches symbol"}), "symbol1_schau");
  AddSpecialDetail(({"mystisches symbol"}), "symbol2_schau");
  AddDetail(("symbol"),
	    "Welches Symbol denn?\n");
  AddSound( DEFAULT_SOUND,
	    "Noch ist es still. Aber wenn Du Dich etwas bemuehst, wird sich "
	    +"das hoffentlich aendern.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst hier nichts.\n");
  // DETAILS END;

  // EXITS START;
  AddExit ("runter", ROOM("1_room9"));
  // EXITS END;

  AddCmd(({"stecke", "steck"}), "stecke_was");    
  AddCmd(({"zieh", "ziehe"}), "ziehe_was");
  AddCmd(({"spiel", "spiele", "intonier", "intoniere"}), "spiele_was");
 
  // ITEMS START;
  // ITEMS END;
  
  previous_object()->CustomizeObject(); 
}
symbol1_schau()
{
  if (symbol1drin==1)
    {
      return (BS("Es steckt in dem Schlitz.\n"));
    }
  else
    {
      return ("Sowas siehst Du da nicht!\n");
    }
}
symbol2_schau()
{
  if (symbol2drin==1)
    {
      return (BS("Es steckt in der Einbuchtung.\n"));
    }
  else
    {
      return ("Sowas siehst Du da nicht!\n");
    }
}

kugel_schau()
{
  if (kugeldrin==1)
    {
      return (BS("Sie steckt in der Aushoehlung.\n"));
    }
  else
    {
      return ("Sowas siehst Du da nicht!\n");
    }
}

hebel_schau()
{
  if (hebeldrin==1)
    {
      return (BS("Er steckt in dem Loch.\n"));
    }
  else
    {
      return ("Sowas siehst Du da nicht!\n");
    }
}

einbuchtung_schau()
{
  if (symbol2drin == 1)
    return (BS("Eine Einbuchtung in der ein mystisches Symbol steckt.\n"));
  else return (BS("Eine kleine Einbuchtung in die man anscheinend etwas stecken "
	      +"kann.\n"));
}

schlitz_schau()
{
  if (symbol1drin == 1)
    return (BS("Ein kleiner Schlitz in dem ein magisches Symbol steckt.\n"));
  else return (BS("Ein kleiner Schlitz in den man anscheinend etwas stecken kann.\n"));
}

aushoehlung_schau()
{
  if (kugeldrin == 1)
    return (BS("Eine halbkugelfoermige Aushoehlung, in der eine magiedurchflutete "
	   +"Kugel steckt.\n"));
  else return (BS("Eine halbkugelfoermige Aushoehlung, in die man anscheinend "
	      +"etwas stecken kann.\n"));
}

loch_schau()
{
  if (hebeldrin ==1)
    return (BS("In dem Loch steckt ein Kristallhebel.\n"));
  else return (BS("Ein Loch, in das man anscheinend etwas stecken kann.\n"));
}


instrument_schau()
{
  write (BS("Auf der Apparatur sind eine halbkugelfoermige Aushoehlung, "
	+"ein kleines Loch, ein kleiner Schlitz, eine Einbuchtung und "
	+"eine Klaviatur.\n"));
  if (kugeldrin == 1)
    {
	write (BS("In der Aushoehlung steckt eine magiedurchflutete "
	      +"Kugel. "));
      }
  if (symbol1drin == 1)
    {
      write (BS("In dem Schlitz steckt ein magisches Symbol. "));
    }
  if (symbol2drin == 1)
    {
      write (BS("In der Einbuchtung steckt ein mystisches Symbol. "));
    }
  if (hebeldrin == 1)
    {
      write (BS("In dem Loch steckt ein Kristallhebel. "));
    }
  if (synthian == 1)
    {
      write (BS("Die ganze Apparatur erstrahlt in einem "
	    +"hellen magischen Licht."));
    }
  return("\n");
}


spiele_was(str)
{
  object ob;
  notify_fail("Welchen Ton willst Du denn spielen?\n");
  if (synthian == 0)
    {
      write (BS("Du musst das Instrument erst einschalten "
		+"bevor Du darauf spielen kannst.\n"));
      return 1;
    }
  if (!ob=present(("\nsqanleitung"),TP))
    {
      write (BS("Bevor Du nicht weisst was Du spielen sollst, "
		+"solltest Du das Instrument noch nicht benutzen.\n"));
      return 1;
    }
  if (str == "auf klaviatur")
    {
      write (BS("Welchen Ton willst Du denn spielen?\n"));
      return 1;
    }
  
  if ((str == "ton cis" || str == "ton ces" || str == "ton des" ||
       str == "ton dis" || str == "ton es" || str == "ton e" || 
       str == "ton eis" || str == "ton f" || str == "ton fis" || 
       str == "ton fes" || str == "ton ges" || str == "ton gis" || 
       str == "ton aes" || str == "ton ais" || str == "ton b" ||
       str == "ton his" || str == "cis" || str == "ces" || str == "des" ||
       str == "dis" || str == "es" || str == "e" || str == "eis" ||
       str == "f" || str == "fis" || str == "fes" || str == "ges" || 
       str == "gis" || str == "aes" || str == "ais" || str == "b" ||
       str == "his"))
    {
      write (BS("Das war jetzt nicht der richtige Ton. Jetzt "
	    +"musst Du nocheinmal von vorne beginnen.\n"));
      tonspiel=0;
      return 1;
    }
  
  if ((str == "ton a" || str == "a"))
    {
      if ((tonspiel==0) || (tonspiel==5))
	{
	  if (tonspiel==0)
	    {
	      write (BS("Du spielst den Ton 'a' auf dem Instrument.\n"));
	      tonspiel=1;
	      return 1;
	    }
	  if (tonspiel==5)
	    {
	      if (ob=present(("\nsqquestitem"), TP)) ob->remove();
	      if (ob=present(("\nsqanleitung"), TP)) ob->remove();
	      if (ob=present(("\nsqrattengift"), TP)) ob->remove();
	      if (ob=present(("\nsqbrecheisen"), TP)) ob->remove();
	      if (ob=present(("\nsqerde"), TP)) ob->remove();
	      if (ob=present(("\nsqholzscheit"), TP)) ob->remove();
	      if (ob=present(("\nsqkaese"), TP)) ob->remove();
	      if (ob=present(("\nsqkristallhebel"), TP)) ob->remove();
	      if (ob=present(("\nsqkresse"), TP)) ob->remove();
	      if (ob=present(("\nsqmelodie"), TP)) ob->remove();
	      if (ob=present(("\nsqkugel"), TP)) ob->remove();
	      if (ob=present(("\nsqnetz"), TP )) ob->remove();
	      if (ob=present(("\nsqnkobold"), TP)) ob->remove();
	      if (ob=present(("\nsqpistill"), TP)) ob->remove();
	      if (ob=present(("\nsqrattengift"), TP)) ob->remove();
	      if (ob=present(("\nsqrose"), TP)) ob->remove();
	      if (ob=present(("\nsrosenbluete"), TP)) ob->remove();
	      if (ob=present(("\nsqrubin"), TP)) ob->remove();
	      if (ob=present(("\nsqsaranostin"), TP)) ob->remove();
	      if (ob=present(("\nsqschnittlauch"), TP)) ob->remove();
	      if (ob=present(("\nsqsymbol1"), TP)) ob->remove();
	      if (ob=present(("\nsqsymbol2"), TP)) ob->remove();
	      if (ob=present(("\nsqtomate"), TP)) ob->remove();
	      if (ob=present(("\nsqtrankbuch"), TP)) ob->remove();
	      if (ob=present(("\nsqwalnuss"), TP)) ob->remove();
	      if (ob=present(("\nsqzaubertrank"), TP)) ob->remove();
	      
	      
	      kugeldrin=0;
	      symbol1drin=0;
	      symbol2drin=0;
	      hebeldrin=0;
	      synthian=0;
	      allesdrin=0;
	      tonspiel=0;
	      
	      ob = clone_object(OBJ("give_quest"))->move(TP, M_NOCHECK);
	      TP->move(ROOM("dummy"), M_GO|M_SILENT|M_NO_SHOW);
	      return 1;
	    }
	}	      
      else
	{
	  write (BS("Das war jetzt nicht der richtige Ton. Jetzt "
		+"musst Du nocheinmal von vorne beginnen.\n"));
	  tonspiel=0;
	  return 1;
	}
    }
  if ((str == "ton c" || str == "c"))
    {
      if (tonspiel==1) 
	{
	  write (BS("Du spielst den Ton 'c' auf dem Instrument.\n"));
	  tonspiel=2;
	  return 1;
	}
      else
	{
	  write (BS("Das war jetzt nicht der richtige Ton. Jetzt "
		+"musst Du nocheinmal von vorne beginnen.\n"));
	       tonspiel=0;
	       return 1;
	}
	 }
  if ((str == "ton h" || str == "h"))
    {
      if (tonspiel==2) 
	{
	  write (BS("Du spielst den Ton 'h' auf dem Instrument.\n"));
	  tonspiel=3;
	  return 1;
	}
      else
	{
	  write (BS("Das war jetzt nicht der richtige Ton. Jetzt "
		+"musst Du nocheinmal von vorne beginnen.\n"));
	  tonspiel=0;
	  return 1;
	}
    }
  if ((str == "ton d" || str == "d"))
    {
      if (tonspiel==3) 
	{
	  write (BS("Du spielst den Ton 'd' auf dem Instrument.\n"));
	  tonspiel=4;
	  return 1;
	}
      else
	{
	      write (BS("Das war jetzt nicht der richtige Ton. Jetzt "
		    +"musst Du nocheinmal von vorne beginnen.\n"));
	      tonspiel=0;
	      return 1;
	}
    }
  if ((str == "ton g" || str == "g"))
    {
      if (tonspiel==4) 
	{
	  write (BS("Du spielst den Ton 'g' auf dem Instrument.\n"));
	  tonspiel=5;
	  return 1;
	}
      else
	{
	  write (BS("Das war jetzt nicht der richtige Ton. Jetzt "
		+"musst Du nocheinmal von vorne beginnen.\n"));
	  tonspiel=0;
	  return 1;
	}
    }
  write (BS("Welchen Ton willst Du denn spielen?\n"));  
  return 1;
}


stecke_was(str)
{
  object ob, ob1;
  string str1, str2;
  if (!str) return;
  notify_fail("Was willst Du wohin stecken?");
  sscanf(str, "%s in %s", str1, str2);
  if ((str1=="symbol"||str1=="magisches symbol"||str1=="mystisches symbol" ||
       str1=="hebel" || str1=="kristallhebel" || str1=="kugel" ||
       str1=="magiedurchflutete kugel") && 
      (str2=="loch" || str2=="einbuchtung" || str2=="schlitz" || str2=="aushoehlung"))
    {
      if (str1=="symbol")
	{
	  if ((!ob=present(("\nsqsymbol1"),TP)) && (!ob1=present(("\nsqsymbol2"),TP)))
	    {
	      write (BS("Aber Du hast doch gar kein Symbol.\n"));
	      return 1;
	    }
	  else
	    {
	      write (BS("Welches Symbol meinst Du denn?\n"));
	      return 1;
	    }
	}
      
      if ((str1=="magisches symbol") && (str2=="schlitz"))
	{
	  if (!ob=present(("\nsqsymbol1"),TP))
	    {
	      write (BS("Du hast kein magisches Symbol.\n"));
	      return 1;
	    }
	  else
	    {
	      if (symbol1drin == 1)
		{
		  write (BS("Es ist schon ein magisches Symbol in dem Schlitz.\n"));
		  ob->remove();
		  return 1;
		}
	      else
		{
		  write (BS("Du steckst das magische Symbol in den Schlitz.\n"));
		  ob->remove();
		  symbol1drin=1;
		  call_out(("allescheck"), 0);
		  return 1;
		}
	    }
	}
      
      if ((str1=="mystisches symbol") && (str2=="einbuchtung"))
	{
	  if (!ob=present(("\nsqsymbol2"),TP))
	    {
	      write (BS("Du hast kein mystisches Symbol.\n"));
	      return 1;
	    }
	  else
	    {
	      if (symbol2drin == 1)
		{
		  write (BS("Es ist schon ein mystisches Symbol in der Einbuchtung.\n"));
		  ob->remove();
		  return 1;
		}
	      else
		{
		  write (BS("Du steckst das mystische Symbol in die Einbuchtung.\n"));
		  ob->remove();
		  symbol2drin=1;
		  call_out(("allescheck"), 0);
		  return 1;
		}
	    }
	}
   
      if ((str1=="hebel" || str1=="kristallhebel") && (str2=="loch"))
	{
	  if (!ob=present(("\nsqkristallhebel"),TP))
	    {
	      write (BS("Du hast keinen Kristallhebel.\n"));
	      return 1;
	    }
	  else
	    {
	      if (hebeldrin == 1)
		{
		  write (BS("Es ist schon ein Kristallhebel in dem Loch.\n"));
		  ob->remove();
		  return 1;
		}
	      else
		{
		  write (BS("Du steckst den Kristallhebel in das Loch.\n"));
		  ob->remove();
		  hebeldrin=1;
		  call_out(("allescheck"), 0);
		  return 1;
		}
	    }
	}
      
      if ((str1=="kugel" || str1=="magiedurchflutete kugel") && (str2=="aushoehlung"))
	{
	  if (!ob=present(("\nsqkugel"),TP))
	    {
	      write (BS("Du hast kein magiedurchflutete Kugel.\n"));
	      return 1;
	    }
	  else
	    {
	      if (kugeldrin == 1)
		{
		  write (BS("Es ist schon eine magiedurchflutete Kugel in der Aushoehlung.\n"));
		  ob->remove();
		  return 1;
		}
	      else
		{
		  write (BS("Du steckst die magiedurchflutete Kugel in die Aushoehlung.\n"));
		  ob->remove();
		  kugeldrin=1;
		  call_out(("allescheck"), 0);
		  return 1;
		}
	    }
	}
      write (BS("Das passt da nicht hinein.\n"));
      return 1;
    }
  else return 0;
}

void allescheck()
{
  if ((kugeldrin==1) && (hebeldrin==1) && (symbol1drin==1) && (symbol2drin==1))
    {
      allesdrin=1;
      write (BS("So, jetzt muesste man das Instrument irgendwie "
	    "einschalten koennen.\n")); 
    }
}

ziehe_was(str)
{
  notify_fail("Was willst Du ziehen?\n");
  if ((str == "hebel" || "kristallhebel"))
    {
      if (hebeldrin == 1)
	{
	  if (synthian == 1)
	    {
	      write (BS("Das Instrument ist doch schon eingeschaltet.\n"));
	      return 1;
	    }
	  else
	    {
	      if (allesdrin == 1)
		{
		  write (BS("Du ziehst an dem Kristallhebel und "
			+"ploetzlich faengt das magische Instrument an "
			+"zu pulsieren. Ein roter Lichtstrahl scheint kurz "
			+"ueber dem Instrument auf wird dann immer heller "
			+"und legt sich schlussendlich wie ein Schleier ueber "
			+"das Instrument. Das Instrument scheint jetzt eingeschaltet "
			+"zu sein und erstrahlt in einem hellen magischen Licht.\n"));
		  synthian=1;
		  return 1;
		}
	      else 
		{
		  write (BS("Du ziehst an dem Kristallhebel aber nichts geschieht.\n"));
		  return 1;
		}
	    }
	}      
      else 
	{
	  write (BS("Du findest keinen Hebel an dem Du ziehen koenntest.\n"));
	  return 1;
	}
    }
  else return 0;
}





































