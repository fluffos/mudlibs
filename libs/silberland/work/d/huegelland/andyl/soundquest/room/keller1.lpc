#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

int scheibe=0;
int seil=0;
int knopf=0;
int kasten=0;
int dokument=0;

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 0);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:17, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Im Keller des Soundmagierhauses");
  SetProp (P_INT_LONG, "Du befindest Dich hier im Keller des Soundmagierhauses.\n"
	   +"Es ist etwas kuehler als oben und es ist auch ziemlich duster. "
	   +"Der Boden ist mit glatten glaenzenden Metallplatten ausgelegt. "
	   +"Die Waende sind ebenfalls metallisch und glaenzen silbern. "
	   +"Die Decke ist aus voellig glatten Marmor. "
	   +"In diesem Raum scheint es offensichtlich nicht viel zu geben, "
	   +"aber der Schein kann auch truegen. "
	   +"Im Sueden fuehrt eine Tuer in einen weiteren Raum des Kellers und "
	   +"ueber eine Treppe im Osten kommst Du wieder zurueck nach oben.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("waende"),
	    "Die Waende sind metallisch und glaenzen silbern. Du kannst nichst "
	    +"besonderes an ihnen erkenn... Moment, da haettest Du doch fast "
	    +"etwas an der Nordwand uebersehen.\n");
  AddDetail(({"moment", "spieler"}),
	    "Manche Spieler muessen auch jeden Sch... untersuchen.\n");
  AddDetail(({"sch", "sch...", "schimpfwoerter", "moral" , "arsch", "idee"}),
	    "Um die Moral aufrecht zu erhalten werden Schimpfwoerter "
	    +"bewusst nicht voll ausgeschrieben. Welcher Arsch ist eigentlich "
	    +"auf diese daemliche Idee gekommen?\n");
  AddDetail(({"wand"}),
	    "Welche Wand willst Du denn untersuchen? Die Nordwand, die Ostwand, "
	    +"die Suedwand oder die Westwand?\n");
  AddDetail(("nordwand"),
	    "Da ist eine kleine Ritze in der Wand.\n");
  AddDetail(("ritze"),
	     "In der Ritze ist ein kleine Scheibe.\n");
  AddDetail(("scheibe"),
	     "Hmmm, vielleicht koennte man sie ja drehen.\n");
  AddDetail(("ostwand"),
	    "Bis auf den Schatten der Treppe kannst du nichts erwaehnenswertes erkennen.\n");
  AddDetail(("schatten"),
	    "Der ganz gewoehnliche Schatten einer Treppe.\n");
  AddDetail(("schein"),
	    "Der Schein truegt manchmal.\n");
  AddDetail(({"haus", "soundmagierhaus"}),
	    "Du befindest Dich im Keller davon.\n");
  AddDetail(("westwand"),
	    "Da ist nichts aufregendes.\n");
  AddDetail(("suedwand"),
	    "Da ist eine Tuer.\n");
  AddDetail(("tuer"),
	    "Die Tuer fuehrt in einen Raum im Sueden.\n");
  AddDetail(("treppe"),
	     "Die Treppe ist aus Holz und fuehrt nach oben.\n");
  AddDetail(({"holz", "baum"}),
	     "Hart, brennt gut, schwimmt und riecht nach Baum. Holz also.\n");
  AddDetail(({"raum", "keller"}),
	    "Du stehst jetzt im Keller des Soundmagierhauses.\n");
  AddDetail(({"metallplatten", "platten"}),
	    "Es sind voellig quadratische, glatte Metallplatten.\n");
  AddDetail(("metall"),
	    "Ein Dir voellig unbekanntes Metall.\n");
  AddDetail(("klicken"),
	    "Das Klicken kam von oben.\n");
  AddSound(("klicken"),
	    "Das Klicken kam von oben.\n");
  AddDetail(("rumpeln"),
	    "Das Rumpeln kam von unten.\n");
  AddSound(("klicken"),
	    "Das Rumpeln kam von unten.\n");
  AddDetail(("marmor"),
	    "Der Marmor ist voellig glatt.\n");
  AddDetail(("stille"),
	    "Was fuer eine angenehme Stille.\n");
  AddSound(("stille"),
	    "Was fuer eine angenehme Stille.\n");
  AddSpecialDetail(("decke"), "decke_schau");
  AddSpecialDetail(("boden"), "boden_schau");
  AddSpecialDetail(("seil"), "seil_schau");
  AddSpecialDetail(("boden"), "boden_schau");
  AddSpecialDetail(("knopf"), "knopf_schau");
  AddSpecialDetail(({"kasten", "vorderseite"}), "kasten_schau");
  AddSpecialDetail(({"glasfenster", "fenster"}), "glasfenster_schau");
  AddSpecialDetail(("dokument"), "dokument_schau");
  
  AddSound( DEFAULT_SOUND,
	    "Du lauscht der angenehmen Stille.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Hier gibts jetzt sicher nichts zu riechen.\n");
  // DETAILS END;


  // COMMANDS
  AddCmd(({"dreh", "drehe"}), "drehe_was");
  AddCmd(({"ziehe", "zieh"}), "ziehe_was");
  AddCmd(({"druecke", "drueck"}), "druecke_was");
  AddCmd(({"oeffne"}), "oeffne_was");
  
  // COMMANDS END
  
  // EXITS START;
  AddExit ("treppe", ROOM("0_room11"));
  AddSpecialExit ("sueden", "goto_keller2");
  // EXITS END;

  // ITEMS START;
  // ITEMS END;

  previous_object()->CustomizeObject(); 
  
}

goto_keller2()
{  
  TP->move(ROOM("keller2:"+getuid(this_player())), M_GO);
  return 1;
}

ziehe_was(str)
{
  notify_fail("Woran willst Du ziehen?");
  if ((scheibe==1) && ((str == "seil" || str == "an seil")))
    {
      write(BS("Du ziehst an dem Seil und hoerst ploetzlich ein Rumpeln "
	       +"unterhalb von Dir.\n"));
      seil=1;
      return 1;
    }
  else return 0; 
}

drehe_was(str)
{
  notify_fail("Was willst Du drehen?");
  if (str == "scheibe")
    {
      write(BS("Du drehst die Scheibe und hoerst ploetzlich ein Klicken oberhalb "
	       +"von Dir.\n"));
      scheibe=1;
      return 1;
    }
} 

decke_schau()
{
  if (scheibe==1)
    {
      return(BS("Von der Decke baumelt jetzt ein Seil herab. Man koennte ja einmal "
	       "daran ziehen.\n"));
    }
  else
    {
      return(BS("Die Decke ist aus glatten, schoenen Marmor.\n"));
    }
}


boden_schau()
{
  if (seil==1)
    {
      knopf=1;
      return(BS("Im Boden entdeckst Du einen kleinen Knopf.\n"));
    }
  else
    {
      return(BS("Der Boden ist mit glatten glaenzenden Metallplatten ausgelegt.\n"));
    }
}

seil_schau()
{
  if (scheibe==1)
    {
      knopf=1;
      return(BS("Vielleicht kannst Du ja einmal daran ziehen?\n"));
    }
  else
    {
      return(BS("Sowas siehst Du hier nicht.\n"));
    }
}

knopf_schau()
{
  if (knopf==1)
    {
      return(BS("Vielleicht solltest Du ihn druecken?\n"));
    }
  else
    {
      return(BS("Sowas siehst Du hier nicht.\n"));
    }
}

druecke_was(str)
{
  notify_fail("Was willst Du druecken?\n");
  if (str=="knopf" && kasten==0)
    {
      write(BS("Als Du den Knopf drueckst oeffnet sich ploetzlich der Boden "
	       +"unter Dir auf und ein Kasten klappt nach oben.\n"));
      kasten=1;
      return 1;
    }
  if (str=="knopf" && kasten==1)
    {
      write(BS("Du drueckst den Knopf aber nichts passiert"));
      return 1;
    }
  else return 0;
}



kasten_schau()
{
  if (kasten==1)
    {
      return(BS("Die Voderseite des Kastens wird durch ein grosses Glasfenster "
		+"gepraegt.\n"));
    }
  else
    {
      return(BS("Sowas siehst Du hier nicht.\n"));
    }   
}

glasfenster_schau()
{
  if (kasten==1)
    {
      if (dokument==1)
	{
	  return(BS("Das Glasfenster hat jetzt ein grosses Loch.\n"));
	}
      else
	{
	  return(BS("Du schaust Dir das Glasfenster genauer an und entdeckst "
		    +"dahinter ein altes Dokument.\n"));
	}
    }
  else
    {
      return(BS("Sowas siehst Du hier nicht.\n"));
    }   
}

loch_schau()
{
  if ((kasten==1 && dokument==1))
    {
      return(BS("Ein grosses rundes Loch im Glasfenster des Kastens.\n"));
    }
  else
    {
      return(BS("Sowas siehst Du hier nicht.\n"));
    }   
}

dokument_schau()
{
  if (kasten==1)
    {
      if (dokument==1)
	{
	  return(BS("Da ist kein Dokument mehr.\n"));
	}
      else
	{
	  return(BS("Das Dokument scheint wertvoll zu sein. Wenn dieses Glasfenster "
		    +"nicht dazwischen waere wuerdest Du es sofort nehmen. Vielleicht "
		    +"kann man es ja irgendwie oeffnen.\n"));
	}
    }
  else
    {
      return(BS("Sowas siehst Du hier nicht.\n"));
    }   
}
  
oeffne_was(str)
{
  string stri1, stri2;
  object notenblatt;

  notify_fail("Was willst Du oeffnen?\n");
  if ((str=="kasten" || str=="glasfenster" || 
       str=="fenster") && kasten==1)
    {
      write(BS("Deine Kraft reicht nicht aus um das Glasfenster zu oeffnen. "
	       +"Das wirst Du wohl oder uebel ein Hilfsmittel dazu brauchen.\n"));
      return 1;
    }
  sscanf(str, "%s mit %s", stri1, stri2);
  if (((stri1=="kasten" || stri1=="glasfenster" || stri1=="fenster")) && kasten==1) {
      if (stri2=="diamant")
      {
        if(!present("diamant", TP)) {
          write(BS("Aber du hast doch gar keinen Diamanten?"));
          return -1;
        }

        if (dokument==1) {
            write(BS("Hier ist kein Dokument mehr. Der Kasten ist leer."));
            return 1;
        } else {
            present("diamant", TP)->remove(1);
            write(BS("Du schneidest mit dem Diamanten ein Loch in die Glaswand und "
              +"nimmst das alte Dokument an Dich. Seltsamerweise verschwindet "
              +"dabei auch der Diamant.\n"));
            dokument=1;
            
            notenblatt = clone_object("/gilden/bardengilde/obj/quest/noten_schildlied");
            if(notenblatt->move(TP, M_NOCHECK) != 1) {
              write("Fehler! Magier verstaendigen!");
              notenblatt->remove(1);
            }

            return 1;
          }
      } else {
        write(BS("Damit scheint es nicht zu gehen. Probier besser etwas anderes.\n"));
        return 1;
      }
  }
  
  return 0;
}












