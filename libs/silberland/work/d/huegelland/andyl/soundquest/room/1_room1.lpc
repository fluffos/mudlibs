#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Die Musikbibliothek");
  SetProp (P_INT_LONG, "Hier ist die Musikbibliothek des Soundmagiers.\n"
	   + "Du siehst hunderte wenn nicht tausende von Buechern die nur von Musik handeln. "
	   + "Du siehst ein grosses schwarzes Regal an der Nordwand, und ein zwei weitere kleine "
	   + "Regale, eins an der Ostwand und eins an der Westwand.\n"); 
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(({"bibliothek", "musikbibliothek"}),
	    "Die Musikbibliothek scheint sehr umfangreich zu sein.\n");
  AddDetail (("wand"),
	     "Welche Wand meinst Du ?\n");
  AddDetail(("regale"),
	    "Du siehst ein rotes, ein graues und ein schwarzes Regal.\n");
  AddDetail (("ostwand"),
	     "Da steht ein rotes Regal.\n");
  AddDetail (("westwand"),
	     "Da steht ein graues Regal.\n");
  AddDetail (("nordwand"),
	     "Da steht ein grosses schwarzes Regal.\n");
  AddDetail (("regal"),
	     "Welches meinst Du ? Das schwarze, das rote oder das graue Regal?\n");
  AddDetail (("buecher"),
	     "Hier muessen tausende von Buechern herumstehen.\n");
  AddDetail (("schwarzes regal"),
	     "In dem schwarzem Regal wird der Grossteil der Buecher aufbewahrt.\n"
	     +"Hauptsaechlich geht es in diesen Buechern um Harmonielehre, Kompositionstechniken, "
	     +"Notenschreibung, Klangoptimierung und dergleichen. Zwei unbeschriftete Buecher, "
	     +"ein gelbes und ein gruenes, fallen Dir jedoch auf.\n");
  AddDetail(({"harmonielehre", "kompositionstechniken", "notenschreibung", "klangoptimierung"}),
	    "Sonderlich interessant findest Du dieses Thema nicht.\n");
  AddDetail (({"gelbes buch", "gruenes buch", "rotes buch", "blaues buch"}),
	     "Du kannst es lesen.\n");
  AddReadDetail (("gelbes buch"),
		 "In dem gelben Buch geht es nur um Verschoenerung der Notenschreibung. "
		 +"Nichts was Dich sonderlich interessiert.\n"); 
  AddReadDetail (("gruenes buch"),
		 "In dem gruenen Buch geht es um Klangverbesserung in der Avantgardemusik. "
		 +"Mit einem Grausen wendest Du Dich von diesem Buch ab.\n");
  AddDetail(("avantgardemusik"),
	    "Es gibt kaum etwas auf der Welt das sich schlimmer anhoert (vielleicht " 
	    +"mit Ausnahme des Geraeusches eines Ogers wenn er Dich gerade verspeisen will).\n"); 
  AddDetail (("rotes regal"),
	     "In dem roten Regal sind hauptsaechlich Buecher ueber Instrumentenkunde. "
	     +"Ein rotes unbeschriftetes Buch faellt Dir auf.\n");
  AddDetail (("Instrumentenkunde"),
	     "Handelt von allem, was Instrumente ansich betrifft.\n");
  AddReadDetail (("rotes buch"),
		 "In dem Buch steht wie man Holzblaeser am besten pflegt. "
		 +"Nicht wirklich besonders interessant.\n");
  AddDetail (({"holzblaeser", "floeten"}),
	     "Floeten z.B. sind Holzblaeser.\n");
  AddDetail(("stein"),
	    "Ganz gewoehnlicher Stein.\n");
  AddDetail(("musik"),
	    "Musik ist das, was die Soundmagier am besten beherrschen.\n");
  AddDetail(({"haus", "soundmagier"}),
	    "Das Haus hier gehoert einem Soundmagier.\n");
  AddDetail (("graues regal"),
	     "In dem grauen Regal sind die Buecher aufbewahrt, welche das "
	     +"Thema magische Klangerzeugung behandeln. Ein blaues Buch "
	     +"faellt Dir dabei besonders auf.\n");
  AddDetail (({"magische klangerzeugung", "klangerzeugung", "fachgebiet"}),
	     "Die magische Klangerzeugung ist das Fachgebiet der Soundmagier. "
	     +"Fuer Dich ist dieses Thema nicht weiter wichtig.\n");
  AddDetail (("boden"),
	     "Der Boden besteht aus dunkelblauen Fliesen.\n");
  AddDetail (({"fliesen", "farbe"}),
	     "Die Fliesen haben eine dunkelblaue Farbe.\n");
  AddDetail (("decke"),
	     "An der grau angestrichenen Decke haengt eine Lampe.\n");  
  AddDetail (("lampe"),
	     "Ohne sie waers hier wahrscheinlich ziemlich dunkel.\n");
  AddDetail (("waende"),
	     "Die Waende sind aus Stein und dunkelgrau angemalt.\n");
  AddDetail (("suedwand"),
	     "Wenn da eine Suedwand waere, koenntest Du sie untersuchen. Da hier "
	     + "aber keine ist, untersuchst Du vergebens.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein leises Wimmern.\n");
  AddSound(("umpf"),
	   "Der wimmert da so vor sich hin.\n");
  AddSound(("wimmern"),
	   "Ach, das ist nur Umpf der da herumwimmert.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du kannst nichts besonderes riechen.\n");
  // DETAILS END;
  
  // EXITS START;
  AddExit ("suedwesten", ROOM("1_room2"));  
  // EXITS END;
  
  AddCmd(("lies"), "lies_buch");
  // ITEMS START;
  // ITEMS END;
       
}

lies_buch (str)
{
  object ob;
  notify_fail( "Was willst Du denn lesen?\n");
  if(( str == "blaues buch" ))
    {
      if (!ob=present(("\nsqanleitung"),TP))	
      {
	write (BS("Als Du das Buch lesen willst, faellt eine kleine Anleitung aus dem "
	      +"Buch, die Du sofort an Dich nimmst.\n")); 
	say (BS(this_player()->name(WER,2)+" liest ein Buch, worauf aus dem Buch etwas herausfaellt, "
	     +"was "+(this_player()->name(WER,2))+" sofort einsteckt.\n"));   
	CLONE(OBJ("anleitung"),(TP));	
	return 1;
      }
      else 
	{
	  write (BS("Du findest das blaue Buch nicht sonderlich interessant.\n"));
	  return 1;
	}
    } 
  return 0;
}














