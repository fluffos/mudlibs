#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du stehst in einem Teil des riesigen Gartens.\n"
	   +"Im Nordwesten kannst Du einen kleinen Schuppen entdecken der "
	   +"etwas verkommen aussieht. Im Sueden befindet sich das eigenartig "
	   +"anmutende Soundmagierhaus. Dir faellt an dem Haus auf, dass es "
	   +"keine Fenster im Erdgeschoss hat und auch nur wenige im ersten Stock. "
	   +"Im Westen kannst Du einen Nussbaum entdecken. "
	   +"Ausserdem wurde hier ein kleiner Holzstapel aufgeschichtet.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(({"nussbaum", "baum"}),
	    "Der steht im Westen.\n");
  AddDetail(("westen"),
	    "Da steht ein Nussbaum.\n");
  AddDetail(("teil"),
	    "Du stehst hier in einem Teil des riesigen Gartens.\n");
  AddDetail(({"garten", "gartens"}),
	    "Der ist ziemlich gross. Schau Dich einfach ein bisschen darin um.\n");
  AddDetail(("boden"),
	    "Du stehst auf einem ueberaus gut gepflegten Rasen.\n");
  AddDetail(("rasen"),
	    "Der ist wirklich in einem traumhaften Zustand.\n");
  AddDetail(("zustand"),
	    "Der Zustand des Rasens ist wirklich traumhaft.\n");
  AddDetail(("himmel"),
	    "Der Himmel ist strahlend blau und die Sonne strahlt Dir aus ihm entgegen.\n");
  AddDetail(("sonne"),
	    "Die Sonne strahlt Dir froehlich aus dem Himmel entgegen.\n");
  AddDetail(("nordwesten"),
	    "Da ist ein kleiner Schuppen.\n");
  AddDetail(("sueden"),
	    "Da befindet sich das Soundmagierhaus.\n");
  AddDetail(({"haus", "soundmagierhaus"}),
	    "Das Haus ist etwas eigenartig konstruiert.\n"
	    +"Wenn Du es nicht mit eigenen Augen sehen wuerdest, "
	    +"wuerdest Du wahrscheinlich nicht glauben das man so ein Haus "
	    +"ueberhaupt bauen kann. Gewoehnlicherweise muesste so eine "
	    +"Konstruktion sofort in sich zusammenbrechen, aber das silberne "
	    +"Schimmern an den Waenden verraet Dir, dass hier Magie am Werke "
	    +"ist.\n");
  AddDetail(("augen"),
	    "Du hast welche, oder?\n");
  AddDetail(("konstruktion"),
	    "Die ist wirklich sehr gewagt.\n");
  AddDetail(("schimmern"),
	    "Das Schimmern duerfte durch Magie hervorgerufen werden.\n");
  AddDetail(({"waende", "waenden"}),
	    "An den Waenden siehst Du ein silbernes Schimmern.\n");
  AddDetail(("magie"),
	    "Die ist hier so intensiv, dass man sie sogar fuehlen kann.\n");
  AddDetail(({"werk", "werke"}),
	    "Hier ist eindeutig Magie am Werk.\n");
  AddDetail(("fenster"),
	    "Im ersten Stock kannst Du einige wenige entdecken. "
	    +"Es ist schon seltsam, dass im Erdgeschoss ueberhaupt keine "
	    +"sind. Das muss ja sehr dunkel da drinnen sein.");
  AddDetail(("erdgeschoss"),
	    "Seltsamerweise siehst Du keine Fenster im Erdgeschoss.\n");
  AddDetail(({"stock", "ersten stock", "erster stock"}),
	    "Wenigstens im ersten Stock sind einige wenige Fenster.\n");
  AddDetail(({"schuppen", "holzschuppen"}),
	    "Ein schaebiger Holzschuppen, der irgendwie nicht zu dem sonst so schoenen "
	    +"Garten passt.\n");
  AddDetail(({"stapel", "holzstapel"}),
	    "Da sind einige Holzscheite aufeinander gestapelt.\n");
  AddDetail(({"holzscheite", "scheite", "holzscheit", "scheit"}),
	    "Normale Holzscheite wie sie halt zum Heizen verwendet werden. Vielleicht "
	    +"solltest Du einen davon mitnehmen. Wer weiss, zu was man so einen noch "
	    +"gebrauchen kann.\n");
  AddDetail(("ruhe"),
	    "Du bist jetzt die Ruhe selbst.\n");
  AddDetail(("gefuehl"),
	    "Ein sehr schoenes und erhebendes Gefuehl.\n");
  AddSound( DEFAULT_SOUND,
	    "Du kannst nichts aufregendes hoeren.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts besonderes.\n");
  // DETAILS END;
  
  // EXITS START;
  AddExit ("westen", ROOM("garten9"));
  AddExit ("norden", ROOM("garten7"));
  AddExit ("nordosten", ROOM("garten6"));
  AddExit ("schuppen",([EX_DEST :  ROOM("schuppen"),
		       EX_MSG : "in den Schuppen"]));
  // EXITS END;
  
  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  AddCmd(("nimm"), "nimm_was");
  
  // ITEMS START;
  // ITEMS END;
  
}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Du setzt Dich in Ruhe hin und lasst die Magie auf Dich "
	    +"einwirken. Das ist ein schoenes, erhebendes Gefuehl.\n"));
      return 1;
    }
  else return 0;
}

nimm_was(str)
{
  object ob;
  notify_fail("Was willst Du nehmen?\n");
  if ((str == "holzscheite" || str == "scheite" || str == "holzscheite mit" || str == "scheite mit"))
    {
      write (BS("Also uebertreib mal nicht. Nimm erst mal nur einen Holzscheit.\n"));
      return 1;
    }
  if ((str == "holzscheit" || str == "scheit" || str == "holzscheit mit" || str == "scheit mit"))
    {
      if(!ob=present(("\nsqquestitem"),TP))
	{
	  write (BS("Derzeit brauchst Du keinen Holzscheit. Vielleicht spaeter.\n"));
	  return 1;
	}
      else
	{
	  if (!ob=present(("\nsqholzscheit"),TP))
	    {
	      write (BS("Du nimmst einen Holzscheit von dem Stapel und steckst ihn ein.\n"));
	      say (BS(this_player()->name(WER,2)+" nimmt einen Holzscheit vom Stapel.\n"));
	      CLONE(OBJ("holzscheit"),(TP));
	      return 1;
	    }
	  else 
	    {
	      write (BS("Aber Du hast doch schon einen Holzscheit.\n"));
	      return 1;
	    }
	}
    }
  else return 0;
}




















