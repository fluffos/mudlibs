#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Gemuesegarten");
  SetProp (P_INT_LONG, "Du stehst hier in einem Gemuesegarten.\n"
	   +"Rings um Dich herum sind einige Gemuesebeete in denen "
	   +"allerlei Gemuese angepflanzt wurde. Westlich von Dir "
	   +"verlaeuft der Zaun der den gesamten Garten umschliesst "
	   +"und die Hecke die parallel dazu angepflanzt wurde. Im "
	   +"Osten kannst Du das geheimnisvolle Haus sehen. Ausserdem "
	   +"siehst Du einen Nussbaum im Nordosten.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(("nussbaum"),
	    "Der steht im Nordosten.\n");
  AddDetail(("nordosten"),
	    "Da steht ein Nussbaum.\n");
  AddDetail(("garten"),
	    "Der ist ziemlich gross und zudem noch ausserordentlich "
	    +"gut gepflegt.\n");
  AddDetail(("himmel"),
	    "Aus dem strahlend blauen Himmel lacht Dir die Sonne "
	    +"entgegen.\n");
  AddDetail(("sonne"),
	    "Aus dem Himmel lacht Dir die Sonne entgegen.\n");
  AddDetail(("sonne"),
	    "Sie lacht Dir freudestrahlend aus dem Himmel entgegen.\n");
  AddDetail(("boden"),
	    "Zwischen den verschiedenen Beeten fuehrt da ein kleiner "
	    +"Weg hindurch.\n");
  AddDetail(({"erde", "humus"}),
	    "In den Beeten scheint eine sehr naehrstoffreiche Erde (auch als Humus "
	    +"bekannt) zu sein.\n");  
  AddDetail(("weg"),
	    "Der Weg besteht aus grossen flachen Steinen die einfach auf "
	    +"das Gras gelegt wurden.\n");
  AddDetail(({"steine", "stein"}),
	    "Es sind grosse flache Steine.\n");
  AddDetail(("gras"),
	    "Zwischen den Steinen kannst Du das gruene Gras erkennen.\n");
  AddDetail(("holz"),
	    "Der Holzzaun ist aus Holz.\n");
  AddDetail(({"zaun", "holzzaun"}),
	    "Ein einfacher weisser Holzzaun.\n");
  AddDetail(("hecke"),
	    "Die Hecke verlaeuft parallel zum Zaun und faellt durch "
	    +"ihre silbernen Blaetter auf.\n");
  AddDetail(("blaetter"),
	    "Die sind voellig silbern. Sowas sieht man auch nicht oft.\n");
  AddDetail(("osten"),
	    "Da steht das Soundmagierhaus.\n");
  AddDetail(({"haus", "soundmagierhaus"}),
	    "Es sieht nicht so aus als koennte es ohne Hilfe hier so stehen. "
	    +"Da muss wohl Magie im Spiel sein.\n");
  AddDetail(("hilfe"),
	    "Ohne irgendeine Hilfe wuerde das Haus sicherlich einstuerzen.\n");
  AddDetail(("spiel"),
	    "Hier ist sicher Magie im Spiel.\n");
  AddDetail(("magie"),
	    "Die kann man hier direkt fuehlen.\n");
  AddDetail(({"beete", "gemuesebeete", "beet", "gemuesebeet"}),
	    "In den Gemuesebeeten ist allerlei Gemuese angepflanzt "
	    +"worden.\n");
  AddDetail(("gemuesegarten"),
	    "Du stehst hier in einem.\n");
  AddDetail(("gemuese"),
	    "Du siehst hier etwas Salat, ein bisschen Kohl und einige "
	    +"Tomaten.\n");
  AddDetail(("salat"),
	    "Der ist noch nicht reif. Wenn er reif waere, wuerdest Du "
	    +"dir wahrscheinlich gleich den Salat mit einem Dressing "
	    +"anrichten und verspeisen.\n");
  AddDetail(("dressing"),
	    "Das wuerde gut zum Salat passen.\n");
  AddDetail(("kohl"),
	    "Wenn er reif ware, koennte man eine gute Suppe aus "
	    +"ihm machen.\n");
  AddDetail(("suppe"),
	    "Mit dem Kohl koennte man sicher eine gute Suppe kochen.\n");
  AddDetail(("tomaten"),
	    "Die sind alle schon voellig verfault. Mit denen koennte "
	    +"man aber sicher einigen Humbug anfangen.\n");
  AddDetail(("humbug"),
	    "Man koennte die faulen Tomaten beispielsweise auf irgendjemanden "
	    +"werfen. Das waere sicher lustig. Vielleicht solltest Du doch "
	    +"eine davon pfluecken.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst nichts Interessantes.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Es riecht hier nach Gemuese.\n");
  AddSmell(("tomaten"),
	   "Die riechen aber ordentlich faul.\n");
  AddSmell(({"salat", "kohl"}),
	   "Der riecht nicht schlecht.\n");
  // DETAILS END;
  
  
  // EXITS START;
  AddExit ("nordosten", ROOM("garten9"));
  AddExit ("sueden", ROOM("garten12"));
  AddExit ("suedosten", ROOM("garten11"));
  // EXITS END;
  
  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  AddCmd(({"pfluecke", "pflueck"}), "pfluecke_was");
  
  // ITEMS START;
  // ITEMS END;

}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Die fuehlt sich seltsam an.\n"));
      return 1;
    }
  else return 0;
}

pfluecke_was(str)
{
  object ob;
  notify_fail("Was willst Du pfluecken?\n");
  if ((str == "tomaten" || str == "faule tomaten"))
    {
      write (BS("Nimm vorlaeufig mal nur eine Tomate.\n"));
      return 1;
    }
  if ((str == "tomate" || str == "faule tomaten"))
    {
      if (!ob=present(("\nsqquestitem"),TP))
	{
	  write (BS("Vorlaeufig brauchst Du keine faule Tomate. "
		+"Vielleicht versuchst Du es spaeter noch "
		+"einmal.\n"));
	  return 1;
	}
      else 
	{
	  if (!ob=present(("\nsqtomate"),TP))
	    {
	      write (BS("Du pflueckst eine faule Tomate und "
		    +"steckst sie ein.\n"));
	      say (BS(this_player()->name(WER,2)+" pflueckt eine faule Tomate.\n"));
	      CLONE(OBJ("tomate"),(TP));
	      return 1;
	    }
	  else 
	    {
	      write (BS("Aber Du hast doch schon eine faule Tomate.\n"));
	      return 1;
	    }
	}
    }
  else return 0;
}















