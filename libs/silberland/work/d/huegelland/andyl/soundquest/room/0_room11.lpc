#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Der Kellereingang");
  SetProp (P_INT_LONG, "Hier duerfte der Eingang zum Keller des Hauses sein.\n"
	   +"Im Westen siehst Du eine einfache Holztuer. "
	   +"Am Raum selber kannst Du nichts besonderes entdecken. "
	   +"Die Waende sind aus Stein, genauso die Decke. Der Boden ist aus "
	   +"Buchenholz.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("haus"),
	    "Du stehst gerade darin.\n");
  AddDetail(({"raum", "kellereingang", "eingang"}),
	    "In diesem Raum scheint der Eingang zum Keller zu sein.\n");
  AddDetail(({"keller", "weg"}),
	    "Hinter der Holztuer ist wahrscheinlich der Weg in den Keller.\n");
  AddDetail(({"tuer", "holztuer", "tuere", "holztuere"}),
	    "Die Holztuer ist aus Eichenholz und sieht sehr robust aus. Wie "
	    +"man die wohl aufkriegt?\n");
  AddDetail(("eichenholz"),
	    "Ein sehr robustes Holz.\n");
  AddDetail(("holz"),
	    "Das Eichenholz oder das Buchenholz?\n");
  AddDetail(("buchenholz"),
	    "Ein einfaches aber schoenes Holz.\n");
  AddDetail(("boden"),
	    "Der Boden ist aus Buchenholz und etwas staubig.\n");
  AddDetail(("staub"),
	    "Ganz gewoehnlicher Staub. Hoffentlich bist Du dagegen nicht allergisch.\n");
  AddDetail(("stein"),
	    "Es duerfte sich bei dem Stein um Granit handeln.\n");
  AddDetail(("granit"),
	    "Ein sehr harter Stein.\n");
  AddDetail(({"waende", "wand"}),
	    "Du untersuchst die Waende etwas genauer. Dabei faellt Dir etwas an der Ostwand auf.\n");
  AddDetail(("ostwand"),
	    "Du entdeckst ein kleines Loch ganz unten bei der Wand.\n");
  AddDetail(({"loch", "mauseloch", "rattenloch"}),
	    "Wahrscheinlich ein Mauseloch, vielleicht sogar ein Rattenloch. Da scheint was drinnen zu "
	    +"sein. Du kannst ja vielleicht mal reingreifen.\n");
  AddDetail(({"maus", "maeuse", "ratte", "ratten"}),
	    "Hoffentlich sind keine in dem Loch.\n");
  AddDetail(("decke"),
	    "Die Decke ist aus hartem Granit. Eine kleine Lampe haengt daran.\n");
  AddDetail(("lampe"),
	    "Sie leuchtet leicht roetlich.\n");
  AddDetail(("westen"),
	    "Da ist eine Holztuer.\n");
  // DETAILS END;

  // EXITS START;
  AddExit ("norden", ROOM("0_room2"));
  AddExit ("sueden", ROOM("0_room10"));
  AddSpecialExit (("tuer", "tuer_zu"));
  // EXITS END;

  AddCmd (({"greif", "greife"}), "greife_in");
  AddCmd ("oeffne&tuer|kellertuer|tuere|kellertuere", "cmd_keller");

  // ITEMS START;
  // ITEMS END;

}

private int bardKnowsSongAlready() {
  return TP->QuerySkillAbility("schildsang der walkueren") 
       + TP->QuerySkillAbility("stolze mauer am fluss") 
       + TP->QuerySkillAbility("zwergisches ahnenlied")
       + TP->QuerySkillAbility("ballade vom drachentoeter") > 0;
}

public int cmd_keller() {
  if(!this_player()->QueryQuest("Umpfs Aufgabe")) {
    write(BS("Die Tuer scheint fest verschlossen."));
    return -1;
  }

  if(TP->QueryProp(P_GUILD) != "bardengilde") {
    tell_room(this_object(), break_string("Nur wahre Kuenstler duerfen meinen Keller betreten!", 75, "Die Stimme des Soundmagiers erschallt: "));
    return 1;
  } else if(bardKnowsSongAlready()) {
    write(BS("Du hast die Sammlung des Soundmagiers bereits gepluendert... Da unten ist nichts mehr."));
    return -1;
  }

  write(BS("Federleicht springt die Tuer auf und du verschwindest im Keller."));

  this_player()->move(ROOM("keller1:" + getuid(this_player())), M_TPORT, "durch die Kellertuer", "verschwindet", "kommt durch die Tuer");
  return 1;
}

greife_in (str)
{
  object ob;
  notify_fail("In was willst Du greifen?\n");
  if ((str == "in loch" || str == "loch"))
    if (!ob=present(("\nsqquestitem"),TP))
      {
	write (BS("Probier das spaeter noch einmal.\n"));
	return 1;
      }
    else
      {
	if (!ob=present(("\nsqrattengift"),TP))
	  {
	    write (BS("Du greifst in das Loch und ziehst ein Stueck Rattengift heraus und steckst es ein.\n"));
	    say (BS(TP->name(WER,2)+" greift in das Loch und zieht etwas daraus hervor und steckt es "
		+"sofort ein.\n"));
	    CLONE(OBJ("rgift"),(TP));
	    return 1;
	  }
	else return write (BS("Du brauchst das nicht nochmal machen.\n")),1;
      }
  else return 0;
}







