#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21,ENV_TERRAIN:TT_PLAIN]));
  SetProp (P_INT_SHORT, "Garten");
  SetProp (P_INT_LONG, "Du stehst suedwestlich vom Haus in einem "
	   +"Teil des Gartens. Suedwestlich verlaeuft ein weisser Holzzaun "
	   +"zu dem parallel eine Hecke gepflanzt wurde. Im Suedosten siehst "
	   +"du eine praechtige Eiche und im Nordwesten einen Gemuesegarten. "
	   +"Ein kleines Haeuschen, welches hier steht, faellt Dir besonders "
	   +"auf.\n");
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(("nordwesten"),
	    "Da ist ein Gemuesegarten.\n");
  AddDetail(("gemuesegarten"),
	    "Der befindet sich im Nordwesten.\n");
  AddDetail(({"eiche", "baum"}),
	    "Die praechtige Eiche befindet sich suedoestlich von hier.\n");
  AddDetail(("suedosten"),
	    "Da steht eine praechtige Eiche.\n");
  AddDetail(("himmel"),
	    "Bis auf die Sonne ist da absolut alles blau.\n");
  AddDetail(("teil"),
	    "Du stehst hier in einem Teil des riesigen Gartens.\n");
  AddDetail(("sonne"),
	    "Die Sonne scheint hier angenehm warm herunter.\n");
  AddDetail(("boden"),
	    "Unter Dir ist ein bestens gepflegter Rasen.\n");
  AddDetail(("garten"),
	    "Dir gefaellt der Garten ausgesprochen gut. Der ist so gross "
	    +"und noch dazu ausgezeichnet gepflegt.\n");
  AddDetail(("rasen"),
	    "Der ist wirklich gut gepflegt worden.\n");
  AddDetail(("haus"),
	    "Ein Wunder, dass dieses Haus bei der Bauweise noch nicht eingestuerzt "
	    +"ist.\n");
  AddDetail(("wunder"),
	    "Das Wunder wurde mit Magie vollbracht, die sogar an den Waenden sichtbar ist.\n");
  AddDetail(("bauweise"),
	    "Eine wirklich interessante Bauweise. Du hmmmst.\n");
  AddDetail(({"waenden", "waende"}),
	    "Von den Waenden geht ein Schimmern aus.\n");
  AddDetail(("schimmern"),
	    "Ein silbernes, wahrscheinlich magisches, Schimmern.\n");
  AddDetail(("magie"),
	    "Die ist hier so intensiv, dass man sie fuehlen kann.\n");
  AddDetail(({"zaun", "holzzaun"}),
	    "Ein einfacher weisser Holzzaun.\n");
  AddDetail(("hecke"),
	    "Die Hecke hat komplett silberne Blaetter.\n");
  AddDetail(("blaetter"),
	    "Silberne Blaetter. Sie gefallen Dir sehr gut.\n");
  AddDetail(({"haeuschen", "holzhaeuschen"}),
	    "Ein kleines Holzhaeuschen. Durch den kleinen Eingang an der Vorderseite kannst Du "
	    +"vielleicht in das Haeuschen schauen.\n");
  AddDetail(("vorderseite"),
	    "Da ist ein kleiner Eingang.\n");
  AddDetail(("eingang"),
	    "Du koenntest durch ihn in das Haeuschen schauen.\n");
  AddDetail(("blick"),
	    "Huch, ist Dein Blick aber boese.\n");
  AddDetail(("herz"),
	    "Es ist ja ganz warm.\n");
  AddDetail(("knuddels"),
	    "Die sind ja sooo suess. Da wird einem richtig warm ums Herz.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst ein knuddeliges Geraeusch aus dem Haeuschen.\n");
  AddSound(("geraeusch"),
	   "Es hoert sich allerliebst an.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst nichts besonderes.\n");

  // DETAILS END;

  // EXITS START;
  AddExit ("osten", ROOM("garten15"));
  AddExit ("nordwesten", ROOM("garten13"));
  AddExit ("suedosten", ROOM("garten16"));
  // EXITS END;
  
  AddCmd(({"fuehle", "fuehl"}), "fuehle_was");
  AddCmd(({"schau", "schaue", "blick", "blicke", "guck", "gucke"}), "schau_durch"); 
  
  // ITEMS START;
  AddItem(NPC("knuddel.lpc"), REFRESH_DESTRUCT);
  // ITEMS END;

}

fuehle_was(str)
{
  notify_fail("Was willst Du fuehlen?\n");
  if (str == "magie")
    {
      write (BS("Du fuehlst die Magie und fuehlst Dich fuer einen Moment "
	    +"extrem gut und stark.\n"));
      return 1;
    }
  else return 0;
}

schau_durch(str)
{
  notify_fail("Wodurch willst Du schauen?\n");
  if ((str == "durch eingang" || str=="durch eingang in haeuschen" || str == "in haeuschen"))
    {
      write (BS("Du siehst ein paar kleine Knuddels die sich da herumspielen. "
	    +"Die sehen absolut suess und urknuddelig aus. Dir wird ganz warm ums Herz.\n"));
      return 1;
    }
  else return 0;
}













