#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN: TT_PLAIN]));
  SetProp (P_INT_SHORT, "Ein Weg westlich vom Weinberg");
  SetProp (P_INT_LONG, "Du befindest Dich auf einem Weg der vom Weinberg auf "
	   +"eine Anhoehe im Westen fuehrt, auf der ein seltsames Gebaeude steht. "
	   +"Der Weg selber besteht aus Schotter zwischen dem da und dort "
	   +"noch etwas Gras und ein wenig Unkraut waechst. Von hier aus kannst Du "
	   +"Derlims Weinberg gut ueberblicken. Auch Derlim ist von hier gut zu sehen. "
	   +"Ausserdem hast Du von hier einen prachtvollen Ausblick auf einen Grossteil "
	   +"des Huegellands.\n");
  
  // ROOM DESCRIPTION END;
  
  // DETAILS START;
  AddDetail(({"weg", "schotterweg"}),
	    "Es ist ein einfacher Schotterweg der auf die Anhoehe im Westen fuehrt.\n");
  AddDetail(("boden"),
	    "Unter Dir ist ein Schotterweg auf dem etwas Gras und Unkraut waechst.\n");
  AddDetail(("westen"),
	    "Das ist eine Anhoehe.\n");
  AddDetail(("osten"),
	    "Da ist der Weinberg.\n");
  AddDetail(("schotter"),
	    "Ganz gewoehnlicher Schotter.\n");
  AddDetail(({"weinberg", "berg"}),
	    "Du kannst ihn im Osten erblicken. Hobbits stellen ihren Wein " 
	    +"naemlich dort selber her.\n");
  AddDetail(("wein"),
	    "Den produzieren die Hobbits auf dem Weinberg.\n");
  AddDetail(({"derlim", "heimatstadt", "stadt"}),
	    "Derlim ist die Heimatstadt der Hobbits. Sie besteht hauptsaechlich "
	    +"aus Huegeln da Hobbits ihre Wohnungen am liebsten ihn Huegel einbauen. "
	    +"Derlim liegt von hier aus im Nordosten.\n");
  AddDetail(("nordosten"),
	    "Da ist Derlim.\n");
  AddDetail(({"hobbit", "hobbits", "gegend", "hause"}),
	    "Hobbits wirst Du in der Gegend sicher einige finden, da sie ja "
	    +"hier im Huegelland zu Hause sind.\n");
  AddDetail(({"huegelland", "land", "ursprungsland", "grossteil"}),
	    "Du befindest Dich hier im Huegelland, dem Ursprungsland der "
	    +"Hobbits. Du kannst von hier aus einen Grossteil des Huegellands ueberblicken. " 
	    +"Hier kannst Du ueberraschenderweise sehr viele Huegel sehen.\n");
  AddDetail(("gebaeude"),
	    "Es ist ein seltsam anmutendes Gebaeude. Da gibt es sicher einiges zu "
	    "entdecken.\n");
  AddDetail(("anhoehe"),
	    "Auf der Anhoehe steht ein seltsames Gebaeude.\n");
  AddDetail(({"gras", "unkraut"}),
	    "Das waechst da auf dem Weg zwischen dem Schotter.\n");
  AddDetail(("ausblick"),
	    "Von hier aus hast Du einen hervorragenden Ausblick auf das Huegelland.\n");
  AddDetail(("himmel"),
	    "Vom Himmel strahlt die Sonne angenehm auf Dich herunter.\n");
  AddDetail(("sonne"),
	    "Die Sonne strahlt angenehm auf Dich herunter.\n");
  AddDetail(({"weintrauben", "trauben"}),
	    "Die gibt es drueben am Weinberg.\n");
  AddSmell(({"trauben", "weintrauben"}),
	   "Der Geruch von suessen Weintrauben kommt von dem Weinberg.\n");
  AddDetail(({"kleinzeug", "ernte", "weinernte"}),
	    "Das Kleinzeug auf dem Weinberg ist nicht gut fuer die Weinernte.\n");
  AddDetail(({"huegel", "huegeln"}),
	    "Du siehst hier ziemlich viele Huegel. Einige davon sind sicher die "
	    +"Wohnungen von Hobbits.\n");
  AddDetail(({"wohnungen", "wohnung", "ansammlung"}),
	    "Hobbits bevorzugen es ihre Wohnungen in Huegel einzubauen. Deswegen "
	    +"sieht Derlim auch wie eine Ansammlung vieler Huegel aus.\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerst Geraeusche welche das Kleinzeug am Weinberg produziert.\n");
  AddSound(("geraeusche"),
	   "Du hoerst Geraeusche welche das Kleinzeug am Weinberg produziert.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst den Geruch von Weintrauben.\n");
  // DETAILS END;
  
  //COMMANDS;
  //COMMANDS END;
  
  // EXITS START;
  AddExit("osten", "/d/huegelland/raballion/weinberg/room/apark4.lpc");
  AddExit("westen", ROOM("vorgarten"));
  // EXITS END;
  
  // ITEMS START;
  // ITEMS END;
}



















