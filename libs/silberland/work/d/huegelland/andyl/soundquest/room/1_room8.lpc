#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

#define TISCH(wer) (member(tisch, getuid(wer))!=-1)
string *tisch=({});

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Ein Kristallraum");
  SetProp (P_INT_LONG, "Dieser Raum scheint pur aus Kristall zu bestehen.\n"
	   +"Der grosse Tisch in der Mitte des Raumes laesst darauf schliessen, dass hier "
	   +"moeglicherweise das Esszimmer ist. Alles strahlt und funkelt hier. "
	   +"Staub oder sonstiger Schmutz sind nirgendwo zu sehen. "
	   +"Das Licht welches durch die Kristallwaende scheint wird ueberall gespiegelt, "
	   +"was den Raum ziemlich hell macht.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(("boden"),
	    "Der Boden ist aus reinstem Kristall und strahlend sauber.\n");
  AddDetail(({"waende", "kristallwaende", "wand"}),
	    "Die Waende sind voellig aus Kristall. Absolut glatt und absolut sauber.\n");
  AddDetail(("decke"),
	    "Die Decke ist komplett aus Kristall. An der Decke haengt ausserdem ein "
	    +"kristallener Kronleuchter.\n");
  AddDetail(({"staub","schmutz","spur"}),
	    "Du kannst keine Spur von Staub oder Schmutz entdecken.\n");
  AddDetail(("licht"),
	    "Das Licht spiegelt sich hier an allen Ecken und Enden wieder, wodurch "
	    "der Raum extrem hell wird.\n");
  AddDetail(({"ecken","enden"}),
	    "Alle Ecken und Enden sind natuerlich aus Kristall.\n");
  AddDetail(({"kristall","weise"}),
	    "Das Kristall hier ist durchsichtig und in keinster Weise verunreinigt.\n");
  AddDetail(({"raum", "kristallraum"}),
	    "Das hier ist der Kristallraum.\n");
  AddDetail(({"esszimmer","zimmer", "hinweis"}),
	    "Der grosse Tisch koennte ein Hinweis darauf sein, dass hier das Esszimmer ist.\n");
  AddDetail(("sessel"),
	    "Auch die Sessel sind zu 100% aus Kristall. Sie bieten Platz "
	    +"fuer Gaeste die zu Besuch kommen.\n");  
  AddDetail(("gaeste"),
	    "Sind leider keine hier.\n");
  AddDetail(("platz"),
	    "Die Sessel bieten Platz fuer Gaeste.\n");
  AddDetail(("besuch"),
	    "Keiner da, wie es aussieht.\n");
  AddDetail(({"kronleuchter","kunstwerk", "leuchter"}),
	    "Der Kronleuchter ist ein wahres Kunstwerk aus verschiedensten Kristallteilchen. "
	    +"Er ist an der Decke an einer Aufhaengung befestigt.\n");
  AddDetail(("kristallteilchen"),
	    "Die Kristallteilchen haben alle moeglichen Formen.\n");
  AddDetail(({"formen","gebilden", "gebilde"}),
	    "Die Formen belaufen sich von rund, quaderfoermig, zylindrisch bis zu komplizierten "
	    +"laenglichen Gebilden.");
  AddDetail(("aufhaengung"),
	    "Die Aufhaengung scheint nicht wirklich gut befestigt zu sein. Vielleicht kann man sie "
	    +"irgendwie lockern.\n");
  AddSpecialDetail(({"tisch" , "mitte"}), "schau_tisch");
  AddSound( DEFAULT_SOUND,
	    "Es ist absolut still hier.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du kannst nichts besonderes riechen.\n");
  // DETAILS END;
  
  // EXITS START;
  AddSpecialExit (("osten"), "auszimmerosten");
  AddSpecialExit (("suedwesten"), "auszimmersuedwesten");
  // EXITS END;
  
  AddCmd(({"lockere", "locker"}), "locker_was");
  AddCmd(({"steige", "steig"}), "steige_auf");
  AddCmd(({"schlage", "schlag"}), "schlage_weg");
  AddCmd(({"setz", "setze", "sitz"}), "setze_auf");

  // ITEMS START;
  // ITEMS END;
  
}		  

setze_auf (str)
{
  notify_fail("Auf was willst Du Dich setzen?\n");
  if (str == "auf sessel")
    {
      write(BS("Obwohl der Sessel aus Kristall ist, ist er ausgesprochen bequem. "
	       +"Du wuerdest hier gerne noch etwas laenger sitzenbleiben, doch "
	       +"leider musst Du ja noch etwas erledigen. Seufzend erhebst Du Dich "
	       +"wieder.\n"));
      say(BS(TP->name(WER,0)+" setzt sich in einen Sessel steht aber kurz darauf wieder "
	     +"seufzend davon auf.\n"));
      return 1;
    }
  else return 0;
}


locker_was (str)
{
  notify_fail ("Was willst Du lockern?\n");  
  if (str == "aufhaengung") 
    {
      if (!TISCH(TP))
	return write (BS("Du kommst von hier nicht ran! Vielleicht "
		      +"solltest Du irgendwo raufsteigen.\n")), 1;
      else
	{
	  return write (BS("Du kannst die Aufhaengung nicht so einfach lockern.\n"
			+"Vielleicht schlaegst Du mal auf sie.\n")), 1;
	}
    }
  else return 0;
}

schlage_weg (str)
{
  object ob;
  notify_fail ("Auf was willst Du schlagen?\n");  
  if ((str == "aufhaengung" || str =="auf aufhaengung")) 
   {
     if (!TISCH(TP))
       return write (BS("Du kommst von hier nicht ran. Vielleicht "
		     +"solltest Du irgendwo raufsteigen.\n")), 1;
     else
       {
	 if (!ob=present(("\nsqkristallhebel"),TP))      
	   {
	     write (BS("Du schlaegst einmal fest auf die Aufhaengung worauf der Kronleuchter "
		    +"zu schwanken beginnt und ein Kristallteilchen wegbricht. "
		    +"Du reagierst schnell und faengst es auf bevor es auf den Boden auftrifft "
		    +"und steckst es sofort ein.\n"));
	     say (BS(TP->name(WER,2)+" schlaegt auf die Aufhaengung des Kronleuchters worauf "
		  +"ein Kristallteilchen wegbricht welches "+TP->name(WER,2)+" auffaengt und "
		  +"einsteckt.\n"));
	     CLONE(OBJ("khebel.lpc"),(TP));
	     return 1;
	   }
	 else 
	   {
	     write (BS("Du musst das nicht nochmal machen. Also lass es sein.\n"));
	     return 1;
	   }
       }
   }   
  else return 0;  
}

int steige_auf(string str)
{
  notify_fail("Worauf moechtest Du steigen? Oder moechtest "
	      +"du runtersteigen?\n");
  if (!str) return 0;
  if (str == "auf tisch")
    {
      if (TISCH(TP))
	{
	  write (BS("Aber Du stehst doch schon am Tisch!\n"));
	  return 1;
	}
      if( sizeof(tisch)>=1 )
	{
	  write (BS("Auf dem Tisch steht schon jemand.\n"));
	  return 1;
	}
      write (BS("Du steigst auf den Tisch.\n"));
      say (BS(CAP(TPN)+" steigt auf den Tisch.\n"));
      tisch += ({ getuid(TP) });
      return 1; 
    }
  if (str == "herunter" || str== "runter" || str=="von tisch")
    {
      if(!TISCH(TP) )
	return write (BS("Aber Du bist doch schon herunten!\n")), 0;
      if( TISCH(TP) )
	{
	  write (BS("Du steigst von dem Tisch herunter.\n"));
	  say (BS(CAP(TPN)+" steigt vom Tisch herunter.\n"));
	  tisch -= ({ getuid(TP) });
	  return 1;
	}
    }      
  else 0;
}

void BecomesNetDead(object spieler)
{
  if (TISCH(spieler))
    tisch -= ({ getuid(spieler) });
}

int auszimmerosten()
{
  if( TISCH(TP))
    return notify_fail ("Dazu solltest Du erstmal runtersteigen!\n"), 0;
  TP->move(ROOM("1_room2"), M_GO, "nach osten");
  return 1;
}

int auszimmersuedwesten()
{
  if (TISCH(TP))
    return notify_fail ("Dazu solltest Du erstmal runtersteigen!\n"), 0;
  TP->move(ROOM("1_room7.lpc"), M_GO, "nach suedwesten");
  return 1;
} 

schau_tisch()
{

  string str;
  str = "Der Tisch in der Mitte des Raumes ist vollstaendig aus Kristall.\nUm ihn herum stehen einige Sessel.\n"; 
  if (!sizeof(tisch)) return (BS(str));
  else
   (BS(str+= CAP(tisch[0])+" steht am Tisch.\n"));   
  return (BS(str));
}



























