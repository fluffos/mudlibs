** Last updated: 1998-03-05
*/

#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION;
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN:TT_HOUSE]));
  SetProp (P_INT_SHORT, "Der Raum der Klaenge");
  SetProp (P_INT_LONG, "Dieser Raum ist sehr schlicht gebaut.\n"
	   +"Die Waende und die Decke wie auch der Boden sind aus weissem Stein. "
	   +"An einer Wand haengt eine Fackel. " 
	   +"Aber Du hoerst hier ueberall Klaenge und Geraeusche.\n"
	   +"Man scheint hier besonders aufmerksam lauschen zu muessen.\n");
  // ROOM DESCRIPTION END;

  // DETAILS START;
  AddDetail(({"raum", "vielfalt"}),
	    "Dieser Raum wird von einer Vielfalt von Klaengen und Geraeuschen durchdrungen.\n");
  AddDetail(("boden"),
	    "Der Boden ist aus weissem Stein.\n");
  AddDetail(("waende"),
	    "Die sind aus weissem Stein.\n");
  AddDetail(("wand"),
	    "Da haengt eine Fackel.\n");
  AddDetail(("decke"),
	    "Die Decke ist aus weissem Stein.\n");
  AddDetail(({"stein", "weissen stein"}),
	    "Der Stein hier ist ganz weiss.\n");
  AddDetail(({"fackel"}),
	    "Ohne die waere es hier ziemlich finster.\n");
  AddDetail(({"klaenge", "geraeusche"}),
	    "Du kannst ihnen ja mal lauschen.\n");
  AddSound(DEFAULT_SOUND,
	   "Du hoerst verschiedene Geraeusche und Klaenge.\n");
  AddSound(({"geraeusche", "geraeuschen"}),
	   "Du hoerst ein Brummen, ein Knacksen, ein Wimmern, ein Tuscheln und "
	   +"ein Kreischen.\n");
  AddSound(({"klaenge", "klaengen"}),
	   "Du hoerst hohe Klaenge, tiefe Klaenge, angenehme Klaenge und "
	   +"unangenehme Klaenge, und einen Gong.\n"); 
  AddSound(("brummen"),
	   "Du hoerst ein lautes: GRRRRRROOOOOOOOAAAAAAARRRRRRRRR!\n");
  AddSound(("knacksen"),
	   "Du hoerst es ploetzlich nicht mehr, aber Du koenntest schwoeren, dass da "
	   "vorher noch ein Knacksen war.\n");
  AddSound(("wimmern"),
	   "Das kommt sicher von Umpf. Der sollte anstatt herumzuwimmern "
	   +"lieber was vernuenftiges tun.\n");
  AddDetail(({"gehilfe", "gehilfen"}),
	    "Der jammert gerade woanders herum.\n");
  AddSound(("kreischen"),
	   "Du hoerst: NEIN, NICHT ARGGGGGGGGGGGHHHHHHHHHHHHHH!!!\n");
  AddSound(("tuscheln"),
	    "Da tuschelt eine sanfte Stimme irgendwas.\n");
  AddSound(({"stimme", "stimmen"}),
	   "Welche meinst Du denn?\n");
  AddSound(({"sanfte stimme", "sanfter stimme"}),
	   "Die sanfte Stimme fluestert: Ein Trank kann den Kobold laehmen!\n");
  AddSound(({"hohe klaenge", "hohen klaengen"}),
	   "Du hoerst einen Ton heraus, der mindestens ein C7 ist.\n");
  AddSound(("ton"),
	   "Der Ton ist extrem hoch. Puh, der wirkt ganz schoen auf die Gehoergaenge.\n");
  AddDetail(("gehoergaenge"),
	    "Irgendwie dreht sich da jetzt alles.\n");
  AddSound(({"tiefe klaenge", "tiefen klaengen"}),
	    "Das hoert sich an wie als mehrere Tubas spielen.\n");
  AddSound(({"tubas", "tuba"}),
	   "Du hoerst: UMPDATA, UMPDATA!\n");
  AddDetail(({"tubas", "tuba"}),
	    "Du siehst keine kannst ihnen aber lauschen.\n");
  AddSound(({"unangenehme klaenge", "unangenehmen klaengen"}),
	   "Huch, das hoert sich ja an wie eine Kombination von Avantgarde und "
	   +"Volksmusik.\n");
  AddSound(({"volksmusik", "kombination", "avantgarde"}),
	   "Da zuhoeren ist reiner Masochismus.\n"); 
  AddSound(({"angenehme klaenge", "angenehmen klaengen"}),
	   "Ahh, die wirken entspannend. Eine besonders angenehme Stimme hebt sich "
	   +"aus den Klaengen hervor.\n");
  AddSound(({"angenehme stimme", "angenehmer stimme", "besonders angenehmer stimme", 
	       "besonders angenehme stimme"}),
	   "Sie saeuselt Dir ins Ohr: Der Pistill ist im Schuppen!\n");
  AddDetail(("ohr"),
	    "Solltest Du Dir aber wirklich mal waschen.\n");
  AddSound(("gong"),
	   "Der Gong enthaelt ein interessantes Nebengeraeusch.\n");
  AddSound(("nebengeraeusch"),
	   "Es enthaelt eine Botschaft.\n");
  AddSound(("botschaft"),
	   "In der Bibliothek findest Du etwas sehr wichtiges!\n");
  // DETAILS END;
  
  // EXITS START;
  AddExit ("norden", ROOM("0_room10"));
  AddExit ("nordwesten", ROOM("0_room8"));
  // EXITS END;

  // ITEMS START;
  // ITEMS END;

}


























