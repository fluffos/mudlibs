#include <properties.h>
#include <moving.h>
#include "../files.h"

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21, ENV_TERRAIN: TT_PLAIN]));
  SetProp (P_INT_SHORT, "Ein Vorgarten");
  SetProp (P_INT_LONG, "Du stehst in einem kleinen Vorgarten.\n"
	   +"Ein kleiner Torbogen mit einem kleinen Gartentor dient als Eingang in "
	   +"den eigentlichen Garten. Im Westen befindet sich das dazugehoerige Haus, "
	   +"welches ziemlich gross zu sein scheint. Der Garten ist von einem "
	   +"einfachen Holzzaun umgeben zu dem zusaetzlich eine Hecke gepflanzt wurde. "
	   +"Im Osten fuehrt ein Weg zu dem Weinberg von Derlim.\n");
  
  // ROOM DESCRIPTION END
  
  // DETAILS START
  AddDetail(("vorgarten"),
	    "Du stehst hier in einem huebschen Vorgarten.\n");
  AddDetail(({"weinberg", "berg"}),
	    "Ueber den Weg im Osten kommst Du zu dem Weinberg.\n");
  AddDetail(("osten"),
	    "Im Osten fuehrt ein Weg zum Weinberg von Derlim.\n");
  AddDetail(({"derlim","nordosten"}),
	    "Du kannst Derlim im Nordosten erkennen.\n");
  AddDetail(("weg"),
	    "Es ist ein einfacher Schotterweg der nach Osten fuehrt.\n");
  AddDetail(("schotterweg"),
	    "Ein Weg aus gewoehnlichem Schotter.\n");
  AddDetail(("schotter"),
	    "Ganz gewoehnlicher Schotter.\n");
  AddDetail(("eingang"),
	    "Der fuehrt in den grossen Garten.\n");
  AddDetail(({"torbogen", "bogen"}),
	    "Ein weisser Torbogen aus Holz.\n");
  AddDetail(("garten"),
	    "Der sieht ganz schoen gross aus.\n");
  AddDetail(("hecke"),
	    "Die Hecke hat silberne Blaetter. Du kannst Dich nicht erinnern sowas schon "
	    +"einmal vorher gesehen zu haben.\n");
  AddDetail(("blaetter"),
	    "Die haben eine silberne Farbe.\n");
  AddDetail(("farbe"),
	    "Die ist silbern.\n");
  AddDetail(({"haus", "hauses"}),
	    "Das Haus vor Dir ist ziemlich gross und besitzt eine eigenartige Form.\n");
  AddDetail(({"form", "gebaeude"}),
	    "Die Form des Hauses ist wahrlich seltsam.\n"
	    +"Bei der Form muesste jedes normale Gebaeude einstuerzen. Wahrscheinlich "
	    +"ist da Magie im Spiel.\n");  
  AddDetail(("magie"),
	    "Du kannst die Magie die dieses Gebaeude ausstrahlt, beinahe fuehlen.\n");
  AddDetail(("wohnort"),
	    "Dem Schild zufolge, duerfte das Gebaeude im Westen der Wohnort eines Soundmagiers sein.\n");
  AddDetail(("westen"),
	    "Da steht ein Gebaeude.\n");
  AddDetail(({"spiel", "rolle"}),
	    "In diesem Spiel spielt Magie eine wichtige Rolle.\n");
  AddDetail(("boden"),
	    "Ueberall aus dem Boden spriessen Graeser und da und dort entdeckst Du Blumen.\n");
  AddDetail(({"graeser", "gras"}),
	    "Graeser sind hier in einer verblueffenden Anzahl vorhanden.\n");
  AddDetail(({"anzahl", "unmenge"}),
	    "Eine wahre Unmenge an Graesern.\n");
  AddDetail(("blumen"),
	    "Ein paar Blumen sind inmitten der riesigen Anzahl von Graesern.\n");
  AddDetail(({"zaun","holzzaun"}),
	    "Ein einfacher Holzzaun aus Eichenholz.\n" 
	    +"An ihm kannst Du ein kleines Schild entdecken.\n");
  AddDetail(({"eichenholz", "holz"}),
	    "Solides Eichenholz.\n");
  AddDetail(("schild"),
	    "Du kannst es lesen.\n");
  AddReadDetail(("schild"),
		"Hier ist das bescheidene Domizil eines Soundmagiers. "
		+"Tritt ein, Fremder, und sei willkommen!\n");
  AddDetail(("domizil"),
	    "So bescheiden sieht das aber nicht aus.\n");
  AddDetail(({"fremder", "fremden"}),
	    "Also Du siehst hier keinen Fremden.\n");
  AddDetail(({"soundmagier", "soundmagiers"}),
	    "Vielleicht ist in dem Haus einer?\n");
  AddDetail(("himmel"),
	    "Der Himmel hier ist schoen blau. Die Sonne scheint Dir angenehm auf die Haut und " 
	    "kein Woelkchen ist zu sehen. Auch die Temperatur ist ideal.\n");
  AddDetail(("sonne"),
	    "Sie scheint Dir angenehm auf die Haut.\n");
  AddDetail(("haut"),
	    "Sie sieht sehr gut aus.\n");
  AddDetail(({"wolken", "woelkchen"}),
	    "Du kannst gluecklicherweise keine entdecken.\n");
  AddDetail(("temperatur"),
	    "Sie ist genau richtig.\n");
  AddDetail(("insekten"),
	    "Die bewegen sich zwischen den Graesern.\n");
  AddDetail(("zusammenspiel"),
	    "Du kannst ihm ja mal lauschen.\n");
  AddSound(("zusammenspiel"),
	   "Es wirkt irgendwie sehr beruhigend auf dich.\n");
  AddDetail(("blumen"),
	    "Du siehst nur ein paar Maerzenbecher.\n");
  AddDetail(({"maerzenbecher", "becher"}),
	    "Die haben wunderschoene gelbe Blueten.\n");
  AddDetail(("blueten"),
	    "Die sehen wunderschoen aus.\n");
  AddDetail(("zufriedenheit"),
	    "Zufriedenheit ist schon etwas Schoenes, oder?\n");
  AddSound( DEFAULT_SOUND,
	    "Du hoerste das melodische Zusammenspiel von Insekten.\n");
  AddSound(({"insekten", "insekt"}),
	   "Du lauscht ihrem melodischem Zusammenspiel.\n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
	    "Du riechst den Geruch saftiger Graeser und Blumen.\n");
  AddSmell(({"gras", "graeser"}),
	   "Das Gras riecht frisch und saftig.\n");
  AddSmell(({"blumen", "blume"}),
	   "Die Blumen verstroemen einen hoechst angenehmen Geruch.\n");
  // DETAILS END
  
  //COMMANDS
  AddCmd (({"fuehle", "fuehl"}), "fuehle_was");
  //COMMANDS END
  
  // EXITS START
  AddExit("osten", ROOM("weg"));
  NewDoor ("westen", ROOM("garten1"),
	   ({"gartentor", "tor"}),
	   ({
	     D_LONG, "Ein einfaches kleines Gartentor.\n",
	       D_GENDER, NEUTER,
	       D_SHORT, "Ein %ses Gartentor.",
	       D_NAME, "Gartentor",
	       D_MSGS, "in den Garten des Soundmagiers",
	       }) );
}

// EXITS END

// ITEMS START
// ITEMS END


fuehle_was ( str )
{
  notify_fail("Was willst Du fuehlen?\n");
  if ((str == "magie"))
    {
      write (BS("Die Magie die Du fuehlst erfuellt Dich mit innerer Zufriedenheit."
	    " Du merkst schon das Dir dieser Ort durchaus gefallen kann.\n"));
      return 1;
    }
  return 0;
}




















