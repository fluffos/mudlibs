inherit "std/weapon";

#include <properties.h>
#include <combat.h>         
#include <language.h>     
#include "../files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"stachel", "hornissenstachel"}));
  SetProp (P_SHORT, "Ein Hornissenstachel");
  SetProp (P_LONG, "Dieser Hornissenstachel hat einst einer "
	   +"Hornissenkoenigin gehoert. Die Spitze des Stachels "
	   +"ist extrem spitz. Zudem ist der ganze Stachel so scharf "
	   +"wie ein Messer. Das ist sicher eine recht brauchbare Waffe.\n");
  SetProp (P_NAME, "Hornissenstachel");
  SetProp (P_GENDER, MALE);
  
  SetProp (P_VALUE, 400);
  SetProp (P_WEIGHT, 600);
  SetProp (P_WEAPON_TYPE, WT_KNIFE);
  SetProp (P_DAM_TYPE, DT_PIERCE);
  SetProp (P_WC, 80);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_CHITIN);

  AddDetail(("spitze"),
	    "Die Spitze des Stachels koennte man vielleicht abbrechen.\n");
  AddCmd(({"breche", "brich"}), "breche_ab"); 

}

breche_ab(str)
{
  int max, wht, x;
  notify_fail("Was willst du abbrechen?\n");
  if ((str == "spitze ab" || str == "stachelspitze ab" || 
       str == "hornissenstachelspitze ab"))
    {
      write("Du brichst die Spitze des Hornissenstachels ab. "
	    +"Der Rest des Stachels ist damit nicht mehr zu gebrauchen "
	    +"und du wirfst ihn weg.\n");
      max=0;
      wht=0;
      x=0;      
      max=(TP->QueryProp(P_MAX_WEIGHT));
      wht=(TP->query_weight_contents());
      x=max-wht;
      
      if (x>151)
	{
	  CLONE(OBJ("hspitze"),(TP));
	}      
      else
	{
	  CLONE(OBJ("hspitze"), (ENV(TP)));
	}
      TO->remove();
      return 1;
    }
  else return 0;
}














