inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
if (!is_clone(this_object())) return; 

::create();

 AddId(({"kresse", "\nsqkresse"}));
 SetProp(P_SHORT, "Kresse");
 SetProp(P_LONG, "Ein wenig Kresse.\n"
	 +"Damit kann man sicher irgendetwas Essbares zusaetzlich "
	 +"verfeinern.\n");
 SetProp(P_NAME, "Kresse");
 SetProp(P_GENDER, FEMALE);
 SetProp(P_NOSELL, 1);
 SetProp(P_NOBUY, 1);
 SetProp(P_NODROP, 1);
 SetProp(P_NEVERDROP, 1);
 SetProp(P_WEIGHT, 20);
 
}

