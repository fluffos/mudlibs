inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
if (!is_clone(this_object())) return; 

::create();

AddId(({"\nsqmelodie"}));
SetProp(P_SHORT, 0);
SetProp(P_NAME, "Melodie");
SetProp(P_GENDER, FEMALE);
SetProp(P_NOSELL, 1);
SetProp(P_NOBUY, 1);
SetProp(P_NODROP, 1);
SetProp(P_WEIGHT, 0);
SetProp(P_NEVERDROP, 1);
SetProp(P_VALUE, 0);

}

move(dest,meth) 
{
  mixed res;
  while (remove_call_out("try_remove")!=-1) ;
  res=::move(dest,meth);
  if (!environment() || !living(environment()))
    call_out("try_remove",30);
  return res;
}

try_remove() {
  if (!environment() || !living(environment())) 
    {
      remove();
    }
}




