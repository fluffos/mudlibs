inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
if (!is_clone(this_object())) return; 

 ::create();

 AddId(("\nsqrattengift"));
 AddId(("rattengift"));
 AddId(("gift"));
 SetProp(P_SHORT, "Rattengift");
 SetProp(P_LONG, "Mit dem Rattengift kann man sich "
	 +"schnell und einfach stoerender Ratten entledigen.\n");
 SetProp(P_NAME, "Rattengift");
 SetProp(P_GENDER, NEUTER);
 SetProp(P_NOSELL, 1);
 SetProp(P_NOBUY, 1);
 SetProp(P_NEVERDROP, 1);
 SetProp(P_NODROP, 1);
 SetProp(P_WEIGHT, 20);
 
}





