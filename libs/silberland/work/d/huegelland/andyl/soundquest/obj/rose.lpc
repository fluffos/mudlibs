inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"
void create()
{
  if (!is_clone(this_object())) return; 

  ::create();
  
  AddId(({"rose", "\nsqrose"}));
  SetProp(P_SHORT, "Eine Rose");
  SetProp(P_LONG, "Eine schoene weisse Rose.\n"
	  +"Die Rose hat eine wunderschoene weisse Bluete. "
	  +"Du gehst besser sorgfaeltig mit der Rose um sonst "
	  +"reisst du ihr noch die Bluete aus.\n");
  SetProp(P_NAME, "Rose");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 30);
  SetProp(P_SMELL, "Die Rose duftet herrlich.\n");
  AddCmd(({"reisse", "reiss"}), "reisse_aus");

}

reisse_aus(str)
{
  int max, wht, x;
  object wasp;
  notify_fail("Was willst du ausreissen?\n");
  if ((str == "rosenbluete aus" || str == "bluete aus"))
    {
      write (BS("Du reisst die Bluete der Rose aus und hast "
		+"damit eine Wespe die noch in der Bluete war aggressiv "
	    +"gemacht.\n"));
      x=0;
      max=0;
      wht=0;  
      max=(TP->QueryProp(P_MAX_WEIGHT));
      wht=(TP->query_weight_contents());
      x=max-wht;
      
      if (x>21)
	{
	  CLONE(OBJ("rosenbluete"),(TP));
	}      
      else
	{
	  CLONE(OBJ("rosenbluete"), (ENV(TP)));
	}
      (wasp =clone_object(NPC("wespe")))->move((environment(TP)), M_NOCHECK);
      wasp->Kill(TP);
      TO->remove();
      return 1;
    }
  else return 0;
}













