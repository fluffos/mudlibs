inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
if (!is_clone(this_object())) return; 
 
::create();
 
 AddId(({"bluete", "rosenbluete", "\nsqrosenbluete"}));
 SetProp(P_SHORT, "Eine Rosenbluete");
 SetProp(P_LONG, "Die Bluete einer weissen Rose.\n"
	 +"Mit der kann man sicher etwas nettes anfangen.\n");
 SetProp(P_NAME, "Rosenbluete");
 SetProp(P_GENDER, FEMALE);
 SetProp(P_NOSELL, 1);
 SetProp(P_NOBUY, 1);
 SetProp(P_NODROP, 1);
 SetProp(P_NEVERDROP, 1);
 SetProp(P_WEIGHT, 20);
}

