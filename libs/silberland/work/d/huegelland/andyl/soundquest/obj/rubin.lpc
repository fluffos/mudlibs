inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
if (!is_clone(this_object())) return; 

 ::create();

 AddId(({"pulsierender rubin", "rubin", "\nsqrubin"}));
 SetProp(P_SHORT, "Ein pulsierender Rubin");
 SetProp(P_LONG, "Ein pulsierender Rubin.\n"
	 +"Du hast keine Ahnung zu was der gut "
	+"sein soll.\n");
 SetProp(P_NAME, "Rubin");
 SetProp(P_MATERIAL, MAT_RUBY); 
 SetProp(P_GENDER, MALE);
 SetProp(P_NOSELL, 1);
 SetProp(P_NOBUY, 1);
 SetProp(P_NODROP, 1);
 SetProp(P_NEVERDROP, 1);
 SetProp(P_WEIGHT, 30);

}
