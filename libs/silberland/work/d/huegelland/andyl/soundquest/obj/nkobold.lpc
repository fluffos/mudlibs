inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../files.h"
#define textlist ({ "Der Kobold kreischt: Lass mich hier raus du Ekel!\n", \
  "Der Kobold arglt: Wenn ich hier rauskomme hau ich dir ganz kraeftig ins Schienbein!\n", \
    "Der Kobold schnauzt dich sehr boese an.\n", \
    "Der Kobold strammpelt heftig im Netz herum.\n", \
    "Der Kobold nervt dich so, dass du ihm eine runterhaust, worauf er wieder kurz ruhig ist.\n", \
    "Der Kobold droht: Wenn du mich nicht rauslaesst hol ich meinen grossen Bruder!\n", \
    });
string *text;

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  text=textlist;
  AddId(({"kobold", "gefangener kobold", "netz"}));
  AddId(("\nsqnkobold"));
  SetProp(P_SHORT, "Ein in einem Netz gefangener Kobold");
  SetProp(P_LONG, "Der Kobold zappelt hilflos in dem Netz herum.\n"
	  +"Er tut dir aber nicht im geringsten Leid. Bei allem "
	  +"was der kleine Wicht schon boeses angestellt hat verdient "
	  +"er es ja nicht anders.\n");
  SetProp(P_NAME, "Kobold");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 20);
  call_out("sprechen",20+random(10));
}

void sprechen()
{
  string str;
  str = text [ random(sizeof(text)) ];
  if(living(environment()))
    tell_object(environment(), (BS(str)));
  else
    tell_room(environment(), (BS(str)));
  call_out("sprechen",20+random(10)); 
}


remove()
 {
   while (remove_call_out("sprechen") != -1);
   return ::remove();
 }








