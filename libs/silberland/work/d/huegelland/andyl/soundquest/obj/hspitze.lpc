inherit "std/weapon";

#include <properties.h>
#include <combat.h>         
#include <language.h>     

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"spitze", "hornissenstachelspitze", "stachelspitze"}));
  AddId (("\nsqspitze"));
  SetProp (P_SHORT, "Eine Hornissenstachelspitze");
  SetProp (P_LONG, "Die Spitze eines Hornissenstachels.\n"
	   +"Der hat wohl einmal einer Hornisse gehoert. Sie "
	   +"ist extrem spitz.\n");
  SetProp (P_NAME, "Hornissenstachelspitze");
  SetProp (P_GENDER, FEMALE);
  
  SetProp (P_VALUE, 100);
  SetProp (P_WEIGHT, 150);
  SetProp (P_WEAPON_TYPE, WT_KNIFE);
  SetProp (P_DAM_TYPE, DT_PIERCE);
  SetProp (P_WC, 30);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_CHITIN);

}
 













