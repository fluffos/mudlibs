inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"hebel", "kristallhebel", "\nsqkristallhebel"}));
  SetProp(P_SHORT, "Ein Kristallhebel");
  SetProp(P_LONG, "Ein Hebel aus Kristall.\n"
	  +"Der wird sicher fuer irgendwas benoetigt. Nur fuer was?\n");
  SetProp(P_INFO,"Der Kristallhebel wird fuer "
	  +"eine magische Apparatur benoetigt.\n");  
  SetProp(P_NAME, "Kristallhebel");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 20);
  
}
