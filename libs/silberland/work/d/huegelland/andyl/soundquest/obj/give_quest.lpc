inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../quest.h"
#include "../files.h"
#include <moving.h>

void create()
{
if (!is_clone(this_object())) return; 

::create();

AddId(({"\ngive_quest"}));
SetProp(P_SHORT, 0);
SetProp(P_NAME, "Give_Quest");
SetProp(P_GENDER, NEUTER);
SetProp(P_NOSELL, 1);
SetProp(P_NOBUY, 1);
SetProp(P_NODROP, 1);
SetProp(P_WEIGHT, 0);
SetProp(P_NEVERDROP, 1);
SetProp(P_VALUE, 0);

call_out("endseq1", 1);
}

move(dest,meth) 
{
  mixed res;
  while (remove_call_out("try_remove")!=-1) ;
  res=::move(dest,meth);
  if (!environment() || !living(environment()))
    call_out("try_remove",30);
  return res;
}

try_remove() {
  if (!environment() || !living(environment())) 
    {
      remove();
    }
}

void endseq1()
{
  write (BS("Gerade als du den letzten Ton spielst und das "
	+"Instrument jetzt einsatzbereit zu sein scheint, "
	+"betritt Umpf aufgeregt das Zimmer.\n\n"));
  write ("\n");
  call_out(("endseq2"), 10);
}

void endseq2()
{
  write (BS("Er fragt dich nervoes: Ich bin jetzt mit der "
	+"Kueche fertig. Hast du es geschafft das Instrument "
	+"in Gang zu bringen?\n\n"));
  write ("\n");
  call_out(("endseq3"), 6);
}

void endseq3()
{
  write (BS("Du nickst bestaetigend.\n\n"));
  write ("\n");
  call_out(("endseq4"), 5);
}

void endseq4()
{
  write (BS("Umpf atmet erleichtert auf und "
	+"sagt:\nSehr gut. Denn jeden Moment kann "
	+"mein Meister wieder zurueckkom...\n\n")); 
  write ("\n"); 
  call_out(("endseq5"), 7);
}

void endseq5()
{
  write (BS("Als Umpf den Satz beenden will hoerst du ein "
	+"dumpfes 'ZUSCHH' hinter dir und als du dich "
	+"umdrehst siehst du eine Gestalt in einer "
	+"schwarzen Robe aus einer Rauchwolke treten.\n\n"));
  write ("\n");
  call_out(("endseq6"), 10);
}

void endseq6()
{
  write (BS("Die schwarze Gestalt mustert dich mit geheimnisvollen "
	+"blau leuchtenden Augen.\n\n"));
  write ("\n");
  call_out(("endseq7"), 8);
}

void endseq7()
{
  write (BS("Darauf fragt die Gestalt mit einer kuehlen aber "
	+"dennoch sehr freundlich klingenden Stimme: 'Wer ist das, "
	+"Umpf?' Der Zeigefinger der Gestalt deutet auf dich.\n\n"));
  write ("\n");
  call_out(("endseq8"), 9);
}

void endseq8()
{
  write (BS("Umpf sagt zoegernd: Das ist "+(this_player()->name(WER,2))
	+". "+(this_player()->name(WER,2))+" hat mir ein wenig bei meinen "
	+"Aufgaben geholfen, Meister.\n\n"));
  write ("\n");
  call_out(("endseq9"), 10);
}

void endseq9()
{
  write (BS("Der Soundmagier meint darauf: Na dann sei willkommen "
	+(this_player()->name(WER,2))+". Es ist nett von dir, "
	+"dass du Umpf ein wenig unter die Arme greifst.\n"
	+"Wartet hier bitte noch einen Moment!\n\n")); 
  write ("\n");
  call_out(("endseq10"), 10);
}

void endseq10()
{
  write (BS("Der Soundmagier verschwindet ploetzlich wieder "
	+"in einer Rauchwolke.\n\n"));
  write ("\n");
  call_out(("endseq11"), 8);
}

void endseq11()
{
  write (BS("Du wartest ein paar Minuten mit Umpf, der sichtlich "
	+"nervoes ist, in dem Musikraum als der Soundmagier "
	+"ploetzlich wieder erscheint.\n\n"));
  write ("\n");
  call_out(("endseq12"), 10);
}

void endseq12()
{
  write (BS("'Das Haus hast du wirklich sehr gut aufgeraeumt Umpf. "
	+"Jetzt bin ich nur noch gespannt ob du auch das Instrument "
	+"in Gang gebracht hast.'\n"
	+"Mit diesen Worten begibt sich der Soundmagier zur "
	+"Klaviatur des Instrumentes.\n\n"));
  write ("\n");
  call_out(("endseq13"), 10);
}

void endseq13()
{
  write (BS("Er zieht ein paar Knoepfe und ein paar Hebeln "
	+"die du vorher nicht an der Apparatur entdeckt hast "
	+"und faengt ploetzlich an etwas zu spielen.\n\n"));
  write ("\n");
  call_out(("endseq14"), 10);
}

void endseq14()
{
  write (BS("Auf einmal durchzucken Lichtstrahlen den ganzen Raum "
	+"und Klangfontaenen von ungekannter Schoenheit "
	+"gleiten durch deine Gehoergaenge.\n\n"));
  write ("\n");
  call_out(("endseq15"), 10);
}

void endseq15()
{
  write (BS("Fasziniert stehst du da und verfolgst das "
	+"Lichterspiel und lauscht den berauschenden Klaengen. "
	+"Dein Mund steht weit offen vor Erstaunen und Entzueckung.\n\n"));
  write ("\n");
  call_out(("endseq16"), 10);
}

void endseq16()
{
  int n;
  object ob;
  write (BS("Nach einem Finale furioso beendet der Soundmagier "
	    +"seine kleine Vorstellung wieder und du erwachst aus "
	    +"deinem Staunen. Gleich darauf wendet "
	    +"er sich an Umpf: 'Du hast wirklich alles ganz zu meiner "
	    +"Zufriedenheit erfuellt Umpf. Ich bin stolz auf dich. "
	    +"So einen fleissigen Gehilfen wie dich kann ich echt brauchen. "
	    +"Ich werde dich in die Lehre nehmen. Morgen fangen wir "
	    +"gleich mit deiner Ausbildung an.'\n\n"));
  write ("\n");
  
  if ((TP->QueryQuest("Umpfs Aufgabe"))==0)
    {
      CLONE(("/obj/gems/diamant"), TP);
    }
  else
    {
      CLONE(("/obj/gems/bergkristall"), TP);
    }
  
  n = TP->GiveQuest(SOUNDQUEST);
  if(n == 1)
    {
      write_file (SOUNDQUESTLOG,
		  sprintf ("%s  %s hat Umpfs Aufgabe vollendet.\n",
			   dtime(time()), CAP(TP->query_real_name())));
    } 
  else write_file (SOUNDQUESTLOG, 
		   sprintf ("%d wurde von GiveQuest zurueckgeliefert.\n",
			    n));
  
  call_out(("endseq17"), 16);
}

void endseq17()
{
  write (BS("Umpf laechelt verlegen und strahlt vor lauter Freude.\n\n"));
  write ("\n");
  call_out(("endseq18"), 10);
}

void endseq18()
{
  write (BS("Der Soundmagier laechelt ebenfalls und meint "
	    +"dann: 'Ich muss dann noch einmal kurz etwas erledigen. "
	    +"Es hat mich gefreut dich kennenzulernen "
	    +(this_player()->name(WER,2))+".'\n"
	    +"Mit diesen Worten verschwindet der Soundmagier wieder.\n"));
  write ("\n");
  call_out(("endseq19"), 10);
}

void endseq19()
{
  write (BS("Umpf fuehrt dich  wieder in den Vorgarten zurueck "
	    +"und sagt: 'Danke fuer deine Hilfe "+(this_player()->name(WER,2)) 
	    +". Ohne dich haette ich das wahrscheinlich nie schaffen koennen.'\n"
	    +"Umpf zieht darauf etwas aus seiner Hosentasche und meint: 'Nimm "
	    +"diesen Edelstein als Dank fuer deine Bemuehungen und denk daran, "
	    +"dass du mich jederzeit besuchen kommen kannst. Du bist "
	    +"immer willkommen.\n\n"));
  write ("\n");
  call_out(("endseq20"), 15);
}

void endseq20()
{
  write (BS("Umpf umarmt dich noch einmal dankbar, winkt dir freudestrahlend "
	    +"zu und verschwindet darauf wieder in dem Haus.\n\n"));
  write ("\n");
  call_out(("endseq21"), 5);
}

void endseq21()
{
  TP->move(ROOM("vorgarten"), M_GO|M_SILENT);
  ME->remove();
}

