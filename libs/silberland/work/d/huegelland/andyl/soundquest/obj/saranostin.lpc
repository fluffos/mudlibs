inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"saranostin", "\nsqsaranostin", "flaeschchen"}));
  SetProp(P_SHORT, "Ein Flaeschchen Saranostin");
  SetProp(P_LONG, "Ein kleines Flaeschchen Saranostin.\n"
	  +"Das Saranostin hat eine giftig gruene Farbe "
	  +"und riecht ungefaehr so wie eine starke Salpetersaeure.\n");
  SetProp(P_NAME, "Saranostin");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 30);
  
}



