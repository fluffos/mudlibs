inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"erde", "rote erde", "\nsqerde"}));
  SetProp(P_SHORT, "Rote Erde");
  SetProp(P_LONG, "Ein Haeufchen rote Erde.\n"
	  +"Du kannst nur hoffen das die zu irgendwas gut ist "
	  +"denn sonst schleppst du das Zeug umsonst herum.\n");
  SetProp(P_NAME, "Rote Erde");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 30);

}


