inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return; 

  ::create();
  
  AddId(({"nuss", "walnuss"}));
  AddId(("\nsqwalnuss"));
  SetProp(P_SHORT, "Eine Walnuss");
  SetProp(P_LONG, "Eine ganz gewoehnliche kleine Walnuss.\n");
  SetProp(P_NAME, "Walnuss");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 20);
  
}





