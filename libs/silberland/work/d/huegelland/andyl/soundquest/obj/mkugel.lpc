inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"magiedurchflutete kugel", "kugel", "\nsqkugel"}));
  SetProp(P_SHORT, "Eine magiedurchflutete Kugel");
  SetProp(P_LONG, "Eine von Magie durchflutete Kugel.\n"
	  +"In ihr kannst du verschiedenfaerbige Blitze "
	  +"zucken sehen, welche die Kugel in allen "
	  +"moeglichen Farben aufleuchten lassen.\n");
  SetProp(P_INFO, "Eine magiedurchflutete Kugel.\n"
	  +"Sie scheint als Energiequelle fuer irgendwas "
	  +"zu dienen.\n");
  SetProp(P_NAME, "Magiedurchflutete Kugel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 100);
}


