inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"netz","\nsqnetz"}));
  SetProp(P_SHORT, "Ein Netz");
  SetProp(P_LONG, "Ein Netz aus starken Schnueren.\n"
	  +"Damit kann man sicher irgendetwas fangen.\n");
  SetProp(P_NAME, "Netz");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 20);
  
}

