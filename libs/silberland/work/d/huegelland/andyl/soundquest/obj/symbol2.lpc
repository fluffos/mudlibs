inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"mystisches symbol", "symbol", "\nsqsymbol2"}));
  SetProp(P_SHORT, "Ein mystisches Symbol");
  SetProp(P_LONG, "Ein mystisches Symbol.\n"
	  +"Es hat die Form eines Halbmondes in dem "
	  +"fuer dich unentzifferbare Schriftzeichen "
	  +"eingraviert sind.\n");
  SetProp(P_INFO,"Das mystische Symbol wird fuer "
	  +"eine magische Apparatur benoetigt.\n");
  SetProp(P_NAME, "Mystisches Symbol");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 20);
  
  AddDetail(("schriftzeichen"),
	    "Du kannst sie nicht entziffern.\n");
}







