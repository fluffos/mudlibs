inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../files.h"

void create()
{
if (!is_clone(this_object())) return; 

::create();

AddId(({"zaubertrankbuch", "buch", "trankbuch", "\nsqtrankbuch"}));
SetProp(P_SHORT, "Ein Zaubertrankbuch");
SetProp(P_LONG, "Ein dickes Zaubertrankbuch. Es hat "
	+"6 Kapitel die du alle lesen kannst was du "
	+"auch tun solltest. Da stehen sicher sehr "
	+"interessante Sachen ueber Zaubertraenke drinnen.\n");
SetProp(P_NAME, "Zaubertrankbuch");
SetProp(P_GENDER, NEUTER);
SetProp(P_NOSELL, 1);
SetProp(P_NOBUY, 1);
SetProp(P_NODROP, 1);
SetProp(P_NEVERDROP, 1);
SetProp(P_WEIGHT, 30);

AddCmd(("lies"), "lies_was");

 AddDetail(("kapitel"),
	   "Du kannst die einzelnen Kapitel lesen.\n");

}

lies_was(str)
{
  notify_fail("Was willst du lesen?\n");
  if ((str == "trankbuch" || str == "zaubertrankbuch" || str == "kapitel"))
    {
      write("Welches Kapitel willst Du denn lesen?\n");
      return 1;
    }
  if (str == "kapitel 1")
    {
      write ("Das Kapitel handelt ueber Liebestraenke.\n"
	    +"Leider wird Dir das jetzt nicht weiterhelfen.\n");
      return 1;
    }
  if (str == "kapitel 2")
    {
      write("Dieses Kapitel handelt von Krafttraenken.\n"
	    +"Gewalt wird dich jetzt aber nicht weiterbringen.\n");
      return 1;
    }
  if (str == "kapitel 3")
    {
      write("Kapitel 3 handelt von Giften.\n"
	    +"Das kannst du jetzt aber auch nicht gebrauchen "
	    +"\(Auch wenn Dunkelelfen da anderer Ansicht sein "
	    +"koennten\).\n");
      return 1;
    }
  if (str == "kapitel 4")
    {
      write (BS("Hier findest du etwas interessantes: Ein "
	    +"Rezept fuer einen Laehmtrank der besonders "
	    +"gut bei Kobolden wirkt. Das solltest du "
	    +"vielleicht lesen.\n"));
      return 1;
    }
  if (str == "kapitel 5")
    {
      write("Das Kapitel behandelt Pflanzenduenger.\n"
	    +"Du glaubst nicht, dass du das brauchen wirst.\n");
      return 1;
    }
  if (str == "kapitel 6")
    {
      write(BS("Hier werden hauptsaechlich Nebenwirkungen von Traenken und "
	    +"Kraeutern behandelt. Eine Zeile faellt dir dabei besonders "
	    +"ins Auge. Du kannst sie lesen."));
      return 1;
    }
  if (str == "zeile")
    {
      write(BS("Da steht:  "
	       +"...zudem konnte in Erfahrung gebracht werden, dass Kobolde "
	       +"aus irgendeinem Grund Tomaten hassen und alles "
	       +"versuchen werden um diesen aus dem Weg zu gehen...\n"));
      return 1;
    }
  if (str == "rezept")
    {
      write (BS("Rezept fuer einen Laehmtrank:\n"
	    +"Zuerst gebe man Rattengift, Kaese, "
	    +"eine Walnuss, etwas Kresse, ein "
	    +"wenig rote Erde, die Spitze eines "
	    +"Hornissenstachels, eine Rosenbluete und "
	    +"etwas Schnittlauch in ein Gefaess und zerkleinere "
	    +"das ganze. Danach schuette man ein wenig "
	    +"Saranostin dazu und fuelle es in eine Flasche und "
	    +"der Trank ist fertig.\n"
	    +"Der Trank wirkt bei Hautkontakt sofort.\n"));
      return 1;
    }
  return 0;
}





















