inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(("kaese"));
  AddId(("\nsqkaese"));
  SetProp(P_SHORT, "Ein Stueckchen Kaese");
  SetProp(P_LONG, "Ein kleines Stueckchen Kaese.\n"
	  +"Ungluecklicherweise riecht es leider schon ein "
	  +"bisschen streng.\n");
  SetProp(P_NAME, ({"Kaese", "Kaeses", "Kaese", "Kaese"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 20);
  SetProp(P_MATERIAL, MAT_MISC_FOOD);
  SetProp(P_SMELL, "Der Kaese riecht schon etwas streng.\n");
}











