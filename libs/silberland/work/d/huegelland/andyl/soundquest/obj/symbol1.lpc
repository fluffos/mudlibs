inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"magisches symbol", "symbol"})); 
  AddId(("\nsqsymbol1"));
  SetProp(P_SHORT, "Ein magisches Symbol");
  SetProp(P_LONG, "Ein magisches Symbol.\n"
	  +"Es hat eine eigenartige pentagrammaehnliche "
	  +"Form. Was es wohl damit auf sich hat?\n");
  SetProp(P_INFO, "Das magische Symbol wird fuer "
	  +"eine magische Apparatur benoetigt.\n");
  SetProp(P_NAME, "Magisches Symbol");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 20);
  SetProp(P_MATERIAL, P_MAGIC);

  AddDetail(("form"),
	    "Das Symbol hat die Form eines Pentagramms.\n");
  AddDetail(({"pentagramm", "fuenfstern"}),
	    "Das Pentagramm ist ein Fuenfstern. Es ist das Symbol fuer die Magie.\n");
}

