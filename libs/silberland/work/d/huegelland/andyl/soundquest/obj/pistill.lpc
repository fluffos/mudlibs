inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return; 
  
  ::create();
  
  AddId(({"pistill", "\nsqpistill"}));
  SetProp(P_SHORT, "Ein Pistill");
  SetProp(P_LONG, "Ein einfacher Pistill.\n"
	  +"Er wird dazu verwendet um Dinge in einem Moerser zu "
	  +"zerkleinern.\n");
  SetProp(P_NAME, "Pistill");
  SetProp(P_GENDER, MALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT, 50);

}



