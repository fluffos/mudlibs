inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
if (!is_clone(this_object())) return; 

::create();

AddId(({"schnittlauch", "lauch", "\nsqschnittlauch"}));
SetProp(P_SHORT, "Etwas Schnittlauch");
SetProp(P_LONG, "Das ist ein kleines Straeuschen Schnittlauch.\n"
	+"Damit kann man hervorragend eine Suppe verfeinern.\n");
SetProp(P_NAME, "Schnittlauch");
SetProp(P_GENDER, MALE);
SetProp(P_NOSELL, 1);
SetProp(P_NOBUY, 1);
SetProp(P_NODROP, 1);
SetProp(P_NEVERDROP, 1);
SetProp(P_WEIGHT, 20);

}
