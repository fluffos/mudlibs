inherit "std/food";

#include <properties.h>
#include <food.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Kamillenblueten");
  SetProp(P_LONG,
	  "Die Kamillenblueten verstroemen einen angenehmen Duft. "
	  +"Angeblich sollen die ja heilende Kraefte besitzen.\n");
  SetProp(P_INFO, "Die Kamillenblueten geben einem sowohl Magie- als "
	  +"auch Lebenspunkte zurueck wen man sie isst.\n");
  SetProp(P_ARTICLE, 1);
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Kamillenblueten");
  AddId(({"kamille", "blueten", "kamillenblueten", "kamillen"}));
  SetProp(P_WEIGHT, 1);
  SetProp(P_VALUE, 50);
  SetProp(P_FOOD_INFO, ([F_HEAL : ({30, 30}), F_SOAK : 3]));
  SetProp((P_SMELL),
	  "Die Kamillenblueten verstroemen einen angenehmen, beruhigenden Duft.\n");
}

void BeimEssen()
{
  write("Du isst die Kamillenblueten und fuehlst sofort deren heilende Kraft.\n");
  say(this_player()->name()+" isst ein paar Kamillenblueten.\n"); 
}





