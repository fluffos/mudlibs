inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
if (!is_clone(this_object())) return; 

::create();

AddId(({"faule tomate", "tomate", "\nsqtomate"}));
SetProp(P_SHORT, "Eine faule Tomate");
SetProp(P_LONG, "Eine faule Tomate.\n"
	+"Essen kann man die jetzt sicher nicht mehr. "
	+"Aber vielleicht kann man das auf irgendwas oder "
	+"irgendwen schmeissen oder werfen.\n");
SetProp(P_NAME, "faule Tomate");
SetProp(P_GENDER, FEMALE);
SetProp(P_NOSELL, 1);
SetProp(P_NOBUY, 1);
SetProp(P_NODROP, 1);
SetProp(P_NEVERDROP, 1);
SetProp(P_WEIGHT, 30);
SetProp(P_SMELL, "Die Tomate riecht ziemlich faul.\n");

}


