inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
if (!is_clone(this_object())) return; 

::create();

AddId(({"brecheisen", "eisen", "\nsqbrecheisen"}));
SetProp(P_SHORT, "Ein Brecheisen");
SetProp(P_LONG, "Ein solides Brecheisen.\n"
	+"Damit kann man irgendwas auf oder wegbrechen.\n");
SetProp(P_NAME, "Brecheisen");
SetProp(P_GENDER, NEUTER);
SetProp(P_NEVERDROP);
SetProp(P_NOSELL, 1);
SetProp(P_NOBUY, 1);
SetProp(P_NODROP, 1);
SetProp(P_WEIGHT, 200);

}



