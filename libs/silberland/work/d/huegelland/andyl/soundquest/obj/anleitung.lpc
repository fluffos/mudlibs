inherit "std/thing";

#include <properties.h>
#include <language.h>
#include "../files.h"

void create()
{
if (!is_clone(this_object())) return; 

::create();

AddId(({"anleitung", "\nsqanleitung"}));
SetProp(P_SHORT, "Eine Anleitung");
SetProp(P_LONG, "Eine Anleitung fuer ein magisches Instrument. "
	+"In ihr sind die Prozedur beschrieben wie man so "
	+"ein magisches Instrument in Gang kriegt. Du solltest "
	+"die Anleitung unbedingt lesen.\n");
SetProp(P_NAME, "Anleitung");
SetProp(P_GENDER, FEMALE);
SetProp(P_NOSELL, 1);
SetProp(P_NOBUY, 1);
SetProp(P_NEVERDROP, 1);
SetProp(P_NODROP, 1);
SetProp(P_WEIGHT, 10);

AddCmd(("lies"), "lies_was");

}

lies_was(str)
{
  notify_fail("Was willst du lesen?\n");
  if (str == "anleitung")
    {
      write ("Da scheint ein Teil zu fehlen. Alles was du lesen kannst ist:\n"
               +"\n"
               +"  __                ___________  ______\n"
               +" /  \\/\\________/\\__/           \\/      \\____/\\______/\\\n" 
	       +"| Nachdem alles zusammengebaut ist stellen sie fest   \\\n"
	       +"| ob alles so funktioniert wie es soll indem sie       \\\n"
	       +"| folgendes spielen:                                    \\\n"
	       +"| Spielen sie zuerst den Kammerton. Danach gehen          \\\n"
	       +"| sie in dessen Moll-Tonleiter zuerst eine Terz rauf,      \\\n"
	       +"| dann wieder eine Sekund runter, danach wieder eine        |\n"
	       +"| Terz nach oben, dann eine Quart hinauf und schlussendlich_|\n"
	       +"| noch eine Sekund nach oben.    /\\__________             /\n" 
               +" \\______________________________/            \\/\\_________/\n"
               +"\n"
               +"Wieder mal typisch, einfache Anleitungen scheints wohl nicht\n"
               +"zu geben. Umpf kann Dir hoffentlich etwas davon genauer erklaeren.\n");
      return 1;
    }
  else return 0;
}































