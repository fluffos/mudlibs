inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.lpc>
#include "../files.h"
create()
{

  if (!is_clone(this_object())) return;

  ::create(); 

  SetProp(P_SHORT, "Eine Hornissenkoenigin");
  SetProp(P_LONG, "Die Hornissenkoenigin ist ungefaehr dreimal so "
	  +"gross wie eine normale Hornisse.\n"
	  +"Sie sieht aeusserst gefaehrlich aus. Ausserdem hat "
	  +"sie einen riesigen Stachel.\n");
  SetProp(P_NAME, "Hornissenkoenigin");
  SetProp(P_GENDER, FEMALE);
  
  AddId("hornissenkoenigin"); 
  AddId("koenigin");
  create_default_npc( 5 );
  
  SetProp(P_BODY, 4);
  SetProp(P_SIZE, 11);
  SetProp(P_HANDS, ({" mit ihrem grossen Stachel", 20, DT_PIERCE}));
  SetProp(P_ALIGN, -400 ); 
  SetProp(P_RACE, "Insekt");
  SetProp(P_XP, 300);
  CLONEME (OBJ("hstachel.lpc"));
  command ("zuecke stachel");

}






































