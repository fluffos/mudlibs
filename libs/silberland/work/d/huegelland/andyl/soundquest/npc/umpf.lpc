inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../files.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();    
  SetProp(P_SHORT, "Umpf der kleine Gehilfe");
  SetProp(P_LONG, "Das ist Umpf der Gehilfe des Soundmagiers.\n"
	  + "Er ist ein kleiner Gnom der einen sehr freundlichen "
	  + "Eindruck macht. Er scheint nur gerade ueber irgendetwas "
	  + "ziemlich besorgt zu sein. Vielleicht sprichst du ja mal mit "
	  + "ihm ueber seine Probleme.\n");
  SetProp(P_NAME, "Umpf");
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOATTACK, "sieht so traurig aus, " 
	  + "dass du es nicht uebers Herz bringst ihn anzugreifen.");  
  SetProp(P_GENDER, MALE);
  SetProp(P_REJECT, 
	  ({REJECT_GIVE, "Umpf meint: Danke, aber das kann "
	      +"ich nicht gebrauchen.\n"}));
  AddId(({"umpf", "gehilfe"})); 
  create_default_npc( 20 );
  SetProp(P_BODY, 10);
  SetProp(P_HANDS, ({" mit seinen tolpaetschigen Haenden.", 20}));
  SetProp(P_ALIGN, 500 ); 
  SetProp(P_RACE, "Gnom");
  SetProp(P_XP, 1000);
  set_living_name ("umpf");
  
  SetChats(2, ({
    "Umpf jammert: Dieser dumme Kobold ruiniert mir noch alles.\n",
      "Umpf jammert: Was sag ich nur meinem Meister wenn er kommt?\n",
      "Umpf wimmert verzweifelt vor sich hin.\n",
      "Umpf springt nervoes von einem Bein auf das andere.\n",
      "Umpf meint traurig: So mach ich hier keine Lehre.\n",
      "Umpf schnieft: Ich hasse diesen dummen Kobold.\n",
      }) );
  AddInfo (({"hilfe", "helfen", "aufgabe"}), "@@aufgabe@@", "sagt: ");
  AddInfo(({"umpf", "name"}),
	  "sagt: Umpf ist mein Name.\n");
  AddInfo(("gnom"),
	  "sagt: Ich bin ein Gnom.\n");
  AddInfo (({"gehilfe", "lehrling"}),
	   "Derzeit bin ich hier nur ein Gehilfe, aber ich moechte "
	   +"hier am liebsten Lehrling bei meinem Meister werden "
	   +"und bei ihm eine Lehre machen.\n", "sagt: " );
  AddInfo (("lehre"),
	   "sagt: Ich moechte hier unbedingt eine Lehre machen\n"
	   +"Umpf sagt: um irgendwann einmal Soundmagier zu werden.\n"
	   +"Umpf sagt: Dazu muss ich allerdings meine Aufgabe\n"
	   +"Umpf sagt: als Gehilfe hier gut verrichten. Doch jetzt\n"
	   +"Umpf sagt: hab ich das Problem mit diesem bloeden fiesen "
	   +"Kobold.\n"
	   +"Umpf schnieft verzweifelt auf.\n");
  AddInfo (("gartentor"),
	   "sagt: Mit dem haben meine Probleme ueberhaupt angefangen.\n");
  AddInfo (({"aufgabe", "auftrag"}),
	   "sagt: Ich hab von meinem Meister, der gerade weg ist, den Auftrag\n"
	   +"Umpf sagt: das Haus saeuberlichst zu putzen und zusammenzuraeumen.\n"
	   +"Umpf sagt: Wenn ich die Aufgabe gut erledige darf ich dann bei ihm in\n"
	   +"Umpf sagt: die Lehre gehen.\n" 
	   +"Umpf sagt: Allerdings hab ich jetzt das Problem mit diesem\n"
	   +"Umpf sagt: extrem fiesen Kobold der mir alles ruiniert.\n"
	   +"Umpf schluchzt. \n");
  AddInfo (({"kobold", "problem", "probleme"}),
	   "sagt: Wie ich im Garten war und dort etwas\n"
	   +"Umpf sagt: gearbeitet habe, habe ich das Gartentor aus Versehen\n"
	   +"Umpf sagt: offengelassen. Da ist mir dann so ein bloeder Kobold\n"
	   +"Umpf sagt: ins Haus geflitzt und hat angefangen alles in der Kueche\n"
	   +"Umpf sagt: auf den Kopf zu stellen. Ich habe schon versucht ihn\n"
	   +"Umpf sagt: einzufangen, jedoch ist der viel zu schnell fuer mich.\n"
	   +"Umpf sagt: So kann ich meine Aufgabe nie erfuellen und kann dann\n"
	   +"Umpf sagt: hier keine Lehre machen.\n"
	   +"Umpf sagt: Ohne irgendeine Hilfe gehen dann alle meine Traeume\n"
	   +"Umpf sagt: verloren.\n" 
	   +"Umpf weint bitterlich.\n"); 
  AddInfo(({"traeume", "traum", "wunschtraum"}),
	  "Mein groesster Wunschtraum waere es hier in die Lehre gehen zu duerfen "
	  +"und einmal Soundmagier zu werden.\n", "sagt: ");
  AddInfo (("garten"),
	   "sagt: Das ist ein sehr schoener Garten, findest du nicht?\n");
  AddInfo(("kueche"),
	  "sagt: Die hat mir dieser fiese Kobold total zerlegt.\n");
  AddInfo(({"haus", "soundmagierhaus"}),
	  "Es ist ein sehr grosses seltsames Haus, aber auch ausserordentlich "
	  +"schoen und gemuetlich.\n", "sagt: ");
  AddInfo(({"soundmagier", "koennen", "erschaffung"}),
	  "Soundmagier, wie mein Meister, sind Magier die ihr ganzes Koennen "
	  +"der Erschaffung von mystischen Toenen, wunderschoenen Melodien "
	  +"und berauschenden Klaengen widmen. Ich moechte auch einmal ein "
          +"Soundmagier werden.\n", "sagt: ");
  AddInfo(({"melodien", "melodie", "toenen", "toene", "ton", "klaengen", "klaenge"}),
	  "Das gehoert alles zum Fachgebiet eines Soundmagiers.\n", "sagt: ");
  AddInfo(({"fachgebiet", "musik"}),
	  "Das Fachgebiet eines Soundmagiers ist einfach "
          +"gesagt die Musik.\n", "sagt: ");
  AddInfo(({"rubin", "pulsierender rubin"}),
	  "Damit kannst du die oberen Stockwerke betreten.\n" , "sagt: ");
  AddInfo(({"stockwerke", "stockwerk"}),
	  "Nur mit einem pulsierenden Rubin gelangt man in die "
	  +"oberen Stockwerke.\n" , "sagt: ");
  AddInfo(("meister"),
           "Mein Meister, der gerade nicht im Haus ist, ist ein grosser und sehr "
	  +"angesehener Soundmagier. "
	  +"Ich hoffe, dass ich bei ihm in die Lehre darf. Nur wenn ich mein "
	  +"Problem nicht loesen kann, dann werd ich das "
          +"wohl nie koennen.\n", "sagt: ");
  AddInfo(("magier"),
	  "sagt: Das sind absolute Oberidler.\n");
  AddInfo(({"idler", "oberidler"}),
	  "meint: Das sind sicher Magier oder Goetter!\n");
  AddInfo(({"woody", "dusty", "gott", "goettin", "goetter"}),
	  "sagt: Woody und Dusty sind die Goetter des Silberlandes.\n");
  AddInfo(("silberland"),
	  "sagt: Im Silberland fuehl ich mich extrem wohl. Du auch?\n");
  AddInfo(({"angrox"}),
	  "sagt: Ist das nicht der Druidenpapa?\n");
  AddInfo(("druidenpapa"),
	  "sagt: Das muesste Angrox sein, oder?\n");
  AddInfo(("feyaria"),
	  "sagt: Ist das nicht die Berserkermama?\n");
  AddInfo(("berserkermama"),
	  "sagt: Das ist Feyaria.\n");
  AddInfo(("teranon"),
	  "sagt: Das ist ein grosser Kaempfer gewesen.\n");
  AddInfo(("kaempfer"),
	  "sagt: Teranon war ein grosser Kaempfer.\n");
  AddInfo(("andyl"),
	  "Der war hier schon einmal zu Besuch. Er ist auch "
	  +"ein Soundmagier und redet oft mit meinem Meister "
	  +"ueber Musik. Also ich fand ihn ueberaus freundlich wenn auch etwas seltsam.\n", "sagt: "); 
  AddInfo(("besuch"),
	  "sagt: Einmal war Andyl hier schon zu Besuch.\n");
  AddInfo(({"hornisse", "hornissenstachel"}),
	  "sagt: Im Garten hab ich bisher noch keine Hornissen gesehen. Aber die "
          +"bauen ihre Nester gerne in Dachgeschossen von irgendwelchen Gebaeuden.\n");
  AddInfo(("netz"),
	  "sagt: Also ich hab keines. Hab unseres leider mal irgendwo im Garten "
          +"verlegt.\n");
  AddInfo(({"kraeuter", "gemuese"}),
	  "sagt: Im Gemuesegarten haben wir da einiges.\n");
  AddInfo(("gemuesegarten"),
	  "Da haben wir viel Gemuese und einige "
	  +"Kraeuter angepflanzt.\n", "sagt: ");
  AddInfo(("melodie"),
	  "sagt: Ich kenn leider keine gute. Eventuell ist im Arbeitszimmer meines Meisters "
          +"eine gute Melodie zu entdecken.\n");
  AddInfo(({"magiedurchflutete kugel", "kugel"}),
	  "sagt: Die braucht man um das "
          +"magische Instrument meines Meisters in Gang zu bekommen.\n");
  AddInfo(({"kristallhebel", "hebel"}),
	  "sagt: Den braucht man um das "
          +"magische Instrument meines Meisters in Gang zu bekommen.\n");
  AddInfo(({"symbol", "symbole"}),
          "sagt: Man braucht ein mystischen und ein magisches Symbol um das "
          +"magische Instrument meines Meisters in Gang zu bekommen.\n");
  AddInfo(({"magischen symbol", "mystischen symbol"}),
	  "sagt: Das braucht man um das "
          +"magische Instrument meines Meisters in Gang zu bekommen.\n");
  AddInfo(({"instrument", "magischen instrument"}),
	  "sagt: Das steht zwei Etagen hoeher.\n");
  AddInfo(("etagen"),
	  "sagt: Dieses Haus hat drei Etagen.\n");
  AddInfo(({"pistill", "stab", "art"}),
	  "sagt: Ein Pistill ist ein Art Stab mit dem man irgendetwas "
	  +"zerkleinern kann z.B. in einem Moerser.\n");
  AddInfo(({"moerser"}),
          "sagt: Sowas kennst Du sicher aus verschiedenen Apotheken.\n");
  AddInfo(("kammerton"),
	  "sagt: Der Kammerton ist der Ton a.\n");
  AddInfo(({"tonleiter", "tonleitern"}),
	  "sagt: Es gibt Dur-Tonleitern und Moll-Tonleitern.\n");
  AddInfo(({"dur-tonleiter", "dur", "durtonleiter", "durtonleitern", "dur-tonleitern"}),
	  "sagt: Das sind eher froehlich klingende Tonleitern. Ich kann Dir sagen wie die "
	  +"Dur-Tonleiter vom Ton C geht.\n");
  AddInfo(("dur-tonleiter von ton c"),
	  "sagt: Wenn man sie hinauf geht, geht die so:\nc, d, e, f, g, a, h und dann gehts wieder bei c los.\n"); 
  AddInfo(({"moll-tonleiter", "moll", "molltonleiter", "molltonleitern", "moll-tonleitern"}),
	  "Das sind eher traurig klingende Tonleitern. Willst "
	  +"du sie von einem bestimmten Ton wissen? Dann frag "
	  +"mich nach 'moll-Tonleiter von Ton <x>'.\n", "sagt: ");
  AddInfo(("moll-tonleiter von ton a"),
	  "sagt: Wenn man sie hinauf geht, geht die so:\na, h, c, d, e, f, g und dann gehts wieder bei a los.\n");
  AddInfo(("terz"),
	  "Bei einer Prim bleibt man in einer Tonleiter beim selben Ton, den man zuvor gespielt hat.\n", "sagt: ");
  AddInfo(("terz"),
	  "Bei einer Terz geht man in einer Tonleiter zwei Toene "
	  +"weiter. Je nachdem wie es verlangt ist entweder die Tonleiter hinauf oder hinunter.\n", "sagt: ");
  AddInfo(("sekund"),
	  "Bei einer Sekund geht man in einer Tonleiter "
	  +"einen Ton weiter. Je nachdem wie es verlangt ist entweder die Tonleiter hinauf oder hinunter.\n", "sagt: ");
  AddInfo(("quart"),
	  "Bei einer Quart geht man in einer "
	  +"Tonleiter 3 Toene weiter. Je nachdem wie es verlangt ist entweder die Tonleiter hinauf oder hinunter.\n", "sagt: ");
  AddInfo(("quint"),
	  "Bei einer Quint geht man in einer "
	  +"Tonleiter 4 Toene weiter. Je nachdem wie es verlangt ist entweder die Tonleiter hinauf oder hinunter.\n", "sagt: ");
  
  AddInfo(("sext"),
	  "Bei einer Sext geht man in einer "
	  +"Tonleiter 5 Toene weiter. Je nachdem wie es verlangt ist entweder die Tonleiter hinauf oder hinunter.\n", "sagt: ");
  AddInfo(("sept"),
	  "Bei einer Sept geht man in einer "
	  +"Tonleiter 6 Toene weiter. Je nachdem wie es verlangt ist entweder die Tonleiter hinauf oder hinunter.\n", "sagt: ");
  AddInfo(("oktave"),
	  "Bei einer Oktave geht man in einer "
	  +"Tonleiter 7 Toene weiter. Man ist dann auch wieder bei dem Ton angelangt von dem man ausgegangen ist, "
	  +"allerdings immer hoeher oder tiefer, je nachdem ob man die Tonleiter hinauf oder hintunter geht.\n", "sagt: ");
  AddInfo(({"hobbit", "hobbits"}),
          "Hobbits sind gemuetliche Leute. Die verstehen vor allem "
          +"sehr viel vom Essen.\n", "sagt: ");
  AddInfo(("essen"),
	  "sagt: Da fragst du besser einen Hobbit.\n");
  AddInfo(({"elf", "elfen"}),
	  "Elfen sind ueberaus klug. Ich hoer denen immer "
	  +"gerne beim Philosophieren zu.\n", "sagt: ");
  AddInfo(({"zwerge", "zwerg"}),
	  "sagt: Zwerge sind ueberaus begabt in der Schmiedekunst.\n");
  AddInfo(("schmiedekunst"),
	  "sagt: Da fragst du besser einen Zwerg.\n");
  AddInfo(({"mensch", "menschen"}),
	  "sagt: Menschen sind in jeder Hinsicht sehr anpassungsfaehig.\n");
  AddInfo(({"troll", "trolle"}),
	  "sagt: Trolle sind ein selten daemliches Volk.\n");
  AddInfo(({"dunkelelf", "dunkelelfen"}),
	  "sagt: Dunkelelfen sind eher ungute lichtscheue Gestalten.\n");
  AddInfo(("oger"),
	  "Oger sind sehr gefaehrlich und gefraessig. Vor denen sollte man sich in "
	  +"Acht nehmen.\n", "sagt: ");
  AddInfo(({"fee", "feen"}),
	  "Feen sind ueberaus weise aber sehr zierliche Wesen.\n", "sagt: ");
  AddInfo(("wesen"),
	  "Es gibt sehr viele Wesen im Silberland.\n");
  AddInfo(({"trank", "zaubertrank", "traenke", "zaubertraenke"}),
          "Hmmm, vielleicht kannst Du in der Bibliothek etwas darueber in Erfahrung bringen.\n", "sagt: "); 
  AddInfo(({"buch", "buecher", "buechern"}),
	  "In der Bibliothek im Suedwesten des Hauses findest du einen "
	  +"Haufen Buecher in denen etwas Interessantes drinstehen koennte.\n", "sagt: ");
  AddInfo(("bibliothek"),
	  "In der Bibliothek im Suedwesten des Hauses sind viele interessante Buecher zu finden.\n", "sagt: ");
  AddInfo(DEFAULT_INFO, ({
    "fragt verwirrt: Kann man das zu irgendwas gebrauchen?\n",
      "sagt: Keine Ahnung.\n",
      "zuckt unwissend mit den Schultern.\n",
      "sagt: Hoert sich sehr interessant an.\n",
      "meint: Wer braucht denn sowas?\n",
      "sagt: Also ich hab damit nichts zu tun.\n",
      "schaut dich ahnungslos an.\n",
      "meint: Das koennen bestenfalls die Goetter brauchen.\n",
      "fragt neugierig: Wo kann man das kaufen?\n",
      "denkt intensiv ueber die Bedeutung deiner Worte nach.\n",
      "fragt: Woher soll ich das bitte wissen?\n"}) );

  previous_object()->CustomizeObject(); 

  // Bardengilde Infos
  AddInfo( ({"barden", "bardengilde"}), 
	"Die Bardengilde findest du im Kristallwald. Sie sind erlesene Kuenstler, die"
	"magische Zauberlieder singen koennen. Mein Meister hat sich besonders lang mit "
	"den Barden und ihrer Geschichte beschaeftigt.",
	"sagt: ");
	
  AddInfo( ({"schildlied", "lied", "schildsang der walkueren", "stolze mauer am fluss", "ballade vom drachentoeter",
             "zauberlied", "lieder", "zauberlieder", "liedern", "zauberliedern", "zwerigsches ahnenlied", "zwergischem ahnenlied"}), 
	"Die Barden sind meisterhaft darin Zauberlieder zu singen. Mein Meister, der Soundmagier, hat sogar eine grosse "
	"Sammlung alter Bardendichtungen. Auch ein paar besonders alte Notenblaetter, welche von den Grossen Vier gedichtet wurden, "
	"hat er in seiner Sammlung.",
	"sagt: ");
	
  AddInfo( ({"notenblaetter", "sammlung"}), 
    "Die besonderen Notenblaetter der Sammlung hat der Soundmagier im Keller versteckt. "
	"@@sammlung@@",
    "sagt: ");
}

public string sammlung() {
	if(this_player()->QueryQuest("Umpfs Aufgabe") == 0) {
	    return "Ohje ohje! Einen Fremden darf ich nicht einfach so an die wertvolle Sammlung des Soundmagiers lassen. "
		       "Vielleicht darf ich eine Ausnahme machen, wenn du mir bei meiner Aufgabe hilfst.";
	} else if(this_player()->QueryProp(P_GUILD) != "bardengilde") {
		return "Leider moechte der Soundmagier nur echte Kuenstler an seine Sammlung lassen. Also nur Barden...";
	}

	return "Da du mir geholfen hast, erlaubt der Meister, dass du dich im Keller umsiehst. Seine Sammlung musst "
	       "du aber selbst finden. Das ist die Aufgabe die er dir stellt!";
}

string aufgabe ()
{
  object ob;
  
  if(!ob=present(("\nsqquestitem"), TP))
    {
      CLONE(OBJ("sqquestitem"),(TP));
      return("Du wuerdest mir wirklich helfen?\n"
	     +"Du bist meine Rettung. Bitte sei so nett und\n"
	     +"fang diesen fiesen Kobold ein. Der ist allerdings\n"
	     +"ziemlich schnell ich weiss nicht wie man das machen\n"
	     +"koennte. In Buechern koenntest du vielleicht etwas\n"
	     +"darueber in Erfahrung bringen. Bring ihn auf jeden Fall\n"
	     +"zu mir wenn du ihn hast und Danke im Voraus.\n");
    }
  else
    return(BS("Aber du hilfst mir doch schon.\n"));
}


give_notify(object obj)
{
  object ob;
  
  if (obj->id("\nsqnkobold"))
    {
      if (!ob=present(("\nsqquestitem"),TP))
	{
	  tell_room(environment(),
		    break_string( "Nanu? Wie kommst du denn an den?"
				  +"Da muss ich jetzt etwas richten!\n"));
	  obj->remove();
	  return 1;
	}
      else
	{
	  if (!ob=present(("\nsqrubin"),TP))
	    {
	      obj->remove();
	      CLONE(OBJ("rubin"),TP);
	      call_out(("seq1"), 0);
	      return 1;
	    }
	  else
	    {
	      obj->remove();
	      tell_room(environment(),
			(BS("Umpf fragt verbluefft: Woher kommt den dieser "
			+"Kobold auf einmal her? Naja, egal. "
			+"Danke fuers einfangen.\n")));
	      return 1;
	    }
	  
	}
    }              
  else
    {
      write (BS("Umpf sagt: Danke, aber das brauch ich nicht.\n"));
      obj->move(TP, M_NOCHECK);
    }
}
  
void seq1()
{
  TP->move(ROOM("dummy"), M_GO|M_SILENT|M_NO_SHOW);
  write (BS("Umpf sagt erfreut: Du hast es tatsaechlich geschafft "
	+"diesen Kobold einzufangen. Ich danke dir "
	+TP->name(WER,2)+". Ohne dich haette "
	+"ich das nie geschafft. Warte hier bitte einen Moment. "
	+"Ich hab da noch ein kleines Dankeschoen fuer dich.\n\n"));
  write("\n");
  call_out(("seq2"), 10);
}

void seq2()
{
  write (BS("Umpf dreht sich um und geht in Richtung Speisekammer.\n\n"));
  write("\n");
  call_out(("seq3"), 7);
}

void seq3()
{
  write (BS("Ploetzlich bleibt er abrupt stehen.\n\n"));
  write("\n");
  call_out(("seq4"), 7);
}

void seq4()
{
  write (BS("Er dreht sich zu dir um, ist kreidebleich und "
	+"faehrt sich nervoes durch das Haar.\n\n"));
  write("\n");
  call_out(("seq5"), 7);
}

void seq5()
{
  write (BS("Er meint zerknirscht:'Ich hab da etwas wichtiges vergessen. "
	+"Ich muss noch das magische Instrument meines Meisters "
	+"zusammenbauen. Aber ich glaube nicht, dass ich in der "
	+"Zeit die mir noch bleibt die Kueche wieder sauber machen "
	+"und dann noch das Instrument in Gang bringen kann. Wahrscheinlich "
	+"bedeutet dies das Aus fuer eine Chance auf eine Lehre.'\n"
	+"Umpf faengt an zu weinen.\n\n"));
  write("\n");
  call_out(("seq6"), 16);
}

void seq6()
{
  write (BS("Da dir der kleine Gnom leid tut, bietest du ihm an "
	+"das Instrument fuer ihn zusammenbauen. Umpf atmet "
	+"darauf wieder hoffend auf.\n\n"));
  write("\n");
  call_out(("seq7"), 8);
}

void seq7()
{
  write (BS("Er gibt dir einen Rubin und sagt: Mit diesem Rubin "
	+"kommst du in die oberen Stockwerke. Bau Du das "
	+"Instrument zusammen, ich schau, dass ich in der Zeit "
	+"die Kueche wieder auf Vordermann bringe. Ich hab leider "
	+"das Instrument noch nie zusammengebaut, also kann ich dir "
	+"dazu leider wenig sagen. Aber wenn du Fragen hast, frag mich "
	+"einfach. Vielleicht weiss ich ja doch etwas.\n"));
  write("\n");
  call_out(("seq8"), 16);
}  

void seq8()
{
  TP->move(ROOM("0_room1"), M_TPORT|M_SILENT);
}





















