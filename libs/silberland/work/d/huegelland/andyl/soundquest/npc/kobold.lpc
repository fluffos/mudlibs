inherit "std/npc";

#include <properties.h>
#include <language.h>
#include "../files.h"
#include <moving.h>
create()
{
  
  if (!is_clone(this_object())) return;
  
  ::create();    
  
  
  SetProp(P_SHORT, "Ein gemeiner Kobold");
  SetProp(P_LONG, "Das ist ein echt fieser Kobold.\n"
	  +"Er ist klein und sehr, sehr schnell. Er sieht dich aus "
	  +"boesen gruenen Augen an und ueberlegt was er dir wohl "
	  +"fieses antun koennte. Am liebsten wuerdest du ihm sofort "
	  +"was nachschmeissen. Den zu fangen ist sicher nicht "
	  +"so einfach.\n");
  SetProp(P_NAME, "Kobold");
  SetProp(P_NOATTACK, "entwischt Dir durch die Beine und tritt Dich einmal "
	  +"kraeftig in den Hintern.");  
  SetProp(P_GENDER, MALE);
  AddId(({"kobold", "gemeiner kobold", "\nsqkobold"})); 
  create_default_npc( 10 );
  SetProp(P_BODY, 10);
  SetProp(P_HANDS, ({" mit seinen ekligen Haenden.", 20}));
  SetProp(P_ALIGN, -500 ); 
  SetProp(P_RACE, "Kobold");
  SetProp(P_SMELL, "Der Kobold stinkt ziemlich stark (dir wird da richtig uebel)!");
  SetProp(P_XP, 1000);
  SetChats(2, 
	   ({
	     "Der Kobold spuckt dir auf den Kopf.\n",
	       "Der Kobold kreischt vergnuegt: Baetsch, du kriegst mich nicht!\n",
	       "Der Kobold meint: Also wenn ich so ausschauen wuerde wie du, wuerd ich mich schaemen.\n",
	       "Der Kobold zeigt dir seine Zunge und grinst dabei haemisch.\n",
	       "Der Kobold saust schnell zu dir und gibt dir einen Tritt in den Hintern.\n",
	       }) );
  
  AddDetail(("augen"),
	    "Die boesen gruenen Augen verheissen nichts Gutes.\n");
  
}

give_notify(object obj)
{  
  write (BS("Der Kobold will das nicht haben sondern spuckt Dir lieber voll ins Gesicht.\n"));
  obj->move(TP, M_NOCHECK);
}






























