inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../files.h"

create()
{
  
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Knuddel");
  SetProp(P_LONG, "Das Knuddel ist ein herziges kleines Pelzknaeul.\n"
	  +"So richtig zum knuddeln. Es macht einen ueberaus freundlichen "
	  +"Eindruck.\n");
  SetProp(P_NAME, "Knuddel");
  SetProp(P_GENDER, NEUTER);
  
  AddId("knuddel"); 
  
  create_default_npc( 10 );
  
  SetProp(P_SIZE, 45);
  SetProp(P_BODY, 35);
  SetProp(P_HANDS, ({" mit seinen kleinen Krallen", 12, DT_RIP}));
  SetProp(P_ALIGN, 600 ); 
  SetProp(P_RACE, "Knuddel");
  SetProp(P_XP, 600);
  
  SetChats(2, ({
    "Das Knuddel knuddelt Dich ganz lieb und fest.\n",
      "Das Knuddel quietscht vergnuegt.\n",
      "Das Knuddel kuschelt sich an dich.\n",
      "Das Knuddel kugelt sich ein wenig am Boden herum.\n",
      }) );
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  switch(gruppe) 
  {
    case "fies":
      call_out("react", 0, "schaut Dich knuddeltraurig an",
        "schaut "+TP->name(WEN)+" knuddeltraurig an");
      break;
    case "aergerlich":
      call_out("react", 0, "wird ploetzlich ganz klein", "wird ploetzlich ganz klein");
      break;
    case "traurig":
      call_out("react", 0, "leckt Dir troestend das Gesicht",
	     "leckt "+TP->name(WEM, 2)+" troestend das Gesicht");
      break;
    case "albern":
      call_out("react", 0, "knuddelt Dich grinsend",
	       "knuddelt grinsend "+TP->name(WEN));
      break;
    case "neutral":
      call_out("react", 0, "grinst Dich an", "grinst "+TP->name(WEN)+" an");
      break;
    case "intim":
      call_out("react", 0, "knuddelt Dich gaaanz fest",
                   "knuddelt "+TP->name(WEN)+" gaaanz fest");
      break;
    case "froh":
      call_out("react", 0, "grinst Dich knuddelig an",
             "grinst "+TP->name(WEN)+" knuddelig an");
      break;
    case "aengstlich":
      call_out("react", 0, "knuddelt Dich aufmunternd",
             "knuddelt "+TP->name(WEM)+" aufmunternd");
      break;
    case "frech":
      call_out("react", 0, "quietscht Dich an", "quietscht "+TP->name(WEN)+" an");
      break;
    case "nett":
      call_out("react", 0, "knuddelt Dich", "knuddelt "+TP->name(WEN));
      break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    tell_object(TP, BS(Name(WER, 1) + " "+victim+"."));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others+"."), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


































