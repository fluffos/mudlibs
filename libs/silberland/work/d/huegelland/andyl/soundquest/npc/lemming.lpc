inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../files.h"
create()
{
  
  if (!is_clone(this_object())) return;
  
  ::create(); 

  SetProp(P_SHORT, "Ein Lemming");
  SetProp(P_LONG, "Der Lemming hat ein braunes Fell und grosse Augen. "
	  +"Irgendwie scheint er jedoch nicht ganz normal zu "
	  +"sein da er immerzu mit einem Seil spielt. "
	  +"Er macht ansonsten aber einen sehr freundlichen Eindruck.\n");
  SetProp(P_NAME, "Lemming");
  SetProp(P_GENDER, MALE);
  
  AddId("lemming"); 
  
  create_default_npc( 8 );
  
  SetProp(P_BODY, 5);
  SetProp(P_HANDS, ({" mit seinen Nagezaehnen", 18, DT_RIP}));
  SetProp(P_ALIGN, 300 ); 
  SetProp(P_RACE, "Lemming");
  SetProp(P_XP, 400);


  SetChats(2, ({
      "Der Lemming spielt ein wenig mit dem Seil herum.\n",
      "Der Lemming schaut dich verwirrt an.\n",
      "Der Lemming macht eine Schlinge in sein Seil.\n",
      "Der Lemming legt eine Schlinge um seinen Hals und winkt dir "
      "zu.\n",
      }) );  

  CLONEME("/obj/seil");
}






































