inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
create()
{
  
  if (!is_clone(this_object())) return;
  
  ::create(); 
  
  SetProp(P_SHORT, "Ein Hamster");
  SetProp(P_LONG, "Der Hamster hat vollgefuellte Backen und ist "
	  +"damit beschaeftigt mehr in sie hineinzustopfen.\n"
	  +"Sein Fell ist braun und kuschelig. Er macht einen "
          +"ueberaus freundlichen Eindruck.\n");
  SetProp(P_NAME, "Hamster");
  SetProp(P_GENDER, MALE);
  
  AddId("hamster"); 
  
  create_default_npc( 6 );
  
  SetProp(P_BODY, 5);
  SetProp(P_SIZE, 18);
  SetProp(P_HANDS, ({" mit seinen kleinen Nagezaehnen", 16, DT_RIP}));
  SetProp(P_ALIGN, 300 ); 
  SetProp(P_RACE, "Hamster");
  SetProp(P_XP, 100);
  
  SetChats(2, ({
    "Der Hamster stopft sich wieder so einiges in die Backen.\n",
      "Der Hamster mustert dich neugierig.\n",
      "Der Hamster faengt an sein Fell zu putzen.\n",
      } ));
}






































