inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>

create()
{

  if (!is_clone(this_object())) return;

  ::create(); 

  SetProp(P_SHORT, "Eine Hornisse");
  SetProp(P_LONG, "Die Hornisse ist ein ziemlich grosses Insekt.\n"
	  +"Sie sieht aeusserst gefaehrlich aus. Ausserdem "
	  +"wirkt ihr Stachel ziemlich bedrohlich auf Dich.\n");
  SetProp(P_NAME, "Hornisse");
  SetProp(P_GENDER, FEMALE);
  
  AddId("hornisse"); 
  
  create_default_npc( 4 );
  
  SetProp(P_BODY, 3);
  SetProp(P_SIZE, 9);
  SetProp(P_HANDS, ({" mit ihrem Stachel", 20, DT_PIERCE}));
  SetProp(P_ALIGN, -250 ); 
  SetProp(P_RACE, "Insekt");
  SetProp(P_XP, 100);
  
}


