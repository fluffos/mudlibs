inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
create()
{

  if (!is_clone(this_object())) return;

  ::create(); 

  SetProp(P_SHORT, "Eine Maulwurfsgrille");
  SetProp(P_LONG, "Die Maulwurfsgrille sieht ziemlich boese aus.\n"
	  +"Sie hat kraeftige Zangen die nicht zu verachten sind und "
	  +"mit denen sie dich sicher ziemlich zwicken kann.\n");
  SetProp(P_NAME, "Maulwurfsgrille");
  SetProp(P_GENDER, FEMALE);
  
  AddId(({ "grille", "maulwurfsgrille"})); 
  
  create_default_npc( 11 );
  
  SetProp(P_BODY, 6);
  SetProp(P_SIZE, 17);
  SetProp(P_HANDS, ({" mit ihren kraeftigen Zangen", 18, DT_RIP}));
  SetProp(P_ALIGN, -300 ); 
  SetProp(P_RACE, "Maulwurfsgrille");
  SetProp(P_XP, 700);
  
}






































