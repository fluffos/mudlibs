inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;

  ::create(); 

  SetProp(P_SHORT, "Ein Rotkehlchen");
  SetProp(P_LONG, "Das Rotkehlchen trillert froehlich in der Gegend herum. "
	   "Eine angenehme Stimmung entsteht durch die Toene die "
	   "es von sich gibt.\n");
  
  SetProp(P_NAME, "Rotkehlchen");
  SetProp(P_GENDER, NEUTER);
  
  AddId(({"rotkehlchen", "vogel"})); 
  
  create_default_npc( 8 );
  
  SetProp(P_SIZE, 20);
  SetProp(P_HANDS, ({" mit seinem kleinen Schnabel", 75, DT_PIERCE}));
  SetProp(P_ALIGN, 600 ); 
  SetProp(P_RACE, "Vogel");
  
  
  SetChats(2, ({
    "Das Rotkehlchen trillert ein lustiges Lied vor sich hin.\n",
      "Das Rotkehlchen flattert ungeduldig mit den Fluegeln.\n",
      "Das Rotkehlchen zwitschert eine lustige Melodie.\n",
      }) );
}

