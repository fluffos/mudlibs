inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>

create()
{

  if (!is_clone(this_object())) return;

  ::create(); 

  SetProp(P_SHORT, "Eine Wespe");
  SetProp(P_LONG, "Die Wespe sieht gefaehrlich und boese aus.\n"
	  +"Sie schaut dich mit boesen grossen runden Augen genau an. "
	  +"Ihr Stachel ziemlich bedrohlich auf Dich.\n");
  SetProp(P_NAME, "Wespe");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, 2);
  AddId("wespe"); 
  
  create_default_npc( 4 );
  
  SetProp(P_BODY, 2);
  SetProp(P_HANDS, ({" mit ihrem Stachel", 20, DT_PIERCE}));
  SetProp(P_ALIGN, -200 ); 
  SetProp(P_RACE, "Insekt");
  SetProp(P_XP, 200);
  
}













