// vereb02.c by AnDyL
// Weg nach Nemesia.
// 02-10-1997
// Details, Sound, Smell


inherit "std/room";
#include "/d/def.h"
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg im Huegelland" );
  SetProp( P_INT_LONG, 
          "Ein Weg im Huegelland. \n"
        + "Dir faellt auf das viele Pflanzen hier verdorrt sind. \n"
        + "Die Pflanzen die noch bluehen sind Unkraut. \n" );
 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 17]) );

  AddDetail( ({ "sonne" }),
    "Die Sonne ist grossteils von Wolken verdeckt. \n");
  AddDetail( ("himmel"),
    "Der Himmel ist mit Wolken uebersaet. \n"
    + "Von seinem schoenen blau ist nur wenig zu sehen. \n");
  AddDetail ( ("huegelland"),
    "Ja, du befindest dich im Huegelland. \n");
  AddDetail( ({ "wolken"}),
    "Die Wolken sind hier ziemlich dicht. \n");
  AddDetail( ({ "boden"}),
    "Der Boden ist grossteils von Unkraut und verdorrten Pflanzen bedeckt. \n"
  + "Ausserdem faellt dir ein Stein auf. \n");
   AddDetail( ("stein"),
    "Als du den Stein untersuchst endeckst du eine Markierung.  \n");
   AddDetail( ("markierung"),
    "Auf der Makierung steht: \n" 
    +" \n"  
    +"          Wanderweg c1 nach Xeria. \n"
    +" \n"
    +"                  markiert von der V.H.O.S.W. \n"
    +"                            (Vereinigte Hobbit Organisation \n"
    +"                                      fuer Sicheres Wandern) \n");
  AddDetail( ({"unkraut"}),
    "Ihhh Unkraut, angewidert wendest du deinen Blick ab. \n");
  AddDetail( ({ "weg"}),
    "Das ist ein Weg im Huegelland. Gibt es dazu noch Fragen? \n");
  AddDetail( ({"pflanzen", "pflanzen"}),
    "Fast alle sind verrdort, obwohl hier eigentlich genug Regen faellt. \n"
  + "Das ganze wird dir allmaehlich unheimlich. \n");
  AddDetail( ({ "fragen" }),
    "Anscheinend gibt es doch noch Fragen. Nur Antworten gibt es keine. \n");

  AddSound( DEFAULT_SOUND,
    "Es ist auffallend ruhig hier. \n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
    "Es riecht nach verdorrten Pflanzen. \n");

  AddExit( "nordosten", "./vereb01.lpc" );
  AddExit( "westen", "./vereb03.lpc" );
}




