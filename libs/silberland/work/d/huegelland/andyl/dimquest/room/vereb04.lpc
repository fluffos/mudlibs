#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/huegelland/andyl/weg/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:10]));
  SetProp (P_INT_SHORT, "Ein Weg nach Nemesia");
  SetProp (P_INT_LONG, "Ein Weg nach Nemesia. \n"
                     + "Die Landschaft sieht hier oed und kahl aus. \n"
                     + "Am Wegesrand liegen einige Tierkadaver. \n");
  
  // ROOM DESCRIPTION END

  // DETAILS START
     AddDetail( ("himmel"),
     "Er ist komplett mit pechschwarzen Wolken ueberzogen. \n"
     + "Die Sonne hat hier nicht die geringste Chance durchzudringen. \n");
     AddDetail( ("sonne"),
       "Du siehst sie nicht. Aber ihr Licht fehlt dir. \n" 
     + "Das du ueberhaupt noch was siehst, kommt daher, \n"
     + "dass ein unnaturliches gruenes Licht die Landschaft ueberzieht. \n");        AddDetail( ("licht"),
      "Das Licht duerfte magisch sein. Es sieht allerdings nicht freundlich aus. \n"); 
     AddDetail( ("boden"),
     "Der Boden sieht ungesund grau aus und er ist auesserst sproede. \n");
     AddDetail( ("weg"),
     "Der Weg zieht sich tiefschwarz durch die Lanschaft. \n");
     AddDetail( ("landschaft"),
     "Die Huegel, der Boden, ja selbst der Himmel wirken hier graeslich. \n");
     AddDetail( ("huegel"),
     "Ganz im Gegensatz zum Rest des Huegellandes, sind die Huegel hier \n"
     + "unbewachsen und in graeslichen Schwarz-, Grau- und Brauntoenen. \n");
     AddDetail( ({ "rand", "wegesrand" }),
     "Die Leichen von einigen Tieren liegen am Wegesrand verstreut. \n");
     AddDetail( ({"kadaver", "leichen" , "tierkadaver", "tieren", "tiere"}),
     "Die sind furchtbar zerfetzt worden. \n"
   + "Dein Magen dreht sich ein paar mal herum. \n"
   + "Die Leiche eines Rehs faellt dir besonders auf. \n");
     AddDetail( ({"leiche", "reh"}),
     "Als du die Leiche des Rehs untersuchst faellt dir \n"
     + "auf das ein Klaue in dem Reh steckt. \n");
     AddDetail( ("klaue"),
     "Die Klaue ist mindestens 50 cm lang. \n"
     + "Welches Monster war da am Werk? \n");
     AddDetail( ({"magen"}),
     "Dein Magen ist jetzt ordentlich verknotet. \n");  
  // DETAILS END

  AddSound( DEFAULT_SOUND,
    "Verzweifelte Schreie veraengstigter Tiere dringen an dein Ohr. \n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
    "Es stinkt hier erbaermlich nach Verwesung. \n");

  // EXITS START
  AddExit ("nordwesten", ROOM("vereb03"));
  AddExit ("suedwesten", ROOM("vereb05"));
  // EXITS END

  // ITEMS START
  // ITEMS END

}


