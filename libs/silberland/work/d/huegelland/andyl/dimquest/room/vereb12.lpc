#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/huegelland/andyl/weg/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:21]));
  SetProp (P_INT_SHORT, "Ein Weg");
  SetProp (P_INT_LONG, "Ein Weg nach Nemesia");
  // ROOM DESCRIPTION END

  // DETAILS START
  // DETAILS END

  // EXITS START
  AddExit ("suedosten", ROOM("vereb11"));
  AddExit ("sueden", ROOM("vereb16"));  
  // EXITS END

  // ITEMS START
  // ITEMS END

}
