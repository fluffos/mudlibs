// Details, Sound, Smell


inherit "std/room";
#include "/d/def.h"
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg im Huegelland" );
  SetProp( P_INT_LONG, 
    "Ein Weg im Huegelland. \n"
  + "Der Blick auf die Landschaft erfreut dein Augen. \n"
  + "Einzig ein verdorrter Strauch faellt dir stoerend auf. \n" ); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20])) ;

  AddDetail( ({ "busch", "strauch" }),
    "Wie konnte der Strauch hier verdorren? \n"
    + "Es hat mit Sicherheit genug geregnet. Du schauderst. \n"); 
  AddDetail( ({ "sonne" }),
    "Die Sonne scheint dir angenehm auf deinen Koerper. \n"
    + "Ah, ist das ein gutes Gefuehl. \n");
  AddDetail( ("landschaft"),
    "Die Landschaft ist ein Traum. \n" 
   + "Gruene grasbewachsene Huegel ueberall. Ahhh, schoen. \n");
  AddDetail( ({ "himmel"}),
    "Der Himmel ist schoen blau. \n" 
  + " Nur ein paar Wolken sind zu sehen und die Sonne strahlt. \n");
  AddDetail( ("huegel"),
    "Die Huegel hier gefallen dir. \n");
  AddDetail( ({ "wolken"}),
    "Die sehen kuschelweich aus. \n");
  AddDetail( ({ "boden"}),
    "Der Boden ist grossteils mit Gras und etwas Unkraut bedeckt. \n"
  + "Ein Stein faellt dir auf. \n");
  AddDetail( ({"unkraut"}),
    "Ihhh Unkraut, angewidert wendest du deinen Blick ab. \n");
  AddDetail( ({ "weg"}),
    "Das ist ein Weg im Huegelland. Gibt es dazu noch Fragen ? \n");
  AddDetail( ({"fragen"}),
    "Anscheinend gibt es doch noch Fragen. Nur Antworten gibt es keine. \n");
  AddDetail( ({"auge", "augen"}),
    "Wenn du dich nicht irrst, koennten das deine Augen sein \n");
  AddDetail( ("stein"),
    "Als du den Stein untersuchst endeckst du eine Markierung.  \n");
  AddDetail( ("markierung"),
    "Auf der Makierung steht: \n" 
   +" \n"  
   +"          Wanderweg c1 nach Xeria. \n"
   +" \n"
   +"                  markiert von der V.H.O.S.W. \n"
   +"                            (Vereinigte Hobbit Organisation \n"
   +"                                      fuer Sicheres Wandern) \n");
  AddDetail( ({"Huegelland", "huegelland" }),
    "Das Huegelland ist eine schoene Gegend. Deswegen leben \n"
  + "die Hobbits hier. \n");
  AddDetail( ({"gras"}),
    "Es sieht schoen gruen aus.");  
  AddDetail( ("insekten"),
    "Die tummeln sich alle im Gras.");
  AddDetail( ("gras"),
    "Du bist wahnsinnig ueberrascht, dass das Gras gruen ist \n");
 
  AddSound( DEFAULT_SOUND,
    "Du hoerst die Geraeusche zahlreicher Insekten. \n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
    "Der angenehme Geruch von Gras steigt dir in die Nase. \n");

  AddExit( "norden", "/players/andyl/workroom.lpc" );
  AddExit( "suedwesten", "./vereb02" );
}


















