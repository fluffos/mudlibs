#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/huegelland/andyl/weg/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:15]));
  SetProp (P_INT_SHORT, "Ein Rastplatz");
  SetProp (P_INT_LONG, "Ein verwahrloster Rastplatz. \n"
                     + "Nicht einmal das Unkraut scheint hier ueberlebt zu haben.\n"
                     + "Ausserdem wurde ein grosses Warnschild hier aufgestellt. \n");                                                                     
 
  // ROOM DESCRIPTION END

  // DETAILS START
     AddDetail( ({"himmel"}),
     "Er ist von dunklen Wolken bedeckt. \n");
     AddDetail( ({"wolken"}),
     "Das sind auessest dunkle Wolken. \n");
     AddDetail( ({"warnschild", "schild"}),
     "Ein grosses Warnschild. Es sieht sehr alt aus. \n"
     "Vielleicht solltest du es lesen. \n");  
     AddDetail( ({"loch"}),
     "In dem Loch liegt der Kadaver eines Hasen. \n");
     AddDetail( ({"kadaver", "hase"}),
     "Der Hase wurde brutal zerstueckelt. Das gefaellt dir absolut nicht. \n"
     + "Welches Wesen hinterlaesst so grosse Bisspuren ? \n");
     AddDetail( ({"spuren", "bisse", "bisspuren"}),
     "Die sind wirklich riesig. \n");
     AddDetail( ({"unkraut"}),
     "Selbst das Unkraut ist hier verdorrt. \n" 
     + "Wahrscheinlich war hier Magie im Spiel. \n");
     AddDetail( ({"boden"}),
     "Der Boden ist kahl und leer. Einzig ein Loch faellt dir auf. \n");
     AddDetail( ({"platz", "rastplatz"}),
     "Der Rastplatz sieht sehr verwahrlost aus. Was einmal Tische und \n"
     "Baenke waren ist jetzt nur noch ein Haufen morscher Holzbretter. \n"); 
     AddDetail( ({"tische", "baenke", "bretter", "holzbretter", "haufen"}),
     "Egal was es vorher war, jetzt sind es nur noch morsche Holzbretter. \n");
  // DETAILS END

  AddSound( DEFAULT_SOUND,
    "Die Stille hier macht dich nervoes. \n");
  AddSmell( ({DEFAULT_SMELL, "geruch"}),
    "Hier riecht es nach Verwesung. Wo kommt dieser Geruch her? \n");

  // EXITS START
  AddExit ("osten", ROOM("vereb02"));
  AddExit ("suedosten", ROOM("vereb04"));
  // EXITS END

  // ITEMS START
  // ITEMS END
}








