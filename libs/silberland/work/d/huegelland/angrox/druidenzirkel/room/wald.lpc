// /d/huegelland/angrox/druidenzirkel/room/wald.c
// 061097  Angrox@SilberLand

#pragma strong_types

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/gilden/druidenzirkel/druiden.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT,"Ein ueberwucherter Pfad");
  SetProp(P_INT_LONG, BS(
    "Du befindest Dich auf einem ueberwuchertem Pfad inmitten des Waldes. "
    "Um Dich herum ragen Baeume, die weit aelter als Du sind, in den Himmel "
    "empor. Der Boden ist mit Bueschen der verschiedensten Arten bedeckt, "
    "sodass das Sonnenlicht den Boden wohl nie erreicht. Die Luft ist "
    "erfuellt mit den Geruechen des Waldes, in der Ferne zwitschert ein "
    "Vogel. Der Pfad windet sich durch das Unterholz Richtung Nordwesten."));
  SetProp(P_INDOORS,0); // nur damit der Karren hier nicht herfaehrt!
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:13, ENV_TERRAIN: TT_FOREST]));
  SetProp(P_LIGHT,1);
 
  AddDetail( ({"vogel", "ferne"}),
      "Du kannst den Vogel nicht sehen, nur hoeren.");

  AddDetail( ({"sonne", "sonnenlicht", "licht"}),
      "Das Licht der Sonne erreicht den Boden hier nie.");

  AddDetail("pfad", 
    "Der Pfad ist mit Bueschen ueberwachsen und kaum noch zu erkennen. "
    "Er windet sich Richtung Nordwesten.");

  AddDetail("richtung", 
    "Der Pfad windet sich nach Nordwesten.");
  
  AddDetail("nordwesten", 
    "Dorthin windet sich der Pfad.");

  AddDetail("buesche", 
    "Die Buesche sind vorwiegend Dornengestruepp. Du solltest aufpassen, "
    "dass Du Dich nicht verletzt.");

  AddDetail("dornengestruepp", 
    "Das Dornengestruepp sieht nicht ungefaehrlich aus. Es wuchert schon "
    "teilweise ueber den Pfad.");

  AddDetail(({"boden", "waldboden"}),
    "Der Waldboden ist mit Bueschen ueberwachsen. Ein Pfad schlaengelt sich "
    "Richtung Nordwesten.");

  AddDetail("himmel", 
    "Durch das Blaetterdach kannst Du den Himmel kaum erkennen. Nur ein paar "
    "Sonnenstrahlen dringen zu Dir herunter.");

  AddDetail( ({"dach", "blaetterdach", "zweige"}),
    "Die Zweige der Baeume bilden fast ein richtiges Dach ueber dem Pfad.");

  AddDetail(({"baeume", "giganten", "ehrfurcht"}),
    "Die alten Baeume ragen majestaetisch in den Himmel. Du erschauderst "
    "vor Ehrfurcht fuer diese urtuemlichen Giganten.");

  AddDetail("unterholz", 
    "Das Unterholz hier ist so dicht, dass kaum ein Sonnenstrahl den Boden "
    "beruehrt.");

  AddDetail(({"sonnenstrahl", "sonnenstrahlen"}),
    "Nur einzelne Sonnenstrahlen dringen bis zum Boden durch.");
  AddDetail( "wald",
      "Du stehst mitten im Wald.");
  AddDetail( "dornen",
      "Gefaehrliche Dornen.");
  AddDetail( ({"art", "arten"}),
      "Die vorherrschende Art sind die Dornengestrueppe.");


  AddSmell(DEFAULT_SMELL, "Es riecht hier nach Wald.");
  AddSmell( ({"wald", "luft", "gerueche", "geruch"}),
      "Herrlich aromatisch.");
  AddSound(DEFAULT_SOUND, "Irgendwo zwitschert ein Vogel.");
  AddSound("vogel", "Du kannst nicht genau feststellen, wo der Vogel sitzt, "
            "aber sein Gesang ist sehr schoen.");
  AddSound(({"gesang", "zwitschern"}),
      "Das Zwitschern des Vogels ist sehr schoen.");

  AddExit("nordwesten", "/gilden/druidenzirkel");
  AddExit("suedosten", "/d/huegelland/feyaria/weg/room/wald1");

}

