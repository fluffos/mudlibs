inherit "/d/huegelland/angrox/druidenzirkel/room/std_monolith"; 
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/gilden/druidenzirkel/druiden.h"

int kugel;

void create()
{
  ::create();
  kugel=1;
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Auf einer Lichtung");
  SetProp(P_INT_LONG, 
          "Du befindest Dich auf einer Lichtung, die ueber und ueber "
          "mit Gras bedeckt ist. Vor Dir befindet sich ein grosser "
          "Monolith, der etwa fuenf Schritt hoch sein mag. Auf einer "
          "Seite ist eine grosse Rune in den Monolithen eingelassen. "
          "Auf der Lichtung rings um Dich erkennst Du weitere sechs "
          "Monolithen, von denen einer zerbrochen ist. In der Mitte "
          "der Lichtung steht ein Altar.");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:13]));
  SetProp(P_ELEMENTAL_ROOM, WASSER);

  AddDetail(({"raum", "lichtung"}), 
          "Auf der Lichtung befindet sich ein Monolith, auf dem "
          "eine Rune eingraviert ist.");
  AddDetail("gras", 
          "Das Gras hier ist gruen und sehr saftig.");
  AddDetail("boden", 
          "Der Boden ist ueber und ueber mit Gras bedeckt.");
  AddDetail("himmel", 
          "Am Himmel scheint die Sonne.");
  AddDetail("sonne", 
          "Die scheint vom Himmel herab.");
  AddDetail("monolith", 
          "Grau und verwittert, und dennoch ungebeugt ragt dieser "
          "Monolith in den Himmel. Auf einer Seite ist eine Rune "
          "in den Stein eingelassen.");
  AddDetail("stein", 
          "Der Monolith besteht aus grauem Gestein.");
  AddDetail("gestein", 
          "Hmm ... Du weisst nicht, welches Gestein das ist.");
  AddDetail(({"rune","symbol"}), 
          "Die Rune stellt mehrere waagrechte Wellenlinien dar.");
  AddDetail(({"linien", "wellenlinien"}), 
          "Offenbar ein Symbol fuer Wasser.");
  AddDetail(({"wasser", "element"}),
          "Dieser Monolith representiert wohl das Element Wasser im "
          "Druidenzirkel.");
  AddDetail("monolithen", 
          "Die anderen Monolithen sind rund um den Altar in der "
          "Mitte der Lichtung gruppiert.");
  AddDetail("mitte", 
          "In der Mitte der Lichtung steht ein Altar.");
  AddDetail("altar", 
          "Der Altar scheint ebenfalls aus Stein zu bestehen. Allerdings "
          "kannst Du auf die Entfernung nicht viel erkennen.");
  AddDetail( "entfernung",
          "Zu weit weg.");
  AddDetail("seite", 
          "Die Seite, die Dir zugewandt ist, traegt die Rune.");
  AddDetail( ({"schritt", "laenge"}),
          "Fuenf Schritte wuerdest Du brauchen, um die Laenge des Monolithen abzuschreiten.");

  AddSmell(DEFAULT_SMELL, "Es riecht hier angenehm nach Wald.");
  AddSmell("wald", "Hmm ... herrlich.");
  AddSound(DEFAULT_SOUND, "Eine andaechtige Stille liegt ueber der "
         "Lichtung.");
  AddSound("stille", "Nichts ist zu hoeren.");
  AddExit("suedwesten", "/gilden/druidenzirkel");
}
