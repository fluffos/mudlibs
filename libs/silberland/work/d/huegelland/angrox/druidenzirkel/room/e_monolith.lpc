inherit "/d/huegelland/angrox/druidenzirkel/room/std_monolith";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/gilden/druidenzirkel/druiden.h"

int kugel;

void create()
{
  ::create();
  kugel=1;
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Auf einer Lichtung");
  SetProp(P_INT_LONG, 
          "Du befindest Dich auf einer Lichtung, die ueber und ueber "
          "mit reifueberzogenen Gras bedeckt ist. Ein grosser, mit Reif "
          "ueberzogener Monolith "
          "ragt vor Dir in den Himmel. Auf der Seite, die der Mitte "
          "der Lichtung zugewandt ist, befindet sich eine Rune in den "
          "Monolithen eingelassen. Andere Monolithen befinden sich auf "
          "der Lichtung, Du zaehlst sechs andere, von denen einer "
          "zerstoert ist. In der Mitte der Lichtung befindet sich ein "
          "Altar.");

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:-20]));
  SetProp(P_ELEMENTAL_ROOM, EIS);

  AddDetail(({"raum", "lichtung"}), 
          "Auf der Lichtung befindet sich ein Monolith, auf dem "
          "eine Rune eingraviert ist.");
  AddDetail("gras", 
          "Das Gras hier ist mit Reif ueberzogen.");
  AddDetail("boden", 
          "Der Boden ist gefroren.");
  AddDetail("himmel", 
          "Am Himmel scheint die Sonne.");
  AddDetail("sonne", 
          "Die scheint vom Himmel herab, aber sie waermt Dich nicht.");
  AddDetail("monolith", 
          "Grau und verwittert, und dennoch ungebeugt ragt dieser "
          "Monolith in den Himmel. Er ist mit Reif ueberzogen. "
          "Auf einer Seite ist eine Rune "
          "in den Stein eingelassen.");
  AddDetail("stein", 
          "Der Monolith besteht aus grauem Gestein, das voellig mit Reif "
          "ueberzogen ist.");
  AddDetail(({"reif", "eis"}),
          "Reif ueberzieht den gesamten Monolithen, was ihm ein weisses "
          "Aussehen verleiht. Auch das Gras ist mit Reif ueberzogen.");
  AddDetail("aussehen", 
          "Der Monolith ist mit Reif ueberzogen.");
  AddDetail("gestein", 
          "Hmm ... Du weisst nicht, welches Gestein das ist.");
  AddDetail(({"rune","symbol"}), 
          "Die Rune kannst Du nur nicht entziffern, weil sie vom Eis bedeckt ist.");
  AddDetail("monolithen", 
          "Die anderen Monolithen sind rund um den Altar in der "
          "Mitte der Lichtung gruppiert.");
  AddDetail("mitte", 
          "In der Mitte der Lichtung steht ein Altar.");
  AddDetail("altar", 
          "Der Altar scheint ebenfalls aus Stein zu bestehen. Allerdings "
          "kannst Du auf die Entfernung nicht viel erkennen.");
  AddDetail( "entfernung",
      "Zu weit weg.");
  AddDetail("seite", 
          "Die Seite, die Dir zugewandt ist, traegt die Rune.");

  AddSmell(DEFAULT_SMELL, "Es riecht hier angenehm nach Wald.");
  AddSmell("wald", "Hmm ... herrlich.");
  AddSound(DEFAULT_SOUND, "Eine andaechtige Stille liegt ueber der "
         "Lichtung.");
  AddSound("stille", "Nichts ist zu hoeren.");

  AddExit("osten", "/gilden/druidenzirkel");
}
