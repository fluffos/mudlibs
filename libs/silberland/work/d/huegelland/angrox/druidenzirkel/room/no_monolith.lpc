inherit "/d/huegelland/angrox/druidenzirkel/room/std_monolith"; 
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/gilden/druidenzirkel/druiden.h"

int kugel;

void create()
{
  ::create();
  kugel=1;
  SetProp(P_LIGHT,1);
  SetProp(P_INT_SHORT,"Auf einer Lichtung");
  SetProp(P_INT_LONG, 
          "Du befindest Dich auf einer grossen Lichtung. Vor Dir "
          "steht ein Monolith, der etwa in Schulterhoehe zersplittert "
          "ist. Der obere Teil des Monolithen liegt auf dem "
          "grasbedeckten Boden. Auf der Lichtung befinden sich noch sechs "
          "andere Monolithen. Im Zentrum der Lichtung befindet sich "
          "ein Altar.");
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_FOREST, ENV_TEMPERATURE:13]));

  AddDetail(({"raum", "lichtung"}), 
          "Auf der Lichtung befindet sich ein Monolith, auf dem "
          "eine Rune eingraviert ist.");
  AddDetail("gras", 
          "Das Gras hier ist gruen und sehr saftig.");
  AddDetail("boden", 
          "Der Boden ist ueber und ueber mit Gras bedeckt. Eine Haelfte "
          "des Monolithen liegt am Boden.");
  AddDetail("himmel", 
          "Am Himmel scheint die Sonne.");
  AddDetail("sonne", 
          "Die scheint vom Himmel herab.");
  AddDetail("monolith", 
          "Der Monolith ist in der Mitte zerbrochen. Der obere "
          "Teil des Monolithen liegt am Boden. Offenbar hat ein "
          "Blitz ihn zerstoert.");
  AddDetail("stein", 
          "Der Monolith besteht aus grauem Gestein.");
  AddDetail("gestein", 
          "Hmm ... Du weisst nicht, welches Gestein das ist.");
  AddDetail("monolithen",
          "Die anderen Monolithen sind rund um den Altar im Zentrum "
          "der Lichtung gruppiert.");
  AddDetail("zentrum", 
          "Im Zentrum der Lichtung steht ein Altar.");
  AddDetail("altar", 
          "Der Altar scheint ebenfalls aus Stein zu bestehen. Allerdings "
          "kannst Du auf die Entfernung nicht viel erkennen.");
  AddDetail("mitte", 
          "Der Monolith scheint in der Mitte von einem Blitz in zwei "
          "Haelften gespalten worden zu sein.");
  AddDetail(({"haelften", "haelfte", "teil"}),
          "Eine Haelfte liegt am Boden, die andere steht noch.");
  AddDetail("blitz", 
          "Den Spuren nach zu urteilen muss es ein gewaltig maechtiger Blitz "
          "gewesen sein.");
  AddDetail(({"spuren", "blitzspuren"}),
          "Die Blitzspuren am Monolithen gehen durch eine bis zur "
          "Unkenntlichkeit zerstoerte Rune.");
  AddDetail("rune", 
          "Du kannst sie nicht mehr genau erkennen.");
  AddDetail("unkenntlichkeit", 
          "Die Rune ist bis zur Unkenntlichkeit verschmort.");
  AddDetail("entfernung", 
          "Naja, auf der Lichtung halt.");
  AddDetail( ({"schulterhoehe", "schulter"}),
          "Etwa so hoch wie Deine Schulter.");

  AddSmell(DEFAULT_SMELL, "Es riecht hier angenehm nach Wald.");
  AddSmell("wald", "Hmm ... herrlich.");
  AddSound(DEFAULT_SOUND, "Eine andaechtige Stille liegt ueber der "
         "Lichtung.");
  AddSound("stille", "Nichts ist zu hoeren.");
  AddExit("suedosten", "/gilden/druidenzirkel");
}
