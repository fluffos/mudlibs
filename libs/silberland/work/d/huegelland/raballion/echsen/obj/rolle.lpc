// /d/huegelland/raballion/echsen/obj/rolle.c
// Eine Pergamentrolle
// 2004-07-15  Raballion@

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

#define MASTERDIR "/d/huegelland/raballion/echsen/obj/"
#define MASTERMOD "echsenrunenmaster"

int rollennr;
int trans;

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine echsische Pergamentrolle");
  SetProp(P_LONG, BS( 
    "Auf dieser Rolle steht etwas geschrieben und man kann es eventuell lesen.") );
  SetProp(P_NAME, "Pergamentrolle");
  SetProp(P_GENDER, FEMALE);
  AddId("pergamentrolle");
  AddId("rolle");
  AddId("erolle");

  SetProp(P_MATERIAL, MAT_PERGAMENT );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  AddCmd( ({"lies", "lese"}), "lies");
  rollennr_setzen(random(8));
}

int lies(string str)
{
  notify_fail("In was willst du lesen?\n");
  if( !str ) return 0;
  if( !id(str) ) return 0;
  notify_fail("In sowas kannst Du nicht lesen.\n");

  if( id(str) )
  {
    if(rollennr)
    {
      write((string)call_other(MASTERDIR+MASTERMOD, "setze_text_in_runen", rollennr) + "\n");
      if (trans == 1)
        {
        write("Darunter steht in zittriger und angespannter Schrift:\n\n");
        write((string)call_other(MASTERDIR+MASTERMOD, "query_text", rollennr) + "\n");
        }
      say(CAP_TPN+" liest eine Pergamentrollem.\n");
    }
    else
      write("Leider gibt es auf dieser Pergamentrolle nichts zu lesen.\n");
    return 1;
  }
  return 0;
}

int rollennr_setzen(int nr)
{
rollennr = nr;
return 1;
}

int trans_setzen(int nr)
{
trans = nr;
return 1;
}

int trans_status()
{
return trans;
}

