inherit "/std/room";

#include "../def.h"

#include <properties.h>
#include <language.h>

#define MASTERDIR "/d/huegelland/raballion/echsen/obj/"
#define raba(x) if (find_player("raballion")) tell_object(find_player("raballion"),(x))

// administration
void save_modul();
//string query_status();

// DB Abfrage
int mmaze (string str);
int mdisplay ();
int go_deep(string raum, string araum);
int go();

int mmaze2 (string str);
int mdisplay2 ();
