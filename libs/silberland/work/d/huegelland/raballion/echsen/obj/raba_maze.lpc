int mmaze2(string str)
{
string * cmdl;
int i, j;
int x, y;
string ausgangNord;
string ausgangNordWest;
string ausgangSued;
string ausgangSuedWest;
string ausgangOst;
string ausgangNordOst;
string ausgangWest;
string ausgangSuedOst;


  maze_map = ([]);
  sizex = 0;
  sizey = 0;
  visit = ([]);

  i=0;
  j=0;
  x=0;
  y=0;

  notify_fail("Was willst du fuer ein Maze bauen?\n");
  if( !str ) return 0;

  str = lower_case(str);
  cmdl = explode(str, " ");
//  raba("anzahl: "+sizeof(cmdl)+"\n");
  if ( (sizeof(cmdl) != 2) || (strlen(cmdl[0]) <= 0) || (strlen(cmdl[1]) <= 0 )  )
    {
    return 0;
    }

  sizex = (int)cmdl[0];
//  raba ("sizex: "+sizex+"\n");
  sizey = (int)cmdl[1];
//  raba ("sizey: "+sizey+"\n");

  for (x=1; x<=sizex; x++)
    {
    for (y=1; y<=sizey; y++)
      {
      if (x == 1)
        {
        ausgangNord = "";
        ausgangNordWest = "";
        ausgangNordOst = "";
        }
      else
        {
        ausgangNord = (string)(x-1)+"_"+(string)(y);
        ausgangNordWest = (string)(x-1)+"_"+(string)(y-1);
        ausgangNordOst = (string)(x-1)+"_"+(string)(y+1);
        }
      if (x == sizex)
        {
        ausgangSued = "";
        ausgangSuedWest = "";
        ausgangSuedOst = "";
        }
      else
        {
        ausgangSued = (string)(x+1)+"_"+(string)(y);
        ausgangSuedWest = (string)(x+1)+"_"+(string)(y-1);
        ausgangSuedOst = (string)(x+1)+"_"+(string)(y+1);
        }
      if (y == 1)
        {
        ausgangWest = "";
        ausgangNordWest = "";
        ausgangSuedWest = "";
        }
      else
        {
        ausgangWest = (string)(x)+"_"+(string)(y-1);
        }
      if (y == sizey)
        {
        ausgangOst = "";
        ausgangNordOst = "";
        ausgangSuedOst = "";
        }
      else
        {
        ausgangOst = (string)(x)+"_"+(string)(y+1);
        }
//      raba ("hinzugefuegt: "+(string)x+"_"+(string)y+"mit: "+ausgangNord+" "+ausgangSued+" "+ausgangOst+" "+ausgangWest+"\n");
      maze_map += ([(string)x+"_"+(string)y  : ausgangNord; ausgangSued; ausgangOst; ausgangWest; ausgangNordOst; ausgangNordWest; ausgangSuedWest; ausgangSuedOst ]);
      visit += ([(string)x+"_"+(string)y: 0 ]);
      }
    }
//raba("Groesse von maze_map: "+sizeof(maze_map)+"\n");
//raba("Groesse von visit: "+sizeof(visit)+"\n");
  write("Alle regulaeren Ausgaenge berechnet.\n");
//    go_deep("2_1","");
//    mdisplay();
//    save_modul();
return 1;
}

int go2()
{
  go_deep2("1_2","");
  write ("Maze ist berechnet.\n");
  return 1;
}

int go_deep2(string raum, string araum)
{
int i;
int j;
int k;
string go;
mapping heaper;
mixed *heaper_k;

  heaper = ([]);

  //raba("godeep:"+raum+"und"+araum+"\n");
  visit[raum] = 1;
  // heaper aufbauen; alle weiteren Raeume ohne Aufrufraum
  for (i=0; i<8; i++)
    {
    if ( (maze_map[raum,i] != "") && (maze_map[raum,i] != araum) && (visit[maze_map[raum,i]] == 0) )
      {
      heaper += ([ maze_map[raum,i] : 0 ]);
      }
    }

  while (sizeof(heaper) > 0)
    {
    // alle indices der noch zu besuchenden Raeume
    heaper_k = m_indices(heaper);
    // einen auswaehlen
    i = random (sizeof(heaper_k));

    if ((visit[heaper_k[i]]) == 1)
      {
      // ausgewaehlter raum war schon besucht von wo
      // loesche bei ihm uns heraus
      //raba("  Ausgewaehlter war schon besucht"+(heaper_k[i])+".\n");
      for (j=0; j<8; j++)
        {
        if ( (maze_map[heaper_k[i],j] == raum) )
          {
          // loesche bei ihm uns heraus
          maze_map[heaper_k[i],j] = "";
          }
        if ( maze_map[raum,j] == heaper_k[i] )
          {
          // loesche bei uns ihn heraus
          maze_map[raum,j] = "";
          }
        }
      }
    else
      {
      // unbesuchter Raum, dann gehen wir mal hin und besuchen ihn
      go_deep2(heaper_k[i],raum);
      }
    // loesche heaper_k[i] aus der heaper liste, weil schon mal dort
    heaper -= ([ heaper_k[i] ]);
    }
}

