// /d/huegelland/raballion/echsen/obj/trans.c
// Ein Uebersetzungsbuch fuer echsische Runen (Translator)
// 2004-07-15  Raballion@

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

#define MASTERDIR "/d/huegelland/raballion/echsen/obj/"
#define MASTERMOD "echsenrunenmaster"
#define raba(x) if (find_player("raballion")) tell_object(find_player("raballion"),(x))

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Uebersetzungsbuch \"Echsisch\"");
  SetProp(P_LONG, BS( 
    "Ein Uebersetzungsbuch fuer echsische Runen. Das sogenannte Sacz. "
    "Es traegt den lapidaren Namen: \"Echsisch Fuer Dummis\" "
    "Man kann damit Runen (an der Wand) oder echsische Pergamentrollen uebersetzen." ));
  SetProp(P_NAME, "Uebersetzungsbuch");
  SetProp(P_GENDER, NEUTER);
  AddId("transi");
  AddId("buch");
  AddId("uebersetzungsbuch");

  SetProp(P_MATERIAL, MAT_PERGAMENT );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  AddCmd( ({"lies", "lese"}), "lies");
  AddCmd( ({"uebersetz", "uebersetze"}), "trans");
}

int lies(string str)
{
  notify_fail("In was willst du lesen?\n");
  if( !str ) return 0;
  notify_fail("In sowas kannst Du nicht lesen.\n");

  if ( id(str) )
    {
    write("Du schmoeckerst durch das Woerterbuch und bist begeistert, wie elegant und direkt " +
          "die echsischen Woerter sein koennen.\n"+
          "Damit lassen sich sicher echsische Runen und Pergamentrollen uebersetzen.\n");
    say(CAP_TPN+" liest in einem Woertrebuch.\n");
    return 1;
    }
}

int trans(string str)
{
int i, j, k;
string * cmdl;
object *obj;

  notify_fail("Was willst du uebersetzen?\n");
  if (!str) return 0;

  notify_fail("Soetwas kannst du nicht uebersetzen. Nur echsisches Sacz.\n");
  str = lower_case(str);
  cmdl = explode(str, " ");
  if ( (strlen(cmdl[0]) > 0) && (cmdl[0] == "rolle") )
    {
    if (sizeof(cmdl) == 2)
      {
      k = (int)cmdl[1];
      }
    else
      {
      k = 1;
      }
    obj = all_inventory(TP);
    j = 0;
    for (i = 0; i<sizeof(obj); i++)
      {
      if ((obj[i]->id("erolle")) == 1)
         {
         j++;
         if (k == j)
           {
           // schon uebersetzt?
           // nein!
           if ( obj[i]->trans_status() == 0)
             {
             obj[i]->trans_setzen(1);
             write("Mit Hilfe des Buches schreibst Du die Uebersetzung unter die Runen.\n"+
                   "Deine Haende zittern vor Anspannung dabei und Du bist auch ziemlich nervoes.\n");
             say(CAP_TPN+" uebersetzt angespannt eine Pergamentrollem.\n");
             return 1;
             }
           // ja!
           if (obj[i]->trans_status() == 1)
             {
             write("Als Du mit der Uebersetzung beginnen willst, stellst Du fest: Ist schon Uebersetzt!\n");
             say(CAP_TPN+" stellt ueberrascht fest, dass die Pergamentrollem schon uebersetzt ist.\n");
             return 1;
             }
           }
         }
      }
    if (j < k)
      {
      write ( "So viele Pergamentrollen der Echsen hast Du nicht bei Dir.\n" );
      }
    return 1;
    }
  if ( (strlen(cmdl[0]) > 0) && ((cmdl[0] == "runen")|| (cmdl[0] == "rune") ))
    {
    if (environment(TP)->id("runen"))
      {
      write((string)call_other(MASTERDIR+MASTERMOD, "query_text", environment(TP)->textnr_query()) + "\n");
      }
    return 1;
    }
  return 0;
}
