inherit "std/room";
#define raba(x) if (find_player("raballion")) tell_object(find_player("raballion"),(x))
#define DETAILS_MASTER "/d/huegelland/raballion/echsen/obj/detaild"
#define MASTER "/secure/master"

mapping libraries;

void create()
{
  ::create();
  raba("Inherit room create.\n");
  libraries = ([]);  	
}

varargs void AddLibrary(string library, int localflag)
{
  raba("AddLibrary in room.\n");
  if (localflag == 0)
    {
    raba("Zentral laden."+(string)this_object()+"\n");
    DETAILS_MASTER->NewLib(library, localflag, this_object());
    }
  if (localflag == 1)
    {
    raba("Lokal laden."+(string)this_object()+"\n");
    DETAILS_MASTER->NewLib(library, localflag, this_object());
//    library = MASTER->make_path_absolute(library);
//    libraries += ([ library ]);
    }

}
