#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

#include "echsenmasterdef.h"

int textnr_setzen(int nr);
int textnr_query();

int textnr;

void create()
{
  ::create();
  	
  SetProp(P_INT_SHORT,"Echsentunnel unter Derlim");
  SetProp(P_INT_LONG,
    "Wie halt Tunnel so sind: oede, unheimlich und immer tropft hier etwas. "
    "Runen befinden sich an der Wand. "
    "Hat sich da etwas bewegt?");


  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddId("runen");

#include "details.h"
#include "details_lab.h"

  AddCmd( ({"lies", "lese"}), "lies");

  AddExit( "sueden", "./tunnel2");
  textnr_setzen(201);

}

int lies(string str)
{
  notify_fail("Was willst du lesen?\n");
  if( !str ) return 0;
  if( !id(str) ) return 0;
  notify_fail("Sowas kannst Du nicht lesen.\n");

  if( id(str) )
  {
    if(textnr)
    {
      write((string)call_other(MASTERDIR+MASTERMOD, "setze_text_in_runen", textnr) + "\n");
      say(CAP_TPN+" liest Runen an der Wand, versteht sie aber nicht.\n");
    }
    else
      write("Leider gibt es auf dieser Wand nichts zu lesen.\n");
    return 1;
  }
  return 0;
}

int textnr_setzen(int nr)
{
textnr = nr;
return 1;
}

int textnr_query()
{
return textnr;
}

