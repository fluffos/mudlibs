#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

int spalt, spaltobj, kluft, kluftobj, riss, rissobj;

void create()
{
  ::create();
  	
  SetProp(P_INT_SHORT,"Echsentunnel unter Derlim");
  SetProp(P_INT_LONG,
    "Wie halt Tunnel so sind: oede, unheimlich und immer tropft hier etwas. "
    "Hat sich da etwas bewegt?");


  SetProp(P_LIGHT,0);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

#include "details.h"
#include "details_lab.h"
#include "det_spez_spalt.h"
  
  AddCmd( ({"greif", "greife"}), "greife");

  AddExit( "norden", "./tunnel2");

  reset();

}

#include "proc_spez_spalt.h"

