#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>


create()
{
  ::create();
  

  SetProp(P_INT_SHORT, "Brunnen vom Weinberg" );
  SetProp(P_INT_LONG,
    "Unter Dir hoerst Du das Wasser vom Brunnen glucksen. Zum Glueck findest "+
    "Du hier etwas Halt an den Sprossen.");
 
  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 13, ENV_TERRAIN: TT_CAVE]) );

  call_other(ROOM"tunnel2","???");
  call_other(ROOM"tunnel3","???");


//  AddDetail( ({""}),
//    "");

  AddDetail( ({"wasser"}),
    "Weiter unten gluckst das Wasser herauf. Du kannst es nicht sehen, sondern "+
    "nur hoeren.");
  AddDetail( ({"brunnen"}),
    "Im Brunnen befindest Du Dich gerade.");
  AddDetail( ({"glueck"}),
    "Mit Glueck hat dies nichts zu tun, sondern nur mit der Geschicklichkeit von Dir.");
  AddDetail( ({"geschick", "geschicklichkeit"}),
    "Wenn Du \"info\" tippst, erfaehrst Du mehr darueber.");
  AddDetail( ({"halt"}),
    "Mit etwas Geschick haelst Du Dich an den Sprossen fest.");
  AddDetail( ({"sprosse", "sprossen"}),
    "Die Sprossen sind an der Wand befestigt und mit Geschick hast Du "+
    "sie benutzt.");

  AddDetail( ({"wand", "waende"}),
    "Die Waende sind senkrecht und mit Moosen und Flechten bewachsen und in "+
    "einer der Waende siehst Du eine Tuer eingelassen.");
  AddDetail( ({"unten"}),
    "Weiter unten hoerst Du das Wasser glucksen. Aber mehr kannst Du "+
    "nicht wahrnehmen.");
  AddDetail( ({"oben"}),
    "Durch den Schacht hinauf kannst Du etwas vom Himmel sehen.");
  AddDetail( ({"schacht"}),
    "Der Brunnen ist schachtfoermig angelegt.");
  AddDetail( ({"himmel"}),
    "Der Himmel ist wie immer wolkenlos.");
  AddDetail( ({"moose", "moosen"}),
    "Durch die Moose kannst Du stellenweise die Wand sehen.");
  AddDetail( ({"flechte", "flechten"}),
    "Du fingerst durch die glitschigen Flechten und entdeckst ein kleines "+
    "Loch in einer Wand.");
  AddDetail( ({"loch", "hebel"}),
    "Beherzt greifts Du in das Loch und fuehlst einen Hebel. Wozu der wohl "+
    "dient?");

  AddDetail( ({"boden"}),
    "Tja, hier gibt es keinen Boden.");

// tuer details
  AddDetail( ({"holz"}),
    "Das Holz der Tuer ist schmucklos.");


  AddSound( ({ DEFAULT_SOUND }),
    "Das Wasser gluckst weiter unten zu Dir herauf.");
  AddSound( ({"wasser"}),
    "Das Wasser gluckst, was sonst?");


  AddExit( "rauf", "./apark9");

  AddCmd(({"ziehe", "zieh"}), "zieh_hebel");
  AddCmd(({"oeffne"}), "_open_door");
  AddCmd(({"schliess", "schliesse"}), "_close_door");

  NewDoor("norden", ROOM"tunnel2",
          ({ "holztuer", "tuer"}), 
          ({ D_NAME, "Holztuer", D_GENDER, FEMALE,
             D_SHORT, "Eine Tuer aus hartem Holz (%s).\n",
             D_LONG,  "Diese Tuer besteht aus hartem Holz.\n",
             D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL
          }));

  reset();
}

int zieh_hebel(string str)
{
int doorstat;
object roomobj;

  notify_fail("Was willst Du ziehen?\n");
  if( !str ) return 0;
  notify_fail("Sowas kannst Du nicht ziehen.\n");
  if ( str=="hebel" ||
      str=="am hebel")
     {

     doorstat = "/obj/doormaster"->QueryDoorStatus(ROOM"tunnel2");

     if (doorstat == -1)
        {  
        say("Die Tuer nach Norden oeffnet sich.\n");
        write("Du oeffnest die Tuer nach Norden.\n");
        "/obj/doormaster"->SetDoorStatus(ROOM"tunnel2",1);

        roomobj = find_object(ROOM"tunnel2");
        if (roomobj != 0)
           {
           ROOM"tunnel2"->tuer_schliessen();
           tell_room(roomobj,"Die Tuer nach Sueden oeffnet sich.\n");
           tell_room(roomobj,"Die Tuer nach Norden schliesst sich.\n");
           }

        roomobj = find_object(ROOM"tunnel3");
        if (roomobj != 0)
           {
           tell_room(roomobj,"Die Tuer nach Sueden schliesst sich.\n");
           }
        }
     else
        {
        say("Die Tuer nach Norden schliesst sich.\n");
        write("Du schliesst die Tuer nach Norden.\n");
        "/obj/doormaster"->SetDoorStatus(ROOM"tunnel2",-1);

        roomobj = find_object(ROOM"tunnel2");
        if (roomobj != 0)
           {
           ROOM"tunnel2"->tuer_oeffnen();
           tell_room(roomobj,"Die Tuer nach Sueden schliesst sich.\n");
           tell_room(roomobj,"Die Tuer nach Norden oeffnet sich.\n");
           }

        roomobj = find_object(ROOM"tunnel3");
        if (roomobj != 0)
           {
           tell_room(roomobj,"Die Tuer nach Sueden oeffnet sich.\n");
           }
        }
     return 1;
     }
  return 0;
}

int _open_door(string str)
{
write ("Damit kannst Du die Tuer nicht bewegen (oeffnen).\n");
return 1;

}
int _close_door(string str)
{
write ("Damit kannst Du die Tuer nicht bewegen (schliessen).\n");
return 1;

}

void reset()
{
object roomobj;

  ::reset();

  roomobj = find_object(ROOM"tunnel2");
  if (roomobj != 0)
     {
     ROOM"tunnel2"->reset();
     }

  roomobj = find_object(ROOM"tunnel3");
  if (roomobj != 0)
     {
     ROOM"tunnel3"->reset();
     }
}
