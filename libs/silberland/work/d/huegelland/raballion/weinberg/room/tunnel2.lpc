#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>


create()
{
  ::create();
  

  SetProp(P_INT_SHORT, "Tunnel vom Weinberg" );
  SetProp(P_INT_LONG,
    "Der Tunnelgang macht einen bedrohlichen Eindruck auf Dich und Du "+
    "weisst nicht, was alles auf Dich hier unten wartet.");
 
  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 13, ENV_TERRAIN: TT_CAVE]) );


//  AddDetail( ({""}),
//    "");
  AddDetail( ({"gang", "tunnelgang"}),
    "Obwohl der Gang nicht gerade eng ist, kann man auch nicht gerade "+
    "sagen, er waere gross. Auf jeden Fall ist es ueberall lehmig, "+
    "schmuddelig und feucht.");
  AddDetail( ({"wand", "waende"}),
    "Die Waende sind ganz schoen feucht und aus Lehm und wenn Du Deine Nase tiefer "+
    "reingesteckt haettest, waere sie jetzt dreckig.");
  AddDetail( ({"boden"}),
    "Der Boden ist wie die Wand, aber man kann die Nase nicht reinstecken.");
  AddDetail( ({"decke"}),
    "Die Decke ist wie der Boden.");
  AddDetail( ({"eindruck"}),
    "Bedrohlich ist der Eindruck, denkst Du so bei Dir.");
  AddDetail( ({"nase"}),
    "Ist noch sauber und mitten in Deinem Gesicht.");
  AddDetail( ({"gesicht"}),
    "Das herausragenste in Deinem Gesicht ist Deine Nase.");
  AddDetail( ({"lehm"}),
    "Aus Lehm gebaut, ist dieser Gang gar. aus Fleisch und Blut, der "+
    "letzte Abenteurer war... (frei nach Schiller)");
  AddDetail( ({"fleisch", "blut"}),
    "Tja, der Letzte, der dies untersucht hatte, war, im wahrsten Sinne des Wortes, "+
    "gewesen. Du hast heute aber Glueck.");
  AddDetail( ({"letzte"}),
    "Du bist nicht der Letzte.");
  AddDetail( ({"glueck"}),
    ([ 0:        "Ach, such Dir doch Raba, der erklaert Dir das.",
       "mensch": "Glueck muss der Mensch haben.",
       "zwerg" : "Glueck muss der Zwerg haben.",
       "hobbit": "Glueck muss der Hobbit haben.",
       "elf"   : "Glueck muss der Elf haben."
     ])
     );
  AddDetail( ({"raba"}),
    "Das ist ein bloedelnder Elf.");
  AddDetail( ({"mensch", "Menschen"}),
    "Tippe einfach \"hilfe menschen\".");
  AddDetail( ({"zwerg", "zwerge"}),
    "Tippe einfach \"hilfe zwerge\".");
  AddDetail( ({"hobbit", "hobbits"}),
    "Tippe einfach \"hilfe hobbits\".");
  AddDetail( ({"elf", "elfen"}),
    "Tippe einfach \"hilfe elfen\".");
  AddDetail( ({"fall"}),
    "Hier nicht in Sinne von Absturz gemeint.");
  AddDetail( ({"absturz"}),
    "In diesem Fall nicht.");
  AddDetail( ({"wort", "wortes"}),
    "Kennst Du Skriptfallen?");
  AddDetail( ({"sinn", "sinne"}),
    "Kennst Du Skriptfallen?");
  AddDetail( ({"skript", "skriptfalle", "skriptfallen"}),
    "\"hilfe skript\"");
  AddDetail( ({"abenteurer"}),
    "Darunter verstehe ich hier einfach neugierige Leute.");
  AddDetail( ({"leute"}),
    "Darunter verstehe ich hier einfach nur Leute.");
  AddDetail( ({"schiller"}),
    "Kenne ich nicht. *grins*");
//  AddDetail( ({""}),
//    "");



// tuer details
  AddDetail( ({"holz"}),
    "Das Holz der Tueren ist schmucklos.");

  AddCmd(({"oeffne"}), "_open_door");
  AddCmd(({"schliess", "schliesse"}), "_close_door");
  AddCmd(({"steck", "stecke"}), "nase");


  NewDoor("sueden", ROOM"tunnel1",
          ({ "holztuer", "tuer"}), 
          ({ D_NAME, "Holztuer", D_GENDER, FEMALE,
             D_SHORT, "Eine Tuer aus hartem Holz (%s).\n",
             D_LONG,  "Diese Tuer besteht aus hartem Holz.\n",
             D_FLAGS, DOOR_CLOSED | DOOR_RESET_CL
          }));

  NewDoor("norden", ROOM"tunnel3",
          ({ "holztuer", "tuer"}), 
          ({ D_NAME, "Holztuer", D_GENDER, FEMALE,
             D_SHORT, "Eine Tuer aus hartem Holz (%s).\n",
             D_LONG,  "Diese Tuer besteht aus hartem Holz.\n",
             D_FLAGS, DOOR_OPEN | DOOR_RESET_OP
          }));



}

int tuer_oeffnen()
{
"/obj/doormaster"->SetDoorStatus(ROOM"tunnel3",1);

return 1;
}

int tuer_schliessen()
{
"/obj/doormaster"->SetDoorStatus(ROOM"tunnel3",-1);
return 1;
}




int _open_door(string str)
{
write ("Damit kannst Du die Tuer nicht bewegen (oeffnen).\n");
return 1;
}

int _close_door(string str)
{
write ("Damit kannst Du die Tuer nicht bewegen (schliessen).\n");
return 1;
}

int nase(string str)
{

  notify_fail("Was willst Du stecken?\n");
  if( !str ) return 0;
  if ( str == "nase" ||
       str == "nase tiefer" ||
       str == "nase tiefer in wand" ||
       str == "nase tiefer in die wand" ||
       str == "nase in wand" ||
       str == "nase in die wand" ||
       str == "die nase tiefer" ||
       str == "die nase tiefer in wand" ||
       str == "die nase tiefer in die wand" ||
       str == "die nase in wand" ||
       str == "die nase in die wand"
     )
     {
     write (BS("Was fuer ein Versuch! Zum Glueck ueberlegst Du es Dir im "+
            "letzen Moment nochmal und laesst es bleiben. Vielleicht ist "+ 
            "das naechste Mal ein Nasenessmonster in der Wand und wartet "+
            "nur auf seine Gelegenheit...\n"));
     return 1;
     }
return 0;
}

