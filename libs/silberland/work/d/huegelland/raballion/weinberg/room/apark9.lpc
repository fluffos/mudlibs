#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

int traube;
int schnecke;

string huegel();

create()
{
  ::create();
  
  traube = random(1);
  schnecke = 1;

  SetProp(P_INT_SHORT, "Weinberg von Derlim" );
  SetProp(P_INT_LONG,
    "Du befindest Dich im Weinberg. Die Hobbits stellen naemlich ihren Wein selber her. "+
    "Leider hat sich so manches "+
    "Kleinzeug hier angesiedelt und gefaehrdet so die Ernte. Du kannst Deinen kleinen "+
    "Beitrag leisten und dieses Kleinzeug entfernen und falls keines mehr da ist, warte "+
    "nur eine Weile, die sind gleich wieder hier. Dies ist die oberste Stufe vom "+
    "Weinberg. Hier koennen Anfaenger in Ruhe ihre ersten Kaempfe austragen. "+
    "Direkt vor Dir ist ein Brunnen.");

  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// standart details fuer die stadt
//#include "details_stadt.h"

// standart details fuer aussen
#include "details_aussen.h"

// standart details fuer gruppen von raeumen
#include "details_apark.h"
    
//  AddDetail( ({""}),
//    "");

  AddDetail( ({"grashuegel", "huegel"}),
    #'huegel);
  AddDetail( ({"grashuegeln", "huegeln"}),
    "Mehrzahl von Huegel ist Huegel und nicht Huegeln.");


  AddDetail( ({"brunnen"}),
    "Ein schicker Brunnen in der unverkennbaren Hobbitarchitektur. Er hat die "+
    "typisch kleine Mauer, eine Welle auf der ein Seil aufgerollt ist und einen "+
    "Eimer zum runter lassen. Der Brunnen wurde an einer sehr geschickten Stelle "+
    "angelegt, denn das Wasser fuer die Reben muss nur nach unten getragen werden. "+
    "Reinklettern kann man zur Zeit nicht in den Brunnen. Dies ist die oberste "+
    "Stufe vom Weinberg.");

  AddDetail( ({"mauer", "rundung", "rundungen"}),
    "Leichte Rundungen charakterisieren diese kleine Mauer vom Brunnen.");

  AddDetail( ({"welle"}),
    "Ueber dem Brunnen, zum Eimer runter lassen, ist die Welle montiert.");

  AddDetail( ({"seil"}),
    "Auf der Welle, ueber dem Brunnen, zum Eimer runter lassen, "+
    "ist das Seil aufgewickelt und befestigt.");

  AddDetail( ({"eimer"}),
    "Am Seil, das an der Welle ueber dem Brunnen, zum runter lassen "+
    "befestigt ist, haengt ein Eimer.");

  AddDetail( ({"stelle"}),
    "Die ist die hoechste Stufe vom Weinberg.");


  AddCmd( ({"pfluecke", "pflueck"}), "pfluecken");
  AddCmd( ({"futter", "futtere"}), "pfluecken");
  AddCmd( ({"kletter", "klettere"}), "kletter");

  AddExit( "westen", "./apark8");

  AddItem (NPC"wauckerl", REFRESH_DESTRUCT);
  AddItem (NPC"wauckerl", REFRESH_DESTRUCT);
}

string huegel()
{
         if(schnecke == 1 )
         {
           write(BS("Als Du den Huegel naeher in Augenschein nimmst, "+
                    "entdeckst Du eine Weinbergschnecke.\n"));
           AddItem (NPC"wbschnecke1", REFRESH_NONE);
           schnecke = 0;
           return "";
         }

          write(BS("Du nimmst den Huegel in Augenschein und findest zur Zeit aber nichts."));
          return "";

}


int pfluecken(string str)
{
  notify_fail("Was willst Du pfluecken?\n");
  if( !str ) return 0;
  notify_fail("Sowas kannst Du nicht pfluecken.\n");
  if( str=="frucht" || str=="fruechte" || str=="traube" || str=="trauben" )
    {
    if (TP->QueryProp(P_LEVEL) >= 8)
      {
      write("Du bist in der Stufe schon zu hoch, um noch Trauben zu wollen.\n");
      return 1;
      }

    if(traube>0)
      {
      write("Zufaellig findest Du eine Traube und pflueckst sie.\n");
      say(CAP_TPN+" pflueckt eine Traube.\n");
      CLONE( OBJ "traube", TP);
      traube--;
      }
    else
      write("Leider kannst Du hier keine Traube finden. Eventuell alle weg.\n");
    return 1;
    }
  return 0;
}

int kletter(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if( !str ) return 0;
  notify_fail("Dorthin kannst Du nicht klettern.\n");
  if( str=="brunnen" || str=="in brunnen" )
    {
    write("Ich sagte doch bereits: zur Zeit nicht moeglich.\n");
    return 1;
    }
}

void reset()
{
  ::reset();

  traube = random(1);
  schnecke = 1;
}


