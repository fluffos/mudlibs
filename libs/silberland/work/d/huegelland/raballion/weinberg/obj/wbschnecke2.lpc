inherit "/std/thing";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>

#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Weinbergschneckenleiche");
  SetProp (P_LONG, "Dies war wohl mal eine freudig kriechende "+
    "Weinbergschnecke. Nun ist sie aber tot.");
  SetProp (P_NAME, "Weinbergschneckenleiche");
  SetProp (P_GENDER, FEMALE);
  AddId (({"leiche", "weinbergschneckenleiche", "qschnecke", "schneckenleiche"}));
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 1);
//  SetProp (P_MATERIAL, MAT_MISC_PLANT);
  SetProp (P_MATERIAL, MAT_MISC_DEAD);
  
  SetProp (P_SIZE, 2);
  SetProp (P_MSGIN, "kriecht herein");
  AddCmd (({"iss","ess","esse","futter","mampf"}), "iss");

}

int iss(string str)
{

  notify_fail("WAS willst Du essen?\n");
  if (!stringp(str) || str=="") return 0;
  if (id(str)) {
    write ("Diese Leiche ist nicht zum Essen bestimmt! "+
      "Zumindest nicht in dieser Form.\n");
    return 1;
  }
  else return (notify_fail("Das kannst Du nicht essen!\n"), 0);

}

