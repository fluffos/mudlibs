// Eine Traube
// 1997-11-21  Raballion@

#include "../def.h"

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>


create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Traube");
  SetProp(P_LONG,
    "Diese Traube kann man vielleicht essen.");
  SetProp(P_NAME, "Traube");
  SetProp(P_GENDER, FEMALE);
  AddId("traube");
  AddId("\nobst");

 SetProp (P_INFO,
    "Die Traube ist aeusserst nahrhaft und kann Dich "+
    "bestimmt in Zeiten staerken, in denen Du Dich mal schwach fuehlst.");
  SetProp (P_MATERIAL, MAT_MISC_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL:3+random(7), F_SOAK:2, F_ALCOHOL:0, F_POISON:0]));
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 13);
  SetProp (P_NOBUY, 1);
}

BeimEssen()
{
  write ("Du futterst eine Traube und denkst dabei: Dies wird ein guter Wein.\n");
  say (TPN+" verspeist genuesslich eine Traube.\n");
  return ::BeimEssen();
}
