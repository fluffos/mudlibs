/*
** Nasenbeissmonster, Derlim  (w) Raballion
** ---
** 1998-01-29  0.1  urfassung, kopie von Echse Derlim (Kampfsoldat)
*/

inherit "std/npc";
// inherit "std/inpc/select";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <npc.h>
#include <new_skills.h>
#include <wizlevels.h>

#include "../def.h"

#define pddeb(x) if (find_player("raballion")) tell_object(find_player("raballion"),(x))


create()
{
  if (!is_clone(this_object())) return;  // (return on BP)

  ::create();
  SetProp (P_LONG,
    "Dieses Nasenbeissmonster hat nur einen Lebensinhalt: in Nasen beissen!");
  SetProp (P_SHORT, "Ein Nasenbeissmonster");
  SetProp (P_NAME, "Nasenbeissmonster");
  AddId ( ({"monster", "nasenbeissmonster"}) );
  SetProp (P_GENDER, NEUTER);
  SetProp (P_ALIGN, -50);
  create_default_npc(20+random(3));
  SetProp (P_SIZE, 200+random(20));
  SetProp (P_RACE, "monster");
  SetProp (P_MAX_HANDS, 2);
  SetProp (P_HANDS, ({" mit seinem Gebiss", 180, DT_RIP}) );
  SetProp (P_MSGOUT, "huepft davon in die Wand");
  SetProp (P_MSGIN, "kommt aus der Wand gespungen");
  SetProp(P_AGGRESSIVE,1);

  SUID;

  SetProp(P_SPELLRATE,15);

  AddSpell(2,150, 
    "Das Nasenbeissmonster beisst Dich heftig.\n",
    "Das Nasenbeissmonster beisst @WEN heftig.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1,250, 
    "Das Nasenbeissmonster beisst Dich sehr sehr heftig.\n",
    "Das Nasenbeissmonster beisst @WEM sehr sehr heftig.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetAttackChats(6, ({
    "Das Nasenbeissmonster ruft: Na warte, das wirst Du bereuen!\n",
    "Das Nasenbeissmonster greift Dich von hinten an.\n"}) );


  SetProp (P_DIE_MSG, " versucht ein letztes Mal in Deine Nase zu beissen und stirbt.\n");
  SetProp (P_DEFAULT_INFO, "deutet auf seine Nase.\n");

}


