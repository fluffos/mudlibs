inherit "std/npc";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Weinbergschnecke");
  SetProp (P_LONG, "Fast haettest Du die kleine Weinbergschnecke uebersehen. "+
    "Sie kriecht vor Dir auf dem Boden umher.");
  SetProp (P_NAME, "Weinbergschnecke");
  SetProp (P_GENDER, FEMALE);
  AddId (({"weinbergschnecke", "schnecke"}));
  create_default_npc (1);
  SetProp(P_RACE, "Schnecke");
  SetProp (P_WEIGHT, 50);
  SetProp (P_SIZE, 2);
  SetProp (P_HEAL, 2);
  SetProp (P_MSGIN, "kriecht herein");
  SetProp (P_HANDS, ({" mit ihren Fuehlern", 10}));
  SetProp (P_ALIGN, 10);
  SetProp (P_CORPSE, OBJ"wbschnecke2");

  SUID;
}

