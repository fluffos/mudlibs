inherit "/d/ebene/Park/npc/starter";

#include <properties.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Staudenwauckerl");
  SetProp (P_LONG, "Fast haettest Du das kleine Staudenwauckerl uebersehen. "+
    "Es krabbelt da vor Dir auf dem Boden umher.");
  SetProp (P_NAME, "Staudenwauckerl");
  SetProp (P_GENDER, NEUTER);
  AddId ( ({"wauckerl", "staudenwauckerl"}) );
  create_default_npc (1);
  SetProp(P_RACE, "Insekt");
  SetProp (P_SIZE, 2);
  SetProp (P_HEAL, 2);
  SetProp (P_MSGIN, "huscht herein");
  SetProp (P_HANDS, ({" mit seinen Fuehlern", 10}));
  SetProp (P_ALIGN, 10);
  SetProp ("maxkilllevel", 7);
  SetProp ("nokillmsg", ({
    "Du bist schon zu gross fuer das kleine Wauckerl. Du erroetest.\n",
    "Das Wauckerl weicht geschickt vor @@WEM@@ aus. @@WER@@ erroetet.\n"}));
  SUID;
  CLONEME (WEAPON"wzange");
  command ("zuecke zange");
}

