// Suedweg in Derlim (Hobbingen)
// 1997-04-24  Feyaria@SilberLand
// 1997-09-26  raballion@
//             den raum zu einem raum gemacht

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int haselnuss, hagebutte;

create()
{
  ::create();

  haselnuss = random(10)/9;
  hagebutte = random(10)/8;

  SetProp( P_INT_SHORT, "Suedweg in Derlim" );
  SetProp( P_INT_LONG, BS(
    "Dies ist der Suedweg in Derlim. "
    "Von West nach Ost geht sein Lauf. "
    "Er ist ein Seitenweg, der an der Hecke entlang geht. Im Gegensatz "
    "zur Hauptstrasse ist es hier etwas ruhiger und Du kannst entspannen."
    ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// standart details fuer die stadt
#include "details_stadt.h"

// standart details fuer aussen
#include "details_aussen.h"

// standart details fuer gruppen von raeumen
// suedweg
#include "details_sweg.h"

  AddCmd( ({"pfluecke", "pflueck"}), "pfluecken");
  AddCmd( ({"greif", "greife"}), "greifen");

  AddItem( NPC "buettel", REFRESH_DESTRUCT, ([P_NAME: "La",
       P_MNPC_AREA: ({ROOM"sued", ROOM"nordtor", ROOM"wachraum",
         ROOM"hauptstrasse1",ROOM"hauptstrasse2", ROOM"hauptstrasse3" }),
       P_MNPC_DEFAULTROOM: ROOM"suedtor" ]) );
  AddItem( NPC "echse", REFRESH_DESTRUCT, ([P_NAME: "Aisss",
       P_MNPC_AREA: ({ROOM"sued", ROOM"nordtor", ROOM"wachraum",
         ROOM"hauptstrasse1",ROOM"hauptstrasse2", ROOM"hauptstrasse3" }),
       P_MNPC_DEFAULTROOM: ROOM"suedtor" ]) );

  AddExit( "osten", "./suedweg3" );
  AddExit( "westen", "./hauptstrasse6" );
}

int greifen(string str)
{
  notify_fail("Wohin willst Du greifen?\n");
  if( !str ) return 0;
  if( member( ({"dorn", "dornen", "in dorn", "in dornen"}), str) != -1 )
  {
    write("Du fasst in die Dornen und verletzt Dir Deine Finger.\n");
    say( CAP_TPN+ " greift in die Dornen.\n");
    TP->reduce_hit_point(2+random(4));
    return 1;
  }
  return 0;
}

int pfluecken(string str)
{
  notify_fail("Was willst Du pfluecken?\n");
  if( !str ) return 0;
  notify_fail("Sowas kannst Du nicht pfluecken.\n");
  if( str=="hagebutte" || str=="hagebutten")
  {
    if(hagebutte)
    {
      write("Zufaellig findest Du eine Hagebutte und pflueckst sie.\n");
      say(CAP_TPN+" pflueckt eine Hagebutte.\n");
      CLONE( OBJ "hagebutte", TP);
      hagebutte--;
    }
    else
      write("Leider kannst Du hier keine Hagebutte erreichen. Alle weg?\n");
    return 1;
  }
  if( str=="haselnuss" || str=="haselnuesse")
  {
    if(haselnuss)
    {
      write("Zufaellig findest Du eine Haselnuss und pflueckst sie.\n");
      say(CAP_TPN+" pflueckt eine Haselnuss.\n");
      CLONE( HASELNUSS, TP);
      haselnuss--;
    }
    else
      write("Leider kannst Du hier keine Haselnuss erreichen. Alle weg?\n");
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();

  haselnuss = random(10)/9;
  hagebutte = random(10)/8;
}


