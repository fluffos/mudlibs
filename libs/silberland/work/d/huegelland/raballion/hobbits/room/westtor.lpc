#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <mnpc.h>

int haselnuss, hagebutte;

create()
{
  ::create();

  haselnuss = random(10)/9;
  hagebutte = random(10)/8;

  SetProp( P_INT_SHORT, "Am Westtor von Hobbingen" );
  SetProp( P_INT_LONG,
    "Das Westtor von Derlim. Eigentlich ist es ja ein Loch in der "
    "Hecke, die ganz Derlim umgibt. Ein schweres Tor kannst du an der "
    "Innenseite erkennen. Es ist zur Zeit geschlossen. "
    "Nach Suedosten geht es auf die breite Hauptstrasse. Im Nordosten geht nur "
    "eine kleine Seitenstrasse weg. "
    "Ein grosses Schild ist an der Hecke angebracht."
    );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// standart details fuer die stadt
#include "details_stadt.h"

// standart details fuer aussen
#include "details_aussen.h"

// standart details fuer gruppen von raeumen
// suedweg
#include "details_wweg.h"

  AddDetail( ({"wachen", "dienst"}),
    "Die Wachen leisten hier am Tor ihren Dienst ab.");
  AddDetail( ({"seitenstrasse", "westweg"}),
    "Die Seitenstrasse geht nach Nordosten weg. Von Einheimischen wird "
    "sie auch Westweg genannt.");

  AddDetail( ({"tor", "westtor", "loch"}),
    "Das Tor ist geschlossen. Es besteht aus schweren "
    "Pfosten, die kunstvoll ineinandergefuegt sind. Du hast Pech, dass "
    "es geschlossen ist, sonst haettest Du sicher eine Moeglichkeit, aus "
    "der Stadt zu kommen und Abenteuer zu bestehen. Versuche es doch bei "
    "einem anderen Tor.");
  AddDetail( ({"pfosten"}),
    "Die Pfosten sind auf wunderbare Weise miteinander verbunden. Kein "
    "Spalt ist zwischen den einzelnen Pfosten. Obwohl man es ihnen immer "
    "wieder abspricht, scheinen Hobbits doch sehr geschickt zu sein.");
  AddDetail( ({"spalt"}),
    "KEIN Spalt!");
  AddDetail( ({"pech"}),
    "Da Du heute welches hast, ist das Tor geschlossen.");
  AddDetail( ({"moeglichkeit"}),
    "Es ist nicht moeglich, das Wort Moeglichkeit zu untersuchen :)");
/*
   AddDetail( ({"moeglichkeit"}),
    "Diese besteht allerdings darin, dass hier irgendwer Automaten zum "
    "Untersuchen verwendet.");
   AddDetail( ({"untersuchen"}),
    "Das solltest Du immer nur haendisch tun.");
  AddDetail( ({"automaten"}),
    "Also Die rennen hoechstens bei Dir am Computer. Vorsicht!");
  AddDetail( ({"computer"}),
    "Also Sowas siehst Du hier wirklich nicht. Ich glaub, Du bist ein "
    "Falschspieler.");
  AddDetail( ({"falschspieler"}),
    "Wenn Du so einer bist, dann untersuche doch bitte Deinen eigenen "
    "Selbstmord.");
*/
/// Sowas, Selbstmord -> Tod ?? (Scriptfalle)

  AddDetail( ({"innenseite"}),
    "Die findest Du, wenn Du Dich in der Stadt umschaust.");
  AddDetail( ({"zeit"}),
    "Du denkst . o O ( Wie schnell die Zeit vergeht....)");
  AddSpecialDetail( ({"abenteuer"}), "quests");

  AddDetail( ({"schild"}),
    "Du kannst es lesen.");
  AddReadDetail( ({"schild"}),
    "--------------------------\n"
    "I                        I\n"
    "I         Westtor        I\n"
    "I                        I\n"
    "I  zur Zeit Geschlossen  I\n"
    "I    (Stadtverwaltung)   I\n"
    "I                        I\n"
    "--------------------------\n"
    );

  AddSound( ({ DEFAULT_SOUND }),
    "Du hoerst das aufgeregte Gezwitscher von vielen Voegeln. Ausserdem "
    "noch ein gemuetliches Murmeln, von dem Du aber nicht weisst, woher es "
    "kommt.");
  AddSound( ({"murmeln", "murmel", "gemurmel"}),
    "Vielleicht hoerst Du das Gras wachsen aeh Murmeln.");

  AddCmd( ({"pfluecke", "pflueck"}), "pfluecken");
  AddCmd( ({"greif", "greife"}), "greifen");

  AddItem( NPC "buettel", REFRESH_DESTRUCT, ([P_NAME: "Mi",
       P_MNPC_AREA: ({ROOM"west", ROOM"nordtor", ROOM"wachraum"}),
       P_MNPC_DEFAULTROOM: ROOM"westtor" ]) );
  AddItem( NPC "buettel", REFRESH_DESTRUCT, ([P_NAME: "Fa",
       P_MNPC_AREA: ({ROOM"west", ROOM"nordtor", ROOM"wachraum", 
             ROOM "hauptstrasse5", ROOM "hauptstrasse6", ROOM "suedweg4",
             ROOM "suedweg5", ROOM "suedtor"}),
       P_MNPC_DEFAULTROOM: ROOM"westtor" ]) );
  AddItem( NPC "echse", REFRESH_DESTRUCT, ([P_NAME: "Fisss",
       P_MNPC_AREA: ({ROOM"west", ROOM"nordtor", ROOM"wachraum"}),
       P_MNPC_DEFAULTROOM: ROOM"westtor" ]) );
  AddItem( NPC "echse", REFRESH_DESTRUCT, ([P_NAME: "Eisss",
       P_MNPC_AREA: ({ROOM"west", ROOM"nordtor", ROOM"wachraum",
             ROOM "hauptstrasse5", ROOM "hauptstrasse6", ROOM "suedweg4",
             ROOM "suedweg5", ROOM "suedtor"}),
       P_MNPC_DEFAULTROOM: ROOM"westtor" ]) );

  AddExit( "nordosten", "./westweg2" );
  AddExit( "suedosten", "./hauptstrasse5" );
}


int greifen(string str)
{
  notify_fail("Wohin willst Du greifen?\n");
  if( !str ) return 0;
  if( member( ({"dorn", "dornen", "in dorn", "in dornen"}), str) != -1 )
  {
    write("Du fasst in die Dornen und verletzt Dir Deine Finger.\n");
    say( CAP_TPN+ " greift in die Dornen.\n");
    TP->reduce_hit_point(2+random(4));
    return 1;
  }
  return 0;
}

int pfluecken(string str)
{
  notify_fail("Was willst Du pfluecken?\n");
  if( !str ) return 0;
  notify_fail("Sowas kannst Du nicht pfluecken.\n");
  if( str=="hagebutte" || str=="hagebutten")
  {
    if(hagebutte)
    {
      write("Zufaellig findest Du eine Hagebutte und pflueckst sie.\n");
      say(CAP_TPN+" pflueckt eine Hagebutte.\n");
      CLONE( OBJ "hagebutte", TP);
      hagebutte--;
    }
    else
      write("Leider kannst Du hier keine Hagebutte erreichen. Alle weg?\n");
    return 1;
  }
  if( str=="haselnuss" || str=="haselnuesse")
  {
    if(haselnuss)
    {
      write("Zufaellig findest Du eine Haselnuss und pflueckst sie.\n");
      say(CAP_TPN+" pflueckt eine Haselnuss.\n");
      CLONE( HASELNUSS, TP);
      haselnuss--;
    }
    else
      write("Leider kannst Du hier keine Haselnuss erreichen. Alle weg?\n");
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();

  haselnuss = random(10)/9;
  hagebutte = random(10)/8;
}


string quests()
{
  return "Es gibt zur Zeit "+sizeof("/secure/questmaster"->QueryAllKeys())+
         " Abenteuer im SilberLand.\n";
}

