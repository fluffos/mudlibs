// /d/huegelland/raballion/hobbits/room/laden.c
// in Derlim (Hobbingen)
//Detailbeschreibung von Zeus//
//Raum: Troedlerladen in Hobbingen //
// 1997-04-24  Feyaria@SilberLand
// 1997-09-10  raballion@
//             den Raum an Derlim angepasst



inherit "std/laden";

#include <properties.h>
#include <language.h>
#include <laden.h>
#include "../def.h"


void create()
{
  ::create();
  	
  SetProp(P_INT_SHORT,"Troedlerladen von Derlim");
  SetProp(P_INT_LONG,
    "Das ist der Troedler von Derlim. Ein grosser Tisch trennt den Laden in "
    "zwei gleich grosse Haelften. Hinter dem Tisch steht ein kleiner Hobbit, "
    "der Besitzer des Ladens. Er an- und verkauft so ziemlich alles, was es im "
    "Silberland gibt. Haette er eine Schwiegermutter, so wuerde er "
    "wahrscheinlich auch diese verkaufen. Ueber dem Tisch ist eine Tafel "
    "aufgehaengt. An den Waenden siehst Du viele Regale und Vitrinen die mit "
    "allerlei Sammelsurium gefuellt sind. Licht faellt nur spaerlich durch "
    "die verdreckten Fenster.");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetStorageRoom (ROOM "store");
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "troedelhaendler");
  SetProp(P_SHOPKEEPER_NAME, "Dodo Stolzfuss");
  SetProp(P_SHOPKEEPER_GENDER, MALE);

  AddDetail( ({"boden", "erdboden"}),
    "Ein ganz normaler Erdboden, wie er in einem Huegelhaus ueblich ist.");
  AddDetail( ({"wand", "waende"}),
    "An den Waenden siehst Du viele Regale und Vitrinen die mit allerlei "
    "Sammelsurium gefuellt sind.");
  AddDetail( ({"decke"}),
    "Die Decke ist ueber Dir. Sie besteht aus schweren Eichenbalken.");
  AddDetail( ({"balken", "eichenbalken"}),
    "Schwere Balken aus Eiche.");
  AddDetail(({"laden", "raum", "troedlerladen", "huegelhaus", "haus"}),
    "Du befindest Dich mittendrin.");
  AddDetail( ({"stadt", "hobbingen", "derlim"}),
    "Du befindest Dich in der Stadt Derlim. Von anderen Rassen wird sie aber "
    "Hobbingen genannt.");
  AddDetail(({"ladentisch", "tisch"}),
    "Es ist ein massiver, aus Eichenholz gefertigter Tisch. Die Oberflaeche "
    "des Tisches ist durch die grosse geschaeftliche Taetigkeit schon sehr "
    "abgenutzt.");
  AddDetail( ({"taetigkeit"}),
    "Hier wird fast alles gehandelt.");
  AddDetail(({"holz","eichenholz", "eiche", "eichen"}),
    "Es ist ganz normales Eichenholz, wie es im Silberwald auch vorkommt.");
  AddDetail( ({"silberwald"}),
    "Der Silberwald liegt weit im Osten.");
  AddDetail( ({"welt", "silberland"}),
    "Diese Welt ist das SilberLand.");
  AddDetail( ({"hobbit", "hobbits"}),
    "Die Hobbits leben hier in Derlim.");
  AddDetail("oberflaeche",
    "Sie ist schon sehr abgenutzt.");
  AddDetail("raum",
    "Er ist durch den Ladentisch in zwei gleiche Haelften geteilt.");
  AddDetail("haelften",
    "Sie sind, wie es bei Haelften so ueblich ist, gleich gross, sonst "
    "waeren es wohl keine Haelften.");
  AddDetail("haelfte",
    "Sie ist gleich gross wie die andere, sonst waeren es wohl keine "
    "Haelften.");
  AddDetail(({"besitzer", "troedler", "dodo", "stolzfuss"}),
    "Wenn Du den Troedler nicht sehen kannst, dann ist er auch nicht da. "
    "Falls Du ihn aber siehst, so ist er auch da. So einfach ist das.");
  AddDetail( ({"schwiegermutter"}),
    "Sowas kannst Du hier wirklich nicht verkaufen.");
  AddDetail(({"tafel","holztafel"}),
    "Es ist eine einfache aus Holz gemachte Tafel auf der einige Zeilen "
    "geschrieben stehen. Vielleicht kannst Du sie lesen.");
  AddDetail( ({"zeilen"}),
    "Du kannst sie lesen.");
  AddReadDetail ( ({"tafel", "zeilen"}),
    "Verfuegbare Befehle:\n"+
    "<zeige>           Gibt eine Uebersicht ueber das Angebot im Laden.\n"
    "<zeige> rue|ver|waf Uebersicht ueber Ruestungen/Verschiedenes/Waffen\n"
    "<zeige> panzer|helme|umhaenge|ringe|hosen|schuhe|....  \n"
    "                  Uebersicht ueber die jeweiligen Ruestungsarten.\n"
    "<unt> nummer      Gibt die Beschreibung eines Gegenstands der Liste aus\n"
    "<kaufe> nummer oder\n"
    "<kaufe> etwas     Du kaufst einen bestimmten Gegenstand.\n"
    "<verkaufe> etwas  Du verkaufst einen Gegenstand, den Du bei Dir hast.\n"
    "<versetze> etwas  Du verkaufst einen Gegenstand, auch wenn Dir der\n"
    "                  Haendler nicht den vollen Preis dafuer bezahlen will.\n"
    "<schaetz> etwas   Der Haendler sagt Dir, wieviel ihm ein Gegenstand\n"
    "                  wert waere, wenn Du ihn verkaufen wuerdest.\n");
  AddDetail("waende",
    "Sie sind in einem neckischen Hellblaugruen ausgemalt und ueberall sind "
    "Regale und Vitrinen befestigt.");
  AddDetail( ({"hellblaugruen", "farbe", "blau", "gruen"}),
      "Eine schoene Farbe, sowohl Blau als auch Gruen, und dabei noch sehr hell.");
  AddDetail("regale",
    "Die Regale sind vollgeraeumt mit lauter Sammelsurium welcher sich im "
    "Laufe der Jahre angesammelt hat.");
  AddDetail( ({"sammelsurium", "sachen", "stuecke"}),
    "Es handelt sich um Sachen, die es nicht wert sind aufgezaehlt zu werden, "
    "da es sich um Sammelsurium handelt.");
  AddDetail( ({"vitrinen"}),
    "Die Vitrinen sind alle abgeschlossen und haben eine Glasfront. In diesen "
    "Vitrinen sind die wertvollen, unverkaeuflichen Stuecke aufbewahrt. Eine "
    "Vitrine scheint etwas sonderbar.");
  AddDetail( ({"glas", "glasfront"}),
    "Die Vitrinen haben alle eine Glasfront.");
  AddDetail("vitrine",
    "Die Vitrine sieht genauso aus wie alle anderen, nur der Inhalt scheint "
    "anders zu sein.");
  AddDetail("inhalt",
    "Du siehst Dir den Inhalt der Vitrine genauer an und erkennst, dass es "
    "sich um eine riesige, ekelhaftige Giftspinne handelt. Erschrocken "
    "springst Du einen Schritt zurueck.");
  AddDetail( ({"spinne","giftspinne"}),
      (["darkelf": "Eine wunderschoene, giftige Spinne. Leider ist sie hinter "
       "der Vitrine eingesperrt. ist der Troedler vielleicht ein geheimer "
       "Verehrer der Spinnenkoenigin Lloth?",
      0: "Sie sieht wirklich gefaehrlich, ekelerregend und giftig aus. So etwas "
    "hast Du hier auf dem Festland noch nie gesehen. Den Goettern sei Dank, "
    "ist die Vitrine abgeschlossen, so dass Du sie ganz bestimmt nicht "
    "oeffnen kannst und die Giftspinne weiterhin in der Vitrine bleibt."]) );
  AddDetail( ({"spinnenkoenigin", "lloth"}),
    "Lloth, die Spinnenkoenigin ist die Goettin der Dunkelelfen und "
    "Schutzherrin aller Spinnen.");
  AddDetail( ({"dank"}),
    "Du dankst den Goettern.");
  AddDetail( ({"goetter", "gott", "woody", "dusty"}),
    "Die Goetter im SilberLand sind Woody und Dusty.");
  AddDetail("licht",
    "Ein wenig davon faellt durch die verdreckten Fenster.");
  AddDetail("fenster",
    "Sie sehen aus, als waeren sie schon jahrelang nicht mehr geputzt worden. "
    "Der Hobbit denkt sich wahrscheinlich wieso er sie putzen soll, wenn sie "
    "doch wieder dreckig werden.");
  AddDetail( ({"festland", "land"}),
    "Das ist jenes Land, auf dem Du Dich gerade befindest. Nicht Festland "
    "waere zum Beispiel eine abgelegene Insel.");
  AddDetail( ({"insel", "beispiel"}),
    "Eine Insel ist kein Festland.");

  AddExit( "nordwesten", "./hauptplatz");

//  AddItem("/d/ebene/obj/div/teddyautomat", REFRESH_REMOVE);
  AddItem(NPC "troedler", REFRESH_DESTRUCT);
}

