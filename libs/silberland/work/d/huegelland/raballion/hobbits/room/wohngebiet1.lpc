#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Wohngebiet von Derlim" );
  SetProp(P_INT_LONG,
    "Hier im Wohngebiet ist es eigentlich ganz ruhig und beschaulich. Ueberall kann man die "+
    "grasbewachsenen Huegel mit teilweise sehr schoenen Vorgaerten der Einwohner sehen. "+
    "Falls Du die Bedingungen erfuellst, kannst Du Dich bei der Stadtverwaltung "+
    "nach einem Ort fuer Deinen Huegel erkundigen: "+
    "Die Adresse von hier ist uebrigens \"Wohnweg 1\".");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// standart details fuer die stadt
#include "details_stadt.h"

// standart details fuer aussen
#include "details_aussen.h"

// standart details fuer gruppen von raeumen
#include "details_wohngeb.h"


    
//  AddDetail( ({""}),
//    "");



  AddExit( "norden", "./hauptstrasse6");
  AddExit( "westen", "./wohngebiet2");

}

