#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>


void create()
{
  ::create();
  	
  SetProp(P_INT_SHORT,"Ratszimmer in Derlim");
  SetProp(P_INT_LONG,
    "Dies ist das Ratszimmer von einem Rat der Hobbits. "
    "Es gehoert derzeit Teqlablu. "
    "In der Mitte steht ein grosser, wuchtiger Tisch und ist voll mit Papieren "
    "ueber Antraegen und Bauplaenen.");


  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"rat", "stadtrat",
          "stadtverwaltung", "verwaltung",
          "mitglied", "mitglieder",
          "ratsmitglied", "ratsmitglieder"}),
    "Die Stadtverwaltung von Derlim ist dazu da, um fuer das Allgemeinwohl aller "
    "Einwohner und Besucher von Derlim zu sorgen. Sie kuemmern sich auch um alle "
    "jene, die neu in die Stadt kommen und sich ueberhaupt nicht auskennen. Wenn "
    "einer von ihnen da ist, frag sie einfach und sie werden Dir sicherlich helfen wo "
    "sie nur koennen. Die Mitglieder sind derzeit: Raballion, Teqlablu und Nemesis.");

  AddDetail( ({"teqlablu", "nemesis"}),
    "Ist ein Ratsmitglied");

  AddDetail( ({"decke"}),
    "Die Decke ist schmucklos.");

  AddDetail( ({"boden"}),
    "Der Boden ist schmucklos.");

  AddDetail( ({"wand", "waende"}),
    "Die Waende sind schmucklos.");

  AddDetail( ({ "ratszimmer", "zimmer"}),
    QueryProp(P_INT_LONG) );

  AddDetail( ({"hobbit", "hobbits"}),
    "Die Hobbits leben hier in Derlim.");

  AddDetail( ({"derlim", "stadt"}),
    "Derlim sagen die Hobbits zu ihrer Stadt.");

  AddDetail( ({"belang", "belange", "wichtigkeit", "bedeutung"}),
    "Belang der, -(e)s/-e: von B., ohne B. (Wichtigkeit, Bedeutung) sein... "
    "sagt mein Woerterbuch.");

  AddDetail( ({"huegel"}),
    "Du befindest Dich in einem der Huegel von Derlim.");

  AddDetail( ({"allgemeinwohl"}),
    "Betrifft wohl jeden.");

  AddDetail( ({"einwohner"}),
    "Die Hobbits sind die Einwohner von Derlim.");

  AddDetail( ({"besucher"}),
    "Besucher sind keine Einwohner von Derlim.");

  AddDetail( ({"hobbitleben"}),
    "Wenn Du ein ordentlicher Hobbit bist, kennst Du es ja. Wenn nicht, suche "
    "Dir einen und frage ihn danach.");

  AddDetail( ({"tisch", "schreibtisch"}),
    "Der grosse, wuchtige Tisch ist voller Papiere und Antraege.");

  AddDetail( ({"paier", "papiere"}),
    "Sie sind vollgeschrieben mit Dingen ueber Derlim. Sie gehen Dich nichts an "
    "und drum kuemmerst Du Dich nicht weiter darum.");

  AddDetail( ({"antrag", "antraege"}),
    "Sie sind vollgeschrieben mit Dingen ueber Derlim. Sie gehen Dich nichts an "
    "und drum kuemmerst Du Dich nicht weiter darum.");

  AddDetail( ({"bauplan", "bauplaene"}),
    "Sie sind vollgeschrieben mit Dingen ueber Derlim. Sie gehen Dich nichts an "
    "und drum kuemmerst Du Dich nicht weiter darum.");

  AddDetail( ({"mitte"}),
    "Wo wird sich die Mitte eines Zimmers wohl befinden?");

//  AddDetail( ({""}),
//    "");

  AddDetail( ({"woerterbuch", "naehe", "ding", "dinge", "dingen", "naehe"}),
    "Fragen kannst Du stellen!");

  AddCmd( ({"stab"}), "stab");

  AddExit( "suedwesten", "./rathaus1");

}

int stab(string str)
{
string name;
object obj;

   name = this_player()->query_real_name();
   if ("teqlablu" == name)
      {
      if (!obj=present("bbstab",TP))
         {
         write ("Du hast keinen Buergermeisterstab bei Dir. Du "
                "erhaelst nun einen.\n");
         CLONE(OBJ "bbstab", TP);
         }
      else
         {
         write ("Du hast einen Buergermeisterstab bei Dir. Du "
                "erhaelst nun einen Neueren.\n");
         obj->remove();
         CLONE(OBJ "bbstab", TP);
         }
      return 1;
      }
   else
      {
      write ("Du bist nicht Teqlablu und darfst daher dies nicht tun.\n");
      return 0;
      }
}
