// /d/huegelland/raballion/hobbits/room/hauptstrasse3.c
// in Derlim (Hobbingen)
// 1997-04-24  Feyaria@SilberLand
// 1997-09-10  raballion@
//             den raum zu einem raum gemacht

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Hauptstrasse in Derlim" );
  SetProp( P_INT_LONG, BS(
    "Dies ist die noerdliche Hauptstrasse in Derlim (Hobbingen). "
    "Von Westen nach Nordosten geht ihr Lauf. "
    "Sie verbindet das Nordtor mit dem Hauptplatz und stellt somit eine "
    "Hauptverbindung vom gesellschaftlichen Zentrum von Derlim mit dem "
    "\"Draussen\" dar. "
    "Im Norden siehst Du einen grossen Huegel, zu dem Du aber von hier aus "
    "nicht hinkommst. Im Osten befindet sich die Hobbitgilde."
     ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// standart details fuer die stadt
#include "details_stadt.h"

// standart details fuer aussen
#include "details_aussen.h"

// standart details fuer gruppen von raeumen
// hauptstrasse
#include "details_hauptstr.h"

  AddDetail( ({ "nordtor","tor" }),
    "Geh doch naeher ran um etwas genaueres zu sehen. Es liegt weiter weg im Nordosten.");
  AddDetail( ({ "hauptplatz","platz","zentrum" }),
    "Geh in Richtung Westen und Du wirst schlauer.");

  AddDetail( ({ "draussen" }),
    "Ja, wie sage ich es denn.... dort warten viele Abenteuer auf DICH!");
  AddDetail( ({ "abenteuer" }),
    "Das ist allerdings das Witzige daran: gehe hin und finde es heraus.");
  AddDetail( ({ "witzige","humor" }),
    "Wenn Du das hier liest, dann hast Du ihn bestimmt. Dann kannst du auch nach \"Draussen\" "
    "gehen.");
  AddSpecialDetail( ({"abenteuer"}), "quests");
  AddDetail( ({"gilde", "hobbitgilde"}),
    "Im Osten befindet sich die Hobbitgilde. Dort koennen junge Hobbits ihre "
    "Kampf- und Zauberfertigkeiten erlernen. Die Gilde ist in einem grossen "
    "Huegel untergebracht.");

  AddSmell (DEFAULT_SMELL, "Von ueberall her scheint ein leichter Geruch von Essen zu kommen.\n");
  AddSmell (({"geruch", "essen"}),
    ([ 0:      "Es riecht nach Essen.\n",
     "oger": "Es richt nach Essen. Dein Magen knurrt ganz gewaltig.\n",
     "elf":    "Mmmh. Als Elf sagt Dir der Geruch: Die Kneipe liegt in westlicher Richtung.\n",
     "hobbit": "Du denkst, wie Deine Artgenossen, nur an das Essen.\n",
     "zwerg":  "Also nach Wertmetall riecht es nicht.\n",
     "mensch": "Riecht zwar fremd, aber lecker.\n",
     "magier": "Schnueffelnase. Steckst sie auch ueberall rein. Gib zu Du hast den Code gelesen.\n"

    ]) );

  AddItem( NPC "baldu", REFRESH_DESTRUCT );
  
  AddExit( "nordosten", "./hauptstrasse2" );
  AddExit( "osten", "/gilden/abenteurer/hobbitgilde" );
  AddExit( "suedosten", "./suedweg1" );
  AddExit( "westen", "./hauptplatz" );
  
  AddItem( "/d/ebene/obj/waffe/stockautomat", REFRESH_REMOVE);
}

string quests()
{
  return "Es gibt zur Zeit "+sizeof("/secure/questmaster"->QueryAllKeys())+
         " Abenteuer im SilberLand.\n";
}

