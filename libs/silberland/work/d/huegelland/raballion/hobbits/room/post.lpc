#include <properties.h>
#include <language.h>
#include "../def.h"

inherit "std/post";

void create()
{
  ::create();
  	
  SetProp(P_INT_SHORT,"Post von Derlim");
  SetProp(P_INT_LONG,
    "Du befindest Dich im Postamt von Derlim. Rechter Hand befindet sich "
    "ein Schalter, hinter welchem ein Hobbit im Zeitlupentempo, wie bei "
    "Postlern so ueblich, seine Arbeit verrichtet. Linker Hand kannst Du zwei "
    "Schreibkabinen entdecken. Unterhalb des Postschalters befinden sich "
    "zwei, etwa zwerghohe Tueren.");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

#include "details_stadt.h"
  AddDetail( ({"postamt", "post"}),
    "Du befindest Dich mittendrin.");
  AddDetail(({"schalter","postschalter", "aufgeben"}),
    "Er dient zum Aufgeben Deiner geschriebenen Briefe. Ein duennes "
    "Drahtgitter trennt den Kundenbereich vom Personalbereich. Neben dem "
    "Schalter kannst Du eine kleine, rechteckige Box sehen.");
  AddDetail( ({"brief", "briefe"}),
    "Die Briefe musst Du schon selber schreiben, oder Du musst warten, bis "
    "Dir jemand schreibt. In so einem Fall gib einfach 'post' ein.");
  AddDetail(({"drahtgitter","gitter"}),
    "Ein absolut stabiles, nicht zu durchdringendes Drahtgitter.");
  AddDetail(({"holzbox","box"}),
    "Eine einfache Holzbox. An der Hinterseite der Box kannst Du einen Hebel "
    "erkennen.");
  AddDetail( ({"hinterseite"}),
    "An der Hinterseite der Box kannst Du einen Hebel erkennen.");
  AddDetail( ({"hebel", "holzhebel"}),
    "Ein Holzhebel. Du koenntest versuchen ihn nach unten zu druecken.");
  AddDetail( ({"bereich"}),
    "Es gibt den Kundenbereich und den Personalbereich.");
  AddDetail( ({"kunde"}),
    "DU bist ein Kunde!");
  AddDetail( "kundenbereich",
    "Jener Bereich, in dem Du Dich als Kunde aufhalten darfst.");
  AddDetail( ({"personalbereich", "personal"}),
    "Jener Bereich in dem sich nur das Personal aufhaelt. Fuer Dich ist dieser "
    "Bereich nicht zugaenglich.");
  AddDetail(({"schleim", "kroete" }),
    "Dicker, zaehfluessiger, klebriger Schleim von der Kroete befindet sich "
    "auf Deiner Hand und tropft herunter. Du wischt den Schleim an Deine Hose. "
    "So, nun ist Deine Hand wieder sauber."); 
  AddDetail(({"briefmarkenbefeuchter","befeuchter"}),
    "Das ist die Box, vor der Du gerade stehst.");
  AddDetail( ({"hobbit", "postler", "postler-hobbit"}),
    "Ein richtiger Postler-Hobbit. Eine mit einem Posthorn auf die Brust "
    "gestickte, graue Uniform angezogen und sich im Zeitlupentempo bewegend.");
  AddDetail( ({"uniform", "brust", "posthorn"}),
    "Der Postler hat eine graue Uniform an, bei der ein Posthorn auf die "
    "Brust gestickt ist.");
  AddDetail( ({"tempo", "zeitlupentempo", "zeitlupe"}),
    "Bei diesem Zeitlupentempo kannst Du wohl Deine Briefe auch selber "
    "ueberbringen...");
  AddDetail(({"scheibkabine","kabine"}),
    "In der Kabine kannst Du Deine Post ungestoert erledigen. Du kannst sie "
    "betreten.");
  AddDetail("tueren",
    "Es sind zwei, etwa zwergengrosse Tueren. Auf beiden Tueren ist ein Schild "
    "befestigt.");
  AddDetail("schild",
    "Es befindet sich auf jeder Tuere eines. Sicher kannst Du sie lesen.");
  AddReadDetail("schild",
    "Welches Schild willst Du den lesen ? Es gibt zwei davon.");
  AddReadDetail("schild 1",
    "Auf diesem Schild steht in grossen Buchstaben: POST - AUSGANG ");
  AddReadDetail("schild 2",
    "Auf diesem Schild steht in grossen Buchstaben: EXPRESSPOST ");
  AddDetail("ture",
    "Welche Tuere willst Du untersuchen ? Es gibt zwei davon.");
  AddDetail(({"tuere 1","tuere 2"}),
    "Die Tuer sieht gleich aus wie die andere, nur die Schilder sind "
    "verschieden. Vielleicht kannst Du einen Blick hinter die Tuer machen.");
  AddDetail(({"boden","wand", "waende","decke"}),
    "Mit wunderschoenem, attraktivem und zeitlosen Postgelb bemalt.");
  AddDetail( ({"gelb", "postgelb"}),
    "Das typische Gelb, dass die Post ueberall verwendet.");
  AddSound(({DEFAULT_SOUND}),
    "Du lauscht und hoerst das Stempeln des Personals.");


  
  AddCmd(({"druecke", "drueck"}), "druecken");
  AddCmd(({"oeffne"}),"oeffnen");

  AddExit( "sueden", "./hauptplatz");
}

int druecken(string str)
{
  notify_fail("Was willst Du druecken?\n");
  if( !str ) return 0;
  if( str=="hebel")
  {
    write( BS(
      "Du drueckst den Hebel hinunter und die Vorderseite der Box oeffnet "
      "sich. Blitzschnell schnellt eine lange Zunge aus der Box und trifft "
      "Deine Hand. Erst jetzt erkennst Du, dass es sich um den "
      "vollautomatischen Briefmarkenbefeuchter handelt. Du schaust von vorne "
      "in die Box und siehst eine alte Kroete sitzen, die hier ihre Arbeit "
      "als Briefmarkenbefeuchter verrichtet. Du stoerst sie nicht weiter und "
      "schliesst die Vorderseite der Box wieder. Uebrigens, der Schleim "
      "auf Deiner Hand wirkt nicht gerade appetitlich.") ); 
    say( CAP_TPN + " drueckt den Hebel an der Box.\n");
    return 1;
  }
  return 0;
}

int oeffnen(string str)
{
  notify_fail("Was willst Du oeffnen?\n");
  if( !str ) return 0;
  if( str=="tuer" || str=="tuere")
  {
    write( BS("Welche Tuer willst Du oeffnen ?") );
    return 1;
  }
  if( str=="tuer1" || str=="tuer 1")
  {
   write( BS(
     "Du oeffnest die Tuer einen Spalt und erblickst einen Zwerg, der gerade "
     "ganz gemuetlich und froehlich pfeifend seine Post in seine Posttasche "
     "einsortiert. Es koennte ein Brief fuer Dich dabei sein, deshalb "
     "schliesst Du die Tuere vorsichtig und stoerst den Zwerg nicht weiter "
     "bei seiner Arbeit."));
   say(CAP_TPN + " oeffnet eine Tuer.\n");
   return 1;
  }
  if( str=="tuer2" || str=="tuer 2")
  {
   write( BS(
     "Als Du versuchst die Tuere zu oeffnen, wird die Tuere wuchtig von innen "
     "aufgeschlagen. Pfeilschnell flitzt ein Zwerg mit einer Posttasche aus "
     "der Tuere, rast an Dir vorbei, hinterlaesst eine Rauchwolke und ist "
     "schon weg. Das nennt man Expresspost, was?"));
   say(CAP_TPN + " oeffnet eine Tuer.\n");
   return 1;
  }
 return 0;
}

