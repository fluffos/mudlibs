//Detailbeschreibung von Zeus//
//Raum: Stadtratshaus von Hobbingen//


#include <properties.h>
#include <language.h>
#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  	
  SetProp(P_INT_SHORT,"Stadtratshaus");
  SetProp(P_INT_LONG,
    "Du befindest Dich im Stadtratshaus von Hobbingen. Hier ist das "
    "Arbeitszimmer von Zeus, dem Stadtrat. In der Mitte des Raumes steht ein "
    "Arbeitstisch, der ueber und ueber mit Pergamenten, Schriftrollen und "
    "Buechern angeraeumt ist. Auch ein Tintenfass, eine Rok-Feder und eine "
    "heisse Tasse Kaffee befindet sich darauf. Rechts neben dem Tisch steht "
    "ein bereits ueberquillender Mistkuebel, links vom Tisch ein Holzsessel "
    "fuer Besucher, die mit ihren Problemen zu Zeus kommen und ihn um Rat "
    "oder Hilfe bitten und hinter dem Tisch ein grosser Arbeitssessel. Eine "
    "kleine gemuetliche Couch steht gleich rechts neben dem Eingang, durch "
    "welchen Du hereingekommen bist. An den Waenden stehen ueberall Regale und "
    "Schraenke, die vollgestopft sind mit alten Akten und Unterlagen. Das Zimmer "
    "sieht aus, wie das eines vielbeschaeftigten Hobbits. Also chaotisch und "
    "unordentlich, aber nur der Genie findet sich auch im Chaos zurecht.");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);

  AddDetail(({"stadtratshaus","haus"}),
    "Du befindest Dich mittendrin.");
  AddDetail(({"arbeitszimmer","zimmer","raum"}),
    "Es ist ein sehr geraeumiges Zimmer. Gross genug um Versammlungen, die wichtige"
    "Dinge betreffen, abzuhalten.");
  AddDetail("stadtrat",
    "Der Stadtrat von Hobbingen ist dazu da, um fuer das Allgemeinwohl aller "
    "Einwohner und Besucher von Hobbingen zu sorgen. Er kuemmert sich auch um alle "
    "jene, die neu in das Dorf kommen und sich ueberhaupt nicht auskennen. Wenn "
    "Stadtrat Zeus da ist, frag ihn einfach und er wird Dir sicherlich helfen wo "
    "er nur kann.");
  AddDetail(({"arbeitstisch","tisch"}),
    "Es ist ein ganz gewoehnlicher Arbeitstisch aus Eichenholz, der so stabil "
    "gebaut ist, sodass er die ganzen Pergamente und Schriftrollen und Zeus, wenn "
    "er bei der Arbeit einschlaeft, aushaelt.");
  AddDetail("pergamente",
    "Es sind viele, teils alte, teils neue beschriebene Pergamente. Sie enthalten "
    "fuer Dich meist uninteressante Dinge. Ein Pergament, welches ganz oben "
    "aufliegt, scheint aber irgendwie interessant zu sein, da es ziemlich neu ist.");
  AddDetail(({"pergament","schriftstueck"}),
    "Du drehst und wendest das Schriftstueck und kannst einen Bauplan erkennen.");
  AddDetail(({"bauplan","plan"}),
    "Nach laengerem studieren der unzaehlig vielen Linien und Zahlen, kannst Du er "
    "kennen, dass es sich hierbei um einen Bauplan fuer einen Leuchtturm handelt. "
    "Am unteren rechten Rand siehst Du eine blaue und eine rote Stempelung.");
  AddDetail(({"linien","zahlen"}),
    "Es sind wirklich unzaehlig viele.");
  AddDetail("stempelung",
    "Welche Stempelung willst Du den untersuchen ?");
  AddDetail("rote Stempelung",
    "In grossen roten Lettern kannst Du \"B E W I L L I G T\" lesen.");
  AddDetail("blaue Stempelung",
    "Diese Stempelung scheint noch frisch zu sein. Du kannst \"I M  B A U\" lesen.");
  AddDetail("lettern",
    "Sie sind saftig rot.");
  AddDetail(({"holz","eichenholz"}),
    "Ganz normales Eichenholz, wie es auch im Silberwald vorkommt.");
  AddDetail("schriftrollen",
    "Einige verstaubte Schriftrollen mit fuer Dich absolut uniteressatem Inhalt. "
    "Zwische den Rollen erkennst Du ein kleines Heftchen.");
  AddDetail("heftchen",
    "Wie gesagt, ein Heftchen. Irgendetwas an dem Heftchen scheint Dich magisch "
    "anzuziehen.");
  AddReadDetail("heftchen",
    "Lesen kannst Du das Heftchen nicht. Es scheint sich um eine fremde Schrift "
    "zu handeln. Was koennt man sonst noch mit einem Heftchen machen ?");
  AddCmd(({"blaettere"}), "blaettern");
  AddDetail("buecher",
    "Du erkennst einige alte Buecher. Ein ABSLG-Buch, ein 24-baendiges Lexikon, "
    "eine Bibel, ein DWL-Buch und eine wissenschaftliche Abhandlung.");
  AddDetail(({"ABSLG-buch","abslg-buch"}),
    "ABSLG heisst \"Allgemeines-Buergerliches-Silberland-Gesetz\" und dieses Buch "
    "beinhaltet dieses. Da Rechtstexte bekanntlich sehr verwirrend sind, ist es "
    "wohl besser kompetente Wesen fuer etwaige Fragen heranzuziehen, falls diese "
    "auch gewillt sind, zu Verfuegung stehen und die entsprechenden Bedingungen, "
    "sowie die fachliche Kompetenz auch aufweisen, anwenden und auslegen koennen. "
    "Laut Paragraph 8, Absatz 3, Punkt 4.1.1 sind solche Wesen Goetter. In Aus"
    "nahmefaellen, dass sind jene Faelle die vom herkoemmlichen Rechtsweg ausge "
    "schlossen sind und oder Faelle, deren Auswirkungen nicht absehbar, noch nie "
    "vorgekommen, bei denen eine Situation, definiert im Paragraph 23, Absatz 2, "
    "Punkt 14.1.23, auftritt und auch als solche gewertet werden, kann eine Volks"
    "abstimmung, welche in Paragraph 34, Absatz 3, Punkt 45.12.1 spezifiziert ist, "
    "die Rechtssprechung vornehmen. "
    "Aehm...alles klar ? :-))");
  AddDetail("lexikon",
    "Ein 24-baendiges, in Leder gebundenes Lexikon, welches unheimlich viel Wissen "
    "ueber das SL beinhaltet. Da Du Dich sicher nicht darin zurechtfinden wuerdest, "
    "solltest Du besser den Stadtrat fragen, wenn Du irgendetwas ueber das Silberland "
    "wissen willst.");
  AddDetail(({"leder","rehleder"}),
    "Es ist schon sehr altes Rehleder.");
  AddDetail(({"bibel","universalbibel"}),
    "Das ist eine Universalbibel. In ihr steht fuer jede Rasse der richtige Glauben. "
    "Somit kann der Stadtrat, falls jemand eine Glaubenskrise hat, mit Rat und Tat "
    "zur Seite stehen.");
  AddDetail(({"DWL-Buch","dwl-buch"}),
    "DWL heisst soviel wie \"Dorfwirtschaftslehre\" und ist ein sehr wichtiges Buch. "
    "Darin stehen all jene Dinge, die fuer ein Dorf wie Hobbingen rein wirtschaftlich "
    "gesehen, aeusserst wichtig sind.");
  AddDetail("abhandlung",
    "Du erkennst, dass sie ueber die Existenz von Elfen, Menschen und Zwergen handelt. "
    "Du blaetterst ein wenig darin und erkennst, sowie alle anderen Leser vor Dir, "
    "dass die Elfen, Menschen und Zwerge eigentlich ganz gesellige und nette "
    "Geschoepfe sind.");
  AddDetail(({"fass","tintenfass"}),
    "Es ist ein gewoehnliches, hoelzernes Tintenfass, randvoll gefuellt mit Tinte. Mit "
    "was den sonst als mit Tinte.");
  AddDetail(({"tinte","blaue tinte"}),
    "Blaue Tinte:");
  AddDetail(({"rok-feder","feder"}),
    "Es ist eine Feder des im Silberland beruechtigten Vogel-Rok. Die Feder ist am "
    "Kiel schraeg angespitzt und sie wird, wie sollte es anders sein, zum Schreiben "
    "verwendet.");
  AddDetail(({"tasse","kaffee","bohnenkaffee"}),
    "Die Tasse ist noch halbvoll und lauwarm.");
  AddCmd(({"trinke"}), "trinken");
  AddDetail(({"kuebel","mistkuebel"}),
    "Er quillt bereits ueber vor lauter Muell.");
  AddDetail(({"muell","mist"}),
    "Du durchwuehlst den Muell und findest einen Apfelbunzen, leere Jogurtbecher, "
    "alten Pfeifentabak, viele zerknuellte Zettel und sonstigen unidetifizierbaren "
    "Mist.");
  AddDetail("apfelbunzen",
    "Er ist bereits alt und ausgetrocket.");
  AddDetail("jogurtbecher",
    "Sie sind alle leer.");
  AddDetail("Alter Pfeifentabak der nicht mehr zu verwenden ist.");
  AddDetail("zettel",
    "Viele zerknuellte Zettel.");
  AddDetail(({"sessel","holzsessel"}),
    "Ein schlichter Sessel aus Holz.");  // auf den Sessel kann man sich setzen //
  AddDetail("arbeitssessel",
    "Ein normaler, gepolsterter Sessel aus Holz, in welchem der Stadtrat seine "
    "Arbeit verrichtet. Du kannst Dich hineinsetzen, lass Dich aber nicht dabei "
    "werwischen.");
  AddDetail("couch",
    "Eine kleine, gruene Couch mit vielen weissen Punkten. Gerade richtig zum "
    "Ausruhen. Sie ist so weich, dass man fast darin versinkt.");
    //sitze auf couch//
  AddDetail("eingang",
    "Durch den Eingang bist Du hereingekommen.");
  AddDetail("waende",
    "Die Waende sind in einem zarten hellblau, welches schon eher in ein weiss "
    "uebergeht, ausgemalt. Du siehst einige runde Fenster an den Waenden durch "
    "die das Sonnenlicht hereinfaellt und den Raum erhellt. Ueberall an den "
    "Waende befinden sich Regale und Schraenke. An der Wand hinter dem Schreibtisch "
    "befindet sich eine Tuer.");
  AddDetail(({"licht","sonnenlicht"}),
    "Es kommt von der Sonne. Toll was ?");
  AddDetail("fenster",
    "Sie sind sauberst geputzt und rund.");
  AddDetail("regale",
    "Sie sind vollgestopft mit alten Akten und Unterlagen. Bloederweise kannst Du "
    "kein System erkennen, wie die Akten und Unterlagen geordnet sind, daher hat es "
    "wahrscheinlich keinen Zweck hier nach etwas zu suchen.");
  AddDetail("schraenke",
    "Genauso voll wie die Regale und genauso sinnlos irgendetwas darin zu suchen.");
  AddDetail(({"akten","unterlagen"}),
    "Du wirst gleich in eine Scriptfalle tappen !!!! Es hat keinen Zweck. Verstehst "
    "Du das nicht ?");
  AddDetail("Es ist eine sonderbare Tuere aus massivstem Eichenholz. Auf der Tuer "
    "ist ein Schild befestigt.");
  AddDetail(({"schild","eisen"}),
    "Ein Schild aus Eisen.");
  AddReadDetail("schild",
    "Zur Zeit kein Eintritt fuer Unbefugte.");
  AddExit( "raus", "./hauptstrasse4" );
}

int blaettern(string str)
{
  notify_fail("In was willst Du den Blaettern ?\n");
  if( !str ) return 0;
  if( str=="heftchen" || str=="heft")
  {
    write( BS(
  "Du schlaegst die erste Seite des Heftchens auf und ein lautes \"WOW\" kommt "
  "aus Deinem Mund. Du schlaegst die naechste Seite auf und beginnst begeistert "
   "zu peifen. Ploetzlich faengst Du an zu schwitzen. Hektisch blaetterst Du das "
    "Heftchen bis zur letzten Seite durch und legst es mit hochrotem Kopf an genau "
    "die selbe Stelle zurueck. Es ist Dir wohl die Schamroete ins Hirn gestiegen.") );
   return 1;
  }
  return 0;
}

int trinken(string str)
{
  notify_fail("Was willst Du den Trinken ?\n");
  if( !str ) return 0;
  if( str=="kaffee" || str=="bohnenkaffee" || str=="tasse")
  {
    write( BS(
      "Es ist der Kaffee vom Stadtrat und er waere sicher nicht gluecklich "
      "darueber, wenn Du ihn austrinkst. Darum laesst Du das sein.") );
   return 1;
  }
  return 0;
}

