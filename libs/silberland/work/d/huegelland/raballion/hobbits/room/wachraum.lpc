// Wachraum in Hobbingen
// 1997-04-24  Feyaria@SilberLand
// 1997-09-10  raballion@
//             den raum an Derlim angepasst
// 1997-10-07  raballion@
//             wachen erschaffen verbessert

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <mnpc.h>

murmeln();
sound();
gugs();


object kobj;



create()
{
  ::create();

  SetProp(P_INT_SHORT, "Wachhuette" );
  SetProp(P_INT_LONG,
    "Du stehst in der Wachhuette von Derlim. Sie ist an sich karg "
    "eingerichtet. Nur ein Tisch, ein paar Sessel und einige Betten. Sonst "
    "siehst Du hier nichts Besonderes. Hier ruhen sich die Wachen aus, wenn "
    "sie gerade nicht Dienst haben. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({ "huette", "raum", "wachhuette"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"stadt", "hobbingen", "derlim"}),
    "Du befindest Dich in der Stadt Derlim. Von anderen Rassen wird sie aber Hobbingen genannt.");

  AddDetail( ({"tisch"}),
    "Der Tisch ist aus grob gehobelten Brettern gezimmert. Durch die "
    "taegliche Benuetzung ist er schon ganz blank poliert.");
  AddDetail( ({"bretter"}),
    "Die grob gehobelten Bretter sind auf der Oberseite schon ganz glatt "
    "poliert. Da duerfte sich wirklich niemand viel Muehe damit gemacht "
    "haben.");
  AddDetail( ({"muehe"}),
    "Jemand denkt . o O (Da kann wer wohl nicht lesen ;-) )");
  AddDetail( ({"oberseite"}),
    "Sie ist vom vielen Benutzen blank poliert.");
  AddDetail( ({"benutzen", "benuetzen", "lesen"}),
    "Wer untersucht da nominal gebrauchte Verben??");
  AddDetail( ({"sessel"}),
    "Einige Sessel, die in ihrer Schlichtheit dem Tisch um nichts "
    "nachstehen.");
  AddDetail( ({"schlichtheit", "schlicht"}),
    "Alles hier ist schlicht, nichts ist prunkvoll.");
  AddDetail( ({"bett", "betten"}),
    "Die Betten sind einfach, stabil aber sie scheinen gemuetlich zu sein. "
    "Da hier nur Hobbits schlafen, sind sie entsprechend kurz.");
  AddDetail( ({"dienst", "dienste"}),
    "Hobbits versehen ihre Dienste immer gewissenhaft.");
  AddDetail( ({"boden"}),
    "Der Boden ist mit Steinplatten ausgelegt. Es ist - fuer diesen Raum - "
    "ungewoehnlich sauber verlegt. Eine Falltuer befindet sich am hinteren "
    "Ende des Raumes.");
  AddDetail( ({"tuer"}),
    "Keine Tuer sondern eine Falltuer! Weil die Tuere so oft hingefallen ist, "
    "liegt sie jetzt ganz erschoepft am Boden.");
  AddDetail( ({"ende"}),
    "Am Ende des Raumes befindet sich eine Falltuer.");  
  AddDetail( ({"steinplatte", "steinplatten", "platte", "platten", "stein"}),
    "Sauber verlegt. Auch wenn diesem Raum sonst nicht besonders viel "
    "Aufmerksamkeit geschenkt wurde, nasse Fuesse scheinen Hobbits sich "
    "nicht holen zu wollen.");
  AddDetail( ({"fuss", "fuesse"}),
    "Du suchst und findest ... eins ... zwei .... Ja genau. Zwei Fuesse. "
    "Und beides Deine. Welch ein Glueck!");
  AddDetail( ({"aufmerksamkeit"}),
    "Diese beweist Du beim Lesen sicher nicht.");
  AddDetail( ({"wand", "waende"}),
    "Die Waende sind hier wie alles Andere - richtig - schlicht, aber "
    "stabil. Die Hecke umwuchert die Wachhuette so sehr, dass Sie wohl "
    "auch ohne Waende stehen wuerde. Trotzdem bist Du froh, das die Decke "
    "nicht einfach so ueber Dir schwebt.");
  AddDetail( ({"hecke", "srauch", "straeucher"}),
    "Die ist von draussen sicher besser zu bewundern. Also schau lieber dort nach.");
  AddDetail( ({"decke"}),
    "Einige gusseisene Leuchter haengen von der Decke, die aus starken "
    "Pfosten besteht. Warum Hobbits sie so hoch gebaut haben, erscheint "
    "Dir raetselhaft.");
  AddDetail( ({"leuchter"}),
    "Wie gesagt - aus Gusseisen. So nebenbei spenden sie auch noch Licht "
    "fuer diesen toll moeblierten Raum.");
  AddDetail( ({"gusseisen"}),
    ([ 0:        "Ach, such Dir doch einen Zwerg, der Dir das erklaert.",
       "mensch": "Ach, such Dir doch einen Zwerg, der Dir das erklaert.",
       "zwerg" : "Also Gusseisen sollte Dir schon was sagen.",
       "hobbit": "Ach, such Dir doch einen Zwerg, der Dir das erklaert.",
       "elf"   : "Ach, such Dir doch einen Zwerg, der Dir das erklaert."
     ])
     );
  AddDetail( ({"licht"}),
    "Ist wohl vorhanden, wie wuerdest Du sonst etwas sehen?");
  AddDetail( ({"pfosten"}),
    "Die dicken Pfosten wuerden sicher lange Angriffen standhalten. Gott "
    "sei dank wurde das aber noch nie erprobt.");
  AddDetail( ({"angriff", "angriffe"}),
    "Solche gab es hier noch nie. Trotzdem sind die Hobbits immer wachsam "
    "genug, um sich notfalls verteidigen zu koennen.");
  AddDetail( ({"wachen"}),
    "Hier sind die Wachen von Derlim stationiert.");
  AddDetail( ({"derlim"}),
    "Du bist in Derlim, oder hast Du das schon vergessen?");
  AddDetail( ({"hobbit", "hobbits"}),
    "Die Hobbits leben in Derlim.");

  AddSound( ({ DEFAULT_SOUND }),#'sound);

  AddSound( ({"murmeln"}),#'murmeln );

  AddSmell( ({DEFAULT_SMELL}),
    "Von draussen dringt der Duft der vielen Straeucher herein.");
  AddSmell( ({"duft", "geruch"}),
    "Du riechst einen leichten Geruch von der Hecke her schweben.");

  AddItem( NPC "buettel", REFRESH_DESTRUCT, ([P_NAME: "Do", 
       P_MNPC_AREA: ({ROOM "haupt", ROOM "nordtor", ROOM "wachraum"}) ]) );
  AddItem( NPC "echse", REFRESH_DESTRUCT, ([P_NAME: "Cisss", 
       P_MNPC_AREA: ({ROOM "haupt", ROOM "nordtor", ROOM "wachraum"}) ]) );
  AddItem( NPC "oberbuettel", REFRESH_DESTRUCT);
  
  AddExit( "suedwesten", "./nordtor" );
  NewDoor("unten", ROOM "echsenraum", ({"falltuer", "falltuere" }), 
      ({ D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED | DOOR_NEEDKEY | DOOR_CLOSEKEY,
         D_SHORT, "Eine %se Falltuer.",
         D_LONG, "Die Falltuer besteht aus hartem Holz und ist mit "
                    "Eisenstreben verstaerkt.\n",
         D_NAME, "Falltuer",
         D_GENDER, FEMALE,
         D_CMDS, "oeffne",
         D_TESTFUNC, "buetteltest",
         D_OPENTESTFUNC, "schluesseltest",
         D_CLOSETESTFUNC, "tuer_zu",
         }) );

  AddDetail( ({"holz", "eisenstreben", "eisen", "streben"}),
    "Das harte Holz und die Eisenstreben machen die Falltuer "
    "einbruchssicher.");  
  AddCmd( ({"poliere", "poliere"}), "polieren");
}

mixed buetteltest()
{
  object ob;
  if( ob=present("wache") )
  {
    write(ob->Name(WER,1)+" laesst Dich nicht durch die Falltuere gehn.\n");
    return 1;
  }
  return 0;
}

mixed tuer_zu()
{
  write("Die Falltuere laesst sich nicht schliessen.\n");
  return 1;
}

mixed schluesseltest()
{
  object key;
  if( key = deep_present("\nderlim_falltuer_key", TP) ) {
    call_out("key_weg",0, key);
    return 0;
  }
  write("Damit kannst Du die Falltuer nicht oeffnen.\n");
  return 1;
}

void key_weg(object key)
{
  write(key->Name(WER,1)+" zerbroeselt zu Staub.\n");
  key->remove();
}
    
sound()
{
  if( present("wache") )
    return "Du hoerst das Murmeln der Wachen.\n";
  else
    return "Du hoerst hier nicht viel.\n";
}

murmeln()
{
  if( present( "wache") )
    return BS("Die Wachen unterhalten sich. Du kannst aber nich verstehen, "
        "wovon sie sprechen.");
  else
    return 0;
}

      
int gugs()
{

return 1;

}

int polieren(string str)
{
  notify_fail("Was willst Du polieren?\n");
  if( str!="tisch") return 0;
  write("Der Tisch ist schon poliert, kein Grund da noch nachzuhelfen.");
  return 1;
}
