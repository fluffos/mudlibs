//             den raum an Derlim angepasst

#include <properties.h>
#include <language.h>
#include "../def.h"

inherit "std/room";

string tafel();

void create()
{
  ::create();
  	
  SetProp(P_INT_SHORT,"Heilige Staette in Derlim");
  SetProp(P_INT_LONG,
    "Du stehst mitten in der Heiligen Staette der Hobbits. Du realisierst die "
    "wunderbare Pracht dieser Staette und nimmst vor Ehrfurcht eine leicht "
    "gebueckte Haltung ein. Hunderte von grossen Kerzen, die dieser Staette "
    "ihr Licht schenken, stehen ringsum und geben diesem Ort eine magische "
    "Ausstrahlung. Die Waende des Raumes werden nach vorne hin immer enger, "
    "sodass der Raum die Form eines Dreieckes hat. In der Spitze dieses "
    "Dreieckes steht ein glitzernder Altar. Neben dem Altar haengt eine "
    "Heldentafel.");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"erbauer", "kuenstler", "handwerk", "handwerkskunst", "meister",
               "handwerker"}),
    "Dafuer sind die Hobbits verantwortlich.");
  AddDetail( ({"ausstrahlung", "ort"}),
    "Dieser Ort hat eine fast magische Ausstrahlung.");
  AddDetail( ({"ehrfurcht", "haltung"}),
    "Du nimmst vor Ehrfurcht eine leicht gebueckte Haltung ein.");
  AddDetail( ({"hobbits", "hobbit"}),
    "Die Hobbits werden hier geboren.");
  AddDetail(({"staette","heilige staette", "heiligtum", "raum"}),
    "Du befindest Dich mitten drin.");
  AddDetail("pracht",
    "Sie ist einfach ueberwaeltigend.");
  AddDetail("decke",
    "Sie besteht aus weissem Marmor.");
  AddDetail("marmor",
    "Es ist ganz normaler Marmor. Du kannst jedoch einen kleinen dunklen Fleck "
    "erkennen.");
  AddDetail(({"fleck","dunklen fleck"}),
    "Als Du genauer hinsiehst erkennst Du, dass es sich um eine Spinnwebe "
    "handelt.");
  AddDetail("spinnwebe",
    "Die Spinnwebe scheint schon sehr alt zu sein, weil Du keine Spinne darin "
    "erkennen kannst.");
  AddDetail( ({"spinne"}),
    "Hier ist keine Spinne!");
  AddDetail("boden",
    "Der Boden der Staette besteht, wie die Decke, aus weissem Marmor. "
    "Ueberall stehen brennende Kerzen herum und Du musst aufpassen, dass Du "
    "keine umstoesst.");
  AddDetail("marmor",
    "Er ist blankpoliert, sodass sich die hell leuchtenden Kerzen darin "
    "spiegeln.");
  AddDetail("wachs",
    "Die Wachskerzen bestehen aus Wachs.");
  AddDetail(({"kerzen","wachskerzen"}),
    "Es sind besonders hell leuchtende, weisse Wachskerzen.");
  AddDetail("licht",
    "Das Licht kommt von den hunderten von Kerzen.");
  AddDetail( ({"waende", "wand"}),
    "Die Waende sind ueber und ueber mit kunstvollen Fresken verziert. Ein "
    "Kerzenhalter ist an einer Wand befestigt.");
  AddDetail(({"halter","kerzenhalter", "platz"}),
    "Er ist sehr gross, ist aus Gold und bietet sicherlich sehr vielen Kerzen "
    "Platz. Du kannst ein kleines Schild erkennen.");
  AddDetail("schild",
    "Es ist wie der Kerzenhalter aus Gold. Du koenntest versuchen es zu "
    "lesen.");
  AddDetail( ({"gold"}),
    "Das ganze Gold ist hier sicher sehr wertvoll.");
  AddReadDetail("schild",
    "Bringe Licht in Deine dunkle Seele und zuende eine Kerze fuer die vielen "
    "im Kampf umgekommenen Hobbits an. Fuer nur 25 Muenzen vollbringst Du "
    "diese gute Tat. Das Geld wird dem Fond fuer Witwen und Waisen "
    "zugute kommen.");
  AddDetail("fresken",
    "Die Waende sind damit verziert. Die Hobbits mussen wohl grosse Kuenstler "
    "sein. Ein Fresko faellt Dir besonders auf.");
  AddDetail("fresko",
    "Das Fresko stellt eine undefinierbare Gestalt im Licht vieler Kerzen "
    "dar.");
  AddDetail(({"gestalt","gottheit"}),
    "Es handelt sich hier wohl um die oberste Gottheit der Hobbits. Genaueres "
    "kannst Du leider nicht mehr erkennen.");
  AddDetail( ({"dreieck", "form"}),
    "Du siehst hier kein Dreieck. Es ist nur der Raum der die Form eines "
    "Dreiecks hat.");
  AddDetail( ({"spitze"}),
    "Der Altar steht in der Spitze des Dreiecks.");
  AddDetail( ({"altar", "schoenheit"}),
    "Es ist ein atemberaubender, aus Aquamarin gemachter Fluegelaltar. Du bist "
    "ueberwaeltigt von seiner Schoenheit.");
  AddDetail( ({"aquamarin", "kristall"}),
    "Aus diesem Kristall ist der Fluegelaltar gefertigt.");
  AddDetail("fluegelaltar",
    "Der Fluegelaltar besteht aus einem Mittelteil und zwei Seitenfluegeln.");
  AddDetail( ({"mittelteil", "mitte"}),
    "Er besteht aus reinem, wundervoll leuchtendem und glaenzendem Aquamarin. "
    "Einige Symbole und Figuren sind hier hineingemeisselt. Am unteren Rand "
    "ist eine kleine Aquamarinplatte befestigt. In der Mitte des Mittelteiles "
    "befindet sich ein kleines, quadratisches Tuerchen.");
  AddDetail( ({"rand"}),
    "Am unteren Rand ist eine kleine Aquamarinplatte befestigt.");
  AddDetail(({"symbole", "figuren", "bedeutung"}),
    "Sie sind nur von religioeser Bedeutung und interessieren Dich nicht "
    "weiter.");
  AddDetail( ({"tuerchen", "tuer"}),
    "Du erkennst dass das Tuerchen aus purem Gold gefertigt wurde. Vielleicht "
    "befindet sich das Heiligtum der Hobbits dahinter. Du erkennst aber auch "
    "dass sich dieses Tuerchen mit nichts in der Welt oeffnen laesst.");
  AddDetail(({"platte","aquamarinplatte"}),
    "Auf der Platte befinden sich einige kleine Staender.");
  AddDetail("staender",
    "In den Staendern stecken Raeucherstaebchen. Sie sind vor kurzem frisch "
    "angezuendet worden.");
  AddDetail(({"staebchen","raeucherstaebchen"}),
    "Es sind herrlich nach Moschus duftende Raeucherstaebchen.");
  AddDetail("moschus",
    "Die Staebchen riechen danach.");
  AddDetail( ({"seitenfluegel", "teile"}),
    "Die beiden Seitenfluegel sind ebenfalls kunstvoll aus Aquamarin "
    "gefertigt. Unuebersehbar, dass diese beiden Teile ein grosser Meister der "
    "Handwerkskunst gefertigt haben muss. Da der Altar schon viele Hunderte "
    "Jahre alt ist, wird der Erbauer wohl kaum noch leben.");
  AddDetail( ({"welt", "silberland", "sl"}),
    "Diese Welt ist das SilberLand, auch SL genannt.");

  AddDetail( ({"tafel", "heldentafel"}),
    "Die Heldentafel haengt neben dem Altar. Auf ihr sind die groessten "
    "Helden der Hobbits eingetragen. Du kannst sie lesen.");
  AddReadDetail( ({"heldentafel", "tafel"}), #'tafel);

  AddSound(({DEFAULT_SOUND, "stille", "herz", "pochen"}),
    "Du lauscht und hoerst nichts. Hier herrscht Stille. Eine unendliche "
    "Stille. Es ist absolut still. Du hoerst nicht mal Dein eigenes Herz "
    "pochen. Erstaunlich, nicht?");
  AddSmell(({DEFAULT_SMELL,"raeucherstaebchen","staebchen","luft"}),
    "Du schnupperst in der Luft und der Geruch von Moschus steigt Dir in Deine "
    "feine Nase. Der Geruch scheint von den Raeucherstaebchen zu kommen.");
  AddSmell( ({"moschus"}),
    "Die Staebchen riechen danach.");

  AddItem("/p/service/obj/zettel/zettelmaschine", REFRESH_REMOVE);
  AddItem("/obj/zeitungsautomat", REFRESH_REMOVE);

  AddExit( "norden", "./hauptplatz");

  AddCmd ("bete","bete");
  AddCmd( ({"zuende", "zuend"}), "zuenden");
}

int bete() 
{
  write ("Du kniest nieder und haeltst eine kurze Andacht.\n");
  if (this_player()->QueryProp(P_GHOST))
  {
    say ("Der Geist von "+this_player()->name()+
      " kniet nieder und haelt eine kurze Andacht.\n");
    write ("Eine sehr starke Kraft saugt Dich auf und spuckt Dich wieder "+
      "aus.\nDu spuerst langsam wieder, wie Blut Deinen Koerper von neuem "+
      "durchstroemt.\n");
    say (this_player()->name()+" erscheint ploetzlich wieder in "+
      "koerperlicher Form.\n");
    this_player()->SetProp(P_GHOST,0);
  }
  else
    say (this_player()->name()+" kniet nieder und haelt eine kurze Andacht.\n");
  return 1;
}
 
int zuenden(string str)
{
  notify_fail( "Was willst Du anzuenden?\n");
  if( !str) return 0;
  if( str=="kerze an" || str== "kerzen an" )
  {
    if(TP->QueryMoney()>25 )
    {
      write( BS("Du zuendest eine Kerze an und Du fuehlst Dich gleich viel "
        "besser, weil Du eine gute Tat vollbracht hast. Die Witwen und Waisen "
        "des Silberlandes werden es Dir danken.") );
      say( CAP_TPN + " zuendet eine Kerze an.\n");
      TP->AddMoney(-25);
      return 1;
    }
    else
      notify_fail("Leider hast Du zuwenig Geld.\n");
  }
  return 0;
}

string tafel()
{
  TP->more("/etc/tophobbits.read",1);
  return "";
}


