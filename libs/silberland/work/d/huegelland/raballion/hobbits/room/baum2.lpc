#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Auf einem Baum inmitten von Derlim" );
  SetProp(P_INT_LONG,
    "Du bist weit oben und dir wird leicht schwindelig. Mit "
    "einem Kennerblick stellst Du die Anwesenheit eines Talan fest. Tja, "
    "Raballion braucht doch sein Haus und daher befindet es sich "
    "selbstverstaendlich auf einem Baum.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_FOREST]) );

// standart details fuer die stadt
#include "details_stadt.h"

// standart details fuer aussen
#include "details_aussen.h"

// standart details fuer gruppen von raeumen
// #include "details_hauptstr.h"
    

  AddDetail( ({ "haus", "baumhaus", "elfenhaus"}),
    "Ein sehr schoenes, typisches Elfenhaus. Man kann es eventuell betreten.");
  AddDetail( ({ "talan", "plattform", "anwesenheit"}),
    "Das ist die Plattform, auf der das Haus steht.");
  AddDetail( ({ "kennerblick", "blick"}),
    "Nur Elfen besitzen so etwas wirklich.");


  AddDetail( ({ "baum"}),
    "Jepp am Baum ist alles dran, was ein Baum so hat: Stamm, Aeste, Zweige "
    "und Blaetter.");
  AddDetail( ({ "ast", "aeste"}),
    "Ein Ast halt.");
  AddDetail( ({ "stamm"}),
    "Am Stamm wachsen Aeste raus und und daraus Zweige und daran haengen "
    "Blaetter.");
  AddDetail( ({ "blatt", "blaetter", "zweig", "zweige"}),
    "Aus den Aesten wachsen Zweige und daran haengen Blaetter. Schoen nicht?");

  AddDetail( ({ "platz", "hauptplatz", "stadtkern", "boden"}),
    "Der befindet sich unter Dir und es wird Dir beim runterschauen leicht "
    "schwindelig.");
  AddDetail( ({"wunder"}),
    "Wunder sind moeglich, man muss nur daran glauben.");
  AddDetail( ({ "landschaft", "aussicht" }),
    "Die Aussicht auf die Landschaft ist einfach wunderschoen.");
  AddDetail( ({"huegel", "staedteplanung", "aesthetik"}),
    "Die meisten Haeuser in Derlim bestehen aus Huegeln. Im Norden, sowie im "
    "Sueden, siehst du einen kleinen bzw. mittleren, im Suedosten einen doch "
    "deutlich groesseren Huegel. Ahja, den weiteren Huegel im Nordosten "
    "haette ich fast vergessen. Das Gebaeude im Westen allerdings ist ein "
    "gemauertes Haus. Wenn Du sie untersuchen moechtest, musst Du erst vom "
    "Baum runter.");
  AddDetail( ({"detail"}),
    "Warum sollte das Detail \'detail\' beschrieben sein?\n");
  AddDetail( ({"himmel"}),
    "Treffer. Ein solcher ist ueber Dir. Richtig unerwartet, hier draussen "
    "im Freien. Jaja. Wolken, Sonne, alles da.");
  AddDetail( ({"sonne"}),
    "Sonne? Ueber Dir, warm strahlend, genau ein mal vorhanden, wie es "
    "sich fuer eine richtige Sonne im Silberland gehoert. Was hast Du Dir "
    "auch anderes erwartet?");
  AddDetail( ({"wolke", "wolken"}),
    "Da bist Du wohl einer Falschmeldung erlegen. Der Himmel ist wolkenlos.");
  AddDetail( ({"falschmeldung"}),
    "Extra fuer Dich .");
  AddDetail( ({"frei", "freien", "draussen", "raum"}),
    "Du bist ganz einfach im Freien. Oder glaubst Du, ein Baum ist "
    "ein Raum?");

  AddSound( ({ DEFAULT_SOUND }),
    "Du hoerst viele geschaeftige Hobbits unter Dir.");
  AddSmell( ({DEFAULT_SMELL, "duft", "luft", "geruch", "gerueche"}),
    "Viele verschiedene Gerueche dringen auf Dich ein. Aus dem Westen dringt "
    "eine verfuehrerische Duftwolke auf Dich ein.");
  AddSmell( ({"duftwolke", "duftwolken"}),
    "Auf unerklaerliche Weise bekommst Du Hunger. Lieg das etwa daran, dass "
    "Dir der Duft von Frittatensuppe, Spanferkeln und vielem Anderen in die "
    "Nase steigt?");

  AddCmd (({"klettere","kletter"}), "kletter");
  AddCmd (({"betrete", "betreten", "betritt"}), "rein");

  AddExit( "runter", "./baum");

 
}

int kletter(string str)
{
  string race;

  notify_fail ("Wohin willst Du klettern?\n");
  if (!str) return 0;
  if ( str=="nach unten" || str=="runter" || str=="unten")
  {     
    if( TP->QueryProp(P_RACE)=="Elf" )
      write(BS("Froehlich steigst Du hinunter. "+
             "In einem Baum fuehlst Du Dich einfach zuhause."));
    else
      write("Du kletterst vom Baum hinunter.\n");
    TP->move(ROOM"baum.lpc", M_GO, "unten", "klettert nach", 
        "kommt herabgeklettert");
    return 1;
  }
  return 0;
}

int rein(string str)
{

   notify_fail ("Was willst Du betreten\n");
   if (!str) return 0;
      
  if ( str=="in haus" || str=="haus" || str=="elfenhaus")
    {     
      write("Du betrittst das Haus von Raballion.\n");
      TP->move(ROOM"haus1.lpc", M_GO, "in das Haus");
      return 1;
    }
    else
      return 0;
}

