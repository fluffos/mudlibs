#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Wohngebiet von Derlim" );
  SetProp(P_INT_LONG,
    "Hier im Wohngebiet ist es eigentlich ganz ruhig und beschaulich. Ueberall kann man die "+
    "grasbewachsenen Huegel mit teilweise sehr schoenen Vorgaerten der Einwohner sehen. "+
    "Falls Du die Bedingungen erfuellst, kannst Du Dich bei der Stadtverwaltung "+
    "nach einem Ort fuer Deinen Huegel erkundigen: "+
    "Die Adresse von hier ist uebrigens \"Wohnweg 4\". "+
    "Nach Sueden geht es zum Weinberg von Derlim.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// standart details fuer die stadt
#include "details_stadt.h"

// standart details fuer aussen
#include "details_aussen.h"

// standart details fuer gruppen von raeumen
#include "details_wohngeb.h"


    
//  AddDetail( ({""}),
//    "");

  AddDetail( ({"weinberg", "wein", "weintrauben", "trauben"}),
    "Im Weinberg werden Weintrauben fuer den beruehmten Derlimer Wein "
    "angepflanzt. Es ist die Aufgabe der jungen Hobbits, den Weinberg von "
    "Ungeziefer sauber zu halten. So koennen die Junghobbits ihre erste "
    "Erfahrung im SilberLand machen.");
  AddDetail( ({"junghobbits", "erfahrung", "ungeziefer"}),
    "Der Kampf gegen das Ungeziefer bringt sicher einige Erfahrung fuer "
    "jeden Junghobbit.");
  AddDetail( ({"silberland"}),
    "Alles rund um Dich ist das SilberLand.");  

  AddItem( NPC "hobbit", REFRESH_DESTRUCT);

  AddExit( "westen", "./wohngebiet3");
  AddExit( "sueden", "../../weinberg/room/apark1");

}

