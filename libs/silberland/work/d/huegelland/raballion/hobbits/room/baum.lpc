#define SDMASTER "/obj/sehertormaster"
#define P_SEERDOOR_DISCOVER "rw_sehertor_disc"
#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Auf einem Baum inmitten von Derlim" );
  SetProp(P_INT_LONG,
    "Die Aussicht von dem Baum ist herrlich und es wird Dir die Aesthetik der "+
    "Staedteplanung von Derlim klar. Schoen in die Landschaft integriert, gemuetlich "+
    "und nichts laesst auch nur annaehernd irgend etwas Hektisches verspueren. "+
    "So sitzt Du nun, mehr oder minder bequem, auf dem Baum und geniesst die "+
    "Atmosphaere. Waere ja auch noch schoener an diesem wunderschoenen Ort "+
    "Stress aufkommen zu lassen. Weiter oben faellt Dir ein Talan auf.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// standart details fuer die stadt
#include "details_stadt.h"

// standart details fuer aussen
#include "details_aussen.h"

// standart details fuer gruppen von raeumen
// #include "details_hauptstr.h"
   
  AddDetail( ({"atmosphaere", "ort", "stress"}),
    "Du geniesst die gemuetliche Atmosphaere auf dem Baum, denn dieser Ort "
    "laesst keinen Stress aufkommen.");  
  AddDetail( ({ "baum"}),
    "Jepp am Baum ist alles dran, was ein Baum so hat: Stamm, Aeste, Zweige und Blaetter.");
  AddDetail( ({ "ast", "aeste"}),
    "An einem Ast entdeckst Du ein Loch.");
  AddDetail( ({ "stamm"}),
    "Am Stamm wachsen Aeste raus und und daraus Zweige und daran haengen Blaetter.");
  AddDetail( ({ "loch"}),
    "Vielleicht solltest Du mal hineingreifen...?");
  AddDetail( ({ "blatt", "blaetter", "zweig", "zweige"}),
    "Aus den Aesten wachsen Zweige und daran haengen Blaetter. Schoen nicht?");

  AddDetail( ({ "platz", "hauptplatz", "stadtkern", "boden"}),
    "Der befindet sich unter Dir und es wird Dir beim runterschauen leicht schwindelig.");
  AddDetail( ({ "landschaft", "aussicht" }),
    "Die Aussicht auf die Landschaft ist einfach wunderschoen.");
  AddDetail( ({"huegel", "staedteplanung", "aesthetik"}),
    "Die meisten Haeuser in Derlim bestehen aus Huegeln. Im Norden, sowie im Sueden, "
    "siehst du einen kleinen bzw. mittleren, im Suedosten einen doch deutlich groesseren "
    "Huegel. Ahja, den weiteren Huegel im Nordosten haette ich fast vergessen. "
    "Das Gebaeude im Westen allerdings ist ein gemauertes Haus. Wenn Du sie untersuchen "
    "moechtest, musst Du erst vom Baum runter.");
  AddDetail( ({"detail"}),
    "Warum sollte das Detail \'detail\' beschrieben sein?");
  AddDetail( ({"himmel"}),
    "Treffer. Ein solcher ist ueber Dir. Richtig unerwartet, hier draussen "
    "im Freien. Jaja. Wolken, Sonne, alles da.");
  AddDetail( ({"sonne"}),
    "Sonne? Ueber Dir, warm strahlend, genau ein mal vorhanden, wie es "
    "sich fuer eine richtige Sonne im Silberland gehoert. Was hast Du Dir "
    "auch anderes erwartet?");
  AddDetail( ({"wolke", "wolken"}),
    "Da bist Du wohl einer Falschmeldung erlegen. Der Himmel ist wolkenlos.");
  AddDetail( ({"falschmeldung"}),
    "Extra fuer Dich (und fuer eine ganz besondere Neugierdsnase).");
  AddSpecialDetail( ({"neugierdsnase"}), "neugier" );
  AddDetail( ({"insel", "mitte"}),
    "In der Mitte des Hauptplatzes ist eine kleine Insel. Auf ihr steht "
    "ein grosser Baum und davor eine gemuetliche Bank.");
  AddDetail( ({"frei", "freien", "draussen", "raum"}),
    "Du bist ganz einfach im Freien. Oder glaubst Du, ein Baum ist "
    "ein Raum?");
  AddDetail( ({"talan"}),
    "Wenn Du den Talan untersuchen willst, musst Du schon naeher ran klettern.");

  AddSound( ({ DEFAULT_SOUND }),
    "Du hoerst viele geschaeftige Hobbits unter Dir.");
  AddSmell( ({DEFAULT_SMELL, "duft", "luft", "geruch", "gerueche"}),
    "Viele verschiedene Gerueche dringen auf Dich ein. Aus dem Westen dringt "
    "eine verfuehrerische Duftwolke auf Dich ein.");
  AddSmell( ({"duftwolke", "duftwolken"}),
    "Auf unerklaerliche Weise bekommst Du Hunger. Liegt das etwa daran, dass "
    "Dir der Duft von Frittatensuppe, Spanferkeln und vielem Anderen in die "
    "Nase steigt?");

  AddCmd( ({"greif", "greife"}), "greif");
  AddCmd (({"klettere","kletter"}), "kletter");

  AddExit( "runter", "./hauptplatz");
 
  AddItem("/obj/sehertor", REFRESH_REMOVE, ([P_SEERDOOR_DISCOVER: 0]) );
}

int greif(string str)
{

  notify_fail ("Wo hinein willst Du denn greifen?\n");
  if( !str ) return 0;
  if ( str=="in astloch" || str=="in loch" )
  {
    write(BS("Du fuehlst einen Knopf im Astloch und weil Du ein mutiges "
             "Wesen hast, drueckst Du ihn auch gleich..."));
//  hier die fkt fuer das Sehertor
    if( IS_SEER(TP) && SDMASTER->DiscoverDoor(ROOM "baum") )
    {
      write("Ploetzlich siehst Du ein Sehertor vor Dir.\n");
      WLOG( LOG "sehertor", "entdeckt das Sehertor in Derlim");
    }
    else
      write("Du drueckst den Knopf und nichts passiert.....\n");
    return 1;
  }
  return 0;
}
int kletter(string str)
{
   string race;

   notify_fail ("Wohin willst Du klettern?\n");
   if (!str) return 0;
      
   race = TP->QueryProp(P_RACE);
   
  if ( str=="nach oben" ||
        str=="oben" ||
        str=="rauf"||
        str=="auf den baum" ||
        str=="auf baum"||
        str=="baum"||
        str=="zum talan"||
        str=="talan"||
        str=="hinauf")
    {     
    switch(race)
      {
      case "Elf":
        {
        write("Froehlich steigst Du die Aeste hinauf. "+
              "In einem Baum fuehlst Du Dich einfach zuhause.\n");
        TP->move(ROOM"baum2.lpc", M_GO, "klettert nach oben");
        return 1;
        }
      default:
        {
        write("Du beginnst ohne Furcht nach oben zu klettern.\n");
        TP->move(ROOM"baum2.lpc", M_GO, "klettert nach oben");
        return 1;
        }
      }
    }
  else
    return 0;
}

string neugier()
{
  if( TPN=="Vivienne" )
    return "Ja, DU bist gemeint.\n";
  else
    return "Neugierdsnase? Das kann nur Vivienne sein!\n";
}

int _query_tport_cost_in()
{
  if( TP && TP->QueryProp(P_RACE) == "Hobbit" )
    return -2;
  return 0;
}

int _query_tport_cost_out()
{
  if( TP && TP->QueryProp(P_RACE) == "Hobbit" )
    return -2;
  return 0;
}

