// /d/huegelland/raballion/hobbits/room/haus1.c
// in Derlim
// 1997-11-21  raballion@
//             den raum gemacht 

#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Baumhaus von Raballion" );
  SetProp(P_INT_LONG,
    "Sehr schoen denkst Du Dir dabei. Wirklich sehr schoen. Dieses Haus hat "+
    "alles um es wohnlich zu gestalten. Einen Boden, eine Decke, vier Waende, "+
    "eine Tuer, einen Tisch, zwei Stuehle, einen Schrank, ein Fenster, "+
    "zwei Bilder.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// standart details fuer die stadt
#include "details_stadt.h"

// Haus
  AddDetail( ({ "haus", "baumhaus"}),
    "Du bist im Haus von Raballion und findest es schlichtweg schoen. Kein "+
    "Wunder, dass die Wahl des beratenden Architekten von Derlim auf ihn fiel.");
  AddDetail( ({ "talan", "plattform"}),
    "Das ist die Plattform, auf der das Haus steht. So etwas solltest Du "+
    "aber wissen!");
  AddDetail( ({ "architekt", "job", "richtige", "richtigen"}),
    "Tja, die Hobbits wollten ihre Stadt besonders schoen haben und da haben "+
    "sie in Raba genau den Richtigen gefunden.");
  AddDetail( ({ "raba", "raballion", "richtigen"}),
    "Raba war genau der Richtige fuer den Job des Architekten. Elfen koennen "+
    "so etwas halt gut.");
  AddDetail( ({ "wunder"}),
    "An Wunder kann man glauben, oder auch nicht.");
  AddDetail( ({ "wahl"}),
    "Was eine Wahl ist? Du kannst Fragen stellen!");
  AddDetail( ({"stadt", "hobbingen", "derlim"}),
    "Du befindest Dich unter anderem in der Stadt Derlim. Von anderen "
    "Rassen wird sie aber Hobbingen genannt.");
  AddDetail( ({ "hobbit", "hobbits"}),
    "Die befinden sich weiter unten.");

// Boden
  AddDetail( ({ "boden", "fussboden"}),
    "Der Fussboden ist unter Dir und verhindert ein Herunterfallen von Dir.");
  AddDetail( ({ "herunterfallen", "fall", "fallen", "hoch"}),
    "Du Hoch. Silberland weit unten. Dazwischen Fussboden. Du deshalb "+
    "nicht fallen. Du verstehen?");

// Decke
  AddDetail( ({ "decke"}),
    "Regen gibt es zwar nie in Silberland, aber man weiss nie...");
  AddDetail( ({ "silberland"}),
    "Tippe einfach das Wort \"hilfe\" und die kannst Dir dann die Fragen "+
    "selbst beantworten.");
  AddDetail( ({ "regen"}),
    "Tja, hier regnet es nicht rein.");

// Waende
  AddDetail( ({ "wand", "waende"}),
    "Dieses Haus hat vier Waende. Ein Fenster befindet sich in einer Wand. "
    "Eine Tuer befindet sich ein einer anderen Wand. Zwei Bilder sind "
    "ueber die restlichen Waende verteilt.");

// Tuer
  AddDetail( ({ "tuer"}),
    "Durch diese Tuer bist Du in dieses Haus rein gekommen. Durch diese "+
    "Tuer kannst Du es auch verlassen (raus).");

// Tisch
  AddDetail( ({ "tisch"}),
    "Ein einfacher Tisch auf dem sich zur Zeit nichts befindet. Raba "+
    "mag es schlicht.");
  AddDetail( ({ "zeit"}),
    "Tippe einfach \"uhrzeit\" und rufe \"Was? Schon so spaet!\" Dann weiss jeder "+
    "wo Du bist.");

// Stuehle
  AddDetail( ({ "stuhl", "stuehle"}),
    "Die Stuehle wissen genau wer eingeladen ist und wer nicht. Du kannst Dich folglich "+
    "nicht auf diesen bequemen Stuehlen ausruhen.");

// Schrank
  AddDetail( ({ "schrank", "kasten", "spalt", "krimskram", "kram"}),
    "Du machst vorsichtig eine Tuer vom Schrank einen Spalt auf und schaust hinein. "+
    "Allerlei Krimskram faellt Dir auf und Du machst sofort wieder zu.");

// Fenster
  AddDetail( ({ "fenster", "teil"}),
    "Du siehst einen kleinen Teil der Landschaft durch das Fenster und stellst fest: "+
    "das Fenster ist wie ein Bild in die Wand integriert.");
  AddDetail( ({ "landschaft", "aussicht" }),
    "Die Aussicht auf die Landschaft ist einfach wunderschoen und Du geniesst es ein "+
    "wenig.");

// Bilder
  AddDetail( ({ "bild", "bilder"}),
    "Auf dem ersten Bild ist der Elfenwald zu sehen, damit Raba ihn wenigstens sehen kann. "+
    "Das zweite Bild zeigt Rabas kleinen Sproessling beim Baden, wie er jauchzt vor "+
    "Vergnuegen.");
  AddDetail( ({ "elfenwald", "wald"}),
    "Tja, da sind die Elfen her.");
  AddDetail( ({ "sproessling"}),
    "Putzig schaut der Sproessling von Raba aus, wie er badet. Der Sproessling "+
    "badet gerade und nicht Raba.");
  AddDetail( ({ "baden"}),
    "Babys werden ab und an gebadet. Erwachsene sollten dies auch hin und wieder tun.");
  AddDetail( ({ "erwachsen", "erwachsene"}),
    "Bist Du nicht erwachsen?");
  AddDetail( ({ "vergnuegen"}),
    "Hattest Du kein Vergnuegen beim Baden als Du noch ein Baby warst?");
  AddDetail( ({ "baby", "babys", "babies"}),
    "Ok, da gibt es Bienen und Blumen und dann kommen Stoerche und ..."+
    "Fragen kannst Du stellen! Ich hoffe Du weisst jetzt mehr.");
  AddDetail( ({ "biene", "bienen", "blume", "blumen", "storch", "stoerche"}),
    "Versuche es mal mit dem Detail \"baby\".");

  AddDetail( ({ "frage", "fragen", "detail"}),
    "Du kannst Fragen stellen!");

  AddSound( ({ DEFAULT_SOUND }),
    "Hier oben im Baumhaus hoerst Du nur die Geraeusche des Windes.");
  AddSound( ({"wind", "geraeusch", "geraeusche"}),
    "Der Wind macht typische Geraeusche.");

  AddSmell( ({DEFAULT_SMELL, "geruch", "gerueche"}),
    "Es riecht hier typisch fuer einen Elfen. Zwerge riechen anders!");

  AddExit( "raus", "./baum2" );

 
}


