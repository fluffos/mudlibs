#include "../def.h"

inherit "std/room";

#include <mnpc.h>

int haselnuss, hagebutte;

void create()
{
  ::create();

  haselnuss = random(10)/9;
  hagebutte = random(10)/8;

  SetProp(P_INT_SHORT, "Noerdliches Tor von Derlim (Hobbingen)" );
  SetProp(P_INT_LONG,
    "Das Stadttor von Derlim (Hobbingen). Eigentlich ist es ja ein Loch in der "
    "Hecke, die ganz Derlim umgibt. Ein schweres Tor erkennst Du an der "
    "Innenseite und im Nordosten befindet sich eine Wachhuette. "
    "Nach Osten fuehrt die breite Hauptstrasse, waehrend nach Suedwesten nur "
    "eine kleine Seitenstrasse geht. Im Westen liegt ein schmucker Wohnhuegel. "
    "Nach Nordwesten kannst Du die Stadt wieder verlassen. "
    "Ein grosses Schild ist an der Hecke angebracht.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// standart details fuer die stadt
#include "details_stadt.h"

// standart details fuer aussen
#include "details_aussen.h"

// standart details fuer gruppen von raeumen
// suedweg
#include "details_wweg.h"

  AddDetail( ({"durchschlupf"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"wachhuette", "huette"}),
    "Die Wachhuette ist vollkommen in die Hecke hineingebaut und gaenzlich "
    "von ihr ueberwuchert. Von aussen ist sie nicht auszumachen. Hier "
    "halten sich wohl die Wachen auf, wenn sie nicht gerade im Dienst "
    "sind.");
  AddDetail( ({"wachen", "dienst"}),
    "Die Wachen leisten hier am Tor ihren Dienst ab.");
  AddDetail( ({"seitenstrasse", "westweg"}),
    "Die Seitenstrasse geht nach Suedwesten weg. Von Einheimischen wird "
    "sie auch Westweg genannt.");
  AddDetail( ({"pfad"}),
    "Ein schmaler Pfad fuehrt aussen an der Hecke Richtung Westen. Dort "
    "kannst Du einige Huegel erkennen. Leider ist dieser Weg derzeit nicht "
    "begehbar.");
  AddDetail( ({"huegel"}),
    "Im Westen siehst Du einen groesseren Huegel. Leider ist er zu weit "
    "entfernt, um etwas Genaues zu erkennen.");
 AddDetail( ({"genaues", "genaueres"}),
    "Du konzentrierst Dich, kannst aber noch immer nichts Genaueres "
    "erkennen. Du solltest wirklich naeher hin gehen.");
  AddDetail( ({"loch", "luecke", "eingang"}),
    "Das Loch ist eigentlich der Eingang in die Stadt. Da Derlim aber "
    "nur von einer dichten Hecke umgeben ist, gibt es kein gemauertes "
    "Stadttor sondern eben nur eine Luecke in der Hecke.");
  AddDetail( ({"tor", "stadttor"}),
    "Das Tor lehnt an der Innenseite der Hecke. Es besteht aus schweren "
    "Pfosten, die kunstvoll ineinandergefuegt sind. Du hast Glueck, dass "
    "es geoeffnet ist, sonst haettest Du sicher keine Moeglichkeit, in "
    "die Stadt zu kommen.");
  AddDetail( ({"pfosten"}),
    "Die Pfosten sind auf wunderbare Weise miteinander verbunden. Kein "
    "Spalt ist zwischen den einzelnen Pfosten. Obwohl man es ihnen immer "
    "wieder abspricht, scheinen Hobbits doch sehr geschickt zu sein.");
  AddDetail( ({"spalt"}),
    "KEIN Spalt!");
  AddDetail( ({"glueck"}),
    "Da Du heute welches hast, ist das Tor offen.");
  AddDetail( ({"moeglichkeit"}),
      "Ohne Tor gaebe es keine.");
/*  
  AddDetail( ({"moeglichkeit"}),
    "Diese besteht allerdings darin, dass hier irgendwer Automaten zum "
    "Untersuchen verwendet.");
  AddDetail( ({"untersuchen"}),
    "Das solltest Du immer nur haendisch tun.");
  AddDetail( ({"automaten", "automat"}),
    "Also Die rennen hoechstens bei Dir am Computer. Vorsicht!");
  AddDetail( ({"vorsicht"}),
    "Das ist eine Scriptfalle, wenn du weiter untersuchst kann das boese "
    "Folgen mit sich ziehen!");
  AddDetail( ({"computer", "folgen", "scriptfalle"}),
    "Also SOWAS siehst Du hier wirklich nicht. Ich glaub, Du bist ein "
    "Falschspieler.");
  AddDetail( ({"falschspieler"}),
    "Wenn Du so einer bist, dann untersuche doch bitte Deinen eigenen "
    "Selbstmord.");

  AddSpecialDetail( "selbstmord", "scriptfalle");
/// Sowas, Selbstmord -> Tod ?? (Scriptfalle)
*/
  AddDetail( ({"innenseite"}),
    "Die findest Du, wenn Du in die Stadt hineingehst.");
  AddDetail( ({"boden", "weg"}),
    "Der Boden hier ist mit grossen Steinplatten befestigt. Du merkst "
    "sofort, dass die Hobbits sich um ihre Strassen kuemmern.");
  AddDetail( ({"steinplatte", "steinplatten", "platte", "platten"}),
    "Die Platten scheinen aus dem nahegelegenen Gebirge zu stammen.");
  AddDetail( ({"gebirge"}),
    "Im Norden kannst Du schemenhaft ein riesiges Gebirge erkennen.");
  AddDetail( ({"himmel"}),
    "Durch die dichte Hecke, die sich wie ein Bogen ueber den "
    "Durchschlupf verbindet, kannst Du nur vereinzelt den blauen Himmel "
    "erkennen.");
  AddDetail( ({"bogen"}),
    "Die Hecke spannt einen grossen Bogen ueber die Strasse.");
  AddDetail( ({"strasse", "hauptstrasse", "strassen"}),
    "Die Hauptstrasse von Derlim scheint im Suedosten zu beginnen. Du "
    "musst schon hingehen, damit Du sie genauer sehen kannst.");
  AddDetail( ({"stadt", "hobbingen", "derlim"}),
    "Richtig erkannt. Die Stadt, die zu diesem Stadttor gehoert heisst "
    "Derlim. Sie wird aber von anderen Rassen oft Hobbingen genannt.");
  AddDetail( ({"hobbit", "hobbits", "einheimische"}),
    "In Derlim leben Hobbits. Welch wunderbare Fuegung des Schicksals.");
  AddDetail( ({"schicksal"}),
    "Es scheint Dir guenstig gestimmt zu sein, dass es Dich in diese "
    "wunderschoene Stadt geleitet hat.");
  AddDetail( ({"fuegung"}),
    "Fuegung? Wo denn?? Bist Du ein Automat??? (Bitte, Bitte. Lars ist eh "
    "unterbeschaeftigt)");
  AddDetail( ({"nase"}),
    "Du suchst eine Nase und findest genau ein Stueck mitten in Deinem "
    "Gesicht. So ein Glueck.");
  AddDetail( ({"stueck"}),
    "Was Du alles untersuchst...");
  AddDetail( ({"gesicht"}),
    "Also wenn Du Deine Nase dort gefunden hast, dann solltest Du doch "
    "eines haben, oder??");

  AddDetail( ({"schild"}),
    "Du kannst es lesen.");
  AddReadDetail( ({"schild"}),
    "--------------------------\n"
    "I                        I\n"
    "I      D E R L I M       I\n"
    "I                        I\n"
    "I Hauptstadt der Hobbits I\n"
    "I                        I\n"
    "I                        I\n"
    "I                        I\n"
    "I      (Hobbingen)       I\n"
    "I                        I\n"
    "--------------------------\n"
    );

  AddSound( ({ DEFAULT_SOUND }),
    "Du hoerst das aufgeregte Gezwitscher von vielen Voegeln. Ausserdem "
    "noch ein gemuetliches Murmeln, von dem Du aber nicht weisst, woher es "
    "kommt.");
  AddSound( ({"murmeln", "murmel", "gemurmel"}),
    "Du versuchst Dich zu konzentrieren und meinst, das Murmeln aus "
    "Nordosten zu hoeren.");

  AddCmd( ({"pfluecke", "pflueck"}), "pfluecken");
  AddCmd( ({"greif", "greife"}), "greifen");
  
  AddExit( "nordwesten", HOBBINGEN_WESTWEG );
  AddExit( "nordosten", "./wachraum" );
  AddExit( "osten", "./hauptstrasse1" );
  AddExit( "suedwesten", "./westweg1" );

  AddItem( NPC "taube", REFRESH_DESTRUCT);
  AddItem( NPC "buettel", REFRESH_DESTRUCT, ([P_NAME: "Re", 
       P_MNPC_AREA: ({ROOM "haupt", ROOM "nordtor", ROOM "wachraum", 
                     ROOM "west"}) ]) );
  AddItem( NPC "echse", REFRESH_DESTRUCT, ([P_NAME: "Disss", 
       P_MNPC_AREA: ({ROOM "haupt", ROOM "nordtor", ROOM "wachraum", 
                     ROOM "west"}) ]) );
}

int greifen(string str)
{
  notify_fail("Wohin willst Du greifen?\n");
  if( !str ) return 0;
  if( member( ({"dorn", "dornen", "in dorn", "in dornen"}), str) != -1 )
  {
    write("Du fasst in die Dornen und verletzt Dir Deine Finger.\n");
    say( CAP_TPN+ " greift in die Dornen.\n");
    TP->reduce_hit_point(2+random(4));
    return 1;
  }
  return 0;
}

int pfluecken(string str)
{
  notify_fail("Was willst Du pfluecken?\n");
  if( !str ) return 0;
  notify_fail("Sowas kannst Du nicht pfluecken.\n");
  if( str=="hagebutte" || str=="hagebutten")
  {
    if(hagebutte)
    {
      write("Zufaellig findest Du eine Hagebutte und pflueckst sie.\n");
      say(CAP_TPN+" pflueckt eine Hagebutte.\n");
      CLONE( OBJ "hagebutte", TP);
      hagebutte--;
    }
    else
      write("Leider kannst Du hier keine Hagebutte erreichen. Keine mehr da.\n");
    return 1;
  }
  if( str=="haselnuss" || str=="haselnuesse" )
  {
    if(haselnuss)
    {
      write("Zufaellig findest Du eine Haselnuss und pflueckst sie.\n");
      say(CAP_TPN+" pflueckt eine Haselnuss.\n");
      CLONE( HASELNUSS, TP);
      haselnuss--;
    }
    else
      write("Leider kannst Du hier keine Haselnuss erreichen. Keine mehr da.\n");
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();

  haselnuss = random(10)/9;
  hagebutte = random(10)/8;
}

string scriptfalle()
{
  write_file(LOG "scriptfalle",
    ctime()+": "+CAP(getuid(TP))+" loest Scriptfalle im Nordtor aus!\n");  
  return "Du wurdest als Scripter enttarnt und wirst die Folgen tragen muessen!\n";
}
