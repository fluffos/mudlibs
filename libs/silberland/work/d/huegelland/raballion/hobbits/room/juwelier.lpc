inherit "std/laden";

#include <laden.h>
#include "../def.h"

void create()
{
  ::create();
  	
  SetProp(P_INT_SHORT,"Im Juwelierladen");
  SetProp(P_INT_LONG,
    "Du befindest Dich im Juwelierladen von Sanidra Pelzfuss, der "
    "meisterlichen Juwelierin, die im ganzen SilberLand bekannt fuer ihre "
    "herrlichen Schmuckstuecke ist. Der Raum sieht eigentlich aus wie "
    "ein normaler Wohnhuegel der Hobbits, nur der viele Schmuck der sich in "
    "den grossen Vitrinen befindet, ist nicht typisch fuer eine "
    "Hobbitbehausung.");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetStorageRoom (ROOM "juwelenstore");
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetProp(P_SHOPKEEPER_ID, "sanidra");
  SetProp(P_SHOPKEEPER_NAME, "Sanidra Pelzfuss");
  SetProp(P_SHOPKEEPER_GENDER, FEMALE);
  RemoveFixedObject();
//  AddFixedObject("/p/std/skills/jewelry/obj/mithril", 250000);
  AddFixedObject("/p/std/skills/jewelry/obj/platin", 2500);
  AddFixedObject("/p/std/skills/jewelry/obj/gold", 1000);
//  AddFixedObject("/p/std/skills/jewelry/obj/weissgold", 1250);
//  AddFixedObject("/p/std/skills/jewelry/obj/rotgold", 750);
  AddFixedObject("/p/std/skills/jewelry/obj/silber", 500);
  AddFixedObject("/p/std/skills/jewelry/obj/kupfer", 250);
  SetBuyFact(4);
 
  AddDetail( ({"sanidra", "sanidra pelzfuss", "pelzfuss", "juwelierin"}),
      "Sanidra Pelzfuss ist gerade nicht da, aber sie kommt sicher gleich "
      "wieder.");
  AddDetail( ({"boden", "erdboden"}),
    "Ein ganz normaler Erdboden, wie er in einem Huegelhaus ueblich ist.");
  AddDetail( ({"wand", "waende"}),
    "An den Waenden siehst Du viele Vitrinen die mit wertvollem Schmuck "
    "gefuellt sind.");
  AddDetail( ({"decke"}),
    "Die Decke ist ueber Dir. Sie besteht aus schweren Eichenbalken.");
  AddDetail( ({"balken", "eichenbalken"}),
    "Schwere Balken aus Eiche.");
  AddDetail(({"laden", "raum", "laden", "huegelhaus", "haus", "wohnhuegel", 
        "huegel", "juwelierladen"}),
    "Du befindest Dich mittendrin.");
  AddDetail( ({"stadt", "hobbingen", "derlim"}),
    "Du befindest Dich in der Stadt Derlim. Von anderen Rassen wird sie aber "
    "Hobbingen genannt.");
  AddDetail( ({"rassen"}),
    "Es gibt Hobbits und Nicht-Hobbits.");
  AddDetail( ({"nicht-hobbits", "nichthobbits", "nicht"}),
    "Nicht-Hobbits sind zb Menschen, Zwerge, Elfen, Trolle, Oger, Feen, "
    "Dunkelelfen usw.");
  AddDetail( ({"menschen", "zwerge", "elfen", "trolle", "oger", "feen",
            "dunkelelfen"}),
    "Das sind Nicht-Hobbits, wie schon vorher erwaehnt.");
  AddDetail(({"holz","eichenholz", "eiche", "eichen"}),
    "Es ist ganz normales Eichenholz, wie es im Silberwald auch vorkommt.");
  AddDetail( ({"silberwald", "osten"}),
    "Der Silberwald liegt weit im Osten.");
  AddDetail( ({"welt", "silberland"}),
    "Diese Welt ist das SilberLand.");
  AddDetail( ({"hobbit", "hobbits"}),
    "Die Hobbits leben hier in Derlim.");
  AddDetail( ({"vitrinen", "vitrine", "glasvitrinen", "glasvitrine"}),
    "Die Vitrinen sind alle abgeschlossen und haben eine Glasfront. In diesen "
    "Vitrinen sind die wertvollen Schmuckstuecke aufbewahrt, die Sanidra "
    "Pelzfuss selber herstellt.");
  AddDetail( ({"glas", "glasfront"}),
    "Die Vitrinen haben alle eine Glasfront.");
  AddDetail( ({"hobbitbehausung"}),
    "Dieser Wohnhuegel schaut wie eine normale Hobbitbehausung aus, bis auf "
    "die Glasvitrinen, die mit Unmengen von Schmuck gefuellt sind.");
  AddDetail( ({"unmengen", "unmenge", "menge"}),
    "Unmenge ist noch mehr als Menge. Es sind also wirklich viele "
    "Schmuckstuecke.");
  AddDetail( ({"schmuck", "schmuckstuecke"}),
    "Die Schmuckstuecke von Sanidra Pelzfuss sind wirklich meisterlich "
    "gefertigt.");
  AddSound( ({DEFAULT_SOUND}), 
    "Du hoerst das Klimpern von Juwelen.");
  AddSound( ({"juwelen", "klimpern"}),
    "*klimper* *klimper*");
  AddSmell( ({DEFAULT_SMELL, "schmuck"}),
    "Es riecht nach Schmuck.");

  AddItem(NPC "juwelierin", REFRESH_DESTRUCT);

  AddExit( "westen", "./hauptstrasse5");
  SUID;
}

do_sell(object ob, int force, no_reg)
{
  if( (ob->QueryProp(P_AC)  &&
       member(({AT_RING, AT_AMULET}),ob->QueryProp(P_ARMOUR_TYPE)) != -1) ||
      ob->id("EDELSTEIN") || ob->id("PERLE"))
  {
    if (ob->id("EDELSTEIN") || ob->id("PERLE"))
      ob->SetProp(P_NOBUY, 0);
    return ::do_sell(ob, force);
  }
  write("Sanidra Pelzfuss sagt: Tut mir leid, Ich kaufe nur Schmuck.\n");
  return 1;
}

int QuerySellValue(object ob)
{
  int value;

  value = ::QuerySellValue(ob);
  if (ob->id("EDELSTEIN") || ob->id("PERLE"))
    value = value * 5 / 4;
  return value;
}
