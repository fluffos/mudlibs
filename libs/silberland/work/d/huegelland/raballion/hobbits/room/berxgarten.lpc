/// Der Garten von Berx

#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Berx' Garten " );
  SetProp(P_INT_LONG,
    "Du stehst mitten in einem grossen Garten. In der Mitte wird dieser von "
    "einem maechtigen Baum dominiert. Suedlich davon siehst du einige "
    "Beete, wogegen noerdlich vom Baum nur ein gepflegter Rasen ist. Im "
    "Osten kannst du die Stadtmauer erkennen, die fast vollstaendig von "
    "Weinranken verdeckt ist.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_NO_MNPC, 1);
    
  AddDetail( ({ "garten"}), QueryProp(P_INT_LONG) );
  AddDetail( ({ "baum" }),
    "Mitten im Garten steht ein maechtiger Baum. Du gehst ein paar Schritte "
    "auf ihn zu, um ihn genauer zu betrachten, kannst aber nicht erkennen, "
    "von welcher Art er ist. Doch ein beruhigendes Gefuehl ueberkommt Dich, "
    "als ob der Baum eine friedliche Aura haette. Einige seiner Aeste sind "
    "dicker als die Staemme normaler Baeume und seine Blaetter sind saftig "
    "gruen. Im Norden steht eine Reihe ganz normaler Obstbaeume.");
  AddDetail( ({"blatt", "blaetter"}),
    "Die Blaetter des grossen Baumes sind sattgruen und lustig buschig "
    "gefiedert. Auch anhand der Blaetter kannst du nicht erkennen, welcher "
    "Art der Baum ist. Die Obstbaeume haben genau die Blaetter, die Du bei "
    "ihnen erwartet hast.");
  AddDetail( ({"ast", "aeste"}),
    "Der riesige Baum hat auch solche Aeste. Verglichen mit den Obstbaeumen "
    "im Hintergrund ist einer der drei Hauptaeste sicher groeser als ein "
    "normaler Obstabaum. Dementsprechend riesig ist der ganze Baum. Du "
    "bewunderst die Kraft, mit der der Baum diese Last traegt.");
  AddDetail( ({"beet", "beete"}),
    "Die Beete im Sueden sind wunderschoen gepflegt. Du kannst sowohl "
    "Gemuesebeete als auch Blumenbeete erkennen.");
  AddDetail( ({"gemuesebeet", "gemuesebeete"}),
    "Alles nur erdenkliche Gemuese waechst auf diesen Beeten:Erbsen, "
    "Paradeiser, Karotten, Erdaepfel, Bohnen, Zwiebeln, Knoblauch und viele "
    "dir unbekannte Sorten."); 
  AddDetail( ({"blumenbeet", "blumenbeete"}),
    "Wunderbar gepflegete Blumenbeete. Berx duerfte sich sehr viel Muehe "
    "bei seinen Blumen geben. Sie sind zwar nicht mit den Zuechtungen der "
    "Elfen zu vergleichen, aber fuer einen naturverbundenen Hobbit sind "
    "diese zarten Pflaenzchen ausgezeichnet. Du kannst alle Arten von "
    "Blumen erkennen, die Du Dir nur denken kannst und auch Arten, die Du "
    "noch nie gesehen hast bluehen hier allerliebst.");
//zuechtungen
//pflaenzchen
//arten
//blumen
  AddDetail( ({"rasen"}),
    "Im Norden siehst du einen gepflegten Rasen, auf dem ein Tisch und "
    "einige gemuetliche Korbsessel stehen. Die Sitzgruppe ist so "
    "angeordnet, dass der Baum zwar die Mittagshitze abhaelt, die Strahlen "
    "der Morgen- und Abendsonne aber das lauschige Plaetzchen erwaermt. "
    "Dahinter steht eine Reihe kleinerer Obstbaeume.");
  AddDetail( ({"stadtmauer", "mauer"}),
    "Die maechtige Stadtmauer von Tijara ist ueber und ueber mit Wein "
    "bewachsen. An den wenigen Stellen, die Du durch den Wein erkennen "
    "kannst siehst Du, dass die Mauer aus glatt behauenen Steinen besteht, "
    "die ohne Moertel aufeinandergeschichtet sind. Sie duerften durch eine "
    "komplizierte Verzahnung und ihr grosses Gewicht halten. Ein wahres "
    "Wunder der Steinmetzkunst.");
//wunder
  AddDetail( ({"wein", "weinranke", "weinranken", "ranke", "ranken", 
               "weinstock"}),
    "Der Wein zieht sich ueber die ganze Stadtmauer. Du erkennst, dass es "
    "sich nicht um wilden Wein handelt, sondern es ist ein einziger "
    "kultivierter Weinstock. Er ist kunstvoll beschnitten und eine Menge "
    "Trauben haengen an ihm.");
  AddDetail( ({"obstbaum", "obstbaeume"}),
    "Am noerdlichen Rand des Gartens wachsen einige Obstbaeume. Du kannst "
    "einen Apfel- einen Birnen- einen Tswetschken- und einen Marillenbaum "
    "ekennen.");
  AddDetail( ({"boden"}),
    "Jaja, du stehst am Boden. Genauer gesagt auf einem Weg aus bunten "
    "Steinplatten.");
  AddDetail( ({"weg"}),
    "Der Weg fuehrt durch den ganzen Garten. Von den Beeten bis zu den "
    "Obstbaeumen und vom Haus bis zur Stadtmauer. Er besteht aus bunten "
    "Steinplatten.");
  AddDetail( ({"steinplatten", "platten"}),
    "Viele bunte Steinplatten unterschieldichster Arten. Es sieht fast so "
    "aus, alsob Berx sie von seien Reisen durch das Silberland "
    "zusammengetragen haette. Aber Steine als Souveniers? Eine Platte zu "
    "deinen Fuessen hat ein interessantes Muster.");
  AddDetail( ({"steinplatte", "platte"}),
    "Die Steinplatte zu deinen Fuessen hat ein Muster eingraviert.");
  AddDetail( ({"muster"}),
    "Du betrachtest das Muster genau und stellst erstaunt fest, dass es "
    "altzwergische Runen sind. Wie Berx wohl zu diesem Stein gekommen ist?");
  AddDetail( ({"sonne"}),
    "Die Sonne scheint warm vom Himmel. Vielleicht etwas zu warm sogar. Du "
    "solltest in den Schatten gehen, damit du keinen Sonnenstich bekommst.");
  AddDetail( ({"wolke", "wolken"}),
    "Am Himmel treiben lustige Wolken. Du legst dich in das weiche Gras, "
    "blickst in den Himmel und traeumst ein bisschen vor dich hin.");
  AddDetail( ({"himmel"}),
    "Am Himmel treiben lustig einige Wolken. Sonst ist er tief blau und die "
    "Sonne scheint warm und freundlich.");
  AddDetail( ({"gras"}),
    "Im ganzen Garten waechst gruenes saftiges Gras. Nicht nur der Rasen "
    "selbst, auch zwichen den Beeten und beim Weg ist das Gras geradezu "
    "perfekt geflegt und kurz geschnitten. Trotzdem ist es wunderbar weich "
    "und laedt zum hineinlegen ein.");
  AddDetail( ({"gefuehl"}),
    "In der Naehe des Baumes ueberkommt Dich ein wunderbar angenehmes "
    "Gefuehl, alsob der Baum eine wunderbar positive Aura ausstrahlen "
    "wuerde.");
  AddDetail( ({"aura"}),
    "Der Baum scheint eine so starke Aura zu haben, dass Du glaubst, ihn "
    "leuchten zu sehen.");
  AddDetail( ({"kraft", "energie"}),
    "Die Kraft des Baumes scheint riesig zu sein. Er kommt Dir eher wie ein "
    "schlafender Riese als wie ein Baum vor.");
  AddDetail( ({"erbsen"}),
    "Auf einem Beet wachsen Erbsen. Du siehst, dass sie gerade reif sind "
    "und Dir geradezu aus den Schoten entgegenspringen. ");
  AddDetail( ({"erbse"}),
    "Eine einsame Erbse liegt am Rand des Erbsenbeetes. Da scheint "
    "irgendwer ein paar Erbsen gegessen zu haben und diese eine duerfte ihm "
    "entwischt sein. ");
  AddDetail( ({"paradeiser"}),
    "Wunderschoene rote Paradeiser. Sie leuchten Dir wie kleine rote Lampen "
    "aus dem gruenen Pflanzenmeer entgegen. In fremden, weit entfernten "
    "Gebieten sollen sie ja auch \"Tomaten\" heissen, aber Du haeltst das nur "
    "fuer ein Geruecht. ");
  AddDetail( ({"karotte", "karotten"}),
    "Im Boden wachsen einige Karotten. Da Du Dir aber sicher bist, kein "
    "Hase zu sein, laesst Du sie lieber in Friden. ");
  AddDetail( ({"erdapfel", "erdaepfel"}),
    "Kleine Erdaepfelpflaenzchen wachsen auf den Beeten. Du kannst nicht "
    "erkennen, ob sie schon reif sind. ");
  AddDetail( ({"bohnen"}),
    "Bohnen an langen Bohnenstangen. Sie sind noch etwas gruen und "
    "ungeniessbar. Trotzdem scheinen sie bis in den Himmel zu wachsen. ");
  AddDetail( ({"zwiebel", "zwiebeln"}),
    "Zwischen den Karotten und den Erdaepfeln kannst Du einige Zwiebeln "
    "erkennen. Beim Gedanken, eine zu essen steigen Dir die Traenen in die "
    "Augen. ");
//traenen
  AddDetail( ({"knoblauch"}),
    "Ganz hinten findest Du ein kleines Knoblauchbeet. ");
  AddDetail( ({"muehe"}),
    "Du blickst dich im Garten um und meinst, dass So ein Garten sich "
    "sicher nicht von alleine pflegt und deshalb viel Liebe aber auch "
    "Arbeit braucht. ");
  AddDetail( ({"rasse", "rassen"}),
    "Im Silberland gibt es 4 verschiedene Rassen: Hobits, Zwerge, Menschen "
    "und Elfen. Berx versucht mit allen gut auszukommen. Die einzige Art, "
    "die er ueberhaupt nicht leiden kann sind Rassisten. ");
//art- zu rasse, rassen? 
  AddDetail( ({"rassist", "rassisten"}),
    "Sojemanden mag Berx ueberhaupt nicht. Wenn Du einer bist dann verlasse "
    "bitte diesen Garten und verunstalte ihn nicht laenger. ");
  AddDetail( ({"tisch"}),
    "Der Tisch steht in der Mitte der Sitzgruppe im Schatten des grossen "
    "Baumes. Er ist wie der Korbsessel aus Rohr geflochten und wunderbar "
    "gewirkt. ");
  AddDetail( ({"sessel", "sesseln", "korbsessel", "korbsesseln"}),
    "Bequeme Korbsessel. Gerade richtig, um es sich gemuetlich zu machen. "
    "Berx empfaengt hier sicher oft Gaeste. ");
  AddDetail( ({"sitzgruppe"}),
    "Die Sitzgruppe besteht aus einem Tisch und einigen Korbsesseln. Sie "
    "steht im Schatten des grossen Baumes, der die Mittagshitze abhaelt. ");
  AddDetail( ({"verzahnung"}),
    "Die Mauersteine sind mit einer Kunstvollen Verzahnung "
    "zusammengehalten, die jedem Zwerg zur Ehre reichen wuerde. Trotzdem "
    "duerfte es sich um ein Machwerk der ansaessigen Hobbits handeln, die "
    "auch sehr gute Handwerker sind. ");
  AddDetail( ({"gewicht"}),
    "Die Steinbloecke scheinen unermessliches Gewicht zu haben. Wie diese "
    "Bloecke aufeinendergehievt wurden, ist Dir schleierhaft. Du enkst "
    "unwillkuerlich an Zauberei. ");
//zauberei
//blöcke
  AddDetail( ({"steinmetzkunst"}),
    "Diese Kunst scheint hier sehr ausgepraegt zu sein. Ob die "
    "Hobbithandwerker wohl einmal bei einem Zwergenmeister in die Lehre "
    "gegangen sind? ");
  AddDetail( ({"kunst", "kuenste"}),
    "Viele kunstfertige Handwerker leben in Tijara. Die stadt ist "
    "schliesslich beruehmt dafuer. ");
  AddDetail( ({"wunder"}),
    "Einen solchen Garten hast Du nch nie gesehen. Wenn Du nicht wuestest, "
    "dass er existiert, wuerdest du ihn fuer ein Wunder aus halten "
    "Erzaehlungen halten. ");
  AddDetail( ({"traube", "trauben"}),
    "Wunderbar suesse Trauben haengen an dem Weinstock. Sie werden sicher "
    "einen ausgezeichneten Wein ergeben. ");
/*  AddDetail( ({"apfel", "aepfel"}),
    "
; Apfel, Birnen Tschwetschken, Marillen, -Baeume, Reisen, Fuesse, Runen, 

; [Obstsorten], [Blumen]
*/

  AddSound( ({ DEFAULT_SOUND }),
    "Du lauscht und hoerst einige Voegel zwitschern. Die Blaetter rascheln "
    "leise und um die Blumen fliegen summend einige fleissiege Bienen.");
  AddSound( ({"vogel", "voegel"}),
    "Die Voegel scheinen sich im Baum versammelt zu haben, um Dir ein "
    "Staendchen zu bringen. Auf jeden Fall singen sie gerade jetzt "
    "besonders lieblich.");
  AddSound( ({"wind", "rauschen", "blaetter"}),
    "Es scheint, als wuerde der Wind geradezu mit den Blaettern spielen. "
    "Oder versuchen Wind und Baum gemeinsam zu musizieren? Auf jeden Fall "
    "untermalt das Rauschen auf wunderbare Weise den Gesang der Voegel.");
//gesang
  AddSound( ({"biene", "bienen", "summen"}),
    "Ein monotones Summ-Brumm dringt von den Blumen an Dein Ohr. Die Bienen "
    "lassen sich von Deiner Anwesenheit nicht stoeren und fliegen weiter "
    "ihrer geschaeftigen Arbeit nach.");
//blumen
//ohr
//anwesenheit
//arbeit


  AddSmell( ({DEFAULT_SMELL, "duft", "luft", "geruch", "gerueche"}),
    "Viele verschiedene Gerueche dringen auf Dich ein. Ganze Duftwolken von "
    "den Blumenbeeten, aber auch einige Obstbaeume duften und sogar das "
    "Gras und der Baum scheinen einen angenehmen Duft zu verstroemen.");
  AddSmell( ({"duftwolke", "duftwolken"}),
    "Du riechst eine Mischung aus verschiedesten Blumendueften. Du "
    "koenntest versuchen, herauszufinden, ob du einige Blumen am Geruch "
    "erkennst.");
  AddSmell( ({"obstbaeume", "obstbaum", "obst"}),
    "Das Obst duftet verfuehrerisch. Berx hat sicher nichts dagegen, wenn "
    "Du Dir etwas pflueckst.");
  AddSmell( ({"baum"}),
    "Ein lieblicher Duft umschwebt Deine Nase. Du fuehlst Dich auf einmal "
    "wunderbar gelaunt und ueberglueckich, dass Du diesen Garten gefunden "
    "hast.");
  AddSmell( ({"gras"}),
    "Das Gras riecht frisch geschnitten - und sieht auch danach aus.");

  AddCmd( ({"leg", "lege"}), "legen");
  AddCmd( ({"pfeif", "pfeife"}), "pfeifen");

// erbsen/paradeise pfluecken, nach erdaepfeln graben, hinsetzen/aufstehen, obst pfluecken, runen lesen ;-), 


  AddExit( "zurueck", "./berx");
}


/// Niederlegen...
int legen(string str)
{
  notify_fail("Wie willst Du Dich legen?\n");
  if(!str) return 0;
  if( member( ({"nieder", "ins gras"}), str)!=-1)
  {
    write("Du legst Dich ins Gras, schaust in den Himmel und baumelst mit "
          "der Seele.\n");
    say(CAP(TPN)+ " legt sich ins Gras und blickt vertraeumt in den "
                  "Himmel.\n");
    return 1;
  }
  return 0;
}

int pfeifen(string str)
{
  notify_fail("Du versuchst zu pfeifen, bringst aber nur ein "
              "undefinierbares sssschzzzszszschssz heraus.\n");
 
  if( member( ({"lied", "mit voegeln", "mit vogel", 
                "alle voegel sind schon da", "alle vogerl sind schon da", 
                "kommt ein vogel geflogen", "kommt ein vogerl geflogen"}),
               str)!=-1)
  {
    write("Berx teilt Dir mit: Dieser Garten ist zwar mit viel Liebe "
          "gemacht, aber Zaubertraenke musst du schon woanders suchen.\n");
/// ODER
    write("Du pfeifst froehlich, aber nichts passiert. Probier es doch "
          "einmal woanders.\n");
/// ODER 
    write("Laut oberstem Beschluss der Goetter werden in Seherwohnungen "
          "und -gaerten weder Zaubertraenke noch Forscherpunkte versteckt. "
          "Sorry. Wen du auf sowas aus bist, dann musst du woanders "
          "suchen.\n");
    say(CAP(TPN)+ " pfeift froehlich vor sich hin.\n");
    return 1;
  }
  return 0;
}
