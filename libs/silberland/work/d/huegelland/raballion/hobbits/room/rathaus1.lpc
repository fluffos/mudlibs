//             den raum gemacht 

#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>


void create()
{
  ::create();
  	
  SetProp(P_INT_SHORT,"Rathaus in Derlim");
  SetProp(P_INT_LONG,
    "Dies ist das Rathaus der Hobbits und von hier aus wird Derlim verwaltet. "
    "Mit den Mitgliedern der Stadtverwaltung kannst Du sicher "
    "ueber Belange der Stadt bzw. der Hobbits reden. Du befindest Dich "
    "hier in der Vorhalle und obwohl sie sich in einem Huegel befindet, "
    "ist es angenehm hell hier drin. Massive Saeulen tragen die hohe Decke "
    "und Platten haengen an den Waenden.");


  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"rat", "stadtrat",
          "stadtverwaltung", "verwaltung",
          "mitglied", "mitglieder"}),
    "Die Stadtverwaltung von Derlim ist dazu da, um fuer das Allgemeinwohl aller "
    "Einwohner und Besucher von Derlim zu sorgen. Sie kuemmern sich auch um alle "
    "jene, die neu in die Stadt kommen und sich ueberhaupt nicht auskennen. Wenn "
    "einer von ihnen da ist, frag sie einfach und sie werden Dir sicherlich helfen wo "
    "sie nur koennen. Die Mitglieder sind derzeit: Raballion, Teqlablu und Nemesis.");


  AddDetail( ({"wand", "waende"}),
    "Die grossen Waende sind mit weissem Marmor belegt, der aus einem nahen "
    "Steinbruch stammt. An verschiedenen Stellen in den Waenden sind bronzene "
    "Platten eingelassen.");

  AddDetail( ({"saeule", "saeulen"}),
    "Die stuetzenden Saeulen sind ebenfalls aus weissem Marmor und reich verziert.");

  AddDetail( ({"decke"}),
    "An der hohen Decke sind verschiedene Gemaelde angebracht. Du fragst Dich, "
    "wie sie dorthin gemalt wurden und bruetest kurz ueber komplizierte Gerueste "
    "und andere Bauhilfsmittel. Dann wendest Dich anderen Dingen zu.");

  AddDetail( ({"boden"}),
    "Der glatte Boden besteht aus weissen und roten Marmorfliesen und stellt "
    "offenbar ein komplexes und grosses Labyrinth dar. Wo Du allerdings "
    "so einen verwirrenden Irrgarten schon mal gesehen bzw. erlebt hast "
    "faellt Dir nicht mehr ein.");

  AddDetail( ({ "rathaus", "vorhalle", "halle"}),
    QueryProp(P_INT_LONG) );

  AddDetail( ({"hobbit", "hobbits"}),
    "Die Hobbits leben hier in Derlim.");

  AddDetail( ({"derlim", "stadt"}),
    "Derlim sagen die Hobbits zu ihrer Stadt.");

  AddDetail( ({"belang", "belange", "wichtigkeit", "bedeutung"}),
    "Belang der, -(e)s/-e: von B., ohne B. (Wichtigkeit, Bedeutung) sein... "
    "sagt mein Woerterbuch.");

  AddDetail( ({"huegel"}),
    "Du befindest Dich in einem der Huegel von Derlim.");

  AddDetail( ({"allgemeinwohl"}),
    "Betrifft wohl jeden.");

  AddDetail( ({"einwohner"}),
    "Die Hobbits sind die Einwohner von Derlim.");

  AddDetail( ({"besucher"}),
    "Besucher sind keine Einwohner von Derlim.");

  AddDetail( ({"marmor", "marmorfliese", "marmorfliesen", "fliesen"}),
    "Der Marmor der Waende ist lupenrein und weiss. Der Marmor vom Boden "
    "ist ebenfalls lupenrein in Rot und Weiss. Er stammt wohl aus einem "
    "nahen Steinbruch.");

  AddDetail( ({"weiss", "rot", "farbe", "farben"}),
    "Dir gefallen die Farben vom Marmor.");

  AddDetail( ({"steinbruch"}),
    "Der Steinbruch befindet sich in der Naehe von Derlim.");

  AddDetail( ({"stelle", "stellen"}),
    "An verschiedenen Stellen in den Waenden sind bronzene Platten eingelassen.");

  AddDetail( ({"platte", "platten"}),
    "Es gibt insgesammt drei Platten in den Waenden. Du kannst mit \"lies platte 1\", "
    "\"lies platte 2\", \"lies platte 3\" die Platten lesen.");

  AddReadDetail( ({"platte"}),
    "Welche Platte willst Du lesen?");

  AddReadDetail( ({"platte 1"}),
    "----------------------------------------\n"
    "I         Ahnentafel Derlim             I\n"
    "I Stadtratsmitglieder bisher:           I\n"
    "I                                       I\n"
    "I Raballion (Gruendung)  -              I\n"
    "I Slayven   (01.12.97)   - (03.10.2003) I\n"
    "I Sheila    (01.12.97)   - (02.10.2003) I\n"
    "I Nemesis   (02.10.2003) -              I\n"
    "I Teqlablu  (03.10.2003) -              I\n"
    "I                                       I\n"
    "-----------------------------------------\n"
    );

  AddReadDetail( ({"platte 2"}),
    "---------------------------------------\n"
    "I        Grundsaetze der Hobbits       I\n"
    "I                                      I\n"
    "I 1) sei voller Lebensfreude           I\n"
    "I 2) sei immer Genusssuechtig          I\n"
    "I 3) achte auf ausreichendes Essen     I\n"
    "I 3) achte auf ausreichendes Trinken   I\n"
    "I 4) sei nicht feige                   I\n"
    "I 5) sei nicht dumm                    I\n"
    "I 6) schicke immer erst Fremde in      I\n"
    "I    unbekannte Hoehlen                I\n"
    "I 7) helfe anderen Hobbits in Not      I\n"
    "I 8) habe immer genug Freunde          I\n"
    "I 9) streichle niemals brennende Hunde I\n"
    "I10) finde Deine eigene Reihenfolge    I\n"
    "I    dieser Grundsaetze                I\n"
    "I                                      I\n"
    "I Stadtrat Raballion                   I\n"
    "----------------------------------------\n"
    );

  AddReadDetail( ({"platte 3"}),
    "-----------------------------------------\n"
    "I        Grundriss von Derlim           I\n"
    "I                                       I\n"
    "I                            Wachr.     I\n"                        
    "I                           /           I\n"
    "I                      Tor-----o        I\n"
    "I                   /              \\    I\n"
    "I                o     Post   Verw.   o I\n"
    "I             /  |      |      |   /    I\n"
    "I         o    Kneipe   o------o        I\n"
    "I      /  |          /  |   \\      \\    I\n"
    "I Tor     Alch   o     Kap.    Laden  o I\n"
    "I       \\     /                    /    I\n"
    "I          o------o             o       I\n"
    "I          |                 /          I\n"
    "I          o------o------o              I\n"
    "I                            \\          I\n"
    "I                              Tor      I\n"
    "I                                       I\n"
    "-----------------------------------------\n"
    );

  AddDetail( ({"verzierung", "verzierungen"}),
    "Die huebschen Verzierungen auf den grossen Saeulen sind reichlich vorhanden.");

  AddDetail( ({"gemaelde", "gemaelden"}),
    "Die verschiedenen Gemaelde stellen alle lustige Szenen aus dem taeglichen "
    "Hobbitleben dar. Angefangen von heftigen Gelagen bis zu blutigen Kampfszenen "
    "Hobbit an Hobbit gegen irgendwelche heftigen Monster. Lustig nicht?");

  AddDetail( ({"geruest", "gerueste", "bauhilfsmittel"}),
    "Damit konnte man diese schoene Vorhalle bauen und die Gemaelde anbringen.");

  AddDetail( ({"labyrinth", "irrgarten"}),
    "Du warst schon mal dort, aber sicher bist Du dir nicht.");

// hier

  AddDetail( ({"gelage", "gelagen"}),
    "Hast Du sicher schon mal gemacht. Kannst Dich sicher nicht mehr erinnern.");

  AddDetail( ({"hobbitleben"}),
    "Wenn Du ein ordentlicher Hobbit bist, kennst Du es ja. Wenn nicht, suche "
    "Dir einen und frage ihn danach.");

  AddDetail( ({"kampfszenen"}),
    "Blutig, blutig sind sie. Aber irgendwie scheinen die Hobbits dabei zu laecheln.");

  AddDetail( ({"szene", "szenen"}),
    "Daraus bestehen die schoenen Gemaelde an der hohen Decke.");

  AddDetail( ({"monster"}),
    "Gehe hinaus aus Derlim und suche sie.");

//  AddDetail( ({""}),
//    "");

  AddDetail( ({"woerterbuch", "naehe", "ding", "dinge", "dingen", "naehe"}),
    "Fragen kannst Du stellen!");

  AddItem( OBJ "urne2");

  AddItem("/gilden/bardengilde/obj/ehrenstatue", REFRESH_DESTRUCT, (["hero": "flammara"]));

  AddExit( "suedwesten", "./hauptplatz");
  AddExit( "nordosten", "./rathaus4");
  AddExit( "nordwesten", "./rathaus2");
  AddExit( "norden", "./rathaus3");

}
