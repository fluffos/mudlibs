// in Derlim (Hobbingen)
// 1997-04-24  Feyaria@SilberLand
// 1997-09-10  raballion@
//             den raum zu einem raum gemacht



#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Hauptstrasse in Derlim (Hobbingen)" );
  SetProp( P_INT_LONG, BS(
    "Dies ist die noerdliche Hauptstrasse in Derlim (Hobbingen). "
    "Von Westen nach Suedosten geht ihr Lauf. "
    "Sie verbindet das Nordtor mit dem Hauptplatz und stellt somit eine "
    "Hauptverbindung vom gesellschaftlichen Zentrum von Derlim mit dem \"Draussen\" dar. "
    "Im Sueden siehst Du einen grossen Huegel, zu dem Du aber von hier aus nicht hinkommst."
     ));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// standart details fuer die stadt
#include "details_stadt.h"

// standart details fuer aussen
#include "details_aussen.h"

// standart details fuer gruppen von raeumen
// hauptstrasse
#include "details_hauptstr.h"

  AddDetail( ({ "nordtor","tor" }),
    "Geh doch naeher ran um etwas genaueres zu sehen. Es liegt im Westen.");

  AddDetail( ({ "hauptplatz","platz","zentrum" }),
    "Geh in Richtung Suedosten und Du wirst schlauer.");

  AddDetail( ({ "draussen" }),
    "Ja, wie sage ich es denn.... dort warten viele Abenteuer auf DICH!");
  AddDetail( ({ "abenteuer" }),
    "Das ist allerdings das Witzige daran: gehe hin und finde es heraus.");
  AddDetail( ({ "witzige","humor" }),
    "Wenn Du das hier liest, dann hast Du ihn bestimmt. Dann kannst du auch nach \"Draussen\" "
    "gehen.");

  AddRoomMessage ( ({
    "Ein lustiger Teddybaer huepft vorbei und eilt dann weiter.\n",
    "Aus der Entfernung hoerst Du ein froehliches Lachen.\n",
    "Kinder rennen ausgelassen schreiend die Strasse herunter.\n",
    "Du ueberlegst, ob es nicht klasse waere, weiter zu gehen?\n" }), 45 );
  AddDetail( ({ "teddybaer", "teddybaeren" }),
    "Du musst Dich wohl geirrt haben. Teddybaeren hier in SL... tststs.");
  AddDetail( ({ "entfernung" }),
    "Mmmh. Weiter weg wuerde ich sagen...");
  AddDetail( ({ "lachen" }),
    "Froehliche Hobbits lachen ab und an, oder nicht?");
  AddDetail( ({ "kinder" }),
    "Schon um die naechste Ecke weg..");
  AddDetail( ({ "ecke", "ecken" }),
    "Ja, Ecken gibt es auf dieser Strasse auch.");
  AddSpecialDetail( ({"abenteuer"}), "quests");

  AddSmell (DEFAULT_SMELL, "Von ueberall her scheint ein leichter Geruch von Essen zu kommen.\n");
  AddSmell (({"geruch", "essen"}),
    ([ 0:      "Es riecht nach Essen.\n",
     "elf":    "Mmmh. Als Elf sagt Dir der Geruch: Die Kneipe liegt in suedwestlicher Richtung.\n",
     "hobbit": "Du denkst, wie Deine Artgenossen, nur an das Essen.\n",
     "zwerg":  "Also nach Wertmetall riecht es nicht.\n",
     "mensch": "Riecht zwar fremd, aber lecker.\n",
     "magier": "Schnueffelnase. Steckst sie auch ueberall rein. Gib zu Du hast den Code gelesen.\n"

    ]) );

  AddExit( "westen", "./nordtor" );
  AddExit( "suedosten", "./hauptstrasse2" );
  AddItem( NPC "hobbit", REFRESH_DESTRUCT);
}

string quests()
{
  return "Es gibt zur Zeit "+sizeof("/secure/questmaster"->QueryAllKeys())+
         " Abenteuer im SilberLand.\n";
}

