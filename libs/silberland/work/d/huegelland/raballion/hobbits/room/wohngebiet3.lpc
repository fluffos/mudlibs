#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Wohngebiet von Derlim" );
  SetProp(P_INT_LONG,
    "Hier im Wohngebiet ist es eigentlich ganz ruhig und beschaulich. Ueberall kann man die "+
    "grasbewachsenen Huegel mit teilweise sehr schoenen Vorgaerten der Einwohner sehen. "+
    "Falls Du die Bedingungen erfuellst, kannst Du Dich bei der Stadtverwaltung "+
    "nach einem Ort fuer Deinen Huegel erkundigen: "+
    "Die Adresse von hier ist uebrigens \"Wohnweg 3\". "+
    "Im Westen befindet sich ein ziemlich heruntergekommenes Haus.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// standart details fuer die stadt
#include "details_stadt.h"

// standart details fuer aussen
#include "details_aussen.h"

// standart details fuer gruppen von raeumen
#include "details_wohngeb.h"


    
  AddDetail( ({"haus"}),
    "Im Westen befindet sich ein ziemlich heruntergekommenes Haus. Auf der "
    "windschiefen Tuer ist ein Zettel angeschlagen.");
  AddDetail( ({"tuer"}),
    "Die Tuer ist windschief und ziemlich heruntergekommen. Ein Zettel ist an "
    "ihr angeschlagen.");  
  AddDetail( ({"zettel"}),
    "Der Zettel ist an der Tuer angeschlagen. Du kannst ihn lesen.");  
  AddReadDetail( ({"zettel"}),
    "Baufaelliges Haus! Betreten auf eigene Gefahr!");  


  AddItem( NPC "hobbit", REFRESH_DESTRUCT);

  AddExit( "norden", "./wohngebiet2");
  AddExit( "osten", "./wohngebiet4");
//  AddExit( "westen", "./wohngebiet5");

  AddCmd( ({"betrete", "betret", "betritt"}), "betreten");
}

int betreten (string str)
{
  notify_fail("Was willst Du betreten?\n");
  if( !str || str!="haus") 
    return 0;
  if(TP->QueryProp(P_LEVEL)<35 )
    return write("Du fuehlst Dich nicht mutig genug, das baufaellige Haus "
        "zu betreten.\n"),1;
  write(BS("Dir wird zwar ganz mulmig im Bauch, aber trotzdem betrittst Du "
        "das baufaellige Haus."));
  TP->move( ROOM "polterhaus", M_GO, "mutig das Haus", "betritt", "kommt herein");
  return 1;
}
