// /d/huegelland/raballion/hobbits/room/drachenhoehle.c
// Hoehle des Bronzedrachen in Hobbingen
// 1999-01-24  Feyaria@SilberLand

#include "../def.h"

inherit "std/room";

int schatz;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Drachenhoehle unter Derlim" );
  SetProp(P_INT_LONG,
    "Du stehst in einer gewaltigen Hoehle. An der Decke befindet sich ein "
    "grosses Loch, durch das Licht in die Hoehle scheint. Im Westen "
    "befindet sich ein kleiner Durchgang. Der Boden ist mit Gold und "
    "Edelsteinen uebersaet. Es muss sich also um eine Drachenhoehle "
    "handeln.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"hoehle"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"decke"}),
    "An der Decke befindet sich ein grosses Loch, durch das Licht in die "
    "Hoehle scheint.");
  AddDetail( ({"loch"}),
    "Durch das Loch an der Decke scheint Licht in die Hoehle. Es ist "
    "gross genug, dass der Drache durch dieses Loch hinausfliegen kann.");
  AddDetail( ({"licht"}),
    "Licht scheint durch das Loch an der Decke und erhellt die ganze "
    "Hoehle.");
  AddDetail( ({"himmel"}),
    "Durch das Loch in der Decke kannst Du ein winziges Stueck Himmel sehen.");  
  AddDetail( ({"westen", "durchgang"}),
    "Im Westen befindet sich ein kleiner Durchgang, durch den man die "
    "Hoehle verlassen kann.");
  AddDetail( ({"boden"}),
    "Der Boden ist mit Edelsteinen und Gold ueberseht. Der Drache hat hier "
    "wirklich einen gewaltigen Schatz aufgetuermt.");
  AddSpecialDetail( ({"schatz", "edelsteine", "gold"}), "schatz");
  AddDetail( ({"drachenhoehle", "drache"}),
    "Alles deutet darauf hin, dass es sich hier um eine Drachenhoehle "
    "handelt.");
  AddDetail( ({"wand", "waende", "stein"}),
    "Die Waende sind aus hartem Stein.");  
 
  AddSmell( ({DEFAULT_SMELL, "drache"}), 
      "Es riecht hier sehr stark nach Drache.");

  AddCmd( ({"pluender", "pluendere"}), "pluendern"); 
  AddExit( "westen", "./echsenraum" );
  
  AddItem( NPC "bronzedrache", REFRESH_DESTRUCT );
  schatz=1;
}

void reset()
{
  ::reset();
  schatz=1;
}

string schatz()
{
  if( present("drache") )
    return BS("Der Schatz des Drachen besteht aus Gold und Edelsteinen. "
        "Anfassen solltest Du aber nichts davon, denn das wuerde Dir der "
        "Drache sicher uebelnehmen.");
  else if( schatz )
    return BS("Der Schatz des Drachen besteht aus Gold und Edelsteinen. "
        "Da der Drache nicht da ist, koenntest Du ihn ja pluendern.");
  else
    return BS("Der Schatz wurde schon gepluendert.");
}

int pluendern(string str)
{
  object ob;
  notify_fail("Was willst Du pluendern?\n");
  if( !str ) return 0;
  if( str=="schatz" || str=="drachenschatz" ) {
    if( present("drache") ) 
      return notify_fail("Die Anwesenheit des Drachen hindert Dich am "
          "Pluendern des Schatzes.\n"),0;
    if( !schatz )
      return notify_fail("Der Schatz wurde schon gepluendert!\n"),0;
    write(BS("Du pluenderst den Schatz des Drachen und findest jeder Menge "
        "Gold und Edelsteine."));
    say(BS(CAP_TPN+" pluendert den Schatz des Drachen und findet jede Menge "
        "Gold und Edelsteine."));
    "/obj/gemmaster"->DistributeGem(10,10,1,TO);
     ob=clone_object("/obj/money");
     ob->AddAmount(1000+random(5000) );
     ob->move(TO, M_NOCHECK);
    schatz=0;
    return 1;
  }
  else
    return 0;
}

    

