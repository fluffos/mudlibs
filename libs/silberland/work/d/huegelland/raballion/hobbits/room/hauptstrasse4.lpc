// /d/huegelland/raballion/hobbits/room/hauptstrasse4.c
// Hauptstrasse in Derlim (Hobbingen)
// 1997-04-24  Feyaria@SilberLand
// 1997-09-10  raballion@
//             den raum zu einem raum gemacht


#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Hauptstrasse in Derlim" );
  SetProp( P_INT_LONG, BS(
    "Dies ist die suedliche Hauptstrasse in Derlim (Hobbingen). "
    "Von Suedwesten nach Nordosten geht ihr Lauf. "
    "Sie verbindet den Hauptplatz mit dem suedlichen Bereich von Derlim und stellt somit eine "
    "Hauptverbindung vom gesellschaftlichen Zentrum von hier mit dem Wohnbereich dar. "
    "Im Osten siehst Du einen grossen Huegel, zu dem Du aber von hier aus nicht hinkommst. "
    "Im Norden siehst Du ein Haus, zu dem Du aber von hier aus nicht hinkommst."
    ) );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// standart details fuer die stadt
#include "details_stadt.h"

// standart details fuer aussen
#include "details_aussen.h"

// standart details fuer gruppen von raeumen
// hauptstrasse
#include "details_hauptstr.h"

 
  AddDetail( ({ "hauptplatz","platz","zentrum", "stadtkern" }),
    "Geh in Richtung Nordosten und Du wirst schlauer.");

  AddDetail( ({"bereich", "suedlicher bereich"}),
    "Dort ist der Wohnbereich der Bewohner, oder sollen sie ohne Huegel uebernachten?");
  AddDetail( ({"wohnbereich"}),
    "Hobbits wohnen in Huegeln. Wo sonst?\n"
    "Geh doch naeher ran, dann siehst Du mehr. Er liegt im Suedwesten.");
  AddDetail( ({"haus", "neubau"}),
    "Das Haus sieht wirklich stattlich aus. Obwohl es ein Neubau ist und "
    "deshalb nicht ganz in die Huegellandschaft des alten Stadtkerns von "
    "Derlim passt, findest Du es doch irgendwie gut eingegliedert.");



  AddSmell (DEFAULT_SMELL, "Von ueberall her scheint ein leichter Geruch von Essen zu kommen.\n");
  AddSmell (({"geruch", "essen"}),
    ([ 0:      "Es riecht nach Essen.\n",
     "elf":    "Mmmh. Als Elf sagt Dir der Geruch: Die Kneipe liegt in noerdlicher Richtung.\n",
     "hobbit": "Du denkst, wie Deine Artgenossen, nur an das Essen.\n",
     "zwerg":  "Also nach Wertmetall riecht es nicht.\n",
     "mensch": "Riecht zwar fremd, aber lecker.\n",
     "magier": "Schnueffelnase. Steckst sie auch ueberall rein. Gib zu Du hast den Code gelesen.\n"

    ]) );

  AddExit( "nordosten", "./hauptplatz" );
  AddExit( "suedwesten", "./hauptstrasse5" );

  AddItem( NPC "buettel", REFRESH_DESTRUCT, ([P_NAME: "Si",
       P_MNPC_AREA: ({ROOM"haupt", ROOM"nordtor", ROOM"wachraum", ROOM "sued"}),
       P_MNPC_DEFAULTROOM: ROOM"hauptstrasse4" ]) );
  AddItem( NPC "echse", REFRESH_DESTRUCT, ([P_NAME: "Hisss",
       P_MNPC_AREA: ({ROOM"haupt", ROOM"nordtor", ROOM"wachraum", ROOM "sued"}),
       P_MNPC_DEFAULTROOM: ROOM"hauptstrasse4" ]) );

}

