// /d/huegelland/raballion/hobbits/room/echsenraum.c
// Schlafraum der Kampfechsen in Hobbingen
// 1999-01-24  Feyaria@SilberLand

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Schlafraum der Kampfechsen" );
  SetProp(P_INT_LONG,
    "Du befindest Dich in einer Hoehle unter dem Wachraum von Derlim. "
    "Hier haben es sich die Kampfechsen gemuetlich gemacht. Am Boden "
    "liegen einige Strohlager, auf dem die Echsen wohl schlafen. "
    "Die Waende bestehen aus grob behauenem Stein. Eine Leiter fuehrt "
    "zu einer Falltuer hinauf. Das einzige Licht kommt aus einer Oeffnung "
    "im Osten. Es riecht sehr streng nach echsischen Ausduenstungen. ");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"hoehle", "raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"wachraum"}),
    "Der Wachraum befindet sich ueber Dir.");
  AddDetail( ({"derlim", "hobbingen"}),
    "Du bist in Derlim, auch Hobbingen genannt.");
  AddDetail( ({"echsen", "kampfechsen", "schlafraum"}),
    "Diese Hoehle sieht wie der Schlafraum der Kampfechsen aus.");
  AddDetail( ({"boden"}),
    "Am Boden liegen einige Strohlager herum, auf denen wohl die Echsen "
    "schlafen.");
  AddDetail( ({"lager", "strohlager", "stroh"}),
    "Auf den Strohlagern am Boden uebernachten wohl die Kampfechsen.");
  AddDetail( ({"waende", "wand", "stein"}),
    "Die Waende bestehen aus grob behauenem Stein.");  
  AddDetail( ({"decke"}),
    "An der Decke ist eine Falltuer, zu der eine Leiter hinauffuehrt.");
  AddDetail( ({"leiter"}),
    "Eine Leiter fuehrt zu der Falltuer an der Decke hinauf.");
  AddDetail( ({"licht"}),
    "Das einzige Licht kommt aus einer Oeffnung im Osten.");
  AddDetail( ({"osten", "oeffnung", "durchgang"}),
    "Im Osten befindet sich eine Oeffnung, aus der Licht in die duestere "
    "Hoehle faellt. Sie wird von zwei Echsenstatuen flankiert.");
  AddDetail( ({"statue", "statuen", "echsenstatue", "echsenstatuen"}),
    "Auf beiden Seiten der Oeffnung im Osten stehen Statuen, die "
    "Echsen darstellen. Sie scheinen den Durchgang zu bewachen und lassen "
    "wahrscheinlich nur Echsen durch. (Oder alles, was wie eine Echse "
    "aussieht.)");
  AddDetail( ({"holz"}),
    "Die Falltuer besteht aus hartem Holz.");
  AddDetail( ({"eisenstreben", "eisen", "streben"}),
    "Die Falltuer ist mit Eisenstreben verstaerkt.");  
  AddSound( ({DEFAULT_SOUND}),
    "Es ist sehr still hier.");
  AddSmell( ({DEFAULT_SMELL}),
    "Es riecht nach den Ausduenstungen der Kampfechsen.");
  AddSmell( ({"ausduenstungen"}),
    "So wie es hier riecht, scheinen die Kampfechsen nicht sehr reinlich "
    "zu sein.");
    
  AddExit( "osten", ([EX_DEST: "./drachenhoehle",
                      EX_TESTFUNC: "echsentest"]) );
  NewDoor("oben", ROOM "wachraum", ({"falltuer", "falltuere" }), 
      ({ D_FLAGS, DOOR_RESET_CL | DOOR_CLOSED | DOOR_NEEDKEY | DOOR_CLOSEKEY,
         D_SHORT, "Eine %se Falltuer.",
         D_LONG, "Die Falltuer besteht aus hartem Holz und ist mit "
                    "Eisenstreben verstaerkt.\n",
         D_NAME, "Falltuer",
         D_GENDER, NEUTER,
         D_CMDS, "oeffne",
         D_OPENTESTFUNC, "schluesseltest",
         D_CLOSETESTFUNC, "tuer_zu",
         }) );
}

int echsentest()
{
  object *ob;
  if( (ob=TP->QueryArmours(AT_CLOAK)) && sizeof(ob) && ob[0]->id("echsenhaut") ) 
    return 1;
  write("Eine magische Kraft haelt Dich zurueck.\n");
  return 0;
}

mixed tuer_zu()
{
  write("Die Falltuere laesst sich nicht schliessen.\n");
  return 1;
}

mixed schluesseltest()
{
  object key;
  if( key = deep_present("\nderlim_falltuer_key", TP) ) {
    call_out("key_weg",0, key);
    return 0;
  }
  write("Damit kannst Du die Falltuer nicht oeffnen.\n");
  return 1;
}

void key_weg(object key)
{
  write(key->Name(WER,1)+" zerbroeselt zu Staub.\n");
  key->remove();
}
    
