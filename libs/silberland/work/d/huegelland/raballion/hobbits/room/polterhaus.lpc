// /d/huegelland/raballion/hobbits/room/polterhaus.c
// Haus des Poltergeistes in Derlim
// 2002-07-07 Feyaria@SilberLand


#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "In einem baufaelligen Haus" );
  SetProp(P_INT_LONG,
    "Du befindest Dich in einem baufaelligen Haus mitten in Derlim. Hier "
    "wohnt scheinbar schon lange niemand mehr. Alles ist voll mit Spinnweben "
    "und eine dicke Staubschicht ueberdeckt den ganzen Boden. Leere Faesser "
    "und zerbrochene Bretter liegen wild verstreut herum. Durch die windschiefe "
    "Tuer kommst Du wieder nach draussen.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_HOUSE]) );

  AddDetail( ({"haus", "raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({"boden", "staub", "staubschicht"}),
      "Vom Boden kann man vor lauter Staub nichts erkennen, nur einige leere "
      "Faesser und zerbrochene Bretter liegen wild verstreut herum.");
  AddDetail( ({"wand", "waende"}),
      "Die Waende sind ziemlich dreckig.");
  AddDetail( ({"decke"}),
      "Die Decke ist ziemlich morsch. Ueberall siehst Du Spinnweben.");
  AddDetail( ({"spinnweben", "weben", "spinnwebe", "spinne", "spinnen", 
        "bewohner"}),
      "Ueberall im Raum gibt es Spinnweben, Spinnen scheinen die einzigen "
      "Bewohner dieses Hauses zu sein.");
  AddDetail( ({"fass", "faesser", "brett", "bretter", "ding", "dinge"}),
      "Leere Faesser und zerbrochene Bretter liegen wild verstreut im "
      "Raum herum. Sie sind nicht verstaubt, es scheint als wuerde "
      "irgendwer diese Dinge staendig im Raum herumwerfen.");
  AddDetail( ({"tuer"}),
      "Durch die windschiefe Tuer kommst Du wieder nach draussen, was Du "
      "sofort tun solltest, damit das Haus nicht ueber Dir zusammenbricht.");
  AddDetail( ({"derlim"}),
      "Dieses Haus steht mitten im Wohngebiet von Derlim.");
  AddDetail( ({"wohngebiet", "wohn", "gebiet", "hobbit", "hobbits"}),
      "Im Wohngebiet wohnen die Hobbits von Derlim.");
  AddSmell( DEFAULT_SMELL,
      "Es riecht eigenartig.");
  AddSound( ({DEFAULT_SOUND, "geraeusche"}),
      "Du hoerst eigenartige Geraeusche.");


  AddItem( NPC "poltergeist", REFRESH_DESTRUCT);

  AddExit( "raus", "./wohngebiet3");

}

void reset()
{
  ::reset();
  set_next_reset(12*60*60); // Geist kommt alle 12 Stunden.
}
