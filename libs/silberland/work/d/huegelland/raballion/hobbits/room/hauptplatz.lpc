#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Hauptplatz von Derlim" );
  SetProp(P_INT_LONG,
    "Der Hauptplatz von Derlim. Hier ist viel los. Haendler huschen an "
    "Dir vorbei, Kinder laufen spielend und schreiend ueber den Platz und " 
    "ueberall siehst Du Hobbits mit froehlichen Gesichtern. Im Norden "
    "erkennst Du einen kleinen Huegel, der, obwohl er sehr gepflegt ist, "
    "wenig genutzt scheint. Suedoestlich von Dir erkennst Du einen grossen "
    "Huegel, ueber dem ein Bronzeschild haengt. Im Westen befindet sich ein "
    "grosses Haus, zu dem Du aber keine Eingaenge siehst. Im Sueden ist ein "
    "weiterer mittlerer Huegel mit fast magischer Ausstrahlung. Desweiteren "
    "befindet sich im Nordosten der Stadtverwaltungshuegel.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 18, ENV_TERRAIN: TT_TOWN]) );

// standart details fuer die stadt
#include "details_stadt.h"

// standart details fuer aussen
#include "details_aussen.h"

// standart details fuer gruppen von raeumen
#include "details_hauptstr.h"
    
  AddDetail( ({ "platz", "hauptplatz", "stadtkern"}),
    QueryProp(P_INT_LONG) );
  AddDetail( ({"stadt", "hobbingen", "derlim"}),
    "Du befindest Dich in der Stadt Derlim. Von anderen Rassen wird sie "
    "aber Hobbingen genannt.");
  AddDetail(({"ausstrahlung"}),
    "Eine wirkliche magische Ausstrahlung....");
  AddDetail( ({ "haendler" }),
    "Viele Haendler laufen geschaeftig ueber den Platz. Obwohl Hobbits "
    "nachgesagt wird, sie seien nur an einem genussvollem Leben "
    "interessiert, erscheinen sie Dir als ein fleissiges Volk.");
  AddDetail( ({ "kind", "kinder"}),
    "Kleine und groessere Kinder rennen uebermuetig ueber den Platz. Du "
    "siehst ihnen ihre Lebensfreude richtig an.");
  AddDetail( ({"gesicht", "gesichter", "miene", "mienen"}),
    "Du betrachtest die Gesichter der vorbeieilenden Hobbits genau. "
    "Obwohl alle beschaeftigt scheinen, kannst Du trotzdem nur froehliche "
    "Mienen erkennen.");
  AddDetail( ({"huegel"}),
    "Die meisten Haeuser in Derlim bestehen aus Huegel. Im Norden, sowie im Sueden, "
    "siehst du einen kleinen bzw. mittleren, im Suedosten einen doch deutlich groesseren "
    "Huegel. Ahja, den weiteren Huegel im Nordosten haette ich fast vergessen. "
    "Das Gebaeude im Westen allerdings ist ein gemauertes Haus.");
  AddDetail( ({"mittlerer huegel", "suedhuegel", "suedlicher huegel", 
               "sued huegel", "huegel im sueden"}),
    "Der mittlere Huegel im Sueden fesselt voruebergehend deine Aufmerksamkeit. "
    "Mit Kennerblick registrierst Du den sakralen Mittelpunkt von Derlim. "
    "Er ist aussen wirklich sehr gepflegt, und Du wirst das Gefuehl nicht los, "
    "dass er irgendwie magisch ist.");
  AddDetail( ({"kleiner huegel", "nordhuegel", "noerdlicher huegel", 
               "nord huegel", "huegel im norden"}),
    "Du gehst ein paar Schritte nach Norden und untersuchst den Huegel "
    "genauer. Ueber der Tuer entdeckst Du ein Emailschild. Sonst aendert "
    "sich an Deinem Eindruck nichts. Er ist aussen wirklich sehr gepflegt, "
    "und doch wirst DU das Gefuehl nicht los, dass da irgendwie wenig "
    "Hobbits ein und aus gehen.");
  AddDetail( ({"grosser huegel", "suedosthuegel", "suedoestlicher huegel", 
               "suedost huegel", "huegel im suedosten"}), 
    "Im Suedosten siehst Du einen groesseren Huegel. An einer Stange "
    "haengt ein grosses Bronzeschild. Viele Hobbits gehen dort ein und aus "
    "und du hoerst auch lautes Gerede, das fuer Dich manchmal sogar wie "
    "Gezank klingt.");
  AddDetail( ({"weiteren huegel", "nordosthuegel", "nordoestlicher huegel", 
          "nordost huegel", "huegel im nordosten", "Stadtverwaltungshuegel"}), 
    "Im Nordosten siehst Du einen weiteren Huegel. An ihm ist ein Tonschild "
    "angebracht.");
  AddDetail( ({"haus"}),
    "Das Haus sieht wirklich stattlich aus. Obwohl es ein Neubau ist und "
    "deshalb nicht ganz in die Huegellandschaft des alten Stadtkerns von "
    "Derlim passt, findest Du es doch irgendwie gut eingegliedert.");
  AddDetail( ({"mauer", "mauern"}),
    "Das Haus im Westen ist das einzige Haus hier, das Mauern hat, die "
    "anderen sind alle in den Huegeln.");
  AddDetail( ({"eingang", "eingaenge"}),
    "Sowas siehst Du nur bei den 2 Huegeln. Das Haus scheint wenigstens "
    "auf dieser Seite keine zu haben.");
  AddDetail( ({"leben"}),
    "Jeder hat eines. Sogar Du. Die Hobbits hier geniessen das Ihre "
    "offensichtlich besonders intensiv.");
  AddDetail( ({"lebensfreude"}),
    "Lebensfreude duerfte allen Hobbits angeboren sein. Nichts kann sie "
    "erschuettern. Sie wissen eine koestliche Mahlzeit und nette "
    "Gesellschaft zu schaetzen.");
  AddDetail( ({"volk"}),
    "Hier leben Hobbits. Schau Dich doch um. Da haettest Du auch selber "
    "drauf kommen koennen.");
  AddDetail( ({"eindruck"}),
    "Dein erster Eindruck hat Dich nicht getaeuscht.");
  AddDetail( ({"neubau"}),
    "Als Neubau gilt in Derlim alles, was nicht in einen Huegel "
    "hineingebaut, sondern aus Mauern errichtet ist. Im Westen siehst du "
    "ein Paradebeispiel dafuer.");
  AddDetail( ({"huegellandschaft", "haeuser", "gebaeude", "achse"}),
    "Du drehst Dich einmal um Deine eigene Achse und kommst drauf, dass "
    "die Haeuser in Derlim wirklich fast nur aus Huegeln bestehen.");
  AddDetail( ({"stadtkern"}),
    "Du befindest Dich mitten drin.");
  AddDetail( ({"seite"}),
    "Alles hat mehrere davon. Auch das Haus. Auf der Dir zugewandten Seite "
    "findet Du nicht viel.");
  AddDetail( ({"mahlzeit"}),
    "Mit einer guten Mahlzeit kannst Du sicher jeden Hobbit gluecklich "
    "machen. Wenn Du ihm dabei noch Gesellschaft leistest, ist fuer die "
    "meisten Hobbits ihr Glueck perfekt.");
  AddDetail( ({"glueck"}),
    "Feyaria wuenscht Dir viel Glueck beim Detail-Untersuchen.");
  AddDetail( ({"feyaria", "regionsmagierin", "huegelland"}),
    "Feyaria ist die Regionsmagierin des Huegellandes, und daher auch fuer "
    "diese Stadt verantwortlich.");
  AddDetail( ({"detail"}),
    "Warum sollte das Detail \'detail\' beschrieben sein? ;)\n");
  AddDetail( ({"gesellschaft", "leute"}),
    "Hobbits sind gesellige Leute. Deshalb lieben sie auch Gesellschaften.");
  AddDetail( ({"paradebeispiel"}),
    "Im Westen findest du ein Paradebeispiel fuer ein neu erbautes und "
    "trotzdem passendes Haus.");
/*  
  AddDetail( ({"achse"}),
    "Wo siehst Du sowas? Nur, weil Du Dich um Deine eigene drehst, ist das "
    "noch lang nix zum Untersuchen. Oder bist Du ein Rad? Merke Dir gut, "
    "dass Scripten gefaehrlich ist.");
  AddDetail( ({"untersuchen", "untersuche"}),
    "Schoen und gut, aber bitte immer nur mit erlaubten Mitteln.");
  AddDetail( ({"mittel", "mitteln"}),
    "Unerlaubte Mittel stehen unter 'hilfe scripts'");
  AddDetail( ({"rad"}),
    "Ignorierst Du Warnungen absichtlich?");
  AddDetail( ({"scripten"}),
    "Das fuehrt meist direkt zu Scriptfallen.");
  AddDetail( ({"warnung", "warnungen"}),
    "Die solltest Du doch ernst nehmen, wenn Du nicht in Scriptfallen "
    "landen willst.");
  AddDetail( ({"scriptfalle", "scriptfalle", "scriptfallen"}),
    "Ansich solltest Du jetzt MAUSETOT sein.");
  AddSpecialDetail( ({"mausetot"}), "scriptfalle");
*/  
  AddDetail( ({"boden"}),
    "Du stehst darauf. Der Boden ist ueber und ueber von einer Strasse "
    "bedeckt, die auf beiden Seiten von Gehsteigen eingesaeumt ist. In der "
    "Mitte vom Hauptplatz gibt die Strasse eine kleine Insel frei.");
  AddDetail( ({"himmel"}),
    "Treffer. Ein solcher ist ueber Dir. Richtig unerwartet, hier draussen "
    "im Freien. Jaja. Wolken, Sonne, alles da.");
  AddDetail( ({"sonne"}),
    "Sonne? Ueber Dir, warm strahlend, genau ein mal vorhanden, wie es "
    "sich fuer eine richtige Sonne im Silberland gehoert. Was hast Du Dir "
    "auch anderes erwartet?");
  AddDetail( ({"wolke", "wolken"}),
    "Da bist Du wohl einer Falschmeldung erlegen. Der Himmel ist wolkenlos.");
  AddDetail( ({"falschmeldung"}),
    "Extra fuer Dich (und fuer eine ganz besondere Neugierdsnase).");
  AddSpecialDetail( ({"neugierdsnase"}), "neugier" );
  AddDetail( ({"insel", "mitte"}),
    "In der Mitte des Hauptplatzes ist eine kleine Insel. Auf ihr steht "
    "ein grosser Baum und davor eine gemuetliche Bank.");
  AddDetail( ({"baum"}),
    "Ein riesiger Baum.");
/// Da sollt spaeter fuer Elfen & Menschen kommen, dass man raufklettern kann
/// und fuer Zwerge & Hobbits zum unter die Wurzeln klettern.
/// beides koennt zu einem Sehertor oder sowas fuehren. Details kommen, wenn 
/// wir uns sicher sind, was es wird.
  AddDetail( ({"bank"}),
    "Die Bank laedt richtig zum Ausruhen ein.");
  AddDetail( ({"ausruhen"}),
    "Probier's doch einfach");
/// Command ruhe aus, fuer Elfen, Zwerge, Menschden nix besonderes, 
/// fuer Hobbits einmal pro reset + 10 lp, + 10 mp, 5 sec rast(verpflichtend)
/// ? (Vorschlag)
  AddDetail( ({"frei", "freien", "draussen", "raum"}),
    "Du bist ganz einfach im Freien. Oder glaubst Du, ein Hauptplatz ist "
    "ein Raum?");
  AddDetail( ({"schild", "bronzeschild", "emailschild", "tonschild"}),
    "Du kannst versuchen, es zu lesen.");
  AddReadDetail( ({"schild"}),
    "Welches Schild willst Du lesen?");
  AddReadDetail( ({"bronzeschild"}),
    "Tro;dlerl*den\n"+
    "Nein, dies ist kein TYPO, sondern nur ein etwas schlampiger Troedler.");
  AddReadDetail( ({"emailschild"}),
    "POST");
  AddReadDetail( ({"tonschild"}),
    "Stadtverwaltung");

  AddSound( ({ DEFAULT_SOUND }),
    "Du hoerst viele geschaeftige Hobbits. Aus dem Suedosten dringt lautes "
    "Gerede.");
  AddSound( ({"gerede", "gezank"}),
    "Es hoert sich an, als ob dort ein paar Leute feilschen wuerden.");

  AddSmell( ({DEFAULT_SMELL, "duft", "luft"}),
    "Viele verschiedene Gerueche dringen auf Dich ein. Aus dem Westen dringt "
    "eine verfuehrerische Duftwolke auf Dich ein.");
  AddSmell( ({"duftwolke", "duftwolken"}),
    "Auf unerklaerliche Weise bekommst Du Hunger. Lieg das etwa daran, dass "
    "Dir der Duft von Frittatensuppe, Spanferkeln und vielem Anderen in die "
    "Nase steigt?");
  AddSmell (({"geruch", "gerueche", "essen"}),
    ([ 0:      "Es riecht nach Essen.\n",
     "elf":    "Mmmh. Als Elf sagt Dir der Geruch: Die Kneipe liegt in westlicher Richtung.\n",
     "hobbit": "Du denkst, wie Deine Artgenossen, nur an das Essen.\n",
     "zwerg":  "Also nach Wertmetall riecht es nicht.\n",
     "mensch": "Riecht zwar fremd, aber lecker.\n",
     "magier": "Schnueffelnase. Steckst sie auch ueberall rein. Gib zu Du hast den Code gelesen.\n"

    ]) );

  AddCmd( ({"ruhe", "ruh", "ausruhen"}), "ruhen");
  AddCmd (({"klettere","kletter"}), "kletter");

  AddExit( "norden", "./post" );
  AddExit( "nordosten", "./rathaus1");
  AddExit( "osten", "./hauptstrasse3");
  AddExit( "suedosten", "./laden");
  AddExit( "sueden", "./kapelle");
  AddExit( "suedwesten", "./hauptstrasse4");

  AddItem( NPC "taube", REFRESH_DESTRUCT);
  AddItem( NPC "taube", REFRESH_DESTRUCT);
  AddItem( NPC "taube", REFRESH_DESTRUCT);
  AddItem( "/d/kristallwald/sargola/dorf/obj/tafel");
}

int ruhen(string str)
{
  notify_fail("Willst Du Dich etwa ausruhen?\n");
  if( !str ) return 0;
  if( str=="aus" || str == "auf der bank aus")
  {
    write("Du ruhst Dich auf der Bank aus. Es ist einfach herrlich.\n");
    say( CAP_TPN + " ruht sich auf der Bank aus.\n");
    return 1;
  }
  return 0;
}

int kletter(string str)
{
   string race;

   notify_fail ("Wohin willst Du klettern?\n");
   if (!str) return 0;
      
   race = TP->QueryProp(P_RACE);
   
  if ( str=="nach oben" ||
        str=="oben" ||
        str=="rauf"||
        str=="auf den baum" ||
        str=="auf baum"||
        str=="baum"||
        str=="hinauf")
    {     
    switch(race)
      {
      case "Mensch":
        {
        write("Du blickst noch einmal nach oben und "
            +"beginnst dann ohne Furcht zu klettern.\n");
        TP->move(ROOM"baum.lpc", M_GO, "oben" ,"klettert nach", 
            "kommt heraufgeklettert");
        return 1;
        }
      case "Zwerg":
        {
        write("Nur mit groesster Ueberwindung beginnst Du "
            +"langsam und vorsichtig den Baum zu "
            +"ersteigen. Wenn Deine Ahnen das sehen "
            +"wuerden!\n");
        TP->move(ROOM"baum.lpc", M_GO, "oben" ,"klettert nach", 
            "kommt heraufgeklettert");
        return 1;
        }
      case "Hobbit":
        {
        write("Frohen Mutes beginnst Du den riesigen Baum "
            +"zu erklettern. Da Du dies in deiner Kindheit "
            +"oft gemacht hast, kommst Du gut voran.\n");
        TP->move(ROOM"baum.lpc", M_GO, "oben" ,"klettert nach", 
            "kommt heraufgeklettert");
        return 1;
        }
      case "Elf":
        {
        write("Froehlich steigst Du auf die ersten Aeste. "
            +"In ein Baum fuehlst Du Dich einfach zuhause.\n");
        TP->move(ROOM"baum.lpc", M_GO, "oben" ,"klettert nach", 
            "kommt heraufgeklettert");
        return 1;
        }
      default:
        {
        write("Du beginnst ohne Furcht nach oben zu klettern.\n");
        TP->move(ROOM"baum.lpc", M_GO, "oben" ,"klettert nach", 
            "kommt heraufgeklettert");
        return 1;
        }
      }
    }
  else
    return 0;
}


string neugier()
{
  if( TPN=="Vivienne" )
    return "Ja, DU bist gemeint.\n";
  else
    return "Neugierdsnase? Das kann nur Vivienne sein!\n";
}

string scriptfalle()
{
  write_file(LOG "scriptfalle",
    ctime()+": "+CAP(getuid(TP))+" loest Scriptfalle am Hauptplatz aus!\n");  
  return "Du wurdest als Scripter enttarnt und wirst die Folgen tragen muessen!\n";
}
