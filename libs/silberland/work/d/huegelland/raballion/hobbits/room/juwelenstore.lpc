#include "../def.h"

inherit "std/store";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SUID;
  AddItem ("/p/armour/ring/ring", REFRESH_REMOVE, 
      ([P_VALUE: 3000+random(3000)]) );
  AddItem ("/p/armour/amulet/amulett", REFRESH_REMOVE, 
      ([P_VALUE: 3000+random(3000)]) );
}
