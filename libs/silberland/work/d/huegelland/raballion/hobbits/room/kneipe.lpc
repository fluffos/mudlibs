  AddCmd( ({"oeffne"}), "oeffnen");
 
  AddExit("norden", "./westweg1");

  AddItem( NPC "wirt", REFRESH_DESTRUCT);
  klogeher=({ });
}

public void hirnreiniger_trinken() {
  object task;

  write(BS("Der Wirt bringt Dir ein Glas Hirnreiniger und lacht dabei "
           "hinterhaeltig.\nDu trinkst das Glas bis auf den letzten Tropfen aus "
           "und verspuerst eigentlich\ngar nichts.\nWUMM !!!\nPloetzlich verdrehst "
           "Du die Augen und Rauch kommt aus Deinen Ohren und Deiner Nase.\n"));
  say(BS("Der Wirt bringt "+TPN+" ein Glas Hirnreiniger und lacht dabei "
         "hinterhaeltig.\n"+TPN+" trinkt das Glas bis auf den letzten Tropfen aus, "
         "worauf "+TPN+" die Augen\nverdreht und Rauch aus Ohren und Nase "
         "kommt.\n"));

  if(objectp(task=present(BARD_ID_GS10_TASK, TP))) {
    task->MarkFood(3);
  }
}


int oeffnen(string str)
{
  int i;
  notify_fail("Was willst Du oeffnen?\n");
  if( !str ) return 0;
  if( str=="tuer" || str=="tuere")
  {
    if (member_array (TP, klogeher) == -1)
    {
      write("Du oeffnest die Tuer und betrittst die Toilette.\n");
      if( TP->QueryProp(P_FOOD) > TP->QueryProp(P_MAX_FOOD)/2 )
      {
        TP->SetProp(P_FOOD, TP->QueryProp(P_FOOD)-random(30) );
        i++;
      }
      if( TP->QueryProp(P_DRINK) > TP->QueryProp(P_MAX_DRINK)/2 )
      {
        TP->SetProp(P_DRINK, TP->QueryProp(P_DRINK)-random(30) );
        i++;
      }
      if( TP->QueryProp(P_ALCOHOL) > TP->QueryProp(P_MAX_ALCOHOL)/2 )
      {
        TP->SetProp(P_ALCOHOL, TP->QueryProp(P_ALCOHOL)-random(30) );
        i++;
      }
      switch(i)
      {
        case 0: write("Aber eigentlich musst Du ja gar nicht.....\n"); break;
        case 1: write("Du fuehlst Dich etwas erleichtert.....\n"); break;
        case 2: write("Du fuehlst Dich erleichtert.....\n"); break;
        case 3: write("Du fuehlst Dich sehr erleichtert.....\n"); break;
      } 
      write("Mehr oder weniger befriedigt verlaesst Du die Toilette wieder.\n");   
      klogeher+=({ TP });
    }
    else
      write( "Als Du versuchst die Tuer zu oeffnen, ertoent laut eine "
              "Stimme:\nHALT !, BESETZT !\n");
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();
  klogeher=({ });
}

string xp()
{
  if( TP->QueryProp(P_XP)> 10000000 )
    return BS("Du hast selber schon extrem viel Erfahrung gesammelt. "
              "Vielleicht solltest Du selbst einmal etwas erzaehlen.");
  if( TP->QueryProp(P_XP)> 1000000 )
    return "Du hast selber schon viel Erfahrung gesammelt.\n";
  if( TP->QueryProp(P_XP)> 100000 )
    return "Du hast selber schon einiges an Erfahrung gesammelt.\n";
  if( TP->QueryProp(P_XP)> 10000 )
    return "Du hast selber schon ein wenig Erfahrung gesammelt.\n";
  else
    return "Du hast noch nicht sehr viel Erfahrung gesammelt.\n";
}

string qp()
{
  int maxqp,qp;
  maxqp="/secure/questmaster"->QueryMaxQP();
  qp=100*TP->QueryProp(P_QP);
  if(qp/maxqp > 98 )
    return BS("Du hast selber schon aussergewoehlich viele Abenteuer erlebt. "
              "Vielleicht solltest Du selbst einmal einige erzaehlen.");
  if(qp/maxqp > 75 )
    return BS("Du hast selber schon sehr viele Abenteuer erlebt.");
  if(qp/maxqp > 50 )
    return BS("Du hast selber schon viele Abenteuer erlebt.");
  if(qp/maxqp > 20 )
    return BS("Du hast selber schon einige Abenteuer erlebt.");
  if(qp/maxqp > 2 )
    return BS("Du hast selber erst wenige Abenteuer erlebt.");
  else
    return BS("Du hast noch gar keine Abenteuer erlebt, vielleicht solltest "
              "Du aufmerksam einem erfahrenen "+TP->QueryProp(P_RACE)+" zuhorchen.");
}

string menuetafel()
{
  menue();
  return "";
}

void kindergetraenk(object z, object e)
{
  if( e->QueryProp(P_LEVEL)<=10)
  {
    write("Du trinkst das Kindergetraenk und fuehlst Dich gestaerkt.\n");
    say(TP->Name(WER,1)+" trinkt ein Kindergetraenk.\n");
    e->heal_self(25);
  }
  else
  {
    write("Du bist schon zu gross fuer das Kindergetraenk!\n");
  }
}

void hobbitjause(object z, object e)
{
  int saett;
  if( e->QueryProp(P_RACE)!="Hobbit")
  {
    write(BS("Diese Jause ist nur etwas fuer Hobbits. Enttaeuscht schickst "
          "Du sie wieder zurueck."));
  }
  else
  {
    write(BS("Du mampfst eine Hobbitjause und fuehlst Dich vollkommen "
          "gesaettigt.\n"));
    say(BS(TP->Name(WER,1)+" mamapf eine Hobbit jause und fuehlt sich "
          "vollkommen gesaettigt."));
    saett=e->QueryProp(P_MAX_FOOD)-e->QueryProp(P_FOOD);
    e->SetProp(P_FOOD, e->QueryProp(P_MAX_FOOD));
    e->heal_self(saett*4);
  }
}
