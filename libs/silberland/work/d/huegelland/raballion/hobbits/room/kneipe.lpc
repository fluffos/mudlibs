  AddDetail("rote kerze",
    "Ja, die Kerze ist rot. Das ist aber auch schon alles.");
  AddDetail("weisse kerzen",
    "Ja, die Kerzen sind weiss. Das ist aber auch schon alles.");
  AddDetail( ({"waende"}),
    "Sie sind mit wunderschoenen hoelzernen Taefelungen versehen. Eine Wand "
