  SetProp( P_PUBKEEPER_ID, "tarin");
  SetProp( P_PUBKEEPER_NAME, "Tarin Langsattler");
  SetProp( P_PUBKEEPER_GENDER, MALE);

  AddDrink("Kindergetraenk", ({"kindergetraenk"}),
