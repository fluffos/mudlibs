  AddDetail(({"hobbitstammtisch","stammtisch", "tag", "nacht"}),
    "Die Hobbits treffen sich hier regelmaessig um Erfahrungen auszutauschen "
    "und von Ihren Abenteuern zu berichten. Der Tisch wird Tag und Nacht nur "
    "fuer die Hobbits freigehalten.");
  AddSpecialDetail( ({"erfahrung", "erfahrungen"}), "xp" );
  AddSpecialDetail( ({"abenteuer", "abenteuern"}), "qp" );
  AddDetail( ({"hobbit", "hobbits"}),
    "Die Hobbits treffen sich hier zu ihren Stammtisch.");
  AddDetail("sessel",
    "Es sind gute, stabile Sessel die einen Hobbit in voller Ruestung "
    "sicherlich aushalten.");
  AddDetail( ({"rassen", "rasse", "wesen", "mensch", "menschen", "zwerg",
               "zwerge", "elf", "elfen"}),
    "Es handelt sich natuerlich hauptsaechlich um Hobbits, aber hin und "
    "wieder sieht man auch Menschen, Zwerge und sogar Elfen.");
  AddDetail( ({"tafel", "menuetafel"}),
    "Auf der Menuetafel stehen die Getraenke und Speisen, die Du hier bestellen "
    "kannst.");
  AddDetail( ({"getraenke", "speisen", "getraenk", "speise"}),
    "Alle Speisen und Getraenke, die Du hier bestellen kannst, stehen auf "
    "der Tafel."); 
  AddReadDetail( ({"tafel", "menuetafel"}), #'menuetafel);

  AddSound(({DEFAULT_SOUND}),
    "Du lauscht und hoerst gar nichts. Hier herrscht absolute Stille. Der "
    "richtige Platz um sich auszuruhen.");
  AddSmell(({DEFAULT_SMELL, "geruch", "essen"}),
    "Du schnupperst in der Luft und der Geruch von gutem, warmen Essen "
