  ::create();
  	
  SetProp(P_INT_SHORT,"Wirtshaus zum Goldenen Drachen");
  SetProp(P_INT_LONG, 
    "Du befindest Dich im Wirtshaus \"Zum Goldenen Drachen\". In diesem "
    "Wirtshaus gehen verschiedenste Rassen und Wesen aus und ein um sich zu "
    "staerken und zu erfrischen. Sonnenstrahlen durchdringen die bunten "
    "Fenster und bringen somit Licht in die Gaststube. Auf den Waenden "
    "befinden sich hoelzerne Taefelungen, welche mit schmucken Schnitzereien "
    "verziert sind. Am suedlichen Ende des Hauses befindet sich die Schank. "
    "Ueber der Schank haengt eine Tafel. In einer Ecke steht ein Tisch mit "
    "einigen Sesseln. ");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
