  AddDetail("lettern",
    "Sie sind auch aus Blattgold gemacht.");
  AddDetail( ({"schild"}),
    "Du kannst es lesen.");
  AddDetail( ({"inschrift"}),
    "Du kannst sie lesen.");
  AddReadDetail( ({"schild", "inschrift"}),
