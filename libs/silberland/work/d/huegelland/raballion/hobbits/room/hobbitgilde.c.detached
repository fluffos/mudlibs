// Ein Beispiel einer Abwandlung der Abenteurer-Gilde.

#include "../def.h"

inherit "/gilden/abenteurer";

#include <properties.h>
#include <language.h>

Funktion();

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Hobbitgilde" );
  SetProp(P_INT_LONG, BS( 
    "Du befindest Dich in der Gilde der Hobbits. Sie bietet alles, was ein "
    "junger Abenteurer so braucht. An der Wand befindet sich ein grosse "
    "Tafel, die alle Funktionen erklaert. Durch runde Fenster fliesst "
    "warmes Sonnenlicht in den Raum und macht ihn noch gemuetlicher. "
    "Der Boden besteht aus grossen Marmorplatten. Nach Westen geht es durch "
    "eine grosse Tuer auf die Strasse hinaus. Eine grosse Uhr zeigt die Zeit "
    "an."));
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_HOUSE]) );

  SetProp(P_DETAILS, ([]) );
  RemoveItem("/p/service/obj/zettel/zettelmaschine");
  RemoveExit("westen");
  AddSpecialDetail("uhr","zeige_reboot");
  AddDetail(({"funktionen", "funktion", "tafel"}), #'Funktion);
  AddReadDetail(({"funktion", "funktionen", "schild"}), #'Funktion);

  AddDetail( ({"boden", "platten", "platte"}), 
    "Der Boden besteht aus grossen Marmorplatten.");
  AddDetail( ({"marmor", "marmorplatten", "marmorplatte"}),
    "Es ist sehr teurer Marmor, wie er nur in ganz wenigen Steinbruechen "
    "vorkommt.");
  AddDetail( ({"steinbruch", "steinbrueche"}),
    "Leider ist nicht festzustellen, aus welchem Steinbruch dieser schoene "
    "Marmor kommt.");
  AddDetail( ({"fenster"}),
    "Die Fenster sind rund, wie es bei den Hobbits meist ueblich ist.");
  AddDetail( ({"licht", "sonnenlicht"}),
    "Warmes Sonnenlicht fliessst durch die runden Fenster in den Raum. "
    "Die Hobbits verstehen es, einen Raum gemuetlich zu machen.");
  AddDetail( ({"raum", "gilde"}), QueryProp(P_INT_LONG) ); 
  AddDetail( ({"tafel"}),
    "Auf der Tafel sind alle Funktionen der Gilde erklaert. Du solltest sie "
    "lesen.");
  AddDetail( ({"funktionen", "funktion"}),
    "Du kannst ueber sie auf der Tafel nachlesen.");
  AddDetail( ({"wand", "waende"}), 
    "An der Wand befindet sich ein grosse Tafel, die alle Funktionen "
    "erklaert." );
  AddDetail( ({"abenteurer"}), 
    "Jeder hat sein Leben einmal als Abenteurer begonnen.");
  AddDetail( ({"derlim", "hobbingen"}),
    "Du befindest dich in der Gilde von Derlim.");
  AddDetail( ({"hobbit", "hobbits"}),
    (["hobbit": "Hobbits sind einfach die besten unter allen Voelkern.",
      0: "Die Hobbits haben sich hier gemuetlich eingerichtet."]) );
  AddDetail( ({"tuer", "westen", "strasse"}),
    "Nach Westen geht es durch eine grosse Tuer auf die Strasse hinaus.");
  AddSmell( ({DEFAULT_SMELL}),
    "Es riecht nach Abenteuern.");
  AddSound( ({DEFAULT_SOUND, "laerm"}),
    "Von der Strasse dringt etwas Laerm herein, ansonsten ist es angenehm "
    "ruhig hier.");

  AddCmd( ({"kosten", "wandle", "erhoehe", "lern", "lerne"}), "hobbitgilde");
  
  AddExit( "westen", "./hauptstrasse3" );
  AddItem( NPC "molkine", REFRESH_DESTRUCT);
}

string GuildName() 
{
  return "abenteurer";
}

hobbitgilde(string str)
{  
  string race;
  if( (race=this_player()->QueryProp(P_RACE))!="Hobbit") 
    return notify_fail("Das ist die Hobbitgilde, da hast Du als "+race+
                       " nichts zu suchen.\n"),0;
  switch(query_verb())
  {
    case "kosten": return kosten(str);
    case "wandle": return change(str);
    case "erhoehe": return advance(str);
    case "lern":
    case "lerne": return OwnLearnSpell(str);
  }
}

