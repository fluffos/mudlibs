/// /d/gebirge/feyaria/hobbits/room/berx.c
/// Das Seherhaus von Berx
/// 4-12-96 Feyaria@SilberLand
/// 34 Details, 1 Sound, 1Smell

#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Berx' Seherhaus" );
  SetProp(P_INT_LONG,
    "Das ist das Seherhaus von Berx. Es sieht hier ganz nett aus, obwohl es "
    "etwas unordentlich ist. An einer Wand ist ein schoener grosser "
    "Kamin. Davor befindet sich ein gemuetlicher Lehnstuhl. So richtig zum "
    "Reinsetzen und in einen angenehmen Halbschlaf versinken. Gleich "
    "daneben ist ein Regal, auf dem viele Pfeifen, einige Pfeifenputzer, "
    "etliche Tabakdosen und ein Stopfer liegen. Auf der anderen Seite vom "
    "Kamin steht ein Schrank, in dem einige Glaeser stehen. Im unteren Teil "
    "vom Schrank sind mehrere Flaschen. In einer Ecke steht ein Truhe. "
    "Durch ein kleines Fenster kann man zum Garten hinausschauen.");
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_NO_MNPC, 1);
    
  AddDetail( ({ "seherhaus", "haus", "raum"}), QueryProp(P_INT_LONG) );
  AddDetail( ({ "kamin" }),
    "Ein wunderschoener Kamin. Leise knistert das Feuer in ihm. Ueber dem "
    "Kamin sind einnige Russflecken zu erkennen. Sicher von dem Feuer, das "
    "staendig im Kamin brennt. Unter dem Kamin befinden sich einige "
    "Holzscheiter und auch einige lange, duennen Spaene.");
  AddDetail( ({"feuer", "flammen", "flamme" }),
    "Das Feuer waermt wirklich wunderbar. Es scheint andauernd zu brennen, "
    "jedenfalls weisen die Russflecken ueber dem Kamin darauf hin. Kleine "
    "Flammen zuengeln auch auf den Kerzen und Fackeln, die den Raum "
    "erhellen.");
  AddDetail( ({"lehnstuhl", "stuhl"}),
    "Ein gemuetlicher Lehnstuhl. Berx sitzt hier immer, wenn er seine "
    "Pfeife raucht und ins Feuer starrt. Er ist wie geschaffen fuer "
    "Hobbits. Gerade noch Zwerge duerften ihn gemuetlich finden. Menschen "
    "und Elfen passen da nicht rein.");
  AddSpecialDetail( ({"holz", "scheiter", "holzscheiter"}), "scheiter");
  AddDetail( ({"pfeifen", "pfeife", "sammlung", "sammeln"}),
    "Das Regal ist voller Pfeifen. Berx hat eine ganze Sammlung davon. "
    "Einige sind gross, rund und bauchig, andere klein und zierlich "
    "geschnitzt.");
  AddDetail( ({"tabak", "tabaksorten", "tabaksorte"}),
    "In den Dosen befinden sich verschiedenste Tabaksorten. Sie wurden "
    "ebenso wie die Pfeifen von ueberall im Silberland zusammengetragen. Du "
    "schnupperst an ein paar und stellst fest, dass sie ausergewoehnlich "
    "gut duften.");
  AddDetail( ({"dose", "dosen", "tabakdose", "tabakdosen"}),
    "In den Dosen befindet sich Tabak. Sie sind alle gut verschlossen, "
    "damit der Tabak nicht ausraucht. Jede Dose ist kunstvoll verziert, "
    "geschnitzt oder getrieben, je nach Material.");
  AddDetail( ({"flasche", "flaschen"}),
    "Im Schrank findest Du einige Flaschen. Du kannst nicht erkennen, was "
    "sich in ihnen befindet, aber es sieht auf jeden Fall sehr gut aus. "
    "Vielleicht laesst Berx Dich ja einmal etwas davon kosten?");
  AddDetail( ({"boden", "erde", "fussboden", "parkettboden"}),
    "Ein wunderschoener Parkettboden. Beim Kamin siehst Du einige "
    "Brandflecken und in der Mitte des Raumes liegt ein schoener Teppich.");
  AddDetail( ({"waende", "wand"}),
    "Waende aus Holz. Ganz normal fuer eine Blockhuette. An einer Wand "
    "haengt ein Bilderrahmen. Interessanterweise ist da kein Bild drin. "
    "Koennte es sein, dass da irgendwann ein Bild seiner Frau reinkommen "
    "sollte?");
  AddDetail( ({"bild", "bilder", "bilderrahmen", "rahmen"}),
    "Der Bilderrahmen ist leer. Komisch. Na ja, Berx wird schon einen "
    "Grund dafuer haben.");
  AddDetail( ({"decke", "holzbalken", "balken"}),
    "Grob gehobelte Holzbalken. Die passen eigentlich gar nicht in dieses "
    "Haus. Berx duerfte sich da nicht viel Muehe gegeben haben.");
  AddDetail( ({"leuchter", "luster"}),
    "Luster? Woher hast Du sowas? Da gibt's nur Kerzen und Fackeln.");
  AddDetail( ({"kerze", "kerzen"}),
    "Einige Kerzen und Fackeln erhellen den Raum.");
  AddDetail( ({"fackel", "fackeln"}),
    "Einige Fackeln und Kerzen spenden dem Raum angenehm beruhigendes "
    "Licht.");
  AddDetail( ({"eck", "ecke"}),
    "In einer Ecke steht eine Truhe.");
  AddDetail( ({"truhe"}),
    "In der Truhe bewahrt Berx wohl die Sachen auf, die er grad nicht "
    "braucht. Die ist wohl privat und geht Dich nichts an.");
  AddDetail( ({"fenster"}),
    "Das Fenster wird durch ein Fensterkreuz in 4 Teile geteilt. "
    "Du schaust aus dem Fenster und siehst einen Garten. Du wuerdest ihn "
    "Dir ja gerne genauer anschauen, aber Du findest keine Tuer. Die muss "
    "Feyaria wohl erst proggen.");
  AddDetail( ({"teppich"}),
    "Ein dicker Teppich liegt etwas unordentlich in der Mitte des Raumes. "
    "Obwohl er an sich nur die Kaelte des Bodens abhalten soll ist er so "
    "weich und angenehm, dass Du Dir vorstellen kannst, dass da auch schon "
    "wer uebernachtet hat, der nach einer beruehmtberuechtigten Berx-Party "
    "nicht mehr nach hause fand.");
  AddDetail( ({"fensterkreuz"}),
    "Ein Fensterkreuz. Genau in der Mitte des Fensters. Da gehoert es auch "
    "hin.");
  AddDetail( ({"kreuz", "holzkreuz"}),
    "Ueber der Tuer haengt ein schlichtes Holzkreuz. Das deutet darauf hin, "
    "dass Berx religioes ist.");
  AddDetail( ({"schrank"}),
    "In dem Schrank befinden sich hinter zwei Glastueren Glaeser und "
    "Flaschen. Alle in Reih und Glied ausgerichtet.");
  AddDetail( ({"reih", "glied"}),
    "Die Glaeser und Flaschen stehen in Reih und Glied.");
  AddDetail( ({"tuer"}),
    "Durch diese Tuer bist Du reingekommen und durch diese Tuer kommst Du "
    "wohl auch wieder raus. Sie ist, wie das meiste an diesem Haus, aus "
    "massivem Holz und mit schoener Schnitzkunst verziert. Neben der Tuer "
    "liegt eine Buerste.");
  AddDetail( ("schluessel"),
    "Mit einem Schluessel koennte man die Tuer aufschliessen. Du findest "
    "hier aber keinen Schluessel. Den hat wohl Berx eingesteckt.");
  AddDetail( ({"bodenklappe", "klappe"}),
    "Unter dem Teppich findest Du eine Bodenklappe. Sie ist nicht zu "
    "oeffnen. Da duerfte Feyaria auch noch was zum anschliessen haben, wenn "
    "Woody einverstanden ist und Berx das proggen darf.");
  AddDetail( ({"buerste"}),
    "Eine ganz eigenartig geformte Buerste. Du betrachtest sie genauer und "
    "stellst fest, dass sie nur fuer Berx' pelzige Fuesse sein kann.");
  AddDetail( ({"raumes"}),
    "Was machst Du da? Fast haettest Du eine Scriptfalle ausgeloest.");
  AddDetail( ({"scriptfalle", "scriptfallen"}),
    "Eine kleine suesse Scriptfalle. Besonders Stahldorn (aber auch Geirk) "
    "werden sich freuen, dass die HIER nur ein Detail ist, das ganz und gar "
    "nicht toedlich ist :).");
  AddDetail( ({"berx", "berxi", "besitzer"}),
    "Das ist das Seherhaus von Berx. Wenn Dich was stoert, dann sag es "
    "Berx. Mit etwas Glueck laedt er Dich ja auf eine Party bei sich ein. "
    "So gesellig, wie er ist, macht er das sicher bald.");
  AddDetail( ({"duft", "luft", "geruch", "gerueche"}),
    "Ein angenehmer Duft umspielt Deine Nase. Leider kannst Du nicht "
    "erkennen, woher er stammt.");
  AddDetail( ({"spaene", "span", "holzspaene", "holzspan", "haufen"}),
    "Ein kleiner Haufen von langen duennen Spaenen. Berx verwendet sie "
    "anscheinend, um seine Pfeifen anzuzuenden. Da Du keine Pfeife und auch "
    "keinen Tabak hast, brauchst Du auch keine Spaene.");
  AddDetail( ({"russfleck", "russflecken"}),
    "Ueber dem Kamin und ueber den Kerzen und Fackeln gibt es dukle "
    "Russflecken. Sie stammen von den Flammen, die andauernd brennen.");
  AddDetail( ({ "musik" }),
    "Leise Musik erfuellt den Raum. Du kannst sie nicht genau erkennen, "
    "aber sie gefaellt Dir. Eigentlich wuerdest Du ja gerne tanzen, aber "
    "dann ueberlegst Du es Dir doch anders.");
  AddDetail( ({"arzt", "aerzte", "doktor", "doktoren"}),
    "Wenn Du einen Arzt brauchst, bist du hier leider falsch. Da musst Du "
    "leider woanders weitersuchen.");
  AddDetail( ({"brandfleck", "brandflecken"}),
    "Am Boden sind Brandflecken. Sie duerften von gluehenden Kohlen "
    "stammen, die aus dem Kamin gefallen sind. Gott sei Dank ist die "
    "Huette dabei nicht abgebrannt.");
  AddDetail( ({"blockhuette" }),
    "Wie Du leicht erkennen kannst, hat Berx sein Haus als Blockhuette "
    "gebaut. Sie Dich um und mach es Dir gemuetlich. Wenn Du dir alles "
    "angeschaut hast und immer noch Fragen hast, wende Dich doch an Berx.");
  AddDetail( ({"bug", "bugs", "fehler", "typo", "typos"}),
    "Was? Hier solls Bugs geben? Nie und nimmer. Wenn Du aber auf Deiner "
    "Behauptung bestehst, dann mail es doch Berx, oder lass es ihn sonst "
    "irgendwie wissen.");
  AddDetail( ({"fuss", "fuesse"}),
    "Jaja. Fuesse hat jeder. Der eine mehr, der andere weniger. Berx hat "
    "sogar zwei ganz wunderbar behaarte Fuesse. Die buerstet er auch "
    "regelmaessig.");
 AddDetail( ({"feyaria"}),
    "Feyaria hat diese Stadt erschaffen. Nur ihr hat Berx es zu verdanken, "
    "dass sein Haus hier stehen kann.");
  AddDetail( ({"glaeser", "glas", "becher"}),
    "Im Schrank stehen einige Glaeser. Die verwendet Berx sicher, wenn er "
    "Gaeste bewirtet. Jetzt stehen sie nur schoen geordnet im Schrank.");
  AddDetail( ({"glastuer", "glastueren"}),
    "Der Schrank hat zwei Glastueren, hinter denen die Glaeser und "
    "Flaschen stehen.");
  AddDetail( ({"gott", "goetter", "woody", "dusty"}),
    "Dusty und Woody sind die Goetter hier im MUD. Wenn Du Probleme hast, "
    "bete zu ihnen. Vielleicht hilft's ja.");
 AddDetail( ({"grund", "gruende"}),
    "Aus welchem Grund Du da bist solltest Du doch selber am Besten "  
    "wissen. Wenn nicht, dann kann ich Dir nur einen Psychiater empfaehlen.");
  AddDetail( ({"garten"}),
    "Der Garten ist hinter dem Haus. Leider findest Du keine Moeglichkeit, "
    "dort hin zu kommen.");
  AddDetail( ({"halbschlaf"}),
    "Das ist Berx' beliebtester Zustand, wenn er sich in seinen Lehnstuhl "
    "setzt.");
  AddDetail( ({"hobbit", "hobbits"}),
    "Berx ist ein Hobbit. Deshalb ist hier auch alles nach Art der Hobbits "
    "eingerichtet. Der Kamin, der Lehnstuhl, alles passt. Trotzdem sind "
    "auch Mitglieder aller anderen Rassen willkommen.");
  AddDetail( ({"kohle", "kohlen", "holzkohle", "holzkohlen",
               "holzkohlenstueck", "holzkohlenstuecke", "kohlenstueck",
               "kohlenstuecke"}),
    "Im Kamin liegen Holzkohlestuecke. Einige duerften vor einiger Zeit "
    "aus dem Kamin gefallen sein und die Brandflecken im Boden verursacht "
    "haben.");
  AddDetail( ({"kalt", "kaelte"}),
    "Hier ist es nicht kalt. Wenn dich friert, bist Du sicher krank und "
    "musst zum Arzt.");
  AddDetail( ({"licht", "lichter", "helligkeit"}),
    "Das meiste Licht hier geben die Kerzen und Fackeln. Auch durch das "
    "Fenster kommt etwas Helligkeit.");
  AddDetail( ({"muehe", "muehen", "arbeit", "arbeiten"}),
    "Berx hat sich fuer sein Domizil wirklich viel Muehe gegeben.");
  AddDetail( ({"problem", "probleme"}),
    "Ich hoffe, Du hast keine Probleme. Wenn doch, und es haengt mit "   
    "diesem Raum zusammen, dann mail es Berx. Sonst kann ich Dir nur "
    "raten, einen guten Psychiater aufzusuchen.");
  AddDetail( ({"psychiater"}),
    "Psychiater? Brauchst Du einen? Nicht in diesem MUD. Sprich Dein "
    "Problem doch auf -a aus, oder rede mit sonst jemanden darueber.");
  AddDetail( ({"party", "parties"}),
    "Berx macht sicher einmal eine Party hier. Wenn Du ihn fragst, laedt "
    "er Dich vielleicht zu einer ein.");
  AddDetail( ({"pfeifenputzer", "putzer"}),
    "Ganz normale Pfeifenputzer. Die verwendet man, um die Pfeifen zu "
    "putzen, nachdem sie geraucht wurden. Es sind so viele da, Du kannst "
    "Dir gar nicht vorstellen, dass die jemals ausgehen.");
  AddDetail( ({"regal", "stellage", "ablage"}),
    "Auf dem Regal findest du viele Pfeifen, einige Pfeifenputzer, "
    "Tabakdosen, ein Pfeifenstopfer und eine Buerste. Ganz auf der Seite "
    "liegt eine kleine Scriptfalle. Alles ist fein saeuberlich "
    "aufgeraeumt. Berx duerfte wirklich sehr auf seine Pfeifen acht geben.");
  AddDetail( ({"sl", "silberland", "mud"}),
    "Du befindest dich derzeit im SilberLand. Dem schoensten MUD weit und "
    "breit.");
  AddDetail( ({"spass", "spaesse"}),
    "Mit Berx kannst Du sicher viel Spass haben. Er ist auf jeden Fall "
    "immer dafuer zu haben.");
  AddDetail( ({"stopfer", "pfeifenstopfer", "werkzeug"}),
    "Ein Pfeifenstopfer ist ein Werkzeug, um den Tabak gut in die Pfeife " 
    "hineinzubringen, damit sie nicht zu heiss brennt.");
  AddDetail( ({"schnitzerei", "schnitzereien"}),
    "Die Schnitzereien faszinieren Dich. Berx muss wohl sehr fleissig und "
    "gewissenhaft gewesen sein, da Du trotz der Feinheit der Schnitzereien "
    "nicht die kleinsten Fehler erkennen kannst.");
  AddDetail( ({"zeit"}),
    "Die Zeit vergeht hier absolut gesehn genauso schnell wie ueberall "
    "sonst auch. Doch wei es Dir hier so gut gefaellt, scheint es Dir, als "
    "ob die Zeit wie im Flug verginge.");
  AddDetail( ({"zwerg", "zwerge"}),
    "Zwerge sind kleine Wesen. Wenigstens von der Groesse sind sie Hobbits "
    "aehnlich. Wohl deshalb finden sie alles hier so gemuetlich.");
    
  AddSmell( ({"tabak"}),
    "Du oeffnest eine Dose und riechst am Tabak. Ein angenehmer Duft, der "
    "Dich leicht an getrocknete Feigen, aber auch an guten, lang gereiften "
    "Whisky erinnert, steigt Dir in die Nase.");
  AddSound( ({ DEFAULT_SOUND, "musik" }),
    "Leise Musik erfuellt den Raum. Du kannst sie nicht genau erkennen, "
    "aber sie gefaellt Dir. Eigentlich wuerdest Du ja gerne tanzen, aber "
    "dann ueberlegst Du es Dir doch anders.");
  AddSmell( ({DEFAULT_SMELL, "duft", "luft", "geruch", "gerueche"}),
    "Ein angenehmer Duft umspielt Deine Nase. Leider kannst Du nicht "
    "erkennen, woher er stammt.");

  AddCmd( ({"leg", "lege"}), "legen");
  AddCmd( ({"such", "suche"}), "suchen");

  AddExit( "raus", "./hauptstrasse3");
  AddExit( "garten", "in den Garten#./berxgarten");
}

int legen(string str)
{
  notify_fail("Was willst Du hier legen?\n");
  if(!str) return 0;
  if( member( ({"scheit nach", "holzscheit nach", "scheit ins feuer",
                "holzscheit ins feuer"}), str)!=-1)
  {
    write("Du legst ein Holzscheit ins Feuer.\n");
    say(CAP(TPN)+ " legt ein Holzscheit ins Feuer.\n");
    call_out("feuer",3);
    return 1;
  }
  return 0;
}

void feuer()
{
  tell_room(TO, "Das Feuer flackert hell auf, als das neue Scheit Feuer "
                "faengt.\n");
}

int suchen(string str)
{
  notify_fail("Was willst Du suchen?\n");
  if(!str) return 0;
  if( member( ({"teppich", "unter teppich", "boden", "am boden", 
                "unterm teppich", "unter dem teppich"}),str)!=-1)
  {
    write("Du suchst den Boden ab und entdeckst eine Bodenklappe unter dem "
          "Teppich.\n");
    say( CAP(TPN)+ " entdeckt etwas unter dem Teppich.\n");
    return 1;
  }
  return 0;
}

string scheiter()
{
  call_out("feuer",4);
  return BS("Unter dem Kamin findest Du einige Holzscheiter. Sie haben "
            "gerade die richtige Groesse fuer den Kamin. Daneben liegen auf "
            "einem kleinen Haufen einige Holzspaene. Da Dir die Scheiter so "
            "gut gefallen, legst Du gleich eines nach.");
}
