// d/huegelland/raballion/hobbits/obj/key.c
// Der Schluessel fuer die Falltuer. 
// 199-01-24 Feyaria@SilberLand

inherit "std/thing";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner, bronzener Schluessel");
  SetProp(P_LONG, 
    "Ein kleiner, bronzener Schluessel. Er ist so klein, dass ihn sicher "
    "nur ein Hobbit richtig in die Hand nehmen kann." );
  SetProp(P_NAME, "Schluessel");
  SetProp(P_NAME_ADJ, ({"klein", "bronzen"}) );
  AddId(({"schluessel", "bronzeschluessel", "\nderlim_falltuer_key"}));
  AddAdjective( ({"kleinen", "kleiner", "bronzener", "bronzener"}) );
  
  SetProp(P_WEIGHT, 70);
  SetProp(P_VALUE, 30);
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, ([MAT_BRONCE:100]) );

}

string QueryDoorKey()
{
  return ROOM+"echsenraum"+":"+ROOM+"wachraum" ;
}

