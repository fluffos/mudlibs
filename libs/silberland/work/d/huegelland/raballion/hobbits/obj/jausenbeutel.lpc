// Ein Jausenbeutel fuer die Hobbits
// 7.6.2002 Feyaria@SilberLand

inherit "/std/container";
#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Ein Jausenbeutel");
  SetProp(P_LONG, 
      "In diesen Jausenbeutel sollte man nur Lebensmittel hineinstecken, "
      "denn nur dazu ist er gedacht.");
  AddId(({"beutel", "jausenbeutel"}));
  SetProp(P_NAME, "Jausenbeutel");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 150);
  SetProp(P_MAX_WEIGHT, 2000);
  SetProp(P_WEIGHT_PERCENT, 30);
  SetProp(P_VALUE, 100);
  SetProp(P_MATERIAL, MAT_LEATHER);
  AddDetail("leder", 
    "Feines Leder das sich weich und angenehm anfuehlt.");
}


varargs int PreventInsert(object ob) 
{
  if( ob->id("Nahrung") )
    return ::PreventInsert(ob); 
  write("In den Jausenbeutel passt nur Nahrung hinein!\n");
  return 1;
}
