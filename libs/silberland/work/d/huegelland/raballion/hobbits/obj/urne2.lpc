inherit "/std/thing";

#include "../def.h"

#include <properties.h>
#include <language.h>
#include <ansi.h>
#include <wizlevels.h>
#define URNDIR "/d/huegelland/raballion/hobbits/obj/wahlen.sav"

mapping dwahllisten;
mapping dwahllisteneintraege;
mixed raete=({"raballion","teqlablu", "nemesis"});

void lies_wahlen();
void schreib_wahlen();

int AnlegenListe(string str);
int AnlegenEintrag(string wstr,mixed lstr);

int LoeschenListe(string str);
int LoeschenEintrag(string wstr,string lstr);

int is_rat();
int is_rasse();

create()
{
  if(!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Wahlurne von Derlim");
  SetProp(P_LONG,
    "Dies ist eine schoene Wahlurne und sie wird von der Stadtverwaltung fuer "
    "verschiedene Wahlen benutzt.\nFuer Ueberflieger eine kleine Funktionsuebersicht:\n"
    "Bisher sind nur Hobbits wahlberechtigt.\n"
    "Ueberall gilt: ein * zeigt die eigene, erteilte Stimme an.\n\n"
    "wwahllisten\n"
    "Damit kann man sich die derzeit enthaltenen Wahllisten anzeigen lassen. "
    "Die Ziffer hinter einer Wahlliste gibt die Anzahl der Eintraege an.\n\n"
    "wwahlliste <wahllistenname>\n"
    "Damit kann man sich die derzeitigen Eintraege einer Liste anzeigen lassen. "
    "Die bisher abgegebenen Stimmen werden angezeigt.\n\n"
    "wwaehle <wahllistenname> <wahlelement>\n"
    "Damit kann man in einer Liste seine Stimme einem Eintrag geben. "
    "Ein * zeigt dies am entsprechenden Eintrag an.\n\n"
    "wentziehe <wahllistenname>\n"
    "Damit entzieht man seine Stimme einer bestimmten Liste.\n\n\n"
    "Mit \"hilfe urne\" erhaelt man eine laengere Hilfe.");

  seteuid(getuid(this_object()));

//  AddDetail(({"" }),
//     "");

  SetProp(P_NAME,"Wahlurne");
  SetProp(P_GENDER,FEMALE);
  AddId( ({"urne", "wahlurne"}) );
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
//  SetProp(P_NEVERDROP, 1);
//  SetProp(P_NODROP, "Du kannst die Urne nicht haben und damit auch nicht ablegen.\n");
  SetProp(P_NOGET, "Du kannst die Urne nicht nehmen, sie ist viel zu wichtig.\n");

  AddCmd( ({"hilfe"}), "helfen");
  AddCmd( ({"wwahllisten"}), "wahllisten");
  AddCmd( ({"wwahlliste"}), "wahlliste");
// nur fuer hobbits und raballion
  AddCmd( ({"wwaehle"}), "waehle");
  AddCmd( ({"wentziehe"}), "entziehe");
// adminfkt
  AddCmd( ({"wanlegen"}), "Anlegen");
  AddCmd( ({"wloeschen"}), "Loeschen");
  AddCmd( ({"wdebug"}), "debug");

  dwahllisten=([]);
  dwahllisteneintraege=([]);

// alle Listen mit Eintraegen und Waehlern einlesen und halten
lies_wahlen();
}

int debug()
{

if (is_rat() != 1)
  return 0;

write ("*************************************************\n");
printf ("dwahllisten: %O\n",dwahllisten);
write ("*************************************************\n");
printf ("dwahllisteneintraege: %O\n",dwahllisteneintraege);
write ("*************************************************\n");
return 1;
}

