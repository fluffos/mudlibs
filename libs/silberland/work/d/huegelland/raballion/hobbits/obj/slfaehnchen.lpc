// /d/huegelland/raballion/hobbits/obj/slfaehnchen.c
// Ein Silberlandfaehnchen
// 1998-02-05  Raballion

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Silberlandfaehnchen");
  SetProp(P_LONG, BS( 
    "Dieses Silberlandfaehnchen traegt die typischen Farben von diesem MUD und "+
    "zeichnet Dich als Fan von Silberland aus. Eine Hilfe hat es auch.") );
  SetProp(P_NAME, "Silberlandfaehnchen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"silberlandfaehnchen", "slfaehnchen", "faehnchen"}));

  SetProp(P_MATERIAL, MAT_MISC_HERBAL );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 20);

  AddDetail( ({"farbe", "farben"}),
    "Die typischen Farben von Silberland.");
  AddDetail( ({"silberland", "sl"}),
    "Silberland? Das ist das MUD hier und Du bist ein Fan davon.");
  AddDetail( ({"mud"}),
    "Das Silberland ist ein MUD.");
  AddDetail( ({"fan"}),
    "Du bist ein Fan von Silberland.");

  AddCmd( ({"hilfe"}), "helfen");
  AddCmd( ({"schwenke"}), "schwenke");

}

int helfen(string str)
{

   notify_fail ("Wozu willst Du Hilfe haben?\n");
   if (! stringp(str)) return 0;

   if ( id(str) == 1)
     {
     write ("Hilfe zum Faehnchen:\n");
     write ("schwenke:\n");
     write (BS("Damit kannst Du das Faehnchen heftig schwenken und Dich als "+
               "echten Fan von Silberland auszeichnen."));
//     write ("\n");
//     write ("fans\n");
//     write (BS("Alle anwesende Fans von Silberland anzeigen."));
     return 1;   
     }
   return 0;
}

int schwenke(string str)
{
int i;

   notify_fail ("Was willst Du schwenken?\n");
   if (! stringp(str)) return 0;
   if ( id(str) == 1)
     {
// 0 neuter, 1 male, 2 female


     say(BS(TP->name(2,2)+" schwenkt das Silberlandfaehnchen wie verrueckt und Du "+
        "sieht sofort die echte Fanzugehoerigkeit von Silberland."));
     write (BS("Du schwenkst das Silberlandfaehnchen wie verrueckt und jeder sieht von "+
        "was Du ein Fan bist."));
     return 1;   
     }
   return 0;
}
