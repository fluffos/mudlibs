inherit "/std/thing";

#include "../def.h"

#include <properties.h>
#include <language.h>
#include <ansi.h>
#include <wizlevels.h>
#define URNDIR "/d/huegelland/raballion/hobbits/obj/"
#define URNDIRWL URNDIR+"*.wahl"

int AnlegenListe(string str);
int LoeschenListe(string str);

int AnlegenEintrag(string wstr,string lstr);
int LoeschenEintrag(string wstr,string lstr);

// int LoeschenRest(string str);

create()
{
  if(!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Wahlurne von Derlim");
  SetProp(P_LONG,
    "Dies ist eine schoene Wahlurne und wird von der Stadtverwaltung fuer "
    "verschiedene Wahlen benutzt. "
    "Mit \"hilfe urne\" erhaelt man eine Hilfe.");

  seteuid(getuid(this_object()));

//  AddDetail(({"" }),
//     "");

  SetProp(P_NAME,"Wahlurne");
  SetProp(P_GENDER,FEMALE);
  AddId( ({"urne", "wahlurne"}) );
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, "Du kannst die Urne nicht haben und damit auch nicht ablegen.\n");

  AddCmd( ({"hilfe"}), "helfen");
  AddCmd( ({"wahllisten"}), "waehll");
  AddCmd( ({"wahlliste"}), "waehlli");
  AddCmd( ({"waehle"}), "waehle");
// adminfkt
  AddCmd( ({"anlegen"}), "Anlegen");
  AddCmd( ({"loeschen"}), "Loeschen");

}

int waehle(string str)
{
string *cmdl;
string *wlisten;
string *llisten;
int i;
int j;


   notify_fail ("Was willst Du waehlen?\n");
   if (! stringp(str)) return 0;

   cmdl = explode(str, " ");
   if ((sizeof(cmdl) == 2) && (strlen(cmdl[0]) > 0))
      {
      wlisten = get_dir(URNDIR+cmdl[0]+".wahl");
      if (sizeof(wlisten) < 1)
         {
         write ("Liste \""+cmdl[0]+"\" existiert nicht.\n");
         return 1;
         }
      write ("Liste \""+cmdl[0]+"\" existiert.\n");

      llisten = get_dir(URNDIR+cmdl[0]+".wahl/"+cmdl[1]+".wahl");
      i = sizeof(llisten);
      if (i == 0)
         {
         write ("Deinen Eintrag \""+cmdl[1]+"\" gibt es in der Wahlliste \""+cmdl[0]+"\" nicht.\n");
         return 1;
         }
      else
         {
         write ("Eintrag \""+cmdl[1]+"\" existiert.\n");
         }
      return 1;
      }

   return 0;
}


int helfen(string str)
{
   notify_fail ("Wozu willst Du Hilfe haben?\n");
   if (! stringp(str)) return 0;
   if (id(str) == 1)
      {
      this_player()->More(OBJ "urne.txt",1);
      return 1;
      }
   return 0;
}

int waehll()
{
string *wlisten;
int i;
int j;
int k;

   wlisten = get_dir(URNDIRWL);
   i = sizeof(wlisten);
   if (i > 0)
      {
      write ("Folgende Wahllisten gefunden:\n");
      for (j = 0; j < i; j++)
         {
         k = strlen(wlisten[j]);
         write ((j+1)+": "+wlisten[j][0..k-6]+"\n");
         }
      return 1;
      }
   else
      {
      write ("Derzeit keine Wahllisten vorhanden.\n");
      return 1;
      }
   return 0;
}

int waehlli(string str)
{
string *llisten;
int i;
int j;
int k;

   notify_fail ("Was willst Du fuer eine Wahlliste haben?\n");
   if (! stringp(str)) return 0;

   llisten = get_dir(URNDIR+str+".wahl/*.wahl");
   i = sizeof(llisten);
   if (i > 0)
      {
      write ("Deine ausgewaehlte Wahlliste hat folgende Eintraege:\n");
      for (j = 0; j < i; j++)
         {
         k = strlen(llisten[j]);
//         write ((j+1)+": "+llisten[j][0..k-6]++"\n");
         write ((j+1)+": "+llisten[j][0..k-6]+" ");
         this_player()->More(URNDIR+str+".wahl/"+llisten[j],1);
         }
      return 1;
      }
   else
      {
      if (i == 0)
         {
         write ("Deine ausgewaehlte Wahlliste hat keine Eintraege.\n");
         }
      else
         {
         write ("Deine ausgewaehlte Wahlliste existiert nicht.\n");
         }
      return 1;
      }


   return 0;
}

int Anlegen(string str)
{
string *cmdl;


   notify_fail ("Kommando ist:\nanlegen liste <Listenname>\n"+
                "anlegen eintrag <Listenname> <Eintragname>\n");
   if (! stringp(str)) return 0;

   cmdl = explode(str, " ");
   if ((sizeof(cmdl) == 2) && (strlen(cmdl[0]) > 0) && (cmdl[0] == "liste"))
      {
      return AnlegenListe(cmdl[1]);
      }
   if ((sizeof(cmdl) == 3) && (strlen(cmdl[0]) > 0) && (cmdl[0] == "eintrag"))
      {
      return AnlegenEintrag(cmdl[1], cmdl[2]);
      }

   return 0;
}

int Loeschen(string str)
{
string *llisten;
int i;
int j;
int k;

string *cmdl;


   notify_fail ("Kommando ist:\nloeschen liste <Listenname>\n"+
                "loeschen eintrag <Listenname> <Eintragname>\n");
   if (! stringp(str)) return 0;

   cmdl = explode(str, " ");
   if ((sizeof(cmdl) == 2) && (strlen(cmdl[0]) > 0) && (cmdl[0] == "liste"))
      {
      return LoeschenListe(cmdl[1]);
//      write ("Zur Zeit nicht moeglich!\n");
//      return 1;
      }
   if ((sizeof(cmdl) == 3) && (strlen(cmdl[0]) > 0) && (cmdl[0] == "eintrag"))
      {
      return LoeschenEintrag(cmdl[1], cmdl[2]);
      }

   return 0;
}



int AnlegenListe(string str)
{
string *wlisten;

// *******************************************************
// nachschauen ob es diese liste nicht schon gibt!
// *******************************************************
   wlisten = get_dir(URNDIR+str+".wahl");
   if (sizeof(wlisten) >= 1)
      {
      write ("Liste \""+str+"\" existiert schon.\n");
      return 1;
      }
   else
// *******************************************************
// liste anlegen, falls moeglich
// *******************************************************
      {
      if (mkdir(URNDIR+str+".wahl") == 1)
         {
         write ("Liste \""+str+"\" wurde angelegt.\n");
         }
      else
         {
         write ("Liste \""+str+"\" kann nicht angelegt werden!.\n");
         }
      return 1;
      }
   return 0;
}


int LoeschenListe(string str)
{
string *wlisten;
string *llisten;
int i;
int j;
int k;

// *******************************************************
// nachschauen ob es diese liste ueberhaupt gibt!
// *******************************************************
   wlisten = get_dir(URNDIR+str+".wahl");
   if (sizeof(wlisten) < 1)
      {
      write ("Liste "+str+" existiert nicht.\n");
      return 1;
      }
   else
// *******************************************************
// liste loeschen, falls moeglich ( == leer)
// *******************************************************
      {
      llisten = get_dir(URNDIR+str+".wahl/*.wahl");
      i = sizeof(llisten);
      if (i > 0)
         {
         write ("Deine ausgewaehlte Wahlliste ist nicht leer.\n");
         return 1;
         }
      else
         {
         if (rmdir(URNDIR+str+".wahl") == 1)
            {
            write ("Wahlliste "+str+" wurde geloescht.\n");
            }
         else
            {
            write ("Wahlliste "+str+" kann nicht geloescht werden!.\n");
            }
         return 1;
         }
      }
   return 0;
}

int AnlegenEintrag(string wstr,string lstr)
{
string *llisten;
int i;

   llisten = get_dir(URNDIR+wstr+".wahl/"+lstr+".wahl");
   i = sizeof(llisten);
   if (i > 0)
      {
      write ("Deinen Eintrag \""+lstr+"\" gibt es schon in der Wahlliste \""+wstr+"\".\n");
      return 1;
      }
   else
      {
      if (write_file(URNDIR+wstr+".wahl/"+lstr+".wahl","0\n") == 1)
         {
         write ("Eintrag \""+lstr+"\" in der Wahlliste \""+wstr+"\" angelegt.\n");
         return 1;
         }
      else
         {
         write ("Eintrag \""+lstr+"\" in der Wahlliste \""+wstr+"\" misslungen!\n");
         return 1;
         }
      }
}



int LoeschenEintrag(string wstr,string lstr)
{
string *llisten;
int i;

   llisten = get_dir(URNDIR+wstr+".wahl/"+lstr+".wahl");
   i = sizeof(llisten);
   if (i == 0)
      {
      write ("Deinen Eintrag \""+lstr+"\" gibt es in der Wahlliste \""+wstr+"\" nicht.\n");
      return 1;
      }
   else
      {
      if (rm(URNDIR+wstr+".wahl/"+lstr+".wahl") == 1)
         {
         write ("Eintrag \""+lstr+"\" in der Wahlliste \""+wstr+"\" geloescht.\n");
         return 1;
         }
      else
         {
         write ("Loeschen von Eintrag \""+lstr+"\" in der Wahlliste \""+wstr+"\" misslungen!\n");
         return 1;
         }
      }

return 0;
}
