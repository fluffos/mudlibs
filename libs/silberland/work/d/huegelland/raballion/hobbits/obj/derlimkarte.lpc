mapping getcolors() {
  return ([
/*
    0x66:ANSI_RED+ANSI_INVERS,    // Gilde
    0x68:ANSI_PURPLE+ANSI_BOLD,   // Kirche
    0x74:ANSI_RED,                // Post
    0x54:ANSI_RED,                // Kapelle
    0x34:ANSI_BLUE,               // Kneipe
    0x44:ANSI_BLUE,               // Kneipesaal
    0x64:ANSI_GREEN,              // Laden
    0x62:ANSI_GREEN,              // Kramladen
    0x52:ANSI_GREEN+ANSI_BOLD,    // Waffenexperte
    0x72:ANSI_BLUE,               // Kneipe
    0x32:ANSI_GREEN,              // 4gw-Raum
    0x33:ANSI_YELLOW+ANSI_BOLD    // Bank
*/
  ]);
}

mapping gethilite() {
  return ([
/*
    0x66:ANSI_INVERS,             //  Gilde
    0x74:ANSI_UNDERL,             //  Post
    0x54:ANSI_UNDERL              //  Kapelle
*/
  ]);
}

string *getmap() {
  return ({
"                             *** DERLIM ***                           ",
"                                                                      ",
"                           (Strandweg, Moor)                          ",
"                                   |                                  ",
"                      Wachraum--Nordtor--Wachraum                     ",
"                                   |                                  ",
"                 o-----o-----o-----o-----o-----o-----o                ",
"                 |                 |                 |                ",
"                 o                 o                 o                ",
"                 |                 |                 |                ",
"        Wachraum o         Post    o Rathaus Laden   o Wachraum       ",
"           |     |           |     |     |     |     |     |          ",
"        Westtor--o-----o-----o-----o-----o-----o-----o---Osttor       ",
"                 |     |     |     |           |     |                ",
"                 o  Kneipe Kapelle o     o-----o     o                ",
"                 |                 |     |           |                ",
"                 o--Alchem         o     o-----o     o                ",
"                 |                 |           |     |                ",
"                 o-----o-----o-----o-----o-----o-----o                ",
"                                   |                                  ",
"                      Wachrraum--Suedtor                              ",
"                                   |                                  ",
"                               (Weinberg)                             ",
"                            (fuer Anfaenger)                          ",
"                                                                      ",
""});
}


string long() {
  string *map,fn,term;
  mapping pos,cols;
  int x,x1,x2,y,i,j;
  
  map=getmap()[0..];
  if (!TP) return implode(map,"\n");

  term=TP->QueryProp(P_TTY);
  switch(term) {
    case "ansi":  cols=getcolors(); break;
    case "vt100": cols=gethilite(); break;
    default:;
  }

  // Position des Spielers eintragen
  if (environment(TP)) {
    pos=getpos();
    fn=file_name(environment(TP));
    if (fn[0..36]=="/d/huegelland/raballion/hobbits/room/") fn=fn[37..];
    x=pos[fn,0];y=pos[fn,1];
    if (x||y) {
      if (mappingp(cols)) {
        switch(term) {
          case "ansi":  cols[16*x+y]=ANSI_RED+ANSI_BOLD; break;
          case "vt100": cols[16*x+y]=ANSI_BOLD; break;
          default:;
        }
      }
      if (((x==6) || (x==7)) && (y==4)) x=x*6+6;
      else if ((x=x*6+5) > 60) x=60;
      if ((y*=2) > 20) y=20;

#define IS_LETTER(c) ( (((c&223)>='A') && ((c&223)<='Z')) || \
    ((c>='0') && (c<='9')) )

      x1=x; while (IS_LETTER(map[y][x1])) map[y][x1--]=' ';
      x2=x+1; while (IS_LETTER(map[y][x2])) map[y][x2++]=' ';
      map[y][x-2..x+2]="HIER!";
    }
  }

/*
  // Karte einfaerben:
  if (mappingp(cols))
     {
     for (i=10;i>=0;i--)
        {
        y=2*i;
        for (j=10;j>=0;j--)
           {
           // x=6*j;
           x=6*j+5;
           x2=x;
           while(IS_LETTER(map[y][x])) x--;
           while (IS_LETTER(map[y][x2])) x2++;
           if (map[y][x2]=='!') x2++;
           if (fn=cols[16*j+i])
              {
              map[y]=
              map[y][0..x]+
              fn+map[y][(x+1)..(x2-1)]+ANSI_NORMAL+
              map[y][x2..];
              }
           }
        }
     }
*/  
  return implode(map,"\n");
}

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  SetProp(P_SHORT,"Eine Karte von Derlim");
  SetProp(P_NAME,"Karte");
  SetProp(P_GENDER,FEMALE);
  AddId(({"karte", "derlimkarte", "derlimplan", "stadtplan", "plan"}));
  AddCmd ("lies", "lies");
  SetProp(P_WEIGHT,20);
  SetProp(P_VALUE,0);
  SetProp(P_MATERIAL, MAT_PAPYRUS);
}

int lies(string str)
{
  if (!str || str=="" || !id(str)) return 0;
  write(long());
  return 1;
}

try_remove() {
  if (!environment() || !living(environment())) {
    if (environment())
      tell_room(environment(),"Eine Karte loest sich auf.\n");
    remove();
  }
}

move(dest,meth) {
  mixed res;
  
  while (remove_call_out("try_remove")!=-1) ;
  res=::move(dest,meth);
  if (!environment() || !living(environment()))
    call_out("try_remove",30);
  return res;
}
