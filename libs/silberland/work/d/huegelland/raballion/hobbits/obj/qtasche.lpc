//
// Update

*/

inherit "std/container";

#include <properties.h>

string owner;

create()
{
  ::create();
  AddId (({"tasche", "ledertasche", "qtasche"}));
  SetProp (P_SHORT, "Eine Tasche");
  SetProp (P_LONG, "Eine einfache Ledertasche, "+
                   "damit lassen sich sicher gut Weinbergschnecken suchen.\n");
  SetProp (P_NAME, "Tasche");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_MAX_WEIGHT, 150);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 5);
  SetProp (P_NOBUY, 1);

}

set_owner(arg)
{
  return owner = arg;
}

query_owner()
{
  return owner;
}
