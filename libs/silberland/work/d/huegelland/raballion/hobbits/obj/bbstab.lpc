inherit "/std/thing";


#include "../def.h"

#include <properties.h>
#include <language.h>
#include <ansi.h>
#include <wizlevels.h>
#include <moving.h>

#define NEED_PROTOTYPES

#define pddeb(x) if (find_player("raballion")) tell_object(find_player("raballion"),(x))

create()
{
  if(!is_clone(this_object()))
    return;
  ::create();

  seteuid(getuid(this_object()));

  SetProp(P_SHORT, "Der Buergermeisterstab von Derlim");
  SetProp(P_LONG,
    "Der Buergermeisterstab von Derlim ist aus reich verziertem Holz hergestellt und ist "+
    "das Amtszeichen der Stadtverwaltung. Mit \"hilfe stab\" erhaelt man eine Hilfe.");


  AddDetail(({ "verzierung", "symbole", "symbol", "verzierungen" }),
     "Verzierungen und Symbole verschiedenster Art von Hobbitmeisterhand "+
     "befinden sich auf dem Stab.");
  AddDetail(({ "stab", "buergermeisterstab" }),
     "Er ist das Amtszeichen des Buergermeisters von Derlim.");

 SetProp(P_INFO, BS(
        "Wenn du diesen Stab in Haenden haelst und nicht zur Stadtverwaltung "+
        "gehoerst, hat Raba etwas falsch gemacht!"));
  SetProp(P_NAME,"Buergermeisterstab");
  SetProp(P_GENDER,MALE);
  AddId( ({"stab", "bbstab"}) );
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, "Du wuerdest den Buergermeisterstab niemals hergeben.\n");
  AddCmd( ({"hilfe"}), "helfen");
  //AddCmd( ({"volk"}), "hobbits");
  //AddCmd( ({"anwesende"}), "anwesend");
  AddCmd( ({"karte"}), "karte");
  //AddCmd( ({"bewohner"}), "bewohner");
  //AddCmd( ({"npc"}), "npc");


}

int helfen(string str)
{
  if (! stringp(str)) return 0;
  if (lower_case(str)=="stab")
        {
          TP->More(read_file(OBJ "bstab.txt"));
//          this_player()->More(OBJ "bstab.txt",1);
          return 1;
        }
  return 0;
}



