int hobbits(string str)
{
  object *ulist;

  int i,a;
  ulist = users();
  a = sizeof(ulist);
  write ("Zur Zeit sind folgende Hobbits in Silberland:\n");
  for (i=0; i < a; i++)
    {
    if (ulist[i]->QueryProp(P_RACE) == "Hobbit")
      {
      write ("Name: " + (string) ulist[i]->QueryProp(P_NAME)+"\n" );
      }
    }
  return 1;
}

int anwesend(string str)
{
  object *ulist;
  
  int i,a;
  ulist = users();
  a = sizeof(ulist);
  write ("Zur Zeit befinden sich in Derlim:\n");
  for (i=0; i < a; i++)
    {
    if (((string)environment(ulist[i]))[0..36] == "/d/huegelland/raballion/hobbits/room/")
      {
      write ("Name: " + (string) ulist[i]->QueryProp(P_NAME)+"      " );
      write (environment(ulist[i])->QueryProp(P_INT_SHORT)+"\n");
      }
    }

  write ("\nZur Zeit befinden sich im Park:\n");
  for (i=0; i < a; i++)
    {
    if (((string)environment(ulist[i]))[0..37] == "/d/huegelland/raballion/weinberg/room/")
      {
      write ("Name: " + (string) ulist[i]->QueryProp(P_NAME)+"\n" );
      }
    }
  return 1;
}

int bewohner(string str)
{

  write ("Diese Funktion ist zur Zeit nicht in Betrieb.\n");

  return 1;
}


