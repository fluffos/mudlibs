int karte(string str)
{
  string *map,fn,term;
  mapping pos,cols;
  int x,x2,y,i,j;
  
  map=getmap()[0..];
//  if (!TP) return implode(map,"\n");

  term=TP->QueryProp(P_TTY);

  // Position des Spielers eintragen
  if (environment(TP))
    {
    pos=getpos();
    fn=file_name(environment(TP));
    if (fn[0..36]=="/d/huegelland/raballion/hobbits/room/") fn=fn[37..];
    if (fn[0..37]=="/d/huegelland/raballion/weinberg/room/") fn=fn[38..];
    if (fn[0..25]=="/d/wasser/stahldorn/quest/") fn=fn[26..];
    if (fn[0..35]=="/d/huegelland/orw/pfeifenladen/room/") fn=fn[36..];
    if (fn[0..18]=="/gilden/abenteurer/") fn=fn[19..];
    x=pos[fn,0];y=pos[fn,1];
    if (x||y)
      {
      if (mappingp(cols))
        {
	switch(term)
          {
	  case "ansi":  cols[16*x+y]=ANSI_RED+ANSI_BOLD; break;
	  case "vt100": cols[16*x+y]=ANSI_BOLD; break;
	  default:;
	  }
        }
      x*=7;if (x>60) x=70;
      y*=3;if (y>38) y=38;
      if (map[y][x+1]!='-') map[y][x+1]=' ';
      if (map[y][x+7]!='-' && map[y][x+7]!='G') map[y][x+7]=' ';
      map[y]=map[y][0..(x+1)]+"HIER!"+map[y][(x+7)..];
      }
    }

#define IS_LETTER(x) (((x&223)>=65) && ((x&223)<=90))

  // Karte einfaerben:
  if (mappingp(cols))
    {
    for (i=10;i>=0;i--)
      {
      y=2*i;
      for (j=10;j>=0;j--)
        {
	// x=6*j;
	x=7*j+3;
	while(IS_LETTER(map[y][--x]));
	x2=x; while (IS_LETTER(map[y][++x2]));
	if (fn=cols[16*j+i])
          {
	  map[y]=map[y][0..x]+fn+map[y][(x+1)..(x2-1)]+ANSI_NORMAL+map[y][x2..];
	  }
        }
      }
    }
  write (implode(map,"\n"));

  return 1;
}

