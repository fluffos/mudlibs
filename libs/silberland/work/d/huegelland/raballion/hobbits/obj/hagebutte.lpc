// Eine Hagebutte
// 1997-11-02  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Hagebutte");
  SetProp(P_LONG, BS( 
    "Aus dieser Hagebutte kann man vielleicht Hagebuttentee machen.") );
  SetProp(P_NAME, "Hagebutte");
  SetProp(P_GENDER, FEMALE);
  AddId("hagebutte");

  SetProp(P_MATERIAL, MAT_MISC_HERBAL );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);

}
