// Messingschild
// 1997-11-02 Feyaria@SilerLand

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"schild","messingschild"}));
  SetProp (P_SHORT, "Ein Messingschild");
  SetProp (P_LONG,
    "Ein sehr einfacher Schild, der aus Messing gefertigt wurde.\n");
  SetProp (P_NAME, "Messingschild");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 200);
  SetProp (P_VALUE, 500);

  SetProp (P_ARMOUR_TYPE, AT_SHIELD);   // siehe sys/combat.h
  SetProp (P_AC, 12+random(5));         // 12..16

  SetProp (P_MATERIAL, MAT_BRASS);
}

