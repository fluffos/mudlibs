// Beinschienen aus Messing fuer Hobbitbuettel 
// 1997-11-02  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Beinschienen aus Messing");
  SetProp(P_LONG, BS( 
    "Diese Beinschienen aus Messing schuetzen die Beine vor Schlaegen.") );
  SetProp(P_INFO, BS(
    "Die Beinschienen sind fuer Proportionen von Hobbits angefertigt."));
  SetProp(P_NAME, "Beinschienen");
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 4+random(4));
  SetProp(P_MATERIAL, MAT_BRASS );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 700);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE:({"Hobbit"})]) );

  AddId( ({"beinschienen", "messingbeinschienen"}) );
  
}

