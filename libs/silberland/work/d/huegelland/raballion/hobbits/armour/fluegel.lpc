// d/huegelland/raballion/hobbits/obj/fluegel.c
// Die Fluegel des Bronzedrachens
// 1999-01-24 Feyaria@SilberLand
// 2004-01-26 Verelgt nach armour und zu AT_CLOAK gemacht

inherit "std/armour";

#include "../def.h"

int flying;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Die Fluegeln eines Bronzedrachen");
  SetProp(P_LONG, 
    "Die riesigen Fluegel eines Bronzedrachen. Sie sind ueber 10 Meter "
    "lang und sehr stabil. Trotzdem sind sie fuer ihre enormen Ausmasse "
    "ueberraschend leicht.");
  SetProp(P_NAME, "Drachenfluegeln");
  SetProp(P_PLURAL, 1);
  AddId(({"fluegel", "drachenfluegel", "bronzedrachenfluegel"}));
  SetProp(P_INFO, BS("Ob man mit diesen Fluegeln fliegen kann?\n") );
 
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 9);
  SetProp(P_QUALITY_DECAY, 500);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 3000);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([MAT_SKIN:100]) );
  SetProp(P_WEAR_FUNC, TO);
  SetProp(P_REMOVE_FUNC, TO);

  AddCmd( ({"fliege", "flieg"}), "fliegen");
}

int fliegen( string str )
{
  string was;
  notify_fail("Mit was willst Du fliegen?\n");
  if( !str ) return 0;
  if( sscanf(str, "mit %s", was)!=1 ) return 0;
  if( !id(was) ) return 0;
  if( !QueryProp(P_WORN) )
    return write("Dazu musst Du die Fluegeln schon anziehen!\n"), 1;
  if( ENV(TP)->QueryProp(P_INDOORS) )
    return write("Du musst schon im Freien sein, um zu fliegen.\n"),1;
  write("Du nimmst die Fluegel in die Hand und fliegst sofort davon.\n");
  TP->move( ROOM "hauptplatz", M_TPORT, "Drachenfluegel in die Hand "
      "und fliegt davon", "nimmt", 
      "landet hier mit Hilfe von grossen Drachenfluegeln");
  write("Die Drachenfluegel loesen sich nach diesem Flug auf.\n");
  remove();
  return 1;
}

int WearFunc(object ruest, int silent)
{
  if(!MENV->is_class_member(CL_FLYING))
  {
    flying = 1;
    MENV->AddClass(CL_FLYING);
    tell_object(MENV, 
        "Mit Hilfe der Drachenfluegel kannst Du nun fliegen!\n");
  }
  return 1;
}

int RemoveFunc(object ruest, int silent)
{
  if(flying)
  {
    QueryProp(P_WORN)->RemoveClass(CL_FLYING);
    flying = 0;
  }
  return 1;
}
