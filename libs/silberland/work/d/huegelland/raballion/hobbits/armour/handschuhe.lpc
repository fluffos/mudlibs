// mit Messing verstaerkte Handschuhe
// 1997-11-02 Feyaria@SilerLand

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"handschuhe","lederhandschuhe", "messinghandschuhe"}));
  SetProp (P_SHORT, "Ein Paar mit Messing verstaerkte Lederhandschuhe");
  SetProp (P_LONG, 
    "Ein Paar Handschuhe aus feinstem Leder, das mit Messingplaettchen "
    "verstaerkt wurde. Sie sind aber so klein, das wohl nur ein Hobbit "
    "sie anziehen kann.\n");
  SetProp (P_NAME, "Paar Messinghandschuhe");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 150);
  SetProp (P_VALUE, 800);

  SetProp (P_ARMOUR_TYPE, AT_GLOVE);  // siehe sys/combat.h
  SetProp (P_AC, 7);
  SetProp (P_MATERIAL, ([MAT_LEATHER:70, MAT_BRASS:30]) );
  SetProp (P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE: ({"Hobbit"}) ]) );
}

