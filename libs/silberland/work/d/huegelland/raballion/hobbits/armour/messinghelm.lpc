// Messinghelm 
// 1997-11-02 Feyaria@SilerLand 

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"helm", "messinghelm"}));
  SetProp (P_SHORT, "Ein Messinghelm");
  SetProp (P_LONG,
    "Dieser einfache Messinghelm schuetzt den Kopf.\n");
  SetProp (P_INFO,
    "Der Messinghelm ist ideal an die Kopfform von Hobbits angepasst.\n");
  SetProp (P_NAME, "Messinghelm");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 500);
  SetProp (P_VALUE, 340);

  SetProp (P_ARMOUR_TYPE, AT_HELMET);  // siehe sys/combat.h
  SetProp (P_AC, 5);

  SetProp (P_MATERIAL, MAT_BRASS);
  SetProp (P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE: ({"Hobbit"}) ]) );
}

