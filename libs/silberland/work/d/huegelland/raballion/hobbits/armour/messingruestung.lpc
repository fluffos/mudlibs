// Messingruestung
// 1997-11-02 Feyaria@SilerLand

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"ruestung","messingruestung"}));
  SetProp (P_SHORT, "Eine Messingruestung");
  SetProp (P_LONG,
    "Die Messingruestung schuetzt ihren Traeger vor leichteren Schlaegen.\n");
  SetProp (P_INFO,
    "Die Messingruestung ist ideal an die Koerperform von Hobbits angepasst.\n");
  SetProp (P_NAME, "Messingruestung");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 1000);
  SetProp (P_VALUE, 500);

  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);  // siehe sys/combat.h
  SetProp (P_AC, 21);

  SetProp (P_MATERIAL, MAT_BRASS);
  SetProp (P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE: ({"Hobbit"}) ]) );
}


