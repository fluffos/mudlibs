// Echsenhaut 
// 1997-11-02 Feyaria@SilerLand

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"echsenhaut","haut"}));
  SetProp (P_SHORT, "Eine Echsenhaut");
  SetProp (P_LONG, 
    "Die Haut einer Kampfechse ist sehr strapazierfaehig. Ihre gruenen "
    "Schuppen glitzern im Sonnenlicht.");
  SetProp (P_INFO,
    "Angeblich schuetzt die Haut von Echsen gegen Feuer und Wasser.\n");
  SetProp (P_NAME, "Echsenhaut");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 350);
  SetProp (P_VALUE, 800);

  SetProp (P_ARMOUR_TYPE, AT_CLOAK);  // siehe sys/combat.h
  SetProp (P_AC, 6);
  SetProp (P_MATERIAL, ([MAT_SKIN:100]) );
  SetProp (P_QUALITY_DECAY, 250);
  AddProp (P_DAM_PROTECTION, ([DT_FIRE:1, DT_WATER:1]) );
  SetProp (P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:0, T_HEAT_PROT:2]) );
}

