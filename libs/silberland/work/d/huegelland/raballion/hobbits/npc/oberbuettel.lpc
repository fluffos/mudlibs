// Der Oberbuettel von Derlim 
// 1999-03-03 Feyaria@SilerLand

inherit "std/mnpc";
inherit "std/npc/spells";

#include "../def.h"
#include <mnpc.h>

void init()
{
  ::init();
  if (TP && TP->id("HOBBIT")) AddDefender(TP);
}

create()
{
  object ob;

  if (!is_clone(this_object())) return;  
  ::create();
    
  SetProp (P_SHORT, "Bingo, der Oberbuettel");
  SetProp (P_LONG,
    "Bingo, der Oberbuettel von Derlim, ist fuer einen Hobbit von erstaunlich "
    "kraeftiger Statur. Er ist in frisch polierte Messingruestung gekleidet "
    "und schwingt seinen Stab mit der Kampferfahrung vieler Jahre."); 

  SetProp (P_NAME, "Oberbuettel Bingo");
  set_living_name("bingo");
  SetProp (P_GENDER, MALE);
  AddId ( ({"wache", "buettel", "hobbit", "hobbitbuettel", "oberbuettel",
            "bingo", "oberbuettel bingo", "\nbingo", "HOBBIT"}) );
  SetProp (P_ARTICLE, 0);

  create_default_npc(30);
  SetProp (P_XP, QueryProp(P_XP) + 4000*100 );
  SetProp (P_ALIGN, 80+random(30));
  SetProp (P_SIZE, 90+random(20));
  SetProp (P_RACE, "Hobbit");
  SetProp (P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_TERROR    : -0.1, DT_MAGIC     : -0.1, 
    DT_SOUND     :  0.2, DT_LIGHTNING :  0.1, DT_POISON    :  0.1 ]) );
  
  SetProp (P_MSGOUT, "mustert Dich noch einmal und geht# weiter");
  SetProp (P_MSGIN, "kommt an und mustert Dich pruefend");
  SetProp (P_MNPC_AREA, ROOM );
  SetProp (P_MNPC_WAIT, ({ 10+random(20), 60, 120 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM "wachraum" );
//  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES);
// Besser der bleibt im wachraum stehen  
  
  SetProp(P_SPELLRATE, 50);
  AddSpell(3, 222, 
    "Oberbuettel Bingo gibt Dir einen Fusstritt.\n",
    "Oberbuettel Bingo gibt @WEM einen Fusstritt.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(3, 333, 
    "Oberbuettel Bingo bohrt seinen Stab in Dein Knie.\n",
    "Oberbuettel Bingo bohrt seinen Stab in @WESSEN Knie.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(2, 555, 
    "Oberbuettel Bingo laesst Deinen Kopf explodieren.\n",
    "Oberbuettel Bingo laesst @WESSEN Kopf explodieren.\n",
    DT_EXPLOSION, ([SP_SHOW_DAMAGE:1]) );
  AddSpell(2, 666, 
    "Oberbuettel Bingo schlaegt Dir mit seinem Stab auf die grosse Zehe.\n",
    "Oberbuettel Bingo schlaegt @WEM mit seinem Stab auf die grosse Zehe.\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]) );
  AddDefaultSpell(2, 444, DS_DISARM,
    "Oberbuettel Bingo trifft mit seinem Stab genau Deine Waffenhand.\n", 
    "Oberbuettel Bingo wendet seinen beruehmten Entwaffnungsschlag an.\n");  
  AddSpell(1, 1, 
    "Oberbuettel Bingo ruft eine Kampfechse zu Hilfe.\n",
    "Oberbuettel Bingo ruft eine Kampfechse zu Hilfe.\n",
    DT_ELECTRIC, "echsen_ruf");
  

  SetProp( P_REJECT, ({ REJECT_GIVE,
   "Oberbuettel Bingo sagt: Ich bin nicht bestechlich!\n" }) );

  SUID;

  ob = CLONEOB ("/obj/money");
  ob->SetProp(P_AMOUNT, 100+random(45)*10);
  ob->move(ME);
  CLONEME (OBJ "key");
  if( random(100) < 30 ) CLONEME("/p/armour/ring/ring");
  if( random(100) < 30 ) CLONEME("/p/armour/amulet/amulett");
  if( random(100) < 50 ) CLONEME("/p/armour/trousers/messingbeinschienen");
  if( random(100) < 50 ) CLONEME("/p/armour/bracers/messingarmschienen");
  if( random(100) < 50 ) CLONEME(ARMOUR "handschuhe");
  if( random(100) < 50 ) CLONEME(ARMOUR "messinghelm");
  CLONEME ( "/p/armour/armour/messingruestung");
  CLONEME ( "/p/armour/shield/messingschild");
  command ("trage alles");
  if (!random(4))
  {
    CLONEME (WEAPON "buettelspeer");
    command ("zuecke speer");
  }
  else
  {
    CLONEME (WEAPON "stab");
    command ("zuecke stab");
  }

  SetProp (P_DIE_MSG, " stirbt im Dienst fuer Derlim.\n");
  SetProp (P_DEFAULT_INFO,
      "sagt: Dumme Fragen beantworte ich nicht!");


// standart infos fuer anfaenger und sonstige frager
  AddLibrary( NPC "infos.lib", 1);

  AddInfo ("bingo", "nickt.\n");
  AddInfo ( "oberbuettel",
    "Ich bin der Oberbuettel von Derlim und sorge hier fuer Recht und "
    "Ordnung.", "sagt stolz: ");
  AddInfo( ({"schluessel", "falltuerschluessel"}),
    "Der Schluessel geht Dich gar nichts an!", "schnaubt: ");
  AddInfo( ({"falltuer", "falltuere"}),
    "Die Falltuere fuehrt zum Schlafraum der Kampfechsen. Dort hast Du "
    "nichts zu suchen, also brauchst Du auch keinen Schluessel.",
    "sagt streng: ");
  AddInfo (({"wache", "wachen", "buettel"}),
    "Ja wir Buettel achten auf Ruhe und Ordnung hier in Derlim. "+
    "Mach also keinen Mist oder lass Dich dabei erwischen.", "sagt: ");
  AddInfo (({"kampfwache", "kampfechse", "kampfwachen", "kampfechsen"}),
    "Die haben wir uns wegen den haeufigen Seherueberfaellen zugelegt "+
    "und sind gar nicht so billig. "+
    "Irgendwie muessen wir uns ja schuetzen.", "sagt: ");
  AddInfo (({"ruhe", "ordnung"}),
    "Fuer Ruhe und Ordnung in Derlim sind wir Wachen zustaendig.", 
    "sagt stolz: ");
  AddInfo (({"mist", "dreck"}),
    "Damit meinte ich eigentlich Du sollst keinem auf die Nerven gehen "+
    "und niemanden angreifen. Vor allem keinen anderen Spieler.", 
    "sagt aergerlich: ");
  AddInfo (({"seher"}),
    "Wenn Du mehr ueber Seher wissen willst, dann tippe doch einfach: "+
    "hilfe seher ein.", "sagt belehrend: ");
  AddInfo (({"seherueberfaelle"}),
    "Diese Seher kommen immer hier rein und hauen alles um, aber dagegen haben "
    "wir uns ein paar Kampfechsen kommen lassen von \"Meckermann\". "+
    "Die sind nicht schlecht und essen nicht viel.", "sagt: ");
  AddInfo (({"meckermann"}),
    "Fuer naeheres musst Du die Stadtverwaltung fragen. Die haben uns diese "+
    "Kampfechsen besorgt und wissen sicher auch die genaue Bestellnummer.",
    "sagt: ");
  AddInfo (({"bestellnummer", "bestellnummern", "nummer", "nummern", "bestellen"}),
    "Woher soll ich das wissen, dafuer haben wir doch die Stadtverwaltung.",
    "sagt: ");
  SetProp(P_LOG_INFO, "raballion/bingo");

}

void InformDefend(object enemy)
{
  if( !InFight() )
  {
    tell_room(MENV, "Oberbuettel Bingo greift in den Kampf ein.\n");
    Kill(enemy);
  }
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( gruppe=="fies" && random(2) )
    call_out("kill",2+random(4));
  if( gruppe=="fies")
    call_out("fies",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  command_me("sag Lass das!");
}

void kill()
{
  if( IS_LEARNING(TP) )
    command_me("sag Wenn Du kein Magier waerest, wuerde ich Dich jetzt "
               "toeten, "+TPN+"!"); 
  else
    Kill(TP);
}

#define ECHSENNAMEN ({"Zisss", "Wisss", "Visss", "Tisss", "Risss", \
                      "Nisss", "Lisss" })

void echsen_ruf()
{
  object ob;
  if( present("kampfechse 4", ENV(TO)) ) return;
  ob=clone_object( NPC "echse");
  ob->move(ENV(TO), M_TPORT);
  ob->SetProp(P_NAME, ECHSENNAMEN [random(sizeof(ECHSENNAMEN))] );
}

varargs void die(int poisondeath)
{
  object spieler, ob;
  spieler=QueryProp(P_KILLER);
  if (spieler && (ob = present("\nzechpreller_quest_11", spieler)))
    ob->Mark();
  ::die(poisondeath);
}

