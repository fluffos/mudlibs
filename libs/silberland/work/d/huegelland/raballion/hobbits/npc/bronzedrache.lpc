// Der Wasserdrache
// 1998-10-29 Feyaria@SilberLand

#include "../def.h"

inherit "/p/std/dragons/dragon";
inherit "/std/npc/spells";
#include <mnpc.h>

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();

  create_default_dragon(2,9,1,20+random(15));
  SetProp(P_SHORT, 
    "Grukkolipovzillfurx, ein alter Bronzedrache");
  SetProp(P_LONG, 
    "Vor Dir steht ein gewaltiger Drache mit bronzefarbenen Schuppen. "
    "Auf dem relativ kurzen Hals sitzt ein gewaltiger Kopf mit zwei spitzen "
    "Hoernern. Grosse Luftwirbel kommen aus seinen riesiegen Nuestern. "
    "Obwohl das Maul voller scharfer Zaehne ist, laechelt Dich der Drache "
    "doch an. Auf dem gewaltigen Koeper befinden sich zwei Paar riesige "
    "Fluegel, ein Hinweis, dass sich Bronzedrachen in der Luft wohler "
    "fuehlen als auf der Erde. Der Koerper laeuft in einen langen Schwanz "
    "mit einer schwertaehnlichen Hornspitze aus. Du zitterst vor Ehrfurcht "
    "vor dieser gewaltigen Kreatur."); 
  SetProp(P_NAME, "Grukkolipovzillfurx");
  AddId( ({"grukkolipovzillfurx", "bronzedrache"}) );
  SetProp(P_NAME_ADJ, 0);
  SetProp(P_ARTICLE,0);

  AddDefaultSpell(1,500, DS_MASS_POISON,
    Name()+" speit eine riesige Giftwolke in den Raum.\n",  
    Name()+" speit eine riesige Giftwolke in den Raum.\n");
  AddSpell(1, 1, 
    Name()+" ruft eine Kampfechse zu Hilfe.\n",
    Name()+" ruft eine Kampfechse zu Hilfe.\n",
    DT_ELECTRIC, "echsen_ruf");

  CLONEME( ARMOUR "fluegel");
  CLONEME( RBALSAM);
  CLONEME( WBALSAM);
}

void die(int poisondeath)
{
  object ob;
  if(objectp(ob=present("\nbarden_hero_killquest", QueryProp(P_KILLER)))) {
    ob->Mark();
  }

  write_file(LOG "drache", dtime(time())+": "+CAP(TP->query_real_name())+
      " killt den Bronzedrachen.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "drache", dtime(time())+": Der Bronzedrache hat gerade "+
      CAP(player->query_real_name())+ " umgebracht. (-"+lostexp+" XP)\n");
  ::NotifyPlayerDeath(player, killer, lostexp);
}

#define ECHSENNAMEN ({"Zisss", "Wisss", "Visss", "Tisss", "Risss", \
                      "Nisss", "Lisss" })

void echsen_ruf()
{
  object ob;
  if( present("kampfechse 6", ENV(TO)) ) return;
  ob=clone_object( NPC "echse");
  ob->SetProp(P_MNPC_FLAGS, 0);
  ob->SetProp(P_AGGRESSIVE, 1);
  ob->move(ENV(TO), M_TPORT);
  ob->SetProp(P_NAME, ECHSENNAMEN [random(sizeof(ECHSENNAMEN))] );
}

