// /d/huegelland/raballion/hobitts/npc/juwelierin.c   
// 2002-09-06  Feyaria@SilberLand

inherit "std/repair";

#include "../def.h"
#include "/p/daemon/skillmaster/skillmaster.h"

string k_func();

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Sanidra Pelzfuss, die Meisterjuwelierin");
  SetProp(P_LONG, 
    "Vor Dir steht eine kleine Hobbitfrau, die ueber und ueber mit diversen "
    "Schmuckstuecken behaengt ist, unter anderem mit Ketten, Ohrringen, "
    "Ringen, Armreifen, Fusskettchen usw..... Entweder diese Frau ist "
    "unermesslich reich, oder sie ist Juwelierin und dient als ihr eigenes "
    "Schaufenster.");

  SetProp(P_NAME, "Sanidra Pelzfuss");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId(({"hobbit", "sanidra", "pelzfuss", "sanidra pelzfuss", "juwelierin",
        "meisterjuwelierin", "meisterin"}));
  set_living_name("sanidra");

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit ihren Haenden", 340, DT_BLUDGEON}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 87);
  SetProp(P_ALIGN, 350);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 80);
  SetProp(P_NOATTACK, "haelt einen wunderbar glitzernden Edelstein vor Dein "
      "Gesicht.\nSofort wirst Du wieder friedlich.");

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  AddInfo(DEFAULT_INFO, 
    "fragt Dich: Findest Du meine Juwelen schoen?\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  AddInfo( ({"sandira", "pelzfuss"}),
      "Ja, das bin ich!", "nickt und sagt: ");
  AddInfo( ({"juwelierin", "juwelier", "meisterjuwelier", "meisterjuwelierin",
        "juwelierhandwerk", "ausbildung", "unterricht", "handwerk", "kunst"}),
      "Ich bin eine Meisterjuwelierin. Wenn Du das auch werden willst, "
      "dann frag mich einfach nach einem Juwelierkaestchen.", "sagt stolz: ");
  AddInfo( ({"lehrling", "geselle", "kaestchen", "hilfe"}),
      "Wenn Du mein Lehrling werden willst, so frag mich einfach nach "
      "einem Juwelierkaestchen.", "sagt: ");
  AddInfo( ({"juwelen", "schmuck", "juwel"}),
      "Ich erzeuge aus Edelmetallen und Edelsteinen oder Perlen die "
      "verschiedensten Schmuckstuecke.", "sagt: ");
  AddInfo( ({"edelmetall", "metall", "edelmetalle", "edelmetallen"}),
      "Ich verwende Kupfer, Silber, Gold und Platin. Wenn Du etwas davon "
      "brauchst, ich habe so viel davon, dass ich Dir etwas "
      "verkaufen kann.", "sagt: ");
  AddInfo( ({"kupfer", "silber", "gold", "platin"}),
      "Daraus mache ich Schmuck. Wenn Du etwas davon "
      "brauchst, ich habe so viel davon, dass ich Dir etwas "
      "verkaufen kann", "sagt: ");
  AddInfo( "mithril",
      "Mithril ist sehr selten. Da musst Du schon Glueck haben, "
      "um etwas davon zu finden.", "sagt: ");
  AddInfo( ({"riesenedelstein", "riesenedelsteine", "riesenperle", 
        "riesenperlen"}),
      "Riesenedelsteine und Riesenperlen kann man fuer magische Ringe und "
      "Amulette verwenden.");
  AddInfo( ({"schmuckstuecke", "schmuckstueck", "ring", "ringe", "amulett", 
        "amulette", "kette", "ketten", "perlenkette", "perleneketten", 
        "ohrring", "ohrringe", "armreif", "armreifen" }),
      "Ich erzeuge Ringe, Amulette, Perlenketten, Ohrringe und Armreifen. "
      "Natuerlich repariere ich diese auch.",
      "sagt: ");
  AddInfo( ({"edelstein", "edelsteine"}),
      "Ich verwende Diamant, Rubin, Saphir, Smaragd, Amethyst, Opal, "
      "Topas, Aquamarin, Tuerkis, Citrin, Granat, Zirkon, Tigerauge und "
      "alle verschiedenen Sorten von Perlen und Halbeldelsteinen.", "sagt: ");
  AddInfo( ({"diamant", "rubin", "saphir", "smaragd", "amethyst", "opal",
        "topas", "aquamarin", "tuerkis", "citrin", "granat", "zirkon", 
        "tigerauge", "perle", "perlen", "halbedelstein", "halbeldelsteine"}),
      "Daraus mache ich Schmuckstuecke. Leider habe ich nicht genug davon, "
      "wenn Du selber welche brauchst, musst Du die schon selber besorgen. "
      "Ich selbst bestelle sie immer von einem Edelsteinhaendler in Tijara.", 
      "sagt: ");
  AddInfo( ({"tijara", "edelsteinhaendler"}),
      "Der Edelsteinhaendler aus Tijara hat zwar unverschaemt hohe Preise aber "
      "ich brauche einfach viele Edelsteine und Perlen.", "sagt: ");
  AddInfo( "juwelierkaestchen",  #'k_func, "sagt: ");
  AddInfo( ({"lernen"}),
      "Am besten lernt man das Juwelierhandwerk, wenn man moeglichst "
      "schwere Schmuckstuecke herstellt.", "sagt: ");
  AddInfo( ({"topjuweliere", "topliste", "liste", "juweliere", 
        "juweliertopliste"}),
      "Gib einfach 'topjuweliere' ein.", "sagt: ");
  AddInfo( ({"juwelierfertigkeit", "skill", "fertigkeit", "fertigkeiten",
        "faehigkeit", "faehigkeiten", "skills", "juwelierfertigkeiten"}),
      "Gib einfach 'juwelierfertigkeit' ein, wenn Du wissen willst, wie gut "
      "Du im Juwelierhandwerk bist.", "sagt: ");
  SetProp(P_LOG_INFO, "raballion/sanidra");

  AddLibrary( NPC "infos.lib",1);

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Sanidra Pelzfuss bedankt sich herzlichst.\n" }) );

  AddCmd("topjuweliere", "top_func");
  AddCmd("juwelierfertigkeit", "top_func");

  SetChats(4, ({
    "Sanidra Pelzfuss fragt Dich: Magst Du Juwelen?\n",
    "Sanidra Pelzfuss sagt: Ich liebe Schmuck!\n",
    "Sanidra Pelzfuss sagt: Ich bin eine Meisterjuwelierin.\n",
    "Sanidra Pelzfuss sagt: Ich kann Ringe und Amulette wieder reparieren.\n",
    "Sanidra Pelzfuss bessert einen Kratzer an einem Opalring aus.\n",
    "Sanidra Pelzfuss faedelt Perlen zu einer neuen Perlenkette auf.\n",
    "Sanidra Pelzfuss zeigt Dir einen frisch geschliffenen Edelstein.\n",
    "Sanidra Pelzfuss zeigt Dir einen glitzernden Diamanten.\n",
    "Sanidra Pelzfuss zeigt Dir einen blutroten Rubin.\n",
    "Sanidra Pelzfuss zeigt Dir einen funkelnden Saphir.\n",
    "Sanidra Pelzfuss zeigt Dir einen glitzernden Amethystring.\n",
    "Sanidra Pelzfuss zeigt Dir einen guenstigen Kupferring.\n",
    "Sanidra Pelzfuss zeigt Dir einen wunderschoenen Diamantring.\n",
    "Sanidra Pelzfuss zeigt Dir einen kunstvoll gearbeiteten Saphirohrring.\n",
    "Sanidra Pelzfuss zeigt Dir einen herrlichen Rubinarmreif.\n",
    "Sanidra Pelzfuss zeigt Dir einen praechtige Perlenkette.\n",
    "Sanidra Pelzfuss zeigt Dir ein Platinamulett mit einem eingelegten Smaragd.\n",
    "Sanidra Pelzfuss fragt Dich: Wie gefallen Dir meine Schmuckstuecke?\n",
    "Sanidra Pelzfuss jammert wegen der hohen Edelsteinpreise.\n"
     }) );

  SUID;
  CLONEME("/p/armour/ring/ring" );
  CLONEME("/p/armour/ring/ring" );
  CLONEME("/d/gebirge/feyaria/drachen/armour/ohrringe" );
  CLONEME("/p/armour/amulet/amulett" );
  CLONEME("/p/armour/trousers/rock" );
  CLONEME("/p/armour/armour/bluse" );
  command("trage alles");
}

int rep_auswahl(object ob)
{
  if (ob->QueryProp(P_ARMOUR_TYPE)==AT_RING || 
      ob->QueryProp(P_ARMOUR_TYPE)==AT_AMULET)
    return 1;
  write(break_string("Tut mir leid, ich repariere nur Schmuck!",78,
        Name(WER,1)+" sagt: "));
  return 0;
}

string k_func()
{
 object ob;
  
  if(ob=deep_present("\nJuwelierkaestchen",TP))
  {
    ob->remove(0);
    clone_object("/p/std/skills/jewelry/juwelierkaestchen")->move( TP,M_NOCHECK);
    tell_object(TP,
        "Sanidra tauscht Dein altes Juwelierkaestchen gegen ein Neues.\n");
    return "Du hast zwar schon eins, aber gut - hier hast Du ein neues.";
  }
  clone_object("/p/std/skills/jewelry/juwelierkaestchen.lpc")->move( TP,M_NOCHECK);
  tell_object(TP,
      "Sanidra nimmt ein Juwelierkaestchen und gibt es Dir.\n");
  return "Hier nimm dieses Juwelierkaestchen.";
}

void nix_da(string pln)
{
  object pl;
  if(!pl=find_player(pln)) return;
  if(!present(pl))
    pl->Message("Sandira teilt Dir mit: Komm vorbei, wenn Du etwas willst!\n",
        MSGFLAG_TELL); 
  else
    tell_room(environment(),"Sanidra sagt: "+
        capitalize(pln)+" du Hirt, bist ja eh da, was soll das teile mit?\n");
  return;
}

void catch_tell(string str)
{
  object pl;
  if( !pl=find_player(lower_case(explode(str," ")[0])) ) return;
  if ((strstr(str, "teilt Dir mit: ") != -1)) {
    call_out("nix_da",3,getuid(pl));
  }
 return;
}

int top_func(string str)
{
  int i;
  string output;
  notify_fail("Kommando: topjuweliere <1-100>\n");
  if(!str) return 0;
  i=to_int(str);
  if(i<1 || i>100) return 0;
  output=SKILLMASTER->QueryTopList(i,SK_JEWELRY);
  tell_object(TP, "                    TOPJUWELIERE\n");
  TP->More(output);
  return 1;
}

int skill_func()
{
  SKILLMASTER->QuerySkill(this_player(),SK_JEWELRY,1);
  return 1;
}
