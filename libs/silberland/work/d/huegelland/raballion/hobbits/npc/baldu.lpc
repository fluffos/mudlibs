// /d/huegelland/raballion/hobbits/npc/baldu.c
// Repair fuer WT_KNIFE
// 1998-08-10  Feyaria@SilberLand

inherit "std/repair";

#include "../def.h"
#include <mnpc.h>

int schaerfen(string str);

void create()
{
  if (!is_clone(TO)) return;
  repair::create();

  SetProp(P_SHORT, "Baldu Eisenfeiler, der Scherenschleifer");
  SetProp(P_LONG, BS(
    "Dieser kleine Hobbit traegt einen grossen Schleifstein mit sich herum. "
    "Rund um seinem rundlichen Bauch haengen viele Scheren und Messer. "
    "Es ist Baldu Eisenfeiler, der Scherenschleifer von Derlim. Du hast "
    "gehoert, dass Leute aus dem ganzen SilberLand zu ihm kommen, um ihre "
    "Scheren und Messer von ihm schleifen zu lassen."));
  SetProp(P_NAME, "Baldu");
  set_living_name("scherenschleifer");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"baldu","eisnfeiler", "baldu eisenfeiler", "scherenschleifer",
          "hobbit"}));
  AddDetail( ({"schleifstein", "stein"}),
    "Der Schleifstein ist relativ gross fuer einen Hobbit und sicher sehr "
    "schwer.");

  create_default_npc(18);
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_TERROR    : -0.1, DT_MAGIC     : -0.1, 
    DT_SOUND     :  0.2, DT_LIGHTNING :  0.1, DT_POISON    :  0.1 ]) );
  SetProp(P_HANDS, ({" mit Scherenspitzen", 180, DT_PIERCE}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 88);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MSGIN, "kommt herein und ruft: Der Scherenschleifer ist da");
  SetProp(P_MSGOUT, "findet hier nichts mehr zum Schleifen und geht");
  SetProp(P_MNPC_AREA, ROOM );
  SetProp(P_MNPC_WAIT, ({50,50,50}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hauptplatz");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES+MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO,
    ({"schleift gerade eine Schere und versteht Dich deswegen nicht.\n",
      "laechelt verlegen.\n",
      "sagt: Ich bin doch nur ein Scherenschleifer.\n",
      "fragt: Woher soll ich das wissen?\n",
      "gruebelt vor sich hin.\n",
      "schaut Dich erstaunt an.\n"}) );
  AddLibrary( NPC "infos.lib",1);
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  AddInfo( ({"name", "hobbit", "baldu", "eisenfeiler"}),
    "Ich bin Baldu Eisenfeiler, der Scherenschleifer", "sagt: ");
  AddInfo( ({"scherenschleifer", "dolch", "dolche", "messer"}),
    "Ich bin ein Scherenschleifer, aber ich kann auch Dolche und Messer "
    "wieder reparieren.", "sagt: ");
  AddInfo( ({"schere","heckenschere"}),
    "Ich kann auch Scheren jeder Art wieder schaerfen. Wenn ich eine Schere "
    "wieder schaerfen soll, so sag einfach \"schaerfe gegenstand\".",
    "sagt: ");

  SetProp(P_LOG_INFO, "raballion/baldu");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    Name(WER,1)+" sagt: Vielen Dank, aber ich brauche so etwas nicht.\n"+
    Name(WER,1)+" gibt Dir @WEN wieder zurueck.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(1,240,
    "Baldu bewirft Dich mit frischgeschliffenen Scheren.\n",
    "Baldu bewirft @WEN mit frischgeschliffenen Scheren.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]) );

  SetChats(1, ({
    "Der Schleifstein macht einen hoellischen Laerm.\n",
    Name(WER,1)+ " repariert ein langes Messer.\n",
    Name(WER,1)+ " schleift die Klinge eines spitzen Dolches.\n",
    Name(WER,1)+ " lachelt Dich freundlich an.\n",
    Name(WER,1)+ " sagt: Ich kann Scheren, Messer und Dolche reparieren.\n",
    Name(WER,1)+ " bearbeitet ein Kuechenmesser mit dem Schleifstein.\n",
    Name(WER,1)+ " ruft: Der Scherenschleifer ist da!\n",
    Name(WER,1)+ " schleift eine Schere.\n"}) );

  SUID;
  CLONEME("/p/armour/cloak/lederschuerze");
  command("trage alles");
  CLONEME( "/d/ebene/creative/feldlager/obj/minze");

  AddCmd( ({"schaerfe"}), "schaerfen");

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( !adverb ) adverb ="\b";
  if (find_call_out("react")!= -1) return;
  if( gruppe=="intim" || gruppe=="nett" )
    call_out("react",0, "knuddelt Dich "+adverb+".", "knuddelt "+
      TP->name(WEN)+".");
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER, 1) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

int rep_auswahl(object ob)
{
  if(ob->QueryProp(P_ARMOUR_TYPE))
  {
    write(break_string("Soll ich denn bei "+ob->name(WEM,1)+" die Kanten "
      "schleifen? Ich repariere nur Scheren, Messer und Dolche.",78,
      Name(WER,1)+" sagt: "));
    return 0;
  }
  if(ob->QueryProp(P_WEAPON_TYPE)!=WT_KNIFE )
  {
    write(break_string("Leider ist mir "+ob->name(WER,1)+" zu gross zum "
      "schleifen. Ich repariere nur Scheren, Messer und Dolche.",78,
      Name(WER,1)+" sagt: "));
    return 0;
  }
  return 1;
}

int schaerfen(string str)
{
  object schere;

  notify_fail("Was willst du schaerfen lassen ?\n");
  if( !str) return 0;
  if( !schere=present(str, TP) )
    return 0;
  if( schere->QueryProp(P_WEAPON_TYPE)!=WT_KNIFE )
  {
    write("Ich kann nur Messer und Scheren schaerfen!\n");
    return 1;
  }
  if(TP->QueryMoney() < 250) {
    write(BS("Baldu sagt: Du hast leider keine 250 Muenzen fuers schaerfen dabei !"));
    return 1;
  }

  write(BS("Baldu nimmt "+schere->name(WEN,1)+" und faengt an, sie auf seinem "
        "Schleifstein zu schaerfen, so dass die Funken nur so fliegen. "
        "Schaerfer als je zuvor gibt er "+schere->QueryPronoun(WEN)+
        " Dir wieder zurueck und nimmt Dir 250 Muenzen dafuer ab."));
  TP->AddMoney(-250);
  schere->machscharf();
  return 1;
}
