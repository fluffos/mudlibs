inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"
#include "/d/huegelland/feyaria/weg/squest.h"

void spinnengift();

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Dodo Stolzfuss, der Troedelhaendler");
  SetProp(P_LONG, 
    "Das ist Dodo Stolzfuss. Ihm gehoert der Troedlerladen seit vielen "
    "Jahren. Er ist ein schmaechtiges Kerlchen und immer auf seine Geschaefte "
    "konzentriert. Er hat keinerlei Kampferfahrung und daher ist er an einer "
    "Auseinandersetzung mit Dir ueberhaupt nicht interessiert.");

  SetProp(P_NAME, "Dodo Stolzfuss");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"hobbit", "dodo", "stolzfuss", "troedler", "troedelhaendler",
          "haendler", "kerl", "kerlchen"}));
  set_living_name("dodo");

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinen Haenden", 100, DT_BLUDGEON}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 92);
  SetProp(P_ALIGN, 450);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 20);
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_TERROR    : -0.1, DT_MAGIC     : -0.1,
            DT_SOUND     :  0.2, DT_LIGHTNING :  0.1, DT_POISON    :  0.1 ]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  AddInfo(DEFAULT_INFO, 
    "fragt Dich: Willst Du nicht etwas kaufen oder verkaufen?\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  SetProp(P_LOG_INFO, "raballion/hobbits");

  AddLibrary( NPC "infos.lib",1);

  AddInfo( ({"dodo", "stolzfuss", "troedler", "troedelhaendler", "haendler"}),
    "Ich bin Dodo Stolzfuss, der Troedelhaendler.", "nickt und sagt: ");
  AddInfo( ({"spinne", "giftspinne", "paula"}), 
    "Die Spinne heisst Paula und ich habe sie einem fremden, schwarzen Mann, "
    "der aussah als waere er nicht vom Festland, abgekauft. Der schwarze Mann "
    "verschwand und ward nie mehr gesehen. Wo in aller Welt gibt es solche "
    "ekelerregenden Spinnen und schwarze Maenner? Auf jeden Fall ist die "
    "Spinne extrem giftig! @@spinne@@", "erzaehlt Dir: ");
  AddInfo( ({"laden", "troedelladen", "kaufen", "verkaufen"}),
    "Du kannst hier alles kaufen oder verkaufen.", "sagt: ");
  AddInfo( ({"automat", "hebel", "teddy"}),
    "Wenn Du am Hebel des Automaten ziehst, bekommst Du einen Teddy. So ein "
    "Teddy ist echt lieb und auch sehr nuetzlich.", "sagt: ");
  AddInfo( ({"schaufel", "seil"}),
    "Sowas nuetzliches kann man immer mal brauchen...", "sagt: ");
  AddInfo( ({"fackel"}),
    "Wenn es einmal dunkel ist, wirst Du froh sein, wenn Du eine Fackel "
    "eingekauft hast.", "sagt: ");
  AddInfo( ({"stempel"}),
    "Mit dem Stempel kann sich ein Zweitie markieren. Mach zur Sicherheit "
    "mal 'hilfe  zweities'.", "erklaert: ");
  AddInfo( ({"lolli"}),
    "Sicher hast Du Lust, einen Lolli zu schlecken!", "sagt: ");
  AddInfo( ({"wuerfel"}),
    "Damit kannst Du wuerfeln.", "sagt: ");
  AddInfo( ({"thermomether", "taschenthermometer"}),
    "Mit einem Thermomether wiesst Du immer, wie heiss oder kalt es gerade "
    "ist.", "sagt: ");
  AddInfo( ({"mutter", "schwiegermutter", "schwiegermuetter"}),
    "Tut mir leid, meine Schwiegermutter hab ich schon vor langer Zeit "
    "verkauft. Und andere Schwiegermuetter kaufe ich nicht auf :)", 
    "sagt grinsend: ");
  AddInfo( ({"futter", "spinnenfutter"}),"@@spinnenfutter@@");
  AddInfo( ({"junge", "hirtenjunge", "hirte"}),    
    "Der Hirtenjunge hat mir frueher Futter fuer meine Spinne gebracht. "
    "Jetzt ist er sicher auf der Kuhweide in den Huegeln.", "sagt: ");
  AddInfo( ({"weide", "kuhweide", "kuhfladen", "kuhflade"}),    
    "Die Kuhweide befindet sich in den Huegeln im Nordosten von Derlim. "
    "Du findest sie leicht, denn dort liegen viele Kuhfladen herum.",
    "erzaehlt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Dodo Stolzfuss bedankt sich herzlichst.\n" }) );

  SetProp(P_SPELLRATE, 20);
  AddSpell(1,300,
    "Dodo Stolzfuss nimmt die Giftspinne aus der Vitrine und sie vergiftet Dich.\n",
    "Dodo Stolzfuss nimmt die Giftspinne aus der Vitrine und sie vergiftet @WEN.\n",
     DT_POISON, "gift");

  SetChats(2, ({
    "Dodo Stolzfuss fragt Dich: Willst Du nicht etwas kaufen oder verkaufen?\n",
    "Dodo Stolzfuss sortiert seine Waren.\n",
    "Dodo Stolzfuss zeigt Dir seine Vitrinen.\n",
    "Dodo Stolzfuss will Dir unnuetzes Zeugs andrehen.\n", 
     }) );

  SUID;
//  CLONEME(ARMOUR "" );
  command("trage alles");
}

void gift(object enemy, int damage, mixed dam_type)
{
  enemy->AddPoison(random(10));
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "deads",
    ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(PL))+" umgebracht.\n");
}

string spinne()
{
  if( !TP->QueryQuest(SPINNENQUEST) )
    return "Leider ist die Spinne sehr waehlerisch, was ihr Futter "
      "anbelangt. Zur Zeit ist sie sehr hungrig.";
  else
    return "Dank Dir hat meine Spinne jetzt genug zu fressen.";
}
    
string spinnenfutter()
{
  int r;
  object squest,futter;
  if( TP->QueryQuest(SPINNENQUEST) )
    return "bedankt sich nochmals fuer das Spinnenfutter.\n";
  if( (futter=present("\nspinnenfutter",TP)) && 
      (squest=present(SPINNENQUEST_ID, TP)) )
  {
    if( squest->query_quest()!= 63 )
    {
      write(break_string("Da ist wohl was nicht ganz mit rechten Dingen "
          "zugegangen!  Mach doch alles noch mal von vorne!", 78,  
          "Quest-Erzmagierin Feyaria teilt Dir mit: "));
      squest->remove();
      futter->remove();
      return "schaut dich misstrauisch an.\n";
    }
    if( (r=TP->GiveQuest(SPINNENQUEST)) == 1)
    {
      write_file (SPINNENQUEST_LOG,
        sprintf ("%s  %s hat Futter fuer die Spinne besorgt.\n",
        dtime(time()), CAP(TP->query_real_name())));
      tell_room( MENV, break_string("Oh toll! Das ist ja erstklassiges " 
        "Spinnenfutter! Vielen herzlichen Dank! Du hast meiner Spinne das "
        "Leben gerettet, "+TPN+".",78,Name(WER,1)+" sagt: "));
      tell_room( MENV, "\n"+Name(WER,1)+" fuettert seine Spinne.\n");
    }
    else
      write( "BUG in der QUEST!! Fehler: "+r+"! Erzmagier verstaendigen!\n");
    squest->remove();
    futter->remove();
    return "bedankt sich nochmals fuer das Spinnenfutter.\n"; 
  }
  write(break_string(
    "Meine Spinne ist kurz vorm verhungern. Frueher hat mir immer der "
    "Hirtenjunge von der Kuhweide das Futter fuer meine Spinne gebracht. Aber "
    "nun bekomme ich nichts mehr. Leider kann ich meinen Laden nicht verlassen "
    "und selber nach Futter zu suchen. Es waere sehr nett von Dir, wenn Du "
    "mir etwas Spinnenfutter bringen wuerdest.",78,Name(WER,1)+ " sagt: ") );
  if( !present(SPINNENQUEST_ID, TP) )
    CLONE( SPINNENQUEST_OBJ, TP);
  if( squest=present(SPINNENQUEST_ID, TP) )
    squest->set_quest(SQ_DODO_BEFRAGT);
  return "bedankt sich schon mal im vorraus.\n";
}

