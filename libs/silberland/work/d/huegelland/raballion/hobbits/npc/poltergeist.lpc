// Der Poltergeist
// 14.03.2000 Feyaria@SilberLand

inherit "std/npc";

#include "../def.h" 

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine geisterhafte Erscheinung schwebt mitten im Raum");
  SetProp(P_LONG,
    "Vor Dir schwebt eine geisterhafte Erscheinung mitten im Raum. Es handelt "
    "sich um einen sogenannten Poltergeist, ein sehr starkes Geistwesen. "
    "Der Poltergeist sieht aus wie ein achtarmiger Riese, genaue Konturen "
    "kann man aber nicht erkennen, weil er ziemlich durchsichtig ist.");
  SetProp(P_NAME, "Poltergeist");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-276,T_RANGE_MAX:300]));
  AddId(({"poltergeist", "polter", "geist", "erscheinung", "NOWIMPY"}));
  set_living_name("derlimderlim__poltergeist");

  create_default_npc(40);
  SetProp(P_HANDS, ({" mit Geisterhaenden",QueryProp(P_HANDS)[1],DT_MIND}));
  SetProp(P_XP, QueryProp(P_XP)+15000*100); // Bonus fuer Spells
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RACE, "Geist");
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_AGGRESSIVE, 0.5);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:     -0.8, DT_COLD:     -0.9, DT_WATER: -0.8, DT_AIR:   -0.8,
      DT_SOUND:    -0.6, DT_ELECTRIC: -0.8, DT_LIGHT: -0.6, DT_LIGHTNING: -0.8, 
      DT_MAGIC:     2.0, DT_ACID:     -0.7, DT_POISON:-0.8, DT_TERROR:-1.0,
      DT_MIND:     -0.7, DT_EXPLOSION:-0.5, DT_HOLY:  -0.8, DT_UNHOLY: -0.9,
      DT_SLASH:    -1.0, DT_BLUDGEON: -1.0, DT_PIERCE:-1.0, 
      DT_SQUEEZE:  -1.0, DT_WHIP:     -1.0, DT_RIP:   -1.0]) );
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,30);

  SetProp(P_MSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " poltert zum letzen Mal.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_MSG, "*polterpolterpolter*");

  AddInfo(DEFAULT_INFO, "fuehlt sich nicht angesprochen.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "@WAS@ faellt durch den Poltergeist zu Boden.\n" }) );

  SetProp(P_SPELLRATE, 75);
  AddSpell(2,600,
    "Der Poltergeist wirft Dir ein leeres Fass auf den Kopf.\n",
    "Der Poltergeist wirft @WEM ein leeres Fass auf den Kopf.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,400,
    "Der Poltergeist wirft Dir einen Ziegelstein auf den Kopf.\n",
    "Der Poltergeist wirft @WEM einen Ziegelstein auf den Kopf.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,500,
    "Der Poltergeist erschreckt Dich fuerchterlich.\n",
    "Der Poltergeist erschreckt @WEN fuerchterlich.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,300,
    "Der Poltergeist friert Dich ein.\n",
    "Der Poltergeist friert @WEN ein.\n",
     DT_COLD, "einfrieren", ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1200,
    "Der Poltergeist zerreisst Deinen Brustkorb.\n",
    "Der Poltergeist zerreisst @WESSEN Brustkorb.\.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Poltergeist versucht Dich zu erschrecken.\n",    
    "Der Poltergeist poltert ganz fuerchterlich.\n",    
    "Der Poltergeist schwebt um Dich herum.\n",
    "Der Poltergeist wirft mit Holzbrettern herum.\n"}) );
  SetAttackChats(10, ({
    "Der Poltergeist versucht Dich zu erschrecken.\n",    
    "Der Poltergeist poltert ganz fuerchterlich.\n",    
    "Der Poltergeist schwebt um Dich herum.\n",
    "Der Poltergeist wirft mit Holzbrettern herum.\n"}) );

  SUID;
  CLONEME("/d/dschungel/feyaria/tijara/obj/rbalsam");
}

void die(int poisondeath) {
  write_file(LOG "polter",
    ctime()+": "+CAP(getuid(TP))+" killt den Poltergeist.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == TO)
    write_file(LOG "polter",
      ctime()+": Der Poltergeist hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

int _query_wimpy() { return 0; }

void einfrieren(object enemy, int damage, mixed dam_type)
{
  enemy->ModifySkillAttribute(TO, SA_SPEED, 50, 10);
  enemy->SetProp(P_NEXT_SPELL_TIME, 
      enemy->QueryProp(P_NEXT_SPELL_TIME)<time()? time()+4:
        enemy->QueryProp(P_NEXT_SPELL_TIME)+4);
}
