inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"

object *lokalverbot;
object *hatqtasche;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Tarin Langsattler, der Wirt (test)");
  SetProp(P_LONG, 
    "Das ist Tarin Langsattler (test), der Wirt dieses Hauses. Er schaut immer "
    "recht grimmig unter seinen buschigen Augenbrauen hervor, ist aber "
    "eigentlich ein ganz netter Bursche. Er ist von sehr kraeftiger Statur "
    "und durchaus in der Lage etwaige Stoerenfriede rauszuschmeissen. "
    "Das kraeftigste an ihm ist aber sein dicker Bauch, was auf eine gute "
    "Kueche schliessen laesst.");
  SetProp(P_NAME, "Tarin Langsattler2");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"tarin2", "langsattler2", "tarin langsattler2", "hobbit2", "wirt2"}));
  set_living_name("tarin2");
  hatqtasche = ({ });

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit einem Bierkrug", 200, DT_BLUDGEON}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 105);
  SetProp(P_ALIGN, 250);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 10);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  AddInfo(DEFAULT_INFO, "sagt: Bestell doch lieber was!\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  SetProp(P_LOG_INFO, "raballion/hobbits");
  AddLibrary( NPC "infos.lib",1);

  AddInfo( ({"tarin", "wirt", "langsattel", "tarin langsattel"}),
    "Ja, ich bin der Wirt Tarin Langsattel.", "nickt und sagt: ");
  AddInfo( ({"kneipe", "essen", "trinken", "wirtshaus", "drache", 
             "goldener drache", "goldenem drachen"}),
    "Das hier ist mein Wirtshaus. Was darf ich Dir bringen?", "antwortet: ");
  AddInfo( ({"suppe", "frittaten", "frittatensuppe"}),
    "Die Frittatensuppe ist sehr schmackhaft.", "sagt: ");
  AddInfo( ({"blutwurst", "geroestete blutwurst"}),
    "Die geroestete Blutwurst schmeckt ausgezeichnet.", 
    "leckt sich die Lippen und sagt: ");
  AddInfo( ({"bohneneintopf", "eintopf", "bohnen"}),
    "Den Bohneneintopf musst Du einfach mal probieren!", "schwaermt: ");
  AddInfo( ({"spanferkel", "spanferkelhaxen", "haxen"}),
    "Das ist die Spezialitaet des Hauses!", "sagt stolz: ");
  AddInfo( ({"bananen", "sufflee", "bananensufflee"}),
    "Das ist ein alter Familienrezept.", "sagt geheimnisvoll: ");
  AddInfo( ({"rezept", "familienrezept"}),
    "Ein Verwandter aus Tijara hat mir das Rezept geschickt.", "sagt: ");
  AddInfo( ({"tijara"}),
    "Das ist eine Stadt weit im Sueden.", "sagt: ");
  AddInfo( ({"verwandter", "kontor"}),
    "Er arbeitet in Tiajra in einem Kontor.", "sagt: ");
  AddInfo( ({"stinklpils", "stinkl-pils", "stinkl", "pils", "bier"}),
    "Ein hervorragendes Bier aus einer Privarbrauerei.", "schwaermt: ");
  AddInfo( ({"weintrauben", "weintraubensaft", "saft"}),
    "Frischer Saft aus den Weintrauben aus meinem eigenen Weinberg.",
    "versichert Dir: ");
  AddInfo( ({"waldkraeutertee", "tee", "kraeutertee"}),
    "Frischgekochter Tee aus seltenen Waldkraeutern.", "sagt: ");
  AddInfo( ({"waldkraeuter", "kraeuter"}),
    "Ich verrate niemanden, wo ich diese Kraeuter sammle.", 
    "sagt verschlossen: ");
  AddInfo( ({"derlimer", "roter derlimer", "roter", "rotwein", "wein"}),
    "Der rote Delimer ist der beruehmte Wein aus Derlim. Meiner stammt "
    "aus meinem eigenen Weinberg.", "sagt begeistert: ");
  AddInfo( ({"weinberg", "berg", "suedhang"}),
    "Ich habe meinen eigenen Weinberg, wie fast jeder wohlhabende Hobbit. "
    "Meiner hat aber Suedhang, daher hab ich soviel Wein und Traubensaft.",
    "sagt: ");
  AddInfo( ({"hirnreiniger", "hirn", "reiniger", "mischung"}),
    "Der Hirnreiniger ist eine spezielle Mischung, die Dein Hirn wieder "
    "reinigt. Es ist aber auch viel Alkohl drinnen.", "sagt laechelnd: ");
  AddInfo( ({"notfalltropfen", "notfall", "tropfen"}),
    "Das sind Tropfen fuer jeden Notfall.", "sagt grinsend: ");
  AddInfo( ({"kruege", "teller", "krug"}),
    "Immer muss ich die schmutzigen Kruege und Teller abwaschen.", "seufzt: ");

// Questinfos
  AddInfo( ({"schnecken", "weinbergschnecken"}),
    "Nahja, die Gaeste futtern viel und da kann schon mal was ausgehen. "+
    "Wenn mir aber jemand helfen koennte, ich kann hier gerade nicht weg.", "seufzt: ");
  AddInfo( ({"hilfe", "helfen"}),
    "Im Weinberg von Derlim gibt es ja genug Weinbergschnecken aber zum "+
    "Sammeln wuerdest Du eine Tasche benoetigen. Bring mir aber bitte "+
    "keine lebenden, da ekle ich mich naemlich wieder.", "sagt laechelnd: ");
  AddInfo ("tasche", "@@qtasche@@");



  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Tarin Langsattler bedankt sich.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(1,200,
    "Tarin Langsattler schuettet Dir heisse Frittatensuppe ueber den Kopf.\n",
    "Tarin Langsattler schuettet @WEM heisse Frittatensuppe ueber den Kopf.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Tarin Langsattler bewirft Dich mit leeren Kruegen.\n",
    "Tarin Langsattler bewirft @WEN mit leeren Kruegen.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Tarin Langsattler erzaehlt eine Geschichte.\n",
    "Tarin Langsattler raeumt die leeren Teller ab.\n",
    "Tarin Langsattler raeumt die leeren Kruege ab.\n",
    "Tarin Langsattler waescht die schmutzigen Kruege ab.\n",
    "Tarin Langsattler waescht die schmutzigen Teller ab.\n",
    "Tarin Langsattler preist seine Frittattensuppe an.\n",
    "Tarin Langsattler preist seine geroestete Blutwurst an.\n",
    "Tarin Langsattler preist seinen Bohneneintopf an.\n",
    "Tarin Langsattler preist sein Bananensufflee an.\n",
    "Tarin Langsattler preist seine Spanferkelhaxen an.\n",
    "Tarin Langsattler preist seinen Hirnreiniger an.\n",
    "Tarin Langsattler preist sein Stinkl-Pils an.\n",
    "Tarin Langsattler preist seinen Weintraubensaft an.\n",
    "Tarin Langsattler preist seinen Waldkraeutertee an.\n",
    "Tarin Langsattler preist seinen roten Derlimer an.\n",
    "Tarin Langsattler zapft ein neues Fass an.\n", 
    "Tarin Langsattler presst Weintrauben aus.\n", 
    "Tarin Langsattler kocht neuen Kraeutertee.\n", 
    "Tarin Langsattler holt eine neue Flasche roten Derlimer aus dem Weinkeller.\n",
    "Tarin Langsattler goennt sich selbst einen Schluck roten Derlimer.\n",
    "Tarin Langsattler mischt einen Hirnreiniger zusammen.\n", 
    "Tarin Langsattler kocht Frittatensuppe.\n", 
    "Tarin Langsattler roestet eine Blutwurst.\n", 
    "Tarin Langsattler macht frischen Bohneneintopf.\n", 
    "Tarin Langsattler schaelt Bananen fuer sein Sufflee.\n", 
    "Tarin Langsattler braet ein Spanferkel.\n" 
    "Tarin Langsattler fragt Dich: Darf ich noch was bringen?\n",
    "Tarin Langsattler fragt Dich: Schmeckts?\n",
    "Tarin Langsattler denkt bei sich: Die Schnecken sind fast alle!\n",
    "Tarin Langsattler fragt Dich nach Deinen Wuenschen.\n"}) );

  SUID;
  CLONEME("/p/armour/schuerze" );
  command("trage alles");

  lokalverbot=({});

  AddCmd( ({"kaufe", "kauf", "bestelle", "bestell"}), "lokalverbot_kaufen");
}

int lokalverbot_kaufen(string str)
{
  if( member(lokalverbot,TP)!=-1 )
  {
    write("Tarin Langsattler schreit: Du bekommst nichts!\n");
    return 1;
  }
  else return 0;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( gruppe=="fies" )
    call_out("fies",2+random(3));
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  write("Tarin Langsattler mag das nicht und gibt Dir Lokalverbot.\n"
        "Mit grossen Schwung wirft er Dich aus der Kneipe hinaus.\n\n");
  say("Tarin Langsattler mag das nicht und gibt "+TPN+" Lokalverbot.\n", 
      ({TP}));
  TP->move(ROOM "westweg1", M_GO, "wird von Tarin Langsattler rausgeworfen", 
      "", "wird aus dem Wirtshaus geworfen");
  lokalverbot+=({TP});
}

void reset()
{
  ::reset();
  lokalverbot=({});
  hatqtasche = ({ });
}

void init()
{
  ::init();
  if( member(lokalverbot,TP)!=-1)
    call_out("rauswerfen",0); 
}


give_notify(obj)
{
  int q, i, schneckenleichen;
  string ow;
  object *all, tp;

  tp = TP;
  if (obj->id("qtasche"))
  {
    // EUID ok?
    if (geteuid(obj) != "d.huegelland.raballion")
    {
      say (bs(
        "Was ist denn das fuer eine seltsame Tasche? Die habe ich Dir "+
        "sicher nicht gegeben! Folglich schaue ich gar nicht erst rein, "+
        "was Du alles reingestopft hast.",
        "Tarin sagt: "));
      give_obj (obj, tp);
      return;
    }
    // geklaute Tasche?
    if ((ow=obj->query_owner()) != tp->query_real_name())
    {
      say (bs("Die Tasche hast Du sicher irgendwo geklaut. "+
        "Diese Tasche hatte ich urspruenglich "+
        capitalize(ow)+" gegeben!\n","Tarin sagt: "));
      give_obj (obj, tp);
      return;
    }
    // Inhalt ok?
    schneckenleichen = 0;
    all = all_inventory(obj);
    for (i=0; i<sizeof(all); i++)
      if (all[i]->id("qschnecke")) schneckenleichen++;
    if (schneckenleichen < 3)
    {
      if (schneckenleichen == 0)
      {
        say (bs(
          "So einfach ist die Sache nicht. Aus nichts kann ich kein Essen "+
          "machen. Wenn Du eine tote Weinbergschnecke hast, lege sie bitte "+
          "in die Tasche und bring sie dann mir. Tasche mit Schnecke meine ich.",
          "Tarin sagt: "));
      }
      else
      {
        // versch. write() bzw. say():
        // wieviele Schnecken braucht man fuer ein Essen?
        write ("Tarin schaut Dich freudig an.\n");
        write (bs(
          "Super, Du hast ja tatsaechlich etwas "+
          "besorgt. Leider reicht dies noch nicht fuer ein ganzes Essen. "+
          "Du musst mehr besorgen.\n","Tarin meint: "));
        say ("Tarin scheint noch unzufrieden zu "+
          "sein.\n", tp);
      }
      give_obj (obj, tp);
      return;
    }
    say ("Tarin strahlt ueber beide Ohren.\n");
    say (bs("Danke, "+capitalize(tp->query_real_name())+
      ", Du hast mir echt geholfen!!!\n","Tarin sagt: "));

//  Questbelohnung findet hier statt
//  questabfrage nicht moeglich bis zum einbau
//    q = tp->GiveQuest(PILZQUEST);
    q = 1;
    if (q == 1)
    {
      write ("\nGratulation! Du hast die Aufgabe geloest!\n");
      // dieses shout() wird spaeter mal wieder rausgenommen,
      // wenns schwierigere Quests gibt :)
      domainshout (sprintf ("Lautes Jubeln erklingt aus Derlim.\n%s hat "+
        "dem Wirt sehr geholfen.\n", capitalize(TP->query_real_name())));
//      write_file (PILZQUESTLOG,
      write_file ("/d/huegelland/raballion/hobbits/schnlog",
        sprintf ("%s  %s hat sich als Helfer fuer den Wirt bewaehrt.\n",
        dtime(time()), capitalize(TP->query_real_name())));
    }
    else
    if (q != -1)
      write (sprintf("Unbekannter Fehler, bitte den zustaendigen Magier "+
        "verstaendigen!\nFehlercode: %d\n", q));
    if (schneckenleichen >= 4)
    {
      // zusaetzliche Vollheilung bei Loesung der Fleissaufgabe :)
      write (BS(
        "Tarin bemerkt, dass er mehr tote Weinbergschnecken hat, als er "+
        "fuer eine Essen benoetigt. Er gibt Dir eine Extraportion, die Du sofort "+
        "verschlingst. Du fuehlst Dich auf einmal deutlich staerker.\n"));
      tp->SetProp (P_HP, tp->QueryProp (P_MAX_HP));
      tp->SetProp (P_SP, tp->QueryProp (P_MAX_SP));
    }
    say ("Tarin dankt Dir nochmal und wendet sich wieder seiner "+
      "Arbeit zu.\n");
    for (i=0; i<sizeof(all); i++)   // Korb-Inhalt zerstoeren
      all[i]->remove();
    obj->remove();
    return;
  }
  else if (obj->id("qschnecke"))
  {
    write (BS("Tarin wurgst: Oh, eine tote Weinbergschnecke. Du weisst doch, "+
           "wie sehr ich mich davor ekle!\n"));
    write ("Tarin schuettelt sich.\n");
    write (bs(
      "Hmm, hatte ich Dir nicht eine Tasche gegeben? Ich haette die toten Dinger "+
      "naemlich ganz gerne da drinnen!","Tarin sagt: "));
    give_obj (obj, tp);
  }
  else
  {
    write ("Tarin fragt: \"Was soll ich denn damit?\"\n");
    drop_obj (obj);
  }
  return;
}


void rauswerfen()
{
  if(TP && ENV(TP)==MENV )
  {
    write("Tarin Langsattler wirf Dich wieder hinaus.\n"); 
    say("Tarin Langsattler wirft "+TPN+" hinaus.\n", ({TP}) );
    TP->move(ROOM "westweg1", M_GO, "wird von Tarin Langsattler rausgeworfen",
      "", "wird aus dem Wirtshaus geworfen");
    call_out("mitteilen",2);
  }
}  

void mitteilen()
{
  if(TP)
    tell_object(TP, "Tarin Langsattler teilt Dir mit: Du hast immer noch "
                    "Lokalverbot!\n");
}
 
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "deads",
    ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(PL))+" umgebracht.\n");
}
 


string qtasche()
{
  object ob;
  int ret;

  if ((member_array (TP, hatqtasche) != -1))
    return "erinnert sich: "
      "Dir hab ich schon mal eine Tasche gegeben!\n";

  SUID;
  ob = clone_object (OBJ"qtasche");
  ob->move(ME, M_NOCHECK);
  ob->SetProp(P_LONG, ob->QueryProp(P_LONG)+"Sie gehoert "+TP->name(WEM)+".\n");
  ob->set_owner(TP->query_real_name());

  say (bs(""+
    "Ok, Du willst mir ja wirklich helfen, den Keller zu fuellen, "+
    capitalize(TP->query_real_name())+"! Ich kann jetzt naemlich nicht "+
    "weg. Falls Du erfolgreich bist, waere ich Dir naemlich sehr dankbar. "+
    "Erstmal die Tasche zum Sammeln. Viel Glueck!","Tarin sagt: "));

  hatqtasche += ({ TP });
  ret = ob->move(TP, M_GET);
  if (ret != 1)
  {
    say ("Tarin Langsattler seufzt.\n");
    say (bs(
      "Leider hast Du zuviel Zeug bei Dir und kannst die Tasche nicht mehr tragen, "+
      "ich lege sie also erstmal hier in die Kneipe ab. Verkauf ein bisschen was "+
      "von Deinen schweren Kram und hol Dir die Tasche dann ab. Wenn Sie noch da ist.",
      "Tarin Langsattler seufzt: "));
    // command ("lege korb ab");
    say ("Tarin legt "+TP->name(WESSEN)+" Tasche auf den Boden.\n");
    ob->move(MENV, M_NOCHECK);
  }
  else
  {
    // command ("gib korb an "+TP->name());
    say ("Tarin gibt "+TP->name(WEM)+" "+
      (TP->QueryProp(P_GENDER)==FEMALE ? "ihr" : "sein")+
      "e Tasche.\n", TP);
    write ("Tarin ueberreicht Dir Deine Tasche zum Sammeln.\n");
  }
  return "laechelt zuversichtlich.\n";
}

varargs void die(int poisondeath)
{
  if( objectp(QueryProp(P_KILLER)) )
    environment(this_object())->set_ban(getuid(QueryProp(P_KILLER)),2);
  ::die(poisondeath);
}

