// /d/huegelland/raballion/hobbits/npc/wirt.c   
// Der Wirt von Derlim
// 1997-11-02  Feyaria@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "../def.h"

object *lokalverbot;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Tarin Langsattler, der Wirt");
  SetProp(P_LONG, 
    "Das ist Tarin Langsattler, der Wirt dieses Hauses. Er schaut immer "
    "recht grimmig unter seinen buschigen Augenbrauen hervor, ist aber "
    "eigentlich ein ganz netter Bursche. Er ist von sehr kraeftiger Statur "
    "und durchaus in der Lage etwaige Stoerenfriede rauszuschmeissen. "
    "Das kraeftigste an ihm ist aber sein dicker Bauch, was auf eine gute "
    "Kueche schliessen laesst.");
  SetProp(P_NAME, "Tarin Langsattler");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"tarin", "langsattler", "tarin langsattler", "hobbit", "wirt"}));
  set_living_name("tarin");

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit einem Bierkrug", 200, DT_BLUDGEON}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 105);
  SetProp(P_ALIGN, 250);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 10);
  SetProp(P_RESISTANCE_STRENGTHS, ([ DT_TERROR    : -0.1, DT_MAGIC     : -0.1, 
    DT_SOUND     :  0.2, DT_LIGHTNING :  0.1, DT_POISON    :  0.1 ]) );

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  AddInfo(DEFAULT_INFO, "sagt: Bestell doch lieber was!\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");
  SetProp(P_LOG_INFO, "raballion/hobbits");
  AddLibrary( NPC "infos.lib",1);

  AddInfo( ({"tarin", "wirt", "langsattel", "tarin langsattel"}),
    "Ja, ich bin der Wirt Tarin Langsattel.", "nickt und sagt: ");
  AddInfo( ({"kneipe", "essen", "trinken", "wirtshaus", "drache", 
             "goldener drache", "goldenem drachen"}),
    "Das hier ist mein Wirtshaus. Was darf ich Dir bringen?", "antwortet: ");
  AddInfo( ({"suppe", "frittaten", "frittatensuppe"}),
    "Die Frittatensuppe ist sehr schmackhaft.", "sagt: ");
  AddInfo( ({"blutwurst", "geroestete blutwurst"}),
    "Die geroestete Blutwurst schmeckt ausgezeichnet.", 
    "leckt sich die Lippen und sagt: ");
  AddInfo( ({"bohneneintopf", "eintopf", "bohnen"}),
    "Den Bohneneintopf musst Du einfach mal probieren!", "schwaermt: ");
  AddInfo( ({"spanferkel", "spanferkelhaxen", "haxen"}),
    "Das ist die Spezialitaet des Hauses!", "sagt stolz: ");
  AddInfo( ({"bananen", "sufflee", "bananensufflee"}),
    "Das ist ein alter Familienrezept.", "sagt geheimnisvoll: ");
  AddInfo( ({"rezept", "familienrezept"}),
    "Ein Verwandter aus Tijara hat mir das Rezept geschickt.", "sagt: ");
  AddInfo( ({"tijara"}),
    "Das ist eine Stadt weit im Sueden.", "sagt: ");
  AddInfo( ({"verwandter", "kontor"}),
    "Er arbeitet in Tiajra in einem Kontor.", "sagt: ");
  AddInfo( ({"stinklpils", "stinkl-pils", "stinkl", "pils", "bier"}),
    "Ein hervorragendes Bier aus einer Privatbrauerei.", "schwaermt: ");
  AddInfo( ({"weintrauben", "weintraubensaft", "saft"}),
    "Frischer Saft aus den Weintrauben aus meinem eigenen Weinberg.",
    "versichert Dir: ");
  AddInfo( ({"waldkraeutertee", "tee", "kraeutertee"}),
    "Frischgekochter Tee aus seltenen Waldkraeutern.", "sagt: ");
  AddInfo( ({"waldkraeuter", "kraeuter"}),
    "Ich verrate niemanden, wo ich diese Kraeuter sammle.", 
    "sagt verschlossen: ");
  AddInfo( ({"derlimer", "roter derlimer", "roter", "rotwein", "wein"}),
    "Der rote Delimer ist der beruehmte Wein aus Derlim. Meiner stammt "
    "aus meinem eigenen Weinberg.", "sagt begeistert: ");
  AddInfo( ({"weinberg", "berg", "suedhang"}),
    "Ich habe meinen eigenen Weinberg, wie fast jeder wohlhabende Hobbit. "
    "Meiner hat aber Suedhang, daher hab ich soviel Wein und Traubensaft.",
    "sagt: ");
  AddInfo( ({"hirnreiniger", "hirn", "reiniger", "mischung", "alkohol"}),
    "Der Hirnreiniger ist eine spezielle Mischung, die Dein Hirn wieder "
    "reinigt. Es ist aber auch viel Alkohl drinnen.", "sagt laechelnd: ");
  AddInfo( ({"notfalltropfen", "notfall", "tropfen"}),
    "Das sind Tropfen fuer jeden Notfall.", "sagt grinsend: ");
  AddInfo( ({"kruege", "teller", "krug"}),
    "Immer muss ich die schmutzigen Kruege und Teller abwaschen.", "seufzt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Tarin Langsattler bedankt sich.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(1,200,
    "Tarin Langsattler schuettet Dir heisse Frittatensuppe ueber den Kopf.\n",
    "Tarin Langsattler schuettet @WEM heisse Frittatensuppe ueber den Kopf.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Tarin Langsattler bewirft Dich mit leeren Kruegen.\n",
    "Tarin Langsattler bewirft @WEN mit leeren Kruegen.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Tarin Langsattler erzaehlt eine Geschichte.\n",
    "Tarin Langsattler raeumt die leeren Teller ab.\n",
    "Tarin Langsattler raeumt die leeren Kruege ab.\n",
    "Tarin Langsattler waescht die schmutzigen Kruege ab.\n",
    "Tarin Langsattler waescht die schmutzigen Teller ab.\n",
    "Tarin Langsattler preist seine Frittatensuppe an.\n",
    "Tarin Langsattler preist seine geroestete Blutwurst an.\n",
    "Tarin Langsattler preist seinen Bohneneintopf an.\n",
    "Tarin Langsattler preist sein Bananensoufflee an.\n",
    "Tarin Langsattler preist seine Spanferkelhaxen an.\n",
    "Tarin Langsattler preist seinen Hirnreiniger an.\n",
    "Tarin Langsattler preist sein Stinkl-Pils an.\n",
    "Tarin Langsattler preist seinen Weintraubensaft an.\n",
    "Tarin Langsattler preist seinen Waldkraeutertee an.\n",
    "Tarin Langsattler preist seinen roten Derlimer an.\n",
    "Tarin Langsattler zapft ein neues Fass an.\n", 
    "Tarin Langsattler presst Weintrauben aus.\n", 
    "Tarin Langsattler kocht neuen Kraeutertee.\n", 
    "Tarin Langsattler holt eine neue Flasche roten Derlimer aus dem Weinkeller.\n",
    "Tarin Langsattler goennt sich selbst einen Schluck roten Derlimer.\n",
    "Tarin Langsattler mischt einen Hirnreiniger zusammen.\n", 
    "Tarin Langsattler kocht Frittatensuppe.\n", 
    "Tarin Langsattler roestet eine Blutwurst.\n", 
    "Tarin Langsattler macht frischen Bohneneintopf.\n", 
    "Tarin Langsattler schaelt Bananen fuer sein Soufflee.\n", 
    "Tarin Langsattler braet ein Spanferkel.\n" 
    "Tarin Langsattler fragt Dich: Darf ich noch was bringen?\n",
    "Tarin Langsattler fragt Dich: Schmeckts?\n",
    "Tarin Langsattler fragt Dich nach Deinen Wuenschen.\n"}) );

  SUID;
  CLONEME("/p/armour/cloak/schuerze" );
  command("trage alles");

  lokalverbot=({});

  AddCmd( ({"kaufe", "kauf", "bestelle", "bestell"}), "lokalverbot_kaufen");
}

int lokalverbot_kaufen(string str)
{
  if( member(lokalverbot,TP)!=-1 )
  {
    write("Tarin Langsattler schreit: Du bekommst nichts!\n");
    return 1;
  }
  else return 0;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( gruppe=="fies" )
    call_out("fies",2+random(3));
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  write("Tarin Langsattler mag das nicht und gibt Dir Lokalverbot.\n"
        "Mit grossen Schwung wirft er Dich aus der Kneipe hinaus.\n\n");
  say("Tarin Langsattler mag das nicht und gibt "+TPN+" Lokalverbot.\n", 
      ({TP}));
  TP->move(ROOM "westweg1", M_GO, "wird von Tarin Langsattler rausgeworfen", 
      "", "wird aus dem Wirtshaus geworfen");
  lokalverbot+=({TP});
}

void reset()
{
  ::reset();
  lokalverbot=({});
}

void init()
{
  ::init();
  if( member(lokalverbot,TP)!=-1)
    call_out("rauswerfen",0); 
}

void rauswerfen()
{
  if(TP && ENV(TP)==MENV )
  {
    write("Tarin Langsattler wirf Dich wieder hinaus.\n"); 
    say("Tarin Langsattler wirft "+TPN+" hinaus.\n", ({TP}) );
    TP->move(ROOM "westweg1", M_GO, "wird von Tarin Langsattler rausgeworfen",
      "", "wird aus dem Wirtshaus geworfen");
    call_out("mitteilen",2);
  }
}  

void mitteilen()
{
  if(TP)
    tell_object(TP, "Tarin Langsattler teilt Dir mit: Du hast immer noch "
                    "Lokalverbot!\n");
}
 
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "deads",
    ctime()+": "+Name(WER,1)+" hat gerade "+CAP(getuid(PL))+" umgebracht.\n");
}
 
varargs void die(int poisondeath)
{
  if( objectp(QueryProp(P_KILLER)) )
     environment(this_object())->set_ban(getuid(QueryProp(P_KILLER)),100);
  ::die(poisondeath);
}

