// /d/huegelland/raballion/hobbits/npc/hobbit.c   
// Ein Hobbit 
// 2002-06-07  Feyaria@SilberLand

inherit "std/mnpc";

#include "../def.h"
#include <exploration.h>

void init()
{
  ::init();
  if (TP && TP->id("HOBBIT")) AddDefender(TP);
}


void create()
{
  string *adj;
  int i;
  if (!is_clone(TO)) return;
  ::create();

  adj=({"klein", "jung", "unerfahren", "schwach", "dick", "lustig", "neugierig", 
      "froehlich", "wandernd", "wanderlustig", "erfahren", "kraeftig", "stark"});
  i=random(sizeof(adj));  
  if( random(100) > 50 )
  {
    SetProp(P_GENDER, MALE);
    SetProp(P_NAME, "Hobbit");
    AddId( ({"hobbit"}) );
    SetProp(P_NAME_ADJ, adj[i] ) ;
    SetProp(P_SHORT, "Ein "+adj[i]+"er Hobbit");
    AddAdjective( ({adj[i], adj[i]+"er", adj[i]+"en"}) );
    SetProp(P_LONG, 
       Name(WER,1)+" schaut Dich neugierig an. Er hat braune Augen und "
       "ebenso braunes, krauses Haar, sowohl am Kopf, als auch "
       "auf den Oberseite seiner Fuesse. Ob seine Fusssohlen behaart sind, "
       "kannst Du nicht erkennen, weil die ja auf dem Boden stehen. "
       "Sein runder Bauch ist sicher durch reichliches Essen entstanden." 
      );
    SetProp(P_SMELL, "Du riechst Spuren von Pfeifenrauch.\n");
  }
  else
  {
    SetProp(P_GENDER, FEMALE);
    SetProp(P_NAME, "Hobbitfrau");
    SetProp(P_NAME_ADJ, adj[i]);
    SetProp(P_SHORT, "Eine "+adj[i]+"e Hobbitfrau");
    AddId( ({"hobbitfrau"}) );
    AddAdjective( ({adj[i], adj[i]+"e"}) );
    SetProp(P_LONG, 
       Name(WER,1)+" schaut Dich laechelnd an. Sie hat dunkelblaue Augen und "
       "gelocktes, braunes Haar, sowohl am Kopf als auch auf den Oberseiten "
       "ihrer Fuesse. Obwohl sie staendig ohne Schuhwerk herumlaeuft, sind "
       "ihre Fuesse erstaundlich sauber. Du bildest Dir sogar ein, dass das "
       "Fusshaar frisch gekaemmt ist. Zu den ueblichen weiblichen Rundungen "
       "kommt noch ein rundlicher Bauch, der auf das bei Hobbits uebliche "
       "reichliche Essen schliessen laesst."
      );
    SetProp(P_SMELL, Name(WER,1)+" riecht nach Lavendeloel.\n");
  }
  create_default_npc(8+i/3);
  SetProp(P_ALIGN, -150+random(600));
  AddId(({"\nhobbit", "FELL_WUSCHEL", }));

  SetProp(P_HANDS, ({" mit blossen Haenden", QueryProp(P_HANDS)[1], DT_BLUDGEON}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 80+random(30));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,10);

  SetProp(P_MSGIN, "wandert herein");
  SetProp(P_MSGOUT, "wandert");
  SetProp(P_MMSGIN, "ist ploetzlich da");
  SetProp(P_MMSGOUT, "ist ploetzlich weg");
  SetProp(P_MNPC_AREA, ("/d/huegelland/") );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hauptplatz");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_LOG_INFO, "raballion/hobbits");

  SetProp(P_DIE_MSG, " stirbt einen Hobbittod.\n");
  AddInfo(DEFAULT_INFO, ({
        "schaut Dich erstaunt an.\n",
        "murmelt: Nie gehoert.",
        "schaut Dich fragend an.",
        "sagt: Frag lieber jemand anderen.\n",
        "sagt: Feyaria hat mir darueber nichts beigebracht.\n",
        "sagt: Vielleicht weiss ja Molkine etwas darueber.\n",
        "sagt: Was soll diese Fragerei?\n",
        "sagt: Ich sage jetzt nichts mehr!\n",
        "ignoriert Deine dumme Frage.\n",
        "lacht sich schief ueber Deine Frage.\n",
        "sagt: Ja.\n",
        "sagt: Nein.\n",
        "sagt: Vielleicht.\n",
        "sagt: Eventuell.\n",
        "sagt: Moeglicherweise.\n",
        "fragt Dich: Meinst Du das im Ernst?\n",
        "sagt: Reden ist Silber, Schweigen ist ein drittes Fruehstueck.\n",
        "antwortet etwas, was Du aber nicht verstehen kannst.\n",
        "antwortet mit vollem Mund und Du verstehst nichts.\n",
        "sagt: Lass mich mal nachdenken.....\n",
        "fragt: Gib mir etwas zu essen, dann sag ich es Dir.\n",
        "sagt: Das ist doch geheim!\n",
        "sagt: Wieso weisst Du das denn nicht?\n",
        "sagt: Sgnlw rzi ph wa grewz hkl.\n",
        "sagt: Dfdrtj kjdfjke gjkel jgkd Tre.\n",
        "sagt: Gdjei tejkdf Eje vhjr Xntre.\n",
        "sagt: Zfber nfhge tje Rerj rehjr gjsbd.\n",
        "sagt: Zfhue djker fjek hmeovnbe.\n",
        "hoert Dir nicht zu.\n",
        "zuckt ratlos mit den Schultern.",
        "sagt: Alles kann selbst ich nicht wissen!",
        "legt den Kopf schief und blickt fragend.",
        "kratzt sich ratlos am Kopf." }) );

  AddLibrary( NPC "infos.lib", 1);
  
  SetProp( P_REJECT, ({ REJECT_KEEP,
    Name(WER,1)+" bedankt sich fuer @WEN.\n" }) );

  SetChats(2, ({
    Name(WER,1)+" schaut sich neugierig um.\n",
    Name(WER,1)+" verzehrt "+QueryPossPronoun(NEUTER,WEN,SINGULAR)+
      " drittes Fruehstueck im Gehen.\n",
    Name(WESSEN,1)+" Magen gibt sonderbare Geraeusche von sich.\n",
    Name(WER,1)+" kaemmt sich "+QueryPossPronoun(NEUTER,WEN,PLURAL)+
      " Fusshaare.\n",
    Name(WER,1)+" laechelt Dich an.\n",
    Name(WER,1)+" fragt Dich: Na, wie gefaellt es Dir hier im Huegelland?\n",
    Name(WER,1)+" sagt: Ich stamme aus Derlim, wie fast alle Hobbits.\n",
    Name(WER,1)+" huepft in die Luft.\n",
    Name(WER,1)+" reibt zufrieden ueber "+QueryPossPronoun(MALE,WEN,SINGULAR)+
      " deutlich sichtbaren Bauch.\n",
    Name(WER,1)+" kaut auf irgendetwas herum.\n",
    Name(WER,1)+" sucht verzweifelt nach Rauchkraucht.\n",
    Name(WER,1)+" ist traurig, weil "+QueryPronoun(WER)+" "+
      QueryPossPronoun(FEMALE,WEN,SINGULAR)+" Pfeife nicht finden kann.\n",
    Name(WER,1)+" schaut sich Deine Ausruestung an.\n",
    Name(WER,1)+" schleicht sich hinter Deinen Ruecken.\n",
    Name(WER,1)+" zupft "+QueryPossPronoun(FEMALE,WEN,SINGULAR)+" Kleidung zurecht.\n",
    Name(WER,1)+" reibt sich die Nase.\n",
    Name(WER,1)+" schaut ziemlich gesaettigt aus.\n",
    Name(WER,1)+" wandert ziellos durch die Gegend.\n",
    Name(WER,1)+" lockert "+QueryPossPronoun(MALE,WEN,PLURAL)+" Finger.\n",
    Name(WER,1)+" knuddelt Dich.\n",
    Name(WER,1)+" schaut gelangweilt nach oben.\n",
    Name(WER,1)+" kichert.\n",
    Name(WER,1)+" holt tief Atem.\n",
    Name(WER,1)+" ueberlegt, ob es nicht gerade Zeit fuers Essen ist.\n",
    Name(WER,1)+" kratzt sich am Kopf.\n",
    Name(WER,1)+" ueberlegt, in welche Richtung es jetzt weitergeht.\n",
    Name(WER,1)+" sagt: Das Huegelland ist das allerschoenste Land.\n",
    Name(WER,1)+" nimmt einen Snack aus "+QueryPossPronoun(MALE,WEM,SINGULAR)+
      " Jausenbeutel.\n"}) );

    SUID;
    if( random(100)<20) 
    {
      CLONEME("/p/weapon/club/wanderstab");
      command("zuecke wanderstab");
    }
    else if( random(100)<20) 
    {
      CLONEME("/p/weapon/knife/dolch");
      command("zuecke dolch");
    }
    if( random(100)<50 )
    {
      CLONEME(OBJ "jausenbeutel");
    } 
    if( random(100)<20 )
    {
      if(QueryProp(P_GENDER)==FEMALE)
        CLONEME("/p/armour/armour/bluse");
      else
        CLONEME("/p/armour/armour/weste");
    }
    if( random(100)<20 )
    {
      if(QueryProp(P_GENDER)==FEMALE )
        CLONEME("/p/armour/trousers/rock");
      else
        CLONEME("/p/armour/trousers/hose");
      if(!random(2) )
        CLONEME("/p/armour/belt/guertel");
    }
    if( random(100)<20 && QueryProp(P_GENDER)==MALE)
    {
      CLONEME("/p/armour/helm/hut");
    } 
    if( random(100)<5 )
    {
      CLONEME("/d/huegelland/feyaria/weg/armour/mantel");
    } 
    command("trage alles");
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( (gruppe=="fies" || gruppe=="intim" || gruppe=="frech") 
      && find_call_out("fies")==-1 && random(2) )
    call_out("fies",0);
  if( (gruppe=="nett" || gruppe=="froh") 
      && find_call_out("nett")==-1 && random(2) )
    call_out("nett",0);
  if( (gruppe=="traurig" || gruppe=="aengstlich")
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
  if( (gruppe=="albern" )
      && find_call_out("lustig")==-1 && random(3) )
    call_out("lustig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  if( !present(TP, MENV) ) return;
  tell_room(MENV, Name(WER,1)+ " aergert sich ueber "+TP->name(WEN)+".\n", 
      ({TP, TO}) );
  tell_object(TP, Name(WER,1)+ " aergert sich ueber Dich.\n");
}

void lustig()
{
  if( !present(TP, MENV) ) return;
  switch(random(4))
  {
    case 0: 
      tell_room(MENV, Name(WER,1)+ " bricht vor Lachen zusammen.\n", ({TO}) );
      break;
    case 1: 
      tell_room(MENV, Name(WER,1)+ " lacht laut.\n", ({TO}) );
      break;
    case 2: 
      tell_room(MENV, Name(WER,1)+ " kichert.\n", ({TO}) );
      break;
    case 3: 
      tell_room(MENV, Name(WER,1)+ " schmunzelt.\n", ({TO}) );
      break;
  }
}

void nett()
{  
  if( !present(TP, MENV) ) return;
  switch( random(3) )
  {
    case 0: tell_room(MENV, Name(WER,1)+ " knuddelt "+TP->name(WEN)+".\n", 
                ({TP, TO}) );
            tell_object(TP, Name(WER,1)+ " knuddelt Dich.\n");
            break;
    case 1: tell_room(MENV, Name(WER,1)+ " flauscht "+TP->name(WEN)+".\n", 
                ({TP, TO}) );
            tell_object(TP, Name(WER,1)+ " flauscht Dich.\n");
            break;
    case 2: tell_room(MENV, Name(WER,1)+ " laechelt "+TP->name(WEN)+" an.\n", 
                ({TP, TO}) );
            tell_object(TP, Name(WER,1)+ " laechelt Dich an.\n");
            break;
  }
}

void traurig()
{
  if( !present(TP, MENV) ) return;
  tell_object(TP, Name(WER,1)+ " troestet Dich.\n");
  tell_room(MENV, Name(WER,1)+ " troestet "+TP->name(WEN)+".\n", ({TP, TO}) );
}

mixed _query_noattack()
{
  if(TP && TP->QueryProp(P_LEVEL)>40)
  {
    return "fleht Dich um Gnade an.\nDu hast Mittleid und brichst den Kampf ab.";
  }
  else
    return 0;
}

void give_notify(object ob)
{
  if( ob->id("Nahrung") )
  {
    if(random(2) )
    {
      call_out("aufheben",2, ob);
      tell_room(MENV,break_string(
            "Danke! Ich habe zwar gerade keinen Hunger, aber ich hebe "
            "es mir fuer spaeter auf!", 78, Name(WER,1)+" sagt: ") );
    }
    else
    {
      EPMASTER->GiveExplorationPoint("hobbitnahrung", EP_MISC);
      call_out("essen",2, ob);
      tell_room(MENV, Name(WER,1)+" sagt: Danke! ich hatte schon solchen Hunger!\n");
    }
  }
  else
    ::give_notify(ob);
}

void essen(object ob)
{
  command("iss "+LOWER(ob->name(RAW)) );
  if( ob )
    command("trink "+LOWER(ob->name(RAW)) );
}

void aufheben(object ob)
{
  command("steck "+LOWER(ob->name(RAW))+" in beutel" );
}
