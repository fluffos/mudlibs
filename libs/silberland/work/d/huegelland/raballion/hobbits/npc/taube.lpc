// /d/huegelland/raballion/hobbits/npc/taube.c   
// Eine Taube 
// 1997-11-02  Feyaria@SilberLand

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  create_default_npc(2+random(4));
  SetProp(P_ALIGN, -50-random(100));
  switch( QueryProp(P_LEVEL))
  {
    case 2:
      switch( random(3)) 
      {
        case 0:
          SetProp(P_SHORT, "Eine kleine Taube");
          SetProp(P_NAME_ADJ, "klein");
          AddAdjective( ({"klein", "kleine"}) ); 
          break;
        case 1:
          SetProp(P_SHORT, "Eine haessliche Taube");
          SetProp(P_NAME_ADJ, "haesslich");
          AddAdjective( ({"haesslich", "haessliche"}) ); 
          break;
        case 2:
          SetProp(P_SHORT, "Eine hungrige Taube");
          SetProp(P_NAME_ADJ, "hungrig");
          AddAdjective( ({"hungrig", "hungrige"}) ); 
          break;
      }
      break;
    case 3:
      switch( random(3) )
      {
        case 0:
          SetProp(P_SHORT, "Eine Taube");
          break;
        case 1:
          SetProp(P_SHORT, "Eine freche Taube");
          SetProp(P_NAME_ADJ, "frech");
          AddAdjective( ({"frech", "freche"}) );
          AddProp(P_ALIGN, -50);
          break;
        case 2:
          SetProp(P_SHORT, "Eine schoene Taube");
          SetProp(P_NAME_ADJ, "schoen");
          AddAdjective( ({"schoen", "schoene"}) ); 
          break;
      }
      break;
    case 4:
      switch( random(3) )
      {
        case 0:
          SetProp(P_SHORT, "Eine grosse Taube");
          SetProp(P_NAME_ADJ, "gross");
          AddAdjective( ({"gross", "grosse"}) ); 
          break;
        case 1:
          SetProp(P_SHORT, "Eine fette Taube");
          SetProp(P_NAME_ADJ, "fett");
          AddAdjective( ({"fett", "fette"}) ); 
          break;
        case 2:
          SetProp(P_SHORT, "Eine dicke Taube");
          SetProp(P_NAME_ADJ, "dick");
          AddAdjective( ({"dick", "dicke"}) ); 
          break;
      }
      break;
    case 5:
      switch( random(3) )
      {
        case 0:
          SetProp(P_SHORT, "Eine riesige Taube");
          SetProp(P_NAME_ADJ, "riesig");
          AddAdjective( ({"riesig", "riesige"}) ); 
          break;
        case 1:
          SetProp(P_SHORT, "Eine gefaehrliche Taube");
          SetProp(P_NAME_ADJ, "gefaehrlich");
          AddAdjective( ({"gefaehrlich", "gefaehrliche"}) ); 
          break;
        case 2:
          SetProp(P_SHORT, "Eine boese Taube");
          SetProp(P_NAME_ADJ, "boes");
          AddAdjective( ({"boes", "boese"}) ); 
          AddProp(P_ALIGN, -150);
          break;
      }
      break;
  }

  SetProp(P_NAME, "Taube");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_LONG, 
    Name(WER,1)+" flattert dauernd um Deinen Kopf herum und nervt Dich dabei "
    "fuerchterlich. Sie hat graue, verknitterte Federn und krumme Beine. "
    "Ihr scheussliches Aussehen wird durch ihre fiesen kleinen roten Augen "
    "noch verstaerkt. Wie eine Verrueckte fliegt sie herum, und versucht, "
    "allen im Raum Anwesenden auf den Kopf zu scheissen...");
  AddId(({"taube", "vogel", "FEDERN_WUSCHEL"}));

  SetProp(P_HANDS, ({" mit ihrem Schnabel", 30, DT_PIERCE}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, QueryProp(P_LEVEL)*5);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "landet hier");
  SetProp(P_MMSGOUT, "fliegt weg");
  SetProp(P_MNPC_AREA, ("/d/huegelland/") );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hauptplatz");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG, " wird zu einer Friedenstaube und stirbt.\n");
  AddInfo(DEFAULT_INFO, "gurrt.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann @WEN gar nicht tragen.\n" }) );

  SetChats(2, ({
    "Du trittst fast auf "+name(WEN,1)+".\n",
    Name(WER,1)+" flattert erschreckt hoch.\n",
    Name(WER,1)+" gurrt.\n",
    Name(WER,1)+" gurrt leise.\n",
    Name(WER,1)+" gurrt laut.\n",
    Name(WER,1)+" breitet ihre Fluegel aus.\n",
    Name(WER,1)+" macht Dir auf den Kopf.\nIHHHH!!!\n",
    Name(WER,1)+" macht Dir fast auf den Kopf.\n",
    Name(WER,1)+" pickt Brotkrumen vom Boden auf.\n",
    Name(WER,1)+" pickt ein Koernchen vom Boden.\n"}) );

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(touch)
    call_out("flucht",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void flucht()
{
  tell_room(MENV, Name(WER,1)+ " erschreckt sich.\n");
  Flee();
}


