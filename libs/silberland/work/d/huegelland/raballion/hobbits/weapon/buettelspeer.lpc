inherit "std/weapon";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId ( ({"speer", "buettelspeer"}) );
  SetProp (P_SHORT, "Ein Buettelspeer");
  SetProp (P_LONG, 
      "Dieser Speer aus Eichenholz hat eine Spitze aus harten Metall "
      "und ist mit Widerhaken bestueckt, um den Schaden zu verstaerken. "
      "Die Buettel von Derlim verwenden solche Speere mit hoechster "
      "Kampfkunst gegen ihre Feinde.");
  SetProp (P_NAME, "Buettelspeer");
  SetProp (P_GENDER, MALE);

  SetProp (P_VALUE, 2600);
  SetProp (P_WEIGHT, 1250);
  SetProp (P_WEAPON_TYPE, WT_SPEAR);
  SetProp (P_DAM_TYPE, ({DT_PIERCE, DT_RIP}));
  SetProp (P_WC, 170);
  SetProp (P_WC_FIX, 35);
  SetProp (P_WC_BONUS, (["\nbingo": 200]) );
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, ([MAT_OAK: 70, MAT_BRASS:30]) );
}

