/*
** Ein Stab
** (w) 1997-09-29 Raballion
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId ( ({"stab", "holzstab", "eichenstab", "eichenholzstab"}) );
  SetProp (P_SHORT, "Ein Stab");
  SetProp (P_LONG, "Dieser Stab aus Eichenholz kann mit etwas Geschick "
    "als ganz brauchbare Waffe dienen.");
  SetProp (P_NAME, "Stab");
  SetProp (P_GENDER, MALE);

  SetProp (P_VALUE, 600);
  SetProp (P_WEIGHT, 1250);
  SetProp (P_WEAPON_TYPE, WT_CLUB);
  SetProp (P_DAM_TYPE, DT_BLUDGEON);
  SetProp (P_WC, 130);
  SetProp (P_WC_FIX, 20);
  SetProp (P_WC_BONUS, (["\nbuettel": 50, "\nbingo": 200]) );
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_OAK);
}

