#include "../def.h"

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>


create()
{
  ::create();
  

  SetProp(P_INT_SHORT, "Tunnelsystem von Derlim" );
  SetProp(P_INT_LONG,
    "Diese Ebene des duesteren Tunnels ist mit grossen Quadern ausgekleidet und "+
    "macht einen recht stabilen Eindruck auf Dich. Von der hohen Decke tropf "+
    "immer wieder etwas herunter und Du vernimmst aus der Ferne leichten "+
    "Laerm. Falls Du umkehren moechtest, jetzt hast Du noch die Gelegenheit. "+
    "Spaeter geht es vielleicht nicht mehr so leicht...");
 
  SetProp(P_LIGHT, 0 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 13, ENV_TERRAIN: TT_CAVE]) );

// standart details fuer die ebenen
#include "details.h"

// standart details fuer diese ebene
#include "details_e1.h"

    
//  AddDetail( ({""}),
//    "");

  AddExit( "osten", "./e1r3_1");
  AddExit( "westen", "./e1r1_1");

//  AddItem (NPC"wauckerl", REFRESH_DESTRUCT);
}


void reset()
{
  ::reset();
}

