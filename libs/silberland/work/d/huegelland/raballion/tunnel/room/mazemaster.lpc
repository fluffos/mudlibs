inherit "/std/thing";

#include "../def.h"

#include <properties.h>
#include <language.h>
#include <ansi.h>
#include <wizlevels.h>
#define MAZEDIR "/d/huegelland/raballion/tunnel/master/"

mapping visit0;
mapping visit1;
mapping visit2;

mixed *map;

create()
{
  if(!is_clone(this_object()))
    return;
  ::create();

  SetProp(P_SHORT, "Mazegenerator");
  SetProp(P_LONG,
    "Dieser Mazegenerator stellt ein Maze her und verwaltet dieses.");

  seteuid(getuid(this_object()));

//  AddDetail(({"" }),
//     "");

  SetProp(P_NAME,"Mazegenerator");
  SetProp(P_GENDER,MALE);
  AddId( ({"maze", "generator", "mazegenerator", "mazemaster"}) );
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
//  SetProp(P_NEVERDROP, 1);
//  SetProp(P_NODROP, "Du kannst die Urne nicht haben und damit auch nicht ablegen.\n");
  SetProp(P_NOGET, "Du den Mazegenerator nicht nehmen, dafuer ist er zu schwer.\n");

  AddCmd( ({"hilfe"}), "helfen");
  AddCmd( ({"gdebug"}), "debug");
  AddCmd( ({"gmaze"}), "CreateMaze");
  AddCmd( ({"gplan"}), "ShowMaze");

prepare();

}

