int helfen(string str)
{
   notify_fail ("Wozu willst Du Hilfe haben?\n");
   if (! stringp(str)) return 0;

   str = lower_case(str);
   if (id(str) == 1)
      {
//      this_player()->More(OBJ "urne.txt",1);
      write ("Zur Zeit keine Hilfe moeglich.\n");
      return 1;
      }
   return 0;
}

int ShowMaze(string str)
{

int i;
int j;
int max_i;
int max_j;


//   notify_fail ("Was willst Du anschauen?\n");
//   if (! stringp(str)) return 0;

//   str = lower_case(str);

// ausgabe
   max_i = sizeof(map);
   write ("  0123456789 123456789 123456789 123456789 123456789\n");
   for (i = 0;i < max_i; i++)
      {
      max_j = sizeof(map[i]);
      if (i <10)
         write (" "+i);
      if (i >= 10)
         write (i);
      for (j = 0;j < max_j; j++)
         {
         write((string)map[i][j]);
         }
      write("\n");
      }
// fertig
   return 1;
}

