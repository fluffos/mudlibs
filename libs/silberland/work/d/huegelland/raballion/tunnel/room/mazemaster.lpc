int prepare()
{
int i;
int j;

  map = allocate (45);
  for (i = 0; i < 45; i++)
     {
     map[i] = allocate(45);
     }
  for (i = 0;i < 45; i++)
     {
     for (j = 0;j < 45; j++)
        {
        map[i][j]= " ";
        }
     }
}


void reset()
{
  ::reset();
}
