// /d/gebirge/feyaria/weg/obj/zweig.c
// Ein Haselzweig
// 23-12-1996  Feyaria@SilberLand

inherit "std/thing";

#include <properties.h>
#include "../def.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp (P_SHORT, "Ein Haselzweig");
  SetProp (P_LONG, 
    "Aus diesem Haselzweig kann man eine schoene Pfeife basteln.\n");
  SetProp (P_NAME, "Haselzweig");
  SetProp (P_GENDER, MALE);
  AddId ( ({"zweig", "haselzweig", "\nhaselzweig"}) );
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 200);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_MISC_DECIDUOUS_WOOD);
  
  AddCmd( ({"bastel", "bastle", "bastl"}), "basteln");

}

int basteln(string str)
{
  object ob;
  if( str == "pfeife" || str == "pfeifchen" )
  {
    if( TP == MENV )
    {
      if( ob=present("taschenmesser", TP) )
      {
        if( ob->QueryProp(P_WIELDED) )
        {
          if( ob->QueryProp(P_WC)>=100 )
          {
            write("Du bastelst ein kleines Pfeifchen aus dem Haselzweig.\n");
            say(CAP(TPN) +" bastelt sich ein kleines Pfeifchen.\n");
            CLONE( OBJ "pfeife", TP);
            call_out("remove",1);
            return 1;
          }
          else
            notify_fail("Bei diesem Messer ist die Schneide zu klein.\n");
        }
        else
          notify_fail("Du solltest das Messer erst einmal zuecken.\n");
      }
      else
        notify_fail("Du brauchst schon ein Messer, um die Pfeife zu basteln.\n");
    }
    else
      notify_fail("Du musst den Haselzweig zuerst nehmen.\n"); 
  }
  else
    notify_fail("Was willst Du basteln?\n");
  return 0;
}
