#pragma strong_types

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "../cheasy_defs.h"
#include "/p/daemon/skillmaster/skillmaster.h"

inherit "std/thing";


void create() {
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_NAME,"nix");
  SetProp(P_SHORT,0);
  SetProp(P_LONG,"Nix.\n");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT,0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP,1);
  SetProp(P_VALUE,0); 
  SetProp(P_KILL_NAME, "Ein Sprung aus grosser Hoehe");
  AddCmd("", "nix",1);
  call_out("nix0", 8);
}

void nix0() {
  tell_object(environment(), BS("Du segelst durch die Luft."));
  call_out("nix1", 3);
}

void nix1() {
  tell_object(environment(), BS("Deine Geschwindigkeit wird groesser und"
    " groesser, und der Wipfel der Tanne kommt immer schneller auf Dich zu.")
    );
  call_out("nix2", 5);
}

void nix2() {
  tell_object(environment(), BS(" Wuuuuusch..... zu kurz! Der Wipfel der"
    " Tanne saust an Dir vorbei!")
    );
  call_out("nix3", 4);
}

void nix3() {
  tell_object(environment(), BS("KRACH! Du rauschst mit Karacho durch die"
    " unteren Aeste der Tanne... Ohohoho, tut das weh!")
    );
  environment()->reduce_hit_point(15);
  call_out("nix4", 3);
}

void nix4() {
  tell_object(environment(), BS("Der Boden rast auf Dich zu... wenn das nur"
    " mal gut geht...")
    );
  call_out("nix5", 2);
}

void nix5() {
  tell_object(environment(), BS("Unter Dir erkennst Du ein dorniges"
    " Gebuesch, das Deinen Fall daempfen koennte...")
    );
  call_out("nix6", 2);
}

void nix6() {
  object *schirm;
  if( environment()->QueryProp(P_RACE)=="Fee" )
  {
    tell_object(environment(), BS(
          "Kurz vor dem Boden beginnst Du heftig mit Deinen kleinen "
          "Fluegeln zu schlagen und setzt sanft am Boden auf."));
    environment()->move(ROOM "0204.lpc", M_GO | M_SILENT);
    tell_room(environment(environment()),
      BS(capitalize(environment()->Name()) +" flattert von oben herein."), 
       ({this_player()}));
    call_out("remove", 0, 1);
    return ;
  }
  if(environment()->is_class_member(CL_FLYING))
  {
    tell_object(environment(), BS(
          "Zum Glueck kannst Du fliegen und setzt sanft am Boden auf."));
    environment()->move(ROOM "0204.lpc", M_GO | M_SILENT);
    tell_room(environment(environment()),
      BS(capitalize(environment()->Name()) +" landet elegant am Boden."), 
       ({this_player()}));
    call_out("remove", 0, 1);
    return ;
  }
  if(environment()->QueryProp(P_ARMOURS))
  {
    schirm=filter_objects(environment()->QueryProp(P_ARMOURS), "id", "sonnenschirm"); 
    if (sizeof(schirm) && objectp(schirm[0]))
    {
      tell_object(environment(), BS(
        "Dein aufgespannter Schirm bremst den Fall so weit, dass Du "
        "gefahrlos am Boden landest."));
      environment()->move(ROOM "0204.lpc", M_GO | M_SILENT);
      tell_room(environment(environment()),
          BS(capitalize(environment()->Name()) +" landet mit aufgeklapptem "+
            schirm[0]->name(RAW)+"."), 
          ({this_player()}));
      call_out("remove", 0, 1);
      return;
    }
  }
  tell_object(environment(), BS("Du saust auf das Gebuesch zu...."));
  if(SKILLMASTER->UseSkill(environment(), SK_LUCK) > 0 || random(10) < 7) 
  {
    // Schwein gehabt... man landet im Gebuesch
    call_out("gebuesch", 1);
  } 
  else 
  {
    // tja, pech gehabt. das wars. ende. finito. Maustot ;-)
    call_out("vorbei", 1);
  }
}

void gebuesch() {
  tell_object(environment(), BS("Du rauschst mit Karacho in ein dorniges"
    " Gebuesch; Dein Einschlag hinterlaesst ein grosses Loch.")
    );
  environment()->reduce_hit_point(33);
  environment()->move(ROOM "0204.lpc", M_GO | M_SILENT);
  tell_room(environment(environment()),
    BS(capitalize(environment()->name()) +" stuerzt laut schreiend aus"
      " grosser Hoehe in ein Gebuesch."), ({this_player()}));
  call_out("remove", 0, 1);
}

void vorbei() 
{
  environment()->move(ROOM "0204.lpc", M_GO | M_SILENT);
  tell_object(environment(), BS("SCHEIBENKLEISTER! Du verfehlst das Gebuesch"
    " ganz knapp. Ob Lars diesmal wieder gnaedig ist? Du nimmst Dir vor,"
    " einfach weniger zu scripten und immer brav die Goetter zu achten und"
    " den Empfehlungen der Magier zu folgen. Dann schlaegst Du auf dem"
    " harten Boden auf...") );
  tell_room(environment(environment()),
    BS(capitalize(environment()->name()) +" stuerzt laut schreiend aus"
      " grosser Hoehe und klatscht neben einem Gebuesch auf den Boden."), 
      ({this_player()}));
  environment()->SetProp(P_DIE_MSG, " stuerzt zu Tode.\n");
  environment()->do_damage(25000, TO);
  environment()->SetProp(P_DIE_MSG, 0);
  call_out("remove", 0, 1);
}

int nix(string str) 
{
  string p;
  // Spieler koennen noch rufen oder schreien, Magier koennen alles
  if (IS_LEARNER(TP)) return 0;
  p = query_verb();
  if (p == "ruf" || p == "rufe" || p == "schrei" || p == "schreie"
      || p == "sag" || p == "sage" || p == "schau" || p == "untersuch"
      || p == "untersuche" || p == "unt" || p=="spanne")
    return 0;
  tell_object(environment(), BS("Das geht nicht! Du koenntest einfach"
    " schreien..."));
  return 1;
}
