// /d/gebirge/feyaria/weg/obj/federn.c
// Adlerfedern
// 1997-01-08  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Adlerfeder");
  SetProp(P_LONG, BS( 
    "Diese Adlerfeder stammt von einem maechtigen Steinadler.") );
  SetProp(P_NAME, "Adlerfeder");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"feder", "adlerfeder"}) );

  SetProp(P_MATERIAL, MAT_FEATHER );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 100);
}
