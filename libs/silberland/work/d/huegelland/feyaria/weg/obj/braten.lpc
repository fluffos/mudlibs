// Ein Hirschbraten
// 21-12-1996  Feyaria@SilberLand

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../def.h"


void create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Hirschbraten");
  SetProp (P_LONG, "Dieser Hirschbraten schmeckt sicher sehr lecker.\n");
  SetProp (P_NAME, "Hirschbraten");
  SetProp (P_GENDER, MALE);
  AddId ( ({"braten", "hirschbraten"}) );
  SetProp (P_VALUE, 1300);
  SetProp (P_WEIGHT, 5000);
  SetProp (P_NOBUY, 1);
  SetProp (P_INFO, BS("Den Hirschbraten kannst Du natuerlich essen."));
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, 
    ([F_HEAL:70+random(70), F_SOAK:33, F_ALCOHOL:0, F_POISON:0]));
}

BeimEssen()
{
  if( QueryProp(P_VALUE) )
    write ("Du schlemmst genuesslich einen Hirschbraten.\nLecker!\n");
  else
    write ("Der Hirschbraten schmeckt ja widerlich! *wuergspuckkotz*\n");
  say (TPN+" schlemmt einen Hirschbraten.\n");
  return ::BeimEssen();
}

void verderben()
{
  if(!ENV(TO))
    call_out("remove",0);
  else
  {
    tell_object(ENV(TO), "Der Hirschbraten verdirbt.\n");
    SetProp (P_FOOD_INFO, 
        ([F_HEAL:10-random(70), F_SOAK:33, F_ALCOHOL:0, F_POISON:2]));
    SetProp (P_VALUE, 0);
    SetProp (P_INFO, BS(
          "Der Hirschbraten ist verdorben. Den sollte man besser nicht essen."));
  }
}

void vergammeln()
{
  if(ENV(TO))
    tell_object(ENV(TO), "Der Hirschbraten vergammelt.\n");
  call_out("remove", 1);
}

void reset()
{
  ::reset();
  if (QueryProp(P_VALUE))
  {
    if (!random(7)) 
      verderben();
  }
  else
    vergammeln();
}

