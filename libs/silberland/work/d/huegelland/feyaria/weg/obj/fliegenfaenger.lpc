#include "../def.h"
#include "../squest.h"

inherit "/std/thing";

int fliegen;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  fliegen=0;
  SetProp(P_SHORT, "Ein Fliegenfaenger");
  SetProp(P_LONG, BS(
    "Der Fliegenfaenger ist ein langer Stock, auf dem sich eine klebrige "
    "Fluessigkeit befindet. Hat sich eine gierige Fliege einmal da "
    "draufgesetzt, bleibt sie kleben und kommt nie wieder weg. Man braucht "
    "den Fliegenfaenger also nur ein paar mal durch einen Fliegenschwarm "
    "zu schwingen, und man hat jede Menge Fliegen damit gefangen.")+
    "@@fliegen_anzahl@@");
  SetProp(P_NAME, "Fliegenfaenger");
  SetProp(P_GENDER, MALE);
  AddId( ({"fliegenfaenger", "faenger", "stock", "\nfliegenfaenger"}) );

  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP,"Du sollst doch Fliegen damit fangen!\n");
  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:98,MAT_MISC_FLUID:2]) );

  AddCmd( ({"schwing", "schwinge"}), "schwingen");
}

int schwingen(string str)
{
  object squest;
  notify_fail("Was willst Du schwingen?\n");
  if( !str ) return 0;
  if( !id(str) ) return 0;
  if( !squest=present(SPINNENQUEST_ID, TP) ) return 0;
  if( present("\nspinnenfutter", TP) )
  {
    write(BS("Du kommst drauf, dass Du eigentlich eh schon genuegend Fliegen "
             "gefangen hast und wirfst den Fliegenfaenger weg."));
    call_out("remove",0);
    return 1;
  }
  say(CAP_TPN+" schwingt einen Stock in der Luft herum.\n");  
  if( !ENV(TP)->QueryProp(P_DETAILS)["fliegenschwarm"])
  {
    write("Du schwingst Deinen Fliegenfaenger, aber keine Fliege bleibt "
          "daran haengen.\n");
    return 1;
  }
  write("Du schwingst Deinen Fliegenfaenger und einige Fliegen bleiben "
        "daran haengen.\n");
  fliegen+=1+random(TP->QueryAttribute(A_DEX)/2);
  if( fliegen>5+TP->QueryProp(P_LEVEL) )
  {
    write(BS("Da Du nun genug Fliegen hast, sammelst Du die gefangenen "
             "Fliegen ein und wirfst den Fliegenfaenger weg."));
    CLONE( OBJ "spinnenfutter", TP);
    squest->set_quest(SQ_SPINNENFUTTER);
    call_out("remove",0);
  }
  return 1;
}

string fliegen_anzahl()
{
  if( !fliegen )
    return "Es haengen zur Zeit keine Fliegen daran.";
  else if( fliegen == 1)
    return "Zur Zeit haengt eine Fliege daran.";
  else
    return "Zur Zeit haengen "+fliegen+" Fliegen daran.";
}

