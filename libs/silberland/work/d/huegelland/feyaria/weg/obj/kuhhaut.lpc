// /d/gebirge/feyaria/weg/obj/kuhhaut.c
// Eine Kuhhaut
// 1997-01-01  Feyaria@SilberLand

inherit "std/thing";

#include <properties.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp (P_SHORT, "Eine Kuhhaut");
  SetProp (P_LONG, "Das war einmal die Haut einer Kuh.\n");
  SetProp (P_NAME, "Kuhhaut");
  SetProp (P_GENDER, FEMALE);
  AddId ( ({"haut", "kuhhaut"}) );

  SetProp (P_VALUE, 400);
  SetProp (P_WEIGHT, 500);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_SKIN);
}
