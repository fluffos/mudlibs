// /d/gebirge/feyaria/weg/obj/monster.c
// Ein monstermacher,der aus einem Spieler ein grosses Monster macht
// 1997-01-04  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <new_skills.h>

string *verb;
int transformed = 0;

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  verb= ({"aechze", "fauche", "flippe", "fluche", "grunze", "grummel", 
          "keuche", "knirsche", "knurre", "ruelpse", "sabbere", "spucke",
          "schnaube", "schnaufe", "schreie", "stampfe", "tritt alle"});

  SetProp(P_SHORT, "Ein Monstermacher");
  SetProp(P_LONG, BS( 
    "Der Monstermacher ist ein kleiner, unscheinbarer Stein. aber es steckt "
    "vermutlich viel mehr dahinter als nur ein Stein.") );
  SetProp(P_INFO, BS(
    "Mit dem Monstermacher kannst Du Dich in ein graessliches Monster "
    "verwandeln. Die Syntax dazu ist 'mach aus mir ein monster'. Die "
    "Auswirkungen sind immer anders und nie vorherzusehen.") );
  SetProp(P_NAME, "Monstermacher");
  SetProp(P_GENDER, MALE);
  AddId( ({"monstermacher", "macher"}) );

  SetProp(P_MATERIAL, ({MAT_STONE, MAT_MAGIC}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  AddCmd( "mach", "mach_monster");
  AddCmd( ({"'", ","}) , "sagen", 1);
  AddCmd( "sag", "sagen", 1);
  AddCmd( ({":"}), "emoten", 1);
  AddCmd( ({"emote"}), "emoten");
  AddCmd( ({";"}), "gemoten", 1);
  AddCmd( ({"gemote"}), "gemoten");
  AddCmd( "ruf", "rufen", 1);
  AddCmd( ({"fluchtrichtung", "teil", "erzaehl", "gespraech", "vorsicht", 
        "antwort", "erwieder", "erhoeh", "lern", "denk"}),
          "nixda",1);
  AddCmd( ({  "kuess", "knutsch", "lieb", "knuddel", "knuddle", "knabbber", 
        "kuschel", "schmieg", "lach", "waelz", "kicher", "wein", "zitter", 
        "denk", "laechel", "freu", "lob",  "philosophier", "troest", "fuercht"}),
          "nixda",1);
  AddCmd( ({"rknudd", "rwink", "rgrat", "rumarm", "rwusch", "rdank", "rtroest",
            "rkitz", "rkusch", "rtr", "rkraul", "rschnurr", "rgrins" }),
           "nixda",1);
  AddCmd( ({"nn", "rubrik", "artikel", "inhalt", "schreibe", "note", "reply", 
        "ende", "quit"}), "nixda", 0);
  AddCmd( ({"fknuddel", "fknuddle", "fwinke", "frufe", "femote", "fwer",
            "verachte", "biete"}), "freunde");
  AddCmd( ({"-", "ebene"}), "nixda", 1);

  AddCmd( ({"beherrschung", "schnell", "blutrausch", "willenskraft", "eifer",
        "ausweichen" }), "nospell");
  AddCmd( ({"feuerball", "pfeil", "identifiziere", "schaetz", "blitz",
        "drider", "dunkellanze", "dunkelheit", "terrorblitz", "kontrolliere"}), 
      "zauber");
  AddCmd( ({"kampfschrei", "kopfstoss", "rammen", "zertreten", "riesenkraft", 
        "spalten", "eisenhaut", "waffenkunde"}), "zauber");
  AddCmd( ({"behandle", "entfluche", "erblicke", "goetterschutz",
        "gottheilung", "gottsegen", "heiligengebet", "heiligenschein",
        "lokation", "massenheilung", "meditation", "reparatur", "ruestungssegen",
        "schildparade", "spiegelschild", "talisman", "verbannung", 
        "waffensegen", "wundenblick", "zielattacke"}), "zauber");
  AddCmd( ({"laehme", "elementarhand", "erkenne", "elementarpanzer", 
        "erzpfeil", "wasserpfeil", "luftpfeil", "feuerpfeil", "eispfeil", 
        "erzstrahl", "froststrahl", "wasserstrahl", "windstoss", 
        "erdbeben", "hagelschlag", "sturmflut", "windhose", "feuersturm"}), 
      "zauber");
  SUID;
}

int size, hands, body; 

int mach_monster(string str)
{
  int dauer;
  if( str!="aus mir monster" ) return 0;
  if( TP->QueryProp(P_GENDER) == NEUTER )
  {
    notify_fail("Du bist doch schon ein Monster!\n");
    return 0;
  }
  TP->SetProp(P_FROG,0);
  TP->SetProp(P_GHOST,0); 
  write(BS( "Du verwandelst Dich in ein grausiges Monster. Deine Haut "
   "brennt wie die Hoelle, und darum ziehst Du alle Kleidungsstuecke aus."));
  say(CAP(TPN)+" verwandelt sich in ein grausiges Monster.\n");
  TP->command_me("ziehe alles aus");
  dauer =60*(random(10)+3);
  TP->SetProp(P_NEXT_SPELL_TIME,time()+30);
  TP->ModifySkillAttribute(TP, SA_SPEED, 150, dauer );
  TP->ModifySkillAttribute(TP, SA_DAMAGE, 222, dauer );
  TP->SetProp(P_SP,0);


  if( IS_SEER(TP) )
    TP->comamnd_me("fluchtrichtung trete alle");
  TP->command_me("ebenen aus");
  TP->SetProp(P_WIMPY,0);
  TP->Set(P_TITLE, symbol_function("title", TO), F_QUERY_METHOD);
  TP->Set(P_GUILD_TITLE, symbol_function("title", TO), F_QUERY_METHOD);
  TP->Set(P_RACE, symbol_function("race", TO), F_QUERY_METHOD);
  TP->Set(P_GENDER, symbol_function("gender", TO), F_QUERY_METHOD);
  size=300+random(300);
  TP->Set(P_SIZE, symbol_function("size", TO), F_QUERY_METHOD);
  TP->Set(P_WEIGHT, symbol_function("weight", TO), F_QUERY_METHOD);
  hands=2+random(3) ;
  TP->Set(P_MAX_HANDS, symbol_function("hands", TO), F_QUERY_METHOD);
  body=20+random(50);
  TP->Set(P_BODY, symbol_function("body", TO), F_QUERY_METHOD);
  TP->Set(P_HP_DELAY, symbol_function("null", TO), F_QUERY_METHOD);
  TP->Set(P_SP_DELAY, symbol_function("null", TO), F_QUERY_METHOD);
  TP->Set(P_FROG, symbol_function("null", TO), F_QUERY_METHOD);
  TP->Set(P_WIMPY, symbol_function("null", TO), F_QUERY_METHOD);
  SetProp (P_X_ATTR_MOD, 
      ([ A_INT:-random(5)-3, 
         A_STR:random(11)+5,
         A_DEX:random(8)-2,
         A_CON:random(4)+1]) );
  SetProp (P_X_HEALTH_MOD, 
      ([ P_HP:20+random(50), 
         P_SP:-random(TP->QueryProp(P_MAX_SP)/2)-random(100) ]) ); 
  SetProp (P_X_MAX_HEALTH_MOD, 
      ([ P_HP:20 + random(20), 
         P_SP:-random(100) ]) ); 
  TP->UpdateAttributes();
  call_out("mach_normal", dauer );
  call_out("verben", 2+random(4) );
  transformed = 1;
  return 1;
}

string title() { return "das Monster"; }

string race() { return "Monster";}

int gender() { return NEUTER; }

int size() { return size;}

int weight() { return size*1000;}

int max_hands() { return hands;}

int body() { return body;}

int null() { return 0;}

void mach_normal()
{
  if( !objectp(MENV) ) TO->remove();
  write("Du wirst wieder normal.\n");
  say(CAP(MENV->Name())+ " wird wieder normal.\n");
  MENV->command_me("ziehe alles aus");
  MENV->Set(P_TITLE, 0, F_QUERY_METHOD);
  MENV->Set(P_GUILD_TITLE, 0, F_QUERY_METHOD);
  MENV->Set(P_RACE, 0, F_QUERY_METHOD);
  MENV->Set(P_GENDER, 0, F_QUERY_METHOD);
  MENV->Set(P_SIZE, 0, F_QUERY_METHOD);
  MENV->Set(P_WEIGHT, 0, F_QUERY_METHOD);
  MENV->Set(P_MAX_HANDS, 0, F_QUERY_METHOD);
  MENV->Set(P_BODY, 0, F_QUERY_METHOD);
  MENV->Set(P_HP_DELAY, 0, F_QUERY_METHOD);
  MENV->Set(P_SP_DELAY, 0, F_QUERY_METHOD);
  MENV->Set(P_FROG, 0, F_QUERY_METHOD);
  MENV->Set(P_WIMPY, 0, F_QUERY_METHOD);
  SetProp (P_X_ATTR_MOD, 0 ); 
  SetProp (P_X_HEALTH_MOD, 0 ); 
  SetProp (P_X_MAX_HEALTH_MOD, 0);
  MENV->UpdateAttributes();
  MENV->command_me("ebenen ein");
  while( remove_call_out("verben")!=-1) ;
  transformed = 0;
  
  if( !random(5) )
    TO->remove();
}

string extra_look()
{
  if( MENV->QueryProp(P_GENDER) == NEUTER )
    return sprintf( MENV->Name()+ " ist ein ueber 3 Meter grosses Monster mit %d "
                 "riesigen Haenden.\n", MENV->QueryProp(P_MAX_HANDS) );
  else
   return "";
}

int sagen(string str)
{
  if( TP->QueryProp(P_GENDER) == NEUTER )
  {
    notify_fail("Was willst Du sagen?\n");
    if(!str) return 0;
    write(break_string( str,78, "Du sagst: "));
    say("Das Monster "+TPN+ " bruellt etwas unverstaendliches.\n");
    return 1;
  }
  return 0;
}

int emoten(string str)
{
  if( TP->QueryProp(P_GENDER) == NEUTER )
  {
    write(TPN+" "+str+".\n");
    say( "Das Monster "+ TPN+ " fuchtelt wild mit seinen "+
        TP->QueryProp(P_MAX_HANDS)+" Haenden herum.\n");
    return 1;
  }
  return 0;
}

int gemoten(string str)
{
  if( TP->QueryProp(P_GENDER) == NEUTER )
  {
    write(TPN+"s "+str+".\n");
    say( "Das Monster "+ TPN+ " fuchtelt wild mit seinen "+
        TP->QueryProp(P_MAX_HANDS)+" Haenden herum.\n");
    return 1;
  }
  return 0;
}

int rufen(string str)
{
  if( TP->QueryProp(P_GENDER) == NEUTER )
  {
    write("Deine Kehle ist zu unfoermig zum Rufen.\n");
    return 1;
  }
  return 0;
}

int nixda(string str)
{
  if( TP->QueryProp(P_GENDER) == NEUTER )
  {
    write("An solche Sachen denkt ein Monster doch gar nicht!\n");
    return 1;
  }
  return 0;
}


void verben()
{
  if( !MENV || MENV->QueryProp(P_GENDER)!=NEUTER ) 
  {
    mach_normal();
    remove();
    return;
  }
  MENV->command_me(verb[random(sizeof(verb))]);
  call_out("verben", 3+random(15) );
}

int freunde()
{
  if( MENV->QueryProp(P_GENDER) == NEUTER )
  {
    write("Als Monster hast Du keine Freunde!\n");
    return 1;
  }
  return 0; 
}

varargs int remove(int silent)
{
  if( TO && MENV && query_once_interactive(MENV) &&
     MENV->QueryProp(P_GENDER) == NEUTER && transformed)
    mach_normal();
  return ::remove(silent);
}

int zauber(string str)
{
  if( MENV->QueryProp(P_GENDER) == NEUTER && transformed)
  {
    if( !random(3) )
    {
      write("Du gruebelst: Wie ging das nochmal???\n");
      MENV->SetProp(P_NEXT_SPELL_TIME,time()+random(6)+1);
      MENV->AddSp(-random(25));
      return 1;
    }
  }
  return 0;
}

int nospell(string str)
{
  if( MENV->QueryProp(P_GENDER) == NEUTER && transformed)
  {
    if( random(20) )
    {
      write("Du gruebelst: Wie ging das nochmal???\n");
      TP->SetProp(P_NEXT_SPELL_TIME,time()+random(2)+1);
      TP->AddSp(-random(15));
      return 1;
    }
  }
  return 0;
}
