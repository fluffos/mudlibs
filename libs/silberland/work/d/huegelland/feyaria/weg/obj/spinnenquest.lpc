// Questobjekt fuer Spinnenfutter-Quest
// 1998-08-62 Feyaria@SilberLand

#include "../def.h"
#include "../squest.h"

inherit "std/thing";

int quest;

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "");
  AddId( SPINNENQUEST_ID );

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_INVIS, 1);
  SUID;
}

int set_quest(int stufe)
{
  string po_uid;

  po_uid = explode(getuid(PO),".")[<1];
  if(po_uid!="feyaria" && po_uid!="raballion") return 0;
  quest|=stufe;
  DB("SPINNENQUEST: "+TPN+" ist bei Punkt: "+quest+" "+QSTRING[stufe]+"\n");
  WLOG( LOG "spinnenquest.log", " ist bei Punkt: "+QSTRING[stufe]);
  return quest;
}

int query_quest()
{
  return quest;
}

