#include "../def.h"
inherit "/std/thing";

void create()
{
  if( !IS_CLONE(TO) ) return ;
  ::create();

  SetProp(P_SHORT, "Einige kleine Murmeln");
  SetProp(P_LONG, BS(
    "Einige kleine Murmeln in verschiedenen Farben, wie sie oft von jungen "
    "Hobbits zum spielen verwendet werden."));
  SetProp(P_NAME, "Murmeln");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"murmeln", "\nhirtenjunge_murmeln"}) );

  AddDetail( ({"farben"}),
    "Die Murmeln funkeln in allen moeglichen Farben.");

  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 100);
  SetProp(P_NOSELL, 1);
  SetProp(P_MATERIAL, ([MAT_GLASS:100]) );

  AddCmd( ({"spiel", "spiele"}), "spielen");
}

int spielen(string str)
{
  notify_fail( "Mit WAS willst Du spielen?\n");
  if( !str ) return 0;
  if( str =="mit murmeln" || str == "mit murmel" )
  {
    write(BS( "Du spielst mit dem Murmeln. Wie wunderschoen diese bunten "
      "kleinen Dinger doch herumrollen und im Sonnenlicht funkeln! " ) );
    say( CAP_TPN+" spielt mit kleinen Murmeln. Wie kindisch!\n");
    return 1;
  }
  return 0;
}

