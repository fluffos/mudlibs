// ein Vergissmeinnicht zum pfluecken
// 20-02-97  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Dustyveilchen");
  SetProp(P_LONG, BS( 
    "Dieses gelbe Veilchen hat einen wunderbaren Duft. Unter "
    "Gebirgsbewohnern ist diese Blume auch unter dem Namen "
    "'Dustyveilchen' bekannt.") );
  SetProp(P_NAME, "Dustyveilchen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"veilchen", "blume", "dustyveilchen"}) );

  SetProp(P_MATERIAL, MAT_PLANT );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_SMELL, "Das Veilchen riecht einfach himmlisch.\n");
}
