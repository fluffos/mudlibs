// Hoerner eines Stieres
// 1998-11-28  Feyaria@SilberLand

inherit "std/thing";

#include <properties.h>
#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Stierhoerner");
  SetProp (P_LONG, 
    "Die maechtigen Hoerner eines Stieres. Sie sind stark gebogen und sehr "
    "spitz. Es sieht sicher schneidig aus, wenn man sie an einem Helm "
    "befestigt.");
  SetProp (P_NAME, "Stierhoerner");
  SetProp (P_PLURAL, 1);
  SetProp (P_GENDER, NEUTER);
  AddId ( ({"hoerner", "stierhoerner"}) );

  SetProp (P_VALUE, 150);
  SetProp (P_WEIGHT, 233);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_HORN);

  AddCmd( ({"befestige", "befestig"}), "befestigen");
}

mapping new_material( mapping m1, mapping m2, int w1, int w2)
{
  mapping newmat, newmat1, newmat2;
  string *mat, *mat2;
  int *perc, *perc2;
  int w, i;

  w = w1 + w2;
  mat=m_indices(m1);
  perc=m_values(m1);
  mat2=m_indices(m2);
  perc2=m_values(m2);
  newmat1=([]);
  newmat2=([]);

  for(i=sizeof(mat);i--;i>=0)
    newmat1+=([mat[i]:perc[i]*w1/w]);
  for(i=sizeof(mat2);i--;i>=0)
    newmat2+=([mat2[i]:perc2[i]*w2/w]);
//  DB(sprintf("%O\n%O\n",newmat1,newmat2));
  mat+=mat2;

  newmat = ([]);
  while(sizeof(mat))
  {
    newmat += ([mat[0]: newmat1[mat[0]] + newmat2[mat[0]] ]);
    mat -= ({mat[0]});
  }
//  DB(sprintf("NEWMAT: %O\n", newmat));

  w = 0;
  for(i=sizeof(newmat);i--;i>=0)
    w += m_values(newmat)[i];

  if(w != 100)
    newmat[m_indices(newmat)[0]] = m_values(newmat)[0] + 100 - w;

//  DB(sprintf("NEWMAT: %O\n", newmat));
  return newmat;
}

int befestigen(string str)
{
  string s1, s2;
  object helm;
  string *old_adj, *mat, *mat2;
  int i,ac, w1,w2,w,*perc, *perc2;
  mapping newmat, newmat1, newmat2;
  notify_fail("Was willst Du an was befestigen?\n");
  if( !str ) return 0;
  if( sscanf(str, "%s an %s", s1, s2) != 2 ) return 0;
  if( !id(s1) ) 
    return notify_fail("Das kannst Du nicht an "+CAP(s2)+" befestigen!\n"),0;
  if( !helm=present(s2, TP) )
    return notify_fail("Aber Du hast ja gar kein "+CAP(s2)+"!\n"),0;
  if( helm->QueryProp(P_ARMOUR_TYPE) != AT_HELMET )
    return notify_fail("Du kannst die Stierhoerner nur an einem Helm "
        "befestigen!\n"),0;
/*  if(function_exists("long",helm)[0..4] != "/std/" || 
      function_exists("short",helm)[0..4] != "/std/")
    return notify_fail( BS("Irgendwie ist "+helm->name(WER,1)+" nicht "
        "geeignet, um die Stierhoerner daran zu befestigen.")),0; -- Schwachsinn :) @Gwenshara*/
  if( helm->QueryProp(P_EFFECTIVE_WC) )
    return notify_fail(BS("An "+helm->name(WEM,1)+" kannst Du die Stierhoerner "
        "nicht befestigen, weil da schon Hoerner oder so etwas aehnliches "
        "befestigt sind.")),0;
  if( helm->QueryProp(P_WEIGHT)>3000)
    return notify_fail(BS("An "+helm->name(WEM,1)+" kannst Du die Stierhoerner "
        "nicht befestigen, weil "+helm->QueryPronoun(WER)+" sonst zu schwer "
        "wuerde.")),0;
  
  write("Du befestigst die Stierhoerner an "+helm->name(WEM,1)+".\n");
  say(CAP_TPN+" befestigt Stierhoerner an "+helm->name(WEM,0)+".\n", ({TP}) );

  helm->SetProp(P_SHORT, helm->QueryProp(P_SHORT)+ " mit Stierhoernern");
  helm->SetProp(P_LONG, helm->QueryProp(P_LONG)+ "Maechtige Stierhoerner "
      "sind darauf befestigt.");
  helm->AddAdjective( ({"gehoernt", "gehoernter", "gehoernten", "gehoernte"}) );
  if( !old_adj=helm->QueryProp(P_NAME_ADJ) )
    old_adj=({});
  helm->SetProp(P_NAME_ADJ, old_adj+ ({"gehoernt"}) );

  if( (ac=helm->QueryProp(P_AC))<13-helm->QueryProp(P_DAMAGED) )
    helm->SetProp(P_AC, ac+random(3) );
  helm->Set(P_WEIGHT, 
      w=((w1=helm->QueryProp(P_WEIGHT))+(w2=QueryProp(P_WEIGHT))) );
  helm->SetProp(P_TOTAL_WEIGHT, helm->QueryProp(P_WEIGHT));
  helm->SetProp(P_MATERIAL, 
      new_material(helm->QueryProp(P_MATERIAL), QueryProp(P_MATERIAL), w1, w2));
  helm->SetProp(P_EFFECTIVE_WC, 100+random(50));
  remove();
  return 1;
}
  
