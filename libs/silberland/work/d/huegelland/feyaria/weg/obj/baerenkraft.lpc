// /d/huegelland/feyaria/weg/obj/baerenkraft.c
// Baerenkraft, nachdem man ein Baerensteak gegessen hat.
// 20-02-97  Feyaria@SilberLand

#include "../def.h"

inherit "std/thing";

private nosave object owner;

void create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0); 
  SetProp(P_NAME, 0);
  AddId( ({"\nbaerenkraft"}) );

  SetProp(P_MATERIAL, MAT_MAGIC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0 );
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_INVIS, 1);
  seteuid(getuid(this_object()));

  SetProp( P_X_ATTR_MOD, ([ A_STR: 1, A_CON: random(2) ]) );
  call_out("do_remove", (35+random(35))*60);
}

void init()
{
  ::init();
  if( MENV && interactive(MENV) )
  {
    MENV->UpdateAttributes();
    tell_object(MENV, "Du fuehlst Dich nun stark wie ein Baer.\n");
    DB("*** " + MENV->Name(WER) + " bekommt Baerenkraefte!\n");
  }
}

void do_remove()
{
  if( MENV)
  {
    MENV->UpdateAttributes();
    tell_object(MENV, "Die Baerenkraft verlaesst Dich.\n");
    SetProp (P_X_ATTR_MOD, 0 );
    MENV->UpdateAttributes();
  }
  remove();
}

