// /d/huegelland/feyaria/weg/obj/woole.c
// Schafwolle 
// 1998-10-19  Feyaria@SilberLand

inherit "std/thing";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp (P_SHORT, "Schafwolle");
  SetProp (P_LONG, 
    "Diese Wolle stammt von einem Schaf.");
  SetProp (P_NAME, "Schafwolle");
  SetProp (P_GENDER, FEMALE);
  AddId ( ({"wolle", "schafwolle"}) );

  SetProp (P_MATERIAL, MAT_WOOL);
  SetProp (P_VALUE, 20);
  SetProp (P_WEIGHT, 30);
}

