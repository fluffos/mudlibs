#include "../def.h"
inherit "/std/thing";

void create()
{
  if( !IS_CLONE(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein Haeufchen toter Fliegen");
  SetProp(P_LONG, BS(
    "Dieses Haeufchen toter Fliegen laesst sich sicher gut als "
    "Spinnenfutter verwenden."));
  SetProp(P_NAME, "Spinnenfutter");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"futter", "spinnenfutter", "fliegen", "haeufchen", 
          "haeufchen fliegen", "\nspinnenfutter"}) );

  SetProp(P_WEIGHT, 2);
  SetProp(P_VALUE, 0);
  SetProp(P_NODROP,"Du sollst die Fliegen doch an die Spinne verfuettern!\n");
  SetProp(P_MATERIAL, ([MAT_MISC_DEAD:50, MAT_CHITIN:50]) );

  AddCmd( ({"fuetter", "fuettere", "verfuetter", "verfuettere"}), "fuettern");
}

int fuettern( string str)
{
  string str1, str2;
  notify_fail("Was willst Du an wen verfuettern?\n");
  if( !str ) return 0;
  if( sscanf(str, "%s an %s",str1, str2)!=2 )
    return 0;
  if( id(str1) && (str2=="spinne" || str2=="giftspinne") )
  {
    if( present("dodo", ENV(TP)) )
    {
      write("Du verfuetterst die Fliegen an die Spinne.\n");
      present("dodo", ENV(TP))->spinnenfutter();
    }
    else
      write("Warte lieber damit, bis Dodo wieder da ist...\n");
    return 1;
  }
  return 0;
}

