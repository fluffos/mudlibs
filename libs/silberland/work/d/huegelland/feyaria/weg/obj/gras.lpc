// /d/gebirge/feyaria/weg/obj/gras.c
// Ein Bueschel Gras
// 28-02-1997  Feyaria@SilberLand

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../def.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Bueschel Gras");
  SetProp (P_LONG, "Ein Bueschel saftiges Gras.\n");
  SetProp (P_NAME, "Grasbueschel");
  SetProp (P_GENDER, NEUTER);
  AddId ( ({"gras", "grasbueschel", "bueschel", "\nentenfutter"}) );
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 30);
  SetProp (P_MATERIAL, MAT_PLANT);
  SetProp (P_FOOD_INFO, 
    ([F_HEAL:0, F_SOAK:2, F_ALCOHOL:0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du wuergst das Grasbueschel hinunter.\nDu bist wirklich "+
    (TP->QueryProp(P_GENDER)==FEMALE ? "eine fanatische Vegetarierin" :
    "ein fanatischer Vegetarier")+ "!\n");
  say ( CAP(TPN)+" wuergt ein Bueschel Gras hinunter.\n");
  return ::BeimEssen();
}

