// /d/gebirge/feyaria/weg/npc/khirsch.c
// Ein Kronenhirsch
// 22-10-1996  Feyaria@AnderLand 
// 21-12-1996  Feyaria@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kronenhirsch");
  SetProp(P_LONG, BS(
    "Vor Dir steht ein maechtiger Kronenhirsch mit hellbraunem Fell und "
    "grauem Kinnbart. Seinen Namen hat er von dem maechtigen Geweih, das "
    "auf seinem Kopf sitzt wie eine Krone. An dem Geweih haengen noch "
    "einige Stuecke Bast, es ist dem Hirsch also gerade erst neu "
    "gewachsen."));
  SetProp(P_NAME, "Kronenhirsch");
  SetProp(P_GENDER, MALE);
  AddId( ({"hirsch", "kronenhirsch", "\nkronenhirsch", "FELL_WUSCHEL"}) );

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinem maechtigen Geweih", 150, DT_PIERCE}));
  SetProp(P_RACE, "Hirsch");
  SetProp(P_SIZE, 150+random(10));
  SetProp(P_ALIGN, 150);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "springt aus den Bueschen heraus");

  AddInfo(DEFAULT_INFO, "roehrt ganz laut.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_DIE_MSG, " verwandelt sich in einen Hirschbraten.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    "Der Kronenhirsch kann nichts mit Deinen Sachen anfangen.\n"}));

  SetChats(3, ({
    "Der Kronenhirsch roehrt ganz laut.\n",
    "Der Kronenhirsch schuettelt kleine Stueckchen Bast von seinem neuen "
      "Geweih.\n",
    "Der Kronenhirsch schnaubt leise.\n",
    "Der Kronenhirsch knabbert an den Blaettern der Baeume.\n",
    "Der Kronenhirsch reibt sein Geweih an einem Jungbaum.\n"}) );

  SetProp(P_SPELLRATE,15);
  AddSpell(1,350,
    "Der Kronenhirsch rammt Dich mit seinem maechtigen Geweih.\n",
    "Der Kronenhirsch rammt @WEN mit seinem maechtigen Geweih.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetProp (P_CORPSE, OBJ "braten");
  SetProp (P_CORPSE_FLAGS, COR_NOSETWEIGHT | COR_NOINVTRANSFER);
  SetProp (P_CORPSE_PROPS, ([]) );

  seteuid(getuid(TO));
  
  create_geweih()->move(TO);
  command("zuecke geweih");
}

object create_geweih()
{
  object o;
  
  o = clone_object("std/weapon");
  o->SetProp(P_SHORT, "Ein Hirschgeweih");
  o->SetProp(P_LONG, BS(
     "Das ist das Geweih eines grossen Kronenhirsches. Mit seinen "
     "zwanzig Enden ist es sicher ein schoene Jagdtrophaee."));
  o->SetProp(P_NAME, "Hirschgeweih");
  o->SetProp(P_GENDER, NEUTER);
  o->AddId(({"geweih", "hirschgeweih"}));
  o->SetProp(P_VALUE, 1250+random(100));
  o->SetProp(P_WEIGHT, 2100+random(120));
  o->SetProp(P_MATERIAL, MAT_HORN);
  o->SetProp(P_WEAPON_TYPE, WT_SPEAR);
  o->SetProp(P_DAM_TYPE, DT_PIERCE);
  o->SetProp(P_WC, 125+random(10));
  o->SetProp(P_NR_HANDS, 2);
  return o;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Kronenhirsch ) "
               " -%d EP\n", lostexp) );
}
