// /d/gebirge/feyaria/weg/npc/bergziege.c
// Eine Bergziege
// 30-12-1996  Feyaria@SilberLand
// 24-07-2001  Ronja@SL

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

int milch;

create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Bergziege");
  SetProp(P_LONG,
    "Das ist eine der kleinen Bergziegen, die auch noch in den hoechsten "
    "Gebirgsregionen ueberleben koennen. Sie hat ein dichtes, zotteliges, "
    "weisses Fell und kleine, aber spitze Hoerner. Sie beachtet Dich kaum, "
    "sondern knabbert an einem Busch herum."
  );

  SetProp(P_NAME, "Bergziege");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"ziege", "bergziege", "\nbergziege", "FELL_WUSCHEL"}) );

  AddDetail( ({"fell"}),
    "Die Bergziege hat ein zotteliges, weisses Fell.");

  create_default_npc(11);
  SetProp(P_HANDS, ({" mit ihren Hoernern", 110, DT_PIERCE}));
  SetProp(P_RACE, "Ziege");
  SetProp(P_SIZE, 110);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_WIMPY, 15);
  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "fluechtet laut meckernd");

  AddInfo(DEFAULT_INFO, "meckert.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_DIE_MSG, " verschwindet toedlich verwundet in den Bueschen.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Die Bergziege kann nichts mit Deinen Sachen anfangen.\n"}));

  SetChats(3, ({
    "Die Bergziege meckert.\n",
    "Die Bergziege knabbert an den Blaettern der Buesche.\n",
    "Die Bergziege frisst die letzte Himbeere auf.\n"}) );

  SetProp(P_SPELLRATE,15);
  AddSpell(1,150,
    "Die Bergziege trifft Dich mit ihren kleinen Hufen.\n",
    "Die Bergziege trifft @WEN mit ihren kleinen Hufen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  milch = 1;
  AddCmd( ({"melk","melke"})      , "cmd_melken");

}

void reset()
{
  ::reset();
  milch = 1;
}

int cmd_melken(string str)
{
  object kanne;

  notify_fail("Wen moechtest Du melken?\n");

  if(!str || str == "") return 0;
  if(!id(str)) return 0;

  if(!(kanne=present("milchkanne",TP)))
  {
    tell_object(TP,"Du hast ja garkeine Milchkanne dabei.\n");
    return 1;
  }

  if(kanne->QueryStat())
  {
    tell_object(TP,"Deine Mlchkanne ist doch schon voll.\n");
    return 1;
  }

  if(!present("melkschemel",TP))
  {
    tell_object(TP,"Du hast ja gar keinen Melkschemel dabei.\n");
    return 1;
  }

  if(!milch)
  {
    tell_object(TP,"Diese Ziege hat keine Milch mehr.\n");
    return 1;
  }

  tell_object(TP, BS(
    "Du setzt Dich auf deinen Melkschemel, stellst die Milchkanne unter "
    "die Ziege und faengst an, die Ziege zu melken. Puuuh, ist das muehsam. "
    "Doch mit der Zeit geht Dir das Melken leichter von der Hand und Du "
    "bekommst Deine Milchkanne doch noch mit leckerer Ziegenmilch voll. "
  ));

  tell_room(ENV(TO),BS(
    CAP(TPN)+" setzt sich auf einen Melkschemel und faengt an die Ziege "
    "zu melken. Nach einiger Zeit ist Kanne sogar voll geworden. "
  ),({TP}));

  milch = 0;
  kanne->SetStat(3);
  return 1;
}

