// /d/gebirge/feyaria/weg/npc/murmeltier.c   
// Ein Murmeltier
// 28-12-1996  Feyaria@SilberLand

inherit "std/npc";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Murmeltier");
  SetProp(P_LONG, BS(
    "Das Murmeltier hat ein braeunliches Fell, einen plumpen Koerper und "
    "einen kurzen Stummelschwanz. Es scheint fast zu Grinsen, denn Du "
    "kannst die grossen Nagezaehne sehen."));
  SetProp(P_NAME, "Murmeltier");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"murmeltier", "FELL_WUSCHEL"}) );
  AddDetail( ({"fell"}),
    "Das Fell des Murmeltieres ist braeunlich.");
  AddDetail( ({"schwanz", "stummelschwanz"}),
    "Das Murmeltier hat einen kurzen Stummelschwanz.");
  AddDetail( ({"zaehne", "zahn", "nagezaehne", "nagezahn"}),
    "Das Murmeltier grinst Dich mit seinen grossen Nagezaehnen an.");

  create_default_npc(9);
  SetProp(P_HANDS, ({" mit seinen scharfen Zaehnen", 100, DT_RIP}));
  SetProp(P_RACE, "Nagetier");
  SetProp(P_SIZE, 50+random(10));
  SetProp(P_ALIGN, 150);
  SetProp(P_MAX_HANDS, 4);

  AddInfo(DEFAULT_INFO, "pfeift.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Das Murmeltier will @WEN nicht.\n"}));
  SetProp(P_DIE_MSG, " verschwindet toedlich getroffen in seiner Hoehle.\n");
  SetProp(P_NOCORPSE, 1 );

  SetChats(2, ({
    "Das Murmeltier pfeift einen Warnpfiff.\n",
    "Das Murmeltier schaut sich um.\n",
    "Das Murmeltier murmelt vor sich hin.\n",
    "Das Murmeltier spielt mit kleinen Murmeln.\n",
    "Das Murmeltier verschwindet in der Hoehle und kommt sofort wieder "
       "heraus.\n",
    "Das Murmeltier pfeift.\n"}) );

  SUID;
  if( random(100)>33 )
    CLONEME( ARMOUR "murmeltierfell");
  command_me("trage alles");
}

void init()
{
  ::init();
  if( random(2) && find_call_out("pfeifen")!=-1 )
    call_out("pfeifen",0);
}

void pfeifen()
{
  tell_room(MENV, "Das Murmeltier pfeift einen Warnpfiff.\n");
}

