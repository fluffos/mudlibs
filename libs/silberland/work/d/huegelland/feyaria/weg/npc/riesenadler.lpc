// Ein riesiger Adler
// 1997-11-26  Feyaria@SilberLand
// 1998-02-15  an verschiedene Punkte im Sl fliegen
//

inherit "std/npc";

#include "../def.h"
#include <bank.h>

int mymoney = 0;
object player = 0;

void create()
{
  object ob;
  int i;
  if (!is_clone(TO)) return;
  ::create();

  mymoney=0;
  SetProp(P_SHORT, "Ein riesiger Adler");
  SetProp(P_LONG, BS(
    "Dieser Adler ist wirklich riesig. Er ist ueber 3 Meter gross und hat "
    "sicher eine Fluegelspannweite von ueber 7 Metern. Er hat schwarze "
    "Federn, scharfe Faenge und einen spitzen Schnabel. Er hat ein seltsames "
    "Ledergestell auf dem Ruecken, das fast wie ein Sitz aussieht. "
    "Vielleicht kann man ja auf diesem Adler reiten?"));

  SetProp(P_NAME, "Adler");
  SetProp(P_KILL_NAME, "Ein Riesenadler");
  SetProp(P_NAME_ADJ, "riesig");
  SetProp(P_GENDER, MALE);
  set_living_name("riesenadler");
  AddId( ({"adler", "riesenadler", "Adler"}) );
  AddAdjective( ({"riesig", "riesigen", "riesigem", "riesiger"}) );
  AddDetail( ({"faenge"}),
    "Der Faenge sind so gross und so scharf wie ein Schwert.");
  AddDetail( ({"schnabel"}),
    "Der Schnabel ist spitz und fast so gross wie Du selber.");  
  AddDetail( ({"feder", "federn", "alderfeder", "adlerfedern"}),
    "Der Adler hat schoene, schwarze Federn.");
  
  create_default_npc(38);
  SetProp(P_HANDS, ({" mit seinen scharfen Faengen", 430, DT_RIP}));
  SetProp(P_XP, QueryProp(P_XP)+1500*100);
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 300+random(20));
  SetProp(P_ALIGN, 600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_AIR       : -0.7, DT_COLD      : -0.3, DT_SOUND     : -0.2,
         DT_LIGHTNING :  0.2, DT_FIRE      : -0.2, DT_MAGIC     :  0.3 ]) );

  AddInfo(DEFAULT_INFO, "kreischt.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "kreischt: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Adler will @WEN nicht.\n"}));
  SetProp(P_DIE_MSG, " loest sich in einem Federhaufen auf.\n");

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MMSGIN, "fliegt herein");
  SetProp(P_MMSGOUT, "fliegt weit weg");
  SetProp(P_MSGOUT, "fliegt");

  SetProp(P_SPELLRATE, 70);
  AddSpell(9, 700, 
    "Der riesige Adler greift Dich mit seinem spitzen Schnabel an.\n",
    "Der riesige Adler greift @WEN mit seinem spitzen Schnabel an.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 1800, 
    "Der riesige Adler stuerzt Dich die Klippe hinunter.\n",
    "Der riesige Adler stuerzt @WEN die Klippe hinunter.\n",
    DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  SUID;
  for(i=0;i<random(5)+2;i++)
    CLONEME( OBJ "federn");
  
  if( random(2) )
  {
    ob = clone_object("/gilden/druidenzirkel/obj/focus");
    ob->SetVariables("luft", 2 + random(2) + !random(3) + !random(10));
    ob->move(TO, M_NOCHECK);
  }

  AddCmd( ({"reite", "reit"}), "reiten" );
}

string random_dest(int r)
{
  if( !r ) r=random(6)+1; 
  switch(r)
  {
    case 1: return "/d/polar/lamuerte/dorf/rooms/steg"; break;
    case 2: return "/d/dschungel/feyaria/felseninsel/room/felsen"; break;
    case 3: return "/d/dschungel/feyaria/dorf/room/baum-0b0"; break;
    case 4: return "/d/kristallwald/sargola/wald/room/4_0602"; break;
    case 5: return "/d/ebene/Midas/room/kirchturm"; break;
    case 6: return "/d/wasser/dante/zinsel/room/steg1"; break;
    case 7: return "/d/wueste/protheg/kraterrand/room/krater_1_4_0"; break;
  }
}
 
int reiten( string str)
{
  string str1, dest, str2, wohin, dummy;
  int price;

  if (player && TP != player) return 0;
  notify_fail("Auf wem willst Du reiten?\n");
  if( !str ) return 0;
  price= 500+30*TP->QueryProp(P_LEVEL);
  sscanf(str, "auf %s", str1);
  if( sscanf(str, "auf %s nach %s", str2, wohin)==2 ) ;
  else if( sscanf(str, "auf %s auf %s", str2, wohin)==2) ;
  else if( sscanf(str, "auf %s zur %s", str2, wohin)==2) ;
  else if( sscanf(str, "auf %s zu %s", str2, wohin)==2) ;
  else if( sscanf(str, "auf %s zum %s", str2, wohin)==2) ;
  else sscanf(str, "auf %s in %s", str2, wohin);
  if( id(str) || id(str1) || (id(str2) && !random(33)) )
    dest=random_dest(0);
  else if( id(str2) )
  {
    switch(wohin)
    {
      case "smoersky":
      case "norden":
      case "polar": 
      case "polargebiet": 
      case "eishoehle":
        dest = random_dest(1); price+=random(500); break;
      case "felseninsel":
      case "insel":
      case "sueden":
        dest = random_dest(2); price+=random(200); break;
      case "dschungel":
      case "dschungelelfen":
      case "ulme":
      case "blutulme":
        dest = random_dest(3); price+=random(350); break;
      case "kristallwald":
      case "eiche":
      case "kristalleiche":
        dest = random_dest(4); price-=random(100); break;
      case "midas":
      case "kirche":
      case "kirchturm":
        dest = random_dest(5); price-=random(50); break;
      case "zombieinsel":
      case "zombies":
      case "zombie":
      case "zinsel":
        dest = random_dest(6); price+=random(1500); break;
      case "wueste":
      case "quaul":
      case "krater":
      case "kraterrand":
        dest = random_dest(7); price+=random(2000); break;
      default: 
        dest = random_dest(0);
    }
  }    
  if( id(str) || id(str1) || id(str2) )
  {
    if( TP->QueryMoney() < price )
    {
      write(BS("Der riesige Adler kreischt Dich aergerlich an und laesst Dich "
            "nicht aufsitzen. Vielleicht solltest Du das naechste mal "
            "mehr Geld bereithalten!"));
      return 1;
    }
    TP->AddMoney(-price);
    mymoney+=price;
    write(BS("Du kletterst auf den Ruecken des riesigen Adlers und setzt "
             "Dich auf das Ledergestell. Der Adler erhebt sich und fliegt "
             "weit weg."));
    write("\n\n");
    write(BS("In rasender Geschwindigkeit naehert sich der Adler seinem "
             "Ziel und setzt Dich ab. Bis du begreifst, wo Du jetzt bist, "
             "ist der Adler schon auf und davon."));
    write("\n\n");
    say(CAP_TPN+" klettert auf den Ruecken des riesigen Adlers.\n", ({TP,TO})); 
    TP->move(dest, M_TPORT|M_NO_SHOW, "", 
            "reitet auf einem riesigen Adler davon", 
            "wird von einem riesigen Adler abgesetzt"); 
    if (player)
      deep_remove();
    else
      say("Kurze Zeit darauf kehrt der Adler wieder in seinen Horst zurueck.\n");
    return 1;
  }
  return 0;
}


void init()
{
  ::init();
  if ( TP && TP->id("Adler")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( gruppe=="fies" && find_call_out("fies")==-1)
    call_out("fies",0);
  if( gruppe=="intim" && find_call_out("intim")==-1)
    call_out("intim",0);
  if( ((gruppe=="nett" || gruppe=="froh"))
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
  if( ((gruppe=="traurig" || gruppe=="aengstlich"))
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  command_me("emote kreischt zornig auf.");
}

void intim()
{
  tell_object(TP, Name(WER,1)+" schmiegt sich an Dich an.\n");
  tell_room(MENV, Name(WER,1)+" schmiegt sich an "+TP->name(WEN)+" an.\n", ({TP, TO}) );
}

void traurig()
{
  tell_object(TP, Name(WER,1)+ " troestet Dich.\n");
  tell_room(MENV, Name(WER,1)+ " troestet "+TPN+".\n", ({TP, TO}) );
}

void reset()
{
  if (!is_clone(TO)) return;
  ::reset();
  if( mymoney )
    ZENTRALBANK->PayIn(mymoney);
  mymoney=0;
  if (player)
    deep_remove();
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Riesenadler ) "
               " -%d EP\n", lostexp) );
}

void die(int poisondeath)
{
  object ob;
  write_file(LOG "adler.kills",
    dtime(time())+": "+CAP(getuid(TP))+" toetet den Riesenadler.\n");

  // Fuer Zechprellerquest
  if(QueryProp(P_KILLER))
    ob = present("\nzechpreller_quest_11", QueryProp(P_KILLER));
  if(objectp(ob))
    ob->Mark();
  
  ::die(poisondeath);
}

void set_player(object _player)
{
  player = _player;
  SetProp(P_NOATTACK, "ist doch das Reittier von " + player->name(WEM) + "!");
}

