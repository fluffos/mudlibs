// /d/gebirge/feyaria/weg/npc/reiher.c   
// Ein Loeffelreiher
// 27-12-1996  Feyaria@SilberLand

inherit "std/npc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Loeffelreiher");
  SetProp(P_LONG, BS(
    "Der Loeffelreiher hat einen grossen, loeffelfoermigen Schnabel und "
    "sehr lange Beine, mit denen er im Sumpf sicher nicht versinkt."));
  SetProp(P_NAME, "Loeffelreiher");
  SetProp(P_GENDER, MALE);
  AddId( ({"loeffelreiher", "reiher"}) );
  AddDetail( ({"loeffel", "schnabel"}),
    "Der Loeffelreiher hat einen grossen, loeffelfoermigen Schnabel.");
  AddDetail( ({"bein", "beine"}),
    "Der Loeffelreiher hat sehr lange Beine, mit denen er im Sumpf sicher "
    "nicht versinkt.");

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit seinen loeffelfoermigen Schnabel", 80,
                     DT_BLUDGEON}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 130+random(20));
  SetProp(P_ALIGN, -20);

  SetProp(P_MSGIN, "stelzt herein");
  SetProp(P_MSGOUT, "stelzt");
  SetProp(P_MMSGIN, "stelzt herein");
  SetProp(P_MMSGOUT, "stelzt weit weg");

  AddInfo(DEFAULT_INFO, "schaut Dich nur an.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Loeffelreiher will Deine Sachen nicht.\n"}));

}
