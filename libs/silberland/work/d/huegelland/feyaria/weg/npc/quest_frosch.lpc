
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "../def.h"
#include "../squest.h"

inherit "std/mnpc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  AddId("\nspinnenquest_frosch");
  AddCmd( ({"steck", "stecke"}), "stecken");
}

int stecken(string str)
{
  object squest;
  object stock;
  if(!squest=present(SPINNENQUEST_ID, TP) ) return 0;
  if( str=="stock in froschmaul" || str=="stock in maul" ||
      str=="holzstock in froschmaul" || str=="holzstock in maul" )
  {
    if( stock=present("stock", TP) )
    {
      if( present("fliegenfaenger", TP) || present("spinnenfutter", TP) )
      {
        write("Du brauchst doch gar keinen Fliegenfaenger mehr.\n");
        return 1;
      }
      if( squest->query_quest()==SQ_DODO_BEFRAGT+SQ_JUNGE_BEFRAGT+ 
          SQ_MURMEL_GEFUNDEN+SQ_MURMEL_ABGELIEFERT)
      {
        write(BS("Du steckst den Stock in das Maul des Frosches und sofort "
              "ueberzieht sich der Stock mit einer klebrigen Fluessigkeit - "
              "Du hast jetzt einen echten Fliegenfaenger."));
        tell_room(MENV,CAP_TPN+" steckt einen Stock in das Maul des "
            "Frosches.\n", ({TP}) );   
        stock->remove();
        CLONE(OBJ "fliegenfaenger", TP);
        squest->set_quest(SQ_FLIEGENFAENGER);
      }
      else
      {
        write(BS("Dir faellt eigentlich kein Grund ein, warum Du den Stock "
              "in das Maul des Frosches stecken solltest und laesst es darum "
              "bleiben."));
      }
      return 1;
    }
    write("Dazu brauchst Du erstmal einen Stock.\n");
    return 1;
  }
  write("Was willst Du in wen stecken?\n");
  return 1;
}
