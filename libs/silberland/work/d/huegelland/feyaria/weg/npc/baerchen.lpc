// /d/gebirge/feyaria/weg/npc/baerchen.c
// ein Baerchen
// Cheasy@AnderLand
// 1996-12-21 Feyaria@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include "../cheasy_defs.h"
#include "../def.h"

init() 
{
  object defender;
  ::init();
  if (defender = present("PapaBaer")) AddDefender(defender);
  if (defender = present("MamaBaer")) AddDefender(defender);
}

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Braunbaerchen");
  SetProp(P_LONG, BS("Das Braunbaer-Junge guckt drollig in die Gegend."));
  SetProp(P_NAME, "Braunbaerchen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"braunbaerchen", "baerchen", "baer", "FELL_WUSCHEL"}) );

  AddDetail( ({"krallen","kralle"}),
    "Die Krallen der Baerchens sind noch nicht so gefaehlich wie die der "
    "grossen Baeren, aber sie sind trotzdem ziemlich scharf.");

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen ", 120, DT_RIP}) );
  SetProp(P_RACE, "Baer");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN,"trollt herein");
  SetProp(P_MSGOUT,"trollt sich nach");
  SetProp(P_WEIGHT, 70000);
  SetProp(P_MAX_WEIGHT, 200000);
  SetProp(P_RESISTANCE, ({DT_COLD}) );

  SetChats(7, ({
    "Das Baerchen quietscht vergnuegt.\n",
    "Das Baerchen schnueffelt an Dir herum.\n",
    "Das Baerchen schnueffelt neugierig an Deinen Sachen herum.\n",
    "Das Baerchen schaut Dich treuherzig an.\n",
    "Das Baerchen will mit Dir spielen.\n",
    "Das Baerchen tollt herum.\n",
    "Das Baerchen bettelt um Milch.\n",
    "Das Baerchen brummt leise.\n",
    "Das Baerchen brummt.\n",
    "Das Baerchen kuschelt sich in das Nest.\n",
    "Das Baerchen grunzt.\n"}) );
  SetAttackChats(10, ({
    "Das Baerchen fiept.\n",
    "Das Baerchen jammert.\n"}) );

  SetProp(P_DIE_MSG, " fiept ein letztes Mal.\n" );
  AddInfo(DEFAULT_INFO,"schnueffelt neugierig.\n");
  SetProp(P_REJECT, ({ REJECT_GIVE, "Das Baerchen sucht Milch.\n" }) );

  SUID;
  CLONEME( "/p/armour/cloak/baerenfell");
  command("trage alles");
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Braunbaerchen ) "
               " -%d EP\n", lostexp) );
}
