// /d/gebirge/feyaria/weg/npc/ente.c   
// Eine Ente
// 25-12-1996  Feyaria@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <exploration.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Ente");
  SetProp(P_LONG, BS(
    "Die Ente watschelt auf und ab und schnattert dabei sehr laut. "
    "Scheinbar hat sie grossen Hunger."));
  SetProp(P_NAME, "Ente");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"ente"}) );

  create_default_npc(7);
  SetProp(P_HANDS, ({" mit ihrem breiten Schnabel", 60, DT_SQUEEZE}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 25);
  SetProp(P_ALIGN, 100);
  SetProp(P_WEIGHT, 10000);
  SetProp(P_WIMPY, 10);
  SetProp(P_RESISTANCE, ({DT_WATER}) );
  SetProp(P_DIE_MSG, " wird nie wieder schnattern.\n");

  SetProp(P_MSGIN, "watschelt herein");
  SetProp(P_MSGOUT, "watschelt");
  SetProp(P_MMSGIN, "watschet herein");
  SetProp(P_MMSGOUT, "watschelt weit weg");

  AddInfo(DEFAULT_INFO, "schnattert.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    "Die Ente will das nicht essen.\n"}));

  SetChats(3, ({
    "Die Ente putzt sich ihr Gefieder.\n",
    "Die Ente schnattert laut.\n",
    "Die Ente bettelt um Essen.\n",
    "Die Ente schaut Dich hungrig an.\n",
    "Die Ente streicht ihre Federn glatt.\n",
    "Die Ente reisst etwas Gras aus.\n",
    "Die Ente watschelt im Kreis herum.\n"}) );

  AddCmd( ({"fuetter", "fuettere"}), "fuettern");
}

void give_notify(object ob)
{
  if( ob->id("\nentenfutter") || ob->id("semmel") || ob->id("brot") )
  {
    tell_room(MENV, "Die Ente frisst gierig alles auf.\n");
    ob->remove();
    EPMASTER->GiveExplorationPoint("entenfutter", EP_MISC);
    return;
  }
  ::give_notify(ob);
}

int fuettern(string str)
{
  notify_fail("Warum so kompliziert? Gib der Ente einfach das Futter!\n");
  return 0;
}
