// /d/huegelland/feyaria/weg/npc/stier.c
// Ein Stier
// 1998-08-06  Feyaria@SilberLand

inherit "std/mnpc";

#include "../def.h"
#include <mnpc.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein Stier");
  SetProp(P_LONG, BS(
    "Der Stier ist um einiges groesser als die Kuehe. Auch seine Hoerner "
    "sind sehr gross und schauen recht gefaehrlich aus. Er hat einen "
    "breiten, muskuloesen Koerper mit vier Beinen und einem langen Schwanz "
    "mit einer Quaste. Besser Du kommst ihm nicht zu nahe, vor allem, wenn "
    "Du etwas Rotes traegst."));
  SetProp(P_NAME, "Stier");
  SetProp(P_GENDER, MALE);
  AddId( ({"stier", "FELL_WUSCHEL"}) );

  AddDetail( ({"kopf", "horn", "hoerner", "koerper", "bein", "beine",
               "schwanz", "quaste", "bauch", "maul"}),
    "Schaut genauso aus wie bei jedem anderen Stier auch.");

  create_default_npc(19);
  SetProp(P_HANDS, ({" mit seinen grossen Hoernern", 190, DT_PIERCE}));
  SetProp(P_RACE, "Kuh");
  SetProp(P_SIZE, 160+random(10));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  
  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "weidet weiter");  
  SetProp(P_MNPC_AREA, ROOM "kweide" );
  SetProp(P_MNPC_WAIT, ({ 20, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "kweide5");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "muuht.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    "Der Stier kann mit @WEM nichts anfangen.\n"}));

  SetChats(2, ({
    "Der Stier laesst einen Kuhfladen fallen.\n",
    "Der Stier macht: MUUUUH!!!\n",
    "Der Stier schaut Dich boesartig an.\n",
    "Der Stier beobachtet Dich aufmerksam.\n",
    "Der Stier laeuft ploetzlich auf Dich zu.\n",
    "Der Stier stampft mit seinen Beinen auf den Boden.\n",
    "Der Stier senkt seine gefaehrlichen Hoerner.\n",
    "Der Stier scharrt mit seinen Beinen am Boden.\n",
    "Der Stier muuht.\n"}) );

  SetProp(P_DIE_MSG,
    " faellt tot zu Boden.\nDu fuehlst Dich wie ein siegreicher Torrero.\n");

  AddCmd( ({"melke", "melk"}), "melken");
  CLONEME( OBJ "stierhoerner" );
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  string wie;
  if( !touch ) return;
  wie=adverb;
  if( gruppe=="fies" && find_call_out("kill")==-1 )
  {
    call_out("kill",2+random(4));
    wie="boesartig";
  }
  if( find_call_out("react")==-1 )
    call_out("muuhen",0,wie);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void muuhen(string adverb)
{
  if( present(TP, MENV) )
  {
    write(Name(WER,1)+" muuht Dich "+(adverb?adverb: "laut")+" an.\n");
    say(Name(WER,1)+" muuht "+TP->name(WEN)+(adverb? " "+adverb:"")+" an.\n",
        ({TP}) );
  }
}

void kill()
{
  if( IS_LEARNING(TP) )
    write(break_string("Wenn Du kein Magier waerest, wuerde ich Dich jetzt "
        "dafuer toeten, "+TPN+"!",78, "Der Stier teilt Dir mit: "));
  else
  {
    if( present(TP, MENV) )
    {
      write("Der Stier stuermt auf Dich zu und rammt Dir seine Hoerner in den "
          "Bauch.\n");
      Kill(TP);
    }
  }
}

void init()
{
  int i;
  object* arm;
  ::init();
  if( TP && TP->id("kuh") && !random(30) )
    tell_room(MENV, "Der Stier besteigt die Kuh.\n");
  if( TP && TP->id("hirtenjunge") )
    AddDefender(TP);
/*   Todo: Stier soll alle angreifen, die was rotes Tragen.... 
  if( TP && interactive(TP) && arm=TP->QueryProp(P_ARMOURS) )
  {
    for(i=sizeof(arm)-1;i>-1;i--)
    {
      if( ( strstr(arm[i]->QueryProp(P_LONG), " rot",0)!=-1 ) || 
         (  strstr(arm[i]->QueryProp(P_SHORT), " rot",0)!=-1 ))
      {
        call_out("rot",0);
        break;
      }
    }
  }
*/
}

void rot()
{
  if( present(TP, MENV) )
  {
    write("Der Stier hat etwas Rotes an Dir entdeckt und fuehlt sich "
        "provoziert.\n");
    StartReaction("rot", "fies",0,1);  
  }
}

int melken(string str)
{
  notify_fail("Wen willst Du melken?\n");
  if( !str ) return 0;
  if( str=="stier" )
  {
    write("Einen Stier melken? Das wird wohl ins Auge gehn!\n");
    StartReaction("melken","fies",0,1);
    return 1;
  }
  return 0;
}

void InformDefend(object enemy)
{
  Kill(enemy);
}
