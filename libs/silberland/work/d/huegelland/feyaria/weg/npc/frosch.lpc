// /d/gebirge/feyaria/weg/npc/frosch.c
// ein Frosch
// 1996-12-27 Feyaria@SilberLand

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "../def.h"

inherit NPC "quest_frosch";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Frosch");
  SetProp(P_LONG, "Der Frosch hat eine gruen glaenzenden Haut und quakt nur "
      "laut vor sich hin und beachtet Dich gar nicht. In seinem riesigen Maul "
      "siehst Du eine klebrige Zunge, die hinundwieder herausschnellt und eine "
      "Fliege faengt.");
  SetProp(P_NAME, "Frosch");
  SetProp(P_GENDER, MALE);
  AddId ( ({"frosch", "SCHUPPEN_WUSCHEL"}) );

  create_default_npc (4);
  SetProp(P_HANDS, ({" mit seiner langen Zunge", 40, DT_WHIP}));
  SetProp(P_RACE, "Frosch");
  SetProp(P_SIZE, 12);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "huepft herein");

  AddInfo(DEFAULT_INFO, "quakt laut.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Frosch beachtet Deine Sachen gar nicht.\n"}));

  AddDetail( ({"maul"}),
    "Das Maul ist so gross, dass man da sicher etwas hineinstecken kann. "
    "Nur wird da sicher alles sehr klebrig werden.");
}
