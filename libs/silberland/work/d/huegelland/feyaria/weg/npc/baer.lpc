// /d/gebirge/feyaria/weg/npc/baer.c
// der Braunbaer-Papa
// Cheasy@AnderLand
// 1996-12-21 Feyaria@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>
#include <wizlevels.h>
#include "../cheasy_defs.h"

#define ATTACK_LEVEL 100 

init() 
{
  ::init();
  if ( (2*TP->QueryProp(P_LEVEL) + TP->QueryAttribute(A_INT)
       + TP->QueryAttribute(A_DEX) + TP->QueryAttribute(A_STR)
       + TP->QueryAttribute(A_CON)) > (ATTACK_LEVEL + random(40))
       && query_once_interactive(TP) && !IS_LEARNER(TP) )
    Kill(TP);
}

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Braunbaer");
  SetProp(P_LONG, BS("Der Braunbaer schaut griesgraemig drein. Du moechtest"
    " lieber nicht mit seinen Krallen Bekanntschaft schliessen."));
  SetProp(P_NAME, "Braunbaer");
  SetProp(P_GENDER, MALE);
  AddId( ({"braunbaer", "baer", "PapaBaer", "FELL_WUSCHEL"}) );

  AddDetail( ({"krallen", "kralle", "gebiss"}),
    "Der Braunbaer hat scharfe Krallen und ein gefaehrliches Gebiss.");

  create_default_npc(22);
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen ", 260, DT_RIP}) );
  SetProp(P_RACE, "Baer");
  SetProp(P_SIZE, 250);
  SetProp(P_ALIGN, -180);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE, ({DT_COLD}) );
  SetProp(P_WEIGHT, 180000);
  SetProp(P_MAX_WEIGHT, 240000);
  SetProp(P_MSGIN,"trollt herein");
  SetProp(P_MSGOUT,"trollt sich nach");

  SetProp(P_SPELLRATE, 10);
  AddSpell(2,350,
    "Der Braunbaer schleudert Dich zu Boden.\n",
    "Der Braunbaer schleudert @WEN zu Boden.\n",
     DT_BLUDGEON, "boden", ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,650,
    "Der Braunbaer greift Dich mit seinem Gebiss an.\n",
    "Der Braunbaer greift @WEN mit seinem Gebiss an.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetProp(P_DIE_MSG, " stoehnt ein letztes Mal.\n" );
  AddInfo(DEFAULT_INFO,"brummt.\n");
  SetProp(P_REJECT, ({ REJECT_GIVE, "Der Braunbaer schaut gelangweilt.\n"}));

  SetChats(3, ({
    "Der Braunbaer brummt.\n",
    "Der Braunbaer knurrt.\n"}) );
  SetAttackChats(10, ({
    "Der Braunbaer faucht.\n",
    "Der Braunbaer kratzt Dich.\n"}) );

  seteuid(getuid(this_object()));
  CLONEME( "/p/armour/cloak/baerenfell");
  command("trage alles");
}

void InformDefend(object enemy) 
{
  Kill(enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Braunbaer ) "
               " -%d EP\n", lostexp) );
}

void boden(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, random(3));
}


public varargs void die(int poisondeath) {
  object task;
  
  task = present("\nbard_gs8_task", TP);
  if(objectp(task)) {
    task->bear_killed();
  }

  return ::die(poisondeath);
}