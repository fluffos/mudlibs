// /d/gebirge/feyaria/weg/npc/baerin.c
// die Braunbaer-Mama
// Cheasy@AnderLand
// 1996-12-21 Feyaria@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>
#include <wizlevels.h>
#include "../cheasy_defs.h"

// ATTACK_LEVEL is the sum of all stats and the player level. the baer 
// attacks only players with stats better than attacklevel.
#define ATTACK_LEVEL 100 

init()
{
  object tp;
  ::init();
  if ( (2*TP->QueryProp(P_LEVEL) + TP->QueryAttribute(A_INT)
       + TP->QueryAttribute(A_DEX) + TP->QueryAttribute(A_STR)
       + TP->QueryAttribute(A_CON)) > (ATTACK_LEVEL + random(30))
       && query_once_interactive(TP) && !IS_LEARNER(TP) )
    Kill(TP);
  if (tp = present("PapaBaer")) AddDefender(tp);
}

create()
{
  if (!is_clone(this_object())) return;

  ::create();

  SetProp(P_SHORT, "Eine Braunbaerin");
  SetProp(P_LONG, BS("Die Braunbaerin schaut grimmig drein. Sicher willst "
    "Du Ihr Gebiss lieber nicht kennenlernen."));
  SetProp(P_NAME, "Braunbaerin");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"braunbaer", "baer", "baerin", "MamaBaer", "braunbaerin",
           "FELL_WUSCHEL"}) );

  AddDetail( ({"gebiss"}),
    "Die Braunbaerin hat ein scharfes Gebiss."); 
  AddDetail( ({"krallen"}),
    "Die Krallen der Braunbaerin sind sehr scharf und gefaehrlich.");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit ihren scharfen Krallen ", 250, DT_RIP}) );
  SetProp(P_RACE, "Baer");
  SetProp(P_ALIGN, -90);
  SetProp(P_SIZE, 250);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE, ({DT_COLD}) );
  SetProp(P_MSGIN,"trollt herein");
  SetProp(P_MSGOUT,"trollt sich nach");
  SetProp(P_WEIGHT, 160000);
  SetProp(P_MAX_WEIGHT, 200000);

  SetProp(P_DIE_MSG, " stoehnt ein letztes Mal.\n" );
  AddInfo(DEFAULT_INFO,"brummt.\n");
  SetProp(P_REJECT, ({ REJECT_GIVE, "Die Baerin sucht ihr Junges.\n" }) );

  SetProp(P_SPELLRATE, 5);
  AddSpell(3,300,
    "Die Braunbaerin schleudert Dich zu Boden.\n",
    "Die Braunbaerin schleudert @WEN zu Boden.\n",
     DT_BLUDGEON, "boden", ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,600,
    "Die Braunbaerin greift Dich mit ihrem Gebiss an.\n",
    "Die Braunbaerin greift @WEN mit ihrem Gebiss an.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Die Braunbaerin brummt.\n",
    "Die Braunbaerin jault.\n"}) );
  SetAttackChats(10, ({
    "Die Braunbaerin faucht.\n",
    "Die Braunbaerin knurrt.\n"}) );

  SUID;
  CLONEME( "/p/armour/cloak/baerenfell");
  command("trage alles");
}

void InformDefend(object enemy) 
{
  Kill(enemy);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Braunbaerin ) "
               " -%d EP\n", lostexp) );
}

void boden(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, random(3));
}
