// /d/gebirge/feyaria/weg/npc/specht.c
// Ein Specht
// 20-12-1996 Feyaria@SilberLand

#include "../def.h"
inherit "std/mnpc";

void create()
{
  string name, farbe;
  if (!is_clone(ME)) return;
  ::create();
   
  switch(random(5))
  {
    case 0: name="Buntspecht"; farbe="bunten"; break;
    case 1: name="Schwarzspecht"; farbe="schwarzen"; break;
    case 2: name="Gruenspecht"; farbe="gruenen"; break;      
    case 3: name="Rotspecht"; farbe="roten"; break;
    case 4: name="Gelbspecht"; farbe="gelben"; break;
  }
  SetProp(P_SHORT, "Ein "+name);
  SetProp(P_LONG, 
    "Der "+name+" sitzt am Baumstamm und pickt Insekten aus den Loechern, "
    "die er gerade in den Stamm geschlagen hat. Seinen Namen hat er von "
    "seinem "+farbe+" Gefieder." );
  SetProp(P_NAME, name);
  SetProp(P_GENDER, MALE);
  AddId( ({"specht", LOWER(name)}));

  create_default_npc (6);
  SetProp(P_HANDS, ({" mit seinem spitzen Schnabel", 60, DT_PIERCE}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 12);
  SetProp(P_ALIGN, 50);
  SetProp(P_DIE_MSG, " faellt tot vom Baum hinunter.\n");
  SetProp(P_NOCORPSE, 1 );

  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "flattert herein");
  SetProp(P_MMSGOUT, "flattert weit weg");

  AddInfo(DEFAULT_INFO, "flattert aufgeregt mit seinen Fluegeln.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    Name(WER,1)+" kann das doch gar nicht tragen.\n"}));

  SetChats(2, ({
    Name(WER,1)+" haemmert gegen den Stamm.\n",
    Name(WER,1)+" haemmert im Takt.\n",
    Name(WER,1)+" schaut Dich neugierig an.\n",
    Name(WER,1)+" zieht eine Larve aus einem Loch.\n",
    Name(WER,1)+" pickt einen Holzwurm aus einem Loch.\n"}) );

}
