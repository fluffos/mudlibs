//  den Abenteurer etwas angepasst, und mit ein paar Infos
//  ausgestattet -> 12.08.2019 -> Eros
// SetChats() Wahrscheinlichkeit drastisch reduziert -> 01.11.2024 -> Wraz

inherit "std/mnpc";

#include <language.h>
#include <moving.h>
#include <properties.h>
#include <combat.h>
#include <new_skills.h>
#include <mnpc.h>

#include "../def.h"


void create() {
  if (!is_clone(this_object())) return;

 ::create();

	  
  SetProp(P_SHORT, "Ein verwirrter Abenteurer");
  SetProp(P_LONG,
    "Du siehst einen alten, etwas verwarlost wirkenden Mann..");
  SetProp(P_NAME, "Abenteurer");
  SetProp(P_GENDER, MALE);
  AddId(({"abenteurer","mann"}));
  SetProp(P_ARTICLE, 1);
//  set_living_name("");
  create_default_npc(5);

  SetProp(P_HANDS, ({" mit Forschfaulheit",QueryProp(P_HANDS)[1],DT_BLUDGEON}));

  SetProp(P_RACE, "Abenteurer");
  SetProp(P_SIZE, 168);
  SetProp(P_WEIGHT, 85000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1420");

  SetChats(3, ({

       "Der Abenteurer seufzt: Andracia, oh mein geliebtes Andracia\n",
       "Der Abenteurer schaut suchend auf das Meer hinaus.\n",
       "Der Abenteurer laeuft verwirrt umher ...\n"
               }) );

  AddInfo(DEFAULT_INFO, "sagt: Wale koennen nicht fliegen.\n");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Abenteurer will nichts tragen.\n" }) );
  AddInfo( ({"wal"}), 
    "Ich bin auf einem Wal hergekommen. Man kann ganz normal auf ihm reisen, wenn man sich traut.",
    "sagt: "); 
  AddInfo( ({"herkunft"}), 
    "Ich komme aus Andracia.",
    "sagt: "); 
  AddInfo( ({"andracia"}), 
    "Oh geliebtes Andracia, ob ich jemals wieder dort hin zurueck komme?",
    "sagt: "); 
  AddInfo( ({"weg"}), 
    ".",
    "sagt: "); 
  AddInfo( ({"meer", "wasser"}),
    "Ach, man muesste nur ueber das Meer, um Andracia zu finden.",
    "sagt: ");
  AddInfo( ({"hilfe", "reise", "reisen"}),
    "Ich bin so aengstlich, ich traue mich einfach nicht auf den Wal.",
    "wimmert: ");
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 
  AddInfo( ({""}), 
    ".",
    "sagt: "); 

 }

