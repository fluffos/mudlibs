// Eine Kuh
// 1997-01-01  Feyaria@SilberLand
// 2001-07-24  Ronja@SL

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

int milch;

create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Kuh");
  SetProp(P_LONG,
    "Das ist eine ganz normale Kuh. Sie hat einen grossen Kopf mit zwei "
    "spitzen Hoernern, einen breiten Koerper mit vier Beinen und einen "
    "langen Schwanz mit einer Quaste. Leider ist sie nicht lila sondern "
    "nur braungescheckt. Ihr Bauch ist sehr dick und ihr Maul ist in "
    "stetiger Bewegung; die Kuh ist scheinbar gerade beim Wiederkaeuen."
  );

  SetProp(P_NAME, "Kuh");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kuh", "FELL_WUSCHEL"}) );

  AddDetail( ({"kopf", "horn", "hoerner", "koerper", "bein", "beine",
               "schwanz", "quaste", "bauch", "maul"}),
    "Schaut genauso aus wie bei jeder anderen Kuh auch.");

  AddSpecialDetail( ({"euter"}) ,  "detail_euter");

  create_default_npc(11);
  SetProp(P_HANDS, ({" mit ihren Hoernern", 110, DT_PIERCE}));
  SetProp(P_RACE, "Kuh");
  SetProp(P_SIZE, 140+random(10));
  SetProp(P_ALIGN, 30);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_TRANSPARENT, 0);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "weidet weiter");
  SetProp(P_MNPC_AREA, ({ ROOM "1219", ROOM "1318", ROOM "1317", ROOM "1217",
                          ROOM "kweide1", ROOM "kweide2", ROOM "kweide3",
                          ROOM "kweide4", ROOM "kweide5", ROOM "kweide6", }));
  SetProp(P_MNPC_WAIT, ({ 30, 50, 50 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "kweide3");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS+MOV_INFIGHT);

  AddInfo(DEFAULT_INFO, "muuht.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Die Kuh kann mit @WEM nichts anfangen.\n"}));

  SetChats(2, ({
    "Die Kuh laesst einen Kuhfladen fallen.\n",
    "Die Kuh macht: MUUUUH!!!\n",
    "Die Kuh kaut.\n",
    "Die Zaehne der Kuh zermahlen das halbverdaute Gras.\n",
    "Die Kuh verscheucht die laestigen Fliegen mit ihrem Schwanz.\n",
    "Die Kuh muuht.\n"}) );

  SetProp(P_DIE_MSG,
    " faellt tot zu Boden und Du ziehst ihr sofort die Haut ab.\n");
/*
  SetProp(P_CORPSE, OBJ "kuhhaut");
  SetProp(P_CORPSE_FLAGS, COR_NOSETWEIGHT | COR_NOINVTRANSFER);
  SetProp(P_CORPSE_PROPS, ([]) );
*/
  AddCmd( ({"melke", "melk"}), "cmd_melken");

  if( random(100)<30 ) CLONEME("/d/ebene/creative/feldlager/obj/euter");
  if( random(100)<50 ) CLONEME(WEAPON "kuhfuss");
  if( random(100)<70 ) CLONEME(OBJ "kuhhaut");

  milch = 1;
}

void reset()
{
  ::reset();
  milch = 1;
}

string detail_euter(string str)
{
  string s;

  if(milch)
    s = "Der Euter der Kuh ist prall mit Milch gefuellt.";
  else
    s = "Der Euter der Kuh ist schlaff und leer. Sie wurde vermutlich "
        "erst vor kurzem gemolken.";

  return BS(s);
}

int cmd_melken(string str)
{
  object kanne,hirte;

  notify_fail("Wen moechtest Du melken?\n");

  if(!str || str == "") return 0;
  if(!(str == "kuh")) return 0;

  if(!(kanne=present("milchkanne",TP)))
  {
    tell_object(TP,"Du hast ja gar keine Milchkanne dabei.\n");
    return 1;
  }

  if(kanne->QueryStat())
  {
    tell_object(TP,"Deine Milchkanne ist doch schon voll.\n");
    return 1;
  }

  if(!present("melkschemel",TP))
  {
    tell_object(TP,"Du hast ja gar keinen Melkschemel dabei.\n");
    return 1;
  }

  if(hirte=present("hirtenjunge",ENV(TO)))
  {
    tell_object(TP,"Der Hirtenjunge schreit: DU MILCHDIEB!\n");
    hirte->Kill(TP);
    return 1;
  }

  if(!milch)
  {
    tell_object(TP,"Diese Kuh gibt keine Milch mehr.\n");
    return 1;
  }

  tell_object(TP, BS(
    "Du setzt Dich auf deinen Melkschemel, stellst die Milchkanne unter "
    "das Euter und faengst an, die Kuh zu melken. Puuuh, ist das muehsam. "
    "Doch mit der Zeit geht Dir das Melken leichter von der Hand und Du "
    "bekommst Deine Milchkanne doch noch voll. "
  ));

  tell_room(ENV(TO),BS(
    CAP(TPN)+" setzt sich auf einen Melkschemel und faengt an die Kuh "
    "zu melken. Nach einiger Zeit ist die Kanne sogar voll geworden. "
  ),({TP}));

  milch = 0;
  kanne->SetStat(1);
  return 1;
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( touch && find_call_out("react")==-1 )
    call_out("muuhen",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void muuhen()
{
  command_me("emote muuht Dich laut an.");
}

void init()
{
  ::init();
  if( TP && (TP->id("hirtenjunge") || TP->id("stier")) )
    AddDefender(TP);
}

