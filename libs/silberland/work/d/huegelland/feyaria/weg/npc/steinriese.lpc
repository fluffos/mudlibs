// /d/gebirge/feyaria/weg/npc/troll.c
// Ein Troll
// 96-08-15 Cheasy@AnderLand
// 97-01-02 Feyaria@SilberLand

#pragma strong_types

inherit "std/npc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h>
#include "../def.h"

mapping unitStore = (["geld":0]);

void create() 
{
  if (!is_clone(this_object())) return;

  ::create();
  SetProp(P_SHORT, "Ein Steinriese");
  SetProp(P_LONG, BS(
    "Der Steinriese ist ein etwa sechs Meter grosses, menschenaehnliches "
    "Geschoepf. Er hat Haende wie Kohlenschaufeln und Arme, die dicker sind "
    "als Dein Oberschenkel. Dustyseidank grinst er Dich freundlich an."));
  SetProp(P_NAME, "Steinriese");
  SetProp(P_GENDER, MALE);
  AddId( ({"riese", "steinriese"}) );

  create_default_npc(40);
  SetAttribute(A_STR, 45);
  SetProp(P_HANDS, ({" mit seinen Riesenpranken", 388, DT_BLUDGEON}) );
  SetProp(P_RACE, "Riese");
  SetProp(P_SIZE, 600+random(30) );
  SetProp(P_ALIGN, 250);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_COLD:-0.7, DT_WHIP:-0.4, DT_BLUDGEON:-0.3, DT_PIERCE:-0.6,
        DT_AIR:-1,    DT_TERROR:-1, DT_HOLY:-0.3,     DT_FIRE:-0.3,
        DT_ACID:1.2,  DT_WATER:1.2, DT_MAGIC:-0.2,    DT_LIGHTNING:-0.4]) );
  SetProp(P_NOMAGIC, 5 + random(15));

  SetProp(P_MSGIN,"stampft herein");
  SetProp(P_MSGOUT,"stampft nach");

  SetProp(P_DIE_MSG, " stoehnt noch einmal sehnsuechtig und faellt krachend"
    " um.\n");
  SetProp(P_KILL_MSG, "Dabei hab ich sooo lieb geknuddelt...");

  SetChats(5, ({
    "Der Steinriese grinst Dich freundlich an.\n",
    "Der Steinriese laechelt Dir zu.\n",
    "Der Steinriese mustert Dich respektvoll.\n",
    "Der Steinriese taetschelt Dir aufmunternd den Kopf.\n",
    "Der Steinriese stupst Dir aufmunternd in die Rippen.\n"
    "Du kannst Dich kaum auf den Beinen halten.\n",
    "Der Steinriese sagt: Na Du, haben Du bitte bisschen Geld fuer armes, kleines"
      "\nDer Steinriese sagt: Riese?\n",
    "Der Steinriese schnieft: Ich haben nix Geld *schnueffelheulschnief*\n" }) );
  SetAttackChats(80, ({
    "Der Steinriese erhebt seine Hand zu einem gewaltigen Schlag.\n",
    "Der Steinriese weicht geschickt aus.\n",
    "Der Steinriese holt weit aus...\n...und verfehlt Dich.\n",
    "Der Steinriese versucht, Dich zu treten.\n",
    "@@AttackSlam@@",
    "@@AttackBreak@@",
    "@@AttackUnwear@@",
    "@@AttackKnee@@"}) );

  SetProp(P_SPELLRATE,1);
  AddSpell(1,999,
    "Der Steinriese zertruemmert Deinen Schaedel.\n",
    "Der Steinriese zertruemmert @WESSEN Schaedel.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetProp(P_REJECT, ({ REJECT_KEEP, "Der Steinriese bedankt sich artig.\n" }) );
  RegisterGive("GetSomething", 0);

  AddInfo(DEFAULT_INFO, ({
  "fragt: Warum Du sprech so zu mich? Ich nix verstehn.\n",
  "fragt: Was Du habe gesagt? Ich nur versteh einfaches Satz.\n",
  "fragt: Was Du habe gesagt? Ich nur einfaches dummes kleines Riese.\n",
  "sagt: Ich leida nix wissen von das. Ich nur dummes armes Riese.\n", 
  "fragt: Du nix koenne spreche gaaanz einfach zu gaaanz einfaches Riese?\n"
  }) );
  AddInfo( ({"autor", "cheasy"}), "Cheasy mich hat gemacht. Er sich hat viel"
    " gegeben Mueh, aba, ich zu dumm, ich nix spreche gutt.", "meint: ");
  AddInfo( ({"feyaria"}), "Feyaia gaaanz lieb sein, aba nix mehr kommen "
    "zu armes Riese seit mich hier stehen lassn hat.", "seufzt: ");
  AddInfo( ({"riese", "steinriese"}), "nickt heftig.\n");
  AddInfo( ({"keule", "riesenkeule"}),
    "grinst: Das mein Lieblings-Spillzeuck sein.\n");
  AddInfo( ({"geld", "muenzen", "muenze"}),
    "Ich armes, kleines Riese haben kein garnix Geld.", "schnieft: ");
  AddInfo( ({"hunger", "essen"}),
    "Ich grosses Hunger! Du mir geben Essen?", "sagt :");
  AddInfo( ({"stuhl", "korb", "koerbe", "vosprung"}),
    "Das mich gehoerd. Du nix wegnaehmen das.", "bruellt: ");
  SetProp(P_LOG_INFO, "feyaria/steinriese");

  SUID;
  CLONEME(WEAPON "riesenkeule");
  command("zuecke keule");
  if( !random(3) )
    CLONEME( OBJ "monster");

}

int GetSomething(object ob) 
{
  if (ob->IsUnit())
    call_out("HandleUnit", 0, ob, this_player());
  else
    call_out("Eat1", 4+random(4), ob);
  return 1;
}

void catch_tell(string str) 
{
  string who, how;

  if ((sscanf(str, "%s knuddelt Dich%s\n", who, how) == 2)
     && (who != "Der Steinriese")) {
    who = lower_case(who);
    command("sag " + who);
  } // if (sscanf(...))
  sequencer::catch_tell(str);
  npc::catch_tell(str);
}

void give_notify(object ob) 
{
  sequencer::give_notify(ob);
  npc::give_notify(ob);
}

string AttackKnee() 
{
  object en;

  if (en = QueryEnemy()) 
  {
    tell_room(MENV,BS("Der Steinriese bricht " + capitalize(en->name())
      + " das Rueckgrat."),({ en}));
    tell_object(en, "Der Steinriese bricht Dir das Rueckgrat.\n");
    en->Defend(550+random(200), DT_BLUDGEON,
                  ([SP_NAME:"Knietritt", SP_SHOW_DAMAGE:1]), TO);
  }
  return "";
}

string AttackSlam() 
{
  object en;

  if( en = QueryEnemy()) 
  {
    tell_room(MENV,BS("Der Steinriese rammt " + capitalize(en->name())
      + " unangespitzt in den Boden."), ({en}));
    tell_object(en, "Der Steinriese rammt Dich unangespitzt in den Boden.\n");
    en->Defend(450+random(100), DT_BLUDGEON,
                  ([SP_NAME:"Slam", SP_SHOW_DAMAGE:1]), TO);
  }
  return "";
}

string AttackBreak() 
{
  object en;

  if (en = QueryEnemy()) 
  {
    tell_room(MENV,BS("Der Steinriese zerschmettert "
      + capitalize(en->name()) + "."), ({en}));
    tell_object(en, "Der Steinriese zerschmettert Dich.\n");
    en->Defend(350+random(200), DT_BLUDGEON,
                  ([SP_NAME:"Break", SP_SHOW_DAMAGE:1]), TO);
  }
  return "";
}

string AttackUnwear() 
{
  object en, wp;
  int i;
  if (en = QueryEnemy()) 
  {
    if( (wp = en->QueryProp(P_WEAPON)) && !random(7)) 
    {
      if( i=wp->move(this_object(), M_GIVE) <1)  
      {
        // waffe konnte nicht geklaut werden
        tell_object(en, BS("Der Steinriese versucht, Dir Deine Waffe zu klauen,"
          " aber irgendetwas hindert Ihn daran."));
      } 
      else 
      {
        // waffe erfolgreich geklaut
        tell_object(en, "Der Steinriese nimmt Dir "+ wp->name(WEN,2)+" weg.\n");
        tell_room(MENV, "Der Steinriese nimmt "+en->name(WEM)+" "+ 
                         wp->name(WEN)+ " weg.\n");
        call_out("Eat1", 3 + random(6), wp);
      }
    }
    else
    {
      tell_room(MENV,BS("Der Steinriese verkasematuckelt "
        + capitalize(en->name()) + " mit roher Gewalt."), ({en}));
      tell_object(en, "Der Steinriese verkasemtuckelt Dich mit roher Gewalt.\n");
      en->Defend(random(200), DT_BLUDGEON,
                  ([SP_NAME:"Unwear", SP_SHOW_DAMAGE:1]), TO);
    }
  }
  return "";
}

void Eat1(object ob) 
{
  if( !objectp(ob)) return;
  say(BS("Der Steinriese schnueffelt an " + ob->name(WEM,2)
    + "."));
  call_out("Eat2", 8+random(6), ob);
}

void Eat2(object ob) 
{
  if( !objectp(ob)) return;
  say(BS("Der Steinriese guckt hungrig auf " + ob->name(WEN,2)
    + "."));
  call_out("Eat3", 3+random(6), ob);
}

void Eat3(object ob) 
{
  string theID;

  if( !objectp(ob)) return;
  theID = ob->QueryProp(P_IDS)[<1];
  if (unitStore[theID]) unitStore[theID] = 0;
  say(BS("Der Steinriese verspeist genuesslich " + ob->name(WEN,2)
    + "."));
  if(ob->QueryProp(P_ARMOUR_TYPE) || ob->QueryProp(P_WEAPON_TYPE) )
    call_out("Eat4", 2+random(3), ob);
  else
    if (!ob->remove(0)) destruct(ob);
}

void Eat4(object ob)
{
  int damage;
  if( !objectp(ob)) return;
  if( ob->QueryProp(P_WEAPON_TYPE))
    ob->Damage(ob->QueryProp(P_WC)/2);
  if( ob->QueryProp(P_ARMOUR_TYPE))
    ob->Damage(ob->QueryProp(P_AC)/2);
  say("Der Steinriese spuckt "+ob->name(WEN)+ " aus.\n");
  ob->move(MENV, M_NOCHECK);
}

void HandleUnit(object ob, object pl) 
{
  object inv;
  string theID;
  int amount;

  theID = ob->QueryProp(P_IDS)[<1]; 
  if (inv = present(theID)) 
  {
    amount = inv->QueryProp(P_AMOUNT);
    if (unitStore[theID] <= 0) 
      call_out("Eat1", 1+random(4), inv);
    unitStore[theID] = amount;
  }
  else
  {
    // whoops, there's something wrong here!
    tell_object(pl, "Ein Problem! Verstaendige bitte Feyaria.\n");
  }
}

void die(int poisondeath) 
{
  object ob;
  while (remove_call_out("Eat1") != -1) /* continue */ ;
  while (remove_call_out("Eat2") != -1) /* continue */ ;
  while (remove_call_out("Eat3") != -1) /* continue */ ;
  write_file( LOG "troll.kills",
    dtime(time())+": "+CAP(getuid(TP))+" toetet den Steinriesen.\n");

  // Fuer Zechprellerquest
  if(QueryProp(P_KILLER))
    ob = present("\nzechpreller_quest_11", QueryProp(P_KILLER));
  if(objectp(ob))
    ob->Mark();

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Steinriese ) "
               " -%d EP\n", lostexp) );
}
