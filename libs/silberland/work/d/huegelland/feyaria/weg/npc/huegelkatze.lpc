// eine Huegelkatze
// 24-5-2004  Feyaria@SilberLand

#include "../def.h"

inherit "std/mnpc";

void create()
{
  int level;
  object ob;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Huegelkatze");
  SetProp(P_GENDER, FEMALE);
  switch( random(5) )
  {
    case 0:  
      level = 17;
      SetProp(P_NAME_ADJ, "klein");
      AddAdjective( ({"klein", "kleiner", "kleinen"}) ); 
      break;
    case 1: 
      level = 21;
      SetProp(P_NAME_ADJ, "gross");
      AddAdjective( ({"gross", "grosser", "grossen"}) ); 
      break;
    default: 
      level = 19;
  }
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
    "Die Huegelkatze lebt, wie der Name schon sagt, hauptsaechlich im "
    "Huegelland. Sie hat ein gelblich-braunes Fell und einen eher kurzen "
    "Schwanz. Obwohl sie nicht sehr gross ist, scheint sie sehr gefaehrlich "
    "zu sein, zumindest hat sie scharfe Krallen und spitze Zaehne. Mit ihren "
    "gruenen Katzenaugen schaut sie Dich neugierig an.");
  AddId(({"huegelkatze", "katze", "FELL_WUSCHEL"}));

  AddDetail( ({"zaehne", "reisszaehne"}),
    "Die Reisszaehne der Huegelkatze sind schauen extrem "
    "gefaehrlich aus.");
  AddDetail( ({"augen", "katzenaugen"}),
    "Mit ihren gruenen Augen schaut die Huegelkatze Dich neugierig an, "
    "scheinbar ist sie sich nicht sicher, ob Du eine Beute oder ein Feind "
    "bist.");
  AddDetail( ({"krallen"}),
    "Die Huegelkatze hat grosse, scharfe Krallen.");
  AddDetail( ({"fell"}),
    "Das Fell der Huegelkatze ist von gelblich-brauner Farbe. Du kannst "
    "ganz feine Streifen erkennen.");
  AddDetail(({"streifen", "querstreifen"}),
    "Das Fell hat feine Querstreifen, die etwas braeunlicher sind als das "
    "normale Fell.");

  create_default_npc(level);
  SetProp(P_HANDS, ({" mit ihren scharfen Krallen", level*12, ({DT_RIP}) }));
  SetProp(P_XP, QueryProp(P_XP)*5/4);
  SetProp(P_RACE, "Raubkatze");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_RIP:-0.2,  DT_TERROR:-0.7])); 

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "springt herein");
  SetProp(P_MMSGOUT, "springt weg");
  SetProp(P_MNPC_AREA, "/d/huegelland" );
  SetProp(P_MNPC_DEFAULTROOM, ( ROOM "0715") );
  SetProp(P_MNPC_WAIT, ({ 10, 5, 55 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " stuerzt toedlich verletzt zu Boden.\n");
  AddInfo(DEFAULT_INFO, "faucht Dich nur an.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "schnurrt: ");

  SetProp(P_SPELLRATE, 40);
  AddSpell(5, 300,
    Name(WER,1)+" greift Dich mit ihren spitzen Reisszaehnen an.\n",
    Name(WER,1)+" greift @WEN mit ihren spitzen Reisszaehnen an.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 200,
    Name(WER,1)+" springt Dich an, reisst Dich zu Boden und graebt ihre "
    "Krallen\nin Deine Brust.\n",
    Name(WER,1)+" springt und reisst @WEN zu Boden.\n",
     ({DT_RIP, DT_SQUEEZE}),"disable",([SP_SHOW_DAMAGE:1]));

  SetChats(2, ({
    Name(WER,1)+" faucht Dich an.\n",
    Name(WER,1)+" schaut Dich mit ihren gruenen Katzenaugen an.\n",
    Name(WER,1)+" zeigt ihre spitzen Reisszaehne.\n",
    Name(WER,1)+" beschnuppert Dich.\n",
    Name(WER,1)+" schnuppert.\n",
    Name(WER,1)+" beaeugt Dich misstrauisch.\n",
    Name(WER,1)+" schnurrt.\n",
    Name(WER,1)+" schnurrt leise.\n",
    Name(WER,1)+" fletscht ihre Zaehne.\n"}) );

  SUID;

  if(!random(2)) CLONEME( ARMOUR "huegelkatzenfell");
  if(!random(3)) CLONEME( WEAPON "huegelkatzenkralle");
  if(!random(4)) CLONEME( WEAPON "huegelkatzenreisszahn");
}

void disable(object enemy, int damage, mixed dam_type)
{
  if (!enemy->QueryProp(P_DISABLE_ATTACK))
    enemy->SetProp(P_DISABLE_ATTACK, random(4));
}

mixed _query_reject()
{
  if( random(2) )
    return ({ REJECT_DESTRUCT, Name(WER,1)+" frisst @WEN auf.\n" });
  else
    return ({ REJECT_DROP, Name(WER,1)+" weicht misstrauisch vor @WEM zurueck.\n" });
} 

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Huegelkatze ) "
               " -%d EP\n", lostexp) );
}
