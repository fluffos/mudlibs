// /d/gebirge/feyaria/weg/npc/waldwolf.c   
// Ein Waldwolf
// 08-06-1996  Feyaria@AnderLand
// 20-06-1996  P_INFO und Spells
// 21-12-1996  Feyaria@SilberLand

inherit "std/mnpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>

create()
{
  if (IS_BLUE(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein Waldwolf");
  SetProp(P_LONG, BS(
    "Dieser grosse, boese Waldwolf hat ein dickes schwarzes Fell und ein "
    "grosses Maul voller spitzer Zaehne. Aus seinen gelben Augen schaut er "
    "Dich hasserfuellt an. Sicher ist er gerade sehr hungrig."));
  SetProp(P_INFO, BS(
    "Dieser Waldwolf sieht sehr gefaehrlich aus. Mit seinen spitzen Zaehnen "
    "kann er Dich mit einem einzigen Biss in die Kehle toeten, also sei "
    "sehr vorsichtig."));
  SetProp(P_NAME, "Waldwolf");
  SetProp(P_GENDER, MALE);
  AddId( ({"wolf", "waldwolf", "FELL_WUSCHEL"}) );

  AddDetail( ({"zahn", "zaehne", "maul"}),
    "Die Zaehne des Wolfes sind wirklich spitz! Du moechtest seinem Maul "
    "nicht in die Quere kommen!");
  AddDetail( ({"augen", "auge"}),
    "Der Wolf hat kleine, gelbe Augen mit denen er Dich hasserfuellt und "
    "aufmerksam beobachtet.");
  AddDetail( ({"fell"}),
    "Das schwarze Fell ist typisch fuer einen Waldwolf. Da es schon sehr "
    "abgewetzt ist, schaut der Wolf schon sehr alt aus.");
  
  create_default_npc(16);
  SetProp(P_HANDS, ({" mit seinem fuerchterlichen Gebiss", 160, DT_RIP}));
  SetProp(P_RACE, "Wolf");
  SetProp(P_SIZE, 110+random(10));
  SetProp(P_ALIGN, -222);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE, ({DT_TERROR, DT_COLD}) );

  SetProp(P_MSGIN, "kommt knurrend an");
  SetProp(P_MSGOUT, "geht knurrend");
  SetProp(P_MMSGIN, "kommt knurrend an");
  SetProp(P_MMSGOUT, "will hier nicht mehr knurren");
  SetProp(P_MNPC_AREA, ({ ROOM "0414", ROOM "0313", ROOM "0213", ROOM "0314",
                          ROOM "0415",ROOM "0515", ROOM "wald1", ROOM "wald2",
                          ROOM "wald3"}) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "0314");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "knurrt dich hungrig an.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Waldwolf will Deine Sachen nicht.\n"}));
  SetProp(P_DIE_MSG, " heult das letzte mal.\n");

  SetChats(3, ({
    "Der Waldwolf knurrt Dich an.\n",
    "Der Waldwolf heult furchterregend.\n",
    "Der Waldwolf fletscht seine Zaehne.\n"}) );

  SetProp(P_SPELLRATE, 30);
  AddSpell(15, 222,
    "Der Waldwolf beisst Dich ins Bein.\n",
    "Der Waldwolf beisst @WEN ins Bein.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 777,
    "Der Waldwolf springt Dir an die Kehle.\n",
    "Der Waldwolf springt @WEM an die Kehle.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));

  SUID;
  CLONEME("/p/armour/cloak/wolfsfell");
  command("trage fell");
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Waldwolf ) "
               " -%d EP\n", lostexp) );
}
