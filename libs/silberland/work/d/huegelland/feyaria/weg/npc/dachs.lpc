// /d/gebirge/feyaria/weg/npc/dachs.c
// Ein Dachs
// 1996-12-29 Feyaria@SilberLand

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Dachs");
  SetProp(P_LONG, "Ein kleiner frecher Dachs.\n");
  SetProp(P_NAME, ({"Dachs", "Dachses", "Dachs", "Dachs"}));
  SetProp(P_GENDER, MALE);
  AddId( ({"dachs", "FELL_WUSCHEL"}) );

  create_default_npc(11);
  SetProp(P_HANDS, ({" mit seinen scharfen Krallen", 110, DT_RIP}));
  SetProp(P_RACE, "Dachs");
  SetProp(P_SIZE, 70+random(10));
  SetProp(P_ALIGN, -70);
  SetProp(P_MAX_HANDS, 4);

  SetProp(P_MSGIN, "kommt fauchend an");
  SetProp(P_MSGOUT, "geht fauchend");  
  SetProp(P_MNPC_AREA, ({ ROOM "0719", ROOM "0819", ROOM "0918", ROOM "1018"}));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "0819");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "faucht Dich an.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,  "Der Dachs will das nicht haben.\n"}));
  SetProp(P_DIE_MSG, " faucht zum letzten Mal.\n");

  SetChats(1, ({"Der Dachs faucht Dich an.\n"}) );
}
