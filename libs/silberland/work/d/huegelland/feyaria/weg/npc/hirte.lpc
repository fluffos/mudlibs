// /d/gebirge/feyaria/weg/npc/hirte.c   
// Der Schafhirte
// 1997-01-01  Feyaria@SilberLand

inherit "std/mnpc";

#include "../cheasy_defs.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <mnpc.h>
#include <exploration.h>

int ruecken;

init()
{
  ::init();
  if (TP && TP->id("\nschaeferhund")) AddDefender(TP);
}

create()
{
  if (!is_clone(TO)) return;
  ::create();

  ruecken=1;
  SetProp(P_SHORT, "Ein Schafhirte");
  SetProp(P_LONG, BS(
    "Der Schafhirte steht hier auf seinen Hirtenstab gestuetzt auf der "
    "Weide und huetet seine Schafe. Dabei wird er von einem grossen "
    "Schaeferhund unterstuetzt. Gegen die Kaelte ist er in einen Mantel aus "
    "warmem Schafspelz gehuellt. Er scheint schon sehr alt zu sein, denn "
    "sein Gesicht ist voller Falten. Da er etwas gekruemmt dasteht, ist er "
    "sogar fuer einen Hobbit sehr klein.") );
  SetProp(P_NAME, "Schaefer");
  SetProp(P_GENDER, MALE);
  AddId( ({"hirte", "schafhirte", "schaefer", "\nschaefer"}) );

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinem Hirtenstab", 120, DT_BLUDGEON}));
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 93+random(5) );
  SetProp(P_ALIGN, 255);
  SetProp(P_MAX_HANDS, 2);
   SetProp(P_RESISTANCE_STRENGTHS,
            ([ DT_TERROR    : -0.1, DT_MAGIC     : -0.1, DT_SOUND     :  0.2,
               DT_LIGHTNING :  0.1, DT_POISON    :  0.1 ]) );
  SetProp(P_FOOD, 0);
  
  SetProp(P_MSGIN, "stapft auf seinen Wanderstab gestuetzt herein");
  SetProp(P_MSGOUT, "stapft auf seinen Wanderstab gestuetzt");
  SetProp(P_MMSGIN, "kommt her");
  SetProp(P_MMSGOUT, "geht weit weg");
  SetProp(P_MNPC_AREA, ROOM );
  SetProp(P_MNPC_WAIT, ({ 15, 25, 35 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "0507");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_LOG_INFO, "feyaria/hirte.log");
  AddInfo(DEFAULT_INFO, ({
    "fragt: Wie bitte?\n",
    "fragt: Wie meinst Du das ?\n",
    "fragt: Kannst Du das nochmal wiederholen?\n",
    "gruebelt: Hmmm....., tja...., soso....\n",
    "sagt: Ach wirklich? Was Du nicht sagst!\n",
    "schaut Dich nachdenklich an.\n",
    "sagt: Dazu weiss ich nichts.\n",
    "sagt: Ich bin doch nur ein armer alter Schaefer.\n",
    "sagt: Hmmm...\n",
    "raeuspert sich.\n",
    "gruebelt.\n"}) );
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "sagt: ");
  AddInfo( ({"schaf", "schafe", "lampl", "lamm", "laemmchen", "schafen"}),
    "Ja, das sind meine Schafe.", "sagt: ");
  AddInfo( ({"wolle", "schafswolle"}),
    "Schafswolle ist sehr warm. Du kannst ja welche kaufen, wenn ich wieder "
    "einmal die Schafe schere.", "sagt: ");
  AddInfo( ({"hund", "schaeferhund"}),
    "Mein Schaeferhund hilft mir, die Schafe zu hueten.", "sagt: ");
  AddInfo( ({"hirtenstab", "stab"}),
    "Der Hirtenstab ist ganz praktisch, man kann sich so schoen darauf "
    "stuetzen.", "sagt: ");
  AddInfo( ({"mantel", "pelzmantel", "schafspelzmantel"}),
    "Mein Mantel haelt mich immer schoen warm.", "sagt: ");
  AddInfo( ({"schaefer", "schafhirte", "hirte"}),
    "Ja, das bin ich.", "nickt und sagt: ");
  AddInfo( ({"kaelte", "wind", "wetter", "sonne", "kalt"}),
    "Hier ist es immer sehr kalt, weil hier immer der Wind blaest. Davon "
    "bekomm ich immer Schmerzen im Kreuz", "stoehnt: ");
  AddInfo( ({"kreuz", "schmerzen", "kreuzschmerzen", "ruecken",
             "rueckenschmerzen"}),
    "Ich hab immer Schmerzen im Kreuz. Es waere nett, wenn Du mir ein "
    "Heilmittel gegen die Schmerzen bringen koenntest.", "stoehnt: ");
  AddInfo( ({"mittel", "heilmittel", "heilung", "medizin"}),
    "Ich habe gehoert, weit im Sueden soll es einen Kraeuterkundigen geben, "
    "der solche Sachen behandeln kann. Aber ich kann meine Schafe nicht "
    "alleine lassen, um so weit zu verreisen.", "seufzt: ");
  AddInfo( ({"kraeuter", "kraeuterkundiger", "kraeuterkundigem", "kundiger",
             "kundigem"}),
    "Der Kraeuterkundige wohnt in einer Stadt im Sueden, deren Namen ich aber "
    "vergessen habe. Ich glaube, der Name des Kraeuterhaendlers faengt mit "
    "E an.", "versucht sich zu erinnern: ");
  AddInfo( ({"elsurion"}),
    "Ja, so koennte der Kraeuterkundige heissen.", "gruebelt: ");
  AddInfo( ({"himmel", "adler", "steinadler", "raubvogel", "raubvoegel",
             "vogel", "voegel"}),
    "Manchmal kommt ein Steinadler und schlaegt eines der Laemmer, darum "
    "beobachte ich immer den Himmel.", "sagt: ");
  AddInfo( ({"hobbit", "hobbits"}),
    "Ja, ich bin ein Hobbit und stamme aus " N_STADT ".", "sagt: ");
  AddInfo( ({ LOWER(N_STADT), "stadt", "familie"}),
    "Ich bin in " N_STADT " geboren, und auch meine ganze Familie lebt "
    "dort.", "sagt: ");

  AddInfo( ({"elfen", "elf", "zwerge", "zwerg", "menschen", "mensch"}),
    "Die sieht man nur selten hier in dieser Gegend.", "sagt: ");
  AddInfo( ({"alter", "alt"}),
    "Ich bin schon fast 100 Jahre alt, und Du?", "sagt :");
  AddInfo( ({"name"}),
    "Da ich hier immer so einsam bin, hab ich meinen Namen leider "
    "vergessen.", "seufzt: ");
  AddInfo( ({"beruf", "aufgabe", "job"}),
    "Ich bin ein Schafhirte und huete diese Schafe hier.", "sagt: ");
  AddInfo( ({"hilfe", "quest", "helfen", "mittel"}),
    "Wenn Du mal Zeit hast, koenntest Du mir ja ein Mittel gegen meine "
    "Kreuzschmerzen bringen.", "sagt: ");
  AddInfo( ({"berg", "gebirge", "berge", LOWER(N_BERG)}),
    "Das dort ist der " N_BERG "!", "zeigt auf den " N_BERG " und sagt: ");
  AddInfo( ({"see", LOWER(N_SEE)}),
    "Das dort ist der " N_SEE "!", "zeigt auf den " N_SEE " und sagt: ");
  AddInfo( ({"retter", "bergwacht", "bergwacht-mann", "bergwachtmann", 
             "franz", "franzl", "typ", "schutzhuette", "schutzhuetten"}),
    "Der Franzl von der Bergwacht ist ein netter Typ. Du findest ihn immer "
    "in der Naehe der Schutzhuetten.", "sagt: ");
  AddInfo( ({"wanderer", "karren", "haendler"}),
    "Sowas kommt hier nur sehr selten vorbei.", "sagt: ");
  AddInfo( ({"tier", "tiere"}),
    "Die einzigen Tiere hier sind meine Schafe und mein Hund.", "sagt: ");
  AddInfo( ({"midas", "felonia", "tijara"}),
    "Kenn ich leider nicht.", "sagt: ");
  AddInfo( ({"kluft"}),
    "Pass auf diese Kluft auf! Da sind mir schon viele Schafe hineingefallen."
    "Andererseits haelt sie auch die Woelfe von meinen Schafen fern.",
    "sagt: ");
  AddInfo( ({"wolf", "woelfe"}),
    "Hier gibts es einige Woelfe im Gebirge, die es auf meine Schafe abgesehen "
    "haben.", "sagt aergerlich: ");

  SetProp(P_REJECT, ({ REJECT_KEEP, 
     "Der Schaefer bedankt sich fuer diese milde Gabe.\n"}));
  SetProp(P_DIE_MSG, " wird keine Schafe mehr hueten.\n");

  SetChats(3, ({
    "Der Schaefer pfeift nach seinem Schaeferhund.\n",
    "Der Schaefer kuschelt sich in seinen dicken Schafspelzmantel.\n",
    "Der Schaefer stuetzt sich auf seinen Hirtenstab.\n",
    "Der Schaefer stoeht: Ach mein armes Kreuz.\n",
    "Der Schaefer prueft den Wind mit seinem Finger.\n",
    "Der Schaefer ruft nach seinem Hund.\n",
    "Der Schaefer zittert vor Kaelte.\n",
    "Der Schaefer streckt sich.\n",
    "Der Schaefer schaut Dich pruefend an.\n",
    "Der Schaefer gaehnt.\n",
    "Der Schaefer beobachtet den Himmel.\n",
    "Der Schaefer nickt Dir zu.\n",
    "Der Schaefer bewacht seine Schafe.\n",
    "Der Schaefer beobachtet die Schafe.\n",
    "Der Schaefer fragt Dich: Tut Dir Dein Kreuz auch so weh?\n",
    "Der Schaefer arglt: Heute tut mir mein Kreuz aber weh!\n",
    "Der Schaefer greift sich stoehnend auf den Ruecken.\n",
    "Der Schaefer zaehlt seine Schafe.\n"}) );

  SUID;
  CLONEME( WEAPON "stab");
  command("zuecke stab");
  CLONEME( ARMOUR "mantel");
  command("trage mantel");
  CLONEME( WEAPON "schere");

  AddCmd( ({"kauf", "kaufe"}), "cmd_kaufen");
}

int cmd_kaufen(string str)
{
  notify_fail("Der Schaefer fragt: Was willst Du kaufen?\n");
  if (str != "wolle" && str != "schafwolle")
    return 0;

  command("sag Leider habe ich im Moment keine Wolle zum verkaufen, komm "
          "Doch wieder, wenn ich die Schafe geschoren habe.");
  return 1;
}

void InformDefend(object enemy) 
{
  Kill(enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Hirte ) "
               " -%d EP\n", lostexp) );
}

void give_notify(object ob)
{
  object item;
  if(ruecken && ob->id("\nwunderkraut") ) 
  {
    command_me("iss kraut");
    write("Der Schaefer bedankt sich bei Dir.\n");
    say( "Der Schaefer bedankt sich bei "+ TP->name(WEM) +".\n", ({TP}) );
    WLOG( LOG "hirte", "gibt dem Hirten das Heilmittel");
    EPMASTER->GiveExplorationPoint("heilmittel", EP_MISC);
    ruecken=0;
    if((item=present("\npaladintaskitem", TP)) && item->GetTask(3,TP))
      item->SetFlag(0);
    if(ob) ob->remove();
    return;
  }
  else
    ::give_notify(ob);
}

reset()
{
  ::reset();
  ruecken=1;
}

