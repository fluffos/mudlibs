// /d/gebirge/feyaria/weg/npc/retter.c
// der Bergwacht-Mann
// Original von Cheasy@AnderLand
// 22-12-1996 Feyaria@SilberLand

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <new_skills.h> 
#include <mnpc.h>                                                       
#include "../cheasy_defs.h"
#define KLETTERHAKEN "/d/dschungel/feyaria/felseninsel/obj/kletterhaken" 

create()
{
  if (!is_clone(this_object())) return;

  ::create();
  
  SetProp(P_SHORT, "Ein Bergwacht-Mann");
  SetProp(P_LONG, BS("Der Bergwacht-Mann schaut entspannt in die Gegend. Er"
    " traegt einen warmen Parka, einen Kletterhelm und hat einen Pickel"
    " gezueckt."));
  SetProp(P_NAME, "Bergwacht-Mann");
  SetProp(P_GENDER, MALE);
  AddId( ({"franz", "franzl", "mann", "bergwacht-mann", "retter"}) );
  set_living_name("franzl");

  create_default_npc(31);
  SetProp(P_HANDS, ({" mit seinem Pickel ", 300, DT_PIERCE}) );
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 99);
  SetProp(P_ALIGN, 555);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 50000);
  SetProp(P_RESISTANCE_STRENGTHS,
          ([ DT_TERROR    : -0.7, DT_MAGIC     : -0.5, DT_SOUND     :  0.3,
             DT_LIGHTNING :  0.3, DT_POISON    :  0.2, DT_COLD      : -0.5, 
             DT_AIR       : -0.7, DT_WHIP      : -0.4, DT_WATER     : -0.3]) );
  SetProp(P_NOMAGIC,10);
  SetProp(P_DIE_MSG, " springt in den Abgrund.\n" );
  SetProp(P_NOCORPSE, 1 );

  SetProp(P_MSGIN,"wandert herein");
  SetProp(P_MSGOUT,"wandert");
  SetProp(P_MMSGIN,"wandert herein");
  SetProp(P_MMSGOUT,"wandert weit weg");
  SetProp(P_MNPC_AREA, ({ ROOM "0208", ROOM "0308", ROOM "0309", ROOM "0409",
                       ROOM "0310",ROOM "0209", ROOM "0109", ROOM "0210"}) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "0208");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS+MOV_MAYLOAD);


  SetProp(P_SPELLRATE, 80);
  AddSpell(6,150, 
    "Der Bergwacht-Mann wirft Dir einen magischen Stein an den Kopf.\n",
    "Der Bergwacht-Mann wirft @WEM einen magischen Stein an den Kopf.\n",
    DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,190, 
    "Der Bergwacht-Mann erschreckt Dich mit einem Jodler.\n",
    "Der Bergwacht-Mann erschreckt @WEN mit einem Jodler.\n",
    DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,632,
    "Der Bergwacht-Mann laesst eine Lawine auf Dich stuerzen.\n",
    "Der Bergwacht-Mann laesst eine Lawine auf @WEN stuerzen.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
  "Der Bergwacht-Mann schmaucht an seiner Pfeife.\n",
  "Der Bergwacht-Mann bietet Dir eine Broschuere an.\n",
  "Der Bergwacht-Mann warnt: Nimm Dich vor Steinschlag und Lawinen in acht!\n",
  "Der Bergwacht-Mann flucht ueber die Touristen.\n",
  "Der Bergwacht-Mann lutscht ein Kraeuterbonbon.\n",
  "Der Bergwacht-Mann laedt Dich in die Bergwacht-Huette ein.\n",
  "Der Bergwacht-Mann sucht lila Kuehe.\n",
  "Der Bergwacht-Mann seufzt.\n",
  "Der Bergwacht-Mann grinst Dich an.\n",
  "Der Bergwacht-Mann streicht ueber seinen Bart.\n",
  "Der Bergwacht-Mann schaut pruefend in den Himmel.\n",
  "Der Bergwacht-Mann untersucht die Felswand kritisch.\n",
  "Der Bergwacht-Mann fragt: Kennst Du schon die Abkuerzung hier?\n",
  "Der Bergwacht-Mann jodelt laut ins Tal hinein.\n",
  "Der Bergwacht-Mann juchzt.\n",
  "Der Bergwacht-Mann schiebt seinen Helm tiefer ueber die Augen.\n",
  "Der Bergwacht-Mann zupft an seinem Parka herum.\n",
  "Der Bergwacht-Mann putzt seine Bergstiefel.\n",
  "Der Bergwacht-Mann ueberprueft sein Seil.\n",
  "Der Bergwacht-Mann zaehlt seine Kletterhaken.\n",
  "Der Bergwacht-Mann rueckt seinen Rucksack zurecht.\n",
  "Der Bergwacht-Mann schneuzt sich die Nase.\n",
  "Der Bergwacht-Mann reibt sich die Haende.\n",
  "Der Bergwacht-Mann verscheucht eine Fliege.\n",
  "Der Bergwacht-Mann mustert Dich.\n",
  "Der Bergwacht-Mann interessiert sich fuer Deine Ausruestung.\n",
  "Der Bergwacht-Mann schaut pruefend in den Himmel.\n",
  "Der Bergwacht-Mann bindet sich seine Bergstiefel neu.\n",
  "Der Bergwacht-Mann laechelt Dich an.\n",
  "Der Bergwacht-Mann bietet Dir Freundschaft an.\n",
  "Der Bergwacht-Mann steckt sich ein Kraeuterbonbon in den Mund.\n",
  "Der Bergwacht-Mann schaut sich um.\n"
  }) );

  SetAttackChats(10, ({
  "Der Bergwacht-Mann seufzt.\n",
  "Der Bergwacht-Mann warnt Dich ein letztes mal.\n",
  "Der Bergwacht-Mann sagt: Lass das, ich bin staerker!\n",
  "Der Bergwacht-Mann fragt: Bist Du Lebensmuede?.\n",
  "Der Bergwacht-Mann fragt: Du willst wohl unbedingt zu Lars?\n",
  "Der Bergwacht-Mann fragt: Du hast wohl schon zulange gelebt?\n",
  "Der Bergwacht-Mann sagt: Kuehl Deinen Mut woanders ab!\n",
  "Der Bergwacht-Mann versetzt Dir eine Watschn.\n",
  "Der Bergwacht-Mann zieht Dir einen zweiten Scheitel.\n",
  "Der Bergwacht-Mann warnt Dich.\n"
  }) );

  SetProp( P_REJECT, ({ REJECT_GIVE, "Der Bergwacht-Mann sagt: Ich darf"
     " keine Geschenke von Touristen annehmen.\n" }) );

  SetProp(P_LOG_INFO, "feyaria/retter.log");
  AddInfo(DEFAULT_INFO, ({
    "zuckt mit den Schultern.\n",
    "denkt . o O ( So eine bloede Frage! )\n",
    "fragt: Bist Du vielleicht mit dem Bus gekommen?\n",
    "fragt: Du bist wohl ein Tourist?\n",
    "sagt: Werd Doch nicht gleich frech!\n",
    "fragt: Wie bitte?\n",
    "fragt: Wie meinst Du das ?\n",
    "fragt: Kannst Du das nochmal wiederholen?\n",
    "sagt: Ich glaub, ich hoer schlecht!\n",
    "gruebelt: Hmmm....., tja...., soso....\n",
    "sagt: Ach wirklich? Was Du nicht sagst!\n",
    "kratzt sich hinter dem Ohr.\n",
    "schaut Dich mit grossen Augen an.\n",
    "schaut Dich erstaunt an.\n",
    "sagt: Das meinst Du doch nicht ernst!\n",
    "staunt: Ach wirklich! Das ist mir aber ganz neu!\n",
    "sagt: Das hab ich mich auch schon immer gefragt.\n",
    "sagt: Du kannst aber komische Fragen stellen!\n",
    "sagt: Steig in Deinen Bus und fahr wieder heim!\n",
    "steckt sich einfach ein Kraeuterbonbon in den Mund.\n",
    "seufzt.\n",
    "verwuschelt Deine Haare.\n",
    "bedankt sich bei Dir.\n",
    "dreht sich uninteressiert weg.\n",
    "kichert.\n",
    "grinst Dich an.\n",
    "gruebelt.\n",
    "knuddelt Dich.\n",
    "bleibt stumm.\n",
    "fragt: Wie heisst Du ueberhaupt?\n",
    "sagt: Lass uns das Thema wechseln.\n",
    "sagt: Sowas kann doch nur ein Tourist fragen!\n",
    "sagt: Nein, Nein, NEIN!\n",
    "sagt: Das ist doch alles Bloedsinn!\n",
    "fragt sich: Warum red ich eigentlich mit Touristen?\n",
    "streicht sich ueber den Bart.\n",
    "fragt: Wo ist der Bus?\n" }) );


  AddInfo( ({"feyaria", "fey", "feya", "dschungelelfe"}),
    "Feyaria hat dieses ganze Gebiet hier aufgebaut.", "sagt begeistert: ");
  AddInfo("bus",
    "Na der mit den tausend Leuten, die sich fuer so einen Bloedsinn"
    " interessieren.", "sagt: " );
  AddInfo( ({"bloedsinn", "leute", "leuten"}),
    "Mann, bist Du bloed.", "sagt: ");
  AddInfo( ({"name"}),
    "Angenehm, ich bin der Franzl.", "stellt sich vor: ");
  AddInfo( ({"pfeife", "pfeifchen"}),
    "Wenn ich dafuer nur noch etwas Tabak haette.", "seufzt: ");
  AddInfo( ({"tabak"}),
    "Ich hab keinen, aber ich wuerde doch so gerne mein Pfeifchen rauchen.",
    "seufzt: ");
  AddInfo( "gefahren",
    "Gefahren gibt es hier viele, zB Steinschlag, Waldwoelfe und das "
    "Verwenden von Untersucheskripts", "warnt Dich: ");
  AddInfo( ({"woelfe", "wolf", "waldwolf", "waldwoelfe"}),
    "Der Waldwolf ist eshr gefaehrlich, er kann Dir mit einem Biss die "
    "Kehle herausreissen.", "warnt Dich: ");  
  AddInfo( ({"verwenden","untersucheskripts", "skripts"}),
    "Das Verwenden von Untersucheskripts kann in dieser Gegend toedlich sein.",
    "warnt Dich: ");   
  AddInfo( "steinschlag",
    "Steinschlag kann aus heiterem Himmel kommen, dagegen gibt's"
    " leider keinen Schutz -- ausser gebirgsgerechter Bekleidung. Ein Helm"
    " ist da ganz besonders nuetzlich.",  "belehrt Dich: ");
  AddInfo( ({"lawine", "lawinen", "schneelawine", "schneelawinen"}),
    "Lawinen sind eigentlich nicht so besonders gefaehrlich... man"
    " darf halt net schnurstracks reinlaufen. Aber so bloed, wie die"
    " Touristen sind, rennt doch immer wieder mal einer schnurstracks in"
    " eine Lawine rein.", "belehrt Dich: ");
  AddInfo( ({"tourist", "touristen", "haendler"}),
    "Ohne die bloeden Haendler und Touristen waer das Leben hier viel"
    " schoener. Aber so bloed wie die Deppen halt sind, musst Du jede dritte"
    " Nacht raus und die Reste einsammeln, oder so einem Flachland-Tiroler"
    " die Windeln wechseln.", "erzaehlt Dir: ");
  AddInfo( ({"depp", "deppen"}),
   "Jaja, die Touristen hier sind ganz huebsch deppert.", "kichert: ");
  AddInfo( ({"leben"}),
    "Jaja, das Leben hier oben ist nicht ungefaehrlich, wenn man sich"
    " nicht richtig auskennt.", "sagt: ");
  AddInfo("nacht",
    "Nachts ist es kaelter als am Tag.", "sagt froestelnd: ");
  AddInfo("tag",
    "Am Tag ist es hier ganz angenehm.", "sagt: ");
  AddInfo( ({"rest", "reste"}),
    "Da bleibt halt net viel uebrig, wenn so ein Depp mal wieder in"
    " den Abgrund stuerzt.", "sagt: ");
  AddInfo( ({"flachland-tiroler", "tiroler"}),
    "Grad so ein Depp wie Du einer bist.", "zeigt auf Dich und sagt: ");
  AddInfo( ({"windel", "windeln"}),
    "Du musst wirklich bloeder sein, als die Polizei erlaubt.", "sagt: ");
  AddInfo( ({"bekleidung", "kleidung", "kleider"}),
    "Hier im Gebirge sollte man schon recht warm angezogen sein, und"
    " ein Kopfschutz ist bestimmt nicht verkehrt.", "sagt: ");
  AddInfo( ({"kopfschutz", "schutz", "helm", "kletterhelm"}),
    "Das ist MEIN Kletterhelm, den geb ich nicht her. Und was willst"
    " Du damit schon anfangen, fuer deinen Schwollkopf ist das Ding doch"
    " viel zu klein.",  "sagt: ");
  AddInfo( ({"kopf", "schwollkopf", "schaedel", "hals"}),
    "Na so eine dicke Birne, wie sie auf Deinem Hals sitzt!", "sagt: ");
  AddInfo( ({"birne"}),
    "Doch, genau, Dein Schaedel ist gemeint. Du hast mich da kein"
    " bisschen missverstanden.", "sagt: ");
  AddInfo( ({"freundschaft"}),
    "bietet Dir Freundschaft an.\n");
  AddInfo( ({"mammutbaum", "mammutbaeume"}),
    "Die Mammutbaeume im Wald sind riesengross. Die Touristen versuchen "
    "immer, von den Baeumen runterzuspringen.", "sagt: ");
  AddInfo( ({"broschuere"}),
    "Tut mir leid, die letzte Broschuere hab ich grad verteilt.", "sagt: ");
  AddInfo("parka",
    "Das ist _mein_ Parka, den kannst Du nicht kriegen.", "sagt: ");
  AddInfo( ({"pickel", "eispickel"}),
    "Der Apparat heisst Eispickel, weil man sich damit so schoen in"
    " der Nase bohren kann. Und Du wirst den hier nur ueber meine Leiche"
    " kriegen.", "sagt: ");
  AddInfo( ({"apparat", "apparate"}),
    "Mann oh Mann, kannst Du vielleicht bloede Fragen stellen.", "sagt: ");
  AddInfo( ({"frage", "fragen"}),
    "Ich bin ja ziemlich geduldig... aber das geht zu weit. Ich ruf"
    " jetzt einen Magier, der kann dann mit Dir machen, was auch immer er"
    " mit einem Script machen mag.", "sagt: ");
  AddInfo( ({"script", "magier", "magierin"}),
    "ruft einen Magier.\n");
  AddInfo( ({"polizei", "sheriff"}),
    "ruft den Sheriff.\n");
  AddInfo( ({"bonbon", "kraeuterbonbon", "bonbons", "kraeuterbonbons"}),
    "Die Kraeuterbonbons sind gut, schmecken, und sind gesund. Die"
    " kann man sogar im Laden kaufen, oder im Restaurant hier in der"
    " Naehe.", "sagt: ");
  AddInfo( ({"restaurant", "raststation", "schaudichnichtum", "gasthaus",
             "wirtshaus", "kneipe"}),
    "In der Raststation 'Schaudichnichtum' gibts was zu Essen und zu "
    "Trinken.", "sagt: ");
  AddInfo( ({"essen", "trinken", "most", "jause", "brettljause", 
             "bretteljause", "brettljausn" }),
    "In der Raststaion gibts eine Brettljausn und einen guten Most.");
  AddInfo( ({"bergwacht"}),
    "Die Bergwacht sorgt fuer die Sicherheit hier im Gebirge!", "sagt: ");  
  AddInfo( ({"huette", "bergwacht-huette", "huetten", "bergwacht-huetten"}),
    "Wir unterhalten mehrere Huetten im Gebirge, in denen wir bei"
    " schlechtem Wetter auf besseres warten, und wo wir schlafen. Aber auch"
    " ein paar Krankenbetten stehen da.", "sagt: ");
  AddInfo( ({"gebirge", "berge", "berg"}),
    "Das Gebirge ist nicht ungefaehrlich: Da gibts neben wilden Tieren"
    " auch noch Lawinen, Muren, Steinschlag und Gewitter, die alle"
    " lebensbedrohlich werden koennen. Also sei lieber auf der Hut, und renn"
    " nicht wie ein Lemming immer vorwaerts.", "sagt: ");
  AddInfo( ({"lemming" ,"hut"}),
    "Das hab ich nur so dahingesagt.", "kichert: ");
  AddInfo( ({"gipfel", LOWER(N_BERG), "ausblick"}),
    "Der "+ N_BERG +" ist der hoechste Gipfel hier. Von dort oben hat man "
    "einen tollen Ausblick.", "schwaermt: ");
  AddInfo( ({LOWER(N_SEE), "see", "bergsee"}),
    "Der "+ N_SEE +" liegt unterhalb vom "+ N_BERG +". Er ist ein richtig "
    "idyllischer Bergsee.");
  AddInfo( ({"gewitter", "wetter"}),
    "Gewitter sind im Gebirge sehr gefaehrlich. Die meisten kann man"
    " zwar schon rechtzeitig im voraus erkennen, aber manchmal zieht eins"
    " ohne jede Vorwarnung ueber den Grat und Du stehst mittendrin. Dann"
    " hilft nur noch beten...", "sagt: ");
  AddInfo( ({"mure", "muren", "schlammlawine", "schlammlawinen"}),
    "Muren sind zwar selten, aber hoechst gefaehrlich. Im Gegensatz zu"
    " Schneelawinen gibt's aus den tonnenschweren Schlammlawinen keinerlei"
    " entkommen.", "erzaehlt Dir: ");
  AddInfo( ({"kuh", "kuehe"}),
    "Angeblich gibt es in einem weit entfernten Land lila Kuehe. So"
    " eine wuerde ich fuer mein Leben gern einmal sehen.", "sagt: ");
  AddInfo( ({"problem", "probleme"}),
    "Ich hab keine Probleme, und Du?", "fragt: ");
  AddInfo( ({"bart", "schnauzer", "vollbart"}),
    "So ein Vollbart ist recht angenehm: Im Winter haelt er Dir den"
    " eiskalten Wind vom Leib, im Sommer spendet er Schatten, so dass das"
    " Gesicht nicht so schnell brennt bei der Sonne hier.", "sagt: ");
  AddInfo( ({"gesicht", "milchgesicht"}),
    "Also Dein Milchgesicht wollte ich nicht um alles in der Welt"
    " haben.", "sagt lachend: ");
  AddInfo("winter",
    "sagt froestelnd: Im Winter ist es noch kaelter als jetzt.\n"
    "Der Bergwacht-Mann denkt . o O ( und im Sommer noch heisser. )\n");
  AddInfo("sommer",
    "sagt schwitzend: Im Sommer ist es noch waermer als jetzt.\n"
    "Der Bergwacht-Mann denkt . o O ( und im Winter noch kaelter. )\n");
  AddInfo("schatten",
    "Im Schatten trinken wir ganz gerne ein Bierchen.", "sagt durstig: ");
  AddInfo( ({"bier", "bierchen"}),
    "Ich hab keins dabei, Du vielleicht?", "sagt durstig: ");
  AddInfo("himmel",
    "Man kann viele heraufziehende Gewitter bereits vorher erkennen,"
    " wenn man die Zeichen am Himmel richtig zu lesen versteht.", "sagt: ");
  AddInfo("zeichen",
    "Du Flachland-Tiroler wirst das wohl nie verstehen.", "sagt: ");
  AddInfo( ({"fels", "felsen", "stein", "steine", "felswand", "wand",
     "gestein", "dolomit"}),
    "Die Felswand besteht hier aus einem besonders bruechigem Gestein:"
    " Dolomit. Deshalb gibt's hier auch soviel Steinschlag und Muren.",
    "belehrt Dich: ");
  AddInfo("abkuerzung",
    "Frueher lebte einmal ein Troll noerdlich von hier, der jedermann"
    " ueber den "+ N_BERG +" gehoben hat. Aber seitdem er verschwunden ist, "
    "muessen die Leute den gefaehrlichen Weg ueber die beiden Paesse nehmen.",
    "erzaehlt Dir: ");
  AddInfo( ({"pass", "paesse"}),
    "Die Paesse gibt es schon seit Cheasy die Welt erschaffen hat.", 
    "sagt: ");
  AddInfo( ({"welt"}),
    "Zum philosophieren solltest Du Dich an jemand anderen wenden. Geh"
    " doch zu Elsurion.", "sagt: ");
  AddInfo( ({"elsurion", "kraeuterhaendler", "elf", "kraeuter"}),
    "Elsurion ist so ein alter Elf, der mal hier nach seltenen Kraeutern "
    "gesucht hat. Ich glaube, er ist Kraeuterhaendler in einer Stadt weit "
    "im Sueden.", "erinnert sich: ");
  AddInfo( ({"stadt", "midas", "tijara", "felonia", "stadtmensch",
             LOWER(N_STADT) }),
    "Du bist also ein Stadtmensch? Das hab ich mir ja gleich gedacht.",
    "sagt grinsend: ");
  AddInfo( ({"cheasy"}),
    "Cheasy ist ein richtiger Edelhobbit. Von ihm hab' ich meine"
    " Abneigung gegen Scripts.", "sagt: ");
  AddInfo( ({"stiefel", "bergstiefel"}),
    "Ich glaube nicht, dass deine Quadratquanten in meine schoenen"
    " kleinen Kletterstiefel passen.", "sagt: ");
  AddInfo( ({"quadratquanten", "quanten", "fuesse", "fuss", "kaesfuesse",
      "Kaesefuesse", "kaesfuss", "kaessfuess", "kaesefuss", "kaesefuess"}),
    "Ja, Deine Kaesefuesse meine ich.", "bestaetigt :");
  AddInfo( ({"steigeisen"}),
    "Meine Steigeisen sind toll! Damit habe ich auch auf Eis einen tollen "
    "Halt.", "sagt begeistert: ");    
  AddInfo( ({"seil"}),
    "Das Seil brauch ich, um mich abzuseilen, wenn mal jemand in den"
    " Abgrund gestuerzt ist.", "sagt: ");
  AddInfo( ({"abgrund"}),
    "Da schau runter: gaaaanz unten, die Punkte, die kleinen: das sind"
    " die Reste von so neugierigen Flachland-Tirolern, wie Du einer bist.",
    "sagt: ");
  AddInfo( ({"kletterhaken", "haken"}),
    "Die Kletterhaken sind lebenswichtig: die schlaegt man irgendwo in"
    " die Felswand, und dann kann man daran sein Seil befestigen. Aber meine"
    " kann ich Dir nicht geben.", "sagt: ");
  AddInfo( ({"rucksack"}),
    "Das ist ein spezieller Bergwacht-Rucksack: er ist besonders leicht,"
    " und im Notfall kann man seine Fuesse darin waermen.", "sagt: ");
  AddInfo( ({"notfall", "unfall", "not", "rettung", "hilfe", "bergnot"}),
    "Wenn Du jemals in Bergnot geraetst, musst Du laut um Hilfe rufen."
    " Wenn Dich jemand hoert, verstaendigt er die Bergwacht, und wir tun"
    " unser Moeglichstes, um Dein Leben zu retten.", "sagt: " );
  AddInfo( ({"fliege", "fliegen"}),
    "Die Fliegen sind heute wirklich laestig.", "sagt veraergert: ");
  AddInfo( ({"wind"}),
    "Der Wind kann hier in den Bergen manchmal ganz schoen kalt blasen.",
    "erzaehlt Dir: ");
  AddInfo( ({"tiere", "tier"}),
    "Hier in den Bergen gibt es noch viele Tiere, manche gefaehrlich, andere "
    "friedlich. Wenn Du ueber ein bestimmtes Tier ewtas wissen willst, "
    "dann frag mich ruhig danach.", "erzaehlt Dir: ");
  AddInfo( ({"troll", "trolle"}),
    "Irgendwo in den Huegeln wohnt ein Troll. Er ist eigentlich ganz "
    "friedlich aber auch ziemlich dumm. Du solltest sehr vorsichtig "
    "sein, wenn Du ihn triffst.", "sagt: ");
  AddInfo( ({"fuchs", "rotfuchs"}),
    "Ich hab schon einmal einen Rotfuchs gesehen. Fuer Dich ist er aber "
    "nicht gefaehrlich.", "sagt: ");
  AddInfo( ({"baer", "braunbaer", "braunbaerin", "braunbaerchen", "baeren",
             "baerenfamilie", "braunbaerenfamilie", "braunbaeren"}),
    "Es gibt hier eine ganze Braunbaerenfamilie. Du solltest ihnen nicht zu "
    "nahe kommen, denn die zwei alten Baeren wollen immer ihr Junges "
    "beschuetzen.", "vertraut Dir an: ");
  AddInfo( ({"waldwolf", "wolf", "woelfe"}),
    "Einen Waldwolf hab ich auch schon einmal gesehen. Wenn Du ihn in Ruhe "
    "laesst, wirst Du keine Schwierigkeiten haben, denn es ist ein sehr "
    "alter Wolf. Pass aber trotzdem auf, denn er kann Dir ganz leicht die "
    "Kehle durchbeissen.", "erzaehlt: ");
  AddInfo( ({"ente", "frosch", "reiher"}),
    "In der Talaue gibts noch viele andere Tiere.", "sagt: ");
  AddInfo( ({"raubtiere"}),
    "Hier gibts einige Raubtiere. Einen Waldwolf, einen Fuchs und vor allem "
    "eine ganze Braunbaerenfamilie.", "erzaehlt: ");
  AddInfo( ({"vogel", "voegel"}),
    "Es gibt einige Voegel in den Bergen. Am eindruckvollsten ist aber "
    "sicher der riesige Bergadler.", "sagt: ");
  AddInfo( ({"adler", "bergadler"}),
    "Der Bergadler kreist immer um die hoechsten Gipfel und haelt nach "
    "Beute Ausschau.", "sagt: ");
  AddInfo( ({"hirsch", "kronenhirsch", "reh", "wildschwein", "otter", "hase",
            "eichhoernchen", "kaninnchen", "wildkaninnchen", "schwein", "dachs",
            "uhu", "specht", "hirsche", "rehe", "wildschweine", "hasen",
            "ziege", "bergziege"}),
    "Die Waelder hier sind voll mit solchen Waldtieren.", "sagt: ");
  AddInfo( ({"waldtiere", "waldtier"}),
    "Im Wald gibts Hirsche, Rehe, Wildschweine, Hasen, Eichhoernchen und "
    "noch viele andere Tiere.", "sagt: ");
  AddInfo( ({"murmeltiere", "murmeltier", "bergtiere", "bergtier"}),
    "Ganz hoch in den Bergen leben viele Murmeltiere. Aber sie sind sehr "
    "scheu und verstecken sich meist in ihren Hoehlen.", "sagt: ");
  AddInfo( ({"rasse", "rassen"}),
    "Es gibt vier verschiedene Rassen. Ich gehoere der wunderbaren Rasse "
    "der Hobbits an. Dann gibts da noch Menschen, Elfen und Zwerge.",
    "schwaermt: ");
  AddInfo( ({"hobbit", "hobbits", "volk"}),
    "Ich bin ein Hobbit und ich bin stolz darauf. Wir sind zwar kleiner als "
    "die anderen Rassen, dafuer sind wir schoener, schneller, leiser, "
    "besser, intelligenter, weiser, gelenkiger, geschickter, erfahrener, "
    "klueger, ausdauernder, staerker, huebscher und mutiger.",
    "schwaermt: ");
  AddInfo( ({"herr der ringe", "herr", "ringe", "tolkien", "bilbo", "frodo",
             "merry", "pippin", "meriadoc", "peregrin", "beutlin"}),
    "Im 'Herr der Ringe' sind ja auch die Hobbits die grossen Helden.",
    "schwaermt: ");
  AddInfo( ({"mensch", "menschen", "menschenvolk"}),
    "Menschen sind so gross und breit, die koennen nie durch die engen "
    "Felsspalten durchklettern.", "sagt abfaellig: ");
  AddInfo( ({"elfen", "elf", "elfen", "elfenvolk"}),
    "Elfen fuehlen sich doch nur in ihren Waeldern wohl.",
    "sagt abfaellig: ");
  AddInfo( ({"zwerg", "zwerge", "zwergenvolk"}),
    "Zwerge buddeln doch lieber in einem Berg herum als ihn zu besteigen.",
    "sagt abfaellig: ");
  AddInfo( ({"gegend", "grat", "tal", "talaue", "huegel"}),
    "Eine schoene Gegend haben wir hier, gell?", "sagt stolz: ");
  AddInfo( ({"ochsen", "karren", "ochsenkarren"}),
    "Hier fahren viele Ochsenkarren in Richtung "+N_STADT+".", "sagt: ");
  AddInfo( ({"schaf", "schafen", "hirte", "schafhirte", "schaefer"}),
    "Hier in der Naehe gibt es einen Hirten der seine Schafe hier weiden "
    "laesst. Er stammt auch aus "+N_STADT+".", "sagt: ");

  SUID;
  CLONEME(WEAPON "pickel");
  switch( random(4) )
  {
    case 0: command("fasse pickel lang");
            break;
    case 1: command("fasse pickel kurz");
            break;
    case 2: command("fasse pickel zweihaendig");
            break;
    case 3: command("fasse pickel am kopf");
            break;
  }
  command("zuecke pickel");
  clone_object(ARMOUR "kletterhelm")->move(this_object());
  clone_object(ARMOUR "parka")->move(this_object());
  CLONEME( ARMOUR "steigeisen" );
  command("ziehe alles an");
  clone_object( KLETTERHAKEN )->move(this_object());
  clone_object("/obj/seil")->move(this_object());
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Retter ) "
               " -%d EP\n", lostexp) );
}

void die(int poisondeath)
{
  write_file(LOG "retter.kills",
    dtime(time())+": "+CAP(getuid(TP))+" toetet den Retter.\n");
  domainshout("Ein Bergwacht-Mann ruft: AAAAAAAaaaaaaaa.......... *PLATSCH*\n");
  ::die(poisondeath);
}
