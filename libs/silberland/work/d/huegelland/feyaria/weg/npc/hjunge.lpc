// /d/huegelland/feyaria/weg/npc/hjunge.c
// Der Hirtenjunge
// 1998-08-06  Feyaria@SilberLand

inherit "std/npc";

#include "../def.h"
#include "../squest.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Ein Hirtenjunge");
  SetProp(P_LONG, BS(
    "Dieser kleine Hobbit passt hier auf die Kuehe auf. Er hat braunes, "
    "gekraustes Haar und ist sehr klein - selbst fuer einen Hobbit. "
    "Da er auch sehr jugendliche Gesichtszuege hat, ist er wohl noch nicht "
    "ganz erwachsen. In der Hand hat er einen Hirtenstab, mit dem er die "
    "Kuehe herumtreibt."));
  SetProp(P_NAME, "Hirtenjunge");
  SetProp(P_GENDER, MALE);
  AddId( ({"jungen","junge", "hirtenjunge", "hirte", "cowboy", "hobbit"}) );

  create_default_npc(10);
  SetProp(P_RACE, "Hobbit");
  SetProp(P_SIZE, 75+random(5));
  SetProp(P_ALIGN, 250);
  SetProp(P_MAX_HANDS, 2);

  AddInfo(DEFAULT_INFO, ({
    "sagt: Ich bin doch nur ein einfacher Hirtenjunge!\n",
    "sagt: Hmm???\n",
    "schaut stumm zu Boden.\n",
    "beachtet Dich nicht.\n",
    "sagt: Ich kenn mich nur mit Kuehen aus.\n",
    "gruebelt nur.\n"}) );
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  AddInfo( ({"weide", "gras"}),
    "Hier auf der Weide finden meine Kuehe das beste Gras.\n", "sagt: ");
  AddInfo( ({"kuh", "kuehe", "kuehen", "hirte", "kuhhirte"}), 
    "Ich passe auf die Kuehe auf.", "sagt: ");
  AddInfo( ({"stier", "rot"}),
    "Der Stier ist gefaehrlich. Vor allem, wenn Du etwas Rotes anhast.", 
    "sagt: ");
  AddInfo( ({"milch"}),
    "Die Kuehe hier geben leider nur wenig Milch.", "sagt :");
  AddInfo( ({"kalb"}),
    "Was? Hat eine Kuh schon ein Kalb bekommen? Wo ?", "sagt ueberrascht: ");
  AddInfo( ({"derlim", "hobbingen"}),
    "Das ist meine Heimatstadt.", "sagt froehlich: ");
  AddInfo( ({"huegel", "huegeln", "huegellandschaft"}),
    "Mir gefallen die Huegel sehr gut. In die Berge geh ich aber nie wieder!", 
    "sagt: ");
  AddInfo( ({"berg", "berge"}),
    "Ich mag die Berge nicht, Dort wohnen naemlich die Murmeltiere.", 
    "sagt: ");
  AddInfo( ({"hobbit", "hobbits"}),
    "Ja, ich bin ein Hobbit!", "sagt stolz: ");
  AddInfo( ({"murmeltier", "murmeltiere", "murmeln", "murmel"}), 
      "@@find_murmel@@");
  AddInfo( ({"kugeln", "kugel", "glaskugel", "glaskugeln"}),
    "Ich versteh gar nicht, was die Murmeltiere mit Glaskugeln wollen. Oder "
    "ist das nur, weil die einen aehnlichen Namen haben?", "gruebelt: ");
  AddInfo( ({"spinne", "spinnen", "spinnenfutter", "futter"}),
    "Frueher hab ich oft Futter fuer die Spinne von Dodo besorgt. Aber jetzt "
    "mag ich nicht mehr ueber die Berge gehen. Wenn Du mir meine Murmeln "
    "wiederbringst, verrate ich Dir auch, wie Du selber Spinnenfutter "
    "besorgen kannst.", "sagt: ");
  AddInfo( ({"dodo", "laden"}),
    "Dodo ist der Besitzer des Ladens in Derlim. Ich habe oft fuer seine "
    "Spinne Futter besorgt.", "sagt: ");
  AddInfo( ({"fliegen", "fliege", "muecke", "muecken", "fliegenschwarm",
             "mueckenschwarm"}),
    "Fliegen und Muecken eignen sich bestens fuer Spinnenfutter. Vor allem "
    "im Schilf in der Naehe eines Sees findet man oft ganze Fliegen- und "
    "Mueckenschwaerme.", "sagt: ");
  AddInfo( ({"see", "schilf", "schilfguertel"}),
    "Hinter dem Berg gibt es einen See mit einem breitem Schilfguertel.", 
    "sagt: ");
  AddInfo( ({"fladen", "kuhfladen"}),
    "Steig da ja nicht rein!", "warnt Dich: ");
  AddInfo( ({"stock"}),
    "Du brauchst einen ganz normalen Stock.", "sagt: ");
  AddInfo( ({"fluessigkeit", "kleber", "klebrige fluessigkeit"}),
    "Der Speichel von Froeschen eignet sich da hervorragend dazu. Steck den "
    "Stock einfach in ein Froschmaul, und schon ist der Stock so klebrig, "
    "dass jede Fliege daran haengen bleibt.", "sagt: ");
  AddInfo( ({"speichel"}),
    "Der Speichel von Froeschen ist so klebrig, dass Fliegen daran kleben "
    "bleiben.\n", "sagt: ");
  AddInfo( ({"harz"}),
    "Harz ist zwar auch klebrig, aber die Spinne kann keine Fliegen fressen, "
    "die in Harz eingehuellt sind.", "sagt bedauernd: ");
  AddInfo( ({"frosch", "froesche", "froschmaul", "maul"}),
    "Froesche gibt es ueberall in sumpfigen Gegenden.", "sagt: ");

  SetProp(P_REJECT, ({ REJECT_KEEP, 
    "Der Hirtenjunge bedankt sich herzlichst.\n"}));

  SetChats(2, ({
    "Der Hirtenjunge schaut gelangweilt in den Himmel.\n",
    "Der Hirtenjunge seufzt: Wie bekomm ich bloss meine Murmeln wieder?\n",
    "Der Hirtenjunge verflucht die Murmeltiere.\n",
    "Der Hirtenjunge zaehlt seine Kuehe.\n",
    "Der Hirtenjunge fragt: Was machst Du auf der Kuhweide?\n",
    "Der Hirtenjunge schaut Dich neugierig an.\n",
    "Der Hirtenjunge beobachtet seine Kuehe.\n"}) );

  SetProp(P_DIE_MSG," wird nie wieder Kuehe hirten.\n");

  CLONEME(WEAPON "stab");
  command("zuecke stab");
  if( random(2) ) CLONEME("/p/armour/trousers/lederhose");
  if( random(2) ) CLONEME("/p/armour/armour/hemd");  
  if( random(2) ) CLONEME("/p/armour/boots/sandalen");  
  command("trage alles");
}


void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( gruppe=="fies" && find_call_out("fies")==-1)
    call_out("fies",0);
  if( gruppe=="intim" || gruppe=="nett" || gruppe=="froehlich" && 
      find_call_out("intim")==-1 && random(2) )
    call_out("intim",0);
  if( (gruppe=="traurig" || gruppe=="aengstlich")
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  command_me("sag Wieso bist Du so gemein zu mir ?");
}

void intim()
{
  write(Name(WER,1)+" knuddelt Dich.\n");
  tell_room(MENV, Name(WER,1)+" knuddelt "+TP->name(WEN)+".\n",({TP,TO}) );
}

void traurig()
{
  tell_object(TP, Name(WER,1)+ " troestet Dich.\n");
  tell_room(MENV, Name(WER,1)+ " troestet "+TP->name(WEN)+".\n", ({TP, TO}) );
}

void fliegenfang()
{
  write(break_string("Spinnenfutter zu besorgen ist ganz einfach: Du "
    "brauchst nur einen ganz normalen Stock mit einer klebrigen Fluessigkeit "
    "bestreichen und diesen dann durch einen Fliegenschwarm zu schwingen. "
    "Die Fliegen bleiben daran haengen, und wenn Du genug hast, brauchst Du "
    "sie nur einzusammeln.", 78, "Der Hirtenjunge vertraut Dir an: ") );
  present("murmeln")->remove();  
  call_out("murmeln",6);
}


void murmeln()
{
  tell_room(MENV, "Der Hirtenjunge spielt mit seinen Murmeln und freut sich "
    "riesig.\n");
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

string find_murmel()
{
  object squest;
  if( squest=present(SPINNENQUEST_ID, TP) )
    squest->set_quest(SQ_JUNGE_BEFRAGT);
  tell_room(MENV, break_string(
    "Die boesen Murmeltiere haben mir meine Murmeln gestohlen! Jetzt spielen "
    "wohl die mit meinen schoenen, bunten Glaskugeln :(.", 78,
    Name(WER,1)+ " sagt weinerlich: "));
  return "seufzt herzzerreissend.\n";
}

void give_notify(object ob)
{
  object squest;
  if( ob->id("\nhirtenjunge_murmeln") && (squest=present(SPINNENQUEST_ID,TP)) &&
      squest->query_quest()== SQ_DODO_BEFRAGT+SQ_JUNGE_BEFRAGT+SQ_MURMEL_GEFUNDEN )
  {
    call_out("fliegenfang",2);
    squest->set_quest(SQ_MURMEL_ABGELIEFERT);
  }
  ::give_notify(ob);
}


