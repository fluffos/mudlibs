// /d/gebirge/feyaria/weg/npc/schaf.c
// Ein Schaf
// 1997-01-01  Feyaria@SilberLand
// 2001-07-24  Ronja@SL

inherit "std/mnpc";

#include "../def.h"

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>

int wolle = 1;
int milch = 1;

void init()
{
  ::init();
  if (TP && TP->id("\nschaeferhund")) AddDefender(TP);
  if (TP && TP->id("\nschaefer")) AddDefender(TP);
}

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Ein Schaf");
  SetProp(P_LONG,
    "Das Schaf hat ein dickes, weisses Fell. Sicher ist es schon lange "
    "nicht mehr geschoren worden.");

  SetProp(P_NAME, "Schaf");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"schaf", "\nschaf", "FELL_WUSCHEL"}) );

  create_default_npc(9);
  SetProp(P_HANDS, ({" mit seinen Hufen", 70, DT_BLUDGEON}));
  SetProp(P_RACE, "Schaf");
  SetProp(P_SIZE, 100+random(10));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE, ({DT_COLD}) );
  SetProp(P_WIMPY, 50);
  SetProp(P_WIMPY_DIRECTION, "emote bloekt angsterfuellt");
  SetProp(P_HEAL, 5);

  SetProp(P_MSGIN, "kommt bloekend an");
  SetProp(P_MSGOUT, "trottet bloekend");
  SetProp(P_MMSGIN, "kommt bloekend an");
  SetProp(P_MMSGOUT, "trottet weit weg");
  SetProp(P_MNPC_AREA, ROOM );
  SetProp(P_MNPC_WAIT, ({ 10, 40, 35 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "0507");
  SetProp(P_MNPC_FLAGS,
    MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_INFIGHT);

  AddInfo(DEFAULT_INFO, "bloekt.\n" );
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "bloekt: ");
  SetProp(P_REJECT, ({ REJECT_DROP,
     "Das Schaf schnuppert nur an Deinen Sachen.\n"}));
  SetProp(P_DIE_MSG, " bloekt das letzte Mal.\n");

  SetChats(2, ({
    "Das Schaf knabbert an dem spaerlichen Gras.\n",
    "Das Schaf schaut Dich daemlich an.\n",
    "Das Schaf schaut dumm durch die Gegend.\n",
    "Das Schaf bettelt um Salz.\n",
    "Das Schaf laesst einen stinkenden Haufen fallen.\n",
    "Das Schaf trabt ein Stueck weiter.\n",
    "Das Schaf frisst etwas Gras.\n",
    "Das Schaf bloekt laut.\n",
    "Das Schaf bloekt leise.\n",
    "Das Schaf bloekt.\n"}) );

  AddCmd( ({"huete", "huet"}), "hueten");
  AddCmd( ({"schere", "scher"}), "scheren");
  AddCmd( ({"melk","melke"}) , "cmd_melken" );
}

void reset()
{
  ::reset();
  wolle = 1;
  milch = 1;
  SetProp(P_LONG,
    "Das Schaf hat ein dickes, weisses Fell. Sicher ist es schon lange "
    "nicht mehr geschoren worden.");
}

int hueten(string str)
{
  notify_fail("Wen willst Du hueten?\n");
  if( str== "schaf" || str=="schafe" )
  {
    write("Um Schafe zu hueten musst Du schon ein Schaefer sein!\n");
    return 1;
  }
  return 0;
}

int scheren(string str)
{
  notify_fail("Wen willst Du scheren?\n");
  if( id(str) )
  {
    if( !present("schere", TP) )
    {
      write("Um Schafe zu scheren braucht Du schon eine Schere!\n");
      return 1;
    }
    if( wolle)
    {
      write("Du scherst das Schaf und steckst die Schafwolle ein.\n");
      CLONE( OBJ "wolle", TP);
      wolle=0;
      SetProp(P_LONG,
          "Das Schaf hat eine glatte Haut und schaut irgendwie nackt aus, "
          "es wurde wohl erst vor kurzem geschoren.");
    }
    else
      write("Das Schaf wurde schon vor kurzem geschoren.\n");
    return 1;
  }
  return 0;
}

int cmd_melken(string str)
{
  object kanne, hirte;

  notify_fail("Wen moechtest Du melken?\n");

  if(!str || str == "") return 0;
  if(!id(str)) return 0;

  if(!(kanne=present("milchkanne",TP)))
  {
    tell_object(TP,"Du hast ja gar keine Milchkanne dabei.\n");
    return 1;
  }

  if(kanne->QueryStat())
  {
    tell_object(TP,"Deine Milchkanne ist doch schon voll.\n");
    return 1;
  }

  if(!present("melkschemel",TP))
  {
    tell_object(TP,"Du hast ja gar keinen Melkschemel dabei.\n");
    return 1;
  }

  if(hirte=present("\nschaefer",ENV(TO)))
  {
    tell_object(TP,"Der Schaefer wird wuetend: DU MILCHDIEB!\n");
    hirte->Kill(TP);
    return 1;
  }

  if(!milch)
  {
    tell_object(TP, "Dieses Schaf gibt keine Milch mehr.\n");
    return 1;
  }

  tell_object(TP, BS(
    "Du setzt Dich auf deinen Melkschemel, stellst die Milchkanne unter "
    "das Schaf und faengst an, das Schaf zu melken. Puuuh, ist das muehsam. "
    "Doch mit der Zeit geht Dir das Melken leichter von der Hand und Du "
    "bekommst Deine Milchkanne doch noch mit leckerer Schafsmilch voll. "
  ));

  tell_room(ENV(TO),BS(
    CAP(TPN)+" setzt sich auf einen Melkschemel und faengt an das Schaf "
    "zu melken. Nach einiger Zeit ist die Kanne sogar voll geworden. "
  ),({TP}));

  milch = 0;
  kanne->SetStat(2);
  return 1;
}

void give_notify(object ob)
{
  if( ob->QueryMaterial(MAT_FOOD) )
  {
    tell_room(MENV, "Das hungrige Schaf frisst gierig alles auf.\n");
    ob->remove();
    return;
  }
  ::give_notify(ob);
}
