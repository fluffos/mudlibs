// /d/gebirge/feyaria/weg/npc/karren.c   
// ein Ochsenkarren
// 22-12-1996  Feyaria@SilberLand

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Ochsenkarren");
  SetProp(P_LONG, BS(
    "Dieser Ochsenkarren transportiert Waren durch das ganze SilberLand. "
    "Zwei grosse Ochsen sind vor den Karren gespannt und ein schmaechtiger "
    "Haendler sitzt auf dem Karren und treibt sie mit seiner Peitsche an."));
  SetProp(P_NAME, "Ochsenkarren");
  SetProp(P_GENDER, MALE);
  set_living_name("ochsenkarren");
  AddId(({"ochsenkarren", "karren"}));
  AddDetail( ({"ochsen", "ochse"}),
    "Die Ochsen muessen sich ganz schoen anstrengen, um diesen schweren "
    "Karren zu ziehen.");
  AddDetail( ({"haendler"}),
    "Der Haendler sitzt auf dem Karren und treibt seine Ochsen mit seiner "
    "Peitsche an.");
  AddDetail( ({"peitsche"}),
    "Die sturen Ochsen kann man wohl nur mit einer Peitsche zum Ziehen "
    "bringen.");

  create_default_npc(30);
  SetProp(P_RACE, "Karren");
  SetProp(P_SIZE, 230);
  SetProp(P_NOATTACK, "kann nicht angegriffen werden.\n");

  SetProp(P_MSGIN, "rumpelt herein");
  SetProp(P_MSGOUT, "wird von den Ochsen# gezogen");
  SetProp(P_MMSGIN, "rumpelt herein");
  SetProp(P_MMSGOUT, "wird ganz weit weg gezogen");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "0101");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INFIGHT);

  AddInfo(DEFAULT_INFO, "faehrt unbeirrt weiter.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "In dem Ochsenkarren ist nicht mehr genug Platz fuer Deine Sachen.\n"}));

  SetChats(10, ({
    "Die Ochsen stoehnen unter dem Gewicht des Karrens.\n",
    "Der Haendler treibt seine Ochsen mit der Peitsche an.\n",
    "Der Ochsenkarren rumpelt ueber ein Schlagloch.\n",
    "Der Haendler auf dem Ochsenkarren winkt Dir zu.\n",
    "Ein Ochse schnaubt laut unter der Anstrengung.\n",
    "Der Ochsenkarren rumpelt knapp neben Dir vorbei.\n",
    "Die Raeder des Ochsenkarrens rollen beinahe ueber Deine Fuesse.\n",
    "Der Haendler treibt seine Ochsen zur Eile an.\n",
    "Die Achse des Karrens quietscht unter der grossen Belastung.\n",
    "Der Ochsenkarren schwankt bedenklich auf dieser schlechten Strasse.\n",
    "Der Haendler laesst seine Peitsche knallen.\n",
    "Der Ochsenkarren wird langsamer, als er an Dir vorbei faehrt.\n",
    "Der Haendler auf dem Ochsenkarren gruesst Dich freundlich.\n",
    "Der Haendler ruft: Huehott ihr faulen Ochsen!\n"}) );

}

string long()
{
  return BS(
    "Dieser Ochsenkarren transportiert Waren durch das ganze SilberLand. "
    "Zwei grosse Ochsen sind vor den Karren gespannt und ein schmaechtiger "
    "Haendler sitzt auf dem Karren und treibt sie mit seiner Peitsche an.");
}
