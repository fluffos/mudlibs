// /d/gebirge/feyaria/weg/npc/adler.c   
// Ein Steinadler
// 30-12-1996  Feyaria@SilberLand

inherit "std/mnpc";

#include "../def.h"

void create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Steinadler");
  SetProp(P_LONG, BS(
    "Der Steinadler ist ein maechtiger Raubvogel und der Herrscher der "
    "Luefte in dieser Bergregion. Er hat schwarze Federn, scharfe Faenge "
    "und einen spitzen Schnabel.")+
      "                     /\n"
      "      \\             / /\n"
      "       \\\\\\' ,      / //\n"
      "        \\\\\\//,   _/ //,\n"
      "         \\_-//' /  //<,\n"
      "           \\ ///  <//`\n"
      "          /  >>  \\\\\\`__/_\n"
      "         /,)-^>> _\\` \\\\\\\n"
      "        (/   \\\\ //\\\\\n"
      "             // _//\\\\\\\\\n"
      "            ((` ((\n\n");

  SetProp(P_NAME, "Steinadler");
  SetProp(P_GENDER, MALE);
  AddId( ({"adler", "steinadler", "Adler"}) );
  AddDetail( ({"faenge", "schnabel"}),
    "Der Steinadler ist sicher sehr gefaehrlich.");
  AddDetail( ({"feder", "federn", "adlerfeder", "adlerfedern"}),
    "Der Steinadler hat schoene, schwarze Federn.");
  
  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen scharfen Faengen", 230, DT_RIP}));
  SetProp(P_XP, QueryProp(P_XP)+1500*100);
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 100+random(20));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_AIR       : -0.7, DT_COLD      : -0.3, DT_SOUND     : -0.2,
         DT_LIGHTNING :  0.2, DT_FIRE      :  0.2, DT_BLUDGEON  :  0.3 ]) );

  AddInfo(DEFAULT_INFO, "kreischt.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "kreischt: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Adler will Deine Sachen nicht.\n"}));
  SetProp(P_DIE_MSG, " stuerzt zu Boden.\n");

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MMSGIN, "fliegt herein");
  SetProp(P_MMSGOUT, "fliegt weit weg");
  SetProp(P_MSGOUT, "fliegt");

  SetProp(P_SPELLRATE, 50);
  AddSpell(9, 300, 
    "Der Steinadler greift Dich mit seinem spitzen Schnabel an.\n",
    "Der Steinadler greift @WEN mit seinem spitzen Schnabel an.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 900, 
    "Der Steinadler stuerzt Dich die Klippe hinunter.\n",
    "Der Steinadler stuerzt @WEN die Klippe hinunter.\n",
    DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  SUID;
  if (PO && strstr(file_name(PO), "astral") != -1)
    CLONEME( OBJ "federn");
  else
    for(i = 0; i < 2 + random(5); i++)
      CLONEME( OBJ "federn");
}

void init()
{
  ::init();
  if ( TP && TP->id("Adler")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

