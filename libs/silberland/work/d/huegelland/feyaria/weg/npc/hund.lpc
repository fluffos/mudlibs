// /d/gebirge/feyaria/weg/npc/hund.c   
// Ein Schaeferhund
// 1997-01-01  Feyaria@SilberLand

inherit "std/mnpc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <mnpc.h>

init()
{
  ::init();
  if (TP && TP->id("\nschaefer")) AddDefender(TP);
}

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Schaeferhund");
  SetProp(P_LONG, BS(
    "Der Schaeferhund hat ein dickes, zotteliges Fell und einen buschigen "
    "Schwanz. Laut klaeffend treibt er die Schafe in die richtige Richtung "
    "und sorgt dafuer, dass kein Schafe verloren geht.") );
  SetProp(P_NAME, "Schaeferhund");
  SetProp(P_GENDER, MALE);
  AddId( ({"hund", "schaeferhund", "\nschaeferhund", "FELL_WUSCHEL"}) );

  create_default_npc(14);
  SetProp(P_HANDS, ({" mit seinem Gebiss", 155, DT_RIP}));
  SetProp(P_RACE, "Hund");
  SetProp(P_SIZE, 110+random(10));
  SetProp(P_ALIGN, 222);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE, ({DT_COLD}) );
  SetProp(P_TRANSPARENT, 0);
  
  SetProp(P_MSGIN, "kommt bellend an");
  SetProp(P_MSGOUT, "laeuft bellend");
  SetProp(P_MMSGIN, "kommt bellend an");
  SetProp(P_MMSGOUT, "laeuft weit weg");
  SetProp(P_MNPC_AREA, ROOM );
  SetProp(P_MNPC_WAIT, ({ 5, 15, 15 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "0507");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, ({
    "bellt laut.\n",
    "sagt: Wau! Wau!\n",
    "sagt: Wuff! Wuff!\n",
    "knurrt\n",
    "klaefft.\n",
    "schleckt Dein Gesicht ab.\n",
    "schaut Dich treuherzig an.\n",
    "wedelt mit seinem Schwanz.\n"}) );
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "bellt: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Schaeferhund will Deine Sachen nicht.\n"}));
  SetProp(P_DIE_MSG, " bellt das letzte mal.\n");

  SetChats(10, ({
    "Der Schaeferhund bellt laut.\n",
    "Der Schaeferhund wedelt mit seinem Schwanz.\n",
    "Der Schaeferhund schaut Dich treuherzig an.\n",
    "Der Schaeferhund bellt.\n",
    "Der Schaeferhund hechelt.\n",
    "Der Schaeferhund treibt die Schafe hin und her.\n",
    "Der Schaeferhund pinkelt an Dein Bein.\n",
    "Der Schaeferhund klaefft.\n",
    "Der Schaeferhund klaefft laut.\n",
    "Der Schaeferhund winselt.\n",
    "Der Schaeferhund winselt leise.\n",
    "Der Schaeferhund knurrt.\n",
    "Der Schaeferhund knurrt Dich an.\n",
    "Der Schaeferhund springt in der Gegend herum.\n",
    "Der Schaeferhund heult.\n",
    "Der Schaeferhund schnappt spielerisch nach Deinem Bein.\n",
    "Der Schaeferhund bellt die Schafe an.\n",
    "Der Schaeferhund klaefft die Schafe an.\n",
    "Der Schaeferhund beobachtet aufmerksam die Schafe.\n",
    "Der Schaeferhund schleckt Dein Gesicht ab.\n",
    "Der Schaeferhund schaut Dich treuherzig an.\n",
    "Der Schaeferhund schnuppert an Deinen Fuessen.\n",
    "Der Schaeferhund schnuppert.\n",
    "Der Schaeferhund schnuppert an Dir.\n",
    "Der Schaeferhund knurrt ein Schaf an.\n"}) );

  SetProp(P_SPELLRATE, 30);
  AddSpell(1, 333,
    "Der Schaeferhund beisst Dich ins Bein.\n",
    "Der Schaeferhund beisst @WEN ins Bein.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
  
  CLONEME("/d/ebene/creative/feldlager/obj/haar");
}

void InformDefend(object enemy) 
{
  Kill(enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Schaeferhund ) "
               " -%d EP\n", lostexp) );
}
