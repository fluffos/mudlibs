// /d/gebirge/feyaria/weg/npc/bremse.c   
// Eine laestige Bremse
// 31-12-1996  Feyaria@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include "../def.h"
#include <moving.h>

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine laestige Bremse");
  SetProp(P_LONG, BS(
    "Die laestige Bremse surrt um Deinen Kopf herum und wird Dich sicher "
    "gleich stechen."));
  SetProp(P_NAME, "Bremse");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"bremse"}) );

  create_default_npc(1);
  SetProp(P_HANDS, ({" mit ihrem schmerzenden Biss", 25, DT_POISON}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 3);
  SetProp(P_ALIGN, -70);
  SetProp(P_MAX_HANDS, 6);

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "fliegt herein");
  SetProp(P_MMSGOUT, "fliegt weit weg");
  SetProp(P_DIE_MSG, " bremst nicht rechtzeitig und stirbt vorzeitig.\n");
  
  AddInfo(DEFAULT_INFO, "surrt.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    "Die Bremse kann das nicht nehmen.\n"}));

  SetChats(3, ({
    "Die Bremse setzt sich auf Deine Nase.\n",
    "Die Bremse beisst Dich.\n",
    "Die Bremse sticht Dich.\n",
    "Die Bremse surrt herum.\n",
    "Die Bremse surrt um Deinen Kopf herum.\n"}) );
}
