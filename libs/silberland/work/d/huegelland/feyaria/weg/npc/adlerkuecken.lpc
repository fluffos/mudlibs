// /d/gebirge/feyaria/weg/npc/adler.c   
// Ein Riesenadlerkueken 
// 30-12-1996  Feyaria@SilberLand

inherit "std/npc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>

create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Adlerkueken");
  SetProp(P_LONG, BS(
    "Obwohl dieses Adlerkueken noch sehr jung ist, ist es schon groesser "
    "als Du. Es hat flauschige Federn und blickt Dich suess an. Das kann "
    "aber nicht darueber hinwegtaeuschen, dass dieser kleine Adler schon "
    "recht gefaehrlich ist, denn seine Faenge und sein Schnabel sind schon "
    "sehr spitz."));
      
  SetProp(P_NAME, "Adlerkueken");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"adler", "adlerkueken", "kueken", "Adler"}) );
  AddDetail( ({"faenge", "schnabel"}),
    "Das Adlerkueken ist sicher schon sehr gefaehrlich.");
  AddDetail( ({"feder", "federn", "alderfeder", "adlerfedern"}),
    "Das Adlerkueken hat schoene, flauschige Federn.");
  
  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen scharfen Faengen", 210, DT_RIP}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 150+random(20));
  SetProp(P_ALIGN, 900);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS,
      ([ DT_AIR       : -0.7, DT_COLD      : -0.3, DT_SOUND     : -0.2,
         DT_LIGHTNING :  0.2, DT_FIRE    :  0.2 ]) );

  AddInfo(DEFAULT_INFO, "kreischt.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "kreischt: ");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
     "Das Adlerkueken zerfetzt @WEN mit seinem Schnabel.\n"}));
  SetProp(P_DIE_MSG, " stuerzt zu Boden.\n");

  SetProp(P_SPELLRATE, 50);
  AddSpell(1, 444, 
    "Das Adlerkueken greift Dich mit seinem spitzen Schnabel an.\n",
    "Das Adlerkueken greift @WEN mit seinem spitzen Schnabel an.\n",
    DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SUID;
}

void init()
{
  ::init();
  if ( TP && TP->id("Adler")) AddDefender(TP);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if( gruppe=="fies" && find_call_out("fies")==-1)
    call_out("fies",0);
  if( gruppe=="intim" && find_call_out("intim")==-1)
    call_out("intim",0);
  if( (gruppe=="traurig" || gruppe=="aengstlich")
      && find_call_out("traurig")==-1 && !random(3) )
    call_out("traurig",0);
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  StartReaction(verb, gruppe, adverb, touch);
}

void fies()
{
  command_me("emote kreischt zornig auf.");
}

void intim()
{
  write(Name(WER,1)+" schmiegt sich an Dich an.\n");
  tell_room(TO, Name(WER,1)+" schmiegt sich an "+TP->name(WEN)+" an.\n");
}

void traurig()
{
  tell_object(TP, Name(WER,1)+ " troestet Dich.\n");
  tell_room(MENV, Name(WER,1)+ " troestet "+TPN+".\n", ({TP, TO}) );
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Adlerkueken ) "
               " -%d EP\n", lostexp) );
}

void die(int poisondeath)
{
  write_file(LOG "retter.kills",
    dtime(time())+": "+CAP(getuid(TP))+" toetet ein Adlerkueken.\n");
  ::die(poisondeath);
}
