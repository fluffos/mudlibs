//
// Ein echter Kuhfuss. Angrox@SL :)
//
inherit "std/weapon";
#include <properties.h>		// Properties
#include <combat.h>		// kampfspezifische Konstanten
#include <language.h>		// MALE, FEMALE, WER, ...
#include <thing/material.h> 	//MAT_WOOD, MAT_METAL...
#include <moving.h>		// needed becaus of special grip function
#include <defines.h>
#include <moredef.h>


create()
{
  if (!is_clone(this_object()))
     return;

  ::create(); 
  SetProp(P_SHORT, "Kuhfuss");
  SetProp(P_ARTICLE,"Ein");
  SetProp(P_LONG, 
      "Das ist der Fuss einer grossen toten Kuh. Was man damit wohl machen "
      "kann?");
  SetProp(P_NAME, "Kuhfuss");
  SetProp(P_GENDER, MALE);
  AddId(({"kuhfuss"}));
  SetProp(P_VALUE, 10);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_WC, 40);
  SetProp(P_WC_FIX,30);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL,([MAT_MISC_LIVING:100]));
}

