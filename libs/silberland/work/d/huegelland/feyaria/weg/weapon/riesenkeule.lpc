// /d/gebirge/feyaria/weg/weapon/trollkeule.c
// Die Keule des Trolls
// 1996-01-02  Feyaria@SilberLand

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine Riesenkeule");
  SetProp(P_LONG, BS( 
    "Diese Keule ist fast 3 Meter lang und mit langen Stacheln gespickt. "
    "Sie schaut sehr massiv und schwer aus, sodass nur ein Riese sie "
    "vernuenftig fuehren kann.") );
  SetProp(P_INFO, BS(
    "Mit dieser Waffe kann man sehr gut gegen kleine Lebewesen kaempfen. "
    "Wenn man die Keule von oben auf den Kopf des Gegeners schlaegt, so "
    "kann es sein, dass der Schaedel des Feindes zerbricht.") );
  SetProp(P_NAME, "Riesenkeule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"keule", "riesenkeule"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 293);
  SetProp(P_WC_FIXFACTOR, 0.2);
  SetProp(P_QUALITY_DECAY, 75);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, MAT_FIR );
  SetProp(P_WEIGHT, 20000);
  SetProp(P_VALUE, 1777);

  SetProp(P_WIELD_RESTRICTIONS, ([P_SIZE:190, A_STR:20]) );
  SetProp(P_HIT_FUNC, TO );
}

int HitFunc( object enemy )
{
  object pl;
  pl=QueryProp(P_WIELDED);
  if( !enemy->QueryProp(P_SIZE) ) return 0;
  if( enemy->QueryProp(P_SIZE) < 70+random(55) && !random(4) )
  {
    write("Du zerschmetterst den Schaedel "+ enemy->name(WESSEN) +".\n");
    tell_object(enemy, CAP(pl->name()) +" zerschmettert Deinen Schaedel.\n");
    tell_room(ENV(pl),CAP(pl->name()) +" zerschmettert "+ enemy->name(WESSEN)
             + " Schaedel.\n", ({pl, enemy}) );
    return(pl->QueryAttribute(A_STR)*(10+random(5)) );
  }  
  return 0;
}
