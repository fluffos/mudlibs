inherit "/std/weapon";

#include "../def.h" 

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Huegelkatzenkralle");
  SetProp(P_LONG, 
    "Das ist die Kralle einer Huegelkatze. Sie ist sehr spitz und laesst "
    "sich als Dolch verwenden.");
  SetProp(P_NAME, "Huegelkatzenkralle");
  SetProp(P_GENDER, FEMALE);
  AddId (({"kralle","huegelkatzenkralle", "katzenkralle"}));
  
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_DAM_TYPE, DT_PIERCE);
  SetProp(P_WC, 60);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_HORN:100]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 750);
}

