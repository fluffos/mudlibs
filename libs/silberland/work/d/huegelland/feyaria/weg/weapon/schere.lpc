// /d/huegelland/feyaria/weg/weapon/schere.c
// Schere zum Schafscheren 
// 1998-10-26 Feyaria@SilberLand


#include "../def.h"

inherit "std/weapon";

void create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Eine Schafschere");
  SetProp(P_LONG,  
    "Eine grosse Schere, die man zum Scheren von Schafen verwenden kann.");
  SetProp(P_NAME, "Schafschere");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schere", "schafschere"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 50);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 100);

}
