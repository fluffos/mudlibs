inherit "std/weapon";

#include <properties.h>		// Properties
#include <combat.h>		// kampfspezifische Konstanten
#include <language.h>		// MALE, FEMALE, WER, ...
#include <thing/material.h> 	//MAT_WOOD, MAT_METAL...
#include <moving.h>		// needed becaus of special grip function
#include "../cheasy_defs.h"	// makrodefinitionen

create() 
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Pickel");
  SetProp(P_LONG, 
    BS("Dieser Eispickel ist hauptsaechlich dazu gedacht, um dem Traeger"
      " beim erklettern von Eiswaenden einen zusaetzlichen Halt zu geben,"
      " man kann damit aber auch zuschlagen.") );
  // Die Besonderheiten des Pickels sind nur per identifiziere zu erkennen
  SetProp(P_INFO,
    BS("Der Pickel kann auch als Waffe eingesetzt werden, mit"
      " unterschiedlicher Wirkung, je nachdem, wie Du den Pickel haeltst."
      " (Hilfe mit \"pickelhilfe\" oder \"philfe\".)") );

  SetProp(P_NAME, "Pickel");	// Name des Objekts
  SetProp(P_GENDER, MALE);	// Geschlecht, zum deklinieren
  AddId( ({"eispickel", "pickel"}) );	// IDs, auf die das Objekt reagiert
  SetProp(P_VALUE, 5724);	// extrem teuer
  SetProp(P_WEIGHT, 450);	// in Gramm: extrem leicht
  SetProp(P_MATERIAL, ([MAT_ASH_WOOD:75, MAT_TITANIUM:25]) );
				// Der Pickel besteht aus Holz, Titan-metall
  UseBludgeon();		// normalerweise wird der Pickel wie eine
				// Keule benutzt
  SetProp(P_NOBUY, 1);         // Im Laden nicht zu kaufen
  AddCmd( ({"pickelhilfe", "philfe"}), "pickelhilfe");
  AddCmd( ({"fasse", "fass"}), "hold");
} // create()

void UseBludgeon() 
{
  SetProp(P_WEAPON_TYPE, WT_CLUB);  // normalerweise ein Knueppel
  SetProp(P_DAM_TYPE, DT_BLUDGEON); // der stumpfen schaden macht
  SetProp(P_WC, 180 + random(22)); // Maximaler Schaden als Knueppel
  SetProp(P_NR_HANDS, 1);	// P_WC < 150: kein Zweihaender
} // void UseBludgeon()

void UsePierce() 
{
  SetProp(P_WEAPON_TYPE, WT_SPEAR); // jetzt ein Speer
  SetProp(P_DAM_TYPE, DT_PIERCE); // zum reinstechen
  SetProp(P_WC, 185 + random(22));  // Maximaler Schaden als Speer
  SetProp(P_NR_HANDS, 1);	// P_WC < 150: kein Zweihaender
} // void UsePierce()

void UseRip() 
{
  SetProp(P_WEAPON_TYPE, WT_AXE); // jetzt eine Saege
  SetProp(P_DAM_TYPE, DT_RIP);	// die Loecher reisst
  SetProp(P_WC, 190 + random(22)); // Maximaler Schaden als Saege
  SetProp(P_NR_HANDS, 1);	// P_WC < 150: kein Zweihaender
} // void UseRip()

void UseSlash() 
{
  SetProp(P_WEAPON_TYPE, WT_SWORD); // jetzt zweihaendig als Schwert
  SetProp(P_DAM_TYPE, DT_SLASH); // zum aufschlitzen
  SetProp(P_WC, 225+random(30));  // Maximaler Schaden als Schwert
  SetProp(P_NR_HANDS, 2);	// P_WC >= 150: Zweihaender!
} // void UseSlash()

int pickelhilfe(string param) 
{
  if (!param) 
  {
    write(BS("Je nachdem, wie Du den Pickel haeltst, kannst Du"
      " unterschiedlich zuschlagen. Solange der Pickel gezueckt ist, kannst"
      " Du nicht umgreifen. Um mit dem Pickel arbeiten zu koennen, musst Du"
      " den Pickelstiel lang anfassen.") + "\n"
      "Syntax: fass[e] pickel <wie>\n"
      "  <am stiel> oder <lang>:\n"
      "                 Du schwingst den Pickel wie eine Keule.\n"
      "  <kurz>:        Du reisst mit der Pickelseite.\n"
      "  <zweihaendig>: Du fasst mit beiden Haenden zu.\n"
      "  <am kopf>:     Du stichst mit der Pickelspitze zu.\n");
    return 1;
  } 
  else 
  {
    if (param == "lang" || param == "am stiel") 
    {
      write(BS("Wenn der Pickelstiel lang gehalten wird (eine Hand am"
        " auessersten Ende des Stiels), kannst Du damit besonders gut"
        " arbeiten."));
      return 1;
    }
    else if (param == "kurz") 
    {
      write(BS("Du fasst den Pickel mit einer Hand an der Stelle, an der"
        " der Pickelkopf mit dem Stiel verbunden ist, und reisst mit den"
        " Saegezaehnen an der Pickelseite grosse Loecher."));
      return 1;
    }
    else if (param == "zweihaendig") 
    {
      write(BS("Du greifst den Pickel mit einer Hand an der Stelle, an der"
        " der Pickelkopf mit dem Stiel verbunden ist; mit der Anderen am"
        " aussersten Ende des Stiels, und schlaegst mit der flachen,"
        " scharfen Pickelseite zu."));
      return 1;
    }
    else if (param == "am kopf") 
    {
      write(BS("Du umfasst die Stelle, an der der Pickelstiel mit dem Kopf"
        " verbunden ist mit einer Hand und stichst mit dem Stiel zu."));
      return 1;
    }
  }
  return 0;
} // int pickelhilfe(string param)

int canChangeHold() 
{
  if (QueryProp(P_WIELDED)) 
  {
    write("Du kannst nicht umgreifen, solange der Pickel gezueckt ist.\n");
    return 0;
  }
  else 
    return 1;
} // int canChangeHold()

int hold(string params) 
{
  string	*param;
  int		numParams;

  notify_fail("Wie willst Du den Pickel fassen?\n");
  if (!params) return 0; // oops, we need some params
  params = lower_case(params);
  param = explode(params, " "); // separate the param words
  numParams = sizeof(param);
  if (numParams < 2 || numParams > 3) return 0; // wrong number of params
  if (!id(param[0])) return 0; // we're not adressed
  if (param[1] == "lang" && numParams == 2)  
  {
    if (canChangeHold()) 
    {
    UseBludgeon();
    write("Du haeltst den Pickel jetzt an seinem Stiel.\n");
    say(TPN + " haelt den Pickel an seinem Stiel.\n");
    }
  }
  else if (param[1] == "kurz" && numParams == 2) 
  {
    if (canChangeHold()) 
    {
      UseRip();
      write("Du haeltst den Pickel jetzt am oberen Ende des Stiels.\n");
      say(TPN + " haelt den Pickel am oberen Ende des Stiels.\n");
    }  
  } 
  else if (param[1] == "am" && numParams == 3) 
  {
    if (param[2] == "kopf") 
    {
      if (canChangeHold()) 
      {
        UsePierce();
        write("Du haeltst den Pickel jetzt wie einen Speer.\n");
        say(TPN + " haelt den Pickel wie einen Speer.\n");
      }
    } 
    else if (param[2] == "stiel") 
    {
      if (canChangeHold()) 
      {
        UseRip();
        write("Du haeltst den Pickel jetzt am oberen Ende des Stiels.\n");
        say(TPN + " haelt den Pickel am oberen Ende des Stiels.\n");
      }
    }
    else 
    {
       write("Wie willst Du den Pickel denn anfassen?\n");
       say(TPN + " fingert an seinem Pickel herum.\n");
    }
  }
  else if (param[1] == "zweihaendig" && numParams == 2) 
  {
    if (canChangeHold()) 
    {
      UseSlash();
      write("Du haeltst den Pickel jetzt mit beiden Haenden.\n");
      say(TPN + " haelt den Pickel mit beiden Haenden.\n");
    }
  } 
  else 
  {
    write("Wie willst Du den Pickel denn anfassen?\n");
  }
  return 1;
} // int hold(string params)

int move(mixed dest, int method) 
{
  // overridden to change grip to default grip
  UseBludgeon();
  return weapon::move(dest, method ); 
} // int move(mixed dest, int method)

int remove(int silent ) 
{
  // overridden to change grip to default grip
  UseBludgeon();
  return weapon::remove(silent);
} // varargs int remove(int silent )
