// /d/gebirge/feyaria/weg/weapon/stab.c
// Der Hirtenstab des Schaefers
// 1997-01-01 Feyaria@SilberLand


#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Hirtenstab");
  SetProp(P_LONG, BS( 
    "Das ist ein Hirtenstab, wie in viele Schafhirten gerne verwenden.") );
  SetProp(P_NAME, "Hirtenstab");
  SetProp(P_GENDER, MALE);
  AddId( ({"stab", "hirtenstab"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 110);
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_BEECH );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 500);

}
