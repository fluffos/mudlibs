inherit "/std/armour";

#include "../def.h" 

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Murmeltierfell");
  SetProp(P_LONG, 
    "Das ist das Fell eines Murmeltiers. Es ist nicht sehr gross, dafuer "
    "aber sehr dick und warm.");
  SetProp(P_NAME, "Murmeltierfell");
  SetProp(P_GENDER, NEUTER);
  AddId (({"fell","murmeltierfell", "\nfell_is_gerb_able"}));
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_PELT:100]) );
  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 250);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:6, T_HEAT_PROT:-2]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE: 140]) );
}

