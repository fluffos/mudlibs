// /d/gebirge/feyaria/weg/armour/parka.c
// Der Parka ders Bergwacht-mannes
// 1996-04-10 Cheasy@AnderLand
// 1996-12-29 Feyaria@SilberLand

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object()))     return;
  ::create();

  SetProp(P_SHORT, "Ein Parka");
  SetProp(P_LONG, BS(
    "Der Parka ist ein wind- und wasserdichter Umhang aus festem, jedoch "
    "sehr leichtem Filz.") );
  SetProp(P_INFO, BS(
    "Sicher schuetzt der Parka hervoragend gegen starken Wind, Regen und "
    "Kaelte. Er ist also ideal fuer einen Bergsteiger geeignet.") );
  SetProp(P_NAME, "Parka");
  SetProp(P_GENDER, MALE);
  AddId("parka");

  SetProp(P_WEIGHT, 120);
  SetProp(P_VALUE, 9457);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_MATERIAL, ([MAT_FELT:100]) );
  SetProp(P_AC, 8);
  AddProp(P_DAM_PROTECTION, ([DT_COLD:1, DT_AIR:1, DT_WATER:1]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:5,T_HEAT_PROT:-1]) );
}

