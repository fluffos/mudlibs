inherit "/std/armour";

#include "../def.h" 

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Huegelkatzenfell");
  SetProp(P_LONG, 
    "Das ist das Fell einer Huegelkatze. Es ist von geblich-brauner Farbe "
    "und hat feine Querstreifen, die etwas dunkler sind als das Fell.");
  SetProp(P_NAME, "Huegelkatzenfell");
  SetProp(P_GENDER, NEUTER);
  AddId (({"fell","huegelkatzenfell", "katzenfell", "\nfell_is_gerb_able"}));
  AddDetail( ({"querstreifen", "streifen"}),
      "Die Querstreifen sind von etwas dunklerem Braun als das Fell.");
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ([MAT_PELT:100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 750);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:4, T_HEAT_PROT:0]) );
}

