// /d/gebirge/feyaria/weg/armour/mantel.c
// Der Schafspelzmantel des Hirtens
// 1997-01-01 Feyaria@SilberLand

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../def.h"

create()
{
  if( !is_clone(TO) )     return;
  ::create();

  SetProp(P_SHORT, "Ein Schafspelzmantel");
  SetProp(P_LONG, BS(
    "Dieser Schafspelzmantel haelt sicher sehr warm. Er ist so kurz, dass "
    "er wohl nur einem Hobbit passen kann.") );
  SetProp(P_NAME, "Schafspelzmantel");
  SetProp(P_GENDER, MALE);
  AddId( ({"mantel", "pelzmantel", "schafspelzmantel"}) );

  SetProp(P_WEIGHT, 350);
  SetProp(P_VALUE, 500);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_MATERIAL, MAT_PELT);
  SetProp(P_AC, 6);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:7, T_HEAT_PROT:-4]) );

  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE: ({"Hobbit"}) ]) );
}

