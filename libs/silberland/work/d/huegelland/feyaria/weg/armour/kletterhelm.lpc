//  /d/gebirge/feyaria/weg/armour/kletterhelm.c
//  Helm des Bergwachtmannes, nur fuer Hobbits
//  96-04-10 Cheasy@AnderLand
//  96-12-29 Feyaria@SilberLand

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Kletterhelm");
  SetProp(P_LONG,
    BS("Ein gut gepolsterter, leichter Helm, der speziell vor Steinschlag"
      " schuetzen kann."));
  SetProp(P_INFO, BS(
    "Der Kletterhelm ist perfekt an die Kopfform von Hobbits angepasst.") );
  SetProp(P_NAME, "Kletterhelm");
  SetProp(P_GENDER, MALE);
  AddId( ({"helm", "kletterhelm"}) );

  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 1680);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_MATERIAL, MAT_BRASS);
  SetProp(P_AC, 14);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_INCLUDE_RACE: ({"Hobbit"}) ]) );
  SetProp(P_WORN_TEXT, "aufgesetzt");
}

