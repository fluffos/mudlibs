#pragma strong_types

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>

#include "../directions.h"
#include "../cheasy_defs.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_LIGHT, 1);  // es ist hell -- naja ein bisschen
  SetProp(P_INDOORS, 0);// es hat kein Dach
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:11, ENV_TERRAIN:TT_HILL]));
  SetProp(P_INT_SHORT, "Im freien Fall");
  SetProp(P_INT_LONG, BS("Im freien Fall erkennst Du noch die Baeume"
    " ringsum, und den Wasserfall...") );

  AddDetail( ({"wasserfall"}),
    "Der Wasserfall stuerzt von weit ueber Dir herab und durchnaesst"
    " alles mit der Gischt, die vom Wind abgetrieben wird. Von Dir aus"
    " gesehen, scheint das Wasser stillzustehen... komisch.");
  AddDetail( ({"gischt", "dunst"}),
    "Der Wasserfall rauscht mit solcher Wucht nach unten, dass feiner"
    " Dunst entsteht. Diese Gischt peitscht in Dein Gesicht.");
  AddDetail( ({"wasser"}),
    "Wenn Du nicht im Wipfel der Tanne landest, koenntest Du"
    " vielleicht...");
  AddDetail( ({"stamm", "baumstamm"}),
    "Der Stamm des Mammutbaums ist bei Deiner Geschwindkeit kaum zu"
    " erkennen." );
  AddDetail( ({"luft", "wind"}),
    "Die Luft peitscht Dein Gesicht. Au, tut das weh!.");
  AddDetail( ({"krone", "wipfel", "kronen"}),
    "Die Wipfel der ringsum wachsenden Fichten und Tannen moegen Dich"
    " nicht... sie fliehen mit atemberaubender Geschwindigkeit vor Dir.");
  AddDetail( ({"baum", "mammutbaum", "mammutbaeume"}),
    "Der Mammutbaum wird immer hoeher... oder bist Du es, der immer"
    " tiefer faellt?");
  AddDetail( ({"wald", "waldbaum", "waldbaeume", "baeume"}),
    "Du erkennst verschwommen Fichten und Tannen, aus denen riesige"
    " Mammutbaeume ragen.");
  AddDetail( ({"fichte", "fichten", "tanne", "tannen"}),
    "Die Baeume bewegen sich so schnell, dass Du Fichten und Tannen nicht"
    " mehr unterscheiden kannst.");
}

string GetExits() 
{
  return ""; // "Keine sichtbaren Ausgaenge" unterdruecken
}
