#pragma strong_types

#include <properties.h>
#include <language.h>
#include <combat.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_WALDWEG;
  SetProp ( P_INT_LONG, BS (
    "Du wanderst auf einem Waldweg. Im " + CAP(ED8) + " siehst Du einen "
    "kleinen Steg, der ueber einen Bach fuehrt,"
    " im " + CAP(ED5) + " steigt das Gelaende leicht an. Das"
    " Gelaende ist leicht hueglig, und der Weg schlaengelt sich zwischen den"
    " Baeumen hindurch. Ein bestaendiges Summen ertoent aus den Bueschen."));
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:17, ENV_TERRAIN: TT_FOREST]));
  SetProp(P_LIGHT, 1);

  CD_WALDBODEN;
  CD_WALDWEG;
  CD_WALD;
  AddDetail( "gelaende",
    "Der Wald ist so, wie Du ihn gewohnt bist: Ein paar Baeume, gerade"
    " im richtigen Abstand voneinander. Die Baeume stehen wie gewohnt"
    " auf dem Boden und strecken ihre Aeste in die Luft. Dazwischen"
    " wachsen ein paar Buesche, um die sich der Weg herumschlaengelt.");
  AddDetail( ({"busch", "buesche", "gebuesch", "strauch", "straeucher"}),
    "Du erkennst ein paar Haselstraeucher, ein wenig Brombeerhecken, an"
    " den wenigen sonnigen Stellen am Wegrand wachsen auch ein paar"
    " Himbeerstraeucher.");
  AddDetail( ({"haselstraeucher","haselstrauch","haselhecke","haselhecken",
               "haselbusch", "haselbuesche"}),
    "An den Haselstraeuchern erkennst Du ein paar Haselnuesse. Und wenn"
    " Du Dich recht entsinnst, kann man aus kurzen Haselzweigen huebsche"
    " Pfeifchen basteln.");
  AddDetail( ({"pfeife", "pfeifchen"}),
    "Du hast Dir noch kein Pfeifchen gebastelt?");  
  AddDetail( ({"nuss", "nuesse", "haselnuss", "haselnuesse"}),
    "Schade, die Nuesse hier sind noch gruen.");
  AddDetail( ({"haselzweig", "haselzweige"}),
    "Der Haselbusch besteht aus vielen, recht gerade gewachsenen"
    " Zweigen. Diese Zweige haben eine sehr glatte, feste Rinde, die sich"
    " gut vom Holz abloest, wenn man sie rundum locker klopft.");
  AddDetail( ({"hecke", "hecken"}),
    "Hier gibt es Brombeer-, Himbeer- und Haselhecken. Welche"
    " interessiert Dich denn?");
  AddDetail( ({"brombeerhecke", "brombeerhecken", "brombeerstrauch",
               "brombeerstraeucher", "durchkommen"}),
    "Die Brombeerstraeucher wachsen wild verfilzt und abweisend stachlig"
    " zwischen den Baeumen. Da ist kein Durchkommen, deshalb fuehrt der"
    " Weg auch zwischen den Hecken durch.");
  AddDetail( ({"brombeere", "brombeeren"}),
    "Du kannst keine einzige Brombeere in den Straeuchern erkennen.");
  AddDetail( ({"himbeerhecke", "himbeerhecken", "himbeerstrauch",
               "himbeerstraeucher", "stellen"}),
    "Am Wegrand wuchern an sonnigen Stellen einige Himbeerstraeucher. Um"
    " die Straeucher herum summt und brummt es, weil viele Insekten die"
    " Himbeerblueten als Nektarquelle nutzen.");
  AddDetail( ({"rand", "wegrand"}),
    "Der Wegrand ist der Rand des Weges. Dort wuchern viele Straeucher.");
  AddDetail( ({"himbeere", "himbeeren"}),
    "Du kannst keine einzige Himbeere in den Straeuchern erkennen.");
  AddDetail( ({"beere", "beeren"}),
    "Welche Beeren meinst Du? Himbeeren oder Brombeeren.");
  AddDetail( ({"bluete", "blueten", "himbeerbluete", "himbeerblueten"}),
    "Die Himbeerstraeucher bluehen gerade, und die Blueten werden von"
    " vielen Insekten als Nektarquelle genutzt.");
  AddDetail( ({"nektarquelle", "nektar"}),
    "Du sehnst Dich danach, wieder einmal koestlichen Nektar zu kosten,"
    " allein: hier ist die Nektarquelle ueberhaupt, die Blueten der"
    " Himbeerstraeucher, und Du wuesstest nicht, wie Du den Nektar"
    " erreichen koenntest.");
  AddDetail( ({"insekt", "insekten", "kerbtier", "kerbtiere"}),
    "Rund um den Himbeerstrauch summt und brummt es: Du erkennst Hummeln,"
    " Bienen, Muecken, Schmetterlinge und viele andere Kerbtiere.");
  AddDetail( ({"hummel", "hummeln"}),
    "Ein paar dicke Hummeln brummen behaebig im Zweiggewirr der"
    " Himbeerstraeucher von Bluete zu Bluete.");
  AddDetail( ({"zweiggewirr"}),
    "Selbst wenn Du eines der vielen Insekten fangen wolltest: Du"
    " koenntest es nicht, so dicht wachsen die dornigen Zweige der"
    " Himbeerstraeucher.");
  AddDetail( ({"biene", "bienen"}),
    "Auf vielen Himbeerblueten summen Bienen emsig nektarsammelnd herum.");
  AddDetail( ({"muecke", "muecken", "mueckenschwarm", "schwarm", 
      "fliegen", "fliegenschwarm"}),
    "Nervend summt ein Mueckenschwarm durch die Zweige des"
    " Himbeerstrauchs.");
  AddDetail( ({"schmetterling", "schmetterlinge"}),
    "Im Sonnenschein flattern bunte Schmetterlinge ueber dem"
    " Himbeerstrauch.");
  AddDetail( ({"sonnenschein", "sonne", "schein"}),
    "Die Sonne scheint zwischen den Baeumen auf den Weg.");
  AddDetail( ({"wespe", "wespen"}),
    "Zwischen all den anderen Insekten lauern auch ein paar Wespen auf"
    " Beute: waeren sie nicht so klein, wuerden sie Dich bestimmt auch"
    " angreifen. Beruhigt stellst Du fest, dass sie sich aber nur an"
    " Muecken und Bienen wagen.");
  AddDetail( "abstand",
    "Nicht zu weit voneinander entfernt, aber auch nicht zu nahe"
    " beieinander. Du bleibst trotzdem lieber auf dem Weg.");
  AddDetail( ({"ast", "aeste"}),
    "Normale, gut gewachsene Aeste.");
  AddDetail( ({"luft", "lueftchen"}),
    "Nichts aussergewoehnliches, die Luft hier. Aber es riecht gut,"
    " und Du fuehlst Dich wohl bei dem lauen Lueftchen, das hier"
    " weht.");
  AddDetail( ({"steg", "bach", "baechlein"}),
    "Im Osten siehst Du einen kleinen Steg, der ueber einen Bach "
    "fuehrt.");

  AddSmell( ({DEFAULT_SMELL, "luft", "lueftchen"}),
    "Die Luft riecht gut hier. Du fuehlst Dich wohl. Vor allem die "
    "Himbeerblueten duften wunderbar.");
  AddSmell( ({"blueten", "bluete", "himbeerbluete", "himbeerblueten"}),
    "Die Himbeerblueten duften wunderbar. Liebend gern wuerdest Du eine "
    "Bluete abpfluecken, aber Du willst den Bienen ja nicht ihre "
    "Nahrung wegnehmen.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Brummen und Summen der Insekten.");
  AddSound( ({"insekt", "insekten", "kerbtier", "kerbtiere", "wespe",
              "wespen", "muecke", "muecken", "biene", "bienen", "hummel",
              "hummeln", "summen", "brummen"}),
    "Die Insekten sind wohl der Grund fuer das Brummen und Summen.");

  AddCmd( ({"pfluecke", "pflueck"}), "pfluecken");
  AddCmd( ({"bastel", "bastle", "bastl"}), "basteln");
  AddCmd( ({"schneide", "schneid"}), "abschneiden");

  AddItem( NPC "fuchs", REFRESH_DESTRUCT);
  AddItem( NPC "karren", REFRESH_DESTRUCT);

  AddExit(ED5, "./0102.lpc");
  AddExit("osten", WESTWEG_SILBERWALD);
}

void init()
{
  object ob;
  ::init();
  while( ob=deep_present("halsband 10", TP) )
    ob->remove();
}

int pfluecken(string str)
{
  notify_fail("Das willst Du doch sicher nicht pfluecken!\n");
  if( !str) return 0;
  if( member( ({"blueten", "bluete", "himbeerbluete", "himbeerblueten"}),
       str)!=-1)
  {
    write(BS("Du willst doch nicht den Bienen und Hummeln ihre Nahrung "
          "wegnehmen wollen? Warte doch lieber, bis aus den Blueten "
          "leckerer Himbeeren geworden sind, mit denen kannst Du sicher "
          "mehr anfangen als mit Blueten."));
    return 1;
  }
  if( member( ({"beere", "beeren", "himbeere", "himbeeren"}),
       str)!=-1)
  {
    write(BS("Noch sind sie nur Himbeerblueten. Die brauchen noch einen "
             "ganzen Sommer lang, bis sie sich in Beeren verwandeln."));
    return 1;
  }
  return 0;
}

int basteln(string str)
{
  notify_fail("Was willst Du basteln?\n");
  if( str == "pfeife" || str == "pfeifchen" )
    notify_fail("Dazu musst Du zuerst einen Haselzweig abschneiden.\n");
  return 0;
}

int abschneiden(string str)
{
  string was, mit;
  object ob;
  notify_fail("Was willst Du abschneiden?\n");
  if( !str ) return 0;
  if( str == "zweig ab" || str == "zweige ab" )
  {
    notify_fail("Welchen Zweig willst Du abschneiden?\n");
    return 0;
  }
  if( str == "haselzweig ab" || str == "haselzweige ab" )
  {
    notify_fail("Mit was willst Du den Haselzweig abschneiden?\n");
    return 0;
  }
  if( sscanf( str, "%s mit %s ab",was, mit)!=2 )
  {
    notify_fail("Was willst Du mit wem abschneiden?\n");
    return 0;
  }
  if( was== "zweig" || was == "zweige")
  {
    notify_fail("Welchen Zweig willst Du abschneiden?\n");
    return 0;
  }
  if( was == "haselzweig" || was == "haselzweige" )
  {
    if( !deep_present("\nhaselzweig",TP) && !deep_present("\nrattenpfeife",TP) )
    {   
      if( ob=present( mit, TP) )
      {
        if( ob->QueryProp(P_WIELDED) )
        {
          if( ob->QueryProp(P_WEAPON_TYPE)==WT_KNIFE )
          {
            if( ob->id("taschenmesser") )
            {
              if( ob->QueryProp(P_WC)>=90 )
              {
                write("Du schneidest einen kleinen Haselzweig ab.\n");
                say( CAP(TPN) + " schneidet einen kleinen Haselzweig ab.\n");
                CLONE( OBJ "zweig", TP);
                return 1;
              }
              else
                notify_fail("Bei diesem Messer ist die Schneide zu klein.\n");
            }
            else
              notify_fail(CAP(ob->name(WER,1))+ " ist nicht scharf genug.\n");
          }  
          else
            notify_fail("Ein Messer waere besser zum Abschneiden geeignet.\n");
        }
        else
          notify_fail("Du solltest "+ob->name(WEN,1)+" erst einmal zuecken.\n");
      }
      else
        notify_fail( CAP(mit)+"? Sowas hast Du doch gar nicht!\n");
    }
    else
      notify_fail( "Aber Du hast doch schon ein Pfeifchen.\n");
  }
  return 0;
}
