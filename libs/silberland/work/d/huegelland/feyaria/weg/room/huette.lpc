#pragma strong_types

#include <properties.h>
#include <moving.h>

#include "../directions.h"
#include "../cheasy_defs.h"

inherit "std/room";

int kaese;

void reset()
{
  ::reset();
  tell_room(TO, "Feyaria kommt vorbei und kocht ein neues Kaesefondue.\n");
  kaese=random(3)+1;
}

void create() 
{
  ::create();

  SetProp(P_LIGHT, 1);  // es ist hell -- naja ein bisschen
  SetProp(P_INDOORS, 1);// es hat ein Dach
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:22, ENV_TERRAIN:TT_HOUSE])); // angenehm mwarm
  SetProp(P_NOMAGIC, 1);// und nix is mit zaubern.

  SetProp(P_INT_SHORT, "In einer Bergwacht-Huette");
  SetProp(P_INT_LONG,
   BS("Die Blockhuette ist aus einfachen, unbehauenen Baumstaemmen gezimmert"
    " und hat nur einen Raum. Ein Fenster neben der Tuer beleuchtet den Raum"
    " nur schwach. In einer Ecke steht ein kleiner Tisch mit zwei Hockern."
    " In einem Kamin flackert ein kleines Feuer, ueber dem Feuer haengt ein"
    " Kessel an einem Haken. Ein Regal enthaelt allerlei Utensilien, an"
    " Haken in der Wand haengen die unterschiedlichsten Geraetschaften. An"
    " einer Wand stehen sechs Betten."));

  AddDetail( ({"bett", "betten"}),
    "In den Betten uebernachten die Bergwacht-Maenner und die Wanderer, die "
    "hier vom Einbruch der Dunkelheit ueberrascht werden.");
  AddDetail( ({"decke", "holzdecke"}),
    "Eine ganz solide Holzdecke.");
  AddDetail( ({"kiefer", "kiefern", "fichte", "fichten"}),
    "Aus den unbehauenen Staemmen der Kiefern und Fichten wurde diese "
    "Huette gebaut. Darum nennt man sie ja auch Blockhuette.");
  AddDetail( ({"huette", "bergwachthuette", "bergwacht-huette", 
               "blockhuette"}),
    "Du stehst mitten drinnen.");
  AddDetail( ({"holz", "fichtenholz", "kiefernholz"}),
    "Es handelt sich hauptsaechlich um Kiefern- und Fichtenholz.");
  AddDetail( ({"baumstaemme", "baumstamm", "stamm", "staemme"}),
    "Ganz normale Baumstaemme, wahrscheinlich von einer Kiefer oder"
    " Fichte.");
  AddDetail( ({"wand", "waende"}),
    "Die Waende sind unverputzt und naturbelassen, die grob behauenen"
    " Baumstaemme haben eine ungleichmaessige aber doch anheimelnde"
    " Oberflaeche.");
  AddDetail( ({"oberflaeche", "oberflaechen"}), 
    "All die verschiedenen Oberflaechen hier haben eines gemeinsam: Sie "
    "sehen blitzblank geschrubbt und peinlich sauber aus. Trotzdem strahlt "
    "das Holz eine heimelige Waerme aus.");
  AddDetail( ({"boden", "fussboden"}),
    "Blitzblank gescheuerte Holzdielen, die leise knarren, wenn Du Dich"
    " bewegst.");
  AddDetail( ({"dielen", "holzdielen"}),
    "Sie sind so sauber, dass Du davon essen koenntest.");
  AddDetail( ({"raum", "zimmer", "stube"}), QueryProp(P_INT_LONG) );
  AddDetail("fenster",
    "Wie alles hier ist das Fenster blitzblank geputzt.");
  AddDetail( ({"tisch", "suppenteller", "suppe", "teller"}),
    "Auf dem Tisch siehst Du noch einige halbleere Suppenteller. Die"
    " Bewohner sind wohl sehr ueberhastet aufgebrochen, denn die Suppe ist"
    " noch nicht kalt.");
  AddDetail("hocker",
    "Stabile, dreibeinige Hocker ohne Rueckenlehne.");
  AddDetail( ({"bein", "beine"}),
    "Die Hocker haben drei Beine.");  
  AddDetail("kamin",
    "Im Kamin flackert ein kleines Feuer, ueber dem ein Kessel leise"
    " blubbert.");
  AddDetail(({"feuer", "waerme"}),
    "Das Feuer ist schon fast heruntergebrannt, spendet aber trotzdem"
    " angenehme Waerme hier drinnen.");
  AddDetail("kessel",
    "Du schaust neugierig in den Kessel und entdeckst... \n"
    "... nein ... das kann doch nicht sein! \n"
    "Unglaeubig wirfst Du einen zweiten Blick in den Kessel. \n"
    "Kein Zweifel. Das ist das beruehmte Kaesefondue, das manchmal kostenlos\n"
    "an x-beliebige Bloedmaenner verteilt wird.\n");
  AddDetail( ({"bloedmann", "bloedmaenner"}),
    "Nimm einen Spiegel und schau hinein. Dann siehst Du den einzigen "
    "Bloedmann hier im Raum.");
  AddSpecialDetail( ({"kaese", "fondue", "kaesefondue"}), "fondue");
  AddDetail("haken",
    "Du entdeckst gleich mehrere Haken: Einen im Kamin, an dem ein Kessel"
    " haengt, und einige an der Wand, an welchen die unterschiedlichsten"
    " Geraetschaften haengen.");
  AddDetail( ({"regal", "utensilien", "mull", "verbandmull", "gips",
      "schienen", "armschienen", "beinschienen", "desinfektionsmittel",
      "mittel", "serum", "blutserum"}),
    "Du siehst die unterschiedlichsten Utensilien im Regal:"
    " Verbandmull, Gips, Arm- und Beinschienen, Desinfektionsmittel,"
    " Blutserum, ... kurz und gut: alles was man zum verarzten mehr"
    " oder weniger schwer Verletzter braucht.");
  AddDetail( ({"geraet", "geraete", "geraetschaften", "seil", "kletterseil"
      "gurte", "abseilgurte", "kletterhaken", "eispickel", "pickel", "seile", 
      "steigeisen", "lawinensonden", "rettungsgeraet", "seil", "kletterseile"}),
    "An einigen Haken in der Wand haengen Kletterseile, Abseilgurte,"
    " Kletterhaken, Eispickel, Steigeisen, Lawinensonden und vielerlei"
    " anderes Rettungsgeraet, dessen Sinn Du nicht erkennen kannst.");
  AddDetail(({"ecke", "ecken"}),
    "In einer Ecke steht ein Tisch mit zwei Hockern.");
  AddDetail("tuer",
    "Die Tuer ist nur angelehnt, Du kannst die Huette jederzeit verlassen.");
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach einer leckeren Speise.");
  AddSmell( ({"kaese", "fonue", "kaesefondue", "speise"}),
    "Das Kaesefondue riecht wirklich lecker. Das Wasser laeuft Dir im Mund "
    "zusammen.");
  kaese=random(3)+1;

  AddCmd( "nimm", "get");
  AddCmd( "iss", "essen");

  AddExit ( "raus", "./0208" );

}

int get(string str) 
{
  if ((str == "fondue") || (str == "kaese") || (str == "kaesefondue")) 
  {
    MSG("AUA! Das ist ja kochend heiss! Du laesst das Fondue lieber stehen.",
      " grapscht ins Fondue.");
    TP->reduce_hit_point(2);
    return 1;
  }
  notify_fail("Dein schlechtes Gewissen laesst das nicht zu.\n");
  return 0;
}

int essen(string str) 
{
  notify_fail("Was willst Du essen?\n");
  if( str == "fondue" || str == "kaese" || str == "kaesefondue" )
  {
    if( kaese<=0 )
    {
      write("Leider ist nichts mehr von dem Fondue uebrig. :(\n");
      return 1;
    }
    if( --kaese==0 )
    {
      MSG("Du isst die letzten Reste des Kaesefondues auf.",
        " isst das Kaesefondue zusammen. Fuer Dich bleibt wieder mal nichts"
        " uebrig. Argl! :-(");
      TP->heal_self( 10+random(10) );
    }
    else
    {
      MSG("Du isst etwas von dem Kaesefondue und fuehlst Dich ziemlich "
        "gestaerkt.",
        " isst etwas vom Kaesefondue.");
      TP->heal_self( 15+random(15) );
    }
    return 1;
  }
  if(str=="suppe" || str=="suppenteller")
  {
    write(BS("Du kostest von der Suppe und merkst sofort, warum sie nicht "
          "aufgegessen wurde. IGITT!!"));
    return 1;
  }
  if(str=="von boden" || str=="von holzdielen" || str=="holzdielen" || 
      str=="boden")
  {
    write("So woertlich war das auch nicht gemeint! :)\n");
    return 1;
  }
  return 0;
}

string fondue()
{
  string str;
  str= "Das Kaesefondue schaut richtig lecker aus und duftet auch sehr gut.\n";
  switch( kaese )
  {
    case 3: str+="Der Kessel ist randvoll mit leckerem Kaesefondue.\n";
            break;
    case 2: str+="Der Kessel ist ziemlich voll mit leckerem Kaesefondue.\n";
            break;
    case 1: str+="Im Kessel ist noch etwas Kaesefondue.\n";
            break;
    case 0: str+="Im Kessel sind nur noch spaerliche Reste des Kaesefondues.\n";
            break;
  }
  return str;
}


