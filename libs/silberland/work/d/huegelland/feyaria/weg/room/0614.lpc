#pragma strong_types

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_WALDWEG;
  SetProp(P_INT_LONG,
    BS("Hier macht der Waldweg einen grossen Bogen von " + CAP(ED7) +
      " nach " + CAP(ED8) + ". Im " + CAP(ED7) + " geht es steil bergauf. "
      "Im "+CAP(ED3)+ " befindet sich ein riesiges, weich gepolstertes Nest. "
      "Dort leben sicher auch riesige Tiere."));
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:17, ENV_TERRAIN: TT_FOREST]));
  
  CD_WALD;
  CD_WALDWEG;
  CD_WALDBODEN;

  AddDetail( ({"tiere", "baer", "baeren"}),
    "Bei diesen Tieren koennte es sich um Baeren handeln.");  
  AddDetail( ({"bogen", "kurve"}),
    "In weitem Bogen fuehrt der Weg weiter den Berg hinauf. Du erkennst"
    " so etwas wie ein Nest neben dem Weg.");
  AddDetail( ({"nest"}),
    "Ein riesiges, weich gepolstertes Nest ist direkt neben dem Weg. Du"
    " koenntest Dich ohne Probleme darin schlafen legen. Im "+ CAP(ED3) +
    " kannst Du es betreten.");
  AddDetail( ({"berg", "hang"}),
    "Der Berghang ist bis auf ein paar Krueppelkiefern und niedrige"
    " Graeser fast kahl, ueberall ist der blanke Fels sichtbar.");
  AddDetail( ({"gras", "graeser"}),
    "Es wachsen nur wenige Graeser hier.");
  AddDetail( ({"fels"}),
   "Unter dem kargen Boden ist der blanke Fels sichtbar.");
  AddDetail( ({"kiefer", "kiefern", "krueppelkiefern"}),
    "Die Kiefern wachsen voellig verkuemmert entlang des Bodens. Sie"
    " erreichen kaum die Groesse eines Busches im Tal.");
  AddDetail( ({"boden", "weg", "pfad", "felsboden"}),
    "Der Weg ist mehr ein Pfad in dieser Hoehe, er ist sehr schwer auf"
    " dem blanken Felsboden auszumachen.");
  AddDetail( ({"hoehe"}),
    "Du befindest Dich weit oben ueber dem Tal, fast schon auf dem Pass.");
  AddDetail( ({"tal"}),
    "Weit entfernt liegt das Tal im Dunst unter Dir. Gruen schimmern die"
    " Wiesen herauf. Inmitten des Tals liegt friedlich ein blauer See.");
  AddDetail( ({"dunst", "wiese", "wiesen", "see"}),
    "Du bist viel zu weit ueber dem Tal, um noch Einzelheiten ausmachen"
    " zu koennen. Vielleicht solltest Du naeher herangehen, um mehr zu"
    " sehen.");
  AddDetail( ({"einzelheiten"}),
    "Huii.. Nein, hier ist kein Zaubertrank versteckt. Aetsch.");
  AddDetail( ({"zaubertrank"}),
    "ARGL. Ich sagte doch bereits: KEIN ZAUBERTRANK. Also nochmal fuer"
    " Begriffsstutzige: Nix. Rien. Nada. Njet. Und gib Dich damit"
    " zufrieden, oder ich muesste unangenehm werden.");
  AddDetail( ({"aetsch"}),
    "Musst Du aber neugierig sein... gibs auf, hier ist kein ZT.");
  AddDetail( ({"zt"}),
    "Zwergentoeter? Zwetschgentrunk? Zittertalg? Was denn nun?");
  AddDetail( ({"zwergentoeter", "zwetschgentrunk", "zittertalg"}),
    "Haeh? Wovon redest Du ueberhaupt?");
  AddDetail( ({"himmel", "sonne", "wolke", "wolken"}),
    "Wie immer: Eine Sonne, ein paar Wolken, ansonsten blauer Himmel.");
  AddSpecialDetail( ({"argl", "begriffsstutzige", "begriffsstutzig", "nix",
    "rien", "nada", "njet", "probleme", "details", "nichts"}),
    "Das Untersuchen Solcher Sinnlosen Details Bringt Doch Nichts!");
  AddSpecialDetail( ({"das", "untersuchen", "solcher", "sinnlosen", 
      "bringt", "doch", "kein", "haeh", "wovon",
     "huii", "nein", "also", "was", "ich", "also", "musst", "vielleicht",
     "weit", "sie", "busches", "eine", "goettliche", "strafe", "trifft",
     "unvorbereitet", "ist", "die", "fuer", "untersuch", "faulheit",
     "jetzt", "wirst", "gier", "nach", "forscherpunkten", "bestraft"}),
    "NoScript");

  AddSound( DEFAULT_SOUND,
    "Du hoerst eine leises Brummen.");
  AddSound( ({"brummen", "nest"}),
    "Das Brummen kommt aus dem Nest im "+ CAP(ED3) + ". Du kannst sogar "
    "unterschiedliche Brummlaute unterscheiden. Du kannst sicher nicht "
    "so schoen brummen.");
  AddSound( ({"laute", "brummlaute"}),
    "Du kannnst helle, tiefe und ganz tiefe Brummlaute erlauschen. Was fuer "
    "ein Lebewesen wohl solche Brummlaute von sich gibt?");
  AddSound( ({"lebewesen"}),
    "Welchem Lebewesen genau?");
  AddSound( ({"baer", "braunbaer",}),
    "Du glaubst also, das Brummen kommt von einem Baer? Dann geh doch nach "+
    CAP(ED3) + " und sieh nach, ob das stimmt.");
  AddSound( "brummbaer",
    "Ja, ein Brummbaer kann sicher solche Laute machen :).");
  AddSound( ({"helle", "helle laute", "helle brummlaute",
              "hellen brummaluten", "hellen lauten"}),
    "Die helle Brummlaute stammen wohl von einem kleinen Baer.");
  AddSound( ({"tiefe", "tiefe laute", "tiefe brummlaute", "baerenmutter",
              "mutter", "tiefen lauten", "tiefen brummlauten"}),
    "Die tiefen Brummlaute stammen wohl von der Baerenmutter.");
  AddSound( ({"ganz tiefe", "ganz tiefe laute", "ganz tiefe brummlaute",
              "baerenvater", "vater"}),
    "Die ganz tiefen Brummlaute stammen wohl vom Baerenvater.");

  AddCmd( ({"brumm", "brumme"}), "brummen");

  SetProp(P_HIDE_EXITS, ({ED7, ED8}) );
  AddExit( ({ED7, ED7OB}), "nach "+CAP(ED7OB)+"#./0514.lpc" );
  AddExit( ({ED8, ED8U}), "nach "+CAP(ED8U)+"#./0513.lpc" );
  AddExit(ED3, "./0714.lpc" );
}

int brummen(string str)
{
  notify_fail("Wie willst Du brummen?\n");
  if( !str ) return 0;
  if( str== "wie ein baer" || str == "wie baer" || str == "baerig")
  {
    write( "Du brummst wie ein Baer. Du machst das wirklich toll!\n");
    say( TPN+ " brummt wie ein Baer.\n");
    return 1;
  }
  return 0;
}

