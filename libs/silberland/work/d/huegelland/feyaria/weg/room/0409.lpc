#pragma strong_types

#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <wizlevels.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./schlucht.h"

#define SCHILD_TEXT \
"+----------------------------+\n"\
"|   Wegen Bauarbeiten ist    |\n"\
"|   der Weg in das Hochtal   |\n"\
"|      G E S P E R R T.      |\n"\
"|                        gez.|\n"\
"|   Die SilberLand Strassen-,|\n"\
"|    Wege-, Feld-, Wald- und |\n"\
"| Wiesen-Verwaltungsbehoerde.|\n"\
"+----------------------------+\n"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:12, ENV_TERRAIN: TT_MOUNTAIN]));
  P_INT_SHORT_SCHLUCHTPFAD;
  SetProp(P_INT_LONG,
    BS("Du stehst knapp oberhalb eines Hochtals weit ueber dem " N_SEE ". Aus"
      " dem Hochtal fliesst ein Bach, der sich in einem Wasserfall in den "
      N_SEE " weit unter Dir ergiesst. Der Weg macht hier wieder eine"
      " Spitzkehre von " + CAP(ED6) +" nach " + CAP(ED7) + ". Nach "
      + CAP(ED3) + " zweigt ein Fusspfad ins Hochtal ab, neben dem ein Schild"
      " in den Boden gerammt ist. Im " + CAP(ED6) + " siehst Du einen Tunnel,"
      " der sich durch einen Felspfeiler bohrt."));

  AddDetail("schild",
    SCHILD_TEXT);
  AddReadDetail("schild",
    SCHILD_TEXT);
  AddDetail( ({"hochtal", "tal", "bach", "baechlein", "wasserfall"}),
    "Ein stilles Hochtal fuehrt hier in Richtung " N_BERG ". Im Tal "
    "fliesst ein kleines Baechlein, das ueber die Felswand in einem "
    "wunderschoenen Wasserfall bis in den " N_SEE " stuerzt.");
  AddDetail( ({"see", N_SEE}),
    "Tief unter Dir glaenzt der " N_SEE " im Tal, in den im " + CAP(ED2) + 
    " ein Wasserfall stuerzt.");
  AddDetail( "wasser",
    "Hier gibt es viel Wasser, sowohl im Wasserfall als auch im See.");  
  AddDetail( ({"berg", N_BERG}),
    "Weit entfernt kannst Du nur den schneebedeckten Gipfel des " N_BERG 
    "s erkennen. Du solltest schon ein wenig weiter gehen, um mehr zu "
    "erkennen.");
  AddDetail( ({"tunnel", "eingang", "tunneleingang"}),
    "Im " +  CAP(ED6) + " bohrt sich der Pfad durch einen kurzen Tunnel,"
    " der gerade hoch und breit genug ist, einen der Haendlerkarren"
    " durchzulassen, aber nicht genug Platz fuer zwei bieten wuerde.");
  AddDetail( ({"fusspfad"}),
    "Nach " + CAP(ED3) + " zweigt hier ein schmaler Fusspfad in ein"
    " Hochtal ab, der zur Zeit jedoch nicht begehbar ist.");
  AddDetail( ({"pfeiler", "felspfeiler"}),
    "Der Felspfeiler ist von den vielen Muren ganz schartig geschlagen."
    " Scheinbar stuerzt das Geroell dort so regelmaessig herab, dass man"
    " lieber einen Tunnel durch den Fels schlug. Du kannst tatsaechlich"
    " noch zerschlagene Reste eines uralten Pfades erkennen.");
  AddDetail( ({"reste", "pfad", "spuren", "scharten", "geroell"}),
    "Der uralte Pfad fuehrt vom Tunneleingang um den Felspfeiler herum."
    " Er ist voellig zertruemmert und stellenweise vollstaendig"
    " weggeschlagen, dort kannst Du nicht weitergehen.");
  AddSound(({DEFAULT_SOUND,"rauschen", "wasserfall"}),
    "Du hoerst das Rauschen des Wasserfalls.");  
  CD_SCHLUCHTPFAD;

  AddCmd( ({"ruf", "rufe"}), "rufen");
  
  SetProp(P_HIDE_EXITS, ({ED7}) );
  AddExit( ED6, "./0310.lpc" );
  AddExit( ({ED7, ED7U}), "nach "+CAP(ED7U)+"#./0309.lpc" );
}

int rufen(string str) 
{
  object *helm;
  int chars;
  
  if (str == "hilfe" || str == "um hilfe") 
  {
    write("Du rufst um Hilfe und die Bergwacht rettet Dich aus der "
             "drohenden Geroellawine.\n");
    TP->reduce_hit_point(2*TP->QueryProp(P_LEVEL) );
    TP->move(ROOM "huette", M_GO, "", "wird von der Bergwacht gerettet",
             "wird von der Bergwacht hereingetragen");
    return 1;
  }
  chars=strlen(str)/2;
  if (chars<4) chars=4;
  if(!IS_SEER(this_player()))  // Seher++ duerfen kostenfrei rufen
  {
    if (TP->QueryProp(P_SP) <(chars+20)) 
    {
      write("Du must erst wieder magische Kraefte sammeln.\n");
      write("Tip: Benutz doch mal die Kanaele (Hilfe dazu mit 'hilfe kanaele').\n");
      return 1;
    }
    TP->restore_spell_points(-chars - 20);
  }
  domainshout(TPN+ " ruft: "+ str+"....*RUMMPEL...KRACH...RUMMS*\n");
  write("Durch Dein Rufen loest Du eine Geroellawine aus.\n");
  say( TPN + " loest durch " + TPPP(NEUTER, WEN, SINGULAR) + " Rufen eine "
       "Geroellawine aus.\n");
  SetProp(P_KILL_NAME, "Eine Geroellawine");
  helm=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_HELMET); 
  if( sizeof(helm) && objectp(helm[0]) )
  {
    if( helm[0]->QueryProp(P_NAME)=="Kletterhelm" )
    {
      write("Zum Deinem Glueck traegst Du einen Kletterhelm.\n");
    }
    else
    {
      write("Dein Helm beschuetzt Deinen Kopf gegen den Steinschlag.\n");
      TP->do_damage( 10+random(60)-helm[0]->QueryProp(P_AC)*3 );
    }
  }
  else
  {
    write("Aua! Die Steine prasseln auf Deinen ungeschuetzten Kopf.\n");
    TP->do_damage( 10+random(60) );
  }  
  return 1;
} 
