#pragma strong_types

#include <properties.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./schlucht.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:8, ENV_TERRAIN: TT_CAVE]));
  SetProp(P_INT_SHORT, "In einem Tunnel");
  SetProp(P_INT_LONG,
    BS("Du bist in einem Tunnel. Es ist sehr dunkel hier. Der Fels fuehlt "
       "sich stabil und fest an.") );

  AddDetail( ({"tunnel", "fels", "stein", "wand", "waende", "boden", "decke"}),
    "Der Fels fuehlt sich stabil und fest an.");

  AddCmd( ({"ertaste", "ertast", "tast", "taste", "fuehl", "fuehle"}), "feel");

  AddExit(ED7, "./0209.lpc" );
  AddExit(ED2, "./0409.lpc" );
}

int feel(string str) 
{
  if ((str == "wand") || (str == "tunnelwand") || str == "biegung" || 
       str == "waende") 
  {
    write(BS("Du fuehlst, dass die Tunnelwand mitten im Tunnel von "
     + capitalize(ED7) + " nach " + capitalize(ED2) + " abbiegt."));
    return 1;
  }
  else if ((str == "boden") || (str == "weg") || (str == "pfad")) 
  {
    write(BS("Der Boden fuehlt sich kuehl und feucht an."));
    return 1;
  }
  else if ((str == "decke") || (str == "himmel")) 
  {
    write(BS("Die Decke fuehlt sich feucht und kuehl an."));
    return 1;
  }
  else if (str == "fels" || str == "tunnel") 
 {
    write(BS("Der Fels fuehlt sich kuehl und feucht an."));
    return 1;
  }
  else if(str=="ausgang" || str=="ausgaenge")
  {
    write(BS("Ausgaenge gibt es nach "+ED7+" und nach "+ED2+"."));
   return 1;
  } 
  notify_fail("Wonach willst Du denn tasten?\n");
  return 0;
} 
