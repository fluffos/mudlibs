#pragma strong_types

#include <properties.h>
#include <ansi.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_WALDWEG;
  SetProp(P_INT_LONG,
    BS("Du wanderst auf einem Waldweg. Ein weites Tal oeffnet sich im " +
      capitalize(ED7) + ", im " + capitalize(ED4) + " schimmern Huegel durchs"
      " Blaetterdach. Im " + capitalize(ED3) + " kann man den dichten Wald "
      "betreten." ) );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN: TT_FOREST]));
  SetProp(P_LIGHT, 1);

  CD_WALDBODEN;
  CD_WALDWEG;
  CD_WALD;
  AddDetail( "huegel",
    "Du erkennst kaum etwas, so dicht ist das Blaetterdach hier.");
  AddDetail( ({"blaetter", "blaetterdach", "dach"}),
    "Kaum eine Luecke laesst das Sonnenlicht hier durch das Blaetterdach"
    " dringen. ");
  AddDetail( "luecke",
    "Im " + CAP(ED4) + " erkennst Du einige Huegel.");
  AddDetail( ({"licht", "sonne", "sonnenlicht", "daemmerlicht"}),
    "Angenehmes lindgruenes Daemmerlicht herrscht hier unter dem"
    " Blaetterdach.");
  AddDetail( ({"tal", ED7, "stellen", "verlauf"}),
    "Das Tal ist voellig mit Wald zugewachsen, nur an wenigen Stellen sind"
    " die Blaetter nicht zu dicht, um den weiteren Verlauf des Wegs zu"
    " erkennen.");
  AddDetail( ({ED3, "wald"}),
      "Im " + capitalize(ED3) + " kann man den dichten Wald betreten. "
      "Allerdings solltest Du vorsichtig sein, damit Du Dich dort nicht "
      "verirrst.");

  AddSound( DEFAULT_SOUND,
    "Hier ist es angenehm ruhig.");
  AddSmell( ({DEFAULT_SMELL, "duft", "waldduft"}),
    "Du laesst den beruhigenden Waldduft in Deine Lungen einstroemen.");

  AddItem( NPC "reh", REFRESH_DESTRUCT);

  AddExit(ED4, "./0203.lpc");
  AddExit(ED1, "./0101.lpc");
  AddExit(ED3, ([ EX_DEST: WEG_WALD, EX_TESTFUNC: "exit_wald"]) );
}

int exit_wald()
{
  if (TP && !query_once_interactive(TP))
    return 0;
  if (TP->QueryProp(P_LEVEL) < 15)
  {
    write(BS("Du fuerchtest, dass Du Dich in diesem Wald verlaufen koenntest, "
        "darum beschliesst Du, dort nicht hineinzugehen."));
    return 0;
  }
  DB(ANSI_GREEN + TPN + " betritt den Wald!" + ANSI_NORMAL + "\n");
  call_other("/d/huegelland/feyaria/wald/room/waldmaster", "check_wald");
  write("Du betrittst den dichten Wald, hoffentlich verirrst Du Dich nicht!\n");
  return 1;
}
