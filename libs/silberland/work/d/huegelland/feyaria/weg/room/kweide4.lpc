#include "../def.h"
#include "./kuhweide.h"

inherit "/std/room";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, P_INT_SHORT_KUHWEIDE);
  SetProp(P_INT_LONG, BS(
    "Du stehst mitten auf einer Kuhweide inmitten einer Huegellandschaft. "
    "Das Gras am Boden ist saftig gruen - das ideale Viehfutter. Die Weide "
    "ist durch einen Zaun abgegrenzt, damit die Kuehe die Weide nicht "
    "verlassen koennen.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:17, ENV_TERRAIN:TT_HILL]) );

  DET_KUHWEIDE;

  AddExit("westen", "./kweide3");  
  AddExit("nordwesten", "./kweide1");
  AddExit("suedwesten", "./kweide6");

  AddItem( NPC "kuh", REFRESH_DESTRUCT );
}


