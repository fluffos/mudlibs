#pragma strong_types

#include <properties.h>
#include <moving.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./huegel.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_HUEGEL;
  SetProp(P_INT_LONG, BS(
    "Du stehst knapp unter dem Gipfel eines Huegels. Im " + capitalize(ED3) 
    + " liegt eine Hochflaeche knapp unter Dir. Im " + capitalize(ED8) +
    " siehst Du einen Wasserfall, der Weg scheint unter diesem"
    " durchzufuehren. Im " + capitalize(ED6) + " windet sich der Pfad an"
    " der Huegelflanke entlang.") );
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_HILL]));

  CD_HUEGEL; /* Details fuer den Huegel, definiert in huegel.h */
  CD_HUEGEL2;
  CD_HUEGEL3;
  CD_HUEGEL4;

  AddDetail( ({"wasserfall", "fall"}),
    "Der Wasserfall liegt im " + capitalize(ED8) + ". Du solltest"
    " naeher rangehen, um genaueres zu erkennen.");
  AddDetail( ({"huegelflanke", "flanke"}),
    "Der Pfad windet sich an der Huegelflanke entlang. Nach " + CAP(ED5) +
    " faellt sie steil ab. Pass auf, dass Du dort nicht hinunter rutschst.");

  AddCmd( ({"rutsch", "rutsche"}), "slide");

  AddItem( NPC "huegelkatze", REFRESH_DESTRUCT);

  AddExit(ED6, "./0206.lpc");
  AddExit(ED8, "./0204.lpc");
}

int slide(string str)
{
  if (str == "hang" || str == "aus" || str == "runter" || str== "hinunter"
      || str == ED5 || str == ("nach "+ ED5) ) 
  {    
    write("Du setzt Dich auf Deinen Hosenboden und rutschst den Abhang "
    "hinunter.\n");      
    TP->move(ROOM "0307.lpc", M_GO, "den Abhang hinunter nach "+CAP(ED5),
              "rutscht", "rutscht auf "
              +TP->QueryPossPronoun(MALE, WEM, SINGULAR)+" Hosenboden herein");
      return 1;
  }
  notify_fail("Wohin willst Du denn rutschen?\n");
  return 0;
}
