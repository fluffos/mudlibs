#pragma strong_types

#include <properties.h>
#include <language.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"
#include "/d/huegelland/feyaria/osterhase/oh.h"

inherit "std/room";
inherit "/gilden/bardengilde/obj/quest/reiselied_functions";

void create()
{
  ::create();

  SetProp(P_INT_SHORT,"Ein schmaler Waldpfad");
  SetProp(P_INT_LONG, BS(
    "Du befindest Dich auf einem schmalen Waldpfad der von "+ CAP(ED4)+ 
    " nach "+ CAP(ED8)+ " steil bergauf fuehrt. Die Tannen stehen so dicht "
    "neben dem Weg, dass Du gerade so mal Platz hast. Auch ist es sehr duester, "
    "weil man den Himmel nicht sehen kann. Im Unterholz neben dem Pfad "
    "befindet sich eine kleine Luecke.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:13, ENV_TERRAIN: TT_FOREST]));
  SetProp(P_INDOORS,0);
  SetProp(P_LIGHT,1);

  CD_NADELWALD;
  CD_WALDPFAD;
  CD_WALDBODEN;

  AddDetail( ({"unterholz"}),
    "Im Unterholz ist hier eine kleine Luecke.");
  AddDetail( ({"luecke"}),
    "Die Luecke ist so klein, dass Du sicher da nicht durchkommst. "
    "Aber ein kleines Waldtier kommt da auf jeden Fall durch.");
  AddDetail( ({"tier", "waldtier"}),
    "Welches Tier hier immer durch die Luecke schluepft, kannst Du nicht "
    "feststellen. Aber Du vermutest, dass es hinter der Luecke seinen Bau "
    "hat.");
  AddDetail( ({"bau"}),
    "Zu dem Bau kommst Du sicher nicht hin, aber du koenntest vielleicht "
    "in die Luecke greifen.");

  AddCmd( ({"greif", "greife"}), "greifen");
  AddCmd( ({"schluepf", "schluepfe"}), "schluepfen");

  AddExit(ED4, "./wald1" );
  AddExit(ED8, "./wald3" );
}

int schluepfen(string str)
{
  notify_fail("Wo willst Du durchschluepfen?\n");
  if( !str ) return 0;
  if( member( ({"luecke", "durch luecke"}), str)!=-1)
  {
    write("Du bist viel zu gross, um durch die Luecke zu schluepfen.\n");
    return 1;
  }
  return 0;
}

int greifen(string str)
{
  object ob;

  notify_fail("Wo willst Du hineingreifen?\n");
  if( !str ) return 0;
  if( member( ({"luecke", "in luecke", "bau", "in bau"}),str) !=-1)
  {
    say( TPN+ " steckt "+ TPPP(FEMALE,WEN,SINGULAR) +" Hand ins Unterholz.\n");
    if( ob=present(OSTERHASENQUEST_ID, TP) )
    {
      if( deep_present( OSTERHASENQUEST_EI+" 10", TP) )
      {
        write("Aber Du hast doch schon genug Eier!\n");
      }
      else
      {
        write("Du greifst in die Luecke und holst ein Hasenei heraus.\n");
        CLONE( OSTERHASENQUEST_DIR "ei", TP);
      }
    }
    else
      write("Du greifst in die Luecke, kannst aber nichts erwischen.\n");
    return 1;
  }
  return 0;
}

public void init() {
  ::init();

  if(interactive(this_player())) {
    check_bard_awf_quest(this_player());
  }
}
