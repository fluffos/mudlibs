#pragma strong_types

#include <properties.h>
#include <moving.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./strand.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "An einer Furt");
  SetProp(P_INT_LONG,
    "Der Strand einer Meeresbucht bildet hier den Weg. Im " + CAP(ED7) +
    " liegen Huegel, eine sumpfige Tiefebene dehnt sich im " + CAP(ED1) +
    " bis zu den Fuessen eines riesigen Berges, unter dessen"
    " wolkenverhuellten Gipfel Schneefelder glaenzen. Im " + CAP(ED3) +
    " muendet ein Fluesschen in die Bucht, das Du auf einer Furt im " +
    CAP(ED2) + " durchqueren kannst.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN:TT_HILL]));

  CD_STRAND;

  AddDetail( ({"bucht", "meeresbucht"}),
    "Du stehst im "+ CAP(ED8) +" einer Meeresbucht.");
  AddDetail( ({"furt", "bach", "fluss", "fluesschen"}),
    "Das Fluesschen ist zu breit, um einfach darueberzuspringen, und"
    " waelzt sich traege durch die Ebene aufs Meer zu. Im " + CAP(ED2) +
    " durchquert eine Furt das Flussbett.");
  AddDetail( ({"wasser", "flussbett"}),
    "Das Wasser, das sich traege im Flussbett dem Meer zuwaelzt, ist ganz"
    " schwarz. Das liegt vermutlich daran, dass der Fluss das Moor im " +
    CAP(ED1) + " durchquert.");
  AddDetail( ({"huegel", "gras", "huegellandschaft", "landschaft"}),
    "Die Huegel im " + CAP(ED7) + " sind mit saftiggruenem Gras"
    " bewachsen, auf der Seeseite liegen ein paar Duenen zwischen dem"
    " Strand und der fruchtbaren Huegellandschaft.");
  AddDetail( ({"duenen", "sand", "sandduenen"}),
    "Etwas weiter landeinwaerts hat der Wind den Sand zu Duenen verweht."
    " Sie sind nicht besonders hoch, aber es waere sicher sehr unbequem"
    " ueber den losen Sand zu gehen. Besonders stabil sieht dieser"
    " uebrigens nicht aus.");
  AddDetail( ({"wind", "brise"}),
    "Wie so oft an der See weht hier eine staendige Brise, mal landein,"
    " mal landab. Du koenntest einen Drachen steigen lassen, wenn Du"
    " wolltest.");
  AddDetail( ({"drachen", "drache"}),
    "Wo ist ein Drache?");
  AddDetail( ({"berg", "kuestenberg", "bergriese"}),
    "Im " + CAP(ED1) + " steht ein wahrer Bergriese, mit weiss"
    " leuchtenden Schneefeldern unterhalb des Gipfels. Dagegen sieht der"
    " Kuestenberg mit zwei Gipfeln im " + CAP(ED8) + " fast armselig aus,"
    " aber auch dieser ist sehr hoch, man sagt, noch niemand habe ihn"
    " bestiegen.");
  AddDetail( ({"schnee", "schneefeld", "schneefelder", "gipfel"}),
    "Vielleicht solltest Du da etwas naeher rangehen, um Einzelheiten zu"
    " erkennen.");
  AddDetail( ({"tiefebene", "ebene", "sumpf", "moor"}),
    "Die Tiefebene ist, wie nicht anders zu erwarten, sehr eben und liegt "
    "auch sehr tief. Sie erstreckt sich weit nach " + CAP(ED1) + 
    ". Teilweise ist sie ziemlich sumpfig und in der Naehe des Flusses "
    "befindet sich ein richtiges Moor. Kein Baum, kein Strauch waechst "
    "dort. Einzelne Fusspuren fuehren ins Moor. Wenn Du wirklich mutig bist, "
    "kannst Du ja auch ins Moor stapfen.");
  AddDetail( ({"fusspuren", "fussspuren", "spur", "spuren"}),
    "Einzelne Fusspuren fuehren ins Moor. Wenn Du wirklich mutig bist, "
    "kannst Du ja auch ins Moor stapfen.");
 
  AddCmd( ({"stapf", "stapfe"}), "stapfen" );
  
  AddExit(ED2, "./1616.lpc" );
  AddExit(ED5, "./1518.lpc" );
}

int stapfen(string str)
{
  notify_fail("Wohin willst Du denn stapfen?\n");
  
  if( str=="moor" || str=="in moor" || str=="sumpf" || str=="in sumpf")
  {
    write("Du stapfst mutig ins Moor hinein.\n");
    TP->move(WESTWEG_UNTERWELT, M_GO, "ins Moor", "stapft", "stapft herein");
    return 1;
  }
  return 0;
}

