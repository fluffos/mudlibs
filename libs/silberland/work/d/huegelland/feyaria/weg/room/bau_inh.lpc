inherit "/std/room";

#include "../def.h"
string richtungen();

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem Murmeltierbau");
  SetProp(P_INDOORS, 1);
  SetProp(P_LIGHT, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:17, ENV_TERRAIN: TT_CAVE]) );

  AddSpecialDetail( ({"decke"}), "decke");
  AddSpecialDetail( ({"kopf"}), "kopf");
  AddSpecialDetail( ({"bauch"}), "bauch"); 
  AddDetail( ({"waende", "wand", "erde"}),
    "Die Waende bestehen aus harter Erde.");
  AddDetail( ({"gebirgsboden", "boden", "spuren", "murmeltierspuren"}),
    "Der Boden ist von Murmeltierspuren uebersaeht, diese Sippe hat "
    "scheinbar sehr viele Mitglieder.");   
  AddDetail( ({"sippe", "murmeltiersippe", "mitglieder", "murmeltiere"}),  
    "Hier wohnt eine grosse Murmeltiersippe.");
  AddDetail( ({"gang", "gaenge", "bau", "murmeltierbau"}),    
    "Du befindest Dich in einem Gang im Murmeltierbau.");
  AddDetail( ({"krallen"}),
    "Die Gaenge wurden von den scharfen Krallen der Murmeltiere gegraben.");  
  
  AddSound( ({DEFAULT_SOUND, "trippeln", "murmeltier", "murmeltiere"}),
    "Hin und wieder hoerst Du das entfernte Trippeln von Murmeltieren.");
  AddSmell( ({DEFAULT_SMELL, "geruch", "murmeltier", "murmeltiere"}),
    "Es riecht eigenartig, das muss wohl der Geruch von Murmeltieren sein.");
}

varargs string decke(object viewer)
{
  string str;
  switch( TP->QueryProp(P_SIZE) )
  {
    case 0..99:
      str="Die Decke ist weit genug ueber Dir, sodass Du hier gemuetlich "
           "dahingehen kannst.";
      break;
    case 100..140:
      str="Die Decke ist etwas niedrig, Du musst aufpassen, dass Du Dir "
           "Deinen Kopf nicht anhaust.";
      break;
    case 141..170:
      str="Die Decke ist sehr niedrig, sodass Du den Kopf einziehen musst "
           "und nur gebueckt gehen kannst.";
      break;
    case 171..250:
      str="Die Decke ist so niedrig, dass Du nur auf allen vieren vorwaerts "
           "kommen kannst.";
      break;
    default:
      str="Die Decke ist so niedrig, dass Du auf dem Bauch liegen musst und "
           "dich nur robbend fortbewegen kannst.";
  }   
  return BS(str);
}

string int_long(mixed viewer,mixed viewpoint, int shortflag)
{
  string str;
  str= "Du befindest Dich in einem Murmeltierbau. Mit ihren scharfen Krallen "
    "haben die Murmeltiere hier Gaenge in den harten Gebirgsboden gegraben. ";
  str+=decke(viewer);
  str+="Der Boden ist von Murmeltierspuren uebersaeht, diese Sippe hat "
    "scheinbar sehr viele Mitglieder. ";   
  str+=richtungen();
  str=BS(str);
  SetProp(P_INT_LONG, str);
  return ::int_long(viewer, viewpoint, shortflag);
}

string kopf()
{
  if( TP->QueryProp(P_SIZE) >= 100 )
    return "Pass auf, dass Du Dir Deinen Kopf nicht anhaust!\n";
  else
    return "Die Decke ist so hoch, dass Du Dir Deinen Kopf nicht anhauen "
           "kannst.\n";
}

string bauch()
{
  if( TP->QueryProp(P_SIZE) > 250 )
    return "Du liegst auf Deinem Bauch, sonst wuerdest Du nicht in diesen "
           "Bau passen.\n";
  else
    return "Mit Deinem Bauch ist noch alles in Ordnung.\n";
}

