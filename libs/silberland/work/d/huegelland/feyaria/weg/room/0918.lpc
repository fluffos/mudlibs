#pragma strong_types

#include <properties.h>
#include <wizlevels.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_WALDWEG;
  SetProp(P_INT_LONG,
    "Kontinuierlich steigt der Weg am Berg empor. Links und rechts des"
    " Wegs wachsen Baeume, und die Fliegen und Kaefer summen im Unterholz."
    " Nach Westen geht ein schmaler Forstweg in den dichten Wald hinein.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN: TT_FOREST]));

  CD_WALD;
  CD_WALDWEG;
  CD_WALDBODEN;

  AddDetail( ({"forstweg", "westen"}),
    "Der Forstweg fuehrt nach Westen in den dichten Wald hinein.");
  AddDetail("berg",
    "Der Berg ist recht steil, sodass es nicht ratsam waere, den Weg zu"
    " verlassen.");
  AddDetail( ({"hochwald", "fliegen", "kaefer", "unterholz", "uebliche",
               "uebliches"}),
    "Ein normaler Hochwald, mit Kaefern, Fliegen und Baeumen. Kurz: das"
    " Uebliche, wenn der Magier nicht weiter weiss.");
  AddDetail( ({"magier"}),
    "Verwende 'idee', wenn Dir etwas zu diesem Raum einfaellt.");  
  AddSound( ({DEFAULT_SOUND, "summen", "kaefer", "fliegen"}),
    "Du hoerst das Summen der Fliegen und Kaefer.");
  AddSmell( ({DEFAULT_SMELL, "duft", "waldduft"}),
    "Du laesst den beruhigenden Waldduft in Deine Lungen einstroemen.");

  SetProp(P_HIDE_EXITS, ({ED6}) );
  AddExit(ED3, "./1018.lpc" );
  AddExit("westen", WESTWEG_HOLZFAELLER);
  AddExit( ({ED6, ED6OB}), "nach "+CAP(ED6OB)+"#./0819.lpc" );
}

