#pragma strong_types

#include <properties.h>
#include <moving.h>
#include "../directions.h"
#include "../cheasy_defs.h"

inherit "std/room";

int zt;

void create() 
{
  ::create();

  zt=1+random(2);
  SetProp(P_LIGHT, 1);    // es ist hell -- naja ein bisschen
  SetProp(P_INDOORS, 1);    // es hat ein Dach
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:22, ENV_TERRAIN:TT_HOUSE])); 
  SetProp(P_NOMAGIC, 1);    // und nix is mit zaubern.
  SetProp(P_INT_SHORT, "In einer Bergwacht-Huette");
  SetProp(P_INT_LONG,
    BS("Die Blockhuette ist aus einfachen, unbehauenen Baumstaemmen"
      " gezimmert und hat nur einen Raum. Ein Fenster neben der Tuer"
      " beleuchtet den Raum nur schwach. In einer Ecke steht ein kleiner"
      " Tisch mit zwei Hockern. In einem Kamin flackert ein kleines Feuer,"
      " ueber dem Feuer haengt ein Kessel an einem Haken. Ein Regal"
      " enthaelt allerlei Utensilien, an Haken in der Wand haengen die"
      " unterschiedlichsten Geraetschaften. An einer Wand stehen sechs"
      " Betten.") );

  AddDetail( ({"bett", "betten"}),
    "In den Betten uebernachten die Bergwacht-Maenner und die Wanderer, die "
    "hier vom Einbruch der Dunkelheit ueberrascht werden.");
  AddDetail( ({"decke", "holzdecke"}),
    "Eine ganz solide Holzdecke.");
  AddDetail( ({"kiefer", "kiefern", "fichte", "fichten"}),
    "Aus den unbehauenen Staemmen der Kiefern und Fichten wurde diese "
    "Huette gebaut. Darum nennt man sie ja auch Blockhuette.");
  AddDetail( ({"huette", "bergwachthuette", "bergwacht-huette", 
               "blockhuette"}),
    "Du stehst mitten drinnen.");
  AddDetail( ({"baumstaemme", "baumstamm", "stamm", "staemme"}),
    "Ganz normale Baumstaemme, wahrscheinlich von einer Kiefer oder"
    " Fichte.");
  AddDetail( ({"wand", "waende", "oberflaeche"}),
    "Die Waende sind unverputzt und naturbelassen, die grob behauenen"
    " Baumstaemme haben eine ungleichmaessige aber doch anheimelnde"
    " Oberflaeche.");
  AddDetail( ({"boden", "fussboden"}),
    "Blitzblank gescheuerte Holzdielen, die leise knarren, wenn Du"
    " Dich bewegst.");
  AddDetail( ({"dielen", "holzdielen"}),
    "Sie sind so sauber, dass Du davon essen koenntest.");
  AddDetail( ({"raum", "zimmer", "stube"}), QueryProp(P_INT_LONG) );
  AddDetail("fenster",
    "Wie alles hier ist das Fenster blitzblank geputzt.");
  AddDetail("tisch",
    "Auf dem Tisch siehst Du die Reste einer leckeren Brotzeit. Die"
    " Bewohner sind wohl sehr ueberhastet aufgebrochen.");
  AddDetail( ({"reste", "brotzeit"}),
    "Viel ist nicht mehr uebrig. Es sind wirklich nur mehr Reste.");
  AddDetail("hocker",
    "Erstaunlicherweise ist einer der Hocker umgefallen. Das passt"
    " gar nicht zur peniblen Ordnung hier.");
  AddDetail( "ordnung",
    "Bis auf den umgefallenen Hocker herrscht hier penible Ordnung.");
  AddDetail("kamin",
    "Im Kamin flackert ein kleines Feuer, ueber dem ein Kessel leise"
    " blubbert.");
  AddDetail( ({"feuer", "waerme"}),
    "Das Feuer ist schon fast heruntergebrannt, spendet aber trotzdem"
    " angenehme Waerme hier drinnen.");
  AddDetail( ({"kessel","zaubertrank", "naschwerk", "suppe", "gebraeu"}),
    "Du schaust neugierig in den Kessel und entdeckst... \n"
    "... nein ... das kann doch nicht sein! \n"
    "Unglaeubig wirfst Du einen zweiten Blick in den Kessel. \n"
    "Kein Zweifel. Das ist der Ort, an dem Zaubertrank gebraut wird! \n"
    "Ob Du einmal probieren kannst? \n" );
  AddDetail("haken",
    "Du entdeckst gleich mehrere Haken: Einen im Kamin, an dem ein"
    " Kessel haengt, und einige an der Wand, an welchen die"
    " unterschiedlichsten Geraetschaften haengen.");
  AddDetail( ({"regal", "utensilien", "mull", "verbandmull", "gips",
      "schienen", "armschienen", "beinschienen", "desinfektionsmittel",
      "mittel", "serum", "blutserum"}),
    "Du siehst die unterschiedlichsten Utensilien im Regal:"
    " Verbandmull, Gips, Arm- und Beinschienen, Desinfektionsmittel,"
    " Blutserum, ... kurz und gut: alles was man zum Verarzten mehr"
    " oder weniger schwer Verletzter braucht.");
  AddDetail( ({"geraet", "geraete", "geraetschaften", "seil", "kletterseil"
      "gurte", "abseilgurte", "kletterhaken", "eispickel", "pickel",
      "steigeisen", "lawinensonden", "rettungsgeraet", "kletterseile"}),
    "An einigen Haken in der Wand haengen Kletterseile, Abseilgurte, "
    "Kletterhaken, Eispickel, Steigeisen, Lawinensonden und vielerlei "
    "anderes Rettungsgeraet, dessen Sinn Du nicht erkennen kannst.");
  AddDetail(({"ecke", "ecken"}),
    "In einer Ecke steht ein Tisch mit zwei Hockern.");
  AddDetail("tuer",
    "Die Tuer ist nur angelehnt, Du kannst die Huette jederzeit"
    " verlassen.");
  AddSmell( ({DEFAULT_SMELL, "duft"}),
    "Es riecht hier nach einer suessen Speise. Der Duft kommt wohl aus dem "
    "Kessel.");
  AddSmell( ({"kessel", "zaubertrank", "naschwerk", "suppe", "gebraeu"}),
    "Das Gebraeu im Kessel riecht sehr suess. Das hat sicher jemand "
    "gemacht, der sehr gerne nascht.");

  AddCmd( ({"nimm"}), "get");
  AddCmd( ({"iss", "probiere","probier"}), "eat");
  AddCmd( ({"trink","trinke"}), "drink");
  AddCmd( ({"nasche","nasch"}), "naschen");

  AddExit("raus", "./0210.lpc");
}

int get(string str) 
{
  if (str == "zaubertrank" || str == "naschwerk") 
  {
    MSG("Huch... Du hast alles verschuettet.",
      " verschuettet etwas Suppe."); 
    return 1;
  }
  notify_fail("Dein schlechtes Gewissen laesst das nicht zu. \n");
  return 0;
}

int drink(string str) 
{
  notify_fail("Was willst Du trinken?\n");
  if( str == "zaubertrank" || str == "naschwerk")
  {
    write( BS("Du willst von dem Zaubertrank trinken, aber er ist irgendwie "
              "klebrig und suess. Dieses Naschwerk musst Du scheinbar "
              "auf eine andere Weise zu Dir nehmen.") );
    return 1;
  }
  return 0;
}

int eat(string str) 
{
  notify_fail("Was willst Du essen?\n");
  if( str == "zaubertrank" || str == "naschwerk")
  {
    write( BS("Du willst von dem Zaubertrank essen, aber er ist irgendwie "
              "klebrig und suess. Dieses Naschwerk musst Du scheinbar "
              "auf eine andere Weise zu Dir nehmen.") );
    return 1;
  }
  return 0;
}

int naschen(string str) 
{
  notify_fail("Was willst Du naschen?\n");
  if( str == "zaubertrank" || str == "naschwerk")
  {
    write_file(LOG "zt",
      ctime()+": "+ TPN+ " findet den ZT in Huette2.c\n");
    if( TP->FindPotion( BS("Du naschst etwas von dem Zaubertrank und ein "
           "suesser Geschmack durchflutet Deinen ganzen Koerper. Du fuehlst "
           "Dich fast wie neu geboren. Es handelt sich also doch um einen "
           "echten Zaubertrank.") ) )
    {
      TP->heal_self(200);
      return 1;
    }
    write("Du naschst etwas von dem Zaubertrank, aber scheinbar war es kein "
         "echter. :(\nAber wenigstens schmeckt das suesse Zeug sehr gut.\n");
    if( zt-- > 0 )
      TP->heal_self(20);
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();
  zt=random(2)+1;
}
