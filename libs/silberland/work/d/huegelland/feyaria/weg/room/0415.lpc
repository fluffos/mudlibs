#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_WALDWEG;
  SetProp(P_INT_LONG,
    BS("Der Nadelwald ist hier sehr licht, fast nur noch Kiefern wachsen"
      " hier in dieser Hoehe. Alle Baeume haben seltsam verdrehte Zweige,"
      " und erreichen bei weitem nicht dieselbe Groesse wie unten im Tal."));
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:11, ENV_TERRAIN:TT_HILL]));

  CD_NADELWALD;
  CD_WALDWEG;
  CD_WALDBODEN;

  AddDetail( ({"kiefer", "kiefern", "baum", "baeume", 
               "musterexemplare", "muster", "exemplare", "groesse"}),
    "Die Kiefern hier sind durch das kalte Klima und die staendig"
    " blasenden Winde im Wachstum stark gegenueber den Musterexemplaren im"
    " Tal benachteiligt." );
  AddDetail( ({"klima", "wind", "winde", "wachstum"}),
    "Das kalte Klima und die staendig blasenden Winde benachteiligen das "
   "Wachstum der Kiefern."); 
  AddDetail( ({"musterexemplar", "musterexemplare"}),
    "Du kannst Dich gerade noch erinnern, wie die Kiefern im Tal"
    " aussahen... jedenfalls voellig anders als die Kiefern hier." );
  AddDetail( ({"tal"}),
    "Das Tal liegt weit unter Dir.");
  AddDetail( ({"zweig", "zweige"}),
    "Die Zweige sind durch die hier staendig blasenden Winde seltsam"
    " verdreht und verknotet, bizarr wachsen sie eher entlang der Erde als"
    " in die Hoehe.");
  AddDetail( ({"hoehe"}),
    "Alles ist relativ... die Kiefern stehen hier zwar in grosser Hoehe,"
    " aber sie wachsen nicht dahin, sondern eher entlang der Erde.");
  AddDetail( ({"boden","erde", "krume", "krumen"}),
    "Nur wenig Erde ist zwischen den Felsen zu finden, aber fast jeder"
    " Krumen zwischen den Steinen wird von einer Pflanze genutzt.");
  AddDetail( ({"fels", "felsen", "grund", "stein", "steine", "geroell"}),
    "Der Boden besteht hier fast nur noch aus Steinen und Geroell,"
    " manchmal ist auch der blanke Fels dazwischen zu erkennen.");
  AddDetail( ({"himmel", "wolke", "wolken"}),
    "Einige weisse Schoenwetterwolken stehen am Himmel, und die Sonne"
    " scheint. Trotzdem ist es hier unangenehm kuehl.");
  AddDetail( ({"nadelwald", "wald", "pflanzen", "pflanze"}),
    "Hier wachsen nur noch verkrueppelte Kiefern.");
  AddSound( DEFAULT_SOUND,
    "Hier ist es angenehm ruhig.");
  AddSmell( ({DEFAULT_SMELL, "duft", "waldduft"}),
    "Du laesst den beruhigenden Waldduft in Deine Lungen einstroemen.");

  AddExit(ED3, "./0515.lpc" );
  AddExit(ED8, "./0314.lpc" );
}
