#include "../def.h"

inherit ROOM "bau_inh";

void create()
{
  ::create();

  AddDetail( ({"oeffnung", "westen"}),
    "Im Westen befindet sich eine kleine Oeffnung, Dort kommst Du wieder aus "
    "dem Bau hinaus.");
  AddSpecialDetail( ({"richtungen", "suedostunten"}), "richtungen");

  AddExit( ({"raus", "westen"}), "./0715" );
  AddExit(({"suedostunten", "suedosten"}), "./bau2");
  SetProp(P_HIDE_EXITS, ({"suedosten", "westen"}) );

  AddItem( NPC "murmeltier" , REFRESH_DESTRUCT,
      ([P_NOCORPSE: 0, P_DIE_MSG: " faellt tot um.\n"]) );
}

string richtungen()
{
  return BS("Nach Westen kannst Du den Bau durch eine kleine Oeffnung "
         "verlassen. Nach Suedostunten geht der Bau tiefer in die Erde "
         "hinein. ");
}
