#pragma strong_types

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>

#include "../directions.h"
#include "../cheasy_defs.h"

inherit "std/room";

// PROTOTYPES
int jump(string str);
void deathJump();
int climb(string str);
void down();
int slide(string str);
int NoScript();


// FUNCTIONS

void create()
{
  ::create();

  SetProp(P_LIGHT, 1);  // es ist hell -- naja ein bisschen
  SetProp(P_INDOORS, 0);// es hat kein Dach
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:13, ENV_TERRAIN:TT_HILL]));
  SetProp(P_INT_SHORT, "Auf einem Mammutbaum");
  SetProp(P_INT_LONG, BS(
    "Nach anstrengender Kletterei erreichst Du einen gemuetlichen Platz "
    "weit oben in der Spitze des Mammutbaums. Der Ausblick von hier ist "
    "ueberwaeltigend. Im "+ CAP(ED5) +" siehst Du ein Huegelland hinter "
    "dem sich ein grosser Berggipfel erhebt. Im "+ CAP(ED8)+" erstreckt "
    "sich ein grosses Waldgebiet. Neben Dir faellt der Wasserfall in "
    "den Talkessel hinunter. Irgendwo dort unten muss auch der Waldweg "
    "sein, aber den kannst Du kaum noch erkennen. Knapp ueber Dir "
    "befindet sich ein Baumhaus. Rechts, nicht weit von hier entfernt, "
    "siehst Du eine kleine Wolke, die Du ohne Schwierigkeiten erreichen "
    "koenntest."));
  AddDetail( "wolke", "Eine kleine Wolke befindet sich ein kleines Stueck "
    "rechts vom Ast, auf dem Du stehst.");
  AddDetail( ({"stueck", "schwierigkeiten", "schwierigkeit"}), "Du solltest die Wolke ohne "
    "Schwierigkeiten erreichen koennen, sie ist nur ein kleines Stueck "
    "entfernt.");
  AddDetail( "rechts", "Geh Doch einfach hin!");
  AddDetail( ({"baumhaus", "haus"}),
    "Ein grosses Baumhaus, wer dort wohl wohnen mag?");
  AddDetail( ({"sonne", "himmel"}),
    "Du bist zwar schon sehr hoch geklettert, aber die Sonne und der Himmel "
    "sind trotzdem noch sehr weit oben.");
  AddDetail( ({"weg", "waldweg", "boden"}),
    "Der Waldweg ist so weit unten, dass Du kaum etwas erkennen kannst.");
  AddDetail( ({"platz"}),
    "Der Ast, auf dem Du sitzt, kann man wirklich als gemuetlichen Platz "
    "bezeichnen.");
  AddDetail( ({"spitze"}),
    "Du befindest Dich fast schon in der Spitze des Mammutbaums.");
  AddDetail( ({"ausblick", "blick", "gipfel", "berggipfel", "ferne"}),
    "Der Ausblick ist wirklich phantastisch. Im "+ CAP(ED5) +" siehst Du "
    "ein Huegelland hinter dem sich ein grosser Berggipfel erhebt. Im "+
    CAP(ED8)+" erstreckt sich ein grosses Waldgebiet.");
  AddDetail( ({"waldgebiet", "gebiet"}),
    "Das Waldgebiet erstreckt sich weit von " + CAP(ED7) + " nach "+
    CAP(ED1) + ". Ueberall siehst Du die gruenen Wipfel der Baeume.");
  AddDetail( ({"huegel", "huegelland", "land", "huegeln"}),
    "Das Land im " + CAP(ED5) + " ist sehr huegelig. Hinter den Huegeln "
    "erhebt sich ein maechtiger Berg.");
  CD_BERG_WEIT;
  AddDetail( ({"wasserfall"}),
    "Der Wasserfall stuerzt neben Dir herab und durchnaesst"
    " alles mit der Gischt, die vom Wind abgetrieben wird.");
  AddDetail( ({"talkessel"}),
    "Der Talkessel ist weit unter Dir.");
  AddDetail( ({"gischt", "dunst"}),
    "Der Wasserfall rauscht mit solcher Wucht nach unten, dass feiner"
    " Dunst entsteht. Diese Gischt wird durch den Wind abgetrieben und"
    " durchnaesst alles hier.");
  AddDetail( ({"wasser"}),
    "Hier gibt es ueberall Wasser: durch die Luft treibt die Gischt des"
    " Wasserfalls und durchnaesst alles hier. Der Ast, auf dem Du"
    " sitzt, ist ebenso nass wie der Stamm, Deine Kleider und die Luft"
    " hier.");
  AddDetail( ({"stamm", "baumstamm"}),
    "Der Stamm des Mammutbaums ist hier in Wipfelhoehe noch so dick wie "
    "die Staemme der Nadelbaeume unten auf dem Boden. Im Stamm befinden "
    "sich viele kleine Loecher." );
  AddDetail( ({"loch", "loecher"}),
    "Die Loecher sind klein und rund. Vielleicht hat ein Specht die Loecher "
    "in den Stamm geschlagen, um leckere Insekten zu finden.");
  AddDetail( ({"specht"}),
    "Der Specht ist scheinbar nicht da. Aber wenn er hungrig ist, kommt er "
    "sicher wieder hierher, um Insekten zu fangen.");
  AddDetail( ({"insekten"}),
    "Die Insekten kann wohl nur ein Specht aus dem Baum herausbekommen.");
  AddDetail( ({"luft", "wind"}),
    "Die Wucht des Wasserfalls reisst auch die Luft mit, weshalb hier "
    "staendig ein leichter Wind weht. Durch die Gischt in der Luft ist "
    "dieser Wind nass und unangenehm. Deshalb ist es hier so unangenehm "
    "kalt.");
  AddDetail( ({"aeste"}),
    "Hier gibt es nur einen Ast.");
  AddDetail( ({"ast"}),
    "Der Ast, auf dem Du sitzt, ist so dick wie Dein Oberschenkel "
    "und sicher stabil genug, um hier laengere Zeit zu sitzen.");
  AddDetail( ({"krone", "wipfel", "kronen", "wipfelhoehe"}),
    "Die Wipfel der ringsum wachsenden Fichten und Tannen befinden sich "
    "weit unter Dir.");
  AddDetail( ({"baum", "mammutbaum"}),
    "Der Mammutbaum hat hier in Wipfelhoehe noch einen ziemlich dicken "
    "Stamm.");
  AddDetail( ({"wald", "waldbaum", "waldbaeume", "baeume", "nadelbaeume"}),
    "Ringsum stehen Fichten und Tannen, deren Wipfel sich weit unter "
    "Dir befinden.");
  AddDetail( ({"fichte", "fichten"}),
    "Dir schiesst ein Gedanke durch den Kopf: von hier oben betrachtet"
    " sehen die Fichten aus wie kleine Hutzelmaennchen im gruenen Rock.");
  AddDetail( ({"hutzelmaennchen", "rock"}),
    "Die Fichten sehen wirklich so aus, es sind aber leider nur ganz "
    "normale Fichten.");
  AddDetail( ({"gedanke", "gedanken", "kopf"}),
    "Mach Dir doch ueber vernueftige Dinge Gedanken.");
  AddDetail( ({"tanne", "tannen"}),
    "Die Tannen ueberragen die Fichten ein wenig, aber von hier oben "
    "macht das kaum einen Unterschied. Eine Tanne steht ziemlich nahe, "
    "sodass man fast auf sie springen koennte. Aber nur ein Selbstmoerder "
    "wuerde diesen gefaehrlichen Sprung wagen.");
  AddDetail( ({"selbstmoerder", "sprung"}),
    "Bist Du wirklich ein Selbstmoerder? Dann kannst Du ja den "
    "gefaehrlichen Sprung wagen.");

  AddItem( NPC "specht", REFRESH_DESTRUCT);

  AddCmd( ({"spring", "springe"}), "jump");
  AddCmd( ({"kletter", "klettere"}), "climb");
  AddCmd( ({"rutsch"}), "slide");
}

int jump(string str)
{
  if (str == "tanne" || str == "auf tanne" || str == "zu tanne"
      || str == "runter")
  {
    deathJump();  // man stuerzt unweigerlich ab...
    return 1;    // aber vielleicht ueberlebt man's (50%)
  }
  notify_fail("Wohin willst Du denn springen?\n");
  return 0;
}

void deathJump()
{
  write(BS("Du nimmst all Deinen Mut zusammen und springst zur am naechsten"
    " stehenden Tanne."));
  say(BS(TP->name() + " konzentriert sich einen Augenblick lang und springt "
    "dann zur am naechsten stehenden Tanne."));
  TP->move(ROOM "freefall.lpc", M_GO | M_SILENT);
  // jetzt geht das Ueberlebenslotto los ;-)
  clone_object(OBJ "nix.lpc")->move(TP, M_NOCHECK);
}

int climb(string str)
{
  if (str == "runter" || str=="hinunter" || str == "nach unten")
  {
    this_player()->move(ROOM "baum.lpc", M_GO, "unten", "klettert nach",
      "kommt einen Baumstamm heruntergeklettert");
    return 1;
  }
  else if (str == "hoch" || str=="hinauf" || str=="rauf" ||
           str == "nach oben")
  {
    this_player()->command_me("oben");
    return 1;
  }
  notify_fail("Wohin willst Du denn klettern?\n");
  return 0;
}

int slide(string str)
{
  if (str == "runter" || str == "hinunter" || str == "nach unten" )
  {
    this_player()->move(ROOM "baum.lpc", M_GO, "unten", "rutscht nach",
      "rutscht an einem Baumstamm herunter");
    return 1;
  }
  notify_fail("Wohin willst Du denn rutschen?\n");
  return 0;
}
