// /d/gebirge/feyaria/weg/room/0714.c
// Das Baerennest (0714.c)
// 1996-12-23  Feyaria@SilberLand

#pragma strong_types

#include <properties.h>
#include <language.h>
#include "../directions.h"
#include "../cheasy_defs.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "In einem Braunbaernest");
  SetProp(P_INT_LONG, BS(
    "Du stehst in einem riesigen, weich gepolsterten Nest direkt "
    "neben dem Weg. Du koenntest Dich ohne Probleme darin schlafen legen. "
    "Es riecht hier stark nach Baeren. Hier hat sich scheinbar eine "
    "Baerenfamilie ihr Lager errichtet. Die Zweige der Kiefern biegen "
    "sich ueber das Nest, sodass man fast von einem Dach sprechen kann. "
    "Nach " + CAP(ED7) + " kommst Du wieder auf den Weg zurueck."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);  
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:17, ENV_TERRAIN: TT_FOREST]));

  AddDetail( ({"nest", "lager", "baerennest"}),
    "Du stehst in einem riesigen, weich gepolsterten Nest. Du koenntest "
    "Dich ohne Probleme darin schlafen legen.");
  AddDetail( ({"boden"}),
    "Der Boden ist mit Zweigen und Laub ganz weich gepolstert.");
  AddDetail( ({"zweig", "laub", "zweige", "blaetter", "nadeln", "blatt",
               "nadel"}),
    "Das Nest ist mit Zweigen und Laub weich ausgepolstert.");
  AddDetail( ({"himmel", "sonne"}),
    "Du kannst den Himmel von hier aus nicht sehen, denn die Zweige der "
    "Kiefern biegen sich ueber das Nest, sodass man fast von einem Dach "
    "sprechen kann.");
  AddDetail( ({"weg", "pfad"}),
    "Der Weg befindet sich im " + CAP(ED7) +".");
  AddDetail( ({"baer", "braunbaer", "baerin", "braunbaerin", "baerchen",
               "braunbaerchen"}),
    "Scheinbar ist gerade keiner da.");
  AddDetail( ({"braunbaeren", "baeren", "baerenfamilie"}),
    "Hier leben sicher mehrere Baeren.");
  AddDetail( ({"dach", "decke"}),
    "Die Zweige der Kiefern biegen sich ueber das Nest, sodass man fast "
    "von einem Dach sprechen kann. Daher ist das Nest gut vor Regenguessen "
    "geschuetzt.");
  AddDetail( ({"regen", "regenguesse"}),
    "Hier bist Du gut vor Regen geschuetzt.");
  AddDetail( ({"kiefer", "kiefern", "krueppelkiefern"}),
    "Die Kiefern sind hier gerade gross genug, dass ihre hoechsten Zweige "
    "das Baerennest ueberdecken koennen.");
  AddDetail( ({"zweige", "zweig", "kieferzweige", "kieferzweig"}),
    "Die Kieferzweige ueberdecken das Nest und bilden fast ein richtiges "
    "Dach.");
  AddDetail( ({"honig"}),
    "Es ist kein Honig mehr da. Scheinbar haben die Baeren schon alles "
    "aufgegessen. Nur noch der Honigduft liegt in der Luft.");

  AddSmell( ({DEFAULT_SMELL, "geruch", "gestank"}),
    "Es riecht hier stark nach Baeren.");
  AddSmell( ({"baer", "baeren", "braunbaer", "braunbaeren", "barennest"}),
    "Es riecht hier stark nach Baeren; Du wirst doch nicht in einem "
    "Baerennest gelandet sein? Ganz schwach duftet es suesslich.");
  AddSmell( ({"duft", "honig", "honigduft", "suess", "suesslich",
              "suessigkeit", "suessigkeiten"}),
    "Der suesse Duft stellt sich als Honigduft heraus.");

  AddItem(NPC "baer", REFRESH_DESTRUCT, ([P_AGGRESSIVE:0]));
  AddItem(NPC "baerin", REFRESH_DESTRUCT, ([P_AGGRESSIVE:0]));
  AddItem(NPC "baerchen", REFRESH_DESTRUCT, ([P_AGGRESSIVE:0]));

  AddExit(ED7, "./0614" );
}
