#include "../def.h"

inherit ROOM "bau_inh";

void create()
{
  ::create();

  AddSpecialDetail( ({"richtungen", "norden", "osten", "suedwesten"}), 
    "richtungen");

  AddExit(({"norden"}), "./bau8");  
  AddExit(({"osten"}), "./bau7");
  AddExit(({"suedwesten"}), "./bau5");
}

string richtungen()
{
  return BS("Hier verzweigen sich die Gaenge und fuehren nach Norden, Osten "
            "und Suedwesten. ");
}


