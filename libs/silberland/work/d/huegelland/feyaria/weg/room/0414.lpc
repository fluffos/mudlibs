#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

int wurzel;

void create()
{
  ::create();

  wurzel=1;
  P_INT_SHORT_WALDWEG;
  SetProp(P_INT_LONG,
    BS("Hier fuehrt der Waldweg in einer weiten Kurve von " + CAP(ED3) + 
      " nach " + CAP(ED6) + " steil bergauf. Der Wald saeuselt leise im"
      " Wind, und die Voegel zwitschern froehlich. Der Boden ist hier "
      "von besonders vielen Wurzeln durchzogen.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN: TT_FOREST]));
  
  CD_WALD;
  CD_WALDWEG;
  CD_WALDBODEN;

  AddDetail( ({"boden", "waldboden"}),
    "Der Waldboden ist mit Nadeln bedeckt und mit sehr vielen Wurzeln "
    "durchzogen.");
  AddDetail( ({"wurzel", "wurzeln"}),
    "Viele Wurzeln durchziehen den Boden. Falls Du jemals eine Wurzel "
    "ausgraben willst, ist das sicher der richtige Platz dafuer.");
  AddDetail( ({"kurve"}),
    "Weit geschwungen biegt die Kurve durch den Wald, sodass Du den Weg "
    "weit den Berg hinauf und herab ueberschauen kannst.");
  AddDetail( ({"berg"}),
    "Der Berg wird durch den Wald verdeckt, darum kannst Du ihn eigentlich "
    "nicht sehen. Du weisst aber, dass irgendwo ein Berg sein muss, sonst "
    "wuerde es naemlich hier nicht bergauf gehen koennen.");
  AddDetail( ({"voegel", "vogel"}),
    "Du siehst keine, wohl aber kannst Du ihnen lauschen.");
  AddSound(DEFAULT_SOUND,
    "Der Wald saeuselt leise im Wind, und die Voegel zwitschern froehlich.");
  AddSound( ({"vogel", "voegel", "zwitschern", "voegeln"}),
    "Tschiiiilp... piiiiiiiep.... floet.....");
  AddSound( ({"wind", "saeuseln", "wald"}),
    "Der Wald saeuselt leise im Wind.");
  AddSmell( ({DEFAULT_SMELL, "duft", "waldduft"}),
    "Du laesst den beruhigenden Waldduft in Deine Lungen einstroemen.");

  AddCmd( ({"grab", "grabe"}), "graben");
  
  SetProp(P_HIDE_EXITS, ({ ED6, ED3}) );
  AddExit( ({ED6, ED6OB}), "./0313.lpc" );
  AddExit( ({ED3, ED3U}) , "./0514.lpc" );
}

int graben(string str)
{
  notify_fail("Was willst Du ausgraben?\n");
  if( !str ) return 0;
  if( !present("schaufel", TP) )
  {
    write("Ohne Schaufel im harten Waldboden herumkramen? Du bist doch "
        "kein Maulwurf!\n");
    return 1;
  }
  if( str=="wurzel aus" || str=="schwarzwurzel aus" )
  {
    if( wurzel )
    {
      write("Du graebst eine Schwarzwurzel aus und steckst sie sofort ein.\n");
      say( CAP_TPN+" graebt im Boden herum.\n", ({TP}) );
      CLONE("/d/ebene/creative/feldlager/obj/wurz", TP);
      wurzel=0;
    }
    else
    {
      write("Du graebst, aber findest keine vernueftige Wurzel.\n");
      say( CAP_TPN+" graebt im Boden herum.\n", ({TP}) );
    }
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();
  wurzel=1;
}
