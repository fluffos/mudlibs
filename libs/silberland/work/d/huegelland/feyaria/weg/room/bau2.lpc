#include "../def.h"

inherit ROOM "bau_inh";

void create()
{
  ::create();

  AddSpecialDetail( ({"richtungen", "nordwesten", "sueden", "osten"}), 
    "richtungen");

  AddExit( ({"osten"}), "./bau3" );
  AddExit(({"nordwesten", "nordwestoben"}), "./bau1");  
  AddExit(({"sueden", "suedunten"}), "./bau4");
  SetProp(P_HIDE_EXITS, ({"sueden", "nordwesten"}) );

}

string richtungen()
{
  return BS("Nach Nordwesten geht es steil hinauf, im Sueden dagegen steil "
         "bergab. Nur im Osten geht der Gang einigermassen geradeaus. ");
}
