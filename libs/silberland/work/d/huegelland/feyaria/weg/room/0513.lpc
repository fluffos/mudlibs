#pragma strong_types

#include <properties.h>
#include <moving.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./talaue.h"
#include "./bergpfad.h"

#define SCHILD_TEXT \
"+------------------+\n" \
"|   Raststation    |\n" \
"| Schaudichnichtum |\n" \
"+------------------+\n"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN:TT_HILL]));
  P_INT_SHORT_BERGPFAD;
  SetProp(P_INT_LONG, BS(
    "Hier am Waldrand hast Du eine wunderschoene Aussicht ueber eine Talaue,"
    " die friedlich in der Sonne liegt. Der Weg durchquert das Tal nach " +
    CAP(ED8) + ", im " + CAP(ED4) + " fuehrt der Weg durch Wald steil"
    " bergauf. Neben dem Weg steht ein kleines Haeuschen."));

  CD_BERGPFAD;
  CD_AUE;
  CD_AUE2;

  AddDetail( ({"wald", "waldrand", "rand", "hochwald"}),
    "Im " + CAP(ED4) + " wachsen die ersten Baeume des Waldes, der den"
    " gesamten Berghang bedeckt. Seltsam geduckt liegt der Wald am Rand"
    " der Wiese, fast so, als bestuende eine Feindschaft zwischen beiden.");
  AddDetail( ({"feindschaft", "feind", "feinde"}),
    "Glaubst Du wirklich, dass ein Wald und eine Wiese Feinde sein "
    "koennen?");
  AddDetail( ({"berg", "berghang"}),
    "Der Berg steigt uebergangslos steil aus dem Tal empor, er ist mit"
    " Wald bewachsen, soweit das Auge reicht.");
  AddDetail( ({"auge"}),
    "Jetzt ist Dir doch glatt eine Muecke ins Auge geflogen.");
  AddDetail( ({"muecke"}),
    "Du wischst Dir die Muecke aus Deinem Auge. Hah! Das hat das Biest"
    " nicht ueberlebt.");
  AddDetail( ({"biest"}),
    "Warum musst Du jetzt nur an den Vogel-Rok denken?");
  AddDetail( ({"rok", "vogelrok", "vogel-rok"}),
    "Zum Glueck ist er nicht hier.");
  AddDetail( ({"haus", "haeuschen"}),
    "Im " + CAP(ED7) + " steht ein Haeuschen neben dem Weg. Ueber dem"
    " doppelfluegeligen Tor haengt ein Schild, und vor dem Tor stehen"
    " einige Tische und Stuehle im Freien auf einer Terrasse.");
  AddDetail( ({"raststation", "wirtschaft", "kneipe", "taverne",
               "wirtshaus", "station", "schaudichnichtum"}),
    "In dieser Raststation koennen hungrige Wanderer einen kleinen "
    "Imbiss zu sich nehmen.");
  AddDetail( ({"hunger", "durst", "imbiss", "beduerfnisse"}),
    "Wenn Du Hunger oder Durst hast, brauchst Du nur die Raststation zu "
    "betreten. Dort kannst Du sicher alle Deine Beduerfnisse stillen.");
  AddDetail( ({"wanderer"}),
    "Du, zum Beispiel, bist so ein Wanderer.");
  AddDetail( ({"tuer", "tor", "eingangstor"}),
    "Durch das Tor kannst Du die Raststation betreten.");
  AddDetail( ({"tisch", "tische", "stuhl", "stuehle"}),
    "Hier scheint vor kurzem ein Schauer niedergegangen zu sein: die"
    " Tische und Stuehle sind noch schraeg gegen die Wand gelehnt und"
    " tropfnass. Drinnen ist es bestimmt angenehmer.");
  AddDetail( ({"terrasse", "balkon"}),
    "Die Terrasse ist mit wunderschoenem Ausblick ueber die Ebene"
    " angelegt. Hinter der Terrasse erkennst Du das Eingangstor zur"
    " Wirtschaft.");
  AddDetail( ({"ausblick", "aussicht", "panorama", "platz", "tal", "talau",
               "talaue", "ebene"}),
    "Dieser Platz ist wirklich wunderschoen... Du siehst ein"
    " sonnendurchflutetes Tal, in dem eine saftiggruene Wiese unter"
    " leichtem Dunst liegt. Der Weg durchquert das Tal schnurgerade nach "
    + CAP(ED8) + ". Im " + CAP(ED1) + " liegt ein kleiner See, an dessen"
    " Ufern ein breiter Schilfguertel waechst. Im "+CAP(ED3)+" stuerzt ein"
    " Wasserfall ueber die Kante einer Steilwand in den See. Im " +
    CAP(ED2) + " fuehrt ein kleiner Fluss das Wasser durch eine Schlucht"
    " ab.");
  AddDetail( ({"sonne", "himmel", "wolken"}),
    "Waermend scheint die Sonne zwischen einigen weissen Wolken am"
    " Himmel. Trotzdem ist es hier erfrischend kuehl.");
  AddDetail( ({"wiese", "see", "ufer", "schilf", "schilfguertel",
            "wasserfall", "steilwand", "wand", "kante", "schlucht", "fluss"}),
    "Der Dunst verhindert, dass Du genaueres erkennst. Du solltest naeher"
    " rangehen.");
  AddDetail("dunst",
    "Es hat wohl vor kurzem noch geregnet, jedenfalls ist es ein wenig"
    " dunstig hier.");
  AddDetail( ({"schauer", "wasser", "tropfen"}),
    "Hier scheint vor kurzem ein Schauer niedergegangen zu sein: die"
    " Tische und Stuehle auf der Terrasse sind noch tropfnass. Drinnen"
    " ist es bestimmt gemuetlicher.");
  AddDetail( ({"weg", "pfad"}),
    "Der Weg fuehrt nach " + CAP(ED8) + " durch Wiesen in das Tal;"
    " im "+ CAP(ED4) + " fuehrt er durch einen Hochwald steil bergauf.");
  AddDetail("schild", SCHILD_TEXT);
  AddReadDetail("schild", SCHILD_TEXT);

  AddSound( ({DEFAULT_SOUND, "platschen", "tropfen"}),
    "Hinundwieder hoerst Du ein Platschen, wenn ein Tropfen auf den "
    "Boden faellt.");
  AddSmell( ({DEFAULT_SMELL, "duft"}),
    "Es duftet angenehm nach dem Regen.");


  AddCmd( ({"betritt", "betret", "betrete"}), "enter");

  SetProp(P_HIDE_EXITS, ({ ED4 }) );
  AddExit( ({ED4, ED4OB}), "nach "+CAP(ED4OB)+"#./0614.lpc" );
  AddExit(ED8, "./0412.lpc" );
}

int enter (string str) 
{
  notify_fail("Was willst Du betreten?\n");
  if( !str ) return 0;
  if( member( ({"raststation", "station", "wirtschaft", "kneipe", "taverne",
      "schaudichnichtum", "wirtshaus" ,"haus", "haeuschen"}), str)!=-1 )
  {
    write("Du betrittst die Raststation.\n");
    TP->move( ROOM "kneipe", M_GO, "die Raststation", "betritt",
             "kommt herein");
    return 1;
  }
  return 0;
}
