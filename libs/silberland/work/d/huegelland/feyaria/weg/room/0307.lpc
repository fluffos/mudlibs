#pragma strong_types

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./huegel.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einer Hochflaeche");
  SetProp(P_INT_LONG, BS(
    "Du stehst im " + CAP(ED7) + " einer grossen Hochflaeche, die leicht"
    " nach " + CAP(ED3) + " abfaellt. Dort weidet ein Schaefer mit seinen"
    " Schaeferhunden seine Schafe. Im " + CAP(ED7) + " verlaeuft ein Weg"
    " etwas erhoeht auf einem Grat. Der Weg nach "+ CAP(ED3) +" wird durch "
    "eine breite Kluft abgeschnitten.")
    + "Ein Schild.\n" );
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:13, ENV_TERRAIN:TT_HILL]));

  CD_HUEGEL; /* Details fuer den Huegel, definiert in huegel.h */
  CD_HUEGEL2;
  CD_HUEGEL3;
  CD_HUEGEL4;

  AddDetail( ({"grat", "weg"}),
    "Der Weg fuehrt oben auf dem Grat entlang.");
  AddDetail( ({"hochflaeche"}),
    "Du stehst auf einer fast ebenen, nach " + capitalize(ED3) + 
    " geneigten Hochflaeche. Das karge Gras kann hier wohl keine Kuehe"
    " ernaehren, deshalb haelt man hier die genuegsameren Schafe.");
  AddDetail( ({"kuh", "kuehe"}),
    "Es gibt hier KEINE Kuehe, sondern nur Schafe. Untersuch doch nur Sachen, "
    "die wirklich da sind.");
  AddDetail( ({"gras", "graeser", "sauergras", "ernaehrung"}),
    "Hier waechst kuemmerliches Sauergras, das der Ernaehrung einer"
    " Schafherde dient.");
  AddDetail( ({"schaf", "schafe", "herde", "schafherde"}),
    "Im " + capitalize(ED3) + " weidet eine Schafherde, die von einem"
    " Schaefer mit seinen Schaeferhunden bewacht wird.");
  AddDetail( ({"schaefer", "hirte", "schafhirte"}),
    "Der Schaefer steht am anderen Ende der Hochflaeche auf seinen Stab"
    " gestuetzt, ein Schaeferhund liegt zu seinen Fuessen. Er scheint in"
    " einen weiten Mantel gehuellt zu sein, aber so genau kannst Du das"
    " aus der Ferne nicht erkennen.");
  AddDetail( ({"stab", "hirtenstab"}),
    "Du erkennst die typische Form eines Hirtenstabs bereits aus der"
    " Ferne: mehr als mannshoch, ist er am oberen Ende charakteristisch"
    " gebogen. Um genaueres zu erfahren, solltest Du einmal den Schaefer"
    " besuchen.");
  AddDetail( ({"hund", "hunde", "schaeferhund", "schaeferhunde"}),
    "Die meisten der aussergewoehnlich kraeftigen Schaeferhunde springen"
    " staendig um die Herde und draengen Ausreisser zurueck von den"
    " gefaehrlichen Stellen im Gelaende. Ein besonders grosser Hund liegt"
    " zu Fuessen des Schaefers.");
  AddDetail( "ausreisser",
    "Immer wieder versucht ein vorwitziges Schaf, an die besonders"
    " saftigen Graeser nahe der das Gelaende durchziehenden Kluefte zu"
    " gelangen, wird aber immer rechtzeitig von einem Schaeferhund zurueck"
    " auf sicheren Boden getrieben.");
  AddDetail( ({"gelaende", "kluft", "kluefte", "boden"}),
    "Den weichen Sandstein durchziehen hier tiefe, kaum wenige Meter"
    " breite Kluefte, an deren Grund das Wasser rauscht.");
  AddDetail( ({"stein", "sandstein", "sand", "erosion"}),
    "Da Sandstein so weich ist, bilden sich durch die Erosion auch schnell "
    "tiefe Kluefte.");
  AddDetail( ({"wasser", "grund"}),
    "Sowas siehst Du nicht, die Kluft ist viel zu tief, und schon nach"
    " wenigen Metern verschwimmt alles in tiefem Dunkel da unten.");
  AddDetail( ({"schild", "warnschild", "kante", "maennchen", "piktogramm"}),
    "Ein schwarz-gelbes Warnschild, auf dem ein Maennchen ueber eine"
    " Kante in eine Kluft faellt. Unter dem Piktogramm steht etwas"
    " geschrieben.");
  AddReadDetail( ({"schild", "warnschild"}),
    "        .\n"
    "       / \\\n"
    "      /   \\\n"
    "     / \\O  \\\n"
    "    / _/-   \\\n"
    "   / / |_    \\\n"
    "  / ##     ## \\\n"
    " / ###~~~~~### \\\n"
    "+---------------+\n"
    "| ABSTURZGEFAHR |\n"
    "+---------------+\n" );
  AddSound(DEFAULT_SOUND,
    "In tiefen Klueften rauscht Wasser, hin und wieder bloekt ein Schaf,"
    " und die Schaeferhunde klaeffen ab und zu.");

  AddDetail( ({"goetter", "script", "ecke", "trommelfell", "dort", "keine",
      "ohren", "ecken", "laden", "metern", "sachen", "ferne", "fuessen", 
      "stellen", "dunkel", "schaefers", "immer", "hirtenstabs"}),
    "PASS BESSER AUF, DIE SINNLOSEN SACHEN SOLLTEST DU NICHT UNTERSUCHEN!");
  AddSpecialDetail( ({ "pass", "besser", "auf", "sinnlosen", "solltest",
      "nicht", "untersuchen", "ein", "versehen", "kugelblitz",
      "nase", "oberkoerper", "ohrfeige", "eieiei", "ueber", "hier", "im",
       "sowas", "oho", "mit", "entsetzlich", "eigentlich",
      "auauaua", "patsch", "ohgott", "sowas", "versengt", "und", "tut",
      "das", "weh", "erhaeltst", "eine", "mentale", "tat", "stuerzt", "vom", 
      "trifft", "haargenau"}),
   "NoScript");

  AddCmd( ({"kletter", "klettere"}), "climb");
  AddCmd( ({"spring", "springe", "huepf", "huepfe"}), "jump");
  AddCmd( ({"seil", "seile"}), "glide");
}

int glide(string str) 
{
  write(BS("Spaeter einmal wirst Du Dich in die Kluft abseilen koennen..."
    " zur Zeit ist da aber noch eine Baustelle. Probiers spaeter einmal"
    " wieder, oki?"));
  return 1;
}

int jump(string str) 
{
  if ((str == "in kluft") || (str == "kluft") || (str == "")) 
  {
    write(BS("Willst Du wirklich in die Kluft springen? Die Syntax lautet "
      "dann 'springe in die kluft!' (Ausrufezeichen nicht vergessen!)"));
    return 1;
  }
  else if (str == "in die kluft!") 
  {
    write(BS("Zur Zeit kannst Du noch nicht in die Kluft springen -- wie"
      " bereits gesagt, hier ist noch Baustelle. Probiers doch spaeter"
      " einmal wieder, oki?"));
    return 1;
  }
  else if ((str == "ueber kluft") || (str == "ueber die kluft")) 
  {
    write("Du nimmst Anlauf und springst mutig ueber die Kluft.\n");
    TP->move( ROOM "0407", M_GO, "ueber die Kluft", "springt",
        "kommt ueber die Kluft gesprungen");
    return 1;
  }
  notify_fail("Wohin willst Du denn springen?\n");
  return 0;
} // int jump()

int climb(string str) 
{
  if (str == "grat" || str == "hoch" || str == "auf grat" ||
      str == ("nach "+ ED7) || str == ED7) 
  {
    TP->move(ROOM "0107.lpc", M_GO, CAP(ED7), "klettert auf den Grat im",
                      "kommt heraufgeklettert");
      return 1;
  }
  else if (str == "kluft" || str == "in kluft") 
  {
    write(BS("Die Waende der Kluft sind nass und glitschig, zudem waechst"
      " feuchtes Gras auf jedem Tritt. Ohne Seil kommst Du hier wohl nicht"
      " runter.\n"));
    say(BS(TPN+ " versucht, in eine der Kluefte zu klettern, aber kehrt nach"
      " kurzer Zeit wieder um."));
    return 1;
  }
  notify_fail("Wohin willst Du denn klettern?\n");
  return 0;
} // int climb()

