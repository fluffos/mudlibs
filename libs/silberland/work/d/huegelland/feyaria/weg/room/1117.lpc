#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./hang.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_HANG;
  SetProp(P_INT_LONG,
    BS("Der Pfad windet sich einen endlosen Geroellhang empor; hier ist eine"
      " der Serpentinen, die einen Augenblick zum Verweilen einladen. Das"
      " Buschwerk ringsum ist so hoch, dass es die Aussicht vollstaendig"
      " versperrt."));
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:8, ENV_TERRAIN: TT_MOUNTAIN]));

  CD_HANG;

  AddDetail( ({"serpentine", "serpentinen", "platz", "wendeplatz"}),
    "Mit viel Geschick wurde hier ein Wendeplatz angelegt, von dem der"
    " Weg nach " + CAP(ED8) + " nach oben und im " + CAP(ED7) +
    " abwaerts weiterfuehrt.");
  AddDetail( ({"buschwerk", "busch", "buesche"}),
    "Auf dem Geroellboden koennen sich keine Baeume halten, nur"
    " verfilztes Buschwerk gedeiht hier in Huelle und Fuelle.");
  AddDetail( ({"baeume", "baum", "wald"}),
    "Baeume gibt es erst wieder im tiefer gelegenen Wald, wo es etwas "
    "waermer ist.");
  AddDetail( ({"pfad", "weg", "boden", "pass"}),
    "Zwischen dem Geroell windet sich der Weg weiter nach oben auf den"
    " Pass zu.");
  AddDetail( ({"huelle", "fuelle"}),
    "Das war doch nur eine figurative Redewendung. Also vergiss es.");
  AddDetail( ({"redewendung", "no", "comment", "no comment"}),
    "no comment!");
  AddDetail( ({"aussicht"}),
    "Die Aussicht ist vom Buschwerk versperrt.");

  SetProp(P_HIDE_EXITS, ({ ED7, ED8}) );
  AddExit( ({ED7, ED7U}), "nach "+CAP(ED7U)+"#./1017.lpc" );
  AddExit( ({ED8, ED8OB}), "nach "+CAP(ED8OB)+"#./1016.lpc" );
}
