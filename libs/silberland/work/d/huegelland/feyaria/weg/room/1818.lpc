#pragma strong_types

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./strand.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_STRAND;
  SetProp(P_INT_LONG,
    BS("Der Weg verlaeuft oberhalb des Strandes. Im " + CAP(ED8) + 
      " breitet sich ein Moor aus, hinter dem ein Bergriese liegt. Leise"
      " wogt das Meer in der Bucht im " + CAP(ED6) + ". Jenseits der Bucht"
      " steht ein Berg, dessen Felsen kahl in der Sonne leuchten. Im " +
      CAP(ED4) + " waechst ein lichter Wald auf den Huegeln. Nach "+CAP(ED7)+
      " fuehrt ein Weg die Kueste entlang, im "+ CAP(ED5)+" befindet sich ein "
      "kleiner Steg.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN:TT_HILL]));

  CD_STRAND;

  AddDetail( ({"steg" }),
    "Der Steg befindet sich im "+CAP(ED5)+". Sicher fahren von dort Schiffe "
    "ab.");
  AddDetail( ({"schiff", "schiffe"}),
    "Hier kannst Du noch kein Schiff sehen. Aber vielleicht wirst Du auf dem "
    "Steg fuendig.");
  AddDetail( ({"wald", "huegel"}),
    "Der lichte Wald auf den Huegeln scheint der ideale Siedlungsplatz "
    "fuer Hobbits zu sein. Vielleicht befindet sich dort ja " N_STADT", "
    "die Stadt der Hobbits.");
  AddDetail( ({"fels", "felsen"}),
    "Du siehst den Gipfel nur aus der Ferne, Du kannst ausser kahlen"
    " Felsen dort nichts erkennen.");
  AddDetail( ({"moor", "fluss"}),
    "Das Moor entlang des Flusses sieht voellig undurchdringlich aus.");
  AddDetail( ({"wind", "brise"}),
    "Wie so oft an der See weht hier eine staendige Brise, mal landein,"
    " mal landab.");
  AddDetail( ({"berg", "kuestenberg", "bergriese"}),
    "Im " + CAP(ED1) + " steht ein wahrer Bergriese, mit weiss"
    " leuchtenden Schneefeldern unterhalb des Gipfels. Dagegen sieht der"
    " Kuestenberg mit zwei Gipfeln im " + CAP(ED8) + " fast armselig aus,"
    " aber auch dieser ist sehr hoch, man sagt, noch niemand habe ihn"
    " bestiegen.");
  AddDetail( ({"schnee", "schneefeld", "schneefelder", "gipfel"}),
    "Vielleicht solltest Du da etwas naeher rangehen, um Einzelheiten zu"
    " erkennen.");

  AddExit(ED1, WESTWEG_HOBBINGEN );
  AddExit(ED7, "./1717" );
  AddExit(ED5, "./steg");
}

