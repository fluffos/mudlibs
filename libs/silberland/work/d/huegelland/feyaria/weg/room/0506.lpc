#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./weide.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_WEIDE;
  SetProp(P_INT_LONG, BS(
    "Du stehst auf einer Hochflaeche, die leicht nach " + CAP(ED3) + 
    " abfaellt. Obwohl das Gras hier sehr spaerlich ist, weiden hier viele "
    "Schafe, die von einem Schaefer und seinem Hund bewacht werden. Weit im "
    + CAP(ED3) +" spiegelt sich der " N_BERG " im " N_SEE ". Im "+ CAP(ED1) +
    " steigt das Gelaende steil an.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:9, ENV_TERRAIN:TT_HILL]));

  CD_BERG_WEIT;
  CD_SEE_WEIT;
  WEIDE;
  AddDetail( ({"gelaende"}),
    "Im "+ CAP(ED7) +" dahinter wird das Gelaende etwas huegeliger. Im "+
    CAP(ED3) +" liegt der " N_BERG " und davor der " N_SEE ". Im "+ CAP(ED1)
     +" steigt das Gelaende steil an.");

  AddItem( NPC "schaf", REFRESH_DESTRUCT);

  AddExit(ED4, "./0606.lpc" );
  AddExit(ED6, "./0507.lpc" );
  AddExit(ED7, "./0406.lpc" );
}
