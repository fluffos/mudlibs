#pragma strong_types

#include <properties.h>
#include <wizlevels.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

int blume;

void create()
{
  ::create();

  blume = random(3);
  P_INT_SHORT_WALDWEG;
  SetProp(P_INT_LONG,
    BS("Der Nadelwald ist hier sehr licht, fast nur noch Kiefern wachsen"
      " hier in dieser Hoehe. Alle Baeume haben seltsam verdrehte Zweige,"
      " und erreichen bei weitem nicht dieselbe Groesse wie unten im Tal."));
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_TERRAIN:TT_HILL]));

  CD_NADELWALD;
  CD_WALDWEG;
  CD_WALDBODEN;

  AddDetail( ({"kiefer", "kiefern", "baum", "baeume", 
               "musterexemplare", "muster", "exemplare", "groesse"}),
    "Die Kiefern hier sind durch das kalte Klima und die staendig"
    " blasenden Winde im Wachstum stark gegenueber den Musterexemplaren"
    " im Tal benachteiligt.");
  AddDetail( ({"klima", "wind", "winde", "wachstum"}),
    "Das kalte Klima und die staendig blasenden Winde benachteiligen das "
   "Wachstum der Kiefern."); 
  AddDetail( ({"wald", "nadelwald"}),
    "Hier wachsen nur noch verkrueppelte Kiefern, deren Aeste in"
    " seltsamen Windungen entlang des Bodens wachsen. Sie erreichen bei"
    " weitem nicht die Hoehe wie die Kiefern im Tal.");
  AddDetail( ({"hoehe"}),
    "Waehrend man bei den Kiefern selbst nicht von Hoehe sprechen kann,"
    " kann man es schon von diesem Weg: Du befindest Dich weit oben ueber"
    " dem Tal, das weit weg gruen in der Tiefe schimmert.");
  AddDetail( ({"zweig", "zweige"}),
    "Seltsam verdreht wachsen die Zweige der Kiefern entlang des Bodens,"
    " einen Stamm haben sie --wenn ueberhaupt-- nur entlang des Bodens,"
    " nicht nach oben wachsend.");
  AddDetail( ({"klima", "wetter", "sonne", "himmel", "wolke", "wolken",
               "woelkchen", "sonnenschein"}),
    "Obwohl die Sonne vom Himmel brennt und kaum ein Woelkchen den"
    " Sonnenschein truebt, ist es in dieser Hoehe ziemlich windig und"
    " unangenehm kuehl.");
  AddDetail( ({"wind", "winde"}),
    "Staendig blaest hier ein kuehler Wind, der zur Zeit zwar noch"
    " ertraeglich ist, aber bei schlechterem Wetter wohl oft Sturmstaerke"
    " erreicht.");
  AddDetail( ({"staerke", "sturm", "sturmstaerke"}),
    "Sturmstaerke erreicht der Wind nur bei sehr schlechtem Wetter.");  
  AddDetail( ({"weg", "pfad", "boden"}),
    "Der Boden ist hier steinig und karg, der Weg fuehrt streckenweise"
    " ueber den blanken Fels. Kaum eine Pflanze kann sich hier halten, nur"
    " die Krueppelkiefern und mageres, winterhartes Gras gedeihen hier.");
  AddDetail( ({"tal", "wiese", "tiefe"}),
    "Weit entfernt schimmert eine saftiggruene Wiese tief unten im Tal."
    " Kein Vergleich zu den kargen Kiefern und dem bisschen Gras, das hier"
    " waechst.");
  AddDetail( ({"vergleich", "intelligenz", "script"}),
    "Vergleichen wir einmal Deine Intelligenz mit einem"
    " durchschnittlichen Script, ja? Wenn Du nicht bestehst, kann's sehr"
    " schmerzhaft werden.");
  AddDetail( ({"gras", "grasbueschel", "mutterboden"}),
    "In jedem Spalt, in jedem Felsriss, in dem sich ein wenig Mutterboden"
    " angesammelt hat, wachsen hier karge Grasbueschel, Blumen und einige"
    " Edelweiss.");
  AddDetail( ({"edelweiss"}),
    "Zu schade, dass die Edelweiss hier nicht bluehen... die Blueten"
    " sollen angeblich glueckbringend sein.");
  AddDetail( ({"spalt", "spalten", "riss", "risse", "felsriss", "fels"}),
    "Nur in den Spalten und Rissen im Fels konnte sich ein wenig"
    " Mutterboden halten, der vollstaendig vom kargen Gras und ein paar"
    " Blumen genutzt wird.");
  AddDetail( ({"blume", "blumen", "pflanze", "pflanzen"}),
    "Du siehst hier nur wenige Blumen, nur ein paar Veilchen"
    " bluehen gerade.");
  AddDetail( ({"dustyveilchen", "huebsch", "veilchen"}),
    "Huebsch blueht ein Veilchen gerade vor Deinen Fuessen.");
  AddDetail( ({"fuss", "fuesse"}),
    "Iiiiihhhh... Du solltest Deine Fuesse mal wieder waschen!");
  AddSpecialDetail( ({
     "hier", "sie", "waehrend", "seltsam", "obwohl", "bodens",
     "kaum", "weit", "kein", "wenn", "in", "zu", "nur", 
     "iiiiihhhh", "eine", "goettliche", "strafe", "trifft", "unvorbereitet",
     "ist", "fer", "untersuch", "faulheit", "jetzt", "wirst", "fuer", 
     "gier", "nach", "forscherpunkten", "bestraft" }),
   "NoScript");

  AddSound( DEFAULT_SOUND,
    "Hier ist es angenehm ruhig.");
  AddSmell( ({DEFAULT_SMELL, "duft", "kiefer", "kiefern"}),
    "Der wuerzige Duft der Kiefern weht in Deine Nase.");

  AddCmd( ({"pflueck", "pfluecke"}), "pfluecken");

  AddExit(ED4, "./0616.lpc" );
  AddExit(ED7, "./0415.lpc" );
}

int pfluecken(string str)
{ 
  notify_fail("Was willst Du pfluecken?\n");
  if( !str ) return 0;
  if ( str=="blume" || str=="blumen" || str=="bluete" || str=="blueten" ||
       str=="bluemchen")
  {
    notify_fail("Was fuer eine Blume willst Du pfluecken?\n");
    return 0;
  }
  if( str=="edelweiss" )
  {
    notify_fail("Leider ist hier kein Edelweiss. :(\n");
    return 0;
  }
  if( str=="dustyveilchen" || str=="veilchen" )
  {
    if(blume)
    {
      write( "Du pflueckst ein Veilchen.\n");
      say( CAP(TPN)+ " pflueckt ein kleines Bluemchen.\n");
      CLONE( OBJ "blume", TP);
      blume--;
      return 1;
    }
    notify_fail("Leider hat gerade jemand das Veilchen gepflueckt.\n");
    return 0;
  }
  return 0;
}

void reset()
{
  ::reset();
  blume=random(3);
}

