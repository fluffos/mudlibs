#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./pass.h"
#include "./hang.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_PASS;
  SetProp(P_INT_LONG, BS(
    "Du hast fast die Passhoehe im " + CAP(ED7) + " erreicht. Der Pfad "
    "windet sich nach " +CAP(ED4)+ " ueber einen Geroellhang hinunter. "
    "Hier oben wachsen keine Baeume mehr, deshalb hast Du eine wunderbare "
    "Aussicht.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:7, ENV_TERRAIN: TT_MOUNTAIN]));

  CD_PASS;
  CD_HANG;

  AddDetail( ({"pass", "passhoehe"}),
    "Im " + capitalize(ED7) + " liegt eine Passhoehe, ueber die der Wind"
    " pfeift. Trotz des schoenen Wetters ist es hier oben recht kuehl.");
  AddDetail( ({"wind", "wetter", "sonne"}),
    "Zwar scheint die Sonne angenehm warm, aber hier oben blaest ein"
    " kuehler Wind.");
  AddDetail( ({"aussicht"}),
    "Im " + CAP(ED4) + " glaenzt eine Meeresbucht in der Ferne, in die"
    " sich im " + CAP(ED3) + " ein Fluesschen ergiesst. Du stehst auf"
    " einer Passhoehe fast genau zwischen zwei unnahbaren Gipfeln im "
    + CAP(ED2) + " und " + CAP(ED6) + ". Der Weg fuehrt nach " + CAP(ED7)
    + " weiter in den Pass hinein und nach " + CAP(ED4) + " auf einem"
    " buschbewachsenen Hang steil bergab.");
  AddDetail( ({"meer", "bucht", "meeresbucht", "fluss", "fluesschen",
               "gipfel", "details", "detail", "dunst"}),
    "Das ist so weit weg, dass die Details im Dunst verschwimmen.");

  SetProp(P_HIDE_EXITS, ({ED7, ED4}) );
  AddExit( ({ED4, ED4U}), "nach "+CAP(ED4U)+"#./1117.lpc" );
  AddExit( ({ED7, ED7OB}), "nach "+CAP(ED7OB)+"#./0916.lpc" );
}
