#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./huegel2.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_HUEGEL;
  SetProp(P_INT_LONG,
    BS("Der Weg fuehrt bergauf und bergab durch eine huebsche"
      " Huegellandschaft. Du siehst einen bewaldeten Berg nah im " +
      CAP(ED8) + ", der mit zwei Gipfeln weithin sichtbar ist. Im " +
      CAP(ED3) + " uebersiehst Du eine grosse Tiefebene, in der ein"
      " Fluesschen traege im Sonnenlicht maeandriert. Der Bach muendet in"
      " die grosse Meeresbucht im " + CAP(ED4) + ".") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_HILL]));

  CD_HUEGEL;
  CD_HUEGEL2;

  AddDetail( ({"landschaft", "huegelllandschaft", "huegel"}),
    QueryProp(P_INT_LONG) );
  AddDetail( ({"ebene", "tiefebene", "bach", "baechlein", "fluss",
               "fluesschen"}),
    "Im " + CAP(ED3) + " liegt eine Tiefebene im Dunst unter Dir, durch"
    " die sich traege ein kleines Fluesschen schlaengelt. Du erkennst"
    " einen weiten, weissen Strand am Rand der Meeresbucht im " + 
    CAP(ED4) + ", in die das Baechlein muendet.");
  AddDetail( ({"strand", "sandstrand", "rand"}),
    "Die Ebene wird durch einen schmalen, weissen Sandstrand vom Meer"
    " getrennt, den Du undeutlich durch den Dunst erkennst.");
  AddDetail("berg",
    "Ganz nah vor Dir ueberragt ein riesiger Berg mit zwei Gipfeln die"
    " Landschaft. Die unteren Regionen sind bewaldet, weiter oben glaenzen"
    " kahle Felswaende in der Sonne.");
  AddDetail( ({"gipfel", "felswand", "felswaende"}),
    "Hoch ueber Dir glaenzen die steilen Felswaende in der waermenden"
    " Sonne. Darunter breiten sich Geroellfelder und Buschwerk aus.");
  AddDetail( ({"geroellfeld", "geroellfelder", "buschwerk", "busch",
               "buesche"}),
    "Vielleicht solltest Du naeher hingehen, um mehr zu sehen.");
  AddDetail( ({"wald", "baeume", "hang", "haenge"}),
    "Die Haenge des im " + CAP(ED8) + " liegenden Berges sind im unteren"
    " Bereich bewaldet.");
  AddDetail( ({"licht", "sonnenlicht"}),
    "Waermend scheint die Sonne vom Himmel, es ist hier fast angenehm..."
    " nur noch ein wenig feucht vom letzten Regen, der wohl auch fuer den"
    " Dunst ueber den Wiesen gesorgt hat.");
  AddDetail( ({"bucht", "meer", "meeresbucht"}),
    "Ueber der Bucht liegt Dunst vom letzten Regen. Die Sonne scheint und"
    " laesst die wunderbarsten Farben ueber dem Meer spielen.");
  AddDetail( ({"farben", "anblick"}),
    "Die Sonne laesst die wunderbarsten Farben ueber dem Meer spielen. "
    "Fast alle Farben des Regenbogens sind vorhanden.");
  AddDetail( ({"regenbogen"}),
    "Du siehst nur die Farben des Regenbogens im Meer glitzern.");
  AddDetail( ({"regenbogenfarben"}),
    "Das Meer glitzert in allen Farben des Regenbogens. Ein wirklich "
    "wunderbarer Anblick.");
  AddDetail( ({"regen", "dunst"}),
    "Der letzte Regen ist schon ein Weilchen her, aber noch haengt der"
    " Dunst in der Luft.");
  AddDetail( ({"weile", "weilchen"}),
    "Oh Augenblick, verweile doch, du bist soooo schoen.");
  AddDetail( ({"augenblick"}),
    "Und schon ist wieder ein Augenblick vorbei.");
  AddDetail( ({"luft", "duft"}),
    "Die Luft ist schwuel nach dem letzten Regen, der Duft des Meers"
    " mischt sich hier mit dem der Wiese.");
  AddDetail( ({"sonne", "wetter", "himmel", "wolke", "wolken"}),
    "Am Himmel scheint die Sonne, ein paar Wolken treiben vorueber. Nach"
    " einem kurzen Regen liegt ein schwueler Dunst in der Luft.");

  AddSmell( ({DEFAULT_SMELL, "duft", "luft"}),
    "Die Luft ist schwuel nach dem letzten Regen, der Duft des Meers "
    "mischt sich hier mit dem der Wiese.");
  AddSmell( ({"meer"}),
    "Auch aus dieser weiten Entfernung riecht man den Duft des Meeres.");
  AddSmell( ({"wiese"}),
    "Die Wiese duftet leicht wuerzig.");

  AddExit(ED3, "./1317.lpc" );
  AddExit(ED6, "./1118.lpc" );
}
