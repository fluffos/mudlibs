#pragma strong_types

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <wizlevels.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./schlucht.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN:TT_HILL]));
  P_INT_SHORT_SCHLUCHTPFAD;
  SetProp(P_INT_LONG,
    BS("Schon einige Minuten nachdem Du den Pfad betreten hast, kommst Du an"
    " die erste Spitzkehre. Hier fuehrt der Weg nach " + capitalize(ED6) +
    " und " + capitalize(ED3) + ". Es ist gerade genug Platz, um einen"
    " Haendlerkarren zu wenden. Nicht auszudenken, was passieren wuerde,"
    " wenn er in den Abgrund neben Dir stuerzen wuerde.") );

  CD_SCHLUCHTPFAD;

  AddDetail( ({"minuten", "zeit"}),
    "Die Zeit vergeht...");
  AddDetail( ({"weg", "pfad", "kehre", "spitzkehre"}),
    "Der Weg macht hier eine Spitzkehre, die gerade genug Platz bietet, "
    "um einen Ochsenkarren zu wenden.");
  AddDetail( ({"abgrund", "karren", "haendlerkarren", "haendler",
               "ochsenkarren"}),
    "Du schaust vorsichtig in den Abgrund und entdeckst einen "
    "zerschmetterten Karren; daneben liegt ein Ochsenskelett halb "
    "vergraben in einer Geroellawine. Du meinst zwischen den "
    "Ochsenknochen auch noch einen humanoiden Schaedel zu erkennen.");
  AddDetail( ({"geroelllawine", "geroellawine", "lawine", "mure",
               "geroelllawinen", "geroellawinen", "lawinen", "muren"}),
    "Tief unten im Abgrund neben Dir siehst Du die Ueberreste vieler "
    "Muren (so nennt man Geroellawinen auch): In einem riesigen "
    "Geroellfeld verbleichen die Knochen einiger Ochsen; ein paar "
    "zerschmetterte Raeder sind trotz der Entfernung gerade noch zu "
    "erkennen.");
  AddDetail( ({"rad", "raeder"}),
    "Tief unter Dir liegen ein paar zerschmetterte Raeder im Abgrund.");
  AddDetail( ({"geroell", "geroellfeld"}),
    "Am Fuss des Abgrunds tief unter Dir haben sich die Ueberreste "
    "hunderter Muren in einem riesigen Geroellfeld gesammelt.");
  AddDetail( ({"reste", "ueberreste"}),
    "Ein riesiges Geroellfeld tief unter Dir ist das einzige, was von "
    "hunderten von Muren uebrig blieb.");
  AddDetail( ({"skelett", "knochen", "ochse", "ochsen", "ochsenskelett",
               "schaedel", "ochsenknochen"}),
    "Die einzigen, die Du findest, liegen zerschmettert im Abgrund.");

  AddCmd( ({"ruf", "rufe"}), "rufen");

  SetProp(P_HIDE_EXITS, ({ ED6, ED3}) );
  AddExit( ({ED6, ED6U}), "nach "+CAP(ED6U)+"#./0210.lpc" );
  AddExit( ({ED3, ED3OB}), "nach "+CAP(ED3OB)+"#./0209.lpc" );
}

int rufen(string str) 
{
  object *helm;
  int chars;

  if (str == "hilfe" || str == "um hilfe") 
  {
    write("Du rufst um Hilfe und die Bergwacht rettet Dich aus der "
             "drohenden Geroellawine.\n");
    TP->reduce_hit_point(2*TP->QueryProp(P_LEVEL) );
    TP->move(ROOM "huette2", M_GO, "", "wird von der Bergwacht gerettet",
             "wird von der Bergwacht hereingetragen");
    return 1;
  }
  chars=strlen(str)/2;
  if (chars<4) chars=4;
  if(!IS_SEER(this_player()))  // Seher++ duerfen kostenfrei rufen
  {
    if (TP->QueryProp(P_SP) <(chars+20)) 
    {
      write("Du must erst wieder magische Kraefte sammeln.\n");
      write("Tip: Benutz doch mal die Kanaele (Hilfe dazu mit 'hilfe kanaele').\n");
      return 1;
    }
    TP->restore_spell_points(- chars - 20);
  }
  domainshout(TPN+ " ruft: "+ str+"....*RUMMPEL...KRACH...RUMMS*\n");
  write("Durch Dein Rufen loest Du eine Geroellawine aus.\n");
  say( TPN + " loest durch " + TPPP(NEUTER, WEN, SINGULAR) + " Rufen eine "
       "Geroellawine aus.\n");
  SetProp(P_KILL_NAME, "Eine Geroellawine");
  helm=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_HELMET); 
  if( sizeof(helm) && objectp(helm[0]) )
  {
    if( helm[0]->QueryProp(P_NAME)=="Kletterhelm" )
    {
      write("Zum Deinem Glueck traegst Du einen Kletterhelm.\n");
    }
    else
    {
      write("Dein Helm beschuetzt Deinen Kopf gegen den Steinschlag.\n");
      TP->do_damage( 10+random(60)-helm[0]->QueryProp(P_AC)*3 );
    }
  }
  else
  {
    write("Aua! Die Steine prasseln auf Deinen ungeschuetzten Kopf.\n");
    TP->do_damage( 10+random(60) );
  }  
  return 1;
} 
