// /d/gebirge/feyaria/weg/room/adlernest.c
// 1997-11-26  Feyaria@SilberLand

#pragma strong_types

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT,"In einem Adlerhorst");
  SetProp(P_INT_LONG, 
    "Du stehst in einem riesigen Adlerhorst mitten auf einem hohen Berggipfel. "
    "Im Sueden befindet sich ein zweiter Berggipfel, der aber von Wolken "
    "umhuellt ist. Unter Dir windet sich der Bergpfad zwischen den beiden "
    "Gipfel ueber die Passhoehe.");
  SetProp(P_INDOORS,1); 
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:5, ENV_TERRAIN: TT_MOUNTAIN]));
  SetProp(P_LIGHT,1);

  AddDetail( ({"fels", "felsen"}),
    "Die Felsen bestehen aus einem ganz besonderen Gestein.");
  AddSpecialDetail( ({"gestein", "stein", "steine", "energie"}),
      "stein");
  AddDetail( ({"wolken", "wolke"}),
    "Wolken huellen den suedlichen Berggipfel ein.");
  AddDetail( ({"pass", "passhoehe"}),
    "Die Passhoehe liegt weit unter Dir zwischen den beiden Gipfeln.");
  AddDetail( ({"pfad", "bergpfad"}),
    "Der Bergpfad windet sich unter Dir zwischen den beiden "
    "Gipfel ueber die Passhoehe.");
  AddDetail( ({"horst", "adlerhorst"}),
    "Dieser Adlerhorst ist riesengross, viel groesser als ein normaler "
    "Adlerhorst eigentlich sein sollte. Wie gross da wohl erst die Adler "
    "sein moegen, die hier leben. Der Horst ist ganz weich mit Federn und "
    "Zweigen ausgepolstert, damit es die Adlerkueken schoen warm haben."); 
  AddDetail( ({"adlerkueken", "kueken"}),
    "Der Groesse des Horstes nach sind die Adlerkueken, die hier "
    "ausgebruetet werden, sicher so gross wie Du selber.");
  AddDetail( ({"groesse"}),
    "Der Horst ist wirklich ein sehr grosser Adlerhorst.");
  AddDetail( ({"boden"}),
    "Der Boden des Horstes besteht aus weichen Federn und Zweigen.");
  AddDetail( ({"wand", "waende"}),
    "Die Wand des Horstes besteht aus weichen Federn und Zweigen.");
  AddDetail( ({"feder", "federn"}),
    "Die Federn sind fast alles Flaumfedern der Adler und deshalb sehr "
    "weich.");
  AddDetail( ({"flaumfeder", "flaumfedern"}),
    "Flaumfedern sind ganz weiche Federn.");
  AddDetail( ({"zweig", "zweige"}),
    "Die Zweige halten den Horst zusammen.");
  AddDetail( ({"gipfel", "berggipfel"}),
    "Der Adlerhorst ist auf einem hohen Berggipfel gebaut, damit die Adler "
    "von dort gleich gut losfliegen koennen.");
  AddDetail( ({"berg"}),
    "Du bist auf dem Gipfel von diesem Berg.");
  AddDetail( ({"decke", "himmel"}),
    "Der Himmel bildet die Decke.");
  AddDetail( ({"wind"}),
    "Der Wind pfeift hier oben sehr stark.");

  AddSound(DEFAULT_SOUND,
    "Das Pfeifen des Windes wird noch uebertoent vom Kreischen des Adlers"
    " ueber Dir.");
  AddSound( ({"wind", "pfeifen"}),
    "Der Wind pfeift.");
  AddSound( ({"adler", "kreischen"}),
    "Kiiiiiiiaaaaaaaaaa...... kiiiiiiiaaaaaaa.......");
  AddSmell( ({DEFAULT_SMELL}),
    "Es riecht nach Adlern.");
  AddSmell( ({"adler", "adlergeruch"}),
    "Dir steigt ein intensiver Adlergeruch in die Nase.");
 
  AddItem( NPC "adlerkuecken", REFRESH_DESTRUCT);
  AddItem( NPC "adlerkuecken", REFRESH_DESTRUCT);
  AddItem( NPC "adlerkuecken", REFRESH_DESTRUCT);
  AddItem( NPC "riesenadler", REFRESH_DESTRUCT);
  
  AddExit("runter", "./0916" );
}

string stein()
{
  if(IS_SEER(TP) && !present("\ndrachenquest",TP) && 
      !present("\ndrachenstein",TP))
  {
    write("Du nimmst Dir einen kleinen Stein mit. Sicher kannst Du ihn "
        "brauchen.\n");
    CLONE("/d/gebirge/feyaria/drachen/obj/steinbrocken", TP);
  }
   return "Du spuerst, dass die Steine hier von magischer Energie durchdrungen "
    "sind.\n";
}

