#pragma strong_types

#include <properties.h>
#include <moving.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT,"Ein schmaler Waldpfad");
  SetProp(P_INT_LONG, BS(
    "Du befindest Dich auf einem schmalen Waldpfad, der im "+ CAP(ED3) +
    " auf einen breiteren Weg einmuendet. Die Tannen neben dem Pfad stehen "
    "so dicht, dass ihre Zweige fast ein Dach ueber dem Pfad bilden. Das "
    "Unterholz neben dem Pfad verhindert das Verlassen des Pfades.") );
  SetProp(P_INDOORS,1); // nur damit der Karren hier nicht herfaehrt!
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:13, ENV_TERRAIN: TT_FOREST]));
  SetProp(P_LIGHT,1);
 
  CD_NADELWALD;
  CD_WALDPFAD;
  CD_WALDBODEN;

  AddDetail( ({"dach"}),
    "Die Zweige der Tannen bilden fast ein richtiges Dach ueber dem Pfad.");

  AddDetail("unterholz", 
    "Das Unterholz besteht aus dichten Bueschen und Gewaechsen, sodass ein "
    "Vorankommen hier fast unmoeglich erscheint.");

  AddDetail( ({"vorankommen", "durchkommen"}),
    "Das scheint hier im Unterholz fast unmoeglich zu sein. Nur ein einziger "
    "Busch schaut nicht so dicht aus.");

  AddDetail( ({"buesche", "gewaechse" }), 
    "Die Buesche bilden ein dichtes Unterholz. Einige Dornengewaechse wuerden "
    "das Durchkommen auch nicht gerade erleichtern.");
 
  AddDetail( ({"dorn", "dornen"}),
    "Die Dornen sind sehr spitz.");

  AddDetail(({"dornengewaechse", "dornengewaechs", "dorngewaechs"}),
    "Die Dornengewaechse sind zum Teil mit den anderen Bueschen zu einem "
    "dichten Unterholz verwachsen. An einem Busch faellt Dir eine kleiner "
    "Durchlass im Unterholz auf.");

  AddDetail("busch", 
    "An einem Busch faellt Dir ein kleiner Durchlass auf.");

  AddDetail("durchlass", 
    "Du koenntest Dich durchzwaengen.");

  AddCmd(({"zwaeng", "zwaenge"}), "durchschlupf");

  AddExit(ED3, "./0313" );
  AddExit(ED8, "./wald2" );
}

int durchschlupf(string str)
{
  notify_fail("Wo moechtest Du Dich hindurchzwaengen?\n");
  if(!str) return 0;
  if(str!="durch durchlass" && str!="durch busch") return 0;
  TP->move( WESTWEG_DRUIDEN, M_GO, "das Unterholz", "zwaengt sich durch",
     "klettert aus dem Unterholz heraus");
  return 1;
}
