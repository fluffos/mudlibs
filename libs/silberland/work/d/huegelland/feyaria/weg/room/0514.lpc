#pragma strong_types

#include <properties.h>
#include <moving.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

int hirsch_da;
void hirsch_details();

void create()
{
  ::create();

  P_INT_SHORT_WALDWEG;
  SetProp(P_INT_LONG,
    "Der Waldweg fuehrt nach " + capitalize(ED7) + " steil bergauf, nach "
    + capitalize(ED3)+ " geht es ebenso steil bergab. "+ "@@hirsch_long@@" );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN: TT_FOREST]));
  
  CD_WALD;
  CD_WALDWEG;
  CD_WALDBODEN;

  AddDetail( ({"busch", "buesche", "gebuesch"}),
    "Die Buesche hier sind so dicht, dass man nicht sehen kann, was sich"
    " dahinter verbirgt.");
  AddSmell( ({DEFAULT_SMELL, "duft", "waldduft"}),
    "Du laesst den beruhigenden Waldduft in Deine Lungen einstroemen.");

  hirsch_details();
  
  AddCmd( ({"lock", "locke"}), "locken");

  SetProp(P_HIDE_EXITS, ({ ED7, ED3}) );
  AddExit( ({ED7, ED7OB}), "nach "+CAP(ED7OB)+"#./0414.lpc" );
  AddExit( ({ED3, ED3U}), "nach "+CAP(ED3U)+"#./0614.lpc" );
}

void reset()
{
  object ob;
  ::reset();
  if( ob=present("\nkronenhirsch") )
  {
    tell_room(TO, "Der Kronenhirsch springt ins Gebuesch davon.\n");
    ob->remove();
  }
  if( hirsch_da == 0 )  hirsch_details();
}

void hirsch_details()
{
  hirsch_da=1;
  AddSound( DEFAULT_SOUND,
    "Aus einem dichten Gebuesch kommt ein wetzendes Geraeusch.");
  AddSound( ({"wetzen", "geraeusch", "gebuesch"}),
    "Es klingt so, als wuerde ein Wesen etwas Hartes an einem Baumstamm "
    "wetzen.");
  AddDetail( "wesen",
    "Was das wohl fuer ein Wesen sein wird? Vielleicht kannst Du es ja "
    "aus dem Busch hervorlocken.");
  AddDetail( ({"hirsch", "kronenhirsch"}),
    "Gut kombiniert! Das Geraeusch koennte von einem Hirsch kommen, der "
    "sich gerade den Bast von seinem Geweih abwetzt.");
  AddSound( "wesen",
    "Das Wesen, das diese wetzenden Geraeusche verursacht, scheint sehr "
    "gross zu sein.");
}

string hirsch_long()
{
 if( hirsch_da) 
   return "Aus einem dichten Gebuesch kommt ein wetzendes Geraeusch.";
 else
   return "Neben dem Weg steht ein dichtes Gebuesch.";
}


int locken(string str)
{
  string wen, wen2, woraus;
  if( hirsch_da == 0 ) return 0;
  notify_fail("Wen willst Du hervorlocken?\n");
  if( !str ) return 0;
  if( sscanf( str, "%s aus %s hervor", wen, woraus)==2 ||
      sscanf( str, "%s hervor", wen2)==1 )
  {
    if( member( ({"wesen", "hirsch", "kronenhirsch"}),wen)!=-1 &&
        member( ({"busch", "bueschen", "gebuesch"}),woraus)!=-1 )
    {
      if(present("\nkronenhirsch") )
      {
        notify_fail("Aber Der Hirsch steht doch schon vor Dir!\n");
        return 0;
      }
      write("Du lockst das Wesen aus dem Busch hervor.\n");
      hirsch_da=0;
      call_out("hirsch",2+random(3));
      return 1;
    }
    if( member( ({"wesen", "hirsch", "kronenhirsch"}),wen)!=-1 ||
        member( ({"wesen", "hirsch", "kronenhirsch"}),wen2)!=-1)
    {
      notify_fail("Woraus willst Du das Wesen hervorlocken?\n");
      return 0;
    }
    if( member( ({"busch", "bueschen", "gebuesch"}),woraus)!=-1 )
    {
      notify_fail("Wen willst Du aus dem Gebuesch hervorlocken?\n");
      return 0;
    }
  }
  return 0;
}

void hirsch()
{
  clone_object(NPC "khirsch")->move(TO, M_NOCHECK);  
  AddSound( DEFAULT_SOUND,
    "Es ist angenehm ruhig hier.");
  RemoveSound( ({"wetzen", "geraeusch", "gebuesch"}) );
  RemoveDetail( "wesen");
  RemoveDetail( ({"hirsch", "kronenhirsch"}) );
  RemoveSound( "wesen" );
}
