#pragma strong_types

#include <properties.h>
#include <wizlevels.h>
#include <daemon.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

mapping warned;

void create() 
{
  ::create();

  P_INT_SHORT_WALDWEG;
  SetProp(P_INT_LONG,
    BS("Mitten im Nadelwald erklimmt der Weg die Bergflanke. Im "+ CAP(ED4)+
       " steigt der Weg wieder steiler an. Im Wald erkennst Du hin und wieder "
       "Breschen, die nichts Gutes verheissen."));
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:13, ENV_TERRAIN: TT_FOREST]));

  CD_NADELWALD;
  CD_WALDWEG;
  AddDetail( ({"boden", "nadeln", "nadel", "waldboden"}), 
    "Der Boden ist mit Nadeln bedeckt.\n");

  AddDetail( ({"bergflanke", "berg", "flanke"}),
    "Die Bergflanke ist nicht allzu steil, so dass Du sie problemlos auf"
    " dem Weg erklimmen kannst.");
  AddDetail( ({"raum"}),
    "Der Raum, auf dem der Weg die die Richtung aendert, ist wirklich"
    " sehr begrenzt. Es wachsen hier keinerlei Laubbaeume mehr, nur noch"
    " Nadelwald gedeiht in dieser Hoehe.");
  AddDetail( ({"gutes"}),
    "Es gibt nichts Gutes, ausser man tut es.");
  AddDetail( ({"bresche", "breschen", "gehoelz"}),
    BS("Als ob ein Riese mit einer gewaltigen Axt einen weiten Hieb durch"
      " das Gehoelz gefuehrt haette sind hier riesige Breschen in den Wald"
      " geschlagen. Du erkennst aeltere Breschen, in welchen schon wieder"
      " kleine Baeumchen gruenen, und juengere Schneisen, in welchen kaum"
      " ein Blaettchen gruent."));
  AddDetail( ({"riese", "axt", "hieb"}),
    BS("Bei genauerer Betrachtung zweifelst Du an Deinem ersten Eindruck:"
      " nun denkst Du eher, hier sind Muren durch den Wald gebrochen und"
      " haben saemtliche Baeume gefaellt, die in ihrem Weg standen."));
  AddDetail( ({"scheise", "schneisen", "mure", "muren", "lawine", "lawinen",
    "gesteinslawine", "gesteinslawinen"}),
    BS("Muren haben hier riesige Schneisen in den Wald geschlagen. Selbst"
      " die groessten Baeume wurden von diesen Gesteinslawinen gefaellt."));
  AddDetail( ({"baeumchen"}),
    "In den aelteren Breschen wachsen bereits wieder kleine Baeumchen.");
  AddDetail( ({"blaettchen"}),
    "In den jungen Schneisen waechst kaum ein Blaettchen.");
  AddDetail( ({"blatt", "blaetter", "laub"}),
    "Blaetter siehst Du hier keine. Hier waechst schliesslich ein"
    " Nadelwald.");
  AddDetail( ({"nadelwald"}),
    BS("Hauptsaechlich Fichten und Tannen bilden hier den Wald, auf diesem"
      " kargen Boden und bei dem kuehlen Wetter in dieser Hoehe gedeihen"
      " keine Laubbaeume mehr.") );
  AddDetail( ({"nadel", "nadeln"}),
    "Die Nadeln haengen an den Nadelbaeumen. Darum heissen die Baeume ja "
    "auch NADELBAEUME!");
  AddDetail( ({"wetter", "hoehe", "sonnenschein", "sonne", "hoehe"}),
    "Trotz strahlendem Sonnenschein ist es in dieser Hoehe unangenehm kuehl.");
  AddDetail( ({"laubbaum", "laubbaeume"}),
    BS("ARRRRGGGLLL.... man muss fuer die Spieler aber auch jedes"
      " Detail beschreiben. Also nochmal, als Zitat vom Tod: \"HIER WACHSEN"
      " KEINE LAUBBAEUME.\" Und wenn Du jetzt auch noch Detail untersuchen"
      " willst: Nur zu, der Tod laesst Dich freundlich Gruessen."));
  AddDetail( ({"tod"}),
    "Der Tod sagt: DU SCHON WIEDER. ABER NOCH BIST DU NICHT FUER MICH\n"
    "Der Tod sagt: BESTIMMT.\n");
  AddDetail( ({"zitat"}),
    "Der Tod sagt: MACH NUR WEITER SO... DEINE UHR LAEUFT GERADE NOCH.\n"
    "Der Tod sagt: NOCH. ABER NICHT MEHR LANGE.\n"
    "Der Tod grinst fies.\n" );
  AddDetail( ({"gruesse", "gruessen", "gruss"}),
    "Der Tod sagt: ICH WERDE DICH GERNE PERSOENLICH BEGRUESSEN. SPRING\n"
    "Der Tod sagt: DOCH BITTE EINMAL UEBER DIESE KLINGE.\n"
    "Der Tod zeigt Dir seine Sense.\n");
  AddDetail( ({"klinge", "sense"}),
    BS("Gefaehrlich funkelt die Schneide der Sense. Der Tod kann Deinen"
      " Sprung wohl kaum erwarten.") +
      "\nDer Tod fragt: SOLL ICH DIR EIN WENIG HELFEN?\n"
      "Der Tod sagt: DIE SYNTAX IST spring[e] [ueber] klinge\n"
      "Der Tod winkt Dir einladend zu.\n");
  AddDetail( ({"detail", "uhr", "richtung", "details"}),
    "Untersuch doch bitte nur die sinnvollen Details."); 
  AddSpecialDetail( ({"argl", "arrrrggglll",  "hier", "im",
       "mitten", "es", "als", "bei", "selbst", "in", "untersuch",
       "hauptsaechlich", "trotz", "wachsen", "keine", "und", "nur", 
       "schon", "wieder", "aber", "noch", "bist", "nicht", "fuer", "mich",
       "bestimmt", "mach", "weiter", "so", "laeuft", "gerade",
       "mehr", "lange", "ich", "werde", "gerne", "persoenlich",
       "begruessen", "spring", "doch", "bitte", "einmal", "ueber",
       "diese", "soll", "wenig", "helfen", "syntax", "ist","vielleicht",
       "blitz", "nase", "oberkoerper", "auauaua", "ohrfeige", "patsch",
       "nasenwurzel", "ohgott"}),     "NoScript");
  AddDetail( ({"eindruck", "ausdruck", "abdruck"}),
    BS("Dein Ausdruck beim Eindruck dieses Abdrucks laesst zu wuenschen"
      " uebrig."));
  AddDetail( ({"betrachtung", "philosophie", "philosophieren"}),
    BS("Du geraetst ins Philosophieren. Vielleicht solltest Du doch lieber"
      " einfach weitergehen."));
  AddSound( DEFAULT_SOUND,
    "Hier ist es angenehm ruhig.");
  AddSmell( ({DEFAULT_SMELL, "duft", "waldduft"}),
    "Du laesst den beruhigenden Waldduft in Deine Lungen einstroemen.");

  AddCmd( ({"spring", "springe"}), "jump");

  SetProp(P_HIDE_EXITS, ({ ED4}) );
  AddExit( ({ED4, ED4OB}), "nach "+CAP(ED4OB)+"#./0314.lpc" );
  AddExit(ED8, "./0313.lpc" );

  warned=([]);
}

int jump(string str) 
{
  string tot;
  int xp;
  if (!str) return 0;
  if (str == "klinge" || str == "ueber klinge") 
  {
    if( member(warned, getuid(TP)) )
    {
      write("Du schluckst noch einmal und springst ueber die Klinge.\n");
      say(BS(TP->name() + " springt in die Luft und faellt bereits Tot zu "
            "Boden.")+"\n");
      tot= "[Tod:] Ein Sprung ueber die Sense des Todes hat gerade "+ TPN + 
        " umgebracht.\n";
      //    shout(tot);
      //    write(tot);
      //    xp=TP->QueryProp(P_XP)/100;
      //    TP->AddExp(-xp);
      //    TP->SetProp(P_GHOST,1);
      SetProp(P_KILL_NAME, "Ein Sprung ueber die Sense des Todes");
      TP->SetProp(P_GHOST,1);
      TP->move("/room/death/death_room", M_NOCHECK|M_NO_SHOW);
      TP->SetProp(P_KILLER, 0);
      write_file(LOG "kills",
          ctime()+": "+CAP(getuid(TP))+" springt ueber die Todessense.\n");
      return 1;
    }
    else
    {
      warned[getuid(TP)]=1;
      write("Im letzen Moment haelt Dich Jemand zurueck.\n"
          "Lars teilt Dir mit: Du willst doch nicht wirklich sterben?\n");
      return -1;
    }
  }
  return 0;
}

