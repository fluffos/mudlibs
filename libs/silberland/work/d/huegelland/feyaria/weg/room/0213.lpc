void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( in 0213.c) "
               " -%d EP\n", lostexp) );
}

void reset()
{
  ::reset();
  warned=([]);
}
