// Die Raststation
// 1996-12-23  Feyaria@SiilberLand
// 20 Details, 5 Smells

#pragma strong_types

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include "../directions.h"
#include "../def.h"

inherit "std/pub";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "In der Raststation Schaudichnichtum");
  SetProp(P_INT_LONG, BS(
    "Du sitzt an einem gemuetlichen Tisch in der Raststation "
    "Schaudichnichtum. Hier ist alles sehr rustikal eingerichtet. Die "
    "Theke, die Tische und Stuehle sind alle aus geschnitztem Holz. Aber "
    "vor allem die Holzdecke erweckt Deine Aufmerksamkeit. Sie besteht "
    "aus reichverzierten Holzbalken. Aber bevor Du die Decke eingehender "
    "betrachten kannst, stroemt Dir der Duft von Speck und Most in die "
    "Nase und Du bekommst sofort grossen Appetit."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);  
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23, ENV_TERRAIN:TT_HOUSE]));
  SetProp(P_NOMAGIC, 1);
  SetProp(P_KILL_NAME, "Leichtsinniges Vertrauen auf ein Script");

  AddDrink("Bergquellwasser", ({"bergquellwasser", "wasser", "quellwasser"}),
    55, ({13,12,8}), 0, 5,
    ({"Du trinkst Wasser, ganz frisch wie aus einer Bergquelle.",
      "&& trinkt frisches Bergquellwasser."}) );
  AddDrink("Most", ({"most", "humpen", "humpen most"}),
    77, ({21,18,4}), 3, 3,
    ({"Du trinkst einen Humpen Most.",
      "&& trinkt einen Humpen Most."}) );
  AddFood( "Brettljausn", ({"brettljausn", "jausn", "bretteljause", "jause",
    "bretteljausn", "brettljause"}),  111, ({35,39}), 14,
    ({"Du bekommst eine Brettljause mit Speck und frischem Schwarzbrot.\n"+
    "Sofort verschlingst Du alles und nur mit Muehe kannst Du Dich davor "
    "abhalten,\nauch in das schoene runde Brettl hineinzubeissen.",
    "&& verschlingt eine Bretteljause und fast auch das Holzbrettl."}) );
  AddFood( "geraeuchertes Murmeltier", ({"murmeltier", "geraeuchertes murmeltier"}), 
      888, ({50,50,20}), 17,
      ({"Du isst ein grosses Stueck geraeuchertes Murmeltier und Dir wird "
       "ganz murmelig zumute.","&& isst geraeuchertes Murmeltier. Daraufhin "
       "kommen murmelfoermige Rauchwolken aus &? Ohren."}) );
  AddFood( "Baerensteak", ({"steak", "baerensteak"}), 3333, 120, 50, "baer" );
  AddFood( "Kraeuterbonbon", ({"bonbon", "kraeuterbonbon"}), 44, 2, 1,
     "lutschen");

  AddDetail( ({"raststation", "station", "wirtschaft", "raum", "haus", 
               "haeuschen", "gasthaus", "wirtshaus", "umgebung"}),
    QueryProp(P_INT_LONG) );
  AddDetail( ({"name" }), 
    "Das ist der Name dieser Raststation. Also schau Dich nicht um.");
  AddDetail( ({"schaudichnichtum", "kommissar", "lied", "text", "sinn"}),
    "Dir kommt ein Lied von einem Kommissar in den Sinn, wo der Text so "
    "aehnlich geht.");
  AddDetail( ({"falco"}),
    "Falco singt das Lied vom Kommissar. Du bist ja richtig gebildet!");
  AddDetail( ({"boden", "dielen", "diele", "holzdiele", "holzdielen"}),
    "Der Boden besteht aus Holzdielen.");
  AddDetail( ({"wand", "waende", "holzwand", "holzwaende", "staemme",
               "stamm", "holzstamm", "holzstaemme"}),
    "Die Waende bestehen aus unbehauenen Holzstaemmen.");
  AddDetail( ({"decke", "holzdecke"}),
    "Die Decke besteht aus reichverzierten Holzbalken.");
  AddDetail( ({"balken", "holzbalken"}),
    "Die Holzbalken sind reichlich verziert. Die Verzierungen erinnern Dich "
    "an ein koenigliches Schloss. Sie wirken in dieser rustikalen Umgebung "
    "etwas fehl am Platz.");
  AddDetail( ({"platz"}),
    "Wirklich fehl am Platz.");  
  AddDetail( ({"verzierungen", "verzierung", "deckenverzierung",
               "deckenverzierungen"}),
    "Die Verzierungen erinnern Dich an ein koenigliches Schloss. Sie wirken "
    "in dieser rustikalen Umgebung etwas fehl am Platz.");
  AddDetail( ({"schloss", "koenigsschloss"}),
    "Du fragst Dich, welches Koenigsschloss solche schoene "
    "Deckenverzierungen hatte?");
  AddDetail( ({"holz"}),
    "Fast alles hier ist aus Holz. Sicher ist das meiste Holz aus den nahen "
    "Waeldern.");
  AddDetail( ({"theke", "holztheke"}),
    "An der Holztheke kannst Du Deine Bestellungen aufgeben. Wenn Du Dir "
    "noch nicht sicher bist, was Du haben willst, bestell doch die "
    "Speisekarte mittels 'menue'.");
  AddDetail( ({"tische", "holztische"}),
    "Die meisten Holztische sind leer. Zur Zeit scheint hier nicht viel "
    "Betrieb zu sein.");
  AddDetail( ({"zeit", "betrieb"}),
    "Zeit scheint hier nicht viel Betrieb zu sein.");
  AddDetail( ({"stuhl", "stuehle"}),
    "Die Stuehle haben meisterhaft gedrechselte Beine.");
  AddDetail( ({"beine", "bein"}),
    "Meinst Du jetzt Deine Beine oder die Beine der Stuehle?");
  AddDetail( ({"stuhlbeine", "stuhlbein"}),
    "Die Stuhlbeine sind meisterhaft gedrechselt. Sie wirken in dieser "
    "rustikalen Umgebung etwas fehl am Platz.");
  AddDetail( ({"meine beine"}),
    "Deine Beine kennst Du sicher selber gut genug.");  
  AddDetail( ({"tisch", "holztisch"}),
    "Du sitzt an einem schoenen, runden Tisch. Nur der schmierige Fleck "
    "in der Mitte des Tisches stoert ein wenig.");
  AddDetail( ({"mitte"}),
    "In der Mitte des Tisches befindet sich ein schmieriger Fleck.");   
  AddDetail( ({"flecken", "fleck", "mischung"}),
    "Der Fleck stammt wohl von der Mischung aus fetten Speck und Most, "
    "darum ist er so schmierig.");
  AddDetail( ({"speck", "most", "brettljausn", "jausn", "bretteljause",
               "jause", "bretteljausn", "brettljause", "humpen", "brot",
               "schwarzbrot", "bonbon", "kraeuterbonbon"}),
    "Das kann man hier alles bestellen. Tipp doch einfach mal 'menue'.");
  AddDetail( ({"appetit", "magen", "hunger", "durst", "speisekarte",
               "bestellung", "bestellungen"}),
    "Dein Magen knurrt, Du hast Hunger und Durst, also auf was wartest Du "
    "noch. Bestell Dir endlich etwas!");
  AddDetail( ({"nase"}),
    "Da Deine Nase zwischen Deinen Augen sitzt, kannst Du sie nur schwer "
    "ohne Spiegel betrachten. Aber da Du so angenehme Gerueche riechst, ist "
    "Deine Nase sicher noch da und voll funktionstuechtig.");
  AddDetail( ({"augen", "spiegel"}),
    "Deine Augen kannst Du wirklich nur in einem Spiegel sehen, aber leider "
    "ist hier kein Spiegel.");
  AddDetail( ({"aufmerksamkeit", "forscherpunkt"}),
    "Aufmerksam schaust Du Dich um, sicher nur wegen eines Forscherpunktes. :)");

  AddSmell( ({DEFAULT_SMELL, "geruch", "gerueche", "duft"}),
    "Es riecht hier nach Speck und Most.");
  AddSmell( ({"speck", "fett"}),
    "Der Speck riecht wirklich sehr gut. Sofort willst Du eine Brettljausn "
    "haben.");
  AddSmell( ({"brot", "schwarzbrot"}),
    "Das Schwarzbrot duftet wirklich sehr gut. Auf der Stelle willst Du "
    "eine Brettljausn haben.");
  AddSmell( ({"most", "humpen"}),
    "Der Most hat einen herrlichen Geruch. Warum bestellst Du nicht noch "
    "einen Humpen?");
  AddSmell( ({"jausn", "bretteljause", "jause", "bretteljausn", 
              "brettljause"}),
    "Die Brettljause riecht nach Brot und Speck.");
  AddSound( ({"magen"}),
    "Dein Magen knurrt. Iss doch etwas!");
  AddSound( ({"lied"}),
    "Drah di net um, oh oh oh, der Kommisar geht um...");
  
  AddDetail( ({"aufmerksam", "forscherpunktes"}),
    "Bist Du Vielleicht Ein Script, Dass Alle Grossgeschriebenen Worte "
    "Untersucht? Das Koennte Schnell Zu Deinem Tod Fuehren.");

  AddSpecialDetail( ({"hier", "aber", "sie", "also", "fast", "an", "wenn", 
        "meinst", "nur", "tipp", "bestell", "da", "sofort", "auf", "warum", 
        "waeldern", "bist", "vielleicht" "ein", "script", "dass", "alle",
        "grossgescheibenen", "worte", "untersucht", "jetzt", "stirbst", "zu",
        "bist", "selber", "schuld", "unsinnige", "worte", "soll", "man",
        "nicht", "untersuchen", "koennte", "schnell", "tod", "fuehren"}),
   "NoScript");

  AddExit( "raus", "./0513" );
}

void lutschen(object z, object e)
{
  tell_object(e,
      "Du lutscht ein Kraeuterbonbon und fuehlst Dich wunderbar.\n" );
  tell_room(TO, 
      e->Name(WER)+ " lutscht ein Kraeuterbonbon.\n", ({e}) );
  if( e->QueryProp(P_BLIND) && !random(3) )
  { 
    e->SetProp(P_BLIND, 0);
    tell_object(e, "Du kannst wieder sehen!\n");
  }
  if( e->QueryProp(P_DEAF) && !random(3) )
  { 
    e->SetProp(P_DEAF, 0);
    tell_object(e, "Du kannst wieder hoehren!\n");
  }
}

void baer(object z, object e)
{
  tell_object(e, 
      "Du isst ein kraeftiges Baerensteak und brummst dabei wie ein Baer.\n");
  tell_room(TO, 
      e->Name(WER)+" isst ein Baerensteak und brummt zufrieden.\n", ({e}) );
  if( !present("\nbaerenkraft", e) )
    CLONE ( OBJ "baerenkraft", e);
}

string NoScript()
{
  int damageLevel;
/* 
 if( IS_SEER(TP) )
    damageLevel = 10 + random(10);
  else 
    damageLevel = 5 + random(5);
  if( TP->QueryProp(P_HP)<100 )
  {
    write("Du schreist vor Schmerz: AUA!!!!\n");
    say( TPN+ " schreit vor Schmerz.\n");
  }
  TP->do_damage(damageLevel);
*/  
  write_file(LOG "scriptfalle",
    ctime()+": "+CAP(getuid(TP))+" untersucht < "+ TP->_unparsed_args()+
        " > in kneipe.c.\n");
  return BS("Unsinnige Worte Soll Man Nicht Untersuchen!");
} 

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
     sprintf( ctime()+": "+CAP(getuid(player))+" ( Scriptfalle in kneipe.c) "
               " -%d EP\n", lostexp) );
}
