// /d/gebirge/feyaria/weg/room/0407.c
// 1997-01-01  Feyaria@SilberLand

#pragma strong_types

#include <properties.h>
#include <moving.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./weide.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_WEIDE;
  SetProp(P_INT_LONG, BS(
    "Du stehst auf einer Hochflaeche, die leicht nach " + CAP(ED3) + 
    " abfaellt. Obwohl das Gras hier sehr spaerlich ist, weiden hier viele "
    "Schafe, die von einem Schaefer und seinem Hund bewacht werden. Weit im "
    + CAP(ED3) +" spiegelt sich der " N_BERG " im " N_SEE ". Der Weg nach "+
    CAP(ED7) +" wird durch eine breite Kluft abgeschnitten. Dort wird das "
    "Gelaende zunehmend huegeliger.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:9, ENV_TERRAIN:TT_HILL]));

  CD_BERG_WEIT;
  CD_SEE_WEIT;
  WEIDE;
  AddDetail( ({"gelaende", "kluft", "kluefte", "boden"}),
    "Den weichen Sandstein durchziehen hier tiefe, kaum wenige Meter "
    "breite Kluefte, an deren Grund das Wasser rauscht.");
  AddDetail( ({"stein", "sandstein", "sand"}),
    "Da Sandstein so weich ist, bilden sich durch die Erosion auch schnell "
    "tiefe Kluefte.");
  AddDetail( ({"erosion", "eros"}),
    "Ob Eros damit etwas zu tun hat?");
  AddDetail( ({"grund", "dunkel"}),
    "Sowas siehst Du nicht, die Kluft ist viel zu tief, und schon nach "
    "wenigen Metern verschwimmt alles in tiefem Dunkel da unten.");
  AddDetail( ({"wand", "waende"}),
    "Die Waende der Kluft sind nass und glitschig, zudem waechst"
    " feuchtes Gras auf jedem Tritt.");
  AddDetail( ({"weg"}),
      "Der Weg nach "+ CAP(ED7) +" wird durch eine breite Kluft abgeschnitten.");
  
  AddItem( NPC "schaf", REFRESH_DESTRUCT);
  
  AddCmd( ({"kletter", "klettere"}), "climb");
  AddCmd( ({"spring", "springe", "huepf", "huepfe"}), "jump");
  AddCmd( ({"seil", "seile"}), "glide");

  AddExit(ED1, "./0406.lpc" );
  AddExit(ED2, "./0507.lpc" );

}


int glide(string str) 
{
  notify_fail("Dazu brauchst Du doch ein Seil!\n");
  if( present("seil", TP) )
    notify_fail(BS("Spaeter einmal wirst Du Dich in die Kluft abseilen "
      "koennen... zur Zeit ist da aber noch eine Baustelle. Probiers "
      "spaeter einmal wieder, oki?")); 
  return 0;
}

int jump(string str) 
{
  if ((str == "in kluft") || (str == "kluft") || (str == "")) 
  {
    write(BS("Willst Du wirklich in die Kluft springen? Die Syntax lautet "
      "dann 'springe in die kluft!' (Ausrufezeichen nicht vergessen!)"));
    return 1;
  }
  else if (str == "in die kluft!") 
  {
    write(BS("Zur Zeit kannst Du noch nicht in die Kluft springen -- wie"
      " bereits gesagt, hier ist noch Baustelle. Probiers doch spaeter"
      " einmal wieder, oki?"));
    return 1;
  }
  else if ((str == "ueber kluft") || (str == "ueber die kluft")) 
  {
    write("Du nimmst Anlauf und springst mutig ueber die Kluft.\n");
    TP->move( ROOM "0307", M_GO, "ueber die Kluft", "springt",
        "kommt ueber die Kluft gesprungen");
    return 1;
  }
  notify_fail("Wohin willst Du denn springen?\n");
  return 0;
}

int climb(string str) 
{
  if (str == "kluft" || str == "in kluft") 
  {
    write(BS("Die Waende der Kluft sind nass und glitschig, zudem waechst"
      " feuchtes Gras auf jedem Tritt. Ohne Seil kommst Du hier wohl nicht"
      " runter.\n"));
    say(BS(TPN+ " versucht, in eine der Kluefte zu klettern, aber kehrt nach"
      " kurzer Zeit wieder um."));
    return 1;
  }
  notify_fail("Wohin willst Du denn klettern?\n");
  return 0;
}
