// /d/gebirge/feyaria/weg/room/sumpf2.c  
// Mitten im Sumpf
// 17-08-1996  Feyaria@AnderLand
// 27-12-1996  Feyaria@SilberLand

inherit "/std/room";

#include <language.h>
#include <properties.h>
#include <moving.h>
#include <combat.h>
#include "./sumpf.h"
#include "../def.h"

void create()
{
  ::create();

  P_INT_SHORT_SUMPF;
  SetProp(P_INT_LONG, BS(
    "Du stehst jetzt mitten im Sumpf. Du haettest vielleicht doch nicht den "
    "Weg verlassen sollen. Ueberall um Dich herum befindet sich dichtes "
    "Schilf. Der Weg ist nirgends mehr zu sehen, auch sonst ist kein "
    "Orientierungspunkt in der Naehe. Hoffentlich kommst Du hier schnell "
    "wieder raus, bevor Du ganz im Sumpf versinkst."));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN: TT_SWAMP]));
  SetProp(P_KILL_NAME, "Der tueckische Sumpf");
  SetProp(P_NO_MNPC,1);
  
  SUMPF_DETAILS;
  SUMPF_DETAILS2; 
  SUMPF_SENSE;

  AddItem( NPC "reiher", REFRESH_DESTRUCT);

  AddSpecialExit( ({"norden", "nordwesten", "westen", "suedwesten", "sueden",
                   "suedosten","osten", "nordosten"}), "sumpf");
}

sumpf()
{
  object *schuhe;
  if(random(5)==0 && TP->QueryProp(P_ARMOURS) )
  {
     schuhe=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_BOOT); 
     if (sizeof(schuhe) && objectp(schuhe[0])) 
     {
       schuhe[0]->move( TO, M_PUT | M_SILENT);
       write("Zu Deinem Pech bleiben Deine Schuhe im Sumpf stecken.\n");
     }
  }
  switch (random(10))
  {
    case 0: TP->move(ROOM "0311",M_GO,"durch den Sumpf", "stapft",
                "kommt schlammbespritzt aus dem Sumpf");
            break;
    case 1: TP->move(ROOM "0412",M_GO,"durch den Sumpf", "stapft",
                "kommt schlammbespritzt aus dem Sumpf");
            break;
    case 2:
    case 3: TP->move(ROOM "sumpf1",M_GO,"durch den Sumpf", "stapft",
                "stapft herein");
            break;
    case 4 :TP->move(ROOM "sumpf",M_GO,"noch tiefer in den Sumpf", "stapft",
                "stapft herein");
            break;
    default:
       write("Du bleibst im Sumpf stecken und kommst kaum vorwaerts.\n");
       say( TPN +" will von hier weg, bleibt aber im Sumpf stecken.\n");
  }
  return 1;
}
