#pragma strong_types

#include <properties.h>
#include <moving.h>
#include <combat.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./schlucht.h"


inherit "std/room";

int mure;
/*** PROTOTYPES ***/
int rufen(string str);
void create();

/*** IMPLEMENTATION ***/
void create() 
{
  ::create();

  mure=0;
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:13, ENV_TERRAIN: TT_MOUNTAIN]));
  P_INT_SHORT_SCHLUCHTPFAD;
  SetProp(P_INT_LONG,
    BS("Du bist fast am oberen Ende des Gebirgspfads angekommen. Der Abgrund"
      " gaehnt drohend direkt neben Dir. Im " + CAP(ED7) + " siehst Du eine"
      " Huette, im " + CAP(ED5) +" windet sich der Pfad weiter nach oben."
      " Ueber Dir droht die Felswand, eine ihrer beruechtigten Muren nach"
      " unten zu schicken."));

  AddDetail( ({"huette", "blockhuette"}),
    "Im " + CAP(ED7) + " siehst Du eine einfache Blockhuette.");
  AddDetail( ({"ende"}),
    "Ende bedeutet hier wohl, dass der Gebirgspfad hier aufhoert.");

  CD_SCHLUCHTPFAD;

  AddCmd( ({"ruf", "rufe"}), "rufen");

  SetProp(P_HIDE_EXITS, ({ ED5, ED7 }) );
  AddExit( ({ED5, ED5OB}), "nach "+CAP(ED5OB)+"#./0309.lpc" );
  AddExit( ({ED7, ED7U}), "nach "+CAP(ED7U)+"#./0208.lpc" );
}

int rufen(string str) 
{
  object *helm;

  if (str == "hilfe" || str == "um hilfe") 
  {
    write("Du rufst um Hilfe und die Bergwacht rettet Dich aus der "
             "drohenden Geroellawine.\n");
    TP->reduce_hit_point(2*TP->QueryProp(P_LEVEL) );
    TP->move(ROOM "huette", M_GO, "", "wird von der Bergwacht gerettet",
             "wird von der Bergwacht hereingetragen");
    return 1;
  }
  domainshout(TPN+" ruft: "+str+" ....*RUMMPEL...KRACH...RUMMS*\n");
  write("Durch Dein Rufen loest Du eine Geroellawine aus.\n");
  say( TPN + " loest durch " + TPPP(NEUTER, WEN, SINGULAR) + " Rufen eine "
       "Geroellawine aus.\n");
  SetProp(P_KILL_NAME, "Eine Geroellawine");
  helm=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_HELMET); 
  if( sizeof(helm) && objectp(helm[0]) )
  {
    if( helm[0]->QueryProp(P_NAME)=="Kletterhelm" )
    {
      write("Zum Deinem Glueck traegst Du einen Kletterhelm.\n");
    }
    else
    {
      write("Dein Helm beschuetzt Deinen Kopf gegen den Steinschlag.\n");
      TP->do_damage( 10+random(60)-helm[0]->QueryProp(P_AC)*3 );
    }
  }
  else
  {
    write("Aua! Die Steine prasseln auf Deinen ungeschuetzten Kopf.\n");
    TP->do_damage( 10+random(60) );
  }  
  return 1;
} 


int mure()
{
  write("Hier geht es nicht weiter, der Weg ist durch eine Mure versperrt.\n");
  return -1;
}

void add_mure()
{
  mure=1;
  tell_room(TO, "Eine Mure geht hernieder und verschuettet den Weg nach "+CAP(ED7U)+".\n");
  RemoveExit( ({ED7, ED7U}));
  AddSpecialExit( ({ED7, ED7U}), "mure" );
  SetProp(P_HIDE_EXITS, ({ ED5, ED7, ED7U }) );
  AddDetail( ({"lawine", "geroell", "geroellawine", "geroelllawine",
             "baeume", "muren", "mure", "bergwacht"}),
    "Auch hier ging erst kuerzlich eine Mure nieder. Sie hat einige"
    " Baeume plattgewalzt und den Weg fuer eine Weile unpassierbar gemacht,"
    " hoffentlich wird die Bergwacht den Pfad bald wieder freiraeumen.");
  SetProp(P_INT_LONG,
    BS("Du bist fast am oberen Ende des Gebirgspfads angekommen. Der Abgrund"
      " gaehnt drohend direkt neben Dir. "
      " Im " + CAP(ED5) +" windet sich der Pfad weiter nach oben."
      " Eine Mure hat den Pfad nach "+CAP(ED7)+" verschuettet."));
  call_other( ROOM "0208", "add_mure" );
}

void init()
{
  ::init();
  if( mure && present("bergwacht-mann") )
   call_out("mure_weg", 6);
}

void mure_weg()
{
  if( mure )
  {
    tell_room(TO, "Der Bergwachtmann macht sich an die Arbeit und schaufelt "
        "die Mure weg.\nDer Weg nach "+CAP(ED7U)+" ist wieder passierbar.\n");
    RemoveExit( ({ED7, ED7U}));
    AddExit( ({ED7, ED7U}), "nach "+CAP(ED7U)+"#./0208.lpc" );
    SetProp(P_HIDE_EXITS, ({ ED5, ED7 }) );
    mure=0;
    AddDetail( ({"lawine", "geroell", "geroellawine", "geroelllawine",
          "baeume", "muren", "mure", "bergwacht"}),
        "Auch hier ging erst kuerzlich eine Mure nieder. Sie hat einige"
        " Baeume plattgewalzt und den Weg fuer eine Weile unpassierbar gemacht,"
        " aber inzwischen hat die Bergwacht den Pfad freigeraeumt.");
  SetProp(P_INT_LONG,
    BS("Du bist fast am oberen Ende des Gebirgspfads angekommen. Der Abgrund"
      " gaehnt drohend direkt neben Dir. Im " + CAP(ED7) + " siehst Du eine"
      " Huette, im " + CAP(ED5) +" windet sich der Pfad weiter nach oben."
      " Ueber Dir droht die Felswand, eine ihrer beruechtigten Muren nach"
      " unten zu schicken."));
    call_other( ROOM "0208", "mure_weg" );
  }
}

void reset()
{
  ::reset();
  if( mure )
  {
    mure_weg();
    call_other( ROOM "0208", "mure_weg" );
  }
  else if( !random(10) )
    add_mure();
}

