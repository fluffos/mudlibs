#pragma strong_types

#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <wizlevels.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./schlucht.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:14, ENV_TERRAIN: TT_MOUNTAIN]));
  P_INT_SHORT_SCHLUCHTPFAD;
  SetProp(P_INT_LONG,
    BS("Der Gebirgspfad fuehrt im " + CAP(ED4) + " auf einen kurzen Tunnel"
      " zu, der sich durch einen vorstehenden Felspfeiler bohrt. Im "
      + CAP(ED7) + " siehst Du die letzte Spitzkehre vor dem Talgrund.") );
      
  CD_SCHLUCHTPFAD;

  AddDetail( ({"grund", "talgrund", "tal"}),
    BS("Du kannst den Talgrund im " + capitalize(ED6) + " noch nicht genau"
      " erkennen: er ist noch zu weit entfernt.") );
  AddDetail( ({"tunnel", "eingang", "tunneleingang"}),
    BS("Im " + CAP(ED3) + " bohrt sich der Pfad durch einen kurzen Tunnel,"
      " der gerade hoch und breit genug ist, einen der Haendlerkarren"
      " durchzulassen, aber nicht genug Platz fuer zwei bieten wuerde.") );
  AddDetail( ({"pfeiler", "felspfeiler"}),
    BS("Der Felspfeiler ist von den vielen Muren ganz schartig geschlagen."
      " Scheinbar stuerzt das Geroell dort so regelmaessig herab, dass man"
      " lieber einen Tunnel durch den Fels schlug. Du kannst tatsaechlich"
      " noch zerschlagene Reste eines uralten Pfades erkennen.") );
  AddDetail( ({"reste", "pfad", "spuren", "scharten", "geroell"}),
    BS("Der uralte Pfad fuehrt vom Tunneleingang um den Felspfeiler herum."
      " Er ist voellig zertruemmert und stellenweise vollstaendig"
      " weggeschlagen, dort kannst Du nicht weitergehen.") );
  AddDetail( ({"kehre", "spitzkehre"}),
    BS("Im " + CAP(ED7) + " erkennst Du eine Spitzkehre, die kunstvoll aus"
      " dem Fels geschlagen wurde."));

  AddCmd( ({"ruf", "rufe"}), "rufen");

  SetProp(P_HIDE_EXITS, ({ ED7 }) );
  AddExit( ({ED7, ED7U}), "nach "+CAP(ED7U)+"#./0109.lpc" );
  AddExit(ED3, "./0310.lpc" );
}


int rufen(string str) 
{
  object *helm;
  int chars;
  if (str == "hilfe" || str == "um hilfe") 
  {
    write("Du rufst um Hilfe und die Bergwacht rettet Dich aus der "
             "drohenden Geroellawine.\n");
    TP->reduce_hit_point(2*TP->QueryProp(P_LEVEL) );
    TP->move(ROOM "huette2", M_GO, "", "wird von der Bergwacht gerettet",
             "wird von der Bergwacht hereingetragen");
    return 1;
  }
  chars=strlen(str)/2;
  if (chars<4) chars=4;
  if(!IS_SEER(this_player()))  // Seher++ duerfen kostenfrei rufen
  {
    if (TP->QueryProp(P_SP) <(chars+20)) 
    {
      write("Du must erst wieder magische Kraefte sammeln.\n");
      write("Tip: Benutz doch mal die Kanaele (Hilfe dazu mit 'hilfe kanaele').\n");
      return 1;
    }
    TP->restore_spell_points(-chars - 20);
  }
  domainshout(TPN+ " ruft: "+ str+"....*RUMPEL...KRACH...RUMMS*\n");
  write("Durch Dein Rufen loest Du eine Geroellawine aus.\n");
  say( TPN + " loest durch " + TPPP(NEUTER, WEN, SINGULAR) + " Rufen eine "
       "Geroellawine aus.\n");
  SetProp(P_KILL_NAME, "Eine Geroellawine");
  helm=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_HELMET); 
  if( sizeof(helm) && objectp(helm[0]) )
  {
    if( helm[0]->QueryProp(P_NAME)=="Kletterhelm" )
    {
      write("Zum Deinem Glueck traegst Du einen Kletterhelm.\n");
    }
    else
    {
      write("Dein Helm beschuetzt Deinen Kopf gegen den Steinschlag.\n");
      TP->do_damage( 10+random(60)-helm[0]->QueryProp(P_AC)*3 );
    }
  }
  else
  {
    write("Aua! Die Steine prasseln auf Deinen ungeschuetzten Kopf.\n");
    TP->do_damage( 10+random(60) );
  }  
  return 1;
} 
