#pragma strong_types

#include <properties.h>
#include <moving.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./talaue.h"
#include "./schlucht.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN:TT_HILL]));
  P_INT_SHORT_AU;
  SetProp(P_INT_LONG, BS("Du stehst am Fuss einer Steilwand, in der sich der"
    " Weg in atemberaubenden Serpentinen entlang einer Steilwand aus dem Tal"
    " auf einen Huegel windet. Im " + CAP(ED5) + " liegt eine friedliche,"
    " weltabgeschiedene Talaue mit gruenen Wiesen und ein paar Bueschen.") +
    "Ein LAWINEN-WARNSCHILD.\n"
    "Eine Huette.\n");

  CD_AUE;     // Details fuer die Talaue, definiert in talaue.h
  CD_AUE2;
  CD_SCHLUCHTPFAD; // Details fuer die Steilwand, definiert in schlucht.h

  AddDetail( ({"schild", "warnschild", "lawinen-warnschild",
               "lawinenwarnschild"}),
    WARNSCHILD_TEXT );
  AddReadDetail( ({"schild", "warnschild", "lawinen-warnschild",
                   "lawinenwarnschild"}),
    WARNSCHILD_TEXT );
  AddDetail( ({"huette", "bergwacht-huette", "bergwacht", "blockhuette",
      "forsthaus", "haus"}),
    BS("Eine kleine, heimelige Blockhuette. Ueber der Tuer haengt ein"
      " Schild:") + "\n"
    "+-------------------+\n"
    "| F o r s t h a u s |\n"
    "| Kehrdichannichts  |\n"
    "+-------------------+\n" );
  AddDetail("tuer",
    BS("Die Tuer ist nur angelehnt, Du kannst die Huette jederzeit"
      " betreten.") );
  AddDetail( ({"fenster"}),
    "Durch die Fenster kannst Du erkennen, dass man in der Huette etwas "
    "zu essen und zu trinken bekommen kann.");    
  AddDetail( ({"serpentine", "serpentinen", "zacke", "zacken"}),
    BS("Im Zickzackkurs windet sich der Weg eine Felswand hinauf. Die Zacken"
      " nennt man Serpentinen. Aber wie heissen die Zicken?") );
  AddDetail( ({"zicke", "zicken"}),
    "Du wirst doch hier keine Zicken machen?");

  AddCmd( ({"betritt", "betret", "betrete"}), "enter");

  SetProp(P_HIDE_EXITS, ({ ED2 }) );
  AddExit(ED4, "./0311.lpc" );
  AddExit( ({ED2, ED2OB}), "nach "+CAP(ED2OB)+"#./0109.lpc" );
  /*** spezialbehandlung in enter()
   * AddExit(ED6, "./huette2.lpc");
   ***/
}

int enter(string str) 
{
  if( str == "huette" || str == "bergwacht" || str == "bergwacht-huette" 
    || str == "forsthaus" || str == "haus" || str == "bergwachthuette" ) 
  {
    TP->move( ROOM "huette2.lpc", M_GO, "", "betritt die Bergwacht-Huette",
                      "kommt herein");
      return 1;
  }
  notify_fail("Was willst Du denn betreten?\n");
  return 0;
}
