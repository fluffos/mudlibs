#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_WALDWEG;
  SetProp(P_INT_LONG,
    BS("In grossem Bogen erklimmt der Waldweg den Berg, die Sonne sorgt"
      " dafuer, dass es angenehm warm ist.")+
    "Im Westen befindet sich eine Waldhuette.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN: TT_FOREST]));

  CD_WALD;
  CD_WALDWEG;
  CD_WALDBODEN;

  AddDetail("berg",
    "Der Berg ist recht steil, so dass es nicht ratsam waere, den Weg zu"
    " verlassen.");
  AddDetail( ({"weg", "bogen"}),
    "Der Weg windet sich in grossem Bogen von "+ CAP(ED2) + " nach "+
    CAP(ED7) +" den Berg empor.");
  AddDetail( ({"huette", "waldhuette"}),
"Im Weten befindet sich eine Waldhuette.");
  AddSound( DEFAULT_SOUND,
    "Hier ist es angenehm ruhig.");
  AddSmell( ({DEFAULT_SMELL, "duft", "waldduft"}),
    "Du laesst den beruhigenden Waldduft in Deine Lungen einstroemen.");

  AddItem( NPC "dachs", REFRESH_DESTRUCT);

  SetProp(P_HIDE_EXITS, ({ ED2 }) );
  AddExit( ({ED2, ED2U}), "nach "+CAP(ED2U)+"#./0918.lpc" );
  AddExit(ED7, "./0719.lpc" );
}
