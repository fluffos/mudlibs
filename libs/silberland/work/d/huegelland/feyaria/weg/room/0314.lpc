#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_WALDWEG;
  SetProp(P_INT_LONG,
    BS("Nach " + CAP(ED4)+ " wird der Nadelwald immer lichter, je hoeher der"
      " Weg steigt. Im " + CAP(ED8) + " fuehrt der Weg steil nach unten."));
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:12, ENV_TERRAIN: TT_FOREST]));
  
  CD_NADELWALD;
  CD_WALDWEG;
  CD_WALDBODEN;

  AddItem( NPC "waldwolf", REFRESH_DESTRUCT);

  SetProp(P_HIDE_EXITS, ({ED8}) );
  AddExit(ED4, "./0415.lpc" );
  AddExit( ({ED8, ED8U}) , "nach "+CAP(ED8U)+"#./0213.lpc" );
  // Verbindung zu Xorgans Koehlerhuette:
  AddExit(ED6, "/d/huegelland/xorgan/koehler/room/room_a1");
}
