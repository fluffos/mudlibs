#pragma strong_types

#include <properties.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./pass.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_PASS;
  SetProp(P_INT_LONG, BS(
    "Auf dieser Passhoehe pfeift der Wind. Darum wachsen hier auch nur noch "
    "ganz wenige Krueppelkiefern. Im "+ CAP(ED8) +" beginnt ein lichter "
    "Wald, der jedoch auch nur aus Kiefern besteht. Der Pfad fuehrt von "+
    CAP(ED8) +" steil aufwaerts nach "+ CAP(ED2) +"."));
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:9, ENV_TERRAIN:TT_HILL]));

  AddDetail( ({"wald", "baum", "baeume"}),
    "Der Wald liegt etwas tiefer, darum wachsen dort auch mehr Baeume.");

  CD_PASS;

  SetProp(P_HIDE_EXITS, ({ ED2}) );
  AddExit( ({ED2, ED2OB}), "nach "+CAP(ED2OB)+"#./0715.lpc" );
  AddExit(ED8, "./0515.lpc" );
}
