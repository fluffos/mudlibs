#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./huegel2.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_HUEGEL;
  SetProp(P_INT_LONG,
    BS("Hier biegt der Huegelweg von " + CAP(ED7) + " nach " + CAP(ED5) +
       " ab. Im " + CAP(ED1) + " liegt das Ende einer Schlucht zwischen den"
       " Bergen im " + CAP(ED7) + " und " + CAP(ED1) + ", dort verbreitert"
       " sich das Tal zu einer flachen Tiefebene, die sich bis zum Meer im "
       + CAP(ED4) + " ausdehnt.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_HILL]));

  CD_HUEGEL;
  CD_HUEGEL2;

  AddDetail( ({"schlucht", "tal", "ende"}),
    "Im " + CAP(ED1) + " endet eine Schlucht, aus der rauschend und"
    " wild ein Bach tritt. Im " + CAP(ED3) + " verbreitert sich die"
    " Schlucht zu einem Tal und schliesslich zu einer weiten, gruenen"
    " Ebene.");
  AddDetail( ({"landschaft", "huegelllandschaft", "huegel"}),
    QueryProp(P_INT_LONG) );
  AddDetail( ({"ebene", "tiefebene", "bach", "baechlein", "fluss",
               "fluesschen"}),
    "Im " + CAP(ED3) + " liegt eine Tiefebene im Dunst unter Dir, durch"
    " die sich traege ein kleines Fluesschen schlaengelt. Du erkennst "
    "einen weiten, weissen Strand am Rand der Meeresbucht im " +
    CAP(ED4) + ", in die das Baechlein muendet.");
  AddDetail( ({"strand", "sandstrand", "meer", "meeresbucht", "rand"}),
    "Die Ebene wird durch einen schmalen, weissen Sandstrand vom Meer"
    " getrennt, den Du undeutlich durch den Dunst erkennst.");
  AddDetail("berg",
    "Ganz nah vor Dir ueberragt ein riesiger Berg mit zwei Gipfeln die"
    " Landschaft. Die unteren Regionen sind bewaldet, weiter oben glaenzen"
    " kahle Felswaende in der Sonne.");
  AddDetail( ({"gipfel", "felswand", "felswaende"}),
    "Hoch ueber Dir glaenzen die steilen Felswaende in der waermenden"
    " Sonne. Darunter breiten sich Geroellfelder und Buschwerk aus.");
  AddDetail( ({"geroellfeld", "geroellfelder", "buschwerk", "busch",
               "buesche", "strand"}),
    "Vielleicht solltest Du naeher hingehen, um mehr zu sehen.");
  AddDetail( ({"wald", "baeume", "hang", "haenge"}),
    "Die Haenge des im " + CAP(ED1) + " liegenden Berges sind im unteren"
    " Bereich bewaldet.");

  AddExit(ED5, "./1318.lpc" );
  AddExit(ED7, "./1217.lpc" );
}
