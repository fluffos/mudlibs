#pragma strong_types

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>

#include "../directions.h"
#include "../cheasy_defs.h"

inherit "std/room";

// PROTOTYPES
int jump(string str);
void deathJump();
int climb(string str);
void down();
int slide(string str);
int NoScript();


// CODE
void create() 
{
  ::create();

  SetProp(P_LIGHT, 1);  // es ist hell -- naja ein bisschen
  SetProp(P_INDOORS, 0);// es hat kein Dach
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:12, ENV_TERRAIN:TT_HILL]));
  SetProp(P_INT_SHORT, "Auf einem Mammutbaum");
  SetProp(P_INT_LONG, BS("Nach anstrengender Kletterei setzt Du Dich auf"
    " eine Astgabel eines riesigen Mammutbaums. Rings um Dich erkennst Du"
    " die Kronen der anderen Waldbaeume, aber der Stamm dieses Mammutbaums"
    " ist hier bestimmt noch dicker als Du selbst. Die Krone des Baums ist"
    " ebenso riesig wie dieser; Du kannst von hier aus kaum die hoechsten"
    " Blaetter erkennen. Ein Stueck unter der Baumkrone befindet sich ein "
    "Baumhaus. Weit unter Dir erkennst Du den Weg. Neben Dir"
    " stuerzt der Wasserfall nach unten."));

  AddDetail( ({"baumhaus", "haus"}),
    "Um das Baumhaus zu betrachten musst Du noch ein Stueck weiter "
    "hinaufklettern.");  
  AddDetail( ({"weg", "waldweg", "boden"}),
    "Der Waldweg ist so weit unten, dass Du nur wenig erkennen kannst.");
  AddDetail( ({"blaetter", "himmel"}),
    "Der Blick auf den Himmel wird durch die vielen Blaetter verdeckt.");
  AddDetail( ({"wasserfall"}),
    "Der Wasserfall stuerzt von weit ueber Dir herab und durchnaesst"
    " alles mit der Gischt, die vom Wind abgetrieben wird.");
  AddDetail( ({"gischt", "dunst"}),
    "Der Wasserfall rauscht mit solcher Wucht nach unten, dass feiner"
    " Dunst entsteht. Diese Gischt wird durch den Wind abgetrieben und"
    " durchnaesst alles hier.");
  AddDetail( ({"wasser"}),
    "Hier gibt es ueberall Wasser: durch die Luft treibt die Gischt des"
    " Wasserfalls und durchnaesst alles hier. Die Astgabel, auf der Du"
    " sitzt, ist ebenso nass wie der Stamm, Deine Kleider und die Luft"
    " hier.");
  AddDetail( ({"stamm", "baumstamm", "staemme", "baumstaemme"}),
    "Der Stamm des Mammutbaums ist hier, in Wipfelhoehe der umgebenden"
    " Tannen und Fichten, noch viel dicker als die Staemme der Nadelbaeume"
    " unten auf dem Boden." );
  AddDetail( ({"luft", "wind"}),
    "Die Wucht des Wasserfalls reisst auch die Luft mit, weshalb hier"
    " staendig ein leichter Wind weht. Durch die Gischt in der Luft ist"
    " dieser Wind nass und unangenehm. Deshalb ist es hier so unangenehm"
    " kalt.");
  AddDetail( ({"gabel"}),
    "Zu essen gibt's hier nichts, wozu also eine Gabel?");
  AddDetail( ({"astgabel", "gabelung", "astgabelung"}),
    "Der Ast, auf dessen Gabelung Du stehst, ist so dick wie die Staemme"
    " der Waldbaeume... und das in Wipfelhoehe der normalen Fichten und"
    " Tannen ringsum.");
  AddDetail( ({"ast", "aeste"}),
    "Die Aeste des Mammutbaumes sind fast so dick, wie ein normaler Baum.");
  AddDetail( ({"krone", "wipfel", "kronen"}),
    "Die Wipfel der ringsum wachsenden Fichten und Tannen befinden sich"
    " auf derselben Hoehe. Wenn Sie nicht so weit entfernt stuenden,"
    " koenntest Du versuchen, da hinueberzuspringen.");
  AddDetail( ({"baum", "mammutbaum"}),
    "Der Mammutbaum hat hier in Wipfelhoehe der anderen Baeume ringsum"
    " seine untersten Aeste. Die Krone des Baums ueberragt alle anderen"
    " Baeume. Du kannst kaum die Blaetter im Wipfel des Baums ausmachen.");
  AddDetail( ({"wald", "waldbaum", "waldbaeume", "baeume", "nadelbaeume"}),
    "Ringsum stehen Fichten und Tannen, deren Wipfel sich auf derselben"
    " Hoehe befinden wie Du. Nur noch etwas hoeher muesste die Aussicht"
    " grossartig sein.");
  AddDetail( ({"fichte", "fichten"}),
    "Dir schiesst ein Gedanke durch den Kopf: von hier oben betrachtet"
    " sehen die Fichten aus wie kleine Hutzelmaennchen im gruenen Rock.");
  AddDetail( ({"hutzelmaennchen", "rock"}),
    "Die Fichten sehen wirklich so aus, es sind aber leider nur ganz "
    "normale Fichten.");
  AddDetail( ({"tanne", "tannen"}),
    "Die Tannen ueberragen die Fichten ein wenig, aber auch deren Wipfel"
    " sind nicht viel hoeher als Du bereits geklettert bist. Dir"
    " gegenueber steht eine Tanne gerade ausserhalb Deiner Reichweite. Ein"
    " klein bisschen naeher, und Du koenntest hinueberspringen...");
  AddDetail( ({"gedanke", "kopf", "details"}), 
    "Solche sinnlosen Details solltest Du nicht untersuchen!");
  AddSpecialDetail( ({"ein", "blitz", "versengt", "nase", "und", 
    "oberkoerper", "auauaua", "tut", "das", "weh", "erhaeltst", "eine",
    "mentale", "ohrfeige", "patsch", "das", "tat", "weh", "steinchen",
    "stuerzt", "trifft", "haargenau", "nasenwurzel", "ohgott", "sind",
    "schmerzen", "fuerchterliche", "solche", "rings", "nach", 
    "weit", "neben", "diese", "hier", "wasserfalls", "mammutbaums", "baums",
    "ringsum", "nur", "von"}), "NoScript");

  SetProp(P_KILL_NAME, "Ein dummes Untersuche-Script");
  SetProp(P_KILL_MSG, "bringt jedem den Tod!");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1]));

  AddSound( ({DEFAULT_SOUND, "rauschen", "wasserfall"}),
    "Von unten hoerst Du das Rauschen des Wasserfalls.");

  AddCmd( ({"spring", "springe"}), "jump");
  AddCmd( ({"kletter", "klettere"}), "climb");
  AddCmd( ({"rutsch"}), "slide");
}

int jump(string str) 
{
  if (str == "tanne" || str == "auf tanne" || str == "zu tanne"
      || str == "runter") 
  {
    deathJump();	// man stuerzt unweigerlich ab...
    return 1;		// aber vielleicht ueberlebt man's (50%)
  }
  notify_fail("Wohin willst Du denn springen?\n");
  return 0;
}

void deathJump() 
{
  write(BS("Du nimmst all Deinen Mut zusammen und springst zur am naechsten"
    " stehenden Tanne."));
  say(BS(TP->name() + " konzentriert sich einen Augenblick lang und springt "
     "dann zur am naechsten stehenden Tanne."));
  TP->move( ROOM "freefall.lpc", M_GO | M_SILENT);
  // jetzt geht das Ueberlebenslotto los ;-)
  clone_object( OBJ "nix")->move(TP, M_NOCHECK);
}

int climb(string str) 
{
  if (str == "runter" || str=="hinunter" || str == "nach unten") 
  {
    this_player()->move( ROOM "0204.lpc", M_GO, "unten", "klettert nach",
      "klettert an einem Baumstamm herunter");
    return 1;
  }
  else if (str == "hoch" || str=="hinauf" || str=="rauf" ||
           str == "nach oben") 
  {
    this_player()->move( ROOM "baum2.lpc", M_GO, "oben", "klettert nach",
      "kommt heraufgeklettert");
    return 1;
  }
  notify_fail("Wohin willst Du denn klettern?\n");
  return 0;
}

int slide(string str) 
{
  if (str == "runter" || str=="hinunter" || str == "nach unten") 
  {
    this_player()->move( ROOM "0204.lpc", M_GO, "unten", "rutscht nach",
      "rutscht an einem Baumstamm herunter");
    return 1;
  }
  notify_fail("Wohin willst Du denn rutschen?\n");
  return 0;
}

