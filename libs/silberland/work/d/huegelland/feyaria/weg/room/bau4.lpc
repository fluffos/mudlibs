#include "../def.h"

inherit ROOM "bau_inh";

void create()
{
  ::create();

  AddSpecialDetail( ({"richtungen", "norden", "suedosten"}), "richtungen");

  AddExit(({"norden", "nordoben"}), "./bau2");  
  AddExit(({"suedosten", "suedostunten"}), "./bau5");
  SetProp(P_HIDE_EXITS, ({"suedosten", "norden"}) );

  AddItem( NPC "murmeltier", REFRESH_DESTRUCT);
}

string richtungen()
{
  return BS("Nach Norden geht der Gang steil hinauf, im Suedosten dagegen "
            "steil bergab. ");
}


