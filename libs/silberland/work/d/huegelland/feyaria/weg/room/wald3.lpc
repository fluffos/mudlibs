#pragma strong_types

#include <properties.h>
#include <moving.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT,"Ein schmaler Waldpfad");
  SetProp(P_INT_LONG, BS(
    "Du befindest Dich auf einem schmalen Waldpfad, der hier an einer "
    "Felswand endet, die steil in den Himmel ragt. Nach "+ CAP(ED4)+
    " fuehrt der Pfad steil in den Wald hinunter. Das Unterholz neben dem "
    "Pfad verhindert das Verlassen des Pfades.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:13, ENV_TERRAIN: TT_FOREST]));
  SetProp(P_INDOORS,0); 
  SetProp(P_LIGHT,1);
 
  CD_NADELWALD;
  CD_WALDPFAD;
  CD_WALDBODEN;

  AddDetail( ({"wand", "felswand"}),
    "Auf diese Felswand kannst Du sicher hinaufklettern, denn sie ist sehr "
    "rauh. Es gibt auch viele Risse, Kanten und Vorspruenge, an denen man "
    "sich festhalten kann.");
  AddDetail( ({"kante", "kanten", "vorsprung", "vorspruenge"}),
    "An den Kanten und Vorspruengen kann man sich sicher gut festhalten.");
  AddDetail( ({"risse", "riss"}),
    "Die meisten Risse sind so schmal, dass Du da mit Deinen Haenden keinen "
    "Halt finden kannst.");

  AddCmd( ({"kletter", "klettere"}), "klettern");

  AddExit(ED4, "./wald2" );
}

int klettern( string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if( str=="hoch" || str=="felswand" || str=="wand" || str=="wand hoch" ||
      str=="felswand hoch" || str=="rauf" || str=="wand rauf" || 
      str =="felswand rauf" )
  {
    write("Du kletterst die Felswand hinauf.\n");
    TP->move("/d/gebirge/eros/room/berg_e19", M_GO, "die Felswand hinauf",
      "klettert", "kommt von unten heraufgeklettert");
    return 1;
  }
  return 0;
}
