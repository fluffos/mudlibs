#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./hang.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_HANG;
  SetProp(P_INT_LONG, BS(
    "Immer noch fuehrt der Weg ueber einen endlosen Geroellhang, auf dem "
    "Gestruepp und Dornenhecken wuchern. ") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:9, ENV_TERRAIN: TT_MOUNTAIN]));

  CD_HANG;

  AddDetail( ({"gestruepp", "hecke", "hecken", "dornenhecken"}),
    "Das Gestruepp hier besteht hauptsaechlich aus Brombeer- und"
    " Himbeerhecken, die so verfilzt sind, dass man sie nicht betreten"
    " kann.");
  AddDetail( ({"brombeerhecke", "brombeerhecken", "himbeerhecke",
               "himbeerhecken"}),
    "Schade... es haengen leider keine reifen Beeren dran. Jemand hat "
    "hier schon alles abgeknabbert.");
  AddDetail( ({"beere", "beeren", "brombeere", "brombeeren", "himbeere",
               "himbeeren"}),
    "Alle Beeren wurden schon von jemandem gepflueckt und gegessen. "
    "Sogar einige Blaetter sind auch angeknabbert.");
  AddDetail( ({"blatt", "blaetter"}),
    "Da muss jemand eines grossen Hungers gelitten haben, denn einige "
    "Blaetter sind angeknabbert. Oder war das vielleicht ein Tier?");
  AddDetail( ({"jemand"}),
    "Der Jemand ist sicher kein unsichtbarer Magier sondern wohl ein Tier.");
  AddDetail( ({"hunger"}),
    "Du hast ploetzlich einen riesigen Hunger nach Himbeeren und "
    "Brombeeren.");
  AddDetail( ({"buschwerk", "busch", "buesche"}),
    "Auf dem Geroellboden koennen sich keine Baeume halten, nur"
    " verfilztes Buschwerk gedeiht hier in Huelle und Fuelle.");
  AddDetail( ({"baeume", "baum", "wald"}),
    "Baeume gibt es erst wieder im tiefer gelegenen Wald, wo es etwas "
    "waermer ist.");
  AddDetail( ({"huelle", "fuelle"}),
    " Das war doch nur eine figurative Redewendung. Also vergiss es.");
  AddDetail( ({"redewendung", "no", "comment", "no comment"}),
    "no comment!");

  AddItem( NPC "bergziege", REFRESH_DESTRUCT);

  AddCmd( ({"pfluecke", "pflueck"}), "pfluecken");
  AddCmd( ({"knabber", "knabbere"}), "knabbern");
  
  SetProp(P_HIDE_EXITS, ({ ED3}) );
  AddExit(ED7, "./0917.lpc" );
  AddExit( ({ED3, ED3OB}), "nach "+CAP(ED3OB)+"#./1117.lpc" );
}

int pfluecken(string str)
{
  notify_fail("Was willst Du pfluecken?\n");
  if( !str) return 0;
  if( member( ({"beere", "beeren", "himbeere", "himbeeren", "brombeere",
      "brombeeren"}), str) !=-1)
  {
    write( BS("Leider sind keine Beeren mehr da, die Du pfluecken koenntest. "
      "So ein Pech!"));
    return 1;
  }
  return 0;
}

int knabbern(string str)
{
  notify_fail( "An was willst Du knabbern?\n");
  if(!str) return 0;
  if( member( ({"an blatt", "an blaettern", "blatt", "blaetter"}), str)!=-1)
  {
    write(BS("Du knabberst an einem Blatt, aber spuckst es sofort wieder aus. "
          "Das ist wohl wirklich nur was fuer Bergziegen.") );
    say(BS( CAP_TPN+ " knabbert an einem Blatt und spuckt es sofort wieder "
             "aus."));
    return 1;
  }
  return 0;
}

