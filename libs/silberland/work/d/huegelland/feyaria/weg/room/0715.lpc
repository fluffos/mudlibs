#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./pass.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_PASS;
  SetProp(P_INT_LONG, BS(
    "Auf dieser Passhoehe pfeift der Wind. Darum wachsen hier auch nur noch "
    "ganz wenige Krueppelkiefern. Eine Kolonie von Murmeltieren hat hier "
    "ihre Hoehlen und Loecher gegraben. Ihnen scheint das kalte Wetter hier "
    "nichts auszumachen. Bei Deinem Anblick geben einige Murmeltiere einen "
    "Warnpfiff von sich und fast alle Murmeltiere verstecken sich in den "
    "Loechern. Der Pfad fuehrt von "+ CAP(ED6) +" steil aufwaerts nach "+
    CAP(ED3) +".") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:8, ENV_TERRAIN: TT_MOUNTAIN]));

  CD_PASS;

  AddDetail( ({"murmeltier", "murmeltiere"}),
    "Die Murmeltiere sind sehr scheu, darum kannst Du kaum welche "
    "erblicken. Nach der Anzahl der Hoehlen und Loecher, die sie gegraben "
    "haben, muessen hier aber sicher viele Murmeltiere leben.");
  AddDetail( ({"kolonie", "murmeltierkolonie"}),
    "Bei so vielen Wohnhoehlen kann man nur von einer Murmeltierkolonie "
    "reden.");
  AddDetail( ({"loch", "loecher", "hoehle", "hoehlen", "wohnhoehle",
               "wohnhoehlen"}),
    "Die Murmeltiere haben hier ueberall ihre Wohnhoehlen gegraben. Wenn Du "
    "keine Angst vor engen Hoehlen hast, kannst Du ja in eine der Hoehlen "
    "hineinkriechen.");
  AddDetail( ({"angst"}),
    "Du hast Angst vor engen Hoehlen?");  
  AddDetail( ({"wetter"}),
    "Das Wetter ist sehr kalt hier, aber das scheint den Murmeltieren nichts "
    "auszumachen.");  
  AddDetail( ({"anblick", "warnpfiff"}),
    "Bei Deinem Anblick geben einige Murmeltiere einen Warnpfiff von sich.");

  AddSound( ({"murmeltiere", "murmeltier", "pfeifen", "warnpfiff", "pfiff"}),
    "Du hoerst das Pfeifen der Murmeltiere.");

  AddItem( NPC "murmeltier", REFRESH_DESTRUCT);

  SetProp(P_HIDE_EXITS, ({ED3, ED6}) );
  AddExit( ({ED3, ED3OB}), "nach "+CAP(ED3OB)+"#./0815.lpc" );
  AddExit( ({ED6, ED6U}), "nach "+CAP(ED6U)+"#./0616.lpc" );

  AddCmd( ({"kriech", "krieche"}), "kriechen");
}

int kriechen(string str)
{
  notify_fail("Wohin willst Du hinein kriechen?\n");
  if( !str ) return 0;
  if( str=="hoehle" || str=="in hoehle" || str=="in hoehle hinein")
  {
    write("Du kriechst in die Murmeltierhoehle hinein.\n");
    TP->move(ROOM "bau1", M_GO, "in eine Murmeltierhoehle hinein", "kriecht",
        "kriecht herein");
    return 1;
  }
  return 0;
}

