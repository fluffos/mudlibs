#pragma strong_types

#include <properties.h>
#include <moving.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./talaue.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN:TT_HILL]));
  P_INT_SHORT_AU;
  SetProp(P_INT_LONG, BS(
    "Du stehst mitten in einer schoenen, sonnigen Talaue, die der Weg"
    " pfeilgerade von " + CAP(ED4) + " nach " + CAP(ED8) + " durchzieht."
    " Links und rechts des Wegs stehen Buesche, dahinter erstrecken sich"
    " saftige Wiesen. Im " + CAP(ED3) + " liegt ein Schilfguertel, dahinter"
    " hoerst Du Wasser plaetschern. Ein grosser Fliegenschwarm schwirrt "
    "um Deinen Kopf herum.") );

  CD_AUE;
  CD_AUE2;

  AddDetail( ({"muecke", "muecken", "mueckenschwarm", "schwarm", 
      "fliegen", "fliegenschwarm"}),
    "Nervend summt ein Mueckenschwarm um Deinen Kopf herum.");
  AddDetail( ({"sonne", "himmel"}),
    "Die Sonne scheint waermend vom Himmel herunter.");
  AddDetail( ({"schilf", "guertel", "schilfguertel"}),
    "Im " + CAP(ED2) + " liegt ein breiter Schilfguertel, hinter dem Du"
    " leise Wasser plaetschern hoerst. Das Schilf ist so hoch, dass Du"
    " nicht erkennen kannst, was dahinter liegt. Weit im " + CAP(ED2) + 
    " erkennst Du hinter dem Schilf den " N_BERG " im Dunst.");
  AddDetail( ({"wasser", "plaetschern"}),
    "Du kannst von hier aus kein Wasser sehen, aber Du hoerst es deutlich"
    " im Schilf plaetschern.");
  AddDetail( ({"dunst", N_BERG, "horizont"}),
    "Weit, weit im " + CAP(ED2) + " kannst Du den " N_BERG " im Dunst am"
    " Horizont erkennen.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Plaetschern des Wassers im Schilf.");
  AddSound( ({"wasser", "plaetschern"}),
    "Das Wasser plaetschert leise. Wenn Du Dich genau konzentrierst, kannst "
    "Du ein leises Piepen hoeren.");
  AddSound( "piepen",
    "Das Piepen kommt wahrscheinlich von einem Kueken eines Wasservogels.");
  AddSound( "kueken",
    "Welchem Kueken willst Du lauschen?");
  AddSound( "wasservogel",
    "Es koennte eine Ente sein.");
  AddSound( "ente",
    "Es ist doch nur ein Kueken.");
  AddSound( ({"entenkueken", "entlein"}),
    "Das kleine Entlein ruft nach seiner Mutter. Leider kannst Du das "
    "Entenkueken im dichten Schilf nicht finden, um ihm zu helfen.");
  AddDetail( ({"wasservogel", "wasservoegel", "ente", "enten", "kueken"}),
    "Wenn es sowas hier gibt, ist es im dichten Schilf gut verborgen.");
  AddDetail( ({"entenkueken", "entlein"}),
    "Das Entlein hat sich irgendwo im Schilf versteckt. Daher kannst Du es "
    "nicht sehen.");
  AddSound( ({"quaken", "frosch", "froesche"}),
    "Dem staendigen Quaken zufolge befinden sich Froesche im Schilfguertel.\n");

  AddRoomMessage( ({
      "Ein Mueckenschwarm summt nervend um Deinen Kopf herum.\n",
      "Eine kleine Fliege verirrt sich in Deinen Mund.\n",
      "Eine Fliege fliegt vor Deinen Augen herum.\n",
      "Eine Muecke setzt sich auf Deine Nase.\n",
      "Irgendetwas ist da gerade im Schilfguertel herumgehuepft.\n",
      "Dem staendigen Quaken zufolge befinden sich Froesche im Schilfguertel.\n",
      "Du hoerst ein Quaken aus dem Schilf.\n",
      "Das Summen des Fliegenschwarms nervt Dich.\n"}),
      20);
  
  SetProp(P_HIDE_EXITS, ({ED1, ED2, ED3}) );
  AddExit( ({ED1, ED2, ED3}), ([
      EX_DEST: "./sumpf2",
      EX_MSG: "biegt das Schilf auseinander und zwaengt sich durch",
      EX_PLMSG: BS("Du biegst das Schilf auseinander, zwaengst Dich durch und "
                   "stampfst in das feuchte Schilfgebiet hinaus.") ]) );
  AddExit(ED4, "./0513.lpc" );
  AddExit(ED8, "./0311.lpc" );
}


