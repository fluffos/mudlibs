#pragma strong_types

#include <properties.h>
#include <moving.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./huegel.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_HUEGEL;
  SetProp(P_INT_LONG, BS(
    "Du stehst am Rand einer Hochflaeche, die knapp unter Dir liegt. Im " +
    capitalize(ED7) + " liegt eine Talaue tief unter Dir, im " + 
    capitalize(ED3) + " plaetschert ein Bach in grossem Bogen ueber die "
    "Hochflaeche. Der Weg fuehrt hier von " + capitalize(ED2) + " nach " + 
    capitalize(ED6) + ".") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_HILL]));
  SetProp(P_LIGHT, 1);

  CD_HUEGEL; // Details fuer den Huegel, definiert in huegel.h
  CD_HUEGEL2;
  CD_HUEGEL3;
  CD_HUEGEL4;

  AddDetail( ({"rand"}),
    BS("Vor Dir liegt eine Hochflaeche, die nach " + capitalize(ED3) + 
      " leicht abfaellt, sodass man dort vielleicht hinunter rutschen"
      " kann. Hinter Dir im " + capitalize(ED7) + " endet die"
      " Hochflaeche abrupt und stuerzt fast senkrecht in eine tiefe Talaue."));
  AddDetail( ({"bach", "wasser"}),
    BS("In weitem Bogen fliesst ein Bach durch die Hochflaeche nach "
      + capitalize(ED2) + ".") );
  AddDetail("bogen",
    BS("Der Bach kommt aus " + capitalize(ED4) + " und fliesst in einem"
      " grossen Bogen nach " + capitalize(ED2) + ".") );
  AddSound( ({DEFAULT_SOUND, "bach", "plaetschern", "wasser"}),
    "Du hoerst das Plaetschern des Baches.");

  AddCmd( ({"rutsch", "rutsche"}), "slide");

  AddExit(ED6, "./0107.lpc");
  AddExit(ED2, "./0305.lpc");
}

int slide(string str) 
{
  if (str == "hang" || str == "aus" || str == "runter" || str== "hinunter"
     || str == ED3 || str == ("nach " + ED3)) 
  {
    write(" Du setzt Dich auf deinen Hosenboden und rutschst den Abhang"
	  " hinunter.\n");
    TP->move(ROOM "0307.lpc", M_GO, capitalize(ED3), "stolpert nach",
	      "rutscht auf "+TP->QueryPossPronoun(MALE, WEM, SINGULAR)+
              " Hosenboden herein");
      return 1;
  }
  notify_fail("Wohin willst Du denn rutschen?\n");
  return 0;
}
