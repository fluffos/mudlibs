#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./strand.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_STRAND;
  SetProp(P_INT_LONG,
    BS("Der Strand wird hier schmaler und endet im " + CAP(ED5) + " ganz,"
      " dort liegen Klippen, ueber die kein Pfad fuehrt. Ein Weg fuehrt"
      " hier in die Huegel nach " + CAP(ED7) + ".")
    );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN:TT_HILL]));

  CD_STRAND;

  SetProp (P_KILL_NAME, "Eine vereiterte Blutblase");

  AddDetail( ({"pfad", "weg", "huegel"}),
    "Ein Weg fuehrt hier in die Huegel nach " + CAP(ED7) + ". Nach "+
    CAP(ED5) + " ist der Weg durch die Kreideklippen versperrt.");
  AddDetail( ({"klippen", "klippe", "kreideklippen", "kreideklippe"}),
    "Diese Kreideklippen stuerzen senkrecht etwa hundert Meter tief ins"
    " Meer. Die Brandung tost am Fuss der Klippen; dort ist kein Pfad zu"
    " entdecken.");
  AddSpecialDetail( ({"fuss", "fuesse", "blasen", "mist"}),
    "_blasen");
  AddDetail( ({"kreide", "kreidefelsen", "felsen", "abbrueche", "abbruch"}),
    "Die Klippen bestehen aus Kreidefelsen. Das erklaert die steilen "
    "Abbrueche.");

  SetProp(P_HIDE_EXITS, ({ ED7 }) );
  AddExit(ED1, "./1419.lpc" );
  AddExit( ({ED7, ED7OB}), "nach "+CAP(ED7OB)+"#./1320.lpc" );

  AddItem( NPC "abenteurer", REFRESH_DESTRUCT);
  AddItem( "/d/andracia/yondala/hafen/obj/wal.lpc", REFRESH_DESTRUCT, 1);

}

string _blasen() 
{
  write("Du untersuchst Deine Fuesse. Oh Mist, Du hast Dir ein paar Blasen"
	" gelaufen!\n");
  say(TP->name() + " untersucht stoehnend seine Fuesse.\n");
  TP->do_damage(3 + random(5));
  return "";
} 
