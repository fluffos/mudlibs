// 27-12-1996  Feyaria@SilberLand

inherit "/std/room";

#include <language.h>
#include <properties.h>
#include <moving.h>
#include <combat.h>
#include "./sumpf.h"
#include "../def.h"

object *gefunden;
object *muench;

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Tief im Sumpf");
  SetProp(P_INT_LONG, BS(
    "Jetzt hast Du Dich endgueltig im Sumpf verlaufen. Du steckst bis zum "
    "Bauch im Schlamm, Deine Kleidung ist voll mit Schlammspritzern und Du "
    "kannst Dich kaum noch bewegen. Bald wirst Du voellig im Sumpf "
    "versinken. Wie Du von hier wohl wieder rauskommen kannst?"));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN: TT_SWAMP]));

  AddDetail( "sumpf",
    "Du steckst jetzt mitten im tiefen Sumpf fest. Der Boden ist schlammig "
    "und Du sinkst schon ziemlich tief ein. Langsam solltest Du Dich nach "
    "einem Ausgang umsehen.");
  AddDetail( "schlamm",
    "Deine Kleidung ist voellig mit Schlamm bedeckt, und mit jedem Schritt "
    "steigt die Gefahr, im Boden zu versinken. Noch geht Dir der Schlamm nur "
    "bis zum Bauch, aber wer weiss, was nach dem naechsten Schritt passiert?");
  AddDetail( "bauch",
    "Der Schlamm geht Dir bis zum Bauch.");
  AddDetail( "boden", 
    "Ein Koenigreich fuer ein Stueck festen Boden!");
  AddDetail( ({"koenig", "reich", "koenigreich"}),
    "Leider hast Du kein Koenigreich, dass Du gegen ein Stueck festen "
    "Bodens eintauschen koenntest. :-(");
  AddDetail( "stueck",
    "Ein Stueck festen Bodens wuerde Dir schon genuegen.");
  AddDetail( ({"ausgang", "ausgaenge"}),
    "Hier gibt es keinen sichtbaren Ausgang. Da musst Du Dich schon etwas "
    "anstrengen und selber einen suchen.");
  AddDetail( ({"schlammspritzer", "spritzer", "kleidung"}),
    "Die Schlammspritzer sind Dir jetzt voellig egal. Wichtig ist nur noch, "
    "wie Du hier wieder rauskommen kannst.");
  AddDetail( "weg",
    "Leider kannst Du den Weg nirgends sehen. Du weisst auch leider nicht "
    "mehr, in welcher Richtung der Weg ungefaehr liegt. Es gibt einfach "
    "keinen Orientierungspunkt hier.");
  SUMPF_DETAILS2;
  SUMPF_SENSE;

  AddDetail( ({"geschichte", "geschichten", "baron", "kanonenkugel"}),
    "Jetzt erinnerst Du Dich: Die Luegengeschichten des Barons M....\n"
    "Derjenige, der auf der Kanonenkugel geflogen ist.\n");
  AddDetail( ({"luegengeschichte", "luegengeschichten"}),
    "Kennst Du wirklich nicht die Luegengschichten des Baron Muenchha...");
  AddSpecialDetail( ({"baron muenchhausen", "muenchhausen"}),
    "muenchhausen");
  AddDetail( ({"haar", "haare", "haarschopf", "schopf"}),
    "Du befuehlst Deinen Haarschopf und raetselst, ob er Dich aus dem Sumpf "
    "bringen kann.");

  AddCmd( ({"such", "suche"}), "suchen");
  AddCmd( ({"zieh", "ziehe"}), "ziehen");

  gefunden= ({});
}

string muenchhausen()
{
  if( member_array(TP, gefunden)!=-1)
  {
/*    if( member_array(TP, muench)==-1)
    {
      muench+=({TP});
    }*/
    return BS("Jetzt weisst Du es aber! Muenchhausen zieht sich am eigenen "
              "*** aus dem Sumpf.");
  }
  return "Sowas siehst Du hier nicht.\n";
}

int suchen(string str)
{
  notify_fail("Was willst Du suchen?\n");
  if(!str) return 0;
  if( str == "sumpf" || str == "schlamm" || str == "nach sumpf" || 
      str == "nach schlamm" )
  {
    write("Du suchst im Sumpf und findest nur Schlamm.\n");
    return 1;
  }
  if( str == "im sumpf" || str == "im schlamm" || str == "in sumpf" ||
      str == "in schlamm" )
  {
    write("Du wuehlst im Schlamm herum und findest nichts ausser Schlamm.\n");
    return 1;
  }
  if( str == "ausgang" || str == "ausgaenge" || str == "nach ausgang" ||
      str == "nach ausgaengen" )
  {
    write( BS("Du suchst verzweifelt nach einem Ausgang, aber Du findest "
              "keinen. Dir faellt aber ploetzlich eine Geschichte ein, "
              "in der sich jemand selbst aus einem Sumpf befreit hat."));
    if( member_array(TP, gefunden)==-1)
    {
       gefunden+=({TP});
    }
    return 1;
  }
  return 0;
}

int ziehen(string str)
{
  object *hose;
  object *schuhe;
  string wie,haar;
//  if (member_array (TP, muench) == -1) return 0;
  notify_fail("Woran willst Du ziehen?\n");
  if(!str) return 0;
  if( str == "an haar" || str == "an haarschopf" || str == "an schopf" ||
      str == "an haaren" )
  {
    notify_fail( BS("Du ziehst an Deinem Haarschopf und kommst tatsaechlich "
                  "etwas aus dem Sumpf heraus. Vielleicht solltest Du etwas "
                  "fester ziehen?"));
    return 0;
  }
  if( sscanf(str, "%s an %s",wie, haar)==2 )
  {
    if( (wie =="fest" || wie == "fester") && (haar == "haarschopf" ||
      haar == "schopf" || haar == "haaren" || haar == "haar"))
    {
      write( BS("Du ziehst fest an Deinem Haarschopf und kommst tatsaechlich "
                "mit dem ganzen Koerper aus dem Sumpf heraus."));
      if( TP->QueryProp(P_ARMOURS) )
      {
        schuhe=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_BOOT); 
        if (sizeof(schuhe) && objectp(schuhe[0])) 
        {
          schuhe[0]->remove(M_SILENT);
          write("Zu Deinem Pech bleiben Deine Schuhe im Sumpf stecken.\n");
        }
      }
      if(random(3)==0 && TP->QueryProp(P_ARMOURS))
      {
        hose=filter_objects(TP->QueryProp(P_ARMOURS), "id", AT_TROUSERS); 
        if (sizeof(hose) && objectp(hose[0]))
        {
          hose[0]->remove(M_SILENT);
          write("Jetzt hast Du auch noch Deine Hose verloren!\n");
        }
      }
    }
    TP->move(ROOM "0311",M_GO,"aus dem Sumpf raus", "zieht sich selbst",
       "kommt schlammbespritzt aus dem Sumpf");
    return 1;
  }
  return 0;
}

void reset()
{
  gefunden=({});
  ::reset();
}
