#pragma strong_types

#include <properties.h>
#include <wizlevels.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./hang.h"
#include "./wald.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_HANG;
  SetProp(P_INT_LONG, BS(
    "Du stehst in einer Spitzkehre auf dem Pfad nach " N_STADT ". Hier "
    "endet der dichte Wald in kleinen Krueppelkiefern. Weiter oben kann "
    "sich kaum noch ein Baum halten, nur dichtes Gestruepp wuchert dort. "
    "Nach "+ CAP(ED6) +" fuehrt ein schmaler Weg den baumlosen Hang "
    "hinunter. Neben dem Weg hat jemand einen grossen Wegweiser in den "
    "Boden gerammt."));
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:14, ENV_TERRAIN:TT_HILL]));

  CD_HANG;
  CD_WALD;

  AddDetail ("wegweiser", "Hmmm, lies doch mal!\n");
  AddReadDetail ("wegweiser",
    "\n ,------------------------------------.\n"
      " |            Kristallwald            |\n"
      " |                Elessar             |\n"
      " |                   .                |\n"
      " |                   |                |\n"
      " |             ------+                |\n"
      " |           /       |                |\n"
      " |          /     Silberwald,         |\n"
      " |     Derlim      Midas,             |\n"
      " |                                    |\n"
      " `---------------.----,---------------'\n"
      "                 |    |\n"+
      "                 |    |\n\n");


  AddDetail( ({"kehre", "spitzkehre", "serpentine"}),
    "Die Serpentine ist so eng, dass einer der ueblichen Haendlerkarren"
    " gerade noch wenden kann.");
  AddDetail( ({"waldrand", "rand"}),
    "Nun ja, 'Waldrand' ist wohl ein wenig uebertrieben. Dort unten"
    " wachsen die ersten Baeume, die auch als solche zu erkennen sind, aber"
    " der Uebergang von Gestruepp zu Wald ist eher fliessend und nicht so"
    " genau festzulegen.");
  AddDetail("uebergang",
    "Aber Vorsicht! Dir wird schon sehr mulmig zumute, und Du beschliesst,"
    " hier keine weiteren Einzelheiten zu untersuchen.");
  AddDetail( ({"vorsicht", "einzelheit", "einzelheiten", "script"}),
    "Lass Dich bloss nicht erwischen, Du Script!");
  AddDetail( ({"pfad", "weg", "lucke", "luecken"}),
    "Der Weg oder vielmehr Pfad ist kaum noch zu erkennen, nur die"
    " fortgesetzten Luecken im Gestruepp lassen den Verlauf des Wegs"
    " erkennen.");
  AddDetail( ({"gestruepp", "kiefer", "kiefern", "krueppelkiefer",
               "krueppelkiefern"}),
    "Die Kiefern wachsen hier nur noch zu seltsam verdrehtem Gestruepp"
    " heran, Staemme haben sie keine mehr. Das kommt wohl vom staendig"
    " blasenden Wind hier.");
  AddDetail( ({"wind"}),
    "Der Wind blaest staendig hier.");
  AddDetail( ({"stamm", "staemme", "wiederholung", "langsamdenker" }),
    "Ist ja gut, hier nochmal die Wiederholung fuer Langsamdenker: KEINE"
    " Staemme mehr.");
  AddDetail( ({"wiederholung", "langsamdenker", "vorsicht", "scriptfalle",
               "untersuchungen", "konsequenzen", "murren", "erde"}),
    "Vorsicht, Das Ist Eine Scriptfalle. Also Lass Weitere Untersuchungen"
    " Hier...Oder Trage Die Konsequenzen. Aber Ohne Zu Murren!");
  AddSpecialDetail( ({"weiter", "nun", "dort", "aber", "lass",
      "wegs", "ist", "keine", "eine", "also", "weitere", "hier", "oder",
      "trage", "ohne" "zu", "selbst", "verschlingt", "bestrafen", "wegen",
      "scriptens", "untersuchst", "ein", "verbotenes", "wort", "und", "es",
      "explodiert", "in", "hand"}),
   "NoScript");

  AddItem ( "/d/huegelland/raballion/hobbits/npc/hobbit", REFRESH_DESTRUCT);

  SetProp(P_HIDE_EXITS, ({ED6}) ); 
  AddExit(ED3, "./0819" );
  AddExit(ED2, "./0818" );
  AddExit( ({ED6U, ED6}), "nach "+CAP(ED6U)+"#"WESTWEG_KRISTALLWALD);
}

