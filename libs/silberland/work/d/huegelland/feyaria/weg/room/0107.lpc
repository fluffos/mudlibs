#pragma strong_types

#include <properties.h>
#include <moving.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./huegel.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_HUEGEL;
  SetProp(P_INT_LONG, BS(
    "Du stehst am Nordrand einer Hochflaeche, die knapp"
    " unter Dir liegt. Im " + capitalize(ED7) + " faellt ein Hang steil ab"
    " in eine Talaue, die tief unter Dir liegt. Der Weg biegt hier von " + 
    capitalize(ED2) + " nach " + capitalize(ED4) + ".") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:15, ENV_TERRAIN:TT_HILL]));
  SetProp(P_LIGHT, 1);

  CD_HUEGEL; // Details fuer den Huegel, definiert in huegel.h
  CD_HUEGEL2;
  CD_HUEGEL3;
  CD_HUEGEL4;

  AddDetail( ({ ("nordrand"), "rand"}),
    "Du stehst am Rand einer Hochebene, die nach "+ CAP(ED3)+ " flach "
    "abfaellt. Keine Strasse fuehrt dort hinunter, aber vielleicht kann man "
    "dort hinunter rutschen.");
  AddDetail( ({"bogen", "biegung", "kurve"}),
    BS("Der Weg macht hier einen Bogen von " + capitalize(ED2) + " nach "
      + capitalize(ED4) + ".") );
  AddDetail( ({"strasse"}),
    BS("Strasse? Welche Strasse? Das hier ist ein Weg, der gerade breit"
      " genug ist, um ein kleines Waegelchen durchzulassen.") );
  AddDetail( ({"waegelchen", "wagen"}),
    BS("Im Moment ist gerade keiner da. Nur die Karrenspuren zeugen von"
      " ihrer frueheren Anwesenheit.") );
  AddDetail( ({"anwesenheit", "abzaehlen", "jawoll"}),
    BS("Abzaehlen! Jawoll, Du bist da.") );

  AddCmd( ({"rutsch", "rutsche"}), "slide");

  AddExit(ED4, "./0208.lpc");
  AddExit(ED2, "./0206.lpc");
}

int slide(string str) {
  if (str == "hang" || str == "aus" || str == "runter" || str == "hinunter"
      || str == ED3 || str == ("nach "+ ED3) ) 
  {
    write("Du setzt Dich auf deinen Hosenboden und rutschst den Abhang"
      " hinunter.\n");
    TP->move(ROOM "0307.lpc", M_GO, "nach unten", "verschwindet", "rutscht auf "+
      TP->QueryPossPronoun(MALE, WEM, SINGULAR)+" Hosenboden herein.");
      return 1;
  }
  notify_fail("Wohin willst Du denn rutschen?\n");
  return 0;
}
