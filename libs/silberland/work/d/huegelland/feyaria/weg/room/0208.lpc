#pragma strong_types

#include <properties.h>
#include <moving.h>
#include <combat.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./huegel.h"
#include "./schlucht.h"

/*** PROTOTYPES ***/
int enter(string str);

int mure;
/***IMPLEMENTATION ***/

inherit "std/room";

void create()
{
  ::create();

  mure=0;
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:14, ENV_TERRAIN:TT_HILL]));
  P_INT_SHORT_HUEGEL;
  SetProp(P_INT_LONG, BS(
    "Du stehst am Rand einer Hochflaeche, die sich im " + capitalize(ED2) + 
    " von hier ausdehnt. Der Weg fuehrt am Rand der Hochflaeche nach "
    + capitalize(ED8) +". Im " + capitalize(ED4) + " liegt weit unter Dir"
    " ein See, in dem sich der gegenueberliegende Berggipfel spiegelt. Im "+ 
    capitalize(ED3) + " windet sich der Weg in atemberaubenden Serpentinen"
    " entlang einer Steilwand den Berg hinauf.") +
    "Ein LAWINEN-WARNSCHILD.\n"
    "Eine Bergwacht-Huette.\n" );

  CD_SCHLUCHTPFAD;
  CD_HUEGEL; // Details fuer den Huegel, definiert in huegel.h
  CD_HUEGEL2;
  CD_HUEGEL3;
  CD_HUEGEL4;
  CD_SEE_WEIT;
  CD_BERG_WEIT;

  AddDetail( ({"steilwand", "wand"}),
    "Im "+ capitalize(ED3) + " windet sich der Weg in atemberaubenden "
    "Serpentinen entlang einer Steilwand den Berg hinauf.");
  AddDetail( ({"rand", "kante"}),
    "Im " + capitalize(ED2) + " dehnt sich eine riesige, leicht hueglige"
    " Hochflaeche, die leicht nach " + capitalize(ED3) + " geneigt ist und"
    " hier entlang einer unregelmaessigen Kante in Richtung " + 
    capitalize(ED8) + " abrupt an einem tiefen Abgrund endet.");
  AddDetail( ({"schild", "warnschild", "lawinen-warnschild",
      "lawinenwarnschild"}),
    WARNSCHILD_TEXT );
  AddReadDetail( ({"schild", "warnschild", "lawinen-warnschild",
      "lawinenwarnschild"}),
    WARNSCHILD_TEXT );
  AddDetail( ({"huette", "bergwacht-huette", "bergwacht", "blockhuette",
               "bergwnachthuette"}),
    BS("Eine kleine, heimelige Blockhuette. Ueber der Tuer haengt ein"
      " Schild:") + "\n"
    "+-------------------+\n"
    "| B E R G W A C H T |\n"
    "+-------------------+\n");
  AddDetail("tuer",
    "Die Tuer ist nur angelehnt, Du kannst die Huette jederzeit betreten.");

  AddCmd( ({"betritt", "betret", "betrete"}), "enter");

  AddItem( NPC "retter", REFRESH_DESTRUCT);

  SetProp(P_HIDE_EXITS, ({ED3}) );
  AddExit( ({ ED3, ED3OB}) , "nach "+CAP(ED3OB)+"#./0308.lpc");
  AddExit(ED8, "./0107.lpc");
}

int enter(string str)
{
  if (str == "huette" || str == "bergwacht" || str == "bergwacht-huette")
  {
    TP->move( ROOM "huette.lpc", M_GO, "die Bergwacht-Huette", "betritt",
      "kommt herein");
      return 1;
  }
  notify_fail("Was willst Du denn betreten?\n");
  return 0;
}

void add_mure()
{
  mure=1;
  tell_room(TO, "Eine Mure geht hernieder und verschuettet den Weg nach "+CAP(ED3OB)+".\n");
  RemoveExit( ({ED3, ED3OB}));
  AddSpecialExit( ({ED3, ED3OB}), "mure" );
  SetProp(P_HIDE_EXITS, ({ED3, ED3OB}) );
  AddDetail( ({"lawine", "geroell", "geroellawine", "geroelllawine",
             "baeume", "muren", "mure", "bergwacht"}),
    "Auch hier ging erst kuerzlich eine Mure nieder. Sie hat einige"
    " Baeume plattgewalzt und den Weg fuer eine Weile unpassierbar gemacht,"
    " hoffentlich wird die Bergwacht den Pfad bald wieder freiraeumen.");
  SetProp(P_INT_LONG, BS(
    "Du stehst am Rand einer Hochflaeche, die sich im " + capitalize(ED2) + 
    " von hier ausdehnt. Der Weg fuehrt am Rand der Hochflaeche nach "
    + capitalize(ED8) +". Im " + capitalize(ED4) + " liegt weit unter Dir"
    " ein See, in dem sich der gegenueberliegende Berggipfel spiegelt. Im "+ 
    capitalize(ED3) + " ist der Weg durch eine Mure versperrt.") +
    "Ein LAWINEN-WARNSCHILD.\n"
    "Eine Bergwacht-Huette.\n" );
}

void init()
{
  ::init();
  if( mure && present("bergwacht-mann") )
   call_out("mure_weg", 2);
}

void mure_weg()
{
  if( mure )
  {
    tell_room(TO, "Der Bergwachtmann macht sich an die Arbeit und schaufelt "
        "die Mure weg.\nDer Weg nach "+CAP(ED3OB)+" ist wieder passierbar.\n");
    RemoveExit( ({ED3, ED3OB}));
    AddExit( ({ ED3, ED3OB}) , "nach "+CAP(ED3OB)+"#./0308.lpc");
    SetProp(P_HIDE_EXITS, ({ED3}) );
    mure=0;
    AddDetail( ({"lawine", "geroell", "geroellawine", "geroelllawine",
          "baeume", "muren", "mure", "bergwacht"}),
        "Auch hier ging erst kuerzlich eine Mure nieder. Sie hat einige"
        " Baeume plattgewalzt und den Weg fuer eine Weile unpassierbar gemacht,"
        " aber inzwischen hat die Bergwacht den Pfad freigeraeumt.");
    SetProp(P_INT_LONG, BS(
          "Du stehst am Rand einer Hochflaeche, die sich im " + capitalize(ED2) + 
          " von hier ausdehnt. Der Weg fuehrt am Rand der Hochflaeche nach "
          + capitalize(ED8) +". Im " + capitalize(ED4) + " liegt weit unter Dir"
          " ein See, in dem sich der gegenueberliegende Berggipfel spiegelt. Im "+ 
          capitalize(ED3) + " windet sich der Weg in atemberaubenden Serpentinen"
          " entlang einer Steilwand den Berg hinauf.") +
        "Ein LAWINEN-WARNSCHILD.\n"
        "Eine Bergwacht-Huette.\n" );
    call_other( ROOM "0308", "mure_weg" );
  }
}

int mure()
{
  write("Hier geht es nicht weiter, der Weg ist durch eine Mure versperrt.\n");
  return -1;
}

