#pragma strong_types

#include <properties.h>
#include <wizlevels.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./hang.h"
#include "./wald.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_HANG;
  SetProp(P_INT_LONG, BS(
    "Immer noch laeufst Du auf dem endlosen Hang. Im " + CAP(ED6) +" "
    "erkennst Du eine Spitzkehre am Waldrand. Nach "+ CAP(ED2) +" fuehrt "
    "der Weg steil den Geroellhang hinauf. Auf beiden Seiten des Weges "
    "bilden dichte Buesche ein undurchdringliches Gestruepp.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:11, ENV_TERRAIN:TT_HILL]));

  CD_HANG;
  CD_WALD;

  AddDetail( ({"kehre", "spitzkehre", "serpentine"}),
    "Unten am Waldrand wurde eine Spitzkehre angelegt. Geh hin, wenn Du"
    " sie Dir genauer anschauen willst.");
  AddDetail( ({"waldrand", "rand", "uebergang"}),
    "Nun ja, 'Waldrand' ist wohl ein wenig uebertrieben. Dort unten"
    " wachsen die ersten Baeume, die auch als solche zu erkennen sind, aber"
    " der Uebergang von Gestruepp zu Wald ist eher fliessend und nicht so"
    " genau festzulegen.");
  AddDetail( ({"baum", "baeume"}),
    "Die Baeume wachsen erst weiter unten im Wald.");
  AddDetail( ({"immer", "nach", "auf", "weges", "unten", "geh", "nun",
               "dort", "aber", "script", "details"}),
    "Solche dummen Details untersucht nur ein Script! Bist Du eins?");
//  AddSpecialDetail( ({"solche", "bist"}), "NoScript");
//  AddSpecialDetail( ({"xyrtzhiknd", "fcsordelsp", "zgkeocjwd", "plfdneixc"}),
//    "NoXP");

  SetProp(P_HIDE_EXITS, ({ED2}) );
  AddExit(ED6, "./0719.lpc" );
  AddExit( ({ED2, ED2OB}), "nach "+CAP(ED2OB)+"#./0917.lpc" );
}

string NoScript()
{
  string *str;
  str=({"Xyrtzhiknd", "Fcsordelsp", "Zgkeocjwd", "Plfdneixc"});
  if( !IS_SEER(TP) )
    return "Du dummes Script!!!\n";
  return BS( "Wenn Du "+str[random(4)]+" untersuchst, verlierst Du ALLE "
         "Erfahrungspunkte! Wenn Du das machst, bist Du selbst schuld!");
}

string NoXP()
{
  string str;
  if( !IS_SEER(TP))
    return "Sowas siehst Du hier nicht.\n";
  str=sprintf("Verlust: %d XP.\n",TP->QueryProp(P_XP) );
  write_file(LOG "scriptfalle",
    ctime()+": "+CAP(getuid(TP))+" loest die Scriptfalle in 0818.c aus. "+
    str );
  TP->SetProp(P_XP,0);
  return BS("Der Daemon der Dummheit erscheint und nimmt Dir alle "
         "Erfahrungspunkte weg, denn Scripts brauchen ja keine!");
}
