#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./huegel2.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_HUEGEL;
  SetProp(P_INT_LONG,
    BS("Du wanderst in einem kleinen Tal zwischen zwei Huegeln; der Weg"
      " windet sich zwischen den Hoehen hindurch, um unnoetige Steigungen"
      " zu vermeiden. Ein Zaun grenzt den Weg zu einer Kuhweide ab."));
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN:TT_HILL]));

  CD_HUEGEL;
  CD_HUEGEL2;

  AddDetail( ({"zaun", "weide", "kuhweide", "kuehe"}),
    "Dieser Zaun soll den Weg von der Kuhweide abtrennen. Dummerweise "
    "hat der Zaun ein Loch, sodass die Kuehe von der Weide auf den Weg "
    "heraus kommen. Aber so kannst auch Du hier die Weide betreten.");
  AddDetail( ({"loch"}),
    "Der Zaun hat ein Loch, sodass Du hier die Weide betreten kannst.");

  AddDetail( ({"landschaft", "huegelllandschaft", "huegel"}),
    "Der Weg fuehrt bergauf und bergab durch eine huebsche"
    " Huegellandschaft. Du siehst einen bewaldeten Berg nah im " +
    CAP(ED8) + ", der mit zwei Gipfeln weithin sichtbar ist.");
  AddDetail("berg",
    "Ein riesiger Berg mit zwei Gipfeln ueberragt die Landschaft. Die"
    " unteren Regionen sind bewaldet, weiter oben glaenzen kahle"
    " Felswaende in der Sonne.");
  AddDetail( ({"gipfel", "felswand", "felswaende"}),
    "Hoch ueber Dir glaenzen die steilen Felswaende in der waermenden"
    " Sonne. Darunter breiten sich Geroellfelder und Buschwerk aus.");
  AddDetail( ({"geroellfeld", "geroellfelder", "buschwerk", "busch",
               "buesche", "strand"}),
    "Vielleicht solltest Du naeher hingehen, um mehr zu sehen.");
  AddDetail( ({"wald", "baeume", "hang", "haenge"}),
    "Die Haenge des im " + CAP(ED1) + " liegenden Berges sind im unteren"
    " Bereich bewaldet.");
  AddDetail( ({"steigung", "steigungen", "tal", "hoehen"}),
    "Der Weg windet sich ziemlich flach in einem kleinen Tal zwischen"
    " den Huegeln, um unnoetige Steigungen zu vermeiden.");

  AddExit(ED6, "./1219.lpc" );
  AddExit(ED1, "./1317.lpc" );

  AddItem( NPC "kuh", REFRESH_DESTRUCT);
/*  
  AddExit( "weide", ([ EX_DEST: "./kweide1",
                       EX_MSG: "auf die Kuhweide",
                       EX_PLMSG: "Du betritst die Kuhweide.\n"])
                       );
  SetProp(P_HIDE_EXITS, ({"weide"}) );
*/ 
  AddCmd( ({"betrete", "betritt", "betret"}), "betreten");
}

int betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if( !str ) return 0;
  if( str=="weide" || str=="kuhweide")
  {
    write("Du betrittst die Kuhweide.\n");
    TP->move(ROOM "kweide1", M_GO, "die Kuhweide", "betritt");
    return 1;
  }
  return 0;
}

