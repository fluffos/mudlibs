
#include "../def.h"
#include "../squest.h"

inherit ROOM "bau_inh";

void create()
{
  ::create();

  AddSpecialDetail( ({"richtungen", "sueden", "schlafraum"}),
    "richtungen");
  AddDetail( ({"stroh"}),
    "Die Murmeltiere haben sich kleine Nester aus dem Stroh gebaut.");
  AddDetail( ({"nest", "nester"}),
    "Die Murmeltiere schlafen in diesen Nestern. Sicher verstecken sie dort "
    "auch alles, was sie so finden.");
  
  AddExit(({"sueden"}), "./bau6");

  AddItem( NPC "murmeltier", REFRESH_DESTRUCT, 
      ([P_NOCORPSE: 0, P_DIE_MSG: " faellt tot um.\n"]) );
  AddItem( NPC "murmeltier", REFRESH_DESTRUCT, 
      ([P_NOCORPSE: 0, P_DIE_MSG: " faellt tot um.\n"]) );

  AddCmd( ({"wuehl", "wuehle", "durchwuehle", "durchwuehl"}), "wuehlen");
  AddCmd( ({"such", "suche", "durchsuch", "durchsuche"}), "suchen");
}

string richtungen()
{
  return BS("Dies hier ist sicher ein Schlafraum, denn viel Stroh liegt "
            "hier herum. Nach Sueden geht es zum Gang zurueck. ");
}

int suchen(string str)
{
  notify_fail( "Was willst Du durchsuchen?\n");
  if( !str ) return 0;
  if( member( ({"nest", "nester", "in nest", "in nestern", "stroh", 
                "in stroh"}), str) == -1 )
    return 0;
  if( present("murmeltier") )
  {
    write("Das Murmeltier laesst Dich nicht an das Nest heran.\n");
    return 1;
  }
  write( BS( "Du durchsuchst die Nester, findest aber nichts. Vielleicht "
             "solltest Du dich mal da wirklich durchwuehlen."));
  say(CAP_TPN+ " durchsucht erfolglos die Nester.\n");
  return 1;
}

int wuehlen(string str)
{
  object squest;
  notify_fail( "Was willst du durchwuehlen?\n");
  if( !str ) return 0;
  if( member( ({"nest", "nester", "in nest", "in nestern", "stroh",
                "in stroh"}), str) == -1 )
    return 0;
  if( present("murmeltier") )
  {
    write("Das Murmeltier laesst Dich nicht an das Nest heran.\n");
    return 1;
  }
  if( (squest=present(SPINNENQUEST_ID,TP)) && 
       !present("\nhirtenjunge_murmeln", TP) && 
      TP->QueryProp(P_GENDER)==MALE ) 
  {
    if( squest->query_quest() == SQ_DODO_BEFRAGT+SQ_JUNGE_BEFRAGT )
    {
      write( BS("Du durchwuehlst die Nester und findest tatsaechlich die "
              "Murmeln des Hirtenjungen, die Du sofort einsteckst."));
      CLONE(OBJ "murmeln", TP);
      squest->set_quest(SQ_MURMEL_GEFUNDEN);
      say(CAP_TPN+" durchwuehlt die Nester und findet etwas.\n");
      return 1;
    }
  }
  write( BS( "Du durchwuehlst die Nester und wirfst das ganze Stroh durch "
             "die Luft, findest aber nichts."));
  say(CAP_TPN+" durchwuehlt die Nester, findet aber nichts.\n");
  return 1;
}

