#pragma strong_types

#include <properties.h>
#include <moving.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./pass.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_PASS;
  SetProp(P_INT_LONG, BS(
    "Auf dieser Passhoehe pfeift der Wind, Du fuehlst Dich unbehaglich "
    "kalt. Darum waechst hier auch fast nichts mehr. Du hast hier den "
    "hoechsten Punkt des Passes erreicht, denn der Pfad fuehrt nach "+
    CAP(ED3) +" und "+ CAP(ED8) +" steil abwaerts. Weit ueber Dir schwebt "
    "ein Adler in den Lueften. Laut toent sein Kreischen uebers Land. ") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:6, ENV_TERRAIN: TT_MOUNTAIN]));

  CD_PASS;

  AddSound(DEFAULT_SOUND,
    "Das Pfeifen des Windes wird noch uebertoent vom Kreischen des Adlers"
    " ueber Dir.");
  AddSound( ({"wind", "pfeifen"}),
    "Der Wind pfeift.");
  AddSound( ({"adler", "kreischen"}),
    "Kiiiiiiiaaaaaaaaaa...... kiiiiiiiaaaaaaa.......");
  AddDetail( ({"pass", "passhoehe"}),
    "Hier ist alles Grau in Grau: nur noch Felsen, kaum ein Halm gedeiht"
    " hier. Links und rechts des Wegs geht es weiter hinauf zu den"
    " Gipfeln, zwischen denen der Pass hindurchfuehrt.");
  AddDetail( ({"adler"}),
    "Der Adler schwebt laut kreischend weit ueber Dir und zieht in der"
    " Thermik seine Kreise ohne einen einzigen Fluegelschlag.");
  AddDetail( ({"thermik"}),
    "Durch die Thermik wird der Adler in der Luft gehalten, ohne einen"
    " Fluegel zu bewegen.");
  AddDetail( ({"luft", "kaelte"}),
    "Die Luft hat hier eine eisige Kaelte.");
  AddDetail( ({"kreis", "kreise", "eck", "ecken"}),
    "Ein Eck ohne Ecken nennt man meistens Kreis, oder? Also lass die"
    " bloeden Untersuchungen.");
  AddDetail( ({"gipfel"}),
    "Zwei kahle Gipfel ueberragen den Pass der zwischen ihnen durchfuehrt. "
    "Auf dem noerdlichen Gipfel scheint ein riesiger Adlerhorst zu sein. "
    "Wenn du mutig bist, kannst Du vielleicht dort hinaufklettern.");
  AddDetail( ({"noerdlicher gipfel", "adlerhorst"}),
    "Auf dem noerdlichen Gipfel scheint ein riesiger Adlerhorst zu sein. "
    "Wenn du mutig bist, kannst Du vielleicht dort hinaufklettern.");
  AddDetail( ({"fels", "felsen", "masse", "massen", "felsmassen"}),
    "Grau und maechtig ueberragen Dich die Felsmassen der beiden Gipfel,"
    " zwischen denen der Pass hindurchfuehrt. Als unfreundlichen Gruss"
    " haben diese Gipfel ein paar groessere Felsen in den Pass"
    " geschleudert, die der Weg umgeht.");

  AddItem( NPC "adler", REFRESH_DESTRUCT);

  AddCmd( ({"kletter", "klettere"}), "klettern");
  SetProp(P_HIDE_EXITS, ({ED3, ED8}) );
  AddExit( ({ED3, ED3U}), "nach "+CAP(ED3U)+"#./1016.lpc" );
  AddExit( ({ED8, ED8U}), "nach "+CAP(ED8U)+"#./0815.lpc" );
}

int klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if( !str ) return 0;
  if( str=="gipfel" || str=="auf gipfel")
  {
    notify_fail("Auf welchen Gipfel willst Du klettern?\n");
    return 0;
  }
  if( member(({"auf suedlichen gipfel", "suedlichen gipfel", "suedgipfel",
               "auf suedgipfel"}),str)!=-1)
  {
    notify_fail("Der suedliche Gipfel ist zu steil zum Erklettern.\n");
    return 0;
  }
  if( member(({"auf noerdlichen gipfel", "noerdlichen gipfel", "nordgipfel",
               "auf nordgipfel"}),str)!=-1)
  {
    write("Du kletterst auf den noerdlichen Gipfel und erreichst den "
        "Adlerhorst.\n");
    say(CAP_TPN+" .\n");
    TP->move(ROOM "adlernest", M_GO, "auf den noerdlichen Gipfel hinauf",
        "klettert", "kommt heraufgeklettert");
    return 1;
  }
  return 0;
}
