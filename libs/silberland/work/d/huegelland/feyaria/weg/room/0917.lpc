#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./hang.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_HANG;
  SetProp(P_INT_LONG, BS(
    "Immer noch laeufst Du auf dem endlosen Hang, das Geroell ist nach wie "
    "vor von undurchdringlichem Gestruepp bedeckt. Der Weg verlaeuft von "+
    CAP(ED6) +" nach "+ CAP(ED3)+ " den Hang hinauf.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_TERRAIN: TT_MOUNTAIN]));

  CD_HANG;

  SetProp(P_HIDE_EXITS, ({ ED6}) );
  AddExit( ({ED6, ED6U}), "nach "+CAP(ED6U)+"#./0818.lpc" );
  AddExit(ED3, "./1017.lpc" );
}
