#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_WALDWEG;
  SetProp(P_INT_LONG,
    BS("Kontinuierlich steigt der Weg am Berg empor. Links und rechts des"
    " Wegs wachsen Baeume, und die Fliegen und Kaefer summen im Unterholz."));
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN: TT_FOREST]));

  CD_WALD;
  CD_WALDWEG;
  CD_WALDBODEN;

  AddDetail("berg",
    "Der Berg ist recht steil, so dass es nicht ratsam waere, den Weg zu"
    " verlassen.");
  AddDetail( ({"hochwald", "fliegen", "kaefer", "unterholz"}),
    "Das Uebliche: Ein normaler Hochwald eben, mit Kaefern, Fliegen und"
    " Baeumen.");
  AddDetail( ({"uebliche", "monster", "uebeltier"}),
    "Oho... ein automatisches Uebeltier. Argl, eigentlich haettest Du Dich"
    " eben Selbstloeschen sollen, wenn Du ein ordentlich programmiertes"
    " Monster waerst. Aber nichtsdestotrotz warten hier ein Paar"
    " Unannehmlichkeiten auf Dich...");
  AddDetail( ({"selbstloeschen", "unannehmlichkeiten"}),
    "Noch nicht, aber wart's mal ab... ;-)");
  AddSound( ({DEFAULT_SOUND, "summen", "kaefer", "fliegen"}),
    "Du hoerst das Summen der Fliegen und Kaefer.");
  AddSmell( ({DEFAULT_SMELL, "duft", "waldduft"}),
    "Du laesst den beruhigenden Waldduft in Deine Lungen einstroemen.");

  AddItem( NPC "huegelkatze", REFRESH_DESTRUCT);
  
  SetProp(P_HIDE_EXITS, ({ED3}) );
  AddExit( ({ED3, ED3U}), "nach "+CAP(ED3U)+"#./1118.lpc" );
  AddExit(ED7, "./0918.lpc" );
}
