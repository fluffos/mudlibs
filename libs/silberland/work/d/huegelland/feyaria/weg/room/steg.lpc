// /d/huegelland/feyaria/weg/room/steg.c
// 1997-09-24  Feyaria@SilberLand

#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "/d/wasser/feyaria/schiffe.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Auf einem Steg");
  SetProp(P_INT_LONG, BS(
    "Du stehst auf einem kleinen Steg, von dem Schiffe wegfahren. Das Meer "
    "erstreckt sich weit nach Norden, im Osten erkennt man hinter einer "
    "flachen Sandbank einige sanfte Huegel und im Dunst dahinter kann man "
    "einige Berge erahnen. Im Westen befinden sich bewaldete Huegel, hinter "
    "denen sich irgendwo das Hobbitdorf befinden muss. "
    "Nach Suedosten kommt man auf den Strand zurueck.")+
    "Ein Schiffsfahrplan.\n");
  SetProp(P_INDOORS,0); 
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:17, ENV_TERRAIN: TT_ROAD]));
  SetProp(P_LIGHT,1);

  AddDetail( ({"schiffsfahrplan", "fahrplan", "plan"}),
    "Du kannst ihn lesen.");
  AddReadDetail( ({"schiffsfahrplan", "fahrplan", "plan"}),
    "---------------------------------------------------\n"
    "|                                                 |\n"
    "|  Eisbrecher: nach Smoersky                      |\n"
    "|                                                 |\n"
    "|  Handelsschiff: nach Midas, Tijara und Smoersky |\n"
    "|              ( in unregelmaessigen Abstaenden ) |\n"
    "|                                                 |\n"
    "|  Handelskogge: nach Midas                       |\n"
    "|                                                 |\n"
    "|  Kuestensegler: rund ums SilberLand             |\n"
    "|                                                 |\n"
    "---------------------------------------------------\n");
  AddDetail( ({"steg"}),
    "Von diesem Steg fahren nur sehr wenige Schiffe ab, darum ist er auch "
    "so klein. Er besteht aus Holzplanken.");
  AddDetail( ({"planken", "holzplanken", "holz", "boden"}),
    "Der Steg besteht aus Holzplanken.");
  AddDetail( ({"schiff", "schiffe"}),
    "Es ist gerade kein Schiff da, vielleicht solltest Du noch etwas warten.");
  AddDetail( ({"meer", "norden", "wasser"}),
    "Das Meer ist gruenblau und erstreckt sich weit nach Norden. Weit draussen "
    "schwimmt etwas herum. Was mag das wohl fuer ein Wesen sein?");
  AddDetail( ({"wesen"}),
    "Du kneifst Deine Augen zusammen und identifizierst das Wesen als einen "
    "grossen Wal.");
  AddDetail( ({"wal"}),
    "Der Wal ist leider zu weit weg, um ihn genauer zu erkennen.");
  AddDetail( ({"sandbank", "osten"}),
    "Im Osten erkennt man hinter einer flachen Sandbank einige sanfte Huegel.");
  AddDetail( ({"sand"}),
    "Die Sandbank besteht natuerlich aus Sand.");
  AddDetail( ({"dunst", "berg", "berge"}),  
    "Im Dunst kann man die Berge nur erahnen. Sicher sind sie sehr hoch.");
  AddDetail( ({"westen" }),
    "Im Westen befinden sich bewaldete Huegel.");
  AddDetail( ({"huegel"}),
    "Huegel gibt es am ganzen Land. Im Osten schliessen hinter den Huegeln "
    "Berge an, die man aber im Dunst schlecht erkennen kann. Hinter den "
    "Huegeln im Sueden muss sich wohl das Hobbitdorf befinden, die Huegeln im "
    "Westen hingegen sind ziemlich bewaldet.");
  AddDetail( ({"sueden", "dorf", "hobbitdorf", "hobbingen", "derlim"}),
    "Das Hobbitdorf befindet sich irgendwo im Sueden hinter dem Strand in "
    "den Huegeln. Es wird auch Hobbingen oder Derlim genannt.");
  AddDetail( ({"wald"}),
    "Die Huegel sind nur leicht bewaldet, einen echten Wald kann man das "
    "nicht nennen."); 
  AddDetail( ({"strand", "suedosten"}),
    "Zum Strand kommt man nach Suedosten zurueck.");
  AddDetail( ({"himmel", "sonne"}),
    "Hoch oben im Himmel steht die Sonne und laesst das Meer gruenblau "
    "funkeln.");
  
  AddSmell( ({DEFAULT_SMELL, "meer"}),
    "Es riecht nach Meer.");
  AddSound( ({DEFAULT_SOUND, "rauschen", "wellen", "welle", "brandung"}),
    "Man hoert das Rauschen der Wellen.");

  AddExit(ED1, "./1818" );

  AddItem( EISBRECHER, REFRESH_DESTRUCT, 1);
  AddItem( KUESTENSEGLER, REFRESH_DESTRUCT, 1);
  AddItem( HANDELSKOGGE, REFRESH_DESTRUCT, 1);
}
