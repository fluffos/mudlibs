#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"
#include "./huegel2.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_WALDWEG;
  SetProp(P_INT_LONG,
    BS("Du bist am Waldrand angelangt. Im " + CAP(ED4) + " breitet sich eine"
      " Huegellandschaft aus, dahinter kannst Du eine Bucht erkennen. Im " +
      CAP(ED7) + " steigt der Weg steil in die Berge auf, die Gipfel kannst"
      " Du von hier aus nur erahnen. Weit weg im " + CAP(ED3) + " ist noch"
      " eine saftiggruene Ebene zu erkennen, die ein weisser Sandstrand von"
      " einer Bucht abgrenzt.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN:TT_HILL]));

  CD_HUEGEL;
  CD_HUEGEL2;
  CD_WALD;
  CD_WALDWEG;
  CD_WALDBODEN;

  AddDetail( ({"berg", "berge"}),
    "Der Berg ist recht steil, so dass es nicht ratsam waere, den Weg zu"
    " verlassen.");
  AddDetail( ({"gipfel", "berg", "berge", "fels", "felsmassen"}),
    "Durch den Dunst kannst Du verschwommen zwei weit entfernte Gipfel"
    " erkennen, deren Felsmassen weisslich in der Sonne glaenzen.");
  AddDetail( ({"dunst"}),
    "Ein wenig Dunst truebt die Sicht, sodass entfernte Dinge nur"
    " undeutlich zu erkennen sind.");
  AddDetail( ({"sicht", "fernsicht"}),
    "Durch den Dunst ist die Fernsicht heute nicht besonders gut.");
  AddDetail( ({"ebene"}),
    "Weit weg im " + CAP(ED3) + " liegt eine saftiggruene Ebene, die"
    " durch einen schmalen weissen Streifen Strand vom Meer getrennt"
    " wird.");
  AddDetail( ({"streifen", "strand", "sandstrand", "meer", "bucht"}),
    "Das Meer liegt weit, weit im " + CAP(ED3) + ", von der angrenzenden"
    " Ebene nur durch einen schmalen weissen Sandstrand getrennt. Durch"
    " den Dunst kannst Du keine Einzelheiten erkennen.");
  AddDetail( ({"einzelheit", "einzelheiten"}),
    "Einzelheiten? Nix da, es ist zu dunstig.");
  AddDetail( ({"huegel", "huegellandschaft", "landschaft"}),
    "Im " + CAP(ED4) + " breitet sich eine Huegellandschaft aus, die"
    " wohl einigen Rindern als Weide dient. Zumindest laesst der Geruch"
    " darauf schliessen.");
  AddDetail( ({"waldrand"}),
    "Im " + CAP(ED7) + " beginnt der Wald. Am Waldrand wachsen viele"
    " Buesche und Straeucher, weiter hinten nur noch hohe Baeume.");
  AddDetail( ({"busch", "buesche", "strauch", "straeucher"}),
    "Am Waldrand wachsen viele Buesche und Straeucher, weiter hinten nur "
    "noch hohe Baeume.");

  AddSound( DEFAULT_SOUND,
    "Hier ist es angenehm ruhig.");

  SetProp(P_HIDE_EXITS, ({ED7}) );
  AddExit(ED2, "./1217.lpc" );
  AddExit( ({ED7, ED7OB}), "nach "+CAP(ED7OB)+"#./1018.lpc" );
}
