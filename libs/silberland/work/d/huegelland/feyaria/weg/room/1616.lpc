#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./strand.h"

inherit "std/room";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In einer Furt");
  SetProp(P_INT_LONG,
    BS("Du stehst mitten in einer Furt. Freundliche Hobbits haben hier"
      " Trittsteine quer durchs Flussbett gelegt, was kaum wundert, denn"
      " Hobbits moegen Wasser ueberhaupt nicht und denken zudem, dass Boote"
      " lebensgefaehrliche Apparate sind."));
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN:TT_HILL]));

  CD_STRAND;

  AddDetail( ({"flussbett", "bett"}),
    "Im Flussbett schlaeft der Fluss. Was soll der Fluss denn sonst alleine in "
    "seinem Bett machen?");
  AddDetail( ({"boden"}),
    "Der Boden ist voller Wasser, nur einige Trittsteine verhindern, dass "
    "Deine Fuesse nass werden.");
  AddDetail( ({"furt"}),
    "Die Furt fuehrt ueber den Fluss. Das scheint der einzige Weg zu sein, "
    "um die andere Seite der Bucht zu erreichen.");
  AddDetail( ({"stein", "steine", "trittstein", "trittsteine", "meissel"}),
    "Fein saeuberlich sind hier extra hergestellte Trittsteine in die"
    " Furt gelegt worden. Die Oberflaeche der Steine wurde mit einem"
    " feinen Meissel rautiert, damit man nicht so leicht ausrutschen kann.");
  AddDetail( ({"oberflaeche"}),
    "Die Oberflaeche ist rautiert. Das erhoeht die Oberflaeche des"
    " Steins, damit steigt die Reibung, und schlussendlich ist es deshalb"
    " schwieriger, auf dem Stein auszurutschen als auf einem Stein mit"
    " polierter Oberflaeche, besonders wenn er, wie dieser hier, staendig"
    " nass und von einem gruenlichen Algenschmierfilm ueberzogen ist."
    " Zufrieden?");
  AddDetail( ({"reibung", "algen", "alge", "film", "schmier", "schmierfilm",
               "algenschmierfilm", "bruecke"}),
    "Dir wird auf einmal ganz schwarz vor Augen. Ob es sinnvoll ist,"
    " weiter in der Furt herumzustehen?");
  AddDetail( ({"boot", "boote"}),
    "Hier koennen ganz bestimmt keine Boote durchfahren, da die"
    " Trittsteine so eng beieinander liegen. Du erinnerst Dich, dass"
    " Hobbits Boot fahren ueberhaupt nicht lieben, und Dir wird klar, warum"
    " man hier keine Bruecke gebaut hat.");
  AddDetail( ({"furt", "fluss"}),
    "Das Wasser hier ist ganz schwarz, es gefaellt Dir ueberhaupt nicht."
    " Dustyseidank liegen hier diese Trittsteine, so dass Du Dir nicht"
    " die Fuesse nass machen musst.");
  AddDetail("wasser",
    "Das schwarze Wasser sieht sehr ungesund aus, ebenso wie das Moor im "
    + CAP(ED1) + ".");
  AddDetail( ({"tiefebene", "ebene", "sumpf", "moor", "au", "auen"}),
    "Beiderseits des Flusses im " + CAP(ED1) + " liegt ein Sumpf, der"
    " voellig undurchdringlich aussieht. Kein Baum, kein Strauch waechst"
    " in den giftig-gruenen Auen.");
  AddDetail( ({"baum", "strauch"}),
    "Vielleicht solltest Du einmal Raumbeschreibungen lesen... da stand"
    " doch, dass _kein_ Baum und _kein_ Strauch im Moor wachsen.");
  AddDetail( ({"hobbit", "hobbits"}),
    "Freundliche, kleine Wesen, die am liebsten zuhause sitzen.");
  AddDetail( ({"zuhaus", "zuhause"}),
    "Das ist verdammt weit weg...");
  AddDetail( ({"huegel", "gras", "huegellandschaft", "landschaft"}),
    "Die Huegel im " + CAP(ED7) + " sind mit saftiggruenem Gras"
    " bewachsen, auf der Seeseite liegen ein paar Duenen zwischen dem"
    " Strand und der fruchtbaren Huegellandschaft.");
  AddDetail( ({"duenen", "sand", "sandduenen"}),
    "Etwas weiter landeinwaerts hat der Wind den Sand zu Duenen verweht."
    " Sie sind nicht besonders hoch, aber es waere sicher sehr unbequem"
    " ueber den losen Sand zu gehen. Besonders stabil sieht dieser"
    " ueberigens nicht aus.");
  AddDetail( ({"wind", "brise"}),
    "Wie so oft an der See weht hier eine staendige Brise, mal landein,"
    " mal landab. Du koenntest einen Drachen steigen lassen, wenn Du"
    " wolltest.");
  AddDetail( ({"drachen", "drache"}),
    "Wo ist ein Drache?");
  AddDetail( ({"berg", "kuestenberg", "bergriese"}),
    "Im " + CAP(ED1) + " steht ein wahrer Bergriese, mit weiss"
    " leuchtenden Schneefeldern unterhalb des Gipfels. Dagegen sieht der"
    " Kuestenberg mit zwei Gipfeln im " + CAP(ED8) + " fast armselig aus,"
    " aber auch dieser ist sehr hoch, man sagt, noch niemand habe ihn"
    " bestiegen.");
  AddDetail( ({"schnee", "schneefeld", "schneefelder", "gipfel"}),
    "Vielleicht solltest Du da etwas naeher rangehen, um Einzelheiten zu"
    " erkennen.");

  AddRoomMessage( 
    ({BS("Ein giftig-gruener, schleimiger Fisch springt kurz vor Dir aus"
    " dem Wasser und platscht wieder zurueck. Du wirst von ein paar"
    " Spritzern getroffen."),
    "Du rutscht fast auf einem Stein aus.\n",
    "Das Wasser schwappt ueber einen Trittstein.\n"}),50);


  AddExit(ED3, "./1717.lpc" );
  AddExit(ED6, "./1517.lpc" );
}
