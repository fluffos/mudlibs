#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./pass.h"

inherit "std/room";

void create() 
{
  ::create();

  P_INT_SHORT_PASS;
  SetProp(P_INT_LONG, BS(
    "Auf dieser Passhoehe pfeift der Wind. Darum wachsen hier auch nur noch "
    "ganz wenige Krueppelkiefern. Der Pfad fuehrt von "+ CAP(ED7) +" steil "
    "aufwaerts nach "+ CAP(ED4) +". Neben dem Pfad sind Steine zu einem "
    "grossen Haufen aufgetuermt.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:7, ENV_TERRAIN: TT_MOUNTAIN]));

  CD_PASS;

  AddDetail( ({"haufen", "reste", "ueberreste"}),
    "Bei dem Haufen handelt es sich vielleicht um die Ueberreste eines "
    "Grabes, denn der Boden hier ist zu hart, um zu graben.");
  AddDetail( ({"grab"}),
    "Das ist wohl das Grab eines Wanderers, der hier oben verunglueckt ist. "
    "Vielleicht kannst Du ja eine Inschrift finden, auf der die "
    "Todesursache steht.");
  AddDetail( ({"tod", "todesursache", "ursache"}),
    "In den Bergen gibt es viele Todesursachen: Stuerme, Gewitter, wilde "
    "Tiere, Felsspalten, Erfrieren und noch vieles mehr.");
  AddDetail( ({"sturm", "stuerme", "gewitter", "wetter"}),
    "Zum Glueck ist das Wetter zur Zeit ganz ruhig.");
  AddDetail( ({"kaelte", "erfrieren"}),
    "Es hat zwar eine ziemliche Kaelte hier, aber erfrieren wirst Du hier "
    "nicht.");
  AddDetail( ({"tier", "tiere"}),
    "Kein wildes Tier weit und breit. Aber sei trotzdem vorsichtig.");
  AddDetail( ({"spalt", "felsspalt", "spalten", "felsspalten"}),
    "Solange Du auf dem Weg bleibst, wirst Du auch nicht in eine Felsspalte "
    "fallen.");
  AddDetail( ({"wanderer"}),
    "Da Du auch ein Wanderer bist, solltest Du aufpassen, dass Du nicht "
    "auch mal in so einem Grab liegst.");
  AddDetail( ({"inschrift"}),
    "Du solltest die Inschrift suchen.");
  AddSpecialDetail( ({"auf", "darum", "der", "neben", "bei", "grabes",
     "fast", "nur", "solche", "dummen", "details", "soll", "man", "nicht",
     "untersuchen"}), "disco");

  AddCmd( ({"such", "suche"}), "suchen");

  SetProp(P_HIDE_EXITS, ({ED4, ED7}) );
  AddExit( ({ED4, ED4OB}), "nach "+CAP(ED4OB)+"#./0916.lpc" );
  AddExit( ({ED7, ED7U}), "nach "+CAP(ED7U)+"#./0715.lpc" );
}

