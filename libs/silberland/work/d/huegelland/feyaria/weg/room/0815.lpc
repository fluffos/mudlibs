int suchen(string str)
{
  string wie, wo;
  notify_fail("Was willst Du suchen?\n");
  if(!str) return 0;
  if( sscanf(str, "inschrift %s %s",wie, wo)==2)
  {
    if( (wie=="in" || wie=="auf" || wie=="im" || wie=="an") && 
        (wo=="grab" || wo=="haufen") )
    {
      write("Du findest eine Inschrift auf der steht:\n\n"
        "         ########################################################\n"
        "         #    Hier starb der Sohn des Gouverneurs von Tijara    #\n"
        "         #       im Kampf mit einem riesigen Steinadler.        #\n"
        "         #                                                      #\n"
        "         #                Friede seiner Seele.                  #\n"
        "         ########################################################\n"
        "\n\n");
      return 1;
    }
  }
  else if( str[0..8]=="inschrift" )
    notify_fail("Wo willst Du die Inschrift suchen?\n"); 
  else if( str=="haufen" || str=="grab")
    notify_fail("Den Haufen zu finden war nicht schwer.\n");
  else if( member( ({"stein", "steine", "felsen", "geroell", "bloecke",
                     "block", "felsblock", "felsbloecke", "brocken", 
                     "felsbrocken"}), str)!=-1)
    notify_fail("Du findest viele Steine.\n");
  else
    notify_fail("Du suchst, aber findest nichts.\n");
  return 0;
}

