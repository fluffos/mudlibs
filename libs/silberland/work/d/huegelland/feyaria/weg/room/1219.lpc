#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./huegel2.h"
#include "/d/huegelland/feyaria/osterhase/oh.h"

inherit "std/room";

int gras;

void create() 
{
  ::create();
 
  gras=random(5);

  P_INT_SHORT_HUEGEL;
  SetProp(P_INT_LONG,
    BS("Huegelpfad ist wohl die richtige Beschreibung fuer diesen Weg: links "
      "und rechts liegen rollende Huegel, die mit saftigem, grasgruenen "
      "Gras nur so strotzen. Kein Wunder, dass hie und da ein Hirtenjunge "
      "auf eine Herde Kuehe aufpasst, und ein paar Pferde frei in ihren "
      "Koppeln herumtollen."));
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:16, ENV_TERRAIN:TT_HILL]));

  CD_HUEGEL;
  CD_HUEGEL2;

  AddDetail( ({"beschreibung"}),
    "Genauso wie hier kann man einen Huegelpfad beschreiben.");
  AddDetail( ({"pferd", "pferde", "koppel", "koppeln"}),
    "Auf einigen Koppeln tummeln sich Pferde, die in der Sonne"
    " herumtollen.");
  AddDetail( ({"kuh", "kuehe", "hirte", "hirten", "junge", "jungen",
               "hirtenjunge", "hirtenjungen", "herde", "kuhherde"}),
    "Hie und da weidet eine Kuhherde, die von einem Hirtenjungen bewacht"
    " wird.");
  AddDetail( ({"landschaft", "huegelllandschaft", "huegel"}),
    "Der Weg fuehrt bergauf und bergab durch eine huebsche"
    " Huegellandschaft. Du siehst einen bewaldeten Berg nah im " +
    CAP(ED8) + ", der mit zwei Gipfeln weithin sichtbar ist.");
  AddDetail("berg",
    "Ein riesiger Berg mit zwei Gipfeln ueberragt die Landschaft. Die"
    " unteren Regionen sind bewaldet, weiter oben glaenzen kahle"
    " Felswaende in der Sonne.");
  AddDetail( ({"gipfel", "felswand", "felswaende"}),
    "Hoch ueber Dir glaenzen die steilen Felswaende in der waermenden"
    " Sonne. Darunter breiten sich Geroellfelder und Buschwerk aus.");
  AddDetail( ({"geroellfeld", "geroellfelder", "buschwerk", "busch",
               "buesche", "strand"}),
    "Vielleicht solltest Du naeher hingehen, um mehr zu sehen.");
  AddDetail( ({"wald", "baeume", "hang", "haenge"}),
    "Die Haenge des im " + CAP(ED1) + " liegenden Berges sind im unteren"
    " Bereich bewaldet.");
  AddDetail( ({"himmel", "sonne", "wolke", "wolken"}),
    "Einige Wolken ziehen an der Sonne vorbei durch den ansonsten"
    " blitzblanken Himmel. Das Wetter ist schoen, aber ein wenig schwuel"
    " und dunstig.");
  AddDetail( ({"dunst", "regen", "luft"}),
    "Vom letzten Regen haengt noch ein wenig Dunst in der Luft, deshalb"
    " ist es auch so schwuel hier.");
  AddDetail( ({"gras"}),
    "Das Gras ist hier richtig saftig grasgruen. Am liebsten wuerdest Du das "
    "Gras ausrupfen und sofort verschlingen.");
  AddDetail( ({"gruenes gras"}),
    "Es ist wirklich ein  ein richtiges grasgruenes Gras.");
  AddDetail( "grasgruenes gras",
    "So eine schoene grasgruene Farbe wie diese Gras findet man nur selten.");
  AddDetail( ({"farbe", "farben"}),
    "Es gibt viele Farben hier, aber das Gruen des Grases ist am schoensten.");
  AddDetail( ({"gruen", "gruene farbe"}),
    "Die Farbe ist nicht nur Gruen sondern richtig Grasgruen.");
  AddDetail( ({"grasgruen", "grasgruene farbe"}),
    "Es ist wirklich ein richtiges grasgruenes Gras. Wenn Du eine gruene "
    "Farbe brauchst, solltest Du Dir hier etwas Gras mitnehmen.");

  AddCmd( ({"rupf", "rupfe"}), "rupfen");
  AddCmd( ({"maehe", "maeh"}), "maehen");
  
  AddExit(ED4, "./1320.lpc" );
  AddExit(ED2, "./1318.lpc" );
}

int rupfen(string str)
{
  notify_fail("Was willst Du ausrupfen?\n");
  if( !str ) return 0;
  if( member( ({"gras aus", "gras", "bueschel gras aus", "grasbueschel aus"}),
               str)!=-1 )
  {
    write( BS("Du versuchst das Gras auszureissen, bist aber nicht stark "
              "genug. Besorg dir doch ein Hilfsmittel!"));
    say(BS(CAP(TPN)+" versucht ein Bueschel Gras auszureissen, ist aber "
         "zu schwach."));
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();
  gras=random(5);
}

int maehen(string str)
{
  object ob;
  notify_fail("Was willst Du maehen?\n");
  if(str=="gras" || str=="gras mit sense" || str=="grasbueschel" || 
     str == "grasbueschel mit sense" )
  {
    if ( !present("sense", TP) ) 
    {
      write("Aber dazu brauchst Du doch eine Sense!\n");
      return 1;
    }
    if( ob=present( OSTERHASENQUEST_ID, TP) )
    {
      if( ob->query_color("gruen") )
      {
        write(BS("Es lohnt sich doch gar nicht, hier Gras abzumaehen, denn "
          "Du hast ja noch genug gruene Farbe."));
        return 1;
      }
      write("Du maehst etwas grasgruenes Gras ab und machst gruene Farbe "
        "daraus.\n");
      ob->set_color("gruen");
      return 1;
    }
    write( BS("Mit Deiner Sense maehst Du einige Bueschel Gras ab und "
              "steckst sie sofort ein."));
    say( BS(CAP(TPN)+" maeht einige Bueschel Gras mit einer Sense und steck "
         "das Gras ein.")); 
    CLONE(OBJ "gras", TP);
    return 1;
  }
  return 0;
}

