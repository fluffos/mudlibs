#include "../def.h"

inherit ROOM "bau_inh";

void create()
{
  ::create();

  AddSpecialDetail( ({"richtungen"}), "richtungen");
  AddDetail( ({"sackgasse"}),
    "Hier endet der Gang in einer Sackgasse, denn die Erde wird hier "
    "von hartem Fels abgeloest.");
  AddDetail( ({"fels", "felsen"}),
    "Durch den harten Fels konnten die Murmeltiere nicht mehr weitergraben.");

  AddExit( ({"westen"}), "./bau2" );
}

string richtungen()
{
  return BS("Hier endet der Gang in einer Sackgasse, denn die Erde wird hier "
         "von hartem Fels abgeloest und die Murmeltiere konnten nicht mehr "
         "weitergraben. ");
}
