#pragma strong_types

#include <properties.h>
#include <ansi.h>
#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

#define ZEICHNUNG \
      "\n ,------------------------------------.\n"\
      " |                                    |\n"\
      " |                        Gebirge,    |\n"\
      " |                     /  Felonia     |\n"\
      " |     Derlim,        /               |\n"\
      " |  Kristallwald, ---+                |\n"\
      " |    Elessar,       |                |\n"\
      " |                Silberwald,         |\n"\
      " |                 Midas,             |\n"\
      " |                                    |\n"\
      " `---------------.----,---------------'\n"\
      "                 |    |\n"\
      "                 |    |\n\n"
void create() 
{
  ::create();

  P_INT_SHORT_WALDWEG;
  SetProp(P_INT_LONG, BS(
    "Hier aendert sich der Charakter des Waldes: hier oben ueberwiegen "
    "Nadelbaeume, waehrend weiter unten die Laubbaeume ueberwiegen. Nach "+
    CAP(ED7)+ " fuehrt ein schmaler Pfad in den Wald. In einem Baum am "
    "Wegrand ist eine Zeichnung geschnitzt.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:14, ENV_TERRAIN: TT_FOREST]));
  
  CD_NADELWALD;
  CD_WALDWEG;
  CD_WALDBODEN;

  AddDetail( ({"baum", "wegrand"}),
    "In einem Baum am Wegrand ist eine Zeichnung geschnitzt. Sie schaut aus "
    "wie ein Wegweiser.");
  AddDetail( ({"zeichnung", "wegweiser"}), ZEICHNUNG );
  AddReadDetail( ({"zeichnung", "wegweiser"}), ZEICHNUNG );
  
  AddDetail( ({"pfad", "waldpfad"}),
    "Der Waldpfad fuehrt nach " +CAP(ED7)+ " in den Nadelwald hinein.");
  AddDetail( ({"laubbaum", "laubbaeume"}),
    "Laubbaeume siehst Du nur weiter unten aus der Ferne. Hier oben "
    "wachsen nur noch Nadelbaeume.");
  AddDetail( ({"charakter", "seele", "seelen"}),
    "Na ich weiss nicht... frag da lieber mal einen Seelendoktor.");
  AddDetail( ({"seelendoktor", "doktor"}),
    "Im Moment ist keiner da. Aber untersucht der Tod nicht die Seelen "
    "der Verstorbenen?");
  AddDetail( ({"moment"}),
    "Im Moment scheinst Du mehr Zeit zu haben, als Dir lieb ist.");
  AddDetail( ({"zeit"}),
    "Sie vergeht.");
  AddDetail( ({"fern", "ferne"}),
    "Warum denn in die Ferne schweifen, wenn das Gute liegt so nah?");
  AddDetail( ({"gut", "gute"}),
    "Oh wie schoen... Du denkst an die guten Dinge des Lebens...");
  AddDetail( ({"ding", "dinge", "dingsbums"}),
    "Ein paar Dinge fallen Dir ein, die jetzt besonders gut waeren... "
    "insbesondere ein Dingsbums, ein Troepfchen, ein Schlueckchen, ein... "
    "#$&*! Wie hiess das noch gleich?");
  AddDetail( ({"tropfen", "troepfchen"}),
    "Der Tod erscheint und sagt: BEEIL DICH! ES KOENNTE DEIN LETZTER SEIN!");
  AddDetail( ({"schluck", "schlueckchen"}),
    "Lars ruft Dir zu: Weiter so!");
  AddDetail( ({"lars"}),
    "Lars grinst wie ein Honigkuchenpferd.");
  AddDetail( ({"honigkuchenpferd"}),
    "Ein Honigkuchenpferd sagt: Du guckst aber daemlich aus der Waesche!");
  AddDetail( ({"waesche"}),
    "Puuuhhh... Du solltest Deine Waesche mal wieder waschen.");
  AddDetail( ({"tod", "auge", "zettel", "moment", "kaffee", "woody",
    "lohn", "lohnerhoehung", "kurz", "seele", "schnell", "monster",
    "rufbereitschaft", "notfall", "mann", "service", "jedermann" }),
    "Vor Deinem geistigen Auge erscheint ein Zettel:\n"
    "+------------------------------------------+\n"
    "|Der Tod ist im Moment nicht erreichbar:   |\n"
    "|-  Bei Lars Kaffee trinken                |\n"
    "|-  Bei Woody um Lohnerhoehung erbitten    |\n"
    "==> "+ANSI_BOLD+"Kurz mal eine Seele einsammeln"+ANSI_NORMAL+"         |\n"
    "|-  Schnell mal ein Monster recyclen       |\n"
    "|         ----                             |\n"
    "|-  Ich bin voraussichtlich ____ wieder da |\n"
    "==> "+ANSI_BOLD+"Ich habe Rufbereitschaft..."+ANSI_NORMAL+"            |\n"
    "|     wenn Du mich brauchst, stirb einfach |\n"
    "|-  Ich moechte nicht gestoert werden,     |\n"
    "|     wende Dich im Notfall an ______      |\n"
    "|                                          |\n"
    "|  DER MANN MIT DEM PERSOENLICHEN SERVICE  |\n"
    "|       FUER JEDERMANN ERSCHWINGLICH       |\n"
    "+------------------------------------------+\n"
    );
  AddSpecialDetail( ({ "mit", "dem", "persoenlichen",
     "fuer", "erschwinglich", "irgendwie", "hier", "na", "im",
     "aber", "warum", "oh", "beeil", "es", "koennte", "letzer", "sein",
     "weiter", "puuuhhh", "bei","solche", "dummen", "soll", "man",
    "nicht", "untersuchen"}),  "disconect");
    
  AddDetail( ({"zaubertrunk", "zaubertrank", "zt"}),
    "Oooochh... wieder nix :-(");

  AddSound( ({"wind", "saeuseln", "wald"}),
    "Der Wald ist hier ganz ruhig.");
  AddSmell( ({DEFAULT_SMELL}),
    "Irgendwie riecht es komisch hier.");

  SetProp(P_HIDE_EXITS, ({ ED2}) );
  AddExit(ED4, "./0213.lpc" );
  AddExit( ({ED2, ED2U}), "./0414.lpc" );
  AddExit(ED7, "./wald1");

  AddItem(OSTERHASE, REFRESH_DESTRUCT, 1);
}

