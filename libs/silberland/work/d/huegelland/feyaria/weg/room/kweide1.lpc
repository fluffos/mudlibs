#include "../def.h"
#include "./kuhweide.h"

inherit "/std/room";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, P_INT_SHORT_KUHWEIDE);
  SetProp(P_INT_LONG, BS(
    "Du stehst mitten auf einer Kuhweide inmitten einer Huegellandschaft. "
    "Das Gras am Boden ist saftig gruen - das ideale Viehfutter. Die Weide "
    "ist durch einen Zaun abgegrenzt. Dummerweise hat der Zaun hier ein "
    "Loch, sodass die Kuehe die Weide verlassen koennen.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:17, ENV_TERRAIN:TT_HILL]) );

  DET_KUHWEIDE;

  AddDetail( ({"loch"}),
    "Der Zaun hat hier ein Loch, sodass die Kuehe die Weide verlassen "
    "koennen.");

  AddExit("suedwesten", "./kweide2");
  AddExit("sueden", "./kweide3");
  AddExit("suedosten", "./kweide4");
  AddExit("weg", "durch den Zaun auf den Weg hinaus#./1318");
  SetProp(P_HIDE_EXITS, ({"weg"}) );

  AddCmd( ({"verlasse", "verlass"}), "verlassen");
  AddCmd( ({"kletter", "klettere"}), "klettern");
}

int verlassen(string str)
{
  notify_fail( "Was willst Du verlassen?\n");
  if( !str ) return 0;
  if( str=="weide" || str=="kuhweide" )
  {
    write("Du verlaesst die Kuhweide.\n");
    TP->move(ROOM "1318", M_GO, "die Kuhweide", "verlaesst", 
      "kommt von der Kuhweide auf den Weg zurueck");
    return 1;
  }
  return 0;
}

int klettern(string str)
{
  notify_fail( "Wo willst Du durchklettern?\n");
  if( !str ) return 0;
  if( str=="loch" || str=="durch loch" )
  {
    write("Du verlaesst die Kuhweide.\n");
    TP->move(ROOM "1318", M_GO, "die Kuhweide", "verlaesst", 
      "kommt von der Kuhweide auf den Weg zurueck");
    return 1;
  }
  return 0;
}

