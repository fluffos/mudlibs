#pragma strong_types

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_WALDWEG;
  SetProp(P_INT_LONG,
    BS("Der Waldweg steigt hier steiler an. Im " + capitalize(ED4) + 
      " scheint der Wald lichter zu werden. Neben Dir werden die Haenge "
      "fast unbegehbar steil. Der Weg fuehrt hier unter einem Wasserfall "
      "durch, der Boden ist nass und glitschig. Dir ist unangenehm kalt. "
      "Einige sehr hohe Baeume stehen hier. Weit oben auf einem der Baeume "
      "kannst Du ein Baumhaus sehen.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:10, ENV_TERRAIN: TT_FOREST]));
  SetProp ( P_LIGHT, 1);

  AddCmd( ({"kletter", "klettere", "steig", "steige"}), "climb");
  AddCmd( ({"faell", "faelle", "saeg", "saege"}), "cut");

  CD_WALDBODEN;
  CD_WALDWEG;
  CD_WALD;

  AddDetail( ({"baumhaus", "haus"}), 
    "Das Haus ist zu weit oben, um was genaueres sehen zu koennen.");  
  AddDetail( ({"hang", "haenge", "wand", "abhang", "felswand"}),
    "Die Felswand ist hier ein fast senkrechter Abhang. Durch den"
    " Wasserfall hier ist alles so glitschig, dass Du froh bist, nicht"
    " auszurutschen.\n");
  AddDetail( ({"fels", "felsen"}),
    "Der rote Buntsandstein ist hier nicht rauh, sondern nass und von"
    " einer glitschigen Schicht ueberzogen.");
  AddDetail ( ({"sandstein", "stein", "buntsandstein"}),
    "Buntsandstein ist ein sehr weicher Stein, aber die glitschige "
    "Schicht hat ihn hier vor Verwitterung geschuetzt.");
  AddDetail( ({"schicht"}),
    "Du vermutest, dass die Gischt des Wasserfalls hier alles feucht und"
    " glitschig haelt.");
  AddDetail( ({"baum", "baeume"}),
    "Riesige, uralte Mammutbaeume stehen hier am Wasserfall. Sie"
    " ueberragen alles, vielleicht sogar die Felsklippe im "+
    capitalize(ED7)+". Sie scheinen in der feuchten Luft sehr gut zu "
    "gedeihen. Am Fuss der Baeume waechst dorniges Gebuesch.");
  AddDetail( ({"gebuesch", "busch", "buesche", "hecke", "hecken",
               "dornenhecke", "dornenhecken", "dornen"}),
    "Am Fuss der Mammutbaeume wachsen Dornenhecken, die irgendwie seltsam"
    " aussehen. Jedenfalls sehen die Loecher in den Hecken keineswegs"
    " normal aus.");
  AddDetail( ({"mammutbaum", "mammutbaeume", "saeule", "saeulen", "stamm",
    "staemme"}),
    "Wie riesige Saeulen ragen hier die Staemme der Mammutbaeume in die"
    " Hoehe. Weiter oben muesste eine wunderbare Aussicht sein.");
  AddDetail( ({"aussicht"}),
    "Null Punkte. Die Aussicht ist weiter oben. ;-)" );
  AddDetail( ({"null"}),
    "Und wieder kein Punkt. So langsam solltest Du's aufgeben.");
  AddDetail( ({"punkt"}),
    "Leider kein Punkt. Warum sollte es denn einen geben?");
  AddDetail( ({"punkte"}),
    "Was, Du willst gleich mehrere Punkte? Reicht nicht erstmal einer?");
  AddDetail( ({"loch", "loecher"}),
    "Die Loecher in den Hecken sehen so aus, als waeren grosse "
    "Gegenstaende aus grosser Hoehe in die Hecken geschleudert worden.");
  AddDetail("luft",
    "Die Luft ist erfrischend kuehl und feucht hier.");
  AddDetail( ({"wasserfall", "fall", "klippe", "felsklippe"}),
    "Ein kleiner Bach stuerzt senkrecht die Klippe im "+ 
    capitalize(ED7)+" herunter. Die Gischt weht in alle Richtungen, "
    "sodass hier alles feucht und glitschig ist.");
  AddDetail( ({"bach", "feuchtigkeit", "gischt"}),
    "Der kleine Bach stuerzt von weit ueber Dir in den Talkessel weit"
    " unter Dir. Die dabei entstehende Gischt durchnaesst alles hier.");
  AddDetail( ({"tal", "talkessel"}),
    "Tief unten stuerzt der Wasserfall in einen Talkessel."
    " Ohrenbetaeubendes Tosen klingt bis hierher herauf.");

  AddSound( ({DEFAULT_SOUND, "tosen", "wasserfall", "fall"}),
    "Das ohrenbetaeubende Tosen des Wasserfalls klingt bis hierher herauf.");

  SetProp(P_HIDE_EXITS, ({ ED1 }) );
  AddExit(ED4, "./0305.lpc");
  AddExit( ({ED1, ED1U}), "nach "+CAP(ED1U)+"#./0203.lpc");
}

int climb(string str)
{
  if (str == "hoch" || str == "fels" || str == "felswand" || str == "wand"
    || !str) 
  {
    MSG("Du kletterst ein wenig nach oben, aber verlierst den Halt und"
      " stuerzt zurueck auf den Weg.",
      " klettert an der Wand nach oben, rutscht aus und faellt "
      "wieder runter.");
    return 1;
  }
  else if( str == "baum" || str == "auf baum" || str == "mammutbaum" ||
           str == "auf mammutbaum" ) 
  {
    write("Du kletterst auf einen Baum.\n");
    this_player()->move( ROOM "baum.lpc", M_GO, "auf einen Baum", "klettert",
			"kommt heraufgeklettert");
      return 1;
  }
  notify_fail("Wohin willst Du denn klettern?\n");
  return 0;
}

int cut(string str)
{
  notify_fail("Was willst Du faellen?\n");
  if (str == "baum" || str == "mammutbaum") 
  {
    MSG("Du durchsuchst Deine Taschen, findest aber weder eine"
      " Zimmermannsaege noch eine Holzfaelleraxt.",
      " durchsucht seine Taschen, schaut dann aber enttaeuscht auf.");
    return 1;
  }
  return 0;
}
