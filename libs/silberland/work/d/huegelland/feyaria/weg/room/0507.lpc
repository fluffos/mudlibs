#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./weide.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_WEIDE;
  SetProp(P_INT_LONG,BS(
    "Du stehst auf einer Hochflaeche, die leicht nach " + CAP(ED3) + 
    " abfaellt. Obwohl das Gras hier sehr spaerlich ist, weiden hier viele "
    "Schafe, die von einem Schaefer und seinem Hund bewacht werden. Weit im "
    + CAP(ED3) + " siehst Du den " N_BERG ". Im "+ CAP(ED4) +" bricht die "
    "Hochflaeche schroff ab. Unten im Tal kannst Du den " N_SEE " sehen.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:9, ENV_TERRAIN:TT_HILL]));

  CD_BERG_WEIT;
  CD_SEE_WEIT;
  WEIDE;

  AddItem( NPC "schaf", REFRESH_DESTRUCT);
  AddItem( NPC "hirte", REFRESH_DESTRUCT);
  AddItem( NPC "hund", REFRESH_DESTRUCT);

  AddExit(ED2, "./0506.lpc" );
  AddExit(ED3, "./0606.lpc" );
  AddExit(ED6, "./0407.lpc" );
  AddExit(ED8, "./0406.lpc" );
}
