#pragma strong_types

#include <properties.h>
#include <moving.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./wald.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_WALDWEG;
  SetProp ( P_INT_LONG, BS (
    "Du wanderst auf einem Waldweg. Der Weg wird im "+ capitalize(ED8) +
    " immer flacher, nach "+ capitalize(ED5) + " windet er sich entlang "
    "eines Huegels aufwaerts.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:18, ENV_TERRAIN: TT_FOREST]));
  SetProp ( P_LIGHT, 1);

  CD_WALDBODEN;
  CD_WALDWEG;
  CD_WALD;

  AddDetail ( ({"weg", "huegel","berg"}),
    "Der Weg scheint an der Flanke des Huegels nach oben zu fuehren. Du"
    " erkennst an den Spuren, dass sich die Zugtiere der Haendlerkarren hier"
    " ordentlich abmuehen muessen, um ihre Lasten nach oben zu befoerdern.");
  AddDetail( ({"zugtiere", "zugtiere"}),
    "Du bist zwar kein Zugtier, musst dich aber auf diesem steilen Weg "
    "auch quaelen.");
  AddDetail ( ({"flanke", "oben", "unten"}),
    "Fuer einen gewoehnlichen Huegel ist die Flanke viel zu steil."
    " Tatsaechlich, hie und da scheint der blanke Fels roetlich durch den"
    " Waldboden.");
  AddDetail ( "fels",
    "Roter Buntsandstein.");
  AddDetail ( ({"sandstein", "stein", "buntsandstein"}),
    "Buntsandstein ist ein sehr weicher Stein. Wind und Wetter haben ihn"
    " hier so stark verwittert, dass die Flanke des Huegels voller Spalten"
    " ist.");
  AddDetail( ({"wind", "wetter"}),
    "Wind und Wetter haben viele Spalten im Sandstein geschaffen.");
  AddDetail( ({"spalte", "spalten", "riss", "risse"}),
    "Hier gibt es ziemlich viele Spalten und Risse in der Felswand.");
  AddDetail( ({"wand", "waende"}),
    "Welche Wand meinst Du?");
  AddDetail( ({"felswand"}),
    "Die vielen Spalten und Risse koennten Dir helfen, die Felswand zu "
   "erklettern.");

  AddSound( DEFAULT_SOUND,
    "Hier ist es angenehm ruhig.");
  AddSmell( ({DEFAULT_SMELL, "duft", "waldduft"}),
    "Du laesst den beruhigenden Waldduft in Deine Lungen einstroemen.");

  AddCmd( ({"kletter", "klettere", "klettre", "steig", "steige"}), "climb");
  AddCmd( ({"greif", "greife", "fass", "fasse"}), "greifen");

  
  SetProp(P_HIDE_EXITS, ({ED5}) );
  AddExit( ({ED5, ED5OB}), "nach "+CAP(ED5OB)+"#./0204.lpc");
  AddExit(ED8, "./0102.lpc");
/**** handled specially by climb()
 *AddExit(ED3, "./0303.lpc");
 ****/
}

int climb(string str)
{
  if (str == "hoch" || str == "spalte" || str=="in spalte" || str == "wand" 
      || str == "felswand" || str == "hinauf" || str == "durch spalte" ||
      str == "nach oben" || str=="spalten")
  {
    write("Du kletterst in einer Spalte nach oben.\n");
    TP->move(ROOM "0303.lpc", M_GO, "in einem Riss", "verschwindet",
      "kommt heraufgekrabbelt");
    return 1;
  }
  notify_fail("Wohin willst Du denn klettern?\n");
  return 0;
}

int greifen(string str)
{
  notify_fail("Wohin willst du fassen?\n");
  if( str=="in spalte" || str =="spalte" || str=="riss" || str=="in riss" )
  {
    write("Du fasst in eine Spalte, aber da ist nichts drinnen.\n");
    return 1;
  }
  return 0;
}
