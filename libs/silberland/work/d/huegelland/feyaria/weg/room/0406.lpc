// 1997-01-01  Feyaria@SilberLand

#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./weide.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_WEIDE;
  SetProp(P_INT_LONG, BS(
    "Du stehst auf einer Hochflaeche, die leicht nach " + CAP(ED3) + 
    " abfaellt. Obwohl das Gras hier sehr spaerlich ist, weiden hier viele "
    "Schafe, die von einem Schaefer und seinem Hund bewacht werden. Weit im "
    + CAP(ED3) +" spiegelt sich der " N_BERG " im " N_SEE ". Der Weg nach "+
    CAP(ED7) +" wird durch eine breite Kluft abgeschnitten. Dort wird das "
    "Gelaende zunehmend huegeliger. Im "+ CAP(ED1) +" steigt die "
    "Hochflaeche steil an.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:9, ENV_TERRAIN:TT_HILL]));

  CD_BERG_WEIT;
  CD_SEE_WEIT;
  WEIDE;

  AddDetail( ({"kluft", "kluefte", "boden", "grund"}),
    "Den weichen Sandstein durchziehen hier tiefe, Kluefte, an deren "
    "Grund das Wasser rauscht. Im " + CAP(ED3) +" ist eine Kluft schon "
    "mehr als 10 Meter breit, sodass es keine Moeglichkeit gibt, dort "
    "hinueber zu kommen.");
  AddDetail( ({"moeglichkeit", "bruecke", "springen", "zeit", "weg"}),
    "Zum Springen ist es zu weit; und um eine Bruecke zu bauen, hast Du "
    "wohl zu wenig Zeit.");
  AddDetail( ({"stein", "sandstein", "sand"}),
    "Da Sandstein so weich ist, bilden sich durch die Erosion auch schnell "
    "tiefe Kluefte.");
  AddDetail( ({"erosion", "eros"}),
    "Ob Eros damit etwas zu tun hat?");
  AddDetail( ({"gelaende"}),
    "Im "+ CAP(ED7) +" liegt eine breite Kluft, dahinter wird es dann etwas "
    "huegeliger. Im "+ CAP(ED3) +" liegt der " N_BERG " und davor der "
    N_SEE ". Im "+ CAP(ED1) +" steigt das Gelaende steil an.");

  AddItem( NPC "schaf", REFRESH_DESTRUCT);
  
  AddExit(ED3, "./0506.lpc" );
  AddExit(ED4, "./0507.lpc" );
  AddExit(ED5, "./0407.lpc" );
}
