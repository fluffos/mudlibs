#pragma strong_types

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>
#include "../cheasy_defs.h"

inherit "std/room";

void create() 
{
  ::create();

  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:17, ENV_TERRAIN:TT_HILL]));
  SetProp(P_KILL_NAME, "Uebergrosse Neugier und eigene Dummheit");
  SetProp(P_KILL_MSG, "waren die Ursachen.");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1]));
  SetProp(P_INT_SHORT, "Auf einem Sims ueber dem Wald" );
  SetProp(P_INT_LONG,
    BS("Du stehst auf einem Sims ueber dem Wald, fast ganz oben am"
      " Gipfel. Vor Dir steht ein riesiges Bett, neben Dir ein"
      " riesengrosser Stuhl, und unter dem Bett entdeckst Du einen"
      " Nachttopf, in dem Du schwimmen koenntest, wenn er voll waere."
      " An der Felswand lehnt ein Stapel Koerbe, und ein leerer Korb"
      " steht mitten auf dem Sims.") );

  AddDetail( ({"himmel"}),
    "Der Himmel ist irgendwo ueber Dir. Hast Du etwa etwas anderes erwartet?");
  AddDetail("korb",
    BS("Ein fast kugelfoermiger, riesengrosser Korb. Du koenntest es Dir"
      " ohne Probleme darin bequem machen.") );
  AddDetail( ({"stapel", "koerbe"}),
    BS("Ein riesiger Stapel Koerbe, manche davon sind tropfnass, einige"
      " sind feucht, aber die meisten davon sind angenehm trocken.") );
  AddDetail( ({"fels", "wand", "felswand"}),
    BS("Die Felswand ist hier irgendwie behauen. Du kannst keinen Weg"
      " nach oben oder seitlich von diesem Sims erkennen, aber Du"
      " koenntest problemlos nach unten rutschen.") );
  AddDetail("weg",
    BS("Du erkennst keinen Weg von diesem Sims herunter... zumindest fuer"
      " Normalsterbliche wie Dich. Riesen koennten allerdings diesen"
      " Vorsprung zwanzig Meter ueber Dir als Griff benutzen ;-)") );
  AddDetail( ({"vorsprung", "griff", "haltegriff"}),
    BS("Der Vorsprung ueber Dir sieht tatsaechlich wie ein riesiger"
      " Haltegriff aus.") );
  AddDetail( ({"riese", "riesen"}),
    BS("Im Moment ist wohl keiner da... aber die Moebel koennten fuer"
      " einen Riesen gemacht sein.") );
  AddDetail("moebel",
    BS("Ein Tisch, zwei Hocker, ein paar Koerbe... aber das weisst Du"
      " ja schon.") );
  AddDetail( ({"tisch"}),
    "Ein riesengrosser Tisch.");  
  AddDetail( ({"sims", "boden"}),
    BS("Dieses Sims ist seltsam: es sieht bewohnt aus. Am Rand koenntest Du"
      " nach unten rutschen.") );
  AddDetail("rand",
    BS("Da stehst Du gerade. Hier koenntest Du nach unten rutschen.") );
  AddDetail("wald",
    BS("Der Wald liegt unter Dir, er ist gruen und wogt sachte im Wind.") );
  AddDetail("wind",
    BS("Hier oben blaest ein kraeftiger Wind, der Dir Dein Haar zerzaust."));
  AddSpecialDetail("haar", "det_haar");
  AddDetail("gipfel",
    BS("Ein wenig ueber Dir ist der Gipfel des Huegels. Du kannst ihn"
      " nicht genau erkennen, weil Du zu nahe an der Felswand stehst.") );
  AddDetail("huegel",
    BS("Du stehst drauf. Fast ganz oben sogar.") );
  AddDetail("bett",
    BS("Ein wirklich riesiges Bett, fuer solche halben Portionen wie Du"
      " eine bist schon ein ganzes Matratzenlager.") );
  AddDetail( ({"portion", "portionen"}),
    BS("Ja, Du bist gemeint, Du halbe Portion.") );
  AddDetail( ({"matratze", "matratzenlager", "matratzen"}),
    BS("Hmm, die Fuellung aus halben Baeumen ist wohl nicht nach Deinem"
      " Geschmack.") );
  AddDetail( ({"geschmack"}),
      "Du solltest selber wissen, was nach Deinem Geschmack ist....."); 
  AddDetail( ({"fuellung", "baum", "baeume"}),
    BS("Jemand hat tatsaechlich eine riesige Matratze mit halben Baeumen"
      " gefuellt. Derjenige muss wohl sehr schwer und sehr gross sein.") );
  AddDetail( ({"stuhl", "hocker", "felsplatte", "sitzflaeche"}),
    BS("Unter diesem Stuhl kannst Du ohne Probleme durchlaufen. Die"
      " Sitzflaeche ist aus einer riesigen Felsplatte gefertigt, die"
      " Du alleine nicht einmal mit einem Hebel anheben koenntest."));
  AddDetail( ({"problem", "probleme", "ahnung"}),
      "Keine Ahnung, was Deine Probleme sind, unter dem Stuhl durchlaufen "
      "ist jedenfalls kein Problem.");
  AddDetail( ({"hebel"}),
    "Du hast ja gar keinen geeigneten Hebel dabei.");
  AddDetail( ({"topf", "nachttopf", "form", "oberkante", "augenhoehe"}),
    BS("Nunja, der Form nach ist es ein Nachttopf, und es stinkt auch"
      " wie ein Nachttopf. Nur ist er Dir ein bisschen zu gross: Die"
      " Oberkante ist etwa in Augenhoehe, und Du koenntest problemlos"
      " darin schwimmen lernen."));
  AddSmell( ({"nachttopf", "topf"}),
    "Der Nachttopf riecht etwas nach den Exkrementen des Riesens.");
  AddDetail( ({"beschreibung", "wort", "schluesselwort", "schmerzen",
            "untersuchung", "untersuchungen", "kanne", "falle", "sachen",
            "hier", "wetten", "fast", "moment",}),
    "Argl, Du Solltest Doch Diese Sachen Nicht Untersuchen!");
  AddSpecialDetail( ({ "solltest", "doch", "diese", "nicht", "untersuchen",
      "ohrfeige", "patsch", "blitz", "nasenwurzel", "oberkoerper", "meter",
      "vor", "ein", "dieses", "am", "da", "hmm", "derjenige", "nanu", "unter",
      "nunja", "nur", "auauaua", "ohgott", "versengt", "und", "tut", "weh",
      "erhaeltst", "mentale", "tat", "stuerzt", "vom", "trifft", "haargenau",
      "das", "windes", "argl"}), "NoScript");

  AddSound( ({DEFAULT_SOUND, "wind", "rauschen"}),
    "Du hoerst das Rauschen des Windes.");

  AddCmd( ({"kletter", "klettere", "rutsch", "rutsche"}), "slide");
  AddCmd( ({"krabbel", "krabble", "steig", "steige"}), "crawl");

  AddItem( NPC "steinriese", REFRESH_DESTRUCT);
}

int slide(string str) 
{
  if (str == "runter" || str == "spalte" || str=="hinunter" || str=="nach unten")
  {
    TP->move(ROOM"0203.lpc", M_GO, "unten", "rutscht nach", "purzelt herein");
    return 1;
    }
  notify_fail("Wohin willst Du denn rutschen?\n");
  return 0;
}

int crawl(string str) 
{
  notify_fail("Dorthin kannst Du nicht klettern.\n");
  return 0;
}

