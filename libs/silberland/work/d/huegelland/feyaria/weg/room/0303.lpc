void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Scriptfalle in 0303.c) "
               " -%d EP\n", lostexp) );
}
string det_haar()
{
  return BS("Dein Haar ist "+TP->QueryProp(P_HAIR_COLOR)+".");
}
