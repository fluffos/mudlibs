
#include "../def.h"

inherit ROOM "bau_inh";

void create()
{
  ::create();

  AddSpecialDetail( ({"richtungen", "nordosten", "nordwestoben", "kruemmung"}),
    "richtungen");

  AddExit(({"nordwestoben", "nordwesten"}), "./bau4");  
  AddExit(({"nordosten"}), "./bau6");
  SetProp(P_HIDE_EXITS, ({"nordwesten"}) );

}

string richtungen()
{
  return BS("Der Gang macht hier eine scharfe Kruemmung von Nordwestoben "
            "nach Nordosten. ");
}


