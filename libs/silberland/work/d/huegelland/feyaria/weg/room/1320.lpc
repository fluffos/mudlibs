#pragma strong_types

#include <properties.h>

#include "../directions.h"
#include "../cheasy_defs.h"
#include "./huegel2.h"
#include "./strand.h"

inherit "std/room";

void create()
{
  ::create();

  P_INT_SHORT_HUEGEL;
  SetProp(P_INT_LONG,
    BS("Hier fuehrt der Weg zwischen zwei Huegeln hinunter zu einem Strand"
      " im " + CAP(ED3) + ". Dahinter rauscht das Meer in einer riesigen"
      " Bucht. Das gegenueberliegende Ufer ist weit im " + CAP(ED3) +
      " gerade noch zu erkennen. Im " + CAP(ED2) + " verebben die Huegel,"
      " an einer Flussmuendung beginnt dort eine weite Tiefebene.") );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:17, ENV_TERRAIN:TT_HILL]));

  CD_HUEGEL;
  CD_HUEGEL2;
  CD_STRAND;

  AddDetail( ({"landschaft", "huegelllandschaft", "huegel"}),
    QueryProp(P_INT_LONG) ); 
  AddDetail("berg",
    "Ein riesiger Berg mit zwei Gipfeln ueberragt die Landschaft. Die"
    " unteren Regionen sind bewaldet, weiter oben glaenzen kahle"
    " Felswaende in der Sonne.");
  AddDetail( ({"gipfel", "felswand", "felswaende"}),
    "Hoch ueber Dir glaenzen die steilen Felswaende in der waermenden"
    " Sonne. Darunter breiten sich Geroellfelder und Buschwerk aus.");
  AddDetail( ({"geroellfeld", "geroellfelder", "buschwerk", "busch",
               "buesche", "strand"}),
    "Vielleicht solltest Du naeher hingehen, um mehr zu sehen.");
  AddDetail( ({"wald", "baeume", "hang", "haenge"}),
    "Die Haenge des im " + CAP(ED1) + " liegenden Berges sind im unteren"
    " Bereich bewaldet.");
  AddDetail( ({"bucht"}),
    "Du stehst im "+ CAP(ED6)+ " der Bucht. Das gegenueberliegende Ufer "
    "ist weit im " + CAP(ED3) +" gerade noch zu erkennen.");
  AddDetail( ({"flussmuendung", "fluss", "muendung", "tiefebene", "ebene"}),
    "Im "+CAP(ED2)+" beginnt an einer Flussmuendung eine weite Tiefebene.");

  SetProp(P_HIDE_EXITS, ({ED3}) );
  AddExit( ({ED3, ED3U}), "nach "+CAP(ED3U)+"#./1420.lpc" );
  AddExit(ED8, "./1219.lpc" );
}
