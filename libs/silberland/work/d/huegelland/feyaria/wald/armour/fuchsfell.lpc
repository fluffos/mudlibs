// /d/huegelland/feyaria/wald/armour/fuchsfell.c
// Ein Fuchsfell
// 2002-05-06  Feyaria@SilberLand

#include "../def.h"
#include "/gilden/berserker/berserker_extern.h"
#include "/p/daemon/itemd/itemd.h"
inherit "std/armour";

void create()
{
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Fuchsfell");
  SetProp(P_LONG, 
    "Dieses Fuchsfell ist rostrot und sehr weich. Wenn Du nicht zu gross "
    "bist, kannst Du es als Umhang benutzen.");
  SetProp(P_NAME, "Fuchsfell");
  SetProp(P_GENDER, NEUTER);
  AddId(({"fell", "fuchsfell","\nfell_is_gerb_able"}));
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_PELT:100]));
  SetProp(P_WEIGHT, 900);
  SetProp(P_VALUE, 600);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE:140]) );
  SetProp(P_ITEMD_NO_SOCKETED, 1);
}

void set_fuchs(string name)
{
  switch( name )
  {
    case "Berserkerfuchs":
      SetProp(P_NAME, "Berserkerfuchsfell");
      SetProp(P_SHORT, "Ein Berserkerfuchsfell");
      SetProp(P_LONG, 
        "Dieses Fuchsfell ist blutrot und sehr stabil. Wenn Du nicht zu gross "
        "bist, kannst Du es als Umhang benutzen.");
      AddId( "berserkerfuchsfell");
      SetProp(P_VALUE, 5000);
      SetProp(P_AC, 10);
      SetProp(P_BERSERKER_BONUS, (["all": 15]) );
      break;
    case "Rotfuchs":
      SetProp(P_LONG, 
        "Dieses Fuchsfell ist rostrot und sehr weich. Wenn Du nicht zu gross "
        "bist, kannst Du es als Umhang benutzen.");
      AddId( "rotfuchsfell");
      break;
    case "Silberfuchs":
      SetProp(P_LONG, 
        "Dies ist das Fell eines der seltenen Silberfuechse. Es ist sehr "
        "wertvoll, denn es scheint tatsaechlich geringe Spuren von Silber "
        "zu enthalten.");
      AddId( "silberfuchsfell");
      AddDetail( ({"silber"}),
        "Das Fell des Silberfuchses enthaelt geringe Spuren von Silber." );
      SetProp(P_VALUE, 3500);
      SetProp(P_MATERIAL, ([MAT_PELT:95, MAT_SILVER:5]));
      break;
    case "Schwarzfuchs":
      SetProp(P_LONG, 
        "Das ist das schoene und makelloses Fell eines Schwarzfuches. "
        "Es ist nachtschwarz, sodass man fast unsichtbar wird, wenn man es "
        "sich in der Nacht umhaengt. Allerdings darf man dazu nicht "
        "all zu gross sein.");
      AddId( "schwarzfuchsfell");
      break;
    case "Graufuchs":
      SetProp(P_LONG, "Dieses Fuchsfell hat einen edlen Grauton, es muss also "
        "von einem Graufuchs stammen. Wenn Du nicht zu gross bist, kannst Du "
        "es als Umhang benutzen." );
      AddId( "graufuchsfell");
      break;
  }
}

