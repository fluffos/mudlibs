// /d/huegelland/feyaria/wald/weapon/marderfell.c
// Ein Marderfell
// 2001-04-28  Feyaria@SilberLand

#include "../def.h"
#include "/p/daemon/itemd/itemd.h"
inherit "std/armour";

void create()
{
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Marderfell");
  SetProp(P_LONG, 
    "Das Fell eines Marders.");
  SetProp(P_NAME, "Marderfell");
  SetProp(P_GENDER, NEUTER);
  AddId(({"fell", "marderfell", "\nfell_is_gerb_able"}));
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, ([MAT_PELT:100]) );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 100);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_MAX_SIZE: 150]) );
  SetProp(P_ITEMD_NO_SOCKETED, 1);
}

void set_marder(string name)
{
  SetProp(P_NAME, name + "fell");
  AddId(lower_case(name) + "fell");
  SetProp(P_SHORT, Name(WER,0));
  switch( name )
  {
    case "Goldmarder":
      SetProp(P_VALUE, 10000);
      SetProp(P_WEIGHT, 2000);
      SetProp(P_MATERIAL, ([MAT_GOLD:100]) );
      SetProp(P_AC, 10);
      SetProp(P_LONG,
        "Das Fell eines der legenaeren Goldmarder. Es besteht aus purem Gold "
        "und ist auch dementsprechend wertvoll. Es gibt sicher Leute, die "
        "fuer diese Trophaee ein Vermoegen bezahlen wuerden.");
      break;
    case "Silbermarder":
      SetProp(P_VALUE, 2000);
      SetProp(P_AC, 8);
      SetProp(P_LONG,
        "Dies ist das Fell eines der seltenen Silbermarder. Es glaenzt "
        "silbrig, besteht aber keineswegs aus Silber. Einige Verrueckte "
        "behaupten, dass das Fell des Goldmarders im Gegensatz dazu aus "
        "purem Gold bestehen soll. So ein Unsinn! Zumindest ist dieses "
        "Fell wunderschoen, auch wenn es nicht aus Silber besteht.");
      break;
    case "Hoehlenmarder":
      SetProp(P_LONG,
        "Das Fell des Hoehlenmarders ist pechschwarz.");
      break;
    case "Steinmarder":
      SetProp(P_LONG,
        "Das Fell des Steinmarders ist grau. Feine hellgraue und dunkelgraue "
        "Streifen durchziehen das Fell. Dadurch schaut es einem geaedertem "
        "stein noch viel aehnlicher.");
      break;
    case "Baummarder":
      SetProp(P_LONG,
        "Das Fell des Baummarders ist braun. Es schimmert kaum so wie andere "
        "Felle, aber dadurch kann man es wohl kaum von einem Ast "
        "unterscheiden.");
      break;
    case "Waldmarder":
      SetProp(P_LONG,
        "Das Fell des Waldmarders ist braungescheckt. Es ist die perfekte "
        "Tarnung im Wald.");
      break;
      
  }
}

