// /d/huegelland/feyaria/wald/weapon/loewenfell.c
// Ein Loewenfell
// 2001-04-28  Feyaria@SilberLand

#include "../def.h"
inherit "std/armour";

string mardername;

void create()
{
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Das Fell eines Waldloewen");
  SetProp(P_LONG, 
    "Dies ist das Fell eines Waldloewen. Es hat eine silbrigweisse Farbe "
    "und ist sicher sehr wertvoll. Man kann es sich um die Schultern haengen "
    "und wie einen Umhang verwenden.");
  SetProp(P_NAME, "Waldloewenfell");
  SetProp(P_GENDER, NEUTER);
  AddId(({"fell", "loewenfell", "waldloewenfell", "\nfell_is_gerb_able"}));
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ([MAT_PELT:100]) );
  SetProp(P_WEIGHT, 1700);
  SetProp(P_VALUE, 4000);
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL: 20]) );
}

