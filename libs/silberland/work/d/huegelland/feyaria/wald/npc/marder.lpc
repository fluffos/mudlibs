// /d/huegelland/feyaria/wald/npc/marder.c   
// Ein Marder
// 2001-04-28  Feyaria@SilberLand

inherit "std/mnpc";

#include "../def.h"
#include <npcmaster.h>

int log;

void create()
{
  string name;
  int lvl;
  object ob;
  int alter;

  if (!is_clone(TO)) return;
  ::create();

  switch (log = random(100))
  {
    case 0..1:
      name="Goldmarder";
      SetProp(P_LONG, 
        "Vor Dir steht eines der seltensten Geschoepfe, die es in diesem "
        "Wald gibt. Eigentlich glaubt ja niemand an die Existenz eines "
        "Goldmarders, dre ihn nicht mit eigenen Augen gesehen hat. Sein "
        "Fell scheint tatsaechlich aus purem Gold zu bestehen. Die scharfen "
        "Zaehne im Gebiss des Goldmarders koennten aber ein Hinderniss sein, "
        "diese Tropaehe zu erringen.");
        lvl=5;
      break;
    case 2..5:
      name="Silbermarder";
      SetProp(P_LONG, 
        "Ein kleiner, frecher Marder steht, vor Dir. Wegen dem silbrig "
        "schimmernden Fells wird es wohl einer der seltenen Silbermarder "
        "sein. Im Gegensatz zum Goldmarder, dessen Fell ja tatsaechlich "
        "aus Gold besteht, hat der Silbermarder nur ein ganz normales Fell. "
        "Trotzdem wuerde jeder Pelzhaendler hohe Summen fuer dieses "
        "wunderschoene Fell zahlen. Ob der Marder es Dir aber so einfach "
        "ueberlaesst, ist eine andere Frage.");
        lvl=2;
      break;
    case 6..11:
      name="Hoehlenmarder";
      SetProp(P_LONG, 
        "Schon seltsam, dass ein Hoehlenmarder hier im Wald herumlaeuft. "
        "Normalerweise findet man sie nur in dunklen Hoehlen. Sein "
        "pechschwarzes Fell und die grossen Augen passen auch besser zu "
        "einem Hoehlen- denn zu einem Waldbewohner. Was ihn wohl aus "
        "seiner Hoehle vertrieben hat?");
        lvl=1;
        break;
    case 12..39:
      name="Steinmarder";
      SetProp(P_LONG, 
        "Der Steinmarder lebt normalerweise im Gebirge, weil er durch seine "
        "graues Fell praktisch unsichtbar ist, wenn er sich in der Naehe von "
        "Felsen aufhaelt. Doch auch im Wald scheint er ganz gut leben zu "
        "koennen, zumindest schaut dieses Exemplar sehr gut genaehrt aus.");
      break;    
    case 40..69:
      name="Baummarder";
      SetProp(P_LONG, 
        "Der Baummarder haelt sich am liebsten auf Baeumen auf und sucht "
        "nach Eiern in Vogelnestern. Mit seinen langen Krallen kann er auf "
        "jeden Baum klettern, und mit seinen spitzen Zaehnen jedes Ei "
        "aufbeissen. Durch sein braunes Fell ist er auch realtiv gut "
        "getarnt.");
      break;    
    case 70..99:
      name="Waldmarder";
      SetProp(P_LONG, 
        "Der Waldmarder ist die haeufigste Art von Marder, die man in einem "
        "Wald treffen kann. duch sein braungeschecktes Fell ist er perfekt "
        "an das Dickicht im Wald angepasst, Du wunderst Dich, dass Du ihn "
        "ueberhaupt bemerkt hast, wahrscheinlich weil Du zu gross bist, um "
        "auf die Speisekarte dieses Raeubers zu passen. Als kleiner Vogel "
        "oder Echslein haetten Dich die scharfen Zaehne des Waldmarders "
        "schon laengst zerfetzt.");
      break;    
  }
  if (log < 10) log = 1; else log = 0;
  switch( random(10))
  {
    case 0: alter=-2; 
      SetProp(P_NAME_ADJ, "jung");
      AddAdjective( ({"jungen", "jung"}) );
      break;
    case 1: alter=1; 
      SetProp(P_NAME_ADJ, "alt");
      AddAdjective( ({"alten", "alt"}) );
      break;
    case 2: alter=2; 
      SetProp(P_NAME_ADJ, "gross");
      AddAdjective( ({"gross", "grossen"}) );
      break;
    case 3: alter=-1; 
      SetProp(P_NAME_ADJ, "klein");
      AddAdjective( ({"kleinen", "klein"}) );
      break;
    case 4: alter=4; 
      SetProp(P_NAME_ADJ, "riesig");
      AddAdjective( ({"riesigen", "riesig"}) );
      break;
    case 5: alter=0; 
      SetProp(P_NAME_ADJ, "frech");
      AddAdjective( ({"frecher", "frech"}) );
      break;
    case 6: alter=0; 
      SetProp(P_NAME_ADJ, "hungrig");
      AddAdjective( ({"hungriger", "hungrig"}) );
      break;
    default: alter=0;
  }    
      
  SetProp(P_NAME, name);
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, Name(WER,0));
  AddId( ({"marder", LOWER(name), "FELL_WUSCHEL"}) );

  create_default_npc(11+alter+lvl);
  SetProp(P_NO_SCORE, 1);
  SetProp(P_HANDS, ({" mit seinen Krallen", QueryProp(P_HANDS)[1], DT_RIP}));
  SetProp(P_RACE, "Marder");
  SetProp(P_SIZE, 70+alter*12+lvl*4);
  SetProp(P_ALIGN, -50-random(100));
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "faucht Dich an.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_DIE_MSG, " faucht noch einmal laut und stirbt.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
    Name(WER,1)+" zerbeisst @WEN wuetend.\n"}));

  SetChats(3, ({
    Name(WER,1)+" sucht hier nach Vogeleiern.\n",
    Name(WER,1)+" schnueffelt am Boden herum.\n",
    Name(WER,1)+" faucht leise.\n",
    Name(WER,1)+" zeigt seine spitzen Zaehne.\n",
    Name(WER,1)+" schleicht um Dich herum.\n",
    Name(WER,1)+" beaeugt Dich misstrauisch.\n",
    Name(WER,1)+" klettert auf einen Baum hinauf.\n"}) );

  SetProp(P_SPELLRATE, 20+alter*3+lvl*5);
  AddSpell(1,(10+alter+lvl)*20,
    Name(WER,1)+" beisst Dich mit seinen scharfen Zaehnen.\n",
    Name(WER,1)+" beisst @WEN mit seinen scharfen Zaehnen.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SUID;
  ob=clone_object(ARMOUR "marderfell");
  ob->move(TO);
  ob->set_marder(name);
  command("trage fell");

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( "+name(WER,0)+" ) "
               " -%d EP\n", lostexp) );
}

void die(int poisondeath)
{
  if (log)
    write_file( LOG "rare.kills",
        dtime(time())+": "+CAP(getuid(TP))+" toetet "+name(WEN)+".\n");
  ::die(poisondeath);
}
