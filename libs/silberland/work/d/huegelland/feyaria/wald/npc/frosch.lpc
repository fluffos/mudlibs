// /d/huegelland/feyaria/wald/npc/frosch.c
// ein Frosch
// 2001-05-01  Feyaria@SilberLand

#include "../def.h"
#include <mnpc.h>

inherit  "/d/huegelland/feyaria/weg/npc/quest_frosch";

void create()
{
  string name;
  if (!is_clone(TO)) return;
  ::create();

  switch( random(10))
  {
    case 0..3: name = "Laubfrosch"; break;
    case 4..7: name = "Waldfrosch"; break;
    case 8..9: name = "Gruenfrosch"; break;
  }
  SetProp(P_LONG, "Der Frosch hat eine gruen glaenzenden Haut und quakt nur "
      "laut vor sich hin und beachtet Dich gar nicht. In seinem riesigen Maul "
      "siehst Du eine klebrige Zunge, die hinundwieder herausschnellt und eine "
      "Fliege faengt.");
  SetProp(P_NAME, name);
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, Name(WER,0));
  AddId ( ({"frosch", LOWER(name), "SCHUPPEN_WUSCHEL"}) );

  create_default_npc (4);
  SetProp(P_HANDS, ({" mit seiner langen Zunge", 40, DT_WHIP}));
  SetProp(P_RACE, "Frosch");
  SetProp(P_SIZE, 10 + random(5));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "huepft herein");
  SetProp(P_MSGOUT, "huepft");
  SetProp(P_MMSGIN, "huepft herein");
  SetProp(P_MMSGOUT, "huepft weg");

  AddInfo(DEFAULT_INFO, "quakt laut.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     Name(WER,1)+" beachtet Deine Sachen gar nicht.\n"}));

  AddDetail( ({"maul"}),
    "Das Maul ist so gross, dass man da sicher etwas hineinstecken kann. "
    "Nur wird da sicher alles sehr klebrig werden.");

  if( !random(4) )
  {
    SetProp(P_TRANSPARENT ,0);
    CLONEME("/d/dschungel/feyaria/tijara/obj/frosch");
  }
}
