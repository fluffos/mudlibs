// /d/huegelland/feyaria/wald/npc/mistkaefer.c
// ein Mistkaefer
// 2001-05-01  Feyaria@SilberLand

#include "../def.h"
#include <mnpc.h>

inherit  "std/mnpc.lpc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Mistkaefer");
  SetProp(P_LONG, 
    "Der Mistkaefer ist voellig schwarz und hat zwei kraeftige Zangen, mit "
    "denen er alle moeglichen Sachen durch die Gegend schleppen kann.");
  SetProp(P_NAME, "Mistkaefer");
  SetProp(P_GENDER, MALE);
  AddId ( ({"kaefer", "mistkaefer"}) );

  create_default_npc (5);
  SetProp(P_HANDS, ({" mit seinen kraeftigen Zangen", QueryProp(P_HANDS)[1], DT_SQUEEZE}));
  SetAttribute( A_STR, 30);
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 20+random(10));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_MSGIN, "marschiert herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "marschiert herein");
  SetProp(P_MMSGOUT, "marschiert weg");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "kann doch gar nicht reden.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");

}

void init()
{
  ::init();
  call_out("nimmalles",0);  
}
  
void nimmalles()
{
  command_me("nimm alles");
}  
  
