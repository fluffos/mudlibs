// /d/huegelland/feyaria/wald/npc/hirsch.c   
// Ein Hirsch
// 2001-04-08  Feyaria@SilberLand

#include "../def.h"
#include <npcmaster.h>
#include <ansi.h>

inherit "std/mnpc";

int geweih;

void create()
{
  int alter;
  string name;
  object ob;

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NO_SCORE, 1);
  switch (random(20))
  {
    case 0..2: alter=10; geweih=6; break;
    case 3..5: alter=11; geweih=8; break;
    case 6..8: alter=12; geweih=10; break;
    case 9..11: alter=13; geweih=12; break;
    case 12..14: alter=14; geweih=14; break;
    case 15..16: alter=15; geweih=16; break;
    case 17..18: alter=17; geweih=18; break;
    case 19: alter=20; geweih=20+2*random(3); 
             if (geweih == 24)
               SetProp(P_NO_SCORE, 0);
  }
  switch (random(100))
  {
    case 0..1:
      name="Goldhirsch";
      SetProp(P_LONG, 
          "Du traust Deinen Augen nicht! Vor Dir steht doch tatsaechlich einer "
          "dieser legendaeren Goldhirsche. Seinen Namen traegt er zurecht, denn "
          "sein ganzes Fell hat einen goldenen Glanz. Sein maechtiges Geweih hat "+
          geweih+" Enden, er gehoert also zu den "+
          (geweih>12?"aelteren":"juengeren")+" Exemplaren seiner Art.");
      SetProp(P_NO_SCORE, 0);
      alter += 3;
      break;
    case 2..5:
      name="Silberhirsch";
      SetProp(P_LONG, 
          "Vor Dir steht einer der seltenen Silberhirsche. Seinen Namen hat er "
          "von dem silbrig glaenzenden Fell. Sein maechtiges Geweih hat "+
          geweih+" Enden, er gehoert also zu den "+
          (geweih>12?"aelteren":"juengeren")+
          " Exemplaren seiner Art. An dem Geweih haengen noch einige Stuecke Bast, "
          "es ist dem Hirsch also gerade erst neu gewachsen.");
      if (alter > 12)
        SetProp(P_NO_SCORE, 0);
      alter += 2;
      break;
    case 6..11:
      name="Weisshirsch";
      SetProp(P_LONG, 
          "Vor Dir steht einer der seltenen Weisshirsche. Seinen Namen hat er "
          "von dem komplett weissen Fell. Eigentlich wuerde er besser in eine "
          "Schneelandschaft passen als mitten in einen Wald. Aber mit seinen "
          "schlanken und kraftstrotzenden Beinen kann er sicher jedem Raubtier "
          "entfliehen, auch wenn er nicht so gut getarnt ist wie andere "
          "Waldbewohner. Sein maechtiges Geweih hat "+
          geweih+" Enden, er gehoert also zu den "+
          (geweih>12?"aelteren":"juengeren")+
          " Exemplaren seiner Art.");
      if (alter > 14)
        SetProp(P_NO_SCORE, 0);
      alter ++;
      break;
    case 12..39:
      name="Kronenhirsch";
      SetProp(P_LONG, 
          "Vor Dir steht ein maechtiger Kronenhirsch mit hellbraunem Fell und "
          "grauem Kinnbart. Seinen Namen hat er von dem maechtigen Geweih, das "
          "auf seinem Kopf sitzt wie eine Krone. An dem Geweih haengen noch "
          "einige Stuecke Bast, es ist dem Hirsch also gerade erst neu "
          "gewachsen. Wie man an den "+geweih+" Enden seines Geweihs "
          "erkennen kann, gehoert dieser Hirsch eher zu den "+
          (geweih>12?"aelteren":"juengeren")+
          " seiner Art." );
      break;    
    case 40..69:
      name="Waldhirsch";
      SetProp(P_LONG, 
          "Der Waldhirsch ist einer der typischen Bewohner jeden Waldes. Sein "
          "braunes Fell gibt im eine perfekte Tarnung. Wie man an den "
          +geweih+" Enden seines Geweihs erkennen kann, gehoert dieser "
          "Hirsch eher zu den "+(geweih>12?"aelteren":"juengeren")+
          " Exemplaren seiner Art.");
      break;    
    case 70..99:
      name="Rothirsch";
      SetProp(P_LONG, 
          "Der Rothirsch hat ein stark ins roetliche gehendes rotbraunes Fell und "
          "ist etwas kleiner als andere Hirsche. Wie man an den "
          +geweih+" Enden seines Geweihs erkennen kann, gehoert dieser "
          "Hirsch eher zu den "+(geweih>12?"aelteren":"juengeren")+
          " Exemplaren seiner Art.");
      break;    
  }
  if (!QueryProp(P_NO_SCORE))
    DB(ANSI_GREEN+ANSI_UNDERL+"*** WALD: "+name+" ("+alter+" Jahre, "+geweih+
        "Ender )"+ANSI_NORMAL+"\n"); 
  SetProp(P_SHORT, "Ein "+name);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, name);
  AddId( ({"hirsch", LOWER(name), "FELL_WUSCHEL"}) );

  create_default_npc(alter);
  SetProp(P_HANDS, ({" mit seinem maechtigen Geweih", 10*alter, DT_PIERCE}));
  SetProp(P_RACE, "Hirsch");
  SetProp(P_SIZE, 100 + alter * 3 + random(alter * 3));
  SetProp(P_ALIGN, 150);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "springt aus den Bueschen heraus");
  SetProp(P_MSGOUT, "springt");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "roehrt ganz laut.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_DIE_MSG, " stirbt einen Hirschtod.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    Name(WER,1)+" kann nichts mit Deinen Sachen anfangen.\n"}));

  SetChats(3, ({
    Name(WER,1)+" roehrt ganz laut.\n",
    Name(WER,1)+" schuettelt kleine Stueckchen Bast von seinem neuen "
      "Geweih.\n",
    Name(WER,1)+" schnaubt leise.\n",
    Name(WER,1)+" knabbert an den Blaettern der Baeume.\n",
    Name(WER,1)+" reibt sein Geweih an einem Jungbaum.\n"}) );

  SetProp(P_SPELLRATE, alter * alter / 8);
  AddSpell(1, alter * 25,
    Name(WER,1)+" rammt Dich mit seinem maechtigen Geweih.\n",
    Name(WER,1)+" rammt @WEN mit seinem maechtigen Geweih.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SUID;
  ob = clone_object(WEAPON "geweih");
  ob->move(TO);
  ob->set_hirsch(name, geweih );
  command("zuecke geweih");

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( "+name(WER,0)+" ) "
               " -%d EP\n", lostexp) );
}

void die(int poisondeath)
{
  if (!QueryProp(P_NO_SCORE))
    write_file( LOG "rare.kills",
        dtime(time())+": "+CAP(getuid(TP))+" toetet "+name(WEN)+" ("+geweih+"Ender).\n");
  ::die(poisondeath);
}
