// /d/huegelland/feyaria/wald/npc/centaur.c   
// Ein Centaur
// 2001-05-09  Feyaria@SilberLand

#include "../def.h"
#include <mnpc.h>
inherit "std/mnpc";

void create()
{
  string name;
  int lvl;
  int alter;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Centaur");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, "Ein Centaur");
  SetProp(P_LONG,
    "Vor Dir steht ein Wesen, dass man am besten als Mischung zwischen "
    "Mensch und Pferd beschreiben koennte. Centauren gehoeren der Gruppe "
    "der magischen Mischwesen an, die durch starke Magie aus 2 oder mehreren "
    "Lebewesen geschaffen wurden. Der Centaur besitzt einen Pferdekoerper "
    "mit 4 starken Beinen und breiten Hufen. Vorne besitzt er einen "
    "menschlichen Oberkoerper mit muskuloesen Armen und einen Menschenkopf. "
    "Der Oberkoerper und die Arme sind jedoch auch von einem Pferdefell "
    "bedeckt und die langen Haare des Kopfes setzen sich am Ruecken in einer "
    "Art Maehne fort.");
  AddId( ({"centaur", "MAEHNE_WUSCHEL", }) );
 
  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinen kraeftigen Haenden", 300, DT_BLUDGEON }));
  SetProp(P_RACE, "Pferd");
  SetProp(P_SIZE, 250);
  SetProp(P_ALIGN, 700);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_MSGIN, "galoppiert herein");
  SetProp(P_MSGOUT, "galoppiert");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "wiehert laut.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_DIE_MSG, " zerfallt in einen Menschen- und einen Pferdekoerper.\n");
  SetProp(P_REJECT, ({ REJECT_KEEP, 
    Name(WER,1)+" nimmt @WEN dankend an.\n"}));

  SetChats(3, ({
    Name(WER,1)+" wiehert laut.\n",
    Name(WER,1)+" wiehert leise.\n",
    Name(WER,1)+" wiehert.\n"}) );

  SetProp(P_SPELLRATE, 30);
  AddSpell(1, 500,
    Name(WER,1)+" schlaegt mit seinen Hufen aus und trifft Dich.\n",
    Name(WER,1)+" schlaegt mit seinen Hufen aus und trifft @EWN.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  SUID;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Centaur ) "
               " -%d EP\n", lostexp) );
}

void die(int poisondeath) 
{
  write_file( LOG "centaur.kills",
    dtime(time())+": "+CAP(getuid(TP))+" toetet den Centauren.\n");
  ::die(poisondeath);
}
