// /d/huegelland/feyaria/wald/npc/hirschkaefer.c
// ein Hirschkaefer
// 2001-05-01  Feyaria@SilberLand

#include "../def.h"
#include <mnpc.h>

inherit  "std/mnpc.lpc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Riesenhirschkaefer");
  SetProp(P_LONG, 
    "Der Riesenhirschkaefer is fuer einen Kaefer wirklich riesengross, "
    "naemlich fast einen halben Meter! Er hat zwei grosse Zangen, die wie "
    "das Geweih eines Hirsches ausschauen, daher kommt wohl auch sein "
    "Name. Durch seine harte Chitinpanzerung ist sehr ziemlich gut "
    "geschuetzt.");
  SetProp(P_NAME, "Riesenhirschkaefer");
  SetProp(P_GENDER, MALE);
  AddId ( ({"kaefer", "hirschkaefer", "riesenhirschkaefer"}) );

  create_default_npc (7);
  SetProp(P_HANDS, ({" mit seinen langen Zangen", 55, DT_SQUEEZE}));
  SetProp(P_BODY, QueryProp(P_BODY)*2);
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 40+random(15));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_MSGIN, "marschiert herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "marschiert herein");
  SetProp(P_MMSGOUT, "marschiert weg");

  AddInfo(DEFAULT_INFO, "kann doch gar nicht reden.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.", "teilt Dir mit: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     Name(WER,1)+" kann das doch gar nicht tragen.\n"}));

  SUID;
  //CLONEME(ARMOUR "kaeferpanzer");
  command("trage panzer");
}
