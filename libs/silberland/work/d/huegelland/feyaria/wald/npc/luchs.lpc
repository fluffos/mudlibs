// /d/huegelland/feyaria/wald/npc/luchs.c   
// Ein Luchs
// 2001-04-28  Feyaria@SilberLand

#include "../def.h"
#include <mnpc.h>
inherit "std/mnpc";

void create()
{
  string name;
  int lvl;
  int alter;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Luchs");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG,
    "Der Luchs hat einen Stummelschwanz und dichte Bueschel an den Ohren. "
    "Mit seinem gefleckten Fell ist er im Wald gut getarnt.");
  AddId( ({"luchs", "FELL_WUSCHEL"}) );

  create_default_npc(17);
  SetProp(P_HANDS, ({" mit seinen scharfen Zaehnen", 
        QueryProp(P_HANDS)[1] + 30, DT_PIERCE}));
  SetProp(P_RACE, "Raubkatze");
  SetProp(P_SIZE, 120);
  SetProp(P_ALIGN, 150+random(50));
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "faucht Dich an.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_DIE_MSG, " verendet.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
    Name(WER,1)+" zerbeisst @WEN hungrig.\n"}));

  SetChats(3, ({
    Name(WER,1)+" beaeugt Dich misstrauisch.\n"}) );

  SetProp(P_SPELLRATE, 25);
  AddSpell(2, 200,
    Name(WER,1)+" beisst Dich.\n",
    Name(WER,1)+" beisst @WEN.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 350,
    Name(WER,1)+" krallt sich an Deinem Bein fest.\n",
    Name(WER,1)+" krallt sich an @WESSEN Bein fest.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  SUID;
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Luchs ) "
               " -%d EP\n", lostexp) );
}
