// /d/huegelland/feyaria/wald/npc/fuchs.c   
// Ein Fuchs
// 2001-04-28  Feyaria@SilberLand

#include "../def.h"
#include <npcmaster.h>
#include <ansi.h>

inherit "std/mnpc";

void create()
{
  string name;
  int lvl, alter;
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NO_SCORE, 1);
  switch( random(100))
  {
    case 0:
      name="Berserkerfuchs";
      SetProp(P_LONG, 
        "Dieser Fuchs hat ein blutrotes Fell, vor allem auf seinem Kopf, "
        "sodass es fast so aussieht, also ob er ein rotes Stirnband tragen "
        "wuerde. Daher kommt wohl auch sein Name. Seine Rute ist sehr lang "
        "und buschig. Er schaut Dich mit seinen blutruestigen Augen an und "
        "zeigt dabei seine toedlich scharfen Zaehne.");
        lvl=20;
        DB(ANSI_GREEN + ANSI_UNDERL + "*** WALD: " + ANSI_RED + 
            "Berserkerfuchs" + ANSI_NORMAL + "\n"); 
      break;
    case 1..8:
      name="Silberfuchs";
      SetProp(P_LONG, 
        "Dieser Fuchs hat ein silbgerglaenzendes Fell. Seine Rute ist lang "
        "und sehr buschig. Er schaut Dich mit seinen listigen Augen an und "
        "zeigt dabei seine scharfen Zaehne.");
        lvl=2;
      break;
    case 9..49:
      name="Rotfuchs";
      SetProp(P_LONG, 
        "Der Rotfuchs hat seinen Namen von seinem roetlichen Fell. Er "
        "beobachtet Dich aus seinen listigen Augen, aber seine lange, "
        "buschige Rute wedelt etwas, scheinbar haelt er Dich nicht fuer eine "
        "Beute.");
      break;    
    case 50..79:
      name="Graufuchs";
      SetProp(P_LONG, 
        "Das Fell des Graufuches ist, wie der Name schon sagt, grau. "
        "Auch seine kleinen Augen sind grau. In der Daemmerung ist er "
        "dadurch sehr gut getarnt. Aus seiner langen Schnauze schauen "
        "scharfen Zaehne heraus, zum Glueck bist Du zu gross, um fuer den "
        "Fuchs als Beute zu gelten.");
      break;    
    case 80..99:
      name="Schwarzfuchs";
      SetProp(P_LONG, 
        "Der Schwarzfuchs hat eine nachtschwarzes Fell. Mit seinen kleinen, "
        "gelben Augen schaut er aus wie ein echter Teufel. Seine Rute ist 2"
        "realtiv kurz und nicht so buschig wie bei anderen Fuechsen.");
      lvl=1;
      break;    
  }
  switch( random(10))
  {
    case 0: alter=-2; 
      SetProp(P_NAME_ADJ, "jung");
      AddAdjective( ({"jungen", "jung"}) );
      break;
    case 1: alter=1; 
      SetProp(P_NAME_ADJ, "alt");
      AddAdjective( ({"alten", "alt"}) );
      break;
    case 2: alter=2; 
      SetProp(P_NAME_ADJ, "gross");
      AddAdjective( ({"gross", "grossen"}) );
      break;
    case 3: alter=-1; 
      SetProp(P_NAME_ADJ, "klein");
      AddAdjective( ({"kleinen", "klein"}) );
      break;
    case 4: alter=4; 
      SetProp(P_NAME_ADJ, "riesig");
      AddAdjective( ({"riesigen", "riesig"}) );
      break;
    case 5: alter=0; 
      SetProp(P_NAME_ADJ, "schlau");
      AddAdjective( ({"schlauer", "schlauen"}) );
      break;
    case 6: alter=0; 
      SetProp(P_NAME_ADJ, "hungrig");
      AddAdjective( ({"hungriger", "hungrig", "hungrigen"}) );
      break;
    case 7: alter=1; 
      SetProp(P_NAME_ADJ, "listig");
      AddAdjective( ({"listigen", "listiger"}) );
      break;
    default: alter=0;
  }    
      
  SetProp(P_NAME, name);
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, Name(WER,0));
  AddId( ({"fuchs", LOWER(name), "FELL_WUSCHEL"}) );
  SetProp(P_INFO, BS(
    "Fuechse koenne sehr gefaehrlich sein, denn manche uebertragen die "
    "Tollwut."));

  create_default_npc(10+alter+lvl);
  SetProp(P_HANDS, ({" mit seinen scharfen Zaehnen", QueryProp(P_HANDS)[1], 
    DT_PIERCE}));
  SetProp(P_RACE, "Fuchs");
  SetProp(P_SIZE, 50+alter*10+lvl*7);
  SetProp(P_ALIGN, -150-random(100));
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "faucht Dich an.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_DIE_MSG, " faucht noch einmal laut und stirbt.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
    Name(WER,1)+" zerbeisst @WEN wuetend.\n"}));

  SetChats(3, ({
    Name(WER,1)+" sucht hier nach etwas Fressbarem.\n",
    Name(WER,1)+" schnueffelt am Boden herum.\n",
    Name(WER,1)+" faucht leise.\n",
    Name(WER,1)+" wedelt mit seiner Rute.\n",
    Name(WER,1)+" zeigt seine spitzen Zaehne.\n",
    Name(WER,1)+" schleicht um Dich herum.\n",
    Name(WER,1)+" beaeugt Dich misstrauisch.\n",
    Name(WER,1)+" schnueffelt an Dir herum.\n"}) );

  SetProp(P_SPELLRATE, 4+lvl+alter);
  AddSpell(1, 500+lvl*30+alter*50,
    Name(WER,1)+" steckt Dich mit Tollwut an.\n",
    Name(WER,1)+" steckt @WEN mit Tollwut an.\n",
    DT_POISON, ([SP_SHOW_DAMAGE:1]));
  if (QueryProp(P_LEVEL) > 25)
    AddSpell(2, 1000,
        Name(WER,1)+" berserkt Dich nieder.\n",
        Name(WER,1)+" berserker @WEN nieder.\n",
        DT_SLASH, ([SP_SHOW_DAMAGE:1]));

  SUID;

  ob=clone_object(ARMOUR "fuchsfell");
  ob->move(TO);
  ob->set_fuchs(name);
  command("trage fell");

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( "+name(WER,0)+" ) "
               " -%d EP\n", lostexp) );
}

void die(int poisondeath)
{
  if (QueryProp(P_NAME) == "Silberfuchs")
    write_file( LOG "rare.kills",
        dtime(time())+": "+CAP(getuid(TP))+" toetet "+name(WEN)+".\n");
  ::die(poisondeath);
}
