// /d/huegelland/feyaria/wald/npc/schlange.c   
// Eine SChlange
// 2001-05-01  Feyaria@SilberLand

#include "../def.h"
#include <npcmaster.h>

inherit "std/mnpc";
inherit "std/npc/spells";

void create()
{
  int poison, size;
  string pre, suf;
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  size = 0;
  switch( random(100))
  {
    case 0..10:  pre="Gold"; size = 1; break;    
    case 11..30: pre="Silber"; break;    
    case 31..50: pre="Gruen"; break;    
    case 51..70: pre="Ringel"; size = -1; break;    
    case 71..90: pre="Riesen"; size = 4; break;    
    case 91..98: pre="Regenbogen"; size = 1; break;    
    case 99:     pre="Feyaria"; size = 10; break;    
  }
  switch( random(100))
  {
    case 0..25:  suf="natter"; poison = 0; break;    
    case 26..50: suf="schlange"; poison = 0; break;    
    case 51..75: suf="viper"; poison = 1; break;    
    case 76..99: suf="otter"; poison = 1; break;    
  } 
  switch( random(50))
  {
    case 0..9: size += 1; poison *= 2;
      SetProp(P_NAME_ADJ, "gross");
      AddAdjective( ({"gross", "grossen"}) );
      break;
    case 10..19: size += -1; 
      SetProp(P_NAME_ADJ, "klein");
      AddAdjective( ({"kleinen", "klein"}) );
      break;
    case 20..25: size += 3; poison *= 3;
      SetProp(P_NAME_ADJ, "riesig");
      AddAdjective( ({"riesigen", "riesig"}) );
      break;
    case 26: size += 2; poison *= 5;
      SetProp(P_NAME_ADJ, "toedlich");
      AddAdjective( ({"toedliche", "toedlich"}) );
      break;
  }    
      
  SetProp(P_NAME, pre+suf);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
      Name(WER,1)+" schlaengelt sich auf dem Boden herum. Hoffentlich ist sie "
      "nicht giftig, denn sie koennte Dich jeden moment beissen.");
  AddId( ({"schlange", LOWER(pre), suf, LOWER(pre+suf), "SCHUPPEN_WUSCHEL"}) );

  create_default_npc(12 + size + random(3));
  SetProp(P_HANDS, ({" mit ihren Zaehnen", QueryProp(P_HANDS)[1], 
        (poison?({DT_PIERCE, DT_POISON}):({DT_PIERCE})) }) );
  SetProp(P_RACE, "Schlange");
  SetProp(P_SIZE, 100 + size * 50 + random(50));
  SetProp(P_ALIGN, -50 - random(100));
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_MSGIN, "schlaengelt sich herein");
  SetProp(P_MSGOUT, "schlaengelt sich");
  SetProp(P_MMSGIN, "kriecht aus einem Versteck heraus");
  SetProp(P_MMSGOUT, "verkriecht sich");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
  if (size + poison < 5)
    SetProp(P_NO_SCORE, 1);

  AddInfo(DEFAULT_INFO, "zischelt Dich an.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_DIE_MSG, " ringelt sich zusammen und stirbt.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
    Name(WER,1)+" wuergt @WEN in einem Bissen hinunter.\n"}));

  SetChats(3, ({
    Name(WER,1)+" windet sich wild am Boden herum.\n",
    Name(WER,1)+" zeigt Dir ihre spitzen Zaehne.\n",
    Name(WER,1)+" kriecht ein Stueck von Dir weg.\n",
    Name(WER,1)+" kriecht ein Stueck auf Dich zu.\n",
    Name(WER,1)+" zischelt Dich bedrohlich an.\n",
    Name(WER,1)+" rollt sich zusammen.\n",
    Name(WER,1)+" zischelt mit ihrer gespaltenen Zunge.\n",
    Name(WER,1)+" schlaengelt sich auf dem Boden herum.\n"}) );

  SetProp(P_SPELLRATE, 33 + size * 2);
  AddSpell(3, 150 + size * 20,
    Name(WER,1)+" beisst Dich ganz gemein in die Wade.\n",
    Name(WER,1)+" beisst @WEN ganz gemein in die Wade.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
  if(poison)
  {
    AddDefaultSpell(1,100 * poison, DS_POISON,
      Name(WER,1)+" beisst Dich mit ihrer Giftzaehnen.\n"
      "Ein brennender Schmerz durchfaehrt Dich! Du bist VERGIFTET!!!\n",
      Name(WER,1)+" beisst @WEN mit ihren Giftzaehnen.\n",
       poison);
    AddSpell(2, 200 + size * 20,
      Name(WER,1)+" spritzt Dir ihr Gift mitten ins Gesicht.\n",
      Name(WER,1)+" spritzt @WEM ihr Gift mitten ins Gesicht.\n",
      DT_POISON, ([SP_SHOW_DAMAGE:1]));
  }
  else
    AddSpell(1,200 + size * 30,
      Name(WER,1)+" umschlingt Dich und versucht, Dich zu erdruecken.\n",
      Name(WER,1)+" umschlingt @WEN mit ihrem langen Leib.\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
     

  SUID;
  ob = clone_object("/d/ebene/creative/feldlager/obj/haut");
  ob->move(TO);
  ob->SetProp(P_NAME, name(RAW) + "schlangenhaut");
  ob->AddId(lower_case(name(RAW) + "schlangenhaut"));
  ob->AddId(lower_case(name(RAW) + "haut"));
  ob->AddId(lower_case(ob->name(RAW)));
  ob->SetProp(P_SHORT, "Die Haut "+name(WESSEN,0));
  ob->SetProp(P_LONG,
      "Dies ist die Haut "+name(WESSEN,0)+". Wie jede Schlangenhaut besteht "
      "sie aus vielen kleinen Schuppen. Viele Alchemisten verwenden "
      "Schlangenhaeute als Zutaten fuer ihre wundertaetigen Traenke und "
      "Mixturen.");
  
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( "+name(WER,0)+" ) "
               " -%d EP\n", lostexp) );
}
