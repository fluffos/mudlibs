// /d/huegelland/feyaria/wald/npc/spinne.c   
// Eine Waldspinne
// 2004-09-24  Feyaria@SilberLand

#include "../def.h"

inherit "std/mnpc";
inherit "std/npc/spells";

void create()
{
  int alter;
  if (!is_clone(TO)) return;
  ::create();

  
  switch( random(7))
  {
    case 0: alter=-2; 
      SetProp(P_NAME_ADJ, "jung");
      AddAdjective( ({"junge", "jung"}) );
      break;
    case 1: alter=-1; 
      SetProp(P_NAME_ADJ, "klein");
      AddAdjective( ({"kleine", "klein"}) );
      break;
    case 2: alter=1; 
      SetProp(P_NAME_ADJ, "alt");
      AddAdjective( ({"alte", "alt"}) );
      break;
    case 3: alter=2; 
      SetProp(P_NAME_ADJ, "gross");
      AddAdjective( ({"gross", "grosse"}) );
      break;
    case 4: alter=4; 
      SetProp(P_NAME_ADJ, "riesig");
      AddAdjective( ({"riesige", "riesig"}) );
      break;
    default: alter=0;
  }    
      
  SetProp(P_NAME, "Waldspinne");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, 
      "Eine Waldspinne, eine der groessten Spinnenarten im SilberLand. Sie "
      "ist gross genug, um Jagd auf die meisten Tierarten im Wald zu machen. "
      "Sie spannt ihre Netze zwischen den Baeumen und wartet, bis sich ein "
      "Reh oder ein Hase darin verfaengt. Sie hat acht lange, haarige Beine "
      "und einen grossen Kopf, der mit gefaehrlichen Beissern bestueckt ist. "
      "Ihr Koerper ist durch einen harten Panzer geschuetzt.");
  AddId( ({"spinne", "waldspinne"}) );

  create_default_npc(12+alter);
  SetProp(P_HANDS, ({" mit ihren acht Beinen", QueryProp(P_HANDS)[1] + 50, 
    DT_PIERCE}));
  SetProp(P_RACE, "Spinne");
  SetProp(P_BODY, QueryProp(P_BODY) * 2);
  SetProp(P_SIZE, 150 + alter * 40);
  SetProp(P_ALIGN, -150 - random(100));
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_RESISTANCE_STRENGTHS, 
      ([DT_POISON: -1, DT_TERROR: -1, DT_MIND: -1]) );

  SetProp(P_MSGIN, "trippelt herein");
  SetProp(P_MSGOUT, "trippelt");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "zischt Dich an.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_DIE_MSG, " faellt auf den Ruecken und streckt ihre acht Beine in die Luft.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
    Name(WER,1)+" frisst @WEN.\n"}));

  SetChats(3, ({
    Name(WER,1)+" seilt sich an einem Spinnenfaden ab.\n",
    Name(WER,1)+" sieht Dich hungrig an.\n",
    Name(WER,1)+" prueft ihr Netz.\n",
    Name(WER,1)+" spannt ein Netz zwischen den Baeumen.\n"}) );

  SetProp(P_SPELLRATE, 50 + alter * 10);
  AddSpell(3, 200 + alter * 50,
      Name(WER,1)+" beisst Dich.\n",
      Name(WER,1)+" beisst @WEN.\n",
      DT_POISON, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1, 300 + alter * 50, DS_POISON,
      Name(WER,1)+" sprizt ihr Gift in Deine Adern.\n",
      Name(WER,1)+" sprizt ihr Gift in @WESSEN Adern.\n");
  AddDefaultSpell(1, 200 + alter * 30, DS_PARALYZE,
      Name(WER,1)+" faengt Dich mit ihrem Netz.\n",
      Name(WER,1)+" faengt @WEN mit ihrem Netz.\n", 3 + alter);

  SUID;

  CLONEME("/p/std/skills/sewing_tanning/obj/spinnenseide");
  if (alter > 0)
    CLONEME("/p/std/skills/sewing_tanning/obj/spinnenseide");
  if (alter > 2)
    CLONEME("/p/std/skills/sewing_tanning/obj/spinnenseide");
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( "+name(WER,0)+" ) "
               " -%d EP\n", lostexp) );
}

void die(int poisondeath)
{
  if (QueryProp(P_NAME) == "Silberfuchs")
    write_file( LOG "rare.kills",
        dtime(time())+": "+CAP(getuid(TP))+" toetet "+name(WEN)+".\n");
  ::die(poisondeath);
}
