// /d/huegelland/feyaria/wald/npc/baer.c   
// Ein Baer
// 2001-05-07  Feyaria@SilberLand

#include "../def.h"
#include <npcmaster.h>
#include <ansi.h>
#include "/p/daemon/itemd/itemd.h"

inherit "std/mnpc";

void create()
{
  int alter;
  string baername, chat,farbe;
  object ob;

  if (!is_clone(TO)) return;
  ::create();
  
  alter = 0;
  chat = "brummt";
  farbe = "braun";
  SetProp(P_NO_SCORE, 1);
  switch (random(100))
  {
    case 0..19:
      baername = "Braunbaer";
      alter = 1;
      SetProp(P_LONG, 
        "Dieser Braunbaer schaut genauso aus, wie man sich einen Baeren "
        "vorstellt. Samtiges Fell, breite Tatzen, Knopfaugen, eine lange "
        "Schnauze mit grossen Zaehnen und einen etwas plumpen Koerper. "
        "Obwohl er sehr kuschelig ausschaut, ist ein Baer doch ein Raubtier, "
        "dass man nie unterschaetzen sollte.");
      break;
    case 20..39:
      baername = "Schwarzbaer";
      farbe = "schwarz";
      SetProp(P_LONG, 
        "Der Schwarzbaer hat ein durch und durch schwarzes Fell und eine "
        "relativ schmale Schnauze. Wahrscheinlich kommt er mit der in jeden "
        "Bienenstock hinein. Und Tatsaechlich schaut sein Mund ziemlich mit "
        "Honig verklebt aus. Aber Vorsicht! Vielleicht will er nach so viel "
        "suessen Sachen wieder einmal Fleisch kosten!");
      break;
    case 40..59:
      alter = 5;
      baername = "Grizzlybaer";
      farbe = "grau";
      SetProp(P_LONG, 
        "Der Grizzlybaer ist einer der groessten und staerksten Baeren. "
        "Sein dunkelgraues Fell schaut eher schaebig aus, aber seine grossen "
        "Tatzen und sein maechtiges Gebiss floessen Dir Respekt ein. Besser "
        "Du kommst ihm nicht zu nahe.");
      break;
    case 60..79:
      alter = -1;
      baername = "Waldbaer";
      SetProp(P_LONG, 
        "Der Waldbaer ist ein wenig kleiner als andere Baeren, lebt er doch "
        "im dichtesten Wald, wo wenig Platz fuer so riesenhafte Wesen ist. "
        "Aber auch so hat er gefaehrliche Tatzen, denen man nicht zu nahe "
        "kommen sollten.");
      break;    
    case 80..87:
      baername = "Riesenbaer";
      alter = 10;
      SetProp(P_LONG, 
        "Der Riesenbaer ist wirklich riesengross. Er ueberragt jeden anderen "
        "Baeren um Laengen. Sein braunes Fell und die breiten Tatzen lassen "
        "auf eine Verwandtschaft mit normalen Braunbaeren schliessen. "
        "Komm ihm besser nicht zu nahe, vielleicht stehst Du ja auf seinem "
        "Speisezettel.");
      if (random(2))
        SetProp(P_NO_SCORE, 0);
      break;    
    case 88..91:
      baername = "Brummbaer";
      chat = "brummt, brummt, brummt";
      SetProp(P_LONG, 
        "Der Brummbaer schaut eigentlich aus wie ein ganz normaler Baer, aber "
        "nach wenigen Augenblicken macht einen das staendige Brummen ganz "
        "nervoes. Angeblich koennen manche Brummbaeren andere Lebewesen zu "
        "Tode brummen, aber Du willst diese Legende gar nicht glauben.");
      SetProp(P_NO_SCORE, 0);
      break;    
    case 92..93:
      baername = "Erdbaer";
      SetProp(P_LONG, 
        "Den Erdbaer darf man auf keinen Fall mit den leckeren roten "
        "Walderbeeren verwechseln, auch wenn der Name so aehnlich ist. "
        "Der Erdbaer ist mindestens 1000 mal groesser als eine Erdbeere "
        "und sein Fell ist auch braun und nicht rot. Er hat seinen Namen "
        "davon, dass er sich staendig Hoehlen in den Erdboden graebt. "
        "Das sehr seltene Vorkommen macht den Erdbaer zu einem Tier der "
        "Legende. Aber nun hast Du den Beweis, dass es so ein Tier wirklich "
        "gibt!");
      SetProp(P_NO_SCORE, 0);
      break;    
    case 94..95:
      baername = "Heidelbaer";
      farbe = "heidelbeerblau";
      SetProp(P_LONG, 
        "Heidelbaer ist wohl der richtige Name fuer diesen Baer. Er ernaehrt "
        "sich scheinbar wirklich nur von Heidelbeeren, die so zahlreich in "
        "diesem Wald wachsen. Dadurch ist sein Fell auch ziemlich blau, "
        "allerdings bist Du Dir nicht sicher, ob das seine natuerliche Farbe "
        "ist, oder ob das nur von zerquetschen Heidelbeeren kommt. Das sehr "
        "seltene Vorkommen macht den Heidelbaer zu einem Tier der Legende. Aber "
        "nun hast Du den Beweis, dass es so ein Tier wirklich gibt!");
      SetProp(P_NO_SCORE, 0);
      break;    
    case 96..97:
      baername = "Himmbaer";
      chat = "himmt";
      SetProp(P_LONG, 
        "Du haettest nie gedacht, dass es auch ein Tier gibt, das den "
        "gleichklingenden Namen traegt wie die leckeren Himbeeren, die auch "
        "hier im Wald wachsen. Aber Du bist Dir ganz sicher, dass das ein "
        "Himmbaer ist, weil er nicht brummt sondern himmt. Das sehr seltene "
        "Vorkommen macht den Himmbaer zu einem Tier der Legende. Aber nun hast "
        "Du den Beweis, dass es so ein Tier wirklich gibt!");
      SetProp(P_NO_SCORE, 0);
      break;    
    case 98..99:
      baername = "Stachelbaer";
      SetProp(P_LONG, 
        "Der Stachelbaer hat ein sehr stacheliges Fell, daher kommt wohl "
        "auch sein Name. Die Namensaehnlichkeit zu den Stachelbeeren und "
        "sein sehr seltenes Vorkommen machen den Stachelbaer zu einem "
        "Tier der Legende. Aber nun hast Du den Beweis, dass es so ein Tier "
        "wirklich gibt!");
      SetProp(P_NO_SCORE, 0);
      break;    
  
  }
  if (!QueryProp(P_NO_SCORE))
    DB(ANSI_GREEN+ANSI_UNDERL+"*** WALD: "+baername+ANSI_NORMAL+"\n"); 
  SetProp(P_SHORT, "Ein "+baername);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, baername);
  AddId( ({"baer", LOWER(baername), "FELL_WUSCHEL"}) );

  create_default_npc(22 + alter);
  SetProp(P_HANDS, ({" mit seinen grossen Tatzen", QueryProp(P_HANDS)[1] + 50, 
        DT_BLUDGEON}));
  SetProp(P_RACE, "Baer");
  SetProp(P_SIZE, 250 + alter * 20);
  SetProp(P_ALIGN, -150);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "stapft herein");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, chat + " Dich an.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_DIE_MSG, " " + chat + " noch einmal und stirbt.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    Name(WER,1) + " mag @WEN nicht haben.\n"}));

  SetChats(3, ({
    Name(WER,1) + " " + chat + " ganz laut.\n",
    Name(WER,1) + " " + chat + ".\n",
    Name(WER,1) + " " + chat + " leise.\n",
    Name(WER,1) + " schaut Dich hungrig an.\n"}) );

  SetProp(P_SPELLRATE, 25 + alter * 5);
  AddSpell(1, 300 + alter * 10,
    Name(WER,1) + " beisst Dich mit seinem maechtige Gebiss.\n",
    Name(WER,1) + " beisst @WEN mit seinem maechtige Gebiss.\n",
     DT_PIERCE, ([SP_SHOW_DAMAGE: 1]));

  SUID;
  ob = clone_object("/p/armour/cloak/baerenfell");
  ob->move(TO);
  ob->SetProp(P_LONG, 
    "Das Fell "+name(WESSEN,1) + " hat eine " + farbe + "e Farbe. ");
  ob->SetProp(P_SHORT,
    "Das Fell "+name(WESSEN, 0));  
  ob->RemoveId("braunbaerenfell");  
  ob->AddId(LOWER(baername) + "fell");  
  ob->AddId(LOWER(baername) + "enfell");  
  if (baername == "Grizzlybaer")
    ob->AddId("grizzlyfell");  
  ob->SetProp(P_NAME, baername + "enfell");
  ob->SetProp(P_ITEMD_NO_SOCKETED, 1);
  command("trage alles");

}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( "+name(WER,0)+" ) "
               " -%d EP\n", lostexp) );
}

void die(int poisondeath)
{
  if (!QueryProp(P_NO_SCORE))
    write_file( LOG "rare.kills",
        dtime(time())+": "+CAP(getuid(TP))+" toetet "+name(WEN)+".\n");
  ::die(poisondeath);
}
