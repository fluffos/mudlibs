// /d/huegelland/feyaria/wald/npc/einhorn.c   
// Das Einhorn
// 2001-05-09  Feyaria@SilberLand

#include "../def.h"
#include <mnpc.h>
inherit "std/mnpc";
inherit "std/npc/spells";

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_NAME, "Einhorn");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, "Das Einhorn");
  SetProp(P_LONG,
    "Nie hast Du geglaubt, dass Du einmal das Einhorn wirklich mit eigenen "
    "Augen sehen wirst. Es ist eines der seltestens Geschoepfe, die es im "
    "SilberLand gibt. Es schaut aus wie ein praechtig gewachsener Hengst "
    "mit einem einzigen, gewaltigen Horn mitten auf der Stirn. Die Maehne "
    "ist sehr lang, und auch ueber den breiten Hufen wachsen dichte "
    "Haarbueschel.");
  AddId( ({"einhorn", "MAEHNE_WUSCHEL", "unicorn"}) );
  set_living_name("feyarias_unicorn"); 
  // Geheimer Name, damit man nicht mitteilen kann
  
  
  create_default_npc(35);
  SetProp(P_HANDS, ({" mit seinen Horn", 400, ({DT_PIERCE, DT_MAGIC}) }));
  SetProp(P_RACE, "Einhorn");
  SetProp(P_SIZE, 220);
  SetProp(P_BODY, QueryProp(P_BODY)*2);
  SetProp(P_XP, QueryProp(P_XP)*3/2);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "galoppiert herein");
  SetProp(P_MSGOUT, "galoppiert");
  SetProp(P_MMSGIN, "erscheint ploetzlich");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
  SetProp(P_RESISTANCE_STRENGTHS, ([
    DT_HOLY:-1, DT_UNHOLY:0.2, DT_MIND:-0.5, DT_LIGHTNING:-0.5, DT_SOUND:-0.5,
    DT_MAGIC: -0.5, DT_TERROR:-0.5 ]) );

  AddInfo(DEFAULT_INFO, "wiehert laut.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_DIE_MSG, " wird jetzt nie ein Zweihorn werden koennen.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    Name(WER,1)+" will @WEN nicht mit sich herumtragen.\n"}));

  SetChats(3, ({
    "Das Einhorn wiehert laut.\n",
    "Das Einhorn wiehert leise.\n",
    "Das Einhorn senkt seinen Kopf und zeigt mit dem Horn auf Dich.\n",
    "Das Einhorn sucht hier nach einer Jungfrau.\n",
    "Das Einhorn hebt sein Horn zum Himmel.\n",
    "Das Einhorn wiehert.\n"}) );

  SetProp(P_SPELLRATE, 80);
  AddSpell(3, 600,
    "Das Einhorn schlaegt mit seinen Hufen aus und trifft Dich.\n",
    "Das Einhorn schlaegt mit seinen Hufen aus und trifft @EWN.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(2, 500, DS_MASS_BLIND,
    "Ein extremes Leuchten geht vom Einhorn aus.\n",
    "Ein extremes Leuchten geht vom Einhorn aus.\n",5 );
  AddDefaultSpell(1, 700, DS_MASS_DAMAGE,
    "Ein gewaltige Schockwelle erchuettert den Raum.\n",
    "Ein gewaltige Schockwelle erchuettert den Raum.\n",DT_EXPLOSION );
  AddDefaultSpell(2, 200, DS_PARALYZE,
    "Das Einhorn beruehrt Dich mit dem Horn und Du erstarrst zu Stein.\n",
    "Das Einhorn beruehrt Dich mit dem Horn und @WER erstarrt zu Stein.\n",3);
  AddSpell(1,1000,
    "Das Einhorn schleudert Dich mit einem gezielt Tritt hinfort.\n",
    "Das Einhorn schleudert @WEN mit einem gezielt Tritt hinfort.\n",
    DT_BLUDGEON, "wegschleudern");

  SUID;
  CLONEME(WEAPON "horn");
}

void wegschleudern(object enemy)
{
  object* rooms;
  rooms=m_values(MENV->QueryProp(P_EXITS));
  enemy->move(rooms[random(sizeof(rooms))], M_GO, "wird vom Einhorn fortgeschleudert", "",
    "fliegt in hohem Bogen herein");
  enemy->SetProp(P_PARALYZED, 10);  
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( Einhorn ) "
               " -%d EP\n", lostexp) );
}

void die(int poisondeath) 
{
  write_file( LOG "einhorn.kills",
    dtime(time())+": "+CAP(getuid(TP))+" toetet das Einhorn.\n");
  ::die(poisondeath);
}
