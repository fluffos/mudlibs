// /d/huegelland/feyaria/wald/npc/reh.c   
// Ein Reh
// 2001-04-08  Feyaria@SilberLand

#include "../def.h"
#include <mnpc.h>
inherit "std/mnpc";

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  switch( random(7))
  {
    case 0:
      SetProp(P_SHORT, "Ein scheues Reh");
      SetProp(P_NAME_ADJ, "scheu");
      AddAdjective( ({"scheu", "scheues"}) );
      SetProp(P_WIMPY, 25);
      break;
    case 1:
      SetProp(P_SHORT, "Ein neugieriges Reh");
      SetProp(P_NAME_ADJ, "neugierig");
      AddAdjective( ({"neugierig", "neugieriges"}) );
      break;
    case 2:
      SetProp(P_SHORT, "Ein schoenes Reh");
      SetProp(P_NAME_ADJ, "schoen");
      AddAdjective( ({"schoen", "schoenes"}) );
      break;
    case 3:
      SetProp(P_SHORT, "Ein wildes Reh");
      SetProp(P_NAME_ADJ, "wild");
      AddAdjective( ({"wild", "wildes"}) );
      break;
    case 4:
      SetProp(P_SHORT, "Ein junges Reh");
      SetProp(P_NAME_ADJ, "jung");
      AddAdjective( ({"jung", "junges"}) );
      break;
    case 5:
      SetProp(P_SHORT, "Ein suesses Reh");
      SetProp(P_NAME_ADJ, "suess");
      AddAdjective( ({"suess", "suesses"}) );
      break;
    case 6:
      SetProp(P_SHORT, "Ein kleines Reh");
      SetProp(P_NAME_ADJ, "klein");
      AddAdjective( ({"klein", "kleines"}) );
      break;
  }
  SetProp(P_LONG, BS(
    "Das Reh hat ein rostrotes, weiches Fell und ein kleines, zweiendiges "
    "Geweih. Es schaut Dich scheu mit seinen grossen, braunen Rehaugen an."));
  SetProp(P_NAME, "Reh");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"reh", "FELL_WUSCHEL"}) );

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit seinem kleinen Geweih", 70, DT_PIERCE}));
  SetProp(P_RACE, "Hirsch");
  SetProp(P_SIZE, 65+random(10));
  SetProp(P_ALIGN, 250);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_WEIGHT, 20000);
  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "springt");
  SetProp(P_MMSGIN, "springt herein");
  SetProp(P_MMSGOUT, "springt weit weg");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "schaut Dich verschreckt an.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     Name(WER,1)+" kann nichts mit Deinen Sachen anfangen.\n"}));
  SetProp(P_DIE_MSG, " bricht tot zusammen.\n" );

  SetChats(3, ({
    Name(WER,1)+" schaut Dich ganz scheu mit seinen grossen Rehaugen an.\n",
    Name(WER,1)+" knabbert an den Blaettern der Baeume.\n",
    Name(WER,1)+" blickt nervoes hin und her.\n",
    Name(WER,1)+" zittert leicht.\n",
    Name(WER,1)+" schaut sich aengstlich um.\n",
    Name(WER,1)+" zieht pruefend die Luft in seine Nuestern.\n",
    Name(WER,1)+" schnuppert.\n"}) );

  seteuid(getuid(TO));
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( "+name(WER,0)+" ) "
               " -%d EP\n", lostexp) );
}
