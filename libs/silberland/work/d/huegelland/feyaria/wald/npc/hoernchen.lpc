// /d/huegelland/feyaria/wald/npc/hoernchen.c
// Ein Hoernchen
// 2001-04-08 Feyaria@SilberLand

#include "../def.h"
#include <mnpc.h>
inherit "std/mnpc";

void rand_farb()
{
  switch( random(6))
  {
    case 0: 
      SetProp (P_NAME_ADJ, "grau"); 
      AddAdjective( ({"graues"}) );
      break;
    case 1: 
      SetProp (P_NAME_ADJ, "braun"); 
      AddAdjective( ({"braunes"}) );
      break;
    case 2: 
      SetProp (P_NAME_ADJ, "rotbraun"); 
      AddAdjective( ({"rotbraunes"}) );
      break;
  }
}

void rand_muster()
{
  switch( random(6))
  {
    case 0: 
      SetProp (P_NAME_ADJ, "gestreift"); 
      AddAdjective( ({"gestreiftes"}) );
      break;
    case 1: 
      SetProp (P_NAME_ADJ, "gefleckt"); 
      AddAdjective( ({"geflecktes"}) );
      break;
    case 2: 
      SetProp (P_NAME_ADJ, "gepunktet"); 
      AddAdjective( ({"gepunktetes"}) );
      break;
  }
}


void create()
{
  string name;
  if (!is_clone(ME)) return;
  ::create();
   
  switch(random(5))
  {
    case 0: name="Streifenhoernchen"; rand_farb(); break;
    case 1: name="Fleckenhoernchen"; rand_farb(); break;
    case 2: name="Eichhoernchen"; rand_muster(); break;      
    case 3: name="Grauhoernchen"; rand_muster(); break;
    case 4: name="Flughoernchen"; 
      if( random(100)%2) rand_muster(); else rand_farb();break;
  }
  if( !QueryProp(P_NAME_ADJ) )
  {
    switch( random(7))
    {
      case 0: 
        SetProp (P_NAME_ADJ, "frech"); 
        AddAdjective( ({"freches"}) );
        break;
      case 1: 
        SetProp (P_NAME_ADJ, "neugierig"); 
        AddAdjective( ({"neugieriges"}) );
        break;
      case 2: 
        SetProp (P_NAME_ADJ, "scheu"); 
        AddAdjective( ({"scheues"}) );
        break;
      case 3: 
        SetProp (P_NAME_ADJ, "klein"); 
        AddAdjective( ({"klein"}) );
        break;
      case 4: 
        SetProp (P_NAME_ADJ, "gross"); 
        AddAdjective( ({"gross"}) );
        break;
    }
  }
  SetProp(P_NAME, name);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SHORT, Name(WER,0));
  SetProp(P_LONG, Name(WER,1)+" ist ein kleines Nagetier, das in jedem Wald "
    "zuhause ist. Eifrig auf der Suche nach Nuessen und anderen Leckerbissen "
    "springt des von Ast zu Ast.");
  
  AddId( ({"hoernchen", LOWER(name), "nagetier"}));

  create_default_npc (6+random(3));
  SetProp(P_HANDS, ({" mit seinen Knabberzaehnchen", QueryProp(P_HANDS)[1], 
    DT_PIERCE}));
  SetProp(P_RACE, "Nagetier");
  SetProp(P_SIZE, 20+random(10));
  SetProp(P_ALIGN, 50+random(200) );
  SetProp(P_DIE_MSG, " faellt tot vom Baum hinunter.\n");

  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "springt");
  SetProp(P_MMSGIN, "kommt von einem Baum heruntergesprungen");
  SetProp(P_MMSGOUT, "springt auf einen Baum und verschwindet");
  SetProp(P_MNPC_AREA, ({ ROOM }));
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "beachtet Dich gar nicht.\n");
  AddInfo("feyaria", "teilt Dir mit: Feyaria hat mich erschaffen.\n");
  AddInfo(({"nuss", "haselnuss"}), 
      "piepst: Meine Nuss bekommst Du nicht!\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
    Name(WER,1)+" kann das doch gar nicht tragen.\n"}));

  SetChats(2, ({
    Name(WER,1)+" beaeugt Dich misstrauisch.\n",
    Name(WER,1)+" laeuft auf einem Baumstamm auf und ab.\n",
    Name(WER,1)+" schaut Dich neugierig an.\n",
    Name(WER,1)+" knabbert an einer Nuss.\n",
    Name(WER,1)+" versteckt eine Nuss in einem Astloch.\n",
    Name(WER,1)+" holt eine Nuss aus einem Astloch heraus.\n",
    Name(WER,1)+" springt zwischen den Zweigen hin und her.\n"}) );

  SUID;
  if( !random(3) ) 
    CLONEME("/d/ebene/obj/div/haselnuss");
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if( killer == TO )
    write_file(LOG "kills",
      sprintf( ctime()+": "+CAP(getuid(player))+" ( "+name(WER,0)+" ) "
               " -%d EP\n", lostexp) );
}
