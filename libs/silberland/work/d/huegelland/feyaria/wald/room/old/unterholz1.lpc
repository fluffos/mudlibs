/* unterholz1.c im ostwald 
   Urspruengliches File von Kermet */


#include <properties.h>
#include <moving.h>

#ifndef ROOM
#define ROOM(x) ("/d/kristallwald/kermet/feenland/anfaenger/room/"+x)
#endif

inherit "std/room";

void create()
{
  ::create();
  // ROOM DESCRIPTION
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Im Unterholz.");
  SetProp (P_INT_LONG,
    "Nachdem du ein bischen im Unterholz weitergekrochen bist, erkennst: "+
    "es sieht ueberall fast gleich aus. Auch hier gibts Straeucher, Aeste "+
    "und dergleichen. Irgendetwas besonderes kannst du hier nicht sehen.");
  // ROOM DESCRIPTION END

  // DETAILS START
  AddDetail ( ({"holz", "unterholz"}),
    "Das Unterholz besteht hier aus Aesten, Zweigen, Straeuchern...");
  AddDetail ( ({"aeste", "aesten", "ast"}),
    "Die einzelnen Aeste sind von den Baeumen abgebrochen und liegen hier "+
    "jetzt herum.");
  AddDetail ( ({"baeume", "baeumen", "baum"}),
    "Die Baeume kannst du von hier aus nicht sehen, weil sie oberhalb des "+
    "Unterholzes sind.");
  AddDetail ( ({"unterholzes"}),
    "Dies ist der Genetiv (zweite Fall) von Unterholz.");
  AddDetail ( ({"genetiv"}),
    "Genetiv ist der zweite Fall in der deutschen Sprache.");
  AddDetail ( ({"faelle", "fall"}),
    "Tja, du haettest in der Schule besser aufpassen sollen...");
  AddDetail ( ({"schule"}),
    "Warst du in einer ?");
  AddDetail ( ({"sprache"}),
    "Man spricht deutsch. :-)");
  AddDetail ( ({"zweig", "zweige", "zweigen"}),
    "Die Zweige hier koennte man auch als Aeste bezeichnen (was man "+
    "eigentlich immer kann).");
  AddDetail ( ({"straeucher", "straeuchern", "strauch"}),
    "Hier gibt`s soviele davon, dass du in dem Wirrwarr keinen einzelnen "+
    "ausmachen kannst.");
  AddDetail ( ({"wirrwarr"}),
    "Das Wirrwarr ist undurchdringlich.");
  AddDetail ( ({"boden"}),
    "Am Boden liegen vereinzelt abgebrochene Aeste herum.");
  AddDetail ( ({"himmel"}),
    "Leider kannst du den Himmel hier nicht sehen, weil die Aeste ueber "+
    "dir keinen freien Blick lassen.");
  AddDetail ( ({"blick"}),
    "Dein Blick ist zwar klar und rein, aber den Himmel kannst du trotzdem "+
    "nicht sehen. ;-)");
  // DETAILS END

  // EXITS START
  AddExit ("norden", "./a1");
  AddExit ("suedosten", "./a4");
  // EXITS END

  // ITEMS START
  // ITEMS END

}
