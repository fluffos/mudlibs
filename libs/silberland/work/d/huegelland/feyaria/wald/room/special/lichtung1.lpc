// lichtung1.c im wald 

#include "../../def.h"

inherit ROOM "std_waldraum";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf einer Lichtung mitten im Wald" );
  SetProp(P_INT_LONG,
      "Du stehst am Rand einer kleinen Lichtung mitten im Wald. "
      "Ein trostloser Fleck, der so ganz anders aussieht als der restliche "
      "Wald: das Gras ist verdorrt, ein Kreis verkuemmerter Baeume "
      "steht um eine schwarze, spiegelnde Lacke im Zentrum der Lichtung. "
      "Ein aufdringlich oeliger Geruch steigt Dir in die Nase, als eine sanfte "
      "Brise ueber den leicht sandigen Boden der Lichtung weht. Der Tod "
      "scheint hier allgegenwaertig. Du kannst ausser dem leisen Wind nicht "
      "das geringste Geraeusch vernehmen." );

  AddDetail( ({"lichtung"}),
     "Diese Lichtung ist sehr trostlos.");
  AddDetail( ({ "lacke", "pfuetze", "zentrum" }), 
      "Schwarz glitzert die Pfuetze im schwachen Licht, die "
      "Fluessigkeit duerfte Oel oder etwas aehnliches sein, wie Dich auch der "
      "aufdringliche Geruch vermuten laesst. Der Boden rings um die Lacke "
      "scheint verkohlt zu sein." );
  AddDetail( ({"licht"}),
      "Das Licht ist sehr schwach hier, es scheint fast von der schwarzen "
      "Fluessigkeit vedunkelt zu werden.");
  AddDetail( ({ "boden", "sandboden" }),
      "Der Boden hier auf der Lichtung ist im vergleich zum Rest des Waldes "
      "erstaunlich sandig, fast wie in einer Wueste oder am Strand eines "
      "Ozeans. Keine Pflanze waechst hier, nicht einmal der kleinste Grashalm, "
      "abgesehen von den verdorrten Baeumen die einen Kreis um die Lacke "
      "bilden." );
  AddDetail( ({"sand", "wueste"}),
      "Der Sand erinnert Dich an die Wueste, seltsam.....");
  AddDetail( ({"rest", "wald"}),
      "Der Rest des Waldes ist viel schoener als diese trostlose Lichtung.");
  AddDetail( ({"pflanze", "pflanzen"}),
      "Keine!");
  AddDetail( ({"ozean", "strand"}),
      "Du wuerdest jetzt viel lieber am Strand eines Ozeans sein als hier.");
  AddDetail( ({ "oel", "fluessigkeit", "oberflaeche" }), 
      "Die Fluessigkeit spiegelt schwarz, ihre Oberflaeche wird vom leichten "
      "Wind kaum bewegt und ist fast spiegelglatt." );
  AddDetail( ({ "gras", "grashalm", "halmen", "grashsalme", "halm"}),
      "Am Rande der Lichtung waechst noch verdorrtes, braeunliches Gras, zur "
      "Mitte hin verschwindet es immer mehr bis nur noch reiner Sand den Boden "
      "bedeckt. Dort am Rand scheinst Du zwischen den verdorrten Halmen etwas "
      "Weisses erkennen zu koennen." );
  AddDetail( ({ "rand", "rande" }), 
      "Die Lichtung scheint kreisrund zu sein und wirkt irgendwie nicht "
      "natuerlich sondern kuenstlich geschaffen. Zu abrupt scheint der "
      "Uebergang von den dichten Baeumen zum verdorrten Gras und sandigen "
      "Boden." );
  AddDetail( ({"uebergang"}),
      "Der Uebergang ist sehr abrupt, er kann nicht natuerlichen Ursprungs "
      "sein.");
  AddDetail( ({"ursprung"}),
      "Du ueberlegst welchen Ursprung das alles haben koennte, aber kannst "
      "es Dir nicht erklaeren.");
  AddDetail( ({ "baeume", "mitte" }), 
      "Die Baeume, die in der Mitte der Lichtung einen exakten Kreis bilden "
      "sind abgestorben und verdorrt, ein trauriger Anblick. Ausserdem "
      "scheinen sie im Unterschied zu den hohen, beeindruckenden, dunklen "
      "Tannen, die rund um die Lichtung gedeihen, Laubbaeume zu sein, Platanen "
      "scheinbar." );
  AddDetail(({"unterschied"}),
      "Also den Unterschied zwischen Nadelbaeumen und Laubbaeumen solltest "
      "Du kennen! Oder bist Du die ganze Zeit blind durch den Wald geirrt?");
  AddDetail( ({"zeit"}),
      "Die Zeit vergeht und vergeht....");
  AddDetail( ({"nadelbaum", "nadelbaeume", "tanne", "tannen"}),
      "Rund um die Lichtung besteht der Wald hauptsaechlich aus hohen dunklen "
      "Tannen.");
  AddDetail( ({"anblick"}),
      (["elf": "Wirklich sehr traurig, die armen Baeume! *schluchz*",
            0: "Ein echt trauriger Anblick."]));
  AddDetail( ({ "kreis" , "platanen", "platane", "laubbaeume", "laubbaum"}), 
      "Zwoelf tote Platanen, kein einziges Blatt mehr an den Zweigen, bilden "
      "den exakten Kreis um die oelige Lacke, fast wie eine Art Zaun oder "
      "Schutzwall." );
  AddDetail( ({"art", "zaun", "schutzwall"}),
      "Natuerlich kein echter Zaun, aber sie sollten wohl irgendetwas schuetzen.");
  AddDetail( ({"blatt", "blaetter", "zweig", "zweige"}),
      "Kein einziges mehr an den Zweigen.");
  AddDetail( ({ "tod" }), 
      "Der Tod scheint hier allgegenwaertig zu sein.\n"
      "Der Tod sagt: KOMM MIT MIR!\n"
      "... nein, war nur ein Scherz, aber ein Gefuehl sagt Dir mit grosser "
      "Gewissheit, dass es nicht mehr lange dauern kann." );
  AddDetail( ({"scherz"}),
      "Was fuer ein Scherz! Du koenntest Dich totlachen.");
  AddDetail( ({"gefuehl"}),
     "Jetzt hast Du ein ganz schlechtes Gefuehl, vielleicht solltest Du gehen "
     "bevor der Tod Dich auch holt!");
  AddDetail( ({"brise"}),
      "Eine sanfte Brise weht ueber die Lichtung.");
  AddDetail( ({"fleck"}),
      "Echt trostlos!");
  AddDetail( ({"geraeusch", "geruch"}),
      "Also sehen kannst Du das nicht... versuch mal riechen oder lauschen "
      "oder sowas.....");
  AddDetail( ({"gewissheit"}),
      "Sichern wirst Du bald sterben!");
  AddDetail( ({"himmel"}),
      "Auch der Himmel sieht sehr trist aus.");
  AddDetail( ({"nase"}),
      "Benutz Deine Nase einfach zum riechen!");
  AddDetail( ({"wind"}),
      "Der Wind ist sehr leise.");
  AddDetail( ({"weiss", "weisses"}),
      "Es scheint sich hier um Knochen zu handeln.");
  AddDetail( ({"knochen"}),
      "Zu welchem Wesen diese Knochen gehoeren, laesst sich leider nicht mehr "
      "bestimmen.");
  AddDetail( ({"wesen"}),
      "Das Wesen scheint wohl gestorben zu sein, wie diese Lichtung so "
      "verwuestet wurde.");

  AddSmell( ({DEFAULT_SMELL, "geruch"}), 
      "Es riecht sehr oelig. Der Geruch kommt ganz eindeutig von der schwarzen "
      "Fluessigkeit.");
  AddSmell( ({"fluessigkeit", "oel"}), 
      "Die schwarze Fluessigkeit riecht sehr eigenartig.");
  AddSound( ({DEFAULT_SOUND, "geraeusche", "geraeusch", "wind"}), 
      "Ausser dem Wind hoerst Du keine Geraeusche.");

}
 
