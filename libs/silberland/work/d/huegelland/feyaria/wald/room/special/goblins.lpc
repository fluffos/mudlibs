
#include "../../def.h"

inherit ROOM "std_waldraum";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "In einem Goblinlager mitten im Wald" );
  SetProp(P_INT_LONG,
      "Du stehst in einem kleinen Lager mitten im Wald. Zweifelsohne ist "
      "es ein Goblinlager, das riecht man nicht nur, auch das wueste "
      "Durcheinander kann nur von Goblins stammen. Decken, Kisten und "
      "Saecke mit diversen Sachen liegen mitten unter Abfaellen und "
      "Essensresten - ein richtiges Chaos." );

  AddDetail( ({"boden"}),
      "Der Boden ist voll mit Decken, Kisten, Saecken, Abfaellen und "
      "Essensresten.");
  AddDetail( ({"himmel"}),
      "Der Himmel ist durch die dichten Baeume kaum zu sehen.");
  AddDetail( ({"lager", "goblinlager"}),
      "Das muss ein Goblinlager sein, das sieht und riecht man eindeutig.");
  AddDetail( ({"wald", "baeume", "nadelbaeume", "nadelbaum", "baum"}),
      "Der Wald besteht hier aus dichten Nadelbaeumen.");
  AddDetail( ({"durcheinander"}),
      "Ein richtiges Chaos.");
  AddDetail( ({"goblins", "goblin"}),
      "Nur Goblins koennen so ein fuerchterliches Lager machen.");
  AddDetail( ({"chaos"}),
      "Ein richtiges Durcheinander.");
  AddDetail( ({"decken", "decke"}),
      "Alte verschlissene Decken. Darin wuerdest Du nie schlafen!");
  AddDetail( ({"kiste", "kisten"}),
      "Alte verrostete Kisten. Du willst gar nicht wissen, was da drinnen ist.");
  AddDetail( ({"sack", "saecke"}),
      "Alte vermoderte Saecke. Du willst gar nicht wissen, was da drinnen ist.");
  AddDetail( ({"sachen", "sache"}),
      "Du willst gar nicht wissen, was das fuer Sachen sind.");
  AddDetail( ({"abfaelle", "abfall"}),
      "Eklig.");
  AddDetail( ({"essensreste", "reste", "essensrest", "rest"}),
      "Eklig.");

  AddSmell( ({DEFAULT_SMELL, "goblin", "goblins"}), 
      "Es riecht sehr streng nach Goblins.");
  AddSound( ({DEFAULT_SOUND}), 
      "Du hoerst die normalen Waldgeraeusche, dazwischen aber auch ab und zu "
      "die plappernde Sprache der Goblins.");
  AddSound( ({"waldgeraeusche", "geraeusche"}),
      "Die normalen Waldgeraeusche eben.");
  AddSound( ({"goblin", "goblins", "sprache"}),
      "Du kannst die Sprache der Goblins leider nicht verstehen.");

  AddItem("/d/kristallwald/sargola/dorf/npc/fgoblin", REFRESH_DESTRUCT);
  AddItem("/d/kristallwald/sargola/dorf/npc/goblin", REFRESH_DESTRUCT);
  AddItem("/d/kristallwald/sargola/dorf/npc/jgoblin", REFRESH_DESTRUCT);
}
 
