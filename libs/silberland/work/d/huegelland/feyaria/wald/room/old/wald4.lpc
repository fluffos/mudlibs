inherit "std/room";

#include <properties.h>
#include <language.h>
#include <defines.h>
#include <moredef.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Mitten im Wald" );
  SetProp( P_INT_LONG, "Du befindest Dich mitten in einem riesigen Wald "
     "voller Pflanzen, Tiere und Pilze. In diesem Bereich ist es ein "
     "charakteristischer Mischwald mit Baeumen aller Groessenordnungen, "
     "sodass auch viel Licht auf den Boden faellt, damit auch Straeucher und "
     "Graeser eine Ueberlebenschance haben. Die naturverbundene Umgebung "
     "wirkt sehr beruhigend auf Dich. Obwohl Dir natuerlich bewusst ist, "
     "dass hinter jedem Busch oder Baum eine von vielen Gefahren "
     "des Waldes auf Dich lauern kann.");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 19]) );

  AddDetail( ({ "" }), 
    "" );
  AddDetail( ({ "" }), 
    "" );
  AddDetail( ({ "" }), 
    "" );
  AddDetail( ({ "" }), 
    "" );
  AddDetail( ({ "" }), 
    "" );
  AddDetail( ({ "" }), 
    "" );
  AddDetail( ({ "" }), 
    "" );
  AddDetail( ({ "" }), 
    "" );
  AddDetail( ({ "" }), 
    "" );

//  AddDetail( ({ "" }), 
//    "" );


}
