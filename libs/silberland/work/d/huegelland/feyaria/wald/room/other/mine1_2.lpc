
#include "../../def.h"

inherit ROOM "other/std_mine";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
            QueryProp(P_INT_LONG)[0..<2] + " Der Gang fuehrt hier von Norden "
            "nach Sueden.");

  AddItem("/d/gebirge/angrox/npc/zarbeit", REFRESH_DESTRUCT,
      ([P_MNPC_DEFAULTROOM: file_name(TO), 
        P_MNPC_AREA: ROOM "other/mine",
        P_MNPC_FLAGS: MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES,
      ]) );

  AddExit( "norden", "./mine1_3");
  AddExit( "sueden", "./mine1_1");
}
 
