
#include "../../def.h"

inherit ROOM "other/std_mine";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
      QueryProp(P_INT_LONG)[0..<2] + " In der Decke und im Boden befindet sich jeweils "
      "ein grosses Loch. Hier faehrt wohl der Aufzug nach unten und nach "
      "oben. Gaenge fuehren in alle vier Himmelsrichtungen.");
  
  AddDetail( ({"decke"}),
      "In der Decke befindet sich ein grosses Loch.");
  AddDetail( ({"boden"}),
      "Im Boden befindet sich ein grosses Loch.");
  AddDetail( ({"aufzug"}),
      "Hier kann man mit dem Aufzug nach oben und unten fahren.");

  AddItem(ROOM "other/aufzug", REFRESH_DESTRUCT, 1);

  AddExit( "norden", "./mine4_2");
  AddExit( "sueden", "./mine4_3");
  AddExit( "osten", "./mine4_4");
  AddExit( "westen", "./mine4_6");
}
 
