/* wald1.c im ostwald 
   Urspruengliches File von Lexana */

inherit "std/room";

#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>


void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Auf einem Waldweg");

  SetProp(P_INT_LONG,
    "Du befindest Dich auf einem Waldweg der sich seinen Weg sanft "+
    "durch Buesche und Baeume bahnt. Die Sonnenstrahlen die ihren Weg "+ 
    "durch das saftig gruene Blaetterdach finden fuehlen sich angenehm warm auf "+
    "Deiner Haut an. Vogelgezwitscher rundet das Bild von einer romantischen "+
    "Waldlandschaft ab. Du fuehlst Dich hier einfach wohl.");

  SetProp( P_LIGHT, 1 );
  SetProp(P_INDOORS,0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:22, ENV_TERRAIN:TT_FOREST]));

  AddDetail(({"lichtstrahlen","licht","sonnenstrahlen","strahlen"}),
     "Die Sonnenstrahlen erhellen den Wald ausreichend.");
  AddDetail(({"blaetterdach","dach"}),
     "Das Blaetterdach laesst ausreichend Sonnenstrahlen durch.");
  AddDetail(({"haut","zehe"}),
     "Hmmm...schoen.... sonnengebraeunt.");
  AddDetail(({"vogelgezwitscher","gezwitscher","voegel","voegel"}),
     "Die Voegel des Waldes lassen sich durch Dich nicht in ihrem Gezwitscher "+
      "stoeren.");	
  AddDetail( ({ "weg", "waldweg","gebiet","pfad" }),
    "Der Waldweg schlaengelt sich sanft durch den Wald. An seinen "+
    "Raendern und auf dem Weg selbst, wachsen allerlei Graeser, Blumen "+
    "und Beeren. Daraus schliesst Du, dass dieser Weg schon seit laengerem "+
    "nicht mehr benutzt worden ist.");
  AddDetail(({"wald","landschaft","waldlandschaft"}),
    "Der Wald stellt hier einen aeusserst schoenen Anblick dar. Graeser, "
    "Buesche und Baeume bluehen und gedeihen hier in einer Pracht die Du "
    "schon seit langem nicht mehr gesehen hast. Der Wald bietet sicherlich "
    "Heimat fuer viele Tiere. Ein Weg durchschneidet hier den Wald.");
  AddDetail(({"pracht","stimmung"}),
    "Der Anblick der sich Dir hier bietet ist wahrhaft prachtvoll.");
  AddDetail(({"heimat","heim"}),
     "Der Wald duerfte vielen Tieren eine Heimat bieten.");
  AddDetail("anblick",
    "Der ist hier sehr romantisch.");
  AddDetail(({"gras","graeser","gras","halme"}),
    "Du siehst frische gruene Graeser der unterschiedlichsten Sorten. "
    "Einer der Grashalme scheint angeknabbert zu sein...");
  AddDetail(({"sorten","sorte","grassorten","grassorte"}),
    "Da Du kein Botaniker bist, kannst Du die Grassorten nicht "
    "identifizieren.");
  AddDetail(({"grashalm","halm"}),
    "Dieser Grashalm wurde eindeutig von irgendeinem Tier angeknabbert.");
  AddDetail("tier",
    "Das Tier das diesen Grashalm angeknabbert hat ist laengst ueber alle Berge.");
  AddDetail(({"berge","berg"}), 
    "Hier siehst Du keine Berge, aber das Tier ist sicher dort.");
  AddDetail(({"baeume","baum"}),
    "Viele gesunde, stramme Baeume stehen stehen hier rum, um zusammen mit "+
    "Bueschen, Graesern und Blumen einen Wald zu bilden.");
  AddDetail(({"buesche","busch","gebuesch"}),
    "Gesunde, gruene Buesche saeumen die Wegraender und "+
    "sorgen im Wald selbst fuer einen aufheiternden Anblick.");
  AddDetail(({"wegrand","wegraender","rand","raender"}),
    "Die Wegraender sind eigentlich nicht mehr so genau "+
    "auszumachen da der Weg bereits von vielen Pflanzen "+
    "ueberwuchert wird.");
  AddDetail(({"pflanzen","pflanze"}),
    "Es wachsen hier viele verschiedene Pflanzen: Buesche, Blumen, Beeren... " +
    "um nur einige zu nennen.");
  AddDetail(({"blume","blumen"}),
    "Wunderschoene Blumen wachsen zwischen den Baeumen und am Weg selbst.");
  AddDetail(({"beere","beeren"}),
    "Du siehst hier einige Pflanzen die Beeren tragen, doch kennst Du sie nicht, "+
    "und beschliesst deshalb sie weder zu pfluecken noch zu essen.");
  AddDetail("tiere",
    "Du kannst zwar keine erkennen, aber Du spuerst, dass viele kleine Augen "+
    "Dich durch die Buesche gerade beobachten.");
  AddDetail("augen",
    "Die Augen der Tiere siehst Du nicht.");
  AddDetail("himmel",
    "Den kannst du durch das Blaetterdach kaum sehen.");
  AddDetail(({"boden","waldboden"}),
    "Der Waldboden ist mit Gras ueberwuchert.");
  AddDetail(({"biene","ameise","spinne","fliege","heuschrecke"}),
    "Die ist schon wieder weg.");
  AddDetail(({"netz","spinnennetz"}),
    "Ein kleines Spinnennetz von einer fleissige Spinne gewebt.");
  AddDetail("nektar",	
    "Die Blumen sind voll davon.");
  AddDetail(({"vogelpaerchen","vogelpaar","paerchen","paar"}),
    "Das Vogelpaerchen fuehlt sich von Dir gestoert " +	
    "und fliegt davon.");
  AddDetail("holz",
    "So direkt siehst Du hier kein Holz, aber da Du im Biologieunterricht "+
    "immer aufmerksam warst, weisst Du, dass Baumstaemme und Aeste aus Holz "+
     "bestehen.");
  AddDetail(({"wurm","wuermer"}),
     "Wuermer lassen sich im Waldboden ebenfalls finden.");
  AddDetail(({"staemme","baumstaemme","stamm","baumstamm","zweig","zweige",
              "ast","aeste","blatt","blaetter"}),
    "Ein Wald ist voll davon.");
  AddDetail(({"freund","freundin"}),
    "Waere doch ein romantisches Plaetzchen.");

  AddDetail("muster",
    "Das Muster das die Sonnenstrahlen auf den Waldboden geworfen haben ist "
    "wirklich sehr schoen.");	
	
/* Geraeusche dazu */

   AddSound (({DEFAULT_SOUND, "voegel","biene","vogel","bienen"}), 
     "Du hoerst Voegel in den Baeumen "+
     "zwitschern. Hie und da summt auch "+
     "eine Biene vorbei.\n");
   AddSound(({"knacken","zweigeknacken","knack"}), 
     "Du hast eindeutig einen brechenden Zweig gehoert.\n");

/* und gerueche natuerlich */

   AddSmell(({DEFAULT_SMELL,"nase"}), 
     "Ein lieblicher Geruch von Blumen und Baeumen umspielt Deine Nase.\n");
   AddSmell(({"blumen","blume"}),
     "Hmm...die Blumen duften herrlich.\n");
   AddSmell(({"baeume","baum","holz"}),
     "Die Baeume duften nach frischem Holz.\n");	

   AddRoomMessage ( ({
     "Der Wind streicht sanft durch den Wald.\n",
     "Ein besonders mutiger Vogel versucht auf deinem Kopf zu landen, "
       "scheitert aber.\n",
     "Sonnenstrahlen werfen ein besonders schoenes Muster auf den Waldboden.\n",
     "Eine Biene fliegt summend bei Dir vorbei.\n",
     "Ein Vogel stoesst hinab und frisst eine Biene.\n",
     "Eine Ameise krabbelt ueber Deinen Fuss.\n",
     "Eine Ameise knuddelt Deine grosse Zehe.\n",
     "Eine Spinne webt ein kleines Netz.\n",
     "Eine Fliege verfaengt sich in einem kleinen Spinnennetz.\n",
     "Eine Spinne verspeist eine Fliege.\n",
     "Eine Biene trinkt aus einer Blume Nektar.\n",
     "Ein Vogelpaerchen beginnt miteinander zu turteln.\n",
     "Du hoerst ein leises Knacken in den Zweigen.\n",
     "Die Graeser wogen sanft im Wind.\n",
     "Ein Vogelpaerchen beginnt sich ueber einen Wurm zu streiten und "
       "fliegt zeternd davon.\n",
     "Du siehst einen kleinen Wurm vorbeikrabbeln.\n",
     "Eine Ameise versucht sich mit Deiner grossen Zehe zu paaren.\n",
     "Kleine rote Tiere fallen ueber ein Blatt her und zerren es hinter "
       "einen Busch.\n",
     "Eine Heuschrecke knabbert an einem Grashalm.\n",
     "Ein Windstoss zerreisst ein kleines Spinnennetz.\n",
     "Ein Blatt mir kleinen roten Tieren darauf, wird vorbeigeweht.\n",
     "Eine Spinne verkutzt sich an einer Fliege und verendet.\n"}), 90 );
}

