
#include "../../def.h"
#include <ansi.h>

inherit ROOM "std_waldraum";

#define DEST ({"/d/ebene/Midas/room/room_f5",\
               "/d/gebirge/dusty/zwerge/room/hoehle5",\
               "/d/kristallwald/sargola/dorf/room/1_0714",\
               "/d/huegelland/raballion/hobbits/room/hauptplatz",\
               WALD_WEG,\
             })

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Mitten im Wald vor einem seltsamen Portal" );
  SetProp(P_INT_LONG,
      "Du stehst mitten im Wald, alles schaut genau so aus wie sonst "
      "ueberall auch. Nur dieses grosse, blauleuchtende Portal erstaunt "
      "Dich schon etwas. Das hast Du hier mitten zwischen den Baeumen nicht "
      "erwartet. Wo dieses Portal wohl hinfuehren mag?" );

  AddDetail( ({"boden", "waldboden"}),
      "Normaler Waldboden, nicht sehr interessnt, schau Dir lieber das Portal an.");
  AddDetail( ({"himmel"}),
      "Der Himmel ist nicht zu sehen, dafuer leuchtet das Portal in einem "
      "schoenen Himmelblau. es Dir einfach mal an.");
  AddDetail( ({"wald"}),
      "Der Wald schaut genauso aus wie ueberall sonst auch, schau Dir doch "
      "lieber das Portal an.");
  AddDetail( ({"baeume", "baum"}),
      "Ganz normale Baeume, also ziemlich uninteressant, ganz anders das "
      "Portal, das Du Dir statt den Baeumen anschauen solltest.");
  AddDetail( ({"portal"}),
      "Ein blauleuchtendes Portal, sowas hast Du hier nicht erwartet. "
      "Wo es wohl hinfuehren mag? Du ueberlegst, ob Du es einfach betreten "
      "sollst, oder es doch zuerst nocht genauer untersuchen sollst.");
  AddDetail( ({"blau", "himmelblau", "farbe"}),
      "Das Portal hat eine himmelblaue Farbe.");
  AddDetail( ({"portal genau", "portal genauer"}),
      "Als Du das Portal genauer untersuchst, stellst Du fest, dass das "
      "Blau manchmal etwas zu flackern anfaengt, vielleicht fehlt dem Portal "
      "die Stabilitaet.");
  AddDetail( ({"stabilitaet"}),
      "Das Portal ist nicht ganz stabil, scheinbar teleportiert es Dich jedes "
      "mal an einen anderen Ort.");
  AddDetail( ({"ort"}),
      "An welchen Ort Du kommst, wenn Du das Portal betrittst, kannst Du "
      "leider nicht feststellen.");

  AddSmell( ({DEFAULT_SMELL}), 
      "Du kannst hier nichts riechen.");
  AddSmell( ({"nichts"}), 
      "Wirklich nichts zu riechen, so glaub es doch!");
  AddSmell( ({"portal"}), 
      "Das Portal riecht auch blau, sehr seltsam.");
  AddSound( ({DEFAULT_SOUND}), 
      "Du kannst hier nichts hoeren.");
  AddSound( ({"nichts"}), 
      "Wirklich nichts zu hoeren, so glaub es doch!");
  AddSound( ({"portal"}), 
      "Das Portal hoert sich auch blau an, Du zweifelst langsam an Deinen Sinnen.");

  AddCmd( ({"betrete", "betritt", "betret"}), "cmd_betreten");
}

int cmd_betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if (str != "portal")
    return 0;
  write("Du betrittst mutig das Portal und wirst wegteleportiert.\n");
  Message(TP->Name() + " betritt mutig das Portal und verschwindet.\n", 
      MSGFLAG_VISUAL + MSGFLAG_NO_TP );
  TP->move(DEST[random(sizeof(DEST))], M_TPORT); 
  return 1;
}

varargs string GetExits(object viewer)
{
  string c1,c2;

  if (objectp(TP) && TP->QueryProp(P_TTY) == "ansi")
  {
    c1 = ANSI_BLUE + ANSI_BOLD;
    c2 = ANSI_NORMAL;
  }
  else
    c1 = c2 = "";
  return "Ein " + c1 + "blaues Portal" + c2 + ".\n" + ::GetExits(viewer);
}

