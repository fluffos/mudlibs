#0:0
text_short ({"Mitten im Wald","Im Wald","Der Wald","Zwischen Baeumen, Baeumen, Baeumen","Ein Raum im Wald","In einem riesigen Wald","Ich glaub ich steh im Wald","Mitten in einem Wald","In einem endlos grossen Wald","Wald, Wald, Wald","Vorne Wald, hinten Wald, rechts Wald, links Wald, oben Wald, unten Wald","Verloren im Wald","Verirrt im Wald","Wald so weit das Auge reicht","Du siehst den Wald vor lauter Baeumen nicht","Im Wald der Waelder","Mitten im Wald statt nur dabei",})
text_long ([6:({"Ein grosser, stark mit Gestruepp ueberwucherter Felsblock liegt zwischen den Baeumen.","Ein kleines Baechlein fliesst hier durch den Wald.","Zwischen den Baeumen wachsen einige kleine Buesche.","Am Boden entdeckst Du ein kleines Erdloch.","Auf einem der Baeume bemerkst Du ein kleines Vogelnest.","Eine grosse Eiche faellt Dir auf.","Der Wald macht hier einen ganz besonders friedlichen Eindruck.","Dieser Wald ist wirklich so gross, dass man sich total verirren kann.","Ein Augenpaar beobachtet Dich aus einem Busch.","Nun hast Du total die Orientierung verloren und hast Dich im Wald verirrt.","Hinter Dir knackt es im Unterholz.","Du hoerst ein Rascheln im Gebuesch.","Dies ist wirklich der schoenste Wald in dem Du je warst.","Ein kleines Tier springt vor Dir aus den Bueschen und verschwindet sofort wieder im Unterholz.",}),2:({"Ringsherum wachsen viele Baeume, Straeucher und sonstige Pflanzen.","Alles um Dich herum ist gruen und die Flora waechst und gedeiht.","In diesem Bereich des Waldes wachsen hauptsaechlich Nadelbaeume, aber nicht ausschliesslich.","Zwischen den Laubbaeumen wachsen auch einige Nadelbaeume.","Hier ist der Baumbestand nicht mehr so dicht, sodass auch mehr Licht auf die hier wachsenden Buesche einfaellt.",}),5:({"Einige Lichtstrahlen durchdringen das dichte Blaetterdach.","Das Blaetterdach ist hier so dicht, dass es ziemlich duester ist.","Nur wenig Licht dringt durch das Blaetterdach auf den Boden.","Die wenigen Lichtstrahlen, die das Blaetterdach durchdringen, zaubern ein lustiges Muster auf dem Boden.","Es ist sehr duester hier, nur wenig Licht dringt durch das Blaetterdach bis zum Boden durch.",}),1:({"Du befindest Dich in einem scheinbar endlos grossem Wald.","Vorsichtig schleichst Du weiter durch den Wald.","Der Wald ist hier ein wenig dichter als sonst.","Du stehst mitten im riesigen Wald.","Du tastest Dich vorsichtig weiter durchs Unterholz.",}),4:({"Vereinzelt sieht man hier auch wunderschoene Blumen.","Wenn Du ein Pilzesammler waerest, wuerdest Du Dich hier wie im Paradies fuehlen, so viele Pilze gibt es hier.","Huch? Ein Vogel fliegt ploetzlich haarscharf an Dir vorbei und landet auf einem Ast.","An einem der Baeume vor Dir haengen lauter dicke Lianen herab.","Auf einigen der Straeucher um Dich herum waechst etwas.",}),3:({"Am Boden wuseln lauter kleine Ameisen und andere Insekten herum.","Irgendein Tier hat hier Spuren im Boden hinterlassen.","Du watest in knoecheltiefem Laub und abgestorbenen Nadeln.","Pass auf, dass Du nicht ueber eine der vielen Wurzeln am Boden stolperst!","Der Boden unter Dir besteht aus typischer Walderde.",}),])
text_details (["erdloch":({"Das Loch am Boden ist sehr klein.",}),"eindruck":({"Der Wald macht einen sehr friedlichen Eindruck.",}),"unterholz":({"Das Unterholz ist sehr dicht hier.","Du bahnst Dir einen Weg durch das Unterholz.","Zwischen den Baeumen befindet sich viel Unterholz.","Auf einem Baum ist 'Unterholz acht' eingraviert.","Durch das Unterholz kannst Du Dir nur schwer einen Weg bahnen.","Das Unterholz besteht hauptsaechlich aus Bueschen.","Das Unterholz besteht hauptsaechlich aus Straeuchern.","Unterholz sind die kleineren Pflanzen, die zwischen den Baeumen wachsen.",}),"weg":({"Es gibt keinen Weg durch diesen Wald, Du musst ihn dir schon selbt bahnen.","Es ist schwer, den Weg durch diesen Wald zu finden.","Das Unterholz macht es Dir schwer, Dir Deinen Weg durchs Unterholz zu bahnen.","Ob es einen Weg gibt, der aus diesem Wald wieder hinaus fuehrt?",}),"nadelbaeumen":({"Untersuch doch besser Nadelbaeume.",}),"laubbaeumen":({"Untersuch doch besser Laubbaeume.",}),"blaetterdach":({"Das Blaetterdach besteht aus vielen Blaettern und ist hier sehr dicht, nur vereinzelte Lichtstrahlen dringen bis zum Boden durch.","Das Blaetterdach wird von einzelnen Lichtstrahlen durchbrochen. Es besteht aus vielen Blaettern.","Vereinzelt dringt Licht durch das dichte Dach aus Blaettern.","In einzelnen Strahlen dringt das Licht durch die Blaetter zum Boden.","Wegen dem dichten Blaetterdach gibt er hier nur Licht einzelnen Strahlen.","Das Blaetterdach spannt sich wie ein Dach ueber den Wald, nur besteht es eben aus Blaettern.","Wie ein Dach schuetzen Dich die Blaetter der Baeume.",}),"specht":({"Der Specht lebt wohl gerne im Wald, weil er Baeume braucht, um Nahrung zu finden.","Der Specht haemmert gegen einen Stamm.","Der Specht sitzt so weit oben im Baum, dass Du ihn nicht erreichen kannst.",}),"wurzeln":({"Die Wurzeln einiger Baeume schauen hier aus dem Boden heraus.","Die Wurzeln versorgen die Baeume mit allem was sie so aus der Erde brauchen.","Hier gibt es so viele Wurzeln, dass man fast staendig darueber stolpert.","Am Boden befinden sich viele Wurzeln.","Eine Wurzel schaut ganz besonders aus.",}),"blumen":({"Irgendwelche Blumen.","Es handelt sich um unscheinbare Waldblumen.","Keine der Blumen interessiert Dich.",}),"teile":({"Aus mehreren Teilen wird wieder das Ganze.",}),"oeffnung":({"Was wohl in der Oeffnung drinnen ist? ",}),"nadelbaeume":({"Es wachsen viele verschiedene Nadelbaeume im Wald.","Nadelbaeume sind Baeume mit Nadeln.","Der Wald besteht hier zu einem grossen Teil aus Nadelbaeumen.",}),"giftpilz":({"Ein giftiger Pilz kann sehr gefaehrlich werden.",}),"blaetter":({"Die Blaetter wachsen an Laubbaeumen.","Die Blaetter bilden ein dichtes Dach, ein Blaetterdach sozusagen.",}),"beste":({"Das Beste ist wohl doch Deine Liebe zum Detailuntersuchen.",}),"felsblock":({"Der Felsblock ist fast vollstaendig von Gestruepp ueberwuchert.",}),"baeume":({"Es wachsen viele Baeume in diesem Wald.","Viele Baeume wachsen in diesem Wald.","Der Wald ist voller Baeume.","Es gibt Laubbaeume und Nadelbaeume.","Nur Baeume, so weit Du schauen kannst.","Vorne ein Baum, hinten ein Baum, rechts ein Baum, links ein Baum......",}),"ganzen":({"Untersuch doch das Ganze.",}),"begriff":({"Einen Begriff kann man nur verstehen, nicht untersuchen.",}),"dach":({"Du meinst wohl das Blaetterdach?",}),"holz":({"Kein Holzfaeller kann solch einem solch schoenen Holz widerstehen.",}),"form":({"Die Form erinnert Dich an irgendetwas, aber Du kannst Dich nicht richtig erinnern.",}),"waldblumenpfluecker":({"Wenn Du willst, kannst Du die Waldblume pfluecken.",}),"midas":({"Midas ist eine grosse Stadt.","In Midas sind die Menschen daheim.","In Midas wohnen hauptsaechlich Menschen.",}),"platz":({"Die Buesche fuellen den Platz zwischen den grossen Baeumen auf.",}),"laub":({"Die Laubbaeume hier haben zum Teil ihr Laub abgeworfen, sodass einiges davon am Boden herumliegt.",}),"insekten":({"Am Boden wuseln lauter kleine Insekten herum.",}),"boden":({"Unter Dir ist der Boden, so wie du es in einem Wald erwartest.","Am Boden liegen Nadeln und Blaetter herum.","Es handelt sich um typischen Waldboden.","Der Boden besteht aus Walderde.","Der Boden ist unter Dir, genauso wie der Himmel ueber Dir ist.",}),"betrachters":({"Untersuch doch lieber Betrachter.",}),"strahlen":({"Vereinzelt dringen Lichtstrahlen durch das dichte Blaetterdach.","Vereinzelt dringt Licht durch das dichte Blaetterdach.","Das Blaetterdach wird von einzelnen Lichtstrahlen durchbrochen.","Wegen dem dichten Blaetterdach gibt er hier nur Licht einzelnen Strahlen.","Die Lichtstrahlen zaubern lustige Muster auf den Waldboden.",}),"pilz":({"Du siehst nicht nur einen Pilz, sondern gleiche viele Pilze.","Sammel doch die Pilze!","Bei Pilzen kann man nie genau wissen, untersuch sie lieber ganz genau, bis Du sicher bist, dass sie nicht giftig sind.",}),"paradies":({"Du fuehlst Dich hier wie im Paradies.","Es ist einfach herrlich hier.","So hast Du Dir das Paradies immer vorgestellt.",}),"lichtstrahlen":({"Vereinzelt dringt Licht durch das dichte Blaetterdach.","In einzelnen Strahlen dringt das Licht durch das Blaetterdach zum Boden.","Die Lichtstrahlen bestehen aus Strahlen von Licht.","Das Blaetterdach wird von einzelnen Lichtstrahlen durchbrochen.","Licht kommt von Himmel durch das dichte Blaetterdach herunter.","Wegen dem dichten Blaetterdach gibt er hier nur Licht einzelnen Strahlen.","Die Lichtstrahlen zaubern lustige Muster auf den Waldboden.",}),"rehe":({"Viele Arten von Rehen leben hier im Wald.",}),"wurzelliebhaber":({"Wenn Du gerne Wurzeln isst, kannst Du ja eine ausgraben.",}),"ameisen":({"Am Boden wuseln lauter kleine Ameisen herum.",}),"aeste":({"Die Aeste wachsen auf einem Baum.","Jeder Baum hier hat Aeste. ","Der Baum der hat Aeste, und das ist das Beste... denn waere er kahl, dann waer es ein Pfahl...",}),"tieren":({"Untersuch lieber Tiere oder Tier.",}),"waldblume":({"Die Waldblume schaut sehr schoen aus.","Du beschliesst, die Waldblume nicht zu pfluecken, damit sich auch andere an ihrer Schoenheit erfreuen koennen.","Du ueberlegts, ob Du die Waldblume pfluecken sollst, entschliesst Dich aber dagegen.","Ob Du Dich als Waldblumenpfluecker betaetigen sollst?",}),"teil":({"Ein Teil des Ganzen.",}),"wasser":({"Vielleicht kann man das Wasser ja trinken?","Koestliches Wasser, sicher kannst Du es trinken.","Hast Du etwa Durst?",}),"straeucher":({"Zwischen den Baeumen wachsen viele Straeucher.","Einige Straeucher wachsen zwischen den Baeumen.","Es wachsen hier nicht nur Baeume, sondern auch Straeucher.","Die Straeucher bilden hier ein dichtes Unterholz.",}),"busch":({"Keiner der Buesche faellt Dir besonders auf.","An diesem Busch ist nichts besonderes.","Ein Augenpaar beobachtet Dich aus dem Busch.","Du weisst nicht was, aber irgendetwas ist seltsam an diesem Busch.","Ein Busch wie jeder andere.",}),"augenpaar":({"Zu wem das Augenpaar im Busch wohl gehoeren mag?",}),"wurzel":({"Diese Wurzel scheint essbar zu sein, zumindest fuer einen Wurzelliebhaber.","Bei naeherer Betrachtung ist sie doch nur eine ganz normale Wurzel.","Diese Wurzel ist besonders gross.","Diese Wurzel hat eine ganz eigenartige Form.",}),"vogel":({"Du kannst nicht genau erkennen, was fuer eine Vogel das ist.","Bei diesem Vogel koennte es sich um einen Specht handlen.","Ein Vogel kann leicht aus diesem Wald hinaus finden. Was wuerdest Du nur dafuer geben, fliegen zu koennen!",}),"aesten":({"Untersuch lieber Aeste.",}),"schoenheit":({"Es ist sehr schoen im Wald.","Schoenheit liegt im Auge des Betrachters.",}),"tiere":({"Im Wald leben viele Arten von Tieren.","Es gibt viele Tiere hier im Wald.","Tiere, zB Baeren.","Tiere wie Rehe und Hirsche.",}),"blaettern":({"Du meinst doch Blaetter?",}),"pilze":({"Hier gibt es viele Pilze. Du koenntest welche sammeln, wenn Du ein Pilzesammler bist.",}),"arten":({"Viele Arten von Tieren leben im Wald, zB Baeren.","Viele Arten von Tieren leben im Wald, zB Hirsche.","Viele Arten von Tieren leben im Wald, zB Rehe.",}),"lianen":({"Sie haengen von einem Baum herab und sind ziemlich dick.",}),"straeuchern":({"Untersuch doch lieber Straeucher.",}),"waldboden":({"Der Waldboden ist der Boden des Waldes.",}),"nahrung":({"Die Nahrung hier ist fuer Tiere, nicht fuer Dich!",}),"buesche":({"Zwischen den Baeumen befinden sich hier einige Buesche.","Einige Buesche wachsen hier.","Ein Busch faellt Dir besonders auf.","Keiner der Buesche hier faellt Dir besonders auf.","Die Buesche fuellen den Platz zwischen den grossen Baeumen auf.",}),"auge":({"Mit einem Auge kann man sehen.","Du verwendest Dein Auge staendig zum untersuchen.","Ohne Augen koenntest Du hier nichts untersuchen.",}),"tier":({"Irgend ein Tier hat hier Spuren im Boden hinterlassen.",}),"stamm":({"Jeder Baum hier hat einen Stamm.","Ein Specht haemmert gegen einen Stamm.","Ohne Stamm gaebe es auch keinen Baum.","In einm Stamm findest Du eine kleine Oeffnung.",}),"liebe":({"Liebst Du diesen Wald?",}),"bueschen":({"Untersuch besser Buesche oder Busch.",}),"pfahl":({"Es gibt keinen Pfahl hier, denn alle Baeume haben Aeste.",}),"hirsche":({"Viele Arten von Hirschen leben hier im Wald.",}),"waldblumen":({"Die Waldblumen sind klein und unscheinbar.","Eine Waldblume schaut sehr schoen aus.",}),"ganze":({"Das Ganze hat mehrere Teile.",}),"erde":({"Bei der Erde hier handelt es sich um dunkle Walderde, die besonders fruchtbar ist.",}),"himmel":({"Der Himmel ist ueber Dir, leider kannst Du ihn wegen der vielen Baeume nicht erkennen.","Der Himmel wird durch die Baeume verdeckt.","Der Himmel ist nicht zu sehen, dafuer stehen die Baeume hier viel zu dicht beisammen.","Ueber Dir ist der Himmel und unter Dir der Boden.",}),"waldes":({"Vielleicht solltest Du besser Wald untersuchen.",}),"stadt":({"Du bist hier im Wald, nicht in der Stadt.","Rund um Dich nur Baeume, wo soll da eine Stadt sein?",}),"licht":({"Das Licht kommt wohl vom Himmel, auch wenn man den nicht direkt sehen kann.","In einzelnen Strahlen dringt das Licht vom Himmel durch das Blaetterdach zum Boden.","Das Licht kommt vom Himmel, den man aber wegen dem dichten Blaetterdach nicht sehen kann.","Obwohl das Licht vom Himmel durch das Blaetterdach ziemlich behindert wird, ist es doch hell genug hier.",}),"detailuntersuchen":({"Das machst Du gerade.",}),"beispiel":({"Nur so zum Beispiel.",}),"walderde":({"Die Erde ist dunkel und sehr fruchtbar.","Die Walderde ist sehr fruchtbar, darum koennen hier viele Pflanzen wachsen.",}),"holzfaeller":({"Du koenntest versuchen, den Baum zu faellen.",}),"spuren":({"Du betrachtest die Spuren hier naeher, kannst aber nicht erkennen, zu welchem Tier sie gehoeren.","Du siehst Spuren am Boden. Von welchem Tier die wohl stammen?","Der Boden ist voller Spuren.","Jetzt wo Du genauer hinschaust, sind es doch nur Deine eigenen Spuren.","Du hast keine Ahnung, von wem diese Spuren stammen koennten.",}),"stellen":({"An anderen Stellen im Wald stehen die Baeume viel dichter.",}),"augen":({"Du hast zwei Augen.",}),"eiche":({"Die Eiche ist der groesste Baum in der ganzen Umgebung.","Die Eiche ist wahrlich ein maechtiger Baum.","Diese Eiche ist wirklich riesengross.","Das Holz der Eiche schaut besonders schoen aus.",}),"giftpilze":({"So einen Giftpilz solltest Du nicht sammeln, sonst koenntest Du Dich vergiften.",}),"loch":({"Vielleicht kann man in das Loch ja hineingreifen?",}),"nadeln":({"Die Nadeln befinden sich nicht nur auf den Nadelbaeumen sondern auch am Boden.",}),"baumbestand":({"Der Baumbestand hier ist nicht mehr so dicht, sodass auch mehr Licht auf die hier wachsenden Buesche faellt.","Der Wald besteht hier aus Laubbaeumen und Nadelbaeumen.","Der Baumbestand ist hier nicht mehr ganz so dicht wie an anderen Stellen im Wald.","Ein Baum reiht sich an den naechsten.","Ein Baum und noch ein Baum und noch ein Baum und so weiter..... ",}),"orientierung":({"Du brauchst schon viel Orientierung, um aus diesem Wald wieder hinaus zu finden.","Verlier nicht Deine Orientierung, sonst findest Du hier nie wieder hinaus.","Ohne Orientierung findest Du wohl nie mehr aus diesem Wald hinaus.",}),"muster":({"Die Lichtstrahlen zaubern lustige Muster auf den Waldboden.","Das Licht erzeugt lustige Muster auf dem Boden.","Durch die einzelnen Lichtstrahlen entstehen lustige Muster am Boden.",}),"wald":({"Du befindest Dich mitten im Wald.","Du siehst den Wald vor lauter Baeumen nicht.","Rund um Dich ist nur Wald.","Wald, Wald, Wald, so weit Du schauen kannst.",}),"ast":({"Der Ast gehoert zu einem Baum.","Jeder Baum hier hat Aeste. ",}),"bereich":({"Mit Bereich ist die naehere Umgebung gemeint.","Dieser Bereich des Waldes eben.","Damit ist der Teil des Waldes gemeint, den Du jetzt sehen kannst.",}),"gebuesch":({"Das Gebuesch besteht aus vielen Bueschen.","Ob da irgendetwas in dem Gebuesch drinnen ist?","Das Gebuesch hier ist ziemlich dicht.",}),"durst":({"Wenn Du Durst hast, solltest Du etwas von diesem Wasser trinken.",}),"flora":({"Die Flora des Waldes besteht hauptsaechlich aus Baeumen und Straeuchern.","Flora ist ein anderer Begriff fuer Pflanzen.","Mit Flora sind wohl die Baeume und Straeucher gemeint.",}),"betrachter":({"Du bist der Betrachter der Schoenheit dieses Waldes.",}),"baeumen":({"Untersuch lieber Baeume.",}),"vogelnest":({"Das Vogelnest ist schon lange nicht mehr bewohnt.","Das Vogelnest ist leer.","Das Vogelnest ist verlassen.","Es befinden sich nur mehr die Eierschalen im Vogenest.","In dem Vogelnest liegen ein paar kleine Vogeleier.",}),"baum":({"Der Baum hat Aeste.","Kein Baum faellt Dir besonders auf.","Ein ganz normaler Baum mit Stamm und Aesten.","Ein Baum hier hat besonders schoenes Holz.",}),"rascheln":({"Es raschelt im Gebuesch. Genauers kannst Du nicht erkennen, wie waers mit lauschen?","Es raschelt im Gebuesch, was das wohl ist?","Irgendjemand verursacht ein Rascheln, aber Du kannst nichts sehen.",}),"baechlein":({"Ein kleines Baechlein fliesst hier durch den Wald.","Das Baechlein fuehrt frisches Wasser mit sich.","Ein Baechlein, voll mit frischem Wasser.","Das Baechlein gluckst vor sich hin.","Das Baechlein ist sehr klein.","Das Baechlein ist fast ausgetrocknet.",}),"silberwald":({"Der Silberwald ist ein Wald im Osten von hier.","Der Silberwald ist viel kleiner als dieser Wald.","Den Silberwald findest Du nahe bei Midas.",}),"gestruepp":({"Das Gestruepp ueberwuchert den Felsblock fast vollstaendig.",}),"pflanzen":({"Viele verschiedene Pflanzen wachsen im Wald: Baeume, Straeucher, ...","Baueme und Straeucher zum Beispiel.","Der Wald besteht aus Pflanzen und Tieren.","Ueberall wachsen und gedeihen hier die Pflanzen.",}),"umgebung":({"Die Umgebung besteht aus Wald.","Die Umgebung ist alles, was jetzt rund um Dich ist.","Alles was Dich zur Zeit umgibt, ist die Umgebung.",}),"pilzesammler":({"Sammel doch ein paar Pilze, wenn Du ein Pilzesammler bist.","Im Silberwald gibt es auch einen Pilzesammler.","Als erfahrener Pilzesammler bemerkst Du sofort, dass es sich hier um Giftpilze handelt.",}),"baeren":({"Viele Arten von Baeren leben hier im Wald.",}),"vogeleier":({"Die Vogeleier liegen ganz ungeschuetzt im Vogelnest. Scheinbar wurde das Vogelnest verlassen, komisch, dass noch niemand diese leckeren Vogeleier gestohlen hat.",}),"laubbaeume":({"Es wachsen viele verschiedene Laubbaeume im Wald.","Laubbaeume sind Baeume mit Laub, auch Blaetter genannt.","Der Wald besteht hier zu einem grossen Teil aus Laubbaeumen.",}),"eierschalen":({"Einige zerbrochene Eierschalen liegen im Vogelnest.",}),])
