
#include "../../def.h"

inherit ROOM "other/std_mine";

void create()
{
  ::create();

  SetProp(P_INT_LONG,
      QueryProp(P_INT_LONG)[0..<2] + " Der Gang endet hier in einer Sackgasse, "
      "Du kannst nur wieder nach Norden zurueck.");

  AddDetail( ({"sackgasse", "sack", "gasse"}),
      "Eine Gasse im Sack sozusagen.. Du kannst nur mehr in eine Richtung weiter.");

  AddItem("/d/gebirge/angrox/npc/zarbeit1", REFRESH_DESTRUCT,
      ([P_MNPC_DEFAULTROOM: file_name(TO), 
        P_MNPC_AREA: ROOM "other/mine",
        P_MNPC_FLAGS: MOV_INDOORS + MOV_BACKWARDS + MOV_MOVES,
      ]) );

  AddExit( "norden", "./mine1_4");
}
 
