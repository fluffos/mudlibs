// Virtual Compiler fuer den Wald
//

#include "../def.h"

inherit "std/virtual/v_compiler";

#include <v_compiler.h>

#define P_ROOMS "raum"

void create() 
{
  ::create();
  SetProp(P_COMPILER_PATH, ROOM "" );
  SetProp(P_STD_OBJECT, ROOM "wald" );
  SetProp(P_ROOMS, ({"wald"}) );
}

string Validate(string file) 
{
  string name, foo;
  int xl, yl;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%d:%d%s", name, xl, yl, foo) == 4) &&
      (member(QueryProp(P_ROOMS), name) != -1)) 
  {
    return name+":" + xl + ":" + yl;
  }
  return 0;
}

int CustomizeObject() 
{
  string foo, foo2;
  string *ind;
  int xl, yl, i;
  mapping exits;
  object ob;
  mixed name;
  
  if (!(name = ::CustomizeObject()) || 
      sscanf(name, "%s:%d:%d%s", foo, xl, yl, foo2) != 4)
    return 0;

  exits = ROOM "waldmaster"->get_exits(xl, yl);
  ind = m_indices(exits); 
  for (i = 0; i < sizeof(ind); i++) 
  {
    PO->AddExit(ind[i], exits[ind[i]] );
  }
  if ((xl == 0 && yl == 0) || !sizeof(PO->QueryProp(P_EXITS)))
  {
    PO->AddExit("raus", WALD_WEG);
  }
  ROOM "detailmaster"->Customize(PO);
  return 1;
}
