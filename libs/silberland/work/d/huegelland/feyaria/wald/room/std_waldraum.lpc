#include "../def.h"

inherit "std/room";

void create()
{
  mapping exits;
  int xl, yl, i;
  string *ind;

  ::create();

  SetProp(P_SHORT, "Im Wald");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 16+random(7), ENV_TERRAIN: TT_FOREST]) );

  exits = ROOM "waldmaster"->get_exits2(explode(file_name(),"/")[6]);
  ind = m_indices(exits); 
  for (i = 0; i < sizeof(ind); i++) 
  {
    AddExit(ind[i], exits[ind[i]] );
  }
}
