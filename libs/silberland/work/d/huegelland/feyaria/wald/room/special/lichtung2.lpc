
#include "../../def.h"

inherit ROOM "std_waldraum";

string *nutzer = ({});

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf einer idyllischen Lichtung mitten im Wald" );
  SetProp(P_INT_LONG,
      "Du befindest Dich auf einer idyllischen Lichtung mittem im Wald. "
      "Statt Baeumen waechst hier nur saftiges Gras, aber auch einzelne "
      "Blumen sind zu erkennen. Es gefaellt Dir hier so gut, dass Du gar "
      "nicht mehr in den finsteren Wald zurueckwillst.");

  AddDetail( ({"lichtung"}),
      "Die Lichtung ist richtig idyllisch. Eine schoene Blumenwiese, "
      "eingerahmt von maechtigen Baeumen. Schmetterlinge fliegen von "
      "Blume zu Blume und die Sonne lacht vom Himmel.");
  AddDetail( ({"wald"}),
      "Der Wald ist rund um die Lichtung.");
  AddDetail( ({"baeume", "baum"}),
      "Maechtige Baeume umringen die Lichtung wie eine Mauer.");
  AddDetail( ({"gras"}),
      "Schoenes saftiges Gras, zu schade, dass Du kein Pflanzenfresser bist, "
      "sonst koenntest Du hier richtig schlemmen.");
  AddDetail( ({"blumen", "blume"}),
      "Einige Blumen wachsen hier, vielleicht kannst Du ja eine pfluecken.");
  AddDetail( ({"pflanzenfresser", "kuh"}),
      "Muh!");
  AddDetail( ({"muh"}),
      "Kuh.");
  AddDetail( ({"blumenwiese", "wiese"}),
      "Gras und Blumen.");
  AddDetail( ({"mauer"}),
      "Wie eine Mauer umgeben die Baeume diese Lichtung.");
  AddDetail( ({"idylle"}),
      "Es ist richtig schoen hier.");
  AddDetail( ({"sonne", "himmel"}),
      "Die Sonne lacht vom Himmel.");
  AddDetail( ({"boden"}),
      "Du kannst den Boden nicht sehen, so dicht waechst das Gras hier..");
  AddDetail( ({"schmetterlinge"}),
      "Schmetterlinge fliegen von Blume zu Blume.");
  AddDetail( ({""}),
      ".");

  AddSmell( ({DEFAULT_SMELL, "wald"}), 
      "Es riecht hier nach Wald.");
  AddSound( ({DEFAULT_SOUND, "waldgeraeusche"}), 
      "Du hoerst die ueblichen Waldgeraeusche.");

  AddCmd( ({"pflueck", "pfluecke"}), "cmd_pfluecken");

  AddItem("/d/ebene/Park/npc/schmetterling", REFRESH_DESTRUCT, 
      ([P_MNPC_DEFAULTROOM: file_name(TO), 
        P_MNPC_AREA: ROOM,
        P_MNPC_FLAGS: 0]) );
}
 
int cmd_pfluecken(string str)
{
  notify_fail("Was willst Du pfluecken?\n");
  if (str != "blume" && str != "waldblume" && str != "blumen" && 
      str != "waldblumen") 
    return 0;
  if (member(nutzer, getuid(TP)) == -1)
  {
    write("Du pflueckst ein paar Waldblumen.\n");
    say(TP->Name() + " pflueckt ein paar Waldblumen.\n");
    switch(random(5))
    {
      case 0: CLONE("/d/seher/feyaria/obj/blume", TP); break;
      case 1: CLONE("/d/huegelland/xorgan/koehler/obj/blumen", TP); break;
      default: CLONE("/d/wasser/woody/obj/blume", TP); break;
    }
    nutzer += ({ getuid(TP) });
  }
  else
  {
    write("Du hast hier doch schon Blumen gepflueckt!\n");
  }
  return 1;
}

void reset()
{
  ::reset();
  nutzer = ({});
}

