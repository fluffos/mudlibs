
#include "../../def.h"

inherit ROOM "std_waldraum";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Vor einem grossen Pilzkreis mitten im Wald" );
  SetProp(P_INT_LONG,
      "Du stehst ploetzlich vor einem grossen Pilzkreis. Zwar hast Du im "
      "Wald bis jetzt schon viele Pilze gesehen, aber hier bilden sie einen "
      "voellig regelmaessigen Kreis. Die Baeume halten respektvoll Abstand "
      "von den Pilzen, sodass sich eine kleine Lichtung gebildet hat. "
      "Du findest das alles sehr ungewoehnlich." );
  SetProp(P_NO_MNPC, 1);

  AddDetail( ({"boden", "waldboden"}),
      "Normaler Waldboden, aber scheinbar idealer Boden fuer das Wachstum "
      "von Pilzen.");
  AddDetail( ({"himmel"}),
      "Da durch den Pilzkreis hier eine kleine Lichtung entstanden ist, "
      "sieht man ein kleines Stueck des Himmels.");
  AddDetail( ({"pilze", "pilz"}),
      "Die Pilze wachsen in einem perfekten Kreis. Ansonsten unterscheiden "
      "sie sich nicht von den anderen Pilzen im Wald.");
  AddDetail( ({"pilzkreis", "kreis"}),
      "Die Pilze wachsen in einem perfekten Kreis mit einem Durchmesser von "
      "ca zwei Metern. Die Anordnung ist wirklich voellig regemaessig. Das "
      "verwundert Dich, weil sie im restlichen Wald ganz wild wachsen. Was "
      "da wohl dahintersteckt?");
  AddDetail( ({"wald", "waldstueck", "ort"}),
      "Du bist hier mitten im Wald. Nur der auffallende Pilzkreis "
      "unterscheidet dieses Waldstueck von anderen.");
  AddDetail( ({"stueck"}),
      "Ein Teil des Ganzen.");
  AddDetail( ({"teil"}),
        "Ein Stueck.");
  AddDetail( ({"ganzes", "ganze"}),
      "Das Ganze besteht meist aus Teilen, oder auch aus Stuecken.");
  AddDetail( ({"baeume", "baum"}),
      "Die Baeume halten respektvoll Abstand von den Pilzen, daher ist hier "
      "eine kleine Lichtung enstanden. Irgendwas seltsames muss an diesen "
      "Pilzen sein.");
  AddDetail( ({"lichtung"}),
      "Die Lichtung ist nur sehr klein, nur etwas groesser als der Pilzkreis.");
  AddDetail( ({"anordnung"}),
      "Die Anordnung der Pilze muss eine Bedeutung haben.");
  AddDetail( ({"bedeutung"}),
      "Vielleicht etwas magisches?");
  AddDetail( ({"magie"}),
      "Irgendeine Art von Magie muss da dahinterstecken.");
  AddDetail( ({"art"}),
      "Ob es Hexenmagie ist?.");
  AddDetail( ({"hexenmagie"}),
      "Du erinnerst Dich, dass solche Pilzkreise oft auch als Hexenkreis "
      "bezeichnet werden.");
  AddDetail( ({"hexenkreis"}),
      "Ja, das koennte tatsaechlich ein Hexenkreis sein.");
  AddDetail( ({"hexe", "hexen"}),
      "Du bist keine Hexe, also weisst Du auch nicht, welches Geheimnis sich "
      "hinter so einem Hexenkreis verteckt.");
  AddDetail( ({"geheimnis"}),
      "Ob Du den Kreis betreten solltest, um das Geheimnis herauszufinden?");
  AddDetail( ({"tiere", "waldtiere"}),
      "Hier sind keine Tiere, scheinbar meiden sie den Pilzkreis.");
  AddDetail( ({"abstand", "respektsabstand"}),
      "Die Baeume halten einen Respektsabstand von den Pilzen.");
  AddDetail( ({"wachstum"}),
      "Die Pilze wachsen hier sehr gut.");
  AddDetail( ({"durchmesser", "meter"}),
      "Der Durchmesser des Pilzkreises ist grob geschaetzt zwei Meter.");

  AddSmell( ({DEFAULT_SMELL}), 
      "Es riecht hier nicht anders wie im restlichen Wald, die Pilze sind "
      "wohl sehr geruchslos.");
  AddSound( ({DEFAULT_SOUND}), 
      "Es ist sehr ruhig hier, scheinbar scheinen die vielen Waldtiere diesen "
      "Pilzkreis zu meiden.");
  AddSound( ({"tiere", "waldtiere"}), 
      "Keine Tiere zu hoeren, sie meiden scheinbar diesen Ort.");

  AddCmd( ({"betrete", "betritt"}), "cmd_betreten");
  AddCmd( ({"iss", "esse", "pfluecke", "pflueck"}), "cmd_pilz");
}

int cmd_pilz(string str)
{
  notify_fail("Was willst Du essen?\n");
  if (str == "pilz" || str == "pilze") 
  {
    write(BS("Die Pilze sind sicher giftig, Du solltest sie nicht essen. "
          "Wenn Du es trotzdem versuchen willst, gib 'iss pilz trotz warnung' "
          "ein."));
    return 1;
  }
  else if (str == "pilz trotz warnung")
  {
    write("Du isst einen giftigen Pilz und bereust es sofort.\n");
    say(TPN+ " isst einen giftigen Pilz.\n");
    SetProp(P_KILL_NAME, "Ein giftiger Pilz");
    TP->AddPoison(3 + random(5));
    TP->do_damage(5 + random(50));
    return 1;
  }
  return 0;
}

int cmd_betreten(string str)
{
  notify_fail("Was willst Du betreten?\n");
  if (str != "pilzkreis" && str != "hexenkreis" && str != "kreis")
    return 0;

  if (TP->QueryProp(P_LEVEL) < 45)
  { 
    write(BS("Du traust Dich nicht, den Hexenkreis zu betreten. Du solltest "
        "vorher wohl noch groesser und staerker werden."));
    return -1;
  }

  write("Du betrittst den Hexenkreis und ploetzlich bist Du ganz wo anders.\n");
  say(TPN + " betritt den Pilzkreis und ist ploetzlich verschwunden.\n");
  call_other(HEXENINSEL, "???");
  tell_object(find_object(HEXENINSEL), 
      TPN+ " erscheint in einem Lichtblitz.\n");
  TP->move(HEXENINSEL, M_TPORT|M_SILENT);
  return 1;
}
