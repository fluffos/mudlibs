#include "../../def.h"

inherit "/d/gebirge/angrox/room/std_bergwerk_new";

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Tief in einer Mine");
  SetProp(P_INT_LONG, 
      "Du stehst in einem Gang tief unten in einer Mine der Zwerge. "
      "Alles ist hier aus Stein, bis auf die Holzbalken, die die Decke "
      "stuetzen.");
  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 6+random(7), ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"boden"}), 
      "Der Boden ist hart und steinig.");
  AddDetail( ({"decke"}), 
      "Die Decke besteht aus hartem Stein und ist mit dicken Balken "
      "abgestuetzt.");
  AddDetail( ({"wand", "waende"}), 
      "Die Waende sind aus Stein und roh behauen. Ab und zu sieht man "
      "Schuerfspuren.");
  AddDetail ( ({"spuren", "schuerfspuren"}),
      "Die Zwerge haben hier nach Metallen und Edelsteinen geschuerft.");
  AddDetail( ({"stein"}), 
      "Harter Fels.");
  AddDetail( ({"fels"}), 
      "Steinhart.");
  AddDetail( ({"balken", "holzbalken"}), 
      "Balken aus hartem Holz stuetzen den Gang und verhindern den Einsturz.");
  AddDetail( ({"holz"}), 
      "Da sich diese Mine ja direkt im Wald befindet, wird das Holz wohl auch "
      "von dort her stammen.");
  AddDetail( ({"wald"}), 
      "Der ist irgendwo ueber Dir.");
  AddDetail( ({"mine"}), 
      "Du wunderst Dich, wie die Zwerge wohl diese Mine mitten im Wald "
      "gefunden haben.");
  AddDetail( ({"zwerg", "zwerge", }),
      "Die besten Bergleute im ganzen Silberland.");
  AddDetail( ({"bergleute"}),
      "Die Zwerge bauen hier Metall und Edelsteine ab.");
  AddDetail( ({"metall", "metalle"}),
      "Verschiedene Metalle werden hier von den Zwergen abgebaut.");
  AddDetail( ({"edelstein", "edelsteine"}),
      "Verschiedenste Edelsteine werden hier von den Bergleuten abgebaut.");
  AddDetail( ({"silberland"}),
      "Du bist mitten im Silberland.");
  AddDetail( ({"einsturz"}),
      "Hoffentlich kommt es nicht zu einem Einsturz, sonst waerst Du hier "
      "verloren.");
  AddDetail( ({"gang", "gaenge"}),
      "Die Zwerge haben diese Gaenge in den Stein geschlagen, um hier "
      "Edelsteine schuerfen zu koennen.");
  AddDetail( ({"himmelsrichtungen", "richtungen"}),
      "Norden, Sueden, Westen, Osten.");
  AddDetail( ({"norden"}),
      "Norden ist zwischen Westen und Osten.");
  AddDetail( ({"sueden"}),
      "Sueden ist zwischen Osten und Westen.");
  AddDetail( ({"osten"}),
      "Osten ist zwischen Norden und Sueden.");
  AddDetail( ({"westen"}),
      "Westen ist zwischen Sueden und Norden.");
  AddDetail( ({"nordwesten"}),
      "Nordwesten ist zwischen Westen und Norden.");
  AddDetail( ({"nordosten"}),
      "Nordosten ist zwischen Norden und Osten.");
  AddDetail( ({"suedosten"}),
      "Suedosten ist zwischen Osten und Sueden.");
  AddDetail( ({"suedwesten"}),
      "Suedwesten ist zwischen Sueden und Westen.");
  
  AddSound( ({DEFAULT_SOUND, "haemmern"}),
      "Du hoerst das Haemmern der Bergleute.");
  AddSmell( ({DEFAULT_SMELL}),
      "Es riecht irgendwie muffig hier.");
}
