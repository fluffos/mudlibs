
#include "../../def.h"

inherit ROOM "std_waldraum";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Auf einer Lichtung mitten im Wald" );
  SetProp(P_INT_LONG,
      "Du stehst auf einer Lichtung mitten im Wald. Wo Dich vorhin noch "
      "hohe Baeume und dichtes Buschwerk umgaben, so stehst Du jetzt zwischen "
      "Blumen im dichten Gras. Die Lichtung ist kreisrund und nicht sehr "
      "gross, richtig gemuetlich und der ideale Ort fuer ein Picknick. "
      "Dahinter beginnt sofort wieder der dichte Wald.");

  AddDetail( ({"boden"}),
      "Der Boden ist hier mit dichtem Gras und vielen Blumen bewachsen.");
  AddDetail( ({"himmel"}),
      "Hier kannst Du den strahlend blauen Himmel sehen, im tiefen Wald "
      "war das nur schwer moeglich.");
  AddDetail( ({"lichtung"}),
      "Die Lichtung ist kreisrund und wird von dichten Baeumen umschlossen.");
  AddDetail( ({"wald"}),
      "Der Wald umschliesst die Lichtung.");
  AddDetail( ({"baeume"}),
      "Die Lichtung ist natuerlich voellig baumfrei, aber Du kannst jede "
      "Menge Baeume sehen, die die Lichtung umgeben.");
  AddDetail( ({"menge"}),
      "Viele.");
  AddDetail( ({"buschwerk", "buesche", "busch"}),
      "Dichtes Buschwerk umgibt die Lichtung und verhindert, dass man weit "
      "in den Wald hineinsehen kann.");
  AddDetail( ({"gras"}),
      "Hier waechst dichtes Gras, wie auf einer ......");
  AddDetail( ({"blumen"}),
      "Zwischen dem Gras wachsen auch viele schoene Blumen.");
  AddDetail( ({"blume"}),
      "Hier sind so viele Blumen, dass DuDich gar nicht auf eine einzige "
      "konzentrieren kannst.");
  AddDetail( ({"wiese"}),
      "Richtig, das Gras und die Blumen bilden eine richtige Wiese.");
  AddDetail( ({"ort"}),
      "Es ist ein wunderschoener Ort hier.");
  AddDetail( ({"picknick"}),
      "Es ist der ideale Ort fuer ein Picknick hier, scheinbar sind auch "
      "schon Hobbits auf diese Idee gekommen.");
  AddDetail( ({"idee"}), 
      "Hast Du eine bessere Idee? Dann mach einfach: 'idee <text>'");
  AddDetail( ({"hobbits", "hobbit", "gruppe"}),
      "Eine Gruppe Hobbits veranstaltet hier ein Picknick.");

  AddSmell( ({DEFAULT_SMELL, "duft", "blumen", "blume"}), 
      "Du riechst den Duft der vielen Blumen.");
  AddSound( ({DEFAULT_SOUND, "schmatzen", "hobbits", "hobbit"}), 
      "Du hoerst das Schmatzen der Hobbits, die ihr Picknick geniessen.");

  AddItem( "/d/huegelland/raballion/hobbits/npc/hobbit", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS:0]));
  AddItem( "/d/huegelland/raballion/hobbits/npc/hobbit", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS:0]));
  AddItem( "/d/huegelland/raballion/hobbits/npc/hobbit", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS:0]));

}
 
