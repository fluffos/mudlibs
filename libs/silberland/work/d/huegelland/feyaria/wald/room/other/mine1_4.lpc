
#include "../../def.h"

inherit ROOM "other/std_mine";

void create()
{
  ::create();
  
  SetProp(P_INT_LONG,
      QueryProp(P_INT_LONG)[0..<2] + " Der Gang fuehrt hier nach Norden, "
      "nach Westen und nach Sueden.");
  
  AddExit( "norden", "./mine1_1");
  AddExit( "sueden", "./mine1_5");
  AddExit( "westen", "./mine1_6");
}
 
