#include "../def.h"
#include <exploration.h>
#include "/p/daemon/crond/crond.h"

mixed *waldexits;
mixed *waldraeume;
mapping spezialraeume;
mapping spezial_x;
mapping spezial_y;
mapping dirs;
int XSIZE = 0, YSIZE = 0;

int write_wald();

void create()
{
  if (is_clone(this_object())) 
  {
    destruct(this_object());
    return;
  }
  //       NR,  dir        Y  X ziel
  dirs = ([0:"norden"    ;-1; 0;4,
           1:"nordosten" ;-1; 1;5,
           2:"osten"     ; 0; 1;6,
           3:"suedosten" ; 1; 1;7,
           4:"sueden"    ; 1; 0;0,
           5:"suedwesten"; 1;-1;1,
           6:"westen"    ; 0;-1;2,
           7:"nordwesten";-1;-1;3 ]);
}

void remove()
{
  destruct(this_object());
}

nosave int create_wald(int nolimit)
{
  int i, j, k, e;
  int x, y;
  string *special;
  string s;

  // Array fuer Wald allocieren  
  XSIZE = MIN_XSIZE + random(MAX_XSIZE - MIN_XSIZE + 1);
  YSIZE = MIN_YSIZE + random(MAX_YSIZE - MIN_YSIZE + 1);
  waldexits = allocate(XSIZE);
  waldraeume = allocate(XSIZE);
  for (i = 0; i < XSIZE; i++)
  {
    waldraeume[i] = allocate(YSIZE);
    waldexits[i] = allocate(YSIZE);
    for (j = 0; j < YSIZE; j++)
    {
      waldexits[i][j] = allocate(8);
    }
  }
  spezialraeume = ([]);
  spezial_x = ([]);
  spezial_y = ([]);

  // Spezielle Raeume laden
  special = get_dir(ROOM "special/*.lpc") - ({"geruest.lpc"});

  // Raeume setzen, O sind normale Raeume, S sind spezialraeume
  for (i = 0; i < XSIZE; i++)
  {
    for (j = 0; j < YSIZE; j++)
    {
      if (random(100) < EMPTY_CHANCE && (i + j))
        waldraeume[i][j] = " ";
      else if (random(100) < SPECIAL_CHANCE && i && j && sizeof(special))
      {
        s = special[random(sizeof(special))];
        special -= ({s});
        waldraeume[i][j] = "S";
        s = explode(s, ".")[0];  // .c entfernen
        spezialraeume[i + "-" + j] = s; // Raum je nach Koordinate speichern
        spezial_x[s] = i;  // X-Koordinate zum Raum
        spezial_y[s] = j;  // Y-Koordinate zum Raum
        // Ein weiterer Raum wird entfernt, damit nicht immer die gleichen Raeume da sind.
        if (sizeof(special))
        {
          s = special[random(sizeof(special))];
          special -= ({s});
        }
      }
      else
        waldraeume[i][j] = "O";
    }
  }
  // Zufaellige Exits einbaun
  for (i = 0; i < XSIZE; i++)
  {
    for (j = 0; j < YSIZE; j++)
    {
      if (waldraeume[i][j] != " ")
      {
        for (k = 0; k < 1 + !nolimit + random(4); k++)
        {
          e = random(8);
          // Randloser Wald, bei Ueberlauf kommt man auf der anderen seite wieder raus 
          if (nolimit)
          {
            x = (i + dirs[e,1]) % XSIZE;
            if (x < 0) 
              x = XSIZE + x;
            y = (j + dirs[e,2]) % YSIZE;
            if (y < 0) 
              y = YSIZE + y;
          }
          else // normaler Wald, am Rand gibts dann keine Exits
          {
            x = (i + dirs[e,1]);
            if (x < 0 || x >= XSIZE) 
              continue;
            y = (j + dirs[e,2]);
            if (y < 0 || y >= YSIZE) 
              continue;
          }
          if(waldraeume[x][y] != " ")
          {
            waldexits[i][j][e] = 1;
            waldexits[x][y][dirs[e,3]] = 1; // Exit der gegenrichtung setzen
          }
        }
      }
    }
  }
  if (this_interactive() && IS_ARCH(this_interactive()))
    return write_wald();
  else
    return 1;
}

int write_wald()
{
  int i, j;

  for (i = 0; i < XSIZE; i++)
  {
    for (j = 0; j < YSIZE; j++)
    {
      if (waldexits[i][j][7]) write("\\"); else write (" ");
      if (waldexits[i][j][0]) write("|"); else write (" ");
      if (waldexits[i][j][1]) write("/"); else write (" ");
      write(" ");
    }
    write("\n");
    for (j = 0; j < YSIZE; j++)
    {
      if (waldexits[i][j][6]) write("-"); else write (" ");
      write (waldraeume[i][j]);
      if (waldexits[i][j][2]) write("-"); else write (" ");
      write(" ");
    }
    write("\n");
    for (j = 0; j < YSIZE; j++)
    {
      if (waldexits[i][j][5]) write("/"); else write (" ");
      if (waldexits[i][j][4]) write("|"); else write (" ");
      if (waldexits[i][j][3]) write("\\"); else write (" ");
      write(" ");
    }
    write("\n");
  }

  return 1;
}

mapping get_exits(int x, int y)
{
  mapping ex;
  int i, xx, yy;
  string s;

  ex = ([]);
  for (i = 0; i < 8; i++)
  {
    if (waldexits[x][y][i])
    {
      xx = (x + dirs[i,1]) % XSIZE;
      if (xx < 0) 
        xx = XSIZE + xx;
      yy = (y + dirs[i,2]) % YSIZE;
      if (yy < 0) 
        yy = YSIZE + yy;
      if (stringp(s = spezialraeume[xx + "-" + yy]))
        ex += ([dirs[i, 0]: ROOM "special/" + s]);
      else
        ex += ([dirs[i, 0]: ROOM "wald:" + xx + ":" + yy]);
    }
  }
  if (!sizeof(ex))
    ex = (["raus": WALD_WEG]);
  return ex;
}

mapping get_exits2(string filename)
{
  return get_exits(spezial_x[filename], spezial_y[filename]); 
}

int check_wald()
{
  if (!sizeof(waldexits))
    create_wald(!!random(3));
}

int new_wald()
{
  int i, j;
  object ob;
  string *special;

  if (!(PO_IS_CRON || getuid(TP) == "gwenshara" || (TP && IS_ARCH(TP))))
    return 0;
  for (i = 0; i < XSIZE; i++)
  {
    for (j = 0; j < YSIZE; j++)
    {
      if (ob = find_object(ROOM "wald:" + i + ":" + j))
        ob->remove();
    }
  }
  special = get_dir(ROOM "special/*.lpc");
  for (i = sizeof(special) - 1; i >= 0; i--)
  {
    if (ob = find_object(ROOM "special/" + special[i]))
      ob->remove();
  }
  create_wald(!!random(3));
  return 1;
}

void give_fp(string key, int type)
{
  if (strstr(getuid(previous_object()), "feyaria") != -1)
    EPMASTER->GiveExplorationPoint(key, type);
}
