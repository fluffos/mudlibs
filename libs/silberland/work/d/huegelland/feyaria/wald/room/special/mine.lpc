
#include "../../def.h"

inherit ROOM "std_waldraum";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Beim Eingang zu einer Mine mitten im Wald" );
  SetProp(P_INT_LONG,
      "Du stehst vor dem Eingang zu einer Mine, die die Zwerge hier mitten "
      "im Wald errichtet haben. Warum sie die Mine gerade hier angelegt haben, "
      "kannst Du Dir nicht erklaeren, aber die Bergwerksarbeiter werden schon "
      "wissen was sie tun. Der Wald wurde hier fast vollstaendig abgeholzt, "
      "sicher befinden sich die Baumstaemme als Stuetzbalken in den Stollen. "
      "Ein Aufzug bietet Zugang zu den Tiefen des Bergwerks.");

  AddDetail( ({"eingang", "zugang", "aufzug"}),
      "Man kann nur mit dem Aufzug in die Mine hinein.");
  AddDetail( ({"mine", "metalle", "edelsteine", "bergwerk"}),
      "Da drinnen werden wohl Metalle und Edelsteine abgebaut.");
  AddDetail( ({"wald", "umgebung"}),
      "Der Wald hier wurde abgeholzt.");
  AddDetail( ({"zwerg", "zwerge", "bergwerksarbeiter" }),
      "Die Zwerge sind die besten Bergwerksarbeiter.");
  AddDetail( ({"holz", "holzbalken", "stuetzbalken", "staemme", 
        "baumstaemme", "stamm", "baumstamm"}),
      "Jeder einzelne Baumstamm aus der Umgebung der Mine befindet sich "
      "jetzt sicher als Holzbalken in der Mine.");
  AddDetail( ({"stollen", "gaenge", "gang"}),
      "Du koenntest ja man mit dem Aufzug runterfahren und Dir die Stollen "
      "und Gaenge der Mine ansehen.");
  AddDetail( ({"boden"}),
      "Im Boden ist ein grosses Loch.");
  AddDetail( ({"loch"}),
      "Durch dieses Loch kommt man in die Tiefen der Mine.");
  AddDetail( ({"tiefe", "tiefen"}),
      "Wie tief die Mine hinabreicht, kannst Du von hier nicht beurteilen.");
  AddDetail( ({"himmel"}),
      "Du kannst den Himmel nicht sehn, es liegt zu viel Staub in der Luft.");
  AddDetail( ({"staub", "luft"}),
      "Der viele Staub stammt aus der Mine.");


  AddSmell( ({DEFAULT_SMELL}), 
      "Es riecht hier stark nach Zwerg.");
  AddSound( ({DEFAULT_SOUND, "geraeusche"}), 
      "Du hoerst laute Geraeusche aus den Tiefen der Mine.");

  AddItem("/d/gebirge/angrox/npc/zwaechter1", REFRESH_DESTRUCT);
  AddItem("/d/gebirge/angrox/npc/zwaechter1", REFRESH_DESTRUCT);
  AddItem(ROOM "other/aufzug", REFRESH_DESTRUCT, 1);
}
 
