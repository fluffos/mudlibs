inherit "std/transport";

#include "../../def.h"

void create()
{
   
  ::create();
  
  SetProp( P_NAME, "Aufzug" );
  AddId( ({ "aufzug", "lift" }) );
  SetProp( P_GENDER, MALE );
  SetProp( P_INT_SHORT, "In einem mechanischen Aufzug" );
  SetProp( P_INT_LONG,
      "Du befindest Dich in einem unkomfortablen, rumpelnden Aufzug. Er "
      "befoerdert Dich (hoffentlich) sicher in die Tiefen dieser Mine "
      "und wieder zurueck. Irgendwie kommt dir der Aufzug bekannt vor, "
      "scheinbar verwenden die Zwerge solche Kontruktionen in all ihren "
      "Minen und Bergwerken.");
	 
  SetProp( P_SHORT, "Ein mechanischer Aufzug" );
  SetProp( P_LONG,
      "Der Aufzug ist eine zwergische Konstruktion, die ueber eine "
      "komplizierte Konstruktion von Seilen, Umlenkrollen und "
      "Dampfkesseln sich hier in diesem Schacht aufwaerts und abwaerts "
      "bewegen kann. Irgendwie kommt dir der Aufzug bekannt vor, scheinbar "
      "verwenden die Zwerge solche Kontruktionen in all ihren Minen und "
      "Bergwerken.");
	  
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 6+random(7), ENV_TERRAIN: TT_CAVE]) );
  SetProp(P_TRANSPARENT,0);  
  SetProp( P_DEPARTMSG, ({
    "Der Aufzug setzt sich in Bewegung.\n", 
    "Der Aufzug faehrt ab.\n"}) );  
  SetProp( P_ARRIVEMSG, ({
    "Der Aufzug naehert sich @@QueryArrived@@ und bleibt stehen.\n",
    "Ein Aufzug kommt an.\n"}) );
  SetProp( P_ENTERMSG, ({
    "betritt den Aufzug",
    "kommt herein"}) );  
  SetProp( P_LEAVEMSG, ({
    "verlaesst den Aufzug",
    "kommt aus dem Aufzug"}) );
  SetProp( P_LEAVEFAIL, "Du kannst den Aufzug nicht verlassen, wenn er sich bewegt" );
  SetProp( P_ENTERFAIL, "Es passen nur 5 Passagiere in den Aufzug" );
 
  SetProp( P_MAX_PASSENGERS, 5 );
  
  AddCmd("betrete", "betrete" );
  AddCmd("verlasse", "verlasse");

  AddRoute(ROOM "special/mine", 25, 7, "Eingang", ({"eingang"}), 
      "zum Eingang");
  AddMsg( "Der Aufzug faehrt nach Ebene 1.\n", 1 );
  AddMsg( "Der Aufzug wird langsamer.\n", 1 );

  AddRoute("mine1_1", 25, 7, "Ebene 1", ({"ebene 1", "1. ebene",
        "ersten ebene"}), "zur Ebene 1");
  AddMsg( "Der Aufzug faehrt nach Ebene 2.\n", 1 );
  AddMsg( "Der Aufzug wird langsamer.\n", 1 );
  
  AddRoute("mine2_1", 25, 7, "Ebene 2",({"ebene 2", "2. ebene",
        "zweiten ebene"}), "zur Ebene 2");
  AddMsg( "Der Aufzug faehrt nach Ebene 3.\n", 1 );
  AddMsg( "Der Aufzug wird langsamer.\n", 1 );
  
  AddRoute("mine3_1", 25, 7, "Ebene 3",({"ebene 3", "3. ebene",
        "dritten ebene"}), "zur Ebene 3");
  AddMsg( "Der Aufzug faehrt nach Ebene 4.\n", 1 );
  AddMsg( "Der Aufzug wird langsamer.\n", 1 );

  AddRoute("mine4_1", 25, 7, "Ebene 4",({"ebene 2", "2. ebene",
        "zweiten ebene"}), "zur Ebene 4");
  AddMsg( "Der Aufzug faehrt nach Ebene 3.\n", 1 );
  AddMsg( "Der Aufzug wird langsamer.\n", 1 );

  AddRoute("mine3_1", 25, 7, "Ebene 3",({"ebene 3", "3. ebene",
        "dritten ebene"}), "zur Ebene 3");
  AddMsg( "Der Aufzug faehrt nach Ebene 2.\n", 1 );
  AddMsg( "Der Aufzug wird langsamer.\n", 1 );

  AddRoute("mine2_1", 25, 7, "Ebene 2",({"ebene 2", "2. ebene",
        "zweiten ebene"}), "zur Ebene 2");
  AddMsg( "Der Aufzug faehrt nach Ebene 1.\n", 1 );
  AddMsg( "Der Aufzug wird langsamer.\n", 1 );
  
  AddRoute("mine1_1", 25, 7, "Ebene 1", ({"ebene 1", "1. ebene",
        "ersten ebene"}), "zur Ebene 1");
  AddMsg( "Der Aufzug faehrt zum Eingang.\n", 1 );
  AddMsg( "Der Aufzug wird langsamer.\n", 1 );
  
  Start();
 
  AddDetail("boden",
      "Der Boden besteht aus massivem Holz.");
  AddDetail( ({"wand", "waende"}),
      "Die Waende bestehen aus Holz.");
  AddDetail("decke", 
      "Die Decke ist aus Holz.");
  AddDetail("holz",
        "Das Holz ist aus Holz. Es sieht sehr stabil aus.");
  AddDetail("aufzug", 
      "Du befindest Dich darin.");
}

int betrete(string str)
{
  notify_fail("Was willst Du denn betreten?\n");
  if (str=="aufzug")
    return Enter();
 return 0;
}

int verlasse(string str)
{
 notify_fail("Was willst du denn verlassen?\n");
 if (str=="aufzug")
   return Leave();
 return 0;
}
 
