// /d/huegelland/feyaria/wald/weapon/horn.c
// Das Horn des Einhorns
// 2001-05-09  Feyaria@SilberLand

#include "../def.h"
inherit "std/weapon";

void create()
{
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Das Horn des Einhorns");
  SetProp(P_LONG, 
    "Das Horn des Einhorns ist wie ein Schneckenhaus gedreht und fast "
    "einen Meter lang. solch ein Horn ist so selten und so wundertaetig, "
    "dass viele Alchemisten es mit Gold aufwiegen wuerden. Aber auch als "
    "Waffe kann man es verwenden, wenn man es wie einen Speer in der Hand "
    "haelt.");
  SetProp(P_NAME, ({"Horn des Einhorns", "Horns des Einhorns", 
   "Horn des Einhorns", "Horn des Einhorns"}) );
  SetProp(P_GENDER, NEUTER);
  AddId(({"horn", "einhorn", "\nreal_unicorn_horn"}));
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_MAGIC}) );
  SetProp(P_WC, 200);
  SetProp(P_WC_FIX, 70);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, ([MAT_HORN:100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 50000);
  SetProp(P_WC_BONUS, (["einhorn": 200]) );
  SetProp(P_MAGIC, 1);
}

