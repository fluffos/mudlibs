// /d/huegelland/feyaria/wald/weapon/geweih.c
// Ein Hirschgweih
// 2001-04-08  Feyaria@SilberLand

#include "../def.h"
inherit "std/weapon";

string hirschname;
int hirschgeweih;

void create()
{
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Hirschgeweih");
  SetProp(P_LONG, 
    "Das Geweih eines Hirsches.");
  SetProp(P_NAME, "Hirschgeweih");
  SetProp(P_GENDER, NEUTER);
  AddId(({"geweih", "hirschgeweih"}));
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_DAM_TYPE, ({DT_PIERCE}) );
  SetProp(P_WC, 130);
  SetProp(P_WC_FIX, 20);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_HORN:100]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 100);
  SetProp(P_WC_BONUS, (["hirsch": 77]) );
}

string query_hirsch()
{
  return hirschname;
}
  
int hirschgeweih()
{
  return hirschgeweih;
}

void set_hirsch(string name, int enden)
{
  hirschname=name;
  hirschgeweih=enden;
  switch( name )
  {
    case "Waldhirsch":
      SetProp(P_LONG, 
          "Das ist das Geweih eines gewoehnlicchen Waldhirsches. Mit seinen "+
          enden+" Enden ist es sicher eine schoene Jagdtrophaee.");
      SetProp(P_VALUE, 500+random(100*enden));
      break;
    case "Kronenhirsch":
      SetProp(P_LONG, 
          "Das ist das weitausladende Geweih eines Kronenhirsches. Mit seinen "+
          enden+" Enden ist es sicher eine schoene Jagdtrophaee.");
      SetProp(P_VALUE, 500+random(100*enden));
      break;
    case "Rothirsch":
      SetProp(P_LONG, 
          "Das ist das Geweih eines Rothirsches. Mit seinen "+
          enden+" Enden ist es sicher eine schoene Jagdtrophaee.");
      SetProp(P_VALUE, 300+random(100*enden));
      break;
    case "Silberhirsch":
      SetProp(P_LONG, 
          "Das ist das silbrige Geweih eines seltenen Silberhirsches. Mit seinen "+
          enden+" Enden ist es eine schoene und wertvolle Jagdtrophaee.");
      SetProp(P_VALUE, 1000+random(200*enden));
      SetProp(P_MATERIAL, ([MAT_SILVER:100]) );
      break;
    case "Weisshirsch":
      SetProp(P_LONG, 
          "Das ist das Geweih eines der seltenen weissen Hirschen. Mit seinen "+
          enden+" Enden ist es eine schoene und wertvolle Jagdtrophaee.");
      SetProp(P_VALUE, 1500+random(300*enden));
      break;
    case "Goldhirsch":
      SetProp(P_LONG, 
          "Das ist das golden schimmernde Geweih eines der sehr seltenen "
          "Goldhirschen. Mit seinen "+ enden+" Enden ist es eine sehr schoene und "
          "extrem wertvolle Jagdtrophaee.");
      SetProp(P_VALUE, 5000+random(500*enden));
      SetProp(P_MATERIAL, ([MAT_GOLD:100]) );
      break;
  }
  SetProp(P_WC, enden*7+(enden>16?enden:0));
  SetProp(P_NAME_ADJ, enden + "-endig");
  SetProp(P_SHORT, Name(WER,0));
}

