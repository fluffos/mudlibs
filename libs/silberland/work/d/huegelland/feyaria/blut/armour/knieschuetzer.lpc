// /d/gebirge/feyaria/blut/armour/knieschuetzer.c 
// Stachelbewehrte Knieschuetzer fuer den Schlachtenwueter
// 97-04-20 Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

#define COST 12

int geladen;

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Stachelbewehrte Knieschuetzer");
  SetProp(P_LONG, BS( 
    "Stachelbewehrte Knieschuetzer wie sie nur ein Schlachtenwueter "
    "verwendet.") );
  SetProp(P_NAME, ({ "die Knieschuetzer", "der Knieschuetzer",
                     "den Knieschuetzern", "die Knieschuetzer"}) );
  SetProp(P_INFO, BS(
    "Mit dem Kommando 'kniespiesse <gegner>' kannst Du im Kampf Deinem "
    "Gegner den Kniestachel in den Koerper rammen. Die Konzentration auf "
    "diesen Stoss ist aber so schwer, dass man dazu "+COST+" Magiepunkte "
    "braucht.") );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);
  AddId( ({"knieschuetzer"}) );

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, ({MAT_METAL, MAT_LEATHER}) );
  SetProp(P_WEIGHT, 430);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:15, A_DEX:15, P_XP:300000]) );

/*  SetProp(P_COMBATCMDS, (["kniespiesse %s":
      ([C_MIN:11,C_AVG:28,C_MAX:45,C_DTYPES:({DT_PIERCE}),
      C_SPCOST:COST, C_REFRESH:300, C_READY:"bereit"])]));
*/

  AddCmd("kniespiesse", "spiessen");
  aufladen();

}

int spiessen(string str, int fastload)
{
  object enemy;

  notify_fail("Wen moechtest Du mit Deinen Knien aufspiessen?\n");
  if( stringp(str) && (enemy=present(str, environment(TP))) )
  {
    if (!QueryProp(P_WORN))
    {
      write("Du musst dazu die Knieschuetzer anziehen!\n");
      return 1;
    }
    if (!geladen)
    {
      write("Du musst Dich erst von Deinem letzten Spiessen erholen!\n");
      return 1;
    }
    if (TP->QueryProp(P_SP)<COST)
    {
      write("Du hast nicht genug Magiepunkte dafuer!\n");
      return 1;
    }
    if (PL->QueryProp(P_ATTACK_BUSY))
    {
      write("He! Nicht so schnell!\n");
      return 1;
    }
    PL->SetProp(P_ATTACK_BUSY, 1);
    printf("Du spiesst %s auf Deinen Knien auf.\n", enemy->name(WEN));
    say(sprintf(BS("%s spiesst %s auf %s Knien auf."), CAP(TPN),
       enemy->name(WEN), TPPP(FEMALE,WEM,PLURAL) ), enemy );
    tell_object(enemy, CAP(TPN)+" spiesst Dich auf den Knien auf.\n");
    enemy->Defend(111+random(444), DT_PIERCE,
                  ([SP_NAME:"Helmspiesser", SP_SHOW_DAMAGE:1]), TP);
    TP->restore_spell_points(-COST);
    if (fastload) return 1;
    if (random(200)==13)
    {
      write("Leider brechen die Stacheln von Deinen Knieschuetzern ab.\n"
            "Wuetend wirfst Du sie weg.\n");
      remove(1); 
      return 1;
    }
    call_out("aufladen", 300);  // 5 Minuten Ladezeit
    geladen = 0;
    return 1;
  }
  else
    return 0;
}

void aufladen()
{
  geladen = 1;
}

int bereit()
{
  return (QueryProp(P_WORN) && geladen);
}

