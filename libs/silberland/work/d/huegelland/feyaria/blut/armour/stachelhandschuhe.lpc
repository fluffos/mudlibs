// /d/gebirge/feyaria/blut/armour/stachelhandschuhe.c 
// Die Stachelhandschuhe des Schlachtenwueters
// 97-04-20  Feyaria@SilberLand

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Stachelhandschuhe");
  SetProp(P_LONG, BS( 
    "Diese Handschuhe sind mit spitzen Stachel besetzt.") );
  SetProp(P_INFO, BS(
    "Diese Handschuhe gehoeren zur Ausruetung eines Schlachtenwueters.") );
  SetProp(P_NAME, ({"die Stachelhandschuhe", "der Stachelhandschuhe",
                    "den Stachelhandschuhen", "die Stachelhandschuhe"}) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"handschuhe", "stachelhandschuhe"}) );

  SetProp(P_ARMOUR_TYPE, AT_GLOVE );
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, MAT_METAL );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 2000);
  SetProp(P_NOBUY, 1);

  SetProp(P_WEAR_FUNC, TO );
  SetProp(P_REMOVE_FUNC, TO );
  SetProp(P_DEFEND_FUNC, TO );
}

int WearFunc(object me)
{
  return 1;
}

int RemoveFunc(object me)
{
  return 1;
}

int DefendFunc (mixed dam_type, int spell, object enemy)
{
  return 0;
}
