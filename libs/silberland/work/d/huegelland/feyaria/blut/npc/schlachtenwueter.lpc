// /d/gebirge/feyaria/blut/npc/schlachtenwueter.c  
// Der Schlachtenwueter ( original von R.A. Salvatore )
// 1997-04-20  Feyaria@SilberLand

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Schlachtenwueter");
  SetProp(P_LONG, BS(
    "Das ist der Schlachtenwueter! Dies ist der sonderbarste Zwerg, den Du je "
    "in Deinem Leben erblickt hast. Er traegt an jeder Hand einen staehlernen "
    "Hansdschuh, der mit Stacheln besetzt ist. Von seinen Ellbogen, Knien und "
    "den Zehen seiner schweren Stiefel ragen aehnliche Stachel ab. Er traegt "
    "auch eine Ruestung, die ueber und ueber mit staehlernen Dornen bewehrt "
    "ist. Sein grauer Helm laesst das Gesicht unbedeckt und dicke Lederriemen"
    ", die in seinem monstroesem Bart verschwinden, halten ihn an Ort und "
    "Stelle. Die Kopfbedeckung wird gekroent von einem glaenzenden Stachel, "
    "der fast halb so lang ist, wie der knapp ueber einen Meter grosse Zwerg "
    "selbst."));
  SetProp(P_NAME, "Schlachtenwueter");
  SetProp(P_GENDER, MALE);
  AddId(({"schlachtenwueter", "wueter", "zwerg"}));
  set_living_name("schlachtenwueter");
  SetProp(P_SMELL, BS(
    "Der Zwerg riecht so, als haette er sich seine Ruestung schon seit einem "
    "Jahrhundert nicht mehr ausgezogen. Sicher hasst er Wasser!") );


  create_default_npc(33);
  // P_LEVEL   = 33
  // P_SP/P_HP = 33*8+42        =
  // P_HANDS   = x*10          = 
  // P_BODY    = x*20/3        =  
  // P_XP      = HP*HANDS*50   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen Stacheln und Dornen", 330, ({DT_PIERCE, DT_RIP}) }) );
  SetProp(P_MAX_HP, 2000);
  SetProp(P_BODY, 180);
  SetProp(P_XP, 30000*100); 
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 110);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 10);
  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0,        DT_BLUDGEON   :0,        DT_PIERCE     :-0.2,
    DT_SQUEEZE    :-0.5,     DT_WHIP       :-0.8,     DT_RIP        :-0.2,
    DT_FIRE       :-0.2,     DT_COLD       :-0.2,     DT_WATER      :2.5,    
    DT_AIR        :0,        DT_LIGHTNING  :0,        DT_EXPLOSION  :0, 
    DT_SOUND      :0,        DT_LIGHT      :0.5,      DT_ELECTRIC   :0,    
    DT_ACID       :-0.7,     DT_POISON     :-0.8,     DT_TERROR     :-0.2,     
    DT_HOLY       :0,        DT_UNHOLY     :0,        DT_MAGIC      :-0.3]) );

  SetProp(P_MSGIN, "stapft knirschend herein");
  SetProp(P_MSGOUT, "stapft knirschend");
  SetProp(P_MMSGIN, "erscheint aus einer siegreichen Schlacht");
  SetProp(P_MMSGOUT, "verschwindet, um in einer wichtigen Schlacht zu kaempfen");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "b3");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " hat jetzt tatsaechlich eine Schlacht verloren.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Der wildeste aller Schlachtenwueter");
  SetProp(P_KILL_MSG, "Ich liebe Schlachten!");

  AddInfo(DEFAULT_INFO, "grummelt irgendwas in seinen Bart.\n");
  AddInfo("feyaria", "Feyaria hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Der Schlachtenwueter zerstoert @wen@.\n" }) );

  SetProp(P_SPELLRATE, 100 ); // Nur als Test :), wird dann 10
  AddSpell(1,1000,
    "Der Schlachtenwueter rammt Dir alle seine Stacheln in den Koerper.\n",
    "Der Schlachtenwueter rammt @WEM alle sein Stacheln in den Koerper.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Schlachtenwueter verbreitet einen eklichen Geruch.\n",
    "Der Schlachtenwueter gibt knirschende Geraeusche von sich.\n"}) );
  SetAttackChats(10, ({
    "Der Schlachtenwueter schreit: Ich werde Dich aufspiessen!\n",
    "Der Schlachtenwueter ruft: Ich liebe Schlachten!\n"}) );

  SUID;
  CLONEME(ARMOUR "stachelhandschuhe" );
  CLONEME(ARMOUR "ellbogenschuetzer" );
  CLONEME(ARMOUR "knieschuetzer" );
  CLONEME(ARMOUR "stachelhelm" );
  CLONEME( "/d/wasser/stahldorn/knarkh/obj/stahldornpanzer" ); 
  command("trage alles");
}

void Attack(object enemy)
{
  object ob;
// Nur als Test, wird dann auf !random(5) ...oder bis zu 10....
  if( !random(1) && ob=present("stachelhelm") )
    ob->spiessen(getuid(enemy), 1);
  if( !random(1) && ob=present("ellbogenschuetzer") )
    ob->spiessen(getuid(enemy), 1);
  if( !random(1) && ob=present("knieschuetzer") )
    ob->spiessen(getuid(enemy), 1);
  ::Attack(enemy);
}

// Mitloggen wenn einen Spieler den NPC killt:
void die(int poisondeath)
{
  WLOG(LOG "schlachtenwueter", " killt den Schlachtenwueter.\n");
  ::die(poisondeath);
}

// Mitloggen wenn der NPC einen Spielerkillt:
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "kills",
  sprintf(" %s %s vom Schlachtenwueter umgebracht. ( -%d XP ).\n",
      dtime(time()), CAP( player->query_real_name() ), lostexp ));
  command("nimm alles aus leiche");
}


