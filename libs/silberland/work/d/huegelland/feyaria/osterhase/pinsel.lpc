//  pinsel.c
// Der Pinsel zum anmalen der Ostereier
// 1997-05-18 Feyaria@SilberLand

#include "../def.h"
#include "./oh.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Pinsel");
  SetProp(P_LONG, BS( 
    "Mit diesem Pinsel kann man verschiedene Sachen anmalen. Natuerlich "
    "braucht man dazu noch die passenden Farben.") );
  SetProp(P_INFO, "Dieser Pinsel gehoerte einmal dem Osterhasen.\n");
  SetProp(P_NAME, "Pinsel");
  SetProp(P_GENDER, MALE);
  AddId( ({"pinsel", "\nosterhasenpinsel"}) );

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

  AddCmd( ({"mal", "male"}), "malen");
}

int malen( string str)
{
  object farbkasten, ob;
  string was, farbe;

  notify_fail("Probiers mit 'male <ei> mit farbe <farbe> an'\n");
  if(!str) return 0;

  if( farbkasten=present( OSTERHASENQUEST_ID, TP) ) 
  {
    if( sscanf(str, "%s mit farbe %s an", was, farbe)==2)
    {
      if( ob=present(was, TP) )
      {
        if(ob->id(OSTERHASENQUEST_EI) )
        {
          if(farbkasten->query_color(farbe))
          {
            if(ob->query_farbe() != "schwarz")
            {
              ob->faerben(farbe);
              write("Du malst das Ei "+ farbe + " an.\n");
              say( CAP_TPN+ " bemalt ein Ei.\n");
              return 1;
            }
            else
              notify_fail("Ein schwarzes Ei kannst Du hoechstens noch entfaerben.\n");
          }
          else
            notify_fail("Im Farbkasten ist gar keine Farbe "+CAP(farbe)+".\n");
        }
        else
          notify_fail("Du sollst doch mit diesem Pinsel Ostereier anmalen!\n");
      }
      else
        notify_fail(CAP(was) + " hast Du ja gar nicht!\n");
    }
  }
  else
    notify_fail("Du hast ja gar keine Farben dabei!\n");
  return 0;
}

void init()
{   
  ::init();
  if( !MENV || !living(MENV) )
    call_out("remove",0);
}
