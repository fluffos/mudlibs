inherit "std/mnpc";

#include "../def.h"
#include "./oh.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  if (is_clone(this_object())) 
  {
    destruct(this_object());
    return;
  }
  ::create();
 
  SetProp(P_SHORT, "Der Osterhase");
  SetProp(P_LONG,BS(
    "Das ist der Osterhase. Er schaut eigentlich aus wie jeder andere Hase. "
    "Er hat ein weiches, graues Fell und lange Schlappohren. Aus seinem Mund "
    "schauen zwei lange Nagezaehne heraus. Was ihn von anderen Hasen "
    "unterscheidet, ist der grosse Korb, den er bei sich traegt. Dort "
    "sind sicher die beruehmten Ostereier drinnen!"));
  SetProp(P_NAME, ({"der Osterhase", "des Osterhasen", "dem Osterhasen",
                    "den Osterhasen"}) );
  SetProp(P_ARTICLE,0);
  SetProp(P_GENDER, MALE);
  AddId( ({"hase", "osterhase", "FELL_WUSCHEL"}) );
  AddDetail( ({"fell"}),
    "Der Osterhase hat ein weiches, graues Fell.");
  AddDetail( ({"ohr", "ohren", "schlappohr", "schlappohren"}),
    "Der Osterhase hat lange, suesse Schlappohren.");
  AddDetail( ({"mund", "zahn", "zaehne", "nagezaehne"}),
    "Im Mund hat der Osterhase zwei lange Nagezaehne.");
  AddDetail( ({"korb", "ei", "eier", "osterei", "ostereier", "eiern",
               "ostereiern"}),
    "Der Osterhase traegt einen Korb mit Eiern mit sich herum.");
 
  create_default_npc( 15 );
  SetProp(P_BODY, 200);
  SetProp(P_HANDS, ({" mit seinen Nagezaehnen", 100}));
  SetProp(P_ALIGN, 1000);
  SetProp(P_RACE, "Nagetier");
  SetProp(P_XP, 0);
  SetProp(P_NOATTACK, "huepft zwischen Deinen Beinen durch.");
  set_living_name ("osterhase");

  SetChats(2, ({
    "Der Osterhase hoppelt um dich herum.\n",
    "Der Osterhase sagt: Ich muss noch so viele Eier verstecken!\n",
    "Der Osterhase fragt Dich: Kennst du ein gutes Eierversteck ?\n",
    "Der Osterhase knabbert an einer Karotte.\n",
    "Der Osterhase bewundert seine bunten Eier.\n",
    "Der Osterhase sagt: Feyaria ist ein liebes Osterhaeschen.\n",
    "Der Osterhase versteckt ein Osterei am Boden.\n",
    "Der Osterhase versteckt hier einige Eier.\n",
    "Der Osterhase versteckt sein letzes Ei und sofort erscheinen neue Eier.\n",
    "Der Osterhase knabbert zur Staerkung an einem Salatblatt.\n",
    "Der Osterhase sagt: Eierverstecken ist ganz schoen anstrengend.\n",
    "Der Osterhase laechelt Dich mit seinen Nagezaehnen an.\n",
    "Der Osterhase winkt Dir mit seinen langen Schlappohren zu.\n"
    }) );
  SetAttackChats(15, ({
    "Der Osterhase bewirft Dich mit Ostereiern.\n",
    "Der Osterhase ruft den Weihnachtsmann um Hilfe.\n",
    "Der Osterhase sagt: Feyaria wird das nicht gefallen!\n",
    "Der Osterhase sagt: Du wirst nie wieder Ostereier essen!.\n",
    "Der Osterhase sagt: Lass mich in Ruhe meine Eier verstecken!\n",
    "Der Osterhase isst ein Spinatblatt und hat auf einmal riesiege Muskeln.\n"
   }) );

  SetProp(P_MSGIN,"hoppelt herein");
  SetProp(P_MSGOUT,"versteckt hier ein Osterei und hoppelt");
  SetProp(P_MMSGIN, "kommt aus dem Osterland");
  SetProp(P_MMSGOUT,"verschwindet ins Osterland");
  SetProp(P_MNPC_AREA, ("/d/huegelland/feyaria/weg/room/") );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, "/d/huegelland/feyaria/weg/room/0313" );
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS+ MOV_INDOORS+ MOV_BACKWARDS+ MOV_MOVES);
  SetProp(P_DIE_MSG, " kommt naechste Ostern wieder.\n" );
  SetProp(P_NOCORPSE, 1 );

  SetProp(P_DEFAULT_INFO,"sagt: Das hat doch nichts mit Ostern zu tun.\n");
  SetProp(P_LOG_INFO, "feyaria/osterhase_log");
  AddInfo("kaninchen",
    "sagt: Das sind keine richtigen Hasen.\n");
  AddInfo(({"hase","hasen"}),
    "sagt: Ich bin kein normaler Hase, ich bin der Osterhase.\n");
  AddInfo(({"osterhase ", "ostern"}), 
    "sagt: Zu Ostern verstecke ich die Ostereier.\n");
  AddInfo( ({"ostereier", "osterei", "eier", "ei", "eiern", "ostereiern"}),
    "Ich mache die Ostereier immer aus den Eiern von Waldhasen, die schmecken "
    "viel besser als Vogeleier, obwohl Haseneier viel schwerer zu finden sind.",
    "erzaehlt: ");
  AddInfo( ({"waldhase", "waldhasen"}),
    "Waldhasen leben im Wald, das war nicht schwer zu erraten, aber Du "
    "solltest Dich mehr fuer die Haseneier interessieren.", "sagt: ");  
  AddInfo( ({"vogelei", "vogeleier", "vogeleiern"}),
    "Vogeleier sind nicht das richtige fuer Ostereier, ich verwende nur die "
    "originalen Haseneier.", "sagt: ");
  AddInfo( ({"hasenei", "haseneier", "haseneiern"}),
    "Haseneier findet man nur sehr selten im Wald. Die eierlegenden Hasen "
    "verstecken sich immer im dichten Unterholz.", "sagt: ");
  AddInfo( ({"wald", "unterholz"}),
    "Vielleicht findest Du ja ein dichtes Unterholz hier in der Naehe, dort "
    "koenntest Du dann auch Haseneier finden.", "sagt: ");
  AddInfo( ({"sense", "leiter"}),
    "Ich hab immer eine Sense und eine Leiter dabei, kann manchmal ganz "
    "nuetzlich sein. Jeder Bauer kann Dir sowas verkaufen.", "sagt : ");
  AddInfo( ({"feyaria","osterhaeschen"}),
    "sagt: Feyaria ist ein liebes Osterhaeschen.\n");
  AddInfo( ({"farben", "bunt", "bemalt", "bunte farben", "farbe", "bemalen", 
            "versteck", "verstecken", "eierverstecken", "faerben"}),
    "Ich faerbe die Eier und verstecke sie dann. Aber ich habe soviel zu tun, "
    "dass ich um jede Hilfe beim Eierfaerben froh bin.", "sagt: ");
  AddInfo(({"rot", "blau", "gruen", "gelb", "orange", "violett", "tuerkis",
            "braun", "rosa", "schwarz"}),
    "sagt: Ja, das ist eine schoene Farbe fuer das Eierfaerben.\n");
  AddInfo(({"hilfe", "hilfe", "abenteuer", "problem", "aufgabe"}),
    "Ich koennte deine Hilfe gebrauchen. Ich muss noch so viele Eier faerben, "
    "aber leider habe ich so wenig Zeit. Wenn Du willst, kannst Du mir ja "
    "ein bisschen behilflich sein. Frag mich einfach nach einem Farbkasten.",
    "sagt: ");
  AddInfo( ({"farbkasten"}), "@@aufgabe@@");
  AddInfo( ({"eierfaerben"}), "@@faerben@@");
  AddInfo( ({"faerberei", "elessar", "elfendorf"}),
    "In der Faerberei von Elessar findest Du sicher genuegend Grundfarben "
    "zum Eierfaerben. Falls nicht, kannst Du ja dem weisen Aerendil um Rat "
    "fragen.", "sagt: ");
  AddInfo( ({"grundfarben"}),
    "Rot, Blau, Gruen und Gelb sind die Grundfarben, die ich fuer das "
    "Eierfaerben verwende.", "erzaehlt: ");
  AddInfo(({"salat","salatblatt","karotte","karotten"}),
    "sagt: Das ist meine Lieblingsspeise!\n");
  AddInfo("korb",
    "sagt: In diesem Korb sind die Ostereier drinnen.\n");
  AddInfo( ({"blutrot", "blutrote farbe"}),
    "Blutrote Farbe macht man aus Blut, am besten aus Schweineblut.", 
    "sagt: ",1);
  AddInfo( ({"schwein", "schweine", "schweineblut"}),
    "Schweineblut gibt es manchmal auf Bauernhoefen, wenn ein Schwein "
    "geschlachtet wird.", "sagt: ",1);
  AddInfo( ({"bauernhof", "bauernhoefe"}),
    "Ein Bauernhof wird doch leicht zu finden sein. Ich verstecke fuer "
    "Hansi und Greti jedes Jahr einige Eier.", "sagt: ",1);
  AddInfo( ({"hansi", "greti"}),
    "Hansi und Greti wohnen auf einem Bauernhof in der Naehe von Midas.",
    "sagt :",1);   
  AddInfo( ({"himmelblau", "himmelblaue farbe"}),
    "Himmelblaue Farbe bekommt man natuerlich aus dem Himmel.", "sagt: ",1);
  AddInfo( ({"himmel"}),
    "Den schoensten Himmel gibt es an den suedlichen Kuesten.", "sagt: ",1);
  AddInfo( ({"kueste", "kuesten", "dschungel", "tijara"}),
    "Einen wirklich himmelblauen Himmel gib es an der Kueste im Dschungel, "
    "in der Naehe von Tijara.", "sagt: ",1);
  AddInfo( ({"grasgruen", "grasgruene farbe"}),
    "Grasgruene Farbe macht man aus Gras.", "sagt: ",1);
  AddInfo( ({"gras"}),
    "Gut geeignet ist das Gras, das Kuehe gerne fressen.", "sagt: ",1);
  AddInfo( ({"kuh", "kuehe" ,"hufe", "hoerner"}),
    "Eine Kuh ist so ein grosses Wesen mit 4 Hufen und 2 Hoernern. Es gibt "
    "viele davon ein Stueck westlich von hier Richtung Derlim.", 
    "sagt: ",1);
  AddInfo( ({"derlim", "hobbits"}),
    "In Derlim leben die Hobbits.");  
  AddInfo( ({"eigelb", "eigelbe farbe", "dottergelb", "eidottergelb", 
             "dottergelbe farbe", "eidottergelbe farbe"}),
    "Das schoenste Eigelb gibt es in den Eiern von Seevoegeln", "sagt: ",1);
  AddInfo( ({"seevogel", "seevoegel"}),
    "Seevoegel nisten meist auf den kleinen Inseln mitten im Meer, vor allem "
    "dort, wo es sehr felsig ist.", "sagt: ",1);
  AddInfo( ({"insel", "inseln", "meer"}),
    "Im Meer gibt es viele Inseln.", "sagt: ", 1);
  AddInfo( ({"felseninsel", "moewe", "moewen"}),
    "Die Eier der Moewen auf der Felseninsel wuerden eine ganz gute gelbe "
    "Farbe abgeben.", "sagt: ", 1);
  
  CLONEME( OSTERHASENQUEST_DIR "sense");
  CLONEME( OSTERHASENQUEST_DIR "leiter");

  AddCmd( ({"fertig"}), "fertig");
}

string aufgabe()
{
  if( TP->QueryQuest(OSTERHASENQUEST) ) 
    return "erinnert sich: Aber Du hast mir doch schon geholfen!\n";
  if( present(OSTERHASENQUEST_ID, TP) )
    return "sagt: Aber Du hast doch schon einen Farbkasten!\n";
  write("Der Osterhase gibt Dir einen Farbkasten und einen Pinsel.\n");
  CLONE( OSTERHASENQUEST_DIR "farbkasten", TP);
  CLONE( OSTERHASENQUEST_DIR "pinsel", TP);
  call_out("faerben", 4);
  return "sagt: Viel Glueck beim Eierfaerben.\n";
}

string faerben()
{

  write(break_string(
    "Achja, fast haette ich vergessen, Dir das Eierfaerben zu erklaeren. Du "
    "musst Dir die vier Grundfarben holen und damit 10 Eier in verschiedenen "
    "Farben anmalen. Die Grundfarben findest Du sicher in der alten Faerberei "
    "in Elessar. Wenn Du 10 verschiedenfaerbige Eier hast, dann komm einfach "
    "wieder zu mir und sag mir, dass Du fertig bist.", 78, 
    "Der Osterhase sagt: ")); 
  return "sagt: Und mach alles schoen bunt!\n";
}

void catch_tell(string str)
{
  string wer, was;
  if( sscanf(str, "%s sagt: %s", wer,was)==2 )
  {
    if( strstr(was, "fertig"))
      call_out("fertig",0);
  }
}

void fertig()
{
  string was;
  object ob, ob2;
  object *eier;
  int i;
  if( TP && (ob=present( OSTERHASENQUEST_ID, TP)) && (ob2=present("pinsel", TP)) )
  {
    if( present( "blaues "+OSTERHASENQUEST_EI, TP) &&     
        present( "rotes "+OSTERHASENQUEST_EI, TP) &&
        present( "gruenes "+OSTERHASENQUEST_EI, TP) &&
        present( "gelbes "+OSTERHASENQUEST_EI, TP) &&
        present( "oranges "+OSTERHASENQUEST_EI, TP) &&
        present( "violettes "+OSTERHASENQUEST_EI, TP) &&
        present( "braunes "+OSTERHASENQUEST_EI, TP) &&
        present( "rosa "+OSTERHASENQUEST_EI, TP) &&
        present( "tuerkises "+OSTERHASENQUEST_EI, TP) && 
        present( "schwarzes "+OSTERHASENQUEST_EI, TP) )
    {
      if( TP->GiveQuest(OSTERHASENQUEST) == 1)
      {
        write_file (OSTERHASENQUEST_LOG,
          sprintf ("%s  %s hat dem Osterhasen geholfen.\n",
            dtime(time()), CAP(TP->query_real_name())));
      }
      write(BS("Der Osterhase bedankt sich fuer Deine Muehe und nimmt "
               "Dir alle Eier ab."));
      write("Der Osterhase sagt: Den Farbkasten und Pinsel brauchst Du "
            "jetzt nicht mehr.\n");
      ob->remove();
      ob2->remove();
      present( "blaues "+OSTERHASENQUEST_EI, TP)->remove(1);
      present( "rotes "+OSTERHASENQUEST_EI, TP)->remove(1);
      present( "gruenes "+OSTERHASENQUEST_EI, TP)->remove(1);
      present( "gelbes "+OSTERHASENQUEST_EI, TP)->remove(1);
      present( "oranges "+OSTERHASENQUEST_EI, TP)->remove(1);
      present( "violettes "+OSTERHASENQUEST_EI, TP)->remove(1);
      present( "braunes "+OSTERHASENQUEST_EI, TP)->remove(1);
      present( "rosa "+OSTERHASENQUEST_EI, TP)->remove(1);
      present( "tuerkises "+OSTERHASENQUEST_EI, TP)->remove(1);
      present( "schwarzes "+OSTERHASENQUEST_EI, TP)->remove(1);
      if( ob=present(OSTERHASENQUEST_LEITER, TP) )
      {
        ob->remove();
      }
      if( ob=present(OSTERHASENQUEST_SENSE, TP) )
      {
        ob->remove();
      }    
    } 
    else
      write("Der Osterhase sagt: Du hast noch nicht genug "
        "verschiedenfarbige Eier.\n");
  }
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();
  move( QueryProp(P_MNPC_DEFAULTROOM), M_TPORT);
}
