// Farbkasten fuer die Osterhasenquest
// 1997-05-18  Feyaria@SilberLand

#include "../def.h"
#include "./oh.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

string *farben;

void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Farbkasten");
  SetProp(P_NAME, "Farbkasten");
  SetProp(P_GENDER, MALE);
  AddId( ({"kasten", "farbkasten", OSTERHASENQUEST_ID}) );

  SetProp(P_MATERIAL, MAT_WOOD );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  farben=({"leer","leer","leer","leer"});
  SUID;
}

string long()
{
  string ausgabe;
  int i;

  ausgabe= "In diesem Farbkasten ist Platz fuer vier verschiedene Farben. ";
  if( !sizeof(farben) )
    ausgabe+="Zur Zeit ist aber keine Farbe vorhanden.";
  else
  {
    ausgabe+="Folgende Farben sind zur Zeit vorhanden: ";
    for(i=0;i<sizeof(farben);i++ )
    {
      ausgabe+=farben[i]+", ";
    }
  }
  return BS(ausgabe[0..<3]+".");
}

int query_color(string farbe)
{
  if( member( farben, farbe)!=-1) return 1;
  return 0;
}

int set_color(string farbe)
{
  int i;
  string po_uid;

  if( member( farben, farbe)!=-1) return 0;

  po_uid = explode(getuid(PO),".")[<1];
  if( po_uid=="feyaria" || (po_uid=="rohkopfrex" && farbe=="rot") )
  {
    while( farben[i]!="leer" ) i++;
    farben[i]=farbe;
    DB("OSTERHASENQUEST: "+TPN+" findet Farbe "+farbe+"\n");
    WLOG( OSTERHASENQUEST_DIR "osterhase.log"," findet Farbe "+farbe); 
    return 1;
  }
  else
  {
    DB("Illegaler Zugriff in der Osterhasenquest!\n");
    DB( sprintf("PO= %s, ENV = %s\n", getuid(PO), getuid(MENV) ) );

    write_file( OSTERHASENQUEST_DIR  "illegal.log", sprintf(
      "%s: Illegaler Farbzugriff: PO = %s, ENV = %s\n", 
      dtime(time()), getuid(PO), getuid(MENV) ));
    return 0;
  }
}

int query_all_colors()
{
//  if( farben==({"leer", "leer", "leer", "leer"}) ) return 0;
  return 1;
}

void init()
{
  ::init();
  if( !MENV || !living(MENV) )
    call_out("remove",0);
}
