// /players/feyaria/osterhase/obj/leiter.c   
// Leiter fuer blaue Farbe in Osterhasequest
// 25-06-96  Feyaria@AnderLand
// 1997-05-18 Feyaria@SilberLand

inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include "oh.h"

void create()
{
  if (IS_BLUE(ME)) return;
  ::create();
  SetProp(P_NAME, "Leiter");
  SetProp(P_SHORT, "Eine Leiter");
  SetProp(P_LONG,
    "Eine vier Meter lange Leiter, mit der man ueberall hinaufsteigen kann.\n");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_SIZE, 400);
  SetProp(P_VALUE, 0);
  SetProp(P_MATERIAL, MAT_WOOD);
  SetProp(P_NODROP, 
      "Du solltest Xaver die Leiter zurueckgeben, wenn Du sie nicht mehr brauchst.\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  AddId(({"leiter", OSTERHASENQUEST_LEITER, "QUESTOBJ"}));

  AddCmd( ({"gib", "gebe"}), "geben");
}

int geben(string str)
{
  object ob;
  if(str=="leiter zurueck" || str=="leiter an xaver")
  {
    if(!ob=present(OSTERHASENQUEST_ID, TP))
      return 0;
    if(!present("xaver", environment(TP)))
    {
      write("Die Leiter gehoert doch Xaver, Du musst sie ihm zurueckgeben!\n");
      return 1;
    }
    if(!ob->query_color("blau"))
    {
      write(BS("Bevor Du die Leier zurueck gibts, solltest Du besser die "
          "blaue Farbe suchen."));
      return 1;
    }
    write("Du gibts die Leiter an Xaver zurueck.\n"
        "Xaver sagt: No endli grieg i mei Loata wieda.\n");
    remove();
    return 1;
  }
  return 0;
}

void init()
{
  ::init();
  if( !MENV || !living(MENV) )
    call_out("remove",0);
}
