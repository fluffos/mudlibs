// /players/feyaria/osterhase/obj/sense.c   Sense zum Maehen von Gras
// 25-06-1996   Feyaria@AnderLand 
// 1997-05-18 Feyaria@SilberLand

inherit "std/weapon";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../def.h"
#include "oh.h"

void create()
{
  if (IS_BLUE(ME)) return;
  ::create();
  SetProp(P_SHORT,"Eine Sense");
  SetProp(P_LONG, BS(
    "Diese Sense eignet sich hauptsaechlich zum Maehen von Gras, "+
    "aber zur Not kann sich ein Bauer damit auch verteidigen."));
  SetProp(P_NAME, "Sense");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 800);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WC,90);
  SetProp(P_MATERIAL, ([MAT_IRON:30,MAT_WOOD:70]) );
  SetProp(P_WEAPON_TYPE, WT_SWORD);
  SetProp(P_DAM_TYPE, DT_SLASH);
  SetProp(P_NODROP, 
      "Du solltest Xaver die Sense zurueckgeben, wenn Du sie nicht mehr brauchst.\n");
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  AddId(({"sense", OSTERHASENQUEST_SENSE, "QUESTOBJ"}));

  AddCmd( ({"gib", "gebe"}), "geben");
}

int geben(string str)
{
  object ob;
  if(str=="sense zurueck" || str=="sense an xaver")
  {
    if(!ob=present(OSTERHASENQUEST_ID, TP))
      return 0;
    if(!present("xaver", environment(TP)))
    {
      write("Die Sense gehoert doch Xaver, Du musst sie ihm zurueckgeben!\n");
      return 1;
    }
    if(!ob->query_color("gruen"))
    {
      write(BS("Bevor Du die Sense zurueck gibts, solltest Du besser die "
          "gruene Farbe suchen."));
      return 1;
    }
    write("Du gibts die Sense an Xaver zurueck.\n"
        "Xaver sagt: No endli grieg i mei Sensn wieda.\n");
    remove();
    return 1;
  }
  return 0;
}

void init()
{   
  ::init();
  if( !MENV || !living(MENV) )
    call_out("remove",0);
}
