// /d/huegelland/feyaria/orks/armour/orkmantel.c  
// Ein Orkmantel
// 1997-04-11 Feyaria@SilberLand

inherit "std/armour";

#include "../def.h"

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Orkmantel");
  SetProp(P_LONG, 
    "Du bist erstaunt, dass dieser verdreckte Fetzen Stoff als 'Mantel' "
    "bezeichnet wird. Aber da er von Orks getragen wird, wundert dich "
    "nichts. Eine bestimmte Farbe kannst Du nicht erkennen, da der "
    "Mantel voller Dreck und Blut ist.");
  SetProp(P_NAME, "Orkmantel");
  SetProp(P_GENDER, MALE);
  AddId(({"mantel", "orkmantel"}));
  
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_CLOTH:90, MAT_SHIT:5, MAT_BLOOD:5]) );
  SetProp(P_WEIGHT, 1700);
  SetProp(P_VALUE, 250);
}

