// /d/huegelland/feyaria/orks/armour/hoernerhelm.c  
// Ein gehoernter Helm
// 1997-04-11 Feyaria@SilberLand

inherit "std/armour";

#include "../def.h"

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  
  SetProp(P_SHORT, "Ein gehoernter Helm");
  SetProp(P_LONG, 
    "Dieser Helm besteht aus gehaertetem Stahl und besitzt bei grosse "
    "Hoerner, die wohl von einem Bueffel stammen. Dass der Besitzer des "
    "Helmes die Hoerner nicht nur zur Zierde traegt, sieht man an den "
    "eingetrockneten Blutflecken, die auf dem ganzen Helm und vor allem "
    "auf den Hoernern zu finden sind.");
  SetProp(P_NAME, "Hoernerhelm");
  SetProp(P_GENDER, MALE);
  AddId(({"helm", "hoernerhelm"}));
  AddAdjective( ({"gehoernt", "gehoernten", "gehoernter"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_HORN:15,MAT_STEEL:60,MAT_LEATHER:20,MAT_BLOOD:5]));
  SetProp(P_WEIGHT, 2500);
  SetProp(P_VALUE, 2250);
  SetProp(P_EFFECTIVE_WC, 120 );
}

