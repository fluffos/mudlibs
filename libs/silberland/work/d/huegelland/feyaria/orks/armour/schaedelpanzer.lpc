// /d/huegelland/feyaria/orks/armour/schaedelpanzer.c  
// Ein Schaedelpanzer
// 1997-04-11  Feyaria@SilberLand

inherit "std/armour";

#include "../def.h"

void create()
{
  if( !is_clone(this_object()) ) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Schaedelpanzer");
  SetProp(P_LONG, 
    "Dieser Panzer besteht aus hartem, schwarzem Leder, in das zur "
    "Verstaerkung einige Metallplatten eingearbeitet wurden. Das "
    "Ungewoehliche sind aber die vielen Totenschaedel, die diesen Panzer "
    "schmuecken. Auch das Leder wurde mit roten Totenkoepfen bemalt, und so "
    "macht der Panzer einen sehr gruseligen Eindruck.");
  SetProp(P_NAME, "Schaedelpanzer");
  SetProp(P_GENDER, MALE);
  AddId(({"panzer", "schaedelpanzer"}));
  
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_AC, 29);
  SetProp(P_MATERIAL, ([MAT_BRASS:40, MAT_LEATHER:40, MAT_BONE:20]) );
  SetProp(P_WEIGHT, 6700);
  SetProp(P_VALUE, 1100);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_GOOD:-100, A_STR:10]) );
  AddProp(P_DAM_PROTECTION, ([DT_UNHOLY:1, DT_ACID:1, DT_TERROR:1]) );
  SetProp(P_WEAR_TEXT, ({ 
      "Mit ziemlichem Grausen ziehst Du den Schaedelpanzer an.\n",
      " zieht mit ziemlichem Grausen den Schaedelpanzer an.\n" }) );
}

