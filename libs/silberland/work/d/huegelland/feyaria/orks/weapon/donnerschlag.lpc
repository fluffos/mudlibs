inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include <defines.h>
#include <moredef.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Der Donnerschlag");
  SetProp(P_LONG, 
    "Der Donnerschlag is eine dem Morgenstern aehnliche Waffe, mit dem "
    "grossen Unterschied, dass an einem langen Stiel gleich fuenf Kugeln "
    "mit stabilen Eisenketten befesigt sind. Das Zielen mit dieser "
    "gewaltigen Waffe ist sehr schwer, aber wenn man mit allen fuenf Kugeln "
    "den Gegner trifft, ist die Schadenswirkung enorm. Nur muss man "
    "aufpassen, dass man nicht selbst von den wild herumschwirrenden Kugeln "
    "getroffen wird. Den Namen hat diese Kettenwaffe von dem droehnden Laerm, "
    "den die Kugeln und Ketten machen, wenn sie von einem erfahrenen Kaempfer "
    "in der Luft herumgewirbelt werden.");
  SetProp(P_NAME, "Donnerschlag");
  SetProp(P_GENDER, MALE);
  AddId( ({"donnerschlag"}) );

  SetProp(P_WEAPON_TYPE, WT_CHAIN );
  SetProp(P_WC, 287);
  SetProp(P_WC_FIX, 10);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_PIERCE}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_IRON: 60, MAT_OAK: 40]) );
  SetProp(P_WEIGHT, 4500);
  SetProp(P_VALUE, 3100);
  SetProp(P_QUALITY_DECAY, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:25]) );  
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_KILL_NAME, "Ungeschickter Umgang mit dem Donnerschlag");
  SetProp(P_KILL_MSG, "Welche meiner fuenf toedlichen Kugeln war es denn?");
}

void selbsttreffer(int kugel)
{
  object wielder;
  wielder=QueryProp(P_WIELDED); 
  switch( kugel )
  {
    case 0: tell_object(wielder,
              "Gluecklicherweise trifft Dich keine der Kugeln.\n");
            break;
    case 1: tell_object(wielder,
              "Ungluecklicherweise trifft Dich eine Kugel.\n");
            wielder->do_damage(1+random(10));
            break;
    case 2: tell_object(wielder,
              "Ungluecklicherweise treffen Dich zwei Kugeln.\n");
            wielder->do_damage(2+random(20));
            break;
    case 3: tell_object(wielder,
              "Ungluecklicherweise treffen Dich drei Kugeln.\n");
            wielder->do_damage(3+random(30));
            break;
    case 4: tell_object(wielder,
              "Ungluecklicherweise treffen Dich vier Kugeln.\n");
            wielder->do_damage(4+random(40));
            break;
    case 5: tell_object(wielder,
              "Ungluecklicherweise treffen Dich alle fuenf Kugeln.\n"
              "Du faellst betaeubt zu Boden.\n");
            tell_room(ENV(wielder), 
                wielder->Name(WER,2)+" trifft sich selbst und faellt betaeubt "
                  "zu Boden.\n", ({wielder}) );
            wielder->do_damage(5+random(50));
            wielder->SetProp(P_PARALYZED, ([
                PARALYZE_TIME: 1+random(9),
                PARALYZE_MSG: "Du bist von Deinem Eigentreffer bewusstlos.\n",
                PARALYZE_MSG_OTHER: "%s ist durch den schweren Eigentreffer "
                                    "bewusstlos.\n",
                PARALYZE_END: "Du kommst wieder zu Dir und stehst auf.\n",
                PARALYZE_END_OTHER: "%s kommt wieder zu sich und steht auf.\n"
                ]) );
            break;
  }
}

int HitFunc(object enemy)
{
  int bonus;
  object wielder;
  if( !interactive(wielder=QueryProp(P_WIELDED)) )
    bonus = random(3);
  else 
    bonus = 0;
  switch( random(6)+bonus )
  {
    case 0: tell_object(wielder, "Keine Kugel trifft "+
                enemy->name(WEN,2)+".\n");
            tell_object(enemy, "Keine der Kugeln trifft Dich.\n"); 
            if( random(100)>95 ) selbsttreffer(random(6));
            return -300;
    case 1: tell_object(wielder, "Nur eine Kugel trifft "+
                enemy->name(WEN,2)+".\n");
            tell_object(enemy, "Nur eine Kugel trifft Dich.\n"); 
            if( random(100)>80 ) selbsttreffer(random(5));
            return -150;
    case 2: tell_object(wielder, "Zwei Kugeln treffen "+
                enemy->name(WEN,2)+".\n");
            tell_object(enemy, "Zwei Kugeln treffen Dich.\n"); 
            if( random(100)>60 ) selbsttreffer(random(4));
            return 0;
    case 3: tell_object(wielder, "Drei Kugeln treffen "+
                enemy->name(WEN,2)+".\n");
            tell_object(enemy, "Drei Kugeln treffen Dich.\n"); 
            if( random(100)>40 ) selbsttreffer(random(3));
            return 50+random(100);
    case 4: tell_object(wielder, "Vier Kugeln treffen "+
                enemy->name(WEN,2)+".\n");
            tell_object(enemy, "Vier Kugeln treffen Dich.\n"); 
            if( random(100)>20 ) selbsttreffer(random(2));
            return 100+random(200);
    default: tell_object(wielder, "Alle fuenf Kugeln treffen "+
                enemy->name(WEN,2)+".\n");
            tell_object(enemy, "Alle fuenf Kugeln treffen Dich. AUA!!!\n"); 
            if( random(2) )
            {
              tell_room(ENV(wielder), enemy->Name(WER,2)+ " bricht bewusstlos "
                  "zusammen.\n", ({enemy}));
              if( interactive(enemy) )
              {
                tell_object(enemy, "Durch den schweren Treffer wirst Du "
                                   "bewusstlos und faellst zu Boden.\n");
                enemy->SetProp(P_PARALYZED, ([
                  PARALYZE_TIME: 1+random(3),
                  PARALYZE_MSG: "Du liegst bewusstlos am Boden.\n",
                  PARALYZE_END: "Du kommst wieder zu Dir und stehst auf.\n",
                  PARALYZE_END_OTHER: "%s kommt wieder zu sich und steht auf.\n"
                ]) );
              }
              else
                enemy->SetProp(P_DISABLE_ATTACK, 
                  enemy->QueryProp(P_DISABLE_ATTACK)+1+random(3));
            }
            return 200+random(300);
  }
}

