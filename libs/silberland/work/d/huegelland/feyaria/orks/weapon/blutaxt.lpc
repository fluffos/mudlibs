#include "../def.h"
#include <class.h>

inherit "/std/weapon";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Die Blutaxt");
  SetProp(P_LONG, BS(
    "Du siehst eine gewaltige Streitaxt mit 2 maechtigen Blaettern aus einem "
    "silbrig funkelnden Metall. Auch der Stiel ist aus extrem hartem Stahl "
    "gefertigt. Von den beiden Axtklingen tropft staendig Blut auf den "
    "Boden hinunter. Ein eisiger Schauer laeuft Dir ueber den Ruecken, als "
    "Dir klar wird, dass das Dein eigenes Blut ist!"));
  SetProp(P_NAME, "Blutaxt");                 
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt", "blutaxt"}) );  
  SetProp(P_INFO, BS(
    "Damit diese Axt mehr Schaden macht, hat der Schmied einen minderen "
    "Daemon in die Klinge eingearbeitet. Damit der Daemon weiter in der Axt "
    "gebunden bleibt, muss der Besitzer staendig von seinem eigenen Blut "
    "opfern."));
  AddDetail( ({"blut"}),
    "Das frische Blut, das ueber die Axtklingen zu Boden fliesst, stachelt "
    "Deinen Kampfeswillen an.");

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 295);
  SetProp(P_WC_FIX, 10);
  SetProp(P_DAM_TYPE, ({DT_SLASH, DT_UNHOLY}) );
  SetProp(P_QUALITY_DECAY, 190);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WEIGHT, 8000);
  SetProp(P_VALUE, 5000);
  SetProp(P_WIELD_RESTRICTIONS, 
    ([P_LEVEL:35, A_STR:26, A_CON:26, SR_GOOD:-100 ]));
  SetProp(P_MATERIAL, ([MAT_MITHRIL:35, MAT_STEEL:60, MAT_BLOOD:2, 
                        MAT_MISC_UNHOLY:3]) ); 
  SetProp(P_HIT_FUNC, TO);    
  SetProp(P_UNWIELD_FUNC, TO);
  SetProp(P_WIELD_FUNC, TO);
}

int HitFunc(object enemy)
{
  int hp,al,r,blut;
  object wer;
  if( enemy->is_class_member(CL_DEMON) || enemy->is_class_member(CL_UNDEAD) ) 
    r = -150;
  else
    r = 0;
  wer=QueryProp(P_WIELDED); 
  if( wer->is_class_member(CL_DEMON) )
    hp=1;
  else
    hp=-1;
  if( wer->QueryProp(P_RACE)=="Troll") hp--;
  if( (al=wer->QueryProp(P_ALIGN)) > 100 ) hp -=al/100;
  if( wer->QueryProp(P_HP) < (wer->QueryProp(P_MAX_HP)/2) && !r && 
      ( !random(5) || hp > 0 ) )
  {
    tell_object(wer, 
      "Die Blutaxt saugt Blut aus "+enemy->name(WEM,2)+".\n");
    tell_object(enemy, 
      "Die Blutaxt "+name(WESSEN,1)+" saugt Dir das Blut aus.\n");
    blut=random(20)-al/100;
    enemy->AddHp(-blut);
    hp+=random(blut);
    r+=blut+random(blut);
  }
//  DB("AXT: "+hp+" "+sprintf("%O",wer)+"\n");
  wer->AddHp(hp);
  return r;
}

int UnwieldFunc(object waffe, int silent)
{
  if( QueryProp(P_WIELDED)->InFight() )
  {
    if(!silent) 
      write("Die Blutaxt will unbedingt weiterkaempfen!\n");
    return 0;
  }
  QueryProp(P_WIELDED)->AddHp(-1-random(3));
  return 1;
}

int WieldFunc(object waffe, int silent)
{
  TP->AddHp(-1-random(3));
  return 1;
}
