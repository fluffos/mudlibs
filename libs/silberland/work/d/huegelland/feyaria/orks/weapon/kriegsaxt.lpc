#include "../def.h"

inherit "/std/weapon";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Eine orkische Kriegsaxt");
  SetProp(P_LONG, BS(
    "Diese grosse orkische Axt wird vor allem von starken orkischen Kriegern "
    "verwendet. Die Axtklinge ist mit vielen Dornen und Zacken bewehrt und "
    "der Hammerkopf auf der der Axtklinge gegenueberliegenden Seite ist "
    "besonders gross. Dadurch leidet die Kriegsaxt etwas an Stabilitaet, "
    "schaut aber um vieles gefaehrlicher aus. An einigen Dornen klebt noch "
    "frisches Blut. Der dicke Holzstiel ist mit wilden Schnitzereien "
    "verziert."));
  SetProp(P_NAME, "Kriegsaxt");
  SetProp(P_NAME_ADJ, "orkisch" );
  SetProp(P_GENDER, FEMALE);
  AddId( ({"axt", "kriegsaxt", "orkaxt"}) );  
  AddAdjective( ({"orkisch", "orkische"}) );
  SetProp(P_INFO, BS(
    "Oft sind die Klingen von orkischen Aexten vergiftet."));
  AddDetail( ({"stiel", "holzstiel", "schnitzerei", "schnitzereien"}),
    "Der dicke Holzstiel ist mit Schnitzereien verziert. Sie stellen "
    "Daemonenfratzen und Totenschaedel dar.");
  AddDetail( ({"daemonenfratzen", "totenschaedel", "symbole"}),
    "Solche Symbole geben einem Ork zusaetzliche Kraefte, wenn er in den "
    "Kampf zieht.");
  AddDetail( ({"dornen", "dorn", "zacke", "zacken"}),
    "Die Zacken und Dornen schauen wirklich sehr gefaehrlich aus.");
  AddDetail( ({"hammerkopf"}),
    "Mit dem Hammerkopf kann man auch zuschlagen, dazu muss man nur die Axt "
    "wenden.");

  SetProp(P_WEAPON_TYPE, WT_AXE);
  SetProp(P_WC, 234);
  SetProp(P_WC_BONUS, (["ork":111]) );
  SetProp(P_WC_FIX, 15);
  SetProp(P_DAM_TYPE, DT_RIP );
  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_WEIGHT, 3100);
  SetProp(P_VALUE, 2700);
  SetProp(P_WIELD_RESTRICTIONS, ([P_LEVEL:18, A_STR:22]) );
  SetProp(P_MATERIAL, ([MAT_OAK:60, MAT_STEEL:38, MAT_MISC_POISON:2]) ); 

  if( !random(10) )
  {
    SetProp(P_WC, 222);
    SetProp(P_DAM_TYPE, ({DT_RIP, DT_POISON}) );
    SetProp(P_INFO, BS(
          "Toedliches Gift tropft von der Klinge der Kriegsaxt."));
  }

  AddCmd( ({"wende", "wenden"}), "cmd_wenden");
}

int cmd_wenden(string str)
{
  if( !id(str) ) return 0;

  if( member(QueryProp(P_DAM_TYPE), DT_RIP) != -1)
  {
    SetProp(P_DAM_TYPE, QueryProp(P_DAM_TYPE) + ({DT_BLUDGEON}) - ({DT_RIP}) );
    write("Du schlaegst nun mit dem Hammerkopf der Kriegsaxt zu!\n");
  } 
  else
  {
    SetProp(P_DAM_TYPE, QueryProp(P_DAM_TYPE) - ({DT_BLUDGEON}) + ({DT_RIP}) );
    write("Du schlaegst nun mit der Axtklinge der Kriegsaxt zu!\n");
  } 
  return 1;
}
