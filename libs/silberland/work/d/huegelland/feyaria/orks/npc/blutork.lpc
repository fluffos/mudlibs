// Ein blutruenstiger Ork 
// 08-08-1996  Feyaria@AnderLand
// 1997-04-11  Feyaria@SilberLand
// 1998-10-10  angepasst

#include "../def.h"
#include <mnpc.h>

inherit NPC "std_ork";

void create()
{
  if (!is_clone(this_object()) ) return;
  ::create();
  
  SetProp(P_SHORT, "Ein blutruenstiger Ork");
  SetProp(P_LONG, 
    "Dieser Ork sieht noch viel wilder aus als alle anderen seiner Rasse, "
    "die Du je zu Gesicht bekommen hast. Sein ganzer Koerper ist mit "
    "eingetrockneten Blutflecken uebersaeht, und von seinen Fingern "
    "tropft frisches Blut auf den Boden. Am schlimmsten ist aber sein "
    "gewaltiges Gebiss, denn seine langen und spitzen Eckzaehne sind "
    "wahrlich dafuer geschaffen, Dir die Kehle aufzureissen.");
  SetProp(P_NAME, "Ork");
  set_living_name("blutork");
  SetProp(P_NAME_ADJ, "blutruenstig");
  SetProp(P_GENDER, MALE);
  AddId(({"ork", "blutruenstiger ork", "blutork"}));
  SetProp(P_SMELL, "Der Ork riecht nach frischem Blut.\n");
  AddDetail( ({"blut", "blutflecken"}),
    "Der ganzer Koerper des Orks ist mit eingetrockneten Blutflecken "
    "uebersaeht, und von seinen Fingern tropft frisches Blut auf den Boden. "
    "Du fragst Dich, " "welche grausamen Taten dieser Ork schon hinter sich "
    "hat."); 
  AddDetail( ({"gebiss", "zahn", "zaehne", "eckzahn", "eckzaehne"}),
    "Dieser Ork hat ein fuerchterliches Gebiss, denn seine langen und "
    "spitzen Eckzaehne sind wahrlich dafuer geschaffen, Dir die Kehle "
    "aufzureissen. Jeder Vampir wuerde diesen Ork sicherlich beneiden!");

  create_default_npc(33);
  SetProp(P_HANDS, ({" mit seinen blutbefleckten Haenden",
      QueryProp(P_HANDS)[1]+50,DT_BLUDGEON}));
  SetProp(P_XP, QueryProp(P_XP)+2500*100);
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 150+random(20));
  SetProp(P_ALIGN, -650);
  SetProp(P_RESISTANCE_STRENGTHS, ([
    DT_ACID       :-0.3,     DT_POISON     :0.4,      DT_TERROR     :-0.3,
    DT_HOLY       :0.2,      DT_UNHOLY     :-0.6     ]) );

  SetProp(P_MSGIN, "riecht hier frisches Blut");
  SetProp(P_MSGOUT, "verfolgt eine Blutspur");
  SetProp(P_MMSGIN, "erscheint aus einer Blutwolke");
  SetProp(P_MMSGOUT, "verschwindet in einer Blutlache");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "d3");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  AddInfo(DEFAULT_INFO, "@@blut@@", "schreit: ");

  SetProp(P_DIE_MSG,  " faellt blutueberstroemt zu Boden.\n");
  SetProp(P_KILL_MSG, "Endlich wieder viel Blut fuer mich.");
  SetProp(P_SPELLRATE,50);
  AddSpell(3,250,
    "Der blutruenstige Ork saugt Dein Blut auf.\n",
    "Der blutruenstige Ork saugt @WESSEN Blut auf.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,555,
    "Der blutruenstige Ork zerfetzt Dir die Kehle.\n",
    "Der blutruenstige Ork zerfetzt @WEM die Kehle.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,777,
    "Der blutruenstige Ork reisst Dir fast das Herz heraus.\n",
    "Der blutruenstige Ork reisst @WEM fast das Herz heraus.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(5, ({
    "Blut tropft von den Eckzaehnen des Orks auf den Boden.\n",
    "Der blutruenstige Ork schaut Dich blutgierig an.\n",
    "Der blutruenstige Ork leckt gierig seine Lippen.\n"}) );

  equip(0,1);
  if( !random(10) )
  {
    CLONEME( WEAPON "blutaxt" );
    command("zuecke axt");
  }
}

string blut()
{
  Kill(TP);
  return "Blut! Ich will dein Blut!!!\n";
}

void die(int poisondeath)
{
  WLOG(LOG "blutork", " killt den Blutork.");
  ::die(poisondeath);
}

