// /d/gebirge/feyaria/blut/npc/orkchef.c
// Der Chef der Orks
// 1998-10-19  Feyaria@SilberLand

#include "../def.h"
inherit NPC "std_ork";
inherit "/std/npc/spells";

void create()
{
 
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Rorgraz, der oberste Haeuptling der Orks");
  SetProp(P_LONG, 
    "Rorgraz is der oberste Haeuptling der Orks, vor allem weil er der "
    "staerkste Kaempfer ist. Wenn Du Dir seine maechtigen Muskeln und seine "
    "gewaltigen Hauer anschaust, kannst Du das sofort glauben.");
  SetProp(P_NAME, "Rorgraz");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"ork", "chef", "orkchef", "haeuptling", "rorgraz"}));

  create_default_npc(42);
  SetProp(P_HANDS, ({" mit stahlharten Klauen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_SIZE, 166);
  SetProp(P_XP, QueryProp(P_XP)+5000*100);
  SetProp(P_ALIGN, -400);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Der Ork zerquetscht @WEN in seiner Faust.\n" }) );

  SetProp(P_SPELLRATE,88);
  AddSpell(1,777,
    "Rorgraz erwuergt Dich.\n",
    "Rorgraz erwuergt @WEN.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1,444, DS_DEAF,
    "Rorgraz bruellt Dich an.\n",
    "Rorgraz bruellt @WEN an.\n");
  AddDefaultSpell(1,555, DS_DISARM,
    "Rorgraz landet einen kritischen Treffer auf Deinem Waffenarm.\n",
    "Rorgraz landet einen kritischen Treffer auf @WESSEN Waffenarm.\n");
  AddDefaultSpell(1,333, DS_MASS_DEAF,
    "Rorgraz bruellt so extrem laut, dass sich Deine Ohren verschlagen.\n",
    "Rorgraz bruellt so extrem laut, dass sich Deine Ohren verschlagen.\n");
  AddDefaultSpell(1,350, DS_PARALYZE,
    "Mit einem maechtigen Faustschlag schlaegt Rorgraz Dich bewustlos.\n",
    "Mit einem maechtigen Faustschlag schlaegt Rorgraz @WEN bewustlos.\n", 3);
  AddDefaultSpell(1,333, DS_MASS_FEAR,
    "Rorgraz erschreckt Dich mit einer fuerchterlichen Grimasse.\n",
    "Rorgraz erschreckt Dich mit einer fuerchterlichen Grimasse.\n");

  SetChats(3, ({
    "Rorgraz sagt: Ich bin der einzig legitime Nachfahre von Tolgraz "
      "Blutfaust.\n",  
    "Rorgraz schaut Dich veraechtlich an.\n",  
    "Rorgraz lacht Dich aus.\n",
    "Rorgraz prahlt: Wir Orks sind die besten Kaempfer von allen Rassen.\n", 
    "Rorgraz sagt: Ich bin der staerkste Ork!\n"}) );

  equip(0,1);
  CLONEME( WEAPON "donnerschlag" );
  command("zuecke donnerschlag");

}

void die(int poisondeath)
{
  WLOG(LOG "rorgraz", " killt Rorgraz.");
  ::die(poisondeath);
}

