// /d/huegelland/feyaria/orks/npc/orksoldat.c   
// Ein Ork aus Kharokurg 
// 1998-10-10  Feyaria@SilberLand

#include "../def.h"
#include <mnpc.h>

inherit NPC "std_ork";

void create()
{
  string was, was_id;
  int rand;
  if (!is_clone(this_object())) return;
  ::create();

  rand=random(4);
  was=({"Orksoldat", "Orkwaechter", "Orkkaempfer", "Orkkrieger"})[rand];
  was_id=({"soldat", "waechter", "kaempfer", "krieger"})[rand];
  SetProp(P_SHORT, "Ein "+was );
  SetProp(P_LONG, 
    "Der "+was+" sieht sich hier nach dem rechten um. Misstrauisch laesst "
    "er staendig seinen Blick in der Umgebung schweifen und starrt Dich dabei "
    "immer unangehem lange an. Wie jeder Ork hat auch dieser "+CAP(was)+
    " einen dicken schwarzen Pelz und zwei grosse Hauer im Gebiss. "
    "Er ist sehr gut fuer einen Kampf ausgeruestet.");
  SetProp(P_NAME, was);
  SetProp(P_GENDER, MALE);
  AddId( ({lower_case(was), was_id, "Schwertkaempfer", "Speerkaempfer", 
    "Axtkaempfer", "Keulenkaempfer", "Peitschenkaempfer", "Kettenkaempfer"}) );
  SetProp(P_SIZE, 155+random(20) );
  
  create_default_npc(20+random(5));
  SetProp(P_HANDS, ({" mit Orkkrallen",QueryProp(P_HANDS)[1],DT_RIP}));

  SetProp(P_SPELLRATE, 30);
  AddSpell(2,200,
    Name(WER,1)+ " gibt Dir einen maechtigen Faustschlag.\n",
    Name(WER,1)+ " gibt @WEN einen maechtigen Faustschlag.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    Name(WER,1)+ " wuergt Dich.\n",
    Name(WER,1)+ " wuergt @WEN.\n",
    DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    Name(WER,1)+" mustert Dich misstrauisch.\n",
    Name(WER,1)+" schaut wachsam durch die Gegend.\n",
    Name(WER,1)+" startt Dich lange an.\n",
    Name(WER,1)+" grunzt sehr laut.\n",
    Name(WER,1)+" rempelt Dich sehr hart an.\n",
    Name(WER,1)+" zeigt Dir seine scharfen Zaehne.\n",
    Name(WER,1)+" schaut gierig auf Deine Ausruestung.\n",
    Name(WER,1)+" schaut Dich geringschaetzend an.\n",
    Name(WER,1)+" lacht Dich aus.\n",
    Name(WER,1)+" knurrt Dich veraergert an.\n",
    Name(WER,1)+" grinst Dich extrem boesartig an.\n"}) );

  equip(1,1);
}

