// Ein daemonischer Ork 
// 08-08-1996  Feyaria@AnderLand
// 1997-04-11  Feyaria@SilberLand
// 1998-10-10  angepasst

#include "../def.h"
#include <mnpc.h>
inherit NPC "std_ork";

void create()
{
 
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein daemonischer Ork");
  SetProp(P_LONG, 
    "Dieser Ork sieht richtig furchterregend aus. Sein Gesicht ist zu einer "
    "daemonischen Fratze verzerrt und aus seinem Ruecken beginnen kleine "
    "Hoerner zu wachsen. Sein schwarzer Pelz hat sich zu einem schuppigen "
    "Panzer verwandelt und aus seinen Haenden sind schreckliche Klauen "
    "geworden. Wenn Dir Dein Leben lieb ist, solltest Du jetzt schnell "
    "abhauen.");
  SetProp(P_INFO, 
    "Du kannst eine daemonische Presenz in diesem Ork feststellen. "
    "Er hat wohl einen Packt mit einem Erzdaemon geschlossen und verwandelt "
    "sich jetzt langsam selber in einen Daemon.");
  SetProp(P_NAME, "Ork");
  set_living_name("daemonork");
  SetProp(P_NAME_ADJ, "daemonisch");
  SetProp(P_GENDER, MALE);
  AddId(({"ork", "daemonischer ork", "daemonenork", "daemonork"}));
  SetProp(P_SMELL, "Der daemonische Ork stinkt nach Pest und Schwefel.\n");
  AddDetail( ({"gesicht", "fratze"}),
    "Das Gesicht des Orks ist zu einer daemonischen Fratze verzerrt. Er wird "
    "sich wohl bald selber in einen Daemon verwandlen.");
  AddDetail( ({"ruecken", "hoerner", "horn"}),
    "Aus dem Ruecken des Orks wachsen kleine Hoerner heraus. Er wird sich "
    "wohl bald selber in einen Daemon verwandlen.");
  AddDetail( ({"pelz", "panzer"}),
    "Der Pelz des Orks ist zu einem schuppigen Panzer geworden. Er wird sich "
    "wohl bald selber in einen Daemon verwandlen.");
  AddDetail( ({"haende", "hand", "klauen"}),
    "Die Haende des Orks sind zu schrecklichen Klauen geworden. Er wird sich "
    "wohl bald selber in einen Daemon verwandlen.");

  create_default_npc(38);
  SetProp(P_HANDS, ({" mit seinen schrecklichen Klauen",
      QueryProp(P_HANDS)[1]+100,DT_RIP}));
  SetProp(P_RACE, "Ork");
  SetProp(P_SIZE, 150+random(20));
  SetProp(P_ALIGN, -900);
  SetProp(P_RESISTANCE_STRENGTHS, ([
    DT_SLASH      :-0.3,     DT_BLUDGEON   :-0.3,     DT_PIERCE     :-0.2,
    DT_FIRE       :-0.1,     DT_COLD       :-0.4,     DT_WATER      :0.3,
    DT_ACID       :-0.2,     DT_POISON     :-0.3,     DT_TERROR     :-0.8,
    DT_HOLY       :0.3,      DT_UNHOLY     :-0.7,     DT_MAGIC      :-0.2]) );

  SetProp(P_MSGIN, "verbreitet hier daemonischen Gestank");
  SetProp(P_MSGOUT, "verbreitet seinen Gestank");
  SetProp(P_MMSGIN, "erscheint dirket aus den Niederhoellen");
  SetProp(P_MMSGOUT, "verschwindet in die Niederhoellen");
  SetProp(P_MNPC_AREA, (ROOM) );
  SetProp(P_MNPC_WAIT, ({ 10, 30, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "c1");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS+ MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Der Ork opfert @WEN dem Erzdaemon.\n" }) );
  AddInfo(DEFAULT_INFO, ({
    "schreit: Der Erzdaemon wird euch alle vernichten!\n",
    "schaut Dich hasserfuellt an.\n",
    "zeigt Dir seine fuerchterlichen Krallen.\n"}) );

  SetProp(P_KILL_MSG, "Endlich wieder ein Opfer fuer den Erzdaemon.");
  SetProp(P_SPELLRATE,66);
  AddSpell(4,222,
    "Der daemonische Ork quaelt Dich mit niederhoellischen Temperaturen.\n",
    "Der daemonische Ork qauelt @WEN mit niederhoellischen Temperaturen.\n",
     DT_COLD,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,444,
    "Der daemonische Ork bruellt Dich aus Leibeskraeften an.\n",
    "Der daemonische Ork bruellt @WEN aus Leibeskraeften an.\n",
     DT_SOUND,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,888,
    "Der daemonische Ork erschreckt Dich zu Tode.\n",
    "Der daemonische Ork erschreckt @WEN zu Tode.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

  SetChats(5, ({
    "Der daemonische Ork versucht Dich vom Goetterglauben abzubringen.\n",
    "Der daemonische Ork beschwoert die Macht des Erzdaemonen.\n",
    "Der daemonische Ork grinst daemonisch.\n",
    "Die Hoerner im Ruecken des Orks wachsen ein Stueckchen.\n"}) );

  equip(0,1);
  if( !random(4) ) CLONEME( WEAPON "blutaxt");
  else             CLONEME( WEAPON "kriegsaxt");
  command("zuecke axt");

}

void die(int poisondeath)
{
  WLOG(LOG "daemonork", " killt den Daemonork.");
  ::die(poisondeath);
}

