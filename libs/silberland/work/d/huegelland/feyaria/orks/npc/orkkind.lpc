// Ein Ork aus Kharokurg 
// 1998-10-10  Feyaria@SilberLand

#include "../def.h"
#include <mnpc.h>

inherit NPC "std_ork";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Orkkind");
  SetProp(P_LONG,
    "Ein Orkkind spielt hier und wird von den aelteren Orks kaum beachtet. "
    "Obwohl es noch recht klein ist, hat es auch schon die langen Eckzaehne "
    "und den dichten, schwarzen Pelz der grossen Orks.");
  SetProp(P_NAME, "Orkkind");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"orkkind", "kind"}) );

  create_default_npc(4+random(5));
  SetProp(P_HANDS, ({" mit kleinen Orkkrallen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_WIMPY, QueryProp(P_MAX_HP)/2);
  SetProp(P_ALIGN, 100+random(100) );
  SetProp(P_AGGRESSIVE, 0);
  
  SetChats(3, ({
    "Das Orkkind spielt.\n",
    "Das Orkkind schaut Dich an und kichert.\n",
    "Das Orkkind grinst Dich an.\n"}) );
  SetAttackChats(10, ({
    "Das Orkkind bruellt: MAMI!!!!\n",
    "Das Orkkind faengt zu weinen an.\n",
    "Das Orkkind versucht zu fluechten.\n"}) );
  
  equip(1,0);
}

