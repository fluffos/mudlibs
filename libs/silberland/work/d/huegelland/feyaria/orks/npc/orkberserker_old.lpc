// /d/huegelland/feyaria/orks/npc/orkberserker.c   
// Ein Ork aus Kharokurg 
// 1998-10-10  Feyaria@SilberLand

#include "../def.h"
#include <mnpc.h>

inherit NPC "std_ork";

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Orkberserker" );
  SetProp(P_NAME, "Orkberserker");
  SetProp(P_GENDER, MALE);
  SetProp(P_LONG, 
    Name(WER,1)+" sieht wie ein sehr erfahrener Kaempfer aus. Mit "
    "ueberlegenem Blick mustert er seine Umgebung, und obwohl er Dich kaum "
    "zu beachten scheint, wirft er Dir doch ab und zu einen boesartigen Blick "
    "zu. Seine gewaltigen Hauer sind zusaetzlich noch angefeilt, sodass ein "
    "Biss dieses Orkes toedlich sein kann."); 
  AddId( ({"orkberserker", "berserker"}) );
  AddAdjective( ({"orkisch", "orkischen", "orkischer"}) );
  SetProp(P_SIZE, 155+random(25) );
  
  create_default_npc(35);
  SetProp(P_XP, QueryProp(P_XP)*2);
  SetProp(P_HANDS, ({" mit Orkkrallen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_GUILD, "berserker");
  SetProp(P_GUILD_LEVEL, 6);
  call_other("/gilden/berserker","learn_berserker_skills", 6000, 6000);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" zerstoert @WEN voller Berserkerwut!\n" }) );

  SetChats(3, ({
    Name(WER,1)+" schaut Dich misstrauisch an.\n",
    Name(WER,1)+" grunzt sehr laut.\n",
    Name(WER,1)+" wuetet wie ein Wilder und schuechtert Dich ein.\n",
    Name(WER,1)+" schaetz Dich erfolgreich ein.\n",
    Name(WER,1)+" prueft die Schaerfe seiner Axt.\n",
    Name(WER,1)+" schaut Dich geringschaetzend an.\n",
    Name(WER,1)+" spannt seine gewaltigen Muskeln an.\n",
    Name(WER,1)+" knurrt Dich veraergert an.\n",
    Name(WER,1)+" schaut Dich blutduerstig an.\n"}) );

  if( !random(10) ) CLONEME( WEAPON "blutaxt");
  else CLONEME( WEAPON "kriegsaxt");
  command("zuecke axt");
  equip(0,1);
  if( !present("helm", TO) )
    CLONEME( ARMOUR "hoernerhelm");
  if( !present("stiefel", TO) && !present("schuhe", TO) )
    CLONEME( "/p/armour/boots/eisenschuhe");
  CLONEME( "/gilden/berserker/obj/stirnband" );
  command_me("trage alles");
}

void Attack(object enemy)
{
  if( !QueryProp(P_TMP_DEFEND_HOOK) && random(2) )
    command_me("eisenhaut");
  else if( !present("\nberserker_willenskraft",TO) && random(2) ) 
    command_me("willenskraft");
  else if( !QueryProp(P_PREFERED_ENEMY) && random(2) && 
      sizeof(PresentEnemies()) > 1 && interactive(enemy) ) 
    command_me("augeinauge");
  else if( random(10)<3 && !enemy->QueryProp(P_DEAF) )
    command_me("kampfschrei");
  else switch( 100*enemy->QueryProp(P_SIZE)/QueryProp(P_SIZE))
  {
    case 0..30: command_me("zertreten"); break;
    case 80..300: if( random(3) ) command_me("kopfstoss"); 
                  else command_me("rammen"); break;
    default: command_me("rammen"); break;
  }
  if( enemy ) ::Attack(enemy);  
}
