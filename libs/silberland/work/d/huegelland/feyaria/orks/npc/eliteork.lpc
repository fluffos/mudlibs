// /d/huegelland/feyaria/orks/npc/eliteork.c   
// Ein Ork aus Kharokurg 
// 1998-10-10  Feyaria@SilberLand

#include "../def.h"
#include <mnpc.h>

inherit NPC "std_ork";

void create()
{
  string was, nam;
  if (!is_clone(this_object())) return;
  ::create();

  switch(random(3) )
  {
    case 0: was=nam="Orkveteran"; AddId("veteran"); break;
    case 1: was=nam="Orkhauptmann"; AddId("hauptmann"); break;
    case 2: was="orkischer Elitesoldat"; nam="Elitesoldat";
            AddId("soldat"); SetProp(P_NAME_ADJ, "orkisch");
            break;
  }
  SetProp(P_SHORT, "Ein "+was );
  SetProp(P_NAME, nam);
  SetProp(P_GENDER, MALE);
  SetProp(P_LONG, 
    Name(WER,1)+" sieht wie ein sehr erfahrener Kaempfer aus. Mit "
    "ueberlegenem Blick mustert er seine Umgebung, und obwohl er Dich kaum "
    "zu beachten scheint, wirft er Dir doch ab und zu einen boesartigen Blick "
    "zu. Seine gewaltigen Hauer sind zusaetzlich noch angefeilt, sodass ein "
    "Biss dieses Orkes toedlich sein kann."); 
  AddId( ({lower_case(nam), "eliteork", "Schwertexperte", "Speerexperte", 
    "Axtexperte", "Keulenexperte", "Peitschenexperte", "Kettenexperte"}) );
  AddAdjective( ({"orkisch", "orkischen", "orkischer"}) );
  SetProp(P_SIZE, 155+random(20) );
  
  create_default_npc(25+random(5));
  SetProp(P_HANDS, ({" mit Orkkrallen",QueryProp(P_HANDS)[1],DT_RIP}));

  SetProp(P_SPELLRATE, 50);
  AddSpell(2,234,
    Name(WER,1)+ " gibt Dir einen maechtigen Faustschlag.\n",
    Name(WER,1)+ " gibt @WEN einen maechtigen Faustschlag.\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,345,
    Name(WER,1)+ " wuergt Dich.\n",
    Name(WER,1)+ " wuergt @WEN.\n",
    DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    Name(WER,1)+" mustert Dich misstrauisch.\n",
    Name(WER,1)+" schaut wachsam durch die Gegend.\n",
    Name(WER,1)+" starrt Dich lange und intensiv an.\n",
    Name(WER,1)+" grunzt sehr laut.\n",
    Name(WER,1)+" schaut Dich geringschaetzend an.\n",
    Name(WER,1)+" zeigt Dir seine angespitzen Zaehne.\n",
    Name(WER,1)+" prueft seine Ausruestung.\n",
    Name(WER,1)+" entspannt seine gewaltigen Muskeln.\n",
    Name(WER,1)+" knurrt Dich veraergert an.\n",
    Name(WER,1)+" fuehlt sich Dir ueberlegen.\n",
    Name(WER,1)+" grinst Dich extrem boesartig an.\n"}) );

  equip(1,1);
}

