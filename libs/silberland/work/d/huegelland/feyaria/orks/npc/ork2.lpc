// Ein Ork aus Kharokurg 
// 1998-10-10  Feyaria@SilberLand

#include "../def.h"
#include <mnpc.h>

inherit NPC "std_ork";

void create()
{
  string *adj; 
  int i,j;

  if (!is_clone(this_object())) return;
  ::create();

  adj=({"gross", "gemein", "dick", "breit", "fett", "hinterhaeltig"});
  i=random(sizeof(adj));  
  if( random(100) > 50 )
  {
    SetProp(P_GENDER, MALE);
    SetProp(P_SIZE, 155+random(15) );
    SetProp(P_NAME, "Ork");
    SetProp(P_NAME_ADJ, adj[i] ) ;
    SetProp(P_SHORT, "Ein "+adj[i]+"er Ork");
    AddAdjective( ({adj[i], adj[i]+"er", adj[i]+"en"}) );
    j=3;
  }
  else
  {
    SetProp(P_GENDER, FEMALE);
    SetProp(P_SIZE, 150+random(10) );
    SetProp(P_NAME, "Orkin");
    SetProp(P_NAME_ADJ, adj[i]);
    SetProp(P_SHORT, "Eine "+adj[i]+"e Orkin");
    AddId( ({"orkin"}) );
    AddAdjective( ({adj[i], adj[i]+"e"}) );
    j=0;
  }
  SetProp(P_LONG, 
    Name(WER,0)+ " schaut Dich misstrauisch an. "+CAP(QueryPronoun(WER))+ 
    " hat wie jeder Ork einen dicken schwarzen Pelz und zwei grosse Hauer im "
    "Gebiss.");
  create_default_npc(13+j+random(4));
  SetProp(P_HANDS, ({" mit Orkkrallen",QueryProp(P_HANDS)[1],DT_RIP}));

  SetChats(3, ({
    Name(WER,1)+" grunzt laut.\n",
    Name(WER,1)+" rempelt Dich hart an.\n",
    Name(WER,1)+" zeigt Dir "+QueryPossPronoun(MALE,WEN,PLURAL)+
      " scharfen Zaehne.\n",
    Name(WER,1)+" schaut gierig auf Deine Ausruestung.\n",
    Name(WER,1)+" grinst Dich boesartig an.\n"}) );

  equip(1,1);
}

