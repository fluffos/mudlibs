// /d/gebirge/feyaria/blut/npc/orkchef.c
// Der Chef der Orks
// 1998-10-19  Feyaria@SilberLand

#include "../def.h"
inherit NPC "std_ork";
inherit "/std/npc/spells";

string stirnband();

void create()
{
 
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Rorgraz, der oberste Haeuptling der Orks");
  SetProp(P_LONG, 
    "Rorgraz is der oberste Haeuptling der Orks, vor allem weil er der "
    "staerkste Kaempfer ist. Wenn Du Dir seine maechtigen Muskeln und seine "
    "gewaltigen Hauer anschaust, kannst Du das sofort glauben. Scheinbar hat "
    "er seine Herrschaft jetzt auch ueber die Berserkergilde ausgebreitet.");
  SetProp(P_NAME, "Rorgraz");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"ork", "chef", "orkchef", "haeuptling", "rorgraz"}));

  create_default_npc(42);
  SetProp(P_HANDS, ({" mit stahlharten Klauen",QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_SIZE, 166);
  SetProp(P_XP, QueryProp(P_XP)+5000*100);
  SetProp(P_ALIGN, -400);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_GUILD, "berserker");
  SetProp(P_GUILD_LEVEL, 12);
  call_other("/gilden/berserker","learn_berserker_skills", 10000, 10000);
  SetProp(P_MNPC_DEFAULTROOM, "/gilden/berserker" );

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Der Ork zerquetscht @WEN in seiner Faust.\n" }) );

  SetProp(P_SPELLRATE,88);
  AddSpell(1,777,
    "Rorgraz erwuergt Dich.\n",
    "Rorgraz erwuergt @WEN.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(1,444, DS_DEAF,
    "Rorgraz bruellt Dich an.\n",
    "Rorgraz bruellt @WEN an.\n");
  AddDefaultSpell(1,555, DS_DISARM,
    "Rorgraz landet einen kritischen Treffer auf Deinem Waffenarm.\n",
    "Rorgraz landet einen kritischen Treffer auf @WESSEN Waffenarm.\n");
  AddDefaultSpell(1,333, DS_MASS_DEAF,
    "Rorgraz bruellt so extrem laut, dass sich Deine Ohren verschlagen.\n",
    "Rorgraz bruellt so extrem laut, dass sich Deine Ohren verschlagen.\n");
  AddDefaultSpell(1,350, DS_PARALYZE,
    "Mit einem maechtigen Faustschlag schlaegt Rorgraz Dich bewustlos.\n",
    "Mit einem maechtigen Faustschlag schlaegt Rorgraz @WEN bewustlos.\n", 3);
  AddDefaultSpell(1,333, DS_MASS_FEAR,
    "Rorgraz erschreckt Dich mit einer fuerchterlichen Grimasse.\n",
    "Rorgraz erschreckt Dich mit einer fuerchterlichen Grimasse.\n");

  SetChats(3, ({
    "Rorgraz sagt: Ich bin der einzig legitime Nachfahre von Tolgraz "
      "Blutfaust.\n",  
    "Rorgraz schaut Dich veraechtlich an.\n",  
    "Rorgraz lacht Dich aus.\n",
    "Rorgraz sagt: Ich bin jetzt der Herr ueber die Berserker!\n",
    "Rorgraz prahlt: Wir Orks sind die besten Kaempfer von allen Rassen.\n", 
    "Rorgraz sagt: Ich bin der staerkste Ork!\n",
    "Rorgraz sagt: Die Berserkergilde ist die beste aller Gilden!\n",
    "Rorgraz massiert seinen gewaltigen Oberarm.\n",
    "Rorgraz sagt: Ab nun werden nur mehr Orks Berserker!\n",
    "Rorgraz schaut grimmig durch die Gegend.\n",
    "Rorgraz wuetet herum und schuechtert Dich gewaltig ein.\n", 
    "Rorgraz spannt seine Muskeln an.\n",
    "Rorgraz prueft seine Ausruestung.\n",
    "Rorgraz knirscht mit den Zaehnen.\n",
    "Rorgraz spannt seinen gewaltigen Bizeps an.\n",
    "Rorgraz schaut Dich veraechtlich an.\n"}) );

  AddInfo( DEFAULT_INFO, ({
    "faucht Dich an.\n",
    "grunzt Dich nur veraergert an.\n",
    "sagt: Wir Orks sind die besten Krieger!\n",
    "sagt: Die Berserkergilde gehoert jetzt den Orks!\n"}) );

  AddLibrary( "/gilden/berserker/npc/kronang.lib", 1); 

  AddInfo( ({"rorgraz", "haeuptling"}),
      "Ich bin der Hauptling der Orks!", "sagt: ");
  AddInfo( ({"kronang", "duell"}),
      "Ich habe Kronang im Duell besiegt und nun bin ich Herr ueber die Berserker!",
      "sagt: ");
  AddInfo( ({"skills","faehigkeiten", "fertigkeiten"}), 
      "Du bist erbaermlich als Berserker, kein Wunder, das Du ja kein Ork bist!", 
      "sagt: ");
  AddInfo( ({"stirnband", "blutrotes stirnband"}), #'stirnband);

  equip(0,1);
  CLONEME( WEAPON "donnerschlag" );
  command("zuecke donnerschlag");
  CLONEME( "/gilden/berserker/obj/stirnband" );
  command_me("trage alles");

}

void die(int poisondeath)
{
  WLOG(LOG "rorgraz", " killt Rorgraz.");
  ::die(poisondeath);
}


string stirnband()
{
  if( TP->QueryProp(P_GUILD) == "berserker" )
  {
    if(! present("\nberserker_stirnband", TP) )
    {
      CLONE( ARMOUR "stirnband", TP );
      return "sagt: Du Versager hast Dein Stirnband verloren?\n"
        "Rorgraz sagt: Hier hast Du ein neues, aber wenn das noch einmal passiert,\n"
        "Rorgraz sagt: dann reiss ich Dich in Stuecke!\n";
    }
    return "ermahnt Dich: Pass immer gut auf Dein Stirnband auf!\n";
  }
  return "sagt: Nur als Berserker versteht man den Wert dieses Stirnbandes!\n";
}
