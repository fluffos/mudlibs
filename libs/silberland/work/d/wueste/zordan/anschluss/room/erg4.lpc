
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

string niesen();

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einem heissen Gebirgspfad" );
  SetProp( P_INT_LONG,
    "Der schmale Pfad ist hier relativ breit und das Gehen bereitet Dir keine "
    "grossen Anstrengungen mehr. Die Felswaende sind hier schon deutlich "
    "flacher als im Norden, aber ein Besteigen ist immer noch voellig "
    "aussichtslos." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 31+random(5), 
                           ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "pfad" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "gehen","gehe" }),
    "Wenn Du nicht gerade springst, rennst oder schlaefst, ist die Chance "
    "relativ gross, dass Du hier entlang gehst. Das Gehen bereitet Dir hier "
    "auch keine grossen Anstrengungen mehr.");

  AddDetail( ({ "anstrengung","anstrengungen" }),
    "Die brauchst Du hier zum Gehen nicht mehr wirklich.");

  AddDetail( ({ "felswaende","waende" }),
    "Nicht so hohe Felswaende wie im Norden, aber immer noch zu hoch zum "
    "Besteigen. Irgendwie hast Du bei dieser Hitze auch gar keine Lust dazu!");

  AddDetail( ({ "norden" }),
    "Dort sind haushohe Felswaende und versperren Dir den Weg.");

  AddDetail( ({ "weg" }),
    "Der geht von Westen nach Suedosten und ist recht sandig.");

  AddDetail( ({ "sand" }),
    "Gelb.");

  AddDetail( ({ "hitze" }),
    "Dir ist es hier schon viel zu warm. Im Suedosten wird es aber immer "
    "schlimmer werden, denn dort kannst Du schon die ersten Anzeichen der "
    "offenen Wueste erkennen.");

  AddDetail( ({ "anzeichen","zeichen" }),
    "Warm, gelb, heiss, sandig, unangenehm, toedlich, langweilig.");

  AddDetail( ({ "lust" }),
    "Solltest Du die Lust doch verspueren muss man Dich leider enttaeuschen. "
    "Denn hier kannst Du nicht auf die Felswaende klettern!");

  AddDetail( ({ "besteigen","steigen" }),
    "Du kannst hier keine Felswaende besteigen. Vielleicht geht es ja im "
    "Westen oder Suedosten besser?");

  AddDetail( ({ "boden" }),
    "Der Boden wird nach Suedosten hin immer sandiger.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist blau und die Sonne scheint.");

  AddDetail( ({ "sonne" }),
    "Die Sonne verbrennt Dich fast.");

  AddDetail( ({ "chance" }),
    "Die ist schon recht gross. Jedenfalls in diesem Fall.");

  AddDetail( ({ "fall","faelle" }),
    "In anderen Faellen muss die Chance nicht so gross sein.");

  AddDetail( ({ "wueste" }),
    "Du bist Dir ziemlich sicher, dass die offene Wueste im Suedosten von "
    "hier aus beginnt. Oder sollte das Gebirge rings um Dich herum schon "
    "dazu gehoeren?");

  AddDetail( ({ "gebirge","tibesti","tibesti-gebirge","richtungen","richtung" }),
    "Das Tibesti-Gebirge ragt in alle Richtungen um Dich gen Himmel.");

  AddSound( DEFAULT_SOUND,
    "Der Wind pfeift den Pfad entlang.");

  AddSound( ({ "wind","pfad" }),
    "Es ist schon fast unangenehm laut hier.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht sandig.");

  AddSmell( ({ "sand" }), #'niesen);

  AddItem( OBJ "stein", REFRESH_REMOVE);

  AddExit( "westen",    "./erg3" );
  AddExit( "suedosten", "./erg5" );
}

string niesen() {
  call_out("niesen2",2,TP);
  return "Du schnupperst am Sand. Ja, es ist tatsaechlich Sand!\n";
}

niesen2() {
  TP->command_me("niese");
}
