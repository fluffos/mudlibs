
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einem kleinen Vorsprung" );
  SetProp( P_INT_LONG,
    "Du stehst stolz auf dem kleinen Vorsprung ueber dem Pfad zwischen "
    "Erg und der offenen Wueste. Von hier aus hast Du einen tollen Ausblick. "
    "Allerdings ist es hier oben noch viel waermer als unten.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40+random(5), 
                           ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "felsvorsprung","vorsprung" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "erg" }),
    "Du kannst Reste von Erg im Norden erkennen. Ein wenig Rauch steigt auf.");

  AddDetail( ({ "reste","rest" }),
    "Um mehr zu sehen, muesstest Du schon naeher hingehen.");

  AddDetail( ({ "rauch" }),
    "Der Rauch kann nur aus der Kneipe kommen.");

  AddDetail( ({ "kneipe" }),
    "In der Kneipe gibt es bestimmt gut zu essen und zu trinken.");

  AddDetail( ({ "wueste","offene wueste" }),
    "Die Wueste erstreckt sich im Osten. Sehr eingeschuechtert schaust "
    "Du eine Weile, kannst aber dennoch nichts ja rein gar nichts lebendiges "
    "erkennen. Nur Sand soweit das Auge reicht!");

  AddDetail( ({ "weile","minute","minuten" }),
    "Jedenfalls ein paar Minuten lang hast Du geschaut.");

  AddDetail( ({ "ausblick","blick" }),
    "Der Ausblick von hier ist ueberwaeltigend.");

  AddDetail( ({ "boden" }),
    "Du stehst auf einem harten Felsvorsprung.");

  AddDetail( ({ "fels" }),
    "Stabil genug, Dein Gewicht eine ganze Zeit lang zu tragen.");

  AddDetail( ({ "gewicht","waage" }),
    "Eine Waage gibt es in Midas. Aber Du findest, dass es den Aufwand "
    "nicht wert waere. ;)");

  AddDetail( ({ "midas" }),
    "Midas liegt viel weiter im Westen.");

  AddDetail( ({ "aufwand" }),
    "Der waere nun wirklich VIEL zu hoch.");

  AddDetail( ({ "himmel" }),
    "Die Sonne brennt Dir auf den Kopf und Dir wird schon ganz schummrig.");

  AddDetail( ({ "kopf" }),
    "Den kannst Du leider nicht erkennen, nur erfuehlen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne strahlt hier immer heisser auf Dich herab.");

  AddDetail( ({ "sand" }),
    "Der Sand strahlt gelb, allerdings ist das Bild doch recht verschommen.");

  AddDetail( ({ "bild" }),
    "Durch die grosse Hitze siehst Du von der Wueste alles nur verschwommen.");

  AddSpecialDetail( ({ "pfad" }), "pfadstr");

  AddSound( DEFAULT_SOUND,
    "Es ist kaum etwas zu hoeren.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht hier sehr angenehm.");

  AddItem( NPC "geier", REFRESH_DESTRUCT);

  AddExit( "runter",    "./erg3" );
}

string pfadstr() {
  object ob;
  
  call_other( ROOM "erg3", "???");
  return ROOM "erg3"->int_long(TP,TP,0);
}
