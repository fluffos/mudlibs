
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einem heissen Gebirgspfad" );
  SetProp( P_INT_LONG,
    "Der sehr schmale Pfad macht hier einen Knick von nordoestlicher in "
    "suedoestliche Richtung. Er faellt nach Suedosten hin etwas ab und "
    "ist sehr felsig. Du solltest Dich hier nicht zu schnell bewegen, sonst "
    "kratzt Du Dich womoeglich noch an den scharfen Felswaenden!" );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 29+random(5), 
                           ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "pfad" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "knick" }),
    "Der Pfad macht hier eine scharfe Links- oder Rechtskurve, je nachdem "
    "aus welcher Richtung Du gekommen bist.");

  AddDetail( ({ "kurve" }),
    "Welche Kurve meinst Du?");

  AddDetail( ({ "linkskurve" }),
    "Wenn Du aus dem Norden gekommen bist, dann ist diese Kurve fuer "
    "Dich eine Linkskurve.");

  AddDetail( ({ "rechtskurve" }),
    "Wenn Du aus dem Sueden gekommen bist, dann ist diese Kurve fuer "
    "Dich eine Rechtskurve.");

  AddDetail( ({ "fels","felsen" }),
    "Sehr scharfe Felsen machen es hier fast unmoeglich, schnell "
    "zu gehen!");

  AddDetail( ({ "felswaende","waende" }),
    "Steil tuermen sich die Felswaende neben Dir gen Himmel auf. Du solltest "
    "hier nicht zu schnell gehen, sonst schneidest Du Dich glatt noch an "
    "den scharfen Kanten!!");

  AddDetail( ({ "kanten" }),
    "Scharfe Kanten ragen bis in die Mitte des Pfades. Sei bloss vorsichtig!");

  AddDetail( ({ "kante" }),
    "Eine winzige Kante kannst Du nicht finden.");

  AddDetail( ({ "boden" }),
    "Auf dem Boden ist ein wenig Blut zu sehen!");

  AddDetail( ({ "blut" }),
    "Hier ist wohl jemand einfach zu schnell gegangen und hat sich an "
    "den scharfen Kanten seine Beine aufgeschlitzt!");

  AddDetail( ({ "beine" }),
    "Deine Beine sind noch da wo sie hingehoeren! ;)");

  AddDetail( ({ "himmel" }),
    "Die Bergspitzen gehen geradewegs in den blauen Himmel ueber.");

  AddDetail( ({ "bergspitzen","spitzen" }),
    "Die sind sehr weit ueber Dir und treffen mit dem Himmel zusammen. Du "
    "wist sie aber wohl niemals naeher betrachten koennen.");

  AddDetail( ({ "sonne" }),
    "Die Sonne scheint sehr heiss vom Himmel herunter!");

  AddDetail( ({ "mitte" }),
    "Die Mitte des Pfades ist genau dort, wo Du stehst.");

  AddSound( DEFAULT_SOUND,
    "Der Wind ist hier sehr laut.");

  AddSound( ({ "wind" }),
    "Der Wind pfeift Dir laut um die Ohren.");

  AddSound( ({ "ohren","ohr" }),
    "Mit Deinen Ohren kannst Du den Wind hoeren. Erstaunlich, gell?");

  AddSmell( DEFAULT_SMELL,
    "Es riecht nach Sand!?!");

  AddSmell( ({ "sand" }),
    "Tatsaechlich! Keiner zu sehen, aber deutlich zu riechen!");

  AddItem( NPC "steinbock", REFRESH_DESTRUCT);

  AddExit( "nordosten",  ([ EX_DEST: "./erg1",
                            EX_TESTFUNC: "testezeit",
                            EX_PLMSG: "Du schlaengelst Dich auf dem schmalen "
                                      "Pfad weiter nach Nordosten."
                          ]) );

  AddExit( "suedosten",  ([ EX_DEST: "./erg3",
                            EX_TESTFUNC: "testezeit",
                            EX_PLMSG: "Du schlaengelst Dich auf dem schmalen "
                                      "Pfad weiter nach Suedosten."
                          ]) );
}

int testezeit() {
  if(interactive(TP) && (time()-TP->QueryProp(P_LAST_MOVE) < 2)) {
    write(BS(
      "Ueberhastet schneidest Du Dich an einem der scharfen Felsbrocken!"));
    say(BS(
      CAP_TPN+" schneidet sich an einem der scharfen Felsbrocken!"),({ TP }));
    TP->AddHp(-(10+random(20)));
  }
  return 1;
}
