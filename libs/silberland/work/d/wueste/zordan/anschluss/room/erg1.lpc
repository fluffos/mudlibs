
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einem heissen Gebirgspfad" );
  SetProp( P_INT_LONG,
    "Du stehst auf einem kleinen Pfad inmitten des Tibesti-Gebirges. Westlich "
    "und oestlich von Dir ragen unueberwindlich steile Felswaende hinauf. Der "
    "Pfad windet sich nach Norden in eine flachere Gegend, nach Suedwesten "
    "geht er, immer schmaeler werdend, tiefer in das Gebirge. Es wird Richtung "
    "Sueden immer waermer." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 28+random(5), 
                           ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "pfad" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "tibesti-gebirge","gebirge","tibesti" }),
    "Dieser Pfad fuehrt mitten durch das Tibesti-Gebirge. Nur steile "
    "Felswaende des Gebirges kannst Du hier erkennen, so hoch ist es.");

  AddDetail( ({ "waende","felswaende" }),
    "Die Felswaende ragen unueberwindbar im Westen und Osten von Dir "
    "steil hinauf.");

  AddDetail( ({ "fels" }),
    "Massiver Fels, bei dem sich sogar die Zwerge schwer tun wuerden.");

  AddDetail( ({ "norden","gegend" }),
    "Im Norden liegt eine flachere Gegend.");

  AddDetail( ({ "richtung" }),
    "Der Pfad windet sich mehr in Richtung Sueden als Osten.");

  AddDetail( ({ "himmel" }),
    "Die Sonne steht direkt ueber einer Bergspitze.");

  AddDetail( ({ "spitze","bergspitze" }),
    "Die Bergspitze ist sicher an die 3000 Meter ueber Dir. Die Sonne "
    "scheint darauf aufgespiesst worden zu sein.");

  AddDetail( ({ "meter" }),
    "3000 Meter ist sehr hoch!");

  AddDetail( ({ "boden" }),
    "Kleine Steine und Geroell liegen auf dem Pfad herum. Hier sind noch "
    "nicht viele Lebewesen entlanggekommen.");

  AddDetail( ({ "lebewesen","wesen" }),
    "Hier ist es schon fast zu heiss, als dass hier viele Lebewesen "
    "vorbeikommen wuerden.");

  AddDetail( ({ "steine","stein" }),
    "Kleine Steine saeumen den Pfad.");

  AddDetail( ({ "sonne","gegend" }),
    "Die Sonne erhitzt die Gegend hier schon ziemlich stark.");

  AddDetail( ({ "geroell" }),
    "Einiges an Geroell ist schon die Felswaende runtergekommen. Du solltest "
    "also lieber ein wenig vorsichtig sein!");

  AddSound( DEFAULT_SOUND,
    "Der Wind pfeift aus dem Sueden nach Norden weiter.");

  AddSound( ({ "wind" }),
    "*wusch*");

  AddSmell( DEFAULT_SMELL,
    "Hier riecht es irgendwie *kratz* ja irgendwie sandig.");

  AddSmell( ({ "sand" }),
    "Du kannst ihn zwar nicht sehen, aber deutlich riechen!");

  AddExit( "norden",     "/d/wueste/arthoas/erg/room/aragh/raum45" );
  AddExit( "suedwesten", "./erg2" );
}
