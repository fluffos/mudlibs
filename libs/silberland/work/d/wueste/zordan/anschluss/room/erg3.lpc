
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einem heissen Gebirgspfad" );
  SetProp( P_INT_LONG,
    "Die Sonne brennt sich hier erbarmungslos zwischen den Felswaenden "
    "ihren Weg auf Dein Haupt. Der schmale Pfad scheint sich ein wenig "
    "zu weiten, allerdings bist Du Dir da nicht so ganz sicher. Weiter "
    "im Osten sieht der Pfad jedenfalls noch breiter aus." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30+random(5), 
                           ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "sonne" }),
    "Die Sonne steht hoch ueber Dir, knapp neben den Wipfeln des riesigen "
    "Gebirges, welches Dich umgibt.");

  AddDetail( ({ "wipfel" }),
    "Die Wipfel des Gebirges sind nur noch sehr klein zu erkennen. Ob "
    "Du sie jemals erreichen wuerdest, steht irgendwie ausser Frage.");

  AddDetail( ({ "gebirge" }),
    "Ein riesiges Gebirge umgibt Dich. Doch so langsam weitet sich der Pfad "
    "und die Auslaeufer des Gebirges werden niedriger.");

  AddDetail( ({ "frage" }),
    "Du wirst die Wipfel des Gebirges nie erreichen!");

  AddDetail( ({ "pfad" }),
    "Der Pfad schlaengelt sich von Westen nach Osten weiter. Er wird immer "
    "breiter, je weiter Du nach Osten schaust. Vereinzelt liegt schon "
    "etwas Sand herum und die Temperatur steigt an.");

  AddDetail( ({ "sand" }),
    "Unter Deinen Fuessen sammelt sich an manchen Stellen schon Sand. Das "
    "sind die ersten Anzeichen einer Wueste!");

  AddDetail( ({ "fuesse","fuss" }),
    "Die sind noch dort, wohin sie gehoeren.");

  AddDetail( ({ "richtung","temperatur" }),
    "Richtung Osten wird es immer waermer!");

  AddDetail( ({ "stellen" }),
    "An manchen Stellen sammelt sich schon Sand. Eine faellt Dir besonders "
    "auf!");

  AddDetail( ({ "stelle" }),
    "An dieser Stelle ist wohl mal ein wackerer Abenteurer gestorben, "
    "denn ein tiefer Abdruck ist zu erkennen.");

  AddDetail( ({ "abenteurer" }),
    "Von dem ist inzwischen rein gar nichts mehr uebrig.");

  AddDetail( ({ "abdruck" }),
    "Der Abdruck ist so tief, dass der Abenteurer nur durch einen Sturz "
    "aus grosser Hoehe gestorben sein kann.");

  AddDetail( ({ "sturz" }),
    "Du schaust nach oben und erkennst tatsaechlich einen kleinen Vorsprung.");

  AddDetail( ({ "hoehe" }),
    "Das muss schon sehr sehr hoch gewesen sein.");

  AddDetail( ({ "vorsprung" }),
    "Du bist Dir sicher, dass der Abenteurer von diesem Vorsprung gefallen "
    "sein muss. Mit einem Kletterhaken koenntest Du auch versuchen, diesen "
    "Vorsprung zu erreichen. Das solltest Du allerdings nur dann versuchen, "
    "wenn Du SEHR viel Geschicklichkeit besitzt!");

  AddSpecialDetail( ({ "geschicklichkeit" }), "geschickstr" );

  AddDetail( ({ "zeichen","anzeichen" }),
    "Der Sand stellt die ersten Anzeichen fuer eine Wueste im Osten dar.");

  AddDetail( ({ "wueste" }),
    "Von hier aus kannst Du die Wueste noch nicht erkennen. Aber Du bist "
    "Dir sicher, dass sie im Osten liegen muss.");

  AddDetail( ({ "auslaeufer","laeufer" }),
    "Das Gebirge wird immer niedriger. Die Auslaeufer sind aber immer noch "
    "viel zu hoch, als dass man sie erklimmen koennte.");

  AddDetail( ({ "felswaende","waende" }),
    "Hier sind die Felswaende nicht mehr so scharf und auch der Weg ist "
    "schon sehr breit geworden.");

  AddDetail( ({ "weg" }),
    "Der Weg ist hier relativ breit. Du kannst problemlos Deine Wanderung "
    "fortsetzen.");

  AddDetail( ({ "wanderung" }),
    "Wanderst Du nicht gerade?");

  AddDetail( ({ "haupt" }),
    "Die Sonne brennt Dir mitten auf Dein Haupt.");

  AddDetail( ({ "himmel" }),
    "Hoch am Himmel fliegt ein Vogel.");

  AddDetail( ({ "vogel" }),
    "Es scheint sich um einen Raubvogel zu handeln.");

  AddDetail( ({ "raubvogel" }),
    "Es koennte ein Aasgeier auf der Suche nach Nahrung sein.");

  AddDetail( ({ "suche" }),
    "Jeder ist doch irgendwann einmal auf der Suche nach etwas... auch Du!");

  AddDetail( ({ "aasgeier","geier" }),
    "Ja, es ist einer!");

  AddDetail( ({ "nahrung" }),
    "Hoffentlich bist/wirst Du nicht seine Nahrung!");

  AddDetail( ({ "boden" }),
    "Der Boden ist noch relativ felsig. Ein wenig Sand liegt ueberall "
    "verstreut herum.");

  AddDetail( ({ "felsen","fels" }),
    "Hart und massiv.");

  AddSound( DEFAULT_SOUND,
    "Du hoerst einen Vogel ueber Dir schreien.");

  AddSound( ({ "vogel","aasgeier" }),
    "Ein Aasgeier schreit direkt ueber Dir und sucht nach Nahrung.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht sandig.");

  AddSmell( ({ "sand" }),
    "Du schnupperst am Sand. Ja, es ist tatsaechlich Sand!");

  AddExit( "nordwesten",  ([ EX_DEST: "./erg2",
                             EX_TESTFUNC: "weitergehen" ]) );
  AddExit( "osten",       ([ EX_DEST: "./erg4",
                             EX_TESTFUNC: "weitergehen" ]) );
  
  AddCmd( ({ "versuch","versuche" }), "versuchfkt");
}

string geschickstr() {
  if(TP->QueryAttribute(A_DEX) > 32)
    return "Du hast bestimmt genug Geschicklichkeit!\n";
  if(TP->QueryAttribute(A_DEX) > 30)
    return "Du hast sicher genug Geschicklichkeit!\n";
  if(TP->QueryAttribute(A_DEX) > 28)
    return "Du hast genug Geschicklichkeit!\n";
  if(TP->QueryAttribute(A_DEX) > 26)
    return "Du hast nur vielleicht genug Geschicklichkeit!\n";
  if(TP->QueryAttribute(A_DEX) > 24)
    return "Du hast eher zu wenig Geschicklichkeit!\n";
  if(TP->QueryAttribute(A_DEX) > 22)
    return "Du hast zu wenig Geschicklichkeit!\n";
  return "Du hast ganz sicher zu wenig Geschicklichkeit!\n";
}

int versuchfkt(string str) {
  object ob;
  int erfolg;

  SetProp(P_KILL_NAME,"Ein missglueckter Kletterversuch");  
  ob=present("kletterhaken",TP);
  erfolg=0;
  notify_fail("Was moechtest Du versuchen?\n");
  if(str=="vorsprung zu erreichen") {
    if(ob)
      write("Moechtest Du den Vorsprung mit dem Kletterhaken erreichen?\n");
    else
      write("Du brauchst schon einen Kletterhaken!\n");
    return 1;
  }
  if(str=="vorsprung mit kletterhaken zu erreichen" ||
     str=="vorsprung mit haken zu erreichen") {
    if(ob) {
      if(TP->QueryAttribute(A_DEX) > 32)
      {
        write("Mit Leichtigkeit erreichst Du den Vorsprung!\n");
        erfolg=1;
      }
      else if(TP->QueryAttribute(A_DEX) > 30)
      {
        write("Du erreichst den Vorsprung!\n");
        erfolg=1;
      }
      else if(TP->QueryAttribute(A_DEX) > 28)
      {
        write("Du erreichst den Vorsprung gerade so eben!\n");
        erfolg=1;
      }
      else if(TP->QueryAttribute(A_DEX) > 26)
      {
        if(random(10) <5) {
          write("Mit letzter Muehe erreichst Du den Vorsprung!\n");
          erfolg=1;
        } else {
          write("Du schaffst es nicht den Vorsprung zu erreichen!\n");
          if(random(10)>5) {
            write("Leider verletzt Du Dich bei Deinem Versuch leicht!\n");
            TP->do_damage(10+random(10));
          }
          erfolg=0;
        }
      }
      else if(TP->QueryAttribute(A_DEX) > 24)
      {
        if(random(10) <3) {
          write("Mit letzter Muehe erreichst Du den Vorsprung!\n");
          erfolg=1;
        } else {
          write("Du schaffst es nicht den Vorsprung zu erreichen!\n");
          if(random(10)>3) {
            write("Leider verletzt Du Dich bei Deinem Versuch!\n");
            TP->do_damage(20+random(20));
          }
          erfolg=0;
        }
      }
      else if(TP->QueryAttribute(A_DEX) > 22)
      {
        if(random(10)<1) {
          write("Mit letzter Muehe erreichst Du den Vorsprung!\n");
          erfolg=1;
        } else {
          write("Du schaffst es nicht den Vorsprung zu erreichen!\n");
          if(random(10)>1) {
            write("Leider verletzt Du Dich bei Deinem Versuch schwer!\n");
            TP->do_damage(30+random(30));
          }
          erfolg=0;
        }
      }
      else
      {
        write("Du schaffst es nicht, den Vorsprung zu erreichen!\n");
        write("Leider verletzt Du Dich bei Deinem Versuch sehr schwer!\n");
        TP->do_damage(40+random(40));
        erfolg=0;
      }      
      if(erfolg!=0) {
        say(BS(
          CAP_TPN+" klettert wagemutig mit einem Kletterhaken nach oben!"),
          ({ TP }) );
        TP->move(ROOM "ergvor", M_NOCHECK);
      }
    } else
      write("Du hast ja gar keinen Kletterhaken!\n");
    return 1;
  }
  return 0;
}

init() {
  ::init();
  call_other( ROOM "ergvor", "???");
  tell_room( ROOM "ergvor", BS(
    CAP_TPN+" bleibt direkt unter Dir auf dem Pfad stehen."));
}

weitergehen(string str) {
  call_other( ROOM "ergvor", "???");
  tell_room( ROOM "ergvor", BS(
    CAP_TPN+" geht unten auf dem Pfad weiter nach "+CAP(str)+"."));
  return 1;
}
