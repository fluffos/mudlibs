
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>

string niesen();

create() {
  ::create();

  SetProp( P_INT_SHORT, "Auf einem heissen Gebirgspfad" );
  SetProp( P_INT_LONG,
    "Auslaeufer der offenen Wueste sind jetzt ganz klar vor Dir. Im Suedosten "
    "kannst Du schon deutlich die ersten Duenen erkennen. Das Tibesti-Gebirge "
    "hat hier sicher sein Ende gefunden. Nur ein paar vereinzelte Felsbrocken "
    "liegen noch herum." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 32+random(5), 
                           ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "auslaeufer","laeufer" }),
    "Du stehst mitten in den ersten Auslaeufern der offenen Wueste. Die "
    "Temperatur hat bereits einen ziemlich unangenehmen Wert erreicht. "
    "Im Westen beginnt das Tibesti-Gebirge.");

  AddDetail( ({ "wueste" }),
    "Die offene Wueste liegt im Osten von hier. Nur wegen der vereinzelt "
    "herumliegenden Felsbrocken musst Du einen Umweg nach Suedosten "
    "einschlagen, bevor Du endlich verdursten darfst.");

  AddDetail( ({ "osten" }),
    "Im Osten liegt die offene Wueste. Du kannst sogar schon ein paar Duenen "
    "erkennen.");

  AddDetail( ({ "suedosten" }),
    "Der einzige Weg in die Wueste geht nach Suedosten. Im Nordwesten wird "
    "die Gegend steiniger.");

  AddDetail( ({ "tibesti","tibesti-gebirge","gebirge" }),
    "Hier am Rande der Wueste beginnt das Tibesti-Gebirge.");

  AddDetail( ({ "ende" }),
    "Alles hat ein Ende, auch das Tibesti-Gebirge. Allerdings hat es hier "
    "quasi auch seinen Anfang.");

  AddDetail( ({ "felsbrocken","brocken" }),
    "Die vereinzelt herumliegenden Felsbrocken versperren Dir noch den freien "
    "Weg in alle Richtungen.");

  AddDetail( ({ "felsen","fels" }),
    "Dich umgeben nur mehr ein paar vereinzelte Felsbrocken.");

  AddDetail( ({ "boden" }),
    "Der Boden ist sandig.");

  AddDetail( ({ "sand" }),
    "Hier umgibt Dich schon sehr viel warmer, gelber Sand.");

  AddDetail( ({ "duenen" }),
    "Du siehst im Suedosten schon ein paar erste Duenen.");

  AddDetail( ({ "anfang" }),
    "Hier hat das Tibesti-Gebirge seinen Anfang. Allerdings hat es hier "
    "quasi auch sein Ende.");

  AddDetail( ({ "rande","rand" }),
    "Du stehst direkt am Rand der offenen Wueste.");

  AddDetail( ({ "himmel" }),
    "Die Sonne brennt Dir erbarmungslos auf den Kopf herunter.");

  AddDetail( ({ "sonne" }),
    "*schwitz*");

  AddDetail( ({ "kopf" }),
    "Da ist noch soviel Wasser drin, Du ueberlebst damit sicher sehr "
    "lang in der heissen Wueste ;)");

  AddDetail( ({ "umweg" }),
    "Dir wird nichts anderes ueberbleiben, als nach Suedosten zu gehen, "
    "wenn Du in die offene Wueste gelangen willst.");

  AddDetail( ({ "weg" }),
    "Der Weg geht hier von Nordwesten nach Suedosten.");

  AddDetail( ({ "wasser" }),
    "Du kannst hier kein Wasser sehen und das Wasser in Deinem Kopf schon "
    "erstrecht nicht.");

  AddSound( DEFAULT_SOUND,
    "Ein paar seltsame Laute kommen aus dem Suedosten.");

  AddSound( ({ "laute" }),
    "Das klingt fast wie ein Kamel!?!");

  AddSound( ({ "kamel" }),
    "Was sollte hier schon ein Kamel treiben? Du schaust Dich verwirrt um.");

  AddSmell( DEFAULT_SMELL,
    "Es riecht sandig.");

  AddSmell( ({ "sand" }), #'niesen);

  AddExit( "nordwesten",    "./erg4" );
  AddExit( "suedosten",     "/d/wueste/protheg/karavanen/room/ergkar" );
}

string niesen() {
  call_out("niesen2",2,TP);
  return "Du schnupperst am Sand. Ja, es ist tatsaechlich Sand!\n";
}

niesen2() {
  TP->command_me("niese");
}
