
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein fliegender Aasgeier");
  SetProp(P_LONG,
    "Der Aasgeier schwebt weit ueber Deinem Kopf und ist ganz sicher auf der "
    "Suche nach Nahrung. Du glaubst ein Glitzern in seinen Augen zu sehen, "
    "als Du nach oben schaust. Der Aasgeier bleckt seinen Schnabel und kreist "
    "weiterhin um Dich herum, wartend auf den richtigen Augenblick!");
  SetProp(P_NAME, "Aasgeier");
  SetProp(P_NAME_ADJ, "fliegend");
  SetProp(P_GENDER, MALE);
  AddId( ({"aasgeier", "geier", "\n_aasgeier"}) );

  create_default_npc(19);
  SetProp(P_HANDS, ({" mit seinem scharfen Krallen und Zaehnen",
                   QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Geier");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,100);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      -1.0, DT_WATER:  -1.0, DT_AIR:    -1.0, 
      DT_LIGHTNING: -1.0, DT_EXPLOSION: -1.0, DT_SOUND:  -1.0, DT_LIGHT:  -1.0,
      DT_ELECTRIC:  -1.0, DT_ACID:      -1.0, DT_POISON: -1.0, DT_TERROR: -1.0,
      DT_HOLY:      -1.0, DT_UNHOLY:    -1.0, DT_MAGIC:  -1.0 ]) );
  SetProp(P_NOMAGIC,100);

  SetProp(P_MSGIN, "kommt angeflogen und schwebt ueber Dir");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " stuerzt tot zu Boden.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Aasgeier kann nichts tragen.\n" }) );
}

int _query_wimpy() { return 0; }

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (touch) {
    tell_room(MENV,BS(
      "Netter Versuch, aber Du erreichst den "
      "Aasgeier nur in einem Tagtraum."));
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

_query_noattack() {
  if(previous_object(1) && 
     explode(file_name(previous_object(1)),"#")[0] != 
     "/d/wueste/zordan/anschluss/obj/stein") {
    SetProp(P_HP,QueryProp(P_MAX_HP));
    return "schwebt zu weit ueber Dir!";
  }
  SetProp(P_HP,1);
  return 0;
}
