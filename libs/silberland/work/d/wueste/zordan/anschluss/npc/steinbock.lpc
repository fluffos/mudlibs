
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Steinbock");
  
  SetProp(P_LONG,
    "Koerpergewicht ca. 14 kg. Klein, schlank, konisch zugespitzter Kopf. "
    "Koerper zierlich, mit glattem, dichtem Fell. Schlanke, lange Laeufe. "
    "Grosse, breite Lauscher. Keulen innen weiss. Schwanz sehr kurz. Lebt "
    "in Paaren oder einzeln. Frisst Blaetter, junge Triebe, Gras, auch "
    "Wurzeln und Knollen.");

  SetProp(P_NAME, "Steinbock");  
  SetProp(P_GENDER, MALE); AddId(({"steinbock", "bock"}));

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit seinen scharfen Hoernern",
                   QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Steinbock");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.2, DT_COLD:       0.0, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING:  0.0, DT_EXPLOSION: -0.2, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  0.0, DT_MIND:   0.0 ]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt angesprungen und bleibt neben Dir stehen");
  SetProp(P_MSGOUT, "springt");
  SetProp(P_MMSGIN, "kommt angesprungen und bleibt neben Dir stehen");
  SetProp(P_MMSGOUT, "springt weiter");
  SetProp(P_MNPC_AREA, (ROOM "erg") );
  SetProp(P_MNPC_WAIT, ({ 30, 10, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "erg2");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");
  AddInfo("zordan", "Zordan hat mich erschaffen.","bloekt: ");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Der Steinbock frisst @WEN auf.\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(1,250,
    "Der Steinbock sticht seine Hoerner tief in Deinen Magen.\n",
    "Der Steinbock sticht seine Hoerner tief in @WESSEN Magen.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Steinbock schaut Dich neugierig an.\n",
    "Der Steinbock scharrt im Sand.\n",
    "Der Steinbock wetzt seine Hoerner an einem Felsbrocken.\n",
    "Der Steinbock schaut gelangweilt in der Gegend herum.\n",
    "Der Steinbock frisst ein wenig Gras.\n"}) );

  SUID;
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "spieler.deads",
      "["+dtime()+"]: Der Steinbock hat gerade "+CAP(getuid(player))+
              " umgebracht ("+lostexp+").\n");
}
