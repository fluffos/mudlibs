
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Nomadenschwert");
  SetProp(P_LONG,
    "Diese edle Schwert wurde von einem meister seiner Kunst in den heissen "
    "Gebieten der Wueste hergestellt. Seine Klinge ist so scharf wie tausend "
    "Rasierklingen. Der lange Griff laesst diese Waffe sicher gut fuehren." );
  SetProp(P_NAME, "Nomadenschwert");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"nomadenschwert", "schwert"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 155);
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 1800);
  SetProp(P_NOBUY, 0);

}
