
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create() {
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Fleischmesser");
  SetProp(P_LONG,
    "Dieses Messer aus Stahl eigenet sich hervorragend fuer die Zubereitung "
    "von guten Speisen. Als Waffe kann man es aber wohl eher weniger benutzen. "
    "Die Klinge ist auch schon recht abgenutzt" );
  SetProp(P_NAME, "Fleischmesser");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"fleischmesser", "messer"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 80);
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_STEEL );
  SetProp(P_WEIGHT, 800);
  SetProp(P_VALUE, 500);
  SetProp(P_NOBUY, 0);
  SetProp(P_WC_FIXFACTOR, 0.8 );
    
  SetProp(P_WC_BONUS, (["fatimah": 100]) );
}
