
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

int wasser;

reset() {
  ::reset();
  wasser=3;
}

create() {
  ::create();

  wasser=3;

  SetProp( P_INT_SHORT, "In der Mitte des Nomadenlagers" );
  SetProp( P_INT_LONG,
    "Du stehst mitten in einem kleinen Lager der Nomaden. Der Platz hier in "
    "der Mitte des Lagers wird hauptsaechlich fuer Versammlungen genutzt. "
    "Darum steht hier auch nicht wie in allen anderen Richtungen ein Zelt "
    "herum. Mitten auf dem Platz wurde ein lange Stange in den Boden "
    "gerammt.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "lager" }),
    "Das Lager der Nomaden besteht aus vielen kleinen Zelten. Hier in der "
    "Mitte des Lagers befindet sich aber keines.");

  AddDetail( ({ "nomaden","nomade" }),
    "Derzeit befindet sich wohl keiner hier.");

  AddDetail( ({ "platz" }),
    "Der Platz genau in der Mitte des Lagers wird fuer Versammlungen genutzt.");

  AddDetail( ({ "mitte" }),
    "Du stehst genau in der Mitte des Lagers.");

  AddDetail( ({ "versammlungen","versammlung" }),
    "Hier finden die Versammlungen statt. Aber jetzt gerade ist wohl keine.");

  AddDetail( ({ "richtungen","richtung" }),
    "Na im Norden, Sueden, Osten und Westen.");

  AddDetail( ({ "norden","sueden","osten","westen" }),
    "Du kannst in diese Richtungen weitergehen. Du siehst dort eine Menge "
    "Zelte stehen.");

  AddDetail( ({ "zelt" }),
    "Wenn Du eines der Zelte untersuchen willst, musst Du schon hingehen.");

  AddDetail( ({ "zelte" }),
    "Die Zelte stehen in alle Richtungen verteilt.");

  AddDetail( ({ "stange" }),
    "Die Stange steckt fest im Boden. Auf ihr steckt ein kleiner "
    "Totenschaedel.");

  AddDetail( ({ "totenschaedel","schaedel" }),
    "Der Totenschaedel scheint von einem kleinen Rind zu stammen. Die Nomaden "
    "sehen in ihm soetwas wie ihren Beschuetzer. Er ist einfach so oben auf "
    "die Stange gesteckt. Ein kleiner Ruck koennte den Schaedel vielleicht "
    "runterfallen lassen.");

  AddDetail( ({ "rind","rinder" }),
    "Du siehst hier nur den Schaedel eines Rindes.");

  AddDetail( ({ "beschuetzer" }),
    "Die Nomaden glauben, dass Rinder sie vor allem Boesen beschuetzen.");

  AddDetail( ({ "boeses","boese" }),
    "Das Boese ist immer und ueberall.");

  AddDetail( ({ "ruck" }),
    "Vielleicht kann man an der Stange wackeln?");

  AddDetail( ({ "himmel" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter.");

  AddDetail( ({ "sonne","gelb" }),
    "Die Sonne strahlt in hellstem Gelb.");

  AddDetail( ({ "wand","waende" }),
    "Die Zelte haben keine Waende.");

  AddDetail( ({ "boden" }),
    "Auf dem Boden sind viele Spuren der Nomaden zu erkennen. Neben einer "
    "kleinen Grube faellt Dir eine grosse Tonvase auf.");

  AddDetail( ({ "spur","spuren" }),
    "Die Spuren der Nomaden zeigen in alle Richtungen.");

  AddDetail( ({ "grube" }),
    "Die Grube ist etwa einen halben Meter tief. In ihr lodert ein kleines "
    "Feuer.");

  AddDetail( ({ "meter" }),
    "Was ein Meter ist, weisst Du eh.");

  AddDetail( ({ "feuer" }),
    "Das Feuer wurde in der kleinen Grube gemacht, weil der Wind es sonst "
    "immer ausgehen lassen wuerde. Ausserdem waere das Feuer in der Nacht "
    "meilenweit zu sehen und wuerde die Nomaden verraten.");

  AddDetail( ({ "wind" }),
    "Du kannst den Wind deutlich hoeren.");

  AddDetail( ({ "nacht","glueck" }),
    "Zum Glueck ist es mitten am Tag.");

  AddDetail( ({ "tag" }),
    "Es ist mitten am Tag und die Sonne scheint hell vom Himmel herunter.");

  AddDetail( ({ "schnur" }),
    "Die kleine Schnur haelt den Schaedel fest an der Stange.");

  AddSpecialDetail( ({ "tonvase","vase" }), "vasefkt");

  AddSpecialDetail( ({ "wasser" }), "wasserfkt");

  AddSound( DEFAULT_SOUND,
    "Der Wind pfeift durch die Zelte mitten auf den Platz.");
    
  AddSound( "wind",
    "Der Wind pfeift wirklich in grauhaft hohen Toenen.");
    
  AddSound( ({"toene","ton" }),
    "Du magst diese hohen Toene nicht besonders.");
    
  AddSmell( DEFAULT_SMELL,
    "Aus dem Norden kommt ein wunderbarer Geruch.");

  AddSmell( ({ "norden","geruch" }),
    "Es riecht tatsaechlich nach frischem Essen.");

  AddSmell( "essen",
    "Der Geruch nach Essen kommt aus dem Norden.");

  AddItem( NPC "kaempfer" , REFRESH_DESTRUCT );
  AddItem( NPC "kaempfer" , REFRESH_DESTRUCT );

  AddExit( "norden", "./room-n" );
  AddExit( "sueden", "./room-s" );
  AddExit( "osten",  "./room-o" );
  AddExit( "westen", "./room-w" );
  
  AddCmd( ({ "wackel","wackle","wackl" }) , "wackelfkt" );
  AddCmd( ({ "trink","trinke" }) , "trinkfkt" );
}

int wackelfkt(string str) {
  notify_fail("Woran/Womit moechtest Du wackeln?\n");
  if(!str) return 0;
  if(str != "an stange" && str != "stange") return 0;
  write(BS(
    "Du wackelst kraeftig an der Stange und tatsaechlich. Der Schaedel loest "
    "sich ab und faellt gen Boden. Aber auf einmal stockt er. Eine kleine "
    "Schnur ist an ihm und an der Stange befestigt. Du kannst den Schaedel "
    "wohl wirklich nicht erreichen!"));
  say(BS(
    CAP_TPN+" wackelt an der Stange herum."));
  return 1;
}

string vasefkt(string str) {
  if(wasser>0) {
    return BS(
      "Die Tonvase ist mit Wasser gefuellt. Du koenntest davon trinken.");
  }
  return BS(
    "Die Tonvase ist leider leer.");
}

string wasserfkt(string str) {
  if(wasser>0) {
    return BS(
      "Du kannst das Wasser quasi riechen.");
  }
  return BS(
    "Hier scheint es kein Wasser zu geben.");
}

int trinkfkt(string str) {
  notify_fail("Woraus moechtest Du trinken?\n");
  if(!str) return 0;
  if(str != "aus vase" && str != "aus tonvase") return 0;
  if(wasser<1) {
    write(BS(
      "Die Tonvase ist leider leer."));
    return 1;
  }
  wasser--;
  write(BS(
    "Du nimmst einen grossen Schluck Wasser aus der Tonvase zu Dir. "
    "Aaaaaaaaah, tut DAS gut!!!!"));
  say(BS(
    CAP_TPN+" trinkt einen Schluck Wasser aus der Tonvase."));
  TP->AddHp(10+random(10));
  TP->drink_drink(5,0,0);
  return 1;
}
