
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Im Norden des Nomadenlagers" );
  SetProp( P_INT_LONG,
    "Du stehst ganz im Norden des Nomadenlagers. Ein riesiges Zelt mit "
    "einem kleinen Schild darueber faellt Dir auf. Es riecht stark nach "
    "frischem Essen hier und viele Spuren fuehren in das Zelt hinein." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "norden" }),
    "Du bist ganz im Norden des Lagers.");

  AddDetail( ({ "lager","nomadenlager" }),
    "Das Nomadenlager ist nicht sehr gross. Du befindest Dich gerade im "
    "ganz noerdlichen Teil davon.");

  AddDetail( ({ "teil" }),
    "Das hier ist nur ein kleiner Teil des Lagers.");

  AddDetail( ({ "zelt" }),
    "Das Zelt ist wirklich riesig. Es passen sicher sehr viele Nomaden hinein. "
    "Ein unbeschreiblicher Duft kommt aus dem Zelt heraus.");

  AddDetail( ({ "schild" }),
    "Ein kleines Schild haengt ueber dem Eingang. Du kannst es lesen.");

  AddDetail( ({ "eingang" }),
    "Der grosse Eingang des Zeltes steht offen. Du kannst es einfach so "
    "betreten.");

  AddDetail( ({ "spuren" }),
    "Viele Spuren fuehren in das Zelt hinein. Es sind aber nicht nur die "
    "Spuren von Nomaden, sondern auch vielen anderen Rassen. Eine "
    "faellt Dir besonders auf.");

  AddDetail( ({ "spur" }),
    "Die Spur kann von keinem intelligentem Lebewesen stammen. Es handelte "
    "sich wohl um ein grosses Tier.");

  AddDetail( ({ "rassen","rasse","lebewesen" }),
    "Es gibt viele Rassen und Lebewesen in der Wueste.");

  AddDetail( ({ "wueste" }),
    "Du bist mitten in einem Lager der Nomaden in der Wueste. Schon "
    "vergessen?");

  AddDetail( ({ "boden" }),
    "Der Sand der Wueste verbreitet sich ueber den ganzen Boden. Viele "
    "Spuren fuehren in ein grosses Zelt hinein.");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist strahlend blau.");

  AddDetail( ({ "sonne" }),
    "Die Sonne scheint hell vom Himmel runter.");

  AddDetail( ({ "sand" }),
    "Der Sand der Wueste ist brennend heiss und knirscht unter Deinen "
    "Fuessen.");

  AddDetail( ({ "fuss","fuesse" }),
    "Deine Fuesse sind ... Huch! nicht mehr da, sondern unter dem Sand "
    "vergraben.");

  AddDetail( ({ "nomaden","nomade" }),
    "Die Nomaden leben in diesem Lager.");

  AddReadDetail( ({ "schild" }),
    "_-= Trete ein und erhole Dich, Reisender =-_");

  AddSound( DEFAULT_SOUND,
    "Laute Stimmen kommen aus dem Zelt heraus.");
    
  AddSound( ({"stimmen","stimme"}),
    "Du kannst die Stimmen leider nicht deuten von hier aus.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht sehr stark nach Essen.");

  AddSmell( "duft",
    "Ein herlicher Duft kommt aus dem Zelt.");

  AddSmell( "essen",
    "Es koennte sein, dass es in dem Zelt etwas zu essen gibt.");

  AddExit( "sueden", "./room-m" );
  
  AddCmd( ({ "betret","betrete" }) , "betretfkt" );
}

int betretfkt(string str) {
  notify_fail("Was moechtest Du betreten? Das Zelt?\n");
  if(str != "zelt") return 0;
  write(BS(
    "Du betrittst das grosse Zelt und ein herrlicher Duft stroemt Dir "
    "entgegen..."));
  TP->move( ROOM "zelt-n" , M_GO, 0,
      "geht in das riesige Zelt",
      "kommt in das Zelt");
  return 1;
}
