
#include "../def.h"

inherit "std/pub";

#include <rooms.h>
#include <properties.h>
#include <language.h>
#include <pub.h>
#include <moving.h>

create() {
  ::create();

  SetProp(P_INT_SHORT, "In einem grossen Zelt" );
  SetProp(P_INT_LONG,
    "Du kommst in ein riesiges Zelt mit vielen Tischen und Stuehlen. In einer "
    "Ecke steht ein grosser Kochtopf auf einem Feuer. Viele Nomaden sitzen "
    "hier herum und unterhalten sich beim Essen. Der Geruch von frischem "
    "Wasser und gutem Essen liegt in der Luft." );
  SetProp(P_LIGHT, 1 );
  SetProp(P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );

  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "fatimah");
  SetProp(P_PUBKEEPER_NAME, "Fatimah");
  SetProp(P_PUBMSG_NOKEEPER, 
    "Fatimah ist zur Zeit nicht da. Du solltest es spaeter nochmal versuchen.\n");
  SetProp(P_PUBMSG_NOENEMY, 
    "Glaubst Du Fatimah ist so dumm und verkauft Dir was wenn Du gegen sie kaempfst?\n");
  SetProp(P_PUBMSG_NOINVITE, 
    "Fatimah wird kaum ihren dicksten Feinden etwas bringen.\n");
  SetProp(P_PUBMSG_FIGHTING, 
    "Fatimah kaempft doch gerade um ihr Leben!\n");

  AddDrink("abgestandenes Wasser", ({"wasser", "abgestandenes wasser"}),
    10, ({ 1,1,0 }), 0, 1, ({
      "Fatimah nimmt einen kleinen Becher mit schon gefuelltem Wasser und "
      "gibt es Dir. Du trinkst ihn aus und faengst fast an zu wuergen.",
      "Fatimah nimmt einen kleinen Becher und gibt ihn &&. &! trinkt ihn "
      "sofort aus."}) );

  AddDrink("Frischwasser", ({"frischwasser"}),
    20, ({ 2,2,0 }), 0, 1, ({
      "Fatimah fuellt einen Becher mit frischem, kuehlem Wasser. Du nimmst "
      "ihn gierig in die Hand und trinkst alles auf einmal weg. Wow, tut das "
      "nur gut bei dieser Hitze.",
      "Fatimah bringt && einen Becher voll Frischwasser."}) );

  AddDrink("kuehle Limonade", ({"kuehle limonade","limonade","limo"}),
    50, ({ 13,13,4 }), 0, 6, ({
      "Fatimah greift hinter sich und fuellt ein Glas mit einer gelben "
      "Limonade. Du findest den Geschmack einfach ausgezeichnet und fuehlst "
      "Dich so richtig erfrischt.",
      "Fatimah bringt && ein Glas voll kuehler Limonade. &! trinkt es "
      "gierig aus."}) );

  AddDrink("Kaktusschnaps", ({"kaktusschnaps", "schnaps"}),
    400, ({ 25,25,10 }), 10, 3, ({
      "Fatimah bringt Dir einen klaren Kaktusschnaps. Mit einem leichten "
      "Wuergen schuettest Du das Zeug einfach runter. So schlecht wie "
      "vermutet schmeckt er nicht einmal.",
      "Fatimah bringt && einen Kaktusschnaps. Beim Trinken verzieht && aber "
      "nur ganz kurz das Gesicht."}) );

  AddFood("Schlangensuppe", ({"schlangensuppe","suppe"}),
    200, ({20,25,5}), 15, ({
      "Fatimah laechelt Dich froehlich an und serviert Dir die beste Suppe, "
      "die Du jemals in Deinem Leben gegessen hast. Das sie aus Schlangen "
      "gemacht wurde, faellt Dir dabei gar nicht auf. Du bleckst Dir die "
      "Zunge.",
      "Fatimah laechelt && an und bringt &3 eine wirklich gut riechende "
      "Suppe." }) );

  AddFood("Elefantenfleisch", ({"elefantenfleisch","fleisch"}),
    500, ({50,50,10}), 25, ({
      "Fatimah nimmt ihr Messer und schneidet ein grosses Stueck Fleisch von "
      "einem Braten ab. Sie reicht ihn Dir und wuenscht Dir guten Appetit. "
      "Du schlingst das Elefantenfleisch herunter und fuehlst Dich sehr "
      "gesaettigt.",
      "Fatimah nimmt ihr Messer und schneidet fuer && ein Stueck Fleisch "
      "eines Elefanten zurecht. && verzehrt das Fleischstueck." }) );

  AddDetail( ({ "wueste" }),
    "Das Zelt steht mitten in der Wueste.");

  AddDetail( ({ "wirtin","fatimah" }),
    "Ist Fatimah grad nicht da?");

  AddDetail( ({ "feuer" }),
    "Das Feuer lodert unter dem Kochtopf vor sich hin. Es macht es aber auch "
    "nicht mehr unbedingt waermer hier.");

  AddDetail( ({ "luft" }),
    "Du kannst die Luft nur erahnen, aber nicht wirklich sehen.");

  AddDetail( ({ "wasser" }),
    "Das Wasser schaut sehr frisch aus.");

  AddDetail( ({ "kochtopf","topf" }),
    "Der Kochtopf haengt ueber dem Feuer. Die Wirtin macht darin wohl immer "
    "das Essen fuer die Nomaden.");

  AddDetail( ({ "nomade","nomaden","dinge","alltag" }),
    "Viele Nomaden haben an den Tischen Platz genommen und geniessen ihr "
    "Essen. Sie unterhalten sich sehr aufgeregt ueber die taeglichen Dinge "
    "des Alltages.");

  AddDetail( ({ "essen","trinken" }),
    "Schau doch mal auf das Menue.");

  AddDetail( ({ "menue" }),
    "Einfach 'Menue' eingeben...");

  AddDetail( ({ "ecken" }),
    "Das Zelt hat durch die Zeltstangen sehr viele Ecken.");

  AddDetail( ({ "ecke" }),
    "In einer der Ecken steht ein grosser Kochtopf auf dem Feuer.");

  AddDetail( ({ "zelt" }),
    "Das riesige Zelt besteht aus einigen festen Holzstangen und einer "
    "weissen Zeltplane. Viele Tische und Stuehle stehen mitten darin.");

  AddDetail( ({ "holz" }),
    "Das ist ganz normales, weisses Holz.");

  AddDetail( ({ "holzstangen","stangen","zeltstangen" }),
    "Die Holzstangen stehen in wenig auseinander und tragen die Zeltplane.");

  AddDetail( ({ "zeltplane","plane" }),
    "Die Zeltplane ist total weiss. Das machen die Nomaden immer so, damit "
    "die Sonne das Zelt nicht zu sehr erhitzen kann.");

  AddDetail( ({ "sonne","sonnenstrahl","sonnenstrahlen" }),
    "Es dringt kein Sonnenstrahl in das Zelt. Durch den Eingang kannst Du "
    "aber die Sonne hell scheinen sehen.");

  AddDetail( ({ "eingang","westen" }),
    "Der Eingang liegt im Westen und ist komplett geoeffnet.");

  AddDetail( ({ "tische" }),
    "Die Tische stehen quer verstreut in dem Zelt herum. An ihnen stehen "
    "diverse Stuehle. Zufaellig ist sogar einer der Tische frei.");

  AddDetail( ({ "tisch" }),
    "Der Tisch ist frei. Du kannst hier sicher Platz nehmen.");

  AddDetail( ({ "platz" }),
    "Genug Platz waere jedenfalls in dem riesigen Zelt vorhanden.");

  AddDetail( ({ "decke" }),
    "Es gibt keine definierte Decke in einem Zelt. Die Zeltstangen laufen "
    "zu einer Spitze zusammen.");

  AddDetail( ({ "spitze" }),
    "Die Spitze ist komplett geschlossen, damit es nicht reinregnet.");

  AddDetail( ({ "stuehle" }),
    "Die Stuehle stehen um die Tische verteilt. Sie sind aus weissem Holz, "
    "wie alles hier. Du kannst leider keinen freien Stuhl erkennen.");

  AddDetail( ({ "stuhl","stehen" }),
    "Alle Stuehle sind belegt. Du wirst wohl im Stehen essen muessen.");

  AddDetail( ({ "wand","waende" }),
    "Die Waende hier bestehen aus weissen Zeltplanen.");

  AddDetail( ({ "boden" }),
    "Der Boden wurde mit ein paar kleinen Stoffresten ausgelegt, damit sich "
    "kein Sand in die Schuhe verkriechen kann.");

  AddDetail( ({ "stoff","stoffreste","reste","auslage" }),
    "Die Stoffreste waren wohl frueher mal Zeltplanen. Aber jetzt benutzt man "
    "sie wohl nur noch als Auslage.");

  AddDetail( ({ "schuhe","schuh" }),
    "Sand in den Schuhen ist wirklich unangenehm.");

  AddDetail( ({ "sand" }),
    "Wie ueberall in der Wueste, findet man auch in solchen Zelten noch "
    "genug Sand. Aber er weht nicht herum, darum ist er eigentlich schon "
    "eher angenehm.");

  AddSound( DEFAULT_SOUND,
    "Die Nomaden unterhalten sich angestrengt an den Tischen.");
    
  AddSound( "nomaden",
    "Du kannst ihr Sprache leider nicht so ganz verstehen.");
    
  AddSound( "sprache",
    "Du gibst alles. Aber es reicht doch nicht aus, um etwas genauer zu "
    "verstehen.");
    
  AddSmell( DEFAULT_SMELL,
    "Es riecht nach frischem Wasser und gutem Essen.");

  AddSmell( ({ "wasser","geruch" }) , 
    "Der Geruch von frischem Wasser liegt in der Luft.");

  AddSmell( ({ "luft","delikatessen" }),
    "Die Luft ist erfuellt von einigen Delikatessen.");

  AddSmell( "essen",
    "Das Essen riecht wunderbar.");

  AddItem( NPC "fatimah", REFRESH_DESTRUCT );

  AddExit( "raus", "./room-n" );
  
  AddCmd( ({ "menue" }) , "menuefkt");
  AddCmd( ({ "nimm","nehm","nehme" }), "nimmfkt" );
}

int getfeinde (object ob) {
  object ob2;
  if (ob2 = find_living("fatimah"))
    if (ob2->IsEnemy(ob)) return 1;
  return 0;
}

menuefkt(string str) {
  notify_fail ("Fatimah ist gerade nicht da. Du solltest es spaeter nochmal versuchen.\n");
  if (present("fatimah",ME)) {
    notify_fail("Du kaempfst doch gegen Fatimah. Warum sollte sie Dir ihr ganzes Menue zeigen?\n");
    if (getfeinde(TP)) return 0;
    write("Fatimah laechelt Dich an und zeigt Dir ihre Karte:\n\n");
    return ::menue(str);
  }
  return 0;
}

int nimmfkt(string str) {
  if(str != "platz") return 0;
  write(BS(
    "Du moechtest gerne Platz an dem freien Tisch nehmen und suchst nach "
    "einem freien Stuhl. Doch was ist das? Es ist nicht ein einziger Stuhl "
    "mehr frei. Vergeblich gibst Du auf."));
  return 1;
}
