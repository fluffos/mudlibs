
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create() {
  ::create();

  SetProp( P_INT_SHORT, "Im Osten des Nomadenlagers" );
  SetProp( P_INT_LONG,
    "Hier im Osten des Lagers ist deutlich weniger Aktivitaet. Nur ein "
    "reichlich verziertes Zelt steht hier. Die Sonne scheint hier nicht so "
    "stark, weil die anderen Zelte auf diesen Teil ihre Schatten werfen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_DESERT]) );

  AddDetail( ({ "lager" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "boden" }),
    "Auf dem Boden sammelt sich der feine Sand der Wueste.");

  AddDetail( ({ "himmel" }),
    "Der strahlend blaue Himmel breitet sich ueber Dir aus.");

  AddDetail( ({ "wueste" }),
    "Du bist mitten in der Wueste, schon vergessen?");

  AddDetail( ({ "sand" }),
    "Der feine Sand schlaengelt sich zwischen den Zelten bis hin zu Dir.");

  AddDetail( ({ "sonne" }),
    "Die Sonne steht hoch am Himmel. Sie ist hier aber nicht so warm, weil "
    "die anderen Zelte ihre Schatten genau hierher werfen.");

  AddDetail( ({ "schatten" }),
    "Die Schatten der Zelte fallen genau hierher. Darum ist es hier auch "
    "nicht ganz so warm, wie sonst ueberall im Lager ueblich.");

  AddDetail( ({ "zelte" }),
    "Die anderen Zelte sind weiter im Westen.");

  AddDetail( ({ "teil" }),
    "Dieser Teil des Lagers ist eher weniger besucht.");

  AddDetail( ({ "aktivitaet" }),
    "Hier ist kaum etwas los. Die Nomaden scheinen diesen Teil ein wenig "
    "zu meiden.");

  AddDetail( ({ "nomaden","nomade" }),
    "Die Nomaden scheinen ein wenig Ehrfurcht vor diesem Teil des Lagers zu "
    "haben.");

  AddDetail( ({ "gefuehl","ehrfurcht" }),
    "Das kann eigentlich nur an dem Zelt hier liegen. Vielleicht ist es nicht "
    "nicht ratsam, es zu betreten?");

  AddDetail( ({ "zelt" }),
    "Ein kleines, unscheinbares Zelt steht hier mitten im Osten des Lagers. "
    "Sein Eingang ist reichlich verziert. Zwei Stangen halten den Eingang "
    "auf. Ein Gefuehl der Ehrfurcht kommt in Dir auf.");

  AddDetail( ({ "eingang" }),
    "Der Eingang ist mit einem Tuch verschlossen, Du kannst das Zelt aber "
    "dennoch jederzeit betreten.");

  AddDetail( ({ "stangen","stange" }),
    "Die Stangen halten den Eingang. Auf ihnen sind zwei Schaedel angebracht "
    "worden.");

  AddDetail( ({ "schaedel","mammut","mammuts" }),
    "Die Schaedel zeigen deutlich, dass dieses ein ganz besonders Zelt sein "
    "muss. Es sind die Schaedel von zwei alten Mammuts.");

  AddDetail( ({ "tuch","sicht" }),
    "Das weise Tuch haengt an eine Leine zwischen den beiden Stangen "
    "herunter und versperrt die Sicht nach drinnen.");

  AddDetail( ({ "leine" }),
    "Die feste Leine haelt das Tuch.");

  AddSound( DEFAULT_SOUND,
    "Der Wind ist hier sehr leise.");
    
  AddSound( "wind",
    "Der Wind pfeift hier nur sehr leise.");
    
  AddSmell( DEFAULT_SMELL,
    "Aus dem Nordosten stroemt Dir der Geruch von frischem Wasser entgegen.");

  AddSmell( ({ "nordwesten","geruch","wasser" }),
    "Du kannst von hier aus nur den Geruch von Wasser wittern, aber nichts "
    "genauer erkennen.");

  AddExit( "westen", "./room-m" );

  AddCmd( ({ "betret","betrete" }) , "betretfkt" );
}

int betretfkt(string str) {
  notify_fail("Was moechtest Du betreten? Das Zelt?\n");
  if(str != "zelt") return 0;
  write(BS("Du betrittst das Zelt des Stammesanfuehrers..."));
  TP->move( ROOM "zelt-o" , M_GO, 0,
      "geht in das Zelt",
      "kommt in das Zelt");
  return 1;
}
