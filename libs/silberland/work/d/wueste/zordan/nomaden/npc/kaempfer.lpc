
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Nomadenkaempfer");
  SetProp(P_LONG,
    "Ein ausgewachsener Krieger steht vor Dir. Mit seinem langen Schwert "
    "und seinen starken Muskeln bewacht er wohl das Lager gegen Feinde. "
    "Sein langes Haar weht ihm ins Gesicht und seine Augen lassen nicht "
    "von Dir ab. Die Kleidung laesst leicht ein Ueberleben in der Wueste "
    "zu.");
  SetProp(P_NAME, "Nomadenkaempfer");
  SetProp(P_GENDER, MALE);
  AddId(({"nomade", "nomadenkaempfer", "kaempfer"}));
  
  create_default_npc(15+random(3));
  SetProp(P_HANDS, ({" mit seinen starken Haenden",
                     QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Nomade");
  SetProp(P_SIZE, 170+random(10));
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.5, DT_COLD:      0.1, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING:  0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT: -0.5,
      DT_ELECTRIC:   0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
  SetProp(P_NOMAGIC,0);

  SetProp(P_MNPC_AREA, ROOM "room-" );
  SetProp(P_MNPC_WAIT, ({ 20, 60, 60 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "room-m");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_MSGIN, "kommt wackeren Schrittes an");
  SetProp(P_MSGOUT, "geht wackeren Schrittes");
  SetProp(P_MMSGIN, "kommt wackeren Schrittes an");
  SetProp(P_MMSGOUT, "geht fort");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, ({ 
    "fragt: Was meinst Du genau?\n",
    "sagt: Bist Du Dir sicher?\n",
    "sagt: Davon verstehe ich nichts.\n",
    "grummelt was vor sich hin.\n",
    "versteht Dich doch gar nicht.\n" }));
    
  AddInfo("zordan", "Zordan hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Nomadenkaempfer bedankt sich fuer @WEN.\n" }) );

  SetProp(P_SPELLRATE,50);
  AddSpell(3,200,
    "Der Nomadenkaempfer schlaegt wild auf Dich ein.\n",
    "Der Nomadenkaempfer schlaegt wild auf @WEN ein.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,275,
    "Der Nomadenkaempfer blendet Dich mit seinem Schwert.\n",
    "Der Nomadenkaempfer blendet @WEN mit seinem Schwert.\n",
     DT_LIGHT,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,400,
    "Der Nomadenkaempfer trifft Dich mit einem gewalltigen Hieb.\n",
    "Der Nomadenkaempfer trifft @WEN mit einem gewalltigen Hieb.\n",
     DT_SLASH,([SP_SHOW_DAMAGE:1]));

  SetChats(2, ({
    "Der Nomadenkaempfer schaut Dich laessig an.\n",
    "Der Nomadenkaempfer sagt: Mach hier keinen Unsinn!\n",
    "Der Nomadenkaempfer sagt: Ist das wieder heiss heute ...\n",
    "Der Nomadenkaempfer putzt sich die Schuhe.\n"}) );
  
  SUID;
  CLONEME(WEAPON "nomadenschwert" );
  command("zuecke nomadenschwert");
  CLONEME( "/p/armour/lederschuhe" );
  command("trage alles");
}


// Mitloggen wenn der NPC einen Spielerkillt:
void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "Deads",
      ctime()+": Der Nomadenkaempfer hat gerade "+CAP(getuid(player))+" umgebracht ("
      +lostexp+").\n");
}

void init() {
  ::init();
  if (TP && TP->id("\n_fatimah")) AddDefender(TP);
}

void InformDefend(object enemy) {
  if (!IsEnemy(enemy)) {
    Kill(enemy);
  }
}
