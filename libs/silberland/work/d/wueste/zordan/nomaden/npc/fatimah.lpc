
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Fatimah, die Wirtin");
  SetProp(P_LONG,
    "Die kleine, aber dennoch stabile Wirtin steht in einer Ecke und bereitet "
    "die vielen guten Speisen fuer die Nomaden zu. Ihr langes, weisses Haar "
    "hat sie mit einem kleinen Tuch nach hinten gebunden. Ihre Kleidung "
    "zeugt von harter Arbeit.");
  SetProp(P_NAME, "Fatimah");
  SetProp(P_GENDER, FEMALE);
  AddId(({"\n_fatimah","fatimah", "wirtin", "NOWIMPY"}));
  set_living_name("fatimah");

  create_default_npc(20+random(3));
  SetProp(P_HANDS, ({" mit ihren feuchten Haenden",
                      QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Nomade");
  SetProp(P_SIZE, 160+random(10));
  SetProp(P_ALIGN, 400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:     -0.9, DT_COLD:      0.1, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt an und faengt an zu kochen");
  SetProp(P_MSGOUT, "verschwindet kurz");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  AddInfo(DEFAULT_INFO, ({
    "sagt: Red nicht soviel, sonder iss lieber etwas!\n",
    "sagt: Darauf kann ich Dir keine Antwort geben.\n",
    "schuettelt den Kopf.\n",
    "fragt: Was meinst Du denn jetzt genau?\n" }) );
    
  AddInfo("zordan", "Zordan hat mich erschaffen.","sagt: ");

  AddInfo( ({"",""}),
    ".",
    "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Fatimah sagt: Danke, aber @WEN wuerde mich nur behindern.\n" }) );

  SetProp(P_SPELLRATE,20);

  AddSpell(1,250,
    "Fatimah bewirft Dich mit heissen Kohlen.\n",
    "Fatimah bewirft @WEN mit heissen Kohlen.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Fatimah reicht einem Gast etwas zu trinken.\n",
    "Fatimah schaut Dich fragend an.\n",
    "Fatimah ruft: Meine ist die beste Suppe!\n",
    "Fatimah sagt: Leider ist mir der Wein ausgegangen.\n",
    "Fatimah antwortet einem Nomaden: Zahl gefaelligst Deine Rechnung!\n",
    "Fatimah ruehrt in ihren Speisen herum.\n"}) );
    
  SetAttackChats(40, ({
    "@@hilferuf@@" }) );

  SUID;
  CLONEME(WEAPON "fleischmesser" );
  command("zuecke fleischmesser");
  CLONEME( "/d/wasser/stahldorn/outlaw/obj/hasch" );
  CLONEME( "/p/armour/schuerze" );
  CLONEME( "/d/dschungel/dante/fels/armour/dledergamaschen" );
  command("trage alles");
}

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "Deads",
      ctime()+": Fatimah hat gerade "+CAP(getuid(player))+" umgebracht ("
      +lostexp+").\n");
}

hilferuf() {
  object ob;
  call_other("/d/wueste/zordan/nomaden/room/room-n","???");
  call_other("/d/wueste/zordan/nomaden/room/room-m","???");
  ob=present("nomadenkaempfer",
     find_object("/d/wueste/zordan/nomaden/room/room-n"));
  if(!objectp(ob))
    ob=present("nomadenkaempfer",
       find_object("/d/wueste/zordan/nomaden/room/room-m"));
  if(objectp(ob) && MENV) {
    ob->move(MENV,M_GO);
    return "Fatimah ruft laut um Hilfe bei den Kaempfern an.\n";
  }
  return "";
}

void init() {
  ::init();
  if (TP && TP->id("nomadenkaempfer")) AddDefender(TP);
}
