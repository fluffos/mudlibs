
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Ein Stinktier");
  SetProp(P_LONG,
    "Dieser schwarzweiss gebaenderte Marder mit seinem langen, buschigen "
    "Schwanz lebt wie ein Raeuber in der Wueste. Er verteidigt sich nicht "
    "wie andere Marder mit seinen Krallen, sondern versprueht ein wirklich "
    "stark stinkendes Sekret. Sollte Dich dieses Sekret erwischen, so Gnade "
    "Dir Woody.");
  SetProp(P_NAME, "Stinktier");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "stinktier" }) );

  create_default_npc(7+random(3));
  SetProp(P_HANDS, ({" mit seinem Schwanz",
                   QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Stinktier");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 25+random(10));
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.1, DT_COLD:       0.2, DT_WATER:   0.0, DT_AIR:    0.0,
      DT_LIGHTNING:  0.0, DT_EXPLOSION:  0.0, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.1, DT_POISON: -0.2, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:   0.0 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");

  SetProp(P_DIE_MSG,  " faellt zu Boden.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Stinktier kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,40);
  AddSpell(2,200,
    "Das Stinktier beisst Dir in den Fuss.\n",
    "Das Stinktier beisst @WEM in den Fuss.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,100,
     "Das Stinktier spritzt Dich mit seinem stinkendem Sekret voll.\n",
     "Das Stinktier spritzt @WEN mit seinem stinkendem Sekret voll.\n",
     DT_ACID,"sekretspell");

  SetChats(1, ({
    "Das Stinktier laeuft um Dich herum.\n",
    "Das Stinktier schaut fragend in der Gegend herum.\n",
    "Das Stinktier putzt sich.\n",
    "Hier stinkt es furchterregend.\n",
    "Das Stinktier stinkt wirklich bestialisch.\n",
    "Das Stinktier schaut Dich misstrauisch an.\n"}) );
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}

void sekretspell(object enemy, int damage, mixed dam_type) {
  object ob;
  if(!present("\n_stinktier_sekret",enemy)) {
    ob=clone_object( OBJ "sekret" );
    ob->move(enemy,M_SILENT | M_NOCHECK);
  }
  enemy->Defend(damage, dam_type, 
        ([SP_SHOW_DAMAGE:1,SP_NAME:"sekretspell"]), TO );
}

