
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Ein kleiner Kaefer");
  SetProp(P_LONG,
    "Dieser kleine, schwarze Kaefer kann nur deshalb in der Wueste "
    "ueberleben, weil er sich die meiste Zeit unter den Sand vergraebt "
    "und die Sonne nicht auf ihn scheint. Er krabbelt leichtfuessig mit "
    "seinen sechs Beinchen ueber den Sand und hinterlaesst eine "
    "winzige Spur hinter sich.");
  SetProp(P_NAME, "Kaefer");
  SetProp(P_GENDER, MALE);
  AddId( ({ "kaefer" }) );

  create_default_npc(5+random(3));
  SetProp(P_HANDS, ({" mit winzigen Beinchen",
                   QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Kaefer");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 1+random(2));
  SetProp(P_ALIGN, 10);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.2, DT_COLD:       0.1, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING:  0.0, DT_EXPLOSION: -0.1, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  0.0 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt weiter");

  SetProp(P_DIE_MSG,  " verschwindet tief im Sand.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Kaefer kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,10);
  AddSpell(1,100,
    "Der Kaefer zwickt Dir in den Fuss.\n",
    "Der Kaefer zwickt @WEM in den Fuss.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Kaefer wetzt geschwind ueber Deinen Fuss.\n",
    "Der Kaefer vergraebt sich kurz im Sand.\n",
    "Der Kaefer krabbelt ueber den Sand.\n"}) );
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
