
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

int flug,lasttime;

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  flug=1;

  SetProp(P_SHORT, "Ein Sturmfalke");
  SetProp(P_LONG,
    "Der Sturmfalke ist groesser und unscheinbarer als seine Artgenossen. "
    "Sein Gefieder ist hell- und dunkelbraun gemasert, Schnabel und Augen "
    "sind dunkelbraun oder schwarz. Er legt seine Horste nicht nur im "
    "Gebirge, sondern auch auf hohen freistehenden Baeumen an.");
  SetProp(P_NAME, "Sturmfalke");
  SetProp(P_GENDER, MALE);
  AddId(({"sturmfalke", "falke"}));

  create_default_npc(15+random(3));
  SetProp(P_HANDS, ({" mit seinem harten Schnabel",
                   QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_RACE, "Falke");
  SetProp(P_SIZE, 50+random(15));
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_ALIGN, -150);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      0.1, DT_COLD:      0.0, DT_WATER:   0.0, DT_AIR:    -1.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.1, DT_SOUND:   0.0, DT_LIGHT:  -0.2,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: -0.2, DT_TERROR:  0.1,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  -0.2 ]) );
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kommt angeflogen");
  SetProp(P_MSGOUT, "fliegt");

  SetProp(P_DIE_MSG,  " stuerzt ab und bleibt regungslos liegen.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Sturmfalke kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,60);

  AddSpell(3,300,
    "Der Sturmfalke hackt Dir tief ins Fleisch.\n",
    "Der Sturmfalke hackt @WEM tief ins Fleisch.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,400,
    "Der Sturmfalke hackt Dir ins Auge.\n",
    "Der Sturmfalke hackt @WEM ins Auge.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,500,
    "Der Sturmfalke macht einen Sturzflug und erwischt Dich am Kopf.\n",
    "Der Sturmfalke macht einen Sturzflug und erwischt @WEN am Kopf.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Sturmfalke fliegt ueber Deinem Kopf.\n",
    "Der Sturmfalke dreht einen Kreis ueber Dir.\n",
    "Der Sturmfalke ist sichtlich erregt.\n",
    "Der Sturmfalke kraechzt.\n",
    "Der Sturmfalke haelt Ausschau nach Feinden.\n",
    "Der Sturmfalke fuehlt sich belaestigt.\n"}) );

  SUID;
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy) {
  if(flug && !spell) {
    if(!random(3))
      tell_object(enemy,BS(
        "Der Sturmfalke ist viel zu hoch als das Du ihn so treffen koenntest."));
    dam=0;
  }
  ::Defend(dam, dam_type, spell, enemy);
}

string woisser() {
  if(flug) return "Ueber Dir fliegt weit oben dieser schoene Sturmfalke.\n";
  return "Direkt neben Dir auf dem Boden scharrt der Sturmfalke im Sand.\n";
}

heart_beat() {
  ::heart_beat();
  if(!random(10) && ((time()-lasttime) > 8) && MENV) {
    flug=1-flug;
    lasttime=time();
    if(flug )
      tell_room(MENV,BS(
        "Der Sturmfalke steigt hoch in die Luefte auf."));
    else
      tell_room(MENV,BS(
        "Der Sturmfalke landet neben Dir auf dem Boden."));
  }
}

long() {
  return woisser()+::long();
}
