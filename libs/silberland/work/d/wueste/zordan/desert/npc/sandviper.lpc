
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Eine Sandviper");
  SetProp(P_LONG,
    "Diese Sanviper ist eine kleine Giftschlange, die bis cirka zwei Meter "
    "lang werden kann. Der Koerper der Schlange ist aber so duenn, dass man "
    "sie leicht mit der Hand umfassen kann. Die graugelb gebaenderte "
    "Sandviper lebt bevorzugt in den etwas kuehleren Teilen der Wueste und "
    "ernaehrt sich von kleinen Tieren. Ihr starkes Gift kann sogar einem "
    "Elefanten gefaehrlich werden!");
  SetProp(P_NAME, "Sandviper");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "sandviper","viper" }) );

  create_default_npc(17+random(4));
  SetProp(P_HANDS, ({" mit ihren giftigen Zaehnen",
                   QueryProp(P_HANDS)[1]+100,DT_POISON}));
  SetProp(P_RACE, "Schlange");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 15+random(5));
  SetProp(P_ALIGN, -250);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_AGGRESSIVE, 0.7);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.0, DT_COLD:       0.1, DT_WATER:   0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: -0.2, DT_EXPLOSION: -0.2, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:      -1.0, DT_POISON: -1.0, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  -0.3 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt angeschlaengelt");
  SetProp(P_MSGOUT, "windet sich weiter");

  SetProp(P_DIE_MSG,  " versinkt toedlich getroffen im Sand.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Sandviper kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,60);

  AddDefaultSpell(1, 350, DS_POISON, 
    "Die Sandviper vergiftet Dich mit einem flinken Biss in den Fuss.\n",
    "Die Sandviper vergiftet @WEN mit einem flinken Biss in den Fuss.\n");

  AddSpell(4,250,
    "Die Sandviper beisst Dir ins Bein.\n",
    "Die Sandviper beisst @WEM ins Bein.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Die Sandviper schlaengelt sich durch den Sand.\n",
    "Die Sandviper schlaengelt sich durch Deine Fuesse hindurch.\n",
    "Die Sandviper zischt.\n",
    "Die Sandviper sucht nach Nahrung.\n" }) );
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
