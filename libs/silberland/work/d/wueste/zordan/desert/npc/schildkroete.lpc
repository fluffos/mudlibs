
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Eine Schildkroete");
  SetProp(P_LONG,
    "Diese kleine Schildkroete hat es tatsaechlich geschafft in dieser "
    "unwirklichen Gegend zu ueberleben. Gegen die brennende Hitze ist ihr "
    "Panzer gelbbraun gefaerbt. Normalerweise geht sie nur in der Nacht "
    "umher. Mit ihren kleinen Zaehnchen schafft sie es gerade mal so, das "
    "harte Gras der Wueste auszureissen.");
  SetProp(P_NAME, "Schildkroete");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "schildkroete" }) );

  create_default_npc(8+random(3));
  SetProp(P_HANDS, ({" mit seinen kleinen Zaehnchen",
                   QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Schildkroete");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 10+random(10));
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.1, DT_COLD:       0.1, DT_WATER:  0.0, DT_AIR:     0.0, 
      DT_LIGHTNING: -0.1, DT_EXPLOSION: -0.1, DT_SOUND:  0.0, DT_LIGHT:   0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.0, DT_POISON: 0.1, DT_TERROR:  0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC: -0.5 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt ganz langsam an");
  SetProp(P_MSGOUT, "geht langsam");

  SetProp(P_DIE_MSG,  " hinterlaesst nur noch ihren Panzer.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Schildkroete kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,20);
  AddSpell(1,150,
    "Die Schildkroete beisst Dich hart.\n",
    "Die Schildkroete beisst @WEN hart.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Die Schildkroete wandert langsam durch den heissen Sand.\n",
    "Die Schildkroete streckt ihre Beinchen aus.\n",
    "Die Schildkroete nagt genuesslich an einem Gras.\n",
    "Die Schildkroete steht regungslos in Deinem Schatten.\n",
    "Die Schildkroete versteckt sich kurz in ihrem Panzer.\n"}) );
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
