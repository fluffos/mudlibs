
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Ein Sandwolf");
  SetProp(P_LONG,
    "Die Vertreter der Woelfe in der Wueste sind die Sandwoelfe. Sie sind "
    "zierlicher und duerrer als ihre Vettern, machen aber dies durch ihre "
    "Wildheit und Zaehigkeit wieder wett. Die sandgelben bis schmutzigbraunen "
    "Tiere kennen kaum ein Familienleben. Sie sind gefaehrliche Einzelgaenger.");
  SetProp(P_NAME, "Sandwolf");
  SetProp(P_GENDER, MALE);
  AddId( ({ "sandwolf","wolf" }) );

  create_default_npc(18+random(3));
  SetProp(P_HANDS, ({" mit seinen grossen Gebiss",
                   QueryProp(P_HANDS)[1]+50,DT_PIERCE}));
  SetProp(P_RACE, "Sandwolf");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 90+random(20));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.1, DT_COLD:       0.1, DT_WATER:  0.0, DT_AIR:     0.0, 
      DT_LIGHTNING: -0.2, DT_EXPLOSION: -0.2, DT_SOUND:  0.0, DT_LIGHT:  -0.1,
      DT_ELECTRIC:   0.1, DT_ACID:       0.3, DT_POISON: 0.2, DT_TERROR: -0.1,
      DT_HOLY:       0.1, DT_UNHOLY:    -0.1, DT_MAGIC: -0.1 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt auf seinem Streifzug an");
  SetProp(P_MSGOUT, "streift weiter");

  SetProp(P_DIE_MSG,  " bricht toedlich getroffen zusammen.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Sandwolf kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,90);
  AddSpell(1,165,
    "Der Sandwolf erwischt Dich voll mit seiner Pranke.\n",
    "Der Sandwolf erwischt @WEN voll mit seiner Pranke.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,200,
    "Der Sandwolf zerfleischt Dich zusehends.\n",
    "Der Sandwolf zerfleischt @WEN zusehends.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,250,
    "Der Sandwolf beisst Dir ins Bein.\n",
    "Der Sandwolf beisst @WEM ins Bein.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Sandwolf bleckt seine Pranken.\n",
    "Dem Sandwolf laeuft der Sabber aus dem Maul.\n",
    "Der Sandwolf heult.\n",
    "Der Sandwolf schnuppert an Dir.\n",
    "Der Sandwolf schaut sich nach Beute um.\n"}) );
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
