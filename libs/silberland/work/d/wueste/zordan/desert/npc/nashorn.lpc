
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Ein Nashorn");
  SetProp(P_LONG,
    "Das Nashorn gilt als aeusserst reizbar, verliert aber die Lust am "
    "Kaempfen ebenso leicht wieder und fuehrt die meisten Kaempfe nicht "
    "zuende. Nashoerner trifft man in der Regel nur einzeln an. Sie sind "
    "die absolute Ruhe in sich selbst.");
  SetProp(P_NAME, "Nashorn");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "nashorn" }) );

  create_default_npc(16+random(4));
  SetProp(P_HANDS, ({" mit seinem grossen Horn",
                   QueryProp(P_HANDS)[1]+75,DT_RIP}));
  SetProp(P_RACE, "Nashorn");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 120+random(20));
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.0, DT_COLD:       0.1, DT_WATER: -0.8, DT_AIR:     0.0, 
      DT_LIGHTNING:  0.0, DT_EXPLOSION:  0.0, DT_SOUND:  0.0, DT_LIGHT:   0.1,
      DT_ELECTRIC:   0.0, DT_ACID:       0.0, DT_POISON: 0.1, DT_TERROR:  0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  0.0 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "trampelt laut herein");
  SetProp(P_MSGOUT, "trampelt weiter");

  SetProp(P_DIE_MSG,  " bricht mit einem lauten *RUMMS* zusammen.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Nashorn kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,35);

  AddSpell(4,165,
    "Das Nashorn tritt Dir voll auf den Fuss.\n",
    "Das Nashorn tritt @WEM voll auf den Fuss.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,650,
    "Das Nashorn rammt Dir sein Horn in den Magen.\n",
    "Das Nashorn rammt @WEM sein Horn in den Magen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Das Nashorn schnaubt laut auf.\n",
    "Das Nashorn beobachtet Dich gar nicht.\n",
    "Das Nashorn reibt sein Horn.\n",
    "Das Nashorn trampelt wild auf der Stelle.\n",
    "Das Nashorn wuehlt im Sand.\n"}) );
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy) {
  int max,act,pro;
  ::Defend(dam, dam_type, spell, enemy);
  if(ME) {
    act=ME->QueryProp(P_HP);
    max=ME->QueryProp(P_MAX_HP);
    pro=100*act/max;
    if(pro<30 && pro>1) {
      if(!TO) return 0;
      enemy->StopHuntFor(ME);
      StopHuntFor(enemy);
      tell_room(MENV,BS(
        "Das Nashorn beendet den Kampf und fluechtet."));
      switch(random(4)) {
        case 0: command_me("norden"); break;
        case 1: command_me("sueden"); break;
        case 2: command_me("westen"); break;
        case 3: command_me("osten"); break;
      }
      switch(random(4)) {
        case 0: command_me("norden"); break;
        case 1: command_me("sueden"); break;
        case 2: command_me("westen"); break;
        case 3: command_me("osten"); break;
      }
    }
  }
}

