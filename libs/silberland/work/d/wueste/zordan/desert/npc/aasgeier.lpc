
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Ein Aasgeier");
  SetProp(P_LONG,
    "Du siehst den Aasgeier an und bemerkst, dass er eigentlich absolut "
    "nichts Schoenes an sich hat. Sein Hals ist kahl, duenn und "
    "blutverschmiert. Wahrscheinlich kann er so leichter die Tierkadaver "
    "aushoehlen, ohne dass seine Federn dabei verkleben.");
  SetProp(P_NAME, "Aasgeier");
  SetProp(P_GENDER, MALE);
  AddId( ({ "aasgeier","geier" }) );

  create_default_npc(12+random(4));
  SetProp(P_HANDS, ({" mit seinem starken Schnabel",
                   QueryProp(P_HANDS)[1]+50,DT_RIP}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 45+random(15));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.1, DT_COLD:       0.0, DT_WATER:  0.0, DT_AIR:   -1.0,
      DT_LIGHTNING: -0.8, DT_EXPLOSION: -0.1, DT_SOUND:  0.0, DT_LIGHT: -1.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.1, DT_POISON: 0.1, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC: -0.1 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MNPC_AREA, (ROOM "desert") );
  SetProp(P_MNPC_WAIT, ({ 10+random(10), 15, 15 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "desert:10:10");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_MAYLOAD);

  SetProp(P_MSGIN, "kommt angeflogen");
  SetProp(P_MSGOUT, "fliegt weiter");

  SetProp(P_DIE_MSG,  " stuerzt ab.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Aasgeier kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(1,200,
    "Der Aasgeier stuerzt sich auf Deinen Kopf.\n",
    "Der Aasgeier stuerzt sich auf @WESSEN Kopf.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,250,
    "Der Aasgeier hackt wie wild auf Dich ein.\n",
    "Der Aasgeier hackt wie wild auf @WEN ein.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Aasgeier landet neben Dir auf dem Boden.\n",
    "Der Aasgeier sucht nach Aas.\n",
    "Der Aasgeier sucht nach Kadavern.\n",
    "Der Aasgeier hebt kurz ab und landet wieder.\n",
    "Der Aasgeier schaut Dich erwartungsvoll an.\n",
    "Der Aasgeier denkt wohl bald bist Du sein naechstes Essen.\n",
    "Der Magen des Aasgeiers knurrt Dir hungrig entgegen.\n"}) );
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}

heart_beat() {
  object ob,env;
  ::heart_beat();
  if(env=MENV) {
    if(ob=present("Leiche",env)) {
      tell_room(env,BS(
        "Der Aasgeier stuerzt sich auf die Leiche und wie wild vertilgt er "
        "sie bis auf die letzten Knochen. Vorerst satt und zufrieden glaubst "
        "Du ein Grinsen auf seinem Schnabel zu erkennen."));
      ob->remove();
    }
  }
}
