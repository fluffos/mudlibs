
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Eine Klapperschlange");
  SetProp(P_LONG,
    "Diese unscheinbare graubraune Klapperschlange hat ihren Namen von den "
    "bis zu zwanzig hornigen Schwanzgliedern, die heftig klappern, wenn "
    "die Schlange erregt ist. Sie ist fast drei Menschenschritte lang und "
    "stellt wegen ihrer aggressiven Art eine Gefahr fuer jedes Lebewesen dar.");
  SetProp(P_NAME, "Klapperschlange");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "klapperschlange","schlange" }) );

  create_default_npc(13+random(3));
  SetProp(P_HANDS, ({" mit ihren giftigen Zaehnen",
                   QueryProp(P_HANDS)[1],DT_POISON}));
  SetProp(P_RACE, "Schlange");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 20+random(5));
  SetProp(P_ALIGN, -150);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_AGGRESSIVE, 0.3);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.1, DT_COLD:       0.1, DT_WATER:   0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: -0.1, DT_EXPLOSION: -0.1, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:      -1.0, DT_POISON: -1.0, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  -0.2 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt schlaengelnd an");
  SetProp(P_MSGOUT, "windet sich weiter");

  SetProp(P_DIE_MSG,  " landet toedlich getroffen im Sand.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Klapperschlange kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,40);

  AddDefaultSpell(1, 350, DS_POISON, 
    "Die Klapperschlange vergiftet Dich mit einem starken Biss.\n",
    "Die Klapperschlange vergiftet @WEN mit einem starken Biss.\n");

  AddSpell(4,250,
    "Die Klapperschlange beisst Dir ins Bein.\n",
    "Die Klapperschlange beisst @WEM ins Bein.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,200,
    "Die Klapperschlange beisst Dir in den Fuss.\n",
    "Die Klapperschlange beisst @WEM in den Fuss.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Die Klapperschlange klappert mit ihren Schwanzgliedern.\n",
    "Die Klapperschlange klappert aergerlich laut herum.\n",
    "Die Klapperschlange windet sich lautlos durch den Sand.\n",
    "Die Klapperschlange baut sich gefahrvoll vor Dir auf.\n",
    "Lautes Klappern geht von der Schlange aus.\n"}) );
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
