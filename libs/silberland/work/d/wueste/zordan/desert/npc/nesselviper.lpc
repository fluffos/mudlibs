
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Eine Nesselviper");
  SetProp(P_LONG,
    "Die Nesselviper ist eine kleine Giftschlange, die bis ca. 2 "
    "Menschenschritt lang wird, waehrend der Koerper so schlank bleibt, dass "
    "er mit einer Hand leicht zu umfassen ist. Die graugelb gebaenderte "
    "Nesselviper lebt bevorzugt in der Naehe der Steppe und ernaehrt sich "
    "dort von kleinen Nagetieren. Sie greift nur sehr selten selbstaendig an. "
    "Ihr Gift ist weit und breit gefuerchtet.");
  SetProp(P_NAME, "Nesselviper");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "nesselviper","viper" }) );

  create_default_npc(12+random(3));
  SetProp(P_HANDS, ({" mit ihren giftigen Zaehnen",
                   QueryProp(P_HANDS)[1],DT_POISON}));
  SetProp(P_RACE, "Schlange");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 5+random(2));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_AGGRESSIVE, 0.01);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.0, DT_COLD:       0.1, DT_WATER:   0.1, DT_AIR:    0.0, 
      DT_LIGHTNING: -0.1, DT_EXPLOSION: -0.1, DT_SOUND:   0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:      -1.0, DT_POISON: -1.0, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  -0.5 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "schlaengelt herein");
  SetProp(P_MSGOUT, "schlaengelt weiter");

  SetProp(P_DIE_MSG,  " liegt tot im Sand.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Nesselviper kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,80);

  AddDefaultSpell(1, 400, DS_POISON, 
    "Die Nesselviper vergiftet Dich mit einem flinken Biss.\n",
    "Die Nesselviper vergiftet @WEN mit einem flinken Biss.\n");

  AddSpell(4,250,
    "Die Nesselviper beisst Dir in den Fuss.\n",
    "Die Nesselviper beisst @WEM in den Fuss.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Die Nesselviper kruemmt sich.\n",
    "Die Nesselviper huscht ueber den warmen Sand.\n",
    "Die Nesselviper verschwindet kurz im Sand.\n",
    "Die Nesselviper liegt regungslos am Boden.\n",
    "Die Nesselviper windet sich durch den Sand.\n"}) );
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
