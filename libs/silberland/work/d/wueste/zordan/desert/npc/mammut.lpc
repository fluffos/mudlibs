
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;

  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Ein riesiges Mammut");
  SetProp(P_LONG,
    "Mammuts sind die wandelnden Berge der Steppe und Wueste. Die mit dichtem, "
    "rotbraunen Fell behaarten Riesen ziehen rastlos ueber die Landschaft, "
    "wobei sie sogar bis in die entlegensten Gegenden auf ihrer Nahrungssuche "
    "vordringen. Gejagt werden normalerweise nur alte Tiere, die der Herde "
    "nicht mehr folgen konnten. Aus ihren Elfenbeinen gewinnt man das "
    "Mammuton.");
  SetProp(P_NAME, "Mammut");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "mammut" }) );

  create_default_npc(25+random(5));
  SetProp(P_HANDS, ({" mit seinem gewaltigen Koerper",
                   QueryProp(P_HANDS)[1]+50,DT_BLUDGEON}));
  SetProp(P_RACE, "Mammut");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 400+random(100));
  SetProp(P_ALIGN, 150);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.7, DT_COLD:       0.1, DT_WATER: -1.0, DT_AIR:   -0.2,
      DT_LIGHTNING: -0.7, DT_EXPLOSION: -0.3, DT_SOUND: -0.2, DT_LIGHT: -0.2,
      DT_ELECTRIC:   0.0, DT_ACID:      -0.3, DT_POISON: 0.1, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC: -0.2 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt laut stampfend an");
  SetProp(P_MSGOUT, "geht stampfend weiter");

  SetProp(P_DIE_MSG,  " bricht mit einem lauten Getoese zusammen.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Das Mammut zerstoert @WEN mit einem Tritt.\n" }) );

  SetProp(P_SPELLRATE,70);

  AddSpell(3,300,
    "Das Mammut gibt Dir einen harten Tritt.\n",
    "Das Mammut gibt @WEM einen harten Tritt.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,400,
    "Das Mammut reisst Deinen Koerper mit seinen Elfenbeinen auf.\n",
    "Das Mammut reisst @WESSEN Koerper mit seinen Elfenbeinen auf.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,500,
    "Das Mammut begraebt Dich unter sich.\n",
    "Das Mammut begraebt @WEN unter sich.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1,200,DS_PARALYZE,
    "Das Mammut begraebt Dich unter sich und Du wirst bewusstlos.\n",
    "Das Mammut begraebt @WEN unter sich und @WER wird bewusstlos.\n",
    2);


  SetChats(1, ({
    "Das Mammut sucht hier nach Nahrung.\n",
    "Das Mammut beachtet Dich nicht als Feind.\n",
    "Das Mammut trampelt herum.\n",
    "Das Mammut stoesst einen lauten Schrei aus.\n",
    "Das Mammut graebt behaebig im Sand.\n",
    "Das Mammut haette Dich fast zerquetscht.\n"}) );
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
