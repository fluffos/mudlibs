
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Ein Wuestenfuchs");
  SetProp(P_LONG,
    "Wuestenfuechse sind die am weitesten verbreitete Fuchsart. Sie sind "
    "mutiger als ihre roten und silbernen Artgenossen und trauen sich Nachts "
    "auch in kleine Siedlungen und Zeltplaetze. Ihnen wird selten wegen ihres "
    "Fells nachgestellt, weil es sehr struppig und somit wertlos ist.");
  SetProp(P_NAME, "Wuestenfuchs");
  SetProp(P_GENDER, MALE);
  AddId( ({ "wuestenfuchs","fuchs" }) );

  create_default_npc(13+random(3));
  SetProp(P_HANDS, ({" mit seinem scharfen Gebiss",
                   QueryProp(P_HANDS)[1],DT_RIP}));
  SetProp(P_RACE, "Fuchs");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 50+random(20));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.1, DT_COLD:       0.1, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: -0.1, DT_EXPLOSION: -0.1, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  0.1 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "streunert herein");
  SetProp(P_MSGOUT, "streunert");

  SetProp(P_DIE_MSG,  " faellt toedlich getroffen zu Boden.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Wuestenfuchs kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,45);

  AddSpell(2,250,
    "Der Wuestenfuchs beisst Dir ins Bein.\n",
    "Der Wuestenfuchs beisst @WEM ins Bein.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,400,
    "Der Wuestenfuchs reisst Dir ein Stueck Fleisch aus dem Koerper.\n",
    "Der Wuestenfuchs reisst @WEM ein Stueck Fleisch aus dem Koerper.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Wuestenfuchs schabt im Boden herum.\n",
    "Der Wuestenfuchs heult leise auf.\n",
    "Der Wuestenfuchs sucht nach neuer Beute.\n",
    "Der Wuestenfuchs schaut Dich misstrauisch an.\n",
    "Der Wuestenfuchs laeuft neugierig um Dich herum.\n"}) );

  clone_object("/d/ebene/lostboy/steppe/armour/fuchsfell")->move(this_object(), 2);
  command_me("trage fell");
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
