
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Eine Wuestenspinne");
  SetProp(P_LONG,
    "Diese kleine Spinne hat sich der Umgebung der heissen Wueste perfekt "
    "angepasst. Sie schafft es mit Leichtigkeit Beute zu fangen, indem sie "
    "sie zwischen die Steine ihr Netz spannt. Ihre Beine sind besonders "
    "ausgepraegt, damit sie dem heissen Sand wiederstehen koennen.");
  SetProp(P_NAME, "Wuestenspinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({"wuestenspinne", "spinne"}));

  create_default_npc(8+random(3));
  SetProp(P_HANDS, ({" mit ihren acht Beinen",
                   QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 10+random(5));
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_ALIGN, -50);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      0.1, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: -1.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: -1.0, DT_TERROR: 0.1,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");

  SetProp(P_DIE_MSG,  " ist toedlich getroffen im Sand verschwunden.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Wuestenspinne kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,25);
  AddSpell(1,200,
    "Die Wuestenspinne beisst Dir in den Fuss.\n",
    "Die Wuestenspinne beisst @WEM in den Fuss.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));

  SUID;
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
