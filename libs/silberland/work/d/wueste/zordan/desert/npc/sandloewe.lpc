
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Ein Sandloewe");
  SetProp(P_LONG,
    "Der Sandloewe ist der Koenig der Wueste. Er hat ein sandgelbes Fell, "
    "eine dunkle Maehne und ins Schwaerzliche spielenden Schwanz. "
    "Er ist gedrungen gebaut und erreicht bei einer Schulterhoehe von "
    "sechs Menschenspann eine Laenge von etwa zwei Menschenschritt. Solche "
    "Loewen leben normalerweise in Rudeln. Aber dieser scheint verstossen "
    "worden zu sein.");
  SetProp(P_NAME, "Sandloewe");
  SetProp(P_GENDER, MALE);
  AddId( ({ "sandloewe","loewe" }) );

  create_default_npc(20+random(3));
  SetProp(P_HANDS, ({" mit seinen starken Pranken",
                   QueryProp(P_HANDS)[1]+100,DT_RIP}));
  SetProp(P_RACE, "Sandloewe");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 120+random(20));
  SetProp(P_ALIGN, -150);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.1, DT_COLD:       0.1, DT_WATER:  0.0, DT_AIR:     0.0, 
      DT_LIGHTNING: -0.3, DT_EXPLOSION: -0.2, DT_SOUND:  0.0, DT_LIGHT:  -0.1,
      DT_ELECTRIC:   0.0, DT_ACID:       0.1, DT_POISON: 0.1, DT_TERROR: -0.1,
      DT_HOLY:       0.1, DT_UNHOLY:    -0.1, DT_MAGIC: -0.1 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "kommt auf seinem Streifzug an");
  SetProp(P_MSGOUT, "streift weiter");

  SetProp(P_DIE_MSG,  " bricht toedlich getroffen zusammen.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Sandloewe kann sicher jede Menge tragen.\n" }) );

  SetProp(P_SPELLRATE,40);
  AddSpell(1,275,
    "Der Sandloewe erwischt Dich mit seiner Pranke voll am Koerper.\n",
    "Der Sandloewe erwischt @WEN mit seiner Pranke voll am Koerper.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,360,
    "Der Sandloewe beisst Dir mitten in den Magen.\n",
    "Der Sandloewe beisst @WEM mitten in den Magen.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Sandloewe streift umher.\n",
    "Der Sandloewe schaut sich jede Deiner Bewegungen genau an.\n",
    "Der Sandloewe sucht seine Artgenossen.\n",
    "Der Sandloewe sucht nach Nahrung.\n",
    "Der Sandloewe bruellt laut auf.\n",
    "Der Sandloewe putzt eine seiner Pranken.\n"}) );
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
