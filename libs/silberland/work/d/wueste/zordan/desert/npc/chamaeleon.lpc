
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Ein Chamaeleon");
  SetProp(P_LONG,
    "Dieses Chamaeleon hat einen langen Schwanz und einen hohen Kamm. "
    "Es ist so ungefaehr einen halben Schritt lang und gehoert somit zu "
    "den laengsten seiner Gattung. Mit der langen und klebrigen Zunge "
    "zuengelt es nach Beute, wie Maeuse und kleine Voegel, in seiner "
    "Reichweite.");
  SetProp(P_NAME, "Chamaeleon");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "chamaeleon" }) );

  create_default_npc(7+random(3));
  SetProp(P_HANDS, ({" mit seiner klebrigen Zunge",
                   QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Chamaeleon");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 40+random(10));
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.1, DT_COLD:       0.2, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: -0.1, DT_EXPLOSION: -0.1, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  0.0 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "huscht herein");
  SetProp(P_MSGOUT, "huscht");

  SetProp(P_DIE_MSG,  " landet toedlich getroffen im Sand.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Chamaeleon kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,15);
  AddSpell(1,150,
    "Das Chamaeleon bleibt mit seiner Zunge an Dir kleben.\n",
    "Das Chamaeleon bleibt mit seiner Zunge an @WEM kleben.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Das Chamaeleon zuengelt laut herum.\n",
    "Das Chamaeleon huscht zwischen Deinen Beinen hindurch.\n",
    "Das Chamaeleon faengt ein kleines Insekt.\n",
    "Das Chamaeleon aendert kurzzeitig seine Farbe.\n",
    "Das Chamaeleon erscheint fast durchsichtig.\n"}) );
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
