
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Ein Sandtiger");
  SetProp(P_LONG,
    "Sandtiger sind eine riesige, ungemein gefaehrliche Raubkatzenart. "
    "Sie werden oft bis zu drei Menschenschritt lang und fast sieben "
    "Menschenspann hoch. Sandtiger haben ein ausgedehntes Revier, das er "
    "gegen Eindringlinge verbissen verteidigt. Ein angegriffener Sandtiger "
    "verfaellt in einen richtigen Kampfrausch.");
  SetProp(P_NAME, "Sandtiger");
  SetProp(P_GENDER, MALE);
  AddId( ({ "sandtiger","tiger" }) );

  create_default_npc(25+random(3));
  SetProp(P_HANDS, ({" mit seinen starken Pranken",
                   QueryProp(P_HANDS)[1]+120,DT_RIP}));
  SetProp(P_RACE, "Sandtiger");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 140+random(20));
  SetProp(P_ALIGN, -350);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.1, DT_COLD:       0.0, DT_WATER:  0.0, DT_AIR:     0.0, 
      DT_LIGHTNING: -0.3, DT_EXPLOSION: -0.2, DT_SOUND:  0.0, DT_LIGHT:  -0.1,
      DT_ELECTRIC:   0.0, DT_ACID:       0.0, DT_POISON: 0.0, DT_TERROR: -0.1,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC: -0.3 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "streift auf seinem Rundgang herein");
  SetProp(P_MSGOUT, "streift weiter");

  SetProp(P_DIE_MSG,  " bricht toedlich getroffen zusammen.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Der Sandtiger frisst @WEN einfach auf.\n" }) );

  SetProp(P_SPELLRATE,60);

  AddSpell(3,315,
    "Der Sandtiger reisst Deinen Magen auf.\n",
    "Der Sandtiger reisst @WESSEN Magen auf.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,500,
    "Der Sandtiger bruellt Dich laut an.\n",
    "Der Sandtiger bruellt @WEN laut an.\n",
     DT_SOUND,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der Sandtiger betrachtet Dich als sein Mittagessen.\n",
    "Der Sandtiger ist auf der Suche nach neuer Beute.\n",
    "Der Sandtiger knurrt.\n",
    "Der Sandtiger graebt mit einer Pranke im Sand.\n",
    "Der Sandtiger schnurrt.\n"}) );
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy) {
  ModifySkillAttribute(ME,SA_SPEED,200,5);
  ::Defend(dam, dam_type, spell, enemy);
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
