
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Eine Panzerechse");
  SetProp(P_LONG,
    "Einen gefaehrlichen Gegner stellt diese Panzerechse dar. Ihre dicke "
    "Haut vermag kaum durch ein Schwert durchbohrt werden. Sie macht einen "
    "eher phlegmatischen Eindruck, wie alle Echsenarten. Ihr gewaltiger "
    "Kiefer schlaegt sich durch fast jede Ruestung hindurch.");
  SetProp(P_NAME, "Panzerechse");
  SetProp(P_GENDER, FEMALE);
  AddId(({"panzerechse", "echse"}));

  create_default_npc(14+random(4));
  SetProp(P_HANDS, ({" mit ihrem starken Kiefer",
                   QueryProp(P_HANDS)[1]+100,DT_PIERCE}));
  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 50+random(25));
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_ALIGN, -250);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      0.1, DT_WATER:  -0.5, DT_AIR:    -0.2, 
      DT_LIGHTNING: -0.2, DT_EXPLOSION: -1.0, DT_SOUND:  -0.2, DT_LIGHT:  -1.0,
      DT_ELECTRIC:  -0.2, DT_ACID:      -0.2, DT_POISON: -1.0, DT_TERROR: 0.1,
      DT_HOLY:      0.1, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );

  SetProp(P_MNPC_AREA, (ROOM "desert") );
  SetProp(P_MNPC_WAIT, ({ 10+random(10), 10, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "desert:10:10");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_MAYLOAD);

  SetProp(P_MSGIN, "kriecht flink herein");
  SetProp(P_MSGOUT, "kriecht flink");

  SetProp(P_DIE_MSG,  " windet sich noch einmal und stirbt.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Panzerechse kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,50);
  AddSpell(3,200,
    "Die Panzerechse schnellt auf Dich zu und beisst Dir fest in das Bein.\n",
    "Die Panzerechse schnellt auf @WEN zu und beisst @WEM fest in das Bein.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,400,
    "Die Panzerechse bohrt sich tief in Dein Fleisch.\n",
    "Die Panzerechse bohrt sich tief in @WESSEN Fleisch.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SUID;
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
