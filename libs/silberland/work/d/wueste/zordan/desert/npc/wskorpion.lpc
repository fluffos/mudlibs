
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Ein Wuestenskorpion");
  SetProp(P_LONG,
    "Dieser ungemein gefaehrliche Wuestenskorpion ist fast so lang wie der "
    "Arm eines Menschen. Das Gift des Wuestenskorpions hat schon so manchen "
    "Abenteurer nicht mehr aus der Wueste zureuckkehren lassen. Er ist "
    "gelbbraun gebaendert.");
  SetProp(P_NAME, "Wuestenskorpion");
  SetProp(P_GENDER, MALE);
  AddId(({"wuestenskorpion", "skorpion"}));

  create_default_npc(9+random(3));
  SetProp(P_HANDS, ({" mit seinem giftigen Stachel",
                   QueryProp(P_HANDS)[1],DT_POISON}));
  SetProp(P_RACE, "Skorpion");
  SetProp(P_SIZE, 40+random(10));
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -1.0, DT_COLD:      0.1, DT_WATER:  0.0, DT_AIR:    0.0, 
      DT_LIGHTNING: 0.0, DT_EXPLOSION: -1.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:  0.0, DT_ACID:      0.0, DT_POISON: -1.0, DT_TERROR: 0.0,
      DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:  0.0 ]) );
//  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");

  SetProp(P_DIE_MSG,  " ist tod.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Wuestenskorpion kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(1,250,
    "Der Wuestenskorpion trifft Dich mitten ins Bein.\n",
    "Der Wuestenskorpion trifft @WEN mitten ins Bein.\n",
     DT_POISON,([SP_SHOW_DAMAGE:1]));

  SUID;
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
