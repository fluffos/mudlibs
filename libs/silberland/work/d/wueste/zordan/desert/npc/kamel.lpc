
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Ein Kamel");
  SetProp(P_LONG,
    "Dieses fast drei Menschenschritte hohe Kamel kann in seinen Fetthoeckern "
    "Wasser fuer vier bis fuenf Tage speichern. Es ist von sandgelber bis "
    "dunkelbrauner Farbe und besitzt eine Menge Haare am Hals, an den Hoeckern "
    "und unter dem Bauch. Es ernaehrt sich vornehmlich von Datteln oder den "
    "Trieben von Dornbueschen.");
  SetProp(P_NAME, "Kamel");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "kamel" }) );

  create_default_npc(15+random(3));
  SetProp(P_HANDS, ({" mit seinen starken Hufen",
                   QueryProp(P_HANDS)[1]+100,DT_BLUDGEON}));
  SetProp(P_RACE, "Kamel");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 250+random(50));
  SetProp(P_ALIGN, 250);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.1, DT_COLD:       0.1, DT_WATER: -1.0, DT_AIR:    0.0, 
      DT_LIGHTNING: -0.3, DT_EXPLOSION: -0.2, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.1, DT_POISON: 0.1, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  0.0 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");

  SetProp(P_DIE_MSG,  " bricht toedlich getroffen zusammen.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Das Kamel kann sicher jede Menge tragen.\n" }) );

  SetProp(P_SPELLRATE,30);
  AddSpell(1,250,
    "Das Kamel versucht Dich mit einem starken Hufschlag zu erwischen.\n",
    "Das Kamel versucht @WEN mit einem starken Hufschlag zu erwischen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,300,
    "Das Kamel versucht Dich auf den Boden zu druecken.\n",
    "Das Kamel versucht @WEN auf den Boden zu druecken.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Das Kamel kaut vor sich hin.\n",
    "Das Kamel sucht nach Nahrung.\n",
    "Das Kamel schaut Dich treuherzig an.\n",
    "Die Hoecker des Kamels bewegen sich leicht.\n",
    "Die Haare vom Kamel wehen im Wind.\n"}) );
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
