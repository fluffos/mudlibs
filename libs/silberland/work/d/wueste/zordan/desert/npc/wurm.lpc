
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  if (!DESERTMASTER->newnpc(TO)) {
    destruct(TO);
    return;
  }
  ::create();

  SetProp(P_SHORT, "Ein winziger Wurm");
  SetProp(P_LONG,
    "Ein kleiner Wurm hat sich doch tatsaechlich in die Wueste verirrt. "
    "Oder sollte das hier eine ganz spezielle Art sein, die es schafft mit "
    "wenig Wasser und viel Hitze zurechtzukommen? Die rote Haut des Wurmes "
    "laesst jedenfalls darauf schliessen. Seltsam, dieser Wurm scheint ein "
    "richtiges Gebiss zu haben.");
  SetProp(P_NAME, "Wurm");
  SetProp(P_GENDER, MALE);
  AddId( ({ "wurm" }) );

  create_default_npc(5+random(3));
  SetProp(P_HANDS, ({" mit seinem Gebiss",
                   QueryProp(P_HANDS)[1],DT_BLUDGEON}));
  SetProp(P_RACE, "Wurm");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:70]));
  SetProp(P_SIZE, 5+random(5));
  SetProp(P_ALIGN, 50);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:      -0.5, DT_COLD:       0.1, DT_WATER: -1.0, DT_AIR:    0.0,
      DT_LIGHTNING: -0.4, DT_EXPLOSION: -0.1, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC:   0.0, DT_ACID:       0.2, DT_POISON: 0.2, DT_TERROR: 0.0,
      DT_HOLY:       0.0, DT_UNHOLY:     0.0, DT_MAGIC:  0.0 ]) );
//  SetProp(P_ARTICLE, 0);

  SetProp(P_MSGIN, "windet sich herein");
  SetProp(P_MSGOUT, "windet weiter");

  SetProp(P_DIE_MSG,  " liegt platt zerdrueckt im Sand.\n");

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Wurm kann @WEN nicht tragen.\n" }) );

  SetProp(P_SPELLRATE,40);
  AddSpell(1,200,
    "Der Wurm spuckt eine seltsame Fluessigkeit auf Deinen Fuss.\n",
    "Der Wurm spuckt eine seltsame Fluessigkeit auf @WESSEN Fuss.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,150,
    "Der Wurm beisst Dir in den Fuss.\n",
    "Der Wurm beisst @WEM in den Fuss.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
    "Der winzige Wurm verkriecht sich kurz im Sand.\n",
    "Der winzige Wurm hinterlaesst eine kleine Schleifspur im Sand.\n",
    "Der winzige Wurm klettert Dir ueber Deinen Fuss.\n",
    "Der winzige Wurm buddelt im Sand herum.\n",
    "Der winzige Wurm windet sich ueber den Sand.\n",
    "Der winzige Wurm luckt mit seinem Kopf aus dem Sand heraus.\n"}) );
}

remove() {
  if(TO) DESERTMASTER->removenpc(TO);
  ::remove();
}
