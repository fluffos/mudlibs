
#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

object *pl;

create() {
  ::create();

  pl=({ });

  SetProp( P_INT_SHORT, "In einem Sandsturm gefangen" );
  SetProp( P_INT_LONG,
    "Du bist mitten in einem grossen Sandsturm und kannst nichts mehr ausser "
    "viel umherwirbelndem Sand sehen." );
  SetProp( P_LIGHT, 1 );
  SetProp( P_NOQUIT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_DESERT]) );

  AddRoomMessage( 
    ({ "Der Sand laesst Deine Augen traenen.\n",
       "Du stolperst und faellst in den Sand.\n",
       "War da nicht gerade ein Lebewesen hinter Dir?\n",
       "Der Wind peitscht Dir um die Ohren.\n",
       "Im Norden meinst Du etwas zu erkennen.\n",
       "Im Osten war doch gerade was, oder?\n",
       "Ob Du diesen Sturm ueberleben wirst?\n",
       "Du glaubst nicht jemals wieder hier lebend herauszukommen.\n",
       "Vor lauter Angst verkriechst Du Dich im Sand.\n",
       "Die Gegend kommt Dir immer unterschiedlicher vor.\n",
       "Ein kleiner Kaefer vergraebt sich im Boden.\n",
       "Irgendetwas beruehrte gerade Deinen Fuss.\n",
       "Der Sturm laesst langsam nach.\n",
       "Du glaubst Du bist in der Hoelle.\n",
       "War da im Westen nicht eine Stadt zu erkennen?\n",
       "Du verfluchst die Goetter.\n",
       "Die Sonne ist nicht mehr zu erkennen.\n",
       "Der Wind treibt Dich nach Sueden weiter.\n",
       "Der Wind laesst langsam nach.\n",
       "Du solltest nicht zuviel herumirren.\n",
       "Du denkst   . o O (Das ist mein Ende)\n",
       "Du wuenscht Dir Deine Feinde an diesen Ort.\n",
       "Der Sandsturm wird immer schlimmer.\n",
       "Du kannst Deine Hand nicht mehr vor Augen sehen.\n" })
    ,30);

  AddExit( "norden",     "./sturm" );
  AddExit( "sueden",     "./sturm" );
  AddExit( "osten",      "./sturm" );
  AddExit( "westen",     "./sturm" );
  AddExit( "nordwesten", "./sturm" );
  AddExit( "nordosten",  "./sturm" );
  AddExit( "suedosten",  "./sturm" );
  AddExit( "suedwesten", "./sturm" );
}

reset() {
  ::reset();
  pl=({ });
}

init() {
  ::init();
  AddExit( "norden",     "./sturm" );
  AddExit( "sueden",     "./sturm" );
  AddExit( "osten",      "./sturm" );
  AddExit( "westen",     "./sturm" );
  AddExit( "nordwesten", "./sturm" );
  AddExit( "nordosten",  "./sturm" );
  AddExit( "suedosten",  "./sturm" );
  AddExit( "suedwesten", "./sturm" );
  if(random(100)>50) RemoveExit("norden");
  if(random(100)>50) RemoveExit("sueden");
  if(random(100)>50) RemoveExit("westen");
  if(random(100)>50) RemoveExit("osten");
  if(random(100)>50) RemoveExit("nordwesten");
  if(random(100)>50) RemoveExit("nordosten");
  if(random(100)>50) RemoveExit("suedosten");
  if(random(100)>50 && sizeof(QueryProp(P_EXITS))>1) RemoveExit("suedwesten");
  if(interactive(TP)) {
    if(random(100)>97) call_out("endesturm",0,TP);
    if(member(pl,TP) == -1) {
      call_out("endesturm",200+random(100),TP);
      pl+=({ TP });
    }
  }
}

endesturm(object ob) {
  pl-=({ ob });
  if(!objectp(ob)) {
    return;
  }
  if(!present(ob,ME) || !interactive(ob)) {
    return;
  }
  tell_object(ob,BS(
    "Du jubelst, endlich laesst der Sandsturm nach und nach einer Weile "
    "stehst Du wieder mitten in der heissen Wueste. Wo, das weisst Du "
    "allerdings nicht mehr, denn Du hast die Orientierung vollends verloren."));
  DESERTMASTER->freeplayer(ob);
}

