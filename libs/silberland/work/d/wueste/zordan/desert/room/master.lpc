  if (sscanf(file,"%s:%d:%d%s",foo,x,y,foo2)!=4) {
    write("*** Fehler in AddNpc: Hier ist kein gueltiger Raum der Wueste!\n");
    return -2;
  }
  if (x<0 || x>139 || y<0 || y>49) {
    write("*** Fehler in AddNpc: Hier ist kein gueltiger Raum der Wueste!\n");
    return -2;
  }
