//////////////////////////////////////////////////////////////////////////////
//
// Die beiden Sandstuerme
//
//////////////////////////////////////////////////////////////////////////////

int GetSturm() {
  if(!secure()) return -1;
  write(sprintf("Sandsturm 1: x=%i y=%i r=%i\n",xpos1,ypos1,r1));
  write(sprintf("Sandsturm 2: x=%i y=%i r=%i\n",xpos2,ypos2,r2));
  return 1;
}

void MoveStuerme() {
  switch(random(8)) {
    case 0: if(xpos1>0)   xpos1--;
            break;
    case 1: if(xpos1<138) xpos1++;
            break;
    case 2: if(ypos1>0)   ypos1--;
            break;
    case 3: if(ypos1<48)  ypos1++;
            break;
    case 4: if(xpos1>0)   xpos1--;
            if(ypos1>0)   ypos1--;
            break;
    case 5: if(xpos1>0)   xpos1--;
            if(ypos1<48)  ypos1++;
            break;
    case 6: if(xpos1<138) xpos1++;
            if(ypos1>0)   ypos1--;
            break;
    case 7: if(xpos1<138) xpos1++;
            if(ypos1<48)  ypos1++;
            break;
  }
  switch(random(8)) {
    case 0: if(xpos2>0)   xpos2--;
            break;
    case 1: if(xpos2<138) xpos2++;
            break;
    case 2: if(ypos2>0)   ypos2--;
            break;
    case 3: if(ypos2<48)  ypos2++;
            break;
    case 4: if(xpos2>0)   xpos2--;
            if(ypos2>0)   ypos2--;
            break;
    case 5: if(xpos2>0)   xpos2--;
            if(ypos2<48)  ypos2++;
            break;
    case 6: if(xpos2<138) xpos2++;
            if(ypos2>0)   ypos2--;
            break;
    case 7: if(xpos2<138) xpos2++;
            if(ypos2<48)  ypos2++;
            break;
  }
}

nosave int isinsturm(int x,int y) {
  float rs1,rs2;
  rs1=sqrt(((float)xpos1-(float)x)*((float)xpos1-(float)x)+
           ((float)ypos1-(float)y)*((float)ypos1-(float)y));
  rs2=sqrt(((float)xpos2-(float)x)*((float)xpos2-(float)x)+
           ((float)ypos2-(float)y)*((float)ypos2-(float)y));
  if((int)rs1<=r1) return 1;
  if((int)rs2<=r2) return 1;
  return 0;
}

void freeplayer(object pl) {
  int x,y;
  string str;
  while(map[y][x..x] != ".") {
    x=random(139);
    y=random(49);
  }
  str=ROOM "desert:"+x+":"+y;
  pl->move(str, M_GO + M_SILENT);
}
