#include "../def.h"

inherit "std/virtual/v_compiler";

#include <properties.h>
#include <v_compiler.h>
#include <wizlevels.h>

#define P_ROOMS "raum"

create() {
  ::create();
  SetProp(P_COMPILER_PATH, ROOM "" );
  SetProp(P_STD_OBJECT, ROOM "desert" );
  SetProp(P_ROOMS, ({"desert"}) );
}

string Validate(string file) {
  string name,foo;
  int xl,yl;

  file = ::Validate(file);
  if ((sscanf(file, "%s:%d:%d%s",name,xl,yl,foo) == 4) &&
      (member(QueryProp(P_ROOMS), name) != -1)) {
    return name+":"+xl+":"+yl;
  }
  return 0;
}

int CustomizeObject() {
  string name,foo,foo2,*ind;
  string *str,*karte,npc;
  int xl,yl,i;
  mapping exits;
  object ob;

  if (!(name = ::CustomizeObject()) || sscanf(name,"%s:%d:%d%s",foo,xl,yl,foo2)!=4)
    return 0;
  str=({ });
  karte=DESERTMASTER->getkarte(xl,yl);
  str=DESERTMASTER->getlong(xl,yl);
  exits=DESERTMASTER->getexits(xl,yl);
  npc=DESERTMASTER->getnpc(xl,yl);
  if(sizeof(get_dir(npc+".lpc"))) {
    ob=clone_object(npc);
    if(ob) {
      ob->move(PO,M_GO);
    }
  }
  ind=m_indices(exits);
  for (i=0;i<sizeof(ind);i++) {
    PO->AddExit( ind[i], 
        ([ EX_DEST: exits[ind[i]], EX_TESTFUNC: "check_time" ]) );
  }
  PO->SetVars(karte,str[0],str[1],xl,yl);
  return 1;
}
