
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

#define ausgaben ({ \
  "Du stinkst am ganzen Koerper.", \
  "Du haeltst den Gestank kaum noch aus.", \
  "Du wirst fast wahnsinnig vor lauter Gestank.", \
  "Du musst Dich wegen dem Gestank fast uebergeben.", \
  "Haettest Du das Stinktier nur nie angegriffen.", \
  "Das Stinktier hat Dich voll erwischt.", \
  "Du haeltst Dir die Nase zu.", \
  "Der Gestank ist einfach nur pervers.", \
  "Du kannst keinen klaren Gedanken mehr fassen.", \
  "Der Gestank raubt Dir noch den Verstand.", \
  "Das Sekret vom Stinktier hat sich ueber Dich verteilt.", \
  "Das Sekret vom Stinktier ist der uebelste Gestank den Du kennst.", \
  "Du solltest Dich endlich wieder mal waschen gehen.", \
  "Mit diesem Gestank kannst Du nirgends mehr hingehen.", \
  "Das Stinktier anzugreifen wird Dir eine Lehre sein.", \
  "Pfuiiiii. DU STINKST!!!", \
  "Du stinkst wie der aelteste Troll.", \
  "Nichts auf dieser Welt stinkt so sehr wie Du im Moment.", \
  "Von dem Stinktier wirst Du ab jetzt die Finger lassen." })

#define ausgaben2 ({ \
  "stinkt bestialisch.", \
  "hat ein seltsames Sekret am Koerper.", \
  "stroemt einen heiden Gestank aus.", \
  "moechtest Du am Liebsten fuer immer meiden.", \
  "stinkt wirklich sehr hart.", \
  "hat sich wohl lange nicht mehr gewaschen.", \
  "sollte endlich mal wieder Baden gehen.", \
  "stinkt schlimmer als jede alte Socke.", \
  "strahlt einen Gestank aus, der nicht mehr auszuhalten ist.", \
  "mieft.", \
  "hat wohl etwas gegens Waschen." })

create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0 );
  SetProp(P_NAME, "Sekret vom Stinktier :P");
  SetProp(P_GENDER, NEUTER);
  AddId("\n_stinktier_sekret");

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
 
  call_out("stink",30+random(30));

}

reset() {
  object env;
  ::reset();
  if (!is_clone(TO)) return;
  if(env=MENV) {
    tell_object(env,BS(
      "Endlich hat sich der widerliche Gestank des Stinktieres verzogen. "
      "Du atmest sichtlich erleichtert endlich wieder frisch auf."));
  }
  ME->remove();
}

void stink() {
  object env,eenv;
  string pl;
  if(!env=MENV) {
    call_out("remove",0);
    return;
  }
  if(!living(env) || !query_once_interactive(env)) {
    call_out("remove",0);
    return;
  }
  tell_object(env,BS(ausgaben[random(sizeof(ausgaben))]));
  if((eenv=ENV(env)) && !random(3)) {
    pl=CAP(env->name());
    tell_room(eenv,BS(pl+" "+ausgaben2[random(sizeof(ausgaben2))]), ({ env }));
  }
  while(find_call_out("stink") != -1);
  call_out("stink",60+random(60));
}

string extra_look() {
  object player;
  if(!player=MENV) return "";
  if(player->QueryProp(P_GENDER)==FEMALE)
    return "Sie stinkt bestialisch und ein seltsames Sekret klebt an ihr.\n";
  else 
    return "Er stinkt bestialisch und ein seltsames Sekret klebt an ihm.\n";
}
