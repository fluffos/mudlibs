/*
** Elementarwaechter der beiden Sanddrachen
**
*/

#include "../def.h"

inherit MOST "mynpc";

nosave string element;

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_NAME, "Waechter");
  SetProp(P_ARTICLE,1);
  
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:70]));
  AddId(({SANDBURG,"waechter","elementarwaechter","druide","NOWIMPY"}));

  create_default_human(30);
  SetProp(P_HANDS, ({" mit seinen Haenden", QueryProp(P_HANDS)[1]+100,DT_BLUDGEON}));
  SetProp(P_BODY, 110);
  SetProp(P_ALIGN, 0);
  SetProp(P_HEAL, 250);
  SetProp(P_WIMPY, 0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_NOMAGIC,40+random(20));

  SetProp(P_MSGIN, "bildet sich aus den Elementen selbst");
  SetProp(P_MSGOUT, "loest sich in die Elemente auf");
  SetProp(P_MMSGIN, "bildet sich aus den Elementen selbst");
  SetProp(P_MMSGOUT, "loest sich in die Elemente auf");

  SetProp(P_DIE_MSG,  " stoehnt erschoepft auf und stirbt.\n");
  SetProp(P_MURDER_MSG, "Und wer wird nun Kraya und Kerek beschuetzen?!\n");
  SetProp(P_KILL_NAME, "Ein elementarer Druidenwaechter");
  SetProp(P_KILL_MSG, "Stoert die Ruhe der Sanddrachen nicht!\n");
  
  AddInfo(DEFAULT_INFO, "bruellt: Stirb, Fremder!\n");
  
  SetProp(P_REJECT, ({ 
    REJECT_DESTRUCT, "Elementare Waechter sind nicht bestechlich!\n"}));
  
  SetProp(P_GUILD, "druidenzirkel");
  SetProp(P_GUILD_LEVEL, 15);
  
  ModifySkill("laehme", 10000);
  ModifySkill("laehme", 
	      ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
		SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  
  SetProp(P_SPELLRATE,60+random(15));
  
  AddSpell(3,1,
	   "","", DT_BLUDGEON, "dspells");   
  AddSpell(2,1,
	   "","", DT_BLUDGEON, "drspells");   
  AddSpell(1,1,
	   "","", DT_BLUDGEON, "dla");   

  SUID;

  CLONEME("/gilden/druidenzirkel/armour/d_amulett");
  CLONEME("/gilden/druidenzirkel/armour/e_panzer");
  command("trage alles");

  element="";
}

string QueryElement()
{
  return element;
}

void DefineElement(string str)
{
  if(member(({"eis","feuer","wasser","erz"}), element)!=-1)
    return;

  if((!str) || (member(({"eis","feuer","wasser","erz"}), str)==-1))
    element=({"eis","feuer","wasser","erz"})[random(4)];
  else
    element=str;

  AddId("\n"+str);

  switch(element)
    {
    case "eis"   : SetProp(P_SHORT, "Ein elementarer Waechter des Eises");
      SetProp(P_LONG,
	      BS("Wuestest Du es nicht besser, wuerdest Du sagen, vor Dir "
		 "steht ein alter Mann mit einem langen Bart, bis zum "
		 "Bauchnabel, doch in Wahrheit, ist dies ein sehr erfahrener "
		 "Druide. An den Eiskristallen in seinen Haaren kannst Du "
		 "erkennen, dass sein Element, das des Eises ist. Er scheint "
		 "wuetend zu sein, dass Du hier bist!"));
      SetProp(P_NAME, "Waechter");
      SetProp(P_NAME_ADJ, "elementar");
      SetProp(P_GENDER, MALE);
      SetProp(P_HANDS, ({" mit seinen frostigen Haenden", 
			   QueryProp(P_HANDS)[1], DT_COLD}));
      SetProp(P_RESISTANCE, ({DT_COLD}));
      SetProp(P_VULNERABILITY, ({DT_POISON,DT_FIRE}));
      ModifySkill("froststrahl", 10000);
      ModifySkill("froststrahl", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                  SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
      ModifySkill("hagelschlag", 10000);
      ModifySkill("hagelschlag", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                   SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
      break;
    case "feuer" : SetProp(P_SHORT, "Eine elementare Waechterin des Feuers");
      SetProp(P_LONG,
	      BS("Die junge, bildhuebsche Frau funkelt Dich boese an. Bis auf "
		 "die Tatsache, dass sie keinerlei Haare hat, ihre Augen "
		 "glutrot sind und ihre Fingernaegel zu brennen scheinen, "
		 "sieht diese Frau eigentlich recht normal aus..."));
      SetProp(P_NAME, "Waechterin");
      SetProp(P_NAME_ADJ, "elementar");
      SetProp(P_GENDER, FEMALE);
      SetProp(P_HANDS, ({" mit ihren flammenden Haenden", 
			   QueryProp(P_HANDS)[1], DT_FIRE}));
      SetProp(P_RESISTANCE, ({DT_FIRE}));
      SetProp(P_VULNERABILITY, ({DT_COLD,DT_WATER}));
      ModifySkill("feuerball", 10000);
      ModifySkill("feuerball", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
      ModifySkill("feuersturm", 10000);
      ModifySkill("feuersturm", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                  SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
      break;
    case "wasser": SetProp(P_SHORT, "Ein elementarer Waechter des Wassers");
      SetProp(P_LONG,
	      BS("Der alte, baertige Mann vor Dir erinnert eher an einen "
		 "Zombie, der zulange im Wasser gelegen hat, als an einen "
		 "sehr maechtigen Druiden. In seinen Haaren befinden sich "
		 "Seetangstreifen und seine Haut ist total gruen und "
		 "schwammig. Er scheint wuetend auf Dich zu sein!"));
      SetProp(P_NAME, "Waechter");
      SetProp(P_NAME_ADJ, "elementar");
      SetProp(P_GENDER, MALE);
      SetProp(P_HANDS, ({" mit seinen feuchten Haenden", 
			   QueryProp(P_HANDS)[1], DT_WATER}));
      SetProp(P_RESISTANCE, ({DT_WATER}));
      SetProp(P_VULNERABILITY, ({DT_COLD,DT_FIRE}));
      ModifySkill("wasserstrahl", 10000);
      ModifySkill("wasserstrahl", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                    SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
      ModifySkill("sturmflut", 10000);
      ModifySkill("sturmflut", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
      break;
    case "erz"   : SetProp(P_SHORT, "Ein elementarer Waechter der Erde");
      SetProp(P_LONG,
	      BS("Auf den ersten Blick steht vor Dir eine steinerne Statue, "
		 "doch irgendwas ist anders! Sie lebt! Ja es ist in Wahrheit "
		 "ein aelterer Mann, dessen Haut weiss ist wie Marmor ist. "
		 "Durch sein jahrelanges Praktikum der Magie der Erzdruiden "
		 "ist sein Koerper wohl mutiert, doch das heisst nicht, dass "
		 "er an Agilitaet verloren haette..."));
      SetProp(P_NAME, "Waechter");
      SetProp(P_NAME_ADJ, "elementar");
      SetProp(P_GENDER, MALE);
      SetProp(P_HANDS, ({" mit seinen dornenbesetzten Haenden", 
			   QueryProp(P_HANDS)[1], DT_RIP}));
      SetProp(P_VULNERABILITY, ({DT_AIR}));
      ModifySkill("erzstrahl", 10000);
      ModifySkill("erzstrahl", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
      ModifySkill("erdbeben", 10000);
      ModifySkill("erdbeben", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
      break;
    default : DB("*** Bug by creating Element!!\n");
    }
}

void dla(object enemy,int damage, mixed dam_type)
{
  command_me("laehme "+enemy->name(WER,1));
}

void dspells(object enemy,int damage, mixed dam_type)
{
  switch(element)
    {
    case "erz"   : command_me("erzstrahl");    return;
    case "eis"   : command_me("froststrahl");  return;
    case "wasser": command_me("wasserstrahl"); return;
    case "feuer" : command_me("feuerball");    return;
    default : tell_room(ENV(TO), "*** BUG BUG BUG BUG Bitte PROtheG melden!\n");
    }
}

void drspells(object enemy,int damage, mixed dam_type)
{
  switch(element)
    {
    case "erz"   : command_me("erdbeben");    return;
    case "eis"   : command_me("hagelschlag");  return;
    case "wasser": command_me("sturmflut"); return;
    case "feuer" : command_me("feuersturm");    return;
    default : tell_room(ENV(TO), "*** BUG BUG BUG BUG Bitte PROtheG melden!\n");
    }
}

void die(int poisondeath) 
{
  object kugel, pa;

  write_file(LOG "druiden",
	     ctime()+": "+CAP(getuid(PL))+" toetet einen Waechter ("+element+").\n");
  
  kugel=clone_object(OBJ "kugel");
  kugel->DefineElement(element);
  kugel->move(ME, M_NOCHECK);
  
  BURG->RemoveElemental(ME);
  
  if(pa=present("elementarpanzer", TO))
    pa->panzer_weg(100);
  
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer==TO)
    write_file(LOG "playerdeath",
	       ctime()+": "+CAP(getuid(player))+" stirbt an "+TO->name(WEM)+" ["+lostexp+"]\n");
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;
  if(touch)
    call_out("reaction",0,TP,
	     "bruellt: Stirb, Du schwaechstes Mitglied der "+CAP(TP->QueryProp(P_GUILD))+"\n",
	     "bruellt "+TP->name(WEN,1)+" an.\n",1);
  else
    call_out("reaction",0,TP,
	     "funkelt Dich boese an: Verschwinde, Du Wurm!\n",
	     "funkelt "+TP->name(WEN,1)+" boese an.\n");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

varargs void reaction(object ob, string macher, string andere,int flag) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
      if(flag) Kill(ob);
    }
}
