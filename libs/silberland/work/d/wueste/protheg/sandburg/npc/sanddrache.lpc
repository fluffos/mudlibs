/*
**  Die Sanddrachen Kraya und Kerek aus der Sandburg,
**  beim clonen wird festgelegt ob maennlich oder weiblich
**  --
**  Durch den unflexiblen stddragon bin ich gezwungen, alle Properties selber zu setzen
**  dh: Die Stats sind aehnlich eines Drachen mit level 4 und age 8
*/

#include "../def.h"

inherit "std/mnpc";

void create()
{ 
  object schupperl, mstein;

  if(!is_clone(ME)) return;
  ::create();    
  
  SetProp(P_NAME, "Sanddrache");
  
  create_default_npc(48);
  AddId(({SANDBURG}));
  SetProp(P_XP, 3*QueryProp(P_XP)/2 );
  SetProp(P_TRANSPARENT, 0);
  SetProp(P_WEIGHT, 1200000);
  SetProp(P_SIZE, 1700);
  SetProp(P_ALIGN, 123);
  SetProp(P_RACE, "Drache");
  SetProp(P_RESISTANCE_STRENGTHS, 
	  ([DT_FIRE :-0.5, DT_COLD      :-0.2, DT_WATER     : 0.2,
	    DT_AIR   :-0.2, DT_LIGHTNING :-0.2, DT_EXPLOSION :-0.5,
	    DT_SOUND :-1.0, DT_LIGHT     :-1.0, DT_ELECTRIC  :-0.2,
	    DT_ACID  : 0.0, DT_POISON    :-1.0, DT_TERROR    :-0.9,
	    DT_MAGIC :-0.6, DT_HOLY      :-0.2]));
  
  SetProp(P_TEMPERATURE_RANGE, ([0:0, 1:70]));
  SetProp(P_SPELLRATE, 55);
  
  SetProp(P_KILL_NAME, "Ein Sanddrachenpaerchen");
  SetProp(P_KILL_MSG, "Stoer die Ruhe von Kerek und Kraya nicht, Wurm!\n");

  SetProp(P_MSGIN, "stampft herein.\nDer Boden unter Dir erzittert");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_MMSGIN, "landet vor Dir auf dem Boden");
  SetProp(P_MMSGOUT, "springt hoch und fliegt weg");
  
  SetProp(P_MNPC_AREA, ROOM "hof" );
  SetProp(P_MNPC_WAIT, ({ 10, 10, 30 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "hof_3_3_1");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS);
  
  schupperl=clone_object("/p/std/dragons/obj/schuppe");
  schupperl->SetProp(P_AMOUNT, 20+random(10));
  schupperl->move(ME);
  
  "/obj/gemmaster"->DistributeGem(2,4,1,1);
  mstein=clone_object("/p/magic/magiestein");
  mstein->SetProp(P_AMOUNT, 1+random(3));
  mstein->move(ME);
}

void DefineGender(int i)
{
  if(i==FEMALE)
    {
      SetProp(P_NAME, "Kraya");
      AddId(({"NOWIMPY","drache","kraya", "sanddrache"}));
      SetProp(P_SHORT, "Kraya, der Sanddrache");
      SetProp(P_HANDS, ({" mit ihren Sandkrallen",333,({DT_RIP,DT_BLUDGEON,DT_MAGIC})}));
      SetProp(P_AGGRESSIVE, 0.1);
      SetProp(P_ARTICLE, 0);
      SetProp(P_GENDER, i);
      SetProp(P_LONG,
	      BS("Kraya gehoert zu den seltensten Drachen im Silberland, sie ist naemlich "+
		 "ein weiblicher Sanddrache. Ihr gewaltiger Koerper scheint aus purem Sand "+
		 "zu bestehen, staendig rieselt Sand von ihr herab, doch ihr Koerper scheint "+
		 "sich durch den vielen Sand immer wieder zu regenerieren!\n"));
      SetProp(P_BODY, 490);
      set_living_name("kraya");
      SetProp(P_HANDS, ({" mit ihren Klauen", 466, DT_RIP }));
      AddSpell(1,200,
	       ME->Name()+" blaest Dir Sand ins Gesicht...\n",
	       ME->Name()+" blaest @WEM Sand ins Gesicht...\n",
	       ({DT_AIR}), "spell_blind");
      AddSpell(2,650,
	       ME->Name()+" speit Dir eine Saeurewolke entgegen.\n",
	       ME->Name()+" speit @WEN mit einer Saeurewolke an.\n",
	       ({DT_ACID}),([SP_SHOW_DAMAGE:1]));
      AddSpell(2,650,
	       ME->Name()+" wirbelt mit dem Kopf...\n"+
	       "Ploetzlich rast ein elementarer Sandstrahl auf Dich zu!\n",
	       ME->Name()+" wirbelt mit dem Kopf...\n"+
	       "Ploetzlich rast ein elementarer Sandstrahl auf @WEN zu!\n",
	       ({DT_BLUDGEON,DT_AIR,DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
      AddSpell(1,1,
	       ME->Name()+" spuckt Feuer, das zerstoert Deine Ruestung zerstoert.\n",
	       ME->Name()+" spuckt Feuer, das zerstoert Deine Ruestung zerstoert.\n",
	       ({DT_FIRE}),"breath_spell");
    }
  else if(i==MALE)
    {
      SetProp(P_NAME, "Kerek");
      AddId(({"NOWIMPY","drache","kerek", "sanddrache"}));
      SetProp(P_SHORT, "Kerek, der grosse Sanddrache");
      SetProp(P_HANDS, ({" mit seinen starken Sandkrallen",434,({DT_RIP,DT_BLUDGEON,DT_MAGIC})}));
      SetProp(P_AGGRESSIVE, 0.2);
      SetProp(P_ARTICLE, 0);
      SetProp(P_GENDER, i);
      SetProp(P_LONG,
	      BS("Kerek der Grosse, wie er auch oft genannt wird gehoert zu den magiebegabtesten "+
		 "Drachen im ganzen Silberland. Seine Haut aus purem Sand schuetzt ihn vor den "+
		 "Attacken der Angreifer und so kann er sich gut seiner Hauptaufgabe widmen, "+
		 "naemlich der: Kraya, seine Lebensgefaehrtin zu beschuetzen!\n"));
      SetProp(P_BODY, 550);
      set_living_name("kerek");  
      SetProp(P_HANDS, ({" mit seinen grossen Klauen", 488, DT_RIP }));
      AddSpell(1,200,
	       ME->Name()+" beginnt sich zu drehen...\n",
	       ME->Name()+" beginnt sich zu drehen...\n",
	       DT_POISON, "spell_gift");
      AddSpell(2,650,
	       ME->Name()+" speit Dir eine Saeurewolke entgegen.\n",
	       ME->Name()+" speit @WEN mit einer Saeurewolke an.\n",
	       ({DT_ACID}),([SP_SHOW_DAMAGE:1]));
      AddSpell(2,650,
	       ME->Name()+" wirbelt mit dem Kopf...\n"+
	       "Ploetzlich rast ein elementarer Sandstrahl auf Dich zu!\n",
	       ME->Name()+" wirbelt mit dem Kopf...\n"+
	       "Ploetzlich rast ein elementarer Sandstrahl auf @WEN zu!\n",
	       ({DT_BLUDGEON,DT_AIR,DT_MAGIC}),([SP_SHOW_DAMAGE:1]));
      AddSpell(1,1,
	       ME->Name()+" spuckt Feuer, das zerstoert Deine Ruestung zerstoert.\n",
	       ME->Name()+" spuckt Feuer, das zerstoert Deine Ruestung zerstoert.\n",
	       ({DT_FIRE}),"breath_spell");
    }
  else DB("*** Sanddrache Bug bei DefineGender.\n");
}

void breath_spell(object enemy,int damage, mixed dam_type)
{
  int i,j;
  object *inv; 
  object *armours;
  
  inv=filter_array(all_inventory(environment(this_object())), CLOSURE(living));
  for(i=sizeof(inv)-1;i>=0;i--)
  {
    if(member_array("drache",inv[i]->QueryProp(P_IDS))!=-1 ||
       IS_LEARNING(inv[i])) 
      damage=0; 
    else
      {
	inv[i]->Defend(400+random(450), dam_type, 
		       ([SP_SHOW_DAMAGE:1,SP_NAME:"Dragonbreath"]), this_object());
        /*
	armours=inv[i]->QueryProp(P_ARMOURS); 
	j=random(sizeof(armours));
	if(armours[j]->QueryProp(P_AC) && !armours[j]->id("drachenruestung"))
	  armours[j]->Damage(1+random(3));
          */
        if( pointerp(inv[i]) && pointerp(armours=inv[i]->QueryProp(P_ARMOURS)) ) 
          for(j=0;j<sizeof(armours);j++)
          {
            if( !random(4) && armours[i]->QueryProp(P_AC) && 
                !armours[i]->id("drachenruestung") && 
                armours[i]->QueryProp(P_QUALITY_DECAY) )
              armours[i]->TakeFlaw(5+random(15));
          }
      }
  } 
  return;
}

int Defend(int dam, mixed dtype, mixed spell, object enemy)
{
  if(!pointerp(dtype))
    dtype = ({ dtype });
  
  if(sizeof(dtype & ({ DT_SLASH,DT_BLUDGEON,DT_PIERCE,DT_SQUEEZE,DT_WHIP,DT_RIP })) && !random(3))
    {
      if(!random(5))
	{
	  tell_object(enemy,
		      "Sand beginnt zu broeseln...\n"+
		      "...doch er setzt sich wieder zusammen!!\n");
	  return ::Defend(0, dtype, spell, enemy);
	}
      else
	return ::Defend(dam*2/3, dtype, spell, enemy);
    }

  BURG->Spell(enemy);

  return ::Defend(dam, dtype, spell, enemy);
}

void spell_gift(object enemy, int damage, mixed dam_type)
{
  if(!random(8))
    {
      tell_object(enemy,
		  ME->Name(WESSEN)+" giftiger Schwanzstachel sticht Dich in den Ruecken!!\n"+
		  "Du taumelst...\n");
      enemy->AddPoison(1);
    }
  else
    tell_object(enemy,
		ME->Name(WESSEN)+" giftiger Schwanzstachel verfehlt Dich nur knapp.\n"); 
}

void spell_blind(object enemy, int damage, mixed dam_type)
{
  if(!enemy->QueryProp(P_BLIND))
    enemy->SetProp(P_BLIND, 
		   ([BLIND_TIME: 10+random(5), BLIND_MSG:"Du hast Sand in den Augen!\n"]));
}

void die(int poisondeath)
{
  tell_object(TP, "Der Geist "+ME->Name(WESSEN)+" beruehrt Dich!\n");
  TP->heal_self(500);
  
  write_file(LOG "drachen",
	     ctime()+": "+CAP(getuid(TP))+" toetet "+ME->name(WEN)+".\n");
  if(!IS_LEARNER(TP))
    domainshout(BS(ME->Name()+" bruellt auf unter "+CAP(TP->Name(WESSEN))+" letztem Schlag!"));
  
  CLONEME(OBJ "herz");
  
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)
    write_file(LOG "playerdeath",
	       ctime()+": "+CAP(getuid(player))+" stirbt an "+ME->Name(WEM)+" ["+lostexp+"]\n");
  call_out("klauen", 1);
}

int steinchenklau()
{
  object ob,st;
  
  if(ob=present("leiche", ENV(ME)))
    if(st=deep_present("EDELSTEIN", ob))
      {
	DB("*** Sanddrache nimmt: "+st->QueryProp(P_AMOUNT)+" Stueck "+st->name()+"\n");
	
	st->move(ME, M_NOCHECK);
	
	return 1;
      }
  return -1;
}

void klauen()
{
  if(present("leiche", ENV(ME))) 
    {
      tell_room(ENV(TO), ME->Name()+" durchsucht die frische Leiche...\n");
      while(steinchenklau()!=-1);
    }
  command_me("friss leiche");  
}

void init()
{
  ::init();

  if (TP && TP->id("babydrache")) AddDefender(TP);         
}

void InformDefend(object enemy)
{
  tell_object(enemy, ME->Name()+" stuerzt sich laut bruellend auf Dich!\n");

  Kill(enemy);
}
