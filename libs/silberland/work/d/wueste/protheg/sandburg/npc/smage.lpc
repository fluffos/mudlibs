/*
** fiese, untote Skelettmagier mit unterschiedlicher Magie
**
** Originalskelett by Angrox
*/

#include "../def.h"

inherit MOST "mynpc";

nosave int haxl;
nosave string magic;

void set_magic()
{
  switch(random(100))
    {
    case  0 .. 24 : magic=DT_COLD;
      AddSpell(1, 700,
	       "Der Skelettmagier legt Dir seine Knochenhand auf...\n"+
	       "Ein gewaltiger Schmerz durchzuckt Dich!\n",
	       "Der Skelettmagier legt @WEM seine Knochenhand auf...\n"+
	       "Ein gewaltiger Schmerz durchzuckt darauf @WEN!\n",
	       magic, ([SP_SHOW_DAMAGE:0]));
      AddSpell(2, 300,
	       "Der Skelettmagier streckt seine Arme nach Dir aus...\n"+
	       "Ploetzlich zucken lauter kleine Eiszapfen aus seinen Knochenhaenden!\n",
	       "Der Skelettmagier streckt seine Arme nach @WEM aus...\n"+
	       "Ploetzlich zucken lauter kleine Eiszapfen aus seinen Knochenhaenden!\n",
	       magic, ([SP_SHOW_DAMAGE:1]));
      break;
    case 25 .. 49 : magic=DT_FIRE;
      AddSpell(1, 700,
	       "Der Skelettmagier konzentriert sich, der Raum wird ploetzlich waermer...\n"+
	       "Aus seinen Haenden rast ein Feuerball auf Dich zu!!\n",
	       "Der Skelettmagier konzentriert sich, der Raum wird ploetzlich waermer...\n"+
	       "Aus seinen Haenden rast ein Feuerball auf @WEN zu!!\n",
	       magic, ([SP_SHOW_DAMAGE:1]));
      AddSpell(2, 350,
	       "Der Skelettmagier wirbelt mit den Haenden durch die Luft...\n"+
	       "Ploetzlich tanzen kleine Flaemmchen auf Dir herum!!\n",
	       "Der Skelettmagier wirbelt mit den Haenden durch die Luft...\n"+
	       "Ploetzlich tanzen kleine Flaemmchen auf @WEM herum!!\n",
	       ({magic,DT_TERROR}));
      break;
    case 50 .. 75 : magic=DT_POISON;
      AddSpell(1, 700,
	       "Der Skelettmagier huellt Dich in eine giftige Wolke...\n"+
	       "Dir wird uebel und Dein Kopf faengt an zu pochen!!\n",
	       "Der Skelettmagier huellt @WEN in eine giftige Wolke...\n",
	       magic, ([SP_SHOW_DAMAGE:0]));
      AddSpell(2, 350,
	       "Der Skelettmagier spuckt Dir ins Gesicht! AAAAAAH das brennt!!!\n",
	       "Der Skelettmagier spuckt @WEM ins Gesicht!\n",
	       DT_ACID, ([SP_SHOW_DAMAGE:0]));
      break;
    default: magic=DT_LIGHTNING;
      AddSpell(2, 350,
	       "Der Skelettmagier konzentriert sich...\n"+
	       "Ploetzlich stehen Deine Haare zu Berge!!\n",
	       "Der Skelettmagier beschwoert seine elektrische Energie...\n",
	       DT_ELECTRIC, ([SP_SHOW_DAMAGE:1]));
      AddSpell(1, 900,
	       "Der Skelettmagier hebt seine knochigen Haende...\n"+
	       "Ein gewaltiger Blitz donnert auf Dich herab!!!!\n",
	       "Der Skelettmagier hebt seine knochigen Haende...\n"+
	       "Ein gewaltiger Blitz donnert auf @WEN herab!!!!\n",
	       magic, ([SP_SHOW_DAMAGE:0]));
    }
}

void create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein Skelettmagier");
  SetProp(P_LONG, 
	  BS("Vor Dir steht ein gewaltiger Magier, naja eigentlich nur "
	     "noch, was von ihm uebriggeblieben ist, denn es ist ein "
	     "untoter Magier, der als untotes Skelett durch die Reihen "
	     "der Lebenden wandert. In seinen Augen flackert ein "
	     "seltsames Licht, dass Dich erschaudern laesst."));

  SetProp(P_NAME,"Skelettmagier");
  AddId(({"NOWIMPY","skelettmagier","skelett","magier",SANDBURG}));

  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:70]));
  SetProp(P_RACE, "Untoter");

  create_default_npc(25);

  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_TRANSPARENT, 0);

  SetProp(P_BODY, 150);

  SetProp(P_HANDS, 
	  ({" mit seinen verfaulten Knochenkrallen",199+random(30),DT_RIP}));
  SetProp(P_ALIGN, -550-random(50));
  SetProp(P_SIZE, 150+random(30));
  SetProp(P_XP, QueryProp(P_XP)+96669);
  set_living_name("skelettmagier");
  AddClass(CL_SKELETON);
  SetProp(P_RESISTANCE, 
	  ({DT_COLD, DT_POISON, DT_RIP, DT_AIR, DT_PIERCE, DT_SOUND, 
	      DT_LIGHT, DT_TERROR, DT_UNHOLY}));

  SetProp(P_NOCORPSE, 1);

  AddDetail(({"augen","licht"}), 
	    BS("Legenden zufolge brennt die Seele eines Untoten Skeletts in "
	       "seinen Augen..."));
  
  SUID;
  
  AddMoney(300+random(100));
  
  SetProp(P_REJECT, ({REJECT_DROP, "Der Skelettmagier laesst es fallen.\n"}));
  SetProp(P_DIE_MSG, " klappert zusammen.\n");
  SetProp(P_KILL_MSG, "*stampf* *hack* *nixlebengut*");
  
  SetProp(P_MSGIN, "klappert herein");
  SetProp(P_MMSGIN, "klappert herein");
  SetProp(P_MMSGOUT, "klappert hinaus");
  SetProp(P_MSGOUT, "klappert");
  
  set_magic();

  SetProp(P_SPELLRATE, 80);
  AddSpell(2,250,
	   "Der Skelettmagier rammt seine Knochenfinger in Dich hinein.\n",
	   "Der Skelettmagier rammt seine Knochenfinger in @WEN hinein.\n",
	   DT_PIERCE);
  AddSpell(2,200,
	   "Der Skelettmagier tritt Dich hart in den Bauch.\n",
	   "Der Skelettmagier tritt @WEN hart in den Bauch.\n",
	   DT_BLUDGEON);
  AddSpell(2,300,
	   "Der Skelettmagier versucht Dir ein Bein zu stellen...\n",
	   "Der Skelettmagier versucht @WEM ein Bein zu stellen...\n",
	   DT_BLUDGEON, "spell_haxln");
  AddSpell(1,150,
	   "Der Skelettmagier sticht Dir mit seinem Knochenfinger ins Auge.\n",
	   "Der Skelettmagier sticht @WEM mit seinem Knochenfinger ins Auge.\n",
	   DT_PIERCE, ([SP_SHOW_DAMAGE:0]));

  SetAttackChats(5, ({
    "Der Skelettmagier klappert nervoes mit seinem Unterkiefer.\n",
      "Der Skelettmagier faucht Dich boese an.\n",
      "Der Skelettmagier droht Dir mit geballter Faust!\n",
      "Der Skelettmagier tritt Dich.\n",
      "Der Skelettmagier tritt um sich und verfehlt Dich knapp!\n",
      "Der Skelettmagier versucht Dir ins Auge zu stechen.\n",
      "Der Skelettmagier sucht nach einer Schwachstelle...\n",
      "Der Skelettmagier huepft um Dich herum.\n"}));
}

string info()
{
  string ret;

  switch(magic)
    {
    case DT_COLD:      ret="eiskalt blau";                  break;
    case DT_FIRE:      ret="feurig rot";                    break;
    case DT_POISON:    ret="giftig gruengelb";              break;
    case DT_LIGHTNING: ret="blaeulich mit kleinen Blitzen"; break;
    }
  
  return "Die Augen dieses Skelettmagiers leuchten "+ret+"!\n";
}

void spell_haxln(object enemy, int damage, mixed dam_type)
{
  if((random(3)) ||(haxl>time()))
    tell_object(enemy, BS("Du beginnst zu stolpern, doch Du erfaengst Dich "
			  "wieder."));
  else
    {
      tell_object(enemy, BS("Du beginnst zu stolpern und faellst voll auf "
			    "die Nase!"));
      tell_room(ENV(enemy), BS(enemy->Name()+" stolpert und faellt voll auf "
			       "die Nase!"), ({enemy}));
      enemy->SetProp(P_DISABLE_ATTACK, 
		     enemy->QueryProp(P_DISABLE_ATTACK)+1+random(2));
      haxl=time()+4;
    }
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(!pointerp(dam_type))
    dam_type=({dam_type});
  
  if(sizeof(dam_type & ({DT_MAGIC,magic})) && (random(5)))
    {
      tell_room(ENV(ME), ME->Name()+" leuchtet kurz auf...\n");
      heal_self(dam*2);
      return ::Defend(0, dam_type, spell, enemy);
    }

  return ::Defend(dam, dam_type, spell, enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)
    write_file(LOG "playerdeath",
	       ctime()+": "+CAP(getuid(player))+" stirbt am Skelettmagier ("+
	       magic+") - ["+lostexp+"]\n");
}
