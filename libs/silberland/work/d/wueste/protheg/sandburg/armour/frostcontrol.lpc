/*
  Das Kontrollobjekt der Frostwaffe
  Zerstoert die Waffe bei Feuerangriffen
  Loest sich auf beim zerstoeren der Waffe
*/

#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

nosave int allowed;
nosave object frostwaffe;

create() 
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein schwarzer Punkt");
  SetProp(P_LONG,
	  "Dieser Punkt auf Deiner Stirn dient zum Fokussieren deiner geistigen Macht, "+
	  "um den hohen Anforderungen einer Frostwaffe standhalten zu koennen.\n");
  SetProp(P_INFO, 
	  BS("Nur wenn Du diesen Punkt auf Deiner Stirn hast, kannst Du Dich auf "+
	     "Deine Frostwaffe konzentrieren. Also stell keinen Bloedsinn damit an!"));
  SetProp(P_NAME, "Punkt");
  SetProp(P_GENDER, MALE);
  AddId(({"punkt", "stirnpunkt", "\nfrostcontroll"}));

  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_MAGIC:100]));
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WORN_TEXT, "auf der Stirn");
  
  SetProp(P_REMOVE_FUNC, TO);
  SetProp(P_DEFEND_FUNC, TO);

}

varargs wegmitdir(int i)
{
  allowed=1;
  ME->DoUnwear(1);
  if(!i) tell_object(ENV(ME), "Der magische Punkt auf Deiner Stirn verblasst.\n");
  call_out("remove",0);
}

int RemoveFunc(object me,int silent)
{
  if(allowed) return 1;
  else return 0;
}

int DefendFunc (mixed dtyp, int spell, object enemy) 
{
  if(!frostwaffe) wegmitdir(1);

  if(frostwaffe==ENV(ME)->QueryProp(P_WEAPON))
    if(member(dtyp, DT_FIRE)>=0)
      {
	frostwaffe->Damage(2+random(2));
	tell_object(ENV(ME), "Das Feuer schmilzt einen Teil Deiner Frostwaffe!!\n");
      }
  return 0;
}

itsme(object who)
{
  frostwaffe=who;
}

reset()
{
  object e;

  ::reset();
  
  if(frostwaffe)
    if(e=ENV(ME))
      if(interactive(e))
	if(frostwaffe==e->QueryProp(P_WEAPON)) return;
  
  wegmitdir(1);
}

remove()
{
  object e;

  if((frostwaffe) && (e=ENV(ME)))
    if(interactive(e) && (frostwaffe==e->QueryProp(P_WEAPON)))
      {
	RemoveId("\nfrostcontroll");
	if(frostwaffe->QueryProp(P_CURSED))
	  {
	    tell_object(e, 
			"Ein Energieschub zuckt aus dem Stirnpunkt und entflucht "+
			"Deine Waffe!\n");
	    frostwaffe->SetProp(P_CURSED, 0);
	  }
	frostwaffe->PrepareUnwield();
      }
  
  ::remove();
}
