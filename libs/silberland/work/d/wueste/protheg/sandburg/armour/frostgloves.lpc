/*
** Belohnung aus der Sandburg
**
** Handschuhe aus purem Eis
*/

#include "../def.h"

inherit "std/armour";

#include "/gilden/druidenzirkel/druiden_extern.h"

nosave int timeout;

void create()
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Paar Frosthandschuhe");
  SetProp(P_LONG,
	  BS("Ein Paar Handschuhe aus purem Eis! Dein Atem gefriert, als Du "
	     "sie hochhaeltst. Was fuer eine maechtige Magie muss "
	     "dahinterstecken um so reine Handschuhe erschaffen zu "
	     "koennen. Nur wirklich erfahrene Druiden koennen die Magie "
	     "dieser Handschuhe nutzen."));
  
  SetProp(P_NAME, "Paar Frosthandschuhe");
  SetProp(P_NAME_ADJ, "magisch");
  SetProp(P_GENDER, NEUTER);
  AddId(({"handschuhe", "frosthandschuhe"}));
  SetProp(P_ARMOUR_TYPE, AT_GLOVE);
  SetProp(P_AC, 5);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+([DT_COLD:3]));
  SetProp(P_MATERIAL, ([MAT_MISC_MAGIC:10, MAT_ICE:90]));
  SetProp(P_WEIGHT, 1100);
  SetProp(P_VALUE, 1111);
  SetProp(P_QUALITY_DECAY, ([DT_FIRE:10, DT_COLD:0, 0:1000]));
  SetProp(P_NOBUY, 1); 
  SetProp(P_MAGIC, 1); 
  SetProp(P_DRUID_ADD_HAND_DAMAGE, 10);
  SetProp(P_ITEMD_ELEMENTAL_VALUE, ([EIS:10]));
  SetProp(P_DRUID_HAND_DAMAGE_TYPE, EIS);
  SetProp(P_INFO, 
	  BS("Die Handschuhe unterstuetzen die Eismagie der Druiden!"));
  
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT:-1, T_HEAT_PROT:3]));
  
  SetProp(P_WEAR_RESTRICTIONS, 
	  ([A_INT:18, P_LEVEL:30, P_GUILD_LEVEL:12, P_GUILD:"druidenzirkel"]));
  
  SetProp(P_WEAR_TEXT, ({ 
    "Du streifst Dir %s ueber.\nSie fuehlen sich etwas kuehl an.\n",
      " streift sich %s ueber.\n"}));
  
  timeout=0;
}

void reset()
{
  if(!is_clone(TO)) return;
  ::reset();
  
  if(!MENV) return call_out("remove", 0);
  
  if((!living(MENV)) && ((ENV(MENV)) && (!living(ENV(MENV)))))
    timeout++;
  else
    timeout=0;
  
  if(timeout > 4) return call_out("remove", 0);

}
