/*
** Belohnung aus der Sandburg
** 
** Eine Waffe aus purem Eis
*/

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

#define WAFFEN ({"axt","schwert","dolch","lanze","keule","bogen"})
#define SCHWELLE 20

nosave string defined;
nosave object control;
nosave int eifer;

void create() 
{
  if(!is_clone(TO))  return;
  ::create();
  
  AddId(({"waffe","\nfrostwaffe"}));

  SetProp(P_DAM_TYPE, ({DT_COLD}));

  SetProp(P_INFO, 
	  BS("Diese Waffe besteht aus purem Eis und sollte wohl nicht mit "+
	     "blossen Haenden angefasst werden!\n"));
  SetProp(P_MATERIAL, ([MAT_ICE:90, MAT_MISC_MAGIC:10]));
  SetProp(P_VALUE, 1111);
  SetProp(P_NOBUY, 1);
  SetProp(P_MAGIC, 1);
  SetProp(P_QUALITY_DECAY, 120);

  SetProp(P_WIELD_FUNC, TO);
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_UNWIELD_FUNC, TO);

  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:18,P_LEVEL:30]));
  AddDetail(({"eis","waffe"}),
	    "Diese Waffe scheint aus purem Eis zu bestehen!\n");

  SetProp(P_WIELD_TEXT,
	  ({"Du zueckst die magische Frostwaffe.\n",
	      " zueckt eine magische Frostwaffe.\n"}));
  SetProp(P_UNWIELD_TEXT,
	  ({"Du steckst die magische Frostwaffe zurueck.\n",
	      " steckt eine magische Frostwaffe zurueck.\n"}));
  
  eifer=0;
}

DefineType(string str)
{
  if(member(WAFFEN, defined)!=-1)
    return -1;
  if((!str) || (member(WAFFEN, str)==-1))
    defined=WAFFEN[random(4)];
  else
    defined=str;

  switch(defined)
    {
    case "axt": 
      SetProp(P_SHORT, "Eine Frostaxt");
      SetProp(P_LONG,
	      BS("Eine Axt aus purem Eis! Dein Atem gefriert, als Du sie "
		 "hochhaeltst. Was fuer eine maechtige Magie muss "
		 "dahinterstecken um so eine reine Waffe erschaffen zu "
		 "koennen. Nur wirklich erfahrene Helden koennen damit so "
		 "umgehen, wie es sich gehoert. Der lange, eisige Stiel hat "
		 "einen kleinen Eisknubbel, der die Axt beinahe perfekt "
		 "ausbalanciert und eine scharfe Spitze als Verlaengerung. "
		 "Das Axtblatt ist mit kleinen frostigen Eiszacken "
		 "ueberzogen, die sich brutal in eine Wunde hineindrehen "
		 "koennen.")+
	      "Wahrhaftig eine brutale, jedoch beeindruckende Waffe.\n");
      SetProp(P_NAME, "Frostaxt");
      SetProp(P_NAME_ADJ, "magisch");
      AddId(({"axt", "frostaxt"}));
      SetProp(P_WEAPON_TYPE, WT_AXE);
      SetProp(P_WC, 260+random(15));
      SetProp(P_WC_FIX, 20);
      SetProp(P_NR_HANDS, 2);
      SetProp(P_GENDER, FEMALE);
      SetProp(P_WEIGHT, 3500);
      SetProp(P_SIZE, 127);
      
      AddProp(P_DAM_TYPE, ({DT_SLASH}));
      
      AddDetail(({"magie"}),
		"Bei so einer wundervollen Waffe kann nur Magie "
		"dahinterstecken!");

      AddDetail(({"stiel","axtstiel"}),
		"Der Axtstiel besteht aus einem perfekt ausbalancierten, "
		"laenglichen Eiszylinder mit einem gezackten Axtblatt an "
		"einem und einem kleinen Eisknubbel am anderen Ende.");

      AddDetail(({"blatt","axtblatt"}),
		"Das gewaltige, spitzzulaufende Axtblatt ist mit kleinen "
		"Eiszacken ueberzogen, die einigen Schaden anrichten "
		"koennen...");

      AddDetail(({"zacken","eiszacken"}),
		"Die kleinen Eiszacken reissen beim Auftreffen die Wunde "
		"regelrecht auseinander.\nWie brutal, aber wirksam *g*");

      AddDetail(({"knubbel","eisknubbel"}),
		"Am stumpfen Ende des Axtstiels befindet sich ein kleiner "
		"Eisknubbel mit einer scharfen Spitze als Verlaengerung.");
      
      break;
    case "schwert": 
      SetProp(P_SHORT, "Ein Frostschwert");
      SetProp(P_LONG,
	      BS("Ein Schwert aus purem Eis! Dein Atem gefriert, als Du es "
		 "hochhaeltst. Was fuer eine maechtige Magie muss "
		 "dahinterstecken um so eine reine Waffe erschaffen zu "
		 "koennen. Nur wirklich erfahrene Helden koennen damit so "
		 "umgehen, wie es sich gehoert. Die gezackte Klinge scheint "
		 "total durchsichtig zu sein, was sie aber nicht weniger "
		 "gefaehrlich macht. Das Schwertheft ist schlangenfoermig "
		 "gewunden, was einem im Kampf schnelle Hiebtaktiken erlaubt. "
		 "Scharfe, kleine Eisklauen an den Seiten schuetzen die Hand "
		 "vor gemeinen Schlaegen und erlauben im Gegenzug selbst "
		 "hinterlistige Attacken.")+
	      "Wahrhaftig eine brutale, jedoch beeindruckende Waffe.\n");

      SetProp(P_NAME, "Frostschwert");
      SetProp(P_NAME_ADJ, "magisch");
      AddId(({"schwert", "frostschwert"}));
      SetProp(P_WEAPON_TYPE, WT_SWORD);
      SetProp(P_WC, 185+random(15));
      SetProp(P_WC_FIX, 50);
      SetProp(P_NR_HANDS, 1);
      SetProp(P_GENDER, NEUTER);
      SetProp(P_WEIGHT, 2100);
      SetProp(P_SIZE, 112);
      
      AddProp(P_DAM_TYPE, ({DT_SLASH}));
      
      AddDetail(({"klinge","spitze","zacken"}),
		"Die Klinge wirkt irgendwie durchsichtig und ist an ihrer "
		"Spitze mit scharfen Zacken uebersaeht.");

      AddDetail(({"schwertheft"}),
		"Das Schwertheft ist schlangenfoermig gebogen und liegt "
		"somit recht gut in der Hand.");

      AddDetail(({"klauen","eisklauen","klaue","eisklaue"}),
		"Seitlich am Schwertheft sitzen kleine, jedoch immens "
		"scharfe Eisklauen, die verhindern sollen, dass die Hand "
		"des Schwertfuehrers verletzt wird!");

      AddDetail(({"hand"}),
		"Deine Hand!");

      AddDetail(({"schwertfuehrer","fuehrer"}),
		"Du!");

      break;
    case "dolch": 
      SetProp(P_SHORT, "Ein Frostdolch");
      SetProp(P_LONG,
	      BS("Ein Dolch aus purem Eis! Dein Atem gefriert, als Du ihn "
		 "hochhaeltst. Was fuer eine maechtige Magie muss "
		 "dahinterstecken um so eine reine Waffe erschaffen zu "
		 "koennen. Nur wirklich erfahrene Helden koennen damit so "
		 "umgehen, wie es sich gehoert. Der Frostdolch ist die "
		 "gemeinste aller Frostwaffen, denn die Klinge ist nicht "
		 "nur gezackt, was dem Gegner nicht zu uebersehende Wunden "
		 "verursacht, sondern auch leicht gewoelbt, was bei "
		 "groesseren Gegnern das herausziehen erleichtert. "
		 "Der Griff hat an seinem \"stumpfen\" Ende ebenfalls noch "
		 "ein kleiner Stecher angebracht, um dem Traeger schnelle "
		 "Vor-Zurueck-Taktiken zu ermoeglichen.")+
	      "Wahrhaftig eine brutale, jedoch beeindruckende Waffe.\n");

      SetProp(P_NAME, "Frostdolch");
      SetProp(P_NAME_ADJ, "magisch");
      AddId(({"dolch", "frostdolch"}));
      SetProp(P_WEAPON_TYPE, WT_KNIFE);
      SetProp(P_WC, 105+random(15));
      SetProp(P_WC_FIX, 70);
      SetProp(P_NR_HANDS, 1);
      SetProp(P_GENDER, MALE);
      SetProp(P_WEIGHT, 500);
      SetProp(P_SIZE, 43);
      
      //AddProp(P_DAM_TYPE, ({DT_PIERCE})); Der Dolch bleibt cold-only
      
      AddDetail(({"klinge"}),
		"Die Klinge ist leicht gewoelbt, wuesstest Du es nicht "
		"besser, wuerdest Du sagen, sie ist verbogen. Doch das "
		"scheint bei dieser Waffe absichtlich zu sein.");

      AddDetail(({"griff"}),
		"Der Griff des Dolches ist leicht gerippt. Diese Eigenschaft "
		"laesst sich beim Werfen sicherlich gut einsetzen.");

      AddDetail(({"stecher","ende","stumpfes ende"}),
		"Am \"stumpfen\" Ende des Dolches sitzt ein kleiner Stecher, "
		"der sich sicher oft als nuetzlich erweisen wird!");

      AddDetail(({"form","dolchform","taktik","vorzuruecktaktik"}),
		"Die Form des Dolches erlaubt allerlei gemeine Taktiken fuer "
		"den Kampf.");

      break;
    case "keule": 
      SetProp(P_SHORT, "Eine Frostkeule");
      SetProp(P_LONG,
	      BS("Eine Keule aus purem Eis! Dein Atem gefriert, als Du sie "
		 "hochhaeltst. Was fuer eine maechtige Magie muss "
		 "dahinterstecken um so eine reine Waffe erschaffen zu "
		 "koennen. Nur wirklich erfahrene Helden koennen damit so "
		 "umgehen, wie es sich gehoert. Obwohl die Frostkeule recht "
		 "plump wirkt ist sie doch in den richtigen Haenden eine "
		 "wahre Vernichtungswaffe. Schon allein die Dornen aus purem "
		 "Eis, die an der Keulenspitze festgemacht sind, lassen "
		 "jeden Gegner vor Schreck erstarren.")+
	      "Wahrhaftig eine brutale, jedoch beeindruckende Waffe.\n");

      SetProp(P_NAME, "Frostkeule");
      SetProp(P_NAME_ADJ, ({"stachelbesetzt","magisch"}));
      AddId(({"keule", "frostkeule"}));
      SetProp(P_WEAPON_TYPE, WT_CLUB);
      SetProp(P_WC, 245+random(15));
      SetProp(P_WC_FIX, 10);
      SetProp(P_NR_HANDS, 2);
      SetProp(P_GENDER, FEMALE);
      SetProp(P_WEIGHT, 3500);
      SetProp(P_SIZE, 97);
      
      AddProp(P_DAM_TYPE, ({DT_BLUDGEON}));      
      
      AddDetail(({"vernichtungswaffe"}),
		"Diese Keule kann einen Gegner regelrecht in den Boden "
		"stampfen!");

      AddDetail(({"dornen","eisdornen","eiszapfen","zapfen"}),
		"Ueber zehn Zentimeter lange, gehaertete Eiszapfen, bilden "
		"die Dornenkrone auf der Keulenspitze.");

      AddDetail(({"krone","dornenkrone"}),
		"Eine eisige Dornenkrone ziert die Spitze der Keule.");

      AddDetail(({"spitze","keulenspitze"}),
		"Die Keulenspitze ist mit einer gefaehrlich wirkenden "
		"Dornenkrone besetzt!");

      break;
    case "lanze": 
      SetProp(P_SHORT, "Eine Frostlanze");
      SetProp(P_LONG,
	      BS("Eine Lanze aus purem Eis! Dein Atem gefriert, als Du sie "
		 "hochhaeltst. Was fuer eine maechtige Magie muss "
		 "dahinterstecken um so eine reine Waffe erschaffen zu "
		 "koennen. Nur wirklich erfahrene Helden koennen damit so "
		 "umgehen, wie es sich gehoert. Die lange, stachelbesetzte "
		 "Lanze durchbohrt selbst den haertesten Panzer, wenn sie "
		 "richtig gefuehrt wird. Das lange Heft hat Fuehrungsrillen, "
		 "so koennen die Finger die Lanze besser halten.")+
	      "Wahrhaftig eine brutale, jedoch beeindruckende Waffe.\n");

      SetProp(P_NAME, "Frostlanze");
      SetProp(P_NAME_ADJ, "magisch");
      AddId(({"lanze", "frostlanze"}));
      SetProp(P_WEAPON_TYPE, WT_SPEAR);
      SetProp(P_WC, 225+random(15));
      SetProp(P_WC_FIX, 30);
      SetProp(P_NR_HANDS, 2);
      SetProp(P_GENDER, FEMALE);
      SetProp(P_WEIGHT, 3200);
      SetProp(P_SIZE, 196);
      
      AddProp(P_DAM_TYPE, ({DT_PIERCE}));
      
      AddDetail(({"panzer"}),
		"Nur wirklich sehr starke Panzer koennen dieser Lanze "
		"standhalten.");
      AddDetail(({"heft","lanzenheft"}),
		"Das Lanzenheft ist beinahe siebzig Centimeter lang und mit "
		"Fuehrungsrillen versehen, so koennen sowohl grosse, als auch "
		"kleine Haende die Lanze sicher fuehren.");

      AddDetail(({"rillen","fuehrungsrillen"}),
		"Schraeg ueber das Lanzenheft ziehen sich Fuehrungsrillen, "
		"die einen besseren Halt im Kampf versprechen.");
      
      break;
    case "bogen": 
      SetProp(P_SHORT, "Ein Frostbogen");
      SetProp(P_LONG,
	      BS("Eine Bogen aus purem Eis! Dein Atem gefriert, als Du ihn "
		 "hochhaeltst. Was fuer eine maechtige Magie muss "
		 "dahinterstecken um so eine reine Waffe erschaffen zu "
		 "koennen. Nur wirklich erfahrene Helden koennen damit so "
		 "umgehen, wie es sich gehoert. Der Bogen ist aus blankem Eis, dass "
     "deine Finger taub werden laesst. Sogar die Sehene sieht aus wie "
     "ein feinder Faden aus gefrorenem Wasser.")+
	      "Wahrhaftig eine brutale, jedoch beeindruckende Waffe.\n");

      SetProp(P_NAME, "Frostbogen");
      SetProp(P_NAME_ADJ, "magisch");
      AddId(({"bogen", "frostbogen"}));
      SetProp(P_WEAPON_TYPE, WT_BOW);
      SetProp(P_WC, 225+random(15));
      SetProp(P_WC_FIX, 30);
      SetProp(P_NR_HANDS, 2);
      SetProp(P_GENDER, FEMALE);
      SetProp(P_WEIGHT, 2000);
      SetProp(P_SIZE, 196);
      
      AddProp(P_DAM_TYPE, ({DT_PIERCE}));      
      break;
    }
}

int WieldFunc(object waffe, int silent) 
{
  if(!query_once_interactive(TP)) return 1;

  if(!sizeof(TP->QueryArmours(AT_GLOVE)))
    {
      write("Du nimmst "+ME->name(WEN)+" fest in Deine Haende, doch das kalte Eis "+
	    "brennt sich schmerzhaft in Deine Handflaechen.\nDu steckst "+
	    ME->name(WEN)+" wieder weg.\n");
      TP->AddHp(-5-random(5));
      return 0;
    }
  
  if(objectp(control)) control->wegmitdir(1);
  control=clone_object(ARMOUR "frostcontrol");
  control->move(TP, M_NOCHECK);
  control->DoWear(1);
  control->itsme(TO);
  tell_object(ENV(ME), 
	      "Ploetzlich materialisiert sich ein Punkt aus reiner Magie auf "+
	      "Deiner Stirn.\n");
  eifer=0;
  
  return 1;
}

varargs int UnwieldFunc(object waffe, int silent)
{
  if(objectp(control) &&
     (control==present("\nfrostcontroll",ENV(ME)))) control->wegmitdir();
  
  eifer=0;
  
  return 1;
}

PrepareUnwield()
{
  call_out("prep2",0);
}

prep2()
{
  object pl;
  
  if(pl=ENV(ME))
    if(interactive(pl))
      if(QueryProp(P_WIELDED)==pl)
	if(!present("\nfrostcontroll",pl))
	  {
	    DoUnwield();
	    
	    if(pl==QueryProp(P_WIELDED))
	      {
		tell_object(pl, "Vor Schreck laesst Du Deine Waffe fallen!\n");
		pl->drop_obj(ME);
	      }
	  }
}

int HitFunc(object enemy)
{
  eifer++;

  if((TP) && (enemy) && (TP==QueryProp(P_WIELDED)))
    if(!sizeof(TP->QueryArmours(AT_GLOVE)))
      call_out("fallen_lassen",0, TP);
    else
      if((eifer>SCHWELLE) && (!random(3)))
	call_out("hagelschlag",0,TP,enemy);
  
  return 0;
}

void fallen_lassen(object who)
{
  if(QueryProp(P_WIELDED)!=who) return;

  if(sizeof(TP->QueryArmours(AT_GLOVE))) return;

  tell_object(who,
	      BS("Ein gewaltiger Ruck durchzuckt Deine Hand und Du laesst D"+
		 ME->name(WEN)+" fallen. Vielleicht solltest Du das Eis "+
		 "nicht so schutzlos anfassen!"));

  who->AddHp(-5-random(5));

  who->drop_obj(ME);
}

void hagelschlag(object tp, object enemy)
{
  if(!enemy || !tp) return;

  if(!tp->IsEnemy(enemy)) return;
  if(!present(enemy, ENV(tp))) return;

  tell_room(ENV(enemy), 
	    BS("Ploetzlich beginnen sich kleine Wolken ueber "+tp->name(WEM)+
	       " zu bilden. ")+
	    BS("Es kracht und ein maechtiger Eishagel faehrt auf "+
	       enemy->name(WEN)+" herab"), ({tp,enemy}));

  tell_object(enemy,
	      BS("Ueber "+tp->name(WEM)+" bilden sich ploetzlich kleine "
		 "Wolken.")+
	      BS("Es kracht und ein maechtiger Eishagel schiesst auf Dich "
		 "zu!"));
  tell_object(tp, 
	      BS("Ploetzlich beginnt sich ueber Dir etwas "
		 "zusammenzubrauen...")+
	      BS("D"+ME->name()+" beginnt zu vibrieren, als sich ein "
		 "Hagelschlag losloest und auf "+enemy->name(WEN)+
		 " herabfaehrt."));

  SetProp(P_KILL_NAME, Name());
  enemy->Defend(eifer*15, ({DT_COLD,DT_AIR}), 
		([SP_SHOW_DAMAGE:1,SP_NAME:"Hagelschlag"]), ME);
  eifer=0;
}

QueryType()
{
  return defined;
}

QueryEifer()
{
  return eifer;
}

