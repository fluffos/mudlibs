/*
** Das Herz eines Sanddrachen!
**
*/

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

nosave int counter;

create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Das Herz eines Sanddrachen");
  SetProp(P_LONG, 
	  "Dies ist das noch blutige Herz eines Sanddrachen. Nur erfahrene Kaempfer "+
	  "sind in der Lage so einen Sanddrachen zu toeten!\n");
  SetProp(P_INFO,
	  "Sanddrachenherzen sind leider nicht sonderlich lange haltbar...\n");
  SetProp(P_NAME, "Sanddrachenherz");
  SetProp(P_MATERIAL, ([MAT_FLESH:90, MAT_BLOOD:10]));
  SetProp(P_GENDER, NEUTER);
  AddId(({"herz", "drachenherz", HERZ}));
  SetProp(P_NAME_ADJ, "blutig");
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 666);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
}

reset()
{
  object pl;

  if (!is_clone(TO)) return;  

  ::reset();
  
  counter++;
  
  if(counter==3)
    {
      if(pl=ENV(ME))
	if(interactive(pl))
	  tell_object(pl,"Das "+ME->Name(RAW)+" zerfaellt zu Staub...\n");
      call_out("remove",0);
    }
}
