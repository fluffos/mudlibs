/*
** Magische elementare Kugel der Druidenwaechter
**
*/

#include "../def.h"

inherit "std/thing";
inherit "/gilden/bardengilde/obj/std_spellprovider";

#include <properties.h>
#include <language.h>
#include "/gilden/bardengilde/barden_extern.h"

string element;
int dauer;

create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_GENDER, FEMALE);
  AddId(({"kugel", KUGEL}));
  SetProp(P_NAME_ADJ, "elementar");

  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 777);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
}

QueryElement()
{
  return element;
}

DefineElement(string str)
{
  if(member(({"eis","feuer","wasser","erz"}), element)!=-1)
    return -1;
  if((!str) || (member(({"eis","feuer","wasser","erz"}), str)==-1))
    element=({"eis","feuer","wasser","erz"})[random(4)];
  else
    element=str;
  switch(element)
    {
    case "eis" : 
      SetProp(P_SHORT, "Eine elementare Eiskugel");
      SetProp(P_LONG, "Die Kugel scheint aus purem Eis zu bestehen, dennoch fuehlt sie sich "+
	      "nur kuehl an. Ein magisches Kraftfeld scheint sie zu umschliessen.\n");
      SetProp(P_NAME, "Eiskugel");
      SetProp(P_MATERIAL, ([MAT_ICE:90, MAT_MISC_MAGIC:10]));
      AddId("eiskugel");
      break;
    case "erz" : 
      SetProp(P_SHORT, "Eine elementare Metallkugel");
      SetProp(P_LONG, "Die Kugel scheint aus reinem Metall zu bestehen, dennoch ist sie leicht "+
	      "wie eine Feder. Ein magisches Kraftfeld scheint sie zu umschliessen.\n");
      SetProp(P_NAME, "Metallkugel");
      SetProp(P_MATERIAL, ([MAT_STEEL:90, MAT_MISC_MAGIC:10]));
      AddId("metallkugel");
      break;
    case "feuer" : 
      SetProp(P_SHORT, "Eine elementare Feuerkugel");
      SetProp(P_LONG, "Die Kugel scheint aus purem Feuer zu bestehen, dennoch fuehlt sie sich "+
	      "nur warm an. Ein magisches Kraftfeld scheint sie zu umschliessen.\n");
      SetProp(P_NAME, "Feuerkugel");
      SetProp(P_MATERIAL, ([MAT_FIRE:90, MAT_MISC_MAGIC:10]));
      AddId("feuerkugel");
      break;
    case "wasser" : 
      SetProp(P_SHORT, "Eine elementare Wasserkugel");
      SetProp(P_LONG, "Die Kugel scheint aus purem Wasser zu bestehen, dennoch bleibt sie "+
	      "immer eine perfekte Kugel. Ein magisches Kraftfeld scheint sie zu umschliessen.\n");
      SetProp(P_NAME, "Wasserkugel");
      SetProp(P_MATERIAL, ([MAT_WATER:90, MAT_MISC_MAGIC:10]));
      AddId("wasserkugel");
    }
}

reset()
{
  object pl;

  ::reset();

  if (!is_clone(TO)) return;  
  
  dauer++;
  
  if(dauer==2)
    {
      if(pl=ENV(ME))
	if(interactive(pl))
	  tell_object(pl,"D"+ME->name()+" beginnt sich ploetzlich aufzuloesen...\n");
      call_out("remove",0);
    }
}

public void init() {
  if(!is_clone(this_object())) return;
  ::init();

  if(id("eiskugel")) {
    call_out("fusionCheck", 2);
  }
}

public void fusionCheck() {
  object pl;
  pl = environment(this_object());

  if(!living(pl)) return;
  if(pl->QueryProp(P_GUILD) != "bardengilde") return;
  if(pl->QueryProp(P_BARD_GROUP) != BARD_GROUP_TIRENA) return;
  if(pl->QuerySkill("beschwoerung der sonne") != 0) return;

  if(!present("wasserkugel", pl) || !present("feuerkugel", pl) || !present("metallkugel", pl)) {
    return;
  }

  tell_object(pl, BS("Mit einem Mal beginnen die Elementarkugeln summend zu vibrieren."));
  call_out("fusionFinish", 4, pl);
}

public void fusionFinish(object who) {
  tell_object(who, BS("Mit einem lauten Schnalzen verschmelzen die Kugeln zu einer kleinen "
                     "Miniatursonne, bevor sie sich sofort wieder aufteilen!"));
  call_out("LearnBardSpell", 4, this_player(), "beschwoerung der sonne", 
            "Mit diesem Lied kannst du die Kraft der Sonne selbst in deine Umgebung "
            "beschwoeren, um deine Feind damit zu verbrennen.",
            "spiele 'beschwoerung der sonne'");
}
