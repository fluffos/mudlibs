/*
** Eine kleine Steinschale im Innenhof der Burg
**
*/

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

#define MAXDRINK 5
#define HEAL 40

nosave int counter,next;

create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine niedrige Steinschale");
  SetProp(P_LONG, 
	  "Eine Steinschale halt.\n");
  SetProp(P_NAME, "Steinschale");
  SetProp(P_MATERIAL, ([MAT_STONE:90, MAT_WATER:10]));
  SetProp(P_GENDER, FEMALE);
  AddId(({"schale", "steinschale", SANDBURGBRUNNEN}));
  SetProp(P_WEIGHT, 32323);
  SetProp(P_VALUE, 0);
  SetProp(P_NOGET, 1);
  counter=MAXDRINK;
  next=time();
  AddCmd(({"trink","trinke"}), "trinken");
}

short()
{
  string ret;

  switch(counter)
    {
    case MAXDRINK : ret="volle";     break;
    case 0   : ret="leere";     break;
    default  : ret="halbleere"; break;
    }
  return "Eine "+ret+" Steinschale.\n";
}

long()
{
  return short()+"Man kann aus ihr trinken.\n";
}

reset()
{
  ::reset();
  
  counter=MAXDRINK;
}

trinken(string str)
{
  notify_fail("Woraus willst Du denn trinken?\n");
  if(!str) return 0;
  
  if(str=="aus schale"||str=="aus steinschale"||str=="wasser aus schale"||
     str=="wasser aus steinschale")
    {
      notify_fail("");
      if(!counter)
	return write("Aber die Schale ist doch leer!\n"),0;
      if(next>time())
	return write("Nicht so hastig, sonst verschluckst Du Dich noch!\n"),0;
      write("Du trinkst einen Schluck aus der Steinschale und fuehlst Dich erfrischt.\n");
      say(TPN+" nimmt einen Schluck aus der Steinschale.\n");
      TP->heal_self(HEAL+random(10));
      counter--;
      next=time()+2;
      return 1;
    }
  return 0;
}
