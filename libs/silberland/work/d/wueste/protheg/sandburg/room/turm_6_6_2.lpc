/*
** Turmspitze Aussichtsplattform, Standort der elementaren Waechter
** 
** Wasserdruidenwaechter
*/

object elemental;

#include "../def.h"

inherit MOST "std_room";

#include <properties.h>
#include <language.h>

int DoElemental()
{
  if(elemental)
    if(ENV(elemental)==ME)
      return 1;
    else
      elemental->move(ME,M_NOCHECK);
  else
    {
      elemental=clone_object(NPC "elemental");
      elemental->DefineElement("wasser");
      elemental->move(ME,M_NOCHECK);
      BURG->RegisterElemental("wasser");
      return 1;
    }
  return 0;
}

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Hoch oben auf der Sandturmspitze");
  SetProp(P_INT_LONG,
	  BS("Endlich, die Spitze des Turmes! Eine beeindruckende Aussicht "
	     "bietet sich Dir von hier oben. Zwischen den Sandzinnen "
	     "hindurch kannst Du weit in die Ferne blicken. Weiters stehen "
	     "hier oben ein Sessel und ein grosses Fernrohr, dass in den "
	     "Innenhof gerichtet ist. Durch die Falltuer gelangst Du wieder "
	     "nach unten..."));

  AddDetail(({"boden"}),
	    "Der sandige Boden sieht recht stabil aus. Eine Falltuer wurde "
	    "in ihn eingelassen.");

  AddDetail(({"aussicht"}),
	    "Die Aussicht waere atemberaubend, wenn die Wueste nicht so oed "
	    "waere...");

  AddDetail(({"tuer","falltuer"}),
	    "In den Boden ist eine Falltuer eingelassen, durch die Du wieder "
	    "nach unten gelangen kannst.");

  AddDetail(({"ferne"}),
	    "Weit in der Ferne siehst Du Umrisse von etwas Grossem, "
	    "vielleicht einem Gebirge?");

  AddDetail(({"umrisse","grosses","grosse","gebirge"}),
	    "Ob das die Umrisse eines Gebirges sind?");

  AddDetail(({"himmel"}),
	    "Ein strahlend blauer Himmel erstreckt sich ueber Deinem Kopf.");

  AddDetail("kopf",
	    "Ja, das ist Dein Kopf!");

  AddDetail(({"sessel","thron","sandthron"}),
	    "Der Sessel gleicht schon eher einem Thron aus Sand und scheint "
	    "nicht sonderlich bequem auszusehen. Wer da wohl draufsitzt?");
  
  AddDetail(({"wueste"}),
	    "Ueberall wo Du auch hinsiehst, ist oede Wueste...");

  AddDetail(({"hof","innenhof"}),
	    "Der Innenhof lieg weit unten, was da wohl unten ist?");

  AddDetail(({"turm","spitze"}),
	    QueryProp(P_INT_LONG));

  AddDetail(({"zinnen","sandzinnen"}),
	    "Die Sandzinnen hier sind die gleichen wie unten auf den "
	    "Burgmauern.");

  AddDetail(({"mauern","burgmauern","sandburgmauern","mauer","burgmauer",
		"sandburgmauer"}),
	    "Weit unterhalb erkennst Du die starken Burgmauern, die die "
	    "Tuerme untereinander verbinden.");

  AddDetail(({"tuerme"}),
	    "Vier Tuerme kannst Du erkennen. Du befindest Dich hier auf dem "
	    "suedoestlichen Turm.");

  AddDetail(({"sand"}),
	    "Alles scheint hier aus Sand zu bestehen, sogar der Sessel vor "
	    "Dir und die, in den Boden eingelassene Falltuer.");

  AddDetail(({"rohr","fernrohr"}),
	    "Das Fernrohr ist in den Innenhof ausgerichtet. Wer da wohl "
	    "beobachtet wird?");

  Licht("hell");
  Umgebung("heiss", TT_DESERT, 0);
  Ausgaenge("turm",({"unten"}));
  
  AddCmd(({"blick","blicke","guck","gucke","schau","schaue"}), "durchgucken");
}

nosave int durchgucken(string str)
{
  notify_fail(BS("Wo willst Du denn durchschauen?"));
  if(!str) return 0;

  if(str=="in rohr" || str=="in fernrohr" || str=="durch rohr" || 
     str=="durch fernrohr" || str=="durch rohr durch" || 
     str=="durch fernrohr durch")
    {
      say(BS(TPN+" schaut angestrengt durch das Fernrohr..."));
      write("Du "+explode(query_verb(), "e")[0]+"st angestrengt durch das "
	    "Fernrohr...\n"+
	    ({"Hat sich da nicht gerade etwas bewegt?\n",
		"War das nicht gerade der stachelige Schwanz eines grossen Tieres?\n",
		"Du kannst nichts besonderes erkennen, oder?\n",
		"Du vernimmst eine schwache Bewegung und dann eine Sandwolke...\n"})[random(4)]);
      return 1;
    }
  
  return 0;
}
