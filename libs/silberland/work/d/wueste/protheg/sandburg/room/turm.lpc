/*
** Treppenhaus, Standort der Skelettmagier
** 
*/

#include "../def.h"

inherit MOST "std_room";

#include <properties.h>
#include <language.h>

void create() 
{
  ::create();
  
  SetProp(P_INT_SHORT, "Ein sandiges Treppengewoelbe");
  SetProp(P_INT_LONG,
	  BS("Du stehst auf einer gewundenen Treppe aus purem Sand. In "
	     "regelmaessigen Abstaenden ist ein Fenster in der Aussenwand, "
	     "sodass genug Licht in das Innere des Turmes gelangen kann. "
	     "Doch was ist das? Da liegen doch tatsaechlich Knochen und "
	     "sonstige halbzerfallene Ruestungsteile. Bleib auf der Hut!"));

  AddDetail(({"boden"}),
	    "Der Boden ist irgendwo weit unter Dir. In der Mitte des "
	    "Treppenhauses kannst Du nach unten sehen, doch da unten "
	    "ist alles irgendwie... Schwarz!");

  AddDetail(({"decke","gewoelbe","deckengewoelbe"}),
	    "Weit ueber Dir kannst Du das Deckengewoelbe erkennen.");

  AddDetail(({"treppe","treppen","treppenhaus"}),
	    "Du scheinst Dich hier in einem grossen Treppenhaus zu befinden. "
	    "Die Treppe verlaeuft jeweils sehr steil nach oben und unten. "
	    "Pass bloss auf, dass Du nicht stolperst!");

  AddDetail(({"meter","abstaende"}),
	    "In regelmaessigen Abstaenden sind Loecher in den Aussenwaenden "
	    "des Treppenhauses, die entfernt an Fenster erinnern.");

  AddDetail(({"fenster","loecher"}),
	    "Etwas Sonnenlicht kommt durch die Fenster herein, ansonsten ist "
	    "da nichts Interessantes an den Fenstern.");

  AddDetail(({"interessantes"}),
	    "Nix gibts!");

  AddDetail(({"loch","mitte"}),
	    "Das Loch in der Mitte scheint tief hinabzugehen. Stolpere bloss "
	    "nicht!");

  AddDetail(({"wand","waende"}),
	    "Die Waende bestehen, wie die ganze Burg, komplett aus Sand. "
	    "Einige Fenster wurden in regelmaessigen Abstaenden in die "
	    "Waende eingelassen.");

  AddDetail(({"licht","sonnenlicht","inneres","innen"}),
	    "Das Treppenhaus wird durch die Fenster spaerlich mit "
	    "Sonnenlicht versorgt.");

  AddDetail(({"aussenwand","aussenwaende"}),
	    "Die kannst Du von hier drinnen natuerlich nicht sehen, aber Du "
	    "schaetzt, dass sie auch aus Sand bestehen.");

  AddDetail(({"sand"}),
	    "Alles hier besteht aus Sand, Sand und nochmals Sand!");

  AddDetail(({"hut"}),
	    "Sei bloss vorsichtig!");

  AddDetail(({"knochen","gerippe","leichenteile","ueberreste","kadaver"}),
	    "Ueberall ueber die Treppen verstreut liegen Knochen, ganze "
	    "Gerippe, halb verweste Kadaver, abgetrennte Leichenteile und "
	    "sonstige Ueberreste.");

  AddDetail(({"ruestung","ruestungen","ruestungsteile","ruestungsteil"}),
	    "Ueberall liegen halbverrottete Ruestungen und zerstoerte "
	    "Ruestungsteile herum.");

  Licht("hell");
  Umgebung("maessig", TT_CAVE, 1);
}

int fake()
{
  write(BS("Dich interessiert eher, was da oben ist und nicht unten!"));
  return 0;
}

string pull()
{
  TP->AddHp(-5-random(5));
  return BS("Du wirst ploetzlich zurueckgerissen...");
}
