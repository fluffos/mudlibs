/*
** Standardraum fuer die Burgmauern 
** eigentlich nur Sandwaende die durch Magie zusammengehalten werden
** 
*/

#include "../def.h"

inherit MOST "std_room";

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Zwischen den Zinnen einer Sandburg");
  SetProp(P_INT_LONG,
	  BS("Vorsichtig setzt Du Deine Schritte, denn jeder naechste "
	     "koennte in einer Falle, oder sogar mit dem Tod enden. Rund "
	     "um Dich herum sind meterhohe Zinnen aus purem Sand, die nur "
	     "durch Magie zusammengehalten werden, ebenso wie die ganze "
	     "Burgmauer unter Dir. Rund um die Mauern siehst Du nur oedes "
	     "Wuestenland, was Dich eher interessiert, ist der Innenhof, "
	     "doch von hier oben kannst Du nur wenig erkennen. Vor und "
	     "hinter Dir befindet sich je ein hoher Sandturm, mit einer "
	     "Aussichtsplattform oben drauf."));

  AddDetail(({"boden","sandboden"}),
	    "Der sandige Boden unter Dir wirkt hart wie Stein, aber ob das "
	    "wirklich so ist, bezweifelst Du...");

  AddDetail(({"himmel"}),
	    "Der strahlendblaue Himmel wird hier von den meterhohen sandigen "
	    "Zinnen eingegrenzt.");

  AddDetail(({"hof","innenhof"}),
	    "Du wuesstest nur zu gern, was oder wer sich da unten "
	    "befindet...");

  AddDetail(({"schritt","schritte"}),
	    "Pass bloss auf, wo Du hintrittst!");

  AddDetail(({"falle"}),
	    "Jederzeit koenntest du in eine Falle treten!!");

  AddDetail(({"plattform","aussichtsplattform"}),
	    "Hoch oben auf den Sandtuermen befinden sich zinnenumrandete "
	    "Aussichtsplattformen. Was da wohl oben ist?");

  AddDetail(({"magie","rolle"}),
	    "Offenbar spielt die Magie hier in der Sandburg eine grosse "
	    "Rolle...");

  AddDetail(({"wueste","land","wuestenland","oedland"}),
	    "Die Wueste rund um Dich herum besteht eigentlich nur aus "
	    "sandigem Oedland...");

  AddDetail(({"stein"}),
	    "Der Sand wirkt so hart wie Stein!");

  AddDetail(({"burgmauer","burgmauern","mauer","mauern","sandmauer",
		"sandmauern"}),
	    "Du stehst auf einer hohen Mauer die aus purem Sand zu bestehen "
	    "scheint. Rund um Dich herum stehen meterhohe Zinnen aus purem "
	    "Sand.");

  AddDetail(({"sand"}),
	    "Der Sand ist hier allgegenwaertig! Alles scheint aus Sand zu "
	    "bestehen!!");

  AddDetail(({"zinnen"}),
	    "Neben Dir erheben sich gewaltige, meterhohe Zinnen, die auf den "
	    "Sandmauern einigen Schutz bieten.");

  AddDetail(({"tod"}),
	    "Der Tod scheint hier allgegenwaertig zu sein, warum bloss?");

  AddDetail(({"burg","sandburg"}),
	    "Ein sonderliches Gefuehl beschleicht Dich, was diese Sandburg "
	    "angeht... Ob es noch moeglich ist, zu verschwinden?");

  AddDetail("gefuehl",
	    "Du kannst es nicht genau beschreiben, doch irgendetwas scheint "
	    "hier gar nicht richtig zu sein.");

  AddDetail("schutz",
	    "Eigentlich braucht diese Sandburg keinen Schutz, es ist schon "
	    "unheimlich genug hier.");

  AddDetail(({"turm","sandturm"}),
	    "Jeweils vor und hinter Dir befindet sich ein recht hoher "
	    "Sandturm. Was da wohl oben auf der Aussichtsplattform ist?");

  AddDetail(({"tuerme","sandtuerme","ecke"}),
	    "An jeder Ecke der Sandburg befindet sich Tuerme aus purem Sand.");

  AddDetail("abenteuer",
	    "Konzentriere Dich lieber auf das Abenteuer hier!");

  AddSound(DEFAULT_SOUND,
	   "In der Ferne hoerst Du den Wind rauschen...");

  AddSound(({"ferne"}),
	   "Du denkst kurz an die vielen Abenteuer, die Dich in der Ferne "
	   "erwarten...");

  AddSound("abenteuer",
	   "Du solltest lieber aufpassen wo Du hintrittst!");

  AddSound("wind",
	   "*huiiiiiiiii*huiiiiiiiii*");

  AddSound("sand",
	   "Der Sand will nicht mit Dir sprechen!");

  AddSmell(({"gestank","geruch",DEFAULT_SMELL}),
	   "Es riecht irgendwie nach verdorrtem Fleisch...");

  AddSmell(({"fleisch"}),
	    "Du kannst nicht erkennen wo dieser Geruch herkommt.");

  AddSmell("sand",
	   "Heisser Sand!");

  Licht("hell");
  Umgebung("heiss", TT_DESERT, 0);
}

void BecomesNetAlive(object spieler)
{
  call_other(ROOM "master", "loadme");
}
