/*
** Von Drachen bewachter Granitpodest mit Belohnung drinnen
** 
*/

#include "../def.h"
#include "/gilden/waldlaeufer/ranger_tasks.h"

inherit MOST "std_room";

nosave object kraya, kerek;
nosave mapping skulls;
nosave int counter, activated;

void init_skulls()
{
  skulls=(["eis":0,"erz":0,"feuer":0,"wasser":0]);
  counter=0;
}

varargs void storno(int flag)
{
  if(flag)
    tell_room(TO, BS("Eine gewaltige Welle der Magie verlaesst die "
		     "Kuppel und saeubert die Totenkoepfe."));
  if(flag==2)
    tell_room(TO, BS("Die Kuppel schliesst sich wieder..."));

  activated=0;
  init_skulls();
}

int DoDragonHe()
{
  if(objectp(kerek))
    if(ENV(kerek)==ME)
      return 1;
    else
      kerek->move(ME,M_NOCHECK);
  else
    {
      kerek=clone_object(NPC "sanddrache");
      kerek->DefineGender(MALE);
      kerek->move(ME,M_NOCHECK);
      return 1;
    }
  return 0;
}

int DoDragonShe()
{
  if(objectp(kraya))
    if(ENV(kraya)==ME) 
      return 1;
    else
      kraya->move(ME, M_NOCHECK);
  else
    {
      kraya=clone_object(NPC "sanddrache");
      kraya->DefineGender(FEMALE);
      kraya->move(ME,M_NOCHECK);
      return 1;
    }
  return 0;
}

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Die Mitte des Innenhofes der Sandburg");
  SetProp(P_INT_LONG, 
	  BS("Du stehst hier im weitlaeufigen Innenhof der Sandburg, der "
	     "von den gewaltigen Burgmauern von der Aussenwelt abgegrenzt "
	     "wird. Vier hohe Tuerme ragen aus den Ecken in den Himmel "
	     "empor und werfen lange bedrohliche Schatten auf Dich. Das "
	     "Haeuschen entpuppt sich als kleiner Podest mit vier Saeulen."));

  AddDetail(({"innenhof","hof"}),
	    QueryProp(P_INT_LONG));

  AddDetail(({"boden","sandboden","stein"}),
	    "Der sandige Boden unter Dir wirkt hart wie Stein, aber ob das "
	    "wirklich so ist bezweifelst Du...");

  AddDetail(({"mauern","burgmauern","sandburgmauern","mauer","burgmauer",
		"sandburgmauer"}),
	    "Trotz des grossen Innenhofes scheinen Dich diese gewaltigen "
	    "Burgmauern zu erdruecken!");

  AddDetail(({"ecken","turm","tuerme","sandturm","sandtuerme"}),
	    "In den Ecken des Innenhofes steht je ein gewaltiger Turm aus "
	    "Sand. Irgendwie hast Du das Gefuehl, von dort oben beobachtet "
	    "zu werden!");

  AddDetail(({"schatten"}),
	    "Die Tuerme ragen so hoch in den Himmel, dass deren Schatten "
	    "Dich scheinbar ueber den ganzen Innenhof verfolgen.");

  AddDetail(({"burg","sandburg"}),
	    "Du befindest Dich nun mitten in der Sandburg!");

  AddDetail(({"welt","aussenwelt"}),
	    "Die ist hinter den gewaltigen Burgmauern und somit fuer Dich "
	    "unerreichbar! Du bist hier gefangen!");

  AddDetail(({"gefuehl"}),
	    "Du bist Dir nicht sicher, aber es beunruhigt Dich!");

  AddDetail(({"himmel"}),
	    "Der Himmel wirkt hier unten ziemlich weit weg. Das kommt "
	    "wahrscheinlich wegen den hohen Sandtuermen.");

  AddDetail(({"haeuschen"}),
	    "Das Haeuschen ist eigentlich ein Podest mit vier Saeulen "
	    "rundherum.");

  AddDetail(({"podest","steinpodest"}),
	    "Der Podest besteht aus einem massiven, runenversehenen "
	    "Steinquader mit einer grossen, weissen Kuppel darauf.");

  AddDetail(({"granit","quader","steinquader"}),
	    "Der Steinquader scheint aus einem purem Granitblock zu "
	    "bestehen. Er ist mit vielen verschiedenen Ornamenten und "
	    "geheimnissvollen Runen uebersaeht. Eine Kuppel befindet "
	    "sich auf seiner Oberseite.");

  AddDetail(({"block","granitblock"}),
	    "Der Granitblock wirkt in dieser Sandburg ziemlich deplaziert!");

  AddDetail(({"kuppel"}),
	    "Die Kuppel scheint in einem weissen Licht zu pulsieren. Als Du "
	    "sie etwas laenger betrachtest, bemerkst Du eine angenehme "
	    "Kuehle die von der Kuppel auszugehen scheint. Irgendetwas "
	    "scheint in der Kuppel zu sein, Du kannst undeutlich ein paar "
	    "Umrisse erkennen.");

  AddDetail(({"kuehle"}),
	    "Eine gewisse, kaum spuerbare Kuehle geht von der weissen Kuppel "
	    "aus.");

  AddDetail(({"licht"}),
	    "Ein weisses Licht scheint in der Kuppel zu pulsieren. Hin und "
	    "wieder flackern die Umrisse eines Gegenstandes auf, doch Du "
	    "kannst nicht erkennen, worum es sich handelt.");

  AddDetail(({"gegenstand","umriss","umrisse"}),
	    "Unter der Kuppel kannst Du undeutlich die Umrisse eines "
	    "Gegenstandes erkennen.");

  AddDetail(({"oberseite"}),
	    "Auf der Oberseite des Steinquaders befindet sich eine weisse "
	    "Kuppel.");

  AddDetail(({"ornament","ornamente","rune","runen"}),
	    "Der Steinquader ist mit verschieden Ornamenten und "
	    "unidentifizierbaren Runen uebersaeht.");

  AddDetail(({"saeulen"}),
	    "Um den Podest stehen vier verschiedene Saeulen herum, auf "
	    "denen wiederum je ein Totenkopf plaziert ist. Die Saeulen "
	    "sind ebenfalls aus Sand wie die Sandburg selbst.");

  AddDetail(({"totenkopf","totenkoepfe","schaedel","totenschaedel"}),
	    "Auf jeder Saeule befindet sich ein Totenkopf mit je nur einem "
	    "Auge.");

  AddDetail(({"auge","augen"}),
	    "Es sind vier verschiedene Augen: Eines ist weiss, eines scheint "
	    "aus Stein zu bestehen, eines ist durchsichtig und eines ist "
	    "feurig rot. Die rechte Augenhoehle ist jedoch bei jedem "
	    "Schaedel leer.");

  AddDetail(({"hoehle","hoehlen"}),
	    "Hoehle? Was fuer eine Hoehle meinst Du denn?");

  AddSpecialDetail(({"loecher","loch","augenhoehle","augenhoehlen"}), 
		   "augenhoehle");

  AddDetail(({"spuren","scheuerspuren"}),
	    "Scheint als ob da mal Irgendetwas reingesteckt wurde.");

  AddDetail(({"etwas","irgendetwas"}),
	    "Irgendetwas rundes, augapfelgrosses...");

  AddSound(({"stille","totenstille",DEFAULT_SOUND}),
	   "Hier herrscht Totenstille!");

  AddSound("sand",
	   "Der Sand will nicht mit Dir sprechen!");

  AddSmell(({DEFAULT_SMELL}),
	   "Es riecht irgendwie seltsam, jedoch nicht unangenehm...");

  AddSmell("sand",
	   "Heisser Sand!");

  Licht("hell");
  Umgebung("heiss", TT_DESERT, 0);
  Ausgaenge("hof", "gerade");

  storno();
  
  AddCmd(({"steck","stecke"}), "cmd_stecken");
  AddCmd(({"wirf","werfe"}), "cmd_werfen");
  
  SUID;
}

void reset()
{
  ::reset();

  counter++;
  
  if((counter>=3) && !activated)
    storno(1);
}

string augenhoehle()
{
  string ret;
  
  ret="";
  
  if(skulls["eis"])
    ret+="Eine Eiskugel.\n";
  if(skulls["erz"])
    ret+="Eine Metallkugel.\n";
  if(skulls["wasser"])
    ret+="Eine Wasserkugel.\n";
  if(skulls["feuer"])
    ret+="Eine Feuerkugel.\n";
  
  if(!strlen(ret))
    ret="Die Augenhoehlen scheinen perfekt runde Loecher zu sein. Leichte "
      "Scheuerspuren weisen darauf hin, dass einmal etwas in ihnen gesteckt "
      "haben mag.\n"
      "In den Augenhoehlen befindet sich nichts.\n";
  else
    ret="Die Augenhoehlen scheinen perfekt runde Loecher zu sein. Leichte "
      "Scheuerspuren weisen darauf hin, dass einmal etwas in ihnen gesteckt "
      "haben mag.\n"
      "In den Augenhoehlen befinden sich:\n"+ret;
  
  return ret;
}

nosave int cmd_werfen(string str)
{
  object herz, hueter;
  string what, where;
  
  notify_fail(BS("Was willst Du denn wo hineinwerfen?"));
  if(!str) return 0;

  if(sscanf(str, "%s in %s", what, where)==2)
    {
      where=explode(where, " ")[0];
      
      if(member(({"kuppel","spalte","spalt"}), where)==-1)
	return 0;
	
      if(member(({"sanddrachenherz","herz","drachenherz"}), what)==-1)
	return 0;
      
      if(!herz=present(what, TP)) 
	return write(BS("Aber ein "+CAP(what)+
			" hast Du ja garnicht bei Dir!?")),1;

      if(hueter=present(SANDBURG, ME))
	{
	  hueter->Kill(TP);
	  return write(BS(hueter->Name()+" stuerzt sich wuetend auf Dich!")),1;
	}

      if(!activated)
	return write(BS("Was fuer ein Spalt? Die Kuppel ist doch garnicht "
			"offen!")),1;
      
      if(activated > 2)
	return write(BS("Da tut sich bereits etwas...")), 1;
      
      if(activated==1)
	write("Du wirfst das Drachenherz in den offenen Spalt...\n\n"
	      "Das Licht in der Kuppel verfaerbt sich blau, doch weiter tut "
	      "sich nichts.\n"
	      "Vielleicht musst Du noch ein Drachenherz hineinwerfen!\n");
      else
	{
	  write("Du wirfst das Drachenherz in den offen Spalt...\n"
		"Du Kuppel oeffnet sich weiter...\n\n");

	  call_out("wundergeist", 4, TP);
	}
	    
      say(BS(TPN+" wirft ein Drachenherz in den offenen Spalt der Kuppel."),
	  ({TP}));
      
      herz->remove(1);
      
      activated++;
      
      return 1;
    }
  
  return 0;
}

nosave int cmd_stecken(string str)
{
  string what, where, el;
  object kugel, hueter;
  
  notify_fail(BS("Was willst Du denn wo hineinstecken?"));
  if(!str) return 0;
  
  if(sscanf(str, "%s in %s", what, where)==2)
    {
      where=explode(where, " ")[0];

      if(member(({"schaedel","totenschaedel","kopf","totenkopf",
		    "augenhoehle"}), where)==-1) 
	return 0;
      
      if(what=="kugel")
	return write(BS("Was fuer eine Kugel willst Du denn da "
			"hineinstecken?")),1;

      if(member(({"eiskugel","wasserkugel","feuerkugel","erzkugel",
		    "metallkugel"}), what)==-1)
	return 0;

      if(!kugel=present(what, TP)) 
	return write(BS("Aber eine "+CAP(what)+" hast Du ja garnicht bei "
			"Dir!?")),1;

      if(hueter=present(SANDBURG, ME))
	{
	  hueter->Kill(TP);
	  return write(BS(hueter->Name()+" stuerzt sich wuetend auf Dich!")),1;
	}
      
      el=kugel->QueryElement();

      if(skulls[el]) 
	return write(BS("Da steckt bereits eine "+CAP(what)+" in der "
			"Augenhoehle!")),1;

      write(BS("Du steckst vorsichtig die "+CAP(what)+" in die leere "
	       "Augenhoehle...")+
	    BS("Es macht *PLOPP* und ploetzlich leuchten beide Augen auf."));

      say(BS(TPN+" steckt eine "+CAP(what)+" in die leere Augenhoehle eines "
	     "Totenkopfes."), ({TP}));
      
      kugel->remove(1);
      
      skulls[el]=1;
      
      call_out("check_skulls", 1);
      
      return 1;
    }
 
  return 0;
}

void check_skulls()
{
  if((skulls["eis"]) && (skulls["erz"]) && (skulls["wasser"]) && 
     (skulls["feuer"]))
    {
      tell_room(ME, 
		"Ploetzlich beginnt die Kuppel zu pulsieren...\n\n"
		"Die Spitze der Kuppel beginnt sich zu oeffnen...\n\n"
		"doch sie laesst nur einen kleinen Spalt offen,\n"
		"vielleicht fehlt hier noch etwas?!\n");
      
      AddDetail(({"spalt"}),
		"Da koennte man oben etwas hineinwerfen, doch was?\n");

      activated=1;
    }
}

void wundergeist(object pl)
{
  if(!objectp(pl)) return storno(2);
  if(!present(pl)) return storno(2);
  
  tell_room(ME,
	    "Die Kuppel ist nun komplett offen.\n\n"
	    "Du vernimmst eine Stimme:\n"
	    " 'Ah, ein Sterblicher hat es geschafft mich zu erwecken...'\n\n"
	    "Mit diesen Worten schwebt ploetzlich ein Geist ueber dem "
	    "Steinpodest.\n\n");

  RemoveDetail(({"spalt"}));

  AddDetail(({"geist","dschinn","wundergeist"}),
	    "Der Geist schwebt ueber dem Steinpodest und blickt Dich streng "
	    "an.");

  AddDetail(({"kuppel"}),
	    "Sie ist nun ganz offen, doch Du kannst wegen dem Geist nichts "
	    "genaueres entdecken.");

  AddDetail(({"podest","steinpodest"}),
	    "Der Geist schwebt ueber ihm.");

  call_out("wundergeist_frage", 10, pl);
}

public void finish_ranger_quest(object ob) {
  if(!ob->id(RANGER_TASK_COURIER)) return;
  ob->SetTeil(2);
  return;
}

void wundergeist_frage(object pl)
{
  object ob;

  if(!objectp(pl)) return storno(2);
  if(!present(pl)) return storno(2);

  if(objectp(ob=present(RANGER_TASK_COURIER, pl))) {
    tell_object(pl, "Der Geist reibt sich den Kopf und reicht dir das Teil einer Waffe.\n");
    tell_object(pl, "Der Geist sagt: Hier. Das kannst du haben. Dieses Teil hat mir jemand auf den Kopf geworfen!\n\n");
    call_out("finish_ranger_quest", 4, ob);
  }
  
  tell_object(pl,
	      "Der Geist beugt sich zu Dir vor und spricht:\n"
	      " 'Du hast mich erweckt und mir zwei Sandrachenherzen geopfert.\n"
	      "  Als Dank, darfst Du nun eine Waffe des Frostes waehlen!\n"
	      "  Eine Frostaxt, ein Frostschwert, eine Frostkeule, eine Frostlanze,\n"
	      "  einen Frostdolch, ein Frostbogen oder lieber ein Paar Frosthandschuhe?'\n");

  tell_room(TO, 
	    "Der Geist bietet "+pl->Name(WEM)+" eine Waffe des Frostes an!\n",
	    ({pl}));
  
  tell_object(pl, "Welche soll es sein? ");
  
  input_to("waffenwahl",0,pl);
}

void waffenwahl(string str, object pl)
{
  object waffe;

  if(!objectp(pl)) return storno(2);
  if(!present(pl)) return storno(2);
  
  str=explode(str, "frost")[0];
  
  if(member(({"axt","schwert","keule","lanze","dolch","handschuhe","bogen"}), str)==-1)
    {
      tell_object(pl, "Das ist keine der Waffen, die Dir der Geist angeboten hat!\n");
      tell_object(pl, "Welche soll es sein? ");
      input_to("waffenwahl",0,pl);
      return;
    }
  
  tell_object(pl, "Der Geist meint: 'Du hast Dich entschieden, so soll es sein!\n");
  tell_room(TO, pl->Name(WER)+" hat sich entschieden!\n",({pl}));
  
  if(str=="handschuhe")
    waffe=clone_object(ARMOUR "frostgloves");
  else
    {
      waffe=clone_object(WEAPON "frostwaffe");
      waffe->DefineType(str);
    }

  waffe->move(ME, M_NOCHECK);
  
  tell_room(TO, 
	    BS("Vor deinen Augen materialisiert sich "+waffe->name(WER)+
	    " und faellt zu Boden."));

  pl->command_me("nimm "+str);
  
  write_file(LOG "belohnungen",
    BS(dtime()+": "+CAP(getuid(pl))+" waehlt "+waffe->name(WEN)+"."));
  
  call_out("schluss",2);
}

void schluss()
{
  tell_room(TO, 
	    BS("Der Geist gaehnt und beginnt sich aufzuloesen.")+
	    BS("Gleichzeitig schliesst sich die Kuppel wieder..."));

  RemoveDetail(({"geist","dschinn","wundergeist"}));

  AddDetail(({"podest","steinpodest"}),
	    "Der Podest besteht aus einem massiven, runenversehenen "
	    "Steinquader mit einer grossen, weissen Kuppel darauf.\n");

  AddDetail(({"kuppel"}),
	    "Die Kuppel scheint in einem weissen Licht zu pulsieren. Als Du "
	    "sie etwas laenger betrachtest, bemerkst Du eine angenehme "
	    "Kuehle die von der Kuppel auszugehen scheint. Irgendetwas "
	    "scheint in der Kuppel zu sein, Du kannst undeutlich ein paar "
	    "Umrisse erkennen.");

  storno();
}

mapping QuerySkulls()
{
  return skulls;
}

int QueryActivated()
{
  return activated;
}
