/*
** Burgmauer 
** 
*/

#include "../def.h"

inherit ROOM "burg";

void create() 
{
  ::create();
  
  SetProp(P_INT_LONG, 
	  QueryProp(P_INT_LONG)+
	  BS("Ein grosses Portal steht hier herum."));
  
  AddDetail(({"portal","chance"}),
	    "Dieses Portal ist Deine einzige Chance von hier wegzukommen...");
  
  AddCmd(({"betrete","betret","betritt"}), "escape");
  
  Ausgaenge("hof", ({"suedunten"}));
  Ausgaenge("burg");
}

nosave int escape(string str)
{
  notify_fail(BS("Was willst Du denn betreten?"));
  if(!str) return 0;
  
  if(str=="portal")
    {
      write(BS("Du blickst Dich noch einmal um und betrittst dann zoegernd "
	       "das Portal. Du bist Dir nicht sicher, ob Du alle Geheimnisse "
	       "hier gelueftet hast..."));
      
      TP->move(ROOM "aussen_0_3_0", M_NOCHECK, "durch das Portal", "geht", 
	       "erscheint ploetzlich aus dem Portal");

      return 1;
    }
  
  return 0;
}
