/*
** Der Eingang mit Portal
** 
*/

#include "../def.h"

inherit ROOM "aussen";

nosave string *entered;

void create() 
{
  ::create();
  
  SetProp(P_INT_LONG, 
	  QueryProp(P_INT_LONG)+"Ein grosses Portal steht hier herum.\n");
  
  AddDetail(({"portal"}),
	    "Nur durch dieses Portal gelangt man hinein!\n");
  
  AddCmd(({"betrete","betret","betritt"}), "enter");
  
  Ausgaenge("aussen", "gerade");
  
  entered=({});
}

void reset()
{
  ::reset();
  
  entered=({});
}

nosave int enter(string str)
{
  notify_fail(BS("Was willst Du denn betreten?"));
  if(!str) return 0;
  
  if(str=="portal")
    if(member(entered, getuid(TP))==-1)
      {
	write("Du blickst Dich noch einmal um und betrittst dann entschlossen "
	      "das Portal.\n"
	      "Was Dich auch erwartet, Du wirst es schaffen!\n");
	
	TP->move(ROOM "burg_0_3_1", M_NOCHECK, "durch das Portal", "geht", 
		 "erscheint ploetzlich aus dem Portal");
	
	call_other(ROOM "master", "loadme");
	
	entered+=({getuid(TP)});
	
	return 1;
      }
    else
      return write("Du hast das Portal erst vor kurzem bereits "
		   "durchschritten!\nDu musst warten!\n"),1;

  return 0;
}
