/*
** Ausserhalb der Burgmauern
** 
*/

#include "../def.h"

inherit MOST "std_room";

#define SX 121
#define SY  37
#define DESERT "/d/wueste/zordan/desert/room/desert"

void create() 
{
  object ob;
  string *aktpos;
  string thisfile,path;
  int x,y,z;
  
  ::create();
  
  SetProp(P_INT_SHORT, "An einer gewaltigen Sandburgmauer");
  SetProp(P_INT_LONG,
	  BS("Du befindest Dich hier an einer unueberwindbaren Barriere in "
	     "Form einer gewaltigen Mauer aus purem Sand. Viele "
	     "Moeglichkeiten bleiben Dir nicht, entweder Du gehst wieder "
	     "zurueck in die grosse weite Wueste, oder Du gehst die Mauer "
	     "entlang, mit der Hoffnung, doch noch einen Eingang zu "
	     "finden..."));

  AddDetail(({"boden","sandboden"}),
	    "Der sandige Boden unter Dir wirkt hart wie Stein, aber ob das "
	    "wirklich so ist bezweifelst Du...");

  AddDetail(({"himmel"}),
	    "Der strahlendblaue Himmel wird hier von einer gewaltigen "
	    "Sandmauer eingegrenzt.");

  AddDetail(({"barriere"}),
	    "Die Sandmauern sind so hoch, dass sie fuer Dich eine "
	    "unueberwindbare Barriere bilden.");

  AddDetail(({"mauern","mauer","sandmauer","sandmauern","burgmauer",
		"burgmauern","sandburgmauer","sandburgmauern"}),
	    "Gewaltige hohe Mauern ragen kerzengerade in die Hoehe und "
	    "versperren die Sicht auf alles, das sich dahinter verbirgt.");

  AddDetail(({"hoffnung"}),
	    "Die solltest Du _niemals_ aufgeben! Nicht hier in der Wueste!");

  AddDetail(({"eingang"}),
	    "Wenn Du den Eingang bloss finden wuerdest...");

  AddDetail(({"sandwueste","wueste"}),
	    "Die Wueste erstreckt sich weit in alle Richtungen, nur hier "
	    "endet Dein Weg abrupt an einer gewaltigen Sandmauer.");

  AddDetail(({"weg"}),
	    "Dein Weg hierher war sicherlich recht beschwerlich, deswegen "
	    "wirst Du nicht so schnell aufgeben und weiter nach einem "
	    "Eingang suchen.");

  AddDetail(({"hoehe"}),
	    "Weit oben erkennst Du Zinnen auf den Mauern, vielleicht handelt "
	    "es sich ja um eine Burg?!");

  AddDetail(({"moeglichkeit","moeglichkeiten"}),
	    "Viele hast Du nicht. Suchs Dir aus: Wueste oder Weitersuchen!");

  AddDetail(({"sicht"}),
	    "Du willst unbedingt wissen, was da drinnen ist!");

  AddDetail(({"stein","steinwueste","steine"}),
	    "Das ist eine Sandwueste, wo siehst Du hier Steine?");

  AddDetail(({"suchen","weitersuchen"}),
	    "Na, dann mach!");

  AddDetail(({"sandburg","burg"}),
	    "Ob die gewaltigen Mauern und Zinnen wohl zu einer Sandburg "
	    "gehoeren?");

  AddDetail(({"zinnen"}),
	    "Hoch oben kannst Du die Zinnen auf den Mauern erkennen. Du "
	    "willst unbedingt wissen, was Dich da oben erwartet!");
  
  AddSound(DEFAULT_SOUND,
	   "In der Ferne hoerst Du den Wind rauschen...");

  AddSound(({"ferne"}),
	   "Du denkst kurz an die vielen Abenteuer, die Dich in der Ferne erwarten...");

  AddSound("abenteuer",
	   "Du solltest lieber aufpassen wo Du hintrittst!");

  AddSound("wind",
	   "*huiiiiiiiii*huiiiiiiiii*");

  AddSound("sand",
	   "Der Sand will nicht mit Dir sprechen!");

  AddSmell(({DEFAULT_SMELL}),
	   "Es riecht irgendwie nach Abenteuer!");

  AddSmell(({"abenteuer"}),
	    "Wenn Du doch bloss einen Weg hinein finden wuerdest.");

  AddSmell("sand",
	   "Heisser Sand!");
  
  Licht("hell");
  Umgebung("heiss", TT_DESERT, 0);
  
  thisfile=file_name(TO);
  path="/"+to_string(implode(explode(thisfile,"/")[0..<2],"/"))+"/";
  aktpos=explode(explode(thisfile, "/")[<1],"_");
  
  if(sizeof(aktpos)>=3) {
    x=to_int(aktpos[2]);
    y=to_int(aktpos[1]);
    z=to_int(aktpos[3]);
    // if(ob=find_player("zordan"))
    //  tell_object(ob,sprintf("%s x=%d y=%d z=%d \n",thisfile,x,y,z));
    if(z==0) {
      if(y==0) {
        AddExit("nordwesten", DESERT ":"+(SX+x-1)+":"+(SY+y-1));
        AddExit("norden",     DESERT ":"+(SX+x  )+":"+(SY+y-1));
        AddExit("nordosten",  DESERT ":"+(SX+x+1)+":"+(SY+y-1));
      }
      if(y==6) {
        AddExit("suedwesten", DESERT ":"+(SX+x-1)+":"+(SY+y+1));
        AddExit("sueden",     DESERT ":"+(SX+x  )+":"+(SY+y+1));
        AddExit("suedosten",  DESERT ":"+(SX+x+1)+":"+(SY+y+1));
      }
      if(x==0) {
        AddExit("nordwesten", DESERT ":"+(SX+x-1)+":"+(SY+y-1));
        AddExit("westen",     DESERT ":"+(SX+x-1)+":"+(SY+y  ));
        AddExit("suedwesten", DESERT ":"+(SX+x-1)+":"+(SY+y+1));
      }
      if(x==6) {
        AddExit("nordosten", DESERT ":"+(SX+x+1)+":"+(SY+y-1));
        AddExit("osten",     DESERT ":"+(SX+x+1)+":"+(SY+y  ));
        AddExit("suedosten", DESERT ":"+(SX+x+1)+":"+(SY+y+1));
      }
    }
  }
}
