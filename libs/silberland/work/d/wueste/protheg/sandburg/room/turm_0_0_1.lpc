/*
** Treppenhaus, Standort der Skelettmagier
** 
*/

#include "../def.h"

inherit ROOM "turm";

void create() 
{
  ::create();
  
  AddDetail(({"burg","sandburg","turm","tuerme","sandtuerme","sandturm"}),
	    "Du befindest Dich hier im Treppenhaus des nordwestlichen Turmes "
	    "der Sandburg.");
  
  AddGuardedExit("oben", ROOM "turm_0_0_2", SANDBURG, "@@pull@@");
  
  Ausgaenge("turm");
  
  AddItem(NPC "smage", REFRESH_DESTRUCT);
}
