/*
** Standardraum fuer den Innenhof
** 
*/

#include "../def.h"

inherit MOST "std_room";

void DoBabydrache()
{ 
  object baby;

  if(baby=present("babydrache",TO))
    {
      catch(present("\nschupp",baby)->remove());
      baby->remove(1);
    }
  
  if(!present("babdrache", TO) && (!random(4)))
    {
      baby=clone_object(NPC "babydrache");
      baby->move(TO, M_NOCHECK);
    }
}

void DoBrunnen() 
{ 
  object brunnen;

  if(brunnen=present(SANDBURGBRUNNEN, TO))
    {
      BURG->RemoveBrunnen();
      tell_room(TO, BS(brunnen->Name()+" versinkt im Sand."));
      brunnen->remove(1);
    }

  if(!random(3))
    if(BURG->RegisterBrunnen()==1)
      {
	brunnen=clone_object(OBJ "brunnen");
	brunnen->move(TO, M_NOCHECK);
      } 
} 

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Im Innenhof einer grossen Sandburg");
  SetProp(P_INT_LONG,
	  BS("Du stehst hier im weitlaeufigen Innenhof der Sandburg, der von "
	     "den gewaltigen Burgmauern von der Aussenwelt abgegrenzt wird. "
	     "Vier hohe Tuerme ragen aus den Ecken in den Himmel empor und "
	     "werfen lange bedrohliche Schatten auf Dich. In der Hofmitte "
	     "scheint ein kleines Haeuschen zu stehen."));

  AddDetail(({"innenhof","hof"}),
	    QueryProp(P_INT_LONG));

  AddDetail(({"boden","sandboden","stein"}),
	    "Der sandige Boden unter Dir wirkt hart wie Stein, aber ob das "
	    "wirklich so ist bezweifelst Du...");

  AddDetail(({"mauern","burgmauern","sandburgmauern","mauer","burgmauer",
		"sandburgmauer"}),
	    "Trotz des grossen Innenhofes scheinen Dich diese gewaltigen "
	    "Burgmauern zu erdruecken!");

  AddDetail(({"ecken","turm","tuerme","sandturm","sandtuerme"}),
	    "In den Ecken des Innenhofes steht je ein gewaltiger Turm aus "
	    "Sand. Irgendwie hast Du das Gefuehl, von dort oben beobachtet "
	    "zu werden!");

  AddDetail(({"schatten"}),
	    "Die Tuerme ragen so hoch in den Himmel, dass deren Schatten "
	    "Dich scheinbar ueber den ganzen Innenhof verfolgen.");

  AddDetail(({"burg","sandburg"}),
	    "Du befindest Dich nun mitten in der Sandburg! Was Dich da in "
	    "der Hofmitte wohl erwartet?");

  AddDetail(({"welt","aussenwelt"}),
	    "Die ist hinter den gewaltigen Burgmauern und somit fuer Dich "
	    "unerreichbar! Du bist hier gefangen!");

  AddDetail(({"gefuehl"}),
	    "Du bist Dir nicht sicher, aber es beunruhigt Dich!");

  AddDetail(({"himmel"}),
	    "Der Himmel wirkt hier unten ziemlich weit weg. Das kommt "
	    "wahrscheinlich wegen den hohen Sandtuermen.");

  AddDetail(({"haeuschen","mitte","hofmitte"}),
	    "In der Hofmitte befindet sich ein kleines Haeuschen. "
	    "Vielleicht solltest Du es Dir mal ansehen!");
  
  AddSound(({"stille","totenstille",DEFAULT_SOUND}),
	   "Hier herrscht Totenstille!");

  AddSound("sand",
	   "Der Sand will nicht mit Dir sprechen!");

  AddSmell(({DEFAULT_SMELL}),
	   "Es riecht irgendwie seltsam, jedoch nicht unangenehm...");

  AddSmell("sand",
	   "Heisser Sand!");
  
  Licht("hell");
  Umgebung("heiss", TT_DESERT, 0);
  
  DoBrunnen();
  DoBabydrache();
}

void reset()
{ 
  ::reset(); 
   
  call_out("DoBrunnen",5);
  call_out("DoBabydrache",10);
} 

void BecomesNetAlive(object spieler)
{
  call_other(ROOM "master", "loadme");
}
