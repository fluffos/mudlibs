/*
** Standardraum fuer das Arbeitslager
** 
*/

#include "../def.h"

inherit MOST "std_room";

#include <properties.h>
#include <language.h>

create() 
{
  ::create();
  
  SetProp(P_INT_SHORT, "Ein duesterer Gang unter dem Wuestensand");
  SetProp(P_INT_LONG,
	  "Vorsichtig setzt Du Deine Schritte, denn jeder naechste koennte in "+
	  "einer Falle, oder sogar mit dem Tod enden. Rund um Dich herum sind "+
	  "meterhohe Zinnen aus purem Sand, die nur durch Magie zusammengehalten "+
	  "werden, ebenso wie die ganze Burgmauer unter Dir. Rund um die Mauern "+
	  "siehst Du nur oedes Wuestenland, was Dich eher interessiert, ist der "+
	  "Innenhof, doch von hier oben kannst Du nur wenig erkennen. Vor und "+
	  "hinter Dir befindet sich je ein hoher Sandturm, mit einer "+
	  "Aussichtsplattform oben drauf.\n");

  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN: TT_CAVE]));

  AddDetail(({"boden","sandboden"}),
	    "Der sandige Boden unter Dir wirkt hart wie Stein, aber ob das wirklich so "+
	    "ist, bezweifelst Du...\n");

  AddSound(DEFAULT_SOUND,
	   "In der Ferne hoerst Du den Wind rauschen...\n");

  AddSmell(({"gestank","geruch",DEFAULT_SMELL}),
	   "Es riecht irgendwie nach verdorrtem Fleisch...\n");
  AddCmd(({"grabe","grab"}), "graben");
  AddCmd(({"schuerf","schuerfe"}), "schuerfen");
  AddCmd(({""}),"nospell",1);
}

nosave nospell(string str)
{
  if(member(TP->QueryProp(P_NEWSKILLS), query_verb()))
    return write("Odas Osam grinst Dich aus der Ferne an.\n"+
		 "Odas Osam teilt Dir mit: Deine Zauber sind hier nutzlos!\n"),1;
  return 0;
}

