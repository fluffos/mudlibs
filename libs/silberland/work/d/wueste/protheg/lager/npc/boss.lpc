/* 
   Boss vom Arbeitslager
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

nosave Punish(object ob);

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Odas Osam, der Chef des Arbeitslagers");
  SetProp(P_LONG,
	  "blabla\n");
  SetProp(P_NAME, "Odas Osam");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:50]));
  AddId(({"odas", "odas osam", "boss"}));
  set_living_name("Odas Osam");
  
  create_default_npc(26);
  SetProp(P_HANDS,({" mit seinen Krueppelfingern",QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS , 
	  ([ DT_TERROR: -1.0, DT_UNHOLY: -1.0, DT_MIND: -0.7]));
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC, 80);
  
  SetProp(P_MSGIN, "tritt aus dem Schatten hervor");
  SetProp(P_MSGOUT, "geht");
  
  SetProp(P_DIE_MSG,  " bricht tot zusammen.\n");
  SetProp(P_MURDER_MSG, "Und wer passt jetzt auf Alles auf?");
  SetProp(P_KILL_MSG, "Ein weiterer Sessel aus Deinen Knochen!");

  AddInfo(DEFAULT_INFO, "blickt Dich mistrauisch an.\n");

  AddInfo("hilfe", "Wenn Du mir wirklich helfen willst, dann tippe "+
	  "\n'biete Odas hilfe an'!", "sagt: ");
  

  SetProp(P_REJECT,({REJECT_GIVE,
		       "Odas Osam fragt: Willst Du mich etwa bestechen??\n"}));

  SetProp(P_SPELLRATE,80);
  AddSpell(5,150,
	   "Odas zieht Dir eins mit seiner Peitsche ueber Deinen Kopf.\n",
	   "Odas zieht @WEM eins mit seiner Peitsche ueber Den Kopf.\n",
	   DT_WHIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,250,
	   "Odas wuergt Dich mit seiner Peitsche bis Du blau anlaeufst.\n",
	   "Odas wuergt @WEN mit seiner Peitsche.\n",
	   DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,350,
	   "Odas pruegelt mit seiner Peitsche auf Dich ein.\n",
	   "Odas pruegelt mit seiner Peitsche auf @WEN ein.\n",
	   DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,150,
	   "Odas versucht Dich mit einem Stein bewusstlos zu schlagen.\n",
	   "Odas versucht @WEN mit einem Stein bewusstlos zu schlagen.\n",
	   DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  
  
  SetChats(1,({
    "Odas fragt: willst Du mir helfen?\n",
      "Odas zwinkert Dir zu.\n",
      "Odas mustert Dich von oben bis unten.\n",
      "Odas schwingt beherzt seine Peitsche.\n"}));
  SetAttackChats(10, ({
    "Odas bruellt: ab mit Dir in den Kerker.\n",
      "Odas grummelt: Nie sind die Wachen da, wenn man sie braucht!\n",
      "Odas bruellt Dich an!\n"}));
  
  AddCmd("biete","anbieten");
  SUID;
  CLONEME(WEAPON "bosspeitsche");
  command("zuecke peitsche");
}

void die(int poisondeath) 
{
  write_file(LOG "kills",
	     ctime()+": "+CAP(getuid(PL))+" killt Odas Osam.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  if(killer == ME)
    write_file(LOG "playerdeath",
	       ctime()+": Odas Osam killt "+CAP(getuid(player))+" ("+lostexp+").\n");
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) 
    {
    case "fies":
      if(!random(5))
	{
	  call_out("reaction", 0, TP,
		   "laesst sich das nicht weiter gefallen und steckt Dich ins "+
		   "Lager...",
		   "steckt "+TPN+" genervt ins Lager.");
	  call_out(Punish(TP),1);
	}
      break;
    case "frech":
      call_out("reaction", 0, TP,
	       "warnt: Werde nicht frech, sonst stecke ich Dich ins Lager!",
	       "hebt seinen Finger und warnt "+TPN+".");
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}

anbieten(string str)
{
  notify_fail("Was willst Du wem anbieten?\n");
  if(!str) return 0;
  if(str=="odas hilfe an")
    return Punish(TP),1;
  else return 0;     
}

Punish(object ob)
{
  tell_object(ob, "Du kommst ins Lager!\n");
}
