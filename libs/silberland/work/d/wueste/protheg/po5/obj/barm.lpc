#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <armour.h>

int restzeit;

create() 
{
  if(!is_clone(TO)) return;
  ::create();

  AddId(({"po5brokenarm","\nbarm"}));

  SetProp(P_WEIGHT, 500);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  restzeit=0;
  AddCmd("trage","blockt");
  AddCmd(({"ziehe","zieh"}), "blockz");
}

short(){ return 0;}
long(){ return 0;}

init()
{
  object pl,w;
  
  ::init();

  if(pl=environment(this_object()))
    if(query_once_interactive(pl))
      {
	pl->SetProp(P_MAX_HANDS, pl->QueryProp(P_MAX_HANDS)-1);    
	if(w=pl->QueryProp(P_WEAPON))
	  w->DoUnwield();
      }
  call_out("remove",3600);
}

blockt(string str)
{
  object r;
  
  if(!str) return 0;
  if(r=present(str,TP))
    if(r->QueryProp(P_ARMOUR_TYPE)==AT_GLOVE ||
       r->QueryProp(P_ARMOUR_TYPE)==AT_BRACERS)
      {
	SetProp(P_KILL_NAME, "Allzugrosse Schmerzen");
	TP->do_damage(5);
	return write("Dein linker Arm schmerzt Dich zu sehr!!\n"+
		     "Du kannst "+r->name(WEN,1)+" nicht anziehen.\n"),1;
      }
  return 0;
}

blockz(string str)
{
  string r;
  object ru;
  
  if(!str) return 0;
  if(sscanf(str, "%s an", r)==1)
    if(ru=present(r,TP))
      if(ru->QueryProp(P_ARMOUR_TYPE)==AT_GLOVE ||
	 ru->QueryProp(P_ARMOUR_TYPE)==AT_BRACERS)
	{
	  SetProp(P_KILL_NAME, "Allzugrosse Schmerzen");
	  TP->do_damage(5);
	  return write("Dein linker Arm schmerzt Dich zu sehr!!\n"+
		       "Du kannst "+ru->name(WEN,1)+" nicht anziehen.\n"),1;
	}
  return 0;
}

remove()
{
  object pl;

  if(pl=environment(this_object()))
    if(query_once_interactive(pl))
      {
	pl->SetProp(P_MAX_HANDS, pl->QueryProp(P_MAX_HANDS)+1);
	tell_object(pl, "Dein linker Arm scheint wieder geheilt zu sein!!\n");
      }
  ::remove();
}

BecomesNetDead(object spieler)
{
  restzeit=find_call_out("remove");
  while(remove_call_out("remove")!=-1);
  DB("*** Broken Arm: "+spieler->name(WER,1)+" quiting with Time: "+
     restzeit+" sec\n");
}

BecomesNetAlive(object spieler)
{
  if(restzeit)
    call_out("remove",restzeit);
  DB("*** Broken Arm: "+spieler->name(WER,1)+" restarting with Time: "+
     restzeit+" sec\n");
}

extra_look()
{
  return environment(ME)->name(WESSEN,1)+" linker Arm scheint gebrochen zu sein.\n";
}
