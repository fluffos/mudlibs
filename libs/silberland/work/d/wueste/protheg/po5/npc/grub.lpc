
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Grub, der kleine Berserker");
  SetProp(P_LONG,
	  "Grub ist im Vergleich mit seinem Bruder Ugh noch ein sehr junger "+
	  "und unerfahrener Troll, der sich und seiner Familie erst "+
	  "beweisen muss, ob er das Zeug zu einem echten Berserker hat.\n");
  SetProp(P_NAME, "Grub");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE,0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  AddId(({"grub","\npo5member","berserker","NOWIMPY","Axtkaempfer"}));

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinen starken Faeusten",
		       QueryProp(P_HANDS)[1]+100,DT_SLASH}));
  SetProp(P_BODY, 250);
  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 320);
  SetProp(P_ALIGN, -150);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,200);
  SetProp(P_WIMPY, 0);
  SetProp(P_FOOD, 0);
  SetProp(P_DRINK, 0);
  SetProp(P_RESISTANCE, ({DT_BLUDGEON}));
  SetProp(P_VULNERABILITY, ({DT_FIRE, DT_MIND, DT_SOUND}));
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_MMSGIN, "kommt ploetzlich angerannt");
  SetProp(P_MMSGOUT, "rennt wie ein Verrueckter weg");

  SetProp(P_DIE_MSG,  " kippt tot um.\n");
  SetProp(P_MURDER_MSG, "Freunde! Raecht mich!\n");
  SetProp(P_KILL_NAME, "Die Bruederschaft der Fuenf");
  SetProp(P_KILL_MSG, "Wage es nicht nocheinmal!");

  AddInfo("grub", "sagt: Grub, Bruder von Ugh sein!\n");
  AddInfo(({"grosser bruder","bruder","ugh"}), 
	  "sagt: Ugh sein meiner grosser Bruder!\n");
  AddInfo(({"bruderschaft","fuenf","bruderschaft der fuenf","mitglied"}),
	  "Ich Grub, gutes Berzerker noch nix so gut wie Ugh aber ich"+
	  "immer besser, aber trotzdem helfen Ugh und sein Mitglied in die "+
	  "Bruderschaft der Fuenf!\n","grunzt: ");
  AddInfo(({"beste","berzerker",DEFAULT_INFO}),
	  "Berzerker sein die Beste!!\n","bruellt: ");
  AddInfo("kalandra",
	  "erroetet...\n");
  AddInfo(({"mann","mantar"}),
	  "Sein komisches, altes Mann machen nur dauernd meditieren...\n",
	  "wundert sich: ");
  AddInfo("kronang",
	  "Kronang sein der besten Berserkermeister.\n","bruellt stolz: ");
  AddInfo("schranken",
	  "Du schon gezahlt?\n","fragt: ");
  
  SetProp(P_REJECT,({REJECT_DROP,"Grub sagt: Ich dem nix brauchen.\n"}));

  SetProp(P_GUILD, "berserker");
  SetProp(P_GUILD_LEVEL, 8);

  call_other("/gilden/berserker", "learn_berserker_skills",8000, 8000 );

  /*
    ModifySkill("eisenhaut",    10000);
    ModifySkill("eisenhaut",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    ModifySkill("willenskraft", 10000);
    ModifySkill("willenskraft", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    ModifySkill("rammen",       10000);
    ModifySkill("rammen",       ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    ModifySkill("zertreten",    10000);
    ModifySkill("zertreten",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    ModifySkill("kopfstoss",    10000);
    ModifySkill("kopfstoss",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    ModifySkill("spalten",      10000);
    ModifySkill("spalten",      ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  */

  SetProp(P_SPELLRATE,40);
  AddSpell(3,1,
	   "","", DT_BLUDGEON, "bspells");   
  AddSpell(1,1,
	   "Grub konzentriert sich und wird ploetzlich schneller...\n",
	   "Grub konzentriert sich und wird ploetzlich schneller...\n",
	   DT_BLUDGEON, "speedit");
  AddSpell(1,600,
	   "Grub rammt Dir seinen Pickel in die Schulter!\n",
	   "Grub rammt @WEM seinen Pickel in die Schulter!\n",
	   DT_PIERCE, "disarm");
  AddSpell(2,300,
	   "Grub blaeht sich auf und bruellt Dich aus Leibeskraeften an.\n",
	   "Grub blaeht sich auf und bruellt @WEN aus Leibeskraeften an.\n",
	   DT_SOUND, ([SP_SHOW_DAMAGE:1]));

  SetChats(1, 
	   ({"Grub uebt den Axtkampf, indem er wild auf alles einschlaegt.\n",
	       "Grub schwingt seinen Pickel beherzt in der Gegend herum.\n",
	       "Grub kratzt sich im Fell herum.\n"}));
  SetAttackChats(5, 
		 ({"Grub tritt Dir mit seinem Knie in den Bauch.\n",
		     "Grub beisst Dich bis es blutet.\n"}));
  enable_commands();
  
  PO5->AddMember("grub");
    
  SUID;
  CLONEME("/p/weapon/axe/pickel");
  command("zuecke pickel");
  CLONEME("/gilden/berserker/obj/stirnband");
  CLONEME("/p/armour/trousers/lendenschurz");
  CLONEME("/p/armour/bracers/titanarmschienen");
  command("trage alles");
}

void disarm(object enemy,int damage, mixed dam_type)
{
  object w;
  
  if(w=enemy->QueryProp(P_WEAPON))
    {
      tell_object(enemy,"Vor Schmerz laesst Du Deine Waffe fallen.\n");
      say(enemy->name(WER,1)+" laesst vor Schmerz seine Waffe fallen.\n",enemy);
      enemy->drop_obj(w);
    }
}

void speedit(object enemy,int damage, mixed dam_type)
{
  ME->ModifySkillAttribute(ME,SA_SPEED,100+random(3)*100,20+random(20));
}

/* Habbich von Grimow uebernommen ;) */
void bspells(object enemy,int damage, mixed dam_type)
{
  if(!ME->QueryProp(P_TMP_DEFEND_HOOK)) 
    {
      command_me("eisenhaut");
      return;
    }
  if(!present("\nberserker_willenskraft",ME)) 
    {
      command_me("willenskraft");
      return;
    }
  if(enemy->QueryProp(P_HP)<50*enemy->QueryProp(P_MAX_HP)/100) 
    {
      command_me("spalten");
      return;
    }
  switch(100*enemy->QueryProp(P_SIZE)/QueryProp(P_SIZE)) 
    {
    case  0.. 30: command_me("zertreten"); break;
    case 81..300: if (random(2)) 
      command_me("rammen");
    else
      command_me("kopfstoss");
    break;
    default: command_me("rammen"); break;
    }
  return;
}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
	     ctime()+": "+CAP(getuid(PL))+" killt Grub.\n");
  PO5->DelMember("grub");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  object me,pu;
  int geld;
  
  me=this_object();
  if(killer==me)
    {
      write_file(LOG "npc.deads",
		 ctime()+": "+me->name(WER,1)+" killt "+CAP(getuid(player))+".\n");
      command_me("nimm boerse aus leiche");
      command_me("nimm geld aus leiche");
      geld=me->QueryMoney();
      PO5->Payin(geld);
      me->AddMoney(-geld);
      if(pu=present("geldboerse",me))
	pu->remove();
      DB("*** PO5 !! Kalandra nimmt "+geld+" Muenzen.\n");
    }
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  object tp;

  if (find_call_out("reaction") != -1) return;
  tp=TP;
  switch (gruppe) 
    {
    case "aergerlich":
      call_out("reaction", 0, tp,
	       "haut Dir eine runter.\n",
	       "haut "+tp->name(WEM,1)+" eine runter.");
      break;
    case "fies":
      call_out("reaction", 0, tp,
	       "pruegelt auf Dich ein bis Du roechelst.\n",
	       "pruegelt auf "+tp->name(WEN,1)+" ein.");
      tp->AddHp(-20-random(30));
      break;
    case "frech":
      call_out("reaction", 0, tp,
	       "meint: Werd nicht frech kleiner!\n",
	       "meint: Werd nicht frech kleiner!\n");
      break;
    case "intim":
      call_out("reaction", 0, tp,
	       "kitzelt Dich mit seiner Obsidianaxt.\n",
	       "kitzelt "+tp->name(WEN,1)+" mit seiner Obsidianaxt.\n");
      tp->AddHp(-20-random(30));
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
    }
}

init()
{
  ::init();
  if (TP && TP->id("\npo5member")) AddDefender(TP);
}

InformDefend(object enemy)
{
  if(!ME->InFight())
    say("grub, stuerzt sich, laut groehlend ins Gefecht!\n");
  Kill(enemy);
  PO5->DefendMe(enemy);  
}
