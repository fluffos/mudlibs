
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Mantar, der erfahrene Druide");
  SetProp(P_LONG,
	  "Mantar ist ein alter, aber aeusserst gefaehrlicher Druide, wenn "+
	  "man ihn reizt. Manchmal wirkt er etwas abwesend, das kommt wohl "+
	  "von seinen dauernden Meditationen.\n");
  SetProp(P_NAME, "Mantar");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE,0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  AddId(({"mantar","\npo5member","druide","NOWIMPY"}));

  create_default_npc(30);
  SetProp(P_HANDS, ({" mit seinen elementaren Haenden",
		       QueryProp(P_HANDS)[1]+100,DT_MAGIC}));
  SetProp(P_BODY, 100);
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,250);
  SetProp(P_WIMPY, 0);
  SetProp(P_FOOD, 0);
  SetProp(P_DRINK, 0);
  SetProp(P_RESISTANCE, ({DT_FIRE,DT_COLD,DT_STONE,DT_WATER,DT_AIR}));
  SetProp(P_NOMAGIC,40);

  SetProp(P_MSGIN, "wandert herein");
  SetProp(P_MSGOUT, "wandert");
  SetProp(P_MMSGIN, "erscheint aus dem Nichts!");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");

  SetProp(P_DIE_MSG,  " bricht tot in sich zusammen\n");
  SetProp(P_MURDER_MSG, "Freunde! Raecht mich!\n");
  SetProp(P_KILL_NAME, "Die Bruederschaft der Fuenf");
  SetProp(P_KILL_MSG, "Wage es nicht nocheinmal!");

  AddInfo(DEFAULT_INFO, "meint: Stoere mich nicht in meiner Meditation!\n");
  AddInfo("meditation",
	  "Meine Meditation ist wichtig!\n","findet: ");
  AddInfo(({"bruderschaft","fuenf","bruderschaft der fuenf","mitglied"}),
          "Ich bin Mantar, der erfahrene Druide, Mitglied in der "+
          "Bruderschaft der Fuenf!\n","murmelt: ");
  AddInfo("mantar",
	  "Ja, ich bin Mantar und nur meine Eltern wissen warum!\n","sagt: ");
  AddInfo("druide",
	  "Ich bin schon fast so gut wie Kalandra!\n","meint grinsend: ");
  AddInfo("eltern",
	  "murmelt nur etwas vor sich hin...\n");
  AddInfo(({"meisterin","kalandra"}),
	  "Kalandra ist meine Meisterin!\n","strahlt: ");
  AddInfo(({"grub","ugh"}),
	  "Grub und Ugh sind zwei hervorragende Berserker, aber leider so "+
	  "intelligent wie ein Haufen Heu!\n","sagt: ");
  AddInfo("berserker",
	  "Berserker sind sehr stark!\n","meint: ");
  AddInfo(({"haufen","heu","heuhaufen","haufen heu"}),
	  "grinst nur.\n");
  AddInfo(({"pelzknaeuel","knaeuel","hobbit"}),
	  "Ich mag dieses kleine, freche Pelzknaeuel nicht.\n","gesteht: ");
  AddInfo("schranken",
	  "Der Schranken ist sowieso magisch, wieso muessen wir dann darauf "+
	  "aufpassen??\n","grummelt: ");
  AddInfo("anvar",
	  "Anvar ist ein komischer alter Kautz!\n","meint nur: ");

  SetProp(P_REJECT,({REJECT_DESTRUCT,"Mantar zerstoert Dein Geschenk!\n"}));

  SetProp(P_GUILD, "druidenzirkel");
  SetProp(P_GUILD_LEVEL, 15);

  ModifySkill("feuerball",       10000);
  ModifySkill("feuerball",       ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  ModifySkill("froststrahl",     10000);
  ModifySkill("froststrahl",     ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  ModifySkill("wasserstrahl",    10000);
  ModifySkill("wasserstrahl",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  ModifySkill("erzstrahl",       10000);
  ModifySkill("erzstrahl",       ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  ModifySkill("windstoss",       10000);
  ModifySkill("windstoss",       ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));

  SetProp(P_SPELLRATE,60);
  AddSpell(5,1,
	   "","", DT_BLUDGEON, "dspells");   
  AddSpell(3,1,
	   "","", DT_BLUDGEON, "dbeh");   
  AddSpell(1,1,
	   "",
	   "",
	   DT_MIND,"verfluchen");
  AddSpell(1,1,
	   "Mantar blickt Dich mit leuchtenden Augen an und ploetzlich schrumpft "+
	   "die Welt...\n",
	   "Mantar blickt @WEN mit gruen leuchtenden Augen an und @WER beginnt "+
	   "zu schrumpfen.\n",
	   DT_MAGIC, "quaak");
  AddSpell(2,400,
	   "Mantar beruehrt Deine Stirn und ploetzlich faehrt ein Blitz durch "+
	   "Deine Gedanken.\n",
	   "Mantar beruehrt @WESSEN Stirn, worauf @WER zu taumeln beginnt.\n",
	   DT_MIND, ([SP_SHOW_DAMAGE:1]));

  SetChats(1, 
	   ({"Mantar versinkt kurz in Meditation...\n",
	       "Mantar schliesst seine Augen und konzentriert sich...\n",
	       "Mantar mustert Dich.\n"}));
  SetAttackChats(5, 
		 ({"Mantar beschwoert die Elemente auf Dich.\n",
		     "Mantar naehert sich Dir mit seinen Elementarhaenden.\n"}));
  enable_commands();
  
  PO5->AddMember("mantar");
    
  SUID;
  CLONEME("/gilden/druidenzirkel/armour/d_amulett");
  CLONEME("/gilden/druidenzirkel/armour/e_panzer");
  command("trage alles");
}

void dbeh(object enemy,int damage, mixed dam_type)
{
  string rnd;
  object who;
  
  rnd=({"ugh","grub","hobbit","kalandra"})[random(4)];
  if(who=present(rnd, MENV))
    {
      say("Mantar heilt "+CAP(rnd)+".\n");
      who->AddHp(30+random(20));
    }
  else
    {
      say("Mantar heilt sich.\n");
      ME->AddHp(30+random(20));
    }
  return;
}

void verfluchen(object enemy,int damage, mixed dam_type)
{
  enemy->SetProp(P_FROG, 1);
}

void verfluchen(object enemy,int damage, mixed dam_type)
{
  object w;
    
  if(ob=enemy->QueryProp(P_WEAPON))
    if(!ob->QueryProp(P_AUTOLOADOBJ))
      {
	ob->SetProp(P_CURSED, ob->Name(WER,1)+
		    " wurde durch einen hinterhaeltigen Zauberspruch verflucht!\n");
	tell_object(enemy, "Mantar konzentriert sich auf Deine Waffe...\n"+
		    "Deine Waffe scheint sich veraendert zu haben!!\n");
	say("Mantar konzentriert sich auf "+enemy->name(WESSEN,1)+" Waffe...\n",
	    enemy);
      }
}

void dspells(object enemy,int damage, mixed dam_type)
{
  string *vuln;
  
  /* des geht net im kampf :((((((
    if(!present("\ne_panzer",ME))
    {
    command_me("elementarpanzer");
    return;
    }
  */
  vuln=enemy->QueryProp(P_VULNERABILITY);
  if(member(vuln, DT_FIRE)>-1)
    {
      command_me("feuerball");
      return;
    }
  if(member(vuln, DT_COLD)>-1)
    {
      command_me("froststrahl");
      return;
    }
  if(member(vuln, DT_WATER)>-1)
    {
      command_me("wasserstrahl");
      return;
    }
  if(member(vuln, DT_AIR)>-1)
    {
      command_me("windstoss");
      return;
    }
  if(member(vuln, DT_STONE)>-1)
    {
      command_me("erzstrahl");
      return;
    }
  
  switch(random(5))
    {
    case 0: command_me("erzstrahl"); return;
    case 1: command_me("froststrahl"); return;
    case 2: command_me("windstoss"); return;
    case 3: command_me("wasserstrahl"); return;
    case 4: command_me("feuerball"); return;
    }
  return;
}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
	     ctime()+": "+CAP(getuid(PL))+" killt Mantar.\n");
  PO5->DelMember("mantar");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  object me,pu;
  int geld;
  
  me=this_object();
  if(killer==me)
    {
      write_file(LOG "npc.deads",
		 ctime()+": "+me->name(WER,1)+" killt "+CAP(getuid(player))+".\n");
      command_me("nimm boerse aus leiche");
      command_me("nimm geld aus leiche");
      geld=me->QueryMoney();
      PO5->Payin(geld);
      me->AddMoney(-geld);
      if(pu=present("geldboerse",me))
	pu->remove();
      DB("*** PO5 !! Mantar nimmt "+geld+" Muenzen.\n");
    }
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  object tp;

  if (find_call_out("reaction") != -1) return;
  tp=TP;
  switch (gruppe) 
    {
    case "fies":
      if(!random(10)
	 {
	   call_out("reaction", 0, tp,
		    "meint grinsend: Versuch das jetzt nochmal!\nPloetzlich wird "+
		    "er riesengross, oder ist das umgekehrt?!\n",
		    "grinst "+tp->name(WEN,1)+" an.\nPloetzlich wird "+
		    tp->name(WER,1)+"ganz klein...\n");
	   tp->SetProp(P_FROG,1);
	 }
      break;
    case "frech":
      call_out("reaction", 0, tp,
	       "grummelt Dich an.\n",
	       "grummelt "+tp->name(WEN,1)+" an.\n");
      break;
    case "intim":
      call_out("reaction", 0, tp,
	       "bruellt: Du wagst es!!!\nPloetzlich wird alles weiss...\n",
	       "bruellt "+tp->name(WEN,1)+" an und hebt seine Haende...\n"+
	       "Ploetzlich wird alles weiss...\n");
      tp->SetProp(P_BLIND, 10+random(20));
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

varargs void reaction(object ob, string macher, string andere,int flag) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
      if(flag) ob->AddHp(-20-random(30));
    }
}

init()
{
  ::init();
  if (TP && TP->id("\npo5member")) AddDefender(TP);
}

InformDefend(object enemy)
{
  if(!ME->InFight())
    say("Mantar erwacht aus seiner Konzentration und seine Augen blitzen auf.\n");
  Kill(enemy);
  PO5->DefendMe(enemy);  
}
