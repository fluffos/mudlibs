
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create() 
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ugh, der Berserker");
  SetProp(P_LONG,
	  "Ugh ist Berg von einem Troll, dessen grosse Obsidianaxt in seinen "+
	  "Haenden richtig mickrig aussieht. Er hat seinen Mut und seine "+
	  "Ausdauer schon in hunderten von Kaempfen gezeigt und wird damit "+
	  "nicht aufhoeren, bis ihn eines Tages jemand niederstreckt.\n");
  SetProp(P_NAME, "Ugh");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE,0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:40]));
  AddId(({"ugh","\npo5member","berserker","NOWIMPY","Axtexperte"}));

  create_default_npc(39);
  SetProp(P_HANDS, ({" mit seinen starken Faeusten",
		       QueryProp(P_HANDS)[1]+50,DT_SLASH}));
  SetProp(P_BODY, 200);
  SetProp(P_RACE, "Troll");
  SetProp(P_SIZE, 350);
  SetProp(P_ALIGN, -250);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,250);
  SetProp(P_WIMPY, 0);
  SetProp(P_FOOD, 0);
  SetProp(P_DRINK, 0);
  SetProp(P_RESISTANCE, ({DT_BLUDGEON, DT_TERROR}));
  SetProp(P_VULNERABILITY, ({DT_FIRE, DT_MIND}));
  SetProp(P_NOMAGIC,15);

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_MMSGIN, "kommt ploetzlich angerannt");
  SetProp(P_MMSGOUT, "rennt wie ein Verrueckter weg");

  SetProp(P_DIE_MSG,  " kippt mit einem lauten Krachen um.\n");
  SetProp(P_MURDER_MSG, "Freunde! Raecht mich!\n");
  SetProp(P_KILL_NAME, "Die Bruederschaft der Fuenf");
  SetProp(P_KILL_MSG, "Wage es nicht nocheinmal!");

  AddInfo(({"ugh",DEFAULT_INFO}), "sagt: Ugh, ich sein!\n");
  AddInfo(({"bruderschaft","fuenf","bruderschaft der fuenf","mitglied"}),
          "Ich Ugh, krasse Berserkermeister und stolze Mitglied in "+
          "Bruderschaft der Fuenf!\n","grunzt stolz: ");
  AddInfo(({"berserker","berserkermeister","meister"}),
	  "Ich, bestes Berserker!!\n","meint stolz: ");
  AddInfo(({"kleiner bruder","grub"}),
	  "Grub, kleines Bruder, sein noch nix krasses Berzerker.\n","erzaehlt: ");
  AddInfo("kalandra",
	  "grunzt nur.\n");
  AddInfo(({"druide","mantar"}),
	  "Mantar sein altes, krasses Druide, aber immer nur meditieren.\n",
	  "findet: ");
  AddInfo("hobbit",
	  "Dem mag ich net!\n","meint abwuerfig: ");
  AddInfo("zoll",
	  "Ugh sagen Du zahlen!\n","meint: ");
  AddInfo("axt",
	  "Das sein krasse Obsidianaxt!\n","grunzt: ");
  AddInfo("kronang",
	  "Kronang? Pfffffff, sein konkretes Wichtigmacher.\n","meint: ");
  AddInfo(({"floh","floehe"}),
	  "Die mir noch umbringt!\n","flucht: ");
  AddInfo("schranken",
	  "Dem ist magischen Schranken, wo Du nix kommen durch, wenn nix "+
	  "zahlen!\n","meint haemisch: ");

  SetProp(P_REJECT,({REJECT_KEEP,"Ugh sagt: Ugh, schoener Spielzeug.\n"}));

  SetProp(P_GUILD, "berserker");
  SetProp(P_GUILD_LEVEL, 10);

  call_other("/gilden/berserker", "learn_berserker_skills",10000, 10000 );

  /*
    ModifySkill("eisenhaut",    10000);
    ModifySkill("eisenhaut",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    ModifySkill("willenskraft", 10000);
    ModifySkill("willenskraft", ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    ModifySkill("rammen",       10000);
    ModifySkill("rammen",       ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    ModifySkill("zertreten",    10000);
    ModifySkill("zertreten",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    ModifySkill("kopfstoss",    10000);
    ModifySkill("kopfstoss",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
    ModifySkill("spalten",      10000);
    ModifySkill("spalten",      ([SI_PREPARE_TIME:0, SI_SPELLCOST:0]) );
  */

  SetProp(P_SPELLRATE,60);
  AddSpell(3,1,
	   "","", DT_BLUDGEON, "bspells");   
  AddSpell(2,500,
	   "Ugh hebt seine Axt und schwingt sie beherzt durch die Runde...\n",
	   "Ugh hebt seine Axt und schwingt sie beherzt durch die Runde...\n",
	   DT_SLASH, "hauall");
  AddSpell(3,600,
	   "Ugh laesst einen gewaltigen Kampfschrei los, der Dich umhaut.\n",
	   "Ugh laesst einen gewaltigen Kampfschrei los, der Dich umhaut.\n",
	   DT_SOUND, "hauall");
  AddSpell(1,400,
	   "Ugh erwischt Dich mit dem Axtstiel und Du beginnst zu taumeln...\n",
	   "Ugh erwischt @WEN mit dem Axtstiel und @WER beginnt zu taumeln...\n",
	   DT_SLASH, "knockout");
  AddSpell(1,250,
	   "Ugh hackt auf Deine Ruestung ein...\n",
	   "Ugh hackt auf @WESSEN Ruestung ein...\n",
	   DT_BLUDGEON, "hackit");
  AddSpell(1,800,
	   "Ugh bruellt: Du gehn besuchen Lars!\n",
	   "Ugh bruellt: @WER gehn besuchen Lars!\n",
	   DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  SetChats(1, 
	   ({"Ugh putzt ein wenig an seiner Axt herum.\n",
	       "Ugh kratzt ein paar Hautfetzen von seiner Axt.\n",
	       "Ugh prueft seine Kleidung auf eingetrocknete Blutspritzer ab.\n",
	       "Ugh grunzt.\n",
	       "Ugh holt einen Floh aus seinem Fell und frisst ihn auf.\n",
 	       "Ugh fummelt mit seiner Klaue in seinem Ohr herum.\n",
	       "Ugh kratzt sich ein paar Floehe aus dem Fell.\n"}));
  SetAttackChats(5, 
		 ({"Ugh tritt Dir brutal auf die Zehen.\n",
		     "Ugh beisst Dir in den Arm und saugt etwas Blut.\n"}));
  enable_commands();
  
  PO5->AddMember("ugh");
    
  SUID;
  CLONEME("/p/weapon/axe/obsidianaxt");
  command("zuecke axt");
  CLONEME("/gilden/berserker/obj/stirnband");
  CLONEME("/p/armour/trousers/lendenschurz");
  CLONEME("/p/armour/helm/knochenhelm");
  CLONEME("/p/armour/bracers/titanarmschienen");
  command("trage alles");
}

Defend(int dam, string dtype, int spell, object enemy)
{
  if(!ME->QueryProp(P_TMP_DEFEND_HOOK)) 
    command_me("eisenhaut");
  return::Defend(dam, dtype,spell, enemy);
}

void hackit(object enemy,int damage, mixed dam_type)
{
  object w;
  object *armours;

  if(sizeof(armours=enemy->QueryProp(P_ARMOURS)))
    {
      if((w=armours[random(sizeof(armours))])->QueryProp(P_AC))
	{
	  w->Damage((w->QueryProp(P_AC)+4)/5);
	  tell_object(enemy, w->Name(WER,1)+(w->IsPlural()?" nehmen":" nimmt")+
		      " Schaden.\n");
	}
    }
}

void hauall(object enemy,int damage, mixed dam_type)
{
  object *feinde;
  int i;

  feinde=PresentEnemies();

  if(feinde && sizeof(feinde))
    for(i=sizeof(feinde)-1;i>=0;i--)
      if(random(5))
	feinde[i]->Defend(random(damage), dam_type,
			  ([SP_SHOW_DAMAGE:1,SP_NAME:"hausiealle"]), this_object());
}

void knockout(object enemy,int damage, mixed dam_type)
{
  enemy->SetProp(P_DISABLE_ATTACK, 1+random(3)+enemy->QueryProp(P_DISABLE_ATTACK));
}

void bspells(object enemy,int damage, mixed dam_type)
{
  if(!present("\nberserker_willenskraft",ME)) 
    {
      command_me("willenskraft");
      return;
    }
  if(enemy->QueryProp(P_HP)<45*enemy->QueryProp(P_MAX_HP)/100) 
    {
      command_me("spalten");
      return;
    }
  switch(100*enemy->QueryProp(P_SIZE)/QueryProp(P_SIZE)) 
    {
    case  0.. 30: command_me("zertreten"); break;
    case 81..300: if (random(2)) 
      command_me("rammen");
    else
      command_me("kopfstoss");
    break;
    default: command_me("rammen"); break;
    }
  return;
}

void die(int poisondeath) {
  write_file(LOG "npc.kills",
	     ctime()+": "+CAP(getuid(PL))+" killt Ugh.\n");
  PO5->DelMember("ugh");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp) 
{
  object me,pu;
  int geld;
  
  me=this_object();
  if(killer==me)
    {
      write_file(LOG "npc.deads",
		 ctime()+": "+me->name(WER,1)+" killt "+CAP(getuid(player))+".\n");
      command_me("nimm boerse aus leiche");
      command_me("nimm geld aus leiche");
      geld=me->QueryMoney();
      PO5->Payin(geld);
      me->AddMoney(-geld);
      if(pu=present("geldboerse",me))
	pu->remove();
      DB("*** PO5 !! Kalandra nimmt "+geld+" Muenzen.\n");
    }
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  object tp;

  if (find_call_out("reaction") != -1) return;
  tp=TP;
  switch (gruppe) 
    {
    case "aergerlich":
      call_out("reaction", 0, tp,
	       "haut Dir eine runter.\n",
	       "haut "+tp->name(WEM,1)+" eine runter.");
      break;
    case "fies":
      call_out("reaction", 0, tp,
	       "pruegelt auf Dich ein bis Du roechelst.\n",
	       "pruegelt auf "+tp->name(WEN,1)+" ein.",1);
      break;
    case "frech":
      call_out("reaction", 0, tp,
	       "meint: Werd nicht frech kleiner!\n",
	       "meint: Werd nicht frech kleiner!\n");
      break;
    case "intim":
      call_out("reaction", 0, tp,
	       "kitzelt Dich mit seiner Obsidianaxt.\n",
	       "kitzelt "+tp->name(WEN,1)+" mit seiner Obsidianaxt.\n",1);
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

varargs void reaction(object ob, string macher, string andere,int flag) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
      if(flag) ob->AddHp(-20-random(30));
    }
}

init()
{
  ::init();
  if (TP && TP->id("\npo5member")) AddDefender(TP);
}

InformDefend(object enemy)
{
  if(!ME->InFight())
    say("Ugh, stuerzt sich, laut groehlend ins Gefecht!\n");
  Kill(enemy);
  PO5->DefendMe(enemy);  
}
